          (lower-reach-expr pools all-functions names state leaf)
          subleaf))]
    [(ast.AstExpr.Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr pools all-functions names state index))]
    [(ast.AstExpr.Syscall args)
      (lower-reach-expr-list pools all-functions names state args)]))

(define (lower-reach-global-decl
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [decl : ast.AstDecl]) : LowerReachState
  (match decl
    [(ast.AstDecl.Def decl-meta _ _ expr-box)
      (let
        [expr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools expr-box)]
        (lower-reach-expr pools all-functions names state expr))]
    [(ast.AstDecl.DefMacro decl-meta _ _ _ _) state]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-reach-global-decl pools all-functions names state inner))]
    [_ state]))

(define (lower-reach-global-decls
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module-id : i64]) : LowerReachState
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) state]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons path _) path]
            [(ast.AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            (& paths)
            0
            entry-path
            decl-path
            module-id)]
        [decl-names : LowerNameCache
          (lower-name-cache-with-module-id names logical-module-id)]
        (match decl
          [(ast.AstDecl.Module next-module)
            (lower-reach-global-decls
              pools
              all-functions
              names
              state
              rest
              rest-paths
              entry-path
              next-module)]
          [(ast.AstDecl.Def decl-meta _ _ expr-box)
            (let
              [expr : ast.AstExpr
                (ast.ast-node-pool-context-expr-get pools expr-box)]
              (lower-reach-global-decls
                pools
                all-functions
                names
                (lower-reach-expr pools all-functions decl-names state expr)
                rest
                rest-paths
                entry-path
                module-id))]
          [(ast.AstDecl.DefMacro decl-meta _ _ _ _)
            (lower-reach-global-decls
              pools
              all-functions
              names
              state
              rest
              rest-paths
              entry-path
              module-id)]
          [(ast.AstDecl.Unsafe inner-box)
            (let
              [inner : ast.AstDecl (box-get inner-box)]
              (lower-reach-global-decls
                pools
                all-functions
                names
                (lower-reach-global-decl
                  pools
                  all-functions
                  decl-names
                  state
                  inner)
                rest
                rest-paths
                entry-path
                module-id))]
          [_
            (lower-reach-global-decls
              pools
              all-functions
              names
              state
              rest
              rest-paths
              entry-path
              module-id)]))]))

(define (lower-reach-struct-field-cleanup-roots
  [all-functions : lower_i64_i64_map.Map]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [fields : ast.AstFieldDefList]) : LowerReachState
  (lower-reach-struct-field-cleanup-roots-at
    all-functions
    entry-path
    decl-path
    module
    module-id
    names
    state
    (& fields)
    0))

(define (lower-reach-struct-field-cleanup-roots-at
  [all-functions : lower_i64_i64_map.Map]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : LowerReachState
  (if (>= index (struct-get fields len))
    state
    (let
      [next : LowerReachState
        (match (ast.ast-field-def-list-get
          fields
          index
          (ast.ast-field-def-fallback))
          [(ast.AstFieldDef.Def _ _ cleanup)
            (match cleanup
              [(ast.AstFieldCleanup.Fn cleanup-name)
                (let
                  [logical-id : i64
                    (if (tc_core.tc-name-qualified-id? cleanup-name)
                      (lower-name-cache-resolve-logical-id
                        (& names)
                        (tc_core.macro-hygiene-global-source-name-id-or
                          cleanup-name
                          cleanup-name)
                        -1)
                      (lower-module-name-key-id-by-id module-id cleanup-name))]
                  (lower-reach-add-logical all-functions state logical-id))]
              [_ state])])]
      (lower-reach-struct-field-cleanup-roots-at
        all-functions
        entry-path
        decl-path
        module
        module-id
        names
        next
        fields
        (+ index 1)))))

(define (lower-reach-enum-payload-cleanup-roots
  [all-functions : lower_i64_i64_map.Map]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [variants : ast.AstVariantDefList]) : LowerReachState
  (lower-reach-enum-payload-cleanup-roots-at
    all-functions
    entry-path
    decl-path
    module
    module-id
    names
    state
    (& variants)
    0
    0))

(define (lower-reach-enum-payload-cleanup-roots-at
  [all-functions : lower_i64_i64_map.Map]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [variants : (& variants ast.AstVariantDefList)]
  [variant-index : i64]
  [payload-index : i64]) : LowerReachState
  (if (>= variant-index (ast.ast-variant-def-list-len variants))
    state
    (match (ast.ast-variant-def-list-get
      variants
      variant-index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def _ _ cleanups)
        (if (>=
          payload-index
          (ast.ast-variant-payload-cleanup-list-len (& cleanups)))
          (lower-reach-enum-payload-cleanup-roots-at
            all-functions
            entry-path
            decl-path
            module
            module-id
            names
            state
            variants
            (+ variant-index 1)
            0)
          (let
            [next : LowerReachState
              (match (ast.ast-variant-payload-cleanup-list-get
                (& cleanups)
                payload-index
                (ast.ast-variant-payload-cleanup-fallback))
                [(ast.AstVariantPayloadCleanup.Fn cleanup-name)
                  (let
                    [logical-id : i64
                      (if (tc_core.tc-name-qualified-id? cleanup-name)
                        (lower-name-cache-resolve-logical-id
                          (& names)
                          (tc_core.macro-hygiene-global-source-name-id-or
                            cleanup-name
                            cleanup-name)
                          -1)
                        (lower-module-name-key-id-by-id module-id cleanup-name))]
                    (lower-reach-add-logical all-functions state logical-id))]
                [_ state])]
            (lower-reach-enum-payload-cleanup-roots-at
              all-functions
              entry-path
              decl-path
              module
              module-id
              names
              next
              variants
              variant-index
              (+ payload-index 1))))])))

(define (lower-reach-cleanup-metadata-roots-in-module
  [all-functions : lower_i64_i64_map.Map]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]) : LowerReachState
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) state]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons path _) path]
            [(ast.AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            (& paths)
            0
            entry-path
            decl-path
            module-id)]
        [logical-module : String
          (lower-decl-owner-module-name module-id logical-module-id)]
        [next : LowerReachState
          (match decl
            [(ast.AstDecl.DefStruct decl-meta _ _ cleanup fields)
              (if (ast.ast-struct-cleanup? cleanup)
                (lower-reach-struct-field-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  fields)
                state)]
            [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup fields)
              (if (ast.ast-struct-cleanup? cleanup)
                (lower-reach-struct-field-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  fields)
                state)]
            [(ast.AstDecl.DefEnum decl-meta _ cleanup variants)
              (if (ast.ast-enum-cleanup? cleanup)
                (lower-reach-enum-payload-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  variants)
                state)]
            [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ cleanup variants)
              (if (ast.ast-enum-cleanup? cleanup)
                (lower-reach-enum-payload-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  variants)
                state)]
            [(ast.AstDecl.Module next-module)
              (lower-reach-cleanup-metadata-roots-in-module
                all-functions
                rest
                rest-paths
                entry-path
                (ci.intern-str next-module)
                next-module
                names
                state)]
            [_ state])]
        (match decl
          [(ast.AstDecl.Module _) next]
          [_
            (lower-reach-cleanup-metadata-roots-in-module
              all-functions
              rest
              rest-paths
              entry-path
              module
              module-id
              names
              next)]))]))

(define (lower-function-body-index-empty [count : i64]) : LowerFunctionBodyIndex
  (LowerFunctionBodyIndex
    (lower_i64_i64_map.with-capacity 8192)
    (make-array LowerMaybeFunctionBody count)
    0))

;; Build a small per-module overlay name cache holding only the module's
;; import aliases; module-owned declarations resolve through canonical
;; module-qualified keys in the shared global cache. Misses fall through to that
;; cache `lower-active-global-name-cache` (set by the prune body-index pass).
;; Was O(modules x global-names): a fresh full cache was rebuilt per module.
(define (lower-function-body-name-cache-for-module
  [decls : ast.AstDeclList]
  [_paths : ast.AstDeclPathList]
  [_entry-path : String]
  [_base-names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [module : String]
  [module-id : i64]) : LowerNameCache
  (if (string.eq module "")
    base-cache
    (match (lower-active-module-name-cache-lookup module-id)
      [(LowerMaybeModuleNameCache.Some cache) cache]
      [(LowerMaybeModuleNameCache.No)
        (let
          [alias-only-names : LowerNameEnv
            (lower-name-env-with-import-aliases-in-module-cache
              decls
              (LowerNameEnv.Nil)
              base-cache
              module-id)]
          [cache : LowerNameCache
            (lower-name-cache-overlay alias-only-names module-id)]
          (begin
            (lower-active-module-name-cache-insert! module-id cache)
            cache))])))

(define (lower-function-decl-count-one [decl : ast.AstDecl]) : i64
  (match decl
    [(ast.AstDecl.DefFn decl-meta _ _ _ _ _) 1]
    [(ast.AstDecl.Unsafe inner-box)
      (lower-function-decl-count-one (box-get inner-box))]
    [_ 0]))

(define (lower-function-decl-count [decls : ast.AstDeclList]) : i64
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [out : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (+
              out
              (lower-function-decl-count-one
                (array-ref
                  (struct-get decls slots)
                  (+ (struct-get decls offset) index)))))
          (set! index (+ index 1))))
      out)))

(define (lower-function-body-index-add
  [index : LowerFunctionBodyIndex (:consume)]
  [logical-id : i64]
  [names : LowerNameCache]
  [body : ast.AstExpr]
  [decl-path-owner-id : i64]) : LowerFunctionBodyIndex
  (let
    [ids : lower_i64_i64_map.Map (struct-get index ids)]
    [bodies : (__tl_dyn-array LowerMaybeFunctionBody) (struct-get index bodies)]
    [next : i64 (struct-get index next)]
    (begin
      (array-set!
        bodies
        next
        (LowerMaybeFunctionBody.Some body names decl-path-owner-id))
      (lower_i64_i64_map.insert-ref! (&mut ids) logical-id next)
      (LowerFunctionBodyIndex ids bodies (+ next 1)))))

(define (lower-function-body-index-find
  [index : LowerFunctionBodyIndex]
  [target : i64]) : LowerMaybeFunctionBody
  (match (lower_i64_i64_map.get (& (struct-get index ids)) target)
    [(lower_i64_i64_map.LookupFound body-index)
      (array-ref (struct-get index bodies) body-index)]
    [(lower_i64_i64_map.LookupMissing) (LowerMaybeFunctionBody.No)]))

(define (lower-function-body-index-from-decls-in-module
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [all-decls : ast.AstDeclList]
  [all-paths : ast.AstDeclPathList]
  [base-names : LowerNameEnv]
  [base-name-cache : LowerNameCache]
  [module-name-cache : LowerNameCache]
  [index : LowerFunctionBodyIndex (:consume)]) : LowerFunctionBodyIndex
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) index]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons path _) path]
            [(ast.AstDeclPathListStep.Nil) entry-path])]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            (& paths)
            0
            entry-path
            decl-path
            module-id)]
        [decl-name-cache : LowerNameCache
          (lower-name-cache-with-module-id module-name-cache logical-module-id)]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons _ path-rest)
              (let
                [path-rest : ast.AstDeclPathList path-rest]
                path-rest)]
            [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
        (match (ast.ast-decl-unwrapped decl)
          [(ast.AstDecl.Module next-module)
            (let
              [next-module-str : String (ci.intern-str next-module)]
              (lower-function-body-index-from-decls-in-module
                pools
                rest
                rest-paths
                entry-path
                next-module-str
                next-module
                all-decls
                all-paths
                base-names
                base-name-cache
                (lower-function-body-name-cache-for-module
                  all-decls
                  all-paths
                  entry-path
                  base-names
                  base-name-cache
                  next-module-str
                  next-module)
                index))]
          [(ast.AstDecl.DefFn decl-meta name _ _ body-box _)
            (let
              [body : ast.AstExpr
                (ast.ast-node-pool-context-expr-get pools body-box)]
              (lower-function-body-index-from-decls-in-module
                pools
                rest
                rest-paths
                entry-path
                module
                module-id
                all-decls
                all-paths
                base-names
                base-name-cache
                module-name-cache
                (lower-function-body-index-add
                  index
                  (lower-decl-logical-id
                    entry-path
                    decl-path
                    (lower-decl-owner-module-name module-id logical-module-id)
                    logical-module-id
                    name
                    (tc_core.tc-env-key-name-text name))
                  decl-name-cache
                  body
                  (ast.ast-decl-path-list-owner-id
                    (& paths)
                    0
                    logical-module-id))))]
          [_
            (lower-function-body-index-from-decls-in-module
              pools
              rest
              rest-paths
              entry-path
              module
              module-id
              all-decls
              all-paths
              base-names
              base-name-cache
              module-name-cache
              index)]))]))

(define (lower-function-body-index-from-decls
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [count : i64]) : LowerFunctionBodyIndex
  (begin
    (set! lower-active-module-name-caches (LowerModuleNameCacheList.Nil))
    (let
      [name-cache : LowerNameCache (lower-name-cache-from-env names)]
      (lower-function-body-index-from-decls-in-module
        pools
        decls
        paths
        entry-path
        ""
        cbi.compiler-builtin-id-fix-empty
        decls
        paths
        names
        name-cache
        name-cache
        (lower-function-body-index-empty count)))))

(define (lower-reach-process
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [body-index : LowerFunctionBodyIndex]
  [state : LowerReachState]) : LowerReachState
  (match state
    [(LowerReachState.State reachable worklist)
      (let
        [top : i64 (- (struct-get worklist len) 1)]
        (if (< top 0)
          state
          (let
            [name : i64 (array-ref (struct-get worklist slots) top)]
            [popped : LowerReachState
              (LowerReachState.State
                reachable
                (LowerIdSet (struct-get worklist slots) top))]
            (match (lower-function-body-index-find body-index name)
              [(LowerMaybeFunctionBody.Some body body-names body-path-owner-id)
                (begin
                  (lower_i64_i64_map.insert-ref!
                    (&mut lower-reach-active-runtime-paths)
                    body-path-owner-id
                    1)
                  (lower-reach-process
                    pools
                    all-functions
                    names
                    body-index
                    (lower-reach-expr
                      pools
                      all-functions
                      body-names
                      popped
                      body)))]
              [(LowerMaybeFunctionBody.No)
                (lower-reach-process
                  pools
                  all-functions
                  names
                  body-index
                  popped)]))))]))

(define (lower-dispatch-variant-logical-name
  [module-id : i64]
  [names : LowerNameCache]
  [variant-name : i64]) : String
  (match (lower-name-cache-resolve-id-display
    names
    (lower-dispatch-variant-source-id module-id variant-name))
    [(tc_core.TcMaybeString.Some logical-name) logical-name]
    [(tc_core.TcMaybeString.No) (tc_core.tc-env-key-name-text variant-name)]))

(define (lower-dispatch-variant-source-id
  [module-id : i64]
  [variant-name : i64]) : i64
  (if (or
    (csym.compiler-symbol-root-module-id? module-id)
    (tc_core.tc-name-qualified-id? variant-name)
    (>= variant-name (ci.intern-capacity)))
    variant-name
    (csym.compiler-symbol-module-key-id-by-id module-id variant-name)))

(define (lower-dispatch-variant-logical-id
  [module-id : i64]
  [names : LowerNameCache]
  [variant-name : i64]) : i64
  (let
    [source-id : i64 (lower-dispatch-variant-source-id module-id variant-name)]
    (lower-name-cache-resolve-logical-id (& names) source-id source-id)))

(define (lower-dispatch-variant-set-add-list-from
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [module-id : i64]
  [names : LowerNameCache]
  [out : lower_i64_i64_map.Map (:consume)]) : lower_i64_i64_map.Map
  (if (>= index (struct-get variants len))
    out
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(ast.AstDispatchVariant.Variant _ variant-name)
        (lower-dispatch-variant-set-add-list-from
          variants
          (+ index 1)
          module-id
          names
          (let
            [next-out : lower_i64_i64_map.Map out]
            (begin
              (lower_i64_i64_map.insert-ref!
                (&mut next-out)
                (lower-dispatch-variant-logical-id module-id names variant-name)
                1)
              next-out)))])))

(define (lower-dispatch-variant-set-add-list
  [variants : ast.AstDispatchVariantList]
  [module-id : i64]
  [names : LowerNameCache]
  [out : lower_i64_i64_map.Map (:consume)]) : lower_i64_i64_map.Map
  (lower-dispatch-variant-set-add-list-from (& variants) 0 module-id names out))

(define (lower-dispatch-variant-set-add-decl
  [decl : ast.AstDecl]
  [module-id : i64]
  [names : LowerNameCache]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (match decl
    [(ast.AstDecl.DefDispatch decl-meta _ variants)
      (lower-dispatch-variant-set-add-list variants module-id names out)]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-dispatch-variant-set-add-decl inner module-id names out))]
    [_ out]))

(define (lower-dispatch-variant-set-from-decls-in-module
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameCache]
  [out : lower_i64_i64_map.Map (:consume)]) : lower_i64_i64_map.Map
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [cur-out : lower_i64_i64_map.Map out]
    (begin
      (while (< index count)
        (let
          [decl : ast.AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          [decl-path : String
            (ast.ast-decl-path-list-get (& paths) index entry-path)]
          [logical-module-id : i64
            (lower-decl-owner-module-id
              (& paths)
              index
              entry-path
              decl-path
              cur-module-id)]
          (begin
            (match decl
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [_
                (set!
                  cur-out
                  (lower-dispatch-variant-set-add-decl
                    decl
                    logical-module-id
                    names
                    cur-out))])
            (set! index (+ index 1)))))
      cur-out)))

(define (lower-dispatch-variant-set-from-decls
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameCache]) : lower_i64_i64_map.Map
  (lower-dispatch-variant-set-from-decls-in-module
    decls
    paths
    entry-path
    names
    (lower_i64_i64_map.with-capacity 1024)))

(define (lower-reach-add-dispatch-variant-list-from
  [all-functions : lower_i64_i64_map.Map]
  [module-id : i64]
  [names : LowerNameCache]
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [state : LowerReachState (:consume)]) : LowerReachState
  (if (>= index (struct-get variants len))
    state
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(ast.AstDispatchVariant.Variant _ variant-name)
        (lower-reach-add-dispatch-variant-list-from
          all-functions
          module-id
          names
          variants
          (+ index 1)
          (lower-reach-add-logical
            all-functions
            state
            (lower-dispatch-variant-logical-id module-id names variant-name)))])))

(define (lower-reach-add-dispatch-variant-list
  [all-functions : lower_i64_i64_map.Map]
  [module-id : i64]
  [names : LowerNameCache]
  [variants : ast.AstDispatchVariantList]
  [state : LowerReachState (:consume)]) : LowerReachState
  (lower-reach-add-dispatch-variant-list-from
    all-functions
    module-id
    names
    (& variants)
    0
    state))

(define (lower-reach-add-dispatch-variant-decl
  [all-functions : lower_i64_i64_map.Map]
  [module-id : i64]
  [names : LowerNameCache]
  [decl : ast.AstDecl]
  [state : LowerReachState (:consume)]) : LowerReachState
  (match decl
    [(ast.AstDecl.DefDispatch decl-meta _ variants)
      (lower-reach-add-dispatch-variant-list
        all-functions
        module-id
        names
        variants
        state)]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-reach-add-dispatch-variant-decl
          all-functions
          module-id
          names
          inner
          state))]
    [_ state]))

(define (lower-reach-add-dispatch-variant-roots-in-module
  [all-functions : lower_i64_i64_map.Map]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]) : LowerReachState
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) state]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (match decl
          [(ast.AstDecl.Module next-module)
            (lower-reach-add-dispatch-variant-roots-in-module
              all-functions
              rest
              next-module
              names
              state)]
          [_
            (lower-reach-add-dispatch-variant-roots-in-module
              all-functions
              rest
              module-id
              names
              (lower-reach-add-dispatch-variant-decl
                all-functions
                module-id
                names
                decl
                state))]))]))

(define (lower-reach-add-dispatch-variant-roots
  [all-functions : lower_i64_i64_map.Map]
  [decls : ast.AstDeclList]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]) : LowerReachState
  (lower-reach-add-dispatch-variant-roots-in-module
    all-functions
    decls
    cbi.compiler-builtin-id-fix-empty
    names
    state))

;; `reachable` is keyed by dense `all-functions` slot; resolve a logical ID's
;; slot through the same map the reach walk used and test membership by i64.
(define (lower-reach-slot-set-contains-id?
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [logical-id : i64]) : bool
  (match (lower_i64_i64_map.get (& all-functions) logical-id)
    [(lower_i64_i64_map.LookupMissing) false]
    [(lower_i64_i64_map.LookupFound slot)
      (lower_i64_i64_map.contains? (& reachable) slot)]))

(define (lower-function-kept-by-reach-or-dispatch?
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [logical-id : i64]) : bool
  (or
    (lower-reach-slot-set-contains-id? all-functions reachable logical-id)
    (lower_i64_i64_map.contains? (& dispatch-variants) logical-id)))

(define (lower-used-type-name-leaf-id [name : i64]) : i64
  (let
    [source-id : i64 (tc_core.macro-hygiene-global-source-name-id-or name name)]
    [base-id : i64
      (if (tc_core.tc-name-qualified-id? source-id)
        (tc_core.tc-qualified-name-base-id source-id)
        source-id)]
    (if (and
      (>= base-id 0)
      (< base-id (ci.intern-capacity))
      (ci.intern-dotted? base-id))
      (ci.intern-dotted-final-id base-id)
      base-id)))

(define (lower-used-type-name-add
  [used : lower_i64_i64_map.Map (:consume)]
  [_module : String]
  [name : i64]) : lower_i64_i64_map.Map
  (let
    [with-source : lower_i64_i64_map.Map used]
    (begin
      (lower_i64_i64_map.insert-ref! (&mut with-source) name 1)
      (if (or
        (tc_core.tc-name-qualified-id? name)
        (>= (tc_core.tc-name-first-dot-id name) 0))
        (let
          [leaf : i64 (lower-used-type-name-leaf-id name)]
          (begin
            (if (< leaf 0)
              unit
              (lower_i64_i64_map.insert-ref! (&mut with-source) leaf 1))
            with-source))
        with-source))))

(define (lower-used-type-name-contains?
  [used : lower_i64_i64_map.Map]
  [_module : String]
  [name : i64]) : bool
  (if (lower_i64_i64_map.contains? (& used) name)
    true
    (if (or
      (tc_core.tc-name-qualified-id? name)
      (>= (tc_core.tc-name-first-dot-id name) 0))
      (let
        [leaf : i64 (lower-used-type-name-leaf-id name)]
        (and (>= leaf 0) (lower_i64_i64_map.contains? (& used) leaf)))
      false)))

(define (lower-used-types-precise-empty) : lower_i64_i64_map.Map
  (let
    [used : lower_i64_i64_map.Map (lower_i64_i64_map.with-capacity 8192)]
    (begin
      (lower_i64_i64_map.insert-ref!
        (&mut used)
        cbi.compiler-builtin-id-fix-dollar_lower_dot_precise_type_dce
        1)
      used)))

(define (lower-used-types-add-type-id
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [ty-id : i64]) : lower_i64_i64_map.Map
  (lower-used-types-add-type
    pools
    used
    module
    (ast.ast-node-pool-context-type-get pools ty-id)))

(define (lower-used-types-add-type-list
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [types : ast.AstTypeList]) : lower_i64_i64_map.Map
  (lower-used-types-add-type-list-at pools used module (& types) 0))

(define (lower-used-types-add-type-list-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast.ast-type-list-len types))
    used
    (lower-used-types-add-type-list-at
      pools
      (lower-used-types-add-type-id
        pools
        used
        module
        (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
      module
      types
      (+ index 1))))

(define (lower-used-types-add-type
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [ty : ast.AstType]) : lower_i64_i64_map.Map
  (match ty
    [(ast.AstType.Func args ret)
      (lower-used-types-add-type-id
        pools
        (lower-used-types-add-type-list pools used module (box-get args))
        module
        ret)]
    [(ast.AstType.Tuple elems)
      (lower-used-types-add-type-list pools used module (box-get elems))]
    [(ast.AstType.Array elem _)
      (lower-used-types-add-type-id pools used module elem)]
    [(ast.AstType.DynArray elem)
      (lower-used-types-add-type-id pools used module elem)]
    [(ast.AstType.Slice elem)
      (lower-used-types-add-type-id pools used module elem)]
    [(ast.AstType.Box elem)
      (lower-used-types-add-type-id pools used module elem)]
    [(ast.AstType.Region _ inner)
      (lower-used-types-add-type-id pools used module inner)]
    [(ast.AstType.Ref _ inner)
      (lower-used-types-add-type-id pools used module inner)]
    [(ast.AstType.MutRef _ inner)
      (lower-used-types-add-type-id pools used module inner)]
    [(ast.AstType.Enum name) (lower-used-type-name-add used module name)]
    [(ast.AstType.EnumArgs name _) (lower-used-type-name-add used module name)]
    [(ast.AstType.Struct name) (lower-used-type-name-add used module name)]
    [(ast.AstType.StructArgs name _)
      (lower-used-type-name-add used module name)]
    [(ast.AstType.Var name) (lower-used-type-name-add used module name)]
    [(ast.AstType.VarArgs name _) (lower-used-type-name-add used module name)]
    [(ast.AstType.Ptr inner)
      (lower-used-types-add-type-id pools used module inner)]
    [(ast.AstType.MutPtr inner)
      (lower-used-types-add-type-id pools used module inner)]
    [_ used]))

(define (lower-used-types-add-maybe-type
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [maybe-ty : ast.AstMaybeType]) : lower_i64_i64_map.Map
  (match maybe-ty
    [(ast.AstMaybeType.No) used]
    [(ast.AstMaybeType.Some ty)
      (lower-used-types-add-type pools used module ty)]))

(define (lower-used-types-add-param-list
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [params : ast.AstParamList]) : lower_i64_i64_map.Map
  (lower-used-types-add-param-list-at pools used module (& params) 0))

(define (lower-used-types-add-param-list-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [params : (& params ast.AstParamList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast.ast-param-list-len params))
    used
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param _ ty _ _)
        (lower-used-types-add-param-list-at
          pools
          (lower-used-types-add-type pools used module ty)
          module
          params
          (+ index 1))])))

(define (lower-used-types-add-macro-param-list
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [params : ast.AstMacroParamList]) : lower_i64_i64_map.Map
  (lower-used-types-add-macro-param-list-at pools used module (& params) 0))

(define (lower-used-types-add-macro-param-list-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast.ast-macro-param-list-len params))
    used
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(ast.AstMacroParam.Param _ ty _ _)
        (lower-used-types-add-macro-param-list-at
          pools
          (lower-used-types-add-type pools used module ty)
          module
          params
          (+ index 1))])))

(define (lower-used-types-add-expr-id
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [expr-id : i64]) : lower_i64_i64_map.Map
  (lower-used-types-add-expr
    pools
    used
    module
    (ast.ast-node-pool-context-expr-get pools expr-id)))

(define (lower-used-types-add-expr-list
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [exprs : ast.AstExprList]) : lower_i64_i64_map.Map
  (lower-used-types-add-expr-list-at pools used module (& exprs) 0))

(define (lower-used-types-add-expr-list-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get exprs len))
    used
    (lower-used-types-add-expr-list-at
      pools
      (lower-used-types-add-expr-id
        pools
        used
        module
        (ast.ast-expr-list-get exprs index 0))
      module
      exprs
      (+ index 1))))

(define (lower-used-types-add-pattern
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [pattern : ast.AstPattern]) : lower_i64_i64_map.Map
  (match pattern
    [(ast.AstPattern.Var _ maybe-ty)
      (lower-used-types-add-maybe-type pools used module maybe-ty)]
    [(ast.AstPattern.Tuple patterns-box)
      (lower-used-types-add-pattern-list
        pools
        used
        module
        (box-get patterns-box))]
    [(ast.AstPattern.Array patterns-box)
      (lower-used-types-add-pattern-list
        pools
        used
        module
        (box-get patterns-box))]
    [(ast.AstPattern.Wildcard) used]
    [(ast.AstPattern.Binding _) used]
    [(ast.AstPattern.Variant name patterns-box)
      (let
        ;; `name` is already the interned id; read the id-keyed metadata slots
        ;; directly instead of re-hashing `(tc-env-key-name-text name)` twice.
        [with-head : lower_i64_i64_map.Map
          (if (or
            (tc_core.tc-name-qualified-id? name)
            (>= (tc_core.tc-name-first-dot-id name) 0))
            (lower-used-type-name-add used module name)
            used)]
        (lower-used-types-add-pattern-list
          pools
          with-head
          module
          (box-get patterns-box)))]
    [(ast.AstPattern.Literal _) used]))

(define (lower-used-types-add-pattern-list
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [patterns : ast.AstPatternList]) : lower_i64_i64_map.Map
  (lower-used-types-add-pattern-list-at pools used module (& patterns) 0))

(define (lower-used-types-add-pattern-list-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get patterns len))
    used
    (lower-used-types-add-pattern-list-at
      pools
      (lower-used-types-add-pattern
        pools
        used
        module
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback)))
      module
      patterns
      (+ index 1))))

(define (lower-used-types-add-let-bindings
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [bindings : ast.AstLetBindingList]) : lower_i64_i64_map.Map
  (lower-used-types-add-let-bindings-at pools used module (& bindings) 0))

(define (lower-used-types-add-let-bindings-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast.ast-let-binding-list-len bindings))
    used
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ maybe-ty value-box)
        (lower-used-types-add-let-bindings-at
          pools
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-maybe-type pools used module maybe-ty)
            module
            value-box)
          module
          bindings
          (+ index 1))])))

(define (lower-used-types-add-match-arms
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [arms : ast.AstMatchArmList]) : lower_i64_i64_map.Map
  (lower-used-types-add-match-arms-at pools used module (& arms) 0))

(define (lower-used-types-add-match-arms-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get arms len))
    used
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (lower-used-types-add-match-arms-at
          pools
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-pattern pools used module pattern)
            module
            body-box)
          module
          arms
          (+ index 1))])))

(define (lower-used-types-add-resource-bindings
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [bindings : ast.AstResourceBindingList]) : lower_i64_i64_map.Map
  (lower-used-types-add-resource-bindings-at pools used module (& bindings) 0))

(define (lower-used-types-add-resource-bindings-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    used
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding _ acquire-box cleanup-box _)
        (lower-used-types-add-resource-bindings-at
          pools
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-expr-id pools used module acquire-box)
            module
            cleanup-box)
          module
          bindings
          (+ index 1))])))

(define (lower-used-types-add-expr
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [expr : ast.AstExpr]) : lower_i64_i64_map.Map
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.Literal _) used]
    [(ast.AstExpr.Var _) used]
    [(ast.AstExpr.Binary _ lhs-box rhs-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module lhs-box)
        module
        rhs-box)]
    [(ast.AstExpr.Unary _ inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.Call callee-box args)
      (lower-used-types-add-expr-list
        pools
        (lower-used-types-add-expr-id pools used module callee-box)
        module
        args)]
    [(ast.AstExpr.If cond-box then-box else-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id
          pools
          (lower-used-types-add-expr-id pools used module cond-box)
          module
          then-box)
        module
        else-box)]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-let-bindings pools used module bindings)
            module
            body-box)])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda params ret body-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-maybe-type
              pools
              (lower-used-types-add-param-list pools used module params)
              module
              ret)
            module
            body-box)])]
    [(ast.AstExpr.Tuple values)
      (lower-used-types-add-expr-list pools used module values)]
    [(ast.AstExpr.TupleRef value-box _)
      (lower-used-types-add-expr-id pools used module value-box)]
    [(ast.AstExpr.Array values)
      (lower-used-types-add-expr-list pools used module values)]
    [(ast.AstExpr.DynArray values)
      (lower-used-types-add-expr-list pools used module values)]
    [(ast.AstExpr.MakeArray ty-id len-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type
          pools
          used
          module
          (ast.ast-node-pool-context-type-get pools ty-id))
        module
        len-box)]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module array-box)
        module
        index-box)]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id
          pools
          (lower-used-types-add-expr-id pools used module array-box)
          module
          index-box)
        module
        value-box)]
    [(ast.AstExpr.ArrayTake array-box live-box index-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id
          pools
          (lower-used-types-add-expr-id pools used module array-box)
          module
          live-box)
        module
        index-box)]
    [(ast.AstExpr.FixedArrayTake array-box index-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module array-box)
        module
        index-box)]
    [(ast.AstExpr.ArrayPush array-box value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module array-box)
        module
        value-box)]
    [(ast.AstExpr.StringRef text-box index-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module text-box)
        module
        index-box)]
    [(ast.AstExpr.While cond-box body-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module cond-box)
        module
        body-box)]
    [(ast.AstExpr.ForOwnedState payload)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id
          pools
          used
          module
          (ast.ast-for-owned-state-source (& payload)))
        module
        (ast.ast-for-owned-state-body (& payload)))]
    [(ast.AstExpr.ForOwnedStep payload)
      (let
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        (lower-used-types-add-expr-id
          pools
          (if (>= expected-type 0)
            (lower-used-types-add-expr-id pools used module expected-type)
            used)
          module
          (ast.ast-for-owned-step-body (& payload))))]
    [(ast.AstExpr.Begin exprs)
      (lower-used-types-add-expr-list pools used module exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (lower-used-types-add-expr-list pools used module exprs)]
    [(ast.AstExpr.Set _ value-box)
      (lower-used-types-add-expr-id pools used module value-box)]
    [(ast.AstExpr.Ann inner-box ty-id)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type
          pools
          used
          module
          (ast.ast-node-pool-context-type-get pools ty-id))
        module
        inner-box)]
    [(ast.AstExpr.Cast inner-box ty-id)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type
          pools
          used
          module
          (ast.ast-node-pool-context-type-get pools ty-id))
        module
        inner-box)]
    [(ast.AstExpr.Borrow _ _ inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match value-box arms)
          (lower-used-types-add-match-arms
            pools
            (lower-used-types-add-expr-id pools used module value-box)
            module
            arms)])]
    [(ast.AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(ast.AstForeach.Foreach _ index-ty start-box end-box body-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-expr-id
              pools
              (lower-used-types-add-expr-id
                pools
                (lower-used-types-add-type pools used module index-ty)
                module
                start-box)
              module
              end-box)
            module
            body-box)])]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(ast.AstSpmdReduce.Reduce
            _
            _
            index-ty
            source-box
            init-box
            map-expr-box
            reduce-expr-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-expr-id
              pools
              (lower-used-types-add-expr-id
                pools
                (lower-used-types-add-expr-id
                  pools
                  (lower-used-types-add-type pools used module index-ty)
                  module
                  source-box)
                module
                init-box)
              module
              map-expr-box)
            module
            reduce-expr-box)])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(ast.AstSpmdScan.Scan
            _
            _
            index-ty
            start-box
            end-box
            _
            prefix-ty
            init-box
            value-box
            body-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-expr-id
              pools
              (lower-used-types-add-expr-id
                pools
                (lower-used-types-add-expr-id
                  pools
                  (lower-used-types-add-expr-id
                    pools
                    (lower-used-types-add-type
                      pools
                      (lower-used-types-add-type pools used module index-ty)
                      module
                      prefix-ty)
                    module
                    start-box)
                  module
                  end-box)
                module
                init-box)
              module
              value-box)
            module
            body-box)])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module value-box)
        module
        lane-box)]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module value-box)
        module
        lane-box)]
    [(ast.AstExpr.StructGet value-box _)
      (lower-used-types-add-expr-id pools used module value-box)]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module receiver-box)
        module
        value-box)]
    [(ast.AstExpr.WithRegion _ exprs)
      (lower-used-types-add-expr-list pools used module exprs)]
    [(ast.AstExpr.WithEscape scratch-box exprs)
      (lower-used-types-add-expr-list
        pools
        (lower-used-types-add-expr-id pools used module scratch-box)
        module
        exprs)]
    [(ast.AstExpr.WithScratch exprs)
      (lower-used-types-add-expr-list pools used module exprs)]
    [(ast.AstExpr.InArena arena-box exprs)
      (lower-used-types-add-expr-list
        pools
        (lower-used-types-add-expr-id pools used module arena-box)
        module
        exprs)]
    [(ast.AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (lower-used-types-add-expr-list
            pools
            (lower-used-types-add-resource-bindings pools used module bindings)
            module
            body)])]
    [(ast.AstExpr.Box inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.BoxGet inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.BoxTake inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module inner-box)
        module
        value-box)]
    [(ast.AstExpr.TypeLiteral ty-id)
      (lower-used-types-add-type
        pools
        used
        module
        (ast.ast-node-pool-context-type-get pools ty-id))]
    [(ast.AstExpr.Init maybe-ty-id)
      (lower-used-types-add-maybe-type
        pools
        used
        module
        (ast.ast-maybe-type-from-id-with-pools pools maybe-ty-id))]
    [(ast.AstExpr.Comptime inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.Quote _) used]
    [(ast.AstExpr.Quasiquote _) used]
    [(ast.AstExpr.Unquote inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.UnquoteSplicing inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.BracketClause items)
      (lower-used-types-add-expr-list pools used module items)]
    [(ast.AstExpr.Try inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.Return inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.Break) used]
    [(ast.AstExpr.Continue) used]
    [(ast.AstExpr.PtrNull ty-id)
      (lower-used-types-add-type
        pools
        used
        module
        (ast.ast-node-pool-context-type-get pools ty-id))]
    [(ast.AstExpr.PtrNullCheck value-box)
      (lower-used-types-add-expr-id pools used module value-box)]
    [(ast.AstExpr.PtrAddrOf place-box)
      (lower-used-types-add-expr-id pools used module place-box)]
    [(ast.AstExpr.PtrRead ptr-box)
      (lower-used-types-add-expr-id pools used module ptr-box)]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module ptr-box)
        module
        value-box)]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module ptr-box)
        module
        offset-box)]
    [(ast.AstExpr.PtrCast ptr-box ty-id)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type
          pools
          used
          module
          (ast.ast-node-pool-context-type-get pools ty-id))
        module
        ptr-box)]
    [(ast.AstExpr.PtrToInt ptr-box)
      (lower-used-types-add-expr-id pools used module ptr-box)]
    [(ast.AstExpr.IntToPtr value-box ty-id)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type
          pools
          used
          module
          (ast.ast-node-pool-context-type-get pools ty-id))
        module
        value-box)]
    [(ast.AstExpr.StringData inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module ptr-box)
        module
        len-box)]
    [(ast.AstExpr.ArrayData inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(ast.AstExpr.BinaryData _) used]
    [(ast.AstExpr.SpmdProgramIndex) used]
    [(ast.AstExpr.SpmdProgramCount) used]
    [(ast.AstExpr.ProgramArgc) used]
    [(ast.AstExpr.ProgramArgv) used]
    [(ast.AstExpr.ProgramEnvp) used]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module leaf-box)
        module
        subleaf-box)]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module leaf-box)
        module
        subleaf-box)]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module leaf-box)
        module
        subleaf-box)]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module leaf-box)
        module
        subleaf-box)]
    [(ast.AstExpr.Xgetbv index-box)
      (lower-used-types-add-expr-id pools used module index-box)]
    [(ast.AstExpr.Syscall args)
      (lower-used-types-add-expr-list pools used module args)]))

(define (lower-used-types-add-field-list
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [fields : ast.AstFieldDefList]) : lower_i64_i64_map.Map
  (lower-used-types-add-field-list-at pools used module (& fields) 0))

(define (lower-used-types-add-field-list-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get fields len))
    used
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(ast.AstFieldDef.Def _ ty _)
        (lower-used-types-add-field-list-at
          pools
          (lower-used-types-add-type pools used module ty)
          module
          fields
          (+ index 1))])))

(define (lower-used-types-add-variant-list
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [variants : ast.AstVariantDefList]) : lower_i64_i64_map.Map
  (lower-used-types-add-variant-list-at pools used module (& variants) 0))

(define (lower-used-types-add-variant-list-at
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get variants len))
    used
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def _ fields _)
        (lower-used-types-add-variant-list-at
          pools
          (lower-used-types-add-type-list pools used module fields)
          module
          variants
          (+ index 1))])))

(define (lower-type-decl? [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.DefEnum decl-meta _ _ _) true]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ _ _) true]
    [(ast.AstDecl.DefStruct decl-meta _ _ _ _) true]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ _ _) true]
    [(ast.AstDecl.Unsafe inner-box) (lower-type-decl? (box-get inner-box))]
    [_ false]))

(define (lower-type-decl-used?
  [module : String]
  [used-types : lower_i64_i64_map.Map]
  [decl : ast.AstDecl]) : bool
  ;; Empty is the fast-path marker for "all type declaration paths are already
  ;; reachable"; precise DCE starts from lower-used-types-precise-empty instead.
  (if (= (lower_i64_i64_map.len (& used-types)) 0)
    true
    (match decl
      [(ast.AstDecl.DefEnum decl-meta name _ variants)
        (lower-used-type-name-contains? used-types module name)]
      [(ast.AstDecl.DefEnumLifetimes decl-meta name _ _ variants)
        (lower-used-type-name-contains? used-types module name)]
      [(ast.AstDecl.DefStruct decl-meta name _ _ _)
        (lower-used-type-name-contains? used-types module name)]
      [(ast.AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
        (lower-used-type-name-contains? used-types module name)]
      [(ast.AstDecl.Unsafe inner-box)
        (lower-type-decl-used? module used-types (box-get inner-box))]
      [_ true])))

(define (lower-used-types-add-kept-runtime-decl
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [decl : ast.AstDecl]) : lower_i64_i64_map.Map
  (match decl
    [(ast.AstDecl.Def decl-meta _ maybe-ty _)
      (lower-used-types-add-maybe-type pools used module maybe-ty)]
    [(ast.AstDecl.DefFn decl-meta _ params ret _ _)
      (lower-used-types-add-type
        pools
        (lower-used-types-add-param-list pools used module params)
        module
        ret)]
    [(ast.AstDecl.DefMacro decl-meta _ params ret _)
      (lower-used-types-add-type
        pools
        (lower-used-types-add-macro-param-list pools used module params)
        module
        ret)]
    [(ast.AstDecl.Extern decl-meta _ _ _ ty)
      (lower-used-types-add-type pools used module ty)]
    [(ast.AstDecl.DefEnum decl-meta _ _ _) used]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ _ _) used]
    [(ast.AstDecl.DefStruct decl-meta _ _ _ _) used]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ _ _) used]
    [(ast.AstDecl.Test _ body-box _)
      (lower-used-types-add-expr-id pools used module body-box)]
    [(ast.AstDecl.Unsafe inner-box)
      (lower-used-types-add-kept-runtime-decl
        pools
        used
        module
        (box-get inner-box))]
    [_ used]))

;; A synthesized clone$<T> helper (`stdlib/clone.tl`). Clone helpers are
;; generated as the exact transitive closure the reachable clone roots need and
;; reference one another through `(clone x)` forms the AST reachability walk does
;; not resolve to names, so a reachable helper's callees would otherwise be
;; dropped (undefined-symbol link error). Keep every synthesized helper.
(define (lower-decl-is-clone-helper-inner? [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (lower-name-has-clone-prefix? (tc_core.tc-env-key-name-text name))]
    [(ast.AstDecl.Unsafe inner-box)
      (lower-decl-is-clone-helper? (box-get inner-box))]
    [_ false]))

(define (lower-decl-is-clone-helper? [decl : ast.AstDecl]) : bool
  (match (ast.ast-decl-generated-meta decl)
    [(ast.AstGeneratedDeclMeta.Some generator _ _ _)
      (if (string.eq generator "stdlib.clone/synthesize-helpers")
        true
        (lower-decl-is-clone-helper-inner? decl))]
    [(ast.AstGeneratedDeclMeta.No) (lower-decl-is-clone-helper-inner? decl)]))

(define (lower-runtime-decl-kept-by-reach-or-dispatch?
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [decl : ast.AstDecl]) : bool
  (if (lower-decl-is-clone-helper? decl)
    ;; The clone handoff emits exactly the clone$<T> closure reachable code
    ;; needs, so keep it all.
    true
    (match (lower-function-logical-id-from-decl
      entry-path
      decl-path
      module
      module-id
      decl)
      [(LowerNameCacheMaybeId.Some logical-id)
        (lower-function-kept-by-reach-or-dispatch?
          all-functions
          reachable
          dispatch-variants
          logical-id)]
      [(LowerNameCacheMaybeId.No) true])))

(define (lower-used-types-add-type-decl-name
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [decl : ast.AstDecl]) : lower_i64_i64_map.Map
  (match decl
    [(ast.AstDecl.DefEnum decl-meta name _ _)
      (lower-used-type-name-add used module name)]
    [(ast.AstDecl.DefEnumLifetimes decl-meta name _ _ _)
      (lower-used-type-name-add used module name)]
    [(ast.AstDecl.DefStruct decl-meta name _ _ _)
      (lower-used-type-name-add used module name)]
    [(ast.AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
      (lower-used-type-name-add used module name)]
    [(ast.AstDecl.Unsafe inner-box)
      (lower-used-types-add-type-decl-name
        pools
        used
        module
        (box-get inner-box))]
    [_ used]))

(define (lower-used-types-path-seed-in-module
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module : String]
  [reachable-paths : (& reachable-paths lower_i64_i64_map.Map)]
  [used : lower_i64_i64_map.Map (:consume)]
  [covered : bool]) : LowerUsedTypePathSeed
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) (LowerUsedTypePathSeed.Seed used covered)]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
        [path-owner-id : i64
          (ast.ast-decl-path-list-owner-id
            (& paths)
            0
            (csym.compiler-symbol-root-module-id))]
        (match decl
          [(ast.AstDecl.Module next-module)
            (lower-used-types-path-seed-in-module
              pools
              rest
              rest-paths
              entry-path
              (ci.intern-str next-module)
              reachable-paths
              used
              covered)]
          [_
            (let
              [is-type-decl : bool (lower-type-decl? decl)]
              [path-covered : bool
                (lower_i64_i64_map.contains? (& reachable-paths) path-owner-id)]
              (lower-used-types-path-seed-in-module
                pools
                rest
                rest-paths
                entry-path
                module
                reachable-paths
                (if (and is-type-decl path-covered)
                  (lower-used-types-add-type-decl-name pools used module decl)
                  used)
                (and covered (or (not is-type-decl) path-covered))))]))]))

(define (lower-used-types-from-kept-decls-in-module
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [used : lower_i64_i64_map.Map (:consume)]) : lower_i64_i64_map.Map
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) used]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons path _) path]
            [(ast.AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
        (match decl
          [(ast.AstDecl.Module next-module)
            (lower-used-types-from-kept-decls-in-module
              pools
              rest
              rest-paths
              entry-path
              (ci.intern-str next-module)
              next-module
              all-functions
              reachable
              dispatch-variants
              used)]
          [_
            (lower-used-types-from-kept-decls-in-module
              pools
              rest
              rest-paths
              entry-path
              module
              module-id
              all-functions
              reachable
              dispatch-variants
              (if (lower-runtime-decl-kept-by-reach-or-dispatch?
                entry-path
                decl-path
                module
                module-id
                all-functions
                reachable
                dispatch-variants
                decl)
                (lower-used-types-add-kept-runtime-decl pools used module decl)
                used))]))]))

(define (lower-used-types-add-stdlib-arena-support-deps
  [_pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map (:consume)]
  [module : String]
  [name : i64]) : lower_i64_i64_map.Map
  ;; `in-arena` and allocation lowering use the arena mark support type even
  ;; when source signatures only mention the public Arena wrapper.
  (if (and
    (string.eq module "stdlib.arena")
    (string.eq (tc_core.tc-env-key-name-text name) "Arena"))
    (lower-used-type-name-add used module cbi.compiler-builtin-id-fix-ArenaMark)
    used))

(define (lower-used-types-add-type-decl-deps
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [decl : ast.AstDecl]) : lower_i64_i64_map.Map
  (match decl
    [(ast.AstDecl.DefEnum decl-meta _ _ variants)
      (lower-used-types-add-variant-list pools used module variants)]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ _ variants)
      (lower-used-types-add-variant-list pools used module variants)]
    [(ast.AstDecl.DefStruct decl-meta name _ _ fields)
      (lower-used-types-add-field-list
        pools
        (lower-used-types-add-stdlib-arena-support-deps pools used module name)
        module
        fields)]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ _ fields)
      (lower-used-types-add-field-list pools used module fields)]
    [(ast.AstDecl.Unsafe inner-box)
      (lower-used-types-add-type-decl-deps
        pools
        used
        module
        (box-get inner-box))]
    [_ used]))

(define (lower-used-types-add-type-decl-deps-in-module
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [module : String]
  [used : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  ;; Index cursor rather than `ast-decl-list-step`. The predicates and the
  ;; dependency walk all take `AstDecl` by value, but an aggregate argument is
  ;; passed by reference, so handing them the backing slot costs nothing where
  ;; the step copied 104 B and wrote a 144 B result per declaration.
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-slots : (__tl_dyn-array ast.AstDecl) (struct-get decls slots)]
    [decl-offset : i64 (struct-get decls offset)]
    [index : i64 0]
    [current-module : String module]
    [current-used : lower_i64_i64_map.Map used]
    (begin
      (while (< index count)
        (begin
          (match (array-ref decl-slots (+ decl-offset index))
            [(ast.AstDecl.Module next-module)
              (set! current-module (ci.intern-str next-module))]
            [_
              (if (and
                (lower-type-decl? (array-ref decl-slots (+ decl-offset index)))
                (or
                  (lower-comptime-runtime-skip-module? current-module)
                  (lower-type-decl-used?
                    current-module
                    current-used
                    (array-ref decl-slots (+ decl-offset index)))))
                (set!
                  current-used
                  (lower-used-types-add-type-decl-deps
                    pools
                    current-used
                    current-module
                    (array-ref decl-slots (+ decl-offset index))))
                unit)])
          (set! index (+ index 1))))
      current-used)))

(define (lower-used-types-expand-fixed
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [used : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (let
    [current : lower_i64_i64_map.Map used]
    [iterations : i64 0]
    [done : bool false]
    (begin
      (while (not done)
        (let
          [before : i64 (lower_i64_i64_map.len (& current))]
          [next : lower_i64_i64_map.Map
            (lower-used-types-add-type-decl-deps-in-module
              pools
              decls
              ""
              current)]
          (begin
            (set! current next)
            (set! iterations (+ iterations 1))
            (if (or
              (= before (lower_i64_i64_map.len (& current)))
              (>= iterations 8))
              (set! done true)
              unit))))
      current)))

(define (lower-comptime-runtime-skip-module? [module : String]) : bool
  (string.eq module "stdlib.comptime"))

(define lower-comptime-error-id-generation : i64
  -1)
(define lower-comptime-error-id : i64
  0)
(define lower-comptime-error-comptime-dot-id : i64
  0)
(define lower-comptime-error-comptime-slash-id : i64
  0)
(define lower-comptime-error-comptime-error-dot-id : i64
  0)
(define lower-comptime-error-comptime-error-slash-id : i64
  0)
(define lower-comptime-error-stdlib-dot-dot-id : i64
  0)
(define lower-comptime-error-stdlib-dot-slash-id : i64
  0)
(define lower-comptime-error-stdlib-slash-dot-id : i64
  0)
(define lower-comptime-error-stdlib-slash-slash-id : i64
  0)
(define lower-comptime-error-stdlib-error-dot-dot-id : i64
  0)
(define lower-comptime-error-stdlib-error-dot-slash-id : i64
  0)
(define lower-comptime-error-stdlib-error-slash-dot-id : i64
  0)
(define lower-comptime-error-stdlib-error-slash-slash-id : i64
  0)

(define (lower-comptime-error-ids-ensure!) : unit
  (if (= lower-comptime-error-id-generation (ci.intern-generation))
    unit
    (begin
      (set! lower-comptime-error-id cbi.compiler-builtin-id-fix-comptime_error)
      (set!
        lower-comptime-error-comptime-dot-id
        cbi.compiler-builtin-id-fix-comptime_dot_comptime_error)
      (set!
        lower-comptime-error-comptime-slash-id
        cbi.compiler-builtin-id-fix-comptime_dot_comptime_error)
      (set!
        lower-comptime-error-comptime-error-dot-id
        cbi.compiler-builtin-id-fix-comptime_dot_error)
      (set!
        lower-comptime-error-comptime-error-slash-id
        cbi.compiler-builtin-id-fix-comptime_dot_error)
      (set!
        lower-comptime-error-stdlib-dot-dot-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_comptime_error)
      (set!
        lower-comptime-error-stdlib-dot-slash-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_comptime_error)
      (set!
        lower-comptime-error-stdlib-slash-dot-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_comptime_error)
      (set!
        lower-comptime-error-stdlib-slash-slash-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_comptime_error)
      (set!
        lower-comptime-error-stdlib-error-dot-dot-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_error)
      (set!
        lower-comptime-error-stdlib-error-dot-slash-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_error)
      (set!
        lower-comptime-error-stdlib-error-slash-dot-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_error)
      (set!
        lower-comptime-error-stdlib-error-slash-slash-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_error)
      (set! lower-comptime-error-id-generation (ci.intern-generation)))))

(define (lower-comptime-error-call-id-with-cache? [id : i64]) : bool
  (or
    (= id lower-comptime-error-id)
    (= id lower-comptime-error-comptime-dot-id)
    (= id lower-comptime-error-comptime-slash-id)
    (= id lower-comptime-error-comptime-error-dot-id)
    (= id lower-comptime-error-comptime-error-slash-id)
    (= id lower-comptime-error-stdlib-dot-dot-id)
    (= id lower-comptime-error-stdlib-dot-slash-id)
    (= id lower-comptime-error-stdlib-slash-dot-id)
    (= id lower-comptime-error-stdlib-slash-slash-id)
    (= id lower-comptime-error-stdlib-error-dot-dot-id)
    (= id lower-comptime-error-stdlib-error-dot-slash-id)
    (= id lower-comptime-error-stdlib-error-slash-dot-id)
    (= id lower-comptime-error-stdlib-error-slash-slash-id)))

(define (lower-comptime-error-call-id? [id : i64]) : bool
  (begin
    (lower-comptime-error-ids-ensure!)
    (lower-comptime-error-call-id-with-cache? id)))

(define (lower-comptime-error-source-or-lookup-id?
  [source-id : i64]
  [lookup-id : i64]) : bool
  (begin
    (lower-comptime-error-ids-ensure!)
    (or
      (= source-id lower-comptime-error-id)
      (= source-id lower-comptime-error-comptime-dot-id)
      (= source-id lower-comptime-error-comptime-slash-id)
      (= source-id lower-comptime-error-comptime-error-dot-id)
      (= source-id lower-comptime-error-comptime-error-slash-id)
      (= source-id lower-comptime-error-stdlib-dot-dot-id)
      (= source-id lower-comptime-error-stdlib-dot-slash-id)
      (= source-id lower-comptime-error-stdlib-slash-dot-id)
      (= source-id lower-comptime-error-stdlib-slash-slash-id)
      (= source-id lower-comptime-error-stdlib-error-dot-dot-id)
      (= source-id lower-comptime-error-stdlib-error-dot-slash-id)
      (= source-id lower-comptime-error-stdlib-error-slash-dot-id)
      (= source-id lower-comptime-error-stdlib-error-slash-slash-id)
      (lower-comptime-error-call-id-with-cache? lookup-id))))

(define (lower-decl-kept-by-reach-or-dispatch?
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [used-types : lower_i64_i64_map.Map]
  [decl : ast.AstDecl]) : bool
  (if (lower-type-decl? decl)
    (or
      (lower-comptime-runtime-skip-module? module)
      (lower-type-decl-used? module used-types decl))
    (lower-runtime-decl-kept-by-reach-or-dispatch?
      entry-path
      decl-path
      module
      module-id
      all-functions
      reachable
      dispatch-variants
      decl)))

(define (lower-filter-reachable-decls-paths-and-plan
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [used-types : lower_i64_i64_map.Map]) : LowerFilteredReachableWithPlan
  ;; The first reachability walk must materialize a program for clone-root
  ;; discovery. Record its decision for every source declaration at the same
  ;; time. Clone augmentation preserves source order and appends helpers, so
  ;; this dense plan can be applied after whole-program typecheck without
  ;; rebuilding the function/body/dispatch/type reachability indexes.
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [out : ast.AstDeclList (ast.ast-decl-list-with-capacity count)]
    [out-paths : ast.AstDeclPathList
      (ast.ast-decl-path-list-with-capacity count)]
    [keep : (__tl_dyn-array i64) (make-array i64 count)]
    [source-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [decl : ast.AstDecl
            (ast.ast-decl-list-get (& decls) index (ast.ast-decl-fallback))]
          [decl-path : String
            (ast.ast-decl-path-list-get (& paths) index entry-path)]
          [logical-module-id : i64
            (lower-decl-owner-module-id
              (& paths)
              index
              entry-path
              decl-path
              source-module-id)]
          [kept : bool
            (match decl
              [(ast.AstDecl.Module _) true]
              [_
                (lower-decl-kept-by-reach-or-dispatch?
                  entry-path
                  decl-path
                  (lower-decl-owner-module-name
                    source-module-id
                    logical-module-id)
                  logical-module-id
                  all-functions
                  reachable
                  dispatch-variants
                  used-types
                  decl)])]
          (begin
            (if kept
              (begin
                (array-set! keep index 1)
                (ast.ast-decl-list-push (&mut out) decl)
                (ast.ast-decl-path-list-push-with-owner-id
                  (&mut out-paths)
                  decl-path
                  (ast.ast-decl-path-list-owner-id
                    (& paths)
                    index
                    source-module-id)))
              unit)
            (match decl
              [(ast.AstDecl.Module next-module)
                (set! source-module-id next-module)]
              [_ unit])
            (set! index (+ index 1)))))
      (LowerFilteredReachableWithPlan.Filtered
        out
        out-paths
        (LowerDeclKeepPlan keep count)))))

(define (lower-decl-keep-plan-all [count : i64]) : LowerDeclKeepPlan
  (let
    [keep : (__tl_dyn-array i64) (make-array i64 count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set! keep index 1)
          (set! index (+ index 1))))
      (LowerDeclKeepPlan keep count))))

(define (lower-decl-required-by-clone-roots?
  [roots : clone_support.CloneNameSet]
  [module-id : i64]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.DefEnum decl-meta name _ _)
      (clone_support.clone-name-set-contains-canonical-id? roots module-id name)]
    [(ast.AstDecl.DefStruct decl-meta name _ _ _)
      (clone_support.clone-name-set-contains-canonical-id? roots module-id name)]
    [(ast.AstDecl.Unsafe inner-box)
      (lower-decl-required-by-clone-roots? roots module-id (box-get inner-box))]
    [_ false]))

(define (lower-decl-keep-plan-add-clone-roots
  [plan : LowerDeclKeepPlan]
  [program : ast.AstProgram]
  [clone-roots : clone_support.CloneRootEntries]) : LowerDeclKeepPlan
  ;; Clone-root discovery already computes the exact transitive nominal-type
  ;; closure required by generated helpers. Merge those type declarations into
  ;; the retained plan before source-pool compaction can release their AST.
  (match program
    [(ast.AstProgram.Program decls-box)
      (let
        [decls : ast.AstDeclList (box-get decls-box)]
        [keep : (__tl_dyn-array i64) (struct-get plan keep)]
        [source-count : i64 (struct-get plan source-count)]
        [roots : clone_support.CloneNameSet
          (clone_support.clone-root-entries-to-set
            clone-roots
            (clone_support.clone-name-set-empty))]
        [module-id : i64 cbi.compiler-builtin-id-fix-empty]
        [index : i64 0]
        [count : i64 (ast.ast-decl-list-len (& decls))]
        (begin
          (while (and (< index count) (< index source-count))
            (let
              [decl : ast.AstDecl
                (ast.ast-decl-list-get (& decls) index (ast.ast-decl-fallback))]
              (begin
                (if (lower-decl-required-by-clone-roots? roots module-id decl)
                  (array-set! keep index 1)
                  unit)
                (match decl
                  [(ast.AstDecl.Module next-module)
                    (set! module-id next-module)]
                  [_ unit])
                (set! index (+ index 1)))))
          (LowerDeclKeepPlan keep source-count)))]))

(define (lower-decl-keep-plan-copy-into-pools
  [plan : LowerDeclKeepPlan]
  [pools : ast.AstNodePoolContext]) : LowerDeclKeepPlan
  (let
    [base-arena : arena.Arena
      (arena.Arena (ast.ast-node-pool-context-base-arena pools))]
    (in-arena
      base-arena
      (let
        [source : (__tl_dyn-array i64) (struct-get plan keep)]
        [count : i64 (struct-get plan source-count)]
        [keep : (__tl_dyn-array i64) (make-array i64 count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (array-set! keep index (array-ref source index))
              (set! index (+ index 1))))
          (ast.ast-node-pool-context-sync-base-arena!
            pools
            (arena.tl_arena_current))
          (LowerDeclKeepPlan keep count))))))

(define (lower-decl-keep-plan-apply
  [plan : LowerDeclKeepPlan]
  [program : ast.AstProgram]) : ast.AstProgram
  ;; Source declarations retain their indices through clone augmentation;
  ;; generated clone helpers are appended and all are part of the exact root
  ;; closure, so retain them without another graph walk.
  (match program
    [(ast.AstProgram.Program decls-box)
      (let
        [decls : ast.AstDeclList (box-get decls-box)]
        [count : i64 (ast.ast-decl-list-len (& decls))]
        [source-count : i64 (struct-get plan source-count)]
        [keep : (__tl_dyn-array i64) (struct-get plan keep)]
        [out : ast.AstDeclList (ast.ast-decl-list-with-capacity count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (if (or
                (>= index source-count)
                (not (= (array-ref keep index) 0)))
                (ast.ast-decl-list-push
                  (&mut out)
                  (ast.ast-decl-list-get
                    (& decls)
                    index
                    (ast.ast-decl-fallback)))
                unit)
              (set! index (+ index 1))))
          (ast.ast-program out)))]))

(define (lower-decl-keep-plan-apply-paths
  [plan : LowerDeclKeepPlan]
  [paths : ast.AstDeclPathList]) : ast.AstDeclPathList
  (let
    [source-count : i64 (struct-get plan source-count)]
    [keep : (__tl_dyn-array i64) (struct-get plan keep)]
    [count : i64 (ast.ast-decl-path-list-len (& paths))]
    [limit : i64
      (if (< source-count count)
        source-count
        count)]
    [out : ast.AstDeclPathList (ast.ast-decl-path-list-with-capacity limit)]
    [index : i64 0]
    (begin
      (while (< index limit)
        (begin
          (when
            (not (= (array-ref keep index) 0))
            (ast.ast-decl-path-list-push-with-owner-id
              (&mut out)
              (ast.ast-decl-path-list-get (& paths) index "")
              (ast.ast-decl-path-list-owner-id
                (& paths)
                index
                cbi.compiler-builtin-id-fix-empty)))
          (set! index (+ index 1))))
      out)))

(defenum LowerReachStateCell
  (Occupied LowerReachState))

(define (lower-reach-add-clone-root-helpers
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [roots : clone_support.CloneRootEntries]
  [state : LowerReachState (:consume)]) : LowerReachState
  (let
    [cell : LowerReachStateCell (LowerReachStateCell.Occupied state)]
    [index : i64 0]
    [count : i64 (clone_support.clone-root-entries-len roots)]
    (begin
      (while (< index count)
        (match cell
          [(LowerReachStateCell.Occupied current)
            (set!
              cell
              (LowerReachStateCell.Occupied
                (lower-reach-add-source-id
                  all-functions
                  names
                  current
                  (clone_support.clone-root-entries-helper-id-at-or
                    roots
                    index
                    -1))))])
        (set! index (+ index 1)))
      (match cell
        [(LowerReachStateCell.Occupied result) result]))))

;; Functions with an `(:export-symbol ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦)` declaration publish a fixed
;; ABI symbol and may be called only from outside TypeLisp IR (e.g. the
;; backend-emitted bounds/division/shift checks call the runtime-prelude
;; handlers). Seed every exported function as a reachability root so the prune
;; keeps it and its transitive callees even with no IR caller.
(define (lower-reach-add-export-root-decl
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [state : LowerReachState (:consume)]
  [decl : ast.AstDecl]) : LowerReachState
  (match decl
    [(ast.AstDecl.DefFn decl-meta name _ _ _ metadata)
      (let
        [logical-name-id : i64 (lower-module-name-key-id-by-id module-id name)]
        [export-state : LowerReachState
          (match (ast.ast-fn-metadata-export metadata)
            [(ast.AstFnExport.Export symbol)
              (if (lower-runtime-prelude-selective-export-id? module-id symbol)
                state
                (lower-reach-add-logical all-functions state logical-name-id))]
            [(ast.AstFnExport.No) state])]
        (match (ast.ast-fn-metadata-spmd-callable metadata)
          [(ast.AstSpmdCallable.No) export-state]
          [(ast.AstSpmdCallable.Callable _)
            (lower-reach-add-logical all-functions export-state logical-name-id)]))]
    [(ast.AstDecl.Extern decl-meta _ kind metadata _)
      (match kind
        [(ast.AstExternKind.Function)
          (lower-reach-add-runtime-prelude-string-helper-id
            all-functions
            state
            (ast.ast-extern-metadata-symbol-id (box-get metadata)))]
        [(ast.AstExternKind.Value) state])]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-reach-add-export-root-decl
          entry-path
          decl-path
          module
          module-id
          all-functions
          state
          inner))]
    [_ state]))

(define (lower-reach-add-export-roots-in-module
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [state : LowerReachState (:consume)]) : LowerReachState
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) state]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons path _) path]
            [(ast.AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
        (match decl
          [(ast.AstDecl.Module next-module)
            (lower-reach-add-export-roots-in-module
              rest
              rest-paths
              entry-path
              (ci.intern-str next-module)
              next-module
              all-functions
              state)]
          [_
            (lower-reach-add-export-roots-in-module
              rest
              rest-paths
              entry-path
              module
              module-id
              all-functions
              (lower-reach-add-export-root-decl
                entry-path
                decl-path
                module
                module-id
                all-functions
                state
                decl))]))]))

(define (lower-prune-unreachable-functions-with-clone-roots-and-plan
  [pools : ast.AstNodePoolContext]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [names : LowerNameEnv]
  [clone-roots : clone_support.CloneRootEntries]) : LowerPrunedProgramWithPlan
  (match program
    [(ast.AstProgram.Program decls-box)
      (let
        [decls : ast.AstDeclList (box-get decls-box)]
        ;; Publish the whole-program global name cache so the per-module
        ;; body name-cache overlays built inside lower-function-body-index-from-decls
        ;; (and resolved during lower-reach-process below) can fall through to it.
        ;; Kept in the PERSISTENT (caller) arena so it survives the scratch rewind
        ;; below (the original behavior); decl-lowering re-sets it before use.
        [_set-global : unit
          (begin
            (set!
              lower-active-global-name-cache
              (lower-name-cache-from-env names))
            unit)]
        ;; The reachability scratch (function/dispatch sets, body index and
        ;; its per-module name overlays, the reachable map) is the bulk of the
        ;; ~163MB / ~12% opt1 lower-phase prune cost and adds zero AST/type pool
        ;; nodes -- pure transient scratch. Build it inside the dedicated lower
        ;; scratch arena and rewind it once the pruned program is materialized.
        ;; The pruned decl/path lists only reference shared decl nodes (by
        ;; AstNodeId) and interned strings, never the scratch maps, so they are
        ;; safe to keep in the persistent arena after the rewind (mirrors the
        ;; scratch+escape pattern in lower-function-escaping).
        [prev-arena : i64 (arena.tl_arena_current)]
        [scratch : i64 (lower-scratch-arena-get)]
        (begin
          (unsafe
            (arena.tl_arena_set scratch))
          (let
            [mark : i64 (arena.tl_region_mark)]
            [all-functions : lower_i64_i64_map.Map
              (lower-function-set-from-decls decls paths entry-path)]
            [body-index : LowerFunctionBodyIndex
              (lower-function-body-index-from-decls
                pools
                decls
                paths
                entry-path
                names
                (lower-function-decl-count decls))]
            [name-cache : LowerNameCache (lower-name-cache-from-env names)]
            [dispatch-variants : lower_i64_i64_map.Map
              (lower-dispatch-variant-set-from-decls
                decls
                paths
                entry-path
                name-cache)]
            [main-id : i64 (lower-entry-main-logical-id all-functions)]
            [result : LowerPrunedProgramWithPlan
              (if (>= main-id 0)
                (begin
                  (set!
                    lower-reach-active-runtime-paths
                    (lower_i64_i64_map.with-capacity 1024))
                  (set!
                    lower-reach-active-body-used-types
                    (lower-used-types-precise-empty))
                  (let
                    [main-state : LowerReachState
                      (lower-reach-add-logical
                        all-functions
                        (LowerReachState.State
                          (lower_i64_i64_map.with-capacity 8192)
                          (lower-id-set-empty))
                        main-id)]
                    [export-state : LowerReachState
                      (lower-reach-add-export-roots-in-module
                        decls
                        paths
                        entry-path
                        ""
                        cbi.compiler-builtin-id-fix-empty
                        all-functions
                        main-state)]
                    [cleanup-state : LowerReachState
                      (lower-reach-cleanup-metadata-roots-in-module
                        all-functions
                        decls
                        paths
                        entry-path
                        ""
                        cbi.compiler-builtin-id-fix-empty
                        name-cache
                        export-state)]
                    [clone-state : LowerReachState
                      (lower-reach-add-clone-root-helpers
                        all-functions
                        name-cache
                        clone-roots
                        cleanup-state)]
                    [dispatch-state : LowerReachState
                      (lower-reach-add-dispatch-variant-roots
                        all-functions
                        decls
                        name-cache
                        clone-state)]
                    [global-state : LowerReachState
                      (lower-reach-global-decls
                        pools
                        all-functions
                        name-cache
                        dispatch-state
                        decls
                        paths
                        entry-path
                        cbi.compiler-builtin-id-fix-empty)]
                    [reached-state : LowerReachState
                      (lower-reach-process
                        pools
                        all-functions
                        name-cache
                        body-index
                        global-state)]
                    (match reached-state
                      [(LowerReachState.State reachable _)
                        (let
                          [type-path-seed : LowerUsedTypePathSeed
                            (lower-used-types-path-seed-in-module
                              pools
                              decls
                              paths
                              entry-path
                              ""
                              lower-reach-active-runtime-paths
                              (lower-global-shared-view
                                lower-reach-active-body-used-types)
                              true)]
                          [used-types : lower_i64_i64_map.Map
                            (match type-path-seed
                              [(LowerUsedTypePathSeed.Seed
                                  reachable-path-type-names
                                  type-paths-covered)
                                (if type-paths-covered
                                  (lower_i64_i64_map.with-capacity 8)
                                  (lower-used-types-expand-fixed
                                    pools
                                    decls
                                    (lower-used-types-from-kept-decls-in-module
                                      pools
                                      decls
                                      paths
                                      entry-path
                                      ""
                                      cbi.compiler-builtin-id-fix-empty
                                      all-functions
                                      reachable
                                      dispatch-variants
                                      reachable-path-type-names)))])]
                          [scratch-head : i64 (arena.tl_arena_current)]
                          (begin
                            ;; Materialize the pruned program back in the persistent
                            ;; arena before rewinding the scratch arena.
                            (unsafe
                              (arena.tl_arena_set prev-arena))
                            (let
                              [filtered : LowerFilteredReachableWithPlan
                                (lower-filter-reachable-decls-paths-and-plan
                                  decls
                                  paths
                                  entry-path
                                  all-functions
                                  reachable
                                  dispatch-variants
                                  used-types)]
                              [pruned : LowerPrunedProgramWithPlan
                                (match filtered
                                  [(LowerFilteredReachableWithPlan.Filtered
                                      filtered-decls
                                      filtered-paths
                                      keep-plan)
                                    (LowerPrunedProgramWithPlan.Program
                                      (ast.ast-program filtered-decls)
                                      filtered-paths
                                      keep-plan)])]
                              [new-prev-arena : i64 (arena.tl_arena_current)]
                              (begin
                                (unsafe
                                  (arena.tl_arena_set scratch-head)
                                  (arena.tl_region_reset mark)
                                  (arena.tl_arena_set new-prev-arena))
                                pruned))))])))
                (let
                  [scratch-head : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set prev-arena))
                    (LowerPrunedProgramWithPlan.Program
                      program
                      paths
                      (lower-decl-keep-plan-all
                        (ast.ast-decl-list-len (& decls)))))))]
            (begin
              (lower-reach-scratch-globals-reset!)
              result))))]))

(define (lower-state-next-var [state : LowerState]) : i64
  (match state
    [(LowerState.State data) (struct-get (box-get data) next-var)]))

(define (lower-state-current-label [state : LowerState]) : i64
  (match state
    [(LowerState.State data) (struct-get (box-get data) current-label)]))

(define (lower-state-current-function [state : LowerState]) : String
  (match state
    [(LowerState.State data)
      (ir.compiler-ir-symbol-text (struct-get (box-get data) function))]))

(define (lower-state-current-function-id [state : LowerState]) : i64
  (match state
    [(LowerState.State data) (struct-get (box-get data) function)]))

(define (lower-state-spans [state : LowerState]) : ir.CompilerSourceSpans
  (match state
    [(LowerState.State data) (box-get (struct-get (box-get data) spans))]))

(define (lower-state-names [state : LowerState]) : LowerNameCache
  (match state
    [(LowerState.State data) (struct-get (box-get data) names)]))

(define (lower-state-type-cache [state : LowerState]) : LowerTypeCache
  (match state
    [(LowerState.State data) (struct-get (box-get data) type-cache)]))

(define (lower-state-mode [state : LowerState]) : CompilerLowerMode
  (match state
    [(LowerState.State data) (struct-get (box-get data) mode)]))

(define (lower-state-register-address-taken-var?
  [state : LowerState]
  [var-id : i64]) : bool
  (match state
    [(LowerState.State data)
      (lower_i64_i64_map.contains?
        (& (struct-get (box-get data) address-taken))
        var-id)]))

(define (lower-state-register-address-taken-mark
  [state : LowerState (:consume)]
  [var-id : i64]) : LowerState
  (match state
    [(LowerState.State data)
      (begin
        (lower_i64_i64_map.insert-ref!
          (&mut (struct-get (box-get data) address-taken))
          var-id
          1)
        state)]))

;; Keep reusable-result provenance in a high, disjoint key range of the
;; address-taken fact map. Function-local IR var ids are dense from zero and
;; stay far below this boundary.
(define (lower-inline-result-alias-key [var-id : i64]) : i64
  (+ 1073741824 var-id))

(define (lower-inline-result-alias-marker-set-ref!
  [facts : (&mut facts lower_i64_i64_map.Map)]
  [var-id : i64]
  [marker : i64]) : unit
  (let
    [key : i64 (lower-inline-result-alias-key var-id)]
    (if (> marker 0)
      (lower_i64_i64_map.insert-ref! facts key marker)
      (if (lower_i64_i64_map.contains? facts key)
        (begin
          (lower_i64_i64_map.remove-ref! facts key)
          unit)
        unit))))

(define (lower-inline-result-alias-marker-in-map
  [facts : (& facts lower_i64_i64_map.Map)]
  [value : ir.CompilerIrValue]) : i64
  (match value
    [(ir.CompilerIrValue.Var var-id)
      (lower_i64_i64_map.get-value-or
        facts
        (lower-inline-result-alias-key var-id)
        0)]
    [_ 0]))

(define (lower-state-inline-result-alias-tracking-active? [state : LowerState]) : bool
  (and
    (>= lower-active-loop-entry-var-limit 0)
    (= (lower-state-current-function-id state) lower-active-loop-function)))

(define (lower-state-inline-result-alias-origin
  [state : LowerState]
  [value : ir.CompilerIrValue]) : i64
  (if (lower-state-inline-result-alias-tracking-active? state)
    (match state
      [(LowerState.State data)
        (-
          (lower-inline-result-alias-marker-in-map
            (& (struct-get (box-get data) address-taken))
            value)
          1)])
    -1))

(define (lower-state-inline-result-alias-set
  [state : LowerState (:consume)]
  [var-id : i64]
  [origin-var : i64]) : LowerState
  (if (lower-state-inline-result-alias-tracking-active? state)
    (match state
      [(LowerState.State data)
        (begin
          (lower-inline-result-alias-marker-set-ref!
            (&mut (struct-get (box-get data) address-taken))
            var-id
            (if (>= origin-var 0)
              (+ origin-var 1)
              0))
          state)])
    state))

(define (lower-state-inline-result-alias-mark-value
  [state : LowerState (:consume)]
  [value : ir.CompilerIrValue]) : LowerState
  (match value
    [(ir.CompilerIrValue.Var var-id)
      (lower-state-inline-result-alias-set state var-id var-id)]
    [_ state]))

(define (lower-state-inline-result-alias-mark-call-result
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [value : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerState
  (if (and
    (lower-state-inline-result-alias-tracking-active? state)
    (lower-inline-aggregate-abi-copy-needed? ctx state result-ty))
    (lower-state-inline-result-alias-mark-value state value)
    state))

(define (lower-state-tail-param-start [state : LowerState]) : i64
  (match state
    [(LowerState.State data) (struct-get (box-get data) tail-param-start)]))

(define (lower-state-tail-param-end [state : LowerState]) : i64
  (match state
    [(LowerState.State data) (struct-get (box-get data) tail-param-end)]))

(define (lower-state-tail-param-range-contains?
  [state : LowerState]
  [var-id : i64]) : bool
  (and
    (>= var-id (lower-state-tail-param-start state))
    (< var-id (lower-state-tail-param-end state))))

(define (lower-state-clear-tail-param-range [state : LowerState]) : LowerState
  (match state
    [(LowerState.State data)
      (begin
        (set! (struct-get (box-get data) tail-param-start) 0)
        (set! (struct-get (box-get data) tail-param-end) 0)
        state)]))

(define (lower-state-alloc-var [state : LowerState]) : LowerAlloc
  (match state
    [(LowerState.State data)
      (let
        [next-var : i64 (struct-get (box-get data) next-var)]
        (begin
          (set! (struct-get (box-get data) next-var) (+ next-var 1))
          (LowerAlloc.Alloc state next-var)))]))

(define (lower-state-next-label-number [state : LowerState]) : i64
  (match state
    [(LowerState.State data) (struct-get (box-get data) next-label)]))

(define (lower-state-fresh-label [state : LowerState] [prefix : String]) : LowerLabel
  (match state
    [(LowerState.State data)
      (let
        [next-label : i64 (struct-get (box-get data) next-label)]
        (begin
          (set! (struct-get (box-get data) next-label) (+ next-label 1))
          (LowerLabel.Label
            state
            (ir.compiler-ir-label
              (string.append
                (string.append prefix ".")
                (string.int->string next-label))))))]))

(define (lower-state-fresh-lambda-name [state : LowerState]) : LowerLambdaName
  (match state
    [(LowerState.State data)
      (let
        [next-lambda : i64 (struct-get (box-get data) next-lambda)]
        [function-text : String
          (ir.compiler-ir-symbol-text (struct-get (box-get data) function))]
        [lambda-name : String
          (string.append
            (string.append (string.append "__tl_lambda_" function-text) "_")
            (string.int->string next-lambda))]
        [lambda-id : i64 (ci.intern-generated-name lambda-name)]
        (begin
          (set! (struct-get (box-get data) next-lambda) (+ next-lambda 1))
          (LowerLambdaName.Name state lambda-id)))]))

(define (lower-state-emit
  [state : LowerState (:consume)]
  [instr : ir.CompilerIrInstr]) : LowerState
  (match state
    [(LowerState.State data)
      (begin
        (ir.compiler-ir-instr-builder-push!
          (&mut (struct-get (box-get data) current-instrs))
          instr)
        state)]))

(define (lower-runtime-abort-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ op _ _ _)
      (match op
        [(ir.CompilerIrBinOp.Div) true]
        [(ir.CompilerIrBinOp.Mod) true]
        [(ir.CompilerIrBinOp.Shl _) true]
        [(ir.CompilerIrBinOp.Shr _) true]
        [_ false])]
    [(ir.CompilerIrInstr.Call _ name _ _)
      (let
        [text : String (ir.compiler-ir-symbol-text name)]
        (or
          (string.eq text "stdlib/io.tl::stdlib.io/panic")
          (string.eq text "stdlib\\io.tl::stdlib.io/panic")))]
    [_ false]))

(define (lower-state-emit-at-expr
  [state : LowerState (:consume)]
  [instr : ir.CompilerIrInstr]
  [expr : ast.AstExpr]) : LowerState
  (if (or
    (ir.compiler-debug-info-enabled?)
    (and (not lower-current-decl-generated?) (lower-runtime-abort-instr? instr)))
    (match state
      [(LowerState.State data)
        (let
          [next-spans : ir.CompilerSourceSpans
            (match (lower-ast-expr-span expr)
              [(ir.CompilerMaybeSourceSpan.Some span)
                (ir.compiler-source-spans-insert-instr-located
                  (box-get (struct-get (box-get data) spans))
                  (struct-get (box-get data) function)
                  instr
                  lower-current-source-path-id
                  span)]
              [(ir.CompilerMaybeSourceSpan.No)
                (box-get (struct-get (box-get data) spans))])]
          (begin
            (ir.compiler-ir-instr-builder-push!
              (&mut (struct-get (box-get data) current-instrs))
              instr)
            (set! (struct-get (box-get data) spans) (box next-spans))
            state))])
    (lower-state-emit state instr)))

;; Bounds-check helpers emit their BoundsCheck before the final GEP/load and do
;; not otherwise carry the source expression. Immediately after such a helper
;; returns, its most recently allocated label is the unique LABEL-PREFIX key.
(define (lower-state-record-latest-bounds-check-named-at-expr
  [state : LowerState]
  [label-prefix : String]
  [expr : ast.AstExpr]) : LowerState
  (if (and
    lower-current-decl-generated?
    (not (ir.compiler-debug-info-enabled?)))
    state
    (match (lower-ast-expr-span expr)
      [(ir.CompilerMaybeSourceSpan.No) state]
      [(ir.CompilerMaybeSourceSpan.Some span)
        (match state
          [(LowerState.State data)
            (let
              [bounds-label : i64
                (ir.compiler-ir-label
                  (str_cat.str-cat
                    (str_cat.str-cat label-prefix ".")
                    (string.int->string
                      (- (struct-get (box-get data) next-label) 1))))]
              [next-spans : ir.CompilerSourceSpans
                (ir.compiler-source-spans-insert-instr-located
                  (box-get (struct-get (box-get data) spans))
                  (struct-get (box-get data) function)
                  (ir.CompilerIrInstr.BoundsCheck
                    ir.CompilerIrValue.Unit
                    ir.CompilerIrValue.Unit
                    bounds-label)
                  lower-current-source-path-id
                  span)]
              (begin
                (set! (struct-get (box-get data) spans) (box next-spans))
                state))])])))

(define (lower-state-record-latest-bounds-check-at-expr
  [state : LowerState]
  [expr : ast.AstExpr]) : LowerState
  (lower-state-record-latest-bounds-check-named-at-expr state "bounds_ok" expr))

(define (lower-state-finish-block
  [state : LowerState (:consume)]
  [next-label : i64]) : LowerState
  (match state
    [(LowerState.State data)
      (let
        [current-label : i64 (struct-get (box-get data) current-label)]
        [current-instrs : ir.CompilerIrInstrBuilder
          (struct-get (box-get data) current-instrs)]
        (begin
          (ir.compiler-ir-block-builder-push!
            (&mut (struct-get (box-get data) blocks))
            (ir.CompilerIrBlock.Block
              current-label
              (ir.compiler-ir-instr-builder-to-seq current-instrs)))
          (set! (struct-get (box-get data) current-label) next-label)
          (set!
            (struct-get (box-get data) current-instrs)
            (ir.compiler-ir-instr-builder-new))
          state))]))

(define (lower-state-build-blocks [state : LowerState]) : ir.CompilerIrBlockList
  (match state
    [(LowerState.State data)
      (let
        [current-block : ir.CompilerIrBlock
          (ir.CompilerIrBlock.Block
            (struct-get (box-get data) current-label)
            (ir.compiler-ir-instr-builder-to-seq
              (struct-get (box-get data) current-instrs)))]
        [blocks : ir.CompilerIrBlockBuilder (struct-get (box-get data) blocks)]
        [next-blocks : ir.CompilerIrBlockBuilder
          (ir.CompilerIrBlockBuilder
            (struct-get blocks slots)
            (struct-get blocks len))]
        (begin
          (ir.compiler-ir-block-builder-push! (&mut next-blocks) current-block)
          (ir.compiler-ir-block-builder-to-list next-blocks)))]))

(define (lower-state-build-function-blocks [state : LowerState]) : ir.CompilerIrBlockList
  (lower-state-build-blocks state))

(define (lower-state-build-functions-with
  [state : LowerState]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunctionList
  (match state
    [(LowerState.State data)
      (let
        [functions : ir.CompilerIrFunctionBuilder
          (struct-get (box-get data) functions)]
        [out : ir.CompilerIrFunctionBuilder
          (ir.CompilerIrFunctionBuilder
            (struct-get functions slots)
            (struct-get functions len))]
        (begin
          (ir.compiler-ir-function-builder-push! (&mut out) func)
          (ir.compiler-ir-function-builder-to-list out)))]))

(define (lower-state-add-functions
  [state : LowerState (:consume)]
  [new-functions : ir.CompilerIrFunctionList]
  [new-spans : ir.CompilerSourceSpans]) : LowerState
  (match state
    [(LowerState.State data)
      (begin
        (ir.compiler-ir-function-builder-append-list!
          (&mut (struct-get (box-get data) functions))
          new-functions)
        (set! (struct-get (box-get data) spans) (box new-spans))
        state)]))

(define (lower-materialize
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit allocated (ir.CompilerIrInstr.Mov var-id value ty))
          (ir.CompilerIrValue.Var var-id)
          ty))]))

(define (lower-materialize-at-expr
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (let
        [instr : ir.CompilerIrInstr (ir.CompilerIrInstr.Mov var-id value ty)]
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit-at-expr allocated instr expr)
            (ir.CompilerIrValue.Var var-id)
            ty)))]))

(define (lower-float-literal-bits [text : String] [ty : ast.AstType]) : u64
  (match ty
    [(ast.AstType.F32)
      (match (cfloat.compiler-float-parse-f32-bits text)
        [(CompilerFloatSomeBits bits) bits]
        [(CompilerFloatNoBits) (cast 0 : u64)])]
    [_
      (match (cfloat.compiler-float-parse-f64-bits text)
        [(CompilerFloatSomeBits bits) bits]
        [(CompilerFloatNoBits) (cast 0 : u64)])]))

(define (lower-literal-value-with-type
  [lit : ast.AstLiteral]
  [ty : ast.AstType]) : ir.CompilerIrValue
  (match lit
    [(ast.AstLiteral.Int n _) (ir.CompilerIrValue.I64 n)]
    [(ast.AstLiteral.Float n)
      (ir.CompilerIrValue.F64 (lower-float-literal-bits n ty))]
    [(ast.AstLiteral.Bool b) (ir.CompilerIrValue.Bool b)]
    [(ast.AstLiteral.Char c) (ir.CompilerIrValue.Char c)]
    [(ast.AstLiteral.String string-id)
      (ir.CompilerIrValue.String (ci.intern-str string-id))]
    [(ast.AstLiteral.Unit) ir.CompilerIrValue.Unit]))

(define (lower-binop [op : ast.AstBinOp] [rhs-ty : ast.AstType]) : ir.CompilerIrBinOp
  (match op
    [(ast.AstBinOp.Add) ir.CompilerIrBinOp.Add]
    [(ast.AstBinOp.Sub) ir.CompilerIrBinOp.Sub]
    [(ast.AstBinOp.Mul) ir.CompilerIrBinOp.Mul]
    [(ast.AstBinOp.Div) ir.CompilerIrBinOp.Div]
    [(ast.AstBinOp.Mod) ir.CompilerIrBinOp.Mod]
    [(ast.AstBinOp.Eq) ir.CompilerIrBinOp.Eq]
    [(ast.AstBinOp.Ne) ir.CompilerIrBinOp.Ne]
    [(ast.AstBinOp.Lt) ir.CompilerIrBinOp.Lt]
    [(ast.AstBinOp.Le) ir.CompilerIrBinOp.Le]
    [(ast.AstBinOp.Gt) ir.CompilerIrBinOp.Gt]
    [(ast.AstBinOp.Ge) ir.CompilerIrBinOp.Ge]
    [(ast.AstBinOp.And) ir.CompilerIrBinOp.And]
    [(ast.AstBinOp.Or) ir.CompilerIrBinOp.Or]
    [(ast.AstBinOp.BitAnd) ir.CompilerIrBinOp.BitAnd]
    [(ast.AstBinOp.BitOr) ir.CompilerIrBinOp.BitOr]
    [(ast.AstBinOp.BitXor) ir.CompilerIrBinOp.BitXor]
    [(ast.AstBinOp.Shl) (ir.CompilerIrBinOp.Shl rhs-ty)]
    [(ast.AstBinOp.Shr) (ir.CompilerIrBinOp.Shr rhs-ty)]))

(define (lower-unop [op : ast.AstUnOp]) : ir.CompilerIrUnOp
  (match op
    [(ast.AstUnOp.Neg) ir.CompilerIrUnOp.Neg]
    [(ast.AstUnOp.Not) ir.CompilerIrUnOp.Not]
    [(ast.AstUnOp.BitNot) ir.CompilerIrUnOp.BitNot]))

(define (lower-align-up [n : i64] [align : i64]) : i64
  (if (<= align 1)
    n
    (* (/ (+ n (- align 1)) align) align)))

(define (lower-inline-layout-size-or
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [fallback : i64]) : i64
  ;; Compile-time: a bare struct/enum size is memoized by stable
  ;; interned type-name id
  ;; (its size is stable; this is the hot type-size query in lowering). Generic
  ;; ...Args / tuples / arrays depend on type arguments, so keep the uncached path.
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Struct name)
      (tc_core.tc-inline-aggregate-size-cached ctx name fallback)]
    [(ast.AstType.Enum name)
      (tc_core.tc-inline-aggregate-size-cached ctx name fallback)]
    [_
      (match (tc_core.tc-inline-aggregate-type-layout ctx ty)
        [(tc_core.ResultTcLayoutInfo.Ok info)
          (tc_core.tc-layout-info-size info)]
        [(tc_core.ResultTcLayoutInfo.Err _) fallback])]))

(define (lower-inline-layout-align-or
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [fallback : i64]) : i64
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Struct name)
      (tc_core.tc-inline-aggregate-align-cached ctx name fallback)]
    [(ast.AstType.Enum name)
      (tc_core.tc-inline-aggregate-align-cached ctx name fallback)]
    [_
      (match (tc_core.tc-inline-aggregate-type-layout ctx ty)
        [(tc_core.ResultTcLayoutInfo.Ok info)
          (tc_core.tc-layout-info-align info)]
        [(tc_core.ResultTcLayoutInfo.Err _) fallback])]))

;; A borrowed Slice is a structural fat reference: two integer-class words
;; (data pointer, signed length).  The referent is a type-pool id and may have
;; Region wrappers, which are transparent for this physical classification.
;; Do not recurse through owning containers; only an immediate Slice referent
;; receives the fat-reference representation.
(define (lower-reference-to-slice? [ctx : tc_core.TcContext] [inner : i64]) : bool
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx inner)))
    [(ast.AstType.Slice _) true]
    [_ false]))

(define (lower-type-size [ctx : tc_core.TcContext] [ty : ast.AstType]) : i64
  (match (tc_core.tc-resolve-type ctx ty)
    [(ast.AstType.I64) 8]
    [(ast.AstType.U64) 8]
    [(ast.AstType.F64) 8]
    [(ast.AstType.I32) 4]
    [(ast.AstType.U32) 4]
    [(ast.AstType.F32) 4]
    [(ast.AstType.I16) 2]
    [(ast.AstType.U16) 2]
    [(ast.AstType.I8) 1]
    [(ast.AstType.U8) 1]
    [(ast.AstType.Bool) 1]
    [(ast.AstType.Char) 1]
    [(ast.AstType.Unit) 0]
    [(ast.AstType.Never) 0]
    [(ast.AstType.Expr) 0]
    [(ast.AstType.ExprList) 0]
    [(ast.AstType.Func _ _) 8]
    [(ast.AstType.Tuple _) (lower-inline-layout-size-or ctx ty 8)]
    [(ast.AstType.Array _ _) (lower-inline-layout-size-or ctx ty 8)]
    [(ast.AstType.DynArray _) 8]
    [(ast.AstType.Slice _) 0]
    [(ast.AstType.Box _) 8]
    [(ast.AstType.Ptr _) 8]
    [(ast.AstType.MutPtr _) 8]
    [(ast.AstType.Ref _ inner)
      (if (lower-reference-to-slice? ctx inner)
        16
        8)]
    [(ast.AstType.MutRef _ inner)
      (if (lower-reference-to-slice? ctx inner)
        16
        8)]
    [(ast.AstType.Region _ inner)
      (lower-type-size ctx (tc_core.tc-context-type-get ctx inner))]
    [(ast.AstType.Enum name)
      (lower-inline-layout-size-or ctx (ast.AstType.Enum name) 8)]
    [(ast.AstType.EnumArgs name lifetimes)
      (lower-inline-layout-size-or ctx (ast.AstType.EnumArgs name lifetimes) 8)]
    [(ast.AstType.Struct name)
      (lower-inline-layout-size-or ctx (ast.AstType.Struct name) 8)]
    [(ast.AstType.StructArgs name lifetimes)
      (lower-inline-layout-size-or
        ctx
        (ast.AstType.StructArgs name lifetimes)
        8)]
    [(ast.AstType.String) 8]
    [(ast.AstType.Str) 8]
    [(ast.AstType.Bytes) 8]
    [(ast.AstType.Var _) 8]
    [(ast.AstType.VarArgs _ _) 8]
    [(ast.AstType.Consume inner)
      (lower-type-size ctx (tc_core.tc-context-type-get ctx inner))]))

(define (lower-type-align [ctx : tc_core.TcContext] [ty : ast.AstType]) : i64
  (match (tc_core.tc-resolve-type ctx ty)
    [(ast.AstType.I64) 8]
    [(ast.AstType.U64) 8]
    [(ast.AstType.F64) 8]
    [(ast.AstType.I32) 4]
    [(ast.AstType.U32) 4]
    [(ast.AstType.F32) 4]
    [(ast.AstType.I16) 2]
    [(ast.AstType.U16) 2]
    [(ast.AstType.I8) 1]
    [(ast.AstType.U8) 1]
    [(ast.AstType.Bool) 1]
    [(ast.AstType.Char) 1]
    [(ast.AstType.Unit) 1]
    [(ast.AstType.Never) 1]
    [(ast.AstType.Expr) 1]
    [(ast.AstType.ExprList) 1]
    [(ast.AstType.Func _ _) 8]
    [(ast.AstType.Tuple _) (lower-inline-layout-align-or ctx ty 8)]
    [(ast.AstType.Array _ _) (lower-inline-layout-align-or ctx ty 8)]
    [(ast.AstType.DynArray _) 8]
    [(ast.AstType.Slice _) 0]
    [(ast.AstType.Box _) 8]
    [(ast.AstType.Ptr _) 8]
    [(ast.AstType.MutPtr _) 8]
    [(ast.AstType.Ref _ _) 8]
    [(ast.AstType.MutRef _ _) 8]
    [(ast.AstType.Region _ inner)
      (lower-type-align ctx (tc_core.tc-context-type-get ctx inner))]
    [(ast.AstType.Enum name)
      (lower-inline-layout-align-or ctx (ast.AstType.Enum name) 8)]
    [(ast.AstType.EnumArgs name lifetimes)
      (lower-inline-layout-align-or ctx (ast.AstType.EnumArgs name lifetimes) 8)]
    [(ast.AstType.Struct name)
      (lower-inline-layout-align-or ctx (ast.AstType.Struct name) 8)]
    [(ast.AstType.StructArgs name lifetimes)
      (lower-inline-layout-align-or
        ctx
        (ast.AstType.StructArgs name lifetimes)
        8)]
    [(ast.AstType.String) 8]
    [(ast.AstType.Str) 8]
    [(ast.AstType.Bytes) 8]
    [(ast.AstType.Var _) 8]
    [(ast.AstType.VarArgs _ _) 8]
    [(ast.AstType.Consume inner)
      (lower-type-align ctx (tc_core.tc-context-type-get ctx inner))]))

(define (lower-type-list-extent
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]
  [cursor : i64]) : i64
  (lower-type-list-extent-at ctx (& types) cursor 0))

(define (lower-type-list-extent-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [cursor : i64]
  [index : i64]) : i64
  (if (>= index (ast.ast-type-list-len types))
    cursor
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      (lower-type-list-extent-at
        ctx
        types
        (+ offset (lower-type-size ctx resolved))
        (+ index 1)))))

(define (lower-type-list-storage-size
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : i64
  (let
    [extent : i64 (lower-type-list-extent ctx types 0)]
    (lower-align-up
      (if (= extent 0)
        1
        extent)
      8)))

(define (lower-variant-fields-storage-size
  [ctx : tc_core.TcContext]
  [fields : ast.AstTypeList]) : i64
  (lower-align-up (lower-type-list-extent ctx fields 8) 8))

(define (lower-variant-storage-size
  [ctx : tc_core.TcContext]
  [variant : ast.AstVariantDef]) : i64
  (match variant
    [(ast.AstVariantDef.Def _ fields _)
      (lower-variant-fields-storage-size ctx fields)]))

(define (lower-nullary-variant-object-symbol
  [enum-name : String]
  [variant-name : String]) : i64
  (lower-derived-symbol-id
    (string.append
      "__enum_obj_"
      (string.append enum-name (string.append "_" variant-name)))))

(define (lower-nullary-variant-globals
  [enum-name-id : i64]
  [enum-name : String]
  [variants : ast.AstVariantDefList]
  [tag : i64]
  [globals : ir.CompilerIrGlobalList]) : ir.CompilerIrGlobalList
  (if (>= tag (struct-get (& variants) len))
    globals
    (match (ast.ast-variant-def-list-get
      (& variants)
      tag
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def variant-name fields _)
        (let
          [next : ir.CompilerIrGlobalList
            (if (ast.ast-type-list-empty? (& fields))
              (let
                [object-name : i64
                  (lower-nullary-variant-object-symbol
                    enum-name
                    (tc_core.tc-env-key-name-text variant-name))]
                (ir.compiler-ir-global-cons
                  (ir.CompilerIrGlobal.Global
                    object-name
                    (ast.AstType.I64)
                    (ir.CompilerIrValue.I64 tag))
                  globals))
              globals)]
          (lower-nullary-variant-globals
            enum-name-id
            enum-name
            variants
            (+ tag 1)
            next))])))

(define (lower-enum-variants-storage-size
  [ctx : tc_core.TcContext]
  [variants : ast.AstVariantDefList]
  [max-size : i64]) : i64
  (lower-enum-variants-storage-size-at ctx (& variants) max-size 0))

(define (lower-enum-variants-storage-size-at
  [ctx : tc_core.TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [max-size : i64]
  [index : i64]) : i64
  (if (>= index (struct-get variants len))
    max-size
    (let
      [size : i64
        (lower-variant-storage-size
          ctx
          (ast.ast-variant-def-list-get
            variants
            index
            (ast.ast-variant-def-fallback)))]
      (lower-enum-variants-storage-size-at
        ctx
        variants
        (if (> size max-size)
          size
          max-size)
        (+ index 1)))))

(define (lower-enum-storage-size
  [ctx : tc_core.TcContext]
  [enum-name-id : i64]
  [enum-name : String]) : i64
  (match (tc_core.tc-context-enum-variants-id ctx enum-name-id enum-name)
    [(parser.ResultAstVariantDefList.Ok variants)
      (lower-enum-variants-storage-size ctx variants 8)]
    [(parser.ResultAstVariantDefList.Err _) 8]))

(define (lower-struct-fields-at-handle
  [ctx : tc_core.TcContext]
  [handle : i64]
  [struct-name : String]) : parser.ResultAstFieldDefList
  (if (and
    (csym.compiler-symbols-handle-found? handle)
    (=
      (csym.compiler-symbol-handle-kind handle)
      (csym.compiler-symbol-kind-defstruct)))
    (match (csym.compiler-symbols-decl-at-index
      (tc_core.tc-context-symbols ctx)
      (csym.compiler-symbol-handle-index handle))
      [(parser.ResultAstDecl.Ok decl)
        (match decl
          [(ast.AstDecl.DefStruct decl-meta _ _ _ fields)
            (parser.ResultAstFieldDefList.Ok fields)]
          [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ _ fields)
            (parser.ResultAstFieldDefList.Ok fields)]
          [_
            (parser.ResultAstFieldDefList.Err
              "lower: struct symbol owner is not a struct")])]
      [(parser.ResultAstDecl.Err message)
        (parser.ResultAstFieldDefList.Err message)])
    (parser.ResultAstFieldDefList.Err
      (string.append "lower: unknown struct " struct-name))))

(define (lower-struct-fields-id
  [ctx : tc_core.TcContext]
  [struct-id : i64]
  [struct-name : String]) : parser.ResultAstFieldDefList
  (lower-struct-fields-at-handle
    ctx
    (csym.compiler-symbols-lookup-type-id-or
      (tc_core.tc-context-symbols ctx)
      struct-id
      (csym.compiler-symbols-missing-handle))
    struct-name))

(define (lower-struct-repr-c-id? [ctx : tc_core.TcContext] [struct-id : i64]) : bool
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc_core.tc-context-symbols ctx)
        struct-id
        (csym.compiler-symbols-missing-handle))]
    (if (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-defstruct)))
      (match (csym.compiler-symbols-decl-at-index
        (tc_core.tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle))
        [(parser.ResultAstDecl.Ok decl)
          (match decl
            [(ast.AstDecl.DefStruct decl-meta _ repr _ _)
              (ast.ast-struct-repr-c? repr)]
            [(ast.AstDecl.DefStructLifetimes decl-meta _ _ repr _ _)
              (ast.ast-struct-repr-c? repr)]
            [_ false])]
        [(parser.ResultAstDecl.Err _) false])
      false)))

(define (lower-repr-c-inline-field?
  [ctx : tc_core.TcContext]
  [field-ty : ast.AstType]) : bool
  (match (tc_core.tc-resolve-type ctx field-ty)
    [(ast.AstType.Struct nested) (lower-struct-repr-c-id? ctx nested)]
    [_ false]))

(define (lower-repr-c-field-size
  [ctx : tc_core.TcContext]
  [field-ty : ast.AstType]) : i64
  (match (tc_core.tc-resolve-type ctx field-ty)
    [(ast.AstType.Struct nested)
      (match (tc_core.tc-repr-c-struct-layout-id
        ctx
        (tc_core.tc-nominal-name-id-display nested)
        nested)
        [(tc_core.ResultTcReprCLayout.Ok layout)
          (tc_core.tc-repr-c-layout-size layout)]
        [(tc_core.ResultTcReprCLayout.Err _) 8])]
    [_ (lower-type-size ctx field-ty)]))

(define (lower-reserve-heap-storage
  [state : LowerState]
  [size : i64]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (LowerExpr.Expr
        (lower-state-emit
          allocated
          (ir.CompilerIrInstr.Call
            var-id
            (lower-tl-alloc-symbol)
            (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.I64 size))
            ty))
        (ir.CompilerIrValue.Var var-id)
        ty)]))

(define (lower-inline-storage-slot-count [size : i64]) : i64
  (if (<= size 8)
    1
    (/ (+ size 7) 8)))

(define (lower-reserve-inline-slot-vars
  [state : LowerState]
  [slots : i64]
  [ty : ast.AstType]) : LowerInlineStorage
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (let
        [next-state : LowerState
          (lower-state-emit allocated (ir.CompilerIrInstr.Alloc var-id ty))]
        (if (<= slots 1)
          (LowerInlineStorage.Storage next-state var-id)
          (lower-reserve-inline-slot-vars next-state (- slots 1) ty)))]))

(define (lower-reserve-inline-storage
  [state : LowerState]
  [size : i64]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-reserve-inline-slot-vars
    state
    (lower-inline-storage-slot-count size)
    ty)
    [(LowerInlineStorage.Storage storage-state storage-var)
      (match (lower-state-alloc-var storage-state)
        [(LowerAlloc.Alloc addr-alloc addr-var)
          (LowerExpr.Expr
            (let
              [next-state : LowerState
                (lower-state-emit
                  addr-alloc
                  (ir.CompilerIrInstr.AddrOf addr-var storage-var))]
              (if (>= lower-active-loop-entry-var-limit 0)
                (lower-state-inline-result-alias-set
                  next-state
                  addr-var
                  addr-var)
                next-state))
            (ir.CompilerIrValue.Var addr-var)
            ty)])]))

(define (lower-gep-byte
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (LowerExpr.Expr
        (lower-state-emit
          allocated
          (ir.CompilerIrInstr.Gep
            var-id
            base
            (ir.CompilerIrValue.I64 offset)
            (ast.AstType.U8)))
        (ir.CompilerIrValue.Var var-id)
        (ast.AstType.U64))]))

(define (lower-store-at-offset
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerState
  (match (lower-gep-byte state base offset)
    [(LowerExpr.Expr ptr-state ptr _)
      (lower-state-emit ptr-state (ir.CompilerIrInstr.StorePtr ptr value ty))]))

(define (lower-load-at-offset
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-gep-byte state base offset)
    [(LowerExpr.Expr ptr-state ptr _)
      (match (lower-state-alloc-var ptr-state)
        [(LowerAlloc.Alloc allocated var-id)
          (LowerExpr.Expr
            (lower-state-emit allocated (ir.CompilerIrInstr.Load var-id ptr ty))
            (ir.CompilerIrValue.Var var-id)
            ty)])]))

(define (lower-copy-chunk-size [remaining : i64]) : i64
  (cond [(>= remaining 8) 8] [(>= remaining 4) 4] [(>= remaining 2) 2] [else 1]))

(define (lower-copy-chunk-type [chunk : i64]) : ast.AstType
  (cond
    [(= chunk 8) (ast.AstType.U64)]
    [(= chunk 4) (ast.AstType.U32)]
    [(= chunk 2) (ast.AstType.U16)]
    [else (ast.AstType.U8)]))

;; The byte address `base + offset` as an IR value (the base itself when
;; offset is 0, avoiding a no-op gep).
(define (lower-offset-addr
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]) : LowerExpr
  (if (= offset 0)
    (LowerExpr.Expr state base (ast.AstType.U64))
    (lower-gep-byte state base offset)))

;; Inline the hottest by-value aggregate copies. The flip to
;; inline-by-value aggregates made the 17-128 B band, especially
;; AstTypeList/AstType, ResultTcType/ResultTcType.Ok, and CompilerIrInstr copies,
;; dynamically dominant, but the 16 B ceiling pushed every one of them onto a
;; `tl_memcpy` CALL (~88 dynamic instructions each). Inline they lower to
;; at most eleven 16-byte XMM or scalar-tail load+store pairs.
;; Capping the expansion by that
;; operation count, as production compiler memcpy lowering does, admits the hot
;; 120-176 B band while still routing genuinely large copies through tl_memcpy
;; so the emitted code does not blow up. Must stay a multiple of 8 so the inline
;; chunk loop (lower-copy-chunk-size: 8/4/2/1) terminates cleanly for any size.
(define lower-inline-copy-threshold : i64
  176)

;; Copy `size` bytes dst<-src via a single tl_memcpy runtime call instead
;; of `size/8` separate gep+load+gep+store chunks. The flip from heap-handle
;; structs to inline-by-value aggregates turned every large by-value
;; aggregate copy (set!, pass/return, clone of a >16 B struct) into a long run of
;; word copies -- the dominant `movq` source at -O1 (the `movq ...,%r10 ; movq
;; off(%r10),%rax ; movq %rax,SLOT` runs). One call collapses each run to a few
;; instructions. tl_memcpy takes (dst, src, len) and is emitted unconditionally in
;; the runtime. Only used for copies large enough that the call beats the inline
;; chunks (see lower-copy-bytes threshold).
(define (lower-emit-memcpy
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [dst-offset : i64]
  [src : ir.CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (match (lower-offset-addr state dst dst-offset)
    [(LowerExpr.Expr dst-state dst-addr _)
      (match (lower-offset-addr dst-state src src-offset)
        [(LowerExpr.Expr src-state src-addr _)
          (match (lower-state-alloc-var src-state)
            [(LowerAlloc.Alloc call-state call-var)
              (lower-state-emit
                call-state
                (ir.CompilerIrInstr.Call
                  call-var
                  (lower-derived-symbol-id "tl_memcpy")
                  (ir.compiler-ir-call-args-from-list
                    (ir.compiler-ir-value-cons
                      dst-addr
                      (ir.compiler-ir-value-cons
                        src-addr
                        (ir.compiler-ir-value-cons
                          (ir.CompilerIrValue.I64 size)
                          (ir.CompilerIrValueList.Nil)))))
                  (ast.AstType.Unit)))])])]))

(define (lower-emit-memcpy-value
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [dst-offset : i64]
  [src : ir.CompilerIrValue]
  [src-offset : i64]
  [size : ir.CompilerIrValue]) : LowerState
  (match (lower-offset-addr state dst dst-offset)
    [(LowerExpr.Expr dst-state dst-addr _)
      (match (lower-offset-addr dst-state src src-offset)
        [(LowerExpr.Expr src-state src-addr _)
          (match (lower-state-alloc-var src-state)
            [(LowerAlloc.Alloc call-state call-var)
              (lower-state-emit
                call-state
                (ir.CompilerIrInstr.Call
                  call-var
                  (lower-derived-symbol-id "tl_memcpy")
                  (ir.compiler-ir-call-args-from-list
                    (ir.compiler-ir-value-cons
                      dst-addr
                      (ir.compiler-ir-value-cons
                        src-addr
                        (ir.compiler-ir-value-cons
                          size
                          (ir.CompilerIrValueList.Nil)))))
                  (ast.AstType.Unit)))])])]))

(define (lower-copy-bytes
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [dst-offset : i64]
  [src : ir.CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (cond
    [(<= size 0) state]
    [(> size lower-inline-copy-threshold)
      (lower-emit-memcpy state dst dst-offset src src-offset size)]
    [(>= size 16)
      (match (lower-offset-addr state dst dst-offset)
        [(LowerExpr.Expr dst-state dst-addr _)
          (match (lower-offset-addr dst-state src src-offset)
            [(LowerExpr.Expr src-state src-addr _)
              (lower-state-emit
                src-state
                (ir.CompilerIrInstr.CopyBytes dst-addr src-addr size))])])]
    [else
      (let
        [chunk : i64 (lower-copy-chunk-size size)]
        [chunk-ty : ast.AstType (lower-copy-chunk-type chunk)]
        (match (lower-load-at-offset state src src-offset chunk-ty)
          [(LowerExpr.Expr loaded value _)
            (lower-copy-bytes
              (lower-store-at-offset loaded dst dst-offset value chunk-ty)
              dst
              (+ dst-offset chunk)
              src
              (+ src-offset chunk)
              (- size chunk))]))]))

;; A value is stored FULL-INLINE (its own bytes, addressed by a pointer) when it
;; is a memory aggregate: a struct/enum, tuple, or fixed array. Boxes,
;; dyn-arrays, strings, closures, and scalars keep their existing register-width
;; slot semantics and use scalar load/store rather than byte-copy or
;; pointer-return. Tuples remain address-shaped in expressions, but their
;; nested representation is the tuple bytes rather than a pointer slot.
;; This is the precise gate for choosing inline byte-copy / pointer-return vs.
;; scalar load/store, distinct from the broad lower-type-contains-inline-
;; aggregate? (which is used for the conservative tail-call risk check).
(define (lower-type-inline-storage?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Struct _) true]
    [(ast.AstType.StructArgs _ _) true]
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [(ast.AstType.Tuple _) true]
    [(ast.AstType.Array _ _) true]
    [_ false]))

(define (lower-type-inline-struct-or-enum?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Struct _) true]
    [(ast.AstType.StructArgs _ _) true]
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [_ false]))

;; A register-resident aggregate is an inline struct/enum that fits in a
;; single 8-byte word and is built only of word-class fields. Such a value is
;; carried through the IR as the packed word itself (an i64-shaped SSA value)
;; rather than a pointer to a stack slot: construction packs the fields with
;; shift/or, `struct-get`/`match` extract them with shift/mask, and the value is
;; passed/returned/cloned exactly like a scalar - never touching memory.
;; AstType.StructArgs/AstType.EnumArgs here are lifetime-arg forms; they share
;; the same layout and representation as the bare declaration.
(define (lower-type-register-resident?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ inner) (lower-reference-to-slice? ctx inner)]
    [(ast.AstType.MutRef _ inner) (lower-reference-to-slice? ctx inner)]
    [(ast.AstType.Struct name)
      (> (tc_core.tc-inline-aggregate-regwords-cached ctx name) 0)]
    [(ast.AstType.StructArgs name _)
      (> (tc_core.tc-inline-aggregate-regwords-cached ctx name) 0)]
    [(ast.AstType.Enum name)
      (> (tc_core.tc-inline-aggregate-regwords-cached ctx name) 0)]
    [(ast.AstType.EnumArgs name _)
      (> (tc_core.tc-inline-aggregate-regwords-cached ctx name) 0)]
    [_ false]))

;; Number of machine words a register-resident aggregate occupies
;; (ceil(size/8)). 1 word => carried as a single scalar value; 2
;; words => carried as a register-group value built with CompilerIrInstr.Pack and read
;; with IrInstrWord. Only meaningful when `lower-type-register-resident?` holds.
;; True for a register-resident aggregate that needs the multi-word
;; register-group representation (2+ words) rather than the single-word scalar
;; representation. Drives the CompilerIrInstr.Pack/CompilerIrInstr.Word lowering paths.
(define (lower-type-register-group?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (> (lower-type-register-words ctx ty) 1))

;; Register-residency in ONE inline-layout build, vs the THREE transient
;; layout rebuilds of calling register-resident? + register-group? (which itself
;; rebuilds for resident? and for the size) separately. Returns the machine-word
;; count (1 or 2) of a register-resident aggregate, else 0. Used on the hot match
;; path so the per-function scratch arena keeps the same transient-allocation
;; profile as before this slice (excess rebuilds there overflowed it into a second
;; chunk whose rewind leaked into later lowering).
(define (lower-type-register-words [ctx : tc_core.TcContext] [ty : ast.AstType]) : i64
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ inner)
      (if (lower-reference-to-slice? ctx inner)
        2
        0)]
    [(ast.AstType.MutRef _ inner)
      (if (lower-reference-to-slice? ctx inner)
        2
        0)]
    [(ast.AstType.Struct name)
      (tc_core.tc-inline-aggregate-regwords-cached ctx name)]
    [(ast.AstType.StructArgs name _)
      (tc_core.tc-inline-aggregate-regwords-cached ctx name)]
    [(ast.AstType.Enum name)
      (tc_core.tc-inline-aggregate-regwords-cached ctx name)]
    [(ast.AstType.EnumArgs name _)
      (tc_core.tc-inline-aggregate-regwords-cached ctx name)]
    [_ 0]))

(define (lower-f64-register-word-field?
  [field-ty : ast.AstType]
  [offset : i64]
  [word-index : i64]) : bool
  (match (tc_core.tc-type-strip-region field-ty)
    [(ast.AstType.F64) (and (= (/ offset 8) word-index) (= (% offset 8) 0))]
    [_ false]))

(define (lower-sse-register-word-field?
  [field-ty : ast.AstType]
  [offset : i64]
  [word-index : i64]) : bool
  (match (tc_core.tc-type-strip-region field-ty)
    [(ast.AstType.F64) (and (= (/ offset 8) word-index) (= (% offset 8) 0))]
    [(ast.AstType.F32) (and (= (/ offset 8) word-index) (= (% offset 4) 0))]
    [_ false]))

(define (lower-register-word-type-merge
  [current : ast.AstType]
  [field-ty : ast.AstType]
  [offset : i64]
  [word-index : i64]) : ast.AstType
  (if (lower-sse-register-word-field? field-ty offset word-index)
    (ast.AstType.F64)
    current))

(define (lower-register-struct-word-type-fields
  [fields : tc_core.TcInlineFieldLayoutList]
  [word-index : i64]
  [current : ast.AstType]) : ast.AstType
  (lower-register-struct-word-type-fields-at fields word-index current 0))

(define (lower-register-struct-word-type-fields-at
  [fields : tc_core.TcInlineFieldLayoutList]
  [word-index : i64]
  [current : ast.AstType]
  [index : i64]) : ast.AstType
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    current
    (let
      [field : tc_core.TcInlineFieldLayout
        (tc_core.tc-inline-field-layout-list-ref fields index)]
      (lower-register-struct-word-type-fields-at
        fields
        word-index
        (lower-register-word-type-merge
          current
          (tc_core.tc-inline-field-layout-type field)
          (tc_core.tc-inline-field-layout-offset field)
          word-index)
        (+ index 1)))))

(define (lower-register-payload-word-type-fields
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [word-index : i64]
  [current : ast.AstType]) : ast.AstType
  (lower-register-payload-word-type-fields-at payloads word-index current 0))

(define (lower-register-payload-word-type-fields-at
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [word-index : i64]
  [current : ast.AstType]
  [index : i64]) : ast.AstType
  (if (>= index (tc_core.tc-inline-payload-layout-list-count payloads))
    current
    (let
      [payload : tc_core.TcInlinePayloadLayout
        (tc_core.tc-inline-payload-layout-list-ref payloads index)]
      (lower-register-payload-word-type-fields-at
        payloads
        word-index
        (lower-register-word-type-merge
          current
          (tc_core.tc-inline-payload-layout-type payload)
          (tc_core.tc-inline-payload-layout-offset payload)
          word-index)
        (+ index 1)))))

(define (lower-register-enum-word-type-variants
  [variants : tc_core.TcInlineVariantLayoutList]
  [word-index : i64]
  [current : ast.AstType]) : ast.AstType
  (lower-register-enum-word-type-variants-at variants word-index current 0))

(define (lower-register-enum-word-type-variants-at
  [variants : tc_core.TcInlineVariantLayoutList]
  [word-index : i64]
  [current : ast.AstType]
  [index : i64]) : ast.AstType
  (if (>= index (tc_core.tc-inline-variant-layout-list-count variants))
    current
    (match (tc_core.tc-inline-variant-layout-list-ref variants index)
      [(tc_core.TcInlineVariantLayout.Variant _ _ _ payloads)
        (lower-register-enum-word-type-variants-at
          variants
          word-index
          (lower-register-payload-word-type-fields payloads word-index current)
          (+ index 1))])))

;; Register-resident aggregate word type for lowering/backend movement. INTEGER
;; words are represented as i64 bit words; SSE eightbytes are represented by f64
;; values, including homogeneous packed f32 words carried opaquely in XMM regs.
(define (lower-register-word-type
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [word-index : i64]) : ast.AstType
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ inner)
      (if (lower-reference-to-slice? ctx inner)
        (if (= word-index 0)
          (ast.AstType.U64)
          (ast.AstType.I64))
        (ast.AstType.I64))]
    [(ast.AstType.MutRef _ inner)
      (if (lower-reference-to-slice? ctx inner)
        (if (= word-index 0)
          (ast.AstType.U64)
          (ast.AstType.I64))
        (ast.AstType.I64))]
    [(ast.AstType.Struct name)
      (match (tc_core.tc-inline-aggregate-layout-for-id ctx name)
        [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
          (match layout
            [(tc_core.TcInlineAggregateLayout.Struct _ _ fields)
              (lower-register-struct-word-type-fields
                fields
                word-index
                (ast.AstType.I64))]
            [(tc_core.TcInlineAggregateLayout.Enum _ _ _) (ast.AstType.I64)])]
        [(tc_core.ResultTcInlineAggregateLayout.Err _) (ast.AstType.I64)])]
    [(ast.AstType.StructArgs name _)
      (lower-register-word-type ctx (ast.AstType.Struct name) word-index)]
    [(ast.AstType.Enum name)
      (if (= word-index 0)
        (ast.AstType.I64)
        (match (tc_core.tc-inline-aggregate-layout-for-id ctx name)
          [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
            (match layout
              [(tc_core.TcInlineAggregateLayout.Enum _ _ variants)
                (lower-register-enum-word-type-variants
                  variants
                  word-index
                  (ast.AstType.I64))]
              [(tc_core.TcInlineAggregateLayout.Struct _ _ _) (ast.AstType.I64)])]
          [(tc_core.ResultTcInlineAggregateLayout.Err _) (ast.AstType.I64)]))]
    [(ast.AstType.EnumArgs name _)
      (lower-register-word-type ctx (ast.AstType.Enum name) word-index)]
    [_ (ast.AstType.I64)]))

(define (lower-one-word-register-storage-type
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : ast.AstType
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match resolved
      [(ast.AstType.Array _ _) (ast.AstType.U64)]
      [_
        (if (and
          (lower-type-register-resident? ctx resolved)
          (not (lower-type-register-group? ctx resolved)))
          (let
            [word-ty : ast.AstType (lower-register-word-type ctx resolved 0)]
            (match (tc_core.tc-type-strip-region word-ty)
              [(ast.AstType.F64) word-ty]
              [_ resolved]))
          resolved)])))

(define (lower-type-signed? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.I64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.I8) true]
    [_ false]))

;; Low `size` bytes set to 1 (e.g. size 4 -> 0xffffffff). Used to mask a field
;; to its width before OR-ing it into a packed word. size >= 8 is handled by the
;; callers (no mask needed for a full word).
(define (lower-low-bits-mask [size : i64]) : i64
  (cond
    [(>= size 8) -1]
    [(= size 1) 255]
    [(= size 2) 65535]
    [(= size 3) 16777215]
    [(= size 4) 4294967295]
    [(= size 5) 1099511627775]
    [(= size 6) 281474976710655]
    [(= size 7) 72057594037927935]
    [else -1]))

;; Extract a word-class field from the packed word of a register-resident
;; aggregate. The field occupies bytes [byte-offset, byte-offset+size) of the
;; word; a left shift drops the bytes above it, then a 64-bit arithmetic (signed)
;; or logical (unsigned) right shift moves it to the low bits with the same
;; sign/zero extension a typed memory load would produce.
(define (lower-extract-word-field
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [word : ir.CompilerIrValue]
  [word-ty : ast.AstType]
  [byte-offset : i64]
  [field-ty : ast.AstType]) : LowerExpr
  (let
    [size : i64 (lower-type-size ctx field-ty)]
    (if (>= size 8)
      (LowerExpr.Expr state word field-ty)
      (let
        [bits : LowerExpr
          (match (tc_core.tc-type-strip-region field-ty)
            [(ast.AstType.F32)
              (lower-bitcast-value state word word-ty (ast.AstType.U64))]
            [_ (LowerExpr.Expr state word (ast.AstType.U64))])]
        [left : i64 (- 64 (* (+ byte-offset size) 8))]
        [right : i64 (- 64 (* size 8))]
        (match bits
          [(LowerExpr.Expr bits-state bits-value _)
            (let
              [shifted : LowerExpr
                (if (> left 0)
                  (lower-emit-binop
                    bits-state
                    (ir.CompilerIrBinOp.Shl (ast.AstType.I64))
                    bits-value
                    (ir.CompilerIrValue.I64 left)
                    (ast.AstType.I64))
                  (LowerExpr.Expr bits-state bits-value (ast.AstType.I64)))]
              (match shifted
                [(LowerExpr.Expr shl-state shl-value _)
                  (match (lower-emit-binop
                    shl-state
                    (ir.CompilerIrBinOp.Shr (ast.AstType.I64))
                    shl-value
                    (ir.CompilerIrValue.I64 right)
                    (if (lower-type-signed? field-ty)
                      (ast.AstType.I64)
                      (ast.AstType.U64)))
                    [(LowerExpr.Expr shr-state shr-value _)
                      (match (tc_core.tc-type-strip-region field-ty)
                        [(ast.AstType.F32)
                          (lower-bitcast-value
                            shr-state
                            shr-value
                            (ast.AstType.U64)
                            (ast.AstType.F32))]
                        [_ (LowerExpr.Expr shr-state shr-value field-ty)])])]))])))))

;; OR one field value into the packed-word accumulator: mask it to its byte
;; width (so a sign-extended source cannot bleed into neighbouring fields), shift
;; it to its byte offset, and OR it into `acc`.
(define (lower-pack-word-field
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [byte-offset : i64]
  [field-ty : ast.AstType]) : LowerExpr
  (let
    [size : i64 (lower-type-size ctx field-ty)]
    (if (and
      (>= size 8)
      (lower-f64-register-word-field? field-ty byte-offset 0))
      (LowerExpr.Expr state value field-ty)
      (let
        [bits : LowerExpr
          (match (tc_core.tc-type-strip-region field-ty)
            [(ast.AstType.F32)
              (lower-bitcast-value state value field-ty (ast.AstType.U64))]
            [_ (LowerExpr.Expr state value field-ty)])]
        (match bits
          [(LowerExpr.Expr bits-state bits-value _)
            (let
              [masked : LowerExpr
                (if (>= size 8)
                  (LowerExpr.Expr bits-state bits-value (ast.AstType.U64))
                  (lower-emit-binop
                    bits-state
                    ir.CompilerIrBinOp.BitAnd
                    bits-value
                    (ir.CompilerIrValue.I64 (lower-low-bits-mask size))
                    (ast.AstType.U64)))]
              (match masked
                [(LowerExpr.Expr mask-state mask-value _)
                  (let
                    [shifted : LowerExpr
                      (if (> byte-offset 0)
                        (lower-emit-binop
                          mask-state
                          (ir.CompilerIrBinOp.Shl (ast.AstType.I64))
                          mask-value
                          (ir.CompilerIrValue.I64 (* byte-offset 8))
                          (ast.AstType.I64))
                        (LowerExpr.Expr mask-state mask-value (ast.AstType.U64)))]
                    (match shifted
                      [(LowerExpr.Expr shift-state shift-value _)
                        (lower-emit-binop
                          shift-state
                          ir.CompilerIrBinOp.BitOr
                          acc
                          shift-value
                          (ast.AstType.U64))]))]))])))))

;; Build the packed word for a register-resident struct by folding each field
;; (masked + shifted) into a zero accumulator, in declaration order.
(define (lower-pack-inline-struct-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstFieldDefList]
  [layout : tc_core.TcInlineAggregateLayout]) : ResultLowerExpr
  (lower-pack-inline-struct-values-at
    ctx
    state
    acc
    acc-ty
    values
    (& fields)
    0
    layout))

(define (lower-pack-inline-struct-values-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [values : ir.CompilerIrValueList]
  [fields : (& fields ast.AstFieldDefList)]
  [field-index : i64]
  [layout : tc_core.TcInlineAggregateLayout]) : ResultLowerExpr
  (match (ir.compiler-ir-value-list-force-cons values)
    [(ir.CompilerIrValueList.Nil)
      (if (>= field-index (struct-get fields len))
        (ResultLowerExpr.Ok (LowerExpr.Expr state acc acc-ty))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(ir.CompilerIrValueList.Array seq)
      (lower-pack-inline-struct-values-at
        ctx
        state
        acc
        acc-ty
        (ir.compiler-ir-value-seq-to-list seq)
        fields
        field-index
        layout)]
    [(ir.CompilerIrValueList.Cons value rest-values)
      (if (>= field-index (struct-get fields len))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (match (ast.ast-field-def-list-get
          fields
          field-index
          (ast.ast-field-def-fallback))
          [(ast.AstFieldDef.Def name ty _)
            (let
              [name-str : String (tc_core.tc-env-key-name-text name)]
              [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
              [offset : i64
                (tc_core.tc-inline-aggregate-layout-field-offset-id layout name)]
              (if (< offset 0)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic
                      (string.append
                        "lower: inline struct layout missing field "
                        name-str))))
                (match (lower-pack-word-field
                  ctx
                  state
                  acc
                  value
                  offset
                  resolved)
                  [(LowerExpr.Expr packed-state packed-acc packed-ty)
                    (lower-pack-inline-struct-values-at
                      ctx
                      packed-state
                      packed-acc
                      packed-ty
                      (box-get rest-values)
                      fields
                      (+ field-index 1)
                      layout)])))]))]))

;; Emit an CompilerIrInstr.Pack forming a register-group value from its word values.
(define (lower-emit-pack
  [state : LowerState]
  [words : ir.CompilerIrValueList]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (LowerExpr.Expr
        (lower-state-emit allocated (ir.CompilerIrInstr.Pack var-id words ty))
        (ir.CompilerIrValue.Var var-id)
        ty)]))

;; Emit an CompilerIrInstr.Word extracting word `index` of a register-group value.
(define (lower-emit-word
  [state : LowerState]
  [group : ir.CompilerIrValue]
  [index : i64]
  [word-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (LowerExpr.Expr
        (lower-state-emit
          allocated
          (ir.CompilerIrInstr.Word var-id group index word-ty))
        (ir.CompilerIrValue.Var var-id)
        word-ty)]))

(define (lower-register-word-sse-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.F64) true]
    [_ false]))

(define (lower-materialize-register-word
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [word-ty : ast.AstType]) : LowerExpr
  (if (tc_core.tc-type-eq from-ty word-ty)
    (LowerExpr.Expr state value word-ty)
    (if (lower-register-word-sse-type? word-ty)
      (lower-bitcast-value state value (ast.AstType.U64) word-ty)
      (LowerExpr.Expr state value word-ty))))

;; `=` / `!=` on a 2-word register-group aggregate must compare BOTH
;; words; the scalar CompilerIrInstr.BinOp compared only word0, so two enum values with
;; equal tags but different payloads compared equal.
(define (lower-binop-group-eq? [op : ast.AstBinOp]) : bool
  (match op
    [(ast.AstBinOp.Eq) true]
    [(ast.AstBinOp.Ne) true]
    [_ false]))

(define (lower-group-equality
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [op : ast.AstBinOp]
  [left : ir.CompilerIrValue]
  [right : ir.CompilerIrValue]
  [group-ty : ast.AstType]
  [expr-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-emit-word
    state
    left
    0
    (lower-register-word-type ctx group-ty 0))
    [(LowerExpr.Expr ls0 l0 _)
      (match (lower-emit-word
        ls0
        left
        1
        (lower-register-word-type ctx group-ty 1))
        [(LowerExpr.Expr ls1 l1 _)
          (match (lower-emit-word
            ls1
            right
            0
            (lower-register-word-type ctx group-ty 0))
            [(LowerExpr.Expr rs0 r0 _)
              (match (lower-emit-word
                rs0
                right
                1
                (lower-register-word-type ctx group-ty 1))
                [(LowerExpr.Expr rs1 r1 _)
                  (match (lower-state-alloc-var rs1)
                    [(LowerAlloc.Alloc alloc0 word0-cmp)
                      (match (lower-state-alloc-var alloc0)
                        [(LowerAlloc.Alloc alloc1 word1-cmp)
                          (match (lower-state-alloc-var alloc1)
                            [(LowerAlloc.Alloc alloc2 combined)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr
                                  (lower-state-emit-at-expr
                                    (lower-state-emit
                                      (lower-state-emit
                                        alloc2
                                        (ir.CompilerIrInstr.BinOp
                                          word0-cmp
                                          (lower-binop
                                            op
                                            (lower-register-word-type
                                              ctx
                                              group-ty
                                              0))
                                          l0
                                          r0
                                          (lower-register-word-type
                                            ctx
                                            group-ty
                                            0)))
                                      (ir.CompilerIrInstr.BinOp
                                        word1-cmp
                                        (lower-binop
                                          op
                                          (lower-register-word-type
                                            ctx
                                            group-ty
                                            1))
                                        l1
                                        r1
                                        (lower-register-word-type
                                          ctx
                                          group-ty
                                          1)))
                                    (ir.CompilerIrInstr.BinOp
                                      combined
                                      ;; eq: both words equal; ne: either differs.
                                      (match op
                                        [(ast.AstBinOp.Ne)
                                          ir.CompilerIrBinOp.BitOr]
                                        [_ ir.CompilerIrBinOp.BitAnd])
                                      (ir.CompilerIrValue.Var word0-cmp)
                                      (ir.CompilerIrValue.Var word1-cmp)
                                      expr-ty)
                                    origin)
                                  (ir.CompilerIrValue.Var combined)
                                  expr-ty))])])])])])])]))

;; Read a payload field of a register-group enum scrutinee. `base` is the
;; enum group var; the field at enum byte `offset` lives in word `offset/8` (the
;; payload word for a 16-byte enum), extracted with CompilerIrInstr.Word then shift/mask at
;; its relative offset.
(define (lower-read-register-group-payload
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [base-ty : ast.AstType]
  [offset : i64]
  [field-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-word
    state
    base
    (/ offset 8)
    (lower-register-word-type ctx base-ty (/ offset 8)))
    [(LowerExpr.Expr w-state w-value _)
      (lower-extract-word-field
        ctx
        w-state
        w-value
        (lower-register-word-type ctx base-ty (/ offset 8))
        (- offset (* (/ offset 8) 8))
        field-ty)]))

;; Store a 2-word register-group `value` to memory at pointer `ptr`
;; (word0 at [ptr], word1 at [ptr+8]) -- used when a group is embedded in a
;; pointer-addressed container (array element, dynarray, box, ...).
(define (lower-store-group-at-ptr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerState
  (match (lower-emit-word state value 0 (lower-register-word-type ctx ty 0))
    [(LowerExpr.Expr s0 w0 _)
      (match (lower-emit-word s0 value 1 (lower-register-word-type ctx ty 1))
        [(LowerExpr.Expr s1 w1 _)
          (match (lower-gep-byte
            (lower-state-emit
              s1
              (ir.CompilerIrInstr.StorePtr
                ptr
                w0
                (lower-register-word-type ctx ty 0)))
            ptr
            8)
            [(LowerExpr.Expr s2 ptr8 _)
              (lower-state-emit
                s2
                (ir.CompilerIrInstr.StorePtr
                  ptr8
                  w1
                  (lower-register-word-type ctx ty 1)))])])]))

;; Load a 2-word register-group from memory at pointer `ptr` and reassemble
;; it with CompilerIrInstr.Pack (word0 from [ptr], word1 from [ptr+8]).
(define (lower-load-group-from-ptr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-load-at-offset state ptr 0 (lower-register-word-type ctx ty 0))
    [(LowerExpr.Expr s0 w0 _)
      (match (lower-load-at-offset s0 ptr 8 (lower-register-word-type ctx ty 1))
        [(LowerExpr.Expr s1 w1 _)
          (lower-emit-pack
            s1
            (ir.compiler-ir-value-cons
              w0
              (ir.compiler-ir-value-cons w1 ir.CompilerIrValueList.Nil))
            ty)])]))

;; Internal descriptor-pair transport. Source String/DynArray values remain
;; one-word pointers; only values built by this helper become structural
;; Pack/Word groups. The pair order matches descriptor storage exactly:
;; data_ptr in word0, nonnegative length in word1.
(define (lower-load-register-resident-from-ptr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (if (lower-type-register-group? ctx ty)
    (lower-load-group-from-ptr ctx state ptr ty)
    (match (lower-load-at-offset
      state
      ptr
      0
      (lower-register-word-type ctx ty 0))
      [(LowerExpr.Expr load-state loaded _)
        (LowerExpr.Expr load-state loaded ty)])))

;; Build the packed value for ONE machine word (`word-index`) of a
;; register-group struct: fold in only the fields that live in that word, each at
;; its offset RELATIVE to the word base, leaving an all-zero accumulator for words
;; with no field. Fields straddling a word boundary cannot occur for word-class
;; fields in a C-layout aggregate (each is naturally aligned within a word).
(define (lower-pack-inline-struct-word
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstFieldDefList]
  [layout : tc_core.TcInlineAggregateLayout]
  [word-index : i64]) : ResultLowerExpr
  (lower-pack-inline-struct-word-at
    ctx
    state
    acc
    acc-ty
    values
    (& fields)
    0
    layout
    word-index))

(define (lower-pack-inline-struct-word-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [values : ir.CompilerIrValueList]
  [fields : (& fields ast.AstFieldDefList)]
  [field-index : i64]
  [layout : tc_core.TcInlineAggregateLayout]
  [word-index : i64]) : ResultLowerExpr
  (match (ir.compiler-ir-value-list-force-cons values)
    [(ir.CompilerIrValueList.Nil)
      (if (>= field-index (struct-get fields len))
        (ResultLowerExpr.Ok (LowerExpr.Expr state acc acc-ty))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(ir.CompilerIrValueList.Array seq)
      (lower-pack-inline-struct-word-at
        ctx
        state
        acc
        acc-ty
        (ir.compiler-ir-value-seq-to-list seq)
        fields
        field-index
        layout
        word-index)]
    [(ir.CompilerIrValueList.Cons value rest-values)
      (if (>= field-index (struct-get fields len))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (match (ast.ast-field-def-list-get
          fields
          field-index
          (ast.ast-field-def-fallback))
          [(ast.AstFieldDef.Def name ty _)
            (let
              [name-str : String (tc_core.tc-env-key-name-text name)]
              [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
              [offset : i64
                (tc_core.tc-inline-aggregate-layout-field-offset-id layout name)]
              (if (< offset 0)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic
                      (string.append
                        "lower: inline struct layout missing field "
                        name-str))))
                (if (= (/ offset 8) word-index)
                  (match (lower-pack-word-field
                    ctx
                    state
                    acc
                    value
                    (- offset (* word-index 8))
                    resolved)
                    [(LowerExpr.Expr packed-state packed-acc packed-ty)
                      (lower-pack-inline-struct-word-at
                        ctx
                        packed-state
                        packed-acc
                        packed-ty
                        (box-get rest-values)
                        fields
                        (+ field-index 1)
                        layout
                        word-index)])
                  (lower-pack-inline-struct-word-at
                    ctx
                    state
                    acc
                    acc-ty
                    (box-get rest-values)
                    fields
                    (+ field-index 1)
                    layout
                    word-index))))]))]))

;; Construct a register-group struct value: pack each machine word and
;; combine them with IrInstrPack. Two-word integer-class structs only.
(define (lower-construct-struct-register-group
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstFieldDefList]
  [layout : tc_core.TcInlineAggregateLayout]
  [struct-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-pack-inline-struct-word
    ctx
    state
    (ir.CompilerIrValue.I64 0)
    (ast.AstType.I64)
    values
    fields
    layout
    0)
    [(ResultLowerExpr.Ok (LowerExpr.Expr s0 raw-word0 raw-ty0))
      (match (lower-materialize-register-word
        s0
        raw-word0
        raw-ty0
        (lower-register-word-type ctx struct-ty 0))
        [(LowerExpr.Expr w0-state word0 _)
          (match (lower-pack-inline-struct-word
            ctx
            w0-state
            (ir.CompilerIrValue.I64 0)
            (ast.AstType.I64)
            values
            fields
            layout
            1)
            [(ResultLowerExpr.Ok (LowerExpr.Expr s1 raw-word1 raw-ty1))
              (match (lower-materialize-register-word
                s1
                raw-word1
                raw-ty1
                (lower-register-word-type ctx struct-ty 1))
                [(LowerExpr.Expr w1-state word1 _)
                  (match (lower-emit-pack
                    w1-state
                    (ir.compiler-ir-value-cons
                      word0
                      (ir.compiler-ir-value-cons
                        word1
                        ir.CompilerIrValueList.Nil))
                    struct-ty)
                    [(LowerExpr.Expr ps pv _)
                      (ResultLowerExpr.Ok (LowerExpr.Expr ps pv struct-ty))])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; Fold a register-group enum variant's payload values into word1 (the
;; payload word), each field masked + shifted to its offset RELATIVE to the
;; payload word (payload starts at enum byte 8, i.e. relative offset 0).
(define (lower-pack-enum-payload-word
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [cursor : i64]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstTypeList]) : ResultLowerExpr
  (match (ir.compiler-ir-value-list-force-cons values)
    [(ir.CompilerIrValueList.Nil)
      (ResultLowerExpr.Ok (LowerExpr.Expr state acc acc-ty))]
    [(ir.CompilerIrValueList.Array seq)
      (lower-pack-enum-payload-word
        ctx
        state
        acc
        acc-ty
        cursor
        (ir.compiler-ir-value-seq-to-list seq)
        fields)]
    [(ir.CompilerIrValueList.Cons value rest-values)
      (if (ast.ast-type-list-empty? (& fields))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: enum payload arity mismatch")))
        (let
          [ty-id : i64
            (ast.ast-type-list-get (& fields) 0 (ast.ast-type-id-fallback))]
          [rest-fields : ast.AstTypeList (ast.ast-type-list-slice fields 1)]
          [resolved : ast.AstType
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx ty-id))]
          [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
          (match (lower-pack-word-field ctx state acc value offset resolved)
            [(LowerExpr.Expr packed-state packed-acc packed-ty)
              (lower-pack-enum-payload-word
                ctx
                packed-state
                packed-acc
                packed-ty
                (+ offset (lower-type-size ctx resolved))
                (box-get rest-values)
                rest-fields)])))]))

;; Construct a register-group enum value: word0 = discriminant tag, word1 =
;; the variant's packed (word-class) payload (0 for a nullary variant).
(define (lower-construct-enum-register-group
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [handle : i64]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstTypeList]
  [enum-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-pack-enum-payload-word
    ctx
    state
    (ir.CompilerIrValue.I64 0)
    (ast.AstType.I64)
    0
    values
    fields)
    [(ResultLowerExpr.Ok (LowerExpr.Expr s1 raw-word1 raw-ty1))
      (match (lower-materialize-register-word
        s1
        raw-word1
        raw-ty1
        (lower-register-word-type ctx enum-ty 1))
        [(LowerExpr.Expr w1-state word1 _)
          (match (lower-emit-pack
            w1-state
            (ir.compiler-ir-value-cons
              (ir.CompilerIrValue.I64
                (csym.compiler-registry-handle-child-index handle))
              (ir.compiler-ir-value-cons word1 ir.CompilerIrValueList.Nil))
            enum-ty)
            [(LowerExpr.Expr ps pv _)
              (ResultLowerExpr.Ok (LowerExpr.Expr ps pv enum-ty))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-store-inline-value-at-offset
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [size : i64]) : LowerState
  ;; A register-resident aggregate is carried as a word, so embedding it
  ;; in a memory aggregate is a scalar store of that word, not a byte-copy from a
  ;; pointer. A 2-word register-group stores BOTH words (word0 at offset, word1 at
  ;; offset+8). Only a genuine memory aggregate (inline struct/enum/tuple that
  ;; is not register-resident) needs the byte-copy.
  (if (and
    (lower-type-inline-storage? ctx ty)
    (not (lower-type-register-resident? ctx ty)))
    (lower-copy-bytes state base offset value 0 size)
    (if (lower-type-register-group? ctx ty)
      (match (lower-emit-word state value 0 (lower-register-word-type ctx ty 0))
        [(LowerExpr.Expr s0 w0 _)
          (match (lower-emit-word
            s0
            value
            1
            (lower-register-word-type ctx ty 1))
            [(LowerExpr.Expr s1 w1 _)
              (lower-store-at-offset
                (lower-store-at-offset
                  s1
                  base
                  offset
                  w0
                  (lower-register-word-type ctx ty 0))
                base
                (+ offset 8)
                w1
                (lower-register-word-type ctx ty 1))])])
      (lower-store-at-offset
        state
        base
        offset
        value
        (if (lower-type-register-resident? ctx ty)
          (lower-register-word-type ctx ty 0)
          ty)))))

(define (lower-load-inline-value-at-offset
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [ty : ast.AstType]
  [mode : CompilerLowerMode]) : LowerExpr
  ;; A register-resident aggregate field is loaded as a word (a scalar
  ;; load), not returned as a pointer into the containing slot. A 2-word
  ;; register-group loads BOTH words and reassembles them with IrInstrPack. Only a
  ;; genuine memory aggregate keeps the pointer-return shape.
  (cond
    [(and
        (lower-mode-inline-aggregates? mode)
        (lower-type-inline-storage? ctx ty)
        (not (lower-type-register-resident? ctx ty)))
      (match (lower-gep-byte state base offset)
        [(LowerExpr.Expr ptr-state ptr _) (LowerExpr.Expr ptr-state ptr ty)])]
    [(lower-type-register-group? ctx ty)
      (match (lower-load-at-offset
        state
        base
        offset
        (lower-register-word-type ctx ty 0))
        [(LowerExpr.Expr s0 w0 _)
          (match (lower-load-at-offset
            s0
            base
            (+ offset 8)
            (lower-register-word-type ctx ty 1))
            [(LowerExpr.Expr s1 w1 _)
              (lower-emit-pack
                s1
                (ir.compiler-ir-value-cons
                  w0
                  (ir.compiler-ir-value-cons w1 ir.CompilerIrValueList.Nil))
                ty)])])]
    [(lower-type-register-resident? ctx ty)
      (match (lower-load-at-offset
        state
        base
        offset
        (lower-register-word-type ctx ty 0))
        [(LowerExpr.Expr load-state loaded _)
          (LowerExpr.Expr load-state loaded ty)])]
    [else (lower-load-at-offset state base offset ty)]))

(define (lower-copy-bytes-compact
  [state : LowerState (:consume)]
  [dst : ir.CompilerIrValue]
  [dst-offset : i64]
  [src : ir.CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (if (<= size 0)
    state
    (if (and (= dst-offset 0) (= src-offset 0))
      (lower-state-emit state (ir.CompilerIrInstr.CopyBytes dst src size))
      (lower-copy-bytes state dst dst-offset src src-offset size))))

(define (lower-inline-aggregate-copy-size
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : ResultLowerSize
  (match (tc_core.tc-inline-aggregate-type-layout ctx ty)
    [(tc_core.ResultTcLayoutInfo.Ok info)
      (match info
        [(tc_core.TcLayoutInfo size _) (ResultLowerSize.Ok size)])]
    [(tc_core.ResultTcLayoutInfo.Err message) (ResultLowerSize.Err message)]))

(define (lower-copy-inline-aggregate-to-inline
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (match (lower-inline-aggregate-copy-size ctx ty)
    [(ResultLowerSize.Ok size)
      (match (lower-reserve-inline-storage state size ty)
        [(LowerExpr.Expr copy-state copy-value _)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              ;; A register-resident source is carried as word(s), so
              ;; materialize via the group-aware store -- a 2-word group must
              ;; write BOTH words (a bare scalar store dropped word1).
              (if (lower-type-register-resident? ctx ty)
                (lower-store-inline-value-at-offset
                  ctx
                  copy-state
                  copy-value
                  0
                  value
                  ty
                  size)
                (lower-copy-bytes-compact copy-state copy-value 0 value 0 size))
              copy-value
              ty))])]
    [(ResultLowerSize.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic message)))]))

(define (lower-copy-inline-aggregate-to-heap-as
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [storage-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-inline-aggregate-copy-size ctx ty)
    [(ResultLowerSize.Ok size)
      (match (lower-reserve-heap-storage state size storage-ty)
        [(LowerExpr.Expr copy-state copy-value _)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              ;; Group-aware store here too -- the Win64 C-ABI byref
              ;; path spills register-resident aggregates through this copy,
              ;; and a 2-word group must write BOTH words.
              (if (lower-type-register-resident? ctx ty)
                (lower-store-inline-value-at-offset
                  ctx
                  copy-state
                  copy-value
                  0
                  value
                  ty
                  size)
                (lower-copy-bytes-compact copy-state copy-value 0 value 0 size))
              copy-value
              storage-ty))])]
    [(ResultLowerSize.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic message)))]))

(define (lower-copy-inline-aggregate-to-heap
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (lower-copy-inline-aggregate-to-heap-as ctx state value ty ty))

(define (lower-inline-aggregate-abi-copy-needed?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ty : ast.AstType]) : bool
  (and
    (lower-mode-inline-aggregates? (lower-state-mode state))
    ;; A register-resident aggregate is returned/passed in a register,
    ;; so it needs neither a heap escape-copy nor a caller-provided sret slot.
    (lower-type-inline-storage? ctx ty)
    (not (lower-type-register-resident? ctx ty))))

(define (lower-return-abi-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (if (lower-inline-aggregate-abi-copy-needed? ctx state ty)
    (lower-copy-inline-aggregate-to-heap ctx state value ty)
    (ResultLowerExpr.Ok (LowerExpr.Expr state value ty))))

(define (lower-local-assignment-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [target-var : i64]) : ResultLowerExpr
  (if (and
    (= (lower-state-current-function-id state) lower-active-loop-function)
    (< target-var lower-active-loop-entry-var-limit)
    (>=
      (lower-state-inline-result-alias-origin state value)
      lower-active-loop-entry-var-limit))
    ;; A loop-carried memory-class binding must not retain a pointer to the
    ;; producer's fixed frame slot: that same expression reuses the slot after
    ;; the backedge. Copy into a dedicated frame slot for this assignment site;
    ;; it remains valid until this same assignment replaces the old value and
    ;; does not inherit the active arena's lifetime.
    (lower-copy-inline-aggregate-to-inline ctx state value ty)
    (ResultLowerExpr.Ok (LowerExpr.Expr state value ty))))

(define (lower-current-sret-var [env : sym_i64_env.SymI64Env]) : i64
  (let
    [marker : i64 (lower-sret-param-marker-id)]
    (if (sym_i64_env.sym-i64-contains-id env marker)
      (sym_i64_env.sym-i64-lookup-id-or
        env
        marker
        (csym.compiler-symbols-missing-handle))
      (- 0 1))))

;; Convert a source-level structural value (always represented by a pointer in
;; expression lowering) to the physical return value required by the internal
;; classifier. The sret case performs only a shallow byte move into the hidden
;; caller slot; ownership remains with the already-lowered source expression.
(define (lower-internal-return-register-two
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ret-ty : ast.AstType]
  [classification : LowerCAbiAggregate]
  [first : LowerCAbiSlot]
  [second : LowerCAbiSlot]) : ResultLowerExpr
  (match first
    [(LowerCAbiSlot.Slot first-ty first-offset)
      (match (lower-load-at-offset state value first-offset first-ty)
        [(LowerExpr.Expr first-state first-value _)
          (match second
            [(LowerCAbiSlot.Slot second-ty second-offset)
              (match (lower-load-at-offset
                first-state
                value
                second-offset
                second-ty)
                [(LowerExpr.Expr second-state second-value _)
                  (match (lower-emit-pack
                    second-state
                    (ir.compiler-ir-value-cons
                      first-value
                      (ir.compiler-ir-value-cons
                        second-value
                        ir.CompilerIrValueList.Nil))
                    (lower-internal-transport-type ctx ret-ty classification))
                    [(LowerExpr.Expr packed-state packed-value _)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          packed-state
                          packed-value
                          (lower-internal-transport-type
                            ctx
                            ret-ty
                            classification)))])])])])]))

(define (lower-prepare-internal-return-no
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [value : ir.CompilerIrValue]
  [ret-ty : ast.AstType]) : ResultLowerExpr
  (let
    [sret-var : i64 (lower-current-sret-var env)]
    (if (and
      (>= sret-var 0)
      (lower-type-inline-struct-or-enum? ctx ret-ty)
      (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
      (match (lower-inline-aggregate-copy-size ctx ret-ty)
        [(ResultLowerSize.Ok size)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-copy-bytes
                state
                (ir.CompilerIrValue.Var sret-var)
                0
                value
                0
                size)
              (ir.CompilerIrValue.Var sret-var)
              ret-ty))]
        [(ResultLowerSize.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic message)))])
      (lower-return-abi-value ctx state value ret-ty))))

(define (lower-prepare-internal-return-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [value : ir.CompilerIrValue]
  [ret-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-internal-structural-resolved-type? ret-ty)
    (let
      [class : LowerCAbiAggregate
        (lower-internal-return-class-for-name
          ctx
          (lower-state-mode state)
          (lower-state-current-function state)
          ret-ty)]
      (match class
        [(LowerCAbiAggregate.Integer scalar-ty _)
          (match (lower-load-at-offset state value 0 scalar-ty)
            [(LowerExpr.Expr loaded loaded-value _)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr loaded loaded-value scalar-ty))])]
        [(LowerCAbiAggregate.Register slots _)
          (if (= (lower-c-abi-slot-list-count slots) 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(LowerCAbiSlot.Slot scalar-ty offset)
                (match (lower-load-at-offset state value offset scalar-ty)
                  [(LowerExpr.Expr loaded loaded-value _)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr loaded loaded-value scalar-ty))])])
            (lower-internal-return-register-two
              ctx
              state
              value
              ret-ty
              class
              (lower-c-abi-slot-list-ref slots 0)
              (lower-c-abi-slot-list-ref slots 1)))]
        [(LowerCAbiAggregate.Sret size)
          (let
            [sret-var : i64 (lower-current-sret-var env)]
            (if (< sret-var 0)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic
                    "lower: structural return missing hidden sret parameter")))
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-copy-bytes
                    state
                    (ir.CompilerIrValue.Var sret-var)
                    0
                    value
                    0
                    size)
                  (ir.CompilerIrValue.Var sret-var)
                  (ast.AstType.U64)))))]
        [(LowerCAbiAggregate.No)
          (lower-prepare-internal-return-no ctx state env value ret-ty)]
        [(LowerCAbiAggregate.ByRef _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                "lower: byref return classification is unsupported")))]
        [(LowerCAbiAggregate.Memory _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                "lower: memory return classification is unsupported")))]
        [(LowerCAbiAggregate.Unsupported message)
          (ResultLowerExpr.Err (box (lower-diagnostic message)))]))
    (lower-prepare-internal-return-no ctx state env value ret-ty)))

(define (lower-raw-pointer-ir-type [ty : ast.AstType]) : ast.AstType
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Ptr _) (ast.AstType.U64)]
    [(ast.AstType.MutPtr _) (ast.AstType.U64)]
    [_ ty]))

(define (lower-cast-value
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (let
    [ir-from-ty : ast.AstType (lower-raw-pointer-ir-type from-ty)]
    [ir-to-ty : ast.AstType (lower-raw-pointer-ir-type to-ty)]
    (if (or
      (tc_core.tc-type-eq from-ty to-ty)
      (tc_core.tc-type-eq ir-from-ty ir-to-ty))
      (LowerExpr.Expr state value to-ty)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (LowerExpr.Expr
            (lower-state-emit
              allocated
              (ir.CompilerIrInstr.Cast var-id value ir-from-ty ir-to-ty))
            (ir.CompilerIrValue.Var var-id)
            to-ty)]))))

(define (lower-literal-float-to-bits?
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region from-ty)
    [(ast.AstType.F64)
      (match (tc_core.tc-type-strip-region to-ty)
        [(ast.AstType.U64) true]
        [_ false])]
    [(ast.AstType.F32)
      (match (tc_core.tc-type-strip-region to-ty)
        [(ast.AstType.U32) true]
        [_ false])]
    [_ false]))

(define (lower-runtime-bitcast-value
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (LowerExpr.Expr
        (lower-state-emit
          allocated
          (ir.CompilerIrInstr.Bitcast var-id value from-ty to-ty))
        (ir.CompilerIrValue.Var var-id)
        to-ty)]))

(define (lower-bitcast-value
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (if (tc_core.tc-type-eq from-ty to-ty)
    (LowerExpr.Expr state value to-ty)
    (match value
      [(ir.CompilerIrValue.F64 bits)
        (if (lower-literal-float-to-bits? from-ty to-ty)
          (LowerExpr.Expr
            state
            (ir.CompilerIrValue.I64 (cast bits : i64))
            to-ty)
          (lower-runtime-bitcast-value state value from-ty to-ty))]
      [_ (lower-runtime-bitcast-value state value from-ty to-ty)])))

(define (lower-coerce-value
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (cond
    [(tc_core.tc-never-type? from-ty) (LowerExpr.Expr state value from-ty)]
    [(tc_core.tc-type-eq from-ty to-ty) (LowerExpr.Expr state value to-ty)]
    [(tc_core.tc-type-compatible? to-ty from-ty)
      (lower-cast-value state value from-ty to-ty)]
    [else (LowerExpr.Expr state value to-ty)]))

(define (lower-oob-abort [state : LowerState]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (lower-state-emit
        allocated
        (ir.CompilerIrInstr.Call
          var-id
          (lower-tl-oob-abort-symbol)
          (ir.CompilerIrCallArgs.Nil)
          (ast.AstType.Unit)))]))

(define (lower-shift-abort [state : LowerState]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (lower-state-emit
        allocated
        (ir.CompilerIrInstr.Call
          var-id
          (lower-tl-shift-abort-symbol)
          (ir.CompilerIrCallArgs.Nil)
          (ast.AstType.Unit)))]))

(define (lower-string-fields [state : LowerState] [value : ir.CompilerIrValue]) : LowerStringFields
  (match (lower-load-at-offset state value 0 (ast.AstType.U64))
    [(LowerExpr.Expr ptr-state ptr _)
      (match (lower-load-at-offset ptr-state value 8 (ast.AstType.I64))
        [(LowerExpr.Expr len-state len _)
          (LowerStringFields.Fields len-state ptr len)])]))

(define (lower-str-ref-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ inner)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx inner)))
        [(ast.AstType.Str) true]
        [_ false])]
    [_ false]))

(define (lower-bytes-ref-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ inner)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx inner)))
        [(ast.AstType.Bytes) true]
        [_ false])]
    [(ast.AstType.MutRef _ inner)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx inner)))
        [(ast.AstType.Bytes) true]
        [_ false])]
    [_ false]))

(define (lower-string-handle-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.String) true]
    [_ (lower-str-ref-type? ctx ty)]))

(define (lower-bytes-handle-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (lower-bytes-ref-type? ctx ty))

(define (lower-length-handle-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (or (lower-string-handle-type? ctx ty) (lower-bytes-handle-type? ctx ty)))

(define (lower-string-concat-legacy-name? [name : String]) : bool
  (or (string.eq name "string-append") (string.eq name "string-concat")))

(define (lower-string-concat-public-target? [name : String]) : bool
  ;; Dotted imports resolve to module-key names before direct-call lowering.
  ;; Match that identity instead of the source spelling, so aliases remain
  ;; eligible while same-shaped user functions remain ordinary calls.
  (or
    (string.eq name (csym.compiler-symbol-module-key "stdlib.string" "append"))
    (string.eq name (csym.compiler-symbol-module-key "stdlib.string" "concat"))))

(define (lower-float-to-bits-public-target? [name : String]) : bool
  ;; Public stdlib wrappers are semantically the private bitcast intrinsic.
  ;; Match their resolved module identity so aliases are eligible while
  ;; same-shaped user functions remain ordinary calls.
  (or
    (string.eq
      name
      (csym.compiler-symbol-module-key "stdlib.math" "f64-to-bits"))
    (string.eq
      name
      (csym.compiler-symbol-module-key "stdlib.math" "f32-to-bits"))
    (string.eq name "math.tl::stdlib.math/f64-to-bits")
    (string.eq name "math.tl::stdlib.math/f32-to-bits")
    (string.eq name "stdlib/math.tl::stdlib.math/f64-to-bits")
    (string.eq name "stdlib/math.tl::stdlib.math/f32-to-bits")
    (string.eq name "stdlib\\math.tl::stdlib.math/f64-to-bits")
    (string.eq name "stdlib\\math.tl::stdlib.math/f32-to-bits")))

(define (lower-string-concat-public-source-name? [name : String]) : bool
  ;; These canonical spellings dominate compiler source and must not re-run
  ;; dotted-import resolution at every node of one deep tree. A local binding
  ;; is still rejected by the caller before this fast path is used.
  (or
    (string.eq name "string.append")
    (string.eq name "string.concat")
    (string.eq name "stdlib.string.append")
    (string.eq name "stdlib.string.concat")))

;; A tail call first runs direct-call/TCO eligibility checks over its arguments.
;; Those checks typecheck the whole argument subtree, which is needlessly
;; expensive for a concat tree that will lower to runtime calls rather than a
;; tail call. Recognize the public concat target once at the root and take the
;; ordinary return-expression path directly.
(define (lower-string-concat-call-source?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : bool
  (let
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or name-id name-id)]
    [raw-name : String (ci.intern-str source-id)]
    (and
      (not (tc_core.tc-dotted-local-field-name-id? type-env source-id))
      (or
        (and
          (lower-string-concat-legacy-name? raw-name)
          (lower-builtin-call-available-id? ctx env name-id))
        (match (lower-source-name-lookup-key-id ctx type-env source-id)
          [(tc_core.ResultTcString.Ok lookup-name)
            (lower-string-concat-public-target? lookup-name)]
          [(tc_core.ResultTcString.Err _) false])))))

(define (lower-string-concat-call-parts
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : LowerMaybeStringConcatCall
  (match (ast.ast-expr-unspan-with-pools (tc_core.tc-context-pools ctx) expr)
    [(ast.AstExpr.Call callee-box args)
      (match (ast.ast-expr-unspan-with-pools
        (tc_core.tc-context-pools ctx)
        (tc_core.tc-context-expr-get ctx callee-box))
        [(ast.AstExpr.Var name)
          (let
            [raw-name-id : i64
              (tc_core.macro-hygiene-global-source-name-id-or name name)]
            [raw-name : String (ci.intern-str raw-name-id)]
            (if (= (struct-get (& args) len) 2)
              (if (or
                (and
                  (lower-string-concat-public-source-name? raw-name)
                  (not
                    (tc_core.tc-dotted-local-field-name-id?
                      type-env
                      raw-name-id))
                  (not (sym_i64_env.sym-i64-contains-id env raw-name-id))
                  (not (lower-top-level-value-defined-id? ctx raw-name-id)))
                (and
                  (lower-string-concat-legacy-name? raw-name)
                  (lower-builtin-call-available-id? ctx env name))
                (match (lower-source-name-lookup-key-id
                  ctx
                  type-env
                  raw-name-id)
                  [(tc_core.ResultTcString.Ok lookup-name)
                    (lower-string-concat-public-target? lookup-name)]
                  [(tc_core.ResultTcString.Err _) false]))
                (LowerMaybeStringConcatCall.Some
                  (ast.ast-expr-list-get (& args) 0 0)
                  (ast.ast-expr-list-get (& args) 1 0))
                (LowerMaybeStringConcatCall.No))
              (LowerMaybeStringConcatCall.No)))]
        [_ (LowerMaybeStringConcatCall.No)])]
    [_ (LowerMaybeStringConcatCall.No)]))

(define (lower-string-concat-work-pop
  [pending : (&mut pending ast.AstExprList)]) : i64
  (let
    [index : i64 (- (struct-get pending len) 1)]
    (begin
      (set! (struct-get pending len) index)
      (array-ref (struct-get pending slots) index))))

;; Flatten the complete binary concat tree without recursively lowering its
;; children. The explicit LIFO worklist pushes right before left, preserving
;; source evaluation order without the retained LowerState chain that made deep
;; left/right trees grow superlinearly.
(define (lower-string-concat-exprs-all
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]) : ast.AstExprList
  (let
    [pending : ast.AstExprList (ast.ast-expr-list-with-capacity 16)]
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity 16)]
    (begin
      (ast.ast-expr-list-push
        (&mut pending)
        (ast.ast-expr-list-get (& exprs) 1 0))
      (ast.ast-expr-list-push
        (&mut pending)
        (ast.ast-expr-list-get (& exprs) 0 0))
      (while (not (ast.ast-expr-list-empty? (& pending)))
        (let
          [expr-id : i64 (lower-string-concat-work-pop (&mut pending))]
          [expr : ast.AstExpr (tc_core.tc-context-expr-get ctx expr-id)]
          (begin
            (match (lower-string-concat-call-parts ctx env type-env expr)
              [(LowerMaybeStringConcatCall.Some nested-left nested-right)
                (begin
                  (ast.ast-expr-list-push (&mut pending) nested-right)
                  (ast.ast-expr-list-push (&mut pending) nested-left))]
              [(LowerMaybeStringConcatCall.No)
                (ast.ast-expr-list-push (&mut out) expr-id)])
            unit)))
      out)))

(define (lower-string-concat-runtime-name [count : i64]) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    (cond
      [(= count 3) cbi.compiler-builtin-id-tl-string-concat3]
      [(= count 4) cbi.compiler-builtin-id-tl-string-concat4]
      [(= count 5) cbi.compiler-builtin-id-tl-string-concat5]
      [else cbi.compiler-builtin-id-tl-string-concat])))

(define (lower-string-concat-values-rev-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [end : i64]
  [acc : ir.CompilerIrValueList]
  [count : i64]) : ResultLowerStringValues
  (if (>= index end)
    (ResultLowerStringValues.Ok state acc count)
    (let
      [expr : ast.AstExpr
        (tc_core.tc-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
      (match (lower-expr ctx state env type-env expr)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr expr-state value expr-ty)
              (if (lower-string-handle-type? ctx expr-ty)
                (match (lower-string-fields expr-state value)
                  [(LowerStringFields.Fields field-state ptr len)
                    (lower-string-concat-values-rev-at
                      ctx
                      field-state
                      env
                      type-env
                      exprs
                      (+ index 1)
                      end
                      (ir.compiler-ir-value-cons-linked
                        len
                        (ir.compiler-ir-value-cons-linked ptr acc))
                      (+ count 1))])
                (ResultLowerStringValues.Err
                  (box
                    (lower-diagnostic-at-expr
                      expr
                      "lower: string-concat requires String"))))])]
        [(ResultLowerExpr.Err message) (ResultLowerStringValues.Err message)]))))

(define (lower-string-concat-emit
  [state : LowerState]
  [values-rev : ir.CompilerIrValueList]
  [count : i64]) : LowerExpr
  (begin
    (cfg
      compile-profile
      (set!
        compiler-lower-profile-string-concat-runtime-calls
        (+ compiler-lower-profile-string-concat-runtime-calls 1)))
    (match (lower-state-alloc-var state)
      [(LowerAlloc.Alloc allocated var-id)
        (LowerExpr.Expr
          (lower-state-emit
            allocated
            (ir.CompilerIrInstr.Call
              var-id
              (lower-string-concat-runtime-name count)
              (ir.compiler-ir-call-args-from-list
                (ir.compiler-ir-value-list-reverse-onto
                  values-rev
                  ir.CompilerIrValueList.Nil))
              (ast.AstType.String)))
          (ir.CompilerIrValue.Var var-id)
          (ast.AstType.String))])))

(define (lower-string-concat-exprs-batched-group
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [end : i64]
  [acc : ir.CompilerIrValueList]
  [count : i64]) : ResultLowerExpr
  (match (lower-string-concat-values-rev-at
    ctx
    state
    env
    type-env
    exprs
    index
    end
    acc
    count)
    [(ResultLowerStringValues.Ok values-state values-rev value-count)
      (match (lower-string-concat-emit values-state values-rev value-count)
        [(LowerExpr.Expr call-state call-value _)
          (lower-string-concat-exprs-batched
            ctx
            call-state
            env
            type-env
            exprs
            end
            (LowerMaybeIrValue.Some call-value))])]
    [(ResultLowerStringValues.Err message) (ResultLowerExpr.Err message)]))

(define (lower-string-concat-exprs-batched
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [carry : LowerMaybeIrValue]) : ResultLowerExpr
  (let
    [remaining : i64 (- (struct-get exprs len) index)]
    (if (<= remaining 0)
      (match carry
        [(LowerMaybeIrValue.Some value)
          (ResultLowerExpr.Ok (LowerExpr.Expr state value (ast.AstType.String)))]
        [(LowerMaybeIrValue.No)
          (ResultLowerExpr.Err
            (box (lower-diagnostic "lower: string-concat requires arguments")))])
      (match carry
        [(LowerMaybeIrValue.No)
          (let
            [take : i64
              (if (> remaining 5)
                5
                remaining)]
            (lower-string-concat-exprs-batched-group
              ctx
              state
              env
              type-env
              exprs
              index
              (+ index take)
              ir.CompilerIrValueList.Nil
              0))]
        [(LowerMaybeIrValue.Some value)
          (match (lower-string-fields state value)
            [(LowerStringFields.Fields carry-state ptr len)
              (let
                [take : i64
                  (if (> remaining 4)
                    4
                    remaining)]
                (lower-string-concat-exprs-batched-group
                  ctx
                  carry-state
                  env
                  type-env
                  exprs
                  index
                  (+ index take)
                  (ir.compiler-ir-value-cons-linked
                    len
                    (ir.compiler-ir-value-cons-linked
                      ptr
                      ir.CompilerIrValueList.Nil))
                  1))])]))))

(define (lower-string-concat-exprs
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultLowerExpr
  (begin
    (cfg
      compile-profile
      (begin
        (set!
          compiler-lower-profile-string-concat-trees
          (+ compiler-lower-profile-string-concat-trees 1))
        (set!
          compiler-lower-profile-string-concat-leaves
          (+
            compiler-lower-profile-string-concat-leaves
            (struct-get (& exprs) len)))))
    (lower-string-concat-exprs-batched
      ctx
      state
      env
      type-env
      (& exprs)
      0
      (LowerMaybeIrValue.No))))

(define (lower-supported-reference-referent-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-canonicalize-inferred-type ctx (tc_core.tc-resolve-type ctx ty)))
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Char) true]
    [(ast.AstType.Str) true]
    [(ast.AstType.Bytes) true]
    [(ast.AstType.Tuple elems)
      (lower-supported-reference-type-list-with-stack?
        ctx
        (box-get elems)
        (lower-id-set-empty))]
    [(ast.AstType.Array elem-ty _)
      (not
        (tc_core.tc-type-contains-reference?
          (tc_core.tc-context-type-get ctx elem-ty)))]
    [(ast.AstType.DynArray elem-ty)
      (not
        (tc_core.tc-type-contains-reference?
          (tc_core.tc-context-type-get ctx elem-ty)))]
    ;; A Slice is supported only when it is the immediate referent of a
    ;; borrowed reference; bare Slice remains unsized and has no by-value
    ;; borrow layout.  As with fixed/dynamic arrays, the element itself must
    ;; not contain references.
    [(ast.AstType.Slice elem-ty)
      (not
        (tc_core.tc-type-contains-reference?
          (tc_core.tc-context-type-get ctx elem-ty)))]
    [(ast.AstType.Struct name)
      (lower-supported-reference-struct-args-with-stack?
        ctx
        name
        (ast.ast-lifetime-list-new)
        (lower-id-set-empty))]
    [(ast.AstType.StructArgs name lifetimes)
      (lower-supported-reference-struct-args-with-stack?
        ctx
        name
        (box-get lifetimes)
        (lower-id-set-empty))]
    [(ast.AstType.Enum name)
      (lower-supported-reference-enum-args-with-stack?
        ctx
        name
        (ast.ast-lifetime-list-new)
        (lower-id-set-empty))]
    [(ast.AstType.EnumArgs name lifetimes)
      (lower-supported-reference-enum-args-with-stack?
        ctx
        name
        (box-get lifetimes)
        (lower-id-set-empty))]
    [_ false]))

(define (lower-borrow-place-value-reference?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (if (lower-type-register-resident? ctx resolved)
      false
      (match resolved
        [(ast.AstType.Tuple _) true]
        [(ast.AstType.Array _ _) true]
        [(ast.AstType.DynArray _) true]
        [(ast.AstType.Struct _) true]
        [(ast.AstType.StructArgs _ _) true]
        [(ast.AstType.Enum _) true]
        [(ast.AstType.EnumArgs _ _) true]
        [_ false]))))

;; A memory-class global's symbol stores a pointer to its aggregate payload, so
;; the address of the value is the loaded symbol. Owning/view handles such as a
;; dynamic array are themselves stored inline in the symbol and therefore use
;; the symbol's address even though ordinary borrowing treats their payload
;; pointer as the referent.
(define (lower-ptr-addr-of-global-value-reference?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (if (lower-type-register-resident? ctx resolved)
      false
      (match resolved
        [(ast.AstType.Tuple _) true]
        [(ast.AstType.Array _ _) true]
        [(ast.AstType.Struct _) true]
        [(ast.AstType.StructArgs _ _) true]
        [(ast.AstType.Enum _) true]
        [(ast.AstType.EnumArgs _ _) true]
        [_ false]))))

(define (lower-supported-reference-type-list-with-stack?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-type-list-with-stack-at? ctx (& types) stack 0))

(define (lower-supported-reference-type-list-with-stack-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (and
      (lower-supported-reference-type-with-stack?
        ctx
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        stack)
      (lower-supported-reference-type-list-with-stack-at?
        ctx
        types
        stack
        (+ index 1)))))

(define (lower-supported-reference-type-list-subst-with-stack?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [types : ast.AstTypeList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-type-list-subst-with-stack-at?
    ctx
    subst
    (& types)
    stack
    0))

(define (lower-supported-reference-type-list-subst-with-stack-at?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [types : (& types ast.AstTypeList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (and
      (lower-supported-reference-type-with-stack?
        ctx
        (tc_core.tc-lifetime-subst-type
          subst
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
        stack)
      (lower-supported-reference-type-list-subst-with-stack-at?
        ctx
        subst
        types
        stack
        (+ index 1)))))

(define (lower-supported-reference-field-list-with-stack?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [fields : ast.AstFieldDefList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-field-list-with-stack-at?
    ctx
    subst
    (& fields)
    stack
    0))

(define (lower-supported-reference-field-list-with-stack-at?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [fields : (& fields ast.AstFieldDefList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (struct-get fields len))
    true
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(ast.AstFieldDef.Def _ ty _)
        (and
          (lower-supported-reference-type-with-stack?
            ctx
            (tc_core.tc-lifetime-subst-type subst ty)
            stack)
          (lower-supported-reference-field-list-with-stack-at?
            ctx
            subst
            fields
            stack
            (+ index 1)))])))

(define (lower-supported-reference-variant-list-with-stack?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [variants : ast.AstVariantDefList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-variant-list-with-stack-at?
    ctx
    subst
    (& variants)
    stack
    0))

(define (lower-supported-reference-variant-list-with-stack-at?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [variants : (& variants ast.AstVariantDefList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (struct-get variants len))
    true
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def _ fields _)
        (and
          (lower-supported-reference-type-list-subst-with-stack?
            ctx
            subst
            fields
            stack)
          (lower-supported-reference-variant-list-with-stack-at?
            ctx
            subst
            variants
            stack
            (+ index 1)))])))

(define (lower-supported-reference-struct-args-with-stack?
  [ctx : tc_core.TcContext]
  [name : i64]
  [lifetimes : ast.AstLifetimeList]
  [stack : LowerIdSet]) : bool
  (if (lower-id-set-contains? stack name)
    true
    (match (tc_core.tc-lifetime-subst-from-nominal-args-id ctx name lifetimes)
      [(tc_core.ResultTcLifetimeSubst.Err _) false]
      [(tc_core.ResultTcLifetimeSubst.Ok subst)
        (match (tc_core.tc-struct-decl-id ctx name)
          [(tc_core.ResultTcStructDecl.Err _) false]
          [(tc_core.ResultTcStructDecl.Ok decl)
            (match decl
              [(tc_core.TcStructDecl _ _ fields)
                (lower-supported-reference-field-list-with-stack?
                  (tc_core.tc-context-with-nominal-owner-module-id ctx name)
                  subst
                  fields
                  (lower-id-set-insert stack name))])])])))

(define (lower-supported-reference-enum-args-with-stack?
  [ctx : tc_core.TcContext]
  [name : i64]
  [lifetimes : ast.AstLifetimeList]
  [stack : LowerIdSet]) : bool
  (if (lower-id-set-contains? stack name)
    true
    (match (tc_core.tc-lifetime-subst-from-nominal-args-id ctx name lifetimes)
      [(tc_core.ResultTcLifetimeSubst.Err _) false]
      [(tc_core.ResultTcLifetimeSubst.Ok subst)
        (match (tc_core.tc-context-enum-variants-id
          ctx
          name
          (tc_core.tc-nominal-name-id-display name))
          [(parser.ResultAstVariantDefList.Err _) false]
          [(parser.ResultAstVariantDefList.Ok variants)
            (lower-supported-reference-variant-list-with-stack?
              (tc_core.tc-context-with-nominal-owner-module-id ctx name)
              subst
              variants
              (lower-id-set-insert stack name))])])))

(define (lower-supported-reference-type-with-stack?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [stack : LowerIdSet]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region
        (tc_core.tc-canonicalize-inferred-type
          ctx
          (tc_core.tc-resolve-type ctx ty)))]
    (match resolved
      ;; Bare Slice is unsized and is never a directly lowerable value.  The
      ;; Slice arm below is reached only through Ref/MutRef's referent helper.
      [(ast.AstType.Slice _) false]
      [_
        (if (not (tc_core.tc-type-contains-reference? resolved))
          true
          (match resolved
            [(ast.AstType.Ref _ inner)
              (lower-supported-reference-referent-type?
                ctx
                (tc_core.tc-context-type-get ctx inner))]
            [(ast.AstType.MutRef _ inner)
              (lower-supported-reference-referent-type?
                ctx
                (tc_core.tc-context-type-get ctx inner))]
            [(ast.AstType.Tuple elems)
              (lower-supported-reference-type-list-with-stack?
                ctx
                (box-get elems)
                stack)]
            [(ast.AstType.Array elem _)
              (lower-supported-reference-type-with-stack?
                ctx
                (tc_core.tc-context-type-get ctx elem)
                stack)]
            [(ast.AstType.Box elem)
              (lower-supported-reference-type-with-stack?
                ctx
                (tc_core.tc-context-type-get ctx elem)
                stack)]
            [(ast.AstType.Func params ret)
              (and
                (lower-supported-reference-type-list-with-stack?
                  ctx
                  (box-get params)
                  stack)
                (lower-supported-reference-type-with-stack?
                  ctx
                  (tc_core.tc-context-type-get ctx ret)
                  stack))]
            [(ast.AstType.Struct name)
              (lower-supported-reference-struct-args-with-stack?
                ctx
                name
                (ast.ast-lifetime-list-new)
                stack)]
            [(ast.AstType.StructArgs name lifetimes)
              (lower-supported-reference-struct-args-with-stack?
                ctx
                name
                (box-get lifetimes)
                stack)]
            [(ast.AstType.Enum name)
              (lower-supported-reference-enum-args-with-stack?
                ctx
                name
                (ast.ast-lifetime-list-new)
                stack)]
            [(ast.AstType.EnumArgs name lifetimes)
              (lower-supported-reference-enum-args-with-stack?
                ctx
                name
                (box-get lifetimes)
                stack)]
            [(ast.AstType.Region _ inner)
              (lower-supported-reference-type-with-stack?
                ctx
                (tc_core.tc-context-type-get ctx inner)
                stack)]
            [_ false]))])))

(define (lower-supported-reference-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (lower-supported-reference-type-with-stack? ctx ty (lower-id-set-empty)))

(define (lower-borrowed-str-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-str-ref-type? ctx expr-ty)
    (match (lower-expr ctx state env type-env inner)
      [(ResultLowerExpr.Ok lowered)
        (match lowered
          [(LowerExpr.Expr inner-state value _)
            (ResultLowerExpr.Ok (LowerExpr.Expr inner-state value expr-ty))])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
    (ResultLowerExpr.Err
      (box (lower-diagnostic-at-expr origin (lower-reference-support-message))))))

(define (lower-borrow-copy-to-storage
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [referent-ty : ast.AstType]
  [result-ty : ast.AstType]) : LowerExpr
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions
        (tc_core.tc-resolve-type ctx referent-ty))]
    [size : i64 (lower-type-size ctx resolved)]
    (match (lower-reserve-heap-storage
      state
      (if (= size 0)
        1
        size)
      result-ty)
      [(LowerExpr.Expr base-state base _)
        (LowerExpr.Expr
          (if (> size 0)
            (lower-store-inline-value-at-offset
              ctx
              base-state
              base
              0
              value
              resolved
              size)
            base-state)
          base
          result-ty)])))

(define (lower-borrow-copy-to-inline-storage
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [referent-ty : ast.AstType]
  [result-ty : ast.AstType]) : LowerExpr
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions
        (tc_core.tc-resolve-type ctx referent-ty))]
    [size : i64 (lower-type-size ctx resolved)]
    (match (lower-reserve-inline-storage
      state
      (if (= size 0)
        1
        size)
      resolved)
      [(LowerExpr.Expr base-state base _)
        (LowerExpr.Expr
          (if (> size 0)
            (lower-store-inline-value-at-offset
              ctx
              base-state
              base
              0
              value
              resolved
              size)
            base-state)
          base
          result-ty)])))

(define (lower-borrow-place-slot-reference
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [slot : ir.CompilerIrValue]
  [stored-ty : ast.AstType]
  [result-ty : ast.AstType]
  [load-value-reference : bool]) : LowerExpr
  (if (and
    load-value-reference
    (lower-borrow-place-value-reference?
      ctx
      (tc_core.tc-borrow-referent-type stored-ty)))
    (match (lower-state-alloc-var state)
      [(LowerAlloc.Alloc allocated var-id)
        (LowerExpr.Expr
          (lower-state-emit
            allocated
            (ir.CompilerIrInstr.Load var-id slot stored-ty))
          (ir.CompilerIrValue.Var var-id)
          result-ty)])
    (LowerExpr.Expr state slot result-ty)))

(define (lower-borrow-reference-var-address
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr state (ir.CompilerIrValue.Var id) result-ty))
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (ir.CompilerIrValue.Global
            (lower-resolve-name-symbol-id state name-id))
          result-ty)))))

(define (lower-borrow-var-address-by-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [place-ty : ast.AstType]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [referent-ty : ast.AstType (tc_core.tc-borrow-referent-type place-ty)]
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? id)
      (if (lower-borrow-place-value-reference? ctx referent-ty)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr state (ir.CompilerIrValue.Var id) result-ty))
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx result-ty))
          [(ast.AstType.MutRef _ _)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: mutable borrow of by-value place requires writeback support")))]
          [_
            (ResultLowerExpr.Ok
              (lower-borrow-copy-to-storage
                ctx
                state
                (ir.CompilerIrValue.Var id)
                referent-ty
                result-ty))]))
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (if (lower-borrow-place-value-reference? ctx referent-ty)
            (ir.CompilerIrValue.Global
              (lower-resolve-name-symbol-id state name-id))
            (ir.CompilerIrValue.GlobalAddr
              (lower-resolve-name-symbol-id state name-id)))
          result-ty)))))

(define (lower-borrow-var-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-lookup-id type-env name)
    [(tc_core.ResultTcType.Ok place-ty)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx place-ty))
        [(ast.AstType.Ref _ _)
          (lower-borrow-reference-var-address state env name result-ty)]
        [(ast.AstType.MutRef _ _)
          (lower-borrow-reference-var-address state env name result-ty)]
        [_
          (if (and
            (tc_core.tc-type-contains-reference? place-ty)
            (not (lower-supported-reference-type? ctx place-ty)))
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-reference-support-message))))
            (lower-borrow-var-address-by-value
              ctx
              state
              env
              name
              place-ty
              origin
              result-ty))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-borrow-struct-field-address-from-memory
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field : String]
  [_origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-struct-field-info ctx struct-id struct-name field)
    [(ResultLowerFieldInfo.Ok info)
      (match info
        [(LowerFieldInfo.Info offset field-ty)
          (let
            [load-value-reference : bool
              (not
                (or
                  (and
                    (lower-struct-repr-c-id? ctx struct-id)
                    (lower-repr-c-inline-field? ctx field-ty))
                  (and
                    (lower-mode-inline-aggregates? (lower-state-mode state))
                    (lower-type-inline-storage? ctx field-ty)
                    (not (lower-type-register-resident? ctx field-ty)))))]
            (match (lower-gep-byte state base offset)
              [(LowerExpr.Expr ptr-state ptr _)
                (ResultLowerExpr.Ok
                  (lower-borrow-place-slot-reference
                    ctx
                    ptr-state
                    ptr
                    field-ty
                    result-ty
                    load-value-reference))]))])]
    [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)]))

(define (lower-borrow-struct-field-address-named
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [receiver-value : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field : String]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  ;; A register-resident receiver has no address; materialize the packed
  ;; word to a fresh slot, then take the field address through the same memory
  ;; helper used for borrowed struct references.
  (if (tc_core.tc-name-register-resident-id? ctx struct-id)
    (match (lower-borrow-copy-to-storage
      ctx
      state
      receiver-value
      (ast.AstType.Struct struct-id)
      result-ty)
      [(LowerExpr.Expr mat-state mat-ptr _)
        (lower-borrow-struct-field-address-from-memory
          ctx
          mat-state
          mat-ptr
          struct-id
          struct-name
          field
          origin
          result-ty)])
    (lower-borrow-struct-field-address-from-memory
      ctx
      state
      receiver-value
      struct-id
      struct-name
      field
      origin
      result-ty)))

(define (lower-borrow-struct-field-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [field : String]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env receiver)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr receiver-state receiver-value receiver-ty)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx receiver-ty))
            [(ast.AstType.Struct struct-name)
              (lower-borrow-struct-field-address-named
                ctx
                receiver-state
                receiver-value
                struct-name
                (tc_core.tc-nominal-name-id-display struct-name)
                field
                origin
                result-ty)]
            [(ast.AstType.StructArgs struct-name _)
              (lower-borrow-struct-field-address-named
                ctx
                receiver-state
                receiver-value
                struct-name
                (tc_core.tc-nominal-name-id-display struct-name)
                field
                origin
                result-ty)]
            [(ast.AstType.Ref _ referent-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type
                  ctx
                  (tc_core.tc-context-type-get ctx referent-ty)))
                [(ast.AstType.Struct struct-name)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    struct-name
                    (tc_core.tc-nominal-name-id-display struct-name)
                    field
                    origin
                    result-ty)]
                [(ast.AstType.StructArgs struct-name _)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    struct-name
                    (tc_core.tc-nominal-name-id-display struct-name)
                    field
                    origin
                    result-ty)]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: struct-get borrow requires struct place")))])]
            [(ast.AstType.MutRef _ referent-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type
                  ctx
                  (tc_core.tc-context-type-get ctx referent-ty)))
                [(ast.AstType.Struct struct-name)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    struct-name
                    (tc_core.tc-nominal-name-id-display struct-name)
                    field
                    origin
                    result-ty)]
                [(ast.AstType.StructArgs struct-name _)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    struct-name
                    (tc_core.tc-nominal-name-id-display struct-name)
                    field
                    origin
                    result-ty)]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: struct-get borrow requires struct place")))])]
            [_
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "lower: struct-get borrow requires struct place")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-borrow-tuple-field-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [tuple-expr : ast.AstExpr]
  [index : i64]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env tuple-expr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr tuple-state tuple-value tuple-ty)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx tuple-ty))
            [(ast.AstType.Tuple elem-tys)
              (match (lower-tuple-elem-info ctx (box-get elem-tys) index 0 0)
                [(ResultLowerFieldInfo.Ok info)
                  (match info
                    [(LowerFieldInfo.Info offset _)
                      (match (lower-gep-byte tuple-state tuple-value offset)
                        [(LowerExpr.Expr ptr-state ptr _)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr ptr-state ptr result-ty))])])]
                [(ResultLowerFieldInfo.Err message)
                  (ResultLowerExpr.Err message)])]
            [(ast.AstType.Ref _ referent-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type
                  ctx
                  (tc_core.tc-context-type-get ctx referent-ty)))
                [(ast.AstType.Tuple elem-tys)
                  (match (lower-tuple-elem-info
                    ctx
                    (box-get elem-tys)
                    index
                    0
                    0)
                    [(ResultLowerFieldInfo.Ok info)
                      (match info
                        [(LowerFieldInfo.Info offset _)
                          (match (lower-gep-byte tuple-state tuple-value offset)
                            [(LowerExpr.Expr ptr-state ptr _)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr ptr-state ptr result-ty))])])]
                    [(ResultLowerFieldInfo.Err message)
                      (ResultLowerExpr.Err message)])]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: tuple-ref borrow requires tuple place")))])]
            [(ast.AstType.MutRef _ referent-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type
                  ctx
                  (tc_core.tc-context-type-get ctx referent-ty)))
                [(ast.AstType.Tuple elem-tys)
                  (match (lower-tuple-elem-info
                    ctx
                    (box-get elem-tys)
                    index
                    0
                    0)
                    [(ResultLowerFieldInfo.Ok info)
                      (match info
                        [(LowerFieldInfo.Info offset _)
                          (match (lower-gep-byte tuple-state tuple-value offset)
                            [(LowerExpr.Expr ptr-state ptr _)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr ptr-state ptr result-ty))])])]
                    [(ResultLowerFieldInfo.Err message)
                      (ResultLowerExpr.Err message)])]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: tuple-ref borrow requires tuple place")))])]
            [_
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "lower: tuple-ref borrow requires tuple place")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-borrow-array-element-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [index : ast.AstExpr]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(tc_core.ResultTcType.Ok arr-ty)
      ;; A reference-valued iterator field is already an address of its array
      ;; storage. Its element borrow has been typechecked against the stored
      ;; referent, so lower the same dynamic/fixed-array address computation
      ;; instead of requiring the field projection itself to be an Array value.
      (let
        [container-ty : ast.AstType
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx arr-ty))
            [(ast.AstType.Ref _ referent-ty)
              (tc_core.tc-context-type-get ctx referent-ty)]
            [(ast.AstType.MutRef _ referent-ty)
              (tc_core.tc-context-type-get ctx referent-ty)]
            [_ arr-ty])]
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx container-ty))
          [(ast.AstType.Slice elem-ty)
            (match (lower-expr ctx state env type-env arr)
              [(ResultLowerExpr.Ok arr-lowered)
                (match arr-lowered
                  [(LowerExpr.Expr arr-state arr-value _)
                    (match (lower-index-result-type-or-check
                      ctx
                      env
                      type-env
                      (lower-state-type-cache arr-state)
                      index)
                      [(tc_core.ResultTcType.Ok idx-ty)
                        (match (lower-expr-expected
                          ctx
                          arr-state
                          env
                          type-env
                          index
                          idx-ty
                          index)
                          [(ResultLowerExpr.Ok idx-lowered)
                            (match idx-lowered
                              [(LowerExpr.Expr idx-state idx-value idx-value-ty)
                                (match (lower-slice-element-addr
                                  ctx
                                  idx-state
                                  arr-value
                                  arr-ty
                                  idx-value
                                  idx-value-ty
                                  (tc_core.tc-type-without-regions
                                    (tc_core.tc-context-type-get ctx elem-ty)))
                                  [(LowerExpr.Expr addr-state elem-ptr _)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr
                                        (lower-state-record-latest-bounds-check-at-expr
                                          addr-state
                                          origin)
                                        elem-ptr
                                        result-ty))])])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])]
                      [(tc_core.ResultTcType.Err message)
                        (ResultLowerExpr.Err
                          (box (lower-diagnostic-at-expr index message)))])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [(ast.AstType.DynArray elem-ty)
            (match (lower-expr ctx state env type-env arr)
              [(ResultLowerExpr.Ok arr-lowered)
                (match arr-lowered
                  [(LowerExpr.Expr arr-state arr-value _)
                    (match (lower-index-result-type-or-check
                      ctx
                      env
                      type-env
                      (lower-state-type-cache arr-state)
                      index)
                      [(tc_core.ResultTcType.Ok idx-ty)
                        (match (lower-expr-expected
                          ctx
                          arr-state
                          env
                          type-env
                          index
                          idx-ty
                          index)
                          [(ResultLowerExpr.Ok idx-lowered)
                            (match idx-lowered
                              [(LowerExpr.Expr idx-state idx-value idx-value-ty)
                                (match (lower-array-element-addr
                                  ctx
                                  idx-state
                                  arr-value
                                  idx-value
                                  idx-value-ty
                                  (tc_core.tc-type-without-regions
                                    (tc_core.tc-context-type-get ctx elem-ty)))
                                  [(LowerExpr.Expr addr-state elem-ptr _)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr
                                        (lower-state-record-latest-bounds-check-at-expr
                                          addr-state
                                          origin)
                                        elem-ptr
                                        result-ty))])])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])]
                      [(tc_core.ResultTcType.Err message)
                        (ResultLowerExpr.Err
                          (box (lower-diagnostic-at-expr index message)))])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [(ast.AstType.Array elem-ty elem-count)
            (let
              [fixed-elem-ty : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-context-type-get ctx elem-ty))]
              (match (lower-expr ctx state env type-env arr)
                [(ResultLowerExpr.Ok arr-lowered)
                  (match arr-lowered
                    [(LowerExpr.Expr arr-state arr-value _)
                      (match (lower-index-result-type-or-check
                        ctx
                        env
                        type-env
                        (lower-state-type-cache arr-state)
                        index)
                        [(tc_core.ResultTcType.Ok idx-ty)
                          (match (lower-expr-expected
                            ctx
                            arr-state
                            env
                            type-env
                            index
                            idx-ty
                            index)
                            [(ResultLowerExpr.Ok idx-lowered)
                              (match idx-lowered
                                [(LowerExpr.Expr
                                    idx-state
                                    idx-value
                                    idx-value-ty)
                                  (match (lower-fixed-array-element-addr
                                    ctx
                                    idx-state
                                    arr-value
                                    idx-value
                                    idx-value-ty
                                    fixed-elem-ty
                                    elem-count)
                                    [(LowerExpr.Expr addr-state elem-ptr _)
                                      (ResultLowerExpr.Ok
                                        (LowerExpr.Expr
                                          (lower-state-record-latest-bounds-check-at-expr
                                            addr-state
                                            origin)
                                          elem-ptr
                                          result-ty))])])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)])]
                        [(tc_core.ResultTcType.Err message)
                          (ResultLowerExpr.Err
                            (box (lower-diagnostic-at-expr index message)))])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
          [_
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  (string.append
                    "lower: array-ref borrow requires array place, got "
                    (tc_core.tc-type-render
                      (tc_core.tc-type-strip-region
                        (tc_core.tc-resolve-type ctx container-ty)))))))]))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

(define (lower-borrow-place-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (ast.ast-expr-unspan place)
    [(ast.AstExpr.Var name)
      (if (tc_core.tc-dotted-local-field-name-id? type-env name)
        (match (tc_core.tc-dotted-local-field-expr-id type-env name)
          [(tc_core.ResultTcExprId.Ok virtual-id)
            (lower-borrow-place-address
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin
              result-ty)]
          [(tc_core.ResultTcExprId.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))])
        (lower-borrow-var-address ctx state env type-env name origin result-ty))]
    [(ast.AstExpr.StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-borrow-struct-field-address
          ctx
          state
          env
          type-env
          receiver
          (tc_core.tc-env-key-name-text field)
          origin
          result-ty))]
    [(ast.AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : ast.AstExpr (lower-context-expr-get ctx tuple-expr-box)]
        (lower-borrow-tuple-field-address
          ctx
          state
          env
          type-env
          tuple-expr
          index
          origin
          result-ty))]
    [(ast.AstExpr.ArrayRef arr-box index-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-borrow-array-element-address
          ctx
          state
          env
          type-env
          arr
          index
          origin
          result-ty))]
    [(ast.AstExpr.BoxGet box-box)
      (let
        [box-expr : ast.AstExpr (lower-context-expr-get ctx box-box)]
        (lower-box-storage-address
          ctx
          state
          env
          type-env
          box-expr
          origin
          result-ty))]
    [(ast.AstExpr.BoxTake receiver-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-box-storage-address
          ctx
          state
          env
          type-env
          receiver
          origin
          result-ty))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: borrow requires a local, parameter, or aggregate place")))]))

(define (lower-borrow-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-str-ref-type? ctx expr-ty)
    (lower-borrowed-str-expr ctx state env type-env inner origin expr-ty)
    (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx expr-ty))
      [(ast.AstType.Ref _ referent-ty)
        (if (lower-supported-reference-referent-type?
          ctx
          (tc_core.tc-context-type-get ctx referent-ty))
          (lower-borrow-place-address
            ctx
            state
            env
            type-env
            inner
            origin
            expr-ty)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-reference-support-message)))))]
      [(ast.AstType.MutRef _ referent-ty)
        (if (lower-supported-reference-referent-type?
          ctx
          (tc_core.tc-context-type-get ctx referent-ty))
          (lower-borrow-place-address
            ctx
            state
            env
            type-env
            inner
            origin
            expr-ty)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-reference-support-message)))))]
      [_
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic-at-expr origin (lower-reference-support-message))))])))

(define (lower-store-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [types : ast.AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-store-values-at ctx state base values (& types) 0 cursor))

(define (lower-store-values-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [types : (& types ast.AstTypeList)]
  [type-index : i64]
  [cursor : i64]) : ResultLowerState
  (match values
    [(ir.CompilerIrValueList.Nil)
      (if (>= type-index (ast.ast-type-list-len types))
        (ResultLowerState.Ok state)
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(ir.CompilerIrValueList.Array seq)
      (lower-store-values-at
        ctx
        state
        base
        (ir.compiler-ir-value-seq-to-list seq)
        types
        type-index
        cursor)]
    [(ir.CompilerIrValueList.Cons value rest-values)
      (if (>= type-index (ast.ast-type-list-len types))
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (let
          [ty : ast.AstType
            (tc_core.tc-context-type-get
              ctx
              (ast.ast-type-list-get
                types
                type-index
                (ast.ast-type-id-fallback)))]
          [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
          [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
          (lower-store-values-at
            ctx
            (lower-store-at-offset state base offset value resolved)
            base
            (box-get rest-values)
            types
            (+ type-index 1)
            (+ offset (lower-type-size ctx resolved)))))]))

(define (lower-store-repr-c-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [fields : tc_core.TcReprCFieldLayoutList]) : ResultLowerState
  (lower-store-repr-c-values-at ctx state base values fields 0))

(define (lower-store-repr-c-values-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [fields : tc_core.TcReprCFieldLayoutList]
  [field-index : i64]) : ResultLowerState
  (match values
    [(ir.CompilerIrValueList.Nil)
      (if (= field-index (tc_core.tc-repr-c-field-layout-list-count fields))
        (ResultLowerState.Ok state)
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(ir.CompilerIrValueList.Array seq)
      (lower-store-repr-c-values-at
        ctx
        state
        base
        (ir.compiler-ir-value-seq-to-list seq)
        fields
        field-index)]
    [(ir.CompilerIrValueList.Cons value rest-values)
      (if (>= field-index (tc_core.tc-repr-c-field-layout-list-count fields))
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (match (tc_core.tc-repr-c-field-layout-list-ref fields field-index)
          [(tc_core.TcReprCFieldLayout.Field _ field-ty offset)
            (let
              [stored-state : LowerState
                (if (lower-repr-c-inline-field? ctx field-ty)
                  (lower-copy-bytes
                    state
                    base
                    offset
                    value
                    0
                    (lower-repr-c-field-size ctx field-ty))
                  (lower-store-at-offset state base offset value field-ty))]
              (lower-store-repr-c-values-at
                ctx
                stored-state
                base
                (box-get rest-values)
                fields
                (+ field-index 1)))]))]))

(define (lower-store-inline-struct-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstFieldDefList]
  [layout : tc_core.TcInlineAggregateLayout]) : ResultLowerState
  (lower-store-inline-struct-values-at
    ctx
    state
    base
    values
    (& fields)
    0
    layout))

(define (lower-store-inline-struct-values-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [fields : (& fields ast.AstFieldDefList)]
  [field-index : i64]
  [layout : tc_core.TcInlineAggregateLayout]) : ResultLowerState
  (match values
    [(ir.CompilerIrValueList.Nil)
      (if (>= field-index (struct-get fields len))
        (ResultLowerState.Ok state)
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(ir.CompilerIrValueList.Array seq)
      (lower-store-inline-struct-values-at
        ctx
        state
        base
        (ir.compiler-ir-value-seq-to-list seq)
        fields
        field-index
        layout)]
    [(ir.CompilerIrValueList.Cons value rest-values)
      (if (>= field-index (struct-get fields len))
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (match (ast.ast-field-def-list-get
          fields
          field-index
          (ast.ast-field-def-fallback))
          [(ast.AstFieldDef.Def name ty _)
            (let
              [name-str : String (tc_core.tc-env-key-name-text name)]
              [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
              [offset : i64
                (tc_core.tc-inline-aggregate-layout-field-offset-id layout name)]
              (if (< offset 0)
                (ResultLowerState.Err
                  (box
                    (lower-diagnostic
                      (string.append
                        "lower: inline struct layout missing field "
                        name-str))))
                (match (tc_core.tc-inline-aggregate-type-layout ctx resolved)
                  [(tc_core.ResultTcLayoutInfo.Ok info)
                    (let
                      [stored-state : LowerState
                        (if (<= (tc_core.tc-layout-info-size info) 0)
                          state
                          (lower-store-inline-value-at-offset
                            ctx
                            state
                            base
                            offset
                            value
                            resolved
                            (tc_core.tc-layout-info-size info)))]
                      (lower-store-inline-struct-values-at
                        ctx
                        stored-state
                        base
                        (box-get rest-values)
                        fields
                        (+ field-index 1)
                        layout))]
                  [(tc_core.ResultTcLayoutInfo.Err message)
                    (ResultLowerState.Err (box (lower-diagnostic message)))])))]))]))

(define (lower-store-inline-payload-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [types : ast.AstTypeList]
  [layout : tc_core.TcInlineAggregateLayout]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]) : ResultLowerState
  (lower-store-inline-payload-values-at
    ctx
    state
    base
    values
    (& types)
    layout
    variant-name
    variant-name-id
    index))

(define (lower-store-inline-payload-values-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [types : (& types ast.AstTypeList)]
  [layout : tc_core.TcInlineAggregateLayout]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]) : ResultLowerState
  (match values
    [(ir.CompilerIrValueList.Nil)
      (if (>= index (ast.ast-type-list-len types))
        (ResultLowerState.Ok state)
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(ir.CompilerIrValueList.Array seq)
      (lower-store-inline-payload-values-at
        ctx
        state
        base
        (ir.compiler-ir-value-seq-to-list seq)
        types
        layout
        variant-name
        variant-name-id
        index)]
    [(ir.CompilerIrValueList.Cons value rest-values)
      (if (>= index (ast.ast-type-list-len types))
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (let
          [ty : ast.AstType
            (tc_core.tc-context-type-get
              ctx
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
          [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
          [offset : i64
            (tc_core.tc-inline-aggregate-layout-variant-payload-offset-id
              layout
              variant-name-id
              index)]
          (if (< offset 0)
            (ResultLowerState.Err
              (box
                (lower-diagnostic
                  (string.append
                    "lower: inline enum layout missing payload for "
                    variant-name))))
            (match (tc_core.tc-inline-aggregate-type-layout ctx resolved)
              [(tc_core.ResultTcLayoutInfo.Ok info)
                (lower-store-inline-payload-values-at
                  ctx
                  (if (<= (tc_core.tc-layout-info-size info) 0)
                    state
                    (lower-store-inline-value-at-offset
                      ctx
                      state
                      base
                      offset
                      value
                      resolved
                      (tc_core.tc-layout-info-size info)))
                  base
                  (box-get rest-values)
                  types
                  layout
                  variant-name
                  variant-name-id
                  (+ index 1))]
              [(tc_core.ResultTcLayoutInfo.Err message)
                (ResultLowerState.Err (box (lower-diagnostic message)))]))))]))

(define (lower-literal-payload-supported? [lit : ast.AstLiteral]) : bool
  (match lit
    [(ast.AstLiteral.Int _ _) true]
    [(ast.AstLiteral.Bool _) true]
    [(ast.AstLiteral.Char _) true]
    [(ast.AstLiteral.String _) true]
    [_ false]))

(define (lower-enum-type-name-or-empty [ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Enum enum-name)
      (tc_core.tc-nominal-name-id-display enum-name)]
    [(ast.AstType.EnumArgs enum-name _)
      (tc_core.tc-nominal-name-id-display enum-name)]
    [(ast.AstType.Var enum-name) (tc_core.tc-nominal-name-id-display enum-name)]
    [(ast.AstType.VarArgs enum-name _)
      (tc_core.tc-nominal-name-id-display enum-name)]
    [_ ""]))

(define (lower-enum-type-name-id-or [ty : ast.AstType] [fallback : i64]) : i64
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Enum enum-name) enum-name]
    [(ast.AstType.EnumArgs enum-name _) enum-name]
    [(ast.AstType.Var enum-name) enum-name]
    [(ast.AstType.VarArgs enum-name _) enum-name]
    [_ fallback]))

(define (lower-struct-type-name-or-empty [ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Struct struct-name)
      (tc_core.tc-nominal-name-id-display struct-name)]
    [(ast.AstType.StructArgs struct-name _)
      (tc_core.tc-nominal-name-id-display struct-name)]
    [(ast.AstType.Var struct-name)
      (tc_core.tc-nominal-name-id-display struct-name)]
    [(ast.AstType.VarArgs struct-name _)
      (tc_core.tc-nominal-name-id-display struct-name)]
    [_ ""]))

(define (lower-struct-type-name-id-or [ty : ast.AstType] [fallback : i64]) : i64
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Struct struct-name) struct-name]
    [(ast.AstType.StructArgs struct-name _) struct-name]
    [(ast.AstType.Var struct-name) struct-name]
    [(ast.AstType.VarArgs struct-name _) struct-name]
    [_ fallback]))

(define (lower-struct-type-handle-or
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [fallback : i64]) : i64
  (let
    [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols ctx)]
    [name-id : i64 (lower-struct-type-name-id-or ty -1)]
    [direct : i64
      (if (>= name-id 0)
        (csym.compiler-symbols-lookup-type-id-or symbols name-id fallback)
        fallback)]
    (if (csym.compiler-symbols-handle-found? direct)
      direct
      (if (and
        (>= name-id 0)
        (< name-id (ci.intern-capacity))
        (not (ci.intern-qualified? name-id)))
        (csym.compiler-symbols-lookup-type-id-or
          symbols
          (csym.compiler-symbol-module-key-id-by-id
            (tc_core.tc-context-module-id ctx)
            name-id)
          fallback)
        fallback))))

(define (lower-struct-constructor-handle-id-or
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [ty : ast.AstType]
  [fallback : i64]) : i64
  (let
    [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols ctx)]
    [result-handle : i64 (lower-struct-type-handle-or ctx ty fallback)]
    [lookup-handle : i64
      (if (>= lookup-name-id 0)
        (csym.compiler-symbols-lookup-type-id-or
          symbols
          lookup-name-id
          fallback)
        fallback)]
    [direct-handle : i64
      (if (>= raw-name-id 0)
        (csym.compiler-symbols-lookup-type-id-or symbols raw-name-id fallback)
        fallback)]
    [names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (if (>= raw-name-id 0)
        (lower-name-cache-resolve-logical-id (& names) raw-name-id raw-name-id)
        raw-name-id)]
    [logical-handle : i64
      (if (>= logical-id 0)
        (csym.compiler-symbols-lookup-type-id-or symbols logical-id fallback)
        fallback)]
    (cond
      [(csym.compiler-symbols-handle-found? result-handle) result-handle]
      [(csym.compiler-symbols-handle-found? lookup-handle) lookup-handle]
      [(csym.compiler-symbols-handle-found? direct-handle) direct-handle]
      [(csym.compiler-symbols-handle-found? logical-handle) logical-handle]
      [else fallback])))

(define (lower-variant-handle-for-scrut-id-or
  [ctx : tc_core.TcContext]
  [scrut-ty : ast.AstType]
  [variant-name-id : i64]
  [fallback : i64]) : i64
  (match (tc_core.tc-type-strip-region scrut-ty)
    [(ast.AstType.Enum enum-name-id)
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [(ast.AstType.EnumArgs enum-name-id _)
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [(ast.AstType.Var enum-name-id)
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [(ast.AstType.VarArgs enum-name-id _)
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [_
      (csym.compiler-registries-lookup-variant-id-or
        (tc_core.tc-context-registries ctx)
        variant-name-id
        fallback)]))

(define (lower-variant-owner-id-for-enum
  [ctx : tc_core.TcContext]
  [enum-name-id : i64]
  [variant-name-id : i64]) : i64
  (let
    [handle : i64
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (tc_core.tc-variant-owner-id-or ctx handle enum-name-id)
      enum-name-id)))

(define (lower-variant-handle-name-id-or
  [ctx : tc_core.TcContext]
  [handle : i64]
  [fallback : i64]) : i64
  (match (csym.compiler-registries-variant-name-id-indexed
    (tc_core.tc-context-symbols ctx)
    handle)
    [(option_i64.Some name-id) name-id]
    [(option_i64.None) fallback]))

(define (lower-type-debug-kind [ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Enum _) "enum"]
    [(ast.AstType.EnumArgs _ _) "enum-args"]
    [(ast.AstType.Struct _) "struct"]
    [(ast.AstType.StructArgs _ _) "struct-args"]
    [(ast.AstType.Var _) "var"]
    [(ast.AstType.VarArgs _ _) "var-args"]
    [(ast.AstType.Ref _ _) "ref"]
    [(ast.AstType.MutRef _ _) "mut-ref"]
    [_ "other"]))

(define (lower-unsupported-match-pattern-message
  [ctx : tc_core.TcContext]
  [scrut-ty : ast.AstType]
  [variant-name : String]) : String
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))]
    (str_cat.str-cat
      "lower: unsupported match pattern "
      variant-name
      " in module "
      (tc_core.tc-context-module ctx)
      " raw "
      (lower-type-debug-kind scrut-ty)
      " "
      (tc_core.tc-type-render scrut-ty)
      " resolved "
      (lower-type-debug-kind resolved)
      " "
      (tc_core.tc-type-render resolved))))

(define (lower-member-name-base [name : String]) : String
  (let
    [source : String
      (if (tc_core.tc-name-qualified? name)
        (tc_core.tc-qualified-name-base name)
        name)]
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length source)]
    (begin
      (while (< i n)
        (begin
          (if (string.char-eq (string.string-ref source i) '.')
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      (if (and (>= last-dot 0) (< last-dot (- n 1)))
        (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
        source))))

(define (lower-variant-payload-offset
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [_ : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [resolved : ast.AstType]) : i64
  (if (and
    (lower-mode-inline-aggregates? mode)
    (> (string.string-length enum-name) 0))
    (match (tc_core.tc-inline-aggregate-layout-for-id ctx enum-id)
      [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
        (tc_core.tc-inline-aggregate-layout-variant-payload-offset-id
          layout
          variant-name-id
          index)]
      [(tc_core.ResultTcInlineAggregateLayout.Err _) (- 0 1)])
    (lower-align-up cursor (lower-type-align ctx resolved))))

(define (lower-string-payload-literal-eq
  [state : LowerState]
  [field-value : ir.CompilerIrValue]
  [lit-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state field-value)
    [(LowerStringFields.Fields field-state field-ptr field-len)
      (match (lower-string-fields field-state lit-value)
        [(LowerStringFields.Fields done-state lit-ptr lit-len)
          (ResultLowerExpr.Ok
            (lower-inline-string-eq-fields
              done-state
              field-ptr
              field-len
              lit-ptr
              lit-len
              (ast.AstType.Bool)))])]))

(define (lower-literal-payload-eq
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [field-value : ir.CompilerIrValue]
  [lit : ast.AstLiteral]
  [resolved : ast.AstType]) : ResultLowerExpr
  (match lit
    [(ast.AstLiteral.String _)
      (if (lower-string-handle-type? ctx resolved)
        (lower-string-payload-literal-eq
          state
          field-value
          (lower-literal-value-with-type lit resolved))
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic
              "lower: unsupported enum payload literal pattern type"))))]
    [_
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc eq-alloc eq-var)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-state-emit
                eq-alloc
                (ir.CompilerIrInstr.BinOp
                  eq-var
                  ir.CompilerIrBinOp.Eq
                  field-value
                  (lower-literal-value-with-type lit resolved)
                  resolved))
              (ir.CompilerIrValue.Var eq-var)
              (ast.AstType.Bool)))])]))

(define (lower-box-pattern-name? [name : i64]) : bool
  (string.eq (tc_core.tc-env-key-name-text name) "box"))

(define (lower-bind-irrefutable-box-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [pattern : ast.AstPattern]
  [inner-ty : ast.AstType]) : ResultLowerEnv
  (match pattern
    [(ast.AstPattern.Wildcard) (ResultLowerEnv.Ok state env type-env)]
    [(ast.AstPattern.Binding name)
      (match value
        [(ir.CompilerIrValue.Var value-var)
          (ResultLowerEnv.Ok
            state
            (sym_i64_env.sym-i64-bind-id env name value-var)
            (tc_core.tc-bind-id type-env name inner-ty))]
        [_
          (ResultLowerEnv.Err
            (box (lower-diagnostic "lower: internal box pattern load failed")))])]
    [(ast.AstPattern.Tuple patterns-box)
      (lower-bind-tuple-pattern
        ctx
        state
        env
        type-env
        value
        inner-ty
        (box-get patterns-box))]
    [(ast.AstPattern.Array patterns-box)
      (lower-bind-array-pattern
        ctx
        state
        env
        type-env
        value
        inner-ty
        (box-get patterns-box))]
    [(ast.AstPattern.Variant name args-box)
      (if (lower-box-pattern-name? name)
        (lower-bind-box-pattern
          ctx
          state
          env
          type-env
          value
          inner-ty
          (box-get args-box))
        (if (lower-struct-pattern-for-type? ctx inner-ty name)
          (lower-bind-struct-pattern
            ctx
            state
            env
            type-env
            value
            inner-ty
            (lower-struct-type-name-or-empty
              (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx inner-ty)))
            (box-get args-box))
          (ResultLowerEnv.Err
            (box (lower-diagnostic "lower: unsupported refutable box pattern")))))]
    [_
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: unsupported refutable box pattern")))]))

(define (lower-bind-box-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [box-value : ir.CompilerIrValue]
  [box-ty : ast.AstType]
  [args : ast.AstPatternList]) : ResultLowerEnv
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx box-ty))
    [(ast.AstType.Box inner-node)
      (if (= (struct-get (& args) len) 1)
        (let
          [inner : ast.AstPattern
            (ast.ast-pattern-list-get (& args) 0 (ast.ast-pattern-fallback))]
          [inner-ty : ast.AstType
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx inner-node))]
          (match (lower-load-inline-value-at-offset
            ctx
            state
            box-value
            0
            inner-ty
            (lower-state-mode state))
            [(LowerExpr.Expr load-state inner-value _)
              (lower-bind-irrefutable-box-value
                ctx
                load-state
                env
                type-env
                inner-value
                inner
                inner-ty)]))
        (ResultLowerEnv.Err
          (box
            (lower-diagnostic
              "lower: box pattern expects exactly one inner pattern"))))]
    [_
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: box pattern requires Box type")))]))

(define (lower-bind-box-variant-payload
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [nested-args : ast.AstPatternList]
  [resolved : ast.AstType]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [rest-patterns : ast.AstPatternList]
  [rest-types : ast.AstTypeList]
  [offset : i64]
  [next-index : i64]
  [next-cursor : i64]
  [fail-label : i64]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx resolved))
    [(ast.AstType.Box _)
      (match (if scrut-reg-group?
        (lower-read-register-group-payload
          ctx
          state
          base
          (ast.AstType.Enum enum-id)
          offset
          resolved)
        (lower-load-inline-value-at-offset ctx state base offset resolved mode))
        [(LowerExpr.Expr field-state field-value _)
          (match (lower-bind-box-pattern
            ctx
            field-state
            env
            type-env
            field-value
            resolved
            nested-args)
            [(ResultLowerEnv.Ok box-state box-env box-type-env)
              (lower-bind-variant-payloads
                ctx
                box-state
                box-env
                box-type-env
                base
                rest-patterns
                rest-types
                mode
                enum-id
                enum-name
                variant-name
                variant-name-id
                next-index
                next-cursor
                fail-label
                scrut-reg-group?)]
            [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)])])]
    [_
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: box pattern requires Box payload")))]))

(define (lower-bind-struct-variant-payload
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [nested-args : ast.AstPatternList]
  [resolved : ast.AstType]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [rest-patterns : ast.AstPatternList]
  [rest-types : ast.AstTypeList]
  [offset : i64]
  [next-index : i64]
  [next-cursor : i64]
  [fail-label : i64]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match (if scrut-reg-group?
    (lower-read-register-group-payload
      ctx
      state
      base
      (ast.AstType.Enum enum-id)
      offset
      resolved)
    (lower-load-inline-value-at-offset ctx state base offset resolved mode))
    [(LowerExpr.Expr field-state field-value _)
      (match (lower-bind-struct-pattern
        ctx
        field-state
        env
        type-env
        field-value
        resolved
        (lower-struct-type-name-or-empty
          (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx resolved)))
        nested-args)
        [(ResultLowerEnv.Ok struct-state struct-env struct-type-env)
          (lower-bind-variant-payloads
            ctx
            struct-state
            struct-env
            struct-type-env
            base
            rest-patterns
            rest-types
            mode
            enum-id
            enum-name
            variant-name
            variant-name-id
            next-index
            next-cursor
            fail-label
            scrut-reg-group?)]
        [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)])]))

;; Bind a matched variant's payload fields. Irrefutable subpatterns (wildcard,
;; binding) just load/bind; a refutable literal subpattern loads the
;; field, compares it to the literal, and on mismatch branches to `fail-label`
;; (the enclosing arm's next-arm test) so matching continues. Nested variant
;; subpatterns recurse on the field's tag. `fail-label` is unused when every subpattern
;; is irrefutable.
(define (lower-bind-variant-payloads
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [patterns : ast.AstPatternList]
  [types : ast.AstTypeList]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [fail-label : i64]
  ;; Whether the scrutinee enum is a 2-word register-group value, computed
  ;; ONCE by the caller and threaded here. Recomputing it per payload field (a full
  ;; transient layout rebuild) at every binding site across the whole compiler was
  ;; heavy enough to overflow the per-function scratch arena into a second chunk
  ;; and trip its rewind, corrupting later lowering.
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (if (ast.ast-pattern-list-empty? (& patterns))
    (if (ast.ast-type-list-empty? (& types))
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: enum payload pattern arity mismatch"))))
    (let
      [pattern : ast.AstPattern
        (ast.ast-pattern-list-get (& patterns) 0 (ast.ast-pattern-fallback))]
      [rest-patterns : ast.AstPatternList (ast.ast-pattern-list-tail patterns)]
      (if (ast.ast-type-list-empty? (& types))
        (ResultLowerEnv.Err
          (box (lower-diagnostic "lower: enum payload pattern arity mismatch")))
        (let
          [ty : i64
            (ast.ast-type-list-get (& types) 0 (ast.ast-type-id-fallback))]
          [rest-types : ast.AstTypeList (ast.ast-type-list-slice types 1)]
          (let
            [ty : ast.AstType (tc_core.tc-context-type-get ctx ty)]
            [field-ctx : tc_core.TcContext
              (tc_core.tc-context-with-owner-name-module
                ctx
                (lower-variant-owner-id-for-enum ctx enum-id variant-name-id))]
            [resolved : ast.AstType (tc_core.tc-resolve-type field-ctx ty)]
            [default-offset : i64
              (lower-align-up cursor (lower-type-align ctx resolved))]
            [offset : i64
              (lower-variant-payload-offset
                ctx
                mode
                enum-id
                enum-name
                variant-name
                variant-name-id
                index
                cursor
                resolved)]
            [next-cursor : i64
              (+ default-offset (lower-type-size ctx resolved))]
            [next-index : i64 (+ index 1)]
            (if (< offset 0)
              (ResultLowerEnv.Err
                (box
                  (lower-diagnostic
                    (string.append
                      "lower: inline enum layout missing payload for "
                      variant-name))))
              (match pattern
                [(ast.AstPattern.Wildcard)
                  (lower-bind-variant-payloads
                    ctx
                    state
                    env
                    type-env
                    base
                    rest-patterns
                    rest-types
                    mode
                    enum-id
                    enum-name
                    variant-name
                    variant-name-id
                    next-index
                    next-cursor
                    fail-label
                    scrut-reg-group?)]
                [(ast.AstPattern.Binding name)
                  (match (if scrut-reg-group?
                    (lower-read-register-group-payload
                      ctx
                      state
                      base
                      (ast.AstType.Enum enum-id)
                      offset
                      resolved)
                    (lower-load-inline-value-at-offset
                      ctx
                      state
                      base
                      offset
                      resolved
                      mode))
                    [(LowerExpr.Expr load-state value _)
                      (match value
                        [(ir.CompilerIrValue.Var field-var)
                          (lower-bind-variant-payloads
                            ctx
                            load-state
                            (sym_i64_env.sym-i64-bind-id env name field-var)
                            (tc_core.tc-bind-id type-env name resolved)
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label
                            scrut-reg-group?)]
                        [_
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                "lower: internal enum payload load failed")))])])]
                [(ast.AstPattern.Var name _)
                  (match (if scrut-reg-group?
                    (lower-read-register-group-payload
                      ctx
                      state
                      base
                      (ast.AstType.Enum enum-id)
                      offset
                      resolved)
                    (lower-load-inline-value-at-offset
                      ctx
                      state
                      base
                      offset
                      resolved
                      mode))
                    [(LowerExpr.Expr load-state value _)
                      (match value
                        [(ir.CompilerIrValue.Var field-var)
                          (lower-bind-variant-payloads
                            ctx
                            load-state
                            (sym_i64_env.sym-i64-bind-id env name field-var)
                            (tc_core.tc-bind-id type-env name resolved)
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label
                            scrut-reg-group?)]
                        [_
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                "lower: internal enum payload load failed")))])])]
                [(ast.AstPattern.Tuple patterns-box)
                  (match (if scrut-reg-group?
                    (lower-read-register-group-payload
                      ctx
                      state
                      base
                      (ast.AstType.Enum enum-id)
                      offset
                      resolved)
                    (lower-load-inline-value-at-offset
                      ctx
                      state
                      base
                      offset
                      resolved
                      mode))
                    [(LowerExpr.Expr field-state field-value _)
                      (match (lower-bind-tuple-pattern
                        ctx
                        field-state
                        env
                        type-env
                        field-value
                        resolved
                        (box-get patterns-box))
                        [(ResultLowerEnv.Ok
                            tuple-state
                            tuple-env
                            tuple-type-env)
                          (lower-bind-variant-payloads
                            ctx
                            tuple-state
                            tuple-env
                            tuple-type-env
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label
                            scrut-reg-group?)]
                        [(ResultLowerEnv.Err message)
                          (ResultLowerEnv.Err message)])])]
                [(ast.AstPattern.Array patterns-box)
                  (match (if scrut-reg-group?
                    (lower-read-register-group-payload
                      ctx
                      state
                      base
                      (ast.AstType.Enum enum-id)
                      offset
                      resolved)
                    (lower-load-inline-value-at-offset
                      ctx
                      state
                      base
                      offset
                      resolved
                      mode))
                    [(LowerExpr.Expr field-state field-value _)
                      (match (lower-bind-array-pattern
                        ctx
                        field-state
                        env
                        type-env
                        field-value
                        resolved
                        (box-get patterns-box))
                        [(ResultLowerEnv.Ok
                            array-state
                            array-env
                            array-type-env)
                          (lower-bind-variant-payloads
                            ctx
                            array-state
                            array-env
                            array-type-env
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label
                            scrut-reg-group?)]
                        [(ResultLowerEnv.Err message)
                          (ResultLowerEnv.Err message)])])]
                [(ast.AstPattern.Literal lit)
                  (if (lower-literal-payload-supported? lit)
                    (match (if scrut-reg-group?
                      (lower-read-register-group-payload
                        ctx
                        state
                        base
                        (ast.AstType.Enum enum-id)
                        offset
                        resolved)
                      (lower-load-at-offset state base offset resolved))
                      [(LowerExpr.Expr load-state field-value _)
                        (match (lower-literal-payload-eq
                          ctx
                          load-state
                          field-value
                          lit
                          resolved)
                          [(ResultLowerExpr.Ok lowered-eq)
                            (match lowered-eq
                              [(LowerExpr.Expr eq-state eq-value _)
                                (match (lower-state-fresh-label
                                  eq-state
                                  "payload_ok")
                                  [(LowerLabel.Label ok-state ok-label)
                                    (lower-bind-variant-payloads
                                      ctx
                                      (lower-state-finish-block
                                        (lower-state-emit
                                          ok-state
                                          (ir.CompilerIrInstr.Branch
                                            eq-value
                                            ok-label
                                            fail-label))
                                        ok-label)
                                      env
                                      type-env
                                      base
                                      rest-patterns
                                      rest-types
                                      mode
                                      enum-id
                                      enum-name
                                      variant-name
                                      variant-name-id
                                      next-index
                                      next-cursor
                                      fail-label
                                      scrut-reg-group?)])])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerEnv.Err message)])])
                    (ResultLowerEnv.Err
                      (box
                        (lower-diagnostic
                          "lower: unsupported enum payload literal pattern type"))))]
                [(ast.AstPattern.Variant nested-name nested-args-box)
                  ;; Refutable nested variant payloads test the loaded
                  ;; enum tag and branch to `fail-label` on mismatch. An
                  ;; explicit `(box ...)` payload pattern is irrefutable here;
                  ;; it loads the boxed value and binds the inner pattern.
                  (let
                    [nested-name-str : String
                      (tc_core.tc-env-key-name-text nested-name)]
                    [nested-args : ast.AstPatternList (box-get nested-args-box)]
                    (if (lower-box-pattern-name? nested-name)
                      (lower-bind-box-variant-payload
                        ctx
                        state
                        env
                        type-env
                        base
                        nested-args
                        resolved
                        mode
                        enum-id
                        enum-name
                        variant-name
                        variant-name-id
                        rest-patterns
                        rest-types
                        offset
                        next-index
                        next-cursor
                        fail-label
                        scrut-reg-group?)
                      (if (lower-struct-pattern-for-type?
                        ctx
                        resolved
                        nested-name)
                        (lower-bind-struct-variant-payload
                          ctx
                          state
                          env
                          type-env
                          base
                          nested-args
                          resolved
                          mode
                          enum-id
                          enum-name
                          variant-name
                          variant-name-id
                          rest-patterns
                          rest-types
                          offset
                          next-index
                          next-cursor
                          fail-label
                          scrut-reg-group?)
                        (match ctx
                          [(tc_core.TcContext _ symbols registries _ _ _ _ _ _)
                            (let
                              [handle : i64
                                (lower-variant-handle-for-scrut-id-or
                                  ctx
                                  resolved
                                  nested-name
                                  (csym.compiler-symbols-missing-handle))]
                              (if (not
                                (csym.compiler-symbols-handle-found? handle))
                                (ResultLowerEnv.Err
                                  (box
                                    (lower-diagnostic
                                      (string.append
                                        "lower: unknown nested variant "
                                        nested-name-str))))
                                (match (csym.compiler-registries-variant-fields-indexed
                                  symbols
                                  handle)
                                  [(parser.ResultAstTypeList.Err message)
                                    (ResultLowerEnv.Err
                                      (box (lower-diagnostic message)))]
                                  [(parser.ResultAstTypeList.Ok nested-fields)
                                    (match (lower-load-inline-value-at-offset
                                      ctx
                                      state
                                      base
                                      offset
                                      resolved
                                      mode)
                                      [(LowerExpr.Expr
                                          field-state
                                          field-value
                                          _)
                                        ;; For a register-resident enum field
                                        ;; the loaded value IS the tag word; for a
                                        ;; memory enum it is a pointer to the field,
                                        ;; so the tag is loaded from offset 0.
                                        ;; Dereferencing a register-resident tag word
                                        ;; would fault (it is a small integer, not an
                                        ;; address).
                                        (match (if (lower-type-register-resident?
                                          ctx
                                          resolved)
                                          (LowerExpr.Expr
                                            field-state
                                            field-value
                                            (ast.AstType.I64))
                                          (lower-load-at-offset
                                            field-state
                                            field-value
                                            0
                                            (ast.AstType.I64)))
                                          [(LowerExpr.Expr
                                              tag-state
                                              tag-value
                                              _)
                                            (match (lower-state-alloc-var
                                              tag-state)
                                              [(LowerAlloc.Alloc
                                                  eq-alloc
                                                  eq-var)
                                                (match (lower-state-fresh-label
                                                  (lower-state-emit
                                                    eq-alloc
                                                    (ir.CompilerIrInstr.BinOp
                                                      eq-var
                                                      ir.CompilerIrBinOp.Eq
                                                      tag-value
                                                      (ir.CompilerIrValue.I64
                                                        (csym.compiler-registry-handle-child-index
                                                          handle))
                                                      (ast.AstType.I64)))
                                                  "payload_ok")
                                                  [(LowerLabel.Label
                                                      ok-state
                                                      ok-label)
                                                    (match (lower-bind-variant-payloads
                                                      ctx
                                                      (lower-state-finish-block
                                                        (lower-state-emit
                                                          ok-state
                                                          (ir.CompilerIrInstr.Branch
                                                            (ir.CompilerIrValue.Var
                                                              eq-var)
                                                            ok-label
                                                            fail-label))
                                                        ok-label)
                                                      env
                                                      type-env
                                                      field-value
                                                      nested-args
                                                      nested-fields
                                                      mode
                                                      (lower-enum-type-name-id-or
                                                        resolved
                                                        -1)
                                                      (lower-enum-type-name-or-empty
                                                        resolved)
                                                      nested-name-str
                                                      (lower-variant-handle-name-id-or
                                                        ctx
                                                        handle
                                                        nested-name)
                                                      0
                                                      8
                                                      fail-label
                                                      ;; nested enum: rare path, so
                                                      ;; computing its group-ness once
                                                      ;; here is cheap.
                                                      (lower-type-register-group?
                                                        ctx
                                                        resolved))
                                                      [(ResultLowerEnv.Ok
                                                          nested-state
                                                          nested-env
                                                          nested-type-env)
                                                        (lower-bind-variant-payloads
                                                          ctx
                                                          nested-state
                                                          nested-env
                                                          nested-type-env
                                                          base
                                                          rest-patterns
                                                          rest-types
                                                          mode
                                                          enum-id
                                                          enum-name
                                                          variant-name
                                                          variant-name-id
                                                          next-index
                                                          next-cursor
                                                          fail-label
                                                          scrut-reg-group?)]
                                                      [(ResultLowerEnv.Err
                                                          message)
                                                        (ResultLowerEnv.Err
                                                          message)])])])])])])))]))))]
                [_
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: unsupported enum payload pattern")))]))))))))

(define (lower-borrowed-payload-ref-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [field-ty : ast.AstType]
  [ref-ty : ast.AstType]) : LowerExpr
  (let
    [referent-ty : ast.AstType (tc_core.tc-borrow-referent-type field-ty)]
    (if (or
      (lower-str-ref-type? ctx ref-ty)
      (lower-borrow-place-value-reference? ctx referent-ty))
      (let
        [loaded : LowerExpr (lower-load-at-offset state base offset field-ty)]
        (match loaded
          [(LowerExpr.Expr loaded-state value _)
            (LowerExpr.Expr loaded-state value ref-ty)]))
      (match (lower-gep-byte state base offset)
        [(LowerExpr.Expr ptr-state ptr _) (LowerExpr.Expr ptr-state ptr ref-ty)]))))

(define (lower-bind-borrowed-variant-payloads
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : i64]
  [base : ir.CompilerIrValue]
  [patterns : ast.AstPatternList]
  [types : ast.AstTypeList]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [fail-label : i64]) : ResultLowerEnv
  (if (ast.ast-pattern-list-empty? (& patterns))
    (if (ast.ast-type-list-empty? (& types))
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: enum payload pattern arity mismatch"))))
    (let
      [pattern : ast.AstPattern
        (ast.ast-pattern-list-get (& patterns) 0 (ast.ast-pattern-fallback))]
      [rest-patterns : ast.AstPatternList (ast.ast-pattern-list-tail patterns)]
      (if (ast.ast-type-list-empty? (& types))
        (ResultLowerEnv.Err
          (box (lower-diagnostic "lower: enum payload pattern arity mismatch")))
        (let
          [ty-id : i64
            (ast.ast-type-list-get (& types) 0 (ast.ast-type-id-fallback))]
          [rest-types : ast.AstTypeList (ast.ast-type-list-slice types 1)]
          [ty : ast.AstType (tc_core.tc-context-type-get ctx ty-id)]
          [field-ctx : tc_core.TcContext
            (tc_core.tc-context-with-owner-name-module
              ctx
              (lower-variant-owner-id-for-enum ctx enum-id variant-name-id))]
          [resolved : ast.AstType (tc_core.tc-resolve-type field-ctx ty)]
          [default-offset : i64
            (lower-align-up cursor (lower-type-align ctx resolved))]
          [offset : i64
            (lower-variant-payload-offset
              ctx
              mode
              enum-id
              enum-name
              variant-name
              variant-name-id
              index
              cursor
              resolved)]
          [next-cursor : i64 (+ default-offset (lower-type-size ctx resolved))]
          [next-index : i64 (+ index 1)]
          (if (< offset 0)
            (ResultLowerEnv.Err
              (box
                (lower-diagnostic
                  (string.append
                    "lower: inline enum layout missing payload for "
                    variant-name))))
            (match pattern
              [(ast.AstPattern.Wildcard)
                (lower-bind-borrowed-variant-payloads
                  ctx
                  state
                  env
                  type-env
                  borrow-lifetime
                  base
                  rest-patterns
                  rest-types
                  mode
                  enum-id
                  enum-name
                  variant-name
                  variant-name-id
                  next-index
                  next-cursor
                  fail-label)]
              [(ast.AstPattern.Binding name)
                (let
                  [ref-ty : ast.AstType
                    (tc_core.tc-borrowed-field-ref-type
                      borrow-lifetime
                      resolved)]
                  [ref-expr : LowerExpr
                    (lower-borrowed-payload-ref-expr
                      ctx
                      state
                      base
                      offset
                      resolved
                      ref-ty)]
                  (match ref-expr
                    [(LowerExpr.Expr ref-state ref-value _)
                      (match ref-value
                        [(ir.CompilerIrValue.Var field-var)
                          (lower-bind-borrowed-variant-payloads
                            ctx
                            ref-state
                            (sym_i64_env.sym-i64-bind-id env name field-var)
                            (tc_core.tc-bind-id type-env name ref-ty)
                            borrow-lifetime
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label)]
                        [_
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                "lower: internal borrowed enum payload reference failed")))])]))]
              [(ast.AstPattern.Var name _)
                (let
                  [ref-ty : ast.AstType
                    (tc_core.tc-borrowed-field-ref-type
                      borrow-lifetime
                      resolved)]
                  [ref-expr : LowerExpr
                    (lower-borrowed-payload-ref-expr
                      ctx
                      state
                      base
                      offset
                      resolved
                      ref-ty)]
                  (match ref-expr
                    [(LowerExpr.Expr ref-state ref-value _)
                      (match ref-value
                        [(ir.CompilerIrValue.Var field-var)
                          (lower-bind-borrowed-variant-payloads
                            ctx
                            ref-state
                            (sym_i64_env.sym-i64-bind-id env name field-var)
                            (tc_core.tc-bind-id type-env name ref-ty)
                            borrow-lifetime
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label)]
                        [_
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                "lower: internal borrowed enum payload reference failed")))])]))]
              [(ast.AstPattern.Tuple patterns-box)
                (match (lower-gep-byte state base offset)
                  [(LowerExpr.Expr address-state address _)
                    (match (lower-bind-borrowed-tuple-pattern
                      ctx
                      address-state
                      env
                      type-env
                      borrow-lifetime
                      address
                      resolved
                      (box-get patterns-box))
                      [(ResultLowerEnv.Ok tuple-state tuple-env tuple-type-env)
                        (lower-bind-borrowed-variant-payloads
                          ctx
                          tuple-state
                          tuple-env
                          tuple-type-env
                          borrow-lifetime
                          base
                          rest-patterns
                          rest-types
                          mode
                          enum-id
                          enum-name
                          variant-name
                          variant-name-id
                          next-index
                          next-cursor
                          fail-label)]
                      [(ResultLowerEnv.Err message)
                        (ResultLowerEnv.Err message)])])]
              [(ast.AstPattern.Array patterns-box)
                (match (lower-gep-byte state base offset)
                  [(LowerExpr.Expr address-state address _)
                    (match (lower-bind-borrowed-array-pattern
                      ctx
                      address-state
                      env
                      type-env
                      borrow-lifetime
                      address
                      resolved
                      (box-get patterns-box))
                      [(ResultLowerEnv.Ok array-state array-env array-type-env)
                        (lower-bind-borrowed-variant-payloads
                          ctx
                          array-state
                          array-env
                          array-type-env
                          borrow-lifetime
                          base
                          rest-patterns
                          rest-types
                          mode
                          enum-id
                          enum-name
                          variant-name
                          variant-name-id
                          next-index
                          next-cursor
                          fail-label)]
                      [(ResultLowerEnv.Err message)
                        (ResultLowerEnv.Err message)])])]
              [(ast.AstPattern.Literal lit)
                (if (lower-literal-payload-supported? lit)
                  (match (lower-load-at-offset state base offset resolved)
                    [(LowerExpr.Expr load-state field-value _)
                      (match (lower-literal-payload-eq
                        ctx
                        load-state
                        field-value
                        lit
                        resolved)
                        [(ResultLowerExpr.Ok lowered-eq)
                          (match lowered-eq
                            [(LowerExpr.Expr eq-state eq-value _)
                              (match (lower-state-fresh-label
                                eq-state
                                "payload_ok")
                                [(LowerLabel.Label ok-state ok-label)
                                  (lower-bind-borrowed-variant-payloads
                                    ctx
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        ok-state
                                        (ir.CompilerIrInstr.Branch
                                          eq-value
                                          ok-label
                                          fail-label))
                                      ok-label)
                                    env
                                    type-env
                                    borrow-lifetime
                                    base
                                    rest-patterns
                                    rest-types
                                    mode
                                    enum-id
                                    enum-name
                                    variant-name
                                    variant-name-id
                                    next-index
                                    next-cursor
                                    fail-label)])])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerEnv.Err message)])])
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: unsupported enum payload literal pattern type"))))]
              [(ast.AstPattern.Variant nested-name nested-args-box)
                (let
                  [nested-args : ast.AstPatternList (box-get nested-args-box)]
                  [nested-name-str : String
                    (tc_core.tc-env-key-name-text nested-name)]
                  (match ctx
                    [(tc_core.TcContext _ symbols registries _ _ _ _ _ _)
                      (let
                        [handle : i64
                          (lower-variant-handle-for-scrut-id-or
                            ctx
                            resolved
                            nested-name
                            (csym.compiler-symbols-missing-handle))]
                        (if (not (csym.compiler-symbols-handle-found? handle))
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                (string.append
                                  "lower: unknown nested variant "
                                  nested-name-str))))
                          (match (csym.compiler-registries-variant-fields-indexed
                            symbols
                            handle)
                            [(parser.ResultAstTypeList.Err message)
                              (ResultLowerEnv.Err
                                (box (lower-diagnostic message)))]
                            [(parser.ResultAstTypeList.Ok nested-fields)
                              (match (lower-load-at-offset
                                state
                                base
                                offset
                                resolved)
                                [(LowerExpr.Expr field-state field-value _)
                                  (match (lower-load-at-offset
                                    field-state
                                    field-value
                                    0
                                    (ast.AstType.I64))
                                    [(LowerExpr.Expr tag-state tag-value _)
                                      (match (lower-state-alloc-var tag-state)
                                        [(LowerAlloc.Alloc eq-alloc eq-var)
                                          (match (lower-state-fresh-label
                                            (lower-state-emit
                                              eq-alloc
                                              (ir.CompilerIrInstr.BinOp
                                                eq-var
                                                ir.CompilerIrBinOp.Eq
                                                tag-value
                                                (ir.CompilerIrValue.I64
                                                  (csym.compiler-registry-handle-child-index
                                                    handle))
                                                (ast.AstType.I64)))
                                            "payload_ok")
                                            [(LowerLabel.Label
                                                ok-state
                                                ok-label)
                                              (match (lower-bind-borrowed-variant-payloads
                                                ctx
                                                (lower-state-finish-block
                                                  (lower-state-emit
                                                    ok-state
                                                    (ir.CompilerIrInstr.Branch
                                                      (ir.CompilerIrValue.Var
                                                        eq-var)
                                                      ok-label
                                                      fail-label))
                                                  ok-label)
                                                env
                                                type-env
                                                borrow-lifetime
                                                field-value
                                                nested-args
                                                nested-fields
                                                mode
                                                (lower-enum-type-name-id-or
                                                  resolved
                                                  -1)
                                                (lower-enum-type-name-or-empty
                                                  resolved)
                                                nested-name-str
                                                (lower-variant-handle-name-id-or
                                                  ctx
                                                  handle
                                                  nested-name)
                                                0
                                                8
                                                fail-label)
                                                [(ResultLowerEnv.Ok
                                                    nested-state
                                                    nested-env
                                                    nested-type-env)
                                                  (lower-bind-borrowed-variant-payloads
                                                    ctx
                                                    nested-state
                                                    nested-env
                                                    nested-type-env
                                                    borrow-lifetime
                                                    base
                                                    rest-patterns
                                                    rest-types
                                                    mode
                                                    enum-id
                                                    enum-name
                                                    variant-name
                                                    variant-name-id
                                                    next-index
                                                    next-cursor
                                                    fail-label)]
                                                [(ResultLowerEnv.Err message)
                                                  (ResultLowerEnv.Err message)])])])])])])))]))]
              [_
                (ResultLowerEnv.Err
                  (box
                    (lower-diagnostic "lower: unsupported enum payload pattern")))])))))))

(define (lower-bind-match-variant-payloads
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [base : ir.CompilerIrValue]
  [patterns : ast.AstPatternList]
  [types : ast.AstTypeList]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [fail-label : i64]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match borrow-lifetime
    [(tc_core.TcMaybeNameId.No)
      (lower-bind-variant-payloads
        ctx
        state
        env
        type-env
        base
        patterns
        types
        mode
        enum-id
        enum-name
        variant-name
        variant-name-id
        index
        cursor
        fail-label
        scrut-reg-group?)]
    [(tc_core.TcMaybeNameId.Some lifetime)
      ;; A borrowed scrutinee is always memory-backed (matched behind a pointer),
      ;; never a 2-word register-group value, so the register-group path does not
      ;; apply here.
      (lower-bind-borrowed-variant-payloads
        ctx
        state
        env
        type-env
        lifetime
        base
        patterns
        types
        mode
        enum-id
        enum-name
        variant-name
        variant-name-id
        index
        cursor
        fail-label)]))

;; A payload subpattern is refutable when it can fail to match at run time.
;; Literals and nested enum variants are refutable; `(box ...)` follows its
;; inner pattern, while binding, var, wildcard, and tuple patterns always match.
(define (lower-pattern-refutable? [pattern : ast.AstPattern]) : bool
  (match pattern
    [(ast.AstPattern.Literal _) true]
    [(ast.AstPattern.Variant name args-box)
      (if (lower-box-pattern-name? name)
        (lower-pattern-list-refutable? (box-get args-box))
        true)]
    [_ false]))

(define (lower-pattern-list-refutable? [patterns : ast.AstPatternList]) : bool
  (lower-pattern-list-refutable-at? (& patterns) 0))

(define (lower-pattern-list-refutable-at?
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]) : bool
  (if (>= index (struct-get patterns len))
    false
    (if (lower-pattern-refutable?
      (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback)))
      true
      (lower-pattern-list-refutable-at? patterns (+ index 1)))))

(define (lower-pattern-refutable-for-type?
  [ctx : tc_core.TcContext]
  [pattern : ast.AstPattern]
  [ty : ast.AstType]) : bool
  (match pattern
    [(ast.AstPattern.Wildcard) false]
    [(ast.AstPattern.Var _ _) false]
    [(ast.AstPattern.Binding _) false]
    [(ast.AstPattern.Tuple _) false]
    [(ast.AstPattern.Array _) false]
    [(ast.AstPattern.Literal _) true]
    [(ast.AstPattern.Variant name args-box)
      (let
        [args : ast.AstPatternList (box-get args-box)]
        (if (lower-box-pattern-name? name)
          (lower-pattern-list-refutable? args)
          (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
            [(ast.AstType.Struct struct-name)
              (not
                (tc_core.tc-struct-pattern-irrefutable?
                  ctx
                  (tc_core.tc-nominal-name-id-display struct-name)
                  struct-name
                  ty
                  (tc_core.tc-env-key-name-text name)
                  name
                  args))]
            [(ast.AstType.StructArgs struct-name _)
              (not
                (tc_core.tc-struct-pattern-irrefutable?
                  ctx
                  (tc_core.tc-nominal-name-id-display struct-name)
                  struct-name
                  ty
                  (tc_core.tc-env-key-name-text name)
                  name
                  args))]
            [_ true])))]))

(define (lower-pattern-list-refutable-for-types?
  [ctx : tc_core.TcContext]
  [patterns : ast.AstPatternList]
  [types : ast.AstTypeList]) : bool
  (lower-pattern-list-refutable-for-types-at? ctx (& patterns) 0 types))

(define (lower-pattern-list-refutable-for-types-at?
  [ctx : tc_core.TcContext]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]
  [types : ast.AstTypeList]) : bool
  (if (>= index (ast.ast-pattern-list-len patterns))
    (not (ast.ast-type-list-empty? (& types)))
    (if (ast.ast-type-list-empty? (& types))
      true
      (let
        [ty-id : i64
          (ast.ast-type-list-get (& types) 0 (ast.ast-type-id-fallback))]
        [rest-types : ast.AstTypeList (ast.ast-type-list-slice types 1)]
        [ty : ast.AstType (tc_core.tc-context-type-get ctx ty-id)]
        (if (lower-pattern-refutable-for-type?
          ctx
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
          ty)
          true
          (lower-pattern-list-refutable-for-types-at?
            ctx
            patterns
            (+ index 1)
            rest-types))))))

(define (lower-field-info-from-list
  [ctx : tc_core.TcContext]
  [fields : ast.AstFieldDefList]
  [field-name : String]
  [cursor : i64]) : ResultLowerFieldInfo
  (lower-field-info-from-list-at ctx (& fields) field-name cursor 0))

(define (lower-field-info-from-list-at
  [ctx : tc_core.TcContext]
  [fields : (& fields ast.AstFieldDefList)]
  [field-name : String]
  [cursor : i64]
  [index : i64]) : ResultLowerFieldInfo
  (if (>= index (struct-get fields len))
    (ResultLowerFieldInfo.Err
      (box
        (lower-diagnostic
          (string.append "lower: unknown struct field " field-name))))
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(ast.AstFieldDef.Def name ty _)
        (let
          [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
          [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
          (if (string.eq (tc_core.tc-env-key-name-text name) field-name)
            (ResultLowerFieldInfo.Ok (LowerFieldInfo.Info offset resolved))
            (lower-field-info-from-list-at
              ctx
              fields
              field-name
              (+ offset (lower-type-size ctx resolved))
              (+ index 1))))])))

(define (lower-field-info-from-repr-c-list
  [fields : tc_core.TcReprCFieldLayoutList]
  [field-name : String]) : ResultLowerFieldInfo
  (lower-field-info-from-repr-c-list-at fields field-name 0))

(define (lower-field-info-from-repr-c-list-at
  [fields : tc_core.TcReprCFieldLayoutList]
  [field-name : String]
  [index : i64]) : ResultLowerFieldInfo
  (if (>= index (tc_core.tc-repr-c-field-layout-list-count fields))
    (ResultLowerFieldInfo.Err
      (box
        (lower-diagnostic
          (string.append "lower: unknown struct field " field-name))))
    (match (tc_core.tc-repr-c-field-layout-list-ref fields index)
      [(tc_core.TcReprCFieldLayout.Field name ty offset)
        (if (string.eq name field-name)
          (ResultLowerFieldInfo.Ok (LowerFieldInfo.Info offset ty))
          (lower-field-info-from-repr-c-list-at fields field-name (+ index 1)))])))

(define (lower-struct-field-info
  [ctx : tc_core.TcContext]
  [struct-id : i64]
  [struct-name : String]
  [field-name : String]) : ResultLowerFieldInfo
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id ctx struct-id)]
    (if (lower-struct-repr-c-id? field-ctx struct-id)
      (match (tc_core.tc-repr-c-struct-layout-id
        field-ctx
        struct-name
        struct-id)
        [(tc_core.ResultTcReprCLayout.Ok layout)
          (lower-field-info-from-repr-c-list
            (tc_core.tc-repr-c-layout-fields layout)
            field-name)]
        [(tc_core.ResultTcReprCLayout.Err message)
          (ResultLowerFieldInfo.Err (box (lower-diagnostic message)))])
      (match (lower-struct-fields-id field-ctx struct-id struct-name)
        [(parser.ResultAstFieldDefList.Ok fields)
          (lower-field-info-from-list field-ctx fields field-name 0)]
        [(parser.ResultAstFieldDefList.Err message)
          (ResultLowerFieldInfo.Err (box (lower-diagnostic message)))]))))

(define (lower-struct-field-info-for-mode
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [struct-id : i64]
  [struct-name : String]
  [field-name-id : i64]
  [field-name : String]) : ResultLowerFieldInfo
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id ctx struct-id)]
    (if (lower-mode-inline-aggregates? mode)
      (match (lower-struct-field-info
        field-ctx
        struct-id
        struct-name
        field-name)
        [(ResultLowerFieldInfo.Ok info)
          (match info
            [(LowerFieldInfo.Info _ field-ty)
              (match (tc_core.tc-inline-aggregate-layout-for-id
                field-ctx
                struct-id)
                [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
                  (let
                    [offset : i64
                      (tc_core.tc-inline-aggregate-layout-field-offset-id
                        layout
                        field-name-id)]
                    (if (< offset 0)
                      (ResultLowerFieldInfo.Err
                        (box
                          (lower-diagnostic
                            (string.append
                              "lower: inline struct layout missing field "
                              field-name))))
                      (ResultLowerFieldInfo.Ok
                        (LowerFieldInfo.Info offset field-ty))))]
                [(tc_core.ResultTcInlineAggregateLayout.Err message)
                  (ResultLowerFieldInfo.Err (box (lower-diagnostic message)))])])]
        [(ResultLowerFieldInfo.Err message) (ResultLowerFieldInfo.Err message)])
      (lower-struct-field-info field-ctx struct-id struct-name field-name))))

(define (lower-var-id
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : ast.AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? id)
      (ResultLowerExpr.Ok (LowerExpr.Expr state (ir.CompilerIrValue.Var id) ty))
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (ir.CompilerIrValue.Global
            (lower-resolve-name-symbol-id state name-id))
          ty)))))

(define (lower-register-address-taken-local-read
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [local-id : i64]
  [ty : ast.AstType]) : ResultLowerExpr
  (if (and
    (lower-type-register-resident? ctx ty)
    (lower-state-register-address-taken-var? state local-id))
    (match (lower-state-alloc-var state)
      [(LowerAlloc.Alloc addr-state addr-var)
        (match (lower-load-register-resident-from-ptr
          ctx
          (lower-state-emit
            addr-state
            (ir.CompilerIrInstr.AddrOf addr-var local-id))
          (ir.CompilerIrValue.Var addr-var)
          ty)
          [(LowerExpr.Expr load-state loaded _)
            (ResultLowerExpr.Ok (LowerExpr.Expr load-state loaded ty))])])
    (ResultLowerExpr.Ok
      (LowerExpr.Expr state (ir.CompilerIrValue.Var local-id) ty))))

(define (lower-var-id-storage-aware
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : ast.AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? id)
      (lower-register-address-taken-local-read ctx state id ty)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (ir.CompilerIrValue.Global
            (lower-resolve-name-symbol-id state name-id))
          ty)))))

(define (lower-disarm-move-aware-resource-name
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]) : LowerState
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (not (csym.compiler-symbols-handle-found? local-id))
      state
      (let
        [live-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            (lower-cleanup-live-name-id local-id)
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? live-id)
          (lower-state-emit
            state
            (ir.CompilerIrInstr.Mov
              live-id
              (ir.CompilerIrValue.Bool false)
              (ast.AstType.Bool)))
          state)))))

(define (lower-disarm-move-aware-resource-expr
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [expr : ast.AstExpr]) : LowerState
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var name)
      (lower-disarm-move-aware-resource-name state env name)]
    [_ state]))

(define (lower-function-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Func _ _) true]
    [_ false]))

(define (lower-atomic-public-symbol? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_store")
    (string.eq symbol "tl_atomic_i64_add")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (lower-atomic-public-name? [name : String]) : bool
  (or
    (string.eq name "atomic-i64-load")
    (string.eq name "atomic-i64-store!")
    (string.eq name "atomic-i64-add!")
    (string.eq name "atomic-i64-fetch-add!")
    (string.eq name "atomic-i32-load")
    (string.eq name "atomic-i32-store!")
    (string.eq name "atomic-i32-add!")
    (string.eq name "atomic-i32-fetch-add!")))

(define (lower-atomic-name-candidate? [name : String]) : bool
  (or
    (lower-atomic-public-name? name)
    (lower-atomic-public-symbol? name)
    (and
      (tc_core.tc-name-qualified? name)
      (lower-atomic-public-name? (tc_core.tc-qualified-name-base name)))))

(define (lower-atomic-symbol-for-name [name : String]) : String
  (cond
    [(string.eq name "atomic-i64-load") "tl_atomic_i64_load"]
    [(string.eq name "atomic-i64-store!") "tl_atomic_i64_store"]
    [(string.eq name "atomic-i64-add!") "tl_atomic_i64_add"]
    [(string.eq name "atomic-i64-fetch-add!") "tl_atomic_i64_fetch_add"]
    [(string.eq name "atomic-i32-load") "tl_atomic_i32_load"]
    [(string.eq name "atomic-i32-store!") "tl_atomic_i32_store"]
    [(string.eq name "atomic-i32-add!") "tl_atomic_i32_add"]
    [(string.eq name "atomic-i32-fetch-add!") "tl_atomic_i32_fetch_add"]
    [else ""]))

(define (lower-atomic-import-path? [path : String]) : bool
  (or (string.eq path "stdlib/atomic.tl") (string.eq path "atomic.tl")))

(define (lower-program-imports-atomic? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (match decl
          [(ast.AstDecl.Import decl-meta (ast.AstImportSpec.Spec _ path _ _ _))
            (or
              (lower-atomic-import-path? path)
              (lower-program-imports-atomic? rest))]
          [_ (lower-program-imports-atomic? rest)]))]))

(define (lower-context-imports-atomic? [ctx : tc_core.TcContext]) : bool
  (match ctx
    [(tc_core.TcContext program _ _ _ _ _ _ _ _)
      (match program
        [(ast.AstProgram.Program decls-box)
          (lower-program-imports-atomic? (box-get decls-box))])]))

(define (lower-atomic-imported-symbol-for-name
  [ctx : tc_core.TcContext]
  [name : String]) : String
  (if (and (lower-atomic-public-name? name) (lower-context-imports-atomic? ctx))
    (lower-atomic-symbol-for-name name)
    ""))

(define (lower-atomic-extern-symbol-from-handle
  [symbols : csym.CompilerSymbols]
  [handle : i64]) : String
  (if (=
    (csym.compiler-symbol-handle-kind handle)
    (csym.compiler-symbol-kind-extern))
    (match (csym.compiler-symbols-decl-at-index
      symbols
      (csym.compiler-symbol-handle-index handle))
      [(parser.ResultAstDecl.Ok decl)
        (match decl
          [(ast.AstDecl.Extern decl-meta _ kind metadata _)
            (match kind
              [(ast.AstExternKind.Function)
                (let
                  [symbol : String
                    (ast.ast-extern-metadata-symbol (box-get metadata))]
                  (if (lower-atomic-public-symbol? symbol)
                    symbol
                    ""))]
              [(ast.AstExternKind.Value) ""])]
          [_ ""])]
      [(parser.ResultAstDecl.Err _) ""])
    ""))

(define (lower-atomic-extern-symbol-lookup-id
  [symbols : csym.CompilerSymbols]
  [lookup-id : i64]) : String
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (lower-atomic-extern-symbol-from-handle symbols handle)
      "")))

(define (lower-atomic-extern-symbol-for-name-id
  [ctx : tc_core.TcContext]
  [name : String]
  [name-id : i64]) : String
  (if (not (lower-atomic-name-candidate? name))
    ""
    (let
      [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols ctx)]
      [direct : String (lower-atomic-extern-symbol-lookup-id symbols name-id)]
      [source-name : String (tc_core.tc-hygiene-global-symbol-name name)]
      (if (> (string.string-length direct) 0)
        direct
        (lower-atomic-imported-symbol-for-name ctx source-name)))))

(define (lower-atomic-extern-symbol-for-func
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]) : String
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var raw-name)
      (let
        [source-id : i64
          (tc_core.macro-hygiene-global-source-name-id-or raw-name raw-name)]
        [raw-text : String (ci.intern-str source-id)]
        (match (if (or
          (tc_core.macro-hygiene-global-id? raw-name)
          (tc_core.tc-hygiene-global-name? raw-text))
          (tc_core.TcNameLookup.Ok
            (if (tc_core.macro-hygiene-global-id? raw-name)
              (lower-hygiene-source-name-in-context-id ctx type-env raw-name)
              (tc_core.tc-hygiene-global-call-name raw-text))
            source-id)
          (if (tc_core.tc-source-slash-qualified-id? raw-text source-id)
            (tc_core.TcNameLookup.Ok raw-text source-id)
            (tc_core.tc-source-name-lookup-key-with-field-check-lookup
              ctx
              type-env
              raw-text
              source-id
              true)))
          [(tc_core.TcNameLookup.Ok lookup-name lookup-id)
            (lower-atomic-extern-symbol-for-name-id ctx lookup-name lookup-id)]
          [(tc_core.TcNameLookup.Err _) ""]))]
    [_ ""]))

;; The symbol table is keyed by the module key (module/name) and the bare source
;; name alias, never by the `::` logical/mangled name returned by
;; lower-resolve-name. Look up the bare source name so a function used as a value
;; lowers to CompilerIrValue.Function (its closure-descriptor address) instead of falling
;; through to CompilerIrValue.Global (which would load the function's code bytes and
;; miscompile an indirect call through it).
(define (lower-symbol-function-value-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (let
    [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [kind : i64 (csym.compiler-symbol-handle-kind handle)]
        (or
          (= kind (csym.compiler-symbol-kind-function-define))
          (= kind (csym.compiler-symbol-kind-defdispatch))
          (and
            (= kind (csym.compiler-symbol-kind-extern))
            (match (csym.compiler-symbols-decl-at-index
              symbols
              (csym.compiler-symbol-handle-index handle))
              [(parser.ResultAstDecl.Ok decl)
                (match decl
                  [(ast.AstDecl.Extern decl-meta _ extern-kind _ _)
                    (match extern-kind
                      [(ast.AstExternKind.Function) true]
                      [(ast.AstExternKind.Value) false])]
                  [_ false])]
              [(parser.ResultAstDecl.Err _) false]))))
      false)))

(define (lower-extern-value-decl-id? [ctx : tc_core.TcContext] [name-id : i64]) : bool
  (let
    [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-extern)))
      (match (csym.compiler-symbols-decl-at-index
        symbols
        (csym.compiler-symbol-handle-index handle))
        [(parser.ResultAstDecl.Ok decl)
          (match decl
            [(ast.AstDecl.Extern decl-meta _ extern-kind _ _)
              (match extern-kind
                [(ast.AstExternKind.Function) false]
                [(ast.AstExternKind.Value) true])]
            [_ false])]
        [(parser.ResultAstDecl.Err _) false])
      false)))

(define (lower-function-value-or-var-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : ast.AstType]) : ResultLowerExpr
  (cond
    [(sym_i64_env.sym-i64-contains-id env name-id)
      (lower-var-id state env name-id ty)]
    [(lower-extern-value-decl-id? ctx name-id)
      (match (lower-var-id state env name-id ty)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr value-state value _)
              (match (lower-state-alloc-var value-state)
                [(LowerAlloc.Alloc allocated var-id)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-state-emit
                        allocated
                        (ir.CompilerIrInstr.Mov var-id value ty))
                      (ir.CompilerIrValue.Var var-id)
                      ty))])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(and
        (lower-function-type? ty)
        (lower-symbol-function-value-id? ctx name-id))
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (ir.CompilerIrValue.Function
            (lower-resolve-name-symbol-id state name-id))
          ty))]
    [else (lower-var-id state env name-id ty)]))

(define (lower-lambda-captures-env?
  [expr-bases : i64]
  [outer-env : sym_i64_env.SymI64Env]
  [body : ast.AstExpr]
  [bound : tc_core.TcStringList]) : bool
  (match (sym_i64_env.sym-i64-view outer-env)
    [(sym_i64_env.SymI64ViewNil) false]
    [(sym_i64_env.SymI64ViewBind name-id _ rest)
      (if (tc_core.tc-expr-uses-free-name?
        expr-bases
        body
        (tc_core.tc-env-key-name-text name-id)
        bound)
        true
        (lower-lambda-captures-env? expr-bases rest body bound))]))

(define (lower-lambda-ret-type
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [lambda-expr : ast.AstExpr]
  [maybe-ret : ast.AstMaybeType]) : tc_core.ResultTcType
  (match maybe-ret
    [(ast.AstMaybeType.Some ty)
      (tc_core.ResultTcType.Ok (tc_core.tc-resolve-type ctx ty))]
    [(ast.AstMaybeType.No)
      (match (tc_core.tc-expr ctx type-env lambda-expr)
        [(tc_core.ResultTcType.Ok ty)
          (match (tc_core.tc-type-strip-region ty)
            [(ast.AstType.Func _ ret)
              (tc_core.ResultTcType.Ok (tc_core.tc-context-type-get ctx ret))]
            [_
              (tc_core.ResultTcType.Err
                "lower: lambda did not typecheck as a function")])]
        [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)])]))

(define (lower-capture-list-contains-name?
  [captures : LowerCaptureList]
  [name-id : i64]) : bool
  (let
    [items : (__tl_dyn-array LowerCapture) (struct-get captures items)]
    [count : i64 (struct-get captures count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (array-ref items index)
          [(LowerCapture.Capture capture-name-id _ _ _)
            (if (= capture-name-id name-id)
              (set! found true)
              (set! index (+ index 1)))]))
      found)))

(define (lower-capture-list-empty) : LowerCaptureList
  (LowerCaptureList (make-array LowerCapture 0) 0))

(define (lower-capture-list-add-front
  [captures : LowerCaptureList]
  [capture : LowerCapture]) : LowerCaptureList
  (let
    [items : (__tl_dyn-array LowerCapture) (struct-get captures items)]
    [count : i64 (struct-get captures count)]
    (begin
      (array-push! items capture)
      (LowerCaptureList items (+ count 1)))))

(define (lower-unsupported-capture-message) : String
  "lower: unsupported lambda capture type")

(define (lower-capture-support-message
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ _) (lower-reference-support-message)]
    [(ast.AstType.MutRef _ _) (lower-reference-support-message)]
    [_ (lower-unsupported-capture-message)]))

(define (lower-supported-capture-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Char) true]
    [(ast.AstType.Ref _ _) true]
    [(ast.AstType.MutRef _ _) true]
    [(ast.AstType.Func _ _) true]
    [(ast.AstType.Tuple _) true]
    [(ast.AstType.Array _ _) true]
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [(ast.AstType.Struct _) true]
    [(ast.AstType.StructArgs _ _) true]
    [(ast.AstType.String) true]
    [(ast.AstType.DynArray _) true]
    [_ false]))

(define (lower-capture-env-size [cursor : i64]) : i64
  (lower-align-up
    (if (= cursor 0)
      1
      cursor)
    8))

(define (lower-capture-slot-type [ty : ast.AstType]) : ast.AstType
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Func _ _) (ast.AstType.U64)]
    [(ast.AstType.Tuple _) (ast.AstType.U64)]
    [(ast.AstType.Array _ _) (ast.AstType.U64)]
    [(ast.AstType.Enum _) (ast.AstType.U64)]
    [(ast.AstType.EnumArgs _ _) (ast.AstType.U64)]
    [(ast.AstType.Struct _) (ast.AstType.U64)]
    [(ast.AstType.StructArgs _ _) (ast.AstType.U64)]
    [(ast.AstType.String) (ast.AstType.U64)]
    [(ast.AstType.DynArray _) (ast.AstType.U64)]
    [_ ty]))

(define (lower-fixed-array-storage-size
  [ctx : tc_core.TcContext]
  [elem-ty : ast.AstType]
  [count : i64]) : i64
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    [extent : i64 (* count elem-size)]
    (lower-align-up
      (if (= extent 0)
        1
        extent)
      8)))

(define (lower-capture-snapshot-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-resolve-type ctx ty)
    [(ast.AstType.String) (lower-capture-snapshot-string-value state value)]
    [(ast.AstType.DynArray elem-ty)
      (lower-capture-snapshot-dynarray-value
        ctx
        state
        value
        (tc_core.tc-type-without-regions
          (tc_core.tc-context-type-get ctx elem-ty))
        ty)]
    [(ast.AstType.Tuple elem-tys)
      (lower-capture-snapshot-tuple-value
        ctx
        state
        env
        type-env
        value
        (box-get elem-tys)
        ty)]
    [(ast.AstType.Array elem-ty count)
      (lower-capture-snapshot-fixed-array-value
        ctx
        state
        env
        type-env
        value
        (tc_core.tc-type-without-regions
          (tc_core.tc-context-type-get ctx elem-ty))
        count
        ty)]
    ;; A register-resident aggregate is word-class POD held in a register;
    ;; its capture snapshot is the value itself (nothing on the heap to copy).
    [(ast.AstType.Struct name)
      (if (lower-type-register-resident? ctx ty)
        (ResultLowerExpr.Ok (LowerExpr.Expr state value ty))
        (lower-capture-snapshot-struct-value
          ctx
          state
          env
          type-env
          value
          (tc_core.tc-nominal-name-id-display name)
          ty))]
    [(ast.AstType.StructArgs name _)
      (lower-capture-snapshot-struct-value
        ctx
        state
        env
        type-env
        value
        (tc_core.tc-nominal-name-id-display name)
        ty)]
    [(ast.AstType.Enum name)
      (if (lower-type-register-resident? ctx ty)
        (ResultLowerExpr.Ok (LowerExpr.Expr state value ty))
        (lower-capture-snapshot-enum-value
          ctx
          state
          env
          type-env
          value
          name
          (tc_core.tc-nominal-name-id-display name)
          ty))]
    [(ast.AstType.EnumArgs name _)
      (lower-capture-snapshot-enum-value
        ctx
        state
        env
        type-env
        value
        name
        (tc_core.tc-nominal-name-id-display name)
        ty)]
    [_ (ResultLowerExpr.Ok (LowerExpr.Expr state value ty))]))

(define (lower-capture-snapshot-string-value
  [state : LowerState]
  [value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state value)
    [(LowerStringFields.Fields fields-state ptr len)
      (lower-substring-call-runtime
        fields-state
        ptr
        (ir.CompilerIrValue.I64 0)
        len)]))

(define (lower-capture-snapshot-dynarray-copy
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]) : LowerState
  (if (= elem-size 0)
    state
    (lower-array-push-copy-loop ctx state old-buf new-buf len elem-ty)))

(define (lower-capture-snapshot-dynarray-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [old-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [buf-var : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 result-ty)
    [(LowerExpr.Expr arr-state arr-value _)
      (let
        [copied-state : LowerState
          (lower-capture-snapshot-dynarray-copy
            ctx
            arr-state
            old-buf
            (ir.CompilerIrValue.Var buf-var)
            len
            elem-ty
            elem-size)]
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-store-at-offset
              (lower-store-at-offset
                copied-state
                arr-value
                0
                (ir.CompilerIrValue.Var buf-var)
                (ast.AstType.U64))
              arr-value
              8
              len
              (ast.AstType.I64))
            arr-value
            result-ty)))]))

(define (lower-capture-snapshot-dynarray-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-load-at-offset state value 8 (ast.AstType.I64))
    [(LowerExpr.Expr len-state len _)
      (match (lower-load-at-offset len-state value 0 (ast.AstType.U64))
        [(LowerExpr.Expr ptr-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            (match (if (= elem-size 0)
              (LowerExpr.Expr
                ptr-state
                (ir.CompilerIrValue.I64 1)
                (ast.AstType.I64))
              (lower-emit-binop
                ptr-state
                ir.CompilerIrBinOp.Mul
                len
                (ir.CompilerIrValue.I64 elem-size)
                (ast.AstType.I64)))
              [(LowerExpr.Expr byte-state byte-count _)
                (match (lower-state-alloc-var byte-state)
                  [(LowerAlloc.Alloc buf-alloc buf-var)
                    (lower-capture-snapshot-dynarray-finish
                      ctx
                      (lower-state-emit
                        buf-alloc
                        (ir.CompilerIrInstr.Call
                          buf-var
                          (lower-tl-alloc-symbol)
                          (ir.CompilerIrCallArgs.One byte-count)
                          (ast.AstType.U64)))
                      old-buf
                      len
                      elem-ty
                      elem-size
                      buf-var
                      result-ty)])]))])]))

(define (lower-capture-snapshot-type-list
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [types : ast.AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-capture-snapshot-type-list-at
    ctx
    state
    env
    type-env
    src
    dst
    (& types)
    cursor
    0))

(define (lower-capture-snapshot-type-list-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [types : (& types ast.AstTypeList)]
  [cursor : i64]
  [index : i64]) : ResultLowerState
  (if (>= index (ast.ast-type-list-len types))
    (ResultLowerState.Ok state)
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [resolved : ast.AstType
        (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      [size : i64 (lower-type-size ctx resolved)]
      (if (> size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          resolved
          (lower-state-mode state))
          [(LowerExpr.Expr load-state field-value _)
            (match (lower-capture-snapshot-value
              ctx
              load-state
              env
              type-env
              field-value
              resolved)
              [(ResultLowerExpr.Ok snap)
                (match snap
                  [(LowerExpr.Expr snap-state snap-value _)
                    (lower-capture-snapshot-type-list-at
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        snap-state
                        dst
                        offset
                        snap-value
                        resolved
                        size)
                      env
                      type-env
                      src
                      dst
                      types
                      (+ offset size)
                      (+ index 1))])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (lower-capture-snapshot-type-list-at
          ctx
          state
          env
          type-env
          src
          dst
          types
          (+ offset size)
          (+ index 1))))))

(define (lower-capture-snapshot-tuple-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [elem-tys : ast.AstTypeList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage
    state
    (lower-type-list-storage-size ctx elem-tys)
    result-ty)
    [(LowerExpr.Expr dst-state dst _)
      (match (lower-capture-snapshot-type-list
        ctx
        dst-state
        env
        type-env
        value
        dst
        elem-tys
        0)
        [(ResultLowerState.Ok done-state)
          (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
        [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-capture-snapshot-fixed-array-elems
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [index : i64]
  [count : i64]) : ResultLowerState
  (if (>= index count)
    (ResultLowerState.Ok state)
    (let
      [offset : i64 (* index elem-size)]
      (if (> elem-size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          elem-ty
          (lower-state-mode state))
          [(LowerExpr.Expr load-state elem-value _)
            (match (lower-capture-snapshot-value
              ctx
              load-state
              env
              type-env
              elem-value
              elem-ty)
              [(ResultLowerExpr.Ok snap)
                (match snap
                  [(LowerExpr.Expr snap-state snap-value _)
                    (lower-capture-snapshot-fixed-array-elems
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        snap-state
                        dst
                        offset
                        snap-value
                        elem-ty
                        elem-size)
                      env
                      type-env
                      src
                      dst
                      elem-ty
                      elem-size
                      (+ index 1)
                      count)])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (lower-capture-snapshot-fixed-array-elems
          ctx
          state
          env
          type-env
          src
          dst
          elem-ty
          elem-size
          (+ index 1)
          count)))))

(define (lower-capture-snapshot-fixed-array-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [count : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    (match (lower-reserve-heap-storage
      state
      (lower-fixed-array-storage-size ctx elem-ty count)
      result-ty)
      [(LowerExpr.Expr dst-state dst _)
        (match (lower-capture-snapshot-fixed-array-elems
          ctx
          dst-state
          env
          type-env
          value
          dst
          elem-ty
          elem-size
          0
          count)
          [(ResultLowerState.Ok done-state)
            (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
          [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])))

(define (lower-capture-snapshot-struct-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [struct-name : String]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-struct-repr-c-id? ctx (lower-struct-type-name-id-or result-ty -1))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic
          "lower: repr-c aggregate lambda captures need repr-c snapshot lowering")))
    (match (lower-struct-fields-id
      ctx
      (lower-struct-type-name-id-or result-ty -1)
      struct-name)
      [(parser.ResultAstFieldDefList.Ok fields)
        (let
          [field-types : ast.AstTypeList
            (tc_core.tc-field-type-list ctx fields)]
          (match (lower-reserve-heap-storage
            state
            (lower-type-list-storage-size ctx field-types)
            result-ty)
            [(LowerExpr.Expr dst-state dst _)
              (match (lower-capture-snapshot-type-list
                ctx
                dst-state
                env
                type-env
                value
                dst
                field-types
                0)
                [(ResultLowerState.Ok done-state)
                  (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
                [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))]
      [(parser.ResultAstFieldDefList.Err message)
        (ResultLowerExpr.Err (box (lower-diagnostic message)))])))

(define (lower-capture-snapshot-enum-variants
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [tag : ir.CompilerIrValue]
  [variants : ast.AstVariantDefList]
  [index : i64]
  [done-label : i64]) : ResultLowerState
  (if (>= index (struct-get (& variants) len))
    (ResultLowerState.Ok
      (lower-state-finish-block
        (lower-state-emit state (ir.CompilerIrInstr.Jump done-label))
        done-label))
    (let
      [variant : ast.AstVariantDef
        (ast.ast-variant-def-list-get
          (& variants)
          index
          (ast.ast-variant-def-fallback))]
      (match (lower-state-fresh-label state "capture_enum_variant")
        [(LowerLabel.Label variant-label-state variant-label)
          (match (lower-state-fresh-label
            variant-label-state
            "capture_enum_next")
            [(LowerLabel.Label next-label-state next-label)
              (match (lower-state-alloc-var next-label-state)
                [(LowerAlloc.Alloc cond-state cond-var)
                  (let
                    [branch-state : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            cond-state
                            (ir.CompilerIrInstr.BinOp
                              cond-var
                              ir.CompilerIrBinOp.Eq
                              tag
                              (ir.CompilerIrValue.I64 index)
                              (ast.AstType.I64)))
                          (ir.CompilerIrInstr.Branch
                            (ir.CompilerIrValue.Var cond-var)
                            variant-label
                            next-label))
                        variant-label)]
                    (match variant
                      [(ast.AstVariantDef.Def _ fields _)
                        (match (lower-capture-snapshot-type-list
                          ctx
                          branch-state
                          env
                          type-env
                          src
                          dst
                          fields
                          8)
                          [(ResultLowerState.Ok copied-state)
                            (lower-capture-snapshot-enum-variants
                              ctx
                              (lower-state-finish-block
                                (lower-state-emit
                                  copied-state
                                  (ir.CompilerIrInstr.Jump done-label))
                                next-label)
                              env
                              type-env
                              src
                              dst
                              tag
                              variants
                              (+ index 1)
                              done-label)]
                          [(ResultLowerState.Err message)
                            (ResultLowerState.Err message)])]))])])]))))

(define (lower-capture-snapshot-enum-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [enum-name-id : i64]
  [enum-name : String]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match ctx
    [(tc_core.TcContext _ _ _ _ _ _ _ _ _)
      (match (tc_core.tc-context-enum-variants-id ctx enum-name-id enum-name)
        [(parser.ResultAstVariantDefList.Ok variants)
          (match (lower-reserve-heap-storage
            state
            (lower-enum-storage-size ctx enum-name-id enum-name)
            result-ty)
            [(LowerExpr.Expr dst-state dst _)
              (match (lower-load-at-offset dst-state value 0 (ast.AstType.I64))
                [(LowerExpr.Expr tag-state tag _)
                  (match (lower-state-fresh-label tag-state "capture_enum_done")
                    [(LowerLabel.Label done-state done-label)
                      (match (lower-capture-snapshot-enum-variants
                        ctx
                        (lower-store-at-offset
                          done-state
                          dst
                          0
                          tag
                          (ast.AstType.I64))
                        env
                        type-env
                        value
                        dst
                        tag
                        variants
                        0
                        done-label)
                        [(ResultLowerState.Ok final-state)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr final-state dst result-ty))]
                        [(ResultLowerState.Err message)
                          (ResultLowerExpr.Err message)])])])])]
        [(parser.ResultAstVariantDefList.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic message)))])]))

(define (lower-capture-plan-scan
  [ctx : tc_core.TcContext]
  [expr-bases : i64]
  [outer-env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [body : ast.AstExpr]
  [bound : tc_core.TcStringList]
  [cursor : i64]
  [captures : LowerCaptureList]
  [origin : ast.AstExpr]) : ResultLowerCapturePlan
  (match (sym_i64_env.sym-i64-view outer-env)
    [(sym_i64_env.SymI64ViewNil)
      (ResultLowerCapturePlan.Ok
        (LowerCapturePlan.Plan captures (lower-capture-env-size cursor)))]
    [(sym_i64_env.SymI64ViewBind name-id var-id rest)
      (let
        [name : String (tc_core.tc-env-key-name-text name-id)]
        (if (or
          (lower-capture-list-contains-name? captures name-id)
          (not (tc_core.tc-expr-uses-free-name? expr-bases body name bound)))
          (lower-capture-plan-scan
            ctx
            expr-bases
            rest
            type-env
            body
            bound
            cursor
            captures
            origin)
          (match (tc_core.tc-lookup-id type-env name-id)
            [(tc_core.ResultTcType.Err message)
              (ResultLowerCapturePlan.Err
                (box (lower-diagnostic-at-expr origin message)))]
            [(tc_core.ResultTcType.Ok found-ty)
              (let
                [capture-ty : ast.AstType
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx found-ty))]
                (if (lower-supported-capture-type? ctx capture-ty)
                  (let
                    [slot-ty : ast.AstType (lower-capture-slot-type capture-ty)]
                    [offset : i64
                      (lower-align-up cursor (lower-type-align ctx slot-ty))]
                    ;; A register-group capture occupies 16 bytes inline (two
                    ;; words), not an 8-byte handle slot.
                    [slot-size : i64
                      (if (lower-type-register-group? ctx capture-ty)
                        16
                        (lower-type-size ctx slot-ty))]
                    (lower-capture-plan-scan
                      ctx
                      expr-bases
                      rest
                      type-env
                      body
                      bound
                      (+ offset slot-size)
                      (lower-capture-list-add-front
                        captures
                        (LowerCapture.Capture name-id var-id capture-ty offset))
                      origin))
                  (ResultLowerCapturePlan.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        (lower-capture-support-message ctx capture-ty))))))])))]))

(define (lower-capture-plan
  [ctx : tc_core.TcContext]
  [outer-env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerCapturePlan
  (lower-capture-plan-scan
    ctx
    (tc_core.tc-context-expr-bases ctx)
    outer-env
    type-env
    body
    (tc_core.tc-param-bound-names params)
    0
    (lower-capture-list-empty)
    origin))

(define (lower-store-captures-from-index
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [env-value : ir.CompilerIrValue]
  [items : (__tl_dyn-array LowerCapture)]
  [index : i64]) : ResultLowerState
  (if (< index 0)
    (ResultLowerState.Ok state)
    (let
      [capture : LowerCapture (array-ref items index)]
      (match capture
        [(LowerCapture.Capture _ var-id capture-ty offset)
          (match (lower-capture-snapshot-value
            ctx
            state
            env
            type-env
            (ir.CompilerIrValue.Var var-id)
            capture-ty)
            [(ResultLowerExpr.Ok snap)
              (match snap
                [(LowerExpr.Expr snap-state snap-value _)
                  (lower-store-captures-from-index
                    ctx
                    (if (lower-type-register-group? ctx capture-ty)
                      ;; A captured 2-word group stores both words.
                      (match (lower-gep-byte snap-state env-value offset)
                        [(LowerExpr.Expr gep-state ptr _)
                          (lower-store-group-at-ptr
                            ctx
                            gep-state
                            ptr
                            snap-value
                            capture-ty)])
                      (lower-store-at-offset
                        snap-state
                        env-value
                        offset
                        snap-value
                        (lower-capture-slot-type capture-ty)))
                    env
                    type-env
                    env-value
                    items
                    (- index 1))])]
            [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])]))))

(define (lower-store-captures
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [env-value : ir.CompilerIrValue]
  [captures : LowerCaptureList]) : ResultLowerState
  (lower-store-captures-from-index
    ctx
    state
    env
    type-env
    env-value
    (struct-get captures items)
    (- (struct-get captures count) 1)))

(define (lower-store-capturing-lambda-descriptor
  [state : LowerState]
  [lambda-name : i64]
  [env-value : ir.CompilerIrValue]
  [expr-ty : ast.AstType]) : LowerExpr
  (match (lower-reserve-heap-storage state 16 expr-ty)
    [(LowerExpr.Expr desc-state desc-value _)
      (LowerExpr.Expr
        (lower-store-at-offset
          (lower-store-at-offset
            desc-state
            desc-value
            0
            (ir.CompilerIrValue.GlobalAddr lambda-name)
            (ast.AstType.U64))
          desc-value
          8
          env-value
          (ast.AstType.U64))
        desc-value
        expr-ty)]))

(define (lower-capturing-lambda-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lambda-name : i64]
  [captures : LowerCaptureList]
  [capture-size : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state capture-size (ast.AstType.U64))
    [(LowerExpr.Expr env-state env-value _)
      (match (lower-store-captures
        ctx
        env-state
        env
        type-env
        env-value
        captures)
        [(ResultLowerState.Ok captured-state)
          (match (lower-store-capturing-lambda-descriptor
            captured-state
            lambda-name
            env-value
            expr-ty)
            [(LowerExpr.Expr desc-state desc-value desc-ty)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr desc-state desc-value desc-ty))])]
        [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-load-captures-from-index
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env-value : ir.CompilerIrValue]
  [items : (__tl_dyn-array LowerCapture)]
  [index : i64]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerEnv
  (if (< index 0)
    (ResultLowerEnv.Ok state env type-env)
    (let
      [capture : LowerCapture (array-ref items index)]
      (match capture
        [(LowerCapture.Capture name-id _ capture-ty offset)
          (match (if (lower-type-register-group? ctx capture-ty)
            ;; A captured 2-word group loads both words and repacks.
            (match (lower-gep-byte state env-value offset)
              [(LowerExpr.Expr gep-state ptr _)
                (lower-load-group-from-ptr ctx gep-state ptr capture-ty)])
            (lower-load-at-offset
              state
              env-value
              offset
              (lower-capture-slot-type capture-ty)))
            [(LowerExpr.Expr loaded-state loaded-value _)
              (match loaded-value
                [(ir.CompilerIrValue.Var loaded-var)
                  (lower-load-captures-from-index
                    ctx
                    loaded-state
                    env-value
                    items
                    (- index 1)
                    (sym_i64_env.sym-i64-bind-id env name-id loaded-var)
                    (tc_core.tc-bind-id type-env name-id capture-ty))]
                [_
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: capture load did not materialize a variable")))])])]))))

(define (lower-load-captures
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env-value : ir.CompilerIrValue]
  [captures : LowerCaptureList]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerEnv
  (lower-load-captures-from-index
    ctx
    state
    env-value
    (struct-get captures items)
    (- (struct-get captures count) 1)
    env
    type-env))

(define (lower-captured-param-list
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]) : ir.CompilerIrParamList
  (ir.compiler-ir-param-cons
    (ir.CompilerIrParam.Param "__tl_env" (ast.AstType.U64) 0)
    (lower-param-list ctx params 1)))

(define (lower-captured-internal-param-list
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : ast.AstParamList]
  [source-start : i64]
  [leading-sret? : bool]) : ir.CompilerIrParamList
  (ir.compiler-ir-param-cons
    (ir.CompilerIrParam.Param "__tl_env" (ast.AstType.U64) 0)
    (lower-internal-param-list ctx mode params source-start leading-sret?)))

(define (lower-function-with-captures
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [captures : LowerCaptureList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (if (or
    (lower-param-list-contains-unsupported-reference? ctx params)
    (not (lower-supported-reference-type? ctx ret)))
    (ResultLowerFunction.Err
      (box (lower-diagnostic (lower-reference-support-message))))
    (let
      [logical-name-text : String (ir.compiler-ir-symbol-text logical-name)]
      [param-count : i64 (lower-param-count params)]
      [ret-ty : ast.AstType
        (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
      [ret-class : LowerCAbiAggregate
        (lower-internal-return-class-for-name ctx mode logical-name-text ret-ty)]
      [structural-sret? : bool
        (match ret-class
          [(LowerCAbiAggregate.Sret _) true]
          [_ false])]
      [nominal-sret? : bool
        (and
          (not structural-sret?)
          (lower-mode-inline-aggregates? mode)
          (not (lower-global-init-function? logical-name-text))
          (lower-type-inline-struct-or-enum? ctx ret-ty)
          (not (lower-type-register-resident? ctx ret-ty)))]
      [source-start : i64
        (if structural-sret?
          2
          1)]
      [structural-params? : bool
        (lower-internal-param-list-contains-structural? ctx params)]
      [sret-var : i64
        (if structural-sret?
          1
          (if nominal-sret?
            (+ source-start param-count)
            (- 0 1)))]
      [ret-ir-ty : ast.AstType
        (match ret-class
          [(LowerCAbiAggregate.Unsupported _) (ast.AstType.U64)]
          [_ (lower-internal-return-physical-type ctx mode ret-ty)])]
      [function-spans : ir.CompilerSourceSpans
        (lower-record-function-span
          spans
          (ir.compiler-ir-symbol-typed-id logical-name)
          body)]
      [state : LowerState
        (lower-state-new
          (+
            source-start
            param-count
            (if nominal-sret?
              1
              0))
          0
          0
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-instr-builder-new)
          (ir.compiler-ir-block-builder-new)
          (ir.compiler-ir-function-builder-new)
          logical-name
          (box function-spans)
          names
          type-cache
          mode
          (lower_i64_i64_map.with-capacity 8)
          source-start
          (+ source-start param-count))]
      (match ret-class
        [(LowerCAbiAggregate.Unsupported message)
          (ResultLowerFunction.Err
            (box (lower-diagnostic-at-expr body message)))]
        [_
          (match (lower-load-captures
            ctx
            state
            (ir.CompilerIrValue.Var 0)
            captures
            (sym_i64_env.sym-i64-empty)
            (tc_core.tc-bind-return-type top-env ret-ty))
            [(ResultLowerEnv.Ok captured-state captured-env captured-type-env)
              (let
                [initial-env : sym_i64_env.SymI64Env
                  (if (>= sret-var 0)
                    (sym_i64_env.sym-i64-bind-id
                      captured-env
                      (lower-sret-param-marker-id)
                      sret-var)
                    captured-env)]
                [type-env : tc_core.TcTypeEnv
                  (tc_core.tc-bind-params ctx captured-type-env params)]
                (match (if structural-params?
                  (lower-bind-internal-params
                    ctx
                    mode
                    params
                    source-start
                    captured-state
                    initial-env
                    type-env
                    body)
                  (ResultLowerEnv.Ok
                    captured-state
                    (lower-bind-params params source-start initial-env)
                    type-env))
                  [(ResultLowerEnv.Ok bound-state bound-env bound-type-env)
                    (match (lower-tail-expr
                      ctx
                      bound-state
                      bound-env
                      bound-type-env
                      body
                      ret-ty
                      sret-var)
                      [(ResultLowerState.Ok final-state)
                        (let
                          [source-params : ir.CompilerIrParamList
                            (if structural-params?
                              (lower-captured-internal-param-list
                                ctx
                                mode
                                params
                                source-start
                                structural-sret?)
                              (let
                                [source : ir.CompilerIrParamList
                                  (lower-param-list ctx params source-start)]
                                [with-sret : ir.CompilerIrParamList
                                  (if structural-sret?
                                    (ir.compiler-ir-param-cons
                                      (ir.CompilerIrParam.Param
                                        "__sret"
                                        (ast.AstType.U64)
                                        1)
                                      source)
                                    source)]
                                (ir.compiler-ir-param-cons
                                  (ir.CompilerIrParam.Param
                                    "__tl_env"
                                    (ast.AstType.U64)
                                    0)
                                  with-sret)))]
                          [all-params : ir.CompilerIrParamList
                            (if nominal-sret?
                              (lower-param-list-append-sret
                                source-params
                                sret-var)
                              source-params)]
                          (ResultLowerFunction.Ok
                            (lower-state-build-functions-with
                              final-state
                              (ir.CompilerIrFunction.Function
                                logical-name
                                all-params
                                ret-ir-ty
                                (lower-state-next-var final-state)
                                (lower-state-build-function-blocks final-state)))
                            (lower-state-spans final-state)))]
                      [(ResultLowerState.Err message)
                        (ResultLowerFunction.Err message)])]
                  [(ResultLowerEnv.Err message)
                    (ResultLowerFunction.Err message)]))]
            [(ResultLowerEnv.Err message) (ResultLowerFunction.Err message)])]))))

(define (lower-lambda-noncapturing
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-lambda-ret-type ctx type-env origin maybe-ret)
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]
    [(tc_core.ResultTcType.Ok ret-ty)
      (match (lower-state-fresh-lambda-name state)
        [(LowerLambdaName.Name named-state lambda-name)
          (match (lower-function
            ctx
            type-env
            (lower-state-type-cache state)
            lambda-name
            params
            ret-ty
            body
            (lower-state-spans named-state)
            (lower-state-names named-state)
            (lower-state-mode named-state))
            [(ResultLowerFunction.Ok lambda-functions lambda-spans)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-state-add-functions
                    named-state
                    lambda-functions
                    lambda-spans)
                  (ir.CompilerIrValue.Function lambda-name)
                  expr-ty))]
            [(ResultLowerFunction.Err message) (ResultLowerExpr.Err message)])])]))

(define (lower-lambda-capturing
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-lambda-ret-type ctx type-env origin maybe-ret)
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]
    [(tc_core.ResultTcType.Ok ret-ty)
      (match (lower-capture-plan ctx env type-env params body origin)
        [(ResultLowerCapturePlan.Err message) (ResultLowerExpr.Err message)]
        [(ResultLowerCapturePlan.Ok plan)
          (match plan
            [(LowerCapturePlan.Plan captures capture-size)
              (match (lower-state-fresh-lambda-name state)
                [(LowerLambdaName.Name named-state lambda-name)
                  (match (lower-function-with-captures
                    ctx
                    type-env
                    (lower-state-type-cache named-state)
                    lambda-name
                    params
                    ret-ty
                    body
                    captures
                    (lower-state-spans named-state)
                    (lower-state-names named-state)
                    (lower-state-mode named-state))
                    [(ResultLowerFunction.Ok lambda-functions lambda-spans)
                      (match (lower-capturing-lambda-value
                        ctx
                        (lower-state-add-functions
                          named-state
                          lambda-functions
                          lambda-spans)
                        env
                        type-env
                        lambda-name
                        captures
                        capture-size
                        expr-ty)
                        [(ResultLowerExpr.Ok lowered)
                          (match lowered
                            [(LowerExpr.Expr value-state value value-ty)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr value-state value value-ty))])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])]
                    [(ResultLowerFunction.Err message)
                      (ResultLowerExpr.Err message)])])])])]))

(define (lower-lambda
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-lambda-captures-env?
    (tc_core.tc-context-expr-bases ctx)
    env
    body
    (tc_core.tc-param-bound-names params))
    (lower-lambda-capturing
      ctx
      state
      env
      type-env
      params
      maybe-ret
      body
      origin
      expr-ty)
    (lower-lambda-noncapturing
      ctx
      state
      type-env
      params
      maybe-ret
      body
      origin
      expr-ty)))

(define (lower-return-maybe [value : ir.CompilerIrValue] [ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (match ty
    [(ast.AstType.Unit) ir.CompilerIrMaybeValue.No]
    [_ (ir.CompilerIrMaybeValue.Some value)]))

(define (lower-private-name-id [kind : i64] [var-id : i64]) : i64
  ;; Parser ids and their typechecker marker keys occupy the ranges nearest
  ;; zero. Lower-only bindings use this disjoint structural namespace.
  (- 0 (+ (* (ci.intern-capacity) 4) (+ (* var-id 16) kind))))

(define (lower-private-name-kind [name-id : i64]) : i64
  (% (- (- 0 name-id) (* (ci.intern-capacity) 4)) 16))

(define (lower-private-name-value [name-id : i64]) : i64
  (/ (- (- 0 name-id) (* (ci.intern-capacity) 4)) 16))

(define (lower-cleanup-marker-id) : i64
  (lower-private-name-id 1 0))

(define (lower-region-reset-marker-id) : i64
  (lower-private-name-id 2 0))

;; Lower-only binding for the caller-owned result slot. Kind zero is reserved
;; for this marker; the value component is intentionally zero so this remains
;; disjoint from all source and cleanup names without changing the 16-wide
;; private-name encoding.
(define (lower-sret-param-marker-id) : i64
  (lower-private-name-id 0 0))

(define (lower-spmd-reduce-acc-id) : i64
  (lower-private-name-id 3 0))

(define (lower-spmd-reduce-end-id) : i64
  (lower-private-name-id 4 0))

(define (lower-spmd-reduce-val-id) : i64
  (lower-private-name-id 5 0))

(define (lower-spmd-reduce-current-id) : i64
  (lower-private-name-id 6 0))

(define (lower-spmd-reduce-start-id) : i64
  (lower-private-name-id 15 0))

(define (lower-spmd-reduce-uniform-id) : i64
  (lower-private-name-id 16 0))

(define (lower-spmd-scan-acc-id) : i64
  (lower-private-name-id 7 0))

(define (lower-spmd-scan-end-id) : i64
  (lower-private-name-id 8 0))

(define (lower-spmd-scan-val-id) : i64
  (lower-private-name-id 9 0))

(define (lower-cleanup-hidden-name-id [var-id : i64]) : i64
  (lower-private-name-id 10 var-id))

(define (lower-cleanup-live-name-id [var-id : i64]) : i64
  ;; Kind 1 value 0 is the cleanup-stack marker. Positive values are its
  ;; per-resource liveness bindings, disjoint from every allocated var id.
  (lower-private-name-id 1 (+ var-id 1)))

(define (lower-region-hidden-name-id [var-id : i64]) : i64
  (lower-private-name-id 11 var-id))

(define (lower-arena-restore-hidden-name-id [var-id : i64]) : i64
  (lower-private-name-id 12 var-id))

(define (lower-while-exit-label-id [label-number : i64]) : i64
  (lower-private-name-id 13 label-number))

(define (lower-while-header-label-id [label-number : i64]) : i64
  (lower-private-name-id 14 label-number))

(define (lower-loop-label-name [name-id : i64]) : i64
  (let
    [kind : i64 (lower-private-name-kind name-id)]
    [prefix : String
      (if (= kind 13)
        "while_exit"
        (if (= kind 14)
          "while_header"
          "invalid_loop_label"))]
    (ir.compiler-ir-label
      (string.append
        (string.append prefix ".")
        (string.int->string (lower-private-name-value name-id))))))

(define (lower-cleanup-metadata-type
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : ast.AstType
  (ast.ast-ty-tuple
    (ast.ast-type-cons
      (ast.AstType.Var hidden-name-id)
      (ast.ast-type-cons
        (ast.AstType.Var cleanup-name-id)
        (ast.ast-type-list-new)))))

(define (lower-region-reset-metadata-type [hidden-name-id : i64]) : ast.AstType
  (ast.AstType.Var hidden-name-id))

(define (lower-arena-restore-metadata-type [hidden-name-id : i64]) : ast.AstType
  (ast.ast-ty-tuple
    (ast.ast-type-cons (ast.AstType.Var hidden-name-id) (ast.ast-type-list-new))))

(define (lower-type-env-push-cleanup
  [type-env : tc_core.TcTypeEnv]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (lower-cleanup-marker-id)
    (lower-cleanup-metadata-type hidden-name-id cleanup-name-id)))

(define (lower-type-env-push-move-aware-cleanup
  [type-env : tc_core.TcTypeEnv]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]
  [live-name-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (lower-cleanup-marker-id)
    (ast.ast-ty-tuple
      (ast.ast-type-cons
        (ast.AstType.Var hidden-name-id)
        (ast.ast-type-cons
          (ast.AstType.Var cleanup-name-id)
          (ast.ast-type-cons
            (ast.AstType.Var live-name-id)
            (ast.ast-type-list-new)))))))

(define (lower-type-env-push-region-reset
  [type-env : tc_core.TcTypeEnv]
  [hidden-name-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (lower-region-reset-marker-id)
    (lower-region-reset-metadata-type hidden-name-id)))

(define (lower-type-env-push-arena-restore
  [type-env : tc_core.TcTypeEnv]
  [hidden-name-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (lower-region-reset-marker-id)
    (lower-arena-restore-metadata-type hidden-name-id)))

(define (lower-cleanup-name-id-from-expr [cleanup : ast.AstExpr]) : tc_core.ResultTcExprId
  (match (ast.ast-expr-unspan cleanup)
    [(ast.AstExpr.Var name) (tc_core.ResultTcExprId.Ok name)]
    [_
      (tc_core.ResultTcExprId.Err
        "lower: resource cleanup must be a direct function name")]))

(define (lower-emit-cleanup-call
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : ResultLowerState
  (let
    [resource-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        hidden-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? resource-id)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [call-name : i64
              (lower-resolve-call-name-id allocated env cleanup-name-id)]
            (ResultLowerState.Ok
              (lower-state-emit
                allocated
                (ir.CompilerIrInstr.Call
                  var-id
                  call-name
                  (ir.CompilerIrCallArgs.One
                    (ir.CompilerIrValue.Var resource-id))
                  (ast.AstType.Unit)))))])
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: missing resource cleanup binding"))))))

(define (lower-emit-cleanup-call-if-live
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]
  [live-name-id : i64]) : ResultLowerState
  (let
    [live-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        live-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (not (csym.compiler-symbols-handle-found? live-id))
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: missing resource liveness binding")))
      (match (lower-state-fresh-label state "cleanup_live")
        [(LowerLabel.Label cleanup-label-state cleanup-label)
          (match (lower-state-fresh-label cleanup-label-state "cleanup_done")
            [(LowerLabel.Label labels-state done-label)
              (let
                [cleanup-state : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      labels-state
                      (ir.CompilerIrInstr.Branch
                        (ir.CompilerIrValue.Var live-id)
                        cleanup-label
                        done-label))
                    cleanup-label)]
                (match (lower-emit-cleanup-call
                  cleanup-state
                  env
                  hidden-name-id
                  cleanup-name-id)
                  [(ResultLowerState.Ok called-state)
                    (ResultLowerState.Ok
                      (lower-state-finish-block
                        (lower-state-emit
                          called-state
                          (ir.CompilerIrInstr.Jump done-label))
                        done-label))]
                  [(ResultLowerState.Err message)
                    (ResultLowerState.Err message)]))])]))))

(define (lower-emit-region-reset
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]) : ResultLowerState
  (let
    [mark-var : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        hidden-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? mark-var)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated reset-var)
          (ResultLowerState.Ok
            (lower-state-emit
              allocated
              (ir.CompilerIrInstr.Call
                reset-var
                (lower-tl-region-reset-symbol)
                (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var mark-var))
                (ast.AstType.Unit))))])
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: missing region reset binding"))))))

(define (lower-emit-arena-restore
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]) : ResultLowerState
  (let
    [arena-var : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        hidden-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? arena-var)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated restore-var)
          (ResultLowerState.Ok
            (lower-state-emit
              allocated
              (ir.CompilerIrInstr.Call
                restore-var
                (lower-tl-arena-set-symbol)
                (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var arena-var))
                (ast.AstType.Unit))))])
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: missing arena restore binding"))))))

(define (lower-cleanup-stack-empty) : LowerCleanupStack
  (LowerCleanupStack (make-array i64 0) (make-array i64 0) (make-array i64 0) 0))

(define (lower-cleanup-stack-push
  [cleanups : LowerCleanupStack]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : LowerCleanupStack
  (let
    [hidden-name-ids : (__tl_dyn-array i64)
      (struct-get cleanups hidden-name-ids)]
    [cleanup-name-ids : (__tl_dyn-array i64)
      (struct-get cleanups cleanup-name-ids)]
    [live-name-ids : (__tl_dyn-array i64) (struct-get cleanups live-name-ids)]
    [count : i64 (struct-get cleanups count)]
    (begin
      (array-push! hidden-name-ids hidden-name-id)
      (array-push! cleanup-name-ids cleanup-name-id)
      (array-push! live-name-ids 0)
      (LowerCleanupStack
        hidden-name-ids
        cleanup-name-ids
        live-name-ids
        (+ count 1)))))

(define (lower-cleanup-stack-push-move-aware
  [cleanups : LowerCleanupStack]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]
  [live-name-id : i64]) : LowerCleanupStack
  (let
    [hidden-name-ids : (__tl_dyn-array i64)
      (struct-get cleanups hidden-name-ids)]
    [cleanup-name-ids : (__tl_dyn-array i64)
      (struct-get cleanups cleanup-name-ids)]
    [live-name-ids : (__tl_dyn-array i64) (struct-get cleanups live-name-ids)]
    [count : i64 (struct-get cleanups count)]
    (begin
      (array-push! hidden-name-ids hidden-name-id)
      (array-push! cleanup-name-ids cleanup-name-id)
      (array-push! live-name-ids live-name-id)
      (LowerCleanupStack
        hidden-name-ids
        cleanup-name-ids
        live-name-ids
        (+ count 1)))))

(define (lower-emit-cleanup-stack-at
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-ids : (__tl_dyn-array i64)]
  [cleanup-name-ids : (__tl_dyn-array i64)]
  [live-name-ids : (__tl_dyn-array i64)]
  [index : i64]) : ResultLowerState
  (if (< index 0)
    (ResultLowerState.Ok state)
    (let
      [live-name-id : i64 (array-ref live-name-ids index)]
      (match (if (= live-name-id 0)
        (lower-emit-cleanup-call
          state
          env
          (array-ref hidden-name-ids index)
          (array-ref cleanup-name-ids index))
        (lower-emit-cleanup-call-if-live
          state
          env
          (array-ref hidden-name-ids index)
          (array-ref cleanup-name-ids index)
          live-name-id))
        [(ResultLowerState.Ok next-state)
          (lower-emit-cleanup-stack-at
            next-state
            env
            hidden-name-ids
            cleanup-name-ids
            live-name-ids
            (- index 1))]
        [(ResultLowerState.Err message) (ResultLowerState.Err message)]))))

(define (lower-emit-cleanup-stack
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [cleanups : LowerCleanupStack]) : ResultLowerState
  (lower-emit-cleanup-stack-at
    state
    env
    (struct-get cleanups hidden-name-ids)
    (struct-get cleanups cleanup-name-ids)
    (struct-get cleanups live-name-ids)
    (- (struct-get cleanups count) 1)))

(define (lower-emit-cleanup-marker-tuple
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [types : ast.AstTypeList]) : ResultLowerState
  (if (or
    (= (ast.ast-type-list-len (& types)) 2)
    (= (ast.ast-type-list-len (& types)) 3))
    (let
      [hidden-ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get (& types) 0 (ast.ast-type-id-fallback)))]
      [cleanup-ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get (& types) 1 (ast.ast-type-id-fallback)))]
      (match hidden-ty
        [(ast.AstType.Var hidden-name)
          (match cleanup-ty
            [(ast.AstType.Var cleanup-name)
              (if (= (ast.ast-type-list-len (& types)) 2)
                (lower-emit-cleanup-call state env hidden-name cleanup-name)
                (match (tc_core.tc-context-type-get
                  ctx
                  (ast.ast-type-list-get (& types) 2 (ast.ast-type-id-fallback)))
                  [(ast.AstType.Var live-name)
                    (lower-emit-cleanup-call-if-live
                      state
                      env
                      hidden-name
                      cleanup-name
                      live-name)]
                  [_ (ResultLowerState.Ok state)]))]
            [_ (ResultLowerState.Ok state)])]
        [_ (ResultLowerState.Ok state)]))
    (ResultLowerState.Ok state)))

(define (lower-emit-arena-restore-marker-tuple
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [types : ast.AstTypeList]) : ResultLowerState
  (if (= (ast.ast-type-list-len (& types)) 1)
    (let
      [hidden-ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get (& types) 0 (ast.ast-type-id-fallback)))]
      (match hidden-ty
        [(ast.AstType.Var hidden-name)
          (lower-emit-arena-restore state env hidden-name)]
        [_ (ResultLowerState.Ok state)]))
    (ResultLowerState.Ok state)))

;; Emit the cleanup/region-reset calls a binding env keeps active. This
;; walks the whole TcTypeEnv chain once per scope exit; it used to be a
;; tail-recursive walk, but the inline-aggregate TCO guard declines
;; frame reuse here, so deep envs stacked one ~12KB frame per binding (8,164
;; frames = 100MB of the measured 502MB stack peak). Iterate instead.
(define (lower-emit-active-exits-with
  [ctx : tc_core.TcContext]
  [cleanup-marker-id : i64]
  [region-reset-marker-id : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerState
  (let
    [cur-env : tc_core.TcTypeEnv type-env]
    [cur-state : LowerState state]
    [result : ResultLowerState
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: internal active-exits walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (tc_core.tc-type-env-spine-step cur-env)
          [(tc_core.TcTypeEnvSpineStep.Done)
            (begin
              (set! result (ResultLowerState.Ok cur-state))
              (set! done true))]
          [(tc_core.TcTypeEnvSpineStep.Cache rest-env) (set! cur-env rest-env)]
          [(tc_core.TcTypeEnvSpineStep.Bind key ty rest-env)
            (begin
              ;; The hygiene global boundary closes the function-local scope:
              ;; cleanup/region-reset markers are only ever bound above it by
              ;; body forms (with-resource/with-arena), never in the module or
              ;; top env below. Stop there instead of walking the whole
              ;; program spine (~24.6k binds per return on a self-compile).
              ;; lint-allow: nested-if-ladder
              (if (= key (tc_core.tc-hygiene-global-boundary-id))
                (begin
                  (set! result (ResultLowerState.Ok cur-state))
                  (set! done true))
                (if (= key cleanup-marker-id)
                  (match ty
                    [(ast.AstType.Tuple types)
                      (match (lower-emit-cleanup-marker-tuple
                        ctx
                        cur-state
                        env
                        (box-get types))
                        [(ResultLowerState.Ok next-state)
                          (set! cur-state next-state)]
                        [(ResultLowerState.Err message)
                          (begin
                            (set! result (ResultLowerState.Err message))
                            (set! done true))])]
                    [_ unit])
                  (if (= key region-reset-marker-id)
                    (match ty
                      [(ast.AstType.Var hidden-name)
                        (match (lower-emit-region-reset
                          cur-state
                          env
                          hidden-name)
                          [(ResultLowerState.Ok next-state)
                            (set! cur-state next-state)]
                          [(ResultLowerState.Err message)
                            (begin
                              (set! result (ResultLowerState.Err message))
                              (set! done true))])]
                      [(ast.AstType.Tuple types)
                        (match (lower-emit-arena-restore-marker-tuple
                          ctx
                          cur-state
                          env
                          (box-get types))
                          [(ResultLowerState.Ok next-state)
                            (set! cur-state next-state)]
                          [(ResultLowerState.Err message)
                            (begin
                              (set! result (ResultLowerState.Err message))
                              (set! done true))])]
                      [_ unit])
                    unit)))
              (if done
                unit
                (set! cur-env rest-env)))]))
      result)))

(define (lower-emit-active-exits
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerState
  (lower-emit-active-exits-with
    ctx
    (lower-cleanup-marker-id)
    (lower-region-reset-marker-id)
    state
    env
    type-env))

(define (lower-loop-target-type
  [break-label-id : i64]
  [continue-label-id : i64]) : ast.AstType
  (ast.AstType.Tuple
    (box
      (ast.ast-type-cons
        (ast.AstType.Var break-label-id)
        (ast.ast-type-cons
          (ast.AstType.Var continue-label-id)
          (ast.ast-type-list-new))))))

(define (lower-enter-loop-target
  [type-env : tc_core.TcTypeEnv]
  [break-label-id : i64]
  [continue-label-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (tc_core.tc-loop-target-id)
    (lower-loop-target-type break-label-id continue-label-id)))

(define (lower-loop-target-missing [origin : ast.AstExpr] [form : String]) : ResultLowerLoopTarget
  (ResultLowerLoopTarget.Err
    (box
      (lower-diagnostic-at-expr
        origin
        (string.append
          "typecheck: "
          (string.append form " requires enclosing scalar while"))))))

(define (lower-loop-target-malformed [origin : ast.AstExpr]) : ResultLowerLoopTarget
  (ResultLowerLoopTarget.Err
    (box (lower-diagnostic-at-expr origin "lower: malformed loop target"))))

(define (lower-current-loop-target-from-types
  [origin : ast.AstExpr]
  [break-ty : ast.AstType]
  [continue-ty : ast.AstType]) : ResultLowerLoopTarget
  (match break-ty
    [(ast.AstType.Var break-name)
      (match continue-ty
        [(ast.AstType.Var continue-name)
          (ResultLowerLoopTarget.Ok
            (LowerLoopTarget.Target
              (lower-loop-label-name break-name)
              (lower-loop-label-name continue-name)))]
        [_ (lower-loop-target-malformed origin)])]
    [_ (lower-loop-target-malformed origin)]))

(define (lower-current-loop-target
  [ctx : tc_core.TcContext]
  [origin : ast.AstExpr]
  [type-env : tc_core.TcTypeEnv]
  [form : String]) : ResultLowerLoopTarget
  (match (tc_core.tc-env-marker-type type-env (tc_core.tc-loop-target-id))
    [(ast.AstMaybeType.Some ty)
      (match ty
        [(ast.AstType.Tuple types-box)
          (let
            [types : ast.AstTypeList (box-get types-box)]
            (if (= (ast.ast-type-list-len (& types)) 2)
              (let
                [break-ty : ast.AstType
                  (tc_core.tc-context-type-get
                    ctx
                    (ast.ast-type-list-get
                      (& types)
                      0
                      (ast.ast-type-id-fallback)))]
                [continue-ty : ast.AstType
                  (tc_core.tc-context-type-get
                    ctx
                    (ast.ast-type-list-get
                      (& types)
                      1
                      (ast.ast-type-id-fallback)))]
                (lower-current-loop-target-from-types
                  origin
                  break-ty
                  continue-ty))
              (lower-loop-target-malformed origin)))]
        [_ (lower-loop-target-missing origin form)])]
    [(ast.AstMaybeType.No) (lower-loop-target-missing origin form)]))

(define (lower-emit-active-loop-exits-with
  [ctx : tc_core.TcContext]
  [cleanup-marker-id : i64]
  [region-reset-marker-id : i64]
  [loop-target-id : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerState
  (let
    [cur-env : tc_core.TcTypeEnv type-env]
    [cur-state : LowerState state]
    [result : ResultLowerState
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: internal active-loop-exits walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (tc_core.tc-type-env-spine-step cur-env)
          [(tc_core.TcTypeEnvSpineStep.Done)
            (begin
              (set! result (ResultLowerState.Ok cur-state))
              (set! done true))]
          [(tc_core.TcTypeEnvSpineStep.Cache rest-env) (set! cur-env rest-env)]
          [(tc_core.TcTypeEnvSpineStep.Bind key ty rest-env)
            (begin
              ;; lint-allow: nested-if-ladder
              (if (= key loop-target-id)
                (begin
                  (set! result (ResultLowerState.Ok cur-state))
                  (set! done true))
                (if (= key cleanup-marker-id)
                  (match ty
                    [(ast.AstType.Tuple types)
                      (match (lower-emit-cleanup-marker-tuple
                        ctx
                        cur-state
                        env
                        (box-get types))
                        [(ResultLowerState.Ok next-state)
                          (set! cur-state next-state)]
                        [(ResultLowerState.Err message)
                          (begin
                            (set! result (ResultLowerState.Err message))
                            (set! done true))])]
                    [_ unit])
                  (if (= key region-reset-marker-id)
                    (match ty
                      [(ast.AstType.Var hidden-name)
                        (match (lower-emit-region-reset
                          cur-state
                          env
                          hidden-name)
                          [(ResultLowerState.Ok next-state)
                            (set! cur-state next-state)]
                          [(ResultLowerState.Err message)
                            (begin
                              (set! result (ResultLowerState.Err message))
                              (set! done true))])]
                      [(ast.AstType.Tuple types)
                        (match (lower-emit-arena-restore-marker-tuple
                          ctx
                          cur-state
                          env
                          (box-get types))
                          [(ResultLowerState.Ok next-state)
                            (set! cur-state next-state)]
                          [(ResultLowerState.Err message)
                            (begin
                              (set! result (ResultLowerState.Err message))
                              (set! done true))])]
                      [_ unit])
                    unit)))
              (if done
                unit
                (set! cur-env rest-env)))]))
      result)))

(define (lower-emit-active-loop-exits
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerState
  (lower-emit-active-loop-exits-with
    ctx
    (lower-cleanup-marker-id)
    (lower-region-reset-marker-id)
    (tc_core.tc-loop-target-id)
    state
    env
    type-env))

(define (lower-loop-control-form
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [origin : ast.AstExpr]
  [form : String]) : ResultLowerExpr
  (match (lower-current-loop-target ctx origin type-env form)
    [(ResultLowerLoopTarget.Ok target)
      (match target
        [(LowerLoopTarget.Target break-label continue-label)
          (match (lower-emit-active-loop-exits ctx state env type-env)
            [(ResultLowerState.Ok exit-state)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-state-emit-at-expr
                    exit-state
                    (ir.CompilerIrInstr.Jump
                      (if (string.eq form "break")
                        break-label
                        continue-label))
                    origin)
                  ir.CompilerIrValue.Unit
                  (ast.AstType.Never)))]
            [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerLoopTarget.Err message) (ResultLowerExpr.Err message)]))

(define (lower-return-form
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-current-return-type type-env)
    [(tc_core.ResultTcType.Ok return-ty)
      (match (lower-expr-expected ctx state env type-env value return-ty value)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr value-state value-ir _)
              (match (lower-prepare-internal-return-value
                ctx
                value-state
                env
                value-ir
                return-ty)
                [(ResultLowerExpr.Ok return-copy)
                  (match return-copy
                    [(LowerExpr.Expr return-state return-value _)
                      (match (lower-emit-active-exits
                        ctx
                        return-state
                        env
                        type-env)
                        [(ResultLowerState.Ok cleanup-state)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (lower-state-emit-at-expr
                                cleanup-state
                                (ir.CompilerIrInstr.Return
                                  (lower-return-maybe return-value return-ty))
                                origin)
                              ir.CompilerIrValue.Unit
                              (ast.AstType.Never)))]
                        [(ResultLowerState.Err message)
                          (ResultLowerExpr.Err message)])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(tc_core.ResultTcType.Err _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "typecheck: return requires enclosing function")))]))

(define (lower-load-single-payload
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match resolved
      [(ast.AstType.Unit)
        (LowerExpr.Expr state ir.CompilerIrValue.Unit resolved)]
      ;; A Result/Option payload (offset 8 past the i64 tag) can be an
      ;; inline struct/enum; materialize it via the inline-aware load.
      [_
        (lower-load-inline-value-at-offset
          ctx
          state
          base
          8
          resolved
          (lower-state-mode state))])))

(define (lower-result-info-variant-handle-or
  [ctx : tc_core.TcContext]
  [info : tc_core.TcResultInfo]
  [variant-id : i64]
  [fallback : i64]) : i64
  (let
    [enum-name-id : i64 (tc_core.tc-result-info-enum-id info)]
    [qualified-module-id : i64
      (tc_core.tc-qualified-name-module-id enum-name-id)]
    [module-id : i64
      (if (>= qualified-module-id 0)
        qualified-module-id
        (tc_core.tc-context-module-id ctx))]
    (if (or (< enum-name-id 0) (< variant-id 0))
      fallback
      (csym.compiler-registries-lookup-variant-key-id-or
        (tc_core.tc-context-registries ctx)
        (csym.compiler-symbol-module-key-id-by-id
          module-id
          (csym.compiler-enum-qualified-variant-name-id
            (tc_core.tc-qualified-name-base-id enum-name-id)
            variant-id))
        fallback))))

(define (lower-return-result-err
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [return-info : tc_core.TcResultInfo]
  [payload : ir.CompilerIrValue]) : ResultLowerState
  (match ctx
    [(tc_core.TcContext _ _ registries _ _ _ _ _ _)
      (let
        [enum-name-id : i64 (tc_core.tc-result-info-enum-id return-info)]
        [enum-name : String (tc_core.tc-nominal-name-id-display enum-name-id)]
        [err-id : i64 (tc_core.tc-result-info-err-id return-info)]
        [err-name : String
          (tc_core.tc-qualified-variant-name
            enum-name
            (tc_core.tc-env-key-name-text err-id))]
        [err-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-result-info-err-type return-info))]
        [handle : i64
          (lower-result-info-variant-handle-or
            ctx
            return-info
            err-id
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (lower-reserve-heap-storage
            state
            (lower-enum-storage-size ctx enum-name-id enum-name)
            (ast.AstType.Enum enum-name-id))
            [(LowerExpr.Expr base-state base _)
              (let
                [tag-state : LowerState
                  (lower-store-at-offset
                    base-state
                    base
                    0
                    (ir.CompilerIrValue.I64
                      (csym.compiler-registry-handle-child-index handle))
                    (ast.AstType.I64))]
                [payload-state : LowerState
                  (match err-ty
                    [(ast.AstType.Unit) tag-state]
                    ;; An inline struct/enum err payload must be
                    ;; byte-copied into the err slot, not scalar-stored.
                    [_
                      (lower-store-inline-value-at-offset
                        ctx
                        tag-state
                        base
                        8
                        payload
                        err-ty
                        (lower-type-size ctx err-ty))])]
                [ret-ty : ast.AstType (ast.AstType.Enum enum-name-id)]
                ;; When the function's result enum is register-resident
                ;; the caller reads the return value from registers, so load
                ;; the constructed enum back out of the buffer (word or
                ;; 2-word group) instead of returning the buffer pointer.
                (if (lower-type-register-resident? ctx ret-ty)
                  (match (lower-load-inline-value-at-offset
                    ctx
                    payload-state
                    base
                    0
                    ret-ty
                    (lower-state-mode payload-state))
                    [(LowerExpr.Expr loaded-state loaded _)
                      (ResultLowerState.Ok
                        (lower-state-emit
                          loaded-state
                          (ir.CompilerIrInstr.Return
                            (lower-return-maybe loaded ret-ty))))])
                  (ResultLowerState.Ok
                    (lower-state-emit
                      payload-state
                      (ir.CompilerIrInstr.Return
                        (lower-return-maybe base ret-ty))))))])
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " err-name))))))]))

;; The try tag/payload reads below address the operand as MEMORY. A
;; register-resident Result/Option (e.g. 16-byte (Ok i64)/(Err i64)) is carried
;; as word(s), so spill it to a temp inline slot first and continue with the
;; slot address; otherwise the tag load dereferences the packed value.
(define (lower-try-spill-resident-operand
  [ctx : tc_core.TcContext]
  [lowered : ResultLowerExpr]) : ResultLowerExpr
  (match lowered
    [(ResultLowerExpr.Ok expr)
      (match expr
        [(LowerExpr.Expr state value ty)
          (if (lower-type-register-resident? ctx ty)
            (match (lower-copy-inline-aggregate-to-inline ctx state value ty)
              [(ResultLowerExpr.Ok spilled)
                (match spilled
                  [(LowerExpr.Expr spill-state slot _)
                    (ResultLowerExpr.Ok (LowerExpr.Expr spill-state slot ty))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (ResultLowerExpr.Ok expr))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-try-finish
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [result-value : ir.CompilerIrValue]
  [operand-info : tc_core.TcResultInfo]
  [return-info : tc_core.TcResultInfo]
  [ok-label : i64]
  [err-label : i64]) : ResultLowerExpr
  (let
    [err-start : LowerState (lower-state-finish-block state err-label)]
    (match (lower-load-single-payload
      ctx
      err-start
      result-value
      (tc_core.tc-result-info-err-type operand-info))
      [(LowerExpr.Expr err-payload-state err-payload _)
        (match (lower-emit-active-exits ctx err-payload-state env type-env)
          [(ResultLowerState.Ok cleanup-state)
            (match (lower-return-result-err
              ctx
              cleanup-state
              return-info
              err-payload)
              [(ResultLowerState.Ok returned-state)
                (let
                  [ok-start : LowerState
                    (lower-state-finish-block returned-state ok-label)]
                  (match (lower-load-single-payload
                    ctx
                    ok-start
                    result-value
                    (tc_core.tc-result-info-ok-type operand-info))
                    [(LowerExpr.Expr ok-state ok-payload ok-ty)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr ok-state ok-payload ok-ty))]))]
              [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]
          [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])))

(define (lower-try-with-info
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [result-value : ir.CompilerIrValue]
  [operand-info : tc_core.TcResultInfo]
  [return-info : tc_core.TcResultInfo]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match ctx
    [(tc_core.TcContext _ _ registries _ _ _ _ _ _)
      (let
        [ok-id : i64 (tc_core.tc-result-info-ok-id operand-info)]
        [ok-name : String
          (tc_core.tc-qualified-variant-name
            (tc_core.tc-nominal-name-id-display
              (tc_core.tc-result-info-enum-id operand-info))
            (tc_core.tc-env-key-name-text ok-id))]
        [ok-handle : i64
          (lower-result-info-variant-handle-or
            ctx
            operand-info
            ok-id
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? ok-handle)
          (match (lower-load-at-offset state result-value 0 (ast.AstType.I64))
            [(LowerExpr.Expr tag-state tag-value _)
              (match (lower-state-alloc-var tag-state)
                [(LowerAlloc.Alloc eq-alloc eq-var)
                  (match (lower-state-fresh-label eq-alloc "try_ok")
                    [(LowerLabel.Label ok-label-state ok-label)
                      (match (lower-state-fresh-label ok-label-state "try_err")
                        [(LowerLabel.Label err-label-state err-label)
                          (let
                            [eq-state : LowerState
                              (lower-state-emit-at-expr
                                err-label-state
                                (ir.CompilerIrInstr.BinOp
                                  eq-var
                                  ir.CompilerIrBinOp.Eq
                                  tag-value
                                  (ir.CompilerIrValue.I64
                                    (csym.compiler-registry-handle-child-index
                                      ok-handle))
                                  (ast.AstType.I64))
                                origin)]
                            (lower-try-finish
                              ctx
                              (lower-state-emit
                                eq-state
                                (ir.CompilerIrInstr.Branch
                                  (ir.CompilerIrValue.Var eq-var)
                                  ok-label
                                  err-label))
                              env
                              type-env
                              result-value
                              operand-info
                              return-info
                              ok-label
                              err-label))])])])])
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (string.append "lower: unknown variant " ok-name))))))]))

(define (lower-try
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-try-spill-resident-operand
    ctx
    (lower-expr ctx state env type-env inner))
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr result-state result-value result-ty)
          (match (tc_core.tc-result-info ctx result-ty)
            [(tc_core.ResultTcResultInfo.Ok operand-info)
              (match (tc_core.tc-current-return-type type-env)
                [(tc_core.ResultTcType.Ok return-ty)
                  (match (tc_core.tc-result-info ctx return-ty)
                    [(tc_core.ResultTcResultInfo.Ok return-info)
                      (match (tc_core.tc-try-infos-compatible
                        operand-info
                        return-info)
                        [(tc_core.ResultTcUnit.Ok)
                          (lower-try-with-info
                            ctx
                            result-state
                            env
                            type-env
                            result-value
                            operand-info
                            return-info
                            origin)]
                        [(tc_core.ResultTcUnit.Err message)
                          (ResultLowerExpr.Err
                            (box (lower-diagnostic-at-expr origin message)))])]
                    [(tc_core.ResultTcResultInfo.Err _)
                      (ResultLowerExpr.Err
                        (box
                          (lower-diagnostic-at-expr
                            origin
                            "typecheck: try requires enclosing Result-like function")))])]
                [(tc_core.ResultTcType.Err _)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "typecheck: try requires enclosing Result-like function")))])]
            [(tc_core.ResultTcResultInfo.Err _)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "typecheck: try operand must be Result-like enum")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-top-level-value-defined-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (match ctx
    [(tc_core.TcContext _ symbols _ module module-id _ _ _ _)
      (csym.compiler-symbols-handle-found?
        (if (and
          (> (string.string-length module) 0)
          (not (tc_core.tc-name-qualified-id? name-id)))
          (csym.compiler-symbols-lookup-value-in-module-id-or
            symbols
            module-id
            name-id
            (csym.compiler-symbols-missing-handle))
          (csym.compiler-symbols-lookup-value-id-or
            symbols
            name-id
            (csym.compiler-symbols-missing-handle))))]))

(define (lower-top-level-callable-defined-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (match ctx
    [(tc_core.TcContext _ symbols _ module module-id _ _ _ _)
      (let
        [handle : i64
          (if (and
            (> (string.string-length module) 0)
            (not (tc_core.tc-name-qualified-id? name-id)))
            (csym.compiler-symbols-lookup-value-in-module-id-or
              symbols
              module-id
              name-id
              (csym.compiler-symbols-missing-handle))
            (csym.compiler-symbols-lookup-value-id-or
              symbols
              name-id
              (csym.compiler-symbols-missing-handle)))]
        (if (csym.compiler-symbols-handle-found? handle)
          (let
            [kind : i64 (csym.compiler-symbol-handle-kind handle)]
            (or
              (= kind (csym.compiler-symbol-kind-function-define))
              (= kind (csym.compiler-symbol-kind-extern))
              (= kind (csym.compiler-symbol-kind-defdispatch))))
          false))]))

(define (lower-top-level-callable-lookup-id?
  [ctx : tc_core.TcContext]
  [lookup-id : i64]) : bool
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        (tc_core.tc-context-symbols ctx)
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [kind : i64 (csym.compiler-symbol-handle-kind handle)]
        (or
          (= kind (csym.compiler-symbol-kind-function-define))
          (= kind (csym.compiler-symbol-kind-extern))
          (= kind (csym.compiler-symbol-kind-defdispatch))))
      false)))

(define (lower-callable-lookup-id
  [ctx : tc_core.TcContext]
  [source-id : i64]
  [lookup-id : i64]) : i64
  (match ctx
    [(tc_core.TcContext _ _ _ module module-id _ _ _ _)
      (if (and
        (> (string.string-length module) 0)
        (not (tc_core.tc-name-qualified-id? source-id))
        (lower-top-level-callable-defined-id? ctx source-id))
        (csym.compiler-symbol-module-key-id-by-id module-id source-id)
        lookup-id)]))

(define (lower-builtin-call-available-id?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]) : bool
  (and
    (not (sym_i64_env.sym-i64-contains-id env name-id))
    (not (lower-top-level-value-defined-id? ctx name-id))))

(define (lower-top-level-builtin-available-id?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : bool
  (if (cbi.compiler-builtin-private-intrinsic-id? name-id)
    (tc_core.tc-private-intrinsic-unshadowed-id? ctx type-env name-id)
    (not (lower-top-level-value-defined-id? ctx name-id))))

(define (lower-string-runtime-builtin? [name : String]) : bool
  (let
    [_ : String name]
    false))

;; First-class arena primitives. arena-mark/arena-rewind reuse the
;; existing region runtime (they snapshot/rewind the current arena's bump).
(define (lower-arena-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-arena-id? name-id))

(define (lower-arena-builtin-nullary-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-arena-nullary-id? name-id))

(define (lower-arena-builtin-symbol-id [name-id : i64]) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    (cond
      [(cbi.compiler-builtin-lower-arena-make-id? name-id)
        cbi.compiler-builtin-id-tl-arena-make]
      [(cbi.compiler-builtin-lower-arena-make-atomic-id? name-id)
        cbi.compiler-builtin-id-tl-arena-make-atomic]
      [(cbi.compiler-builtin-lower-arena-current-id? name-id)
        (lower-tl-arena-current-symbol)]
      [(cbi.compiler-builtin-lower-arena-mark-id? name-id)
        (lower-tl-region-mark-symbol)]
      [(cbi.compiler-builtin-lower-arena-set-id? name-id)
        (lower-tl-arena-set-symbol)]
      [(cbi.compiler-builtin-lower-arena-destroy-id? name-id)
        cbi.compiler-builtin-id-tl-arena-destroy]
      [else (lower-tl-region-reset-symbol)])))

(define (lower-arena-builtin-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-arena-builtin-nullary-id? name-id)
    (lower-runtime-call-values
      state
      (lower-arena-builtin-symbol-id name-id)
      ir.CompilerIrValueList.Nil
      result-ty)
    (if (= (struct-get (& args) len) 1)
      (let
        [arg : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
        (match (lower-expr ctx state env type-env arg)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr arg-state arg-value arg-ty)
                (match (lower-cast-value
                  arg-state
                  arg-value
                  arg-ty
                  (ast.AstType.I64))
                  [(LowerExpr.Expr cast-state cast-value _)
                    (lower-runtime-call-values
                      cast-state
                      (lower-arena-builtin-symbol-id name-id)
                      (ir.compiler-ir-value-cons
                        cast-value
                        ir.CompilerIrValueList.Nil)
                      result-ty)])])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: arena builtin expects one argument"))))))

(define (lower-tls-current-arena-read-call
  [state : LowerState]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 0)
    (lower-runtime-call-values
      state
      cbi.compiler-builtin-id-tl-tls-current-arena-load
      ir.CompilerIrValueList.Nil
      result-ty)
    (ResultLowerExpr.Err
      (box (lower-diagnostic "lower: tls-current-arena expects no arguments")))))

(define (lower-tls-current-arena-set-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (lower-expr ctx state env type-env arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state arg-value arg-ty)
              (match (lower-cast-value
                arg-state
                arg-value
                arg-ty
                (ast.AstType.I64))
                [(LowerExpr.Expr cast-state cast-value _)
                  (lower-runtime-call-values
                    cast-state
                    cbi.compiler-builtin-id-tl-tls-current-arena-store
                    (ir.compiler-ir-value-cons
                      cast-value
                      ir.CompilerIrValueList.Nil)
                    result-ty)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic
          "lower: tls-current-arena-set! expects exactly one argument")))))

(define (lower-tls-current-arena-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (cbi.compiler-builtin-lower-tls-current-arena-read-id? name-id)
    (lower-tls-current-arena-read-call state args result-ty)
    (lower-tls-current-arena-set-call ctx state env type-env args result-ty)))

(define (lower-float-sqrt-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (lower-expr-expected ctx state env type-env arg result-ty arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state arg-value _)
              (match (lower-state-alloc-var arg-state)
                [(LowerAlloc.Alloc allocated var-id)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-state-emit-at-expr
                        allocated
                        (ir.CompilerIrInstr.UnOp
                          var-id
                          (ir.CompilerIrUnOp.Sqrt)
                          arg-value
                          result-ty)
                        origin)
                      (ir.CompilerIrValue.Var var-id)
                      result-ty))])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic-at-expr
          origin
          "lower: __tl_float_sqrt expects exactly one argument")))))

(define (lower-float-literal-to-bits-value
  [lit : ast.AstLiteral]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerMaybeIrValue
  (match lit
    [(ast.AstLiteral.Float text)
      (if (lower-literal-float-to-bits? from-ty to-ty)
        (LowerMaybeIrValue.Some
          (ir.CompilerIrValue.I64
            (cast (lower-float-literal-bits text from-ty) : i64)))
        (LowerMaybeIrValue.No))]
    [_ (LowerMaybeIrValue.No)]))

(define (lower-float-bitcast-inner-literal-value
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerMaybeIrValue
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-float-bitcast-inner-literal-value
        ctx
        (lower-context-expr-get ctx inner-box)
        from-ty
        to-ty)]
    [(ast.AstExpr.Literal lit)
      (lower-float-literal-to-bits-value lit from-ty to-ty)]
    [_ (LowerMaybeIrValue.No)]))

(define (lower-float-bitcast-literal-value
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]
  [to-ty : ast.AstType]) : LowerMaybeIrValue
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-float-bitcast-literal-value
        ctx
        (lower-context-expr-get ctx inner-box)
        to-ty)]
    [(ast.AstExpr.Ann inner-box from-ty-id)
      (lower-float-bitcast-inner-literal-value
        ctx
        (lower-context-expr-get ctx inner-box)
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type
            ctx
            (tc_core.tc-context-type-get ctx from-ty-id)))
        to-ty)]
    [(ast.AstExpr.Cast inner-box from-ty-id)
      (lower-float-bitcast-inner-literal-value
        ctx
        (lower-context-expr-get ctx inner-box)
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type
            ctx
            (tc_core.tc-context-type-get ctx from-ty-id)))
        to-ty)]
    [(ast.AstExpr.Literal lit)
      (match (tc_core.tc-type-strip-region to-ty)
        [(ast.AstType.U32)
          (lower-float-literal-to-bits-value lit (ast.AstType.F32) to-ty)]
        [_ (lower-float-literal-to-bits-value lit (ast.AstType.F64) to-ty)])]
    [_ (LowerMaybeIrValue.No)]))

(define (lower-float-bitcast-literal-call?
  [ctx : tc_core.TcContext]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : bool
  (if (= (struct-get (& args) len) 1)
    (match (lower-float-bitcast-literal-value
      ctx
      (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))
      result-ty)
      [(LowerMaybeIrValue.Some _) true]
      [(LowerMaybeIrValue.No) false])
    false))

(define (lower-float-bitcast-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (lower-float-bitcast-literal-value ctx arg result-ty)
        [(LowerMaybeIrValue.Some value)
          ;; Mirror ordinary integer literal lowering: one integer `Mov`, no
          ;; float materialization or runtime `Bitcast`.
          (lower-materialize-at-expr state value result-ty origin)]
        [(LowerMaybeIrValue.No)
          (match (lower-expr ctx state env type-env arg)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr arg-state arg-value arg-ty)
                  (ResultLowerExpr.Ok
                    (lower-bitcast-value arg-state arg-value arg-ty result-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic-at-expr
          origin
          "lower: float bitcast expects exactly one argument")))))

;; Lower `(clone x)`: the canonical deep-copy / arena-escape. A String
;; copies its buffer through `tl_substring`; tuple, fixed-array, and dynamic-
;; array values allocate fresh storage and recursively clone each element; Box
;; values allocate a fresh box for the cloned inner value; named aggregates
;; dispatch to synthesized `clone$<Name>` helpers (compiler_clone.tl) so
;; recursive enum/struct values recurse at runtime instead of lower time; and
;; scalar values are returned as-is.
;; sret ABI: the synthesized `clone$<Name>` helper returns an aggregate,
;; so it carries the hidden sret param; append the result-slot pointer here to
;; match (the same gate as the helper's definition, so a non-aggregate clone$
;; target -- e.g. a type variable -- passes only the value).
(define (lower-clone-type-key-id [ctx : tc_core.TcContext] [name-id : i64]) : i64
  (let
    [fallback : i64
      (if (csym.compiler-composite-pair-key-id? name-id)
        name-id
        (clone_support.clone-name-key-id-in-module
          (tc_core.tc-context-module-id ctx)
          name-id))]
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc_core.tc-context-symbols ctx)
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (tc_core.tc-nominal-owner-id-or ctx handle fallback)
      fallback)))

(define (lower-clone-helper-lookup-id
  [type-key-id : i64]
  [helper-name-id : i64]) : i64
  (if (clone_support.clone-name-key-qualified? type-key-id)
    (csym.compiler-symbol-module-key-id-by-id
      (clone_support.clone-name-key-module-id type-key-id)
      helper-name-id)
    helper-name-id))

(define (lower-clone-named
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (let
    [requested-key-id : i64 (lower-clone-type-key-id ctx name-id)]
    [type-key-id : i64
      (lower-name-cache-clone-key-id (lower-state-names state) requested-key-id)]
    [helper-name-id : i64
      (if (< type-key-id 0)
        -1
        (lower-name-cache-clone-helper-id (lower-state-names state) type-key-id))]
    (if (< helper-name-id 0)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic
            (string.append
              "lower: missing generated clone helper for "
              (tc_core.tc-nominal-name-id-display name-id)))))
      (match (lower-call-append-sret-arg
        ctx
        state
        (ir.compiler-ir-value-cons value ir.CompilerIrValueList.Nil)
        ty)
        [(ResultLowerArgs.Ok sret-state sret-values)
          (match (lower-state-alloc-var sret-state)
            [(LowerAlloc.Alloc allocated var-id)
              (let
                [call-name : i64
                  (lower-resolve-call-name-id
                    allocated
                    env
                    (lower-clone-helper-lookup-id type-key-id helper-name-id))]
                (ResultLowerExpr.Ok
                  (LowerExpr.Expr
                    (lower-state-emit
                      allocated
                      (ir.CompilerIrInstr.Call
                        var-id
                        call-name
                        (ir.compiler-ir-call-args-from-list sret-values)
                        ty))
                    (ir.CompilerIrValue.Var var-id)
                    ty)))])]
        [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))))

(define (lower-clone-scalar-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Char) true]
    [(ast.AstType.Unit) true]
    [(ast.AstType.Never) true]
    [_ false]))

(define (lower-clone-bulk-copy-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [clone-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match clone-ty
      [(ast.AstType.Struct _) (lower-type-register-resident? ctx clone-ty)]
      [(ast.AstType.StructArgs _ _)
        (lower-type-register-resident? ctx clone-ty)]
      [(ast.AstType.Enum _) (lower-type-register-resident? ctx clone-ty)]
      [(ast.AstType.EnumArgs _ _) (lower-type-register-resident? ctx clone-ty)]
      [_ (lower-clone-scalar-type? clone-ty)])))

(define (lower-clone-type-list
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [types : ast.AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-clone-type-list-at ctx state env type-env src dst (& types) cursor 0))

(define (lower-clone-type-list-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [types : (& types ast.AstTypeList)]
  [cursor : i64]
  [index : i64]) : ResultLowerState
  (if (>= index (ast.ast-type-list-len types))
    (ResultLowerState.Ok state)
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [resolved : ast.AstType
        (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      [size : i64 (lower-type-size ctx resolved)]
      (if (> size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          resolved
          (lower-state-mode state))
          [(LowerExpr.Expr load-state field-value _)
            (match (lower-clone-dispatch
              ctx
              load-state
              env
              type-env
              field-value
              resolved)
              [(ResultLowerExpr.Ok cloned)
                (match cloned
                  [(LowerExpr.Expr clone-state clone-value _)
                    (lower-clone-type-list-at
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        clone-state
                        dst
                        offset
                        clone-value
                        resolved
                        size)
                      env
                      type-env
                      src
                      dst
                      types
                      (+ offset size)
                      (+ index 1))])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (lower-clone-type-list-at
          ctx
          state
          env
          type-env
          src
          dst
          types
          (+ offset size)
          (+ index 1))))))

(define (lower-clone-tuple-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [elem-tys : ast.AstTypeList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage
    state
    (lower-type-list-storage-size ctx elem-tys)
    result-ty)
    [(LowerExpr.Expr dst-state dst _)
      (match (lower-clone-type-list
        ctx
        dst-state
        env
        type-env
        value
        dst
        elem-tys
        0)
        [(ResultLowerState.Ok done-state)
          (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
        [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-clone-fixed-array-elems
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [index : i64]
  [count : i64]) : ResultLowerState
  (if (>= index count)
    (ResultLowerState.Ok state)
    (let
      [offset : i64 (* index elem-size)]
      (if (> elem-size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          elem-ty
          (lower-state-mode state))
          [(LowerExpr.Expr load-state elem-value _)
            (match (lower-clone-dispatch
              ctx
              load-state
              env
              type-env
              elem-value
              elem-ty)
              [(ResultLowerExpr.Ok cloned)
                (match cloned
                  [(LowerExpr.Expr clone-state clone-value _)
                    (lower-clone-fixed-array-elems
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        clone-state
                        dst
                        offset
                        clone-value
                        elem-ty
                        elem-size)
                      env
                      type-env
                      src
                      dst
                      elem-ty
                      elem-size
                      (+ index 1)
                      count)])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (lower-clone-fixed-array-elems
          ctx
          state
          env
          type-env
          src
          dst
          elem-ty
          elem-size
          (+ index 1)
          count)))))

(define (lower-clone-fixed-array-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [count : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    (match (lower-reserve-heap-storage
      state
      (lower-fixed-array-storage-size ctx elem-ty count)
      result-ty)
      [(LowerExpr.Expr dst-state dst _)
        (match (lower-clone-fixed-array-elems
          ctx
          dst-state
          env
          type-env
          value
          dst
          elem-ty
          elem-size
          0
          count)
          [(ResultLowerState.Ok done-state)
            (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
          [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])))

(define (lower-clone-dynarray-advance
  [state : LowerState]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc inc-alloc inc-var)
      (ResultLowerState.Ok
        (lower-state-finish-block
          (lower-state-emit
            (lower-state-emit
              (lower-state-emit
                inc-alloc
                (ir.CompilerIrInstr.BinOp
                  inc-var
                  ir.CompilerIrBinOp.Add
                  (ir.CompilerIrValue.Var index-var)
                  (ir.CompilerIrValue.I64 1)
                  (ast.AstType.I64)))
              (ir.CompilerIrInstr.Mov
                index-var
                (ir.CompilerIrValue.Var inc-var)
                (ast.AstType.I64)))
            (ir.CompilerIrInstr.Jump header-label))
          exit-label))]))

(define (lower-clone-dynarray-store-and-advance
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [new-buf : ir.CompilerIrValue]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]
  [clone-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    new-buf
    (ir.CompilerIrValue.Var index-var)
    elem-ty)
    [(LowerExpr.Expr dst-gep-state dst-ptr _)
      (lower-clone-dynarray-advance
        (lower-array-elem-store-state
          ctx
          dst-gep-state
          dst-ptr
          clone-value
          elem-ty)
        index-var
        header-label
        exit-label)]))

(define (lower-clone-dynarray-copy-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]
  [elem-ty : ast.AstType]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    old-buf
    (ir.CompilerIrValue.Var index-var)
    elem-ty)
    [(LowerExpr.Expr src-gep-state src-ptr _)
      (match (lower-load-inline-value-at-offset
        ctx
        src-gep-state
        src-ptr
        0
        elem-ty
        (lower-state-mode src-gep-state))
        [(LowerExpr.Expr load-state elem-value _)
          (match (lower-clone-dispatch
            ctx
            load-state
            env
            type-env
            elem-value
            elem-ty)
            [(ResultLowerExpr.Ok cloned)
              (match cloned
                [(LowerExpr.Expr clone-state clone-value _)
                  (lower-clone-dynarray-store-and-advance
                    ctx
                    clone-state
                    new-buf
                    index-var
                    header-label
                    exit-label
                    clone-value
                    elem-ty)])]
            [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])]))

(define (lower-clone-dynarray-copy-nonempty
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : ResultLowerState
  (match (lower-state-fresh-label state "clone_array_header")
    [(LowerLabel.Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "clone_array_body")
        [(LowerLabel.Label body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "clone_array_exit")
            [(LowerLabel.Label exit-label-state exit-label)
              (match (lower-state-alloc-var exit-label-state)
                [(LowerAlloc.Alloc index-alloc index-var)
                  (let
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            index-alloc
                            (ir.CompilerIrInstr.Mov
                              index-var
                              (ir.CompilerIrValue.I64 0)
                              (ast.AstType.I64)))
                          (ir.CompilerIrInstr.Jump header-label))
                        header-label)]
                    (match (lower-state-alloc-var header-start)
                      [(LowerAlloc.Alloc cond-alloc cond-var)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                (lower-state-emit
                                  cond-alloc
                                  (ir.CompilerIrInstr.BinOp
                                    cond-var
                                    ir.CompilerIrBinOp.Lt
                                    (ir.CompilerIrValue.Var index-var)
                                    len
                                    (ast.AstType.I64)))
                                (ir.CompilerIrInstr.Branch
                                  (ir.CompilerIrValue.Var cond-var)
                                  body-label
                                  exit-label))
                              body-label)]
                          (lower-clone-dynarray-copy-body
                            ctx
                            body-start
                            env
                            type-env
                            old-buf
                            new-buf
                            index-var
                            header-label
                            exit-label
                            elem-ty))]))])])])]))

(define (lower-clone-dynarray-copy-loop
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [byte-count : ir.CompilerIrValue]) : ResultLowerState
  (if (= elem-size 0)
    (ResultLowerState.Ok state)
    (if (lower-clone-bulk-copy-type? ctx elem-ty)
      (ResultLowerState.Ok
        (lower-emit-memcpy-value state new-buf 0 old-buf 0 byte-count))
      (lower-clone-dynarray-copy-nonempty
        ctx
        state
        env
        type-env
        old-buf
        new-buf
        len
        elem-ty))))

(define (lower-clone-dynarray-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [old-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [byte-count : ir.CompilerIrValue]
  [buf-var : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 result-ty)
    [(LowerExpr.Expr arr-state arr-value _)
      (match (lower-clone-dynarray-copy-loop
        ctx
        arr-state
        env
        type-env
        old-buf
        (ir.CompilerIrValue.Var buf-var)
        len
        elem-ty
        elem-size
        byte-count)
        [(ResultLowerState.Ok copied-state)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-store-at-offset
                (lower-store-at-offset
                  copied-state
                  arr-value
                  0
                  (ir.CompilerIrValue.Var buf-var)
                  (ast.AstType.U64))
                arr-value
                8
                len
                (ast.AstType.I64))
              arr-value
              result-ty))]
        [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-clone-dynarray-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-load-at-offset state value 8 (ast.AstType.I64))
    [(LowerExpr.Expr len-state len _)
      (match (lower-load-at-offset len-state value 0 (ast.AstType.U64))
        [(LowerExpr.Expr ptr-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            (match (if (= elem-size 0)
              (LowerExpr.Expr
                ptr-state
                (ir.CompilerIrValue.I64 1)
                (ast.AstType.I64))
              (lower-emit-binop
                ptr-state
                ir.CompilerIrBinOp.Mul
                len
                (ir.CompilerIrValue.I64 elem-size)
                (ast.AstType.I64)))
              [(LowerExpr.Expr byte-state byte-count _)
                (match (lower-state-alloc-var byte-state)
                  [(LowerAlloc.Alloc buf-alloc buf-var)
                    (lower-clone-dynarray-finish
                      ctx
                      (lower-state-emit
                        buf-alloc
                        (ir.CompilerIrInstr.Call
                          buf-var
                          (lower-tl-alloc-symbol)
                          (ir.CompilerIrCallArgs.One byte-count)
                          (ast.AstType.U64)))
                      env
                      type-env
                      old-buf
                      len
                      elem-ty
                      elem-size
                      byte-count
                      buf-var
                      result-ty)])]))])]))

(define (lower-clone-box-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [inner-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  ;; A (Box T) with inline struct/enum T addresses the T storage at the
  ;; box pointer; load it as a value (pointer) rather than scalar-loading the
  ;; leading word, mirroring lower-box-get.
  (match (lower-load-inline-value-at-offset
    ctx
    state
    value
    0
    inner-ty
    (lower-state-mode state))
    [(LowerExpr.Expr load-state inner-value _)
      (match (lower-clone-dispatch
        ctx
        load-state
        env
        type-env
        inner-value
        inner-ty)
        [(ResultLowerExpr.Ok cloned)
          (match cloned
            [(LowerExpr.Expr clone-state clone-value _)
              (match (lower-reserve-heap-storage
                clone-state
                (lower-type-size ctx inner-ty)
                result-ty)
                [(LowerExpr.Expr box-state box-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-store-inline-value-at-offset
                        ctx
                        box-state
                        box-value
                        0
                        clone-value
                        inner-ty
                        (lower-type-size ctx inner-ty))
                      box-value
                      result-ty))])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-clone-dispatch
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (let
    [clone-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match clone-ty
      [(ast.AstType.String) (lower-capture-snapshot-string-value state value)]
      [(ast.AstType.Tuple elem-tys)
        (lower-clone-tuple-value
          ctx
          state
          env
          type-env
          value
          (box-get elem-tys)
          clone-ty)]
      [(ast.AstType.Array elem-ty count)
        (lower-clone-fixed-array-value
          ctx
          state
          env
          type-env
          value
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx elem-ty))
          count
          clone-ty)]
      [(ast.AstType.DynArray elem-ty)
        (lower-clone-dynarray-value
          ctx
          state
          env
          type-env
          value
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx elem-ty))
          clone-ty)]
      [(ast.AstType.Box elem-ty)
        (lower-clone-box-value
          ctx
          state
          env
          type-env
          value
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx elem-ty))
          clone-ty)]
      ;; A register-resident aggregate is word-class POD held in a
      ;; register, so cloning it is a value copy -- no deep-clone helper, no
      ;; memory traversal.
      [(ast.AstType.Enum name)
        (if (lower-type-register-resident? ctx clone-ty)
          (ResultLowerExpr.Ok (LowerExpr.Expr state value clone-ty))
          (lower-clone-named ctx state env name value clone-ty))]
      [(ast.AstType.Struct name)
        (if (lower-type-register-resident? ctx clone-ty)
          (ResultLowerExpr.Ok (LowerExpr.Expr state value clone-ty))
          (lower-clone-named ctx state env name value clone-ty))]
      [(ast.AstType.Var name)
        (lower-clone-named ctx state env name value clone-ty)]
      [_
        (if (lower-clone-scalar-type? clone-ty)
          (ResultLowerExpr.Ok (LowerExpr.Expr state value clone-ty))
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: clone unsupported type "
                  (tc_core.tc-type-render clone-ty))))))])))

(define (lower-clone-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arg)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr arg-state arg-value arg-ty)
          (lower-clone-dispatch ctx arg-state env type-env arg-value arg-ty)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-call-explicit-mut-borrow-var-id
  [ctx : tc_core.TcContext]
  [arg : ast.AstExpr]) : tc_core.TcMaybeNameId
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.Borrow mutable _ place-box)
      (if mutable
        (match (ast.ast-expr-unspan (lower-context-expr-get ctx place-box))
          [(ast.AstExpr.Var name) (tc_core.TcMaybeNameId.Some name)]
          [_ (tc_core.TcMaybeNameId.No)])
        (tc_core.TcMaybeNameId.No))]
    [_ (tc_core.TcMaybeNameId.No)]))

;; Pack a borrowed fixed-array reference into the structural Slice ABI group.
;; The source expression is lowered exactly once; word0 is its data pointer and
;; word1 is the compile-time fixed length.  This helper is called only after
;; the typechecker has accepted the closed call-only unsize predicate.
(define (lower-call-array-ref-to-slice-pack
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [expected : ast.AstType]
  [actual : ast.AstType]) : ResultLowerExpr
  (let
    [actual-resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx actual))]
    [array-len : i64
      (match actual-resolved
        [(ast.AstType.Ref _ inner)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx inner)))
            [(ast.AstType.Array _ count) count]
            [_ -1])]
        [(ast.AstType.MutRef _ inner)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx inner)))
            [(ast.AstType.Array _ count) count]
            [_ -1])]
        [_ -1])]
    (if (< array-len 0)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            arg
            "lower: Slice unsize requires fixed-array reference")))
      (match (lower-expr-expected
        ctx
        state
        env
        type-env
        arg
        (tc_core.tc-type-without-regions actual)
        arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state value value-ty)
              (match (lower-emit-cast
                arg-state
                value
                value-ty
                (ast.AstType.U64))
                [(LowerExpr.Expr cast-state ptr _)
                  (ResultLowerExpr.Ok
                    (lower-emit-pack
                      cast-state
                      (ir.compiler-ir-value-cons
                        ptr
                        (ir.compiler-ir-value-cons
                          (ir.CompilerIrValue.I64 array-len)
                          ir.CompilerIrValueList.Nil))
                      (tc_core.tc-type-without-regions expected)))])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))

(define (lower-call-arg-normal-basic
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [effective-arg : ast.AstExpr]
  [arg-ty : ast.AstType]) : ResultLowerCallArg
  (match (lower-expr-expected ctx state env type-env effective-arg arg-ty arg)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr arg-state value _)
          (ResultLowerCallArg.Ok
            (LowerCallArg.Arg arg-state value (LowerMaybeArgWriteback.No)))])]
    [(ResultLowerExpr.Err message) (ResultLowerCallArg.Err message)]))

;; The type fact recorded for an explicit borrow can be contextualized to the
;; Slice formal by the time lowering runs, so it no longer describes the
;; borrowed place's fixed-array referent. Recover that provenance only on the
;; Slice-formal path. Other argument forms retain the ordinary fact lookup,
;; which is needed for variables that already hold an Array or Slice reference.
(define (lower-call-slice-formal-actual-type
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [effective-arg : ast.AstExpr]) : tc_core.ResultTcType
  (match (ast.ast-expr-unspan effective-arg)
    [(ast.AstExpr.Borrow mutable _ place-box)
      (let
        [place-expr : ast.AstExpr (lower-context-expr-get ctx place-box)]
        (match (tc_core.tc-borrow-place
          ctx
          (tc_core.tc-context-expr-bases ctx)
          type-env
          place-expr)
          [(tc_core.ResultTcBorrowPlace.Ok place)
            (match place
              [(tc_core.TcBorrowPlace lifetime referent-ty)
                (tc_core.ResultTcType.Ok
                  (if mutable
                    (ast.ast-ty-mut-ref-with-pools
                      (tc_core.tc-context-pools ctx)
                      lifetime
                      referent-ty)
                    (ast.ast-ty-ref-with-pools
                      (tc_core.tc-context-pools ctx)
                      lifetime
                      referent-ty)))])]
          [(tc_core.ResultTcBorrowPlace.Err message)
            (tc_core.ResultTcType.Err message)]))]
    [_ (tc_core.tc-call-arg-expr-type ctx type-env effective-arg)]))

(define (lower-call-arg-normal-as
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [effective-arg : ast.AstExpr]
  [arg-ty : ast.AstType]) : ResultLowerCallArg
  (let
    [disarmed-state : LowerState
      (lower-disarm-move-aware-resource-expr state env effective-arg)]
    (if (tc_core.tc-call-slice-ref-formal? ctx arg-ty)
      (match (lower-call-slice-formal-actual-type ctx type-env effective-arg)
        [(tc_core.ResultTcType.Ok actual-ty)
          (if (tc_core.tc-call-array-ref-to-slice-ref-compatible?
            ctx
            arg-ty
            actual-ty)
            (match (lower-call-array-ref-to-slice-pack
              ctx
              disarmed-state
              env
              type-env
              effective-arg
              arg-ty
              actual-ty)
              [(ResultLowerExpr.Ok packed)
                (match packed
                  [(LowerExpr.Expr packed-state value _)
                    (ResultLowerCallArg.Ok
                      (LowerCallArg.Arg
                        packed-state
                        value
                        (LowerMaybeArgWriteback.No)))])]
              [(ResultLowerExpr.Err message) (ResultLowerCallArg.Err message)])
            (lower-call-arg-normal-basic
              ctx
              disarmed-state
              env
              type-env
              arg
              effective-arg
              arg-ty))]
        [(tc_core.ResultTcType.Err _)
          (lower-call-arg-normal-basic
            ctx
            disarmed-state
            env
            type-env
            arg
            effective-arg
            arg-ty)])
      (lower-call-arg-normal-basic
        ctx
        disarmed-state
        env
        type-env
        arg
        effective-arg
        arg-ty))))

(define (lower-call-arg-mut-borrow-var-as
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [effective-arg : ast.AstExpr]
  [arg-ty : ast.AstType]
  [name-id : i64]) : ResultLowerCallArg
  (match (tc_core.tc-lookup-id type-env name-id)
    [(tc_core.ResultTcType.Ok place-ty)
      (let
        [referent-ty : ast.AstType (tc_core.tc-borrow-referent-type place-ty)]
        [referent-ir-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx referent-ty))]
        (if (or
          (tc_core.tc-type-contains-reference? place-ty)
          (lower-borrow-place-value-reference? ctx referent-ty))
          (lower-call-arg-normal-as
            ctx
            state
            env
            type-env
            arg
            effective-arg
            arg-ty)
          (let
            [local-id : i64
              (sym_i64_env.sym-i64-lookup-id-or
                env
                name-id
                (csym.compiler-symbols-missing-handle))]
            (if (csym.compiler-symbols-handle-found? local-id)
              (match (lower-borrow-copy-to-inline-storage
                ctx
                state
                (ir.CompilerIrValue.Var local-id)
                referent-ir-ty
                arg-ty)
                [(LowerExpr.Expr arg-state storage _)
                  (ResultLowerCallArg.Ok
                    (LowerCallArg.Arg
                      arg-state
                      storage
                      (LowerMaybeArgWriteback.Some
                        (LowerArgWriteback.Writeback
                          local-id
                          storage
                          referent-ir-ty
                          arg))))])
              (lower-call-arg-normal-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty)))))]
    [(tc_core.ResultTcType.Err _)
      (lower-call-arg-normal-as ctx state env type-env arg effective-arg arg-ty)]))

(define (lower-call-arg-as
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [expected : ast.AstType]
  [arg-ty : ast.AstType]) : ResultLowerCallArg
  (match (tc_core.tc-call-effective-arg-expr ctx type-env arg expected)
    [(tc_core.ResultTcExpr.Ok effective-arg)
      (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx arg-ty))
        [(ast.AstType.MutRef _ _)
          (match (lower-call-explicit-mut-borrow-var-id ctx effective-arg)
            [(tc_core.TcMaybeNameId.Some name-id)
              (lower-call-arg-mut-borrow-var-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty
                name-id)]
            [(tc_core.TcMaybeNameId.No)
              (lower-call-arg-normal-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty)])]
        [_
          (lower-call-arg-normal-as
            ctx
            state
            env
            type-env
            arg
            effective-arg
            arg-ty)])]
    [(tc_core.ResultTcExpr.Err message)
      (ResultLowerCallArg.Err (box (lower-diagnostic-at-expr arg message)))]))

;; Arguments lower left-to-right, so append each writeback before recurring.
;; This preserves post-call writeback order without a prepend/copy pass.
(define (lower-call-arg-writebacks-push-maybe
  [writebacks : (&mut writebacks lower_arg_writeback_vec.Vec)]
  [maybe-writeback : LowerMaybeArgWriteback]) : unit
  (match maybe-writeback
    [(LowerMaybeArgWriteback.No) unit]
    [(LowerMaybeArgWriteback.Some writeback)
      (lower_arg_writeback_vec.push writebacks writeback)]))

(define (lower-call-args-as
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]) : ResultLowerCallArgs
  (lower-call-args-as-at
    ctx
    state
    env
    type-env
    (& args)
    (& types)
    0
    (lower_arg_writeback_vec.new)))

(define (lower-call-args-as-at
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [writebacks : lower_arg_writeback_vec.Vec (:consume)]) : ResultLowerCallArgs
  (if (>= index (struct-get args len))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerCallArgs.Ok
        state
        ir.CompilerIrValueList.Nil
        (LowerArgWritebacks.Some writebacks))
      (ResultLowerCallArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerCallArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [arg : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [expected-id : i64
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))]
        [expected : ast.AstType
          (ast.ast-type-strip-consuming-param-with-pools
            (tc_core.tc-context-pools ctx)
            (tc_core.tc-context-type-get ctx expected-id))]
        [arg-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx expected))]
        (match (lower-call-arg-as ctx state env type-env arg expected arg-ty)
          [(ResultLowerCallArg.Ok lowered-arg)
            (match lowered-arg
              [(LowerCallArg.Arg arg-state value maybe-writeback)
                (let
                  [next-writebacks : lower_arg_writeback_vec.Vec writebacks]
                  (begin
                    (lower-call-arg-writebacks-push-maybe
                      (&mut next-writebacks)
                      maybe-writeback)
                    (match (lower-call-args-as-at
                      ctx
                      arg-state
                      env
                      type-env
                      args
                      types
                      (+ index 1)
                      next-writebacks)
                      [(ResultLowerCallArgs.Ok
                          rest-state
                          rest-values
                          rest-writebacks)
                        (ResultLowerCallArgs.Ok
                          rest-state
                          (ir.compiler-ir-value-cons value rest-values)
                          rest-writebacks)]
                      [(ResultLowerCallArgs.Err message)
                        (ResultLowerCallArgs.Err message)])))])]
          [(ResultLowerCallArg.Err message) (ResultLowerCallArgs.Err message)])))))

(define (lower-apply-arg-writeback
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [writeback : LowerArgWriteback]) : LowerState
  (match writeback
    [(LowerArgWriteback.Writeback local-id storage referent-ty origin)
      (match (lower-load-register-resident-from-ptr
        ctx
        state
        storage
        referent-ty)
        [(LowerExpr.Expr load-state loaded _)
          (lower-state-emit-at-expr
            load-state
            (ir.CompilerIrInstr.Mov local-id loaded referent-ty)
            origin)])]))

(define lower-arg-writeback-fallback : LowerArgWriteback
  (LowerArgWriteback.Writeback
    0
    (ir.CompilerIrValue.I64 0)
    (ast.AstType.I64)
    (ast.AstExpr.Literal (ast.ast-lit-int 0))))

(define (lower-apply-arg-writebacks
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [writebacks : LowerArgWritebacks]) : LowerState
  (match writebacks
    [(LowerArgWritebacks.None) state]
    [(LowerArgWritebacks.Some items)
      (let
        [count : i64 (lower_arg_writeback_vec.len (& items))]
        [index : i64 0]
        [out : LowerState state]
        (begin
          (while (< index count)
            (begin
              (set!
                out
                (lower-apply-arg-writeback
                  ctx
                  out
                  (lower_arg_writeback_vec.get
                    (& items)
                    index
                    (lower-global-shared-view lower-arg-writeback-fallback))))
              (set! index (+ index 1))))
          out))]))

(define (lower-bootstrap-runtime-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-bootstrap-runtime-id? name-id))

(define (lower-args-as
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]) : ResultLowerArgs
  (lower-args-as-at ctx state env type-env (& args) (& types) 0))

(define (lower-args-as-at
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index (struct-get args len))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerArgs.Ok state ir.CompilerIrValueList.Nil)
      (ResultLowerArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [arg : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [expected-id : i64
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))]
        [expected : ast.AstType
          (ast.ast-type-strip-consuming-param-with-pools
            (tc_core.tc-context-pools ctx)
            (tc_core.tc-context-type-get ctx expected-id))]
        [arg-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx expected))]
        (match (tc_core.tc-call-effective-arg-expr ctx type-env arg expected)
          [(tc_core.ResultTcExpr.Ok effective-arg)
            (match (lower-expr-expected
              ctx
              (lower-disarm-move-aware-resource-expr state env effective-arg)
              env
              type-env
              effective-arg
              arg-ty
              arg)
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr arg-state value _)
                    (match (lower-args-as-at
                      ctx
                      arg-state
                      env
                      type-env
                      args
                      types
                      (+ index 1))
                      [(ResultLowerArgs.Ok rest-state rest-values)
                        (ResultLowerArgs.Ok
                          rest-state
                          (ir.compiler-ir-value-cons value rest-values))]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerArgs.Err message)])])]
              [(ResultLowerExpr.Err message) (ResultLowerArgs.Err message)])]
          [(tc_core.ResultTcExpr.Err message)
            (ResultLowerArgs.Err (box (lower-diagnostic-at-expr arg message)))])))))

;; Mutable-reference formals need call-aware lowering for writebacks, while
;; borrowed Slice formals need it for the closed call-local unsize path.
(define (lower-call-type-list-needs-call-aware-args?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : bool
  (lower-call-type-list-needs-call-aware-args-at? ctx (& types) 0))

(define (lower-call-type-list-needs-call-aware-args-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (let
      [head : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (match (tc_core.tc-type-strip-region head)
        [(ast.AstType.MutRef _ _) true]
        [_
          (if (tc_core.tc-call-slice-ref-formal? ctx head)
            true
            (lower-call-type-list-needs-call-aware-args-at?
              ctx
              types
              (+ index 1)))]))))

(define (lower-call-args-as-needed
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]) : ResultLowerCallArgs
  (if (lower-call-type-list-needs-call-aware-args? ctx types)
    (lower-call-args-as ctx state env type-env args types)
    (match (lower-args-as ctx state env type-env args types)
      [(ResultLowerArgs.Ok args-state values)
        (ResultLowerCallArgs.Ok args-state values (LowerArgWritebacks.None))]
      [(ResultLowerArgs.Err message) (ResultLowerCallArgs.Err message)])))

(define (lower-construct-struct-inline-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [struct-name : String]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstFieldDefList]
  [struct-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-inline-aggregate-layout-for-id
    ctx
    (lower-struct-type-name-id-or struct-ty -1))
    [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(tc_core.TcInlineAggregateLayout.Struct size _ _)
          ;; A register-resident struct is built directly in registers by
          ;; packing its fields with shift/or; no stack slot, no stores. A 2-word
          ;; struct packs each word and combines them with IrInstrPack.
          (if (tc_core.tc-inline-aggregate-layout-register-resident? layout)
            (if (lower-type-register-group? ctx struct-ty)
              (lower-construct-struct-register-group
                ctx
                state
                values
                fields
                layout
                struct-ty)
              (match (lower-pack-inline-struct-values
                ctx
                state
                (ir.CompilerIrValue.I64 0)
                (ast.AstType.I64)
                values
                fields
                layout)
                [(ResultLowerExpr.Ok packed)
                  (match packed
                    [(LowerExpr.Expr packed-state packed-value packed-ty)
                      (match (lower-materialize-register-word
                        packed-state
                        packed-value
                        packed-ty
                        (lower-register-word-type ctx struct-ty 0))
                        [(LowerExpr.Expr word-state word-value _)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr word-state word-value struct-ty))])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
            (match (lower-reserve-inline-storage state size struct-ty)
              [(LowerExpr.Expr base-state base _)
                (match (lower-store-inline-struct-values
                  ctx
                  base-state
                  base
                  values
                  fields
                  layout)
                  [(ResultLowerState.Ok done-state)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr done-state base struct-ty))]
                  [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))]
        [(tc_core.TcInlineAggregateLayout.Enum _ _ _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for struct is enum "
                  struct-name))))])]
    [(tc_core.ResultTcInlineAggregateLayout.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic message)))]))

;; TWO-PHASE CONSTRUCTOR LOWERING -- THE ORDER IS LOAD-BEARING (issue #5971).
;;
;; Every `-into` path in this family materializes ALL constructor arguments to
;; values first (`lower-args-as` / `lower-args-as-at` runs to completion) and
;; only then writes the tag and payload bytes of `dst`. That order is what makes
;; writing straight into an sret slot or a `set!` place correct WITHOUT any
;; alias analysis, because of three properties of by-value aggregates:
;;
;;   1. a by-value aggregate argument is passed as a bare POINTER, with no
;;      caller-side copy (the call site moves the address, never the bytes);
;;   2. passing an aggregate by value does not move it out of the caller: the
;;      move checker accepts the caller's continued use of it afterwards, and
;;      only the local binding form is a hard move error;
;;   3. the type checker rejects writes through storage derived from a
;;      memory-class by-value parameter, so it is read-only through that path.
;;
;; The hidden sret slot still carries NO `noalias` guarantee against arguments
;; of the same call: accumulator threading (`acc = (f acc x)`, tail recursion)
;; can make a call site's result slot the next iteration's argument pointer.
;; Interleaving destination writes with argument evaluation MISCOMPILES whenever
;; `dst` aliases an argument. A prior full destination-forwarding version here
;; (-282 `tl_memcpy` call sites) broke stage1 in `tc-name-id-list-add`; keep the
;; source order explicit.
;;
;; Destination forwarding belongs in `compiler_optimize.tl`, where the whole
;; window is visible and the alias side condition can actually be discharged --
;; see the `ctor_fwd` pass (`opt-ctor-fwd-*`) and its guard.
(define (lower-construct-struct-inline-into-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstFieldDefList]) : ResultLowerState
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx struct-id)
    [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(tc_core.TcInlineAggregateLayout.Struct _ _ _)
          (lower-store-inline-struct-values ctx state dst values fields layout)]
        [(tc_core.TcInlineAggregateLayout.Enum _ _ _)
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for struct is enum "
                  struct-name))))])]
    [(tc_core.ResultTcInlineAggregateLayout.Err message)
      (ResultLowerState.Err (box (lower-diagnostic message)))]))

(define (lower-construct-enum-inline-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [variant-name : String]
  [handle : i64]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstTypeList]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-inline-aggregate-layout-for-id
    ctx
    (lower-enum-type-name-id-or enum-ty -1))
    [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(tc_core.TcInlineAggregateLayout.Enum size _ _)
          ;; A 1-word register-resident enum is nullary, so its single word
          ;; is the discriminant tag. A 2-word register-group enum packs the tag
          ;; into word0 and the variant payload into word1.
          (if (tc_core.tc-inline-aggregate-layout-register-resident? layout)
            ;; A register-resident enum is 8 (nullary tag) or 16 bytes (tag
            ;; word0 + payload word1); derive the 2-word group case from the size we
            ;; already have rather than rebuilding the layout (lower-type-register-
            ;; group?), whose transient per-call allocation -- summed over every
            ;; construct/match/bind site during the per-function scratch arena
            ;; window -- was heavy enough to overflow the scratch arena into a
            ;; second chunk and trip its rewind, corrupting later lowering.
            (if (= size 16)
              (lower-construct-enum-register-group
                ctx
                state
                handle
                values
                fields
                enum-ty)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  state
                  (ir.CompilerIrValue.I64
                    (csym.compiler-registry-handle-child-index handle))
                  enum-ty)))
            (let
              [layout-variant-name : String
                (lower-member-name-base variant-name)]
              [layout-variant-name-id : i64
                (match (csym.compiler-registries-variant-name-id-indexed
                  (tc_core.tc-context-symbols ctx)
                  handle)
                  [(option_i64.Some name-id) name-id]
                  [(option_i64.None) -1])]
              (match (lower-reserve-inline-storage state size enum-ty)
                [(LowerExpr.Expr base-state base _)
                  (let
                    [tag-state : LowerState
                      (lower-store-at-offset
                        base-state
                        base
                        0
                        (ir.CompilerIrValue.I64
                          (csym.compiler-registry-handle-child-index handle))
                        (ast.AstType.I64))]
                    (match (lower-store-inline-payload-values
                      ctx
                      tag-state
                      base
                      values
                      fields
                      layout
                      layout-variant-name
                      layout-variant-name-id
                      0)
                      [(ResultLowerState.Ok done-state)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr done-state base enum-ty))]
                      [(ResultLowerState.Err message)
                        (ResultLowerExpr.Err message)]))])))]
        [(tc_core.TcInlineAggregateLayout.Struct _ _ _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for enum is struct "
                  enum-name))))])]
    [(tc_core.ResultTcInlineAggregateLayout.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic message)))]))

(define (lower-construct-enum-inline-into-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [values : ir.CompilerIrValueList]
  [fields : ast.AstTypeList]
  [enum-id : i64]
  [enum-name : String]) : ResultLowerState
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx enum-id)
    [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(tc_core.TcInlineAggregateLayout.Enum _ _ _)
          (let
            [layout-variant-name : String (lower-member-name-base variant-name)]
            [layout-variant-name-id : i64
              (match (csym.compiler-registries-variant-name-id-indexed
                (tc_core.tc-context-symbols ctx)
                handle)
                [(option_i64.Some name-id) name-id]
                [(option_i64.None) -1])]
            [tag-state : LowerState
              (lower-store-at-offset
                state
                dst
                0
                (ir.CompilerIrValue.I64
                  (csym.compiler-registry-handle-child-index handle))
                (ast.AstType.I64))]
            (lower-store-inline-payload-values
              ctx
              tag-state
              dst
              values
              fields
              layout
              layout-variant-name
              layout-variant-name-id
              0))]
        [(tc_core.TcInlineAggregateLayout.Struct _ _ _)
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for enum is struct "
                  enum-name))))])]
    [(tc_core.ResultTcInlineAggregateLayout.Err message)
      (ResultLowerState.Err (box (lower-diagnostic message)))]))

(define (lower-enum-constructor-fields-for-result
  [ctx : tc_core.TcContext]
  [enum-ty : ast.AstType]
  [fields : ast.AstTypeList]) : ast.AstTypeList
  (match enum-ty
    [(ast.AstType.EnumArgs enum-id lifetimes)
      (match (tc_core.tc-lifetime-subst-from-nominal-args-id
        ctx
        enum-id
        (box-get lifetimes))
        [(tc_core.ResultTcLifetimeSubst.Ok subst)
          (tc_core.tc-lifetime-subst-type-list subst fields)]
        [(tc_core.ResultTcLifetimeSubst.Err _) fields])]
    [(ast.AstType.VarArgs enum-id lifetimes)
      (match (tc_core.tc-lifetime-subst-from-nominal-args-id
        ctx
        enum-id
        (box-get lifetimes))
        [(tc_core.ResultTcLifetimeSubst.Ok subst)
          (tc_core.tc-lifetime-subst-type-list subst fields)]
        [(tc_core.ResultTcLifetimeSubst.Err _) fields])]
    [_ fields]))

(define (lower-variant-payload-fields-for-handle
  [ctx : tc_core.TcContext]
  [handle : i64]
  [resolved-scrut-ty : ast.AstType]
  [fields : ast.AstTypeList]) : ast.AstTypeList
  (let
    [field-ctx : tc_core.TcContext
      (tc_core.tc-context-with-nominal-owner-handle-module
        ctx
        (csym.compiler-registry-variant-owner-handle handle))]
    (tc_core.tc-resolve-type-list
      field-ctx
      (lower-enum-constructor-fields-for-result
        field-ctx
        resolved-scrut-ty
        fields))))

(define (lower-construct-enum-with-name
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [variant-name : String]
  [handle : i64]
  [args : ast.AstExprList]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerExpr
  (match ctx
    [(tc_core.TcContext _ symbols _ _ _ _ _ _ _)
      (match (csym.compiler-registries-variant-fields-indexed symbols handle)
        [(parser.ResultAstTypeList.Ok fields)
          (let
            [field-ctx : tc_core.TcContext
              (tc_core.tc-context-with-nominal-owner-handle-module ctx handle)]
            [resolved-fields : ast.AstTypeList
              (tc_core.tc-resolve-type-list
                field-ctx
                (lower-enum-constructor-fields-for-result
                  field-ctx
                  enum-ty
                  fields))]
            (match (lower-args-as ctx state env type-env args resolved-fields)
              [(ResultLowerArgs.Ok args-state values)
                (if (lower-mode-inline-aggregates?
                  (lower-state-mode args-state))
                  (lower-construct-enum-inline-from-values
                    ctx
                    args-state
                    variant-name
                    handle
                    values
                    resolved-fields
                    enum-name
                    enum-ty)
                  (if (ast.ast-type-list-empty? (& resolved-fields))
                    (match (csym.compiler-registries-variant-name-id-indexed
                      symbols
                      handle)
                      [(option_i64.Some _)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            args-state
                            (ir.CompilerIrValue.GlobalAddr
                              (lower-nullary-variant-object-symbol
                                enum-name
                                variant-name))
                            enum-ty))]
                      [(option_i64.None)
                        (ResultLowerExpr.Err
                          (box
                            (lower-diagnostic
                              "lower: variant handle has no source name")))])
                    (let
                      [size : i64
                        (lower-variant-fields-storage-size ctx resolved-fields)]
                      (match (lower-reserve-heap-storage
                        args-state
                        size
                        enum-ty)
                        [(LowerExpr.Expr base-state base _)
                          (let
                            [tag-state : LowerState
                              (lower-store-at-offset
                                base-state
                                base
                                0
                                (ir.CompilerIrValue.I64
                                  (csym.compiler-registry-handle-child-index
                                    handle))
                                (ast.AstType.I64))]
                            (match (lower-store-values
                              ctx
                              tag-state
                              base
                              values
                              resolved-fields
                              8)
                              [(ResultLowerState.Ok done-state)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr done-state base enum-ty))]
                              [(ResultLowerState.Err message)
                                (ResultLowerExpr.Err message)]))]))))]
              [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))]
        [(parser.ResultAstTypeList.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic message)))])]))

(define (lower-construct-enum-with-handle
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [variant-name : String]
  [handle : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [enum-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx result-ty))]
    (match enum-ty
      [(ast.AstType.Enum enum-name)
        (lower-construct-enum-with-name
          ctx
          state
          env
          type-env
          variant-name
          handle
          args
          (tc_core.tc-nominal-name-id-display enum-name)
          enum-ty)]
      [(ast.AstType.EnumArgs enum-name _)
        (lower-construct-enum-with-name
          ctx
          state
          env
          type-env
          variant-name
          handle
          args
          (tc_core.tc-nominal-name-id-display enum-name)
          enum-ty)]
      [_
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic
              (string.append
                "lower: enum constructor result is not enum: "
                variant-name))))])))

;; Two-phase order (arguments first, destination bytes second) is load-bearing
;; here too -- see the #5971 note at `lower-construct-struct-inline-into-from-values`.
(define (lower-construct-enum-with-name-into
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [args : ast.AstExprList]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerState
  (match ctx
    [(tc_core.TcContext _ symbols _ _ _ _ _ _ _)
      (match (csym.compiler-registries-variant-fields-indexed symbols handle)
        [(parser.ResultAstTypeList.Ok fields)
          (let
            [field-ctx : tc_core.TcContext
              (tc_core.tc-context-with-nominal-owner-handle-module ctx handle)]
            [resolved-fields : ast.AstTypeList
              (tc_core.tc-resolve-type-list
                field-ctx
                (lower-enum-constructor-fields-for-result
                  field-ctx
                  enum-ty
                  fields))]
            (match (lower-args-as ctx state env type-env args resolved-fields)
              [(ResultLowerArgs.Ok args-state values)
                (if (lower-mode-inline-aggregates?
                  (lower-state-mode args-state))
                  (lower-construct-enum-inline-into-from-values
                    ctx
                    args-state
                    dst
                    variant-name
                    handle
                    values
                    resolved-fields
                    (lower-enum-type-name-id-or enum-ty -1)
                    enum-name)
                  (ResultLowerState.Err
                    (box
                      (lower-diagnostic
                        "lower: enum destination construction requires inline aggregates"))))]
              [(ResultLowerArgs.Err message) (ResultLowerState.Err message)]))]
        [(parser.ResultAstTypeList.Err message)
          (ResultLowerState.Err (box (lower-diagnostic message)))])]))

;; Two-phase order (arguments first, destination bytes second) is load-bearing
;; here too -- see the #5971 note at `lower-construct-struct-inline-into-from-values`.
(define (lower-construct-enum-with-handle-into
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerState
  (let
    [enum-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx result-ty))]
    (match enum-ty
      [(ast.AstType.Enum enum-name)
        (lower-construct-enum-with-name-into
          ctx
          state
          env
          type-env
          dst
          variant-name
          handle
          args
          (tc_core.tc-nominal-name-id-display enum-name)
          enum-ty)]
      [(ast.AstType.EnumArgs enum-name _)
        (lower-construct-enum-with-name-into
          ctx
          state
          env
          type-env
          dst
          variant-name
          handle
          args
          (tc_core.tc-nominal-name-id-display enum-name)
          enum-ty)]
      [_
        (ResultLowerState.Err
          (box
            (lower-diagnostic
              (string.append
                "lower: enum constructor result is not enum: "
                variant-name))))])))

(define (lower-struct-constructor-field-types-for-result
  [ctx : tc_core.TcContext]
  [struct-ty : ast.AstType]
  [fields : ast.AstFieldDefList]) : ast.AstTypeList
  (let
    [field-types : ast.AstTypeList (tc_core.tc-field-type-list ctx fields)]
    (match struct-ty
      [(ast.AstType.StructArgs struct-id lifetimes)
        (match (tc_core.tc-lifetime-subst-from-nominal-args-id
          ctx
          struct-id
          (box-get lifetimes))
          [(tc_core.ResultTcLifetimeSubst.Ok subst)
            (tc_core.tc-lifetime-subst-type-list subst field-types)]
          [(tc_core.ResultTcLifetimeSubst.Err _) field-types])]
      [(ast.AstType.VarArgs struct-id lifetimes)
        (match (tc_core.tc-lifetime-subst-from-nominal-args-id
          ctx
          struct-id
          (box-get lifetimes))
          [(tc_core.ResultTcLifetimeSubst.Ok subst)
            (tc_core.tc-lifetime-subst-type-list subst field-types)]
          [(tc_core.ResultTcLifetimeSubst.Err _) field-types])]
      [_ field-types])))

(define (lower-context-with-nominal-owner-module-id
  [ctx : tc_core.TcContext]
  [nominal-id : i64]) : tc_core.TcContext
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc_core.tc-context-symbols ctx)
        nominal-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [module-id : i64
          (csym.compiler-symbols-owner-module-id-at-index-or
            (tc_core.tc-context-symbols ctx)
            (csym.compiler-symbol-handle-index handle)
            cbi.compiler-builtin-id-fix-empty)]
        (if (>= module-id 0)
          (tc_core.tc-context-with-module-id
            ctx
            (ci.intern-str module-id)
            module-id)
          (tc_core.tc-context-with-module-id
            ctx
            ""
            cbi.compiler-builtin-id-fix-empty)))
      (if (tc_core.tc-name-qualified-id? nominal-id)
        (let
          [module-id : i64 (tc_core.tc-qualified-name-module-id nominal-id)]
          (tc_core.tc-context-with-module-id
            ctx
            (ci.intern-str module-id)
            module-id))
        ctx))))

(define (lower-construct-struct
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [struct-name : String]
  [struct-handle : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  ;; Field annotations are scoped to the declaring module. Resolve them there
  ;; before lowering arguments or storage so a dotted imported aggregate keeps
  ;; the layout of its nested nominal fields.
  (let
    [result-struct-id : i64 (lower-struct-type-name-id-or result-ty -1)]
    [struct-id : i64
      (if (csym.compiler-symbols-handle-found? struct-handle)
        (tc_core.tc-nominal-owner-id-or ctx struct-handle result-struct-id)
        result-struct-id)]
    [field-ctx : tc_core.TcContext
      (if (csym.compiler-symbols-handle-found? struct-handle)
        (tc_core.tc-context-with-nominal-owner-handle-module ctx struct-handle)
        (lower-context-with-nominal-owner-module-id ctx struct-id))]
    (match (if (csym.compiler-symbols-handle-found? struct-handle)
      (lower-struct-fields-at-handle field-ctx struct-handle struct-name)
      (lower-struct-fields-id field-ctx struct-id struct-name))
      [(parser.ResultAstFieldDefList.Ok fields)
        (let
          [struct-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx result-ty))]
          [field-types : ast.AstTypeList
            (tc_core.tc-resolve-type-list
              field-ctx
              (lower-struct-constructor-field-types-for-result
                field-ctx
                struct-ty
                fields))]
          (match (lower-args-as ctx state env type-env args field-types)
            [(ResultLowerArgs.Ok args-state values)
              (if (lower-mode-inline-aggregates? (lower-state-mode args-state))
                (lower-construct-struct-inline-from-values
                  field-ctx
                  args-state
                  struct-name
                  values
                  fields
                  struct-ty)
                (if (lower-struct-repr-c-id? field-ctx struct-id)
                  (match (tc_core.tc-repr-c-struct-layout-id
                    field-ctx
                    struct-name
                    struct-id)
                    [(tc_core.ResultTcReprCLayout.Ok layout)
                      (match (lower-reserve-heap-storage
                        args-state
                        (tc_core.tc-repr-c-layout-size layout)
                        struct-ty)
                        [(LowerExpr.Expr base-state base _)
                          (match (lower-store-repr-c-values
                            field-ctx
                            base-state
                            base
                            values
                            (tc_core.tc-repr-c-layout-fields layout))
                            [(ResultLowerState.Ok done-state)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr done-state base struct-ty))]
                            [(ResultLowerState.Err message)
                              (ResultLowerExpr.Err message)])])]
                    [(tc_core.ResultTcReprCLayout.Err message)
                      (ResultLowerExpr.Err (box (lower-diagnostic message)))])
                  (let
                    [size : i64
                      (lower-type-list-storage-size field-ctx field-types)]
                    (match (lower-reserve-heap-storage
                      args-state
                      size
                      struct-ty)
                      [(LowerExpr.Expr base-state base _)
                        (match (lower-store-values
                          field-ctx
                          base-state
                          base
                          values
                          field-types
                          0)
                          [(ResultLowerState.Ok done-state)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr done-state base struct-ty))]
                          [(ResultLowerState.Err message)
                            (ResultLowerExpr.Err message)])]))))]
            [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))]
      [(parser.ResultAstFieldDefList.Err message)
        (ResultLowerExpr.Err (box (lower-diagnostic message)))])))

;; Two-phase order (arguments first, destination bytes second) is load-bearing
;; here too -- see the #5971 note at `lower-construct-struct-inline-into-from-values`.
(define (lower-construct-struct-into
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [struct-name : String]
  [struct-handle : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerState
  (let
    [result-struct-id : i64 (lower-struct-type-name-id-or result-ty -1)]
    [struct-id : i64
      (if (csym.compiler-symbols-handle-found? struct-handle)
        (tc_core.tc-nominal-owner-id-or ctx struct-handle result-struct-id)
        result-struct-id)]
    [field-ctx : tc_core.TcContext
      (if (csym.compiler-symbols-handle-found? struct-handle)
        (tc_core.tc-context-with-nominal-owner-handle-module ctx struct-handle)
        (lower-context-with-nominal-owner-module-id ctx struct-id))]
    (match (if (csym.compiler-symbols-handle-found? struct-handle)
      (lower-struct-fields-at-handle field-ctx struct-handle struct-name)
      (lower-struct-fields-id field-ctx struct-id struct-name))
      [(parser.ResultAstFieldDefList.Ok fields)
        (let
          [struct-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx result-ty))]
          [field-types : ast.AstTypeList
            (tc_core.tc-resolve-type-list
              field-ctx
              (lower-struct-constructor-field-types-for-result
                field-ctx
                struct-ty
                fields))]
          (match (lower-args-as ctx state env type-env args field-types)
            [(ResultLowerArgs.Ok args-state values)
              (if (lower-mode-inline-aggregates? (lower-state-mode args-state))
                (lower-construct-struct-inline-into-from-values
                  field-ctx
                  args-state
                  dst
                  struct-id
                  struct-name
                  values
                  fields)
                (ResultLowerState.Err
                  (box
                    (lower-diagnostic
                      "lower: struct destination construction requires inline aggregates"))))]
            [(ResultLowerArgs.Err message) (ResultLowerState.Err message)]))]
      [(parser.ResultAstFieldDefList.Err message)
        (ResultLowerState.Err (box (lower-diagnostic message)))])))

(define (lower-init-expr-list-from-types
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : ast.AstExprList
  (lower-init-expr-list-from-types-at ctx (& types) 0))

(define (lower-init-expr-list-from-types-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstExprList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-expr-list-new)
    (let
      [head : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (ast.ast-expr-cons
        (ast.ast-expr-init head)
        (lower-init-expr-list-from-types-at ctx types (+ index 1))))))

(define (lower-init-expr-list-repeat [ty : ast.AstType] [count : i64]) : ast.AstExprList
  (if (<= count 0)
    (ast.ast-expr-list-new)
    (ast.ast-expr-cons
      (ast.ast-expr-init ty)
      (lower-init-expr-list-repeat ty (- count 1)))))

(define (lower-init-scalar
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (lower-materialize-at-expr state value ty origin))

(define (lower-init-struct
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [struct-name : String]
  [struct-ty : ast.AstType]) : ResultLowerExpr
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-struct-type-name-id-or struct-ty -1))]
    (if (lower-struct-repr-c-id?
      field-ctx
      (lower-struct-type-name-id-or struct-ty -1))
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic "lower: init supports only default-layout structs")))
      (match (lower-struct-fields-id
        field-ctx
        (lower-struct-type-name-id-or struct-ty -1)
        struct-name)
        [(parser.ResultAstFieldDefList.Ok fields)
          (let
            [field-types : ast.AstTypeList
              (tc_core.tc-resolve-type-list
                field-ctx
                (lower-struct-constructor-field-types-for-result
                  field-ctx
                  struct-ty
                  fields))]
            (lower-construct-struct
              ctx
              state
              env
              type-env
              struct-name
              (lower-struct-type-handle-or
                ctx
                struct-ty
                (csym.compiler-symbols-missing-handle))
              (lower-init-expr-list-from-types ctx field-types)
              struct-ty))]
        [(parser.ResultAstFieldDefList.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic message)))]))))

(define (lower-init-enum
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerExpr
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-enum-type-name-id-or enum-ty -1))]
    (match (tc_core.tc-enum-decl-id
      field-ctx
      (lower-enum-type-name-id-or enum-ty -1))
      [(tc_core.ResultTcEnumDecl.Ok decl)
        (match decl
          [(tc_core.TcEnumDecl _ variants)
            (if (ast.ast-variant-def-list-empty? (& variants))
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic
                    "lower: init requires enum with at least one variant")))
              (let
                [variant : ast.AstVariantDef
                  (ast.ast-variant-def-list-get
                    (& variants)
                    0
                    (ast.ast-variant-def-fallback))]
                (match variant
                  [(ast.AstVariantDef.Def variant-name fields _)
                    (let
                      [lookup-name : String
                        (tc_core.tc-variant-name-for-enum
                          enum-name
                          (tc_core.tc-env-key-name-text variant-name))]
                      [payload-types : ast.AstTypeList
                        (tc_core.tc-resolve-type-list
                          field-ctx
                          (lower-enum-constructor-fields-for-result
                            field-ctx
                            enum-ty
                            fields))]
                      [handle : i64
                        (lower-variant-constructor-handle-id-or
                          ctx
                          (tc_core.tc-env-key-name-text variant-name)
                          variant-name
                          enum-ty
                          (csym.compiler-symbols-missing-handle))]
                      (if (csym.compiler-symbols-handle-found? handle)
                        (lower-construct-enum-with-name
                          ctx
                          state
                          env
                          type-env
                          lookup-name
                          handle
                          (lower-init-expr-list-from-types ctx payload-types)
                          enum-name
                          enum-ty)
                        (ResultLowerExpr.Err
                          (box
                            (lower-diagnostic
                              (string.append
                                "lower: unknown variant "
                                lookup-name))))))])))])]
      [(tc_core.ResultTcEnumDecl.Err message)
        (ResultLowerExpr.Err (box (lower-diagnostic message)))])))

(define (lower-init-struct-into
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [struct-name : String]
  [struct-ty : ast.AstType]) : ResultLowerState
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-struct-type-name-id-or struct-ty -1))]
    (if (lower-struct-repr-c-id?
      field-ctx
      (lower-struct-type-name-id-or struct-ty -1))
      (ResultLowerState.Err
        (box
          (lower-diagnostic "lower: init supports only default-layout structs")))
      (match (lower-struct-fields-id
        field-ctx
        (lower-struct-type-name-id-or struct-ty -1)
        struct-name)
        [(parser.ResultAstFieldDefList.Ok fields)
          (let
            [field-types : ast.AstTypeList
              (tc_core.tc-resolve-type-list
                field-ctx
                (lower-struct-constructor-field-types-for-result
                  field-ctx
                  struct-ty
                  fields))]
            (lower-construct-struct-into
              ctx
              state
              env
              type-env
              dst
              struct-name
              (lower-struct-type-handle-or
                ctx
                struct-ty
                (csym.compiler-symbols-missing-handle))
              (lower-init-expr-list-from-types ctx field-types)
              struct-ty))]
        [(parser.ResultAstFieldDefList.Err message)
          (ResultLowerState.Err (box (lower-diagnostic message)))]))))

(define (lower-init-enum-into
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerState
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-enum-type-name-id-or enum-ty -1))]
    (match (tc_core.tc-enum-decl-id
      field-ctx
      (lower-enum-type-name-id-or enum-ty -1))
      [(tc_core.ResultTcEnumDecl.Ok decl)
        (match decl
          [(tc_core.TcEnumDecl _ variants)
            (if (ast.ast-variant-def-list-empty? (& variants))
              (ResultLowerState.Err
                (box
                  (lower-diagnostic
                    "lower: init requires enum with at least one variant")))
              (let
                [variant : ast.AstVariantDef
                  (ast.ast-variant-def-list-get
                    (& variants)
                    0
                    (ast.ast-variant-def-fallback))]
                (match variant
                  [(ast.AstVariantDef.Def variant-name fields _)
                    (let
                      [lookup-name : String
                        (tc_core.tc-variant-name-for-enum
                          enum-name
                          (tc_core.tc-env-key-name-text variant-name))]
                      [payload-types : ast.AstTypeList
                        (tc_core.tc-resolve-type-list
                          field-ctx
                          (lower-enum-constructor-fields-for-result
                            field-ctx
                            enum-ty
                            fields))]
                      [handle : i64
                        (lower-variant-constructor-handle-id-or
                          ctx
                          (tc_core.tc-env-key-name-text variant-name)
                          variant-name
                          enum-ty
                          (csym.compiler-symbols-missing-handle))]
                      (if (csym.compiler-symbols-handle-found? handle)
                        (lower-construct-enum-with-name-into
                          ctx
                          state
                          env
                          type-env
                          dst
                          lookup-name
                          handle
                          (lower-init-expr-list-from-types ctx payload-types)
                          enum-name
                          enum-ty)
                        (ResultLowerState.Err
                          (box
                            (lower-diagnostic
                              (string.append
                                "lower: unknown variant "
                                lookup-name))))))])))])]
      [(tc_core.ResultTcEnumDecl.Err message)
        (ResultLowerState.Err (box (lower-diagnostic message)))])))

(define (lower-init-expr-into
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerState
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match resolved
      [(ast.AstType.Struct name)
        (lower-init-struct-into
          ctx
          state
          env
          type-env
          dst
          (tc_core.tc-nominal-name-id-display name)
          resolved)]
      [(ast.AstType.StructArgs name _)
        (lower-init-struct-into
          ctx
          state
          env
          type-env
          dst
          (tc_core.tc-nominal-name-id-display name)
          resolved)]
      [(ast.AstType.Enum name)
        (lower-init-enum-into
          ctx
          state
          env
          type-env
          dst
          (tc_core.tc-nominal-name-id-display name)
          resolved)]
      [(ast.AstType.EnumArgs name _)
        (lower-init-enum-into
          ctx
          state
          env
          type-env
          dst
          (tc_core.tc-nominal-name-id-display name)
          resolved)]
      [_
        (ResultLowerState.Err
          (box
            (lower-diagnostic-at-expr
              origin
              (string.append
                "lower: init unsupported type "
                (tc_core.tc-type-render resolved)))))])))

(define (lower-init-expr
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [ty : ast.AstType]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (if (tc_core.tc-integer-type? resolved)
      (lower-init-scalar state (ir.CompilerIrValue.I64 0) expr-ty origin)
      (match resolved
        [(ast.AstType.F64)
          (lower-init-scalar
            state
            (ir.CompilerIrValue.F64
              (lower-float-literal-bits "0.0" (ast.AstType.F64)))
            expr-ty
            origin)]
        [(ast.AstType.F32)
          (lower-init-scalar
            state
            (ir.CompilerIrValue.F64
              (lower-float-literal-bits "0.0" (ast.AstType.F32)))
            expr-ty
            origin)]
        [(ast.AstType.Bool)
          (lower-init-scalar
            state
            (ir.CompilerIrValue.Bool false)
            expr-ty
            origin)]
        [(ast.AstType.Char)
          (lower-init-scalar
            state
            (ir.CompilerIrValue.Char '\0')
            expr-ty
            origin)]
        [(ast.AstType.Unit)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr state ir.CompilerIrValue.Unit expr-ty))]
        [(ast.AstType.String)
          (lower-init-scalar
            state
            (ir.CompilerIrValue.String "")
            expr-ty
            origin)]
        [(ast.AstType.Ptr _)
          (match (lower-materialize
            state
            (ir.CompilerIrValue.I64 0)
            (ast.AstType.U64))
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr null-state null-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr null-state null-value expr-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
        [(ast.AstType.MutPtr _)
          (match (lower-materialize
            state
            (ir.CompilerIrValue.I64 0)
            (ast.AstType.U64))
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr null-state null-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr null-state null-value expr-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
        [(ast.AstType.DynArray elem)
          (lower-make-array-from-len
            ctx
            state
            env
            type-env
            (tc_core.tc-context-type-get ctx elem)
            (ir.CompilerIrValue.I64 0)
            (ast.AstType.I64)
            (ast.AstExpr.Literal (ast.ast-lit-int 0))
            origin)]
        [(ast.AstType.Box elem)
          (lower-box ctx state env type-env (ast.AstExpr.Init elem) expr-ty)]
        [(ast.AstType.Tuple elems)
          (lower-tuple
            ctx
            state
            env
            type-env
            (lower-init-expr-list-from-types ctx (box-get elems))
            expr-ty
            origin)]
        [(ast.AstType.Array elem count)
          (if (< count 0)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic
                  "lower: init fixed array length must be non-negative")))
            (lower-array-literal
              ctx
              state
              env
              type-env
              (lower-init-expr-list-repeat
                (tc_core.tc-context-type-get ctx elem)
                count)
              expr-ty
              origin))]
        [(ast.AstType.Struct name)
          (lower-init-struct
            ctx
            state
            env
            type-env
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(ast.AstType.StructArgs name _)
          (lower-init-struct
            ctx
            state
            env
            type-env
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(ast.AstType.Enum name)
          (lower-init-enum
            ctx
            state
            env
            type-env
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(ast.AstType.EnumArgs name _)
          (lower-init-enum
            ctx
            state
            env
            type-env
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (string.append
                  "lower: init unsupported type "
                  (tc_core.tc-type-render resolved)))))]))))

(define (lower-nullary-variant-result-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [_ false]))

(define (lower-nullary-variant-or-function-value
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-nullary-variant-result-type? expr-ty)
    (let
      [lookup-name : String
        (lower-variant-constructor-lookup-name ctx name raw-name-id expr-ty)]
      [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols ctx)]
      [handle : i64
        (lower-variant-constructor-handle-id-or
          ctx
          name
          raw-name-id
          expr-ty
          (csym.compiler-symbols-missing-handle))]
      (if (csym.compiler-symbols-handle-found? handle)
        (match (csym.compiler-registries-variant-fields-indexed symbols handle)
          [(parser.ResultAstTypeList.Ok fields)
            (if (ast.ast-type-list-empty? (& fields))
              (lower-construct-enum-with-handle
                ctx
                state
                env
                type-env
                lookup-name
                handle
                (ast.ast-expr-list-new)
                expr-ty)
              (lower-function-value-or-var-id
                ctx
                state
                env
                lookup-name-id
                expr-ty))]
          [(parser.ResultAstTypeList.Err _)
            (lower-function-value-or-var-id
              ctx
              state
              env
              lookup-name-id
              expr-ty)])
        (lower-function-value-or-var-id ctx state env lookup-name-id expr-ty)))
    (lower-function-value-or-var-id ctx state env lookup-name-id expr-ty)))

;; A register-group GLOBAL stores its two words inline at the symbol; a
;; read of it yields `CompilerIrValue.Global name` (the storage), which must be
;; materialized into a register-group VALUE by loading both words from the
;; symbol's address. Local group vars (CompilerIrValue.Var) and non-group values pass
;; through unchanged.
(define (lower-materialize-group-global
  [ctx : tc_core.TcContext]
  [result : ResultLowerExpr]) : ResultLowerExpr
  (match result
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr s v t)
          (match v
            [(ir.CompilerIrValue.Global name)
              (if (lower-type-register-group? ctx t)
                (match (lower-load-group-from-ptr
                  ctx
                  s
                  (ir.CompilerIrValue.GlobalAddr name)
                  t)
                  [(LowerExpr.Expr ls lv _)
                    (ResultLowerExpr.Ok (LowerExpr.Expr ls lv t))])
                (ResultLowerExpr.Ok lowered))]
            [_ (ResultLowerExpr.Ok lowered)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-var-or-nullary-variant-id
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  ;; Mirror lower-var-or-nullary-variant -- a register-group GLOBAL read
  ;; yields CompilerIrValue.Global and must be materialized into a group VALUE (load both
  ;; words) before any CompilerIrInstr.Word/struct-get/match extraction; main's interned
  ;; -id path dropped this wrapper, so reg-group globals faulted.
  (lower-materialize-group-global
    ctx
    (if (sym_i64_env.sym-i64-contains-id env name-id)
      (lower-var-id-storage-aware ctx state env name-id expr-ty)
      (let
        [name : String
          (ci.intern-str
            (tc_core.macro-hygiene-global-source-name-id-or name-id name-id))]
        (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
          ctx
          type-env
          name
          name-id
          true)
          [(tc_core.TcNameLookup.Ok lookup-name lookup-name-id)
            (lower-nullary-variant-or-function-value
              ctx
              state
              env
              type-env
              lookup-name
              name-id
              lookup-name-id
              expr-ty)]
          [(tc_core.TcNameLookup.Err message)
            (ResultLowerExpr.Err (box (lower-diagnostic message)))])))))

(define (lower-call-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : tc_core.ResultTcType
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var name)
      (let
        [source-id : i64
          (tc_core.macro-hygiene-global-source-name-id-or name name)]
        (if (and
          (cbi.compiler-builtin-lower-clone-id? source-id)
          (= (struct-get (& args) len) 1))
          (lower-expr-result-type-fast
            ctx
            env
            type-env
            type-cache
            (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0)))
          (match (lower-lookup-type-id ctx type-cache env type-env name)
            [(tc_core.ResultTcType.Ok fn-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx fn-ty))
                [(ast.AstType.Func _ ret)
                  (tc_core.ResultTcType.Ok
                    (tc_core.tc-type-without-regions
                      (tc_core.tc-resolve-type
                        ctx
                        (tc_core.tc-context-type-get ctx ret))))]
                [(ast.AstType.Enum _)
                  (tc_core.ResultTcType.Ok
                    (tc_core.tc-type-without-regions fn-ty))]
                [_
                  (tc_core.ResultTcType.Err
                    "lower: call result type is not fast-pathable")])]
            [(tc_core.ResultTcType.Err message)
              (if (lower-builtin-call-available-id? ctx env source-id)
                (cond
                  [(cbi.compiler-builtin-lower-length-call-id? source-id)
                    (tc_core.ResultTcType.Ok (ast.AstType.I64))]
                  [(cbi.compiler-builtin-lower-string-ref-call-id? source-id)
                    (tc_core.ResultTcType.Ok (ast.AstType.Char))]
                  [(cbi.compiler-builtin-lower-clone-id? source-id)
                    (if (= (struct-get (& args) len) 1)
                      (lower-expr-result-type-fast
                        ctx
                        env
                        type-env
                        type-cache
                        (lower-context-expr-get
                          ctx
                          (ast.ast-expr-list-get (& args) 0 0)))
                      (tc_core.ResultTcType.Err
                        "lower: call result type is not fast-pathable"))]
                  [else (tc_core.ResultTcType.Err message)])
                (tc_core.ResultTcType.Err message))])))]
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (tc_core.tc-lambda-expr-allow-ref-captures
              ctx
              type-env
              params
              maybe-ret
              body)
              [(tc_core.ResultTcType.Ok fn-ty)
                (match fn-ty
                  [(ast.AstType.Func _ ret)
                    (tc_core.ResultTcType.Ok
                      (tc_core.tc-type-without-regions
                        (tc_core.tc-resolve-type
                          ctx
                          (tc_core.tc-context-type-get ctx ret))))]
                  [_
                    (tc_core.ResultTcType.Err
                      "lower: call result type is not fast-pathable")])]
              [(tc_core.ResultTcType.Err message)
                (tc_core.ResultTcType.Err message)]))])]
    [_
      (tc_core.ResultTcType.Err "lower: call result type is not fast-pathable")]))

(define (lower-binary-result-type-fast
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : tc_core.ResultTcType
  (match (tc_core.tc-binop-expr-types ctx type-env op left right)
    [(tc_core.ResultTcBinOpTypes.Ok binop-types)
      (match binop-types
        [(tc_core.TcBinOpTypes _ _ result-ty)
          (tc_core.ResultTcType.Ok
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx result-ty)))])]
    [(tc_core.ResultTcBinOpTypes.Err message)
      (tc_core.ResultTcType.Err message)]))

(define (lower-binop-types-with-result
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]
  [expr-ty : ast.AstType]) : tc_core.ResultTcBinOpTypes
  (let
    [operand-expected : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx expr-ty))]
    (match (tc_core.tc-binop-contextual-operand-type op operand-expected)
      [(ast.AstMaybeType.No)
        (tc_core.tc-binop-expr-types ctx type-env op left right)]
      [(ast.AstMaybeType.Some operand-ty)
        (match (tc_core.tc-expr-with-expected-or-actual
          ctx
          type-env
          left
          operand-ty)
          [(tc_core.ResultTcType.Ok left-ty)
            (match (tc_core.tc-expr-with-expected-or-actual
              ctx
              type-env
              right
              operand-ty)
              [(tc_core.ResultTcType.Ok right-ty)
                (match (tc_core.tc-binop-type op left-ty right-ty)
                  [(tc_core.ResultTcType.Ok result-ty)
                    (if (tc_core.tc-type-compatible? expr-ty result-ty)
                      (tc_core.ResultTcBinOpTypes.Ok
                        (tc_core.TcBinOpTypes
                          left-ty
                          right-ty
                          (tc_core.tc-contextual-result-type expr-ty result-ty)))
                      (tc_core.tc-binop-expr-types ctx type-env op left right))]
                  [(tc_core.ResultTcType.Err _)
                    (tc_core.tc-binop-expr-types ctx type-env op left right)])]
              [(tc_core.ResultTcType.Err message)
                (tc_core.ResultTcBinOpTypes.Err message)])]
          [(tc_core.ResultTcType.Err message)
            (tc_core.ResultTcBinOpTypes.Err message)])])))

(define (lower-unop-type-with-result
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstUnOp]
  [inner : ast.AstExpr]
  [expr-ty : ast.AstType]) : tc_core.ResultTcType
  (let
    [operand-expected : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx expr-ty))]
    (match (tc_core.tc-unop-contextual-operand-type op operand-expected)
      [(ast.AstMaybeType.No)
        (match (tc_core.tc-expr ctx type-env inner)
          [(tc_core.ResultTcType.Ok inner-ty)
            (tc_core.tc-unop-type op inner-ty)]
          [(tc_core.ResultTcType.Err message)
            (tc_core.ResultTcType.Err message)])]
      [(ast.AstMaybeType.Some operand-ty)
        (match (tc_core.tc-expr-with-expected-or-actual
          ctx
          type-env
          inner
          operand-ty)
          [(tc_core.ResultTcType.Ok inner-ty)
            (match (tc_core.tc-unop-type op inner-ty)
              [(tc_core.ResultTcType.Ok result-ty)
                (if (tc_core.tc-type-compatible? expr-ty result-ty)
                  (tc_core.ResultTcType.Ok
                    (tc_core.tc-contextual-result-type expr-ty result-ty))
                  (tc_core.tc-unop-type op inner-ty))]
              [(tc_core.ResultTcType.Err _)
                (match (tc_core.tc-expr ctx type-env inner)
                  [(tc_core.ResultTcType.Ok actual-ty)
                    (tc_core.tc-unop-type op actual-ty)]
                  [(tc_core.ResultTcType.Err message)
                    (tc_core.ResultTcType.Err message)])])]
          [(tc_core.ResultTcType.Err message)
            (tc_core.ResultTcType.Err message)])])))

(define (lower-if-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]) : tc_core.ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache then-branch)
    [(tc_core.ResultTcType.Ok then-ty)
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        else-branch)
        [(tc_core.ResultTcType.Ok else-ty)
          (match (tc_core.tc-merge-branch-type ctx type-env then-ty else-ty)
            [(tc_core.ResultTcType.Ok merged) (tc_core.ResultTcType.Ok merged)]
            [(tc_core.ResultTcType.Err message)
              (if (and
                (tc_core.tc-integer-literal-expr? then-branch)
                (tc_core.tc-integer-type? else-ty))
                (match (tc_core.tc-integer-literal-expr-with-expected
                  ctx
                  then-branch
                  else-ty)
                  [(tc_core.ResultTcType.Ok contextual-then)
                    (tc_core.tc-merge-branch-type
                      ctx
                      type-env
                      contextual-then
                      else-ty)]
                  [(tc_core.ResultTcType.Err literal-message)
                    (tc_core.ResultTcType.Err literal-message)])
                (if (and
                  (tc_core.tc-integer-literal-expr? else-branch)
                  (tc_core.tc-integer-type? then-ty))
                  (match (tc_core.tc-integer-literal-expr-with-expected
                    ctx
                    else-branch
                    then-ty)
                    [(tc_core.ResultTcType.Ok contextual-else)
                      (tc_core.tc-merge-branch-type
                        ctx
                        type-env
                        then-ty
                        contextual-else)]
                    [(tc_core.ResultTcType.Err literal-message)
                      (tc_core.ResultTcType.Err literal-message)])
                  (tc_core.ResultTcType.Err message)))])]
        [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)])]
    [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)]))

(define (lower-expr-list-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [exprs : ast.AstExprList]) : tc_core.ResultTcType
  (let
    [len : i64 (struct-get (& exprs) len)]
    (if (= len 0)
      (tc_core.ResultTcType.Ok (ast.AstType.Unit))
      (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        (lower-context-expr-get
          ctx
          (ast.ast-expr-list-get (& exprs) (- len 1) 0))))))

(define (lower-pattern-list-bind-local-names
  [env : sym_i64_env.SymI64Env]
  [patterns : ast.AstPatternList]) : sym_i64_env.SymI64Env
  (lower-pattern-list-bind-local-names-at env (& patterns) 0))

(define (lower-pattern-list-bind-local-names-at
  [env : sym_i64_env.SymI64Env]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]) : sym_i64_env.SymI64Env
  (if (>= index (struct-get patterns len))
    env
    (lower-pattern-list-bind-local-names-at
      (lower-pattern-bind-local-names
        env
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback)))
      patterns
      (+ index 1))))

(define (lower-pattern-bind-local-names
  [env : sym_i64_env.SymI64Env]
  [pattern : ast.AstPattern]) : sym_i64_env.SymI64Env
  (match pattern
    [(ast.AstPattern.Var name _) (sym_i64_env.sym-i64-bind-id env name 0)]
    [(ast.AstPattern.Tuple patterns-box)
      (let
        [patterns : ast.AstPatternList (box-get patterns-box)]
        (lower-pattern-list-bind-local-names env patterns))]
    [(ast.AstPattern.Array patterns-box)
      (let
        [patterns : ast.AstPatternList (box-get patterns-box)]
        (lower-pattern-list-bind-local-names env patterns))]
    [(ast.AstPattern.Binding name) (sym_i64_env.sym-i64-bind-id env name 0)]
    [(ast.AstPattern.Variant _ args-box)
      (let
        [args : ast.AstPatternList (box-get args-box)]
        (lower-pattern-list-bind-local-names env args))]
    [_ env]))

(define (lower-match-pattern-bind-local-names
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : sym_i64_env.SymI64Env
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))
    [(ast.AstType.Enum _)
      (match pattern
        [(ast.AstPattern.Variant _ args-box)
          (let
            [args : ast.AstPatternList (box-get args-box)]
            (lower-pattern-list-bind-local-names env args))]
        [_ env])]
    [_ (lower-pattern-bind-local-names env pattern)]))

(define (lower-match-arm-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]) : tc_core.ResultTcType
  (match arm
    [(ast.AstMatchArm.Arm pattern body-box)
      (let
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (match (tc_core.tc-bind-match-pattern ctx type-env scrut-ty pattern)
          [(tc_core.ResultTcEnv.Ok arm-type-env)
            (lower-expr-result-type-fast
              ctx
              (lower-match-pattern-bind-local-names ctx env scrut-ty pattern)
              arm-type-env
              type-cache
              body)]
          [(tc_core.ResultTcEnv.Err message) (tc_core.ResultTcType.Err message)]))]))

(define (lower-match-rest-result-types-fast-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [want : ast.AstType]) : tc_core.ResultTcType
  (if (>= index (struct-get arms len))
    (tc_core.ResultTcType.Ok want)
    (match (lower-match-arm-result-type-fast
      ctx
      env
      type-env
      type-cache
      scrut-ty
      (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback)))
      [(tc_core.ResultTcType.Ok got)
        (match (tc_core.tc-merge-branch-type ctx type-env want got)
          [(tc_core.ResultTcType.Ok merged)
            (lower-match-rest-result-types-fast-at
              ctx
              env
              type-env
              type-cache
              scrut-ty
              arms
              (+ index 1)
              merged)]
          [(tc_core.ResultTcType.Err message)
            (tc_core.ResultTcType.Err message)])]
      [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)])))

(define (lower-match-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]) : tc_core.ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache scrutinee)
    [(tc_core.ResultTcType.Ok scrut-ty)
      (if (ast.ast-match-arm-list-empty? (& arms))
        (tc_core.ResultTcType.Err
          "lower: match result type is not fast-pathable")
        (match (lower-match-arm-result-type-fast
          ctx
          env
          type-env
          type-cache
          scrut-ty
          (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback)))
          [(tc_core.ResultTcType.Ok first-ty)
            (lower-match-rest-result-types-fast-at
              ctx
              env
              type-env
              type-cache
              scrut-ty
              (& arms)
              1
              first-ty)]
          [(tc_core.ResultTcType.Err message)
            (tc_core.ResultTcType.Err message)]))]
    [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)]))

(define (lower-let-binding-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]) : tc_core.ResultTcType
  (match maybe-ty
    [(ast.AstMaybeType.Some ty)
      (tc_core.ResultTcType.Ok
        (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty)))]
    [(ast.AstMaybeType.No)
      (if (tc_core.tc-ref-capturing-lambda-init?
        (tc_core.tc-context-expr-bases ctx)
        type-env
        init)
        (match (ast.ast-expr-unspan init)
          [(ast.AstExpr.Lambda lambda-box)
            (match (box-get lambda-box)
              [(ast.AstLambda.Lambda params maybe-ret body-box)
                (let
                  [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
                  (tc_core.tc-lambda-expr-allow-ref-captures
                    ctx
                    type-env
                    params
                    maybe-ret
                    body))])]
          [_ (lower-expr-result-type-fast ctx env type-env type-cache init)])
        (lower-expr-result-type-fast ctx env type-env type-cache init))]))

(define (lower-let-bindings-type-env-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [bindings : ast.AstLetBindingList]) : tc_core.ResultTcEnv
  (lower-let-bindings-type-env-fast-at
    ctx
    env
    type-env
    type-cache
    (& bindings)
    0))

(define (lower-let-bindings-type-env-fast-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : tc_core.ResultTcEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (tc_core.ResultTcEnv.Ok type-env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [name-id : i64 name]
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          (match (lower-let-binding-result-type-fast
            ctx
            env
            type-env
            type-cache
            maybe-ty
            init)
            [(tc_core.ResultTcType.Ok binding-ty)
              (lower-let-bindings-type-env-fast-at
                ctx
                (sym_i64_env.sym-i64-bind-id env name-id 0)
                (tc_core.tc-bind-c-abi-fnptr-if-needed-id
                  ctx
                  type-env
                  name-id
                  binding-ty
                  init)
                type-cache
                bindings
                (+ index 1))]
            [(tc_core.ResultTcType.Err message)
              (tc_core.ResultTcEnv.Err message)]))])))

(define (lower-let-bindings-local-env
  [env : sym_i64_env.SymI64Env]
  [bindings : ast.AstLetBindingList]) : sym_i64_env.SymI64Env
  (lower-let-bindings-local-env-at env (& bindings) 0))

(define (lower-let-bindings-local-env-at
  [env : sym_i64_env.SymI64Env]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : sym_i64_env.SymI64Env
  (if (>= index (ast.ast-let-binding-list-len bindings))
    env
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name _ _)
        (lower-let-bindings-local-env-at
          (sym_i64_env.sym-i64-bind-id env name 0)
          bindings
          (+ index 1))])))

(define (lower-projected-result-type-fast
  [ctx : tc_core.TcContext]
  [container-ty : ast.AstType]
  [projected-ty : ast.AstType]) : ast.AstType
  (tc_core.tc-type-without-regions
    (tc_core.tc-resolve-type
      ctx
      (tc_core.tc-project-from-region-container container-ty projected-ty))))

(define (lower-index-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [index : ast.AstExpr]) : tc_core.ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache index)
    [(tc_core.ResultTcType.Ok index-ty)
      (if (tc_core.tc-integer-type? index-ty)
        (tc_core.ResultTcType.Ok index-ty)
        (tc_core.ResultTcType.Err
          "lower: index result type is not fast-pathable"))]
    [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)]))

(define (lower-unary-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [op : ast.AstUnOp]
  [inner : ast.AstExpr]) : tc_core.ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache inner)
    [(tc_core.ResultTcType.Ok inner-ty)
      (match (tc_core.tc-unop-type op inner-ty)
        [(tc_core.ResultTcType.Ok result-ty)
          (tc_core.ResultTcType.Ok
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx result-ty)))]
        [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)])]
    [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)]))

(define (lower-tuple-ref-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [tuple-expr : ast.AstExpr]
  [index : i64]) : tc_core.ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache tuple-expr)
    [(tc_core.ResultTcType.Ok tuple-ty)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx tuple-ty))
        [(ast.AstType.Tuple elem-tys)
          (match (tc_core.tc-type-list-ref (box-get elem-tys) index)
            [(tc_core.ResultTcType.Ok elem-ty)
              (tc_core.ResultTcType.Ok
                (lower-projected-result-type-fast ctx tuple-ty elem-ty))]
            [(tc_core.ResultTcType.Err message)
              (tc_core.ResultTcType.Err message)])]
        [_
          (tc_core.ResultTcType.Err
            "lower: tuple-ref result type is not fast-pathable")])]
    [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)]))

(define (lower-array-ref-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [array-expr : ast.AstExpr]
  [index : ast.AstExpr]) : tc_core.ResultTcType
  (match (lower-index-result-type-fast ctx env type-env type-cache index)
    [(tc_core.ResultTcType.Ok _)
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        array-expr)
        [(tc_core.ResultTcType.Ok array-ty)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx array-ty))
            [(ast.AstType.Array elem-ty _)
              (tc_core.ResultTcType.Ok
                (lower-projected-result-type-fast
                  ctx
                  array-ty
                  (tc_core.tc-context-type-get ctx elem-ty)))]
            [(ast.AstType.DynArray elem-ty)
              (tc_core.ResultTcType.Ok
                (lower-projected-result-type-fast
                  ctx
                  array-ty
                  (tc_core.tc-context-type-get ctx elem-ty)))]
            [_
              (tc_core.ResultTcType.Err
                "lower: array-ref result type is not fast-pathable")])]
        [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)])]
    [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)]))

(define (lower-string-ref-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [str : ast.AstExpr]
  [index : ast.AstExpr]) : tc_core.ResultTcType
  (match (lower-index-result-type-fast ctx env type-env type-cache index)
    [(tc_core.ResultTcType.Ok _)
      (match (lower-expr-result-type-fast ctx env type-env type-cache str)
        [(tc_core.ResultTcType.Ok str-ty)
          (if (lower-string-handle-type? ctx str-ty)
            (tc_core.ResultTcType.Ok (ast.AstType.Char))
            (tc_core.ResultTcType.Err
              "lower: string-ref result type is not fast-pathable"))]
        [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)])]
    [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)]))

(define (lower-struct-get-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [receiver : ast.AstExpr]
  [field : i64]) : tc_core.ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache receiver)
    [(tc_core.ResultTcType.Ok receiver-ty)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx receiver-ty))
        [(ast.AstType.Struct struct-name)
          (match (tc_core.tc-struct-field-type-id ctx struct-name field)
            [(tc_core.ResultTcType.Ok field-ty)
              (tc_core.ResultTcType.Ok
                (lower-projected-result-type-fast ctx receiver-ty field-ty))]
            [(tc_core.ResultTcType.Err message)
              (tc_core.ResultTcType.Err message)])]
        [(ast.AstType.StructArgs struct-name lifetimes)
          (match (tc_core.tc-struct-field-type-with-args-id
            ctx
            struct-name
            (box-get lifetimes)
            field)
            [(tc_core.ResultTcType.Ok field-ty)
              (tc_core.ResultTcType.Ok
                (lower-projected-result-type-fast ctx receiver-ty field-ty))]
            [(tc_core.ResultTcType.Err message)
              (tc_core.ResultTcType.Err message)])]
        [_
          (tc_core.ResultTcType.Err
            "lower: struct-get result type is not fast-pathable")])]
    [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)]))

(define (lower-box-get-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [box-expr : ast.AstExpr]) : tc_core.ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache box-expr)
    [(tc_core.ResultTcType.Ok box-ty)
      (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx box-ty))
        [(ast.AstType.Box inner-ty)
          (tc_core.ResultTcType.Ok
            (lower-projected-result-type-fast
              ctx
              box-ty
              (tc_core.tc-context-type-get ctx inner-ty)))]
        [_
          (tc_core.ResultTcType.Err
            "lower: box-get result type is not fast-pathable")])]
    [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)]))

;; Compile-time: memoize lower-expr-result-type-fast by AST node id.
;; lower-expr-origin computes each expr's result type (walking the result-
;; determining spine) BEFORE lowering, and lowering the children re-walks their
;; spines -- so for deeply-nested functions a node's spine is recomputed once per
;; ancestor: O(N^2), the dominant lower-phase cost (single big functions allocated
;; hundreds of MB of transient). The cache is a fixed direct-mapped global array
;; keyed by the spanned node id, validated by a PER-FUNCTION generation counter
;; (tc-rtf-next-gen! is bumped at each lower-function-escaping). The generation
;; makes it both correct (a node's type-env is fixed within its own function) and
;; arena-safe (an entry is only ever read within the same function's lowering,
;; while that function's scratch arena is still live -- the next function bumps
;; the generation, so a stale scratch-allocated type is never read). A slot
;; collision (different id, same slot) misses via the stored-id check.
(define tc-rtf-cap : i64
  65536)
(define tc-rtf-gen-arr : (__tl_dyn-array i64)
  (make-array i64 tc-rtf-cap))
(define tc-rtf-id-arr : (__tl_dyn-array i64)
  (make-array i64 tc-rtf-cap))
(define tc-rtf-ty-arr : (__tl_dyn-array ast.AstType)
  (make-array ast.AstType tc-rtf-cap))
(define tc-rtf-current-gen : i64
  0)
(define tc-rtf-filled : bool
  false)

(define (tc-rtf-ensure!) : unit
  (if tc-rtf-filled
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-rtf-cap)
          (begin
            (array-set! tc-rtf-gen-arr i 0)
            (set! i (+ i 1))))
        (set! tc-rtf-filled true)))))

(define (tc-rtf-next-gen!) : unit
  (begin
    (tc-rtf-ensure!)
    (set! tc-rtf-current-gen (+ tc-rtf-current-gen 1))))

(define (lower-expr-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [expr : ast.AstExpr]) : tc_core.ResultTcType
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [slot : i64 (% inner-box tc-rtf-cap)]
        (if (if (= (array-ref tc-rtf-gen-arr slot) tc-rtf-current-gen)
          (= (array-ref tc-rtf-id-arr slot) inner-box)
          false)
          (tc_core.ResultTcType.Ok
            (lower-global-array-element-shared-view tc-rtf-ty-arr slot))
          (match (lower-expr-result-type-fast
            ctx
            env
            type-env
            type-cache
            (lower-context-expr-get ctx inner-box))
            [(tc_core.ResultTcType.Ok ty)
              (begin
                (array-set! tc-rtf-gen-arr slot tc-rtf-current-gen)
                (array-set! tc-rtf-id-arr slot inner-box)
                (array-set! tc-rtf-ty-arr slot ty)
                (tc_core.ResultTcType.Ok ty))]
            [(tc_core.ResultTcType.Err message)
              (tc_core.ResultTcType.Err message)])))]
    [(ast.AstExpr.Literal lit)
      (tc_core.ResultTcType.Ok (tc_core.tc-literal-type lit))]
    [(ast.AstExpr.BinaryData _)
      (tc_core.ResultTcType.Ok (ast.ast-ty-dyn-array (ast.AstType.U8)))]
    [(ast.AstExpr.SpmdProgramIndex) (tc_core.ResultTcType.Ok (ast.AstType.I64))]
    [(ast.AstExpr.SpmdProgramCount) (tc_core.ResultTcType.Ok (ast.AstType.I64))]
    [(ast.AstExpr.Var name)
      (match (lower-lookup-type-id ctx type-cache env type-env name)
        [(tc_core.ResultTcType.Ok expr-ty)
          (tc_core.ResultTcType.Ok (tc_core.tc-type-without-regions expr-ty))]
        [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)])]
    [(ast.AstExpr.Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id-with-pools
        (tc_core.tc-context-pools ctx)
        maybe-ty-id)
        [(ast.AstMaybeType.Some ty)
          (tc_core.ResultTcType.Ok
            (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty)))]
        [(ast.AstMaybeType.No)
          (tc_core.ResultTcType.Err
            "lower: contextual init requires an expected type")])]
    [(ast.AstExpr.Ann _ ty-id)
      (tc_core.ResultTcType.Ok
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx ty-id))))]
    [(ast.AstExpr.Cast _ ty-id)
      (tc_core.ResultTcType.Ok
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx ty-id))))]
    [(ast.AstExpr.Unary op inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-unary-result-type-fast ctx env type-env type-cache op inner))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (lower-call-result-type-fast ctx env type-env type-cache func args))]
    [(ast.AstExpr.Binary op left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (lower-binary-result-type-fast ctx type-env op left right))]
    [(ast.AstExpr.If _ then-branch-box else-branch-box)
      (let
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-if-result-type-fast
          ctx
          env
          type-env
          type-cache
          then-branch
          else-branch))]
    [(ast.AstExpr.Begin exprs)
      (lower-expr-list-result-type-fast ctx env type-env type-cache exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (lower-expr-list-result-type-fast
        ctx
        env
        (tc_core.tc-enter-unsafe type-env)
        type-cache
        exprs)]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-match-result-type-fast
              ctx
              env
              type-env
              type-cache
              scrutinee
              arms))])]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings-type-env-fast
              ctx
              env
              type-env
              type-cache
              bindings)
              [(tc_core.ResultTcEnv.Ok body-type-env)
                (lower-expr-result-type-fast
                  ctx
                  (lower-let-bindings-local-env env bindings)
                  body-type-env
                  type-cache
                  body)]
              [(tc_core.ResultTcEnv.Err message)
                (tc_core.ResultTcType.Err message)]))])]
    [(ast.AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : ast.AstExpr (lower-context-expr-get ctx tuple-expr-box)]
        (lower-tuple-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          tuple-expr
          index))]
    [(ast.AstExpr.ArrayRef array-expr-box index-box)
      (let
        [array-expr : ast.AstExpr (lower-context-expr-get ctx array-expr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-array-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          array-expr
          index))]
    [(ast.AstExpr.StringRef str-box index-box)
      (let
        [str : ast.AstExpr (lower-context-expr-get ctx str-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-string-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          str
          index))]
    [(ast.AstExpr.StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-struct-get-result-type-fast
          ctx
          env
          type-env
          type-cache
          receiver
          field))]
    [(ast.AstExpr.BoxGet box-expr-box)
      (let
        [box-expr : ast.AstExpr (lower-context-expr-get ctx box-expr-box)]
        (lower-box-get-result-type-fast ctx env type-env type-cache box-expr))]
    [(ast.AstExpr.BoxTake box-expr-box)
      (let
        [box-expr : ast.AstExpr (lower-context-expr-get ctx box-expr-box)]
        (lower-box-get-result-type-fast ctx env type-env type-cache box-expr))]
    [(ast.AstExpr.Set _ _) (tc_core.ResultTcType.Ok (ast.AstType.Unit))]
    [(ast.AstExpr.StructSet _ _ _) (tc_core.ResultTcType.Ok (ast.AstType.Unit))]
    [(ast.AstExpr.BoxSet _ _) (tc_core.ResultTcType.Ok (ast.AstType.Unit))]
    [_
      (tc_core.ResultTcType.Err
        "lower: expression result type is not fast-pathable")]))

(define (lower-expr-result-type-or-check
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [expr : ast.AstExpr]) : tc_core.ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache expr)
    [(tc_core.ResultTcType.Ok expr-ty) (tc_core.ResultTcType.Ok expr-ty)]
    [(tc_core.ResultTcType.Err _) (tc_core.tc-expr ctx type-env expr)]))

(define (lower-index-result-type-or-check
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [index : ast.AstExpr]) : tc_core.ResultTcType
  (match (lower-index-result-type-fast ctx env type-env type-cache index)
    [(tc_core.ResultTcType.Ok index-ty) (tc_core.ResultTcType.Ok index-ty)]
    [(tc_core.ResultTcType.Err _)
      (match (tc_core.tc-expr-with-expected-or-actual
        ctx
        type-env
        index
        (ast.AstType.I64))
        [(tc_core.ResultTcType.Ok index-ty)
          (if (tc_core.tc-integer-type? index-ty)
            (tc_core.ResultTcType.Ok
              (tc_core.tc-type-without-regions
                (tc_core.tc-resolve-type ctx index-ty)))
            (tc_core.ResultTcType.Err
              "lower: index result type is not fast-pathable"))]
        [(tc_core.ResultTcType.Err message) (tc_core.ResultTcType.Err message)])]))

(define (lower-ptr-addr-of-local-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? local-id)
      (match (lower-lookup-type-id
        ctx
        (lower-state-type-cache state)
        env
        type-env
        name)
        [(tc_core.ResultTcType.Ok place-ty)
          (if (lower-borrow-place-value-reference? ctx place-ty)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                state
                (ir.CompilerIrValue.Var local-id)
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx place-ty))))
            (match (lower-state-alloc-var state)
              [(LowerAlloc.Alloc allocated var-id)
                (let
                  [addr-state : LowerState
                    (lower-state-emit-at-expr
                      allocated
                      (ir.CompilerIrInstr.AddrOf var-id local-id)
                      origin)]
                  [marked-state : LowerState
                    (if (lower-type-register-resident? ctx place-ty)
                      (lower-state-register-address-taken-mark
                        addr-state
                        local-id)
                      addr-state)]
                  [addr-ty : ast.AstType
                    (tc_core.tc-type-without-regions
                      (tc_core.tc-resolve-type ctx place-ty))]
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      marked-state
                      (ir.CompilerIrValue.Var var-id)
                      addr-ty)))]))]
        [(tc_core.ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))])
      (match (lower-lookup-type-id
        ctx
        (lower-state-type-cache state)
        env
        type-env
        name)
        [(tc_core.ResultTcType.Ok place-ty)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              state
              (if (lower-ptr-addr-of-global-value-reference? ctx place-ty)
                (ir.CompilerIrValue.Global
                  (lower-resolve-name-symbol-id state name))
                (ir.CompilerIrValue.GlobalAddr
                  (lower-resolve-name-symbol-id state name)))
              (tc_core.tc-type-without-regions
                (tc_core.tc-resolve-type ctx place-ty))))]
        [(tc_core.ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))))

(define (lower-integer-expr-with-expected-or-actual
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [expected-ty : ast.AstType]
  [non-integer-message : String]) : ResultLowerExpr
  (match (tc_core.tc-expr-with-expected-or-actual ctx type-env expr expected-ty)
    [(tc_core.ResultTcType.Ok expr-ty)
      (let
        [resolved-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx expr-ty))]
        (if (tc_core.tc-integer-type? resolved-ty)
          (lower-expr-expected ctx state env type-env expr resolved-ty expr)
          (ResultLowerExpr.Err
            (box (lower-diagnostic-at-expr expr non-integer-message)))))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-for-owned-name-id [ctx : tc_core.TcContext] [expr-id : i64]) : i64
  (match (ast.ast-expr-unspan-with-pools
    (tc_core.tc-context-pools ctx)
    (lower-context-expr-get ctx expr-id))
    [(ast.AstExpr.Var name) name]
    [_ -1]))

(define (lower-for-owned-state
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-name-id : i64]
  [index-name-id : i64]
  [source-id : i64]
  [body-id : i64]) : ResultLowerExpr
  (let
    [source-name : i64 (lower-for-owned-name-id ctx source-name-id)]
    [index-name : i64 (lower-for-owned-name-id ctx index-name-id)]
    [source : ast.AstExpr (lower-context-expr-get ctx source-id)]
    [body : ast.AstExpr (lower-context-expr-get ctx body-id)]
    (if (or (< source-name 0) (< index-name 0))
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            source
            "lower: invalid scalar for owned-array state names")))
      (match (lower-expr ctx state env type-env source)
        [(ResultLowerExpr.Ok lowered-source)
          (match lowered-source
            [(LowerExpr.Expr source-state source-value source-ty)
              (match (lower-state-alloc-var source-state)
                [(LowerAlloc.Alloc source-allocated source-var)
                  (match (lower-state-alloc-var
                    (lower-state-emit
                      source-allocated
                      (ir.CompilerIrInstr.Mov
                        source-var
                        source-value
                        (lower-one-word-register-storage-type ctx source-ty))))
                    [(LowerAlloc.Alloc index-allocated index-var)
                      (let
                        [bound-env : sym_i64_env.SymI64Env
                          (sym_i64_env.sym-i64-bind-id
                            (sym_i64_env.sym-i64-bind-id
                              env
                              source-name
                              source-var)
                            index-name
                            index-var)]
                        [bound-type-env : tc_core.TcTypeEnv
                          (tc_core.tc-bind-id
                            (tc_core.tc-bind-id type-env source-name source-ty)
                            index-name
                            (ast.AstType.I64))]
                        (match (lower-expr
                          ctx
                          (lower-state-emit
                            index-allocated
                            (ir.CompilerIrInstr.Mov
                              index-var
                              (ir.CompilerIrValue.I64 0)
                              (ast.AstType.I64)))
                          bound-env
                          bound-type-env
                          body)
                          [(ResultLowerExpr.Ok lowered-body)
                            (match lowered-body
                              [(LowerExpr.Expr body-state _ body-ty)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr
                                    body-state
                                    ir.CompilerIrValue.Unit
                                    (if (tc_core.tc-never-type? body-ty)
                                      body-ty
                                      (ast.AstType.Unit))))])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)]))])])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))

(define (lower-for-owned-step-generated
  [ctx : tc_core.TcContext]
  [source-id : i64]
  [index-id : i64]
  [binding-id : i64]
  [done-id : i64]
  [body-id : i64]
  [length : i64]) : i64
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    [index-name : i64 (lower-for-owned-name-id ctx index-id)]
    [binding-name : i64 (lower-for-owned-name-id ctx binding-id)]
    [done-name : i64 (lower-for-owned-name-id ctx done-id)]
    [one-id : i64
      (ast.ast-node-pool-context-expr-push
        pools
        (ast.AstExpr.Literal (ast.ast-lit-int 1)))]
    [length-id : i64
      (ast.ast-node-pool-context-expr-push
        pools
        (ast.AstExpr.Literal (ast.ast-lit-int length)))]
    [true-id : i64
      (ast.ast-node-pool-context-expr-push
        pools
        (ast.AstExpr.Literal (ast.AstLiteral.Bool true)))]
    [item-id : i64 (ast.ast-expr-array-ref-with-pools pools source-id index-id)]
    [next-index-id : i64
      (ast.ast-expr-binary-with-pools pools (ast.AstBinOp.Add) index-id one-id)]
    [set-index-id : i64
      (ast.ast-expr-set-id-with-pools pools index-name next-index-id)]
    [item-body-items : ast.AstExprList (ast.ast-expr-list-with-capacity 2)]
    [item-bindings : ast.AstLetBindingList
      (ast.ast-let-binding-list-with-capacity 1)]
    (begin
      (ast.ast-expr-list-push (&mut item-body-items) set-index-id)
      (ast.ast-expr-list-push (&mut item-body-items) body-id)
      (ast.ast-let-binding-list-push
        (&mut item-bindings)
        (ast.ast-let-binding-id binding-name (ast.AstMaybeType.No) item-id))
      (ast.ast-expr-if-with-pools
        pools
        (ast.ast-expr-binary-with-pools
          pools
          (ast.AstBinOp.Lt)
          index-id
          length-id)
        (ast.ast-expr-let-with-pools
          pools
          item-bindings
          (ast.ast-node-pool-context-expr-push
            pools
            (ast.AstExpr.Begin item-body-items)))
        (ast.ast-expr-set-id-with-pools pools done-name true-id)))))

(define (lower-for-owned-step
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [index-id : i64]
  [binding-id : i64]
  [done-id : i64]
  [body-id : i64]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-context-expr-get ctx source-id))
    [(tc_core.ResultTcType.Ok source-ty)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx source-ty))
        [(ast.AstType.Array _ length)
          (let
            [generated-id : i64
              (lower-for-owned-step-generated
                ctx
                source-id
                index-id
                binding-id
                done-id
                body-id
                length)]
            (lower-expr
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx generated-id)))]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                "lower: scalar for owned step requires fixed-array state")))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic message)))]))

(define (lower-expr-typechecked
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-expr ctx type-env expr)
    [(tc_core.ResultTcType.Ok expr-ty)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc_core.tc-type-without-regions expr-ty))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-cast-source-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (tc_core.tc-integer-literal-expr? expr)
    (lower-expr-with-type ctx state env type-env expr origin (ast.AstType.I64))
    (lower-expr ctx state env type-env expr)))

;; Lowering runs after full-program typecheck. For result types that are
;; syntactically available, avoid re-running recursive expression typecheck;
;; the fallback below preserves the old path for anything ambiguous.
(define (lower-expr-origin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-origin ctx state env type-env inner origin))]
    [(ast.AstExpr.Literal lit)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc_core.tc-literal-type lit))]
    [(ast.AstExpr.BinaryData _)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (ast.ast-ty-dyn-array (ast.AstType.U8)))]
    [(ast.AstExpr.Var name)
      (if (tc_core.tc-dotted-local-field-name-id? type-env name)
        (match (tc_core.tc-dotted-local-field-expr-id type-env name)
          [(tc_core.ResultTcExprId.Ok virtual-id)
            (lower-expr-origin
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin)]
          [(tc_core.ResultTcExprId.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))])
        (match (lower-lookup-type-id
          ctx
          (lower-state-type-cache state)
          env
          type-env
          name)
          [(tc_core.ResultTcType.Ok expr-ty)
            (lower-expr-with-type
              ctx
              state
              env
              type-env
              expr
              origin
              (tc_core.tc-type-without-regions expr-ty))]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))]))]
    [(ast.AstExpr.Ann _ ty-id)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx ty-id))))]
    [(ast.AstExpr.Cast _ ty-id)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx ty-id))))]
    [(ast.AstExpr.Binary op left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (match (lower-binary-result-type-fast ctx type-env op left right)
          [(tc_core.ResultTcType.Ok expr-ty)
            (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
          [(tc_core.ResultTcType.Err _)
            (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (match (lower-call-result-type-fast
          ctx
          env
          type-env
          (lower-state-type-cache state)
          func
          args)
          [(tc_core.ResultTcType.Ok expr-ty)
            (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
          [(tc_core.ResultTcType.Err _)
            (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(ResultLowerEnv.Ok binding-state body-env body-type-env)
                (lower-expr ctx binding-state body-env body-type-env body)]
              [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))])]
    [(ast.AstExpr.Begin exprs) (lower-begin ctx state env type-env exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (lower-begin ctx state env (tc_core.tc-enter-unsafe type-env) exprs)]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (match (lower-if-result-type-fast
          ctx
          env
          type-env
          (lower-state-type-cache state)
          then-branch
          else-branch)
          [(tc_core.ResultTcType.Ok expr-ty)
            (lower-if
              ctx
              state
              env
              type-env
              cond
              then-branch
              else-branch
              expr-ty)]
          [(tc_core.ResultTcType.Err _)
            (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (match (lower-match-result-type-fast
              ctx
              env
              type-env
              (lower-state-type-cache state)
              scrutinee
              arms)
              [(tc_core.ResultTcType.Ok expr-ty)
                (lower-match ctx state env type-env scrutinee arms expr-ty)]
              [(tc_core.ResultTcType.Err _)
                (lower-expr-typechecked ctx state env type-env expr origin)]))])]
    [_
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        (lower-state-type-cache state)
        expr)
        [(tc_core.ResultTcType.Ok expr-ty)
          (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
        [(tc_core.ResultTcType.Err _)
          (lower-expr-typechecked ctx state env type-env expr origin)])]))

(define (lower-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (lower-expr-origin ctx state env type-env expr expr))

(define (lower-expr-with-type
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-with-type ctx state env type-env inner origin expr-ty))]
    [(ast.AstExpr.Literal lit)
      (lower-materialize-at-expr
        state
        (lower-literal-value-with-type lit expr-ty)
        expr-ty
        origin)]
    [(ast.AstExpr.BinaryData bytes)
      (lower-materialize-at-expr
        state
        (ir.CompilerIrValue.Bytes bytes)
        expr-ty
        origin)]
    [(ast.AstExpr.SpmdProgramIndex)
      (lower-materialize-at-expr
        state
        (ir.CompilerIrValue.I64 0)
        expr-ty
        origin)]
    [(ast.AstExpr.SpmdProgramCount)
      (lower-materialize-at-expr
        state
        (ir.CompilerIrValue.I64 1)
        expr-ty
        origin)]
    [(ast.AstExpr.Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id-with-pools
        (tc_core.tc-context-pools ctx)
        maybe-ty-id)
        [(ast.AstMaybeType.Some ty)
          (lower-init-expr ctx state env type-env ty origin expr-ty)]
        [(ast.AstMaybeType.No)
          (lower-init-expr ctx state env type-env expr-ty origin expr-ty)])]
    [(ast.AstExpr.Var name)
      (if (tc_core.tc-dotted-local-field-name-id? type-env name)
        (match (tc_core.tc-dotted-local-field-expr-id type-env name)
          [(tc_core.ResultTcExprId.Ok virtual-id)
            (lower-expr-with-type
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin
              expr-ty)]
          [(tc_core.ResultTcExprId.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))])
        (lower-var-or-nullary-variant-id ctx state env type-env name expr-ty))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-expr-expected ctx state env type-env inner expr-ty origin)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr inner-state value _)
                (ResultLowerExpr.Ok (LowerExpr.Expr inner-state value expr-ty))])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-cast-source-expr ctx state env type-env inner origin)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr inner-state value inner-ty)
                (ResultLowerExpr.Ok
                  (lower-cast-value inner-state value inner-ty expr-ty))])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(ast.AstExpr.Borrow _ _ inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-borrow-expr ctx state env type-env inner origin expr-ty))]
    [(ast.AstExpr.Unary op inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-unop-type-with-result ctx type-env op inner expr-ty)
          [(tc_core.ResultTcType.Ok result-ty)
            (match (tc_core.tc-unop-contextual-operand-type op result-ty)
              [(ast.AstMaybeType.No)
                (match (lower-expr ctx state env type-env inner)
                  [(ResultLowerExpr.Ok lowered)
                    (match lowered
                      [(LowerExpr.Expr inner-state value _)
                        (match (lower-state-alloc-var inner-state)
                          [(LowerAlloc.Alloc allocated var-id)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                (lower-state-emit-at-expr
                                  allocated
                                  (ir.CompilerIrInstr.UnOp
                                    var-id
                                    (lower-unop op)
                                    value
                                    result-ty)
                                  origin)
                                (ir.CompilerIrValue.Var var-id)
                                result-ty))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
              [(ast.AstMaybeType.Some operand-ty)
                (match (lower-expr-expected
                  ctx
                  state
                  env
                  type-env
                  inner
                  operand-ty
                  inner)
                  [(ResultLowerExpr.Ok lowered)
                    (match lowered
                      [(LowerExpr.Expr inner-state value _)
                        (match (lower-state-alloc-var inner-state)
                          [(LowerAlloc.Alloc allocated var-id)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                (lower-state-emit-at-expr
                                  allocated
                                  (ir.CompilerIrInstr.UnOp
                                    var-id
                                    (lower-unop op)
                                    value
                                    result-ty)
                                  origin)
                                (ir.CompilerIrValue.Var var-id)
                                result-ty))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))]))]
    [(ast.AstExpr.Binary op left-box right-box)
      ;; `and`/`or` short-circuit: desugar to a conditional branch so the right
      ;; operand is evaluated only when the left does not already decide the
      ;; result, matching the Rust lowerer in `src/lower.rs`:
      ;; `(and a b)` -> `(if a b false)`, `(or a b)` -> `(if a true b)`. Every
      ;; other binop evaluates both operands eagerly into an `CompilerIrInstr.BinOp`.
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (match op
          [(ast.AstBinOp.And)
            (lower-if
              ctx
              state
              env
              type-env
              left
              right
              (ast.AstExpr.Literal (ast.AstLiteral.Bool false))
              expr-ty)]
          [(ast.AstBinOp.Or)
            (lower-if
              ctx
              state
              env
              type-env
              left
              (ast.AstExpr.Literal (ast.AstLiteral.Bool true))
              right
              expr-ty)]
          [_
            (match (lower-binop-types-with-result
              ctx
              type-env
              op
              left
              right
              expr-ty)
              [(tc_core.ResultTcBinOpTypes.Ok binop-types)
                (match binop-types
                  [(tc_core.TcBinOpTypes left-ty right-ty result-ty)
                    (match (lower-expr-expected
                      ctx
                      state
                      env
                      type-env
                      left
                      left-ty
                      left)
                      [(ResultLowerExpr.Ok left-lowered)
                        (match left-lowered
                          [(LowerExpr.Expr left-state left-value _)
                            (match (lower-expr-expected
                              ctx
                              left-state
                              env
                              type-env
                              right
                              right-ty
                              right)
                              [(ResultLowerExpr.Ok right-lowered)
                                (match right-lowered
                                  [(LowerExpr.Expr right-state right-value _)
                                    (if (and
                                      (lower-binop-group-eq? op)
                                      (lower-type-register-group? ctx left-ty))
                                      (lower-group-equality
                                        ctx
                                        right-state
                                        op
                                        left-value
                                        right-value
                                        left-ty
                                        result-ty
                                        origin)
                                      (match (lower-state-alloc-var right-state)
                                        [(LowerAlloc.Alloc allocated var-id)
                                          (ResultLowerExpr.Ok
                                            (LowerExpr.Expr
                                              (lower-state-emit-at-expr
                                                allocated
                                                (ir.CompilerIrInstr.BinOp
                                                  var-id
                                                  (lower-binop op right-ty)
                                                  left-value
                                                  right-value
                                                  (if (ir.compiler-ir-binop-compare?
                                                    (lower-binop op right-ty))
                                                    left-ty
                                                    result-ty))
                                                origin)
                                              (ir.CompilerIrValue.Var var-id)
                                              result-ty))]))])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])])]
                      [(ResultLowerExpr.Err message)
                        (ResultLowerExpr.Err message)])])]
              [(tc_core.ResultTcBinOpTypes.Err message)
                (ResultLowerExpr.Err
                  (box (lower-diagnostic-at-expr origin message)))])]))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (lower-call ctx state env type-env func args expr-ty origin))]
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (lower-lambda
              ctx
              state
              env
              type-env
              params
              maybe-ret
              body
              origin
              expr-ty))])]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(ResultLowerEnv.Ok binding-state body-env body-type-env)
                (lower-expr-expected
                  ctx
                  binding-state
                  body-env
                  body-type-env
                  body
                  expr-ty
                  body)]
              [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))])]
    [(ast.AstExpr.Begin exprs)
      (lower-begin-expected ctx state env type-env exprs expr-ty)]
    [(ast.AstExpr.Unsafe exprs)
      (lower-begin-expected
        ctx
        state
        env
        (tc_core.tc-enter-unsafe type-env)
        exprs
        expr-ty)]
    [(ast.AstExpr.Set name value-box)
      (let
        [name-id : i64 name]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [name-text : String (tc_core.tc-env-key-name-text name)]
        (if (tc_core.tc-dotted-local-field-name-id? type-env name)
          (match (tc_core.tc-dotted-local-field-set-expr-id
            type-env
            name
            value-box)
            [(tc_core.ResultTcExprId.Ok virtual-id)
              (lower-expr-with-type
                ctx
                state
                env
                type-env
                (lower-context-expr-get ctx virtual-id)
                origin
                expr-ty)]
            [(tc_core.ResultTcExprId.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr origin message)))])
          (match (lower-lookup-type-id
            ctx
            (lower-state-type-cache state)
            env
            type-env
            name-id)
            [(tc_core.ResultTcType.Ok store-ty)
              (let
                [target-ty : ast.AstType
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx store-ty))]
                [target-ir-ty : ast.AstType
                  (lower-one-word-register-storage-type ctx target-ty)]
                (match (lower-expr-expected
                  ctx
                  state
                  env
                  type-env
                  value
                  target-ty
                  value)
                  [(ResultLowerExpr.Ok lowered)
                    (match lowered
                      [(LowerExpr.Expr value-state value-ir _)
                        (let
                          [id : i64
                            (sym_i64_env.sym-i64-lookup-id-or
                              env
                              name-id
                              (csym.compiler-symbols-missing-handle))]
                          (if (csym.compiler-symbols-handle-found? id)
                            (match (lower-local-assignment-value
                              ctx
                              value-state
                              value-ir
                              target-ty
                              id)
                              [(ResultLowerExpr.Ok assignment)
                                (match assignment
                                  [(LowerExpr.Expr
                                      assign-value-state
                                      assign-ir
                                      _)
                                    (let
                                      [assign-state
                                        : LowerState
                                        ;; A rebound aggregate param may point at
                                        ;; current-frame storage, so its var id no
                                        ;; longer proves tail-call forwarding is safe.
                                        (if (and
                                          (lower-state-tail-param-range-contains?
                                            assign-value-state
                                            id)
                                          (lower-type-contains-inline-aggregate?
                                            ctx
                                            target-ty))
                                          (lower-state-clear-tail-param-range
                                            assign-value-state)
                                          assign-value-state)]
                                      (ResultLowerExpr.Ok
                                        (LowerExpr.Expr
                                          (let
                                            [next-state : LowerState
                                              (lower-state-emit-at-expr
                                                assign-state
                                                (ir.CompilerIrInstr.Mov
                                                  id
                                                  assign-ir
                                                  target-ir-ty)
                                                origin)]
                                            (if (>=
                                              lower-active-loop-entry-var-limit
                                              0)
                                              (let
                                                [assign-origin : i64
                                                  (lower-state-inline-result-alias-origin
                                                    next-state
                                                    assign-ir)]
                                                (lower-state-inline-result-alias-set
                                                  next-state
                                                  id
                                                  assign-origin))
                                              next-state))
                                          ir.CompilerIrValue.Unit
                                          expr-ty)))])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])
                            (match (lower-return-abi-value
                              ctx
                              value-state
                              value-ir
                              target-ty)
                              [(ResultLowerExpr.Ok store-copy)
                                (match store-copy
                                  [(LowerExpr.Expr store-state store-ir _)
                                    (let
                                      [target-id : i64
                                        (lower-resolve-name-symbol-id
                                          store-state
                                          name-id)]
                                      (ResultLowerExpr.Ok
                                        (LowerExpr.Expr
                                          (lower-state-emit-at-expr
                                            store-state
                                            (ir.CompilerIrInstr.Store
                                              target-id
                                              store-ir
                                              target-ir-ty)
                                            origin)
                                          ir.CompilerIrValue.Unit
                                          expr-ty)))])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
            [(tc_core.ResultTcType.Err _)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    (string.append
                      "lower: assignment to unknown local "
                      name-text))))])))]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-if ctx state env type-env cond then-branch else-branch expr-ty))]
    [(ast.AstExpr.While cond-box body-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (lower-while ctx state env type-env cond body))]
    [(ast.AstExpr.ForOwnedState payload)
      (lower-for-owned-state
        ctx
        state
        env
        type-env
        (ast.ast-for-owned-state-source-name (& payload))
        (ast.ast-for-owned-state-index-name (& payload))
        (ast.ast-for-owned-state-source (& payload))
        (ast.ast-for-owned-state-body (& payload)))]
    [(ast.AstExpr.ForOwnedStep payload)
      (lower-for-owned-step
        ctx
        state
        env
        type-env
        (ast.ast-for-owned-step-source-name (& payload))
        (ast.ast-for-owned-step-index-name (& payload))
        (ast.ast-for-owned-step-binding-name (& payload))
        (ast.ast-for-owned-step-done-name (& payload))
        (ast.ast-for-owned-step-body (& payload)))]
    [(ast.AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(ast.AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
            [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (lower-foreach
              ctx
              state
              env
              type-env
              index
              (tc_core.tc-env-key-name-text index)
              index-ty
              start
              end
              body))])]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(ast.AstSpmdReduce.Reduce
            op
            index
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
            [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
            [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
            [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
            (lower-spmd-reduce
              ctx
              state
              env
              type-env
              expr-ty
              op
              index
              (tc_core.tc-env-key-name-text index)
              index-ty
              start
              end
              init
              value))])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(ast.AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
            [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
            [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
            [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (lower-spmd-scan
              ctx
              state
              env
              type-env
              op
              index
              (tc_core.tc-env-key-name-text index)
              index-ty
              start
              end
              prefix
              (tc_core.tc-env-key-name-text prefix)
              prefix-ty
              init
              value
              body))])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (lower-spmd-broadcast ctx state env type-env value lane))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (lower-spmd-shuffle ctx state env type-env value lane))]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-match ctx state env type-env scrutinee arms expr-ty))])]
    [(ast.AstExpr.StringRef str-box index-box)
      (let
        [str : ast.AstExpr (lower-context-expr-get ctx str-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-string-ref ctx state env type-env str index origin))]
    [(ast.AstExpr.StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-struct-get ctx state env type-env receiver field expr-ty))]
    [(ast.AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-struct-set ctx state env type-env receiver field value origin))]
    [(ast.AstExpr.MakeArray elem-ty-id len-box)
      (let
        [len : ast.AstExpr (lower-context-expr-get ctx len-box)]
        (lower-make-array
          ctx
          state
          env
          type-env
          (tc_core.tc-context-type-get ctx elem-ty-id)
          len
          origin))]
    [(ast.AstExpr.Array values)
      (lower-array-literal ctx state env type-env values expr-ty origin)]
    [(ast.AstExpr.DynArray values)
      (lower-dyn-array-literal ctx state env type-env values expr-ty origin)]
    [(ast.AstExpr.ArrayRef arr-box index-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-array-ref ctx state env type-env arr index))]
    [(ast.AstExpr.ArraySet arr-box index-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-array-set ctx state env type-env arr index value))]
    [(ast.AstExpr.ArrayTake arr-box live-box index-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [live : ast.AstExpr (lower-context-expr-get ctx live-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-array-take ctx state env type-env arr live index expr-ty))]
    [(ast.AstExpr.FixedArrayTake arr-box index-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-fixed-array-take ctx state env type-env arr index expr-ty))]
    [(ast.AstExpr.ArrayPush arr-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-array-push ctx state env type-env arr value))]
    [(ast.AstExpr.Tuple values)
      (lower-tuple ctx state env type-env values expr-ty origin)]
    [(ast.AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : ast.AstExpr (lower-context-expr-get ctx tuple-expr-box)]
        (lower-tuple-ref ctx state env type-env tuple-expr index expr-ty))]
    [(ast.AstExpr.WithRegion _ body)
      (lower-with-arena ctx state env type-env body)]
    [(ast.AstExpr.WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr (lower-context-expr-get ctx scratch-box)]
        (lower-with-escape ctx state env type-env scratch body))]
    [(ast.AstExpr.WithScratch body)
      (lower-with-scratch ctx state env type-env body)]
    [(ast.AstExpr.InArena arena-box body)
      (let
        [arena : ast.AstExpr (lower-context-expr-get ctx arena-box)]
        (lower-in-arena ctx state env type-env arena body))]
    [(ast.AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (lower-with-resource ctx state env type-env bindings body)])]
    [(ast.AstExpr.Box inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box ctx state env type-env inner expr-ty))]
    [(ast.AstExpr.BoxGet inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expr-ty))]
    [(ast.AstExpr.BoxTake inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expr-ty))]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-box-set ctx state env type-env inner value origin))]
    [(ast.AstExpr.Try inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-try ctx state env type-env inner origin))]
    [(ast.AstExpr.Return value-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-return-form ctx state env type-env value origin))]
    [(ast.AstExpr.Break)
      (lower-loop-control-form ctx state env type-env origin "break")]
    [(ast.AstExpr.Continue)
      (lower-loop-control-form ctx state env type-env origin "continue")]
    ;; `(comptime expr)` folds to a literal via the scalar CTFE evaluator.
    ;; Successful folds reuse the ordinary literal path; CTFE rejections (free
    ;; runtime vars and unsupported CTFE forms surface as lower errors.
    [(ast.AstExpr.Comptime inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (ctfe.compiler-ctfe-eval
          inner
          (tc_core.tc-ctfe-env ctx)
          (ctfe.ctfe-fuel-limit))
          [(ctfe.ResultCtfe.Ok value _)
            (match value
              [(ctfe.CompilerCtfeValue.Type ty)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      (string.append
                        "type value "
                        (string.append
                          (tc_core.tc-type-render
                            (tc_core.tc-resolve-type ctx ty))
                          " is compile-time only")))))]
              [(ctfe.CompilerCtfeValue.String _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "String value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.Name _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "String value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.Expr _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "Expr value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.ExprList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprList value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.ExprClause _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprClause value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.ExprClauseList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprClauseList value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.ExprBindingClause _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprBindingClause value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.ExprBindingClauseList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprBindingClauseList value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.Pattern _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "Pattern value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.PatternList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "PatternList value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.MatchArm _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "MatchArm value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.MatchArmList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "MatchArmList value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.LetBinding _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "LetBinding value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.LetBindingList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "LetBindingList value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.TypeInfo _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeInfo value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.TypeInfoBox _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeInfo box value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.TypeInfoList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeInfoList value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.TypeField _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeField value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.TypeFieldList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeFieldList value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.TypeVariantPayload _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariantPayload value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.TypeVariantPayloadList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariantPayloadList value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.TypeVariant _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariant value is compile-time only")))]
              [(ctfe.CompilerCtfeValue.TypeVariantList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariantList value is compile-time only")))]
              [_
                (lower-materialize
                  state
                  (lower-literal-value-with-type
                    (ctfe.ctfe-value-to-literal-for-type value expr-ty)
                    expr-ty)
                  expr-ty)])]
          [(ctfe.ResultCtfe.Err diag) (ResultLowerExpr.Err diag)]))]
    [(ast.AstExpr.Quote _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr origin "Expr value is compile-time only")))]
    [(ast.AstExpr.Quasiquote _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr origin "Expr value is compile-time only")))]
    [(ast.AstExpr.Unquote _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "unquote is only valid inside quasiquote")))]
    [(ast.AstExpr.UnquoteSplicing _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "unquote-splicing is only valid inside quasiquote")))]
    [(ast.AstExpr.TypeLiteral ty-id)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (string.append
              "type value "
              (string.append
                (tc_core.tc-type-render
                  (tc_core.tc-resolve-type
                    ctx
                    (tc_core.tc-context-type-get ctx ty-id)))
                " is compile-time only")))))]
    ;; `(ptr-null : T)` is a pointer-sized zero (pointer ABI size is 8);
    ;; `(ptr-null? p)` is `p == 0` producing a `bool`. No new IR/asm needed.
    [(ast.AstExpr.PtrNull _)
      (match (lower-materialize
        state
        (ir.CompilerIrValue.I64 0)
        (ast.AstType.U64))
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr null-state null-value _)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr null-state null-value expr-ty))])]
        [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)])]
    [(ast.AstExpr.PtrNullCheck inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-expr ctx state env type-env inner)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr inner-state inner-value _)
                (ResultLowerExpr.Ok
                  (lower-emit-binop
                    inner-state
                    ir.CompilerIrBinOp.Eq
                    inner-value
                    (ir.CompilerIrValue.I64 0)
                    (ast.AstType.Bool)))])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(ast.AstExpr.PtrAddrOf place-box)
      (let
        [place : ast.AstExpr (lower-context-expr-get ctx place-box)]
        (match (tc_core.tc-ptr-addr-of-place ctx type-env place)
          [(tc_core.ResultTcType.Ok _)
            (match (match (ast.ast-expr-unspan place)
              [(ast.AstExpr.Var name)
                (lower-ptr-addr-of-local-address
                  ctx
                  state
                  env
                  type-env
                  name
                  origin)]
              [_
                (lower-mutable-place-address
                  ctx
                  state
                  env
                  type-env
                  place
                  origin)])
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr addr-state addr-value _)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr addr-state addr-value expr-ty))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))]))]
    [(ast.AstExpr.PtrRead ptr-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr ptr-state ptr-value _)
                (lower-array-elem-ref-result ctx ptr-state ptr-value expr-ty)])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok ptr-lowered)
            (match ptr-lowered
              [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
                ;; Preserve left-to-right evaluation: the value expression may
                ;; lower to calls or other effects, so keep the pointer in its own
                ;; raw pointer temp before lowering the value.
                (match (lower-state-alloc-var ptr-state)
                  [(LowerAlloc.Alloc ptr-allocated ptr-var)
                    (let
                      [ptr-home-state : LowerState
                        (lower-state-emit
                          ptr-allocated
                          (ir.CompilerIrInstr.Mov
                            ptr-var
                            ptr-value
                            (lower-raw-pointer-ir-type ptr-ty)))]
                      (match (tc_core.tc-mut-pointer-elem
                        (tc_core.tc-resolve-type ctx ptr-ty)
                        "lower: ptr-write! requires MutPtr pointer operand")
                        [(tc_core.ResultTcType.Ok elem-ty)
                          (match (lower-expr-expected
                            ctx
                            ptr-home-state
                            env
                            type-env
                            value
                            (tc_core.tc-type-without-regions elem-ty)
                            value)
                            [(ResultLowerExpr.Ok value-lowered)
                              (match value-lowered
                                [(LowerExpr.Expr value-state value-ir value-ty)
                                  (ResultLowerExpr.Ok
                                    (LowerExpr.Expr
                                      ;; Raw-pointer writes use the same storage
                                      ;; contract as array element writes.
                                      ;; Memory aggregates are represented by
                                      ;; an address and must copy their complete
                                      ;; inline representation; StorePtr would
                                      ;; otherwise write that address into only
                                      ;; the first word. Two-word register
                                      ;; groups likewise need both words.
                                      (if (and
                                        (lower-mode-inline-aggregates?
                                          (lower-state-mode value-state))
                                        (lower-type-inline-storage?
                                          ctx
                                          value-ty)
                                        (not
                                          (lower-type-register-resident?
                                            ctx
                                            value-ty)))
                                        (lower-copy-bytes
                                          value-state
                                          (ir.CompilerIrValue.Var ptr-var)
                                          0
                                          value-ir
                                          0
                                          (lower-type-size ctx value-ty))
                                        (if (lower-type-register-group?
                                          ctx
                                          value-ty)
                                          (lower-store-group-at-ptr
                                            ctx
                                            value-state
                                            (ir.CompilerIrValue.Var ptr-var)
                                            value-ir
                                            value-ty)
                                          (lower-state-emit-at-expr
                                            value-state
                                            (ir.CompilerIrInstr.StorePtr
                                              (ir.CompilerIrValue.Var ptr-var)
                                              value-ir
                                              value-ty)
                                            origin)))
                                      ir.CompilerIrValue.Unit
                                      expr-ty))])]
                            [(ResultLowerExpr.Err diag)
                              (ResultLowerExpr.Err diag)])]
                        [(tc_core.ResultTcType.Err message)
                          (ResultLowerExpr.Err
                            (box (lower-diagnostic-at-expr origin message)))]))])])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        [offset : ast.AstExpr (lower-context-expr-get ctx offset-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok ptr-lowered)
            (match ptr-lowered
              [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
                (match (lower-expr-expected
                  ctx
                  ptr-state
                  env
                  type-env
                  offset
                  (ast.AstType.I64)
                  offset)
                  [(ResultLowerExpr.Ok offset-lowered)
                    (match offset-lowered
                      [(LowerExpr.Expr offset-state offset-value _)
                        (match (tc_core.tc-type-strip-region
                          (tc_core.tc-resolve-type ctx ptr-ty))
                          [(ast.AstType.Ptr elem-ty)
                            (match (lower-emit-elem-addr-gep
                              ctx
                              offset-state
                              ptr-value
                              offset-value
                              (tc_core.tc-context-type-get ctx elem-ty))
                              [(LowerExpr.Expr gep-state gep-value _)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr gep-state gep-value expr-ty))])]
                          [(ast.AstType.MutPtr elem-ty)
                            (match (lower-emit-elem-addr-gep
                              ctx
                              offset-state
                              ptr-value
                              offset-value
                              (tc_core.tc-context-type-get ctx elem-ty))
                              [(LowerExpr.Expr gep-state gep-value _)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr gep-state gep-value expr-ty))])]
                          [_
                            (ResultLowerExpr.Err
                              (box
                                (lower-diagnostic-at-expr
                                  origin
                                  "lower: ptr-offset requires raw pointer")))])])]
                  [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)])])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(ast.AstExpr.PtrCast ptr-box _)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
                (ResultLowerExpr.Ok
                  (lower-cast-value ptr-state ptr-value ptr-ty expr-ty))])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(ast.AstExpr.PtrToInt ptr-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
                (ResultLowerExpr.Ok
                  (lower-cast-value ptr-state ptr-value ptr-ty expr-ty))])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(ast.AstExpr.IntToPtr value-box _)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (match (lower-expr ctx state env type-env value)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr value-state value-ir value-ty)
                (ResultLowerExpr.Ok
                  (lower-cast-value value-state value-ir value-ty expr-ty))])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(ast.AstExpr.StringData str-box)
      (let
        [str : ast.AstExpr (lower-context-expr-get ctx str-box)]
        (lower-string-data ctx state env type-env str expr-ty))]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        [len : ast.AstExpr (lower-context-expr-get ctx len-box)]
        (lower-string-from-bytes ctx state env type-env ptr len))]
    [(ast.AstExpr.ArrayData array-box)
      (let
        [array : ast.AstExpr (lower-context-expr-get ctx array-box)]
        (lower-array-data ctx state env type-env array expr-ty))]
    [(ast.AstExpr.ProgramArgc) (lower-entry-load state 0 expr-ty)]
    [(ast.AstExpr.ProgramArgv) (lower-entry-load state 1 expr-ty)]
    [(ast.AstExpr.ProgramEnvp) (lower-entry-load state 2 expr-ty)]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : ast.AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 0))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : ast.AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 1))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : ast.AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 2))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : ast.AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 3))]
    [(ast.AstExpr.Xgetbv index-box)
      (let
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-xgetbv ctx state env type-env index))]
    [(ast.AstExpr.Syscall args) (lower-syscall ctx state env type-env args)]
    [_
      (ResultLowerExpr.Err
        (box (lower-diagnostic-at-expr origin "lower: unsupported expression")))]))

(define (lower-expr-with-type-and-coerce
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-with-type ctx state env type-env expr origin expr-ty)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr next-state value actual-ty)
          (ResultLowerExpr.Ok
            (lower-coerce-value next-state value actual-ty expected-ty))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-expr-and-coerce
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-expr-with-expected-or-actual ctx type-env expr expected-ty)
    [(tc_core.ResultTcType.Ok actual-ty)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        expr
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx actual-ty))
        expected-ty)]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-expr-expected
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [expected-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-expected ctx state env type-env inner expected-ty origin))]
    [(ast.AstExpr.Literal lit)
      (lower-materialize-at-expr
        state
        (lower-literal-value-with-type lit expected-ty)
        expected-ty
        origin)]
    [(ast.AstExpr.Unary _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(ast.AstExpr.Binary _ _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(ast.AstExpr.Let _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(ast.AstExpr.Begin _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(ast.AstExpr.Unsafe _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(ast.AstExpr.Array _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(ast.AstExpr.DynArray _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(ast.AstExpr.Tuple _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-if
          ctx
          state
          env
          type-env
          cond
          then-branch
          else-branch
          expected-ty))]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-match ctx state env type-env scrutinee arms expected-ty))])]
    [(ast.AstExpr.Box inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box ctx state env type-env inner expected-ty))]
    [(ast.AstExpr.BoxGet inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expected-ty))]
    [(ast.AstExpr.BoxTake inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expected-ty))]
    [(ast.AstExpr.Borrow _ _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(ast.AstExpr.Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id-with-pools
        (tc_core.tc-context-pools ctx)
        maybe-ty-id)
        [(ast.AstMaybeType.No)
          (lower-init-expr
            ctx
            state
            env
            type-env
            expected-ty
            origin
            expected-ty)]
        [(ast.AstMaybeType.Some _)
          (lower-expr-and-coerce ctx state env type-env expr expected-ty)])]
    [(ast.AstExpr.Call func-box _)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        [expected-resolved : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx expected-ty))]
        (if (match (tc_core.tc-type-strip-region expected-resolved)
          [(ast.AstType.Enum _) true]
          [(ast.AstType.EnumArgs _ _) true]
          [_ false])
          (lower-expr-with-type-and-coerce
            ctx
            state
            env
            type-env
            expr
            origin
            expected-resolved
            expected-ty)
          (match (ast.ast-expr-unspan func)
            [(ast.AstExpr.Var name)
              (match (lower-lookup-type-id
                ctx
                (lower-state-type-cache state)
                env
                type-env
                name)
                [(tc_core.ResultTcType.Ok fn-ty)
                  (match (tc_core.tc-type-strip-region
                    (tc_core.tc-resolve-type ctx fn-ty))
                    [(ast.AstType.Func _ ret-ty)
                      (let
                        [actual-ty : ast.AstType
                          (tc_core.tc-type-without-regions
                            (tc_core.tc-resolve-type
                              ctx
                              (tc_core.tc-context-type-get ctx ret-ty)))]
                        (if (tc_core.tc-type-eq actual-ty expected-resolved)
                          (lower-expr-with-type-and-coerce
                            ctx
                            state
                            env
                            type-env
                            expr
                            origin
                            actual-ty
                            expected-ty)
                          (lower-expr-and-coerce
                            ctx
                            state
                            env
                            type-env
                            expr
                            expected-ty)))]
                    [_
                      (lower-expr-and-coerce
                        ctx
                        state
                        env
                        type-env
                        expr
                        expected-ty)])]
                [(tc_core.ResultTcType.Err _)
                  (lower-expr-and-coerce
                    ctx
                    state
                    env
                    type-env
                    expr
                    expected-ty)])]
            [_ (lower-expr-and-coerce ctx state env type-env expr expected-ty)])))]
    [_ (lower-expr-and-coerce ctx state env type-env expr expected-ty)]))

(define (lower-struct-get-named
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [receiver-value : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field-id : i64]
  [field : String]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-struct-field-info-for-mode
    ctx
    (lower-state-mode state)
    struct-id
    struct-name
    field-id
    field)
    [(ResultLowerFieldInfo.Ok info)
      (match info
        [(LowerFieldInfo.Info offset field-ty)
          ;; When the receiver is a register-resident struct, its value is
          ;; the packed word itself; extract the field with shift/mask instead of
          ;; computing an address and loading from memory.
          (if (tc_core.tc-name-register-resident-id? ctx struct-id)
            (if (lower-type-register-group? ctx (ast.AstType.Struct struct-id))
              ;; 2-word register-group receiver: select the field's word with
              ;; CompilerIrInstr.Word, then shift/mask within that word at its relative
              ;; offset.
              (match (lower-emit-word
                state
                receiver-value
                (/ offset 8)
                (lower-register-word-type
                  ctx
                  (ast.AstType.Struct struct-id)
                  (/ offset 8)))
                [(LowerExpr.Expr w-state w-value _)
                  (match (lower-extract-word-field
                    ctx
                    w-state
                    w-value
                    (lower-register-word-type
                      ctx
                      (ast.AstType.Struct struct-id)
                      (/ offset 8))
                    (- offset (* (/ offset 8) 8))
                    field-ty)
                    [(LowerExpr.Expr ext-state ext-value _)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr ext-state ext-value result-ty))])])
              (match (lower-extract-word-field
                ctx
                state
                receiver-value
                (lower-register-word-type ctx (ast.AstType.Struct struct-id) 0)
                offset
                field-ty)
                [(LowerExpr.Expr ext-state ext-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr ext-state ext-value result-ty))]))
            (match (lower-gep-byte state receiver-value offset)
              [(LowerExpr.Expr ptr-state ptr _)
                ;; A register-resident field is carried as a packed word,
                ;; so its value is the LOADED word, never the field address --
                ;; exclude it from the in-place pointer-return shape (otherwise a
                ;; later `match`/`=` would read the address as if it were the tag).
                ;; A genuine memory aggregate field still returns its in-place
                ;; pointer. This mirrors `lower-load-inline-value-at-offset`.
                (cond
                  [(and
                      (not (lower-type-register-resident? ctx field-ty))
                      (or
                        (and
                          (lower-struct-repr-c-id? ctx struct-id)
                          (lower-repr-c-inline-field? ctx field-ty))
                        (and
                          (lower-mode-inline-aggregates?
                            (lower-state-mode ptr-state))
                          (lower-type-inline-storage? ctx field-ty))))
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr ptr-state ptr result-ty))]
                  [(lower-type-register-group? ctx field-ty)
                    (match (lower-load-group-from-ptr
                      ctx
                      ptr-state
                      ptr
                      field-ty)
                      [(LowerExpr.Expr g-state g-value _)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr g-state g-value result-ty))])]
                  [(lower-type-register-resident? ctx field-ty)
                    (match (lower-state-alloc-var ptr-state)
                      [(LowerAlloc.Alloc allocated var-id)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-state-emit
                              allocated
                              (ir.CompilerIrInstr.Load
                                var-id
                                ptr
                                (lower-register-word-type ctx field-ty 0)))
                            (ir.CompilerIrValue.Var var-id)
                            result-ty))])]
                  [else
                    (match (lower-state-alloc-var ptr-state)
                      [(LowerAlloc.Alloc allocated var-id)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-state-emit
                              allocated
                              (ir.CompilerIrInstr.Load var-id ptr field-ty))
                            (ir.CompilerIrValue.Var var-id)
                            result-ty))])])]))])]
    [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)]))

(define (lower-struct-get-through-reference
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [receiver-value : ir.CompilerIrValue]
  [referent-ty : ast.AstType]
  [struct-id : i64]
  [struct-name : String]
  [field-id : i64]
  [field : String]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (if (lower-type-register-resident? ctx referent-ty)
    (lower-load-register-resident-from-ptr ctx state receiver-value referent-ty)
    (LowerExpr.Expr state receiver-value referent-ty))
    [(LowerExpr.Expr value-state value _)
      (lower-struct-get-named
        ctx
        value-state
        value
        struct-id
        struct-name
        field-id
        field
        result-ty)]))

(define (lower-struct-get
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [field : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [field-name : String (tc_core.tc-env-key-name-text field)]
    (match (lower-expr ctx state env type-env receiver)
      [(ResultLowerExpr.Ok lowered)
        (match lowered
          [(LowerExpr.Expr receiver-state receiver-value receiver-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type ctx receiver-ty))
              [(ast.AstType.Struct struct-name)
                (lower-struct-get-named
                  ctx
                  receiver-state
                  receiver-value
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field
                  field-name
                  result-ty)]
              [(ast.AstType.StructArgs struct-name _)
                (lower-struct-get-named
                  ctx
                  receiver-state
                  receiver-value
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field
                  field-name
                  result-ty)]
              [(ast.AstType.Ref _ referent-ty)
                (match (tc_core.tc-type-strip-region
                  (tc_core.tc-resolve-type
                    ctx
                    (tc_core.tc-context-type-get ctx referent-ty)))
                  [(ast.AstType.Struct struct-name)
                    (lower-struct-get-through-reference
                      ctx
                      receiver-state
                      receiver-value
                      (tc_core.tc-context-type-get ctx referent-ty)
                      struct-name
                      (tc_core.tc-nominal-name-id-display struct-name)
                      field
                      field-name
                      result-ty)]
                  [(ast.AstType.StructArgs struct-name _)
                    (lower-struct-get-through-reference
                      ctx
                      receiver-state
                      receiver-value
                      (tc_core.tc-context-type-get ctx referent-ty)
                      struct-name
                      (tc_core.tc-nominal-name-id-display struct-name)
                      field
                      field-name
                      result-ty)]
                  [_
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          receiver
                          "lower: struct-get requires struct")))])]
              [(ast.AstType.MutRef _ referent-ty)
                (match (tc_core.tc-type-strip-region
                  (tc_core.tc-resolve-type
                    ctx
                    (tc_core.tc-context-type-get ctx referent-ty)))
                  [(ast.AstType.Struct struct-name)
                    (lower-struct-get-through-reference
                      ctx
                      receiver-state
                      receiver-value
                      (tc_core.tc-context-type-get ctx referent-ty)
                      struct-name
                      (tc_core.tc-nominal-name-id-display struct-name)
                      field
                      field-name
                      result-ty)]
                  [(ast.AstType.StructArgs struct-name _)
                    (lower-struct-get-through-reference
                      ctx
                      receiver-state
                      receiver-value
                      (tc_core.tc-context-type-get ctx referent-ty)
                      struct-name
                      (tc_core.tc-nominal-name-id-display struct-name)
                      field
                      field-name
                      result-ty)]
                  [_
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          receiver
                          "lower: struct-get requires struct")))])]
              [_
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      receiver
                      "lower: struct-get requires struct")))])])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

;; Lower `(box expr)`: evaluate `expr`, reserve arena storage sized for
;; its (pointer-shaped) value via `tl_alloc`, store the value at offset 0, and
;; return the box handle (the storage pointer) typed as the `(Box T)` result.
(define (lower-box
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-box-set-inner-type ctx result-ty)
    [(tc_core.ResultTcType.Ok expected-inner-ty)
      (match (lower-expr-expected
        ctx
        state
        env
        type-env
        inner
        (tc_core.tc-type-without-regions expected-inner-ty)
        inner)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr inner-state inner-value inner-ty)
              (match (lower-reserve-heap-storage
                inner-state
                (lower-type-size ctx inner-ty)
                result-ty)
                [(LowerExpr.Expr base-state base _)
                  ;; A register-resident inner value is a word; store it
                  ;; scalar into the box rather than byte-copying from a pointer.
                  (if (and
                    (lower-type-inline-storage? ctx inner-ty)
                    (not (lower-type-register-resident? ctx inner-ty)))
                    (match (lower-inline-aggregate-copy-size ctx inner-ty)
                      [(ResultLowerSize.Ok size)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-copy-bytes
                              base-state
                              base
                              0
                              inner-value
                              0
                              size)
                            base
                            result-ty))]
                      [(ResultLowerSize.Err message)
                        (ResultLowerExpr.Err (box (lower-diagnostic message)))])
                    (if (lower-type-register-group? ctx inner-ty)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-store-group-at-ptr
                            ctx
                            base-state
                            base
                            inner-value
                            inner-ty)
                          base
                          result-ty))
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-store-at-offset
                            base-state
                            base
                            0
                            inner-value
                            inner-ty)
                          base
                          result-ty))))])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr inner message)))]))

(define (lower-deref-from-expected-receiver
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [receiver-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    state
    env
    type-env
    receiver
    receiver-ty
    receiver)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr receiver-state receiver-value _)
          (ResultLowerExpr.Ok
            (lower-load-inline-value-at-offset
              ctx
              receiver-state
              receiver-value
              0
              result-ty
              (lower-state-mode receiver-state)))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; Lower a Box/reference projection: both handles are pointers to the projected
;; value's storage, so the load shape is identical after receiver validation.
(define (lower-box-get
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    inner)
    [(tc_core.ResultTcType.Ok receiver-ty)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx receiver-ty))
        [(ast.AstType.Box _)
          (lower-deref-from-expected-receiver
            ctx
            state
            env
            type-env
            inner
            (ast.ast-ty-box result-ty)
            result-ty)]
        [(ast.AstType.Ref _ _)
          (lower-deref-from-expected-receiver
            ctx
            state
            env
            type-env
            inner
            receiver-ty
            result-ty)]
        [(ast.AstType.MutRef _ _)
          (lower-deref-from-expected-receiver
            ctx
            state
            env
            type-env
            inner
            receiver-ty
            result-ty)]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                inner
                "lower: deref requires Box or reference type")))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr inner message)))]))

(define (lower-box-storage-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [box-expr : ast.AstExpr]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    box-expr)
    [(tc_core.ResultTcType.Ok box-ty)
      (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx box-ty))
        [(ast.AstType.Box _)
          (match (lower-expr ctx state env type-env box-expr)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr box-state box-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr box-state box-value result-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
        [(ast.AstType.MutRef _ _)
          (match (lower-expr ctx state env type-env box-expr)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr receiver-state receiver-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr receiver-state receiver-value result-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
        [(ast.AstType.Ref _ _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: deref mutation requires mutable access")))]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: deref requires Box or reference type")))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr box-expr message)))]))

;; Locate the byte offset and resolved type of tuple element `target` within the
;; element-type list, laying fields out exactly like a struct over those types
;; (each field aligned to its own alignment). Mirrors `lower-field-info-from-list`
;; but indexes by position rather than name.
(define (lower-tuple-elem-info
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]
  [target : i64]
  [index : i64]
  [cursor : i64]) : ResultLowerFieldInfo
  (if (>= index (ast.ast-type-list-len (& types)))
    (ResultLowerFieldInfo.Err
      (box (lower-diagnostic "lower: tuple-ref index out of range")))
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get (& types) index (ast.ast-type-id-fallback)))]
      [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      (if (= index target)
        (ResultLowerFieldInfo.Ok (LowerFieldInfo.Info offset resolved))
        (lower-tuple-elem-info
          ctx
          types
          target
          (+ index 1)
          (+ offset (lower-type-size ctx resolved)))))))

;; Evaluate each tuple element (preserving side effects even for zero-sized
;; elements) and store the sized ones into the aggregate at their field offset,
;; threading the lowering state. Mirrors the per-field store loop of `lower-box`
;; generalized over the element-type list.
(define (lower-tuple-store-elems
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [values : ast.AstExprList]
  [types : ast.AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-tuple-store-elems-at
    ctx
    state
    env
    type-env
    base
    (& values)
    (& types)
    0
    cursor))

(define (lower-tuple-store-elems-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [values : (& values ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [cursor : i64]) : ResultLowerState
  (if (>= index (struct-get values len))
    (ResultLowerState.Ok state)
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: tuple arity mismatch")))
      (let
        [value : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get values index 0))]
        [ty : ast.AstType
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        [size : i64 (lower-type-size ctx resolved)]
        (match (lower-expr-expected ctx state env type-env value resolved value)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr elem-state elem-value _)
                (lower-tuple-store-elems-at
                  ctx
                  (if (> size 0)
                    (lower-store-inline-value-at-offset
                      ctx
                      elem-state
                      base
                      offset
                      elem-value
                      resolved
                      size)
                    elem-state)
                  env
                  type-env
                  base
                  values
                  types
                  (+ index 1)
                  (+ offset size))])]
          [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])))))

;; Lower `(tuple v0 v1 ...)`: reserve struct-shaped aggregate storage for the
;; element types, store each element at its field offset, and return the storage
;; pointer typed as the tuple. Tuple expressions remain address-shaped even
;; though their inline byte layout is recursive (nested copies use the bytes).
;; Mirrors `src/lower.rs` `lower_tuple`.
(define (lower-tuple
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [values : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-resolve-type ctx result-ty)
    [(ast.AstType.Tuple elem-tys)
      (match (lower-reserve-heap-storage
        state
        (lower-type-list-storage-size ctx (box-get elem-tys))
        result-ty)
        [(LowerExpr.Expr base-state base _)
          (match (lower-tuple-store-elems
            ctx
            base-state
            env
            type-env
            base
            values
            (box-get elem-tys)
            0)
            [(ResultLowerState.Ok final-state)
              (ResultLowerExpr.Ok (LowerExpr.Expr final-state base result-ty))]
            [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr origin "lower: tuple requires tuple type")))]))

;; Evaluate each fixed-array-literal element (preserving side effects even for
;; zero-sized elements) and store the sized ones at `index * elem-size` into the
;; reserved inline storage, threading the lowering state. Mirrors
;; `lower-tuple-store-elems`, specialized to a single homogeneous element type.
(define (lower-array-literal-store-elems
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [values : ast.AstExprList]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [offset : i64]) : ResultLowerState
  (lower-array-literal-store-elems-at
    ctx
    state
    env
    type-env
    base
    (& values)
    0
    elem-ty
    elem-size
    offset))

(define (lower-array-literal-store-elems-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [values : (& values ast.AstExprList)]
  [value-index : i64]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [offset : i64]) : ResultLowerState
  (if (>= value-index (struct-get values len))
    (ResultLowerState.Ok state)
    (let
      [value : ast.AstExpr
        (lower-context-expr-get
          ctx
          (ast.ast-expr-list-get values value-index 0))]
      (if (> elem-size 0)
        (match (lower-direct-store-rhs-at-offset
          ctx
          state
          env
          type-env
          base
          offset
          value
          elem-ty
          value)
          [(LowerMaybeDirectStore.Store elem-state)
            (lower-array-literal-store-elems-at
              ctx
              elem-state
              env
              type-env
              base
              values
              (+ value-index 1)
              elem-ty
              elem-size
              (+ offset elem-size))]
          [(LowerMaybeDirectStore.Err message) (ResultLowerState.Err message)]
          [(LowerMaybeDirectStore.No)
            (match (lower-expr-expected
              ctx
              state
              env
              type-env
              value
              elem-ty
              value)
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr elem-state elem-value _)
                    (lower-array-literal-store-elems-at
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        elem-state
                        base
                        offset
                        elem-value
                        elem-ty
                        elem-size)
                      env
                      type-env
                      base
                      values
                      (+ value-index 1)
                      elem-ty
                      elem-size
                      (+ offset elem-size))])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (match (lower-expr-expected ctx state env type-env value elem-ty value)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr elem-state _ _)
                (lower-array-literal-store-elems-at
                  ctx
                  elem-state
                  env
                  type-env
                  base
                  values
                  (+ value-index 1)
                  elem-ty
                  elem-size
                  (+ offset elem-size))])]
          [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])))))

;; Lower `(array v0 v1 ...)`: reserve inline storage for `count` elements of the
;; element type, store each element at `index * elem-size`, and return the
;; storage pointer typed as the fixed array. A fixed-array value is pointer-
;; shaped (a pointer to inline storage), matching `array-ref`/`array-set!`, which
;; index off the same base. Mirrors `src/lower.rs` `lower_array_literal`.
(define (lower-array-literal
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [values : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-resolve-type ctx result-ty)
    [(ast.AstType.Array elem-ty count)
      (let
        [resolved-elem : ast.AstType
          (tc_core.tc-resolve-type
            ctx
            (tc_core.tc-context-type-get ctx elem-ty))]
        [elem-size : i64
          (lower-type-size ctx (tc_core.tc-context-type-get ctx elem-ty))]
        [storage-size : i64 (lower-type-size ctx result-ty)]
        (match (lower-reserve-inline-storage state storage-size result-ty)
          [(LowerExpr.Expr base-state base _)
            (match (lower-array-literal-store-elems
              ctx
              base-state
              env
              type-env
              base
              values
              resolved-elem
              elem-size
              0)
              [(ResultLowerState.Ok final-state)
                (ResultLowerExpr.Ok (LowerExpr.Expr final-state base result-ty))]
              [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: array literal requires fixed-array type")))]))

(define (lower-dyn-array-literal-store-elems-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [values : (& values ast.AstExprList)]
  [value-index : i64]
  [elem-ty : ast.AstType]
  [elem-size : i64]) : ResultLowerState
  (if (>= value-index (struct-get values len))
    (ResultLowerState.Ok state)
    (let
      [value : ast.AstExpr
        (lower-context-expr-get
          ctx
          (ast.ast-expr-list-get values value-index 0))]
      (if (> elem-size 0)
        (match (lower-emit-elem-addr-gep
          ctx
          state
          buf-value
          (ir.CompilerIrValue.I64 value-index)
          elem-ty)
          [(LowerExpr.Expr addr-state elem-ptr _)
            (match (lower-direct-store-rhs-into
              ctx
              addr-state
              env
              type-env
              elem-ptr
              value
              elem-ty
              value)
              [(LowerMaybeDirectStore.Store elem-state)
                (lower-dyn-array-literal-store-elems-at
                  ctx
                  elem-state
                  env
                  type-env
                  buf-value
                  values
                  (+ value-index 1)
                  elem-ty
                  elem-size)]
              [(LowerMaybeDirectStore.Err message)
                (ResultLowerState.Err message)]
              [(LowerMaybeDirectStore.No)
                (match (lower-expr-expected
                  ctx
                  addr-state
                  env
                  type-env
                  value
                  elem-ty
                  value)
                  [(ResultLowerExpr.Ok lowered)
                    (match lowered
                      [(LowerExpr.Expr elem-state elem-value _)
                        (lower-dyn-array-literal-store-elems-at
                          ctx
                          (lower-array-elem-store-state
                            ctx
                            elem-state
                            elem-ptr
                            elem-value
                            elem-ty)
                          env
                          type-env
                          buf-value
                          values
                          (+ value-index 1)
                          elem-ty
                          elem-size)])]
                  [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])])
        (match (lower-expr-expected ctx state env type-env value elem-ty value)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr elem-state _ _)
                (lower-dyn-array-literal-store-elems-at
                  ctx
                  elem-state
                  env
                  type-env
                  buf-value
                  values
                  (+ value-index 1)
                  elem-ty
                  elem-size)])]
          [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])))))

(define (lower-dyn-array-literal-store-elems
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [values : ast.AstExprList]
  [elem-ty : ast.AstType]
  [elem-size : i64]) : ResultLowerState
  (lower-dyn-array-literal-store-elems-at
    ctx
    state
    env
    type-env
    buf-value
    (& values)
    0
    elem-ty
    elem-size))

(define (lower-dyn-array-literal
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [values : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx result-ty))
    [(ast.AstType.DynArray elem-ty)
      (let
        [resolved-elem : ast.AstType
          (tc_core.tc-resolve-type
            ctx
            (tc_core.tc-context-type-get ctx elem-ty))]
        [elem-size : i64 (lower-type-size ctx resolved-elem)]
        [count : i64 (tc_core.tc-expr-list-len values)]
        [byte-count : ir.CompilerIrValue
          (ir.CompilerIrValue.I64 (* count elem-size))]
        [arr-ty : ast.AstType (ast.ast-ty-dyn-array resolved-elem)]
        (match (lower-state-alloc-var state)
          [(LowerAlloc.Alloc buf-alloc buf-var)
            (let
              [alloc-state : LowerState
                (lower-state-emit
                  buf-alloc
                  (ir.CompilerIrInstr.Call
                    buf-var
                    (lower-tl-alloc-symbol)
                    (ir.CompilerIrCallArgs.One byte-count)
                    (ast.AstType.U64)))]
              (match (lower-dyn-array-literal-store-elems
                ctx
                alloc-state
                env
                type-env
                (ir.CompilerIrValue.Var buf-var)
                values
                resolved-elem
                elem-size)
                [(ResultLowerState.Ok final-state)
                  (lower-make-array-store-fat
                    final-state
                    arr-ty
                    buf-var
                    (ir.CompilerIrValue.I64 count))]
                [(ResultLowerState.Err message) (ResultLowerExpr.Err message)]))]))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: dynamic array literal requires dynamic-array type")))]))

;; Lower `(tuple-ref t i)`: evaluate the tuple, compute element `i`'s offset, and
;; load it (returning the unit value for a zero-sized element, which was never
;; stored). Mirrors `src/lower.rs` `lower_tuple_ref`.
(define (lower-tuple-ref
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [tuple-expr : ast.AstExpr]
  [index : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env tuple-expr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr tuple-state tuple-value tuple-ty)
          (match (tc_core.tc-resolve-type ctx tuple-ty)
            [(ast.AstType.Tuple elem-tys)
              (match (lower-tuple-elem-info ctx (box-get elem-tys) index 0 0)
                [(ResultLowerFieldInfo.Ok info)
                  (match info
                    [(LowerFieldInfo.Info offset elem-ty)
                      (if (> (lower-type-size ctx elem-ty) 0)
                        (match (lower-load-inline-value-at-offset
                          ctx
                          tuple-state
                          tuple-value
                          offset
                          elem-ty
                          (lower-state-mode tuple-state))
                          [(LowerExpr.Expr load-state load-value _)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr load-state load-value result-ty))])
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            tuple-state
                            ir.CompilerIrValue.Unit
                            result-ty)))])]
                [(ResultLowerFieldInfo.Err message)
                  (ResultLowerExpr.Err message)])]
            [_
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    tuple-expr
                    "lower: tuple-ref requires tuple")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-string-ref-byte
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc gep-alloc gep-var)
      (let
        [gep-state : LowerState
          (lower-state-emit
            gep-alloc
            (ir.CompilerIrInstr.Gep
              gep-var
              data-ptr
              index-value
              (ast.AstType.Char)))]
        (match (lower-state-alloc-var gep-state)
          [(LowerAlloc.Alloc load-alloc load-var)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-state-emit
                  load-alloc
                  (ir.CompilerIrInstr.Load
                    load-var
                    (ir.CompilerIrValue.Var gep-var)
                    (ast.AstType.Char)))
                (ir.CompilerIrValue.Var load-var)
                (ast.AstType.Char)))]))]))

(define (lower-string-ref-load
  [state : LowerState]
  [str-value : ir.CompilerIrValue]
  [index-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state str-value)
    [(LowerStringFields.Fields fields-state data-ptr str-len)
      (match (lower-cast-value
        fields-state
        index-value
        (ast.AstType.I64)
        (ast.AstType.U64))
        [(LowerExpr.Expr index-u-state index-u _)
          (match (lower-cast-value
            index-u-state
            str-len
            (ast.AstType.I64)
            (ast.AstType.U64))
            [(LowerExpr.Expr len-u-state len-u _)
              (match (lower-state-fresh-label len-u-state "str_bounds_ok")
                [(LowerLabel.Label bounds-ok-state bounds-ok-label)
                  (lower-string-ref-byte
                    (lower-state-emit
                      bounds-ok-state
                      (ir.CompilerIrInstr.BoundsCheck
                        index-u
                        len-u
                        bounds-ok-label))
                    data-ptr
                    index-value)])])])]))

(define (lower-string-ref
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [str : ast.AstExpr]
  [index : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env str)
    [(ResultLowerExpr.Ok lowered-str)
      (match lowered-str
        [(LowerExpr.Expr str-state str-value str-ty)
          (if (lower-string-handle-type? ctx str-ty)
            (match (lower-integer-expr-with-expected-or-actual
              ctx
              str-state
              env
              type-env
              index
              (ast.AstType.I64)
              "lower: string index must be integer")
              [(ResultLowerExpr.Ok lowered-index)
                (match lowered-index
                  [(LowerExpr.Expr index-state index-raw index-ty)
                    (match (lower-cast-value
                      index-state
                      index-raw
                      index-ty
                      (ast.AstType.I64))
                      [(LowerExpr.Expr index-i-state index-value _)
                        (match (lower-string-ref-load
                          index-i-state
                          str-value
                          index-value)
                          [(ResultLowerExpr.Ok loaded)
                            (match loaded
                              [(LowerExpr.Expr loaded-state value ty)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr
                                    (lower-state-record-latest-bounds-check-named-at-expr
                                      loaded-state
                                      "str_bounds_ok"
                                      origin)
                                    value
                                    ty))])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  str
                  "lower: string-ref requires String"))))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-slice-view-static-source-fields
  [state : LowerState]
  [source-value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [elem-ty : ast.AstType]
  [count : i64]) : ResultLowerSliceViewSourceFields
  ;; Fixed arrays and references to fixed arrays are represented as a raw
  ;; pointer to their inline storage.  Cast that pointer to the ABI's U64 word
  ;; and carry the compile-time element count as an I64 value.
  (match (lower-cast-value state source-value source-ty (ast.AstType.U64))
    [(LowerExpr.Expr ptr-state ptr _)
      (ResultLowerSliceViewSourceFields.Ok
        (LowerSliceViewSourceFields.Fields
          ptr-state
          ptr
          (ir.CompilerIrValue.I64 count)
          elem-ty))]))

(define (lower-slice-view-dynamic-source-fields
  [state : LowerState]
  [source-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : ResultLowerSliceViewSourceFields
  ;; Dynamic arrays (and references to them) point at a two-word descriptor:
  ;; data pointer at byte offset 0, signed length at byte offset 8.
  (match (lower-load-at-offset state source-value 0 (ast.AstType.U64))
    [(LowerExpr.Expr ptr-state ptr _)
      (match (lower-load-at-offset ptr-state source-value 8 (ast.AstType.I64))
        [(LowerExpr.Expr len-state len _)
          (ResultLowerSliceViewSourceFields.Ok
            (LowerSliceViewSourceFields.Fields len-state ptr len elem-ty))])]))

(define (lower-slice-view-reference-slice-fields
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [source-value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [elem-ty : ast.AstType]) : ResultLowerSliceViewSourceFields
  ;; A borrowed Slice is already a two-word register group.  Extracting both
  ;; words preserves the source value without touching a descriptor.
  (match (lower-emit-word
    state
    source-value
    0
    (lower-register-word-type ctx source-ty 0))
    [(LowerExpr.Expr ptr-state ptr _)
      (match (lower-emit-word
        ptr-state
        source-value
        1
        (lower-register-word-type ctx source-ty 1))
        [(LowerExpr.Expr len-state len _)
          (ResultLowerSliceViewSourceFields.Ok
            (LowerSliceViewSourceFields.Fields len-state ptr len elem-ty))])]))

(define (lower-slice-view-invalid-source [source : ast.AstExpr]) : ResultLowerSliceViewSourceFields
  (ResultLowerSliceViewSourceFields.Err
    (box
      (lower-diagnostic-at-expr
        source
        "lower: slice-view source must be a fixed array, dynamic array, or borrowed reference to one"))))

(define (lower-slice-view-referent-fields
  [ctx : tc_core.TcContext]
  [source-state : LowerState]
  [source-value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [referent : ast.AstType]
  [source : ast.AstExpr]) : ResultLowerSliceViewSourceFields
  (match referent
    [(ast.AstType.Array elem count)
      (lower-slice-view-static-source-fields
        source-state
        source-value
        source-ty
        (tc_core.tc-context-type-get ctx elem)
        count)]
    [(ast.AstType.DynArray elem)
      (lower-slice-view-dynamic-source-fields
        source-state
        source-value
        (tc_core.tc-context-type-get ctx elem))]
    [(ast.AstType.Slice elem)
      (lower-slice-view-reference-slice-fields
        ctx
        source-state
        source-value
        source-ty
        (tc_core.tc-context-type-get ctx elem))]
    [_ (lower-slice-view-invalid-source source)]))

(define (lower-slice-view-source-fields
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source : ast.AstExpr]) : ResultLowerSliceViewSourceFields
  (match (lower-expr ctx state env type-env source)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr source-state source-value source-ty)
          (let
            [resolved : ast.AstType
              (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx source-ty))]
            (match resolved
              [(ast.AstType.Array elem count)
                (lower-slice-view-static-source-fields
                  source-state
                  source-value
                  source-ty
                  (tc_core.tc-context-type-get ctx elem)
                  count)]
              [(ast.AstType.DynArray elem)
                (lower-slice-view-dynamic-source-fields
                  source-state
                  source-value
                  (tc_core.tc-context-type-get ctx elem))]
              [(ast.AstType.Ref _ inner)
                (lower-slice-view-referent-fields
                  ctx
                  source-state
                  source-value
                  source-ty
                  (tc_core.tc-type-strip-region
                    (tc_core.tc-resolve-type
                      ctx
                      (tc_core.tc-context-type-get ctx inner)))
                  source)]
              [(ast.AstType.MutRef _ inner)
                (lower-slice-view-referent-fields
                  ctx
                  source-state
                  source-value
                  source-ty
                  (tc_core.tc-type-strip-region
                    (tc_core.tc-resolve-type
                      ctx
                      (tc_core.tc-context-type-get ctx inner)))
                  source)]
              [_ (lower-slice-view-invalid-source source)]))])]
    [(ResultLowerExpr.Err message)
      (ResultLowerSliceViewSourceFields.Err message)]))

(define (lower-slice-view-pack
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (lower-emit-pack
    state
    (ir.compiler-ir-value-cons
      ptr
      (ir.compiler-ir-value-cons len-value ir.CompilerIrValueList.Nil))
    result-ty))

(define (lower-slice-view-finish-after-len-check
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [src-ptr : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [len-ok-var : i64]
  [fail-label : i64]
  [copy-label : i64]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [fail-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          state
          (ir.CompilerIrInstr.Branch
            (ir.CompilerIrValue.Var len-ok-var)
            copy-label
            fail-label))
        fail-label)]
    [copy-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (ir.CompilerIrInstr.Jump copy-label))
        copy-label)]
    [checked-start : LowerState
      (lower-state-record-latest-bounds-check-named-at-expr
        copy-start
        "slice_view_ok"
        origin)]
    (if (= (lower-type-size ctx elem-ty) 0)
      (ResultLowerExpr.Ok
        (lower-slice-view-pack checked-start src-ptr len-value result-ty))
      (match (lower-emit-elem-addr-gep
        ctx
        checked-start
        src-ptr
        start-value
        elem-ty)
        [(LowerExpr.Expr ptr-state ptr _)
          (ResultLowerExpr.Ok
            (lower-slice-view-pack ptr-state ptr len-value result-ty))]))))

(define (lower-slice-view-check-len
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [fail-label : i64]
  [copy-label : i64]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  ;; Once start <= source length holds, subtract in signed space and compare
  ;; the requested length as unsigned.  This avoids overflow from `start+len`
  ;; while still rejecting negative inputs through the unsigned comparisons.
  (match (lower-emit-binop
    state
    ir.CompilerIrBinOp.Sub
    src-len
    start-value
    (ast.AstType.I64))
    [(LowerExpr.Expr rem-state remaining _)
      (match (lower-cast-value
        rem-state
        remaining
        (ast.AstType.I64)
        (ast.AstType.U64))
        [(LowerExpr.Expr rem-u-state remaining-u _)
          (match (lower-cast-value
            rem-u-state
            len-value
            (ast.AstType.I64)
            (ast.AstType.U64))
            [(LowerExpr.Expr len-u-state len-u _)
              (match (lower-state-alloc-var len-u-state)
                [(LowerAlloc.Alloc len-ok-alloc len-ok-var)
                  (lower-slice-view-finish-after-len-check
                    ctx
                    (lower-state-emit
                      len-ok-alloc
                      (ir.CompilerIrInstr.BinOp
                        len-ok-var
                        ir.CompilerIrBinOp.Le
                        len-u
                        remaining-u
                        (ast.AstType.U64)))
                    src-ptr
                    start-value
                    len-value
                    len-ok-var
                    fail-label
                    copy-label
                    elem-ty
                    result-ty
                    origin)])])])]))

(define (lower-slice-view-bounds-checked
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-cast-value
    state
    start-value
    (ast.AstType.I64)
    (ast.AstType.U64))
    [(LowerExpr.Expr start-u-state start-u _)
      (match (lower-cast-value
        start-u-state
        src-len
        (ast.AstType.I64)
        (ast.AstType.U64))
        [(LowerExpr.Expr src-len-u-state src-len-u _)
          (match (lower-state-alloc-var src-len-u-state)
            [(LowerAlloc.Alloc start-ok-alloc start-ok-var)
              (let
                [start-ok-state : LowerState
                  (lower-state-emit
                    start-ok-alloc
                    (ir.CompilerIrInstr.BinOp
                      start-ok-var
                      ir.CompilerIrBinOp.Le
                      start-u
                      src-len-u
                      (ast.AstType.U64)))]
                (match (lower-state-fresh-label
                  start-ok-state
                  "slice_view_start_ok")
                  [(LowerLabel.Label rem-label-state rem-label)
                    (match (lower-state-fresh-label
                      rem-label-state
                      "slice_view_bounds_fail")
                      [(LowerLabel.Label fail-label-state fail-label)
                        (match (lower-state-fresh-label
                          fail-label-state
                          "slice_view_ok")
                          [(LowerLabel.Label copy-label-state copy-label)
                            (let
                              [rem-start : LowerState
                                (lower-state-finish-block
                                  (lower-state-emit
                                    copy-label-state
                                    (ir.CompilerIrInstr.Branch
                                      (ir.CompilerIrValue.Var start-ok-var)
                                      rem-label
                                      fail-label))
                                  rem-label)]
                              (lower-slice-view-check-len
                                ctx
                                rem-start
                                src-ptr
                                src-len
                                start-value
                                len-value
                                fail-label
                                copy-label
                                elem-ty
                                result-ty
                                origin))])])]))])])]))

(define (lower-slice-view-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 3)
    (let
      [source : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [start : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [len : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 2 0))]
      (match (lower-slice-view-source-fields ctx state env type-env source)
        [(ResultLowerSliceViewSourceFields.Ok fields)
          (match fields
            [(LowerSliceViewSourceFields.Fields
                source-state
                src-ptr
                src-len
                elem-ty)
              (match (lower-integer-expr-with-expected-or-actual
                ctx
                source-state
                env
                type-env
                start
                (ast.AstType.I64)
                "lower: slice-view start must be integer")
                [(ResultLowerExpr.Ok lowered-start)
                  (match lowered-start
                    [(LowerExpr.Expr start-state start-raw start-ty)
                      (match (lower-cast-value
                        start-state
                        start-raw
                        start-ty
                        (ast.AstType.I64))
                        [(LowerExpr.Expr start-i-state start-value _)
                          (match (lower-integer-expr-with-expected-or-actual
                            ctx
                            start-i-state
                            env
                            type-env
                            len
                            (ast.AstType.I64)
                            "lower: slice-view length must be integer")
                            [(ResultLowerExpr.Ok lowered-len)
                              (match lowered-len
                                [(LowerExpr.Expr len-state len-raw len-ty)
                                  (match (lower-cast-value
                                    len-state
                                    len-raw
                                    len-ty
                                    (ast.AstType.I64))
                                    [(LowerExpr.Expr len-i-state len-value _)
                                      (lower-slice-view-bounds-checked
                                        ctx
                                        len-i-state
                                        src-ptr
                                        src-len
                                        start-value
                                        len-value
                                        elem-ty
                                        result-ty
                                        origin)])])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)])])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerSliceViewSourceFields.Err message)
          (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic-at-expr
          origin
          "lower: slice-view expects exactly three arguments")))))

(define (lower-substring-call-runtime
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit
            allocated
            (ir.CompilerIrInstr.Call
              var-id
              (lower-tl-substring-symbol)
              (ir.compiler-ir-call-args-from-list
                (ir.compiler-ir-value-cons
                  src-ptr
                  (ir.compiler-ir-value-cons
                    start-value
                    (ir.compiler-ir-value-cons
                      len-value
                      ir.CompilerIrValueList.Nil))))
              (ast.AstType.String)))
          (ir.CompilerIrValue.Var var-id)
          (ast.AstType.String)))]))

(define (lower-substring-finish-after-len-check
  [state : LowerState (:consume)]
  [src-ptr : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [len-ok-var : i64]
  [fail-label : i64]
  [copy-label : i64]) : ResultLowerExpr
  (let
    [fail-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          state
          (ir.CompilerIrInstr.Branch
            (ir.CompilerIrValue.Var len-ok-var)
            copy-label
            fail-label))
        fail-label)]
    [copy-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (ir.CompilerIrInstr.Jump copy-label))
        copy-label)]
    (lower-substring-call-runtime copy-start src-ptr start-value len-value)))

(define (lower-substring-check-len
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [fail-label : i64]
  [copy-label : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc rem-alloc rem-var)
      (let
        [rem-state : LowerState
          (lower-state-emit
            rem-alloc
            (ir.CompilerIrInstr.BinOp
              rem-var
              ir.CompilerIrBinOp.Sub
              src-len
              start-value
              (ast.AstType.I64)))]
        (match (lower-cast-value
          rem-state
          (ir.CompilerIrValue.Var rem-var)
          (ast.AstType.I64)
          (ast.AstType.U64))
          [(LowerExpr.Expr rem-u-state rem-u _)
            (match (lower-cast-value
              rem-u-state
              len-value
              (ast.AstType.I64)
              (ast.AstType.U64))
              [(LowerExpr.Expr len-u-state len-u _)
                (match (lower-state-alloc-var len-u-state)
                  [(LowerAlloc.Alloc len-ok-alloc len-ok-var)
                    (let
                      [len-ok-state : LowerState
                        (lower-state-emit
                          len-ok-alloc
                          (ir.CompilerIrInstr.BinOp
                            len-ok-var
                            ir.CompilerIrBinOp.Le
                            len-u
                            rem-u
                            (ast.AstType.U64)))]
                      (lower-substring-finish-after-len-check
                        len-ok-state
                        src-ptr
                        start-value
                        len-value
                        len-ok-var
                        fail-label
                        copy-label))])])]))]))

(define (lower-substring-bounds-checked
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-cast-value
    state
    start-value
    (ast.AstType.I64)
    (ast.AstType.U64))
    [(LowerExpr.Expr start-u-state start-u _)
      (match (lower-cast-value
        start-u-state
        src-len
        (ast.AstType.I64)
        (ast.AstType.U64))
        [(LowerExpr.Expr src-len-u-state src-len-u _)
          (match (lower-state-alloc-var src-len-u-state)
            [(LowerAlloc.Alloc start-ok-alloc start-ok-var)
              (let
                [start-ok-state : LowerState
                  (lower-state-emit
                    start-ok-alloc
                    (ir.CompilerIrInstr.BinOp
                      start-ok-var
                      ir.CompilerIrBinOp.Le
                      start-u
                      src-len-u
                      (ast.AstType.U64)))]
                (match (lower-state-fresh-label
                  start-ok-state
                  "substr_start_ok")
                  [(LowerLabel.Label rem-label-state rem-label)
                    (match (lower-state-fresh-label
                      rem-label-state
                      "substr_bounds_fail")
                      [(LowerLabel.Label fail-label-state fail-label)
                        (match (lower-state-fresh-label
                          fail-label-state
                          "substr_ok")
                          [(LowerLabel.Label copy-label-state copy-label)
                            (let
                              [rem-start : LowerState
                                (lower-state-finish-block
                                  (lower-state-emit
                                    copy-label-state
                                    (ir.CompilerIrInstr.Branch
                                      (ir.CompilerIrValue.Var start-ok-var)
                                      rem-label
                                      fail-label))
                                  rem-label)]
                              (lower-substring-check-len
                                rem-start
                                src-ptr
                                src-len
                                start-value
                                len-value
                                fail-label
                                copy-label))])])]))])])]))

(define (lower-substring
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [str : ast.AstExpr]
  [start : ast.AstExpr]
  [len : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env str)
    [(ResultLowerExpr.Ok lowered-str)
      (match lowered-str
        [(LowerExpr.Expr str-state str-value str-ty)
          (if (lower-string-handle-type? ctx str-ty)
            (match (lower-string-fields str-state str-value)
              [(LowerStringFields.Fields fields-state src-ptr src-len)
                (match (lower-integer-expr-with-expected-or-actual
                  ctx
                  fields-state
                  env
                  type-env
                  start
                  (ast.AstType.I64)
                  "lower: substring start must be integer")
                  [(ResultLowerExpr.Ok lowered-start)
                    (match lowered-start
                      [(LowerExpr.Expr start-state start-raw start-ty)
                        (match (lower-cast-value
                          start-state
                          start-raw
                          start-ty
                          (ast.AstType.I64))
                          [(LowerExpr.Expr start-i-state start-value _)
                            (match (lower-integer-expr-with-expected-or-actual
                              ctx
                              start-i-state
                              env
                              type-env
                              len
                              (ast.AstType.I64)
                              "lower: substring length must be integer")
                              [(ResultLowerExpr.Ok lowered-len)
                                (match lowered-len
                                  [(LowerExpr.Expr len-state len-raw len-ty)
                                    (match (lower-cast-value
                                      len-state
                                      len-raw
                                      len-ty
                                      (ast.AstType.I64))
                                      [(LowerExpr.Expr len-i-state len-value _)
                                        (lower-substring-bounds-checked
                                          len-i-state
                                          src-ptr
                                          src-len
                                          start-value
                                          len-value)])])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  str
                  "lower: substring requires String"))))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-string-concat
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [exprs : ast.AstExprList
      (lower-string-concat-exprs-all ctx env type-env args)]
    ;; A single public stdlib wrapper call already has compact, stable codegen.
    ;; Keep it on the ordinary direct-call path; only a nested public tree needs
    ;; the fused runtime batches. Legacy intrinsics have always used the runtime
    ;; path, including their two-leaf form.
    (if (and
      (lower-string-concat-public-target? name)
      (= (struct-get (& exprs) len) 2))
      (lower-direct-call-id
        ctx
        state
        env
        type-env
        source-id
        name
        args
        result-ty
        origin)
      (lower-string-concat-exprs ctx state env type-env exprs))))

(define (lower-c-abi-runtime-handle-extern? [name : String]) : bool
  (or
    (lower-string-prefix-at? name "tl_" 0)
    (lower-string-prefix-at? name ".L_tl_" 0)))

(define (lower-c-abi-extern-call?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [name : String]) : bool
  (cond
    [(not (lower-mode-c-abi? (lower-state-mode state))) false]
    [(sym_i64_env.sym-i64-contains-id env name-id) false]
    [(lower-c-abi-runtime-handle-extern? name) false]
    [else
      (let
        [handle : i64
          (csym.compiler-symbols-lookup-value-id-or
            (tc_core.tc-context-symbols ctx)
            name-id
            (csym.compiler-symbols-missing-handle))]
        (and
          (csym.compiler-symbols-handle-found? handle)
          (=
            (csym.compiler-symbol-handle-kind handle)
            (csym.compiler-symbol-kind-extern))
          (lower-symbol-function-value-id? ctx name-id)))]))

(define (lower-c-abi-extern-value-call?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [name : String]) : bool
  (cond
    [(not (lower-mode-c-abi? (lower-state-mode state))) false]
    [(sym_i64_env.sym-i64-contains-id env name-id) false]
    [(lower-c-abi-runtime-handle-extern? name) false]
    [else (lower-extern-value-decl-id? ctx name-id)]))

(define (lower-c-abi-integer-field-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Char) true]
    [(ast.AstType.Ptr _) true]
    [(ast.AstType.MutPtr _) true]
    [_ false]))

(define (lower-c-abi-inline-fields-integer-only?
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]) : bool
  (lower-c-abi-inline-fields-integer-only-at? ctx fields 0))

(define (lower-c-abi-inline-fields-integer-only-at?
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [index : i64]) : bool
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    true
    (and
      (lower-c-abi-integer-field-type?
        ctx
        (tc_core.tc-inline-field-layout-type
          (tc_core.tc-inline-field-layout-list-ref fields index)))
      (lower-c-abi-inline-fields-integer-only-at? ctx fields (+ index 1)))))

(define (lower-c-abi-win64-register-struct-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
    [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(tc_core.TcInlineAggregateLayout.Struct _ _ fields)
          (lower-c-abi-inline-fields-win64-register? ctx fields)]
        [(tc_core.TcInlineAggregateLayout.Enum _ _ _) false])]
    [(tc_core.ResultTcInlineAggregateLayout.Err _) false]))

(define (lower-c-abi-win64-register-field-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Struct name) (lower-c-abi-win64-register-struct-id? ctx name)]
    [(ast.AstType.StructArgs name _)
      (lower-c-abi-win64-register-struct-id? ctx name)]
    [(ast.AstType.F32) true]
    [(ast.AstType.F64) true]
    [_ (lower-c-abi-integer-field-type? ctx ty)]))

(define (lower-c-abi-inline-fields-win64-register?
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]) : bool
  (lower-c-abi-inline-fields-win64-register-at? ctx fields 0))

(define (lower-c-abi-inline-fields-win64-register-at?
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [index : i64]) : bool
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    true
    (and
      (lower-c-abi-win64-register-field-type?
        ctx
        (tc_core.tc-inline-field-layout-type
          (tc_core.tc-inline-field-layout-list-ref fields index)))
      (lower-c-abi-inline-fields-win64-register-at? ctx fields (+ index 1)))))

(define (lower-c-abi-register-aggregate-fields-ok?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [fields : tc_core.TcInlineFieldLayoutList]) : bool
  (if (lower-mode-windows-c-abi? mode)
    (lower-c-abi-inline-fields-win64-register? ctx fields)
    (lower-c-abi-inline-fields-integer-only? ctx fields)))

(define (lower-c-abi-integer-scalar-type [size : i64]) : ast.AstType
  (cond
    [(<= size 1) (ast.AstType.U8)]
    [(<= size 2) (ast.AstType.U16)]
    [(<= size 4) (ast.AstType.U32)]
    [else (ast.AstType.U64)]))

(define (lower-c-abi-target-name [mode : CompilerLowerMode]) : String
  (if (lower-mode-windows-c-abi? mode)
    "windows-x86_64"
    "linux-x86_64"))

(define (lower-c-abi-register-aggregate-size?
  [mode : CompilerLowerMode]
  [size : i64]) : bool
  (if (lower-mode-windows-c-abi? mode)
    (or (= size 1) (= size 2) (= size 4) (= size 8))
    (and (> size 0) (<= size 8))))

(define (lower-c-abi-aggregate-size-message [mode : CompilerLowerMode]) : String
  (if (lower-mode-windows-c-abi? mode)
    "scalar structs of size 1, 2, 4, or 8 bytes, including nested scalar struct fields"
    "System V aggregate structs/enums, including register-class and MEMORY-class layouts"))

(define (lower-c-abi-unsupported-message
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : String
  (string.append
    (string.append "lower: unsupported " (lower-c-abi-target-name mode))
    (string.append
      " C aggregate ABI for "
      (string.append
        (tc_core.tc-type-render ty)
        (string.append
          "; this slice supports "
          (lower-c-abi-aggregate-size-message mode))))))

(define (lower-internal-abi-unsupported-message
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : String
  (string.append
    (string.append "lower: unsupported " (lower-c-abi-target-name mode))
    (string.append
      " internal aggregate ABI for "
      (string.append
        (tc_core.tc-type-render ty)
        "; tuple/fixed-array parameters and returns require a non-zero finite inline layout"))))

(define (lower-c-abi-two-register-return-message [ty : ast.AstType]) : String
  (string.append
    "lower: unsupported linux-x86_64 C two-register aggregate return ABI for "
    (tc_core.tc-type-render ty)))

(define (lower-c-abi-sysv-slot-size [size : i64] [slot-index : i64]) : i64
  (if (= slot-index 0)
    (if (> size 8)
      8
      size)
    (- size 8)))

(define (lower-c-abi-sysv-merge-integer [current : LowerCAbiEightbyteClass]) : LowerCAbiEightbyteClass
  (match current
    [(LowerCAbiEightbyteClass.Unsupported)
      (LowerCAbiEightbyteClass.Unsupported)]
    [_ (LowerCAbiEightbyteClass.Integer)]))

(define (lower-c-abi-sysv-slot-base [offset : i64]) : i64
  (* (/ offset 8) 8))

(define (lower-c-abi-sysv-pack-f32-sse?
  [current-ty : ast.AstType]
  [current-offset : i64]
  [next-ty : ast.AstType]
  [next-offset : i64]) : bool
  (match current-ty
    [(ast.AstType.F32)
      (match next-ty
        [(ast.AstType.F32)
          (let
            [base : i64 (lower-c-abi-sysv-slot-base current-offset)]
            (and
              (= (lower-c-abi-sysv-slot-base next-offset) base)
              (= current-offset base)
              (= next-offset (+ base 4))))]
        [_ false])]
    [_ false]))

(define (lower-c-abi-sysv-merge-sse
  [current : LowerCAbiEightbyteClass]
  [ty : ast.AstType]
  [offset : i64]) : LowerCAbiEightbyteClass
  (match current
    [(LowerCAbiEightbyteClass.Empty) (LowerCAbiEightbyteClass.Sse ty offset)]
    [(LowerCAbiEightbyteClass.Integer) (LowerCAbiEightbyteClass.Integer)]
    [(LowerCAbiEightbyteClass.Sse current-ty current-offset)
      (if (lower-c-abi-sysv-pack-f32-sse? current-ty current-offset ty offset)
        ;; A `{ f32, f32 }` eightbyte is still an SSE-class argument. Carry it
        ;; as an opaque 8-byte XMM payload, not as an INTEGER slot.
        (LowerCAbiEightbyteClass.Sse
          (ast.AstType.F64)
          (lower-c-abi-sysv-slot-base offset))
        (LowerCAbiEightbyteClass.Unsupported))]
    [(LowerCAbiEightbyteClass.Unsupported)
      (LowerCAbiEightbyteClass.Unsupported)]))

(define (lower-c-abi-sysv-mark-integer-slot
  [slots : LowerCAbiSysvSlots]
  [slot-index : i64]) : LowerCAbiSysvSlots
  (match slots
    [(LowerCAbiSysvSlots.Slots first second)
      (if (= slot-index 0)
        (LowerCAbiSysvSlots.Slots (lower-c-abi-sysv-merge-integer first) second)
        (if (= slot-index 1)
          (LowerCAbiSysvSlots.Slots
            first
            (lower-c-abi-sysv-merge-integer second))
          (LowerCAbiSysvSlots.Unsupported)))]
    [(LowerCAbiSysvSlots.Unsupported) (LowerCAbiSysvSlots.Unsupported)]))

(define (lower-c-abi-sysv-mark-integer-range
  [slots : LowerCAbiSysvSlots]
  [offset : i64]
  [size : i64]) : LowerCAbiSysvSlots
  (if (<= size 0)
    slots
    (let
      [first-slot : i64 (/ offset 8)]
      [last-slot : i64 (/ (+ offset (- size 1)) 8)]
      (if (= first-slot last-slot)
        (lower-c-abi-sysv-mark-integer-slot slots first-slot)
        (lower-c-abi-sysv-mark-integer-slot
          (lower-c-abi-sysv-mark-integer-slot slots first-slot)
          last-slot)))))

(define (lower-c-abi-sysv-mark-sse-slot
  [slots : LowerCAbiSysvSlots]
  [ty : ast.AstType]
  [offset : i64]) : LowerCAbiSysvSlots
  (let
    [slot-index : i64 (/ offset 8)]
    (match slots
      [(LowerCAbiSysvSlots.Slots first second)
        (if (= slot-index 0)
          (LowerCAbiSysvSlots.Slots
            (lower-c-abi-sysv-merge-sse first ty offset)
            second)
          (if (= slot-index 1)
            (LowerCAbiSysvSlots.Slots
              first
              (lower-c-abi-sysv-merge-sse second ty offset))
            (LowerCAbiSysvSlots.Unsupported)))]
      [(LowerCAbiSysvSlots.Unsupported) (LowerCAbiSysvSlots.Unsupported)])))

(define (lower-c-abi-sysv-classify-fields
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-c-abi-sysv-classify-fields-at ctx fields base-offset slots 0))

(define (lower-c-abi-sysv-classify-fields-at
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    slots
    (let
      [field : tc_core.TcInlineFieldLayout
        (tc_core.tc-inline-field-layout-list-ref fields index)]
      (lower-c-abi-sysv-classify-fields-at
        ctx
        fields
        base-offset
        (lower-c-abi-sysv-classify-type
          ctx
          (tc_core.tc-inline-field-layout-type field)
          (+ base-offset (tc_core.tc-inline-field-layout-offset field))
          slots)
        (+ index 1)))))

(define (lower-c-abi-sysv-classify-payloads
  [ctx : tc_core.TcContext]
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-c-abi-sysv-classify-payloads-at ctx payloads base-offset slots 0))

(define (lower-c-abi-sysv-classify-payloads-at
  [ctx : tc_core.TcContext]
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-payload-layout-list-count payloads))
    slots
    (let
      [payload : tc_core.TcInlinePayloadLayout
        (tc_core.tc-inline-payload-layout-list-ref payloads index)]
      (lower-c-abi-sysv-classify-payloads-at
        ctx
        payloads
        base-offset
        (lower-c-abi-sysv-classify-type
          ctx
          (tc_core.tc-inline-payload-layout-type payload)
          (+ base-offset (tc_core.tc-inline-payload-layout-offset payload))
          slots)
        (+ index 1)))))

(define (lower-c-abi-sysv-classify-variants
  [ctx : tc_core.TcContext]
  [variants : tc_core.TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-c-abi-sysv-classify-variants-at ctx variants base-offset slots 0))

(define (lower-c-abi-sysv-classify-variants-at
  [ctx : tc_core.TcContext]
  [variants : tc_core.TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-variant-layout-list-count variants))
    slots
    (match (tc_core.tc-inline-variant-layout-list-ref variants index)
      [(tc_core.TcInlineVariantLayout.Variant _ _ _ payloads)
        (lower-c-abi-sysv-classify-variants-at
          ctx
          variants
          base-offset
          (lower-c-abi-sysv-classify-payloads ctx payloads base-offset slots)
          (+ index 1))])))

(define (lower-c-abi-sysv-classify-layout
  [ctx : tc_core.TcContext]
  [layout : tc_core.TcInlineAggregateLayout]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match layout
    [(tc_core.TcInlineAggregateLayout.Struct _ _ fields)
      (lower-c-abi-sysv-classify-fields ctx fields base-offset slots)]
    [(tc_core.TcInlineAggregateLayout.Enum _ _ variants)
      ;; Synthetic tagged-union view: int64 tag at offset 0 plus every variant
      ;; payload overlaid in the union region starting at offset 8.
      (lower-c-abi-sysv-classify-variants
        ctx
        variants
        base-offset
        (lower-c-abi-sysv-mark-integer-range slots base-offset 8))]))

(define (lower-c-abi-sysv-classify-struct-id
  [ctx : tc_core.TcContext]
  [name-id : i64]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
    [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
      (lower-c-abi-sysv-classify-layout ctx layout base-offset slots)]
    [(tc_core.ResultTcInlineAggregateLayout.Err _)
      (LowerCAbiSysvSlots.Unsupported)]))

(define (lower-c-abi-sysv-classify-type
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (match resolved
      [(ast.AstType.Struct name)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(ast.AstType.StructArgs name _)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(ast.AstType.Enum name)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(ast.AstType.EnumArgs name _)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(ast.AstType.F64)
        (lower-c-abi-sysv-mark-sse-slot slots (ast.AstType.F64) offset)]
      [(ast.AstType.F32)
        (lower-c-abi-sysv-mark-sse-slot slots (ast.AstType.F32) offset)]
      [_
        (if (lower-c-abi-integer-field-type? ctx resolved)
          (lower-c-abi-sysv-mark-integer-range
            slots
            offset
            (lower-type-size ctx resolved))
          (LowerCAbiSysvSlots.Unsupported))])))

(define (lower-c-abi-sysv-slot-from-class
  [class : LowerCAbiEightbyteClass]
  [size : i64]
  [slot-index : i64]) : LowerCAbiSlot
  (let
    [slot-size : i64 (lower-c-abi-sysv-slot-size size slot-index)]
    [slot-offset : i64 (* slot-index 8)]
    (match class
      [(LowerCAbiEightbyteClass.Sse ty offset) (LowerCAbiSlot.Slot ty offset)]
      [_
        (LowerCAbiSlot.Slot
          (lower-c-abi-integer-scalar-type slot-size)
          slot-offset)])))

(define (lower-c-abi-slot-list-count [slots : LowerCAbiSlotList]) : i64
  (struct-get slots count))

(define (lower-c-abi-slot-list-ref [slots : LowerCAbiSlotList] [index : i64]) : LowerCAbiSlot
  (array-ref (struct-get slots items) index))

(define (lower-c-abi-slot-list-single [slot : LowerCAbiSlot]) : LowerCAbiSlotList
  (let
    [items : (__tl_dyn-array LowerCAbiSlot) (make-array LowerCAbiSlot 1)]
    (begin
      (array-set! items 0 slot)
      (LowerCAbiSlotList items 1))))

(define (lower-c-abi-slot-list-pair
  [first : LowerCAbiSlot]
  [second : LowerCAbiSlot]) : LowerCAbiSlotList
  (let
    [items : (__tl_dyn-array LowerCAbiSlot) (make-array LowerCAbiSlot 2)]
    (begin
      (array-set! items 0 first)
      (array-set! items 1 second)
      (LowerCAbiSlotList items 2))))

(define (lower-sysv-register-aggregate-from-slots
  [size : i64]
  [slots : LowerCAbiSysvSlots]
  [allow-return? : bool]
  [unsupported-message : String]) : LowerCAbiAggregate
  (cond
    [(<= size 0) (LowerCAbiAggregate.Unsupported unsupported-message)]
    [(> size 16)
      (if allow-return?
        (LowerCAbiAggregate.Sret size)
        (LowerCAbiAggregate.Memory size))]
    [else
      (match slots
        [(LowerCAbiSysvSlots.Slots first second)
          (match first
            [(LowerCAbiEightbyteClass.Unsupported)
              (LowerCAbiAggregate.Unsupported unsupported-message)]
            [_
              (match second
                [(LowerCAbiEightbyteClass.Unsupported)
                  (LowerCAbiAggregate.Unsupported unsupported-message)]
                [_
                  (if (> size 8)
                    (LowerCAbiAggregate.Register
                      (lower-c-abi-slot-list-pair
                        (lower-c-abi-sysv-slot-from-class first size 0)
                        (lower-c-abi-sysv-slot-from-class second size 1))
                      size)
                    (LowerCAbiAggregate.Register
                      (lower-c-abi-slot-list-single
                        (lower-c-abi-sysv-slot-from-class first size 0))
                      size))])])]
        [(LowerCAbiSysvSlots.Unsupported)
          (LowerCAbiAggregate.Unsupported unsupported-message)])]))

(define (lower-c-abi-sysv-register-aggregate-from-slots
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [slots : LowerCAbiSysvSlots]
  [allow-return? : bool]) : LowerCAbiAggregate
  (lower-sysv-register-aggregate-from-slots
    size
    slots
    allow-return?
    (lower-c-abi-unsupported-message mode resolved)))

(define (lower-internal-sysv-register-aggregate-from-slots
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [slots : LowerCAbiSysvSlots]
  [allow-return? : bool]) : LowerCAbiAggregate
  (lower-sysv-register-aggregate-from-slots
    size
    slots
    allow-return?
    (lower-internal-abi-unsupported-message mode resolved)))

(define (lower-c-abi-sysv-register-aggregate
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [fields : tc_core.TcInlineFieldLayoutList]
  [allow-return? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0)
      (LowerCAbiAggregate.Unsupported
        (lower-c-abi-unsupported-message mode resolved))]
    [(> size 16)
      (if allow-return?
        (LowerCAbiAggregate.Sret size)
        (LowerCAbiAggregate.Memory size))]
    [(and
        (lower-c-abi-register-aggregate-size? mode size)
        (lower-c-abi-register-aggregate-fields-ok? ctx mode fields))
      (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)]
    [else
      (lower-c-abi-sysv-register-aggregate-from-slots
        mode
        resolved
        size
        (lower-c-abi-sysv-classify-fields
          ctx
          fields
          0
          (LowerCAbiSysvSlots.Slots
            (LowerCAbiEightbyteClass.Empty)
            (LowerCAbiEightbyteClass.Empty)))
        allow-return?)]))

(define (lower-c-abi-sysv-register-enum-aggregate
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [align : i64]
  [variants : tc_core.TcInlineVariantLayoutList]
  [allow-return? : bool]) : LowerCAbiAggregate
  (if (tc_core.tc-inline-enum-layout-tag-only? size variants)
    (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)
    (lower-c-abi-sysv-register-aggregate-from-slots
      mode
      resolved
      size
      (lower-c-abi-sysv-classify-layout
        ctx
        (tc_core.TcInlineAggregateLayout.Enum size align variants)
        0
        (LowerCAbiSysvSlots.Slots
          (LowerCAbiEightbyteClass.Empty)
          (LowerCAbiEightbyteClass.Empty)))
      allow-return?)))

(define (lower-c-abi-win64-aggregate-class
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [register-ok? : bool]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (cond
    [(and (lower-c-abi-register-aggregate-size? mode size) register-ok?)
      (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)]
    [(and allow-sret? (> size 8)) (LowerCAbiAggregate.Sret size)]
    [(and allow-byref? (not (lower-c-abi-register-aggregate-size? mode size)))
      (LowerCAbiAggregate.ByRef size)]
    [else
      (LowerCAbiAggregate.Unsupported
        (lower-c-abi-unsupported-message mode resolved))]))

(define (lower-c-abi-aggregate-class-from-layout
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [layout : tc_core.TcInlineAggregateLayout]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (match layout
    [(tc_core.TcInlineAggregateLayout.Struct size _ fields)
      (if (lower-mode-windows-c-abi? mode)
        (lower-c-abi-win64-aggregate-class
          mode
          resolved
          size
          (lower-c-abi-register-aggregate-fields-ok? ctx mode fields)
          allow-sret?
          allow-byref?)
        (lower-c-abi-sysv-register-aggregate
          ctx
          mode
          resolved
          size
          fields
          allow-sret?))]
    [(tc_core.TcInlineAggregateLayout.Enum size align variants)
      (if (lower-mode-windows-c-abi? mode)
        ;; Model the default enum layout as a synthetic C aggregate:
        ;; int64 tag at offset 0 plus the max-sized payload union at offset 8.
        (lower-c-abi-win64-aggregate-class
          mode
          resolved
          size
          (tc_core.tc-inline-enum-layout-tag-only? size variants)
          allow-sret?
          allow-byref?)
        (if (lower-mode-linux-c-abi? mode)
          (lower-c-abi-sysv-register-enum-aggregate
            ctx
            mode
            resolved
            size
            align
            variants
            allow-sret?)
          (LowerCAbiAggregate.Unsupported
            (lower-c-abi-unsupported-message mode resolved))))]))

(define (lower-c-abi-aggregate-class-for-nominal
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [name-id : i64]
  [resolved : ast.AstType]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
    [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
      (lower-c-abi-aggregate-class-from-layout
        ctx
        mode
        resolved
        layout
        allow-sret?
        allow-byref?)]
    [(tc_core.ResultTcInlineAggregateLayout.Err message)
      (LowerCAbiAggregate.Unsupported message)]))

(define (lower-c-abi-aggregate-class-with-flags
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match resolved
      [(ast.AstType.Struct name)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [(ast.AstType.StructArgs name _)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [(ast.AstType.Enum name)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [(ast.AstType.EnumArgs name _)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [_ (LowerCAbiAggregate.No)])))

(define (lower-c-abi-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (lower-c-abi-aggregate-class-with-flags ctx mode ty false true))

(define (lower-c-abi-return-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (lower-c-abi-aggregate-class-with-flags ctx mode ty true false))

;; Internal aggregate ABI classification is deliberately separate from the C
;; extern classifier above.  The latter is selected only for nominal
;; Struct/Enum declarations and is part of the existing extern contract;
;; these helpers select only structural Tuple/Array values for future internal
;; parameter/return lowering.
(define (lower-internal-sysv-classify-tuple-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [cursor : i64]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (if (>= index (ast.ast-type-list-len types))
    slots
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
      [field-align : i64 (lower-type-align ctx resolved)]
      [field-size : i64 (lower-type-size ctx resolved)]
      [offset : i64 (lower-align-up cursor field-align)]
      (lower-internal-sysv-classify-tuple-at
        ctx
        types
        (+ index 1)
        (+ offset field-size)
        base-offset
        (if (<= field-size 0)
          slots
          (lower-internal-sysv-classify-type
            ctx
            resolved
            (+ base-offset offset)
            slots))))))

(define (lower-internal-sysv-classify-array-at
  [ctx : tc_core.TcContext]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [stride : i64]
  [index : i64]
  [count : i64]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (if (>= index count)
    slots
    (lower-internal-sysv-classify-array-at
      ctx
      elem-ty
      elem-size
      stride
      (+ index 1)
      count
      base-offset
      (if (<= elem-size 0)
        slots
        (lower-internal-sysv-classify-type
          ctx
          elem-ty
          (+ base-offset (* index stride))
          slots)))))

(define (lower-internal-sysv-classify-type
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (match resolved
      [(ast.AstType.Tuple elem-types)
        (let
          [types : ast.AstTypeList (box-get elem-types)]
          (lower-internal-sysv-classify-tuple-at ctx (& types) 0 0 offset slots))]
      [(ast.AstType.Array elem-id count)
        (let
          [elem-ty : ast.AstType (tc_core.tc-context-type-get ctx elem-id)]
          [elem-size : i64 (lower-type-size ctx elem-ty)]
          [elem-align : i64 (lower-type-align ctx elem-ty)]
          (lower-internal-sysv-classify-array-at
            ctx
            elem-ty
            elem-size
            (lower-align-up elem-size elem-align)
            0
            count
            offset
            slots))]
      [(ast.AstType.Struct name)
        (lower-internal-sysv-classify-nominal-id ctx name offset slots)]
      [(ast.AstType.StructArgs name _)
        (lower-internal-sysv-classify-nominal-id ctx name offset slots)]
      [(ast.AstType.Enum name)
        (lower-internal-sysv-classify-nominal-id ctx name offset slots)]
      [(ast.AstType.EnumArgs name _)
        (lower-internal-sysv-classify-nominal-id ctx name offset slots)]
      [(ast.AstType.F64)
        (lower-c-abi-sysv-mark-sse-slot slots (ast.AstType.F64) offset)]
      [(ast.AstType.F32)
        (lower-c-abi-sysv-mark-sse-slot slots (ast.AstType.F32) offset)]
      [_
        ;; Every other successfully laid-out value is carried by its actual
        ;; bytes.  TypeLisp handles (String, Box, Func, DynArray, ordinary
        ;; references, and inferred handles) therefore occupy INTEGER
        ;; eightbytes even though they are not C-eligible extern fields.
        (match (tc_core.tc-inline-aggregate-type-layout ctx resolved)
          [(tc_core.ResultTcLayoutInfo.Ok info)
            (let
              [size : i64 (tc_core.tc-layout-info-size info)]
              (if (<= size 0)
                slots
                (lower-c-abi-sysv-mark-integer-range slots offset size)))]
          [(tc_core.ResultTcLayoutInfo.Err _) (LowerCAbiSysvSlots.Unsupported)])])))

(define (lower-internal-sysv-classify-fields
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-internal-sysv-classify-fields-at ctx fields base-offset slots 0))

(define (lower-internal-sysv-classify-fields-at
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    slots
    (let
      [field : tc_core.TcInlineFieldLayout
        (tc_core.tc-inline-field-layout-list-ref fields index)]
      (lower-internal-sysv-classify-fields-at
        ctx
        fields
        base-offset
        (lower-internal-sysv-classify-type
          ctx
          (tc_core.tc-inline-field-layout-type field)
          (+ base-offset (tc_core.tc-inline-field-layout-offset field))
          slots)
        (+ index 1)))))

(define (lower-internal-sysv-classify-payloads
  [ctx : tc_core.TcContext]
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-internal-sysv-classify-payloads-at ctx payloads base-offset slots 0))

(define (lower-internal-sysv-classify-payloads-at
  [ctx : tc_core.TcContext]
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-payload-layout-list-count payloads))
    slots
    (let
      [payload : tc_core.TcInlinePayloadLayout
        (tc_core.tc-inline-payload-layout-list-ref payloads index)]
      (lower-internal-sysv-classify-payloads-at
        ctx
        payloads
        base-offset
        (lower-internal-sysv-classify-type
          ctx
          (tc_core.tc-inline-payload-layout-type payload)
          (+ base-offset (tc_core.tc-inline-payload-layout-offset payload))
          slots)
        (+ index 1)))))

(define (lower-internal-sysv-classify-variants
  [ctx : tc_core.TcContext]
  [variants : tc_core.TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-internal-sysv-classify-variants-at ctx variants base-offset slots 0))

(define (lower-internal-sysv-classify-variants-at
  [ctx : tc_core.TcContext]
  [variants : tc_core.TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-variant-layout-list-count variants))
    slots
    (match (tc_core.tc-inline-variant-layout-list-ref variants index)
      [(tc_core.TcInlineVariantLayout.Variant _ _ _ payloads)
        (lower-internal-sysv-classify-variants-at
          ctx
          variants
          base-offset
          (lower-internal-sysv-classify-payloads ctx payloads base-offset slots)
          (+ index 1))])))

(define (lower-internal-sysv-classify-layout
  [ctx : tc_core.TcContext]
  [layout : tc_core.TcInlineAggregateLayout]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match layout
    [(tc_core.TcInlineAggregateLayout.Struct _ _ fields)
      (lower-internal-sysv-classify-fields ctx fields base-offset slots)]
    [(tc_core.TcInlineAggregateLayout.Enum _ _ variants)
      ;; Synthetic tagged-union view: int64 tag at offset 0 plus every variant
      ;; payload overlaid in the union region starting at offset 8.
      (lower-internal-sysv-classify-variants
        ctx
        variants
        base-offset
        (lower-c-abi-sysv-mark-integer-range slots base-offset 8))]))

(define (lower-internal-sysv-classify-nominal-id
  [ctx : tc_core.TcContext]
  [name-id : i64]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
    [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
      (lower-internal-sysv-classify-layout ctx layout base-offset slots)]
    [(tc_core.ResultTcInlineAggregateLayout.Err _)
      (LowerCAbiSysvSlots.Unsupported)]))

(define (lower-internal-sysv-register-aggregate
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [allow-return? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0)
      (LowerCAbiAggregate.Unsupported
        (lower-internal-abi-unsupported-message mode resolved))]
    [(> size 16)
      (if allow-return?
        (LowerCAbiAggregate.Sret size)
        (LowerCAbiAggregate.Memory size))]
    [else
      (lower-internal-sysv-register-aggregate-from-slots
        mode
        resolved
        size
        (lower-internal-sysv-classify-type
          ctx
          resolved
          0
          (LowerCAbiSysvSlots.Slots
            (LowerCAbiEightbyteClass.Empty)
            (LowerCAbiEightbyteClass.Empty)))
        allow-return?)]))

(define (lower-internal-win64-type-supported?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-inline-aggregate-type-layout ctx ty)
    [(tc_core.ResultTcLayoutInfo.Ok _) true]
    [(tc_core.ResultTcLayoutInfo.Err _) false]))

(define (lower-internal-win64-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [allow-return? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0)
      (LowerCAbiAggregate.Unsupported
        (lower-internal-abi-unsupported-message mode resolved))]
    [(not (lower-mode-windows-c-abi? mode))
      (LowerCAbiAggregate.Unsupported
        (lower-internal-abi-unsupported-message mode resolved))]
    [(not (lower-internal-win64-type-supported? ctx resolved))
      (LowerCAbiAggregate.Unsupported
        (lower-internal-abi-unsupported-message mode resolved))]
    [(lower-c-abi-register-aggregate-size? mode size)
      (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)]
    [allow-return? (LowerCAbiAggregate.Sret size)]
    [(and allow-byref? (not (lower-c-abi-register-aggregate-size? mode size)))
      (LowerCAbiAggregate.ByRef size)]
    [else
      (LowerCAbiAggregate.Unsupported
        (lower-internal-abi-unsupported-message mode resolved))]))

(define (lower-internal-aggregate-class-with-flags
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]
  [allow-return? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match resolved
      [(ast.AstType.Tuple _)
        (match (tc_core.tc-inline-aggregate-type-layout ctx resolved)
          [(tc_core.ResultTcLayoutInfo.Ok info)
            (lower-internal-aggregate-class-from-size
              ctx
              mode
              resolved
              (tc_core.tc-layout-info-size info)
              allow-return?
              allow-byref?)]
          [(tc_core.ResultTcLayoutInfo.Err _)
            (LowerCAbiAggregate.Unsupported
              (lower-internal-abi-unsupported-message mode resolved))])]
      [(ast.AstType.Array _ _)
        (match (tc_core.tc-inline-aggregate-type-layout ctx resolved)
          [(tc_core.ResultTcLayoutInfo.Ok info)
            (lower-internal-aggregate-class-from-size
              ctx
              mode
              resolved
              (tc_core.tc-layout-info-size info)
              allow-return?
              allow-byref?)]
          [(tc_core.ResultTcLayoutInfo.Err _)
            (LowerCAbiAggregate.Unsupported
              (lower-internal-abi-unsupported-message mode resolved))])]
      [_ (LowerCAbiAggregate.No)])))

(define (lower-internal-aggregate-class-from-size
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [allow-return? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (if (lower-mode-windows-c-abi? mode)
    (lower-internal-win64-aggregate-class
      ctx
      mode
      resolved
      size
      allow-return?
      allow-byref?)
    (lower-internal-sysv-register-aggregate
      ctx
      mode
      resolved
      size
      allow-return?)))

(define (lower-internal-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (lower-internal-aggregate-class-with-flags ctx mode ty false true))

(define (lower-internal-return-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (lower-internal-aggregate-class-with-flags ctx mode ty true false))

;; Structural values use the internal convention only for Tuple/Array roots.
;; Keep this predicate alongside the classifier so all signature, call and
;; return paths agree on the same source-level gate.
(define (lower-internal-structural-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Tuple _) true]
    [(ast.AstType.Array _ _) true]
    [_ false]))

;; Call sites pass a type list resolved by the type checker already. Keep this
;; root-only check free of another per-element type resolution on the scalar
;; fast path; regions are transparent for the ABI gate.
(define (lower-internal-structural-resolved-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(ast.AstType.Tuple _) true]
    [(ast.AstType.Array _ _) true]
    [_ false]))

(define (lower-internal-structural-resolved-type-list?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : bool
  (lower-internal-structural-resolved-type-list-at? ctx (& types) 0))

(define (lower-internal-structural-resolved-type-list-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (or
        (lower-internal-structural-resolved-type? ty)
        (lower-internal-structural-resolved-type-list-at? ctx types (+ index 1))))))

(define (lower-internal-structural-type-list?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : bool
  (lower-internal-structural-type-list-at? ctx (& types) 0))

(define (lower-internal-structural-type-list-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (or
        (lower-internal-structural-type? ctx ty)
        (lower-internal-structural-type-list-at? ctx types (+ index 1))))))

(define (lower-internal-aggregate-key
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : String
  (ctfe.ctfe-type-key-with-reflections-and-pools
    (tc_core.tc-context-pools ctx)
    (ctfe.ctfe-reflect-info-list-empty)
    (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))))

(define (lower-internal-group-mask-from-slots [slots : LowerCAbiSlotList]) : i64
  (if (= (lower-c-abi-slot-list-count slots) 2)
    (let
      [first : LowerCAbiSlot (lower-c-abi-slot-list-ref slots 0)]
      [second : LowerCAbiSlot (lower-c-abi-slot-list-ref slots 1)]
      [first-sse : bool
        (match first
          [(LowerCAbiSlot.Slot scalar-ty _)
            (lower-register-word-sse-type? scalar-ty)])]
      [second-sse : bool
        (match second
          [(LowerCAbiSlot.Slot scalar-ty _)
            (lower-register-word-sse-type? scalar-ty)])]
      (+
        (if first-sse
          1
          0)
        (if second-sse
          2
          0)))
    0))

;; Physical transport nominal types are intentionally opaque to the source
;; checker. Their display spelling is consumed by backend ABI classification;
;; the canonical source type key makes collisions impossible across nested
;; tuples/arrays and mixed integer/SSE groups.
(define (lower-internal-transport-type
  [ctx : tc_core.TcContext]
  [resolved : ast.AstType]
  [classification : LowerCAbiAggregate]) : ast.AstType
  (match classification
    [(LowerCAbiAggregate.Integer scalar-ty _) scalar-ty]
    [(LowerCAbiAggregate.Register slots _)
      (if (= (lower-c-abi-slot-list-count slots) 1)
        (match (lower-c-abi-slot-list-ref slots 0)
          [(LowerCAbiSlot.Slot scalar-ty _) scalar-ty])
        (let
          [mask : i64 (lower-internal-group-mask-from-slots slots)]
          [key : String (lower-internal-aggregate-key ctx resolved)]
          [encoded : String
            (string.append
              "__tl_internal_abi_group_m"
              (string.append (string.int->string mask) (string.append "__" key)))]
          (ast.AstType.Struct (lower-derived-symbol-id encoded))))]
    [(LowerCAbiAggregate.Memory size)
      (let
        [key : String (lower-internal-aggregate-key ctx resolved)]
        [encoded : String
          (string.append
            "__tl_internal_abi_mem_s"
            (string.append (string.int->string size) (string.append "__" key)))]
        (ast.AstType.Struct (lower-derived-symbol-id encoded)))]
    [(LowerCAbiAggregate.ByRef _) (ast.AstType.U64)]
    [(LowerCAbiAggregate.Sret _) (ast.AstType.U64)]
    [_ (lower-one-word-register-storage-type ctx resolved)]))

(define (lower-internal-param-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (if (lower-internal-structural-type? ctx ty)
    (lower-internal-aggregate-class ctx mode ty)
    (LowerCAbiAggregate.No)))

(define (lower-internal-return-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (if (lower-internal-structural-type? ctx ty)
    (lower-internal-return-aggregate-class ctx mode ty)
    (LowerCAbiAggregate.No)))

(define (lower-internal-param-physical-type
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : ast.AstType
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (lower-internal-transport-type
      ctx
      resolved
      (lower-internal-param-class ctx mode resolved))))

(define (lower-internal-return-physical-type
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : ast.AstType
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    [classification : LowerCAbiAggregate
      (lower-internal-return-class ctx mode resolved)]
    (match classification
      [(LowerCAbiAggregate.No)
        (lower-one-word-register-storage-type ctx resolved)]
      [_ (lower-internal-transport-type ctx resolved classification)])))

(define (lower-c-abi-register-resident-to-scalar
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [agg-ty : ast.AstType]
  [scalar-ty : ast.AstType]) : LowerExpr
  (let
    [storage-ty : ast.AstType (lower-one-word-register-storage-type ctx agg-ty)]
    (if (and
      (lower-register-word-sse-type? storage-ty)
      (not (tc_core.tc-type-eq storage-ty scalar-ty)))
      (lower-bitcast-value state value storage-ty scalar-ty)
      (LowerExpr.Expr state value scalar-ty))))

(define (lower-c-abi-scalar-to-register-resident
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [scalar-ty : ast.AstType]
  [agg-ty : ast.AstType]) : LowerExpr
  (let
    [storage-ty : ast.AstType (lower-one-word-register-storage-type ctx agg-ty)]
    (if (and
      (lower-register-word-sse-type? storage-ty)
      (not (tc_core.tc-type-eq scalar-ty storage-ty)))
      (match (lower-bitcast-value state value scalar-ty storage-ty)
        [(LowerExpr.Expr bit-state bit-value _)
          (LowerExpr.Expr bit-state bit-value agg-ty)])
      (LowerExpr.Expr state value agg-ty))))

(define (lower-c-abi-args-as
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]) : ResultLowerArgs
  (lower-c-abi-args-as-at ctx state env type-env (& args) (& types) 0))

(define (lower-c-abi-args-as-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index (struct-get args len))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerArgs.Ok state ir.CompilerIrValueList.Nil)
      (ResultLowerArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [arg : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [expected-id : i64
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))]
        [expected : ast.AstType (tc_core.tc-context-type-get ctx expected-id)]
        [arg-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx expected))]
        (match (lower-expr-expected ctx state env type-env arg arg-ty arg)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr arg-state value _)
                (match (lower-c-abi-aggregate-class
                  ctx
                  (lower-state-mode arg-state)
                  arg-ty)
                  [(LowerCAbiAggregate.No)
                    (match (lower-c-abi-args-as-at
                      ctx
                      arg-state
                      env
                      type-env
                      args
                      types
                      (+ index 1))
                      [(ResultLowerArgs.Ok rest-state rest-values)
                        (ResultLowerArgs.Ok
                          rest-state
                          (ir.compiler-ir-value-cons value rest-values))]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerArgs.Err message)])]
                  [(LowerCAbiAggregate.Integer scalar-ty size)
                    ;; A register-resident aggregate is carried as a
                    ;; single-word scalar -- `value` is already the word the C
                    ;; ABI wants in a register, so pass it directly. Any other
                    ;; aggregate (a memory-backed value, e.g. a mixed
                    ;; int/float sub-word struct) is a pointer, so load the
                    ;; scalar out of it. Gate on the same residency predicate
                    ;; that chose the value representation -- not on `size`,
                    ;; since mixed sub-word float structs can still be
                    ;; memory-backed at 8 bytes.
                    (match (if (lower-type-register-resident? ctx arg-ty)
                      (lower-c-abi-register-resident-to-scalar
                        ctx
                        arg-state
                        value
                        arg-ty
                        scalar-ty)
                      (lower-load-at-offset arg-state value 0 scalar-ty))
                      [(LowerExpr.Expr scalar-state scalar-value _)
                        (match (lower-c-abi-args-as-at
                          ctx
                          scalar-state
                          env
                          type-env
                          args
                          types
                          (+ index 1))
                          [(ResultLowerArgs.Ok rest-state rest-values)
                            (ResultLowerArgs.Ok
                              rest-state
                              (ir.compiler-ir-value-cons
                                scalar-value
                                rest-values))]
                          [(ResultLowerArgs.Err message)
                            (ResultLowerArgs.Err message)])])]
                  [(LowerCAbiAggregate.Register slots _)
                    (match (lower-c-abi-register-arg-slot-values
                      ctx
                      arg-state
                      value
                      arg-ty
                      slots)
                      [(ResultLowerArgs.Ok slot-state slot-values)
                        (match (lower-c-abi-args-as-at
                          ctx
                          slot-state
                          env
                          type-env
                          args
                          types
                          (+ index 1))
                          [(ResultLowerArgs.Ok rest-state rest-values)
                            (ResultLowerArgs.Ok
                              rest-state
                              (lower-value-list-append slot-values rest-values))]
                          [(ResultLowerArgs.Err message)
                            (ResultLowerArgs.Err message)])]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerArgs.Err message)])]
                  [(LowerCAbiAggregate.Memory size)
                    ;; The backend consumes size/unit markers and copies the aggregate to %rsp.
                    (match (lower-c-abi-args-as-at
                      ctx
                      arg-state
                      env
                      type-env
                      args
                      types
                      (+ index 1))
                      [(ResultLowerArgs.Ok rest-state rest-values)
                        (ResultLowerArgs.Ok
                          rest-state
                          (ir.compiler-ir-value-cons
                            value
                            (ir.compiler-ir-value-cons
                              (ir.CompilerIrValue.I64 size)
                              (ir.compiler-ir-value-cons
                                (ir.CompilerIrValue.Unit)
                                rest-values))))]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerArgs.Err message)])]
                  [(LowerCAbiAggregate.ByRef _)
                    ;; The ABI argument is the address of the copied object,
                    ;; not the aggregate itself. Type the value as u64 so
                    ;; direct extern-call register assignment does not
                    ;; reclassify this pointer as a multi-word group.
                    (match (lower-copy-inline-aggregate-to-heap-as
                      ctx
                      arg-state
                      value
                      arg-ty
                      (ast.AstType.U64))
                      [(ResultLowerExpr.Ok copied)
                        (match copied
                          [(LowerExpr.Expr copy-state copy-value _)
                            (match (lower-c-abi-args-as-at
                              ctx
                              copy-state
                              env
                              type-env
                              args
                              types
                              (+ index 1))
                              [(ResultLowerArgs.Ok rest-state rest-values)
                                (ResultLowerArgs.Ok
                                  rest-state
                                  (ir.compiler-ir-value-cons
                                    copy-value
                                    rest-values))]
                              [(ResultLowerArgs.Err message)
                                (ResultLowerArgs.Err message)])])]
                      [(ResultLowerExpr.Err message)
                        (ResultLowerArgs.Err message)])]
                  [(LowerCAbiAggregate.Unsupported message)
                    (ResultLowerArgs.Err
                      (box (lower-diagnostic-at-expr arg message)))]
                  [(LowerCAbiAggregate.Sret _)
                    (ResultLowerArgs.Err
                      (box
                        (lower-diagnostic-at-expr
                          arg
                          (lower-c-abi-unsupported-message
                            (lower-state-mode arg-state)
                            arg-ty))))])])]
          [(ResultLowerExpr.Err message) (ResultLowerArgs.Err message)])))))

(define (lower-c-abi-register-arg-slot-values-from
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [arg-ty : ast.AstType]
  [slots : LowerCAbiSlotList]
  [index : i64]) : ResultLowerArgs
  (if (>= index (lower-c-abi-slot-list-count slots))
    (ResultLowerArgs.Ok state ir.CompilerIrValueList.Nil)
    (match (lower-c-abi-slot-list-ref slots index)
      [(LowerCAbiSlot.Slot scalar-ty offset)
        (match (if (lower-type-register-resident? ctx arg-ty)
          (if (lower-type-register-group? ctx arg-ty)
            (lower-emit-word state value (/ offset 8) scalar-ty)
            (LowerExpr.Expr state value scalar-ty))
          (lower-load-at-offset state value offset scalar-ty))
          [(LowerExpr.Expr slot-state slot-value _)
            (match (lower-c-abi-register-arg-slot-values-from
              ctx
              slot-state
              value
              arg-ty
              slots
              (+ index 1))
              [(ResultLowerArgs.Ok rest-state rest-values)
                (ResultLowerArgs.Ok
                  rest-state
                  (ir.compiler-ir-value-cons slot-value rest-values))]
              [(ResultLowerArgs.Err message) (ResultLowerArgs.Err message)])])])))

(define (lower-c-abi-register-arg-slot-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [arg-ty : ast.AstType]
  [slots : LowerCAbiSlotList]) : ResultLowerArgs
  (lower-c-abi-register-arg-slot-values-from ctx state value arg-ty slots 0))

(define (lower-value-list-append
  [values : ir.CompilerIrValueList]
  [tail : ir.CompilerIrValueList]) : ir.CompilerIrValueList
  (match values
    [(ir.CompilerIrValueList.Nil) tail]
    [(ir.CompilerIrValueList.Array seq)
      (lower-value-list-append (ir.compiler-ir-value-seq-to-list seq) tail)]
    [(ir.CompilerIrValueList.Cons head rest)
      (ir.compiler-ir-value-cons
        head
        (lower-value-list-append (box-get rest) tail))]))

(define (lower-c-abi-ir-return-slots-from
  [slots : LowerCAbiSlotList]
  [out : (__tl_dyn-array ir.CompilerIrCAbiReturnSlot)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (match (lower-c-abi-slot-list-ref slots index)
      [(LowerCAbiSlot.Slot scalar-ty offset)
        (begin
          (array-set!
            out
            index
            (ir.CompilerIrCAbiReturnSlot.Slot scalar-ty offset))
          (lower-c-abi-ir-return-slots-from slots out (+ index 1) count))])))

(define (lower-c-abi-ir-return-slots [slots : LowerCAbiSlotList]) : ir.CompilerIrCAbiReturnSlotList
  (let
    [count : i64 (lower-c-abi-slot-list-count slots)]
    [out : (__tl_dyn-array ir.CompilerIrCAbiReturnSlot)
      (array.make-array ir.CompilerIrCAbiReturnSlot count)]
    (begin
      (lower-c-abi-ir-return-slots-from slots out 0 count)
      (ir.CompilerIrCAbiReturnSlotList.Array
        (ir.CompilerIrCAbiReturnSlotSeq out count)))))

(define (lower-c-abi-materialize-stored-register-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (if (lower-type-register-group? ctx result-ty)
    (lower-load-group-from-ptr ctx state base result-ty)
    (LowerExpr.Expr state base result-ty)))

(define (lower-c-abi-finish-call-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [call-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [abi : LowerCAbiAggregate]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match abi
    [(LowerCAbiAggregate.No)
      (ResultLowerExpr.Ok (LowerExpr.Expr state call-value result-ty))]
    [(LowerCAbiAggregate.Integer scalar-ty size)
      ;; A register-resident aggregate is carried as a single-word scalar --
      ;; the C call returns the whole value in a register, which IS that word
      ;; representation, so hand it back directly. Any other aggregate (a
      ;; memory-backed value, e.g. a mixed int/float sub-word struct) is
      ;; referenced by pointer, so spill the returned scalar
      ;; into a fresh slot and return the pointer. Gate on the same residency
      ;; predicate that chose the value representation -- not on `size`, since
      ;; mixed sub-word float structs can still be memory-backed at 8 bytes.
      (if (lower-type-register-resident? ctx result-ty)
        (ResultLowerExpr.Ok
          (lower-c-abi-scalar-to-register-resident
            ctx
            state
            call-value
            scalar-ty
            result-ty))
        (match (lower-reserve-heap-storage state size result-ty)
          [(LowerExpr.Expr base-state base _)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-store-at-offset base-state base 0 call-value scalar-ty)
                base
                result-ty))]))]
    [(LowerCAbiAggregate.Register slots size)
      (let
        [slot-count : i64 (lower-c-abi-slot-list-count slots)]
        (cond
          [(= slot-count 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(LowerCAbiSlot.Slot scalar-ty offset)
                (if (lower-type-register-resident? ctx result-ty)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr state call-value result-ty))
                  (match (lower-reserve-heap-storage state size result-ty)
                    [(LowerExpr.Expr base-state base _)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-store-at-offset
                            base-state
                            base
                            offset
                            call-value
                            scalar-ty)
                          base
                          result-ty))]))])]
          [(= slot-count 0)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-c-abi-unsupported-message
                    (lower-state-mode state)
                    result-ty))))]
          [else
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-c-abi-two-register-return-message result-ty))))]))]
    [(LowerCAbiAggregate.ByRef _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Memory _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Sret _)
      ;; The C callee wrote the >8B result into the caller-provided sret
      ;; buffer, so `call-value` is the buffer pointer. A register-resident result
      ;; (a 16B word-class struct: a 2-word register group in this backend) must
      ;; be materialized back into that two-word group VALUE -- load both words
      ;; and Pack -- or downstream consumers that expect a register pair (e.g. a
      ;; by-value call argument) get the pointer in word0 and garbage in word1.
      ;; A genuine memory aggregate (>16B, or float-containing) stays the pointer.
      (if (lower-type-register-group? ctx result-ty)
        (ResultLowerExpr.Ok
          (lower-load-group-from-ptr ctx state call-value result-ty))
        (ResultLowerExpr.Ok (LowerExpr.Expr state call-value result-ty)))]
    [(LowerCAbiAggregate.Unsupported message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-direct-c-abi-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [param-types : ast.AstTypeList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-c-abi-args-as ctx state env type-env args param-types)
    [(ResultLowerArgs.Ok args-state values)
      (match (lower-c-abi-return-aggregate-class
        ctx
        (lower-state-mode args-state)
        result-ty)
        [(LowerCAbiAggregate.Unsupported message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]
        [(LowerCAbiAggregate.No)
          (match (lower-state-alloc-var args-state)
            [(LowerAlloc.Alloc allocated var-id)
              (let
                [instr : ir.CompilerIrInstr
                  (ir.CompilerIrInstr.Call
                    var-id
                    (lower-resolve-call-name-id-with-display
                      allocated
                      env
                      name-id
                      name)
                    (ir.compiler-ir-call-args-from-list values)
                    result-ty)]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr allocated instr origin)
                  (ir.CompilerIrValue.Var var-id)
                  result-ty
                  (LowerCAbiAggregate.No)
                  origin))])]
        [(LowerCAbiAggregate.Integer scalar-ty size)
          (match (lower-state-alloc-var args-state)
            [(LowerAlloc.Alloc allocated var-id)
              (let
                [instr : ir.CompilerIrInstr
                  (ir.CompilerIrInstr.Call
                    var-id
                    (lower-resolve-call-name-id-with-display
                      allocated
                      env
                      name-id
                      name)
                    (ir.compiler-ir-call-args-from-list values)
                    scalar-ty)]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr allocated instr origin)
                  (ir.CompilerIrValue.Var var-id)
                  result-ty
                  (LowerCAbiAggregate.Integer scalar-ty size)
                  origin))])]
        [(LowerCAbiAggregate.Register slots size)
          (let
            [slot-count : i64 (lower-c-abi-slot-list-count slots)]
            (cond
              [(= slot-count 1)
                (match (lower-c-abi-slot-list-ref slots 0)
                  [(LowerCAbiSlot.Slot scalar-ty _)
                    (match (lower-state-alloc-var args-state)
                      [(LowerAlloc.Alloc allocated var-id)
                        (let
                          [instr : ir.CompilerIrInstr
                            (ir.CompilerIrInstr.Call
                              var-id
                              (lower-resolve-call-name-id-with-display
                                allocated
                                env
                                name-id
                                name)
                              (ir.compiler-ir-call-args-from-list values)
                              scalar-ty)]
                          (lower-c-abi-finish-call-result
                            ctx
                            (lower-state-emit-at-expr allocated instr origin)
                            (ir.CompilerIrValue.Var var-id)
                            result-ty
                            (LowerCAbiAggregate.Register slots size)
                            origin))])])]
              [(= slot-count 0)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      (lower-c-abi-unsupported-message
                        (lower-state-mode args-state)
                        result-ty))))]
              [else
                (match (lower-reserve-heap-storage args-state size result-ty)
                  [(LowerExpr.Expr base-state base _)
                    (let
                      [instr : ir.CompilerIrInstr
                        (ir.ir-instr-call-cabi-store-result
                          base
                          (lower-resolve-call-name-id-with-display
                            base-state
                            env
                            name-id
                            name)
                          (ir.compiler-ir-call-args-from-list values)
                          (lower-c-abi-ir-return-slots slots))]
                      (match (lower-c-abi-materialize-stored-register-result
                        ctx
                        (lower-state-emit-at-expr base-state instr origin)
                        base
                        result-ty)
                        [(LowerExpr.Expr out-state out-value out-ty)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr out-state out-value out-ty))]))])]))]
        [(LowerCAbiAggregate.ByRef _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-c-abi-unsupported-message
                  (lower-state-mode args-state)
                  result-ty))))]
        [(LowerCAbiAggregate.Memory _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-c-abi-unsupported-message
                  (lower-state-mode args-state)
                  result-ty))))]
        [(LowerCAbiAggregate.Sret size)
          ;; Reserve the sret buffer typed as a scalar pointer (U64), NOT
          ;; the aggregate result type. A register-resident result type would make
          ;; the backend classify the hidden sret pointer as a 2-word register
          ;; group, shifting every real argument by one slot (and reading an
          ;; undefined second word). Typing it U64 keeps the hidden pointer in a
          ;; single integer register, and it survives copy-propagation (there is
          ;; no copy to fold). The result materialization below reads the 2 words
          ;; back from the buffer using `result-ty` explicitly.
          (match (lower-reserve-heap-storage args-state size (ast.AstType.U64))
            [(LowerExpr.Expr base-state base _)
              (match (lower-state-alloc-var base-state)
                [(LowerAlloc.Alloc allocated var-id)
                  (let
                    [instr : ir.CompilerIrInstr
                      (ir.CompilerIrInstr.Call
                        var-id
                        (lower-resolve-call-name-id-with-display
                          allocated
                          env
                          name-id
                          name)
                        (ir.compiler-ir-call-args-from-list
                          (ir.compiler-ir-value-cons base values))
                        (ast.AstType.U64))]
                    (lower-c-abi-finish-call-result
                      ctx
                      (lower-state-emit-at-expr allocated instr origin)
                      base
                      result-ty
                      (LowerCAbiAggregate.Sret size)
                      origin))])])])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-indirect-c-abi-call-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [func-value : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-c-abi-return-aggregate-class
    ctx
    (lower-state-mode state)
    result-ty)
    [(LowerCAbiAggregate.Unsupported message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]
    [(LowerCAbiAggregate.No)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [instr : ir.CompilerIrInstr
              (ir.CompilerIrInstr.CallIndirectC
                var-id
                func-value
                (ir.compiler-ir-call-args-from-list values)
                result-ty)]
            (lower-c-abi-finish-call-result
              ctx
              (lower-state-emit-at-expr allocated instr origin)
              (ir.CompilerIrValue.Var var-id)
              result-ty
              (LowerCAbiAggregate.No)
              origin))])]
    [(LowerCAbiAggregate.Integer scalar-ty size)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [instr : ir.CompilerIrInstr
              (ir.CompilerIrInstr.CallIndirectC
                var-id
                func-value
                (ir.compiler-ir-call-args-from-list values)
                scalar-ty)]
            (lower-c-abi-finish-call-result
              ctx
              (lower-state-emit-at-expr allocated instr origin)
              (ir.CompilerIrValue.Var var-id)
              result-ty
              (LowerCAbiAggregate.Integer scalar-ty size)
              origin))])]
    [(LowerCAbiAggregate.Register slots size)
      (let
        [slot-count : i64 (lower-c-abi-slot-list-count slots)]
        (cond
          [(= slot-count 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(LowerCAbiSlot.Slot scalar-ty _)
                (match (lower-state-alloc-var state)
                  [(LowerAlloc.Alloc allocated var-id)
                    (let
                      [instr : ir.CompilerIrInstr
                        (ir.CompilerIrInstr.CallIndirectC
                          var-id
                          func-value
                          (ir.compiler-ir-call-args-from-list values)
                          scalar-ty)]
                      (lower-c-abi-finish-call-result
                        ctx
                        (lower-state-emit-at-expr allocated instr origin)
                        (ir.CompilerIrValue.Var var-id)
                        result-ty
                        (LowerCAbiAggregate.Register slots size)
                        origin))])])]
          [(= slot-count 0)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-c-abi-unsupported-message
                    (lower-state-mode state)
                    result-ty))))]
          [else
            (match (lower-reserve-heap-storage state size result-ty)
              [(LowerExpr.Expr base-state base _)
                (let
                  [instr : ir.CompilerIrInstr
                    (ir.ir-instr-call-indirect-cabi-store-result
                      base
                      func-value
                      (ir.compiler-ir-call-args-from-list values)
                      (lower-c-abi-ir-return-slots slots))]
                  (match (lower-c-abi-materialize-stored-register-result
                    ctx
                    (lower-state-emit-at-expr base-state instr origin)
                    base
                    result-ty)
                    [(LowerExpr.Expr out-state out-value out-ty)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr out-state out-value out-ty))]))])]))]
    [(LowerCAbiAggregate.ByRef _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Memory _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Sret size)
      ;; Reserve the sret buffer typed as a scalar pointer (U64) -- see
      ;; lower-direct-c-abi-call -- so a register-resident result type does not make
      ;; the backend classify the hidden sret pointer as a 2-register group arg.
      (match (lower-reserve-heap-storage state size (ast.AstType.U64))
        [(LowerExpr.Expr base-state base _)
          (match (lower-state-alloc-var base-state)
            [(LowerAlloc.Alloc allocated var-id)
              (let
                [instr : ir.CompilerIrInstr
                  (ir.CompilerIrInstr.CallIndirectC
                    var-id
                    func-value
                    (ir.compiler-ir-call-args-from-list
                      (ir.compiler-ir-value-cons base values))
                    (ast.AstType.U64))]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr allocated instr origin)
                  base
                  result-ty
                  (LowerCAbiAggregate.Sret size)
                  origin))])])]))

(define (lower-extern-value-c-abi-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]
  [param-types : ast.AstTypeList]
  [fn-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-var-id state env name-id fn-ty)
    [(ResultLowerExpr.Ok lowered-func)
      (match lowered-func
        [(LowerExpr.Expr func-state func-value _)
          (match (lower-state-alloc-var func-state)
            [(LowerAlloc.Alloc allocated func-var)
              (let
                [loaded-state : LowerState
                  (lower-state-emit-at-expr
                    allocated
                    (ir.CompilerIrInstr.Mov func-var func-value fn-ty)
                    origin)]
                (match (lower-c-abi-args-as
                  ctx
                  loaded-state
                  env
                  type-env
                  args
                  param-types)
                  [(ResultLowerArgs.Ok args-state values)
                    (lower-indirect-c-abi-call-values
                      ctx
                      args-state
                      (ir.CompilerIrValue.Var func-var)
                      values
                      result-ty
                      origin)]
                  [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; sret ABI caller side: append the sret pointer as the trailing arg to a
;; value list (matching the callee's `__sret` param).
(define (lower-value-list-append-one
  [values : ir.CompilerIrValueList]
  [extra : ir.CompilerIrValue]) : ir.CompilerIrValueList
  (match values
    [(ir.CompilerIrValueList.Nil)
      (ir.compiler-ir-value-cons extra ir.CompilerIrValueList.Nil)]
    [(ir.CompilerIrValueList.Array seq)
      (lower-value-list-append-one (ir.compiler-ir-value-seq-to-list seq) extra)]
    [(ir.CompilerIrValueList.Cons head rest)
      (ir.compiler-ir-value-cons
        head
        (lower-value-list-append-one (box-get rest) extra))]))

;; For a call whose result is an inline aggregate, allocate the result slot on
;; the caller's stack and append its pointer as the hidden trailing arg. Uses
;; the same gate/size as the callee's sret return, so the call's return value is
;; that pointer and callers consume the result exactly as before. Non-aggregate
;; results pass through unchanged.
(define (lower-call-append-sret-arg
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [values : ir.CompilerIrValueList]
  [result-ty : ast.AstType]) : ResultLowerArgs
  ;; Structural Tuple/Array sret is a leading ABI argument handled by the
  ;; internal call path below. This legacy helper is nominal Struct/Enum only.
  (if (and
    (lower-type-inline-struct-or-enum? ctx result-ty)
    (lower-inline-aggregate-abi-copy-needed? ctx state result-ty))
    (match (lower-inline-aggregate-copy-size ctx result-ty)
      [(ResultLowerSize.Ok size)
        (match (lower-reserve-inline-storage state size result-ty)
          [(LowerExpr.Expr slot-state slot-ptr _)
            (ResultLowerArgs.Ok
              slot-state
              (lower-value-list-append-one values slot-ptr))])]
      [(ResultLowerSize.Err message)
        (ResultLowerArgs.Err (box (lower-diagnostic message)))])
    (ResultLowerArgs.Ok state values)))

(define (lower-value-list-prepend-one
  [head : ir.CompilerIrValue]
  [tail : ir.CompilerIrValueList]) : ir.CompilerIrValueList
  (ir.compiler-ir-value-cons head tail))

(define (lower-internal-return-class-for-name
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [name : String]
  [result-ty : ast.AstType]) : LowerCAbiAggregate
  ;; Global initializers are invoked by startup code, which owns the stable
  ;; arena result path rather than a caller stack slot.
  (if (lower-global-init-function? name)
    (LowerCAbiAggregate.No)
    (lower-internal-return-class ctx mode result-ty)))

(define (lower-internal-call-register-two
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [classification : LowerCAbiAggregate]
  [slots : LowerCAbiSlotList]) : ResultLowerArgs
  (match (lower-c-abi-register-arg-slot-values ctx state value source-ty slots)
    [(ResultLowerArgs.Ok slot-state slot-values)
      (match (ir.compiler-ir-value-list-force-cons slot-values)
        [(ir.CompilerIrValueList.Cons first-value rest)
          (match (ir.compiler-ir-value-list-force-cons (box-get rest))
            [(ir.CompilerIrValueList.Cons second-value _)
              (match (lower-emit-pack
                slot-state
                (ir.compiler-ir-value-cons
                  first-value
                  (ir.compiler-ir-value-cons
                    second-value
                    ir.CompilerIrValueList.Nil))
                (lower-internal-transport-type ctx source-ty classification))
                [(LowerExpr.Expr packed-state packed-value _)
                  (ResultLowerArgs.Ok
                    packed-state
                    (ir.compiler-ir-value-cons
                      packed-value
                      ir.CompilerIrValueList.Nil))])]
            [_
              (ResultLowerArgs.Err
                (box
                  (lower-diagnostic "lower: structural register group arity")))])]
        [_
          (ResultLowerArgs.Err
            (box (lower-diagnostic "lower: structural register group arity")))])]
    [(ResultLowerArgs.Err message) (ResultLowerArgs.Err message)]))

(define (lower-internal-call-arg-one
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [classification : LowerCAbiAggregate]
  [origin : ast.AstExpr]) : ResultLowerArgs
  (match classification
    [(LowerCAbiAggregate.No)
      (ResultLowerArgs.Ok
        state
        (ir.compiler-ir-value-cons value ir.CompilerIrValueList.Nil))]
    [(LowerCAbiAggregate.Integer scalar-ty _)
      (match (lower-load-at-offset state value 0 scalar-ty)
        [(LowerExpr.Expr loaded loaded-value _)
          (ResultLowerArgs.Ok
            loaded
            (ir.compiler-ir-value-cons loaded-value ir.CompilerIrValueList.Nil))])]
    [(LowerCAbiAggregate.Register slots _)
      (if (= (lower-c-abi-slot-list-count slots) 1)
        (match (lower-c-abi-slot-list-ref slots 0)
          [(LowerCAbiSlot.Slot scalar-ty offset)
            (match (lower-load-at-offset state value offset scalar-ty)
              [(LowerExpr.Expr loaded loaded-value _)
                (ResultLowerArgs.Ok
                  loaded
                  (ir.compiler-ir-value-cons
                    loaded-value
                    ir.CompilerIrValueList.Nil))])])
        (lower-internal-call-register-two
          ctx
          state
          value
          source-ty
          classification
          slots))]
    [(LowerCAbiAggregate.Memory size)
      (let
        [physical-ty : ast.AstType
          (lower-internal-transport-type ctx source-ty classification)]
        (match (lower-state-alloc-var state)
          [(LowerAlloc.Alloc allocated var-id)
            (ResultLowerArgs.Ok
              (lower-state-emit
                allocated
                (ir.CompilerIrInstr.Mov var-id value physical-ty))
              (ir.compiler-ir-value-cons
                (ir.CompilerIrValue.Var var-id)
                ir.CompilerIrValueList.Nil))]))]
    [(LowerCAbiAggregate.ByRef size)
      (match (lower-reserve-inline-storage state size source-ty)
        [(LowerExpr.Expr copy-state copy-ptr _)
          (let
            [copied : LowerState
              (lower-copy-bytes copy-state copy-ptr 0 value 0 size)]
            (match (lower-cast-value
              copied
              copy-ptr
              source-ty
              (ast.AstType.U64))
              [(LowerExpr.Expr cast-state pointer _)
                (ResultLowerArgs.Ok
                  cast-state
                  (ir.compiler-ir-value-cons pointer ir.CompilerIrValueList.Nil))]))])]
    [(LowerCAbiAggregate.Unsupported message)
      (ResultLowerArgs.Err (box (lower-diagnostic-at-expr origin message)))]
    [(LowerCAbiAggregate.Sret _)
      (ResultLowerArgs.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: structural return classification used for parameter")))]))

(define (lower-internal-call-args-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [state : LowerState]
  [values : ir.CompilerIrValueList]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [origin : ast.AstExpr]) : ResultLowerArgs
  (match (ir.compiler-ir-value-list-force-cons values)
    [(ir.CompilerIrValueList.Nil)
      (if (>= index (ast.ast-type-list-len types))
        (ResultLowerArgs.Ok state ir.CompilerIrValueList.Nil)
        (ResultLowerArgs.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(ir.CompilerIrValueList.Array seq)
      (lower-internal-call-args-at
        ctx
        mode
        state
        (ir.compiler-ir-value-seq-to-list seq)
        types
        index
        origin)]
    [(ir.CompilerIrValueList.Cons value rest)
      (if (>= index (ast.ast-type-list-len types))
        (ResultLowerArgs.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (let
          [source-ty : ast.AstType
            (tc_core.tc-context-type-get
              ctx
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
          (match (lower-internal-call-arg-one
            ctx
            state
            value
            source-ty
            (lower-internal-param-class ctx mode source-ty)
            origin)
            [(ResultLowerArgs.Ok arg-state arg-values)
              (match (lower-internal-call-args-at
                ctx
                mode
                arg-state
                (box-get rest)
                types
                (+ index 1)
                origin)
                [(ResultLowerArgs.Ok rest-state rest-values)
                  (ResultLowerArgs.Ok
                    rest-state
                    (lower-value-list-append arg-values rest-values))]
                [(ResultLowerArgs.Err message) (ResultLowerArgs.Err message)])]
            [(ResultLowerArgs.Err message) (ResultLowerArgs.Err message)])))]))

(define (lower-internal-call-args
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [state : LowerState]
  [values : ir.CompilerIrValueList]
  [types : ast.AstTypeList]
  [origin : ast.AstExpr]) : ResultLowerArgs
  (if (lower-internal-structural-resolved-type-list? ctx types)
    (lower-internal-call-args-at ctx mode state values (& types) 0 origin)
    (ResultLowerArgs.Ok state values)))

(define (lower-internal-materialize-result-two
  [call-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [slots : LowerCAbiSlotList]
  [storage : ir.CompilerIrValue]
  [storage-state : LowerState]) : ResultLowerExpr
  (match (lower-c-abi-slot-list-ref slots 0)
    [(LowerCAbiSlot.Slot first-ty first-offset)
      (match (lower-emit-word storage-state call-value 0 first-ty)
        [(LowerExpr.Expr first-state first-value _)
          (match (lower-c-abi-slot-list-ref slots 1)
            [(LowerCAbiSlot.Slot second-ty second-offset)
              (match (lower-emit-word first-state call-value 1 second-ty)
                [(LowerExpr.Expr second-state second-value _)
                  (let
                    [with0 : LowerState
                      (lower-store-at-offset
                        second-state
                        storage
                        first-offset
                        first-value
                        first-ty)]
                    [with1 : LowerState
                      (lower-store-at-offset
                        with0
                        storage
                        second-offset
                        second-value
                        second-ty)]
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr with1 storage result-ty)))])])])]))

(define (lower-internal-materialize-call-result
  [state : LowerState]
  [call-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [classification : LowerCAbiAggregate]) : ResultLowerExpr
  (match classification
    [(LowerCAbiAggregate.Integer scalar-ty size)
      (match (lower-reserve-inline-storage state size result-ty)
        [(LowerExpr.Expr storage-state storage _)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-store-at-offset
                storage-state
                storage
                0
                call-value
                scalar-ty)
              storage
              result-ty))])]
    [(LowerCAbiAggregate.Register slots size)
      (match (lower-reserve-inline-storage state size result-ty)
        [(LowerExpr.Expr storage-state storage _)
          (if (= (lower-c-abi-slot-list-count slots) 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(LowerCAbiSlot.Slot scalar-ty offset)
                (ResultLowerExpr.Ok
                  (LowerExpr.Expr
                    (lower-store-at-offset
                      storage-state
                      storage
                      offset
                      call-value
                      scalar-ty)
                    storage
                    result-ty))])
            (lower-internal-materialize-result-two
              call-value
              result-ty
              slots
              storage
              storage-state))])]
    [_
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: unsupported structural call result")))]))

(define (lower-internal-direct-call-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [name : String]
  [values : ir.CompilerIrValueList]
  [param-types : ast.AstTypeList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [mode : CompilerLowerMode (lower-state-mode state)]
    [result-class : LowerCAbiAggregate
      (lower-internal-return-class-for-name ctx mode name result-ty)]
    (match (lower-internal-call-args ctx mode state values param-types origin)
      [(ResultLowerArgs.Ok args-state physical-values)
        (match result-class
          [(LowerCAbiAggregate.Sret size)
            (match (lower-reserve-inline-storage args-state size result-ty)
              [(LowerExpr.Expr slot-state slot-ptr _)
                (match (lower-cast-value
                  slot-state
                  slot-ptr
                  result-ty
                  (ast.AstType.U64))
                  [(LowerExpr.Expr cast-state sret-pointer _)
                    (match (lower-state-alloc-var cast-state)
                      [(LowerAlloc.Alloc allocated call-var)
                        (let
                          [callee : i64
                            (lower-resolve-call-name-id-with-display
                              allocated
                              env
                              source-id
                              name)]
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (let
                                [call-state : LowerState
                                  (lower-state-emit-at-expr
                                    allocated
                                    (ir.CompilerIrInstr.Call
                                      call-var
                                      callee
                                      (ir.compiler-ir-call-args-from-list
                                        (lower-value-list-prepend-one
                                          sret-pointer
                                          physical-values))
                                      (ast.AstType.U64))
                                    origin)]
                                (if (>= lower-active-loop-entry-var-limit 0)
                                  (lower-state-inline-result-alias-mark-value
                                    call-state
                                    slot-ptr)
                                  call-state))
                              slot-ptr
                              result-ty)))])])])]
          [(LowerCAbiAggregate.No)
            ;; Preserve the nominal/existing scalar path (including trailing
            ;; nominal sret) exactly as before.
            (match (lower-call-append-sret-arg
              ctx
              args-state
              physical-values
              result-ty)
              [(ResultLowerArgs.Ok call-state call-values)
                (match (lower-state-alloc-var call-state)
                  [(LowerAlloc.Alloc allocated call-var)
                    (let
                      [callee : i64
                        (lower-resolve-call-name-id-with-display
                          allocated
                          env
                          source-id
                          name)]
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (let
                            [call-state : LowerState
                              (lower-state-emit-at-expr
                                allocated
                                (ir.CompilerIrInstr.Call
                                  call-var
                                  callee
                                  (ir.compiler-ir-call-args-from-list
                                    call-values)
                                  (lower-one-word-register-storage-type
                                    ctx
                                    result-ty))
                                origin)]
                            (if (>= lower-active-loop-entry-var-limit 0)
                              (lower-state-inline-result-alias-mark-call-result
                                ctx
                                call-state
                                (ir.CompilerIrValue.Var call-var)
                                result-ty)
                              call-state))
                          (ir.CompilerIrValue.Var call-var)
                          result-ty)))])]
              [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)])]
          [(LowerCAbiAggregate.Unsupported message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))]
          [_
            (match (lower-state-alloc-var args-state)
              [(LowerAlloc.Alloc allocated call-var)
                (let
                  [callee : i64
                    (lower-resolve-call-name-id-with-display
                      allocated
                      env
                      source-id
                      name)]
                  [physical-ret : ast.AstType
                    (lower-internal-transport-type ctx result-ty result-class)]
                  [call-state : LowerState
                    (lower-state-emit-at-expr
                      allocated
                      (ir.CompilerIrInstr.Call
                        call-var
                        callee
                        (ir.compiler-ir-call-args-from-list physical-values)
                        physical-ret)
                      origin)]
                  (match (lower-internal-materialize-call-result
                    call-state
                    (ir.CompilerIrValue.Var call-var)
                    result-ty
                    result-class)
                    [(ResultLowerExpr.Ok result) (ResultLowerExpr.Ok result)]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)]))])])]
      [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)])))

(define (lower-internal-indirect-call-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [func-value : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [param-types : ast.AstTypeList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [mode : CompilerLowerMode (lower-state-mode state)]
    [result-class : LowerCAbiAggregate
      (lower-internal-return-class ctx mode result-ty)]
    (match (lower-internal-call-args ctx mode state values param-types origin)
      [(ResultLowerArgs.Ok args-state physical-values)
        (match result-class
          [(LowerCAbiAggregate.Sret size)
            (match (lower-reserve-inline-storage args-state size result-ty)
              [(LowerExpr.Expr slot-state slot-ptr _)
                (match (lower-cast-value
                  slot-state
                  slot-ptr
                  result-ty
                  (ast.AstType.U64))
                  [(LowerExpr.Expr cast-state sret-pointer _)
                    (match (lower-state-alloc-var cast-state)
                      [(LowerAlloc.Alloc allocated call-var)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (let
                              [call-state : LowerState
                                (lower-state-emit-at-expr
                                  allocated
                                  (ir.CompilerIrInstr.CallIndirect
                                    call-var
                                    func-value
                                    (ir.compiler-ir-call-args-from-list
                                      (lower-value-list-prepend-one
                                        sret-pointer
                                        physical-values))
                                    (ast.AstType.U64))
                                  origin)]
                              (if (>= lower-active-loop-entry-var-limit 0)
                                (lower-state-inline-result-alias-mark-value
                                  call-state
                                  slot-ptr)
                                call-state))
                            slot-ptr
                            result-ty))])])])]
          [(LowerCAbiAggregate.No)
            (lower-indirect-call-values
              ctx
              args-state
              func-value
              physical-values
              result-ty
              origin)]
          [(LowerCAbiAggregate.Unsupported message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))]
          [_
            (match (lower-state-alloc-var args-state)
              [(LowerAlloc.Alloc allocated call-var)
                (let
                  [physical-ret : ast.AstType
                    (lower-internal-transport-type ctx result-ty result-class)]
                  [call-state : LowerState
                    (lower-state-emit-at-expr
                      allocated
                      (ir.CompilerIrInstr.CallIndirect
                        call-var
                        func-value
                        (ir.compiler-ir-call-args-from-list physical-values)
                        physical-ret)
                      origin)]
                  (lower-internal-materialize-call-result
                    call-state
                    (ir.CompilerIrValue.Var call-var)
                    result-ty
                    result-class))])])]
      [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)])))

(define (lower-direct-call-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [name : String]
  [values : ir.CompilerIrValueList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-call-append-sret-arg ctx state values result-ty)
    [(ResultLowerArgs.Ok sret-state sret-values)
      (match (lower-state-alloc-var sret-state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [result-ir-ty : ast.AstType
              (lower-one-word-register-storage-type ctx result-ty)]
            [callee : i64
              (lower-resolve-call-name-id-with-display
                allocated
                env
                source-id
                name)]
            [instr : ir.CompilerIrInstr
              (ir.CompilerIrInstr.Call
                var-id
                callee
                (ir.compiler-ir-call-args-from-list sret-values)
                result-ir-ty)]
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (let
                  [call-state : LowerState
                    (lower-state-emit-at-expr allocated instr origin)]
                  (if (>= lower-active-loop-entry-var-limit 0)
                    (lower-state-inline-result-alias-mark-call-result
                      ctx
                      call-state
                      (ir.CompilerIrValue.Var var-id)
                      result-ty)
                    call-state))
                (ir.CompilerIrValue.Var var-id)
                result-ty)))])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-bytes-view-from-parts-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-reserve-inline-storage state 16 (ast.AstType.String))
    [(LowerExpr.Expr base-state base-value _)
      (let
        [with-ptr : LowerState
          (lower-store-at-offset
            base-state
            base-value
            0
            ptr-value
            (ast.AstType.U64))]
        [with-len : LowerState
          (lower-store-at-offset
            with-ptr
            base-value
            8
            len-value
            (ast.AstType.I64))]
        (match (lower-state-alloc-var with-len)
          [(LowerAlloc.Alloc call-state call-var)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-state-emit-at-expr
                  call-state
                  (ir.CompilerIrInstr.Call
                    call-var
                    (lower-tl-str-view-symbol)
                    (ir.compiler-ir-call-args-from-list
                      (ir.compiler-ir-value-cons
                        base-value
                        (ir.compiler-ir-value-cons
                          (ir.CompilerIrValue.I64 0)
                          (ir.compiler-ir-value-cons
                            len-value
                            ir.CompilerIrValueList.Nil))))
                    (lower-one-word-register-storage-type ctx result-ty))
                  origin)
                (ir.CompilerIrValue.Var call-var)
                result-ty))]))]))

(define (lower-bytes-view-from-parts-values
  [ctx : tc_core.TcContext]
  [args-result : ResultLowerArgs]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match args-result
    [(ResultLowerArgs.Ok args-state values)
      (match (ir.compiler-ir-value-list-force-cons values)
        [(ir.CompilerIrValueList.Array seq)
          (lower-bytes-view-from-parts-values
            ctx
            (ResultLowerArgs.Ok
              args-state
              (ir.compiler-ir-value-seq-to-list seq))
            result-ty
            origin)]
        [(ir.CompilerIrValueList.Cons data-value rest0)
          (match (box-get rest0)
            [(ir.CompilerIrValueList.Cons len-value rest1)
              (match (box-get rest1)
                [(ir.CompilerIrValueList.Cons _ rest2)
                  (match (box-get rest2)
                    [(ir.CompilerIrValueList.Nil)
                      (lower-bytes-view-from-parts-result
                        ctx
                        args-state
                        data-value
                        len-value
                        result-ty
                        origin)]
                    [_
                      (ResultLowerExpr.Err
                        (box
                          (lower-diagnostic-at-expr
                            origin
                            "lower: bytes view helper expects data, length, owner")))])]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: bytes view helper expects data, length, owner")))])]
            [_
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "lower: bytes view helper expects data, length, owner")))])]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: bytes view helper expects data, length, owner")))])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-bytes-view-from-parts-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (lower-bytes-view-from-parts-values
    ctx
    (lower-args ctx state env type-env args)
    result-ty
    origin))

(define (lower-direct-call-from-args
  [ctx : tc_core.TcContext]
  [args-result : ResultLowerArgs]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [name : String]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match args-result
    [(ResultLowerArgs.Ok args-state values)
      (lower-direct-call-values
        ctx
        args-state
        env
        source-id
        name
        values
        result-ty
        origin)]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-direct-call-from-call-args
  [ctx : tc_core.TcContext]
  [args-result : ResultLowerCallArgs]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [name : String]
  [param-types : ast.AstTypeList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match args-result
    [(ResultLowerCallArgs.Ok args-state values writebacks)
      (match (lower-internal-direct-call-values
        ctx
        args-state
        env
        source-id
        name
        values
        param-types
        result-ty
        origin)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr call-state call-value call-ty)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-apply-arg-writebacks ctx call-state writebacks)
                  call-value
                  call-ty))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(ResultLowerCallArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-direct-call-param-types
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : tc_core.ResultTcTypeList
  (match (tc_core.tc-call-extern-abi-for-name-id ctx name-id)
    [(tc_core.TcMaybeExternAbi.Some abi)
      (if (tc_core.tc-call-dynamic-c-varargs-abi? abi)
        (tc_core.tc-call-extern-varargs-params
          ctx
          type-env
          (ast.AstExpr.Var name-id)
          args
          params
          abi)
        (tc_core.ResultTcTypeList.Ok params))]
    [(tc_core.TcMaybeExternAbi.No) (tc_core.ResultTcTypeList.Ok params)]))

(define (lower-direct-call-id-with-lookup-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (lower-bytes-view-from-parts-name? name)
    (lower-bytes-view-from-parts-call
      ctx
      state
      env
      type-env
      args
      result-ty
      origin)
    (match (lower-lookup-type-id
      ctx
      (lower-state-type-cache state)
      env
      type-env
      lookup-id)
      [(tc_core.ResultTcType.Ok fn-ty)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx fn-ty))
          [(ast.AstType.Func param-types _)
            (match (lower-direct-call-param-types
              ctx
              type-env
              source-id
              args
              (tc_core.tc-resolve-type-list ctx (box-get param-types)))
              [(tc_core.ResultTcTypeList.Ok call-param-types)
                (if (lower-c-abi-extern-call?
                  ctx
                  state
                  env
                  (if (>= lookup-id 0)
                    lookup-id
                    source-id)
                  name)
                  (lower-direct-c-abi-call
                    ctx
                    state
                    env
                    type-env
                    (if (>= lookup-id 0)
                      lookup-id
                      source-id)
                    name
                    args
                    call-param-types
                    result-ty
                    origin)
                  (if (lower-c-abi-extern-value-call?
                    ctx
                    state
                    env
                    (if (>= lookup-id 0)
                      lookup-id
                      source-id)
                    name)
                    (lower-extern-value-c-abi-call
                      ctx
                      state
                      env
                      type-env
                      (if (>= lookup-id 0)
                        lookup-id
                        source-id)
                      args
                      call-param-types
                      (tc_core.tc-type-strip-region
                        (tc_core.tc-resolve-type ctx fn-ty))
                      result-ty
                      origin)
                    (lower-direct-call-from-call-args
                      ctx
                      (lower-call-args-as-needed
                        ctx
                        state
                        env
                        type-env
                        args
                        call-param-types)
                      env
                      source-id
                      name
                      call-param-types
                      result-ty
                      origin)))]
              [(tc_core.ResultTcTypeList.Err message)
                (ResultLowerExpr.Err
                  (box (lower-diagnostic-at-expr origin message)))])]
          [_
            (lower-direct-call-from-args
              ctx
              (lower-args ctx state env type-env args)
              env
              source-id
              name
              result-ty
              origin)])]
      [(tc_core.ResultTcType.Err _)
        (lower-direct-call-from-args
          ctx
          (lower-args ctx state env type-env args)
          env
          source-id
          name
          result-ty
          origin)])))

(define (lower-direct-call-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (lower-direct-call-id-with-lookup-id
    ctx
    state
    env
    type-env
    source-id
    source-id
    name
    args
    result-ty
    origin))

(define (lower-indirect-call-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [func-value : ir.CompilerIrValue]
  [values : ir.CompilerIrValueList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-call-append-sret-arg ctx state values result-ty)
    [(ResultLowerArgs.Ok sret-state sret-values)
      (match (lower-state-alloc-var sret-state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [result-ir-ty : ast.AstType
              (lower-one-word-register-storage-type ctx result-ty)]
            [instr : ir.CompilerIrInstr
              (ir.CompilerIrInstr.CallIndirect
                var-id
                func-value
                (ir.compiler-ir-call-args-from-list sret-values)
                result-ir-ty)]
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (let
                  [call-state : LowerState
                    (lower-state-emit-at-expr allocated instr origin)]
                  (if (>= lower-active-loop-entry-var-limit 0)
                    (lower-state-inline-result-alias-mark-call-result
                      ctx
                      call-state
                      (ir.CompilerIrValue.Var var-id)
                      result-ty)
                    call-state))
                (ir.CompilerIrValue.Var var-id)
                result-ty)))])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-indirect-call-args
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [func-ty : ast.AstType]) : ResultLowerArgs
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx func-ty))
    [(ast.AstType.Func param-types _)
      (lower-args-as
        ctx
        state
        env
        type-env
        args
        (tc_core.tc-resolve-type-list ctx (box-get param-types)))]
    [_ (lower-args ctx state env type-env args)]))

(define (lower-indirect-call-args-with-writebacks
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [func-ty : ast.AstType]) : ResultLowerCallArgs
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx func-ty))
    [(ast.AstType.Func param-types _)
      (lower-call-args-as-needed
        ctx
        state
        env
        type-env
        args
        (tc_core.tc-resolve-type-list ctx (box-get param-types)))]
    [_
      (match (lower-args ctx state env type-env args)
        [(ResultLowerArgs.Ok args-state values)
          (ResultLowerCallArgs.Ok args-state values (LowerArgWritebacks.None))]
        [(ResultLowerArgs.Err message) (ResultLowerCallArgs.Err message)])]))

(define (lower-indirect-call
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func-ty : ast.AstType]
  [func-value : ir.CompilerIrValue]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-indirect-call-args-with-writebacks
    ctx
    state
    env
    type-env
    args
    func-ty)
    [(ResultLowerCallArgs.Ok args-state values writebacks)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx func-ty))
        [(ast.AstType.Func param-types _)
          (match (lower-internal-indirect-call-values
            ctx
            args-state
            func-value
            values
            (tc_core.tc-resolve-type-list ctx (box-get param-types))
            result-ty
            origin)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr call-state call-value call-ty)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-apply-arg-writebacks ctx call-state writebacks)
                      call-value
                      call-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
        [_
          (match (lower-indirect-call-values
            ctx
            args-state
            func-value
            values
            result-ty
            origin)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr call-state call-value call-ty)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-apply-arg-writebacks ctx call-state writebacks)
                      call-value
                      call-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerCallArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-indirect-c-abi-call
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func-ty : ast.AstType]
  [func-value : ir.CompilerIrValue]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx func-ty))
    [(ast.AstType.Func param-types _)
      (match (lower-c-abi-args-as
        ctx
        state
        env
        type-env
        args
        (tc_core.tc-resolve-type-list ctx (box-get param-types)))
        [(ResultLowerArgs.Ok args-state values)
          (lower-indirect-c-abi-call-values
            ctx
            args-state
            func-value
            values
            result-ty
            origin)]
        [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)])]
    [_
      (lower-indirect-call
        ctx
        state
        env
        type-env
        func-ty
        func-value
        args
        result-ty
        origin)]))

(define (lower-substring-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 3)
    (let
      [str : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [start : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [len : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 2 0))]
      (lower-substring ctx state env type-env str start len))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-string-concat-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 2)
    (lower-string-concat
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-string-runtime-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (or (string.eq name "substring") (string.eq name "string-slice"))
    (lower-substring-call
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)
    (lower-string-concat-call
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-runtime-call-values
  [state : LowerState]
  [name : i64]
  [values : ir.CompilerIrValueList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit
            allocated
            (ir.CompilerIrInstr.Call
              var-id
              name
              (ir.compiler-ir-call-args-from-list values)
              result-ty))
          (ir.CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-inline-string-eq-finish
  [state : LowerState (:consume)]
  [_true-label : i64]
  [false-label : i64]
  [done-label : i64]
  [result-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (let
    [false-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-state-emit
            state
            (ir.CompilerIrInstr.Mov
              result-var
              (ir.CompilerIrValue.Bool true)
              (ast.AstType.Bool)))
          (ir.CompilerIrInstr.Jump done-label))
        false-label)]
    [done-start : LowerState
      (lower-state-finish-block
        (lower-state-emit false-start (ir.CompilerIrInstr.Jump done-label))
        done-label)]
    (LowerExpr.Expr done-start (ir.CompilerIrValue.Var result-var) result-ty)))

(define (lower-inline-string-eq-body
  [state : LowerState]
  [header-label : i64]
  [true-label : i64]
  [false-label : i64]
  [done-label : i64]
  [result-var : i64]
  [index-var : i64]
  [left-ptr : ir.CompilerIrValue]
  [right-ptr : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-gep
    state
    left-ptr
    (ir.CompilerIrValue.Var index-var)
    (ast.AstType.U8))
    [(LowerExpr.Expr left-gep-state left-addr _)
      (match (lower-emit-load left-gep-state left-addr (ast.AstType.U8))
        [(LowerExpr.Expr left-load-state left-byte _)
          (match (lower-emit-gep
            left-load-state
            right-ptr
            (ir.CompilerIrValue.Var index-var)
            (ast.AstType.U8))
            [(LowerExpr.Expr right-gep-state right-addr _)
              (match (lower-emit-load
                right-gep-state
                right-addr
                (ast.AstType.U8))
                [(LowerExpr.Expr right-load-state right-byte _)
                  (match (lower-emit-cast
                    right-load-state
                    left-byte
                    (ast.AstType.U8)
                    (ast.AstType.I64))
                    [(LowerExpr.Expr left-cast-state left-i64 _)
                      (match (lower-emit-cast
                        left-cast-state
                        right-byte
                        (ast.AstType.U8)
                        (ast.AstType.I64))
                        [(LowerExpr.Expr right-cast-state right-i64 _)
                          (match (lower-emit-binop
                            right-cast-state
                            ir.CompilerIrBinOp.Eq
                            left-i64
                            right-i64
                            (ast.AstType.I64))
                            [(LowerExpr.Expr byte-eq-state byte-eq _)
                              (match (lower-emit-binop
                                byte-eq-state
                                ir.CompilerIrBinOp.Add
                                (ir.CompilerIrValue.Var index-var)
                                (ir.CompilerIrValue.I64 1)
                                (ast.AstType.I64))
                                [(LowerExpr.Expr inc-state next-index _)
                                  (lower-inline-string-eq-finish
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        (lower-state-emit
                                          inc-state
                                          (ir.CompilerIrInstr.Mov
                                            index-var
                                            next-index
                                            (ast.AstType.I64)))
                                        (ir.CompilerIrInstr.Branch
                                          byte-eq
                                          header-label
                                          false-label))
                                      true-label)
                                    true-label
                                    false-label
                                    done-label
                                    result-var
                                    result-ty)])])])])])])])]))

(define (lower-inline-string-eq-fields
  [state : LowerState]
  [left-ptr : ir.CompilerIrValue]
  [left-len : ir.CompilerIrValue]
  [right-ptr : ir.CompilerIrValue]
  [right-len : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-state-fresh-label state "string_eq_header")
    [(LowerLabel.Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "string_eq_body")
        [(LowerLabel.Label body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "string_eq_true")
            [(LowerLabel.Label true-label-state true-label)
              (match (lower-state-fresh-label
                true-label-state
                "string_eq_false")
                [(LowerLabel.Label false-label-state false-label)
                  (match (lower-state-fresh-label
                    false-label-state
                    "string_eq_done")
                    [(LowerLabel.Label done-label-state done-label)
                      (match (lower-state-alloc-var done-label-state)
                        [(LowerAlloc.Alloc result-alloc result-var)
                          (match (lower-state-alloc-var result-alloc)
                            [(LowerAlloc.Alloc index-alloc index-var)
                              (match (lower-emit-binop
                                (lower-state-emit
                                  (lower-state-emit
                                    index-alloc
                                    (ir.CompilerIrInstr.Mov
                                      result-var
                                      (ir.CompilerIrValue.Bool false)
                                      (ast.AstType.Bool)))
                                  (ir.CompilerIrInstr.Mov
                                    index-var
                                    (ir.CompilerIrValue.I64 0)
                                    (ast.AstType.I64)))
                                ir.CompilerIrBinOp.Eq
                                left-len
                                right-len
                                (ast.AstType.I64))
                                [(LowerExpr.Expr len-state len-ok _)
                                  (let
                                    [header-start : LowerState
                                      (lower-state-finish-block
                                        (lower-state-emit
                                          len-state
                                          (ir.CompilerIrInstr.Branch
                                            len-ok
                                            header-label
                                            false-label))
                                        header-label)]
                                    (match (lower-emit-binop
                                      header-start
                                      ir.CompilerIrBinOp.Lt
                                      (ir.CompilerIrValue.Var index-var)
                                      left-len
                                      (ast.AstType.I64))
                                      [(LowerExpr.Expr cond-state cond-value _)
                                        (lower-inline-string-eq-body
                                          (lower-state-finish-block
                                            (lower-state-emit
                                              cond-state
                                              (ir.CompilerIrInstr.Branch
                                                cond-value
                                                body-label
                                                true-label))
                                            body-label)
                                          header-label
                                          true-label
                                          false-label
                                          done-label
                                          result-var
                                          index-var
                                          left-ptr
                                          right-ptr
                                          result-ty)]))])])])])])])])]))

(define (lower-inline-string-to-int-negate
  [state : LowerState (:consume)]
  [negate-label : i64]
  [done-label : i64]
  [value-var : i64]
  [negative-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (let
    [negate-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          state
          (ir.CompilerIrInstr.Branch
            (ir.CompilerIrValue.Var negative-var)
            negate-label
            done-label))
        negate-label)]
    (match (lower-emit-binop
      negate-start
      ir.CompilerIrBinOp.Sub
      (ir.CompilerIrValue.I64 0)
      (ir.CompilerIrValue.Var value-var)
      (ast.AstType.I64))
      [(LowerExpr.Expr neg-state neg-value _)
        (let
          [done-start : LowerState
            (lower-state-finish-block
              (lower-state-emit
                (lower-state-emit
                  neg-state
                  (ir.CompilerIrInstr.Mov value-var neg-value (ast.AstType.I64)))
                (ir.CompilerIrInstr.Jump done-label))
              done-label)]
          (LowerExpr.Expr
            done-start
            (ir.CompilerIrValue.Var value-var)
            result-ty))])))

(define (lower-inline-string-to-int-body
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [header-label : i64]
  [apply-label : i64]
  [negate-label : i64]
  [done-label : i64]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-gep
    state
    ptr
    (ir.CompilerIrValue.Var index-var)
    (ast.AstType.U8))
    [(LowerExpr.Expr byte-gep-state byte-addr _)
      (match (lower-emit-load byte-gep-state byte-addr (ast.AstType.U8))
        [(LowerExpr.Expr byte-load-state byte-value _)
          (match (lower-emit-cast
            byte-load-state
            byte-value
            (ast.AstType.U8)
            (ast.AstType.I64))
            [(LowerExpr.Expr byte-cast-state byte-i64 _)
              (match (lower-emit-binop
                byte-cast-state
                ir.CompilerIrBinOp.Sub
                byte-i64
                (ir.CompilerIrValue.I64 48)
                (ast.AstType.I64))
                [(LowerExpr.Expr digit-state digit _)
                  (match (lower-emit-binop
                    digit-state
                    ir.CompilerIrBinOp.Mul
                    (ir.CompilerIrValue.Var value-var)
                    (ir.CompilerIrValue.I64 10)
                    (ast.AstType.I64))
                    [(LowerExpr.Expr scaled-state scaled _)
                      (match (lower-emit-binop
                        scaled-state
                        ir.CompilerIrBinOp.Add
                        scaled
                        digit
                        (ast.AstType.I64))
                        [(LowerExpr.Expr next-state next-value _)
                          (match (lower-emit-binop
                            next-state
                            ir.CompilerIrBinOp.Add
                            (ir.CompilerIrValue.Var index-var)
                            (ir.CompilerIrValue.I64 1)
                            (ast.AstType.I64))
                            [(LowerExpr.Expr inc-state next-index _)
                              (lower-inline-string-to-int-negate
                                (lower-state-finish-block
                                  (lower-state-emit
                                    (lower-state-emit
                                      (lower-state-emit
                                        inc-state
                                        (ir.CompilerIrInstr.Mov
                                          value-var
                                          next-value
                                          (ast.AstType.I64)))
                                      (ir.CompilerIrInstr.Mov
                                        index-var
                                        next-index
                                        (ast.AstType.I64)))
                                    (ir.CompilerIrInstr.Jump header-label))
                                  apply-label)
                                negate-label
                                done-label
                                value-var
                                negative-var
                                result-ty)])])])])])])]))

(define (lower-inline-string-to-int-loop
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [body-label : i64]
  [apply-label : i64]
  [header-label : i64]
  [negate-label : i64]
  [done-label : i64]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-binop
    state
    ir.CompilerIrBinOp.Lt
    (ir.CompilerIrValue.Var index-var)
    len
    (ast.AstType.I64))
    [(LowerExpr.Expr cond-state cond-value _)
      (lower-inline-string-to-int-body
        (lower-state-finish-block
          (lower-state-emit
            cond-state
            (ir.CompilerIrInstr.Branch cond-value body-label apply-label))
          body-label)
        ptr
        header-label
        apply-label
        negate-label
        done-label
        value-var
        index-var
        negative-var
        result-ty)]))

(define (lower-inline-string-to-int-sign
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [minus-label : i64]
  [header-label : i64]
  [body-label : i64]
  [apply-label : i64]
  [negate-label : i64]
  [done-label : i64]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-gep state ptr (ir.CompilerIrValue.I64 0) (ast.AstType.U8))
    [(LowerExpr.Expr first-gep-state first-addr _)
      (match (lower-emit-load first-gep-state first-addr (ast.AstType.U8))
        [(LowerExpr.Expr first-load-state first-byte _)
          (match (lower-emit-cast
            first-load-state
            first-byte
            (ast.AstType.U8)
            (ast.AstType.I64))
            [(LowerExpr.Expr first-cast-state first-i64 _)
              (match (lower-emit-binop
                first-cast-state
                ir.CompilerIrBinOp.Eq
                first-i64
                (ir.CompilerIrValue.I64 45)
                (ast.AstType.I64))
                [(LowerExpr.Expr minus-test-state minus? _)
                  (let
                    [minus-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          minus-test-state
                          (ir.CompilerIrInstr.Branch
                            minus?
                            minus-label
                            header-label))
                        minus-label)]
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            (lower-state-emit
                              minus-start
                              (ir.CompilerIrInstr.Mov
                                negative-var
                                (ir.CompilerIrValue.Bool true)
                                (ast.AstType.Bool)))
                            (ir.CompilerIrInstr.Mov
                              index-var
                              (ir.CompilerIrValue.I64 1)
                              (ast.AstType.I64)))
                          (ir.CompilerIrInstr.Jump header-label))
                        header-label)]
                    (lower-inline-string-to-int-loop
                      header-start
                      ptr
                      len
                      body-label
                      apply-label
                      header-label
                      negate-label
                      done-label
                      value-var
                      index-var
                      negative-var
                      result-ty))])])])]))

(define (lower-inline-string-to-int-fields
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-state-fresh-label state "string_to_int_sign")
    [(LowerLabel.Label sign-label-state sign-label)
      (match (lower-state-fresh-label sign-label-state "string_to_int_minus")
        [(LowerLabel.Label minus-label-state minus-label)
          (match (lower-state-fresh-label
            minus-label-state
            "string_to_int_header")
            [(LowerLabel.Label header-label-state header-label)
              (match (lower-state-fresh-label
                header-label-state
                "string_to_int_body")
                [(LowerLabel.Label body-label-state body-label)
                  (match (lower-state-fresh-label
                    body-label-state
                    "string_to_int_apply_sign")
                    [(LowerLabel.Label apply-label-state apply-label)
                      (match (lower-state-fresh-label
                        apply-label-state
                        "string_to_int_negate")
                        [(LowerLabel.Label negate-label-state negate-label)
                          (match (lower-state-fresh-label
                            negate-label-state
                            "string_to_int_done")
                            [(LowerLabel.Label done-label-state done-label)
                              (match (lower-state-alloc-var done-label-state)
                                [(LowerAlloc.Alloc value-alloc value-var)
                                  (match (lower-state-alloc-var value-alloc)
                                    [(LowerAlloc.Alloc index-alloc index-var)
                                      (match (lower-state-alloc-var index-alloc)
                                        [(LowerAlloc.Alloc
                                            negative-alloc
                                            negative-var)
                                          (match (lower-emit-binop
                                            (lower-state-emit
                                              (lower-state-emit
                                                (lower-state-emit
                                                  negative-alloc
                                                  (ir.CompilerIrInstr.Mov
                                                    value-var
                                                    (ir.CompilerIrValue.I64 0)
                                                    (ast.AstType.I64)))
                                                (ir.CompilerIrInstr.Mov
                                                  index-var
                                                  (ir.CompilerIrValue.I64 0)
                                                  (ast.AstType.I64)))
                                              (ir.CompilerIrInstr.Mov
                                                negative-var
                                                (ir.CompilerIrValue.Bool false)
                                                (ast.AstType.Bool)))
                                            ir.CompilerIrBinOp.Gt
                                            len
                                            (ir.CompilerIrValue.I64 0)
                                            (ast.AstType.I64))
                                            [(LowerExpr.Expr
                                                nonempty-state
                                                nonempty
                                                _)
                                              (lower-inline-string-to-int-sign
                                                (lower-state-finish-block
                                                  (lower-state-emit
                                                    nonempty-state
                                                    (ir.CompilerIrInstr.Branch
                                                      nonempty
                                                      sign-label
                                                      done-label))
                                                  sign-label)
                                                ptr
                                                len
                                                minus-label
                                                header-label
                                                body-label
                                                apply-label
                                                negate-label
                                                done-label
                                                value-var
                                                index-var
                                                negative-var
                                                result-ty)])])])])])])])])])])]))

(define (lower-string-to-int-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (lower-expr ctx state env type-env arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state arg-value arg-ty)
              (if (lower-string-handle-type? ctx arg-ty)
                (match (lower-string-fields arg-state arg-value)
                  [(LowerStringFields.Fields fields-state ptr len)
                    (ResultLowerExpr.Ok
                      (lower-inline-string-to-int-fields
                        fields-state
                        ptr
                        len
                        result-ty))])
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      arg
                      "lower: string->int requires String"))))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      cbi.compiler-builtin-id-tl-private-string-to-int
      "__tl_string_to_int"
      args
      result-ty
      origin)))

(define (lower-string-eq-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 2)
    (let
      [left : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [right : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      (match (lower-expr ctx state env type-env left)
        [(ResultLowerExpr.Ok lowered-left)
          (match lowered-left
            [(LowerExpr.Expr left-state left-value _)
              (match (lower-expr ctx left-state env type-env right)
                [(ResultLowerExpr.Ok lowered-right)
                  (match lowered-right
                    [(LowerExpr.Expr right-state right-value _)
                      (match (lower-string-fields right-state left-value)
                        [(LowerStringFields.Fields
                            left-fields-state
                            left-ptr
                            left-len)
                          (match (lower-string-fields
                            left-fields-state
                            right-value)
                            [(LowerStringFields.Fields
                                done-fields-state
                                right-ptr
                                right-len)
                              (ResultLowerExpr.Ok
                                (lower-inline-string-eq-fields
                                  done-fields-state
                                  left-ptr
                                  left-len
                                  right-ptr
                                  right-len
                                  result-ty))])])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      cbi.compiler-builtin-id-tl-private-string-eq
      "__tl_string_eq"
      args
      result-ty
      origin)))

(define (lower-bootstrap-runtime-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (lower-private-string-eq-helper-call-id? ctx type-env source-id)
    (lower-string-eq-call ctx state env type-env args result-ty origin)
    (if (lower-private-string-to-int-helper-call-id? ctx type-env source-id)
      (lower-string-to-int-call ctx state env type-env args result-ty origin)
      (lower-direct-call-id
        ctx
        state
        env
        type-env
        source-id
        name
        args
        result-ty
        origin))))

(define (lower-private-string-eq-helper-call-id?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : bool
  (and
    (cbi.compiler-builtin-typecheck-string-eq-id? name-id)
    (lower-top-level-builtin-available-id? ctx type-env name-id)))

(define (lower-private-string-to-int-helper-call-id?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : bool
  (and
    (cbi.compiler-builtin-typecheck-string-to-int-id? name-id)
    (lower-top-level-builtin-available-id? ctx type-env name-id)))

;; Lower an unshadowed `(__tl_string_ref s i)` intrinsic call to the
;; bounds-checked String byte index, like the parser-owned `AstExpr.StringRef`
;; node.
(define (lower-string-ref-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 2)
    (let
      [str : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [index : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      (lower-string-ref ctx state env type-env str index origin))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-module-lookup-name [ctx : tc_core.TcContext] [name : String]) : String
  (let
    [module : String (tc_core.tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc_core.tc-name-qualified? name)))
      (csym.compiler-symbol-module-key module name)
      name)))

(define (lower-call-name-matches-nominal?
  [ctx : tc_core.TcContext]
  [name : String]
  [nominal-name : String]) : bool
  (if (tc_core.tc-name-qualified? name)
    (string.eq name nominal-name)
    (and
      (string.eq
        (tc_core.tc-qualified-name-module nominal-name)
        (tc_core.tc-context-module ctx))
      (string.eq name (tc_core.tc-qualified-name-base nominal-name)))))

(define (lower-variant-constructor-lookup-name
  [ctx : tc_core.TcContext]
  [name : String]
  [name-id : i64]
  [result-ty : ast.AstType]) : String
  (let
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or name-id name-id)]
    (match (tc_core.tc-type-strip-region result-ty)
      [(ast.AstType.Enum enum-name)
        (let
          [enum-name-str : String
            (tc_core.tc-nominal-name-id-display enum-name)]
          (if (or
            (tc_core.tc-name-qualified? name)
            (string.eq
              (tc_core.tc-qualified-name-module enum-name-str)
              (tc_core.tc-context-module ctx)))
            (tc_core.tc-source-variant-name-for-enum-id
              ctx
              enum-name-str
              name
              source-id)
            (lower-module-lookup-name ctx name)))]
      [(ast.AstType.EnumArgs enum-name _)
        (let
          [enum-name-str : String
            (tc_core.tc-nominal-name-id-display enum-name)]
          (if (or
            (tc_core.tc-name-qualified? name)
            (string.eq
              (tc_core.tc-qualified-name-module enum-name-str)
              (tc_core.tc-context-module ctx)))
            (tc_core.tc-source-variant-name-for-enum-id
              ctx
              enum-name-str
              name
              source-id)
            (lower-module-lookup-name ctx name)))]
      [_ ""])))

(define (lower-variant-constructor-handle-id-or
  [ctx : tc_core.TcContext]
  [_ : String]
  [raw-name-id : i64]
  [result-ty : ast.AstType]
  [fallback : i64]) : i64
  (let
    [source-name-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or raw-name-id raw-name-id)]
    [source-key-id : i64
      (csym.compiler-symbol-dotted-variant-key-id-in-module-or
        source-name-id
        (tc_core.tc-context-module-id ctx)
        -1)]
    [source-handle : i64
      (if (>= source-key-id 0)
        (csym.compiler-registries-lookup-variant-key-id-or
          (tc_core.tc-context-registries ctx)
          source-key-id
          fallback)
        fallback)]
    [enum-name-id : i64
      (match (tc_core.tc-type-strip-region result-ty)
        [(ast.AstType.Enum name) name]
        [(ast.AstType.EnumArgs name _) name]
        [_ -1])]
    [variant-name-id : i64
      (if (and (>= source-name-id 0) (< source-name-id (ci.intern-capacity)))
        (ci.intern-dotted-final-id
          (tc_core.tc-qualified-name-base-id source-name-id))
        -1)]
    [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols ctx)]
    [direct-variant-handle : i64
      (csym.compiler-registries-lookup-variant-id-or
        (tc_core.tc-context-registries ctx)
        source-name-id
        fallback)]
    [direct-variant-owner-index : i64
      (if (csym.compiler-symbols-handle-found? direct-variant-handle)
        (csym.compiler-registry-handle-owner-index direct-variant-handle)
        -1)]
    [direct-variant-owner-id : i64
      (csym.compiler-symbols-owner-id-at-index-or
        symbols
        direct-variant-owner-index
        -1)]
    [direct-variant-module-id : i64
      (csym.compiler-symbols-owner-module-id-at-index-or
        symbols
        direct-variant-owner-index
        -1)]
    [direct-variant-owner-matches : bool
      (and
        (csym.compiler-symbols-handle-found? direct-variant-handle)
        (or
          (=
            direct-variant-owner-id
            (csym.compiler-symbol-name-id-key enum-name-id))
          (tc_core.tc-current-module-owner-name-matches-id?
            enum-name-id
            direct-variant-owner-id))
        (if (csym.compiler-composite-pair-key-id? enum-name-id)
          (=
            direct-variant-module-id
            (csym.compiler-composite-pair-left-id enum-name-id))
          (if (tc_core.tc-name-qualified-id? enum-name-id)
            (=
              direct-variant-module-id
              (tc_core.tc-qualified-name-module-id enum-name-id))
            true)))]
    (cond
      [direct-variant-owner-matches direct-variant-handle]
      [(csym.compiler-symbols-handle-found? source-handle) source-handle]
      [(and (>= enum-name-id 0) (>= variant-name-id 0))
        (let
          [direct-enum-handle : i64
            (csym.compiler-symbols-lookup-type-id-or
              symbols
              enum-name-id
              fallback)]
          [enum-base-id : i64
            (if (>= enum-name-id 0)
              (tc_core.tc-qualified-name-base-id enum-name-id)
              -1)]
          [enum-handle : i64
            (cond
              [(csym.compiler-symbols-handle-found? direct-enum-handle)
                direct-enum-handle]
              [(>= enum-base-id 0)
                (csym.compiler-symbols-lookup-type-id-or
                  symbols
                  (csym.compiler-symbol-module-key-id-by-id
                    (tc_core.tc-context-module-id ctx)
                    enum-base-id)
                  fallback)]
              [else fallback])]
          (if (csym.compiler-symbols-handle-found? enum-handle)
            (let
              [enum-index : i64 (csym.compiler-symbol-handle-index enum-handle)]
              [module-id : i64
                (csym.compiler-symbols-owner-module-id-at-index-or
                  symbols
                  enum-index
                  (csym.compiler-symbol-root-module-id))]
              [key-id : i64
                (csym.compiler-symbol-module-key-id-by-id
                  module-id
                  (csym.compiler-enum-qualified-variant-name-id
                    enum-base-id
                    variant-name-id))]
              (csym.compiler-registries-lookup-variant-key-id-or
                (tc_core.tc-context-registries ctx)
                key-id
                fallback))
            fallback))]
      [else fallback])))

(define (lower-call-non-builtin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [resolved-name-id : i64 raw-name-id]
    (if (and
      (>= resolved-name-id 0)
      (sym_i64_env.sym-i64-contains-id env resolved-name-id))
      (lower-direct-call-id
        ctx
        state
        env
        type-env
        resolved-name-id
        name
        args
        result-ty
        origin)
      (let
        [source-name : String (lower-hygiene-source-name name)]
        [callable-lookup-id : i64
          (lower-callable-lookup-id ctx raw-name-id lookup-name-id)]
        [function-value : bool
          (lower-top-level-callable-lookup-id? ctx callable-lookup-id)]
        [variant-name : String
          (lower-variant-constructor-lookup-name
            ctx
            source-name
            raw-name-id
            result-ty)]
        [struct-name : String
          (match (tc_core.tc-type-strip-region result-ty)
            [(ast.AstType.Struct resolved-struct)
              (if (lower-call-name-matches-nominal?
                ctx
                source-name
                (tc_core.tc-nominal-name-id-display resolved-struct))
                (tc_core.tc-nominal-name-id-display resolved-struct)
                (lower-module-lookup-name ctx source-name))]
            [(ast.AstType.StructArgs resolved-struct _)
              (if (lower-call-name-matches-nominal?
                ctx
                source-name
                (tc_core.tc-nominal-name-id-display resolved-struct))
                (tc_core.tc-nominal-name-id-display resolved-struct)
                (lower-module-lookup-name ctx source-name))]
            [_ (lower-module-lookup-name ctx source-name)])]
        [variant-handle : i64
          (lower-variant-constructor-handle-id-or
            ctx
            source-name
            raw-name-id
            result-ty
            (csym.compiler-symbols-missing-handle))]
        [struct-handle : i64
          (lower-struct-constructor-handle-id-or
            ctx
            state
            raw-name-id
            callable-lookup-id
            result-ty
            (csym.compiler-symbols-missing-handle))]
        (if (and
          (not function-value)
          (csym.compiler-symbols-handle-found? variant-handle))
          (lower-construct-enum-with-handle
            ctx
            state
            env
            type-env
            variant-name
            variant-handle
            args
            result-ty)
          (if (and
            (or
              (tc_core.tc-constructor-name-id? ctx raw-name-id)
              (tc_core.tc-constructor-name-id? ctx callable-lookup-id))
            (csym.compiler-symbols-handle-found? struct-handle)
            (=
              (csym.compiler-symbol-handle-kind struct-handle)
              (csym.compiler-symbol-kind-defstruct)))
            (lower-construct-struct
              ctx
              state
              env
              type-env
              struct-name
              struct-handle
              args
              result-ty)
            (lower-direct-call-id-with-lookup-id
              ctx
              state
              env
              type-env
              raw-name-id
              callable-lookup-id
              name
              args
              result-ty
              origin)))))))

(define (lower-direct-store-target?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ty : ast.AstType]) : bool
  (and
    (lower-mode-inline-aggregates? (lower-state-mode state))
    (lower-type-inline-struct-or-enum? ctx ty)
    (not (lower-type-register-resident? ctx ty))))

(define (lower-direct-store-result [result : ResultLowerState]) : LowerMaybeDirectStore
  (match result
    [(ResultLowerState.Ok done-state) (LowerMaybeDirectStore.Store done-state)]
    [(ResultLowerState.Err message) (LowerMaybeDirectStore.Err message)]))

(define (lower-direct-constructor-call-into
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [name : String]
  [raw-name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [_origin : ast.AstExpr]) : LowerMaybeDirectStore
  (if (sym_i64_env.sym-i64-contains-id env raw-name-id)
    (LowerMaybeDirectStore.No)
    (let
      [source-name : String (lower-hygiene-source-name name)]
      [lookup-name-id : i64
        (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
          ctx
          type-env
          name
          raw-name-id
          true)
          [(tc_core.TcNameLookup.Ok _ resolved-id) resolved-id]
          [(tc_core.TcNameLookup.Err _) raw-name-id])]
      [callable-lookup-id : i64
        (lower-callable-lookup-id ctx raw-name-id lookup-name-id)]
      [function-value : bool
        (lower-top-level-callable-lookup-id? ctx callable-lookup-id)]
      [variant-name : String
        (lower-variant-constructor-lookup-name
          ctx
          source-name
          raw-name-id
          result-ty)]
      [struct-name : String
        (match (tc_core.tc-type-strip-region result-ty)
          [(ast.AstType.Struct resolved-struct)
            (if (lower-call-name-matches-nominal?
              ctx
              source-name
              (tc_core.tc-nominal-name-id-display resolved-struct))
              (tc_core.tc-nominal-name-id-display resolved-struct)
              (lower-module-lookup-name ctx source-name))]
          [(ast.AstType.StructArgs resolved-struct _)
            (if (lower-call-name-matches-nominal?
              ctx
              source-name
              (tc_core.tc-nominal-name-id-display resolved-struct))
              (tc_core.tc-nominal-name-id-display resolved-struct)
              (lower-module-lookup-name ctx source-name))]
          [_ (lower-module-lookup-name ctx source-name)])]
      [variant-handle : i64
        (lower-variant-constructor-handle-id-or
          ctx
          source-name
          raw-name-id
          result-ty
          (csym.compiler-symbols-missing-handle))]
      [struct-handle : i64
        (lower-struct-constructor-handle-id-or
          ctx
          state
          raw-name-id
          callable-lookup-id
          result-ty
          (csym.compiler-symbols-missing-handle))]
      (if (and
        (not function-value)
        (csym.compiler-symbols-handle-found? variant-handle))
        (lower-direct-store-result
          (lower-construct-enum-with-handle-into
            ctx
            state
            env
            type-env
            dst
            variant-name
            variant-handle
            args
            result-ty))
        (if (and
          (or
            (tc_core.tc-constructor-name-id? ctx raw-name-id)
            (tc_core.tc-constructor-name-id? ctx callable-lookup-id))
          (csym.compiler-symbols-handle-found? struct-handle)
          (=
            (csym.compiler-symbol-handle-kind struct-handle)
            (csym.compiler-symbol-kind-defstruct)))
          (lower-direct-store-result
            (lower-construct-struct-into
              ctx
              state
              env
              type-env
              dst
              struct-name
              struct-handle
              args
              result-ty))
          (LowerMaybeDirectStore.No))))))

(define (lower-direct-nullary-variant-into
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [name : String]
  [raw-name-id : i64]
  [result-ty : ast.AstType]) : LowerMaybeDirectStore
  (if (sym_i64_env.sym-i64-contains-id env raw-name-id)
    (LowerMaybeDirectStore.No)
    (let
      [source-name : String (lower-hygiene-source-name name)]
      [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols ctx)]
      [function-value : bool
        (or
          (lower-top-level-callable-defined-id? ctx raw-name-id)
          (lower-symbol-function-value-id? ctx raw-name-id))]
      [variant-name : String
        (lower-variant-constructor-lookup-name
          ctx
          source-name
          raw-name-id
          result-ty)]
      [handle : i64
        (lower-variant-constructor-handle-id-or
          ctx
          source-name
          raw-name-id
          result-ty
          (csym.compiler-symbols-missing-handle))]
      (if (and
        (not function-value)
        (csym.compiler-symbols-handle-found? handle))
        (match (csym.compiler-registries-variant-fields-indexed symbols handle)
          [(parser.ResultAstTypeList.Ok fields)
            (if (ast.ast-type-list-empty? (& fields))
              (lower-direct-store-result
                (lower-construct-enum-with-handle-into
                  ctx
                  state
                  env
                  type-env
                  dst
                  variant-name
                  handle
                  (ast.ast-expr-list-new)
                  result-ty))
              (LowerMaybeDirectStore.No))]
          [(parser.ResultAstTypeList.Err message)
            (LowerMaybeDirectStore.Err (box (lower-diagnostic message)))])
        (LowerMaybeDirectStore.No)))))

(define (lower-direct-init-into
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [maybe-ty : ast.AstMaybeType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeDirectStore
  (match maybe-ty
    [(ast.AstMaybeType.No)
      (lower-direct-store-result
        (lower-init-expr-into ctx state env type-env dst result-ty origin))]
    [(ast.AstMaybeType.Some ty)
      (let
        [resolved-init : ast.AstType
          (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
        [resolved-result : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx result-ty))]
        (if (tc_core.tc-type-eq resolved-init resolved-result)
          (lower-direct-store-result
            (lower-init-expr-into ctx state env type-env dst ty origin))
          (LowerMaybeDirectStore.No)))]))

(define (lower-direct-store-rhs-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [value : ast.AstExpr]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeDirectStore
  (if (lower-direct-store-target? ctx state result-ty)
    (match value
      [(ast.AstExpr.Spanned inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-direct-store-rhs-into
            ctx
            state
            env
            type-env
            dst
            inner
            result-ty
            origin))]
      [(ast.AstExpr.Ann inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-direct-store-rhs-into
            ctx
            state
            env
            type-env
            dst
            inner
            result-ty
            origin))]
      [(ast.AstExpr.Init maybe-ty-id)
        (lower-direct-init-into
          ctx
          state
          env
          type-env
          dst
          (ast.ast-maybe-type-from-id-with-pools
            (tc_core.tc-context-pools ctx)
            maybe-ty-id)
          result-ty
          origin)]
      [(ast.AstExpr.Call func-box args)
        (let
          [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
          (match (ast.ast-expr-unspan func)
            [(ast.AstExpr.Var name)
              (lower-direct-constructor-call-into
                ctx
                state
                env
                type-env
                dst
                (ci.intern-str
                  (tc_core.macro-hygiene-global-source-name-id-or name name))
                name
                args
                result-ty
                origin)]
            [_ (LowerMaybeDirectStore.No)]))]
      [(ast.AstExpr.Var name)
        (if (tc_core.tc-dotted-local-field-name-id? type-env name)
          (LowerMaybeDirectStore.No)
          (lower-direct-nullary-variant-into
            ctx
            state
            env
            type-env
            dst
            (ci.intern-str
              (tc_core.macro-hygiene-global-source-name-id-or name name))
            name
            result-ty))]
      [_ (LowerMaybeDirectStore.No)])
    (LowerMaybeDirectStore.No)))

(define (lower-direct-store-rhs-at-offset
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [value : ast.AstExpr]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeDirectStore
  (if (lower-direct-store-target? ctx state result-ty)
    (if (= offset 0)
      (lower-direct-store-rhs-into
        ctx
        state
        env
        type-env
        base
        value
        result-ty
        origin)
      (match (lower-gep-byte state base offset)
        [(LowerExpr.Expr ptr-state ptr _)
          (lower-direct-store-rhs-into
            ctx
            ptr-state
            env
            type-env
            ptr
            value
            result-ty
            origin)]))
    (LowerMaybeDirectStore.No)))

(define (lower-spmd-scalar-arg-varying?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [arg : ast.AstExpr]) : bool
  (>
    (lower-masked-vector-expr-lanes-with-locals
      ctx
      (CompilerLowerMode.Avx512)
      env
      type-env
      index
      (lower-masked-vector-empty-lane-locals)
      arg)
    0))

(define (lower-spmd-call-args-from-values
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [args : ast.AstExprList]
  [params : ast.AstParamList]
  [values : ir.CompilerIrValueList]) : ir.CompilerIrSpmdCallArgList
  (lower-spmd-call-args-from-values-at
    ctx
    env
    type-env
    index
    (& args)
    (& params)
    (ir.compiler-ir-value-list-force-cons values)
    0))

(define (lower-spmd-call-args-from-values-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstParamList)]
  [values : ir.CompilerIrValueList]
  [arg-index : i64]) : ir.CompilerIrSpmdCallArgList
  (if (or
    (>= arg-index (struct-get args len))
    (>= arg-index (ast.ast-param-list-len params)))
    ir.CompilerIrSpmdCallArgList.Nil
    (match values
      [(ir.CompilerIrValueList.Array seq)
        (lower-spmd-call-args-from-values-at
          ctx
          env
          type-env
          index
          args
          params
          (ir.compiler-ir-value-seq-to-list seq)
          arg-index)]
      [(ir.CompilerIrValueList.Cons value rest)
        (match (ast.ast-param-list-get
          params
          arg-index
          (ast.ast-param-fallback))
          [(ast.AstParam.Param _ param-ty _ _)
            (let
              [resolved-ty : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx param-ty))]
              [arg : ast.AstExpr
                (lower-context-expr-get
                  ctx
                  (ast.ast-expr-list-get args arg-index 0))]
              [varying : bool
                (lower-spmd-scalar-arg-varying? ctx env type-env index arg)]
              (ir.ir-spmd-call-arg-cons
                (ir.CompilerIrSpmdCallArg.Arg
                  (lower-spmd-ir-value-class resolved-ty varying)
                  value
                  resolved-ty)
                (lower-spmd-call-args-from-values-at
                  ctx
                  env
                  type-env
                  index
                  args
                  params
                  (box-get rest)
                  (+ arg-index 1))))])]
      [(ir.CompilerIrValueList.Nil) ir.CompilerIrSpmdCallArgList.Nil])))

(define (lower-imported-spmd-scalar-call
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [canonical-name : i64]
  [fn-ty : ast.AstType]
  [callables : ast.AstImportedSpmdCallableList]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeSpmdCall
  (match fn-ty
    [(ast.AstType.Func param-types ret-id)
      (let
        [params : ast.AstParamList
          (lower-imported-spmd-params ctx (box-get param-types))]
        [ret : ast.AstType (tc_core.tc-context-type-get ctx ret-id)]
        (if (<=
          (lower-spmd-call-args-lanes
            ctx
            (CompilerLowerMode.Avx512)
            env
            type-env
            index
            (lower-masked-vector-empty-lane-locals)
            args)
          0)
          (LowerMaybeSpmdCall.No)
          (match (lower-call-args-as-needed
            ctx
            state
            env
            type-env
            args
            (tc_core.tc-param-type-list ctx params))
            [(ResultLowerCallArgs.Err message) (LowerMaybeSpmdCall.Err message)]
            [(ResultLowerCallArgs.Ok args-state values writebacks)
              (let
                [call-args : ir.CompilerIrSpmdCallArgList
                  (lower-spmd-call-args-from-values
                    ctx
                    env
                    type-env
                    index
                    args
                    params
                    values)]
                [args-code : String
                  (lower-imported-spmd-call-args-code call-args)]
                [signature : String (lower-spmd-source-signature params ret)]
                [requested-index-param : i64
                  (lower-imported-spmd-index-param ctx index args)]
                (match (lower-imported-spmd-select
                  canonical-name
                  (& callables)
                  signature
                  (ir.CompilerIrSpmdBackend.Scalar)
                  1
                  args-code
                  requested-index-param
                  ret
                  origin)
                  [(ResultLowerImportedSpmdSpecialization.Err message)
                    (LowerMaybeSpmdCall.Err message)]
                  [(ResultLowerImportedSpmdSpecialization.Ok specialization)
                    (match (lower-avx512-emit-spmd-call
                      args-state
                      (lower-imported-spmd-ir-symbol specialization)
                      (ir.CompilerIrSpmdBackend.Scalar)
                      (ir.CompilerIrValue.Bool true)
                      1
                      call-args
                      result-ty
                      (lower-imported-spmd-result-varying? specialization)
                      origin)
                      [(ResultLowerExpr.Err message)
                        (LowerMaybeSpmdCall.Err message)]
                      [(ResultLowerExpr.Ok lowered)
                        (match lowered
                          [(LowerExpr.Expr call-state value ty)
                            (LowerMaybeSpmdCall.Some
                              (LowerExpr.Expr
                                (lower-apply-arg-writebacks
                                  ctx
                                  call-state
                                  writebacks)
                                value
                                ty))])])]))])))]
    [_
      (LowerMaybeSpmdCall.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: imported SPMD helper does not have function type")))]))

(define (lower-spmd-scalar-call-maybe
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeSpmdCall
  (match (lower-global-shared-view lower-spmd-scalar-call-context)
    [(LowerSpmdScalarCallContext.No) (LowerMaybeSpmdCall.No)]
    [(LowerSpmdScalarCallContext.Some index)
      (match (lower-spmd-inline-helper-lookup
        ctx
        env
        type-env
        (lower-id-set-empty)
        func)
        [(ResultLowerSpmdInlineHelper.Ok helper)
          (match helper
            [(LowerSpmdInlineHelper.Some _ params ret body)
              (if (and
                (lower-spmd-helper-out-of-line? ctx body)
                (>
                  (lower-spmd-call-args-lanes
                    ctx
                    (CompilerLowerMode.Avx512)
                    env
                    type-env
                    index
                    (lower-masked-vector-empty-lane-locals)
                    args)
                  0))
                (match (lower-call-args-as-needed
                  ctx
                  state
                  env
                  type-env
                  args
                  (tc_core.tc-param-type-list ctx params))
                  [(ResultLowerCallArgs.Ok args-state values writebacks)
                    (match (lower-state-fresh-lambda-name args-state)
                      [(LowerLambdaName.Name named-state hidden-name)
                        (let
                          [call-args : ir.CompilerIrSpmdCallArgList
                            (lower-spmd-call-args-from-values
                              ctx
                              env
                              type-env
                              index
                              args
                              params
                              values)]
                          (match (lower-spmd-specialized-helper-function
                            ctx
                            type-env
                            (lower-state-type-cache named-state)
                            hidden-name
                            params
                            ret
                            false
                            body
                            (ir.CompilerIrSpmdBackend.Scalar)
                            call-args
                            1
                            ""
                            -1
                            (lower-state-spans named-state)
                            (lower-state-names named-state)
                            (lower-state-mode named-state))
                            [(ResultLowerFunction.Ok functions helper-spans)
                              (match (lower-avx512-emit-spmd-call
                                (lower-state-add-functions
                                  named-state
                                  functions
                                  helper-spans)
                                hidden-name
                                (ir.CompilerIrSpmdBackend.Scalar)
                                (ir.CompilerIrValue.Bool true)
                                1
                                call-args
                                result-ty
                                (>
                                  (lower-spmd-direct-call-result-lanes
                                    ctx
                                    (CompilerLowerMode.Avx512)
                                    env
                                    type-env
                                    index
                                    (lower-masked-vector-empty-lane-locals)
                                    func
                                    args)
                                  0)
                                origin)
                                [(ResultLowerExpr.Ok lowered)
                                  (match lowered
                                    [(LowerExpr.Expr call-state value ty)
                                      (LowerMaybeSpmdCall.Some
                                        (LowerExpr.Expr
                                          (lower-apply-arg-writebacks
                                            ctx
                                            call-state
                                            writebacks)
                                          value
                                          ty))])]
                                [(ResultLowerExpr.Err message)
                                  (LowerMaybeSpmdCall.Err message)])]
                            [(ResultLowerFunction.Err message)
                              (LowerMaybeSpmdCall.Err message)]))])]
                  [(ResultLowerCallArgs.Err message)
                    (LowerMaybeSpmdCall.Err message)])
                (LowerMaybeSpmdCall.No))]
            [(LowerSpmdInlineHelper.Imported canonical-name fn-ty callables)
              (lower-imported-spmd-scalar-call
                ctx
                state
                env
                type-env
                index
                canonical-name
                fn-ty
                (box-get callables)
                args
                result-ty
                origin)]
            [(LowerSpmdInlineHelper.No) (LowerMaybeSpmdCall.No)])]
        [(ResultLowerSpmdInlineHelper.Err message)
          (LowerMaybeSpmdCall.Err message)])]))

(define (lower-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (tc_core.tc-lambda-expr-allow-ref-captures
              ctx
              type-env
              params
              maybe-ret
              body)
              [(tc_core.ResultTcType.Ok fn-ty)
                (match (lower-lambda
                  ctx
                  state
                  env
                  type-env
                  params
                  maybe-ret
                  body
                  func
                  fn-ty)
                  [(ResultLowerExpr.Ok lowered-func)
                    (match lowered-func
                      [(LowerExpr.Expr func-state func-value _)
                        (lower-indirect-call
                          ctx
                          func-state
                          env
                          type-env
                          fn-ty
                          func-value
                          args
                          result-ty
                          origin)])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
              [(tc_core.ResultTcType.Err message)
                (ResultLowerExpr.Err
                  (box (lower-diagnostic-at-expr func message)))]))])]
    [(ast.AstExpr.Var raw-name)
      ;; Builtins reached from a macro expansion arrive hygiene-renamed
      ;; (`__tl_macro_global$string.string-length`); strip the prefix so the builtin
      ;; dispatch below (length/string-length inline loads, etc.) fires just as it
      ;; does for hand-written calls. `raw-name` still keys the local-variable
      ;; lookup, and the generic call path strips the prefix itself.
      (let
        [raw-text : String
          (if (or
            (tc_core.macro-hygiene-global-id? raw-name)
            (tc_core.macro-hygiene-local-id? raw-name))
            (ci.intern-str
              (tc_core.macro-hygiene-structural-source-name-id raw-name))
            (tc_core.tc-env-key-name-text raw-name))]
        (if (tc_core.tc-dotted-local-field-name-id? type-env raw-name)
          (match (lower-expr ctx state env type-env func)
            [(ResultLowerExpr.Ok lowered-func)
              (match lowered-func
                [(LowerExpr.Expr func-state func-value func-ty)
                  (if (lower-function-type? func-ty)
                    (if (tc_core.tc-expr-c-abi-fnptr? ctx type-env func)
                      (lower-indirect-c-abi-call
                        ctx
                        func-state
                        env
                        type-env
                        func-ty
                        func-value
                        args
                        result-ty
                        origin)
                      (lower-indirect-call
                        ctx
                        func-state
                        env
                        type-env
                        func-ty
                        func-value
                        args
                        result-ty
                        origin))
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          func
                          "lower: call target is not a function"))))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
          (let
            [local-id : i64
              (sym_i64_env.sym-i64-lookup-id-or
                env
                raw-name
                (csym.compiler-symbols-missing-handle))]
            (if (csym.compiler-symbols-handle-found? local-id)
              (match (tc_core.tc-lookup-id type-env raw-name)
                [(tc_core.ResultTcType.Ok fn-ty)
                  (if (lower-function-type? fn-ty)
                    (if (tc_core.tc-binding-c-abi-fnptr-id? type-env raw-name)
                      (lower-indirect-c-abi-call
                        ctx
                        state
                        env
                        type-env
                        fn-ty
                        (ir.CompilerIrValue.Var local-id)
                        args
                        result-ty
                        origin)
                      (lower-indirect-call
                        ctx
                        state
                        env
                        type-env
                        fn-ty
                        (ir.CompilerIrValue.Var local-id)
                        args
                        result-ty
                        origin))
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          func
                          "lower: call target is not a function"))))]
                [(tc_core.ResultTcType.Err message)
                  (ResultLowerExpr.Err
                    (box (lower-diagnostic-at-expr func message)))])
              (let
                [hygiene-global : bool
                  (or
                    (tc_core.macro-hygiene-global-id? raw-name)
                    (tc_core.tc-hygiene-global-name? raw-text))]
                (match (if hygiene-global
                  (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
                    ctx
                    type-env
                    raw-text
                    raw-name
                    true)
                    [(tc_core.TcNameLookup.Ok _ resolved-id)
                      (tc_core.TcNameLookup.Ok
                        (tc_core.tc-hygiene-global-call-name raw-text)
                        resolved-id)]
                    [(tc_core.TcNameLookup.Err _)
                      (tc_core.TcNameLookup.Ok
                        (tc_core.tc-hygiene-global-call-name raw-text)
                        raw-name)])
                  (if (tc_core.tc-source-slash-qualified-id? raw-text raw-name)
                    (tc_core.TcNameLookup.Ok raw-text raw-name)
                    (tc_core.tc-source-name-lookup-key-with-field-check-lookup
                      ctx
                      type-env
                      raw-text
                      raw-name
                      true)))
                  [(tc_core.TcNameLookup.Ok name lookup-name-id)
                    ;; `array-length`/`length` on a dynamic array and private
                    ;; string intrinsics load fat-value fields directly instead of
                    ;; calling runtime symbols. Other `length` argument types keep
                    ;; the ordinary direct-call path.
                    (let
                      [source-id : i64
                        (if hygiene-global
                          (tc_core.macro-hygiene-global-source-name-id-or
                            raw-name
                            raw-name)
                          raw-name)]
                      [source-key-id : i64
                        (tc_core.tc-env-name-key-id source-id)]
                      [lowered-name : String
                        (if hygiene-global
                          (match (lower-name-cache-lookup-id
                            (lower-state-names state)
                            source-key-id)
                            [(tc_core.TcMaybeString.Some logical-name)
                              logical-name]
                            [(tc_core.TcMaybeString.No)
                              (lower-hygiene-source-name-in-context-id
                                ctx
                                type-env
                                raw-name)])
                          name)]
                      [name-id : i64 source-key-id]
                      [builtin-available : bool
                        (lower-top-level-builtin-available-id?
                          ctx
                          type-env
                          name-id)]
                      ;; Macro hygiene retains the defining-module spelling in
                      ;; `name`, while the typechecker classifies public Slice
                      ;; intrinsics from their source name. Reuse that exact
                      ;; shadow-aware classifier so generated declarations do
                      ;; not lower slice-view as an ordinary external call.
                      [slice-call-kind : tc_core.TcSliceViewCallKind
                        (tc_core.tc-slice-view-call-kind-name
                          ctx
                          type-env
                          source-id
                          (ci.intern-str source-id))]
                      [atomic-symbol : String
                        (lower-atomic-extern-symbol-for-name-id
                          ctx
                          name
                          lookup-name-id)]
                      (cond
                        [(> (string.string-length atomic-symbol) 0)
                          (lower-atomic-call
                            ctx
                            state
                            env
                            type-env
                            atomic-symbol
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (lower-atomic-pointer-name? name))
                          (lower-atomic-pointer-call
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (tc_core.tc-layout-query-name? name))
                          (ResultLowerExpr.Err
                            (box
                              (lower-diagnostic-at-expr
                                origin
                                (string.append
                                  "lower: "
                                  (string.append
                                    name
                                    " is compile-time only; wrap it in (comptime ...)")))))]
                        [(not
                            (= slice-call-kind tc_core.TcSliceViewCallKind.None))
                          (lower-slice-view-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(tc_core.tc-string-ref-helper-call-id?
                            ctx
                            type-env
                            source-id
                            name-id)
                          (lower-string-ref-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(tc_core.tc-string-length-helper-call-id?
                            ctx
                            type-env
                            source-id
                            name-id)
                          (lower-array-length
                            ctx
                            state
                            env
                            type-env
                            cbi.compiler-builtin-id-tl-private-string-length
                            "__tl_string_length"
                            args
                            result-ty
                            origin)]
                        [(lower-private-string-eq-helper-call-id?
                            ctx
                            type-env
                            name-id)
                          (lower-string-eq-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(lower-private-string-to-int-helper-call-id?
                            ctx
                            type-env
                            name-id)
                          (lower-string-to-int-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(or
                            (lower-string-concat-public-target? name)
                            (and
                              builtin-available
                              (lower-string-concat-legacy-name? name)))
                          (lower-string-concat-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            (lower-float-bitcast-literal-call?
                              ctx
                              args
                              result-ty)
                            (lower-float-to-bits-public-target? name))
                          (lower-float-bitcast-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-string-ref-call-id?
                              name-id))
                          (lower-string-ref-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-length-call-id? name-id))
                          (lower-array-length
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (lower-string-runtime-builtin? name))
                          (lower-string-runtime-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-cpuid-id? name-id))
                          (lower-cpuid-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-xgetbv-id? name-id))
                          (lower-xgetbv-call ctx state env type-env args origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-clone-id? name-id))
                          (if (= (struct-get (& args) len) 1)
                            (lower-clone-call
                              ctx
                              state
                              env
                              type-env
                              (lower-context-expr-get
                                ctx
                                (ast.ast-expr-list-get (& args) 0 0)))
                            (ResultLowerExpr.Err
                              (box
                                (lower-diagnostic
                                  "lower: clone expects one argument"))))]
                        [(and
                            builtin-available
                            (lower-arena-builtin-id? name-id))
                          (lower-arena-builtin-call
                            ctx
                            state
                            env
                            type-env
                            name-id
                            args
                            result-ty)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-float-sqrt-id? name-id))
                          (lower-float-sqrt-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-float-bitcast-id?
                              name-id))
                          (lower-float-bitcast-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-tls-current-arena-id?
                              name-id))
                          (lower-tls-current-arena-call
                            ctx
                            state
                            env
                            type-env
                            name-id
                            args
                            result-ty)]
                        [(and
                            builtin-available
                            (lower-bootstrap-runtime-builtin-id? name-id))
                          (lower-bootstrap-runtime-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(lower-comptime-error-source-or-lookup-id?
                            source-id
                            name-id)
                          (ResultLowerExpr.Err
                            (box
                              (lower-diagnostic-at-expr
                                origin
                                "lower: comptime-error is compile-time only")))]
                        [else
                          (match (lower-spmd-scalar-call-maybe
                            ctx
                            state
                            env
                            type-env
                            func
                            args
                            result-ty
                            origin)
                            [(LowerMaybeSpmdCall.Some lowered)
                              (ResultLowerExpr.Ok lowered)]
                            [(LowerMaybeSpmdCall.Err message)
                              (ResultLowerExpr.Err message)]
                            [(LowerMaybeSpmdCall.No)
                              (lower-call-non-builtin
                                ctx
                                state
                                env
                                type-env
                                lowered-name
                                raw-name
                                lookup-name-id
                                args
                                result-ty
                                origin)])]))]
                  [(tc_core.TcNameLookup.Err message)
                    (ResultLowerExpr.Err
                      (box (lower-diagnostic-at-expr origin message)))]))))))]
    [_
      (match (lower-expr ctx state env type-env func)
        [(ResultLowerExpr.Ok lowered-func)
          (match lowered-func
            [(LowerExpr.Expr func-state func-value func-ty)
              (if (lower-function-type? func-ty)
                (if (tc_core.tc-expr-c-abi-fnptr? ctx type-env func)
                  (lower-indirect-c-abi-call
                    ctx
                    func-state
                    env
                    type-env
                    func-ty
                    func-value
                    args
                    result-ty
                    origin)
                  (lower-indirect-call
                    ctx
                    func-state
                    env
                    type-env
                    func-ty
                    func-value
                    args
                    result-ty
                    origin))
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      func
                      "lower: call target is not a function"))))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]))

;; A dynamic-array value is a pointer to inline fat storage `{data_ptr, length}`
;; with the i64 length at byte offset 8. `Gep` scales the index by the element
;; size, so index 1 with element type i64 addresses that length field, which a
;; typed `Load` then reads. Dynamic-array and borrowed-Slice calls plus
;; core/private string-length calls are intercepted; other `length` arguments
;; fall back to a direct call.
(define (lower-array-length
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        (lower-state-type-cache state)
        arr)
        [(tc_core.ResultTcType.Ok arr-ty)
          (lower-array-length-with-type
            ctx
            state
            env
            type-env
            source-id
            name
            args
            result-ty
            origin
            arr
            arr-ty)]
        [(tc_core.ResultTcType.Err _)
          (match (tc_core.tc-expr ctx type-env arr)
            [(tc_core.ResultTcType.Ok arr-ty)
              (lower-array-length-with-type
                ctx
                state
                env
                type-env
                source-id
                name
                args
                result-ty
                origin
                arr
                arr-ty)]
            [(tc_core.ResultTcType.Err _)
              (lower-direct-call-id
                ctx
                state
                env
                type-env
                source-id
                name
                args
                result-ty
                origin)])]))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-array-length-with-type
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]
  [arr : ast.AstExpr]
  [arr-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-array-length-receiver ctx arr-ty)
    [(tc_core.ResultTcArrayReceiver.Ok _)
      (lower-array-length-load ctx state env type-env arr)]
    [(tc_core.ResultTcArrayReceiver.Err _)
      (if (and
        (cbi.compiler-builtin-lower-string-length-load-id? source-id)
        (lower-length-handle-type? ctx arr-ty))
        (lower-array-length-load ctx state env type-env arr)
        (lower-direct-call-id
          ctx
          state
          env
          type-env
          source-id
          name
          args
          result-ty
          origin))]))

(define (lower-array-length-load
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr arr-state arr-value arr-ty)
          (let
            [resolved : ast.AstType
              (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx arr-ty))]
            (match resolved
              [(ast.AstType.Ref _ inner)
                (if (lower-reference-to-slice? ctx inner)
                  (match (lower-emit-word
                    arr-state
                    arr-value
                    1
                    (lower-register-word-type ctx arr-ty 1))
                    [(LowerExpr.Expr length-state length-value _)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          length-state
                          length-value
                          (ast.AstType.I64)))])
                  (lower-array-length-load-descriptor arr-state arr-value))]
              [(ast.AstType.MutRef _ inner)
                (if (lower-reference-to-slice? ctx inner)
                  (match (lower-emit-word
                    arr-state
                    arr-value
                    1
                    (lower-register-word-type ctx arr-ty 1))
                    [(LowerExpr.Expr length-state length-value _)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          length-state
                          length-value
                          (ast.AstType.I64)))])
                  (lower-array-length-load-descriptor arr-state arr-value))]
              [_ (lower-array-length-load-descriptor arr-state arr-value)]))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-array-length-load-descriptor
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc gep-alloc gep-var)
      (let
        [gep-state : LowerState
          (lower-state-emit
            gep-alloc
            (ir.CompilerIrInstr.Gep
              gep-var
              arr-value
              (ir.CompilerIrValue.I64 1)
              (ast.AstType.I64)))]
        (match (lower-state-alloc-var gep-state)
          [(LowerAlloc.Alloc load-alloc load-var)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-state-emit
                  load-alloc
                  (ir.CompilerIrInstr.Load
                    load-var
                    (ir.CompilerIrValue.Var gep-var)
                    (ast.AstType.I64)))
                (ir.CompilerIrValue.Var load-var)
                (ast.AstType.I64)))]))]))

(define (lower-string-data
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [str : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env str)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr str-state str-value _)
          (match (lower-load-at-offset str-state str-value 0 result-ty)
            [(LowerExpr.Expr data-state data-value _)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr data-state data-value result-ty))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-array-data
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [array : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env array)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr array-state array-value array-ty)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx array-ty))
            [(ast.AstType.DynArray _)
              (match (lower-load-at-offset array-state array-value 0 result-ty)
                [(LowerExpr.Expr data-state data-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr data-state data-value result-ty))])]
            [(ast.AstType.Array _ _)
              (ResultLowerExpr.Ok
                (lower-cast-value array-state array-value array-ty result-ty))]
            [_
              (ResultLowerExpr.Err
                (box (lower-diagnostic "lower: array-data requires array")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-string-from-bytes
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [ptr : ast.AstExpr]
  [len : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env ptr)
    [(ResultLowerExpr.Ok ptr-lowered)
      (match ptr-lowered
        [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
          (match (lower-integer-expr-with-expected-or-actual
            ctx
            ptr-state
            env
            type-env
            len
            (ast.AstType.I64)
            "lower: string-from-bytes length must be integer")
            [(ResultLowerExpr.Ok len-lowered)
              (match len-lowered
                [(LowerExpr.Expr len-state len-value len-ty)
                  (match (lower-cast-value
                    len-state
                    len-value
                    len-ty
                    (ast.AstType.I64))
                    [(LowerExpr.Expr len-i-state len-i-value _)
                      (match (lower-reserve-heap-storage
                        len-i-state
                        16
                        (ast.AstType.String))
                        [(LowerExpr.Expr base-state base-value _)
                          (let
                            [with-ptr : LowerState
                              (lower-store-at-offset
                                base-state
                                base-value
                                0
                                ptr-value
                                (lower-raw-pointer-ir-type ptr-ty))]
                            [with-len : LowerState
                              (lower-store-at-offset
                                with-ptr
                                base-value
                                8
                                len-i-value
                                (ast.AstType.I64))]
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                with-len
                                base-value
                                (ast.AstType.String))))])])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-entry-load
  [state : LowerState]
  [kind : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (let
        [instr : ir.CompilerIrInstr
          (if (= kind 0)
            (ir.CompilerIrInstr.EntryArgc var-id)
            (if (= kind 1)
              (ir.CompilerIrInstr.EntryArgv var-id)
              (ir.CompilerIrInstr.EntryEnvp var-id)))]
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit allocated instr)
            (ir.CompilerIrValue.Var var-id)
            result-ty)))]))

(define (lower-cpuid-like
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [leaf : ast.AstExpr]
  [subleaf : ast.AstExpr]
  [reg-index : i64]) : ResultLowerExpr
  (match (lower-integer-expr-with-expected-or-actual
    ctx
    state
    env
    type-env
    leaf
    (ast.AstType.I64)
    "lower: cpuid leaf must be integer")
    [(ResultLowerExpr.Ok leaf-lowered)
      (match leaf-lowered
        [(LowerExpr.Expr leaf-state leaf-value leaf-ty)
          (match (lower-cast-value
            leaf-state
            leaf-value
            leaf-ty
            (ast.AstType.I64))
            [(LowerExpr.Expr leaf-i-state leaf-i-value _)
              (match (lower-integer-expr-with-expected-or-actual
                ctx
                leaf-i-state
                env
                type-env
                subleaf
                (ast.AstType.I64)
                "lower: cpuid subleaf must be integer")
                [(ResultLowerExpr.Ok subleaf-lowered)
                  (match subleaf-lowered
                    [(LowerExpr.Expr subleaf-state subleaf-value subleaf-ty)
                      (match (lower-cast-value
                        subleaf-state
                        subleaf-value
                        subleaf-ty
                        (ast.AstType.I64))
                        [(LowerExpr.Expr subleaf-i-state subleaf-i-value _)
                          (match (lower-state-alloc-var subleaf-i-state)
                            [(LowerAlloc.Alloc allocated var-id)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr
                                  (lower-state-emit
                                    allocated
                                    (ir.CompilerIrInstr.CpuId
                                      var-id
                                      leaf-i-value
                                      subleaf-i-value
                                      reg-index))
                                  (ir.CompilerIrValue.Var var-id)
                                  (ast.AstType.I64)))])])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-xgetbv
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : ast.AstExpr]) : ResultLowerExpr
  (match (lower-integer-expr-with-expected-or-actual
    ctx
    state
    env
    type-env
    index
    (ast.AstType.I64)
    "lower: xgetbv index must be integer")
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr index-state index-value index-ty)
          (match (lower-cast-value
            index-state
            index-value
            index-ty
            (ast.AstType.I64))
            [(LowerExpr.Expr index-i-state index-i-value _)
              (match (lower-state-alloc-var index-i-state)
                [(LowerAlloc.Alloc allocated var-id)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-state-emit
                        allocated
                        (ir.CompilerIrInstr.Xgetbv var-id index-i-value))
                      (ir.CompilerIrValue.Var var-id)
                      (ast.AstType.I64)))])])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-cpuid-store-field
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [leaf : ir.CompilerIrValue]
  [subleaf : ir.CompilerIrValue]
  [reg-index : i64]
  [offset : i64]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (lower-store-at-offset
        (lower-state-emit
          allocated
          (ir.CompilerIrInstr.CpuId var-id leaf subleaf reg-index))
        base
        offset
        (ir.CompilerIrValue.Var var-id)
        (ast.AstType.I32))]))

(define (lower-cpuid-tuple-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [leaf : ir.CompilerIrValue]
  [subleaf : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-resolve-type ctx result-ty)
    [(ast.AstType.Tuple elem-tys)
      (match (lower-reserve-heap-storage
        state
        (lower-type-list-storage-size ctx (box-get elem-tys))
        result-ty)
        [(LowerExpr.Expr base-state base _)
          (let
            [eax-state : LowerState
              (lower-cpuid-store-field base-state base leaf subleaf 0 0)]
            [ebx-state : LowerState
              (lower-cpuid-store-field eax-state base leaf subleaf 1 4)]
            [ecx-state : LowerState
              (lower-cpuid-store-field ebx-state base leaf subleaf 2 8)]
            [edx-state : LowerState
              (lower-cpuid-store-field ecx-state base leaf subleaf 3 12)]
            (ResultLowerExpr.Ok (LowerExpr.Expr edx-state base result-ty)))])]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr origin "lower: cpuid requires tuple result")))]))

(define (lower-cpuid-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 2)
    (let
      [leaf : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [subleaf : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      (match (lower-integer-expr-with-expected-or-actual
        ctx
        state
        env
        type-env
        leaf
        (ast.AstType.I64)
        "lower: cpuid leaf must be integer")
        [(ResultLowerExpr.Ok leaf-lowered)
          (match leaf-lowered
            [(LowerExpr.Expr leaf-state leaf-value leaf-ty)
              (match (lower-cast-value
                leaf-state
                leaf-value
                leaf-ty
                (ast.AstType.I64))
                [(LowerExpr.Expr leaf-i-state leaf-i-value _)
                  (match (lower-integer-expr-with-expected-or-actual
                    ctx
                    leaf-i-state
                    env
                    type-env
                    subleaf
                    (ast.AstType.I64)
                    "lower: cpuid subleaf must be integer")
                    [(ResultLowerExpr.Ok subleaf-lowered)
                      (match subleaf-lowered
                        [(LowerExpr.Expr subleaf-state subleaf-value subleaf-ty)
                          (match (lower-cast-value
                            subleaf-state
                            subleaf-value
                            subleaf-ty
                            (ast.AstType.I64))
                            [(LowerExpr.Expr subleaf-i-state subleaf-i-value _)
                              (lower-cpuid-tuple-values
                                ctx
                                subleaf-i-state
                                leaf-i-value
                                subleaf-i-value
                                result-ty
                                origin)])])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box (lower-diagnostic "lower: cpuid expects two arguments")))))

(define (lower-xgetbv-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (lower-xgetbv
      ctx
      state
      env
      type-env
      (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0)))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic-at-expr origin "lower: xgetbv expects one argument")))))

;; Small emit helpers: allocate a fresh var, emit one instruction, and return a
;; `LowerExpr` carrying the updated state plus the result value. These flatten
;; the otherwise deeply-nested alloc/emit chains in the array-access lowering.
(define (lower-emit-cast
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir.CompilerIrInstr.Cast v value from-ty to-ty))
        (ir.CompilerIrValue.Var v)
        to-ty)]))

(define (lower-emit-gep
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [gep-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir.CompilerIrInstr.Gep v base index gep-ty))
        (ir.CompilerIrValue.Var v)
        gep-ty)]))

(define (lower-emit-load
  [state : LowerState]
  [addr : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir.CompilerIrInstr.Load v addr ty))
        (ir.CompilerIrValue.Var v)
        ty)]))

(define (lower-emit-binop
  [state : LowerState]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir.CompilerIrInstr.BinOp v op lhs rhs ty))
        (ir.CompilerIrValue.Var v)
        (ir.compiler-ir-binop-result-type op ty))]))

;; A BoundsCheck is emitted as one unsigned `cmpq length, index`, so a operand
;; that is already a width-64 integer needs no materialised `Cast ... : u64`:
;; i64 and u64 share the single 64-bit register/stack home the compare reads,
;; and the emitted instruction is identical either way. A negative i64 index
;; still traps, because the unsigned compare sees its sign-extended pattern as a
;; huge value -- which is exactly what the cast used to produce.
;;
;; The IR already carries raw i64 bounds-check operands: the gather lane checks
;; and the vector-map lane-array checks pass array lengths and computed indices
;; straight through with no cast at all. The optimizer likewise already assumes
;; the identity, canonicalising an `I64->U64` bounds operand back to its source
;; before keying redundancy facts (opt-bounds-cast-canon).
;;
;; Emitting the cast anyway costs one extra SSA value per operand -- two per
;; array access -- that the register allocator must give a home. Under pressure
;; that home is a spill slot, and because the slot colouring re-derives slots
;; per variable it need not be the source's slot, so the "no-op" cast
;; materialises as a real staged slot-to-slot copy in front of every check.
;;
;; Narrower operands keep their cast: those extensions are real work.
(define (lower-bounds-operand-width-64? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [_ false]))

(define (lower-emit-bounds-operand
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]) : LowerExpr
  (if (lower-bounds-operand-width-64? from-ty)
    (LowerExpr.Expr state value from-ty)
    (lower-emit-cast state value from-ty (ast.AstType.U64))))

(define (lower-emit-bounds-check
  [state : LowerState]
  [index : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]) : LowerState
  (match (lower-state-fresh-label state "bounds_ok")
    [(LowerLabel.Label bounds-ok-state bounds-ok-label)
      (lower-state-emit
        bounds-ok-state
        (ir.CompilerIrInstr.BoundsCheck index length bounds-ok-label))]))

;; Address an array element, striding by the element's full inline
;; size. Memory aggregates use a byte-offset GEP so fixed arrays, structs, and
;; enums use their real layout size instead of an address-sized backend scale.
;; Scalars and pointer-slot handles keep the type-scaled GEP.
(define (lower-emit-elem-addr-gep
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [idx-off : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : LowerExpr
  (if (lower-type-inline-storage? ctx elem-ty)
    (match (lower-emit-binop
      state
      ir.CompilerIrBinOp.Mul
      idx-off
      (ir.CompilerIrValue.I64 (lower-type-size ctx elem-ty))
      (ast.AstType.I64))
      [(LowerExpr.Expr mul-state byte-off _)
        (lower-emit-gep mul-state base byte-off (ast.AstType.U8))])
    (lower-emit-gep state base idx-off elem-ty)))

;; Tail of `lower-array-element-addr`: after the explicit bounds check, load the
;; buffer pointer (fat offset 0, a raw U64 address) and Gep it by the index to
;; the element address (striding by the real inline element size).
(define (lower-array-element-addr-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [idx-off : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-gep
    state
    arr-value
    (ir.CompilerIrValue.I64 0)
    (ast.AstType.I64))
    [(LowerExpr.Expr buf-gep-state buf-gep _)
      (match (lower-emit-load buf-gep-state buf-gep (ast.AstType.U64))
        [(LowerExpr.Expr buf-state buf-val _)
          (lower-emit-elem-addr-gep ctx buf-state buf-val idx-off elem-ty)])]))

;; Compute the address of element `idx-value` in dynamic array `arr-value`,
;; emitting an unsigned bounds check (negative indices wrap large and also
;; fail). Returns the element pointer as an `elem-ty`-typed value.
(define (lower-array-element-addr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-bounds-operand state idx-value idx-ty)
    [(LowerExpr.Expr s1 idx-u _)
      (match (lower-emit-cast s1 idx-value idx-ty (ast.AstType.I64))
        [(LowerExpr.Expr s2 idx-off _)
          (match (lower-emit-gep
            s2
            arr-value
            (ir.CompilerIrValue.I64 1)
            (ast.AstType.I64))
            [(LowerExpr.Expr s3 len-gep _)
              (match (lower-emit-load s3 len-gep (ast.AstType.I64))
                [(LowerExpr.Expr s4 len-val _)
                  (match (lower-emit-bounds-operand
                    s4
                    len-val
                    (ast.AstType.I64))
                    [(LowerExpr.Expr s5 len-u _)
                      (lower-array-element-addr-finish
                        ctx
                        (lower-emit-bounds-check s5 idx-u len-u)
                        arr-value
                        idx-off
                        elem-ty)])])])])]))

;; Compute a checked element address for a borrowed Slice register group.
;; Word0 is the data pointer and word1 is the signed length, so this path
;; never loads a dynamic-array descriptor.
(define (lower-slice-element-addr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [slice-value : ir.CompilerIrValue]
  [slice-ty : ast.AstType]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-word
    state
    slice-value
    0
    (lower-register-word-type ctx slice-ty 0))
    [(LowerExpr.Expr s0 data-ptr _)
      (match (lower-emit-word
        s0
        slice-value
        1
        (lower-register-word-type ctx slice-ty 1))
        [(LowerExpr.Expr s1 length-i64 _)
          (match (lower-emit-bounds-operand s1 idx-value idx-ty)
            [(LowerExpr.Expr s2 idx-u _)
              (match (lower-emit-cast s2 idx-value idx-ty (ast.AstType.I64))
                [(LowerExpr.Expr s3 idx-off _)
                  (match (lower-emit-bounds-operand
                    s3
                    length-i64
                    (ast.AstType.I64))
                    [(LowerExpr.Expr s4 length-u _)
                      (lower-emit-elem-addr-gep
                        ctx
                        (lower-emit-bounds-check s4 idx-u length-u)
                        data-ptr
                        idx-off
                        elem-ty)])])])])]))

(define (lower-atomic-elem-type [symbol : String]) : ast.AstType
  (if (or
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add"))
    (ast.AstType.I32)
    (ast.AstType.I64)))

(define (lower-atomic-raw-symbol [symbol : String]) : i64
  (lower-derived-symbol-id
    (cond
      [(string.eq symbol "tl_atomic_i64_load") "tl_atomic_i64_load_ptr"]
      [(string.eq symbol "tl_atomic_i64_store") "tl_atomic_i64_store_ptr"]
      [(string.eq symbol "tl_atomic_i64_add") "tl_atomic_i64_add_ptr"]
      [(string.eq symbol "tl_atomic_i64_fetch_add")
        "tl_atomic_i64_fetch_add_ptr"]
      [(string.eq symbol "tl_atomic_i32_load") "tl_atomic_i32_load_ptr"]
      [(string.eq symbol "tl_atomic_i32_store") "tl_atomic_i32_store_ptr"]
      [(string.eq symbol "tl_atomic_i32_add") "tl_atomic_i32_add_ptr"]
      [else "tl_atomic_i32_fetch_add_ptr"])))

(define (lower-atomic-pointer-name? [name : String]) : bool
  (or
    (string.eq name "atomic-load")
    (string.eq name "atomic-store!")
    (string.eq name "atomic-add!")
    (string.eq name "atomic-fetch-add!")
    (string.eq name "atomic-cas!")
    (string.eq name "volatile-load")
    (string.eq name "volatile-store!")))

(define (lower-atomic-pointer-func?
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var raw-name)
      (let
        [name-id : i64
          (tc_core.macro-hygiene-global-source-name-id-or raw-name raw-name)]
        [name : String (tc_core.tc-env-key-name-text name-id)]
        (and
          (lower-atomic-pointer-name? name)
          (not (tc_core.tc-name-bound-id? type-env name-id))))]
    [_ false]))

(define (lower-atomic-pointer-load-name? [name : String]) : bool
  (or (string.eq name "atomic-load") (string.eq name "volatile-load")))

(define (lower-atomic-pointer-cas-name? [name : String]) : bool
  (string.eq name "atomic-cas!"))

(define (lower-atomic-pointer-volatile-name? [name : String]) : bool
  (or (string.eq name "volatile-load") (string.eq name "volatile-store!")))

(define (lower-atomic-pointer-width-prefix
  [name : String]
  [elem-ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region elem-ty)
    [(ast.AstType.I32)
      (if (lower-atomic-pointer-volatile-name? name)
        "tl_volatile_i32_"
        "tl_atomic_i32_")]
    [(ast.AstType.U32)
      (if (lower-atomic-pointer-volatile-name? name)
        "tl_volatile_i32_"
        "tl_atomic_i32_")]
    [_
      (if (lower-atomic-pointer-volatile-name? name)
        "tl_volatile_i64_"
        "tl_atomic_i64_")]))

(define (lower-atomic-pointer-op-suffix [name : String]) : String
  (cond
    [(string.eq name "atomic-load") "load_ptr"]
    [(string.eq name "atomic-store!") "store_ptr"]
    [(string.eq name "atomic-add!") "add_ptr"]
    [(string.eq name "atomic-fetch-add!") "fetch_add_ptr"]
    [(string.eq name "volatile-load") "load_ptr"]
    [(string.eq name "volatile-store!") "store_ptr"]
    [else "cas_ptr"]))

(define (lower-atomic-pointer-raw-symbol
  [name : String]
  [elem-ty : ast.AstType]) : i64
  (lower-derived-symbol-id
    (str_cat.str-cat
      (lower-atomic-pointer-width-prefix name elem-ty)
      (lower-atomic-pointer-op-suffix name)
      ""
      "")))

(define (lower-atomic-pointer-elem
  [ctx : tc_core.TcContext]
  [name : String]
  [ptr-ty : ast.AstType]) : tc_core.ResultTcType
  (tc_core.tc-atomic-pointer-elem ctx name ptr-ty))

(define (lower-atomic-pointer-load-arity-message [name : String]) : String
  (string.append "lower: " (string.append name " expects exactly one argument")))

(define (lower-atomic-pointer-update-arity-message [name : String]) : String
  (if (lower-atomic-pointer-volatile-name? name)
    "lower: volatile-store! expects exactly two arguments"
    "lower: atomic update expects exactly two arguments"))

(define (lower-atomic-pointer-emit-load
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [name : String]
  [ptr : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (ir.CompilerIrInstr.Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (ir.CompilerIrCallArgs.One ptr)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (ir.CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-emit-update
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [name : String]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (ir.CompilerIrInstr.Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (ir.CompilerIrCallArgs.Two ptr value)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (ir.CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-emit-cas
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [name : String]
  [ptr : ir.CompilerIrValue]
  [expected : ir.CompilerIrValue]
  [new-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (ir.CompilerIrInstr.Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (ir.compiler-ir-call-args-from-list
                (ir.compiler-ir-value-cons
                  ptr
                  (ir.compiler-ir-value-cons
                    expected
                    (ir.compiler-ir-value-cons
                      new-value
                      (ir.CompilerIrValueList.Nil)))))
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (ir.CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-update-tail
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [name : String]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]
  [tail : ast.AstExprList]) : ResultLowerExpr
  (if (= (struct-get (& tail) len) 0)
    (lower-atomic-pointer-emit-update
      ctx
      state
      name
      ptr
      value
      elem-ty
      result-ty
      origin)
    (ResultLowerExpr.Err
      (box (lower-diagnostic (lower-atomic-pointer-update-arity-message name))))))

(define (lower-atomic-pointer-cas-tail
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [ptr : ir.CompilerIrValue]
  [expected : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]
  [tail : ast.AstExprList]) : ResultLowerExpr
  (if (= (struct-get (& tail) len) 1)
    (let
      [new-value : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& tail) 0 0))]
      (match (lower-expr-expected
        ctx
        state
        env
        type-env
        new-value
        elem-ty
        new-value)
        [(ResultLowerExpr.Ok new-lowered)
          (match new-lowered
            [(LowerExpr.Expr new-state new-ir _)
              (lower-atomic-pointer-emit-cas
                ctx
                new-state
                name
                ptr
                expected
                new-ir
                elem-ty
                result-ty
                origin)])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic "lower: atomic-cas! expects exactly three arguments")))))

(define (lower-atomic-pointer-nonload-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [ptr : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [tail0 : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (> (struct-get (& tail0) len) 0)
    (let
      [value : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& tail0) 0 0))]
      [tail1 : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& tail0) 1)]
      (match (lower-expr-expected ctx state env type-env value elem-ty value)
        [(ResultLowerExpr.Ok value-lowered)
          (match value-lowered
            [(LowerExpr.Expr value-state value-ir _)
              (if (lower-atomic-pointer-cas-name? name)
                (lower-atomic-pointer-cas-tail
                  ctx
                  value-state
                  env
                  type-env
                  name
                  ptr
                  value-ir
                  elem-ty
                  result-ty
                  origin
                  tail1)
                (lower-atomic-pointer-update-tail
                  ctx
                  value-state
                  name
                  ptr
                  value-ir
                  elem-ty
                  result-ty
                  origin
                  tail1))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic
          (if (lower-atomic-pointer-cas-name? name)
            "lower: atomic-cas! expects exactly three arguments"
            (lower-atomic-pointer-update-arity-message name)))))))

(define (lower-atomic-pointer-call-with-elem
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [ptr : ast.AstExpr]
  [ptr-ty : ast.AstType]
  [elem-ty : ast.AstType]
  [tail0 : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-expected ctx state env type-env ptr ptr-ty ptr)
    [(ResultLowerExpr.Ok ptr-lowered)
      (match ptr-lowered
        [(LowerExpr.Expr ptr-state ptr-ir _)
          (if (lower-atomic-pointer-load-name? name)
            (if (= (struct-get (& tail0) len) 0)
              (lower-atomic-pointer-emit-load
                ctx
                ptr-state
                name
                ptr-ir
                elem-ty
                result-ty
                origin)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic
                    (lower-atomic-pointer-load-arity-message name)))))
            (lower-atomic-pointer-nonload-call
              ctx
              ptr-state
              env
              type-env
              name
              ptr-ir
              elem-ty
              tail0
              result-ty
              origin))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-atomic-pointer-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (> (struct-get (& args) len) 0)
    (let
      [ptr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [tail0 : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& args) 1)]
      (match (tc_core.tc-expr ctx type-env ptr)
        [(tc_core.ResultTcType.Ok ptr-ty)
          (match (lower-atomic-pointer-elem ctx name ptr-ty)
            [(tc_core.ResultTcType.Ok elem-ty)
              (lower-atomic-pointer-call-with-elem
                ctx
                state
                env
                type-env
                name
                ptr
                ptr-ty
                elem-ty
                tail0
                result-ty
                origin)]
            [(tc_core.ResultTcType.Err message)
              (ResultLowerExpr.Err (box (lower-diagnostic-at-expr ptr message)))])]
        [(tc_core.ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr ptr message)))]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic
          (if (lower-atomic-pointer-load-name? name)
            (lower-atomic-pointer-load-arity-message name)
            (if (lower-atomic-pointer-cas-name? name)
              "lower: atomic-cas! expects exactly three arguments"
              (lower-atomic-pointer-update-arity-message name))))))))

(define (lower-atomic-load-symbol? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i32_load")))

(define (lower-atomic-emit-load
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [symbol : String]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (ir.CompilerIrInstr.Call
              var-id
              (lower-atomic-raw-symbol symbol)
              (ir.CompilerIrCallArgs.One ptr)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (ir.CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-emit-update
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [symbol : String]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (ir.CompilerIrInstr.Call
              var-id
              (lower-atomic-raw-symbol symbol)
              (ir.CompilerIrCallArgs.Two ptr value)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (ir.CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-storage-array
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [storage : ast.AstExpr]
  [elem-ty : ast.AstType]) : ResultLowerExpr
  (let
    [array-ty : ast.AstType (ast.ast-ty-dyn-array elem-ty)]
    (match (lower-expr ctx state env type-env storage)
      [(ResultLowerExpr.Ok lowered)
        (match lowered
          [(LowerExpr.Expr storage-state storage-value storage-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type ctx storage-ty))
              [(ast.AstType.DynArray _)
                (ResultLowerExpr.Ok
                  (LowerExpr.Expr storage-state storage-value array-ty))]
              [(ast.AstType.Ref _ referent-ty)
                (let
                  [referent : ast.AstType
                    (tc_core.tc-context-type-get ctx referent-ty)]
                  [slots-id : i64 (ci.intern "slots")]
                  (match (tc_core.tc-type-strip-region
                    (tc_core.tc-resolve-type ctx referent))
                    [(ast.AstType.Struct struct-name)
                      (lower-struct-get-through-reference
                        ctx
                        storage-state
                        storage-value
                        referent
                        struct-name
                        (tc_core.tc-nominal-name-id-display struct-name)
                        slots-id
                        "slots"
                        array-ty)]
                    [(ast.AstType.StructArgs struct-name _)
                      (lower-struct-get-through-reference
                        ctx
                        storage-state
                        storage-value
                        referent
                        struct-name
                        (tc_core.tc-nominal-name-id-display struct-name)
                        slots-id
                        "slots"
                        array-ty)]
                    [_
                      (ResultLowerExpr.Err
                        (box
                          (lower-diagnostic-at-expr
                            storage
                            "lower: atomic storage expects an atomic buffer")))]))]
              [_
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      storage
                      "lower: atomic storage expects an atomic buffer")))])])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-atomic-array-element-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [array : ast.AstExpr]
  [index : ast.AstExpr]
  [elem-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-atomic-storage-array ctx state env type-env array elem-ty)
    [(ResultLowerExpr.Ok arr-lowered)
      (match arr-lowered
        [(LowerExpr.Expr arr-state arr-value _)
          (match (lower-index-result-type-or-check
            ctx
            env
            type-env
            (lower-state-type-cache arr-state)
            index)
            [(tc_core.ResultTcType.Ok idx-ty)
              (match (lower-expr-expected
                ctx
                arr-state
                env
                type-env
                index
                idx-ty
                index)
                [(ResultLowerExpr.Ok idx-lowered)
                  (match idx-lowered
                    [(LowerExpr.Expr idx-state idx-value idx-value-ty)
                      (match (lower-array-element-addr
                        ctx
                        idx-state
                        arr-value
                        idx-value
                        idx-value-ty
                        elem-ty)
                        [(LowerExpr.Expr addr-state elem-ptr elem-ptr-ty)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (lower-state-record-latest-bounds-check-at-expr
                                addr-state
                                index)
                              elem-ptr
                              elem-ptr-ty))])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
            [(tc_core.ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr index message)))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-atomic-call-load
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [symbol : String]
  [array : ast.AstExpr]
  [index : ast.AstExpr]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-atomic-array-element-address
    ctx
    state
    env
    type-env
    array
    index
    elem-ty)
    [(ResultLowerExpr.Ok addr)
      (match addr
        [(LowerExpr.Expr addr-state ptr _)
          (lower-atomic-emit-load ctx addr-state ptr symbol result-ty origin)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-atomic-call-update
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [symbol : String]
  [array : ast.AstExpr]
  [index : ast.AstExpr]
  [value : ast.AstExpr]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-atomic-array-element-address
    ctx
    state
    env
    type-env
    array
    index
    elem-ty)
    [(ResultLowerExpr.Ok addr)
      (match addr
        [(LowerExpr.Expr addr-state ptr _)
          (match (lower-expr-expected
            ctx
            addr-state
            env
            type-env
            value
            elem-ty
            value)
            [(ResultLowerExpr.Ok value-lowered)
              (match value-lowered
                [(LowerExpr.Expr value-state value-ir _)
                  (lower-atomic-emit-update
                    ctx
                    value-state
                    ptr
                    value-ir
                    symbol
                    result-ty
                    origin)])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-atomic-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [symbol : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [elem-ty : ast.AstType (lower-atomic-elem-type symbol)]
    [count : i64 (struct-get (& args) len)]
    (if (= count 0)
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: atomic helper expects arguments")))
      (if (= count 1)
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic
              "lower: atomic helper expects at least two arguments")))
        (let
          [array : ast.AstExpr
            (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
          [index : ast.AstExpr
            (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
          (if (lower-atomic-load-symbol? symbol)
            (if (= count 2)
              (lower-atomic-call-load
                ctx
                state
                env
                type-env
                symbol
                array
                index
                elem-ty
                result-ty
                origin)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic "lower: atomic load expects two arguments"))))
            (if (= count 3)
              (lower-atomic-call-update
                ctx
                state
                env
                type-env
                symbol
                array
                index
                (lower-context-expr-get
                  ctx
                  (ast.ast-expr-list-get (& args) 2 0))
                elem-ty
                result-ty
                origin)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic
                    "lower: atomic update expects three arguments"))))))))))

;; Fixed arrays are inline element storage. Bounds check against the static
;; length, then Gep directly from the array handle without loading dynamic-array
;; fat fields.
(define (lower-fixed-array-element-addr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [elem-ty : ast.AstType]
  [elem-count : i64]) : LowerExpr
  (match (lower-emit-bounds-operand state idx-value idx-ty)
    [(LowerExpr.Expr s1 idx-u _)
      (match (lower-emit-cast s1 idx-value idx-ty (ast.AstType.I64))
        [(LowerExpr.Expr s2 idx-off _)
          (lower-emit-elem-addr-gep
            ctx
            (lower-emit-bounds-check
              s2
              idx-u
              (ir.CompilerIrValue.I64 elem-count))
            arr-value
            idx-off
            elem-ty)])]))

;; `(make-array T len)` -> checked length, `tl_alloc` element buffer, and a
;; heap-backed dynamic-array fat value `{ ptr, len }`.
(define (lower-make-array-store-fat
  [state : LowerState]
  [arr-ty : ast.AstType]
  [buf-var : i64]
  [len-i64 : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 arr-ty)
    [(LowerExpr.Expr arr-state arr-value _)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-store-at-offset
            (lower-store-at-offset
              arr-state
              arr-value
              0
              (ir.CompilerIrValue.Var buf-var)
              (ast.AstType.U64))
            arr-value
            8
            len-i64
            (ast.AstType.I64))
          arr-value
          arr-ty))]))

(define (lower-init-default-share-safe-type-list?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : bool
  (lower-init-default-share-safe-type-list-at? ctx (& types) 0))

(define (lower-init-default-share-safe-type-list-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (let
      [head : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (if (lower-init-default-share-safe? ctx head)
        (lower-init-default-share-safe-type-list-at? ctx types (+ index 1))
        false))))

(define (lower-init-default-share-safe-struct?
  [ctx : tc_core.TcContext]
  [_ : String]
  [struct-ty : ast.AstType]) : bool
  (match (tc_core.tc-struct-decl-id
    ctx
    (lower-struct-type-name-id-or struct-ty -1))
    [(tc_core.ResultTcStructDecl.Ok decl)
      (match decl
        [(tc_core.TcStructDecl repr cleanup fields)
          (if (ast.ast-struct-repr-c? repr)
            false
            (if (ast.ast-struct-cleanup? cleanup)
              false
              (let
                [field-types : ast.AstTypeList
                  (tc_core.tc-resolve-type-list
                    ctx
                    (lower-struct-constructor-field-types-for-result
                      ctx
                      struct-ty
                      fields))]
                (lower-init-default-share-safe-type-list? ctx field-types))))])]
    [(tc_core.ResultTcStructDecl.Err _) false]))

(define (lower-init-default-share-safe-enum?
  [ctx : tc_core.TcContext]
  [_ : String]
  [enum-ty : ast.AstType]) : bool
  (match (tc_core.tc-enum-decl-id ctx (lower-enum-type-name-id-or enum-ty -1))
    [(tc_core.ResultTcEnumDecl.Ok decl)
      (match decl
        [(tc_core.TcEnumDecl cleanup variants)
          (if (ast.ast-enum-cleanup? cleanup)
            false
            (if (ast.ast-variant-def-list-empty? (& variants))
              false
              (let
                [variant : ast.AstVariantDef
                  (ast.ast-variant-def-list-get
                    (& variants)
                    0
                    (ast.ast-variant-def-fallback))]
                (match variant
                  [(ast.AstVariantDef.Def _ fields _)
                    (let
                      [field-types : ast.AstTypeList
                        (tc_core.tc-resolve-type-list
                          ctx
                          (lower-enum-constructor-fields-for-result
                            ctx
                            enum-ty
                            fields))]
                      (lower-init-default-share-safe-type-list? ctx field-types))]))))])]
    [(tc_core.ResultTcEnumDecl.Err _) false]))

(define (lower-init-default-share-safe?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (if (tc_core.tc-integer-type? resolved)
      true
      (match resolved
        [(ast.AstType.F64) true]
        [(ast.AstType.F32) true]
        [(ast.AstType.Bool) true]
        [(ast.AstType.Char) true]
        [(ast.AstType.Unit) true]
        [(ast.AstType.String) true]
        [(ast.AstType.Ptr _) true]
        [(ast.AstType.MutPtr _) true]
        [(ast.AstType.Tuple elems)
          (lower-init-default-share-safe-type-list? ctx (box-get elems))]
        [(ast.AstType.Struct name)
          (lower-init-default-share-safe-struct?
            ctx
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(ast.AstType.StructArgs name _)
          (lower-init-default-share-safe-struct?
            ctx
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(ast.AstType.Enum name)
          (lower-init-default-share-safe-enum?
            ctx
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(ast.AstType.EnumArgs name _)
          (lower-init-default-share-safe-enum?
            ctx
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [_ false]))))

(define (lower-make-array-init-advance
  [state : LowerState]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc inc-alloc inc-var)
      (ResultLowerState.Ok
        (lower-state-finish-block
          (lower-state-emit
            (lower-state-emit
              (lower-state-emit
                inc-alloc
                (ir.CompilerIrInstr.BinOp
                  inc-var
                  ir.CompilerIrBinOp.Add
                  (ir.CompilerIrValue.Var index-var)
                  (ir.CompilerIrValue.I64 1)
                  (ast.AstType.I64)))
              (ir.CompilerIrInstr.Mov
                index-var
                (ir.CompilerIrValue.Var inc-var)
                (ast.AstType.I64)))
            (ir.CompilerIrInstr.Jump header-label))
          exit-label))]))

(define (lower-make-array-store-init-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]
  [elem-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    buf-value
    (ir.CompilerIrValue.Var index-var)
    elem-ty)
    [(LowerExpr.Expr gep-state elem-ptr _)
      (lower-make-array-init-advance
        (lower-array-elem-store-state ctx gep-state elem-ptr init-value elem-ty)
        index-var
        header-label
        exit-label)]))

(define (lower-make-array-init-body
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]
  [elem-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (lower-init-expr ctx state env type-env elem-ty origin elem-ty)
    [(ResultLowerExpr.Ok lowered-init)
      (match lowered-init
        [(LowerExpr.Expr init-state init-value _)
          (match (lower-emit-elem-addr-gep
            ctx
            init-state
            buf-value
            (ir.CompilerIrValue.Var index-var)
            elem-ty)
            [(LowerExpr.Expr gep-state elem-ptr _)
              (lower-make-array-init-advance
                (lower-array-elem-store-state
                  ctx
                  gep-state
                  elem-ptr
                  init-value
                  elem-ty)
                index-var
                header-label
                exit-label)])])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-make-array-init-loop-with-labels
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [origin : ast.AstExpr]
  [header-label : i64]
  [body-label : i64]
  [exit-label : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc index-alloc index-var)
      (let
        [header-start : LowerState
          (lower-state-finish-block
            (lower-state-emit
              (lower-state-emit
                index-alloc
                (ir.CompilerIrInstr.Mov
                  index-var
                  (ir.CompilerIrValue.I64 0)
                  (ast.AstType.I64)))
              (ir.CompilerIrInstr.Jump header-label))
            header-label)]
        (match (lower-emit-binop
          header-start
          ir.CompilerIrBinOp.Lt
          (ir.CompilerIrValue.Var index-var)
          len-i64
          (ast.AstType.I64))
          [(LowerExpr.Expr cond-state cond-value _)
            (let
              [body-start : LowerState
                (lower-state-finish-block
                  (lower-state-emit
                    cond-state
                    (ir.CompilerIrInstr.Branch cond-value body-label exit-label))
                  body-label)]
              (lower-make-array-init-body
                ctx
                body-start
                env
                type-env
                buf-value
                index-var
                header-label
                exit-label
                elem-ty
                origin))]))]))

(define (lower-make-array-store-init-loop-with-labels
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]
  [header-label : i64]
  [body-label : i64]
  [exit-label : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc index-alloc index-var)
      (let
        [header-start : LowerState
          (lower-state-finish-block
            (lower-state-emit
              (lower-state-emit
                index-alloc
                (ir.CompilerIrInstr.Mov
                  index-var
                  (ir.CompilerIrValue.I64 0)
                  (ast.AstType.I64)))
              (ir.CompilerIrInstr.Jump header-label))
            header-label)]
        (match (lower-emit-binop
          header-start
          ir.CompilerIrBinOp.Lt
          (ir.CompilerIrValue.Var index-var)
          len-i64
          (ast.AstType.I64))
          [(LowerExpr.Expr cond-state cond-value _)
            (let
              [body-start : LowerState
                (lower-state-finish-block
                  (lower-state-emit
                    cond-state
                    (ir.CompilerIrInstr.Branch cond-value body-label exit-label))
                  body-label)]
              (lower-make-array-store-init-body
                ctx
                body-start
                buf-value
                index-var
                header-label
                exit-label
                elem-ty
                init-value))]))]))

(define (lower-make-array-init-loop-runtime
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (if (= elem-size 0)
    (ResultLowerState.Ok state)
    (match (lower-state-fresh-label state "make_array_init_header")
      [(LowerLabel.Label header-label-state header-label)
        (match (lower-state-fresh-label
          header-label-state
          "make_array_init_body")
          [(LowerLabel.Label body-label-state body-label)
            (match (lower-state-fresh-label
              body-label-state
              "make_array_init_exit")
              [(LowerLabel.Label exit-label-state exit-label)
                (lower-make-array-init-loop-with-labels
                  ctx
                  exit-label-state
                  env
                  type-env
                  buf-value
                  len-i64
                  elem-ty
                  origin
                  header-label
                  body-label
                  exit-label)])])])))

(define (lower-make-array-store-init-loop-runtime
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [init-value : ir.CompilerIrValue]) : ResultLowerState
  (if (= elem-size 0)
    (ResultLowerState.Ok state)
    (match (lower-state-fresh-label state "make_array_init_header")
      [(LowerLabel.Label header-label-state header-label)
        (match (lower-state-fresh-label
          header-label-state
          "make_array_init_body")
          [(LowerLabel.Label body-label-state body-label)
            (match (lower-state-fresh-label
              body-label-state
              "make_array_init_exit")
              [(LowerLabel.Label exit-label-state exit-label)
                (lower-make-array-store-init-loop-with-labels
                  ctx
                  exit-label-state
                  buf-value
                  len-i64
                  elem-ty
                  init-value
                  header-label
                  body-label
                  exit-label)])])])))

(define (lower-make-array-fill8
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [init-value : ir.CompilerIrValue]) : ResultLowerState
  (match (lower-runtime-call-values
    state
    (lower-tl-array-fill8-symbol)
    (ir.compiler-ir-value-cons
      buf-value
      (ir.compiler-ir-value-cons
        len-i64
        (ir.compiler-ir-value-cons init-value ir.CompilerIrValueList.Nil)))
    (ast.AstType.Unit))
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr done-state _ _) (ResultLowerState.Ok done-state)])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-make-array-fill8-supported?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (and
      (= (lower-type-size ctx resolved) 8)
      (not (tc_core.tc-type-eq resolved (ast.AstType.F64)))
      ;; Memory-resident inline aggregates are pointers to
      ;; storage, but a one-word register-resident aggregate is the word
      ;; itself, so fill8 can replicate it directly.
      (or
        (not (lower-type-inline-storage? ctx resolved))
        (lower-type-register-resident? ctx resolved))
      (lower-init-default-share-safe? ctx resolved))))

(define (lower-make-array-zero-fill-supported?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (if (tc_core.tc-integer-type? resolved)
      true
      (match resolved
        [(ast.AstType.F64) true]
        [(ast.AstType.F32) true]
        [(ast.AstType.Bool) true]
        [(ast.AstType.Char) true]
        [(ast.AstType.Unit) true]
        [(ast.AstType.Ptr _) true]
        [(ast.AstType.MutPtr _) true]
        [(ast.AstType.Struct _)
          (lower-make-array-zero-fill-struct-supported? ctx resolved)]
        [(ast.AstType.StructArgs _ _)
          (lower-make-array-zero-fill-struct-supported? ctx resolved)]
        [(ast.AstType.Enum _)
          (lower-make-array-zero-fill-enum-supported? ctx resolved)]
        [(ast.AstType.EnumArgs _ _)
          (lower-make-array-zero-fill-enum-supported? ctx resolved)]
        [(ast.AstType.Tuple elems)
          (lower-make-array-zero-fill-type-list-supported?
            ctx
            (box-get elems)
            0)]
        [(ast.AstType.Array elem _)
          (lower-make-array-zero-fill-supported?
            ctx
            (tc_core.tc-context-type-get ctx elem))]
        [_ false]))))

;; Every type in `types` (starting at `index`) must have an all-zero-bytes
;; default value. Used to decide whether make-array can zero its backing
;; store instead of running the per-element default-init loop.
(define (lower-make-array-zero-fill-type-list-supported?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len (& types)))
    true
    (if (lower-make-array-zero-fill-supported?
      ctx
      (tc_core.tc-context-type-get
        ctx
        (ast.ast-type-list-get (& types) index (ast.ast-type-id-fallback))))
      (lower-make-array-zero-fill-type-list-supported? ctx types (+ index 1))
      false)))

;; A struct can be zero-filled when every field's default is all-zero bytes
;; (default-layout only, mirroring lower-init-struct).
(define (lower-make-array-zero-fill-struct-supported?
  [ctx : tc_core.TcContext]
  [struct-ty : ast.AstType]) : bool
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-struct-type-name-id-or struct-ty -1))]
    (if (lower-struct-repr-c-id?
      field-ctx
      (lower-struct-type-name-id-or struct-ty -1))
      false
      (match (lower-struct-fields-id
        field-ctx
        (lower-struct-type-name-id-or struct-ty -1)
        (tc_core.tc-nominal-name-id-display
          (lower-struct-type-name-id-or struct-ty -1)))
        [(parser.ResultAstFieldDefList.Ok fields)
          (lower-make-array-zero-fill-type-list-supported?
            field-ctx
            (tc_core.tc-resolve-type-list
              field-ctx
              (lower-struct-constructor-field-types-for-result
                field-ctx
                struct-ty
                fields))
            0)]
        [(parser.ResultAstFieldDefList.Err _) false]))))

;; An enum can be zero-filled when its first variant (tag 0) is fieldless:
;; the default value is then the zero tag word plus don't-care payload bytes,
;; which zeroing satisfies. (A payloaded first variant could have a non-zero
;; default, so those enums keep the init loop.)
(define (lower-make-array-zero-fill-enum-supported?
  [ctx : tc_core.TcContext]
  [enum-ty : ast.AstType]) : bool
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-enum-type-name-id-or enum-ty -1))]
    (match (tc_core.tc-enum-decl-id
      field-ctx
      (lower-enum-type-name-id-or enum-ty -1))
      [(tc_core.ResultTcEnumDecl.Ok decl)
        (match decl
          [(tc_core.TcEnumDecl _ variants)
            (if (ast.ast-variant-def-list-empty? (& variants))
              false
              (match (ast.ast-variant-def-list-get
                (& variants)
                0
                (ast.ast-variant-def-fallback))
                [(ast.AstVariantDef.Def _ fields _)
                  (ast.ast-type-list-empty? (& fields))]))])]
      [(tc_core.ResultTcEnumDecl.Err _) false])))

(define (lower-make-array-zero-fill
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [byte-count : ir.CompilerIrValue]) : ResultLowerState
  (match (lower-runtime-call-values
    state
    (lower-tl-array-zero-symbol)
    (ir.compiler-ir-value-cons
      buf-value
      (ir.compiler-ir-value-cons byte-count ir.CompilerIrValueList.Nil))
    (ast.AstType.Unit))
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr done-state _ _) (ResultLowerState.Ok done-state)])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-make-array-zero-literal-length? [len : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan len)
    [(ast.AstExpr.Literal (ast.AstLiteral.Int value _)) (= value 0)]
    [_ false]))

(define (lower-make-array-init-loop-nonzero
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [byte-count : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (cond
    [(= elem-size 0) (ResultLowerState.Ok state)]
    [(lower-make-array-zero-fill-supported? ctx elem-ty)
      (lower-make-array-zero-fill state buf-value byte-count)]
    [(lower-init-default-share-safe? ctx elem-ty)
      (match (lower-init-expr ctx state env type-env elem-ty origin elem-ty)
        [(ResultLowerExpr.Ok lowered-init)
          (match lowered-init
            [(LowerExpr.Expr init-state init-value _)
              (if (lower-make-array-fill8-supported? ctx elem-ty)
                (lower-make-array-fill8 init-state buf-value len-i64 init-value)
                (lower-make-array-store-init-loop-runtime
                  ctx
                  init-state
                  buf-value
                  len-i64
                  elem-ty
                  elem-size
                  init-value))])]
        [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])]
    [else
      (lower-make-array-init-loop-runtime
        ctx
        state
        env
        type-env
        buf-value
        len-i64
        elem-ty
        elem-size
        origin)]))

(define (lower-make-array-init-loop
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [byte-count : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : ast.AstExpr]) : ResultLowerState
  (if zero-literal-length
    (ResultLowerState.Ok state)
    (match len-i64
      [(ir.CompilerIrValue.I64 literal-len)
        (if (= literal-len 0)
          (ResultLowerState.Ok state)
          (lower-make-array-init-loop-nonzero
            ctx
            state
            env
            type-env
            buf-value
            len-i64
            byte-count
            elem-ty
            elem-size
            origin))]
      [_
        (lower-make-array-init-loop-nonzero
          ctx
          state
          env
          type-env
          buf-value
          len-i64
          byte-count
          elem-ty
          elem-size
          origin)])))

(define (lower-make-array-alloc-buffer
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr-ty : ast.AstType]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-emit-binop
    state
    (ir.CompilerIrBinOp.Mul)
    len-i64
    (ir.CompilerIrValue.I64 elem-size)
    (ast.AstType.I64))
    [(LowerExpr.Expr byte-state byte-count _)
      (match (lower-state-alloc-var byte-state)
        [(LowerAlloc.Alloc buf-alloc buf-var)
          (let
            [alloc-state : LowerState
              (lower-state-emit
                buf-alloc
                (ir.CompilerIrInstr.Call
                  buf-var
                  (lower-tl-alloc-symbol)
                  (ir.CompilerIrCallArgs.One byte-count)
                  (ast.AstType.U64)))]
            (match (lower-make-array-init-loop
              ctx
              alloc-state
              env
              type-env
              (ir.CompilerIrValue.Var buf-var)
              len-i64
              byte-count
              elem-ty
              elem-size
              zero-literal-length
              origin)
              [(ResultLowerState.Ok init-state)
                (lower-make-array-store-fat init-state arr-ty buf-var len-i64)]
              [(ResultLowerState.Err message) (ResultLowerExpr.Err message)]))])]))

(define (lower-make-array-after-max-check
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [fail-label : i64]
  [alloc-label : i64]
  [arr-ty : ast.AstType]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [fail-start : LowerState (lower-state-finish-block state fail-label)]
    [alloc-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (ir.CompilerIrInstr.Jump alloc-label))
        alloc-label)]
    (lower-make-array-alloc-buffer
      ctx
      alloc-start
      env
      type-env
      arr-ty
      len-i64
      elem-ty
      elem-size
      zero-literal-length
      origin)))

(define (lower-make-array-from-len
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [elem-ty : ast.AstType]
  [len-value : ir.CompilerIrValue]
  [len-ty : ast.AstType]
  [len-expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [resolved-elem : ast.AstType (tc_core.tc-resolve-type ctx elem-ty)]
    (match (lower-cast-value state len-value len-ty (ast.AstType.I64))
      [(LowerExpr.Expr len-state len-i64 _)
        (let
          [elem-size : i64 (lower-type-size ctx resolved-elem)]
          [arr-ty : ast.AstType (ast.ast-ty-dyn-array resolved-elem)]
          (match (lower-state-fresh-label len-state "make_array_len_nonneg")
            [(LowerLabel.Label s1 check-max-label)
              (match (lower-state-fresh-label s1 "make_array_len_fail")
                [(LowerLabel.Label s2 fail-label)
                  (match (lower-state-fresh-label s2 "make_array_len_ok")
                    [(LowerLabel.Label s3 alloc-label)
                      (match (lower-emit-binop
                        s3
                        (ir.CompilerIrBinOp.Le)
                        (ir.CompilerIrValue.I64 0)
                        len-i64
                        (ast.AstType.I64))
                        [(LowerExpr.Expr s4 non-negative _)
                          (let
                            [check-start : LowerState
                              (lower-state-finish-block
                                (lower-state-emit
                                  s4
                                  (ir.CompilerIrInstr.Branch
                                    non-negative
                                    check-max-label
                                    fail-label))
                                check-max-label)]
                            [max-len : i64
                              (if (= elem-size 0)
                                9223372036854775807
                                (/ 9223372036854775807 elem-size))]
                            (match (lower-emit-binop
                              check-start
                              (ir.CompilerIrBinOp.Le)
                              len-i64
                              (ir.CompilerIrValue.I64 max-len)
                              (ast.AstType.I64))
                              [(LowerExpr.Expr s5 within-max _)
                                (lower-make-array-after-max-check
                                  ctx
                                  (lower-state-emit
                                    s5
                                    (ir.CompilerIrInstr.Branch
                                      within-max
                                      alloc-label
                                      fail-label))
                                  env
                                  type-env
                                  fail-label
                                  alloc-label
                                  arr-ty
                                  len-i64
                                  resolved-elem
                                  elem-size
                                  (lower-make-array-zero-literal-length?
                                    len-expr)
                                  origin)]))])])])]))])))

(define (lower-make-array
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [elem-ty : ast.AstType]
  [len : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-integer-expr-with-expected-or-actual
    ctx
    state
    env
    type-env
    len
    (ast.AstType.I64)
    "lower: make-array length must be integer")
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr len-state len-value len-ty)
          (lower-make-array-from-len
            ctx
            len-state
            env
            type-env
            elem-ty
            len-value
            len-ty
            len
            origin)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; `(array-ref arr index)` -> bounds-checked typed element load.
;; Read an array element given its address. For a memory aggregate
;; element the address IS the value (pointer representation); for scalars and
;; pointer-slot types (box/dynarray/string handles) load the register-width
;; value. Mirrors lower-load-inline-value-at-offset at offset 0 but preserves the
;; exact lower-emit-load scalar path.
(define (lower-array-elem-ref-result
  [ctx : tc_core.TcContext]
  [addr-state : LowerState]
  [elem-ptr : ir.CompilerIrValue]
  [elem-ir-ty : ast.AstType]) : ResultLowerExpr
  ;; A register-resident element is loaded as a word, not returned as the
  ;; element address.
  (if (and
    (lower-mode-inline-aggregates? (lower-state-mode addr-state))
    (lower-type-inline-storage? ctx elem-ir-ty)
    (not (lower-type-register-resident? ctx elem-ir-ty)))
    (ResultLowerExpr.Ok (LowerExpr.Expr addr-state elem-ptr elem-ir-ty))
    (if (lower-type-register-group? ctx elem-ir-ty)
      (match (lower-load-group-from-ptr ctx addr-state elem-ptr elem-ir-ty)
        [(LowerExpr.Expr load-state load-value _)
          (ResultLowerExpr.Ok (LowerExpr.Expr load-state load-value elem-ir-ty))])
      (match (lower-emit-load addr-state elem-ptr elem-ir-ty)
        [(LowerExpr.Expr load-state load-value _)
          (ResultLowerExpr.Ok (LowerExpr.Expr load-state load-value elem-ir-ty))]))))

(define (lower-array-take-length
  [state : LowerState]
  [array-value : ir.CompilerIrValue]) : LowerExpr
  (match (lower-emit-gep
    state
    array-value
    (ir.CompilerIrValue.I64 1)
    (ast.AstType.I64))
    [(LowerExpr.Expr gep-state gep-value _)
      (lower-emit-load gep-state gep-value (ast.AstType.I64))]))

(define (lower-array-take-store-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [result-base : ir.CompilerIrValue]
  [elem-offset : i64]
  [elem-ty : ast.AstType]
  [available : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]) : LowerState
  (lower-store-inline-value-at-offset
    ctx
    (lower-store-at-offset state result-base 0 available (ast.AstType.Bool))
    result-base
    elem-offset
    value
    elem-ty
    (lower-type-size ctx elem-ty)))

;; Finish a checked dynamic-array extraction once its availability flag is
;; initialized to false. The payload is meaningful only when that flag is true.
;; Both dynamic lengths are checked before either element address is formed;
;; clearing the bitmap precedes the payload load, making a repeated extraction
;; observe false instead of moving again.
(define (lower-array-take-after-result-flag
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [array-value : ir.CompilerIrValue]
  [live-value : ir.CompilerIrValue]
  [index-value : ir.CompilerIrValue]
  [index-ty : ast.AstType]
  [elem-ty : ast.AstType]
  [result-base : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [elem-offset : i64]) : ResultLowerExpr
  (match (lower-array-take-length state array-value)
    [(LowerExpr.Expr array-len-state array-len _)
      (match (lower-array-take-length array-len-state live-value)
        [(LowerExpr.Expr live-len-state live-len _)
          (match (lower-emit-cast
            live-len-state
            index-value
            index-ty
            (ast.AstType.U64))
            [(LowerExpr.Expr index-state index-u _)
              (match (lower-emit-cast
                index-state
                array-len
                (ast.AstType.I64)
                (ast.AstType.U64))
                [(LowerExpr.Expr array-len-state2 array-len-u _)
                  (match (lower-emit-cast
                    array-len-state2
                    live-len
                    (ast.AstType.I64)
                    (ast.AstType.U64))
                    [(LowerExpr.Expr live-len-state2 live-len-u _)
                      (match (lower-emit-binop
                        live-len-state2
                        ir.CompilerIrBinOp.Lt
                        index-u
                        array-len-u
                        (ast.AstType.U64))
                        [(LowerExpr.Expr array-ok-state array-ok _)
                          (match (lower-emit-binop
                            array-ok-state
                            ir.CompilerIrBinOp.Lt
                            index-u
                            live-len-u
                            (ast.AstType.U64))
                            [(LowerExpr.Expr live-ok-state live-ok _)
                              (match (lower-emit-binop
                                live-ok-state
                                ir.CompilerIrBinOp.And
                                array-ok
                                live-ok
                                (ast.AstType.Bool))
                                [(LowerExpr.Expr bounds-state bounds-ok _)
                                  (match (lower-state-fresh-label
                                    bounds-state
                                    "array_take_live")
                                    [(LowerLabel.Label
                                        live-label-state
                                        live-label)
                                      (match (lower-state-fresh-label
                                        live-label-state
                                        "array_take_value")
                                        [(LowerLabel.Label
                                            take-label-state
                                            take-label)
                                          (match (lower-state-fresh-label
                                            take-label-state
                                            "array_take_done")
                                            [(LowerLabel.Label
                                                done-label-state
                                                done-label)
                                              (let
                                                [live-start : LowerState
                                                  (lower-state-finish-block
                                                    (lower-state-emit
                                                      done-label-state
                                                      (ir.CompilerIrInstr.Branch
                                                        bounds-ok
                                                        live-label
                                                        done-label))
                                                    live-label)]
                                                (match (lower-array-element-addr
                                                  ctx
                                                  live-start
                                                  live-value
                                                  index-value
                                                  index-ty
                                                  (ast.AstType.Bool))
                                                  [(LowerExpr.Expr
                                                      live-addr-state
                                                      live-ptr
                                                      _)
                                                    (match (lower-array-elem-ref-result
                                                      ctx
                                                      live-addr-state
                                                      live-ptr
                                                      (ast.AstType.Bool))
                                                      [(ResultLowerExpr.Ok
                                                          live-read)
                                                        (match live-read
                                                          [(LowerExpr.Expr
                                                              live-read-state
                                                              live-bit
                                                              _)
                                                            (let
                                                              [take-start : LowerState
                                                                (lower-state-finish-block
                                                                  (lower-state-emit
                                                                    live-read-state
                                                                    (ir.CompilerIrInstr.Branch
                                                                      live-bit
                                                                      take-label
                                                                      done-label))
                                                                  take-label)]
                                                              (match (lower-array-element-addr
                                                                ctx
                                                                take-start
                                                                array-value
                                                                index-value
                                                                index-ty
                                                                elem-ty)
                                                                [(LowerExpr.Expr
                                                                    elem-addr-state
                                                                    elem-ptr
                                                                    _)
                                                                  (match (lower-array-elem-ref-result
                                                                    ctx
                                                                    elem-addr-state
                                                                    elem-ptr
                                                                    elem-ty)
                                                                    [(ResultLowerExpr.Ok
                                                                        value-read)
                                                                      (match value-read
                                                                        [(LowerExpr.Expr
                                                                            value-state
                                                                            value
                                                                            _)
                                                                          (let
                                                                            [cleared-state : LowerState
                                                                              (lower-array-elem-store-state
                                                                                ctx
                                                                                value-state
                                                                                live-ptr
                                                                                (ir.CompilerIrValue.Bool
                                                                                  false)
                                                                                (ast.AstType.Bool))]
                                                                            [stored-state : LowerState
                                                                              (lower-array-take-store-result
                                                                                ctx
                                                                                cleared-state
                                                                                result-base
                                                                                elem-offset
                                                                                elem-ty
                                                                                (ir.CompilerIrValue.Bool
                                                                                  true)
                                                                                value)]
                                                                            (ResultLowerExpr.Ok
                                                                              (LowerExpr.Expr
                                                                                (lower-state-finish-block
                                                                                  (lower-state-emit
                                                                                    stored-state
                                                                                    (ir.CompilerIrInstr.Jump
                                                                                      done-label))
                                                                                  done-label)
                                                                                result-base
                                                                                result-ty)))])]
                                                                    [(ResultLowerExpr.Err
                                                                        message)
                                                                      (ResultLowerExpr.Err
                                                                        message)])]))])]
                                                      [(ResultLowerExpr.Err
                                                          message)
                                                        (ResultLowerExpr.Err
                                                          message)])]))])])])])])])])])])])]))

(define (lower-array-take
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [array : ast.AstExpr]
  [live : ast.AstExpr]
  [index : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    array)
    [(tc_core.ResultTcType.Ok array-ty)
      (match (tc_core.tc-array-set-receiver ctx array-ty)
        [(tc_core.ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(tc_core.TcArrayReceiver container-ty elem-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx container-ty))
                [(ast.AstType.DynArray _)
                  (let
                    [elem-ir-ty : ast.AstType
                      (tc_core.tc-type-without-regions
                        (tc_core.tc-resolve-type ctx elem-ty))]
                    (match (lower-expr ctx state env type-env array)
                      [(ResultLowerExpr.Ok array-lowered)
                        (match array-lowered
                          [(LowerExpr.Expr array-state array-value _)
                            (match (lower-expr
                              ctx
                              array-state
                              env
                              type-env
                              live)
                              [(ResultLowerExpr.Ok live-lowered)
                                (match live-lowered
                                  [(LowerExpr.Expr live-state live-value _)
                                    (match (lower-integer-expr-with-expected-or-actual
                                      ctx
                                      live-state
                                      env
                                      type-env
                                      index
                                      (ast.AstType.I64)
                                      "lower: array-take! index must be integer")
                                      [(ResultLowerExpr.Ok index-lowered)
                                        (match index-lowered
                                          [(LowerExpr.Expr
                                              index-state
                                              index-value
                                              index-ty)
                                            (let
                                              [elem-offset : i64
                                                (lower-align-up
                                                  1
                                                  (lower-type-align
                                                    ctx
                                                    elem-ir-ty))]
                                              [result-storage-size : i64
                                                (lower-type-list-storage-size
                                                  ctx
                                                  (ast.ast-type-cons
                                                    (ast.AstType.Bool)
                                                    (ast.ast-type-cons
                                                      elem-ir-ty
                                                      (ast.ast-type-list-new))))]
                                              (match (lower-reserve-heap-storage
                                                index-state
                                                result-storage-size
                                                result-ty)
                                                [(LowerExpr.Expr
                                                    result-state
                                                    result-base
                                                    _)
                                                  (lower-array-take-after-result-flag
                                                    ctx
                                                    (lower-store-at-offset
                                                      result-state
                                                      result-base
                                                      0
                                                      (ir.CompilerIrValue.Bool
                                                        false)
                                                      (ast.AstType.Bool))
                                                    array-value
                                                    live-value
                                                    index-value
                                                    index-ty
                                                    elem-ir-ty
                                                    result-base
                                                    result-ty
                                                    elem-offset)]))])]
                                      [(ResultLowerExpr.Err message)
                                        (ResultLowerExpr.Err message)])])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])])]
                      [(ResultLowerExpr.Err message)
                        (ResultLowerExpr.Err message)]))]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        array
                        "lower: array-take! requires dynamic array storage")))])])]
        [(tc_core.ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr array message)))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr array message)))]))

;; Materialize the removed value before its slot is reinitialized. Scalar and
;; register-group loads are already independent values; an inline memory
;; aggregate needs a distinct local copy because its lowered value is an
;; address into the array storage itself.
(define (lower-fixed-array-take-old
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [elem-ptr : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : ResultLowerExpr
  (if (= (lower-type-size ctx elem-ty) 0)
    (ResultLowerExpr.Ok (LowerExpr.Expr state ir.CompilerIrValue.Unit elem-ty))
    (match (lower-array-elem-ref-result ctx state elem-ptr elem-ty)
      [(ResultLowerExpr.Ok old)
        (match old
          [(LowerExpr.Expr old-state old-value _)
            (if (and
              (lower-mode-inline-aggregates? (lower-state-mode old-state))
              (lower-type-inline-storage? ctx elem-ty)
              (not (lower-type-register-resident? ctx elem-ty)))
              (lower-copy-inline-aggregate-to-inline
                ctx
                old-state
                old-value
                elem-ty)
              (ResultLowerExpr.Ok old))])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-fixed-array-take-reinit
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [elem-ptr : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-fixed-array-take-old ctx state elem-ptr elem-ty)
    [(ResultLowerExpr.Ok old)
      (match old
        [(LowerExpr.Expr old-state old-value _)
          (match (lower-init-expr
            ctx
            old-state
            env
            type-env
            elem-ty
            origin
            elem-ty)
            [(ResultLowerExpr.Ok initialized)
              (match initialized
                [(LowerExpr.Expr init-state init-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-array-elem-store-state
                        ctx
                        init-state
                        elem-ptr
                        init-value
                        elem-ty)
                      old-value
                      result-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; `(array-take! items index)` evaluates the storage place and index once,
;; checks the fixed bound, moves/copies the old value into an independent
;; result, then immediately restores the slot with `(init : T)`.
(define (lower-fixed-array-take
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [array : ast.AstExpr]
  [index : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    array)
    [(tc_core.ResultTcType.Ok array-ty)
      (match (tc_core.tc-fixed-array-take-receiver ctx array-ty)
        [(tc_core.ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(tc_core.TcArrayReceiver container-ty elem-ty)
              (let
                [elem-ir-ty : ast.AstType
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx elem-ty))]
                (match (lower-expr ctx state env type-env array)
                  [(ResultLowerExpr.Ok array-lowered)
                    (match array-lowered
                      [(LowerExpr.Expr array-state array-value _)
                        (match (lower-index-result-type-or-check
                          ctx
                          env
                          type-env
                          (lower-state-type-cache array-state)
                          index)
                          [(tc_core.ResultTcType.Ok index-ty)
                            (match (lower-expr-expected
                              ctx
                              array-state
                              env
                              type-env
                              index
                              index-ty
                              index)
                              [(ResultLowerExpr.Ok index-lowered)
                                (match index-lowered
                                  [(LowerExpr.Expr
                                      index-state
                                      index-value
                                      index-value-ty)
                                    (match (tc_core.tc-type-strip-region
                                      (tc_core.tc-resolve-type ctx container-ty))
                                      [(ast.AstType.Array _ elem-count)
                                        (match (lower-fixed-array-element-addr
                                          ctx
                                          index-state
                                          array-value
                                          index-value
                                          index-value-ty
                                          elem-ir-ty
                                          elem-count)
                                          [(LowerExpr.Expr
                                              addr-state
                                              elem-ptr
                                              _)
                                            (lower-fixed-array-take-reinit
                                              ctx
                                              (lower-state-record-latest-bounds-check-at-expr
                                                addr-state
                                                index)
                                              env
                                              type-env
                                              elem-ptr
                                              elem-ir-ty
                                              array
                                              result-ty)])]
                                      [_
                                        (ResultLowerExpr.Err
                                          (box
                                            (lower-diagnostic-at-expr
                                              array
                                              "lower: array-take! requires fixed array type")))])])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])]
                          [(tc_core.ResultTcType.Err message)
                            (ResultLowerExpr.Err
                              (box (lower-diagnostic-at-expr index message)))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))])]
        [(tc_core.ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr array message)))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr array message)))]))

(define (lower-array-ref
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [index : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(tc_core.ResultTcType.Ok arr-ty)
      (match (tc_core.tc-array-readable-receiver ctx arr-ty)
        [(tc_core.ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(tc_core.TcArrayReceiver container-ty elem-ty)
              (let
                [elem-ir-ty : ast.AstType
                  (tc_core.tc-type-without-regions elem-ty)]
                (match (lower-expr ctx state env type-env arr)
                  [(ResultLowerExpr.Ok arr-lowered)
                    (match arr-lowered
                      [(LowerExpr.Expr arr-state arr-value _)
                        (match (lower-index-result-type-or-check
                          ctx
                          env
                          type-env
                          (lower-state-type-cache arr-state)
                          index)
                          [(tc_core.ResultTcType.Ok idx-ty)
                            (match (lower-expr-expected
                              ctx
                              arr-state
                              env
                              type-env
                              index
                              idx-ty
                              index)
                              [(ResultLowerExpr.Ok idx-lowered)
                                (match idx-lowered
                                  [(LowerExpr.Expr
                                      idx-state
                                      idx-value
                                      idx-value-ty)
                                    (match (tc_core.tc-type-strip-region
                                      (tc_core.tc-resolve-type ctx container-ty))
                                      [(ast.AstType.DynArray _)
                                        (match (lower-array-element-addr
                                          ctx
                                          idx-state
                                          arr-value
                                          idx-value
                                          idx-value-ty
                                          elem-ir-ty)
                                          [(LowerExpr.Expr
                                              addr-state
                                              elem-ptr
                                              _)
                                            (lower-array-elem-ref-result
                                              ctx
                                              (lower-state-record-latest-bounds-check-at-expr
                                                addr-state
                                                index)
                                              elem-ptr
                                              elem-ir-ty)])]
                                      [(ast.AstType.Ref _ inner)
                                        (if (lower-reference-to-slice?
                                          ctx
                                          inner)
                                          (match (lower-slice-element-addr
                                            ctx
                                            idx-state
                                            arr-value
                                            container-ty
                                            idx-value
                                            idx-value-ty
                                            elem-ir-ty)
                                            [(LowerExpr.Expr
                                                addr-state
                                                elem-ptr
                                                _)
                                              (lower-array-elem-ref-result
                                                ctx
                                                (lower-state-record-latest-bounds-check-at-expr
                                                  addr-state
                                                  index)
                                                elem-ptr
                                                elem-ir-ty)])
                                          (ResultLowerExpr.Err
                                            (box
                                              (lower-diagnostic-at-expr
                                                arr
                                                "lower: array-ref requires array type"))))]
                                      [(ast.AstType.MutRef _ inner)
                                        (if (lower-reference-to-slice?
                                          ctx
                                          inner)
                                          (match (lower-slice-element-addr
                                            ctx
                                            idx-state
                                            arr-value
                                            container-ty
                                            idx-value
                                            idx-value-ty
                                            elem-ir-ty)
                                            [(LowerExpr.Expr
                                                addr-state
                                                elem-ptr
                                                _)
                                              (lower-array-elem-ref-result
                                                ctx
                                                (lower-state-record-latest-bounds-check-at-expr
                                                  addr-state
                                                  index)
                                                elem-ptr
                                                elem-ir-ty)])
                                          (ResultLowerExpr.Err
                                            (box
                                              (lower-diagnostic-at-expr
                                                arr
                                                "lower: array-ref requires array type"))))]
                                      [(ast.AstType.Array _ elem-count)
                                        (match (lower-fixed-array-element-addr
                                          ctx
                                          idx-state
                                          arr-value
                                          idx-value
                                          idx-value-ty
                                          elem-ir-ty
                                          elem-count)
                                          [(LowerExpr.Expr
                                              addr-state
                                              elem-ptr
                                              _)
                                            (if (=
                                              (lower-type-size ctx elem-ir-ty)
                                              0)
                                              (ResultLowerExpr.Ok
                                                (LowerExpr.Expr
                                                  (lower-state-record-latest-bounds-check-at-expr
                                                    addr-state
                                                    index)
                                                  ir.CompilerIrValue.Unit
                                                  elem-ir-ty))
                                              (lower-array-elem-ref-result
                                                ctx
                                                (lower-state-record-latest-bounds-check-at-expr
                                                  addr-state
                                                  index)
                                                elem-ptr
                                                elem-ir-ty))])]
                                      [_
                                        (ResultLowerExpr.Err
                                          (box
                                            (lower-diagnostic-at-expr
                                              arr
                                              "lower: array-ref requires array type")))])])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])]
                          [(tc_core.ResultTcType.Err message)
                            (ResultLowerExpr.Err
                              (box (lower-diagnostic-at-expr index message)))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))])]
        [(tc_core.ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

;; `(array-set! arr index value)` -> bounds-checked typed element store.
;; Store a value into an array element slot. A memory aggregate
;; value is byte-copied into the full-size element slot; scalars and pointer-slot
;; handles use a register-width store.
(define (lower-array-elem-store-state
  [ctx : tc_core.TcContext]
  [addr-state : LowerState]
  [elem-ptr : ir.CompilerIrValue]
  [value-ir : ir.CompilerIrValue]
  [elem-ir-ty : ast.AstType]) : LowerState
  ;; A register-resident element value is a word; store it scalar instead
  ;; of byte-copying from a pointer.
  (if (and
    (lower-mode-inline-aggregates? (lower-state-mode addr-state))
    (lower-type-inline-storage? ctx elem-ir-ty)
    (not (lower-type-register-resident? ctx elem-ir-ty)))
    (lower-copy-bytes
      addr-state
      elem-ptr
      0
      value-ir
      0
      (lower-type-size ctx elem-ir-ty))
    (if (lower-type-register-group? ctx elem-ir-ty)
      (lower-store-group-at-ptr ctx addr-state elem-ptr value-ir elem-ir-ty)
      (lower-state-emit
        addr-state
        (ir.CompilerIrInstr.StorePtr elem-ptr value-ir elem-ir-ty)))))

(define (lower-array-set-store-materialized
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr : ast.AstExpr]
  [origin : ast.AstExpr]
  [arr-value : ir.CompilerIrValue]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [container-ty : ast.AstType]
  [elem-ir-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx container-ty))
    [(ast.AstType.DynArray _)
      (match (lower-array-element-addr
        ctx
        state
        arr-value
        idx-value
        idx-ty
        elem-ir-ty)
        [(LowerExpr.Expr addr-state elem-ptr _)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-array-elem-store-state
                ctx
                (lower-state-record-latest-bounds-check-at-expr
                  addr-state
                  origin)
                elem-ptr
                value-ir
                elem-ir-ty)
              ir.CompilerIrValue.Unit
              (ast.AstType.Unit)))])]
    [(ast.AstType.Array _ elem-count)
      (match (lower-fixed-array-element-addr
        ctx
        state
        arr-value
        idx-value
        idx-ty
        elem-ir-ty
        elem-count)
        [(LowerExpr.Expr addr-state elem-ptr _)
          (if (= (lower-type-size ctx elem-ir-ty) 0)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-state-record-latest-bounds-check-at-expr
                  addr-state
                  origin)
                ir.CompilerIrValue.Unit
                (ast.AstType.Unit)))
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-array-elem-store-state
                  ctx
                  (lower-state-record-latest-bounds-check-at-expr
                    addr-state
                    origin)
                  elem-ptr
                  value-ir
                  elem-ir-ty)
                ir.CompilerIrValue.Unit
                (ast.AstType.Unit))))])]
    [(ast.AstType.Ref _ inner)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            arr
            "lower: array-set! requires mutable array access")))]
    [(ast.AstType.MutRef _ inner)
      (if (lower-reference-to-slice? ctx inner)
        (match (lower-slice-element-addr
          ctx
          state
          arr-value
          container-ty
          idx-value
          idx-ty
          elem-ir-ty)
          [(LowerExpr.Expr addr-state elem-ptr _)
            (if (= (lower-type-size ctx elem-ir-ty) 0)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-state-record-latest-bounds-check-at-expr
                    addr-state
                    origin)
                  ir.CompilerIrValue.Unit
                  (ast.AstType.Unit)))
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-array-elem-store-state
                    ctx
                    (lower-state-record-latest-bounds-check-at-expr
                      addr-state
                      origin)
                    elem-ptr
                    value-ir
                    elem-ir-ty)
                  ir.CompilerIrValue.Unit
                  (ast.AstType.Unit))))])
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic-at-expr
              arr
              "lower: array-set! requires array type"))))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr arr "lower: array-set! requires array type")))]))

(define (lower-array-set-direct-store
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [origin : ast.AstExpr]
  [arr-value : ir.CompilerIrValue]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [container-ty : ast.AstType]
  [elem-ir-ty : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeDirectStore
  (if (and
    (> (lower-type-size ctx elem-ir-ty) 0)
    (lower-direct-store-target? ctx state elem-ir-ty))
    (match (tc_core.tc-type-strip-region
      (tc_core.tc-resolve-type ctx container-ty))
      [(ast.AstType.DynArray _)
        (match (lower-array-element-addr
          ctx
          state
          arr-value
          idx-value
          idx-ty
          elem-ir-ty)
          [(LowerExpr.Expr addr-state elem-ptr _)
            (lower-direct-store-rhs-into
              ctx
              (lower-state-record-latest-bounds-check-at-expr addr-state origin)
              env
              type-env
              elem-ptr
              value
              elem-ir-ty
              value)])]
      [(ast.AstType.Array _ elem-count)
        (match (lower-fixed-array-element-addr
          ctx
          state
          arr-value
          idx-value
          idx-ty
          elem-ir-ty
          elem-count)
          [(LowerExpr.Expr addr-state elem-ptr _)
            (lower-direct-store-rhs-into
              ctx
              (lower-state-record-latest-bounds-check-at-expr addr-state origin)
              env
              type-env
              elem-ptr
              value
              elem-ir-ty
              value)])]
      [(ast.AstType.Ref _ inner)
        (LowerMaybeDirectStore.Err
          (box
            (lower-diagnostic-at-expr
              arr
              "lower: array-set! requires mutable array access")))]
      [(ast.AstType.MutRef _ inner)
        (if (lower-reference-to-slice? ctx inner)
          (match (lower-slice-element-addr
            ctx
            state
            arr-value
            container-ty
            idx-value
            idx-ty
            elem-ir-ty)
            [(LowerExpr.Expr addr-state elem-ptr _)
              (lower-direct-store-rhs-into
                ctx
                (lower-state-record-latest-bounds-check-at-expr
                  addr-state
                  origin)
                env
                type-env
                elem-ptr
                value
                elem-ir-ty
                value)])
          (LowerMaybeDirectStore.Err
            (box
              (lower-diagnostic-at-expr
                arr
                "lower: array-set! requires array type"))))]
      [_
        (LowerMaybeDirectStore.Err
          (box
            (lower-diagnostic-at-expr
              arr
              "lower: array-set! requires array type")))])
    (LowerMaybeDirectStore.No)))

(define (lower-mutable-var-storage-address-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : i64]
  [place-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? local-id)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [addr-state : LowerState
              (lower-state-emit-at-expr
                allocated
                (ir.CompilerIrInstr.AddrOf var-id local-id)
                origin)]
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (if (lower-type-register-resident? ctx place-ty)
                  (lower-state-register-address-taken-mark addr-state local-id)
                  addr-state)
                (ir.CompilerIrValue.Var var-id)
                place-ty)))])
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (ir.CompilerIrValue.GlobalAddr
            (lower-resolve-name-symbol-id state name))
          place-ty)))))

(define (lower-mutable-var-address-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(tc_core.ResultTcType.Ok place-ty)
      (let
        [resolved : ast.AstType
          (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx place-ty))]
        (match resolved
          [(ast.AstType.MutRef _ referent-ty)
            (match (lower-var-id state env name place-ty)
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr ref-state ref-value _)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr
                        ref-state
                        ref-value
                        (tc_core.tc-context-type-get ctx referent-ty)))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [(ast.AstType.Ref _ _)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: set! struct field requires mutable struct access")))]
          [_
            (if (lower-borrow-place-value-reference? ctx place-ty)
              (lower-var-id state env name place-ty)
              (lower-mutable-var-storage-address-id
                ctx
                state
                env
                name
                place-ty
                origin))]))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-struct-field-address-from-place
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [receiver-ty : ast.AstType]
  [field : String]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx receiver-ty))
    [(ast.AstType.Struct struct-name)
      (match (lower-struct-field-info
        ctx
        struct-name
        (tc_core.tc-nominal-name-id-display struct-name)
        field)
        [(ResultLowerFieldInfo.Ok info)
          (match info
            [(LowerFieldInfo.Info offset field-ty)
              (match (lower-gep-byte state base offset)
                [(LowerExpr.Expr ptr-state ptr _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      ptr-state
                      ptr
                      (tc_core.tc-type-without-regions field-ty)))])])]
        [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)])]
    [(ast.AstType.StructArgs struct-name _)
      (match (lower-struct-field-info
        ctx
        struct-name
        (tc_core.tc-nominal-name-id-display struct-name)
        field)
        [(ResultLowerFieldInfo.Ok info)
          (match info
            [(LowerFieldInfo.Info offset field-ty)
              (match (lower-gep-byte state base offset)
                [(LowerExpr.Expr ptr-state ptr _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      ptr-state
                      ptr
                      (tc_core.tc-type-without-regions field-ty)))])])]
        [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)])]
    [(ast.AstType.MutRef _ referent-ty)
      (match (lower-emit-load state base receiver-ty)
        [(LowerExpr.Expr ref-state ref-value _)
          (lower-struct-field-address-from-place
            ctx
            ref-state
            ref-value
            (tc_core.tc-context-type-get ctx referent-ty)
            field
            origin)])]
    [(ast.AstType.Ref _ _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires mutable struct access")))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires struct")))]))

(define (lower-tuple-field-address-from-place
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [tuple-ty : ast.AstType]
  [index : i64]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx tuple-ty))
    [(ast.AstType.Tuple elem-tys)
      (match (lower-tuple-elem-info ctx (box-get elem-tys) index 0 0)
        [(ResultLowerFieldInfo.Ok info)
          (match info
            [(LowerFieldInfo.Info offset elem-ty)
              (match (lower-gep-byte state base offset)
                [(LowerExpr.Expr ptr-state ptr _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      ptr-state
                      ptr
                      (tc_core.tc-type-without-regions elem-ty)))])])]
        [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)])]
    [(ast.AstType.MutRef _ referent-ty)
      (match (lower-emit-load state base tuple-ty)
        [(LowerExpr.Expr ref-state ref-value _)
          (lower-tuple-field-address-from-place
            ctx
            ref-state
            ref-value
            (tc_core.tc-context-type-get ctx referent-ty)
            index
            origin)])]
    [(ast.AstType.Ref _ _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires mutable tuple access")))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: tuple-ref requires tuple place")))]))

(define (lower-mutable-array-element-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [index : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(tc_core.ResultTcType.Ok arr-ty)
      (match (tc_core.tc-array-set-receiver ctx arr-ty)
        [(tc_core.ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(tc_core.TcArrayReceiver container-ty elem-ty)
              (lower-borrow-array-element-address
                ctx
                state
                env
                type-env
                arr
                index
                origin
                (tc_core.tc-type-without-regions elem-ty))])]
        [(tc_core.ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

(define (lower-mutable-place-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (ast.ast-expr-unspan place)
    [(ast.AstExpr.Var name)
      (if (tc_core.tc-dotted-local-field-name-id? type-env name)
        (match (tc_core.tc-dotted-local-field-expr-id type-env name)
          [(tc_core.ResultTcExprId.Ok virtual-id)
            (lower-mutable-place-address
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin)]
          [(tc_core.ResultTcExprId.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))])
        (lower-mutable-var-address-id ctx state env type-env name origin))]
    [(ast.AstExpr.StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (match (lower-mutable-place-address
          ctx
          state
          env
          type-env
          receiver
          origin)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr receiver-state receiver-base receiver-ty)
                (lower-struct-field-address-from-place
                  ctx
                  receiver-state
                  receiver-base
                  receiver-ty
                  (tc_core.tc-env-key-name-text field)
                  origin)])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(ast.AstExpr.TupleRef tuple-box index)
      (let
        [tuple : ast.AstExpr (lower-context-expr-get ctx tuple-box)]
        (match (lower-mutable-place-address ctx state env type-env tuple origin)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr tuple-state tuple-base tuple-ty)
                (lower-tuple-field-address-from-place
                  ctx
                  tuple-state
                  tuple-base
                  tuple-ty
                  index
                  origin)])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(ast.AstExpr.ArrayRef arr-box index-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-mutable-array-element-address
          ctx
          state
          env
          type-env
          arr
          index
          origin))]
    [(ast.AstExpr.BoxGet box-box)
      (let
        [box-expr : ast.AstExpr (lower-context-expr-get ctx box-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          box-expr)
          [(tc_core.ResultTcType.Ok box-ty)
            (match (tc_core.tc-box-set-inner-type ctx box-ty)
              [(tc_core.ResultTcType.Ok inner-ty)
                (lower-box-storage-address
                  ctx
                  state
                  env
                  type-env
                  box-expr
                  origin
                  (tc_core.tc-type-without-regions inner-ty))]
              [(tc_core.ResultTcType.Err message)
                (ResultLowerExpr.Err
                  (box (lower-diagnostic-at-expr origin message)))])]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr box-expr message)))]))]
    [(ast.AstExpr.BoxTake receiver-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          receiver)
          [(tc_core.ResultTcType.Ok receiver-ty)
            (match (tc_core.tc-box-set-inner-type ctx receiver-ty)
              [(tc_core.ResultTcType.Ok inner-ty)
                (lower-box-storage-address
                  ctx
                  state
                  env
                  type-env
                  receiver
                  origin
                  (tc_core.tc-type-without-regions inner-ty))]
              [(tc_core.ResultTcType.Err message)
                (ResultLowerExpr.Err
                  (box (lower-diagnostic-at-expr origin message)))])]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr receiver message)))]))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! target must be a storage place")))]))

(define (lower-struct-field-store-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [field-ptr : ir.CompilerIrValue]
  [value-ir : ir.CompilerIrValue]
  [field-ir-ty : ast.AstType]) : ResultLowerExpr
  (if (= (lower-type-size ctx field-ir-ty) 0)
    (ResultLowerExpr.Ok
      (LowerExpr.Expr state ir.CompilerIrValue.Unit (ast.AstType.Unit)))
    (ResultLowerExpr.Ok
      (LowerExpr.Expr
        (lower-store-inline-value-at-offset
          ctx
          state
          field-ptr
          0
          value-ir
          field-ir-ty
          (lower-type-size ctx field-ir-ty))
        ir.CompilerIrValue.Unit
        (ast.AstType.Unit)))))

(define (lower-store-expr-into-address-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [value : ast.AstExpr]
  [value-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (> (lower-type-size ctx value-ty) 0)
    (match (lower-direct-store-rhs-into
      ctx
      state
      env
      type-env
      dst
      value
      value-ty
      origin)
      [(LowerMaybeDirectStore.Store done-state)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr done-state ir.CompilerIrValue.Unit (ast.AstType.Unit)))]
      [(LowerMaybeDirectStore.Err message) (ResultLowerExpr.Err message)]
      [(LowerMaybeDirectStore.No)
        (match (lower-expr-expected
          ctx
          state
          env
          type-env
          value
          value-ty
          origin)
          [(ResultLowerExpr.Ok value-lowered)
            (match value-lowered
              [(LowerExpr.Expr value-state value-ir _)
                (lower-struct-field-store-result
                  ctx
                  value-state
                  dst
                  value-ir
                  value-ty)])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])
    (match (lower-expr-expected ctx state env type-env value value-ty origin)
      [(ResultLowerExpr.Ok value-lowered)
        (match value-lowered
          [(LowerExpr.Expr value-state value-ir _)
            (lower-struct-field-store-result
              ctx
              value-state
              dst
              value-ir
              value-ty)])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-box-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [box-expr : ast.AstExpr]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    box-expr)
    [(tc_core.ResultTcType.Ok box-ty)
      (match (tc_core.tc-box-set-inner-type ctx box-ty)
        [(tc_core.ResultTcType.Ok inner-ty)
          (let
            [inner-ir-ty : ast.AstType
              (tc_core.tc-type-without-regions inner-ty)]
            (match (lower-box-storage-address
              ctx
              state
              env
              type-env
              box-expr
              origin
              inner-ir-ty)
              [(ResultLowerExpr.Ok place-lowered)
                (match place-lowered
                  [(LowerExpr.Expr place-state box-ptr _)
                    (lower-store-expr-into-address-result
                      ctx
                      place-state
                      env
                      type-env
                      box-ptr
                      value
                      inner-ir-ty
                      value)])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
        [(tc_core.ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr box-expr message)))]))

(define (lower-refresh-register-resident-root-after-store
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (tc_core.tc-move-root-projection-var-id
    (tc_core.tc-context-expr-bases ctx)
    place)
    [(tc_core.TcMaybeNameId.Some root-id)
      (let
        [local-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            root-id
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? local-id)
          (match (tc_core.tc-lookup-id type-env root-id)
            [(tc_core.ResultTcType.Ok root-ty)
              (let
                [resolved : ast.AstType
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx root-ty))]
                (if (lower-type-register-resident? ctx resolved)
                  (match (lower-state-alloc-var state)
                    [(LowerAlloc.Alloc addr-alloc addr-var)
                      (match (lower-load-register-resident-from-ptr
                        ctx
                        (lower-state-emit-at-expr
                          addr-alloc
                          (ir.CompilerIrInstr.AddrOf addr-var local-id)
                          origin)
                        (ir.CompilerIrValue.Var addr-var)
                        resolved)
                        [(LowerExpr.Expr load-state loaded _)
                          (ResultLowerState.Ok
                            (lower-state-emit-at-expr
                              load-state
                              (ir.CompilerIrInstr.Mov local-id loaded resolved)
                              origin))])])
                  (ResultLowerState.Ok state)))]
            [(tc_core.ResultTcType.Err message)
              (ResultLowerState.Err
                (box (lower-diagnostic-at-expr origin message)))])
          (ResultLowerState.Ok state)))]
    [(tc_core.TcMaybeNameId.No) (ResultLowerState.Ok state)]))

(define (lower-register-resident-local-place?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [receiver : ast.AstExpr]
  [receiver-ty : ast.AstType]) : bool
  (if (lower-type-register-resident? ctx receiver-ty)
    (match (ast.ast-expr-unspan receiver)
      [(ast.AstExpr.Var name) (sym_i64_env.sym-i64-contains-id env name)]
      [_ false])
    false))

(define (lower-reload-register-resident-local-from-storage
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [storage-ptr : ir.CompilerIrValue]
  [local-id : i64]
  [receiver-ir-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-load-register-resident-from-ptr
    ctx
    state
    storage-ptr
    receiver-ir-ty)
    [(LowerExpr.Expr load-state loaded _)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            load-state
            (ir.CompilerIrInstr.Mov local-id loaded receiver-ir-ty)
            origin)
          ir.CompilerIrValue.Unit
          (ast.AstType.Unit)))]))

(define (lower-struct-set-register-resident-local
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [receiver-ty : ast.AstType]
  [field : String]
  [field-ir-ty : ast.AstType]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (ast.ast-expr-unspan receiver)
    [(ast.AstExpr.Var name)
      (let
        [local-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? local-id)
          (let
            [receiver-ir-ty : ast.AstType
              (tc_core.tc-type-without-regions
                (tc_core.tc-resolve-type ctx receiver-ty))]
            [receiver-size : i64 (lower-type-size ctx receiver-ir-ty)]
            (match (lower-reserve-inline-storage
              state
              (if (= receiver-size 0)
                1
                receiver-size)
              receiver-ir-ty)
              [(LowerExpr.Expr storage-state storage-ptr _)
                (let
                  [stored-root-state : LowerState
                    (if (= receiver-size 0)
                      storage-state
                      (lower-store-inline-value-at-offset
                        ctx
                        storage-state
                        storage-ptr
                        0
                        (ir.CompilerIrValue.Var local-id)
                        receiver-ir-ty
                        receiver-size))]
                  (match (lower-struct-field-address-from-place
                    ctx
                    stored-root-state
                    storage-ptr
                    receiver-ir-ty
                    field
                    origin)
                    [(ResultLowerExpr.Ok place-lowered)
                      (match place-lowered
                        [(LowerExpr.Expr place-state field-ptr _)
                          (match (lower-store-expr-into-address-result
                            ctx
                            place-state
                            env
                            type-env
                            field-ptr
                            value
                            field-ir-ty
                            value)
                            [(ResultLowerExpr.Ok stored-field)
                              (match stored-field
                                [(LowerExpr.Expr store-state _ _)
                                  (lower-reload-register-resident-local-from-storage
                                    ctx
                                    store-state
                                    storage-ptr
                                    local-id
                                    receiver-ir-ty
                                    origin)])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)])])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)]))]))
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: set! struct field requires local storage")))))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires local storage")))]))

(define (lower-tuple-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [receiver-ty : ast.AstType]
  [index : i64]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-tuple-set-element-type ctx receiver-ty index)
    [(tc_core.ResultTcType.Ok elem-ty)
      (let
        [elem-ir-ty : ast.AstType (tc_core.tc-type-without-regions elem-ty)]
        (match (lower-mutable-place-address
          ctx
          state
          env
          type-env
          receiver
          origin)
          [(ResultLowerExpr.Ok place-lowered)
            (match place-lowered
              [(LowerExpr.Expr place-state place-ptr place-ty)
                (match (lower-tuple-field-address-from-place
                  ctx
                  place-state
                  place-ptr
                  place-ty
                  index
                  origin)
                  [(ResultLowerExpr.Ok elem-lowered)
                    (match elem-lowered
                      [(LowerExpr.Expr elem-state elem-ptr _)
                        (match (lower-store-expr-into-address-result
                          ctx
                          elem-state
                          env
                          type-env
                          elem-ptr
                          value
                          elem-ir-ty
                          value)
                          [(ResultLowerExpr.Ok stored)
                            (match stored
                              [(LowerExpr.Expr store-state _ _)
                                (match (lower-refresh-register-resident-root-after-store
                                  ctx
                                  store-state
                                  env
                                  type-env
                                  receiver
                                  origin)
                                  [(ResultLowerState.Ok refreshed-state)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr
                                        refreshed-state
                                        ir.CompilerIrValue.Unit
                                        (ast.AstType.Unit)))]
                                  [(ResultLowerState.Err message)
                                    (ResultLowerExpr.Err message)])])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-struct-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [field-id : i64]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    receiver)
    [(tc_core.ResultTcType.Ok receiver-ty)
      (if (ast.ast-tuple-set-field-id? field-id)
        (lower-tuple-set
          ctx
          state
          env
          type-env
          receiver
          receiver-ty
          (ast.ast-tuple-set-index-from-field-id field-id)
          value
          origin)
        (match (tc_core.tc-struct-set-field-type-id ctx receiver-ty field-id)
          [(tc_core.ResultTcType.Ok field-ty)
            (let
              [field : String (tc_core.tc-env-key-name-text field-id)]
              [field-ir-ty : ast.AstType
                (tc_core.tc-type-without-regions field-ty)]
              (if (lower-register-resident-local-place?
                ctx
                env
                receiver
                receiver-ty)
                (lower-struct-set-register-resident-local
                  ctx
                  state
                  env
                  type-env
                  receiver
                  receiver-ty
                  field
                  field-ir-ty
                  value
                  origin)
                (match (lower-mutable-place-address
                  ctx
                  state
                  env
                  type-env
                  receiver
                  origin)
                  [(ResultLowerExpr.Ok place-lowered)
                    (match place-lowered
                      [(LowerExpr.Expr place-state place-ptr place-ty)
                        (match (lower-struct-field-address-from-place
                          ctx
                          place-state
                          place-ptr
                          place-ty
                          field
                          origin)
                          [(ResultLowerExpr.Ok field-lowered)
                            (match field-lowered
                              [(LowerExpr.Expr field-state field-ptr _)
                                (match (lower-store-expr-into-address-result
                                  ctx
                                  field-state
                                  env
                                  type-env
                                  field-ptr
                                  value
                                  field-ir-ty
                                  value)
                                  [(ResultLowerExpr.Ok stored)
                                    (match stored
                                      [(LowerExpr.Expr store-state _ _)
                                        (match (lower-refresh-register-resident-root-after-store
                                          ctx
                                          store-state
                                          env
                                          type-env
                                          receiver
                                          origin)
                                          [(ResultLowerState.Ok refreshed-state)
                                            (ResultLowerExpr.Ok
                                              (LowerExpr.Expr
                                                refreshed-state
                                                ir.CompilerIrValue.Unit
                                                (ast.AstType.Unit)))]
                                          [(ResultLowerState.Err message)
                                            (ResultLowerExpr.Err message)])])]
                                  [(ResultLowerExpr.Err message)
                                    (ResultLowerExpr.Err message)])])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))]))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr receiver message)))]))

(define (lower-array-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [index : ast.AstExpr]
  [value : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(tc_core.ResultTcType.Ok arr-ty)
      (match (tc_core.tc-array-set-receiver ctx arr-ty)
        [(tc_core.ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(tc_core.TcArrayReceiver container-ty elem-ty)
              (let
                [elem-ir-ty : ast.AstType
                  (tc_core.tc-type-without-regions elem-ty)]
                (match (lower-expr ctx state env type-env arr)
                  [(ResultLowerExpr.Ok arr-lowered)
                    (match arr-lowered
                      [(LowerExpr.Expr arr-state arr-value _)
                        (match (lower-index-result-type-or-check
                          ctx
                          env
                          type-env
                          (lower-state-type-cache arr-state)
                          index)
                          [(tc_core.ResultTcType.Ok idx-ty)
                            (match (lower-expr-expected
                              ctx
                              arr-state
                              env
                              type-env
                              index
                              idx-ty
                              index)
                              [(ResultLowerExpr.Ok idx-lowered)
                                (match idx-lowered
                                  [(LowerExpr.Expr
                                      idx-state
                                      idx-value
                                      idx-value-ty)
                                    (match (lower-array-set-direct-store
                                      ctx
                                      (lower-state-clone idx-state)
                                      env
                                      type-env
                                      arr
                                      index
                                      arr-value
                                      idx-value
                                      idx-value-ty
                                      container-ty
                                      elem-ir-ty
                                      value)
                                      [(LowerMaybeDirectStore.Store
                                          direct-state)
                                        (ResultLowerExpr.Ok
                                          (LowerExpr.Expr
                                            direct-state
                                            ir.CompilerIrValue.Unit
                                            (ast.AstType.Unit)))]
                                      [(LowerMaybeDirectStore.Err message)
                                        (ResultLowerExpr.Err message)]
                                      [(LowerMaybeDirectStore.No)
                                        (match (lower-expr-expected
                                          ctx
                                          idx-state
                                          env
                                          type-env
                                          value
                                          elem-ir-ty
                                          value)
                                          [(ResultLowerExpr.Ok value-lowered)
                                            (match value-lowered
                                              [(LowerExpr.Expr
                                                  value-state
                                                  value-ir
                                                  _)
                                                (lower-array-set-store-materialized
                                                  ctx
                                                  value-state
                                                  arr
                                                  index
                                                  arr-value
                                                  idx-value
                                                  idx-value-ty
                                                  container-ty
                                                  elem-ir-ty
                                                  value-ir)])]
                                          [(ResultLowerExpr.Err message)
                                            (ResultLowerExpr.Err message)])])])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])]
                          [(tc_core.ResultTcType.Err message)
                            (ResultLowerExpr.Err
                              (box (lower-diagnostic-at-expr index message)))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))])]
        [(tc_core.ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

;; Copy old dynamic-array elements into a freshly allocated buffer. The loop is
;; emitted as explicit IR so `array-push!` works for runtime lengths.
(define (lower-array-push-copy-loop
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [old-len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : LowerState
  (match (lower-state-fresh-label state "array_push_copy_header")
    [(LowerLabel.Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "array_push_copy_body")
        [(LowerLabel.Label body-label-state body-label)
          (match (lower-state-fresh-label
            body-label-state
            "array_push_copy_exit")
            [(LowerLabel.Label exit-label-state exit-label)
              (match (lower-state-alloc-var exit-label-state)
                [(LowerAlloc.Alloc index-alloc index-var)
                  (let
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            index-alloc
                            (ir.CompilerIrInstr.Mov
                              index-var
                              (ir.CompilerIrValue.I64 0)
                              (ast.AstType.I64)))
                          (ir.CompilerIrInstr.Jump header-label))
                        header-label)]
                    (match (lower-state-alloc-var header-start)
                      [(LowerAlloc.Alloc cond-alloc cond-var)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                (lower-state-emit
                                  cond-alloc
                                  (ir.CompilerIrInstr.BinOp
                                    cond-var
                                    ir.CompilerIrBinOp.Lt
                                    (ir.CompilerIrValue.Var index-var)
                                    old-len
                                    (ast.AstType.I64)))
                                (ir.CompilerIrInstr.Branch
                                  (ir.CompilerIrValue.Var cond-var)
                                  body-label
                                  exit-label))
                              body-label)]
                          (match (lower-emit-elem-addr-gep
                            ctx
                            body-start
                            old-buf
                            (ir.CompilerIrValue.Var index-var)
                            elem-ty)
                            [(LowerExpr.Expr src-gep-state src-ptr _)
                              (match (lower-load-inline-value-at-offset
                                ctx
                                src-gep-state
                                src-ptr
                                0
                                elem-ty
                                (lower-state-mode src-gep-state))
                                [(LowerExpr.Expr load-state elem-value _)
                                  (match (lower-emit-elem-addr-gep
                                    ctx
                                    load-state
                                    new-buf
                                    (ir.CompilerIrValue.Var index-var)
                                    elem-ty)
                                    [(LowerExpr.Expr dst-gep-state dst-ptr _)
                                      (match (lower-state-alloc-var
                                        (lower-array-elem-store-state
                                          ctx
                                          dst-gep-state
                                          dst-ptr
                                          elem-value
                                          elem-ty))
                                        [(LowerAlloc.Alloc inc-alloc inc-var)
                                          (lower-state-finish-block
                                            (lower-state-emit
                                              (lower-state-emit
                                                (lower-state-emit
                                                  inc-alloc
                                                  (ir.CompilerIrInstr.BinOp
                                                    inc-var
                                                    ir.CompilerIrBinOp.Add
                                                    (ir.CompilerIrValue.Var
                                                      index-var)
                                                    (ir.CompilerIrValue.I64 1)
                                                    (ast.AstType.I64)))
                                                (ir.CompilerIrInstr.Mov
                                                  index-var
                                                  (ir.CompilerIrValue.Var
                                                    inc-var)
                                                  (ast.AstType.I64)))
                                              (ir.CompilerIrInstr.Jump
                                                header-label))
                                            exit-label)])])])]))]))])])])]))

(define (lower-array-push-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [old-buf : ir.CompilerIrValue]
  [old-len : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [new-len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : LowerExpr
  (match (lower-emit-elem-addr-gep
    ctx
    (lower-array-push-copy-loop ctx state old-buf new-buf old-len elem-ty)
    new-buf
    old-len
    elem-ty)
    [(LowerExpr.Expr tail-gep-state tail-ptr _)
      (LowerExpr.Expr
        (lower-store-at-offset
          (lower-store-at-offset
            (lower-array-elem-store-state
              ctx
              tail-gep-state
              tail-ptr
              value-ir
              elem-ty)
            arr-value
            0
            new-buf
            (ast.AstType.U64))
          arr-value
          8
          new-len
          (ast.AstType.I64))
        ir.CompilerIrValue.Unit
        (ast.AstType.Unit))]))

(define (lower-array-push-alloc-buffer
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [old-buf : ir.CompilerIrValue]
  [old-len : ir.CompilerIrValue]
  [elem-size : i64]
  [elem-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : LowerExpr
  (match (lower-emit-binop
    state
    ir.CompilerIrBinOp.Add
    old-len
    (ir.CompilerIrValue.I64 1)
    (ast.AstType.I64))
    [(LowerExpr.Expr len-state new-len _)
      (match (lower-emit-binop
        len-state
        ir.CompilerIrBinOp.Mul
        new-len
        (ir.CompilerIrValue.I64 elem-size)
        (ast.AstType.I64))
        [(LowerExpr.Expr byte-state byte-count _)
          (match (lower-state-alloc-var byte-state)
            [(LowerAlloc.Alloc buf-alloc buf-var)
              (lower-array-push-finish
                ctx
                (lower-state-emit
                  buf-alloc
                  (ir.CompilerIrInstr.Call
                    buf-var
                    (lower-tl-alloc-symbol)
                    (ir.CompilerIrCallArgs.One byte-count)
                    (ast.AstType.U64)))
                arr-value
                old-buf
                old-len
                (ir.CompilerIrValue.Var buf-var)
                new-len
                elem-ty
                value-ir)])])]))

(define (lower-array-push-after-max-check
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [fail-label : i64]
  [alloc-label : i64]
  [arr-value : ir.CompilerIrValue]
  [old-buf : ir.CompilerIrValue]
  [old-len : ir.CompilerIrValue]
  [elem-size : i64]
  [elem-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : LowerExpr
  (let
    [fail-start : LowerState (lower-state-finish-block state fail-label)]
    [alloc-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (ir.CompilerIrInstr.Jump alloc-label))
        alloc-label)]
    (lower-array-push-alloc-buffer
      ctx
      alloc-start
      arr-value
      old-buf
      old-len
      elem-size
      elem-ty
      value-ir)))

(define (lower-array-push-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : LowerExpr
  (match (lower-load-at-offset state arr-value 8 (ast.AstType.I64))
    [(LowerExpr.Expr len-state old-len _)
      (match (lower-load-at-offset len-state arr-value 0 (ast.AstType.U64))
        [(LowerExpr.Expr buf-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            [max-old-len : i64
              (if (= elem-size 0)
                9223372036854775806
                (- (/ 9223372036854775807 elem-size) 1))]
            (match (lower-state-fresh-label buf-state "array_push_alloc")
              [(LowerLabel.Label alloc-label-state alloc-label)
                (match (lower-state-fresh-label
                  alloc-label-state
                  "array_push_fail")
                  [(LowerLabel.Label fail-label-state fail-label)
                    (match (lower-emit-binop
                      fail-label-state
                      ir.CompilerIrBinOp.Le
                      old-len
                      (ir.CompilerIrValue.I64 max-old-len)
                      (ast.AstType.I64))
                      [(LowerExpr.Expr check-state within-max _)
                        (lower-array-push-after-max-check
                          ctx
                          (lower-state-emit
                            check-state
                            (ir.CompilerIrInstr.Branch
                              within-max
                              alloc-label
                              fail-label))
                          fail-label
                          alloc-label
                          arr-value
                          old-buf
                          old-len
                          elem-size
                          elem-ty
                          value-ir)])])]))])]))

;; `(array-push! arr value)` -> allocate a new element buffer in the active
;; arena, copy old elements, append `value`, and update the fat `{ptr, len}`.
(define (lower-array-push
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [value : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(tc_core.ResultTcType.Ok arr-ty)
      (match (tc_core.tc-array-push-receiver ctx arr-ty)
        [(tc_core.ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(tc_core.TcArrayReceiver _ elem-ty)
              (let
                [elem-ir-ty : ast.AstType
                  (tc_core.tc-type-without-regions elem-ty)]
                (match (lower-expr ctx state env type-env arr)
                  [(ResultLowerExpr.Ok arr-lowered)
                    (match arr-lowered
                      [(LowerExpr.Expr arr-state arr-value _)
                        (match (lower-expr-expected
                          ctx
                          arr-state
                          env
                          type-env
                          value
                          elem-ir-ty
                          value)
                          [(ResultLowerExpr.Ok value-lowered)
                            (match value-lowered
                              [(LowerExpr.Expr value-state value-ir _)
                                (ResultLowerExpr.Ok
                                  (lower-array-push-from-values
                                    ctx
                                    value-state
                                    arr-value
                                    elem-ir-ty
                                    value-ir))])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))])]
        [(tc_core.ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))])]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

;; Lower each syscall operand and widen it to i64 (the kernel reads the full
;; 64-bit registers). Mirrors `lower-args` but inserts the cast.
(define (lower-syscall-args
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]) : ResultLowerArgs
  (lower-syscall-args-at ctx state env type-env (& args) 0))

(define (lower-syscall-args-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index (struct-get args len))
    (ResultLowerArgs.Ok state ir.CompilerIrValueList.Nil)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      (match (lower-expr ctx state env type-env arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state value value-ty)
              (match (lower-cast-value
                arg-state
                value
                value-ty
                (ast.AstType.I64))
                [(LowerExpr.Expr cast-state cast-value _)
                  (match (lower-syscall-args-at
                    ctx
                    cast-state
                    env
                    type-env
                    args
                    (+ index 1))
                    [(ResultLowerArgs.Ok rest-state rest-values)
                      (ResultLowerArgs.Ok
                        rest-state
                        (ir.compiler-ir-value-cons cast-value rest-values))]
                    [(ResultLowerArgs.Err message)
                      (ResultLowerArgs.Err message)])])])]
        [(ResultLowerExpr.Err message) (ResultLowerArgs.Err message)]))))

(define (lower-syscall
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]) : ResultLowerExpr
  (match (lower-syscall-args ctx state env type-env args)
    [(ResultLowerArgs.Ok args-state values)
      (match (lower-state-alloc-var args-state)
        [(LowerAlloc.Alloc allocated var-id)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-state-emit
                allocated
                (ir.CompilerIrInstr.Syscall
                  var-id
                  (ir.compiler-ir-call-args-from-list values)))
              (ir.CompilerIrValue.Var var-id)
              (ast.AstType.I64)))])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-args
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]) : ResultLowerArgs
  (lower-args-at ctx state env type-env (& args) 0))

(define (lower-args-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index (struct-get args len))
    (ResultLowerArgs.Ok state ir.CompilerIrValueList.Nil)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      (match (lower-expr ctx state env type-env arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state value _)
              (match (lower-args-at ctx arg-state env type-env args (+ index 1))
                [(ResultLowerArgs.Ok rest-state rest-values)
                  (ResultLowerArgs.Ok
                    rest-state
                    (ir.compiler-ir-value-cons value rest-values))]
                [(ResultLowerArgs.Err message) (ResultLowerArgs.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerArgs.Err message)]))))

(define (lower-let-binding-type
  [ctx : tc_core.TcContext]
  [maybe-ty : ast.AstMaybeType]
  [init-ty : ast.AstType]) : ast.AstType
  (match maybe-ty
    [(ast.AstMaybeType.Some ty)
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    [(ast.AstMaybeType.No) (tc_core.tc-type-without-regions init-ty)]))

(define (lower-let-init
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]) : ResultLowerExpr
  (match maybe-ty
    [(ast.AstMaybeType.Some ty)
      (if (tc_core.tc-ref-capturing-lambda-init?
        (tc_core.tc-context-expr-bases ctx)
        type-env
        init)
        (match (ast.ast-expr-unspan init)
          [(ast.AstExpr.Lambda lambda-box)
            (match (box-get lambda-box)
              [(ast.AstLambda.Lambda params lambda-ret body-box)
                (let
                  [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
                  [expected-ty : ast.AstType
                    (tc_core.tc-type-without-regions
                      (tc_core.tc-resolve-type ctx ty))]
                  (match (lower-lambda
                    ctx
                    state
                    env
                    type-env
                    params
                    lambda-ret
                    body
                    init
                    expected-ty)
                    [(ResultLowerExpr.Ok lowered)
                      (match lowered
                        [(LowerExpr.Expr next-state value actual-ty)
                          (ResultLowerExpr.Ok
                            (lower-coerce-value
                              next-state
                              value
                              actual-ty
                              expected-ty))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)]))])]
          [_
            (lower-expr-expected
              ctx
              state
              env
              type-env
              init
              (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))
              init)])
        (lower-expr-expected
          ctx
          state
          env
          type-env
          init
          (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))
          init))]
    [(ast.AstMaybeType.No)
      (if (tc_core.tc-ref-capturing-lambda-init?
        (tc_core.tc-context-expr-bases ctx)
        type-env
        init)
        (match (ast.ast-expr-unspan init)
          [(ast.AstExpr.Lambda lambda-box)
            (match (box-get lambda-box)
              [(ast.AstLambda.Lambda params lambda-ret body-box)
                (let
                  [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
                  (match (tc_core.tc-lambda-expr-allow-ref-captures
                    ctx
                    type-env
                    params
                    lambda-ret
                    body)
                    [(tc_core.ResultTcType.Ok lambda-ty)
                      (lower-lambda
                        ctx
                        state
                        env
                        type-env
                        params
                        lambda-ret
                        body
                        init
                        lambda-ty)]
                    [(tc_core.ResultTcType.Err message)
                      (ResultLowerExpr.Err
                        (box (lower-diagnostic-at-expr init message)))]))])]
          [_ (lower-expr ctx state env type-env init)])
        (lower-expr ctx state env type-env init))]))

(define (lower-let-bindings
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : ast.AstLetBindingList]) : ResultLowerEnv
  (lower-let-bindings-at ctx state env type-env (& bindings) 0))

(define (lower-let-bindings-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : ResultLowerEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (ResultLowerEnv.Ok state env type-env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [name-id : i64 name]
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          (match (lower-let-init ctx state env type-env maybe-ty init)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr init-state init-value init-ty)
                  (let
                    [binding-ty : ast.AstType
                      (lower-let-binding-type ctx maybe-ty init-ty)]
                    [binding-ir-ty : ast.AstType
                      (lower-one-word-register-storage-type ctx binding-ty)]
                    (match (lower-state-alloc-var init-state)
                      [(LowerAlloc.Alloc allocated var-id)
                        (let
                          [next-type-env : tc_core.TcTypeEnv
                            (tc_core.tc-bind-c-abi-fnptr-if-needed-id
                              ctx
                              type-env
                              name-id
                              binding-ty
                              init)]
                          (lower-let-bindings-at
                            ctx
                            (let
                              [next-state : LowerState
                                (lower-state-emit
                                  allocated
                                  (ir.CompilerIrInstr.Mov
                                    var-id
                                    init-value
                                    binding-ir-ty))]
                              (if (>= lower-active-loop-entry-var-limit 0)
                                (let
                                  [init-alias-origin : i64
                                    (lower-state-inline-result-alias-origin
                                      next-state
                                      init-value)]
                                  (lower-state-inline-result-alias-set
                                    next-state
                                    var-id
                                    init-alias-origin))
                                next-state))
                            (sym_i64_env.sym-i64-bind-id env name-id var-id)
                            next-type-env
                            bindings
                            (+ index 1)))]))])]
            [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)]))])))

(define (lower-resource-bindings
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : ast.AstResourceBindingList]
  [cleanups : LowerCleanupStack]) : ResultLowerResourceBindings
  (lower-resource-bindings-at ctx state env type-env (& bindings) cleanups 0))

(define (lower-resource-bindings-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [cleanups : LowerCleanupStack]
  [index : i64]) : ResultLowerResourceBindings
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (ResultLowerResourceBindings.Ok
      (LowerResourceBindings.Bindings state env type-env cleanups))
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding name init-box cleanup-box move-aware?)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [cleanup : ast.AstExpr (lower-context-expr-get ctx cleanup-box)]
          (match (tc_core.tc-resource-cleanup-resource-type
            ctx
            type-env
            cleanup)
            [(tc_core.ResultTcType.Ok expected-init-ty)
              (match (lower-expr-expected
                ctx
                state
                env
                type-env
                init
                (tc_core.tc-type-without-regions expected-init-ty)
                init)
                [(ResultLowerExpr.Ok lowered)
                  (match lowered
                    [(LowerExpr.Expr init-state init-value init-ty)
                      (match (lower-cleanup-name-id-from-expr cleanup)
                        [(tc_core.ResultTcExprId.Ok cleanup-name-id)
                          (let
                            [binding-ty : ast.AstType
                              (tc_core.tc-type-without-regions init-ty)]
                            [binding-ir-ty : ast.AstType
                              (lower-one-word-register-storage-type
                                ctx
                                binding-ty)]
                            (match (lower-state-alloc-var init-state)
                              [(LowerAlloc.Alloc allocated var-id)
                                (let
                                  [hidden-name-id : i64
                                    (lower-cleanup-hidden-name-id var-id)]
                                  [bound-state : LowerState
                                    (lower-state-emit
                                      allocated
                                      (ir.CompilerIrInstr.Mov
                                        var-id
                                        init-value
                                        binding-ir-ty))]
                                  [bound-env : sym_i64_env.SymI64Env
                                    (sym_i64_env.sym-i64-bind-id
                                      (sym_i64_env.sym-i64-bind-id
                                        env
                                        name
                                        var-id)
                                      hidden-name-id
                                      var-id)]
                                  [bound-type-env : tc_core.TcTypeEnv
                                    (lower-type-env-push-cleanup
                                      (tc_core.tc-bind-id
                                        type-env
                                        name
                                        binding-ty)
                                      hidden-name-id
                                      cleanup-name-id)]
                                  (if move-aware?
                                    (match (lower-state-alloc-var bound-state)
                                      [(LowerAlloc.Alloc live-state live-var-id)
                                        (let
                                          [live-name-id : i64
                                            (lower-cleanup-live-name-id var-id)]
                                          (lower-resource-bindings-at
                                            ctx
                                            (lower-state-emit
                                              live-state
                                              (ir.CompilerIrInstr.Mov
                                                live-var-id
                                                (ir.CompilerIrValue.Bool true)
                                                (ast.AstType.Bool)))
                                            (sym_i64_env.sym-i64-bind-id
                                              bound-env
                                              live-name-id
                                              live-var-id)
                                            (lower-type-env-push-move-aware-cleanup
                                              (tc_core.tc-bind-id
                                                type-env
                                                name
                                                binding-ty)
                                              hidden-name-id
                                              cleanup-name-id
                                              live-name-id)
                                            bindings
                                            (lower-cleanup-stack-push-move-aware
                                              cleanups
                                              hidden-name-id
                                              cleanup-name-id
                                              live-name-id)
                                            (+ index 1)))])
                                    (lower-resource-bindings-at
                                      ctx
                                      bound-state
                                      bound-env
                                      bound-type-env
                                      bindings
                                      (lower-cleanup-stack-push
                                        cleanups
                                        hidden-name-id
                                        cleanup-name-id)
                                      (+ index 1))))]))]
                        [(tc_core.ResultTcExprId.Err message)
                          (ResultLowerResourceBindings.Err
                            (box (lower-diagnostic-at-expr cleanup message)))])])]
                [(ResultLowerExpr.Err message)
                  (ResultLowerResourceBindings.Err message)])]
            [(tc_core.ResultTcType.Err message)
              (ResultLowerResourceBindings.Err
                (box (lower-diagnostic-at-expr cleanup message)))]))])))

(define (lower-with-resource
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : ast.AstResourceBindingList]
  [body : ast.AstExprList]) : ResultLowerExpr
  (match (lower-resource-bindings
    ctx
    state
    env
    type-env
    bindings
    (lower-cleanup-stack-empty))
    [(ResultLowerResourceBindings.Ok lowered-bindings)
      (match lowered-bindings
        [(LowerResourceBindings.Bindings
            binding-state
            body-env
            body-type-env
            cleanups)
          (match (lower-begin ctx binding-state body-env body-type-env body)
            [(ResultLowerExpr.Ok lowered-body)
              (match lowered-body
                [(LowerExpr.Expr body-state value body-ty)
                  (if (tc_core.tc-never-type? body-ty)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr body-state value body-ty))
                    (match (lower-emit-cleanup-stack
                      body-state
                      body-env
                      cleanups)
                      [(ResultLowerState.Ok cleanup-state)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr cleanup-state value body-ty))]
                      [(ResultLowerState.Err message)
                        (ResultLowerExpr.Err message)]))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerResourceBindings.Err message) (ResultLowerExpr.Err message)]))

(define (lower-begin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultLowerExpr
  (lower-begin-at ctx state env type-env (& exprs) 0))

(define (lower-begin-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultLowerExpr
  (let
    [len : i64 (struct-get exprs len)]
    (if (>= index len)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr state ir.CompilerIrValue.Unit (ast.AstType.Unit)))
      (let
        [expr : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
        (if (= (+ index 1) len)
          (lower-expr ctx state env type-env expr)
          (match (lower-expr ctx state env type-env expr)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr next-state _ expr-ty)
                  (if (tc_core.tc-never-type? expr-ty)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr
                        next-state
                        ir.CompilerIrValue.Unit
                        (ast.AstType.Never)))
                    (lower-begin-at
                      ctx
                      next-state
                      env
                      type-env
                      exprs
                      (+ index 1)))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))))

(define (lower-begin-expected
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (lower-begin-expected-at ctx state env type-env (& exprs) 0 expected-ty))

(define (lower-begin-expected-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (let
    [len : i64 (struct-get exprs len)]
    (if (>= index len)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr state ir.CompilerIrValue.Unit (ast.AstType.Unit)))
      (let
        [expr : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
        (if (= (+ index 1) len)
          (lower-expr-expected ctx state env type-env expr expected-ty expr)
          (match (lower-expr ctx state env type-env expr)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr next-state _ expr-ty)
                  (if (tc_core.tc-never-type? expr-ty)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr
                        next-state
                        ir.CompilerIrValue.Unit
                        (ast.AstType.Never)))
                    (lower-begin-expected-at
                      ctx
                      next-state
                      env
                      type-env
                      exprs
                      (+ index 1)
                      expected-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))))

(define (lower-with-arena
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [body : ast.AstExprList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc mark-allocated mark-var)
      (let
        [hidden-name-id : i64 (lower-region-hidden-name-id mark-var)]
        [marked-state : LowerState
          (lower-state-emit
            mark-allocated
            (ir.CompilerIrInstr.Call
              mark-var
              (lower-tl-region-mark-symbol)
              (ir.CompilerIrCallArgs.Nil)
              (ast.AstType.U64)))]
        [region-env : sym_i64_env.SymI64Env
          (sym_i64_env.sym-i64-bind-id env hidden-name-id mark-var)]
        [region-type-env : tc_core.TcTypeEnv
          (lower-type-env-push-region-reset type-env hidden-name-id)]
        (match (lower-begin ctx marked-state region-env region-type-env body)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr body-state value body-ty)
                (if (tc_core.tc-never-type? body-ty)
                  (ResultLowerExpr.Ok (LowerExpr.Expr body-state value body-ty))
                  (match (lower-state-alloc-var body-state)
                    [(LowerAlloc.Alloc reset-allocated reset-var)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-state-emit
                            reset-allocated
                            (ir.CompilerIrInstr.Call
                              reset-var
                              (lower-tl-region-reset-symbol)
                              (ir.CompilerIrCallArgs.One
                                (ir.CompilerIrValue.Var mark-var))
                              (ast.AstType.Unit)))
                          value
                          body-ty))]))])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]))

(define (lower-arena-handle
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arena : ast.AstExpr]
  [form : String]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arena)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr arena-state arena-value arena-ty)
          (if (tc_core.tc-arena-type? ctx arena-ty)
            (lower-struct-get-named
              ctx
              arena-state
              arena-value
              (lower-struct-type-name-id-or
                (tc_core.tc-resolve-type ctx arena-ty)
                -1)
              (lower-struct-type-name-or-empty
                (tc_core.tc-resolve-type ctx arena-ty))
              cbi.compiler-builtin-id-fix-handle
              "handle"
              (ast.AstType.I64))
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic
                  (str_cat.str-cat "lower: " form " arena must be Arena")))))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-in-arena
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arena : ast.AstExpr]
  [body : ast.AstExprList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc saved-allocated saved-var)
      (let
        [saved-state : LowerState
          (lower-state-emit
            saved-allocated
            (ir.CompilerIrInstr.Call
              saved-var
              (lower-tl-arena-current-symbol)
              ir.CompilerIrCallArgs.Nil
              (ast.AstType.I64)))]
        (match (lower-arena-handle
          ctx
          saved-state
          env
          type-env
          arena
          "in-arena")
          [(ResultLowerExpr.Ok arena-lowered)
            (match arena-lowered
              [(LowerExpr.Expr arena-state arena-value _)
                (match (lower-runtime-call-values
                  arena-state
                  (lower-tl-arena-set-symbol)
                  (ir.compiler-ir-value-cons
                    arena-value
                    ir.CompilerIrValueList.Nil)
                  (ast.AstType.Unit))
                  [(ResultLowerExpr.Ok set-lowered)
                    (match set-lowered
                      [(LowerExpr.Expr set-state _ _)
                        (let
                          [hidden-name-id : i64
                            (lower-arena-restore-hidden-name-id saved-var)]
                          [body-env : sym_i64_env.SymI64Env
                            (sym_i64_env.sym-i64-bind-id
                              env
                              hidden-name-id
                              saved-var)]
                          [body-type-env : tc_core.TcTypeEnv
                            (lower-type-env-push-arena-restore
                              type-env
                              hidden-name-id)]
                          (match (lower-begin
                            ctx
                            set-state
                            body-env
                            body-type-env
                            body)
                            [(ResultLowerExpr.Ok body-lowered)
                              (match body-lowered
                                [(LowerExpr.Expr body-state value body-ty)
                                  (if (tc_core.tc-never-type? body-ty)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr body-state value body-ty))
                                    (match (lower-runtime-call-values
                                      body-state
                                      (lower-tl-arena-set-symbol)
                                      (ir.compiler-ir-value-cons
                                        (ir.CompilerIrValue.Var saved-var)
                                        ir.CompilerIrValueList.Nil)
                                      (ast.AstType.Unit))
                                      [(ResultLowerExpr.Ok restore-lowered)
                                        (match restore-lowered
                                          [(LowerExpr.Expr restore-state _ _)
                                            (ResultLowerExpr.Ok
                                              (LowerExpr.Expr
                                                restore-state
                                                value
                                                body-ty))])]
                                      [(ResultLowerExpr.Err message)
                                        (ResultLowerExpr.Err message)]))])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)]))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]))

(define (lower-with-escape-final
  [final-lowered : LowerExpr]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (match final-lowered
    [(LowerExpr.Expr final-state _ _)
      (ResultLowerExpr.Ok (LowerExpr.Expr final-state escaped-value escaped-ty))]))

(define (lower-with-escape-rewind
  [state : LowerState]
  [mark-value : ir.CompilerIrValue]
  [new-enclosing-value : ir.CompilerIrValue]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-region-reset-symbol)
    (ir.compiler-ir-value-cons mark-value ir.CompilerIrValueList.Nil)
    (ast.AstType.Unit))
    [(ResultLowerExpr.Ok rewind-lowered)
      (match rewind-lowered
        [(LowerExpr.Expr rewind-state _ _)
          (match (lower-runtime-call-values
            rewind-state
            (lower-tl-arena-set-symbol)
            (ir.compiler-ir-value-cons
              new-enclosing-value
              ir.CompilerIrValueList.Nil)
            (ast.AstType.Unit))
            [(ResultLowerExpr.Ok final-lowered)
              (lower-with-escape-final final-lowered escaped-value escaped-ty)]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-escape-cleanup
  [state : LowerState]
  [scratch-head-value : ir.CompilerIrValue]
  [mark-value : ir.CompilerIrValue]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-current-symbol)
    ir.CompilerIrValueList.Nil
    (ast.AstType.I64))
    [(ResultLowerExpr.Ok new-enclosing-lowered)
      (match new-enclosing-lowered
        [(LowerExpr.Expr new-enclosing-state new-enclosing-value _)
          (match (lower-runtime-call-values
            new-enclosing-state
            (lower-tl-arena-set-symbol)
            (ir.compiler-ir-value-cons
              scratch-head-value
              ir.CompilerIrValueList.Nil)
            (ast.AstType.Unit))
            [(ResultLowerExpr.Ok restore-scratch-lowered)
              (match restore-scratch-lowered
                [(LowerExpr.Expr restore-scratch-state _ _)
                  (lower-with-escape-rewind
                    restore-scratch-state
                    mark-value
                    new-enclosing-value
                    escaped-value
                    escaped-ty)])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-escape-clone
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scratch-head-value : ir.CompilerIrValue]
  [mark-value : ir.CompilerIrValue]
  [body-value : ir.CompilerIrValue]
  [body-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-clone-dispatch ctx state env type-env body-value body-ty)
    [(ResultLowerExpr.Ok escaped-lowered)
      (match escaped-lowered
        [(LowerExpr.Expr escaped-state escaped-value escaped-ty)
          (lower-with-escape-cleanup
            escaped-state
            scratch-head-value
            mark-value
            escaped-value
            escaped-ty)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-escape-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [enclosing-value : ir.CompilerIrValue]
  [mark-value : ir.CompilerIrValue]
  [body : ast.AstExprList]) : ResultLowerExpr
  (match (lower-begin ctx state env type-env body)
    [(ResultLowerExpr.Ok body-lowered)
      (match body-lowered
        [(LowerExpr.Expr body-state body-value body-ty)
          (match (lower-runtime-call-values
            body-state
            (lower-tl-arena-current-symbol)
            ir.CompilerIrValueList.Nil
            (ast.AstType.I64))
            [(ResultLowerExpr.Ok scratch-head-lowered)
              (match scratch-head-lowered
                [(LowerExpr.Expr scratch-head-state scratch-head-value _)
                  (match (lower-runtime-call-values
                    scratch-head-state
                    (lower-tl-arena-set-symbol)
                    (ir.compiler-ir-value-cons
                      enclosing-value
                      ir.CompilerIrValueList.Nil)
                    (ast.AstType.Unit))
                    [(ResultLowerExpr.Ok restore-enclosing-lowered)
                      (match restore-enclosing-lowered
                        [(LowerExpr.Expr restore-state _ _)
                          (lower-with-escape-clone
                            ctx
                            restore-state
                            env
                            type-env
                            scratch-head-value
                            mark-value
                            body-value
                            body-ty)])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-escape
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scratch : ast.AstExpr]
  [body : ast.AstExprList]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-current-symbol)
    ir.CompilerIrValueList.Nil
    (ast.AstType.I64))
    [(ResultLowerExpr.Ok enclosing-lowered)
      (match enclosing-lowered
        [(LowerExpr.Expr enclosing-state enclosing-value _)
          (match (lower-arena-handle
            ctx
            enclosing-state
            env
            type-env
            scratch
            "with-escape")
            [(ResultLowerExpr.Ok scratch-lowered)
              (match scratch-lowered
                [(LowerExpr.Expr scratch-state scratch-value _)
                  (match (lower-runtime-call-values
                    scratch-state
                    (lower-tl-arena-set-symbol)
                    (ir.compiler-ir-value-cons
                      scratch-value
                      ir.CompilerIrValueList.Nil)
                    (ast.AstType.Unit))
                    [(ResultLowerExpr.Ok set-scratch-lowered)
                      (match set-scratch-lowered
                        [(LowerExpr.Expr set-scratch-state _ _)
                          (match (lower-runtime-call-values
                            set-scratch-state
                            (lower-tl-region-mark-symbol)
                            ir.CompilerIrValueList.Nil
                            (ast.AstType.U64))
                            [(ResultLowerExpr.Ok mark-lowered)
                              (match mark-lowered
                                [(LowerExpr.Expr mark-state mark-value _)
                                  (lower-with-escape-body
                                    ctx
                                    mark-state
                                    env
                                    type-env
                                    enclosing-value
                                    mark-value
                                    body)])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)])])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch-final-restore
  [state : LowerState]
  [new-enclosing-value : ir.CompilerIrValue]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-set-symbol)
    (ir.compiler-ir-value-cons new-enclosing-value ir.CompilerIrValueList.Nil)
    (ast.AstType.Unit))
    [(ResultLowerExpr.Ok final-lowered)
      (lower-with-escape-final final-lowered escaped-value escaped-ty)]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch-cleanup
  [state : LowerState]
  [scratch-head-value : ir.CompilerIrValue]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-current-symbol)
    ir.CompilerIrValueList.Nil
    (ast.AstType.I64))
    [(ResultLowerExpr.Ok new-enclosing-lowered)
      (match new-enclosing-lowered
        [(LowerExpr.Expr new-enclosing-state new-enclosing-value _)
          (match (lower-runtime-call-values
            new-enclosing-state
            (lower-tl-arena-destroy-symbol)
            (ir.compiler-ir-value-cons
              scratch-head-value
              ir.CompilerIrValueList.Nil)
            (ast.AstType.Unit))
            [(ResultLowerExpr.Ok destroy-lowered)
              (match destroy-lowered
                [(LowerExpr.Expr destroy-state _ _)
                  (lower-with-scratch-final-restore
                    destroy-state
                    new-enclosing-value
                    escaped-value
                    escaped-ty)])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch-clone
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scratch-head-value : ir.CompilerIrValue]
  [body-value : ir.CompilerIrValue]
  [body-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-clone-dispatch ctx state env type-env body-value body-ty)
    [(ResultLowerExpr.Ok escaped-lowered)
      (match escaped-lowered
        [(LowerExpr.Expr escaped-state escaped-value escaped-ty)
          (lower-with-scratch-cleanup
            escaped-state
            scratch-head-value
            escaped-value
            escaped-ty)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [enclosing-value : ir.CompilerIrValue]
  [body : ast.AstExprList]) : ResultLowerExpr
  (match (lower-begin ctx state env type-env body)
    [(ResultLowerExpr.Ok body-lowered)
      (match body-lowered
        [(LowerExpr.Expr body-state body-value body-ty)
          (match (lower-runtime-call-values
            body-state
            (lower-tl-arena-current-symbol)
            ir.CompilerIrValueList.Nil
            (ast.AstType.I64))
            [(ResultLowerExpr.Ok scratch-head-lowered)
              (match scratch-head-lowered
                [(LowerExpr.Expr scratch-head-state scratch-head-value _)
                  (match (lower-runtime-call-values
                    scratch-head-state
                    (lower-tl-arena-set-symbol)
                    (ir.compiler-ir-value-cons
                      enclosing-value
                      ir.CompilerIrValueList.Nil)
                    (ast.AstType.Unit))
                    [(ResultLowerExpr.Ok restore-enclosing-lowered)
                      (match restore-enclosing-lowered
                        [(LowerExpr.Expr restore-state _ _)
                          (lower-with-scratch-clone
                            ctx
                            restore-state
                            env
                            type-env
                            scratch-head-value
                            body-value
                            body-ty)])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [body : ast.AstExprList]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-current-symbol)
    ir.CompilerIrValueList.Nil
    (ast.AstType.I64))
    [(ResultLowerExpr.Ok enclosing-lowered)
      (match enclosing-lowered
        [(LowerExpr.Expr enclosing-state enclosing-value _)
          (match (lower-runtime-call-values
            enclosing-state
            (lower-tl-arena-make-symbol)
            ir.CompilerIrValueList.Nil
            (ast.AstType.I64))
            [(ResultLowerExpr.Ok scratch-lowered)
              (match scratch-lowered
                [(LowerExpr.Expr scratch-state scratch-value _)
                  (match (lower-runtime-call-values
                    scratch-state
                    (lower-tl-arena-set-symbol)
                    (ir.compiler-ir-value-cons
                      scratch-value
                      ir.CompilerIrValueList.Nil)
                    (ast.AstType.Unit))
                    [(ResultLowerExpr.Ok set-scratch-lowered)
                      (match set-scratch-lowered
                        [(LowerExpr.Expr set-scratch-state _ _)
                          (lower-with-scratch-body
                            ctx
                            set-scratch-state
                            env
                            type-env
                            enclosing-value
                            body)])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-if-merge
  [ctx : tc_core.TcContext]
  [else-state : LowerState (:consume)]
  [then-value : ir.CompilerIrValue]
  [then-end-label : i64]
  [else-value : ir.CompilerIrValue]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [else-end-label : i64 (lower-state-current-label else-state)]
    [expr-ir-ty : ast.AstType
      (lower-one-word-register-storage-type ctx expr-ty)]
    [merge-start : LowerState
      (lower-state-finish-block
        (lower-state-emit else-state (ir.CompilerIrInstr.Jump merge-label))
        merge-label)]
    (match (lower-state-alloc-var merge-start)
      [(LowerAlloc.Alloc allocated var-id)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit
              allocated
              (ir.CompilerIrInstr.Phi
                var-id
                (ir.compiler-ir-phi-input-cons
                  then-value
                  then-end-label
                  (ir.compiler-ir-phi-input-cons
                    else-value
                    else-end-label
                    ir.CompilerIrPhiInputList.Nil))
                expr-ir-ty))
            (ir.CompilerIrValue.Var var-id)
            expr-ty))])))

(define (lower-if-single-merge
  [state : LowerState (:consume)]
  [value : ir.CompilerIrValue]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [merge-start : LowerState
      (lower-state-finish-block
        (lower-state-emit state (ir.CompilerIrInstr.Jump merge-label))
        merge-label)]
    (ResultLowerExpr.Ok (LowerExpr.Expr merge-start value expr-ty))))

(define (lower-if-finish
  [ctx : tc_core.TcContext]
  [then-value : ir.CompilerIrValue]
  [then-ty : ast.AstType]
  [then-end-label : i64]
  [else-state : LowerState (:consume)]
  [else-value : ir.CompilerIrValue]
  [else-ty : ast.AstType]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (tc_core.tc-never-type? then-ty)
    (if (tc_core.tc-never-type? else-ty)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-finish-block else-state merge-label)
          ir.CompilerIrValue.Unit
          (ast.AstType.Never)))
      (lower-if-single-merge else-state else-value merge-label expr-ty))
    (if (tc_core.tc-never-type? else-ty)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-finish-block else-state merge-label)
          then-value
          expr-ty))
      (lower-if-merge
        ctx
        else-state
        then-value
        then-end-label
        else-value
        merge-label
        expr-ty))))

(define (lower-if-else
  [ctx : tc_core.TcContext]
  [else-start : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [else-branch : ast.AstExpr]
  [then-value : ir.CompilerIrValue]
  [then-ty : ast.AstType]
  [then-end-label : i64]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    else-start
    env
    type-env
    else-branch
    expr-ty
    else-branch)
    [(ResultLowerExpr.Ok else-lowered)
      (match else-lowered
        [(LowerExpr.Expr else-state else-value else-ty)
          (lower-if-finish
            ctx
            then-value
            then-ty
            then-end-label
            else-state
            else-value
            else-ty
            merge-label
            expr-ty)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-if-then
  [ctx : tc_core.TcContext]
  [then-start : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]
  [else-label : i64]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    then-start
    env
    type-env
    then-branch
    expr-ty
    then-branch)
    [(ResultLowerExpr.Ok then-lowered)
      (match then-lowered
        [(LowerExpr.Expr then-state then-value then-ty)
          (let
            [then-end-label : i64 (lower-state-current-label then-state)]
            [else-start : LowerState
              (if (tc_core.tc-never-type? then-ty)
                (lower-state-finish-block then-state else-label)
                (lower-state-finish-block
                  (lower-state-emit
                    then-state
                    (ir.CompilerIrInstr.Jump merge-label))
                  else-label))]
            (lower-if-else
              ctx
              else-start
              env
              type-env
              else-branch
              then-value
              then-ty
              then-end-label
              merge-label
              expr-ty))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-if
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [cond : ast.AstExpr]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env cond)
    [(ResultLowerExpr.Ok cond-lowered)
      (match cond-lowered
        [(LowerExpr.Expr cond-state cond-value cond-ty)
          (if (tc_core.tc-type-compatible? (ast.AstType.Bool) cond-ty)
            (match (lower-state-fresh-label cond-state "if_then")
              [(LowerLabel.Label then-label-state then-label)
                (match (lower-state-fresh-label then-label-state "if_else")
                  [(LowerLabel.Label else-label-state else-label)
                    (match (lower-state-fresh-label else-label-state "if_merge")
                      [(LowerLabel.Label merge-label-state merge-label)
                        (let
                          [branch-state : LowerState
                            (lower-state-emit
                              merge-label-state
                              (ir.CompilerIrInstr.Branch
                                cond-value
                                then-label
                                else-label))]
                          (lower-if-then
                            ctx
                            (lower-state-finish-block branch-state then-label)
                            env
                            type-env
                            then-branch
                            else-branch
                            else-label
                            merge-label
                            expr-ty))])])])
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  cond
                  "typecheck: if condition must be bool"))))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-while-active
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [cond : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-fresh-label (lower-state-clone state) "while_header")
    [(LowerLabel.Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "while_body")
        [(LowerLabel.Label body-label-state body-label)
          (match (lower-state-fresh-label
            (lower-state-clone body-label-state)
            "while_exit")
            [(LowerLabel.Label exit-label-state exit-label)
              (let
                [header-start : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      exit-label-state
                      (ir.CompilerIrInstr.Jump header-label))
                    header-label)]
                (match (lower-expr ctx header-start env type-env cond)
                  [(ResultLowerExpr.Ok cond-lowered)
                    (match cond-lowered
                      [(LowerExpr.Expr cond-state cond-value _)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                cond-state
                                (ir.CompilerIrInstr.Branch
                                  cond-value
                                  body-label
                                  exit-label))
                              body-label)]
                          (match (lower-expr
                            ctx
                            body-start
                            env
                            (lower-enter-loop-target
                              type-env
                              (lower-while-exit-label-id
                                (lower-state-next-label-number body-label-state))
                              (lower-while-header-label-id
                                (lower-state-next-label-number state)))
                            body)
                            [(ResultLowerExpr.Ok body-lowered)
                              (match body-lowered
                                [(LowerExpr.Expr body-state _ body-ty)
                                  (ResultLowerExpr.Ok
                                    (LowerExpr.Expr
                                      (if (tc_core.tc-never-type? body-ty)
                                        (lower-state-finish-block
                                          body-state
                                          exit-label)
                                        (lower-state-finish-block
                                          (lower-state-emit
                                            body-state
                                            (ir.CompilerIrInstr.Jump
                                              header-label))
                                          exit-label))
                                      ir.CompilerIrValue.Unit
                                      (ast.AstType.Unit)))])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)]))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))])])]))

(define (lower-while
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [cond : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [previous-function : i64 lower-active-loop-function]
    [previous-var-limit : i64 lower-active-loop-entry-var-limit]
    (begin
      (set! lower-active-loop-function (lower-state-current-function-id state))
      (set! lower-active-loop-entry-var-limit (lower-state-next-var state))
      (let
        [result : ResultLowerExpr
          (lower-while-active ctx state env type-env cond body)]
        (begin
          (set! lower-active-loop-function previous-function)
          (set! lower-active-loop-entry-var-limit previous-var-limit)
          result)))))

;; Per-iteration accumulator update for an associative binop fold
;; (`sum`/`all`/`any`): `(set! acc (<op> acc value))`. `value` appears once so it
;; is evaluated exactly once per iteration.
(define (spmd-reduce-acc-binop-update
  [pools : ast.AstNodePoolContext]
  [op : ast.AstBinOp]
  [value : i64]) : i64
  (ast.ast-expr-set-id-with-pools
    pools
    (lower-spmd-reduce-acc-id)
    (ast.ast-expr-binary-with-pools
      pools
      op
      (ast.ast-node-pool-context-expr-push
        pools
        (ast.AstExpr.Var (lower-spmd-reduce-acc-id)))
      value)))

;; Per-iteration accumulator update for a select fold (`min`/`max`): bind `value`
;; once into a temp, then keep it when `(<cmp> val acc)` holds, else keep `acc`.
;; The temp keeps `value` to a single evaluation even though the select names it
;; twice.
(define (spmd-reduce-acc-select-update
  [pools : ast.AstNodePoolContext]
  [cmp : ast.AstBinOp]
  [value : i64]) : i64
  (ast.ast-expr-let-with-pools
    pools
    (ast.ast-let-binding-cons
      (ast.ast-let-binding-id
        (lower-spmd-reduce-val-id)
        (ast.AstMaybeType.No)
        value)
      (ast.ast-let-binding-list-new))
    (ast.ast-expr-set-id-with-pools
      pools
      (lower-spmd-reduce-acc-id)
      (ast.ast-expr-if-with-pools
        pools
        (ast.ast-expr-binary-with-pools
          pools
          cmp
          (ast.ast-node-pool-context-expr-push
            pools
            (ast.AstExpr.Var (lower-spmd-reduce-val-id)))
          (ast.ast-node-pool-context-expr-push
            pools
            (ast.AstExpr.Var (lower-spmd-reduce-acc-id))))
        (ast.ast-node-pool-context-expr-push
          pools
          (ast.AstExpr.Var (lower-spmd-reduce-val-id)))
        (ast.ast-node-pool-context-expr-push
          pools
          (ast.AstExpr.Var (lower-spmd-reduce-acc-id)))))))

(define (spmd-reduce-acc-update-expr
  [pools : ast.AstNodePoolContext]
  [op : ast.AstReduceOp]
  [value : i64]) : i64
  (match op
    [(ast.AstReduceOp.Sum)
      (spmd-reduce-acc-binop-update pools (ast.AstBinOp.Add) value)]
    [(ast.AstReduceOp.All)
      (spmd-reduce-acc-binop-update pools (ast.AstBinOp.And) value)]
    [(ast.AstReduceOp.Any)
      (spmd-reduce-acc-binop-update pools (ast.AstBinOp.Or) value)]
    [(ast.AstReduceOp.Min)
      (spmd-reduce-acc-select-update pools (ast.AstBinOp.Lt) value)]
    [(ast.AstReduceOp.Max)
      (spmd-reduce-acc-select-update pools (ast.AstBinOp.Gt) value)]))

;; Conservative scan used by the reduction addend split: does `expr` write
;; `name` (`set!`) anywhere, or rebind `name` with a `let` binding? Either one
;; means a `Var name` read at the top of the reduce value cannot be hoisted out
;; of the loop as-is. Variants that are not explicitly walked (match, nested
;; loops/comprehensions, quotes, region/escape blocks, ...) bail out with
;; `true` so the split simply does not fire on exotic value expressions.
(define (lower-spmd-reduce-expr-writes-id?
  [ctx : tc_core.TcContext]
  [name : i64]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(ast.AstExpr.Ann inner-box _)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(ast.AstExpr.Cast inner-box _)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(ast.AstExpr.Borrow _ _ inner-box)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(ast.AstExpr.Unary _ inner-box)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(ast.AstExpr.Binary _ left-box right-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name left-box)
        (lower-spmd-reduce-node-writes-id? ctx name right-box))]
    [(ast.AstExpr.Call func-box args)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name func-box)
        (lower-spmd-reduce-expr-list-writes-id? ctx name args))]
    [(ast.AstExpr.BracketClause items)
      (lower-spmd-reduce-expr-list-writes-id? ctx name items)]
    [(ast.AstExpr.If cond-box then-box else-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name cond-box)
        (lower-spmd-reduce-node-writes-id? ctx name then-box)
        (lower-spmd-reduce-node-writes-id? ctx name else-box))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (or
            (lower-spmd-reduce-let-bindings-write-id? ctx name bindings)
            (lower-spmd-reduce-node-writes-id? ctx name body-box))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda _ _ body-box)
          (lower-spmd-reduce-node-writes-id? ctx name body-box)])]
    [(ast.AstExpr.Tuple exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(ast.AstExpr.Array exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(ast.AstExpr.DynArray exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(ast.AstExpr.TupleRef tuple-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name tuple-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(ast.AstExpr.MakeArray _ len-box)
      (lower-spmd-reduce-node-writes-id? ctx name len-box)]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(ast.AstExpr.ArrayTake array-box live-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name live-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(ast.AstExpr.FixedArrayTake array-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(ast.AstExpr.ArrayPush array-box value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(ast.AstExpr.StringRef string-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name string-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(ast.AstExpr.While cond-box body-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name cond-box)
        (lower-spmd-reduce-node-writes-id? ctx name body-box))]
    [(ast.AstExpr.Begin exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(ast.AstExpr.Set set-name value-box)
      (or
        (= set-name name)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(ast.AstExpr.StructGet target-box _)
      (lower-spmd-reduce-node-writes-id? ctx name target-box)]
    [(ast.AstExpr.StructSet target-box _ value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name target-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(ast.AstExpr.Box value-box)
      (lower-spmd-reduce-node-writes-id? ctx name value-box)]
    [(ast.AstExpr.BoxGet value-box)
      (lower-spmd-reduce-node-writes-id? ctx name value-box)]
    [(ast.AstExpr.BoxTake value-box)
      (lower-spmd-reduce-node-writes-id? ctx name value-box)]
    [(ast.AstExpr.BoxSet target-box value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name target-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(ast.AstExpr.Literal _) false]
    [(ast.AstExpr.Var _) false]
    [_ true]))

(define (lower-spmd-reduce-node-writes-id?
  [ctx : tc_core.TcContext]
  [name : i64]
  [id : i64]) : bool
  (lower-spmd-reduce-expr-writes-id? ctx name (lower-context-expr-get ctx id)))

(define (lower-spmd-reduce-expr-list-writes-id?
  [ctx : tc_core.TcContext]
  [name : i64]
  [exprs : ast.AstExprList]) : bool
  (lower-spmd-reduce-expr-list-writes-id-at? ctx name (& exprs) 0))

(define (lower-spmd-reduce-expr-list-writes-id-at?
  [ctx : tc_core.TcContext]
  [name : i64]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : bool
  (if (>= expr-index (struct-get exprs len))
    false
    (or
      (lower-spmd-reduce-node-writes-id?
        ctx
        name
        (ast.ast-expr-list-get exprs expr-index 0))
      (lower-spmd-reduce-expr-list-writes-id-at?
        ctx
        name
        exprs
        (+ expr-index 1)))))

;; A `let` binding list blocks the split when it rebinds `name` (a `Var name`
;; read inside would no longer mean the outer variable) or when any binding
;; init writes `name`.
(define (lower-spmd-reduce-let-bindings-write-id?
  [ctx : tc_core.TcContext]
  [name : i64]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-spmd-reduce-let-bindings-write-id-at? ctx name (& bindings) 0))

(define (lower-spmd-reduce-let-bindings-write-id-at?
  [ctx : tc_core.TcContext]
  [name : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (or
      (match (ast.ast-let-binding-list-get
        bindings
        binding-index
        (ast.ast-let-binding-fallback))
        [(ast.AstLetBinding.Binding bind-name _ init-box)
          (or
            (= bind-name name)
            (lower-spmd-reduce-node-writes-id? ctx name init-box))])
      (lower-spmd-reduce-let-bindings-write-id-at?
        ctx
        name
        bindings
        (+ binding-index 1)))))

;; Strip `Spanned`/`Ann` wrappers to see the syntactic head of an expression
;; (mirrors the unwrapping in `lower-simple-vector-reduce`).
(define (lower-spmd-reduce-split-unwrap
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : ast.AstExpr
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-spmd-reduce-split-unwrap
        ctx
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-spmd-reduce-split-unwrap
        ctx
        (lower-context-expr-get ctx inner-box))]
    [_ expr]))

;; If `operand` (an expr-pool id) is a plain variable reference that is
;; invariant across the reduction, return its id; otherwise -1. Invariant
;; here means: not the loop index, never `set!` inside the whole value
;; expression, and never rebound by a `let` inside it. A `Var` read is pure,
;; so hoisting it out of the loop is then unobservable.
(define (lower-spmd-reduce-split-uniform-var
  [ctx : tc_core.TcContext]
  [index-id : i64]
  [value : ast.AstExpr]
  [operand : i64]) : i64
  (match (lower-spmd-reduce-split-unwrap
    ctx
    (lower-context-expr-get ctx operand))
    [(ast.AstExpr.Var u-id)
      (if (and
        (not (= u-id index-id))
        (not (lower-spmd-reduce-expr-writes-id? ctx u-id value)))
        u-id
        (- 0 1))]
    [_ (- 0 1)]))

;; Reduction addend split matcher: recognize a scalar `sum` reduce whose value
;; is `(+ X U)` (either operand order) with `U` a reduction-invariant variable
;; and an i64/u64 accumulator whose type matches the loop index type (the exit
;; trip count is computed in the index type, so the split stays within one
;; wrapping integer type). Returns `Split x-id u-id` with the varying addend's
;; expr-pool id and the uniform addend's variable id.
(define (lower-spmd-reduce-split-addend
  [ctx : tc_core.TcContext]
  [op : ast.AstReduceOp]
  [acc-ty : ast.AstType]
  [index-id : i64]
  [index-ty : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeReduceSplit
  (match op
    [(ast.AstReduceOp.Sum)
      (match acc-ty
        [(ast.AstType.I64)
          (lower-spmd-reduce-split-addend-typed
            ctx
            acc-ty
            index-id
            index-ty
            value)]
        [(ast.AstType.U64)
          (lower-spmd-reduce-split-addend-typed
            ctx
            acc-ty
            index-id
            index-ty
            value)]
        [_ (LowerMaybeReduceSplit.No)])]
    [_ (LowerMaybeReduceSplit.No)]))

(define (lower-spmd-reduce-split-addend-typed
  [ctx : tc_core.TcContext]
  [acc-ty : ast.AstType]
  [index-id : i64]
  [index-ty : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeReduceSplit
  (if (not
    (tc_core.tc-type-eq (tc_core.tc-type-without-regions index-ty) acc-ty))
    (LowerMaybeReduceSplit.No)
    (match (lower-spmd-reduce-split-unwrap ctx value)
      [(ast.AstExpr.Binary (ast.AstBinOp.Add) left-box right-box)
        (let
          [left-uniform : i64
            (lower-spmd-reduce-split-uniform-var ctx index-id value left-box)]
          (if (>= left-uniform 0)
            (LowerMaybeReduceSplit.Split right-box left-uniform)
            (let
              [right-uniform : i64
                (lower-spmd-reduce-split-uniform-var
                  ctx
                  index-id
                  value
                  right-box)]
              (if (>= right-uniform 0)
                (LowerMaybeReduceSplit.Split left-box right-uniform)
                (LowerMaybeReduceSplit.No)))))]
      [_ (LowerMaybeReduceSplit.No)])))

;; Scalar `spmd-reduce` loop scaffold: desugar to an accumulator loop and
;; reuse the let/while/set lowering. `acc`/`end`/index are bound once before the
;; loop (so `init`/`end`/`start` evaluate exactly once); an empty range returns
;; `init` without evaluating `acc-update`. `acc`/`end`/temp use lexer-impossible
;; names so they cannot collide with a user binding. The ordered left-to-right
;; fold matches the spec reference semantics.
;;   (spmd-reduce <op> ([i : ty start end]) init value)
;;     === (let [acc : result-ty init] [end' end] [i start]
;;           (begin (while (< i end') (begin <acc-update> (set! i (+ i 1)))) acc))
;; With a `LowerMaybeReduceSplit.Split` plan (a `sum` over `(+ X U)` with a
;; reduction-invariant `U`, see `lower-spmd-reduce-split-addend`) the scaffold
;; additionally binds `start'` and the hoisted uniform addend `u'`, the
;; accumulator update adds only `X`, and the loop tail returns
;; `(+ acc (* (- i start') u'))`:
;;     === (let [acc : result-ty init] [end' end] [start' start] [i start']
;;             [u' U]
;;           (begin
;;             (while (< i end') (begin <acc-update-X> (set! i (+ i 1))))
;;             (+ acc (* (- i start') u'))))
;; Exactness: `i` counts up by one per trip, so `(- i start')` after the loop
;; is the trip count n (0 for an empty range), and over wrapping i64/u64
;; arithmetic `init + Σ_k (X_k + U) == init + Σ_k X_k + n*U` because wrapping
;; `+` and `*` are the mod-2^64 ring operations. `u'` reads `U` once before
;; the loop; that is unobservable because a `Var` read is pure and the split
;; plan guarantees `U` is never written inside the value expression.
(define (lower-spmd-reduce-scaffold
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [_result-ty : ast.AstType]
  [index-id : i64]
  [_index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [init : ast.AstExpr]
  [acc-ty : ast.AstType]
  [acc-update : i64]
  [split : LowerMaybeReduceSplit]) : ResultLowerExpr
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    [loop-id : i64
      (ast.ast-expr-while-with-pools
        pools
        (ast.ast-expr-binary-with-pools
          pools
          (ast.AstBinOp.Lt)
          (ast.ast-node-pool-context-expr-push pools (ast.AstExpr.Var index-id))
          (ast.ast-node-pool-context-expr-push
            pools
            (ast.AstExpr.Var (lower-spmd-reduce-end-id))))
        (ast.ast-node-pool-context-expr-push
          pools
          (ast.AstExpr.Begin
            (ast.ast-expr-cons
              acc-update
              (ast.ast-expr-cons
                (ast.ast-expr-set-id-with-pools
                  pools
                  index-id
                  (ast.ast-expr-binary-with-pools
                    pools
                    (ast.AstBinOp.Add)
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (ast.AstExpr.Var index-id))
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (ast.AstExpr.Literal (ast.ast-lit-int 1)))))
                (ast.ast-expr-list-new))))))]
    [root-id : i64
      (match split
        [(LowerMaybeReduceSplit.Split _ u-id)
          (ast.ast-expr-let-with-pools
            pools
            (ast.ast-let-binding-cons
              (ast.ast-let-binding-id
                (lower-spmd-reduce-acc-id)
                (ast.AstMaybeType.Some acc-ty)
                (ast.ast-node-pool-context-expr-push pools init))
              (ast.ast-let-binding-cons
                (ast.ast-let-binding-id
                  (lower-spmd-reduce-end-id)
                  (ast.AstMaybeType.Some index-ty)
                  (ast.ast-node-pool-context-expr-push pools end))
                (ast.ast-let-binding-cons
                  (ast.ast-let-binding-id
                    (lower-spmd-reduce-start-id)
                    (ast.AstMaybeType.Some index-ty)
                    (ast.ast-node-pool-context-expr-push pools start))
                  (ast.ast-let-binding-cons
                    (ast.ast-let-binding-id
                      index-id
                      (ast.AstMaybeType.Some index-ty)
                      (ast.ast-node-pool-context-expr-push
                        pools
                        (ast.AstExpr.Var (lower-spmd-reduce-start-id))))
                    (ast.ast-let-binding-cons
                      (ast.ast-let-binding-id
                        (lower-spmd-reduce-uniform-id)
                        (ast.AstMaybeType.No)
                        (ast.ast-node-pool-context-expr-push
                          pools
                          (ast.AstExpr.Var u-id)))
                      (ast.ast-let-binding-list-new))))))
            (ast.ast-node-pool-context-expr-push
              pools
              (ast.AstExpr.Begin
                (ast.ast-expr-cons
                  loop-id
                  (ast.ast-expr-cons
                    (ast.ast-expr-binary-with-pools
                      pools
                      (ast.AstBinOp.Add)
                      (ast.ast-node-pool-context-expr-push
                        pools
                        (ast.AstExpr.Var (lower-spmd-reduce-acc-id)))
                      (ast.ast-expr-binary-with-pools
                        pools
                        (ast.AstBinOp.Mul)
                        (ast.ast-expr-binary-with-pools
                          pools
                          (ast.AstBinOp.Sub)
                          (ast.ast-node-pool-context-expr-push
                            pools
                            (ast.AstExpr.Var index-id))
                          (ast.ast-node-pool-context-expr-push
                            pools
                            (ast.AstExpr.Var (lower-spmd-reduce-start-id))))
                        (ast.ast-node-pool-context-expr-push
                          pools
                          (ast.AstExpr.Var (lower-spmd-reduce-uniform-id)))))
                    (ast.ast-expr-list-new))))))]
        [_
          (ast.ast-expr-let-with-pools
            pools
            (ast.ast-let-binding-cons
              (ast.ast-let-binding-id
                (lower-spmd-reduce-acc-id)
                (ast.AstMaybeType.Some acc-ty)
                (ast.ast-node-pool-context-expr-push pools init))
              (ast.ast-let-binding-cons
                (ast.ast-let-binding-id
                  (lower-spmd-reduce-end-id)
                  (ast.AstMaybeType.Some index-ty)
                  (ast.ast-node-pool-context-expr-push pools end))
                (ast.ast-let-binding-cons
                  (ast.ast-let-binding-id
                    index-id
                    (ast.AstMaybeType.Some index-ty)
                    (ast.ast-node-pool-context-expr-push pools start))
                  (ast.ast-let-binding-list-new))))
            (ast.ast-node-pool-context-expr-push
              pools
              (ast.AstExpr.Begin
                (ast.ast-expr-cons
                  loop-id
                  (ast.ast-expr-cons
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (ast.AstExpr.Var (lower-spmd-reduce-acc-id)))
                    (ast.ast-expr-list-new))))))])]
    [root : ast.AstExpr (lower-context-expr-get ctx root-id)]
    (lower-expr ctx state env type-env root)))

;; Scalar lowering for all reduction ops: `sum` (wrapping `+`, also f64
;; ordered add), `all`/`any` (boolean `and`/`or`), and `min`/`max` (ordered
;; select). Each supplies its per-iteration accumulator update to the shared
;; loop scaffold. A `sum` whose value is `(+ X U)` with reduction-invariant
;; `U` takes the addend split (see `lower-spmd-reduce-split-addend`): the loop
;; accumulates only `X` and the scaffold adds `(* trip-count U)` once at the
;; end. The SIMD-mode vector plan, when it applies, is unaffected.
(define (lower-spmd-reduce
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [result-ty : ast.AstType]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [init : ast.AstExpr]
  [value : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-expr
    ctx
    (tc_core.tc-bind-id type-env index-id index-ty)
    value)
    [(tc_core.ResultTcType.Ok value-ty)
      (let
        [acc-ty : ast.AstType (tc_core.tc-type-without-regions value-ty)]
        [split : LowerMaybeReduceSplit
          (lower-spmd-reduce-split-addend ctx op acc-ty index-id index-ty value)]
        [acc-update : i64
          (match split
            [(LowerMaybeReduceSplit.Split x-id _)
              (spmd-reduce-acc-binop-update
                (tc_core.tc-context-pools ctx)
                (ast.AstBinOp.Add)
                x-id)]
            [_
              (spmd-reduce-acc-update-expr
                (tc_core.tc-context-pools ctx)
                op
                (lower-context-expr-push ctx value))])]
        (if (and
          (lower-mode-simd? (lower-state-mode state))
          (lower-type-i64? index-ty))
          (let
            [plan : LowerMaybeVectorReduce
              (lower-simple-vector-reduce
                ctx
                (lower-state-mode state)
                env
                type-env
                op
                index
                acc-ty
                value)]
            (match plan
              [(LowerMaybeVectorReduce.Array _ _ _ _)
                (lower-avx2-spmd-reduce-lowered
                  ctx
                  state
                  env
                  type-env
                  index-ty
                  start
                  end
                  init
                  op
                  plan)]
              [(LowerMaybeVectorReduce.Value _ _ _ _)
                (lower-avx2-spmd-reduce-lowered
                  ctx
                  state
                  env
                  type-env
                  index-ty
                  start
                  end
                  init
                  op
                  plan)]
              [(LowerMaybeVectorReduce.No)
                (lower-spmd-reduce-scaffold
                  ctx
                  state
                  env
                  type-env
                  result-ty
                  index-id
                  index
                  index-ty
                  start
                  end
                  init
                  acc-ty
                  acc-update
                  split)]))
          (lower-spmd-reduce-scaffold
            ctx
            state
            env
            type-env
            result-ty
            index-id
            index
            index-ty
            start
            end
            init
            acc-ty
            acc-update
            split)))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr value message)))]))

(define (spmd-scan-binop-prefix
  [pools : ast.AstNodePoolContext]
  [op : ast.AstBinOp]
  [value : i64]) : i64
  (ast.ast-expr-binary-with-pools
    pools
    op
    (ast.ast-node-pool-context-expr-push
      pools
      (ast.AstExpr.Var (lower-spmd-scan-acc-id)))
    value))

(define (spmd-scan-select-prefix
  [pools : ast.AstNodePoolContext]
  [cmp : ast.AstBinOp]
  [value : i64]) : i64
  (ast.ast-expr-let-with-pools
    pools
    (ast.ast-let-binding-cons
      (ast.ast-let-binding-id
        (lower-spmd-scan-val-id)
        (ast.AstMaybeType.No)
        value)
      (ast.ast-let-binding-list-new))
    (ast.ast-expr-if-with-pools
      pools
      (ast.ast-expr-binary-with-pools
        pools
        cmp
        (ast.ast-node-pool-context-expr-push
          pools
          (ast.AstExpr.Var (lower-spmd-scan-val-id)))
        (ast.ast-node-pool-context-expr-push
          pools
          (ast.AstExpr.Var (lower-spmd-scan-acc-id))))
      (ast.ast-node-pool-context-expr-push
        pools
        (ast.AstExpr.Var (lower-spmd-scan-val-id)))
      (ast.ast-node-pool-context-expr-push
        pools
        (ast.AstExpr.Var (lower-spmd-scan-acc-id))))))

(define (spmd-scan-prefix-expr
  [pools : ast.AstNodePoolContext]
  [op : ast.AstReduceOp]
  [value : i64]) : i64
  (match op
    [(ast.AstReduceOp.Sum)
      (spmd-scan-binop-prefix pools (ast.AstBinOp.Add) value)]
    [(ast.AstReduceOp.All)
      (spmd-scan-binop-prefix pools (ast.AstBinOp.And) value)]
    [(ast.AstReduceOp.Any)
      (spmd-scan-binop-prefix pools (ast.AstBinOp.Or) value)]
    [(ast.AstReduceOp.Min)
      (spmd-scan-select-prefix pools (ast.AstBinOp.Lt) value)]
    [(ast.AstReduceOp.Max)
      (spmd-scan-select-prefix pools (ast.AstBinOp.Gt) value)]))

(define (lower-spmd-scan-scaffold
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [_index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [prefix-id : i64]
  [_prefix : String]
  [prefix-ty : ast.AstType]
  [init : ast.AstExpr]
  [prefix-value : i64]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    (lower-expr
      ctx
      state
      env
      type-env
      (lower-context-expr-get
        ctx
        (ast.ast-expr-let-with-pools
          pools
          (ast.ast-let-binding-cons
            (ast.ast-let-binding-id
              (lower-spmd-scan-acc-id)
              (ast.AstMaybeType.Some prefix-ty)
              (ast.ast-node-pool-context-expr-push pools init))
            (ast.ast-let-binding-cons
              (ast.ast-let-binding-id
                (lower-spmd-scan-end-id)
                (ast.AstMaybeType.Some index-ty)
                (ast.ast-node-pool-context-expr-push pools end))
              (ast.ast-let-binding-cons
                (ast.ast-let-binding-id
                  index-id
                  (ast.AstMaybeType.Some index-ty)
                  (ast.ast-node-pool-context-expr-push pools start))
                (ast.ast-let-binding-list-new))))
          (ast.ast-node-pool-context-expr-push
            pools
            (ast.AstExpr.Begin
              (ast.ast-expr-cons
                (ast.ast-expr-while-with-pools
                  pools
                  (ast.ast-expr-binary-with-pools
                    pools
                    (ast.AstBinOp.Lt)
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (ast.AstExpr.Var index-id))
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (ast.AstExpr.Var (lower-spmd-scan-end-id))))
                  (ast.ast-expr-let-with-pools
                    pools
                    (ast.ast-let-binding-cons
                      (ast.ast-let-binding-id
                        prefix-id
                        (ast.AstMaybeType.Some prefix-ty)
                        prefix-value)
                      (ast.ast-let-binding-list-new))
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (ast.AstExpr.Begin
                        (ast.ast-expr-cons
                          (ast.ast-expr-set-id-with-pools
                            pools
                            (lower-spmd-scan-acc-id)
                            (ast.ast-node-pool-context-expr-push
                              pools
                              (ast.AstExpr.Var prefix-id)))
                          (ast.ast-expr-cons
                            (ast.ast-node-pool-context-expr-push pools body)
                            (ast.ast-expr-cons
                              (ast.ast-expr-set-id-with-pools
                                pools
                                index-id
                                (ast.ast-expr-binary-with-pools
                                  pools
                                  (ast.AstBinOp.Add)
                                  (ast.ast-node-pool-context-expr-push
                                    pools
                                    (ast.AstExpr.Var index-id))
                                  (ast.ast-node-pool-context-expr-push
                                    pools
                                    (ast.AstExpr.Literal (ast.ast-lit-int 1)))))
                              (ast.ast-expr-list-new))))))))
                (ast.ast-expr-list-new)))))))))

(define (lower-spmd-scan
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [prefix-id : i64]
  [prefix : String]
  [prefix-ty : ast.AstType]
  [init : ast.AstExpr]
  [value : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [scalar-prefix : i64
      (spmd-scan-prefix-expr
        (tc_core.tc-context-pools ctx)
        op
        (lower-context-expr-push ctx value))]
    [vector-plan : LowerMaybeVectorScan
      (lower-simple-vector-scan
        ctx
        (lower-state-mode state)
        env
        type-env
        op
        index
        prefix
        prefix-ty
        value
        body)]
    (if (and
      (lower-mode-simd? (lower-state-mode state))
      (lower-type-i64? index-ty))
      (match vector-plan
        [(LowerMaybeVectorScan.Scan _ _ _ _ _)
          (lower-simd-spmd-scan-lowered
            ctx
            state
            env
            type-env
            op
            index-id
            index-ty
            start
            end
            prefix-id
            prefix-ty
            init
            value
            body
            vector-plan)]
        [(LowerMaybeVectorScan.No)
          (lower-spmd-scan-scaffold
            ctx
            state
            env
            type-env
            index-id
            index
            index-ty
            start
            end
            prefix-id
            prefix
            prefix-ty
            init
            scalar-prefix
            body)])
      (lower-spmd-scan-scaffold
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start
        end
        prefix-id
        prefix
        prefix-ty
        init
        scalar-prefix
        body))))

(define (lower-spmd-broadcast
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ast.AstExpr]
  [lane : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    state
    env
    type-env
    lane
    (ast.AstType.I64)
    lane)
    [(ResultLowerExpr.Ok lane-lowered)
      (match lane-lowered
        [(LowerExpr.Expr lane-state lane-value _)
          (lower-expr
            ctx
            (lower-emit-spmd-broadcast-lane-check
              lane-state
              lane-value
              (ir.CompilerIrValue.I64 1))
            env
            type-env
            value)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-spmd-shuffle-diagnostic) : String
  "lower: SPMD spmd-shuffle requires scalar backend until SIMD shuffle lowering lands")

(define (lower-spmd-shuffle
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ast.AstExpr]
  [lane : ast.AstExpr]) : ResultLowerExpr
  (if (lower-mode-simd? (lower-state-mode state))
    (ResultLowerExpr.Err
      (box (lower-diagnostic (lower-spmd-shuffle-diagnostic))))
    (match (lower-expr-expected
      ctx
      state
      env
      type-env
      lane
      (ast.AstType.I64)
      lane)
      [(ResultLowerExpr.Ok lane-lowered)
        (match lane-lowered
          [(LowerExpr.Expr lane-state lane-value _)
            (lower-expr
              ctx
              (lower-emit-spmd-broadcast-lane-check
                lane-state
                lane-value
                (ir.CompilerIrValue.I64 1))
              env
              type-env
              value)])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-mode-simd? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.Avx2) true]
    [(CompilerLowerMode.LinuxAvx2) true]
    [(CompilerLowerMode.WindowsAvx2) true]
    [(CompilerLowerMode.Avx512) true]
    [(CompilerLowerMode.LinuxAvx512) true]
    [(CompilerLowerMode.WindowsAvx512) true]
    [_ false]))

(define (lower-mode-avx2? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.Avx2) true]
    [(CompilerLowerMode.LinuxAvx2) true]
    [(CompilerLowerMode.WindowsAvx2) true]
    [_ false]))

(define (lower-mode-avx512? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.Avx512) true]
    [(CompilerLowerMode.LinuxAvx512) true]
    [(CompilerLowerMode.WindowsAvx512) true]
    [_ false]))

(define (lower-avx2-masked-if-diagnostic) : String
  "lower: SPMD masked if is not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-avx2-varying-while-diagnostic) : String
  "lower: SPMD varying while is not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-simd-foreach-fallback-diagnostic) : String
  "lower: SPMD foreach does not match a SIMD lowering pattern for this backend mode; use scalar or a contiguous map/zip body with supported array and uniform operands")

(define (lower-mode-inline-aggregates? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.Scalar) true]
    [(CompilerLowerMode.LinuxScalar) true]
    [(CompilerLowerMode.WindowsScalar) true]
    [(CompilerLowerMode.Avx2) true]
    [(CompilerLowerMode.LinuxAvx2) true]
    [(CompilerLowerMode.WindowsAvx2) true]
    [(CompilerLowerMode.Avx512) true]
    [(CompilerLowerMode.LinuxAvx512) true]
    [(CompilerLowerMode.WindowsAvx512) true]
    [(CompilerLowerMode.InlineAggregates) true]
    [_ false]))

(define (lower-mode-linux-c-abi? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.LinuxScalar) true]
    [(CompilerLowerMode.LinuxAvx2) true]
    [(CompilerLowerMode.LinuxAvx512) true]
    [_ false]))

(define (lower-mode-windows-c-abi? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.WindowsScalar) true]
    [(CompilerLowerMode.WindowsAvx2) true]
    [(CompilerLowerMode.WindowsAvx512) true]
    [_ false]))

(define (lower-mode-c-abi? [mode : CompilerLowerMode]) : bool
  (or (lower-mode-linux-c-abi? mode) (lower-mode-windows-c-abi? mode)))

(define (lower-type-i64? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(ast.AstType.I64) true]
    [_ false]))

(define (lower-type-bool? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(ast.AstType.Bool) true]
    [_ false]))

(define (lower-avx512-bool-lanes [mode : CompilerLowerMode]) : i64
  (if (lower-mode-avx512? mode)
    64
    (if (lower-mode-avx2? mode)
      32
      0)))

(define (lower-simd-lanes-for-elem
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : i64
  (match mode
    [(CompilerLowerMode.Avx2)
      (match (tc_core.tc-type-without-regions ty)
        [(ast.AstType.I64) 4]
        [(ast.AstType.U64) 4]
        [(ast.AstType.F64) 4]
        [(ast.AstType.F32) 8]
        [(ast.AstType.I32) 8]
        [(ast.AstType.U32) 8]
        [(ast.AstType.I16) 16]
        [(ast.AstType.U16) 16]
        [(ast.AstType.I8) 32]
        [(ast.AstType.U8) 32]
        [_ 0])]
    [(CompilerLowerMode.LinuxAvx2)
      (match (tc_core.tc-type-without-regions ty)
        [(ast.AstType.I64) 4]
        [(ast.AstType.U64) 4]
        [(ast.AstType.F64) 4]
        [(ast.AstType.F32) 8]
        [(ast.AstType.I32) 8]
        [(ast.AstType.U32) 8]
        [(ast.AstType.I16) 16]
        [(ast.AstType.U16) 16]
        [(ast.AstType.I8) 32]
        [(ast.AstType.U8) 32]
        [_ 0])]
    [(CompilerLowerMode.WindowsAvx2)
      (match (tc_core.tc-type-without-regions ty)
        [(ast.AstType.I64) 4]
        [(ast.AstType.U64) 4]
        [(ast.AstType.F64) 4]
        [(ast.AstType.F32) 8]
        [(ast.AstType.I32) 8]
        [(ast.AstType.U32) 8]
        [(ast.AstType.I16) 16]
        [(ast.AstType.U16) 16]
        [(ast.AstType.I8) 32]
        [(ast.AstType.U8) 32]
        [_ 0])]
    [(CompilerLowerMode.Avx512)
      (match (tc_core.tc-type-without-regions ty)
        [(ast.AstType.I64) 8]
        [(ast.AstType.U64) 8]
        [(ast.AstType.F64) 8]
        [(ast.AstType.F32) 16]
        [(ast.AstType.I32) 16]
        [(ast.AstType.U32) 16]
        [(ast.AstType.I16) 32]
        [(ast.AstType.U16) 32]
        [(ast.AstType.I8) 64]
        [(ast.AstType.U8) 64]
        [_ 0])]
    [(CompilerLowerMode.LinuxAvx512)
      (match (tc_core.tc-type-without-regions ty)
        [(ast.AstType.I64) 8]
        [(ast.AstType.U64) 8]
        [(ast.AstType.F64) 8]
        [(ast.AstType.F32) 16]
        [(ast.AstType.I32) 16]
        [(ast.AstType.U32) 16]
        [(ast.AstType.I16) 32]
        [(ast.AstType.U16) 32]
        [(ast.AstType.I8) 64]
        [(ast.AstType.U8) 64]
        [_ 0])]
    [(CompilerLowerMode.WindowsAvx512)
      (match (tc_core.tc-type-without-regions ty)
        [(ast.AstType.I64) 8]
        [(ast.AstType.U64) 8]
        [(ast.AstType.F64) 8]
        [(ast.AstType.F32) 16]
        [(ast.AstType.I32) 16]
        [(ast.AstType.U32) 16]
        [(ast.AstType.I16) 32]
        [(ast.AstType.U16) 32]
        [(ast.AstType.I8) 64]
        [(ast.AstType.U8) 64]
        [_ 0])]
    [_ 0]))

(define (lower-expr-is-var?
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]
  [name : String]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-is-var? ctx inner name))]
    [(ast.AstExpr.Var found)
      (string.eq (tc_core.tc-env-key-name-text found) name)]
    [_ false]))

(define (lower-expr-is-program-index?
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-expr-is-program-index? ctx (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-expr-is-program-index? ctx (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.SpmdProgramIndex) true]
    [_ false]))

(define (lower-dynamic-array-var
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : LowerMaybeArrayVar
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-dynamic-array-var ctx env type-env inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-dynamic-array-var ctx env type-env inner))]
    [(ast.AstExpr.Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? var-id)
          (match (tc_core.tc-lookup-id type-env name)
            [(tc_core.ResultTcType.Ok ty)
              (match (tc_core.tc-type-strip-region ty)
                [(ast.AstType.DynArray elem-ty)
                  (LowerMaybeArrayVar.Some
                    var-id
                    (tc_core.tc-type-without-regions
                      (tc_core.tc-context-type-get ctx elem-ty)))]
                [(ast.AstType.Ref _ referent-ty)
                  (match (tc_core.tc-type-strip-region
                    (tc_core.tc-context-type-get ctx referent-ty))
                    [(ast.AstType.DynArray elem-ty)
                      (LowerMaybeArrayVar.Some
                        var-id
                        (tc_core.tc-type-without-regions
                          (tc_core.tc-context-type-get ctx elem-ty)))]
                    ;; Slice references use the same two-word data/length
                    ;; descriptor consumed by contiguous SPMD load plans.
                    [(ast.AstType.Slice elem-ty)
                      (LowerMaybeArrayVar.Some
                        var-id
                        (tc_core.tc-type-without-regions
                          (tc_core.tc-context-type-get ctx elem-ty)))]
                    [_ (LowerMaybeArrayVar.No)])]
                [(ast.AstType.MutRef _ referent-ty)
                  (match (tc_core.tc-type-strip-region
                    (tc_core.tc-context-type-get ctx referent-ty))
                    [(ast.AstType.DynArray elem-ty)
                      (LowerMaybeArrayVar.Some
                        var-id
                        (tc_core.tc-type-without-regions
                          (tc_core.tc-context-type-get ctx elem-ty)))]
                    [(ast.AstType.Slice elem-ty)
                      (LowerMaybeArrayVar.Some
                        var-id
                        (tc_core.tc-type-without-regions
                          (tc_core.tc-context-type-get ctx elem-ty)))]
                    [_ (LowerMaybeArrayVar.No)])]
                [_ (LowerMaybeArrayVar.No)])]
            [(tc_core.ResultTcType.Err _) (LowerMaybeArrayVar.No)])
          (LowerMaybeArrayVar.No)))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-array-ref-var-for-index
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [index : String]) : LowerMaybeArrayVar
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-array-ref-var-for-index ctx env type-env inner index))]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (if (lower-expr-is-var? ctx idx index)
          (lower-dynamic-array-var ctx env type-env arr)
          (LowerMaybeArrayVar.No)))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-array-ref-var-for-program-index
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : LowerMaybeArrayVar
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-array-ref-var-for-program-index
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (if (lower-expr-is-program-index? ctx idx)
          (lower-dynamic-array-var ctx env type-env arr)
          (LowerMaybeArrayVar.No)))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-simple-spmd-broadcast-lane
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : LowerMaybeIrValue
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-spmd-broadcast-lane ctx env type-env inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-spmd-broadcast-lane ctx env type-env inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-spmd-broadcast-lane ctx env type-env inner))]
    [(ast.AstExpr.Literal (ast.AstLiteral.Int n _))
      (LowerMaybeIrValue.Some (ir.CompilerIrValue.I64 n))]
    [(ast.AstExpr.Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? var-id)
          (match (tc_core.tc-lookup-id type-env name)
            [(tc_core.ResultTcType.Ok ty)
              (if (tc_core.tc-type-eq
                (tc_core.tc-type-without-regions ty)
                (ast.AstType.I64))
                (LowerMaybeIrValue.Some (ir.CompilerIrValue.Var var-id))
                (LowerMaybeIrValue.No))]
            [(tc_core.ResultTcType.Err _) (LowerMaybeIrValue.No)])
          (LowerMaybeIrValue.No)))]
    [_ (LowerMaybeIrValue.No)]))

(define (lower-array-var-set-empty) : LowerArrayVarSet
  (LowerArrayVarSet (make-array i64 0) (make-array i64 0) 0))

(define (lower-array-var-set-add
  [set : LowerArrayVarSet]
  [var : i64]
  [offset : i64]) : LowerArrayVarSet
  (let
    [vars : (__tl_dyn-array i64) (struct-get set vars)]
    [offsets : (__tl_dyn-array i64) (struct-get set offsets)]
    [count : i64 (struct-get set count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (if (= (array-ref vars index) var)
          (begin
            (if (> offset (array-ref offsets index))
              (array-set! offsets index offset)
              unit)
            (set! found true))
          (set! index (+ index 1))))
      (if found
        (LowerArrayVarSet vars offsets count)
        (begin
          (array-push! vars var)
          (array-push! offsets offset)
          (LowerArrayVarSet vars offsets (+ count 1)))))))

(define (lower-array-var-set-merge
  [left : LowerArrayVarSet]
  [right : LowerArrayVarSet]) : LowerArrayVarSet
  (let
    [vars : (__tl_dyn-array i64) (struct-get right vars)]
    [offsets : (__tl_dyn-array i64) (struct-get right offsets)]
    [count : i64 (struct-get right count)]
    [index : i64 0]
    [out : LowerArrayVarSet left]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (lower-array-var-set-add
              out
              (array-ref vars index)
              (array-ref offsets index)))
          (set! index (+ index 1))))
      out)))

(define (lower-array-var-set-max-offset [set : LowerArrayVarSet]) : i64
  (let
    [offsets : (__tl_dyn-array i64) (struct-get set offsets)]
    [count : i64 (struct-get set count)]
    [index : i64 0]
    [max-offset : i64 0]
    (begin
      (while (< index count)
        (let
          [offset : i64 (array-ref offsets index)]
          (begin
            (if (> offset max-offset)
              (set! max-offset offset)
              unit)
            (set! index (+ index 1)))))
      max-offset)))

(define (lower-masked-vector-index-literal-offset
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-literal-offset ctx inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-literal-offset ctx inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-literal-offset ctx inner))]
    [(ast.AstExpr.Literal (ast.AstLiteral.Int n _))
      (if (>= n 0)
        n
        -1)]
    [_ -1]))

(define (lower-masked-vector-positive-power-two-literal
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-positive-power-two-literal ctx inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-positive-power-two-literal ctx inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-positive-power-two-literal ctx inner))]
    [(ast.AstExpr.Literal (ast.AstLiteral.Int n _))
      (if (> n 0)
        (if (= (bit-and n (- n 1)) 0)
          n
          -1)
        -1)]
    [_ -1]))

(define (lower-masked-vector-index-offset
  [ctx : tc_core.TcContext]
  [index : String]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-offset ctx index inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-offset ctx index inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-offset ctx index inner))]
    [(ast.AstExpr.Var name)
      (if (string.eq (tc_core.tc-env-key-name-text name) index)
        0
        -1)]
    [(ast.AstExpr.Binary op left-box right-box)
      (match op
        [(ast.AstBinOp.Add)
          (let
            [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
            [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
            [left-offset : i64
              (lower-masked-vector-index-offset ctx index left)]
            [right-offset : i64
              (lower-masked-vector-index-offset ctx index right)]
            (if (= left-offset 0)
              (lower-masked-vector-index-literal-offset ctx right)
              (if (= right-offset 0)
                (lower-masked-vector-index-literal-offset ctx left)
                -1)))]
        [_ -1])]
    [_ -1]))

(define (lower-masked-vector-lanes-merge [left : i64] [right : i64]) : i64
  (cond
    [(< left 0) -1]
    [(< right 0) -1]
    [(= left 0) right]
    [(= right 0) left]
    [(= left right) left]
    [else -1]))

(define (lower-masked-vector-binop-supported? [op : ast.AstBinOp]) : bool
  (match op
    [(ast.AstBinOp.Add) true]
    [(ast.AstBinOp.Sub) true]
    [(ast.AstBinOp.Mod) true]
    [(ast.AstBinOp.BitAnd) true]
    [(ast.AstBinOp.BitOr) true]
    [(ast.AstBinOp.BitXor) true]
    [(ast.AstBinOp.Shl) true]
    [(ast.AstBinOp.Shr) true]
    [(ast.AstBinOp.Eq) true]
    [(ast.AstBinOp.Ne) true]
    [(ast.AstBinOp.Lt) true]
    [(ast.AstBinOp.Le) true]
    [(ast.AstBinOp.Gt) true]
    [(ast.AstBinOp.Ge) true]
    [(ast.AstBinOp.And) true]
    [(ast.AstBinOp.Or) true]
    [_ false]))

(define (lower-masked-vector-unop-supported? [op : ast.AstUnOp]) : bool
  (match op
    [(ast.AstUnOp.Not) true]
    [_ false]))

(define (lower-masked-vector-empty-lane-locals) : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 16))

(define (lower-masked-vector-lane-locals-from-set
  [items : LowerIdSet]
  [lanes : i64]) : lower_i64_i64_map.Map
  (let
    [out : lower_i64_i64_map.Map (lower-masked-vector-empty-lane-locals)]
    [index : i64 (struct-get items len)]
    (begin
      (while (> index 0)
        (begin
          (set! index (- index 1))
          (lower_i64_i64_map.insert-ref!
            (&mut out)
            (array-ref (struct-get items slots) index)
            lanes)))
      out)))

(define (lower-masked-vector-lane-locals-bind-if-varying
  [lane-locals : lower_i64_i64_map.Map (:consume)]
  [name : i64]
  [lanes : i64]) : lower_i64_i64_map.Map
  (if (> lanes 0)
    (begin
      (lower_i64_i64_map.insert-ref! (&mut lane-locals) name lanes)
      lane-locals)
    lane-locals))

(define (lower-masked-vector-expr-list-lanes-with-locals
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : ast.AstExprList]) : i64
  (lower-masked-vector-expr-list-lanes-with-locals-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-lanes-with-locals-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : i64
  (if (>= expr-index (struct-get exprs len))
    0
    (let
      [expr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0))]
      (lower-masked-vector-lanes-merge
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          expr)
        (lower-masked-vector-expr-list-lanes-with-locals-at
          ctx
          mode
          env
          type-env
          index
          lane-locals
          exprs
          (+ expr-index 1))))))

(define (lower-masked-vector-let-bindings-locals
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : ast.AstLetBindingList]) : lower_i64_i64_map.Map
  (lower-masked-vector-let-bindings-locals-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-locals-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : lower_i64_i64_map.Map
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    lane-locals
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [init-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              init)]
          [next-locals : lower_i64_i64_map.Map
            (lower-masked-vector-lane-locals-bind-if-varying
              lane-locals
              name
              init-lanes)]
          (lower-masked-vector-let-bindings-locals-at
            ctx
            mode
            env
            type-env
            index
            next-locals
            bindings
            (+ binding-index 1)))])))

(define (lower-masked-vector-let-bindings-lanes-with-locals
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : ast.AstLetBindingList]) : i64
  (lower-masked-vector-let-bindings-lanes-with-locals-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-lanes-with-locals-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : i64
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    0
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [init-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              init)]
          [next-locals : lower_i64_i64_map.Map
            (lower-masked-vector-lane-locals-bind-if-varying
              lane-locals
              name
              init-lanes)]
          (lower-masked-vector-lanes-merge
            init-lanes
            (lower-masked-vector-let-bindings-lanes-with-locals-at
              ctx
              mode
              env
              type-env
              index
              next-locals
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-pattern-locals
  [pattern : ast.AstPattern]
  [scrut-lanes : i64]
  [lane-locals : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (if (> scrut-lanes 0)
    (match pattern
      [(ast.AstPattern.Var name _)
        (lower-masked-vector-lane-locals-bind-if-varying
          lane-locals
          name
          scrut-lanes)]
      [(ast.AstPattern.Tuple patterns-box)
        (lower-masked-vector-pattern-list-locals
          (box-get patterns-box)
          scrut-lanes
          lane-locals)]
      [(ast.AstPattern.Array patterns-box)
        (lower-masked-vector-pattern-list-locals
          (box-get patterns-box)
          scrut-lanes
          lane-locals)]
      [(ast.AstPattern.Binding name)
        (lower-masked-vector-lane-locals-bind-if-varying
          lane-locals
          name
          scrut-lanes)]
      [(ast.AstPattern.Variant _ patterns-box)
        (lower-masked-vector-pattern-list-locals
          (box-get patterns-box)
          scrut-lanes
          lane-locals)]
      [_ lane-locals])
    lane-locals))

(define (lower-masked-vector-pattern-list-locals
  [patterns : ast.AstPatternList]
  [scrut-lanes : i64]
  [lane-locals : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (lower-masked-vector-pattern-list-locals-at
    (& patterns)
    scrut-lanes
    lane-locals
    0))

(define (lower-masked-vector-pattern-list-locals-at
  [patterns : (& patterns ast.AstPatternList)]
  [scrut-lanes : i64]
  [lane-locals : lower_i64_i64_map.Map]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get patterns len))
    lane-locals
    (lower-masked-vector-pattern-list-locals-at
      patterns
      scrut-lanes
      (lower-masked-vector-pattern-locals
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
        scrut-lanes
        lane-locals)
      (+ index 1))))

(define (lower-masked-vector-match-arms-lanes-with-locals
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [scrut-lanes : i64]
  [arms : ast.AstMatchArmList]) : i64
  (lower-masked-vector-match-arms-lanes-with-locals-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    scrut-lanes
    (& arms)
    0))

(define (lower-masked-vector-match-arms-lanes-with-locals-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [scrut-lanes : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [arm-index : i64]) : i64
  (if (>= arm-index (struct-get arms len))
    0
    (match (ast.ast-match-arm-list-get
      arms
      arm-index
      (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
          [body-locals : lower_i64_i64_map.Map
            (lower-masked-vector-pattern-locals pattern scrut-lanes lane-locals)]
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              body-locals
              body)
            (lower-masked-vector-match-arms-lanes-with-locals-at
              ctx
              mode
              env
              type-env
              index
              lane-locals
              scrut-lanes
              arms
              (+ arm-index 1))))])))

(define (lower-spmd-call-args-lanes
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [args : ast.AstExprList]) : i64
  (lower-spmd-call-args-lanes-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& args)
    0))

(define (lower-spmd-call-args-lanes-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]) : i64
  (if (>= arg-index (struct-get args len))
    0
    (lower-masked-vector-lanes-merge
      (lower-masked-vector-expr-lanes-with-locals
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx (ast.ast-expr-list-get args arg-index 0)))
      (lower-spmd-call-args-lanes-at
        ctx
        mode
        env
        type-env
        index
        lane-locals
        args
        (+ arg-index 1)))))

(define (lower-spmd-helper-param-locals
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [caller-locals : lower_i64_i64_map.Map]
  [params : ast.AstParamList]
  [args : ast.AstExprList]) : lower_i64_i64_map.Map
  (lower-spmd-helper-param-locals-at
    ctx
    mode
    env
    type-env
    index
    caller-locals
    (& params)
    (& args)
    0
    (lower-masked-vector-empty-lane-locals)))

(define (lower-spmd-helper-param-locals-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [caller-locals : lower_i64_i64_map.Map]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]
  [out : lower_i64_i64_map.Map (:consume)]) : lower_i64_i64_map.Map
  (if (or
    (>= arg-index (ast.ast-param-list-len params))
    (>= arg-index (struct-get args len)))
    out
    (match (ast.ast-param-list-get params arg-index (ast.ast-param-fallback))
      [(ast.AstParam.Param name _ _ _)
        (let
          [arg-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              caller-locals
              (lower-context-expr-get
                ctx
                (ast.ast-expr-list-get args arg-index 0)))]
          (lower-spmd-helper-param-locals-at
            ctx
            mode
            env
            type-env
            index
            caller-locals
            params
            args
            (+ arg-index 1)
            (lower-masked-vector-lane-locals-bind-if-varying out name arg-lanes)))])))

(define (lower-imported-spmd-source-args-code-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]) : String
  (if (>= arg-index (struct-get args len))
    ""
    (let
      [arg-lanes : i64
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx (ast.ast-expr-list-get args arg-index 0)))]
      (str_cat.str-cat
        (cond [(> arg-lanes 0) "v"] [(= arg-lanes 0) "u"] [else "?"])
        (lower-imported-spmd-source-args-code-at
          ctx
          mode
          env
          type-env
          index
          lane-locals
          args
          (+ arg-index 1))))))

(define (lower-imported-spmd-direct-call-result-lanes
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [canonical-name : i64]
  [fn-ty : ast.AstType]
  [callables : ast.AstImportedSpmdCallableList]) : i64
  (match fn-ty
    [(ast.AstType.Func param-types ret-id)
      (let
        [params : ast.AstParamList
          (lower-imported-spmd-params ctx (box-get param-types))]
        [ret : ast.AstType (tc_core.tc-context-type-get ctx ret-id)]
        [arg-lanes : i64
          (lower-spmd-call-args-lanes
            ctx
            mode
            env
            type-env
            index
            lane-locals
            args)]
        [backend : ir.CompilerIrSpmdBackend
          (cond
            [(lower-mode-avx512? mode) (ir.CompilerIrSpmdBackend.Avx512)]
            [(lower-mode-avx2? mode) (ir.CompilerIrSpmdBackend.Avx2)]
            [else (ir.CompilerIrSpmdBackend.Scalar)])]
        [lanes : i64
          (match backend
            [(ir.CompilerIrSpmdBackend.Scalar) 1]
            [_ arg-lanes])]
        [args-code : String
          (lower-imported-spmd-source-args-code-at
            ctx
            mode
            env
            type-env
            index
            lane-locals
            (& args)
            0)]
        [unknown-arg-code : String "?"]
        (cond
          [(= arg-lanes 0) 0]
          [(or
              (< arg-lanes 0)
              (string.contains (& args-code) (& unknown-arg-code)))
            -1]
          [else
            (match (lower-imported-spmd-select
              canonical-name
              (& callables)
              (lower-spmd-source-signature params ret)
              backend
              lanes
              args-code
              (lower-imported-spmd-index-param ctx index args)
              ret
              func)
              [(ResultLowerImportedSpmdSpecialization.Err _) -1]
              [(ResultLowerImportedSpmdSpecialization.Ok specialization)
                (if (or
                  (tc_core.tc-type-eq
                    (tc_core.tc-type-without-regions ret)
                    (ast.AstType.Unit))
                  (lower-imported-spmd-result-varying? specialization))
                  arg-lanes
                  0)])]))]
    [_ -1]))

(define (lower-spmd-direct-call-result-lanes
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : i64
  (match (ast.ast-expr-unspan-with-pools (tc_core.tc-context-pools ctx) func)
    [(ast.AstExpr.Var raw-name)
      (if (sym_i64_env.sym-i64-contains-id env raw-name)
        -1
        (match (lower-spmd-inline-helper-lookup
          ctx
          env
          type-env
          (lower-id-set-empty)
          func)
          [(ResultLowerSpmdInlineHelper.Ok helper)
            (match helper
              [(LowerSpmdInlineHelper.Some name params _ body)
                (let
                  [arg-lanes : i64
                    (lower-spmd-call-args-lanes
                      ctx
                      mode
                      env
                      type-env
                      index
                      lane-locals
                      args)]
                  (if (< arg-lanes 0)
                    -1
                    (let
                      [previous : LowerIdSet
                        (lower-global-shared-view
                          lower-spmd-inline-helper-stack)]
                      [result : i64 -1]
                      (begin
                        (set!
                          lower-spmd-inline-helper-stack
                          (lower-id-set-insert previous name))
                        (set!
                          result
                          (lower-masked-vector-expr-lanes-with-locals
                            ctx
                            mode
                            env
                            type-env
                            ""
                            (lower-spmd-helper-param-locals
                              ctx
                              mode
                              env
                              type-env
                              index
                              lane-locals
                              params
                              args)
                            body))
                        (set! lower-spmd-inline-helper-stack previous)
                        (if (< result 0)
                          arg-lanes
                          result)))))]
              [(LowerSpmdInlineHelper.Imported canonical-name fn-ty callables)
                (lower-imported-spmd-direct-call-result-lanes
                  ctx
                  mode
                  env
                  type-env
                  index
                  lane-locals
                  func
                  args
                  canonical-name
                  fn-ty
                  (box-get callables))]
              [(LowerSpmdInlineHelper.No) -1])]
          [(ResultLowerSpmdInlineHelper.Err _) -1]))]
    [_ -1]))

(define (lower-masked-vector-expr-lanes-with-locals
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(ast.AstExpr.Literal _) 0]
    [(ast.AstExpr.Var name)
      (let
        [name-text : String (tc_core.tc-env-key-name-text name)]
        (match (lower_i64_i64_map.get (& lane-locals) name)
          [(lower_i64_i64_map.LookupFound lanes) lanes]
          [(lower_i64_i64_map.LookupMissing)
            (if (string.eq name-text index)
              (lower-simd-lanes-for-elem mode (ast.AstType.I64))
              0)]))]
    [(ast.AstExpr.Unary op inner-box)
      (if (lower-masked-vector-unop-supported? op)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            inner))
        -1)]
    [(ast.AstExpr.Binary op left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        [operand-lanes : i64
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              left)
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              right))]
        ;; The masked-lane census records widths, not scalar types. Admit the
        ;; widths whose integer/float multiply opcodes already exist; a
        ;; width-neutral expression inherits the enclosing array lane width.
        [vector-mul-width : bool
          (and
            (match op
              [(ast.AstBinOp.Mul) true]
              [_ false])
            (or
              (= operand-lanes 0)
              (=
                operand-lanes
                (lower-simd-lanes-for-elem mode (ast.AstType.I64)))
              (=
                operand-lanes
                (lower-simd-lanes-for-elem mode (ast.AstType.I32)))
              (=
                operand-lanes
                (lower-simd-lanes-for-elem mode (ast.AstType.I16)))))]
        (if (or (lower-masked-vector-binop-supported? op) vector-mul-width)
          operand-lanes
          -1))]
    [(ast.AstExpr.Call func-box args)
      (lower-spmd-direct-call-result-lanes
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx func-box)
        args)]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            [body-locals : lower_i64_i64_map.Map
              (lower-masked-vector-let-bindings-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)]
            (lower-masked-vector-lanes-merge
              (lower-masked-vector-let-bindings-lanes-with-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                mode
                env
                type-env
                index
                body-locals
                body)))])]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            cond)
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              then-branch)
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              else-branch))))]
    [(ast.AstExpr.While cond-box body-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            cond)
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            body)))]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            [scrut-lanes : i64
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                scrutinee)]
            (lower-masked-vector-lanes-merge
              scrut-lanes
              (lower-masked-vector-match-arms-lanes-with-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                scrut-lanes
                arms)))])]
    [(ast.AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-lanes-with-locals
        ctx
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (if (>= (lower-masked-vector-index-offset ctx index idx) 0)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some _ elem-ty)
              (if (lower-type-bool? elem-ty)
                (lower-avx512-bool-lanes mode)
                (lower-simd-lanes-for-elem mode elem-ty))]
            [(LowerMaybeArrayVar.No) -1])
          -1))]
    [(ast.AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (if (>= (lower-masked-vector-index-offset ctx index idx) 0)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some _ elem-ty)
              (if (lower-type-bool? elem-ty)
                (let
                  [value-lanes : i64
                    (lower-masked-vector-expr-lanes-with-locals
                      ctx
                      mode
                      env
                      type-env
                      index
                      lane-locals
                      value)]
                  (if (< value-lanes 0)
                    -1
                    (if (= value-lanes 0)
                      (lower-avx512-bool-lanes mode)
                      value-lanes)))
                (lower-masked-vector-lanes-merge
                  (lower-simd-lanes-for-elem mode elem-ty)
                  (lower-masked-vector-expr-lanes-with-locals
                    ctx
                    mode
                    env
                    type-env
                    index
                    lane-locals
                    value)))]
            [(LowerMaybeArrayVar.No) -1])
          -1))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            receiver)
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            value)))]
    [_ -1]))

(define (lower-masked-vector-expr-lanes
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [expr : ast.AstExpr]) : i64
  (lower-masked-vector-expr-lanes-with-locals
    ctx
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    expr))

(define (lower-masked-vector-body-has-varying-if-with-locals?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (if (>
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            cond)
          0)
          true
          (or
            (lower-masked-vector-body-has-varying-if-with-locals?
              ctx
              mode
              env
              type-env
              index
              lane-locals
              then-branch)
            (lower-masked-vector-body-has-varying-if-with-locals?
              ctx
              mode
              env
              type-env
              index
              lane-locals
              else-branch))))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            [body-locals : lower_i64_i64_map.Map
              (lower-masked-vector-let-bindings-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)]
            (or
              (lower-masked-vector-let-bindings-have-varying-if-with-locals?
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (lower-masked-vector-body-has-varying-if-with-locals?
                ctx
                mode
                env
                type-env
                index
                body-locals
                body)))])]
    [(ast.AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-varying-if-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            left)
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            right)))]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            arr)
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            idx)))]
    [(ast.AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            arr)
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            idx)
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            value)))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            receiver)
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            value)))]
    [_ false]))

(define (lower-masked-vector-expr-list-has-varying-if-with-locals?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : ast.AstExprList]) : bool
  (lower-masked-vector-expr-list-has-varying-if-with-locals-at?
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-has-varying-if-with-locals-at?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : bool
  (if (>= expr-index (struct-get exprs len))
    false
    (or
      (lower-masked-vector-body-has-varying-if-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      (lower-masked-vector-expr-list-has-varying-if-with-locals-at?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        exprs
        (+ expr-index 1)))))

(define (lower-masked-vector-let-bindings-have-varying-if-with-locals?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-masked-vector-let-bindings-have-varying-if-with-locals-at?
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-have-varying-if-with-locals-at?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [init-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              init)]
          [init-has-varying-if : bool
            (lower-masked-vector-body-has-varying-if-with-locals?
              ctx
              mode
              env
              type-env
              index
              lane-locals
              init)]
          [next-locals : lower_i64_i64_map.Map
            (lower-masked-vector-lane-locals-bind-if-varying
              lane-locals
              name
              init-lanes)]
          (or
            init-has-varying-if
            (lower-masked-vector-let-bindings-have-varying-if-with-locals-at?
              ctx
              mode
              env
              type-env
              index
              next-locals
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-body-has-varying-if?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [expr : ast.AstExpr]) : bool
  (lower-masked-vector-body-has-varying-if-with-locals?
    ctx
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    expr))

(define (lower-masked-vector-body-has-varying-while-with-locals?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-masked-vector-body-has-varying-while-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-masked-vector-body-has-varying-while-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (lower-masked-vector-body-has-varying-while-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.While cond-box body-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (or
          (>
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              cond)
            0)
          (lower-masked-vector-body-has-varying-while-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            cond)
          (lower-masked-vector-body-has-varying-while-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            body)))]
    [(ast.AstExpr.If cond-box then-box else-box)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx cond-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx then-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx else-box)))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            [body-locals : lower_i64_i64_map.Map
              (lower-masked-vector-let-bindings-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)]
            (or
              (lower-masked-vector-let-bindings-have-varying-while-with-locals?
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (lower-masked-vector-body-has-varying-while-with-locals?
                ctx
                mode
                env
                type-env
                index
                body-locals
                body)))])]
    [(ast.AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-varying-while-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(ast.AstExpr.Unary _ inner-box)
      (lower-masked-vector-body-has-varying-while-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx left-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx right-box)))]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx arr-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx idx-box)))]
    [(ast.AstExpr.ArraySet arr-box idx-box value-box)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx arr-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          ctx
          mode
