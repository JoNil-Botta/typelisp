  (OkLowerState LowerState)
  (ErrLowerState (Box CompilerDiagnostic)))

(defenum LowerMaybeDirectStore
  (LowerNoDirectStore)
  (LowerDirectStore LowerState)
  (LowerDirectStoreErr (Box CompilerDiagnostic)))

(defenum ResultLowerEnv
  (OkLowerEnv LowerState sym_i64_env.SymI64Env TcTypeEnv)
  (ErrLowerEnv (Box CompilerDiagnostic)))

;; #3759: OkLowerModuleLocalEnv carries, in order, the full module-local type
;; env (top-env + module-local type decls), the full module-local name env, the
;; module-local-ONLY type env, and the module-local-ONLY name env (just the
;; module's own type/name bindings, on empty bases). The last two build small
;; per-module type/name cache overlays over the shared global caches instead of
;; re-walking the global env at every module boundary.
(defenum ResultLowerModuleLocalEnv
  (OkLowerModuleLocalEnv TcTypeEnv LowerNameEnv TcTypeEnv LowerNameEnv)
  (ErrLowerModuleLocalEnv String))

(defenum ResultLowerValue
  (OkLowerValue CompilerIrValue)
  (ErrLowerValue (Box CompilerDiagnostic)))

(defenum ResultLowerSize
  (OkLowerSize i64)
  (ErrLowerSize String))

(defenum ResultLowerFunction
  (OkLowerFunction CompilerIrFunctionList CompilerSourceSpans)
  (ErrLowerFunction (Box CompilerDiagnostic)))

;; `lower-decls` also threads the `CompilerSourceSpans` provenance side table
;;
;; (#605) so each lowered function's source span is recorded alongside the IR.
(defstruct LowerDeclsSuccess
  (globals CompilerIrGlobalList)
  (functions CompilerIrFunctionList)
  (externs CompilerIrExternList)
  (spans CompilerSourceSpans))

(defenum ResultLowerDecls
  (OkLowerDecls (Box LowerDeclsSuccess))
  (ErrLowerDecls (Box CompilerDiagnostic)))

(defenum LowerDispatchDecl
  (LowerDispatchDecl
    CompilerIrGlobal
    CompilerIrFunctionList
    CompilerSourceSpans))

(defenum ResultLowerDispatchDecl
  (OkLowerDispatchDecl (Box LowerDispatchDecl))
  (ErrLowerDispatchDecl (Box CompilerDiagnostic)))

;; A successful lowering returns the IR `CompilerIrProgram` plus a
;;
;; `CompilerSourceSpans` side table (#605) mapping each lowered function's name
;;
;; to the `AstSourceSpan` of its source body, so backend diagnostics can report a
;;
;; real source location. The provenance table is kept outside the IR so the
;;
;; optimizer and liveness data model stay unchanged.
(defenum ResultCompilerLower
  (OkCompilerLower CompilerIrProgram CompilerSourceSpans)
  (ErrCompilerLower (Box CompilerDiagnostic)))

(defenum LowerFieldInfo
  (LowerFieldInfo i64 AstType))

(defenum ResultLowerFieldInfo
  (OkLowerFieldInfo LowerFieldInfo)
  (ErrLowerFieldInfo (Box CompilerDiagnostic)))

(defenum LowerStringFields
  (LowerStringFields LowerState CompilerIrValue CompilerIrValue))

(defenum LowerMaybeStringConcatCall
  (LowerNoStringConcatCall)
  (LowerSomeStringConcatCall AstExpr AstExpr))

(defenum ResultLowerStringValues
  (OkLowerStringValues LowerState CompilerIrValueList i64)
  (ErrLowerStringValues (Box CompilerDiagnostic)))

(defstruct LowerCleanupStack
  (hidden-names (Array String))
  (cleanup-names (Array String))
  (count i64))

(defenum LowerResourceBindings
  (LowerResourceBindings
    LowerState
    sym_i64_env.SymI64Env
    TcTypeEnv
    LowerCleanupStack))

(defenum ResultLowerResourceBindings
  (OkLowerResourceBindings LowerResourceBindings)
  (ErrLowerResourceBindings (Box CompilerDiagnostic)))

(define (lower-diagnostic [message : String]) : CompilerDiagnostic
  (compiler-diagnostic-at-start "" message))

(cfg
  compile-profile
  (define compiler-lower-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-start-total : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-start-live : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-detail-start-ms : i64
    0))

(cfg
  compile-profile
  (define (compiler-lower-profile-field [value : i64]) : String
    (string.append "|" (string.int->string value))))

(cfg
  compile-profile
  (define (compiler-lower-profile-start) : unit
    (begin
      (set! compiler-lower-profile-start-ms (profile.now-ms))
      (set! compiler-lower-profile-start-total (profile.alloc-total))
      (set! compiler-lower-profile-start-live (profile.alloc-live))
      (profile.alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-lower-profile-finish [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64
        (- (profile.alloc-peak) compiler-lower-profile-start-live)]
      (io.print-error
        (string.append
          "compile-profile|lower."
          (string.append
            phase
            (string.append
              (compiler-lower-profile-field
                (- end-ms compiler-lower-profile-start-ms))
              (string.append
                (compiler-lower-profile-field
                  (- end-total compiler-lower-profile-start-total))
                (string.append
                  (compiler-lower-profile-field
                    (- end-live compiler-lower-profile-start-live))
                  (string.append (compiler-lower-profile-field peak-delta) "\n"))))))))))

(cfg
  compile-profile
  (define (compiler-lower-profile-detail-start) : unit
    (set! compiler-lower-profile-detail-start-ms (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-lower-profile-detail-finish
    [phase : String]
    [name : String]) : unit
    (let
      [elapsed : i64
        (- (profile.now-ms) compiler-lower-profile-detail-start-ms)]
      (if (>= elapsed 1)
        (io.print-error
          (string.append
            "compile-profile-detail|lower."
            (string.append
              phase
              (string.append
                "|"
                (string.append
                  (string.int->string elapsed)
                  (string.append "|" (string.append name "\n")))))))
        unit))))

(cfg
  compile-profile
  ;; Counter rows reuse the six-field phase schema so benchmark profile.tsv
  ;; extraction preserves them; the counter value lives in the live-delta slot.
  (define (compiler-lower-profile-counter [name : String] [value : i64]) : unit
    (io.print-error
      (string.append
        "compile-profile|lower."
        (string.append
          name
          (string.append
            "|0|0"
            (string.append (compiler-lower-profile-field value) "|0\n")))))))

(cfg
  compile-profile
  (define (compiler-lower-profile-pools
    [point : String]
    [pools : AstNodePoolContext]) : unit
    (begin
      (compiler-lower-profile-counter
        (string.append "ast_expr_pool." (string.append point ".len"))
        (ast-node-pool-context-expr-len pools))
      (compiler-lower-profile-counter
        (string.append "ast_expr_pool." (string.append point ".capacity"))
        (ast-node-pool-context-expr-capacity pools))
      (compiler-lower-profile-counter
        (string.append "ast_type_pool." (string.append point ".len"))
        (ast-node-pool-context-type-len pools))
      (compiler-lower-profile-counter
        (string.append "ast_type_pool." (string.append point ".capacity"))
        (ast-node-pool-context-type-capacity pools)))))

(cfg
  compile-profile
  (define (compiler-lower-profile-decl-list-count [decls : AstDeclList]) : i64
    (match decls
      [(AstDeclList.Nil) 0]
      [(AstDeclList.Cons _ rest)
        (let
          [rest : AstDeclList (box-get rest)]
          (+ 1 (compiler-lower-profile-decl-list-count rest)))])))

(cfg
  compile-profile
  (define (compiler-lower-profile-program-counts
    [point : String]
    [program : AstProgram]) : unit
    (match program
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (begin
            (compiler-lower-profile-counter
              (string.append "checked_program." (string.append point ".decls"))
              (compiler-lower-profile-decl-list-count decls))
            (compiler-lower-profile-counter
              (string.append
                "checked_program."
                (string.append point ".functions"))
              (lower-function-decl-count decls))))])))

(cfg
  compile-profile
  (define (compiler-lower-profile-ir-shape
    [point : String]
    [program : CompilerIrProgram]) : unit
    (match program
      [(CompilerIrProgram.Program _ functions _)
        (begin
          (compiler-lower-profile-counter
            (string.append "ir." (string.append point ".functions"))
            (compiler-ir-function-list-count functions))
          (compiler-lower-profile-counter
            (string.append "ir." (string.append point ".blocks"))
            (compiler-ir-function-list-block-count functions))
          (compiler-lower-profile-counter
            (string.append "ir." (string.append point ".instructions"))
            (compiler-ir-function-list-instruction-count functions)))])))

(cfg
  compile-profile
  (define (compiler-lower-profile-ir-arena [point : String]) : unit
    (compiler-lower-profile-counter
      (string.append "ir_arena." (string.append point ".active"))
      (if (= lower-ir-arena 0)
        0
        1))))

(define (lower-diagnostic-at-expr [expr : AstExpr] [message : String]) : CompilerDiagnostic
  (match expr
    [(AstExpr.Spanned _ span)
      (compiler-diagnostic-from-ast-span "" span message)]
    [_ (lower-diagnostic message)]))

;; Best-available source span for an expression: the outermost `AstExpr.Spanned`
;;
;; wrapper the parser attached (#605). Used to populate the lowering provenance
;;
;; side table from a function's body. Returns `CompilerMaybeSourceSpan.No` for an
;;
;; unspanned expression (synthesized IR has no source location).
(define (lower-ast-expr-span [expr : AstExpr]) : CompilerMaybeSourceSpan
  (match expr
    [(AstExpr.Spanned _ span) (CompilerMaybeSourceSpan.Some span)]
    [_ (CompilerMaybeSourceSpan.No)]))

(define (lower-diagnostic-with-path [diag : CompilerDiagnostic] [path : String]) : CompilerDiagnostic
  (compiler-diagnostic-with-path diag path))

(define (lower-reference-support-message) : String
  "lower: reference-typed programs require borrow/reference lowering support (#803/#806/#804)")

(define (lower-bytes-view-from-parts-name? [name : String]) : bool
  (let
    [base : String
      (if (tc-name-qualified? name)
        (tc-qualified-name-base name)
        name)]
    (or
      (string.eq base "tl_bytes_view_from_str_parts")
      (string.eq base "tl_bytes_view_from_buf_parts")
      (string.eq base "tl_bytes_mut_view_from_buf_parts")
      (string.eq base "tl_bytes_view_from_bytes_parts")
      (string.eq base "tl_bytes_mut_view_from_bytes_parts"))))

(define (lower-supported-reference-extern?
  [ctx : TcContext]
  [name : i64]
  [ty : AstType]) : bool
  (let
    [_ : TcContext ctx]
    [_ty : AstType ty]
    (or
      (cbi.compiler-builtin-backend-tl-str-view-id? name)
      (string.eq (intern-str name) "tl_str_view")
      (lower-bytes-view-from-parts-name? (intern-str name)))))

(define (lower-instr-list-fill-array-reversed
  [instrs : CompilerIrInstrList]
  [slots : (Array CompilerIrInstr)]
  [index : i64]) : unit
  (match instrs
    [(CompilerIrInstrList.Nil) unit]
    [(CompilerIrInstrList.Cons head rest)
      (begin
        (array-set! slots index head)
        (lower-instr-list-fill-array-reversed (box-get rest) slots (- index 1)))]))

(define (lower-instr-seq-from-reversed-list [instrs : CompilerIrInstrList]) : CompilerIrInstrSeq
  (let
    [count : i64 (compiler-ir-instr-list-count instrs)]
    [slots : (Array CompilerIrInstr) (make-array CompilerIrInstr count)]
    (begin
      (lower-instr-list-fill-array-reversed instrs slots (- count 1))
      (CompilerIrInstrSeq slots count))))

(define (lower-block-list-reverse-onto
  [blocks : CompilerIrBlockList]
  [acc : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) acc]
    [(CompilerIrBlockList.Cons head rest)
      (lower-block-list-reverse-onto
        (box-get rest)
        (compiler-ir-block-cons head acc))]
    [(CompilerIrBlockList.Array seq)
      (lower-block-list-reverse-onto (compiler-ir-block-seq-to-list seq) acc)]))

(define (lower-block-list-reverse [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (lower-block-list-reverse-onto blocks CompilerIrBlockList.Nil))

(define (lower-global-list-reverse-onto
  [globals : CompilerIrGlobalList]
  [acc : CompilerIrGlobalList]) : CompilerIrGlobalList
  (match globals
    [(CompilerIrGlobalList.Nil) acc]
    [(CompilerIrGlobalList.Cons head rest)
      (lower-global-list-reverse-onto
        (box-get rest)
        (compiler-ir-global-cons head acc))]))

(define (lower-global-list-reverse [globals : CompilerIrGlobalList]) : CompilerIrGlobalList
  (lower-global-list-reverse-onto globals CompilerIrGlobalList.Nil))

(define (lower-function-list-reverse-onto
  [functions : CompilerIrFunctionList]
  [acc : CompilerIrFunctionList]) : CompilerIrFunctionList
  (match (compiler-ir-function-list-force-cons functions)
    [(CompilerIrFunctionList.Nil) acc]
    [(CompilerIrFunctionList.Cons head rest)
      (lower-function-list-reverse-onto
        (box-get rest)
        (compiler-ir-function-cons head acc))]
    [(CompilerIrFunctionList.Array seq)
      (lower-function-list-reverse-onto
        (compiler-ir-function-seq-to-list seq)
        acc)]))

(define (lower-function-list-reverse [functions : CompilerIrFunctionList]) : CompilerIrFunctionList
  (lower-function-list-reverse-onto functions CompilerIrFunctionList.Nil))

(define (lower-function-list-append
  [left : CompilerIrFunctionList]
  [right : CompilerIrFunctionList]) : CompilerIrFunctionList
  (match (compiler-ir-function-list-force-cons left)
    [(CompilerIrFunctionList.Nil) right]
    [(CompilerIrFunctionList.Cons head rest)
      (compiler-ir-function-cons
        head
        (lower-function-list-append (box-get rest) right))]
    [(CompilerIrFunctionList.Array seq)
      (lower-function-list-append (compiler-ir-function-seq-to-list seq) right)]))

(define (lower-extern-list-reverse-onto
  [externs : CompilerIrExternList]
  [acc : CompilerIrExternList]) : CompilerIrExternList
  (match externs
    [(CompilerIrExternList.Nil) acc]
    [(CompilerIrExternList.Cons head rest)
      (lower-extern-list-reverse-onto
        (box-get rest)
        (compiler-ir-extern-cons head acc))]))

(define (lower-extern-list-reverse [externs : CompilerIrExternList]) : CompilerIrExternList
  (lower-extern-list-reverse-onto externs CompilerIrExternList.Nil))

(define (lower-name-env-lookup [names : LowerNameEnv] [source-name : String]) : TcMaybeString
  (let
    [cur : LowerNameEnv names]
    [result : TcMaybeString (TcMaybeString.No)]
    [done : bool false]
    (begin
      (while (and
        (not done)
        (match cur
          [(LowerNameNil) false]
          [_ true]))
        (match cur
          [(LowerNameNil) unit]
          [(LowerNameBind source _ logical rest)
            (if (string.eq source source-name)
              (begin
                (set! result (TcMaybeString.Some logical))
                (set! done true))
              (set! cur (box-get rest)))]))
      result)))

(define (lower-name-env-resolve [names : LowerNameEnv] [source-name : String]) : String
  (match (lower-name-env-lookup names source-name)
    [(TcMaybeString.Some logical) logical]
    [(TcMaybeString.No) source-name]))

(define (lower-name-env-count [names : LowerNameEnv]) : i64
  (let
    [cur : LowerNameEnv names]
    [count : i64 0]
    (begin
      (while (match cur
        [(LowerNameNil) false]
        [_ true])
        (match cur
          [(LowerNameNil) unit]
          [(LowerNameBind _ _ _ rest)
            (begin
              (set! count (+ count 1))
              (set! cur (box-get rest)))]))
      count)))

(define (lower-name-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(defenum LowerNameCacheMaybeId
  (LowerNameCacheNoId)
  (LowerNameCacheSomeId i64))

(define (lower-name-cache-source-last-slash [source-name : String]) : i64
  (let
    [i : i64 0]
    [n : i64 (string.string-length source-name)]
    [last : i64 -1]
    (begin
      (while (< i n)
        (begin
          (if (string.char-eq (string.string-ref source-name i) '/')
            (set! last i)
            unit)
          (set! i (+ i 1))))
      last)))

(define (lower-name-cache-source-id-from-parts [source-name : String]) : LowerNameCacheMaybeId
  (let
    [slash : i64 (lower-name-cache-source-last-slash source-name)]
    [n : i64 (string.string-length source-name)]
    (if (< slash 0)
      (LowerNameCacheNoId)
      (let
        [base-start : i64 (+ slash 1)]
        [module : String (string.substring source-name 0 slash)]
        [base : String
          (string.substring source-name base-start (- n base-start))]
        (match (intern-lookup module)
          [(InternLookupFound module-id)
            (match (intern-lookup base)
              [(InternLookupFound base-id)
                (LowerNameCacheSomeId
                  (compiler-symbol-module-key-id-by-id module-id base-id))]
              [(InternLookupMissing) (LowerNameCacheNoId)])]
          [(InternLookupMissing) (LowerNameCacheNoId)])))))

(define (lower-name-cache-source-id [source-name : String]) : LowerNameCacheMaybeId
  (match (intern-lookup source-name)
    [(InternLookupFound id)
      (LowerNameCacheSomeId (compiler-symbol-name-id-key id))]
    [(InternLookupMissing) (lower-name-cache-source-id-from-parts source-name)]))

(define (lower-name-cache-source-id-value [source-name : String]) : i64
  (match (lower-name-cache-source-id source-name)
    [(LowerNameCacheSomeId source-id) source-id]
    [(LowerNameCacheNoId) -1]))

(define (lower-name-env-bind
  [source-name : String]
  [logical-name : String]
  [rest : LowerNameEnv]) : LowerNameEnv
  (LowerNameBind
    source-name
    (lower-name-cache-source-id-value source-name)
    logical-name
    (box rest)))

(define (lower-name-env-bind-id
  [source-name : String]
  [source-id : i64]
  [logical-name : String]
  [rest : LowerNameEnv]) : LowerNameEnv
  (LowerNameBind source-name source-id logical-name (box rest)))

(define (lower-name-cache-add-id
  [cache : LowerNameCache]
  [source-id : i64]
  [logical-name : String]) : LowerNameCache
  (let
    [ids : hashmap.I64I64Map (struct-get cache ids)]
    [values : (Array String) (struct-get cache values)]
    (if (< source-id 0)
      cache
      (match (hashmap.i64-i64-map-get ids source-id)
        [(hashmap.I64I64MapFound _) cache]
        [(hashmap.I64I64MapMissing)
          (let
            [next : i64 (hashmap.i64-i64-map-len ids)]
            (begin
              (array-set! values next logical-name)
              (LowerNameCache
                (hashmap.i64-i64-map-put ids source-id next)
                values
                (struct-get cache parent))))]))))

(define (lower-name-cache-add
  [cache : LowerNameCache]
  [source-name : String]
  [logical-name : String]) : LowerNameCache
  (lower-name-cache-add-id
    cache
    (lower-name-cache-source-id-value source-name)
    logical-name))

(define (lower-name-cache-from-env-into
  [names : LowerNameEnv]
  [cache : LowerNameCache]) : LowerNameCache
  (let
    [cur : LowerNameEnv names]
    [out : LowerNameCache cache]
    (begin
      (while (match cur
        [(LowerNameNil) false]
        [_ true])
        (match cur
          [(LowerNameNil) unit]
          [(LowerNameBind _ source-id logical rest)
            (begin
              (set! out (lower-name-cache-add-id out source-id logical))
              (set! cur (box-get rest)))]))
      out)))

(define (lower-name-cache-from-env [names : LowerNameEnv]) : LowerNameCache
  (let
    [count : i64 (lower-name-env-count names)]
    (lower-name-cache-from-env-into
      names
      (LowerNameCache
        (hashmap.i64-i64-map-with-capacity (lower-name-cache-capacity count))
        (make-array String count)
        (LowerNameParentNone)))))

;; #3759: build a small overlay name cache from `names` (the module-local names
;; only). On a miss it falls through to the shared global cache
;; `lower-active-global-name-cache` (see lower-name-cache-resolve).
(define (lower-name-cache-overlay [names : LowerNameEnv]) : LowerNameCache
  (let
    [count : i64 (lower-name-env-count names)]
    (lower-name-cache-from-env-into
      names
      (LowerNameCache
        (hashmap.i64-i64-map-with-capacity (lower-name-cache-capacity count))
        (make-array String count)
        (LowerNameParentGlobal)))))

(define (lower-name-cache-lookup-id [cache : LowerNameCache] [source-id : i64]) : TcMaybeString
  (match (hashmap.i64-i64-map-get (struct-get cache ids) source-id)
    [(hashmap.I64I64MapFound index)
      (TcMaybeString.Some (array-ref (struct-get cache values) index))]
    [(hashmap.I64I64MapMissing)
      (match (struct-get cache parent)
        [(LowerNameParentNone) (TcMaybeString.No)]
        [(LowerNameParentGlobal)
          (lower-name-cache-lookup-id lower-active-global-name-cache source-id)])]))

(define (lower-name-cache-resolve
  [cache : LowerNameCache]
  [source-name : String]) : String
  (match (lower-name-cache-source-id source-name)
    [(LowerNameCacheSomeId source-id)
      (match (lower-name-cache-lookup-id cache source-id)
        [(TcMaybeString.Some logical-name) logical-name]
        [(TcMaybeString.No) source-name])]
    [(LowerNameCacheNoId) source-name]))

(define (lower-name-cache-resolve-dotted
  [cache : LowerNameCache]
  [source-name : String]) : String
  (let
    [n : i64 (string.string-length source-name)]
    [i : i64 0]
    [out : String ""]
    [done : bool false]
    (begin
      (while (if done
        false
        (< i n))
        (begin
          (if (and
            (> i 0)
            (< i (- n 1))
            (string.char-eq (string.string-ref source-name i) '.'))
            (let
              [module : String (string.substring source-name 0 i)]
              [base-start : i64 (+ i 1)]
              [base : String
                (string.substring source-name base-start (- n base-start))]
              (match (intern-lookup module)
                [(InternLookupFound module-id)
                  (match (intern-lookup base)
                    [(InternLookupFound base-id)
                      (match (lower-name-cache-lookup-id
                        cache
                        (compiler-symbol-module-key-id-by-id module-id base-id))
                        [(TcMaybeString.Some resolved)
                          (begin
                            (set! out (string.copy resolved))
                            (set! done true))]
                        [(TcMaybeString.No) unit])]
                    [(InternLookupMissing) unit])]
                [(InternLookupMissing) unit]))
            unit)
          (set! i (+ i 1))))
      (if done
        out
        source-name))))

(define (lower-name-cache-resolve-source
  [cache : LowerNameCache]
  [source-name : String]) : String
  (let
    [resolved : String (lower-name-cache-resolve cache source-name)]
    (if (string.eq resolved source-name)
      (lower-name-cache-resolve-dotted cache source-name)
      (string.copy resolved))))

(define (lower-type-env-count [env : TcTypeEnv]) : i64
  (match env
    [(TcTypeEnv.Nil) 0]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (lower-type-env-count (box-get rest))]
    [(TcTypeEnv.Bind _ _ rest) (+ 1 (lower-type-env-count (box-get rest)))]))

(define (lower-type-env-contains-reference? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (lower-type-env-contains-reference? (box-get rest))]
    [(TcTypeEnv.Bind _ ty rest)
      (if (tc-type-contains-reference? ty)
        true
        (lower-type-env-contains-reference? (box-get rest)))]))

(define (lower-type-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (lower-type-cache-add
  [cache : LowerTypeCache]
  [name-id : i64]
  [ty : AstType]) : LowerTypeCache
  (match cache
    [(LowerNoTypeCache) cache]
    [(LowerSomeTypeCache ids values next parent)
      (match (hashmap.i64-i64-map-get ids name-id)
        [(hashmap.I64I64MapFound _) cache]
        [(hashmap.I64I64MapMissing)
          (begin
            (array-set! values next ty)
            (LowerSomeTypeCache
              (hashmap.i64-i64-map-put ids name-id next)
              values
              (+ next 1)
              parent))])]))

(define (lower-type-cache-from-env-into
  [env : TcTypeEnv]
  [cache : LowerTypeCache]) : LowerTypeCache
  (match env
    [(TcTypeEnv.Nil) cache]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (lower-type-cache-from-env-into (box-get rest) cache)]
    [(TcTypeEnv.Bind name-id ty rest)
      (lower-type-cache-from-env-into
        (box-get rest)
        (lower-type-cache-add cache name-id ty))]))

(define (lower-type-cache-from-env [env : TcTypeEnv]) : LowerTypeCache
  (let
    [count : i64 (lower-type-env-count env)]
    (lower-type-cache-from-env-into
      env
      (LowerSomeTypeCache
        (hashmap.i64-i64-map-with-capacity (lower-type-cache-capacity count))
        (make-array AstType count)
        0
        (LowerTypeParentNone)))))

;; #3759: build a small overlay type cache from `env` (the module-local type
;; bindings only). On a miss it falls through to the shared global cache
;; `lower-decls-global-type-cache` (see lower-type-cache-lookup).
(define (lower-type-cache-overlay [env : TcTypeEnv]) : LowerTypeCache
  (let
    [count : i64 (lower-type-env-count env)]
    (lower-type-cache-from-env-into
      env
      (LowerSomeTypeCache
        (hashmap.i64-i64-map-with-capacity (lower-type-cache-capacity count))
        (make-array AstType count)
        0
        (LowerTypeParentGlobal)))))

(define (lower-type-cache-lookup-id
  [cache : LowerTypeCache]
  [name-id : i64]
  [display-name : String]) : ResultTcType
  (match cache
    [(LowerNoTypeCache)
      (ResultTcType.Err (string.append "typecheck: unbound name " display-name))]
    [(LowerSomeTypeCache ids values _ parent)
      (match (hashmap.i64-i64-map-get ids name-id)
        [(hashmap.I64I64MapFound index)
          (ResultTcType.Ok (array-ref values index))]
        [(hashmap.I64I64MapMissing)
          (match parent
            [(LowerTypeParentNone)
              (ResultTcType.Err
                (string.append "typecheck: unbound name " display-name))]
            [(LowerTypeParentGlobal)
              (lower-type-cache-lookup-id
                lower-decls-global-type-cache
                name-id
                display-name)])])]))

(define (lower-type-cache-lookup [cache : LowerTypeCache] [name : String]) : ResultTcType
  (match (intern-lookup name)
    [(InternLookupFound name-id)
      (lower-type-cache-lookup-id cache name-id name)]
    [(InternLookupMissing)
      (ResultTcType.Err (string.append "typecheck: unbound name " name))]))

(define (lower-hygiene-source-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
      [(TcHygieneGlobalName.Context module lookup-name)
        (if (tc-name-qualified? lookup-name)
          lookup-name
          (compiler-symbol-module-key module lookup-name))])
    name))

(define (lower-hygiene-fallback-source-name [name : String]) : TcMaybeString
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneGlobalName.Legacy _) (TcMaybeString.No)]
      [(TcHygieneGlobalName.Context module lookup-name)
        (if (and
          (> (string.string-length module) 0)
          (not (tc-name-qualified? lookup-name)))
          (TcMaybeString.Some lookup-name)
          (TcMaybeString.No))])
    (TcMaybeString.No)))

(define (lower-hygiene-context-source-name
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [module : String]
  [lookup-name : String]) : String
  (if (tc-name-qualified? lookup-name)
    lookup-name
    (if (>= (tc-name-first-dot lookup-name) 0)
      (match (tc-source-name-lookup-key
        (tc-context-with-module ctx module)
        type-env
        lookup-name)
        [(ResultTcString.Ok resolved-name) resolved-name]
        [(ResultTcString.Err _) (compiler-symbol-module-key module lookup-name)])
      (compiler-symbol-module-key module lookup-name))))

(define (lower-hygiene-source-name-in-context
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
      [(TcHygieneGlobalName.Context module lookup-name)
        (lower-hygiene-context-source-name ctx type-env module lookup-name)])
    name))

(define (lower-type-cache-lookup-hygiene
  [cache : LowerTypeCache]
  [name : String]) : ResultTcType
  (let
    [source-name : String (lower-hygiene-source-name name)]
    (match (lower-type-cache-lookup cache source-name)
      [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
      [(ResultTcType.Err message)
        (match (lower-hygiene-fallback-source-name name)
          [(TcMaybeString.Some fallback)
            (match (lower-type-cache-lookup cache fallback)
              [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
              [(ResultTcType.Err _) (ResultTcType.Err message)])]
          [(TcMaybeString.No) (ResultTcType.Err message)])])))

(define (lower-name-cache-resolve-hygiene
  [cache : LowerNameCache]
  [source-name : String]) : String
  (let
    [primary : String (lower-hygiene-source-name source-name)]
    [resolved : String (lower-name-cache-resolve-source cache primary)]
    (if (string.eq resolved primary)
      (match (lower-hygiene-fallback-source-name source-name)
        [(TcMaybeString.Some fallback)
          (lower-name-cache-resolve-source cache fallback)]
        [(TcMaybeString.No) resolved])
      resolved)))

(define (lower-symbols-lookup-value-hygiene
  [symbols : CompilerSymbols]
  [source-name : String]) : i64
  (let
    [primary : String (lower-hygiene-source-name source-name)]
    [handle : i64
      (compiler-symbols-lookup-value-or
        symbols
        primary
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      handle
      (match (lower-hygiene-fallback-source-name source-name)
        [(TcMaybeString.Some fallback)
          (compiler-symbols-lookup-value-or
            symbols
            fallback
            (compiler-symbols-missing-handle))]
        [(TcMaybeString.No) (compiler-symbols-missing-handle)]))))

(define (lower-source-name-lookup-key
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [name : String]) : ResultTcString
  (let
    [source-name : String
      (lower-hygiene-source-name-in-context ctx type-env name)]
    (if (tc-source-slash-qualified? source-name)
      (ResultTcString.Ok source-name)
      (match (tc-source-name-lookup-key ctx type-env source-name)
        [(ResultTcString.Ok lookup-name) (ResultTcString.Ok lookup-name)]
        [(ResultTcString.Err message)
          (match (lower-hygiene-fallback-source-name name)
            [(TcMaybeString.Some fallback)
              (if (tc-source-slash-qualified? fallback)
                (ResultTcString.Ok fallback)
                (match (tc-source-name-lookup-key ctx type-env fallback)
                  [(ResultTcString.Ok lookup-name)
                    (ResultTcString.Ok lookup-name)]
                  [(ResultTcString.Err _) (ResultTcString.Err message)]))]
            [(TcMaybeString.No) (ResultTcString.Err message)])]))))

(define (lower-source-name-lookup-key-after-local-field-check
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [name : String]) : ResultTcString
  (let
    [source-name : String
      (lower-hygiene-source-name-in-context ctx type-env name)]
    (if (tc-source-slash-qualified? source-name)
      (ResultTcString.Ok source-name)
      (match (tc-source-name-lookup-key-after-local-field-check
        ctx
        type-env
        source-name)
        [(ResultTcString.Ok lookup-name) (ResultTcString.Ok lookup-name)]
        [(ResultTcString.Err message)
          (match (lower-hygiene-fallback-source-name name)
            [(TcMaybeString.Some fallback)
              (if (tc-source-slash-qualified? fallback)
                (ResultTcString.Ok fallback)
                (match (tc-source-name-lookup-key-after-local-field-check
                  ctx
                  type-env
                  fallback)
                  [(ResultTcString.Ok lookup-name)
                    (ResultTcString.Ok lookup-name)]
                  [(ResultTcString.Err _) (ResultTcString.Err message)]))]
            [(TcMaybeString.No) (ResultTcString.Err message)])]))))

(define (lower-lookup-type
  [ctx : TcContext]
  [type-cache : LowerTypeCache]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]) : ResultTcType
  (if (tc-dotted-local-field-name? type-env name)
    (match (tc-dotted-local-field-expr-id type-env name)
      [(ResultTcExprId.Ok virtual-id)
        (tc-expr ctx type-env (ast-node-get virtual-id))]
      [(ResultTcExprId.Err message) (ResultTcType.Err message)])
    (if (tc-hygiene-global-name? name)
      (lower-type-cache-lookup-hygiene type-cache name)
      (match (lower-source-name-lookup-key-after-local-field-check
        ctx
        type-env
        name)
        [(ResultTcString.Ok lookup-name)
          (if (sym_i64_env.sym-i64-contains env lookup-name)
            (tc-lookup type-env lookup-name)
            (match (tc-lookup type-env lookup-name)
              [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
              [(ResultTcType.Err _)
                (match (lower-type-cache-lookup type-cache lookup-name)
                  [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
                  [(ResultTcType.Err message)
                    (tc-variant-constructor-type-for-lookup-or
                      ctx
                      lookup-name
                      (tc-source-lookup-display-name ctx name lookup-name)
                      (tc-source-unbound-display-message
                        ctx
                        name
                        lookup-name
                        message))])]))]
        [(ResultTcString.Err message) (ResultTcType.Err message)]))))

(define (lower-lookup-type-id
  [ctx : TcContext]
  [type-cache : LowerTypeCache]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (let
    [name : String (intern-str name-id)]
    (if (tc-hygiene-global-name? name)
      (lower-type-cache-lookup-hygiene type-cache name)
      (if (sym_i64_env.sym-i64-contains-id env name-id)
        (tc-lookup-id type-env name-id)
        (lower-lookup-type ctx type-cache env type-env name)))))

(define (lower-name-env-add-alias-if-free
  [names : LowerNameEnv]
  [source-name : String]
  [logical-name : String]) : LowerNameEnv
  (match (lower-name-env-lookup names source-name)
    [(TcMaybeString.Some _) names]
    [(TcMaybeString.No) (lower-name-env-bind source-name logical-name names)]))

(define (lower-name-env-add-alias-if-free-id
  [names : LowerNameEnv]
  [source-name : String]
  [source-id : i64]
  [logical-name : String]) : LowerNameEnv
  (match (lower-name-env-lookup names source-name)
    [(TcMaybeString.Some _) names]
    [(TcMaybeString.No)
      (lower-name-env-bind-id source-name source-id logical-name names)]))

(define (lower-name-env-add-import-alias-binding
  [names : LowerNameEnv]
  [alias : String]
  [source-name : String]
  [logical-name : String]) : LowerNameEnv
  (if (string.eq alias "")
    (lower-name-env-add-alias-if-free names source-name logical-name)
    (lower-name-env-bind source-name logical-name names)))

(define (lower-name-env-add-import-alias-binding-id
  [names : LowerNameEnv]
  [alias : String]
  [source-name : String]
  [source-id : i64]
  [logical-name : String]) : LowerNameEnv
  (if (string.eq alias "")
    (lower-name-env-add-alias-if-free-id
      names
      source-name
      source-id
      logical-name)
    (lower-name-env-bind-id source-name source-id logical-name names)))

(define (lower-name-env-add-import-alias-binding-base-id
  [names : LowerNameEnv]
  [alias : String]
  [base-name : String]
  [base-id : i64]
  [logical-name : String]) : LowerNameEnv
  (lower-name-env-add-import-alias-binding-id
    names
    alias
    (compiler-symbol-module-key alias base-name)
    (compiler-symbol-module-key-id-by-id (intern alias) base-id)
    logical-name))

(define (lower-name-env-add-module-binding
  [names : LowerNameEnv]
  [module : String]
  [source-name : String]
  [logical-name : String]) : LowerNameEnv
  (if (string.eq module "")
    (lower-name-env-bind source-name logical-name names)
    (let
      [source-id : i64
        (compiler-symbol-module-key-id-by-id
          (intern module)
          (intern source-name))]
      (lower-name-env-bind-id
        (compiler-symbol-module-key module source-name)
        source-id
        logical-name
        names))))

(define (lower-name-env-add-struct-cleanup-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [cleanup : AstStructCleanup]) : LowerNameEnv
  (match cleanup
    [(AstStructCleanup.No) names]
    [(AstStructCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (intern-str cleanup-name)]
        (lower-name-env-add-module-binding
          names
          module
          cleanup-str
          (lower-decl-logical-name entry-path decl-path module cleanup-str)))]))

(define (lower-name-env-add-enum-cleanup-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [cleanup : AstEnumCleanup]) : LowerNameEnv
  (match cleanup
    [(AstEnumCleanup.No) names]
    [(AstEnumCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (intern-str cleanup-name)]
        (lower-name-env-add-module-binding
          names
          module
          cleanup-str
          (lower-decl-logical-name entry-path decl-path module cleanup-str)))]))

(define (lower-name-env-add-local-struct-cleanup
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [cleanup : AstStructCleanup]) : LowerNameEnv
  (match cleanup
    [(AstStructCleanup.No) names]
    [(AstStructCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (intern-str cleanup-name)]
        (lower-name-env-bind-id
          cleanup-str
          cleanup-name
          (lower-current-decl-logical-name-cache name-cache module cleanup-str)
          names))]))

(define (lower-name-env-add-local-enum-cleanup
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [cleanup : AstEnumCleanup]) : LowerNameEnv
  (match cleanup
    [(AstEnumCleanup.No) names]
    [(AstEnumCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (intern-str cleanup-name)]
        (lower-name-env-bind-id
          cleanup-str
          cleanup-name
          (lower-current-decl-logical-name-cache name-cache module cleanup-str)
          names))]))

(define (lower-name-has-clone-prefix? [name : String]) : bool
  (if (>= (string.string-length name) 6)
    (string.eq (string.substring name 0 6) "clone$")
    false))

(define (lower-resolve-name [state : LowerState] [source-name : String]) : String
  (lower-name-cache-resolve-hygiene (lower-state-names state) source-name))

(define (lower-resolve-call-name
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-name : String]) : String
  (if (sym_i64_env.sym-i64-contains env source-name)
    source-name
    (lower-resolve-name state source-name)))

(define (lower-path-separator? [c : char]) : bool
  (or (= c '/') (= c '\\')))

(define (lower-path-drive-qualified? [path : String]) : bool
  (let
    [n : i64 (string.string-length path)]
    (and (> n 1) (= (cast (string.string-ref path 1) : i64) (cast ':' : i64)))))

(define (lower-dirname [path : String]) : String
  (let
    [n : i64 (string.string-length path)]
    [i : i64 0]
    [last : i64 -1]
    (begin
      (while (< i n)
        (begin
          (if (lower-path-separator? (string.string-ref path i))
            (set! last i)
            (set! last last))
          (set! i (+ i 1))))
      (if (< last 0)
        ""
        (string.substring path 0 (+ last 1))))))

(define (lower-path-segment-vec-render-from
  [segments : vector.StringVec]
  [index : i64]
  [prefix : String]) : String
  (if (>= index (vector.string-vec-len segments))
    prefix
    (let
      [segment : String (vector.string-vec-get segments index "")]
      [next-prefix : String
        (if (= (string.string-length prefix) 0)
          segment
          (string.append prefix (string.append "/" segment)))]
      (lower-path-segment-vec-render-from segments (+ index 1) next-prefix))))

(define (lower-path-segment-vec-render [segments : vector.StringVec]) : String
  (lower-path-segment-vec-render-from segments 0 ""))

(define (lower-path-normalize-segment
  [segment : String]
  [segments : vector.StringVec]
  [rooted : bool]) : vector.StringVec
  (cond
    [(string.eq segment "") segments]
    [(string.eq segment ".") segments]
    [(not (string.eq segment "..")) (vector.string-vec-push segments segment)]
    [(<= (vector.string-vec-len segments) 0)
      (if rooted
        segments
        (vector.string-vec-push segments segment))]
    [else
      (let
        [top : String (vector.string-vec-last segments "")]
        (if (string.eq top "..")
          (vector.string-vec-push segments segment)
          (vector.string-vec-pop-rest-or
            (vector.string-vec-pop segments)
            segments)))]))

(define (lower-normalize-path [path : String]) : String
  (let
    [n : i64 (string.string-length path)]
    [drive-root : bool
      (if (> n 2)
        (if (lower-path-drive-qualified? path)
          (lower-path-separator? (string.string-ref path 2))
          false)
        false)]
    [rooted : bool
      (if drive-root
        true
        (if (> n 0)
          (lower-path-separator? (string.string-ref path 0))
          false))]
    [i : i64
      (if drive-root
        3
        (if rooted
          1
          0))]
    [segment-start : i64 i]
    [segments : vector.StringVec (vector.string-vec-new)]
    (begin
      (while (< i n)
        (begin
          (if (lower-path-separator? (string.string-ref path i))
            (begin
              (set!
                segments
                (lower-path-normalize-segment
                  (string.substring path segment-start (- i segment-start))
                  segments
                  rooted))
              (set! segment-start (+ i 1)))
            (set! segment-start segment-start))
          (set! i (+ i 1))))
      (set!
        segments
        (lower-path-normalize-segment
          (string.substring path segment-start (- n segment-start))
          segments
          rooted))
      (let
        [body : String (lower-path-segment-vec-render segments)]
        (cond
          [(if drive-root
              (= (string.string-length body) 0)
              false)
            (string.append (string.substring path 0 2) "/")]
          [drive-root
            (string.append (string.substring path 0 2) (string.append "/" body))]
          [(if rooted
              (= (string.string-length body) 0)
              false)
            "/"]
          [rooted (string.append "/" body)]
          [(= (string.string-length body) 0) "."]
          [else body])))))

(define (lower-string-prefix-at?
  [text : String]
  [prefix : String]
  [start : i64]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< start 0)
      false
      (if (> (+ start prefix-len) text-len)
        false
        (let
          [i : i64 0]
          [ok : bool true]
          (begin
            (while ok
              (if (< i prefix-len)
                (if (=
                  (cast (string.string-ref text (+ start i)) : i64)
                  (cast (string.string-ref prefix i) : i64))
                  (set! i (+ i 1))
                  (set! ok false))
                (set! ok false)))
            (= i prefix-len)))))))

(define (lower-module-id [entry-path : String] [decl-path : String]) : String
  (let
    [entry-path : String (lower-normalize-path entry-path)]
    [decl-path : String (lower-normalize-path decl-path)]
    [base : String (lower-dirname entry-path)]
    [base-len : i64 (string.string-length base)]
    [decl-len : i64 (string.string-length decl-path)]
    (if (and (> base-len 0) (lower-string-prefix-at? decl-path base 0))
      (string.substring decl-path base-len (- decl-len base-len))
      decl-path)))

(define (lower-module-logical-name
  [entry-path : String]
  [decl-path : String]
  [source-name : String]) : String
  (if (and
    (string.eq
      (lower-normalize-path decl-path)
      (lower-normalize-path entry-path))
    (string.eq source-name "main"))
    "main"
    (string.append
      (string.append (lower-module-id entry-path decl-path) "::")
      source-name)))

(define lower-entry-main-module-active : bool
  false)
(define lower-entry-main-module : String
  "")

(define (lower-entry-main-module-match? [module : String]) : bool
  (if lower-entry-main-module-active
    (string.eq module lower-entry-main-module)
    (or (string.eq module "") (string.eq module "main"))))

(define (lower-decl-entry-main?
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [source-name : String]) : bool
  (and
    (string.eq
      (lower-normalize-path decl-path)
      (lower-normalize-path entry-path))
    (string.eq source-name "main")
    (lower-entry-main-module-match? module)))

(define (lower-entry-main-decl? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def name _ _) (= name (intern "main"))]
    [(AstDecl.DefFn name _ _ _ _) (= name (intern "main"))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-entry-main-decl? template))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-entry-main-decl? inner))]
    [_ false]))

(define (lower-entry-main-scan-add
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [decl : AstDecl]
  [scan : LowerEntryMainScan]) : LowerEntryMainScan
  (match scan
    [(LowerEntryMainScan fallback-count fallback-module preferred)
      (if (and
        (string.eq
          (lower-normalize-path decl-path)
          (lower-normalize-path entry-path))
        (lower-entry-main-decl? decl))
        (if (or (string.eq module "") (string.eq module "main"))
          (LowerEntryMainScan fallback-count fallback-module true)
          (LowerEntryMainScan (+ fallback-count 1) module preferred))
        scan)]))

(define (lower-entry-main-scan-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [scan : LowerEntryMainScan]
  [module : String]) : LowerEntryMainScan
  (match decls
    [(AstDeclList.Nil) scan]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [decl-path : String
          (match paths
            [(AstDeclPathList.Cons path _) path]
            [(AstDeclPathList.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathList.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList (box-get path-rest)]
                path-rest)]
            [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
        (match decl
          [(AstDecl.Module next-module)
            (lower-entry-main-scan-decls-in-module
              rest
              rest-paths
              entry-path
              scan
              (intern-str next-module))]
          [_
            (lower-entry-main-scan-decls-in-module
              rest
              rest-paths
              entry-path
              (lower-entry-main-scan-add entry-path decl-path module decl scan)
              module)]))]))

(define (lower-entry-main-scan-selection [scan : LowerEntryMainScan]) : LowerMaybeEntryMainModule
  (match scan
    [(LowerEntryMainScan fallback-count fallback-module preferred)
      (if preferred
        (LowerNoEntryMainModule)
        (if (= fallback-count 1)
          (LowerSomeEntryMainModule fallback-module)
          (LowerNoEntryMainModule)))]))

(define (lower-entry-main-selection-for-program
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]) : LowerMaybeEntryMainModule
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (lower-entry-main-scan-selection
          (lower-entry-main-scan-decls-in-module
            decls
            paths
            entry-path
            (LowerEntryMainScan 0 "" false)
            "")))]))

(define (lower-entry-main-selection-install!
  [selection : LowerMaybeEntryMainModule]) : unit
  (match selection
    [(LowerNoEntryMainModule)
      (begin
        (set! lower-entry-main-module-active false)
        (set! lower-entry-main-module ""))]
    [(LowerSomeEntryMainModule module)
      (begin
        (set! lower-entry-main-module-active true)
        (set! lower-entry-main-module module))]))

(define (lower-entry-main-selection-restore! [active : bool] [module : String]) : unit
  (begin
    (set! lower-entry-main-module-active active)
    (set! lower-entry-main-module module)))

(define (lower-decl-logical-name
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [source-name : String]) : String
  (if (lower-decl-entry-main? entry-path decl-path module source-name)
    "main"
    (if (string.eq module "")
      (lower-module-logical-name entry-path decl-path source-name)
      (lower-module-logical-name
        entry-path
        decl-path
        (compiler-symbol-module-key module source-name)))))

(define (lower-dispatch-source-name [module : String] [name : String]) : String
  (if (and (> (string.string-length module) 0) (not (tc-name-qualified? name)))
    (compiler-symbol-module-key module name)
    name))

(define (lower-current-decl-logical-name
  [names : LowerNameEnv]
  [module : String]
  [source-name : String]) : String
  (let
    [key : String (compiler-symbol-module-key module source-name)]
    [resolved : String
      (lower-name-env-resolve
        names
        (compiler-symbol-module-key module source-name))]
    (if (and
      (string.eq module "main")
      (string.eq source-name "main")
      (string.eq resolved key))
      "main"
      resolved)))

(define (lower-current-decl-logical-name-cache
  [names : LowerNameCache]
  [module : String]
  [source-name : String]) : String
  (let
    [key : String (compiler-symbol-module-key module source-name)]
    [resolved : String (lower-name-cache-resolve names key)]
    (if (and
      (string.eq module "main")
      (string.eq source-name "main")
      (string.eq resolved key))
      "main"
      resolved)))

(define (lower-name-env-add-decl-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [decl : AstDecl]) : LowerNameEnv
  (match decl
    [(AstDecl.Def name _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-module-binding
          names
          module
          name-str
          (lower-decl-logical-name entry-path decl-path module name-str)))]
    [(AstDecl.DefFn name _ _ _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-module-binding
          names
          module
          name-str
          (lower-decl-logical-name entry-path decl-path module name-str)))]
    [(AstDecl.DefDispatch name _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-module-binding
          names
          module
          name-str
          (lower-decl-logical-name entry-path decl-path module name-str)))]
    [(AstDecl.Extern name _ _ _)
      ;; Calls resolve through the local declaration name; backend metadata owns
      ;; the exact external linker symbol.
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-module-binding names module name-str name-str))]
    [(AstDecl.DefEnum _ cleanup _)
      (lower-name-env-add-enum-cleanup-in-module
        names
        entry-path
        decl-path
        module
        cleanup)]
    [(AstDecl.DefEnumLifetimes _ _ cleanup _)
      (lower-name-env-add-enum-cleanup-in-module
        names
        entry-path
        decl-path
        module
        cleanup)]
    [(AstDecl.DefStruct _ _ cleanup _)
      (lower-name-env-add-struct-cleanup-in-module
        names
        entry-path
        decl-path
        module
        cleanup)]
    [(AstDecl.DefStructLifetimes _ _ _ cleanup _)
      (lower-name-env-add-struct-cleanup-in-module
        names
        entry-path
        decl-path
        module
        cleanup)]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-name-env-add-decl-in-module
          names
          entry-path
          decl-path
          module
          template))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-decl-in-module
          names
          entry-path
          decl-path
          module
          inner))]
    [_ names]))

(define (lower-name-env-add-decl
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [decl : AstDecl]) : LowerNameEnv
  (lower-name-env-add-decl-in-module names entry-path decl-path "" decl))

(define (lower-name-env-from-decls
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]) : LowerNameEnv
  (let
    [base : LowerNameEnv
      (lower-name-env-from-decls-in-module decls paths entry-path names "")]
    (lower-name-env-with-import-aliases decls paths entry-path base true)))

(define (lower-name-env-from-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [module : String]) : LowerNameEnv
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 (intern module)]
    (begin
      (while (match cur-decls
        [(AstDeclList.Nil) false]
        [_ true])
        (match cur-decls
          [(AstDeclList.Nil) unit]
          [(AstDeclList.Cons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              [decl-path : String
                (match cur-paths
                  [(AstDeclPathList.Cons path _) path]
                  [(AstDeclPathList.Nil) entry-path])]
              [rest-paths : AstDeclPathList
                (match cur-paths
                  [(AstDeclPathList.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList (box-get path-rest)]
                      path-rest)]
                  [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths)
                    (set! cur-module-id next-module))]
                [_
                  (begin
                    (set!
                      cur-names
                      (lower-name-env-add-decl-in-module
                        cur-names
                        entry-path
                        decl-path
                        (intern-str cur-module-id)
                        decl))
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths))]))]))
      cur-names)))

(define (lower-name-env-add-clone-decl-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [decl : AstDecl]) : LowerNameEnv
  (match decl
    [(AstDecl.DefFn name _ _ _ _)
      (let
        [name-str : String (intern-str name)]
        (if (lower-name-has-clone-prefix? name-str)
          (lower-name-env-add-module-binding
            names
            module
            name-str
            (lower-decl-logical-name entry-path decl-path module name-str))
          names))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-name-env-add-clone-decl-in-module
          names
          entry-path
          decl-path
          module
          template))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-clone-decl-in-module
          names
          entry-path
          decl-path
          module
          inner))]
    [_ names]))

(define (lower-name-env-add-clone-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [module : String]) : LowerNameEnv
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 (intern module)]
    (begin
      (while (match cur-decls
        [(AstDeclList.Nil) false]
        [_ true])
        (match cur-decls
          [(AstDeclList.Nil) unit]
          [(AstDeclList.Cons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              [decl-path : String
                (match cur-paths
                  [(AstDeclPathList.Cons path _) path]
                  [(AstDeclPathList.Nil) entry-path])]
              [rest-paths : AstDeclPathList
                (match cur-paths
                  [(AstDeclPathList.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList (box-get path-rest)]
                      path-rest)]
                  [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths)
                    (set! cur-module-id next-module))]
                [_
                  (begin
                    (set!
                      cur-names
                      (lower-name-env-add-clone-decl-in-module
                        cur-names
                        entry-path
                        decl-path
                        (intern-str cur-module-id)
                        decl))
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths))]))]))
      cur-names)))

(define (lower-name-env-add-clone-decls
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]) : LowerNameEnv
  (lower-name-env-add-clone-decls-in-module decls paths entry-path names ""))

(define (lower-alias-logical-name
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [source-name : String]
  [path-aware : bool]) : String
  (if path-aware
    (lower-decl-logical-name entry-path decl-path module source-name)
    (compiler-symbol-module-key module source-name)))

(define (lower-import-alias-key [importer-module : String] [alias : String]) : String
  (if (string.eq alias "")
    importer-module
    alias))

(define (lower-name-env-add-decl-alias-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [alias : String]
  [module : String]
  [decl : AstDecl]
  [path-aware : bool]) : LowerNameEnv
  (match decl
    [(AstDecl.Def name _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-import-alias-binding-base-id
          names
          alias
          name-str
          name
          (lower-alias-logical-name
            entry-path
            decl-path
            module
            name-str
            path-aware)))]
    [(AstDecl.DefFn name _ _ _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-import-alias-binding-base-id
          names
          alias
          name-str
          name
          (lower-alias-logical-name
            entry-path
            decl-path
            module
            name-str
            path-aware)))]
    [(AstDecl.DefDispatch name _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-import-alias-binding-base-id
          names
          alias
          name-str
          name
          (lower-alias-logical-name
            entry-path
            decl-path
            module
            name-str
            path-aware)))]
    [(AstDecl.Extern name _ _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-import-alias-binding-base-id
          names
          alias
          name-str
          name
          name-str))]
    [(AstDecl.DefStruct _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.No) names]
        [(AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (intern-str cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-id
              names
              alias
              cleanup-str
              cleanup-name
              (lower-alias-logical-name
                entry-path
                decl-path
                module
                cleanup-str
                path-aware)))])]
    [(AstDecl.DefStructLifetimes _ _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.No) names]
        [(AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (intern-str cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-id
              names
              alias
              cleanup-str
              cleanup-name
              (lower-alias-logical-name
                entry-path
                decl-path
                module
                cleanup-str
                path-aware)))])]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-name-env-add-decl-alias-in-module
          names
          entry-path
          decl-path
          alias
          module
          template
          path-aware))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-decl-alias-in-module
          names
          entry-path
          decl-path
          alias
          module
          inner
          path-aware))]
    [_ names]))

(define (lower-name-env-add-decl-alias-in-module-cache
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [alias : String]
  [module : String]
  [decl : AstDecl]) : LowerNameEnv
  (match decl
    [(AstDecl.Def name _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-import-alias-binding-base-id
          names
          alias
          name-str
          name
          (lower-current-decl-logical-name-cache base-cache module name-str)))]
    [(AstDecl.DefFn name _ _ _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-import-alias-binding-base-id
          names
          alias
          name-str
          name
          (lower-current-decl-logical-name-cache base-cache module name-str)))]
    [(AstDecl.DefDispatch name _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-import-alias-binding-base-id
          names
          alias
          name-str
          name
          (lower-current-decl-logical-name-cache base-cache module name-str)))]
    [(AstDecl.Extern name _ _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-add-import-alias-binding-base-id
          names
          alias
          name-str
          name
          name-str))]
    [(AstDecl.DefStruct _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.No) names]
        [(AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (intern-str cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-id
              names
              alias
              cleanup-str
              cleanup-name
              (lower-current-decl-logical-name-cache
                base-cache
                module
                cleanup-str)))])]
    [(AstDecl.DefStructLifetimes _ _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.No) names]
        [(AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (intern-str cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-id
              names
              alias
              cleanup-str
              cleanup-name
              (lower-current-decl-logical-name-cache
                base-cache
                module
                cleanup-str)))])]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-name-env-add-decl-alias-in-module-cache
          names
          base-cache
          alias
          module
          template))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-decl-alias-in-module-cache
          names
          base-cache
          alias
          module
          inner))]
    [_ names]))

(define (lower-name-env-add-module-aliases
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [target-module : String]
  [alias : String]
  [module : String]
  [path-aware : bool]) : LowerNameEnv
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-names : LowerNameEnv names]
    [target-module-id : i64 (intern target-module)]
    [cur-module-id : i64 (intern module)]
    (begin
      (while (match cur-decls
        [(AstDeclList.Nil) false]
        [_ true])
        (match cur-decls
          [(AstDeclList.Nil) unit]
          [(AstDeclList.Cons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              [decl-path : String
                (match cur-paths
                  [(AstDeclPathList.Cons path _) path]
                  [(AstDeclPathList.Nil) entry-path])]
              [rest-paths : AstDeclPathList
                (match cur-paths
                  [(AstDeclPathList.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList (box-get path-rest)]
                      path-rest)]
                  [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! cur-module-id next-module)
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths))]
                [(AstDecl.Import _)
                  (begin
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths))]
                [(AstDecl.IncludeStr _ _)
                  (begin
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths))]
                [(AstDecl.IncludeBin _ _)
                  (begin
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths))]
                [(AstDecl.Test _ _ _)
                  (begin
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths))]
                [_
                  (begin
                    (if (= cur-module-id target-module-id)
                      (set!
                        cur-names
                        (lower-name-env-add-decl-alias-in-module
                          cur-names
                          entry-path
                          decl-path
                          alias
                          (intern-str cur-module-id)
                          decl
                          path-aware))
                      unit)
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths))]))]))
      cur-names)))

(define (lower-name-env-add-module-aliases-cache
  [decls : AstDeclList]
  [base-cache : LowerNameCache]
  [names : LowerNameEnv]
  [target-module : String]
  [target-module-id : i64]
  [alias : String]
  [module-id : i64]) : LowerNameEnv
  (let
    [cur-decls : AstDeclList decls]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 module-id]
    (begin
      (while (match cur-decls
        [(AstDeclList.Nil) false]
        [_ true])
        (match cur-decls
          [(AstDeclList.Nil) unit]
          [(AstDeclList.Cons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! cur-module-id next-module)
                    (set! cur-decls rest))]
                [(AstDecl.Import _) (set! cur-decls rest)]
                [(AstDecl.IncludeStr _ _) (set! cur-decls rest)]
                [(AstDecl.IncludeBin _ _) (set! cur-decls rest)]
                [(AstDecl.Test _ _ _) (set! cur-decls rest)]
                [_
                  (begin
                    (if (= cur-module-id target-module-id)
                      (set!
                        cur-names
                        (lower-name-env-add-decl-alias-in-module-cache
                          cur-names
                          base-cache
                          alias
                          target-module
                          decl))
                      unit)
                    (set! cur-decls rest))]))]))
      cur-names)))

(define (lower-name-env-from-import-aliases
  [all-decls : AstDeclList]
  [all-paths : AstDeclPathList]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [module : String]
  [path-aware : bool]) : LowerNameEnv
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 (intern module)]
    (begin
      (while (match cur-decls
        [(AstDeclList.Nil) false]
        [_ true])
        (match cur-decls
          [(AstDeclList.Nil) unit]
          [(AstDeclList.Cons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              [rest-paths : AstDeclPathList
                (match cur-paths
                  [(AstDeclPathList.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList (box-get path-rest)]
                      path-rest)]
                  [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
              (begin
                (match decl
                  [(AstDecl.Import
                      (AstImportSpec.Spec
                        _
                        _
                        (AstMaybeModuleName.Some target-module)
                        (AstMaybeImportAlias.Some alias)
                        _))
                    (set!
                      cur-names
                      (lower-name-env-add-module-aliases
                        all-decls
                        all-paths
                        entry-path
                        cur-names
                        target-module
                        (lower-import-alias-key
                          (intern-str cur-module-id)
                          alias)
                        ""
                        path-aware))]
                  [_ unit])
                (match decl
                  [(AstDecl.Module next-module)
                    (set! cur-module-id next-module)]
                  [_ unit])
                (set! cur-decls rest)
                (set! cur-paths rest-paths)))]))
      cur-names)))

(define (lower-name-env-with-import-aliases
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [path-aware : bool]) : LowerNameEnv
  (lower-name-env-from-import-aliases
    decls
    paths
    decls
    paths
    entry-path
    names
    ""
    path-aware))

(define (lower-name-env-from-import-aliases-in-module
  [all-decls : AstDeclList]
  [all-paths : AstDeclPathList]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [target-current-module : String]
  [current-module : String]
  [path-aware : bool]) : LowerNameEnv
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-names : LowerNameEnv names]
    [target-module-id : i64 (intern target-current-module)]
    [cur-module-id : i64 (intern current-module)]
    (begin
      (while (match cur-decls
        [(AstDeclList.Nil) false]
        [_ true])
        (match cur-decls
          [(AstDeclList.Nil) unit]
          [(AstDeclList.Cons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              [rest-paths : AstDeclPathList
                (match cur-paths
                  [(AstDeclPathList.Cons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList (box-get path-rest)]
                      path-rest)]
                  [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
              (begin
                (match decl
                  [(AstDecl.Import
                      (AstImportSpec.Spec
                        _
                        _
                        (AstMaybeModuleName.Some target-module)
                        (AstMaybeImportAlias.Some alias)
                        _))
                    (if (= cur-module-id target-module-id)
                      (set!
                        cur-names
                        (lower-name-env-add-module-aliases
                          all-decls
                          all-paths
                          entry-path
                          cur-names
                          target-module
                          alias
                          ""
                          path-aware))
                      unit)]
                  [_ unit])
                (match decl
                  [(AstDecl.Module next-module)
                    (set! cur-module-id next-module)]
                  [_ unit])
                (set! cur-decls rest)
                (set! cur-paths rest-paths)))]))
      cur-names)))

(define (lower-name-env-with-import-aliases-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [module : String]
  [path-aware : bool]) : LowerNameEnv
  (lower-name-env-from-import-aliases-in-module
    decls
    paths
    decls
    paths
    entry-path
    names
    module
    ""
    path-aware))

(define (lower-name-env-from-import-aliases-in-module-cache
  [all-decls : AstDeclList]
  [decls : AstDeclList]
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [target-current-module-id : i64]
  [current-module-id : i64]) : LowerNameEnv
  (let
    [cur-decls : AstDeclList decls]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 current-module-id]
    (begin
      (while (match cur-decls
        [(AstDeclList.Nil) false]
        [_ true])
        (match cur-decls
          [(AstDeclList.Nil) unit]
          [(AstDeclList.Cons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              (begin
                (match decl
                  [(AstDecl.Import
                      (AstImportSpec.Spec
                        _
                        _
                        (AstMaybeModuleName.Some target-module)
                        (AstMaybeImportAlias.Some alias)
                        _))
                    (if (= cur-module-id target-current-module-id)
                      (set!
                        cur-names
                        (lower-name-env-add-module-aliases-cache
                          all-decls
                          base-cache
                          cur-names
                          target-module
                          (intern target-module)
                          alias
                          (intern "")))
                      unit)]
                  [_ unit])
                (match decl
                  [(AstDecl.Module next-module)
                    (set! cur-module-id next-module)]
                  [_ unit])
                (set! cur-decls rest)))]))
      cur-names)))

(define (lower-name-env-with-import-aliases-in-module-cache
  [decls : AstDeclList]
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [module : String]) : LowerNameEnv
  (lower-name-env-from-import-aliases-in-module-cache
    decls
    decls
    names
    base-cache
    (intern module)
    (intern "")))

;; #3759: `names` is the env to bind onto; `resolve-env` is the env used to
;; resolve dispatch logical names (the only case that consults an env rather than
;; the name cache). For the normal full build the two are identical. The
;; module-local-only overlay build passes a fresh `names` base but the full env
;; as `resolve-env`, so dispatch names still resolve against all in-scope
;; bindings while only the module-local additions are accumulated.
(define (lower-name-env-add-local-decl-resolve
  [names : LowerNameEnv]
  [resolve-env : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [decl : AstDecl]) : LowerNameEnv
  (match decl
    [(AstDecl.Def name _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-bind-id
          name-str
          name
          (lower-current-decl-logical-name-cache name-cache module name-str)
          names))]
    [(AstDecl.DefFn name _ _ _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-bind-id
          name-str
          name
          (lower-current-decl-logical-name-cache name-cache module name-str)
          names))]
    [(AstDecl.DefDispatch name _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-bind-id
          name-str
          name
          (lower-current-decl-logical-name resolve-env module name-str)
          names))]
    [(AstDecl.Extern name _ _ _)
      (let
        [name-str : String (intern-str name)]
        (lower-name-env-bind-id
          name-str
          name
          (lower-current-decl-logical-name-cache name-cache module name-str)
          names))]
    [(AstDecl.DefEnum _ cleanup _)
      (lower-name-env-add-local-enum-cleanup names name-cache module cleanup)]
    [(AstDecl.DefEnumLifetimes _ _ cleanup _)
      (lower-name-env-add-local-enum-cleanup names name-cache module cleanup)]
    [(AstDecl.DefStruct _ _ cleanup _)
      (lower-name-env-add-local-struct-cleanup names name-cache module cleanup)]
    [(AstDecl.DefStructLifetimes _ _ _ cleanup _)
      (lower-name-env-add-local-struct-cleanup names name-cache module cleanup)]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-name-env-add-local-decl-resolve
          names
          resolve-env
          name-cache
          module
          template))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-local-decl-resolve
          names
          resolve-env
          name-cache
          module
          inner))]
    [_ names]))

(define (lower-name-env-add-local-decl
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [decl : AstDecl]) : LowerNameEnv
  (lower-name-env-add-local-decl-resolve names names name-cache module decl))

(define (lower-module-local-type-env-bind-qualified
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [module : String]
  [name : String]) : ResultTcEnv
  (match (tc-lookup top-env (compiler-symbol-module-key module name))
    [(ResultTcType.Ok ty) (ResultTcEnv.Ok (tc-bind env name ty))]
    [(ResultTcType.Err message) (ResultTcEnv.Err message)]))

(define (lower-module-local-type-env-bind-qualified-if-free
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [module : String]
  [name : String]) : ResultTcEnv
  (match (tc-lookup top-env (compiler-symbol-module-key module name))
    [(ResultTcType.Ok ty) (ResultTcEnv.Ok (tc-bind-alias-if-free env name ty))]
    [(ResultTcType.Err message) (ResultTcEnv.Err message)]))

(define (lower-module-local-type-env-bind-qualified-id-if-free
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [module : String]
  [name-id : i64]) : ResultTcEnv
  (match (tc-lookup-id top-env (tc-module-name-id module name-id))
    [(ResultTcType.Ok ty)
      (ResultTcEnv.Ok (tc-bind-alias-id-if-free env name-id ty))]
    [(ResultTcType.Err message) (ResultTcEnv.Err message)]))

(define (lower-module-local-type-env-add-variants
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [module : String]
  [enum-name : String]
  [variants : AstVariantDefList]) : ResultTcEnv
  (match variants
    [(AstVariantDefList.Nil) (ResultTcEnv.Ok env)]
    [(AstVariantDefList.Cons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef.Def name _ _)
            (match (lower-module-local-type-env-bind-qualified-id-if-free
              top-env
              env
              module
              name)
              [(ResultTcEnv.Ok next-env)
                (lower-module-local-type-env-add-variants
                  top-env
                  next-env
                  module
                  enum-name
                  rest)]
              [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]))]))

(define (lower-module-local-type-env-add-decl
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [module : String]
  [decl : AstDecl]) : ResultTcEnv
  (match decl
    [(AstDecl.Def name _ _)
      (lower-module-local-type-env-bind-qualified
        top-env
        env
        module
        (intern-str name))]
    [(AstDecl.DefFn name _ _ _ _)
      (lower-module-local-type-env-bind-qualified
        top-env
        env
        module
        (intern-str name))]
    [(AstDecl.DefDispatch name _)
      (lower-module-local-type-env-bind-qualified
        top-env
        env
        module
        (intern-str name))]
    [(AstDecl.Extern name _ _ _)
      (lower-module-local-type-env-bind-qualified
        top-env
        env
        module
        (intern-str name))]
    [(AstDecl.DefEnum name cleanup variants)
      (match (lower-module-local-type-env-add-variants
        top-env
        env
        module
        (intern-str name)
        variants)
        [(ResultTcEnv.Ok next-env)
          (match cleanup
            [(AstEnumCleanup.No) (ResultTcEnv.Ok next-env)]
            [(AstEnumCleanup.Fn cleanup-name)
              (lower-module-local-type-env-bind-qualified
                top-env
                next-env
                module
                (intern-str cleanup-name))])]
        [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefEnumLifetimes name _ cleanup variants)
      (match (lower-module-local-type-env-add-variants
        top-env
        env
        module
        (intern-str name)
        variants)
        [(ResultTcEnv.Ok next-env)
          (match cleanup
            [(AstEnumCleanup.No) (ResultTcEnv.Ok next-env)]
            [(AstEnumCleanup.Fn cleanup-name)
              (lower-module-local-type-env-bind-qualified
                top-env
                next-env
                module
                (intern-str cleanup-name))])]
        [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefStruct name _ cleanup _)
      (match (lower-module-local-type-env-bind-qualified
        top-env
        env
        module
        (intern-str name))
        [(ResultTcEnv.Ok next-env)
          (match cleanup
            [(AstStructCleanup.No) (ResultTcEnv.Ok next-env)]
            [(AstStructCleanup.Fn cleanup-name)
              (lower-module-local-type-env-bind-qualified
                top-env
                next-env
                module
                (intern-str cleanup-name))])]
        [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefStructLifetimes name _ _ cleanup _)
      (match (lower-module-local-type-env-bind-qualified
        top-env
        env
        module
        (intern-str name))
        [(ResultTcEnv.Ok next-env)
          (match cleanup
            [(AstStructCleanup.No) (ResultTcEnv.Ok next-env)]
            [(AstStructCleanup.Fn cleanup-name)
              (lower-module-local-type-env-bind-qualified
                top-env
                next-env
                module
                (intern-str cleanup-name))])]
        [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-module-local-type-env-add-decl top-env env module template))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-module-local-type-env-add-decl top-env env module inner))]
    [_ (ResultTcEnv.Ok env)]))

(define (lower-module-local-envs-list
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [type-env : TcTypeEnv]
  [local-type-env : TcTypeEnv]
  [names : LowerNameEnv]
  [local-names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [target-module : String]
  [target-module-id : i64]
  [module-id : i64]) : ResultLowerModuleLocalEnv
  (match decls
    [(AstDeclList.Nil)
      (OkLowerModuleLocalEnv type-env names local-type-env local-names)]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.Module next-module)
            (lower-module-local-envs-list
              top-env
              rest
              type-env
              local-type-env
              names
              local-names
              name-cache
              target-module
              target-module-id
              next-module)]
          [_
            (if (= module-id target-module-id)
              (match (lower-module-local-type-env-add-decl
                top-env
                type-env
                target-module
                decl)
                [(ResultTcEnv.Ok next-type-env)
                  ;; #3759: rebind the same decl onto a fresh local-only base.
                  ;; lower-module-local-type-env-add-decl resolves every type
                  ;; against top-env (passed separately), so the bindings are
                  ;; identical to next-type-env's local additions -- only the base
                  ;; env differs. This isolates the module-local type bindings for
                  ;; the per-module type-cache overlay.
                  (match (lower-module-local-type-env-add-decl
                    top-env
                    local-type-env
                    target-module
                    decl)
                    [(ResultTcEnv.Ok next-local-type-env)
                      (lower-module-local-envs-list
                        top-env
                        rest
                        next-type-env
                        next-local-type-env
                        (lower-name-env-add-local-decl
                          names
                          name-cache
                          target-module
                          decl)
                        ;; #3759: accumulate the module-local name bindings on a
                        ;; fresh base for the name-cache overlay; dispatch logical
                        ;; names still resolve against the full `names` env.
                        (lower-name-env-add-local-decl-resolve
                          local-names
                          names
                          name-cache
                          target-module
                          decl)
                        name-cache
                        target-module
                        target-module-id
                        module-id)]
                    [(ResultTcEnv.Err message) (ErrLowerModuleLocalEnv message)])]
                [(ResultTcEnv.Err message) (ErrLowerModuleLocalEnv message)])
              (lower-module-local-envs-list
                top-env
                rest
                type-env
                local-type-env
                names
                local-names
                name-cache
                target-module
                target-module-id
                module-id))]))]))

(define (lower-module-local-envs
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]) : ResultLowerModuleLocalEnv
  (if (string.eq module "")
    (OkLowerModuleLocalEnv top-env names (TcTypeEnv.Nil) (LowerNameNil))
    (match (tc-context-program ctx)
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          [module-names : LowerNameEnv
            (lower-name-env-with-import-aliases-in-module-cache
              decls
              names
              name-cache
              module)]
          ;; #3759: the module's import aliases resolve against the global
          ;; name-cache (not the env base), so building them on an empty base
          ;; yields the module-local-only alias env -- the starting point for the
          ;; per-module name-cache overlay (local decl names are added on top in
          ;; lower-module-local-envs-list).
          [local-alias-names : LowerNameEnv
            (lower-name-env-with-import-aliases-in-module-cache
              decls
              (LowerNameNil)
              name-cache
              module)]
          (lower-module-local-envs-list
            top-env
            decls
            top-env
            (TcTypeEnv.Nil)
            module-names
            local-alias-names
            name-cache
            module
            (intern module)
            (intern "")))])))

(define (lower-string-set-contains? [items : LowerStringSet] [name : String]) : bool
  (match items
    [(LowerStringNil) false]
    [(LowerStringCons item rest)
      (if (string.eq item name)
        true
        (lower-string-set-contains? (box-get rest) name))]))

(define (lower-string-set-insert [items : LowerStringSet] [name : String]) : LowerStringSet
  (if (lower-string-set-contains? items name)
    items
    (LowerStringCons name (box items))))

(define (lower-spmd-inline-empty-helper-stack) : LowerStringSet
  LowerStringNil)

(define lower-spmd-inline-helper-stack : LowerStringSet
  (lower-spmd-inline-empty-helper-stack))
(define lower-spmd-inline-next-temp : i64
  0)
(define lower-no-main-entry-prune-active : bool
  false)

(define (lower-reset-file-state!) : unit
  (begin
    (set! lower-entry-main-module-active false)
    (set! lower-entry-main-module "")
    (set! lower-spmd-inline-helper-stack (lower-spmd-inline-empty-helper-stack))
    (set! lower-spmd-inline-next-temp 0)
    (set! lower-no-main-entry-prune-active false)))

(define (lower-spmd-inline-recursive-message) : String
  "lower: recursive SPMD inline helper call is not supported")

(define (lower-spmd-inline-fresh-local [name : String]) : String
  (let
    [next : i64 lower-spmd-inline-next-temp]
    (begin
      (set! lower-spmd-inline-next-temp (+ lower-spmd-inline-next-temp 1))
      (str_cat.str-cat
        "__tl_spmd_inline_local$"
        (string.int->string next)
        "$"
        name))))

(define (lower-spmd-inline-subst-lookup
  [subs : LowerSpmdInlineSubst]
  [name : String]) : LowerMaybeAstExpr
  (match subs
    [(LowerSpmdInlineSubstNil) (LowerNoAstExpr)]
    [(LowerSpmdInlineSubstCons key value rest)
      (if (string.eq key name)
        (LowerSomeAstExpr value)
        (lower-spmd-inline-subst-lookup (box-get rest) name))]))

(define (lower-spmd-inline-subst-remove
  [subs : LowerSpmdInlineSubst]
  [name : String]) : LowerSpmdInlineSubst
  (match subs
    [(LowerSpmdInlineSubstNil) LowerSpmdInlineSubstNil]
    [(LowerSpmdInlineSubstCons key value rest)
      (if (string.eq key name)
        (lower-spmd-inline-subst-remove (box-get rest) name)
        (LowerSpmdInlineSubstCons
          key
          value
          (box (lower-spmd-inline-subst-remove (box-get rest) name))))]))

(define (lower-spmd-inline-subst-cons
  [name : String]
  [value : AstExpr]
  [rest : LowerSpmdInlineSubst]) : LowerSpmdInlineSubst
  (LowerSpmdInlineSubstCons name value (box rest)))

(define (lower-spmd-inline-helper-from-decl [name : String] [decl : AstDecl]) : ResultLowerSpmdInlineHelper
  (match decl
    [(AstDecl.DefFn _ params _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (OkLowerSpmdInlineHelper (LowerSomeSpmdInlineHelper name params body)))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-spmd-inline-helper-from-decl name inner))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-spmd-inline-helper-from-decl name template))]
    [_ (OkLowerSpmdInlineHelper (LowerNoSpmdInlineHelper))]))

(define (lower-spmd-inline-helper-name
  [ctx : TcContext]
  [_env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [shadowed : LowerStringSet]
  [func : AstExpr]) : ResultTcString
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [raw-text : String (intern-str raw-name)]
        (cond
          [(lower-string-set-contains? shadowed raw-text)
            (ResultTcString.Err "")]
          [(tc-hygiene-global-name? raw-text)
            (ResultTcString.Ok (tc-hygiene-global-call-name raw-text))]
          [else (lower-source-name-lookup-key ctx type-env raw-text)]))]
    [_ (ResultTcString.Err "")]))

(define (lower-spmd-inline-helper-lookup
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [shadowed : LowerStringSet]
  [func : AstExpr]) : ResultLowerSpmdInlineHelper
  (match (lower-spmd-inline-helper-name ctx env type-env shadowed func)
    [(ResultTcString.Ok name)
      (if (string.eq name "")
        (OkLowerSpmdInlineHelper (LowerNoSpmdInlineHelper))
        (if (lower-string-set-contains? lower-spmd-inline-helper-stack name)
          (ErrLowerSpmdInlineHelper
            (box
              (lower-diagnostic-at-expr
                func
                (lower-spmd-inline-recursive-message))))
          (let
            [handle : i64
              (lower-symbols-lookup-value-hygiene (tc-context-symbols ctx) name)]
            (if (compiler-symbols-handle-found? handle)
              (if (=
                (compiler-symbol-handle-kind handle)
                (compiler-symbol-kind-function-define))
                (match (compiler-symbols-decl-at-index
                  (tc-context-symbols ctx)
                  (compiler-symbol-handle-index handle))
                  [(ResultAstDecl.Ok decl)
                    (lower-spmd-inline-helper-from-decl name decl)]
                  [(ResultAstDecl.Err message)
                    (ErrLowerSpmdInlineHelper (box (lower-diagnostic message)))])
                (OkLowerSpmdInlineHelper (LowerNoSpmdInlineHelper)))
              (OkLowerSpmdInlineHelper (LowerNoSpmdInlineHelper))))))]
    [(ResultTcString.Err message)
      (if (string.eq message "")
        (OkLowerSpmdInlineHelper (LowerNoSpmdInlineHelper))
        (ErrLowerSpmdInlineHelper (box (lower-diagnostic-at-expr func message))))]))

(define (lower-spmd-inline-build-subst
  [params : AstParamList]
  [args : AstExprList]
  [subst : LowerSpmdInlineSubst]
  [origin : AstExpr]) : ResultLowerSpmdInlineSubst
  (match params
    [(AstParamList.Nil)
      (match args
        [(AstExprList.Nil) (OkLowerSpmdInlineSubst subst)]
        [_
          (ErrLowerSpmdInlineSubst
            (box (lower-diagnostic-at-expr origin "lower: arity mismatch")))])]
    [(AstParamList.Cons param rest-params)
      (let
        [rest-params : AstParamList (box-get rest-params)]
        (match args
          [(AstExprList.Cons arg rest-args)
            (let
              [arg : AstExpr (ast-node-get arg)]
              [rest-args : AstExprList (box-get rest-args)]
              (match param
                [(AstParam.Param param-name _ _)
                  (lower-spmd-inline-build-subst
                    rest-params
                    rest-args
                    (lower-spmd-inline-subst-cons
                      (intern-str param-name)
                      arg
                      subst)
                    origin)]))]
          [(AstExprList.Nil)
            (ErrLowerSpmdInlineSubst
              (box (lower-diagnostic-at-expr origin "lower: arity mismatch")))]))]))

(define (lower-spmd-inline-arg-subst
  [params : AstParamList]
  [args : AstExprList]
  [origin : AstExpr]) : ResultLowerSpmdInlineSubst
  (lower-spmd-inline-build-subst params args LowerSpmdInlineSubstNil origin))

(define (lower-spmd-inline-expr-list
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerStringSet]) : ResultLowerAstExprList
  (match exprs
    [(AstExprList.Nil) (OkLowerAstExprList AstExprList.Nil)]
    [(AstExprList.Cons head rest)
      (let
        [head : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (lower-spmd-inline-expr ctx env type-env head subst shadowed)
          [(OkLowerAstExpr rewritten-head)
            (match (lower-spmd-inline-expr-list
              ctx
              env
              type-env
              rest
              subst
              shadowed)
              [(OkLowerAstExprList rewritten-rest)
                (OkLowerAstExprList
                  (ast-expr-cons (ast-node-push rewritten-head) rewritten-rest))]
              [(ErrLowerAstExprList diag) (ErrLowerAstExprList diag)])]
          [(ErrLowerAstExpr diag) (ErrLowerAstExprList diag)]))]))

(define (lower-spmd-inline-let-bindings
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstLetBindingList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerStringSet]) : ResultLowerSpmdInlineLetBindings
  (match bindings
    [(AstLetBindingList.Nil)
      (OkLowerSpmdInlineLetBindings
        (LowerSpmdInlineLetBindings AstLetBindingList.Nil subst shadowed))]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [name-text : String (intern-str name)]
              [renamed : bool
                (match subst
                  [(LowerSpmdInlineSubstNil) false]
                  [_ true])]
              [bind-name : String
                (if renamed
                  (lower-spmd-inline-fresh-local name-text)
                  name-text)]
              [bind-id : i64 (intern bind-name)]
              (match (lower-spmd-inline-expr
                ctx
                env
                type-env
                init
                subst
                shadowed)
                [(OkLowerAstExpr rewritten-init)
                  (match (lower-spmd-inline-let-bindings
                    ctx
                    env
                    type-env
                    rest
                    (if renamed
                      (lower-spmd-inline-subst-cons
                        name-text
                        (AstExpr.Var bind-id)
                        (lower-spmd-inline-subst-remove subst name-text))
                      (lower-spmd-inline-subst-remove subst name-text))
                    (lower-string-set-insert shadowed name-text))
                    [(OkLowerSpmdInlineLetBindings rewritten)
                      (match rewritten
                        [(LowerSpmdInlineLetBindings
                            rewritten-rest
                            body-subst
                            body-shadowed)
                          (OkLowerSpmdInlineLetBindings
                            (LowerSpmdInlineLetBindings
                              (ast-let-binding-cons
                                (ast-let-binding-id
                                  bind-id
                                  maybe-ty
                                  (ast-node-push rewritten-init))
                                rewritten-rest)
                              body-subst
                              body-shadowed))])]
                    [(ErrLowerSpmdInlineLetBindings diag)
                      (ErrLowerSpmdInlineLetBindings diag)])]
                [(ErrLowerAstExpr diag) (ErrLowerSpmdInlineLetBindings diag)]))]))]))

(define (lower-spmd-inline-helper-body
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [params : AstParamList]
  [args : AstExprList]
  [body : AstExpr]
  [origin : AstExpr]) : ResultLowerAstExpr
  (match (lower-spmd-inline-arg-subst params args origin)
    [(OkLowerSpmdInlineSubst helper-subst)
      (let
        [previous : LowerStringSet lower-spmd-inline-helper-stack]
        [result : ResultLowerAstExpr
          (ErrLowerAstExpr
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-spmd-inline-recursive-message))))]
        (begin
          (set!
            lower-spmd-inline-helper-stack
            (lower-string-set-insert previous name))
          (set!
            result
            (lower-spmd-inline-expr
              ctx
              env
              type-env
              body
              helper-subst
              LowerStringNil))
          (set! lower-spmd-inline-helper-stack previous)
          result))]
    [(ErrLowerSpmdInlineSubst diag) (ErrLowerAstExpr diag)]))

(define (lower-spmd-inline-call
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerStringSet]
  [origin : AstExpr]) : ResultLowerAstExpr
  (match (lower-spmd-inline-expr-list ctx env type-env args subst shadowed)
    [(OkLowerAstExprList rewritten-args)
      (match (lower-spmd-inline-helper-lookup ctx env type-env shadowed func)
        [(OkLowerSpmdInlineHelper helper)
          (match helper
            [(LowerSomeSpmdInlineHelper name params body)
              (lower-spmd-inline-helper-body
                ctx
                env
                type-env
                name
                params
                rewritten-args
                body
                origin)]
            [(LowerNoSpmdInlineHelper)
              (match (lower-spmd-inline-expr
                ctx
                env
                type-env
                func
                subst
                shadowed)
                [(OkLowerAstExpr rewritten-func)
                  (OkLowerAstExpr
                    (ast-node-get
                      (ast-expr-call
                        (ast-node-push rewritten-func)
                        rewritten-args)))]
                [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])])]
        [(ErrLowerSpmdInlineHelper diag) (ErrLowerAstExpr diag)])]
    [(ErrLowerAstExprList diag) (ErrLowerAstExpr diag)]))

(define (lower-spmd-inline-expr
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerStringSet]) : ResultLowerAstExpr
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(OkLowerAstExpr rewritten)
            (OkLowerAstExpr
              (ast-node-get (ast-expr-spanned (ast-node-push rewritten) span)))]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.Var name)
      (match (lower-spmd-inline-subst-lookup subst (intern-str name))
        [(LowerSomeAstExpr value) (OkLowerAstExpr value)]
        [(LowerNoAstExpr) (OkLowerAstExpr expr)])]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (lower-spmd-inline-expr ctx env type-env left subst shadowed)
          [(OkLowerAstExpr rewritten-left)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              right
              subst
              shadowed)
              [(OkLowerAstExpr rewritten-right)
                (OkLowerAstExpr
                  (ast-node-get
                    (ast-expr-binary
                      op
                      (ast-node-push rewritten-left)
                      (ast-node-push rewritten-right))))]
              [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(OkLowerAstExpr rewritten)
            (OkLowerAstExpr
              (ast-node-get (ast-expr-unary op (ast-node-push rewritten))))]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (lower-spmd-inline-call ctx env type-env func args subst shadowed expr))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (match (lower-spmd-inline-expr ctx env type-env cond subst shadowed)
          [(OkLowerAstExpr rewritten-cond)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              then-branch
              subst
              shadowed)
              [(OkLowerAstExpr rewritten-then)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  else-branch
                  subst
                  shadowed)
                  [(OkLowerAstExpr rewritten-else)
                    (OkLowerAstExpr
                      (ast-node-get
                        (ast-expr-if
                          (ast-node-push rewritten-cond)
                          (ast-node-push rewritten-then)
                          (ast-node-push rewritten-else))))]
                  [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
              [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (lower-spmd-inline-let-bindings
              ctx
              env
              type-env
              bindings
              subst
              shadowed)
              [(OkLowerSpmdInlineLetBindings rewritten)
                (match rewritten
                  [(LowerSpmdInlineLetBindings
                      rewritten-bindings
                      body-subst
                      body-shadowed)
                    (match (lower-spmd-inline-expr
                      ctx
                      env
                      type-env
                      body
                      body-subst
                      body-shadowed)
                      [(OkLowerAstExpr rewritten-body)
                        (OkLowerAstExpr
                          (ast-node-get
                            (ast-expr-let
                              rewritten-bindings
                              (ast-node-push rewritten-body))))]
                      [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])])]
              [(ErrLowerSpmdInlineLetBindings diag) (ErrLowerAstExpr diag)]))])]
    [(AstExpr.Begin exprs)
      (match (lower-spmd-inline-expr-list ctx env type-env exprs subst shadowed)
        [(OkLowerAstExprList rewritten)
          (OkLowerAstExpr (AstExpr.Begin rewritten))]
        [(ErrLowerAstExprList diag) (ErrLowerAstExpr diag)])]
    [(AstExpr.Ann inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(OkLowerAstExpr rewritten)
            (OkLowerAstExpr
              (ast-node-get (ast-expr-ann (ast-node-push rewritten) ty)))]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.Cast inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(OkLowerAstExpr rewritten)
            (OkLowerAstExpr
              (ast-node-get (ast-expr-cast (ast-node-push rewritten) ty)))]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (lower-spmd-inline-expr ctx env type-env array subst shadowed)
          [(OkLowerAstExpr rewritten-array)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              index
              subst
              shadowed)
              [(OkLowerAstExpr rewritten-index)
                (OkLowerAstExpr
                  (ast-node-get
                    (ast-expr-array-ref
                      (ast-node-push rewritten-array)
                      (ast-node-push rewritten-index))))]
              [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (lower-spmd-inline-expr ctx env type-env array subst shadowed)
          [(OkLowerAstExpr rewritten-array)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              index
              subst
              shadowed)
              [(OkLowerAstExpr rewritten-index)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  value
                  subst
                  shadowed)
                  [(OkLowerAstExpr rewritten-value)
                    (OkLowerAstExpr
                      (ast-node-get
                        (ast-expr-array-set
                          (ast-node-push rewritten-array)
                          (ast-node-push rewritten-index)
                          (ast-node-push rewritten-value))))]
                  [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
              [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (lower-spmd-inline-expr ctx env type-env receiver subst shadowed)
          [(OkLowerAstExpr rewritten-receiver)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              value
              subst
              shadowed)
              [(OkLowerAstExpr rewritten-value)
                (OkLowerAstExpr
                  (ast-node-get
                    (ast-expr-struct-set-id
                      (ast-node-push rewritten-receiver)
                      field
                      (ast-node-push rewritten-value))))]
              [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              start
              subst
              shadowed)
              [(OkLowerAstExpr rewritten-start)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  end
                  subst
                  shadowed)
                  [(OkLowerAstExpr rewritten-end)
                    (match (lower-spmd-inline-expr
                      ctx
                      env
                      type-env
                      init
                      subst
                      shadowed)
                      [(OkLowerAstExpr rewritten-init)
                        (match (lower-spmd-inline-expr
                          ctx
                          env
                          type-env
                          value
                          subst
                          shadowed)
                          [(OkLowerAstExpr rewritten-value)
                            (match (lower-spmd-inline-expr
                              ctx
                              env
                              type-env
                              body
                              subst
                              shadowed)
                              [(OkLowerAstExpr rewritten-body)
                                (OkLowerAstExpr
                                  (AstExpr.SpmdScan
                                    (box
                                      (AstSpmdScan.Scan
                                        op
                                        index
                                        index-ty
                                        (ast-node-push rewritten-start)
                                        (ast-node-push rewritten-end)
                                        prefix
                                        prefix-ty
                                        (ast-node-push rewritten-init)
                                        (ast-node-push rewritten-value)
                                        (ast-node-push rewritten-body)))))]
                              [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
                          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
                      [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
                  [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
              [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (lower-spmd-inline-expr ctx env type-env value subst shadowed)
          [(OkLowerAstExpr rewritten-value)
            (match (lower-spmd-inline-expr ctx env type-env lane subst shadowed)
              [(OkLowerAstExpr rewritten-lane)
                (OkLowerAstExpr
                  (ast-node-get
                    (ast-expr-spmd-broadcast
                      (ast-node-push rewritten-value)
                      (ast-node-push rewritten-lane))))]
              [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (lower-spmd-inline-expr ctx env type-env value subst shadowed)
          [(OkLowerAstExpr rewritten-value)
            (match (lower-spmd-inline-expr ctx env type-env lane subst shadowed)
              [(OkLowerAstExpr rewritten-lane)
                (OkLowerAstExpr
                  (ast-node-get
                    (ast-expr-spmd-shuffle
                      (ast-node-push rewritten-value)
                      (ast-node-push rewritten-lane))))]
              [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)])]
          [(ErrLowerAstExpr diag) (ErrLowerAstExpr diag)]))]
    [_ (OkLowerAstExpr expr)]))

(define (lower-function-logical-name-from-decl
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [decl : AstDecl]) : TcMaybeString
  (match decl
    [(AstDecl.DefFn name _ _ _ _)
      (TcMaybeString.Some
        (lower-decl-logical-name entry-path decl-path module (intern-str name)))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-function-logical-name-from-decl
          entry-path
          decl-path
          module
          template))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-function-logical-name-from-decl
          entry-path
          decl-path
          module
          inner))]
    [_ (TcMaybeString.No)]))

(define (lower-function-set-from-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [out : hashmap.StringI64Map]) : hashmap.StringI64Map
  (match decls
    [(AstDeclList.Nil) out]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [decl-path : String
          (match paths
            [(AstDeclPathList.Cons path _) path]
            [(AstDeclPathList.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathList.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList (box-get path-rest)]
                path-rest)]
            [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
        (match decl
          [(AstDecl.Module next-module)
            (lower-function-set-from-decls-in-module
              rest
              rest-paths
              entry-path
              (intern-str next-module)
              out)]
          [_
            (lower-function-set-from-decls-in-module
              rest
              rest-paths
              entry-path
              module
              (match (lower-function-logical-name-from-decl
                entry-path
                decl-path
                module
                decl)
                ;; #3792: assign each distinct function name a dense slot
                ;; (0..N-1, its insertion order) instead of a constant 1, so the
                ;; prune reachability `reachable` set can key on that i64 slot.
                ;; Skip names already present so the slot stays a bijection
                ;; (string-i64-map-len is the live-entry count == next free slot).
                [(TcMaybeString.Some logical-name)
                  (if (hashmap.string-i64-map-contains? out logical-name)
                    out
                    (hashmap.string-i64-map-put
                      out
                      logical-name
                      (hashmap.string-i64-map-len out)))]
                [(TcMaybeString.No) out]))]))]))

(define (lower-function-set-from-decls
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]) : hashmap.StringI64Map
  (lower-function-set-from-decls-in-module
    decls
    paths
    entry-path
    ""
    (hashmap.string-i64-map-with-capacity 8192)))

(define (lower-clone-root-add-type-list
  [ctx : TcContext]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [types : AstTypeList]
  [module : String]) : CloneNameList
  (match types
    [(AstTypeList.Nil) roots]
    [(AstTypeList.Cons head rest)
      (let
        [head : AstType (tc-context-type-get ctx head)]
        [rest : AstTypeList (box-get rest)]
        (lower-clone-root-add-type-list
          ctx
          decls
          able
          (lower-clone-root-add-type
            (tc-context-with-module ctx module)
            decls
            able
            roots
            head)
          rest
          module))]))

(define (lower-clone-root-add-field-list
  [ctx : TcContext]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [fields : AstFieldDefList]
  [module : String]) : CloneNameList
  (match fields
    [(AstFieldDefList.Nil) roots]
    [(AstFieldDefList.Cons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef.Def _ ty _)
            (lower-clone-root-add-field-list
              ctx
              decls
              able
              (lower-clone-root-add-type
                (tc-context-with-module ctx module)
                decls
                able
                roots
                ty)
              rest
              module)]))]))

(define (lower-clone-root-add-variant-list
  [ctx : TcContext]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [variants : AstVariantDefList]
  [module : String]) : CloneNameList
  (match variants
    [(AstVariantDefList.Nil) roots]
    [(AstVariantDefList.Cons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef.Def _ fields _)
            (lower-clone-root-add-variant-list
              ctx
              decls
              able
              (lower-clone-root-add-type-list
                ctx
                decls
                able
                roots
                fields
                module)
              rest
              module)]))]))

(define (lower-clone-root-add-named-deps-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [name : String]
  [module : String]) : CloneNameList
  (match decls
    [(AstDeclList.Nil) roots]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.Module next-module)
            (lower-clone-root-add-named-deps-in-module
              ctx
              rest
              able
              roots
              name
              (intern-str next-module))]
          [(AstDecl.DefEnum decl-name _ variants)
            (if (string.eq
              (clone-type-name-canonical module (intern-str decl-name))
              name)
              (lower-clone-root-add-variant-list
                ctx
                decls
                able
                roots
                variants
                module)
              (lower-clone-root-add-named-deps-in-module
                ctx
                rest
                able
                roots
                name
                module))]
          [(AstDecl.DefStruct decl-name _ _ fields)
            (if (string.eq
              (clone-type-name-canonical module (intern-str decl-name))
              name)
              (lower-clone-root-add-field-list
                ctx
                decls
                able
                roots
                fields
                module)
              (lower-clone-root-add-named-deps-in-module
                ctx
                rest
                able
                roots
                name
                module))]
          [_
            (lower-clone-root-add-named-deps-in-module
              ctx
              rest
              able
              roots
              name
              module)]))]))

(define (lower-clone-root-add-named-deps
  [ctx : TcContext]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [name : String]) : CloneNameList
  (lower-clone-root-add-named-deps-in-module ctx decls able roots name ""))

(define (lower-clone-root-add-named
  [ctx : TcContext]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [name : String]) : CloneNameList
  (let
    [helper-name : String name]
    (if (clone-name-set-contains? able helper-name)
      (if (clone-name-list-contains? roots helper-name)
        roots
        (lower-clone-root-add-named-deps
          ctx
          decls
          able
          (CloneNameList.Cons helper-name (box roots))
          helper-name))
      roots)))

(define (lower-clone-root-add-type
  [ctx : TcContext]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [ty : AstType]) : CloneNameList
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Tuple elems)
        (lower-clone-root-add-type-list
          ctx
          decls
          able
          roots
          (box-get elems)
          (tc-context-module ctx))]
      [(AstType.Array elem _)
        (lower-clone-root-add-type
          ctx
          decls
          able
          roots
          (tc-context-type-get ctx elem))]
      [(AstType.DynArray elem)
        (lower-clone-root-add-type
          ctx
          decls
          able
          roots
          (tc-context-type-get ctx elem))]
      [(AstType.Box elem)
        (lower-clone-root-add-type
          ctx
          decls
          able
          roots
          (tc-context-type-get ctx elem))]
      [(AstType.Enum name)
        (lower-clone-root-add-named ctx decls able roots (intern-str name))]
      [(AstType.Struct name)
        (lower-clone-root-add-named ctx decls able roots (intern-str name))]
      [(AstType.Var name)
        (lower-clone-root-add-named ctx decls able roots (intern-str name))]
      [_ roots])))

;; Resolve `logical-name` to its dense `all-functions` slot with a single probe
;; (the membership gate this always did), then dedup / insert into `reachable` by
;; that i64 slot -- no per-reference string_eq on the reachable set. The worklist
;; still carries the name so lower-reach-process can resolve the body by name.
(define (lower-reach-add-logical
  [all-functions : hashmap.StringI64Map]
  [state : LowerReachState]
  [logical-name : String]) : LowerReachState
  (match (hashmap.string-i64-map-get all-functions logical-name)
    [(hashmap.StringI64MapMissing) state]
    [(hashmap.StringI64MapFound slot)
      (match state
        [(LowerReachState reachable worklist)
          (if (hashmap.i64-i64-map-contains? reachable slot)
            state
            (LowerReachState
              (hashmap.i64-i64-map-put reachable slot 1)
              (LowerStringCons logical-name (box worklist))))])]))

(define (lower-runtime-prelude-string-helper-name [source-name : String]) : String
  (let
    [base : String (tc-qualified-name-base source-name)]
    (cond
      [(string.eq base "tl_int_to_string") "tl-runtime-int-to-string"]
      [(string.eq base "tl_substring") "tl-runtime-substring"]
      [(string.eq base "tl_str_view") "tl-runtime-str-view"]
      [(string.eq base "tl_bytes_view_from_str_parts") "tl-runtime-str-view"]
      [(string.eq base "tl_bytes_view_from_buf_parts") "tl-runtime-str-view"]
      [(string.eq base "tl_bytes_mut_view_from_buf_parts")
        "tl-runtime-str-view"]
      [(string.eq base "tl_bytes_view_from_bytes_parts") "tl-runtime-str-view"]
      [(string.eq base "tl_bytes_mut_view_from_bytes_parts")
        "tl-runtime-str-view"]
      [(string.eq base "tl_string_concat") "tl-runtime-string-concat"]
      [(string.eq base "tl_string_concat3") "tl-runtime-string-concat3"]
      [(string.eq base "tl_string_concat4") "tl-runtime-string-concat4"]
      [(string.eq base "tl_string_concat5") "tl-runtime-string-concat5"]
      [(string.eq base "tl_atomic_i64_load_ptr")
        "tl-runtime-atomic-i64-load-ptr"]
      [(string.eq base "tl_atomic_i64_store_ptr")
        "tl-runtime-atomic-i64-store-ptr!"]
      [(string.eq base "tl_atomic_i64_add_ptr")
        "tl-runtime-atomic-i64-add-ptr!"]
      [(string.eq base "tl_atomic_i64_fetch_add_ptr")
        "tl-runtime-atomic-i64-fetch-add-ptr!"]
      [(string.eq base "tl_atomic_i64_cas_ptr")
        "tl-runtime-atomic-i64-cas-ptr!"]
      [(string.eq base "tl_atomic_i32_load_ptr")
        "tl-runtime-atomic-i32-load-ptr"]
      [(string.eq base "tl_atomic_i32_store_ptr")
        "tl-runtime-atomic-i32-store-ptr!"]
      [(string.eq base "tl_atomic_i32_add_ptr")
        "tl-runtime-atomic-i32-add-ptr!"]
      [(string.eq base "tl_atomic_i32_fetch_add_ptr")
        "tl-runtime-atomic-i32-fetch-add-ptr!"]
      [(string.eq base "tl_atomic_i32_cas_ptr")
        "tl-runtime-atomic-i32-cas-ptr!"]
      [else ""])))

(define (lower-reach-add-runtime-prelude-string-helper
  [all-functions : hashmap.StringI64Map]
  [state : LowerReachState]
  [source-name : String]) : LowerReachState
  (let
    [helper : String (lower-runtime-prelude-string-helper-name source-name)]
    (if (string.eq helper "")
      state
      (let
        [module-helper : String
          (compiler-symbol-module-key "stdlib.runtime" helper)]
        (lower-reach-add-logical
          all-functions
          (lower-reach-add-logical
            all-functions
            (lower-reach-add-logical
              all-functions
              (lower-reach-add-logical
                all-functions
                state
                (string.append "stdlib/runtime.tl::" helper))
              (string.append "stdlib\\runtime.tl::" helper))
            (string.append "stdlib/runtime.tl::" module-helper))
          (string.append "stdlib\\runtime.tl::" module-helper))))))

(define (lower-reach-add-string-snapshot-runtime
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]) : LowerReachState
  ;; Clone-out/capture snapshot lowering copies owned String buffers through the
  ;; fixed `tl_substring` ABI helper. Source `substring`/`string-slice` calls
  ;; lower there too, so keep its TypeLisp runtime body when a reachable source
  ;; form can synthesize that call after this prune pass.
  (lower-reach-add-runtime-prelude-string-helper-resolved
    all-functions
    names
    state
    "tl_substring"))

(define (lower-reach-add-runtime-prelude-string-helper-resolved
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [source-name : String]) : LowerReachState
  (let
    [helper : String (lower-runtime-prelude-string-helper-name source-name)]
    (if (string.eq helper "")
      state
      (let
        [seeded : LowerReachState
          (lower-reach-add-runtime-prelude-string-helper
            all-functions
            state
            source-name)]
        [module-source : String
          (compiler-symbol-module-key "stdlib.runtime" helper)]
        (lower-reach-add-source
          all-functions
          names
          (lower-reach-add-source all-functions names seeded module-source)
          helper)))))

(define (lower-reach-string-snapshot-source-call? [name-id : i64]) : bool
  (let
    [name : String (tc-hygiene-global-call-name (intern-str name-id))]
    [lookup-id : i64 (intern name)]
    (or
      (cbi.compiler-builtin-lower-clone-id? lookup-id)
      (string.eq name "substring")
      (string.eq name "string-slice"))))

(define (lower-reach-add-source
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [source-name : String]) : LowerReachState
  ;; References introduced by macro expansion carry the hygiene-global prefix
  ;; (e.g. `__tl_macro_global$string.append`); strip it before resolving so the
  ;; underlying function counts as reachable. Otherwise a function called only
  ;; from a macro expansion is pruned, then fails to resolve during lowering.
  (let
    [logical-name : String (lower-name-cache-resolve-hygiene names source-name)]
    (lower-reach-add-runtime-prelude-string-helper-resolved
      all-functions
      names
      (lower-reach-add-stdlib-string-public-helper
        all-functions
        names
        (lower-reach-add-runtime-prelude-string-helper
          all-functions
          (lower-reach-add-logical all-functions state logical-name)
          source-name)
        source-name)
      logical-name)))

(define (lower-stdlib-string-public-helper-name? [base : String]) : bool
  (or
    (string.eq base "string-length")
    (string.eq base "string-ref")
    (string.eq base "char-at")
    (string.eq base "string-eq")
    (string.eq base "string=?")
    (string.eq base "string->int")))

(define (lower-reach-add-stdlib-string-public-helper
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [source-name : String]) : LowerReachState
  (let
    [base : String
      (tc-qualified-name-base (lower-hygiene-source-name source-name))]
    (if (lower-stdlib-string-public-helper-name? base)
      (lower-reach-add-logical
        all-functions
        state
        (lower-name-cache-resolve-source
          names
          (compiler-symbol-module-key "stdlib.string" base)))
      state)))

(define (lower-reach-used-type-name-add-source! [source : String] [name : i64]) : unit
  (if (or (tc-name-qualified? source) (>= (tc-name-first-dot source) 0))
    (set!
      lower-reach-active-body-used-types
      (lower-used-type-name-add lower-reach-active-body-used-types "" name))
    unit))

(define (lower-reach-used-types-add-pattern-roots! [pattern : AstPattern]) : unit
  (match pattern
    [(AstPattern.Var _ _) unit]
    [(AstPattern.Tuple patterns-box)
      (lower-reach-used-types-add-pattern-list-roots! (box-get patterns-box))]
    [(AstPattern.Wildcard) unit]
    [(AstPattern.Binding _) unit]
    [(AstPattern.Variant name patterns-box)
      (begin
        (lower-reach-used-type-name-add-source! (intern-str name) name)
        (lower-reach-used-types-add-pattern-list-roots! (box-get patterns-box)))]
    [(AstPattern.Literal _) unit]))

(define (lower-reach-used-types-add-pattern-list-roots!
  [patterns : AstPatternList]) : unit
  (match patterns
    [(AstPatternList.Nil) unit]
    [(AstPatternList.Cons pattern rest)
      (begin
        (lower-reach-used-types-add-pattern-roots! (box-get pattern))
        (lower-reach-used-types-add-pattern-list-roots! (box-get rest)))]))

(define (lower-reach-expr-list
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [exprs : AstExprList]) : LowerReachState
  (match exprs
    [(AstExprList.Nil) state]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (lower-reach-expr-list
          all-functions
          names
          (lower-reach-expr all-functions names state expr)
          rest))]))

(define (lower-reach-let-bindings
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : AstLetBindingList]) : LowerReachState
  (match bindings
    [(AstLetBindingList.Nil) state]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding _ _ value-box)
            (let
              [value : AstExpr (ast-node-get value-box)]
              (lower-reach-let-bindings
                all-functions
                names
                (lower-reach-expr all-functions names state value)
                rest))]))]))

(define (lower-reach-match-arms
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [arms : AstMatchArmList]) : LowerReachState
  (match arms
    [(AstMatchArmList.Nil) state]
    [(AstMatchArmList.Cons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm.Arm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (begin
                (lower-reach-used-types-add-pattern-roots! pattern)
                (lower-reach-match-arms
                  all-functions
                  names
                  (lower-reach-expr all-functions names state body)
                  rest)))]))]))

(define (lower-reach-resource-bindings
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : AstResourceBindingList]) : LowerReachState
  (match bindings
    [(AstResourceBindingList.Nil) state]
    [(AstResourceBindingList.Cons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding.Binding _ acquire-box cleanup-box)
            (let
              [acquire : AstExpr (ast-node-get acquire-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (lower-reach-resource-bindings
                all-functions
                names
                (lower-reach-expr
                  all-functions
                  names
                  (lower-reach-expr all-functions names state acquire)
                  cleanup)
                rest))]))]))

(define (lower-clone-roots-expr-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [exprs : AstExprList]) : CloneNameList
  (match exprs
    [(AstExprList.Nil) roots]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (lower-clone-roots-expr-list
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots expr)
          rest))]))

(define (lower-clone-roots-bind-let
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]) : TcTypeEnv
  (match maybe-ty
    [(AstMaybeType.Some want) (tc-bind-id env name (tc-resolve-type ctx want))]
    [(AstMaybeType.No)
      (match (tc-expr ctx env init)
        [(ResultTcType.Ok init-ty) (tc-bind-id env name init-ty)]
        [(ResultTcType.Err _) env])]))

(define (lower-clone-roots-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [bindings : AstLetBindingList]) : LowerCloneRootEnv
  (match bindings
    [(AstLetBindingList.Nil) (LowerCloneRootEnv roots env)]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [next-roots : CloneNameList
                (lower-clone-roots-expr ctx env decls able roots init)]
              [next-env : TcTypeEnv
                (lower-clone-roots-bind-let ctx env name maybe-ty init)]
              (lower-clone-roots-let-bindings
                ctx
                next-env
                decls
                able
                next-roots
                rest))]))]))

(define (lower-clone-roots-match-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : CloneNameList
  (match arms
    [(AstMatchArmList.Nil) roots]
    [(AstMatchArmList.Cons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm.Arm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              [arm-env : TcTypeEnv
                (match (tc-bind-match-pattern ctx env scrut-ty pattern)
                  [(ResultTcEnv.Ok next-env) next-env]
                  [(ResultTcEnv.Err _) env])]
              (lower-clone-roots-match-arms
                ctx
                env
                decls
                able
                (lower-clone-roots-expr ctx arm-env decls able roots body)
                scrut-ty
                rest))]))]))

(define (lower-clone-roots-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [bindings : AstResourceBindingList]) : CloneNameList
  (match bindings
    [(AstResourceBindingList.Nil) roots]
    [(AstResourceBindingList.Cons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding.Binding _ acquire-box cleanup-box)
            (let
              [acquire : AstExpr (ast-node-get acquire-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (lower-clone-roots-resource-bindings
                ctx
                env
                decls
                able
                (lower-clone-roots-expr
                  ctx
                  env
                  decls
                  able
                  (lower-clone-roots-expr ctx env decls able roots acquire)
                  cleanup)
                rest))]))]))

(define (lower-clone-roots-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [callee : AstExpr]
  [args : AstExprList]) : CloneNameList
  (let
    [walked : CloneNameList
      (lower-clone-roots-expr-list
        ctx
        env
        decls
        able
        (lower-clone-roots-expr ctx env decls able roots callee)
        args)]
    (match (ast-expr-unspan callee)
      [(AstExpr.Var name)
        (let
          [raw-name : String (intern-str name)]
          [lookup-name : String (tc-hygiene-global-call-name raw-name)]
          [lookup-id : i64 (intern lookup-name)]
          [bound : bool
            (if (tc-hygiene-global-name? raw-name)
              false
              (tc-name-bound? env lookup-name))]
          (if (and
            (cbi.compiler-builtin-lower-clone-id? lookup-id)
            (not bound)
            (not (lower-top-level-value-defined? ctx lookup-name)))
            (match args
              [(AstExprList.Cons _ rest)
                (let
                  [rest : AstExprList (box-get rest)]
                  (match rest
                    [(AstExprList.Nil)
                      (match (tc-expr
                        ctx
                        env
                        (ast-node-get
                          (ast-expr-call-with-pools
                            (tc-context-pools ctx)
                            (ast-node-pool-context-expr-push
                              (tc-context-pools ctx)
                              callee)
                            args)))
                        [(ResultTcType.Ok clone-ty)
                          (lower-clone-root-add-type
                            ctx
                            decls
                            able
                            walked
                            clone-ty)]
                        [(ResultTcType.Err _) walked])]
                    [_ walked]))]
              [_ walked])
            walked))]
      [_ walked])))

(define (lower-clone-roots-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [expr : AstExpr]) : CloneNameList
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.Literal _) roots]
    [(AstExpr.Var _) roots]
    [(AstExpr.Binary _ lhs-box rhs-box)
      (let
        [lhs : AstExpr (ast-node-get lhs-box)]
        [rhs : AstExpr (ast-node-get rhs-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots lhs)
          rhs))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.Call callee-box args)
      (let
        [callee : AstExpr (ast-node-get callee-box)]
        (lower-clone-roots-call ctx env decls able roots callee args))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-expr : AstExpr (ast-node-get then-box)]
        [else-expr : AstExpr (ast-node-get else-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr
            ctx
            env
            decls
            able
            (lower-clone-roots-expr ctx env decls able roots cond)
            then-expr)
          else-expr))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (lower-clone-roots-let-bindings
              ctx
              env
              decls
              able
              roots
              bindings)
              [(LowerCloneRootEnv binding-roots body-env)
                (lower-clone-roots-expr
                  ctx
                  body-env
                  decls
                  able
                  binding-roots
                  body)]))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (lower-clone-roots-expr
              ctx
              (tc-bind-params ctx env params)
              decls
              able
              roots
              body))])]
    [(AstExpr.Tuple values)
      (lower-clone-roots-expr-list ctx env decls able roots values)]
    [(AstExpr.TupleRef value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr ctx env decls able roots value))]
    [(AstExpr.Array values)
      (lower-clone-roots-expr-list ctx env decls able roots values)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (lower-clone-roots-expr ctx env decls able roots len))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots array)
          index))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr
            ctx
            env
            decls
            able
            (lower-clone-roots-expr ctx env decls able roots array)
            index)
          value))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots receiver)
          value))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots array)
          value))]
    [(AstExpr.StringRef text-box index-box)
      (let
        [text : AstExpr (ast-node-get text-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots text)
          index))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots cond)
          body))]
    [(AstExpr.Begin exprs)
      (lower-clone-roots-expr-list ctx env decls able roots exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-clone-roots-expr-list ctx env decls able roots exprs)]
    [(AstExpr.Set _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr ctx env decls able roots value))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.Borrow _ _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match value-box arms)
          (let
            [value : AstExpr (ast-node-get value-box)]
            [value-roots : CloneNameList
              (lower-clone-roots-expr ctx env decls able roots value)]
            (match (tc-expr ctx env value)
              [(ResultTcType.Ok scrut-ty)
                (lower-clone-roots-match-arms
                  ctx
                  env
                  decls
                  able
                  value-roots
                  scrut-ty
                  arms)]
              [(ResultTcType.Err _) value-roots]))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            [body-env : TcTypeEnv
              (tc-bind-id env index (tc-resolve-type ctx index-ty))]
            (lower-clone-roots-expr
              ctx
              body-env
              decls
              able
              (lower-clone-roots-expr
                ctx
                env
                decls
                able
                (lower-clone-roots-expr ctx env decls able roots start)
                end)
              body))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            _
            index
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [value-env : TcTypeEnv
              (tc-bind-id env index (tc-resolve-type ctx index-ty))]
            (lower-clone-roots-expr
              ctx
              value-env
              decls
              able
              (lower-clone-roots-expr
                ctx
                env
                decls
                able
                (lower-clone-roots-expr
                  ctx
                  env
                  decls
                  able
                  (lower-clone-roots-expr ctx env decls able roots start)
                  end)
                init)
              value))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [value-env : TcTypeEnv
              (tc-bind-id env index (tc-resolve-type ctx index-ty))]
            [body-env : TcTypeEnv
              (tc-bind-id value-env prefix (tc-resolve-type ctx prefix-ty))]
            (lower-clone-roots-expr
              ctx
              body-env
              decls
              able
              (lower-clone-roots-expr
                ctx
                value-env
                decls
                able
                (lower-clone-roots-expr
                  ctx
                  env
                  decls
                  able
                  (lower-clone-roots-expr
                    ctx
                    env
                    decls
                    able
                    (lower-clone-roots-expr ctx env decls able roots start)
                    end)
                  init)
                value)
              body))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots value)
          lane))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots value)
          lane))]
    [(AstExpr.StructGet value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr ctx env decls able roots value))]
    [(AstExpr.WithRegion region exprs)
      (lower-clone-roots-expr-list
        ctx
        (tc-push-region env region)
        decls
        able
        roots
        exprs)]
    [(AstExpr.WithEscape scratch-box exprs)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        [walked : CloneNameList
          (lower-clone-roots-expr-list
            ctx
            env
            decls
            able
            (lower-clone-roots-expr ctx env decls able roots scratch)
            exprs)]
        (match (tc-with-escape-expr ctx env scratch exprs)
          [(ResultTcType.Ok result-ty)
            (lower-clone-root-add-type ctx decls able walked result-ty)]
          [(ResultTcType.Err _) walked]))]
    [(AstExpr.WithScratch exprs)
      (let
        [walked : CloneNameList
          (lower-clone-roots-expr-list ctx env decls able roots exprs)]
        (match (tc-with-scratch-expr ctx env exprs)
          [(ResultTcType.Ok result-ty)
            (lower-clone-root-add-type ctx decls able walked result-ty)]
          [(ResultTcType.Err _) walked]))]
    [(AstExpr.InArena arena-box exprs)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (lower-clone-roots-expr-list
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots arena)
          exprs))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (let
            [binding-roots : CloneNameList
              (lower-clone-roots-resource-bindings
                ctx
                env
                decls
                able
                roots
                bindings)]
            [body-env : TcTypeEnv
              (match (tc-resource-bindings ctx env bindings)
                [(ResultTcEnv.Ok next-env) next-env]
                [(ResultTcEnv.Err _) env])]
            (lower-clone-roots-expr-list
              ctx
              body-env
              decls
              able
              binding-roots
              body))])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots inner)
          value))]
    [(AstExpr.TypeLiteral _) roots]
    [(AstExpr.Init _) roots]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.Quote _) roots]
    [(AstExpr.Quasiquote _) roots]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.BracketClause items)
      (lower-clone-roots-expr-list ctx env decls able roots items)]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.PtrNull _) roots]
    [(AstExpr.PtrNullCheck value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr ctx env decls able roots value))]
    [(AstExpr.PtrAddrOf _) roots]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (lower-clone-roots-expr ctx env decls able roots ptr))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots ptr)
          value))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots ptr)
          offset))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (lower-clone-roots-expr ctx env decls able roots ptr))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (lower-clone-roots-expr ctx env decls able roots ptr))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-clone-roots-expr ctx env decls able roots value))]
    [(AstExpr.StringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots ptr)
          len))]
    [(AstExpr.ArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-clone-roots-expr ctx env decls able roots inner))]
    [(AstExpr.BinaryData _) roots]
    [(AstExpr.SpmdProgramIndex) roots]
    [(AstExpr.SpmdProgramCount) roots]
    [(AstExpr.ProgramArgc) roots]
    [(AstExpr.ProgramArgv) roots]
    [(AstExpr.ProgramEnvp) roots]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots leaf)
          subleaf))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots leaf)
          subleaf))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots leaf)
          subleaf))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-clone-roots-expr
          ctx
          env
          decls
          able
          (lower-clone-roots-expr ctx env decls able roots leaf)
          subleaf))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (lower-clone-roots-expr ctx env decls able roots index))]
    [(AstExpr.Syscall args)
      (lower-clone-roots-expr-list ctx env decls able roots args)]))

;; #3735-followup: `name-cache` is the LowerNameCache built once from the
;; whole-program `names` env. It is invariant across every module of a single
;; clone-roots pass (the global name env never changes mid-pass), so it is
;; threaded as a parameter instead of being rebuilt from `names` at each
;; `(module ...)` boundary. Rebuilding it per module made this pass
;; O(modules x global-names); the self-compile hit ~2.3M redundant name-cache
;; entries across ~190 rebuilds in the clone-roots phase alone.
(define (lower-clone-roots-decls-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [decls : AstDeclList]
  [all-decls : AstDeclList]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]) : CloneNameList
  (let
    [cur : AstDeclList decls]
    [cur-local-env : TcTypeEnv local-env]
    [cur-roots : CloneNameList roots]
    [cur-module : String module]
    [done : bool false]
    (begin
      (while (not done)
        (match cur
          [(AstDeclList.Nil) (set! done true)]
          [(AstDeclList.Cons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              (match decl
                [(AstDecl.Unsafe inner-box)
                  (set! cur (ast-decl-cons (box-get inner-box) rest))]
                [(AstDecl.ComptimeDecl _ template-box)
                  (set! cur (ast-decl-cons (box-get template-box) rest))]
                [(AstDecl.Def _ _ expr-box)
                  (let
                    [expr : AstExpr (ast-node-get expr-box)]
                    (begin
                      (set!
                        cur-roots
                        (lower-clone-roots-expr
                          (tc-context-with-module ctx cur-module)
                          cur-local-env
                          all-decls
                          able
                          cur-roots
                          expr))
                      (set! cur rest)))]
                [(AstDecl.DefFn _ params ret body-box _)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module ctx cur-module)]
                    [body : AstExpr (ast-node-get body-box)]
                    [fn-env : TcTypeEnv
                      (tc-bind-return-type
                        (tc-bind-params decl-ctx cur-local-env params)
                        (tc-resolve-type decl-ctx ret))]
                    (begin
                      (set!
                        cur-roots
                        (lower-clone-roots-expr
                          decl-ctx
                          fn-env
                          all-decls
                          able
                          cur-roots
                          body))
                      (set! cur rest)))]
                [(AstDecl.Module next-module)
                  (let
                    [next-module-str : String (intern-str next-module)]
                    (begin
                      (match (lower-module-local-envs
                        ctx
                        top-env
                        names
                        name-cache
                        next-module-str)
                        [(OkLowerModuleLocalEnv next-local-env _ _ _)
                          (set! cur-local-env next-local-env)]
                        [(ErrLowerModuleLocalEnv _) unit])
                      (set! cur-module next-module-str)
                      (set! cur rest)))]
                [_ (set! cur rest)]))]))
      cur-roots)))

(define (lower-clone-roots-program
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [names : LowerNameEnv]
  [program : AstProgram]) : CloneNameList
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        [name-cache : LowerNameCache (lower-name-cache-from-env names)]
        (lower-clone-roots-decls-in-module
          ctx
          top-env
          top-env
          decls
          decls
          (clone-fixpoint
            (tc-context-pools ctx)
            decls
            (clone-all-type-names decls (clone-name-set-empty)))
          (CloneNameList.Nil)
          names
          name-cache
          ""))]))

;; #3792: copy a clone-root name list into the active (persistent) arena. The
;; clone-helper names are re-interned (so they live in the persistent intern
;; arena) and the cons cells are rebuilt, so the result is independent of the
;; scratch arena the original list was discovered in.
(define (lower-clone-name-list-escape [names : CloneNameList]) : CloneNameList
  (match names
    [(CloneNameList.Nil) (CloneNameList.Nil)]
    [(CloneNameList.Cons name rest)
      (CloneNameList.Cons
        (intern-str (intern name))
        (box (lower-clone-name-list-escape (box-get rest))))]))

;; #3792: copy a clone-roots result into the active (persistent) arena. On the
;; (program-valid) Ok path this re-homes the name list; the rare Err path
;; rebuilds the diagnostic with a persistent copy of its message so neither
;; references the rewound scratch arena.
(define (lower-clone-roots-result-escape [result : ResultLowerCloneRoots]) : ResultLowerCloneRoots
  (match result
    [(OkLowerCloneRoots names)
      (OkLowerCloneRoots (lower-clone-name-list-escape names))]
    [(ErrLowerCloneRoots diag)
      (let
        [message : String (compiler-diagnostic-message (box-get diag))]
        (ErrLowerCloneRoots (box (lower-diagnostic (string.copy (& message))))))]))

(define (lower-reachable-clone-roots
  [pools : AstNodePoolContext]
  [program : AstProgram]
  [_paths : AstDeclPathList]
  [names : LowerNameEnv]) : ResultLowerCloneRoots
  ;; #3792: clone-root discovery rebuilds the whole-program symbols, registries
  ;; and top-env plus the clone-ability fixpoint -- ~132MB of the opt1 lower
  ;; peak that adds only a couple dozen AST/type pool nodes, i.e. almost pure
  ;; transient scratch. Build it inside the dedicated lower scratch arena and
  ;; rewind it once the clone-root names are copied back into the persistent
  ;; arena. The only escaping value is the CloneNameList (interned clone-helper
  ;; names), copied by lower-clone-roots-result-escape; the only global cache
  ;; clone-root discovery can leave pointing at the scratch arena is the
  ;; nominal-owner cache, reset on entry and after the rewind (mirrors
  ;; lower-function-escaping and the real typecheck, which also resets it before
  ;; reuse). Persistent intern storage is enabled across the region so names
  ;; interned during discovery never dangle the global intern table.
  (let
    [prev-arena : i64 (arena.tl_arena_current)]
    [prev-persist : bool (intern-persistent-storage-on?)]
    [scratch : i64 (lower-scratch-arena-get)]
    (begin
      (tc-nominal-owner-cache-reset!)
      (intern-persistent-storage-enable!)
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        [raw : ResultLowerCloneRoots
          (match (build-compiler-symbols program)
            [(ResultCompilerSymbols.Ok symbols)
              (match (build-compiler-registries-with-symbols program symbols)
                [(ResultCompilerRegistries.Ok registries)
                  (let
                    [ctx : TcContext
                      (TcContext program symbols registries "" pools)]
                    (match (tc-build-top-env ctx program)
                      [(ResultTcEnv.Ok top-env)
                        (begin
                          (tc-context-capture-active-pools! ctx)
                          (let
                            [roots : CloneNameList
                              (lower-clone-roots-program
                                ctx
                                top-env
                                names
                                program)]
                            (OkLowerCloneRoots roots)))]
                      [(ResultTcEnv.Err message)
                        (ErrLowerCloneRoots (box (lower-diagnostic message)))]))]
                [(ResultCompilerRegistries.Err message)
                  (ErrLowerCloneRoots (box (lower-diagnostic message)))])]
            [(ResultCompilerSymbols.Err message)
              (ErrLowerCloneRoots (box (lower-diagnostic message)))])]
        [scratch-head : i64 (arena.tl_arena_current)]
        (begin
          ;; Re-home the result in the persistent arena while the scratch is
          ;; still live, then rewind the scratch arena.
          (unsafe
            (arena.tl_arena_set prev-arena))
          (let
            [result : ResultLowerCloneRoots
              (lower-clone-roots-result-escape raw)]
            (begin
              (unsafe
                (arena.tl_arena_set scratch-head)
                (arena.tl_region_reset mark)
                (arena.tl_arena_set prev-arena))
              ;; The nominal-owner cache may now hold name strings allocated in
              ;; the rewound scratch arena; clear them so no slot compares
              ;; against freed memory before the real typecheck repopulates it.
              (tc-nominal-owner-cache-reset!)
              (if prev-persist
                unit
                (intern-persistent-storage-disable!))
              result)))))))

(define (lower-reach-call-callee
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [callee : AstExpr]) : LowerReachState
  (match (ast-expr-unspan callee)
    [(AstExpr.Var name)
      (lower-reach-add-source all-functions names state (intern-str name))]
    [_ (lower-reach-expr all-functions names state callee)]))

(define (lower-reach-expr
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [expr : AstExpr]) : LowerReachState
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.Literal _) state]
    [(AstExpr.Var name)
      (lower-reach-add-source all-functions names state (intern-str name))]
    [(AstExpr.Binary _ lhs-box rhs-box)
      (let
        [lhs : AstExpr (ast-node-get lhs-box)]
        [rhs : AstExpr (ast-node-get rhs-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state lhs)
          rhs))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.Call callee-box args)
      (let
        [callee : AstExpr (ast-node-get callee-box)]
        [callee-state : LowerReachState
          (lower-reach-call-callee all-functions names state callee)]
        [runtime-state : LowerReachState
          (match (ast-expr-unspan callee)
            [(AstExpr.Var name)
              (if (lower-reach-string-snapshot-source-call? name)
                (lower-reach-add-string-snapshot-runtime
                  all-functions
                  names
                  callee-state)
                callee-state)]
            [_ callee-state])]
        (lower-reach-expr-list all-functions names runtime-state args))]
    [(AstExpr.If cond-box then-expr-box else-expr-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-expr : AstExpr (ast-node-get then-expr-box)]
        [else-expr : AstExpr (ast-node-get else-expr-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr
            all-functions
            names
            (lower-reach-expr all-functions names state cond)
            then-expr)
          else-expr))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (lower-reach-expr
              all-functions
              names
              (lower-reach-let-bindings all-functions names state bindings)
              body))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (lower-reach-expr
              all-functions
              names
              (lower-reach-add-string-snapshot-runtime
                all-functions
                names
                state)
              body))])]
    [(AstExpr.Tuple values)
      (lower-reach-expr-list all-functions names state values)]
    [(AstExpr.TupleRef value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr all-functions names state value))]
    [(AstExpr.Array values)
      (lower-reach-expr-list all-functions names state values)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (lower-reach-expr all-functions names state len))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state array)
          index))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr
            all-functions
            names
            (lower-reach-expr all-functions names state array)
            index)
          value))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state array)
          value))]
    [(AstExpr.StringRef text-box index-box)
      (let
        [text : AstExpr (ast-node-get text-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state text)
          index))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state cond)
          body))]
    [(AstExpr.Begin exprs)
      (lower-reach-expr-list all-functions names state exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-reach-expr-list all-functions names state exprs)]
    [(AstExpr.Set _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr all-functions names state value))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.Borrow _ _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match value-box arms)
          (let
            [value : AstExpr (ast-node-get value-box)]
            (lower-reach-match-arms
              all-functions
              names
              (lower-reach-expr all-functions names state value)
              arms))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ source-box init-box body-box)
          (let
            [source : AstExpr (ast-node-get source-box)]
            [init : AstExpr (ast-node-get init-box)]
            [body : AstExpr (ast-node-get body-box)]
            (lower-reach-expr
              all-functions
              names
              (lower-reach-expr
                all-functions
                names
                (lower-reach-expr all-functions names state source)
                init)
              body))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            _
            _
            _
            source-box
            init-box
            map-expr-box
            reduce-expr-box)
          (let
            [source : AstExpr (ast-node-get source-box)]
            [init : AstExpr (ast-node-get init-box)]
            [map-expr : AstExpr (ast-node-get map-expr-box)]
            [reduce-expr : AstExpr (ast-node-get reduce-expr-box)]
            (lower-reach-expr
              all-functions
              names
              (lower-reach-expr
                all-functions
                names
                (lower-reach-expr
                  all-functions
                  names
                  (lower-reach-expr all-functions names state source)
                  init)
                map-expr)
              reduce-expr))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (lower-reach-expr
              all-functions
              names
              (lower-reach-expr
                all-functions
                names
                (lower-reach-expr
                  all-functions
                  names
                  (lower-reach-expr
                    all-functions
                    names
                    (lower-reach-expr all-functions names state start)
                    end)
                  init)
                value)
              body))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state value)
          lane))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state value)
          lane))]
    [(AstExpr.StructGet value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr all-functions names state value))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state receiver)
          value))]
    [(AstExpr.WithRegion _ exprs)
      (lower-reach-expr-list all-functions names state exprs)]
    [(AstExpr.WithEscape scratch-box exprs)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (lower-reach-expr-list
          all-functions
          names
          (lower-reach-expr
            all-functions
            names
            (lower-reach-add-string-snapshot-runtime all-functions names state)
            scratch)
          exprs))]
    [(AstExpr.WithScratch exprs)
      (lower-reach-expr-list
        all-functions
        names
        (lower-reach-add-string-snapshot-runtime all-functions names state)
        exprs)]
    [(AstExpr.InArena arena-box exprs)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (lower-reach-expr-list
          all-functions
          names
          (lower-reach-expr all-functions names state arena)
          exprs))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (lower-reach-expr-list
            all-functions
            names
            (lower-reach-resource-bindings all-functions names state bindings)
            body)])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state inner)
          value))]
    [(AstExpr.TypeLiteral _) state]
    [(AstExpr.Init _) state]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.Quote _) state]
    [(AstExpr.Quasiquote _) state]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.BracketClause items)
      (lower-reach-expr-list all-functions names state items)]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.PtrNull _) state]
    [(AstExpr.PtrNullCheck value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr all-functions names state value))]
    [(AstExpr.PtrAddrOf _) state]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (lower-reach-expr all-functions names state ptr))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state ptr)
          value))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state ptr)
          offset))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (lower-reach-expr all-functions names state ptr))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (lower-reach-expr all-functions names state ptr))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-reach-expr all-functions names state value))]
    [(AstExpr.StringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state ptr)
          len))]
    [(AstExpr.ArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-reach-expr all-functions names state inner))]
    [(AstExpr.BinaryData _) state]
    [(AstExpr.SpmdProgramIndex) state]
    [(AstExpr.SpmdProgramCount) state]
    [(AstExpr.ProgramArgc) state]
    [(AstExpr.ProgramArgv) state]
    [(AstExpr.ProgramEnvp) state]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state leaf)
          subleaf))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state leaf)
          subleaf))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state leaf)
          subleaf))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-reach-expr
          all-functions
          names
          (lower-reach-expr all-functions names state leaf)
          subleaf))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (lower-reach-expr all-functions names state index))]
    [(AstExpr.Syscall args)
      (lower-reach-expr-list all-functions names state args)]))

(define (lower-reach-global-decl
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [decl : AstDecl]) : LowerReachState
  (match decl
    [(AstDecl.Def _ _ expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (lower-reach-expr all-functions names state expr))]
    [(AstDecl.DefMacro _ _ _ _) state]
    [(AstDecl.ComptimeDecl _ inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-reach-global-decl all-functions names state inner))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-reach-global-decl all-functions names state inner))]
    [_ state]))

(define (lower-reach-global-decls
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [decls : AstDeclList]) : LowerReachState
  (match decls
    [(AstDeclList.Nil) state]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.Def _ _ expr-box)
            (let
              [expr : AstExpr (ast-node-get expr-box)]
              (lower-reach-global-decls
                all-functions
                names
                (lower-reach-expr all-functions names state expr)
                rest))]
          [(AstDecl.DefMacro _ _ _ _)
            (lower-reach-global-decls all-functions names state rest)]
          [(AstDecl.ComptimeDecl _ inner-box)
            (let
              [inner : AstDecl (box-get inner-box)]
              (lower-reach-global-decls
                all-functions
                names
                (lower-reach-global-decl all-functions names state inner)
                rest))]
          [_ (lower-reach-global-decls all-functions names state rest)]))]))

(define (lower-reach-struct-field-cleanup-roots
  [all-functions : hashmap.StringI64Map]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [names : LowerNameCache]
  [state : LowerReachState]
  [fields : AstFieldDefList]) : LowerReachState
  (match fields
    [(AstFieldDefList.Nil) state]
    [(AstFieldDefList.Cons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        [next : LowerReachState
          (match field
            [(AstFieldDef.Def _ _ cleanup)
              (match cleanup
                [(AstFieldCleanup.Fn cleanup-name)
                  (let
                    [cleanup-str : String (intern-str cleanup-name)]
                    [logical-name : String
                      (if (tc-name-qualified? cleanup-str)
                        (lower-name-cache-resolve-hygiene names cleanup-str)
                        (lower-decl-logical-name
                          entry-path
                          decl-path
                          module
                          cleanup-str))]
                    (lower-reach-add-logical all-functions state logical-name))]
                [_ state])])]
        (lower-reach-struct-field-cleanup-roots
          all-functions
          entry-path
          decl-path
          module
          names
          next
          rest))]))

(define (lower-reach-cleanup-metadata-roots-in-module
  [all-functions : hashmap.StringI64Map]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [names : LowerNameCache]
  [state : LowerReachState]) : LowerReachState
  (match decls
    [(AstDeclList.Nil) state]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [decl-path : String
          (match paths
            [(AstDeclPathList.Cons path _) path]
            [(AstDeclPathList.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathList.Cons _ path-rest) (box-get path-rest)]
            [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
        [next : LowerReachState
          (match decl
            [(AstDecl.DefStruct _ _ cleanup fields)
              (if (ast-struct-cleanup? cleanup)
                (lower-reach-struct-field-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  module
                  names
                  state
                  fields)
                state)]
            [(AstDecl.DefStructLifetimes _ _ _ cleanup fields)
              (if (ast-struct-cleanup? cleanup)
                (lower-reach-struct-field-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  module
                  names
                  state
                  fields)
                state)]
            [(AstDecl.ComptimeDecl _ template-box)
              (let
                [template : AstDecl (box-get template-box)]
                (match template
                  [(AstDecl.DefStruct _ _ cleanup fields)
                    (if (ast-struct-cleanup? cleanup)
                      (lower-reach-struct-field-cleanup-roots
                        all-functions
                        entry-path
                        decl-path
                        module
                        names
                        state
                        fields)
                      state)]
                  [(AstDecl.DefStructLifetimes _ _ _ cleanup fields)
                    (if (ast-struct-cleanup? cleanup)
                      (lower-reach-struct-field-cleanup-roots
                        all-functions
                        entry-path
                        decl-path
                        module
                        names
                        state
                        fields)
                      state)]
                  [_ state]))]
            [(AstDecl.Module next-module)
              (lower-reach-cleanup-metadata-roots-in-module
                all-functions
                rest
                rest-paths
                entry-path
                (intern-str next-module)
                names
                state)]
            [_ state])]
        (match decl
          [(AstDecl.Module _) next]
          [_
            (lower-reach-cleanup-metadata-roots-in-module
              all-functions
              rest
              rest-paths
              entry-path
              module
              names
              next)]))]))

(define (lower-function-body-index-empty [count : i64]) : LowerFunctionBodyIndex
  (LowerFunctionBodyIndex
    (hashmap.string-i64-map-with-capacity 8192)
    (make-array LowerMaybeFunctionBody count)
    0))

;; #3786: accumulate a module's local decl names onto `base-names` while
;; resolving dispatch logical names against `resolve-names` (the full module
;; env), so a module-local-only env can be built for the per-module body
;; name-cache overlay without changing dispatch results.
(define (lower-function-body-local-names-in-module-resolve
  [decls : AstDeclList]
  [base-names : LowerNameEnv]
  [resolve-names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [target-module : String]
  [target-module-id : i64]
  [module-id : i64]) : LowerNameEnv
  (match decls
    [(AstDeclList.Nil) base-names]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.Module next-module)
            (lower-function-body-local-names-in-module-resolve
              rest
              base-names
              resolve-names
              base-cache
              target-module
              target-module-id
              next-module)]
          [_
            (lower-function-body-local-names-in-module-resolve
              rest
              (if (= module-id target-module-id)
                (lower-name-env-add-local-decl-resolve
                  base-names
                  resolve-names
                  base-cache
                  target-module
                  decl)
                base-names)
              resolve-names
              base-cache
              target-module
              target-module-id
              module-id)]))]))

;; #3786: build a small per-module overlay name cache holding only the module's
;; import aliases + local decl names; misses fall through to the shared global
;; cache `lower-active-global-name-cache` (set by the prune body-index pass).
;; Was O(modules x global-names): a fresh full cache was rebuilt per module.
(define (lower-function-body-name-cache-for-module
  [decls : AstDeclList]
  [_paths : AstDeclPathList]
  [_entry-path : String]
  [base-names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [module : String]) : LowerNameCache
  (if (string.eq module "")
    base-cache
    (let
      [module-base-names : LowerNameEnv
        (lower-name-env-with-import-aliases-in-module-cache
          decls
          base-names
          base-cache
          module)]
      [alias-only-names : LowerNameEnv
        (lower-name-env-with-import-aliases-in-module-cache
          decls
          (LowerNameNil)
          base-cache
          module)]
      (lower-name-cache-overlay
        (lower-function-body-local-names-in-module-resolve
          decls
          alias-only-names
          module-base-names
          base-cache
          module
          (intern module)
          (intern ""))))))

(define (lower-function-decl-count-one [decl : AstDecl]) : i64
  (match decl
    [(AstDecl.DefFn _ _ _ _ _) 1]
    [(AstDecl.ComptimeDecl _ inner-box)
      (lower-function-decl-count-one (box-get inner-box))]
    [(AstDecl.Unsafe inner-box)
      (lower-function-decl-count-one (box-get inner-box))]
    [_ 0]))

(define (lower-function-decl-count [decls : AstDeclList]) : i64
  (match decls
    [(AstDeclList.Nil) 0]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (+
          (lower-function-decl-count-one decl)
          (lower-function-decl-count rest)))]))

(define (lower-function-body-index-add
  [index : LowerFunctionBodyIndex]
  [logical-name : String]
  [names : LowerNameCache]
  [body : AstExpr]
  [decl-path : String]) : LowerFunctionBodyIndex
  (let
    [ids : hashmap.StringI64Map (struct-get index ids)]
    [bodies : (Array LowerMaybeFunctionBody) (struct-get index bodies)]
    [next : i64 (struct-get index next)]
    (begin
      (array-set! bodies next (LowerSomeFunctionBody body names decl-path))
      (LowerFunctionBodyIndex
        (hashmap.string-i64-map-put ids logical-name next)
        bodies
        (+ next 1)))))

(define (lower-function-body-index-find
  [index : LowerFunctionBodyIndex]
  [target : String]) : LowerMaybeFunctionBody
  (match (hashmap.string-i64-map-get (struct-get index ids) target)
    [(hashmap.StringI64MapFound body-index)
      (array-ref (struct-get index bodies) body-index)]
    [(hashmap.StringI64MapMissing) (LowerNoFunctionBody)]))

(define (lower-function-body-index-from-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [all-decls : AstDeclList]
  [all-paths : AstDeclPathList]
  [base-names : LowerNameEnv]
  [base-name-cache : LowerNameCache]
  [module-name-cache : LowerNameCache]
  [index : LowerFunctionBodyIndex]) : LowerFunctionBodyIndex
  (match decls
    [(AstDeclList.Nil) index]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [decl-path : String
          (match paths
            [(AstDeclPathList.Cons path _) path]
            [(AstDeclPathList.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathList.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList (box-get path-rest)]
                path-rest)]
            [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
        (match decl
          [(AstDecl.Module next-module)
            (let
              [next-module-str : String (intern-str next-module)]
              (lower-function-body-index-from-decls-in-module
                rest
                rest-paths
                entry-path
                next-module-str
                all-decls
                all-paths
                base-names
                base-name-cache
                (lower-function-body-name-cache-for-module
                  all-decls
                  all-paths
                  entry-path
                  base-names
                  base-name-cache
                  next-module-str)
                index))]
          [(AstDecl.DefFn name _ _ body-box _)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (lower-function-body-index-from-decls-in-module
                rest
                rest-paths
                entry-path
                module
                all-decls
                all-paths
                base-names
                base-name-cache
                module-name-cache
                (lower-function-body-index-add
                  index
                  (lower-decl-logical-name
                    entry-path
                    decl-path
                    module
                    (intern-str name))
                  module-name-cache
                  body
                  decl-path)))]
          [(AstDecl.ComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (lower-function-body-index-from-decls-in-module
                (ast-decl-cons template rest)
                (ast-decl-path-cons decl-path rest-paths)
                entry-path
                module
                all-decls
                all-paths
                base-names
                base-name-cache
                module-name-cache
                index))]
          [(AstDecl.Unsafe inner-box)
            (let
              [inner : AstDecl (box-get inner-box)]
              (match inner
                [(AstDecl.DefFn name _ _ body-box _)
                  (let
                    [body : AstExpr (ast-node-get body-box)]
                    (lower-function-body-index-from-decls-in-module
                      rest
                      rest-paths
                      entry-path
                      module
                      all-decls
                      all-paths
                      base-names
                      base-name-cache
                      module-name-cache
                      (lower-function-body-index-add
                        index
                        (lower-decl-logical-name
                          entry-path
                          decl-path
                          module
                          (intern-str name))
                        module-name-cache
                        body
                        decl-path)))]
                [(AstDecl.ComptimeDecl _ _)
                  (lower-function-body-index-from-decls-in-module
                    (ast-decl-cons inner rest)
                    (ast-decl-path-cons decl-path rest-paths)
                    entry-path
                    module
                    all-decls
                    all-paths
                    base-names
                    base-name-cache
                    module-name-cache
                    index)]
                [_
                  (lower-function-body-index-from-decls-in-module
                    rest
                    rest-paths
                    entry-path
                    module
                    all-decls
                    all-paths
                    base-names
                    base-name-cache
                    module-name-cache
                    index)]))]
          [_
            (lower-function-body-index-from-decls-in-module
              rest
              rest-paths
              entry-path
              module
              all-decls
              all-paths
              base-names
              base-name-cache
              module-name-cache
              index)]))]))

(define (lower-function-body-index-from-decls
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [count : i64]) : LowerFunctionBodyIndex
  (let
    [name-cache : LowerNameCache (lower-name-cache-from-env names)]
    (lower-function-body-index-from-decls-in-module
      decls
      paths
      entry-path
      ""
      decls
      paths
      names
      name-cache
      name-cache
      (lower-function-body-index-empty count))))

(define (lower-reach-process
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [body-index : LowerFunctionBodyIndex]
  [state : LowerReachState]) : LowerReachState
  (match state
    [(LowerReachState reachable worklist)
      (match worklist
        [(LowerStringNil) state]
        [(LowerStringCons name rest)
          (let
            [popped : LowerReachState
              (LowerReachState reachable (box-get rest))]
            (match (lower-function-body-index-find body-index name)
              [(LowerSomeFunctionBody body body-names body-path)
                (begin
                  (set!
                    lower-reach-active-runtime-paths
                    (hashmap.i64-i64-map-put
                      lower-reach-active-runtime-paths
                      (intern body-path)
                      1))
                  (lower-reach-process
                    all-functions
                    names
                    body-index
                    (lower-reach-expr all-functions body-names popped body)))]
              [(LowerNoFunctionBody)
                (lower-reach-process all-functions names body-index popped)]))])]))

(define (lower-dispatch-variant-logical-name
  [module : String]
  [names : LowerNameCache]
  [variant-name : String]) : String
  (lower-name-cache-resolve
    names
    (lower-dispatch-source-name module variant-name)))

(define (lower-dispatch-variant-set-add-list
  [variants : AstDispatchVariantList]
  [module : String]
  [names : LowerNameCache]
  [out : hashmap.StringI64Map]) : hashmap.StringI64Map
  (match variants
    [(AstDispatchVariantList.Nil) out]
    [(AstDispatchVariantList.Cons variant rest)
      (let
        [rest : AstDispatchVariantList (box-get rest)]
        (match variant
          [(AstDispatchVariant.Variant _ variant-name)
            (lower-dispatch-variant-set-add-list
              rest
              module
              names
              (hashmap.string-i64-map-put
                out
                (lower-dispatch-variant-logical-name module names variant-name)
                1))]))]))

(define (lower-dispatch-variant-set-add-decl
  [decl : AstDecl]
  [module : String]
  [names : LowerNameCache]
  [out : hashmap.StringI64Map]) : hashmap.StringI64Map
  (match decl
    [(AstDecl.DefDispatch _ variants)
      (lower-dispatch-variant-set-add-list variants module names out)]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-dispatch-variant-set-add-decl template module names out))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-dispatch-variant-set-add-decl inner module names out))]
    [_ out]))

(define (lower-dispatch-variant-set-from-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [names : LowerNameCache]
  [out : hashmap.StringI64Map]) : hashmap.StringI64Map
  (match decls
    [(AstDeclList.Nil) out]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathList.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList (box-get path-rest)]
                path-rest)]
            [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
        (match decl
          [(AstDecl.Module next-module)
            (lower-dispatch-variant-set-from-decls-in-module
              rest
              rest-paths
              entry-path
              (intern-str next-module)
              names
              out)]
          [_
            (lower-dispatch-variant-set-from-decls-in-module
              rest
              rest-paths
              entry-path
              module
              names
              (lower-dispatch-variant-set-add-decl decl module names out))]))]))

(define (lower-dispatch-variant-set-from-decls
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameCache]) : hashmap.StringI64Map
  (lower-dispatch-variant-set-from-decls-in-module
    decls
    paths
    entry-path
    ""
    names
    (hashmap.string-i64-map-with-capacity 1024)))

(define (lower-reach-add-dispatch-variant-list
  [all-functions : hashmap.StringI64Map]
  [module : String]
  [names : LowerNameCache]
  [variants : AstDispatchVariantList]
  [state : LowerReachState]) : LowerReachState
  (match variants
    [(AstDispatchVariantList.Nil) state]
    [(AstDispatchVariantList.Cons variant rest)
      (let
        [rest : AstDispatchVariantList (box-get rest)]
        (match variant
          [(AstDispatchVariant.Variant _ variant-name)
            (lower-reach-add-dispatch-variant-list
              all-functions
              module
              names
              rest
              (lower-reach-add-logical
                all-functions
                state
                (lower-dispatch-variant-logical-name module names variant-name)))]))]))

(define (lower-reach-add-dispatch-variant-decl
  [all-functions : hashmap.StringI64Map]
  [module : String]
  [names : LowerNameCache]
  [decl : AstDecl]
  [state : LowerReachState]) : LowerReachState
  (match decl
    [(AstDecl.DefDispatch _ variants)
      (lower-reach-add-dispatch-variant-list
        all-functions
        module
        names
        variants
        state)]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (lower-reach-add-dispatch-variant-decl
          all-functions
          module
          names
          template
          state))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-reach-add-dispatch-variant-decl
          all-functions
          module
          names
          inner
          state))]
    [_ state]))

(define (lower-reach-add-dispatch-variant-roots-in-module
  [all-functions : hashmap.StringI64Map]
  [decls : AstDeclList]
  [module : String]
  [names : LowerNameCache]
  [state : LowerReachState]) : LowerReachState
  (match decls
    [(AstDeclList.Nil) state]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.Module next-module)
            (lower-reach-add-dispatch-variant-roots-in-module
              all-functions
              rest
              (intern-str next-module)
              names
              state)]
          [_
            (lower-reach-add-dispatch-variant-roots-in-module
              all-functions
              rest
              module
              names
              (lower-reach-add-dispatch-variant-decl
                all-functions
                module
                names
                decl
                state))]))]))

(define (lower-reach-add-dispatch-variant-roots
  [all-functions : hashmap.StringI64Map]
  [decls : AstDeclList]
  [names : LowerNameCache]
  [state : LowerReachState]) : LowerReachState
  (lower-reach-add-dispatch-variant-roots-in-module
    all-functions
    decls
    ""
    names
    state))

;; #3792: `reachable` is keyed by dense `all-functions` slot; resolve a name's
;; slot through the same map the reach walk used and test membership by i64.
(define (lower-reach-slot-set-contains-name?
  [all-functions : hashmap.StringI64Map]
  [reachable : hashmap.I64I64Map]
  [logical-name : String]) : bool
  (match (hashmap.string-i64-map-get all-functions logical-name)
    [(hashmap.StringI64MapMissing) false]
    [(hashmap.StringI64MapFound slot)
      (hashmap.i64-i64-map-contains? reachable slot)]))

(define (lower-function-kept-by-reach-or-dispatch?
  [all-functions : hashmap.StringI64Map]
  [reachable : hashmap.I64I64Map]
  [dispatch-variants : hashmap.StringI64Map]
  [logical-name : String]) : bool
  (or
    (lower-reach-slot-set-contains-name? all-functions reachable logical-name)
    (hashmap.string-i64-map-contains? dispatch-variants logical-name)))

(define (lower-used-type-name-leaf [name : String]) : String
  (let
    [source : String
      (if (tc-name-qualified? name)
        (tc-qualified-name-base name)
        name)]
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length source)]
    (begin
      (while (< i n)
        (begin
          (if (string.char-eq (string.string-ref source i) '.')
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      (if (and (>= last-dot 0) (< last-dot (- n 1)))
        (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
        source))))

(define (lower-used-type-name-add
  [used : hashmap.I64I64Map]
  [_module : String]
  [name : i64]) : hashmap.I64I64Map
  (let
    [source : String (intern-str name)]
    [with-source : hashmap.I64I64Map (hashmap.i64-i64-map-put used name 1)]
    (if (or (tc-name-qualified? source) (>= (tc-name-first-dot source) 0))
      (let
        [leaf : String (lower-used-type-name-leaf source)]
        (if (string.eq leaf source)
          with-source
          (hashmap.i64-i64-map-put with-source (intern leaf) 1)))
      with-source)))

(define (lower-used-type-name-contains?
  [used : hashmap.I64I64Map]
  [_module : String]
  [name : i64]) : bool
  (if (hashmap.i64-i64-map-contains? used name)
    true
    (let
      [source : String (intern-str name)]
      (if (or (tc-name-qualified? source) (>= (tc-name-first-dot source) 0))
        (let
          [leaf : String (lower-used-type-name-leaf source)]
          (if (string.eq leaf source)
            false
            (hashmap.i64-i64-map-contains? used (intern leaf))))
        false))))

(define (lower-used-types-precise-empty) : hashmap.I64I64Map
  (hashmap.i64-i64-map-put
    (hashmap.i64-i64-map-with-capacity 8192)
    (intern "$lower.precise-type-dce")
    1))

(define (lower-used-types-add-type-id
  [used : hashmap.I64I64Map]
  [module : String]
  [ty-id : i64]) : hashmap.I64I64Map
  (lower-used-types-add-type used module (ty-node-get ty-id)))

(define (lower-used-types-add-type-list
  [used : hashmap.I64I64Map]
  [module : String]
  [types : AstTypeList]) : hashmap.I64I64Map
  (match types
    [(AstTypeList.Nil) used]
    [(AstTypeList.Cons head rest)
      (lower-used-types-add-type-list
        (lower-used-types-add-type-id used module head)
        module
        (box-get rest))]))

(define (lower-used-types-add-type
  [used : hashmap.I64I64Map]
  [module : String]
  [ty : AstType]) : hashmap.I64I64Map
  (match ty
    [(AstType.Func args ret)
      (lower-used-types-add-type-id
        (lower-used-types-add-type-list used module (box-get args))
        module
        ret)]
    [(AstType.Tuple elems)
      (lower-used-types-add-type-list used module (box-get elems))]
    [(AstType.Array elem _) (lower-used-types-add-type-id used module elem)]
    [(AstType.DynArray elem) (lower-used-types-add-type-id used module elem)]
    [(AstType.Box elem) (lower-used-types-add-type-id used module elem)]
    [(AstType.Region _ inner) (lower-used-types-add-type-id used module inner)]
    [(AstType.Ref _ inner) (lower-used-types-add-type-id used module inner)]
    [(AstType.MutRef _ inner) (lower-used-types-add-type-id used module inner)]
    [(AstType.Enum name) (lower-used-type-name-add used module name)]
    [(AstType.EnumArgs name _) (lower-used-type-name-add used module name)]
    [(AstType.Struct name) (lower-used-type-name-add used module name)]
    [(AstType.StructArgs name _) (lower-used-type-name-add used module name)]
    [(AstType.Var name) (lower-used-type-name-add used module name)]
    [(AstType.VarArgs name _) (lower-used-type-name-add used module name)]
    [(AstType.Ptr inner) (lower-used-types-add-type-id used module inner)]
    [(AstType.MutPtr inner) (lower-used-types-add-type-id used module inner)]
    [_ used]))

(define (lower-used-types-add-maybe-type
  [used : hashmap.I64I64Map]
  [module : String]
  [maybe-ty : AstMaybeType]) : hashmap.I64I64Map
  (match maybe-ty
    [(AstMaybeType.No) used]
    [(AstMaybeType.Some ty) (lower-used-types-add-type used module ty)]))

(define (lower-used-types-add-param-list
  [used : hashmap.I64I64Map]
  [module : String]
  [params : AstParamList]) : hashmap.I64I64Map
  (match params
    [(AstParamList.Nil) used]
    [(AstParamList.Cons param rest)
      (match param
        [(AstParam.Param _ ty _)
          (lower-used-types-add-param-list
            (lower-used-types-add-type used module ty)
            module
            (box-get rest))])]))

(define (lower-used-types-add-macro-param-list
  [used : hashmap.I64I64Map]
  [module : String]
  [params : AstMacroParamList]) : hashmap.I64I64Map
  (match params
    [(AstMacroParamList.Nil) used]
    [(AstMacroParamList.Cons param rest)
      (match param
        [(AstMacroParam.Param _ ty _)
          (lower-used-types-add-macro-param-list
            (lower-used-types-add-type used module ty)
            module
            (box-get rest))])]))

(define (lower-used-types-add-expr-id
  [used : hashmap.I64I64Map]
  [module : String]
  [expr-id : i64]) : hashmap.I64I64Map
  (lower-used-types-add-expr used module (ast-node-get expr-id)))

(define (lower-used-types-add-expr-list
  [used : hashmap.I64I64Map]
  [module : String]
  [exprs : AstExprList]) : hashmap.I64I64Map
  (match exprs
    [(AstExprList.Nil) used]
    [(AstExprList.Cons expr rest)
      (lower-used-types-add-expr-list
        (lower-used-types-add-expr-id used module expr)
        module
        (box-get rest))]))

(define (lower-used-types-add-pattern
  [used : hashmap.I64I64Map]
  [module : String]
  [pattern : AstPattern]) : hashmap.I64I64Map
  (match pattern
    [(AstPattern.Var _ maybe-ty)
      (lower-used-types-add-maybe-type used module maybe-ty)]
    [(AstPattern.Tuple patterns-box)
      (lower-used-types-add-pattern-list used module (box-get patterns-box))]
    [(AstPattern.Wildcard) used]
    [(AstPattern.Binding _) used]
    [(AstPattern.Variant name patterns-box)
      (let
        [name-str : String (intern-str name)]
        [with-head : hashmap.I64I64Map
          (if (or
            (tc-name-qualified? name-str)
            (>= (tc-name-first-dot name-str) 0))
            (lower-used-type-name-add used module name)
            used)]
        (lower-used-types-add-pattern-list
          with-head
          module
          (box-get patterns-box)))]
    [(AstPattern.Literal _) used]))

(define (lower-used-types-add-pattern-list
  [used : hashmap.I64I64Map]
  [module : String]
  [patterns : AstPatternList]) : hashmap.I64I64Map
  (match patterns
    [(AstPatternList.Nil) used]
    [(AstPatternList.Cons pattern rest)
      (lower-used-types-add-pattern-list
        (lower-used-types-add-pattern used module (box-get pattern))
        module
        (box-get rest))]))

(define (lower-used-types-add-let-bindings
  [used : hashmap.I64I64Map]
  [module : String]
  [bindings : AstLetBindingList]) : hashmap.I64I64Map
  (match bindings
    [(AstLetBindingList.Nil) used]
    [(AstLetBindingList.Cons binding rest)
      (match binding
        [(AstLetBinding.Binding _ maybe-ty value-box)
          (lower-used-types-add-let-bindings
            (lower-used-types-add-expr-id
              (lower-used-types-add-maybe-type used module maybe-ty)
              module
              value-box)
            module
            (box-get rest))])]))

(define (lower-used-types-add-match-arms
  [used : hashmap.I64I64Map]
  [module : String]
  [arms : AstMatchArmList]) : hashmap.I64I64Map
  (match arms
    [(AstMatchArmList.Nil) used]
    [(AstMatchArmList.Cons arm rest)
      (match arm
        [(AstMatchArm.Arm pattern body-box)
          (lower-used-types-add-match-arms
            (lower-used-types-add-expr-id
              (lower-used-types-add-pattern used module pattern)
              module
              body-box)
            module
            (box-get rest))])]))

(define (lower-used-types-add-resource-bindings
  [used : hashmap.I64I64Map]
  [module : String]
  [bindings : AstResourceBindingList]) : hashmap.I64I64Map
  (match bindings
    [(AstResourceBindingList.Nil) used]
    [(AstResourceBindingList.Cons binding rest)
      (match binding
        [(AstResourceBinding.Binding _ acquire-box cleanup-box)
          (lower-used-types-add-resource-bindings
            (lower-used-types-add-expr-id
              (lower-used-types-add-expr-id used module acquire-box)
              module
              cleanup-box)
            module
            (box-get rest))])]))

(define (lower-used-types-add-expr
  [used : hashmap.I64I64Map]
  [module : String]
  [expr : AstExpr]) : hashmap.I64I64Map
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.Literal _) used]
    [(AstExpr.Var _) used]
    [(AstExpr.Binary _ lhs-box rhs-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module lhs-box)
        module
        rhs-box)]
    [(AstExpr.Unary _ inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.Call callee-box args)
      (lower-used-types-add-expr-list
        (lower-used-types-add-expr-id used module callee-box)
        module
        args)]
    [(AstExpr.If cond-box then-box else-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id
          (lower-used-types-add-expr-id used module cond-box)
          module
          then-box)
        module
        else-box)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (lower-used-types-add-expr-id
            (lower-used-types-add-let-bindings used module bindings)
            module
            body-box)])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params ret body-box)
          (lower-used-types-add-expr-id
            (lower-used-types-add-maybe-type
              (lower-used-types-add-param-list used module params)
              module
              ret)
            module
            body-box)])]
    [(AstExpr.Tuple values) (lower-used-types-add-expr-list used module values)]
    [(AstExpr.TupleRef value-box _)
      (lower-used-types-add-expr-id used module value-box)]
    [(AstExpr.Array values) (lower-used-types-add-expr-list used module values)]
    [(AstExpr.MakeArray ty len-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-type used module ty)
        module
        len-box)]
    [(AstExpr.ArrayRef array-box index-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module array-box)
        module
        index-box)]
    [(AstExpr.ArraySet array-box index-box value-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id
          (lower-used-types-add-expr-id used module array-box)
          module
          index-box)
        module
        value-box)]
    [(AstExpr.ArrayPush array-box value-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module array-box)
        module
        value-box)]
    [(AstExpr.StringRef text-box index-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module text-box)
        module
        index-box)]
    [(AstExpr.While cond-box body-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module cond-box)
        module
        body-box)]
    [(AstExpr.Begin exprs) (lower-used-types-add-expr-list used module exprs)]
    [(AstExpr.Unsafe exprs) (lower-used-types-add-expr-list used module exprs)]
    [(AstExpr.Set _ value-box)
      (lower-used-types-add-expr-id used module value-box)]
    [(AstExpr.Ann inner-box ty)
      (lower-used-types-add-expr-id
        (lower-used-types-add-type used module ty)
        module
        inner-box)]
    [(AstExpr.Cast inner-box ty)
      (lower-used-types-add-expr-id
        (lower-used-types-add-type used module ty)
        module
        inner-box)]
    [(AstExpr.Borrow _ _ inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match value-box arms)
          (lower-used-types-add-match-arms
            (lower-used-types-add-expr-id used module value-box)
            module
            arms)])]
    [(AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(AstForeach.Foreach _ index-ty start-box end-box body-box)
          (lower-used-types-add-expr-id
            (lower-used-types-add-expr-id
              (lower-used-types-add-expr-id
                (lower-used-types-add-type used module index-ty)
                module
                start-box)
              module
              end-box)
            module
            body-box)])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            _
            _
            index-ty
            source-box
            init-box
            map-expr-box
            reduce-expr-box)
          (lower-used-types-add-expr-id
            (lower-used-types-add-expr-id
              (lower-used-types-add-expr-id
                (lower-used-types-add-expr-id
                  (lower-used-types-add-type used module index-ty)
                  module
                  source-box)
                module
                init-box)
              module
              map-expr-box)
            module
            reduce-expr-box)])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            index-ty
            start-box
            end-box
            _
            prefix-ty
            init-box
            value-box
            body-box)
          (lower-used-types-add-expr-id
            (lower-used-types-add-expr-id
              (lower-used-types-add-expr-id
                (lower-used-types-add-expr-id
                  (lower-used-types-add-expr-id
                    (lower-used-types-add-type
                      (lower-used-types-add-type used module index-ty)
                      module
                      prefix-ty)
                    module
                    start-box)
                  module
                  end-box)
                module
                init-box)
              module
              value-box)
            module
            body-box)])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module value-box)
        module
        lane-box)]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module value-box)
        module
        lane-box)]
    [(AstExpr.StructGet value-box _)
      (lower-used-types-add-expr-id used module value-box)]
    [(AstExpr.StructSet receiver-box _ value-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module receiver-box)
        module
        value-box)]
    [(AstExpr.WithRegion _ exprs)
      (lower-used-types-add-expr-list used module exprs)]
    [(AstExpr.WithEscape scratch-box exprs)
      (lower-used-types-add-expr-list
        (lower-used-types-add-expr-id used module scratch-box)
        module
        exprs)]
    [(AstExpr.WithScratch exprs)
      (lower-used-types-add-expr-list used module exprs)]
    [(AstExpr.InArena arena-box exprs)
      (lower-used-types-add-expr-list
        (lower-used-types-add-expr-id used module arena-box)
        module
        exprs)]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (lower-used-types-add-expr-list
            (lower-used-types-add-resource-bindings used module bindings)
            module
            body)])]
    [(AstExpr.Box inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.BoxGet inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.BoxTake inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.BoxSet inner-box value-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module inner-box)
        module
        value-box)]
    [(AstExpr.TypeLiteral ty) (lower-used-types-add-type used module ty)]
    [(AstExpr.Init maybe-ty)
      (lower-used-types-add-maybe-type used module maybe-ty)]
    [(AstExpr.Comptime inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.Quote _) used]
    [(AstExpr.Quasiquote _) used]
    [(AstExpr.Unquote inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.UnquoteSplicing inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.BracketClause items)
      (lower-used-types-add-expr-list used module items)]
    [(AstExpr.Try inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.Return inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.PtrNull ty) (lower-used-types-add-type used module ty)]
    [(AstExpr.PtrNullCheck value-box)
      (lower-used-types-add-expr-id used module value-box)]
    [(AstExpr.PtrAddrOf _) used]
    [(AstExpr.PtrRead ptr-box)
      (lower-used-types-add-expr-id used module ptr-box)]
    [(AstExpr.PtrWrite ptr-box value-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module ptr-box)
        module
        value-box)]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module ptr-box)
        module
        offset-box)]
    [(AstExpr.PtrCast ptr-box ty)
      (lower-used-types-add-expr-id
        (lower-used-types-add-type used module ty)
        module
        ptr-box)]
    [(AstExpr.PtrToInt ptr-box)
      (lower-used-types-add-expr-id used module ptr-box)]
    [(AstExpr.IntToPtr value-box ty)
      (lower-used-types-add-expr-id
        (lower-used-types-add-type used module ty)
        module
        value-box)]
    [(AstExpr.StringData inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module ptr-box)
        module
        len-box)]
    [(AstExpr.ArrayData inner-box)
      (lower-used-types-add-expr-id used module inner-box)]
    [(AstExpr.BinaryData _) used]
    [(AstExpr.SpmdProgramIndex) used]
    [(AstExpr.SpmdProgramCount) used]
    [(AstExpr.ProgramArgc) used]
    [(AstExpr.ProgramArgv) used]
    [(AstExpr.ProgramEnvp) used]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module leaf-box)
        module
        subleaf-box)]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module leaf-box)
        module
        subleaf-box)]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module leaf-box)
        module
        subleaf-box)]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        (lower-used-types-add-expr-id used module leaf-box)
        module
        subleaf-box)]
    [(AstExpr.Xgetbv index-box)
      (lower-used-types-add-expr-id used module index-box)]
    [(AstExpr.Syscall args) (lower-used-types-add-expr-list used module args)]))

(define (lower-used-types-add-field-list
  [used : hashmap.I64I64Map]
  [module : String]
  [fields : AstFieldDefList]) : hashmap.I64I64Map
  (match fields
    [(AstFieldDefList.Nil) used]
    [(AstFieldDefList.Cons field rest)
      (match field
        [(AstFieldDef.Def _ ty _)
          (lower-used-types-add-field-list
            (lower-used-types-add-type used module ty)
            module
            (box-get rest))])]))

(define (lower-used-types-add-variant-list
  [used : hashmap.I64I64Map]
  [module : String]
  [variants : AstVariantDefList]) : hashmap.I64I64Map
  (match variants
    [(AstVariantDefList.Nil) used]
    [(AstVariantDefList.Cons variant rest)
      (match variant
        [(AstVariantDef.Def _ fields _)
          (lower-used-types-add-variant-list
            (lower-used-types-add-type-list used module fields)
            module
            (box-get rest))])]))

(define (lower-type-decl? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefEnum _ _ _) true]
    [(AstDecl.DefEnumLifetimes _ _ _ _) true]
    [(AstDecl.DefStruct _ _ _ _) true]
    [(AstDecl.DefStructLifetimes _ _ _ _ _) true]
    [(AstDecl.Unsafe inner-box) (lower-type-decl? (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ inner-box) (lower-type-decl? (box-get inner-box))]
    [_ false]))

(define (lower-type-decl-used?
  [module : String]
  [used-types : hashmap.I64I64Map]
  [decl : AstDecl]) : bool
  ;; Empty is the fast-path marker for "all type declaration paths are already
  ;; reachable"; precise DCE starts from lower-used-types-precise-empty instead.
  (if (= (hashmap.i64-i64-map-len used-types) 0)
    true
    (match decl
      [(AstDecl.DefEnum name _ variants)
        (lower-used-type-name-contains? used-types module name)]
      [(AstDecl.DefEnumLifetimes name _ _ variants)
        (lower-used-type-name-contains? used-types module name)]
      [(AstDecl.DefStruct name _ _ _)
        (lower-used-type-name-contains? used-types module name)]
      [(AstDecl.DefStructLifetimes name _ _ _ _)
        (lower-used-type-name-contains? used-types module name)]
      [(AstDecl.Unsafe inner-box)
        (lower-type-decl-used? module used-types (box-get inner-box))]
      [(AstDecl.ComptimeDecl _ inner-box)
        (lower-type-decl-used? module used-types (box-get inner-box))]
      [_ true])))

(define (lower-used-types-add-kept-runtime-decl
  [used : hashmap.I64I64Map]
  [module : String]
  [decl : AstDecl]) : hashmap.I64I64Map
  (match decl
    [(AstDecl.Def _ maybe-ty _)
      (lower-used-types-add-maybe-type used module maybe-ty)]
    [(AstDecl.DefFn _ params ret _ _)
      (lower-used-types-add-type
        (lower-used-types-add-param-list used module params)
        module
        ret)]
    [(AstDecl.DefMacro _ params ret _)
      (lower-used-types-add-type
        (lower-used-types-add-macro-param-list used module params)
        module
        ret)]
    [(AstDecl.Extern _ _ _ ty) (lower-used-types-add-type used module ty)]
    [(AstDecl.DefEnum _ _ _) used]
    [(AstDecl.DefEnumLifetimes _ _ _ _) used]
    [(AstDecl.DefStruct _ _ _ _) used]
    [(AstDecl.DefStructLifetimes _ _ _ _ _) used]
    [(AstDecl.Test _ body-box _)
      (lower-used-types-add-expr-id used module body-box)]
    [(AstDecl.Unsafe inner-box)
      (lower-used-types-add-kept-runtime-decl used module (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ inner-box)
      (lower-used-types-add-kept-runtime-decl used module (box-get inner-box))]
    [_ used]))

(define (lower-runtime-decl-kept-by-reach-or-dispatch?
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [all-functions : hashmap.StringI64Map]
  [reachable : hashmap.I64I64Map]
  [dispatch-variants : hashmap.StringI64Map]
  [decl : AstDecl]) : bool
  (match (lower-function-logical-name-from-decl
    entry-path
    decl-path
    module
    decl)
    [(TcMaybeString.Some logical-name)
      (lower-function-kept-by-reach-or-dispatch?
        all-functions
        reachable
        dispatch-variants
        logical-name)]
    [(TcMaybeString.No) true]))

(define (lower-used-types-add-type-decl-name
  [used : hashmap.I64I64Map]
  [module : String]
  [decl : AstDecl]) : hashmap.I64I64Map
  (match decl
    [(AstDecl.DefEnum name _ _) (lower-used-type-name-add used module name)]
    [(AstDecl.DefEnumLifetimes name _ _ _)
      (lower-used-type-name-add used module name)]
    [(AstDecl.DefStruct name _ _ _) (lower-used-type-name-add used module name)]
    [(AstDecl.DefStructLifetimes name _ _ _ _)
      (lower-used-type-name-add used module name)]
    [(AstDecl.Unsafe inner-box)
      (lower-used-types-add-type-decl-name used module (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ inner-box)
      (lower-used-types-add-type-decl-name used module (box-get inner-box))]
    [_ used]))

(define (lower-used-types-path-seed-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [reachable-paths : hashmap.I64I64Map]
  [used : hashmap.I64I64Map]
  [covered : bool]) : LowerUsedTypePathSeed
  (match decls
    [(AstDeclList.Nil) (LowerUsedTypePathSeed used covered)]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [decl-path : String
          (match paths
            [(AstDeclPathList.Cons path _) path]
            [(AstDeclPathList.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathList.Cons _ path-rest) (box-get path-rest)]
            [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
        (match decl
          [(AstDecl.Module next-module)
            (lower-used-types-path-seed-in-module
              rest
              rest-paths
              entry-path
              (intern-str next-module)
              reachable-paths
              used
              covered)]
          [_
            (let
              [is-type-decl : bool (lower-type-decl? decl)]
              [path-covered : bool
                (hashmap.i64-i64-map-contains?
                  reachable-paths
                  (intern decl-path))]
              (lower-used-types-path-seed-in-module
                rest
                rest-paths
                entry-path
                module
                reachable-paths
                (if (and is-type-decl path-covered)
                  (lower-used-types-add-type-decl-name used module decl)
                  used)
                (and covered (or (not is-type-decl) path-covered))))]))]))

(define (lower-used-types-from-kept-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [all-functions : hashmap.StringI64Map]
  [reachable : hashmap.I64I64Map]
  [dispatch-variants : hashmap.StringI64Map]
  [used : hashmap.I64I64Map]) : hashmap.I64I64Map
  (match decls
    [(AstDeclList.Nil) used]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [decl-path : String
          (match paths
            [(AstDeclPathList.Cons path _) path]
            [(AstDeclPathList.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathList.Cons _ path-rest) (box-get path-rest)]
            [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
        (match decl
          [(AstDecl.Module next-module)
            (lower-used-types-from-kept-decls-in-module
              rest
              rest-paths
              entry-path
              (intern-str next-module)
              all-functions
              reachable
              dispatch-variants
              used)]
          [_
            (lower-used-types-from-kept-decls-in-module
              rest
              rest-paths
              entry-path
              module
              all-functions
              reachable
              dispatch-variants
              (if (lower-runtime-decl-kept-by-reach-or-dispatch?
                entry-path
                decl-path
                module
                all-functions
                reachable
                dispatch-variants
                decl)
                (lower-used-types-add-kept-runtime-decl used module decl)
                used))]))]))

(define (lower-used-types-add-stdlib-arena-support-deps
  [used : hashmap.I64I64Map]
  [module : String]
  [name : i64]) : hashmap.I64I64Map
  ;; `in-arena` and allocation lowering use the arena mark support type even
  ;; when source signatures only mention the public Arena wrapper.
  (if (and
    (string.eq module "stdlib.arena")
    (string.eq (intern-str name) "Arena"))
    (lower-used-type-name-add used module (intern "ArenaMark"))
    used))

(define (lower-used-types-add-type-decl-deps
  [used : hashmap.I64I64Map]
  [module : String]
  [decl : AstDecl]) : hashmap.I64I64Map
  (match decl
    [(AstDecl.DefEnum _ _ variants)
      (lower-used-types-add-variant-list used module variants)]
    [(AstDecl.DefEnumLifetimes _ _ _ variants)
      (lower-used-types-add-variant-list used module variants)]
    [(AstDecl.DefStruct name _ _ fields)
      (lower-used-types-add-field-list
        (lower-used-types-add-stdlib-arena-support-deps used module name)
        module
        fields)]
    [(AstDecl.DefStructLifetimes _ _ _ _ fields)
      (lower-used-types-add-field-list used module fields)]
    [(AstDecl.Unsafe inner-box)
      (lower-used-types-add-type-decl-deps used module (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ inner-box)
      (lower-used-types-add-type-decl-deps used module (box-get inner-box))]
    [_ used]))

(define (lower-used-types-add-type-decl-deps-in-module
  [decls : AstDeclList]
  [module : String]
  [used : hashmap.I64I64Map]) : hashmap.I64I64Map
  (match decls
    [(AstDeclList.Nil) used]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.Module next-module)
            (lower-used-types-add-type-decl-deps-in-module
              rest
              (intern-str next-module)
              used)]
          [_
            (lower-used-types-add-type-decl-deps-in-module
              rest
              module
              (if (and
                (lower-type-decl? decl)
                (or
                  (lower-comptime-runtime-skip-module? module)
                  (lower-type-decl-used? module used decl)))
                (lower-used-types-add-type-decl-deps used module decl)
                used))]))]))

(define (lower-used-types-expand-fixed
  [decls : AstDeclList]
  [used : hashmap.I64I64Map]) : hashmap.I64I64Map
  (let
    [current : hashmap.I64I64Map used]
    [iterations : i64 0]
    [done : bool false]
    (begin
      (while (not done)
        (let
          [before : i64 (hashmap.i64-i64-map-len current)]
          [next : hashmap.I64I64Map
            (lower-used-types-add-type-decl-deps-in-module decls "" current)]
          (begin
            (set! current next)
            (set! iterations (+ iterations 1))
            (if (or
              (= before (hashmap.i64-i64-map-len current))
              (>= iterations 8))
              (set! done true)
              unit))))
      current)))

(define (lower-comptime-runtime-skip-module? [module : String]) : bool
  (string.eq module "stdlib.comptime"))

(define (lower-no-main-entry-prune-active?) : bool
  lower-no-main-entry-prune-active)

(define (lower-no-main-entry-prune-set! [active : bool]) : unit
  (set! lower-no-main-entry-prune-active active))

(define lower-comptime-error-id-generation : i64
  -1)
(define lower-comptime-error-id : i64
  0)
(define lower-comptime-error-comptime-dot-id : i64
  0)
(define lower-comptime-error-comptime-slash-id : i64
  0)
(define lower-comptime-error-comptime-error-dot-id : i64
  0)
(define lower-comptime-error-comptime-error-slash-id : i64
  0)
(define lower-comptime-error-stdlib-dot-dot-id : i64
  0)
(define lower-comptime-error-stdlib-dot-slash-id : i64
  0)
(define lower-comptime-error-stdlib-slash-dot-id : i64
  0)
(define lower-comptime-error-stdlib-slash-slash-id : i64
  0)
(define lower-comptime-error-stdlib-error-dot-dot-id : i64
  0)
(define lower-comptime-error-stdlib-error-dot-slash-id : i64
  0)
(define lower-comptime-error-stdlib-error-slash-dot-id : i64
  0)
(define lower-comptime-error-stdlib-error-slash-slash-id : i64
  0)

(define (lower-comptime-error-ids-ensure!) : unit
  (if (= lower-comptime-error-id-generation (intern-generation))
    unit
    (begin
      (set! lower-comptime-error-id (intern "comptime-error"))
      (set!
        lower-comptime-error-comptime-dot-id
        (intern "comptime.comptime-error"))
      (set!
        lower-comptime-error-comptime-slash-id
        (intern "comptime/comptime-error"))
      (set!
        lower-comptime-error-comptime-error-dot-id
        (intern "comptime.error"))
      (set!
        lower-comptime-error-comptime-error-slash-id
        (intern "comptime/error"))
      (set!
        lower-comptime-error-stdlib-dot-dot-id
        (intern "stdlib.comptime.comptime-error"))
      (set!
        lower-comptime-error-stdlib-dot-slash-id
        (intern "stdlib.comptime/comptime-error"))
      (set!
        lower-comptime-error-stdlib-slash-dot-id
        (intern "stdlib/comptime.comptime-error"))
      (set!
        lower-comptime-error-stdlib-slash-slash-id
        (intern "stdlib/comptime/comptime-error"))
      (set!
        lower-comptime-error-stdlib-error-dot-dot-id
        (intern "stdlib.comptime.error"))
      (set!
        lower-comptime-error-stdlib-error-dot-slash-id
        (intern "stdlib.comptime/error"))
      (set!
        lower-comptime-error-stdlib-error-slash-dot-id
        (intern "stdlib/comptime.error"))
      (set!
        lower-comptime-error-stdlib-error-slash-slash-id
        (intern "stdlib/comptime/error"))
      (set! lower-comptime-error-id-generation (intern-generation)))))

(define (lower-comptime-error-call-id-with-cache? [id : i64]) : bool
  (or
    (= id lower-comptime-error-id)
    (= id lower-comptime-error-comptime-dot-id)
    (= id lower-comptime-error-comptime-slash-id)
    (= id lower-comptime-error-comptime-error-dot-id)
    (= id lower-comptime-error-comptime-error-slash-id)
    (= id lower-comptime-error-stdlib-dot-dot-id)
    (= id lower-comptime-error-stdlib-dot-slash-id)
    (= id lower-comptime-error-stdlib-slash-dot-id)
    (= id lower-comptime-error-stdlib-slash-slash-id)
    (= id lower-comptime-error-stdlib-error-dot-dot-id)
    (= id lower-comptime-error-stdlib-error-dot-slash-id)
    (= id lower-comptime-error-stdlib-error-slash-dot-id)
    (= id lower-comptime-error-stdlib-error-slash-slash-id)))

(define (lower-comptime-error-call-id? [id : i64]) : bool
  (begin
    (lower-comptime-error-ids-ensure!)
    (lower-comptime-error-call-id-with-cache? id)))

(define (lower-comptime-error-source-or-lookup-id?
  [source-id : i64]
  [lookup-id : i64]) : bool
  (begin
    (lower-comptime-error-ids-ensure!)
    (or
      (= source-id lower-comptime-error-id)
      (= source-id lower-comptime-error-comptime-dot-id)
      (= source-id lower-comptime-error-comptime-slash-id)
      (= source-id lower-comptime-error-comptime-error-dot-id)
      (= source-id lower-comptime-error-comptime-error-slash-id)
      (= source-id lower-comptime-error-stdlib-dot-dot-id)
      (= source-id lower-comptime-error-stdlib-dot-slash-id)
      (= source-id lower-comptime-error-stdlib-slash-dot-id)
      (= source-id lower-comptime-error-stdlib-slash-slash-id)
      (= source-id lower-comptime-error-stdlib-error-dot-dot-id)
      (= source-id lower-comptime-error-stdlib-error-dot-slash-id)
      (= source-id lower-comptime-error-stdlib-error-slash-dot-id)
      (= source-id lower-comptime-error-stdlib-error-slash-slash-id)
      (lower-comptime-error-call-id-with-cache? lookup-id))))

(define (lower-decl-kept-by-reach-or-dispatch?
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [all-functions : hashmap.StringI64Map]
  [reachable : hashmap.I64I64Map]
  [dispatch-variants : hashmap.StringI64Map]
  [used-types : hashmap.I64I64Map]
  [decl : AstDecl]) : bool
  (if (lower-type-decl? decl)
    (or
      (lower-comptime-runtime-skip-module? module)
      (lower-type-decl-used? module used-types decl))
    (lower-runtime-decl-kept-by-reach-or-dispatch?
      entry-path
      decl-path
      module
      all-functions
      reachable
      dispatch-variants
      decl)))

(define (lower-filter-reachable-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [all-functions : hashmap.StringI64Map]
  [reachable : hashmap.I64I64Map]
  [dispatch-variants : hashmap.StringI64Map]
  [used-types : hashmap.I64I64Map]) : LowerFilteredReachable
  (match decls
    [(AstDeclList.Nil)
      (LowerFilteredReachable AstDeclList.Nil AstDeclPathList.Nil)]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [decl-path : String
          (match paths
            [(AstDeclPathList.Cons path _) path]
            [(AstDeclPathList.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathList.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList (box-get path-rest)]
                path-rest)]
            [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
        (match decl
          [(AstDecl.Module next-module)
            (match (lower-filter-reachable-in-module
              rest
              rest-paths
              entry-path
              (intern-str next-module)
              all-functions
              reachable
              dispatch-variants
              used-types)
              [(LowerFilteredReachable rest-decls rest-paths)
                (LowerFilteredReachable
                  (ast-decl-cons decl rest-decls)
                  (ast-decl-path-cons decl-path rest-paths))])]
          [_
            (match (lower-filter-reachable-in-module
              rest
              rest-paths
              entry-path
              module
              all-functions
              reachable
              dispatch-variants
              used-types)
              [(LowerFilteredReachable rest-decls rest-paths)
                (if (lower-decl-kept-by-reach-or-dispatch?
                  entry-path
                  decl-path
                  module
                  all-functions
                  reachable
                  dispatch-variants
                  used-types
                  decl)
                  (LowerFilteredReachable
                    (ast-decl-cons decl rest-decls)
                    (ast-decl-path-cons decl-path rest-paths))
                  (LowerFilteredReachable rest-decls rest-paths))])]))]))

;; Keep decls and paths in lockstep so pruning does not repeat the same
;; reachability predicate walk over the whole declaration list.
(define (lower-filter-reachable-decls-and-paths
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [all-functions : hashmap.StringI64Map]
  [reachable : hashmap.I64I64Map]
  [dispatch-variants : hashmap.StringI64Map]
  [used-types : hashmap.I64I64Map]) : LowerFilteredReachable
  (lower-filter-reachable-in-module
    decls
    paths
    entry-path
    ""
    all-functions
    reachable
    dispatch-variants
    used-types))

;; The synthesized clone$<T> helpers (compiler_clone.tl) are referenced by
;; `(clone x)` forms only after lowering. Seed exactly the helpers needed by
;; clone calls found in already-reachable source functions.
(define (lower-reach-add-clone-root-helpers
  [all-functions : hashmap.StringI64Map]
  [names : LowerNameCache]
  [roots : CloneNameList]
  [state : LowerReachState]) : LowerReachState
  (match roots
    [(CloneNameList.Nil) state]
    [(CloneNameList.Cons name rest)
      (lower-reach-add-clone-root-helpers
        all-functions
        names
        (box-get rest)
        (lower-reach-add-source
          all-functions
          names
          state
          (clone-helper-name name)))]))

;; Functions with an `(:export-symbol …)` declaration (#2143) publish a fixed
;; ABI symbol and may be called only from outside TypeLisp IR (e.g. the
;; backend-emitted bounds/division/shift checks call the runtime-prelude
;; handlers). Seed every exported function as a reachability root so the prune
;; keeps it and its transitive callees even with no IR caller.
(define (lower-reach-add-export-root-decl
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [all-functions : hashmap.StringI64Map]
  [state : LowerReachState]
  [decl : AstDecl]) : LowerReachState
  (match decl
    [(AstDecl.DefFn name _ _ _ export)
      (let
        [name-str : String (intern-str name)]
        (match export
          [(AstFnExport.Export _)
            (lower-reach-add-logical
              all-functions
              state
              (lower-decl-logical-name entry-path decl-path module name-str))]
          [(AstFnExport.No) state]))]
    [(AstDecl.Extern _ kind metadata _)
      (match kind
        [(AstExternKind.Function)
          (lower-reach-add-runtime-prelude-string-helper
            all-functions
            state
            (ast-extern-metadata-symbol metadata))]
        [(AstExternKind.Value) state])]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-reach-add-export-root-decl
          entry-path
          decl-path
          module
          all-functions
          state
          inner))]
    [(AstDecl.ComptimeDecl _ inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-reach-add-export-root-decl
          entry-path
          decl-path
          module
          all-functions
          state
          inner))]
    [_ state]))

(define (lower-reach-add-export-roots-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [all-functions : hashmap.StringI64Map]
  [state : LowerReachState]) : LowerReachState
  (match decls
    [(AstDeclList.Nil) state]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [decl-path : String
          (match paths
            [(AstDeclPathList.Cons path _) path]
            [(AstDeclPathList.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathList.Cons _ path-rest) (box-get path-rest)]
            [(AstDeclPathList.Nil) AstDeclPathList.Nil])]
        (match decl
          [(AstDecl.Module next-module)
            (lower-reach-add-export-roots-in-module
              rest
              rest-paths
              entry-path
              (intern-str next-module)
              all-functions
              state)]
          [_
            (lower-reach-add-export-roots-in-module
              rest
              rest-paths
              entry-path
              module
              all-functions
              (lower-reach-add-export-root-decl
                entry-path
                decl-path
                module
                all-functions
                state
                decl))]))]))

(define (lower-prune-unreachable-functions-with-clone-roots
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [names : LowerNameEnv]
  [clone-roots : CloneNameList]) : LowerPrunedProgram
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        ;; #3786: publish the whole-program global name cache so the per-module
        ;; body name-cache overlays built inside lower-function-body-index-from-decls
        ;; (and resolved during lower-reach-process below) can fall through to it.
        ;; Kept in the PERSISTENT (caller) arena so it survives the scratch rewind
        ;; below (the original behavior); decl-lowering re-sets it before use.
        [_set-global : unit
          (begin
            (set!
              lower-active-global-name-cache
              (lower-name-cache-from-env names))
            unit)]
        ;; #3792: the reachability scratch (function/dispatch sets, body index and
        ;; its per-module name overlays, the reachable map) is the bulk of the
        ;; ~163MB / ~12% opt1 lower-phase prune cost and adds zero AST/type pool
        ;; nodes -- pure transient scratch. Build it inside the dedicated lower
        ;; scratch arena and rewind it once the pruned program is materialized.
        ;; The pruned decl/path lists only reference shared decl nodes (by
        ;; AstNodeId) and interned strings, never the scratch maps, so they are
        ;; safe to keep in the persistent arena after the rewind (mirrors the
        ;; scratch+escape pattern in lower-function-escaping).
        [prev-arena : i64 (arena.tl_arena_current)]
        [prev-persist : bool (intern-persistent-storage-on?)]
        [scratch : i64 (lower-scratch-arena-get)]
        (begin
          ;; Force any string interned while the scratch arena is active into the
          ;; persistent intern arena, so the global intern table never retains a
          ;; pointer into memory freed by the rewind below.
          (intern-persistent-storage-enable!)
          (unsafe
            (arena.tl_arena_set scratch))
          (let
            [mark : i64 (arena.tl_region_mark)]
            [all-functions : hashmap.StringI64Map
              (lower-function-set-from-decls decls paths entry-path)]
            [body-index : LowerFunctionBodyIndex
              (lower-function-body-index-from-decls
                decls
                paths
                entry-path
                names
                (lower-function-decl-count decls))]
            [name-cache : LowerNameCache (lower-name-cache-from-env names)]
            [dispatch-variants : hashmap.StringI64Map
              (lower-dispatch-variant-set-from-decls
                decls
                paths
                entry-path
                name-cache)]
            [result : LowerPrunedProgram
              (if (hashmap.string-i64-map-contains? all-functions "main")
                (begin
                  (set!
                    lower-reach-active-runtime-paths
                    (hashmap.i64-i64-map-with-capacity 1024))
                  (set!
                    lower-reach-active-body-used-types
                    (lower-used-types-precise-empty))
                  (match (lower-reach-process
                    all-functions
                    name-cache
                    body-index
                    (lower-reach-global-decls
                      all-functions
                      name-cache
                      (lower-reach-add-dispatch-variant-roots
                        all-functions
                        decls
                        name-cache
                        (lower-reach-add-clone-root-helpers
                          all-functions
                          name-cache
                          clone-roots
                          (lower-reach-cleanup-metadata-roots-in-module
                            all-functions
                            decls
                            paths
                            entry-path
                            ""
                            name-cache
                            (lower-reach-add-export-roots-in-module
                              decls
                              paths
                              entry-path
                              ""
                              all-functions
                              (lower-reach-add-logical
                                all-functions
                                (LowerReachState
                                  (hashmap.i64-i64-map-with-capacity 8192)
                                  LowerStringNil)
                                "main")))))
                      decls))
                    [(LowerReachState reachable _)
                      (let
                        [reachable-runtime-paths : hashmap.I64I64Map
                          lower-reach-active-runtime-paths]
                        [type-path-seed : LowerUsedTypePathSeed
                          (lower-used-types-path-seed-in-module
                            decls
                            paths
                            entry-path
                            ""
                            reachable-runtime-paths
                            lower-reach-active-body-used-types
                            true)]
                        [used-types : hashmap.I64I64Map
                          (match type-path-seed
                            [(LowerUsedTypePathSeed
                                reachable-path-type-names
                                type-paths-covered)
                              (if type-paths-covered
                                (hashmap.i64-i64-map-with-capacity 8)
                                (lower-used-types-expand-fixed
                                  decls
                                  (lower-used-types-from-kept-decls-in-module
                                    decls
                                    paths
                                    entry-path
                                    ""
                                    all-functions
                                    reachable
                                    dispatch-variants
                                    reachable-path-type-names)))])]
                        [scratch-head : i64 (arena.tl_arena_current)]
                        (begin
                          ;; Materialize the pruned program back in the persistent
                          ;; arena before rewinding the scratch arena.
                          (unsafe
                            (arena.tl_arena_set prev-arena))
                          (let
                            [filtered : LowerFilteredReachable
                              (lower-filter-reachable-decls-and-paths
                                decls
                                paths
                                entry-path
                                all-functions
                                reachable
                                dispatch-variants
                                used-types)]
                            [pruned : LowerPrunedProgram
                              (match filtered
                                [(LowerFilteredReachable
                                    filtered-decls
                                    filtered-paths)
                                  (LowerPrunedProgram
                                    (ast-program filtered-decls)
                                    filtered-paths)])]
                            [new-prev-arena : i64 (arena.tl_arena_current)]
                            (begin
                              (unsafe
                                (arena.tl_arena_set scratch-head)
                                (arena.tl_region_reset mark)
                                (arena.tl_arena_set new-prev-arena))
                              pruned))))]))
                (let
                  [scratch-head : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set prev-arena))
                    (LowerPrunedProgram program paths))))]
            (begin
              (if prev-persist
                unit
                (intern-persistent-storage-disable!))
              result))))]))

(define (lower-prune-unreachable-functions
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [names : LowerNameEnv]) : LowerPrunedProgram
  (lower-prune-unreachable-functions-with-clone-roots
    entry-path
    program
    paths
    names
    (CloneNameList.Nil)))

(define (lower-state-next-var [state : LowerState]) : i64
  (match state
    [(LowerState next-var _ _ _ _ _ _ _ _ _ _ _ _ _) next-var]))

(define (lower-state-current-label [state : LowerState]) : String
  (match state
    [(LowerState _ _ _ label _ _ _ _ _ _ _ _ _ _) label]))

(define (lower-state-current-function [state : LowerState]) : String
  (match state
    [(LowerState _ _ _ _ _ _ _ function _ _ _ _ _ _) function]))

(define (lower-state-spans [state : LowerState]) : CompilerSourceSpans
  (match state
    [(LowerState _ _ _ _ _ _ _ _ spans _ _ _ _ _) (box-get spans)]))

(define (lower-state-names [state : LowerState]) : LowerNameCache
  (match state
    [(LowerState _ _ _ _ _ _ _ _ _ names _ _ _ _) names]))

(define (lower-state-type-cache [state : LowerState]) : LowerTypeCache
  (match state
    [(LowerState _ _ _ _ _ _ _ _ _ _ type-cache _ _ _) type-cache]))

(define (lower-state-functions [state : LowerState]) : CompilerIrFunctionList
  (match state
    [(LowerState _ _ _ _ _ _ functions _ _ _ _ _ _ _) (box-get functions)]))

(define (lower-state-mode [state : LowerState]) : CompilerLowerMode
  (match state
    [(LowerState _ _ _ _ _ _ _ _ _ _ _ mode _ _) mode]))

(define (lower-state-tail-param-start [state : LowerState]) : i64
  (match state
    [(LowerState _ _ _ _ _ _ _ _ _ _ _ _ param-start _) param-start]))

(define (lower-state-tail-param-end [state : LowerState]) : i64
  (match state
    [(LowerState _ _ _ _ _ _ _ _ _ _ _ _ _ param-end) param-end]))

(define (lower-state-tail-param-range-contains?
  [state : LowerState]
  [var-id : i64]) : bool
  (and
    (>= var-id (lower-state-tail-param-start state))
    (< var-id (lower-state-tail-param-end state))))

(define (lower-state-clear-tail-param-range [state : LowerState]) : LowerState
  (match state
    [(LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        _
        _)
      (LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        0
        0)]))

(define (lower-state-alloc-var [state : LowerState]) : LowerAlloc
  (match state
    [(LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)
      (LowerAlloc
        (LowerState
          (+ next-var 1)
          next-label
          next-lambda
          current-label
          current-instrs
          blocks
          functions
          function
          spans
          names
          type-cache
          mode
          tail-param-start
          tail-param-end)
        next-var)]))

(define (lower-state-fresh-label [state : LowerState] [prefix : String]) : LowerLabel
  (match state
    [(LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)
      (LowerLabel
        (LowerState
          next-var
          (+ next-label 1)
          next-lambda
          current-label
          current-instrs
          blocks
          functions
          function
          spans
          names
          type-cache
          mode
          tail-param-start
          tail-param-end)
        (string.append
          (string.append prefix ".")
          (string.int->string next-label)))]))

(define (lower-state-fresh-lambda-name [state : LowerState]) : LowerLambdaName
  (match state
    [(LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)
      (LowerLambdaName
        (LowerState
          next-var
          next-label
          (+ next-lambda 1)
          current-label
          current-instrs
          blocks
          functions
          function
          spans
          names
          type-cache
          mode
          tail-param-start
          tail-param-end)
        (string.append
          (string.append (string.append "__tl_lambda_" function) "_")
          (string.int->string next-lambda)))]))

(define (lower-state-emit [state : LowerState] [instr : CompilerIrInstr]) : LowerState
  (match state
    [(LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)
      (LowerState
        next-var
        next-label
        next-lambda
        current-label
        (box (compiler-ir-instr-cons instr (box-get current-instrs)))
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)]))

(define (lower-state-record-instr-span
  [state : LowerState]
  [instr : CompilerIrInstr]
  [span : AstSourceSpan]) : LowerState
  (match state
    [(LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)
      (LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        (box
          (compiler-source-spans-insert-instr
            (box-get spans)
            function
            instr
            span))
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)]))

(define (lower-state-emit-at-expr
  [state : LowerState]
  [instr : CompilerIrInstr]
  [_expr : AstExpr]) : LowerState
  ;; Per-instruction spans are allocated inside per-function scratch arenas and
  ;; are not escaped by `lower-function-escaping`; function-level spans are
  ;; recorded separately after escape.
  (lower-state-emit state instr))

(define (lower-state-finish-block [state : LowerState] [next-label : String]) : LowerState
  (match state
    [(LowerState
        next-var
        next-label-id
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)
      (LowerState
        next-var
        next-label-id
        next-lambda
        next-label
        (box CompilerIrInstrList.Nil)
        (box
          (compiler-ir-block-cons
            (CompilerIrBlock.Block
              current-label
              (lower-instr-seq-from-reversed-list (box-get current-instrs)))
            (box-get blocks)))
        functions
        function
        spans
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)]))

(define (lower-state-build-blocks [state : LowerState]) : CompilerIrBlockList
  (match state
    [(LowerState _ _ _ current-label current-instrs blocks _ _ _ _ _ _ _ _)
      (let
        [current-block : CompilerIrBlock
          (CompilerIrBlock.Block
            current-label
            (lower-instr-seq-from-reversed-list (box-get current-instrs)))]
        (lower-block-list-reverse-onto
          (box-get blocks)
          (compiler-ir-block-cons current-block CompilerIrBlockList.Nil)))]))

(define (lower-state-build-function-blocks [state : LowerState]) : CompilerIrBlockList
  (compiler-ir-block-list-compact (lower-state-build-blocks state)))

(define (lower-state-add-functions
  [state : LowerState]
  [new-functions : CompilerIrFunctionList]
  [new-spans : CompilerSourceSpans]) : LowerState
  (match state
    [(LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        _
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)
      (LowerState
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        (box (lower-function-list-append new-functions (box-get functions)))
        function
        (box new-spans)
        names
        type-cache
        mode
        tail-param-start
        tail-param-end)]))

(define (lower-materialize
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (OkLowerExpr
        (LowerExpr
          (lower-state-emit allocated (CompilerIrInstr.Mov var-id value ty))
          (CompilerIrValue.Var var-id)
          ty))]))

(define (lower-materialize-at-expr
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]
  [expr : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (let
        [instr : CompilerIrInstr (CompilerIrInstr.Mov var-id value ty)]
        (OkLowerExpr
          (LowerExpr
            (lower-state-emit-at-expr allocated instr expr)
            (CompilerIrValue.Var var-id)
            ty)))]))

(define (lower-float-literal-bits [text : String] [ty : AstType]) : u64
  (match ty
    [(AstType.F32)
      (match (compiler-float-parse-f32-bits text)
        [(CompilerFloatSomeBits bits) bits]
        [(CompilerFloatNoBits) (cast 0 : u64)])]
    [_
      (match (compiler-float-parse-f64-bits text)
        [(CompilerFloatSomeBits bits) bits]
        [(CompilerFloatNoBits) (cast 0 : u64)])]))

(define (lower-literal-value-with-type [lit : AstLiteral] [ty : AstType]) : CompilerIrValue
  (match lit
    [(AstLiteral.Int n _) (CompilerIrValue.I64 n)]
    [(AstLiteral.Float n) (CompilerIrValue.F64 (lower-float-literal-bits n ty))]
    [(AstLiteral.Bool b) (CompilerIrValue.Bool b)]
    [(AstLiteral.Char c) (CompilerIrValue.Char c)]
    [(AstLiteral.String s) (CompilerIrValue.String s)]
    [(AstLiteral.Unit) CompilerIrValue.Unit]))

(define (lower-literal-value [lit : AstLiteral]) : CompilerIrValue
  (lower-literal-value-with-type lit (tc-literal-type lit)))

(define (lower-binop [op : AstBinOp]) : CompilerIrBinOp
  (match op
    [(AstBinOp.Add) CompilerIrBinOp.Add]
    [(AstBinOp.Sub) CompilerIrBinOp.Sub]
    [(AstBinOp.Mul) CompilerIrBinOp.Mul]
    [(AstBinOp.Div) CompilerIrBinOp.Div]
    [(AstBinOp.Mod) CompilerIrBinOp.Mod]
    [(AstBinOp.Eq) CompilerIrBinOp.Eq]
    [(AstBinOp.Ne) CompilerIrBinOp.Ne]
    [(AstBinOp.Lt) CompilerIrBinOp.Lt]
    [(AstBinOp.Le) CompilerIrBinOp.Le]
    [(AstBinOp.Gt) CompilerIrBinOp.Gt]
    [(AstBinOp.Ge) CompilerIrBinOp.Ge]
    [(AstBinOp.And) CompilerIrBinOp.And]
    [(AstBinOp.Or) CompilerIrBinOp.Or]
    [(AstBinOp.BitAnd) CompilerIrBinOp.BitAnd]
    [(AstBinOp.BitOr) CompilerIrBinOp.BitOr]
    [(AstBinOp.BitXor) CompilerIrBinOp.BitXor]
    [(AstBinOp.Shl) CompilerIrBinOp.Shl]
    [(AstBinOp.Shr) CompilerIrBinOp.Shr]))

(define (lower-unop [op : AstUnOp]) : CompilerIrUnOp
  (match op
    [(AstUnOp.Neg) CompilerIrUnOp.Neg]
    [(AstUnOp.Not) CompilerIrUnOp.Not]
    [(AstUnOp.BitNot) CompilerIrUnOp.BitNot]))

(define (lower-align-up [n : i64] [align : i64]) : i64
  (if (<= align 1)
    n
    (* (/ (+ n (- align 1)) align) align)))

(define (lower-inline-layout-size-or
  [ctx : TcContext]
  [ty : AstType]
  [fallback : i64]) : i64
  ;; #2386/#2624 (compile-time): a bare struct/enum size is memoized by stable
  ;; interned type-name id
  ;; (its size is stable; this is the hot type-size query in lowering). Generic
  ;; ...Args / tuples / arrays depend on type arguments, so keep the uncached path.
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (tc-inline-aggregate-size-cached ctx name fallback)]
    [(AstType.Enum name) (tc-inline-aggregate-size-cached ctx name fallback)]
    [_
      (match (tc-inline-aggregate-type-layout ctx ty)
        [(ResultTcLayoutInfo.Ok info) (tc-layout-info-size info)]
        [(ResultTcLayoutInfo.Err _) fallback])]))

(define (lower-inline-layout-align-or
  [ctx : TcContext]
  [ty : AstType]
  [fallback : i64]) : i64
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (tc-inline-aggregate-align-cached ctx name fallback)]
    [(AstType.Enum name) (tc-inline-aggregate-align-cached ctx name fallback)]
    [_
      (match (tc-inline-aggregate-type-layout ctx ty)
        [(ResultTcLayoutInfo.Ok info) (tc-layout-info-align info)]
        [(ResultTcLayoutInfo.Err _) fallback])]))

(define (lower-type-size [ctx : TcContext] [ty : AstType]) : i64
  (match (tc-resolve-type ctx ty)
    [(AstType.I64) 8]
    [(AstType.U64) 8]
    [(AstType.F64) 8]
    [(AstType.I32) 4]
    [(AstType.U32) 4]
    [(AstType.F32) 4]
    [(AstType.I16) 2]
    [(AstType.U16) 2]
    [(AstType.I8) 1]
    [(AstType.U8) 1]
    [(AstType.Bool) 1]
    [(AstType.Char) 1]
    [(AstType.Unit) 0]
    [(AstType.Never) 0]
    [(AstType.Expr) 0]
    [(AstType.ExprList) 0]
    [(AstType.Func _ _) 8]
    [(AstType.Tuple _) 8]
    [(AstType.Array _ _) (lower-inline-layout-size-or ctx ty 8)]
    [(AstType.DynArray _) 8]
    [(AstType.Box _) 8]
    [(AstType.Ptr _) 8]
    [(AstType.MutPtr _) 8]
    [(AstType.Ref _ _) 8]
    [(AstType.MutRef _ _) 8]
    [(AstType.Region _ inner)
      (lower-type-size ctx (tc-context-type-get ctx inner))]
    [(AstType.Enum name)
      (lower-inline-layout-size-or ctx (AstType.Enum name) 8)]
    [(AstType.EnumArgs name lifetimes)
      (lower-inline-layout-size-or ctx (AstType.EnumArgs name lifetimes) 8)]
    [(AstType.Struct name)
      (lower-inline-layout-size-or ctx (AstType.Struct name) 8)]
    [(AstType.StructArgs name lifetimes)
      (lower-inline-layout-size-or ctx (AstType.StructArgs name lifetimes) 8)]
    [(AstType.String) 8]
    [(AstType.Str) 8]
    [(AstType.Bytes) 8]
    [(AstType.Var _) 8]
    [(AstType.VarArgs _ _) 8]))

(define (lower-type-align [ctx : TcContext] [ty : AstType]) : i64
  (match (tc-resolve-type ctx ty)
    [(AstType.I64) 8]
    [(AstType.U64) 8]
    [(AstType.F64) 8]
    [(AstType.I32) 4]
    [(AstType.U32) 4]
    [(AstType.F32) 4]
    [(AstType.I16) 2]
    [(AstType.U16) 2]
    [(AstType.I8) 1]
    [(AstType.U8) 1]
    [(AstType.Bool) 1]
    [(AstType.Char) 1]
    [(AstType.Unit) 1]
    [(AstType.Never) 1]
    [(AstType.Expr) 1]
    [(AstType.ExprList) 1]
    [(AstType.Func _ _) 8]
    [(AstType.Tuple _) 8]
    [(AstType.Array _ _) (lower-inline-layout-align-or ctx ty 8)]
    [(AstType.DynArray _) 8]
    [(AstType.Box _) 8]
    [(AstType.Ptr _) 8]
    [(AstType.MutPtr _) 8]
    [(AstType.Ref _ _) 8]
    [(AstType.MutRef _ _) 8]
    [(AstType.Region _ inner)
      (lower-type-align ctx (tc-context-type-get ctx inner))]
    [(AstType.Enum name)
      (lower-inline-layout-align-or ctx (AstType.Enum name) 8)]
    [(AstType.EnumArgs name lifetimes)
      (lower-inline-layout-align-or ctx (AstType.EnumArgs name lifetimes) 8)]
    [(AstType.Struct name)
      (lower-inline-layout-align-or ctx (AstType.Struct name) 8)]
    [(AstType.StructArgs name lifetimes)
      (lower-inline-layout-align-or ctx (AstType.StructArgs name lifetimes) 8)]
    [(AstType.String) 8]
    [(AstType.Str) 8]
    [(AstType.Bytes) 8]
    [(AstType.Var _) 8]
    [(AstType.VarArgs _ _) 8]))

(define (lower-type-list-extent
  [ctx : TcContext]
  [types : AstTypeList]
  [cursor : i64]) : i64
  (match types
    [(AstTypeList.Nil) cursor]
    [(AstTypeList.Cons ty rest)
      (let
        [ty : AstType (tc-context-type-get ctx ty)]
        [rest : AstTypeList (box-get rest)]
        [resolved : AstType (tc-resolve-type ctx ty)]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        (lower-type-list-extent
          ctx
          rest
          (+ offset (lower-type-size ctx resolved))))]))

(define (lower-type-list-storage-size [ctx : TcContext] [types : AstTypeList]) : i64
  (let
    [extent : i64 (lower-type-list-extent ctx types 0)]
    (lower-align-up
      (if (= extent 0)
        1
        extent)
      8)))

(define (lower-variant-fields-storage-size
  [ctx : TcContext]
  [fields : AstTypeList]) : i64
  (lower-align-up (lower-type-list-extent ctx fields 8) 8))

(define (lower-variant-storage-size [ctx : TcContext] [variant : AstVariantDef]) : i64
  (match variant
    [(AstVariantDef.Def _ fields _)
      (lower-variant-fields-storage-size ctx fields)]))

(define (lower-nullary-variant-object-name
  [enum-name : String]
  [variant-name : String]) : String
  (string.append
    "__enum_obj_"
    (string.append enum-name (string.append "_" variant-name))))

(define (lower-nullary-variant-globals
  [enum-name : String]
  [variants : AstVariantDefList]
  [tag : i64]
  [globals : CompilerIrGlobalList]) : CompilerIrGlobalList
  (match variants
    [(AstVariantDefList.Nil) globals]
    [(AstVariantDefList.Cons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef.Def variant-name fields _)
            (let
              [next : CompilerIrGlobalList
                (match fields
                  [(AstTypeList.Nil)
                    (let
                      [object-name : String
                        (lower-nullary-variant-object-name
                          enum-name
                          (intern-str variant-name))]
                      (compiler-ir-global-cons
                        (CompilerIrGlobal.Global
                          object-name
                          (AstType.I64)
                          (CompilerIrValue.I64 tag))
                        globals))]
                  [_ globals])]
              (lower-nullary-variant-globals enum-name rest (+ tag 1) next))]))]))

(define (lower-enum-variants-storage-size
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [max-size : i64]) : i64
  (match variants
    [(AstVariantDefList.Nil) max-size]
    [(AstVariantDefList.Cons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        [size : i64 (lower-variant-storage-size ctx variant)]
        (lower-enum-variants-storage-size
          ctx
          rest
          (if (> size max-size)
            size
            max-size)))]))

(define (lower-enum-storage-size [ctx : TcContext] [enum-name : String]) : i64
  (match (tc-context-enum-variants ctx enum-name)
    [(ResultAstVariantDefList.Ok variants)
      (lower-enum-variants-storage-size ctx variants 8)]
    [(ResultAstVariantDefList.Err _) 8]))

(define (lower-struct-fields [ctx : TcContext] [struct-name : String]) : ResultAstFieldDefList
  (match ctx
    [(TcContext _ symbols _ _ _)
      (let
        [handle : i64
          (compiler-symbols-lookup-type-or
            symbols
            struct-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (if (=
            (compiler-symbol-handle-kind handle)
            (compiler-symbol-kind-defstruct))
            (match (compiler-symbols-decl-at-index
              symbols
              (compiler-symbol-handle-index handle))
              [(ResultAstDecl.Ok decl)
                (match decl
                  [(AstDecl.DefStruct _ _ _ fields)
                    (ResultAstFieldDefList.Ok fields)]
                  [(AstDecl.DefStructLifetimes _ _ _ _ fields)
                    (ResultAstFieldDefList.Ok fields)]
                  [_
                    (ResultAstFieldDefList.Err
                      "lower: struct symbol owner is not a struct")])]
              [(ResultAstDecl.Err message) (ResultAstFieldDefList.Err message)])
            (ResultAstFieldDefList.Err
              (string.append "lower: unknown struct " struct-name)))
          (ResultAstFieldDefList.Err
            (string.append "lower: unknown struct " struct-name))))]))

(define (lower-struct-repr-c? [ctx : TcContext] [struct-name : String]) : bool
  (match (tc-struct-decl ctx struct-name)
    [(ResultTcStructDecl.Ok decl)
      (match decl
        [(TcStructDecl repr _ _) (ast-struct-repr-c? repr)])]
    [(ResultTcStructDecl.Err _) false]))

(define (lower-repr-c-inline-field? [ctx : TcContext] [field-ty : AstType]) : bool
  (match (tc-resolve-type ctx field-ty)
    [(AstType.Struct nested) (lower-struct-repr-c? ctx (intern-str nested))]
    [_ false]))

(define (lower-repr-c-field-size [ctx : TcContext] [field-ty : AstType]) : i64
  (match (tc-resolve-type ctx field-ty)
    [(AstType.Struct nested)
      (match (tc-repr-c-struct-layout ctx (intern-str nested))
        [(ResultTcReprCLayout.Ok layout) (tc-repr-c-layout-size layout)]
        [(ResultTcReprCLayout.Err _) 8])]
    [_ (lower-type-size ctx field-ty)]))

(define (lower-reserve-heap-storage
  [state : LowerState]
  [size : i64]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (LowerExpr
        (lower-state-emit
          allocated
          (CompilerIrInstr.Call
            var-id
            "tl_alloc"
            (CompilerIrCallArgs.One (CompilerIrValue.I64 size))
            ty))
        (CompilerIrValue.Var var-id)
        ty)]))

(define (lower-inline-storage-slot-count [size : i64]) : i64
  (if (<= size 8)
    1
    (/ (+ size 7) 8)))

(define (lower-reserve-inline-slot-vars
  [state : LowerState]
  [slots : i64]
  [ty : AstType]) : LowerInlineStorage
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (let
        [next-state : LowerState
          (lower-state-emit allocated (CompilerIrInstr.Alloc var-id ty))]
        (if (<= slots 1)
          (LowerInlineStorage next-state var-id)
          (lower-reserve-inline-slot-vars next-state (- slots 1) ty)))]))

(define (lower-reserve-inline-storage
  [state : LowerState]
  [size : i64]
  [ty : AstType]) : LowerExpr
  (match (lower-reserve-inline-slot-vars
    state
    (lower-inline-storage-slot-count size)
    ty)
    [(LowerInlineStorage storage-state storage-var)
      (match (lower-state-alloc-var storage-state)
        [(LowerAlloc addr-alloc addr-var)
          (LowerExpr
            (lower-state-emit
              addr-alloc
              (CompilerIrInstr.AddrOf addr-var storage-var))
            (CompilerIrValue.Var addr-var)
            ty)])]))

(define (lower-gep-byte
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (LowerExpr
        (lower-state-emit
          allocated
          (CompilerIrInstr.Gep
            var-id
            base
            (CompilerIrValue.I64 offset)
            (AstType.U8)))
        (CompilerIrValue.Var var-id)
        (AstType.U64))]))

(define (lower-store-at-offset
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [value : CompilerIrValue]
  [ty : AstType]) : LowerState
  (match (lower-gep-byte state base offset)
    [(LowerExpr ptr-state ptr _)
      (lower-state-emit ptr-state (CompilerIrInstr.StorePtr ptr value ty))]))

(define (lower-load-at-offset
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [ty : AstType]) : LowerExpr
  (match (lower-gep-byte state base offset)
    [(LowerExpr ptr-state ptr _)
      (match (lower-state-alloc-var ptr-state)
        [(LowerAlloc allocated var-id)
          (LowerExpr
            (lower-state-emit allocated (CompilerIrInstr.Load var-id ptr ty))
            (CompilerIrValue.Var var-id)
            ty)])]))

(define (lower-copy-chunk-size [remaining : i64]) : i64
  (cond [(>= remaining 8) 8] [(>= remaining 4) 4] [(>= remaining 2) 2] [else 1]))

(define (lower-copy-chunk-type [chunk : i64]) : AstType
  (cond
    [(= chunk 8) (AstType.U64)]
    [(= chunk 4) (AstType.U32)]
    [(= chunk 2) (AstType.U16)]
    [else (AstType.U8)]))

;; #2386: the byte address `base + offset` as an IR value (the base itself when
;; offset is 0, avoiding a no-op gep).
(define (lower-offset-addr
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]) : LowerExpr
  (if (= offset 0)
    (LowerExpr state base (AstType.U64))
    (lower-gep-byte state base offset)))

;; #2386 / lever #1: inline the hottest by-value aggregate copies. The flip to
;; inline-by-value aggregates (#1867) made the 17-64 B band, especially
;; AstTypeList/AstType and ResultTcType/ResultTcType.Ok copies, dynamically dominant,
;; but the 16 B ceiling pushed every one of them onto a `tl_memcpy` CALL (~88
;; dynamic instructions each). Inline they cost only `size/8` load+store pairs.
;; Raising the ceiling to 64 B turns that band into straight movs (a few
;; instructions) while still routing genuinely large copies through tl_memcpy so
;; the emitted code does not blow up. Must stay a multiple of 8 so the inline
;; chunk loop (lower-copy-chunk-size: 8/4/2/1) terminates cleanly for any size.
(define lower-inline-copy-threshold : i64
  64)

;; #2386: copy `size` bytes dst<-src via a single tl_memcpy runtime call instead
;; of `size/8` separate gep+load+gep+store chunks. The flip from heap-handle
;; structs to inline-by-value aggregates (#1867) turned every large by-value
;; aggregate copy (set!, pass/return, clone of a >16 B struct) into a long run of
;; word copies -- the dominant `movq` source at -O1 (the `movq ...,%r10 ; movq
;; off(%r10),%rax ; movq %rax,SLOT` runs). One call collapses each run to a few
;; instructions. tl_memcpy takes (dst, src, len) and is emitted unconditionally in
;; the runtime. Only used for copies large enough that the call beats the inline
;; chunks (see lower-copy-bytes threshold).
(define (lower-emit-memcpy
  [state : LowerState]
  [dst : CompilerIrValue]
  [dst-offset : i64]
  [src : CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (match (lower-offset-addr state dst dst-offset)
    [(LowerExpr dst-state dst-addr _)
      (match (lower-offset-addr dst-state src src-offset)
        [(LowerExpr src-state src-addr _)
          (match (lower-state-alloc-var src-state)
            [(LowerAlloc call-state call-var)
              (lower-state-emit
                call-state
                (CompilerIrInstr.Call
                  call-var
                  "tl_memcpy"
                  (compiler-ir-call-args-from-list
                    (compiler-ir-value-cons
                      dst-addr
                      (compiler-ir-value-cons
                        src-addr
                        (compiler-ir-value-cons
                          (CompilerIrValue.I64 size)
                          (IrValueNil)))))
                  (AstType.Unit)))])])]))

(define (lower-emit-memcpy-value
  [state : LowerState]
  [dst : CompilerIrValue]
  [dst-offset : i64]
  [src : CompilerIrValue]
  [src-offset : i64]
  [size : CompilerIrValue]) : LowerState
  (match (lower-offset-addr state dst dst-offset)
    [(LowerExpr dst-state dst-addr _)
      (match (lower-offset-addr dst-state src src-offset)
        [(LowerExpr src-state src-addr _)
          (match (lower-state-alloc-var src-state)
            [(LowerAlloc call-state call-var)
              (lower-state-emit
                call-state
                (CompilerIrInstr.Call
                  call-var
                  "tl_memcpy"
                  (compiler-ir-call-args-from-list
                    (compiler-ir-value-cons
                      dst-addr
                      (compiler-ir-value-cons
                        src-addr
                        (compiler-ir-value-cons size (IrValueNil)))))
                  (AstType.Unit)))])])]))

(define (lower-copy-bytes
  [state : LowerState]
  [dst : CompilerIrValue]
  [dst-offset : i64]
  [src : CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (cond
    [(<= size 0) state]
    [(> size lower-inline-copy-threshold)
      (lower-emit-memcpy state dst dst-offset src src-offset size)]
    [(>= size 16)
      (match (lower-offset-addr state dst dst-offset)
        [(LowerExpr dst-state dst-addr _)
          (match (lower-offset-addr dst-state src src-offset)
            [(LowerExpr src-state src-addr _)
              (lower-state-emit
                src-state
                (CompilerIrInstr.CopyBytes dst-addr src-addr size))])])]
    [else
      (let
        [chunk : i64 (lower-copy-chunk-size size)]
        [chunk-ty : AstType (lower-copy-chunk-type chunk)]
        (match (lower-load-at-offset state src src-offset chunk-ty)
          [(LowerExpr loaded value _)
            (lower-copy-bytes
              (lower-store-at-offset loaded dst dst-offset value chunk-ty)
              dst
              (+ dst-offset chunk)
              src
              (+ src-offset chunk)
              (- size chunk))]))]))

;; A value is stored FULL-INLINE (its own bytes, addressed by a pointer) when it
;; is a memory aggregate: a struct/enum or fixed array. Tuples, boxes,
;; dyn-arrays, strings, closures, and scalars keep their existing register-width
;; slot semantics:
;; they use scalar load/store rather than byte-copy or pointer-return.
;; This is the precise gate for choosing inline byte-copy / pointer-return vs.
;; scalar load/store, distinct from the broad lower-type-contains-inline-
;; aggregate? (which is used for the conservative tail-call risk check).
(define (lower-type-inline-storage? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Array _ _) true]
    [_ false]))

(define (lower-type-inline-struct-or-enum? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ false]))

;; #2386: a register-resident aggregate is an inline struct/enum that fits in a
;; single 8-byte word and is built only of word-class fields. Such a value is
;; carried through the IR as the packed word itself (an i64-shaped SSA value)
;; rather than a pointer to a stack slot: construction packs the fields with
;; shift/or, `struct-get`/`match` extract them with shift/mask, and the value is
;; passed/returned/cloned exactly like a scalar - never touching memory.
;; #2605: AstType.StructArgs/AstType.EnumArgs here are lifetime-arg forms; they share
;; the same layout and representation as the bare declaration.
(define (lower-type-register-resident? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (tc-name-register-resident? ctx (intern-str name))]
    [(AstType.StructArgs name _)
      (tc-name-register-resident? ctx (intern-str name))]
    [(AstType.Enum name) (tc-name-register-resident? ctx (intern-str name))]
    [(AstType.EnumArgs name _)
      (tc-name-register-resident? ctx (intern-str name))]
    [_ false]))

;; #2386: number of machine words a register-resident aggregate occupies
;; (ceil(size/8)). 1 word => carried as a single scalar value (slice 1/2); 2
;; words => carried as a register-group value built with CompilerIrInstr.Pack and read
;; with IrInstrWord. Only meaningful when `lower-type-register-resident?` holds.
(define (lower-type-register-word-count [ctx : TcContext] [ty : AstType]) : i64
  (/ (+ (lower-type-size ctx ty) 7) 8))

;; #2386: true for a register-resident aggregate that needs the multi-word
;; register-group representation (2+ words) rather than the single-word scalar
;; representation. Drives the CompilerIrInstr.Pack/CompilerIrInstr.Word lowering paths.
(define (lower-type-register-group? [ctx : TcContext] [ty : AstType]) : bool
  (> (lower-type-register-words ctx ty) 1))

;; #2386: register-residency in ONE inline-layout build, vs the THREE transient
;; layout rebuilds of calling register-resident? + register-group? (which itself
;; rebuilds for resident? and for the size) separately. Returns the machine-word
;; count (1 or 2) of a register-resident aggregate, else 0. Used on the hot match
;; path so the per-function scratch arena keeps the same transient-allocation
;; profile as before this slice (excess rebuilds there overflowed it into a second
;; chunk whose rewind leaked into later lowering).
(define (lower-type-register-words [ctx : TcContext] [ty : AstType]) : i64
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (tc-inline-aggregate-regwords-cached ctx name)]
    [(AstType.StructArgs name _) (tc-inline-aggregate-regwords-cached ctx name)]
    [(AstType.Enum name) (tc-inline-aggregate-regwords-cached ctx name)]
    [(AstType.EnumArgs name _) (tc-inline-aggregate-regwords-cached ctx name)]
    [_ 0]))

(define (lower-f64-register-word-field?
  [field-ty : AstType]
  [offset : i64]
  [word-index : i64]) : bool
  (match (tc-type-strip-region field-ty)
    [(AstType.F64) (and (= (/ offset 8) word-index) (= (% offset 8) 0))]
    [_ false]))

(define (lower-sse-register-word-field?
  [field-ty : AstType]
  [offset : i64]
  [word-index : i64]) : bool
  (match (tc-type-strip-region field-ty)
    [(AstType.F64) (and (= (/ offset 8) word-index) (= (% offset 8) 0))]
    [(AstType.F32) (and (= (/ offset 8) word-index) (= (% offset 4) 0))]
    [_ false]))

(define (lower-register-word-type-merge
  [current : AstType]
  [field-ty : AstType]
  [offset : i64]
  [word-index : i64]) : AstType
  (if (lower-sse-register-word-field? field-ty offset word-index)
    (AstType.F64)
    current))

(define (lower-register-struct-word-type-fields
  [fields : TcInlineFieldLayoutList]
  [word-index : i64]
  [current : AstType]) : AstType
  (match fields
    [(TcInlineFieldLayoutList.Nil) current]
    [(TcInlineFieldLayoutList.Cons field rest)
      (lower-register-struct-word-type-fields
        (box-get rest)
        word-index
        (lower-register-word-type-merge
          current
          (tc-inline-field-layout-type field)
          (tc-inline-field-layout-offset field)
          word-index))]))

(define (lower-register-payload-word-type-fields
  [payloads : TcInlinePayloadLayoutList]
  [word-index : i64]
  [current : AstType]) : AstType
  (match payloads
    [(TcInlinePayloadLayoutList.Nil) current]
    [(TcInlinePayloadLayoutList.Cons payload rest)
      (lower-register-payload-word-type-fields
        (box-get rest)
        word-index
        (lower-register-word-type-merge
          current
          (tc-inline-payload-layout-type payload)
          (tc-inline-payload-layout-offset payload)
          word-index))]))

(define (lower-register-enum-word-type-variants
  [variants : TcInlineVariantLayoutList]
  [word-index : i64]
  [current : AstType]) : AstType
  (match variants
    [(TcInlineVariantLayoutList.Nil) current]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (match variant
        [(TcInlineVariantLayout.Variant _ _ _ payloads)
          (lower-register-enum-word-type-variants
            (box-get rest)
            word-index
            (lower-register-payload-word-type-fields
              payloads
              word-index
              current))])]))

;; Register-resident aggregate word type for lowering/backend movement. INTEGER
;; words are represented as i64 bit words; SSE eightbytes are represented by f64
;; values, including homogeneous packed f32 words carried opaquely in XMM regs.
(define (lower-register-word-type
  [ctx : TcContext]
  [ty : AstType]
  [word-index : i64]) : AstType
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name)
      (match (tc-inline-aggregate-layout-for ctx (intern-str name))
        [(ResultTcInlineAggregateLayout.Ok layout)
          (match layout
            [(TcInlineAggregateLayout.Struct _ _ fields)
              (lower-register-struct-word-type-fields
                fields
                word-index
                (AstType.I64))]
            [(TcInlineAggregateLayout.Enum _ _ _) (AstType.I64)])]
        [(ResultTcInlineAggregateLayout.Err _) (AstType.I64)])]
    [(AstType.StructArgs name _)
      (lower-register-word-type ctx (AstType.Struct name) word-index)]
    [(AstType.Enum name)
      (if (= word-index 0)
        (AstType.I64)
        (match (tc-inline-aggregate-layout-for ctx (intern-str name))
          [(ResultTcInlineAggregateLayout.Ok layout)
            (match layout
              [(TcInlineAggregateLayout.Enum _ _ variants)
                (lower-register-enum-word-type-variants
                  variants
                  word-index
                  (AstType.I64))]
              [(TcInlineAggregateLayout.Struct _ _ _) (AstType.I64)])]
          [(ResultTcInlineAggregateLayout.Err _) (AstType.I64)]))]
    [(AstType.EnumArgs name _)
      (lower-register-word-type ctx (AstType.Enum name) word-index)]
    [_ (AstType.I64)]))

(define (lower-one-word-register-storage-type [ctx : TcContext] [ty : AstType]) : AstType
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Array _ _) (AstType.U64)]
      [_
        (if (and
          (lower-type-register-resident? ctx resolved)
          (not (lower-type-register-group? ctx resolved)))
          (let
            [word-ty : AstType (lower-register-word-type ctx resolved 0)]
            (match (tc-type-strip-region word-ty)
              [(AstType.F64) word-ty]
              [_ resolved]))
          resolved)])))

(define (lower-type-signed? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [_ false]))

;; Low `size` bytes set to 1 (e.g. size 4 -> 0xffffffff). Used to mask a field
;; to its width before OR-ing it into a packed word. size >= 8 is handled by the
;; callers (no mask needed for a full word).
(define (lower-low-bits-mask [size : i64]) : i64
  (cond
    [(>= size 8) -1]
    [(= size 1) 255]
    [(= size 2) 65535]
    [(= size 3) 16777215]
    [(= size 4) 4294967295]
    [(= size 5) 1099511627775]
    [(= size 6) 281474976710655]
    [(= size 7) 72057594037927935]
    [else -1]))

;; Extract a word-class field from the packed word of a register-resident
;; aggregate. The field occupies bytes [byte-offset, byte-offset+size) of the
;; word; a left shift drops the bytes above it, then a 64-bit arithmetic (signed)
;; or logical (unsigned) right shift moves it to the low bits with the same
;; sign/zero extension a typed memory load would produce.
(define (lower-extract-word-field
  [ctx : TcContext]
  [state : LowerState]
  [word : CompilerIrValue]
  [word-ty : AstType]
  [byte-offset : i64]
  [field-ty : AstType]) : LowerExpr
  (let
    [size : i64 (lower-type-size ctx field-ty)]
    (if (>= size 8)
      (LowerExpr state word field-ty)
      (let
        [bits : LowerExpr
          (match (tc-type-strip-region field-ty)
            [(AstType.F32)
              (lower-bitcast-value state word word-ty (AstType.U64))]
            [_ (LowerExpr state word (AstType.U64))])]
        [left : i64 (- 64 (* (+ byte-offset size) 8))]
        [right : i64 (- 64 (* size 8))]
        (match bits
          [(LowerExpr bits-state bits-value _)
            (let
              [shifted : LowerExpr
                (if (> left 0)
                  (lower-emit-binop
                    bits-state
                    CompilerIrBinOp.Shl
                    bits-value
                    (CompilerIrValue.I64 left)
                    (AstType.I64))
                  (LowerExpr bits-state bits-value (AstType.I64)))]
              (match shifted
                [(LowerExpr shl-state shl-value _)
                  (match (lower-emit-binop
                    shl-state
                    CompilerIrBinOp.Shr
                    shl-value
                    (CompilerIrValue.I64 right)
                    (if (lower-type-signed? field-ty)
                      (AstType.I64)
                      (AstType.U64)))
                    [(LowerExpr shr-state shr-value _)
                      (match (tc-type-strip-region field-ty)
                        [(AstType.F32)
                          (lower-bitcast-value
                            shr-state
                            shr-value
                            (AstType.U64)
                            (AstType.F32))]
                        [_ (LowerExpr shr-state shr-value field-ty)])])]))])))))

;; OR one field value into the packed-word accumulator: mask it to its byte
;; width (so a sign-extended source cannot bleed into neighbouring fields), shift
;; it to its byte offset, and OR it into `acc`.
(define (lower-pack-word-field
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [value : CompilerIrValue]
  [byte-offset : i64]
  [field-ty : AstType]) : LowerExpr
  (let
    [size : i64 (lower-type-size ctx field-ty)]
    (if (and
      (>= size 8)
      (lower-f64-register-word-field? field-ty byte-offset 0))
      (LowerExpr state value field-ty)
      (let
        [bits : LowerExpr
          (match (tc-type-strip-region field-ty)
            [(AstType.F32)
              (lower-bitcast-value state value field-ty (AstType.U64))]
            [_ (LowerExpr state value field-ty)])]
        (match bits
          [(LowerExpr bits-state bits-value _)
            (let
              [masked : LowerExpr
                (if (>= size 8)
                  (LowerExpr bits-state bits-value (AstType.U64))
                  (lower-emit-binop
                    bits-state
                    CompilerIrBinOp.BitAnd
                    bits-value
                    (CompilerIrValue.I64 (lower-low-bits-mask size))
                    (AstType.U64)))]
              (match masked
                [(LowerExpr mask-state mask-value _)
                  (let
                    [shifted : LowerExpr
                      (if (> byte-offset 0)
                        (lower-emit-binop
                          mask-state
                          CompilerIrBinOp.Shl
                          mask-value
                          (CompilerIrValue.I64 (* byte-offset 8))
                          (AstType.I64))
                        (LowerExpr mask-state mask-value (AstType.U64)))]
                    (match shifted
                      [(LowerExpr shift-state shift-value _)
                        (lower-emit-binop
                          shift-state
                          CompilerIrBinOp.BitOr
                          acc
                          shift-value
                          (AstType.U64))]))]))])))))

;; Build the packed word for a register-resident struct by folding each field
;; (masked + shifted) into a zero accumulator, in declaration order.
(define (lower-pack-inline-struct-values
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [acc-ty : AstType]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [layout : TcInlineAggregateLayout]) : ResultLowerExpr
  (match values
    [(IrValueNil)
      (match fields
        [(AstFieldDefList.Nil) (OkLowerExpr (LowerExpr state acc acc-ty))]
        [_
          (ErrLowerExpr
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(IrValueCons value rest-values)
      (match fields
        [(AstFieldDefList.Cons field rest-fields)
          (let
            [rest-fields : AstFieldDefList (box-get rest-fields)]
            (match field
              [(AstFieldDef.Def name ty _)
                (let
                  [name-str : String (intern-str name)]
                  [resolved : AstType (tc-resolve-type ctx ty)]
                  [offset : i64
                    (tc-inline-aggregate-layout-field-offset layout name-str)]
                  (if (< offset 0)
                    (ErrLowerExpr
                      (box
                        (lower-diagnostic
                          (string.append
                            "lower: inline struct layout missing field "
                            name-str))))
                    (match (lower-pack-word-field
                      ctx
                      state
                      acc
                      value
                      offset
                      resolved)
                      [(LowerExpr packed-state packed-acc packed-ty)
                        (lower-pack-inline-struct-values
                          ctx
                          packed-state
                          packed-acc
                          packed-ty
                          (box-get rest-values)
                          rest-fields
                          layout)])))]))]
        [(AstFieldDefList.Nil)
          (ErrLowerExpr
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]))

;; #2386: emit an CompilerIrInstr.Pack forming a register-group value from its word values.
(define (lower-emit-pack
  [state : LowerState]
  [words : CompilerIrValueList]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (LowerExpr
        (lower-state-emit allocated (CompilerIrInstr.Pack var-id words ty))
        (CompilerIrValue.Var var-id)
        ty)]))

;; #2386: emit an CompilerIrInstr.Word extracting word `index` of a register-group value.
(define (lower-emit-word
  [state : LowerState]
  [group : CompilerIrValue]
  [index : i64]
  [word-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (LowerExpr
        (lower-state-emit
          allocated
          (CompilerIrInstr.Word var-id group index word-ty))
        (CompilerIrValue.Var var-id)
        word-ty)]))

(define (lower-register-word-sse-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.F64) true]
    [_ false]))

(define (lower-materialize-register-word
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [word-ty : AstType]) : LowerExpr
  (if (tc-type-eq from-ty word-ty)
    (LowerExpr state value word-ty)
    (if (lower-register-word-sse-type? word-ty)
      (lower-bitcast-value state value (AstType.U64) word-ty)
      (LowerExpr state value word-ty))))

;; #2386: `=` / `!=` on a 2-word register-group aggregate must compare BOTH
;; words; the scalar CompilerIrInstr.BinOp compared only word0, so two enum values with
;; equal tags but different payloads compared equal.
(define (lower-binop-group-eq? [op : AstBinOp]) : bool
  (match op
    [(AstBinOp.Eq) true]
    [(AstBinOp.Ne) true]
    [_ false]))

(define (lower-group-equality
  [ctx : TcContext]
  [state : LowerState]
  [op : AstBinOp]
  [left : CompilerIrValue]
  [right : CompilerIrValue]
  [group-ty : AstType]
  [expr-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-emit-word
    state
    left
    0
    (lower-register-word-type ctx group-ty 0))
    [(LowerExpr ls0 l0 _)
      (match (lower-emit-word
        ls0
        left
        1
        (lower-register-word-type ctx group-ty 1))
        [(LowerExpr ls1 l1 _)
          (match (lower-emit-word
            ls1
            right
            0
            (lower-register-word-type ctx group-ty 0))
            [(LowerExpr rs0 r0 _)
              (match (lower-emit-word
                rs0
                right
                1
                (lower-register-word-type ctx group-ty 1))
                [(LowerExpr rs1 r1 _)
                  (match (lower-state-alloc-var rs1)
                    [(LowerAlloc alloc0 word0-cmp)
                      (match (lower-state-alloc-var alloc0)
                        [(LowerAlloc alloc1 word1-cmp)
                          (match (lower-state-alloc-var alloc1)
                            [(LowerAlloc alloc2 combined)
                              (OkLowerExpr
                                (LowerExpr
                                  (lower-state-emit-at-expr
                                    (lower-state-emit
                                      (lower-state-emit
                                        alloc2
                                        (CompilerIrInstr.BinOp
                                          word0-cmp
                                          (lower-binop op)
                                          l0
                                          r0
                                          expr-ty))
                                      (CompilerIrInstr.BinOp
                                        word1-cmp
                                        (lower-binop op)
                                        l1
                                        r1
                                        expr-ty))
                                    (CompilerIrInstr.BinOp
                                      combined
                                      ;; eq: both words equal; ne: either differs.
                                      (match op
                                        [(AstBinOp.Ne) CompilerIrBinOp.BitOr]
                                        [_ CompilerIrBinOp.BitAnd])
                                      (CompilerIrValue.Var word0-cmp)
                                      (CompilerIrValue.Var word1-cmp)
                                      expr-ty)
                                    origin)
                                  (CompilerIrValue.Var combined)
                                  expr-ty))])])])])])])]))

;; #2386: read a payload field of a register-group enum scrutinee. `base` is the
;; enum group var; the field at enum byte `offset` lives in word `offset/8` (the
;; payload word for a 16-byte enum), extracted with CompilerIrInstr.Word then shift/mask at
;; its relative offset.
(define (lower-read-register-group-payload
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [base-ty : AstType]
  [offset : i64]
  [field-ty : AstType]) : LowerExpr
  (match (lower-emit-word
    state
    base
    (/ offset 8)
    (lower-register-word-type ctx base-ty (/ offset 8)))
    [(LowerExpr w-state w-value _)
      (lower-extract-word-field
        ctx
        w-state
        w-value
        (lower-register-word-type ctx base-ty (/ offset 8))
        (- offset (* (/ offset 8) 8))
        field-ty)]))

;; #2386: store a 2-word register-group `value` to memory at pointer `ptr`
;; (word0 at [ptr], word1 at [ptr+8]) -- used when a group is embedded in a
;; pointer-addressed container (array element, dynarray, box, ...).
(define (lower-store-group-at-ptr
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [ty : AstType]) : LowerState
  (match (lower-emit-word state value 0 (lower-register-word-type ctx ty 0))
    [(LowerExpr s0 w0 _)
      (match (lower-emit-word s0 value 1 (lower-register-word-type ctx ty 1))
        [(LowerExpr s1 w1 _)
          (match (lower-gep-byte
            (lower-state-emit
              s1
              (CompilerIrInstr.StorePtr
                ptr
                w0
                (lower-register-word-type ctx ty 0)))
            ptr
            8)
            [(LowerExpr s2 ptr8 _)
              (lower-state-emit
                s2
                (CompilerIrInstr.StorePtr
                  ptr8
                  w1
                  (lower-register-word-type ctx ty 1)))])])]))

;; #2386: load a 2-word register-group from memory at pointer `ptr` and reassemble
;; it with CompilerIrInstr.Pack (word0 from [ptr], word1 from [ptr+8]).
(define (lower-load-group-from-ptr
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (match (lower-load-at-offset state ptr 0 (lower-register-word-type ctx ty 0))
    [(LowerExpr s0 w0 _)
      (match (lower-load-at-offset s0 ptr 8 (lower-register-word-type ctx ty 1))
        [(LowerExpr s1 w1 _)
          (lower-emit-pack
            s1
            (IrValueCons w0 (box (IrValueCons w1 (box IrValueNil))))
            ty)])]))

(define (lower-load-register-resident-from-ptr
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (if (lower-type-register-group? ctx ty)
    (lower-load-group-from-ptr ctx state ptr ty)
    (match (lower-load-at-offset
      state
      ptr
      0
      (lower-register-word-type ctx ty 0))
      [(LowerExpr load-state loaded _) (LowerExpr load-state loaded ty)])))

;; #2386: build the packed value for ONE machine word (`word-index`) of a
;; register-group struct: fold in only the fields that live in that word, each at
;; its offset RELATIVE to the word base, leaving an all-zero accumulator for words
;; with no field. Fields straddling a word boundary cannot occur for word-class
;; fields in a C-layout aggregate (each is naturally aligned within a word).
(define (lower-pack-inline-struct-word
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [acc-ty : AstType]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [layout : TcInlineAggregateLayout]
  [word-index : i64]) : ResultLowerExpr
  (match values
    [(IrValueNil)
      (match fields
        [(AstFieldDefList.Nil) (OkLowerExpr (LowerExpr state acc acc-ty))]
        [_
          (ErrLowerExpr
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(IrValueCons value rest-values)
      (match fields
        [(AstFieldDefList.Cons field rest-fields)
          (let
            [rest-fields : AstFieldDefList (box-get rest-fields)]
            (match field
              [(AstFieldDef.Def name ty _)
                (let
                  [name-str : String (intern-str name)]
                  [resolved : AstType (tc-resolve-type ctx ty)]
                  [offset : i64
                    (tc-inline-aggregate-layout-field-offset layout name-str)]
                  (if (< offset 0)
                    (ErrLowerExpr
                      (box
                        (lower-diagnostic
                          (string.append
                            "lower: inline struct layout missing field "
                            name-str))))
                    (if (= (/ offset 8) word-index)
                      (match (lower-pack-word-field
                        ctx
                        state
                        acc
                        value
                        (- offset (* word-index 8))
                        resolved)
                        [(LowerExpr packed-state packed-acc packed-ty)
                          (lower-pack-inline-struct-word
                            ctx
                            packed-state
                            packed-acc
                            packed-ty
                            (box-get rest-values)
                            rest-fields
                            layout
                            word-index)])
                      (lower-pack-inline-struct-word
                        ctx
                        state
                        acc
                        acc-ty
                        (box-get rest-values)
                        rest-fields
                        layout
                        word-index))))]))]
        [(AstFieldDefList.Nil)
          (ErrLowerExpr
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]))

;; #2386: construct a register-group struct value: pack each machine word and
;; combine them with IrInstrPack. Two-word integer-class structs only (slice 3).
(define (lower-construct-struct-register-group
  [ctx : TcContext]
  [state : LowerState]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [layout : TcInlineAggregateLayout]
  [struct-ty : AstType]) : ResultLowerExpr
  (match (lower-pack-inline-struct-word
    ctx
    state
    (CompilerIrValue.I64 0)
    (AstType.I64)
    values
    fields
    layout
    0)
    [(OkLowerExpr (LowerExpr s0 raw-word0 raw-ty0))
      (match (lower-materialize-register-word
        s0
        raw-word0
        raw-ty0
        (lower-register-word-type ctx struct-ty 0))
        [(LowerExpr w0-state word0 _)
          (match (lower-pack-inline-struct-word
            ctx
            w0-state
            (CompilerIrValue.I64 0)
            (AstType.I64)
            values
            fields
            layout
            1)
            [(OkLowerExpr (LowerExpr s1 raw-word1 raw-ty1))
              (match (lower-materialize-register-word
                s1
                raw-word1
                raw-ty1
                (lower-register-word-type ctx struct-ty 1))
                [(LowerExpr w1-state word1 _)
                  (match (lower-emit-pack
                    w1-state
                    (IrValueCons
                      word0
                      (box (IrValueCons word1 (box IrValueNil))))
                    struct-ty)
                    [(LowerExpr ps pv _)
                      (OkLowerExpr (LowerExpr ps pv struct-ty))])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

;; #2386: fold a register-group enum variant's payload values into word1 (the
;; payload word), each field masked + shifted to its offset RELATIVE to the
;; payload word (payload starts at enum byte 8, i.e. relative offset 0).
(define (lower-pack-enum-payload-word
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [acc-ty : AstType]
  [cursor : i64]
  [values : CompilerIrValueList]
  [fields : AstTypeList]) : ResultLowerExpr
  (match values
    [(IrValueNil) (OkLowerExpr (LowerExpr state acc acc-ty))]
    [(IrValueCons value rest-values)
      (match fields
        [(AstTypeList.Cons ty rest-fields)
          (let
            [resolved : AstType
              (tc-resolve-type ctx (tc-context-type-get ctx ty))]
            [offset : i64
              (lower-align-up cursor (lower-type-align ctx resolved))]
            (match (lower-pack-word-field ctx state acc value offset resolved)
              [(LowerExpr packed-state packed-acc packed-ty)
                (lower-pack-enum-payload-word
                  ctx
                  packed-state
                  packed-acc
                  packed-ty
                  (+ offset (lower-type-size ctx resolved))
                  (box-get rest-values)
                  (box-get rest-fields))]))]
        [(AstTypeList.Nil)
          (ErrLowerExpr
            (box (lower-diagnostic "lower: enum payload arity mismatch")))])]))

;; #2386: construct a register-group enum value: word0 = discriminant tag, word1 =
;; the variant's packed (word-class) payload (0 for a nullary variant).
(define (lower-construct-enum-register-group
  [ctx : TcContext]
  [state : LowerState]
  [handle : i64]
  [values : CompilerIrValueList]
  [fields : AstTypeList]
  [enum-ty : AstType]) : ResultLowerExpr
  (match (lower-pack-enum-payload-word
    ctx
    state
    (CompilerIrValue.I64 0)
    (AstType.I64)
    0
    values
    fields)
    [(OkLowerExpr (LowerExpr s1 raw-word1 raw-ty1))
      (match (lower-materialize-register-word
        s1
        raw-word1
        raw-ty1
        (lower-register-word-type ctx enum-ty 1))
        [(LowerExpr w1-state word1 _)
          (match (lower-emit-pack
            w1-state
            (IrValueCons
              (CompilerIrValue.I64
                (compiler-registry-handle-child-index handle))
              (box (IrValueCons word1 (box IrValueNil))))
            enum-ty)
            [(LowerExpr ps pv _) (OkLowerExpr (LowerExpr ps pv enum-ty))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-store-inline-value-at-offset
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [value : CompilerIrValue]
  [ty : AstType]
  [size : i64]) : LowerState
  ;; #2386: a register-resident aggregate is carried as a word, so embedding it
  ;; in a memory aggregate is a scalar store of that word, not a byte-copy from a
  ;; pointer. A 2-word register-group stores BOTH words (word0 at offset, word1 at
  ;; offset+8). Only a genuine memory aggregate (inline struct/enum that is not
  ;; register-resident) needs the byte-copy.
  (if (and
    (lower-type-inline-storage? ctx ty)
    (not (lower-type-register-resident? ctx ty)))
    (lower-copy-bytes state base offset value 0 size)
    (if (lower-type-register-group? ctx ty)
      (match (lower-emit-word state value 0 (lower-register-word-type ctx ty 0))
        [(LowerExpr s0 w0 _)
          (match (lower-emit-word
            s0
            value
            1
            (lower-register-word-type ctx ty 1))
            [(LowerExpr s1 w1 _)
              (lower-store-at-offset
                (lower-store-at-offset
                  s1
                  base
                  offset
                  w0
                  (lower-register-word-type ctx ty 0))
                base
                (+ offset 8)
                w1
                (lower-register-word-type ctx ty 1))])])
      (lower-store-at-offset
        state
        base
        offset
        value
        (if (lower-type-register-resident? ctx ty)
          (lower-register-word-type ctx ty 0)
          ty)))))

(define (lower-load-inline-value-at-offset
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [ty : AstType]
  [mode : CompilerLowerMode]) : LowerExpr
  ;; #2386: a register-resident aggregate field is loaded as a word (a scalar
  ;; load), not returned as a pointer into the containing slot. A 2-word
  ;; register-group loads BOTH words and reassembles them with IrInstrPack. Only a
  ;; genuine memory aggregate keeps the pointer-return shape.
  (cond
    [(and
        (lower-mode-inline-aggregates? mode)
        (lower-type-inline-storage? ctx ty)
        (not (lower-type-register-resident? ctx ty)))
      (match (lower-gep-byte state base offset)
        [(LowerExpr ptr-state ptr _) (LowerExpr ptr-state ptr ty)])]
    [(lower-type-register-group? ctx ty)
      (match (lower-load-at-offset
        state
        base
        offset
        (lower-register-word-type ctx ty 0))
        [(LowerExpr s0 w0 _)
          (match (lower-load-at-offset
            s0
            base
            (+ offset 8)
            (lower-register-word-type ctx ty 1))
            [(LowerExpr s1 w1 _)
              (lower-emit-pack
                s1
                (IrValueCons w0 (box (IrValueCons w1 (box IrValueNil))))
                ty)])])]
    [(lower-type-register-resident? ctx ty)
      (match (lower-load-at-offset
        state
        base
        offset
        (lower-register-word-type ctx ty 0))
        [(LowerExpr load-state loaded _) (LowerExpr load-state loaded ty)])]
    [else (lower-load-at-offset state base offset ty)]))

(define (lower-copy-bytes-compact
  [state : LowerState]
  [dst : CompilerIrValue]
  [dst-offset : i64]
  [src : CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (if (<= size 0)
    state
    (if (and (= dst-offset 0) (= src-offset 0))
      (lower-state-emit state (CompilerIrInstr.CopyBytes dst src size))
      (lower-copy-bytes state dst dst-offset src src-offset size))))

(define (lower-inline-aggregate-copy-size [ctx : TcContext] [ty : AstType]) : ResultLowerSize
  (match (tc-inline-aggregate-type-layout ctx ty)
    [(ResultTcLayoutInfo.Ok info)
      (match info
        [(TcLayoutInfo size _) (OkLowerSize size)])]
    [(ResultTcLayoutInfo.Err message) (ErrLowerSize message)]))

(define (lower-copy-inline-aggregate-to-inline
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (match (lower-inline-aggregate-copy-size ctx ty)
    [(OkLowerSize size)
      (match (lower-reserve-inline-storage state size ty)
        [(LowerExpr copy-state copy-value _)
          (OkLowerExpr
            (LowerExpr
              ;; #2386: a register-resident source is carried as word(s), so
              ;; materialize via the group-aware store -- a 2-word group must
              ;; write BOTH words (a bare scalar store dropped word1).
              (if (lower-type-register-resident? ctx ty)
                (lower-store-inline-value-at-offset
                  ctx
                  copy-state
                  copy-value
                  0
                  value
                  ty
                  size)
                (lower-copy-bytes-compact copy-state copy-value 0 value 0 size))
              copy-value
              ty))])]
    [(ErrLowerSize message) (ErrLowerExpr (box (lower-diagnostic message)))]))

(define (lower-copy-inline-aggregate-to-heap-as
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]
  [storage-ty : AstType]) : ResultLowerExpr
  (match (lower-inline-aggregate-copy-size ctx ty)
    [(OkLowerSize size)
      (match (lower-reserve-heap-storage state size storage-ty)
        [(LowerExpr copy-state copy-value _)
          (OkLowerExpr
            (LowerExpr
              ;; #2386: group-aware store here too -- the Win64 C-ABI byref
              ;; path spills register-resident aggregates through this copy,
              ;; and a 2-word group must write BOTH words.
              (if (lower-type-register-resident? ctx ty)
                (lower-store-inline-value-at-offset
                  ctx
                  copy-state
                  copy-value
                  0
                  value
                  ty
                  size)
                (lower-copy-bytes-compact copy-state copy-value 0 value 0 size))
              copy-value
              storage-ty))])]
    [(ErrLowerSize message) (ErrLowerExpr (box (lower-diagnostic message)))]))

(define (lower-copy-inline-aggregate-to-heap
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (lower-copy-inline-aggregate-to-heap-as ctx state value ty ty))

(define (lower-inline-aggregate-abi-copy-needed?
  [ctx : TcContext]
  [state : LowerState]
  [ty : AstType]) : bool
  (and
    (lower-mode-inline-aggregates? (lower-state-mode state))
    ;; #2386: a register-resident aggregate is returned/passed in a register,
    ;; so it needs neither a heap escape-copy nor a caller-provided sret slot.
    (lower-type-inline-storage? ctx ty)
    (not (lower-type-register-resident? ctx ty))))

(define (lower-return-abi-value
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (if (lower-inline-aggregate-abi-copy-needed? ctx state ty)
    (lower-copy-inline-aggregate-to-heap ctx state value ty)
    (OkLowerExpr (LowerExpr state value ty))))

(define (lower-raw-pointer-ir-type [ty : AstType]) : AstType
  (match (tc-type-strip-region ty)
    [(AstType.Ptr _) (AstType.U64)]
    [(AstType.MutPtr _) (AstType.U64)]
    [_ ty]))

(define (lower-cast-value
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : LowerExpr
  (let
    [ir-from-ty : AstType (lower-raw-pointer-ir-type from-ty)]
    [ir-to-ty : AstType (lower-raw-pointer-ir-type to-ty)]
    (if (or (tc-type-eq from-ty to-ty) (tc-type-eq ir-from-ty ir-to-ty))
      (LowerExpr state value to-ty)
      (match (lower-state-alloc-var state)
        [(LowerAlloc allocated var-id)
          (LowerExpr
            (lower-state-emit
              allocated
              (CompilerIrInstr.Cast var-id value ir-from-ty ir-to-ty))
            (CompilerIrValue.Var var-id)
            to-ty)]))))

(define (lower-bitcast-value
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : LowerExpr
  (if (tc-type-eq from-ty to-ty)
    (LowerExpr state value to-ty)
    (match (lower-state-alloc-var state)
      [(LowerAlloc allocated var-id)
        (LowerExpr
          (lower-state-emit
            allocated
            (CompilerIrInstr.Bitcast var-id value from-ty to-ty))
          (CompilerIrValue.Var var-id)
          to-ty)])))

(define (lower-coerce-value
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : LowerExpr
  (cond
    [(tc-never-type? from-ty) (LowerExpr state value from-ty)]
    [(tc-type-eq from-ty to-ty) (LowerExpr state value to-ty)]
    [(tc-type-compatible? to-ty from-ty)
      (lower-cast-value state value from-ty to-ty)]
    [else (LowerExpr state value to-ty)]))

(define (lower-oob-abort [state : LowerState]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (lower-state-emit
        allocated
        (CompilerIrInstr.Call
          var-id
          "tl_oob_abort"
          (CompilerIrCallArgs.Nil)
          (AstType.Unit)))]))

(define (lower-string-fields [state : LowerState] [value : CompilerIrValue]) : LowerStringFields
  (match (lower-load-at-offset state value 0 (AstType.U64))
    [(LowerExpr ptr-state ptr _)
      (match (lower-load-at-offset ptr-state value 8 (AstType.I64))
        [(LowerExpr len-state len _) (LowerStringFields len-state ptr len)])]))

(define (lower-str-ref-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Ref _ inner)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(AstType.Str) true]
        [_ false])]
    [_ false]))

(define (lower-bytes-ref-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Ref _ inner)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(AstType.Bytes) true]
        [_ false])]
    [(AstType.MutRef _ inner)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(AstType.Bytes) true]
        [_ false])]
    [_ false]))

(define (lower-string-handle-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.String) true]
    [_ (lower-str-ref-type? ctx ty)]))

(define (lower-bytes-handle-type? [ctx : TcContext] [ty : AstType]) : bool
  (lower-bytes-ref-type? ctx ty))

(define (lower-length-handle-type? [ctx : TcContext] [ty : AstType]) : bool
  (or (lower-string-handle-type? ctx ty) (lower-bytes-handle-type? ctx ty)))

(define (lower-string-concat-builtin-name? [name : String]) : bool
  (or (string.eq name "string-append") (string.eq name "string-concat")))

(define (lower-string-concat-call-parts
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [expr : AstExpr]) : LowerMaybeStringConcatCall
  (match (ast-expr-unspan-with-pools (tc-context-pools ctx) expr)
    [(AstExpr.Call callee-box args)
      (match (ast-expr-unspan-with-pools
        (tc-context-pools ctx)
        (tc-context-expr-get ctx callee-box))
        [(AstExpr.Var name)
          (if (and
            (lower-string-concat-builtin-name? (intern-str name))
            (lower-builtin-call-available? ctx env (intern-str name)))
            (match args
              [(AstExprList.Cons left tail)
                (let
                  [left : AstExpr (tc-context-expr-get ctx left)]
                  [tail : AstExprList (box-get tail)]
                  (match tail
                    [(AstExprList.Cons right rest)
                      (let
                        [right : AstExpr (tc-context-expr-get ctx right)]
                        [rest : AstExprList (box-get rest)]
                        (match rest
                          [(AstExprList.Nil)
                            (LowerSomeStringConcatCall left right)]
                          [_ (LowerNoStringConcatCall)]))]
                    [_ (LowerNoStringConcatCall)]))]
              [_ (LowerNoStringConcatCall)])
            (LowerNoStringConcatCall))]
        [_ (LowerNoStringConcatCall)])]
    [_ (LowerNoStringConcatCall)]))

(define (lower-string-concat-exprs-right
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [left : AstExpr]
  [right : AstExpr]
  [remaining : i64]) : AstExprList
  (if (<= remaining 2)
    (ast-expr-cons
      (ast-node-push left)
      (ast-expr-cons (ast-node-push right) AstExprList.Nil))
    (match (lower-string-concat-call-parts ctx env right)
      [(LowerSomeStringConcatCall nested-left nested-right)
        (ast-expr-cons
          (ast-node-push left)
          (lower-string-concat-exprs-right
            ctx
            env
            nested-left
            nested-right
            (- remaining 1)))]
      [(LowerNoStringConcatCall)
        (ast-expr-cons
          (ast-node-push left)
          (ast-expr-cons (ast-node-push right) AstExprList.Nil))])))

(define (lower-string-concat-runtime-name [count : i64]) : String
  (cond
    [(= count 3) "tl_string_concat3"]
    [(= count 4) "tl_string_concat4"]
    [(= count 5) "tl_string_concat5"]
    [else "tl_string_concat"]))

(define (lower-string-concat-values-rev
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]
  [acc : CompilerIrValueList]
  [count : i64]) : ResultLowerStringValues
  (match exprs
    [(AstExprList.Nil) (OkLowerStringValues state acc count)]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (tc-context-expr-get ctx expr)]
        [rest : AstExprList (box-get rest)]
        (match (lower-expr ctx state env type-env expr)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr expr-state value expr-ty)
                (if (lower-string-handle-type? ctx expr-ty)
                  (match (lower-string-fields expr-state value)
                    [(LowerStringFields field-state ptr len)
                      (lower-string-concat-values-rev
                        ctx
                        field-state
                        env
                        type-env
                        rest
                        (compiler-ir-value-cons
                          len
                          (compiler-ir-value-cons ptr acc))
                        (+ count 1))])
                  (ErrLowerStringValues
                    (box
                      (lower-diagnostic-at-expr
                        expr
                        "lower: string-concat requires String"))))])]
          [(ErrLowerExpr message) (ErrLowerStringValues message)]))]))

(define (lower-string-concat-exprs
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : ResultLowerExpr
  (match (lower-string-concat-values-rev
    ctx
    state
    env
    type-env
    exprs
    IrValueNil
    0)
    [(OkLowerStringValues values-state values-rev count)
      (match (lower-state-alloc-var values-state)
        [(LowerAlloc allocated var-id)
          (OkLowerExpr
            (LowerExpr
              (lower-state-emit
                allocated
                (CompilerIrInstr.Call
                  var-id
                  (lower-string-concat-runtime-name count)
                  (compiler-ir-call-args-from-list
                    (compiler-ir-value-list-reverse-onto values-rev IrValueNil))
                  (AstType.String)))
              (CompilerIrValue.Var var-id)
              (AstType.String)))])]
    [(ErrLowerStringValues message) (ErrLowerExpr message)]))

(define (lower-supported-reference-referent-type?
  [ctx : TcContext]
  [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.F64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.F32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Str) true]
    [(AstType.Bytes) true]
    [(AstType.Tuple elems)
      (lower-supported-reference-type-list-with-stack?
        ctx
        (box-get elems)
        LowerStringNil)]
    [(AstType.Array elem-ty _)
      (not (tc-type-contains-reference? (tc-context-type-get ctx elem-ty)))]
    [(AstType.DynArray elem-ty)
      (not (tc-type-contains-reference? (tc-context-type-get ctx elem-ty)))]
    [(AstType.Struct name)
      (lower-supported-reference-struct-args-with-stack?
        ctx
        (intern-str name)
        AstLifetimeList.Nil
        LowerStringNil)]
    [(AstType.StructArgs name lifetimes)
      (lower-supported-reference-struct-args-with-stack?
        ctx
        (intern-str name)
        (box-get lifetimes)
        LowerStringNil)]
    [(AstType.Enum name)
      (lower-supported-reference-enum-args-with-stack?
        ctx
        (intern-str name)
        AstLifetimeList.Nil
        LowerStringNil)]
    [(AstType.EnumArgs name lifetimes)
      (lower-supported-reference-enum-args-with-stack?
        ctx
        (intern-str name)
        (box-get lifetimes)
        LowerStringNil)]
    [_ false]))

(define (lower-borrow-place-value-reference? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (if (lower-type-register-resident? ctx resolved)
      false
      (match resolved
        [(AstType.Tuple _) true]
        [(AstType.Array _ _) true]
        [(AstType.DynArray _) true]
        [(AstType.Struct _) true]
        [(AstType.StructArgs _ _) true]
        [(AstType.Enum _) true]
        [(AstType.EnumArgs _ _) true]
        [_ false]))))

(define (lower-supported-reference-type-list-with-stack?
  [ctx : TcContext]
  [types : AstTypeList]
  [stack : LowerStringSet]) : bool
  (match types
    [(AstTypeList.Nil) true]
    [(AstTypeList.Cons head rest)
      (let
        [head : AstType (tc-context-type-get ctx head)]
        [rest : AstTypeList (box-get rest)]
        (and
          (lower-supported-reference-type-with-stack? ctx head stack)
          (lower-supported-reference-type-list-with-stack? ctx rest stack)))]))

(define (lower-supported-reference-type-list-subst-with-stack?
  [ctx : TcContext]
  [subst : TcLifetimeSubst]
  [types : AstTypeList]
  [stack : LowerStringSet]) : bool
  (match types
    [(AstTypeList.Nil) true]
    [(AstTypeList.Cons head rest)
      (let
        [head : AstType (tc-context-type-get ctx head)]
        [rest : AstTypeList (box-get rest)]
        (and
          (lower-supported-reference-type-with-stack?
            ctx
            (tc-lifetime-subst-type subst head)
            stack)
          (lower-supported-reference-type-list-subst-with-stack?
            ctx
            subst
            rest
            stack)))]))

(define (lower-supported-reference-field-list-with-stack?
  [ctx : TcContext]
  [subst : TcLifetimeSubst]
  [fields : AstFieldDefList]
  [stack : LowerStringSet]) : bool
  (match fields
    [(AstFieldDefList.Nil) true]
    [(AstFieldDefList.Cons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef.Def _ ty _)
            (and
              (lower-supported-reference-type-with-stack?
                ctx
                (tc-lifetime-subst-type subst ty)
                stack)
              (lower-supported-reference-field-list-with-stack?
                ctx
                subst
                rest
                stack))]))]))

(define (lower-supported-reference-variant-list-with-stack?
  [ctx : TcContext]
  [subst : TcLifetimeSubst]
  [variants : AstVariantDefList]
  [stack : LowerStringSet]) : bool
  (match variants
    [(AstVariantDefList.Nil) true]
    [(AstVariantDefList.Cons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef.Def _ fields _)
            (and
              (lower-supported-reference-type-list-subst-with-stack?
                ctx
                subst
                fields
                stack)
              (lower-supported-reference-variant-list-with-stack?
                ctx
                subst
                rest
                stack))]))]))

(define (lower-supported-reference-struct-args-with-stack?
  [ctx : TcContext]
  [name : String]
  [lifetimes : AstLifetimeList]
  [stack : LowerStringSet]) : bool
  (if (lower-string-set-contains? stack name)
    true
    (match (tc-lifetime-subst-from-nominal-args ctx name lifetimes)
      [(ResultTcLifetimeSubst.Err _) false]
      [(ResultTcLifetimeSubst.Ok subst)
        (match (tc-struct-decl ctx name)
          [(ResultTcStructDecl.Err _) false]
          [(ResultTcStructDecl.Ok decl)
            (match decl
              [(TcStructDecl _ _ fields)
                (lower-supported-reference-field-list-with-stack?
                  ctx
                  subst
                  fields
                  (lower-string-set-insert stack name))])])])))

(define (lower-supported-reference-enum-args-with-stack?
  [ctx : TcContext]
  [name : String]
  [lifetimes : AstLifetimeList]
  [stack : LowerStringSet]) : bool
  (if (lower-string-set-contains? stack name)
    true
    (match (tc-lifetime-subst-from-nominal-args ctx name lifetimes)
      [(ResultTcLifetimeSubst.Err _) false]
      [(ResultTcLifetimeSubst.Ok subst)
        (match (tc-context-enum-variants ctx name)
          [(ResultAstVariantDefList.Err _) false]
          [(ResultAstVariantDefList.Ok variants)
            (lower-supported-reference-variant-list-with-stack?
              ctx
              subst
              variants
              (lower-string-set-insert stack name))])])))

(define (lower-supported-reference-type-with-stack?
  [ctx : TcContext]
  [ty : AstType]
  [stack : LowerStringSet]) : bool
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (if (not (tc-type-contains-reference? resolved))
      true
      (match resolved
        [(AstType.Ref _ inner)
          (lower-supported-reference-referent-type?
            ctx
            (tc-context-type-get ctx inner))]
        [(AstType.MutRef _ inner)
          (lower-supported-reference-referent-type?
            ctx
            (tc-context-type-get ctx inner))]
        [(AstType.Tuple elems)
          (lower-supported-reference-type-list-with-stack?
            ctx
            (box-get elems)
            stack)]
        [(AstType.Array elem _)
          (lower-supported-reference-type-with-stack?
            ctx
            (tc-context-type-get ctx elem)
            stack)]
        [(AstType.Box elem)
          (lower-supported-reference-type-with-stack?
            ctx
            (tc-context-type-get ctx elem)
            stack)]
        [(AstType.Func params ret)
          (and
            (lower-supported-reference-type-list-with-stack?
              ctx
              (box-get params)
              stack)
            (lower-supported-reference-type-with-stack?
              ctx
              (tc-context-type-get ctx ret)
              stack))]
        [(AstType.StructArgs name lifetimes)
          (lower-supported-reference-struct-args-with-stack?
            ctx
            (intern-str name)
            (box-get lifetimes)
            stack)]
        [(AstType.EnumArgs name lifetimes)
          (lower-supported-reference-enum-args-with-stack?
            ctx
            (intern-str name)
            (box-get lifetimes)
            stack)]
        [(AstType.Region _ inner)
          (lower-supported-reference-type-with-stack?
            ctx
            (tc-context-type-get ctx inner)
            stack)]
        [_ false]))))

(define (lower-supported-reference-type? [ctx : TcContext] [ty : AstType]) : bool
  (lower-supported-reference-type-with-stack? ctx ty LowerStringNil))

(define (lower-borrowed-str-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (lower-str-ref-type? ctx expr-ty)
    (match (lower-expr ctx state env type-env inner)
      [(OkLowerExpr lowered)
        (match lowered
          [(LowerExpr inner-state value _)
            (OkLowerExpr (LowerExpr inner-state value expr-ty))])]
      [(ErrLowerExpr message) (ErrLowerExpr message)])
    (ErrLowerExpr
      (box (lower-diagnostic-at-expr origin (lower-reference-support-message))))))

(define (lower-borrow-copy-to-storage
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [referent-ty : AstType]
  [result-ty : AstType]) : LowerExpr
  (let
    [resolved : AstType
      (tc-type-without-regions (tc-resolve-type ctx referent-ty))]
    [size : i64 (lower-type-size ctx resolved)]
    (match (lower-reserve-heap-storage
      state
      (if (= size 0)
        1
        size)
      result-ty)
      [(LowerExpr base-state base _)
        (LowerExpr
          (if (> size 0)
            (lower-store-inline-value-at-offset
              ctx
              base-state
              base
              0
              value
              resolved
              size)
            base-state)
          base
          result-ty)])))

(define (lower-borrow-copy-to-inline-storage
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [referent-ty : AstType]
  [result-ty : AstType]) : LowerExpr
  (let
    [resolved : AstType
      (tc-type-without-regions (tc-resolve-type ctx referent-ty))]
    [size : i64 (lower-type-size ctx resolved)]
    (match (lower-reserve-inline-storage
      state
      (if (= size 0)
        1
        size)
      resolved)
      [(LowerExpr base-state base _)
        (LowerExpr
          (if (> size 0)
            (lower-store-inline-value-at-offset
              ctx
              base-state
              base
              0
              value
              resolved
              size)
            base-state)
          base
          result-ty)])))

(define (lower-borrow-place-slot-reference
  [ctx : TcContext]
  [state : LowerState]
  [slot : CompilerIrValue]
  [stored-ty : AstType]
  [result-ty : AstType]
  [load-value-reference : bool]) : LowerExpr
  (if (and
    load-value-reference
    (lower-borrow-place-value-reference?
      ctx
      (tc-borrow-referent-type stored-ty)))
    (match (lower-state-alloc-var state)
      [(LowerAlloc allocated var-id)
        (LowerExpr
          (lower-state-emit
            allocated
            (CompilerIrInstr.Load var-id slot stored-ty))
          (CompilerIrValue.Var var-id)
          result-ty)])
    (LowerExpr state slot result-ty)))

(define (lower-borrow-reference-var-address
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : String]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-or env name (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? id)
      (OkLowerExpr (LowerExpr state (CompilerIrValue.Var id) result-ty))
      (OkLowerExpr
        (LowerExpr
          state
          (CompilerIrValue.Global (lower-resolve-name state name))
          result-ty)))))

(define (lower-borrow-var-address-by-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : String]
  [place-ty : AstType]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [referent-ty : AstType (tc-borrow-referent-type place-ty)]
    [id : i64
      (sym_i64_env.sym-i64-lookup-or env name (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? id)
      (if (lower-borrow-place-value-reference? ctx referent-ty)
        (OkLowerExpr (LowerExpr state (CompilerIrValue.Var id) result-ty))
        (match (tc-type-strip-region (tc-resolve-type ctx result-ty))
          [(AstType.MutRef _ _)
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: mutable borrow of by-value place requires writeback support")))]
          [_
            (OkLowerExpr
              (lower-borrow-copy-to-storage
                ctx
                state
                (CompilerIrValue.Var id)
                referent-ty
                result-ty))]))
      (OkLowerExpr
        (LowerExpr
          state
          (CompilerIrValue.GlobalAddr (lower-resolve-name state name))
          result-ty)))))

(define (lower-borrow-var-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (tc-lookup type-env name)
    [(ResultTcType.Ok place-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx place-ty))
        [(AstType.Ref _ _)
          (lower-borrow-reference-var-address state env name result-ty)]
        [(AstType.MutRef _ _)
          (lower-borrow-reference-var-address state env name result-ty)]
        [_
          (if (and
            (tc-type-contains-reference? place-ty)
            (not (lower-supported-reference-type? ctx place-ty)))
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-reference-support-message))))
            (lower-borrow-var-address-by-value
              ctx
              state
              env
              name
              place-ty
              origin
              result-ty))])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-borrow-struct-field-address-from-memory
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [struct-name : String]
  [field : String]
  [_origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-struct-field-info ctx struct-name field)
    [(OkLowerFieldInfo info)
      (match info
        [(LowerFieldInfo offset field-ty)
          (let
            [load-value-reference : bool
              (not
                (or
                  (and
                    (lower-struct-repr-c? ctx struct-name)
                    (lower-repr-c-inline-field? ctx field-ty))
                  (and
                    (lower-mode-inline-aggregates? (lower-state-mode state))
                    (lower-type-inline-storage? ctx field-ty)
                    (not (lower-type-register-resident? ctx field-ty)))))]
            (match (lower-gep-byte state base offset)
              [(LowerExpr ptr-state ptr _)
                (OkLowerExpr
                  (lower-borrow-place-slot-reference
                    ctx
                    ptr-state
                    ptr
                    field-ty
                    result-ty
                    load-value-reference))]))])]
    [(ErrLowerFieldInfo message) (ErrLowerExpr message)]))

(define (lower-borrow-struct-field-address-named
  [ctx : TcContext]
  [state : LowerState]
  [receiver-value : CompilerIrValue]
  [struct-name : String]
  [field : String]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  ;; #2386: a register-resident receiver has no address; materialize the packed
  ;; word to a fresh slot, then take the field address through the same memory
  ;; helper used for borrowed struct references.
  (if (tc-name-register-resident? ctx struct-name)
    (match (lower-borrow-copy-to-storage
      ctx
      state
      receiver-value
      (AstType.Struct (intern struct-name))
      result-ty)
      [(LowerExpr mat-state mat-ptr _)
        (lower-borrow-struct-field-address-from-memory
          ctx
          mat-state
          mat-ptr
          struct-name
          field
          origin
          result-ty)])
    (lower-borrow-struct-field-address-from-memory
      ctx
      state
      receiver-value
      struct-name
      field
      origin
      result-ty)))

(define (lower-borrow-struct-field-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [receiver : AstExpr]
  [field : String]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env receiver)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr receiver-state receiver-value receiver-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
            [(AstType.Struct struct-name)
              (lower-borrow-struct-field-address-named
                ctx
                receiver-state
                receiver-value
                (intern-str struct-name)
                field
                origin
                result-ty)]
            [(AstType.StructArgs struct-name _)
              (lower-borrow-struct-field-address-named
                ctx
                receiver-state
                receiver-value
                (intern-str struct-name)
                field
                origin
                result-ty)]
            [(AstType.Ref _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (ty-node-get referent-ty)))
                [(AstType.Struct struct-name)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    (intern-str struct-name)
                    field
                    origin
                    result-ty)]
                [(AstType.StructArgs struct-name _)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    (intern-str struct-name)
                    field
                    origin
                    result-ty)]
                [_
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: struct-get borrow requires struct place")))])]
            [(AstType.MutRef _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (ty-node-get referent-ty)))
                [(AstType.Struct struct-name)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    (intern-str struct-name)
                    field
                    origin
                    result-ty)]
                [(AstType.StructArgs struct-name _)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    (intern-str struct-name)
                    field
                    origin
                    result-ty)]
                [_
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: struct-get borrow requires struct place")))])]
            [_
              (ErrLowerExpr
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "lower: struct-get borrow requires struct place")))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-borrow-tuple-field-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [tuple-expr : AstExpr]
  [index : i64]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env tuple-expr)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr tuple-state tuple-value tuple-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx tuple-ty))
            [(AstType.Tuple elem-tys)
              (match (lower-tuple-elem-info ctx (box-get elem-tys) index 0 0)
                [(OkLowerFieldInfo info)
                  (match info
                    [(LowerFieldInfo offset _)
                      (match (lower-gep-byte tuple-state tuple-value offset)
                        [(LowerExpr ptr-state ptr _)
                          (OkLowerExpr (LowerExpr ptr-state ptr result-ty))])])]
                [(ErrLowerFieldInfo message) (ErrLowerExpr message)])]
            [(AstType.Ref _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (ty-node-get referent-ty)))
                [(AstType.Tuple elem-tys)
                  (match (lower-tuple-elem-info
                    ctx
                    (box-get elem-tys)
                    index
                    0
                    0)
                    [(OkLowerFieldInfo info)
                      (match info
                        [(LowerFieldInfo offset _)
                          (match (lower-gep-byte tuple-state tuple-value offset)
                            [(LowerExpr ptr-state ptr _)
                              (OkLowerExpr (LowerExpr ptr-state ptr result-ty))])])]
                    [(ErrLowerFieldInfo message) (ErrLowerExpr message)])]
                [_
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: tuple-ref borrow requires tuple place")))])]
            [(AstType.MutRef _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (ty-node-get referent-ty)))
                [(AstType.Tuple elem-tys)
                  (match (lower-tuple-elem-info
                    ctx
                    (box-get elem-tys)
                    index
                    0
                    0)
                    [(OkLowerFieldInfo info)
                      (match info
                        [(LowerFieldInfo offset _)
                          (match (lower-gep-byte tuple-state tuple-value offset)
                            [(LowerExpr ptr-state ptr _)
                              (OkLowerExpr (LowerExpr ptr-state ptr result-ty))])])]
                    [(ErrLowerFieldInfo message) (ErrLowerExpr message)])]
                [_
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: tuple-ref borrow requires tuple place")))])]
            [_
              (ErrLowerExpr
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "lower: tuple-ref borrow requires tuple place")))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-borrow-array-element-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [index : AstExpr]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      (match (tc-type-strip-region arr-ty)
        [(AstType.DynArray elem-ty)
          (match (lower-expr ctx state env type-env arr)
            [(OkLowerExpr arr-lowered)
              (match arr-lowered
                [(LowerExpr arr-state arr-value _)
                  (match (lower-index-result-type-or-check
                    ctx
                    env
                    type-env
                    (lower-state-type-cache arr-state)
                    index)
                    [(ResultTcType.Ok idx-ty)
                      (match (lower-expr-expected
                        ctx
                        arr-state
                        env
                        type-env
                        index
                        idx-ty
                        index)
                        [(OkLowerExpr idx-lowered)
                          (match idx-lowered
                            [(LowerExpr idx-state idx-value idx-value-ty)
                              (match (lower-array-element-addr
                                ctx
                                idx-state
                                arr-value
                                idx-value
                                idx-value-ty
                                (tc-type-without-regions (ty-node-get elem-ty)))
                                [(LowerExpr addr-state elem-ptr _)
                                  (OkLowerExpr
                                    (LowerExpr addr-state elem-ptr result-ty))])])]
                        [(ErrLowerExpr message) (ErrLowerExpr message)])]
                    [(ResultTcType.Err message)
                      (ErrLowerExpr
                        (box (lower-diagnostic-at-expr index message)))])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])]
        [(AstType.Array elem-ty elem-count)
          (let
            [fixed-elem-ty : AstType
              (tc-type-without-regions (ty-node-get elem-ty))]
            (match (lower-expr ctx state env type-env arr)
              [(OkLowerExpr arr-lowered)
                (match arr-lowered
                  [(LowerExpr arr-state arr-value _)
                    (match (lower-index-result-type-or-check
                      ctx
                      env
                      type-env
                      (lower-state-type-cache arr-state)
                      index)
                      [(ResultTcType.Ok idx-ty)
                        (match (lower-expr-expected
                          ctx
                          arr-state
                          env
                          type-env
                          index
                          idx-ty
                          index)
                          [(OkLowerExpr idx-lowered)
                            (match idx-lowered
                              [(LowerExpr idx-state idx-value idx-value-ty)
                                (match (lower-fixed-array-element-addr
                                  ctx
                                  idx-state
                                  arr-value
                                  idx-value
                                  idx-value-ty
                                  fixed-elem-ty
                                  elem-count)
                                  [(LowerExpr addr-state elem-ptr _)
                                    (OkLowerExpr
                                      (LowerExpr addr-state elem-ptr result-ty))])])]
                          [(ErrLowerExpr message) (ErrLowerExpr message)])]
                      [(ResultTcType.Err message)
                        (ErrLowerExpr
                          (box (lower-diagnostic-at-expr index message)))])])]
              [(ErrLowerExpr message) (ErrLowerExpr message)]))]
        [_
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: array-ref borrow requires array place")))])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr arr message)))]))

(define (lower-borrow-place-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [place : AstExpr]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (ast-expr-unspan place)
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? type-env name)
          (match (tc-dotted-local-field-expr-id type-env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (lower-borrow-place-address
                ctx
                state
                env
                type-env
                (ast-node-get virtual-id)
                origin
                result-ty)]
            [(ResultTcExprId.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])
          (lower-borrow-var-address
            ctx
            state
            env
            type-env
            name-text
            origin
            result-ty)))]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (lower-borrow-struct-field-address
          ctx
          state
          env
          type-env
          receiver
          (intern-str field)
          origin
          result-ty))]
    [(AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : AstExpr (ast-node-get tuple-expr-box)]
        (lower-borrow-tuple-field-address
          ctx
          state
          env
          type-env
          tuple-expr
          index
          origin
          result-ty))]
    [(AstExpr.ArrayRef arr-box index-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-borrow-array-element-address
          ctx
          state
          env
          type-env
          arr
          index
          origin
          result-ty))]
    [(AstExpr.BoxGet box-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        (lower-box-storage-address
          ctx
          state
          env
          type-env
          box-expr
          origin
          result-ty))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: borrow requires a local, parameter, or aggregate place")))]))

(define (lower-borrow-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (lower-str-ref-type? ctx expr-ty)
    (lower-borrowed-str-expr ctx state env type-env inner origin expr-ty)
    (match (tc-type-strip-region (tc-resolve-type ctx expr-ty))
      [(AstType.Ref _ referent-ty)
        (if (lower-supported-reference-referent-type?
          ctx
          (ty-node-get referent-ty))
          (lower-borrow-place-address
            ctx
            state
            env
            type-env
            inner
            origin
            expr-ty)
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-reference-support-message)))))]
      [(AstType.MutRef _ referent-ty)
        (if (lower-supported-reference-referent-type?
          ctx
          (ty-node-get referent-ty))
          (lower-borrow-place-address
            ctx
            state
            env
            type-env
            inner
            origin
            expr-ty)
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-reference-support-message)))))]
      [_
        (ErrLowerExpr
          (box
            (lower-diagnostic-at-expr origin (lower-reference-support-message))))])))

(define (lower-store-values
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [types : AstTypeList]
  [cursor : i64]) : ResultLowerState
  (match values
    [(IrValueNil)
      (match types
        [(AstTypeList.Nil) (OkLowerState state)]
        [_
          (ErrLowerState
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(IrValueCons value rest-values)
      (match types
        [(AstTypeList.Cons ty rest-types)
          (let
            [ty : AstType (ty-node-get ty)]
            [rest-types : AstTypeList (box-get rest-types)]
            [resolved : AstType (tc-resolve-type ctx ty)]
            [offset : i64
              (lower-align-up cursor (lower-type-align ctx resolved))]
            (lower-store-values
              ctx
              (lower-store-at-offset state base offset value resolved)
              base
              (box-get rest-values)
              rest-types
              (+ offset (lower-type-size ctx resolved))))]
        [(AstTypeList.Nil)
          (ErrLowerState
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]))

(define (lower-store-repr-c-values
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [fields : TcReprCFieldLayoutList]) : ResultLowerState
  (match values
    [(IrValueNil)
      (match fields
        [(TcReprCFieldLayoutList.Nil) (OkLowerState state)]
        [_
          (ErrLowerState
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(IrValueCons value rest-values)
      (match fields
        [(TcReprCFieldLayoutList.Cons field rest-fields)
          (match field
            [(TcReprCFieldLayout.Field _ field-ty offset)
              (let
                [stored-state : LowerState
                  (if (lower-repr-c-inline-field? ctx field-ty)
                    (lower-copy-bytes
                      state
                      base
                      offset
                      value
                      0
                      (lower-repr-c-field-size ctx field-ty))
                    (lower-store-at-offset state base offset value field-ty))]
                (lower-store-repr-c-values
                  ctx
                  stored-state
                  base
                  (box-get rest-values)
                  (box-get rest-fields)))])]
        [(TcReprCFieldLayoutList.Nil)
          (ErrLowerState
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]))

(define (lower-store-inline-struct-values
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [layout : TcInlineAggregateLayout]) : ResultLowerState
  (match values
    [(IrValueNil)
      (match fields
        [(AstFieldDefList.Nil) (OkLowerState state)]
        [_
          (ErrLowerState
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(IrValueCons value rest-values)
      (match fields
        [(AstFieldDefList.Cons field rest-fields)
          (let
            [rest-fields : AstFieldDefList (box-get rest-fields)]
            (match field
              [(AstFieldDef.Def name ty _)
                (let
                  [name-str : String (intern-str name)]
                  [resolved : AstType (tc-resolve-type ctx ty)]
                  [offset : i64
                    (tc-inline-aggregate-layout-field-offset layout name-str)]
                  (if (< offset 0)
                    (ErrLowerState
                      (box
                        (lower-diagnostic
                          (string.append
                            "lower: inline struct layout missing field "
                            name-str))))
                    (match (tc-inline-aggregate-type-layout ctx resolved)
                      [(ResultTcLayoutInfo.Ok info)
                        (let
                          [stored-state : LowerState
                            (if (<= (tc-layout-info-size info) 0)
                              state
                              (lower-store-inline-value-at-offset
                                ctx
                                state
                                base
                                offset
                                value
                                resolved
                                (tc-layout-info-size info)))]
                          (lower-store-inline-struct-values
                            ctx
                            stored-state
                            base
                            (box-get rest-values)
                            rest-fields
                            layout))]
                      [(ResultTcLayoutInfo.Err message)
                        (ErrLowerState (box (lower-diagnostic message)))])))]))]
        [(AstFieldDefList.Nil)
          (ErrLowerState
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]))

(define (lower-store-inline-payload-values
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [types : AstTypeList]
  [layout : TcInlineAggregateLayout]
  [variant-name : String]
  [index : i64]) : ResultLowerState
  (match values
    [(IrValueNil)
      (match types
        [(AstTypeList.Nil) (OkLowerState state)]
        [_
          (ErrLowerState
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(IrValueCons value rest-values)
      (match types
        [(AstTypeList.Cons ty rest-types)
          (let
            [ty : AstType (ty-node-get ty)]
            [rest-types : AstTypeList (box-get rest-types)]
            [resolved : AstType (tc-resolve-type ctx ty)]
            [offset : i64
              (tc-inline-aggregate-layout-variant-payload-offset
                layout
                variant-name
                index)]
            (if (< offset 0)
              (ErrLowerState
                (box
                  (lower-diagnostic
                    (string.append
                      "lower: inline enum layout missing payload for "
                      variant-name))))
              (match (tc-inline-aggregate-type-layout ctx resolved)
                [(ResultTcLayoutInfo.Ok info)
                  (lower-store-inline-payload-values
                    ctx
                    (if (<= (tc-layout-info-size info) 0)
                      state
                      (lower-store-inline-value-at-offset
                        ctx
                        state
                        base
                        offset
                        value
                        resolved
                        (tc-layout-info-size info)))
                    base
                    (box-get rest-values)
                    rest-types
                    layout
                    variant-name
                    (+ index 1))]
                [(ResultTcLayoutInfo.Err message)
                  (ErrLowerState (box (lower-diagnostic message)))])))]
        [(AstTypeList.Nil)
          (ErrLowerState
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]))

(define (lower-literal-payload-supported? [lit : AstLiteral]) : bool
  (match lit
    [(AstLiteral.Int _ _) true]
    [(AstLiteral.Bool _) true]
    [(AstLiteral.Char _) true]
    [(AstLiteral.String _) true]
    [_ false]))

(define (lower-enum-type-name-or-empty [ty : AstType]) : String
  (match (tc-type-strip-region ty)
    [(AstType.Enum enum-name) (intern-str enum-name)]
    [(AstType.EnumArgs enum-name _) (intern-str enum-name)]
    [(AstType.VarArgs enum-name _) (intern-str enum-name)]
    [_ ""]))

(define (lower-struct-type-name-or-empty [ty : AstType]) : String
  (match (tc-type-strip-region ty)
    [(AstType.Struct struct-name) (intern-str struct-name)]
    [(AstType.StructArgs struct-name _) (intern-str struct-name)]
    [(AstType.VarArgs struct-name _) (intern-str struct-name)]
    [_ ""]))

(define (lower-variant-lookup-name-for-scrut
  [ctx : TcContext]
  [scrut-ty : AstType]
  [variant-name : String]) : String
  (match (tc-type-strip-region scrut-ty)
    [(AstType.Enum enum-name)
      (tc-source-variant-name-for-enum ctx (intern-str enum-name) variant-name)]
    [(AstType.EnumArgs enum-name _)
      (tc-source-variant-name-for-enum ctx (intern-str enum-name) variant-name)]
    [(AstType.VarArgs enum-name _)
      (tc-source-variant-name-for-enum ctx (intern-str enum-name) variant-name)]
    [_ variant-name]))

(define (lower-type-debug-kind [ty : AstType]) : String
  (match (tc-type-strip-region ty)
    [(AstType.Enum _) "enum"]
    [(AstType.EnumArgs _ _) "enum-args"]
    [(AstType.Struct _) "struct"]
    [(AstType.StructArgs _ _) "struct-args"]
    [(AstType.Var _) "var"]
    [(AstType.VarArgs _ _) "var-args"]
    [(AstType.Ref _ _) "ref"]
    [(AstType.MutRef _ _) "mut-ref"]
    [_ "other"]))

(define (lower-unsupported-match-pattern-message
  [ctx : TcContext]
  [scrut-ty : AstType]
  [variant-name : String]) : String
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
    (str_cat.str-cat
      "lower: unsupported match pattern "
      variant-name
      " in module "
      (tc-context-module ctx)
      " raw "
      (lower-type-debug-kind scrut-ty)
      " "
      (tc-type-render scrut-ty)
      " resolved "
      (lower-type-debug-kind resolved)
      " "
      (tc-type-render resolved))))

(define (lower-member-name-base [name : String]) : String
  (let
    [source : String
      (if (tc-name-qualified? name)
        (tc-qualified-name-base name)
        name)]
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length source)]
    (begin
      (while (< i n)
        (begin
          (if (string.char-eq (string.string-ref source i) '.')
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      (if (and (>= last-dot 0) (< last-dot (- n 1)))
        (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
        source))))

(define (lower-variant-payload-offset
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [enum-name : String]
  [variant-name : String]
  [index : i64]
  [cursor : i64]
  [resolved : AstType]) : i64
  (if (and
    (lower-mode-inline-aggregates? mode)
    (> (string.string-length enum-name) 0))
    (match (tc-inline-aggregate-layout-for ctx enum-name)
      [(ResultTcInlineAggregateLayout.Ok layout)
        (tc-inline-aggregate-layout-variant-payload-offset
          layout
          (lower-member-name-base variant-name)
          index)]
      [(ResultTcInlineAggregateLayout.Err _) (- 0 1)])
    (lower-align-up cursor (lower-type-align ctx resolved))))

(define (lower-string-payload-literal-eq
  [state : LowerState]
  [field-value : CompilerIrValue]
  [lit-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state field-value)
    [(LowerStringFields field-state field-ptr field-len)
      (match (lower-string-fields field-state lit-value)
        [(LowerStringFields done-state lit-ptr lit-len)
          (OkLowerExpr
            (lower-inline-string-eq-fields
              done-state
              field-ptr
              field-len
              lit-ptr
              lit-len
              (AstType.Bool)))])]))

(define (lower-literal-payload-eq
  [ctx : TcContext]
  [state : LowerState]
  [field-value : CompilerIrValue]
  [lit : AstLiteral]
  [resolved : AstType]) : ResultLowerExpr
  (match lit
    [(AstLiteral.String _)
      (if (lower-string-handle-type? ctx resolved)
        (lower-string-payload-literal-eq
          state
          field-value
          (lower-literal-value-with-type lit resolved))
        (ErrLowerExpr
          (box
            (lower-diagnostic
              "lower: unsupported enum payload literal pattern type"))))]
    [_
      (match (lower-state-alloc-var state)
        [(LowerAlloc eq-alloc eq-var)
          (OkLowerExpr
            (LowerExpr
              (lower-state-emit
                eq-alloc
                (CompilerIrInstr.BinOp
                  eq-var
                  CompilerIrBinOp.Eq
                  field-value
                  (lower-literal-value-with-type lit resolved)
                  resolved))
              (CompilerIrValue.Var eq-var)
              (AstType.Bool)))])]))

(define (lower-box-pattern-name? [name : i64]) : bool
  (string.eq (intern-str name) "box"))

(define (lower-bind-irrefutable-box-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [pattern : AstPattern]
  [inner-ty : AstType]) : ResultLowerEnv
  (match pattern
    [(AstPattern.Wildcard) (OkLowerEnv state env type-env)]
    [(AstPattern.Binding name)
      (match value
        [(CompilerIrValue.Var value-var)
          (OkLowerEnv
            state
            (sym_i64_env.sym-i64-bind-id env name value-var)
            (tc-bind-id type-env name inner-ty))]
        [_
          (ErrLowerEnv
            (box (lower-diagnostic "lower: internal box pattern load failed")))])]
    [(AstPattern.Variant name args-box)
      (if (lower-box-pattern-name? name)
        (lower-bind-box-pattern
          ctx
          state
          env
          type-env
          value
          inner-ty
          (box-get args-box))
        (ErrLowerEnv
          (box (lower-diagnostic "lower: unsupported refutable box pattern"))))]
    [_
      (ErrLowerEnv
        (box (lower-diagnostic "lower: unsupported refutable box pattern")))]))

(define (lower-bind-box-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [box-value : CompilerIrValue]
  [box-ty : AstType]
  [args : AstPatternList]) : ResultLowerEnv
  (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
    [(AstType.Box inner-node)
      (match args
        [(AstPatternList.Cons inner rest-box)
          (let
            [inner : AstPattern (box-get inner)]
            [rest : AstPatternList (box-get rest-box)]
            [inner-ty : AstType (tc-resolve-type ctx (ty-node-get inner-node))]
            (match rest
              [(AstPatternList.Nil)
                (match (lower-load-inline-value-at-offset
                  ctx
                  state
                  box-value
                  0
                  inner-ty
                  (lower-state-mode state))
                  [(LowerExpr load-state inner-value _)
                    (lower-bind-irrefutable-box-value
                      ctx
                      load-state
                      env
                      type-env
                      inner-value
                      inner
                      inner-ty)])]
              [_
                (ErrLowerEnv
                  (box
                    (lower-diagnostic
                      "lower: box pattern expects exactly one inner pattern")))]))]
        [_
          (ErrLowerEnv
            (box
              (lower-diagnostic
                "lower: box pattern expects exactly one inner pattern")))])]
    [_
      (ErrLowerEnv
        (box (lower-diagnostic "lower: box pattern requires Box type")))]))

(define (lower-bind-box-variant-payload
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [nested-args : AstPatternList]
  [resolved : AstType]
  [mode : CompilerLowerMode]
  [enum-name : String]
  [variant-name : String]
  [rest-patterns : AstPatternList]
  [rest-types : AstTypeList]
  [offset : i64]
  [next-index : i64]
  [next-cursor : i64]
  [fail-label : String]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match (tc-type-strip-region (tc-resolve-type ctx resolved))
    [(AstType.Box _)
      (match (if scrut-reg-group?
        (lower-read-register-group-payload
          ctx
          state
          base
          (AstType.Enum (intern enum-name))
          offset
          resolved)
        (lower-load-inline-value-at-offset ctx state base offset resolved mode))
        [(LowerExpr field-state field-value _)
          (match (lower-bind-box-pattern
            ctx
            field-state
            env
            type-env
            field-value
            resolved
            nested-args)
            [(OkLowerEnv box-state box-env box-type-env)
              (lower-bind-variant-payloads
                ctx
                box-state
                box-env
                box-type-env
                base
                rest-patterns
                rest-types
                mode
                enum-name
                variant-name
                next-index
                next-cursor
                fail-label
                scrut-reg-group?)]
            [(ErrLowerEnv message) (ErrLowerEnv message)])])]
    [_
      (ErrLowerEnv
        (box (lower-diagnostic "lower: box pattern requires Box payload")))]))

(define (lower-bind-struct-variant-payload
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [nested-args : AstPatternList]
  [resolved : AstType]
  [mode : CompilerLowerMode]
  [enum-name : String]
  [variant-name : String]
  [rest-patterns : AstPatternList]
  [rest-types : AstTypeList]
  [offset : i64]
  [next-index : i64]
  [next-cursor : i64]
  [fail-label : String]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match (if scrut-reg-group?
    (lower-read-register-group-payload
      ctx
      state
      base
      (AstType.Enum (intern enum-name))
      offset
      resolved)
    (lower-load-inline-value-at-offset ctx state base offset resolved mode))
    [(LowerExpr field-state field-value _)
      (match (lower-bind-struct-pattern
        ctx
        field-state
        env
        type-env
        field-value
        resolved
        (lower-struct-type-name-or-empty
          (tc-type-strip-region (tc-resolve-type ctx resolved)))
        nested-args)
        [(OkLowerEnv struct-state struct-env struct-type-env)
          (lower-bind-variant-payloads
            ctx
            struct-state
            struct-env
            struct-type-env
            base
            rest-patterns
            rest-types
            mode
            enum-name
            variant-name
            next-index
            next-cursor
            fail-label
            scrut-reg-group?)]
        [(ErrLowerEnv message) (ErrLowerEnv message)])]))

;; Bind a matched variant's payload fields. Irrefutable subpatterns (wildcard,
;; binding) just load/bind; a refutable literal subpattern (#651) loads the
;; field, compares it to the literal, and on mismatch branches to `fail-label`
;; (the enclosing arm's next-arm test) so matching continues. Nested variant
;; subpatterns recurse on the field's tag. `fail-label` is unused when every subpattern
;; is irrefutable.
(define (lower-bind-variant-payloads
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [patterns : AstPatternList]
  [types : AstTypeList]
  [mode : CompilerLowerMode]
  [enum-name : String]
  [variant-name : String]
  [index : i64]
  [cursor : i64]
  [fail-label : String]
  ;; #2386: whether the scrutinee enum is a 2-word register-group value, computed
  ;; ONCE by the caller and threaded here. Recomputing it per payload field (a full
  ;; transient layout rebuild) at every binding site across the whole compiler was
  ;; heavy enough to overflow the per-function scratch arena into a second chunk
  ;; and trip its rewind, corrupting later lowering.
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match patterns
    [(AstPatternList.Nil)
      (match types
        [(AstTypeList.Nil) (OkLowerEnv state env type-env)]
        [_
          (ErrLowerEnv
            (box
              (lower-diagnostic "lower: enum payload pattern arity mismatch")))])]
    [(AstPatternList.Cons pattern rest-patterns)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest-patterns : AstPatternList (box-get rest-patterns)]
        (match types
          [(AstTypeList.Cons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              [resolved : AstType (tc-resolve-type ctx ty)]
              [default-offset : i64
                (lower-align-up cursor (lower-type-align ctx resolved))]
              [offset : i64
                (lower-variant-payload-offset
                  ctx
                  mode
                  enum-name
                  variant-name
                  index
                  cursor
                  resolved)]
              [next-cursor : i64
                (+ default-offset (lower-type-size ctx resolved))]
              [next-index : i64 (+ index 1)]
              (if (< offset 0)
                (ErrLowerEnv
                  (box
                    (lower-diagnostic
                      (string.append
                        "lower: inline enum layout missing payload for "
                        variant-name))))
                (match pattern
                  [(AstPattern.Wildcard)
                    (lower-bind-variant-payloads
                      ctx
                      state
                      env
                      type-env
                      base
                      rest-patterns
                      rest-types
                      mode
                      enum-name
                      variant-name
                      next-index
                      next-cursor
                      fail-label
                      scrut-reg-group?)]
                  [(AstPattern.Binding name)
                    (match (if scrut-reg-group?
                      (lower-read-register-group-payload
                        ctx
                        state
                        base
                        (AstType.Enum (intern enum-name))
                        offset
                        resolved)
                      (lower-load-inline-value-at-offset
                        ctx
                        state
                        base
                        offset
                        resolved
                        mode))
                      [(LowerExpr load-state value _)
                        (match value
                          [(CompilerIrValue.Var field-var)
                            (lower-bind-variant-payloads
                              ctx
                              load-state
                              (sym_i64_env.sym-i64-bind-id env name field-var)
                              (tc-bind-id type-env name resolved)
                              base
                              rest-patterns
                              rest-types
                              mode
                              enum-name
                              variant-name
                              next-index
                              next-cursor
                              fail-label
                              scrut-reg-group?)]
                          [_
                            (ErrLowerEnv
                              (box
                                (lower-diagnostic
                                  "lower: internal enum payload load failed")))])])]
                  [(AstPattern.Literal lit)
                    (if (lower-literal-payload-supported? lit)
                      (match (if scrut-reg-group?
                        (lower-read-register-group-payload
                          ctx
                          state
                          base
                          (AstType.Enum (intern enum-name))
                          offset
                          resolved)
                        (lower-load-at-offset state base offset resolved))
                        [(LowerExpr load-state field-value _)
                          (match (lower-literal-payload-eq
                            ctx
                            load-state
                            field-value
                            lit
                            resolved)
                            [(OkLowerExpr lowered-eq)
                              (match lowered-eq
                                [(LowerExpr eq-state eq-value _)
                                  (match (lower-state-fresh-label
                                    eq-state
                                    "payload_ok")
                                    [(LowerLabel ok-state ok-label)
                                      (lower-bind-variant-payloads
                                        ctx
                                        (lower-state-finish-block
                                          (lower-state-emit
                                            ok-state
                                            (CompilerIrInstr.Branch
                                              eq-value
                                              ok-label
                                              fail-label))
                                          ok-label)
                                        env
                                        type-env
                                        base
                                        rest-patterns
                                        rest-types
                                        mode
                                        enum-name
                                        variant-name
                                        next-index
                                        next-cursor
                                        fail-label
                                        scrut-reg-group?)])])]
                            [(ErrLowerExpr message) (ErrLowerEnv message)])])
                      (ErrLowerEnv
                        (box
                          (lower-diagnostic
                            "lower: unsupported enum payload literal pattern type"))))]
                  [(AstPattern.Variant nested-name nested-args-box)
                    ;; Refutable nested variant payloads (#651) test the loaded
                    ;; enum tag and branch to `fail-label` on mismatch. An
                    ;; explicit `(box ...)` payload pattern is irrefutable here;
                    ;; it loads the boxed value and binds the inner pattern.
                    (let
                      [nested-name-str : String (intern-str nested-name)]
                      [nested-args : AstPatternList (box-get nested-args-box)]
                      (if (lower-box-pattern-name? nested-name)
                        (lower-bind-box-variant-payload
                          ctx
                          state
                          env
                          type-env
                          base
                          nested-args
                          resolved
                          mode
                          enum-name
                          variant-name
                          rest-patterns
                          rest-types
                          offset
                          next-index
                          next-cursor
                          fail-label
                          scrut-reg-group?)
                        (if (lower-struct-pattern-for-type?
                          ctx
                          resolved
                          nested-name)
                          (lower-bind-struct-variant-payload
                            ctx
                            state
                            env
                            type-env
                            base
                            nested-args
                            resolved
                            mode
                            enum-name
                            variant-name
                            rest-patterns
                            rest-types
                            offset
                            next-index
                            next-cursor
                            fail-label
                            scrut-reg-group?)
                          (match ctx
                            [(TcContext _ symbols registries _ _)
                              (let
                                [handle : i64
                                  (compiler-registries-lookup-variant-id-or
                                    registries
                                    nested-name
                                    (compiler-symbols-missing-handle))]
                                (if (not
                                  (compiler-symbols-handle-found? handle))
                                  (ErrLowerEnv
                                    (box
                                      (lower-diagnostic
                                        (string.append
                                          "lower: unknown nested variant "
                                          nested-name-str))))
                                  (match (compiler-registries-variant-fields-indexed
                                    symbols
                                    handle)
                                    [(ResultAstTypeList.Err message)
                                      (ErrLowerEnv
                                        (box (lower-diagnostic message)))]
                                    [(ResultAstTypeList.Ok nested-fields)
                                      (match (lower-load-inline-value-at-offset
                                        ctx
                                        state
                                        base
                                        offset
                                        resolved
                                        mode)
                                        [(LowerExpr field-state field-value _)
                                          ;; #2386: for a register-resident enum field
                                          ;; the loaded value IS the tag word; for a
                                          ;; memory enum it is a pointer to the field,
                                          ;; so the tag is loaded from offset 0.
                                          ;; Dereferencing a register-resident tag word
                                          ;; would fault (it is a small integer, not an
                                          ;; address).
                                          (match (if (lower-type-register-resident?
                                            ctx
                                            resolved)
                                            (LowerExpr
                                              field-state
                                              field-value
                                              (AstType.I64))
                                            (lower-load-at-offset
                                              field-state
                                              field-value
                                              0
                                              (AstType.I64)))
                                            [(LowerExpr tag-state tag-value _)
                                              (match (lower-state-alloc-var
                                                tag-state)
                                                [(LowerAlloc eq-alloc eq-var)
                                                  (match (lower-state-fresh-label
                                                    (lower-state-emit
                                                      eq-alloc
                                                      (CompilerIrInstr.BinOp
                                                        eq-var
                                                        CompilerIrBinOp.Eq
                                                        tag-value
                                                        (CompilerIrValue.I64
                                                          (compiler-registry-handle-child-index
                                                            handle))
                                                        (AstType.I64)))
                                                    "payload_ok")
                                                    [(LowerLabel
                                                        ok-state
                                                        ok-label)
                                                      (match (lower-bind-variant-payloads
                                                        ctx
                                                        (lower-state-finish-block
                                                          (lower-state-emit
                                                            ok-state
                                                            (CompilerIrInstr.Branch
                                                              (CompilerIrValue.Var
                                                                eq-var)
                                                              ok-label
                                                              fail-label))
                                                          ok-label)
                                                        env
                                                        type-env
                                                        field-value
                                                        nested-args
                                                        nested-fields
                                                        mode
                                                        (lower-enum-type-name-or-empty
                                                          resolved)
                                                        nested-name-str
                                                        0
                                                        8
                                                        fail-label
                                                        ;; nested enum: rare path, so
                                                        ;; computing its group-ness once
                                                        ;; here is cheap.
                                                        (lower-type-register-group?
                                                          ctx
                                                          resolved))
                                                        [(OkLowerEnv
                                                            nested-state
                                                            nested-env
                                                            nested-type-env)
                                                          (lower-bind-variant-payloads
                                                            ctx
                                                            nested-state
                                                            nested-env
                                                            nested-type-env
                                                            base
                                                            rest-patterns
                                                            rest-types
                                                            mode
                                                            enum-name
                                                            variant-name
                                                            next-index
                                                            next-cursor
                                                            fail-label
                                                            scrut-reg-group?)]
                                                        [(ErrLowerEnv message)
                                                          (ErrLowerEnv message)])])])])])])))]))))]
                  [_
                    (ErrLowerEnv
                      (box
                        (lower-diagnostic
                          "lower: unsupported enum payload pattern")))])))]
          [(AstTypeList.Nil)
            (ErrLowerEnv
              (box
                (lower-diagnostic "lower: enum payload pattern arity mismatch")))]))]))

(define (lower-borrowed-payload-ref-expr
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [field-ty : AstType]
  [ref-ty : AstType]) : LowerExpr
  (let
    [referent-ty : AstType (tc-borrow-referent-type field-ty)]
    (if (or
      (lower-str-ref-type? ctx ref-ty)
      (lower-borrow-place-value-reference? ctx referent-ty))
      (let
        [loaded : LowerExpr (lower-load-at-offset state base offset field-ty)]
        (match loaded
          [(LowerExpr loaded-state value _)
            (LowerExpr loaded-state value ref-ty)]))
      (match (lower-gep-byte state base offset)
        [(LowerExpr ptr-state ptr _) (LowerExpr ptr-state ptr ref-ty)]))))

(define (lower-bind-borrowed-variant-payloads
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [borrow-lifetime : String]
  [base : CompilerIrValue]
  [patterns : AstPatternList]
  [types : AstTypeList]
  [mode : CompilerLowerMode]
  [enum-name : String]
  [variant-name : String]
  [index : i64]
  [cursor : i64]
  [fail-label : String]) : ResultLowerEnv
  (match patterns
    [(AstPatternList.Nil)
      (match types
        [(AstTypeList.Nil) (OkLowerEnv state env type-env)]
        [_
          (ErrLowerEnv
            (box
              (lower-diagnostic "lower: enum payload pattern arity mismatch")))])]
    [(AstPatternList.Cons pattern rest-patterns)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest-patterns : AstPatternList (box-get rest-patterns)]
        (match types
          [(AstTypeList.Cons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              [resolved : AstType (tc-resolve-type ctx ty)]
              [default-offset : i64
                (lower-align-up cursor (lower-type-align ctx resolved))]
              [offset : i64
                (lower-variant-payload-offset
                  ctx
                  mode
                  enum-name
                  variant-name
                  index
                  cursor
                  resolved)]
              [next-cursor : i64
                (+ default-offset (lower-type-size ctx resolved))]
              [next-index : i64 (+ index 1)]
              (if (< offset 0)
                (ErrLowerEnv
                  (box
                    (lower-diagnostic
                      (string.append
                        "lower: inline enum layout missing payload for "
                        variant-name))))
                (match pattern
                  [(AstPattern.Wildcard)
                    (lower-bind-borrowed-variant-payloads
                      ctx
                      state
                      env
                      type-env
                      borrow-lifetime
                      base
                      rest-patterns
                      rest-types
                      mode
                      enum-name
                      variant-name
                      next-index
                      next-cursor
                      fail-label)]
                  [(AstPattern.Binding name)
                    (let
                      [ref-ty : AstType
                        (tc-borrowed-field-ref-type borrow-lifetime resolved)]
                      [ref-expr : LowerExpr
                        (lower-borrowed-payload-ref-expr
                          ctx
                          state
                          base
                          offset
                          resolved
                          ref-ty)]
                      (match ref-expr
                        [(LowerExpr ref-state ref-value _)
                          (match ref-value
                            [(CompilerIrValue.Var field-var)
                              (lower-bind-borrowed-variant-payloads
                                ctx
                                ref-state
                                (sym_i64_env.sym-i64-bind-id env name field-var)
                                (tc-bind-id type-env name ref-ty)
                                borrow-lifetime
                                base
                                rest-patterns
                                rest-types
                                mode
                                enum-name
                                variant-name
                                next-index
                                next-cursor
                                fail-label)]
                            [_
                              (ErrLowerEnv
                                (box
                                  (lower-diagnostic
                                    "lower: internal borrowed enum payload reference failed")))])]))]
                  [(AstPattern.Literal lit)
                    (if (lower-literal-payload-supported? lit)
                      (match (lower-load-at-offset state base offset resolved)
                        [(LowerExpr load-state field-value _)
                          (match (lower-literal-payload-eq
                            ctx
                            load-state
                            field-value
                            lit
                            resolved)
                            [(OkLowerExpr lowered-eq)
                              (match lowered-eq
                                [(LowerExpr eq-state eq-value _)
                                  (match (lower-state-fresh-label
                                    eq-state
                                    "payload_ok")
                                    [(LowerLabel ok-state ok-label)
                                      (lower-bind-borrowed-variant-payloads
                                        ctx
                                        (lower-state-finish-block
                                          (lower-state-emit
                                            ok-state
                                            (CompilerIrInstr.Branch
                                              eq-value
                                              ok-label
                                              fail-label))
                                          ok-label)
                                        env
                                        type-env
                                        borrow-lifetime
                                        base
                                        rest-patterns
                                        rest-types
                                        mode
                                        enum-name
                                        variant-name
                                        next-index
                                        next-cursor
                                        fail-label)])])]
                            [(ErrLowerExpr message) (ErrLowerEnv message)])])
                      (ErrLowerEnv
                        (box
                          (lower-diagnostic
                            "lower: unsupported enum payload literal pattern type"))))]
                  [(AstPattern.Variant nested-name nested-args-box)
                    (let
                      [nested-args : AstPatternList (box-get nested-args-box)]
                      [nested-name-str : String (intern-str nested-name)]
                      (match ctx
                        [(TcContext _ symbols registries _ _)
                          (let
                            [handle : i64
                              (compiler-registries-lookup-variant-id-or
                                registries
                                nested-name
                                (compiler-symbols-missing-handle))]
                            (if (not (compiler-symbols-handle-found? handle))
                              (ErrLowerEnv
                                (box
                                  (lower-diagnostic
                                    (string.append
                                      "lower: unknown nested variant "
                                      nested-name-str))))
                              (match (compiler-registries-variant-fields-indexed
                                symbols
                                handle)
                                [(ResultAstTypeList.Err message)
                                  (ErrLowerEnv (box (lower-diagnostic message)))]
                                [(ResultAstTypeList.Ok nested-fields)
                                  (match (lower-load-at-offset
                                    state
                                    base
                                    offset
                                    resolved)
                                    [(LowerExpr field-state field-value _)
                                      (match (lower-load-at-offset
                                        field-state
                                        field-value
                                        0
                                        (AstType.I64))
                                        [(LowerExpr tag-state tag-value _)
                                          (match (lower-state-alloc-var
                                            tag-state)
                                            [(LowerAlloc eq-alloc eq-var)
                                              (match (lower-state-fresh-label
                                                (lower-state-emit
                                                  eq-alloc
                                                  (CompilerIrInstr.BinOp
                                                    eq-var
                                                    CompilerIrBinOp.Eq
                                                    tag-value
                                                    (CompilerIrValue.I64
                                                      (compiler-registry-handle-child-index
                                                        handle))
                                                    (AstType.I64)))
                                                "payload_ok")
                                                [(LowerLabel ok-state ok-label)
                                                  (match (lower-bind-borrowed-variant-payloads
                                                    ctx
                                                    (lower-state-finish-block
                                                      (lower-state-emit
                                                        ok-state
                                                        (CompilerIrInstr.Branch
                                                          (CompilerIrValue.Var
                                                            eq-var)
                                                          ok-label
                                                          fail-label))
                                                      ok-label)
                                                    env
                                                    type-env
                                                    borrow-lifetime
                                                    field-value
                                                    nested-args
                                                    nested-fields
                                                    mode
                                                    (lower-enum-type-name-or-empty
                                                      resolved)
                                                    nested-name-str
                                                    0
                                                    8
                                                    fail-label)
                                                    [(OkLowerEnv
                                                        nested-state
                                                        nested-env
                                                        nested-type-env)
                                                      (lower-bind-borrowed-variant-payloads
                                                        ctx
                                                        nested-state
                                                        nested-env
                                                        nested-type-env
                                                        borrow-lifetime
                                                        base
                                                        rest-patterns
                                                        rest-types
                                                        mode
                                                        enum-name
                                                        variant-name
                                                        next-index
                                                        next-cursor
                                                        fail-label)]
                                                    [(ErrLowerEnv message)
                                                      (ErrLowerEnv message)])])])])])])))]))]
                  [_
                    (ErrLowerEnv
                      (box
                        (lower-diagnostic
                          "lower: unsupported enum payload pattern")))])))]
          [(AstTypeList.Nil)
            (ErrLowerEnv
              (box
                (lower-diagnostic "lower: enum payload pattern arity mismatch")))]))]))

(define (lower-bind-match-variant-payloads
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [borrow-lifetime : TcMaybeString]
  [base : CompilerIrValue]
  [patterns : AstPatternList]
  [types : AstTypeList]
  [mode : CompilerLowerMode]
  [enum-name : String]
  [variant-name : String]
  [index : i64]
  [cursor : i64]
  [fail-label : String]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match borrow-lifetime
    [(TcMaybeString.No)
      (lower-bind-variant-payloads
        ctx
        state
        env
        type-env
        base
        patterns
        types
        mode
        enum-name
        variant-name
        index
        cursor
        fail-label
        scrut-reg-group?)]
    [(TcMaybeString.Some lifetime)
      ;; A borrowed scrutinee is always memory-backed (matched behind a pointer),
      ;; never a 2-word register-group value, so the register-group path does not
      ;; apply here.
      (lower-bind-borrowed-variant-payloads
        ctx
        state
        env
        type-env
        lifetime
        base
        patterns
        types
        mode
        enum-name
        variant-name
        index
        cursor
        fail-label)]))

;; A payload subpattern is refutable when it can fail to match at run time.
;; Literals and nested enum variants are refutable; `(box ...)` follows its
;; inner pattern, while binding, var, wildcard, and tuple patterns always match.
(define (lower-pattern-refutable? [pattern : AstPattern]) : bool
  (match pattern
    [(AstPattern.Literal _) true]
    [(AstPattern.Variant name args-box)
      (if (lower-box-pattern-name? name)
        (lower-pattern-list-refutable? (box-get args-box))
        true)]
    [_ false]))

(define (lower-pattern-list-refutable? [patterns : AstPatternList]) : bool
  (match patterns
    [(AstPatternList.Nil) false]
    [(AstPatternList.Cons pattern rest)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest : AstPatternList (box-get rest)]
        (if (lower-pattern-refutable? pattern)
          true
          (lower-pattern-list-refutable? rest)))]))

(define (lower-pattern-refutable-for-type?
  [ctx : TcContext]
  [pattern : AstPattern]
  [ty : AstType]) : bool
  (match pattern
    [(AstPattern.Wildcard) false]
    [(AstPattern.Var _ _) false]
    [(AstPattern.Binding _) false]
    [(AstPattern.Tuple _) false]
    [(AstPattern.Literal _) true]
    [(AstPattern.Variant name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (if (lower-box-pattern-name? name)
          (lower-pattern-list-refutable? args)
          (match (tc-type-strip-region (tc-resolve-type ctx ty))
            [(AstType.Struct struct-name)
              (not
                (tc-struct-pattern-irrefutable?
                  ctx
                  (intern-str struct-name)
                  ty
                  (intern-str name)
                  args))]
            [(AstType.StructArgs struct-name _)
              (not
                (tc-struct-pattern-irrefutable?
                  ctx
                  (intern-str struct-name)
                  ty
                  (intern-str name)
                  args))]
            [_ true])))]))

(define (lower-pattern-list-refutable-for-types?
  [ctx : TcContext]
  [patterns : AstPatternList]
  [types : AstTypeList]) : bool
  (match patterns
    [(AstPatternList.Nil)
      (match types
        [(AstTypeList.Nil) false]
        [_ true])]
    [(AstPatternList.Cons pattern rest)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest : AstPatternList (box-get rest)]
        (match types
          [(AstTypeList.Cons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (if (lower-pattern-refutable-for-type? ctx pattern ty)
                true
                (lower-pattern-list-refutable-for-types? ctx rest rest-types)))]
          [(AstTypeList.Nil) true]))]))

(define (lower-field-info-from-list
  [ctx : TcContext]
  [fields : AstFieldDefList]
  [field-name : String]
  [cursor : i64]) : ResultLowerFieldInfo
  (match fields
    [(AstFieldDefList.Nil)
      (ErrLowerFieldInfo
        (box
          (lower-diagnostic
            (string.append "lower: unknown struct field " field-name))))]
    [(AstFieldDefList.Cons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef.Def name ty _)
            (let
              [resolved : AstType (tc-resolve-type ctx ty)]
              [offset : i64
                (lower-align-up cursor (lower-type-align ctx resolved))]
              (if (string.eq (intern-str name) field-name)
                (OkLowerFieldInfo (LowerFieldInfo offset resolved))
                (lower-field-info-from-list
                  ctx
                  rest
                  field-name
                  (+ offset (lower-type-size ctx resolved)))))]))]))

(define (lower-field-info-from-repr-c-list
  [fields : TcReprCFieldLayoutList]
  [field-name : String]) : ResultLowerFieldInfo
  (match fields
    [(TcReprCFieldLayoutList.Nil)
      (ErrLowerFieldInfo
        (box
          (lower-diagnostic
            (string.append "lower: unknown struct field " field-name))))]
    [(TcReprCFieldLayoutList.Cons field rest)
      (match field
        [(TcReprCFieldLayout.Field name ty offset)
          (if (string.eq name field-name)
            (OkLowerFieldInfo (LowerFieldInfo offset ty))
            (lower-field-info-from-repr-c-list (box-get rest) field-name))])]))

(define (lower-struct-field-info
  [ctx : TcContext]
  [struct-name : String]
  [field-name : String]) : ResultLowerFieldInfo
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module ctx struct-name)]
    (if (lower-struct-repr-c? field-ctx struct-name)
      (match (tc-repr-c-struct-layout field-ctx struct-name)
        [(ResultTcReprCLayout.Ok layout)
          (lower-field-info-from-repr-c-list
            (tc-repr-c-layout-fields layout)
            field-name)]
        [(ResultTcReprCLayout.Err message)
          (ErrLowerFieldInfo (box (lower-diagnostic message)))])
      (match (lower-struct-fields field-ctx struct-name)
        [(ResultAstFieldDefList.Ok fields)
          (lower-field-info-from-list field-ctx fields field-name 0)]
        [(ResultAstFieldDefList.Err message)
          (ErrLowerFieldInfo (box (lower-diagnostic message)))]))))

(define (lower-struct-field-info-for-mode
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [struct-name : String]
  [field-name : String]) : ResultLowerFieldInfo
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module ctx struct-name)]
    (if (lower-mode-inline-aggregates? mode)
      (match (lower-struct-field-info field-ctx struct-name field-name)
        [(OkLowerFieldInfo info)
          (match info
            [(LowerFieldInfo _ field-ty)
              (match (tc-inline-aggregate-layout-for field-ctx struct-name)
                [(ResultTcInlineAggregateLayout.Ok layout)
                  (let
                    [offset : i64
                      (tc-inline-aggregate-layout-field-offset
                        layout
                        field-name)]
                    (if (< offset 0)
                      (ErrLowerFieldInfo
                        (box
                          (lower-diagnostic
                            (string.append
                              "lower: inline struct layout missing field "
                              field-name))))
                      (OkLowerFieldInfo (LowerFieldInfo offset field-ty))))]
                [(ResultTcInlineAggregateLayout.Err message)
                  (ErrLowerFieldInfo (box (lower-diagnostic message)))])])]
        [(ErrLowerFieldInfo message) (ErrLowerFieldInfo message)])
      (lower-struct-field-info field-ctx struct-name field-name))))

(define (lower-var
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : String]
  [ty : AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-or env name (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? id)
      (OkLowerExpr (LowerExpr state (CompilerIrValue.Var id) ty))
      (OkLowerExpr
        (LowerExpr
          state
          (CompilerIrValue.Global (lower-resolve-name state name))
          ty)))))

(define (lower-var-id
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? id)
      (OkLowerExpr (LowerExpr state (CompilerIrValue.Var id) ty))
      (OkLowerExpr
        (LowerExpr
          state
          (CompilerIrValue.Global
            (lower-resolve-name state (intern-str name-id)))
          ty)))))

(define (lower-function-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func _ _) true]
    [_ false]))

(define (lower-extern-function-decl? [ctx : TcContext] [name : String]) : bool
  (let
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [handle : i64 (lower-symbols-lookup-value-hygiene symbols name)]
    (if (compiler-symbols-handle-found? handle)
      (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern))
        (match (compiler-symbols-decl-at-index
          symbols
          (compiler-symbol-handle-index handle))
          [(ResultAstDecl.Ok decl)
            (match decl
              [(AstDecl.Extern _ kind _ _)
                (match kind
                  [(AstExternKind.Function) true]
                  [(AstExternKind.Value) false])]
              [_ false])]
          [(ResultAstDecl.Err _) false])
        false)
      false)))

(define (lower-extern-value-decl? [ctx : TcContext] [name : String]) : bool
  (let
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [handle : i64 (lower-symbols-lookup-value-hygiene symbols name)]
    (if (compiler-symbols-handle-found? handle)
      (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern))
        (match (compiler-symbols-decl-at-index
          symbols
          (compiler-symbol-handle-index handle))
          [(ResultAstDecl.Ok decl)
            (match decl
              [(AstDecl.Extern _ kind _ _)
                (match kind
                  [(AstExternKind.Function) false]
                  [(AstExternKind.Value) true])]
              [_ false])]
          [(ResultAstDecl.Err _) false])
        false)
      false)))

(define (lower-atomic-public-symbol? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_store")
    (string.eq symbol "tl_atomic_i64_add")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (lower-atomic-public-name? [name : String]) : bool
  (or
    (string.eq name "atomic-i64-load")
    (string.eq name "atomic-i64-store!")
    (string.eq name "atomic-i64-add!")
    (string.eq name "atomic-i64-fetch-add!")
    (string.eq name "atomic-i32-load")
    (string.eq name "atomic-i32-store!")
    (string.eq name "atomic-i32-add!")
    (string.eq name "atomic-i32-fetch-add!")))

(define (lower-atomic-name-candidate? [name : String]) : bool
  (or
    (lower-atomic-public-name? name)
    (lower-atomic-public-symbol? name)
    (and
      (tc-name-qualified? name)
      (lower-atomic-public-name? (tc-qualified-name-base name)))))

(define (lower-atomic-symbol-for-name [name : String]) : String
  (cond
    [(string.eq name "atomic-i64-load") "tl_atomic_i64_load"]
    [(string.eq name "atomic-i64-store!") "tl_atomic_i64_store"]
    [(string.eq name "atomic-i64-add!") "tl_atomic_i64_add"]
    [(string.eq name "atomic-i64-fetch-add!") "tl_atomic_i64_fetch_add"]
    [(string.eq name "atomic-i32-load") "tl_atomic_i32_load"]
    [(string.eq name "atomic-i32-store!") "tl_atomic_i32_store"]
    [(string.eq name "atomic-i32-add!") "tl_atomic_i32_add"]
    [(string.eq name "atomic-i32-fetch-add!") "tl_atomic_i32_fetch_add"]
    [else ""]))

(define (lower-atomic-import-path? [path : String]) : bool
  (or (string.eq path "stdlib/atomic.tl") (string.eq path "atomic.tl")))

(define (lower-program-imports-atomic? [decls : AstDeclList]) : bool
  (match decls
    [(AstDeclList.Nil) false]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.Import (AstImportSpec.Spec _ path _ _ _))
            (or
              (lower-atomic-import-path? path)
              (lower-program-imports-atomic? rest))]
          [_ (lower-program-imports-atomic? rest)]))]))

(define (lower-context-imports-atomic? [ctx : TcContext]) : bool
  (match ctx
    [(TcContext program _ _ _ _)
      (match program
        [(AstProgram.Program decls-box)
          (lower-program-imports-atomic? (box-get decls-box))])]))

(define (lower-atomic-imported-symbol-for-name
  [ctx : TcContext]
  [name : String]) : String
  (if (and (lower-atomic-public-name? name) (lower-context-imports-atomic? ctx))
    (lower-atomic-symbol-for-name name)
    ""))

(define (lower-atomic-extern-symbol-from-handle
  [symbols : CompilerSymbols]
  [handle : i64]) : String
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern))
    (match (compiler-symbols-decl-at-index
      symbols
      (compiler-symbol-handle-index handle))
      [(ResultAstDecl.Ok decl)
        (match decl
          [(AstDecl.Extern _ kind metadata _)
            (match kind
              [(AstExternKind.Function)
                (let
                  [symbol : String (ast-extern-metadata-symbol metadata)]
                  (if (lower-atomic-public-symbol? symbol)
                    symbol
                    ""))]
              [(AstExternKind.Value) ""])]
          [_ ""])]
      [(ResultAstDecl.Err _) ""])
    ""))

(define (lower-atomic-extern-symbol-lookup
  [symbols : CompilerSymbols]
  [lookup-name : String]) : String
  (let
    [handle : i64 (lower-symbols-lookup-value-hygiene symbols lookup-name)]
    (if (compiler-symbols-handle-found? handle)
      (lower-atomic-extern-symbol-from-handle symbols handle)
      "")))

(define (lower-atomic-extern-symbol-for-name [ctx : TcContext] [name : String]) : String
  (if (not (lower-atomic-name-candidate? name))
    ""
    (let
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [direct : String (lower-atomic-extern-symbol-lookup symbols name)]
      [source-name : String (tc-hygiene-global-symbol-name name)]
      [module : String (tc-context-module ctx)]
      [lookup-name : String
        (if (and
          (> (string.string-length module) 0)
          (not (tc-name-qualified? source-name)))
          (compiler-symbol-module-key module source-name)
          source-name)]
      [found : String (lower-atomic-extern-symbol-lookup symbols lookup-name)]
      (if (> (string.string-length direct) 0)
        direct
        (if (or
          (> (string.string-length found) 0)
          (string.eq lookup-name source-name))
          (if (> (string.string-length found) 0)
            found
            (lower-atomic-imported-symbol-for-name ctx source-name))
          (lower-atomic-extern-symbol-lookup symbols source-name))))))

(define (lower-atomic-extern-symbol-for-func
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [func : AstExpr]) : String
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [raw-text : String (intern-str raw-name)]
        (if (tc-hygiene-global-name? raw-text)
          (lower-atomic-extern-symbol-for-name
            ctx
            (tc-hygiene-global-call-name raw-text))
          (if (tc-source-slash-qualified? raw-text)
            (lower-atomic-extern-symbol-for-name ctx raw-text)
            (match (lower-source-name-lookup-key ctx type-env raw-text)
              [(ResultTcString.Ok lookup-name)
                (lower-atomic-extern-symbol-for-name ctx lookup-name)]
              [(ResultTcString.Err _) ""]))))]
    [_ ""]))

;; The symbol table is keyed by the module key (module/name) and the bare source
;; name alias, never by the `::` logical/mangled name returned by
;; lower-resolve-name. Look up the bare source name so a function used as a value
;; lowers to CompilerIrValue.Function (its closure-descriptor address) instead of falling
;; through to CompilerIrValue.Global (which would load the function's code bytes and
;; miscompile an indirect call through it).
(define (lower-symbol-function-value?
  [ctx : TcContext]
  [_state : LowerState]
  [name : String]) : bool
  (let
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [handle : i64 (lower-symbols-lookup-value-hygiene symbols name)]
    (if (compiler-symbols-handle-found? handle)
      (or
        (=
          (compiler-symbol-handle-kind handle)
          (compiler-symbol-kind-function-define))
        (lower-extern-function-decl? ctx name)
        (=
          (compiler-symbol-handle-kind handle)
          (compiler-symbol-kind-defdispatch)))
      false)))

(define (lower-function-value-or-var
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : String]
  [ty : AstType]) : ResultLowerExpr
  (cond
    [(sym_i64_env.sym-i64-contains env name) (lower-var state env name ty)]
    [(lower-extern-value-decl? ctx name)
      (match (lower-var state env name ty)
        [(OkLowerExpr lowered)
          (match lowered
            [(LowerExpr value-state value _)
              (match (lower-state-alloc-var value-state)
                [(LowerAlloc allocated var-id)
                  (OkLowerExpr
                    (LowerExpr
                      (lower-state-emit
                        allocated
                        (CompilerIrInstr.Mov var-id value ty))
                      (CompilerIrValue.Var var-id)
                      ty))])])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(and
        (lower-function-type? ty)
        (lower-symbol-function-value? ctx state name))
      (OkLowerExpr
        (LowerExpr
          state
          (CompilerIrValue.Function (lower-resolve-name state name))
          ty))]
    [else (lower-var state env name ty)]))

(define (lower-lambda-captures-env?
  [outer-env : sym_i64_env.SymI64Env]
  [body : AstExpr]
  [bound : TcStringList]) : bool
  (match outer-env
    [(sym_i64_env.SymI64Nil) false]
    [(sym_i64_env.SymI64Bind name-id _ rest)
      (if (tc-expr-uses-free-name? body (intern-str name-id) bound)
        true
        (lower-lambda-captures-env? (box-get rest) body bound))]))

(define (lower-lambda-ret-type
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [lambda-expr : AstExpr]
  [maybe-ret : AstMaybeType]) : ResultTcType
  (match maybe-ret
    [(AstMaybeType.Some ty) (ResultTcType.Ok (tc-resolve-type ctx ty))]
    [(AstMaybeType.No)
      (match (tc-expr ctx type-env lambda-expr)
        [(ResultTcType.Ok ty)
          (match (tc-type-strip-region ty)
            [(AstType.Func _ ret) (ResultTcType.Ok (ty-node-get ret))]
            [_
              (ResultTcType.Err "lower: lambda did not typecheck as a function")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]))

(define (lower-capture-list-contains-name?
  [captures : LowerCaptureList]
  [name : String]) : bool
  (let
    [items : (Array LowerCapture) (struct-get captures items)]
    [count : i64 (struct-get captures count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (array-ref items index)
          [(LowerCapture capture-name _ _ _)
            (if (string.eq capture-name name)
              (set! found true)
              (set! index (+ index 1)))]))
      found)))

(define (lower-capture-list-count [captures : LowerCaptureList]) : i64
  (struct-get captures count))

(define (lower-capture-list-empty) : LowerCaptureList
  (LowerCaptureList (make-array LowerCapture 0) 0))

(define (lower-capture-list-add-front
  [captures : LowerCaptureList]
  [capture : LowerCapture]) : LowerCaptureList
  (let
    [items : (Array LowerCapture) (struct-get captures items)]
    [count : i64 (struct-get captures count)]
    (begin
      (array-push! items capture)
      (LowerCaptureList items (+ count 1)))))

(define (lower-capture-list-storage-entry?
  [captures : LowerCaptureList]
  [index : i64]
  [name : String]
  [var-id : i64]
  [offset : i64]) : bool
  (if (or (< index 0) (>= index (struct-get captures count)))
    false
    (match (array-ref (struct-get captures items) index)
      [(LowerCapture capture-name capture-var-id _ capture-offset)
        (and
          (string.eq capture-name name)
          (= capture-var-id var-id)
          (= capture-offset offset))])))

(define (lower-unsupported-capture-message) : String
  "lower: unsupported lambda capture type (#1553)")

(define (lower-capture-support-message [ctx : TcContext] [ty : AstType]) : String
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Ref _ _) (lower-reference-support-message)]
    [(AstType.MutRef _ _) (lower-reference-support-message)]
    [_ (lower-unsupported-capture-message)]))

(define (lower-supported-capture-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.F64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.F32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Ref _ _) true]
    [(AstType.Func _ _) true]
    [(AstType.Tuple _) true]
    [(AstType.Array _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.String) true]
    [(AstType.DynArray _) true]
    [_ false]))

(define (lower-capture-env-size [cursor : i64]) : i64
  (lower-align-up
    (if (= cursor 0)
      1
      cursor)
    8))

(define (lower-capture-slot-type [ty : AstType]) : AstType
  (match (tc-type-strip-region ty)
    [(AstType.Func _ _) (AstType.U64)]
    [(AstType.Tuple _) (AstType.U64)]
    [(AstType.Array _ _) (AstType.U64)]
    [(AstType.Enum _) (AstType.U64)]
    [(AstType.EnumArgs _ _) (AstType.U64)]
    [(AstType.Struct _) (AstType.U64)]
    [(AstType.StructArgs _ _) (AstType.U64)]
    [(AstType.String) (AstType.U64)]
    [(AstType.DynArray _) (AstType.U64)]
    [_ ty]))

(define (lower-fixed-array-storage-size
  [ctx : TcContext]
  [elem-ty : AstType]
  [count : i64]) : i64
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    [extent : i64 (* count elem-size)]
    (lower-align-up
      (if (= extent 0)
        1
        extent)
      8)))

(define (lower-capture-snapshot-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (match (tc-resolve-type ctx ty)
    [(AstType.String) (lower-capture-snapshot-string-value state value)]
    [(AstType.DynArray elem-ty)
      (lower-capture-snapshot-dynarray-value
        ctx
        state
        value
        (tc-type-without-regions (ty-node-get elem-ty))
        ty)]
    [(AstType.Tuple elem-tys)
      (lower-capture-snapshot-tuple-value
        ctx
        state
        env
        type-env
        value
        (box-get elem-tys)
        ty)]
    [(AstType.Array elem-ty count)
      (lower-capture-snapshot-fixed-array-value
        ctx
        state
        env
        type-env
        value
        (tc-type-without-regions (ty-node-get elem-ty))
        count
        ty)]
    ;; #2386: a register-resident aggregate is word-class POD held in a register;
    ;; its capture snapshot is the value itself (nothing on the heap to copy).
    [(AstType.Struct name)
      (if (lower-type-register-resident? ctx ty)
        (OkLowerExpr (LowerExpr state value ty))
        (lower-capture-snapshot-struct-value
          ctx
          state
          env
          type-env
          value
          (intern-str name)
          ty))]
    [(AstType.StructArgs name _)
      (lower-capture-snapshot-struct-value
        ctx
        state
        env
        type-env
        value
        (intern-str name)
        ty)]
    [(AstType.Enum name)
      (if (lower-type-register-resident? ctx ty)
        (OkLowerExpr (LowerExpr state value ty))
        (lower-capture-snapshot-enum-value
          ctx
          state
          env
          type-env
          value
          (intern-str name)
          ty))]
    [(AstType.EnumArgs name _)
      (lower-capture-snapshot-enum-value
        ctx
        state
        env
        type-env
        value
        (intern-str name)
        ty)]
    [_ (OkLowerExpr (LowerExpr state value ty))]))

(define (lower-capture-snapshot-string-value
  [state : LowerState]
  [value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state value)
    [(LowerStringFields fields-state ptr len)
      (lower-substring-call-runtime
        fields-state
        ptr
        (CompilerIrValue.I64 0)
        len)]))

(define (lower-capture-snapshot-dynarray-copy
  [ctx : TcContext]
  [state : LowerState]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]) : LowerState
  (if (= elem-size 0)
    state
    (lower-array-push-copy-loop ctx state old-buf new-buf len elem-ty)))

(define (lower-capture-snapshot-dynarray-finish
  [ctx : TcContext]
  [state : LowerState]
  [old-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [buf-var : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 result-ty)
    [(LowerExpr arr-state arr-value _)
      (let
        [copied-state : LowerState
          (lower-capture-snapshot-dynarray-copy
            ctx
            arr-state
            old-buf
            (CompilerIrValue.Var buf-var)
            len
            elem-ty
            elem-size)]
        (OkLowerExpr
          (LowerExpr
            (lower-store-at-offset
              (lower-store-at-offset
                copied-state
                arr-value
                0
                (CompilerIrValue.Var buf-var)
                (AstType.U64))
              arr-value
              8
              len
              (AstType.I64))
            arr-value
            result-ty)))]))

(define (lower-capture-snapshot-dynarray-value
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-load-at-offset state value 8 (AstType.I64))
    [(LowerExpr len-state len _)
      (match (lower-load-at-offset len-state value 0 (AstType.U64))
        [(LowerExpr ptr-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            (match (if (= elem-size 0)
              (LowerExpr ptr-state (CompilerIrValue.I64 1) (AstType.I64))
              (lower-emit-binop
                ptr-state
                CompilerIrBinOp.Mul
                len
                (CompilerIrValue.I64 elem-size)
                (AstType.I64)))
              [(LowerExpr byte-state byte-count _)
                (match (lower-state-alloc-var byte-state)
                  [(LowerAlloc buf-alloc buf-var)
                    (lower-capture-snapshot-dynarray-finish
                      ctx
                      (lower-state-emit
                        buf-alloc
                        (CompilerIrInstr.Call
                          buf-var
                          "tl_alloc"
                          (CompilerIrCallArgs.One byte-count)
                          (AstType.U64)))
                      old-buf
                      len
                      elem-ty
                      elem-size
                      buf-var
                      result-ty)])]))])]))

(define (lower-capture-snapshot-type-list
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [types : AstTypeList]
  [cursor : i64]) : ResultLowerState
  (match types
    [(AstTypeList.Nil) (OkLowerState state)]
    [(AstTypeList.Cons ty rest)
      (let
        [ty : AstType (ty-node-get ty)]
        [rest : AstTypeList (box-get rest)]
        [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        [size : i64 (lower-type-size ctx resolved)]
        (if (> size 0)
          (match (lower-load-inline-value-at-offset
            ctx
            state
            src
            offset
            resolved
            (lower-state-mode state))
            [(LowerExpr load-state field-value _)
              (match (lower-capture-snapshot-value
                ctx
                load-state
                env
                type-env
                field-value
                resolved)
                [(OkLowerExpr snap)
                  (match snap
                    [(LowerExpr snap-state snap-value _)
                      (lower-capture-snapshot-type-list
                        ctx
                        (lower-store-inline-value-at-offset
                          ctx
                          snap-state
                          dst
                          offset
                          snap-value
                          resolved
                          size)
                        env
                        type-env
                        src
                        dst
                        rest
                        (+ offset size))])]
                [(ErrLowerExpr message) (ErrLowerState message)])])
          (lower-capture-snapshot-type-list
            ctx
            state
            env
            type-env
            src
            dst
            rest
            (+ offset size))))]))

(define (lower-capture-snapshot-tuple-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-tys : AstTypeList]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage
    state
    (lower-type-list-storage-size ctx elem-tys)
    result-ty)
    [(LowerExpr dst-state dst _)
      (match (lower-capture-snapshot-type-list
        ctx
        dst-state
        env
        type-env
        value
        dst
        elem-tys
        0)
        [(OkLowerState done-state)
          (OkLowerExpr (LowerExpr done-state dst result-ty))]
        [(ErrLowerState message) (ErrLowerExpr message)])]))

(define (lower-capture-snapshot-fixed-array-elems
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [index : i64]
  [count : i64]) : ResultLowerState
  (if (>= index count)
    (OkLowerState state)
    (let
      [offset : i64 (* index elem-size)]
      (if (> elem-size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          elem-ty
          (lower-state-mode state))
          [(LowerExpr load-state elem-value _)
            (match (lower-capture-snapshot-value
              ctx
              load-state
              env
              type-env
              elem-value
              elem-ty)
              [(OkLowerExpr snap)
                (match snap
                  [(LowerExpr snap-state snap-value _)
                    (lower-capture-snapshot-fixed-array-elems
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        snap-state
                        dst
                        offset
                        snap-value
                        elem-ty
                        elem-size)
                      env
                      type-env
                      src
                      dst
                      elem-ty
                      elem-size
                      (+ index 1)
                      count)])]
              [(ErrLowerExpr message) (ErrLowerState message)])])
        (lower-capture-snapshot-fixed-array-elems
          ctx
          state
          env
          type-env
          src
          dst
          elem-ty
          elem-size
          (+ index 1)
          count)))))

(define (lower-capture-snapshot-fixed-array-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [count : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    (match (lower-reserve-heap-storage
      state
      (lower-fixed-array-storage-size ctx elem-ty count)
      result-ty)
      [(LowerExpr dst-state dst _)
        (match (lower-capture-snapshot-fixed-array-elems
          ctx
          dst-state
          env
          type-env
          value
          dst
          elem-ty
          elem-size
          0
          count)
          [(OkLowerState done-state)
            (OkLowerExpr (LowerExpr done-state dst result-ty))]
          [(ErrLowerState message) (ErrLowerExpr message)])])))

(define (lower-capture-snapshot-struct-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [struct-name : String]
  [result-ty : AstType]) : ResultLowerExpr
  (if (lower-struct-repr-c? ctx struct-name)
    (ErrLowerExpr
      (box
        (lower-diagnostic
          "lower: repr-c aggregate lambda captures need repr-c snapshot lowering")))
    (match (lower-struct-fields ctx struct-name)
      [(ResultAstFieldDefList.Ok fields)
        (let
          [field-types : AstTypeList (tc-field-type-list ctx fields)]
          (match (lower-reserve-heap-storage
            state
            (lower-type-list-storage-size ctx field-types)
            result-ty)
            [(LowerExpr dst-state dst _)
              (match (lower-capture-snapshot-type-list
                ctx
                dst-state
                env
                type-env
                value
                dst
                field-types
                0)
                [(OkLowerState done-state)
                  (OkLowerExpr (LowerExpr done-state dst result-ty))]
                [(ErrLowerState message) (ErrLowerExpr message)])]))]
      [(ResultAstFieldDefList.Err message)
        (ErrLowerExpr (box (lower-diagnostic message)))])))

(define (lower-capture-snapshot-enum-variants
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [tag : CompilerIrValue]
  [variants : AstVariantDefList]
  [index : i64]
  [done-label : String]) : ResultLowerState
  (match variants
    [(AstVariantDefList.Nil)
      (OkLowerState
        (lower-state-finish-block
          (lower-state-emit state (CompilerIrInstr.Jump done-label))
          done-label))]
    [(AstVariantDefList.Cons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match (lower-state-fresh-label state "capture_enum_variant")
          [(LowerLabel variant-label-state variant-label)
            (match (lower-state-fresh-label
              variant-label-state
              "capture_enum_next")
              [(LowerLabel next-label-state next-label)
                (match (lower-state-alloc-var next-label-state)
                  [(LowerAlloc cond-state cond-var)
                    (let
                      [branch-state : LowerState
                        (lower-state-finish-block
                          (lower-state-emit
                            (lower-state-emit
                              cond-state
                              (CompilerIrInstr.BinOp
                                cond-var
                                CompilerIrBinOp.Eq
                                tag
                                (CompilerIrValue.I64 index)
                                (AstType.Bool)))
                            (CompilerIrInstr.Branch
                              (CompilerIrValue.Var cond-var)
                              variant-label
                              next-label))
                          variant-label)]
                      (match variant
                        [(AstVariantDef.Def _ fields _)
                          (match (lower-capture-snapshot-type-list
                            ctx
                            branch-state
                            env
                            type-env
                            src
                            dst
                            fields
                            8)
                            [(OkLowerState copied-state)
                              (lower-capture-snapshot-enum-variants
                                ctx
                                (lower-state-finish-block
                                  (lower-state-emit
                                    copied-state
                                    (CompilerIrInstr.Jump done-label))
                                  next-label)
                                env
                                type-env
                                src
                                dst
                                tag
                                rest
                                (+ index 1)
                                done-label)]
                            [(ErrLowerState message) (ErrLowerState message)])]))])])]))]))

(define (lower-capture-snapshot-enum-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [enum-name : String]
  [result-ty : AstType]) : ResultLowerExpr
  (match ctx
    [(TcContext program _ _ _ _)
      (match (tc-program-enum-variants program enum-name)
        [(ResultAstVariantDefList.Ok variants)
          (match (lower-reserve-heap-storage
            state
            (lower-enum-storage-size ctx enum-name)
            result-ty)
            [(LowerExpr dst-state dst _)
              (match (lower-load-at-offset dst-state value 0 (AstType.I64))
                [(LowerExpr tag-state tag _)
                  (match (lower-state-fresh-label tag-state "capture_enum_done")
                    [(LowerLabel done-state done-label)
                      (match (lower-capture-snapshot-enum-variants
                        ctx
                        (lower-store-at-offset
                          done-state
                          dst
                          0
                          tag
                          (AstType.I64))
                        env
                        type-env
                        value
                        dst
                        tag
                        variants
                        0
                        done-label)
                        [(OkLowerState final-state)
                          (OkLowerExpr (LowerExpr final-state dst result-ty))]
                        [(ErrLowerState message) (ErrLowerExpr message)])])])])]
        [(ResultAstVariantDefList.Err message)
          (ErrLowerExpr (box (lower-diagnostic message)))])]))

(define (lower-capture-plan-scan
  [ctx : TcContext]
  [outer-env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [body : AstExpr]
  [bound : TcStringList]
  [cursor : i64]
  [captures : LowerCaptureList]
  [origin : AstExpr]) : ResultLowerCapturePlan
  (match outer-env
    [(sym_i64_env.SymI64Nil)
      (OkLowerCapturePlan
        (LowerCapturePlan captures (lower-capture-env-size cursor)))]
    [(sym_i64_env.SymI64Bind name-id var-id rest)
      (let
        [name : String (intern-str name-id)]
        (if (or
          (lower-capture-list-contains-name? captures name)
          (not (tc-expr-uses-free-name? body name bound)))
          (lower-capture-plan-scan
            ctx
            (box-get rest)
            type-env
            body
            bound
            cursor
            captures
            origin)
          (match (tc-lookup type-env name)
            [(ResultTcType.Err message)
              (ErrLowerCapturePlan
                (box (lower-diagnostic-at-expr origin message)))]
            [(ResultTcType.Ok found-ty)
              (let
                [capture-ty : AstType
                  (tc-type-without-regions (tc-resolve-type ctx found-ty))]
                (if (lower-supported-capture-type? ctx capture-ty)
                  (let
                    [slot-ty : AstType (lower-capture-slot-type capture-ty)]
                    [offset : i64
                      (lower-align-up cursor (lower-type-align ctx slot-ty))]
                    ;; #2386: a register-group capture occupies 16 bytes inline (two
                    ;; words), not an 8-byte handle slot.
                    [slot-size : i64
                      (if (lower-type-register-group? ctx capture-ty)
                        16
                        (lower-type-size ctx slot-ty))]
                    (lower-capture-plan-scan
                      ctx
                      (box-get rest)
                      type-env
                      body
                      bound
                      (+ offset slot-size)
                      (lower-capture-list-add-front
                        captures
                        (LowerCapture name var-id capture-ty offset))
                      origin))
                  (ErrLowerCapturePlan
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        (lower-capture-support-message ctx capture-ty))))))])))]))

(define (lower-capture-plan
  [ctx : TcContext]
  [outer-env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]
  [origin : AstExpr]) : ResultLowerCapturePlan
  (lower-capture-plan-scan
    ctx
    outer-env
    type-env
    body
    (tc-param-bound-names params)
    0
    (lower-capture-list-empty)
    origin))

(define (lower-store-captures-from-index
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [env-value : CompilerIrValue]
  [items : (Array LowerCapture)]
  [index : i64]) : ResultLowerState
  (if (< index 0)
    (OkLowerState state)
    (let
      [capture : LowerCapture (array-ref items index)]
      (match capture
        [(LowerCapture _ var-id capture-ty offset)
          (match (lower-capture-snapshot-value
            ctx
            state
            env
            type-env
            (CompilerIrValue.Var var-id)
            capture-ty)
            [(OkLowerExpr snap)
              (match snap
                [(LowerExpr snap-state snap-value _)
                  (lower-store-captures-from-index
                    ctx
                    (if (lower-type-register-group? ctx capture-ty)
                      ;; #2386: a captured 2-word group stores both words.
                      (match (lower-gep-byte snap-state env-value offset)
                        [(LowerExpr gep-state ptr _)
                          (lower-store-group-at-ptr
                            ctx
                            gep-state
                            ptr
                            snap-value
                            capture-ty)])
                      (lower-store-at-offset
                        snap-state
                        env-value
                        offset
                        snap-value
                        (lower-capture-slot-type capture-ty)))
                    env
                    type-env
                    env-value
                    items
                    (- index 1))])]
            [(ErrLowerExpr message) (ErrLowerState message)])]))))

(define (lower-store-captures
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [env-value : CompilerIrValue]
  [captures : LowerCaptureList]) : ResultLowerState
  (lower-store-captures-from-index
    ctx
    state
    env
    type-env
    env-value
    (struct-get captures items)
    (- (struct-get captures count) 1)))

(define (lower-store-capturing-lambda-descriptor
  [state : LowerState]
  [lambda-name : String]
  [env-value : CompilerIrValue]
  [expr-ty : AstType]) : LowerExpr
  (match (lower-reserve-heap-storage state 16 expr-ty)
    [(LowerExpr desc-state desc-value _)
      (LowerExpr
        (lower-store-at-offset
          (lower-store-at-offset
            desc-state
            desc-value
            0
            (CompilerIrValue.GlobalAddr lambda-name)
            (AstType.U64))
          desc-value
          8
          env-value
          (AstType.U64))
        desc-value
        expr-ty)]))

(define (lower-capturing-lambda-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lambda-name : String]
  [captures : LowerCaptureList]
  [capture-size : i64]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state capture-size (AstType.U64))
    [(LowerExpr env-state env-value _)
      (match (lower-store-captures
        ctx
        env-state
        env
        type-env
        env-value
        captures)
        [(OkLowerState captured-state)
          (match (lower-store-capturing-lambda-descriptor
            captured-state
            lambda-name
            env-value
            expr-ty)
            [(LowerExpr desc-state desc-value desc-ty)
              (OkLowerExpr (LowerExpr desc-state desc-value desc-ty))])]
        [(ErrLowerState message) (ErrLowerExpr message)])]))

(define (lower-load-captures-from-index
  [ctx : TcContext]
  [state : LowerState]
  [env-value : CompilerIrValue]
  [items : (Array LowerCapture)]
  [index : i64]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerEnv
  (if (< index 0)
    (OkLowerEnv state env type-env)
    (let
      [capture : LowerCapture (array-ref items index)]
      (match capture
        [(LowerCapture name _ capture-ty offset)
          (match (if (lower-type-register-group? ctx capture-ty)
            ;; #2386: a captured 2-word group loads both words and repacks.
            (match (lower-gep-byte state env-value offset)
              [(LowerExpr gep-state ptr _)
                (lower-load-group-from-ptr ctx gep-state ptr capture-ty)])
            (lower-load-at-offset
              state
              env-value
              offset
              (lower-capture-slot-type capture-ty)))
            [(LowerExpr loaded-state loaded-value _)
              (match loaded-value
                [(CompilerIrValue.Var loaded-var)
                  (lower-load-captures-from-index
                    ctx
                    loaded-state
                    env-value
                    items
                    (- index 1)
                    (sym_i64_env.sym-i64-bind env name loaded-var)
                    (tc-bind type-env name capture-ty))]
                [_
                  (ErrLowerEnv
                    (box
                      (lower-diagnostic
                        "lower: capture load did not materialize a variable")))])])]))))

(define (lower-load-captures
  [ctx : TcContext]
  [state : LowerState]
  [env-value : CompilerIrValue]
  [captures : LowerCaptureList]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerEnv
  (lower-load-captures-from-index
    ctx
    state
    env-value
    (struct-get captures items)
    (- (struct-get captures count) 1)
    env
    type-env))

(define (lower-captured-param-list [ctx : TcContext] [params : AstParamList]) : CompilerIrParamList
  (compiler-ir-param-cons
    (CompilerIrParam.Param "__tl_env" (AstType.U64) 0)
    (lower-param-list ctx params 1)))

(define (lower-function-with-captures
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : String]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [captures : LowerCaptureList]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (if (or
    (lower-param-list-contains-unsupported-reference? ctx params)
    (not (lower-supported-reference-type? ctx ret)))
    (ErrLowerFunction
      (box (lower-diagnostic (lower-reference-support-message))))
    (let
      [param-count : i64 (+ 1 (lower-param-count params))]
      [ret-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ret))]
      ;; #1867 sret ABI for closures: hidden result-slot pointer at var
      ;; `param-count` (just past env + real params).
      [sret-needed : bool
        (and
          (lower-mode-inline-aggregates? mode)
          (lower-type-inline-struct-or-enum? ctx ret-ty)
          (not (lower-type-register-resident? ctx ret-ty)))]
      [sret-var : i64
        (if sret-needed
          param-count
          (- 0 1))]
      [function-spans : CompilerSourceSpans
        (lower-record-function-span spans logical-name body)]
      [state : LowerState
        (LowerState
          (if sret-needed
            (+ param-count 1)
            param-count)
          0
          0
          "entry"
          (box CompilerIrInstrList.Nil)
          (box CompilerIrBlockList.Nil)
          (box CompilerIrFunctionList.Nil)
          logical-name
          (box function-spans)
          names
          type-cache
          mode
          1
          param-count)]
      (match (lower-load-captures
        ctx
        state
        (CompilerIrValue.Var 0)
        captures
        (sym_i64_env.sym-i64-empty)
        (tc-bind-return-type top-env ret-ty))
        [(OkLowerEnv captured-state captured-env captured-type-env)
          (let
            [env : sym_i64_env.SymI64Env
              (lower-bind-params params 1 captured-env)]
            [type-env : TcTypeEnv (tc-bind-params ctx captured-type-env params)]
            (match (lower-tail-expr
              ctx
              captured-state
              env
              type-env
              body
              ret-ty
              sret-var)
              [(OkLowerState final-state)
                (OkLowerFunction
                  (compiler-ir-function-cons
                    (CompilerIrFunction.Function
                      logical-name
                      (if (>= sret-var 0)
                        (lower-param-list-append-sret
                          (lower-captured-param-list ctx params)
                          sret-var)
                        (lower-captured-param-list ctx params))
                      ret-ty
                      (lower-state-next-var final-state)
                      (lower-state-build-function-blocks final-state))
                    (lower-state-functions final-state))
                  (lower-state-spans final-state))]
              [(ErrLowerState message) (ErrLowerFunction message)]))]
        [(ErrLowerEnv message) (ErrLowerFunction message)]))))

(define (lower-lambda-noncapturing
  [ctx : TcContext]
  [state : LowerState]
  [type-env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-lambda-ret-type ctx type-env origin maybe-ret)
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))]
    [(ResultTcType.Ok ret-ty)
      (match (lower-state-fresh-lambda-name state)
        [(LowerLambdaName named-state lambda-name)
          (match (lower-function
            ctx
            type-env
            (lower-state-type-cache state)
            lambda-name
            params
            ret-ty
            body
            (lower-state-spans named-state)
            (lower-state-names named-state)
            (lower-state-mode named-state))
            [(OkLowerFunction lambda-functions lambda-spans)
              (OkLowerExpr
                (LowerExpr
                  (lower-state-add-functions
                    named-state
                    lambda-functions
                    lambda-spans)
                  (CompilerIrValue.Function lambda-name)
                  expr-ty))]
            [(ErrLowerFunction message) (ErrLowerExpr message)])])]))

(define (lower-lambda-capturing
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-lambda-ret-type ctx type-env origin maybe-ret)
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))]
    [(ResultTcType.Ok ret-ty)
      (match (lower-capture-plan ctx env type-env params body origin)
        [(ErrLowerCapturePlan message) (ErrLowerExpr message)]
        [(OkLowerCapturePlan plan)
          (match plan
            [(LowerCapturePlan captures capture-size)
              (match (lower-state-fresh-lambda-name state)
                [(LowerLambdaName named-state lambda-name)
                  (match (lower-function-with-captures
                    ctx
                    type-env
                    (lower-state-type-cache named-state)
                    lambda-name
                    params
                    ret-ty
                    body
                    captures
                    (lower-state-spans named-state)
                    (lower-state-names named-state)
                    (lower-state-mode named-state))
                    [(OkLowerFunction lambda-functions lambda-spans)
                      (match (lower-capturing-lambda-value
                        ctx
                        (lower-state-add-functions
                          named-state
                          lambda-functions
                          lambda-spans)
                        env
                        type-env
                        lambda-name
                        captures
                        capture-size
                        expr-ty)
                        [(OkLowerExpr lowered)
                          (match lowered
                            [(LowerExpr value-state value value-ty)
                              (OkLowerExpr
                                (LowerExpr value-state value value-ty))])]
                        [(ErrLowerExpr message) (ErrLowerExpr message)])]
                    [(ErrLowerFunction message) (ErrLowerExpr message)])])])])]))

(define (lower-lambda
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (lower-lambda-captures-env? env body (tc-param-bound-names params))
    (lower-lambda-capturing
      ctx
      state
      env
      type-env
      params
      maybe-ret
      body
      origin
      expr-ty)
    (lower-lambda-noncapturing
      ctx
      state
      type-env
      params
      maybe-ret
      body
      origin
      expr-ty)))

(define (lower-return-maybe [value : CompilerIrValue] [ty : AstType]) : CompilerIrMaybeValue
  (match ty
    [(AstType.Unit) CompilerIrMaybeValue.No]
    [_ (CompilerIrMaybeValue.Some value)]))

(define (lower-cleanup-marker-name) : String
  " __tl_active_cleanup")

(define lower-cleanup-marker-id-cache : i64
  -1)

(define (lower-cleanup-marker-id) : i64
  lower-cleanup-marker-id-cache)

(define (lower-region-reset-marker-name) : String
  " __tl_active_region_reset")

(define lower-region-reset-marker-id-cache : i64
  -1)

(define (lower-region-reset-marker-id) : i64
  lower-region-reset-marker-id-cache)

(define (lower-spmd-reduce-acc-name) : String
  "0spmd-reduce-acc")

(define (lower-spmd-reduce-end-name) : String
  "0spmd-reduce-end")

(define (lower-spmd-reduce-val-name) : String
  "0spmd-reduce-val")

(define (lower-spmd-reduce-current-name) : String
  "0spmd-reduce-current")

(define (lower-spmd-scan-acc-name) : String
  "0spmd-scan-acc")

(define (lower-spmd-scan-end-name) : String
  "0spmd-scan-end")

(define (lower-spmd-scan-val-name) : String
  "0spmd-scan-val")

(define lower-spmd-reduce-acc-id-cache : i64
  -1)
(define lower-spmd-reduce-end-id-cache : i64
  -1)
(define lower-spmd-reduce-val-id-cache : i64
  -1)
(define lower-spmd-reduce-current-id-cache : i64
  -1)
(define lower-spmd-scan-acc-id-cache : i64
  -1)
(define lower-spmd-scan-end-id-cache : i64
  -1)
(define lower-spmd-scan-val-id-cache : i64
  -1)

(define (lower-spmd-reduce-acc-id) : i64
  lower-spmd-reduce-acc-id-cache)

(define (lower-spmd-reduce-end-id) : i64
  lower-spmd-reduce-end-id-cache)

(define (lower-spmd-reduce-val-id) : i64
  lower-spmd-reduce-val-id-cache)

(define (lower-spmd-reduce-current-id) : i64
  lower-spmd-reduce-current-id-cache)

(define (lower-spmd-scan-acc-id) : i64
  lower-spmd-scan-acc-id-cache)

(define (lower-spmd-scan-end-id) : i64
  lower-spmd-scan-end-id-cache)

(define (lower-spmd-scan-val-id) : i64
  lower-spmd-scan-val-id-cache)

(define (lower-name-id [name : String]) : i64
  (cond
    [(string.eq name (lower-spmd-reduce-acc-name)) (lower-spmd-reduce-acc-id)]
    [(string.eq name (lower-spmd-reduce-end-name)) (lower-spmd-reduce-end-id)]
    [(string.eq name (lower-spmd-reduce-val-name)) (lower-spmd-reduce-val-id)]
    [(string.eq name (lower-spmd-reduce-current-name))
      (lower-spmd-reduce-current-id)]
    [(string.eq name (lower-spmd-scan-acc-name)) (lower-spmd-scan-acc-id)]
    [(string.eq name (lower-spmd-scan-end-name)) (lower-spmd-scan-end-id)]
    [(string.eq name (lower-spmd-scan-val-name)) (lower-spmd-scan-val-id)]
    [else (intern name)]))

(define (lower-refresh-marker-ids!) : unit
  (begin
    (set! lower-cleanup-marker-id-cache (intern (lower-cleanup-marker-name)))
    (set!
      lower-region-reset-marker-id-cache
      (intern (lower-region-reset-marker-name)))
    (set! lower-spmd-reduce-acc-id-cache (intern (lower-spmd-reduce-acc-name)))
    (set! lower-spmd-reduce-end-id-cache (intern (lower-spmd-reduce-end-name)))
    (set! lower-spmd-reduce-val-id-cache (intern (lower-spmd-reduce-val-name)))
    (set!
      lower-spmd-reduce-current-id-cache
      (intern (lower-spmd-reduce-current-name)))
    (set! lower-spmd-scan-acc-id-cache (intern (lower-spmd-scan-acc-name)))
    (set! lower-spmd-scan-end-id-cache (intern (lower-spmd-scan-end-name)))
    (set! lower-spmd-scan-val-id-cache (intern (lower-spmd-scan-val-name)))))

(define (lower-cleanup-hidden-name [var-id : i64]) : String
  (string.append "__tl_cleanup_resource." (string.int->string var-id)))

(define (lower-region-hidden-name [var-id : i64]) : String
  (string.append "__tl_region_mark." (string.int->string var-id)))

(define (lower-arena-restore-hidden-name [var-id : i64]) : String
  (string.append "__tl_arena_restore." (string.int->string var-id)))

(define (lower-cleanup-metadata-type
  [hidden-name : String]
  [cleanup-name : String]) : AstType
  (ast-ty-tuple
    (ast-type-cons
      (AstType.Var (intern hidden-name))
      (ast-type-cons (AstType.Var (intern cleanup-name)) AstTypeList.Nil))))

(define (lower-region-reset-metadata-type [hidden-name : String]) : AstType
  (AstType.Var (intern hidden-name)))

(define (lower-arena-restore-metadata-type [hidden-name : String]) : AstType
  (ast-ty-tuple
    (ast-type-cons (AstType.Var (intern hidden-name)) AstTypeList.Nil)))

(define (lower-type-env-push-cleanup
  [type-env : TcTypeEnv]
  [hidden-name : String]
  [cleanup-name : String]) : TcTypeEnv
  (tc-bind-id
    type-env
    (lower-cleanup-marker-id)
    (lower-cleanup-metadata-type hidden-name cleanup-name)))

(define (lower-type-env-push-region-reset
  [type-env : TcTypeEnv]
  [hidden-name : String]) : TcTypeEnv
  (tc-bind-id
    type-env
    (lower-region-reset-marker-id)
    (lower-region-reset-metadata-type hidden-name)))

(define (lower-type-env-push-arena-restore
  [type-env : TcTypeEnv]
  [hidden-name : String]) : TcTypeEnv
  (tc-bind-id
    type-env
    (lower-region-reset-marker-id)
    (lower-arena-restore-metadata-type hidden-name)))

(define (lower-cleanup-name-from-expr [cleanup : AstExpr]) : ResultTcString
  (match (ast-expr-unspan cleanup)
    [(AstExpr.Var name) (ResultTcString.Ok (intern-str name))]
    [_
      (ResultTcString.Err
        "lower: resource cleanup must be a direct function name")]))

(define (lower-emit-cleanup-call
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name : String]
  [cleanup-name : String]) : ResultLowerState
  (let
    [resource-id : i64
      (sym_i64_env.sym-i64-lookup-or
        env
        hidden-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? resource-id)
      (match (lower-state-alloc-var state)
        [(LowerAlloc allocated var-id)
          (OkLowerState
            (lower-state-emit
              allocated
              (CompilerIrInstr.Call
                var-id
                (lower-resolve-call-name allocated env cleanup-name)
                (CompilerIrCallArgs.One (CompilerIrValue.Var resource-id))
                (AstType.Unit))))])
      (ErrLowerState
        (box (lower-diagnostic "lower: missing resource cleanup binding"))))))

(define (lower-emit-region-reset
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name : String]) : ResultLowerState
  (let
    [mark-var : i64
      (sym_i64_env.sym-i64-lookup-or
        env
        hidden-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? mark-var)
      (match (lower-state-alloc-var state)
        [(LowerAlloc allocated reset-var)
          (OkLowerState
            (lower-state-emit
              allocated
              (CompilerIrInstr.Call
                reset-var
                "tl_region_reset"
                (CompilerIrCallArgs.One (CompilerIrValue.Var mark-var))
                (AstType.Unit))))])
      (ErrLowerState
        (box (lower-diagnostic "lower: missing region reset binding"))))))

(define (lower-emit-arena-restore
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name : String]) : ResultLowerState
  (let
    [arena-var : i64
      (sym_i64_env.sym-i64-lookup-or
        env
        hidden-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? arena-var)
      (match (lower-state-alloc-var state)
        [(LowerAlloc allocated restore-var)
          (OkLowerState
            (lower-state-emit
              allocated
              (CompilerIrInstr.Call
                restore-var
                "tl_arena_set"
                (CompilerIrCallArgs.One (CompilerIrValue.Var arena-var))
                (AstType.Unit))))])
      (ErrLowerState
        (box (lower-diagnostic "lower: missing arena restore binding"))))))

(define (lower-cleanup-stack-empty) : LowerCleanupStack
  (LowerCleanupStack (make-array String 0) (make-array String 0) 0))

(define (lower-cleanup-stack-push
  [cleanups : LowerCleanupStack]
  [hidden-name : String]
  [cleanup-name : String]) : LowerCleanupStack
  (let
    [hidden-names : (Array String) (struct-get cleanups hidden-names)]
    [cleanup-names : (Array String) (struct-get cleanups cleanup-names)]
    [count : i64 (struct-get cleanups count)]
    (begin
      (array-push! hidden-names hidden-name)
      (array-push! cleanup-names cleanup-name)
      (LowerCleanupStack hidden-names cleanup-names (+ count 1)))))

(define (lower-cleanup-stack-count [cleanups : LowerCleanupStack]) : i64
  (struct-get cleanups count))

(define (lower-cleanup-stack-entry?
  [cleanups : LowerCleanupStack]
  [index : i64]
  [hidden-name : String]
  [cleanup-name : String]) : bool
  (if (or (< index 0) (>= index (struct-get cleanups count)))
    false
    (and
      (string.eq
        (array-ref (struct-get cleanups hidden-names) index)
        hidden-name)
      (string.eq
        (array-ref (struct-get cleanups cleanup-names) index)
        cleanup-name))))

(define (lower-emit-cleanup-stack-at
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-names : (Array String)]
  [cleanup-names : (Array String)]
  [index : i64]) : ResultLowerState
  (if (< index 0)
    (OkLowerState state)
    (match (lower-emit-cleanup-call
      state
      env
      (array-ref hidden-names index)
      (array-ref cleanup-names index))
      [(OkLowerState next-state)
        (lower-emit-cleanup-stack-at
          next-state
          env
          hidden-names
          cleanup-names
          (- index 1))]
      [(ErrLowerState message) (ErrLowerState message)])))

(define (lower-emit-cleanup-stack
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [cleanups : LowerCleanupStack]) : ResultLowerState
  (lower-emit-cleanup-stack-at
    state
    env
    (struct-get cleanups hidden-names)
    (struct-get cleanups cleanup-names)
    (- (struct-get cleanups count) 1)))

;; #2598: emit the cleanup/region-reset calls a binding env keeps active. This
;; walks the whole TcTypeEnv chain once per scope exit; it used to be a
;; tail-recursive walk, but the inline-aggregate TCO guard (#2597) declines
;; frame reuse here, so deep envs stacked one ~12KB frame per binding (8,164
;; frames = 100MB of the measured 502MB stack peak). Iterate instead.
(define (lower-emit-active-exits-with
  [cleanup-marker-id : i64]
  [region-reset-marker-id : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerState
  (let
    [cur-env : TcTypeEnv type-env]
    [cur-state : LowerState state]
    [result : ResultLowerState
      (ErrLowerState
        (box (lower-diagnostic "lower: internal active-exits walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match cur-env
          [(TcTypeEnv.Nil)
            (begin
              (set! result (OkLowerState cur-state))
              (set! done true))]
          [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _) (set! cur-env (box-get rest))]
          [(TcTypeEnv.Bind key ty rest)
            (begin
              (if (= key cleanup-marker-id)
                (match ty
                  [(AstType.Tuple types)
                    (match (box-get types)
                      [(AstTypeList.Cons hidden-ty type-rest)
                        (let
                          [hidden-ty : AstType (ty-node-get hidden-ty)]
                          [type-rest : AstTypeList (box-get type-rest)]
                          (match hidden-ty
                            [(AstType.Var hidden-name)
                              (match type-rest
                                [(AstTypeList.Cons cleanup-ty end)
                                  (let
                                    [cleanup-ty : AstType
                                      (ty-node-get cleanup-ty)]
                                    [end : AstTypeList (box-get end)]
                                    (match cleanup-ty
                                      [(AstType.Var cleanup-name)
                                        (match end
                                          [(AstTypeList.Nil)
                                            (match (lower-emit-cleanup-call
                                              cur-state
                                              env
                                              (intern-str hidden-name)
                                              (intern-str cleanup-name))
                                              [(OkLowerState next-state)
                                                (set! cur-state next-state)]
                                              [(ErrLowerState message)
                                                (begin
                                                  (set!
                                                    result
                                                    (ErrLowerState message))
                                                  (set! done true))])]
                                          [_ unit])]
                                      [_ unit]))]
                                [_ unit])]
                            [_ unit]))]
                      [_ unit])]
                  [_ unit])
                (if (= key region-reset-marker-id)
                  (match ty
                    [(AstType.Var hidden-name)
                      (match (lower-emit-region-reset
                        cur-state
                        env
                        (intern-str hidden-name))
                        [(OkLowerState next-state) (set! cur-state next-state)]
                        [(ErrLowerState message)
                          (begin
                            (set! result (ErrLowerState message))
                            (set! done true))])]
                    [(AstType.Tuple types)
                      (match (box-get types)
                        [(AstTypeList.Cons hidden-ty end)
                          (let
                            [hidden-ty : AstType (ty-node-get hidden-ty)]
                            [end : AstTypeList (box-get end)]
                            (match hidden-ty
                              [(AstType.Var hidden-name)
                                (match end
                                  [(AstTypeList.Nil)
                                    (match (lower-emit-arena-restore
                                      cur-state
                                      env
                                      (intern-str hidden-name))
                                      [(OkLowerState next-state)
                                        (set! cur-state next-state)]
                                      [(ErrLowerState message)
                                        (begin
                                          (set! result (ErrLowerState message))
                                          (set! done true))])]
                                  [_ unit])]
                              [_ unit]))]
                        [_ unit])]
                    [_ unit])
                  unit))
              (if done
                unit
                (set! cur-env (box-get rest))))]))
      result)))

(define (lower-emit-active-exits
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerState
  (lower-emit-active-exits-with
    (lower-cleanup-marker-id)
    (lower-region-reset-marker-id)
    state
    env
    type-env))

(define (lower-emit-active-cleanups-with
  [cleanup-marker-id : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerState
  (match type-env
    [(TcTypeEnv.Nil) (OkLowerState state)]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (lower-emit-active-cleanups-with
        cleanup-marker-id
        state
        env
        (box-get rest))]
    [(TcTypeEnv.Bind key ty rest)
      (if (= key cleanup-marker-id)
        (match ty
          [(AstType.Tuple types)
            (match (box-get types)
              [(AstTypeList.Cons hidden-ty type-rest)
                (let
                  [hidden-ty : AstType (ty-node-get hidden-ty)]
                  [type-rest : AstTypeList (box-get type-rest)]
                  (match hidden-ty
                    [(AstType.Var hidden-name)
                      (match type-rest
                        [(AstTypeList.Cons cleanup-ty end)
                          (let
                            [cleanup-ty : AstType (ty-node-get cleanup-ty)]
                            [end : AstTypeList (box-get end)]
                            (match cleanup-ty
                              [(AstType.Var cleanup-name)
                                (match end
                                  [(AstTypeList.Nil)
                                    (match (lower-emit-cleanup-call
                                      state
                                      env
                                      (intern-str hidden-name)
                                      (intern-str cleanup-name))
                                      [(OkLowerState next-state)
                                        (lower-emit-active-cleanups-with
                                          cleanup-marker-id
                                          next-state
                                          env
                                          (box-get rest))]
                                      [(ErrLowerState message)
                                        (ErrLowerState message)])]
                                  [_
                                    (lower-emit-active-cleanups-with
                                      cleanup-marker-id
                                      state
                                      env
                                      (box-get rest))])]
                              [_
                                (lower-emit-active-cleanups-with
                                  cleanup-marker-id
                                  state
                                  env
                                  (box-get rest))]))]
                        [_
                          (lower-emit-active-cleanups-with
                            cleanup-marker-id
                            state
                            env
                            (box-get rest))])]
                    [_
                      (lower-emit-active-cleanups-with
                        cleanup-marker-id
                        state
                        env
                        (box-get rest))]))]
              [_
                (lower-emit-active-cleanups-with
                  cleanup-marker-id
                  state
                  env
                  (box-get rest))])]
          [_
            (lower-emit-active-cleanups-with
              cleanup-marker-id
              state
              env
              (box-get rest))])
        (lower-emit-active-cleanups-with
          cleanup-marker-id
          state
          env
          (box-get rest)))]))

(define (lower-emit-active-cleanups
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerState
  (lower-emit-active-cleanups-with (lower-cleanup-marker-id) state env type-env))

(define (lower-return-form
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-current-return-type type-env)
    [(ResultTcType.Ok return-ty)
      (match (lower-expr-expected ctx state env type-env value return-ty value)
        [(OkLowerExpr lowered)
          (match lowered
            [(LowerExpr value-state value-ir _)
              (match (lower-return-abi-value ctx value-state value-ir return-ty)
                [(OkLowerExpr return-copy)
                  (match return-copy
                    [(LowerExpr return-state return-value _)
                      (match (lower-emit-active-exits return-state env type-env)
                        [(OkLowerState cleanup-state)
                          (OkLowerExpr
                            (LowerExpr
                              (lower-state-emit-at-expr
                                cleanup-state
                                (CompilerIrInstr.Return
                                  (lower-return-maybe return-value return-ty))
                                origin)
                              CompilerIrValue.Unit
                              (AstType.Never)))]
                        [(ErrLowerState message) (ErrLowerExpr message)])])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(ResultTcType.Err _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "typecheck: return requires enclosing function")))]))

(define (lower-load-single-payload
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Unit) (LowerExpr state CompilerIrValue.Unit resolved)]
      ;; #1867: a Result/Option payload (offset 8 past the i64 tag) can be an
      ;; inline struct/enum; materialize it via the inline-aware load.
      [_
        (lower-load-inline-value-at-offset
          ctx
          state
          base
          8
          resolved
          (lower-state-mode state))])))

(define (lower-return-result-err
  [ctx : TcContext]
  [state : LowerState]
  [return-info : TcResultInfo]
  [payload : CompilerIrValue]) : ResultLowerState
  (match ctx
    [(TcContext _ _ registries _ _)
      (let
        [enum-name : String (tc-result-info-enum-name return-info)]
        [err-name : String (tc-result-info-err-name return-info)]
        [err-ty : AstType
          (tc-type-without-regions (tc-result-info-err-type return-info))]
        [handle : i64
          (compiler-registries-lookup-variant-or
            registries
            err-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (lower-reserve-heap-storage
            state
            (lower-enum-storage-size ctx enum-name)
            (AstType.Enum (intern enum-name)))
            [(LowerExpr base-state base _)
              (let
                [tag-state : LowerState
                  (lower-store-at-offset
                    base-state
                    base
                    0
                    (CompilerIrValue.I64
                      (compiler-registry-handle-child-index handle))
                    (AstType.I64))]
                [payload-state : LowerState
                  (match err-ty
                    [(AstType.Unit) tag-state]
                    ;; #1867: an inline struct/enum err payload must be
                    ;; byte-copied into the err slot, not scalar-stored.
                    [_
                      (lower-store-inline-value-at-offset
                        ctx
                        tag-state
                        base
                        8
                        payload
                        err-ty
                        (lower-type-size ctx err-ty))])]
                [ret-ty : AstType (AstType.Enum (intern enum-name))]
                ;; #2386: when the function's result enum is register-resident
                ;; the caller reads the return value from registers, so load
                ;; the constructed enum back out of the buffer (word or
                ;; 2-word group) instead of returning the buffer pointer.
                (if (lower-type-register-resident? ctx ret-ty)
                  (match (lower-load-inline-value-at-offset
                    ctx
                    payload-state
                    base
                    0
                    ret-ty
                    (lower-state-mode payload-state))
                    [(LowerExpr loaded-state loaded _)
                      (OkLowerState
                        (lower-state-emit
                          loaded-state
                          (CompilerIrInstr.Return
                            (lower-return-maybe loaded ret-ty))))])
                  (OkLowerState
                    (lower-state-emit
                      payload-state
                      (CompilerIrInstr.Return (lower-return-maybe base ret-ty))))))])
          (ErrLowerState
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " err-name))))))]))

;; #2386: the try tag/payload reads below address the operand as MEMORY. A
;; register-resident Result/Option (e.g. 16-byte (Ok i64)/(Err i64)) is carried
;; as word(s), so spill it to a temp inline slot first and continue with the
;; slot address; otherwise the tag load dereferences the packed value.
(define (lower-try-spill-resident-operand
  [ctx : TcContext]
  [lowered : ResultLowerExpr]) : ResultLowerExpr
  (match lowered
    [(OkLowerExpr expr)
      (match expr
        [(LowerExpr state value ty)
          (if (lower-type-register-resident? ctx ty)
            (match (lower-copy-inline-aggregate-to-inline ctx state value ty)
              [(OkLowerExpr spilled)
                (match spilled
                  [(LowerExpr spill-state slot _)
                    (OkLowerExpr (LowerExpr spill-state slot ty))])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])
            (OkLowerExpr expr))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-try-finish
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [result-value : CompilerIrValue]
  [operand-info : TcResultInfo]
  [return-info : TcResultInfo]
  [ok-label : String]
  [err-label : String]) : ResultLowerExpr
  (let
    [err-start : LowerState (lower-state-finish-block state err-label)]
    (match (lower-load-single-payload
      ctx
      err-start
      result-value
      (tc-result-info-err-type operand-info))
      [(LowerExpr err-payload-state err-payload _)
        (match (lower-emit-active-exits err-payload-state env type-env)
          [(OkLowerState cleanup-state)
            (match (lower-return-result-err
              ctx
              cleanup-state
              return-info
              err-payload)
              [(OkLowerState returned-state)
                (let
                  [ok-start : LowerState
                    (lower-state-finish-block returned-state ok-label)]
                  (match (lower-load-single-payload
                    ctx
                    ok-start
                    result-value
                    (tc-result-info-ok-type operand-info))
                    [(LowerExpr ok-state ok-payload ok-ty)
                      (OkLowerExpr (LowerExpr ok-state ok-payload ok-ty))]))]
              [(ErrLowerState message) (ErrLowerExpr message)])]
          [(ErrLowerState message) (ErrLowerExpr message)])])))

(define (lower-try-with-info
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [result-value : CompilerIrValue]
  [operand-info : TcResultInfo]
  [return-info : TcResultInfo]
  [origin : AstExpr]) : ResultLowerExpr
  (match ctx
    [(TcContext _ _ registries _ _)
      (let
        [ok-name : String (tc-result-info-ok-name operand-info)]
        [ok-handle : i64
          (compiler-registries-lookup-variant-or
            registries
            ok-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? ok-handle)
          (match (lower-load-at-offset state result-value 0 (AstType.I64))
            [(LowerExpr tag-state tag-value _)
              (match (lower-state-alloc-var tag-state)
                [(LowerAlloc eq-alloc eq-var)
                  (match (lower-state-fresh-label eq-alloc "try_ok")
                    [(LowerLabel ok-label-state ok-label)
                      (match (lower-state-fresh-label ok-label-state "try_err")
                        [(LowerLabel err-label-state err-label)
                          (let
                            [eq-state : LowerState
                              (lower-state-emit-at-expr
                                err-label-state
                                (CompilerIrInstr.BinOp
                                  eq-var
                                  CompilerIrBinOp.Eq
                                  tag-value
                                  (CompilerIrValue.I64
                                    (compiler-registry-handle-child-index
                                      ok-handle))
                                  (AstType.Bool))
                                origin)]
                            (lower-try-finish
                              ctx
                              (lower-state-emit
                                eq-state
                                (CompilerIrInstr.Branch
                                  (CompilerIrValue.Var eq-var)
                                  ok-label
                                  err-label))
                              env
                              type-env
                              result-value
                              operand-info
                              return-info
                              ok-label
                              err-label))])])])])
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                (string.append "lower: unknown variant " ok-name))))))]))

(define (lower-try
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-try-spill-resident-operand
    ctx
    (lower-expr ctx state env type-env inner))
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr result-state result-value result-ty)
          (match (tc-result-info ctx result-ty)
            [(ResultTcResultInfo.Ok operand-info)
              (match (tc-current-return-type type-env)
                [(ResultTcType.Ok return-ty)
                  (match (tc-result-info ctx return-ty)
                    [(ResultTcResultInfo.Ok return-info)
                      (match (tc-try-infos-compatible operand-info return-info)
                        [(ResultTcUnit.Ok)
                          (lower-try-with-info
                            ctx
                            result-state
                            env
                            type-env
                            result-value
                            operand-info
                            return-info
                            origin)]
                        [(ResultTcUnit.Err message)
                          (ErrLowerExpr
                            (box (lower-diagnostic-at-expr origin message)))])]
                    [(ResultTcResultInfo.Err _)
                      (ErrLowerExpr
                        (box
                          (lower-diagnostic-at-expr
                            origin
                            "typecheck: try requires enclosing Result-like function")))])]
                [(ResultTcType.Err _)
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "typecheck: try requires enclosing Result-like function")))])]
            [(ResultTcResultInfo.Err _)
              (ErrLowerExpr
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "typecheck: try operand must be Result-like enum")))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-top-level-value-defined? [ctx : TcContext] [name : String]) : bool
  (match ctx
    [(TcContext _ symbols _ module _)
      (compiler-symbols-handle-found?
        (if (and
          (> (string.string-length module) 0)
          (not (tc-name-qualified? name)))
          (compiler-symbols-lookup-value-in-module-or
            symbols
            module
            name
            (compiler-symbols-missing-handle))
          (compiler-symbols-lookup-value-or
            symbols
            name
            (compiler-symbols-missing-handle))))]))

(define (lower-builtin-call-available?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [name : String]) : bool
  (and
    (not (sym_i64_env.sym-i64-contains env name))
    (not (lower-top-level-value-defined? ctx name))))

(define (lower-string-runtime-builtin? [name : String]) : bool
  (let
    [_ : String name]
    false))

;; First-class arena primitives (#1633). arena-mark/arena-rewind reuse the
;; existing region runtime (they snapshot/rewind the current arena's bump).
(define (lower-arena-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-arena-id? name-id))

(define (lower-arena-builtin? [name : String]) : bool
  (lower-arena-builtin-id? (intern name)))

(define (lower-arena-builtin-nullary-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-arena-nullary-id? name-id))

(define (lower-arena-builtin-nullary? [name : String]) : bool
  (lower-arena-builtin-nullary-id? (intern name)))

(define (lower-arena-builtin-symbol-id [name-id : i64]) : String
  (cond
    [(cbi.compiler-builtin-lower-arena-make-id? name-id) "tl_arena_make"]
    [(cbi.compiler-builtin-lower-arena-make-atomic-id? name-id)
      "tl_arena_make_atomic"]
    [(cbi.compiler-builtin-lower-arena-current-id? name-id) "tl_arena_current"]
    [(cbi.compiler-builtin-lower-arena-mark-id? name-id) "tl_region_mark"]
    [(cbi.compiler-builtin-lower-arena-set-id? name-id) "tl_arena_set"]
    [(cbi.compiler-builtin-lower-arena-destroy-id? name-id) "tl_arena_destroy"]
    [else "tl_region_reset"]))

(define (lower-arena-builtin-symbol [name : String]) : String
  (lower-arena-builtin-symbol-id (intern name)))

(define (lower-arena-builtin-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [name-id : i64 (intern name)]
    (if (lower-arena-builtin-nullary-id? name-id)
      (lower-runtime-call-values
        state
        (lower-arena-builtin-symbol-id name-id)
        IrValueNil
        result-ty)
      (match args
        [(AstExprList.Cons arg tail)
          (let
            [arg : AstExpr (ast-node-get arg)]
            [tail : AstExprList (box-get tail)]
            (match tail
              [(AstExprList.Nil)
                (match (lower-expr ctx state env type-env arg)
                  [(OkLowerExpr lowered)
                    (match lowered
                      [(LowerExpr arg-state arg-value arg-ty)
                        (match (lower-cast-value
                          arg-state
                          arg-value
                          arg-ty
                          (AstType.I64))
                          [(LowerExpr cast-state cast-value _)
                            (lower-runtime-call-values
                              cast-state
                              (lower-arena-builtin-symbol-id name-id)
                              (compiler-ir-value-cons cast-value IrValueNil)
                              result-ty)])])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)])]
              [_
                (ErrLowerExpr
                  (box
                    (lower-diagnostic
                      "lower: arena builtin expects one argument")))]))]
        [_
          (ErrLowerExpr
            (box (lower-diagnostic "lower: arena builtin expects one argument")))]))))

(define (lower-tls-current-arena-read-call
  [state : LowerState]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (match args
    [(AstExprList.Nil)
      (lower-runtime-call-values
        state
        "tl_tls_current_arena_load"
        IrValueNil
        result-ty)]
    [_
      (ErrLowerExpr
        (box (lower-diagnostic "lower: tls-current-arena expects no arguments")))]))

(define (lower-tls-current-arena-set-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons arg-node rest-box)
      (let
        [arg : AstExpr (ast-node-get arg-node)]
        [rest : AstExprList (box-get rest-box)]
        (match rest
          [(AstExprList.Nil)
            (match (lower-expr ctx state env type-env arg)
              [(OkLowerExpr lowered)
                (match lowered
                  [(LowerExpr arg-state arg-value arg-ty)
                    (match (lower-cast-value
                      arg-state
                      arg-value
                      arg-ty
                      (AstType.I64))
                      [(LowerExpr cast-state cast-value _)
                        (lower-runtime-call-values
                          cast-state
                          "tl_tls_current_arena_store"
                          (compiler-ir-value-cons cast-value IrValueNil)
                          result-ty)])])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]
          [_
            (ErrLowerExpr
              (box
                (lower-diagnostic
                  "lower: tls-current-arena-set! expects exactly one argument")))]))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic
            "lower: tls-current-arena-set! expects exactly one argument")))]))

(define (lower-tls-current-arena-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (if (cbi.compiler-builtin-lower-tls-current-arena-read-id? name-id)
    (lower-tls-current-arena-read-call state args result-ty)
    (lower-tls-current-arena-set-call ctx state env type-env args result-ty)))

;; Lower `(clone x)` (#1633): the canonical deep-copy / arena-escape. A String
;; copies its buffer through `tl_substring`; tuple, fixed-array, and dynamic-
;; array values allocate fresh storage and recursively clone each element; Box
;; values allocate a fresh box for the cloned inner value; named aggregates
;; dispatch to synthesized `clone$<Name>` helpers (compiler_clone.tl) so
;; recursive enum/struct values recurse at runtime instead of lower time; and
;; scalar values are returned as-is.
;; #1867 sret ABI: the synthesized `clone$<Name>` helper returns an aggregate,
;; so it carries the hidden sret param; append the result-slot pointer here to
;; match (the same gate as the helper's definition, so a non-aggregate clone$
;; target -- e.g. a type variable -- passes only the value).
(define (lower-clone-named
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : String]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (match (lower-call-append-sret-arg
    ctx
    state
    (compiler-ir-value-cons value IrValueNil)
    ty)
    [(OkLowerArgs sret-state sret-values)
      (match (lower-state-alloc-var sret-state)
        [(LowerAlloc allocated var-id)
          (OkLowerExpr
            (LowerExpr
              (lower-state-emit
                allocated
                (CompilerIrInstr.Call
                  var-id
                  (lower-resolve-call-name
                    allocated
                    env
                    (clone-helper-name name))
                  (compiler-ir-call-args-from-list sret-values)
                  ty))
              (CompilerIrValue.Var var-id)
              ty))])]
    [(ErrLowerArgs message) (ErrLowerExpr message)]))

(define (lower-clone-scalar-type? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Unit) true]
    [(AstType.Never) true]
    [_ false]))

(define (lower-clone-bulk-copy-type? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [clone-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match clone-ty
      [(AstType.Struct _) (lower-type-register-resident? ctx clone-ty)]
      [(AstType.StructArgs _ _) (lower-type-register-resident? ctx clone-ty)]
      [(AstType.Enum _) (lower-type-register-resident? ctx clone-ty)]
      [(AstType.EnumArgs _ _) (lower-type-register-resident? ctx clone-ty)]
      [_ (lower-clone-scalar-type? clone-ty)])))

(define (lower-clone-type-list
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [types : AstTypeList]
  [cursor : i64]) : ResultLowerState
  (match types
    [(AstTypeList.Nil) (OkLowerState state)]
    [(AstTypeList.Cons ty rest)
      (let
        [ty : AstType (ty-node-get ty)]
        [rest : AstTypeList (box-get rest)]
        [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        [size : i64 (lower-type-size ctx resolved)]
        (if (> size 0)
          (match (lower-load-inline-value-at-offset
            ctx
            state
            src
            offset
            resolved
            (lower-state-mode state))
            [(LowerExpr load-state field-value _)
              (match (lower-clone-dispatch
                ctx
                load-state
                env
                type-env
                field-value
                resolved)
                [(OkLowerExpr cloned)
                  (match cloned
                    [(LowerExpr clone-state clone-value _)
                      (lower-clone-type-list
                        ctx
                        (lower-store-inline-value-at-offset
                          ctx
                          clone-state
                          dst
                          offset
                          clone-value
                          resolved
                          size)
                        env
                        type-env
                        src
                        dst
                        rest
                        (+ offset size))])]
                [(ErrLowerExpr message) (ErrLowerState message)])])
          (lower-clone-type-list
            ctx
            state
            env
            type-env
            src
            dst
            rest
            (+ offset size))))]))

(define (lower-clone-tuple-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-tys : AstTypeList]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage
    state
    (lower-type-list-storage-size ctx elem-tys)
    result-ty)
    [(LowerExpr dst-state dst _)
      (match (lower-clone-type-list
        ctx
        dst-state
        env
        type-env
        value
        dst
        elem-tys
        0)
        [(OkLowerState done-state)
          (OkLowerExpr (LowerExpr done-state dst result-ty))]
        [(ErrLowerState message) (ErrLowerExpr message)])]))

(define (lower-clone-fixed-array-elems
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [index : i64]
  [count : i64]) : ResultLowerState
  (if (>= index count)
    (OkLowerState state)
    (let
      [offset : i64 (* index elem-size)]
      (if (> elem-size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          elem-ty
          (lower-state-mode state))
          [(LowerExpr load-state elem-value _)
            (match (lower-clone-dispatch
              ctx
              load-state
              env
              type-env
              elem-value
              elem-ty)
              [(OkLowerExpr cloned)
                (match cloned
                  [(LowerExpr clone-state clone-value _)
                    (lower-clone-fixed-array-elems
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        clone-state
                        dst
                        offset
                        clone-value
                        elem-ty
                        elem-size)
                      env
                      type-env
                      src
                      dst
                      elem-ty
                      elem-size
                      (+ index 1)
                      count)])]
              [(ErrLowerExpr message) (ErrLowerState message)])])
        (lower-clone-fixed-array-elems
          ctx
          state
          env
          type-env
          src
          dst
          elem-ty
          elem-size
          (+ index 1)
          count)))))

(define (lower-clone-fixed-array-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [count : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    (match (lower-reserve-heap-storage
      state
      (lower-fixed-array-storage-size ctx elem-ty count)
      result-ty)
      [(LowerExpr dst-state dst _)
        (match (lower-clone-fixed-array-elems
          ctx
          dst-state
          env
          type-env
          value
          dst
          elem-ty
          elem-size
          0
          count)
          [(OkLowerState done-state)
            (OkLowerExpr (LowerExpr done-state dst result-ty))]
          [(ErrLowerState message) (ErrLowerExpr message)])])))

(define (lower-clone-dynarray-advance
  [state : LowerState]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc inc-alloc inc-var)
      (OkLowerState
        (lower-state-finish-block
          (lower-state-emit
            (lower-state-emit
              (lower-state-emit
                inc-alloc
                (CompilerIrInstr.BinOp
                  inc-var
                  CompilerIrBinOp.Add
                  (CompilerIrValue.Var index-var)
                  (CompilerIrValue.I64 1)
                  (AstType.I64)))
              (CompilerIrInstr.Mov
                index-var
                (CompilerIrValue.Var inc-var)
                (AstType.I64)))
            (CompilerIrInstr.Jump header-label))
          exit-label))]))

(define (lower-clone-dynarray-store-and-advance
  [ctx : TcContext]
  [state : LowerState]
  [new-buf : CompilerIrValue]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]
  [clone-value : CompilerIrValue]
  [elem-ty : AstType]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    new-buf
    (CompilerIrValue.Var index-var)
    elem-ty)
    [(LowerExpr dst-gep-state dst-ptr _)
      (lower-clone-dynarray-advance
        (lower-array-elem-store-state
          ctx
          dst-gep-state
          dst-ptr
          clone-value
          elem-ty)
        index-var
        header-label
        exit-label)]))

(define (lower-clone-dynarray-copy-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]
  [elem-ty : AstType]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    old-buf
    (CompilerIrValue.Var index-var)
    elem-ty)
    [(LowerExpr src-gep-state src-ptr _)
      (match (lower-load-inline-value-at-offset
        ctx
        src-gep-state
        src-ptr
        0
        elem-ty
        (lower-state-mode src-gep-state))
        [(LowerExpr load-state elem-value _)
          (match (lower-clone-dispatch
            ctx
            load-state
            env
            type-env
            elem-value
            elem-ty)
            [(OkLowerExpr cloned)
              (match cloned
                [(LowerExpr clone-state clone-value _)
                  (lower-clone-dynarray-store-and-advance
                    ctx
                    clone-state
                    new-buf
                    index-var
                    header-label
                    exit-label
                    clone-value
                    elem-ty)])]
            [(ErrLowerExpr message) (ErrLowerState message)])])]))

(define (lower-clone-dynarray-copy-nonempty
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]) : ResultLowerState
  (match (lower-state-fresh-label state "clone_array_header")
    [(LowerLabel header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "clone_array_body")
        [(LowerLabel body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "clone_array_exit")
            [(LowerLabel exit-label-state exit-label)
              (match (lower-state-alloc-var exit-label-state)
                [(LowerAlloc index-alloc index-var)
                  (let
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            index-alloc
                            (CompilerIrInstr.Mov
                              index-var
                              (CompilerIrValue.I64 0)
                              (AstType.I64)))
                          (CompilerIrInstr.Jump header-label))
                        header-label)]
                    (match (lower-state-alloc-var header-start)
                      [(LowerAlloc cond-alloc cond-var)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                (lower-state-emit
                                  cond-alloc
                                  (CompilerIrInstr.BinOp
                                    cond-var
                                    CompilerIrBinOp.Lt
                                    (CompilerIrValue.Var index-var)
                                    len
                                    (AstType.Bool)))
                                (CompilerIrInstr.Branch
                                  (CompilerIrValue.Var cond-var)
                                  body-label
                                  exit-label))
                              body-label)]
                          (lower-clone-dynarray-copy-body
                            ctx
                            body-start
                            env
                            type-env
                            old-buf
                            new-buf
                            index-var
                            header-label
                            exit-label
                            elem-ty))]))])])])]))

(define (lower-clone-dynarray-copy-loop
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [byte-count : CompilerIrValue]) : ResultLowerState
  (if (= elem-size 0)
    (OkLowerState state)
    (if (lower-clone-bulk-copy-type? ctx elem-ty)
      (OkLowerState
        (lower-emit-memcpy-value state new-buf 0 old-buf 0 byte-count))
      (lower-clone-dynarray-copy-nonempty
        ctx
        state
        env
        type-env
        old-buf
        new-buf
        len
        elem-ty))))

(define (lower-clone-dynarray-finish
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [old-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [byte-count : CompilerIrValue]
  [buf-var : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 result-ty)
    [(LowerExpr arr-state arr-value _)
      (match (lower-clone-dynarray-copy-loop
        ctx
        arr-state
        env
        type-env
        old-buf
        (CompilerIrValue.Var buf-var)
        len
        elem-ty
        elem-size
        byte-count)
        [(OkLowerState copied-state)
          (OkLowerExpr
            (LowerExpr
              (lower-store-at-offset
                (lower-store-at-offset
                  copied-state
                  arr-value
                  0
                  (CompilerIrValue.Var buf-var)
                  (AstType.U64))
                arr-value
                8
                len
                (AstType.I64))
              arr-value
              result-ty))]
        [(ErrLowerState message) (ErrLowerExpr message)])]))

(define (lower-clone-dynarray-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-load-at-offset state value 8 (AstType.I64))
    [(LowerExpr len-state len _)
      (match (lower-load-at-offset len-state value 0 (AstType.U64))
        [(LowerExpr ptr-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            (match (if (= elem-size 0)
              (LowerExpr ptr-state (CompilerIrValue.I64 1) (AstType.I64))
              (lower-emit-binop
                ptr-state
                CompilerIrBinOp.Mul
                len
                (CompilerIrValue.I64 elem-size)
                (AstType.I64)))
              [(LowerExpr byte-state byte-count _)
                (match (lower-state-alloc-var byte-state)
                  [(LowerAlloc buf-alloc buf-var)
                    (lower-clone-dynarray-finish
                      ctx
                      (lower-state-emit
                        buf-alloc
                        (CompilerIrInstr.Call
                          buf-var
                          "tl_alloc"
                          (CompilerIrCallArgs.One byte-count)
                          (AstType.U64)))
                      env
                      type-env
                      old-buf
                      len
                      elem-ty
                      elem-size
                      byte-count
                      buf-var
                      result-ty)])]))])]))

(define (lower-clone-box-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [inner-ty : AstType]
  [result-ty : AstType]) : ResultLowerExpr
  ;; #1867: a (Box T) with inline struct/enum T addresses the T storage at the
  ;; box pointer; load it as a value (pointer) rather than scalar-loading the
  ;; leading word, mirroring lower-box-get.
  (match (lower-load-inline-value-at-offset
    ctx
    state
    value
    0
    inner-ty
    (lower-state-mode state))
    [(LowerExpr load-state inner-value _)
      (match (lower-clone-dispatch
        ctx
        load-state
        env
        type-env
        inner-value
        inner-ty)
        [(OkLowerExpr cloned)
          (match cloned
            [(LowerExpr clone-state clone-value _)
              (match (lower-reserve-heap-storage
                clone-state
                (lower-type-size ctx inner-ty)
                result-ty)
                [(LowerExpr box-state box-value _)
                  (OkLowerExpr
                    (LowerExpr
                      (lower-store-inline-value-at-offset
                        ctx
                        box-state
                        box-value
                        0
                        clone-value
                        inner-ty
                        (lower-type-size ctx inner-ty))
                      box-value
                      result-ty))])])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]))

(define (lower-clone-dispatch
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (let
    [clone-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match clone-ty
      [(AstType.String) (lower-capture-snapshot-string-value state value)]
      [(AstType.Tuple elem-tys)
        (lower-clone-tuple-value
          ctx
          state
          env
          type-env
          value
          (box-get elem-tys)
          clone-ty)]
      [(AstType.Array elem-ty count)
        (lower-clone-fixed-array-value
          ctx
          state
          env
          type-env
          value
          (tc-type-without-regions (ty-node-get elem-ty))
          count
          clone-ty)]
      [(AstType.DynArray elem-ty)
        (lower-clone-dynarray-value
          ctx
          state
          env
          type-env
          value
          (tc-type-without-regions (ty-node-get elem-ty))
          clone-ty)]
      [(AstType.Box elem-ty)
        (lower-clone-box-value
          ctx
          state
          env
          type-env
          value
          (tc-type-without-regions (ty-node-get elem-ty))
          clone-ty)]
      ;; #2386: a register-resident aggregate is word-class POD held in a
      ;; register, so cloning it is a value copy -- no deep-clone helper, no
      ;; memory traversal.
      [(AstType.Enum name)
        (if (lower-type-register-resident? ctx clone-ty)
          (OkLowerExpr (LowerExpr state value clone-ty))
          (lower-clone-named ctx state env (intern-str name) value clone-ty))]
      [(AstType.Struct name)
        (if (lower-type-register-resident? ctx clone-ty)
          (OkLowerExpr (LowerExpr state value clone-ty))
          (lower-clone-named ctx state env (intern-str name) value clone-ty))]
      [(AstType.Var name)
        (lower-clone-named ctx state env (intern-str name) value clone-ty)]
      [_
        (if (lower-clone-scalar-type? clone-ty)
          (OkLowerExpr (LowerExpr state value clone-ty))
          (ErrLowerExpr
            (box
              (lower-diagnostic
                (string.append
                  "lower: clone unsupported type "
                  (tc-type-render clone-ty))))))])))

(define (lower-clone-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arg : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arg)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr arg-state arg-value arg-ty)
          (lower-clone-dispatch ctx arg-state env type-env arg-value arg-ty)])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-call-explicit-mut-borrow-var-name [arg : AstExpr]) : TcMaybeString
  (match (ast-expr-unspan arg)
    [(AstExpr.Borrow mutable _ place-box)
      (if mutable
        (match (ast-expr-unspan (ast-node-get place-box))
          [(AstExpr.Var name) (TcMaybeString.Some (intern-str name))]
          [_ TcMaybeString.No])
        TcMaybeString.No)]
    [_ TcMaybeString.No]))

(define (lower-call-arg-normal-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arg : AstExpr]
  [effective-arg : AstExpr]
  [arg-ty : AstType]) : ResultLowerCallArg
  (match (lower-expr-expected ctx state env type-env effective-arg arg-ty arg)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr arg-state value _)
          (OkLowerCallArg (LowerCallArg arg-state value LowerNoArgWriteback))])]
    [(ErrLowerExpr message) (ErrLowerCallArg message)]))

(define (lower-call-arg-mut-borrow-var-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arg : AstExpr]
  [effective-arg : AstExpr]
  [arg-ty : AstType]
  [name : String]) : ResultLowerCallArg
  (match (tc-lookup type-env name)
    [(ResultTcType.Ok place-ty)
      (let
        [referent-ty : AstType (tc-borrow-referent-type place-ty)]
        [referent-ir-ty : AstType
          (tc-type-without-regions (tc-resolve-type ctx referent-ty))]
        (if (or
          (tc-type-contains-reference? place-ty)
          (lower-borrow-place-value-reference? ctx referent-ty))
          (lower-call-arg-normal-as
            ctx
            state
            env
            type-env
            arg
            effective-arg
            arg-ty)
          (let
            [local-id : i64
              (sym_i64_env.sym-i64-lookup-or
                env
                name
                (compiler-symbols-missing-handle))]
            (if (compiler-symbols-handle-found? local-id)
              (match (lower-borrow-copy-to-inline-storage
                ctx
                state
                (CompilerIrValue.Var local-id)
                referent-ir-ty
                arg-ty)
                [(LowerExpr arg-state storage _)
                  (OkLowerCallArg
                    (LowerCallArg
                      arg-state
                      storage
                      (LowerSomeArgWriteback
                        (LowerArgWriteback local-id storage referent-ir-ty arg))))])
              (lower-call-arg-normal-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty)))))]
    [(ResultTcType.Err _)
      (lower-call-arg-normal-as ctx state env type-env arg effective-arg arg-ty)]))

(define (lower-call-arg-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arg : AstExpr]
  [expected : AstType]
  [arg-ty : AstType]) : ResultLowerCallArg
  (match (tc-call-effective-arg-expr ctx type-env arg expected)
    [(ResultTcExpr.Ok effective-arg)
      (match (tc-type-strip-region (tc-resolve-type ctx arg-ty))
        [(AstType.MutRef _ _)
          (match (lower-call-explicit-mut-borrow-var-name effective-arg)
            [(TcMaybeString.Some name)
              (lower-call-arg-mut-borrow-var-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty
                name)]
            [(TcMaybeString.No)
              (lower-call-arg-normal-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty)])]
        [_
          (lower-call-arg-normal-as
            ctx
            state
            env
            type-env
            arg
            effective-arg
            arg-ty)])]
    [(ResultTcExpr.Err message)
      (ErrLowerCallArg (box (lower-diagnostic-at-expr arg message)))]))

(define (lower-arg-writeback-list-empty) : LowerArgWritebackList
  (LowerArgWritebackList (make-array LowerArgWriteback 0) 0))

(define (lower-arg-writeback-list-count [writebacks : LowerArgWritebackList]) : i64
  (struct-get writebacks count))

(define (lower-arg-writeback-list-ref
  [writebacks : LowerArgWritebackList]
  [index : i64]) : LowerArgWriteback
  (array-ref (struct-get writebacks items) index))

(define (lower-arg-writeback-list-add
  [writebacks : LowerArgWritebackList]
  [writeback : LowerArgWriteback]) : LowerArgWritebackList
  (let
    [items : (Array LowerArgWriteback) (struct-get writebacks items)]
    [count : i64 (struct-get writebacks count)]
    [out : (Array LowerArgWriteback) (make-array LowerArgWriteback (+ count 1))]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set! out index (array-ref items index))
          (set! index (+ index 1))))
      (array-set! out count writeback)
      (LowerArgWritebackList out (+ count 1)))))

(define (lower-arg-writeback-list-add-front
  [writebacks : LowerArgWritebackList]
  [writeback : LowerArgWriteback]) : LowerArgWritebackList
  (let
    [items : (Array LowerArgWriteback) (struct-get writebacks items)]
    [count : i64 (struct-get writebacks count)]
    [out : (Array LowerArgWriteback) (make-array LowerArgWriteback (+ count 1))]
    [index : i64 0]
    (begin
      (array-set! out 0 writeback)
      (while (< index count)
        (begin
          (array-set! out (+ index 1) (array-ref items index))
          (set! index (+ index 1))))
      (LowerArgWritebackList out (+ count 1)))))

(define (lower-call-arg-writebacks-add-maybe
  [writebacks : LowerArgWritebackList]
  [maybe-writeback : LowerMaybeArgWriteback]) : LowerArgWritebackList
  (match maybe-writeback
    [(LowerNoArgWriteback) writebacks]
    [(LowerSomeArgWriteback writeback)
      (lower-arg-writeback-list-add-front writebacks writeback)]))

(define (lower-call-args-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [types : AstTypeList]) : ResultLowerCallArgs
  (match args
    [(AstExprList.Nil)
      (match types
        [(AstTypeList.Nil)
          (OkLowerCallArgs state IrValueNil (lower-arg-writeback-list-empty))]
        [_
          (ErrLowerCallArgs
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(AstExprList.Cons arg rest-args)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest-args : AstExprList (box-get rest-args)]
        (match types
          [(AstTypeList.Cons expected rest-types)
            (let
              [expected : AstType (ty-node-get expected)]
              [rest-types : AstTypeList (box-get rest-types)]
              [arg-ty : AstType
                (tc-type-without-regions (tc-resolve-type ctx expected))]
              (match (lower-call-arg-as
                ctx
                state
                env
                type-env
                arg
                expected
                arg-ty)
                [(OkLowerCallArg lowered-arg)
                  (match lowered-arg
                    [(LowerCallArg arg-state value maybe-writeback)
                      (match (lower-call-args-as
                        ctx
                        arg-state
                        env
                        type-env
                        rest-args
                        rest-types)
                        [(OkLowerCallArgs
                            rest-state
                            rest-values
                            rest-writebacks)
                          (OkLowerCallArgs
                            rest-state
                            (compiler-ir-value-cons value rest-values)
                            (lower-call-arg-writebacks-add-maybe
                              rest-writebacks
                              maybe-writeback))]
                        [(ErrLowerCallArgs message) (ErrLowerCallArgs message)])])]
                [(ErrLowerCallArg message) (ErrLowerCallArgs message)]))]
          [(AstTypeList.Nil)
            (ErrLowerCallArgs
              (box (lower-diagnostic "lower: constructor arity mismatch")))]))]))

(define (lower-apply-arg-writeback
  [ctx : TcContext]
  [state : LowerState]
  [writeback : LowerArgWriteback]) : LowerState
  (match writeback
    [(LowerArgWriteback local-id storage referent-ty origin)
      (match (lower-load-register-resident-from-ptr
        ctx
        state
        storage
        referent-ty)
        [(LowerExpr load-state loaded _)
          (lower-state-emit-at-expr
            load-state
            (CompilerIrInstr.Mov local-id loaded referent-ty)
            origin)])]))

(define (lower-apply-arg-writebacks
  [ctx : TcContext]
  [state : LowerState]
  [writebacks : LowerArgWritebackList]) : LowerState
  (let
    [count : i64 (lower-arg-writeback-list-count writebacks)]
    [index : i64 0]
    [out : LowerState state]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (lower-apply-arg-writeback
              ctx
              out
              (lower-arg-writeback-list-ref writebacks index)))
          (set! index (+ index 1))))
      out)))

(define (lower-bootstrap-runtime-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-bootstrap-runtime-id? name-id))

(define (lower-bootstrap-runtime-builtin? [name : String]) : bool
  (lower-bootstrap-runtime-builtin-id? (intern name)))

(define (lower-args-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [types : AstTypeList]) : ResultLowerArgs
  (match args
    [(AstExprList.Nil)
      (match types
        [(AstTypeList.Nil) (OkLowerArgs state IrValueNil)]
        [_
          (ErrLowerArgs
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(AstExprList.Cons arg rest-args)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest-args : AstExprList (box-get rest-args)]
        (match types
          [(AstTypeList.Cons expected rest-types)
            (let
              [expected : AstType (ty-node-get expected)]
              [rest-types : AstTypeList (box-get rest-types)]
              [arg-ty : AstType
                (tc-type-without-regions (tc-resolve-type ctx expected))]
              (match (tc-call-effective-arg-expr ctx type-env arg expected)
                [(ResultTcExpr.Ok effective-arg)
                  (match (lower-expr-expected
                    ctx
                    state
                    env
                    type-env
                    effective-arg
                    arg-ty
                    arg)
                    [(OkLowerExpr lowered)
                      (match lowered
                        [(LowerExpr arg-state value _)
                          (match (lower-args-as
                            ctx
                            arg-state
                            env
                            type-env
                            rest-args
                            rest-types)
                            [(OkLowerArgs rest-state rest-values)
                              (OkLowerArgs
                                rest-state
                                (compiler-ir-value-cons value rest-values))]
                            [(ErrLowerArgs message) (ErrLowerArgs message)])])]
                    [(ErrLowerExpr message) (ErrLowerArgs message)])]
                [(ResultTcExpr.Err message)
                  (ErrLowerArgs (box (lower-diagnostic-at-expr arg message)))]))]
          [(AstTypeList.Nil)
            (ErrLowerArgs
              (box (lower-diagnostic "lower: constructor arity mismatch")))]))]))

(define (lower-call-type-list-has-mut-ref-formal?
  [ctx : TcContext]
  [types : AstTypeList]) : bool
  (match types
    [(AstTypeList.Nil) false]
    [(AstTypeList.Cons head rest)
      (let
        [head : AstType (ty-node-get head)]
        [rest : AstTypeList (box-get rest)]
        (match (tc-type-strip-region head)
          [(AstType.MutRef _ _) true]
          [_ (lower-call-type-list-has-mut-ref-formal? ctx rest)]))]))

(define (lower-call-args-as-needed
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [types : AstTypeList]) : ResultLowerCallArgs
  (if (lower-call-type-list-has-mut-ref-formal? ctx types)
    (lower-call-args-as ctx state env type-env args types)
    (match (lower-args-as ctx state env type-env args types)
      [(OkLowerArgs args-state values)
        (OkLowerCallArgs args-state values (lower-arg-writeback-list-empty))]
      [(ErrLowerArgs message) (ErrLowerCallArgs message)])))

(define (lower-construct-struct-inline-from-values
  [ctx : TcContext]
  [state : LowerState]
  [struct-name : String]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [struct-ty : AstType]) : ResultLowerExpr
  (match (tc-inline-aggregate-layout-for ctx struct-name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Struct size _ _)
          ;; #2386: a register-resident struct is built directly in registers by
          ;; packing its fields with shift/or; no stack slot, no stores. A 2-word
          ;; struct packs each word and combines them with IrInstrPack.
          (if (tc-inline-aggregate-layout-register-resident? layout)
            (if (lower-type-register-group? ctx struct-ty)
              (lower-construct-struct-register-group
                ctx
                state
                values
                fields
                layout
                struct-ty)
              (match (lower-pack-inline-struct-values
                ctx
                state
                (CompilerIrValue.I64 0)
                (AstType.I64)
                values
                fields
                layout)
                [(OkLowerExpr packed)
                  (match packed
                    [(LowerExpr packed-state packed-value packed-ty)
                      (match (lower-materialize-register-word
                        packed-state
                        packed-value
                        packed-ty
                        (lower-register-word-type ctx struct-ty 0))
                        [(LowerExpr word-state word-value _)
                          (OkLowerExpr
                            (LowerExpr word-state word-value struct-ty))])])]
                [(ErrLowerExpr message) (ErrLowerExpr message)]))
            (match (lower-reserve-inline-storage state size struct-ty)
              [(LowerExpr base-state base _)
                (match (lower-store-inline-struct-values
                  ctx
                  base-state
                  base
                  values
                  fields
                  layout)
                  [(OkLowerState done-state)
                    (OkLowerExpr (LowerExpr done-state base struct-ty))]
                  [(ErrLowerState message) (ErrLowerExpr message)])]))]
        [(TcInlineAggregateLayout.Enum _ _ _)
          (ErrLowerExpr
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for struct is enum "
                  struct-name))))])]
    [(ResultTcInlineAggregateLayout.Err message)
      (ErrLowerExpr (box (lower-diagnostic message)))]))

(define (lower-construct-struct-inline-into-from-values
  [ctx : TcContext]
  [state : LowerState]
  [dst : CompilerIrValue]
  [struct-name : String]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]) : ResultLowerState
  (match (tc-inline-aggregate-layout-for ctx struct-name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Struct _ _ _)
          (lower-store-inline-struct-values ctx state dst values fields layout)]
        [(TcInlineAggregateLayout.Enum _ _ _)
          (ErrLowerState
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for struct is enum "
                  struct-name))))])]
    [(ResultTcInlineAggregateLayout.Err message)
      (ErrLowerState (box (lower-diagnostic message)))]))

(define (lower-construct-enum-inline-from-values
  [ctx : TcContext]
  [state : LowerState]
  [variant-name : String]
  [handle : i64]
  [values : CompilerIrValueList]
  [fields : AstTypeList]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerExpr
  (match (tc-inline-aggregate-layout-for ctx enum-name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Enum size _ _)
          ;; #2386: a 1-word register-resident enum is nullary, so its single word
          ;; is the discriminant tag. A 2-word register-group enum packs the tag
          ;; into word0 and the variant payload into word1.
          (if (tc-inline-aggregate-layout-register-resident? layout)
            ;; #2386: a register-resident enum is 8 (nullary tag) or 16 bytes (tag
            ;; word0 + payload word1); derive the 2-word group case from the size we
            ;; already have rather than rebuilding the layout (lower-type-register-
            ;; group?), whose transient per-call allocation -- summed over every
            ;; construct/match/bind site during the per-function scratch arena
            ;; window -- was heavy enough to overflow the scratch arena into a
            ;; second chunk and trip its rewind, corrupting later lowering.
            (if (= size 16)
              (lower-construct-enum-register-group
                ctx
                state
                handle
                values
                fields
                enum-ty)
              (OkLowerExpr
                (LowerExpr
                  state
                  (CompilerIrValue.I64
                    (compiler-registry-handle-child-index handle))
                  enum-ty)))
            (let
              [layout-variant-name : String
                (lower-member-name-base variant-name)]
              (match (lower-reserve-inline-storage state size enum-ty)
                [(LowerExpr base-state base _)
                  (let
                    [tag-state : LowerState
                      (lower-store-at-offset
                        base-state
                        base
                        0
                        (CompilerIrValue.I64
                          (compiler-registry-handle-child-index handle))
                        (AstType.I64))]
                    (match (lower-store-inline-payload-values
                      ctx
                      tag-state
                      base
                      values
                      fields
                      layout
                      layout-variant-name
                      0)
                      [(OkLowerState done-state)
                        (OkLowerExpr (LowerExpr done-state base enum-ty))]
                      [(ErrLowerState message) (ErrLowerExpr message)]))])))]
        [(TcInlineAggregateLayout.Struct _ _ _)
          (ErrLowerExpr
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for enum is struct "
                  enum-name))))])]
    [(ResultTcInlineAggregateLayout.Err message)
      (ErrLowerExpr (box (lower-diagnostic message)))]))

(define (lower-construct-enum-inline-into-from-values
  [ctx : TcContext]
  [state : LowerState]
  [dst : CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [values : CompilerIrValueList]
  [fields : AstTypeList]
  [enum-name : String]) : ResultLowerState
  (match (tc-inline-aggregate-layout-for ctx enum-name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Enum _ _ _)
          (let
            [layout-variant-name : String (lower-member-name-base variant-name)]
            [tag-state : LowerState
              (lower-store-at-offset
                state
                dst
                0
                (CompilerIrValue.I64
                  (compiler-registry-handle-child-index handle))
                (AstType.I64))]
            (lower-store-inline-payload-values
              ctx
              tag-state
              dst
              values
              fields
              layout
              layout-variant-name
              0))]
        [(TcInlineAggregateLayout.Struct _ _ _)
          (ErrLowerState
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for enum is struct "
                  enum-name))))])]
    [(ResultTcInlineAggregateLayout.Err message)
      (ErrLowerState (box (lower-diagnostic message)))]))

(define (lower-enum-constructor-fields-for-result
  [ctx : TcContext]
  [enum-name : String]
  [enum-ty : AstType]
  [fields : AstTypeList]) : AstTypeList
  (match enum-ty
    [(AstType.EnumArgs _ lifetimes)
      (match (tc-lifetime-subst-from-nominal-args
        ctx
        enum-name
        (box-get lifetimes))
        [(ResultTcLifetimeSubst.Ok subst)
          (tc-lifetime-subst-type-list subst fields)]
        [(ResultTcLifetimeSubst.Err _) fields])]
    [(AstType.VarArgs _ lifetimes)
      (match (tc-lifetime-subst-from-nominal-args
        ctx
        enum-name
        (box-get lifetimes))
        [(ResultTcLifetimeSubst.Ok subst)
          (tc-lifetime-subst-type-list subst fields)]
        [(ResultTcLifetimeSubst.Err _) fields])]
    [_ fields]))

(define (lower-variant-owner-module [ctx : TcContext] [handle : i64]) : String
  (match (tc-nominal-owner-name
    ctx
    (compiler-registry-variant-owner-handle handle))
    [(ResultTcString.Ok owner-name)
      (if (tc-name-qualified? owner-name)
        (tc-qualified-name-module owner-name)
        "")]
    [(ResultTcString.Err _) ""]))

(define (lower-variant-payload-fields-for-handle
  [ctx : TcContext]
  [handle : i64]
  [resolved-scrut-ty : AstType]
  [fields : AstTypeList]) : AstTypeList
  (let
    [field-ctx : TcContext
      (tc-context-with-module ctx (lower-variant-owner-module ctx handle))]
    [enum-name : String (lower-enum-type-name-or-empty resolved-scrut-ty)]
    (tc-resolve-type-list
      field-ctx
      (lower-enum-constructor-fields-for-result
        field-ctx
        enum-name
        resolved-scrut-ty
        fields))))

(define (lower-construct-enum-with-name
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [variant-name : String]
  [handle : i64]
  [args : AstExprList]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerExpr
  (match ctx
    [(TcContext _ symbols _ _ _)
      (match (compiler-registries-variant-fields-indexed symbols handle)
        [(ResultAstTypeList.Ok fields)
          (let
            [field-ctx : TcContext
              (tc-context-with-module
                ctx
                (lower-variant-owner-module ctx handle))]
            [resolved-fields : AstTypeList
              (tc-resolve-type-list
                field-ctx
                (lower-enum-constructor-fields-for-result
                  field-ctx
                  enum-name
                  enum-ty
                  fields))]
            (match (lower-args-as ctx state env type-env args resolved-fields)
              [(OkLowerArgs args-state values)
                (if (lower-mode-inline-aggregates?
                  (lower-state-mode args-state))
                  (lower-construct-enum-inline-from-values
                    ctx
                    args-state
                    variant-name
                    handle
                    values
                    resolved-fields
                    enum-name
                    enum-ty)
                  (match resolved-fields
                    [(AstTypeList.Nil)
                      (OkLowerExpr
                        (LowerExpr
                          args-state
                          (CompilerIrValue.GlobalAddr
                            (lower-nullary-variant-object-name
                              enum-name
                              variant-name))
                          enum-ty))]
                    [_
                      (let
                        [size : i64
                          (lower-variant-fields-storage-size
                            ctx
                            resolved-fields)]
                        (match (lower-reserve-heap-storage
                          args-state
                          size
                          enum-ty)
                          [(LowerExpr base-state base _)
                            (let
                              [tag-state : LowerState
                                (lower-store-at-offset
                                  base-state
                                  base
                                  0
                                  (CompilerIrValue.I64
                                    (compiler-registry-handle-child-index
                                      handle))
                                  (AstType.I64))]
                              (match (lower-store-values
                                ctx
                                tag-state
                                base
                                values
                                resolved-fields
                                8)
                                [(OkLowerState done-state)
                                  (OkLowerExpr
                                    (LowerExpr done-state base enum-ty))]
                                [(ErrLowerState message) (ErrLowerExpr message)]))]))]))]
              [(ErrLowerArgs message) (ErrLowerExpr message)]))]
        [(ResultAstTypeList.Err message)
          (ErrLowerExpr (box (lower-diagnostic message)))])]))

(define (lower-construct-enum-with-handle
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [variant-name : String]
  [handle : i64]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [enum-ty : AstType
      (tc-type-without-regions (tc-resolve-type ctx result-ty))]
    (match enum-ty
      [(AstType.Enum enum-name)
        (lower-construct-enum-with-name
          ctx
          state
          env
          type-env
          variant-name
          handle
          args
          (intern-str enum-name)
          enum-ty)]
      [(AstType.EnumArgs enum-name _)
        (lower-construct-enum-with-name
          ctx
          state
          env
          type-env
          variant-name
          handle
          args
          (intern-str enum-name)
          enum-ty)]
      [_
        (ErrLowerExpr
          (box
            (lower-diagnostic
              (string.append
                "lower: enum constructor result is not enum: "
                variant-name))))])))

(define (lower-construct-enum-with-name-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [args : AstExprList]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerState
  (match ctx
    [(TcContext _ symbols _ _ _)
      (match (compiler-registries-variant-fields-indexed symbols handle)
        [(ResultAstTypeList.Ok fields)
          (let
            [field-ctx : TcContext
              (tc-context-with-module
                ctx
                (lower-variant-owner-module ctx handle))]
            [resolved-fields : AstTypeList
              (tc-resolve-type-list
                field-ctx
                (lower-enum-constructor-fields-for-result
                  field-ctx
                  enum-name
                  enum-ty
                  fields))]
            (match (lower-args-as ctx state env type-env args resolved-fields)
              [(OkLowerArgs args-state values)
                (if (lower-mode-inline-aggregates?
                  (lower-state-mode args-state))
                  (lower-construct-enum-inline-into-from-values
                    ctx
                    args-state
                    dst
                    variant-name
                    handle
                    values
                    resolved-fields
                    enum-name)
                  (ErrLowerState
                    (box
                      (lower-diagnostic
                        "lower: enum destination construction requires inline aggregates"))))]
              [(ErrLowerArgs message) (ErrLowerState message)]))]
        [(ResultAstTypeList.Err message)
          (ErrLowerState (box (lower-diagnostic message)))])]))

(define (lower-construct-enum-with-handle-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerState
  (let
    [enum-ty : AstType
      (tc-type-without-regions (tc-resolve-type ctx result-ty))]
    (match enum-ty
      [(AstType.Enum enum-name)
        (lower-construct-enum-with-name-into
          ctx
          state
          env
          type-env
          dst
          variant-name
          handle
          args
          (intern-str enum-name)
          enum-ty)]
      [(AstType.EnumArgs enum-name _)
        (lower-construct-enum-with-name-into
          ctx
          state
          env
          type-env
          dst
          variant-name
          handle
          args
          (intern-str enum-name)
          enum-ty)]
      [_
        (ErrLowerState
          (box
            (lower-diagnostic
              (string.append
                "lower: enum constructor result is not enum: "
                variant-name))))])))

(define (lower-struct-constructor-field-types-for-result
  [ctx : TcContext]
  [struct-name : String]
  [struct-ty : AstType]
  [fields : AstFieldDefList]) : AstTypeList
  (let
    [field-types : AstTypeList (tc-field-type-list ctx fields)]
    (match struct-ty
      [(AstType.StructArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ResultTcLifetimeSubst.Err _) field-types])]
      [(AstType.VarArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ResultTcLifetimeSubst.Err _) field-types])]
      [_ field-types])))

(define (lower-context-with-nominal-owner-module
  [ctx : TcContext]
  [nominal-name : String]) : TcContext
  (if (tc-name-qualified? nominal-name)
    (tc-context-with-module ctx (tc-qualified-name-module nominal-name))
    (let
      [handle : i64
        (compiler-symbols-lookup-type-or
          (tc-context-symbols ctx)
          nominal-name
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? handle)
        (match (tc-nominal-owner-name ctx handle)
          [(ResultTcString.Ok owner-name)
            (if (tc-name-qualified? owner-name)
              (tc-context-with-module ctx (tc-qualified-name-module owner-name))
              (tc-context-with-module ctx ""))]
          [(ResultTcString.Err _) ctx])
        ctx))))

(define (lower-construct-struct
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [struct-name : String]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-struct-fields ctx struct-name)
    [(ResultAstFieldDefList.Ok fields)
      (let
        [struct-ty : AstType
          (tc-type-without-regions (tc-resolve-type ctx result-ty))]
        [field-types : AstTypeList
          (lower-struct-constructor-field-types-for-result
            ctx
            struct-name
            struct-ty
            fields)]
        (match (lower-args-as ctx state env type-env args field-types)
          [(OkLowerArgs args-state values)
            (if (lower-mode-inline-aggregates? (lower-state-mode args-state))
              (lower-construct-struct-inline-from-values
                ctx
                args-state
                struct-name
                values
                fields
                struct-ty)
              (if (lower-struct-repr-c? ctx struct-name)
                (match (tc-repr-c-struct-layout ctx struct-name)
                  [(ResultTcReprCLayout.Ok layout)
                    (match (lower-reserve-heap-storage
                      args-state
                      (tc-repr-c-layout-size layout)
                      struct-ty)
                      [(LowerExpr base-state base _)
                        (match (lower-store-repr-c-values
                          ctx
                          base-state
                          base
                          values
                          (tc-repr-c-layout-fields layout))
                          [(OkLowerState done-state)
                            (OkLowerExpr (LowerExpr done-state base struct-ty))]
                          [(ErrLowerState message) (ErrLowerExpr message)])])]
                  [(ResultTcReprCLayout.Err message)
                    (ErrLowerExpr (box (lower-diagnostic message)))])
                (let
                  [size : i64 (lower-type-list-storage-size ctx field-types)]
                  (match (lower-reserve-heap-storage args-state size struct-ty)
                    [(LowerExpr base-state base _)
                      (match (lower-store-values
                        ctx
                        base-state
                        base
                        values
                        field-types
                        0)
                        [(OkLowerState done-state)
                          (OkLowerExpr (LowerExpr done-state base struct-ty))]
                        [(ErrLowerState message) (ErrLowerExpr message)])]))))]
          [(ErrLowerArgs message) (ErrLowerExpr message)]))]
    [(ResultAstFieldDefList.Err message)
      (ErrLowerExpr (box (lower-diagnostic message)))]))

(define (lower-construct-struct-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [struct-name : String]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerState
  (match (lower-struct-fields ctx struct-name)
    [(ResultAstFieldDefList.Ok fields)
      (let
        [struct-ty : AstType
          (tc-type-without-regions (tc-resolve-type ctx result-ty))]
        [field-types : AstTypeList
          (lower-struct-constructor-field-types-for-result
            ctx
            struct-name
            struct-ty
            fields)]
        (match (lower-args-as ctx state env type-env args field-types)
          [(OkLowerArgs args-state values)
            (if (lower-mode-inline-aggregates? (lower-state-mode args-state))
              (lower-construct-struct-inline-into-from-values
                ctx
                args-state
                dst
                struct-name
                values
                fields)
              (ErrLowerState
                (box
                  (lower-diagnostic
                    "lower: struct destination construction requires inline aggregates"))))]
          [(ErrLowerArgs message) (ErrLowerState message)]))]
    [(ResultAstFieldDefList.Err message)
      (ErrLowerState (box (lower-diagnostic message)))]))

(define (lower-init-expr-list-from-types [types : AstTypeList]) : AstExprList
  (match types
    [(AstTypeList.Nil) AstExprList.Nil]
    [(AstTypeList.Cons head rest)
      (let
        [head : AstType (ty-node-get head)]
        [rest : AstTypeList (box-get rest)]
        (ast-expr-cons
          (ast-expr-init head)
          (lower-init-expr-list-from-types rest)))]))

(define (lower-init-expr-list-repeat [ty : AstType] [count : i64]) : AstExprList
  (if (<= count 0)
    AstExprList.Nil
    (ast-expr-cons
      (ast-expr-init ty)
      (lower-init-expr-list-repeat ty (- count 1)))))

(define (lower-init-scalar
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (lower-materialize-at-expr state value ty origin))

(define (lower-init-struct
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [struct-name : String]
  [struct-ty : AstType]) : ResultLowerExpr
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module ctx struct-name)]
    (if (lower-struct-repr-c? field-ctx struct-name)
      (ErrLowerExpr
        (box
          (lower-diagnostic "lower: init supports only default-layout structs")))
      (match (lower-struct-fields field-ctx struct-name)
        [(ResultAstFieldDefList.Ok fields)
          (let
            [field-types : AstTypeList
              (tc-resolve-type-list
                field-ctx
                (lower-struct-constructor-field-types-for-result
                  field-ctx
                  struct-name
                  struct-ty
                  fields))]
            (lower-construct-struct
              ctx
              state
              env
              type-env
              struct-name
              (lower-init-expr-list-from-types field-types)
              struct-ty))]
        [(ResultAstFieldDefList.Err message)
          (ErrLowerExpr (box (lower-diagnostic message)))]))))

(define (lower-init-enum
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerExpr
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module ctx enum-name)]
    (match (tc-enum-decl field-ctx enum-name)
      [(ResultTcEnumDecl.Ok decl)
        (match decl
          [(TcEnumDecl _ variants)
            (match variants
              [(AstVariantDefList.Nil)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic
                      "lower: init requires enum with at least one variant")))]
              [(AstVariantDefList.Cons variant _)
                (match variant
                  [(AstVariantDef.Def variant-name fields _)
                    (let
                      [lookup-name : String
                        (tc-variant-name-for-enum
                          enum-name
                          (intern-str variant-name))]
                      [payload-types : AstTypeList
                        (tc-resolve-type-list
                          field-ctx
                          (lower-enum-constructor-fields-for-result
                            field-ctx
                            enum-name
                            enum-ty
                            fields))]
                      [handle : i64
                        (compiler-registries-lookup-variant-or
                          (tc-context-registries ctx)
                          lookup-name
                          (compiler-symbols-missing-handle))]
                      (if (compiler-symbols-handle-found? handle)
                        (lower-construct-enum-with-name
                          ctx
                          state
                          env
                          type-env
                          lookup-name
                          handle
                          (lower-init-expr-list-from-types payload-types)
                          enum-name
                          enum-ty)
                        (ErrLowerExpr
                          (box
                            (lower-diagnostic
                              (string.append
                                "lower: unknown variant "
                                lookup-name))))))])])])]
      [(ResultTcEnumDecl.Err message)
        (ErrLowerExpr (box (lower-diagnostic message)))])))

(define (lower-init-struct-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [struct-name : String]
  [struct-ty : AstType]) : ResultLowerState
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module ctx struct-name)]
    (if (lower-struct-repr-c? field-ctx struct-name)
      (ErrLowerState
        (box
          (lower-diagnostic "lower: init supports only default-layout structs")))
      (match (lower-struct-fields field-ctx struct-name)
        [(ResultAstFieldDefList.Ok fields)
          (let
            [field-types : AstTypeList
              (tc-resolve-type-list
                field-ctx
                (lower-struct-constructor-field-types-for-result
                  field-ctx
                  struct-name
                  struct-ty
                  fields))]
            (lower-construct-struct-into
              ctx
              state
              env
              type-env
              dst
              struct-name
              (lower-init-expr-list-from-types field-types)
              struct-ty))]
        [(ResultAstFieldDefList.Err message)
          (ErrLowerState (box (lower-diagnostic message)))]))))

(define (lower-init-enum-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerState
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module ctx enum-name)]
    (match (tc-enum-decl field-ctx enum-name)
      [(ResultTcEnumDecl.Ok decl)
        (match decl
          [(TcEnumDecl _ variants)
            (match variants
              [(AstVariantDefList.Nil)
                (ErrLowerState
                  (box
                    (lower-diagnostic
                      "lower: init requires enum with at least one variant")))]
              [(AstVariantDefList.Cons variant _)
                (match variant
                  [(AstVariantDef.Def variant-name fields _)
                    (let
                      [lookup-name : String
                        (tc-variant-name-for-enum
                          enum-name
                          (intern-str variant-name))]
                      [payload-types : AstTypeList
                        (tc-resolve-type-list
                          field-ctx
                          (lower-enum-constructor-fields-for-result
                            field-ctx
                            enum-name
                            enum-ty
                            fields))]
                      [handle : i64
                        (compiler-registries-lookup-variant-or
                          (tc-context-registries ctx)
                          lookup-name
                          (compiler-symbols-missing-handle))]
                      (if (compiler-symbols-handle-found? handle)
                        (lower-construct-enum-with-name-into
                          ctx
                          state
                          env
                          type-env
                          dst
                          lookup-name
                          handle
                          (lower-init-expr-list-from-types payload-types)
                          enum-name
                          enum-ty)
                        (ErrLowerState
                          (box
                            (lower-diagnostic
                              (string.append
                                "lower: unknown variant "
                                lookup-name))))))])])])]
      [(ResultTcEnumDecl.Err message)
        (ErrLowerState (box (lower-diagnostic message)))])))

(define (lower-init-expr-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [ty : AstType]
  [origin : AstExpr]) : ResultLowerState
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Struct name)
        (lower-init-struct-into
          ctx
          state
          env
          type-env
          dst
          (intern-str name)
          resolved)]
      [(AstType.StructArgs name _)
        (lower-init-struct-into
          ctx
          state
          env
          type-env
          dst
          (intern-str name)
          resolved)]
      [(AstType.Enum name)
        (lower-init-enum-into
          ctx
          state
          env
          type-env
          dst
          (intern-str name)
          resolved)]
      [(AstType.EnumArgs name _)
        (lower-init-enum-into
          ctx
          state
          env
          type-env
          dst
          (intern-str name)
          resolved)]
      [_
        (ErrLowerState
          (box
            (lower-diagnostic-at-expr
              origin
              (string.append
                "lower: init unsupported type "
                (tc-type-render resolved)))))])))

(define (lower-init-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [ty : AstType]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (if (tc-integer-type? resolved)
      (lower-init-scalar state (CompilerIrValue.I64 0) expr-ty origin)
      (match resolved
        [(AstType.F64)
          (lower-init-scalar
            state
            (CompilerIrValue.F64 (lower-float-literal-bits "0.0" (AstType.F64)))
            expr-ty
            origin)]
        [(AstType.F32)
          (lower-init-scalar
            state
            (CompilerIrValue.F64 (lower-float-literal-bits "0.0" (AstType.F32)))
            expr-ty
            origin)]
        [(AstType.Bool)
          (lower-init-scalar state (CompilerIrValue.Bool false) expr-ty origin)]
        [(AstType.Char)
          (lower-init-scalar state (CompilerIrValue.Char '\0') expr-ty origin)]
        [(AstType.Unit)
          (OkLowerExpr (LowerExpr state CompilerIrValue.Unit expr-ty))]
        [(AstType.String)
          (lower-init-scalar state (CompilerIrValue.String "") expr-ty origin)]
        [(AstType.Ptr _)
          (match (lower-materialize state (CompilerIrValue.I64 0) (AstType.U64))
            [(OkLowerExpr lowered)
              (match lowered
                [(LowerExpr null-state null-value _)
                  (OkLowerExpr (LowerExpr null-state null-value expr-ty))])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])]
        [(AstType.MutPtr _)
          (match (lower-materialize state (CompilerIrValue.I64 0) (AstType.U64))
            [(OkLowerExpr lowered)
              (match lowered
                [(LowerExpr null-state null-value _)
                  (OkLowerExpr (LowerExpr null-state null-value expr-ty))])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])]
        [(AstType.DynArray elem)
          (lower-make-array-from-len
            ctx
            state
            env
            type-env
            (ty-node-get elem)
            (CompilerIrValue.I64 0)
            (AstType.I64)
            (AstExpr.Literal (ast-lit-int 0))
            origin)]
        [(AstType.Box elem)
          (lower-box
            ctx
            state
            env
            type-env
            (AstExpr.Init (AstMaybeType.Some (ty-node-get elem)))
            expr-ty)]
        [(AstType.Tuple elems)
          (lower-tuple
            ctx
            state
            env
            type-env
            (lower-init-expr-list-from-types (box-get elems))
            expr-ty
            origin)]
        [(AstType.Array elem count)
          (if (< count 0)
            (ErrLowerExpr
              (box
                (lower-diagnostic
                  "lower: init fixed array length must be non-negative")))
            (lower-array-literal
              ctx
              state
              env
              type-env
              (lower-init-expr-list-repeat (ty-node-get elem) count)
              expr-ty
              origin))]
        [(AstType.Struct name)
          (lower-init-struct ctx state env type-env (intern-str name) resolved)]
        [(AstType.StructArgs name _)
          (lower-init-struct ctx state env type-env (intern-str name) resolved)]
        [(AstType.Enum name)
          (lower-init-enum ctx state env type-env (intern-str name) resolved)]
        [(AstType.EnumArgs name _)
          (lower-init-enum ctx state env type-env (intern-str name) resolved)]
        [_
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                (string.append
                  "lower: init unsupported type "
                  (tc-type-render resolved)))))]))))

(define (lower-nullary-variant-result-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ false]))

(define (lower-nullary-variant-or-function-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (lower-nullary-variant-result-type? expr-ty)
    (let
      [lookup-name : String
        (lower-variant-constructor-lookup-name ctx name expr-ty)]
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [registries : CompilerRegistries (tc-context-registries ctx)]
      [handle : i64
        (compiler-registries-lookup-variant-or
          registries
          lookup-name
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? handle)
        (match (compiler-registries-variant-fields-indexed symbols handle)
          [(ResultAstTypeList.Ok fields)
            (match fields
              [(AstTypeList.Nil)
                (lower-construct-enum-with-handle
                  ctx
                  state
                  env
                  type-env
                  lookup-name
                  handle
                  AstExprList.Nil
                  expr-ty)]
              [_ (lower-function-value-or-var ctx state env name expr-ty)])]
          [(ResultAstTypeList.Err _)
            (lower-function-value-or-var ctx state env name expr-ty)])
        (lower-function-value-or-var ctx state env name expr-ty)))
    (lower-function-value-or-var ctx state env name expr-ty)))

;; #2386: a register-group GLOBAL stores its two words inline at the symbol; a
;; read of it yields `CompilerIrValue.Global name` (the storage), which must be
;; materialized into a register-group VALUE by loading both words from the
;; symbol's address. Local group vars (CompilerIrValue.Var) and non-group values pass
;; through unchanged.
(define (lower-materialize-group-global
  [ctx : TcContext]
  [result : ResultLowerExpr]) : ResultLowerExpr
  (match result
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr s v t)
          (match v
            [(CompilerIrValue.Global name)
              (if (lower-type-register-group? ctx t)
                (match (lower-load-group-from-ptr
                  ctx
                  s
                  (CompilerIrValue.GlobalAddr name)
                  t)
                  [(LowerExpr ls lv _) (OkLowerExpr (LowerExpr ls lv t))])
                (OkLowerExpr lowered))]
            [_ (OkLowerExpr lowered)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-var-or-nullary-variant
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (lower-materialize-group-global
    ctx
    (if (sym_i64_env.sym-i64-contains env name)
      (lower-var state env name expr-ty)
      (lower-nullary-variant-or-function-value
        ctx
        state
        env
        type-env
        name
        expr-ty))))

(define (lower-var-or-nullary-variant-id
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]
  [expr-ty : AstType]) : ResultLowerExpr
  ;; #2357: mirror lower-var-or-nullary-variant -- a register-group GLOBAL read
  ;; yields CompilerIrValue.Global and must be materialized into a group VALUE (load both
  ;; words) before any CompilerIrInstr.Word/struct-get/match extraction; main's interned
  ;; -id path dropped this wrapper, so reg-group globals faulted.
  (lower-materialize-group-global
    ctx
    (if (sym_i64_env.sym-i64-contains-id env name-id)
      (lower-var-id state env name-id expr-ty)
      (let
        [name : String (intern-str name-id)]
        (match (lower-source-name-lookup-key ctx type-env name)
          [(ResultTcString.Ok lookup-name)
            (lower-nullary-variant-or-function-value
              ctx
              state
              env
              type-env
              lookup-name
              expr-ty)]
          [(ResultTcString.Err message)
            (ErrLowerExpr (box (lower-diagnostic message)))])))))

(define (lower-call-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (match (ast-expr-unspan func)
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (match (lower-lookup-type ctx type-cache env type-env name-text)
          [(ResultTcType.Ok fn-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
              [(AstType.Func _ ret)
                (ResultTcType.Ok
                  (tc-type-without-regions
                    (tc-resolve-type ctx (ty-node-get ret))))]
              [(AstType.Enum _)
                (ResultTcType.Ok (tc-type-without-regions fn-ty))]
              [_
                (ResultTcType.Err
                  "lower: call result type is not fast-pathable")])]
          [(ResultTcType.Err message)
            (if (lower-builtin-call-available? ctx env name-text)
              (cond
                [(cbi.compiler-builtin-lower-array-length-id? name)
                  (ResultTcType.Ok (AstType.I64))]
                [(cbi.compiler-builtin-lower-string-ref-call-id? name)
                  (ResultTcType.Ok (AstType.Char))]
                [(cbi.compiler-builtin-lower-clone-id? name)
                  (match args
                    [(AstExprList.Cons arg tail)
                      (let
                        [arg : AstExpr (ast-node-get arg)]
                        [tail : AstExprList (box-get tail)]
                        (match tail
                          [(AstExprList.Nil)
                            (lower-expr-result-type-fast
                              ctx
                              env
                              type-env
                              type-cache
                              arg)]
                          [_
                            (ResultTcType.Err
                              "lower: call result type is not fast-pathable")]))]
                    [_
                      (ResultTcType.Err
                        "lower: call result type is not fast-pathable")])]
                [else (ResultTcType.Err message)])
              (ResultTcType.Err message))]))]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-lambda-expr-allow-ref-captures
              ctx
              type-env
              params
              maybe-ret
              body)
              [(ResultTcType.Ok fn-ty)
                (match fn-ty
                  [(AstType.Func _ ret)
                    (ResultTcType.Ok
                      (tc-type-without-regions
                        (tc-resolve-type ctx (ty-node-get ret))))]
                  [_
                    (ResultTcType.Err
                      "lower: call result type is not fast-pathable")])]
              [(ResultTcType.Err message) (ResultTcType.Err message)]))])]
    [_ (ResultTcType.Err "lower: call result type is not fast-pathable")]))

(define (lower-binary-result-type-fast
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultTcType
  (match (tc-binop-expr-types ctx type-env op left right)
    [(ResultTcBinOpTypes.Ok binop-types)
      (match binop-types
        [(TcBinOpTypes _ _ result-ty)
          (ResultTcType.Ok
            (tc-type-without-regions (tc-resolve-type ctx result-ty)))])]
    [(ResultTcBinOpTypes.Err message) (ResultTcType.Err message)]))

(define (lower-binop-types-with-result
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]
  [expr-ty : AstType]) : ResultTcBinOpTypes
  (let
    [operand-expected : AstType
      (tc-type-without-regions (tc-resolve-type ctx expr-ty))]
    (match (tc-binop-contextual-operand-type op operand-expected)
      [(AstMaybeType.No) (tc-binop-expr-types ctx type-env op left right)]
      [(AstMaybeType.Some operand-ty)
        (match (tc-expr-with-expected-or-actual ctx type-env left operand-ty)
          [(ResultTcType.Ok left-ty)
            (match (tc-expr-with-expected-or-actual
              ctx
              type-env
              right
              operand-ty)
              [(ResultTcType.Ok right-ty)
                (match (tc-binop-type op left-ty right-ty)
                  [(ResultTcType.Ok result-ty)
                    (if (tc-type-compatible? expr-ty result-ty)
                      (ResultTcBinOpTypes.Ok
                        (TcBinOpTypes
                          left-ty
                          right-ty
                          (tc-contextual-result-type expr-ty result-ty)))
                      (tc-binop-expr-types ctx type-env op left right))]
                  [(ResultTcType.Err _)
                    (tc-binop-expr-types ctx type-env op left right)])]
              [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])]
          [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])])))

(define (lower-unop-type-with-result
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [op : AstUnOp]
  [inner : AstExpr]
  [expr-ty : AstType]) : ResultTcType
  (let
    [operand-expected : AstType
      (tc-type-without-regions (tc-resolve-type ctx expr-ty))]
    (match (tc-unop-contextual-operand-type op operand-expected)
      [(AstMaybeType.No)
        (match (tc-expr ctx type-env inner)
          [(ResultTcType.Ok inner-ty) (tc-unop-type op inner-ty)]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(AstMaybeType.Some operand-ty)
        (match (tc-expr-with-expected-or-actual ctx type-env inner operand-ty)
          [(ResultTcType.Ok inner-ty)
            (match (tc-unop-type op inner-ty)
              [(ResultTcType.Ok result-ty)
                (if (tc-type-compatible? expr-ty result-ty)
                  (ResultTcType.Ok
                    (tc-contextual-result-type expr-ty result-ty))
                  (tc-unop-type op inner-ty))]
              [(ResultTcType.Err _)
                (match (tc-expr ctx type-env inner)
                  [(ResultTcType.Ok actual-ty) (tc-unop-type op actual-ty)]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (lower-if-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [then-branch : AstExpr]
  [else-branch : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache then-branch)
    [(ResultTcType.Ok then-ty)
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        else-branch)
        [(ResultTcType.Ok else-ty) (tc-merge-branch-type then-ty else-ty)]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-expr-list-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [exprs : AstExprList]) : ResultTcType
  (match exprs
    [(AstExprList.Nil) (ResultTcType.Ok (AstType.Unit))]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprList.Nil)
            (lower-expr-result-type-fast ctx env type-env type-cache expr)]
          [_
            (lower-expr-list-result-type-fast ctx env type-env type-cache rest)]))]))

(define (lower-pattern-list-bind-local-names
  [env : sym_i64_env.SymI64Env]
  [patterns : AstPatternList]) : sym_i64_env.SymI64Env
  (match patterns
    [(AstPatternList.Nil) env]
    [(AstPatternList.Cons pattern rest)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest : AstPatternList (box-get rest)]
        (lower-pattern-list-bind-local-names
          (lower-pattern-bind-local-names env pattern)
          rest))]))

(define (lower-pattern-bind-local-names
  [env : sym_i64_env.SymI64Env]
  [pattern : AstPattern]) : sym_i64_env.SymI64Env
  (match pattern
    [(AstPattern.Var name _) (sym_i64_env.sym-i64-bind-id env name 0)]
    [(AstPattern.Tuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (lower-pattern-list-bind-local-names env patterns))]
    [(AstPattern.Binding name) (sym_i64_env.sym-i64-bind-id env name 0)]
    [(AstPattern.Variant _ args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (lower-pattern-list-bind-local-names env args))]
    [_ env]))

(define (lower-match-pattern-bind-local-names
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : sym_i64_env.SymI64Env
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(AstType.Enum _)
      (match pattern
        [(AstPattern.Variant _ args-box)
          (let
            [args : AstPatternList (box-get args-box)]
            (lower-pattern-list-bind-local-names env args))]
        [_ env])]
    [_ (lower-pattern-bind-local-names env pattern)]))

(define (lower-match-arm-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [scrut-ty : AstType]
  [arm : AstMatchArm]) : ResultTcType
  (match arm
    [(AstMatchArm.Arm pattern body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-bind-match-pattern ctx type-env scrut-ty pattern)
          [(ResultTcEnv.Ok arm-type-env)
            (lower-expr-result-type-fast
              ctx
              (lower-match-pattern-bind-local-names ctx env scrut-ty pattern)
              arm-type-env
              type-cache
              body)]
          [(ResultTcEnv.Err message) (ResultTcType.Err message)]))]))

(define (lower-match-rest-result-types-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [want : AstType]) : ResultTcType
  (match arms
    [(AstMatchArmList.Nil) (ResultTcType.Ok want)]
    [(AstMatchArmList.Cons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match (lower-match-arm-result-type-fast
          ctx
          env
          type-env
          type-cache
          scrut-ty
          arm)
          [(ResultTcType.Ok got)
            (match (tc-merge-branch-type want got)
              [(ResultTcType.Ok merged)
                (lower-match-rest-result-types-fast
                  ctx
                  env
                  type-env
                  type-cache
                  scrut-ty
                  rest
                  merged)]
              [(ResultTcType.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)]))]))

(define (lower-match-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache scrutinee)
    [(ResultTcType.Ok scrut-ty)
      (match arms
        [(AstMatchArmList.Nil)
          (ResultTcType.Err "lower: match result type is not fast-pathable")]
        [(AstMatchArmList.Cons arm rest)
          (let
            [rest : AstMatchArmList (box-get rest)]
            (match (lower-match-arm-result-type-fast
              ctx
              env
              type-env
              type-cache
              scrut-ty
              arm)
              [(ResultTcType.Ok first-ty)
                (lower-match-rest-result-types-fast
                  ctx
                  env
                  type-env
                  type-cache
                  scrut-ty
                  rest
                  first-ty)]
              [(ResultTcType.Err message) (ResultTcType.Err message)]))])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-let-binding-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]) : ResultTcType
  (match maybe-ty
    [(AstMaybeType.Some ty)
      (ResultTcType.Ok (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstMaybeType.No)
      (if (tc-ref-capturing-lambda-init? type-env init)
        (match (ast-expr-unspan init)
          [(AstExpr.Lambda lambda-box)
            (match (box-get lambda-box)
              [(AstLambda.Lambda params maybe-ret body-box)
                (let
                  [body : AstExpr (ast-node-get body-box)]
                  (tc-lambda-expr-allow-ref-captures
                    ctx
                    type-env
                    params
                    maybe-ret
                    body))])]
          [_ (lower-expr-result-type-fast ctx env type-env type-cache init)])
        (lower-expr-result-type-fast ctx env type-env type-cache init))]))

(define (lower-let-bindings-type-env-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [bindings : AstLetBindingList]) : ResultTcEnv
  (match bindings
    [(AstLetBindingList.Nil) (ResultTcEnv.Ok type-env)]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name maybe-ty init-box)
            (let
              [name-id : i64 name]
              [init : AstExpr (ast-node-get init-box)]
              (match (lower-let-binding-result-type-fast
                ctx
                env
                type-env
                type-cache
                maybe-ty
                init)
                [(ResultTcType.Ok binding-ty)
                  (lower-let-bindings-type-env-fast
                    ctx
                    (sym_i64_env.sym-i64-bind-id env name-id 0)
                    (tc-bind-c-abi-fnptr-if-needed-id
                      ctx
                      type-env
                      name-id
                      binding-ty
                      init)
                    type-cache
                    rest)]
                [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]))]))

(define (lower-let-bindings-local-env
  [env : sym_i64_env.SymI64Env]
  [bindings : AstLetBindingList]) : sym_i64_env.SymI64Env
  (match bindings
    [(AstLetBindingList.Nil) env]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name _ _)
            (lower-let-bindings-local-env
              (sym_i64_env.sym-i64-bind-id env name 0)
              rest)]))]))

(define (lower-projected-result-type-fast
  [ctx : TcContext]
  [container-ty : AstType]
  [projected-ty : AstType]) : AstType
  (tc-type-without-regions
    (tc-resolve-type
      ctx
      (tc-project-from-region-container container-ty projected-ty))))

(define (lower-index-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [index : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache index)
    [(ResultTcType.Ok index-ty)
      (if (tc-integer-type? index-ty)
        (ResultTcType.Ok index-ty)
        (ResultTcType.Err "lower: index result type is not fast-pathable"))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-unary-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [op : AstUnOp]
  [inner : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache inner)
    [(ResultTcType.Ok inner-ty)
      (match (tc-unop-type op inner-ty)
        [(ResultTcType.Ok result-ty)
          (ResultTcType.Ok
            (tc-type-without-regions (tc-resolve-type ctx result-ty)))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-tuple-ref-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [tuple-expr : AstExpr]
  [index : i64]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache tuple-expr)
    [(ResultTcType.Ok tuple-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx tuple-ty))
        [(AstType.Tuple elem-tys)
          (match (tc-type-list-ref (box-get elem-tys) index)
            [(ResultTcType.Ok elem-ty)
              (ResultTcType.Ok
                (lower-projected-result-type-fast ctx tuple-ty elem-ty))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [_
          (ResultTcType.Err "lower: tuple-ref result type is not fast-pathable")])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-array-ref-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [array-expr : AstExpr]
  [index : AstExpr]) : ResultTcType
  (match (lower-index-result-type-fast ctx env type-env type-cache index)
    [(ResultTcType.Ok _)
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        array-expr)
        [(ResultTcType.Ok array-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
            [(AstType.Array elem-ty _)
              (ResultTcType.Ok
                (lower-projected-result-type-fast
                  ctx
                  array-ty
                  (ty-node-get elem-ty)))]
            [(AstType.DynArray elem-ty)
              (ResultTcType.Ok
                (lower-projected-result-type-fast
                  ctx
                  array-ty
                  (ty-node-get elem-ty)))]
            [_
              (ResultTcType.Err
                "lower: array-ref result type is not fast-pathable")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-string-ref-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [str : AstExpr]
  [index : AstExpr]) : ResultTcType
  (match (lower-index-result-type-fast ctx env type-env type-cache index)
    [(ResultTcType.Ok _)
      (match (lower-expr-result-type-fast ctx env type-env type-cache str)
        [(ResultTcType.Ok str-ty)
          (if (lower-string-handle-type? ctx str-ty)
            (ResultTcType.Ok (AstType.Char))
            (ResultTcType.Err
              "lower: string-ref result type is not fast-pathable"))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-struct-get-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [receiver : AstExpr]
  [field : String]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache receiver)
    [(ResultTcType.Ok receiver-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
        [(AstType.Struct struct-name)
          (match (tc-struct-field-type ctx (intern-str struct-name) field)
            [(ResultTcType.Ok field-ty)
              (ResultTcType.Ok
                (lower-projected-result-type-fast ctx receiver-ty field-ty))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(AstType.StructArgs struct-name lifetimes)
          (match (tc-struct-field-type-with-args
            ctx
            (intern-str struct-name)
            (box-get lifetimes)
            field)
            [(ResultTcType.Ok field-ty)
              (ResultTcType.Ok
                (lower-projected-result-type-fast ctx receiver-ty field-ty))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [_
          (ResultTcType.Err
            "lower: struct-get result type is not fast-pathable")])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-box-get-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [box-expr : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache box-expr)
    [(ResultTcType.Ok box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstType.Box inner-ty)
          (ResultTcType.Ok
            (lower-projected-result-type-fast ctx box-ty (ty-node-get inner-ty)))]
        [_ (ResultTcType.Err "lower: box-get result type is not fast-pathable")])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

;; #2386 (compile-time): memoize lower-expr-result-type-fast by AST node id.
;; lower-expr-origin computes each expr's result type (walking the result-
;; determining spine) BEFORE lowering, and lowering the children re-walks their
;; spines -- so for deeply-nested functions a node's spine is recomputed once per
;; ancestor: O(N^2), the dominant lower-phase cost (single big functions allocated
;; hundreds of MB of transient). The cache is a fixed direct-mapped global array
;; keyed by the spanned node id, validated by a PER-FUNCTION generation counter
;; (tc-rtf-next-gen! is bumped at each lower-function-escaping). The generation
;; makes it both correct (a node's type-env is fixed within its own function) and
;; arena-safe (an entry is only ever read within the same function's lowering,
;; while that function's scratch arena is still live -- the next function bumps
;; the generation, so a stale scratch-allocated type is never read). A slot
;; collision (different id, same slot) misses via the stored-id check.
(define tc-rtf-cap : i64
  1048576)
(define tc-rtf-gen-arr : (Array i64)
  (make-array i64 1048576))
(define tc-rtf-id-arr : (Array i64)
  (make-array i64 1048576))
(define tc-rtf-ty-arr : (Array AstType)
  (make-array AstType 1048576))
(define tc-rtf-current-gen : i64
  0)
(define tc-rtf-filled : bool
  false)

(define (tc-rtf-ensure!) : unit
  (if tc-rtf-filled
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-rtf-cap)
          (begin
            (array-set! tc-rtf-gen-arr i 0)
            (set! i (+ i 1))))
        (set! tc-rtf-filled true)))))

(define (tc-rtf-next-gen!) : unit
  (begin
    (tc-rtf-ensure!)
    (set! tc-rtf-current-gen (+ tc-rtf-current-gen 1))))

(define (lower-expr-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [expr : AstExpr]) : ResultTcType
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [slot : i64 (% inner-box tc-rtf-cap)]
        (if (if (= (array-ref tc-rtf-gen-arr slot) tc-rtf-current-gen)
          (= (array-ref tc-rtf-id-arr slot) inner-box)
          false)
          (ResultTcType.Ok (array-ref tc-rtf-ty-arr slot))
          (match (lower-expr-result-type-fast
            ctx
            env
            type-env
            type-cache
            (ast-node-get inner-box))
            [(ResultTcType.Ok ty)
              (begin
                (array-set! tc-rtf-gen-arr slot tc-rtf-current-gen)
                (array-set! tc-rtf-id-arr slot inner-box)
                (array-set! tc-rtf-ty-arr slot ty)
                (ResultTcType.Ok ty))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])))]
    [(AstExpr.Literal lit) (ResultTcType.Ok (tc-literal-type lit))]
    [(AstExpr.BinaryData _) (ResultTcType.Ok (ast-ty-dyn-array (AstType.U8)))]
    [(AstExpr.SpmdProgramIndex) (ResultTcType.Ok (AstType.I64))]
    [(AstExpr.SpmdProgramCount) (ResultTcType.Ok (AstType.I64))]
    [(AstExpr.Var name)
      (match (lower-lookup-type-id ctx type-cache env type-env name)
        [(ResultTcType.Ok expr-ty)
          (ResultTcType.Ok (tc-type-without-regions expr-ty))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.Some ty)
          (ResultTcType.Ok (tc-type-without-regions (tc-resolve-type ctx ty)))]
        [(AstMaybeType.No)
          (ResultTcType.Err "lower: contextual init requires an expected type")])]
    [(AstExpr.Ann _ ty)
      (ResultTcType.Ok (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstExpr.Cast _ ty)
      (ResultTcType.Ok (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-unary-result-type-fast ctx env type-env type-cache op inner))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (lower-call-result-type-fast ctx env type-env type-cache func args))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (lower-binary-result-type-fast ctx type-env op left right))]
    [(AstExpr.If _ then-branch-box else-branch-box)
      (let
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (lower-if-result-type-fast
          ctx
          env
          type-env
          type-cache
          then-branch
          else-branch))]
    [(AstExpr.Begin exprs)
      (lower-expr-list-result-type-fast ctx env type-env type-cache exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-expr-list-result-type-fast
        ctx
        env
        (tc-enter-unsafe type-env)
        type-cache
        exprs)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (lower-match-result-type-fast
              ctx
              env
              type-env
              type-cache
              scrutinee
              arms))])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (lower-let-bindings-type-env-fast
              ctx
              env
              type-env
              type-cache
              bindings)
              [(ResultTcEnv.Ok body-type-env)
                (lower-expr-result-type-fast
                  ctx
                  (lower-let-bindings-local-env env bindings)
                  body-type-env
                  type-cache
                  body)]
              [(ResultTcEnv.Err message) (ResultTcType.Err message)]))])]
    [(AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : AstExpr (ast-node-get tuple-expr-box)]
        (lower-tuple-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          tuple-expr
          index))]
    [(AstExpr.ArrayRef array-expr-box index-box)
      (let
        [array-expr : AstExpr (ast-node-get array-expr-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-array-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          array-expr
          index))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-string-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          str
          index))]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (lower-struct-get-result-type-fast
          ctx
          env
          type-env
          type-cache
          receiver
          (intern-str field)))]
    [(AstExpr.BoxGet box-expr-box)
      (let
        [box-expr : AstExpr (ast-node-get box-expr-box)]
        (lower-box-get-result-type-fast ctx env type-env type-cache box-expr))]
    [(AstExpr.BoxTake box-expr-box)
      (let
        [box-expr : AstExpr (ast-node-get box-expr-box)]
        (lower-box-get-result-type-fast ctx env type-env type-cache box-expr))]
    [(AstExpr.Set _ _) (ResultTcType.Ok (AstType.Unit))]
    [(AstExpr.StructSet _ _ _) (ResultTcType.Ok (AstType.Unit))]
    [(AstExpr.BoxSet _ _) (ResultTcType.Ok (AstType.Unit))]
    [_ (ResultTcType.Err "lower: expression result type is not fast-pathable")]))

(define (lower-expr-result-type-or-check
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [expr : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache expr)
    [(ResultTcType.Ok expr-ty) (ResultTcType.Ok expr-ty)]
    [(ResultTcType.Err _) (tc-expr ctx type-env expr)]))

(define (lower-index-result-type-or-check
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [index : AstExpr]) : ResultTcType
  (match (lower-index-result-type-fast ctx env type-env type-cache index)
    [(ResultTcType.Ok index-ty) (ResultTcType.Ok index-ty)]
    [(ResultTcType.Err _)
      (match (tc-expr-with-expected-or-actual ctx type-env index (AstType.I64))
        [(ResultTcType.Ok index-ty)
          (if (tc-integer-type? index-ty)
            (ResultTcType.Ok
              (tc-type-without-regions (tc-resolve-type ctx index-ty)))
            (ResultTcType.Err "lower: index result type is not fast-pathable"))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]))

(define (lower-integer-expr-with-expected-or-actual
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [expected-ty : AstType]
  [non-integer-message : String]) : ResultLowerExpr
  (match (tc-expr-with-expected-or-actual ctx type-env expr expected-ty)
    [(ResultTcType.Ok expr-ty)
      (let
        [resolved-ty : AstType
          (tc-type-without-regions (tc-resolve-type ctx expr-ty))]
        (if (tc-integer-type? resolved-ty)
          (lower-expr-expected ctx state env type-env expr resolved-ty expr)
          (ErrLowerExpr
            (box (lower-diagnostic-at-expr expr non-integer-message)))))]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-expr-typechecked
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-expr ctx type-env expr)
    [(ResultTcType.Ok expr-ty)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc-type-without-regions expr-ty))]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-cast-source-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (if (tc-integer-literal-expr? expr)
    (lower-expr-with-type ctx state env type-env expr origin (AstType.I64))
    (lower-expr ctx state env type-env expr)))

;; Lowering runs after full-program typecheck. For result types that are
;; syntactically available, avoid re-running recursive expression typecheck;
;; the fallback below preserves the old path for anything ambiguous.
(define (lower-expr-origin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-expr-origin ctx state env type-env inner origin))]
    [(AstExpr.Literal lit)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc-literal-type lit))]
    [(AstExpr.BinaryData _)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (ast-ty-dyn-array (AstType.U8)))]
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? type-env name)
          (match (tc-dotted-local-field-expr-id type-env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (lower-expr-origin
                ctx
                state
                env
                type-env
                (ast-node-get virtual-id)
                origin)]
            [(ResultTcExprId.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])
          (match (lower-lookup-type-id
            ctx
            (lower-state-type-cache state)
            env
            type-env
            name)
            [(ResultTcType.Ok expr-ty)
              (lower-expr-with-type
                ctx
                state
                env
                type-env
                expr
                origin
                (tc-type-without-regions expr-ty))]
            [(ResultTcType.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])))]
    [(AstExpr.Ann _ ty)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstExpr.Cast _ ty)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (lower-binary-result-type-fast ctx type-env op left right)
          [(ResultTcType.Ok expr-ty)
            (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
          [(ResultTcType.Err _)
            (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (lower-call-result-type-fast
          ctx
          env
          type-env
          (lower-state-type-cache state)
          func
          args)
          [(ResultTcType.Ok expr-ty)
            (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
          [(ResultTcType.Err _)
            (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(OkLowerEnv binding-state body-env body-type-env)
                (lower-expr ctx binding-state body-env body-type-env body)]
              [(ErrLowerEnv message) (ErrLowerExpr message)]))])]
    [(AstExpr.Begin exprs) (lower-begin ctx state env type-env exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-begin ctx state env (tc-enter-unsafe type-env) exprs)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (match (lower-if-result-type-fast
          ctx
          env
          type-env
          (lower-state-type-cache state)
          then-branch
          else-branch)
          [(ResultTcType.Ok expr-ty)
            (lower-if
              ctx
              state
              env
              type-env
              cond
              then-branch
              else-branch
              expr-ty)]
          [(ResultTcType.Err _)
            (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (lower-match-result-type-fast
              ctx
              env
              type-env
              (lower-state-type-cache state)
              scrutinee
              arms)
              [(ResultTcType.Ok expr-ty)
                (lower-match ctx state env type-env scrutinee arms expr-ty)]
              [(ResultTcType.Err _)
                (lower-expr-typechecked ctx state env type-env expr origin)]))])]
    [_
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        (lower-state-type-cache state)
        expr)
        [(ResultTcType.Ok expr-ty)
          (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
        [(ResultTcType.Err _)
          (lower-expr-typechecked ctx state env type-env expr origin)])]))

(define (lower-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : ResultLowerExpr
  (lower-expr-origin ctx state env type-env expr expr))

(define (lower-expr-with-type
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-expr-with-type ctx state env type-env inner origin expr-ty))]
    [(AstExpr.Literal lit)
      (lower-materialize-at-expr
        state
        (lower-literal-value-with-type lit expr-ty)
        expr-ty
        origin)]
    [(AstExpr.BinaryData bytes)
      (lower-materialize-at-expr
        state
        (CompilerIrValue.Bytes bytes)
        expr-ty
        origin)]
    [(AstExpr.SpmdProgramIndex)
      (lower-materialize-at-expr state (CompilerIrValue.I64 0) expr-ty origin)]
    [(AstExpr.SpmdProgramCount)
      (lower-materialize-at-expr state (CompilerIrValue.I64 1) expr-ty origin)]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.Some ty)
          (lower-init-expr ctx state env type-env ty origin expr-ty)]
        [(AstMaybeType.No)
          (lower-init-expr ctx state env type-env expr-ty origin expr-ty)])]
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? type-env name)
          (match (tc-dotted-local-field-expr-id type-env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (lower-expr-with-type
                ctx
                state
                env
                type-env
                (ast-node-get virtual-id)
                origin
                expr-ty)]
            [(ResultTcExprId.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])
          (lower-var-or-nullary-variant-id ctx state env type-env name expr-ty)))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (lower-expr-expected ctx state env type-env inner expr-ty origin)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr inner-state value _)
                (OkLowerExpr (LowerExpr inner-state value expr-ty))])]
          [(ErrLowerExpr message) (ErrLowerExpr message)]))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (lower-cast-source-expr ctx state env type-env inner origin)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr inner-state value inner-ty)
                (OkLowerExpr
                  (lower-cast-value inner-state value inner-ty expr-ty))])]
          [(ErrLowerExpr message) (ErrLowerExpr message)]))]
    [(AstExpr.Borrow _ _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-borrow-expr ctx state env type-env inner origin expr-ty))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (lower-unop-type-with-result ctx type-env op inner expr-ty)
          [(ResultTcType.Ok result-ty)
            (match (tc-unop-contextual-operand-type op result-ty)
              [(AstMaybeType.No)
                (match (lower-expr ctx state env type-env inner)
                  [(OkLowerExpr lowered)
                    (match lowered
                      [(LowerExpr inner-state value _)
                        (match (lower-state-alloc-var inner-state)
                          [(LowerAlloc allocated var-id)
                            (OkLowerExpr
                              (LowerExpr
                                (lower-state-emit-at-expr
                                  allocated
                                  (CompilerIrInstr.UnOp
                                    var-id
                                    (lower-unop op)
                                    value
                                    result-ty)
                                  origin)
                                (CompilerIrValue.Var var-id)
                                result-ty))])])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)])]
              [(AstMaybeType.Some operand-ty)
                (match (lower-expr-expected
                  ctx
                  state
                  env
                  type-env
                  inner
                  operand-ty
                  inner)
                  [(OkLowerExpr lowered)
                    (match lowered
                      [(LowerExpr inner-state value _)
                        (match (lower-state-alloc-var inner-state)
                          [(LowerAlloc allocated var-id)
                            (OkLowerExpr
                              (LowerExpr
                                (lower-state-emit-at-expr
                                  allocated
                                  (CompilerIrInstr.UnOp
                                    var-id
                                    (lower-unop op)
                                    value
                                    result-ty)
                                  origin)
                                (CompilerIrValue.Var var-id)
                                result-ty))])])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)])])]
          [(ResultTcType.Err message)
            (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))]))]
    [(AstExpr.Binary op left-box right-box)
      ;; `and`/`or` short-circuit: desugar to a conditional branch so the right
      ;; operand is evaluated only when the left does not already decide the
      ;; result, matching the Rust lowerer in `src/lower.rs` (#1132 / #1165):
      ;; `(and a b)` -> `(if a b false)`, `(or a b)` -> `(if a true b)`. Every
      ;; other binop evaluates both operands eagerly into an `CompilerIrInstr.BinOp`.
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match op
          [(AstBinOp.And)
            (lower-if
              ctx
              state
              env
              type-env
              left
              right
              (AstExpr.Literal (AstLiteral.Bool false))
              expr-ty)]
          [(AstBinOp.Or)
            (lower-if
              ctx
              state
              env
              type-env
              left
              (AstExpr.Literal (AstLiteral.Bool true))
              right
              expr-ty)]
          [_
            (match (lower-binop-types-with-result
              ctx
              type-env
              op
              left
              right
              expr-ty)
              [(ResultTcBinOpTypes.Ok binop-types)
                (match binop-types
                  [(TcBinOpTypes left-ty right-ty result-ty)
                    (match (lower-expr-expected
                      ctx
                      state
                      env
                      type-env
                      left
                      left-ty
                      left)
                      [(OkLowerExpr left-lowered)
                        (match left-lowered
                          [(LowerExpr left-state left-value _)
                            (match (lower-expr-expected
                              ctx
                              left-state
                              env
                              type-env
                              right
                              right-ty
                              right)
                              [(OkLowerExpr right-lowered)
                                (match right-lowered
                                  [(LowerExpr right-state right-value _)
                                    (if (and
                                      (lower-binop-group-eq? op)
                                      (lower-type-register-group? ctx left-ty))
                                      (lower-group-equality
                                        ctx
                                        right-state
                                        op
                                        left-value
                                        right-value
                                        left-ty
                                        result-ty
                                        origin)
                                      (match (lower-state-alloc-var right-state)
                                        [(LowerAlloc allocated var-id)
                                          (OkLowerExpr
                                            (LowerExpr
                                              (lower-state-emit-at-expr
                                                allocated
                                                (CompilerIrInstr.BinOp
                                                  var-id
                                                  (lower-binop op)
                                                  left-value
                                                  right-value
                                                  result-ty)
                                                origin)
                                              (CompilerIrValue.Var var-id)
                                              result-ty))]))])]
                              [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                      [(ErrLowerExpr message) (ErrLowerExpr message)])])]
              [(ResultTcBinOpTypes.Err message)
                (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])]))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (lower-call ctx state env type-env func args expr-ty origin))]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (lower-lambda
              ctx
              state
              env
              type-env
              params
              maybe-ret
              body
              origin
              expr-ty))])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(OkLowerEnv binding-state body-env body-type-env)
                (lower-expr-expected
                  ctx
                  binding-state
                  body-env
                  body-type-env
                  body
                  expr-ty
                  body)]
              [(ErrLowerEnv message) (ErrLowerExpr message)]))])]
    [(AstExpr.Begin exprs)
      (lower-begin-expected ctx state env type-env exprs expr-ty)]
    [(AstExpr.Unsafe exprs)
      (lower-begin-expected
        ctx
        state
        env
        (tc-enter-unsafe type-env)
        exprs
        expr-ty)]
    [(AstExpr.Set name value-box)
      (let
        [name-id : i64 name]
        [value : AstExpr (ast-node-get value-box)]
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? type-env name)
          (match (tc-dotted-local-field-set-expr-id
            type-env
            name-text
            value-box)
            [(ResultTcExprId.Ok virtual-id)
              (lower-expr-with-type
                ctx
                state
                env
                type-env
                (ast-node-get virtual-id)
                origin
                expr-ty)]
            [(ResultTcExprId.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])
          (match (lower-lookup-type-id
            ctx
            (lower-state-type-cache state)
            env
            type-env
            name-id)
            [(ResultTcType.Ok store-ty)
              (let
                [target-ty : AstType
                  (tc-type-without-regions (tc-resolve-type ctx store-ty))]
                [target-ir-ty : AstType
                  (lower-one-word-register-storage-type ctx target-ty)]
                (match (lower-expr-expected
                  ctx
                  state
                  env
                  type-env
                  value
                  target-ty
                  value)
                  [(OkLowerExpr lowered)
                    (match lowered
                      [(LowerExpr value-state value-ir _)
                        (let
                          [id : i64
                            (sym_i64_env.sym-i64-lookup-id-or
                              env
                              name-id
                              (compiler-symbols-missing-handle))]
                          (if (compiler-symbols-handle-found? id)
                            (let
                              [assign-state
                                : LowerState
                                ;; A rebound aggregate param may point at
                                ;; current-frame storage, so its var id no
                                ;; longer proves tail-call forwarding is safe.
                                (if (and
                                  (lower-state-tail-param-range-contains?
                                    value-state
                                    id)
                                  (lower-type-contains-inline-aggregate?
                                    ctx
                                    target-ty))
                                  (lower-state-clear-tail-param-range
                                    value-state)
                                  value-state)]
                              (OkLowerExpr
                                (LowerExpr
                                  (lower-state-emit-at-expr
                                    assign-state
                                    (CompilerIrInstr.Mov
                                      id
                                      value-ir
                                      target-ir-ty)
                                    origin)
                                  CompilerIrValue.Unit
                                  expr-ty)))
                            (match (lower-return-abi-value
                              ctx
                              value-state
                              value-ir
                              target-ty)
                              [(OkLowerExpr store-copy)
                                (match store-copy
                                  [(LowerExpr store-state store-ir _)
                                    (OkLowerExpr
                                      (LowerExpr
                                        (lower-state-emit-at-expr
                                          store-state
                                          (CompilerIrInstr.Store
                                            (lower-resolve-name
                                              store-state
                                              name-text)
                                            store-ir
                                            target-ir-ty)
                                          origin)
                                        CompilerIrValue.Unit
                                        expr-ty))])]
                              [(ErrLowerExpr message) (ErrLowerExpr message)])))])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)]))]
            [(ResultTcType.Err _)
              (ErrLowerExpr
                (box
                  (lower-diagnostic-at-expr
                    origin
                    (string.append
                      "lower: assignment to unknown local "
                      name-text))))])))]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (lower-if ctx state env type-env cond then-branch else-branch expr-ty))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (lower-while ctx state env type-env cond body))]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (lower-foreach
              ctx
              state
              env
              type-env
              (intern-str index)
              index-ty
              start
              end
              body))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            op
            index
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (lower-spmd-reduce
              ctx
              state
              env
              type-env
              expr-ty
              op
              (intern-str index)
              index-ty
              start
              end
              init
              value))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (lower-spmd-scan
              ctx
              state
              env
              type-env
              op
              (intern-str index)
              index-ty
              start
              end
              (intern-str prefix)
              prefix-ty
              init
              value
              body))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (lower-spmd-broadcast ctx state env type-env value lane))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (lower-spmd-shuffle ctx state env type-env value lane))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (lower-match ctx state env type-env scrutinee arms expr-ty))])]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-string-ref ctx state env type-env str index))]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (lower-struct-get
          ctx
          state
          env
          type-env
          receiver
          (intern-str field)
          expr-ty))]
    [(AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-struct-set
          ctx
          state
          env
          type-env
          receiver
          (intern-str field)
          value
          origin))]
    [(AstExpr.MakeArray elem-ty len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (lower-make-array ctx state env type-env elem-ty len origin))]
    [(AstExpr.Array values)
      (lower-array-literal ctx state env type-env values expr-ty origin)]
    [(AstExpr.ArrayRef arr-box index-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-array-ref ctx state env type-env arr index))]
    [(AstExpr.ArraySet arr-box index-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-array-set ctx state env type-env arr index value))]
    [(AstExpr.ArrayPush arr-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-array-push ctx state env type-env arr value))]
    [(AstExpr.Tuple values)
      (lower-tuple ctx state env type-env values expr-ty origin)]
    [(AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : AstExpr (ast-node-get tuple-expr-box)]
        (lower-tuple-ref ctx state env type-env tuple-expr index expr-ty))]
    [(AstExpr.WithRegion _ body) (lower-with-arena ctx state env type-env body)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (lower-with-escape ctx state env type-env scratch body))]
    [(AstExpr.WithScratch body)
      (lower-with-scratch ctx state env type-env body)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (lower-in-arena ctx state env type-env arena body))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (lower-with-resource ctx state env type-env bindings body)])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-box ctx state env type-env inner expr-ty))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-box-get ctx state env type-env inner expr-ty))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-box-get ctx state env type-env inner expr-ty))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-box-set ctx state env type-env inner value origin))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-try ctx state env type-env inner origin))]
    [(AstExpr.Return value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (lower-return-form ctx state env type-env value origin))]
    ;; `(comptime expr)` folds to a literal via the scalar CTFE evaluator (#719).
    ;; Successful folds reuse the ordinary literal path; CTFE rejections (free
    ;; runtime vars and unsupported CTFE forms surface as lower errors.
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (compiler-ctfe-eval inner (tc-ctfe-env ctx) (ctfe-fuel-limit))
          [(ResultCtfe.Ok value _)
            (match value
              [(CompilerCtfeValue.Type ty)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      (string.append
                        "type value "
                        (string.append
                          (tc-type-render (tc-resolve-type ctx ty))
                          " is compile-time only")))))]
              [(CompilerCtfeValue.String _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "String value is compile-time only")))]
              [(CompilerCtfeValue.Expr _ _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "Expr value is compile-time only")))]
              [(CompilerCtfeValue.ExprList _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprList value is compile-time only")))]
              [(CompilerCtfeValue.ExprClause _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprClause value is compile-time only")))]
              [(CompilerCtfeValue.ExprClauseList _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprClauseList value is compile-time only")))]
              [(CompilerCtfeValue.ExprBindingClause _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprBindingClause value is compile-time only")))]
              [(CompilerCtfeValue.ExprBindingClauseList _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprBindingClauseList value is compile-time only")))]
              [(CompilerCtfeValue.Pattern _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "Pattern value is compile-time only")))]
              [(CompilerCtfeValue.PatternList _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "PatternList value is compile-time only")))]
              [(CompilerCtfeValue.MatchArm _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "MatchArm value is compile-time only")))]
              [(CompilerCtfeValue.MatchArmList _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "MatchArmList value is compile-time only")))]
              [(CompilerCtfeValue.TypeInfo _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeInfo value is compile-time only")))]
              [(CompilerCtfeValue.TypeInfoBox _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeInfo box value is compile-time only")))]
              [(CompilerCtfeValue.TypeInfoList _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeInfoList value is compile-time only")))]
              [(CompilerCtfeValue.TypeField _ _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeField value is compile-time only")))]
              [(CompilerCtfeValue.TypeFieldList _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeFieldList value is compile-time only")))]
              [(CompilerCtfeValue.TypeVariantPayload _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariantPayload value is compile-time only")))]
              [(CompilerCtfeValue.TypeVariantPayloadList _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariantPayloadList value is compile-time only")))]
              [(CompilerCtfeValue.TypeVariant _ _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariant value is compile-time only")))]
              [(CompilerCtfeValue.TypeVariantList _)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariantList value is compile-time only")))]
              [_
                (lower-materialize
                  state
                  (lower-literal-value-with-type
                    (ctfe-value-to-literal-for-type value expr-ty)
                    expr-ty)
                  expr-ty)])]
          [(ResultCtfe.Err diag) (ErrLowerExpr diag)]))]
    [(AstExpr.Quote _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr origin "Expr value is compile-time only")))]
    [(AstExpr.Quasiquote _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr origin "Expr value is compile-time only")))]
    [(AstExpr.Unquote _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "unquote is only valid inside quasiquote")))]
    [(AstExpr.UnquoteSplicing _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "unquote-splicing is only valid inside quasiquote")))]
    [(AstExpr.TypeLiteral ty)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            (string.append
              "type value "
              (string.append
                (tc-type-render (tc-resolve-type ctx ty))
                " is compile-time only")))))]
    ;; `(ptr-null : T)` is a pointer-sized zero (pointer ABI size is 8);
    ;; `(ptr-null? p)` is `p == 0` producing a `bool`. No new IR/asm needed.
    [(AstExpr.PtrNull _)
      (match (lower-materialize state (CompilerIrValue.I64 0) (AstType.U64))
        [(OkLowerExpr lowered)
          (match lowered
            [(LowerExpr null-state null-value _)
              (OkLowerExpr (LowerExpr null-state null-value expr-ty))])]
        [(ErrLowerExpr diag) (ErrLowerExpr diag)])]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (lower-expr ctx state env type-env inner)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr inner-state inner-value _)
                (OkLowerExpr
                  (lower-emit-binop
                    inner-state
                    CompilerIrBinOp.Eq
                    inner-value
                    (CompilerIrValue.I64 0)
                    (AstType.Bool)))])]
          [(ErrLowerExpr diag) (ErrLowerExpr diag)]))]
    [(AstExpr.PtrAddrOf name)
      (let
        [local-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? local-id)
          (match (lower-state-alloc-var state)
            [(LowerAlloc allocated var-id)
              (OkLowerExpr
                (LowerExpr
                  (lower-state-emit-at-expr
                    allocated
                    (CompilerIrInstr.AddrOf var-id local-id)
                    origin)
                  (CompilerIrValue.Var var-id)
                  expr-ty))])
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: ptr-addr-of requires local or parameter storage")))))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr ptr-state ptr-value _)
                (lower-array-elem-ref-result ctx ptr-state ptr-value expr-ty)])]
          [(ErrLowerExpr diag) (ErrLowerExpr diag)]))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(OkLowerExpr ptr-lowered)
            (match ptr-lowered
              [(LowerExpr ptr-state ptr-value ptr-ty)
                ;; Preserve left-to-right evaluation: the value expression may
                ;; lower to calls or other effects, so keep the pointer in its own
                ;; raw pointer temp before lowering the value.
                (match (lower-state-alloc-var ptr-state)
                  [(LowerAlloc ptr-allocated ptr-var)
                    (let
                      [ptr-home-state : LowerState
                        (lower-state-emit
                          ptr-allocated
                          (CompilerIrInstr.Mov
                            ptr-var
                            ptr-value
                            (lower-raw-pointer-ir-type ptr-ty)))]
                      (match (tc-mut-pointer-elem
                        (tc-resolve-type ctx ptr-ty)
                        "lower: ptr-write! requires MutPtr pointer operand")
                        [(ResultTcType.Ok elem-ty)
                          (match (lower-expr-expected
                            ctx
                            ptr-home-state
                            env
                            type-env
                            value
                            (tc-type-without-regions elem-ty)
                            value)
                            [(OkLowerExpr value-lowered)
                              (match value-lowered
                                [(LowerExpr value-state value-ir value-ty)
                                  (OkLowerExpr
                                    (LowerExpr
                                      (lower-state-emit-at-expr
                                        value-state
                                        (CompilerIrInstr.StorePtr
                                          (CompilerIrValue.Var ptr-var)
                                          value-ir
                                          value-ty)
                                        origin)
                                      CompilerIrValue.Unit
                                      expr-ty))])]
                            [(ErrLowerExpr diag) (ErrLowerExpr diag)])]
                        [(ResultTcType.Err message)
                          (ErrLowerExpr
                            (box (lower-diagnostic-at-expr origin message)))]))])])]
          [(ErrLowerExpr diag) (ErrLowerExpr diag)]))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(OkLowerExpr ptr-lowered)
            (match ptr-lowered
              [(LowerExpr ptr-state ptr-value ptr-ty)
                (match (lower-expr-expected
                  ctx
                  ptr-state
                  env
                  type-env
                  offset
                  (AstType.I64)
                  offset)
                  [(OkLowerExpr offset-lowered)
                    (match offset-lowered
                      [(LowerExpr offset-state offset-value _)
                        (match (tc-type-strip-region
                          (tc-resolve-type ctx ptr-ty))
                          [(AstType.Ptr elem-ty)
                            (match (lower-emit-elem-addr-gep
                              ctx
                              offset-state
                              ptr-value
                              offset-value
                              (ty-node-get elem-ty))
                              [(LowerExpr gep-state gep-value _)
                                (OkLowerExpr
                                  (LowerExpr gep-state gep-value expr-ty))])]
                          [(AstType.MutPtr elem-ty)
                            (match (lower-emit-elem-addr-gep
                              ctx
                              offset-state
                              ptr-value
                              offset-value
                              (ty-node-get elem-ty))
                              [(LowerExpr gep-state gep-value _)
                                (OkLowerExpr
                                  (LowerExpr gep-state gep-value expr-ty))])]
                          [_
                            (ErrLowerExpr
                              (box
                                (lower-diagnostic-at-expr
                                  origin
                                  "lower: ptr-offset requires raw pointer")))])])]
                  [(ErrLowerExpr diag) (ErrLowerExpr diag)])])]
          [(ErrLowerExpr diag) (ErrLowerExpr diag)]))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr ptr-state ptr-value ptr-ty)
                (OkLowerExpr
                  (lower-cast-value ptr-state ptr-value ptr-ty expr-ty))])]
          [(ErrLowerExpr diag) (ErrLowerExpr diag)]))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr ptr-state ptr-value ptr-ty)
                (OkLowerExpr
                  (lower-cast-value ptr-state ptr-value ptr-ty expr-ty))])]
          [(ErrLowerExpr diag) (ErrLowerExpr diag)]))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (match (lower-expr ctx state env type-env value)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr value-state value-ir value-ty)
                (OkLowerExpr
                  (lower-cast-value value-state value-ir value-ty expr-ty))])]
          [(ErrLowerExpr diag) (ErrLowerExpr diag)]))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (lower-string-data ctx state env type-env str expr-ty))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (lower-string-from-bytes ctx state env type-env ptr len))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (lower-array-data ctx state env type-env array expr-ty))]
    [(AstExpr.ProgramArgc) (lower-entry-load state 0 expr-ty)]
    [(AstExpr.ProgramArgv) (lower-entry-load state 1 expr-ty)]
    [(AstExpr.ProgramEnvp) (lower-entry-load state 2 expr-ty)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 0))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 1))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 2))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 3))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (lower-xgetbv ctx state env type-env index))]
    [(AstExpr.Syscall args) (lower-syscall ctx state env type-env args)]
    [_
      (ErrLowerExpr
        (box (lower-diagnostic-at-expr origin "lower: unsupported expression")))]))

(define (lower-expr-with-type-and-coerce
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]
  [expected-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-with-type ctx state env type-env expr origin expr-ty)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr next-state value actual-ty)
          (OkLowerExpr
            (lower-coerce-value next-state value actual-ty expected-ty))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-expr-and-coerce
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [expected-ty : AstType]) : ResultLowerExpr
  (match (tc-expr-with-expected-or-actual ctx type-env expr expected-ty)
    [(ResultTcType.Ok actual-ty)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        expr
        (tc-type-without-regions (tc-resolve-type ctx actual-ty))
        expected-ty)]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-expr-expected
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [expected-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-expr-expected ctx state env type-env inner expected-ty origin))]
    [(AstExpr.Literal lit)
      (lower-materialize-at-expr
        state
        (lower-literal-value-with-type lit expected-ty)
        expected-ty
        origin)]
    [(AstExpr.Unary _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Binary _ _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Let _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Begin _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Unsafe _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Array _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Tuple _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (lower-if
          ctx
          state
          env
          type-env
          cond
          then-branch
          else-branch
          expected-ty))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (lower-match ctx state env type-env scrutinee arms expected-ty))])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-box ctx state env type-env inner expected-ty))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-box-get ctx state env type-env inner expected-ty))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-box-get ctx state env type-env inner expected-ty))]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.No)
          (lower-init-expr
            ctx
            state
            env
            type-env
            expected-ty
            origin
            expected-ty)]
        [(AstMaybeType.Some _)
          (lower-expr-and-coerce ctx state env type-env expr expected-ty)])]
    [(AstExpr.Call func-box _)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (ast-expr-unspan func)
          [(AstExpr.Var name)
            (match (lower-lookup-type
              ctx
              (lower-state-type-cache state)
              env
              type-env
              (intern-str name))
              [(ResultTcType.Ok fn-ty)
                (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
                  [(AstType.Func _ ret-ty)
                    (let
                      [actual-ty : AstType
                        (tc-type-without-regions
                          (tc-resolve-type ctx (ty-node-get ret-ty)))]
                      [expected-resolved : AstType
                        (tc-type-without-regions
                          (tc-resolve-type ctx expected-ty))]
                      (if (tc-type-eq actual-ty expected-resolved)
                        (lower-expr-with-type-and-coerce
                          ctx
                          state
                          env
                          type-env
                          expr
                          origin
                          actual-ty
                          expected-ty)
                        (lower-expr-and-coerce
                          ctx
                          state
                          env
                          type-env
                          expr
                          expected-ty)))]
                  [_
                    (lower-expr-and-coerce
                      ctx
                      state
                      env
                      type-env
                      expr
                      expected-ty)])]
              [(ResultTcType.Err _)
                (lower-expr-and-coerce ctx state env type-env expr expected-ty)])]
          [_ (lower-expr-and-coerce ctx state env type-env expr expected-ty)]))]
    [_ (lower-expr-and-coerce ctx state env type-env expr expected-ty)]))

(define (lower-struct-get-named
  [ctx : TcContext]
  [state : LowerState]
  [receiver-value : CompilerIrValue]
  [struct-name : String]
  [field : String]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-struct-field-info-for-mode
    ctx
    (lower-state-mode state)
    struct-name
    field)
    [(OkLowerFieldInfo info)
      (match info
        [(LowerFieldInfo offset field-ty)
          ;; #2386: when the receiver is a register-resident struct, its value is
          ;; the packed word itself; extract the field with shift/mask instead of
          ;; computing an address and loading from memory.
          (if (tc-name-register-resident? ctx struct-name)
            (if (lower-type-register-group?
              ctx
              (AstType.Struct (intern struct-name)))
              ;; 2-word register-group receiver: select the field's word with
              ;; CompilerIrInstr.Word, then shift/mask within that word at its relative
              ;; offset.
              (match (lower-emit-word
                state
                receiver-value
                (/ offset 8)
                (lower-register-word-type
                  ctx
                  (AstType.Struct (intern struct-name))
                  (/ offset 8)))
                [(LowerExpr w-state w-value _)
                  (match (lower-extract-word-field
                    ctx
                    w-state
                    w-value
                    (lower-register-word-type
                      ctx
                      (AstType.Struct (intern struct-name))
                      (/ offset 8))
                    (- offset (* (/ offset 8) 8))
                    field-ty)
                    [(LowerExpr ext-state ext-value _)
                      (OkLowerExpr (LowerExpr ext-state ext-value result-ty))])])
              (match (lower-extract-word-field
                ctx
                state
                receiver-value
                (lower-register-word-type
                  ctx
                  (AstType.Struct (intern struct-name))
                  0)
                offset
                field-ty)
                [(LowerExpr ext-state ext-value _)
                  (OkLowerExpr (LowerExpr ext-state ext-value result-ty))]))
            (match (lower-gep-byte state receiver-value offset)
              [(LowerExpr ptr-state ptr _)
                ;; #2386: a register-resident field is carried as a packed word,
                ;; so its value is the LOADED word, never the field address --
                ;; exclude it from the in-place pointer-return shape (otherwise a
                ;; later `match`/`=` would read the address as if it were the tag).
                ;; A genuine memory aggregate field still returns its in-place
                ;; pointer. This mirrors `lower-load-inline-value-at-offset`.
                (cond
                  [(and
                      (not (lower-type-register-resident? ctx field-ty))
                      (or
                        (and
                          (lower-struct-repr-c? ctx struct-name)
                          (lower-repr-c-inline-field? ctx field-ty))
                        (and
                          (lower-mode-inline-aggregates?
                            (lower-state-mode ptr-state))
                          (lower-type-inline-storage? ctx field-ty))))
                    (OkLowerExpr (LowerExpr ptr-state ptr result-ty))]
                  [(lower-type-register-group? ctx field-ty)
                    (match (lower-load-group-from-ptr
                      ctx
                      ptr-state
                      ptr
                      field-ty)
                      [(LowerExpr g-state g-value _)
                        (OkLowerExpr (LowerExpr g-state g-value result-ty))])]
                  [(lower-type-register-resident? ctx field-ty)
                    (match (lower-state-alloc-var ptr-state)
                      [(LowerAlloc allocated var-id)
                        (OkLowerExpr
                          (LowerExpr
                            (lower-state-emit
                              allocated
                              (CompilerIrInstr.Load
                                var-id
                                ptr
                                (lower-register-word-type ctx field-ty 0)))
                            (CompilerIrValue.Var var-id)
                            result-ty))])]
                  [else
                    (match (lower-state-alloc-var ptr-state)
                      [(LowerAlloc allocated var-id)
                        (OkLowerExpr
                          (LowerExpr
                            (lower-state-emit
                              allocated
                              (CompilerIrInstr.Load var-id ptr field-ty))
                            (CompilerIrValue.Var var-id)
                            result-ty))])])]))])]
    [(ErrLowerFieldInfo message) (ErrLowerExpr message)]))

(define (lower-struct-get-through-reference
  [ctx : TcContext]
  [state : LowerState]
  [receiver-value : CompilerIrValue]
  [referent-ty : AstType]
  [struct-name : String]
  [field : String]
  [result-ty : AstType]) : ResultLowerExpr
  (match (if (lower-type-register-resident? ctx referent-ty)
    (lower-load-register-resident-from-ptr ctx state receiver-value referent-ty)
    (LowerExpr state receiver-value referent-ty))
    [(LowerExpr value-state value _)
      (lower-struct-get-named ctx value-state value struct-name field result-ty)]))

(define (lower-struct-get
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [receiver : AstExpr]
  [field : String]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env receiver)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr receiver-state receiver-value receiver-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
            [(AstType.Struct struct-name)
              (lower-struct-get-named
                ctx
                receiver-state
                receiver-value
                (intern-str struct-name)
                field
                result-ty)]
            [(AstType.StructArgs struct-name _)
              (lower-struct-get-named
                ctx
                receiver-state
                receiver-value
                (intern-str struct-name)
                field
                result-ty)]
            [(AstType.Ref _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (ty-node-get referent-ty)))
                [(AstType.Struct struct-name)
                  (lower-struct-get-through-reference
                    ctx
                    receiver-state
                    receiver-value
                    (ty-node-get referent-ty)
                    (intern-str struct-name)
                    field
                    result-ty)]
                [(AstType.StructArgs struct-name _)
                  (lower-struct-get-through-reference
                    ctx
                    receiver-state
                    receiver-value
                    (ty-node-get referent-ty)
                    (intern-str struct-name)
                    field
                    result-ty)]
                [_
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        receiver
                        "lower: struct-get requires struct")))])]
            [(AstType.MutRef _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (ty-node-get referent-ty)))
                [(AstType.Struct struct-name)
                  (lower-struct-get-through-reference
                    ctx
                    receiver-state
                    receiver-value
                    (ty-node-get referent-ty)
                    (intern-str struct-name)
                    field
                    result-ty)]
                [(AstType.StructArgs struct-name _)
                  (lower-struct-get-through-reference
                    ctx
                    receiver-state
                    receiver-value
                    (ty-node-get referent-ty)
                    (intern-str struct-name)
                    field
                    result-ty)]
                [_
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        receiver
                        "lower: struct-get requires struct")))])]
            [_
              (ErrLowerExpr
                (box
                  (lower-diagnostic-at-expr
                    receiver
                    "lower: struct-get requires struct")))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

;; Lower `(box expr)` (#1443): evaluate `expr`, reserve arena storage sized for
;; its (pointer-shaped) value via `tl_alloc`, store the value at offset 0, and
;; return the box handle (the storage pointer) typed as the `(Box T)` result.
(define (lower-box
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (tc-box-set-inner-type ctx result-ty)
    [(ResultTcType.Ok expected-inner-ty)
      (match (lower-expr-expected
        ctx
        state
        env
        type-env
        inner
        (tc-type-without-regions expected-inner-ty)
        inner)
        [(OkLowerExpr lowered)
          (match lowered
            [(LowerExpr inner-state inner-value inner-ty)
              (match (lower-reserve-heap-storage
                inner-state
                (lower-type-size ctx inner-ty)
                result-ty)
                [(LowerExpr base-state base _)
                  ;; #2386: a register-resident inner value is a word; store it
                  ;; scalar into the box rather than byte-copying from a pointer.
                  (if (and
                    (lower-type-inline-storage? ctx inner-ty)
                    (not (lower-type-register-resident? ctx inner-ty)))
                    (match (lower-inline-aggregate-copy-size ctx inner-ty)
                      [(OkLowerSize size)
                        (OkLowerExpr
                          (LowerExpr
                            (lower-copy-bytes
                              base-state
                              base
                              0
                              inner-value
                              0
                              size)
                            base
                            result-ty))]
                      [(ErrLowerSize message)
                        (ErrLowerExpr (box (lower-diagnostic message)))])
                    (if (lower-type-register-group? ctx inner-ty)
                      (OkLowerExpr
                        (LowerExpr
                          (lower-store-group-at-ptr
                            ctx
                            base-state
                            base
                            inner-value
                            inner-ty)
                          base
                          result-ty))
                      (OkLowerExpr
                        (LowerExpr
                          (lower-store-at-offset
                            base-state
                            base
                            0
                            inner-value
                            inner-ty)
                          base
                          result-ty))))])])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr inner message)))]))

;; Lower `(box-get b)` (#1443): evaluate the box handle and load the boxed value
;; of type `T` (the result type) from offset 0 of the box storage.
(define (lower-box-get
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    state
    env
    type-env
    inner
    (ast-ty-box result-ty)
    inner)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr box-state box-value _)
          ;; #1867: when the boxed value is an inline aggregate, the box pointer
          ;; already addresses the T storage, so box-get yields that pointer
          ;; (offset 0) rather than scalar-loading the first 8 bytes (which would
          ;; read only the leading word, e.g. an enum tag, and treat it as the
          ;; whole value). Scalars still load. Mirrors lower-struct-get.
          (OkLowerExpr
            (lower-load-inline-value-at-offset
              ctx
              box-state
              box-value
              0
              result-ty
              (lower-state-mode box-state)))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-box-storage-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [box-expr : AstExpr]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    box-expr)
    [(ResultTcType.Ok box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstType.Box _)
          (match (lower-expr ctx state env type-env box-expr)
            [(OkLowerExpr lowered)
              (match lowered
                [(LowerExpr box-state box-value _)
                  (OkLowerExpr (LowerExpr box-state box-value result-ty))])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])]
        [(AstType.Ref _ _)
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: box-get requires Box storage")))]
        [_
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: box-get requires Box type")))])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr box-expr message)))]))

;; Locate the byte offset and resolved type of tuple element `target` within the
;; element-type list, laying fields out exactly like a struct over those types
;; (each field aligned to its own alignment). Mirrors `lower-field-info-from-list`
;; but indexes by position rather than name.
(define (lower-tuple-elem-info
  [ctx : TcContext]
  [types : AstTypeList]
  [target : i64]
  [index : i64]
  [cursor : i64]) : ResultLowerFieldInfo
  (match types
    [(AstTypeList.Nil)
      (ErrLowerFieldInfo
        (box (lower-diagnostic "lower: tuple-ref index out of range")))]
    [(AstTypeList.Cons ty rest)
      (let
        [ty : AstType (ty-node-get ty)]
        [rest : AstTypeList (box-get rest)]
        [resolved : AstType (tc-resolve-type ctx ty)]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        (if (= index target)
          (OkLowerFieldInfo (LowerFieldInfo offset resolved))
          (lower-tuple-elem-info
            ctx
            rest
            target
            (+ index 1)
            (+ offset (lower-type-size ctx resolved)))))]))

;; Evaluate each tuple element (preserving side effects even for zero-sized
;; elements) and store the sized ones into the aggregate at their field offset,
;; threading the lowering state. Mirrors the per-field store loop of `lower-box`
;; generalized over the element-type list.
(define (lower-tuple-store-elems
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [values : AstExprList]
  [types : AstTypeList]
  [cursor : i64]) : ResultLowerState
  (match values
    [(AstExprList.Nil) (OkLowerState state)]
    [(AstExprList.Cons value rest-values)
      (let
        [value : AstExpr (ast-node-get value)]
        [rest-values : AstExprList (box-get rest-values)]
        (match types
          [(AstTypeList.Nil)
            (ErrLowerState
              (box (lower-diagnostic "lower: tuple arity mismatch")))]
          [(AstTypeList.Cons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              [resolved : AstType (tc-resolve-type ctx ty)]
              [offset : i64
                (lower-align-up cursor (lower-type-align ctx resolved))]
              [size : i64 (lower-type-size ctx resolved)]
              (match (lower-expr-expected
                ctx
                state
                env
                type-env
                value
                resolved
                value)
                [(OkLowerExpr lowered)
                  (match lowered
                    [(LowerExpr elem-state elem-value _)
                      (lower-tuple-store-elems
                        ctx
                        (if (> size 0)
                          (lower-store-inline-value-at-offset
                            ctx
                            elem-state
                            base
                            offset
                            elem-value
                            resolved
                            size)
                          elem-state)
                        env
                        type-env
                        base
                        rest-values
                        rest-types
                        (+ offset size))])]
                [(ErrLowerExpr message) (ErrLowerState message)]))]))]))

;; Lower `(tuple v0 v1 ...)`: reserve struct-shaped aggregate storage for the
;; element types, store each element at its field offset, and return the storage
;; pointer typed as the tuple. The tuple value is pointer-shaped (size 8), like a
;; struct/box handle. Mirrors `src/lower.rs` `lower_tuple`.
(define (lower-tuple
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [values : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-resolve-type ctx result-ty)
    [(AstType.Tuple elem-tys)
      (match (lower-reserve-heap-storage
        state
        (lower-type-list-storage-size ctx (box-get elem-tys))
        result-ty)
        [(LowerExpr base-state base _)
          (match (lower-tuple-store-elems
            ctx
            base-state
            env
            type-env
            base
            values
            (box-get elem-tys)
            0)
            [(OkLowerState final-state)
              (OkLowerExpr (LowerExpr final-state base result-ty))]
            [(ErrLowerState message) (ErrLowerExpr message)])])]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr origin "lower: tuple requires tuple type")))]))

;; Evaluate each fixed-array-literal element (preserving side effects even for
;; zero-sized elements) and store the sized ones at `index * elem-size` into the
;; reserved inline storage, threading the lowering state. Mirrors
;; `lower-tuple-store-elems`, specialized to a single homogeneous element type.
(define (lower-array-literal-store-elems
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [values : AstExprList]
  [elem-ty : AstType]
  [elem-size : i64]
  [offset : i64]) : ResultLowerState
  (match values
    [(AstExprList.Nil) (OkLowerState state)]
    [(AstExprList.Cons value rest-values)
      (let
        [value : AstExpr (ast-node-get value)]
        [rest-values : AstExprList (box-get rest-values)]
        (if (> elem-size 0)
          (match (lower-direct-store-rhs-at-offset
            ctx
            state
            env
            type-env
            base
            offset
            value
            elem-ty
            value)
            [(LowerDirectStore elem-state)
              (lower-array-literal-store-elems
                ctx
                elem-state
                env
                type-env
                base
                rest-values
                elem-ty
                elem-size
                (+ offset elem-size))]
            [(LowerDirectStoreErr message) (ErrLowerState message)]
            [(LowerNoDirectStore)
              (match (lower-expr-expected
                ctx
                state
                env
                type-env
                value
                elem-ty
                value)
                [(OkLowerExpr lowered)
                  (match lowered
                    [(LowerExpr elem-state elem-value _)
                      (lower-array-literal-store-elems
                        ctx
                        (lower-store-inline-value-at-offset
                          ctx
                          elem-state
                          base
                          offset
                          elem-value
                          elem-ty
                          elem-size)
                        env
                        type-env
                        base
                        rest-values
                        elem-ty
                        elem-size
                        (+ offset elem-size))])]
                [(ErrLowerExpr message) (ErrLowerState message)])])
          (match (lower-expr-expected
            ctx
            state
            env
            type-env
            value
            elem-ty
            value)
            [(OkLowerExpr lowered)
              (match lowered
                [(LowerExpr elem-state _ _)
                  (lower-array-literal-store-elems
                    ctx
                    elem-state
                    env
                    type-env
                    base
                    rest-values
                    elem-ty
                    elem-size
                    (+ offset elem-size))])]
            [(ErrLowerExpr message) (ErrLowerState message)])))]))

;; Lower `(array v0 v1 ...)`: reserve inline storage for `count` elements of the
;; element type, store each element at `index * elem-size`, and return the
;; storage pointer typed as the fixed array. A fixed-array value is pointer-
;; shaped (a pointer to inline storage), matching `array-ref`/`array-set!`, which
;; index off the same base. Mirrors `src/lower.rs` `lower_array_literal`.
(define (lower-array-literal
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [values : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-resolve-type ctx result-ty)
    [(AstType.Array elem-ty count)
      (let
        [resolved-elem : AstType (tc-resolve-type ctx (ty-node-get elem-ty))]
        [elem-size : i64 (lower-type-size ctx (ty-node-get elem-ty))]
        [storage-size : i64 (lower-type-size ctx result-ty)]
        (match (lower-reserve-inline-storage state storage-size result-ty)
          [(LowerExpr base-state base _)
            (match (lower-array-literal-store-elems
              ctx
              base-state
              env
              type-env
              base
              values
              resolved-elem
              elem-size
              0)
              [(OkLowerState final-state)
                (OkLowerExpr (LowerExpr final-state base result-ty))]
              [(ErrLowerState message) (ErrLowerExpr message)])]))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: array literal requires fixed-array type")))]))

;; Lower `(tuple-ref t i)`: evaluate the tuple, compute element `i`'s offset, and
;; load it (returning the unit value for a zero-sized element, which was never
;; stored). Mirrors `src/lower.rs` `lower_tuple_ref`.
(define (lower-tuple-ref
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [tuple-expr : AstExpr]
  [index : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env tuple-expr)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr tuple-state tuple-value tuple-ty)
          (match (tc-resolve-type ctx tuple-ty)
            [(AstType.Tuple elem-tys)
              (match (lower-tuple-elem-info ctx (box-get elem-tys) index 0 0)
                [(OkLowerFieldInfo info)
                  (match info
                    [(LowerFieldInfo offset elem-ty)
                      (if (> (lower-type-size ctx elem-ty) 0)
                        (match (lower-load-inline-value-at-offset
                          ctx
                          tuple-state
                          tuple-value
                          offset
                          elem-ty
                          (lower-state-mode tuple-state))
                          [(LowerExpr load-state load-value _)
                            (OkLowerExpr
                              (LowerExpr load-state load-value result-ty))])
                        (OkLowerExpr
                          (LowerExpr tuple-state CompilerIrValue.Unit result-ty)))])]
                [(ErrLowerFieldInfo message) (ErrLowerExpr message)])]
            [_
              (ErrLowerExpr
                (box
                  (lower-diagnostic-at-expr
                    tuple-expr
                    "lower: tuple-ref requires tuple")))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-string-ref-byte
  [state : LowerState]
  [data-ptr : CompilerIrValue]
  [index-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc gep-alloc gep-var)
      (let
        [gep-state : LowerState
          (lower-state-emit
            gep-alloc
            (CompilerIrInstr.Gep gep-var data-ptr index-value (AstType.Char)))]
        (match (lower-state-alloc-var gep-state)
          [(LowerAlloc load-alloc load-var)
            (OkLowerExpr
              (LowerExpr
                (lower-state-emit
                  load-alloc
                  (CompilerIrInstr.Load
                    load-var
                    (CompilerIrValue.Var gep-var)
                    (AstType.Char)))
                (CompilerIrValue.Var load-var)
                (AstType.Char)))]))]))

(define (lower-string-ref-load
  [state : LowerState]
  [str-value : CompilerIrValue]
  [index-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state str-value)
    [(LowerStringFields fields-state data-ptr str-len)
      (match (lower-cast-value
        fields-state
        index-value
        (AstType.I64)
        (AstType.U64))
        [(LowerExpr index-u-state index-u _)
          (match (lower-cast-value
            index-u-state
            str-len
            (AstType.I64)
            (AstType.U64))
            [(LowerExpr len-u-state len-u _)
              (match (lower-state-fresh-label len-u-state "str_bounds_ok")
                [(LowerLabel bounds-ok-state bounds-ok-label)
                  (lower-string-ref-byte
                    (lower-state-emit
                      bounds-ok-state
                      (CompilerIrInstr.BoundsCheck
                        index-u
                        len-u
                        bounds-ok-label))
                    data-ptr
                    index-value)])])])]))

(define (lower-string-ref
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [str : AstExpr]
  [index : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env str)
    [(OkLowerExpr lowered-str)
      (match lowered-str
        [(LowerExpr str-state str-value str-ty)
          (if (lower-string-handle-type? ctx str-ty)
            (match (lower-integer-expr-with-expected-or-actual
              ctx
              str-state
              env
              type-env
              index
              (AstType.I64)
              "lower: string index must be integer")
              [(OkLowerExpr lowered-index)
                (match lowered-index
                  [(LowerExpr index-state index-raw index-ty)
                    (match (lower-cast-value
                      index-state
                      index-raw
                      index-ty
                      (AstType.I64))
                      [(LowerExpr index-i-state index-value _)
                        (lower-string-ref-load
                          index-i-state
                          str-value
                          index-value)])])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  str
                  "lower: string-ref requires String"))))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-substring-call-runtime
  [state : LowerState]
  [src-ptr : CompilerIrValue]
  [start-value : CompilerIrValue]
  [len-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (OkLowerExpr
        (LowerExpr
          (lower-state-emit
            allocated
            (CompilerIrInstr.Call
              var-id
              "tl_substring"
              (compiler-ir-call-args-from-list
                (compiler-ir-value-cons
                  src-ptr
                  (compiler-ir-value-cons
                    start-value
                    (compiler-ir-value-cons len-value IrValueNil))))
              (AstType.String)))
          (CompilerIrValue.Var var-id)
          (AstType.String)))]))

(define (lower-substring-finish-after-len-check
  [state : LowerState]
  [src-ptr : CompilerIrValue]
  [start-value : CompilerIrValue]
  [len-value : CompilerIrValue]
  [len-ok-var : i64]
  [fail-label : String]
  [copy-label : String]) : ResultLowerExpr
  (let
    [fail-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          state
          (CompilerIrInstr.Branch
            (CompilerIrValue.Var len-ok-var)
            copy-label
            fail-label))
        fail-label)]
    [copy-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (CompilerIrInstr.Jump copy-label))
        copy-label)]
    (lower-substring-call-runtime copy-start src-ptr start-value len-value)))

(define (lower-substring-check-len
  [state : LowerState]
  [src-ptr : CompilerIrValue]
  [src-len : CompilerIrValue]
  [start-value : CompilerIrValue]
  [len-value : CompilerIrValue]
  [fail-label : String]
  [copy-label : String]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc rem-alloc rem-var)
      (let
        [rem-state : LowerState
          (lower-state-emit
            rem-alloc
            (CompilerIrInstr.BinOp
              rem-var
              CompilerIrBinOp.Sub
              src-len
              start-value
              (AstType.I64)))]
        (match (lower-cast-value
          rem-state
          (CompilerIrValue.Var rem-var)
          (AstType.I64)
          (AstType.U64))
          [(LowerExpr rem-u-state rem-u _)
            (match (lower-cast-value
              rem-u-state
              len-value
              (AstType.I64)
              (AstType.U64))
              [(LowerExpr len-u-state len-u _)
                (match (lower-state-alloc-var len-u-state)
                  [(LowerAlloc len-ok-alloc len-ok-var)
                    (let
                      [len-ok-state : LowerState
                        (lower-state-emit
                          len-ok-alloc
                          (CompilerIrInstr.BinOp
                            len-ok-var
                            CompilerIrBinOp.Le
                            len-u
                            rem-u
                            (AstType.U64)))]
                      (lower-substring-finish-after-len-check
                        len-ok-state
                        src-ptr
                        start-value
                        len-value
                        len-ok-var
                        fail-label
                        copy-label))])])]))]))

(define (lower-substring-bounds-checked
  [state : LowerState]
  [src-ptr : CompilerIrValue]
  [src-len : CompilerIrValue]
  [start-value : CompilerIrValue]
  [len-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-cast-value state start-value (AstType.I64) (AstType.U64))
    [(LowerExpr start-u-state start-u _)
      (match (lower-cast-value
        start-u-state
        src-len
        (AstType.I64)
        (AstType.U64))
        [(LowerExpr src-len-u-state src-len-u _)
          (match (lower-state-alloc-var src-len-u-state)
            [(LowerAlloc start-ok-alloc start-ok-var)
              (let
                [start-ok-state : LowerState
                  (lower-state-emit
                    start-ok-alloc
                    (CompilerIrInstr.BinOp
                      start-ok-var
                      CompilerIrBinOp.Le
                      start-u
                      src-len-u
                      (AstType.U64)))]
                (match (lower-state-fresh-label
                  start-ok-state
                  "substr_start_ok")
                  [(LowerLabel rem-label-state rem-label)
                    (match (lower-state-fresh-label
                      rem-label-state
                      "substr_bounds_fail")
                      [(LowerLabel fail-label-state fail-label)
                        (match (lower-state-fresh-label
                          fail-label-state
                          "substr_ok")
                          [(LowerLabel copy-label-state copy-label)
                            (let
                              [rem-start : LowerState
                                (lower-state-finish-block
                                  (lower-state-emit
                                    copy-label-state
                                    (CompilerIrInstr.Branch
                                      (CompilerIrValue.Var start-ok-var)
                                      rem-label
                                      fail-label))
                                  rem-label)]
                              (lower-substring-check-len
                                rem-start
                                src-ptr
                                src-len
                                start-value
                                len-value
                                fail-label
                                copy-label))])])]))])])]))

(define (lower-substring
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [str : AstExpr]
  [start : AstExpr]
  [len : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env str)
    [(OkLowerExpr lowered-str)
      (match lowered-str
        [(LowerExpr str-state str-value str-ty)
          (if (lower-string-handle-type? ctx str-ty)
            (match (lower-string-fields str-state str-value)
              [(LowerStringFields fields-state src-ptr src-len)
                (match (lower-integer-expr-with-expected-or-actual
                  ctx
                  fields-state
                  env
                  type-env
                  start
                  (AstType.I64)
                  "lower: substring start must be integer")
                  [(OkLowerExpr lowered-start)
                    (match lowered-start
                      [(LowerExpr start-state start-raw start-ty)
                        (match (lower-cast-value
                          start-state
                          start-raw
                          start-ty
                          (AstType.I64))
                          [(LowerExpr start-i-state start-value _)
                            (match (lower-integer-expr-with-expected-or-actual
                              ctx
                              start-i-state
                              env
                              type-env
                              len
                              (AstType.I64)
                              "lower: substring length must be integer")
                              [(OkLowerExpr lowered-len)
                                (match lowered-len
                                  [(LowerExpr len-state len-raw len-ty)
                                    (match (lower-cast-value
                                      len-state
                                      len-raw
                                      len-ty
                                      (AstType.I64))
                                      [(LowerExpr len-i-state len-value _)
                                        (lower-substring-bounds-checked
                                          len-i-state
                                          src-ptr
                                          src-len
                                          start-value
                                          len-value)])])]
                              [(ErrLowerExpr message) (ErrLowerExpr message)])])])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)])])
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  str
                  "lower: substring requires String"))))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-string-concat
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [left : AstExpr]
  [right : AstExpr]) : ResultLowerExpr
  (lower-string-concat-exprs
    ctx
    state
    env
    type-env
    (lower-string-concat-exprs-right ctx env left right 5)))

(define (lower-c-abi-runtime-handle-extern? [name : String]) : bool
  (or
    (lower-string-prefix-at? name "tl_" 0)
    (lower-string-prefix-at? name ".L_tl_" 0)))

(define (lower-c-abi-extern-call?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : String]) : bool
  (cond
    [(not (lower-mode-c-abi? (lower-state-mode state))) false]
    [(sym_i64_env.sym-i64-contains env name) false]
    [(lower-c-abi-runtime-handle-extern? name) false]
    [else
      (let
        [handle : i64
          (lower-symbols-lookup-value-hygiene (tc-context-symbols ctx) name)]
        (and
          (compiler-symbols-handle-found? handle)
          (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern))
          (lower-extern-function-decl? ctx name)))]))

(define (lower-c-abi-extern-value-call?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : String]) : bool
  (cond
    [(not (lower-mode-c-abi? (lower-state-mode state))) false]
    [(sym_i64_env.sym-i64-contains env name) false]
    [(lower-c-abi-runtime-handle-extern? name) false]
    [else (lower-extern-value-decl? ctx name)]))

(define (lower-c-abi-integer-field-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [_ false]))

(define (lower-c-abi-inline-fields-integer-only?
  [ctx : TcContext]
  [fields : TcInlineFieldLayoutList]) : bool
  (match fields
    [(TcInlineFieldLayoutList.Nil) true]
    [(TcInlineFieldLayoutList.Cons field rest)
      (and
        (lower-c-abi-integer-field-type?
          ctx
          (tc-inline-field-layout-type field))
        (lower-c-abi-inline-fields-integer-only? ctx (box-get rest)))]))

(define (lower-c-abi-win64-register-struct-name?
  [ctx : TcContext]
  [name : String]) : bool
  (match (tc-inline-aggregate-layout-for ctx name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Struct _ _ fields)
          (lower-c-abi-inline-fields-win64-register? ctx fields)]
        [(TcInlineAggregateLayout.Enum _ _ _) false])]
    [(ResultTcInlineAggregateLayout.Err _) false]))

(define (lower-c-abi-win64-register-field-type?
  [ctx : TcContext]
  [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name)
      (lower-c-abi-win64-register-struct-name? ctx (intern-str name))]
    [(AstType.StructArgs name _)
      (lower-c-abi-win64-register-struct-name? ctx (intern-str name))]
    [(AstType.F32) true]
    [(AstType.F64) true]
    [_ (lower-c-abi-integer-field-type? ctx ty)]))

(define (lower-c-abi-inline-fields-win64-register?
  [ctx : TcContext]
  [fields : TcInlineFieldLayoutList]) : bool
  (match fields
    [(TcInlineFieldLayoutList.Nil) true]
    [(TcInlineFieldLayoutList.Cons field rest)
      (and
        (lower-c-abi-win64-register-field-type?
          ctx
          (tc-inline-field-layout-type field))
        (lower-c-abi-inline-fields-win64-register? ctx (box-get rest)))]))

(define (lower-c-abi-register-aggregate-fields-ok?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [fields : TcInlineFieldLayoutList]) : bool
  (if (lower-mode-windows-c-abi? mode)
    (lower-c-abi-inline-fields-win64-register? ctx fields)
    (lower-c-abi-inline-fields-integer-only? ctx fields)))

(define (lower-c-abi-integer-scalar-type [size : i64]) : AstType
  (cond
    [(<= size 1) (AstType.U8)]
    [(<= size 2) (AstType.U16)]
    [(<= size 4) (AstType.U32)]
    [else (AstType.U64)]))

(define (lower-c-abi-target-name [mode : CompilerLowerMode]) : String
  (if (lower-mode-windows-c-abi? mode)
    "windows-x86_64"
    "linux-x86_64"))

(define (lower-c-abi-register-aggregate-size?
  [mode : CompilerLowerMode]
  [size : i64]) : bool
  (if (lower-mode-windows-c-abi? mode)
    (or (= size 1) (= size 2) (= size 4) (= size 8))
    (and (> size 0) (<= size 8))))

(define (lower-c-abi-aggregate-size-message [mode : CompilerLowerMode]) : String
  (if (lower-mode-windows-c-abi? mode)
    "scalar structs of size 1, 2, 4, or 8 bytes, including nested scalar struct fields"
    "System V aggregate structs/enums, including register-class and MEMORY-class layouts"))

(define (lower-c-abi-unsupported-message
  [mode : CompilerLowerMode]
  [ty : AstType]) : String
  (string.append
    (string.append "lower: unsupported " (lower-c-abi-target-name mode))
    (string.append
      " C aggregate ABI for "
      (string.append
        (tc-type-render ty)
        (string.append
          "; this slice supports "
          (lower-c-abi-aggregate-size-message mode))))))

(define (lower-c-abi-two-register-return-message [ty : AstType]) : String
  (string.append
    "lower: unsupported linux-x86_64 C two-register aggregate return ABI for "
    (string.append (tc-type-render ty) "; see #1995")))

(define (lower-c-abi-sysv-slot-size [size : i64] [slot-index : i64]) : i64
  (if (= slot-index 0)
    (if (> size 8)
      8
      size)
    (- size 8)))

(define (lower-c-abi-sysv-merge-integer [current : LowerCAbiEightbyteClass]) : LowerCAbiEightbyteClass
  (match current
    [(LowerCAbiEightbyteClass.Unsupported)
      (LowerCAbiEightbyteClass.Unsupported)]
    [_ (LowerCAbiEightbyteClass.Integer)]))

(define (lower-c-abi-sysv-slot-base [offset : i64]) : i64
  (* (/ offset 8) 8))

(define (lower-c-abi-sysv-pack-f32-sse?
  [current-ty : AstType]
  [current-offset : i64]
  [next-ty : AstType]
  [next-offset : i64]) : bool
  (match current-ty
    [(AstType.F32)
      (match next-ty
        [(AstType.F32)
          (let
            [base : i64 (lower-c-abi-sysv-slot-base current-offset)]
            (and
              (= (lower-c-abi-sysv-slot-base next-offset) base)
              (= current-offset base)
              (= next-offset (+ base 4))))]
        [_ false])]
    [_ false]))

(define (lower-c-abi-sysv-merge-sse
  [current : LowerCAbiEightbyteClass]
  [ty : AstType]
  [offset : i64]) : LowerCAbiEightbyteClass
  (match current
    [(LowerCAbiEightbyteClass.Empty) (LowerCAbiEightbyteClass.Sse ty offset)]
    [(LowerCAbiEightbyteClass.Integer) (LowerCAbiEightbyteClass.Integer)]
    [(LowerCAbiEightbyteClass.Sse current-ty current-offset)
      (if (lower-c-abi-sysv-pack-f32-sse? current-ty current-offset ty offset)
        ;; A `{ f32, f32 }` eightbyte is still an SSE-class argument. Carry it
        ;; as an opaque 8-byte XMM payload, not as an INTEGER slot.
        (LowerCAbiEightbyteClass.Sse
          (AstType.F64)
          (lower-c-abi-sysv-slot-base offset))
        (LowerCAbiEightbyteClass.Unsupported))]
    [(LowerCAbiEightbyteClass.Unsupported)
      (LowerCAbiEightbyteClass.Unsupported)]))

(define (lower-c-abi-sysv-mark-integer-slot
  [slots : LowerCAbiSysvSlots]
  [slot-index : i64]) : LowerCAbiSysvSlots
  (match slots
    [(LowerCAbiSysvSlots.Slots first second)
      (if (= slot-index 0)
        (LowerCAbiSysvSlots.Slots (lower-c-abi-sysv-merge-integer first) second)
        (if (= slot-index 1)
          (LowerCAbiSysvSlots.Slots
            first
            (lower-c-abi-sysv-merge-integer second))
          (LowerCAbiSysvSlots.Unsupported)))]
    [(LowerCAbiSysvSlots.Unsupported) (LowerCAbiSysvSlots.Unsupported)]))

(define (lower-c-abi-sysv-mark-integer-range
  [slots : LowerCAbiSysvSlots]
  [offset : i64]
  [size : i64]) : LowerCAbiSysvSlots
  (if (<= size 0)
    slots
    (let
      [first-slot : i64 (/ offset 8)]
      [last-slot : i64 (/ (+ offset (- size 1)) 8)]
      (if (= first-slot last-slot)
        (lower-c-abi-sysv-mark-integer-slot slots first-slot)
        (lower-c-abi-sysv-mark-integer-slot
          (lower-c-abi-sysv-mark-integer-slot slots first-slot)
          last-slot)))))

(define (lower-c-abi-sysv-mark-sse-slot
  [slots : LowerCAbiSysvSlots]
  [ty : AstType]
  [offset : i64]) : LowerCAbiSysvSlots
  (let
    [slot-index : i64 (/ offset 8)]
    (match slots
      [(LowerCAbiSysvSlots.Slots first second)
        (if (= slot-index 0)
          (LowerCAbiSysvSlots.Slots
            (lower-c-abi-sysv-merge-sse first ty offset)
            second)
          (if (= slot-index 1)
            (LowerCAbiSysvSlots.Slots
              first
              (lower-c-abi-sysv-merge-sse second ty offset))
            (LowerCAbiSysvSlots.Unsupported)))]
      [(LowerCAbiSysvSlots.Unsupported) (LowerCAbiSysvSlots.Unsupported)])))

(define (lower-c-abi-sysv-classify-fields
  [ctx : TcContext]
  [fields : TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match fields
    [(TcInlineFieldLayoutList.Nil) slots]
    [(TcInlineFieldLayoutList.Cons field rest)
      (lower-c-abi-sysv-classify-fields
        ctx
        (box-get rest)
        base-offset
        (lower-c-abi-sysv-classify-type
          ctx
          (tc-inline-field-layout-type field)
          (+ base-offset (tc-inline-field-layout-offset field))
          slots))]))

(define (lower-c-abi-sysv-classify-payloads
  [ctx : TcContext]
  [payloads : TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match payloads
    [(TcInlinePayloadLayoutList.Nil) slots]
    [(TcInlinePayloadLayoutList.Cons payload rest)
      (lower-c-abi-sysv-classify-payloads
        ctx
        (box-get rest)
        base-offset
        (lower-c-abi-sysv-classify-type
          ctx
          (tc-inline-payload-layout-type payload)
          (+ base-offset (tc-inline-payload-layout-offset payload))
          slots))]))

(define (lower-c-abi-sysv-classify-variants
  [ctx : TcContext]
  [variants : TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match variants
    [(TcInlineVariantLayoutList.Nil) slots]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (match variant
        [(TcInlineVariantLayout.Variant _ _ _ payloads)
          (lower-c-abi-sysv-classify-variants
            ctx
            (box-get rest)
            base-offset
            (lower-c-abi-sysv-classify-payloads ctx payloads base-offset slots))])]))

(define (lower-c-abi-sysv-classify-layout
  [ctx : TcContext]
  [layout : TcInlineAggregateLayout]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match layout
    [(TcInlineAggregateLayout.Struct _ _ fields)
      (lower-c-abi-sysv-classify-fields ctx fields base-offset slots)]
    [(TcInlineAggregateLayout.Enum _ _ variants)
      ;; Synthetic tagged-union view: int64 tag at offset 0 plus every variant
      ;; payload overlaid in the union region starting at offset 8.
      (lower-c-abi-sysv-classify-variants
        ctx
        variants
        base-offset
        (lower-c-abi-sysv-mark-integer-range slots base-offset 8))]))

(define (lower-c-abi-sysv-classify-struct-name
  [ctx : TcContext]
  [name : String]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match (tc-inline-aggregate-layout-for ctx name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (lower-c-abi-sysv-classify-layout ctx layout base-offset slots)]
    [(ResultTcInlineAggregateLayout.Err _) (LowerCAbiSysvSlots.Unsupported)]))

(define (lower-c-abi-sysv-classify-type
  [ctx : TcContext]
  [ty : AstType]
  [offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Struct name)
        (lower-c-abi-sysv-classify-struct-name
          ctx
          (intern-str name)
          offset
          slots)]
      [(AstType.StructArgs name _)
        (lower-c-abi-sysv-classify-struct-name
          ctx
          (intern-str name)
          offset
          slots)]
      [(AstType.Enum name)
        (lower-c-abi-sysv-classify-struct-name
          ctx
          (intern-str name)
          offset
          slots)]
      [(AstType.EnumArgs name _)
        (lower-c-abi-sysv-classify-struct-name
          ctx
          (intern-str name)
          offset
          slots)]
      [(AstType.F64)
        (lower-c-abi-sysv-mark-sse-slot slots (AstType.F64) offset)]
      [(AstType.F32)
        (lower-c-abi-sysv-mark-sse-slot slots (AstType.F32) offset)]
      [_
        (if (lower-c-abi-integer-field-type? ctx resolved)
          (lower-c-abi-sysv-mark-integer-range
            slots
            offset
            (lower-type-size ctx resolved))
          (LowerCAbiSysvSlots.Unsupported))])))

(define (lower-c-abi-sysv-slot-from-class
  [class : LowerCAbiEightbyteClass]
  [size : i64]
  [slot-index : i64]) : LowerCAbiSlot
  (let
    [slot-size : i64 (lower-c-abi-sysv-slot-size size slot-index)]
    [slot-offset : i64 (* slot-index 8)]
    (match class
      [(LowerCAbiEightbyteClass.Sse ty offset) (LowerCAbiSlot.Slot ty offset)]
      [_
        (LowerCAbiSlot.Slot
          (lower-c-abi-integer-scalar-type slot-size)
          slot-offset)])))

(define (lower-c-abi-slot-list-count [slots : LowerCAbiSlotList]) : i64
  (struct-get slots count))

(define (lower-c-abi-slot-list-ref [slots : LowerCAbiSlotList] [index : i64]) : LowerCAbiSlot
  (array-ref (struct-get slots items) index))

(define (lower-c-abi-slot-list-single [slot : LowerCAbiSlot]) : LowerCAbiSlotList
  (let
    [items : (Array LowerCAbiSlot) (make-array LowerCAbiSlot 1)]
    (begin
      (array-set! items 0 slot)
      (LowerCAbiSlotList items 1))))

(define (lower-c-abi-slot-list-pair
  [first : LowerCAbiSlot]
  [second : LowerCAbiSlot]) : LowerCAbiSlotList
  (let
    [items : (Array LowerCAbiSlot) (make-array LowerCAbiSlot 2)]
    (begin
      (array-set! items 0 first)
      (array-set! items 1 second)
      (LowerCAbiSlotList items 2))))

(define (lower-c-abi-sysv-register-aggregate-from-slots
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [size : i64]
  [slots : LowerCAbiSysvSlots]
  [allow-return? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0)
      (LowerCAbiAggregate.Unsupported
        (lower-c-abi-unsupported-message mode resolved))]
    [(> size 16)
      (if allow-return?
        (LowerCAbiAggregate.Sret size)
        (LowerCAbiAggregate.Memory size))]
    [else
      (match slots
        [(LowerCAbiSysvSlots.Slots first second)
          (match first
            [(LowerCAbiEightbyteClass.Unsupported)
              (LowerCAbiAggregate.Unsupported
                (lower-c-abi-unsupported-message mode resolved))]
            [_
              (match second
                [(LowerCAbiEightbyteClass.Unsupported)
                  (LowerCAbiAggregate.Unsupported
                    (lower-c-abi-unsupported-message mode resolved))]
                [_
                  (if (> size 8)
                    (LowerCAbiAggregate.Register
                      (lower-c-abi-slot-list-pair
                        (lower-c-abi-sysv-slot-from-class first size 0)
                        (lower-c-abi-sysv-slot-from-class second size 1))
                      size)
                    (LowerCAbiAggregate.Register
                      (lower-c-abi-slot-list-single
                        (lower-c-abi-sysv-slot-from-class first size 0))
                      size))])])]
        [(LowerCAbiSysvSlots.Unsupported)
          (LowerCAbiAggregate.Unsupported
            (lower-c-abi-unsupported-message mode resolved))])]))

(define (lower-c-abi-sysv-register-aggregate
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [size : i64]
  [fields : TcInlineFieldLayoutList]
  [allow-return? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0)
      (LowerCAbiAggregate.Unsupported
        (lower-c-abi-unsupported-message mode resolved))]
    [(> size 16)
      (if allow-return?
        (LowerCAbiAggregate.Sret size)
        (LowerCAbiAggregate.Memory size))]
    [(and
        (lower-c-abi-register-aggregate-size? mode size)
        (lower-c-abi-register-aggregate-fields-ok? ctx mode fields))
      (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)]
    [else
      (lower-c-abi-sysv-register-aggregate-from-slots
        mode
        resolved
        size
        (lower-c-abi-sysv-classify-fields
          ctx
          fields
          0
          (LowerCAbiSysvSlots.Slots
            (LowerCAbiEightbyteClass.Empty)
            (LowerCAbiEightbyteClass.Empty)))
        allow-return?)]))

(define (lower-c-abi-sysv-register-enum-aggregate
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [size : i64]
  [align : i64]
  [variants : TcInlineVariantLayoutList]
  [allow-return? : bool]) : LowerCAbiAggregate
  (if (tc-inline-enum-layout-tag-only? size variants)
    (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)
    (lower-c-abi-sysv-register-aggregate-from-slots
      mode
      resolved
      size
      (lower-c-abi-sysv-classify-layout
        ctx
        (TcInlineAggregateLayout.Enum size align variants)
        0
        (LowerCAbiSysvSlots.Slots
          (LowerCAbiEightbyteClass.Empty)
          (LowerCAbiEightbyteClass.Empty)))
      allow-return?)))

(define (lower-c-abi-win64-aggregate-class
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [size : i64]
  [register-ok? : bool]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (cond
    [(and (lower-c-abi-register-aggregate-size? mode size) register-ok?)
      (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)]
    [(and allow-sret? (> size 8)) (LowerCAbiAggregate.Sret size)]
    [(and allow-byref? (not (lower-c-abi-register-aggregate-size? mode size)))
      (LowerCAbiAggregate.ByRef size)]
    [else
      (LowerCAbiAggregate.Unsupported
        (lower-c-abi-unsupported-message mode resolved))]))

(define (lower-c-abi-aggregate-class-from-layout
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [layout : TcInlineAggregateLayout]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (match layout
    [(TcInlineAggregateLayout.Struct size _ fields)
      (if (lower-mode-windows-c-abi? mode)
        (lower-c-abi-win64-aggregate-class
          mode
          resolved
          size
          (lower-c-abi-register-aggregate-fields-ok? ctx mode fields)
          allow-sret?
          allow-byref?)
        (lower-c-abi-sysv-register-aggregate
          ctx
          mode
          resolved
          size
          fields
          allow-sret?))]
    [(TcInlineAggregateLayout.Enum size align variants)
      (if (lower-mode-windows-c-abi? mode)
        ;; Model the default enum layout as a synthetic C aggregate:
        ;; int64 tag at offset 0 plus the max-sized payload union at offset 8.
        (lower-c-abi-win64-aggregate-class
          mode
          resolved
          size
          (tc-inline-enum-layout-tag-only? size variants)
          allow-sret?
          allow-byref?)
        (if (lower-mode-linux-c-abi? mode)
          (lower-c-abi-sysv-register-enum-aggregate
            ctx
            mode
            resolved
            size
            align
            variants
            allow-sret?)
          (LowerCAbiAggregate.Unsupported
            (lower-c-abi-unsupported-message mode resolved))))]))

(define (lower-c-abi-aggregate-class-for-nominal
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [name : String]
  [resolved : AstType]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (match (tc-inline-aggregate-layout-for ctx name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (lower-c-abi-aggregate-class-from-layout
        ctx
        mode
        resolved
        layout
        allow-sret?
        allow-byref?)]
    [(ResultTcInlineAggregateLayout.Err message)
      (LowerCAbiAggregate.Unsupported message)]))

(define (lower-c-abi-aggregate-class-with-flags
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [ty : AstType]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Struct name)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          (intern-str name)
          resolved
          allow-sret?
          allow-byref?)]
      [(AstType.StructArgs name _)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          (intern-str name)
          resolved
          allow-sret?
          allow-byref?)]
      [(AstType.Enum name)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          (intern-str name)
          resolved
          allow-sret?
          allow-byref?)]
      [(AstType.EnumArgs name _)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          (intern-str name)
          resolved
          allow-sret?
          allow-byref?)]
      [_ (LowerCAbiAggregate.No)])))

(define (lower-c-abi-aggregate-class
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [ty : AstType]) : LowerCAbiAggregate
  (lower-c-abi-aggregate-class-with-flags ctx mode ty false true))

(define (lower-c-abi-return-aggregate-class
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [ty : AstType]) : LowerCAbiAggregate
  (lower-c-abi-aggregate-class-with-flags ctx mode ty true false))

(define (lower-c-abi-register-resident-to-scalar
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [agg-ty : AstType]
  [scalar-ty : AstType]) : LowerExpr
  (let
    [storage-ty : AstType (lower-one-word-register-storage-type ctx agg-ty)]
    (if (and
      (lower-register-word-sse-type? storage-ty)
      (not (tc-type-eq storage-ty scalar-ty)))
      (lower-bitcast-value state value storage-ty scalar-ty)
      (LowerExpr state value scalar-ty))))

(define (lower-c-abi-scalar-to-register-resident
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [scalar-ty : AstType]
  [agg-ty : AstType]) : LowerExpr
  (let
    [storage-ty : AstType (lower-one-word-register-storage-type ctx agg-ty)]
    (if (and
      (lower-register-word-sse-type? storage-ty)
      (not (tc-type-eq scalar-ty storage-ty)))
      (match (lower-bitcast-value state value scalar-ty storage-ty)
        [(LowerExpr bit-state bit-value _)
          (LowerExpr bit-state bit-value agg-ty)])
      (LowerExpr state value agg-ty))))

(define (lower-c-abi-args-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [types : AstTypeList]) : ResultLowerArgs
  (match args
    [(AstExprList.Nil)
      (match types
        [(AstTypeList.Nil) (OkLowerArgs state IrValueNil)]
        [_
          (ErrLowerArgs
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(AstExprList.Cons arg rest-args)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest-args : AstExprList (box-get rest-args)]
        (match types
          [(AstTypeList.Cons expected rest-types)
            (let
              [expected : AstType (ty-node-get expected)]
              [rest-types : AstTypeList (box-get rest-types)]
              [arg-ty : AstType
                (tc-type-without-regions (tc-resolve-type ctx expected))]
              (match (lower-expr-expected ctx state env type-env arg arg-ty arg)
                [(OkLowerExpr lowered)
                  (match lowered
                    [(LowerExpr arg-state value _)
                      (match (lower-c-abi-aggregate-class
                        ctx
                        (lower-state-mode arg-state)
                        arg-ty)
                        [(LowerCAbiAggregate.No)
                          (match (lower-c-abi-args-as
                            ctx
                            arg-state
                            env
                            type-env
                            rest-args
                            rest-types)
                            [(OkLowerArgs rest-state rest-values)
                              (OkLowerArgs
                                rest-state
                                (compiler-ir-value-cons value rest-values))]
                            [(ErrLowerArgs message) (ErrLowerArgs message)])]
                        [(LowerCAbiAggregate.Integer scalar-ty size)
                          ;; #2386: a register-resident aggregate is carried as a
                          ;; single-word scalar -- `value` is already the word the C
                          ;; ABI wants in a register, so pass it directly. Any other
                          ;; aggregate (a memory-backed value, e.g. a mixed
                          ;; int/float sub-word struct) is a
                          ;; pointer, so load the scalar out of it. Gate on the same
                          ;; residency predicate that chose the value representation
                          ;; -- not on `size`, since mixed sub-word float
                          ;; structs can still be memory-backed at 8 bytes.
                          (match (if (lower-type-register-resident? ctx arg-ty)
                            (lower-c-abi-register-resident-to-scalar
                              ctx
                              arg-state
                              value
                              arg-ty
                              scalar-ty)
                            (lower-load-at-offset arg-state value 0 scalar-ty))
                            [(LowerExpr scalar-state scalar-value _)
                              (match (lower-c-abi-args-as
                                ctx
                                scalar-state
                                env
                                type-env
                                rest-args
                                rest-types)
                                [(OkLowerArgs rest-state rest-values)
                                  (OkLowerArgs
                                    rest-state
                                    (compiler-ir-value-cons
                                      scalar-value
                                      rest-values))]
                                [(ErrLowerArgs message) (ErrLowerArgs message)])])]
                        [(LowerCAbiAggregate.Register slots _)
                          (match (lower-c-abi-register-arg-slot-values
                            ctx
                            arg-state
                            value
                            arg-ty
                            slots)
                            [(OkLowerArgs slot-state slot-values)
                              (match (lower-c-abi-args-as
                                ctx
                                slot-state
                                env
                                type-env
                                rest-args
                                rest-types)
                                [(OkLowerArgs rest-state rest-values)
                                  (OkLowerArgs
                                    rest-state
                                    (lower-value-list-append
                                      slot-values
                                      rest-values))]
                                [(ErrLowerArgs message) (ErrLowerArgs message)])]
                            [(ErrLowerArgs message) (ErrLowerArgs message)])]
                        [(LowerCAbiAggregate.Memory size)
                          ;; The backend consumes size/unit markers and copies the aggregate to %rsp.
                          (match (lower-c-abi-args-as
                            ctx
                            arg-state
                            env
                            type-env
                            rest-args
                            rest-types)
                            [(OkLowerArgs rest-state rest-values)
                              (OkLowerArgs
                                rest-state
                                (compiler-ir-value-cons
                                  value
                                  (compiler-ir-value-cons
                                    (CompilerIrValue.I64 size)
                                    (compiler-ir-value-cons
                                      (CompilerIrValue.Unit)
                                      rest-values))))]
                            [(ErrLowerArgs message) (ErrLowerArgs message)])]
                        [(LowerCAbiAggregate.ByRef _)
                          ;; The ABI argument is the address of the copied
                          ;; object, not the aggregate itself. Type the value as
                          ;; u64 so direct extern-call register assignment does
                          ;; not reclassify this pointer as a multi-word group.
                          (match (lower-copy-inline-aggregate-to-heap-as
                            ctx
                            arg-state
                            value
                            arg-ty
                            (AstType.U64))
                            [(OkLowerExpr copied)
                              (match copied
                                [(LowerExpr copy-state copy-value _)
                                  (match (lower-c-abi-args-as
                                    ctx
                                    copy-state
                                    env
                                    type-env
                                    rest-args
                                    rest-types)
                                    [(OkLowerArgs rest-state rest-values)
                                      (OkLowerArgs
                                        rest-state
                                        (compiler-ir-value-cons
                                          copy-value
                                          rest-values))]
                                    [(ErrLowerArgs message)
                                      (ErrLowerArgs message)])])]
                            [(ErrLowerExpr message) (ErrLowerArgs message)])]
                        [(LowerCAbiAggregate.Unsupported message)
                          (ErrLowerArgs
                            (box (lower-diagnostic-at-expr arg message)))]
                        [(LowerCAbiAggregate.Sret _)
                          (ErrLowerArgs
                            (box
                              (lower-diagnostic-at-expr
                                arg
                                (lower-c-abi-unsupported-message
                                  (lower-state-mode arg-state)
                                  arg-ty))))])])]
                [(ErrLowerExpr message) (ErrLowerArgs message)]))]
          [(AstTypeList.Nil)
            (ErrLowerArgs
              (box (lower-diagnostic "lower: constructor arity mismatch")))]))]))

(define (lower-c-abi-register-arg-slot-values-from
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [arg-ty : AstType]
  [slots : LowerCAbiSlotList]
  [index : i64]) : ResultLowerArgs
  (if (>= index (lower-c-abi-slot-list-count slots))
    (OkLowerArgs state IrValueNil)
    (match (lower-c-abi-slot-list-ref slots index)
      [(LowerCAbiSlot.Slot scalar-ty offset)
        (match (if (lower-type-register-resident? ctx arg-ty)
          (if (lower-type-register-group? ctx arg-ty)
            (lower-emit-word state value (/ offset 8) scalar-ty)
            (LowerExpr state value scalar-ty))
          (lower-load-at-offset state value offset scalar-ty))
          [(LowerExpr slot-state slot-value _)
            (match (lower-c-abi-register-arg-slot-values-from
              ctx
              slot-state
              value
              arg-ty
              slots
              (+ index 1))
              [(OkLowerArgs rest-state rest-values)
                (OkLowerArgs
                  rest-state
                  (compiler-ir-value-cons slot-value rest-values))]
              [(ErrLowerArgs message) (ErrLowerArgs message)])])])))

(define (lower-c-abi-register-arg-slot-values
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [arg-ty : AstType]
  [slots : LowerCAbiSlotList]) : ResultLowerArgs
  (lower-c-abi-register-arg-slot-values-from ctx state value arg-ty slots 0))

(define (lower-value-list-append
  [values : CompilerIrValueList]
  [tail : CompilerIrValueList]) : CompilerIrValueList
  (match values
    [(IrValueNil) tail]
    [(IrValueCons head rest)
      (compiler-ir-value-cons
        head
        (lower-value-list-append (box-get rest) tail))]))

(define (lower-c-abi-ir-return-slots-from
  [slots : LowerCAbiSlotList]
  [index : i64]) : CompilerIrCAbiReturnSlotList
  (if (>= index (lower-c-abi-slot-list-count slots))
    (IrCAbiReturnSlotNil)
    (match (lower-c-abi-slot-list-ref slots index)
      [(LowerCAbiSlot.Slot scalar-ty offset)
        (IrCAbiReturnSlotCons
          (CompilerIrCAbiReturnSlot.Slot scalar-ty offset)
          (box (lower-c-abi-ir-return-slots-from slots (+ index 1))))])))

(define (lower-c-abi-ir-return-slots [slots : LowerCAbiSlotList]) : CompilerIrCAbiReturnSlotList
  (lower-c-abi-ir-return-slots-from slots 0))

(define (lower-c-abi-materialize-stored-register-result
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [result-ty : AstType]) : LowerExpr
  (if (lower-type-register-group? ctx result-ty)
    (lower-load-group-from-ptr ctx state base result-ty)
    (LowerExpr state base result-ty)))

(define (lower-c-abi-finish-call-result
  [ctx : TcContext]
  [state : LowerState]
  [call-value : CompilerIrValue]
  [result-ty : AstType]
  [abi : LowerCAbiAggregate]
  [origin : AstExpr]) : ResultLowerExpr
  (match abi
    [(LowerCAbiAggregate.No)
      (OkLowerExpr (LowerExpr state call-value result-ty))]
    [(LowerCAbiAggregate.Integer scalar-ty size)
      ;; #2386: a register-resident aggregate is carried as a single-word scalar --
      ;; the C call returns the whole value in a register, which IS that word
      ;; representation, so hand it back directly. Any other aggregate (a
      ;; memory-backed value, e.g. a mixed int/float sub-word struct) is
      ;; referenced by pointer, so spill the returned scalar
      ;; into a fresh slot and return the pointer. Gate on the same residency
      ;; predicate that chose the value representation -- not on `size`, since
      ;; mixed sub-word float structs can still be memory-backed at 8 bytes.
      (if (lower-type-register-resident? ctx result-ty)
        (OkLowerExpr
          (lower-c-abi-scalar-to-register-resident
            ctx
            state
            call-value
            scalar-ty
            result-ty))
        (match (lower-reserve-heap-storage state size result-ty)
          [(LowerExpr base-state base _)
            (OkLowerExpr
              (LowerExpr
                (lower-store-at-offset base-state base 0 call-value scalar-ty)
                base
                result-ty))]))]
    [(LowerCAbiAggregate.Register slots size)
      (let
        [slot-count : i64 (lower-c-abi-slot-list-count slots)]
        (cond
          [(= slot-count 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(LowerCAbiSlot.Slot scalar-ty offset)
                (if (lower-type-register-resident? ctx result-ty)
                  (OkLowerExpr (LowerExpr state call-value result-ty))
                  (match (lower-reserve-heap-storage state size result-ty)
                    [(LowerExpr base-state base _)
                      (OkLowerExpr
                        (LowerExpr
                          (lower-store-at-offset
                            base-state
                            base
                            offset
                            call-value
                            scalar-ty)
                          base
                          result-ty))]))])]
          [(= slot-count 0)
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-c-abi-unsupported-message
                    (lower-state-mode state)
                    result-ty))))]
          [else
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-c-abi-two-register-return-message result-ty))))]))]
    [(LowerCAbiAggregate.ByRef _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Memory _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Sret _)
      ;; #2386: the C callee wrote the >8B result into the caller-provided sret
      ;; buffer, so `call-value` is the buffer pointer. A register-resident result
      ;; (a 16B word-class struct: a 2-word register group in this backend) must
      ;; be materialized back into that two-word group VALUE -- load both words
      ;; and Pack -- or downstream consumers that expect a register pair (e.g. a
      ;; by-value call argument) get the pointer in word0 and garbage in word1.
      ;; A genuine memory aggregate (>16B, or float-containing) stays the pointer.
      (if (lower-type-register-group? ctx result-ty)
        (OkLowerExpr (lower-load-group-from-ptr ctx state call-value result-ty))
        (OkLowerExpr (LowerExpr state call-value result-ty)))]
    [(LowerCAbiAggregate.Unsupported message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-direct-c-abi-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [param-types : AstTypeList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-c-abi-args-as ctx state env type-env args param-types)
    [(OkLowerArgs args-state values)
      (match (lower-c-abi-return-aggregate-class
        ctx
        (lower-state-mode args-state)
        result-ty)
        [(LowerCAbiAggregate.Unsupported message)
          (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))]
        [(LowerCAbiAggregate.No)
          (match (lower-state-alloc-var args-state)
            [(LowerAlloc allocated var-id)
              (let
                [instr : CompilerIrInstr
                  (CompilerIrInstr.Call
                    var-id
                    (lower-resolve-call-name allocated env name)
                    (compiler-ir-call-args-from-list values)
                    result-ty)]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr allocated instr origin)
                  (CompilerIrValue.Var var-id)
                  result-ty
                  (LowerCAbiAggregate.No)
                  origin))])]
        [(LowerCAbiAggregate.Integer scalar-ty size)
          (match (lower-state-alloc-var args-state)
            [(LowerAlloc allocated var-id)
              (let
                [instr : CompilerIrInstr
                  (CompilerIrInstr.Call
                    var-id
                    (lower-resolve-call-name allocated env name)
                    (compiler-ir-call-args-from-list values)
                    scalar-ty)]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr allocated instr origin)
                  (CompilerIrValue.Var var-id)
                  result-ty
                  (LowerCAbiAggregate.Integer scalar-ty size)
                  origin))])]
        [(LowerCAbiAggregate.Register slots size)
          (let
            [slot-count : i64 (lower-c-abi-slot-list-count slots)]
            (cond
              [(= slot-count 1)
                (match (lower-c-abi-slot-list-ref slots 0)
                  [(LowerCAbiSlot.Slot scalar-ty _)
                    (match (lower-state-alloc-var args-state)
                      [(LowerAlloc allocated var-id)
                        (let
                          [instr : CompilerIrInstr
                            (CompilerIrInstr.Call
                              var-id
                              (lower-resolve-call-name allocated env name)
                              (compiler-ir-call-args-from-list values)
                              scalar-ty)]
                          (lower-c-abi-finish-call-result
                            ctx
                            (lower-state-emit-at-expr allocated instr origin)
                            (CompilerIrValue.Var var-id)
                            result-ty
                            (LowerCAbiAggregate.Register slots size)
                            origin))])])]
              [(= slot-count 0)
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      (lower-c-abi-unsupported-message
                        (lower-state-mode args-state)
                        result-ty))))]
              [else
                (match (lower-reserve-heap-storage args-state size result-ty)
                  [(LowerExpr base-state base _)
                    (let
                      [instr : CompilerIrInstr
                        (ir-instr-call-cabi-store-result
                          base
                          (lower-resolve-call-name base-state env name)
                          (compiler-ir-call-args-from-list values)
                          (lower-c-abi-ir-return-slots slots))]
                      (match (lower-c-abi-materialize-stored-register-result
                        ctx
                        (lower-state-emit-at-expr base-state instr origin)
                        base
                        result-ty)
                        [(LowerExpr out-state out-value out-ty)
                          (OkLowerExpr (LowerExpr out-state out-value out-ty))]))])]))]
        [(LowerCAbiAggregate.ByRef _)
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-c-abi-unsupported-message
                  (lower-state-mode args-state)
                  result-ty))))]
        [(LowerCAbiAggregate.Memory _)
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-c-abi-unsupported-message
                  (lower-state-mode args-state)
                  result-ty))))]
        [(LowerCAbiAggregate.Sret size)
          ;; #2386: reserve the sret buffer typed as a scalar pointer (U64), NOT
          ;; the aggregate result type. A register-resident result type would make
          ;; the backend classify the hidden sret pointer as a 2-word register
          ;; group, shifting every real argument by one slot (and reading an
          ;; undefined second word). Typing it U64 keeps the hidden pointer in a
          ;; single integer register, and it survives copy-propagation (there is
          ;; no copy to fold). The result materialization below reads the 2 words
          ;; back from the buffer using `result-ty` explicitly.
          (match (lower-reserve-heap-storage args-state size (AstType.U64))
            [(LowerExpr base-state base _)
              (match (lower-state-alloc-var base-state)
                [(LowerAlloc allocated var-id)
                  (let
                    [instr : CompilerIrInstr
                      (CompilerIrInstr.Call
                        var-id
                        (lower-resolve-call-name allocated env name)
                        (compiler-ir-call-args-from-list
                          (compiler-ir-value-cons base values))
                        (AstType.U64))]
                    (lower-c-abi-finish-call-result
                      ctx
                      (lower-state-emit-at-expr allocated instr origin)
                      base
                      result-ty
                      (LowerCAbiAggregate.Sret size)
                      origin))])])])]
    [(ErrLowerArgs message) (ErrLowerExpr message)]))

(define (lower-indirect-c-abi-call-values
  [ctx : TcContext]
  [state : LowerState]
  [func-value : CompilerIrValue]
  [values : CompilerIrValueList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-c-abi-return-aggregate-class
    ctx
    (lower-state-mode state)
    result-ty)
    [(LowerCAbiAggregate.Unsupported message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))]
    [(LowerCAbiAggregate.No)
      (match (lower-state-alloc-var state)
        [(LowerAlloc allocated var-id)
          (let
            [instr : CompilerIrInstr
              (CompilerIrInstr.CallIndirectC
                var-id
                func-value
                (compiler-ir-call-args-from-list values)
                result-ty)]
            (lower-c-abi-finish-call-result
              ctx
              (lower-state-emit-at-expr allocated instr origin)
              (CompilerIrValue.Var var-id)
              result-ty
              (LowerCAbiAggregate.No)
              origin))])]
    [(LowerCAbiAggregate.Integer scalar-ty size)
      (match (lower-state-alloc-var state)
        [(LowerAlloc allocated var-id)
          (let
            [instr : CompilerIrInstr
              (CompilerIrInstr.CallIndirectC
                var-id
                func-value
                (compiler-ir-call-args-from-list values)
                scalar-ty)]
            (lower-c-abi-finish-call-result
              ctx
              (lower-state-emit-at-expr allocated instr origin)
              (CompilerIrValue.Var var-id)
              result-ty
              (LowerCAbiAggregate.Integer scalar-ty size)
              origin))])]
    [(LowerCAbiAggregate.Register slots size)
      (let
        [slot-count : i64 (lower-c-abi-slot-list-count slots)]
        (cond
          [(= slot-count 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(LowerCAbiSlot.Slot scalar-ty _)
                (match (lower-state-alloc-var state)
                  [(LowerAlloc allocated var-id)
                    (let
                      [instr : CompilerIrInstr
                        (CompilerIrInstr.CallIndirectC
                          var-id
                          func-value
                          (compiler-ir-call-args-from-list values)
                          scalar-ty)]
                      (lower-c-abi-finish-call-result
                        ctx
                        (lower-state-emit-at-expr allocated instr origin)
                        (CompilerIrValue.Var var-id)
                        result-ty
                        (LowerCAbiAggregate.Register slots size)
                        origin))])])]
          [(= slot-count 0)
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-c-abi-unsupported-message
                    (lower-state-mode state)
                    result-ty))))]
          [else
            (match (lower-reserve-heap-storage state size result-ty)
              [(LowerExpr base-state base _)
                (let
                  [instr : CompilerIrInstr
                    (ir-instr-call-indirect-cabi-store-result
                      base
                      func-value
                      (compiler-ir-call-args-from-list values)
                      (lower-c-abi-ir-return-slots slots))]
                  (match (lower-c-abi-materialize-stored-register-result
                    ctx
                    (lower-state-emit-at-expr base-state instr origin)
                    base
                    result-ty)
                    [(LowerExpr out-state out-value out-ty)
                      (OkLowerExpr (LowerExpr out-state out-value out-ty))]))])]))]
    [(LowerCAbiAggregate.ByRef _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Memory _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Sret size)
      ;; #2386: reserve the sret buffer typed as a scalar pointer (U64) -- see
      ;; lower-direct-c-abi-call -- so a register-resident result type does not make
      ;; the backend classify the hidden sret pointer as a 2-register group arg.
      (match (lower-reserve-heap-storage state size (AstType.U64))
        [(LowerExpr base-state base _)
          (match (lower-state-alloc-var base-state)
            [(LowerAlloc allocated var-id)
              (let
                [instr : CompilerIrInstr
                  (CompilerIrInstr.CallIndirectC
                    var-id
                    func-value
                    (compiler-ir-call-args-from-list
                      (compiler-ir-value-cons base values))
                    (AstType.U64))]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr allocated instr origin)
                  base
                  result-ty
                  (LowerCAbiAggregate.Sret size)
                  origin))])])]))

(define (lower-extern-value-c-abi-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [param-types : AstTypeList]
  [fn-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-var state env name fn-ty)
    [(OkLowerExpr lowered-func)
      (match lowered-func
        [(LowerExpr func-state func-value _)
          (match (lower-state-alloc-var func-state)
            [(LowerAlloc allocated func-var)
              (let
                [loaded-state : LowerState
                  (lower-state-emit-at-expr
                    allocated
                    (CompilerIrInstr.Mov func-var func-value fn-ty)
                    origin)]
                (match (lower-c-abi-args-as
                  ctx
                  loaded-state
                  env
                  type-env
                  args
                  param-types)
                  [(OkLowerArgs args-state values)
                    (lower-indirect-c-abi-call-values
                      ctx
                      args-state
                      (CompilerIrValue.Var func-var)
                      values
                      result-ty
                      origin)]
                  [(ErrLowerArgs message) (ErrLowerExpr message)]))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

;; #1867 sret ABI caller side: append the sret pointer as the trailing arg to a
;; value list (matching the callee's `__sret` param).
(define (lower-value-list-append-one
  [values : CompilerIrValueList]
  [extra : CompilerIrValue]) : CompilerIrValueList
  (match values
    [(IrValueNil) (compiler-ir-value-cons extra IrValueNil)]
    [(IrValueCons head rest)
      (compiler-ir-value-cons
        head
        (lower-value-list-append-one (box-get rest) extra))]))

;; For a call whose result is an inline aggregate, allocate the result slot on
;; the caller's stack and append its pointer as the hidden trailing arg. Uses
;; the same gate/size as the callee's sret return, so the call's return value is
;; that pointer and callers consume the result exactly as before. Non-aggregate
;; results pass through unchanged.
(define (lower-call-append-sret-arg
  [ctx : TcContext]
  [state : LowerState]
  [values : CompilerIrValueList]
  [result-ty : AstType]) : ResultLowerArgs
  (if (lower-inline-aggregate-abi-copy-needed? ctx state result-ty)
    (match (lower-inline-aggregate-copy-size ctx result-ty)
      [(OkLowerSize size)
        (match (lower-reserve-inline-storage state size result-ty)
          [(LowerExpr slot-state slot-ptr _)
            (OkLowerArgs
              slot-state
              (lower-value-list-append-one values slot-ptr))])]
      [(ErrLowerSize message) (ErrLowerArgs (box (lower-diagnostic message)))])
    (OkLowerArgs state values)))

(define (lower-direct-call-values
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : String]
  [values : CompilerIrValueList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-call-append-sret-arg ctx state values result-ty)
    [(OkLowerArgs sret-state sret-values)
      (match (lower-state-alloc-var sret-state)
        [(LowerAlloc allocated var-id)
          (let
            [result-ir-ty : AstType
              (lower-one-word-register-storage-type ctx result-ty)]
            [instr : CompilerIrInstr
              (CompilerIrInstr.Call
                var-id
                (lower-resolve-call-name allocated env name)
                (compiler-ir-call-args-from-list sret-values)
                result-ir-ty)]
            (OkLowerExpr
              (LowerExpr
                (lower-state-emit-at-expr allocated instr origin)
                (CompilerIrValue.Var var-id)
                result-ty)))])]
    [(ErrLowerArgs message) (ErrLowerExpr message)]))

(define (lower-bytes-view-from-parts-result
  [ctx : TcContext]
  [state : LowerState]
  [ptr-value : CompilerIrValue]
  [len-value : CompilerIrValue]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-reserve-inline-storage state 16 (AstType.String))
    [(LowerExpr base-state base-value _)
      (let
        [with-ptr : LowerState
          (lower-store-at-offset
            base-state
            base-value
            0
            ptr-value
            (AstType.U64))]
        [with-len : LowerState
          (lower-store-at-offset with-ptr base-value 8 len-value (AstType.I64))]
        (match (lower-state-alloc-var with-len)
          [(LowerAlloc call-state call-var)
            (OkLowerExpr
              (LowerExpr
                (lower-state-emit-at-expr
                  call-state
                  (CompilerIrInstr.Call
                    call-var
                    "tl_str_view"
                    (compiler-ir-call-args-from-list
                      (compiler-ir-value-cons
                        base-value
                        (compiler-ir-value-cons
                          (CompilerIrValue.I64 0)
                          (compiler-ir-value-cons len-value IrValueNil))))
                    (lower-one-word-register-storage-type ctx result-ty))
                  origin)
                (CompilerIrValue.Var call-var)
                result-ty))]))]))

(define (lower-bytes-view-from-parts-values
  [ctx : TcContext]
  [args-result : ResultLowerArgs]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args-result
    [(OkLowerArgs args-state values)
      (match values
        [(IrValueCons data-value rest0)
          (match (box-get rest0)
            [(IrValueCons len-value rest1)
              (match (box-get rest1)
                [(IrValueCons _ rest2)
                  (match (box-get rest2)
                    [(IrValueNil)
                      (lower-bytes-view-from-parts-result
                        ctx
                        args-state
                        data-value
                        len-value
                        result-ty
                        origin)]
                    [_
                      (ErrLowerExpr
                        (box
                          (lower-diagnostic-at-expr
                            origin
                            "lower: bytes view helper expects data, length, owner")))])]
                [_
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: bytes view helper expects data, length, owner")))])]
            [_
              (ErrLowerExpr
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "lower: bytes view helper expects data, length, owner")))])]
        [_
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: bytes view helper expects data, length, owner")))])]
    [(ErrLowerArgs message) (ErrLowerExpr message)]))

(define (lower-bytes-view-from-parts-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (lower-bytes-view-from-parts-values
    ctx
    (lower-args ctx state env type-env args)
    result-ty
    origin))

(define (lower-direct-call-from-args
  [ctx : TcContext]
  [args-result : ResultLowerArgs]
  [env : sym_i64_env.SymI64Env]
  [name : String]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args-result
    [(OkLowerArgs args-state values)
      (lower-direct-call-values ctx args-state env name values result-ty origin)]
    [(ErrLowerArgs message) (ErrLowerExpr message)]))

(define (lower-direct-call-from-call-args
  [ctx : TcContext]
  [args-result : ResultLowerCallArgs]
  [env : sym_i64_env.SymI64Env]
  [name : String]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args-result
    [(OkLowerCallArgs args-state values writebacks)
      (match (lower-direct-call-values
        ctx
        args-state
        env
        name
        values
        result-ty
        origin)
        [(OkLowerExpr lowered)
          (match lowered
            [(LowerExpr call-state call-value call-ty)
              (OkLowerExpr
                (LowerExpr
                  (lower-apply-arg-writebacks ctx call-state writebacks)
                  call-value
                  call-ty))])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(ErrLowerCallArgs message) (ErrLowerExpr message)]))

(define (lower-direct-call-param-types
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [params : AstTypeList]) : ResultTcTypeList
  (match (tc-call-extern-abi-for-name ctx name)
    [(TcMaybeExternAbi.Some abi)
      (if (tc-call-dynamic-c-varargs-abi? abi)
        (tc-call-extern-varargs-params ctx type-env args params abi)
        (ResultTcTypeList.Ok params))]
    [(TcMaybeExternAbi.No) (ResultTcTypeList.Ok params)]))

(define (lower-direct-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (lower-bytes-view-from-parts-name? name)
    (lower-bytes-view-from-parts-call
      ctx
      state
      env
      type-env
      args
      result-ty
      origin)
    (match (lower-lookup-type
      ctx
      (lower-state-type-cache state)
      env
      type-env
      name)
      [(ResultTcType.Ok fn-ty)
        (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
          [(AstType.Func param-types _)
            (match (lower-direct-call-param-types
              ctx
              type-env
              name
              args
              (tc-resolve-type-list ctx (box-get param-types)))
              [(ResultTcTypeList.Ok call-param-types)
                (if (lower-c-abi-extern-call? ctx state env name)
                  (lower-direct-c-abi-call
                    ctx
                    state
                    env
                    type-env
                    name
                    args
                    call-param-types
                    result-ty
                    origin)
                  (if (lower-c-abi-extern-value-call? ctx state env name)
                    (lower-extern-value-c-abi-call
                      ctx
                      state
                      env
                      type-env
                      name
                      args
                      call-param-types
                      (tc-type-strip-region (tc-resolve-type ctx fn-ty))
                      result-ty
                      origin)
                    (lower-direct-call-from-call-args
                      ctx
                      (lower-call-args-as-needed
                        ctx
                        state
                        env
                        type-env
                        args
                        call-param-types)
                      env
                      name
                      result-ty
                      origin)))]
              [(ResultTcTypeList.Err message)
                (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])]
          [_
            (lower-direct-call-from-args
              ctx
              (lower-args ctx state env type-env args)
              env
              name
              result-ty
              origin)])]
      [(ResultTcType.Err _)
        (lower-direct-call-from-args
          ctx
          (lower-args ctx state env type-env args)
          env
          name
          result-ty
          origin)])))

(define (lower-indirect-call-values
  [ctx : TcContext]
  [state : LowerState]
  [func-value : CompilerIrValue]
  [values : CompilerIrValueList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-call-append-sret-arg ctx state values result-ty)
    [(OkLowerArgs sret-state sret-values)
      (match (lower-state-alloc-var sret-state)
        [(LowerAlloc allocated var-id)
          (let
            [result-ir-ty : AstType
              (lower-one-word-register-storage-type ctx result-ty)]
            [instr : CompilerIrInstr
              (CompilerIrInstr.CallIndirect
                var-id
                func-value
                (compiler-ir-call-args-from-list sret-values)
                result-ir-ty)]
            (OkLowerExpr
              (LowerExpr
                (lower-state-emit-at-expr allocated instr origin)
                (CompilerIrValue.Var var-id)
                result-ty)))])]
    [(ErrLowerArgs message) (ErrLowerExpr message)]))

(define (lower-indirect-call-args
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [func-ty : AstType]) : ResultLowerArgs
  (match (tc-type-strip-region (tc-resolve-type ctx func-ty))
    [(AstType.Func param-types _)
      (lower-args-as
        ctx
        state
        env
        type-env
        args
        (tc-resolve-type-list ctx (box-get param-types)))]
    [_ (lower-args ctx state env type-env args)]))

(define (lower-indirect-call-args-with-writebacks
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [func-ty : AstType]) : ResultLowerCallArgs
  (match (tc-type-strip-region (tc-resolve-type ctx func-ty))
    [(AstType.Func param-types _)
      (lower-call-args-as-needed
        ctx
        state
        env
        type-env
        args
        (tc-resolve-type-list ctx (box-get param-types)))]
    [_
      (match (lower-args ctx state env type-env args)
        [(OkLowerArgs args-state values)
          (OkLowerCallArgs args-state values (lower-arg-writeback-list-empty))]
        [(ErrLowerArgs message) (ErrLowerCallArgs message)])]))

(define (lower-indirect-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func-ty : AstType]
  [func-value : CompilerIrValue]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-indirect-call-args-with-writebacks
    ctx
    state
    env
    type-env
    args
    func-ty)
    [(OkLowerCallArgs args-state values writebacks)
      (match (lower-indirect-call-values
        ctx
        args-state
        func-value
        values
        result-ty
        origin)
        [(OkLowerExpr lowered)
          (match lowered
            [(LowerExpr call-state call-value call-ty)
              (OkLowerExpr
                (LowerExpr
                  (lower-apply-arg-writebacks ctx call-state writebacks)
                  call-value
                  call-ty))])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(ErrLowerCallArgs message) (ErrLowerExpr message)]))

(define (lower-indirect-c-abi-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func-ty : AstType]
  [func-value : CompilerIrValue]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-type-strip-region (tc-resolve-type ctx func-ty))
    [(AstType.Func param-types _)
      (match (lower-c-abi-args-as
        ctx
        state
        env
        type-env
        args
        (tc-resolve-type-list ctx (box-get param-types)))
        [(OkLowerArgs args-state values)
          (lower-indirect-c-abi-call-values
            ctx
            args-state
            func-value
            values
            result-ty
            origin)]
        [(ErrLowerArgs message) (ErrLowerExpr message)])]
    [_
      (lower-indirect-call
        ctx
        state
        env
        type-env
        func-ty
        func-value
        args
        result-ty
        origin)]))

(define (lower-substring-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons str tail)
      (let
        [str : AstExpr (ast-node-get str)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Cons start rest1)
            (let
              [start : AstExpr (ast-node-get start)]
              [rest1 : AstExprList (box-get rest1)]
              (match rest1
                [(AstExprList.Cons len rest2)
                  (let
                    [len : AstExpr (ast-node-get len)]
                    [rest2 : AstExprList (box-get rest2)]
                    (match rest2
                      [(AstExprList.Nil)
                        (lower-substring ctx state env type-env str start len)]
                      [_
                        (lower-direct-call
                          ctx
                          state
                          env
                          type-env
                          name
                          args
                          result-ty
                          origin)]))]
                [_
                  (lower-direct-call
                    ctx
                    state
                    env
                    type-env
                    name
                    args
                    result-ty
                    origin)]))]
          [_
            (lower-direct-call
              ctx
              state
              env
              type-env
              name
              args
              result-ty
              origin)]))]
    [_ (lower-direct-call ctx state env type-env name args result-ty origin)]))

(define (lower-string-concat-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons left tail)
      (let
        [left : AstExpr (ast-node-get left)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Cons right rest)
            (let
              [right : AstExpr (ast-node-get right)]
              [rest : AstExprList (box-get rest)]
              (match rest
                [(AstExprList.Nil)
                  (lower-string-concat ctx state env type-env left right)]
                [_
                  (lower-direct-call
                    ctx
                    state
                    env
                    type-env
                    name
                    args
                    result-ty
                    origin)]))]
          [_
            (lower-direct-call
              ctx
              state
              env
              type-env
              name
              args
              result-ty
              origin)]))]
    [_ (lower-direct-call ctx state env type-env name args result-ty origin)]))

(define (lower-string-runtime-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (or (string.eq name "substring") (string.eq name "string-slice"))
    (lower-substring-call ctx state env type-env name args result-ty origin)
    (lower-string-concat-call ctx state env type-env name args result-ty origin)))

(define (lower-runtime-call-values
  [state : LowerState]
  [name : String]
  [values : CompilerIrValueList]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (OkLowerExpr
        (LowerExpr
          (lower-state-emit
            allocated
            (CompilerIrInstr.Call
              var-id
              name
              (compiler-ir-call-args-from-list values)
              result-ty))
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-one-arg-runtime-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [fallback-name : String]
  [runtime-name : String]
  [expected-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons arg tail)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Nil)
            (match (lower-expr ctx state env type-env arg)
              [(OkLowerExpr lowered)
                (match lowered
                  [(LowerExpr arg-state arg-value arg-ty)
                    (match (lower-cast-value
                      arg-state
                      arg-value
                      arg-ty
                      expected-ty)
                      [(LowerExpr cast-state cast-value _)
                        (lower-runtime-call-values
                          cast-state
                          runtime-name
                          (compiler-ir-value-cons cast-value IrValueNil)
                          result-ty)])])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]
          [_
            (lower-direct-call
              ctx
              state
              env
              type-env
              fallback-name
              args
              result-ty
              origin)]))]
    [_
      (lower-direct-call
        ctx
        state
        env
        type-env
        fallback-name
        args
        result-ty
        origin)]))

(define (lower-one-string-object-runtime-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arg : AstExpr]
  [runtime-name : String]
  [result-ty : AstType]
  [message : String]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arg)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr arg-state arg-value arg-ty)
          (if (lower-string-handle-type? ctx arg-ty)
            (lower-runtime-call-values
              arg-state
              runtime-name
              (compiler-ir-value-cons arg-value IrValueNil)
              result-ty)
            (ErrLowerExpr (box (lower-diagnostic-at-expr arg message))))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-inline-string-eq-finish
  [state : LowerState]
  [_true-label : String]
  [false-label : String]
  [done-label : String]
  [result-var : i64]
  [result-ty : AstType]) : LowerExpr
  (let
    [false-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-state-emit
            state
            (CompilerIrInstr.Mov
              result-var
              (CompilerIrValue.Bool true)
              (AstType.Bool)))
          (CompilerIrInstr.Jump done-label))
        false-label)]
    [done-start : LowerState
      (lower-state-finish-block
        (lower-state-emit false-start (CompilerIrInstr.Jump done-label))
        done-label)]
    (LowerExpr done-start (CompilerIrValue.Var result-var) result-ty)))

(define (lower-inline-string-eq-body
  [state : LowerState]
  [header-label : String]
  [true-label : String]
  [false-label : String]
  [done-label : String]
  [result-var : i64]
  [index-var : i64]
  [left-ptr : CompilerIrValue]
  [right-ptr : CompilerIrValue]
  [result-ty : AstType]) : LowerExpr
  (match (lower-emit-gep
    state
    left-ptr
    (CompilerIrValue.Var index-var)
    (AstType.U8))
    [(LowerExpr left-gep-state left-addr _)
      (match (lower-emit-load left-gep-state left-addr (AstType.U8))
        [(LowerExpr left-load-state left-byte _)
          (match (lower-emit-gep
            left-load-state
            right-ptr
            (CompilerIrValue.Var index-var)
            (AstType.U8))
            [(LowerExpr right-gep-state right-addr _)
              (match (lower-emit-load right-gep-state right-addr (AstType.U8))
                [(LowerExpr right-load-state right-byte _)
                  (match (lower-emit-cast
                    right-load-state
                    left-byte
                    (AstType.U8)
                    (AstType.I64))
                    [(LowerExpr left-cast-state left-i64 _)
                      (match (lower-emit-cast
                        left-cast-state
                        right-byte
                        (AstType.U8)
                        (AstType.I64))
                        [(LowerExpr right-cast-state right-i64 _)
                          (match (lower-emit-binop
                            right-cast-state
                            CompilerIrBinOp.Eq
                            left-i64
                            right-i64
                            (AstType.Bool))
                            [(LowerExpr byte-eq-state byte-eq _)
                              (match (lower-emit-binop
                                byte-eq-state
                                CompilerIrBinOp.Add
                                (CompilerIrValue.Var index-var)
                                (CompilerIrValue.I64 1)
                                (AstType.I64))
                                [(LowerExpr inc-state next-index _)
                                  (lower-inline-string-eq-finish
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        (lower-state-emit
                                          inc-state
                                          (CompilerIrInstr.Mov
                                            index-var
                                            next-index
                                            (AstType.I64)))
                                        (CompilerIrInstr.Branch
                                          byte-eq
                                          header-label
                                          false-label))
                                      true-label)
                                    true-label
                                    false-label
                                    done-label
                                    result-var
                                    result-ty)])])])])])])])]))

(define (lower-inline-string-eq-fields
  [state : LowerState]
  [left-ptr : CompilerIrValue]
  [left-len : CompilerIrValue]
  [right-ptr : CompilerIrValue]
  [right-len : CompilerIrValue]
  [result-ty : AstType]) : LowerExpr
  (match (lower-state-fresh-label state "string_eq_header")
    [(LowerLabel header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "string_eq_body")
        [(LowerLabel body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "string_eq_true")
            [(LowerLabel true-label-state true-label)
              (match (lower-state-fresh-label
                true-label-state
                "string_eq_false")
                [(LowerLabel false-label-state false-label)
                  (match (lower-state-fresh-label
                    false-label-state
                    "string_eq_done")
                    [(LowerLabel done-label-state done-label)
                      (match (lower-state-alloc-var done-label-state)
                        [(LowerAlloc result-alloc result-var)
                          (match (lower-state-alloc-var result-alloc)
                            [(LowerAlloc index-alloc index-var)
                              (match (lower-emit-binop
                                (lower-state-emit
                                  (lower-state-emit
                                    index-alloc
                                    (CompilerIrInstr.Mov
                                      result-var
                                      (CompilerIrValue.Bool false)
                                      (AstType.Bool)))
                                  (CompilerIrInstr.Mov
                                    index-var
                                    (CompilerIrValue.I64 0)
                                    (AstType.I64)))
                                CompilerIrBinOp.Eq
                                left-len
                                right-len
                                (AstType.Bool))
                                [(LowerExpr len-state len-ok _)
                                  (let
                                    [header-start : LowerState
                                      (lower-state-finish-block
                                        (lower-state-emit
                                          len-state
                                          (CompilerIrInstr.Branch
                                            len-ok
                                            header-label
                                            false-label))
                                        header-label)]
                                    (match (lower-emit-binop
                                      header-start
                                      CompilerIrBinOp.Lt
                                      (CompilerIrValue.Var index-var)
                                      left-len
                                      (AstType.Bool))
                                      [(LowerExpr cond-state cond-value _)
                                        (lower-inline-string-eq-body
                                          (lower-state-finish-block
                                            (lower-state-emit
                                              cond-state
                                              (CompilerIrInstr.Branch
                                                cond-value
                                                body-label
                                                true-label))
                                            body-label)
                                          header-label
                                          true-label
                                          false-label
                                          done-label
                                          result-var
                                          index-var
                                          left-ptr
                                          right-ptr
                                          result-ty)]))])])])])])])])]))

(define (lower-inline-string-to-int-negate
  [state : LowerState]
  [negate-label : String]
  [done-label : String]
  [value-var : i64]
  [negative-var : i64]
  [result-ty : AstType]) : LowerExpr
  (let
    [negate-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          state
          (CompilerIrInstr.Branch
            (CompilerIrValue.Var negative-var)
            negate-label
            done-label))
        negate-label)]
    (match (lower-emit-binop
      negate-start
      CompilerIrBinOp.Sub
      (CompilerIrValue.I64 0)
      (CompilerIrValue.Var value-var)
      (AstType.I64))
      [(LowerExpr neg-state neg-value _)
        (let
          [done-start : LowerState
            (lower-state-finish-block
              (lower-state-emit
                (lower-state-emit
                  neg-state
                  (CompilerIrInstr.Mov value-var neg-value (AstType.I64)))
                (CompilerIrInstr.Jump done-label))
              done-label)]
          (LowerExpr done-start (CompilerIrValue.Var value-var) result-ty))])))

(define (lower-inline-string-to-int-body
  [state : LowerState]
  [ptr : CompilerIrValue]
  [header-label : String]
  [apply-label : String]
  [negate-label : String]
  [done-label : String]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : AstType]) : LowerExpr
  (match (lower-emit-gep state ptr (CompilerIrValue.Var index-var) (AstType.U8))
    [(LowerExpr byte-gep-state byte-addr _)
      (match (lower-emit-load byte-gep-state byte-addr (AstType.U8))
        [(LowerExpr byte-load-state byte-value _)
          (match (lower-emit-cast
            byte-load-state
            byte-value
            (AstType.U8)
            (AstType.I64))
            [(LowerExpr byte-cast-state byte-i64 _)
              (match (lower-emit-binop
                byte-cast-state
                CompilerIrBinOp.Sub
                byte-i64
                (CompilerIrValue.I64 48)
                (AstType.I64))
                [(LowerExpr digit-state digit _)
                  (match (lower-emit-binop
                    digit-state
                    CompilerIrBinOp.Mul
                    (CompilerIrValue.Var value-var)
                    (CompilerIrValue.I64 10)
                    (AstType.I64))
                    [(LowerExpr scaled-state scaled _)
                      (match (lower-emit-binop
                        scaled-state
                        CompilerIrBinOp.Add
                        scaled
                        digit
                        (AstType.I64))
                        [(LowerExpr next-state next-value _)
                          (match (lower-emit-binop
                            next-state
                            CompilerIrBinOp.Add
                            (CompilerIrValue.Var index-var)
                            (CompilerIrValue.I64 1)
                            (AstType.I64))
                            [(LowerExpr inc-state next-index _)
                              (lower-inline-string-to-int-negate
                                (lower-state-finish-block
                                  (lower-state-emit
                                    (lower-state-emit
                                      (lower-state-emit
                                        inc-state
                                        (CompilerIrInstr.Mov
                                          value-var
                                          next-value
                                          (AstType.I64)))
                                      (CompilerIrInstr.Mov
                                        index-var
                                        next-index
                                        (AstType.I64)))
                                    (CompilerIrInstr.Jump header-label))
                                  apply-label)
                                negate-label
                                done-label
                                value-var
                                negative-var
                                result-ty)])])])])])])]))

(define (lower-inline-string-to-int-loop
  [state : LowerState]
  [ptr : CompilerIrValue]
  [len : CompilerIrValue]
  [body-label : String]
  [apply-label : String]
  [header-label : String]
  [negate-label : String]
  [done-label : String]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : AstType]) : LowerExpr
  (match (lower-emit-binop
    state
    CompilerIrBinOp.Lt
    (CompilerIrValue.Var index-var)
    len
    (AstType.Bool))
    [(LowerExpr cond-state cond-value _)
      (lower-inline-string-to-int-body
        (lower-state-finish-block
          (lower-state-emit
            cond-state
            (CompilerIrInstr.Branch cond-value body-label apply-label))
          body-label)
        ptr
        header-label
        apply-label
        negate-label
        done-label
        value-var
        index-var
        negative-var
        result-ty)]))

(define (lower-inline-string-to-int-sign
  [state : LowerState]
  [ptr : CompilerIrValue]
  [len : CompilerIrValue]
  [minus-label : String]
  [header-label : String]
  [body-label : String]
  [apply-label : String]
  [negate-label : String]
  [done-label : String]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : AstType]) : LowerExpr
  (match (lower-emit-gep state ptr (CompilerIrValue.I64 0) (AstType.U8))
    [(LowerExpr first-gep-state first-addr _)
      (match (lower-emit-load first-gep-state first-addr (AstType.U8))
        [(LowerExpr first-load-state first-byte _)
          (match (lower-emit-cast
            first-load-state
            first-byte
            (AstType.U8)
            (AstType.I64))
            [(LowerExpr first-cast-state first-i64 _)
              (match (lower-emit-binop
                first-cast-state
                CompilerIrBinOp.Eq
                first-i64
                (CompilerIrValue.I64 45)
                (AstType.Bool))
                [(LowerExpr minus-test-state minus? _)
                  (let
                    [minus-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          minus-test-state
                          (CompilerIrInstr.Branch
                            minus?
                            minus-label
                            header-label))
                        minus-label)]
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            (lower-state-emit
                              minus-start
                              (CompilerIrInstr.Mov
                                negative-var
                                (CompilerIrValue.Bool true)
                                (AstType.Bool)))
                            (CompilerIrInstr.Mov
                              index-var
                              (CompilerIrValue.I64 1)
                              (AstType.I64)))
                          (CompilerIrInstr.Jump header-label))
                        header-label)]
                    (lower-inline-string-to-int-loop
                      header-start
                      ptr
                      len
                      body-label
                      apply-label
                      header-label
                      negate-label
                      done-label
                      value-var
                      index-var
                      negative-var
                      result-ty))])])])]))

(define (lower-inline-string-to-int-fields
  [state : LowerState]
  [ptr : CompilerIrValue]
  [len : CompilerIrValue]
  [result-ty : AstType]) : LowerExpr
  (match (lower-state-fresh-label state "string_to_int_sign")
    [(LowerLabel sign-label-state sign-label)
      (match (lower-state-fresh-label sign-label-state "string_to_int_minus")
        [(LowerLabel minus-label-state minus-label)
          (match (lower-state-fresh-label
            minus-label-state
            "string_to_int_header")
            [(LowerLabel header-label-state header-label)
              (match (lower-state-fresh-label
                header-label-state
                "string_to_int_body")
                [(LowerLabel body-label-state body-label)
                  (match (lower-state-fresh-label
                    body-label-state
                    "string_to_int_apply_sign")
                    [(LowerLabel apply-label-state apply-label)
                      (match (lower-state-fresh-label
                        apply-label-state
                        "string_to_int_negate")
                        [(LowerLabel negate-label-state negate-label)
                          (match (lower-state-fresh-label
                            negate-label-state
                            "string_to_int_done")
                            [(LowerLabel done-label-state done-label)
                              (match (lower-state-alloc-var done-label-state)
                                [(LowerAlloc value-alloc value-var)
                                  (match (lower-state-alloc-var value-alloc)
                                    [(LowerAlloc index-alloc index-var)
                                      (match (lower-state-alloc-var index-alloc)
                                        [(LowerAlloc
                                            negative-alloc
                                            negative-var)
                                          (match (lower-emit-binop
                                            (lower-state-emit
                                              (lower-state-emit
                                                (lower-state-emit
                                                  negative-alloc
                                                  (CompilerIrInstr.Mov
                                                    value-var
                                                    (CompilerIrValue.I64 0)
                                                    (AstType.I64)))
                                                (CompilerIrInstr.Mov
                                                  index-var
                                                  (CompilerIrValue.I64 0)
                                                  (AstType.I64)))
                                              (CompilerIrInstr.Mov
                                                negative-var
                                                (CompilerIrValue.Bool false)
                                                (AstType.Bool)))
                                            CompilerIrBinOp.Gt
                                            len
                                            (CompilerIrValue.I64 0)
                                            (AstType.Bool))
                                            [(LowerExpr
                                                nonempty-state
                                                nonempty
                                                _)
                                              (lower-inline-string-to-int-sign
                                                (lower-state-finish-block
                                                  (lower-state-emit
                                                    nonempty-state
                                                    (CompilerIrInstr.Branch
                                                      nonempty
                                                      sign-label
                                                      done-label))
                                                  sign-label)
                                                ptr
                                                len
                                                minus-label
                                                header-label
                                                body-label
                                                apply-label
                                                negate-label
                                                done-label
                                                value-var
                                                index-var
                                                negative-var
                                                result-ty)])])])])])])])])])])]))

(define (lower-string-to-int-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons arg tail)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Nil)
            (match (lower-expr ctx state env type-env arg)
              [(OkLowerExpr lowered)
                (match lowered
                  [(LowerExpr arg-state arg-value arg-ty)
                    (if (lower-string-handle-type? ctx arg-ty)
                      (match (lower-string-fields arg-state arg-value)
                        [(LowerStringFields fields-state ptr len)
                          (OkLowerExpr
                            (lower-inline-string-to-int-fields
                              fields-state
                              ptr
                              len
                              result-ty))])
                      (ErrLowerExpr
                        (box
                          (lower-diagnostic-at-expr
                            arg
                            "lower: string->int requires String"))))])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]
          [_
            (lower-direct-call
              ctx
              state
              env
              type-env
              "__tl_string_to_int"
              args
              result-ty
              origin)]))]
    [_
      (lower-direct-call
        ctx
        state
        env
        type-env
        "__tl_string_to_int"
        args
        result-ty
        origin)]))

(define (lower-int-to-string-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons arg tail)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Nil)
            (match (lower-expr ctx state env type-env arg)
              [(OkLowerExpr lowered)
                (match lowered
                  [(LowerExpr arg-state arg-value arg-ty)
                    (match (lower-cast-value
                      arg-state
                      arg-value
                      arg-ty
                      (AstType.I64))
                      [(LowerExpr cast-state cast-value _)
                        (lower-runtime-call-values
                          cast-state
                          "tl_int_to_string"
                          (compiler-ir-value-cons cast-value IrValueNil)
                          result-ty)])])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]
          [_
            (lower-direct-call
              ctx
              state
              env
              type-env
              "string.int->string"
              args
              result-ty
              origin)]))]
    [_
      (lower-direct-call
        ctx
        state
        env
        type-env
        "string.int->string"
        args
        result-ty
        origin)]))

(define (lower-string-eq-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons left tail)
      (let
        [left : AstExpr (ast-node-get left)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Cons right rest)
            (let
              [right : AstExpr (ast-node-get right)]
              [rest : AstExprList (box-get rest)]
              (match rest
                [(AstExprList.Nil)
                  (match (lower-expr ctx state env type-env left)
                    [(OkLowerExpr lowered-left)
                      (match lowered-left
                        [(LowerExpr left-state left-value _)
                          (match (lower-expr ctx left-state env type-env right)
                            [(OkLowerExpr lowered-right)
                              (match lowered-right
                                [(LowerExpr right-state right-value _)
                                  (match (lower-string-fields
                                    right-state
                                    left-value)
                                    [(LowerStringFields
                                        left-fields-state
                                        left-ptr
                                        left-len)
                                      (match (lower-string-fields
                                        left-fields-state
                                        right-value)
                                        [(LowerStringFields
                                            done-fields-state
                                            right-ptr
                                            right-len)
                                          (OkLowerExpr
                                            (lower-inline-string-eq-fields
                                              done-fields-state
                                              left-ptr
                                              left-len
                                              right-ptr
                                              right-len
                                              result-ty))])])])]
                            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)])]
                [_
                  (lower-direct-call
                    ctx
                    state
                    env
                    type-env
                    "__tl_string_eq"
                    args
                    result-ty
                    origin)]))]
          [_
            (lower-direct-call
              ctx
              state
              env
              type-env
              "__tl_string_eq"
              args
              result-ty
              origin)]))]
    [_
      (lower-direct-call
        ctx
        state
        env
        type-env
        "__tl_string_eq"
        args
        result-ty
        origin)]))

(define (lower-bootstrap-runtime-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (lower-private-string-eq-helper-call-name? type-env name)
    (lower-string-eq-call ctx state env type-env args result-ty origin)
    (if (tc-string-to-int-helper-call-name? ctx type-env name name)
      (lower-string-to-int-call ctx state env type-env args result-ty origin)
      (lower-direct-call ctx state env type-env name args result-ty origin))))

(define (lower-private-string-eq-helper-call-name?
  [type-env : TcTypeEnv]
  [name : String]) : bool
  (lower-private-string-eq-helper-call-id? type-env (tc-builtin-name-id name)))

(define (lower-private-string-eq-helper-call-id?
  [type-env : TcTypeEnv]
  [name-id : i64]) : bool
  (and
    (cbi.compiler-builtin-typecheck-string-eq-id? name-id)
    (tc-default-builtin-unshadowed-id? type-env name-id)))

;; Lower an unshadowed `(__tl_string_ref s i)` intrinsic call to the
;; bounds-checked String byte index, like the parser-owned `AstExpr.StringRef`
;; node.
(define (lower-string-ref-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons str tail)
      (let
        [str : AstExpr (ast-node-get str)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Cons index rest)
            (let
              [index : AstExpr (ast-node-get index)]
              [rest : AstExprList (box-get rest)]
              (match rest
                [(AstExprList.Nil)
                  (lower-string-ref ctx state env type-env str index)]
                [_
                  (lower-direct-call
                    ctx
                    state
                    env
                    type-env
                    name
                    args
                    result-ty
                    origin)]))]
          [_
            (lower-direct-call
              ctx
              state
              env
              type-env
              name
              args
              result-ty
              origin)]))]
    [_ (lower-direct-call ctx state env type-env name args result-ty origin)]))

(define (lower-module-lookup-name [ctx : TcContext] [name : String]) : String
  (let
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified? name)))
      (compiler-symbol-module-key module name)
      name)))

(define (lower-call-name-matches-nominal?
  [ctx : TcContext]
  [name : String]
  [nominal-name : String]) : bool
  (if (tc-name-qualified? name)
    (string.eq name nominal-name)
    (and
      (string.eq
        (tc-qualified-name-module nominal-name)
        (tc-context-module ctx))
      (string.eq name (tc-qualified-name-base nominal-name)))))

(define (lower-variant-constructor-lookup-name
  [ctx : TcContext]
  [name : String]
  [result-ty : AstType]) : String
  (match (tc-type-strip-region result-ty)
    [(AstType.Enum enum-name)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (if (or
          (tc-name-qualified? name)
          (string.eq
            (tc-qualified-name-module enum-name-str)
            (tc-context-module ctx)))
          (tc-source-variant-name-for-enum ctx enum-name-str name)
          (lower-module-lookup-name ctx name)))]
    [(AstType.EnumArgs enum-name _)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (if (or
          (tc-name-qualified? name)
          (string.eq
            (tc-qualified-name-module enum-name-str)
            (tc-context-module ctx)))
          (tc-source-variant-name-for-enum ctx enum-name-str name)
          (lower-module-lookup-name ctx name)))]
    [_ ""]))

(define (lower-call-non-builtin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (sym_i64_env.sym-i64-contains env name)
    (lower-direct-call ctx state env type-env name args result-ty origin)
    (let
      [source-name : String (lower-hygiene-source-name name)]
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [registries : CompilerRegistries (tc-context-registries ctx)]
      [variant-name : String
        (lower-variant-constructor-lookup-name ctx source-name result-ty)]
      [struct-name : String
        (match (tc-type-strip-region result-ty)
          [(AstType.Struct resolved-struct)
            (if (lower-call-name-matches-nominal?
              ctx
              source-name
              (intern-str resolved-struct))
              (intern-str resolved-struct)
              (lower-module-lookup-name ctx source-name))]
          [_ (lower-module-lookup-name ctx source-name)])]
      [variant-handle : i64
        (compiler-registries-lookup-variant-or
          registries
          variant-name
          (compiler-symbols-missing-handle))]
      [struct-handle : i64
        (compiler-symbols-lookup-type-or
          symbols
          struct-name
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? variant-handle)
        (lower-construct-enum-with-handle
          ctx
          state
          env
          type-env
          variant-name
          variant-handle
          args
          result-ty)
        (if (and
          (compiler-symbols-handle-found? struct-handle)
          (=
            (compiler-symbol-handle-kind struct-handle)
            (compiler-symbol-kind-defstruct)))
          (lower-construct-struct
            ctx
            state
            env
            type-env
            struct-name
            args
            result-ty)
          (lower-direct-call ctx state env type-env name args result-ty origin))))))

(define (lower-direct-store-target?
  [ctx : TcContext]
  [state : LowerState]
  [ty : AstType]) : bool
  (and
    (lower-mode-inline-aggregates? (lower-state-mode state))
    (lower-type-inline-struct-or-enum? ctx ty)
    (not (lower-type-register-resident? ctx ty))))

(define (lower-direct-store-result [result : ResultLowerState]) : LowerMaybeDirectStore
  (match result
    [(OkLowerState done-state) (LowerDirectStore done-state)]
    [(ErrLowerState message) (LowerDirectStoreErr message)]))

(define (lower-direct-constructor-call-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [_origin : AstExpr]) : LowerMaybeDirectStore
  (if (sym_i64_env.sym-i64-contains env name)
    (LowerNoDirectStore)
    (let
      [source-name : String (lower-hygiene-source-name name)]
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [registries : CompilerRegistries (tc-context-registries ctx)]
      [variant-name : String
        (lower-variant-constructor-lookup-name ctx source-name result-ty)]
      [struct-name : String
        (match (tc-type-strip-region result-ty)
          [(AstType.Struct resolved-struct)
            (if (lower-call-name-matches-nominal?
              ctx
              source-name
              (intern-str resolved-struct))
              (intern-str resolved-struct)
              (lower-module-lookup-name ctx source-name))]
          [(AstType.StructArgs resolved-struct _)
            (if (lower-call-name-matches-nominal?
              ctx
              source-name
              (intern-str resolved-struct))
              (intern-str resolved-struct)
              (lower-module-lookup-name ctx source-name))]
          [_ (lower-module-lookup-name ctx source-name)])]
      [variant-handle : i64
        (compiler-registries-lookup-variant-or
          registries
          variant-name
          (compiler-symbols-missing-handle))]
      [struct-handle : i64
        (compiler-symbols-lookup-type-or
          symbols
          struct-name
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? variant-handle)
        (lower-direct-store-result
          (lower-construct-enum-with-handle-into
            ctx
            state
            env
            type-env
            dst
            variant-name
            variant-handle
            args
            result-ty))
        (if (and
          (compiler-symbols-handle-found? struct-handle)
          (=
            (compiler-symbol-handle-kind struct-handle)
            (compiler-symbol-kind-defstruct)))
          (lower-direct-store-result
            (lower-construct-struct-into
              ctx
              state
              env
              type-env
              dst
              struct-name
              args
              result-ty))
          (LowerNoDirectStore))))))

(define (lower-direct-nullary-variant-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [name : String]
  [result-ty : AstType]) : LowerMaybeDirectStore
  (if (sym_i64_env.sym-i64-contains env name)
    (LowerNoDirectStore)
    (let
      [source-name : String (lower-hygiene-source-name name)]
      [registries : CompilerRegistries (tc-context-registries ctx)]
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [variant-name : String
        (lower-variant-constructor-lookup-name ctx source-name result-ty)]
      [handle : i64
        (compiler-registries-lookup-variant-or
          registries
          variant-name
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? handle)
        (match (compiler-registries-variant-fields-indexed symbols handle)
          [(ResultAstTypeList.Ok fields)
            (match fields
              [(AstTypeList.Nil)
                (lower-direct-store-result
                  (lower-construct-enum-with-handle-into
                    ctx
                    state
                    env
                    type-env
                    dst
                    variant-name
                    handle
                    AstExprList.Nil
                    result-ty))]
              [_ (LowerNoDirectStore)])]
          [(ResultAstTypeList.Err message)
            (LowerDirectStoreErr (box (lower-diagnostic message)))])
        (LowerNoDirectStore)))))

(define (lower-direct-init-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [maybe-ty : AstMaybeType]
  [result-ty : AstType]
  [origin : AstExpr]) : LowerMaybeDirectStore
  (match maybe-ty
    [(AstMaybeType.No)
      (lower-direct-store-result
        (lower-init-expr-into ctx state env type-env dst result-ty origin))]
    [(AstMaybeType.Some ty)
      (let
        [resolved-init : AstType
          (tc-type-without-regions (tc-resolve-type ctx ty))]
        [resolved-result : AstType
          (tc-type-without-regions (tc-resolve-type ctx result-ty))]
        (if (tc-type-eq resolved-init resolved-result)
          (lower-direct-store-result
            (lower-init-expr-into ctx state env type-env dst ty origin))
          (LowerNoDirectStore)))]))

(define (lower-direct-store-rhs-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [value : AstExpr]
  [result-ty : AstType]
  [origin : AstExpr]) : LowerMaybeDirectStore
  (if (lower-direct-store-target? ctx state result-ty)
    (match value
      [(AstExpr.Spanned inner-box _)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (lower-direct-store-rhs-into
            ctx
            state
            env
            type-env
            dst
            inner
            result-ty
            origin))]
      [(AstExpr.Ann inner-box _)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (lower-direct-store-rhs-into
            ctx
            state
            env
            type-env
            dst
            inner
            result-ty
            origin))]
      [(AstExpr.Init maybe-ty)
        (lower-direct-init-into
          ctx
          state
          env
          type-env
          dst
          maybe-ty
          result-ty
          origin)]
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (match (ast-expr-unspan func)
            [(AstExpr.Var name)
              (lower-direct-constructor-call-into
                ctx
                state
                env
                type-env
                dst
                (intern-str name)
                args
                result-ty
                origin)]
            [_ (LowerNoDirectStore)]))]
      [(AstExpr.Var name)
        (if (tc-dotted-local-field-name-id? type-env name)
          (LowerNoDirectStore)
          (lower-direct-nullary-variant-into
            ctx
            state
            env
            type-env
            dst
            (intern-str name)
            result-ty))]
      [_ (LowerNoDirectStore)])
    (LowerNoDirectStore)))

(define (lower-direct-store-rhs-at-offset
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [offset : i64]
  [value : AstExpr]
  [result-ty : AstType]
  [origin : AstExpr]) : LowerMaybeDirectStore
  (if (lower-direct-store-target? ctx state result-ty)
    (if (= offset 0)
      (lower-direct-store-rhs-into
        ctx
        state
        env
        type-env
        base
        value
        result-ty
        origin)
      (match (lower-gep-byte state base offset)
        [(LowerExpr ptr-state ptr _)
          (lower-direct-store-rhs-into
            ctx
            ptr-state
            env
            type-env
            ptr
            value
            result-ty
            origin)]))
    (LowerNoDirectStore)))

(define (lower-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (ast-expr-unspan func)
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-lambda-expr-allow-ref-captures
              ctx
              type-env
              params
              maybe-ret
              body)
              [(ResultTcType.Ok fn-ty)
                (match (lower-lambda
                  ctx
                  state
                  env
                  type-env
                  params
                  maybe-ret
                  body
                  func
                  fn-ty)
                  [(OkLowerExpr lowered-func)
                    (match lowered-func
                      [(LowerExpr func-state func-value _)
                        (lower-indirect-call
                          ctx
                          func-state
                          env
                          type-env
                          fn-ty
                          func-value
                          args
                          result-ty
                          origin)])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)])]
              [(ResultTcType.Err message)
                (ErrLowerExpr (box (lower-diagnostic-at-expr func message)))]))])]
    [(AstExpr.Var raw-name)
      ;; Builtins reached from a macro expansion arrive hygiene-renamed
      ;; (`__tl_macro_global$string.string-length`); strip the prefix so the builtin
      ;; dispatch below (length/string-length inline loads, etc.) fires just as it
      ;; does for hand-written calls. `raw-name` still keys the local-variable
      ;; lookup, and the generic call path strips the prefix itself.
      (let
        [raw-text : String (intern-str raw-name)]
        (if (tc-dotted-local-field-name? type-env raw-text)
          (match (lower-expr ctx state env type-env func)
            [(OkLowerExpr lowered-func)
              (match lowered-func
                [(LowerExpr func-state func-value func-ty)
                  (if (lower-function-type? func-ty)
                    (if (tc-expr-c-abi-fnptr? ctx type-env func)
                      (lower-indirect-c-abi-call
                        ctx
                        func-state
                        env
                        type-env
                        func-ty
                        func-value
                        args
                        result-ty
                        origin)
                      (lower-indirect-call
                        ctx
                        func-state
                        env
                        type-env
                        func-ty
                        func-value
                        args
                        result-ty
                        origin))
                    (ErrLowerExpr
                      (box
                        (lower-diagnostic-at-expr
                          func
                          "lower: call target is not a function"))))])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])
          (let
            [local-id : i64
              (sym_i64_env.sym-i64-lookup-or
                env
                (intern-str raw-name)
                (compiler-symbols-missing-handle))]
            (if (compiler-symbols-handle-found? local-id)
              (match (tc-lookup type-env (intern-str raw-name))
                [(ResultTcType.Ok fn-ty)
                  (if (lower-function-type? fn-ty)
                    (if (tc-binding-c-abi-fnptr-id? type-env raw-name)
                      (lower-indirect-c-abi-call
                        ctx
                        state
                        env
                        type-env
                        fn-ty
                        (CompilerIrValue.Var local-id)
                        args
                        result-ty
                        origin)
                      (lower-indirect-call
                        ctx
                        state
                        env
                        type-env
                        fn-ty
                        (CompilerIrValue.Var local-id)
                        args
                        result-ty
                        origin))
                    (ErrLowerExpr
                      (box
                        (lower-diagnostic-at-expr
                          func
                          "lower: call target is not a function"))))]
                [(ResultTcType.Err message)
                  (ErrLowerExpr (box (lower-diagnostic-at-expr func message)))])
              (let
                [hygiene-global : bool (tc-hygiene-global-name? raw-text)]
                (match (if hygiene-global
                  (ResultTcString.Ok (tc-hygiene-global-call-name raw-text))
                  (lower-source-name-lookup-key ctx type-env raw-text))
                  [(ResultTcString.Ok name)
                    ;; `array-length`/`length` on a dynamic array and private
                    ;; string intrinsics load fat-value fields directly instead of
                    ;; calling runtime symbols. Other `length` argument types keep
                    ;; the ordinary direct-call path.
                    (let
                      [source-name : String
                        (if hygiene-global
                          (tc-hygiene-global-call-name raw-text)
                          raw-text)]
                      [lowered-name : String
                        (if hygiene-global
                          (lower-hygiene-source-name-in-context
                            ctx
                            type-env
                            raw-text)
                          name)]
                      [source-id : i64
                        (if hygiene-global
                          (intern source-name)
                          raw-name)]
                      [name-id : i64 (intern name)]
                      [builtin-available : bool
                        (not (lower-top-level-value-defined? ctx name))]
                      [atomic-symbol : String
                        (lower-atomic-extern-symbol-for-name ctx name)]
                      (cond
                        [(> (string.string-length atomic-symbol) 0)
                          (lower-atomic-call
                            ctx
                            state
                            env
                            type-env
                            atomic-symbol
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (lower-atomic-pointer-name? name))
                          (lower-atomic-pointer-call
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty
                            origin)]
                        [(and builtin-available (tc-layout-query-name? name))
                          (ErrLowerExpr
                            (box
                              (lower-diagnostic-at-expr
                                origin
                                (string.append
                                  "lower: "
                                  (string.append
                                    name
                                    " is compile-time only; wrap it in (comptime ...)")))))]
                        [(tc-string-ref-helper-call-id?
                            ctx
                            type-env
                            source-id
                            name-id)
                          (lower-string-ref-call
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty
                            origin)]
                        [(tc-string-length-helper-call-id?
                            ctx
                            type-env
                            source-id
                            name-id)
                          (lower-array-length
                            ctx
                            state
                            env
                            type-env
                            "__tl_string_length"
                            args
                            result-ty
                            origin)]
                        [(lower-private-string-eq-helper-call-id?
                            type-env
                            name-id)
                          (lower-string-eq-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(tc-string-to-int-helper-call-id? type-env name-id)
                          (lower-string-to-int-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-string-ref-call-id?
                              name-id))
                          (lower-string-ref-call
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-length-call-id? name-id))
                          (lower-array-length
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (lower-string-runtime-builtin? name))
                          (lower-string-runtime-call
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-cpuid-id? name-id))
                          (lower-cpuid-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-xgetbv-id? name-id))
                          (lower-xgetbv-call ctx state env type-env args origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-clone-id? name-id))
                          (match args
                            [(AstExprList.Cons arg tail)
                              (let
                                [arg : AstExpr (ast-node-get arg)]
                                [tail : AstExprList (box-get tail)]
                                (match tail
                                  [(AstExprList.Nil)
                                    (lower-clone-call
                                      ctx
                                      state
                                      env
                                      type-env
                                      arg)]
                                  [_
                                    (ErrLowerExpr
                                      (box
                                        (lower-diagnostic
                                          "lower: clone expects one argument")))]))]
                            [_
                              (ErrLowerExpr
                                (box
                                  (lower-diagnostic
                                    "lower: clone expects one argument")))])]
                        [(and
                            builtin-available
                            (lower-arena-builtin-id? name-id))
                          (lower-arena-builtin-call
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-tls-current-arena-id?
                              name-id))
                          (lower-tls-current-arena-call
                            ctx
                            state
                            env
                            type-env
                            name-id
                            args
                            result-ty)]
                        [(and
                            builtin-available
                            (lower-bootstrap-runtime-builtin-id? name-id))
                          (lower-bootstrap-runtime-call
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty
                            origin)]
                        [(lower-comptime-error-source-or-lookup-id?
                            source-id
                            name-id)
                          (ErrLowerExpr
                            (box
                              (lower-diagnostic-at-expr
                                origin
                                "lower: comptime-error is compile-time only")))]
                        [else
                          (lower-call-non-builtin
                            ctx
                            state
                            env
                            type-env
                            lowered-name
                            args
                            result-ty
                            origin)]))]
                  [(ResultTcString.Err message)
                    (ErrLowerExpr
                      (box (lower-diagnostic-at-expr origin message)))]))))))]
    [_
      (match (lower-expr ctx state env type-env func)
        [(OkLowerExpr lowered-func)
          (match lowered-func
            [(LowerExpr func-state func-value func-ty)
              (if (lower-function-type? func-ty)
                (if (tc-expr-c-abi-fnptr? ctx type-env func)
                  (lower-indirect-c-abi-call
                    ctx
                    func-state
                    env
                    type-env
                    func-ty
                    func-value
                    args
                    result-ty
                    origin)
                  (lower-indirect-call
                    ctx
                    func-state
                    env
                    type-env
                    func-ty
                    func-value
                    args
                    result-ty
                    origin))
                (ErrLowerExpr
                  (box
                    (lower-diagnostic-at-expr
                      func
                      "lower: call target is not a function"))))])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]))

;; A dynamic-array value is a pointer to inline fat storage `{data_ptr, length}`
;; with the i64 length at byte offset 8. `Gep` scales the index by the element
;; size, so index 1 with element type i64 addresses that length field, which a
;; typed `Load` then reads. Dynamic-array calls and private string.string-length calls
;; are intercepted; other `length` arguments fall back to the direct-call path.
(define (lower-array-length
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons arr tail)
      (let
        [arr : AstExpr (ast-node-get arr)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Nil)
            (match (lower-expr-result-type-fast
              ctx
              env
              type-env
              (lower-state-type-cache state)
              arr)
              [(ResultTcType.Ok arr-ty)
                (lower-array-length-with-type
                  ctx
                  state
                  env
                  type-env
                  name
                  args
                  result-ty
                  origin
                  arr
                  arr-ty)]
              [(ResultTcType.Err _)
                (match (tc-expr ctx type-env arr)
                  [(ResultTcType.Ok arr-ty)
                    (lower-array-length-with-type
                      ctx
                      state
                      env
                      type-env
                      name
                      args
                      result-ty
                      origin
                      arr
                      arr-ty)]
                  [(ResultTcType.Err _)
                    (lower-direct-call
                      ctx
                      state
                      env
                      type-env
                      name
                      args
                      result-ty
                      origin)])])]
          [_
            (lower-direct-call
              ctx
              state
              env
              type-env
              name
              args
              result-ty
              origin)]))]
    [_ (lower-direct-call ctx state env type-env name args result-ty origin)]))

(define (lower-array-length-with-type
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]
  [arr : AstExpr]
  [arr-ty : AstType]) : ResultLowerExpr
  (match (tc-array-length-receiver ctx arr-ty)
    [(ResultTcArrayReceiver.Ok _)
      (lower-array-length-load ctx state env type-env arr)]
    [(ResultTcArrayReceiver.Err _)
      (if (and
        (cbi.compiler-builtin-typecheck-string-length-id? (intern name))
        (lower-length-handle-type? ctx arr-ty))
        (lower-array-length-load ctx state env type-env arr)
        (lower-direct-call ctx state env type-env name args result-ty origin))]))

(define (lower-array-length-load
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arr)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr arr-state arr-value _)
          (match (lower-state-alloc-var arr-state)
            [(LowerAlloc gep-alloc gep-var)
              (let
                [gep-state : LowerState
                  (lower-state-emit
                    gep-alloc
                    (CompilerIrInstr.Gep
                      gep-var
                      arr-value
                      (CompilerIrValue.I64 1)
                      (AstType.I64)))]
                (match (lower-state-alloc-var gep-state)
                  [(LowerAlloc load-alloc load-var)
                    (OkLowerExpr
                      (LowerExpr
                        (lower-state-emit
                          load-alloc
                          (CompilerIrInstr.Load
                            load-var
                            (CompilerIrValue.Var gep-var)
                            (AstType.I64)))
                        (CompilerIrValue.Var load-var)
                        (AstType.I64)))]))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-string-data
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [str : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env str)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr str-state str-value _)
          (match (lower-load-at-offset str-state str-value 0 result-ty)
            [(LowerExpr data-state data-value _)
              (OkLowerExpr (LowerExpr data-state data-value result-ty))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-array-data
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [array : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env array)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr array-state array-value array-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
            [(AstType.DynArray _)
              (match (lower-load-at-offset array-state array-value 0 result-ty)
                [(LowerExpr data-state data-value _)
                  (OkLowerExpr (LowerExpr data-state data-value result-ty))])]
            [(AstType.Array _ _)
              (OkLowerExpr
                (lower-cast-value array-state array-value array-ty result-ty))]
            [_
              (ErrLowerExpr
                (box (lower-diagnostic "lower: array-data requires array")))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-string-from-bytes
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [ptr : AstExpr]
  [len : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env ptr)
    [(OkLowerExpr ptr-lowered)
      (match ptr-lowered
        [(LowerExpr ptr-state ptr-value ptr-ty)
          (match (lower-integer-expr-with-expected-or-actual
            ctx
            ptr-state
            env
            type-env
            len
            (AstType.I64)
            "lower: string-from-bytes length must be integer")
            [(OkLowerExpr len-lowered)
              (match len-lowered
                [(LowerExpr len-state len-value len-ty)
                  (match (lower-cast-value
                    len-state
                    len-value
                    len-ty
                    (AstType.I64))
                    [(LowerExpr len-i-state len-i-value _)
                      (match (lower-reserve-heap-storage
                        len-i-state
                        16
                        (AstType.String))
                        [(LowerExpr base-state base-value _)
                          (let
                            [with-ptr : LowerState
                              (lower-store-at-offset
                                base-state
                                base-value
                                0
                                ptr-value
                                (lower-raw-pointer-ir-type ptr-ty))]
                            [with-len : LowerState
                              (lower-store-at-offset
                                with-ptr
                                base-value
                                8
                                len-i-value
                                (AstType.I64))]
                            (OkLowerExpr
                              (LowerExpr with-len base-value (AstType.String))))])])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-entry-load
  [state : LowerState]
  [kind : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (let
        [instr : CompilerIrInstr
          (if (= kind 0)
            (CompilerIrInstr.EntryArgc var-id)
            (if (= kind 1)
              (CompilerIrInstr.EntryArgv var-id)
              (CompilerIrInstr.EntryEnvp var-id)))]
        (OkLowerExpr
          (LowerExpr
            (lower-state-emit allocated instr)
            (CompilerIrValue.Var var-id)
            result-ty)))]))

(define (lower-cpuid-like
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [leaf : AstExpr]
  [subleaf : AstExpr]
  [reg-index : i64]) : ResultLowerExpr
  (match (lower-integer-expr-with-expected-or-actual
    ctx
    state
    env
    type-env
    leaf
    (AstType.I64)
    "lower: cpuid leaf must be integer")
    [(OkLowerExpr leaf-lowered)
      (match leaf-lowered
        [(LowerExpr leaf-state leaf-value leaf-ty)
          (match (lower-cast-value leaf-state leaf-value leaf-ty (AstType.I64))
            [(LowerExpr leaf-i-state leaf-i-value _)
              (match (lower-integer-expr-with-expected-or-actual
                ctx
                leaf-i-state
                env
                type-env
                subleaf
                (AstType.I64)
                "lower: cpuid subleaf must be integer")
                [(OkLowerExpr subleaf-lowered)
                  (match subleaf-lowered
                    [(LowerExpr subleaf-state subleaf-value subleaf-ty)
                      (match (lower-cast-value
                        subleaf-state
                        subleaf-value
                        subleaf-ty
                        (AstType.I64))
                        [(LowerExpr subleaf-i-state subleaf-i-value _)
                          (match (lower-state-alloc-var subleaf-i-state)
                            [(LowerAlloc allocated var-id)
                              (OkLowerExpr
                                (LowerExpr
                                  (lower-state-emit
                                    allocated
                                    (CompilerIrInstr.CpuId
                                      var-id
                                      leaf-i-value
                                      subleaf-i-value
                                      reg-index))
                                  (CompilerIrValue.Var var-id)
                                  (AstType.I64)))])])])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-xgetbv
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : AstExpr]) : ResultLowerExpr
  (match (lower-integer-expr-with-expected-or-actual
    ctx
    state
    env
    type-env
    index
    (AstType.I64)
    "lower: xgetbv index must be integer")
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr index-state index-value index-ty)
          (match (lower-cast-value
            index-state
            index-value
            index-ty
            (AstType.I64))
            [(LowerExpr index-i-state index-i-value _)
              (match (lower-state-alloc-var index-i-state)
                [(LowerAlloc allocated var-id)
                  (OkLowerExpr
                    (LowerExpr
                      (lower-state-emit
                        allocated
                        (CompilerIrInstr.Xgetbv var-id index-i-value))
                      (CompilerIrValue.Var var-id)
                      (AstType.I64)))])])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-cpuid-store-field
  [state : LowerState]
  [base : CompilerIrValue]
  [leaf : CompilerIrValue]
  [subleaf : CompilerIrValue]
  [reg-index : i64]
  [offset : i64]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (lower-store-at-offset
        (lower-state-emit
          allocated
          (CompilerIrInstr.CpuId var-id leaf subleaf reg-index))
        base
        offset
        (CompilerIrValue.Var var-id)
        (AstType.I32))]))

(define (lower-cpuid-tuple-values
  [ctx : TcContext]
  [state : LowerState]
  [leaf : CompilerIrValue]
  [subleaf : CompilerIrValue]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-resolve-type ctx result-ty)
    [(AstType.Tuple elem-tys)
      (match (lower-reserve-heap-storage
        state
        (lower-type-list-storage-size ctx (box-get elem-tys))
        result-ty)
        [(LowerExpr base-state base _)
          (let
            [eax-state : LowerState
              (lower-cpuid-store-field base-state base leaf subleaf 0 0)]
            [ebx-state : LowerState
              (lower-cpuid-store-field eax-state base leaf subleaf 1 4)]
            [ecx-state : LowerState
              (lower-cpuid-store-field ebx-state base leaf subleaf 2 8)]
            [edx-state : LowerState
              (lower-cpuid-store-field ecx-state base leaf subleaf 3 12)]
            (OkLowerExpr (LowerExpr edx-state base result-ty)))])]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr origin "lower: cpuid requires tuple result")))]))

(define (lower-cpuid-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons leaf tail)
      (let
        [leaf : AstExpr (ast-node-get leaf)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Cons subleaf rest)
            (let
              [subleaf : AstExpr (ast-node-get subleaf)]
              [rest : AstExprList (box-get rest)]
              (match rest
                [(AstExprList.Nil)
                  (match (lower-integer-expr-with-expected-or-actual
                    ctx
                    state
                    env
                    type-env
                    leaf
                    (AstType.I64)
                    "lower: cpuid leaf must be integer")
                    [(OkLowerExpr leaf-lowered)
                      (match leaf-lowered
                        [(LowerExpr leaf-state leaf-value leaf-ty)
                          (match (lower-cast-value
                            leaf-state
                            leaf-value
                            leaf-ty
                            (AstType.I64))
                            [(LowerExpr leaf-i-state leaf-i-value _)
                              (match (lower-integer-expr-with-expected-or-actual
                                ctx
                                leaf-i-state
                                env
                                type-env
                                subleaf
                                (AstType.I64)
                                "lower: cpuid subleaf must be integer")
                                [(OkLowerExpr subleaf-lowered)
                                  (match subleaf-lowered
                                    [(LowerExpr
                                        subleaf-state
                                        subleaf-value
                                        subleaf-ty)
                                      (match (lower-cast-value
                                        subleaf-state
                                        subleaf-value
                                        subleaf-ty
                                        (AstType.I64))
                                        [(LowerExpr
                                            subleaf-i-state
                                            subleaf-i-value
                                            _)
                                          (lower-cpuid-tuple-values
                                            ctx
                                            subleaf-i-state
                                            leaf-i-value
                                            subleaf-i-value
                                            result-ty
                                            origin)])])]
                                [(ErrLowerExpr message) (ErrLowerExpr message)])])])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)])]
                [_
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic "lower: cpuid expects two arguments")))]))]
          [_
            (ErrLowerExpr
              (box (lower-diagnostic "lower: cpuid expects two arguments")))]))]
    [_
      (ErrLowerExpr
        (box (lower-diagnostic "lower: cpuid expects two arguments")))]))

(define (lower-xgetbv-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons index tail)
      (let
        [index : AstExpr (ast-node-get index)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprList.Nil) (lower-xgetbv ctx state env type-env index)]
          [_
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: xgetbv expects one argument")))]))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr origin "lower: xgetbv expects one argument")))]))

;; Small emit helpers: allocate a fresh var, emit one instruction, and return a
;; `LowerExpr` carrying the updated state plus the result value. These flatten
;; the otherwise deeply-nested alloc/emit chains in the array-access lowering.
(define (lower-emit-cast
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.Cast v value from-ty to-ty))
        (CompilerIrValue.Var v)
        to-ty)]))

(define (lower-emit-gep
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [gep-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.Gep v base index gep-ty))
        (CompilerIrValue.Var v)
        gep-ty)]))

(define (lower-emit-load
  [state : LowerState]
  [addr : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.Load v addr ty))
        (CompilerIrValue.Var v)
        ty)]))

(define (lower-emit-binop
  [state : LowerState]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.BinOp v op lhs rhs ty))
        (CompilerIrValue.Var v)
        ty)]))

(define (lower-emit-bounds-check
  [state : LowerState]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : LowerState
  (match (lower-state-fresh-label state "bounds_ok")
    [(LowerLabel bounds-ok-state bounds-ok-label)
      (lower-state-emit
        bounds-ok-state
        (CompilerIrInstr.BoundsCheck index length bounds-ok-label))]))

;; #1867/#3580: address an array element, striding by the element's full inline
;; size. Memory aggregates use a byte-offset GEP so fixed arrays, structs, and
;; enums use their real layout size instead of an address-sized backend scale.
;; Scalars and pointer-slot handles keep the type-scaled GEP.
(define (lower-emit-elem-addr-gep
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [idx-off : CompilerIrValue]
  [elem-ty : AstType]) : LowerExpr
  (if (lower-type-inline-storage? ctx elem-ty)
    (match (lower-emit-binop
      state
      CompilerIrBinOp.Mul
      idx-off
      (CompilerIrValue.I64 (lower-type-size ctx elem-ty))
      (AstType.I64))
      [(LowerExpr mul-state byte-off _)
        (lower-emit-gep mul-state base byte-off (AstType.U8))])
    (lower-emit-gep state base idx-off elem-ty)))

;; Tail of `lower-array-element-addr`: after the explicit bounds check, load the
;; buffer pointer (fat offset 0, a raw U64 address) and Gep it by the index to
;; the element address (striding by the real inline element size).
(define (lower-array-element-addr-finish
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [idx-off : CompilerIrValue]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-emit-gep state arr-value (CompilerIrValue.I64 0) (AstType.I64))
    [(LowerExpr buf-gep-state buf-gep _)
      (match (lower-emit-load buf-gep-state buf-gep (AstType.U64))
        [(LowerExpr buf-state buf-val _)
          (lower-emit-elem-addr-gep ctx buf-state buf-val idx-off elem-ty)])]))

;; Compute the address of element `idx-value` in dynamic array `arr-value`,
;; emitting an unsigned bounds check (negative indices wrap large and also
;; fail). Returns the element pointer as an `elem-ty`-typed value.
(define (lower-array-element-addr
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [idx-value : CompilerIrValue]
  [idx-ty : AstType]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-emit-cast state idx-value idx-ty (AstType.U64))
    [(LowerExpr s1 idx-u _)
      (match (lower-emit-cast s1 idx-value idx-ty (AstType.I64))
        [(LowerExpr s2 idx-off _)
          (match (lower-emit-gep
            s2
            arr-value
            (CompilerIrValue.I64 1)
            (AstType.I64))
            [(LowerExpr s3 len-gep _)
              (match (lower-emit-load s3 len-gep (AstType.I64))
                [(LowerExpr s4 len-val _)
                  (match (lower-emit-cast
                    s4
                    len-val
                    (AstType.I64)
                    (AstType.U64))
                    [(LowerExpr s5 len-u _)
                      (lower-array-element-addr-finish
                        ctx
                        (lower-emit-bounds-check s5 idx-u len-u)
                        arr-value
                        idx-off
                        elem-ty)])])])])]))

(define (lower-atomic-elem-type [symbol : String]) : AstType
  (if (or
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add"))
    (AstType.I32)
    (AstType.I64)))

(define (lower-atomic-raw-symbol [symbol : String]) : String
  (cond
    [(string.eq symbol "tl_atomic_i64_load") "tl_atomic_i64_load_ptr"]
    [(string.eq symbol "tl_atomic_i64_store") "tl_atomic_i64_store_ptr"]
    [(string.eq symbol "tl_atomic_i64_add") "tl_atomic_i64_add_ptr"]
    [(string.eq symbol "tl_atomic_i64_fetch_add") "tl_atomic_i64_fetch_add_ptr"]
    [(string.eq symbol "tl_atomic_i32_load") "tl_atomic_i32_load_ptr"]
    [(string.eq symbol "tl_atomic_i32_store") "tl_atomic_i32_store_ptr"]
    [(string.eq symbol "tl_atomic_i32_add") "tl_atomic_i32_add_ptr"]
    [else "tl_atomic_i32_fetch_add_ptr"]))

(define (lower-atomic-pointer-name? [name : String]) : bool
  (or
    (string.eq name "atomic-load")
    (string.eq name "atomic-store!")
    (string.eq name "atomic-add!")
    (string.eq name "atomic-fetch-add!")
    (string.eq name "atomic-cas!")))

(define (lower-atomic-pointer-func? [type-env : TcTypeEnv] [func : AstExpr]) : bool
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [raw-text : String (intern-str raw-name)]
        [name : String
          (if (tc-hygiene-global-name? raw-text)
            (tc-hygiene-global-call-name raw-text)
            raw-text)]
        (and
          (lower-atomic-pointer-name? name)
          (not (tc-name-bound? type-env name))))]
    [_ false]))

(define (lower-atomic-pointer-load-name? [name : String]) : bool
  (string.eq name "atomic-load"))

(define (lower-atomic-pointer-cas-name? [name : String]) : bool
  (string.eq name "atomic-cas!"))

(define (lower-atomic-pointer-width-prefix [elem-ty : AstType]) : String
  (match (tc-type-strip-region elem-ty)
    [(AstType.I32) "tl_atomic_i32_"]
    [(AstType.U32) "tl_atomic_i32_"]
    [_ "tl_atomic_i64_"]))

(define (lower-atomic-pointer-op-suffix [name : String]) : String
  (cond
    [(string.eq name "atomic-load") "load_ptr"]
    [(string.eq name "atomic-store!") "store_ptr"]
    [(string.eq name "atomic-add!") "add_ptr"]
    [(string.eq name "atomic-fetch-add!") "fetch_add_ptr"]
    [else "cas_ptr"]))

(define (lower-atomic-pointer-raw-symbol [name : String] [elem-ty : AstType]) : String
  (str_cat.str-cat
    (lower-atomic-pointer-width-prefix elem-ty)
    (lower-atomic-pointer-op-suffix name)
    ""
    ""))

(define (lower-atomic-pointer-elem
  [ctx : TcContext]
  [name : String]
  [ptr-ty : AstType]) : ResultTcType
  (tc-atomic-pointer-elem ctx name ptr-ty))

(define (lower-atomic-pointer-emit-load
  [ctx : TcContext]
  [state : LowerState]
  [name : String]
  [ptr : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (OkLowerExpr
        (LowerExpr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (CompilerIrCallArgs.One ptr)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-emit-update
  [ctx : TcContext]
  [state : LowerState]
  [name : String]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (OkLowerExpr
        (LowerExpr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (CompilerIrCallArgs.Two ptr value)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-emit-cas
  [ctx : TcContext]
  [state : LowerState]
  [name : String]
  [ptr : CompilerIrValue]
  [expected : CompilerIrValue]
  [new-value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (OkLowerExpr
        (LowerExpr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (compiler-ir-call-args-from-list
                (compiler-ir-value-cons
                  ptr
                  (compiler-ir-value-cons
                    expected
                    (compiler-ir-value-cons new-value (IrValueNil)))))
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-update-tail
  [ctx : TcContext]
  [state : LowerState]
  [name : String]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]
  [tail : AstExprList]) : ResultLowerExpr
  (match tail
    [(AstExprList.Nil)
      (lower-atomic-pointer-emit-update
        ctx
        state
        name
        ptr
        value
        elem-ty
        result-ty
        origin)]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic
            "lower: atomic update expects exactly two arguments")))]))

(define (lower-atomic-pointer-cas-tail
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [ptr : CompilerIrValue]
  [expected : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]
  [tail : AstExprList]) : ResultLowerExpr
  (match tail
    [(AstExprList.Cons new-node tail2)
      (let
        [new-value : AstExpr (ast-node-get new-node)]
        [tail2 : AstExprList (box-get tail2)]
        (match tail2
          [(AstExprList.Nil)
            (match (lower-expr-expected
              ctx
              state
              env
              type-env
              new-value
              elem-ty
              new-value)
              [(OkLowerExpr new-lowered)
                (match new-lowered
                  [(LowerExpr new-state new-ir _)
                    (lower-atomic-pointer-emit-cas
                      ctx
                      new-state
                      name
                      ptr
                      expected
                      new-ir
                      elem-ty
                      result-ty
                      origin)])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]
          [_
            (ErrLowerExpr
              (box
                (lower-diagnostic
                  "lower: atomic-cas! expects exactly three arguments")))]))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic
            "lower: atomic-cas! expects exactly three arguments")))]))

(define (lower-atomic-pointer-nonload-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [ptr : CompilerIrValue]
  [elem-ty : AstType]
  [tail0 : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match tail0
    [(AstExprList.Cons value-node tail1)
      (let
        [value : AstExpr (ast-node-get value-node)]
        [tail1 : AstExprList (box-get tail1)]
        (match (lower-expr-expected ctx state env type-env value elem-ty value)
          [(OkLowerExpr value-lowered)
            (match value-lowered
              [(LowerExpr value-state value-ir _)
                (if (lower-atomic-pointer-cas-name? name)
                  (lower-atomic-pointer-cas-tail
                    ctx
                    value-state
                    env
                    type-env
                    name
                    ptr
                    value-ir
                    elem-ty
                    result-ty
                    origin
                    tail1)
                  (lower-atomic-pointer-update-tail
                    ctx
                    value-state
                    name
                    ptr
                    value-ir
                    elem-ty
                    result-ty
                    origin
                    tail1))])]
          [(ErrLowerExpr message) (ErrLowerExpr message)]))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic
            (if (lower-atomic-pointer-cas-name? name)
              "lower: atomic-cas! expects exactly three arguments"
              "lower: atomic update expects exactly two arguments"))))]))

(define (lower-atomic-pointer-call-with-elem
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [ptr-ty : AstType]
  [elem-ty : AstType]
  [tail0 : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-expr-expected ctx state env type-env ptr ptr-ty ptr)
    [(OkLowerExpr ptr-lowered)
      (match ptr-lowered
        [(LowerExpr ptr-state ptr-ir _)
          (if (lower-atomic-pointer-load-name? name)
            (match tail0
              [(AstExprList.Nil)
                (lower-atomic-pointer-emit-load
                  ctx
                  ptr-state
                  name
                  ptr-ir
                  elem-ty
                  result-ty
                  origin)]
              [_
                (ErrLowerExpr
                  (box
                    (lower-diagnostic
                      "lower: atomic-load expects exactly one argument")))])
            (lower-atomic-pointer-nonload-call
              ctx
              ptr-state
              env
              type-env
              name
              ptr-ir
              elem-ty
              tail0
              result-ty
              origin))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-atomic-pointer-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args
    [(AstExprList.Cons ptr-node tail0)
      (let
        [ptr : AstExpr (ast-node-get ptr-node)]
        [tail0 : AstExprList (box-get tail0)]
        (match (tc-expr ctx type-env ptr)
          [(ResultTcType.Ok ptr-ty)
            (match (lower-atomic-pointer-elem ctx name ptr-ty)
              [(ResultTcType.Ok elem-ty)
                (lower-atomic-pointer-call-with-elem
                  ctx
                  state
                  env
                  type-env
                  name
                  ptr
                  ptr-ty
                  elem-ty
                  tail0
                  result-ty
                  origin)]
              [(ResultTcType.Err message)
                (ErrLowerExpr (box (lower-diagnostic-at-expr ptr message)))])]
          [(ResultTcType.Err message)
            (ErrLowerExpr (box (lower-diagnostic-at-expr ptr message)))]))]
    [(AstExprList.Nil)
      (ErrLowerExpr
        (box
          (lower-diagnostic
            (if (lower-atomic-pointer-load-name? name)
              "lower: atomic-load expects exactly one argument"
              (if (lower-atomic-pointer-cas-name? name)
                "lower: atomic-cas! expects exactly three arguments"
                "lower: atomic update expects exactly two arguments")))))]))

(define (lower-atomic-load-symbol? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i32_load")))

(define (lower-atomic-emit-load
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [symbol : String]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (OkLowerExpr
        (LowerExpr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-raw-symbol symbol)
              (CompilerIrCallArgs.One ptr)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-emit-update
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [symbol : String]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc allocated var-id)
      (OkLowerExpr
        (LowerExpr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-raw-symbol symbol)
              (CompilerIrCallArgs.Two ptr value)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-array-element-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [array : AstExpr]
  [index : AstExpr]
  [elem-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    state
    env
    type-env
    array
    (ast-ty-dyn-array elem-ty)
    array)
    [(OkLowerExpr arr-lowered)
      (match arr-lowered
        [(LowerExpr arr-state arr-value _)
          (match (lower-index-result-type-or-check
            ctx
            env
            type-env
            (lower-state-type-cache arr-state)
            index)
            [(ResultTcType.Ok idx-ty)
              (match (lower-expr-expected
                ctx
                arr-state
                env
                type-env
                index
                idx-ty
                index)
                [(OkLowerExpr idx-lowered)
                  (match idx-lowered
                    [(LowerExpr idx-state idx-value idx-value-ty)
                      (OkLowerExpr
                        (lower-array-element-addr
                          ctx
                          idx-state
                          arr-value
                          idx-value
                          idx-value-ty
                          elem-ty))])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])]
            [(ResultTcType.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr index message)))])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-atomic-call-load
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [symbol : String]
  [array : AstExpr]
  [index : AstExpr]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-atomic-array-element-address
    ctx
    state
    env
    type-env
    array
    index
    elem-ty)
    [(OkLowerExpr addr)
      (match addr
        [(LowerExpr addr-state ptr _)
          (lower-atomic-emit-load ctx addr-state ptr symbol result-ty origin)])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-atomic-call-update
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [symbol : String]
  [array : AstExpr]
  [index : AstExpr]
  [value : AstExpr]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-atomic-array-element-address
    ctx
    state
    env
    type-env
    array
    index
    elem-ty)
    [(OkLowerExpr addr)
      (match addr
        [(LowerExpr addr-state ptr _)
          (match (lower-expr-expected
            ctx
            addr-state
            env
            type-env
            value
            elem-ty
            value)
            [(OkLowerExpr value-lowered)
              (match value-lowered
                [(LowerExpr value-state value-ir _)
                  (lower-atomic-emit-update
                    ctx
                    value-state
                    ptr
                    value-ir
                    symbol
                    result-ty
                    origin)])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-atomic-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [symbol : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [elem-ty : AstType (lower-atomic-elem-type symbol)]
    (match args
      [(AstExprList.Cons array-node tail0)
        (let
          [array : AstExpr (ast-node-get array-node)]
          [tail0 : AstExprList (box-get tail0)]
          (match tail0
            [(AstExprList.Cons index-node tail1)
              (let
                [index : AstExpr (ast-node-get index-node)]
                [tail1 : AstExprList (box-get tail1)]
                (if (lower-atomic-load-symbol? symbol)
                  (match tail1
                    [(AstExprList.Nil)
                      (lower-atomic-call-load
                        ctx
                        state
                        env
                        type-env
                        symbol
                        array
                        index
                        elem-ty
                        result-ty
                        origin)]
                    [_
                      (ErrLowerExpr
                        (box
                          (lower-diagnostic
                            "lower: atomic load expects two arguments")))])
                  (match tail1
                    [(AstExprList.Cons value-node tail2)
                      (let
                        [value : AstExpr (ast-node-get value-node)]
                        [tail2 : AstExprList (box-get tail2)]
                        (match tail2
                          [(AstExprList.Nil)
                            (lower-atomic-call-update
                              ctx
                              state
                              env
                              type-env
                              symbol
                              array
                              index
                              value
                              elem-ty
                              result-ty
                              origin)]
                          [_
                            (ErrLowerExpr
                              (box
                                (lower-diagnostic
                                  "lower: atomic update expects three arguments")))]))]
                    [(AstExprList.Nil)
                      (ErrLowerExpr
                        (box
                          (lower-diagnostic
                            "lower: atomic update expects three arguments")))])))]
            [(AstExprList.Nil)
              (ErrLowerExpr
                (box
                  (lower-diagnostic
                    "lower: atomic helper expects at least two arguments")))]))]
      [(AstExprList.Nil)
        (ErrLowerExpr
          (box (lower-diagnostic "lower: atomic helper expects arguments")))])))

;; Fixed arrays are inline element storage. Bounds check against the static
;; length, then Gep directly from the array handle without loading dynamic-array
;; fat fields.
(define (lower-fixed-array-element-addr
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [idx-value : CompilerIrValue]
  [idx-ty : AstType]
  [elem-ty : AstType]
  [elem-count : i64]) : LowerExpr
  (match (lower-emit-cast state idx-value idx-ty (AstType.U64))
    [(LowerExpr s1 idx-u _)
      (match (lower-emit-cast s1 idx-value idx-ty (AstType.I64))
        [(LowerExpr s2 idx-off _)
          (lower-emit-elem-addr-gep
            ctx
            (lower-emit-bounds-check s2 idx-u (CompilerIrValue.I64 elem-count))
            arr-value
            idx-off
            elem-ty)])]))

;; `(make-array T len)` -> checked length, `tl_alloc` element buffer, and a
;; heap-backed dynamic-array fat value `{ ptr, len }`.
(define (lower-make-array-store-fat
  [state : LowerState]
  [arr-ty : AstType]
  [buf-var : i64]
  [len-i64 : CompilerIrValue]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 arr-ty)
    [(LowerExpr arr-state arr-value _)
      (OkLowerExpr
        (LowerExpr
          (lower-store-at-offset
            (lower-store-at-offset
              arr-state
              arr-value
              0
              (CompilerIrValue.Var buf-var)
              (AstType.U64))
            arr-value
            8
            len-i64
            (AstType.I64))
          arr-value
          arr-ty))]))

(define (lower-init-default-share-safe-type-list?
  [ctx : TcContext]
  [types : AstTypeList]) : bool
  (match types
    [(AstTypeList.Nil) true]
    [(AstTypeList.Cons head rest)
      (let
        [head : AstType (ty-node-get head)]
        [rest : AstTypeList (box-get rest)]
        (if (lower-init-default-share-safe? ctx head)
          (lower-init-default-share-safe-type-list? ctx rest)
          false))]))

(define (lower-init-default-share-safe-struct?
  [ctx : TcContext]
  [struct-name : String]
  [struct-ty : AstType]) : bool
  (match (tc-struct-decl ctx struct-name)
    [(ResultTcStructDecl.Ok decl)
      (match decl
        [(TcStructDecl repr cleanup fields)
          (if (ast-struct-repr-c? repr)
            false
            (if (ast-struct-cleanup? cleanup)
              false
              (let
                [field-types : AstTypeList
                  (tc-resolve-type-list
                    ctx
                    (lower-struct-constructor-field-types-for-result
                      ctx
                      struct-name
                      struct-ty
                      fields))]
                (lower-init-default-share-safe-type-list? ctx field-types))))])]
    [(ResultTcStructDecl.Err _) false]))

(define (lower-init-default-share-safe-enum?
  [ctx : TcContext]
  [enum-name : String]
  [enum-ty : AstType]) : bool
  (match (tc-enum-decl ctx enum-name)
    [(ResultTcEnumDecl.Ok decl)
      (match decl
        [(TcEnumDecl cleanup variants)
          (if (ast-enum-cleanup? cleanup)
            false
            (match variants
              [(AstVariantDefList.Nil) false]
              [(AstVariantDefList.Cons variant _)
                (match variant
                  [(AstVariantDef.Def _ fields _)
                    (let
                      [field-types : AstTypeList
                        (tc-resolve-type-list
                          ctx
                          (lower-enum-constructor-fields-for-result
                            ctx
                            enum-name
                            enum-ty
                            fields))]
                      (lower-init-default-share-safe-type-list? ctx field-types))])]))])]
    [(ResultTcEnumDecl.Err _) false]))

(define (lower-init-default-share-safe? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (if (tc-integer-type? resolved)
      true
      (match resolved
        [(AstType.F64) true]
        [(AstType.F32) true]
        [(AstType.Bool) true]
        [(AstType.Char) true]
        [(AstType.Unit) true]
        [(AstType.String) true]
        [(AstType.Ptr _) true]
        [(AstType.MutPtr _) true]
        [(AstType.Tuple elems)
          (lower-init-default-share-safe-type-list? ctx (box-get elems))]
        [(AstType.Struct name)
          (lower-init-default-share-safe-struct? ctx (intern-str name) resolved)]
        [(AstType.StructArgs name _)
          (lower-init-default-share-safe-struct? ctx (intern-str name) resolved)]
        [(AstType.Enum name)
          (lower-init-default-share-safe-enum? ctx (intern-str name) resolved)]
        [(AstType.EnumArgs name _)
          (lower-init-default-share-safe-enum? ctx (intern-str name) resolved)]
        [_ false]))))

(define (lower-make-array-init-advance
  [state : LowerState]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc inc-alloc inc-var)
      (OkLowerState
        (lower-state-finish-block
          (lower-state-emit
            (lower-state-emit
              (lower-state-emit
                inc-alloc
                (CompilerIrInstr.BinOp
                  inc-var
                  CompilerIrBinOp.Add
                  (CompilerIrValue.Var index-var)
                  (CompilerIrValue.I64 1)
                  (AstType.I64)))
              (CompilerIrInstr.Mov
                index-var
                (CompilerIrValue.Var inc-var)
                (AstType.I64)))
            (CompilerIrInstr.Jump header-label))
          exit-label))]))

(define (lower-make-array-store-init-body
  [ctx : TcContext]
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]
  [elem-ty : AstType]
  [init-value : CompilerIrValue]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    buf-value
    (CompilerIrValue.Var index-var)
    elem-ty)
    [(LowerExpr gep-state elem-ptr _)
      (lower-make-array-init-advance
        (lower-array-elem-store-state ctx gep-state elem-ptr init-value elem-ty)
        index-var
        header-label
        exit-label)]))

(define (lower-make-array-init-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]
  [elem-ty : AstType]
  [origin : AstExpr]) : ResultLowerState
  (match (lower-init-expr ctx state env type-env elem-ty origin elem-ty)
    [(OkLowerExpr lowered-init)
      (match lowered-init
        [(LowerExpr init-state init-value _)
          (match (lower-emit-elem-addr-gep
            ctx
            init-state
            buf-value
            (CompilerIrValue.Var index-var)
            elem-ty)
            [(LowerExpr gep-state elem-ptr _)
              (lower-make-array-init-advance
                (lower-array-elem-store-state
                  ctx
                  gep-state
                  elem-ptr
                  init-value
                  elem-ty)
                index-var
                header-label
                exit-label)])])]
    [(ErrLowerExpr message) (ErrLowerState message)]))

(define (lower-make-array-init-loop-with-labels
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [origin : AstExpr]
  [header-label : String]
  [body-label : String]
  [exit-label : String]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc index-alloc index-var)
      (let
        [header-start : LowerState
          (lower-state-finish-block
            (lower-state-emit
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov
                  index-var
                  (CompilerIrValue.I64 0)
                  (AstType.I64)))
              (CompilerIrInstr.Jump header-label))
            header-label)]
        (match (lower-emit-binop
          header-start
          CompilerIrBinOp.Lt
          (CompilerIrValue.Var index-var)
          len-i64
          (AstType.Bool))
          [(LowerExpr cond-state cond-value _)
            (let
              [body-start : LowerState
                (lower-state-finish-block
                  (lower-state-emit
                    cond-state
                    (CompilerIrInstr.Branch cond-value body-label exit-label))
                  body-label)]
              (lower-make-array-init-body
                ctx
                body-start
                env
                type-env
                buf-value
                index-var
                header-label
                exit-label
                elem-ty
                origin))]))]))

(define (lower-make-array-store-init-loop-with-labels
  [ctx : TcContext]
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [init-value : CompilerIrValue]
  [header-label : String]
  [body-label : String]
  [exit-label : String]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc index-alloc index-var)
      (let
        [header-start : LowerState
          (lower-state-finish-block
            (lower-state-emit
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov
                  index-var
                  (CompilerIrValue.I64 0)
                  (AstType.I64)))
              (CompilerIrInstr.Jump header-label))
            header-label)]
        (match (lower-emit-binop
          header-start
          CompilerIrBinOp.Lt
          (CompilerIrValue.Var index-var)
          len-i64
          (AstType.Bool))
          [(LowerExpr cond-state cond-value _)
            (let
              [body-start : LowerState
                (lower-state-finish-block
                  (lower-state-emit
                    cond-state
                    (CompilerIrInstr.Branch cond-value body-label exit-label))
                  body-label)]
              (lower-make-array-store-init-body
                ctx
                body-start
                buf-value
                index-var
                header-label
                exit-label
                elem-ty
                init-value))]))]))

(define (lower-make-array-init-loop-runtime
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [origin : AstExpr]) : ResultLowerState
  (if (= elem-size 0)
    (OkLowerState state)
    (match (lower-state-fresh-label state "make_array_init_header")
      [(LowerLabel header-label-state header-label)
        (match (lower-state-fresh-label
          header-label-state
          "make_array_init_body")
          [(LowerLabel body-label-state body-label)
            (match (lower-state-fresh-label
              body-label-state
              "make_array_init_exit")
              [(LowerLabel exit-label-state exit-label)
                (lower-make-array-init-loop-with-labels
                  ctx
                  exit-label-state
                  env
                  type-env
                  buf-value
                  len-i64
                  elem-ty
                  origin
                  header-label
                  body-label
                  exit-label)])])])))

(define (lower-make-array-store-init-loop-runtime
  [ctx : TcContext]
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [init-value : CompilerIrValue]) : ResultLowerState
  (if (= elem-size 0)
    (OkLowerState state)
    (match (lower-state-fresh-label state "make_array_init_header")
      [(LowerLabel header-label-state header-label)
        (match (lower-state-fresh-label
          header-label-state
          "make_array_init_body")
          [(LowerLabel body-label-state body-label)
            (match (lower-state-fresh-label
              body-label-state
              "make_array_init_exit")
              [(LowerLabel exit-label-state exit-label)
                (lower-make-array-store-init-loop-with-labels
                  ctx
                  exit-label-state
                  buf-value
                  len-i64
                  elem-ty
                  init-value
                  header-label
                  body-label
                  exit-label)])])])))

(define (lower-make-array-fill8
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [init-value : CompilerIrValue]) : ResultLowerState
  (match (lower-runtime-call-values
    state
    "tl_array_fill8"
    (compiler-ir-value-cons
      buf-value
      (compiler-ir-value-cons
        len-i64
        (compiler-ir-value-cons init-value IrValueNil)))
    (AstType.Unit))
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr done-state _ _) (OkLowerState done-state)])]
    [(ErrLowerExpr message) (ErrLowerState message)]))

(define (lower-make-array-fill8-supported? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (and
      (= (lower-type-size ctx resolved) 8)
      (not (tc-type-eq resolved (AstType.F64)))
      ;; #1867/#2386: memory-resident inline aggregates are pointers to
      ;; storage, but a one-word register-resident aggregate is the word
      ;; itself, so fill8 can replicate it directly.
      (or
        (not (lower-type-inline-storage? ctx resolved))
        (lower-type-register-resident? ctx resolved))
      (lower-init-default-share-safe? ctx resolved))))

(define (lower-make-array-zero-fill-supported? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (if (tc-integer-type? resolved)
      true
      (match resolved
        [(AstType.F64) true]
        [(AstType.F32) true]
        [(AstType.Bool) true]
        [(AstType.Char) true]
        [(AstType.Unit) true]
        [(AstType.Ptr _) true]
        [(AstType.MutPtr _) true]
        [_ false]))))

(define (lower-make-array-zero-fill
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [byte-count : CompilerIrValue]) : ResultLowerState
  (match (lower-runtime-call-values
    state
    "tl_array_zero"
    (compiler-ir-value-cons
      buf-value
      (compiler-ir-value-cons byte-count IrValueNil))
    (AstType.Unit))
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr done-state _ _) (OkLowerState done-state)])]
    [(ErrLowerExpr message) (ErrLowerState message)]))

(define (lower-make-array-zero-literal-length? [len : AstExpr]) : bool
  (match (ast-expr-unspan len)
    [(AstExpr.Literal (AstLiteral.Int value _)) (= value 0)]
    [_ false]))

(define (lower-make-array-init-loop-nonzero
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [byte-count : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [origin : AstExpr]) : ResultLowerState
  (cond
    [(= elem-size 0) (OkLowerState state)]
    [(lower-make-array-zero-fill-supported? ctx elem-ty)
      (lower-make-array-zero-fill state buf-value byte-count)]
    [(lower-init-default-share-safe? ctx elem-ty)
      (match (lower-init-expr ctx state env type-env elem-ty origin elem-ty)
        [(OkLowerExpr lowered-init)
          (match lowered-init
            [(LowerExpr init-state init-value _)
              (if (lower-make-array-fill8-supported? ctx elem-ty)
                (lower-make-array-fill8 init-state buf-value len-i64 init-value)
                (lower-make-array-store-init-loop-runtime
                  ctx
                  init-state
                  buf-value
                  len-i64
                  elem-ty
                  elem-size
                  init-value))])]
        [(ErrLowerExpr message) (ErrLowerState message)])]
    [else
      (lower-make-array-init-loop-runtime
        ctx
        state
        env
        type-env
        buf-value
        len-i64
        elem-ty
        elem-size
        origin)]))

(define (lower-make-array-init-loop
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [byte-count : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : AstExpr]) : ResultLowerState
  (if zero-literal-length
    (OkLowerState state)
    (match len-i64
      [(CompilerIrValue.I64 literal-len)
        (if (= literal-len 0)
          (OkLowerState state)
          (lower-make-array-init-loop-nonzero
            ctx
            state
            env
            type-env
            buf-value
            len-i64
            byte-count
            elem-ty
            elem-size
            origin))]
      [_
        (lower-make-array-init-loop-nonzero
          ctx
          state
          env
          type-env
          buf-value
          len-i64
          byte-count
          elem-ty
          elem-size
          origin)])))

(define (lower-make-array-alloc-buffer
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr-ty : AstType]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-emit-binop
    state
    (CompilerIrBinOp.Mul)
    len-i64
    (CompilerIrValue.I64 elem-size)
    (AstType.I64))
    [(LowerExpr byte-state byte-count _)
      (match (lower-state-alloc-var byte-state)
        [(LowerAlloc buf-alloc buf-var)
          (let
            [alloc-state : LowerState
              (lower-state-emit
                buf-alloc
                (CompilerIrInstr.Call
                  buf-var
                  "tl_alloc"
                  (CompilerIrCallArgs.One byte-count)
                  (AstType.U64)))]
            (match (lower-make-array-init-loop
              ctx
              alloc-state
              env
              type-env
              (CompilerIrValue.Var buf-var)
              len-i64
              byte-count
              elem-ty
              elem-size
              zero-literal-length
              origin)
              [(OkLowerState init-state)
                (lower-make-array-store-fat init-state arr-ty buf-var len-i64)]
              [(ErrLowerState message) (ErrLowerExpr message)]))])]))

(define (lower-make-array-after-max-check
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [fail-label : String]
  [alloc-label : String]
  [arr-ty : AstType]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [fail-start : LowerState (lower-state-finish-block state fail-label)]
    [alloc-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (CompilerIrInstr.Jump alloc-label))
        alloc-label)]
    (lower-make-array-alloc-buffer
      ctx
      alloc-start
      env
      type-env
      arr-ty
      len-i64
      elem-ty
      elem-size
      zero-literal-length
      origin)))

(define (lower-make-array-from-len
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [elem-ty : AstType]
  [len-value : CompilerIrValue]
  [len-ty : AstType]
  [len-expr : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [resolved-elem : AstType (tc-resolve-type ctx elem-ty)]
    (match (lower-cast-value state len-value len-ty (AstType.I64))
      [(LowerExpr len-state len-i64 _)
        (let
          [elem-size : i64 (lower-type-size ctx resolved-elem)]
          [arr-ty : AstType (ast-ty-dyn-array resolved-elem)]
          (match (lower-state-fresh-label len-state "make_array_len_nonneg")
            [(LowerLabel s1 check-max-label)
              (match (lower-state-fresh-label s1 "make_array_len_fail")
                [(LowerLabel s2 fail-label)
                  (match (lower-state-fresh-label s2 "make_array_len_ok")
                    [(LowerLabel s3 alloc-label)
                      (match (lower-emit-binop
                        s3
                        (CompilerIrBinOp.Le)
                        (CompilerIrValue.I64 0)
                        len-i64
                        (AstType.Bool))
                        [(LowerExpr s4 non-negative _)
                          (let
                            [check-start : LowerState
                              (lower-state-finish-block
                                (lower-state-emit
                                  s4
                                  (CompilerIrInstr.Branch
                                    non-negative
                                    check-max-label
                                    fail-label))
                                check-max-label)]
                            [max-len : i64
                              (if (= elem-size 0)
                                9223372036854775807
                                (/ 9223372036854775807 elem-size))]
                            (match (lower-emit-binop
                              check-start
                              (CompilerIrBinOp.Le)
                              len-i64
                              (CompilerIrValue.I64 max-len)
                              (AstType.Bool))
                              [(LowerExpr s5 within-max _)
                                (lower-make-array-after-max-check
                                  ctx
                                  (lower-state-emit
                                    s5
                                    (CompilerIrInstr.Branch
                                      within-max
                                      alloc-label
                                      fail-label))
                                  env
                                  type-env
                                  fail-label
                                  alloc-label
                                  arr-ty
                                  len-i64
                                  resolved-elem
                                  elem-size
                                  (lower-make-array-zero-literal-length?
                                    len-expr)
                                  origin)]))])])])]))])))

(define (lower-make-array
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [elem-ty : AstType]
  [len : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-integer-expr-with-expected-or-actual
    ctx
    state
    env
    type-env
    len
    (AstType.I64)
    "lower: make-array length must be integer")
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr len-state len-value len-ty)
          (lower-make-array-from-len
            ctx
            len-state
            env
            type-env
            elem-ty
            len-value
            len-ty
            len
            origin)])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

;; `(array-ref arr index)` -> bounds-checked typed element load.
;; #1867/#3580: read an array element given its address. For a memory aggregate
;; element the address IS the value (pointer representation); for scalars and
;; pointer-slot types (tuple/box/dynarray/string handles) load the register-width
;; value. Mirrors lower-load-inline-value-at-offset at offset 0 but preserves the
;; exact lower-emit-load scalar path.
(define (lower-array-elem-ref-result
  [ctx : TcContext]
  [addr-state : LowerState]
  [elem-ptr : CompilerIrValue]
  [elem-ir-ty : AstType]) : ResultLowerExpr
  ;; #2386: a register-resident element is loaded as a word, not returned as the
  ;; element address.
  (if (and
    (lower-mode-inline-aggregates? (lower-state-mode addr-state))
    (lower-type-inline-storage? ctx elem-ir-ty)
    (not (lower-type-register-resident? ctx elem-ir-ty)))
    (OkLowerExpr (LowerExpr addr-state elem-ptr elem-ir-ty))
    (if (lower-type-register-group? ctx elem-ir-ty)
      (match (lower-load-group-from-ptr ctx addr-state elem-ptr elem-ir-ty)
        [(LowerExpr load-state load-value _)
          (OkLowerExpr (LowerExpr load-state load-value elem-ir-ty))])
      (match (lower-emit-load addr-state elem-ptr elem-ir-ty)
        [(LowerExpr load-state load-value _)
          (OkLowerExpr (LowerExpr load-state load-value elem-ir-ty))]))))

(define (lower-array-ref
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [index : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      (match (tc-array-readable-receiver ctx arr-ty)
        [(ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (let
                [elem-ir-ty : AstType (tc-type-without-regions elem-ty)]
                (match (lower-expr ctx state env type-env arr)
                  [(OkLowerExpr arr-lowered)
                    (match arr-lowered
                      [(LowerExpr arr-state arr-value _)
                        (match (lower-index-result-type-or-check
                          ctx
                          env
                          type-env
                          (lower-state-type-cache arr-state)
                          index)
                          [(ResultTcType.Ok idx-ty)
                            (match (lower-expr-expected
                              ctx
                              arr-state
                              env
                              type-env
                              index
                              idx-ty
                              index)
                              [(OkLowerExpr idx-lowered)
                                (match idx-lowered
                                  [(LowerExpr idx-state idx-value idx-value-ty)
                                    (match (tc-type-strip-region
                                      (tc-resolve-type ctx container-ty))
                                      [(AstType.DynArray _)
                                        (match (lower-array-element-addr
                                          ctx
                                          idx-state
                                          arr-value
                                          idx-value
                                          idx-value-ty
                                          elem-ir-ty)
                                          [(LowerExpr addr-state elem-ptr _)
                                            (lower-array-elem-ref-result
                                              ctx
                                              addr-state
                                              elem-ptr
                                              elem-ir-ty)])]
                                      [(AstType.Array _ elem-count)
                                        (match (lower-fixed-array-element-addr
                                          ctx
                                          idx-state
                                          arr-value
                                          idx-value
                                          idx-value-ty
                                          elem-ir-ty
                                          elem-count)
                                          [(LowerExpr addr-state elem-ptr _)
                                            (if (=
                                              (lower-type-size ctx elem-ir-ty)
                                              0)
                                              (OkLowerExpr
                                                (LowerExpr
                                                  addr-state
                                                  CompilerIrValue.Unit
                                                  elem-ir-ty))
                                              (lower-array-elem-ref-result
                                                ctx
                                                addr-state
                                                elem-ptr
                                                elem-ir-ty))])]
                                      [_
                                        (ErrLowerExpr
                                          (box
                                            (lower-diagnostic-at-expr
                                              arr
                                              "lower: array-ref requires array type")))])])]
                              [(ErrLowerExpr message) (ErrLowerExpr message)])]
                          [(ResultTcType.Err message)
                            (ErrLowerExpr
                              (box (lower-diagnostic-at-expr index message)))])])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)]))])]
        [(ResultTcArrayReceiver.Err message)
          (ErrLowerExpr (box (lower-diagnostic-at-expr arr message)))])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr arr message)))]))

;; `(array-set! arr index value)` -> bounds-checked typed element store.
;; #1867/#3580: store a value into an array element slot. A memory aggregate
;; value is byte-copied into the full-size element slot; scalars and pointer-slot
;; handles use a register-width store.
(define (lower-array-elem-store-state
  [ctx : TcContext]
  [addr-state : LowerState]
  [elem-ptr : CompilerIrValue]
  [value-ir : CompilerIrValue]
  [elem-ir-ty : AstType]) : LowerState
  ;; #2386: a register-resident element value is a word; store it scalar instead
  ;; of byte-copying from a pointer.
  (if (and
    (lower-mode-inline-aggregates? (lower-state-mode addr-state))
    (lower-type-inline-storage? ctx elem-ir-ty)
    (not (lower-type-register-resident? ctx elem-ir-ty)))
    (lower-copy-bytes
      addr-state
      elem-ptr
      0
      value-ir
      0
      (lower-type-size ctx elem-ir-ty))
    (if (lower-type-register-group? ctx elem-ir-ty)
      (lower-store-group-at-ptr ctx addr-state elem-ptr value-ir elem-ir-ty)
      (lower-state-emit
        addr-state
        (CompilerIrInstr.StorePtr elem-ptr value-ir elem-ir-ty)))))

(define (lower-array-set-store-materialized
  [ctx : TcContext]
  [state : LowerState]
  [arr : AstExpr]
  [arr-value : CompilerIrValue]
  [idx-value : CompilerIrValue]
  [idx-ty : AstType]
  [container-ty : AstType]
  [elem-ir-ty : AstType]
  [value-ir : CompilerIrValue]) : ResultLowerExpr
  (match (tc-type-strip-region (tc-resolve-type ctx container-ty))
    [(AstType.DynArray _)
      (match (lower-array-element-addr
        ctx
        state
        arr-value
        idx-value
        idx-ty
        elem-ir-ty)
        [(LowerExpr addr-state elem-ptr _)
          (OkLowerExpr
            (LowerExpr
              (lower-array-elem-store-state
                ctx
                addr-state
                elem-ptr
                value-ir
                elem-ir-ty)
              CompilerIrValue.Unit
              (AstType.Unit)))])]
    [(AstType.Array _ elem-count)
      (match (lower-fixed-array-element-addr
        ctx
        state
        arr-value
        idx-value
        idx-ty
        elem-ir-ty
        elem-count)
        [(LowerExpr addr-state elem-ptr _)
          (if (= (lower-type-size ctx elem-ir-ty) 0)
            (OkLowerExpr
              (LowerExpr addr-state CompilerIrValue.Unit (AstType.Unit)))
            (OkLowerExpr
              (LowerExpr
                (lower-array-elem-store-state
                  ctx
                  addr-state
                  elem-ptr
                  value-ir
                  elem-ir-ty)
                CompilerIrValue.Unit
                (AstType.Unit))))])]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr arr "lower: array-set! requires array type")))]))

(define (lower-array-set-direct-store
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [arr-value : CompilerIrValue]
  [idx-value : CompilerIrValue]
  [idx-ty : AstType]
  [container-ty : AstType]
  [elem-ir-ty : AstType]
  [value : AstExpr]) : LowerMaybeDirectStore
  (if (and
    (> (lower-type-size ctx elem-ir-ty) 0)
    (lower-direct-store-target? ctx state elem-ir-ty))
    (match (tc-type-strip-region (tc-resolve-type ctx container-ty))
      [(AstType.DynArray _)
        (match (lower-array-element-addr
          ctx
          state
          arr-value
          idx-value
          idx-ty
          elem-ir-ty)
          [(LowerExpr addr-state elem-ptr _)
            (lower-direct-store-rhs-into
              ctx
              addr-state
              env
              type-env
              elem-ptr
              value
              elem-ir-ty
              value)])]
      [(AstType.Array _ elem-count)
        (match (lower-fixed-array-element-addr
          ctx
          state
          arr-value
          idx-value
          idx-ty
          elem-ir-ty
          elem-count)
          [(LowerExpr addr-state elem-ptr _)
            (lower-direct-store-rhs-into
              ctx
              addr-state
              env
              type-env
              elem-ptr
              value
              elem-ir-ty
              value)])]
      [_
        (LowerDirectStoreErr
          (box
            (lower-diagnostic-at-expr
              arr
              "lower: array-set! requires array type")))])
    (LowerNoDirectStore)))

(define (lower-mutable-var-storage-address-id
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : i64]
  [place-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? local-id)
      (match (lower-state-alloc-var state)
        [(LowerAlloc allocated var-id)
          (OkLowerExpr
            (LowerExpr
              (lower-state-emit-at-expr
                allocated
                (CompilerIrInstr.AddrOf var-id local-id)
                origin)
              (CompilerIrValue.Var var-id)
              place-ty))])
      (OkLowerExpr
        (LowerExpr
          state
          (CompilerIrValue.GlobalAddr
            (lower-resolve-name state (intern-str name)))
          place-ty)))))

(define (lower-mutable-var-address-id
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(ResultTcType.Ok place-ty)
      (let
        [resolved : AstType
          (tc-type-strip-region (tc-resolve-type ctx place-ty))]
        (match resolved
          [(AstType.MutRef _ referent-ty)
            (match (lower-var-id state env name place-ty)
              [(OkLowerExpr lowered)
                (match lowered
                  [(LowerExpr ref-state ref-value _)
                    (OkLowerExpr
                      (LowerExpr ref-state ref-value (ty-node-get referent-ty)))])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]
          [(AstType.Ref _ _)
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: set! struct field requires mutable struct access")))]
          [_
            (if (lower-borrow-place-value-reference? ctx place-ty)
              (lower-var-id state env name place-ty)
              (lower-mutable-var-storage-address-id
                state
                env
                name
                place-ty
                origin))]))]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-struct-field-address-from-place
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [receiver-ty : AstType]
  [field : String]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstType.Struct struct-name)
      (match (lower-struct-field-info ctx (intern-str struct-name) field)
        [(OkLowerFieldInfo info)
          (match info
            [(LowerFieldInfo offset field-ty)
              (match (lower-gep-byte state base offset)
                [(LowerExpr ptr-state ptr _)
                  (OkLowerExpr
                    (LowerExpr ptr-state ptr (tc-type-without-regions field-ty)))])])]
        [(ErrLowerFieldInfo message) (ErrLowerExpr message)])]
    [(AstType.StructArgs struct-name _)
      (match (lower-struct-field-info ctx (intern-str struct-name) field)
        [(OkLowerFieldInfo info)
          (match info
            [(LowerFieldInfo offset field-ty)
              (match (lower-gep-byte state base offset)
                [(LowerExpr ptr-state ptr _)
                  (OkLowerExpr
                    (LowerExpr ptr-state ptr (tc-type-without-regions field-ty)))])])]
        [(ErrLowerFieldInfo message) (ErrLowerExpr message)])]
    [(AstType.MutRef _ referent-ty)
      (match (lower-emit-load state base receiver-ty)
        [(LowerExpr ref-state ref-value _)
          (lower-struct-field-address-from-place
            ctx
            ref-state
            ref-value
            (ty-node-get referent-ty)
            field
            origin)])]
    [(AstType.Ref _ _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires mutable struct access")))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires struct")))]))

(define (lower-tuple-field-address-from-place
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [tuple-ty : AstType]
  [index : i64]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-type-strip-region (tc-resolve-type ctx tuple-ty))
    [(AstType.Tuple elem-tys)
      (match (lower-tuple-elem-info ctx (box-get elem-tys) index 0 0)
        [(OkLowerFieldInfo info)
          (match info
            [(LowerFieldInfo offset elem-ty)
              (match (lower-gep-byte state base offset)
                [(LowerExpr ptr-state ptr _)
                  (OkLowerExpr
                    (LowerExpr ptr-state ptr (tc-type-without-regions elem-ty)))])])]
        [(ErrLowerFieldInfo message) (ErrLowerExpr message)])]
    [(AstType.MutRef _ referent-ty)
      (match (lower-emit-load state base tuple-ty)
        [(LowerExpr ref-state ref-value _)
          (lower-tuple-field-address-from-place
            ctx
            ref-state
            ref-value
            (ty-node-get referent-ty)
            index
            origin)])]
    [(AstType.Ref _ _)
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires mutable tuple access")))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: tuple-ref requires tuple place")))]))

(define (lower-mutable-array-element-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [index : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      (match (tc-array-set-receiver ctx arr-ty)
        [(ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (lower-borrow-array-element-address
                ctx
                state
                env
                type-env
                arr
                index
                origin
                (tc-type-without-regions elem-ty))])]
        [(ResultTcArrayReceiver.Err message)
          (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr arr message)))]))

(define (lower-mutable-place-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [place : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (ast-expr-unspan place)
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? type-env name)
          (match (tc-dotted-local-field-expr-id type-env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (lower-mutable-place-address
                ctx
                state
                env
                type-env
                (ast-node-get virtual-id)
                origin)]
            [(ResultTcExprId.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])
          (lower-mutable-var-address-id ctx state env type-env name origin)))]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (match (lower-mutable-place-address
          ctx
          state
          env
          type-env
          receiver
          origin)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr receiver-state receiver-base receiver-ty)
                (lower-struct-field-address-from-place
                  ctx
                  receiver-state
                  receiver-base
                  receiver-ty
                  (intern-str field)
                  origin)])]
          [(ErrLowerExpr message) (ErrLowerExpr message)]))]
    [(AstExpr.TupleRef tuple-box index)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (match (lower-mutable-place-address ctx state env type-env tuple origin)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr tuple-state tuple-base tuple-ty)
                (lower-tuple-field-address-from-place
                  ctx
                  tuple-state
                  tuple-base
                  tuple-ty
                  index
                  origin)])]
          [(ErrLowerExpr message) (ErrLowerExpr message)]))]
    [(AstExpr.ArrayRef arr-box index-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [index : AstExpr (ast-node-get index-box)]
        (lower-mutable-array-element-address
          ctx
          state
          env
          type-env
          arr
          index
          origin))]
    [(AstExpr.BoxGet box-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          box-expr)
          [(ResultTcType.Ok box-ty)
            (match (tc-box-set-inner-type ctx box-ty)
              [(ResultTcType.Ok inner-ty)
                (lower-box-storage-address
                  ctx
                  state
                  env
                  type-env
                  box-expr
                  origin
                  (tc-type-without-regions inner-ty))]
              [(ResultTcType.Err message)
                (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])]
          [(ResultTcType.Err message)
            (ErrLowerExpr (box (lower-diagnostic-at-expr box-expr message)))]))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! target must be a storage place")))]))

(define (lower-struct-field-store-result
  [ctx : TcContext]
  [state : LowerState]
  [field-ptr : CompilerIrValue]
  [value-ir : CompilerIrValue]
  [field-ir-ty : AstType]) : ResultLowerExpr
  (if (= (lower-type-size ctx field-ir-ty) 0)
    (OkLowerExpr (LowerExpr state CompilerIrValue.Unit (AstType.Unit)))
    (OkLowerExpr
      (LowerExpr
        (lower-store-inline-value-at-offset
          ctx
          state
          field-ptr
          0
          value-ir
          field-ir-ty
          (lower-type-size ctx field-ir-ty))
        CompilerIrValue.Unit
        (AstType.Unit)))))

(define (lower-store-expr-into-address-result
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [value : AstExpr]
  [value-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (> (lower-type-size ctx value-ty) 0)
    (match (lower-direct-store-rhs-into
      ctx
      state
      env
      type-env
      dst
      value
      value-ty
      origin)
      [(LowerDirectStore done-state)
        (OkLowerExpr (LowerExpr done-state CompilerIrValue.Unit (AstType.Unit)))]
      [(LowerDirectStoreErr message) (ErrLowerExpr message)]
      [(LowerNoDirectStore)
        (match (lower-expr-expected
          ctx
          state
          env
          type-env
          value
          value-ty
          origin)
          [(OkLowerExpr value-lowered)
            (match value-lowered
              [(LowerExpr value-state value-ir _)
                (lower-struct-field-store-result
                  ctx
                  value-state
                  dst
                  value-ir
                  value-ty)])]
          [(ErrLowerExpr message) (ErrLowerExpr message)])])
    (match (lower-expr-expected ctx state env type-env value value-ty origin)
      [(OkLowerExpr value-lowered)
        (match value-lowered
          [(LowerExpr value-state value-ir _)
            (lower-struct-field-store-result
              ctx
              value-state
              dst
              value-ir
              value-ty)])]
      [(ErrLowerExpr message) (ErrLowerExpr message)])))

(define (lower-box-set
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [box-expr : AstExpr]
  [value : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    box-expr)
    [(ResultTcType.Ok box-ty)
      (match (tc-box-set-inner-type ctx box-ty)
        [(ResultTcType.Ok inner-ty)
          (let
            [inner-ir-ty : AstType (tc-type-without-regions inner-ty)]
            (match (lower-box-storage-address
              ctx
              state
              env
              type-env
              box-expr
              origin
              inner-ir-ty)
              [(OkLowerExpr place-lowered)
                (match place-lowered
                  [(LowerExpr place-state box-ptr _)
                    (lower-store-expr-into-address-result
                      ctx
                      place-state
                      env
                      type-env
                      box-ptr
                      value
                      inner-ir-ty
                      value)])]
              [(ErrLowerExpr message) (ErrLowerExpr message)]))]
        [(ResultTcType.Err message)
          (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr box-expr message)))]))

(define (lower-refresh-register-resident-root-after-store
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [place : AstExpr]
  [origin : AstExpr]) : ResultLowerState
  (match (tc-move-root-projection-var place)
    [(TcMaybeString.Some root)
      (let
        [local-id : i64
          (sym_i64_env.sym-i64-lookup-or
            env
            root
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? local-id)
          (match (tc-lookup type-env root)
            [(ResultTcType.Ok root-ty)
              (let
                [resolved : AstType
                  (tc-type-without-regions (tc-resolve-type ctx root-ty))]
                (if (lower-type-register-resident? ctx resolved)
                  (match (lower-state-alloc-var state)
                    [(LowerAlloc addr-alloc addr-var)
                      (match (lower-load-register-resident-from-ptr
                        ctx
                        (lower-state-emit-at-expr
                          addr-alloc
                          (CompilerIrInstr.AddrOf addr-var local-id)
                          origin)
                        (CompilerIrValue.Var addr-var)
                        resolved)
                        [(LowerExpr load-state loaded _)
                          (OkLowerState
                            (lower-state-emit-at-expr
                              load-state
                              (CompilerIrInstr.Mov local-id loaded resolved)
                              origin))])])
                  (OkLowerState state)))]
            [(ResultTcType.Err message)
              (ErrLowerState (box (lower-diagnostic-at-expr origin message)))])
          (OkLowerState state)))]
    [(TcMaybeString.No) (OkLowerState state)]))

(define (lower-register-resident-local-place?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [receiver : AstExpr]
  [receiver-ty : AstType]) : bool
  (if (lower-type-register-resident? ctx receiver-ty)
    (match (ast-expr-unspan receiver)
      [(AstExpr.Var name) (sym_i64_env.sym-i64-contains-id env name)]
      [_ false])
    false))

(define (lower-reload-register-resident-local-from-storage
  [ctx : TcContext]
  [state : LowerState]
  [storage-ptr : CompilerIrValue]
  [local-id : i64]
  [receiver-ir-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-load-register-resident-from-ptr
    ctx
    state
    storage-ptr
    receiver-ir-ty)
    [(LowerExpr load-state loaded _)
      (OkLowerExpr
        (LowerExpr
          (lower-state-emit-at-expr
            load-state
            (CompilerIrInstr.Mov local-id loaded receiver-ir-ty)
            origin)
          CompilerIrValue.Unit
          (AstType.Unit)))]))

(define (lower-struct-set-register-resident-local
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [receiver : AstExpr]
  [receiver-ty : AstType]
  [field : String]
  [field-ir-ty : AstType]
  [value : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (ast-expr-unspan receiver)
    [(AstExpr.Var name)
      (let
        [local-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? local-id)
          (let
            [receiver-ir-ty : AstType
              (tc-type-without-regions (tc-resolve-type ctx receiver-ty))]
            [receiver-size : i64 (lower-type-size ctx receiver-ir-ty)]
            (match (lower-reserve-inline-storage
              state
              (if (= receiver-size 0)
                1
                receiver-size)
              receiver-ir-ty)
              [(LowerExpr storage-state storage-ptr _)
                (let
                  [stored-root-state : LowerState
                    (if (= receiver-size 0)
                      storage-state
                      (lower-store-inline-value-at-offset
                        ctx
                        storage-state
                        storage-ptr
                        0
                        (CompilerIrValue.Var local-id)
                        receiver-ir-ty
                        receiver-size))]
                  (match (lower-struct-field-address-from-place
                    ctx
                    stored-root-state
                    storage-ptr
                    receiver-ir-ty
                    field
                    origin)
                    [(OkLowerExpr place-lowered)
                      (match place-lowered
                        [(LowerExpr place-state field-ptr _)
                          (match (lower-store-expr-into-address-result
                            ctx
                            place-state
                            env
                            type-env
                            field-ptr
                            value
                            field-ir-ty
                            value)
                            [(OkLowerExpr stored-field)
                              (match stored-field
                                [(LowerExpr store-state _ _)
                                  (lower-reload-register-resident-local-from-storage
                                    ctx
                                    store-state
                                    storage-ptr
                                    local-id
                                    receiver-ir-ty
                                    origin)])]
                            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)]))]))
          (ErrLowerExpr
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: set! struct field requires local storage")))))]
    [_
      (ErrLowerExpr
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires local storage")))]))

(define (lower-struct-set
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [receiver : AstExpr]
  [field : String]
  [value : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    receiver)
    [(ResultTcType.Ok receiver-ty)
      (match (tc-struct-set-field-type ctx receiver-ty field)
        [(ResultTcType.Ok field-ty)
          (let
            [field-ir-ty : AstType (tc-type-without-regions field-ty)]
            (if (lower-register-resident-local-place?
              ctx
              env
              receiver
              receiver-ty)
              (lower-struct-set-register-resident-local
                ctx
                state
                env
                type-env
                receiver
                receiver-ty
                field
                field-ir-ty
                value
                origin)
              (match (lower-mutable-place-address
                ctx
                state
                env
                type-env
                receiver
                origin)
                [(OkLowerExpr place-lowered)
                  (match place-lowered
                    [(LowerExpr place-state place-ptr place-ty)
                      (match (lower-struct-field-address-from-place
                        ctx
                        place-state
                        place-ptr
                        place-ty
                        field
                        origin)
                        [(OkLowerExpr field-lowered)
                          (match field-lowered
                            [(LowerExpr field-state field-ptr _)
                              (match (lower-store-expr-into-address-result
                                ctx
                                field-state
                                env
                                type-env
                                field-ptr
                                value
                                field-ir-ty
                                value)
                                [(OkLowerExpr stored)
                                  (match stored
                                    [(LowerExpr store-state _ _)
                                      (match (lower-refresh-register-resident-root-after-store
                                        ctx
                                        store-state
                                        env
                                        type-env
                                        receiver
                                        origin)
                                        [(OkLowerState refreshed-state)
                                          (OkLowerExpr
                                            (LowerExpr
                                              refreshed-state
                                              CompilerIrValue.Unit
                                              (AstType.Unit)))]
                                        [(ErrLowerState message)
                                          (ErrLowerExpr message)])])]
                                [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                        [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])))]
        [(ResultTcType.Err message)
          (ErrLowerExpr (box (lower-diagnostic-at-expr origin message)))])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr receiver message)))]))

(define (lower-array-set
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [index : AstExpr]
  [value : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      (match (tc-array-set-receiver ctx arr-ty)
        [(ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (let
                [elem-ir-ty : AstType (tc-type-without-regions elem-ty)]
                (match (lower-expr ctx state env type-env arr)
                  [(OkLowerExpr arr-lowered)
                    (match arr-lowered
                      [(LowerExpr arr-state arr-value _)
                        (match (lower-index-result-type-or-check
                          ctx
                          env
                          type-env
                          (lower-state-type-cache arr-state)
                          index)
                          [(ResultTcType.Ok idx-ty)
                            (match (lower-expr-expected
                              ctx
                              arr-state
                              env
                              type-env
                              index
                              idx-ty
                              index)
                              [(OkLowerExpr idx-lowered)
                                (match idx-lowered
                                  [(LowerExpr idx-state idx-value idx-value-ty)
                                    (match (lower-array-set-direct-store
                                      ctx
                                      idx-state
                                      env
                                      type-env
                                      arr
                                      arr-value
                                      idx-value
                                      idx-value-ty
                                      container-ty
                                      elem-ir-ty
                                      value)
                                      [(LowerDirectStore direct-state)
                                        (OkLowerExpr
                                          (LowerExpr
                                            direct-state
                                            CompilerIrValue.Unit
                                            (AstType.Unit)))]
                                      [(LowerDirectStoreErr message)
                                        (ErrLowerExpr message)]
                                      [(LowerNoDirectStore)
                                        (match (lower-expr-expected
                                          ctx
                                          idx-state
                                          env
                                          type-env
                                          value
                                          elem-ir-ty
                                          value)
                                          [(OkLowerExpr value-lowered)
                                            (match value-lowered
                                              [(LowerExpr
                                                  value-state
                                                  value-ir
                                                  _)
                                                (lower-array-set-store-materialized
                                                  ctx
                                                  value-state
                                                  arr
                                                  arr-value
                                                  idx-value
                                                  idx-value-ty
                                                  container-ty
                                                  elem-ir-ty
                                                  value-ir)])]
                                          [(ErrLowerExpr message)
                                            (ErrLowerExpr message)])])])]
                              [(ErrLowerExpr message) (ErrLowerExpr message)])]
                          [(ResultTcType.Err message)
                            (ErrLowerExpr
                              (box (lower-diagnostic-at-expr index message)))])])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)]))])]
        [(ResultTcArrayReceiver.Err message)
          (ErrLowerExpr (box (lower-diagnostic-at-expr arr message)))])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr arr message)))]))

;; Copy old dynamic-array elements into a freshly allocated buffer. The loop is
;; emitted as explicit IR so `array-push!` works for runtime lengths.
(define (lower-array-push-copy-loop
  [ctx : TcContext]
  [state : LowerState]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [old-len : CompilerIrValue]
  [elem-ty : AstType]) : LowerState
  (match (lower-state-fresh-label state "array_push_copy_header")
    [(LowerLabel header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "array_push_copy_body")
        [(LowerLabel body-label-state body-label)
          (match (lower-state-fresh-label
            body-label-state
            "array_push_copy_exit")
            [(LowerLabel exit-label-state exit-label)
              (match (lower-state-alloc-var exit-label-state)
                [(LowerAlloc index-alloc index-var)
                  (let
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            index-alloc
                            (CompilerIrInstr.Mov
                              index-var
                              (CompilerIrValue.I64 0)
                              (AstType.I64)))
                          (CompilerIrInstr.Jump header-label))
                        header-label)]
                    (match (lower-state-alloc-var header-start)
                      [(LowerAlloc cond-alloc cond-var)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                (lower-state-emit
                                  cond-alloc
                                  (CompilerIrInstr.BinOp
                                    cond-var
                                    CompilerIrBinOp.Lt
                                    (CompilerIrValue.Var index-var)
                                    old-len
                                    (AstType.Bool)))
                                (CompilerIrInstr.Branch
                                  (CompilerIrValue.Var cond-var)
                                  body-label
                                  exit-label))
                              body-label)]
                          (match (lower-emit-elem-addr-gep
                            ctx
                            body-start
                            old-buf
                            (CompilerIrValue.Var index-var)
                            elem-ty)
                            [(LowerExpr src-gep-state src-ptr _)
                              (match (lower-load-inline-value-at-offset
                                ctx
                                src-gep-state
                                src-ptr
                                0
                                elem-ty
                                (lower-state-mode src-gep-state))
                                [(LowerExpr load-state elem-value _)
                                  (match (lower-emit-elem-addr-gep
                                    ctx
                                    load-state
                                    new-buf
                                    (CompilerIrValue.Var index-var)
                                    elem-ty)
                                    [(LowerExpr dst-gep-state dst-ptr _)
                                      (match (lower-state-alloc-var
                                        (lower-array-elem-store-state
                                          ctx
                                          dst-gep-state
                                          dst-ptr
                                          elem-value
                                          elem-ty))
                                        [(LowerAlloc inc-alloc inc-var)
                                          (lower-state-finish-block
                                            (lower-state-emit
                                              (lower-state-emit
                                                (lower-state-emit
                                                  inc-alloc
                                                  (CompilerIrInstr.BinOp
                                                    inc-var
                                                    CompilerIrBinOp.Add
                                                    (CompilerIrValue.Var
                                                      index-var)
                                                    (CompilerIrValue.I64 1)
                                                    (AstType.I64)))
                                                (CompilerIrInstr.Mov
                                                  index-var
                                                  (CompilerIrValue.Var inc-var)
                                                  (AstType.I64)))
                                              (CompilerIrInstr.Jump
                                                header-label))
                                            exit-label)])])])]))]))])])])]))

(define (lower-array-push-finish
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [old-buf : CompilerIrValue]
  [old-len : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [new-len : CompilerIrValue]
  [elem-ty : AstType]
  [value-ir : CompilerIrValue]) : LowerExpr
  (match (lower-emit-elem-addr-gep
    ctx
    (lower-array-push-copy-loop ctx state old-buf new-buf old-len elem-ty)
    new-buf
    old-len
    elem-ty)
    [(LowerExpr tail-gep-state tail-ptr _)
      (LowerExpr
        (lower-store-at-offset
          (lower-store-at-offset
            (lower-array-elem-store-state
              ctx
              tail-gep-state
              tail-ptr
              value-ir
              elem-ty)
            arr-value
            0
            new-buf
            (AstType.U64))
          arr-value
          8
          new-len
          (AstType.I64))
        CompilerIrValue.Unit
        (AstType.Unit))]))

(define (lower-array-push-alloc-buffer
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [old-buf : CompilerIrValue]
  [old-len : CompilerIrValue]
  [elem-size : i64]
  [elem-ty : AstType]
  [value-ir : CompilerIrValue]) : LowerExpr
  (match (lower-emit-binop
    state
    CompilerIrBinOp.Add
    old-len
    (CompilerIrValue.I64 1)
    (AstType.I64))
    [(LowerExpr len-state new-len _)
      (match (lower-emit-binop
        len-state
        CompilerIrBinOp.Mul
        new-len
        (CompilerIrValue.I64 elem-size)
        (AstType.I64))
        [(LowerExpr byte-state byte-count _)
          (match (lower-state-alloc-var byte-state)
            [(LowerAlloc buf-alloc buf-var)
              (lower-array-push-finish
                ctx
                (lower-state-emit
                  buf-alloc
                  (CompilerIrInstr.Call
                    buf-var
                    "tl_alloc"
                    (CompilerIrCallArgs.One byte-count)
                    (AstType.U64)))
                arr-value
                old-buf
                old-len
                (CompilerIrValue.Var buf-var)
                new-len
                elem-ty
                value-ir)])])]))

(define (lower-array-push-after-max-check
  [ctx : TcContext]
  [state : LowerState]
  [fail-label : String]
  [alloc-label : String]
  [arr-value : CompilerIrValue]
  [old-buf : CompilerIrValue]
  [old-len : CompilerIrValue]
  [elem-size : i64]
  [elem-ty : AstType]
  [value-ir : CompilerIrValue]) : LowerExpr
  (let
    [fail-start : LowerState (lower-state-finish-block state fail-label)]
    [alloc-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (CompilerIrInstr.Jump alloc-label))
        alloc-label)]
    (lower-array-push-alloc-buffer
      ctx
      alloc-start
      arr-value
      old-buf
      old-len
      elem-size
      elem-ty
      value-ir)))

(define (lower-array-push-from-values
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [elem-ty : AstType]
  [value-ir : CompilerIrValue]) : LowerExpr
  (match (lower-load-at-offset state arr-value 8 (AstType.I64))
    [(LowerExpr len-state old-len _)
      (match (lower-load-at-offset len-state arr-value 0 (AstType.U64))
        [(LowerExpr buf-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            [max-old-len : i64
              (if (= elem-size 0)
                9223372036854775806
                (- (/ 9223372036854775807 elem-size) 1))]
            (match (lower-state-fresh-label buf-state "array_push_alloc")
              [(LowerLabel alloc-label-state alloc-label)
                (match (lower-state-fresh-label
                  alloc-label-state
                  "array_push_fail")
                  [(LowerLabel fail-label-state fail-label)
                    (match (lower-emit-binop
                      fail-label-state
                      CompilerIrBinOp.Le
                      old-len
                      (CompilerIrValue.I64 max-old-len)
                      (AstType.Bool))
                      [(LowerExpr check-state within-max _)
                        (lower-array-push-after-max-check
                          ctx
                          (lower-state-emit
                            check-state
                            (CompilerIrInstr.Branch
                              within-max
                              alloc-label
                              fail-label))
                          fail-label
                          alloc-label
                          arr-value
                          old-buf
                          old-len
                          elem-size
                          elem-ty
                          value-ir)])])]))])]))

;; `(array-push! arr value)` -> allocate a new element buffer in the active
;; arena, copy old elements, append `value`, and update the fat `{ptr, len}`.
(define (lower-array-push
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [value : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      (match (tc-array-push-receiver ctx arr-ty)
        [(ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(TcArrayReceiver _ elem-ty)
              (let
                [elem-ir-ty : AstType (tc-type-without-regions elem-ty)]
                (match (lower-expr ctx state env type-env arr)
                  [(OkLowerExpr arr-lowered)
                    (match arr-lowered
                      [(LowerExpr arr-state arr-value _)
                        (match (lower-expr-expected
                          ctx
                          arr-state
                          env
                          type-env
                          value
                          elem-ir-ty
                          value)
                          [(OkLowerExpr value-lowered)
                            (match value-lowered
                              [(LowerExpr value-state value-ir _)
                                (OkLowerExpr
                                  (lower-array-push-from-values
                                    ctx
                                    value-state
                                    arr-value
                                    elem-ir-ty
                                    value-ir))])]
                          [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)]))])]
        [(ResultTcArrayReceiver.Err message)
          (ErrLowerExpr (box (lower-diagnostic-at-expr arr message)))])]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr arr message)))]))

;; Lower each syscall operand and widen it to i64 (the kernel reads the full
;; 64-bit registers). Mirrors `lower-args` but inserts the cast.
(define (lower-syscall-args
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]) : ResultLowerArgs
  (match args
    [(AstExprList.Nil) (OkLowerArgs state IrValueNil)]
    [(AstExprList.Cons arg rest)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest : AstExprList (box-get rest)]
        (match (lower-expr ctx state env type-env arg)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr arg-state value value-ty)
                (match (lower-cast-value arg-state value value-ty (AstType.I64))
                  [(LowerExpr cast-state cast-value _)
                    (match (lower-syscall-args ctx cast-state env type-env rest)
                      [(OkLowerArgs rest-state rest-values)
                        (OkLowerArgs
                          rest-state
                          (compiler-ir-value-cons cast-value rest-values))]
                      [(ErrLowerArgs message) (ErrLowerArgs message)])])])]
          [(ErrLowerExpr message) (ErrLowerArgs message)]))]))

(define (lower-syscall
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]) : ResultLowerExpr
  (match (lower-syscall-args ctx state env type-env args)
    [(OkLowerArgs args-state values)
      (match (lower-state-alloc-var args-state)
        [(LowerAlloc allocated var-id)
          (OkLowerExpr
            (LowerExpr
              (lower-state-emit
                allocated
                (CompilerIrInstr.Syscall
                  var-id
                  (compiler-ir-call-args-from-list values)))
              (CompilerIrValue.Var var-id)
              (AstType.I64)))])]
    [(ErrLowerArgs message) (ErrLowerExpr message)]))

(define (lower-args
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]) : ResultLowerArgs
  (match args
    [(AstExprList.Nil) (OkLowerArgs state IrValueNil)]
    [(AstExprList.Cons arg rest)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest : AstExprList (box-get rest)]
        (match (lower-expr ctx state env type-env arg)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr arg-state value _)
                (match (lower-args ctx arg-state env type-env rest)
                  [(OkLowerArgs rest-state rest-values)
                    (OkLowerArgs
                      rest-state
                      (compiler-ir-value-cons value rest-values))]
                  [(ErrLowerArgs message) (ErrLowerArgs message)])])]
          [(ErrLowerExpr message) (ErrLowerArgs message)]))]))

(define (lower-let-binding-type
  [ctx : TcContext]
  [maybe-ty : AstMaybeType]
  [init-ty : AstType]) : AstType
  (match maybe-ty
    [(AstMaybeType.Some ty) (tc-type-without-regions (tc-resolve-type ctx ty))]
    [(AstMaybeType.No) (tc-type-without-regions init-ty)]))

(define (lower-let-init
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]) : ResultLowerExpr
  (match maybe-ty
    [(AstMaybeType.Some ty)
      (if (tc-ref-capturing-lambda-init? type-env init)
        (match (ast-expr-unspan init)
          [(AstExpr.Lambda lambda-box)
            (match (box-get lambda-box)
              [(AstLambda.Lambda params lambda-ret body-box)
                (let
                  [body : AstExpr (ast-node-get body-box)]
                  [expected-ty : AstType
                    (tc-type-without-regions (tc-resolve-type ctx ty))]
                  (match (lower-lambda
                    ctx
                    state
                    env
                    type-env
                    params
                    lambda-ret
                    body
                    init
                    expected-ty)
                    [(OkLowerExpr lowered)
                      (match lowered
                        [(LowerExpr next-state value actual-ty)
                          (OkLowerExpr
                            (lower-coerce-value
                              next-state
                              value
                              actual-ty
                              expected-ty))])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)]))])]
          [_
            (lower-expr-expected
              ctx
              state
              env
              type-env
              init
              (tc-type-without-regions (tc-resolve-type ctx ty))
              init)])
        (lower-expr-expected
          ctx
          state
          env
          type-env
          init
          (tc-type-without-regions (tc-resolve-type ctx ty))
          init))]
    [(AstMaybeType.No)
      (if (tc-ref-capturing-lambda-init? type-env init)
        (match (ast-expr-unspan init)
          [(AstExpr.Lambda lambda-box)
            (match (box-get lambda-box)
              [(AstLambda.Lambda params lambda-ret body-box)
                (let
                  [body : AstExpr (ast-node-get body-box)]
                  (match (tc-lambda-expr-allow-ref-captures
                    ctx
                    type-env
                    params
                    lambda-ret
                    body)
                    [(ResultTcType.Ok lambda-ty)
                      (lower-lambda
                        ctx
                        state
                        env
                        type-env
                        params
                        lambda-ret
                        body
                        init
                        lambda-ty)]
                    [(ResultTcType.Err message)
                      (ErrLowerExpr
                        (box (lower-diagnostic-at-expr init message)))]))])]
          [_ (lower-expr ctx state env type-env init)])
        (lower-expr ctx state env type-env init))]))

(define (lower-let-bindings
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstLetBindingList]) : ResultLowerEnv
  (match bindings
    [(AstLetBindingList.Nil) (OkLowerEnv state env type-env)]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name maybe-ty init-box)
            (let
              [name-id : i64 name]
              [init : AstExpr (ast-node-get init-box)]
              (match (lower-let-init ctx state env type-env maybe-ty init)
                [(OkLowerExpr lowered)
                  (match lowered
                    [(LowerExpr init-state init-value init-ty)
                      (let
                        [binding-ty : AstType
                          (lower-let-binding-type ctx maybe-ty init-ty)]
                        [binding-ir-ty : AstType
                          (lower-one-word-register-storage-type ctx binding-ty)]
                        (match (lower-state-alloc-var init-state)
                          [(LowerAlloc allocated var-id)
                            (let
                              [next-type-env : TcTypeEnv
                                (tc-bind-c-abi-fnptr-if-needed-id
                                  ctx
                                  type-env
                                  name-id
                                  binding-ty
                                  init)]
                              (lower-let-bindings
                                ctx
                                (lower-state-emit
                                  allocated
                                  (CompilerIrInstr.Mov
                                    var-id
                                    init-value
                                    binding-ir-ty))
                                (sym_i64_env.sym-i64-bind-id env name-id var-id)
                                next-type-env
                                rest))]))])]
                [(ErrLowerExpr message) (ErrLowerEnv message)]))]))]))

(define (lower-resource-bindings
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstResourceBindingList]
  [cleanups : LowerCleanupStack]) : ResultLowerResourceBindings
  (match bindings
    [(AstResourceBindingList.Nil)
      (OkLowerResourceBindings
        (LowerResourceBindings state env type-env cleanups))]
    [(AstResourceBindingList.Cons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding.Binding name init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (match (tc-resource-cleanup-resource-type ctx type-env cleanup)
                [(ResultTcType.Ok expected-init-ty)
                  (match (lower-expr-expected
                    ctx
                    state
                    env
                    type-env
                    init
                    (tc-type-without-regions expected-init-ty)
                    init)
                    [(OkLowerExpr lowered)
                      (match lowered
                        [(LowerExpr init-state init-value init-ty)
                          (match (lower-cleanup-name-from-expr cleanup)
                            [(ResultTcString.Ok cleanup-name)
                              (let
                                [binding-ty : AstType
                                  (tc-type-without-regions init-ty)]
                                [binding-ir-ty : AstType
                                  (lower-one-word-register-storage-type
                                    ctx
                                    binding-ty)]
                                (match (lower-state-alloc-var init-state)
                                  [(LowerAlloc allocated var-id)
                                    (let
                                      [hidden-name : String
                                        (lower-cleanup-hidden-name var-id)]
                                      [bound-state : LowerState
                                        (lower-state-emit
                                          allocated
                                          (CompilerIrInstr.Mov
                                            var-id
                                            init-value
                                            binding-ir-ty))]
                                      [bound-env : sym_i64_env.SymI64Env
                                        (sym_i64_env.sym-i64-bind
                                          (sym_i64_env.sym-i64-bind-id
                                            env
                                            name
                                            var-id)
                                          hidden-name
                                          var-id)]
                                      [bound-type-env : TcTypeEnv
                                        (lower-type-env-push-cleanup
                                          (tc-bind-id type-env name binding-ty)
                                          hidden-name
                                          cleanup-name)]
                                      (lower-resource-bindings
                                        ctx
                                        bound-state
                                        bound-env
                                        bound-type-env
                                        rest
                                        (lower-cleanup-stack-push
                                          cleanups
                                          hidden-name
                                          cleanup-name)))]))]
                            [(ResultTcString.Err message)
                              (ErrLowerResourceBindings
                                (box (lower-diagnostic-at-expr cleanup message)))])])]
                    [(ErrLowerExpr message) (ErrLowerResourceBindings message)])]
                [(ResultTcType.Err message)
                  (ErrLowerResourceBindings
                    (box (lower-diagnostic-at-expr cleanup message)))]))]))]))

(define (lower-with-resource
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstResourceBindingList]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-resource-bindings
    ctx
    state
    env
    type-env
    bindings
    (lower-cleanup-stack-empty))
    [(OkLowerResourceBindings lowered-bindings)
      (match lowered-bindings
        [(LowerResourceBindings binding-state body-env body-type-env cleanups)
          (match (lower-begin ctx binding-state body-env body-type-env body)
            [(OkLowerExpr lowered-body)
              (match lowered-body
                [(LowerExpr body-state value body-ty)
                  (if (tc-never-type? body-ty)
                    (OkLowerExpr (LowerExpr body-state value body-ty))
                    (match (lower-emit-cleanup-stack
                      body-state
                      body-env
                      cleanups)
                      [(OkLowerState cleanup-state)
                        (OkLowerExpr (LowerExpr cleanup-state value body-ty))]
                      [(ErrLowerState message) (ErrLowerExpr message)]))])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerResourceBindings message) (ErrLowerExpr message)]))

(define (lower-begin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : ResultLowerExpr
  (match exprs
    [(AstExprList.Nil)
      (OkLowerExpr (LowerExpr state CompilerIrValue.Unit (AstType.Unit)))]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprList.Nil) (lower-expr ctx state env type-env expr)]
          [_
            (match (lower-expr ctx state env type-env expr)
              [(OkLowerExpr lowered)
                (match lowered
                  [(LowerExpr next-state _ expr-ty)
                    (if (tc-never-type? expr-ty)
                      (OkLowerExpr
                        (LowerExpr
                          next-state
                          CompilerIrValue.Unit
                          (AstType.Never)))
                      (lower-begin ctx next-state env type-env rest))])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]))]))

(define (lower-begin-expected
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]
  [expected-ty : AstType]) : ResultLowerExpr
  (match exprs
    [(AstExprList.Nil)
      (OkLowerExpr (LowerExpr state CompilerIrValue.Unit (AstType.Unit)))]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprList.Nil)
            (lower-expr-expected ctx state env type-env expr expected-ty expr)]
          [_
            (match (lower-expr ctx state env type-env expr)
              [(OkLowerExpr lowered)
                (match lowered
                  [(LowerExpr next-state _ expr-ty)
                    (if (tc-never-type? expr-ty)
                      (OkLowerExpr
                        (LowerExpr
                          next-state
                          CompilerIrValue.Unit
                          (AstType.Never)))
                      (lower-begin-expected
                        ctx
                        next-state
                        env
                        type-env
                        rest
                        expected-ty))])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]))]))

(define (lower-with-arena
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc mark-allocated mark-var)
      (let
        [hidden-name : String (lower-region-hidden-name mark-var)]
        [marked-state : LowerState
          (lower-state-emit
            mark-allocated
            (CompilerIrInstr.Call
              mark-var
              "tl_region_mark"
              (CompilerIrCallArgs.Nil)
              (AstType.U64)))]
        [region-env : SymI64Env
          (sym_i64_env.sym-i64-bind env hidden-name mark-var)]
        [region-type-env : TcTypeEnv
          (lower-type-env-push-region-reset type-env hidden-name)]
        (match (lower-begin ctx marked-state region-env region-type-env body)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr body-state value body-ty)
                (if (tc-never-type? body-ty)
                  (OkLowerExpr (LowerExpr body-state value body-ty))
                  (match (lower-state-alloc-var body-state)
                    [(LowerAlloc reset-allocated reset-var)
                      (OkLowerExpr
                        (LowerExpr
                          (lower-state-emit
                            reset-allocated
                            (CompilerIrInstr.Call
                              reset-var
                              "tl_region_reset"
                              (CompilerIrCallArgs.One
                                (CompilerIrValue.Var mark-var))
                              (AstType.Unit)))
                          value
                          body-ty))]))])]
          [(ErrLowerExpr message) (ErrLowerExpr message)]))]))

(define (lower-arena-handle
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arena : AstExpr]
  [form : String]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arena)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr arena-state arena-value arena-ty)
          (if (tc-arena-type? ctx arena-ty)
            (lower-struct-get-named
              ctx
              arena-state
              arena-value
              (lower-struct-type-name-or-empty (tc-resolve-type ctx arena-ty))
              "handle"
              (AstType.I64))
            (ErrLowerExpr
              (box
                (lower-diagnostic
                  (str_cat.str-cat "lower: " form " arena must be Arena")))))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-in-arena
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arena : AstExpr]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc saved-allocated saved-var)
      (let
        [saved-state : LowerState
          (lower-state-emit
            saved-allocated
            (CompilerIrInstr.Call
              saved-var
              "tl_arena_current"
              CompilerIrCallArgs.Nil
              (AstType.I64)))]
        (match (lower-arena-handle
          ctx
          saved-state
          env
          type-env
          arena
          "in-arena")
          [(OkLowerExpr arena-lowered)
            (match arena-lowered
              [(LowerExpr arena-state arena-value _)
                (match (lower-runtime-call-values
                  arena-state
                  "tl_arena_set"
                  (compiler-ir-value-cons arena-value IrValueNil)
                  (AstType.Unit))
                  [(OkLowerExpr set-lowered)
                    (match set-lowered
                      [(LowerExpr set-state _ _)
                        (let
                          [hidden-name : String
                            (lower-arena-restore-hidden-name saved-var)]
                          [body-env : sym_i64_env.SymI64Env
                            (sym_i64_env.sym-i64-bind env hidden-name saved-var)]
                          [body-type-env : TcTypeEnv
                            (lower-type-env-push-arena-restore
                              type-env
                              hidden-name)]
                          (match (lower-begin
                            ctx
                            set-state
                            body-env
                            body-type-env
                            body)
                            [(OkLowerExpr body-lowered)
                              (match body-lowered
                                [(LowerExpr body-state value body-ty)
                                  (if (tc-never-type? body-ty)
                                    (OkLowerExpr
                                      (LowerExpr body-state value body-ty))
                                    (match (lower-runtime-call-values
                                      body-state
                                      "tl_arena_set"
                                      (compiler-ir-value-cons
                                        (CompilerIrValue.Var saved-var)
                                        IrValueNil)
                                      (AstType.Unit))
                                      [(OkLowerExpr restore-lowered)
                                        (match restore-lowered
                                          [(LowerExpr restore-state _ _)
                                            (OkLowerExpr
                                              (LowerExpr
                                                restore-state
                                                value
                                                body-ty))])]
                                      [(ErrLowerExpr message)
                                        (ErrLowerExpr message)]))])]
                            [(ErrLowerExpr message) (ErrLowerExpr message)]))])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)])])]
          [(ErrLowerExpr message) (ErrLowerExpr message)]))]))

(define (lower-with-escape-final
  [final-lowered : LowerExpr]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match final-lowered
    [(LowerExpr final-state _ _)
      (OkLowerExpr (LowerExpr final-state escaped-value escaped-ty))]))

(define (lower-with-escape-rewind
  [state : LowerState]
  [mark-value : CompilerIrValue]
  [new-enclosing-value : CompilerIrValue]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    "tl_region_reset"
    (compiler-ir-value-cons mark-value IrValueNil)
    (AstType.Unit))
    [(OkLowerExpr rewind-lowered)
      (match rewind-lowered
        [(LowerExpr rewind-state _ _)
          (match (lower-runtime-call-values
            rewind-state
            "tl_arena_set"
            (compiler-ir-value-cons new-enclosing-value IrValueNil)
            (AstType.Unit))
            [(OkLowerExpr final-lowered)
              (lower-with-escape-final final-lowered escaped-value escaped-ty)]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-with-escape-cleanup
  [state : LowerState]
  [scratch-head-value : CompilerIrValue]
  [mark-value : CompilerIrValue]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    "tl_arena_current"
    IrValueNil
    (AstType.I64))
    [(OkLowerExpr new-enclosing-lowered)
      (match new-enclosing-lowered
        [(LowerExpr new-enclosing-state new-enclosing-value _)
          (match (lower-runtime-call-values
            new-enclosing-state
            "tl_arena_set"
            (compiler-ir-value-cons scratch-head-value IrValueNil)
            (AstType.Unit))
            [(OkLowerExpr restore-scratch-lowered)
              (match restore-scratch-lowered
                [(LowerExpr restore-scratch-state _ _)
                  (lower-with-escape-rewind
                    restore-scratch-state
                    mark-value
                    new-enclosing-value
                    escaped-value
                    escaped-ty)])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-with-escape-clone
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scratch-head-value : CompilerIrValue]
  [mark-value : CompilerIrValue]
  [body-value : CompilerIrValue]
  [body-ty : AstType]) : ResultLowerExpr
  (match (lower-clone-dispatch ctx state env type-env body-value body-ty)
    [(OkLowerExpr escaped-lowered)
      (match escaped-lowered
        [(LowerExpr escaped-state escaped-value escaped-ty)
          (lower-with-escape-cleanup
            escaped-state
            scratch-head-value
            mark-value
            escaped-value
            escaped-ty)])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-with-escape-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [enclosing-value : CompilerIrValue]
  [mark-value : CompilerIrValue]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-begin ctx state env type-env body)
    [(OkLowerExpr body-lowered)
      (match body-lowered
        [(LowerExpr body-state body-value body-ty)
          (match (lower-runtime-call-values
            body-state
            "tl_arena_current"
            IrValueNil
            (AstType.I64))
            [(OkLowerExpr scratch-head-lowered)
              (match scratch-head-lowered
                [(LowerExpr scratch-head-state scratch-head-value _)
                  (match (lower-runtime-call-values
                    scratch-head-state
                    "tl_arena_set"
                    (compiler-ir-value-cons enclosing-value IrValueNil)
                    (AstType.Unit))
                    [(OkLowerExpr restore-enclosing-lowered)
                      (match restore-enclosing-lowered
                        [(LowerExpr restore-state _ _)
                          (lower-with-escape-clone
                            ctx
                            restore-state
                            env
                            type-env
                            scratch-head-value
                            mark-value
                            body-value
                            body-ty)])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-with-escape
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scratch : AstExpr]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    "tl_arena_current"
    IrValueNil
    (AstType.I64))
    [(OkLowerExpr enclosing-lowered)
      (match enclosing-lowered
        [(LowerExpr enclosing-state enclosing-value _)
          (match (lower-arena-handle
            ctx
            enclosing-state
            env
            type-env
            scratch
            "with-escape")
            [(OkLowerExpr scratch-lowered)
              (match scratch-lowered
                [(LowerExpr scratch-state scratch-value _)
                  (match (lower-runtime-call-values
                    scratch-state
                    "tl_arena_set"
                    (compiler-ir-value-cons scratch-value IrValueNil)
                    (AstType.Unit))
                    [(OkLowerExpr set-scratch-lowered)
                      (match set-scratch-lowered
                        [(LowerExpr set-scratch-state _ _)
                          (match (lower-runtime-call-values
                            set-scratch-state
                            "tl_region_mark"
                            IrValueNil
                            (AstType.U64))
                            [(OkLowerExpr mark-lowered)
                              (match mark-lowered
                                [(LowerExpr mark-state mark-value _)
                                  (lower-with-escape-body
                                    ctx
                                    mark-state
                                    env
                                    type-env
                                    enclosing-value
                                    mark-value
                                    body)])]
                            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-with-scratch-final-restore
  [state : LowerState]
  [new-enclosing-value : CompilerIrValue]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    "tl_arena_set"
    (compiler-ir-value-cons new-enclosing-value IrValueNil)
    (AstType.Unit))
    [(OkLowerExpr final-lowered)
      (lower-with-escape-final final-lowered escaped-value escaped-ty)]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-with-scratch-cleanup
  [state : LowerState]
  [scratch-head-value : CompilerIrValue]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    "tl_arena_current"
    IrValueNil
    (AstType.I64))
    [(OkLowerExpr new-enclosing-lowered)
      (match new-enclosing-lowered
        [(LowerExpr new-enclosing-state new-enclosing-value _)
          (match (lower-runtime-call-values
            new-enclosing-state
            "tl_arena_destroy"
            (compiler-ir-value-cons scratch-head-value IrValueNil)
            (AstType.Unit))
            [(OkLowerExpr destroy-lowered)
              (match destroy-lowered
                [(LowerExpr destroy-state _ _)
                  (lower-with-scratch-final-restore
                    destroy-state
                    new-enclosing-value
                    escaped-value
                    escaped-ty)])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-with-scratch-clone
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scratch-head-value : CompilerIrValue]
  [body-value : CompilerIrValue]
  [body-ty : AstType]) : ResultLowerExpr
  (match (lower-clone-dispatch ctx state env type-env body-value body-ty)
    [(OkLowerExpr escaped-lowered)
      (match escaped-lowered
        [(LowerExpr escaped-state escaped-value escaped-ty)
          (lower-with-scratch-cleanup
            escaped-state
            scratch-head-value
            escaped-value
            escaped-ty)])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-with-scratch-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [enclosing-value : CompilerIrValue]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-begin ctx state env type-env body)
    [(OkLowerExpr body-lowered)
      (match body-lowered
        [(LowerExpr body-state body-value body-ty)
          (match (lower-runtime-call-values
            body-state
            "tl_arena_current"
            IrValueNil
            (AstType.I64))
            [(OkLowerExpr scratch-head-lowered)
              (match scratch-head-lowered
                [(LowerExpr scratch-head-state scratch-head-value _)
                  (match (lower-runtime-call-values
                    scratch-head-state
                    "tl_arena_set"
                    (compiler-ir-value-cons enclosing-value IrValueNil)
                    (AstType.Unit))
                    [(OkLowerExpr restore-enclosing-lowered)
                      (match restore-enclosing-lowered
                        [(LowerExpr restore-state _ _)
                          (lower-with-scratch-clone
                            ctx
                            restore-state
                            env
                            type-env
                            scratch-head-value
                            body-value
                            body-ty)])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-with-scratch
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    "tl_arena_current"
    IrValueNil
    (AstType.I64))
    [(OkLowerExpr enclosing-lowered)
      (match enclosing-lowered
        [(LowerExpr enclosing-state enclosing-value _)
          (match (lower-runtime-call-values
            enclosing-state
            "tl_arena_make"
            IrValueNil
            (AstType.I64))
            [(OkLowerExpr scratch-lowered)
              (match scratch-lowered
                [(LowerExpr scratch-state scratch-value _)
                  (match (lower-runtime-call-values
                    scratch-state
                    "tl_arena_set"
                    (compiler-ir-value-cons scratch-value IrValueNil)
                    (AstType.Unit))
                    [(OkLowerExpr set-scratch-lowered)
                      (match set-scratch-lowered
                        [(LowerExpr set-scratch-state _ _)
                          (lower-with-scratch-body
                            ctx
                            set-scratch-state
                            env
                            type-env
                            enclosing-value
                            body)])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-if-merge
  [ctx : TcContext]
  [else-state : LowerState]
  [then-value : CompilerIrValue]
  [then-end-label : String]
  [else-value : CompilerIrValue]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (let
    [else-end-label : String (lower-state-current-label else-state)]
    [expr-ir-ty : AstType (lower-one-word-register-storage-type ctx expr-ty)]
    [merge-start : LowerState
      (lower-state-finish-block
        (lower-state-emit else-state (CompilerIrInstr.Jump merge-label))
        merge-label)]
    (match (lower-state-alloc-var merge-start)
      [(LowerAlloc allocated var-id)
        (OkLowerExpr
          (LowerExpr
            (lower-state-emit
              allocated
              (CompilerIrInstr.Phi
                var-id
                (compiler-ir-phi-input-cons
                  then-value
                  then-end-label
                  (compiler-ir-phi-input-cons
                    else-value
                    else-end-label
                    CompilerIrPhiInputList.Nil))
                expr-ir-ty))
            (CompilerIrValue.Var var-id)
            expr-ty))])))

(define (lower-if-single-merge
  [state : LowerState]
  [value : CompilerIrValue]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (let
    [merge-start : LowerState
      (lower-state-finish-block
        (lower-state-emit state (CompilerIrInstr.Jump merge-label))
        merge-label)]
    (OkLowerExpr (LowerExpr merge-start value expr-ty))))

(define (lower-if-finish
  [ctx : TcContext]
  [then-value : CompilerIrValue]
  [then-ty : AstType]
  [then-end-label : String]
  [else-state : LowerState]
  [else-value : CompilerIrValue]
  [else-ty : AstType]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (tc-never-type? then-ty)
    (if (tc-never-type? else-ty)
      (OkLowerExpr
        (LowerExpr
          (lower-state-finish-block else-state merge-label)
          CompilerIrValue.Unit
          (AstType.Never)))
      (lower-if-single-merge else-state else-value merge-label expr-ty))
    (if (tc-never-type? else-ty)
      (OkLowerExpr
        (LowerExpr
          (lower-state-finish-block else-state merge-label)
          then-value
          expr-ty))
      (lower-if-merge
        ctx
        else-state
        then-value
        then-end-label
        else-value
        merge-label
        expr-ty))))

(define (lower-if-else
  [ctx : TcContext]
  [else-start : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [else-branch : AstExpr]
  [then-value : CompilerIrValue]
  [then-ty : AstType]
  [then-end-label : String]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    else-start
    env
    type-env
    else-branch
    expr-ty
    else-branch)
    [(OkLowerExpr else-lowered)
      (match else-lowered
        [(LowerExpr else-state else-value else-ty)
          (lower-if-finish
            ctx
            then-value
            then-ty
            then-end-label
            else-state
            else-value
            else-ty
            merge-label
            expr-ty)])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-if-then
  [ctx : TcContext]
  [then-start : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [then-branch : AstExpr]
  [else-branch : AstExpr]
  [else-label : String]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    then-start
    env
    type-env
    then-branch
    expr-ty
    then-branch)
    [(OkLowerExpr then-lowered)
      (match then-lowered
        [(LowerExpr then-state then-value then-ty)
          (let
            [then-end-label : String (lower-state-current-label then-state)]
            [else-start : LowerState
              (if (tc-never-type? then-ty)
                (lower-state-finish-block then-state else-label)
                (lower-state-finish-block
                  (lower-state-emit
                    then-state
                    (CompilerIrInstr.Jump merge-label))
                  else-label))]
            (lower-if-else
              ctx
              else-start
              env
              type-env
              else-branch
              then-value
              then-ty
              then-end-label
              merge-label
              expr-ty))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-if
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [cond : AstExpr]
  [then-branch : AstExpr]
  [else-branch : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env cond)
    [(OkLowerExpr cond-lowered)
      (match cond-lowered
        [(LowerExpr cond-state cond-value cond-ty)
          (if (tc-type-compatible? (AstType.Bool) cond-ty)
            (match (lower-state-fresh-label cond-state "if_then")
              [(LowerLabel then-label-state then-label)
                (match (lower-state-fresh-label then-label-state "if_else")
                  [(LowerLabel else-label-state else-label)
                    (match (lower-state-fresh-label else-label-state "if_merge")
                      [(LowerLabel merge-label-state merge-label)
                        (let
                          [branch-state : LowerState
                            (lower-state-emit
                              merge-label-state
                              (CompilerIrInstr.Branch
                                cond-value
                                then-label
                                else-label))]
                          (lower-if-then
                            ctx
                            (lower-state-finish-block branch-state then-label)
                            env
                            type-env
                            then-branch
                            else-branch
                            else-label
                            merge-label
                            expr-ty))])])])
            (ErrLowerExpr
              (box
                (lower-diagnostic-at-expr
                  cond
                  "typecheck: if condition must be bool"))))])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-while
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [cond : AstExpr]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-state-fresh-label state "while_header")
    [(LowerLabel header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "while_body")
        [(LowerLabel body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "while_exit")
            [(LowerLabel exit-label-state exit-label)
              (let
                [header-start : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      exit-label-state
                      (CompilerIrInstr.Jump header-label))
                    header-label)]
                (match (lower-expr ctx header-start env type-env cond)
                  [(OkLowerExpr cond-lowered)
                    (match cond-lowered
                      [(LowerExpr cond-state cond-value _)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                cond-state
                                (CompilerIrInstr.Branch
                                  cond-value
                                  body-label
                                  exit-label))
                              body-label)]
                          (match (lower-expr ctx body-start env type-env body)
                            [(OkLowerExpr body-lowered)
                              (match body-lowered
                                [(LowerExpr body-state _ body-ty)
                                  (OkLowerExpr
                                    (LowerExpr
                                      (if (tc-never-type? body-ty)
                                        (lower-state-finish-block
                                          body-state
                                          exit-label)
                                        (lower-state-finish-block
                                          (lower-state-emit
                                            body-state
                                            (CompilerIrInstr.Jump header-label))
                                          exit-label))
                                      CompilerIrValue.Unit
                                      (AstType.Unit)))])]
                            [(ErrLowerExpr message) (ErrLowerExpr message)]))])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)]))])])]))

;; Per-iteration accumulator update for an associative binop fold
;; (`sum`/`all`/`any`): `(set! acc (<op> acc value))`. `value` appears once so it
;; is evaluated exactly once per iteration.
(define (spmd-reduce-acc-binop-update [op : AstBinOp] [value : i64]) : i64
  (ast-expr-set
    (lower-spmd-reduce-acc-name)
    (ast-expr-binary
      op
      (ast-node-push (AstExpr.Var (lower-spmd-reduce-acc-id)))
      value)))

;; Per-iteration accumulator update for a select fold (`min`/`max`): bind `value`
;; once into a temp, then keep it when `(<cmp> val acc)` holds, else keep `acc`.
;; The temp keeps `value` to a single evaluation even though the select names it
;; twice.
(define (spmd-reduce-acc-select-update [cmp : AstBinOp] [value : i64]) : i64
  (ast-expr-let
    (ast-let-binding-cons
      (ast-let-binding (lower-spmd-reduce-val-name) (AstMaybeType.No) value)
      (AstLetBindingList.Nil))
    (ast-expr-set
      (lower-spmd-reduce-acc-name)
      (ast-expr-if
        (ast-expr-binary
          cmp
          (ast-node-push (AstExpr.Var (lower-spmd-reduce-val-id)))
          (ast-node-push (AstExpr.Var (lower-spmd-reduce-acc-id))))
        (ast-node-push (AstExpr.Var (lower-spmd-reduce-val-id)))
        (ast-node-push (AstExpr.Var (lower-spmd-reduce-acc-id)))))))

(define (spmd-reduce-acc-update-expr [op : AstReduceOp] [value : i64]) : i64
  (match op
    [(AstReduceOp.Sum) (spmd-reduce-acc-binop-update (AstBinOp.Add) value)]
    [(AstReduceOp.All) (spmd-reduce-acc-binop-update (AstBinOp.And) value)]
    [(AstReduceOp.Any) (spmd-reduce-acc-binop-update (AstBinOp.Or) value)]
    [(AstReduceOp.Min) (spmd-reduce-acc-select-update (AstBinOp.Lt) value)]
    [(AstReduceOp.Max) (spmd-reduce-acc-select-update (AstBinOp.Gt) value)]))

;; Scalar `spmd-reduce` loop scaffold (#1013): desugar to an accumulator loop and
;; reuse the let/while/set lowering. `acc`/`end`/index are bound once before the
;; loop (so `init`/`end`/`start` evaluate exactly once); an empty range returns
;; `init` without evaluating `acc-update`. `acc`/`end`/temp use lexer-impossible
;; names so they cannot collide with a user binding. The ordered left-to-right
;; fold matches the spec reference semantics.
;;   (spmd-reduce <op> ([i : ty start end]) init value)
;;     === (let [acc : result-ty init] [end' end] [i start]
;;           (begin (while (< i end') (begin <acc-update> (set! i (+ i 1)))) acc))
(define (lower-spmd-reduce-scaffold
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [_result-ty : AstType]
  [index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [init : AstExpr]
  [acc-ty : AstType]
  [acc-update : i64]) : ResultLowerExpr
  (lower-expr
    ctx
    state
    env
    type-env
    (ast-node-get
      (ast-expr-let
        (ast-let-binding-cons
          (ast-let-binding
            (lower-spmd-reduce-acc-name)
            (AstMaybeType.Some acc-ty)
            (ast-node-push init))
          (ast-let-binding-cons
            (ast-let-binding
              (lower-spmd-reduce-end-name)
              (AstMaybeType.Some index-ty)
              (ast-node-push end))
            (ast-let-binding-cons
              (ast-let-binding
                index
                (AstMaybeType.Some index-ty)
                (ast-node-push start))
              (AstLetBindingList.Nil))))
        (ast-node-push
          (AstExpr.Begin
            (ast-expr-cons
              (ast-expr-while
                (ast-expr-binary
                  (AstBinOp.Lt)
                  (ast-node-push (AstExpr.Var (intern index)))
                  (ast-node-push (AstExpr.Var (lower-spmd-reduce-end-id))))
                (ast-node-push
                  (AstExpr.Begin
                    (ast-expr-cons
                      acc-update
                      (ast-expr-cons
                        (ast-expr-set
                          index
                          (ast-expr-binary
                            (AstBinOp.Add)
                            (ast-node-push (AstExpr.Var (intern index)))
                            (ast-node-push (AstExpr.Literal (ast-lit-int 1)))))
                        (AstExprList.Nil))))))
              (ast-expr-cons
                (ast-node-push (AstExpr.Var (lower-spmd-reduce-acc-id)))
                (AstExprList.Nil)))))))))

;; Scalar lowering for all reduction ops (#1013): `sum` (wrapping `+`, also f64
;; ordered add), `all`/`any` (boolean `and`/`or`), and `min`/`max` (ordered
;; select). Each supplies its per-iteration accumulator update to the shared
;; loop scaffold.
(define (lower-spmd-reduce
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [result-ty : AstType]
  [op : AstReduceOp]
  [index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [init : AstExpr]
  [value : AstExpr]) : ResultLowerExpr
  (match (tc-expr ctx (tc-bind type-env index index-ty) value)
    [(ResultTcType.Ok value-ty)
      (let
        [acc-ty : AstType (tc-type-without-regions value-ty)]
        [acc-update : i64
          (spmd-reduce-acc-update-expr op (ast-node-push value))]
        (if (and
          (lower-mode-simd? (lower-state-mode state))
          (lower-type-i64? index-ty))
          (let
            [plan : LowerMaybeVectorReduce
              (lower-simple-vector-reduce
                (lower-state-mode state)
                env
                type-env
                op
                index
                acc-ty
                value)]
            (match plan
              [(LowerSomeVectorReduce _ _ _ _)
                (lower-avx2-spmd-reduce-lowered
                  ctx
                  state
                  env
                  type-env
                  index-ty
                  start
                  end
                  init
                  op
                  plan)]
              [(LowerSomeVectorValueReduce _ _ _ _)
                (lower-avx2-spmd-reduce-lowered
                  ctx
                  state
                  env
                  type-env
                  index-ty
                  start
                  end
                  init
                  op
                  plan)]
              [LowerNoVectorReduce
                (lower-spmd-reduce-scaffold
                  ctx
                  state
                  env
                  type-env
                  result-ty
                  index
                  index-ty
                  start
                  end
                  init
                  acc-ty
                  acc-update)]))
          (lower-spmd-reduce-scaffold
            ctx
            state
            env
            type-env
            result-ty
            index
            index-ty
            start
            end
            init
            acc-ty
            acc-update)))]
    [(ResultTcType.Err message)
      (ErrLowerExpr (box (lower-diagnostic-at-expr value message)))]))

(define (spmd-scan-binop-prefix [op : AstBinOp] [value : i64]) : i64
  (ast-expr-binary
    op
    (ast-node-push (AstExpr.Var (lower-spmd-scan-acc-id)))
    value))

(define (spmd-scan-select-prefix [cmp : AstBinOp] [value : i64]) : i64
  (ast-expr-let
    (ast-let-binding-cons
      (ast-let-binding (lower-spmd-scan-val-name) (AstMaybeType.No) value)
      (AstLetBindingList.Nil))
    (ast-expr-if
      (ast-expr-binary
        cmp
        (ast-node-push (AstExpr.Var (lower-spmd-scan-val-id)))
        (ast-node-push (AstExpr.Var (lower-spmd-scan-acc-id))))
      (ast-node-push (AstExpr.Var (lower-spmd-scan-val-id)))
      (ast-node-push (AstExpr.Var (lower-spmd-scan-acc-id))))))

(define (spmd-scan-prefix-expr [op : AstReduceOp] [value : i64]) : i64
  (match op
    [(AstReduceOp.Sum) (spmd-scan-binop-prefix (AstBinOp.Add) value)]
    [(AstReduceOp.All) (spmd-scan-binop-prefix (AstBinOp.And) value)]
    [(AstReduceOp.Any) (spmd-scan-binop-prefix (AstBinOp.Or) value)]
    [(AstReduceOp.Min) (spmd-scan-select-prefix (AstBinOp.Lt) value)]
    [(AstReduceOp.Max) (spmd-scan-select-prefix (AstBinOp.Gt) value)]))

(define (lower-spmd-scan-scaffold
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [prefix : String]
  [prefix-ty : AstType]
  [init : AstExpr]
  [prefix-value : i64]
  [body : AstExpr]) : ResultLowerExpr
  (lower-expr
    ctx
    state
    env
    type-env
    (ast-node-get
      (ast-expr-let
        (ast-let-binding-cons
          (ast-let-binding
            (lower-spmd-scan-acc-name)
            (AstMaybeType.Some prefix-ty)
            (ast-node-push init))
          (ast-let-binding-cons
            (ast-let-binding
              (lower-spmd-scan-end-name)
              (AstMaybeType.Some index-ty)
              (ast-node-push end))
            (ast-let-binding-cons
              (ast-let-binding
                index
                (AstMaybeType.Some index-ty)
                (ast-node-push start))
              (AstLetBindingList.Nil))))
        (ast-node-push
          (AstExpr.Begin
            (ast-expr-cons
              (ast-expr-while
                (ast-expr-binary
                  (AstBinOp.Lt)
                  (ast-node-push (AstExpr.Var (intern index)))
                  (ast-node-push (AstExpr.Var (lower-spmd-scan-end-id))))
                (ast-expr-let
                  (ast-let-binding-cons
                    (ast-let-binding
                      prefix
                      (AstMaybeType.Some prefix-ty)
                      prefix-value)
                    (AstLetBindingList.Nil))
                  (ast-node-push
                    (AstExpr.Begin
                      (ast-expr-cons
                        (ast-expr-set
                          (lower-spmd-scan-acc-name)
                          (ast-node-push (AstExpr.Var (intern prefix))))
                        (ast-expr-cons
                          (ast-node-push body)
                          (ast-expr-cons
                            (ast-expr-set
                              index
                              (ast-expr-binary
                                (AstBinOp.Add)
                                (ast-node-push (AstExpr.Var (intern index)))
                                (ast-node-push
                                  (AstExpr.Literal (ast-lit-int 1)))))
                            (AstExprList.Nil))))))))
              (AstExprList.Nil))))))))

(define (lower-spmd-scan
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [prefix : String]
  [prefix-ty : AstType]
  [init : AstExpr]
  [value : AstExpr]
  [body : AstExpr]) : ResultLowerExpr
  (lower-spmd-scan-scaffold
    ctx
    state
    env
    type-env
    index
    index-ty
    start
    end
    prefix
    prefix-ty
    init
    (spmd-scan-prefix-expr op (ast-node-push value))
    body))

(define (lower-spmd-broadcast
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : AstExpr]
  [lane : AstExpr]) : ResultLowerExpr
  (match (lower-expr-expected ctx state env type-env lane (AstType.I64) lane)
    [(OkLowerExpr lane-lowered)
      (match lane-lowered
        [(LowerExpr lane-state lane-value _)
          (lower-expr
            ctx
            (lower-emit-spmd-broadcast-lane-check
              lane-state
              lane-value
              (CompilerIrValue.I64 1))
            env
            type-env
            value)])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-spmd-shuffle-diagnostic) : String
  "lower: SPMD spmd-shuffle requires scalar backend until SIMD shuffle lowering lands")

(define (lower-spmd-shuffle
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : AstExpr]
  [lane : AstExpr]) : ResultLowerExpr
  (if (lower-mode-simd? (lower-state-mode state))
    (ErrLowerExpr (box (lower-diagnostic (lower-spmd-shuffle-diagnostic))))
    (match (lower-expr-expected ctx state env type-env lane (AstType.I64) lane)
      [(OkLowerExpr lane-lowered)
        (match lane-lowered
          [(LowerExpr lane-state lane-value _)
            (lower-expr
              ctx
              (lower-emit-spmd-broadcast-lane-check
                lane-state
                lane-value
                (CompilerIrValue.I64 1))
              env
              type-env
              value)])]
      [(ErrLowerExpr message) (ErrLowerExpr message)])))

(define (lower-mode-simd? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerAvx2) true]
    [(CompilerLowerLinuxAvx2) true]
    [(CompilerLowerWindowsAvx2) true]
    [(CompilerLowerAvx512) true]
    [(CompilerLowerLinuxAvx512) true]
    [(CompilerLowerWindowsAvx512) true]
    [_ false]))

(define (lower-mode-avx2? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerAvx2) true]
    [(CompilerLowerLinuxAvx2) true]
    [(CompilerLowerWindowsAvx2) true]
    [_ false]))

(define (lower-mode-avx512? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerAvx512) true]
    [(CompilerLowerLinuxAvx512) true]
    [(CompilerLowerWindowsAvx512) true]
    [_ false]))

(define (lower-avx2-masked-if-diagnostic) : String
  "lower: SPMD masked if is not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-avx2-varying-match-diagnostic) : String
  "lower: SPMD varying match is not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-avx2-varying-while-diagnostic) : String
  "lower: SPMD varying while is not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-spmd-bool-lane-diagnostic) : String
  "lower: SPMD foreach bool dynamic-array lanes require AVX-512 backend mode; use scalar or avx512")

(define (lower-simd-foreach-fallback-diagnostic) : String
  "lower: SPMD foreach does not match a SIMD lowering pattern for this backend mode; use scalar or a contiguous map/zip body with supported array and uniform operands")

(define (lower-mode-inline-aggregates? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerScalar) true]
    [(CompilerLowerLinuxScalar) true]
    [(CompilerLowerWindowsScalar) true]
    [(CompilerLowerAvx2) true]
    [(CompilerLowerLinuxAvx2) true]
    [(CompilerLowerWindowsAvx2) true]
    [(CompilerLowerAvx512) true]
    [(CompilerLowerLinuxAvx512) true]
    [(CompilerLowerWindowsAvx512) true]
    [(CompilerLowerInlineAggregates) true]
    [_ false]))

(define (lower-mode-linux-c-abi? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerLinuxScalar) true]
    [(CompilerLowerLinuxAvx2) true]
    [(CompilerLowerLinuxAvx512) true]
    [_ false]))

(define (lower-mode-windows-c-abi? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerWindowsScalar) true]
    [(CompilerLowerWindowsAvx2) true]
    [(CompilerLowerWindowsAvx512) true]
    [_ false]))

(define (lower-mode-c-abi? [mode : CompilerLowerMode]) : bool
  (or (lower-mode-linux-c-abi? mode) (lower-mode-windows-c-abi? mode)))

(define (lower-type-i64? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.I64) true]
    [_ false]))

(define (lower-type-bool? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.Bool) true]
    [_ false]))

(define (lower-avx512-bool-lanes [mode : CompilerLowerMode]) : i64
  (if (lower-mode-avx512? mode)
    64
    0))

(define (lower-simd-lanes-for-elem [mode : CompilerLowerMode] [ty : AstType]) : i64
  (match mode
    [(CompilerLowerAvx2)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 4]
        [(AstType.U64) 4]
        [(AstType.F64) 4]
        [(AstType.F32) 8]
        [(AstType.I32) 8]
        [(AstType.U32) 8]
        [(AstType.I16) 16]
        [(AstType.U16) 16]
        [(AstType.I8) 32]
        [(AstType.U8) 32]
        [_ 0])]
    [(CompilerLowerLinuxAvx2)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 4]
        [(AstType.U64) 4]
        [(AstType.F64) 4]
        [(AstType.F32) 8]
        [(AstType.I32) 8]
        [(AstType.U32) 8]
        [(AstType.I16) 16]
        [(AstType.U16) 16]
        [(AstType.I8) 32]
        [(AstType.U8) 32]
        [_ 0])]
    [(CompilerLowerWindowsAvx2)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 4]
        [(AstType.U64) 4]
        [(AstType.F64) 4]
        [(AstType.F32) 8]
        [(AstType.I32) 8]
        [(AstType.U32) 8]
        [(AstType.I16) 16]
        [(AstType.U16) 16]
        [(AstType.I8) 32]
        [(AstType.U8) 32]
        [_ 0])]
    [(CompilerLowerAvx512)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 8]
        [(AstType.U64) 8]
        [(AstType.F64) 8]
        [(AstType.F32) 16]
        [(AstType.I32) 16]
        [(AstType.U32) 16]
        [(AstType.I16) 32]
        [(AstType.U16) 32]
        [(AstType.I8) 64]
        [(AstType.U8) 64]
        [_ 0])]
    [(CompilerLowerLinuxAvx512)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 8]
        [(AstType.U64) 8]
        [(AstType.F64) 8]
        [(AstType.F32) 16]
        [(AstType.I32) 16]
        [(AstType.U32) 16]
        [(AstType.I16) 32]
        [(AstType.U16) 32]
        [(AstType.I8) 64]
        [(AstType.U8) 64]
        [_ 0])]
    [(CompilerLowerWindowsAvx512)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 8]
        [(AstType.U64) 8]
        [(AstType.F64) 8]
        [(AstType.F32) 16]
        [(AstType.I32) 16]
        [(AstType.U32) 16]
        [(AstType.I16) 32]
        [(AstType.U16) 32]
        [(AstType.I8) 64]
        [(AstType.U8) 64]
        [_ 0])]
    [_ 0]))

(define (lower-expr-is-var? [expr : AstExpr] [name : String]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-expr-is-var? inner name))]
    [(AstExpr.Var found) (string.eq (intern-str found) name)]
    [_ false]))

(define (lower-dynamic-array-var
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : LowerMaybeArrayVar
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-dynamic-array-var env type-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-dynamic-array-var env type-env inner))]
    [(AstExpr.Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? var-id)
          (match (tc-lookup type-env (intern-str name))
            [(ResultTcType.Ok ty)
              (match (tc-type-strip-region ty)
                [(AstType.DynArray elem-ty)
                  (LowerSomeArrayVar
                    var-id
                    (tc-type-without-regions (ty-node-get elem-ty)))]
                [(AstType.Ref _ referent-ty)
                  (match (tc-type-strip-region (ty-node-get referent-ty))
                    [(AstType.DynArray elem-ty)
                      (LowerSomeArrayVar
                        var-id
                        (tc-type-without-regions (ty-node-get elem-ty)))]
                    [_ LowerNoArrayVar])]
                [(AstType.MutRef _ referent-ty)
                  (match (tc-type-strip-region (ty-node-get referent-ty))
                    [(AstType.DynArray elem-ty)
                      (LowerSomeArrayVar
                        var-id
                        (tc-type-without-regions (ty-node-get elem-ty)))]
                    [_ LowerNoArrayVar])]
                [_ LowerNoArrayVar])]
            [(ResultTcType.Err _) LowerNoArrayVar])
          LowerNoArrayVar))]
    [_ LowerNoArrayVar]))

(define (lower-array-ref-var-for-index
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [index : String]) : LowerMaybeArrayVar
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-array-ref-var-for-index env type-env inner index))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        (if (lower-expr-is-var? idx index)
          (lower-dynamic-array-var env type-env arr)
          LowerNoArrayVar))]
    [_ LowerNoArrayVar]))

(define (lower-simple-spmd-broadcast-lane
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : LowerMaybeIrValue
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-simple-spmd-broadcast-lane env type-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-simple-spmd-broadcast-lane env type-env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-simple-spmd-broadcast-lane env type-env inner))]
    [(AstExpr.Literal (AstLiteral.Int n _))
      (LowerSomeIrValue (CompilerIrValue.I64 n))]
    [(AstExpr.Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? var-id)
          (match (tc-lookup type-env (intern-str name))
            [(ResultTcType.Ok ty)
              (if (tc-type-eq (tc-type-without-regions ty) (AstType.I64))
                (LowerSomeIrValue (CompilerIrValue.Var var-id))
                LowerNoIrValue)]
            [(ResultTcType.Err _) LowerNoIrValue])
          LowerNoIrValue))]
    [_ LowerNoIrValue]))

(define (lower-array-var-set-empty) : LowerArrayVarSet
  (LowerArrayVarSet (make-array i64 0) (make-array i64 0) 0))

(define (lower-array-var-set-add
  [set : LowerArrayVarSet]
  [var : i64]
  [offset : i64]) : LowerArrayVarSet
  (let
    [vars : (Array i64) (struct-get set vars)]
    [offsets : (Array i64) (struct-get set offsets)]
    [count : i64 (struct-get set count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (if (= (array-ref vars index) var)
          (begin
            (if (> offset (array-ref offsets index))
              (array-set! offsets index offset)
              unit)
            (set! found true))
          (set! index (+ index 1))))
      (if found
        (LowerArrayVarSet vars offsets count)
        (begin
          (array-push! vars var)
          (array-push! offsets offset)
          (LowerArrayVarSet vars offsets (+ count 1)))))))

(define (lower-array-var-set-merge
  [left : LowerArrayVarSet]
  [right : LowerArrayVarSet]) : LowerArrayVarSet
  (let
    [vars : (Array i64) (struct-get right vars)]
    [offsets : (Array i64) (struct-get right offsets)]
    [count : i64 (struct-get right count)]
    [index : i64 0]
    [out : LowerArrayVarSet left]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (lower-array-var-set-add
              out
              (array-ref vars index)
              (array-ref offsets index)))
          (set! index (+ index 1))))
      out)))

(define (lower-array-var-set-max-offset [set : LowerArrayVarSet]) : i64
  (let
    [offsets : (Array i64) (struct-get set offsets)]
    [count : i64 (struct-get set count)]
    [index : i64 0]
    [max-offset : i64 0]
    (begin
      (while (< index count)
        (let
          [offset : i64 (array-ref offsets index)]
          (begin
            (if (> offset max-offset)
              (set! max-offset offset)
              unit)
            (set! index (+ index 1)))))
      max-offset)))

(define (compiler-lower-array-var-set-ok?) : bool
  (let
    [left : LowerArrayVarSet
      (lower-array-var-set-add
        (lower-array-var-set-add
          (lower-array-var-set-add (lower-array-var-set-empty) 10 1)
          20
          2)
        10
        4)]
    [right : LowerArrayVarSet
      (lower-array-var-set-add
        (lower-array-var-set-add (lower-array-var-set-empty) 30 3)
        20
        1)]
    [merged : LowerArrayVarSet (lower-array-var-set-merge left right)]
    [vars : (Array i64) (struct-get merged vars)]
    [offsets : (Array i64) (struct-get merged offsets)]
    (and
      (= (struct-get merged count) 3)
      (= (array-length vars) 3)
      (= (array-length offsets) 3)
      (= (array-ref vars 0) 10)
      (= (array-ref offsets 0) 4)
      (= (array-ref vars 1) 20)
      (= (array-ref offsets 1) 2)
      (= (array-ref vars 2) 30)
      (= (array-ref offsets 2) 3)
      (= (lower-array-var-set-max-offset merged) 4))))

(define (lower-masked-vector-index-literal-offset [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-index-literal-offset inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-index-literal-offset inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-index-literal-offset inner))]
    [(AstExpr.Literal (AstLiteral.Int n _))
      (if (>= n 0)
        n
        -1)]
    [_ -1]))

(define (lower-masked-vector-positive-power-two-literal [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-positive-power-two-literal inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-positive-power-two-literal inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-positive-power-two-literal inner))]
    [(AstExpr.Literal (AstLiteral.Int n _))
      (if (> n 0)
        (if (= (bit-and n (- n 1)) 0)
          n
          -1)
        -1)]
    [_ -1]))

(define (lower-masked-vector-index-offset [index : String] [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-index-offset index inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-index-offset index inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-index-offset index inner))]
    [(AstExpr.Var name)
      (if (string.eq (intern-str name) index)
        0
        -1)]
    [(AstExpr.Binary op left-box right-box)
      (match op
        [(AstBinOp.Add)
          (let
            [left : AstExpr (ast-node-get left-box)]
            [right : AstExpr (ast-node-get right-box)]
            [left-offset : i64 (lower-masked-vector-index-offset index left)]
            [right-offset : i64 (lower-masked-vector-index-offset index right)]
            (if (= left-offset 0)
              (lower-masked-vector-index-literal-offset right)
              (if (= right-offset 0)
                (lower-masked-vector-index-literal-offset left)
                -1)))]
        [_ -1])]
    [_ -1]))

(define (lower-masked-vector-lanes-merge [left : i64] [right : i64]) : i64
  (cond
    [(< left 0) -1]
    [(< right 0) -1]
    [(= left 0) right]
    [(= right 0) left]
    [(= left right) left]
    [else -1]))

(define (lower-masked-vector-binop-supported? [op : AstBinOp]) : bool
  (match op
    [(AstBinOp.Add) true]
    [(AstBinOp.Mod) true]
    [(AstBinOp.Eq) true]
    [(AstBinOp.Ne) true]
    [(AstBinOp.Lt) true]
    [(AstBinOp.Le) true]
    [(AstBinOp.Gt) true]
    [(AstBinOp.Ge) true]
    [(AstBinOp.And) true]
    [(AstBinOp.Or) true]
    [_ false]))

(define (lower-masked-vector-unop-supported? [op : AstUnOp]) : bool
  (match op
    [(AstUnOp.Not) true]
    [_ false]))

(define (lower-masked-vector-empty-lane-locals) : hashmap.StringI64Map
  (hashmap.string-i64-map-with-capacity 16))

(define (lower-masked-vector-expr-list-lanes-with-locals
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [exprs : AstExprList]) : i64
  (match exprs
    [(AstExprList.Nil) 0]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            mode
            env
            type-env
            index
            lane-locals
            expr)
          (lower-masked-vector-expr-list-lanes-with-locals
            mode
            env
            type-env
            index
            lane-locals
            rest)))]))

(define (lower-masked-vector-let-bindings-locals
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [bindings : AstLetBindingList]) : hashmap.StringI64Map
  (match bindings
    [(AstLetBindingList.Nil) lane-locals]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [init-lanes : i64
                (lower-masked-vector-expr-lanes-with-locals
                  mode
                  env
                  type-env
                  index
                  lane-locals
                  init)]
              [next-locals : hashmap.StringI64Map
                (if (> init-lanes 0)
                  (hashmap.string-i64-map-put
                    lane-locals
                    (intern-str name)
                    init-lanes)
                  lane-locals)]
              (lower-masked-vector-let-bindings-locals
                mode
                env
                type-env
                index
                next-locals
                rest))]))]))

(define (lower-masked-vector-let-bindings-lanes-with-locals
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [bindings : AstLetBindingList]) : i64
  (match bindings
    [(AstLetBindingList.Nil) 0]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [init-lanes : i64
                (lower-masked-vector-expr-lanes-with-locals
                  mode
                  env
                  type-env
                  index
                  lane-locals
                  init)]
              [next-locals : hashmap.StringI64Map
                (if (> init-lanes 0)
                  (hashmap.string-i64-map-put
                    lane-locals
                    (intern-str name)
                    init-lanes)
                  lane-locals)]
              (lower-masked-vector-lanes-merge
                init-lanes
                (lower-masked-vector-let-bindings-lanes-with-locals
                  mode
                  env
                  type-env
                  index
                  next-locals
                  rest)))]))]))

(define (lower-masked-vector-pattern-locals
  [pattern : AstPattern]
  [scrut-lanes : i64]
  [lane-locals : hashmap.StringI64Map]) : hashmap.StringI64Map
  (if (> scrut-lanes 0)
    (match pattern
      [(AstPattern.Var name _)
        (hashmap.string-i64-map-put lane-locals (intern-str name) scrut-lanes)]
      [(AstPattern.Tuple patterns-box)
        (lower-masked-vector-pattern-list-locals
          (box-get patterns-box)
          scrut-lanes
          lane-locals)]
      [(AstPattern.Binding name)
        (hashmap.string-i64-map-put lane-locals (intern-str name) scrut-lanes)]
      [(AstPattern.Variant _ patterns-box)
        (lower-masked-vector-pattern-list-locals
          (box-get patterns-box)
          scrut-lanes
          lane-locals)]
      [_ lane-locals])
    lane-locals))

(define (lower-masked-vector-pattern-list-locals
  [patterns : AstPatternList]
  [scrut-lanes : i64]
  [lane-locals : hashmap.StringI64Map]) : hashmap.StringI64Map
  (match patterns
    [(AstPatternList.Nil) lane-locals]
    [(AstPatternList.Cons pattern rest)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest : AstPatternList (box-get rest)]
        (lower-masked-vector-pattern-list-locals
          rest
          scrut-lanes
          (lower-masked-vector-pattern-locals pattern scrut-lanes lane-locals)))]))

(define (lower-masked-vector-match-arms-lanes-with-locals
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [scrut-lanes : i64]
  [arms : AstMatchArmList]) : i64
  (match arms
    [(AstMatchArmList.Nil) 0]
    [(AstMatchArmList.Cons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm.Arm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              [body-locals : hashmap.StringI64Map
                (lower-masked-vector-pattern-locals
                  pattern
                  scrut-lanes
                  lane-locals)]
              (lower-masked-vector-lanes-merge
                (lower-masked-vector-expr-lanes-with-locals
                  mode
                  env
                  type-env
                  index
                  body-locals
                  body)
                (lower-masked-vector-match-arms-lanes-with-locals
                  mode
                  env
                  type-env
                  index
                  lane-locals
                  scrut-lanes
                  rest)))]))]))

(define (lower-masked-vector-expr-lanes-with-locals
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-expr-lanes-with-locals
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-expr-lanes-with-locals
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-expr-lanes-with-locals
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Literal _) 0]
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (match (hashmap.string-i64-map-get lane-locals name-text)
          [(hashmap.StringI64MapFound lanes) lanes]
          [(hashmap.StringI64MapMissing)
            (if (string.eq name-text index)
              (lower-simd-lanes-for-elem mode (AstType.I64))
              0)]))]
    [(AstExpr.Unary op inner-box)
      (if (lower-masked-vector-unop-supported? op)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (lower-masked-vector-expr-lanes-with-locals
            mode
            env
            type-env
            index
            lane-locals
            inner))
        -1)]
    [(AstExpr.Binary op left-box right-box)
      (if (lower-masked-vector-binop-supported? op)
        (let
          [left : AstExpr (ast-node-get left-box)]
          [right : AstExpr (ast-node-get right-box)]
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              mode
              env
              type-env
              index
              lane-locals
              left)
            (lower-masked-vector-expr-lanes-with-locals
              mode
              env
              type-env
              index
              lane-locals
              right)))
        -1)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            [body-locals : hashmap.StringI64Map
              (lower-masked-vector-let-bindings-locals
                mode
                env
                type-env
                index
                lane-locals
                bindings)]
            (lower-masked-vector-lanes-merge
              (lower-masked-vector-let-bindings-lanes-with-locals
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (lower-masked-vector-expr-lanes-with-locals
                mode
                env
                type-env
                index
                body-locals
                body)))])]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            mode
            env
            type-env
            index
            lane-locals
            cond)
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              mode
              env
              type-env
              index
              lane-locals
              then-branch)
            (lower-masked-vector-expr-lanes-with-locals
              mode
              env
              type-env
              index
              lane-locals
              else-branch))))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            mode
            env
            type-env
            index
            lane-locals
            cond)
          (lower-masked-vector-expr-lanes-with-locals
            mode
            env
            type-env
            index
            lane-locals
            body)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            [scrut-lanes : i64
              (lower-masked-vector-expr-lanes-with-locals
                mode
                env
                type-env
                index
                lane-locals
                scrutinee)]
            (lower-masked-vector-lanes-merge
              scrut-lanes
              (lower-masked-vector-match-arms-lanes-with-locals
                mode
                env
                type-env
                index
                lane-locals
                scrut-lanes
                arms)))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-lanes-with-locals
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        (if (>= (lower-masked-vector-index-offset index idx) 0)
          (match (lower-dynamic-array-var env type-env arr)
            [(LowerSomeArrayVar _ elem-ty)
              (if (lower-type-bool? elem-ty)
                (lower-avx512-bool-lanes mode)
                (lower-simd-lanes-for-elem mode elem-ty))]
            [LowerNoArrayVar -1])
          -1))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        [value : AstExpr (ast-node-get value-box)]
        (if (>= (lower-masked-vector-index-offset index idx) 0)
          (match (lower-dynamic-array-var env type-env arr)
            [(LowerSomeArrayVar _ elem-ty)
              (if (lower-type-bool? elem-ty)
                (let
                  [value-lanes : i64
                    (lower-masked-vector-expr-lanes-with-locals
                      mode
                      env
                      type-env
                      index
                      lane-locals
                      value)]
                  (if (< value-lanes 0)
                    -1
                    (if (= value-lanes 0)
                      (lower-avx512-bool-lanes mode)
                      value-lanes)))
                (lower-masked-vector-lanes-merge
                  (lower-simd-lanes-for-elem mode elem-ty)
                  (lower-masked-vector-expr-lanes-with-locals
                    mode
                    env
                    type-env
                    index
                    lane-locals
                    value)))]
            [LowerNoArrayVar -1])
          -1))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            mode
            env
            type-env
            index
            lane-locals
            receiver)
          (lower-masked-vector-expr-lanes-with-locals
            mode
            env
            type-env
            index
            lane-locals
            value)))]
    [_ -1]))

(define (lower-masked-vector-expr-list-lanes
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : AstExprList]) : i64
  (lower-masked-vector-expr-list-lanes-with-locals
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    exprs))

(define (lower-masked-vector-let-bindings-lanes
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [bindings : AstLetBindingList]) : i64
  (lower-masked-vector-let-bindings-lanes-with-locals
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    bindings))

(define (lower-masked-vector-expr-lanes
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : i64
  (lower-masked-vector-expr-lanes-with-locals
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    expr))

(define (lower-masked-vector-body-has-varying-if-with-locals?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (if (>
          (lower-masked-vector-expr-lanes-with-locals
            mode
            env
            type-env
            index
            lane-locals
            cond)
          0)
          true
          (or
            (lower-masked-vector-body-has-varying-if-with-locals?
              mode
              env
              type-env
              index
              lane-locals
              then-branch)
            (lower-masked-vector-body-has-varying-if-with-locals?
              mode
              env
              type-env
              index
              lane-locals
              else-branch))))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            [body-locals : hashmap.StringI64Map
              (lower-masked-vector-let-bindings-locals
                mode
                env
                type-env
                index
                lane-locals
                bindings)]
            (or
              (lower-masked-vector-let-bindings-have-varying-if-with-locals?
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (lower-masked-vector-body-has-varying-if-with-locals?
                mode
                env
                type-env
                index
                body-locals
                body)))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-varying-if-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            left)
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            right)))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            arr)
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            idx)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            arr)
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            idx)
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            receiver)
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            value)))]
    [_ false]))

(define (lower-masked-vector-expr-list-has-varying-if-with-locals?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            expr)
          (lower-masked-vector-expr-list-has-varying-if-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            rest)))]))

(define (lower-masked-vector-let-bindings-have-varying-if-with-locals?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [init-lanes : i64
                (lower-masked-vector-expr-lanes-with-locals
                  mode
                  env
                  type-env
                  index
                  lane-locals
                  init)]
              [next-locals : hashmap.StringI64Map
                (if (> init-lanes 0)
                  (hashmap.string-i64-map-put
                    lane-locals
                    (intern-str name)
                    init-lanes)
                  lane-locals)]
              (or
                (lower-masked-vector-body-has-varying-if-with-locals?
                  mode
                  env
                  type-env
                  index
                  lane-locals
                  init)
                (lower-masked-vector-let-bindings-have-varying-if-with-locals?
                  mode
                  env
                  type-env
                  index
                  next-locals
                  rest)))]))]))

(define (lower-masked-vector-body-has-varying-if?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : bool
  (lower-masked-vector-body-has-varying-if-with-locals?
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    expr))

(define (lower-masked-vector-expr-list-has-varying-if?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : AstExprList]) : bool
  (lower-masked-vector-expr-list-has-varying-if-with-locals?
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    exprs))

(define (lower-masked-vector-let-bindings-have-varying-if?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [bindings : AstLetBindingList]) : bool
  (lower-masked-vector-let-bindings-have-varying-if-with-locals?
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    bindings))

(define (lower-masked-vector-body-has-varying-while-with-locals?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-masked-vector-body-has-varying-while-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        (ast-node-get inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-masked-vector-body-has-varying-while-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        (ast-node-get inner-box))]
    [(AstExpr.Cast inner-box _)
      (lower-masked-vector-body-has-varying-while-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        (ast-node-get inner-box))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (or
          (>
            (lower-masked-vector-expr-lanes-with-locals
              mode
              env
              type-env
              index
              lane-locals
              cond)
            0)
          (lower-masked-vector-body-has-varying-while-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            cond)
          (lower-masked-vector-body-has-varying-while-with-locals?
            mode
            env
            type-env
            index
            lane-locals
            body)))]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get cond-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get then-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get else-box)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            [body-locals : hashmap.StringI64Map
              (lower-masked-vector-let-bindings-locals
                mode
                env
                type-env
                index
                lane-locals
                bindings)]
            (or
              (lower-masked-vector-let-bindings-have-varying-while-with-locals?
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (lower-masked-vector-body-has-varying-while-with-locals?
                mode
                env
                type-env
                index
                body-locals
                body)))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-varying-while-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(AstExpr.Unary _ inner-box)
      (lower-masked-vector-body-has-varying-while-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        (ast-node-get inner-box))]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get left-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get right-box)))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get arr-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get idx-box)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get arr-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get idx-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get value-box)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get receiver-box))
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get value-box)))]
    [_ false]))

(define (lower-masked-vector-expr-list-has-varying-while-with-locals?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (or
        (lower-masked-vector-body-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get expr))
        (lower-masked-vector-expr-list-has-varying-while-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (box-get rest)))]))

(define (lower-masked-vector-let-bindings-have-varying-while-with-locals?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (match binding
        [(AstLetBinding.Binding name _ init-box)
          (let
            [init : AstExpr (ast-node-get init-box)]
            [init-lanes : i64
              (lower-masked-vector-expr-lanes-with-locals
                mode
                env
                type-env
                index
                lane-locals
                init)]
            [next-locals : hashmap.StringI64Map
              (if (> init-lanes 0)
                (hashmap.string-i64-map-put
                  lane-locals
                  (intern-str name)
                  init-lanes)
                lane-locals)]
            (or
              (lower-masked-vector-body-has-varying-while-with-locals?
                mode
                env
                type-env
                index
                lane-locals
                init)
              (lower-masked-vector-let-bindings-have-varying-while-with-locals?
                mode
                env
                type-env
                index
                next-locals
                (box-get rest))))])]))

