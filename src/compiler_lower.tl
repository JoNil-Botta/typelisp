(define (lower-test-instrs-u64-mov-count [instrs : CompilerIrInstrList]) : i64
  (match instrs
    [(CompilerIrInstrList.Nil) 0]
    [(CompilerIrInstrList.Cons instr rest)
      (+
        (lower-test-instr-u64-mov-count instr)
