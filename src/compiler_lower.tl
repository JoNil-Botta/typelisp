        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx left-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx right-box)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-masked-vector-let-bindings-have-varying-match-with-locals?
              ctx
              mode
              env
              type-env
              index
              lane-locals
              bindings)
            (lower-masked-vector-body-has-varying-match-with-locals?
              ctx
              mode
              env
              type-env
              index
              (lower-masked-vector-let-bindings-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (lower-context-expr-get ctx body-box)))])]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx cond-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx then-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx else-box)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (lower-context-expr-get ctx scrutinee-box)]
            [scrut-lanes : i64
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                scrutinee)]
            (or
              (> scrut-lanes 0)
              (lower-masked-vector-match-arms-have-varying-match-with-locals?
                ctx
                mode
                env
                type-env
                index
                lane-locals
                scrut-lanes
                arms)))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-varying-match-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (or
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx arr-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx idx-box)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (or
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx arr-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx idx-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx value-box)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (or
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx receiver-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx value-box)))]
    [_ false]))

(define (lower-masked-vector-expr-list-has-varying-match-with-locals?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : AstExprList]) : bool
  (lower-masked-vector-expr-list-has-varying-match-with-locals-at?
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-has-varying-match-with-locals-at?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : (& exprs AstExprList)]
  [expr-index : i64]) : bool
  (if (>= expr-index (struct-get exprs len))
    false
    (or
      (lower-masked-vector-body-has-varying-match-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx (ast-expr-list-get exprs expr-index 0)))
      (lower-masked-vector-expr-list-has-varying-match-with-locals-at?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        exprs
        (+ expr-index 1)))))

(define (lower-masked-vector-let-bindings-have-varying-match-with-locals?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : AstLetBindingList]) : bool
  (lower-masked-vector-let-bindings-have-varying-match-with-locals-at?
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-have-varying-match-with-locals-at?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding name _ init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          [init-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              init)]
          [next-locals : lower_i64_i64_map.Map
            (lower-masked-vector-lane-locals-bind-if-varying
              lane-locals
              name
              init-lanes)]
          (or
            (lower-masked-vector-body-has-varying-match-with-locals?
              ctx
              mode
              env
              type-env
              index
              lane-locals
              init)
            (lower-masked-vector-let-bindings-have-varying-match-with-locals-at?
              ctx
              mode
              env
              type-env
              index
              next-locals
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-match-arms-have-varying-match-with-locals?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [scrut-lanes : i64]
  [arms : AstMatchArmList]) : bool
  (lower-masked-vector-match-arms-have-varying-match-with-locals-at?
    ctx
    mode
    env
    type-env
    index
    lane-locals
    scrut-lanes
    (& arms)
    0))

(define (lower-masked-vector-match-arms-have-varying-match-with-locals-at?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [scrut-lanes : i64]
  [arms : (& arms AstMatchArmList)]
  [arm-index : i64]) : bool
  (if (>= arm-index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms arm-index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (or
          (lower-masked-vector-body-has-varying-match-with-locals?
            ctx
            mode
            env
            type-env
            index
            (lower-masked-vector-pattern-locals pattern scrut-lanes lane-locals)
            (lower-context-expr-get ctx body-box))
          (lower-masked-vector-match-arms-have-varying-match-with-locals-at?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            scrut-lanes
            arms
            (+ arm-index 1)))])))

(define (lower-masked-vector-body-has-varying-match?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : bool
  (lower-masked-vector-body-has-varying-match-with-locals?
    ctx
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    expr))

(define (lower-spmd-enum-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ false]))

(define (lower-masked-vector-array-ref-varying-enum?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [arr : AstExpr]
  [idx : AstExpr]) : bool
  (and
    (>= (lower-masked-vector-index-offset ctx index idx) 0)
    (match (lower-dynamic-array-var ctx env type-env arr)
      [(LowerMaybeArrayVar.Some _ elem-ty) (lower-spmd-enum-type? elem-ty)]
      [(LowerMaybeArrayVar.No) false])))

(define (lower-masked-vector-expr-varying-enum-with-locals?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [enum-locals : LowerIdSet]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-masked-vector-expr-varying-enum-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-masked-vector-expr-varying-enum-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Cast inner-box _)
      (lower-masked-vector-expr-varying-enum-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Var name) (lower-id-set-contains? enum-locals name)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (lower-masked-vector-array-ref-varying-enum?
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx arr-box)
        (lower-context-expr-get ctx idx-box))]
    [_ false]))

(define (lower-masked-vector-enum-let-locals
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [enum-locals : LowerIdSet]
  [bindings : AstLetBindingList]) : LowerIdSet
  (lower-masked-vector-enum-let-locals-at
    ctx
    env
    type-env
    index
    enum-locals
    (& bindings)
    0))

(define (lower-masked-vector-enum-let-locals-at
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [enum-locals : LowerIdSet]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : LowerIdSet
  (if (>= binding-index (ast-let-binding-list-len bindings))
    enum-locals
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding name _ init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          [next-locals : LowerIdSet
            (if (lower-masked-vector-expr-varying-enum-with-locals?
              ctx
              env
              type-env
              index
              enum-locals
              init)
              (lower-id-set-insert enum-locals name)
              enum-locals)]
          (lower-masked-vector-enum-let-locals-at
            ctx
            env
            type-env
            index
            next-locals
            bindings
            (+ binding-index 1)))])))

(define (lower-masked-vector-body-has-varying-enum-match-with-locals?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [enum-locals : LowerIdSet]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-masked-vector-body-has-varying-enum-match-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-masked-vector-body-has-varying-enum-match-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Cast inner-box _)
      (lower-masked-vector-body-has-varying-enum-match-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Unary _ inner-box)
      (lower-masked-vector-body-has-varying-enum-match-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx left-box))
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx right-box)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-masked-vector-let-bindings-have-varying-enum-match-with-locals?
              ctx
              env
              type-env
              index
              enum-locals
              bindings)
            (lower-masked-vector-body-has-varying-enum-match-with-locals?
              ctx
              env
              type-env
              index
              (lower-masked-vector-enum-let-locals
                ctx
                env
                type-env
                index
                enum-locals
                bindings)
              (lower-context-expr-get ctx body-box)))])]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx cond-box))
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx then-box))
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx else-box)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (or
              (lower-masked-vector-expr-varying-enum-with-locals?
                ctx
                env
                type-env
                index
                enum-locals
                scrutinee)
              (lower-masked-vector-body-has-varying-enum-match-with-locals?
                ctx
                env
                type-env
                index
                enum-locals
                scrutinee)
              (lower-masked-vector-match-arms-have-varying-enum-match-with-locals?
                ctx
                env
                type-env
                index
                enum-locals
                arms)))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-varying-enum-match-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (or
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx arr-box))
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx idx-box)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (or
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx arr-box))
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx idx-box))
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx value-box)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (or
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx receiver-box))
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx value-box)))]
    [_ false]))

(define (lower-masked-vector-expr-list-has-varying-enum-match-with-locals?
