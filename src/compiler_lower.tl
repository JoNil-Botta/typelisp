(cfg
  compile-profile
  (define (compiler-lower-profile-name-finish [state : CompilerLowerState]) : unit
    (let
      [address : u64 (compiler-lower-profile-intern-metrics-address state)]
      [ids : lower_i64_i64_map.Map
        (compiler-lower-state-read
          state
          lower_i64_i64_map.Map
          alias-overlay-ids)]
      (compiler-lower-name-env-profile-emit! address)
      (compiler-lower-name-storage-profile-emit! address)
      (counters.profile-counter-live-row!
        "lower.alias_overlay.capacity_slots"
        (lower_i64_i64_map.capacity (& ids)))
      (compiler-lower-name-cache-profile-emit! address)
      (compiler-lower-module-view-profile-emit! address))))

(cfg
  (any compile-profile test)
  (define (compiler-lower-profile-name-cache-lookup
    [metrics : profile_state.CompilerProfileMetrics]
    [hit : bool]) : unit
    (profile_state.compiler-profile-metrics-add!
      (profile_state.compiler-profile-state-shared-view metrics)
      compiler-lower-profile-name-cache-lookups-metric
      1)
    (if hit
      (profile_state.compiler-profile-metrics-add!
        metrics
        compiler-lower-profile-name-cache-local-hits-metric
        1)
      (profile_state.compiler-profile-metrics-add!
        metrics
        compiler-lower-profile-name-cache-local-misses-metric
        1))))

(cfg
  compile-profile
  (define (compiler-lower-profile-pools
    [point : String]
    [pools : ast.AstNodePoolContext]) : unit
    (compiler-lower-profile-counter
      (str_cat.str-cat "ast_expr_pool." (lower-global-shared-view point) ".len")
      (ast.ast-node-pool-context-expr-len pools))
    (compiler-lower-profile-counter
      (str_cat.str-cat
        "ast_expr_pool."
        (lower-global-shared-view point)
        ".capacity")
      (ast.ast-node-pool-context-expr-capacity pools))
    (compiler-lower-profile-counter
      (str_cat.str-cat
        "ast_expr_pool."
        (lower-global-shared-view point)
        ".segments")
      (ast.ast-node-pool-context-expr-segment-count pools))
    (compiler-lower-profile-counter
      (str_cat.str-cat
        "ast_expr_pool."
        (lower-global-shared-view point)
        ".segment_bytes")
      (ast.ast-node-pool-context-expr-segment-bytes pools))
    (compiler-lower-profile-counter
      (str_cat.str-cat "ast_type_pool." (lower-global-shared-view point) ".len")
      (ast.ast-node-pool-context-type-len pools))
    (compiler-lower-profile-counter
      (str_cat.str-cat
        "ast_type_pool."
        (lower-global-shared-view point)
        ".capacity")
      (ast.ast-node-pool-context-type-capacity pools))
    (compiler-lower-profile-counter
      (str_cat.str-cat
        "ast_type_pool."
        (lower-global-shared-view point)
        ".segments")
      (ast.ast-node-pool-context-type-segment-count pools))
    (compiler-lower-profile-counter
      (str_cat.str-cat "ast_type_pool." point ".segment_bytes")
      (ast.ast-node-pool-context-type-segment-bytes pools))))

(cfg
  compile-profile
  (define (compiler-lower-profile-decl-list-count
    [decls : (& decls ast.AstDeclList)]) : i64
    (ast.ast-decl-list-len decls)))

(cfg
  compile-profile
  (define (compiler-lower-profile-program-counts
    [point : String]
    [program : ast.AstProgram]) : unit
    (match program
      [(Program decls-box)
        (let
          [decls : ast.AstDeclList (deref decls-box)]
          (compiler-lower-profile-counter
            (str_cat.str-cat
              "checked_program."
              (lower-global-shared-view point)
              ".decls")
            (compiler-lower-profile-decl-list-count decls))
          (compiler-lower-profile-counter
            (str_cat.str-cat "checked_program." point ".functions")
            (lower-function-decl-count decls)))])))

(cfg
  compile-profile
  (define (compiler-lower-profile-ir-shape
    [point : String]
    [program : ir.CompilerIrProgram]) : unit
    (match program
      [(Program _ functions _)
        (compiler-lower-profile-counter
          (str_cat.str-cat "ir." (lower-global-shared-view point) ".functions")
          (ir.compiler-ir-function-seq-count functions))
        (compiler-lower-profile-counter
          (str_cat.str-cat "ir." (lower-global-shared-view point) ".blocks")
          (ir.compiler-ir-function-seq-block-count functions))
        (compiler-lower-profile-counter
          (str_cat.str-cat "ir." point ".instructions")
          (ir.compiler-ir-function-seq-instruction-count functions))])))

(cfg
  compile-profile
  (define (compiler-lower-profile-ir-arena [point : String]) : unit
    (compiler-lower-profile-counter
      (str_cat.str-cat "ir_arena." point ".active")
      (if (= lower-ir-arena 0)
        0
        1))))

(define (lower-expr-id-span
  [pools : (& pools ast.AstNodePoolContext)]
  [expr-id : i64]) : ir.CompilerMaybeSourceSpan
  (lower-ast-expr-span pools (ast.ast-node-pool-context-expr-get pools expr-id)))

;; List fold for the first source span: keep a span found in an earlier child,
;; otherwise ask the next child.
(defmacro (lower-first-span [found : Expr] [next : Expr]) : Expr
  `(match ,found
    [(ir.CompilerMaybeSourceSpan.Some span)
      (ir.CompilerMaybeSourceSpan.Some span)]
    [(ir.CompilerMaybeSourceSpan.No) ,next]))

(define (lower-ast-expr-direct-span [expr : ast.AstExpr]) : ir.CompilerMaybeSourceSpan
  (match expr
    [(Spanned _ span) (Some span)]
    [_ (No)]))

;; Best-available diagnostic source span for an expression. Prefer the parser's
;; outer `AstExpr.Spanned` wrapper, then fall back to the first source-carrying
;; child of common transformed/generated expression nodes.
(define (lower-ast-expr-span
  [pools : (& pools ast.AstNodePoolContext)]
  [expr : ast.AstExpr]) : ir.CompilerMaybeSourceSpan
  (match (lower-global-shared-view expr)
    [(Spanned _ span) (Some span)]
    [(MacroExpansion _ _ _) (No)]
    [(ForOwnedState _) (No)]
    [(ForOwnedStep _) (No)]
    [_
      (ast.ast-expr-list-fold
        (ast.ast-expr-child-ids expr)
        lower-first-span
        (ir.CompilerMaybeSourceSpan.No)
        lower-expr-id-span
        pools)]))

(define (lower-diagnostic-at-expr-with-pools
  [pools : (& pools ast.AstNodePoolContext)]
  [expr : ast.AstExpr]
  [message : String]) : cdiag.CompilerDiagnostic
  (match (lower-ast-expr-span pools expr)
    [(Some span) (cdiag.compiler-diagnostic-from-ast-span "" span message)]
    [(No) (lower-diagnostic message)]))

;; Keep the context owner explicit at diagnostic call sites without repeating
;; its pool projection hundreds of times in this already-large lowering unit.
;; This wrapper is cold on successful compilation; the recursive span walk
;; below it remains directly bound to the context's pool capability.
(define (lower-diagnostic-at-expr
  [ctx : (& ctx tc_core.TcContext)]
  [expr : ast.AstExpr]
  [message : String]) : cdiag.CompilerDiagnostic
  (let
    [pools : ast.AstNodePoolContext
      (tc_core.tc-context-pools
        (owned_view.compiler-owned-reference-shared-view ctx))]
    (lower-diagnostic-at-expr-with-pools (& pools) expr message)))

(define (lower-diagnostic-with-fallback-path
  [diag : cdiag.CompilerDiagnostic]
  [path : String]) : cdiag.CompilerDiagnostic
  (cdiag.compiler-diagnostic-with-fallback-path diag path))

(define (lower-resetting-entry-in-live-session?) : bool
  (load.compiler-load-active-session-live?))

(define (lower-resetting-entry-live-session-error
  [entry : String]
  [path : String]) : ResultCompilerLower
  (Err
    (box
      (lower-diagnostic-with-fallback-path
        (lower-diagnostic
          (str_cat.str-cat
            entry
            ": standalone resetting compiler entry cannot run inside an active compiler load session"))
        path))))

(define (lower-reference-support-message) : String
  "lower: reference-typed programs require borrow/reference lowering support")

(define (lower-bytes-view-from-parts-name? [name : String]) : bool
  (let
    [base : String
      (if (tc_core.tc-name-qualified? name)
        (tc_core.tc-qualified-name-base name)
        name)]
    (or
      (string.eq base "tl_bytes_view_from_str_parts")
      (string.eq base "tl_bytes_view_from_buf_parts")
      (string.eq base "tl_bytes_mut_view_from_buf_parts")
      (string.eq base "tl_bytes_view_from_bytes_parts")
      (string.eq base "tl_bytes_mut_view_from_bytes_parts"))))

(define (lower-atomic-buffer-extern-name? [name : String]) : bool
  (let
    [base : String
      (if (tc_core.tc-name-qualified? name)
        (tc_core.tc-qualified-name-base name)
        name)]
    (or
      (string.eq base "atomic-i64-load")
      (string.eq base "atomic-i64-store!")
      (string.eq base "atomic-i64-add!")
      (string.eq base "atomic-i64-fetch-add!")
      (string.eq base "atomic-i32-load")
      (string.eq base "atomic-i32-store!")
      (string.eq base "atomic-i32-add!")
      (string.eq base "atomic-i32-fetch-add!"))))

(define (lower-supported-reference-extern?
  [ctx : tc_core.TcContext]
  [name : i64]
  [ty : ast.AstType]) : bool
  (let
    [_ : tc_core.TcContext ctx]
    [_ty : ast.AstType ty]
    (or
      (cbi.compiler-builtin-backend-tl-str-view-id? name)
      (string.eq (tc_core.tc-env-key-name-text name) "tl_str_view")
      (lower-bytes-view-from-parts-name? (tc_core.tc-env-key-name-text name))
      (lower-atomic-buffer-extern-name? (tc_core.tc-env-key-name-text name)))))

(define (lower-name-env-lookup-symbol-id
  [names : LowerNameEnv]
  [source-id : i64]
  [fallback : i64]) : i64
  (if (< source-id 0)
    fallback
    (match names
      [(Nil) fallback]
      [(Inline bind-id _ symbol-id)
        (if (= bind-id source-id)
          symbol-id
          fallback)]
      [(Dense store head _)
        (let
          [cursor : i64 head]
          (while (>= cursor 0)
            (let
              [binding : LowerNameBinding
                (lower-name-store-binding-at (& (__tl-box-place store)) cursor)]
              (if (= binding.source-id source-id)
                (return binding.symbol-id)
                (set! cursor binding.parent))))
          fallback)])))

(define (lower-name-env-lookup-logical-id
  [names : LowerNameEnv]
  [source-id : i64]
  [fallback : i64]) : i64
  (if (< source-id 0)
    fallback
    (match names
      [(Nil) fallback]
      [(Inline bind-id logical-id _)
        (if (= bind-id source-id)
          logical-id
          fallback)]
      [(Dense store head _)
        (let
          [cursor : i64 head]
          (while (>= cursor 0)
            (let
              [binding : LowerNameBinding
                (lower-name-store-binding-at (& (__tl-box-place store)) cursor)]
              (if (= binding.source-id source-id)
                (return binding.logical-id)
                (set! cursor binding.parent))))
          fallback)])))

(define (lower-name-env-lookup-with-id [names : LowerNameEnv] [source-id : i64]) : tc_core.TcMaybeString
  (let
    [symbol-id : i64 (lower-name-env-lookup-symbol-id names source-id -1)]
    (if (>= symbol-id 0)
      (Some (ir.compiler-ir-symbol-text symbol-id))
      (No))))

(define (lower-name-env-count [names : (& names LowerNameEnv)]) : i64
  (let
    [names : LowerNameEnv
      (owned_view.compiler-owned-reference-shared-view names)]
    (match names
      [(Nil) 0]
      [(Inline _ _ _) 1]
      [(Dense _ _ count) count])))

(define (lower-name-env-copy-chain-into!
  [names : LowerNameEnv]
  [target : (&mut target LowerNameStore)]
  [start : i64]) : unit
  (match names
    [(Nil) unit]
    [(Inline source-id logical-id symbol-id)
      (lower-name-store-write-index!
        target
        start
        (LowerNameBinding source-id logical-id symbol-id (- start 1)))]
    [(Dense store head count)
      (let
        [cursor : i64 head]
        [write : i64 (+ start (- count 1))]
        (while (>= cursor 0)
          (let
            [binding : LowerNameBinding
              (lower-name-store-binding-at (& (__tl-box-place store)) cursor)]
            (lower-name-store-write-index!
              target
              write
              (LowerNameBinding
                binding.source-id
                binding.logical-id
                binding.symbol-id
                (- write 1)))
            (set! cursor binding.parent)
            (set! write (- write 1)))))]))

(define (lower-name-env-materialize-two
  [left : LowerNameEnv]
  [right : LowerNameEnv]) : LowerNameEnv
  (let
    [left-count : i64 (lower-name-env-count left)]
    [right-count : i64 (lower-name-env-count right)]
    [count : i64 (+ left-count right-count)]
    (if (< count 1)
      Nil
      (let
        [last-index : i64
          (if (< count 1)
            0
            (- count 1))]
        [store : (Box LowerNameStore) (box (lower-name-store-new))]
        [_ensure : unit
          (lower-name-store-ensure-index!
            (&mut (__tl-box-place store))
            last-index)]
        [_copy-right : unit
          (lower-name-env-copy-chain-into!
            right
            (&mut (__tl-box-place store))
            0)]
        [_copy-left : unit
          (lower-name-env-copy-chain-into!
            left
            (&mut (__tl-box-place store))
            right-count)]
        (__tl-project-set-field (__tl-box-place store) len count)
        (Dense store (- count 1) count)))))

(define (lower-name-env-rebuild-over
  [left : LowerNameEnv]
  [right : LowerNameEnv]) : LowerNameEnv
  (let
    [count : i64 (lower-name-env-count left)]
    [cur : LowerNameEnv left]
    [bindings : (__tl_dyn-array LowerNameFlatBinding)
      (__tl_make-array LowerNameFlatBinding count)]
    [index : i64 0]
    [out : LowerNameEnv right]
    (while (match (lower-global-shared-view cur)
      [(Nil) false]
      [_ true])
      (match (lower-name-env-view (lower-global-shared-view cur))
        [(Nil) unit]
        [(Bind source-id logical-id symbol-id rest)
          (set!
            (array-ref bindings index)
            (LowerNameFlatBinding source-id logical-id symbol-id))
          (set! index (+ index 1))
          (set! cur rest)]))
    (set! index (- count 1))
    (while (>= index 0)
      (let
        [binding : LowerNameFlatBinding (array-ref bindings index)]
        (set!
          out
          (lower-name-env-bind-ids-raw
            binding.source-id
            binding.logical-id
            binding.symbol-id
            out))
        (set! index (- index 1))))
    out))

(define (lower-name-env-append [left : LowerNameEnv] [right : LowerNameEnv]) : LowerNameEnv
  (match (lower-global-shared-view left)
    [(Nil) right]
    [_
      (match (lower-global-shared-view right)
        [(Nil) (lower-name-env-materialize-two left Nil)]
        [_ (lower-name-env-rebuild-over left right)])]))

;; Profile builds route name-environment operations through the exact lowering
;; job owner. Ordinary builds expand the macros below to the original raw calls,
;; so they neither pass an extra hot-path argument nor allocate metrics storage.
(cfg
  (any compile-profile test)
  (define (lower-name-env-bind-ids-profile-storage-note!
    [metrics : profile_state.CompilerProfileMetrics]
    [rest : LowerNameEnv]) : unit
    (match rest
      [(Nil) unit]
      [(Inline _ _ _)
        (profile_state.compiler-profile-metrics-add!
          metrics
          compiler-lower-profile-name-env-stores-metric
          1)]
      [(Dense store _ _)
        (let
          [storage : LowerNameStore (deref store)]
          (when
            (>= storage.len (* storage.segment-count 16))
            (profile_state.compiler-profile-metrics-add!
              metrics
              compiler-lower-profile-name-env-store-grows-metric
              1)))])))

(cfg
  (any compile-profile test)
  (define (lower-name-env-bind-ids-profile-storage
    [metrics : profile_state.CompilerProfileMetrics]
    [source-id : i64]
    [logical-id : i64]
    [symbol-id : i64]
    [rest : LowerNameEnv]) : LowerNameEnv
    (lower-name-env-bind-ids-profile-storage-note!
      metrics
      (lower-global-shared-view rest))
    (lower-name-env-bind-ids-raw source-id logical-id symbol-id rest)))

(cfg
  (any compile-profile test)
  (define (lower-name-env-bind-ids-profile
    [state : CompilerLowerState]
    [source-id : i64]
    [logical-id : i64]
    [symbol-id : i64]
    [rest : LowerNameEnv]) : LowerNameEnv
    (let
      [metrics : profile_state.CompilerProfileMetrics
        (compiler-lower-profile-metrics-view state)]
      (profile_state.compiler-profile-metrics-add!
        (profile_state.compiler-profile-state-shared-view metrics)
        compiler-lower-profile-name-env-binds-metric
        1)
      (lower-name-env-bind-ids-profile-storage
        metrics
        source-id
        logical-id
        symbol-id
        rest))))

(cfg
  (any compile-profile test)
  (define (lower-name-env-lookup-symbol-id-profile
    [state : CompilerLowerState]
    [names : LowerNameEnv]
    [source-id : i64]
    [fallback : i64]) : i64
    (let
      [metrics : profile_state.CompilerProfileMetrics
        (compiler-lower-profile-metrics-view state)]
      (profile_state.compiler-profile-metrics-add!
        (profile_state.compiler-profile-state-shared-view metrics)
        compiler-lower-profile-name-env-lookups-metric
        1)
      (if (< source-id 0)
        fallback
        (match names
          [(Nil) fallback]
          [(Inline bind-id _ symbol-id)
            (profile_state.compiler-profile-metrics-add!
              metrics
              compiler-lower-profile-name-env-lookup-steps-metric
              1)
            (if (= bind-id source-id)
              symbol-id
              fallback)]
          [(Dense store head _)
            (let
              [cursor : i64 head]
              [storage : LowerNameStore (deref store)]
              (while (>= cursor 0)
                (let
                  [binding : LowerNameBinding
                    (lower-name-store-binding-at (& storage) cursor)]
                  (profile_state.compiler-profile-metrics-add!
                    (profile_state.compiler-profile-state-shared-view metrics)
                    compiler-lower-profile-name-env-lookup-steps-metric
                    1)
                  (if (= binding.source-id source-id)
                    (return binding.symbol-id)
                    (set! cursor binding.parent))))
              fallback)])))))

(cfg
  (any compile-profile test)
  (define (lower-name-env-lookup-with-id-profile
    [state : CompilerLowerState]
    [names : LowerNameEnv]
    [source-id : i64]) : tc_core.TcMaybeString
    (let
      [symbol-id : i64
        (lower-name-env-lookup-symbol-id-profile state names source-id -1)]
      (if (>= symbol-id 0)
        (Some (ir.compiler-ir-symbol-text symbol-id))
        (No)))))

(cfg
  (any compile-profile test)
  (define (lower-name-env-materialize-two-profile
    [state : CompilerLowerState]
    [left : LowerNameEnv]
    [right : LowerNameEnv]) : LowerNameEnv
    (let
      [count : i64 (+ (lower-name-env-count left) (lower-name-env-count right))]
      [metrics : profile_state.CompilerProfileMetrics
        (compiler-lower-profile-metrics-view state)]
      (when
        (> count 0)
        (begin
          (profile_state.compiler-profile-metrics-add!
            (profile_state.compiler-profile-state-shared-view metrics)
            compiler-lower-profile-name-env-materializations-metric
            1)
          (profile_state.compiler-profile-metrics-add!
            (profile_state.compiler-profile-state-shared-view metrics)
            compiler-lower-profile-name-env-materialized-entries-metric
            count)
          (profile_state.compiler-profile-metrics-add!
            (profile_state.compiler-profile-state-shared-view metrics)
            compiler-lower-profile-name-env-stores-metric
            1)
          (profile_state.compiler-profile-metrics-add!
            metrics
            compiler-lower-profile-name-env-store-grows-metric
            (/ (- count 1) 16))))
      (lower-name-env-materialize-two left right))))

(cfg
  (any compile-profile test)
  (define (lower-name-env-rebuild-over-profile
    [state : CompilerLowerState]
    [left : LowerNameEnv]
    [right : LowerNameEnv]) : LowerNameEnv
    (let
      [append-count : i64 (lower-name-env-count left)]
      [metrics : profile_state.CompilerProfileMetrics
        (compiler-lower-profile-metrics-view state)]
      (match (lower-global-shared-view right)
        [(Nil) unit]
        [(Inline _ _ _)
          (profile_state.compiler-profile-metrics-add!
            (profile_state.compiler-profile-state-shared-view metrics)
            compiler-lower-profile-name-env-stores-metric
            1)
          (profile_state.compiler-profile-metrics-add!
            metrics
            compiler-lower-profile-name-env-store-grows-metric
            (/ append-count 16))]
        [(Dense store _ _)
          (let
            [storage : LowerNameStore (deref store)]
            [needed : i64 (+ storage.len append-count)]
            [needed-segments : i64
              (if (< needed 1)
                0
                (+ (/ (- needed 1) 16) 1))]
            (when
              (> needed-segments storage.segment-count)
              (profile_state.compiler-profile-metrics-add!
                metrics
                compiler-lower-profile-name-env-store-grows-metric
                (- needed-segments storage.segment-count))))])
      (lower-name-env-rebuild-over left right))))

(cfg
  (any compile-profile test)
  (define (lower-name-env-append-profile
    [state : CompilerLowerState]
    [left : LowerNameEnv]
    [right : LowerNameEnv]) : LowerNameEnv
    (match (lower-global-shared-view left)
      [(Nil) right]
      [_
        (match (lower-global-shared-view right)
          [(Nil) (lower-name-env-materialize-two-profile state left Nil)]
          [_ (lower-name-env-rebuild-over-profile state left right)])])))

(defmacro (lower-name-env-lookup-symbol-id-owned
  [_state : Expr]
  [names : Expr]
  [source-id : Expr]
  [fallback : Expr]) : Expr
  (cfg
    (any compile-profile test)
    `(lower-name-env-lookup-symbol-id-profile
      ,_state
      ,names
      ,source-id
      ,fallback)
    `(lower-name-env-lookup-symbol-id ,names ,source-id ,fallback)))

(defmacro (lower-name-env-lookup-with-id-owned
  [_state : Expr]
  [names : Expr]
  [source-id : Expr]) : Expr
  (cfg
    (any compile-profile test)
    `(lower-name-env-lookup-with-id-profile ,_state ,names ,source-id)
    `(lower-name-env-lookup-with-id ,names ,source-id)))

(defmacro (lower-name-env-append-owned
  [_state : Expr]
  [left : Expr]
  [right : Expr]) : Expr
  (cfg
    (any compile-profile test)
    `(lower-name-env-append-profile ,_state ,left ,right)
    `(lower-name-env-append ,left ,right)))

(cfg
  (any compile-profile test)
  (define (lower-name-env-copy-active-profile
    [state : CompilerLowerState]
    [names : LowerNameEnv]) : LowerNameEnv
    (match (lower-global-shared-view names)
      [(Nil) Nil]
      [(Inline source-id logical-id symbol-id)
        (Inline source-id logical-id symbol-id)]
      [_ (lower-name-env-materialize-two-profile state names Nil)])))

(cfg
  (any compile-profile test)
  (define (lower-name-env-copy-into-pools-profile
    [state : CompilerLowerState]
    [names : LowerNameEnv]
    [pools : ast.AstNodePoolContext]) : LowerNameEnv
    (let
      [base-arena : arena.Arena
        (arena.Arena (ast.ast-node-pool-context-base-arena pools))]
      (in-arena base-arena (lower-name-env-copy-active-profile state names)))))

(defmacro (lower-name-env-copy-into-pools-owned
  [_state : Expr]
  [names : Expr]
  [pools : Expr]) : Expr
  (cfg
    (any compile-profile test)
    `(lower-name-env-copy-into-pools-profile ,_state ,names ,pools)
    `(lower-name-env-copy-into-pools ,names ,pools)))

;; The generated hashmap grows at three-quarter occupancy. One-and-a-half
;; slots per potential entry leaves space below that limit after power-of-two
;; rounding without retaining a mostly empty table in every module view.
(define (lower-name-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (+ count (shr count 1))))

;; Only nonidentity names can enter `logical-symbols`. Count an upper bound
;; before allocating a view so its map never grows in the lowering arena. The
;; dense chain is read in place, as `lower-name-env-copy-chain-into!` does:
;; stepping through `lower-name-env-view` rebuilt a view per binding and cost
;; more than the growth it avoids.
(define (lower-name-binding-logical-alias? [source-id : i64] [logical-id : i64]) : bool
  (and (>= source-id 0) (not (= source-id logical-id))))

(define (lower-name-env-logical-alias-count [names : LowerNameEnv]) : i64
  (match names
    [(Nil) 0]
    [(Inline source-id logical-id _)
      (if (lower-name-binding-logical-alias? source-id logical-id)
        1
        0)]
    [(Dense store head _)
      (let
        [cursor : i64 head]
        [count : i64 0]
        (while (>= cursor 0)
          (let
            [binding : LowerNameBinding
              (lower-name-store-binding-at (& (__tl-box-place store)) cursor)]
            (when
              (lower-name-binding-logical-alias?
                binding.source-id
                binding.logical-id)
              (set! count (+ count 1)))
            (set! cursor binding.parent)))
        count)]))

(cfg
  (any compile-profile test)
  (define (lower-name-cache-map-growth-profile
    [before : LowerNameCache]
    [after : (& after LowerNameCache)]) : unit
    (let
      [metrics : profile_state.CompilerProfileMetrics
        (compiler-lower-profile-metrics-view
          (lower-name-cache-owner-state after))]
      (when
        (>
          (lower_i64_i64_map.capacity (& after.ids))
          (lower_i64_i64_map.capacity (& before.ids)))
        (profile_state.compiler-profile-metrics-add!
          (profile_state.compiler-profile-state-shared-view metrics)
          compiler-lower-profile-name-cache-id-growth-views-metric
          1))
      (when
        (>
          (lower_i64_i64_map.capacity (& after.logical-symbols))
          (lower_i64_i64_map.capacity (& before.logical-symbols)))
        (profile_state.compiler-profile-metrics-add!
          metrics
          compiler-lower-profile-name-cache-logical-growth-views-metric
          1)))))

(cfg
  (any compile-profile test)
  (define (lower-alias-overlay-growth-profile
    [state : CompilerLowerState]
    [next : (& next lower_i64_i64_map.Map)]) : unit
    (let
      [old : lower_i64_i64_map.Map
        (compiler-lower-state-read
          state
          lower_i64_i64_map.Map
          alias-overlay-ids)]
      [old-cap : i64 (lower_i64_i64_map.capacity (& old))]
      [next-cap : i64 (lower_i64_i64_map.capacity next)]
      (when
        (> next-cap old-cap)
        ;; The map doubles. Sum the slots allocated by every intermediate
        ;; table, not just the final capacity increase.
        (profile_state.compiler-profile-metrics-add!
          (compiler-lower-profile-metrics-view state)
          compiler-lower-profile-alias-overlay-growth-slots-metric
          (* 2 (- next-cap old-cap)))))))

(define (lower-logical-display-name-select
  [lower-state : CompilerLowerState]
  [display : String]
  [logical-id : i64]
  [direct : bool]) : String
  (if direct
    (compiler-lower-state-intern-str lower-state logical-id)
    display))

;; A derived symbol is minted into the IR's own growable symbol table, not into
;; the fixed intern pool. These logical spellings are by far the largest
;; generated-name population of a whole-program compile, and the pool's fixed
;; slots cannot hold them alongside the source lane (refs #6293). The table
;; keys on the full display string exactly as `intern-generated-canonical-name`
;; does, so a
;; definition and every call to it still resolve to one id and one spelling.
(define (lower-derived-symbol-id [logical-name : String]) : i64
  (ir.compiler-ir-symbol logical-name))

(define (lower-logical-symbol-id-select
  [logical-name : String]
  [logical-id : i64]
  [direct : bool]) : i64
  (if direct
    logical-id
    (lower-derived-symbol-id logical-name)))

(define (lower-logical-symbol-id-direct? [logical-id : i64] [source-id : i64]) : bool
  (and (= logical-id source-id) (tc_core.tc-env-key-has-name-id? logical-id)))

(define (lower-name-cache-logical-module-id [logical-id : i64]) : i64
  (cond
    [(csym.compiler-composite-triple-key-id? logical-id)
      (csym.compiler-composite-triple-left-id logical-id)]
    [(csym.compiler-composite-pair-key-id? logical-id)
      (csym.compiler-composite-pair-left-id logical-id)]
    [else -1]))

(define (lower-module-path-index-add-logical-id!
  [intern-state : ci.InternCompatState]
  [index : (&mut index LowerModulePathIndex)]
  [logical-id : i64]) : unit
  (let
    [module-id : i64 (lower-name-cache-logical-module-id logical-id)]
    (if (or
      (< module-id 0)
      (>= module-id (ci.intern-capacity))
      (csym.compiler-symbol-root-module-id? module-id))
      unit
      (let
        [edges : lower_i64_i64_map.Map index.edges]
        [terminals : lower_i64_i64_map.Map index.terminals]
        [modules : lower_i64_i64_map.Map index.modules]
        [next-node : i64 index.next-node]
        (match (lower_i64_i64_map.get (& modules) module-id)
          [(LookupFound _) unit]
          [(LookupMissing)
            (let
              [current : i64 module-id]
              [node : i64 0]
              (lower_i64_i64_map.insert-ref! (&mut modules) module-id 1)
              (while (>= current 0)
                (let
                  [segment : i64
                    (if (ci.intern-compat-state-dotted? intern-state current)
                      (ci.intern-compat-state-leading-dot-id
                        intern-state
                        current)
                      current)]
                  [edge-key : i64
                    (csym.compiler-composite-pair-key-id node segment)]
                  [child : i64
                    (lower_i64_i64_map.get-value-or (& edges) edge-key -1)]
                  (when
                    (< child 0)
                    (set! child next-node)
                    (set! next-node (+ next-node 1))
                    (lower_i64_i64_map.insert-ref! (&mut edges) edge-key child))
                  (set! node child)
                  (set!
                    current
                    (if (ci.intern-compat-state-dotted? intern-state current)
                      (ci.intern-compat-state-dotted-tail-id
                        intern-state
                        current)
                      -1))))
              (lower_i64_i64_map.insert-ref! (&mut terminals) node module-id)
              (set! index.edges edges)
              (set! index.terminals terminals)
              (set! index.modules modules)
              (set! index.next-node next-node)
              unit)])))))

(defenum LowerNameCacheMaybeId
  (No)
  (Some i64))

(define (lower-name-env-bind-logical-symbol-id
  [source-id : i64]
  [logical-id : i64]
  [symbol-id : i64]
  [rest : LowerNameEnv]) : LowerNameEnv
  (lower-name-env-bind-ids source-id logical-id symbol-id rest))

(cfg
  (any compile-profile test)
  (define (lower-name-env-bind-logical-symbol-id-profile
    [state : CompilerLowerState]
    [source-id : i64]
    [logical-id : i64]
    [symbol-id : i64]
    [rest : LowerNameEnv]) : LowerNameEnv
    (lower-name-env-bind-ids-profile state source-id logical-id symbol-id rest)))

(defmacro (lower-name-env-bind-logical-symbol-id-owned
  [_state : Expr]
  [source-id : Expr]
  [logical-id : Expr]
  [symbol-id : Expr]
  [rest : Expr]) : Expr
  (cfg
    (any compile-profile test)
    `(lower-name-env-bind-logical-symbol-id-profile
      ,_state
      ,source-id
      ,logical-id
      ,symbol-id
      ,rest)
    `(lower-name-env-bind-logical-symbol-id
      ,source-id
      ,logical-id
      ,symbol-id
      ,rest)))

(define (lower-extern-logical-symbol-id
  [lower-state : CompilerLowerState]
  [logical-id : i64]
  [logical-name : String]
  [source-id : i64]
  [metadata : ast.AstExternMetadata]) : i64
  ;; Dependency functions are represented as extern stubs in the consuming
  ;; package. Their source names may collide across dependencies, while the
  ;; imported SPMD metadata retains the canonical package-module identity.
  ;; Use that identity for the IR call target; the extern record still carries
  ;; the exact linker symbol independently, per SPEC 4.4.5.
  (match (ast.ast-extern-metadata-imported-spmd
    (lower-global-shared-view metadata))
    [(Package _ _ canonical-name _)
      (lower-derived-symbol-id
        (compiler-lower-state-intern-id-str lower-state canonical-name))]
    [(No)
      (let
        [direct : bool (lower-logical-symbol-id-direct? logical-id source-id)]
        [link-id : i64
          (ci.intern-id-value
            (ast.ast-extern-metadata-symbol-id
              (lower-global-shared-view metadata)))]
        (if (and
          (ast.ast-extern-metadata-symbol-matches-source? metadata)
          direct)
          link-id
          (lower-logical-symbol-id-select logical-name logical-id direct)))]))

(define (lower-name-cache-owner-state [cache : (& cache LowerNameCache)]) : CompilerLowerState
  (compiler-lower-state-from-address cache.owner-address))

(define (lower-name-cache-interns [cache : (& cache LowerNameCache)]) : ci.InternCompatState
  (compiler-lower-state-interns (lower-name-cache-owner-state cache)))

(define (lower-name-cache-intern-str
  [cache : (& cache LowerNameCache)]
  [id : i64]) : String
  (ci.intern-compat-state-str (lower-name-cache-interns cache) id))

(define (lower-name-cache-structural-session [cache : (& cache LowerNameCache)]) : cis.InternStructuralSessionHandle
  (compiler-lower-state-structural-session (lower-name-cache-owner-state cache)))

(define (lower-name-cache-active-global [cache : (& cache LowerNameCache)]) : LowerNameCache
  (lower-active-global-name-cache-current (lower-name-cache-owner-state cache)))

(define (lower-name-cache-global-lookup-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [global-cache : LowerNameCache (lower-name-cache-active-global cache)]
    (lower-name-cache-lookup-logical-id (& global-cache) source-id fallback)))

(define (lower-name-cache-global-lookup-symbol-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [global-cache : LowerNameCache (lower-name-cache-active-global cache)]
    (lower-name-cache-lookup-symbol-id (& global-cache) source-id fallback)))

(define (lower-name-cache-global-resolve-module-path-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [global-cache : LowerNameCache (lower-name-cache-active-global cache)]
    (lower-module-path-index-resolve-logical-id
      (& global-cache)
      source-id
      fallback)))

(define (lower-name-cache-add-id!
  [cache : (&mut cache LowerNameCache)]
  [source-id : i64]
  [logical-id : i64]
  [fallback-symbol-id : i64]) : unit
  (let
    [ids : lower_i64_i64_map.Map cache.ids]
    [logical-ids : (__tl_dyn-array i64) cache.logical-ids]
    [symbol-ids : (__tl_dyn-array i64) cache.symbol-ids]
    [logical-symbols : lower_i64_i64_map.Map cache.logical-symbols]
    [module-paths : LowerModulePathIndex cache.module-paths]
    (if (< source-id 0)
      unit
      (match (lower_i64_i64_map.get (& ids) source-id)
        [(LookupFound _) unit]
        [(LookupMissing)
          (let
            [next : i64 (lower_i64_i64_map.len (& ids))]
            [logical-slot : i64
              (lower_i64_i64_map.get-value-or (& ids) logical-id -1)]
            [symbol-id : i64
              (if (>= logical-slot 0)
                (array-ref symbol-ids logical-slot)
                (let
                  [local-symbol-id : i64
                    (lower_i64_i64_map.get-value-or
                      (& logical-symbols)
                      logical-id
                      -1)]
                  (if (>= local-symbol-id 0)
                    local-symbol-id
                    (match cache.parent
                      [(None) -1]
                      [(Global)
                        (lower-name-cache-global-lookup-symbol-id
                          cache
                          logical-id
                          -1)]))))]
            (begin
              (cfg
                (any compile-profile test)
                (profile_state.compiler-profile-metrics-add!
                  (compiler-lower-profile-metrics-view
                    (lower-name-cache-owner-state cache))
                  compiler-lower-profile-name-cache-entries-metric
                  1))
              (when (< symbol-id 0) (set! symbol-id fallback-symbol-id))
              (set! (array-ref logical-ids next) logical-id)
              (set! (array-ref symbol-ids next) symbol-id)
              (lower_i64_i64_map.insert-ref! (&mut ids) source-id next)
              (when
                (and (< logical-slot 0) (not (= source-id logical-id)))
                (lower_i64_i64_map.insert-ref!
                  (&mut logical-symbols)
                  logical-id
                  symbol-id))
              (lower-module-path-index-add-logical-id!
                (lower-name-cache-interns cache)
                (&mut module-paths)
                logical-id)
              (set! cache.ids ids)
              (set! cache.logical-ids logical-ids)
              (set! cache.symbol-ids symbol-ids)
              (set! cache.logical-symbols logical-symbols)
              (set! cache.module-paths module-paths)
              unit))]))))

(define (lower-name-cache-from-env-into
  [names : LowerNameEnv]
  [cache : LowerNameCache]) : LowerNameCache
  (let
    [out : LowerNameCache (lower-global-shared-view cache)]
    (begin
      ;; Walk the dense chain in place, head first, in the order
      ;; `lower-name-env-view` yields it, without rebuilding a view per binding.
      (match names
        [(Nil) unit]
        [(Inline source-id logical-id symbol-id)
          (lower-name-cache-add-id! (&mut out) source-id logical-id symbol-id)]
        [(Dense store head _)
          (let
            [cursor : i64 head]
            (while (>= cursor 0)
              (let
                [binding : LowerNameBinding
                  (lower-name-store-binding-at
                    (& (__tl-box-place store))
                    cursor)]
                (lower-name-cache-add-id!
                  (&mut out)
                  binding.source-id
                  binding.logical-id
                  binding.symbol-id)
                (set! cursor binding.parent))))])
      (cfg
        (any compile-profile test)
        (lower-name-cache-map-growth-profile cache out)
        unit)
      out)))

(define (lower-name-cache-from-env
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]) : LowerNameCache
  (begin
    (cfg
      (any compile-profile test)
      (profile_state.compiler-profile-metrics-add!
        (compiler-lower-profile-metrics-view lower-state)
        compiler-lower-profile-name-cache-builds-metric
        1))
    (let
      [count : i64 (lower-name-env-count names)]
      [logical-alias-count : i64
        (lower-name-env-logical-alias-count (lower-global-shared-view names))]
      (lower-name-cache-from-env-into
        names
        (LowerNameCache
          (lower_i64_i64_map.with-capacity (lower-name-cache-capacity count))
          (__tl_make-array i64 count)
          (__tl_make-array i64 count)
          (lower_i64_i64_map.with-capacity
            (lower-name-cache-capacity logical-alias-count))
          (lower-module-path-index-empty)
          (Empty)
          cbi.compiler-builtin-id-fix-empty
          (None)
          lower-state.address)))))

;; Build a small overlay name cache from `names` (the module-local names
;; only). On a miss it falls through to the shared global cache
;; `lower-active-global-name-cache` (see lower-name-cache-resolve-logical-id).
(define (lower-name-cache-overlay
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [module-id : i64]) : LowerNameCache
  (begin
    (cfg
      (any compile-profile test)
      (profile_state.compiler-profile-metrics-add!
        (compiler-lower-profile-metrics-view lower-state)
        compiler-lower-profile-name-cache-builds-metric
        1))
    (let
      [count : i64 (lower-name-env-count names)]
      [logical-alias-count : i64
        (lower-name-env-logical-alias-count (lower-global-shared-view names))]
      (lower-name-cache-from-env-into
        names
        (LowerNameCache
          (lower_i64_i64_map.with-capacity (lower-name-cache-capacity count))
          (__tl_make-array i64 count)
          (__tl_make-array i64 count)
          (lower_i64_i64_map.with-capacity
            (lower-name-cache-capacity logical-alias-count))
          (lower-module-path-index-empty)
          (Empty)
          module-id
          (Global)
          lower-state.address)))))

(define (lower-module-name-cache-store-copy-prefix!
  [source : (__tl_dyn-array LowerNameCache)]
  [destination : (&mut destination (__tl_dyn-array LowerNameCache))]
  [len : i64]) : unit
  (let
    [index : i64 0]
    (while (< index len)
      (set! (array-ref destination index) (array-ref source index))
      (set! index (+ index 1)))))

(define (lower-module-name-cache-store-grow [store : LowerModuleNameCacheStore]) : LowerModuleNameCacheStore
  (let
    [old-capacity : i64 (array-length store.values)]
    [next-capacity : i64
      (if (< old-capacity 1)
        8
        (* old-capacity 2))]
    [next-values : (__tl_dyn-array LowerNameCache)
      (__tl_make-array LowerNameCache next-capacity)]
    (lower-module-name-cache-store-copy-prefix!
      store.values
      (&mut next-values)
      store.len)
    (LowerModuleNameCacheStore store.modules next-values store.len)))

(define (lower-module-name-cache-store-lookup
  [store : LowerModuleNameCacheStore]
  [module-id : i64]) : LowerMaybeModuleNameCache
  (match (lower_i64_i64_map.get (& store.modules) module-id)
    [(LookupFound slot)
      (Some (lower-global-array-element-shared-view store.values slot))]
    [(LookupMissing) (No)]))

(define (lower-module-name-cache-store-insert
  [store : LowerModuleNameCacheStore]
  [module-id : i64]
  [cache : LowerNameCache]) : LowerModuleNameCacheStore
  (match (lower_i64_i64_map.get (& store.modules) module-id)
    [(LookupFound slot)
      (set! (array-ref store.values slot) cache)
      store]
    [(LookupMissing)
      (let
        [ready : LowerModuleNameCacheStore
          (if (>= store.len (array-length store.values))
            (lower-module-name-cache-store-grow store)
            store)]
        [slot : i64 ready.len]
        [modules : lower_i64_i64_map.Map ready.modules]
        (begin
          (set! (array-ref ready.values slot) cache)
          (lower_i64_i64_map.insert-ref! (&mut modules) module-id slot)
          (cfg
            (any compile-profile test)
            (profile_state.compiler-profile-metrics-add!
              (compiler-lower-profile-metrics-view
                (lower-name-cache-owner-state (& cache)))
              compiler-lower-profile-module-name-cache-entries-metric
              1))
          (LowerModuleNameCacheStore modules ready.values (+ slot 1))))]))

(define (lower-active-module-name-cache-lookup
  [lower-state : CompilerLowerState]
  [module-id : i64]) : LowerMaybeModuleNameCache
  (let
    [result : LowerMaybeModuleNameCache
      (lower-module-name-cache-store-lookup
        (compiler-lower-state-read
          lower-state
          LowerModuleNameCacheStore
          active-module-name-caches)
        module-id)]
    (begin
      (cfg
        (any compile-profile test)
        (begin
          (profile_state.compiler-profile-metrics-add!
            (compiler-lower-profile-metrics-view lower-state)
            compiler-lower-profile-module-name-cache-lookups-metric
            1)
          (match (& result)
            [(Some _)
              (profile_state.compiler-profile-metrics-add!
                (compiler-lower-profile-metrics-view lower-state)
                compiler-lower-profile-module-name-cache-hits-metric
                1)]
            [(No) unit])))
      result)))

(define (lower-active-module-name-cache-insert!
  [lower-state : CompilerLowerState]
  [module-id : i64]
  [cache : LowerNameCache]) : unit
  (compiler-lower-state-write!
    lower-state
    LowerModuleNameCacheStore
    active-module-name-caches
    (lower-module-name-cache-store-insert
      (compiler-lower-state-read
        lower-state
        LowerModuleNameCacheStore
        active-module-name-caches)
      module-id
      cache)))

(define (lower-name-cache-with-module-id
  [cache : LowerNameCache]
  [module-id : i64]) : LowerNameCache
  (LowerNameCache
    cache.ids
    cache.logical-ids
    cache.symbol-ids
    cache.logical-symbols
    cache.module-paths
    cache.clone-roots
    module-id
    cache.parent
    cache.owner-address))

(define (lower-name-cache-with-clone-roots
  [cache : LowerNameCache]
  [roots : clone_support.CloneRootEntries]) : LowerNameCache
  (LowerNameCache
    cache.ids
    cache.logical-ids
    cache.symbol-ids
    cache.logical-symbols
    cache.module-paths
    roots
    cache.module-id
    cache.parent
    cache.owner-address))

(define (lower-name-cache-clone-helper-id
  [cache : LowerNameCache]
  [type-key-id : i64]) : i64
  (let
    [helper-id : i64
      (clone_support.clone-root-entries-helper-id-or
        cache.clone-roots
        type-key-id
        -1)]
    (if (>= helper-id 0)
      helper-id
      (match cache.parent
        [(None) -1]
        [(Global)
          (lower-name-cache-clone-helper-id
            (lower-name-cache-active-global (& cache))
            type-key-id)]))))

(define (lower-name-cache-clone-key-id
  [cache : LowerNameCache]
  [type-key-id : i64]) : i64
  (if (>=
    (lower-name-cache-clone-helper-id
      (lower-global-shared-view cache)
      type-key-id)
    0)
    type-key-id
    (let
      [candidate : i64
        (clone_support.clone-root-entries-unique-key-for-base-id-or
          cache.clone-roots
          (clone_support.clone-name-key-base-id type-key-id)
          -1)]
      (if (>= candidate 0)
        candidate
        (match cache.parent
          [(None) -1]
          [(Global)
            (lower-name-cache-clone-key-id
              (lower-name-cache-active-global (& cache))
              type-key-id)])))))

(define (lower-name-cache-lookup-id [cache : LowerNameCache] [source-id : i64]) : tc_core.TcMaybeString
  (let
    [index : i64 (lower_i64_i64_map.get-value-or (& cache.ids) source-id -1)]
    (begin
      (cfg
        (any compile-profile test)
        (compiler-lower-profile-name-cache-lookup
          (compiler-lower-profile-metrics-view
            (lower-name-cache-owner-state (& cache)))
          (>= index 0)))
      (if (>= index 0)
        (Some (ir.compiler-ir-symbol-text (array-ref cache.symbol-ids index)))
        (match cache.parent
          [(None) (No)]
          [(Global)
            (lower-name-cache-lookup-id
              (lower-name-cache-active-global (& cache))
              source-id)])))))

(define (lower-name-cache-lookup-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [index : i64 (lower_i64_i64_map.get-value-or (& cache.ids) source-id -1)]
    (begin
      (cfg
        (any compile-profile test)
        (compiler-lower-profile-name-cache-lookup
          (compiler-lower-profile-metrics-view
            (lower-name-cache-owner-state cache))
          (>= index 0)))
      (if (>= index 0)
        (array-ref cache.logical-ids index)
        (match cache.parent
          [(None) fallback]
          [(Global)
            (lower-name-cache-global-lookup-logical-id cache source-id fallback)])))))

(define (lower-name-cache-lookup-symbol-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [index : i64 (lower_i64_i64_map.get-value-or (& cache.ids) source-id -1)]
    (begin
      (cfg
        (any compile-profile test)
        (compiler-lower-profile-name-cache-lookup
          (compiler-lower-profile-metrics-view
            (lower-name-cache-owner-state cache))
          (>= index 0)))
      (if (>= index 0)
        (array-ref cache.symbol-ids index)
        (let
          [symbol-id : i64
            (lower_i64_i64_map.get-value-or
              (& cache.logical-symbols)
              source-id
              -1)]
          (if (>= symbol-id 0)
            symbol-id
            (match cache.parent
              [(None) fallback]
              [(Global)
                (lower-name-cache-global-lookup-symbol-id
                  cache
                  source-id
                  fallback)])))))))

(define (lower-module-path-index-resolve-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [intern-state : ci.InternCompatState (lower-name-cache-interns cache)]
    [paths : LowerModulePathIndex cache.module-paths]
    [edges : lower_i64_i64_map.Map paths.edges]
    [terminals : lower_i64_i64_map.Map paths.terminals]
    [current : i64 source-id]
    [node : i64 0]
    [result : i64 fallback]
    [done : bool false]
    (while (and
      (not done)
      (ci.intern-compat-state-dotted? intern-state current))
      (let
        [segment : i64
          (ci.intern-compat-state-leading-dot-id intern-state current)]
        [remainder : i64
          (ci.intern-compat-state-dotted-tail-id intern-state current)]
        [edge-key : i64 (csym.compiler-composite-pair-key-id node segment)]
        [child : i64 (lower_i64_i64_map.get-value-or (& edges) edge-key -1)]
        (if (< child 0)
          (set! done true)
          (let
            [module-id : i64
              (lower_i64_i64_map.get-value-or (& terminals) child -1)]
            (set! node child)
            (when
              (and (>= module-id 0) (>= remainder 0))
              (let
                [raw-logical-id : i64
                  (lower-name-cache-lookup-logical-id
                    cache
                    (csym.compiler-symbol-module-key-id-by-id
                      module-id
                      remainder)
                    -1)]
                (if (>= raw-logical-id 0)
                  (set! result raw-logical-id)
                  (when
                    (and
                      (ci.intern-compat-state-dotted? intern-state remainder)
                      (not
                        (ci.intern-compat-state-dotted?
                          intern-state
                          (ci.intern-compat-state-dotted-tail-id
                            intern-state
                            remainder))))
                    (let
                      [qualified-base-id : i64
                        (csym.compiler-composite-pair-key-id
                          (ci.intern-compat-state-leading-dot-id
                            intern-state
                            remainder)
                          (ci.intern-compat-state-dotted-tail-id
                            intern-state
                            remainder))]
                      [qualified-logical-id : i64
                        (lower-name-cache-lookup-logical-id
                          cache
                          (csym.compiler-symbol-module-key-id-by-id
                            module-id
                            qualified-base-id)
                          -1)]
                      (when
                        (>= qualified-logical-id 0)
                        (set! result qualified-logical-id)))))))
            (set! current remainder)))))
    (if (and
      (< result 0)
      (match cache.parent
        [(Global) true]
        [(None) false]))
      (lower-name-cache-global-resolve-module-path-id cache source-id fallback)
      result)))

(define (lower-name-cache-resolve-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [intern-state : ci.InternCompatState (lower-name-cache-interns cache)]
    [module-id : i64 cache.module-id]
    [source-key-id : i64
      (tc_core.tc-env-name-key-id
        (compiler-lower-state-structural-session
          (lower-name-cache-owner-state cache))
        source-id)]
    ;; Qualified macro-hygiene symbols carry the macro definition module as
    ;; their qualifier and the parsed source lookup ID as their base. A dotted
    ;; base therefore has all of the structural path information needed to
    ;; resolve the referenced declaration after a direct lookup misses.
    [path-source-id : i64
      (if (and
        (tc_core.tc-env-key-has-name-id? source-id)
        (ci.intern-compat-state-qualified? intern-state source-id)
        (ci.intern-compat-state-dotted?
          intern-state
          (ci.intern-compat-state-qualified-base-id intern-state source-id)))
        (ci.intern-compat-state-qualified-base-id intern-state source-id)
        source-id)]
    [module-local : i64
      (if (and
        (not (csym.compiler-symbol-root-module-id? module-id))
        (= source-key-id source-id)
        (tc_core.tc-env-key-has-name-id? source-id)
        (not (ci.intern-compat-state-dotted? intern-state source-id)))
        (let
          [qualified-id : i64
            (csym.compiler-symbol-module-key-id-by-id module-id source-id)]
          [cached-logical-id
            : i64
            ;; Module overlays contain import aliases only. A canonical
            ;; current-module key cannot be present there, so avoid one
            ;; guaranteed local-map miss before consulting the shared cache.
            (match cache.parent
              [(Global)
                (lower-name-cache-global-lookup-logical-id
                  cache
                  qualified-id
                  -1)]
              [(None)
                (lower-name-cache-lookup-logical-id cache qualified-id -1)])]
          (if (>= cached-logical-id 0)
            cached-logical-id
            ;; Unlocated compiler-source entry points have no owner path from
            ;; which to build canonical name rows. The typechecker registries
            ;; still prove whether this module owns the source declaration.
            (let
              [owner-state : CompilerLowerState
                (lower-name-cache-owner-state cache)]
              [active-symbols : csym.CompilerSymbols
                (compiler-lower-state-read
                  owner-state
                  csym.CompilerSymbols
                  active-symbols)]
              (if (and
                (compiler-lower-state-read
                  owner-state
                  bool
                  active-symbols-ready)
                (csym.compiler-symbols-handle-found?
                  (csym.compiler-symbols-lookup-value-in-module-id-or
                    active-symbols
                    module-id
                    source-id
                    (csym.compiler-symbols-missing-handle))))
                qualified-id
                -1))))
        -1)]
    (if (>= module-local 0)
      module-local
      (let
        [direct : i64
          (lower-name-cache-lookup-logical-id cache source-key-id -1)]
        (if (>= direct 0)
          direct
          (if (and
            (tc_core.tc-env-key-has-name-id? path-source-id)
            (ci.intern-compat-state-dotted? intern-state path-source-id))
            (let
              [alias-logical-id : i64
                (lower-name-cache-lookup-logical-id
                  cache
                  (csym.compiler-symbol-module-key-id-by-id
                    (ci.intern-compat-state-leading-dot-id
                      intern-state
                      path-source-id)
                    (ci.intern-compat-state-dotted-tail-id
                      intern-state
                      path-source-id))
                  -1)]
              (if (>= alias-logical-id 0)
                alias-logical-id
                (let
                  [path-logical-id : i64
                    (lower-module-path-index-resolve-logical-id
                      cache
                      path-source-id
                      -1)]
                  (if (>= path-logical-id 0)
                    path-logical-id
                    fallback))))
            fallback))))))

(define (lower-name-cache-resolve-symbol-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [logical-id : i64 (lower-name-cache-resolve-logical-id cache source-id -1)]
    (if (< logical-id 0)
      fallback
      (lower-name-cache-lookup-symbol-id cache logical-id fallback))))

(define (lower-name-cache-contains-local-id?
  [cache : (& cache LowerNameCache)]
  [source-id : i64]) : bool
  (if (< source-id 0)
    false
    (>= (lower_i64_i64_map.get-value-or (& cache.ids) source-id -1) 0)))

(define (lower-name-cache-resolve-id-display
  [cache : LowerNameCache]
  [source-id : i64]) : tc_core.TcMaybeString
  (let
    [source-key-id : i64
      (tc_core.tc-env-name-key-id
        (lower-name-cache-structural-session (& cache))
        source-id)]
    [logical-id : i64
      (lower-name-cache-resolve-logical-id (& cache) source-id -1)]
    (if (< logical-id 0)
      (No)
      (if (= logical-id source-key-id)
        (lower-name-cache-lookup-id cache source-key-id)
        (match (lower-name-cache-lookup-id
          (lower-global-shared-view cache)
          logical-id)
          [(Some logical-name) (Some logical-name)]
          [(No)
            (Some
              (tc_core.tc-env-key-name-text-for-session
                (lower-name-cache-structural-session (& cache))
                logical-id))])))))

(define (lower-type-env-count [env : tc_core.TcTypeEnv]) : i64
  (match (tc_core.tc-type-env-spine-step env)
    [(Done) 0]
    [(Cache rest-env) (lower-type-env-count rest-env)]
    [(Bind _ _ rest-env) (+ 1 (lower-type-env-count rest-env))]))

(define (lower-type-env-contains-reference? [env : tc_core.TcTypeEnv]) : bool
  (match (tc_core.tc-type-env-spine-step env)
    [(Done) false]
    [(Cache rest-env) (lower-type-env-contains-reference? rest-env)]
    [(Bind _ ty rest-env)
      (if (tc_core.tc-type-contains-reference? ty)
        true
        (lower-type-env-contains-reference? rest-env))]))

(define (lower-type-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (lower-type-cache-add
  [cache : LowerTypeCache]
  [name-id : i64]
  [ty : ast.AstType]) : LowerTypeCache
  (match (lower-global-shared-view cache)
    [(No) cache]
    [(Some ids values next parent owner-address)
      (match (lower_i64_i64_map.get (& ids) name-id)
        [(LookupFound _) cache]
        [(LookupMissing)
          (set! (array-ref values next) ty)
          (lower_i64_i64_map.insert-ref! (&mut ids) name-id next)
          (Some ids values (+ next 1) parent owner-address)])]))

(define (lower-type-cache-from-env-into
  [env : tc_core.TcTypeEnv]
  [cache : LowerTypeCache]) : LowerTypeCache
  (match (tc_core.tc-type-env-spine-step env)
    [(Done) cache]
    [(Cache rest-env) (lower-type-cache-from-env-into rest-env cache)]
    [(Bind name-id ty rest-env)
      (lower-type-cache-from-env-into
        rest-env
        (lower-type-cache-add cache name-id ty))]))

(define (lower-type-cache-from-env
  [lower-state : CompilerLowerState]
  [env : tc_core.TcTypeEnv]) : LowerTypeCache
  (let
    [count : i64 (lower-type-env-count env)]
    (lower-type-cache-from-env-into
      env
      (Some
        (lower_i64_i64_map.with-capacity (lower-type-cache-capacity count))
        (__tl_make-array ast.AstType count)
        0
        (None)
        lower-state.address))))

;; Build a small overlay type cache from `env` (the module-local type
;; bindings only). On a miss it falls through to the shared global cache
;; in the lower state's `decls-global-type-cache` cell (see
;; lower-type-cache-lookup-id).
(define (lower-type-cache-overlay
  [lower-state : CompilerLowerState]
  [env : tc_core.TcTypeEnv]) : LowerTypeCache
  (let
    [count : i64 (lower-type-env-count env)]
    (lower-type-cache-from-env-into
      env
      (Some
        (lower_i64_i64_map.with-capacity (lower-type-cache-capacity count))
        (__tl_make-array ast.AstType count)
        0
        (Global)
        lower-state.address))))

(define (lower-type-cache-lookup-id
  [cache : LowerTypeCache]
  [name-id : i64]
  [display-name : String]) : tc_core.ResultTcType
  (match cache
    [(No) (Err (str_cat.str-cat "typecheck: unbound name " display-name))]
    [(Some ids values _ parent owner-address)
      (let
        [index : i64 (lower_i64_i64_map.get-value-or (& ids) name-id -1)]
        (if (>= index 0)
          (Ok (lower-global-array-element-shared-view values index))
          (match parent
            [(None)
              (Err (str_cat.str-cat "typecheck: unbound name " display-name))]
            [(Global)
              (lower-type-cache-lookup-id
                (compiler-lower-state-read
                  (compiler-lower-state-from-address owner-address)
                  LowerTypeCache
                  decls-global-type-cache)
                name-id
                display-name)])))]))

(define (lower-hygiene-source-name [name : String]) : String
  (if (tc_core.tc-hygiene-global-name? name)
    (match (tc_core.tc-hygiene-global-decode name)
      [(Legacy lookup-name) lookup-name]
      [(Context module lookup-name)
        (if (tc_core.tc-name-qualified? lookup-name)
          lookup-name
          (csym.compiler-symbol-module-key module lookup-name))])
    name))

(define (lower-hygiene-fallback-source-name [name : String]) : tc_core.TcMaybeString
  (if (tc_core.tc-hygiene-global-name? name)
    (match (tc_core.tc-hygiene-global-decode name)
      [(Legacy _) (No)]
      [(Context module lookup-name)
        (if (and
          (> (string.string-length module) 0)
          (not (tc_core.tc-name-qualified? lookup-name)))
          (Some lookup-name)
          (No))])
    (No)))

(define (lower-hygiene-context-source-name-id
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [module : String]
  [module-id : i64]
  [lookup-name : String]
  [lookup-name-id : i64]) : String
  (if (tc_core.tc-name-qualified-id?
    (tc_core.tc-context-structural-session ctx)
    lookup-name-id)
    lookup-name
    (if (and
      (>= lookup-name-id 0)
      (< lookup-name-id (ci.intern-capacity))
      (>=
        (tc_core.tc-name-first-dot-id
          (tc_core.tc-context-structural-session ctx)
          lookup-name-id)
        0))
      (match (tc_core.tc-source-name-lookup-key-with-field-check
        (tc_core.tc-context-with-module-id
          ctx
          (lower-global-shared-view module)
          module-id)
        type-env
        (lower-global-shared-view lookup-name)
        lookup-name-id
        true)
        [(Ok resolved-name) resolved-name]
        [(Err _) (csym.compiler-symbol-module-key module lookup-name)])
      (csym.compiler-symbol-module-key module lookup-name))))

(define (lower-context-intern-str [ctx : tc_core.TcContext] [id : i64]) : String
  (ci.intern-source-name-session-handle-str
    (tc_core.tc-context-source-names ctx)
    id))

(define (lower-hygiene-source-name-in-context-id
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : String
  (let
    [interns : ci.InternCompatState (compiler-lower-state-interns lower-state)]
    [session : cis.InternStructuralSessionHandle
      (tc_core.tc-context-structural-session ctx)]
    [structural? : bool (tc_core.macro-hygiene-global-id? session name-id)]
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or session name-id name-id)]
    [name : String (lower-context-intern-str ctx source-id)]
    (if structural?
      (let
        [module-id : i64
          (tc_core.macro-hygiene-global-module-id session name-id)]
        (if (tc_core.macro-hygiene-global-legacy-id? session name-id)
          name
          (lower-hygiene-context-source-name-id
            ctx
            type-env
            (if (csym.compiler-symbol-root-module-id? module-id)
              ""
              (tc_core.tc-env-key-name-text-for-session session module-id))
            module-id
            name
            source-id)))
      (if (tc_core.tc-hygiene-global-name? name)
        (match (tc_core.tc-hygiene-global-decode name)
          [(Legacy lookup-name) lookup-name]
          [(Context module lookup-name)
            (let
              [lookup-name-id : i64
                (tc_core.macro-hygiene-global-source-name-id-or
                  session
                  name-id
                  -1)]
              [module-id : i64
                (ci.intern-compat-state-qualified-module-id (& interns) name-id)]
              (if (and (>= lookup-name-id 0) (>= module-id 0))
                (lower-hygiene-context-source-name-id
                  ctx
                  type-env
                  module
                  module-id
                  lookup-name
                  lookup-name-id)
                (csym.compiler-symbol-module-key module lookup-name)))])
        name))))

(define (lower-type-cache-lookup-hygiene-id
  [session : cis.InternStructuralSessionHandle]
  [cache : LowerTypeCache]
  [name : String]
  [generated-name-id : i64]) : tc_core.ResultTcType
  (let
    [source-name : String
      (lower-hygiene-source-name (lower-global-shared-view name))]
    [source-name-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        session
        generated-name-id
        -1)]
    [source-key-id : i64 (tc_core.tc-env-name-key-id session source-name-id)]
    [lookup-id : i64
      (if (>= source-name-id 0)
        (tc_core.tc-env-name-key-id session generated-name-id)
        source-key-id)]
    (match (lower-type-cache-lookup-id
      (lower-global-shared-view cache)
      lookup-id
      source-name)
      [(Ok ty) (Ok ty)]
      [(Err message)
        (match (lower-hygiene-fallback-source-name name)
          [(Some fallback)
            (match (lower-type-cache-lookup-id
              cache
              (if (>= source-name-id 0)
                source-name-id
                source-key-id)
              fallback)
              [(Ok ty) (Ok ty)]
              [(Err _) (Err message)])]
          [(No) (Err message)])])))

(define (lower-source-name-lookup-key-id
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]) : tc_core.ResultTcString
  (let
    [source-name : String (lower-context-intern-str ctx source-id)]
    (if (tc_core.tc-source-slash-qualified-id?
      (tc_core.tc-context-structural-session ctx)
      (lower-global-shared-view source-name)
      source-id)
      (Ok source-name)
      (tc_core.tc-source-name-lookup-key-with-field-check
        ctx
        type-env
        source-name
        source-id
        true))))

(define (lower-lookup-structural-hygiene-type-id
  [ctx : tc_core.TcContext]
  [type-cache : LowerTypeCache]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : tc_core.ResultTcType
  (let
    [session : cis.InternStructuralSessionHandle
      (tc_core.tc-context-structural-session ctx)]
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or session name-id -1)]
    [source-name : String (lower-context-intern-str ctx source-id)]
    (if (tc_core.macro-hygiene-global-legacy-id? session name-id)
      (lower-type-cache-lookup-id
        type-cache
        (tc_core.tc-env-name-key-id session source-id)
        source-name)
      (let
        [module-id : i64
          (tc_core.macro-hygiene-global-module-id session name-id)]
        [definition-ctx : tc_core.TcContext
          (if (csym.compiler-symbol-root-module-id? module-id)
            (tc_core.tc-context-with-module-id
              ctx
              ""
              cbi.compiler-builtin-id-fix-empty)
            (tc_core.tc-context-with-module-id
              ctx
              (tc_core.tc-env-key-name-text-for-session session module-id)
              module-id))]
        (if (>= (tc_core.tc-name-first-dot-id session source-id) 0)
          (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
            definition-ctx
            type-env
            source-name
            source-id
            true)
            [(Ok lookup-name lookup-id)
              ;; `Enum.Variant` resolves to a registry key the type cache
              ;; never binds; its type is the variant's constructor type.
              (match (lower-type-cache-lookup-id
                type-cache
                (tc_core.tc-env-name-key-id session lookup-id)
                lookup-name)
                [(Ok ty) (Ok ty)]
                [(Err message)
                  (tc_core.tc-variant-constructor-type-for-lookup-or-id
                    definition-ctx
                    lookup-id
                    message)])]
            [(Err message) (Err message)])
          (lower-type-cache-lookup-id
            type-cache
            (csym.compiler-symbol-module-key-id-by-id module-id source-id)
            source-name))))))

(define (lower-lookup-type-existing-id
  [ctx : tc_core.TcContext]
  [type-cache : LowerTypeCache]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [name-id : i64]) : tc_core.ResultTcType
  (cond
    [(tc_core.tc-dotted-local-field-name-id? type-env name-id)
      (let
        [virtual-id
          (try
            (tc_core.tc-dotted-local-field-expr-id-from-source-name-id
              (tc_core.tc-context-structural-session ctx)
              name-id))]
        (tc_core.tc-expr ctx type-env (lower-context-expr-get ctx virtual-id)))]
    [(tc_core.tc-hygiene-global-name? name)
      (lower-type-cache-lookup-hygiene-id
        (tc_core.tc-context-structural-session ctx)
        type-cache
        name
        name-id)]
    [(tc_core.tc-source-slash-qualified-id?
        (tc_core.tc-context-structural-session ctx)
        (lower-global-shared-view name)
        name-id)
      (let
        [lookup-key-id : i64
          (tc_core.tc-env-name-key-id
            (tc_core.tc-context-structural-session ctx)
            name-id)]
        (match (lower-type-cache-lookup-id type-cache lookup-key-id name)
          [(Ok ty) (Ok ty)]
          [(Err message)
            (match (tc_core.tc-lookup-id type-env lookup-key-id)
              [(Ok ty) (Ok ty)]
              [(Err _) (Err message)])]))]
    [else
      (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
        ctx
        type-env
        (lower-global-shared-view name)
        name-id
        false)
        [(Ok lookup-name lookup-id)
          (if (sym_i64_env.sym-i64-contains-id env lookup-id)
            (tc_core.tc-lookup-id type-env lookup-id)
            ;; `type-cache` is the complete global type environment plus the
            ;; current module overlay. Preserve raw generated-name hits, then
            ;; use the canonical module/base key only as the dotted-source
            ;; fallback, matching typechecking without conflating the two ID
            ;; domains.
            (match (lower-type-cache-lookup-id
              type-cache
              lookup-id
              (lower-global-shared-view lookup-name))
              [(Ok ty) (Ok ty)]
              [(Err message)
                (let
                  [lookup-key-id : i64
                    (tc_core.tc-env-name-key-id
                      (tc_core.tc-context-structural-session ctx)
                      lookup-id)]
                  (if (= lookup-key-id lookup-id)
                    (tc_core.tc-variant-constructor-type-for-lookup-or-id
                      ctx
                      lookup-id
                      (tc_core.tc-source-unbound-display-message
                        ctx
                        name
                        name-id
                        lookup-name
                        message))
                    (match (tc_core.tc-lookup-id type-env lookup-key-id)
                      [(Ok ty) (Ok ty)]
                      [(Err _)
                        (tc_core.tc-variant-constructor-type-for-lookup-or-id
                          ctx
                          lookup-id
                          (tc_core.tc-source-unbound-display-message
                            ctx
                            name
                            name-id
                            lookup-name
                            message))])))]))]
        [(Err message) (Err message)])]))

(define (lower-lookup-type-id
  [ctx : tc_core.TcContext]
  [type-cache : LowerTypeCache]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : tc_core.ResultTcType
  (cond
    [(sym_i64_env.sym-i64-contains-id env name-id)
      (tc_core.tc-lookup-id type-env name-id)]
    [(tc_core.macro-hygiene-global-id?
        (tc_core.tc-context-structural-session ctx)
        name-id)
      (lower-lookup-structural-hygiene-type-id ctx type-cache type-env name-id)]
    [(tc_core.tc-env-key-has-name-id? name-id)
      (let
        [name : String (tc_core.tc-env-key-name-text name-id)]
        (lower-lookup-type-existing-id ctx type-cache env type-env name name-id))]
    [else
      (lower-type-cache-lookup-id
        type-cache
        name-id
        (tc_core.tc-env-key-display
          (tc_core.tc-context-structural-session ctx)
          name-id))]))

;; Growable membership set of the interned source-ids already bound into the
;; import-alias overlay currently being built by
;; lower-name-env-from-import-aliases-in-module-cache. That overlay starts empty
;; and is accumulated strictly linearly (single accumulator, no branching or
;; re-entrant overlay builds), so an O(1) hashmap presence check can stand in for
;; an O(n) LowerNameEnv scan per added alias (O(aliases^2) per module). Only
;; presence matters here, so a bare generated i64 -> i64 map (which grows) is
;; used rather than a fixed-capacity LowerNameCache.
;;
;; `valid` guards the fast path. Every alias bound through this overlay carries
;; an interned (>=0) source id, so the set stays a complete mirror; but should a
;; <0 (never-interned) id ever appear -- the only case lower-name-env-lookup-with-id
;; resolves through its string-compare gate rather than the id gate -- we drop
;; back to the exact scan for the remainder of the overlay so the Some/No result
;; stays byte-identical to the pure linear scan.
(define (lower-alias-overlay-owner-arena [lower-state : CompilerLowerState]) : arena.Arena
  ;; The lower state survives entry scratch and batch arena resets. Its map
  ;; backing must therefore live beside the state's other retained memo data.
  (let
    [storage : CompilerLowerFunctionMemoStorage
      (compiler-lower-function-memo-storage lower-state)]
    (arena.Arena storage.arena)))

;; Only an insert that grows the table allocates, so only that insert needs
;; the retained arena; the rest skip the arena switch.
(define (lower-alias-overlay-insert!
  [lower-state : CompilerLowerState]
  [ids : (&mut ids lower_i64_i64_map.Map)]
  [source-id : i64]
  [logical-id : i64]) : unit
  (if (>= ids.len ids.growth-limit)
    (in-arena
      (lower-alias-overlay-owner-arena lower-state)
      (lower_i64_i64_map.insert-ref! ids source-id logical-id))
    (lower_i64_i64_map.insert-ref! ids source-id logical-id)))

;; The overlay set is insert-only, so an empty table has no tombstones and
;; already has its full growth limit. Clearing costs its whole capacity, so
;; skip it for a table that is already empty.
(define (lower-alias-overlay-clear! [ids : (&mut ids lower_i64_i64_map.Map)]) : unit
  (when (> ids.len 0) (lower_i64_i64_map.clear-ref! ids)))

(define (lower-alias-overlay-reset! [lower-state : CompilerLowerState]) : unit
  (let
    [ids : lower_i64_i64_map.Map
      (compiler-lower-state-read
        lower-state
        lower_i64_i64_map.Map
        alias-overlay-ids)]
    (begin
      ;; The set is consulted only while constructing the current overlay.
      ;; Keep its largest table for the next build instead of stranding every
      ;; grown table in the lowering arena.
      (lower-alias-overlay-clear! (&mut ids))
      (cfg
        (any compile-profile test)
        (profile_state.compiler-profile-metrics-add!
          (compiler-lower-profile-metrics-view lower-state)
          compiler-lower-profile-alias-overlay-resets-metric
          1)
        unit)
      (compiler-lower-state-write!
        lower-state
        lower_i64_i64_map.Map
        alias-overlay-ids
        ids)
      (compiler-lower-state-write! lower-state bool alias-overlay-valid true))))

(define (lower-alias-overlay-contains?
  [lower-state : CompilerLowerState]
  [source-id : i64]) : bool
  (let
    [ids : lower_i64_i64_map.Map
      (compiler-lower-state-read
        lower-state
        lower_i64_i64_map.Map
        alias-overlay-ids)]
    (match (lower_i64_i64_map.get (& ids) source-id)
      [(LookupFound _) true]
      [(LookupMissing) false])))

(define (lower-alias-overlay-logical-id-or
  [lower-state : CompilerLowerState]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [ids : lower_i64_i64_map.Map
      (compiler-lower-state-read
        lower-state
        lower_i64_i64_map.Map
        alias-overlay-ids)]
    (lower_i64_i64_map.get-value-or (& ids) source-id fallback)))

(define (lower-alias-overlay-record!
  [lower-state : CompilerLowerState]
  [source-id : i64]
  [logical-id : i64]) : unit
  (let
    [ids : lower_i64_i64_map.Map
      (compiler-lower-state-read
        lower-state
        lower_i64_i64_map.Map
        alias-overlay-ids)]
    (begin
      (lower-alias-overlay-insert! lower-state (&mut ids) source-id logical-id)
      (cfg
        (any compile-profile test)
        (lower-alias-overlay-growth-profile lower-state (& ids))
        unit)
      (compiler-lower-state-write!
        lower-state
        lower_i64_i64_map.Map
        alias-overlay-ids
        ids))))

;; Seed the overlay membership set from an existing base environment.
(define (lower-alias-overlay-seed-from-env!
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]) : unit
  (let
    [ids : lower_i64_i64_map.Map
      (compiler-lower-state-read
        lower-state
        lower_i64_i64_map.Map
        alias-overlay-ids)]
    [valid : bool true]
    [cur : LowerNameEnv names]
    (begin
      (lower-alias-overlay-clear! (&mut ids))
      (while (match (lower-global-shared-view cur)
        [(Nil) false]
        [_ true])
        (match (lower-name-env-view (lower-global-shared-view cur))
          [(Nil) unit]
          [(Bind bind-id logical-id _ rest)
            (if (< bind-id 0)
              (set! valid false)
              (lower-alias-overlay-insert!
                lower-state
                (&mut ids)
                bind-id
                logical-id))
            (set! cur rest)]))
      (cfg
        (any compile-profile test)
        (lower-alias-overlay-growth-profile lower-state (& ids))
        unit)
      (compiler-lower-state-write!
        lower-state
        lower_i64_i64_map.Map
        alias-overlay-ids
        ids)
      (compiler-lower-state-write! lower-state bool alias-overlay-valid valid))))

;; Per-declaration memo of the import-alias logical symbol ID, live for exactly
;; one lower-name-env-from-import-aliases pass.
;;
;; The rendered logical display name feeding lower-logical-symbol-id-select is a
;; function of the TARGET declaration alone -- entry path, the declaration's own
;; path, its owning module, and its name. The importing alias never appears in
;; it. The alias fanout, however, visits every declaration of a module once per
;; importing alias, so it would render the same "<module>::<name>" string many
;; times per declaration. Those strings
;; are pure scratch -- only the interned ID they resolve to is retained -- yet
;; the lowering arena has no free, so all of them would stay live through
;; the compile-wide peak, in each of the two name-env builds.
;;
;; Keying on the declaration's program-order position collapses that to one
;; render per declaration. The first visit renders and interns in exactly the
;; unmemoized order, so the intern pool receives the same insertions with the
;; same IDs; later visits reuse the ID that intern-generated-canonical-name
;; would have returned from its existing slot anyway.
(define (lower-alias-symbol-memo-reset!
  [lower-state : CompilerLowerState]
  [count : i64]) : unit
  (let
    [slots : (__tl_dyn-array i64)
      (__tl_make-array
        i64
        (if (< count 1)
          1
          count))]
    [index : i64 0]
    (while (< index count)
      (set! (array-ref slots index) -1)
      (set! index (+ index 1)))
    (compiler-lower-state-write!
      lower-state
      (__tl_dyn-array i64)
      alias-symbol-memo
      slots)))

(define (lower-alias-symbol-memo-release! [lower-state : CompilerLowerState]) : unit
  (compiler-lower-state-write!
    lower-state
    (__tl_dyn-array i64)
    alias-symbol-memo
    (__tl_make-array i64 0)))

(define (lower-alias-symbol-memo-get
  [lower-state : CompilerLowerState]
  [position : i64]) : i64
  (let
    [memo : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        alias-symbol-memo)]
    (if (or (< position 0) (>= position (array-length memo)))
      -1
      (array-ref memo position))))

(define (lower-alias-symbol-memo-set!
  [lower-state : CompilerLowerState]
  [position : i64]
  [symbol-id : i64]) : unit
  (let
    [memo : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        alias-symbol-memo)]
    (if (or (< position 0) (< symbol-id 0) (>= position (array-length memo)))
      unit
      (set! (array-ref memo position) symbol-id))))

(define (lower-name-env-add-import-alias-binding-symbol-id
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [alias : String]
  [_ : String]
  [source-id : i64]
  [_ : String]
  [logical-id : i64]
  [symbol-id : i64]) : LowerNameEnv
  (when
    (< source-id 0)
    (compiler-lower-state-write! lower-state bool alias-overlay-valid false))
  ;; Re-entering a flattened module can repeat the exact same aliased import.
  ;; Its source and logical IDs are identical, so another shadowing node cannot
  ;; change resolution. A later reuse of the alias for a different logical ID
  ;; still binds and replaces the tracked value.
  (when
    (not (string.eq alias ""))
    (when
      (compiler-lower-state-read lower-state bool alias-overlay-valid)
      (when
        (=
          (lower-alias-overlay-logical-id-or lower-state source-id -1)
          logical-id)
        (return names))
      (lower-alias-overlay-record! lower-state source-id logical-id))
    (return
      (lower-name-env-bind-logical-symbol-id-owned
        lower-state
        source-id
        logical-id
        symbol-id
        names)))
  ;; Empty alias, degraded set (a <0 id appeared): exact linear scan preserves
  ;; the Some/No decision byte-for-byte.
  (when
    (not (compiler-lower-state-read lower-state bool alias-overlay-valid))
    (return
      (match (lower-name-env-lookup-with-id-owned
        lower-state
        (lower-global-shared-view names)
        source-id)
        [(Some _) names]
        [(No)
          (lower-name-env-bind-logical-symbol-id-owned
            lower-state
            source-id
            logical-id
            symbol-id
            names)])))
  ;; Fast path: O(1) membership check against the base-seeded overlay set,
  ;; same accept decision as scanning `names`.
  (when (lower-alias-overlay-contains? lower-state source-id) (return names))
  (lower-alias-overlay-record! lower-state source-id logical-id)
  (lower-name-env-bind-logical-symbol-id-owned
    lower-state
    source-id
    logical-id
    symbol-id
    names))

(define (lower-name-env-add-decl-import-alias-binding-base-id
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [position : i64]
  [entry-path : String]
  [decl-path : String]
  [alias : String]
  [alias-id : i64]
  [module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]
  [path-aware : bool]) : LowerNameEnv
  (let
    [logical-id : i64 (lower-module-name-key-id-by-id module-id source-id)]
    [memoized : i64 (lower-alias-symbol-memo-get lower-state position)]
    (if (>= memoized 0)
      ;; This declaration was already resolved earlier in the pass by another
      ;; importing alias. Re-rendering its display name would rebuild a string
      ;; whose every interned constituent is already present -- the composite
      ;; logical key above, and the canonical name itself -- so the render can
      ;; only reproduce `memoized`.
      (lower-name-env-add-import-alias-binding-base-symbol-id
        lower-state
        names
        alias
        alias-id
        source-name
        source-id
        logical-id
        ""
        memoized)
      ;; First sight of this declaration: render, derive, and intern in the
      ;; original order (logical key, display name, alias composite key, then
      ;; the canonical symbol) so intern ID assignment is unchanged.
      (let
        [logical-name : String
          (lower-alias-logical-name-id
            lower-state
            (lower-global-shared-view entry-path)
            (lower-global-shared-view decl-path)
            module
            module-id
            source-id
            (lower-global-shared-view source-name)
            path-aware)]
        [direct : bool
          (lower-alias-logical-symbol-direct?
            entry-path
            decl-path
            logical-id
            source-id
            path-aware)]
        [source-key-id : i64
          (csym.compiler-symbol-module-key-id-by-id alias-id source-id)]
        [symbol-id : i64
          (lower-logical-symbol-id-select
            (lower-global-shared-view logical-name)
            logical-id
            direct)]
        (lower-alias-symbol-memo-set! lower-state position symbol-id)
        (lower-name-env-add-import-alias-binding-symbol-id
          lower-state
          names
          alias
          source-name
          source-key-id
          logical-name
          logical-id
          symbol-id)))))

(define (lower-name-env-add-import-alias-binding-base-symbol-id
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [alias : String]
  [alias-id : i64]
  [_ : String]
  [base-id : i64]
  [logical-id : i64]
  [logical-name : String]
  [symbol-id : i64]) : LowerNameEnv
  (lower-name-env-add-import-alias-binding-symbol-id
    lower-state
    names
    alias
    ;; As above: the callee ignores the rendered key (`[_ : String]`); only
    ;; the composite key ID is consumed.
    ""
    (csym.compiler-symbol-module-key-id-by-id alias-id base-id)
    logical-name
    logical-id
    symbol-id))

(define (lower-name-env-add-import-alias-binding-base-cache-symbol-id
  [names : LowerNameEnv]
  [base-cache : (& base-cache LowerNameCache)]
  [dedup-base : bool]
  [alias : (& alias str)]
  [alias-id : i64]
  [_ : String]
  [base-id : i64]
  [logical-id : i64]
  [_ : String]
  [symbol-id : i64]) : LowerNameEnv
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache base-cache)]
    [source-id : i64
      (csym.compiler-symbol-module-key-id-by-id alias-id base-id)]
    (when
      (< source-id 0)
      (compiler-lower-state-write! lower-state bool alias-overlay-valid false))
    ;; Identical aliased imports may recur when a flattened module is
    ;; re-entered. Skip only an identical source/logical pair; a different
    ;; logical target still shadows and updates the tracked value.
    (when
      (not (string.eq alias ""))
      (when
        (compiler-lower-state-read lower-state bool alias-overlay-valid)
        (when
          (=
            (lower-alias-overlay-logical-id-or lower-state source-id -1)
            logical-id)
          (return names))
        (lower-alias-overlay-record! lower-state source-id logical-id))
      (return
        (lower-name-env-bind-logical-symbol-id-owned
          lower-state
          source-id
          logical-id
          symbol-id
          names)))
    ;; Empty alias already provided by the base module: nothing to add.
    (when
      (and
        dedup-base
        (lower-name-cache-contains-local-id? base-cache source-id))
      (return names))
    ;; Degraded set (a <0 id appeared): exact linear scan preserves the
    ;; Some/No decision byte-for-byte.
    (when
      (not (compiler-lower-state-read lower-state bool alias-overlay-valid))
      (return
        (match (lower-name-env-lookup-with-id-owned
          lower-state
          (lower-global-shared-view names)
          source-id)
          [(Some _) names]
          [(No)
            (lower-name-env-bind-logical-symbol-id-owned
              lower-state
              source-id
              logical-id
              symbol-id
              names)])))
    ;; Fast path: O(1) overlay dedup, same accept decision as scanning `names`.
    (when (lower-alias-overlay-contains? lower-state source-id) (return names))
    (lower-alias-overlay-record! lower-state source-id logical-id)
    (lower-name-env-bind-logical-symbol-id-owned
      lower-state
      source-id
      logical-id
      symbol-id
      names)))

;; The module-local alias fanout resolves every (import, declaration) pair
;; through the base module's name cache, which holds the pair's symbol on
;; practically every visit. So the display name that derives the miss fallback
;; is rendered only on an actual miss: the callee below ignores the rendered
;; name (its parameter is `_`), so the result is the same either way, without
;; the throwaway module-key strings. Presence is decided with the same
;; `>= 0` test the render helper itself uses on this API.
(define (lower-name-cache-alias-symbol-id-or-derived
  [base-cache : (& base-cache LowerNameCache)]
  [logical-id : i64]
  [module : String]
  [source-name : String]
  [source-id : i64]) : i64
  (let
    [cached : i64
      (lower-name-cache-lookup-symbol-id (& base-cache) logical-id -1)]
    (if (>= cached 0)
      cached
      (lower-derived-symbol-id
        (lower-current-decl-logical-name-cache-id
          base-cache
          module
          source-name
          source-id)))))

(define (lower-name-env-add-import-alias-binding-base-cache-id
  [names : LowerNameEnv]
  [base-cache : (& base-cache LowerNameCache)]
  [dedup-base : bool]
  [alias : (& alias str)]
  [alias-id : i64]
  [base-name : String]
  [base-id : i64]
  [logical-id : i64]
  [module : String]
  [source-name : String]
  [source-id : i64]) : LowerNameEnv
  (lower-name-env-add-import-alias-binding-base-cache-symbol-id
    names
    base-cache
    dedup-base
    alias
    alias-id
    base-name
    base-id
    logical-id
    ;; The callee ignores this rendered name; only the symbol id is consumed.
    ""
    (lower-name-cache-alias-symbol-id-or-derived
      base-cache
      logical-id
      module
      source-name
      source-id)))

(define (lower-module-name-key-id-by-id [module-id : i64] [name-id : i64]) : i64
  (if (csym.compiler-symbol-root-module-id? module-id)
    name-id
    (csym.compiler-symbol-module-key-id-by-id module-id name-id)))

(define (lower-name-env-add-module-binding-id
  [names : LowerNameEnv]
  [_module : String]
  [module-id : i64]
  [_ : String]
  [source-id : i64]
  [logical-name : String]
  [logical-id : i64]
  [direct : bool]) : LowerNameEnv
  (let
    [symbol-id : i64
      (lower-logical-symbol-id-select
        logical-name
        (if direct
          source-id
          logical-id)
        direct)]
    (if (csym.compiler-symbol-root-module-id? module-id)
      (lower-name-env-bind-logical-symbol-id
        source-id
        logical-id
        symbol-id
        names)
      (lower-name-env-bind-logical-symbol-id
        logical-id
        logical-id
        symbol-id
        names))))

(cfg
  (any compile-profile test)
  (define (lower-name-env-add-module-binding-id-profile
    [state : CompilerLowerState]
    [names : LowerNameEnv]
    [_module : String]
    [module-id : i64]
    [_ : String]
    [source-id : i64]
    [logical-name : String]
    [logical-id : i64]
    [direct : bool]) : LowerNameEnv
    (let
      [symbol-id : i64
        (lower-logical-symbol-id-select
          logical-name
          (if direct
            source-id
            logical-id)
          direct)]
      (if (csym.compiler-symbol-root-module-id? module-id)
        (lower-name-env-bind-logical-symbol-id-profile
          state
          source-id
          logical-id
          symbol-id
          names)
        (lower-name-env-bind-logical-symbol-id-profile
          state
          logical-id
          logical-id
          symbol-id
          names)))))

(defmacro (lower-name-env-add-module-binding-id-owned
  [_state : Expr]
  [names : Expr]
  [module : Expr]
  [module-id : Expr]
  [source-name : Expr]
  [source-id : Expr]
  [logical-name : Expr]
  [logical-id : Expr]
  [direct : Expr]) : Expr
  (cfg
    (any compile-profile test)
    `(lower-name-env-add-module-binding-id-profile
      ,_state
      ,names
      ,module
      ,module-id
      ,source-name
      ,source-id
      ,logical-name
      ,logical-id
      ,direct)
    `(lower-name-env-add-module-binding-id
      ,names
      ,module
      ,module-id
      ,source-name
      ,source-id
      ,logical-name
      ,logical-id
      ,direct)))

(define (lower-name-env-add-decl-module-binding-id
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]) : LowerNameEnv
  (let
    [logical-id : i64
      (lower-decl-logical-id
        lower-state
        (lower-global-shared-view entry-path)
        (lower-global-shared-view decl-path)
        (lower-global-shared-view module)
        module-id
        source-id
        (lower-global-shared-view source-name))]
    (lower-name-env-add-module-binding-id-owned
      lower-state
      names
      (lower-global-shared-view module)
      module-id
      (lower-global-shared-view source-name)
      source-id
      (lower-decl-logical-name-id
        lower-state
        (lower-global-shared-view entry-path)
        (lower-global-shared-view decl-path)
        module
        module-id
        source-id
        source-name)
      logical-id
      (lower-decl-logical-symbol-direct?
        entry-path
        decl-path
        logical-id
        source-id))))

(define (lower-name-env-add-module-extern-binding-id
  [state : CompilerLowerState]
  [names : LowerNameEnv]
  [_module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]
  [metadata : ast.AstExternMetadata]) : LowerNameEnv
  (let
    [logical-id : i64 (lower-module-name-key-id-by-id module-id source-id)]
    [symbol-id : i64
      (lower-extern-logical-symbol-id
        state
        logical-id
        source-name
        source-id
        metadata)]
    (lower-name-env-bind-ids
      (if (csym.compiler-symbol-root-module-id? module-id)
        source-id
        logical-id)
      logical-id
      symbol-id
      names)))

(cfg
  (any compile-profile test)
  (define (lower-name-env-add-module-extern-binding-id-profile
    [state : CompilerLowerState]
    [names : LowerNameEnv]
    [_module : String]
    [module-id : i64]
    [source-name : String]
    [source-id : i64]
    [metadata : ast.AstExternMetadata]) : LowerNameEnv
    (let
      [logical-id : i64 (lower-module-name-key-id-by-id module-id source-id)]
      [symbol-id : i64
        (lower-extern-logical-symbol-id
          state
          logical-id
          source-name
          source-id
          metadata)]
      (lower-name-env-bind-ids-profile
        state
        (if (csym.compiler-symbol-root-module-id? module-id)
          source-id
          logical-id)
        logical-id
        symbol-id
        names))))

(defmacro (lower-name-env-add-module-extern-binding-id-owned
  [_state : Expr]
  [names : Expr]
  [module : Expr]
  [module-id : Expr]
  [source-name : Expr]
  [source-id : Expr]
  [metadata : Expr]) : Expr
  (cfg
    (any compile-profile test)
    `(lower-name-env-add-module-extern-binding-id-profile
      ,_state
      ,names
      ,module
      ,module-id
      ,source-name
      ,source-id
      ,metadata)
    `(lower-name-env-add-module-extern-binding-id
      ,_state
      ,names
      ,module
      ,module-id
      ,source-name
      ,source-id
      ,metadata)))

(define (lower-name-env-add-struct-cleanup-in-module
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [cleanup : ast.AstStructCleanup]) : LowerNameEnv
  (match cleanup
    [(No) names]
    [(Fn cleanup-name)
      (let
        [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
        [cleanup-str : String (lower-name-id-text lower-state cleanup-name-id)]
        (lower-name-env-add-decl-module-binding-id
          lower-state
          names
          entry-path
          decl-path
          module
          module-id
          cleanup-str
          cleanup-name-id))]))

(define (lower-name-env-add-enum-cleanup-in-module
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [cleanup : ast.AstEnumCleanup]) : LowerNameEnv
  (match cleanup
    [(No) names]
    [(Fn cleanup-name)
      (let
        [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
        [cleanup-str : String (lower-name-id-text lower-state cleanup-name-id)]
        (lower-name-env-add-decl-module-binding-id
          lower-state
          names
          entry-path
          decl-path
          module
          module-id
          cleanup-str
          cleanup-name-id))]))

(define (lower-name-has-clone-prefix? [name : String]) : bool
  (let
    [source-name : String (tc_core.tc-hygiene-global-call-name name)]
    (if (>= (string.string-length source-name) 6)
      (string.eq (string.substring source-name 0 6) "clone$")
      false)))

(define (lower-resolve-name-id [state : LowerState] [source-id : i64]) : String
  (let
    [names : LowerNameCache (lower-state-names state)]
    (if (and (>= source-id 0) (< source-id (ci.intern-capacity)))
      (match (lower-name-cache-resolve-id-display
        (lower-global-shared-view names)
        source-id)
        [(Some logical-name) logical-name]
        [(No) (lower-name-cache-intern-str (& names) source-id)])
      (match (lower-name-cache-lookup-id
        (lower-global-shared-view names)
        source-id)
        [(Some logical-name) logical-name]
        [(No)
          (tc_core.tc-nominal-name-id-display-for-session
            (lower-name-cache-structural-session (& names))
            source-id)]))))

(define (lower-resolve-name-symbol-id [state : LowerState] [source-id : i64]) : i64
  (let
    [names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (lower-name-cache-resolve-logical-id (& names) source-id source-id)]
    [resolved-name : String (lower-resolve-name-id state source-id)]
    [symbol-id : i64
      (lower-name-cache-resolve-symbol-id (& names) source-id -1)]
    (if (>= symbol-id 0)
      symbol-id
      (lower-logical-symbol-id-select
        resolved-name
        logical-id
        (lower-logical-symbol-id-direct? logical-id source-id)))))

(define (lower-name-cache-ir-symbol
  [names : (& names LowerNameCache)]
  [logical-id : i64]
  [source-id : i64]
  [display-name : String]) : i64
  (lower-name-cache-lookup-symbol-id
    (& names)
    logical-id
    (lower-logical-symbol-id-select
      display-name
      logical-id
      (lower-logical-symbol-id-direct? logical-id source-id))))

(define (lower-decl-function-symbol-id
  [names : (& names LowerNameCache)]
  [logical-id : i64]
  [source-id : i64]
  [logical-name : String]) : i64
  (if (= logical-id cbi.compiler-builtin-id-fix-main)
    source-id
    (lower-name-cache-ir-symbol names logical-id source-id logical-name)))

(define (lower-tl-alloc-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-alloc)

(define (lower-tl-oob-abort-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-oob-abort)

(define (lower-tl-shift-abort-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-shift-abort)

(define (lower-tl-region-reset-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-region-reset)

(define (lower-tl-region-mark-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-region-mark)

(define (lower-tl-arena-set-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-arena-set)

(define (lower-tl-arena-current-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-arena-current)

(define (lower-tl-substring-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-substring)

(define (lower-tl-str-view-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-str-view)

(define (lower-tl-array-fill8-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-array-fill8)

(define (lower-tl-array-zero-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-array-zero)

(define (lower-tl-arena-make-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-arena-make)

(define (lower-tl-arena-destroy-symbol) : i64
  (cbi.compiler-builtin-refresh!)
  cbi.compiler-builtin-id-tl-arena-destroy)

(define (lower-resolve-call-name-id
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]) : i64
  (let
    [local? : bool (sym_i64_env.sym-i64-contains-id env source-id)]
    [state-names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (if local?
        source-id
        (lower-name-cache-resolve-logical-id
          (& state-names)
          source-id
          source-id))]
    [source-name : String
      (if (and (>= source-id 0) (< source-id (ci.intern-capacity)))
        (lower-name-cache-intern-str (& state-names) source-id)
        (tc_core.tc-nominal-name-id-display-for-session
          (lower-name-cache-structural-session (& state-names))
          source-id))]
    [resolved-name : String
      (if local?
        source-name
        (if (and (>= source-id 0) (< source-id (ci.intern-capacity)))
          (lower-resolve-name-id state source-id)
          (match (lower-name-cache-lookup-id
            (lower-global-shared-view state-names)
            source-id)
            [(Some logical-name) logical-name]
            [(No) source-name])))]
    [symbol-id : i64
      (if local?
        -1
        (lower-name-cache-resolve-symbol-id (& state-names) source-id -1))]
    (if (>= symbol-id 0)
      symbol-id
      (lower-logical-symbol-id-select
        resolved-name
        logical-id
        (lower-logical-symbol-id-direct? logical-id source-id)))))

(define (lower-resolve-call-name-id-with-display
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [display-name : String]) : i64
  (let
    [local? : bool (sym_i64_env.sym-i64-contains-id env source-id)]
    [state-names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (if local?
        source-id
        (lower-name-cache-resolve-logical-id
          (& state-names)
          source-id
          source-id))]
    [logical-display : String
      (if local?
        display-name
        (match (lower-name-cache-resolve-id-display
          (lower-global-shared-view state-names)
          source-id)
          [(Some resolved-name) resolved-name]
          [(No)
            (if (>= source-id (ci.intern-capacity))
              (tc_core.tc-env-key-display
                (lower-name-cache-structural-session (& state-names))
                source-id)
              display-name)]))]
    [symbol-id : i64
      (if local?
        -1
        (lower-name-cache-resolve-symbol-id (& state-names) source-id -1))]
    (if (>= symbol-id 0)
      symbol-id
      (lower-logical-symbol-id-select
        logical-display
        logical-id
        (lower-logical-symbol-id-direct? logical-id source-id)))))

(define (lower-path-separator? [c : char]) : bool
  (or (= c '/') (= c '\\')))

(define (lower-path-drive-qualified? [path : (& path str)]) : bool
  (let
    [n : i64 (string.string-length path)]
    (and (> n 1) (= (cast (string.string-ref path 1) : i64) (cast ':' : i64)))))

(define (lower-dirname [path : String]) : String
  (let
    [n : i64 (string.string-length path)]
    [i : i64 0]
    [last : i64 -1]
    (while (< i n)
      (if (lower-path-separator? (string.string-ref path i))
        (set! last i)
        (set! last last))
      (set! i (+ i 1)))
    (if (< last 0)
      ""
      (string.substring path 0 (+ last 1)))))

;; Join segments with '/' in one linear text-buf build. A fold-with-append
;; copies the whole accumulated prefix on every segment (quadratic in rendered
;; length), and this runs once per normalized path.
(define (lower-path-segment-vec-render [segments : svec.Vec]) : String
  (let
    [count : i64 (svec.len (& segments))]
    (if (<= count 1)
      (svec.get (& segments) 0 "")
      (let
        [buf : text_buf.TextBuf
          (text_buf.append (text_buf.empty) (svec.get (& segments) 0 ""))]
        [i : i64 1]
        (while (< i count)
          (set!
            buf
            (text_buf.append
              (text_buf.append buf "/")
              (svec.get (& segments) i "")))
          (set! i (+ i 1)))
        (text_buf.render buf)))))

(define (lower-path-normalize-segment
  [segment : String]
  [segments : (&mut segments svec.Vec)]
  [rooted : bool]) : unit
  (cond
    [(string.eq segment "") unit]
    [(string.eq segment ".") unit]
    [(not (string.eq segment "..")) (svec.push-ref! segments segment)]
    [(<= (svec.len (& segments)) 0)
      (if rooted
        unit
        (svec.push-ref! segments segment))]
    [else
      (let
        [top : String (svec.last (& segments) "")]
        (if (string.eq top "..")
          (svec.push-ref! segments segment)
          (match (svec.pop-ref! segments)
            [(Ok _) unit]
            [Empty unit])))]))

(define (lower-path-canonical? [path : (& path str)]) : bool
  (let
    [n : i64 (string.string-length path)]
    [i : i64 0]
    [segment-start : i64 0]
    [ok : bool (> n 0)]
    (while (and ok (< i n))
      (let
        [c : char (string.string-ref path i)]
        (cond
          [(= c '\\') (set! ok false)]
          [(= c '/')
            (let
              [segment-len : i64 (- i segment-start)]
              (if (and (= segment-len 0) (not (= i 0)))
                (set! ok false)
                unit)
              (if (and
                (= segment-len 1)
                (= (string.string-ref path segment-start) '.'))
                (set! ok false)
                unit)
              (if (and
                (= segment-len 2)
                (= (string.string-ref path segment-start) '.')
                (= (string.string-ref path (+ segment-start 1)) '.'))
                (set! ok false)
                unit)
              (set! segment-start (+ i 1)))]
          [else unit])
        (set! i (+ i 1))))
    (if (not ok)
      false
      (let
        [segment-len : i64 (- n segment-start)]
        (cond
          [(= segment-len 0)
            (or (= n 1) (and (= n 3) (lower-path-drive-qualified? path)))]
          [(and
              (= segment-len 1)
              (= (string.string-ref path segment-start) '.'))
            false]
          [(and
              (= segment-len 2)
              (= (string.string-ref path segment-start) '.')
              (= (string.string-ref path (+ segment-start 1)) '.'))
            false]
          [else true])))))

;; --- proven-canonical path memo ---------------------------------------
;; lower-normalize-path returns its argument unchanged when the path is
;; already canonical, and that is what nearly every module path of a normal
;; compile is. The asks come one per declaration per lowering walk over the
;; program's few distinct module paths, so lower-path-canonical? would keep
;; re-reading the same strings byte by byte.
;; Remembering which path strings are already proven canonical answers the
;; repeats with a length compare instead of a scan.
;;
;; Two slots, because both decl-level callers (lower-decl-entry-path? and
;; lower-module-id) normalize the fixed entry path and the current decl path
;; back to back, and the pair only changes at a module boundary. A remembered
;; path is only ever used as a comparison key -- lower-normalize-path returns
;; the caller's own argument on a hit -- so nothing here extends a String's
;; lifetime past the call that supplied it, and the lower job reset drops
;; the keys with the rest of the per-file lowering state.
(define (lower-canonical-path-recent-current [lower-state : CompilerLowerState]) : String
  (compiler-lower-state-read lower-state String canonical-path-recent))

(define (lower-canonical-path-prior-current [lower-state : CompilerLowerState]) : String
  (compiler-lower-state-read lower-state String canonical-path-prior))

(define (lower-canonical-path-recent-set!
  [lower-state : CompilerLowerState]
  [path : String]) : unit
  (compiler-lower-state-write! lower-state String canonical-path-recent path))

(define (lower-canonical-path-prior-set!
  [lower-state : CompilerLowerState]
  [path : String]) : unit
  (compiler-lower-state-write! lower-state String canonical-path-prior path))

(define (lower-canonical-path-memo-reset! [lower-state : CompilerLowerState]) : unit
  (compiler-lower-state-write! lower-state i64 canonical-path-count 0)
  (lower-canonical-path-recent-set! lower-state "")
  (lower-canonical-path-prior-set! lower-state ""))

(define (lower-canonical-path-remembered?
  [lower-state : CompilerLowerState]
  [path : (& path str)]) : bool
  (if (and
    (>= (compiler-lower-state-read lower-state i64 canonical-path-count) 1)
    (string.eq (lower-canonical-path-recent-current lower-state) path))
    true
    (and
      (>= (compiler-lower-state-read lower-state i64 canonical-path-count) 2)
      (string.eq (lower-canonical-path-prior-current lower-state) path))))

(define (lower-canonical-path-remember!
  [lower-state : CompilerLowerState]
  [path : String]) : unit
  (let
    [count : i64
      (compiler-lower-state-read lower-state i64 canonical-path-count)]
    (lower-canonical-path-prior-set!
      lower-state
      (lower-canonical-path-recent-current lower-state))
    (lower-canonical-path-recent-set! lower-state path)
    (if (< count 2)
      (compiler-lower-state-write!
        lower-state
        i64
        canonical-path-count
        (+ count 1))
      unit)))

(define (lower-path-known-canonical?
  [lower-state : CompilerLowerState]
  [path : String]) : bool
  (if (lower-canonical-path-remembered? lower-state path)
    true
    (if (lower-path-canonical? path)
      (begin
        (lower-canonical-path-remember! lower-state path)
        true)
      false)))

(define (lower-normalize-path
  [lower-state : CompilerLowerState]
  [path : String]) : String
  (if (lower-path-known-canonical? lower-state (lower-global-shared-view path))
    path
    (let
      [n : i64 (string.string-length path)]
      [drive-root : bool
        (if (> n 2)
          (if (lower-path-drive-qualified? path)
            (lower-path-separator? (string.string-ref path 2))
            false)
          false)]
      [rooted : bool
        (if drive-root
          true
          (if (> n 0)
            (lower-path-separator? (string.string-ref path 0))
            false))]
      [i : i64
        (if drive-root
          3
          (if rooted
            1
            0))]
      [segment-start : i64 i]
      [segments : svec.Vec (svec.new)]
      (while (< i n)
        (if (lower-path-separator? (string.string-ref path i))
          (begin
            (lower-path-normalize-segment
              (string.substring path segment-start (- i segment-start))
              (&mut segments)
              rooted)
            (set! segment-start (+ i 1)))
          (set! segment-start segment-start))
        (set! i (+ i 1)))
      (lower-path-normalize-segment
        (string.substring path segment-start (- n segment-start))
        (&mut segments)
        rooted)
      (let
        [body : String (lower-path-segment-vec-render segments)]
        (cond
          [(if drive-root
              (= (string.string-length body) 0)
              false)
            (str_cat.str-cat (string.substring path 0 2) "/")]
          [drive-root (str_cat.str-cat (string.substring path 0 2) "/" body)]
          [(if rooted
              (= (string.string-length body) 0)
              false)
            "/"]
          [rooted (str_cat.str-cat "/" body)]
          [(= (string.string-length body) 0) "."]
          [else body])))))

(define (lower-string-prefix-at?
  [text : String]
  [prefix : String]
  [start : i64]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< start 0)
      false
      (if (> (+ start prefix-len) text-len)
        false
        (let
          [i : i64 0]
          [ok : bool true]
          (while ok
            (if (< i prefix-len)
              (if (=
                (cast (string.string-ref text (+ start i)) : i64)
                (cast (string.string-ref prefix i) : i64))
                (set! i (+ i 1))
                (set! ok false))
              (set! ok false)))
          (= i prefix-len))))))

(define (lower-module-id
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]) : String
  (let
    [entry-path : String (lower-normalize-path lower-state entry-path)]
    ;; A stdlib module a root resolved names itself `stdlib/<suffix>`, as the
    ;; embedded payload does, wherever the root lies relative to the cwd.
    [decl-path : String
      (lower-normalize-path
        lower-state
        (load.compiler-load-canonical-stdlib-path decl-path))]
    [base : String (lower-dirname entry-path)]
    [base-len : i64 (string.string-length base)]
    [decl-len : i64 (string.string-length decl-path)]
    (if (and
      (> base-len 0)
      (lower-string-prefix-at? (lower-global-shared-view decl-path) base 0))
      (string.substring decl-path base-len (- decl-len base-len))
      decl-path)))

(define (lower-module-logical-name
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [source-name : String]) : String
  (if (and
    (string.eq source-name "main")
    (string.eq
      (lower-normalize-path lower-state (lower-global-shared-view decl-path))
      (lower-normalize-path lower-state (lower-global-shared-view entry-path))))
    "main"
    (str_cat.str-cat
      (lower-module-id lower-state entry-path decl-path)
      "::"
      source-name)))

(define (lower-entry-main-module-active-current
  [lower-state : CompilerLowerState]) : bool
  (compiler-lower-state-read lower-state bool entry-main-module-active))

(define (lower-entry-main-module-current [lower-state : CompilerLowerState]) : String
  (compiler-lower-state-read lower-state String entry-main-module))

(define (lower-entry-main-module-set!
  [lower-state : CompilerLowerState]
  [module : String]) : unit
  (compiler-lower-state-write! lower-state String entry-main-module module))

(define (lower-entry-main-module-id-current [lower-state : CompilerLowerState]) : i64
  (compiler-lower-state-read lower-state i64 entry-main-module-id))

(define (lower-entry-main-module-match?
  [lower-state : CompilerLowerState]
  [module : String]) : bool
  (if (compiler-lower-state-read lower-state bool entry-main-module-active)
    (string.eq module (lower-entry-main-module-current lower-state))
    (or (string.eq module "") (string.eq module "main"))))

(define (lower-decl-entry-main?
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [source-name : String]) : bool
  (and
    (string.eq source-name "main")
    (lower-entry-main-module-match? lower-state module)
    (string.eq
      (lower-normalize-path lower-state decl-path)
      (lower-normalize-path lower-state entry-path))))

(define (lower-decl-logical-id
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]) : i64
  (if (lower-decl-entry-main?
    lower-state
    entry-path
    decl-path
    module
    source-name)
    cbi.compiler-builtin-id-fix-main
    (lower-module-name-key-id-by-id module-id source-id)))

(define (lower-decl-entry-path?
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]) : bool
  (or
    (string.eq entry-path decl-path)
    (string.eq
      (lower-normalize-path lower-state entry-path)
      (lower-normalize-path lower-state decl-path))))

(define (lower-decl-logical-symbol-direct?
  [_ : String]
  [_ : String]
  [logical-id : i64]
  [_ : i64]) : bool
  (= logical-id cbi.compiler-builtin-id-fix-main))

(define (lower-decl-owner-module-id
  [lower-state : CompilerLowerState]
  [paths : (& paths ast.AstDeclPathList)]
  [index : i64]
  [entry-path : String]
  [decl-path : String]
  [source-module-id : i64]) : i64
  (if (or
    (not (csym.compiler-symbol-root-module-id? source-module-id))
    (lower-decl-entry-path? lower-state entry-path decl-path))
    source-module-id
    (ast.ast-decl-path-list-owner-id paths index source-module-id)))

;; Mixed AST/name fields may carry ordinary intern-pool IDs or table-backed
;; macro-hygiene identities. Lowering owns the explicit source/structural-name
;; session needed to render either domain without treating an opaque handle as
;; a pool index.
(define (lower-name-id-text-for-session
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : String
  (tc_core.tc-env-key-name-text-for-session session name-id))

(define (lower-name-id-text [lower-state : CompilerLowerState] [name-id : i64]) : String
  (lower-name-id-text-for-session
    (compiler-lower-state-structural-session lower-state)
    name-id))

(define (lower-decl-owner-module-name
  [lower-state : CompilerLowerState]
  [source-module-id : i64]
  [owner-module-id : i64]) : String
  (let
    [interns : ci.InternCompatState (compiler-lower-state-interns lower-state)]
    (if (and
      (not (= source-module-id owner-module-id))
      (ci.intern-compat-state-generated-id-active? (& interns) owner-module-id))
      ""
      (lower-name-id-text lower-state owner-module-id))))

(cfg
  test
  (test
    lower-decl-owner-module-name-structural
    (let
      [installed : ci.InternCompatState (ci.intern-compat-state-capture-active)]
      [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
      [source-name-id : i64
        (ci.intern-compat-state-intern
          (&mut intern-state)
          "lower-structural-module")]
      [_install : unit (ci.intern-compat-state-install! intern-state)]
      [lower-state : CompilerLowerState
        (compiler-lower-state-new-with-intern-state intern-state)]
      [owner-module-id : i64
        (cis.intern-macro-global-identity-raw
          (cis.intern-structural-session-macro-global-identity
            (compiler-lower-state-structural-session lower-state)
            Context
            cbi.compiler-builtin-id-fix-empty
            source-name-id))]
      [ok : bool
        (string.eq
          (lower-decl-owner-module-name
            lower-state
            cbi.compiler-builtin-id-fix-empty
            owner-module-id)
          "lower-structural-module")]
      (ci.intern-compat-state-install! installed)
      (if ok
        unit
        (io.panic "lower: structural owner module name smoke failed")))))

(define (lower-entry-main-decl? [decl : ast.AstDecl]) : bool
  (match decl
    [(Def decl-meta name _ _) (= name cbi.compiler-builtin-id-fix-main)]
    [(DefFn decl-meta name _ _ _ _) (= name cbi.compiler-builtin-id-fix-main)]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-entry-main-decl? inner))]
    [_ false]))

(define (lower-entry-main-scan-add
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [scan : LowerEntryMainScan]) : LowerEntryMainScan
  (match (lower-global-shared-view scan)
    [(Scan fallback-count fallback-module fallback-module-id preferred)
      (if (and
        (lower-entry-main-decl? decl)
        (string.eq
          (lower-normalize-path lower-state decl-path)
          (lower-normalize-path lower-state entry-path)))
        (if (or (string.eq module "") (string.eq module "main"))
          (Scan fallback-count fallback-module fallback-module-id true)
          (Scan (+ fallback-count 1) module module-id preferred))
        scan)]))

(define (lower-entry-main-scan-decls-in-module
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [scan : LowerEntryMainScan]
  [module : String]
  [module-id : i64]) : LowerEntryMainScan
  (match (ast.ast-decl-list-step decls)
    [(Nil) scan]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(Cons path _) path]
            [(Nil) (owned_view.compiler-owned-shared-view entry-path)])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(Cons _ path-rest)
              (let
                [path-rest : ast.AstDeclPathList path-rest]
                path-rest)]
            [(Nil) (ast.ast-decl-path-list-new)])]
        (match (lower-global-shared-view decl)
          [(Module next-module)
            (lower-entry-main-scan-decls-in-module
              lower-state
              rest
              rest-paths
              entry-path
              scan
              (lower-name-id-text lower-state next-module)
              next-module)]
          [_
            (lower-entry-main-scan-decls-in-module
              lower-state
              rest
              rest-paths
              (lower-global-shared-view entry-path)
              (lower-entry-main-scan-add
                lower-state
                entry-path
                decl-path
                (lower-global-shared-view module)
                module-id
                decl
                scan)
              module
              module-id)]))]))

(define (lower-entry-main-scan-selection [scan : LowerEntryMainScan]) : LowerMaybeEntryMainModule
  (match scan
    [(Scan fallback-count fallback-module fallback-module-id preferred)
      (if preferred
        (No)
        (if (= fallback-count 1)
          (Some fallback-module fallback-module-id)
          (No)))]))

(define (lower-entry-main-selection-for-program
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]) : LowerMaybeEntryMainModule
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (deref decls-box)]
        (lower-entry-main-scan-selection
          (lower-entry-main-scan-decls-in-module
            lower-state
            decls
            paths
            entry-path
            (Scan 0 "" cbi.compiler-builtin-id-fix-empty false)
            ""
            cbi.compiler-builtin-id-fix-empty)))]))

(define (lower-entry-main-selection-install!
  [lower-state : CompilerLowerState]
  [selection : LowerMaybeEntryMainModule]) : unit
  (match selection
    [(No)
      (compiler-lower-state-write!
        lower-state
        bool
        entry-main-module-active
        false)
      (lower-entry-main-module-set! lower-state "")
      (compiler-lower-state-write!
        lower-state
        i64
        entry-main-module-id
        cbi.compiler-builtin-id-fix-empty)]
    [(Some module module-id)
      (compiler-lower-state-write!
        lower-state
        bool
        entry-main-module-active
        true)
      (lower-entry-main-module-set! lower-state module)
      (compiler-lower-state-write!
        lower-state
        i64
        entry-main-module-id
        module-id)]))

(define (lower-entry-main-selection-restore!
  [lower-state : CompilerLowerState]
  [active : bool]
  [module : String]
  [module-id : i64]) : unit
  (compiler-lower-state-write! lower-state bool entry-main-module-active active)
  (lower-entry-main-module-set! lower-state module)
  (compiler-lower-state-write! lower-state i64 entry-main-module-id module-id))

(define (lower-entry-main-logical-id
  [all-functions : (& all-functions lower_i64_i64_map.Map)]) : i64
  (if (lower_i64_i64_map.contains?
    (& all-functions)
    cbi.compiler-builtin-id-fix-main)
    cbi.compiler-builtin-id-fix-main
    -1))

(define (lower-decl-logical-name-display
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]) : String
  (let
    [logical-id : i64
      (lower-decl-logical-id
        lower-state
        (lower-global-shared-view entry-path)
        (lower-global-shared-view decl-path)
        (lower-global-shared-view module)
        module-id
        source-id
        (lower-global-shared-view source-name))]
    (if (= logical-id cbi.compiler-builtin-id-fix-main)
      "main"
      (if (string.eq module "")
        (lower-module-logical-name lower-state entry-path decl-path source-name)
        (lower-module-logical-name
          lower-state
          entry-path
          decl-path
          (csym.compiler-symbol-module-key module source-name))))))

(define (lower-decl-logical-name-id
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]) : String
  (let
    [logical-id : i64
      (lower-decl-logical-id
        lower-state
        (lower-global-shared-view entry-path)
        (lower-global-shared-view decl-path)
        (lower-global-shared-view module)
        module-id
        source-id
        (lower-global-shared-view source-name))]
    (lower-logical-display-name-select
      lower-state
      (lower-decl-logical-name-display
        lower-state
        (lower-global-shared-view entry-path)
        (lower-global-shared-view decl-path)
        module
        module-id
        source-id
        source-name)
      logical-id
      (lower-decl-logical-symbol-direct?
        entry-path
        decl-path
        logical-id
        source-id))))

(define (lower-current-decl-logical-name-cache-id
  [names : (& names LowerNameCache)]
  [module : String]
  [source-name : String]
  [source-id : i64]) : String
  (let
    [key-id : i64 (lower-module-name-key-id-by-id names.module-id source-id)]
    [symbol-id : i64 (lower-name-cache-lookup-symbol-id (& names) key-id -1)]
    ;; `compiler-symbol-module-key` is a pure render (no interning), and the two
    ;; branches above it discard the result. Building it eagerly allocated a
    ;; module-key string for every cache hit; render only where it is returned.
    (if (>= symbol-id 0)
      (ir.compiler-ir-symbol-text symbol-id)
      (if (and (string.eq module "main") (string.eq source-name "main"))
        "main"
        (csym.compiler-symbol-module-key module source-name)))))

(define (lower-name-env-add-decl-in-module
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match decl
    [(Def decl-meta name _ _)
      (let
        [name-str : String (lower-name-id-text lower-state name)]
        (lower-name-env-add-decl-module-binding-id
          lower-state
          names
          entry-path
          decl-path
          module
          module-id
          name-str
          name))]
    [(DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (lower-name-id-text lower-state name)]
        (lower-name-env-add-decl-module-binding-id
          lower-state
          names
          entry-path
          decl-path
          module
          module-id
          name-str
          name))]
    [(DefDispatch decl-meta name _)
      (let
        [name-str : String (lower-name-id-text lower-state name)]
        (lower-name-env-add-decl-module-binding-id
          lower-state
          names
          entry-path
          decl-path
          module
          module-id
          name-str
          name))]
    [(Extern decl-meta name _ metadata _)
      ;; Calls resolve through the local declaration name; backend metadata owns
      ;; the exact external linker symbol.
      (let
        [name-str : String (lower-name-id-text lower-state name)]
        (lower-name-env-add-module-extern-binding-id-owned
          lower-state
          names
          module
          module-id
          name-str
          name
          (deref metadata)))]
    [(DefEnum decl-meta _ cleanup _)
      (lower-name-env-add-enum-cleanup-in-module
        lower-state
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(DefEnumLifetimes decl-meta _ _ cleanup _)
      (lower-name-env-add-enum-cleanup-in-module
        lower-state
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(DefStruct decl-meta _ _ cleanup _)
      (lower-name-env-add-struct-cleanup-in-module
        lower-state
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(DefStructLifetimes decl-meta _ _ _ cleanup _)
      (lower-name-env-add-struct-cleanup-in-module
        lower-state
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-name-env-add-decl-in-module
          lower-state
          names
          entry-path
          decl-path
          module
          module-id
          inner))]
    [_ names]))

(define (lower-decl-lexical-binding-id [decl : ast.AstDecl]) : LowerNameCacheMaybeId
  (match decl
    [(Def decl-meta name _ _) (Some name)]
    [(DefFn decl-meta name _ _ _ _) (Some name)]
    [(DefDispatch decl-meta name _) (Some name)]
    [(Extern decl-meta name _ _ _) (Some name)]
    [(DefEnum decl-meta _ cleanup _)
      (match cleanup
        [(Fn name) (Some (ci.intern-syntax-id-value name))]
        [(No) (No)])]
    [(DefEnumLifetimes decl-meta _ _ cleanup _)
      (match cleanup
        [(Fn name) (Some (ci.intern-syntax-id-value name))]
        [(No) (No)])]
    [(DefStruct decl-meta _ _ cleanup _)
      (match cleanup
        [(Fn name) (Some (ci.intern-syntax-id-value name))]
        [(No) (No)])]
    [(DefStructLifetimes decl-meta _ _ _ cleanup _)
      (match cleanup
        [(Fn name) (Some (ci.intern-syntax-id-value name))]
        [(No) (No)])]
    [(Unsafe inner-box) (lower-decl-lexical-binding-id (deref inner-box))]
    [_ (No)]))

;; A path-loaded file remains in the lexical root namespace even though its
;; emitted declarations use the file/module owner ID. Preserve both keys: the
;; parser ID resolves unqualified source references, while the owner pair is the
;; stable backend/reachability identity.
(define (lower-name-env-add-root-alias-from-latest
  [names : LowerNameEnv]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match (lower-decl-lexical-binding-id decl)
    [(No) names]
    [(Some source-id)
      (match (lower-name-env-view (lower-global-shared-view names))
        [(Bind _ logical-id symbol-id _)
          (lower-name-env-bind-ids source-id logical-id symbol-id names)]
        [(Nil) names])]))

(cfg
  (any compile-profile test)
  (define (lower-name-env-add-root-alias-from-latest-profile
    [state : CompilerLowerState]
    [names : LowerNameEnv]
    [decl : ast.AstDecl]) : LowerNameEnv
    (match (lower-decl-lexical-binding-id decl)
      [(No) names]
      [(Some source-id)
        (match (lower-name-env-view (lower-global-shared-view names))
          [(Bind _ logical-id symbol-id _)
            (lower-name-env-bind-ids-profile
              state
              source-id
              logical-id
              symbol-id
              names)]
          [(Nil) names])])))

(defmacro (lower-name-env-add-root-alias-from-latest-owned
  [_state : Expr]
  [names : Expr]
  [decl : Expr]) : Expr
  (cfg
    (any compile-profile test)
    `(lower-name-env-add-root-alias-from-latest-profile ,_state ,names ,decl)
    `(lower-name-env-add-root-alias-from-latest ,names ,decl)))

(define (lower-name-env-from-decls-with-state
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]) : LowerNameEnv
  (let
    [base : LowerNameEnv
      (lower-name-env-from-decls-in-module
        lower-state
        (lower-global-shared-view decls)
        paths
        (lower-global-shared-view entry-path)
        names
        ""
        cbi.compiler-builtin-id-fix-empty)]
    (lower-name-env-with-import-aliases
      lower-state
      decls
      paths
      entry-path
      base
      true)))

(define (lower-name-env-from-decls-in-module
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [paths : (& paths ast.AstDeclPathList)]
  [entry-path : String]
  [names : LowerNameEnv]
  [_module : String]
  [module-id : i64]) : LowerNameEnv
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 module-id]
    (while (< index count)
      (let
        [decl : ast.AstDecl
          (lower-global-array-element-shared-view
            decls.slots
            (+ decls.offset index))]
        [decl-path : String
          (ast.ast-decl-path-list-get
            (& paths)
            index
            (lower-global-shared-view entry-path))]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            lower-state
            (& paths)
            index
            (lower-global-shared-view entry-path)
            (lower-global-shared-view decl-path)
            cur-module-id)]
        (match (lower-global-shared-view decl)
          [(Def decl-meta _ _ _) unit]
          [_ unit])
        (match (lower-global-shared-view decl)
          [(Module next-module) (set! cur-module-id next-module)]
          [_
            (let
              [owner-names : LowerNameEnv
                (lower-name-env-add-decl-in-module
                  lower-state
                  (lower-global-shared-view cur-names)
                  (lower-global-shared-view entry-path)
                  decl-path
                  (lower-decl-owner-module-name
                    lower-state
                    cur-module-id
                    logical-module-id)
                  logical-module-id
                  (lower-global-shared-view decl))]
              (set!
                cur-names
                (if (and
                  (csym.compiler-symbol-root-module-id? cur-module-id)
                  (not (csym.compiler-symbol-root-module-id? logical-module-id)))
                  (lower-name-env-add-root-alias-from-latest-owned
                    lower-state
                    owner-names
                    decl)
                  owner-names)))])
        (set! index (+ index 1))))
    cur-names))

(define (lower-name-env-add-clone-decl-in-module-inner
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [roots : clone_support.CloneRootEntries]
  [bind-syntax? : bool]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match decl
    [(DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (lower-name-id-text lower-state name)]
        (if (lower-name-has-clone-prefix? (lower-global-shared-view name-str))
          (lower-name-env-add-decl-module-binding-id
            lower-state
            names
            entry-path
            decl-path
            module
            module-id
            name-str
            name)
          names))]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-name-env-add-clone-decl-in-module
          lower-state
          names
          roots
          bind-syntax?
          entry-path
          decl-path
          module
          module-id
          inner))]
    [_ names]))

(define (lower-name-env-add-clone-decl-in-module
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [roots : clone_support.CloneRootEntries]
  [bind-syntax? : bool]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match (ast.ast-decl-generated-meta decl)
    [(Some generator item _ _)
      (if (string.eq generator "stdlib.clone/synthesize-helpers")
        (match (ast.ast-decl-unwrapped decl)
          [(DefFn decl-meta name _ _ _ _)
            (let
              [with-syntax-id : LowerNameEnv
                (if bind-syntax?
                  (lower-name-env-add-decl-module-binding-id
                    lower-state
                    names
                    entry-path
                    decl-path
                    module
                    module-id
                    item
                    name)
                  names)]
              [root-key-id : i64
                (lower-clone-handoff-source-helper-root-id
                  lower-state
                  name
                  module-id
                  roots)]
              (if (>= root-key-id 0)
                (let
                  [helper-id : i64
                    (clone_support.clone-root-entries-helper-id-or
                      roots
                      root-key-id
                      -1)]
                  [syntax-key-id : i64
                    (lower-module-name-key-id-by-id module-id name)]
                  [logical-id : i64
                    (lower-name-env-lookup-logical-id
                      (lower-global-shared-view with-syntax-id)
                      syntax-key-id
                      -1)]
                  [symbol-id : i64
                    (lower-name-env-lookup-symbol-id-owned
                      lower-state
                      (lower-global-shared-view with-syntax-id)
                      syntax-key-id
                      -1)]
                  ;; Alias the role handle to the declaration's exact
                  ;; logical/symbol identity. Recomputing from helper-id would
                  ;; create a second IR symbol for the same helper.
                  (if (and (>= logical-id 0) (>= symbol-id 0))
                    (lower-name-env-bind-logical-symbol-id-owned
                      lower-state
                      (lower-module-name-key-id-by-id module-id helper-id)
                      logical-id
                      symbol-id
                      with-syntax-id)
                    with-syntax-id))
                with-syntax-id))]
          [_ names])
        (lower-name-env-add-clone-decl-in-module-inner
          lower-state
          names
          roots
          bind-syntax?
          entry-path
          decl-path
          module
          module-id
          decl))]
    [(No)
      (lower-name-env-add-clone-decl-in-module-inner
        lower-state
        names
        roots
        bind-syntax?
        entry-path
        decl-path
        module
        module-id
        decl)]))

(define (lower-name-env-add-clone-decls-in-module
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [paths : (& paths ast.AstDeclPathList)]
  [entry-path : String]
  [names : LowerNameEnv]
  [roots : clone_support.CloneRootEntries]
  [bind-syntax? : bool]
  [initial-module-id : i64]) : LowerNameEnv
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 initial-module-id]
    ;; Match the backing slot rather than binding the row to a local first: the
    ;; local materialised a 104 B copy, while a projection match loads the tag
    ;; and hands the slot straight on (aggregate arguments pass by reference).
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [decl-offset : i64 decls.offset]
    (while (< index count)
      (let
        [decl-path : String (ast.ast-decl-path-list-get (& paths) index "")]
        (match (lower-global-array-element-shared-view
          decl-slots
          (+ decl-offset index))
          [(Module next-module) (set! cur-module-id next-module)]
          [_
            (set!
              cur-names
              (lower-name-env-add-clone-decl-in-module
                lower-state
                cur-names
                roots
                bind-syntax?
                (lower-global-shared-view entry-path)
                decl-path
                (compiler-lower-state-name-text lower-state cur-module-id)
                cur-module-id
                (lower-global-array-element-shared-view
                  decl-slots
                  (+ decl-offset index))))])
        (set! index (+ index 1))))
    cur-names))

(define (lower-name-env-add-clone-decls
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [paths : (& paths ast.AstDeclPathList)]
  [entry-path : String]
  [names : LowerNameEnv]
  [roots : clone_support.CloneRootEntries]
  [bind-syntax? : bool]) : LowerNameEnv
  (lower-name-env-add-clone-decls-in-module
    lower-state
    decls
    paths
    entry-path
    names
    roots
    bind-syntax?
    cbi.compiler-builtin-id-fix-empty))

(define (lower-alias-logical-name-id
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]
  [path-aware : bool]) : String
  (if path-aware
    (lower-decl-logical-name-id
      lower-state
      entry-path
      decl-path
      module
      module-id
      source-id
      source-name)
    (csym.compiler-symbol-module-key module source-name)))

(define (lower-alias-logical-symbol-direct?
  [entry-path : String]
  [decl-path : String]
  [logical-id : i64]
  [source-id : i64]
  [path-aware : bool]) : bool
  (if path-aware
    (lower-decl-logical-symbol-direct?
      entry-path
      decl-path
      logical-id
      source-id)
    (lower-logical-symbol-id-direct? logical-id source-id)))

(define (lower-import-alias-key-id [importer-module-id : i64] [alias-id : i64]) : i64
  (if (= alias-id cbi.compiler-builtin-id-fix-empty)
    importer-module-id
    alias-id))

(define (lower-name-env-add-decl-alias-in-module
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [position : i64]
  [entry-path : String]
  [decl-path : String]
  [alias : String]
  [alias-id : i64]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [path-aware : bool]) : LowerNameEnv
  (match decl
    [(Def decl-meta name _ _)
      (let
        [name-str : String (lower-name-id-text lower-state name)]
        (lower-name-env-add-decl-import-alias-binding-base-id
          lower-state
          names
          position
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          name-str
          name
          path-aware))]
    [(DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (lower-name-id-text lower-state name)]
        (lower-name-env-add-decl-import-alias-binding-base-id
          lower-state
          names
          position
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          name-str
          name
          path-aware))]
    [(DefDispatch decl-meta name _)
      (let
        [name-str : String (lower-name-id-text lower-state name)]
        (lower-name-env-add-decl-import-alias-binding-base-id
          lower-state
          names
          position
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          name-str
          name
          path-aware))]
    [(Extern decl-meta name _ metadata _)
      (let
        [name-str : String (lower-name-id-text lower-state name)]
        [logical-id : i64 (lower-module-name-key-id-by-id module-id name)]
        (lower-name-env-add-import-alias-binding-base-symbol-id
          lower-state
          names
          alias
          alias-id
          (lower-global-shared-view name-str)
          name
          logical-id
          (lower-global-shared-view name-str)
          (lower-extern-logical-symbol-id
            lower-state
            logical-id
            name-str
            name
            (deref metadata))))]
    [(DefEnum decl-meta _ cleanup _)
      (match cleanup
        [(No) names]
        [(Fn cleanup-name)
          (let
            [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
            [cleanup-str : String
              (lower-name-id-text lower-state cleanup-name-id)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              lower-state
              names
              position
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name-id
              path-aware))])]
    [(DefEnumLifetimes decl-meta _ _ cleanup _)
      (match cleanup
        [(No) names]
        [(Fn cleanup-name)
          (let
            [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
            [cleanup-str : String
              (lower-name-id-text lower-state cleanup-name-id)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              lower-state
              names
              position
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name-id
              path-aware))])]
    [(DefStruct decl-meta _ _ cleanup _)
      (match cleanup
        [(No) names]
        [(Fn cleanup-name)
          (let
            [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
            [cleanup-str : String
              (lower-name-id-text lower-state cleanup-name-id)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              lower-state
              names
              position
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name-id
              path-aware))])]
    [(DefStructLifetimes decl-meta _ _ _ cleanup _)
      (match cleanup
        [(No) names]
        [(Fn cleanup-name)
          (let
            [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
            [cleanup-str : String
              (lower-name-id-text lower-state cleanup-name-id)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              lower-state
              names
              position
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name-id
              path-aware))])]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-name-env-add-decl-alias-in-module
          lower-state
          names
          position
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          inner
          path-aware))]
    [_ names]))

(define (lower-name-env-add-decl-alias-in-module-cache
  [names : LowerNameEnv]
  [base-cache : (& base-cache LowerNameCache)]
  [dedup-base : bool]
  [alias : (& alias str)]
  [alias-id : i64]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match decl
    [(Def decl-meta name _ _)
      (let
        [name-str : String
          (lower-name-id-text
            (compiler-lower-state-from-name-cache base-cache)
            name)]
        (lower-name-env-add-import-alias-binding-base-cache-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          (lower-global-shared-view name-str)
          name
          (lower-module-name-key-id-by-id module-id name)
          module
          name-str
          name))]
    [(DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String
          (lower-name-id-text
            (compiler-lower-state-from-name-cache base-cache)
            name)]
        (lower-name-env-add-import-alias-binding-base-cache-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          (lower-global-shared-view name-str)
          name
          (lower-module-name-key-id-by-id module-id name)
          module
          name-str
          name))]
    [(DefDispatch decl-meta name _)
      (let
        [name-str : String
          (lower-name-id-text
            (compiler-lower-state-from-name-cache base-cache)
            name)]
        (lower-name-env-add-import-alias-binding-base-cache-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          (lower-global-shared-view name-str)
          name
          (lower-module-name-key-id-by-id module-id name)
          module
          name-str
          name))]
    [(Extern decl-meta name _ metadata _)
      (let
        [name-str : String
          (lower-name-id-text
            (compiler-lower-state-from-name-cache base-cache)
            name)]
        [logical-id : i64 (lower-module-name-key-id-by-id module-id name)]
        (lower-name-env-add-import-alias-binding-base-cache-symbol-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          (lower-global-shared-view name-str)
          name
          logical-id
          (lower-global-shared-view name-str)
          (lower-extern-logical-symbol-id
            (lower-name-cache-owner-state (& base-cache))
            logical-id
            name-str
            name
            (deref metadata))))]
    [(DefEnum decl-meta _ cleanup _)
      (match cleanup
        [(No) names]
        [(Fn cleanup-name)
          (let
            [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
            [cleanup-str : String
              (lower-name-id-text
                (compiler-lower-state-from-name-cache base-cache)
                cleanup-name-id)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              (lower-global-shared-view cleanup-str)
              cleanup-name-id
              (lower-module-name-key-id-by-id module-id cleanup-name-id)
              module
              cleanup-str
              cleanup-name-id))])]
    [(DefEnumLifetimes decl-meta _ _ cleanup _)
      (match cleanup
        [(No) names]
        [(Fn cleanup-name)
          (let
            [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
            [cleanup-str : String
              (lower-name-id-text
                (compiler-lower-state-from-name-cache base-cache)
                cleanup-name-id)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              (lower-global-shared-view cleanup-str)
              cleanup-name-id
              (lower-module-name-key-id-by-id module-id cleanup-name-id)
              module
              cleanup-str
              cleanup-name-id))])]
    [(DefStruct decl-meta _ _ cleanup _)
      (match cleanup
        [(No) names]
        [(Fn cleanup-name)
          (let
            [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
            [cleanup-str : String
              (lower-name-id-text
                (compiler-lower-state-from-name-cache base-cache)
                cleanup-name-id)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              (lower-global-shared-view cleanup-str)
              cleanup-name-id
              (lower-module-name-key-id-by-id module-id cleanup-name-id)
              module
              cleanup-str
              cleanup-name-id))])]
    [(DefStructLifetimes decl-meta _ _ _ cleanup _)
      (match cleanup
        [(No) names]
        [(Fn cleanup-name)
          (let
            [cleanup-name-id : i64 (ci.intern-syntax-id-value cleanup-name)]
            [cleanup-str : String
              (lower-name-id-text
                (compiler-lower-state-from-name-cache base-cache)
                cleanup-name-id)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              (lower-global-shared-view cleanup-str)
              cleanup-name-id
              (lower-module-name-key-id-by-id module-id cleanup-name-id)
              module
              cleanup-str
              cleanup-name-id))])]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-name-env-add-decl-alias-in-module-cache
          names
          base-cache
          dedup-base
          alias
          alias-id
          module
          module-id
          inner))]
    [_ names]))

(define (lower-name-env-add-module-aliases
  [lower-state : CompilerLowerState]
  [decls : (& decls ast.AstDeclList)]
  [paths : (& paths ast.AstDeclPathList)]
  [entry-path : String]
  [names : LowerNameEnv]
  [target-module-id : i64]
  [alias-id : i64]
  [_module-id : i64]
  [path-aware : bool]) : LowerNameEnv
  (let
    [cur-names : LowerNameEnv names]
    [target-module : String (lower-name-id-text lower-state target-module-id)]
    [alias : String (lower-name-id-text lower-state alias-id)]
    [_ensure : unit (lower-module-decl-index-ensure! lower-state decls)]
    [slot : i64 (lower-module-decl-index-slot lower-state target-module-id)]
    [starts : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-starts)]
    [ends : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-ends)]
    [positions : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-positions)]
    (if (< slot 0)
      cur-names
      (let
        [index : i64 (lower-global-array-element-shared-view starts slot)]
        [end : i64 (lower-global-array-element-shared-view ends slot)]
        [decl-offset : i64 decls.offset]
        [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
        (while (< index end)
          (let
            [position : i64
              (lower-global-array-element-shared-view positions index)]
            [decl : ast.AstDecl
              (lower-global-array-element-shared-view
                decl-slots
                (+ decl-offset position))]
            [decl-path : String
              (ast.ast-decl-path-list-get
                (& paths)
                position
                (lower-global-shared-view entry-path))]
            (match (lower-global-shared-view decl)
              [(Module _) unit]
              [(Import decl-meta _) unit]
              [(IncludeStr _ _) unit]
              [(IncludeStrComptime _ _) unit]
              [(IncludeStrLzss _ _) unit]
              [(IncludeBin _ _) unit]
              [(Test _ _ _ _) unit]
              [_
                (set!
                  cur-names
                  (lower-name-env-add-decl-alias-in-module
                    lower-state
                    cur-names
                    position
                    (lower-global-shared-view entry-path)
                    decl-path
                    (lower-global-shared-view alias)
                    alias-id
                    (lower-global-shared-view target-module)
                    target-module-id
                    decl
                    path-aware))])
            (set! index (+ index 1))))
        cur-names))))

;; --- per-program module -> decl-position index ------------------
;; Import-alias fanout, its cache-backed module-local variant, and
;; lower-module-local-envs-list all need to filter the whole-program decl list
;; down to one module. Scanning every declaration and tracking `(module NAME)`
;; markers for each target would cost O(imports x program) work in
;; the initial name-env build, plus repeated module-local scans later. This
;; CSR-shaped index maps each module id to the program-order positions of its
;; declarations (module markers excluded) so all of those consumers touch only
;; the target module's rows. Built lazily per program over the checked decl list,
;; which is immutable for the whole lower run;
;; compiler-lower-state-reset! drops it between programs and the (len, offset)
;; stamp re-checks the list shape on every ensure.
(define (lower-module-decl-index-reset! [lower-state : CompilerLowerState]) : unit
  (compiler-lower-state-write! lower-state bool module-decl-index-ready false)
  (compiler-lower-state-write! lower-state i64 module-decl-index-decl-count -1)
  (compiler-lower-state-write! lower-state i64 module-decl-index-decl-offset -1)
  ;; The stale array/map handles are never read while ready is false (every
  ;; consumer goes through ensure!), so destroying their owner arena is safe.
  (let
    [index-arena : i64
      (compiler-lower-state-read lower-state i64 module-decl-index-arena)]
    (unless
      (= index-arena 0)
      (unsafe
        (arena.tl_arena_destroy index-arena))
      (compiler-lower-state-write! lower-state i64 module-decl-index-arena 0)))
  (compiler-lower-state-write!
    lower-state
    lower_i64_i64_map.Map
    module-decl-index-modules
    (lower_i64_i64_map.with-capacity 16))
  (compiler-lower-state-write!
    lower-state
    (__tl_dyn-array i64)
    module-decl-index-starts
    (__tl_make-array i64 0))
  (compiler-lower-state-write!
    lower-state
    (__tl_dyn-array i64)
    module-decl-index-ends
    (__tl_make-array i64 0))
  (compiler-lower-state-write!
    lower-state
    (__tl_dyn-array i64)
    module-decl-index-positions
    (__tl_make-array i64 0)))

(define (lower-module-decl-index-ensure!
  [lower-state : CompilerLowerState]
  [decls : (& decls ast.AstDeclList)]) : unit
  (if (and
    (compiler-lower-state-read lower-state bool module-decl-index-ready)
    (=
      (compiler-lower-state-read lower-state i64 module-decl-index-decl-count)
      decls.len)
    (=
      (compiler-lower-state-read lower-state i64 module-decl-index-decl-offset)
      decls.offset))
    unit
    (let
      [count : i64 decls.len]
      [decl-offset : i64 decls.offset]
      [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
      [empty-module-id : i64 cbi.compiler-builtin-id-fix-empty]
      ;; The index outlives the transient scratch arenas active during
      ;; lowering, so its backing allocations live in a dedicated arena
      ;; (same idiom as tc-hygiene-module-env-cache-arena): allocating them
      ;; in whatever arena happens to be active would leave the state fields
      ;; dangling when that scratch arena is destroyed.
      [index-arena : i64
        (compiler-lower-state-read lower-state i64 module-decl-index-arena)]
      [_make-arena : unit
        (when
          (= index-arena 0)
          (set! index-arena (arena.tl_arena_make_small))
          (compiler-lower-state-write!
            lower-state
            i64
            module-decl-index-arena
            index-arena))]
      (in-arena
        (arena.Arena index-arena)
        (let
          [modules : lower_i64_i64_map.Map
            (lower_i64_i64_map.with-capacity 512)]
          [module-count : i64 0]
          [counts : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
          [starts : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
          [ends : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
          [positions : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
          [cur-module-id : i64 empty-module-id]
          [i : i64 0]
          [running : i64 0]
          ;; Pass 1: assign a dense slot per module id and count its decls.
          (while (< i count)
            (match (array-ref decl-slots (+ decl-offset i))
              [(Module next-module) (set! cur-module-id next-module)]
              [_
                (let
                  [slot : i64
                    (match (lower_i64_i64_map.get (& modules) cur-module-id)
                      [(LookupFound found-slot) found-slot]
                      [(LookupMissing)
                        (let
                          [new-slot : i64 module-count]
                          (lower_i64_i64_map.insert-ref!
                            (&mut modules)
                            cur-module-id
                            new-slot)
                          (set! module-count (+ module-count 1))
                          new-slot)])]
                  (set! (array-ref counts slot) (+ (array-ref counts slot) 1)))])
            (set! i (+ i 1)))
          ;; Prefix sums: starts fixed, ends double as fill cursors below.
          (set! i 0)
          (while (< i module-count)
            (set! (array-ref starts i) running)
            (set! (array-ref ends i) running)
            (set! running (+ running (array-ref counts i)))
            (set! i (+ i 1)))
          ;; Pass 2: fill program-order positions per module slot.
          (set! cur-module-id empty-module-id)
          (set! i 0)
          (while (< i count)
            (match (array-ref decl-slots (+ decl-offset i))
              [(Module next-module) (set! cur-module-id next-module)]
              [_
                (match (lower_i64_i64_map.get (& modules) cur-module-id)
                  [(LookupFound slot)
                    (let
                      [cursor : i64 (array-ref ends slot)]
                      (set! (array-ref positions cursor) i)
                      (set! (array-ref ends slot) (+ cursor 1)))]
                  [(LookupMissing) unit])])
            (set! i (+ i 1)))
          (compiler-lower-state-write!
            lower-state
            lower_i64_i64_map.Map
            module-decl-index-modules
            modules)
          (compiler-lower-state-write!
            lower-state
            (__tl_dyn-array i64)
            module-decl-index-starts
            starts)
          (compiler-lower-state-write!
            lower-state
            (__tl_dyn-array i64)
            module-decl-index-ends
            ends)
          (compiler-lower-state-write!
            lower-state
            (__tl_dyn-array i64)
            module-decl-index-positions
            positions)
          (compiler-lower-state-write!
            lower-state
            i64
            module-decl-index-decl-count
            count)
          (compiler-lower-state-write!
            lower-state
            i64
            module-decl-index-decl-offset
            decl-offset)
          (compiler-lower-state-write!
            lower-state
            bool
            module-decl-index-ready
            true))))))

;; Dense slot for a module id, or -1 when the module owns no declarations.
(define (lower-module-decl-index-slot
  [lower-state : CompilerLowerState]
  [module-id : i64]) : i64
  (let
    [modules : lower_i64_i64_map.Map
      (compiler-lower-state-read
        lower-state
        lower_i64_i64_map.Map
        module-decl-index-modules)]
    (lower_i64_i64_map.get-value-or (& modules) module-id -1)))

(define (lower-name-env-add-module-aliases-cache
  [decls : ast.AstDeclList]
  [base-cache : (& base-cache LowerNameCache)]
  [dedup-base : bool]
  [names : LowerNameEnv]
  [target-module-id : i64]
  [alias-id : i64]
  [_module-id : i64]) : LowerNameEnv
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache base-cache)]
    [cur-names : LowerNameEnv names]
    [_ensure : unit (lower-module-decl-index-ensure! lower-state decls)]
    [slot : i64 (lower-module-decl-index-slot lower-state target-module-id)]
    [starts : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-starts)]
    [ends : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-ends)]
    [positions : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-positions)]
    (if (< slot 0)
      cur-names
      (let
        [j : i64 (lower-global-array-element-shared-view starts slot)]
        [end : i64 (lower-global-array-element-shared-view ends slot)]
        [target-module : String
          (lower-name-id-text lower-state target-module-id)]
        [alias : String (lower-name-id-text lower-state alias-id)]
        (while (< j end)
          (let
            [decl : ast.AstDecl
              (lower-global-array-element-shared-view
                decls.slots
                (+
                  decls.offset
                  (lower-global-array-element-shared-view positions j)))]
            (match (lower-global-shared-view decl)
              [(Module _) unit]
              [(Import decl-meta _) unit]
              [(IncludeStr _ _) unit]
              [(IncludeStrComptime _ _) unit]
              [(IncludeStrLzss _ _) unit]
              [(IncludeBin _ _) unit]
              [(Test _ _ _ _) unit]
              [_
                (set!
                  cur-names
                  (lower-name-env-add-decl-alias-in-module-cache
                    cur-names
                    base-cache
                    dedup-base
                    alias
                    alias-id
                    (lower-global-shared-view target-module)
                    target-module-id
                    decl))])
            (set! j (+ j 1))))
        cur-names))))

(define (lower-name-env-add-selected-item-alias
  [lower-state : CompilerLowerState]
  [names : LowerNameEnv]
  [importer-module-id : i64]
  [target-module-id : i64]
  [item-id : i64]
  [alias-id : i64]) : LowerNameEnv
  (let
    [target-key : i64 (lower-module-name-key-id-by-id target-module-id item-id)]
    [alias-key : i64
      (lower-module-name-key-id-by-id importer-module-id alias-id)]
    [logical-id : i64
      (lower-name-env-lookup-logical-id
        (lower-global-shared-view names)
        target-key
        -1)]
    [symbol-id : i64
      (lower-name-env-lookup-symbol-id-owned
        lower-state
        (lower-global-shared-view names)
        target-key
        -1)]
    (if (or (< logical-id 0) (< symbol-id 0))
      names
      (lower-name-env-add-import-alias-binding-symbol-id
        lower-state
        names
        (lower-name-id-text lower-state alias-id)
        ""
        alias-key
        ""
        logical-id
        symbol-id))))

(define (lower-name-env-add-selected-item-alias-cache
  [names : LowerNameEnv]
  [base-cache : (& base-cache LowerNameCache)]
  [importer-module-id : i64]
  [target-module-id : i64]
  [item-id : i64]
  [alias-id : i64]) : LowerNameEnv
  (let
    [target-key : i64 (lower-module-name-key-id-by-id target-module-id item-id)]
    [alias-key : i64
      (lower-module-name-key-id-by-id importer-module-id alias-id)]
    [logical-id : i64
      (lower-name-cache-lookup-logical-id (& base-cache) target-key -1)]
    [symbol-id : i64
      (if (< logical-id 0)
        -1
        (lower-name-cache-lookup-symbol-id (& base-cache) logical-id -1))]
    (if (or (< logical-id 0) (< symbol-id 0))
      names
      (lower-name-env-add-import-alias-binding-symbol-id
        (compiler-lower-state-from-name-cache base-cache)
        names
        (lower-name-id-text
          (compiler-lower-state-from-name-cache base-cache)
          alias-id)
        ""
        alias-key
        ""
        logical-id
        symbol-id))))

(define (lower-name-env-from-import-aliases
  [lower-state : CompilerLowerState]
  [all-decls : ast.AstDeclList]
  [all-paths : ast.AstDeclPathList]
  [decls : ast.AstDeclList]
  [_paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [initial-module-id : i64]
  [path-aware : bool]) : LowerNameEnv
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 initial-module-id]
    ;; Seed the overlay membership set from the base env so the per-alias
    ;; "already bound?" check below is O(1) instead of an O(base) linear scan.
    (lower-alias-overlay-seed-from-env!
      lower-state
      (lower-global-shared-view cur-names))
    ;; The fanout below revisits each imported declaration once per importing
    ;; alias; the memo is indexed by that declaration's position in
    ;; `all-decls` and is valid only while this pass' (decls, paths,
    ;; entry-path, path-aware) tuple is fixed.
    (lower-alias-symbol-memo-reset!
      lower-state
      (ast.ast-decl-list-len (& all-decls)))
    (while (< index count)
      (let
        [decl : ast.AstDecl
          (lower-global-array-element-shared-view
            decls.slots
            (+ decls.offset index))]
        (match (lower-global-shared-view decl)
          [(Import
              decl-meta
              (Spec (ModuleItem item) _ (Some target-module) (Some alias) _))
            (set!
              cur-names
              (lower-name-env-add-selected-item-alias
                lower-state
                cur-names
                cur-module-id
                target-module
                item
                alias))]
          [(Import decl-meta (Spec _ _ (Some target-module) (Some alias) _))
            (set!
              cur-names
              (lower-name-env-add-module-aliases
                lower-state
                all-decls
                all-paths
                (lower-global-shared-view entry-path)
                cur-names
                target-module
                (lower-import-alias-key-id cur-module-id alias)
                cbi.compiler-builtin-id-fix-empty
                path-aware))]
          [_ unit])
        (match decl
          [(Module next-module) (set! cur-module-id next-module)]
          [_ unit])
        (set! index (+ index 1))))
    (lower-alias-symbol-memo-release! lower-state)
    cur-names))

(define (lower-name-env-with-import-aliases
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [path-aware : bool]) : LowerNameEnv
  (lower-name-env-from-import-aliases
    lower-state
    (lower-global-shared-view decls)
    (lower-global-shared-view paths)
    decls
    paths
    entry-path
    names
    cbi.compiler-builtin-id-fix-empty
    path-aware))

(define (lower-name-env-from-import-aliases-in-module-cache
  [all-decls : ast.AstDeclList]
  [decls : ast.AstDeclList]
  [names : LowerNameEnv]
  [base-cache : (& base-cache LowerNameCache)]
  [dedup-base : bool]
  [target-current-module-id : i64]
  [_current-module-id : i64]) : LowerNameEnv
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache base-cache)]
    [cur-names : LowerNameEnv names]
    [_ensure : unit (lower-module-decl-index-ensure! lower-state decls)]
    [slot : i64
      (lower-module-decl-index-slot lower-state target-current-module-id)]
    [starts : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-starts)]
    [ends : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-ends)]
    [positions : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-positions)]
    ;; `names` is always a fresh (empty) overlay here, so seed the overlay
    ;; membership set empty; it then mirrors every alias bound below.
    (lower-alias-overlay-reset! lower-state)
    (if (< slot 0)
      cur-names
      (let
        [j : i64 (lower-global-array-element-shared-view starts slot)]
        [end : i64 (lower-global-array-element-shared-view ends slot)]
        (while (< j end)
          (let
            [decl : ast.AstDecl
              (lower-global-array-element-shared-view
                decls.slots
                (+
                  decls.offset
                  (lower-global-array-element-shared-view positions j)))]
            (match decl
              [(Import
                  decl-meta
                  (Spec (ModuleItem item) _ (Some target-module) (Some alias) _))
                (set!
                  cur-names
                  (lower-name-env-add-selected-item-alias-cache
                    cur-names
                    base-cache
                    target-current-module-id
                    target-module
                    item
                    alias))]
              [(Import decl-meta (Spec _ _ (Some target-module) (Some alias) _))
                (set!
                  cur-names
                  (lower-name-env-add-module-aliases-cache
                    (lower-global-shared-view all-decls)
                    base-cache
                    dedup-base
                    cur-names
                    target-module
                    alias
                    cbi.compiler-builtin-id-fix-empty))]
              [_ unit])
            (set! j (+ j 1))))
        cur-names))))

(define (lower-name-env-with-import-aliases-in-module-cache
  [decls : ast.AstDeclList]
  [names : LowerNameEnv]
  [base-cache : (& base-cache LowerNameCache)]
  [module-id : i64]) : LowerNameEnv
  ;; Build aliases into a fresh overlay so empty-alias duplicate checks do not
  ;; rescan the whole base env for every imported decl.
  (let
    [dedup-base : bool
      (match (lower-global-shared-view names)
        [(Nil) false]
        [_ true])]
    [overlay : LowerNameEnv
      (lower-name-env-from-import-aliases-in-module-cache
        (lower-global-shared-view decls)
        decls
        Nil
        base-cache
        dedup-base
        module-id
        cbi.compiler-builtin-id-fix-empty)]
    (match (lower-global-shared-view names)
      [(Nil) overlay]
      [_
        (lower-name-env-append-owned
          (compiler-lower-state-from-name-cache base-cache)
          overlay
          names)])))

(define (lower-module-local-type-envs-bind-qualified
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [name-id : i64]) : ResultLowerModuleTypeEnvs
  (let
    [ty
      (try
        (tc_core.tc-lookup-id
          top-env
          (csym.compiler-symbol-module-key-id-by-id module name-id)))]
    (Ok
      (tc_core.tc-bind-id env name-id (lower-global-shared-view ty))
      (tc_core.tc-bind-id local-env name-id ty))))

;; A module's first enum declaring a variant name owns the module's bare
;; spelling of it, as in typecheck's module overlay. Only this module's own
;; bindings decide that: `env` starts from the program environment, where the
;; entry module binds its variants bare, and an entry-module variant of the same
;; spelling must not shadow this module's.
(define (lower-module-local-type-envs-bind-qualified-id-if-free
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [name-id : i64]) : ResultLowerModuleTypeEnvs
  (match (tc_core.tc-lookup-id local-env name-id)
    [(Ok _) (Ok env local-env)]
    [(Err _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name-id)]))

(define (lower-module-local-type-envs-add-variants
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [variants : ast.AstVariantDefList]) : ResultLowerModuleTypeEnvs
  (lower-module-local-type-envs-add-variants-at
    top-env
    env
    local-env
    module
    (& variants)
    0))

(define (lower-module-local-type-envs-add-variants-at
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : ResultLowerModuleTypeEnvs
  (if (>= index variants.len)
    (Ok env local-env)
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def name _ _)
        (match (lower-module-local-type-envs-bind-qualified-id-if-free
          top-env
          env
          local-env
          module
          name)
          [(Ok next-env next-local-env)
            (lower-module-local-type-envs-add-variants-at
              top-env
              next-env
              next-local-env
              module
              variants
              (+ index 1))]
          [(Err message) (Err message)])])))

(define (lower-module-local-type-envs-add-decl
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [decl : ast.AstDecl]) : ResultLowerModuleTypeEnvs
  (match decl
    [(Def decl-meta name _ _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(DefFn decl-meta name _ _ _ _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(DefDispatch decl-meta name _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(Extern decl-meta name _ _ _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(DefEnum decl-meta _ cleanup variants)
      (match (lower-module-local-type-envs-add-variants
        top-env
        env
        local-env
        module
        variants)
        [(Ok next-env next-local-env)
          (match cleanup
            [(No) (Ok next-env next-local-env)]
            [(Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                (ci.intern-syntax-id-value cleanup-name))])]
        [(Err message) (Err message)])]
    [(DefEnumLifetimes decl-meta _ _ cleanup variants)
      (match (lower-module-local-type-envs-add-variants
        top-env
        env
        local-env
        module
        variants)
        [(Ok next-env next-local-env)
          (match cleanup
            [(No) (Ok next-env next-local-env)]
            [(Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                (ci.intern-syntax-id-value cleanup-name))])]
        [(Err message) (Err message)])]
    [(DefStruct decl-meta name _ cleanup _)
      (match (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)
        [(Ok next-env next-local-env)
          (match cleanup
            [(No) (Ok next-env next-local-env)]
            [(Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                (ci.intern-syntax-id-value cleanup-name))])]
        [(Err message) (Err message)])]
    [(DefStructLifetimes decl-meta name _ _ cleanup _)
      (match (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)
        [(Ok next-env next-local-env)
          (match cleanup
            [(No) (Ok next-env next-local-env)]
            [(Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                (ci.intern-syntax-id-value cleanup-name))])]
        [(Err message) (Err message)])]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-module-local-type-envs-add-decl
          top-env
          env
          local-env
          module
          inner))]
    [_ (Ok env local-env)]))

(define (lower-module-local-envs-list
  [top-env : tc_core.TcTypeEnv]
  [decls : ast.AstDeclList]
  [type-env : tc_core.TcTypeEnv]
  [local-type-env : tc_core.TcTypeEnv]
  [_resolve-names : LowerNameEnv]
  [local-names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [_target-module : (& _target-module str)]
  [target-module-id : i64]) : ResultLowerModuleLocalEnv
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache name-cache)]
    [cur-type-env : tc_core.TcTypeEnv type-env]
    [cur-local-type-env : tc_core.TcTypeEnv local-type-env]
    [cur-local-names : LowerNameEnv local-names]
    [_ensure : unit (lower-module-decl-index-ensure! lower-state decls)]
    [slot : i64 (lower-module-decl-index-slot lower-state target-module-id)]
    [starts : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-starts)]
    [ends : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-ends)]
    [positions : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        module-decl-index-positions)]
    [index : i64
      (if (< slot 0)
        0
        (lower-global-array-element-shared-view starts slot))]
    [count : i64
      (if (< slot 0)
        0
        (lower-global-array-element-shared-view ends slot))]
    [decl-offset : i64 decls.offset]
    [result : ResultLowerModuleLocalEnv (Err "lower: module local env walk")]
    [done : bool false]
    (while (and (not done) (< index count))
      (let
        [decl : ast.AstDecl
          (lower-global-array-element-shared-view
            decls.slots
            (+
              decl-offset
              (lower-global-array-element-shared-view positions index)))]
        (match (lower-global-shared-view decl)
          [(Module _) unit]
          [_
            (match (lower-module-local-type-envs-add-decl
              top-env
              cur-type-env
              cur-local-type-env
              target-module-id
              decl)
              [(Ok next-type-env next-local-type-env)
                (set! cur-type-env next-type-env)
                (set! cur-local-type-env next-local-type-env)]
              [(Err message)
                (set! result (Err message))
                (set! done true)])])
        (set! index (+ index 1))))
    (if done
      result
      (Ok
        ;; Keep the module declaration-count phase from seeding function-local
        ;; partial-cache collapse depth.
        (tc_core.tc-env-with-cache-layer-over-explicit cur-type-env)
        cur-local-type-env
        cur-local-names))))

(define (lower-module-local-envs
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : (& module str)]
  [module-id : i64]) : ResultLowerModuleLocalEnv
  (if (string.eq module "")
    (Ok top-env (tc_core.tc-empty-env) (Nil))
    (match (tc_core.tc-context-program ctx)
      [(Program decls-box)
        (let
          [decls : ast.AstDeclList (deref decls-box)]
          ;; The module's import aliases resolve against the global
          ;; name-cache (not the env base), so building them on an empty base
          ;; yields the module-local-only alias env used by the per-module
          ;; name-cache overlay. Unqualified declarations owned by this module
          ;; resolve through the shared cache's canonical module-qualified keys,
          ;; so copying every local declaration into the overlay is redundant.
          [local-alias-names : LowerNameEnv
            (lower-name-env-with-import-aliases-in-module-cache
              (lower-global-shared-view decls)
              (Nil)
              name-cache
              module-id)]
          (lower-module-local-envs-list
            top-env
            decls
            top-env
            (tc_core.tc-empty-env)
            names
            local-alias-names
            name-cache
            module
            module-id))])))

(define (lower-module-local-view-store-copy-prefix!
  [source : (__tl_dyn-array LowerModuleLocalView)]
  [destination : (&mut destination (__tl_dyn-array LowerModuleLocalView))]
  [len : i64]) : unit
  (let
    [index : i64 0]
    (while (< index len)
      (set! (array-ref destination index) (array-ref source index))
      (set! index (+ index 1)))))

(define (lower-module-local-view-store-grow [store : LowerModuleLocalViewStore]) : LowerModuleLocalViewStore
  (let
    [old-capacity : i64 (array-length store.values)]
    [next-capacity : i64
      (if (< old-capacity 1)
        8
        (* old-capacity 2))]
    [next-values : (__tl_dyn-array LowerModuleLocalView)
      (__tl_make-array LowerModuleLocalView next-capacity)]
    (lower-module-local-view-store-copy-prefix!
      store.values
      (&mut next-values)
      store.len)
    (LowerModuleLocalViewStore store.modules next-values store.len)))

(define (lower-module-local-view-store-lookup
  [store : LowerModuleLocalViewStore]
  [module-id : i64]) : LowerMaybeModuleLocalView
  (match (lower_i64_i64_map.get (& store.modules) module-id)
    [(LookupFound slot)
      (Some (lower-global-array-element-shared-view store.values slot))]
    [(LookupMissing) (No)]))

(define (lower-module-local-view-store-insert
  [store : LowerModuleLocalViewStore]
  [module-id : i64]
  [view : LowerModuleLocalView]) : LowerModuleLocalViewStore
  (match (lower_i64_i64_map.get (& store.modules) module-id)
    [(LookupFound slot)
      (set! (array-ref store.values slot) view)
      store]
    [(LookupMissing)
      (let
        [ready : LowerModuleLocalViewStore
          (if (>= store.len (array-length store.values))
            (lower-module-local-view-store-grow store)
            store)]
        [slot : i64 ready.len]
        [modules : lower_i64_i64_map.Map ready.modules]
        (begin
          (set! (array-ref ready.values slot) view)
          (lower_i64_i64_map.insert-ref! (&mut modules) module-id slot)
          (cfg
            (any compile-profile test)
            (profile_state.compiler-profile-metrics-add!
              (compiler-lower-profile-metrics-view
                (compiler-lower-state-from-name-cache view.name-cache))
              compiler-lower-profile-module-local-view-entries-metric
              1))
          (LowerModuleLocalViewStore modules ready.values (+ slot 1))))]))

(define (lower-active-module-local-view-lookup
  [lower-state : CompilerLowerState]
  [module-id : i64]) : LowerMaybeModuleLocalView
  (let
    [result : LowerMaybeModuleLocalView
      (lower-module-local-view-store-lookup
        (compiler-lower-state-read
          lower-state
          LowerModuleLocalViewStore
          active-module-local-views)
        module-id)]
    (begin
      (cfg
        (any compile-profile test)
        (begin
          (profile_state.compiler-profile-metrics-add!
            (compiler-lower-profile-metrics-view lower-state)
            compiler-lower-profile-module-local-view-lookups-metric
            1)
          (match (& result)
            [(Some _)
              (profile_state.compiler-profile-metrics-add!
                (compiler-lower-profile-metrics-view lower-state)
                compiler-lower-profile-module-local-view-hits-metric
                1)]
            [(No) unit])))
      result)))

(define (lower-active-module-local-view-insert!
  [lower-state : CompilerLowerState]
  [module-id : i64]
  [view : LowerModuleLocalView]) : unit
  (compiler-lower-state-write!
    lower-state
    LowerModuleLocalViewStore
    active-module-local-views
    (lower-module-local-view-store-insert
      (compiler-lower-state-read
        lower-state
        LowerModuleLocalViewStore
        active-module-local-views)
      module-id
      view)))

(define (lower-module-local-view-build
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [names : LowerNameEnv]
  [module : (& module str)]
  [module-id : i64]) : ResultLowerModuleLocalView
  (match (lower-module-local-envs
    ctx
    top-env
    names
    (lower-active-global-name-cache-current lower-state)
    module
    module-id)
    [(Ok local-top-env local-type-env local-name-only)
      (Ok
        (LowerModuleLocalView
          local-top-env
          (lower-name-cache-overlay lower-state local-name-only module-id)
          (lower-type-cache-overlay lower-state local-type-env)))]
    [(Err message) (Err message)]))

;; The declaration loop's module views are released in epochs. The loop's
;; `(module ...)` markers are split into `lower-module-view-epoch-count` equal
;; epochs. A module's view lives in the arena of the epoch holding the module's
;; last marker, and that arena is destroyed once the loop has passed the epoch,
;; when no module of the epoch has a segment left. Views share epoch arenas
;; because an arena of its own would cost most views a whole transparent huge
;; page on Linux.
(define lower-module-view-epoch-count : i64
  8)

(defstruct LowerModuleViewEpochs
  ;; module id -> index of the module's last marker
  (last-markers lower_i64_i64_map.Map)
  (marker-count i64)
  ;; one arena per epoch, 0 until a view needs it
  (arenas (__tl_dyn-array i64))
  ;; the modules whose views were built, and their epochs
  (modules (__tl_dyn-array i64))
  (module-epochs (__tl_dyn-array i64))
  (built i64)
  ;; epochs below this one are released
  (released i64))

;; Index every `(module ...)` marker of DECLS. The loop visits every marker,
;; including runtime-skipped modules' (their skip stops at the next marker).
(define (lower-module-view-epochs-new [decls : ast.AstDeclList]) : LowerModuleViewEpochs
  (let
    [last-markers : lower_i64_i64_map.Map (lower_i64_i64_map.with-capacity 64)]
    [count : i64 0]
    [cursor : ast.AstDeclList decls]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cursor)
        [(Nil) (set! done true)]
        [(Cons decl rest)
          (match (lower-global-shared-view decl)
            [(Module module-id)
              (lower_i64_i64_map.insert-ref!
                (&mut last-markers)
                module-id
                count)
              (set! count (+ count 1))]
            [_ unit])
          (set! cursor rest)]))
    (LowerModuleViewEpochs
      last-markers
      count
      (__tl_make-array i64 lower-module-view-epoch-count)
      (__tl_make-array i64 0)
      (__tl_make-array i64 0)
      0
      0)))

(define (lower-module-view-epoch
  [epochs : (& epochs LowerModuleViewEpochs)]
  [module-id : i64]) : i64
  (/
    (*
      (lower_i64_i64_map.get-value-or (& epochs.last-markers) module-id 0)
      lower-module-view-epoch-count)
    (if (> epochs.marker-count 0)
      epochs.marker-count
      1)))

;; MODULE-ID's view, built on first use into its epoch's arena. The
;; lowering-wide declaration index is filled first, in the enclosing arena; the
;; alias-overlay set and the interner already allocate in their own arenas.
(define (lower-module-local-view-cached
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [names : LowerNameEnv]
  [module : (& module str)]
  [module-id : i64]
  [epochs : (&mut epochs LowerModuleViewEpochs)]) : ResultLowerModuleLocalView
  (match (lower-active-module-local-view-lookup lower-state module-id)
    [(Some view) (Ok view)]
    [(No)
      (if (string.eq module "")
        unit
        (match (tc_core.tc-context-program ctx)
          [(Program decls-box)
            (lower-module-decl-index-ensure! lower-state (deref decls-box))]))
      (let
        [epoch : i64 (lower-module-view-epoch epochs module-id)]
        [view-arena : i64
          (if (> (array-ref epochs.arenas epoch) 0)
            (array-ref epochs.arenas epoch)
            (let
              [created : i64 (arena.tl_arena_make_small)]
              (ast.compiler-arena-debug-protect-never-reset! created)
              (set! (array-ref epochs.arenas epoch) created)
              created))]
        [home : i64 (arena.tl_arena_current)]
        [_enter : unit
          (unsafe
            (arena.tl_arena_set view-arena))]
        [built : ResultLowerModuleLocalView
          (lower-module-local-view-build
            lower-state
            ctx
            top-env
            names
            module
            module-id)]
        [_leave : unit
          (unsafe
            (arena.tl_arena_set home))]
        [view (try built)]
        (lower-active-module-local-view-insert!
          lower-state
          module-id
          (lower-global-shared-view view))
        (__tl_array-push! epochs.modules module-id)
        (__tl_array-push! epochs.module-epochs epoch)
        (set! epochs.built (+ epochs.built 1))
        (Ok view))]))

;; Release every epoch the loop has passed at marker index MARKER: each one
;; whose modules all have their last marker before it. Their views' map entries
;; are dropped (their value slots are never read again), then the epoch's arena
;; is destroyed. Nothing that outlives a module's segments points into its view:
;; the caches never grow after construction, lowering-wide memo state allocates
;; in its own arenas, and only construction runs with an epoch arena current.
(define (lower-module-view-epochs-release-before!
  [lower-state : CompilerLowerState]
  [epochs : (&mut epochs LowerModuleViewEpochs)]
  [marker : i64]) : unit
  (while (and
    (< epochs.released lower-module-view-epoch-count)
    (<=
      (* (+ epochs.released 1) epochs.marker-count)
      (* marker lower-module-view-epoch-count)))
    (let
      [epoch : i64 epochs.released]
      [store : LowerModuleLocalViewStore
        (compiler-lower-state-read
          lower-state
          LowerModuleLocalViewStore
          active-module-local-views)]
      [modules : lower_i64_i64_map.Map store.modules]
      [index : i64 0]
      (while (< index epochs.built)
        (if (= (array-ref epochs.module-epochs index) epoch)
          (begin
            (lower_i64_i64_map.remove-ref!
              (&mut modules)
              (array-ref epochs.modules index))
            (cfg
              (any compile-profile test)
              (profile_state.compiler-profile-metrics-add!
                (compiler-lower-profile-metrics-view lower-state)
                compiler-lower-profile-module-local-view-released-metric
                1)
              unit)
            unit)
          unit)
        (set! index (+ index 1)))
      (compiler-lower-state-write!
        lower-state
        LowerModuleLocalViewStore
        active-module-local-views
        (LowerModuleLocalViewStore modules store.values store.len))
      (when
        (> (array-ref epochs.arenas epoch) 0)
        (ast.compiler-arena-retire-protected-owner!
          (array-ref epochs.arenas epoch))
        (set! (array-ref epochs.arenas epoch) 0))
      (set! epochs.released (+ epoch 1)))))

(define (lower-id-set-empty) : LowerIdSet
  (LowerIdSet (__tl_make-array i64 0) 0))

(define (lower-id-set-contains? [items : (& items LowerIdSet)] [name : i64]) : bool
  (let
    [index : i64 items.len]
    [found : bool false]
    (while (and (not found) (> index 0))
      (set! index (- index 1))
      (if (= (array-ref items.slots index) name)
        (set! found true)
        unit))
    found))

(define (lower-id-set-insert [items : LowerIdSet] [name : i64]) : LowerIdSet
  (if (lower-id-set-contains? items name)
    items
    (let
      [len : i64 items.len]
      [slots : (__tl_dyn-array i64) (__tl_make-array i64 (+ len 1))]
      [index : i64 0]
      (while (< index len)
        (set! (array-ref slots index) (array-ref items.slots index))
        (set! index (+ index 1)))
      (set! (array-ref slots len) name)
      (LowerIdSet slots (+ len 1)))))

;; Stack push for the reach worklist only: that state is threaded linearly, so
;; the backing array is reused instead of copied. Popping just shrinks `len`,
;; which is why the spare tail slot is overwritten in place when it exists.
(define (lower-id-set-push [items : LowerIdSet] [name : i64]) : LowerIdSet
  (let
    [slots : (__tl_dyn-array i64) items.slots]
    [len : i64 items.len]
    (if (< len (array-length slots))
      (set! (array-ref slots len) name)
      (__tl_array-push! slots name))
    (LowerIdSet slots (+ len 1))))

(define (lower-spmd-inline-empty-helper-stack) : LowerIdSet
  (lower-id-set-empty))

(define tc-rtf-cap : i64
  65536)
(define lower-variant-arm-memo-cap : i64
  256)

(define (compiler-lower-state-spmd-package [state : CompilerLowerState]) : CompilerLowerSpmdPackageState
  (compiler-lower-state-read
    state
    CompilerLowerSpmdPackageState
    spmd-package-state))

(define (compiler-lower-state-set-spmd-package!
  [state : CompilerLowerState]
  [name : String]) : unit
  (let
    [previous : CompilerLowerSpmdPackageState
      (compiler-lower-state-spmd-package state)]
    [home : i64 (arena.tl_arena_current)]
    [next : i64 (arena.tl_arena_make_small)]
    (unsafe
      (arena.tl_arena_set next))
    (let
      [package : CompilerLowerSpmdPackageState
        (CompilerLowerSpmdPackageState
          next
          (string.copy name)
          (lower_i64_i64_map.with-capacity 8)
          (lower_i64_i64_map.with-capacity 8))]
      (unsafe
        (arena.tl_arena_set home))
      (if (= previous.arena 0)
        unit
        (unsafe
          (arena.tl_arena_destroy previous.arena)))
      (compiler-lower-state-write!
        state
        CompilerLowerSpmdPackageState
        spmd-package-state
        package))))

(define (compiler-lower-state-clear-spmd-package! [state : CompilerLowerState]) : unit
  (let
    [previous : CompilerLowerSpmdPackageState
      (compiler-lower-state-spmd-package state)]
    (if (= previous.arena 0)
      unit
      (unsafe
        (arena.tl_arena_destroy previous.arena)))
    (compiler-lower-state-write!
      state
      CompilerLowerSpmdPackageState
      spmd-package-state
      (compiler-lower-spmd-package-state-empty))))

(define (compiler-lower-state-ensure-spmd-package! [state : CompilerLowerState]) : unit
  (let
    [package : CompilerLowerSpmdPackageState
      (compiler-lower-state-spmd-package state)]
    (if (= package.arena 0)
      (compiler-lower-state-set-spmd-package! state "")
      unit)))

(define (compiler-lower-state-spmd-package-name [state : CompilerLowerState]) : String
  (let
    [package : CompilerLowerSpmdPackageState
      (compiler-lower-state-spmd-package state)]
    package.name))

(define (compiler-lower-function-memo-storage [state : CompilerLowerState]) : CompilerLowerFunctionMemoStorage
  (compiler-lower-state-read
    state
    CompilerLowerFunctionMemoStorage
    function-memo-storage))

(define (compiler-lower-function-memo-storage-set!
  [state : CompilerLowerState]
  [storage : CompilerLowerFunctionMemoStorage]) : unit
  (compiler-lower-state-write!
    state
    CompilerLowerFunctionMemoStorage
    function-memo-storage
    storage))

(define (compiler-lower-function-memo-storage-ensure!
  [state : CompilerLowerState]) : unit
  (let
    [storage : CompilerLowerFunctionMemoStorage
      (compiler-lower-function-memo-storage state)]
    (if (> (array-length storage.rtf-generations) 0)
      unit
      (in-arena
        (arena.Arena storage.arena)
        (let
          [rtf-generations : (__tl_dyn-array i64)
            (__tl_make-array i64 tc-rtf-cap)]
          [rtf-ids : (__tl_dyn-array i64) (__tl_make-array i64 tc-rtf-cap)]
          [rtf-types : (__tl_dyn-array ast.AstType)
            (__tl_make-array ast.AstType tc-rtf-cap)]
          [variant-stamps : (__tl_dyn-array i64)
            (__tl_make-array i64 lower-variant-arm-memo-cap)]
          [variant-keys : (__tl_dyn-array i64)
            (__tl_make-array i64 lower-variant-arm-memo-cap)]
          [variant-scrutinee-types : (__tl_dyn-array ast.AstType)
            (__tl_make-array ast.AstType lower-variant-arm-memo-cap)]
          [variant-outcomes : (__tl_dyn-array LowerVariantArmResolution)
            (__tl_make-array
              LowerVariantArmResolution
              lower-variant-arm-memo-cap)]
          [index : i64 0]
          (while (< index tc-rtf-cap)
            (set! (array-ref rtf-generations index) 0)
            (set! index (+ index 1)))
          (set! index 0)
          (while (< index lower-variant-arm-memo-cap)
            (set! (array-ref variant-stamps index) 0)
            (set! index (+ index 1)))
          (set! storage.rtf-generations rtf-generations)
          (set! storage.rtf-ids rtf-ids)
          (set! storage.rtf-types rtf-types)
          (set! storage.variant-stamps variant-stamps)
          (set! storage.variant-keys variant-keys)
          (set! storage.variant-scrutinee-types variant-scrutinee-types)
          (set! storage.variant-outcomes variant-outcomes)
          (compiler-lower-function-memo-storage-set! state storage))))))

(define (compiler-lower-function-state-ptr [state : CompilerLowerFunctionState]) : (MutPtr
    CompilerLowerFunctionStateData)
  (unsafe
    (int->ptr
      (cast state.address : u64)
      : (MutPtr CompilerLowerFunctionStateData))))

(define (compiler-lower-function-state-view
  [state : CompilerLowerFunctionState]) : (Ptr CompilerLowerFunctionStateData)
  (unsafe
    (int->ptr (cast state.address : u64) : (Ptr CompilerLowerFunctionStateData))))

(define (compiler-lower-function-state-new-with-stack
  [owner : CompilerLowerState]
  [stack : LowerIdSet]) : CompilerLowerFunctionState
  (compiler-lower-function-memo-storage-ensure! owner)
  (let
    [storage : CompilerLowerFunctionMemoStorage
      (compiler-lower-function-memo-storage owner)]
    [rtf-generation : i64 (+ storage.next-rtf-generation 1)]
    [variant-generation : i64 (+ storage.next-variant-generation 1)]
    [cell : (__tl_dyn-array CompilerLowerFunctionStateData)
      (__tl_make-array CompilerLowerFunctionStateData 1)]
    [address : i64
      (cast
        (unsafe
          (ptr->int
            (ptr-cast
              (__tl_array-data cell)
              : (Ptr CompilerLowerFunctionStateData))))
        : i64)]
    (set! storage.next-rtf-generation rtf-generation)
    (set! storage.next-variant-generation variant-generation)
    (compiler-lower-function-memo-storage-set! owner storage)
    (set!
      (array-ref cell 0)
      (CompilerLowerFunctionStateData
        owner.address
        stack
        false
        0
        (No)
        rtf-generation
        variant-generation))
    (CompilerLowerFunctionState address)))

(define (compiler-lower-function-state-new [owner : CompilerLowerState]) : CompilerLowerFunctionState
  (compiler-lower-function-state-new-with-stack
    owner
    (lower-spmd-inline-empty-helper-stack)))

(define (compiler-lower-function-state-inline-helper-stack
  [state : CompilerLowerFunctionState]) : LowerIdSet
  (unsafe
    (deref (compiler-lower-function-state-view state)).inline-helper-stack))

(define (compiler-lower-function-state-owner
  [state : CompilerLowerFunctionState]) : CompilerLowerState
  (compiler-lower-state-from-address
    (unsafe
      (deref (compiler-lower-function-state-view state)).owner-address)))

(define (compiler-lower-function-state-inline-helper-stack-set!
  [state : CompilerLowerFunctionState]
  [stack : LowerIdSet]) : unit
  (unsafe
    (set!
      (deref (compiler-lower-function-state-ptr state)).inline-helper-stack
      stack)))

(define (compiler-lower-function-state-recursion-detected?
  [state : CompilerLowerFunctionState]) : bool
  (unsafe
    (deref (compiler-lower-function-state-view state)).inline-recursion-detected))

(define (compiler-lower-function-state-recursion-detected-set!
  [state : CompilerLowerFunctionState]
  [detected : bool]) : unit
  (unsafe
    (set!
      (deref (compiler-lower-function-state-ptr state)).inline-recursion-detected
      detected)))

(define (compiler-lower-function-state-fresh-local-id!
  [state : CompilerLowerFunctionState]
  [source-name-id : i64]) : i64
  (unsafe
    (let
      [data : (MutPtr CompilerLowerFunctionStateData)
        (compiler-lower-function-state-ptr state)]
      [next : i64 (deref data).inline-next-temp]
      [owner-address : i64 (deref data).owner-address]
      (set! (deref data).inline-next-temp (+ next 1))
      (let
        [session : cis.InternStructuralSessionHandle
          (compiler-lower-state-structural-session
            (compiler-lower-state-from-address owner-address))]
        (cis.intern-fresh-local-identity-raw
          (cis.intern-structural-session-fresh-local-identity
            session
            next
            (tc_core.macro-hygiene-global-source-name-id-or
              session
              source-name-id
              source-name-id)))))))

(define (compiler-lower-function-state-scalar-call-context
  [state : CompilerLowerFunctionState]) : LowerSpmdScalarCallContext
  (unsafe
    (deref (compiler-lower-function-state-view state)).scalar-call-context))

(define (compiler-lower-function-state-scalar-call-context-set!
  [state : CompilerLowerFunctionState]
  [context : LowerSpmdScalarCallContext]) : unit
  (unsafe
    (set!
      (deref (compiler-lower-function-state-ptr state)).scalar-call-context
      context)))

(define (compiler-lower-function-state-rtf-generation
  [state : CompilerLowerFunctionState]) : i64
  (unsafe
    (deref (compiler-lower-function-state-view state)).rtf-generation))

(define (compiler-lower-function-state-variant-generation
  [state : CompilerLowerFunctionState]) : i64
  (unsafe
    (deref (compiler-lower-function-state-view state)).variant-generation))

;; For the memo-size test in compiler_lower_tests: comptime size-of rejects a
;; type named through a module alias.
(define (lower-variant-arm-resolution-size) : i64
  (comptime (size-of (type LowerVariantArmResolution))))

(define (compiler-lower-state-reset! [lower-state : CompilerLowerState]) : unit
  (compiler-lower-state-clear-spmd-package! lower-state)
  (lower-canonical-path-memo-reset! lower-state)
  (lower-entry-main-selection-restore!
    lower-state
    false
    ""
    cbi.compiler-builtin-id-fix-empty)
  (compiler-lower-state-write! lower-state i64 current-source-path-id 0)
  (compiler-lower-state-write! lower-state bool current-decl-generated false)
  (compiler-lower-state-write!
    lower-state
    LowerTypeCache
    decls-global-type-cache
    (LowerTypeCache.No))
  (compiler-lower-state-write!
    lower-state
    lower_i64_i64_map.Map
    rvo-early-return-functions
    (lower_i64_i64_map.with-capacity 8))
  (compiler-lower-state-write!
    lower-state
    csym.CompilerSymbols
    active-symbols
    (csym.compiler-symbols-empty))
  (compiler-lower-state-write! lower-state bool active-symbols-ready false)
  (lower-alias-overlay-reset! lower-state)
  (lower-alias-symbol-memo-release! lower-state)
  (lower-reach-scratch-state-reset! lower-state)
  (lower-module-decl-index-reset! lower-state)
  (lower-comptime-error-ids-reset! lower-state)
  (compiler-lower-checked-dest-pools-clear! lower-state))

(define (lower-reset-file-state!) : unit
  unit)

(define (lower-reset-intern-owned-state!) : unit
  (tc_core.compiler-typecheck-reset-intern-owned-state!))

(define (lower-context-expr-get [ctx : tc_core.TcContext] [id : i64]) : ast.AstExpr
  (let
    [expr : ast.AstExpr (tc_core.tc-context-expr-get ctx id)]
    ;; Expansion provenance has served its diagnostic purpose by the time a
    ;; fully typechecked program reaches lowering. Keep it transparent here so
    ;; every lowering analysis sees exactly the generated expression shape.
    (match (lower-global-shared-view expr)
      [(MacroExpansion inner _ _) (lower-context-expr-get ctx inner)]
      [_ expr])))

(define (lower-context-expr-push [ctx : tc_core.TcContext] [expr : ast.AstExpr]) : i64
  (ast.ast-node-pool-context-expr-push (tc_core.tc-context-pools ctx) expr))

(define (lower-spmd-inline-recursive-message) : String
  "lower: recursive SPMD helper call is not supported")

(define (lower-spmd-inline-fresh-local-id
  [function-state : CompilerLowerFunctionState]
  [source-name-id : i64]) : i64
  (compiler-lower-function-state-fresh-local-id! function-state source-name-id))

(define (lower-spmd-inline-subst-empty) : LowerSpmdInlineSubst
  (LowerSpmdInlineSubst
    (__tl_make-array i64 0)
    (__tl_make-array ast.AstExpr 0)
    0))

(define (lower-spmd-inline-subst-lookup
  [subs : LowerSpmdInlineSubst]
  [name : i64]) : LowerMaybeAstExpr
  (let
    [index : i64 subs.len]
    [found : i64 -1]
    (while (> index 0)
      (set! index (- index 1))
      (when
        (= (array-ref subs.names index) name)
        (set! found index)
        (set! index 0)))
    (if (< found 0)
      (No)
      (Some (lower-global-array-element-shared-view subs.values found)))))

(define (lower-spmd-inline-subst-remove
  [subs : LowerSpmdInlineSubst]
  [name : i64]) : LowerSpmdInlineSubst
  (let
    [len : i64 subs.len]
    [names : (__tl_dyn-array i64) (__tl_make-array i64 len)]
    [values : (__tl_dyn-array ast.AstExpr) (__tl_make-array ast.AstExpr len)]
    [index : i64 0]
    [kept : i64 0]
    (while (< index len)
      (unless
        (= (array-ref subs.names index) name)
        (set! (array-ref names kept) (array-ref subs.names index))
        (set! (array-ref values kept) (array-ref subs.values index))
        (set! kept (+ kept 1)))
      (set! index (+ index 1)))
    (LowerSpmdInlineSubst names values kept)))

(define (lower-spmd-inline-subst-cons
  [name : i64]
  [value : ast.AstExpr]
  [rest : LowerSpmdInlineSubst]) : LowerSpmdInlineSubst
  (let
    [len : i64 rest.len]
    [names : (__tl_dyn-array i64) (__tl_make-array i64 (+ len 1))]
    [values : (__tl_dyn-array ast.AstExpr)
      (__tl_make-array ast.AstExpr (+ len 1))]
    [index : i64 0]
    (while (< index len)
      (set! (array-ref names index) (array-ref rest.names index))
      (set! (array-ref values index) (array-ref rest.values index))
      (set! index (+ index 1)))
    (set! (array-ref names len) name)
    (set! (array-ref values len) value)
    (LowerSpmdInlineSubst names values (+ len 1))))

(define (lower-spmd-inline-helper-from-decl
  [ctx : tc_core.TcContext]
  [handle : i64]
  [decl : ast.AstDecl]) : ResultLowerSpmdInlineHelper
  (match decl
    [(DefFn decl-meta _ params ret body-box _)
      (let
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (Ok (Some handle params ret body)))]
    [(Extern _ _ (Function) metadata ty)
      (match (ast.ast-extern-metadata-imported-spmd (deref metadata))
        [(No) (Ok (No))]
        [(Package owner version canonical-name callables)
          (Ok (Imported owner version canonical-name ty callables))])]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-spmd-inline-helper-from-decl ctx handle inner))]
    [_ (Ok (No))]))

(define (lower-spmd-inline-helper-lookup
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [shadowed : LowerIdSet]
  [func : ast.AstExpr]) : ResultLowerSpmdInlineHelper
  (lower-spmd-inline-helper-lookup-resolved
    ctx
    function-state
    (lower-global-shared-view func)
    (lower-spmd-inline-helper-name-id
      function-state
      ctx
      env
      type-env
      shadowed
      func)))

(define (lower-spmd-inline-helper-name-id
  [function-state : CompilerLowerFunctionState]
  [ctx : tc_core.TcContext]
  [_env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [shadowed : LowerIdSet]
  [func : ast.AstExpr]) : tc_core.TcNameLookup
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    (match (ast.ast-expr-unspan-with-pools (& pools) func)
      [(Var raw-name)
        (let
          [source-id : i64
            (tc_core.macro-hygiene-global-source-name-id-or
              (tc_core.tc-context-structural-session ctx)
              raw-name
              raw-name)]
          [raw-text : String (lower-context-intern-str ctx source-id)]
          (cond
            [(lower-id-set-contains? shadowed raw-name) (Err "")]
            [(tc_core.macro-hygiene-global-id?
                (tc_core.tc-context-structural-session ctx)
                raw-name)
              (Ok
                (lower-hygiene-source-name-in-context-id
                  (compiler-lower-function-state-owner function-state)
                  ctx
                  type-env
                  raw-name)
                source-id)]
            [(tc_core.tc-hygiene-global-name? raw-text)
              (Ok (tc_core.tc-hygiene-global-call-name raw-text) source-id)]
            [(tc_core.tc-source-slash-qualified-id?
                (tc_core.tc-context-structural-session ctx)
                (lower-global-shared-view raw-text)
                source-id)
              (Ok raw-text source-id)]
            [else
              (tc_core.tc-source-name-lookup-key-with-field-check-lookup
                ctx
                type-env
                raw-text
                source-id
                true)]))]
      [_ (Err "")])))

(define (lower-spmd-inline-helper-lookup-resolved
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [func : ast.AstExpr]
  [resolved : tc_core.TcNameLookup]) : ResultLowerSpmdInlineHelper
  (match resolved
    [(Ok name lookup-id)
      (if (string.eq name "")
        (Ok (No))
        (let
          [handle : i64
            (csym.compiler-symbols-lookup-value-id-or
              (tc_core.tc-context-symbols ctx)
              lookup-id
              (csym.compiler-symbols-missing-handle))]
          (cond
            [(not (csym.compiler-symbols-handle-found? handle)) (Ok (No))]
            [(and
              (=
                (csym.compiler-symbol-handle-kind handle)
                (csym.compiler-symbol-kind-function-define))
              (let
                [helper-stack
                  (compiler-lower-function-state-inline-helper-stack
                    function-state)]
                (lower-id-set-contains? helper-stack handle)))
              (compiler-lower-function-state-recursion-detected-set!
                function-state
                true)
              (Err
                (box
                  (lower-diagnostic-at-expr
                    ctx
                    func
                    (lower-spmd-inline-recursive-message))))]
            [(or
                (=
                  (csym.compiler-symbol-handle-kind handle)
                  (csym.compiler-symbol-kind-function-define))
                (=
                  (csym.compiler-symbol-handle-kind handle)
                  (csym.compiler-symbol-kind-extern)))
              (match (csym.compiler-symbols-decl-at-index
                (tc_core.tc-context-symbols ctx)
                (csym.compiler-symbol-handle-index handle))
                [(Ok decl) (lower-spmd-inline-helper-from-decl ctx handle decl)]
                [(Err message) (Err (box (lower-diagnostic message)))])]
            [else (Ok (No))])))]
    [(Err message)
      (if (string.eq message "")
        (Ok (No))
        (Err (box (lower-diagnostic-at-expr ctx func message))))]))

;; An argument that can be rematerialized without changing its value or effects.
;; A variable read needs a snapshot: later arguments or the helper body can
;; change its value. Borrowing a checked variable only names its stable place.
(define (lower-spmd-inline-arg-stable?
  [ctx : tc_core.TcContext]
  [arg : ast.AstExpr]) : bool
  (match arg
    [(Spanned inner-box _)
      (lower-spmd-inline-arg-stable? ctx (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-spmd-inline-arg-stable? ctx (lower-context-expr-get ctx inner-box))]
    [(Borrow _ _ place-box)
      (match (ast.ast-expr-unspan (lower-context-expr-get ctx place-box))
        [(Var _) true]
        [_ false])]
    [(Var _) false]
    [(Literal _) true]
    [(SpmdProgramIndex) true]
    [(SpmdProgramCount) true]
    [_ false]))

;; The declared type of a staged argument: a scalar lane parameter keeps its
;; type, which converts the argument as the call would and is what the SIMD
;; planners read; any other parameter, such as a reference whose lifetime
;; names the helper's own region, takes the argument's already checked type.
(define (lower-spmd-inline-staged-type [param-ty : ast.AstType]) : ast.AstMaybeType
  (match (tc_core.tc-type-without-regions (lower-global-shared-view param-ty))
    [(I8) (Some param-ty)]
    [(U8) (Some param-ty)]
    [(I16) (Some param-ty)]
    [(U16) (Some param-ty)]
    [(I32) (Some param-ty)]
    [(U32) (Some param-ty)]
    [(I64) (Some param-ty)]
    [(U64) (Some param-ty)]
    [(F32) (Some param-ty)]
    [(F64) (Some param-ty)]
    [(Bool) (Some param-ty)]
    [_ (No)]))

;; Call-by-value for an inlined helper (#7541). Every argument that cannot be
;; rematerialized is bound, in argument order, to a fresh hygienic
;; local, and the parameter is substituted by that
;; local; `staged` collects those bindings for the `let` that wraps the body.
;; So each such argument is evaluated exactly once, left to right, before the
;; body, whether the body reads its parameter once, twice or not at all. A stable
;; argument is substituted as it is.
(define (lower-spmd-inline-build-subst-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [subst : LowerSpmdInlineSubst]
  [staged : (&mut staged ast.AstLetBindingList)]
  [origin : ast.AstExpr]) : ResultLowerSpmdInlineSubst
  (cond
    [(>= index (ast.ast-param-list-len params))
      (if (= index args.len)
        (Ok subst)
        (Err
          (box (lower-diagnostic-at-expr ctx origin "lower: arity mismatch"))))]
    [(>= index args.len)
      (Err (box (lower-diagnostic-at-expr ctx origin "lower: arity mismatch")))]
    [else
      (let
        [arg-id : i64 (ast.ast-expr-list-get args index 0)]
        [arg : ast.AstExpr (lower-context-expr-get ctx arg-id)]
        (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
          [(Param param-name param-ty _)
            (lower-spmd-inline-build-subst-at
              ctx
              function-state
              params
              args
              (+ index 1)
              (if (lower-spmd-inline-arg-stable?
                ctx
                (lower-global-shared-view arg))
                (lower-spmd-inline-subst-cons param-name arg subst)
                (let
                  [local : i64
                    (lower-spmd-inline-fresh-local-id function-state param-name)]
                  (ast.ast-let-binding-list-push
                    staged
                    (ast.ast-let-binding-id
                      local
                      (lower-spmd-inline-staged-type param-ty)
                      arg-id))
                  (lower-spmd-inline-subst-cons param-name (Var local) subst)))
              staged
              origin)]))]))

(define (lower-spmd-inline-expr-list
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]) : ResultLowerAstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity exprs.len)]
    [_
      (try
        (lower-spmd-inline-expr-list-into
          ctx
          function-state
          env
          type-env
          (& exprs)
          0
          subst
          shadowed
          (&mut out)))]
    (Ok out)))

(define (lower-spmd-inline-expr-list-into
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]
  [out : (&mut out ast.AstExprList)]) : ResultLowerAstExprList
  (if (>= index exprs.len)
    (Ok (ast.ast-expr-list-new))
    (let
      [head-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [head : ast.AstExpr (lower-context-expr-get ctx head-id)]
      [rewritten-head
        (try
          (lower-spmd-inline-expr
            ctx
            function-state
            env
            type-env
            head
            subst
            shadowed))]
      (ast.ast-expr-list-push out (lower-context-expr-push ctx rewritten-head))
      (lower-spmd-inline-expr-list-into
        ctx
        function-state
        env
        type-env
        exprs
        (+ index 1)
        subst
        shadowed
        out))))

(define (lower-spmd-inline-let-bindings
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : ast.AstLetBindingList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]) : ResultLowerSpmdInlineLetBindings
  (let
    [out : ast.AstLetBindingList
      (ast.ast-let-binding-list-with-capacity
        (ast.ast-let-binding-list-len (& bindings)))]
    (match (lower-spmd-inline-let-bindings-into
      ctx
      function-state
      env
      type-env
      (& bindings)
      subst
      shadowed
      0
      (&mut out))
      [(Ok body-subst body-shadowed)
        (Ok (Bindings out body-subst body-shadowed))]
      [(Err diag) (Err diag)])))

(define (lower-spmd-inline-let-bindings-into
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]
  [index : i64]
  [out : (&mut out ast.AstLetBindingList)]) : ResultLowerSpmdInlineLetBindingsBuild
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok subst shadowed)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [renamed : bool (> subst.len 0)]
          [bind-id : i64
            (if renamed
              (lower-spmd-inline-fresh-local-id function-state name)
              name)]
          [rewritten-init
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                init
                subst
                shadowed))]
          (ast.ast-let-binding-list-push
            out
            (ast.ast-let-binding-id
              bind-id
              maybe-ty
              (lower-context-expr-push ctx rewritten-init)))
          (lower-spmd-inline-let-bindings-into
            ctx
            function-state
            env
            type-env
            bindings
            (if renamed
              (lower-spmd-inline-subst-cons
                name
                (Var bind-id)
                (lower-spmd-inline-subst-remove subst name))
              (lower-spmd-inline-subst-remove subst name))
            (lower-id-set-insert shadowed name)
            (+ index 1)
            out))])))

(define (lower-spmd-inline-helper-body
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [handle : i64]
  [params : ast.AstParamList]
  [args : ast.AstExprList]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerAstExpr
  (let
    [staged : ast.AstLetBindingList (ast.ast-let-binding-list-with-capacity 0)]
    [helper-subst
      (try
        (lower-spmd-inline-build-subst-at
          ctx
          function-state
          (& params)
          (& args)
          0
          (lower-spmd-inline-subst-empty)
          (&mut staged)
          (lower-global-shared-view origin)))]
    [previous : LowerIdSet
      (compiler-lower-function-state-inline-helper-stack function-state)]
    [result : ResultLowerAstExpr
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            (lower-spmd-inline-recursive-message))))]
    (compiler-lower-function-state-inline-helper-stack-set!
      function-state
      (lower-id-set-insert (lower-global-shared-view previous) handle))
    (set!
      result
      (let
        [shadowed (lower-id-set-empty)]
        (lower-spmd-inline-expr
          ctx
          function-state
          env
          type-env
          body
          helper-subst
          shadowed)))
    (compiler-lower-function-state-inline-helper-stack-set!
      function-state
      previous)
    (let
      [rewritten (try result)]
      (if (= (ast.ast-let-binding-list-len (& staged)) 0)
        (Ok rewritten)
        (Ok
          (lower-context-expr-get
            ctx
            (ast.ast-expr-let-with-pools
              (tc_core.tc-context-pools ctx)
              staged
              (lower-context-expr-push ctx rewritten))))))))

;; Keep the established small-helper rewrite, but stop cloning larger helper
;; bodies into every vector call site. The limit is deliberately an internal
;; lowering choice: it does not add a source attribute or public varying type.
(define lower-spmd-inline-node-limit : i64
  12)

(define (lower-spmd-inline-expr-list-cost
  [ctx : tc_core.TcContext]
  [exprs : ast.AstExprList]) : i64
  (lower-spmd-inline-expr-list-cost-at ctx (& exprs) 0))

(define (lower-spmd-inline-expr-list-cost-at
  [ctx : tc_core.TcContext]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : i64
  (if (>= index exprs.len)
    0
    (+
      (lower-spmd-inline-expr-cost
        ctx
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-spmd-inline-expr-list-cost-at ctx exprs (+ index 1)))))

(define (lower-spmd-inline-let-cost
  [ctx : tc_core.TcContext]
  [bindings : ast.AstLetBindingList]) : i64
  (lower-spmd-inline-let-cost-at ctx (& bindings) 0))

(define (lower-spmd-inline-let-cost-at
  [ctx : tc_core.TcContext]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : i64
  (if (>= index (ast.ast-let-binding-list-len bindings))
    0
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx init-box))
          (lower-spmd-inline-let-cost-at ctx bindings (+ index 1)))])))

(define (lower-spmd-inline-expr-cost
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(Spanned inner-box _)
      (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box))]
    [(Cast inner-box _)
      (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box))]
    [(Unary _ inner-box)
      (+
        1
        (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box)))]
    [(Binary _ left-box right-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx left-box))
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx right-box))))]
    [(Call func-box args)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx func-box))
          (lower-spmd-inline-expr-list-cost ctx args)))]
    [(If cond-box then-box else-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx cond-box))
          (+
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx then-box))
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx else-box)))))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (+
            1
            (+
              (lower-spmd-inline-let-cost ctx bindings)
              (lower-spmd-inline-expr-cost
                ctx
                (lower-context-expr-get ctx body-box))))])]
    [(Begin exprs) (+ 1 (lower-spmd-inline-expr-list-cost ctx exprs))]
    [(ArrayRef array-box index-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx array-box))
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx index-box))))]
    [(ArraySet array-box index-box value-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx array-box))
          (+
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx index-box))
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx value-box)))))]
    [_ 1]))

(define (lower-spmd-helper-out-of-line?
  [ctx : tc_core.TcContext]
  [body : ast.AstExpr]) : bool
  (> (lower-spmd-inline-expr-cost ctx body) lower-spmd-inline-node-limit))

(define (lower-spmd-preserve-call
  [ctx : tc_core.TcContext]
  [func : ast.AstExpr]
  [rewritten-args : ast.AstExprList]) : ResultLowerAstExpr
  (Ok
    (lower-context-expr-get
      ctx
      (ast.ast-expr-call-with-pools
        (tc_core.tc-context-pools ctx)
        (lower-context-expr-push ctx func)
        rewritten-args))))

(define (lower-spmd-inline-call
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]
  [origin : ast.AstExpr]) : ResultLowerAstExpr
  (let
    [rewritten-args
      (try
        (lower-spmd-inline-expr-list
          ctx
          function-state
          env
          type-env
          args
          (lower-global-shared-view subst)
          (lower-global-shared-view shadowed)))]
    [helper
      (try
        (lower-spmd-inline-helper-lookup
          ctx
          function-state
          env
          type-env
          (lower-global-shared-view shadowed)
          (lower-global-shared-view func)))]
    (match helper
      [(Some name params _ body)
        (if (lower-spmd-helper-out-of-line? ctx (lower-global-shared-view body))
          (lower-spmd-preserve-call ctx func rewritten-args)
          (lower-spmd-inline-helper-body
            ctx
            function-state
            env
            type-env
            name
            params
            rewritten-args
            body
            origin))]
      [(Imported _ _ _ _ _) (lower-spmd-preserve-call ctx func rewritten-args)]
      [(No)
        (let
          [rewritten-func : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                func
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-call-with-pools
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten-func)
                rewritten-args))))])))

(define (lower-spmd-inline-expr
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [subst : (& subst LowerSpmdInlineSubst)]
  [shadowed : (& shadowed LowerIdSet)]) : ResultLowerAstExpr
  (let
    [subst : LowerSpmdInlineSubst
      (owned_view.compiler-owned-reference-shared-view subst)]
    [shadowed : LowerIdSet
      (owned_view.compiler-owned-reference-shared-view shadowed)]
    (match (lower-global-shared-view expr)
      [(Spanned inner-box span)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          [rewritten : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                inner
                subst
                shadowed))]
          [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-spanned-with-pools
                pools
                (lower-context-expr-push ctx rewritten)
                span))))]
      [(Var name)
        (match (lower-spmd-inline-subst-lookup subst name)
          [(Some value) (Ok value)]
          [(No) (Ok expr)])]
      [(Binary op left-box right-box)
        (let
          [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
          [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
          [rewritten-left
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                left
                subst
                shadowed))]
          [rewritten-right : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                right
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-binary-with-pools
                (tc_core.tc-context-pools ctx)
                op
                (lower-context-expr-push ctx rewritten-left)
                (lower-context-expr-push ctx rewritten-right)))))]
      [(Unary op inner-box)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          [rewritten : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                inner
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-unary-with-pools
                (tc_core.tc-context-pools ctx)
                op
                (lower-context-expr-push ctx rewritten)))))]
      [(Call func-box args)
        (let
          [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
          (lower-spmd-inline-call
            ctx
            function-state
            env
            type-env
            func
            args
            subst
            shadowed
            expr))]
      [(If cond-box then-box else-box)
        (let
          [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
          [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
          [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
          [rewritten-cond
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                cond
                subst
                shadowed))]
          [rewritten-then
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                then-branch
                subst
                shadowed))]
          [rewritten-else : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                else-branch
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-if-with-pools
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten-cond)
                (lower-context-expr-push ctx rewritten-then)
                (lower-context-expr-push ctx rewritten-else)))))]
      [(Let let-box)
        (match (__tl-box-place let-box)
          [(Let bindings body-box)
            (let
              [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
              [rewritten : LowerSpmdInlineLetBindings
                (try
                  (lower-spmd-inline-let-bindings
                    ctx
                    function-state
                    env
                    type-env
                    bindings
                    subst
                    shadowed))]
              (match rewritten
                [(Bindings rewritten-bindings body-subst body-shadowed)
                  (let
                    [rewritten-body : ast.AstExpr
                      (try
                        (lower-spmd-inline-expr
                          ctx
                          function-state
                          env
                          type-env
                          body
                          body-subst
                          body-shadowed))]
                    (Ok
                      (lower-context-expr-get
                        ctx
                        (ast.ast-expr-let-with-pools
                          (tc_core.tc-context-pools ctx)
                          rewritten-bindings
                          (lower-context-expr-push ctx rewritten-body)))))]))])]
      [(Begin exprs)
        (let
          [rewritten : ast.AstExprList
            (try
              (lower-spmd-inline-expr-list
                ctx
                function-state
                env
                type-env
                exprs
                subst
                shadowed))]
          (Ok (Begin rewritten)))]
      [(Ann inner-box ty-id)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          [rewritten : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                inner
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-ann-with-pools-id
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten)
                ty-id))))]
      [(Cast inner-box ty-id)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          [rewritten : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                inner
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-cast-with-pools-id
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten)
                ty-id))))]
      [(ArrayRef array-box index-box)
        (let
          [array : ast.AstExpr (lower-context-expr-get ctx array-box)]
          [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
          [rewritten-array
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                array
                subst
                shadowed))]
          [rewritten-index : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                index
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-array-ref-with-pools
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten-array)
                (lower-context-expr-push ctx rewritten-index)))))]
      [(ArraySet array-box index-box value-box)
        (let
          [array : ast.AstExpr (lower-context-expr-get ctx array-box)]
          [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
          [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
          [rewritten-array
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                array
                subst
                shadowed))]
          [rewritten-index
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                index
                subst
                shadowed))]
          [rewritten-value : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                value
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-array-set-with-pools
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten-array)
                (lower-context-expr-push ctx rewritten-index)
                (lower-context-expr-push ctx rewritten-value)))))]
      [(ArrayTake array-box live-box index-box)
        (let
          [array : ast.AstExpr (lower-context-expr-get ctx array-box)]
          [live : ast.AstExpr (lower-context-expr-get ctx live-box)]
          [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
          [rewritten-array
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                array
                subst
                shadowed))]
          [rewritten-live
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                live
                subst
                shadowed))]
          [rewritten-index : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                index
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-array-take-with-pools
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten-array)
                (lower-context-expr-push ctx rewritten-live)
                (lower-context-expr-push ctx rewritten-index)))))]
      [(Replace place-box replacement-box)
        (let
          [place : ast.AstExpr (lower-context-expr-get ctx place-box)]
          [replacement : ast.AstExpr
            (lower-context-expr-get ctx replacement-box)]
          [rewritten-place
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                place
                subst
                shadowed))]
          [rewritten-replacement : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                replacement
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-replace-with-pools
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten-place)
                (lower-context-expr-push ctx rewritten-replacement)))))]
      [(StructSet receiver-box field value-box)
        (let
          [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
          [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
          [rewritten-receiver
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                receiver
                subst
                shadowed))]
          [rewritten-value : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                value
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-struct-set-id-with-pools
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten-receiver)
                field
                (lower-context-expr-push ctx rewritten-value)))))]
      [(SpmdScan scan-box)
        (match (__tl-box-place scan-box)
          [(Scan
              op
              index
              index-ty
              start-box
              end-box
              prefix
              prefix-ty
              init-box
              value-box
              body-box)
            (let
              [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
              [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
              [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
              [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
              [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
              [rewritten-start
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    start
                    subst
                    shadowed))]
              [rewritten-end
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    end
                    subst
                    shadowed))]
              [rewritten-init
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    init
                    subst
                    shadowed))]
              [rewritten-value
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    value
                    subst
                    shadowed))]
              [rewritten-body : ast.AstExpr
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    body
                    subst
                    shadowed))]
              (Ok
                (SpmdScan
                  (box
                    (ast.AstSpmdScan.Scan
                      op
                      index
                      index-ty
                      (lower-context-expr-push ctx rewritten-start)
                      (lower-context-expr-push ctx rewritten-end)
                      prefix
                      prefix-ty
                      (lower-context-expr-push ctx rewritten-init)
                      (lower-context-expr-push ctx rewritten-value)
                      (lower-context-expr-push ctx rewritten-body))))))])]
      [(SpmdCompact compact-box)
        (match (__tl-box-place compact-box)
          [(Compact
              index
              index-ty
              start-box
              end-box
              slot
              slot-ty
              init-box
              keep-box
              body-box)
            (let
              [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
              [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
              [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
              [keep : ast.AstExpr (lower-context-expr-get ctx keep-box)]
              [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
              [rewritten-start
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    start
                    subst
                    shadowed))]
              [rewritten-end
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    end
                    subst
                    shadowed))]
              [rewritten-init
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    init
                    subst
                    shadowed))]
              [rewritten-keep
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    keep
                    subst
                    shadowed))]
              [rewritten-body : ast.AstExpr
                (try
                  (lower-spmd-inline-expr
                    ctx
                    function-state
                    env
                    type-env
                    body
                    subst
                    shadowed))]
              (Ok
                (SpmdCompact
                  (box
                    (ast.AstSpmdCompact.Compact
                      index
                      index-ty
                      (lower-context-expr-push ctx rewritten-start)
                      (lower-context-expr-push ctx rewritten-end)
                      slot
                      slot-ty
                      (lower-context-expr-push ctx rewritten-init)
                      (lower-context-expr-push ctx rewritten-keep)
                      (lower-context-expr-push ctx rewritten-body))))))])]
      [(SpmdBroadcast value-box lane-box)
        (let
          [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
          [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
          [rewritten-value
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                value
                subst
                shadowed))]
          [rewritten-lane : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                lane
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-spmd-broadcast-with-pools
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten-value)
                (lower-context-expr-push ctx rewritten-lane)))))]
      [(SpmdShuffle value-box lane-box)
        (let
          [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
          [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
          [rewritten-value
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                value
                subst
                shadowed))]
          [rewritten-lane : ast.AstExpr
            (try
              (lower-spmd-inline-expr
                ctx
                function-state
                env
                type-env
                lane
                subst
                shadowed))]
          (Ok
            (lower-context-expr-get
              ctx
              (ast.ast-expr-spmd-shuffle-with-pools
                (tc_core.tc-context-pools ctx)
                (lower-context-expr-push ctx rewritten-value)
                (lower-context-expr-push ctx rewritten-lane)))))]
      [_ (Ok expr)])))

(define (lower-function-logical-id-from-decl
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameCacheMaybeId
  (match decl
    [(DefFn decl-meta name _ _ _ _)
      (Some
        (lower-decl-logical-id
          lower-state
          entry-path
          decl-path
          module
          module-id
          name
          (lower-name-id-text lower-state name)))]
    [(Unsafe inner-box)
      (lower-function-logical-id-from-decl
        lower-state
        entry-path
        decl-path
        module
        module-id
        (deref inner-box))]
    [_ (No)]))

(define (lower-function-set-from-decls-in-module
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [paths : (& paths ast.AstDeclPathList)]
  [entry-path : String]
  [_module : String]
  [module-id : i64]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [cur-out : lower_i64_i64_map.Map out]
    (while (< index count)
      (let
        [decl : ast.AstDecl
          (lower-global-array-element-shared-view
            decls.slots
            (+ decls.offset index))]
        [decl-path : String
          (ast.ast-decl-path-list-get
            (& paths)
            index
            (lower-global-shared-view entry-path))]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            lower-state
            (& paths)
            index
            (lower-global-shared-view entry-path)
            (lower-global-shared-view decl-path)
            cur-module-id)]
        (match (lower-global-shared-view decl)
          [(Module next-module) (set! cur-module-id next-module)]
          [_
            (match (lower-function-logical-id-from-decl
              lower-state
              (lower-global-shared-view entry-path)
              decl-path
              (lower-decl-owner-module-name
                lower-state
                cur-module-id
                logical-module-id)
              logical-module-id
              decl)
              ;; Assign each distinct function name a dense slot
              ;; (0..N-1, its insertion order) instead of a constant 1, so
              ;; prune reachability `reachable` can key on that i64 slot.
              ;; Skip names already present so the slot stays a bijection.
              [(Some logical-id)
                (if (lower_i64_i64_map.contains? (& cur-out) logical-id)
                  unit
                  (let
                    [slot : i64 (lower_i64_i64_map.len (& cur-out))]
                    (lower_i64_i64_map.insert-ref!
                      (&mut cur-out)
                      logical-id
                      slot)))]
              [(No) unit])])
        (set! index (+ index 1))))
    cur-out))

(define (lower-function-set-from-decls
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [paths : (& paths ast.AstDeclPathList)]
  [entry-path : String]) : lower_i64_i64_map.Map
  (lower-function-set-from-decls-in-module
    lower-state
    decls
    paths
    entry-path
    ""
    cbi.compiler-builtin-id-fix-empty
    (lower_i64_i64_map.with-capacity 8192)))

(define (lower-reach-add-logical
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [state : LowerReachState]
  [logical-id : i64]) : LowerReachState
  (match (lower_i64_i64_map.get (& all-functions) logical-id)
    [(LookupMissing) state]
    [(LookupFound slot)
      (match (lower-global-shared-view state)
        [(State reachable worklist lower-state)
          (if (lower_i64_i64_map.contains? (& reachable) slot)
            state
            (let
              [next-reachable : lower_i64_i64_map.Map reachable]
              (lower_i64_i64_map.insert-ref! (&mut next-reachable) slot 1)
              (State
                next-reachable
                (lower-id-set-push worklist logical-id)
                lower-state)))])]))

(define (lower-runtime-prelude-string-helper-id
  [session : cis.InternStructuralSessionHandle]
  [source-id : i64]) : i64
  (let
    [raw-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        session
        source-id
        source-id)]
    [base-id : i64 (tc_core.tc-qualified-name-base-id raw-id)]
    (cond
      [(= base-id cbi.compiler-builtin-id-tl-int-to-string)
        cbi.compiler-builtin-id-runtime-int-to-string]
      [(= base-id cbi.compiler-builtin-id-tl-substring)
        cbi.compiler-builtin-id-runtime-substring]
      [(= base-id cbi.compiler-builtin-id-tl-str-view)
        cbi.compiler-builtin-id-runtime-str-view]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat)
        cbi.compiler-builtin-id-string-concat]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat3)
        cbi.compiler-builtin-id-runtime-string-concat3]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat4)
        cbi.compiler-builtin-id-runtime-string-concat4]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat5)
        cbi.compiler-builtin-id-runtime-string-concat5]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-load-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-load)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-load-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-load-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-store-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-store)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-store-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-store-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-fetch-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-fetch-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-fetch-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-fetch-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-cas-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-cas)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-cas-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-cas-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-load-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-load)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-load-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-load-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-store-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-store)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-store-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-store-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-fetch-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-fetch-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-fetch-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-fetch-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-cas-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-cas)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-cas-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-cas-ptr]
      [else -1])))

(define (lower-runtime-prelude-selective-export-id?
  [module-id : i64]
  [symbol-id : i64]) : bool
  (and
    (= module-id cbi.compiler-builtin-id-runtime-module)
    (>=
      (lower-runtime-prelude-string-helper-id
        (cis.InternStructuralSessionHandle 0)
        symbol-id)
      0)))

(define (lower-reach-add-runtime-prelude-string-helper-id
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [state : LowerReachState]
  [source-id : i64]) : LowerReachState
  (let
    [helper-id : i64
      (lower-runtime-prelude-string-helper-id
        (match (lower-global-shared-view state)
          [(State _ _ lower-state)
            (compiler-lower-state-structural-session lower-state)])
        source-id)]
    (if (< helper-id 0)
      state
      (lower-reach-add-logical
        all-functions
        (lower-reach-add-logical all-functions state helper-id)
        (csym.compiler-symbol-module-key-id-by-id
          cbi.compiler-builtin-id-runtime-module
          helper-id)))))

(define (lower-reach-add-string-snapshot-runtime
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]) : LowerReachState
  ;; Clone-out/capture snapshot lowering copies owned String buffers through
  ;; the fixed `tl_substring` ABI helper, so keep its TypeLisp runtime body
  ;; when a reachable source form can synthesize that call after this prune
  ;; pass. Public stdlib string substring helpers are normal source functions;
  ;; explicit `tl_substring` extern references are rooted through the runtime
  ;; prelude helper path instead.
  (lower-reach-add-runtime-prelude-string-helper-resolved-id
    all-functions
    names
    state
    cbi.compiler-builtin-id-tl-substring))

(define (lower-reach-add-runtime-prelude-string-helper-resolved-id
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]
  [source-id : i64]) : LowerReachState
  (let
    [helper-id : i64
      (lower-runtime-prelude-string-helper-id
        (lower-name-cache-structural-session (& names))
        source-id)]
    (if (< helper-id 0)
      state
      (let
        [module-helper-id : i64
          (csym.compiler-symbol-module-key-id-by-id
            cbi.compiler-builtin-id-runtime-module
            helper-id)]
        [helper-logical-id : i64
          (lower-name-cache-resolve-logical-id (& names) helper-id helper-id)]
        [module-helper-logical-id : i64
          (lower-name-cache-resolve-logical-id
            (& names)
            module-helper-id
            module-helper-id)]
        (lower-reach-add-logical
          all-functions
          (lower-reach-add-logical
            all-functions
            (lower-reach-add-runtime-prelude-string-helper-id
              all-functions
              state
              source-id)
            helper-logical-id)
          module-helper-logical-id)))))

;; `lower-string-concat` emits one of these fixed ABI calls after source
;; reachability has already completed. Root their TypeLisp runtime exports from
;; the source call so pruning cannot leave the generated call unresolved.
(define (lower-reach-add-string-concat-runtime
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]) : LowerReachState
  (lower-reach-add-runtime-prelude-string-helper-resolved-id
    all-functions
    names
    (lower-reach-add-runtime-prelude-string-helper-resolved-id
      all-functions
      names
      (lower-reach-add-runtime-prelude-string-helper-resolved-id
        all-functions
        names
        (lower-reach-add-runtime-prelude-string-helper-resolved-id
          all-functions
          names
          state
          cbi.compiler-builtin-id-tl-string-concat)
        cbi.compiler-builtin-id-tl-string-concat3)
      cbi.compiler-builtin-id-tl-string-concat4)
    cbi.compiler-builtin-id-tl-string-concat5))

(define (lower-reach-legacy-string-concat-source-id?
  [session : cis.InternStructuralSessionHandle]
  [source-id : i64]) : bool
  (let
    [raw-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        session
        source-id
        source-id)]
    ;; These legacy intrinsics have no source definition to resolve. A user
    ;; definition with the same spelling can retain unused runtime exports,
    ;; but it cannot change the source program's behavior.
    (or
      (= raw-id cbi.compiler-builtin-id-string-append)
      (= raw-id cbi.compiler-builtin-id-string-concat))))

(define (lower-reach-stdlib-string-concat-logical-id?
  [names : (& names LowerNameCache)]
  [logical-id : i64]) : bool
  ;; Alias spellings are no longer present once the reach worklist reaches the
  ;; public wrapper. Compare its resolved logical identity instead, so a
  ;; compiler-fused `string_mod.append` (or macro-generated alias) also keeps
  ;; the post-prune runtime ABI exports.
  (let
    [module-id : i64 cbi.compiler-builtin-id-fix-stdlib_dot_string]
    [append-id : i64
      (csym.compiler-symbol-module-key-id-by-id
        module-id
        cbi.compiler-builtin-id-fix-append)]
    [concat-id : i64
      (csym.compiler-symbol-module-key-id-by-id
        module-id
        cbi.compiler-builtin-id-fix-concat)]
    (or
      (=
        logical-id
        (lower-name-cache-resolve-logical-id (& names) append-id append-id))
      (=
        logical-id
        (lower-name-cache-resolve-logical-id (& names) concat-id concat-id)))))

(define (lower-reach-public-string-concat-source-id?
  [names : (& names LowerNameCache)]
  [source-id : i64]) : bool
  ;; Resolve aliases before deciding whether this source call can be fused. The
  ;; generated runtime calls need reachability roots only for a nested public
  ;; tree, not for every ordinary `string.append` wrapper call.
  (let
    [mapped-source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        (lower-name-cache-structural-session (& names))
        source-id
        source-id)]
    [hygiene-key-id : i64
      (tc_core.tc-env-name-key-id
        (lower-name-cache-structural-session (& names))
        source-id)]
    [hygiene-logical-id : i64
      (if (= hygiene-key-id source-id)
        -1
        (lower-name-cache-lookup-logical-id (& names) hygiene-key-id -1))]
    [logical-id : i64
      (if (>= hygiene-logical-id 0)
        hygiene-logical-id
        (lower-name-cache-resolve-logical-id (& names) mapped-source-id -1))]
    (lower-reach-stdlib-string-concat-logical-id? names logical-id)))

(define (lower-reach-public-float-to-bits-source-id?
  [names : LowerNameCache]
  [source-id : i64]) : bool
  (let
    [mapped-source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        (lower-name-cache-structural-session (& names))
        source-id
        source-id)]
    [hygiene-key-id : i64
      (tc_core.tc-env-name-key-id
        (lower-name-cache-structural-session (& names))
        source-id)]
    [hygiene-logical-id : i64
      (if (= hygiene-key-id source-id)
        -1
        (lower-name-cache-lookup-logical-id (& names) hygiene-key-id -1))]
    [logical-id : i64
      (if (>= hygiene-logical-id 0)
        hygiene-logical-id
        (lower-name-cache-resolve-logical-id (& names) mapped-source-id -1))]
    (if (< logical-id 0)
      false
      (match (lower-name-cache-lookup-id names logical-id)
        [(Some name) (lower-float-to-bits-public-target? name)]
        [(No) false]))))

(define (lower-reach-float-to-bits-literal-arg?
  [pools : (& pools ast.AstNodePoolContext)]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-pools pools expr)
    [(Literal lit)
      (match lit
        [(Float _) true]
        [_ false])]
    [(Ann inner-box _)
      (match (ast.ast-expr-unspan-with-pools
        pools
        (ast.ast-node-pool-context-expr-get pools inner-box))
        [(Literal lit)
          (match lit
            [(Float _) true]
            [_ false])]
        [_ false])]
    [(Cast inner-box _)
      (match (ast.ast-expr-unspan-with-pools
        pools
        (ast.ast-node-pool-context-expr-get pools inner-box))
        [(Literal lit)
          (match lit
            [(Float _) true]
            [_ false])]
        [_ false])]
    [_ false]))

(define (lower-reach-string-concat-call?
  [pools : (& pools ast.AstNodePoolContext)]
  [names : (& names LowerNameCache)]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-pools pools expr)
    [(Call callee-box args)
      (let
        [callee : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools callee-box)]
        (match (ast.ast-expr-unspan-with-pools pools callee)
          [(Var name)
            (and
              (= args.len 2)
              (or
                (lower-reach-legacy-string-concat-source-id?
                  (lower-name-cache-structural-session (& names))
                  name)
                (lower-reach-public-string-concat-source-id? names name)))]
          [_ false]))]
    [_ false]))

(define (lower-reach-public-string-concat-tree?
  [pools : (& pools ast.AstNodePoolContext)]
  [names : (& names LowerNameCache)]
  [callee : ast.AstExpr]
  [args : (& args ast.AstExprList)]) : bool
  (if (= args.len 2)
    (match (ast.ast-expr-unspan-with-pools pools callee)
      [(Var name)
        (and
          (lower-reach-public-string-concat-source-id? names name)
          (let
            [left : ast.AstExpr
              (ast.ast-node-pool-context-expr-get
                pools
                (ast.ast-expr-list-get (& args) 0 0))]
            [right : ast.AstExpr
              (ast.ast-node-pool-context-expr-get
                pools
                (ast.ast-expr-list-get (& args) 1 0))]
            (or
              (lower-reach-string-concat-call? pools names left)
              (lower-reach-string-concat-call? pools names right))))]
      [_ false])
    false))

(define (lower-reach-string-snapshot-source-call?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-clone-id?
    (tc_core.macro-hygiene-global-source-name-id-or session name-id name-id)))

(define (lower-reach-add-source-id
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]
  [source-id : i64]) : LowerReachState
  (let
    [mapped-source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        (lower-name-cache-structural-session (& names))
        source-id
        source-id)]
    [hygiene-key-id : i64
      (tc_core.tc-env-name-key-id
        (lower-name-cache-structural-session (& names))
        source-id)]
    [hygiene-logical-id : i64
      (if (= hygiene-key-id source-id)
        -1
        (lower-name-cache-lookup-logical-id (& names) hygiene-key-id -1))]
    [logical-id : i64
      (if (>= hygiene-logical-id 0)
        hygiene-logical-id
        (lower-name-cache-resolve-logical-id (& names) mapped-source-id -1))]
    (lower-reach-add-runtime-prelude-string-helper-resolved-id
      all-functions
      names
      (lower-reach-add-stdlib-string-public-helper-id
        all-functions
        names
        (lower-reach-add-runtime-prelude-string-helper-id
          all-functions
          (lower-reach-add-logical all-functions state logical-id)
          source-id)
        source-id)
      source-id)))

(define (lower-reach-add-stdlib-string-public-helper-id
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]
  [source-id : i64]) : LowerReachState
  (let
    [raw-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        (lower-name-cache-structural-session (& names))
        source-id
        source-id)]
    [base-id : i64 (tc_core.tc-qualified-name-base-id raw-id)]
    (if (or
      (= base-id cbi.compiler-builtin-id-string-length)
      (= base-id cbi.compiler-builtin-id-string-ref)
      (= base-id cbi.compiler-builtin-id-char-at)
      (= base-id cbi.compiler-builtin-id-string-eq)
      (= base-id cbi.compiler-builtin-id-string-eq-question)
      (= base-id cbi.compiler-builtin-id-string-to-int))
      (let
        [module-source-id : i64
          (csym.compiler-symbol-module-key-id-by-id
            cbi.compiler-builtin-id-fix-stdlib_dot_string
            base-id)]
        (lower-reach-add-logical
          all-functions
          state
          (lower-name-cache-resolve-logical-id
            (& names)
            module-source-id
            module-source-id)))
      state)))

(define (lower-reach-state-owner [state : LowerReachState]) : CompilerLowerState
  (match state
    [(State _ _ lower-state) lower-state]))

(define (lower-reach-used-type-name-add-source!
  [lower-state : CompilerLowerState]
  [name : i64]) : unit
  (if (or
    (tc_core.tc-name-qualified-id?
      (compiler-lower-state-structural-session lower-state)
      name)
    (>=
      (tc_core.tc-name-first-dot-id
        (compiler-lower-state-structural-session lower-state)
        name)
      0))
    (compiler-lower-state-write!
      lower-state
      lower_i64_i64_map.Map
      reach-active-body-used-types
      (lower-used-type-name-add
        (compiler-lower-state-structural-session lower-state)
        (compiler-lower-state-read
          lower-state
          lower_i64_i64_map.Map
          reach-active-body-used-types)
        ""
        name))
    unit))

(define (lower-reach-used-types-add-pattern-roots!
  [lower-state : CompilerLowerState]
  [pattern : ast.AstPattern]) : unit
  (match pattern
    [(Var _ _) unit]
    [(Tuple patterns-box)
      (lower-reach-used-types-add-pattern-list-roots!
        lower-state
        (deref patterns-box))]
    [(Array patterns-box)
      (lower-reach-used-types-add-pattern-list-roots!
        lower-state
        (deref patterns-box))]
    [(Slice patterns-box _)
      (lower-reach-used-types-add-pattern-list-roots!
        lower-state
        (deref patterns-box))]
    [(Wildcard) unit]
    [(Binding _) unit]
    [(Variant name patterns-box)
      (lower-reach-used-type-name-add-source! lower-state name)
      (lower-reach-used-types-add-pattern-list-roots!
        lower-state
        (deref patterns-box))]
    [(Literal _) unit]))

(define (lower-reach-used-types-add-pattern-list-roots!
  [lower-state : CompilerLowerState]
  [patterns : ast.AstPatternList]) : unit
  (lower-reach-used-types-add-pattern-list-roots-at! lower-state (& patterns) 0))

(define (lower-reach-used-types-add-pattern-list-roots-at!
  [lower-state : CompilerLowerState]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]) : unit
  (unless
    (>= index patterns.len)
    (lower-reach-used-types-add-pattern-roots!
      lower-state
      (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback)))
    (lower-reach-used-types-add-pattern-list-roots-at!
      lower-state
      patterns
      (+ index 1))))

(define (lower-reach-expr-list
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [exprs : ast.AstExprList]) : LowerReachState
  (lower-reach-expr-list-at pools all-functions names state (& exprs) 0))

(define (lower-reach-expr-list-at
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : LowerReachState
  (if (>= index exprs.len)
    state
    (let
      [expr-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [expr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools expr-id)]
      (lower-reach-expr-list-at
        pools
        all-functions
        (lower-global-shared-view names)
        (lower-reach-expr pools all-functions names state expr)
        exprs
        (+ index 1)))))

(define (lower-reach-let-bindings
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : ast.AstLetBindingList]) : LowerReachState
  (lower-reach-let-bindings-at pools all-functions names state (& bindings) 0))

(define (lower-reach-let-bindings-at
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : LowerReachState
  (if (>= index (ast.ast-let-binding-list-len bindings))
    state
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ value-box)
        (let
          [value : ast.AstExpr
            (ast.ast-node-pool-context-expr-get pools value-box)]
          (lower-reach-let-bindings-at
            pools
            all-functions
            (lower-global-shared-view names)
            (lower-reach-expr pools all-functions names state value)
            bindings
            (+ index 1)))])))

(define (lower-reach-match-arms
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [arms : ast.AstMatchArmList]) : LowerReachState
  (lower-reach-match-arms-at pools all-functions names state (& arms) 0))

(define (lower-reach-match-arms-at
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : LowerReachState
  (if (>= index arms.len)
    state
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-node-pool-context-expr-get pools body-box)]
          (lower-reach-used-types-add-pattern-roots!
            (lower-reach-state-owner (lower-global-shared-view state))
            pattern)
          (lower-reach-match-arms-at
            pools
            all-functions
            (lower-global-shared-view names)
            (lower-reach-expr pools all-functions names state body)
            arms
            (+ index 1)))])))

(define (lower-reach-resource-bindings
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : ast.AstResourceBindingList]) : LowerReachState
  (lower-reach-resource-bindings-at
    pools
    all-functions
    names
    state
    (& bindings)
    0))

(define (lower-reach-resource-bindings-at
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : LowerReachState
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    state
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding _ acquire-box cleanup-box _)
        (let
          [acquire : ast.AstExpr
            (ast.ast-node-pool-context-expr-get pools acquire-box)]
          [cleanup : ast.AstExpr
            (ast.ast-node-pool-context-expr-get pools cleanup-box)]
          (lower-reach-resource-bindings-at
            pools
            all-functions
            (lower-global-shared-view names)
            (lower-reach-expr
              pools
              all-functions
              (lower-global-shared-view names)
              (lower-reach-expr pools all-functions names state acquire)
              cleanup)
            bindings
            (+ index 1)))])))

(define (lower-clone-handoff-type-args
  [ctx : tc_core.TcContext]
  [pools : ast.AstNodePoolContext]
  [roots : clone_support.CloneRootEntries]) : ast.AstExprList
  (let
    [index : i64 (- (clone_support.clone-root-entries-len roots) 1)]
    [out : ast.AstExprList (ast.ast-expr-list-new)]
    ;; Dense roots expose logical newest-first order; cons from the oldest
    ;; logical entry back to index 0 so the list keeps that order.
    (while (>= index 0)
      (let
        [root-key-id : i64
          (clone_support.clone-root-entries-key-id-at-or roots index -1)]
        [module-id : i64
          (if (clone_support.clone-name-key-qualified? root-key-id)
            (clone_support.clone-name-key-module-id root-key-id)
            cbi.compiler-builtin-id-fix-empty)]
        (set!
          out
          (ast.ast-expr-cons
            (ast.ast-node-pool-context-expr-push
              pools
              (Literal (String module-id)))
            (ast.ast-expr-cons
              (ast.ast-node-pool-context-expr-push
                pools
                (TypeLiteral
                  (ast.ast-node-pool-context-type-push
                    pools
                    (tc_core.tc-resolve-type ctx (Var root-key-id)))))
              out)))
        (set! index (- index 1))))
    out))

(define (lower-clone-handoff-request-decl
  [ctx : tc_core.TcContext]
  [pools : ast.AstNodePoolContext]
  [roots : clone_support.CloneRootEntries]) : ast.AstDecl
  (let
    [callee : i64
      (ast.ast-node-pool-context-expr-push
        pools
        (Var
          (tc_core.macro-hygiene-global-id
            (tc_core.tc-context-structural-session ctx)
            cbi.compiler-builtin-id-fix-stdlib_dot_clone
            cbi.compiler-builtin-id-fix-synthesize_helpers
            false)))]
    [call-id : i64
      (ast.ast-expr-call-with-pools
        pools
        callee
        (lower-clone-handoff-type-args ctx pools roots))]
    (Import
      (ast.ast-decl-meta-runtime-shared-view)
      (Spec (MacroDecls call-id No) "" No No (box (ast.ast-decl-span-fallback))))))

(define (lower-clone-handoff-generated-origin-count-in-module
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [root-key-id : i64]
  [helper-name-id : i64]
  [module-id : i64]) : i64
  (match (ast.ast-decl-list-step decls)
    [(Nil) 0]
    [(Cons decl rest)
      (match (lower-global-shared-view decl)
        [(Module next-module)
          (lower-clone-handoff-generated-origin-count-in-module
            lower-state
            rest
            root-key-id
            helper-name-id
            next-module)]
        [_
          (+
            (match (ast.ast-decl-generated-meta decl)
              [(Some generator item _ key)
                (if (and
                  (string.eq generator "stdlib.clone/synthesize-helpers")
                  (string.eq
                    item
                    (compiler-lower-state-intern-str lower-state helper-name-id))
                  (tc_core.tc-string-prefix?
                    key
                    "decls:stdlib.clone:stdlib.clone/synthesize-helpers(")
                  (if (clone_support.clone-name-key-qualified? root-key-id)
                    (=
                      module-id
                      (clone_support.clone-name-key-module-id root-key-id))
                    (clone_support.clone-module-id-root? module-id))
                  (=
                    (clone_support.clone-helper-decl-count
                      (ast.ast-decl-cons
                        (ast.ast-decl-module-id module-id)
                        (ast.ast-decl-cons decl (ast.ast-decl-list-new)))
                      root-key-id
                      helper-name-id)
                    1))
                  1
                  0)]
              [(No) 0])
            (lower-clone-handoff-generated-origin-count-in-module
              lower-state
              rest
              root-key-id
              helper-name-id
              module-id))])]))

(define (lower-clone-handoff-generated-origin-count
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [root-key-id : i64]
  [helper-name-id : i64]) : i64
  (lower-clone-handoff-generated-origin-count-in-module
    lower-state
    decls
    root-key-id
    helper-name-id
    cbi.compiler-builtin-id-fix-empty))

;; Caches that may capture scratch-arena values produced by the handoff
;; expansion. Each is a pure memo rebuilt on demand; resetting them before the
;; scratch arena is destroyed mirrors the macro-walk boundary clears.
(define (lower-clone-handoff-expansion-cache-clear!
  [job-state : tc_core.TcJobState]) : unit
  (let
    [macro-state : tc_core.TcMacroState
      (tc_core.tc-job-state-macro-state job-state)]
    (tc_core.macro-generated-decls-memo-reset! macro-state)
    (tc_core.macro-generated-module-memo-reset! macro-state)
    (tc_core.tc-macro-helper-env-cache-reset! macro-state)
    (tc_core.tc-nominal-owner-cache-reset-for-job! job-state)
    (tc_core.macro-alias-derived-cache-reset-for-state! macro-state)
    (tc_core.tc-job-state-reset-file-state! job-state)
    (ctfe.ctfe-module-macro-export-reset-for-state!
      (tc_core.tc-macro-ctfe-state macro-state))))

;; The handoff expansion runs the full macro/CTFE machinery for every clone
;; root in one shot. Its working set (CTFE values, env spines, memo entries) is
;; dead once the generated helper declarations exist, but unlike the main macro
;; walk it runs after macro_detach -- no later pool compaction retires that
;; garbage, so it would stay in the persistent base arena for the rest of the
;; compile. Run the expansion in a scratch arena and
;; copy only the returned declarations out (the mark/rewind/clone-out shape of
;; tc-check-fn-decl-scoped): node-pool growth and interned spellings already
;; live in their persistent owners, type-node payloads are persisted at push
;; time by ty-node-persist, and ast-program-copy-append-with-pools deep-copies
;; the decl shells and any scratch-resident expr payloads, remapping the
;; appended expr/type ids.
(define (lower-clone-handoff-expansion-copy-out
  [pools : ast.AstNodePoolContext]
  [raw : tc_core.ResultMacroDeclExpansion]) : tc_core.ResultMacroDeclExpansion
  (match raw
    [(Ok generated generated-paths)
      (match (ast.ast-program-copy-append-with-pools
        pools
        pools
        (ast.ast-program generated))
        [(AstProgramCompaction copied _)
          (match copied
            [(Program decls-box)
              (Ok
                (deref decls-box)
                (lower-copy-paths-into-pools generated-paths pools))])])]
    [(Err diag) (Err (box (cdiag.compiler-diagnostic-copy (deref diag))))]))

(define (lower-clone-handoff-expand-one
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [source-decls : ast.AstDeclList]
  [entry-path : String]
  [pools : ast.AstNodePoolContext]
  [roots : clone_support.CloneRootEntries]) : tc_core.ResultMacroDeclExpansion
  (let
    [request : ast.AstDecl (lower-clone-handoff-request-decl ctx pools roots)]
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (arena.tl_arena_make)]
    (unsafe
      (arena.tl_arena_set scratch))
    (let
      [raw : tc_core.ResultMacroDeclExpansion
        (tc_core.macro-expand-decl-with-path
          (tc_core.tc-context-with-module-id
            ctx
            ""
            cbi.compiler-builtin-id-fix-empty)
          top-env
          top-env
          source-decls
          ""
          cbi.compiler-builtin-id-fix-empty
          request
          ;; This internal Clone request uses the closed core-macro prelude,
          ;; whose source-language cfg set is explicitly empty.
          (lower-source-language-cfgs)
          entry-path)]
      (unsafe
        (arena.tl_arena_set enclosing))
      (ast.ast-node-pool-context-capture-active! pools)
      (let
        [escaped : tc_core.ResultMacroDeclExpansion
          (lower-clone-handoff-expansion-copy-out pools raw)]
        (lower-clone-handoff-expansion-cache-clear!
          (tc_core.tc-context-job-state ctx))
        (unsafe
          (arena.tl_arena_destroy scratch))
        (ast.ast-node-pool-context-install! pools)
        escaped))))

(define (lower-clone-handoff-source-helper-root-id
  [lower-state : CompilerLowerState]
  [name-id : i64]
  [module-id : i64]
  [roots : clone_support.CloneRootEntries]) : i64
  (let
    [index : i64 0]
    [count : i64 (clone_support.clone-root-entries-len roots)]
    [found : i64 -1]
    (while (and (< index count) (< found 0))
      (let
        [root-key-id : i64
          (clone_support.clone-root-entries-key-id-at-or roots index -1)]
        [helper-name-id : i64
          (clone_support.clone-root-entries-helper-id-at-or roots index -1)]
        [root-module-id : i64
          (if (clone_support.clone-name-key-qualified? root-key-id)
            (clone_support.clone-name-key-module-id root-key-id)
            cbi.compiler-builtin-id-fix-empty)]
        (if (and
          (= module-id root-module-id)
          (string.eq
            (tc_core.tc-env-key-name-text name-id)
            (compiler-lower-state-intern-str lower-state helper-name-id)))
          (set! found root-key-id)
          unit)
        (set! index (+ index 1))))
    found))

(define (lower-clone-handoff-source-conflict-in-module
  [lower-state : CompilerLowerState]
  [source-decls : (& source-decls ast.AstDeclList)]
  [roots : clone_support.CloneRootEntries]
  [module-id : i64]) : i64
  ;; Index cursor rather than `ast-decl-list-step`; the first non-negative root
  ;; key still stops the walk. The wrapper peel stays by value -- it needs owned
  ;; `Box` storage to walk an `AstDecl.Unsafe` chain -- but it reads the
  ;; backing slot instead of a stepped-out 104 B copy.
  (let
    [count : i64 (ast.ast-decl-list-len (& source-decls))]
    [decl-slots : (__tl_dyn-array ast.AstDecl) source-decls.slots]
    [decl-offset : i64 source-decls.offset]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [found : i64 -1]
    (while (and (< found 0) (< index count))
      (match (ast.ast-decl-unwrapped
        (lower-global-array-element-shared-view
          decl-slots
          (+ decl-offset index)))
        [(Module next-module) (set! cur-module-id next-module)]
        [(DefFn decl-meta name _ _ _ _)
          (let
            [root-key-id : i64
              (lower-clone-handoff-source-helper-root-id
                lower-state
                name
                cur-module-id
                roots)]
            (if (>= root-key-id 0)
              (set! found root-key-id)
              unit))]
        [_ unit])
      (set! index (+ index 1)))
    found))

(define (lower-clone-handoff-source-conflict
  [lower-state : CompilerLowerState]
  [source-decls : (& source-decls ast.AstDeclList)]
  [roots : clone_support.CloneRootEntries]) : i64
  (lower-clone-handoff-source-conflict-in-module
    lower-state
    source-decls
    roots
    cbi.compiler-builtin-id-fix-empty))

(define (lower-clone-handoff-generated-roots-ok?
  [lower-state : CompilerLowerState]
  [generated : ast.AstDeclList]
  [roots : clone_support.CloneRootEntries]) : bool
  (let
    [index : i64 0]
    [count : i64 (clone_support.clone-root-entries-len roots)]
    [ok : bool true]
    (while (and (< index count) ok)
      (let
        [root-key-id : i64
          (clone_support.clone-root-entries-key-id-at-or roots index -1)]
        [helper-name-id : i64
          (clone_support.clone-root-entries-helper-id-at-or roots index -1)]
        (if (and
          (=
            (clone_support.clone-helper-decl-count
              (lower-global-shared-view generated)
              root-key-id
              helper-name-id)
            1)
          (=
            (lower-clone-handoff-generated-origin-count
              lower-state
              (lower-global-shared-view generated)
              root-key-id
              helper-name-id)
            1))
          unit
          (set! ok false))
        (set! index (+ index 1))))
    ok))

(define (lower-clone-handoff-generated-summary-at
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [remaining : i64]) : String
  (if (<= remaining 0)
    "..."
    (match (ast.ast-decl-list-step decls)
      [(Nil) "end"]
      [(Cons decl rest)
        (let
          [item : String
            (match (ast.ast-decl-unwrapped (lower-global-shared-view decl))
              [(Module module-id)
                (str_cat.str-cat
                  "module:"
                  (compiler-lower-state-name-text lower-state module-id))]
              [(DefFn decl-meta name _ _ _ _)
                (match (ast.ast-decl-generated-meta decl)
                  [(Some generator generated-item _ _)
                    (str_cat.str-cat
                      "fn:"
                      (compiler-lower-state-name-text lower-state name)
                      "@"
                      generator
                      "/"
                      generated-item)]
                  [(No)
                    (str_cat.str-cat
                      "fn:"
                      (compiler-lower-state-name-text lower-state name)
                      "@plain")])]
              [_ "other"])]
          (str_cat.str-cat
            item
            ","
            (lower-clone-handoff-generated-summary-at
              lower-state
              rest
              (- remaining 1))))])))

(define (lower-clone-handoff-generated-summary
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]) : String
  (str_cat.str-cat
    "count="
    (string.int->string (ast.ast-decl-list-len (& decls)))
    "["
    (lower-clone-handoff-generated-summary-at lower-state decls 8)
    "]"))

;; Expand roots in bounded chunks: the one-shot expansion's macro/CTFE working
;; set scales with the whole root list, but only one chunk's worth needs to be
;; live at a time.
;; Helpers are generated per type key, so chunking preserves the output union.
(define (lower-clone-handoff-expand-roots
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [source-decls : ast.AstDeclList]
  [entry-path : String]
  [pools : ast.AstNodePoolContext]
  [roots : clone_support.CloneRootEntries]
  [acc : ast.AstDeclList]) : tc_core.ResultMacroDecls
  (if (clone_support.clone-root-entries-empty? roots)
    (Ok acc)
    (let
      [chunk : clone_support.CloneRootEntries
        (clone_support.clone-root-entries-take roots 16)]
      [rest : clone_support.CloneRootEntries
        (clone_support.clone-root-entries-drop roots 16)]
      [expanded : tc_core.ResultMacroDeclExpansion
        (lower-clone-handoff-expand-one
          ctx
          top-env
          (lower-global-shared-view source-decls)
          (lower-global-shared-view entry-path)
          pools
          chunk)]
      (match expanded
        [(Ok generated _)
          (if (lower-clone-handoff-generated-roots-ok?
            lower-state
            (lower-global-shared-view generated)
            chunk)
            (begin
              (ast.ast-node-pool-context-capture-active! pools)
              (lower-clone-handoff-expand-roots
                lower-state
                ctx
                top-env
                source-decls
                entry-path
                pools
                rest
                (clone_support.clone-decl-list-append acc generated)))
            (let
              [root-key-id : i64
                (clone_support.clone-root-entries-key-id-at-or chunk 0 -1)]
              [helper-name-id : i64
                (clone_support.clone-root-entries-helper-id-at-or chunk 0 -1)]
              [message : String
                (str_cat.str-cat
                  "clone: stdlib handoff produced an invalid or conflicting helper for "
                  (clone_support.clone-name-key-string root-key-id)
                  " (helper-count="
                  (string.int->string
                    (clone_support.clone-helper-decl-count
                      (lower-global-shared-view generated)
                      root-key-id
                      helper-name-id))
                  ", origin-count="
                  (string.int->string
                    (lower-clone-handoff-generated-origin-count
                      lower-state
                      (lower-global-shared-view generated)
                      root-key-id
                      helper-name-id))
                  ", generated="
                  (lower-clone-handoff-generated-summary lower-state generated)
                  ")")]
              (Err (box (tc_core.tc-diag-at-start message)))))]
        [(Err diag) (Err diag)]))))

(define (lower-clone-handoff-augment
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [entry-path : String]
  [program : ast.AstProgram]
  [able : clone_support.CloneNameSet]
  [roots : clone_support.CloneRootEntries]
  [pools : ast.AstNodePoolContext]) : ResultLowerCloneAugment
  (let
    [_live-start : i64 (cfg compile-profile (profile.alloc-live) 0)]
    [result : ResultLowerCloneAugment
      (match program
        [(Program decls-box)
          (let
            [source-decls : ast.AstDeclList (deref decls-box)]
            [handoff-roots : clone_support.CloneRootEntries
              (clone_support.clone-stdlib-handoff-roots
                pools
                source-decls
                able
                roots)]
            [conflict : i64
              (begin
                ;; Clone roots carry structural generated-symbol identities. The
                ;; macro handoff below is their first text boundary.
                (clone_support.clone-root-entries-materialize-helper-names!
                  handoff-roots)
                (lower-clone-handoff-source-conflict
                  lower-state
                  source-decls
                  handoff-roots))]
            (if (>= conflict 0)
              (Err
                (str_cat.str-cat
                  "clone: conflicting helper producer for "
                  (clone_support.clone-helper-name
                    (clone_support.clone-name-key-string conflict))))
              (match (lower-clone-handoff-expand-roots
                lower-state
                ctx
                top-env
                (lower-global-shared-view source-decls)
                entry-path
                pools
                handoff-roots
                (ast.ast-decl-list-new))
                [(Ok handoff-decls)
                  (let
                    [augmented-decls : ast.AstDeclList
                      (clone_support.clone-decl-list-append
                        source-decls
                        handoff-decls)]
                    (Ok
                      (ast.ast-program augmented-decls)
                      handoff-decls
                      handoff-roots))]
                [(Err diag)
                  (let
                    [diagnostic : cdiag.CompilerDiagnostic (deref diag)]
                    (Err (cdiag.compiler-diagnostic-message diagnostic)))])))])]
    ;; What the handoff leaves live: the helpers it generated, not its
    ;; working memory.
    (begin
      (cfg
        compile-profile
        (compiler-lower-profile-counter
          "clone_handoff.retained_bytes"
          (- (profile.alloc-live) _live-start))
        unit)
      result)))

(define (lower-extend-checked-context-with-clone-decls
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [source-decl-count : i64]
  [program : ast.AstProgram]) : ResultLowerCheckedContext
  (match (lower-global-shared-view program)
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (deref decls-box)]
        [clone-decls : ast.AstDeclList
          (tc_core.tc-decl-list-drop decls source-decl-count)]
        [next-ctx : tc_core.TcContext
          (tc_core.tc-context-with-program ctx program)]
        [next-env
          (try (tc_core.env-extend-with-module next-ctx top-env clone-decls))]
        (tc_core.tc-context-capture-active-pools! next-ctx)
        (tc_core.tc-hygiene-reset-active-top-env!
          (tc_core.tc-context-macro-state next-ctx)
          next-env)
        (tc_core.tc-macro-helper-env-cache-reset!
          (tc_core.tc-context-macro-state next-ctx))
        (Ok next-ctx next-env))]))

(define (lower-reach-call-callee
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [callee : ast.AstExpr]
  [args : (& args ast.AstExprList)]) : LowerReachState
  (match (ast.ast-expr-unspan-with-pools
    pools
    (lower-global-shared-view callee))
    [(Var name)
      ;; Literal public-wrapper calls disappear into integer constants during
      ;; lowering, so do not keep an otherwise-dead wrapper just for that call.
      (if (and
        (= args.len 1)
        (lower-reach-float-to-bits-literal-arg?
          pools
          (ast.ast-node-pool-context-expr-get
            pools
            (ast.ast-expr-list-get (& args) 0 0)))
        (lower-reach-public-float-to-bits-source-id?
          (lower-global-shared-view names)
          name))
        state
        (lower-reach-add-source-id all-functions names state name))]
    [_ (lower-reach-expr pools all-functions names state callee)]))

(define (lower-reach-expr
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [expr : ast.AstExpr]) : LowerReachState
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(MacroExpansion inner-box _ _)
      (lower-reach-expr
        pools
        all-functions
        names
        state
        (ast.ast-node-pool-context-expr-get pools inner-box))]
    [(Literal _) state]
    [(Var name) (lower-reach-add-source-id all-functions names state name)]
    [(Binary _ lhs-box rhs-box)
      (let
        [lhs : ast.AstExpr (ast.ast-node-pool-context-expr-get pools lhs-box)]
        [rhs : ast.AstExpr (ast.ast-node-pool-context-expr-get pools rhs-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state lhs)
          rhs))]
    [(Unary _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(Call callee-box args)
      (let
        [callee : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools callee-box)]
        [callee-state : LowerReachState
          (lower-reach-call-callee
            pools
            all-functions
            (lower-global-shared-view names)
            state
            (lower-global-shared-view callee)
            args)]
        [concat-state : LowerReachState
          (match (ast.ast-expr-unspan-with-pools
            pools
            (lower-global-shared-view callee))
            [(Var name)
              (if (or
                (lower-reach-legacy-string-concat-source-id?
                  (lower-name-cache-structural-session (& names))
                  name)
                (lower-reach-public-string-concat-tree?
                  pools
                  names
                  (lower-global-shared-view callee)
                  args))
                (lower-reach-add-string-concat-runtime
                  all-functions
                  names
                  callee-state)
                callee-state)]
            [_ callee-state])]
        [runtime-state : LowerReachState
          (match (ast.ast-expr-unspan-with-pools pools callee)
            [(Var name)
              (if (lower-reach-string-snapshot-source-call?
                (lower-name-cache-structural-session (& names))
                name)
                (lower-reach-add-string-snapshot-runtime
                  all-functions
                  names
                  concat-state)
                concat-state)]
            [_ concat-state])]
        (lower-reach-expr-list pools all-functions names runtime-state args))]
    [(If cond-box then-expr-box else-expr-box)
      (let
        [cond : ast.AstExpr (ast.ast-node-pool-context-expr-get pools cond-box)]
        [then-expr : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools then-expr-box)]
        [else-expr : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools else-expr-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr
            pools
            all-functions
            (lower-global-shared-view names)
            (lower-reach-expr pools all-functions names state cond)
            then-expr)
          else-expr))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              (lower-global-shared-view names)
              (lower-reach-let-bindings
                pools
                all-functions
                names
                state
                bindings)
              body))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda _ _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              (lower-global-shared-view names)
              (lower-reach-add-string-snapshot-runtime
                all-functions
                names
                state)
              body))])]
    [(Tuple values)
      (lower-reach-expr-list pools all-functions names state values)]
    [(TupleRef value-box _)
      (let
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(Array values)
      (lower-reach-expr-list pools all-functions names state values)]
    [(DynArray values)
      (lower-reach-expr-list pools all-functions names state values)]
    [(FixedMakeArray _ len-box)
      (let
        [len : ast.AstExpr (ast.ast-node-pool-context-expr-get pools len-box)]
        (lower-reach-expr pools all-functions names state len))]
    [(MakeArray _ len-box)
      (let
        [len : ast.AstExpr (ast.ast-node-pool-context-expr-get pools len-box)]
        (lower-reach-expr pools all-functions names state len))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools array-box)]
        [index : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state array)
          index))]
    [(Replace place-box replacement-box)
      (let
        [place : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools place-box)]
        [replacement : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools replacement-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state place)
          replacement))]
    [(ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools array-box)]
        [index : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools index-box)]
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr
            pools
            all-functions
            (lower-global-shared-view names)
            (lower-reach-expr pools all-functions names state array)
            index)
          value))]
    [(ArrayTake array-box live-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools array-box)]
        [live : ast.AstExpr (ast.ast-node-pool-context-expr-get pools live-box)]
        [index : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr
            pools
            all-functions
            (lower-global-shared-view names)
            (lower-reach-expr pools all-functions names state array)
            live)
          index))]
    [(ArrayPush array-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools array-box)]
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state array)
          value))]
    [(StringRef text-box index-box)
      (let
        [text : ast.AstExpr (ast.ast-node-pool-context-expr-get pools text-box)]
        [index : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state text)
          index))]
    [(While cond-box body-box)
      (let
        [cond : ast.AstExpr (ast.ast-node-pool-context-expr-get pools cond-box)]
        (lower-reach-expr-list
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state cond)
          body-box))]
    [(ForOwnedState payload)
      (lower-reach-expr
        pools
        all-functions
        (lower-global-shared-view names)
        (lower-reach-expr
          pools
          all-functions
          names
          state
          (ast.ast-node-pool-context-expr-get
            pools
            (ast.ast-for-owned-state-source (& payload))))
        (ast.ast-node-pool-context-expr-get
          pools
          (ast.ast-for-owned-state-body (& payload))))]
    [(ForOwnedStep payload)
      (let
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (if (>= expected-type 0)
            (lower-reach-expr
              pools
              all-functions
              names
              state
              (ast.ast-node-pool-context-expr-get pools expected-type))
            state)
          (ast.ast-node-pool-context-expr-get
            pools
            (ast.ast-for-owned-step-body (& payload)))))]
    [(Begin exprs)
      (lower-reach-expr-list pools all-functions names state exprs)]
    [(Unsafe exprs)
      (lower-reach-expr-list pools all-functions names state exprs)]
    [(Set _ value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(Borrow _ _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match value-box arms)
          (let
            [value : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools value-box)]
            (lower-reach-match-arms
              pools
              all-functions
              (lower-global-shared-view names)
              (lower-reach-expr pools all-functions names state value)
              arms))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach _ _ source-box init-box body-box)
          (let
            [source : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools source-box)]
            [init : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools init-box)]
            [body : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              (lower-global-shared-view names)
              (lower-reach-expr
                pools
                all-functions
                (lower-global-shared-view names)
                (lower-reach-expr pools all-functions names state source)
                init)
              body))]
        [(Foreach2 _ _ a-box b-box _ _ c-box d-box body-box)
          (let
            [reached : LowerReachState
              (lower-reach-expr
                pools
                all-functions
                (lower-global-shared-view names)
                (lower-reach-expr
                  pools
                  all-functions
                  (lower-global-shared-view names)
                  (lower-reach-expr
                    pools
                    all-functions
                    (lower-global-shared-view names)
                    (lower-reach-expr
                      pools
                      all-functions
                      (lower-global-shared-view names)
                      state
                      (ast.ast-node-pool-context-expr-get pools a-box))
                    (ast.ast-node-pool-context-expr-get pools b-box))
                  (ast.ast-node-pool-context-expr-get pools c-box))
                (ast.ast-node-pool-context-expr-get pools d-box))]
            (lower-reach-expr
              pools
              all-functions
              names
              reached
              (ast.ast-node-pool-context-expr-get pools body-box)))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ _ _ source-box init-box map-expr-box reduce-expr-box)
          (let
            [source : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools source-box)]
            [init : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools init-box)]
            [map-expr : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools map-expr-box)]
            [reduce-expr : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools reduce-expr-box)]
            (lower-reach-expr
              pools
              all-functions
              (lower-global-shared-view names)
              (lower-reach-expr
                pools
                all-functions
                (lower-global-shared-view names)
                (lower-reach-expr
                  pools
                  all-functions
                  (lower-global-shared-view names)
                  (lower-reach-expr pools all-functions names state source)
                  init)
                map-expr)
              reduce-expr))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ _ _ start-box end-box _ _ init-box value-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools start-box)]
            [end : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools end-box)]
            [init : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools init-box)]
            [value : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools value-box)]
            [body : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              (lower-global-shared-view names)
              (lower-reach-expr
                pools
                all-functions
                (lower-global-shared-view names)
                (lower-reach-expr
                  pools
                  all-functions
                  (lower-global-shared-view names)
                  (lower-reach-expr
                    pools
                    all-functions
                    (lower-global-shared-view names)
                    (lower-reach-expr pools all-functions names state start)
                    end)
                  init)
                value)
              body))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact _ _ start-box end-box _ _ init-box keep-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools start-box)]
            [end : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools end-box)]
            [init : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools init-box)]
            [keep : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools keep-box)]
            [body : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              (lower-global-shared-view names)
              (lower-reach-expr
                pools
                all-functions
                (lower-global-shared-view names)
                (lower-reach-expr
                  pools
                  all-functions
                  (lower-global-shared-view names)
                  (lower-reach-expr
                    pools
                    all-functions
                    (lower-global-shared-view names)
                    (lower-reach-expr pools all-functions names state start)
                    end)
                  init)
                keep)
              body))])]
    [(SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        [lane : ast.AstExpr (ast.ast-node-pool-context-expr-get pools lane-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state value)
          lane))]
    [(SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        [lane : ast.AstExpr (ast.ast-node-pool-context-expr-get pools lane-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state value)
          lane))]
    [(StructGet value-box _)
      (let
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools receiver-box)]
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state receiver)
          value))]
    [(WithRegion _ exprs)
      (lower-reach-expr-list pools all-functions names state exprs)]
    [(WithEscape scratch-box exprs)
      (let
        [scratch : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools scratch-box)]
        (lower-reach-expr-list
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr
            pools
            all-functions
            (lower-global-shared-view names)
            (lower-reach-add-string-snapshot-runtime all-functions names state)
            scratch)
          exprs))]
    [(WithScratch exprs)
      (lower-reach-expr-list
        pools
        all-functions
        (lower-global-shared-view names)
        (lower-reach-add-string-snapshot-runtime all-functions names state)
        exprs)]
    [(InArena arena-box exprs)
      (let
        [arena : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools arena-box)]
        (lower-reach-expr-list
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state arena)
          exprs))]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (lower-reach-expr-list
            pools
            all-functions
            (lower-global-shared-view names)
            (lower-reach-resource-bindings
              pools
              all-functions
              names
              state
              bindings)
            body)])]
    [(Box inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(BoxGet inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(BoxTake inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state inner)
          value))]
    [(TypeLiteral _) state]
    [(Init _) state]
    [(Comptime inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(Quote _) state]
    [(Quasiquote _) state]
    [(Unquote inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(UnquoteSplicing inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(BracketClause items)
      (lower-reach-expr-list pools all-functions names state items)]
    [(Try inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(Return inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(Break) state]
    [(Continue) state]
    [(PtrNull _) state]
    [(PtrNullCheck value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(PtrAddrOf place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools place-box)]
        (lower-reach-expr pools all-functions names state place))]
    [(PtrRead ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools ptr-box)]
        (lower-reach-expr pools all-functions names state ptr))]
    [(PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools ptr-box)]
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state ptr)
          value))]
    [(PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools offset-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state ptr)
          offset))]
    [(PtrCast ptr-box _)
      (let
        [ptr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools ptr-box)]
        (lower-reach-expr pools all-functions names state ptr))]
    [(PtrToInt ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools ptr-box)]
        (lower-reach-expr pools all-functions names state ptr))]
    [(IntToPtr value-box _)
      (let
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(StringData inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools ptr-box)]
        [len : ast.AstExpr (ast.ast-node-pool-context-expr-get pools len-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state ptr)
          len))]
    [(ArrayData inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(BinaryData _) state]
    [(SpmdProgramIndex) state]
    [(SpmdProgramCount) state]
    [(ProgramArgc) state]
    [(ProgramArgv) state]
    [(ProgramEnvp) state]
    [(CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (ast.ast-node-pool-context-expr-get pools leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools subleaf-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state leaf)
          subleaf))]
    [(CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (ast.ast-node-pool-context-expr-get pools leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools subleaf-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state leaf)
          subleaf))]
    [(CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (ast.ast-node-pool-context-expr-get pools leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools subleaf-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state leaf)
          subleaf))]
    [(CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (ast.ast-node-pool-context-expr-get pools leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools subleaf-box)]
        (lower-reach-expr
          pools
          all-functions
          (lower-global-shared-view names)
          (lower-reach-expr pools all-functions names state leaf)
          subleaf))]
    [(Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr pools all-functions names state index))]
    [(Syscall args)
      (lower-reach-expr-list pools all-functions names state args)]
    [(ForeachActive _ body-box)
      (lower-reach-expr
        pools
        all-functions
        names
        state
        (ast.ast-node-pool-context-expr-get pools body-box))]
    [(LaneValue value-box)
      (lower-reach-expr
        pools
        all-functions
        names
        state
        (ast.ast-node-pool-context-expr-get pools value-box))]))

(define (lower-reach-global-decl
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [decl : ast.AstDecl]) : LowerReachState
  (match decl
    [(Def decl-meta _ _ expr-box)
      (let
        [expr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools expr-box)]
        (lower-reach-expr pools all-functions names state expr))]
    [(DefMacro decl-meta _ _ _ _) state]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-reach-global-decl pools all-functions names state inner))]
    [_ state]))

(define (lower-reach-global-decls
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [state : LowerReachState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module-id : i64]) : LowerReachState
  (match (ast.ast-decl-list-step decls)
    [(Nil) state]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(Cons path _) path]
            [(Nil) (owned_view.compiler-owned-shared-view entry-path)])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(Cons _ path-rest) path-rest]
            [(Nil) (ast.ast-decl-path-list-new)])]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            (lower-reach-state-owner (lower-global-shared-view state))
            (& paths)
            0
            (lower-global-shared-view entry-path)
            decl-path
            module-id)]
        [decl-names : LowerNameCache
          (lower-name-cache-with-module-id
            (lower-global-shared-view names)
            logical-module-id)]
        (match decl
          [(Module next-module)
            (lower-reach-global-decls
              pools
              all-functions
              names
              state
              rest
              rest-paths
              entry-path
              next-module)]
          [(Def decl-meta _ _ expr-box)
            (let
              [expr : ast.AstExpr
                (ast.ast-node-pool-context-expr-get pools expr-box)]
              (lower-reach-global-decls
                pools
                all-functions
                names
                (lower-reach-expr pools all-functions decl-names state expr)
                rest
                rest-paths
                entry-path
                module-id))]
          [(DefMacro decl-meta _ _ _ _)
            (lower-reach-global-decls
              pools
              all-functions
              names
              state
              rest
              rest-paths
              entry-path
              module-id)]
          [(Unsafe inner-box)
            (let
              [inner : ast.AstDecl (deref inner-box)]
              (lower-reach-global-decls
                pools
                all-functions
                names
                (lower-reach-global-decl
                  pools
                  all-functions
                  decl-names
                  state
                  inner)
                rest
                rest-paths
                entry-path
                module-id))]
          [_
            (lower-reach-global-decls
              pools
              all-functions
              names
              state
              rest
              rest-paths
              entry-path
              module-id)]))]))

(define (lower-reach-struct-field-cleanup-roots
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [entry-path : (& entry-path str)]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]
  [fields : ast.AstFieldDefList]) : LowerReachState
  (lower-reach-struct-field-cleanup-roots-at
    all-functions
    entry-path
    decl-path
    module
    module-id
    names
    state
    (& fields)
    0))

(define (lower-reach-struct-field-cleanup-roots-at
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [entry-path : (& entry-path str)]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : LowerReachState
  (if (>= index fields.len)
    state
    (let
      [next : LowerReachState
        (match (ast.ast-field-def-list-get
          fields
          index
          (ast.ast-field-def-fallback))
          [(Def _ _ cleanup)
            (match cleanup
              [(Fn cleanup-name)
                (let
                  [cleanup-name-id : i64
                    (ci.intern-syntax-id-value cleanup-name)]
                  [logical-id : i64
                    (if (tc_core.tc-name-qualified-id?
                      (lower-name-cache-structural-session (& names))
                      cleanup-name-id)
                      (lower-name-cache-resolve-logical-id
                        (& names)
                        (tc_core.macro-hygiene-global-source-name-id-or
                          (lower-name-cache-structural-session (& names))
                          cleanup-name-id
                          cleanup-name-id)
                        -1)
                      (lower-module-name-key-id-by-id module-id cleanup-name-id))]
                  (lower-reach-add-logical all-functions state logical-id))]
              [_ state])])]
      (lower-reach-struct-field-cleanup-roots-at
        all-functions
        entry-path
        decl-path
        module
        module-id
        names
        next
        fields
        (+ index 1)))))

(define (lower-reach-enum-payload-cleanup-roots
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [entry-path : (& entry-path str)]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]
  [variants : ast.AstVariantDefList]) : LowerReachState
  (lower-reach-enum-payload-cleanup-roots-at
    all-functions
    entry-path
    decl-path
    module
    module-id
    names
    state
    (& variants)
    0
    0))

(define (lower-reach-enum-payload-cleanup-roots-at
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [entry-path : (& entry-path str)]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]
  [variants : (& variants ast.AstVariantDefList)]
  [variant-index : i64]
  [payload-index : i64]) : LowerReachState
  (if (>= variant-index (ast.ast-variant-def-list-len variants))
    state
    (match (ast.ast-variant-def-list-get
      variants
      variant-index
      (ast.ast-variant-def-fallback))
      [(Def _ _ cleanups)
        (if (>=
          payload-index
          (ast.ast-variant-payload-cleanup-list-len (& cleanups)))
          (lower-reach-enum-payload-cleanup-roots-at
            all-functions
            entry-path
            decl-path
            module
            module-id
            names
            state
            variants
            (+ variant-index 1)
            0)
          (let
            [next : LowerReachState
              (match (ast.ast-variant-payload-cleanup-list-get
                (& cleanups)
                payload-index
                (ast.ast-variant-payload-cleanup-fallback))
                [(Fn cleanup-name)
                  (let
                    [cleanup-name-id : i64
                      (ci.intern-syntax-id-value cleanup-name)]
                    [logical-id : i64
                      (if (tc_core.tc-name-qualified-id?
                        (lower-name-cache-structural-session (& names))
                        cleanup-name-id)
                        (lower-name-cache-resolve-logical-id
                          (& names)
                          (tc_core.macro-hygiene-global-source-name-id-or
                            (lower-name-cache-structural-session (& names))
                            cleanup-name-id
                            cleanup-name-id)
                          -1)
                        (lower-module-name-key-id-by-id
                          module-id
                          cleanup-name-id))]
                    (lower-reach-add-logical all-functions state logical-id))]
                [_ state])]
            (lower-reach-enum-payload-cleanup-roots-at
              all-functions
              entry-path
              decl-path
              module
              module-id
              names
              next
              variants
              variant-index
              (+ payload-index 1))))])))

(define (lower-reach-cleanup-metadata-roots-in-module
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]) : LowerReachState
  (match (ast.ast-decl-list-step decls)
    [(Nil) state]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(Cons path _) path]
            [(Nil) (owned_view.compiler-owned-shared-view entry-path)])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(Cons _ path-rest) path-rest]
            [(Nil) (ast.ast-decl-path-list-new)])]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            (lower-reach-state-owner (lower-global-shared-view state))
            (& paths)
            0
            (lower-global-shared-view entry-path)
            (lower-global-shared-view decl-path)
            module-id)]
        [logical-module : String
          (lower-decl-owner-module-name
            (lower-reach-state-owner (lower-global-shared-view state))
            module-id
            logical-module-id)]
        [next : LowerReachState
          (match (lower-global-shared-view decl)
            [(DefStruct decl-meta _ _ cleanup fields)
              (if (ast.ast-struct-cleanup? cleanup)
                (lower-reach-struct-field-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  fields)
                state)]
            [(DefStructLifetimes decl-meta _ _ _ cleanup fields)
              (if (ast.ast-struct-cleanup? cleanup)
                (lower-reach-struct-field-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  fields)
                state)]
            [(DefEnum decl-meta _ cleanup variants)
              (if (ast.ast-enum-cleanup? cleanup)
                (lower-reach-enum-payload-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  variants)
                state)]
            [(DefEnumLifetimes decl-meta _ _ cleanup variants)
              (if (ast.ast-enum-cleanup? cleanup)
                (lower-reach-enum-payload-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  variants)
                state)]
            [(Module next-module)
              (lower-reach-cleanup-metadata-roots-in-module
                all-functions
                (lower-global-shared-view rest)
                (lower-global-shared-view rest-paths)
                (lower-global-shared-view entry-path)
                (lower-name-id-text
                  (lower-reach-state-owner (lower-global-shared-view state))
                  next-module)
                next-module
                names
                state)]
            [_ state])]
        (match decl
          [(Module _) next]
          [_
            (lower-reach-cleanup-metadata-roots-in-module
              all-functions
              rest
              rest-paths
              entry-path
              module
              module-id
              names
              next)]))]))

(define (lower-function-body-index-empty [count : i64]) : LowerFunctionBodyIndex
  (LowerFunctionBodyIndex
    (lower_i64_i64_map.with-capacity 8192)
    (__tl_make-array LowerMaybeFunctionBody count)
    0))

;; Build a small per-module overlay name cache holding only the module's
;; import aliases; module-owned declarations resolve through canonical
;; module-qualified keys in the shared global cache. Misses fall through to that
;; cache `lower-active-global-name-cache` (set by the prune body-index pass).
;; Was O(modules x global-names): a fresh full cache was rebuilt per module.
(define (lower-function-body-name-cache-for-module
  [decls : ast.AstDeclList]
  [_paths : (& _paths ast.AstDeclPathList)]
  [_entry-path : String]
  [_base-names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [module : String]
  [module-id : i64]) : LowerNameCache
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache base-cache)]
    (if (string.eq module "")
      base-cache
      (match (lower-active-module-name-cache-lookup lower-state module-id)
        [(Some cache) cache]
        [(No)
          (let
            [alias-only-names : LowerNameEnv
              (lower-name-env-with-import-aliases-in-module-cache
                decls
                (Nil)
                base-cache
                module-id)]
            [cache : LowerNameCache
              (lower-name-cache-overlay lower-state alias-only-names module-id)]
            (lower-active-module-name-cache-insert!
              lower-state
              module-id
              (lower-global-shared-view cache))
            cache)]))))

(define (lower-function-decl-count-one [decl : ast.AstDecl]) : i64
  (match decl
    [(DefFn decl-meta _ _ _ _ _) 1]
    [(Unsafe inner-box) (lower-function-decl-count-one (deref inner-box))]
    [_ 0]))

(define (lower-function-decl-count [decls : ast.AstDeclList]) : i64
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [out : i64 0]
    (while (< index count)
      (set!
        out
        (+
          out
          (lower-function-decl-count-one
            (lower-global-array-element-shared-view
              decls.slots
              (+ decls.offset index)))))
      (set! index (+ index 1)))
    out))

(define (lower-function-body-index-add
  [index : LowerFunctionBodyIndex]
  [logical-id : i64]
  [names : LowerNameCache]
  [body : ast.AstExpr]
  [decl-path-owner-id : i64]) : LowerFunctionBodyIndex
  (let
    [ids : lower_i64_i64_map.Map index.ids]
    [bodies : (__tl_dyn-array LowerMaybeFunctionBody) index.bodies]
    [next : i64 index.next]
    (set!
      (array-ref bodies next)
      (LowerMaybeFunctionBody.Some body names decl-path-owner-id))
    (lower_i64_i64_map.insert-ref! (&mut ids) logical-id next)
    (LowerFunctionBodyIndex ids bodies (+ next 1))))

(define (lower-function-body-index-find
  [index : (& index LowerFunctionBodyIndex)]
  [target : i64]) : LowerMaybeFunctionBody
  (match (lower_i64_i64_map.get (& index.ids) target)
    [(LookupFound body-index) (array-ref index.bodies body-index)]
    [(LookupMissing) (No)]))

(define (lower-function-body-index-from-decls-in-module
  [lower-state : CompilerLowerState]
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [all-decls : ast.AstDeclList]
  [all-paths : (& all-paths ast.AstDeclPathList)]
  [base-names : LowerNameEnv]
  [base-name-cache : LowerNameCache]
  [module-name-cache : LowerNameCache]
  [index : LowerFunctionBodyIndex]) : LowerFunctionBodyIndex
  (match (ast.ast-decl-list-step decls)
    [(Nil) index]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(Cons path _) path]
            [(Nil) (owned_view.compiler-owned-shared-view entry-path)])]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            lower-state
            (& paths)
            0
            (lower-global-shared-view entry-path)
            (lower-global-shared-view decl-path)
            module-id)]
        [decl-name-cache : LowerNameCache
          (lower-name-cache-with-module-id
            (lower-global-shared-view module-name-cache)
            logical-module-id)]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(Cons _ path-rest)
              (let
                [path-rest : ast.AstDeclPathList path-rest]
                path-rest)]
            [(Nil) (ast.ast-decl-path-list-new)])]
        (match (ast.ast-decl-unwrapped decl)
          [(Module next-module)
            (let
              [next-module-str : String
                (lower-name-id-text lower-state next-module)]
              (lower-function-body-index-from-decls-in-module
                lower-state
                pools
                rest
                rest-paths
                (lower-global-shared-view entry-path)
                (lower-global-shared-view next-module-str)
                next-module
                (lower-global-shared-view all-decls)
                all-paths
                (lower-global-shared-view base-names)
                (lower-global-shared-view base-name-cache)
                (lower-function-body-name-cache-for-module
                  all-decls
                  all-paths
                  entry-path
                  base-names
                  base-name-cache
                  next-module-str
                  next-module)
                index))]
          [(DefFn decl-meta name _ _ body-box _)
            (let
              [body : ast.AstExpr
                (ast.ast-node-pool-context-expr-get pools body-box)]
              (lower-function-body-index-from-decls-in-module
                lower-state
                pools
                rest
                rest-paths
                (lower-global-shared-view entry-path)
                module
                module-id
                all-decls
                all-paths
                base-names
                base-name-cache
                module-name-cache
                (lower-function-body-index-add
                  index
                  (lower-decl-logical-id
                    lower-state
                    entry-path
                    decl-path
                    (lower-decl-owner-module-name
                      lower-state
                      module-id
                      logical-module-id)
                    logical-module-id
                    name
                    (lower-name-id-text lower-state name))
                  decl-name-cache
                  body
                  (ast.ast-decl-path-list-owner-id
                    (& paths)
                    0
                    logical-module-id))))]
          [_
            (lower-function-body-index-from-decls-in-module
              lower-state
              pools
              rest
              rest-paths
              entry-path
              module
              module-id
              all-decls
              all-paths
              base-names
              base-name-cache
              module-name-cache
              index)]))]))

(define (lower-function-body-index-from-decls
  [lower-state : CompilerLowerState]
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [count : i64]) : LowerFunctionBodyIndex
  (compiler-lower-state-write!
    lower-state
    LowerModuleNameCacheStore
    active-module-name-caches
    (lower-module-name-cache-store-empty))
  (let
    [name-cache : LowerNameCache
      (lower-name-cache-from-env lower-state (lower-global-shared-view names))]
    (lower-function-body-index-from-decls-in-module
      lower-state
      pools
      (lower-global-shared-view decls)
      (lower-global-shared-view paths)
      entry-path
      ""
      cbi.compiler-builtin-id-fix-empty
      decls
      paths
      names
      (lower-global-shared-view name-cache)
      name-cache
      (lower-function-body-index-empty count))))

(define (lower-reach-process
  [pools : (& pools ast.AstNodePoolContext)]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : LowerNameCache]
  [body-index : LowerFunctionBodyIndex]
  [state : LowerReachState]) : LowerReachState
  (match (lower-global-shared-view state)
    [(State reachable worklist lower-state)
      (let
        [top : i64 (- worklist.len 1)]
        (if (< top 0)
          state
          (let
            [name : i64 (array-ref worklist.slots top)]
            [popped : LowerReachState
              (State reachable (LowerIdSet worklist.slots top) lower-state)]
            (match (lower-function-body-index-find body-index name)
              [(Some body body-names body-path-owner-id)
                (let
                  [runtime-paths : lower_i64_i64_map.Map
                    (compiler-lower-state-read
                      lower-state
                      lower_i64_i64_map.Map
                      reach-active-runtime-paths)]
                  (lower_i64_i64_map.insert-ref!
                    (&mut runtime-paths)
                    body-path-owner-id
                    1)
                  (compiler-lower-state-write!
                    lower-state
                    lower_i64_i64_map.Map
                    reach-active-runtime-paths
                    runtime-paths))
                (lower-reach-process
                  pools
                  all-functions
                  names
                  body-index
                  (lower-reach-expr pools all-functions body-names popped body))]
              [(No)
                (lower-reach-process
                  pools
                  all-functions
                  names
                  body-index
                  popped)]))))]))

(define (lower-dispatch-variant-logical-name
  [module-id : i64]
  [names : LowerNameCache]
  [variant-name : i64]) : String
  (match (lower-name-cache-resolve-id-display
    (lower-global-shared-view names)
    (lower-dispatch-variant-source-id
      (lower-name-cache-structural-session (& names))
      module-id
      variant-name))
    [(Some logical-name) logical-name]
    [(No) (tc_core.tc-env-key-name-text variant-name)]))

(define (lower-dispatch-variant-source-id
  [session : cis.InternStructuralSessionHandle]
  [module-id : i64]
  [variant-name : i64]) : i64
  (if (or
    (csym.compiler-symbol-root-module-id? module-id)
    (tc_core.tc-name-qualified-id? session variant-name)
    (>= variant-name (ci.intern-capacity)))
    variant-name
    (csym.compiler-symbol-module-key-id-by-id module-id variant-name)))

(define (lower-dispatch-variant-logical-id
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [variant-name : i64]) : i64
  (let
    [source-id : i64
      (lower-dispatch-variant-source-id
        (lower-name-cache-structural-session (& names))
        module-id
        variant-name)]
    (lower-name-cache-resolve-logical-id (& names) source-id source-id)))

(define (lower-dispatch-variant-set-add-list-from
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (if (>= index variants.len)
    out
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(Variant _ variant-name)
        (lower-dispatch-variant-set-add-list-from
          variants
          (+ index 1)
          module-id
          names
          (let
            [next-out : lower_i64_i64_map.Map out]
            (lower_i64_i64_map.insert-ref!
              (&mut next-out)
              (lower-dispatch-variant-logical-id module-id names variant-name)
              1)
            next-out))])))

(define (lower-dispatch-variant-set-add-list
  [variants : ast.AstDispatchVariantList]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (lower-dispatch-variant-set-add-list-from (& variants) 0 module-id names out))

(define (lower-dispatch-variant-set-add-decl
  [decl : ast.AstDecl]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (match decl
    [(DefDispatch decl-meta _ variants)
      (lower-dispatch-variant-set-add-list variants module-id names out)]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-dispatch-variant-set-add-decl inner module-id names out))]
    [_ out]))

(define (lower-dispatch-variant-set-from-decls-in-module
  [decls : ast.AstDeclList]
  [paths : (& paths ast.AstDeclPathList)]
  [entry-path : String]
  [names : (& names LowerNameCache)]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [cur-out : lower_i64_i64_map.Map out]
    (while (< index count)
      (let
        [decl : ast.AstDecl
          (lower-global-array-element-shared-view
            decls.slots
            (+ decls.offset index))]
        [decl-path : String
          (ast.ast-decl-path-list-get
            (& paths)
            index
            (lower-global-shared-view entry-path))]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            (compiler-lower-state-from-name-cache names)
            (& paths)
            index
            (lower-global-shared-view entry-path)
            decl-path
            cur-module-id)]
        (match (lower-global-shared-view decl)
          [(Module next-module) (set! cur-module-id next-module)]
          [_
            (set!
              cur-out
              (lower-dispatch-variant-set-add-decl
                decl
                logical-module-id
                names
                cur-out))])
        (set! index (+ index 1))))
    cur-out))

(define (lower-dispatch-variant-set-from-decls
  [decls : ast.AstDeclList]
  [paths : (& paths ast.AstDeclPathList)]
  [entry-path : String]
  [names : (& names LowerNameCache)]) : lower_i64_i64_map.Map
  (lower-dispatch-variant-set-from-decls-in-module
    decls
    paths
    entry-path
    names
    (lower_i64_i64_map.with-capacity 1024)))

(define (lower-reach-add-dispatch-variant-list-from
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [state : LowerReachState]) : LowerReachState
  (if (>= index variants.len)
    state
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(Variant _ variant-name)
        (lower-reach-add-dispatch-variant-list-from
          all-functions
          module-id
          names
          variants
          (+ index 1)
          (lower-reach-add-logical
            all-functions
            state
            (lower-dispatch-variant-logical-id module-id names variant-name)))])))

(define (lower-reach-add-dispatch-variant-list
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [variants : ast.AstDispatchVariantList]
  [state : LowerReachState]) : LowerReachState
  (lower-reach-add-dispatch-variant-list-from
    all-functions
    module-id
    names
    (& variants)
    0
    state))

(define (lower-reach-add-dispatch-variant-decl
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [decl : ast.AstDecl]
  [state : LowerReachState]) : LowerReachState
  (match decl
    [(DefDispatch decl-meta _ variants)
      (lower-reach-add-dispatch-variant-list
        all-functions
        module-id
        names
        variants
        state)]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-reach-add-dispatch-variant-decl
          all-functions
          module-id
          names
          inner
          state))]
    [_ state]))

(define (lower-reach-add-dispatch-variant-roots-in-module
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [decls : ast.AstDeclList]
  [module-id : i64]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]) : LowerReachState
  (match (ast.ast-decl-list-step decls)
    [(Nil) state]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (match (lower-global-shared-view decl)
          [(Module next-module)
            (lower-reach-add-dispatch-variant-roots-in-module
              all-functions
              rest
              next-module
              names
              state)]
          [_
            (lower-reach-add-dispatch-variant-roots-in-module
              all-functions
              rest
              module-id
              names
              (lower-reach-add-dispatch-variant-decl
                all-functions
                module-id
                names
                decl
                state))]))]))

(define (lower-reach-add-dispatch-variant-roots
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [decls : ast.AstDeclList]
  [names : (& names LowerNameCache)]
  [state : LowerReachState]) : LowerReachState
  (lower-reach-add-dispatch-variant-roots-in-module
    all-functions
    decls
    cbi.compiler-builtin-id-fix-empty
    names
    state))

;; `reachable` is keyed by dense `all-functions` slot; resolve a logical ID's
;; slot through the same map the reach walk used and test membership by i64.
(define (lower-reach-slot-set-contains-id?
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [reachable : (& reachable lower_i64_i64_map.Map)]
  [logical-id : i64]) : bool
  (match (lower_i64_i64_map.get (& all-functions) logical-id)
    [(LookupMissing) false]
    [(LookupFound slot) (lower_i64_i64_map.contains? (& reachable) slot)]))

(define (lower-function-kept-by-reach-or-dispatch?
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [reachable : (& reachable lower_i64_i64_map.Map)]
  [dispatch-variants : (& dispatch-variants lower_i64_i64_map.Map)]
  [logical-id : i64]) : bool
  (or
    (lower-reach-slot-set-contains-id? all-functions reachable logical-id)
    (lower_i64_i64_map.contains? (& dispatch-variants) logical-id)))

(define (lower-session-name-qualified?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (cis.intern-structural-session-handle-source-names session)]
    (if (and
      (>= name-id 0)
      (< name-id (ci.intern-source-name-session-handle-capacity source-names)))
      (ci.intern-source-name-session-handle-qualified? source-names name-id)
      (tc_core.tc-name-qualified-id? session name-id))))

(define (lower-session-name-first-dot-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (cis.intern-structural-session-handle-source-names session)]
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or session name-id name-id)]
    (if (and
      (>= source-id 0)
      (< source-id (ci.intern-source-name-session-handle-capacity source-names)))
      (ci.intern-source-name-session-handle-first-dot source-names source-id)
      -1)))

(define (lower-session-qualified-name-base-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (cis.intern-structural-session-handle-source-names session)]
    (cond
      [(and
          (>= name-id 0)
          (<
            name-id
            (ci.intern-source-name-session-handle-capacity source-names))
          (ci.intern-source-name-session-handle-qualified? source-names name-id))
        (ci.intern-source-name-session-handle-qualified-base-id
          source-names
          name-id)]
      [(csym.compiler-composite-triple-key-id? name-id)
        (csym.compiler-composite-pair-key-id
          (csym.compiler-composite-triple-middle-id name-id)
          (csym.compiler-composite-triple-right-id name-id))]
      [(csym.compiler-composite-pair-key-id? name-id)
        (csym.compiler-composite-pair-right-id name-id)]
      [else name-id])))

(define (lower-used-type-name-leaf-id
  [session : cis.InternStructuralSessionHandle]
  [name : i64]) : i64
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (cis.intern-structural-session-handle-source-names session)]
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or session name name)]
    [base-id : i64 (lower-session-qualified-name-base-id session source-id)]
    (if (and
      (>= base-id 0)
      (< base-id (ci.intern-source-name-session-handle-capacity source-names))
      (ci.intern-source-name-session-handle-dotted? source-names base-id))
      (ci.intern-source-name-session-handle-dotted-final-id
        source-names
        base-id)
      base-id)))

(define (lower-used-type-name-add
  [session : cis.InternStructuralSessionHandle]
  [used : lower_i64_i64_map.Map]
  [_module : String]
  [name : i64]) : lower_i64_i64_map.Map
  (let
    [with-source : lower_i64_i64_map.Map used]
    (lower_i64_i64_map.insert-ref! (&mut with-source) name 1)
    (if (or
      (lower-session-name-qualified? session name)
      (>= (lower-session-name-first-dot-id session name) 0))
      (let
        [leaf : i64 (lower-used-type-name-leaf-id session name)]
        (if (< leaf 0)
          unit
          (lower_i64_i64_map.insert-ref! (&mut with-source) leaf 1))
        with-source)
      with-source)))

(define (lower-used-type-name-contains?
  [session : cis.InternStructuralSessionHandle]
  [used : (& used lower_i64_i64_map.Map)]
  [_module : (& _module str)]
  [name : i64]) : bool
  (if (lower_i64_i64_map.contains? (& used) name)
    true
    (if (or
      (lower-session-name-qualified? session name)
      (>= (lower-session-name-first-dot-id session name) 0))
      (let
        [leaf : i64 (lower-used-type-name-leaf-id session name)]
        (and (>= leaf 0) (lower_i64_i64_map.contains? (& used) leaf)))
      false)))

(define (lower-used-types-precise-empty) : lower_i64_i64_map.Map
  (let
    [used : lower_i64_i64_map.Map (lower_i64_i64_map.with-capacity 8192)]
    (lower_i64_i64_map.insert-ref!
      (&mut used)
      cbi.compiler-builtin-id-fix-dollar_lower_dot_precise_type_dce
      1)
    used))

(define (lower-used-types-add-type-id
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [ty-id : i64]) : lower_i64_i64_map.Map
  (lower-used-types-add-type
    session
    pools
    used
    module
    (ast.ast-node-pool-context-type-get (& pools) ty-id)))

(define (lower-used-types-add-type-list
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [types : ast.AstTypeList]) : lower_i64_i64_map.Map
  (lower-used-types-add-type-list-at session pools used module (& types) 0))

(define (lower-used-types-add-type-list-at
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast.ast-type-list-len types))
    used
    (lower-used-types-add-type-list-at
      session
      pools
      (lower-used-types-add-type-id
        session
        pools
        used
        (lower-global-shared-view module)
        (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
      module
      types
      (+ index 1))))

(define (lower-used-types-add-type
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [ty : ast.AstType]) : lower_i64_i64_map.Map
  (match ty
    [(Func args ret)
      (lower-used-types-add-type-id
        session
        pools
        (lower-used-types-add-type-list
          session
          pools
          used
          (lower-global-shared-view module)
          (deref args))
        module
        ret)]
    [(Tuple elems)
      (lower-used-types-add-type-list session pools used module (deref elems))]
    [(Array elem _)
      (lower-used-types-add-type-id session pools used module elem)]
    [(DynArray elem)
      (lower-used-types-add-type-id session pools used module elem)]
    [(Slice elem) (lower-used-types-add-type-id session pools used module elem)]
    [(Box elem) (lower-used-types-add-type-id session pools used module elem)]
    [(Region _ inner)
      (lower-used-types-add-type-id session pools used module inner)]
    [(Invalidate _ inner)
      (lower-used-types-add-type-id session pools used module inner)]
    [(Ref _ inner)
      (lower-used-types-add-type-id session pools used module inner)]
    [(MutRef _ inner)
      (lower-used-types-add-type-id session pools used module inner)]
    [(Enum name) (lower-used-type-name-add session used module name)]
    [(EnumArgs name _) (lower-used-type-name-add session used module name)]
    [(Struct name) (lower-used-type-name-add session used module name)]
    [(StructArgs name _) (lower-used-type-name-add session used module name)]
    [(Var name) (lower-used-type-name-add session used module name)]
    [(VarArgs name _) (lower-used-type-name-add session used module name)]
    [(Ptr inner) (lower-used-types-add-type-id session pools used module inner)]
    [(MutPtr inner)
      (lower-used-types-add-type-id session pools used module inner)]
    [_ used]))

(define (lower-used-types-add-maybe-type
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [maybe-ty : ast.AstMaybeType]) : lower_i64_i64_map.Map
  (match maybe-ty
    [(No) used]
    [(Some ty) (lower-used-types-add-type session pools used module ty)]))

(define (lower-used-types-add-param-list
  [session : cis.InternStructuralSessionHandle]
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [params : ast.AstParamList]) : lower_i64_i64_map.Map
  (lower-used-types-add-param-list-at session pools used module (& params) 0))

(define (lower-used-types-add-param-list-at
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [params : (& params ast.AstParamList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast.ast-param-list-len params))
    used
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty _)
        (lower-used-types-add-param-list-at
          session
          pools
          (lower-used-types-add-type
            session
            pools
            used
            (lower-global-shared-view module)
            ty)
          module
          params
          (+ index 1))])))

(define (lower-used-types-add-macro-param-list
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [params : ast.AstMacroParamList]) : lower_i64_i64_map.Map
  (lower-used-types-add-macro-param-list-at
    session
    pools
    used
    module
    (& params)
    0))

(define (lower-used-types-add-macro-param-list-at
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast.ast-macro-param-list-len params))
    used
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param _ ty _ _)
        (lower-used-types-add-macro-param-list-at
          session
          pools
          (lower-used-types-add-type
            session
            pools
            used
            (lower-global-shared-view module)
            ty)
          module
          params
          (+ index 1))])))

;; Add the types a node's children name, in payload order.
(define (lower-used-types-add-children-at
  [session : cis.InternStructuralSessionHandle]
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [children : (& children ast.AstExprChildList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index children.len)
    used
    (lower-used-types-add-children-at
      session
      pools
      (match (ast.ast-expr-child-list-get
        children
        index
        (ast.ast-expr-child-fallback))
        [(Expr id)
          (lower-used-types-add-expr-id
            session
            pools
            used
            (lower-global-shared-view module)
            id)]
        [(TypeId id)
          (lower-used-types-add-type
            session
            pools
            used
            (lower-global-shared-view module)
            (ast.ast-node-pool-context-type-get pools id))]
        [(Type ty)
          (lower-used-types-add-type
            session
            pools
            used
            (lower-global-shared-view module)
            ty)]
        [(Pattern pattern)
          (lower-used-types-add-pattern
            session
            pools
            used
            (lower-global-shared-view module)
            pattern)])
      module
      children
      (+ index 1))))

;; A type operand is added before the expression it annotates or converts.
(define (lower-used-types-add-type-then-expr
  [session : cis.InternStructuralSessionHandle]
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [ty-id : i64]
  [expr-id : i64]) : lower_i64_i64_map.Map
  (lower-used-types-add-expr-id
    session
    pools
    (lower-used-types-add-type
      session
      pools
      used
      (lower-global-shared-view module)
      (ast.ast-node-pool-context-type-get pools ty-id))
    module
    expr-id))

(define (lower-used-types-add-expr-id
  [session : cis.InternStructuralSessionHandle]
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [expr-id : i64]) : lower_i64_i64_map.Map
  ;; The arms below add a type operand before its expression, keep the SPMD
  ;; scan and compact types ahead of their operands, read only some for-owned
  ;; slots and skip quoted syntax; every other variant's children are added
  ;; through the AstExpr child list.
  (match (ast.ast-node-pool-context-expr-get pools expr-id)
    [(ForOwnedState payload)
      (lower-used-types-add-expr-id
        session
        pools
        (lower-used-types-add-expr-id
          session
          pools
          used
          (lower-global-shared-view module)
          (ast.ast-for-owned-state-source (& payload)))
        module
        (ast.ast-for-owned-state-body (& payload)))]
    [(ForOwnedStep payload)
      (let
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        (lower-used-types-add-expr-id
          session
          pools
          (if (>= expected-type 0)
            (lower-used-types-add-expr-id
              session
              pools
              used
              (lower-global-shared-view module)
              expected-type)
            used)
          module
          (ast.ast-for-owned-step-body (& payload))))]
    [(Ann inner-box ty-id)
      (lower-used-types-add-type-then-expr
        session
        pools
        used
        module
        ty-id
        inner-box)]
    [(Cast inner-box ty-id)
      (lower-used-types-add-type-then-expr
        session
        pools
        used
        module
        ty-id
        inner-box)]
    [(SpmdScan scan-box)
      (match (deref scan-box)
        [(Scan
            _
            _
            index-ty
            start-box
            end-box
            _
            prefix-ty
            init-box
            value-box
            body-box)
          (lower-used-types-add-expr-id
            session
            pools
            (lower-used-types-add-expr-id
              session
              pools
              (lower-used-types-add-expr-id
                session
                pools
                (lower-used-types-add-expr-id
                  session
                  pools
                  (lower-used-types-add-expr-id
                    session
                    pools
                    (lower-used-types-add-type
                      session
                      pools
                      (lower-used-types-add-type
                        session
                        pools
                        used
                        (lower-global-shared-view module)
                        index-ty)
                      (lower-global-shared-view module)
                      prefix-ty)
                    (lower-global-shared-view module)
                    start-box)
                  (lower-global-shared-view module)
                  end-box)
                (lower-global-shared-view module)
                init-box)
              (lower-global-shared-view module)
              value-box)
            module
            body-box)])]
    [(SpmdCompact compact-box)
      (match (deref compact-box)
        [(Compact
            _
            index-ty
            start-box
            end-box
            _
            slot-ty
            init-box
            keep-box
            body-box)
          (lower-used-types-add-expr-id
            session
            pools
            (lower-used-types-add-expr-id
              session
              pools
              (lower-used-types-add-expr-id
                session
                pools
                (lower-used-types-add-expr-id
                  session
                  pools
                  (lower-used-types-add-expr-id
                    session
                    pools
                    (lower-used-types-add-type
                      session
                      pools
                      (lower-used-types-add-type
                        session
                        pools
                        used
                        (lower-global-shared-view module)
                        index-ty)
                      (lower-global-shared-view module)
                      slot-ty)
                    (lower-global-shared-view module)
                    start-box)
                  (lower-global-shared-view module)
                  end-box)
                (lower-global-shared-view module)
                init-box)
              (lower-global-shared-view module)
              keep-box)
            module
            body-box)])]
    [(Quote _) used]
    [(Quasiquote _) used]
    [(PtrCast ptr-box ty-id)
      (lower-used-types-add-type-then-expr
        session
        pools
        used
        module
        ty-id
        ptr-box)]
    [(IntToPtr value-box ty-id)
      (lower-used-types-add-type-then-expr
        session
        pools
        used
        module
        ty-id
        value-box)]
    [_
      (let
        [children : ast.AstExprChildList
          (ast.ast-expr-children
            (ast.ast-node-pool-context-expr-get pools expr-id))]
        (lower-used-types-add-children-at
          session
          pools
          used
          module
          (& children)
          0))]))

(define (lower-used-types-add-pattern
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [pattern : ast.AstPattern]) : lower_i64_i64_map.Map
  (match pattern
    [(Var _ maybe-ty)
      (lower-used-types-add-maybe-type session pools used module maybe-ty)]
    [(Tuple patterns-box)
      (lower-used-types-add-pattern-list
        session
        pools
        used
        module
        (deref patterns-box))]
    [(Array patterns-box)
      (lower-used-types-add-pattern-list
        session
        pools
        used
        module
        (deref patterns-box))]
    [(Slice patterns-box _)
      (lower-used-types-add-pattern-list
        session
        pools
        used
        module
        (deref patterns-box))]
    [(Wildcard) used]
    [(Binding _) used]
    [(Variant name patterns-box)
      (let
        ;; `name` is already the interned id; read the id-keyed metadata slots
        ;; directly instead of re-hashing `(tc-env-key-name-text name)` twice.
        [with-head : lower_i64_i64_map.Map
          (if (or
            (tc_core.tc-name-qualified-id? session name)
            (>= (tc_core.tc-name-first-dot-id session name) 0))
            (lower-used-type-name-add
              session
              used
              (lower-global-shared-view module)
              name)
            used)]
        (lower-used-types-add-pattern-list
          session
          pools
          with-head
          module
          (deref patterns-box)))]
    [(Literal _) used]))

(define (lower-used-types-add-pattern-list
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [patterns : ast.AstPatternList]) : lower_i64_i64_map.Map
  (lower-used-types-add-pattern-list-at
    session
    pools
    used
    module
    (& patterns)
    0))

(define (lower-used-types-add-pattern-list-at
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index patterns.len)
    used
    (lower-used-types-add-pattern-list-at
      session
      pools
      (lower-used-types-add-pattern
        session
        pools
        used
        (lower-global-shared-view module)
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback)))
      module
      patterns
      (+ index 1))))

(define (lower-used-types-add-field-list
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [fields : ast.AstFieldDefList]) : lower_i64_i64_map.Map
  (lower-used-types-add-field-list-at session pools used module (& fields) 0))

(define (lower-used-types-add-field-list-at
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index fields.len)
    used
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def _ ty _)
        (lower-used-types-add-field-list-at
          session
          pools
          (lower-used-types-add-type
            session
            pools
            used
            (lower-global-shared-view module)
            ty)
          module
          fields
          (+ index 1))])))

(define (lower-used-types-add-variant-list
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [variants : ast.AstVariantDefList]) : lower_i64_i64_map.Map
  (lower-used-types-add-variant-list-at
    session
    pools
    used
    module
    (& variants)
    0))

(define (lower-used-types-add-variant-list-at
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index variants.len)
    used
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def _ fields _)
        (lower-used-types-add-variant-list-at
          session
          pools
          (lower-used-types-add-type-list
            session
            pools
            used
            (lower-global-shared-view module)
            fields)
          module
          variants
          (+ index 1))])))

(define (lower-type-decl? [decl : ast.AstDecl]) : bool
  (match decl
    [(DefEnum decl-meta _ _ _) true]
    [(DefEnumLifetimes decl-meta _ _ _ _) true]
    [(DefStruct decl-meta _ _ _ _) true]
    [(DefStructLifetimes decl-meta _ _ _ _ _) true]
    [(Unsafe inner-box) (lower-type-decl? (deref inner-box))]
    [_ false]))

(define (lower-type-decl-used?
  [session : cis.InternStructuralSessionHandle]
  [module : (& module str)]
  [used-types : (& used-types lower_i64_i64_map.Map)]
  [decl : ast.AstDecl]) : bool
  ;; Empty is the fast-path marker for "all type declaration paths are already
  ;; reachable"; precise DCE starts from lower-used-types-precise-empty instead.
  (if (= (lower_i64_i64_map.len (& used-types)) 0)
    true
    (match decl
      [(DefEnum decl-meta name _ variants)
        (lower-used-type-name-contains? session used-types module name)]
      [(DefEnumLifetimes decl-meta name _ _ variants)
        (lower-used-type-name-contains? session used-types module name)]
      [(DefStruct decl-meta name _ _ _)
        (lower-used-type-name-contains? session used-types module name)]
      [(DefStructLifetimes decl-meta name _ _ _ _)
        (lower-used-type-name-contains? session used-types module name)]
      [(Unsafe inner-box)
        (lower-type-decl-used? session module used-types (deref inner-box))]
      [_ true])))

(define (lower-used-types-add-kept-runtime-decl
  [session : cis.InternStructuralSessionHandle]
  [pools : ast.AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [decl : ast.AstDecl]) : lower_i64_i64_map.Map
  (match decl
    [(Def decl-meta _ maybe-ty _)
      (lower-used-types-add-maybe-type session pools used module maybe-ty)]
    [(DefFn decl-meta _ params ret _ _)
      (lower-used-types-add-type
        session
        pools
        (lower-used-types-add-param-list
          session
          pools
          used
          (lower-global-shared-view module)
          params)
        module
        ret)]
    [(DefMacro decl-meta _ params ret _)
      (lower-used-types-add-type
        session
        pools
        (lower-used-types-add-macro-param-list
          session
          pools
          used
          (lower-global-shared-view module)
          params)
        module
        ret)]
    [(Extern decl-meta _ _ _ ty)
      (lower-used-types-add-type session pools used module ty)]
    [(DefEnum decl-meta _ _ _) used]
    [(DefEnumLifetimes decl-meta _ _ _ _) used]
    [(DefStruct decl-meta _ _ _ _) used]
    [(DefStructLifetimes decl-meta _ _ _ _ _) used]
    [(Test _ body-box _ _)
      (lower-used-types-add-expr-id session pools used module body-box)]
    [(Unsafe inner-box)
      (lower-used-types-add-kept-runtime-decl
        session
        pools
        used
        module
        (deref inner-box))]
    [_ used]))

;; A synthesized clone$<T> helper (`stdlib/clone.tl`). Clone helpers are
;; generated as the exact transitive closure the reachable clone roots need and
;; reference one another through `(clone x)` forms the AST reachability walk does
;; not resolve to names, so a reachable helper's callees would otherwise be
;; dropped (undefined-symbol link error). Keep every synthesized helper.
(define (lower-decl-is-clone-helper-inner? [decl : ast.AstDecl]) : bool
  (match decl
    [(DefFn decl-meta name _ _ _ _)
      (lower-name-has-clone-prefix? (tc_core.tc-env-key-name-text name))]
    [(Unsafe inner-box) (lower-decl-is-clone-helper? (deref inner-box))]
    [_ false]))

(define (lower-decl-is-clone-helper? [decl : ast.AstDecl]) : bool
  (match (ast.ast-decl-generated-meta decl)
    [(Some generator _ _ _)
      (if (string.eq generator "stdlib.clone/synthesize-helpers")
        true
        (lower-decl-is-clone-helper-inner? decl))]
    [(No) (lower-decl-is-clone-helper-inner? decl)]))

(define (lower-runtime-decl-kept-by-reach-or-dispatch?
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [reachable : (& reachable lower_i64_i64_map.Map)]
  [dispatch-variants : (& dispatch-variants lower_i64_i64_map.Map)]
  [decl : ast.AstDecl]) : bool
  (if (lower-decl-is-clone-helper? (lower-global-shared-view decl))
    ;; The clone handoff emits exactly the clone$<T> closure reachable code
    ;; needs, so keep it all.
    true
    (match (lower-function-logical-id-from-decl
      lower-state
      entry-path
      decl-path
      module
      module-id
      decl)
      [(Some logical-id)
        (lower-function-kept-by-reach-or-dispatch?
          all-functions
          reachable
          dispatch-variants
          logical-id)]
      [(No) true])))

(define (lower-used-types-add-type-decl-name
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [decl : ast.AstDecl]) : lower_i64_i64_map.Map
  (match decl
    [(DefEnum decl-meta name _ _)
      (lower-used-type-name-add session used module name)]
    [(DefEnumLifetimes decl-meta name _ _ _)
      (lower-used-type-name-add session used module name)]
    [(DefStruct decl-meta name _ _ _)
      (lower-used-type-name-add session used module name)]
    [(DefStructLifetimes decl-meta name _ _ _ _)
      (lower-used-type-name-add session used module name)]
    [(Unsafe inner-box)
      (lower-used-types-add-type-decl-name
        session
        pools
        used
        module
        (deref inner-box))]
    [_ used]))

(define (lower-used-types-path-seed-in-module
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : (& entry-path str)]
  [module : String]
  [reachable-paths : (& reachable-paths lower_i64_i64_map.Map)]
  [used : lower_i64_i64_map.Map]
  [covered : bool]) : LowerUsedTypePathSeed
  (match (ast.ast-decl-list-step decls)
    [(Nil) (Seed used covered)]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(Cons _ path-rest) path-rest]
            [(Nil) (ast.ast-decl-path-list-new)])]
        [path-owner-id : i64
          (ast.ast-decl-path-list-owner-id
            (& paths)
            0
            (csym.compiler-symbol-root-module-id))]
        (match (lower-global-shared-view decl)
          [(Module next-module)
            (lower-used-types-path-seed-in-module
              session
              pools
              rest
              rest-paths
              entry-path
              (lower-name-id-text-for-session session next-module)
              reachable-paths
              used
              covered)]
          [_
            (let
              [is-type-decl : bool
                (lower-type-decl? (lower-global-shared-view decl))]
              [path-covered : bool
                (lower_i64_i64_map.contains? (& reachable-paths) path-owner-id)]
              (lower-used-types-path-seed-in-module
                session
                pools
                rest
                rest-paths
                entry-path
                (lower-global-shared-view module)
                reachable-paths
                (if (and is-type-decl path-covered)
                  (lower-used-types-add-type-decl-name
                    session
                    pools
                    used
                    module
                    decl)
                  used)
                (and covered (or (not is-type-decl) path-covered))))]))]))

(define (lower-used-types-from-kept-decls-in-module
  [session : cis.InternStructuralSessionHandle]
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [reachable : (& reachable lower_i64_i64_map.Map)]
  [dispatch-variants : (& dispatch-variants lower_i64_i64_map.Map)]
  [used : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (match (ast.ast-decl-list-step decls)
    [(Nil) used]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(Cons path _) path]
            [(Nil) (owned_view.compiler-owned-shared-view entry-path)])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(Cons _ path-rest) path-rest]
            [(Nil) (ast.ast-decl-path-list-new)])]
        (match (lower-global-shared-view decl)
          [(Module next-module)
            (lower-used-types-from-kept-decls-in-module
              session
              lower-state
              pools
              rest
              rest-paths
              entry-path
              (lower-name-id-text-for-session session next-module)
              next-module
              all-functions
              reachable
              dispatch-variants
              used)]
          [_
            (lower-used-types-from-kept-decls-in-module
              session
              lower-state
              pools
              rest
              rest-paths
              (lower-global-shared-view entry-path)
              (lower-global-shared-view module)
              module-id
              all-functions
              reachable
              dispatch-variants
              (if (lower-runtime-decl-kept-by-reach-or-dispatch?
                lower-state
                entry-path
                decl-path
                (lower-global-shared-view module)
                module-id
                all-functions
                reachable
                dispatch-variants
                (lower-global-shared-view decl))
                (lower-used-types-add-kept-runtime-decl
                  session
                  pools
                  used
                  module
                  decl)
                used))]))]))

(define (lower-used-types-add-stdlib-arena-support-deps
  [session : cis.InternStructuralSessionHandle]
  [_pools : (& _pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [name : i64]) : lower_i64_i64_map.Map
  ;; `in-arena` and allocation lowering use the arena mark support type even
  ;; when source signatures only mention the public Arena wrapper.
  (if (and
    (string.eq module "stdlib.arena")
    (string.eq (lower-name-id-text-for-session session name) "Arena"))
    (lower-used-type-name-add
      session
      used
      module
      cbi.compiler-builtin-id-fix-ArenaMark)
    used))

(define (lower-used-types-add-type-decl-deps
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [decl : ast.AstDecl]) : lower_i64_i64_map.Map
  (match decl
    [(DefEnum decl-meta _ _ variants)
      (lower-used-types-add-variant-list session pools used module variants)]
    [(DefEnumLifetimes decl-meta _ _ _ variants)
      (lower-used-types-add-variant-list session pools used module variants)]
    [(DefStruct decl-meta name _ _ fields)
      (lower-used-types-add-field-list
        session
        pools
        (lower-used-types-add-stdlib-arena-support-deps
          session
          pools
          used
          (lower-global-shared-view module)
          name)
        module
        fields)]
    [(DefStructLifetimes decl-meta _ _ _ _ fields)
      (lower-used-types-add-field-list session pools used module fields)]
    [(Unsafe inner-box)
      (lower-used-types-add-type-decl-deps
        session
        pools
        used
        module
        (deref inner-box))]
    [_ used]))

(define (lower-used-types-add-type-decl-deps-in-module
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : (& decls ast.AstDeclList)]
  [module : String]
  [used : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  ;; Index cursor rather than `ast-decl-list-step`. The predicates and the
  ;; dependency walk all take `AstDecl` by value, but an aggregate argument is
  ;; passed by reference, so handing them the backing slot costs nothing where
  ;; the step would copy 104 B and write a 144 B result per declaration.
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [decl-offset : i64 decls.offset]
    [index : i64 0]
    [current-module : String module]
    [current-used : lower_i64_i64_map.Map used]
    (while (< index count)
      (match (lower-global-array-element-shared-view
        decl-slots
        (+ decl-offset index))
        [(Module next-module)
          (set!
            current-module
            (lower-name-id-text-for-session session next-module))]
        [_
          (if (and
            (lower-type-decl?
              (lower-global-array-element-shared-view
                decl-slots
                (+ decl-offset index)))
            (or
              (lower-comptime-runtime-skip-module? current-module)
              (lower-type-decl-used?
                session
                current-module
                current-used
                (lower-global-array-element-shared-view
                  decl-slots
                  (+ decl-offset index)))))
            (set!
              current-used
              (lower-used-types-add-type-decl-deps
                session
                pools
                current-used
                (lower-global-shared-view current-module)
                (lower-global-array-element-shared-view
                  decl-slots
                  (+ decl-offset index))))
            unit)])
      (set! index (+ index 1)))
    current-used))

(define (lower-used-types-expand-fixed
  [session : cis.InternStructuralSessionHandle]
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : (& decls ast.AstDeclList)]
  [used : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (let
    [current : lower_i64_i64_map.Map used]
    [iterations : i64 0]
    [done : bool false]
    (while (not done)
      (let
        [before : i64 (lower_i64_i64_map.len (& current))]
        [next : lower_i64_i64_map.Map
          (lower-used-types-add-type-decl-deps-in-module
            session
            pools
            decls
            ""
            (lower-global-shared-view current))]
        (set! current next)
        (set! iterations (+ iterations 1))
        (if (or
          (= before (lower_i64_i64_map.len (& current)))
          (>= iterations 8))
          (set! done true)
          unit)))
    current))

(define (lower-comptime-runtime-skip-module? [module : (& module str)]) : bool
  (string.eq module "stdlib.comptime"))

(define (lower-comptime-error-ids-reset! [lower-state : CompilerLowerState]) : unit
  (let
    [cache : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        comptime-error-cache)]
    [index : i64 0]
    (while (< index lower-comptime-cache-size)
      (set! (array-ref cache index) 0)
      (set! index (+ index 1)))
    (set! (array-ref cache lower-comptime-cache-generation-index) -1)
    (set! (array-ref cache lower-comptime-cache-table-id-index) -1)))

(define (lower-comptime-error-ids-ensure!
  [lower-state : CompilerLowerState]
  [builtin-state : cbi.CompilerBuiltinIdsState]) : unit
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [generation : i64 (ci.intern-compat-state-generation intern-state)]
    [table-id : i64 (ci.intern-compat-state-table-id intern-state)]
    [cache : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        comptime-error-cache)]
    (unless
      (and
        (= (array-ref cache lower-comptime-cache-table-id-index) table-id)
        (= (array-ref cache lower-comptime-cache-generation-index) generation))
      (unless
        (cbi.state-table-current-with? builtin-state generation table-id)
        (io.panic "lower: builtin snapshot does not match intern owner"))
      (set!
        (array-ref cache lower-comptime-cache-id-index)
        (cbi.state-ref builtin-state 94))
      (set!
        (array-ref cache lower-comptime-cache-comptime-dot-id-index)
        (cbi.state-ref builtin-state 90))
      (set!
        (array-ref cache lower-comptime-cache-comptime-slash-id-index)
        (cbi.state-ref builtin-state 90))
      (set!
        (array-ref cache lower-comptime-cache-comptime-error-dot-id-index)
        (cbi.state-ref builtin-state 91))
      (set!
        (array-ref cache lower-comptime-cache-comptime-error-slash-id-index)
        (cbi.state-ref builtin-state 91))
      (set!
        (array-ref cache lower-comptime-cache-stdlib-dot-dot-id-index)
        (cbi.state-ref builtin-state 149))
      (set!
        (array-ref cache lower-comptime-cache-stdlib-dot-slash-id-index)
        (cbi.state-ref builtin-state 149))
      (set!
        (array-ref cache lower-comptime-cache-stdlib-slash-dot-id-index)
        (cbi.state-ref builtin-state 149))
      (set!
        (array-ref cache lower-comptime-cache-stdlib-slash-slash-id-index)
        (cbi.state-ref builtin-state 149))
      (set!
        (array-ref cache lower-comptime-cache-stdlib-error-dot-dot-id-index)
        (cbi.state-ref builtin-state 150))
      (set!
        (array-ref cache lower-comptime-cache-stdlib-error-dot-slash-id-index)
        (cbi.state-ref builtin-state 150))
      (set!
        (array-ref cache lower-comptime-cache-stdlib-error-slash-dot-id-index)
        (cbi.state-ref builtin-state 150))
      (set!
        (array-ref cache lower-comptime-cache-stdlib-error-slash-slash-id-index)
        (cbi.state-ref builtin-state 150))
      ;; Publish the stamp last so readers never accept partially rebuilt IDs.
      (set! (array-ref cache lower-comptime-cache-table-id-index) table-id)
      (set! (array-ref cache lower-comptime-cache-generation-index) generation))))

(define (lower-comptime-error-call-id-with-cache?
  [lower-state : CompilerLowerState]
  [id : i64]) : bool
  (let
    [cache : (__tl_dyn-array i64)
      (compiler-lower-state-read
        lower-state
        (__tl_dyn-array i64)
        comptime-error-cache)]
    (or
      (= id (array-ref cache lower-comptime-cache-id-index))
      (= id (array-ref cache lower-comptime-cache-comptime-dot-id-index))
      (= id (array-ref cache lower-comptime-cache-comptime-slash-id-index))
      (= id (array-ref cache lower-comptime-cache-comptime-error-dot-id-index))
      (=
        id
        (array-ref cache lower-comptime-cache-comptime-error-slash-id-index))
      (= id (array-ref cache lower-comptime-cache-stdlib-dot-dot-id-index))
      (= id (array-ref cache lower-comptime-cache-stdlib-dot-slash-id-index))
      (= id (array-ref cache lower-comptime-cache-stdlib-slash-dot-id-index))
      (= id (array-ref cache lower-comptime-cache-stdlib-slash-slash-id-index))
      (=
        id
        (array-ref cache lower-comptime-cache-stdlib-error-dot-dot-id-index))
      (=
        id
        (array-ref cache lower-comptime-cache-stdlib-error-dot-slash-id-index))
      (=
        id
        (array-ref cache lower-comptime-cache-stdlib-error-slash-dot-id-index))
      (=
        id
        (array-ref cache lower-comptime-cache-stdlib-error-slash-slash-id-index)))))

(define (lower-comptime-error-call-id?
  [lower-state : CompilerLowerState]
  [id : i64]) : bool
  (lower-comptime-error-call-id-with-cache? lower-state id))

(define (lower-comptime-error-source-or-lookup-id?
  [lower-state : CompilerLowerState]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (lower-comptime-error-call-id-with-cache? lower-state source-id)
    (lower-comptime-error-call-id-with-cache? lower-state lookup-id)))

(define (lower-decl-kept-by-reach-or-dispatch?
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [reachable : (& reachable lower_i64_i64_map.Map)]
  [dispatch-variants : (& dispatch-variants lower_i64_i64_map.Map)]
  [used-types : (& used-types lower_i64_i64_map.Map)]
  [decl : ast.AstDecl]) : bool
  (if (lower-type-decl? (lower-global-shared-view decl))
    (or
      (lower-comptime-runtime-skip-module? module)
      (lower-type-decl-used?
        (compiler-lower-state-structural-session lower-state)
        module
        used-types
        decl))
    (lower-runtime-decl-kept-by-reach-or-dispatch?
      lower-state
      entry-path
      decl-path
      module
      module-id
      all-functions
      reachable
      dispatch-variants
      decl)))

(define (lower-filter-reachable-decls-paths-and-plan
  [lower-state : CompilerLowerState]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [used-types : lower_i64_i64_map.Map]) : LowerFilteredReachableWithPlan
  ;; The first reachability walk must materialize a program for clone-root
  ;; discovery. Record its decision for every source declaration at the same
  ;; time. Clone augmentation preserves source order and appends helpers, so
  ;; this dense plan can be applied after whole-program typecheck without
  ;; rebuilding the function/body/dispatch/type reachability indexes.
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [out : ast.AstDeclList (ast.ast-decl-list-with-capacity count)]
    [out-paths : ast.AstDeclPathList
      (ast.ast-decl-path-list-with-capacity count)]
    [keep : (__tl_dyn-array i64) (__tl_make-array i64 count)]
    [source-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [index : i64 0]
    (while (< index count)
      (let
        [decl : ast.AstDecl
          (ast.ast-decl-list-get (& decls) index (ast.ast-decl-fallback))]
        [decl-path : String
          (ast.ast-decl-path-list-get
            (& paths)
            index
            (lower-global-shared-view entry-path))]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            lower-state
            (& paths)
            index
            (lower-global-shared-view entry-path)
            (lower-global-shared-view decl-path)
            source-module-id)]
        [kept : bool
          (match (& decl)
            [(Module _) true]
            [_
              (lower-decl-kept-by-reach-or-dispatch?
                lower-state
                (lower-global-shared-view entry-path)
                (lower-global-shared-view decl-path)
                (lower-decl-owner-module-name
                  lower-state
                  source-module-id
                  logical-module-id)
                logical-module-id
                all-functions
                reachable
                dispatch-variants
                used-types
                (lower-global-shared-view decl))])]
        (when
          kept
          (set! (array-ref keep index) 1)
          (ast.ast-decl-list-push (&mut out) (lower-global-shared-view decl))
          (ast.ast-decl-path-list-push-with-owner-and-provenance-id
            (&mut out-paths)
            decl-path
            (ast.ast-decl-path-list-owner-id (& paths) index source-module-id)
            (ast.ast-decl-path-list-provenance-id
              (& paths)
              index
              cbi.compiler-builtin-id-fix-empty)))
        (match decl
          [(Module next-module) (set! source-module-id next-module)]
          [_ unit])
        (set! index (+ index 1))))
    (Filtered out out-paths (LowerDeclKeepPlan keep count))))

(define (lower-decl-keep-plan-all [count : i64]) : LowerDeclKeepPlan
  (let
    [keep : (__tl_dyn-array i64) (__tl_make-array i64 count)]
    [index : i64 0]
    (while (< index count)
      (set! (array-ref keep index) 1)
      (set! index (+ index 1)))
    (LowerDeclKeepPlan keep count)))

(define (lower-decl-required-by-clone-roots?
  [roots : (& roots clone_support.CloneNameSet)]
  [module-id : i64]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(DefEnum decl-meta name _ _)
      (clone_support.clone-name-set-contains-canonical-id? roots module-id name)]
    [(DefStruct decl-meta name _ _ _)
      (clone_support.clone-name-set-contains-canonical-id? roots module-id name)]
    [(Unsafe inner-box)
      (lower-decl-required-by-clone-roots? roots module-id (deref inner-box))]
    [_ false]))

(define (lower-decl-keep-plan-add-clone-roots
  [plan : LowerDeclKeepPlan]
  [program : ast.AstProgram]
  [clone-roots : clone_support.CloneRootEntries]) : LowerDeclKeepPlan
  ;; Clone-root discovery already computes the exact transitive nominal-type
  ;; closure required by generated helpers. Merge those type declarations into
  ;; the retained plan before source-pool compaction can release their AST.
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (deref decls-box)]
        [keep : (__tl_dyn-array i64) plan.keep]
        [source-count : i64 plan.source-count]
        [roots : clone_support.CloneNameSet
          (clone_support.clone-root-entries-to-set
            clone-roots
            (clone_support.clone-name-set-empty))]
        [module-id : i64 cbi.compiler-builtin-id-fix-empty]
        [index : i64 0]
        [count : i64 (ast.ast-decl-list-len (& decls))]
        (while (and (< index count) (< index source-count))
          (let
            [decl : ast.AstDecl
              (ast.ast-decl-list-get (& decls) index (ast.ast-decl-fallback))]
            (if (lower-decl-required-by-clone-roots?
              roots
              module-id
              (lower-global-shared-view decl))
              (set! (array-ref keep index) 1)
              unit)
            (match decl
              [(Module next-module) (set! module-id next-module)]
              [_ unit])
            (set! index (+ index 1))))
        (LowerDeclKeepPlan keep source-count))]))

(define (lower-decl-keep-plan-copy-into-pools
  [plan : LowerDeclKeepPlan]
  [pools : (& pools ast.AstNodePoolContext)]) : LowerDeclKeepPlan
  (let
    [base-arena : arena.Arena
      (arena.Arena (ast.ast-node-pool-context-base-arena pools))]
    (in-arena
      base-arena
      (let
        [source : (__tl_dyn-array i64) plan.keep]
        [count : i64 plan.source-count]
        [keep : (__tl_dyn-array i64) (__tl_make-array i64 count)]
        [index : i64 0]
        (while (< index count)
          (set! (array-ref keep index) (array-ref source index))
          (set! index (+ index 1)))
        (LowerDeclKeepPlan keep count)))))

(define (lower-decl-keep-plan-apply
  [plan : (& plan LowerDeclKeepPlan)]
  [program : ast.AstProgram]) : ast.AstProgram
  ;; Source declarations retain their indices through clone augmentation;
  ;; generated clone helpers are appended and all are part of the exact root
  ;; closure, so retain them without another graph walk.
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (deref decls-box)]
        [count : i64 (ast.ast-decl-list-len (& decls))]
        [source-count : i64 plan.source-count]
        [keep : (__tl_dyn-array i64) plan.keep]
        [out : ast.AstDeclList (ast.ast-decl-list-with-capacity count)]
        [index : i64 0]
        (while (< index count)
          (if (or (>= index source-count) (not (= (array-ref keep index) 0)))
            (ast.ast-decl-list-push
              (&mut out)
              (ast.ast-decl-list-get (& decls) index (ast.ast-decl-fallback)))
            unit)
          (set! index (+ index 1)))
        (ast.ast-program out))]))

(define (lower-decl-keep-plan-apply-paths
  [plan : LowerDeclKeepPlan]
  [paths : ast.AstDeclPathList]) : ast.AstDeclPathList
  (let
    [source-count : i64 plan.source-count]
    [keep : (__tl_dyn-array i64) plan.keep]
    [count : i64 (ast.ast-decl-path-list-len (& paths))]
    [limit : i64
      (if (< source-count count)
        source-count
        count)]
    [out : ast.AstDeclPathList (ast.ast-decl-path-list-with-capacity limit)]
    [index : i64 0]
    (while (< index limit)
      (when
        (not (= (array-ref keep index) 0))
        (ast.ast-decl-path-list-push-with-owner-and-provenance-id
          (&mut out)
          (ast.ast-decl-path-list-get (& paths) index "")
          (ast.ast-decl-path-list-owner-id
            (& paths)
            index
            cbi.compiler-builtin-id-fix-empty)
          (ast.ast-decl-path-list-provenance-id
            (& paths)
            index
            cbi.compiler-builtin-id-fix-empty)))
      (set! index (+ index 1)))
    out))

(defenum LowerReachStateCell
  (Occupied LowerReachState))

(define (lower-reach-add-clone-root-helpers
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [names : (& names LowerNameCache)]
  [roots : clone_support.CloneRootEntries]
  [state : LowerReachState]) : LowerReachState
  (let
    [cell : LowerReachStateCell (Occupied state)]
    [index : i64 0]
    [count : i64 (clone_support.clone-root-entries-len roots)]
    (while (< index count)
      (match cell
        [(Occupied current)
          (set!
            cell
            (Occupied
              (lower-reach-add-source-id
                all-functions
                names
                current
                (clone_support.clone-root-entries-helper-id-at-or
                  roots
                  index
                  -1))))])
      (set! index (+ index 1)))
    (match cell
      [(Occupied result) result])))

;; Functions with an `(:export-symbol ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦)` declaration publish a fixed
;; ABI symbol and may be called only from outside TypeLisp IR (e.g. the
;; backend-emitted bounds/division/shift checks call the runtime-prelude
;; handlers). Seed every exported function as a reachability root so the prune
;; keeps it and its transitive callees even with no IR caller.
(define (lower-reach-add-export-root-decl
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [state : LowerReachState]
  [decl : ast.AstDecl]) : LowerReachState
  (match decl
    [(DefFn decl-meta name _ _ _ metadata)
      (let
        [logical-name-id : i64 (lower-module-name-key-id-by-id module-id name)]
        [export-state : LowerReachState
          (match (ast.ast-fn-metadata-export
            (lower-global-shared-view metadata))
            [(Export symbol)
              (if (lower-runtime-prelude-selective-export-id?
                module-id
                (ci.intern-id-value symbol))
                state
                (lower-reach-add-logical all-functions state logical-name-id))]
            [(No) state])]
        (match (ast.ast-fn-metadata-spmd-callable metadata)
          [(No) export-state]
          [(Callable _)
            (lower-reach-add-logical all-functions export-state logical-name-id)]))]
    [(Extern decl-meta _ kind metadata _)
      (match kind
        [(Function)
          (lower-reach-add-runtime-prelude-string-helper-id
            all-functions
            state
            (ci.intern-id-value
              (ast.ast-extern-metadata-symbol-id (deref metadata))))]
        [(Value) state])]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-reach-add-export-root-decl
          entry-path
          decl-path
          module
          module-id
          all-functions
          state
          inner))]
    [_ state]))

(define (lower-reach-add-export-roots-in-module
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : (& all-functions lower_i64_i64_map.Map)]
  [state : LowerReachState]) : LowerReachState
  (match (ast.ast-decl-list-step decls)
    [(Nil) state]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(Cons path _) path]
            [(Nil) (owned_view.compiler-owned-shared-view entry-path)])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(Cons _ path-rest) path-rest]
            [(Nil) (ast.ast-decl-path-list-new)])]
        (match (lower-global-shared-view decl)
          [(Module next-module)
            (lower-reach-add-export-roots-in-module
              rest
              rest-paths
              entry-path
              (lower-name-id-text
                (lower-reach-state-owner (lower-global-shared-view state))
                next-module)
              next-module
              all-functions
              state)]
          [_
            (lower-reach-add-export-roots-in-module
              rest
              rest-paths
              (lower-global-shared-view entry-path)
              (lower-global-shared-view module)
              module-id
              all-functions
              (lower-reach-add-export-root-decl
                entry-path
                decl-path
                module
                module-id
                all-functions
                state
                decl))]))]))

(define (lower-prune-unreachable-functions-with-clone-roots-and-plan
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [names : LowerNameEnv]
  [clone-roots : clone_support.CloneRootEntries]) : LowerPrunedProgramWithPlan
  (match (lower-global-shared-view program)
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (deref decls-box)]
        ;; Publish the whole-program global name cache so the per-module
        ;; body name-cache overlays built inside lower-function-body-index-from-decls
        ;; (and resolved during lower-reach-process below) can fall through to it.
        ;; Kept in the PERSISTENT (caller) arena so it survives the scratch rewind
        ;; below (the original behavior); decl-lowering re-sets it before use.
        [_set-global : unit
          (begin
            (lower-active-global-name-cache-set!
              lower-state
              (lower-name-cache-from-env
                lower-state
                (lower-global-shared-view names)))
            unit)]
        ;; The reachability scratch (function/dispatch sets, body index and
        ;; its per-module name overlays, the reachable map) is the bulk of the
        ;; prune cost and adds zero AST/type pool
        ;; nodes -- pure transient scratch. Build it inside the dedicated lower
        ;; scratch arena and rewind it once the pruned program is materialized.
        ;; The pruned decl/path lists only reference shared decl nodes (by
        ;; node id) and interned strings, never the scratch maps, so they are
        ;; safe to keep in the persistent arena after the rewind (mirrors the
        ;; scratch+escape pattern in lower-function-escaping).
        [prev-arena : i64 (arena.tl_arena_current)]
        [scratch : i64 (lower-scratch-arena-get)]
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [mark : i64 (arena.tl_region_mark)]
          [all-functions : lower_i64_i64_map.Map
            (lower-function-set-from-decls
              lower-state
              (lower-global-shared-view decls)
              paths
              (lower-global-shared-view entry-path))]
          [body-index : LowerFunctionBodyIndex
            (lower-function-body-index-from-decls
              lower-state
              pools
              (lower-global-shared-view decls)
              (lower-global-shared-view paths)
              (lower-global-shared-view entry-path)
              (lower-global-shared-view names)
              (lower-function-decl-count (lower-global-shared-view decls)))]
          [name-cache : LowerNameCache
            (lower-name-cache-from-env lower-state names)]
          [dispatch-variants : lower_i64_i64_map.Map
            (lower-dispatch-variant-set-from-decls
              (lower-global-shared-view decls)
              paths
              (lower-global-shared-view entry-path)
              name-cache)]
          [main-id : i64 (lower-entry-main-logical-id all-functions)]
          [result : LowerPrunedProgramWithPlan
            (if (>= main-id 0)
              (begin
                (compiler-lower-state-write!
                  lower-state
                  lower_i64_i64_map.Map
                  reach-active-runtime-paths
                  (lower_i64_i64_map.with-capacity 1024))
                (compiler-lower-state-write!
                  lower-state
                  lower_i64_i64_map.Map
                  reach-active-body-used-types
                  (lower-used-types-precise-empty))
                (let
                  [main-state : LowerReachState
                    (lower-reach-add-logical
                      all-functions
                      (State
                        (lower_i64_i64_map.with-capacity 8192)
                        (lower-id-set-empty)
                        lower-state)
                      main-id)]
                  [export-state : LowerReachState
                    (lower-reach-add-export-roots-in-module
                      (lower-global-shared-view decls)
                      (lower-global-shared-view paths)
                      (lower-global-shared-view entry-path)
                      ""
                      cbi.compiler-builtin-id-fix-empty
                      all-functions
                      main-state)]
                  [cleanup-state : LowerReachState
                    (lower-reach-cleanup-metadata-roots-in-module
                      all-functions
                      (lower-global-shared-view decls)
                      (lower-global-shared-view paths)
                      (lower-global-shared-view entry-path)
                      ""
                      cbi.compiler-builtin-id-fix-empty
                      name-cache
                      export-state)]
                  [clone-state : LowerReachState
                    (lower-reach-add-clone-root-helpers
                      all-functions
                      name-cache
                      clone-roots
                      cleanup-state)]
                  [dispatch-state : LowerReachState
                    (lower-reach-add-dispatch-variant-roots
                      all-functions
                      (lower-global-shared-view decls)
                      name-cache
                      clone-state)]
                  [global-state : LowerReachState
                    (lower-reach-global-decls
                      pools
                      all-functions
                      (lower-global-shared-view name-cache)
                      dispatch-state
                      (lower-global-shared-view decls)
                      (lower-global-shared-view paths)
                      (lower-global-shared-view entry-path)
                      cbi.compiler-builtin-id-fix-empty)]
                  [reached-state : LowerReachState
                    (lower-reach-process
                      pools
                      all-functions
                      name-cache
                      body-index
                      global-state)]
                  (match reached-state
                    [(State reachable _ _)
                      (let
                        [runtime-paths : lower_i64_i64_map.Map
                          (compiler-lower-state-read
                            lower-state
                            lower_i64_i64_map.Map
                            reach-active-runtime-paths)]
                        [body-used-types : lower_i64_i64_map.Map
                          (compiler-lower-state-read
                            lower-state
                            lower_i64_i64_map.Map
                            reach-active-body-used-types)]
                        [type-path-seed : LowerUsedTypePathSeed
                          (lower-used-types-path-seed-in-module
                            (compiler-lower-state-structural-session
                              lower-state)
                            pools
                            (lower-global-shared-view decls)
                            (lower-global-shared-view paths)
                            entry-path
                            ""
                            runtime-paths
                            body-used-types
                            true)]
                        [used-types : lower_i64_i64_map.Map
                          (match type-path-seed
                            [(Seed reachable-path-type-names type-paths-covered)
                              (if type-paths-covered
                                (lower_i64_i64_map.with-capacity 8)
                                (lower-used-types-expand-fixed
                                  (compiler-lower-state-structural-session
                                    lower-state)
                                  pools
                                  decls
                                  (lower-used-types-from-kept-decls-in-module
                                    (compiler-lower-state-structural-session
                                      lower-state)
                                    lower-state
                                    pools
                                    (lower-global-shared-view decls)
                                    (lower-global-shared-view paths)
                                    (lower-global-shared-view entry-path)
                                    ""
                                    cbi.compiler-builtin-id-fix-empty
                                    all-functions
                                    reachable
                                    dispatch-variants
                                    reachable-path-type-names)))])]
                        ;; Materialize the pruned program back in the persistent
                        ;; arena before rewinding the scratch arena.
                        (unsafe
                          (arena.tl_arena_set prev-arena))
                        (let
                          [filtered : LowerFilteredReachableWithPlan
                            (lower-filter-reachable-decls-paths-and-plan
                              lower-state
                              decls
                              paths
                              entry-path
                              all-functions
                              reachable
                              dispatch-variants
                              used-types)]
                          [pruned : LowerPrunedProgramWithPlan
                            (match filtered
                              [(Filtered
                                  filtered-decls
                                  filtered-paths
                                  keep-plan)
                                (Program
                                  (ast.ast-program filtered-decls)
                                  filtered-paths
                                  keep-plan)])]
                          (unsafe
                            (arena.tl_arena_set scratch)
                            (arena.tl_region_reset mark)
                            (arena.tl_arena_set prev-arena))
                          pruned))])))
              (begin
                (unsafe
                  (arena.tl_arena_set scratch)
                  (arena.tl_region_reset mark)
                  (arena.tl_arena_set prev-arena))
                (Program
                  program
                  paths
                  (lower-decl-keep-plan-all (ast.ast-decl-list-len (& decls))))))]
          (lower-reach-scratch-state-reset! lower-state)
          result))]))

(define (lower-state-next-var [state : LowerState]) : i64
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) next-var)))

(define (lower-state-current-label [state : LowerState]) : i64
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) current-label)))

(define (lower-state-current-function [state : LowerState]) : String
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (ir.compiler-ir-symbol-text
      (__tl-project-field (__tl-box-place data) function))))

(define (lower-state-current-function-id [state : LowerState]) : i64
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) function)))

(define (lower-state-spans [state : LowerState]) : ir.CompilerSourceSpans
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-box-place (__tl-project-field (__tl-box-place data) spans))))

(define (lower-state-names [state : LowerState]) : LowerNameCache
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) names)))

(define (lower-state-owner [state : LowerState]) : CompilerLowerState
  (let
    [names (lower-state-names state)]
    (compiler-lower-state-from-name-cache names)))

(define (lower-state-current-source-path-id [state : LowerState]) : i64
  (compiler-lower-state-read
    (lower-state-owner state)
    i64
    current-source-path-id))

(define (lower-state-current-decl-generated? [state : LowerState]) : bool
  (compiler-lower-state-read
    (lower-state-owner state)
    bool
    current-decl-generated))

(define (lower-state-active-loop-function [state : LowerState]) : i64
  (compiler-lower-state-read (lower-state-owner state) i64 active-loop-function))

(define (lower-state-active-loop-entry-var-limit [state : LowerState]) : i64
  (compiler-lower-state-read
    (lower-state-owner state)
    i64
    active-loop-entry-var-limit))

(define (lower-state-type-cache [state : LowerState]) : LowerTypeCache
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) type-cache)))

(define (lower-state-function-state [state : LowerState]) : CompilerLowerFunctionState
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) function-state)))

(define (lower-state-mode [state : LowerState]) : CompilerLowerMode
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) mode)))

(define (lower-masked-preheader-cache-new) : (Box LowerMaskedPreheaderCacheData)
  (box
    (LowerMaskedPreheaderCacheData
      (ir.compiler-ir-instr-builder-new)
      (__tl_make-array ir.CompilerIrValue 0)
      (__tl_make-array ast.AstType 0)
      (__tl_make-array ir.CompilerIrValue 0)
      0
      (__tl_make-array i64 0)
      (__tl_make-array ir.CompilerIrValue 0)
      0)))

(define (lower-state-masked-preheader-cache [state : LowerState]) : LowerMaybeMaskedPreheaderCache
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    [view : LowerStateData (deref data)]
    view.masked-preheader-cache))

(define (lower-masked-preheader-cache-set!
  [state : LowerState]
  [cache : (Box LowerMaskedPreheaderCacheData)]) : unit
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-set-field
      (__tl-box-place data)
      masked-preheader-cache
      (LowerMaybeMaskedPreheaderCache.Some cache))))

(define (lower-masked-preheader-cache-disable! [state : LowerState]) : unit
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-set-field
      (__tl-box-place data)
      masked-preheader-cache
      (LowerMaybeMaskedPreheaderCache.No))))

(define (lower-masked-preheader-uniform-get
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : LowerMaybeIrValue
  (match (lower-state-masked-preheader-cache state)
    [(No) (No)]
    [(Some cache)
      (let
        [cache-data : LowerMaskedPreheaderCacheData (deref cache)]
        [uniform-values : (__tl_dyn-array ir.CompilerIrValue)
          cache-data.uniform-values]
        [uniform-types : (__tl_dyn-array ast.AstType) cache-data.uniform-types]
        [uniform-vectors : (__tl_dyn-array ir.CompilerIrValue)
          cache-data.uniform-vectors]
        [index : i64 0]
        [count : i64 cache-data.uniform-count]
        (while (< index count)
          (when
            (and
              (lower-vector-map-ir-value-eq?
                (lower-global-shared-view value)
                (lower-global-array-element-shared-view uniform-values index))
              (tc_core.tc-type-eq
                (lower-global-shared-view elem-ty)
                (lower-global-array-element-shared-view uniform-types index)))
            (return
              (Some
                (lower-global-array-element-shared-view uniform-vectors index))))
          (set! index (+ index 1)))
        (No))]))

(define (lower-masked-preheader-uniform-add!
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [vector : ir.CompilerIrValue]) : unit
  (match (lower-state-masked-preheader-cache state)
    [(No) unit]
    [(Some cache)
      (let
        [cache-data : LowerMaskedPreheaderCacheData
          (lower-box-shared-view cache)]
        [count : i64 cache-data.uniform-count]
        [values : (__tl_dyn-array ir.CompilerIrValue) cache-data.uniform-values]
        [types : (__tl_dyn-array ast.AstType) cache-data.uniform-types]
        [vectors : (__tl_dyn-array ir.CompilerIrValue)
          cache-data.uniform-vectors]
        (__tl_array-push! values value)
        (__tl_array-push! types elem-ty)
        (__tl_array-push! vectors vector)
        (__tl-project-set-field
          (__tl-box-place cache)
          uniform-count
          (+ count 1)))]))

(define (lower-masked-preheader-uniform-can-add? [state : LowerState]) : bool
  (match (lower-state-masked-preheader-cache state)
    [(No) false]
    [(Some _cache) true]))

(define (lower-masked-preheader-array-data-get
  [state : LowerState]
  [array-var : i64]) : LowerMaybeIrValue
  (match (lower-state-masked-preheader-cache state)
    [(No) (No)]
    [(Some cache)
      (let
        [cache-data : LowerMaskedPreheaderCacheData (deref cache)]
        [array-vars : (__tl_dyn-array i64) cache-data.array-vars]
        [array-data : (__tl_dyn-array ir.CompilerIrValue) cache-data.array-data]
        [index : i64 0]
        [count : i64 cache-data.array-count]
        (while (< index count)
          (when
            (= array-var (array-ref array-vars index))
            (return
              (Some (lower-global-array-element-shared-view array-data index))))
          (set! index (+ index 1)))
        (No))]))

(define (lower-masked-preheader-array-data-add!
  [state : LowerState]
  [array-var : i64]
  [data : ir.CompilerIrValue]) : unit
  (match (lower-state-masked-preheader-cache state)
    [(No) unit]
    [(Some cache)
      (let
        [cache-data : LowerMaskedPreheaderCacheData
          (lower-box-shared-view cache)]
        [count : i64 cache-data.array-count]
        [vars : (__tl_dyn-array i64) cache-data.array-vars]
        [values : (__tl_dyn-array ir.CompilerIrValue) cache-data.array-data]
        (__tl_array-push! vars array-var)
        (__tl_array-push! values data)
        (__tl-project-set-field (__tl-box-place cache) array-count (+ count 1)))]))

(define (lower-masked-load-cache-entry-capacity) : i64
  32)

(define (lower-masked-load-cache-mask-capacity) : i64
  64)

;; -1 is the symbolic all-active mask; -2 is an uncacheable non-variable mask.
(define (lower-masked-load-mask-key [mask : ir.CompilerIrMaybeValue]) : i64
  (match mask
    [(No) -1]
    [(Some value)
      (match value
        [(Var var) var]
        [_ -2])]))

(define (lower-state-masked-load-cache [state : LowerState]) : LowerMaybeMaskedLoadCache
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) masked-load-cache)))

(define (lower-masked-load-cache-enable! [state : LowerState]) : unit
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (match (__tl-project-field (__tl-box-place data) masked-load-cache)
      [(No)
        (__tl-project-set-field
          (__tl-box-place data)
          masked-load-cache
          (LowerMaybeMaskedLoadCache.Some
            (box
              (LowerMaskedLoadCacheData
                (__tl_make-array i64 (lower-masked-load-cache-entry-capacity))
                (__tl_make-array i64 (lower-masked-load-cache-entry-capacity))
                (__tl_make-array i64 (lower-masked-load-cache-entry-capacity))
                (__tl_make-array
                  ir.CompilerIrValue
                  (lower-masked-load-cache-entry-capacity))
                0
                (__tl_make-array i64 (lower-masked-load-cache-mask-capacity))
                (__tl_make-array i64 (lower-masked-load-cache-mask-capacity))
                0))))]
      [(Some cache)
        (__tl-project-set-field (__tl-box-place cache) count 0)
        (__tl-project-set-field (__tl-box-place cache) mask-count 0)])))

;; Memory effects retire values but keep the mask ancestry: the control-flow
;; proof remains true and can classify loads emitted after the effect.
(define (lower-masked-load-cache-invalidate! [state : LowerState]) : unit
  (match (lower-state-masked-load-cache state)
    [(No) unit]
    [(Some cache) (__tl-project-set-field (__tl-box-place cache) count 0)]))

(define (lower-masked-load-mask-parent-at
  [state : LowerState]
  [mask : i64]
  [index : i64]) : i64
  (match (lower-state-masked-load-cache state)
    [(No) -2]
    [(Some cache)
      (let
        [count : i64 (__tl-project-field (__tl-box-place cache) mask-count)]
        (if (>= index count)
          -2
          (if (=
            (array-ref
              (__tl-project-field (__tl-box-place cache) mask-vars)
              index)
            mask)
            (array-ref
              (__tl-project-field (__tl-box-place cache) mask-parents)
              index)
            (lower-masked-load-mask-parent-at state mask (+ index 1)))))]))

(define (lower-masked-load-mask-dominates-with-fuel?
  [state : LowerState]
  [defining-mask : i64]
  [current-mask : i64]
  [fuel : i64]) : bool
  (if (or (= defining-mask -1) (= defining-mask current-mask))
    true
    (if (or (<= fuel 0) (< current-mask 0))
      false
      (let
        [parent : i64 (lower-masked-load-mask-parent-at state current-mask 0)]
        (if (= parent -2)
          false
          (lower-masked-load-mask-dominates-with-fuel?
            state
            defining-mask
            parent
            (- fuel 1)))))))

(define (lower-masked-load-mask-dominates?
  [state : LowerState]
  [defining-mask : i64]
  [current-mask : i64]) : bool
  (match (lower-state-masked-load-cache state)
    [(No) false]
    [(Some cache)
      (lower-masked-load-mask-dominates-with-fuel?
        state
        defining-mask
        current-mask
        (+ (__tl-project-field (__tl-box-place cache) mask-count) 1))]))

(define (lower-masked-load-register-mask!
  [state : LowerState]
  [parent : ir.CompilerIrMaybeValue]
  [child : ir.CompilerIrValue]) : unit
  (let
    [parent-key : i64 (lower-masked-load-mask-key parent)]
    [child-key : i64 (lower-masked-load-mask-key (Some child))]
    (if (or (< parent-key -1) (< child-key 0) (= parent-key child-key))
      unit
      (match (lower-state-masked-load-cache state)
        [(No) unit]
        [(Some cache)
          (let
            [count : i64 (__tl-project-field (__tl-box-place cache) mask-count)]
            (unless
              (or
                (not
                  (= (lower-masked-load-mask-parent-at state child-key 0) -2))
                (>= count (lower-masked-load-cache-mask-capacity)))
              (set!
                (array-ref
                  (__tl-project-field (__tl-box-place cache) mask-vars)
                  count)
                child-key)
              (set!
                (array-ref
                  (__tl-project-field (__tl-box-place cache) mask-parents)
                  count)
                parent-key)
              (__tl-project-set-field
                (__tl-box-place cache)
                mask-count
                (+ count 1))))]))))

(define (lower-masked-load-cache-get-at
  [state : LowerState]
  [array-var : i64]
  [offset : i64]
  [mask : i64]
  [index : i64]) : LowerMaybeMaskedLoad
  (match (lower-state-masked-load-cache state)
    [(No) (No)]
    [(Some cache)
      (let
        [count : i64 (__tl-project-field (__tl-box-place cache) count)]
        (if (>= index count)
          (No)
          (if (and
            (=
              (array-ref
                (__tl-project-field (__tl-box-place cache) array-vars)
                index)
              array-var)
            (=
              (array-ref
                (__tl-project-field (__tl-box-place cache) offsets)
                index)
              offset)
            (lower-masked-load-mask-dominates?
              state
              (array-ref
                (__tl-project-field (__tl-box-place cache) masks)
                index)
              mask))
            (Some
              (lower-global-array-element-shared-view
                (__tl-project-field (__tl-box-place cache) values)
                index))
            (lower-masked-load-cache-get-at
              state
              array-var
              offset
              mask
              (+ index 1)))))]))

(define (lower-masked-load-cache-get
  [state : LowerState]
  [array-var : i64]
  [offset : i64]
  [active-mask : ir.CompilerIrMaybeValue]) : LowerMaybeMaskedLoad
  (let
    [mask : i64 (lower-masked-load-mask-key active-mask)]
    (if (< mask -1)
      (No)
      (lower-masked-load-cache-get-at state array-var offset mask 0))))

(define (lower-masked-load-cache-put!
  [state : LowerState]
  [array-var : i64]
  [offset : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [value : ir.CompilerIrValue]) : unit
  (let
    [mask : i64 (lower-masked-load-mask-key active-mask)]
    (if (< mask -1)
      unit
      (match (lower-state-masked-load-cache state)
        [(No) unit]
        [(Some cache)
          (let
            [count : i64 (__tl-project-field (__tl-box-place cache) count)]
            (unless
              (>= count (lower-masked-load-cache-entry-capacity))
              (set!
                (array-ref
                  (__tl-project-field (__tl-box-place cache) array-vars)
                  count)
                array-var)
              (set!
                (array-ref
                  (__tl-project-field (__tl-box-place cache) offsets)
                  count)
                offset)
              (set!
                (array-ref
                  (__tl-project-field (__tl-box-place cache) masks)
                  count)
                mask)
              (set!
                (array-ref
                  (__tl-project-field (__tl-box-place cache) values)
                  count)
                value)
              (__tl-project-set-field (__tl-box-place cache) count (+ count 1))))]))))

(define (lower-masked-load-cache-invalidate-result [result : ResultLowerExpr]) : ResultLowerExpr
  (match (lower-global-shared-view result)
    [(Ok lowered)
      (match lowered
        [(Expr state _ _)
          (lower-masked-load-cache-invalidate! state)
          result])]
    [(Err _) result]))

(define (lower-state-register-address-taken-var?
  [state : LowerState]
  [var-id : i64]) : bool
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (lower_i64_i64_map.contains?
      (& (__tl-project-field (__tl-box-place data) address-taken))
      var-id)))

(define (lower-state-register-address-taken-mark
  [state : LowerState]
  [var-id : i64]) : LowerState
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (lower_i64_i64_map.insert-ref!
      (&mut (__tl-project-field (__tl-box-place data) address-taken))
      var-id
      1)
    state))

(define (lower-state-deferred-copy? [state : LowerState] [var-id : i64]) : bool
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (and
      (not
        (lower_i64_i64_map.is-empty?
          (& (__tl-project-field (__tl-box-place data) deferred-copies))))
      (lower_i64_i64_map.contains?
        (& (__tl-project-field (__tl-box-place data) deferred-copies))
        var-id))))

(define (lower-state-deferred-copy-mark [state : LowerState] [var-id : i64]) : LowerState
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (lower_i64_i64_map.insert-ref!
      (&mut (__tl-project-field (__tl-box-place data) deferred-copies))
      var-id
      1)
    state))

(define (lower-state-deferred-arm-body [state : LowerState]) : i64
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) deferred-arm-body)))

(define (lower-state-set-deferred-arm-body!
  [state : LowerState]
  [body-id : i64]) : unit
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-set-field (__tl-box-place data) deferred-arm-body body-id)))

(define (lower-state-tail-param-start [state : LowerState]) : i64
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) tail-param-start)))

(define (lower-state-tail-param-end [state : LowerState]) : i64
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) tail-param-end)))

(define (lower-state-tail-param-range-contains?
  [state : LowerState]
  [var-id : i64]) : bool
  (and
    (>= var-id (lower-state-tail-param-start state))
    (< var-id (lower-state-tail-param-end state))))

(define (lower-state-clear-tail-param-range [state : LowerState]) : LowerState
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-set-field (__tl-box-place data) tail-param-start 0)
    (__tl-project-set-field (__tl-box-place data) tail-param-end 0)
    state))

(define (lower-state-alloc-var [state : LowerState]) : LowerAlloc
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    [next-var : i64 (__tl-project-field (__tl-box-place data) next-var)]
    (__tl-project-set-field (__tl-box-place data) next-var (+ next-var 1))
    (Alloc state next-var)))

(define (lower-state-next-label-number [state : LowerState]) : i64
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (__tl-project-field (__tl-box-place data) next-label)))

(define (lower-state-fresh-label [state : LowerState] [prefix : String]) : LowerLabel
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    [next-label : i64 (__tl-project-field (__tl-box-place data) next-label)]
    (__tl-project-set-field (__tl-box-place data) next-label (+ next-label 1))
    (Label
      state
      (ir.compiler-ir-label
        (str_cat.str-cat prefix "." (string.int->string next-label))))))

(define (lower-state-fresh-lambda-name [state : LowerState]) : LowerLambdaName
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    [next-lambda : i64 (__tl-project-field (__tl-box-place data) next-lambda)]
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns
        (let
          [name-cache (lower-box-field-shared-view data names)]
          (compiler-lower-state-from-name-cache name-cache)))]
    [components : i64
      (ci.intern-compat-state-composite-pair-id
        (&mut intern-state)
        (__tl-project-field (__tl-box-place data) function)
        next-lambda)]
    [lambda-id : i64
      (ci.intern-compat-state-generated-role-symbol-id
        (&mut intern-state)
        (ci.intern-generated-symbol-role-lambda)
        components)]
    (__tl-project-set-field (__tl-box-place data) next-lambda (+ next-lambda 1))
    (Name state lambda-id)))

(define (lower-state-emit [state : LowerState] [instr : ir.CompilerIrInstr]) : LowerState
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (ir.compiler-ir-instr-builder-push!
      (&mut (__tl-project-field (__tl-box-place data) current-instrs))
      instr)
    state))

(define (lower-runtime-abort-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(BoundsCheck _ _ _) true]
    [(BinOp _ op _ _ _) (ir.compiler-ir-binop-may-fault? op)]
    [(Call _ name _ _)
      (let
        [text : String (ir.compiler-ir-symbol-text name)]
        (or
          (string.eq text "stdlib/io.tl::stdlib.io/panic")
          (string.eq text "stdlib\\io.tl::stdlib.io/panic")))]
    [_ false]))

(define (lower-state-emit-at-expr
  [ctx : (& ctx tc_core.TcContext)]
  [state : LowerState]
  [instr : ir.CompilerIrInstr]
  [expr : ast.AstExpr]) : LowerState
  (if (or
    (ir.compiler-debug-info-enabled?)
    (and
      (not (lower-state-current-decl-generated? state))
      (lower-runtime-abort-instr? (lower-global-shared-view instr))))
    (let
      [data : (Box LowerStateData) (lower-state-box state)]
      [pools : ast.AstNodePoolContext
        (tc_core.tc-context-pools
          (owned_view.compiler-owned-reference-shared-view ctx))]
      [next-spans : ir.CompilerSourceSpans
        (match (lower-ast-expr-span (& pools) expr)
          [(Some span)
            (ir.compiler-source-spans-insert-instr-located
              (lower-boxed-box-field-shared-view data spans)
              (ir.compiler-ir-symbol-typed-id
                (lower-box-field-shared-view data function))
              (lower-global-shared-view instr)
              (lower-state-current-source-path-id state)
              span)]
          [(No) (lower-boxed-box-field-shared-view data spans)])]
      (ir.compiler-ir-instr-builder-push!
        (&mut (__tl-project-field (__tl-box-place data) current-instrs))
        instr)
      (__tl-project-set-field (__tl-box-place data) spans (box next-spans))
      state)
    (lower-state-emit state instr)))

;; Bounds-check helpers emit their BoundsCheck before the final GEP/load and do
;; not otherwise carry the source expression. Immediately after such a helper
;; returns, its most recently allocated label is the unique LABEL-PREFIX key.
(define (lower-state-record-latest-bounds-check-named-at-expr
  [ctx : (& ctx tc_core.TcContext)]
  [state : LowerState]
  [label-prefix : String]
  [expr : ast.AstExpr]) : LowerState
  (let
    [pools : ast.AstNodePoolContext
      (tc_core.tc-context-pools
        (owned_view.compiler-owned-reference-shared-view ctx))]
    (if (and
      (lower-state-current-decl-generated? state)
      (not (ir.compiler-debug-info-enabled?)))
      state
      (match (lower-ast-expr-span (& pools) expr)
        [(No) state]
        [(Some span)
          (let
            [data : (Box LowerStateData) (lower-state-box state)]
            [bounds-label : i64
              (ir.compiler-ir-label
                (str_cat.str-cat
                  (str_cat.str-cat label-prefix ".")
                  (string.int->string
                    (- (lower-box-field-shared-view data next-label) 1))))]
            [next-spans : ir.CompilerSourceSpans
              (ir.compiler-source-spans-insert-instr-located
                (lower-boxed-box-field-shared-view data spans)
                (ir.compiler-ir-symbol-typed-id
                  (lower-box-field-shared-view data function))
                (BoundsCheck Unit Unit bounds-label)
                (lower-state-current-source-path-id state)
                span)]
            (__tl-project-set-field
              (__tl-box-place data)
              spans
              (box next-spans))
            state)]))))

(define (lower-state-record-latest-bounds-check-at-expr
  [ctx : (& ctx tc_core.TcContext)]
  [state : LowerState]
  [expr : ast.AstExpr]) : LowerState
  (lower-state-record-latest-bounds-check-named-at-expr
    ctx
    state
    "bounds_ok"
    expr))

(define (lower-state-finish-block [state : LowerState] [next-label : i64]) : LowerState
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    [current-label : i64 (lower-box-field-shared-view data current-label)]
    [current-instrs : ir.CompilerIrInstrBuilder
      (lower-box-field-shared-view data current-instrs)]
    (ir.compiler-ir-block-builder-push!
      (&mut (__tl-project-field (__tl-box-place data) blocks))
      (ir.CompilerIrBlock.Block
        current-label
        (ir.compiler-ir-instr-builder-to-seq current-instrs)))
    (__tl-project-set-field (__tl-box-place data) current-label next-label)
    (__tl-project-set-field
      (__tl-box-place data)
      current-instrs
      (ir.compiler-ir-instr-builder-new))
    state))

(define (lower-state-build-blocks [state : LowerState]) : ir.CompilerIrBlockList
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    [current-block : ir.CompilerIrBlock
      (Block
        (lower-box-field-shared-view data current-label)
        (ir.compiler-ir-instr-builder-to-seq
          (lower-box-field-shared-view data current-instrs)))]
    [blocks : ir.CompilerIrBlockBuilder
      (lower-box-field-shared-view data blocks)]
    [next-blocks : ir.CompilerIrBlockBuilder
      (ir.CompilerIrBlockBuilder blocks.slots blocks.len)]
    (ir.compiler-ir-block-builder-push! (&mut next-blocks) current-block)
    (ir.compiler-ir-block-builder-to-list next-blocks)))

(define (lower-state-build-function-blocks [state : LowerState]) : ir.CompilerIrBlockList
  (lower-state-build-blocks state))

(define (lower-state-build-functions-with
  [state : LowerState]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    [functions : ir.CompilerIrFunctionBuilder
      (lower-box-field-shared-view data functions)]
    [out : ir.CompilerIrFunctionBuilder
      (ir.CompilerIrFunctionBuilder functions.slots functions.len)]
    (ir.compiler-ir-function-builder-push! (&mut out) func)
    (ir.compiler-ir-function-builder-to-seq out)))

(define (lower-state-add-functions
  [state : LowerState]
  [new-functions : ir.CompilerIrFunctionSeq]
  [new-spans : ir.CompilerSourceSpans]) : LowerState
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (ir.compiler-ir-function-builder-append-seq!
      (&mut (__tl-project-field (__tl-box-place data) functions))
      new-functions)
    (__tl-project-set-field (__tl-box-place data) spans (box new-spans))
    state))

(define (lower-materialize
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Ok
        (Expr
          (lower-state-emit
            allocated
            (Mov var-id value (lower-global-shared-view ty)))
          (Var var-id)
          ty))]))

(define (lower-materialize-at-expr
  [ctx : (& ctx tc_core.TcContext)]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (let
        [instr : ir.CompilerIrInstr
          (Mov var-id value (lower-global-shared-view ty))]
        (Ok
          (Expr
            (lower-state-emit-at-expr ctx allocated instr expr)
            (Var var-id)
            ty)))]))

(define (lower-float-literal-bits [text : String] [ty : ast.AstType]) : u64
  (match ty
    [(F32)
      (match (cfloat.compiler-float-parse-f32-bits text)
        [(CompilerFloatSomeBits bits) bits]
        [(CompilerFloatNoBits) (cast 0 : u64)])]
    [_
      (match (cfloat.compiler-float-parse-f64-bits text)
        [(CompilerFloatSomeBits bits) bits]
        [(CompilerFloatNoBits) (cast 0 : u64)])]))

(define (lower-literal-value-with-type
  [source-names : ci.InternSourceNameSessionHandle]
  [lit : ast.AstLiteral]
  [ty : ast.AstType]) : ir.CompilerIrValue
  (match lit
    [(Int n text) (I64 (ast.ast-int-literal-value-or-payload n text))]
    [(Float n) (F64 (lower-float-literal-bits n ty))]
    [(Bool b) (Bool b)]
    [(Char c) (Char c)]
    [(String string-id)
      (String (ci.intern-source-name-session-handle-str source-names string-id))]
    [(Unit) Unit]))

(define (lower-binop [op : ast.AstBinOp] [rhs-ty : ast.AstType]) : ir.CompilerIrBinOp
  (match op
    [(Add) Add]
    [(Sub) Sub]
    [(Mul) Mul]
    [(Div) Div]
    [(Mod) Mod]
    [(Eq) Eq]
    [(Ne) Ne]
    [(Lt) Lt]
    [(Le) Le]
    [(Gt) Gt]
    [(Ge) Ge]
    [(And) And]
    [(Or) Or]
    [(BitAnd) BitAnd]
    [(BitOr) BitOr]
    [(BitXor) BitXor]
    [(Shl) (Shl rhs-ty)]
    [(Shr) (Shr rhs-ty)]))

(define (lower-unop [op : ast.AstUnOp]) : ir.CompilerIrUnOp
  (match op
    [(Neg) Neg]
    [(Not) Not]
    [(BitNot) BitNot]))

(define (lower-align-up [n : i64] [align : i64]) : i64
  (if (<= align 1)
    n
    (* (/ (+ n (- align 1)) align) align)))

(define (lower-inline-layout-size-or
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [fallback : i64]) : i64
  ;; Compile-time: a bare struct/enum size is memoized by stable
  ;; interned type-name id
  ;; (its size is stable; this is the hot type-size query in lowering). Generic
  ;; ...Args / tuples / arrays depend on type arguments, so keep the uncached path.
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view ty)))
    [(Struct name) (tc_core.tc-inline-aggregate-size-cached ctx name fallback)]
    [(Enum name) (tc_core.tc-inline-aggregate-size-cached ctx name fallback)]
    [_
      (match (tc_core.tc-inline-aggregate-type-layout ctx ty)
        [(Ok info) (tc_core.tc-layout-info-size info)]
        [(Err _) fallback])]))

(define (lower-inline-layout-align-or
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [fallback : i64]) : i64
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view ty)))
    [(Struct name) (tc_core.tc-inline-aggregate-align-cached ctx name fallback)]
    [(Enum name) (tc_core.tc-inline-aggregate-align-cached ctx name fallback)]
    [_
      (match (tc_core.tc-inline-aggregate-type-layout ctx ty)
        [(Ok info) (tc_core.tc-layout-info-align info)]
        [(Err _) fallback])]))

;; Whether a reference to the type-pool node `inner` is a fat reference
;; (`ast.ast-type-fat-referent?`): a borrowed Slice or `bytes`. Region wrappers
;; on the referent are transparent; owning containers are not looked through.
(define (lower-fat-reference? [ctx : tc_core.TcContext] [inner : i64]) : bool
  (ast.ast-type-fat-referent?
    (tc_core.tc-type-strip-region
      (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx inner)))))

(define (lower-type-size [ctx : tc_core.TcContext] [ty : (& ty ast.AstType)]) : i64
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (match (tc_core.tc-resolve-type ctx (lower-global-shared-view ty))
      [(I64) 8]
      [(U64) 8]
      [(F64) 8]
      [(I32) 4]
      [(U32) 4]
      [(F32) 4]
      [(I16) 2]
      [(U16) 2]
      [(I8) 1]
      [(U8) 1]
      [(Bool) 1]
      [(Char) 1]
      [(Unit) 0]
      [(Never) 0]
      [(Expr) 0]
      [(ExprList) 0]
      [(CFunc _ _) 8]
      [(Func _ _) 8]
      [(Tuple _) (lower-inline-layout-size-or ctx ty 8)]
      [(Array _ _) (lower-inline-layout-size-or ctx ty 8)]
      [(DynArray _) 8]
      [(Slice _) 0]
      [(Box _) 8]
      [(Ptr _) 8]
      [(MutPtr _) 8]
      [(Ref _ inner)
        (if (lower-fat-reference? ctx inner)
          16
          8)]
      [(MutRef _ inner)
        (if (lower-fat-reference? ctx inner)
          16
          8)]
      [(Region _ inner)
        (let
          [ty (tc_core.tc-context-type-get ctx inner)]
          (lower-type-size ctx ty))]
      [(Invalidate _ inner)
        (let
          [ty (tc_core.tc-context-type-get ctx inner)]
          (lower-type-size ctx ty))]
      [(Enum name) (lower-inline-layout-size-or ctx (Enum name) 8)]
      [(EnumArgs name lifetimes)
        (lower-inline-layout-size-or ctx (EnumArgs name lifetimes) 8)]
      [(Struct name) (lower-inline-layout-size-or ctx (Struct name) 8)]
      [(StructArgs name lifetimes)
        (lower-inline-layout-size-or ctx (StructArgs name lifetimes) 8)]
      [(String) 8]
      [(Str) 8]
      [(Bytes) 8]
      [(Var _) 8]
      [(VarArgs _ _) 8])))

;; Snapshot the completed, resolved layouts before the driver retires their
;; typecheck owner as per-nominal type-stable word masks for the optimizer
;; (#8124): bit w is set when word w holds a value of one type whatever value
;; the aggregate holds. Only integer facts escape; the caller's representation
;; arena owns the maps. An enum's payload words are unstable unless it has one
;; variant. Padding, unresolved types, structural containers and oversized
;; aggregates prove nothing. Lifetime arguments do not change layout.
(define (lower-representation-nominal-name [ty : ast.AstType]) : i64
  (match ty
    [(Struct name) name]
    [(StructArgs name _) name]
    [(Enum name) name]
    [(EnumArgs name _) name]
    ;; An enum payload names its type unresolved. A cached layout under the
    ;; name makes it nominal; a type parameter has none and stays unstable.
    [(Var name) name]
    [(VarArgs name _) name]
    [_ -1]))

(define (lower-representation-stable-type-mask
  [type-segment-bases : i64]
  [state : tc_core.TcAggLayoutCacheState]
  [index : (&mut index ir.CompilerIrRepresentationIndex)]
  [ty : ast.AstType]
  [fuel : i64]) : i64
  (let
    [name : i64
      (lower-representation-nominal-name (lower-global-shared-view ty))]
    (cond
      [(<= fuel 0) 0]
      [(>= name 0)
        (lower-representation-stable-nominal-mask
          type-segment-bases
          state
          index
          name
          fuel)]
      [else
        (match (lower-global-shared-view ty)
          [(Region _ inner)
            (lower-representation-stable-type-mask
              type-segment-bases
              state
              index
              (ast.ast-type-segment-bases-get type-segment-bases inner)
              (- fuel 1))]
          [(Invalidate _ inner)
            (lower-representation-stable-type-mask
              type-segment-bases
              state
              index
              (ast.ast-type-segment-bases-get type-segment-bases inner)
              (- fuel 1))]
          [(Ref _ inner)
            (if (ast.ast-type-segment-bases-fat-referent?
              type-segment-bases
              inner)
              3
              1)]
          [(MutRef _ inner)
            (if (ast.ast-type-segment-bases-fat-referent?
              type-segment-bases
              inner)
              3
              1)]
          [(Unit) 0]
          [(Never) 0]
          [(DynArray _) 1]
          [(String) 1]
          [(Str) 1]
          [(Box _) 1]
          [(Ptr _) 1]
          [(MutPtr _) 1]
          [(Func _ _) 1]
          [(CFunc _ _) 1]
          [_
            (if (lower-clone-scalar-type? ty)
              1
              0)])])))

(define (lower-representation-stable-field-mask
  [type-segment-bases : i64]
  [state : tc_core.TcAggLayoutCacheState]
  [index : (&mut index ir.CompilerIrRepresentationIndex)]
  [ty : ast.AstType]
  [offset : i64]
  [fuel : i64]) : i64
  (if (or (< offset 0) (>= offset 512) (not (= (% offset 8) 0)))
    0
    (shl
      (lower-representation-stable-type-mask
        type-segment-bases
        state
        index
        ty
        fuel)
      (/ offset 8))))

(define (lower-representation-stable-layout-mask
  [type-segment-bases : i64]
  [state : tc_core.TcAggLayoutCacheState]
  [index : (&mut index ir.CompilerIrRepresentationIndex)]
  [layout : tc_core.TcInlineAggregateLayout]
  [fuel : i64]) : i64
  (if (or
    (<= fuel 0)
    (>
      (tc_core.tc-inline-aggregate-layout-size
        (lower-global-shared-view layout))
      512))
    0
    (match layout
      [(Struct _ _ fields)
        (let
          [mask : i64 0]
          [at : i64 0]
          (while (< at (tc_core.tc-inline-field-layout-list-count (& fields)))
            (match (tc_core.tc-inline-field-layout-list-ref (& fields) at)
              [(Field _ ty offset)
                (set!
                  mask
                  (bit-or
                    mask
                    (lower-representation-stable-field-mask
                      type-segment-bases
                      state
                      index
                      ty
                      offset
                      (- fuel 1))))])
            (set! at (+ at 1)))
          mask)]
      [(Enum _ _ variants)
        (let
          [mask : i64 1]
          (when
            (= (tc_core.tc-inline-variant-layout-list-count (& variants)) 1)
            (match (tc_core.tc-inline-variant-layout-list-ref (& variants) 0)
              [(Variant _ _ _ payloads)
                (let
                  [at : i64 0]
                  (while (<
                    at
                    (tc_core.tc-inline-payload-layout-list-count (& payloads)))
                    (match (tc_core.tc-inline-payload-layout-list-ref
                      (& payloads)
                      at)
                      [(Payload _ ty offset)
                        (set!
                          mask
                          (bit-or
                            mask
                            (lower-representation-stable-field-mask
                              type-segment-bases
                              state
                              index
                              ty
                              offset
                              (- fuel 1))))])
                    (set! at (+ at 1))))]))
          mask)])))

(define (lower-representation-stable-nominal-mask
  [type-segment-bases : i64]
  [state : tc_core.TcAggLayoutCacheState]
  [index : (&mut index ir.CompilerIrRepresentationIndex)]
  [name : i64]
  [fuel : i64]) : i64
  (let
    [key : i64 (ast.ast-nominal-name-id-key name)]
    (if (ir.compiler-ir-representation-index-stable-mask-known? index key)
      (ir.compiler-ir-representation-index-stable-mask index key)
      (let
        [slots : (__tl_dyn-array tc_core.TcAggLayoutCacheSlot)
          (tc_core.tc-agg-layout-cache-slots state)]
        [slot : i64
          (if (= (array-length slots) tc_core.tc-agg-layout-cache-capacity)
            (tc_core.tc-agg-layout-cache-probe-slot-for-state state name)
            -1)]
        [mask : i64 0]
        ;; Publish no proof while recursively visiting this nominal identity.
        (ir.compiler-ir-representation-index-set-stable-mask! index key 0)
        (when
          (and (> fuel 0) (>= slot 0))
          (match (owned_view.compiler-owned-array-element-shared-view
            slots
            slot)
            [(Full _ layout)
              (set!
                mask
                (lower-representation-stable-layout-mask
                  type-segment-bases
                  state
                  index
                  layout
                  fuel))]
            [(Empty) unit]))
        (ir.compiler-ir-representation-index-set-stable-mask! index key mask)
        mask))))

(define (lower-representation-index-stable-words
  [type-segment-bases : i64]
  [job : tc_core.TcJobState]
  [index : ir.CompilerIrRepresentationIndex]) : ir.CompilerIrRepresentationIndex
  (let
    [address : i64 (tc_core.tc-job-state-agg-layout-cache-address job)]
    (when
      (> address 0)
      (let
        [state : tc_core.TcAggLayoutCacheState
          (tc_core.TcAggLayoutCacheState address)]
        [slots : (__tl_dyn-array tc_core.TcAggLayoutCacheSlot)
          (tc_core.tc-agg-layout-cache-slots state)]
        [at : i64 0]
        (while (< at (array-length slots))
          (match (owned_view.compiler-owned-array-element-shared-view slots at)
            [(Full name _)
              (lower-representation-stable-nominal-mask
                type-segment-bases
                state
                (&mut index)
                name
                64)
              unit]
            [(Empty) unit])
          (set! at (+ at 1)))))
    index))

(define (lower-type-align [ctx : tc_core.TcContext] [ty : (& ty ast.AstType)]) : i64
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (match (tc_core.tc-resolve-type ctx (lower-global-shared-view ty))
      [(I64) 8]
      [(U64) 8]
      [(F64) 8]
      [(I32) 4]
      [(U32) 4]
      [(F32) 4]
      [(I16) 2]
      [(U16) 2]
      [(I8) 1]
      [(U8) 1]
      [(Bool) 1]
      [(Char) 1]
      [(Unit) 1]
      [(Never) 1]
      [(Expr) 1]
      [(ExprList) 1]
      [(CFunc _ _) 8]
      [(Func _ _) 8]
      [(Tuple _) (lower-inline-layout-align-or ctx ty 8)]
      [(Array _ _) (lower-inline-layout-align-or ctx ty 8)]
      [(DynArray _) 8]
      [(Slice _) 0]
      [(Box _) 8]
      [(Ptr _) 8]
      [(MutPtr _) 8]
      [(Ref _ _) 8]
      [(MutRef _ _) 8]
      [(Region _ inner)
        (let
          [ty (tc_core.tc-context-type-get ctx inner)]
          (lower-type-align ctx ty))]
      [(Invalidate _ inner)
        (let
          [ty (tc_core.tc-context-type-get ctx inner)]
          (lower-type-align ctx ty))]
      [(Enum name) (lower-inline-layout-align-or ctx (Enum name) 8)]
      [(EnumArgs name lifetimes)
        (lower-inline-layout-align-or ctx (EnumArgs name lifetimes) 8)]
      [(Struct name) (lower-inline-layout-align-or ctx (Struct name) 8)]
      [(StructArgs name lifetimes)
        (lower-inline-layout-align-or ctx (StructArgs name lifetimes) 8)]
      [(String) 8]
      [(Str) 8]
      [(Bytes) 8]
      [(Var _) 8]
      [(VarArgs _ _) 8])))

(define (lower-type-list-extent
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]
  [cursor : i64]) : i64
  (lower-type-list-extent-at ctx (& types) cursor 0))

(define (lower-type-list-extent-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [cursor : i64]
  [index : i64]) : i64
  (if (>= index (ast.ast-type-list-len types))
    cursor
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      (lower-type-list-extent-at
        ctx
        types
        (+ offset (lower-type-size ctx resolved))
        (+ index 1)))))

(define (lower-type-list-storage-size
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : i64
  (let
    [extent : i64 (lower-type-list-extent ctx types 0)]
    (lower-align-up
      (if (= extent 0)
        1
        extent)
      8)))

(define (lower-variant-fields-storage-size
  [ctx : tc_core.TcContext]
  [fields : ast.AstTypeList]) : i64
  (lower-align-up (lower-type-list-extent ctx fields 8) 8))

(define (lower-variant-storage-size
  [ctx : tc_core.TcContext]
  [variant : ast.AstVariantDef]) : i64
  (match variant
    [(Def _ fields _) (lower-variant-fields-storage-size ctx fields)]))

(define (lower-nullary-variant-object-symbol
  [intern-state : ci.InternCompatState]
  [enum-name-id : i64]
  [variant-name-id : i64]) : i64
  (let
    [owned-intern-state : ci.InternCompatState intern-state]
    [components : i64
      (ci.intern-compat-state-composite-pair-id
        (&mut owned-intern-state)
        enum-name-id
        variant-name-id)]
    (ci.intern-compat-state-generated-role-symbol-id
      (&mut owned-intern-state)
      (ci.intern-generated-symbol-role-nullary-enum-object)
      components)))

(define (lower-nullary-variant-globals
  [intern-state : ci.InternCompatState]
  [enum-name-id : i64]
  [enum-name : String]
  [variants : (& variants ast.AstVariantDefList)]
  [tag : i64]
  [globals : (&mut globals ir.CompilerIrGlobalBuilder)]) : unit
  (if (>= tag variants.len)
    unit
    (match (ast.ast-variant-def-list-get
      (& variants)
      tag
      (ast.ast-variant-def-fallback))
      [(Def variant-name fields _)
        (when
          (ast.ast-type-list-empty? (& fields))
          (let
            [object-name : i64
              (lower-nullary-variant-object-symbol
                (lower-global-shared-view intern-state)
                enum-name-id
                variant-name)]
            (ir.compiler-ir-global-builder-push!
              globals
              (ir.CompilerIrGlobal.Global object-name (I64) (I64 tag)))))
        (lower-nullary-variant-globals
          intern-state
          enum-name-id
          enum-name
          variants
          (+ tag 1)
          globals)])))

(define (lower-enum-variants-storage-size
  [ctx : tc_core.TcContext]
  [variants : ast.AstVariantDefList]
  [max-size : i64]) : i64
  (lower-enum-variants-storage-size-at ctx (& variants) max-size 0))

(define (lower-enum-variants-storage-size-at
  [ctx : tc_core.TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [max-size : i64]
  [index : i64]) : i64
  (if (>= index variants.len)
    max-size
    (let
      [size : i64
        (lower-variant-storage-size
          ctx
          (ast.ast-variant-def-list-get
            variants
            index
            (ast.ast-variant-def-fallback)))]
      (lower-enum-variants-storage-size-at
        ctx
        variants
        (if (> size max-size)
          size
          max-size)
        (+ index 1)))))

(define (lower-enum-storage-size
  [ctx : tc_core.TcContext]
  [enum-name-id : i64]
  [enum-name : String]) : i64
  (match (tc_core.tc-context-enum-variants-id ctx enum-name-id enum-name)
    [(Ok variants) (lower-enum-variants-storage-size ctx variants 8)]
    [(Err _) 8]))

(define (lower-struct-fields-at-handle
  [ctx : tc_core.TcContext]
  [handle : i64]
  [struct-name : String]) : parser.ResultAstFieldDefList
  (if (and
    (csym.compiler-symbols-handle-found? handle)
    (=
      (csym.compiler-symbol-handle-kind handle)
      (csym.compiler-symbol-kind-defstruct)))
    (let
      [decl : ast.AstDecl
        (try
          (csym.compiler-symbols-decl-at-index
            (tc_core.tc-context-symbols ctx)
            (csym.compiler-symbol-handle-index handle)))]
      (match decl
        [(DefStruct decl-meta _ _ _ fields) (Ok fields)]
        [(DefStructLifetimes decl-meta _ _ _ _ fields) (Ok fields)]
        [_ (Err "lower: struct symbol owner is not a struct")]))
    (Err (str_cat.str-cat "lower: unknown struct " struct-name))))

(define (lower-struct-fields-id
  [ctx : tc_core.TcContext]
  [struct-id : i64]
  [struct-name : String]) : parser.ResultAstFieldDefList
  (lower-struct-fields-at-handle
    ctx
    (csym.compiler-symbols-lookup-type-id-or
      (tc_core.tc-context-symbols ctx)
      struct-id
      (csym.compiler-symbols-missing-handle))
    struct-name))

(define (lower-struct-repr-c-id? [ctx : tc_core.TcContext] [struct-id : i64]) : bool
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc_core.tc-context-symbols ctx)
        struct-id
        (csym.compiler-symbols-missing-handle))]
    (if (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-defstruct)))
      (match (csym.compiler-symbols-decl-at-index
        (tc_core.tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle))
        [(Ok decl)
          (match decl
            [(DefStruct decl-meta _ repr _ _) (ast.ast-struct-repr-c? repr)]
            [(DefStructLifetimes decl-meta _ _ repr _ _)
              (ast.ast-struct-repr-c? repr)]
            [_ false])]
        [(Err _) false])
      false)))

(define (lower-repr-c-inline-field?
  [ctx : tc_core.TcContext]
  [field-ty : ast.AstType]) : bool
  (match (tc_core.tc-resolve-type ctx field-ty)
    [(Struct nested) (lower-struct-repr-c-id? ctx nested)]
    [_ false]))

(define (lower-reserve-heap-storage
  [state : LowerState]
  [size : i64]
  [ty : (& ty ast.AstType)]) : LowerExpr
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (match (lower-state-alloc-var state)
      [(Alloc allocated var-id)
        (Expr
          (lower-state-emit
            allocated
            (Call
              var-id
              (lower-tl-alloc-symbol)
              (One (I64 size))
              (lower-global-shared-view ty)))
          (Var var-id)
          ty)])))

(define (lower-inline-storage-slot-count [size : i64]) : i64
  (if (<= size 8)
    1
    (/ (+ size 7) 8)))

(define (lower-reserve-inline-slot-vars
  [state : LowerState]
  [slots : i64]
  [ty : ast.AstType]) : LowerInlineStorage
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (let
        [next-state : LowerState
          (lower-state-emit
            allocated
            (Alloc var-id (lower-global-shared-view ty)))]
        (if (<= slots 1)
          (Storage next-state var-id)
          (lower-reserve-inline-slot-vars next-state (- slots 1) ty)))]))

(define (lower-reserve-inline-storage
  [state : LowerState]
  [size : i64]
  [ty : (& ty ast.AstType)]) : LowerExpr
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (match (lower-reserve-inline-slot-vars
      state
      (lower-inline-storage-slot-count size)
      (lower-global-shared-view ty))
      [(Storage storage-state storage-var)
        (match (lower-state-alloc-var storage-state)
          [(Alloc addr-alloc addr-var)
            (Expr
              (lower-state-emit addr-alloc (AddrOf addr-var storage-var))
              (Var addr-var)
              ty)])])))

(define (lower-gep-byte
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]) : LowerExpr
  (match (lower-emit-gep state base (I64 offset) (U8))
    [(Expr gep-state ptr _) (Expr gep-state ptr (U64))]))

(define (lower-store-at-offset
  [state : LowerState]
  [base : (& base ir.CompilerIrValue)]
  [offset : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerState
  (let
    [base : ir.CompilerIrValue
      (owned_view.compiler-owned-reference-shared-view base)]
    (match (lower-gep-byte state base offset)
      [(Expr ptr-state ptr _)
        (lower-state-emit ptr-state (StorePtr ptr value ty))])))

;; A checked TypeLisp move into an owned aggregate place. StoreOwned is the
;; actual typed store and the explicit ownership-transfer proof. Unsafe/raw
;; writes use StorePtr and cannot manufacture an edge from payload type alone.
(define (lower-store-owned-at-offset
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerState
  (match (lower-gep-byte state base offset)
    [(Expr ptr-state ptr _)
      (lower-state-emit ptr-state (StoreOwned ptr value ty))]))

(define (lower-store-checked-value-at-offset
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [size : i64]) : LowerState
  (if (lower-owned-handle-type? ctx (lower-global-shared-view ty))
    (lower-store-owned-at-offset state base offset value ty)
    (lower-store-inline-value-at-offset ctx state base offset value ty size)))

(define (lower-load-at-offset
  [state : LowerState]
  [base : (& base ir.CompilerIrValue)]
  [offset : i64]
  [ty : ast.AstType]) : LowerExpr
  (let
    [base : ir.CompilerIrValue
      (owned_view.compiler-owned-reference-shared-view base)]
    (match (lower-gep-byte state base offset)
      [(Expr ptr-state ptr _)
        (match (lower-state-alloc-var ptr-state)
          [(Alloc allocated var-id)
            (Expr
              (lower-state-emit
                allocated
                (Load var-id ptr (lower-global-shared-view ty)))
              (Var var-id)
              ty)])])))

(define (lower-copy-chunk-size [remaining : i64]) : i64
  (cond [(>= remaining 8) 8] [(>= remaining 4) 4] [(>= remaining 2) 2] [else 1]))

(define (lower-copy-chunk-type [chunk : i64]) : ast.AstType
  (cond [(= chunk 8) (U64)] [(= chunk 4) (U32)] [(= chunk 2) (U16)] [else (U8)]))

;; The byte address `base + offset` as an IR value (the base itself when
;; offset is 0, avoiding a no-op gep).
(define (lower-offset-addr
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]) : LowerExpr
  (if (= offset 0)
    (Expr state base (U64))
    (lower-gep-byte state base offset)))

;; Inline the hottest by-value aggregate copies. Copies in the 17-128 B band,
;; especially AstTypeList/AstType, ResultTcType/ResultTcType.Ok, and
;; CompilerIrInstr copies, are dynamically dominant, and a `tl_memcpy` CALL
;; costs far more than such a copy. Inline they lower to
;; at most eleven 16-byte XMM or scalar-tail load+store pairs.
;; Capping the expansion by that
;; operation count, as production compiler memcpy lowering does, admits the hot
;; 120-176 B band while still routing genuinely large copies through tl_memcpy
;; so the emitted code does not blow up. Must stay a multiple of 8 so the inline
;; chunk loop (lower-copy-chunk-size: 8/4/2/1) terminates cleanly for any size.
(define lower-inline-copy-threshold : i64
  176)

;; Copy `size` bytes dst<-src via a single tl_memcpy runtime call instead
;; of `size/8` separate gep+load+gep+store chunks. Chunked, a large by-value
;; aggregate copy (set!, pass/return, clone of a >16 B struct) is a long run of
;; word copies (`movq ...,%r10 ; movq off(%r10),%rax ; movq %rax,SLOT`); one
;; call collapses each run to a few
;; instructions. tl_memcpy takes (dst, src, len) and is emitted unconditionally in
;; the runtime. Only used for copies large enough that the call beats the inline
;; chunks (see lower-copy-bytes threshold).
(define (lower-emit-memcpy
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [dst-offset : i64]
  [src : ir.CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (match (lower-offset-addr state dst dst-offset)
    [(Expr dst-state dst-addr _)
      (match (lower-offset-addr dst-state src src-offset)
        [(Expr src-state src-addr _)
          (match (lower-state-alloc-var src-state)
            [(Alloc call-state call-var)
              (lower-state-emit
                call-state
                (Call
                  call-var
                  (lower-derived-symbol-id "tl_memcpy")
                  (ir.compiler-ir-call-args-from-seq
                    (ir.compiler-ir-value-seq3 dst-addr src-addr (I64 size)))
                  (Unit)))])])]))

(define (lower-emit-memcpy-value
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [dst-offset : i64]
  [src : ir.CompilerIrValue]
  [src-offset : i64]
  [size : ir.CompilerIrValue]) : LowerState
  (match (lower-offset-addr state dst dst-offset)
    [(Expr dst-state dst-addr _)
      (match (lower-offset-addr dst-state src src-offset)
        [(Expr src-state src-addr _)
          (match (lower-state-alloc-var src-state)
            [(Alloc call-state call-var)
              (lower-state-emit
                call-state
                (Call
                  call-var
                  (lower-derived-symbol-id "tl_memcpy")
                  (ir.compiler-ir-call-args-from-seq
                    (ir.compiler-ir-value-seq3 dst-addr src-addr size))
                  (Unit)))])])]))

(define (lower-copy-bytes
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [dst-offset : i64]
  [src : ir.CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (cond
    [(<= size 0) state]
    [(> size lower-inline-copy-threshold)
      (lower-emit-memcpy state dst dst-offset src src-offset size)]
    [(>= size 16)
      (match (lower-offset-addr state dst dst-offset)
        [(Expr dst-state dst-addr _)
          (match (lower-offset-addr dst-state src src-offset)
            [(Expr src-state src-addr _)
              (lower-state-emit src-state (CopyBytes dst-addr src-addr size))])])]
    [else
      (let
        [chunk : i64 (lower-copy-chunk-size size)]
        [chunk-ty : ast.AstType (lower-copy-chunk-type chunk)]
        (match (lower-load-at-offset
          state
          src
          src-offset
          (lower-global-shared-view chunk-ty))
          [(Expr loaded value _)
            (lower-copy-bytes
              (lower-store-at-offset loaded dst dst-offset value chunk-ty)
              dst
              (+ dst-offset chunk)
              src
              (+ src-offset chunk)
              (- size chunk))]))]))

;; A value is stored FULL-INLINE (its own bytes, addressed by a pointer) when it
;; is a memory aggregate: a struct/enum, tuple, or fixed array. Boxes,
;; dyn-arrays, strings, closures, and scalars keep their existing register-width
;; slot semantics and use scalar load/store rather than byte-copy or
;; pointer-return. Tuples remain address-shaped in expressions, but their
;; nested representation is the tuple bytes rather than a pointer slot.
;; This is the precise gate for choosing inline byte-copy / pointer-return vs.
;; scalar load/store, distinct from the broad lower-type-contains-inline-
;; aggregate? (which is used for the conservative tail-call risk check).
(define (lower-type-inline-storage?
  [ctx : tc_core.TcContext]
  [ty : (& ty ast.AstType)]) : bool
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
      [(Struct _) true]
      [(StructArgs _ _) true]
      [(Enum _) true]
      [(EnumArgs _ _) true]
      [(Tuple _) true]
      [(Array _ _) true]
      [_ false])))

(define (lower-type-inline-struct-or-enum?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(Struct _) true]
    [(StructArgs _ _) true]
    [(Enum _) true]
    [(EnumArgs _ _) true]
    [_ false]))

;; A register-resident aggregate is an inline struct/enum that fits in a
;; single 8-byte word and is built only of word-class fields. Such a value is
;; carried through the IR as the packed word itself (an i64-shaped SSA value)
;; rather than a pointer to a stack slot: construction packs the fields with
;; shift/or, `struct-get`/`match` extract them with shift/mask, and the value is
;; passed/returned/cloned exactly like a scalar - never touching memory.
;; AstType.StructArgs/AstType.EnumArgs here are lifetime-arg forms; they share
;; the same layout and representation as the bare declaration.
(define (lower-type-register-resident?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(Ref _ inner) (lower-fat-reference? ctx inner)]
    [(MutRef _ inner) (lower-fat-reference? ctx inner)]
    [(Struct name) (> (tc_core.tc-inline-aggregate-regwords-cached ctx name) 0)]
    [(StructArgs name _)
      (> (tc_core.tc-inline-aggregate-regwords-cached ctx name) 0)]
    [(Enum name) (> (tc_core.tc-inline-aggregate-regwords-cached ctx name) 0)]
    [(EnumArgs name _)
      (> (tc_core.tc-inline-aggregate-regwords-cached ctx name) 0)]
    [_ false]))

;; Number of machine words a register-resident aggregate occupies
;; (ceil(size/8)). 1 word => carried as a single scalar value; 2
;; words => carried as a register-group value built with CompilerIrInstr.Pack and read
;; with CompilerIrInstr.Word. Only meaningful when
;; `lower-type-register-resident?` holds.
;; True for a register-resident aggregate that needs the multi-word
;; register-group representation (2+ words) rather than the single-word scalar
;; representation. Drives the CompilerIrInstr.Pack/CompilerIrInstr.Word lowering paths.
(define (lower-type-register-group?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (> (lower-type-register-words ctx ty) 1))

;; Register-residency in ONE inline-layout build, vs the THREE transient
;; layout rebuilds of calling register-resident? + register-group? (which itself
;; rebuilds for resident? and for the size) separately. Returns the machine-word
;; count (1 or 2) of a register-resident aggregate, else 0. Used on the hot match
;; path, where excess rebuilds would overflow the per-function scratch arena
;; into a second chunk whose rewind leaks into later lowering.
(define (lower-type-register-words [ctx : tc_core.TcContext] [ty : ast.AstType]) : i64
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(Ref _ inner)
      (if (lower-fat-reference? ctx inner)
        2
        0)]
    [(MutRef _ inner)
      (if (lower-fat-reference? ctx inner)
        2
        0)]
    [(Struct name) (tc_core.tc-inline-aggregate-regwords-cached ctx name)]
    [(StructArgs name _) (tc_core.tc-inline-aggregate-regwords-cached ctx name)]
    [(Enum name) (tc_core.tc-inline-aggregate-regwords-cached ctx name)]
    [(EnumArgs name _) (tc_core.tc-inline-aggregate-regwords-cached ctx name)]
    [_ 0]))

(define (lower-f64-register-word-field?
  [field-ty : ast.AstType]
  [offset : i64]
  [word-index : i64]) : bool
  (match (tc_core.tc-type-strip-region field-ty)
    [(F64) (and (= (/ offset 8) word-index) (= (% offset 8) 0))]
    [_ false]))

(define (lower-sse-register-word-field?
  [field-ty : ast.AstType]
  [offset : i64]
  [word-index : i64]) : bool
  (match (tc_core.tc-type-strip-region field-ty)
    [(F64) (and (= (/ offset 8) word-index) (= (% offset 8) 0))]
    [(F32) (and (= (/ offset 8) word-index) (= (% offset 4) 0))]
    [_ false]))

(define (lower-register-word-type-merge
  [current : ast.AstType]
  [field-ty : ast.AstType]
  [offset : i64]
  [word-index : i64]) : ast.AstType
  (if (lower-sse-register-word-field? field-ty offset word-index)
    (F64)
    current))

(define (lower-register-struct-word-type-fields
  [fields : tc_core.TcInlineFieldLayoutList]
  [word-index : i64]
  [current : ast.AstType]) : ast.AstType
  (lower-register-struct-word-type-fields-at fields word-index current 0))

(define (lower-register-struct-word-type-fields-at
  [fields : tc_core.TcInlineFieldLayoutList]
  [word-index : i64]
  [current : ast.AstType]
  [index : i64]) : ast.AstType
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    current
    (let
      [field : tc_core.TcInlineFieldLayout
        (tc_core.tc-inline-field-layout-list-ref fields index)]
      (lower-register-struct-word-type-fields-at
        fields
        word-index
        (lower-register-word-type-merge
          current
          (tc_core.tc-inline-field-layout-type (lower-global-shared-view field))
          (tc_core.tc-inline-field-layout-offset field)
          word-index)
        (+ index 1)))))

(define (lower-register-payload-word-type-fields
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [word-index : i64]
  [current : ast.AstType]) : ast.AstType
  (lower-register-payload-word-type-fields-at payloads word-index current 0))

(define (lower-register-payload-word-type-fields-at
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [word-index : i64]
  [current : ast.AstType]
  [index : i64]) : ast.AstType
  (if (>= index (tc_core.tc-inline-payload-layout-list-count payloads))
    current
    (let
      [payload : tc_core.TcInlinePayloadLayout
        (tc_core.tc-inline-payload-layout-list-ref payloads index)]
      (lower-register-payload-word-type-fields-at
        payloads
        word-index
        (lower-register-word-type-merge
          current
          (tc_core.tc-inline-payload-layout-type
            (lower-global-shared-view payload))
          (tc_core.tc-inline-payload-layout-offset payload)
          word-index)
        (+ index 1)))))

(define (lower-register-enum-word-type-variants
  [variants : tc_core.TcInlineVariantLayoutList]
  [word-index : i64]
  [current : ast.AstType]) : ast.AstType
  (lower-register-enum-word-type-variants-at variants word-index current 0))

(define (lower-register-enum-word-type-variants-at
  [variants : tc_core.TcInlineVariantLayoutList]
  [word-index : i64]
  [current : ast.AstType]
  [index : i64]) : ast.AstType
  (if (>= index (tc_core.tc-inline-variant-layout-list-count variants))
    current
    (match (tc_core.tc-inline-variant-layout-list-ref variants index)
      [(Variant _ _ _ payloads)
        (lower-register-enum-word-type-variants-at
          variants
          word-index
          (lower-register-payload-word-type-fields payloads word-index current)
          (+ index 1))])))

;; Register-resident aggregate word type for lowering/backend movement. INTEGER
;; words are represented as i64 bit words; SSE eightbytes are represented by f64
;; values, including homogeneous packed f32 words carried opaquely in XMM regs.
(define (lower-register-word-type
  [ctx : tc_core.TcContext]
  [ty : (& ty ast.AstType)]
  [word-index : i64]) : ast.AstType
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
      [(Ref _ inner)
        (if (lower-fat-reference? ctx inner)
          (if (= word-index 0)
            (U64)
            (I64))
          (I64))]
      [(MutRef _ inner)
        (if (lower-fat-reference? ctx inner)
          (if (= word-index 0)
            (U64)
            (I64))
          (I64))]
      [(Struct name)
        (match (tc_core.tc-inline-aggregate-layout-for-id ctx name)
          [(Ok layout)
            (match layout
              [(Struct _ _ fields)
                (lower-register-struct-word-type-fields fields word-index (I64))]
              [(Enum _ _ _) (I64)])]
          [(Err _) (I64)])]
      [(StructArgs name _)
        (let
          [ty (ast.AstType.Struct name)]
          (lower-register-word-type ctx ty word-index))]
      [(Enum name)
        (if (= word-index 0)
          (I64)
          (match (tc_core.tc-inline-aggregate-layout-for-id ctx name)
            [(Ok layout)
              (match layout
                [(Enum _ _ variants)
                  (lower-register-enum-word-type-variants
                    variants
                    word-index
                    (I64))]
                [(Struct _ _ _) (I64)])]
            [(Err _) (I64)]))]
      [(EnumArgs name _)
        (let
          [ty (ast.AstType.Enum name)]
          (lower-register-word-type ctx ty word-index))]
      [_ (I64)])))

(define (lower-one-word-register-storage-type
  [ctx : tc_core.TcContext]
  [ty : (& ty ast.AstType)]) : ast.AstType
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match (& resolved)
      [(Array _ _) (U64)]
      [_
        (if (and
          (lower-type-register-resident?
            ctx
            (lower-global-shared-view resolved))
          (not
            (lower-type-register-group? ctx (lower-global-shared-view resolved))))
          (let
            [word-ty : ast.AstType (lower-register-word-type ctx resolved 0)]
            (match (tc_core.tc-type-strip-region
              (lower-global-shared-view word-ty))
              [(F64) word-ty]
              [_ resolved]))
          resolved)])))

(define (lower-type-signed? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(I64) true]
    [(I32) true]
    [(I16) true]
    [(I8) true]
    [_ false]))

;; Low `size` bytes set to 1 (e.g. size 4 -> 0xffffffff). Used to mask a field
;; to its width before OR-ing it into a packed word. size >= 8 is handled by the
;; callers (no mask needed for a full word).
(define (lower-low-bits-mask [size : i64]) : i64
  (cond
    [(>= size 8) -1]
    [(= size 1) 255]
    [(= size 2) 65535]
    [(= size 3) 16777215]
    [(= size 4) 4294967295]
    [(= size 5) 1099511627775]
    [(= size 6) 281474976710655]
    [(= size 7) 72057594037927935]
    [else -1]))

;; Extract a word-class field from the packed word of a register-resident
;; aggregate. The field occupies bytes [byte-offset, byte-offset+size) of the
;; word; a left shift drops the bytes above it, then a 64-bit arithmetic (signed)
;; or logical (unsigned) right shift moves it to the low bits with the same
;; sign/zero extension a typed memory load would produce.
(define (lower-extract-word-field
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [word : ir.CompilerIrValue]
  [word-ty : ast.AstType]
  [byte-offset : i64]
  [field-ty : ast.AstType]) : LowerExpr
  (let
    [size : i64 (lower-type-size ctx field-ty)]
    (if (>= size 8)
      (Expr state word field-ty)
      (let
        [bits : LowerExpr
          (match (tc_core.tc-type-strip-region
            (lower-global-shared-view field-ty))
            [(F32) (lower-bitcast-value state word word-ty (U64))]
            [_ (Expr state word (U64))])]
        [left : i64 (- 64 (* (+ byte-offset size) 8))]
        [right : i64 (- 64 (* size 8))]
        (match bits
          [(Expr bits-state bits-value _)
            (let
              [shifted : LowerExpr
                (if (> left 0)
                  (lower-emit-binop
                    bits-state
                    (Shl (I64))
                    bits-value
                    (I64 left)
                    (I64))
                  (Expr bits-state bits-value (I64)))]
              (match shifted
                [(Expr shl-state shl-value _)
                  (match (lower-emit-binop
                    shl-state
                    (Shr (I64))
                    shl-value
                    (I64 right)
                    (if (lower-type-signed? (lower-global-shared-view field-ty))
                      (I64)
                      (U64)))
                    [(Expr shr-state shr-value _)
                      (match (tc_core.tc-type-strip-region
                        (lower-global-shared-view field-ty))
                        [(F32)
                          (lower-bitcast-value shr-state shr-value (U64) (F32))]
                        [_ (Expr shr-state shr-value field-ty)])])]))])))))

;; OR one field value into the packed-word accumulator: mask it to its byte
;; width (so a sign-extended source cannot bleed into neighbouring fields), shift
;; it to its byte offset, and OR it into `acc`.
(define (lower-pack-word-field
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [byte-offset : i64]
  [field-ty : ast.AstType]) : LowerExpr
  (let
    [size : i64 (lower-type-size ctx field-ty)]
    (if (and
      (>= size 8)
      (lower-f64-register-word-field?
        (lower-global-shared-view field-ty)
        byte-offset
        0))
      (Expr state value field-ty)
      (let
        [bits : LowerExpr
          (match (tc_core.tc-type-strip-region
            (lower-global-shared-view field-ty))
            [(F32) (lower-bitcast-value state value field-ty (U64))]
            [_ (Expr state value field-ty)])]
        (match bits
          [(Expr bits-state bits-value _)
            (let
              [masked : LowerExpr
                (if (>= size 8)
                  (Expr bits-state bits-value (U64))
                  (lower-emit-binop
                    bits-state
                    BitAnd
                    bits-value
                    (I64 (lower-low-bits-mask size))
                    (U64)))]
              (match masked
                [(Expr mask-state mask-value _)
                  (let
                    [shifted : LowerExpr
                      (if (> byte-offset 0)
                        (lower-emit-binop
                          mask-state
                          (Shl (I64))
                          mask-value
                          (I64 (* byte-offset 8))
                          (I64))
                        (Expr mask-state mask-value (U64)))]
                    (match shifted
                      [(Expr shift-state shift-value _)
                        (lower-emit-binop
                          shift-state
                          BitOr
                          acc
                          shift-value
                          (U64))]))]))])))))

;; Build the packed word for a register-resident struct by folding each field
;; (masked + shifted) into a zero accumulator, in declaration order.
(define (lower-pack-inline-struct-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [values : ir.CompilerIrValueSeq]
  [fields : ast.AstFieldDefList]
  [layout : tc_core.TcInlineAggregateLayout]) : ResultLowerExpr
  (lower-pack-inline-struct-values-at
    ctx
    state
    acc
    acc-ty
    values
    (& fields)
    0
    layout))

(define (lower-pack-inline-struct-values-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [values : ir.CompilerIrValueSeq]
  [fields : (& fields ast.AstFieldDefList)]
  [field-index : i64]
  [layout : tc_core.TcInlineAggregateLayout]) : ResultLowerExpr
  (if (>= field-index values.len)
    (if (>= field-index fields.len)
      (Ok (Expr state acc acc-ty))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= field-index fields.len)
      (Err (box (lower-diagnostic "lower: constructor arity mismatch")))
      (match (ast.ast-field-def-list-get
        fields
        field-index
        (ast.ast-field-def-fallback))
        [(Def name ty _)
          (let
            [name-id : i64 (ci.intern-syntax-id-value name)]
            [name-str : String (tc_core.tc-env-key-name-text name-id)]
            [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
            [offset : i64
              (tc_core.tc-inline-aggregate-layout-field-offset-id
                (lower-global-shared-view layout)
                name-id)]
            (if (< offset 0)
              (Err
                (box
                  (lower-diagnostic
                    (str_cat.str-cat
                      "lower: inline struct layout missing field "
                      name-str))))
              (match (lower-pack-word-field
                ctx
                state
                acc
                (ir.compiler-ir-value-seq-ref values field-index)
                offset
                resolved)
                [(Expr packed-state packed-acc packed-ty)
                  (lower-pack-inline-struct-values-at
                    ctx
                    packed-state
                    packed-acc
                    packed-ty
                    values
                    fields
                    (+ field-index 1)
                    layout)])))]))))

;; Emit an CompilerIrInstr.Pack forming a register-group value from its word values.
(define (lower-emit-pack
  [state : LowerState]
  [words : ir.CompilerIrValueSeq]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Expr
        (lower-state-emit
          allocated
          (Pack var-id words (lower-global-shared-view ty)))
        (Var var-id)
        ty)]))

;; Emit an CompilerIrInstr.Word extracting word `index` of a register-group value.
(define (lower-emit-word
  [state : LowerState]
  [group : ir.CompilerIrValue]
  [index : i64]
  [word-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Expr
        (lower-state-emit
          allocated
          (Word var-id group index (lower-global-shared-view word-ty)))
        (Var var-id)
        word-ty)]))

(define (lower-register-word-sse-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(F64) true]
    [_ false]))

(define (lower-materialize-register-word
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [word-ty : ast.AstType]) : LowerExpr
  (if (tc_core.tc-type-eq from-ty (lower-global-shared-view word-ty))
    (Expr state value word-ty)
    (if (lower-register-word-sse-type? (lower-global-shared-view word-ty))
      (lower-bitcast-value state value (U64) word-ty)
      (Expr state value word-ty))))

;; `=` / `!=` on a 2-word register-group aggregate must compare BOTH
;; words; the scalar CompilerIrInstr.BinOp compared only word0, so two enum values with
;; equal tags but different payloads compared equal.
(define (lower-binop-group-eq? [op : ast.AstBinOp]) : bool
  (match op
    [(Eq) true]
    [(Ne) true]
    [_ false]))

(define (lower-group-equality
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [op : ast.AstBinOp]
  [left : ir.CompilerIrValue]
  [right : ir.CompilerIrValue]
  [group-ty : ast.AstType]
  [expr-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-emit-word
    state
    (lower-global-shared-view left)
    0
    (lower-register-word-type ctx group-ty 0))
    [(Expr ls0 l0 _)
      (match (lower-emit-word
        ls0
        left
        1
        (lower-register-word-type ctx group-ty 1))
        [(Expr ls1 l1 _)
          (match (lower-emit-word
            ls1
            (lower-global-shared-view right)
            0
            (lower-register-word-type ctx group-ty 0))
            [(Expr rs0 r0 _)
              (match (lower-emit-word
                rs0
                right
                1
                (lower-register-word-type ctx group-ty 1))
                [(Expr rs1 r1 _)
                  (match (lower-state-alloc-var rs1)
                    [(Alloc alloc0 word0-cmp)
                      (match (lower-state-alloc-var alloc0)
                        [(Alloc alloc1 word1-cmp)
                          (match (lower-state-alloc-var alloc1)
                            [(Alloc alloc2 combined)
                              (Ok
                                (Expr
                                  (lower-state-emit-at-expr
                                    ctx
                                    (lower-state-emit
                                      (lower-state-emit
                                        alloc2
                                        (BinOp
                                          word0-cmp
                                          (lower-binop
                                            op
                                            (lower-register-word-type
                                              ctx
                                              group-ty
                                              0))
                                          l0
                                          r0
                                          (lower-register-word-type
                                            ctx
                                            group-ty
                                            0)))
                                      (BinOp
                                        word1-cmp
                                        (lower-binop
                                          op
                                          (lower-register-word-type
                                            ctx
                                            group-ty
                                            1))
                                        l1
                                        r1
                                        (lower-register-word-type
                                          ctx
                                          group-ty
                                          1)))
                                    (BinOp
                                      combined
                                      ;; eq: both words equal; ne: either differs.
                                      (match op
                                        [(Ne) BitOr]
                                        [_ BitAnd])
                                      (Var word0-cmp)
                                      (Var word1-cmp)
                                      (lower-global-shared-view expr-ty))
                                    origin)
                                  (Var combined)
                                  expr-ty))])])])])])])]))

;; Read a payload field of a register-group enum scrutinee. `base` is the
;; enum group var; the field at enum byte `offset` lives in word `offset/8` (the
;; payload word for a 16-byte enum), extracted with CompilerIrInstr.Word then shift/mask at
;; its relative offset.
(define (lower-read-register-group-payload
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [base-ty : ast.AstType]
  [offset : i64]
  [field-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-word
    state
    base
    (/ offset 8)
    (lower-register-word-type ctx base-ty (/ offset 8)))
    [(Expr w-state w-value _)
      (lower-extract-word-field
        ctx
        w-state
        w-value
        (lower-register-word-type ctx base-ty (/ offset 8))
        (- offset (* (/ offset 8) 8))
        field-ty)]))

;; Store a 2-word register-group `value` to memory at pointer `ptr`
;; (word0 at [ptr], word1 at [ptr+8]) -- used when a group is embedded in a
;; pointer-addressed container (array element, dynarray, box, ...).
(define (lower-store-group-at-ptr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerState
  (match (lower-emit-word
    state
    (lower-global-shared-view value)
    0
    (lower-register-word-type ctx ty 0))
    [(Expr s0 w0 _)
      (match (lower-emit-word s0 value 1 (lower-register-word-type ctx ty 1))
        [(Expr s1 w1 _)
          (match (lower-gep-byte
            (lower-state-emit
              s1
              (StorePtr
                (lower-global-shared-view ptr)
                w0
                (lower-register-word-type ctx ty 0)))
            ptr
            8)
            [(Expr s2 ptr8 _)
              (lower-state-emit
                s2
                (StorePtr ptr8 w1 (lower-register-word-type ctx ty 1)))])])]))

;; Load a 2-word register-group from memory at pointer `ptr` and reassemble
;; it with CompilerIrInstr.Pack (word0 from [ptr], word1 from [ptr+8]).
(define (lower-load-group-from-ptr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-load-at-offset state ptr 0 (lower-register-word-type ctx ty 0))
    [(Expr s0 w0 _)
      (match (lower-load-at-offset s0 ptr 8 (lower-register-word-type ctx ty 1))
        [(Expr s1 w1 _)
          (lower-emit-pack s1 (ir.compiler-ir-value-seq2 w0 w1) ty)])]))

;; Internal descriptor-pair transport. Source String/DynArray values remain
;; one-word pointers; only values built by this helper become structural
;; Pack/Word groups. The pair order matches descriptor storage exactly:
;; data_ptr in word0, nonnegative length in word1.
(define (lower-load-register-resident-from-ptr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (if (lower-type-register-group? ctx (lower-global-shared-view ty))
    (lower-load-group-from-ptr ctx state ptr ty)
    (match (lower-load-at-offset
      state
      ptr
      0
      (lower-register-word-type ctx ty 0))
      [(Expr load-state loaded _) (Expr load-state loaded ty)])))

;; Build the packed value for ONE machine word (`word-index`) of a
;; register-group struct: fold in only the fields that live in that word, each at
;; its offset RELATIVE to the word base, leaving an all-zero accumulator for words
;; with no field. Fields straddling a word boundary cannot occur for word-class
;; fields in a C-layout aggregate (each is naturally aligned within a word).
(define (lower-pack-inline-struct-word
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [values : ir.CompilerIrValueSeq]
  [fields : (& fields ast.AstFieldDefList)]
  [layout : tc_core.TcInlineAggregateLayout]
  [word-index : i64]) : ResultLowerExpr
  (lower-pack-inline-struct-word-at
    ctx
    state
    acc
    acc-ty
    values
    (& fields)
    0
    layout
    word-index))

(define (lower-pack-inline-struct-word-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [values : ir.CompilerIrValueSeq]
  [fields : (& fields ast.AstFieldDefList)]
  [field-index : i64]
  [layout : tc_core.TcInlineAggregateLayout]
  [word-index : i64]) : ResultLowerExpr
  (if (>= field-index values.len)
    (if (>= field-index fields.len)
      (Ok (Expr state acc acc-ty))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= field-index fields.len)
      (Err (box (lower-diagnostic "lower: constructor arity mismatch")))
      (match (ast.ast-field-def-list-get
        fields
        field-index
        (ast.ast-field-def-fallback))
        [(Def name ty _)
          (let
            [name-id : i64 (ci.intern-syntax-id-value name)]
            [name-str : String (tc_core.tc-env-key-name-text name-id)]
            [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
            [offset : i64
              (tc_core.tc-inline-aggregate-layout-field-offset-id
                (lower-global-shared-view layout)
                name-id)]
            (if (< offset 0)
              (Err
                (box
                  (lower-diagnostic
                    (str_cat.str-cat
                      "lower: inline struct layout missing field "
                      name-str))))
              (if (= (/ offset 8) word-index)
                (match (lower-pack-word-field
                  ctx
                  state
                  acc
                  (ir.compiler-ir-value-seq-ref values field-index)
                  (- offset (* word-index 8))
                  resolved)
                  [(Expr packed-state packed-acc packed-ty)
                    (lower-pack-inline-struct-word-at
                      ctx
                      packed-state
                      packed-acc
                      packed-ty
                      values
                      fields
                      (+ field-index 1)
                      layout
                      word-index)])
                (lower-pack-inline-struct-word-at
                  ctx
                  state
                  acc
                  acc-ty
                  values
                  fields
                  (+ field-index 1)
                  layout
                  word-index))))]))))

;; Construct a register-group struct value: pack each machine word and
;; combine them with CompilerIrInstr.Pack. Two-word integer-class structs only.
(define (lower-construct-struct-register-group
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [values : ir.CompilerIrValueSeq]
  [fields : ast.AstFieldDefList]
  [layout : tc_core.TcInlineAggregateLayout]
  [struct-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-pack-inline-struct-word
    ctx
    state
    (I64 0)
    (I64)
    (lower-global-shared-view values)
    fields
    (lower-global-shared-view layout)
    0)
    [(Ok (Expr s0 raw-word0 raw-ty0))
      (match (lower-materialize-register-word
        s0
        raw-word0
        raw-ty0
        (lower-register-word-type ctx struct-ty 0))
        [(Expr w0-state word0 _)
          (match (lower-pack-inline-struct-word
            ctx
            w0-state
            (I64 0)
            (I64)
            values
            fields
            layout
            1)
            [(Ok (Expr s1 raw-word1 raw-ty1))
              (match (lower-materialize-register-word
                s1
                raw-word1
                raw-ty1
                (lower-register-word-type ctx struct-ty 1))
                [(Expr w1-state word1 _)
                  (match (lower-emit-pack
                    w1-state
                    (ir.compiler-ir-value-seq2 word0 word1)
                    (lower-global-shared-view struct-ty))
                    [(Expr ps pv _) (Ok (Expr ps pv struct-ty))])])]
            [(Err message) (Err message)])])]
    [(Err message) (Err message)]))

;; Fold a register-group enum variant's payload values into word1 (the
;; payload word), each field masked + shifted to its offset RELATIVE to the
;; payload word (payload starts at enum byte 8, i.e. relative offset 0).
(define (lower-pack-enum-payload-word
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [cursor : i64]
  [values : ir.CompilerIrValueSeq]
  [fields : ast.AstTypeList]) : ResultLowerExpr
  (lower-pack-enum-payload-word-at
    ctx
    state
    acc
    acc-ty
    cursor
    values
    (& fields)
    0))

(define (lower-pack-enum-payload-word-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [acc : ir.CompilerIrValue]
  [acc-ty : ast.AstType]
  [cursor : i64]
  [values : ir.CompilerIrValueSeq]
  [fields : (& fields ast.AstTypeList)]
  [index : i64]) : ResultLowerExpr
  (if (>= index values.len)
    (Ok (Expr state acc acc-ty))
    (if (>= index (ast.ast-type-list-len fields))
      (Err (box (lower-diagnostic "lower: enum payload arity mismatch")))
      (let
        [ty-id : i64
          (ast.ast-type-list-get fields index (ast.ast-type-id-fallback))]
        [resolved : ast.AstType
          (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx ty-id))]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        (match (lower-pack-word-field
          ctx
          state
          acc
          (ir.compiler-ir-value-seq-ref values index)
          offset
          (lower-global-shared-view resolved))
          [(Expr packed-state packed-acc packed-ty)
            (lower-pack-enum-payload-word-at
              ctx
              packed-state
              packed-acc
              packed-ty
              (+ offset (lower-type-size ctx resolved))
              values
              fields
              (+ index 1))])))))

;; Construct a register-group enum value: word0 = discriminant tag, word1 =
;; the variant's packed (word-class) payload (0 for a nullary variant).
(define (lower-construct-enum-register-group
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [handle : i64]
  [values : ir.CompilerIrValueSeq]
  [fields : ast.AstTypeList]
  [enum-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-pack-enum-payload-word ctx state (I64 0) (I64) 0 values fields)
    [(Ok (Expr s1 raw-word1 raw-ty1))
      (match (lower-materialize-register-word
        s1
        raw-word1
        raw-ty1
        (lower-register-word-type ctx enum-ty 1))
        [(Expr w1-state word1 _)
          (match (lower-emit-pack
            w1-state
            (ir.compiler-ir-value-seq2
              (I64 (csym.compiler-registry-handle-child-index handle))
              word1)
            (lower-global-shared-view enum-ty))
            [(Expr ps pv _) (Ok (Expr ps pv enum-ty))])])]
    [(Err message) (Err message)]))

(define (lower-store-inline-value-at-offset
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : (& base ir.CompilerIrValue)]
  [offset : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [size : i64]) : LowerState
  ;; A register-resident aggregate is carried as a word, so embedding it
  ;; in a memory aggregate is a scalar store of that word, not a byte-copy from a
  ;; pointer. A 2-word register-group stores BOTH words (word0 at offset, word1 at
  ;; offset+8). Only a genuine memory aggregate (inline struct/enum/tuple that
  ;; is not register-resident) needs the byte-copy.
  (let
    [base : ir.CompilerIrValue
      (owned_view.compiler-owned-reference-shared-view base)]
    (if (and
      (lower-type-inline-storage? ctx ty)
      (not (lower-type-register-resident? ctx (lower-global-shared-view ty))))
      (lower-copy-bytes state base offset value 0 size)
      (if (lower-type-register-group? ctx (lower-global-shared-view ty))
        (match (lower-emit-word
          state
          (lower-global-shared-view value)
          0
          (lower-register-word-type ctx ty 0))
          [(Expr s0 w0 _)
            (match (lower-emit-word
              s0
              value
              1
              (lower-register-word-type ctx ty 1))
              [(Expr s1 w1 _)
                (lower-store-at-offset
                  (lower-store-at-offset
                    s1
                    base
                    offset
                    w0
                    (lower-register-word-type ctx ty 0))
                  base
                  (+ offset 8)
                  w1
                  (lower-register-word-type ctx ty 1))])])
        (lower-store-at-offset
          state
          base
          offset
          value
          (if (lower-type-register-resident? ctx (lower-global-shared-view ty))
            (lower-register-word-type ctx ty 0)
            ty))))))

(define (lower-load-inline-value-at-offset
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [ty : ast.AstType]) : LowerExpr
  ;; A register-resident aggregate field is loaded as a word (a scalar
  ;; load), not returned as a pointer into the containing slot. A 2-word
  ;; register-group loads BOTH words and reassembles them with
  ;; CompilerIrInstr.Pack. Only a genuine memory aggregate keeps the
  ;; pointer-return shape.
  (cond
    [(and
        (lower-type-inline-storage? ctx ty)
        (not (lower-type-register-resident? ctx (lower-global-shared-view ty))))
      (match (lower-gep-byte state base offset)
        [(Expr ptr-state ptr _) (Expr ptr-state ptr ty)])]
    [(lower-type-register-group? ctx (lower-global-shared-view ty))
      (match (lower-load-at-offset
        state
        base
        offset
        (lower-register-word-type ctx ty 0))
        [(Expr s0 w0 _)
          (match (lower-load-at-offset
            s0
            base
            (+ offset 8)
            (lower-register-word-type ctx ty 1))
            [(Expr s1 w1 _)
              (lower-emit-pack s1 (ir.compiler-ir-value-seq2 w0 w1) ty)])])]
    [(lower-type-register-resident? ctx (lower-global-shared-view ty))
      (match (lower-load-at-offset
        state
        base
        offset
        (lower-register-word-type ctx ty 0))
        [(Expr load-state loaded _) (Expr load-state loaded ty)])]
    [else (lower-load-at-offset state base offset ty)]))

(define (lower-copy-bytes-compact
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [dst-offset : i64]
  [src : ir.CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (if (<= size 0)
    state
    (if (and (= dst-offset 0) (= src-offset 0))
      (lower-state-emit state (CopyBytes dst src size))
      (lower-copy-bytes state dst dst-offset src src-offset size))))

;; Return-slot copies are paid on every aggregate-returning wrapper edge, and
;; results just over 200 bytes are common (the move checker returns many).
;; Let final sret copies use fourteen 16-byte memory
;; operations, matching the target-style operation budget, without globally
;; expanding cold field/list copies in the same size band.
(define lower-inline-return-copy-threshold : i64
  216)

(define (lower-copy-return-bytes
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [src : ir.CompilerIrValue]
  [size : i64]) : LowerState
  (if (and
    (> size lower-inline-copy-threshold)
    (<= size lower-inline-return-copy-threshold))
    (lower-state-emit state (CopyBytes dst src size))
    (lower-copy-bytes state dst 0 src 0 size)))

(define (lower-inline-aggregate-copy-size
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : ResultLowerSize
  (let
    [info : tc_core.TcLayoutInfo
      (try (tc_core.tc-inline-aggregate-type-layout ctx ty))]
    (match info
      [(TcLayoutInfo size _) (Ok size)])))

(define (lower-copy-inline-aggregate-to-inline
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (match (lower-inline-aggregate-copy-size ctx (lower-global-shared-view ty))
    [(Ok size)
      (match (lower-reserve-inline-storage state size ty)
        [(Expr copy-state copy-value _)
          (Ok
            (Expr
              ;; A register-resident source is carried as word(s), so
              ;; materialize via the group-aware store -- a 2-word group must
              ;; write BOTH words (a bare scalar store dropped word1).
              (if (lower-type-register-resident?
                ctx
                (lower-global-shared-view ty))
                (lower-store-inline-value-at-offset
                  ctx
                  copy-state
                  copy-value
                  0
                  value
                  (lower-global-shared-view ty)
                  size)
                (lower-copy-bytes-compact
                  copy-state
                  (lower-global-shared-view copy-value)
                  0
                  value
                  0
                  size))
              copy-value
              ty))])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

;; The frame copy with its address typed as `storage-ty`. The Win64 C-ABI
;; by-reference argument passes that address as a plain `u64`, so direct
;; extern-call register assignment never reclassifies the pointer as a
;; multi-word register group. The callee may write through it; the frame slot
;; is private to this call site and covers the call (#7885).
(define (lower-copy-inline-aggregate-to-inline-as
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [storage-ty : ast.AstType]) : ResultLowerExpr
  (let
    [copied : LowerExpr
      (try (lower-copy-inline-aggregate-to-inline ctx state value ty))]
    (match copied
      [(Expr copy-state copy-value _)
        (Ok (Expr copy-state copy-value storage-ty))])))

(define (lower-copy-inline-aggregate-to-heap
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (match (lower-inline-aggregate-copy-size ctx (lower-global-shared-view ty))
    [(Ok size)
      (match (lower-reserve-heap-storage state size ty)
        [(Expr copy-state copy-value _)
          (Ok
            (Expr
              ;; Group-aware store: a 2-word register group must write BOTH
              ;; words.
              (if (lower-type-register-resident?
                ctx
                (lower-global-shared-view ty))
                (lower-store-inline-value-at-offset
                  ctx
                  copy-state
                  copy-value
                  0
                  value
                  (lower-global-shared-view ty)
                  size)
                (lower-copy-bytes-compact
                  copy-state
                  (lower-global-shared-view copy-value)
                  0
                  value
                  0
                  size))
              copy-value
              ty))])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

(define (lower-inline-aggregate-abi-copy-needed?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (and
    ;; A register-resident aggregate is returned/passed in a register,
    ;; so it needs neither a heap escape-copy nor a caller-provided sret slot.
    (lower-type-inline-storage? ctx ty)
    (not (lower-type-register-resident? ctx ty))))

(define (lower-return-abi-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (if (lower-inline-aggregate-abi-copy-needed?
    ctx
    (lower-global-shared-view ty))
    (lower-copy-inline-aggregate-to-heap ctx state value ty)
    (Ok (Expr state value ty))))

(define (lower-local-assignment-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [target-var : i64]) : ResultLowerExpr
  (if (and
    (=
      (lower-state-current-function-id state)
      (lower-state-active-loop-function state))
    (< target-var (lower-state-active-loop-entry-var-limit state))
    (lower-inline-aggregate-abi-copy-needed? ctx (lower-global-shared-view ty)))
    ;; A loop-carried memory-class value needs independent inline storage.
    ;; Its source address can arrive through projections, branch merges, or
    ;; an enclosing loop. Snapshot at the assignment boundary rather than
    ;; depending on a partial address-provenance analysis. Raw pointers copy
    ;; only the address because they are not memory-class aggregates.
    (lower-copy-inline-aggregate-to-inline ctx state value ty)
    (Ok (Expr state value ty))))

(define (lower-current-sret-var
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]) : i64
  (let
    [marker : i64
      (cis.intern-lower-private-identity-raw (lower-sret-param-marker-id state))]
    (if (sym_i64_env.sym-i64-contains-id env marker)
      (sym_i64_env.sym-i64-lookup-id-or
        env
        marker
        (csym.compiler-symbols-missing-handle))
      (- 0 1))))

;; Convert a source-level structural value (always represented by a pointer in
;; expression lowering) to the physical return value required by the internal
;; classifier. The sret case performs only a shallow byte move into the hidden
;; caller slot; ownership remains with the already-lowered source expression.
(define (lower-internal-return-register-two
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ret-ty : ast.AstType]
  [classification : LowerCAbiAggregate]
  [first : LowerCAbiSlot]
  [second : LowerCAbiSlot]) : ResultLowerExpr
  (match first
    [(Slot first-ty first-offset)
      (match (lower-load-at-offset state value first-offset first-ty)
        [(Expr first-state first-value _)
          (match second
            [(Slot second-ty second-offset)
              (match (lower-load-at-offset
                first-state
                value
                second-offset
                second-ty)
                [(Expr second-state second-value _)
                  (match (lower-emit-pack
                    second-state
                    (ir.compiler-ir-value-seq2 first-value second-value)
                    (lower-internal-transport-type
                      ctx
                      (lower-global-shared-view ret-ty)
                      (lower-global-shared-view classification)))
                    [(Expr packed-state packed-value _)
                      (Ok
                        (Expr
                          packed-state
                          packed-value
                          (lower-internal-transport-type
                            ctx
                            ret-ty
                            classification)))])])])])]))

(define (lower-prepare-internal-return-no
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [value : ir.CompilerIrValue]
  [ret-ty : ast.AstType]) : ResultLowerExpr
  (let
    [sret-var : i64 (lower-current-sret-var state env)]
    (if (and
      (>= sret-var 0)
      (lower-type-inline-struct-or-enum? ctx (lower-global-shared-view ret-ty))
      (lower-inline-aggregate-abi-copy-needed?
        ctx
        (lower-global-shared-view ret-ty)))
      (match (lower-inline-aggregate-copy-size
        ctx
        (lower-global-shared-view ret-ty))
        [(Ok size)
          (Ok
            (Expr
              (lower-copy-return-bytes state (Var sret-var) value size)
              (Var sret-var)
              ret-ty))]
        [(Err message) (Err (box (lower-diagnostic message)))])
      (lower-return-abi-value ctx state value ret-ty))))

(define (lower-prepare-internal-return-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [value : ir.CompilerIrValue]
  [ret-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-internal-structural-resolved-type?
    (lower-global-shared-view ret-ty))
    (let
      [class : LowerCAbiAggregate
        (lower-internal-return-class-for-symbol
          ctx
          (lower-state-mode state)
          (lower-state-names state)
          (lower-state-current-function-id state)
          (lower-global-shared-view ret-ty))]
      (match (lower-global-shared-view class)
        [(Integer scalar-ty _)
          (match (lower-load-at-offset
            state
            value
            0
            (lower-global-shared-view scalar-ty))
            [(Expr loaded loaded-value _)
              (Ok (Expr loaded loaded-value scalar-ty))])]
        [(Register slots _)
          (if (= (lower-c-abi-slot-list-count slots) 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(Slot scalar-ty offset)
                (match (lower-load-at-offset
                  state
                  value
                  offset
                  (lower-global-shared-view scalar-ty))
                  [(Expr loaded loaded-value _)
                    (Ok (Expr loaded loaded-value scalar-ty))])])
            (lower-internal-return-register-two
              ctx
              state
              value
              ret-ty
              class
              (lower-c-abi-slot-list-ref slots 0)
              (lower-c-abi-slot-list-ref slots 1)))]
        [(Sret size)
          (let
            [sret-var : i64 (lower-current-sret-var state env)]
            (if (< sret-var 0)
              (Err
                (box
                  (lower-diagnostic
                    "lower: structural return missing hidden sret parameter")))
              (Ok
                (Expr
                  (lower-copy-bytes state (Var sret-var) 0 value 0 size)
                  (Var sret-var)
                  (U64)))))]
        [(No) (lower-prepare-internal-return-no ctx state env value ret-ty)]
        [(ByRef _)
          (Err
            (box
              (lower-diagnostic
                "lower: byref return classification is unsupported")))]
        [(Memory _)
          (Err
            (box
              (lower-diagnostic
                "lower: memory return classification is unsupported")))]
        [(Unsupported message) (Err (box (lower-diagnostic message)))]))
    (lower-prepare-internal-return-no ctx state env value ret-ty)))

(define (lower-raw-pointer-ir-type [ty : ast.AstType]) : ast.AstType
  (match (tc_core.tc-type-strip-region (lower-global-shared-view ty))
    [(Ptr _) (U64)]
    [(MutPtr _) (U64)]
    [_ ty]))

(define (lower-cast-value
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (let
    [ir-from-ty : ast.AstType
      (lower-raw-pointer-ir-type (lower-global-shared-view from-ty))]
    [ir-to-ty : ast.AstType
      (lower-raw-pointer-ir-type (lower-global-shared-view to-ty))]
    (if (or
      (tc_core.tc-type-eq from-ty (lower-global-shared-view to-ty))
      (tc_core.tc-type-eq
        (lower-global-shared-view ir-from-ty)
        (lower-global-shared-view ir-to-ty)))
      (Expr state value to-ty)
      (match (lower-state-alloc-var state)
        [(Alloc allocated var-id)
          (Expr
            (lower-state-emit allocated (Cast var-id value ir-from-ty ir-to-ty))
            (Var var-id)
            to-ty)]))))

(define (lower-literal-float-to-bits?
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region from-ty)
    [(F64)
      (match (tc_core.tc-type-strip-region to-ty)
        [(U64) true]
        [_ false])]
    [(F32)
      (match (tc_core.tc-type-strip-region to-ty)
        [(U32) true]
        [_ false])]
    [_ false]))

(define (lower-runtime-bitcast-value
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Expr
        (lower-state-emit
          allocated
          (Bitcast var-id value from-ty (lower-global-shared-view to-ty)))
        (Var var-id)
        to-ty)]))

(define (lower-bitcast-value
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (if (tc_core.tc-type-eq
    (lower-global-shared-view from-ty)
    (lower-global-shared-view to-ty))
    (Expr state value to-ty)
    (match (lower-global-shared-view value)
      [(F64 bits)
        (if (lower-literal-float-to-bits?
          (lower-global-shared-view from-ty)
          (lower-global-shared-view to-ty))
          (Expr state (I64 (cast bits : i64)) to-ty)
          (lower-runtime-bitcast-value state value from-ty to-ty))]
      [_ (lower-runtime-bitcast-value state value from-ty to-ty)])))

(define (lower-coerce-value
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (cond
    [(tc_core.tc-never-type? (lower-global-shared-view from-ty))
      (Expr state value from-ty)]
    [(tc_core.tc-type-eq
        (lower-global-shared-view from-ty)
        (lower-global-shared-view to-ty))
      (Expr state value to-ty)]
    [(tc_core.tc-type-compatible?
        (lower-global-shared-view to-ty)
        (lower-global-shared-view from-ty))
      (lower-cast-value state value from-ty to-ty)]
    [else (Expr state value to-ty)]))

(define (lower-oob-abort [state : LowerState]) : LowerState
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (lower-state-emit
        allocated
        (Call var-id (lower-tl-oob-abort-symbol) (Nil) (Unit)))]))

(define (lower-shift-abort [state : LowerState]) : LowerState
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (lower-state-emit
        allocated
        (Call var-id (lower-tl-shift-abort-symbol) (Nil) (Unit)))]))

(define (lower-string-fields [state : LowerState] [value : ir.CompilerIrValue]) : LowerStringFields
  (match (lower-load-at-offset state value 0 (U64))
    [(Expr ptr-state ptr _)
      (match (lower-load-at-offset ptr-state value 8 (I64))
        [(Expr len-state len _) (Fields len-state ptr len)])]))

(define (lower-str-ref-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(Ref _ inner)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx inner)))
        [(Str) true]
        [_ false])]
    [_ false]))

(define (lower-bytes-ref-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(Ref _ inner)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx inner)))
        [(Bytes) true]
        [_ false])]
    [(MutRef _ inner)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx inner)))
        [(Bytes) true]
        [_ false])]
    [_ false]))

(define (lower-string-handle-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view ty)))
    [(String) true]
    [_ (lower-str-ref-type? ctx ty)]))

(define (lower-bytes-handle-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (lower-bytes-ref-type? ctx ty))

(define (lower-length-handle-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (or
    (lower-string-handle-type? ctx (lower-global-shared-view ty))
    (lower-bytes-handle-type? ctx ty)))

;; A deprecated bare concat spelling (`string-append`, `string-concat`) lowers
;; to the runtime concat ABI wherever it is not shadowed: as a plain builtin,
;; or as the stdlib.string helper that typecheck gave the two-String-handle
;; type (`tc-string-copy-helper-call-id?`, asked through the visibility test it
;; shares, as for the eq family). The runtime prelude's own `string-concat`
;; definition does not count as a shadow (see
;; `lower-stdlib-string-helper-unshadowed-id?`). The spelling is tested by id
;; first, so other calls pay only two comparisons.
(define (lower-string-concat-legacy-call-id?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name-id : i64]) : bool
  (and
    (or
      (= source-id cbi.compiler-builtin-id-string-append)
      (= source-id cbi.compiler-builtin-id-string-concat))
    (or
      (lower-builtin-call-available-id? ctx env name-id)
      (and
        (tc_core.tc-stdlib-string-helper-visible-or-wrapper-id?
          ctx
          type-env
          source-id
          true
          name-id
          source-id
          (if (= source-id cbi.compiler-builtin-id-string-append)
            "string-append"
            "string-concat"))
        (lower-stdlib-string-helper-unshadowed-id? ctx env state name-id)))))

(define (lower-string-concat-public-target? [name : (& name str)]) : bool
  ;; Dotted imports resolve to module-key names before direct-call lowering.
  ;; Match that identity instead of the source spelling, so aliases remain
  ;; eligible while same-shaped user functions remain ordinary calls.
  (or
    (string.eq name (csym.compiler-symbol-module-key "stdlib.string" "append"))
    (string.eq name (csym.compiler-symbol-module-key "stdlib.string" "concat"))))

(define (lower-float-to-bits-public-target? [name : (& name str)]) : bool
  ;; Public stdlib wrappers are semantically the private bitcast intrinsic.
  ;; Match their resolved module identity so aliases are eligible while
  ;; same-shaped user functions remain ordinary calls.
  (or
    (string.eq
      name
      (csym.compiler-symbol-module-key "stdlib.math" "f64-to-bits"))
    (string.eq
      name
      (csym.compiler-symbol-module-key "stdlib.math" "f32-to-bits"))
    (string.eq name "math.tl::stdlib.math/f64-to-bits")
    (string.eq name "math.tl::stdlib.math/f32-to-bits")
    (string.eq name "stdlib/math.tl::stdlib.math/f64-to-bits")
    (string.eq name "stdlib/math.tl::stdlib.math/f32-to-bits")
    (string.eq name "stdlib\\math.tl::stdlib.math/f64-to-bits")
    (string.eq name "stdlib\\math.tl::stdlib.math/f32-to-bits")))

(define (lower-string-concat-public-source-name? [name : (& name str)]) : bool
  ;; These canonical spellings dominate compiler source and must not re-run
  ;; dotted-import resolution at every node of one deep tree. A local binding
  ;; is still rejected by the caller before this fast path is used.
  (or
    (string.eq name "string.append")
    (string.eq name "string.concat")
    (string.eq name "stdlib.string.append")
    (string.eq name "stdlib.string.concat")))

;; A tail call first runs direct-call/TCO eligibility checks over its arguments.
;; Those checks typecheck the whole argument subtree, which is needlessly
;; expensive for a concat tree that will lower to runtime calls rather than a
;; tail call. Recognize the public concat target once at the root and take the
;; ordinary return-expression path directly.
(define (lower-string-concat-call-source?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : bool
  (let
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        (tc_core.tc-context-structural-session ctx)
        name-id
        name-id)]
    (and
      (not (tc_core.tc-dotted-local-field-name-id? type-env source-id))
      (or
        (lower-string-concat-legacy-call-id?
          ctx
          env
          state
          type-env
          source-id
          name-id)
        (match (lower-source-name-lookup-key-id ctx type-env source-id)
          [(Ok lookup-name) (lower-string-concat-public-target? lookup-name)]
          [(Err _) false])))))

(define (lower-string-concat-call-parts
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : LowerMaybeStringConcatCall
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    (match (ast.ast-expr-unspan-with-pools (& pools) expr)
      [(Call callee-box args)
        (match (ast.ast-expr-unspan-with-pools
          (& pools)
          (tc_core.tc-context-expr-get ctx callee-box))
          [(Var name)
            (let
              [raw-name-id : i64
                (tc_core.macro-hygiene-global-source-name-id-or
                  (tc_core.tc-context-structural-session ctx)
                  name
                  name)]
              [raw-name : String (lower-context-intern-str ctx raw-name-id)]
              (if (= args.len 2)
                (if (or
                  (and
                    (lower-string-concat-public-source-name? raw-name)
                    (not
                      (tc_core.tc-dotted-local-field-name-id?
                        type-env
                        raw-name-id))
                    (not (sym_i64_env.sym-i64-contains-id env raw-name-id))
                    (not (lower-top-level-value-defined-id? ctx raw-name-id)))
                  (lower-string-concat-legacy-call-id?
                    ctx
                    env
                    state
                    type-env
                    raw-name-id
                    name)
                  (match (lower-source-name-lookup-key-id
                    ctx
                    type-env
                    raw-name-id)
                    [(Ok lookup-name)
                      (lower-string-concat-public-target? lookup-name)]
                    [(Err _) false]))
                  (Some
                    (ast.ast-expr-list-get (& args) 0 0)
                    (ast.ast-expr-list-get (& args) 1 0))
                  (No))
                (No)))]
          [_ (No)])]
      [_ (No)])))

(define (lower-string-concat-work-pop
  [pending : (&mut pending ast.AstExprList)]) : i64
  (let
    [index : i64 (- pending.len 1)]
    (set! pending.len index)
    (array-ref pending.slots index)))

;; Flatten the complete binary concat tree without recursively lowering its
;; children. The explicit LIFO worklist pushes right before left, preserving
;; source evaluation order without the retained LowerState chain that made deep
;; left/right trees grow superlinearly.
(define (lower-string-concat-exprs-all
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]) : ast.AstExprList
  (let
    [pending : ast.AstExprList (ast.ast-expr-list-with-capacity 16)]
    [out : ast.AstExprList (ast.ast-expr-list-with-capacity 16)]
    (ast.ast-expr-list-push
      (&mut pending)
      (ast.ast-expr-list-get (& exprs) 1 0))
    (ast.ast-expr-list-push
      (&mut pending)
      (ast.ast-expr-list-get (& exprs) 0 0))
    (while (not (ast.ast-expr-list-empty? (& pending)))
      (let
        [expr-id : i64 (lower-string-concat-work-pop (&mut pending))]
        [expr : ast.AstExpr (tc_core.tc-context-expr-get ctx expr-id)]
        (match (lower-string-concat-call-parts ctx env state type-env expr)
          [(Some nested-left nested-right)
            (ast.ast-expr-list-push (&mut pending) nested-right)
            (ast.ast-expr-list-push (&mut pending) nested-left)]
          [(No) (ast.ast-expr-list-push (&mut out) expr-id)])
        unit))
    out))

(define (lower-string-concat-runtime-name [count : i64]) : i64
  (cbi.compiler-builtin-refresh!)
  (cond
    [(= count 3) cbi.compiler-builtin-id-tl-string-concat3]
    [(= count 4) cbi.compiler-builtin-id-tl-string-concat4]
    [(= count 5) cbi.compiler-builtin-id-tl-string-concat5]
    [else cbi.compiler-builtin-id-tl-string-concat]))

(define (lower-string-concat-values-at!
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [end : i64]
  [builder : (&mut builder ir.CompilerIrValueBuilder)]
  [count : i64]) : ResultLowerStringValues
  (if (>= index end)
    (Ok state count)
    (let
      [expr : ast.AstExpr
        (tc_core.tc-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
      [lowered
        (try
          (lower-expr ctx state env type-env (lower-global-shared-view expr)))]
      (match lowered
        [(Expr expr-state value expr-ty)
          (if (lower-string-handle-type? ctx expr-ty)
            (match (lower-string-fields expr-state value)
              [(Fields field-state ptr len)
                (ir.compiler-ir-value-builder-push! builder ptr)
                (ir.compiler-ir-value-builder-push! builder len)
                (lower-string-concat-values-at!
                  ctx
                  field-state
                  env
                  type-env
                  exprs
                  (+ index 1)
                  end
                  builder
                  (+ count 1))])
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  expr
                  "lower: string-concat requires String"))))]))))

(define (lower-string-concat-emit
  [state : LowerState]
  [values : ir.CompilerIrValueSeq]
  [count : i64]) : LowerExpr
  (begin
    (cfg
      compile-profile
      (compiler-lower-profile-string-concat-note-runtime-call!
        (lower-state-owner state)))
    (match (lower-state-alloc-var state)
      [(Alloc allocated var-id)
        (Expr
          (lower-state-emit
            allocated
            (Call
              var-id
              (lower-string-concat-runtime-name count)
              (ir.compiler-ir-call-args-from-seq values)
              (String)))
          (Var var-id)
          (String))])))

(define (lower-string-concat-exprs-batched-group
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [end : i64]
  [prefix : ir.CompilerIrValueSeq]
  [count : i64]) : ResultLowerExpr
  (let
    [builder : ir.CompilerIrValueBuilder
      (ir.compiler-ir-value-builder-with-capacity
        (+ prefix.len (* (- end index) 2)))]
    [_prefix : unit
      (ir.compiler-ir-value-builder-append-seq! (&mut builder) prefix)]
    (match (lower-string-concat-values-at!
      ctx
      state
      env
      type-env
      exprs
      index
      end
      (&mut builder)
      count)
      [(Ok values-state value-count)
        (match (lower-string-concat-emit
          values-state
          (ir.compiler-ir-value-builder-to-seq builder)
          value-count)
          [(Expr call-state call-value _)
            (lower-string-concat-exprs-batched
              ctx
              call-state
              env
              type-env
              exprs
              end
              (Some call-value))])]
      [(Err message) (Err message)])))

(define (lower-string-concat-exprs-batched
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [carry : LowerMaybeIrValue]) : ResultLowerExpr
  (let
    [remaining : i64 (- exprs.len index)]
    (if (<= remaining 0)
      (match carry
        [(Some value) (Ok (Expr state value (String)))]
        [(No)
          (Err
            (box (lower-diagnostic "lower: string-concat requires arguments")))])
      (match carry
        [(No)
          (let
            [take : i64
              (if (> remaining 5)
                5
                remaining)]
            (lower-string-concat-exprs-batched-group
              ctx
              state
              env
              type-env
              exprs
              index
              (+ index take)
              (ir.compiler-ir-value-seq-empty)
              0))]
        [(Some value)
          (match (lower-string-fields state value)
            [(Fields carry-state ptr len)
              (let
                [take : i64
                  (if (> remaining 4)
                    4
                    remaining)]
                (lower-string-concat-exprs-batched-group
                  ctx
                  carry-state
                  env
                  type-env
                  exprs
                  index
                  (+ index take)
                  (ir.compiler-ir-value-seq2 ptr len)
                  1))])]))))

(define (lower-string-concat-exprs
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultLowerExpr
  (begin
    (cfg
      compile-profile
      (compiler-lower-profile-string-concat-note-tree!
        (lower-state-owner state)
        exprs.len))
    (lower-string-concat-exprs-batched ctx state env type-env (& exprs) 0 (No))))

(define (lower-supported-reference-referent-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-canonicalize-inferred-type ctx (tc_core.tc-resolve-type ctx ty)))
    [(I64) true]
    [(U64) true]
    [(F64) true]
    [(I32) true]
    [(U32) true]
    [(F32) true]
    [(I16) true]
    [(U16) true]
    [(I8) true]
    [(U8) true]
    [(Bool) true]
    [(Char) true]
    ;; Borrowing a raw-pointer value borrows the one-word pointer slot; it does
    ;; not dereference the raw pointer's target. Pointer formatting relies on
    ;; this shape before its separately unsafe ptr->int conversion.
    [(Ptr _) true]
    [(MutPtr _) true]
    [(Str) true]
    [(Bytes) true]
    [(Tuple elems)
      (lower-supported-reference-type-list-with-stack?
        ctx
        (deref elems)
        (lower-id-set-empty))]
    ;; A fixed array stores its elements inline, so it is borrowable whenever
    ;; one element is a lowerable value: reference-bearing elements (shared
    ;; `str`/scalar views, lifetime-parameterized records) keep the layout they
    ;; have as struct fields (#8111). A dynamic array stays reference-free.
    [(Array elem-ty _)
      (lower-supported-reference-type-with-stack?
        ctx
        (tc_core.tc-context-type-get ctx elem-ty)
        (lower-id-set-empty))]
    [(DynArray elem-ty)
      (not
        (tc_core.tc-type-contains-reference?
          (tc_core.tc-context-type-get ctx elem-ty)))]
    ;; Borrowing a Box value takes the address of its one-word owning handle.
    ;; The pointee remains behind the Box and is lowered separately when the
    ;; resulting reference is dereferenced.
    [(Box elem-ty)
      (lower-supported-reference-type-with-stack?
        ctx
        (tc_core.tc-context-type-get ctx elem-ty)
        (lower-id-set-empty))]
    ;; A Slice is supported only when it is the immediate referent of a
    ;; borrowed reference; bare Slice remains unsized and has no by-value
    ;; borrow layout.  Its elements follow the fixed-array rule above: a Slice
    ;; views an array's inline elements.
    [(Slice elem-ty)
      (lower-supported-reference-type-with-stack?
        ctx
        (tc_core.tc-context-type-get ctx elem-ty)
        (lower-id-set-empty))]
    [(Struct name)
      (lower-supported-reference-struct-args-with-stack?
        ctx
        name
        (ast.ast-lifetime-list-new)
        (lower-id-set-empty))]
    [(StructArgs name lifetimes)
      (lower-supported-reference-struct-args-with-stack?
        ctx
        name
        (deref lifetimes)
        (lower-id-set-empty))]
    [(Enum name)
      (lower-supported-reference-enum-args-with-stack?
        ctx
        name
        (ast.ast-lifetime-list-new)
        (lower-id-set-empty))]
    [(EnumArgs name lifetimes)
      (lower-supported-reference-enum-args-with-stack?
        ctx
        name
        (deref lifetimes)
        (lower-id-set-empty))]
    [_ false]))

(define (lower-borrow-place-value-reference?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (if (lower-type-register-resident? ctx (lower-global-shared-view resolved))
      false
      (match resolved
        [(Tuple _) true]
        [(Array _ _) true]
        [(DynArray _) true]
        [(Struct _) true]
        [(StructArgs _ _) true]
        [(Enum _) true]
        [(EnumArgs _ _) true]
        [_ false]))))

;; A memory-class local/global value already denotes its aggregate payload, so
;; address-of can reuse that reference. Owning/view handles such as a dynamic
;; array are instead stored inline and must take the address of the handle slot,
;; even though ordinary borrowing treats their payload pointer as the referent.
(define (lower-ptr-addr-of-storage-value-reference?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (if (lower-type-register-resident? ctx (lower-global-shared-view resolved))
      false
      (match resolved
        [(Tuple _) true]
        [(Array _ _) true]
        [(Struct _) true]
        [(StructArgs _ _) true]
        [(Enum _) true]
        [(EnumArgs _ _) true]
        [_ false]))))

(define (lower-supported-reference-type-list-with-stack?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-type-list-with-stack-at? ctx (& types) stack 0))

(define (lower-supported-reference-type-list-with-stack-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (and
      (lower-supported-reference-type-with-stack?
        ctx
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        (lower-global-shared-view stack))
      (lower-supported-reference-type-list-with-stack-at?
        ctx
        types
        stack
        (+ index 1)))))

(define (lower-supported-reference-type-list-subst-with-stack?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [types : ast.AstTypeList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-type-list-subst-with-stack-at?
    ctx
    subst
    (& types)
    stack
    0))

(define (lower-supported-reference-type-list-subst-with-stack-at?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [types : (& types ast.AstTypeList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (and
      (lower-supported-reference-type-with-stack?
        ctx
        (tc_core.tc-lifetime-subst-type
          subst
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
        (lower-global-shared-view stack))
      (lower-supported-reference-type-list-subst-with-stack-at?
        ctx
        subst
        types
        stack
        (+ index 1)))))

(define (lower-supported-reference-field-list-with-stack?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [fields : ast.AstFieldDefList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-field-list-with-stack-at?
    ctx
    subst
    (& fields)
    stack
    0))

(define (lower-supported-reference-field-list-with-stack-at?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [fields : (& fields ast.AstFieldDefList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index fields.len)
    true
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def _ ty _)
        (and
          (lower-supported-reference-type-with-stack?
            ctx
            (tc_core.tc-lifetime-subst-type subst ty)
            (lower-global-shared-view stack))
          (lower-supported-reference-field-list-with-stack-at?
            ctx
            subst
            fields
            stack
            (+ index 1)))])))

(define (lower-supported-reference-variant-list-with-stack?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [variants : ast.AstVariantDefList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-variant-list-with-stack-at?
    ctx
    subst
    (& variants)
    stack
    0))

(define (lower-supported-reference-variant-list-with-stack-at?
  [ctx : tc_core.TcContext]
  [subst : tc_core.TcLifetimeSubst]
  [variants : (& variants ast.AstVariantDefList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index variants.len)
    true
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def _ fields _)
        (and
          (lower-supported-reference-type-list-subst-with-stack?
            ctx
            subst
            fields
            (lower-global-shared-view stack))
          (lower-supported-reference-variant-list-with-stack-at?
            ctx
            subst
            variants
            stack
            (+ index 1)))])))

(define (lower-supported-reference-struct-args-with-stack?
  [ctx : tc_core.TcContext]
  [name : i64]
  [lifetimes : ast.AstLifetimeList]
  [stack : LowerIdSet]) : bool
  (if (lower-id-set-contains? stack name)
    true
    (match (tc_core.tc-lifetime-subst-from-nominal-args-id ctx name lifetimes)
      [(Err _) false]
      [(Ok subst)
        (match (tc_core.tc-struct-decl-id ctx name)
          [(Err _) false]
          [(Ok decl)
            (match decl
              [(TcStructDecl _ _ fields)
                (lower-supported-reference-field-list-with-stack?
                  (tc_core.tc-context-with-nominal-owner-module-id ctx name)
                  subst
                  fields
                  (lower-id-set-insert stack name))])])])))

(define (lower-supported-reference-enum-args-with-stack?
  [ctx : tc_core.TcContext]
  [name : i64]
  [lifetimes : ast.AstLifetimeList]
  [stack : LowerIdSet]) : bool
  (if (lower-id-set-contains? stack name)
    true
    (match (tc_core.tc-lifetime-subst-from-nominal-args-id ctx name lifetimes)
      [(Err _) false]
      [(Ok subst)
        (match (tc_core.tc-context-enum-variants-id
          ctx
          name
          (tc_core.tc-nominal-name-id-display name))
          [(Err _) false]
          [(Ok variants)
            (lower-supported-reference-variant-list-with-stack?
              (tc_core.tc-context-with-nominal-owner-module-id ctx name)
              subst
              variants
              (lower-id-set-insert stack name))])])))

(define (lower-supported-reference-type-with-stack?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [stack : LowerIdSet]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region
        (tc_core.tc-canonicalize-inferred-type
          ctx
          (tc_core.tc-resolve-type ctx ty)))]
    (match (& resolved)
      ;; Bare Slice is unsized and is never a directly lowerable value.  The
      ;; Slice arm below is reached only through Ref/MutRef's referent helper.
      [(Slice _) false]
      [_
        (if (not
          (tc_core.tc-type-contains-reference?
            (lower-global-shared-view resolved)))
          true
          (match resolved
            [(Ref _ inner)
              (lower-supported-reference-referent-type?
                ctx
                (tc_core.tc-context-type-get ctx inner))]
            [(MutRef _ inner)
              (lower-supported-reference-referent-type?
                ctx
                (tc_core.tc-context-type-get ctx inner))]
            [(Tuple elems)
              (lower-supported-reference-type-list-with-stack?
                ctx
                (deref elems)
                stack)]
            [(Array elem _)
              (lower-supported-reference-type-with-stack?
                ctx
                (tc_core.tc-context-type-get ctx elem)
                stack)]
            [(DynArray elem)
              (lower-supported-reference-type-with-stack?
                ctx
                (tc_core.tc-context-type-get ctx elem)
                stack)]
            [(Box elem)
              (lower-supported-reference-type-with-stack?
                ctx
                (tc_core.tc-context-type-get ctx elem)
                stack)]
            [(Func params ret)
              (and
                (lower-supported-reference-type-list-with-stack?
                  ctx
                  (deref params)
                  (lower-global-shared-view stack))
                (lower-supported-reference-type-with-stack?
                  ctx
                  (tc_core.tc-context-type-get ctx ret)
                  stack))]
            [(Struct name)
              (lower-supported-reference-struct-args-with-stack?
                ctx
                name
                (ast.ast-lifetime-list-new)
                stack)]
            [(StructArgs name lifetimes)
              (lower-supported-reference-struct-args-with-stack?
                ctx
                name
                (deref lifetimes)
                stack)]
            [(Enum name)
              (lower-supported-reference-enum-args-with-stack?
                ctx
                name
                (ast.ast-lifetime-list-new)
                stack)]
            [(EnumArgs name lifetimes)
              (lower-supported-reference-enum-args-with-stack?
                ctx
                name
                (deref lifetimes)
                stack)]
            [(Region _ inner)
              (lower-supported-reference-type-with-stack?
                ctx
                (tc_core.tc-context-type-get ctx inner)
                stack)]
            [_ false]))])))

(define (lower-supported-reference-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (lower-supported-reference-type-with-stack? ctx ty (lower-id-set-empty)))

(define (lower-borrowed-str-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-str-ref-type? ctx (lower-global-shared-view expr-ty))
    (let
      [lowered (try (lower-expr ctx state env type-env inner))]
      (match lowered
        [(Expr inner-state value _) (Ok (Expr inner-state value expr-ty))]))
    (Err
      (box
        (lower-diagnostic-at-expr ctx origin (lower-reference-support-message))))))

(define (lower-borrow-copy-to-storage
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [referent-ty : ast.AstType]
  [result-ty : ast.AstType]) : LowerExpr
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions
        (tc_core.tc-resolve-type ctx referent-ty))]
    [size : i64 (lower-type-size ctx resolved)]
    (match (lower-reserve-heap-storage
      state
      (if (= size 0)
        1
        size)
      result-ty)
      [(Expr base-state base _)
        (Expr
          (if (> size 0)
            (lower-store-inline-value-at-offset
              ctx
              base-state
              base
              0
              value
              resolved
              size)
            base-state)
          base
          result-ty)])))

(define (lower-borrow-copy-to-inline-storage
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [referent-ty : ast.AstType]
  [result-ty : ast.AstType]) : LowerExpr
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions
        (tc_core.tc-resolve-type ctx referent-ty))]
    [size : i64 (lower-type-size ctx resolved)]
    (match (lower-reserve-inline-storage
      state
      (if (= size 0)
        1
        size)
      resolved)
      [(Expr base-state base _)
        (Expr
          (if (> size 0)
            (lower-store-inline-value-at-offset
              ctx
              base-state
              base
              0
              value
              resolved
              size)
            base-state)
          base
          result-ty)])))

(define (lower-borrow-place-slot-reference
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [slot : ir.CompilerIrValue]
  [stored-ty : ast.AstType]
  [result-ty : ast.AstType]
  [load-value-reference : bool]) : LowerExpr
  (if (and
    load-value-reference
    (lower-borrow-place-value-reference?
      ctx
      (tc_core.tc-borrow-referent-type (lower-global-shared-view stored-ty))))
    (match (lower-state-alloc-var state)
      [(Alloc allocated var-id)
        (Expr
          (lower-state-emit allocated (Load var-id slot stored-ty))
          (Var var-id)
          result-ty)])
    (Expr state slot result-ty)))

(define (lower-borrow-reference-var-address
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? id)
      (Ok (Expr state (Var id) result-ty))
      (Ok
        (Expr
          state
          (Global (lower-resolve-name-symbol-id state name-id))
          result-ty)))))

(define (lower-borrow-var-address-by-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [place-ty : ast.AstType]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [referent-ty : ast.AstType (tc_core.tc-borrow-referent-type place-ty)]
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? id)
      (if (lower-borrow-place-value-reference?
        ctx
        (lower-global-shared-view referent-ty))
        (Ok (Expr state (Var id) result-ty))
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx (lower-global-shared-view result-ty)))
          [(MutRef _ _)
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  "lower: mutable borrow of by-value place requires writeback support")))]
          [_
            (if (not (lower-state-deferred-copy? state id))
              (ResultLowerExpr.Ok
                (lower-borrow-copy-to-storage
                  ctx
                  state
                  (Var id)
                  referent-ty
                  result-ty))
              ;; An auto-borrowed deferred Copy binding copies its value as
              ;; read here, not its address.
              (match (lower-load-inline-value-at-offset
                ctx
                state
                (ir.CompilerIrValue.Var id)
                0
                (lower-global-shared-view referent-ty))
                [(LowerExpr.Expr read-state value _)
                  (ResultLowerExpr.Ok
                    (lower-borrow-copy-to-storage
                      ctx
                      read-state
                      value
                      referent-ty
                      result-ty))]))]))
      (Ok
        (Expr
          state
          (if (lower-borrow-place-value-reference? ctx referent-ty)
            (Global (lower-resolve-name-symbol-id state name-id))
            (GlobalAddr (lower-resolve-name-symbol-id state name-id)))
          result-ty)))))

(define (lower-borrow-var-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-lookup-id type-env name)
    [(Ok place-ty)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (lower-global-shared-view place-ty)))
        [(Ref _ _)
          (lower-borrow-reference-var-address state env name result-ty)]
        [(MutRef _ _)
          (lower-borrow-reference-var-address state env name result-ty)]
        [_
          (if (and
            (tc_core.tc-type-contains-reference?
              (lower-global-shared-view place-ty))
            (not
              (lower-supported-reference-type?
                ctx
                (lower-global-shared-view place-ty))))
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  (lower-reference-support-message))))
            (lower-borrow-var-address-by-value
              ctx
              state
              env
              name
              place-ty
              origin
              result-ty))])]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx origin message)))]))

(define (lower-borrow-struct-field-address-from-memory
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field : String]
  [_origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [info (try (lower-struct-field-info ctx struct-id struct-name field))]
    (match info
      [(Info offset field-ty)
        (let
          [load-value-reference : bool
            (not
              (or
                (and
                  (lower-struct-repr-c-id? ctx struct-id)
                  (lower-repr-c-inline-field?
                    ctx
                    (lower-global-shared-view field-ty)))
                (and
                  (lower-type-inline-storage? ctx field-ty)
                  (not
                    (lower-type-register-resident?
                      ctx
                      (lower-global-shared-view field-ty))))))]
          (match (lower-gep-byte state base offset)
            [(Expr ptr-state ptr _)
              (Ok
                (lower-borrow-place-slot-reference
                  ctx
                  ptr-state
                  ptr
                  field-ty
                  result-ty
                  load-value-reference))]))])))

(define (lower-borrow-struct-field-address-named
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [receiver-value : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field : String]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  ;; A register-resident receiver has no address; materialize the packed
  ;; word to a fresh slot, then take the field address through the same memory
  ;; helper used for borrowed struct references.
  (if (tc_core.tc-name-register-resident-id? ctx struct-id)
    (match (lower-borrow-copy-to-storage
      ctx
      state
      receiver-value
      (Struct struct-id)
      (lower-global-shared-view result-ty))
      [(Expr mat-state mat-ptr _)
        (lower-borrow-struct-field-address-from-memory
          ctx
          mat-state
          mat-ptr
          struct-id
          struct-name
          field
          origin
          result-ty)])
    (lower-borrow-struct-field-address-from-memory
      ctx
      state
      receiver-value
      struct-id
      struct-name
      field
      origin
      result-ty)))

(define (lower-borrow-struct-field-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [field : String]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [lowered : LowerExpr (try (lower-expr ctx state env type-env receiver))]
    (match lowered
      [(Expr receiver-state receiver-value receiver-ty)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx receiver-ty))
          [(Struct struct-name)
            (lower-borrow-struct-field-address-named
              ctx
              receiver-state
              receiver-value
              struct-name
              (tc_core.tc-nominal-name-id-display struct-name)
              field
              origin
              result-ty)]
          [(StructArgs struct-name _)
            (lower-borrow-struct-field-address-named
              ctx
              receiver-state
              receiver-value
              struct-name
              (tc_core.tc-nominal-name-id-display struct-name)
              field
              origin
              result-ty)]
          [(Ref _ referent-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (tc_core.tc-context-type-get ctx referent-ty)))
              [(Struct struct-name)
                (lower-borrow-struct-field-address-from-memory
                  ctx
                  receiver-state
                  receiver-value
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field
                  origin
                  result-ty)]
              [(StructArgs struct-name _)
                (lower-borrow-struct-field-address-from-memory
                  ctx
                  receiver-state
                  receiver-value
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field
                  origin
                  result-ty)]
              [_
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "lower: field projection borrow requires struct place")))])]
          [(MutRef _ referent-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (tc_core.tc-context-type-get ctx referent-ty)))
              [(Struct struct-name)
                (lower-borrow-struct-field-address-from-memory
                  ctx
                  receiver-state
                  receiver-value
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field
                  origin
                  result-ty)]
              [(StructArgs struct-name _)
                (lower-borrow-struct-field-address-from-memory
                  ctx
                  receiver-state
                  receiver-value
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field
                  origin
                  result-ty)]
              [_
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "lower: field projection borrow requires struct place")))])]
          [_
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  "lower: field projection borrow requires struct place")))])])))

(define (lower-borrow-tuple-field-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [tuple-expr : ast.AstExpr]
  [index : i64]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [lowered : LowerExpr (try (lower-expr ctx state env type-env tuple-expr))]
    (match lowered
      [(Expr tuple-state tuple-value tuple-ty)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx tuple-ty))
          [(Tuple elem-tys)
            (let
              [info : LowerFieldInfo
                (try (lower-tuple-elem-info ctx (deref elem-tys) index 0 0))]
              (match info
                [(Info offset _)
                  (match (lower-gep-byte tuple-state tuple-value offset)
                    [(Expr ptr-state ptr _) (Ok (Expr ptr-state ptr result-ty))])]))]
          [(Ref _ referent-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (tc_core.tc-context-type-get ctx referent-ty)))
              [(Tuple elem-tys)
                (let
                  [info : LowerFieldInfo
                    (try (lower-tuple-elem-info ctx (deref elem-tys) index 0 0))]
                  (match info
                    [(Info offset _)
                      (match (lower-gep-byte tuple-state tuple-value offset)
                        [(Expr ptr-state ptr _)
                          (Ok (Expr ptr-state ptr result-ty))])]))]
              [_
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "lower: tuple-ref borrow requires tuple place")))])]
          [(MutRef _ referent-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (tc_core.tc-context-type-get ctx referent-ty)))
              [(Tuple elem-tys)
                (let
                  [info : LowerFieldInfo
                    (try (lower-tuple-elem-info ctx (deref elem-tys) index 0 0))]
                  (match info
                    [(Info offset _)
                      (match (lower-gep-byte tuple-state tuple-value offset)
                        [(Expr ptr-state ptr _)
                          (Ok (Expr ptr-state ptr result-ty))])]))]
              [_
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "lower: tuple-ref borrow requires tuple place")))])]
          [_
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  "lower: tuple-ref borrow requires tuple place")))])])))

(define (lower-borrow-array-element-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [index : ast.AstExpr]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    arr)
    [(Ok arr-ty)
      ;; A reference-valued iterator field is already an address of its array
      ;; storage. Its element borrow has been typechecked against the stored
      ;; referent, so lower the same dynamic/fixed-array address computation
      ;; instead of requiring the field projection itself to be an Array value.
      (let
        [container-ty : ast.AstType
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx (lower-global-shared-view arr-ty)))
            [(Ref _ referent-ty) (tc_core.tc-context-type-get ctx referent-ty)]
            [(MutRef _ referent-ty)
              (tc_core.tc-context-type-get ctx referent-ty)]
            [_ (owned_view.compiler-owned-shared-view arr-ty)])]
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx (lower-global-shared-view container-ty)))
          [(Slice elem-ty)
            (let
              [arr-lowered : LowerExpr
                (try (lower-expr ctx state env type-env arr))]
              (match arr-lowered
                [(Expr arr-state arr-value _)
                  (match (lower-index-result-type-or-check
                    ctx
                    env
                    type-env
                    (lower-state-type-cache arr-state)
                    (lower-state-function-state arr-state)
                    (lower-global-shared-view index))
                    [(Ok idx-ty)
                      (let
                        [idx-lowered
                          (try
                            (lower-expr-expected
                              ctx
                              arr-state
                              env
                              type-env
                              (lower-global-shared-view index)
                              idx-ty
                              index))]
                        (match idx-lowered
                          [(Expr idx-state idx-value idx-value-ty)
                            (match (lower-slice-element-addr
                              ctx
                              idx-state
                              arr-value
                              arr-ty
                              idx-value
                              idx-value-ty
                              (tc_core.tc-type-without-regions
                                (tc_core.tc-context-type-get ctx elem-ty)))
                              [(Expr addr-state elem-ptr _)
                                (Ok
                                  (Expr
                                    (lower-state-record-latest-bounds-check-at-expr
                                      ctx
                                      addr-state
                                      origin)
                                    elem-ptr
                                    result-ty))])]))]
                    [(Err message)
                      (Err (box (lower-diagnostic-at-expr ctx index message)))])]))]
          [(DynArray elem-ty)
            (let
              [arr-lowered : LowerExpr
                (try (lower-expr ctx state env type-env arr))]
              (match arr-lowered
                [(Expr arr-state arr-value _)
                  (match (lower-index-result-type-or-check
                    ctx
                    env
                    type-env
                    (lower-state-type-cache arr-state)
                    (lower-state-function-state arr-state)
                    (lower-global-shared-view index))
                    [(Ok idx-ty)
                      (let
                        [idx-lowered
                          (try
                            (lower-expr-expected
                              ctx
                              arr-state
                              env
                              type-env
                              (lower-global-shared-view index)
                              idx-ty
                              index))]
                        (match idx-lowered
                          [(Expr idx-state idx-value idx-value-ty)
                            (match (lower-array-element-addr
                              ctx
                              idx-state
                              arr-value
                              idx-value
                              idx-value-ty
                              (tc_core.tc-type-without-regions
                                (tc_core.tc-context-type-get ctx elem-ty)))
                              [(Expr addr-state elem-ptr _)
                                (Ok
                                  (Expr
                                    (lower-state-record-latest-bounds-check-at-expr
                                      ctx
                                      addr-state
                                      origin)
                                    elem-ptr
                                    result-ty))])]))]
                    [(Err message)
                      (Err (box (lower-diagnostic-at-expr ctx index message)))])]))]
          [(Array elem-ty elem-count)
            (let
              [fixed-elem-ty : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-context-type-get ctx elem-ty))]
              [arr-lowered : LowerExpr
                (try (lower-expr ctx state env type-env arr))]
              (match arr-lowered
                [(Expr arr-state arr-value _)
                  (match (lower-index-result-type-or-check
                    ctx
                    env
                    type-env
                    (lower-state-type-cache arr-state)
                    (lower-state-function-state arr-state)
                    (lower-global-shared-view index))
                    [(Ok idx-ty)
                      (let
                        [idx-lowered
                          (try
                            (lower-expr-expected
                              ctx
                              arr-state
                              env
                              type-env
                              (lower-global-shared-view index)
                              idx-ty
                              index))]
                        (match idx-lowered
                          [(Expr idx-state idx-value idx-value-ty)
                            (match (lower-fixed-array-element-addr
                              ctx
                              idx-state
                              arr-value
                              idx-value
                              idx-value-ty
                              fixed-elem-ty
                              elem-count)
                              [(Expr addr-state elem-ptr _)
                                (Ok
                                  (Expr
                                    (lower-state-record-latest-bounds-check-at-expr
                                      ctx
                                      addr-state
                                      origin)
                                    elem-ptr
                                    result-ty))])]))]
                    [(Err message)
                      (Err (box (lower-diagnostic-at-expr ctx index message)))])]))]
          [_
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  (str_cat.str-cat
                    "lower: array-ref borrow requires array place, got "
                    (tc_core.tc-type-render
                      (tc_core.tc-type-strip-region
                        (tc_core.tc-resolve-type ctx container-ty)))))))]))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx arr message)))]))

(define (lower-borrow-place-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (ast.ast-expr-unspan place)
    [(Var name)
      (if (tc_core.tc-dotted-local-field-name-id? type-env name)
        (match (tc_core.tc-dotted-local-field-expr-id type-env name)
          [(Ok virtual-id)
            (lower-borrow-place-address
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin
              result-ty)]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx origin message)))])
        (lower-borrow-var-address ctx state env type-env name origin result-ty))]
    [(StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-borrow-struct-field-address
          ctx
          state
          env
          type-env
          receiver
          (tc_core.tc-env-key-name-text field)
          origin
          result-ty))]
    [(TupleRef tuple-expr-box index)
      (let
        [tuple-expr : ast.AstExpr (lower-context-expr-get ctx tuple-expr-box)]
        (lower-borrow-tuple-field-address
          ctx
          state
          env
          type-env
          tuple-expr
          index
          origin
          result-ty))]
    [(ArrayRef arr-box index-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-borrow-array-element-address
          ctx
          state
          env
          type-env
          arr
          index
          origin
          result-ty))]
    [(BoxGet box-box)
      (let
        [box-expr : ast.AstExpr (lower-context-expr-get ctx box-box)]
        (lower-box-storage-address
          ctx
          state
          env
          type-env
          box-expr
          origin
          result-ty
          true))]
    [(BoxTake receiver-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-box-storage-address
          ctx
          state
          env
          type-env
          receiver
          origin
          result-ty
          true))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: borrow requires a local, parameter, or aggregate place")))]))

(define (lower-borrow-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-str-ref-type? ctx (lower-global-shared-view expr-ty))
    (lower-borrowed-str-expr ctx state env type-env inner origin expr-ty)
    (match (tc_core.tc-type-strip-region
      (tc_core.tc-resolve-type ctx (lower-global-shared-view expr-ty)))
      [(Ref _ referent-ty)
        (if (lower-supported-reference-referent-type?
          ctx
          (tc_core.tc-context-type-get ctx referent-ty))
          (lower-borrow-place-address
            ctx
            state
            env
            type-env
            inner
            origin
            expr-ty)
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                origin
                (lower-reference-support-message)))))]
      [(MutRef _ referent-ty)
        (if (lower-supported-reference-referent-type?
          ctx
          (tc_core.tc-context-type-get ctx referent-ty))
          (lower-borrow-place-address
            ctx
            state
            env
            type-env
            inner
            origin
            expr-ty)
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                origin
                (lower-reference-support-message)))))]
      [_
        (Err
          (box
            (lower-diagnostic-at-expr
              ctx
              origin
              (lower-reference-support-message))))])))

(define (lower-store-inline-struct-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueSeq]
  [fields : ast.AstFieldDefList]
  [layout : tc_core.TcInlineAggregateLayout]) : ResultLowerState
  (lower-store-inline-struct-values-at
    ctx
    state
    base
    values
    (& fields)
    0
    layout))

(define (lower-store-inline-struct-values-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueSeq]
  [fields : (& fields ast.AstFieldDefList)]
  [field-index : i64]
  [layout : tc_core.TcInlineAggregateLayout]) : ResultLowerState
  (if (>= field-index values.len)
    (if (>= field-index fields.len)
      (Ok state)
      (Err (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= field-index fields.len)
      (Err (box (lower-diagnostic "lower: constructor arity mismatch")))
      (match (ast.ast-field-def-list-get
        fields
        field-index
        (ast.ast-field-def-fallback))
        [(Def name ty _)
          (let
            [name-id : i64 (ci.intern-syntax-id-value name)]
            [name-str : String (tc_core.tc-env-key-name-text name-id)]
            [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
            [offset : i64
              (tc_core.tc-inline-aggregate-layout-field-offset-id
                (lower-global-shared-view layout)
                name-id)]
            (if (< offset 0)
              (Err
                (box
                  (lower-diagnostic
                    (str_cat.str-cat
                      "lower: inline struct layout missing field "
                      name-str))))
              (match (tc_core.tc-inline-aggregate-type-layout
                ctx
                (lower-global-shared-view resolved))
                [(Ok info)
                  (let
                    [stored-state : LowerState
                      (if (<= (tc_core.tc-layout-info-size info) 0)
                        state
                        (lower-store-checked-value-at-offset
                          ctx
                          state
                          (lower-global-shared-view base)
                          offset
                          (ir.compiler-ir-value-seq-ref values field-index)
                          resolved
                          (tc_core.tc-layout-info-size info)))]
                    (lower-store-inline-struct-values-at
                      ctx
                      stored-state
                      base
                      values
                      fields
                      (+ field-index 1)
                      layout))]
                [(Err message) (Err (box (lower-diagnostic message)))])))]))))

(define (lower-store-inline-payload-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueSeq]
  [types : ast.AstTypeList]
  [layout : tc_core.TcInlineAggregateLayout]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]) : ResultLowerState
  (lower-store-inline-payload-values-at
    ctx
    state
    base
    values
    (& types)
    layout
    variant-name
    variant-name-id
    index))

(define (lower-store-inline-payload-values-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [values : ir.CompilerIrValueSeq]
  [types : (& types ast.AstTypeList)]
  [layout : tc_core.TcInlineAggregateLayout]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]) : ResultLowerState
  (if (>= index values.len)
    (if (>= index (ast.ast-type-list-len types))
      (Ok state)
      (Err (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [ty : ast.AstType
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
        [offset : i64
          (tc_core.tc-inline-aggregate-layout-variant-payload-offset-id
            (lower-global-shared-view layout)
            variant-name-id
            index)]
        (if (< offset 0)
          (Err
            (box
              (lower-diagnostic
                (str_cat.str-cat
                  "lower: inline enum layout missing payload for "
                  variant-name))))
          (match (tc_core.tc-inline-aggregate-type-layout
            ctx
            (lower-global-shared-view resolved))
            [(Ok info)
              (lower-store-inline-payload-values-at
                ctx
                (if (<= (tc_core.tc-layout-info-size info) 0)
                  state
                  (lower-store-checked-value-at-offset
                    ctx
                    state
                    (lower-global-shared-view base)
                    offset
                    (ir.compiler-ir-value-seq-ref values index)
                    resolved
                    (tc_core.tc-layout-info-size info)))
                base
                values
                types
                layout
                variant-name
                variant-name-id
                (+ index 1))]
            [(Err message) (Err (box (lower-diagnostic message)))]))))))

(define (lower-literal-payload-supported? [lit : ast.AstLiteral]) : bool
  (match lit
    [(Int _ _) true]
    [(Bool _) true]
    [(Char _) true]
    [(String _) true]
    [_ false]))

(define (lower-enum-type-name-or-empty [ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region ty)
    [(Enum enum-name) (tc_core.tc-nominal-name-id-display enum-name)]
    [(EnumArgs enum-name _) (tc_core.tc-nominal-name-id-display enum-name)]
    [(Var enum-name) (tc_core.tc-nominal-name-id-display enum-name)]
    [(VarArgs enum-name _) (tc_core.tc-nominal-name-id-display enum-name)]
    [_ ""]))

(define (lower-enum-type-name-id-or [ty : (& ty ast.AstType)] [fallback : i64]) : i64
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (match (tc_core.tc-type-strip-region ty)
      [(Enum enum-name) enum-name]
      [(EnumArgs enum-name _) enum-name]
      [(Var enum-name) enum-name]
      [(VarArgs enum-name _) enum-name]
      [_ fallback])))

(define (lower-struct-type-name-or-empty [ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region ty)
    [(Struct struct-name) (tc_core.tc-nominal-name-id-display struct-name)]
    [(StructArgs struct-name _)
      (tc_core.tc-nominal-name-id-display struct-name)]
    [(Var struct-name) (tc_core.tc-nominal-name-id-display struct-name)]
    [(VarArgs struct-name _) (tc_core.tc-nominal-name-id-display struct-name)]
    [_ ""]))

(define (lower-struct-type-name-id-or
  [ty : (& ty ast.AstType)]
  [fallback : i64]) : i64
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (match (tc_core.tc-type-strip-region ty)
      [(Struct struct-name) struct-name]
      [(StructArgs struct-name _) struct-name]
      [(Var struct-name) struct-name]
      [(VarArgs struct-name _) struct-name]
      [_ fallback])))

(define (lower-struct-type-handle-or
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [fallback : i64]) : i64
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
    [name-id : i64 (lower-struct-type-name-id-or ty -1)]
    [direct : i64
      (if (>= name-id 0)
        (csym.compiler-symbols-lookup-type-id-or symbols name-id fallback)
        fallback)]
    (if (csym.compiler-symbols-handle-found? direct)
      direct
      (if (and
        (>= name-id 0)
        (<
          name-id
          (ci.intern-source-name-session-handle-capacity
            (tc_core.tc-context-source-names ctx)))
        (not
          (ci.intern-source-name-session-handle-qualified?
            (tc_core.tc-context-source-names ctx)
            name-id)))
        (csym.compiler-symbols-lookup-type-id-or
          symbols
          (csym.compiler-symbol-module-key-id-by-id
            (tc_core.tc-context-module-id ctx)
            name-id)
          fallback)
        fallback))))

(define (lower-struct-constructor-handle-id-or
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [ty : ast.AstType]
  [fallback : i64]) : i64
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
    [result-handle : i64 (lower-struct-type-handle-or ctx ty fallback)]
    [lookup-handle : i64
      (if (>= lookup-name-id 0)
        (csym.compiler-symbols-lookup-type-id-or
          symbols
          lookup-name-id
          fallback)
        fallback)]
    [direct-handle : i64
      (if (>= raw-name-id 0)
        (csym.compiler-symbols-lookup-type-id-or symbols raw-name-id fallback)
        fallback)]
    [names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (if (>= raw-name-id 0)
        (lower-name-cache-resolve-logical-id (& names) raw-name-id raw-name-id)
        raw-name-id)]
    [logical-handle : i64
      (if (>= logical-id 0)
        (csym.compiler-symbols-lookup-type-id-or symbols logical-id fallback)
        fallback)]
    (cond
      [(csym.compiler-symbols-handle-found? result-handle) result-handle]
      [(csym.compiler-symbols-handle-found? lookup-handle) lookup-handle]
      [(csym.compiler-symbols-handle-found? direct-handle) direct-handle]
      [(csym.compiler-symbols-handle-found? logical-handle) logical-handle]
      [else fallback])))

(define (lower-variant-handle-for-scrut-id-or
  [ctx : tc_core.TcContext]
  [scrut-ty : ast.AstType]
  [variant-name-id : i64]
  [fallback : i64]) : i64
  (match (tc_core.tc-type-strip-region scrut-ty)
    [(Enum enum-name-id)
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [(EnumArgs enum-name-id _)
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [(Var enum-name-id)
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [(VarArgs enum-name-id _)
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [_
      (csym.compiler-registries-lookup-variant-id-or
        (tc_core.tc-context-registries ctx)
        variant-name-id
        fallback)]))

(define (lower-variant-owner-id-for-enum
  [ctx : tc_core.TcContext]
  [enum-name-id : i64]
  [variant-name-id : i64]) : i64
  (let
    [handle : i64
      (tc_core.tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (tc_core.tc-variant-owner-id-or ctx handle enum-name-id)
      enum-name-id)))

(define (lower-variant-handle-name-id-or
  [ctx : tc_core.TcContext]
  [handle : i64]
  [fallback : i64]) : i64
  (match (csym.compiler-registries-variant-name-id-indexed
    (tc_core.tc-context-symbols ctx)
    handle)
    [(option_i64.Some name-id) name-id]
    [(option_i64.None) fallback]))

(define (lower-type-debug-kind [ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region ty)
    [(Enum _) "enum"]
    [(EnumArgs _ _) "enum-args"]
    [(Struct _) "struct"]
    [(StructArgs _ _) "struct-args"]
    [(Var _) "var"]
    [(VarArgs _ _) "var-args"]
    [(Ref _ _) "ref"]
    [(MutRef _ _) "mut-ref"]
    [_ "other"]))

(define (lower-unsupported-match-pattern-message
  [ctx : tc_core.TcContext]
  [scrut-ty : ast.AstType]
  [variant-name : String]) : String
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (lower-global-shared-view scrut-ty)))]
    (str_cat.str-cat
      "lower: unsupported match pattern "
      variant-name
      " in module "
      (tc_core.tc-context-module ctx)
      " raw "
      (lower-type-debug-kind (lower-global-shared-view scrut-ty))
      " "
      (tc_core.tc-type-render scrut-ty)
      " resolved "
      (lower-type-debug-kind (lower-global-shared-view resolved))
      " "
      (tc_core.tc-type-render resolved))))

(define (lower-member-name-base [name : String]) : String
  (let
    [source : String
      (if (tc_core.tc-name-qualified? name)
        (tc_core.tc-qualified-name-base name)
        name)]
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length source)]
    (while (< i n)
      (if (string.char-eq (string.string-ref source i) '.')
        (set! last-dot i)
        unit)
      (set! i (+ i 1)))
    (if (and (>= last-dot 0) (< last-dot (- n 1)))
      (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
      source)))

(define (lower-variant-payload-offset
  [ctx : tc_core.TcContext]
  [enum-id : i64]
  [enum-name : (& enum-name str)]
  [_ : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [resolved : ast.AstType]) : i64
  (if (> (string.string-length enum-name) 0)
    (match (tc_core.tc-inline-aggregate-layout-for-id ctx enum-id)
      [(Ok layout)
        (tc_core.tc-inline-aggregate-layout-variant-payload-offset-id
          layout
          variant-name-id
          index)]
      [(Err _) (- 0 1)])
    (lower-align-up cursor (lower-type-align ctx resolved))))

(define (lower-string-payload-literal-eq
  [state : LowerState]
  [field-value : ir.CompilerIrValue]
  [lit-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state field-value)
    [(Fields field-state field-ptr field-len)
      (match (lower-string-fields field-state lit-value)
        [(Fields done-state lit-ptr lit-len)
          (Ok
            (lower-inline-string-eq-fields
              done-state
              field-ptr
              field-len
              lit-ptr
              lit-len
              (Bool)))])]))

(define (lower-literal-payload-eq
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [field-value : ir.CompilerIrValue]
  [lit : ast.AstLiteral]
  [resolved : ast.AstType]) : ResultLowerExpr
  (match (lower-global-shared-view lit)
    [(String _)
      (if (lower-string-handle-type? ctx (lower-global-shared-view resolved))
        (lower-string-payload-literal-eq
          state
          field-value
          (lower-literal-value-with-type
            (tc_core.tc-context-source-names ctx)
            lit
            resolved))
        (Err
          (box
            (lower-diagnostic
              "lower: unsupported enum payload literal pattern type"))))]
    [_
      (match (lower-state-alloc-var state)
        [(Alloc eq-alloc eq-var)
          (Ok
            (Expr
              (lower-state-emit
                eq-alloc
                (BinOp
                  eq-var
                  Eq
                  field-value
                  (lower-literal-value-with-type
                    (tc_core.tc-context-source-names ctx)
                    lit
                    (lower-global-shared-view resolved))
                  resolved))
              (Var eq-var)
              (Bool)))])]))

(define (lower-box-pattern-name? [name : i64]) : bool
  (string.eq (tc_core.tc-env-key-name-text name) "box"))

(define (lower-bind-irrefutable-box-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [pattern : ast.AstPattern]
  [inner-ty : ast.AstType]) : ResultLowerEnv
  (match pattern
    [(Wildcard) (Ok state env type-env)]
    [(Binding name)
      (match value
        [(Var value-var)
          (Ok
            state
            (sym_i64_env.sym-i64-bind-id env name value-var)
            (tc_core.tc-bind-id type-env name inner-ty))]
        [_
          (Err
            (box (lower-diagnostic "lower: internal box pattern load failed")))])]
    [(Tuple patterns-box)
      (lower-bind-tuple-pattern
        ctx
        state
        env
        type-env
        (Owned)
        value
        inner-ty
        (deref patterns-box))]
    [(Array patterns-box)
      (lower-bind-array-pattern
        ctx
        state
        env
        type-env
        (Owned)
        value
        inner-ty
        (deref patterns-box))]
    [(Variant name args-box)
      (if (lower-box-pattern-name? name)
        (lower-bind-box-pattern
          ctx
          state
          env
          type-env
          value
          inner-ty
          (deref args-box))
        (if (lower-struct-pattern-for-type?
          ctx
          (lower-global-shared-view inner-ty)
          name)
          (lower-bind-struct-pattern
            ctx
            state
            env
            type-env
            value
            (lower-global-shared-view inner-ty)
            (lower-struct-type-name-or-empty
              (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx inner-ty)))
            (deref args-box))
          (Err
            (box (lower-diagnostic "lower: unsupported refutable box pattern")))))]
    [_
      (Err (box (lower-diagnostic "lower: unsupported refutable box pattern")))]))

(define (lower-bind-box-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [box-value : ir.CompilerIrValue]
  [box-ty : ast.AstType]
  [args : ast.AstPatternList]) : ResultLowerEnv
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx box-ty))
    [(Box inner-node)
      (if (= args.len 1)
        (let
          [inner : ast.AstPattern
            (ast.ast-pattern-list-get (& args) 0 (ast.ast-pattern-fallback))]
          [inner-ty : ast.AstType
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx inner-node))]
          (match (lower-load-inline-value-at-offset
            ctx
            state
            box-value
            0
            (lower-global-shared-view inner-ty))
            [(Expr load-state inner-value _)
              (lower-bind-irrefutable-box-value
                ctx
                load-state
                env
                type-env
                inner-value
                inner
                inner-ty)]))
        (Err
          (box
            (lower-diagnostic
              "lower: box pattern expects exactly one inner pattern"))))]
    [_ (Err (box (lower-diagnostic "lower: box pattern requires Box type")))]))

(define (lower-bind-box-variant-payload
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [nested-args : ast.AstPatternList]
  [resolved : ast.AstType]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [rest-patterns : ast.AstPatternList]
  [rest-types : ast.AstTypeList]
  [offset : i64]
  [next-index : i64]
  [next-cursor : i64]
  [fail-label : i64]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view resolved)))
    [(Box _)
      (match (lower-bind-payload-value
        ctx
        state
        (lower-global-shared-view base)
        enum-id
        offset
        (lower-global-shared-view resolved)
        scrut-reg-group?)
        [(Expr field-state field-value _)
          (match (lower-bind-box-pattern
            ctx
            field-state
            env
            type-env
            field-value
            resolved
            nested-args)
            [(Ok box-state box-env box-type-env)
              (lower-bind-variant-payloads
                ctx
                box-state
                box-env
                box-type-env
                (Owned)
                base
                rest-patterns
                rest-types
                mode
                enum-id
                enum-name
                variant-name
                variant-name-id
                next-index
                next-cursor
                fail-label
                scrut-reg-group?)]
            [(Err message) (Err message)])])]
    [_ (Err (box (lower-diagnostic "lower: box pattern requires Box payload")))]))

(define (lower-bind-struct-variant-payload
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [nested-args : ast.AstPatternList]
  [resolved : ast.AstType]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [rest-patterns : ast.AstPatternList]
  [rest-types : ast.AstTypeList]
  [offset : i64]
  [next-index : i64]
  [next-cursor : i64]
  [fail-label : i64]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match (lower-bind-payload-value
    ctx
    state
    (lower-global-shared-view base)
    enum-id
    offset
    (lower-global-shared-view resolved)
    scrut-reg-group?)
    [(Expr field-state field-value _)
      (match (lower-bind-struct-pattern
        ctx
        field-state
        env
        type-env
        field-value
        (lower-global-shared-view resolved)
        (lower-struct-type-name-or-empty
          (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx resolved)))
        nested-args)
        [(Ok struct-state struct-env struct-type-env)
          (lower-bind-variant-payloads
            ctx
            struct-state
            struct-env
            struct-type-env
            (Owned)
            base
            rest-patterns
            rest-types
            mode
            enum-id
            enum-name
            variant-name
            variant-name-id
            next-index
            next-cursor
            fail-label
            scrut-reg-group?)]
        [(Err message) (Err message)])]))

;; How a pattern binds the parts of the value it matches: owned patterns load
;; each part, borrowed ones (a match on a reference) bind references to the parts
;; with the scrutinee borrow's lifetime.
(defenum LowerBindMode
  (Owned)
  (Borrowed i64))

;; An owned payload's value: read out of a register-group scrutinee, or loaded
;; from memory.
(define (lower-bind-payload-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [enum-id : i64]
  [offset : i64]
  [resolved : ast.AstType]
  [scrut-reg-group? : bool]) : LowerExpr
  (if scrut-reg-group?
    (lower-read-register-group-payload
      ctx
      state
      base
      (Enum enum-id)
      offset
      resolved)
    (lower-load-inline-value-at-offset ctx state base offset resolved)))

;; What a name pattern binds to a payload, typed as the binding: the payload's
;; value when owned, a reference to it with the borrow's lifetime when borrowed.
(define (lower-bind-payload-name-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [bind-mode : LowerBindMode]
  [base : ir.CompilerIrValue]
  [enum-id : i64]
  [offset : i64]
  [resolved : ast.AstType]
  [scrut-reg-group? : bool]) : LowerExpr
  (match bind-mode
    [(LowerBindMode.Owned)
      (match (lower-bind-payload-value
        ctx
        state
        base
        enum-id
        offset
        (lower-global-shared-view resolved)
        scrut-reg-group?)
        [(LowerExpr.Expr load-state value _)
          (LowerExpr.Expr load-state value resolved)])]
    [(LowerBindMode.Borrowed borrow-lifetime)
      (let
        [bound-ty : ast.AstType
          (tc_core.tc-borrowed-binding-type
            ctx
            borrow-lifetime
            (lower-global-shared-view resolved))]
        (lower-borrowed-binding-expr ctx state base offset resolved bound-ty))]))

;; A payload name binding. Through a shared reference, a scalar part whose
;; every read in the arm comes before anything that could write memory is a
;; deferred Copy binding: the name holds the part's address (a fresh `Gep`) and
;; each read loads the part there, so an arm path that never reads the name
;; never loads it. A read before any write sees the value the match would have
;; copied.
(define (lower-bind-payload-name
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [bind-mode : LowerBindMode]
  [base : ir.CompilerIrValue]
  [enum-id : i64]
  [offset : i64]
  [resolved : ast.AstType]
  [scrut-reg-group? : bool]
  [name : i64]) : LowerExpr
  (let
    [arm-body : i64 (lower-state-deferred-arm-body state)]
    (if (and
      (>= arm-body 0)
      (lower-deferred-copy-type?
        (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx (lower-global-shared-view resolved))))
      (not
        (lower-deferred-copy-unsafe?
          (lower-deferred-copy-scan ctx arm-body name false))))
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc ptr-state ptr-id)
          (LowerExpr.Expr
            (lower-state-deferred-copy-mark
              (lower-state-emit
                ptr-state
                (ir.CompilerIrInstr.Gep
                  ptr-id
                  base
                  (ir.CompilerIrValue.I64 offset)
                  (ast.AstType.U8)))
              ptr-id)
            (ir.CompilerIrValue.Var ptr-id)
            resolved)])
      (lower-bind-payload-name-value
        ctx
        state
        bind-mode
        base
        enum-id
        offset
        resolved
        scrut-reg-group?))))

;; A scalar that a deferred Copy binding may read from its address at each use.
(define (lower-deferred-copy-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Char) true]
    [_ false]))

;; What `lower-deferred-copy-scan` finds in a subtree, as bits: it reads the
;; name (1), it may write memory (2: a call, a store, or a scope exit that can
;; run cleanup), or it reads the name where a write may already have happened
;; or it uses the name other than by reading its value (4).
(define (lower-deferred-copy-unsafe? [code : i64]) : bool
  (not (= (bit-and code 4) 0)))

(define (lower-deferred-copy-writes? [code : i64]) : bool
  (not (= (bit-and code 2) 0)))

;; Scan an arm body for reads of the bound `name`, in evaluation order, with
;; `written` telling whether something before may have written memory. A form
;; not modeled here counts as a write, and any use of the name inside it as
;; unsafe: taking its address, assigning it, capturing it, a loop.
(define (lower-deferred-copy-scan
  [ctx : tc_core.TcContext]
  [id : i64]
  [name : i64]
  [written : bool]) : i64
  (let
    [expr : ast.AstExpr (lower-context-expr-get ctx id)]
    (match (lower-global-shared-view expr)
      [(ast.AstExpr.Var var) (cond [(not (= var name)) 0] [written 4] [else 1])]
      [(ast.AstExpr.Literal _) 0]
      [(ast.AstExpr.Break) 0]
      [(ast.AstExpr.Continue) 0]
      [(ast.AstExpr.Spanned inner _)
        (lower-deferred-copy-scan ctx inner name written)]
      [(ast.AstExpr.MacroExpansion inner _ _)
        (lower-deferred-copy-scan ctx inner name written)]
      [(ast.AstExpr.Ann inner _)
        (lower-deferred-copy-scan ctx inner name written)]
      [(ast.AstExpr.Cast inner _)
        (lower-deferred-copy-scan ctx inner name written)]
      [(ast.AstExpr.Unary _ inner)
        (lower-deferred-copy-scan ctx inner name written)]
      [(ast.AstExpr.TupleRef inner _)
        (lower-deferred-copy-scan ctx inner name written)]
      [(ast.AstExpr.StructGet inner _)
        (lower-deferred-copy-scan ctx inner name written)]
      [(ast.AstExpr.Return inner)
        (lower-deferred-copy-scan ctx inner name written)]
      [(ast.AstExpr.Try inner)
        (lower-deferred-copy-scan ctx inner name written)]
      [(ast.AstExpr.Binary _ left right)
        (lower-deferred-copy-operand-pair
          (lower-deferred-copy-scan ctx left name written)
          (lower-deferred-copy-scan ctx right name written))]
      [(ast.AstExpr.ArrayRef array index)
        (lower-deferred-copy-operand-pair
          (lower-deferred-copy-scan ctx array name written)
          (lower-deferred-copy-scan ctx index name written))]
      ;; Arguments are read before the call, which may then write.
      [(ast.AstExpr.Call func args)
        (bit-or
          (lower-deferred-copy-operand-pair
            (lower-deferred-copy-scan ctx func name written)
            (lower-deferred-copy-scan-operands ctx (& args) 0 name written 0))
          2)]
      [(ast.AstExpr.If cond then-branch else-branch)
        (let
          [cond-code : i64 (lower-deferred-copy-scan ctx cond name written)]
          [after : bool (or written (lower-deferred-copy-writes? cond-code))]
          (bit-or
            cond-code
            (bit-or
              (lower-deferred-copy-scan ctx then-branch name after)
              (lower-deferred-copy-scan ctx else-branch name after))))]
      [(ast.AstExpr.Begin items)
        (lower-deferred-copy-scan-sequence ctx (& items) 0 name written 0)]
      [(ast.AstExpr.Unsafe items)
        (lower-deferred-copy-scan-sequence ctx (& items) 0 name written 0)]
      ;; Leaving a `let` or `match` scope can run a binding's cleanup.
      [(ast.AstExpr.Let let-box)
        (match (__tl-box-place let-box)
          [(ast.AstLet.Let bindings body)
            (let
              [inits : i64
                (lower-deferred-copy-scan-let-inits
                  ctx
                  (& bindings)
                  0
                  name
                  written
                  0)]
              (bit-or
                (bit-or
                  inits
                  (lower-deferred-copy-scan
                    ctx
                    body
                    name
                    (or written (lower-deferred-copy-writes? inits))))
                2))])]
      [(ast.AstExpr.Match match-box)
        (match (__tl-box-place match-box)
          [(ast.AstMatch.Match scrutinee arms)
            (let
              [scrutinee-code : i64
                (lower-deferred-copy-scan ctx scrutinee name written)]
              (bit-or
                (bit-or
                  scrutinee-code
                  (lower-deferred-copy-scan-arms
                    ctx
                    (& arms)
                    0
                    name
                    (or written (lower-deferred-copy-writes? scrutinee-code))
                    0))
                2))])]
      [_
        (if (lower-deferred-copy-mentions?
          ctx
          (lower-global-shared-view expr)
          name)
          4
          2)])))

;; Two operands scanned from the same point, in an order not modeled: a read
;; in one is unsafe when the other may write.
(define (lower-deferred-copy-operand-pair [first : i64] [second : i64]) : i64
  (if (or
    (and (= (bit-and first 1) 1) (lower-deferred-copy-writes? second))
    (and (= (bit-and second 1) 1) (lower-deferred-copy-writes? first)))
    4
    (bit-or first second)))

;; Call arguments, as pairwise operands: `seen` joins the codes of the earlier
;; arguments.
(define (lower-deferred-copy-scan-operands
  [ctx : tc_core.TcContext]
  [items : (& items ast.AstExprList)]
  [index : i64]
  [name : i64]
  [written : bool]
  [seen : i64]) : i64
  (if (or (>= index items.len) (lower-deferred-copy-unsafe? seen))
    seen
    (lower-deferred-copy-scan-operands
      ctx
      items
      (+ index 1)
      name
      written
      (lower-deferred-copy-operand-pair
        seen
        (lower-deferred-copy-scan
          ctx
          (ast.ast-expr-list-get items index 0)
          name
          written)))))

(define (lower-deferred-copy-scan-sequence
  [ctx : tc_core.TcContext]
  [items : (& items ast.AstExprList)]
  [index : i64]
  [name : i64]
  [written : bool]
  [code : i64]) : i64
  (if (or (>= index items.len) (lower-deferred-copy-unsafe? code))
    code
    (let
      [item : i64
        (lower-deferred-copy-scan
          ctx
          (ast.ast-expr-list-get items index 0)
          name
          written)]
      (lower-deferred-copy-scan-sequence
        ctx
        items
        (+ index 1)
        name
        (or written (lower-deferred-copy-writes? item))
        (bit-or code item)))))

(define (lower-deferred-copy-scan-let-inits
  [ctx : tc_core.TcContext]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [name : i64]
  [written : bool]
  [code : i64]) : i64
  (if (or
    (>= index (ast.ast-let-binding-list-len bindings))
    (lower-deferred-copy-unsafe? code))
    code
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ init)
        (let
          [item : i64 (lower-deferred-copy-scan ctx init name written)]
          (lower-deferred-copy-scan-let-inits
            ctx
            bindings
            (+ index 1)
            name
            (or written (lower-deferred-copy-writes? item))
            (bit-or code item)))])))

(define (lower-deferred-copy-scan-arms
  [ctx : tc_core.TcContext]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [name : i64]
  [written : bool]
  [code : i64]) : i64
  (if (or (>= index arms.len) (lower-deferred-copy-unsafe? code))
    code
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body)
        (lower-deferred-copy-scan-arms
          ctx
          arms
          (+ index 1)
          name
          written
          (bit-or code (lower-deferred-copy-scan ctx body name written)))])))

(define (lower-deferred-copy-mentions?
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]
  [name : i64]) : bool
  (match (lower-global-shared-view expr)
    [(ast.AstExpr.Var var) (= var name)]
    [_
      (let
        [children : ast.AstExprList (ast.ast-expr-child-ids expr)]
        [index : i64 0]
        [found : bool false]
        (while (and (not found) (< index children.len))
          (when
            (lower-deferred-copy-mentions?
              ctx
              (lower-context-expr-get
                ctx
                (ast.ast-expr-list-get (& children) index -1))
              name)
            (set! found true))
          (set! index (+ index 1)))
        found)]))

;; A tuple or fixed-array payload for its element patterns: the loaded value
;; when owned, the payload's address when borrowed.
(define (lower-bind-payload-aggregate
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [bind-mode : LowerBindMode]
  [base : ir.CompilerIrValue]
  [enum-id : i64]
  [offset : i64]
  [resolved : ast.AstType]
  [scrut-reg-group? : bool]) : LowerExpr
  (match bind-mode
    [(Owned)
      (lower-bind-payload-value
        ctx
        state
        base
        enum-id
        offset
        resolved
        scrut-reg-group?)]
    [(Borrowed _) (lower-gep-byte state base offset)]))

(define (lower-bind-variant-payloads
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bind-mode : LowerBindMode]
  [base : ir.CompilerIrValue]
  [patterns : ast.AstPatternList]
  [types : ast.AstTypeList]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [fail-label : i64]
  ;; Whether the scrutinee enum is a 2-word register-group value, computed
  ;; ONCE by the caller and threaded here. Recomputing it per payload field (a full
  ;; transient layout rebuild) at every binding site across the whole compiler was
  ;; heavy enough to overflow the per-function scratch arena into a second chunk
  ;; and trip its rewind, corrupting later lowering. Always false when borrowed:
  ;; a borrowed scrutinee is matched behind a pointer.
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (if (ast.ast-pattern-list-empty? (& patterns))
    (if (ast.ast-type-list-empty? (& types))
      (Ok state env type-env)
      (Err
        (box (lower-diagnostic "lower: enum payload pattern arity mismatch"))))
    (let
      [pattern : ast.AstPattern
        (ast.ast-pattern-list-get (& patterns) 0 (ast.ast-pattern-fallback))]
      [rest-patterns : ast.AstPatternList (ast.ast-pattern-list-tail patterns)]
      (if (ast.ast-type-list-empty? (& types))
        (Err
          (box (lower-diagnostic "lower: enum payload pattern arity mismatch")))
        (let
          [ty-id : i64
            (ast.ast-type-list-get (& types) 0 (ast.ast-type-id-fallback))]
          [rest-types : ast.AstTypeList (ast.ast-type-list-slice types 1)]
          [ty : ast.AstType (tc_core.tc-context-type-get ctx ty-id)]
          [field-ctx : tc_core.TcContext
            (tc_core.tc-context-with-owner-name-module
              ctx
              (lower-variant-owner-id-for-enum ctx enum-id variant-name-id))]
          [resolved : ast.AstType (tc_core.tc-resolve-type field-ctx ty)]
          [default-offset : i64
            (lower-align-up cursor (lower-type-align ctx resolved))]
          [offset : i64
            (lower-variant-payload-offset
              ctx
              enum-id
              enum-name
              (lower-global-shared-view variant-name)
              variant-name-id
              index
              cursor
              (lower-global-shared-view resolved))]
          [next-cursor : i64 (+ default-offset (lower-type-size ctx resolved))]
          [next-index : i64 (+ index 1)]
          (if (< offset 0)
            (Err
              (box
                (lower-diagnostic
                  (str_cat.str-cat
                    "lower: inline enum layout missing payload for "
                    variant-name))))
            (match pattern
              [(Wildcard)
                (lower-bind-variant-payloads
                  ctx
                  state
                  env
                  type-env
                  bind-mode
                  base
                  rest-patterns
                  rest-types
                  mode
                  enum-id
                  enum-name
                  variant-name
                  variant-name-id
                  next-index
                  next-cursor
                  fail-label
                  scrut-reg-group?)]
              [(Binding name)
                (match (lower-bind-payload-name
                  ctx
                  state
                  bind-mode
                  (lower-global-shared-view base)
                  enum-id
                  offset
                  resolved
                  scrut-reg-group?
                  name)
                  [(Expr bound-state bound-value bound-ty)
                    (match bound-value
                      [(Var field-var)
                        (lower-bind-variant-payloads
                          ctx
                          bound-state
                          (sym_i64_env.sym-i64-bind-id env name field-var)
                          (tc_core.tc-bind-id type-env name bound-ty)
                          bind-mode
                          base
                          rest-patterns
                          rest-types
                          mode
                          enum-id
                          enum-name
                          variant-name
                          variant-name-id
                          next-index
                          next-cursor
                          fail-label
                          scrut-reg-group?)]
                      [_
                        (Err
                          (box
                            (lower-diagnostic
                              (lower-bind-payload-name-failure bind-mode))))])])]
              [(Var name _)
                (match (lower-bind-payload-name
                  ctx
                  state
                  bind-mode
                  (lower-global-shared-view base)
                  enum-id
                  offset
                  resolved
                  scrut-reg-group?
                  name)
                  [(Expr bound-state bound-value bound-ty)
                    (match bound-value
                      [(Var field-var)
                        (lower-bind-variant-payloads
                          ctx
                          bound-state
                          (sym_i64_env.sym-i64-bind-id env name field-var)
                          (tc_core.tc-bind-id type-env name bound-ty)
                          bind-mode
                          base
                          rest-patterns
                          rest-types
                          mode
                          enum-id
                          enum-name
                          variant-name
                          variant-name-id
                          next-index
                          next-cursor
                          fail-label
                          scrut-reg-group?)]
                      [_
                        (Err
                          (box
                            (lower-diagnostic
                              (lower-bind-payload-name-failure bind-mode))))])])]
              [(Tuple patterns-box)
                (match (lower-bind-payload-aggregate
                  ctx
                  state
                  bind-mode
                  (lower-global-shared-view base)
                  enum-id
                  offset
                  (lower-global-shared-view resolved)
                  scrut-reg-group?)
                  [(Expr field-state field-value _)
                    (match (lower-bind-tuple-pattern
                      ctx
                      field-state
                      env
                      type-env
                      bind-mode
                      field-value
                      resolved
                      (deref patterns-box))
                      [(Ok tuple-state tuple-env tuple-type-env)
                        (lower-bind-variant-payloads
                          ctx
                          tuple-state
                          tuple-env
                          tuple-type-env
                          bind-mode
                          base
                          rest-patterns
                          rest-types
                          mode
                          enum-id
                          enum-name
                          variant-name
                          variant-name-id
                          next-index
                          next-cursor
                          fail-label
                          scrut-reg-group?)]
                      [(Err message) (Err message)])])]
              [(Array patterns-box)
                (match (lower-bind-payload-aggregate
                  ctx
                  state
                  bind-mode
                  (lower-global-shared-view base)
                  enum-id
                  offset
                  (lower-global-shared-view resolved)
                  scrut-reg-group?)
                  [(Expr field-state field-value _)
                    (match (lower-bind-array-pattern
                      ctx
                      field-state
                      env
                      type-env
                      bind-mode
                      field-value
                      resolved
                      (deref patterns-box))
                      [(Ok array-state array-env array-type-env)
                        (lower-bind-variant-payloads
                          ctx
                          array-state
                          array-env
                          array-type-env
                          bind-mode
                          base
                          rest-patterns
                          rest-types
                          mode
                          enum-id
                          enum-name
                          variant-name
                          variant-name-id
                          next-index
                          next-cursor
                          fail-label
                          scrut-reg-group?)]
                      [(Err message) (Err message)])])]
              ;; A borrowed Slice payload is a two-word view, read by value
              ;; even through a borrowed enum; its slice pattern tests the
              ;; length and branches to `fail-label` like a nested variant.
              [(Slice items-box has-rest)
                (match (lower-bind-payload-value
                  ctx
                  state
                  (lower-global-shared-view base)
                  enum-id
                  offset
                  (lower-global-shared-view resolved)
                  scrut-reg-group?)
                  [(Expr view-state view-value _)
                    (match (lower-bind-slice-pattern
                      ctx
                      view-state
                      env
                      type-env
                      view-value
                      (lower-global-shared-view resolved)
                      (deref items-box)
                      has-rest
                      mode
                      fail-label
                      true)
                      [(Ok slice-state slice-env slice-type-env)
                        (lower-bind-variant-payloads
                          ctx
                          slice-state
                          slice-env
                          slice-type-env
                          bind-mode
                          base
                          rest-patterns
                          rest-types
                          mode
                          enum-id
                          enum-name
                          variant-name
                          variant-name-id
                          next-index
                          next-cursor
                          fail-label
                          scrut-reg-group?)]
                      [(Err message) (Err message)])])]
              [(Literal lit)
                (if (lower-literal-payload-supported?
                  (lower-global-shared-view lit))
                  (match (if scrut-reg-group?
                    (lower-read-register-group-payload
                      ctx
                      state
                      (lower-global-shared-view base)
                      (Enum enum-id)
                      offset
                      (lower-global-shared-view resolved))
                    (lower-load-at-offset
                      state
                      base
                      offset
                      (lower-global-shared-view resolved)))
                    [(Expr load-state field-value _)
                      (let
                        [lowered-eq
                          (try
                            (lower-literal-payload-eq
                              ctx
                              load-state
                              field-value
                              lit
                              resolved))]
                        (match lowered-eq
                          [(Expr eq-state eq-value _)
                            (match (lower-state-fresh-label
                              eq-state
                              "payload_ok")
                              [(Label ok-state ok-label)
                                (lower-bind-variant-payloads
                                  ctx
                                  (lower-state-finish-block
                                    (lower-state-emit
                                      ok-state
                                      (Branch eq-value ok-label fail-label))
                                    ok-label)
                                  env
                                  type-env
                                  bind-mode
                                  base
                                  rest-patterns
                                  rest-types
                                  mode
                                  enum-id
                                  enum-name
                                  variant-name
                                  variant-name-id
                                  next-index
                                  next-cursor
                                  fail-label
                                  scrut-reg-group?)])]))])
                  (Err
                    (box
                      (lower-diagnostic
                        "lower: unsupported enum payload literal pattern type"))))]
              [(Variant nested-name nested-args-box)
                ;; Refutable nested variant payloads test the loaded enum tag
                ;; and branch to `fail-label` on mismatch. An owned `(box ...)`
                ;; payload pattern is irrefutable here; it loads the boxed value
                ;; and binds the inner pattern, as an owned struct pattern binds
                ;; its fields.
                (let
                  [nested-name-str : String
                    (tc_core.tc-env-key-name-text nested-name)]
                  [nested-args : ast.AstPatternList (deref nested-args-box)]
                  [owned? : bool
                    (match bind-mode
                      [(Owned) true]
                      [(Borrowed _) false])]
                  (cond
                    [(and owned? (lower-box-pattern-name? nested-name))
                      (lower-bind-box-variant-payload
                        ctx
                        state
                        env
                        type-env
                        base
                        nested-args
                        resolved
                        mode
                        enum-id
                        enum-name
                        variant-name
                        variant-name-id
                        rest-patterns
                        rest-types
                        offset
                        next-index
                        next-cursor
                        fail-label
                        scrut-reg-group?)]
                    [(and
                        owned?
                        (lower-struct-pattern-for-type?
                          ctx
                          (lower-global-shared-view resolved)
                          nested-name))
                      (lower-bind-struct-variant-payload
                        ctx
                        state
                        env
                        type-env
                        base
                        nested-args
                        resolved
                        mode
                        enum-id
                        enum-name
                        variant-name
                        variant-name-id
                        rest-patterns
                        rest-types
                        offset
                        next-index
                        next-cursor
                        fail-label
                        scrut-reg-group?)]
                    [else
                      (let
                        [symbols : (& ctx csym.CompilerSymbols)
                          (tc_core.tc-context-symbols ctx)]
                        [handle : i64
                          (lower-variant-handle-for-scrut-id-or
                            ctx
                            (lower-global-shared-view resolved)
                            nested-name
                            (csym.compiler-symbols-missing-handle))]
                        (if (not (csym.compiler-symbols-handle-found? handle))
                          (Err
                            (box
                              (lower-diagnostic
                                (str_cat.str-cat
                                  "lower: unknown nested variant "
                                  nested-name-str))))
                          (match (csym.compiler-registries-variant-fields-indexed
                            symbols
                            handle)
                            [(Err message)
                              (Err (box (lower-diagnostic message)))]
                            [(Ok nested-fields)
                              (match (lower-load-inline-value-at-offset
                                ctx
                                state
                                (lower-global-shared-view base)
                                offset
                                (lower-global-shared-view resolved))
                                [(Expr field-state field-value _)
                                  ;; For a register-resident enum field the
                                  ;; loaded value IS the tag word; for a memory
                                  ;; enum it is a pointer to the field, so the
                                  ;; tag is loaded from offset 0. Dereferencing
                                  ;; a register-resident tag word would fault
                                  ;; (it is a small integer, not an address).
                                  (match (if (lower-type-register-resident?
                                    ctx
                                    (lower-global-shared-view resolved))
                                    (Expr
                                      field-state
                                      (lower-global-shared-view field-value)
                                      (I64))
                                    (lower-load-at-offset
                                      field-state
                                      field-value
                                      0
                                      (I64)))
                                    [(Expr tag-state tag-value _)
                                      (match (lower-state-alloc-var tag-state)
                                        [(Alloc eq-alloc eq-var)
                                          (match (lower-state-fresh-label
                                            (lower-state-emit
                                              eq-alloc
                                              (BinOp
                                                eq-var
                                                Eq
                                                tag-value
                                                (I64
                                                  (csym.compiler-registry-handle-child-index
                                                    handle))
                                                (I64)))
                                            "payload_ok")
                                            [(Label ok-state ok-label)
                                              (match (lower-bind-variant-payloads
                                                ctx
                                                (lower-state-finish-block
                                                  (lower-state-emit
                                                    ok-state
                                                    (Branch
                                                      (Var eq-var)
                                                      ok-label
                                                      fail-label))
                                                  ok-label)
                                                env
                                                type-env
                                                bind-mode
                                                field-value
                                                nested-args
                                                nested-fields
                                                mode
                                                (lower-enum-type-name-id-or
                                                  resolved
                                                  -1)
                                                (lower-enum-type-name-or-empty
                                                  (lower-global-shared-view
                                                    resolved))
                                                nested-name-str
                                                (lower-variant-handle-name-id-or
                                                  ctx
                                                  handle
                                                  nested-name)
                                                0
                                                8
                                                fail-label
                                                ;; nested enum: rare path, so
                                                ;; computing its group-ness
                                                ;; once here is cheap.
                                                (match bind-mode
                                                  [(Owned)
                                                    (lower-type-register-group?
                                                      ctx
                                                      resolved)]
                                                  [(Borrowed _) false]))
                                                [(Ok
                                                    nested-state
                                                    nested-env
                                                    nested-type-env)
                                                  (lower-bind-variant-payloads
                                                    ctx
                                                    nested-state
                                                    nested-env
                                                    nested-type-env
                                                    bind-mode
                                                    base
                                                    rest-patterns
                                                    rest-types
                                                    mode
                                                    enum-id
                                                    enum-name
                                                    variant-name
                                                    variant-name-id
                                                    next-index
                                                    next-cursor
                                                    fail-label
                                                    scrut-reg-group?)]
                                                [(Err message) (Err message)])])])])])])))]))]
              [_
                (Err
                  (box
                    (lower-diagnostic "lower: unsupported enum payload pattern")))])))))))

;; The element patterns of a slice pattern, without its rest item.
(define (lower-slice-pattern-elements
  [items : (& items ast.AstPatternList)]
  [count : i64]) : ast.AstPatternList
  (let
    [out : ast.AstPatternList (ast.ast-pattern-list-with-capacity count)]
    [index : i64 0]
    (while (< index count)
      (ast.ast-pattern-list-push
        (&mut out)
        (ast.ast-pattern-list-get items index (ast.ast-pattern-fallback)))
      (set! index (+ index 1)))
    out))

;; Binds a name to the address of element `index`, typed `ref-ty`.
(define (lower-bind-slice-element-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [data-ptr : ir.CompilerIrValue]
  [index : i64]
  [elem-ty : ast.AstType]
  [name : i64]
  [ref-ty : ast.AstType]) : ResultLowerEnv
  (match (lower-gep-byte state data-ptr (* index (lower-type-size ctx elem-ty)))
    [(Expr addr-state (Var addr-var) _)
      (Ok
        addr-state
        (sym_i64_env.sym-i64-bind-id env name addr-var)
        (tc_core.tc-bind-id type-env name ref-ty))]
    [_
      (Err
        (box (lower-diagnostic "lower: internal slice element address failed")))]))

;; A mutable view binds each non-Copy element named by the pattern as a `&mut`
;; reference to its storage; typecheck admits only names and `_` there.
(define (lower-bind-slice-mut-elements-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [data-ptr : ir.CompilerIrValue]
  [items : (& items ast.AstPatternList)]
  [count : i64]
  [lifetime : i64]
  [elem-ty : ast.AstType]
  [index : i64]) : ResultLowerEnv
  (if (>= index count)
    (Ok state env type-env)
    (let
      [name : i64
        (match (ast.ast-pattern-list-get items index (ast.ast-pattern-fallback))
          [(Binding name) name]
          [(Var name _) name]
          [(Wildcard) -1]
          [_ -2])]
      (cond
        [(= name -1)
          (lower-bind-slice-mut-elements-at
            ctx
            state
            env
            type-env
            data-ptr
            items
            count
            lifetime
            elem-ty
            (+ index 1))]
        [(= name -2)
          (Err
            (box
              (lower-diagnostic
                "lower: unsupported mutable slice element pattern")))]
        [else
          (match (lower-bind-slice-element-address
            ctx
            state
            env
            type-env
            (lower-global-shared-view data-ptr)
            index
            (lower-global-shared-view elem-ty)
            name
            (ast.ast-ty-mut-ref
              lifetime
              (tc_core.tc-type-without-regions
                (lower-global-shared-view elem-ty))))
            [(Ok next-state next-env next-type-env)
              (lower-bind-slice-mut-elements-at
                ctx
                next-state
                next-env
                next-type-env
                data-ptr
                items
                count
                lifetime
                elem-ty
                (+ index 1))]
            [(Err message) (Err message)])]))))

;; Binds `rest` to the view past the first `count` elements: the data pointer
;; advanced by `count` elements and the length less `count`, with no copy.
(define (lower-bind-slice-rest
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [data-ptr : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [count : i64]
  [rest : ast.AstPattern]
  [rest-ty : ast.AstType]
  [elem-ty : ast.AstType]) : ResultLowerEnv
  (let
    [name : i64
      (match rest
        [(Binding name) name]
        [(Var name _) name]
        [_ -1])]
    [offset : i64 (* count (lower-type-size ctx elem-ty))]
    (if (< name 0)
      (Ok state env type-env)
      (match (if (= offset 0)
        (Expr state data-ptr (U64))
        (lower-gep-byte state data-ptr offset))
        [(Expr ptr-state rest-ptr _)
          (match (if (= count 0)
            (Expr ptr-state len (I64))
            (lower-emit-binop ptr-state Sub len (I64 count) (I64)))
            [(Expr len-state rest-len _)
              (match (lower-slice-view-pack
                len-state
                rest-ptr
                rest-len
                (lower-global-shared-view rest-ty))
                [(Expr pack-state (Var rest-var) _)
                  (Ok
                    pack-state
                    (sym_i64_env.sym-i64-bind-id env name rest-var)
                    (tc_core.tc-bind-id type-env name rest-ty))]
                [_
                  (Err
                    (box
                      (lower-diagnostic
                        "lower: internal slice rest view failed")))])])]))))

;; Emits the one length comparison of a slice arm: `len = count`, or
;; `len >= count` with a rest binding, branching to `fail-label` when false.
(define (lower-slice-length-test
  [state : LowerState]
  [len : ir.CompilerIrValue]
  [count : i64]
  [has-rest : bool]
  [fail-label : i64]) : LowerState
  (match (lower-emit-binop
    state
    (if has-rest
      Ge
      Eq)
    len
    (I64 count)
    (I64))
    [(Expr cmp-state len-ok _)
      (match (lower-state-fresh-label cmp-state "slice_len_ok")
        [(Label label-state ok-label)
          (lower-state-finish-block
            (lower-state-emit label-state (Branch len-ok ok-label fail-label))
            ok-label)])]))

;; Binds the element patterns of a slice arm. Copy elements bind by value and
;; other elements by reference through the payload binder: its sequential
;; layout (an empty enum name) places element i at i * size.
(define (lower-bind-slice-elements
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [data-ptr : ir.CompilerIrValue]
  [items : (& items ast.AstPatternList)]
  [count : i64]
  [lifetime : i64]
  [mutable : bool]
  [elem-ty : ast.AstType]
  [mode : CompilerLowerMode]
  [fail-label : i64]) : ResultLowerEnv
  (let
    [copyable : bool
      (tc_core.tc-type-copyable? ctx (lower-global-shared-view elem-ty))]
    (if (and mutable (not copyable))
      (lower-bind-slice-mut-elements-at
        ctx
        state
        env
        type-env
        data-ptr
        items
        count
        lifetime
        elem-ty
        0)
      (let
        [elem-id : i64
          (ast.ast-node-pool-context-type-push
            (tc_core.tc-context-pools ctx)
            (lower-global-shared-view elem-ty))]
        [types : ast.AstTypeList (ast.ast-type-list-with-capacity count)]
        [index : i64 0]
        (while (< index count)
          (ast.ast-type-list-push (&mut types) elem-id)
          (set! index (+ index 1)))
        (lower-bind-variant-payloads
          ctx
          state
          env
          type-env
          (if copyable
            (Owned)
            (Borrowed lifetime))
          data-ptr
          (lower-slice-pattern-elements items count)
          types
          mode
          -1
          ""
          "slice"
          -1
          0
          0
          fail-label
          false)))))

;; Tests and binds `(slice p1 ... pk [& rest])` against a borrowed view
;; (SPEC 5.13): one length comparison, then the element loads, and `rest` as a
;; pointer and length. The comparison is skipped when `test?` is false (an
;; exhaustive final arm) and for a borrowed fixed array, whose length
;; typecheck already matched.
(define (lower-bind-slice-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [items : ast.AstPatternList]
  [has-rest : bool]
  [mode : CompilerLowerMode]
  [fail-label : i64]
  [test? : bool]) : ResultLowerEnv
  (match (tc_core.tc-slice-pattern-scrutinee
    ctx
    (lower-global-shared-view scrut-ty))
    [(View lifetime mutable elem-ty array-length)
      (let
        [count : i64
          (tc_core.tc-slice-pattern-element-count (& items) has-rest)]
        (match (if (>= array-length 0)
          (lower-slice-view-static-source-fields
            state
            scrut-value
            scrut-ty
            (lower-global-shared-view elem-ty)
            array-length)
          (lower-slice-view-reference-slice-fields
            ctx
            state
            scrut-value
            scrut-ty
            (lower-global-shared-view elem-ty)))
          [(Ok (Fields fields-state data-ptr len _))
            (match (lower-bind-slice-elements
              ctx
              (if (and test? (< array-length 0))
                (lower-slice-length-test
                  fields-state
                  (lower-global-shared-view len)
                  count
                  has-rest
                  fail-label)
                fields-state)
              env
              type-env
              (lower-global-shared-view data-ptr)
              (& items)
              count
              lifetime
              mutable
              (lower-global-shared-view elem-ty)
              mode
              fail-label)
              [(Ok elements-state elements-env elements-type-env)
                (if has-rest
                  (lower-bind-slice-rest
                    ctx
                    elements-state
                    elements-env
                    elements-type-env
                    data-ptr
                    len
                    count
                    (ast.ast-pattern-list-get
                      (& items)
                      count
                      (ast.ast-pattern-fallback))
                    (tc_core.tc-slice-pattern-rest-type
                      ctx
                      lifetime
                      mutable
                      (lower-global-shared-view elem-ty))
                    elem-ty)
                  (Ok elements-state elements-env elements-type-env))]
              [(Err message) (Err message)])]
          [(Err message) (Err message)]))]
    [(Invalid)
      (Err
        (box
          (lower-diagnostic
            "lower: slice pattern requires a borrowed Slice or fixed-array scrutinee")))]))

(define (lower-bind-payload-name-failure [bind-mode : LowerBindMode]) : String
  (match bind-mode
    [(Owned) "lower: internal enum payload load failed"]
    [(Borrowed _) "lower: internal borrowed enum payload reference failed"]))

(define (lower-borrowed-payload-ref-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [field-ty : ast.AstType]
  [ref-ty : ast.AstType]) : LowerExpr
  ;; Enum payload aggregates are stored inline in the enum slot. Borrowing a
  ;; tuple, fixed array, struct, or enum payload therefore takes the payload's
  ;; address even when that aggregate is normally represented by a pointer.
  (if (lower-str-ref-type? ctx (lower-global-shared-view ref-ty))
    (let
      [loaded : LowerExpr (lower-load-at-offset state base offset field-ty)]
      (match loaded
        [(Expr loaded-state value _) (Expr loaded-state value ref-ty)]))
    (match (lower-gep-byte state base offset)
      [(Expr ptr-state ptr _) (Expr ptr-state ptr ref-ty)])))

;; A Copy part read by value out of borrowed storage. An inline memory aggregate
;; is copied into fresh storage so the binding does not alias the scrutinee.
(define (lower-copy-inline-value-at-offset
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-load-inline-value-at-offset
    ctx
    state
    base
    offset
    (lower-global-shared-view ty))
    [(LowerExpr.Expr load-state value _)
      (if (and
        (lower-type-inline-storage? ctx ty)
        (not (lower-type-register-resident? ctx (lower-global-shared-view ty))))
        (let
          [size : i64 (lower-type-size ctx ty)]
          (match (lower-reserve-inline-storage
            load-state
            (if (= size 0)
              1
              size)
            ty)
            [(LowerExpr.Expr copy-state copy-value _)
              (LowerExpr.Expr
                (lower-copy-bytes-compact
                  copy-state
                  (lower-global-shared-view copy-value)
                  0
                  value
                  0
                  size)
                copy-value
                ty)]))
        (LowerExpr.Expr load-state value ty))]))

;; What a name pattern binds to a part matched through a shared reference, typed
;; by `tc-borrowed-binding-type`: a Copy part's value, a `(Box T)` part's boxed
;; storage, and otherwise the part's address (a `String` as its `str` view).
(define (lower-borrowed-binding-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [field-ty : ast.AstType]
  [bound-ty : ast.AstType]) : LowerExpr
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (lower-global-shared-view field-ty)))]
    (match (lower-global-shared-view resolved)
      [(ast.AstType.Box inner-id)
        (match (lower-load-at-offset state base offset resolved)
          [(LowerExpr.Expr box-state box-ptr _)
            (lower-borrowed-payload-ref-expr
              ctx
              box-state
              box-ptr
              0
              (tc_core.tc-type-without-regions
                (tc_core.tc-resolve-type
                  ctx
                  (tc_core.tc-context-type-get ctx inner-id)))
              bound-ty)])]
      [_
        (if (tc_core.tc-borrowed-binding-by-value?
          ctx
          (lower-global-shared-view field-ty))
          (match (lower-copy-inline-value-at-offset
            ctx
            state
            base
            offset
            (lower-global-shared-view resolved))
            [(LowerExpr.Expr copy-state value _)
              (LowerExpr.Expr copy-state value bound-ty)])
          (lower-borrowed-payload-ref-expr
            ctx
            state
            base
            offset
            field-ty
            bound-ty))])))

(define (lower-bind-match-variant-payloads
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [base : ir.CompilerIrValue]
  [patterns : ast.AstPatternList]
  [types : ast.AstTypeList]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [fail-label : i64]
  [scrut-reg-group? : bool]
  ;; The arm body, the scope of the bindings (`lower-bind-payload-name`).
  [body-id : i64]) : ResultLowerEnv
  (match borrow-lifetime
    [(No)
      (lower-bind-variant-payloads
        ctx
        state
        env
        type-env
        (Owned)
        base
        patterns
        types
        mode
        enum-id
        enum-name
        variant-name
        variant-name-id
        index
        cursor
        fail-label
        scrut-reg-group?)]
    [(Some lifetime)
      ;; A borrowed scrutinee is always memory-backed (matched behind a pointer),
      ;; never a 2-word register-group value, so the register-group path does not
      ;; apply here.
      (let
        [outer-arm-body : i64 (lower-state-deferred-arm-body state)]
        (lower-state-set-deferred-arm-body! state body-id)
        (let
          [bound : ResultLowerEnv
            (lower-bind-variant-payloads
              ctx
              state
              env
              type-env
              (Borrowed lifetime)
              base
              patterns
              types
              mode
              enum-id
              enum-name
              variant-name
              variant-name-id
              index
              cursor
              fail-label
              false)]
          (lower-state-set-deferred-arm-body! state outer-arm-body)
          bound))]))

;; A payload subpattern is refutable when it can fail to match at run time.
;; Literals, nested enum variants and slice patterns with a length test are
;; refutable; `(box ...)` follows its inner pattern, while binding, var,
;; wildcard, and tuple patterns always match.
(define (lower-pattern-refutable? [pattern : ast.AstPattern]) : bool
  (match pattern
    [(Literal _) true]
    [(Variant name args-box)
      (if (lower-box-pattern-name? name)
        (lower-pattern-list-refutable? (deref args-box))
        true)]
    [(Slice items-box has-rest)
      (let
        [items : ast.AstPatternList (deref items-box)]
        (or
          (not has-rest)
          (> items.len 1)
          (lower-pattern-list-refutable? items)))]
    [_ false]))

(define (lower-pattern-list-refutable? [patterns : ast.AstPatternList]) : bool
  (lower-pattern-list-refutable-at? (& patterns) 0))

(define (lower-pattern-list-refutable-at?
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]) : bool
  (if (>= index patterns.len)
    false
    (if (lower-pattern-refutable?
      (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback)))
      true
      (lower-pattern-list-refutable-at? patterns (+ index 1)))))

(define (lower-pattern-refutable-for-type?
  [ctx : tc_core.TcContext]
  [pattern : ast.AstPattern]
  [ty : ast.AstType]) : bool
  (match pattern
    [(Wildcard) false]
    [(Var _ _) false]
    [(Binding _) false]
    [(Tuple _) false]
    [(Array _) false]
    [(Literal _) true]
    [(Slice items-box has-rest)
      (not
        (tc_core.tc-slice-pattern-irrefutable?
          ctx
          (deref items-box)
          has-rest
          ty))]
    [(Variant name args-box)
      (let
        [args : ast.AstPatternList (deref args-box)]
        (if (lower-box-pattern-name? name)
          (lower-pattern-list-refutable? args)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx (lower-global-shared-view ty)))
            [(Struct struct-name)
              (not
                (tc_core.tc-struct-pattern-irrefutable?
                  ctx
                  (tc_core.tc-nominal-name-id-display struct-name)
                  struct-name
                  ty
                  (tc_core.tc-env-key-name-text name)
                  name
                  args))]
            [(StructArgs struct-name _)
              (not
                (tc_core.tc-struct-pattern-irrefutable?
                  ctx
                  (tc_core.tc-nominal-name-id-display struct-name)
                  struct-name
                  ty
                  (tc_core.tc-env-key-name-text name)
                  name
                  args))]
            [_ true])))]))

(define (lower-pattern-list-refutable-for-types?
  [ctx : tc_core.TcContext]
  [patterns : (& patterns ast.AstPatternList)]
  [types : (& types ast.AstTypeList)]) : bool
  (lower-pattern-list-refutable-for-types-at? ctx (& patterns) 0 types))

(define (lower-pattern-list-refutable-for-types-at?
  [ctx : tc_core.TcContext]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]
  [types : (& types ast.AstTypeList)]) : bool
  (if (>= index (ast.ast-pattern-list-len patterns))
    (not (ast.ast-type-list-empty? types))
    (if (ast.ast-type-list-empty? types)
      true
      (let
        [ty-id : i64 (ast.ast-type-list-get types 0 (ast.ast-type-id-fallback))]
        [rest-types : ast.AstTypeList (ast.ast-type-list-slice types 1)]
        [ty : ast.AstType (tc_core.tc-context-type-get ctx ty-id)]
        (if (lower-pattern-refutable-for-type?
          ctx
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
          ty)
          true
          (lower-pattern-list-refutable-for-types-at?
            ctx
            patterns
            (+ index 1)
            rest-types))))))

(define (lower-field-info-from-list-at
  [ctx : tc_core.TcContext]
  [struct-id : i64]
  [fields : (& fields ast.AstFieldDefList)]
  [field-name : String]
  [index : i64]) : ResultLowerFieldInfo
  (if (>= index fields.len)
    (Err
      (box
        (lower-diagnostic
          (str_cat.str-cat "lower: unknown struct field " field-name))))
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def name ty _)
        (if (string.eq
          (tc_core.tc-env-key-name-text (ci.intern-syntax-id-value name))
          field-name)
          (match (tc_core.tc-inline-aggregate-layout-for-id ctx struct-id)
            [(Ok layout)
              (Ok
                (Info
                  (tc_core.tc-inline-aggregate-layout-field-offset-id
                    layout
                    (ci.intern-syntax-id-value name))
                  (tc_core.tc-resolve-type ctx ty)))]
            [(Err message) (Err (box (lower-diagnostic message)))])
          (lower-field-info-from-list-at
            ctx
            struct-id
            fields
            field-name
            (+ index 1)))])))

;; A struct field's offset, from the one inline aggregate layout that also
;; answers `offset-of` (default and `(:repr c)` structs alike, including
;; declared alignment), and its declared type resolved afresh: the cached
;; layout's types are not retained beyond the cache.
(define (lower-struct-field-info
  [ctx : tc_core.TcContext]
  [struct-id : i64]
  [struct-name : String]
  [field-name : String]) : ResultLowerFieldInfo
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id ctx struct-id)]
    (match (lower-struct-fields-id field-ctx struct-id struct-name)
      [(Ok fields)
        (lower-field-info-from-list-at
          field-ctx
          struct-id
          (& fields)
          field-name
          0)]
      [(Err message) (Err (box (lower-diagnostic message)))])))

(define (lower-var-id
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : ast.AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? id)
      (Ok (Expr state (Var id) ty))
      (Ok (Expr state (Global (lower-resolve-name-symbol-id state name-id)) ty)))))

;; A deferred Copy binding's value, loaded at the read from the address the
;; binding holds (`lower-bind-payload-name`).
(define (lower-deferred-copy-read
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [local-id : i64]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-load-inline-value-at-offset
    ctx
    state
    (ir.CompilerIrValue.Var local-id)
    0
    (lower-global-shared-view ty))
    [(LowerExpr.Expr load-state value _) (LowerExpr.Expr load-state value ty)]))

(define (lower-register-address-taken-local-read
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [local-id : i64]
  [ty : ast.AstType]) : ResultLowerExpr
  (if (and
    (lower-type-register-resident? ctx (lower-global-shared-view ty))
    (lower-state-register-address-taken-var? state local-id))
    (match (lower-state-alloc-var state)
      [(Alloc addr-state addr-var)
        (match (lower-load-register-resident-from-ptr
          ctx
          (lower-state-emit addr-state (AddrOf addr-var local-id))
          (Var addr-var)
          (lower-global-shared-view ty))
          [(Expr load-state loaded _) (Ok (Expr load-state loaded ty))])])
    (Ok (Expr state (Var local-id) ty))))

(define (lower-var-id-storage-aware
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : ast.AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (cond
      [(not (csym.compiler-symbols-handle-found? id))
        (Ok
          (Expr state (Global (lower-resolve-name-symbol-id state name-id)) ty))]
      [(lower-state-deferred-copy? state id)
        (ResultLowerExpr.Ok (lower-deferred-copy-read ctx state id ty))]
      [else (lower-register-address-taken-local-read ctx state id ty)])))

(define (lower-disarm-move-aware-resource-name
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]) : LowerState
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (not (csym.compiler-symbols-handle-found? local-id))
      state
      (let
        [live-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            (cis.intern-lower-private-identity-raw
              (lower-cleanup-live-name-id state local-id))
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? live-id)
          (lower-state-emit state (Mov live-id (Bool false) (Bool)))
          state)))))

(define (lower-disarm-move-aware-resource-expr
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [expr : ast.AstExpr]) : LowerState
  (match (ast.ast-expr-unspan expr)
    [(Var name) (lower-disarm-move-aware-resource-name state env name)]
    [_ state]))

(define (lower-c-function-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(CFunc _ _) true]
    [_ false]))

(define (lower-function-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(CFunc _ _) true]
    [(Func _ _) true]
    [_ false]))

(define (lower-atomic-public-symbol? [symbol : (& symbol str)]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_store")
    (string.eq symbol "tl_atomic_i64_add")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (lower-atomic-public-name? [name : String]) : bool
  (or
    (string.eq name "atomic-i64-load")
    (string.eq name "atomic-i64-store!")
    (string.eq name "atomic-i64-add!")
    (string.eq name "atomic-i64-fetch-add!")
    (string.eq name "atomic-i32-load")
    (string.eq name "atomic-i32-store!")
    (string.eq name "atomic-i32-add!")
    (string.eq name "atomic-i32-fetch-add!")))

(define (lower-atomic-name-candidate? [name : String]) : bool
  (or
    (lower-atomic-public-name? (lower-global-shared-view name))
    (lower-atomic-public-symbol? name)
    (and
      (tc_core.tc-name-qualified? name)
      (lower-atomic-public-name? (tc_core.tc-qualified-name-base name)))))

(define (lower-atomic-symbol-for-name [name : String]) : String
  (cond
    [(string.eq name "atomic-i64-load") "tl_atomic_i64_load"]
    [(string.eq name "atomic-i64-store!") "tl_atomic_i64_store"]
    [(string.eq name "atomic-i64-add!") "tl_atomic_i64_add"]
    [(string.eq name "atomic-i64-fetch-add!") "tl_atomic_i64_fetch_add"]
    [(string.eq name "atomic-i32-load") "tl_atomic_i32_load"]
    [(string.eq name "atomic-i32-store!") "tl_atomic_i32_store"]
    [(string.eq name "atomic-i32-add!") "tl_atomic_i32_add"]
    [(string.eq name "atomic-i32-fetch-add!") "tl_atomic_i32_fetch_add"]
    [else ""]))

(define (lower-atomic-import-path? [path : String]) : bool
  (or (string.eq path "stdlib/atomic.tl") (string.eq path "atomic.tl")))

(define (lower-program-imports-atomic? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (match decl
          [(Import decl-meta (Spec _ path _ _ _))
            (or
              (lower-atomic-import-path? path)
              (lower-program-imports-atomic? rest))]
          [_ (lower-program-imports-atomic? rest)]))]))

(define (lower-context-imports-atomic? [ctx : tc_core.TcContext]) : bool
  (let
    [program : ast.AstProgram (tc_core.tc-context-program ctx)]
    (match program
      [(Program decls-box) (lower-program-imports-atomic? (deref decls-box))])))

(define (lower-atomic-imported-symbol-for-name
  [ctx : tc_core.TcContext]
  [name : String]) : String
  (if (and
    (lower-atomic-public-name? (lower-global-shared-view name))
    (lower-context-imports-atomic? ctx))
    (lower-atomic-symbol-for-name name)
    ""))

(define (lower-atomic-extern-symbol-from-handle
  [symbols : (& symbols csym.CompilerSymbols)]
  [handle : i64]) : String
  (if (=
    (csym.compiler-symbol-handle-kind handle)
    (csym.compiler-symbol-kind-extern))
    (match (csym.compiler-symbols-decl-at-index
      symbols
      (csym.compiler-symbol-handle-index handle))
      [(Ok decl)
        (match decl
          [(Extern decl-meta _ kind metadata _)
            (match kind
              [(Function)
                (let
                  [symbol : String
                    (ast.ast-extern-metadata-symbol (deref metadata))]
                  (if (lower-atomic-public-symbol? symbol)
                    symbol
                    ""))]
              [(Value) ""])]
          [_ ""])]
      [(Err _) ""])
    ""))

(define (lower-atomic-extern-symbol-lookup-id
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]) : String
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (lower-atomic-extern-symbol-from-handle symbols handle)
      "")))

(define (lower-atomic-extern-symbol-for-name-id
  [ctx : tc_core.TcContext]
  [name : String]
  [name-id : i64]) : String
  (if (not (lower-atomic-name-candidate? (lower-global-shared-view name)))
    ""
    (let
      [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
      [direct : String (lower-atomic-extern-symbol-lookup-id symbols name-id)]
      [source-name : String (tc_core.tc-hygiene-global-symbol-name name)]
      (if (> (string.string-length direct) 0)
        direct
        (lower-atomic-imported-symbol-for-name ctx source-name)))))

(define (lower-atomic-extern-symbol-for-func
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]) : String
  (match (ast.ast-expr-unspan func)
    [(Var raw-name)
      (let
        [source-id : i64
          (tc_core.macro-hygiene-global-source-name-id-or
            (tc_core.tc-context-structural-session ctx)
            raw-name
            raw-name)]
        [raw-text : String (lower-context-intern-str ctx source-id)]
        (match (if (or
          (tc_core.macro-hygiene-global-id?
            (tc_core.tc-context-structural-session ctx)
            raw-name)
          (tc_core.tc-hygiene-global-name? raw-text))
          (tc_core.TcNameLookup.Ok
            (if (tc_core.macro-hygiene-global-id?
              (tc_core.tc-context-structural-session ctx)
              raw-name)
              (lower-hygiene-source-name-in-context-id
                lower-state
                ctx
                type-env
                raw-name)
              (tc_core.tc-hygiene-global-call-name raw-text))
            source-id)
          (if (tc_core.tc-source-slash-qualified-id?
            (tc_core.tc-context-structural-session ctx)
            (lower-global-shared-view raw-text)
            source-id)
            (tc_core.TcNameLookup.Ok raw-text source-id)
            (tc_core.tc-source-name-lookup-key-with-field-check-lookup
              ctx
              type-env
              raw-text
              source-id
              true)))
          [(Ok lookup-name lookup-id)
            (lower-atomic-extern-symbol-for-name-id ctx lookup-name lookup-id)]
          [(Err _) ""]))]
    [_ ""]))

;; The symbol table is keyed by the module key (module/name) and the bare source
;; name alias, never by the `::` logical/mangled name returned by
;; lower-resolve-name. Look up the bare source name so a function used as a value
;; lowers to CompilerIrValue.Function (its closure-descriptor address) instead of falling
;; through to CompilerIrValue.Global (which would load the function's code bytes and
;; miscompile an indirect call through it).
(define (lower-symbol-function-value-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [kind : i64 (csym.compiler-symbol-handle-kind handle)]
        (or
          (= kind (csym.compiler-symbol-kind-function-define))
          (= kind (csym.compiler-symbol-kind-defdispatch))
          (and
            (= kind (csym.compiler-symbol-kind-extern))
            (match (csym.compiler-symbols-decl-at-index
              symbols
              (csym.compiler-symbol-handle-index handle))
              [(Ok decl)
                (match decl
                  [(Extern decl-meta _ extern-kind _ _)
                    (match extern-kind
                      [(Function) true]
                      [(Value) false])]
                  [_ false])]
              [(Err _) false]))))
      false)))

(define (lower-extern-value-decl-id? [ctx : tc_core.TcContext] [name-id : i64]) : bool
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-extern)))
      (match (csym.compiler-symbols-decl-at-index
        symbols
        (csym.compiler-symbol-handle-index handle))
        [(Ok decl)
          (match decl
            [(Extern decl-meta _ extern-kind _ _)
              (match extern-kind
                [(Function) false]
                [(Value) true])]
            [_ false])]
        [(Err _) false])
      false)))

(define (lower-function-value-or-var-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : ast.AstType]) : ResultLowerExpr
  (cond
    [(sym_i64_env.sym-i64-contains-id env name-id)
      (lower-var-id state env name-id ty)]
    [(lower-extern-value-decl-id? ctx name-id)
      (let
        [lowered
          (try (lower-var-id state env name-id (lower-global-shared-view ty)))]
        (match lowered
          [(Expr value-state value _)
            (match (lower-state-alloc-var value-state)
              [(Alloc allocated var-id)
                (Ok
                  (Expr
                    (lower-state-emit
                      allocated
                      (Mov var-id value (lower-global-shared-view ty)))
                    (Var var-id)
                    ty))])]))]
    [(and
        (lower-function-type? (lower-global-shared-view ty))
        (lower-symbol-function-value-id? ctx name-id))
      (Ok
        (Expr state (Function (lower-resolve-name-symbol-id state name-id)) ty))]
    [else (lower-var-id state env name-id ty)]))

(define (lower-lambda-captures-env?
  [expr-bases : i64]
  [outer-env : sym_i64_env.SymI64Env]
  [body : ast.AstExpr]
  [bound : tc_core.TcStringList]) : bool
  (match (sym_i64_env.sym-i64-view outer-env)
    [(SymI64ViewNil) false]
    [(SymI64ViewBind name-id _ rest)
      (if (tc_core.tc-expr-uses-free-name?
        expr-bases
        (lower-global-shared-view body)
        (tc_core.tc-env-key-name-text name-id)
        (lower-global-shared-view bound))
        true
        (lower-lambda-captures-env? expr-bases rest body bound))]))

(define (lower-lambda-ret-type
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [lambda-expr : ast.AstExpr]
  [maybe-ret : ast.AstMaybeType]) : tc_core.ResultTcType
  (match maybe-ret
    [(Some ty) (Ok (tc_core.tc-resolve-type ctx ty))]
    [(No)
      (let
        [ty : ast.AstType (try (tc_core.tc-expr ctx type-env lambda-expr))]
        (match (tc_core.tc-type-strip-region ty)
          [(Func _ ret) (Ok (tc_core.tc-context-type-get ctx ret))]
          [_ (Err "lower: lambda did not typecheck as a function")]))]))

(define (lower-capture-list-contains-name?
  [captures : (& captures LowerCaptureList)]
  [name-id : i64]) : bool
  (let
    [items : (__tl_dyn-array LowerCapture) captures.items]
    [count : i64 captures.count]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (array-ref items index)
        [(Capture capture-name-id _ _ _)
          (if (= capture-name-id name-id)
            (set! found true)
            (set! index (+ index 1)))]))
    found))

(define (lower-capture-list-empty) : LowerCaptureList
  (LowerCaptureList (__tl_make-array LowerCapture 0) 0))

(define (lower-capture-list-add-front
  [captures : LowerCaptureList]
  [capture : LowerCapture]) : LowerCaptureList
  (let
    [items : (__tl_dyn-array LowerCapture) captures.items]
    [count : i64 captures.count]
    (__tl_array-push! items capture)
    (LowerCaptureList items (+ count 1))))

(define (lower-unsupported-capture-message) : String
  "lower: unsupported lambda capture type")

(define (lower-capture-support-message
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(Ref _ _) (lower-reference-support-message)]
    [(MutRef _ _) (lower-reference-support-message)]
    [_ (lower-unsupported-capture-message)]))

(define (lower-supported-capture-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(I64) true]
    [(U64) true]
    [(F64) true]
    [(I32) true]
    [(U32) true]
    [(F32) true]
    [(I16) true]
    [(U16) true]
    [(I8) true]
    [(U8) true]
    [(Bool) true]
    [(Char) true]
    [(Ptr _) true]
    [(MutPtr _) true]
    [(Ref _ _) true]
    [(MutRef _ _) true]
    [(CFunc _ _) true]
    [(Func _ _) true]
    [(Tuple _) true]
    [(Array _ _) true]
    [(Enum _) true]
    [(EnumArgs _ _) true]
    [(Struct _) true]
    [(StructArgs _ _) true]
    [(String) true]
    [(DynArray _) true]
    [_ false]))

(define (lower-capture-env-size [cursor : i64]) : i64
  (lower-align-up
    (if (= cursor 0)
      1
      cursor)
    8))

(define (lower-capture-slot-type [ty : ast.AstType]) : ast.AstType
  (match (tc_core.tc-type-strip-region (lower-global-shared-view ty))
    [(Func _ _) (U64)]
    [(Tuple _) (U64)]
    [(Array _ _) (U64)]
    [(Enum _) (U64)]
    [(EnumArgs _ _) (U64)]
    [(Struct _) (U64)]
    [(StructArgs _ _) (U64)]
    [(String) (U64)]
    [(DynArray _) (U64)]
    [_ ty]))

(define (lower-fixed-array-storage-size
  [ctx : tc_core.TcContext]
  [elem-ty : ast.AstType]
  [count : i64]) : i64
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    [extent : i64 (* count elem-size)]
    (lower-align-up
      (if (= extent 0)
        1
        extent)
      8)))

(define (lower-capture-snapshot-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-resolve-type ctx (lower-global-shared-view ty))
    [(String) (lower-capture-snapshot-string-value state value)]
    [(DynArray elem-ty)
      (lower-capture-snapshot-dynarray-value
        ctx
        state
        value
        (tc_core.tc-type-without-regions
          (tc_core.tc-context-type-get ctx elem-ty))
        ty)]
    [(Tuple elem-tys)
      (lower-copy-tuple-value
        ctx
        state
        env
        type-env
        (Snapshot)
        value
        (deref elem-tys)
        ty)]
    [(Array elem-ty count)
      (lower-copy-fixed-array-value
        ctx
        state
        env
        type-env
        (Snapshot)
        value
        (tc_core.tc-type-without-regions
          (tc_core.tc-context-type-get ctx elem-ty))
        count
        ty)]
    ;; A register-resident aggregate is word-class POD held in a register;
    ;; its capture snapshot is the value itself (nothing on the heap to copy).
    [(Struct name)
      (if (lower-type-register-resident? ctx (lower-global-shared-view ty))
        (Ok (Expr state value ty))
        (lower-capture-snapshot-struct-value
          ctx
          state
          env
          type-env
          value
          (tc_core.tc-nominal-name-id-display name)
          ty))]
    [(StructArgs name _)
      (lower-capture-snapshot-struct-value
        ctx
        state
        env
        type-env
        value
        (tc_core.tc-nominal-name-id-display name)
        ty)]
    [(Enum name)
      (if (lower-type-register-resident? ctx (lower-global-shared-view ty))
        (Ok (Expr state value ty))
        (lower-capture-snapshot-enum-value
          ctx
          state
          env
          type-env
          value
          name
          (tc_core.tc-nominal-name-id-display name)
          ty))]
    [(EnumArgs name _)
      (lower-capture-snapshot-enum-value
        ctx
        state
        env
        type-env
        value
        name
        (tc_core.tc-nominal-name-id-display name)
        ty)]
    [_ (Ok (Expr state value ty))]))

(define (lower-capture-snapshot-string-value
  [state : LowerState]
  [value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state value)
    [(Fields fields-state ptr len)
      (lower-substring-call-runtime fields-state ptr (I64 0) len)]))

(define (lower-capture-snapshot-dynarray-copy
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]) : LowerState
  (if (= elem-size 0)
    state
    (lower-array-push-copy-loop ctx state old-buf new-buf len elem-ty)))

(define (lower-capture-snapshot-dynarray-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [old-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [buf-var : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 result-ty)
    [(Expr arr-state arr-value _)
      (let
        [copied-state : LowerState
          (lower-capture-snapshot-dynarray-copy
            ctx
            arr-state
            old-buf
            (Var buf-var)
            (lower-global-shared-view len)
            elem-ty
            elem-size)]
        (Ok
          (Expr
            (lower-store-at-offset
              (lower-store-at-offset
                copied-state
                arr-value
                0
                (Var buf-var)
                (U64))
              arr-value
              8
              len
              (I64))
            arr-value
            result-ty)))]))

(define (lower-capture-snapshot-dynarray-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-load-at-offset state value 8 (I64))
    [(Expr len-state len _)
      (match (lower-load-at-offset len-state value 0 (U64))
        [(Expr ptr-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            (match (if (= elem-size 0)
              (Expr ptr-state (I64 1) (I64))
              (lower-emit-binop
                ptr-state
                Mul
                (lower-global-shared-view len)
                (I64 elem-size)
                (I64)))
              [(Expr byte-state byte-count _)
                (match (lower-state-alloc-var byte-state)
                  [(Alloc buf-alloc buf-var)
                    (lower-capture-snapshot-dynarray-finish
                      ctx
                      (lower-state-emit
                        buf-alloc
                        (Call
                          buf-var
                          (lower-tl-alloc-symbol)
                          (One byte-count)
                          (U64)))
                      old-buf
                      len
                      elem-ty
                      elem-size
                      buf-var
                      result-ty)])]))])]))

;; The two deep copies of an aggregate into fresh heap storage: `(clone x)`,
;; and the snapshot a capturing lambda takes of a captured value. Tuples and
;; fixed arrays copy element by element the same way in both; only the copy
;; of each element differs.
(defenum LowerCopyMode
  (Clone)
  (Snapshot))

(define (lower-copy-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [copy-mode : LowerCopyMode]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (match copy-mode
    [(Clone) (lower-clone-dispatch ctx state env type-env value ty)]
    [(Snapshot) (lower-capture-snapshot-value ctx state env type-env value ty)]))

(define (lower-copy-type-list
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [copy-mode : LowerCopyMode]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [types : ast.AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-copy-type-list-at
    ctx
    state
    env
    type-env
    copy-mode
    src
    dst
    (& types)
    cursor
    0))

(define (lower-copy-type-list-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [copy-mode : LowerCopyMode]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [types : (& types ast.AstTypeList)]
  [cursor : i64]
  [index : i64]) : ResultLowerState
  (if (>= index (ast.ast-type-list-len types))
    (Ok state)
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [resolved : ast.AstType
        (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      [size : i64 (lower-type-size ctx resolved)]
      (if (> size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          (lower-global-shared-view src)
          offset
          (lower-global-shared-view resolved))
          [(Expr load-state field-value _)
            (let
              [copied
                (try
                  (lower-copy-value
                    ctx
                    load-state
                    env
                    type-env
                    copy-mode
                    field-value
                    (lower-global-shared-view resolved)))]
              (match copied
                [(Expr copy-state copy-value _)
                  (lower-copy-type-list-at
                    ctx
                    (lower-store-inline-value-at-offset
                      ctx
                      copy-state
                      dst
                      offset
                      copy-value
                      resolved
                      size)
                    env
                    type-env
                    copy-mode
                    src
                    dst
                    types
                    (+ offset size)
                    (+ index 1))]))])
        (lower-copy-type-list-at
          ctx
          state
          env
          type-env
          copy-mode
          src
          dst
          types
          (+ offset size)
          (+ index 1))))))

(define (lower-copy-tuple-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [copy-mode : LowerCopyMode]
  [value : ir.CompilerIrValue]
  [elem-tys : ast.AstTypeList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage
    state
    (lower-type-list-storage-size ctx (lower-global-shared-view elem-tys))
    result-ty)
    [(Expr dst-state dst _)
      (let
        [done-state
          (try
            (lower-copy-type-list
              ctx
              dst-state
              env
              type-env
              copy-mode
              value
              (lower-global-shared-view dst)
              elem-tys
              0))]
        (Ok (Expr done-state dst result-ty)))]))

(define (lower-copy-fixed-array-elems
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [copy-mode : LowerCopyMode]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [index : i64]
  [count : i64]) : ResultLowerState
  (if (>= index count)
    (Ok state)
    (let
      [offset : i64 (* index elem-size)]
      (if (> elem-size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          (lower-global-shared-view src)
          offset
          (lower-global-shared-view elem-ty))
          [(Expr load-state elem-value _)
            (let
              [copied
                (try
                  (lower-copy-value
                    ctx
                    load-state
                    env
                    type-env
                    copy-mode
                    elem-value
                    (lower-global-shared-view elem-ty)))]
              (match copied
                [(Expr copy-state copy-value _)
                  (lower-copy-fixed-array-elems
                    ctx
                    (lower-store-inline-value-at-offset
                      ctx
                      copy-state
                      dst
                      offset
                      copy-value
                      (lower-global-shared-view elem-ty)
                      elem-size)
                    env
                    type-env
                    copy-mode
                    src
                    dst
                    elem-ty
                    elem-size
                    (+ index 1)
                    count)]))])
        (lower-copy-fixed-array-elems
          ctx
          state
          env
          type-env
          copy-mode
          src
          dst
          elem-ty
          elem-size
          (+ index 1)
          count)))))

(define (lower-copy-fixed-array-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [copy-mode : LowerCopyMode]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [count : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    (match (lower-reserve-heap-storage
      state
      (lower-fixed-array-storage-size
        ctx
        (lower-global-shared-view elem-ty)
        count)
      result-ty)
      [(Expr dst-state dst _)
        (let
          [done-state
            (try
              (lower-copy-fixed-array-elems
                ctx
                dst-state
                env
                type-env
                copy-mode
                value
                (lower-global-shared-view dst)
                elem-ty
                elem-size
                0
                count))]
          (Ok (Expr done-state dst result-ty)))])))

(define (lower-capture-snapshot-struct-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [struct-name : String]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-struct-repr-c-id? ctx (lower-struct-type-name-id-or result-ty -1))
    (Err
      (box
        (lower-diagnostic
          "lower: repr-c aggregate lambda captures need repr-c snapshot lowering")))
    (match (lower-struct-fields-id
      ctx
      (lower-struct-type-name-id-or result-ty -1)
      struct-name)
      [(Ok fields)
        (let
          [field-types : ast.AstTypeList
            (tc_core.tc-field-type-list ctx fields)]
          (match (lower-reserve-heap-storage
            state
            (lower-type-list-storage-size
              ctx
              (lower-global-shared-view field-types))
            result-ty)
            [(Expr dst-state dst _)
              (let
                [done-state
                  (try
                    (lower-copy-type-list
                      ctx
                      dst-state
                      env
                      type-env
                      (Snapshot)
                      value
                      (lower-global-shared-view dst)
                      field-types
                      0))]
                (Ok (Expr done-state dst result-ty)))]))]
      [(Err message) (Err (box (lower-diagnostic message)))])))

(define (lower-capture-snapshot-enum-variants
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [src : ir.CompilerIrValue]
  [dst : ir.CompilerIrValue]
  [tag : ir.CompilerIrValue]
  [variants : ast.AstVariantDefList]
  [index : i64]
  [done-label : i64]) : ResultLowerState
  (if (>= index variants.len)
    (Ok
      (lower-state-finish-block
        (lower-state-emit state (Jump done-label))
        done-label))
    (let
      [variant : ast.AstVariantDef
        (ast.ast-variant-def-list-get
          (& variants)
          index
          (ast.ast-variant-def-fallback))]
      (match (lower-state-fresh-label state "capture_enum_variant")
        [(Label variant-label-state variant-label)
          (match (lower-state-fresh-label
            variant-label-state
            "capture_enum_next")
            [(Label next-label-state next-label)
              (match (lower-state-alloc-var next-label-state)
                [(Alloc cond-state cond-var)
                  (let
                    [branch-state : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            cond-state
                            (BinOp
                              cond-var
                              Eq
                              (lower-global-shared-view tag)
                              (I64 index)
                              (I64)))
                          (Branch (Var cond-var) variant-label next-label))
                        variant-label)]
                    (match variant
                      [(Def _ fields _)
                        (let
                          [copied-state
                            (try
                              (lower-copy-type-list
                                ctx
                                branch-state
                                env
                                type-env
                                (Snapshot)
                                (lower-global-shared-view src)
                                (lower-global-shared-view dst)
                                fields
                                8))]
                          (lower-capture-snapshot-enum-variants
                            ctx
                            (lower-state-finish-block
                              (lower-state-emit copied-state (Jump done-label))
                              next-label)
                            env
                            type-env
                            src
                            dst
                            tag
                            variants
                            (+ index 1)
                            done-label))]))])])]))))

(define (lower-capture-snapshot-enum-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [enum-name-id : i64]
  [enum-name : String]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-context-enum-variants-id
    ctx
    enum-name-id
    (lower-global-shared-view enum-name))
    [(Ok variants)
      (match (lower-reserve-heap-storage
        state
        (lower-enum-storage-size ctx enum-name-id enum-name)
        result-ty)
        [(Expr dst-state dst _)
          (match (lower-load-at-offset dst-state value 0 (I64))
            [(Expr tag-state tag _)
              (match (lower-state-fresh-label tag-state "capture_enum_done")
                [(Label done-state done-label)
                  (let
                    [final-state
                      (try
                        (lower-capture-snapshot-enum-variants
                          ctx
                          (lower-store-at-offset
                            done-state
                            dst
                            0
                            (lower-global-shared-view tag)
                            (I64))
                          env
                          type-env
                          value
                          (lower-global-shared-view dst)
                          tag
                          variants
                          0
                          done-label))]
                    (Ok (Expr final-state dst result-ty)))])])])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

(define (lower-capture-plan-scan
  [ctx : tc_core.TcContext]
  [expr-bases : i64]
  [outer-env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [body : ast.AstExpr]
  [bound : tc_core.TcStringList]
  [cursor : i64]
  [captures : LowerCaptureList]
  [origin : ast.AstExpr]) : ResultLowerCapturePlan
  (match (sym_i64_env.sym-i64-view outer-env)
    [(SymI64ViewNil) (Ok (Plan captures (lower-capture-env-size cursor)))]
    [(SymI64ViewBind name-id var-id rest)
      (let
        [name : String (tc_core.tc-env-key-name-text name-id)]
        (if (or
          (lower-capture-list-contains-name? captures name-id)
          (not
            (tc_core.tc-expr-uses-free-name?
              expr-bases
              (lower-global-shared-view body)
              name
              (lower-global-shared-view bound))))
          (lower-capture-plan-scan
            ctx
            expr-bases
            rest
            type-env
            body
            bound
            cursor
            captures
            origin)
          (match (tc_core.tc-lookup-id type-env name-id)
            [(Err message)
              (Err (box (lower-diagnostic-at-expr ctx origin message)))]
            [(Ok found-ty)
              (let
                [capture-ty : ast.AstType
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx found-ty))]
                (if (lower-supported-capture-type?
                  ctx
                  (lower-global-shared-view capture-ty))
                  (let
                    [slot-ty : ast.AstType
                      (lower-capture-slot-type
                        (lower-global-shared-view capture-ty))]
                    [offset : i64
                      (lower-align-up cursor (lower-type-align ctx slot-ty))]
                    ;; A register-group capture occupies 16 bytes inline (two
                    ;; words), not an 8-byte handle slot.
                    [slot-size : i64
                      (if (lower-type-register-group?
                        ctx
                        (lower-global-shared-view capture-ty))
                        16
                        (lower-type-size ctx slot-ty))]
                    (lower-capture-plan-scan
                      ctx
                      expr-bases
                      rest
                      type-env
                      body
                      bound
                      (+ offset slot-size)
                      (lower-capture-list-add-front
                        captures
                        (Capture name-id var-id capture-ty offset))
                      origin))
                  (Err
                    (box
                      (lower-diagnostic-at-expr
                        ctx
                        origin
                        (lower-capture-support-message ctx capture-ty))))))])))]))

(define (lower-capture-plan
  [ctx : tc_core.TcContext]
  [outer-env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerCapturePlan
  (lower-capture-plan-scan
    ctx
    (tc_core.tc-context-expr-bases ctx)
    outer-env
    type-env
    body
    (tc_core.tc-param-bound-names params)
    0
    (lower-capture-list-empty)
    origin))

(define (lower-store-captures-from-index
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [env-value : ir.CompilerIrValue]
  [items : (__tl_dyn-array LowerCapture)]
  [index : i64]) : ResultLowerState
  (if (< index 0)
    (Ok state)
    (let
      [capture : LowerCapture
        (lower-global-array-element-shared-view items index)]
      (match capture
        [(Capture _ var-id capture-ty offset)
          (let
            [snap
              (try
                (lower-capture-snapshot-value
                  ctx
                  state
                  env
                  type-env
                  (Var var-id)
                  (lower-global-shared-view capture-ty)))]
            (match snap
              [(Expr snap-state snap-value _)
                (lower-store-captures-from-index
                  ctx
                  (if (lower-type-register-group?
                    ctx
                    (lower-global-shared-view capture-ty))
                    ;; A captured 2-word group stores both words.
                    (match (lower-gep-byte
                      snap-state
                      (lower-global-shared-view env-value)
                      offset)
                      [(Expr gep-state ptr _)
                        (lower-store-group-at-ptr
                          ctx
                          gep-state
                          ptr
                          snap-value
                          capture-ty)])
                    (lower-store-at-offset
                      snap-state
                      env-value
                      offset
                      snap-value
                      (lower-capture-slot-type capture-ty)))
                  env
                  type-env
                  env-value
                  items
                  (- index 1))]))]))))

(define (lower-store-captures
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [env-value : ir.CompilerIrValue]
  [captures : LowerCaptureList]) : ResultLowerState
  (lower-store-captures-from-index
    ctx
    state
    env
    type-env
    env-value
    captures.items
    (- captures.count 1)))

(define (lower-store-capturing-lambda-descriptor
  [state : LowerState]
  [lambda-name : i64]
  [env-value : ir.CompilerIrValue]
  [expr-ty : ast.AstType]) : LowerExpr
  (match (lower-reserve-heap-storage state 16 expr-ty)
    [(Expr desc-state desc-value _)
      (Expr
        (lower-store-at-offset
          (lower-store-at-offset
            desc-state
            desc-value
            0
            (GlobalAddr lambda-name)
            (U64))
          desc-value
          8
          env-value
          (U64))
        desc-value
        expr-ty)]))

(define (lower-capturing-lambda-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lambda-name : i64]
  [captures : LowerCaptureList]
  [capture-size : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (let
    [ty (ast.AstType.U64)]
    (lower-reserve-heap-storage state capture-size ty))
    [(Expr env-state env-value _)
      (let
        [captured-state
          (try
            (lower-store-captures
              ctx
              env-state
              env
              type-env
              (lower-global-shared-view env-value)
              captures))]
        (match (lower-store-capturing-lambda-descriptor
          captured-state
          lambda-name
          env-value
          expr-ty)
          [(Expr desc-state desc-value desc-ty)
            (Ok (Expr desc-state desc-value desc-ty))]))]))

(define (lower-load-captures-from-index
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env-value : ir.CompilerIrValue]
  [items : (__tl_dyn-array LowerCapture)]
  [index : i64]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerEnv
  (if (< index 0)
    (Ok state env type-env)
    (let
      [capture : LowerCapture
        (lower-global-array-element-shared-view items index)]
      (match capture
        [(Capture name-id _ capture-ty offset)
          (match (if (lower-type-register-group?
            ctx
            (lower-global-shared-view capture-ty))
            ;; A captured 2-word group loads both words and repacks.
            (match (lower-gep-byte
              state
              (lower-global-shared-view env-value)
              offset)
              [(Expr gep-state ptr _)
                (lower-load-group-from-ptr
                  ctx
                  gep-state
                  ptr
                  (lower-global-shared-view capture-ty))])
            (lower-load-at-offset
              state
              env-value
              offset
              (lower-capture-slot-type (lower-global-shared-view capture-ty))))
            [(Expr loaded-state loaded-value _)
              (match loaded-value
                [(Var loaded-var)
                  (lower-load-captures-from-index
                    ctx
                    loaded-state
                    env-value
                    items
                    (- index 1)
                    (sym_i64_env.sym-i64-bind-id env name-id loaded-var)
                    (tc_core.tc-bind-id type-env name-id capture-ty))]
                [_
                  (Err
                    (box
                      (lower-diagnostic
                        "lower: capture load did not materialize a variable")))])])]))))

(define (lower-load-captures
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env-value : ir.CompilerIrValue]
  [captures : LowerCaptureList]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerEnv
  (lower-load-captures-from-index
    ctx
    state
    env-value
    captures.items
    (- captures.count 1)
    env
    type-env))

(define (lower-captured-internal-param-list
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : ast.AstParamList]
  [source-start : i64]
  [leading-sret? : bool]) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "__tl_env" (U64) 0)
    (lower-internal-param-list ctx mode params source-start leading-sret?)))

(define (lower-function-with-captures
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [logical-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [captures : LowerCaptureList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (if (or
    (lower-param-list-contains-unsupported-reference? ctx params)
    (not (lower-supported-reference-type? ctx (lower-global-shared-view ret))))
    (Err (box (lower-diagnostic (lower-reference-support-message))))
    (let
      [param-count : i64 (lower-param-count params)]
      [ret-ty : ast.AstType
        (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
      [global-init? : bool
        (lower-global-init-function-symbol? names logical-name)]
      [ret-class : LowerCAbiAggregate
        (lower-internal-return-class-for-symbol
          ctx
          mode
          (lower-global-shared-view names)
          logical-name
          (lower-global-shared-view ret-ty))]
      [structural-sret? : bool
        (match (& ret-class)
          [(Sret _) true]
          [_ false])]
      [nominal-sret? : bool
        (and
          (not structural-sret?)
          (not global-init?)
          (lower-type-inline-struct-or-enum?
            ctx
            (lower-global-shared-view ret-ty))
          (not
            (lower-type-register-resident?
              ctx
              (lower-global-shared-view ret-ty))))]
      [source-start : i64
        (if structural-sret?
          2
          1)]
      [structural-params? : bool
        (lower-internal-param-list-contains-structural? ctx params)]
      [sret-var : i64
        (if structural-sret?
          1
          (if nominal-sret?
            (+ source-start param-count)
            (- 0 1)))]
      [ret-ir-ty : ast.AstType
        (match (& ret-class)
          [(Unsupported _) (U64)]
          [_
            (lower-internal-return-physical-type
              ctx
              mode
              (lower-global-shared-view ret-ty))])]
      [function-spans : ir.CompilerSourceSpans
        (lower-record-function-span
          (compiler-lower-state-from-name-cache names)
          (& (tc_core.tc-context-pools ctx))
          spans
          (ir.compiler-ir-symbol-typed-id logical-name)
          (lower-global-shared-view body))]
      [state : LowerState
        (lower-state-new
          (+
            source-start
            param-count
            (if nominal-sret?
              1
              0))
          0
          0
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-instr-builder-new)
          (ir.compiler-ir-block-builder-new)
          (ir.compiler-ir-function-builder-new)
          logical-name
          (box function-spans)
          names
          type-cache
          function-state
          mode
          (lower_i64_i64_map.with-capacity 8)
          source-start
          (+ source-start param-count))]
      (match ret-class
        [(Unsupported message)
          (Err (box (lower-diagnostic-at-expr ctx body message)))]
        [_
          (match (lower-load-captures
            ctx
            state
            (Var 0)
            captures
            (sym_i64_env.sym-i64-empty)
            (tc_core.tc-bind-return-type
              top-env
              (lower-global-shared-view ret-ty)))
            [(Ok captured-state captured-env captured-type-env)
              (let
                [initial-env : sym_i64_env.SymI64Env
                  (if (>= sret-var 0)
                    (sym_i64_env.sym-i64-bind-id
                      captured-env
                      (cis.intern-lower-private-identity-raw
                        (lower-sret-param-marker-id captured-state))
                      sret-var)
                    captured-env)]
                [type-env : tc_core.TcTypeEnv
                  (tc_core.tc-bind-params ctx captured-type-env params)]
                (match (if structural-params?
                  (lower-bind-internal-params
                    ctx
                    mode
                    params
                    source-start
                    captured-state
                    initial-env
                    type-env
                    (lower-global-shared-view body))
                  (ResultLowerEnv.Ok
                    captured-state
                    (lower-bind-params params source-start initial-env)
                    type-env))
                  [(Ok bound-state bound-env bound-type-env)
                    (let
                      [final-state
                        (try
                          (lower-tail-expr
                            ctx
                            bound-state
                            bound-env
                            bound-type-env
                            body
                            ret-ty
                            sret-var))]
                      [source-params : ir.CompilerIrParamSeq
                        (if structural-params?
                          (lower-captured-internal-param-list
                            ctx
                            mode
                            params
                            source-start
                            structural-sret?)
                          (let
                            [source : ir.CompilerIrParamSeq
                              (lower-param-list ctx params source-start)]
                            [with-sret : ir.CompilerIrParamSeq
                              (if structural-sret?
                                (ir.compiler-ir-param-seq-prepend
                                  (Param
                                    (ir.compiler-ir-hidden-sret-param-name)
                                    (U64)
                                    1)
                                  source)
                                source)]
                            (ir.compiler-ir-param-seq-prepend
                              (Param "__tl_env" (U64) 0)
                              with-sret)))]
                      [all-params : ir.CompilerIrParamSeq
                        (if nominal-sret?
                          (lower-param-list-append-sret source-params sret-var)
                          source-params)]
                      (Ok
                        (lower-state-build-functions-with
                          final-state
                          (Function
                            logical-name
                            all-params
                            ret-ir-ty
                            (lower-state-next-var final-state)
                            (lower-state-build-function-blocks final-state)
                            Ordinary))
                        (lower-state-spans final-state)))]
                  [(Err message) (Err message)]))]
            [(Err message) (Err message)])]))))

(define (lower-lambda-noncapturing
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-lambda-ret-type
    ctx
    type-env
    (lower-global-shared-view origin)
    maybe-ret)
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx origin message)))]
    [(Ok ret-ty)
      (match (lower-state-fresh-lambda-name state)
        [(Name named-state lambda-name)
          (match (lower-function
            ctx
            type-env
            (lower-state-type-cache state)
            (compiler-lower-function-state-new (lower-state-owner state))
            lambda-name
            params
            ret-ty
            body
            (lower-state-spans named-state)
            (lower-state-names named-state)
            (lower-state-mode named-state))
            [(Ok lambda-functions lambda-spans)
              (Ok
                (Expr
                  (lower-state-add-functions
                    named-state
                    lambda-functions
                    lambda-spans)
                  (Function lambda-name)
                  expr-ty))]
            [(Err message) (Err message)])])]))

(define (lower-lambda-capturing
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-lambda-ret-type
    ctx
    type-env
    (lower-global-shared-view origin)
    maybe-ret)
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx origin message)))]
    [(Ok ret-ty)
      (let
        [plan
          (try
            (lower-capture-plan
              ctx
              env
              type-env
              (lower-global-shared-view params)
              (lower-global-shared-view body)
              origin))]
        (match plan
          [(Plan captures capture-size)
            (match (lower-state-fresh-lambda-name state)
              [(Name named-state lambda-name)
                (match (lower-function-with-captures
                  ctx
                  type-env
                  (lower-state-type-cache named-state)
                  (compiler-lower-function-state-new
                    (lower-state-owner named-state))
                  lambda-name
                  params
                  ret-ty
                  body
                  (lower-global-shared-view captures)
                  (lower-state-spans named-state)
                  (lower-state-names named-state)
                  (lower-state-mode named-state))
                  [(Ok lambda-functions lambda-spans)
                    (let
                      [lowered
                        (try
                          (lower-capturing-lambda-value
                            ctx
                            (lower-state-add-functions
                              named-state
                              lambda-functions
                              lambda-spans)
                            env
                            type-env
                            lambda-name
                            captures
                            capture-size
                            expr-ty))]
                      (match lowered
                        [(Expr value-state value value-ty)
                          (Ok (Expr value-state value value-ty))]))]
                  [(Err message) (Err message)])])]))]))

(define (lower-lambda
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-lambda-captures-env?
    (tc_core.tc-context-expr-bases ctx)
    env
    (lower-global-shared-view body)
    (tc_core.tc-param-bound-names (lower-global-shared-view params)))
    (lower-lambda-capturing
      ctx
      state
      env
      type-env
      params
      maybe-ret
      body
      origin
      expr-ty)
    (lower-lambda-noncapturing
      ctx
      state
      type-env
      params
      maybe-ret
      body
      origin
      expr-ty)))

(define (lower-return-maybe [value : ir.CompilerIrValue] [ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (match ty
    [(Unit) No]
    [_ (Some value)]))

(define (lower-private-identity
  [state : LowerState]
  [record : cis.InternLowerPrivateRecord]) : cis.InternLowerPrivateIdentity
  (cis.intern-structural-session-lower-private-identity
    (compiler-lower-state-structural-session (lower-state-owner state))
    record))

(define (lower-cleanup-marker-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state CleanupStack))

(define (lower-region-reset-marker-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state RegionReset))

(define (lower-sret-param-marker-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SretParameter))

(define (lower-spmd-reduce-acc-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SpmdReduceAccumulator))

(define (lower-spmd-reduce-end-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SpmdReduceEnd))

(define (lower-spmd-reduce-val-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SpmdReduceValue))

(define (lower-spmd-reduce-current-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SpmdReduceCurrent))

(define (lower-spmd-reduce-start-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SpmdReduceStart))

(define (lower-spmd-reduce-uniform-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SpmdReduceUniform))

(define (lower-spmd-scan-acc-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SpmdScanAccumulator))

(define (lower-spmd-scan-end-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SpmdScanEnd))

(define (lower-spmd-scan-val-id [state : LowerState]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state SpmdScanValue))

(define (lower-cleanup-hidden-name-id [state : LowerState] [var-id : i64]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state (CleanupHidden var-id)))

(define (lower-cleanup-live-name-id [state : LowerState] [var-id : i64]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state (CleanupLiveness var-id)))

(define (lower-region-hidden-name-id [state : LowerState] [var-id : i64]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state (RegionHidden var-id)))

(define (lower-arena-restore-hidden-name-id [state : LowerState] [var-id : i64]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state (ArenaRestoreHidden var-id)))

(define (lower-while-exit-label-id [state : LowerState] [label-number : i64]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state (WhileExit label-number)))

(define (lower-while-header-label-id [state : LowerState] [label-number : i64]) : cis.InternLowerPrivateIdentity
  (lower-private-identity state (WhileHeader label-number)))

(define (lower-loop-label-name
  [state : LowerState]
  [identity : cis.InternLowerPrivateIdentity]) : i64
  (match (cis.intern-structural-session-lower-private-record
    (compiler-lower-state-structural-session (lower-state-owner state))
    identity)
    [(Some record)
      (match record
        [(WhileExit ordinal)
          (ir.compiler-ir-label
            (str_cat.str-cat "while_exit." (string.int->string ordinal)))]
        [(WhileHeader ordinal)
          (ir.compiler-ir-label
            (str_cat.str-cat "while_header." (string.int->string ordinal)))]
        [_ (ci.tl_oob_abort)])]
    [(No) (ci.tl_oob_abort)]))

(define (lower-cleanup-metadata-type
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : ast.AstType
  (ast.ast-ty-tuple
    (ast.ast-type-cons
      (Var hidden-name-id)
      (ast.ast-type-cons (Var cleanup-name-id) (ast.ast-type-list-new)))))

(define (lower-region-reset-metadata-type [hidden-name-id : i64]) : ast.AstType
  (Var hidden-name-id))

(define (lower-arena-restore-metadata-type [hidden-name-id : i64]) : ast.AstType
  (ast.ast-ty-tuple
    (ast.ast-type-cons (Var hidden-name-id) (ast.ast-type-list-new))))

(define (lower-type-env-push-cleanup
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (cis.intern-lower-private-identity-raw (lower-cleanup-marker-id state))
    (lower-cleanup-metadata-type hidden-name-id cleanup-name-id)))

(define (lower-type-env-push-move-aware-cleanup
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]
  [live-name-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (cis.intern-lower-private-identity-raw (lower-cleanup-marker-id state))
    (ast.ast-ty-tuple
      (ast.ast-type-cons
        (Var hidden-name-id)
        (ast.ast-type-cons
          (Var cleanup-name-id)
          (ast.ast-type-cons (Var live-name-id) (ast.ast-type-list-new)))))))

(define (lower-type-env-push-region-reset
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [hidden-name-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (cis.intern-lower-private-identity-raw (lower-region-reset-marker-id state))
    (lower-region-reset-metadata-type hidden-name-id)))

(define (lower-type-env-push-arena-restore
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [hidden-name-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (cis.intern-lower-private-identity-raw (lower-region-reset-marker-id state))
    (lower-arena-restore-metadata-type hidden-name-id)))

(define (lower-cleanup-name-id-from-expr [cleanup : ast.AstExpr]) : tc_core.ResultTcExprId
  (match (ast.ast-expr-unspan cleanup)
    [(Var name) (Ok name)]
    [_ (Err "lower: resource cleanup must be a direct function name")]))

(define (lower-emit-cleanup-call
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : ResultLowerState
  (let
    [resource-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        hidden-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? resource-id)
      (match (lower-state-alloc-var state)
        [(Alloc allocated var-id)
          (let
            [call-name : i64
              (lower-resolve-call-name-id allocated env cleanup-name-id)]
            (Ok
              (lower-state-emit
                allocated
                (Call var-id call-name (One (Var resource-id)) (Unit)))))])
      (Err (box (lower-diagnostic "lower: missing resource cleanup binding"))))))

(define (lower-emit-cleanup-call-if-live
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]
  [live-name-id : i64]) : ResultLowerState
  (let
    [live-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        live-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (not (csym.compiler-symbols-handle-found? live-id))
      (Err (box (lower-diagnostic "lower: missing resource liveness binding")))
      (match (lower-state-fresh-label state "cleanup_live")
        [(Label cleanup-label-state cleanup-label)
          (match (lower-state-fresh-label cleanup-label-state "cleanup_done")
            [(Label labels-state done-label)
              (let
                [cleanup-state : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      labels-state
                      (Branch (Var live-id) cleanup-label done-label))
                    cleanup-label)]
                [called-state
                  (try
                    (lower-emit-cleanup-call
                      cleanup-state
                      env
                      hidden-name-id
                      cleanup-name-id))]
                (Ok
                  (lower-state-finish-block
                    (lower-state-emit called-state (Jump done-label))
                    done-label)))])]))))

(define (lower-emit-region-reset
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]) : ResultLowerState
  (let
    [mark-var : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        hidden-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? mark-var)
      (match (lower-state-alloc-var state)
        [(Alloc allocated reset-var)
          (Ok
            (lower-state-emit
              allocated
              (Call
                reset-var
                (lower-tl-region-reset-symbol)
                (One (Var mark-var))
                (Unit))))])
      (Err (box (lower-diagnostic "lower: missing region reset binding"))))))

(define (lower-emit-arena-restore
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]) : ResultLowerState
  (let
    [arena-var : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        hidden-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? arena-var)
      (match (lower-state-alloc-var state)
        [(Alloc allocated restore-var)
          (Ok
            (lower-state-emit
              allocated
              (Call
                restore-var
                (lower-tl-arena-set-symbol)
                (One (Var arena-var))
                (Unit))))])
      (Err (box (lower-diagnostic "lower: missing arena restore binding"))))))

(define (lower-cleanup-stack-empty) : LowerCleanupStack
  (LowerCleanupStack
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    0))

(define (lower-cleanup-stack-push
  [cleanups : LowerCleanupStack]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : LowerCleanupStack
  (let
    [hidden-name-ids : (__tl_dyn-array i64) cleanups.hidden-name-ids]
    [cleanup-name-ids : (__tl_dyn-array i64) cleanups.cleanup-name-ids]
    [live-name-ids : (__tl_dyn-array i64) cleanups.live-name-ids]
    [count : i64 cleanups.count]
    (__tl_array-push! hidden-name-ids hidden-name-id)
    (__tl_array-push! cleanup-name-ids cleanup-name-id)
    (__tl_array-push! live-name-ids 0)
    (LowerCleanupStack
      hidden-name-ids
      cleanup-name-ids
      live-name-ids
      (+ count 1))))

(define (lower-cleanup-stack-push-move-aware
  [cleanups : LowerCleanupStack]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]
  [live-name-id : i64]) : LowerCleanupStack
  (let
    [hidden-name-ids : (__tl_dyn-array i64) cleanups.hidden-name-ids]
    [cleanup-name-ids : (__tl_dyn-array i64) cleanups.cleanup-name-ids]
    [live-name-ids : (__tl_dyn-array i64) cleanups.live-name-ids]
    [count : i64 cleanups.count]
    (__tl_array-push! hidden-name-ids hidden-name-id)
    (__tl_array-push! cleanup-name-ids cleanup-name-id)
    (__tl_array-push! live-name-ids live-name-id)
    (LowerCleanupStack
      hidden-name-ids
      cleanup-name-ids
      live-name-ids
      (+ count 1))))

(define (lower-emit-cleanup-stack-at
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-ids : (__tl_dyn-array i64)]
  [cleanup-name-ids : (__tl_dyn-array i64)]
  [live-name-ids : (__tl_dyn-array i64)]
  [index : i64]) : ResultLowerState
  (if (< index 0)
    (Ok state)
    (let
      [live-name-id : i64 (array-ref live-name-ids index)]
      [next-state : LowerState
        (try
          (if (= live-name-id 0)
            (lower-emit-cleanup-call
              state
              env
              (array-ref hidden-name-ids index)
              (array-ref cleanup-name-ids index))
            (lower-emit-cleanup-call-if-live
              state
              env
              (array-ref hidden-name-ids index)
              (array-ref cleanup-name-ids index)
              live-name-id)))]
      (lower-emit-cleanup-stack-at
        next-state
        env
        hidden-name-ids
        cleanup-name-ids
        live-name-ids
        (- index 1)))))

(define (lower-emit-cleanup-stack
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [cleanups : LowerCleanupStack]) : ResultLowerState
  (lower-emit-cleanup-stack-at
    state
    env
    cleanups.hidden-name-ids
    cleanups.cleanup-name-ids
    cleanups.live-name-ids
    (- cleanups.count 1)))

(define (lower-emit-cleanup-marker-tuple
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [types : ast.AstTypeList]) : ResultLowerState
  (if (or
    (= (ast.ast-type-list-len (& types)) 2)
    (= (ast.ast-type-list-len (& types)) 3))
    (let
      [hidden-ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get (& types) 0 (ast.ast-type-id-fallback)))]
      [cleanup-ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get (& types) 1 (ast.ast-type-id-fallback)))]
      (match hidden-ty
        [(Var hidden-name)
          (match cleanup-ty
            [(Var cleanup-name)
              (if (= (ast.ast-type-list-len (& types)) 2)
                (lower-emit-cleanup-call state env hidden-name cleanup-name)
                (match (tc_core.tc-context-type-get
                  ctx
                  (ast.ast-type-list-get (& types) 2 (ast.ast-type-id-fallback)))
                  [(Var live-name)
                    (lower-emit-cleanup-call-if-live
                      state
                      env
                      hidden-name
                      cleanup-name
                      live-name)]
                  [_ (Ok state)]))]
            [_ (Ok state)])]
        [_ (Ok state)]))
    (Ok state)))

(define (lower-emit-arena-restore-marker-tuple
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [types : ast.AstTypeList]) : ResultLowerState
  (if (= (ast.ast-type-list-len (& types)) 1)
    (let
      [hidden-ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get (& types) 0 (ast.ast-type-id-fallback)))]
      (match hidden-ty
        [(Var hidden-name) (lower-emit-arena-restore state env hidden-name)]
        [_ (Ok state)]))
    (Ok state)))

;; Emit the cleanup/region-reset calls a binding env keeps active. This
;; walks the whole TcTypeEnv chain once per scope exit. It iterates rather than
;; tail-recursing: the inline-aggregate TCO guard declines frame reuse here, so
;; a recursive walk stacks one large frame per binding of a deep env.
(define (lower-emit-active-exits-with
  [ctx : tc_core.TcContext]
  [cleanup-marker-id : i64]
  [region-reset-marker-id : i64]
  [stop-id : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerState
  (let
    [cur-env : tc_core.TcTypeEnv type-env]
    [cur-state : LowerState state]
    [result : ResultLowerState
      (Err (box (lower-diagnostic "lower: internal active-exits walk")))]
    [done : bool false]
    (while (not done)
      (match (tc_core.tc-type-env-spine-step cur-env)
        [(Done)
          (set! result (Ok cur-state))
          (set! done true)]
        [(Cache rest-env) (set! cur-env rest-env)]
        [(Bind key ty rest-env)
          ;; A return stops at the hygiene global boundary, which closes
          ;; the function-local scope: cleanup/region-reset markers are
          ;; only ever bound above it by body forms (with-resource/
          ;; with-arena), never in the module or top env below. Stopping
          ;; there avoids walking the whole program spine on every
          ;; return. A break or continue stops at the
          ;; innermost loop target.
          ;; lint-allow: nested-if-ladder
          (if (= key stop-id)
            (begin
              (set! result (Ok cur-state))
              (set! done true))
            (if (= key cleanup-marker-id)
              (match ty
                [(Tuple types)
                  (match (lower-emit-cleanup-marker-tuple
                    ctx
                    cur-state
                    env
                    (deref types))
                    [(Ok next-state) (set! cur-state next-state)]
                    [(Err message)
                      (set! result (Err message))
                      (set! done true)])]
                [_ unit])
              (if (= key region-reset-marker-id)
                (match ty
                  [(Var hidden-name)
                    (match (lower-emit-region-reset cur-state env hidden-name)
                      [(Ok next-state) (set! cur-state next-state)]
                      [(Err message)
                        (set! result (Err message))
                        (set! done true)])]
                  [(Tuple types)
                    (match (lower-emit-arena-restore-marker-tuple
                      ctx
                      cur-state
                      env
                      (deref types))
                      [(Ok next-state) (set! cur-state next-state)]
                      [(Err message)
                        (set! result (Err message))
                        (set! done true)])]
                  [_ unit])
                unit)))
          (if done
            unit
            (set! cur-env rest-env))]))
    result))

(define (lower-emit-active-exits
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerState
  (lower-emit-active-exits-with
    ctx
    (cis.intern-lower-private-identity-raw (lower-cleanup-marker-id state))
    (cis.intern-lower-private-identity-raw (lower-region-reset-marker-id state))
    (tc_core.tc-hygiene-global-boundary-id)
    state
    env
    type-env))

(define (lower-loop-target-type
  [break-label-id : i64]
  [continue-label-id : i64]) : ast.AstType
  (Tuple
    (box
      (ast.ast-type-cons
        (Var break-label-id)
        (ast.ast-type-cons (Var continue-label-id) (ast.ast-type-list-new))))))

(define (lower-enter-loop-target
  [type-env : tc_core.TcTypeEnv]
  [break-label-id : i64]
  [continue-label-id : i64]) : tc_core.TcTypeEnv
  (tc_core.tc-bind-id
    type-env
    (tc_core.tc-loop-target-id)
    (lower-loop-target-type break-label-id continue-label-id)))

(define (lower-loop-target-missing
  [ctx : tc_core.TcContext]
  [origin : ast.AstExpr]
  [form : String]) : ResultLowerLoopTarget
  (Err
    (box
      (lower-diagnostic-at-expr
        ctx
        origin
        (str_cat.str-cat "typecheck: " form " requires enclosing scalar while")))))

(define (lower-loop-target-malformed
  [ctx : tc_core.TcContext]
  [origin : ast.AstExpr]) : ResultLowerLoopTarget
  (Err
    (box (lower-diagnostic-at-expr ctx origin "lower: malformed loop target"))))

(define (lower-current-loop-target-from-types
  [state : LowerState]
  [ctx : tc_core.TcContext]
  [origin : ast.AstExpr]
  [break-ty : ast.AstType]
  [continue-ty : ast.AstType]) : ResultLowerLoopTarget
  (match break-ty
    [(Var break-name)
      (match continue-ty
        [(Var continue-name)
          (Ok
            (Target
              (lower-loop-label-name
                state
                (cis.InternLowerPrivateIdentity break-name))
              (lower-loop-label-name
                state
                (cis.InternLowerPrivateIdentity continue-name))))]
        [_ (lower-loop-target-malformed ctx origin)])]
    [_ (lower-loop-target-malformed ctx origin)]))

(define (lower-current-loop-target
  [state : LowerState]
  [ctx : tc_core.TcContext]
  [origin : ast.AstExpr]
  [type-env : tc_core.TcTypeEnv]
  [form : String]) : ResultLowerLoopTarget
  (match (tc_core.tc-env-marker-type type-env (tc_core.tc-loop-target-id))
    [(Some ty)
      (match ty
        [(Tuple types-box)
          (let
            [types : ast.AstTypeList (deref types-box)]
            (if (= (ast.ast-type-list-len (& types)) 2)
              (let
                [break-ty : ast.AstType
                  (tc_core.tc-context-type-get
                    ctx
                    (ast.ast-type-list-get
                      (& types)
                      0
                      (ast.ast-type-id-fallback)))]
                [continue-ty : ast.AstType
                  (tc_core.tc-context-type-get
                    ctx
                    (ast.ast-type-list-get
                      (& types)
                      1
                      (ast.ast-type-id-fallback)))]
                (lower-current-loop-target-from-types
                  state
                  ctx
                  origin
                  break-ty
                  continue-ty))
              (lower-loop-target-malformed ctx origin)))]
        [_ (lower-loop-target-missing ctx origin form)])]
    [(No) (lower-loop-target-missing ctx origin form)]))

(define (lower-emit-active-loop-exits
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]) : ResultLowerState
  (lower-emit-active-exits-with
    ctx
    (cis.intern-lower-private-identity-raw (lower-cleanup-marker-id state))
    (cis.intern-lower-private-identity-raw (lower-region-reset-marker-id state))
    (tc_core.tc-loop-target-id)
    state
    env
    type-env))

(define (lower-loop-control-form
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [origin : ast.AstExpr]
  [form : String]) : ResultLowerExpr
  (let
    [target
      (try
        (lower-current-loop-target
          state
          ctx
          (lower-global-shared-view origin)
          type-env
          (lower-global-shared-view form)))]
    (match target
      [(Target break-label continue-label)
        (let
          [exit-state
            (try (lower-emit-active-loop-exits ctx state env type-env))]
          (Ok
            (Expr
              (lower-state-emit-at-expr
                ctx
                exit-state
                (Jump
                  (if (string.eq form "break")
                    break-label
                    continue-label))
                origin)
              Unit
              (Never))))])))

(define (lower-return-form
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-current-return-type type-env)
    [(Ok return-ty)
      (let
        [lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view value)
              (lower-global-shared-view return-ty)
              value))]
        (match lowered
          [(Expr value-state value-ir _)
            (let
              [return-copy
                (try
                  (lower-prepare-internal-return-value
                    ctx
                    value-state
                    env
                    value-ir
                    (lower-global-shared-view return-ty)))]
              (match return-copy
                [(Expr return-state return-value _)
                  (let
                    [cleanup-state : LowerState
                      (try
                        (lower-emit-active-exits ctx return-state env type-env))]
                    (Ok
                      (Expr
                        (lower-state-emit-at-expr
                          ctx
                          cleanup-state
                          (Return (lower-return-maybe return-value return-ty))
                          origin)
                        Unit
                        (Never))))]))]))]
    [(Err _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "typecheck: return requires enclosing function")))]))

(define (lower-load-single-payload
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view resolved)
      [(Unit) (Expr state Unit resolved)]
      ;; A Result/Option payload (offset 8 past the i64 tag) can be an
      ;; inline struct/enum; materialize it via the inline-aware load.
      [_ (lower-load-inline-value-at-offset ctx state base 8 resolved)])))

(define (lower-result-info-variant-handle-or
  [ctx : tc_core.TcContext]
  [info : tc_core.TcResultInfo]
  [variant-id : i64]
  [fallback : i64]) : i64
  (let
    [enum-name-id : i64 (tc_core.tc-result-info-enum-id info)]
    [qualified-module-id : i64
      (tc_core.tc-qualified-name-module-id enum-name-id)]
    [module-id : i64
      (if (>= qualified-module-id 0)
        qualified-module-id
        (tc_core.tc-context-module-id ctx))]
    (if (or (< enum-name-id 0) (< variant-id 0))
      fallback
      (csym.compiler-registries-lookup-variant-key-id-or
        (tc_core.tc-context-registries ctx)
        (csym.compiler-symbol-module-key-id-by-id
          module-id
          (csym.compiler-enum-qualified-variant-name-id
            (tc_core.tc-qualified-name-base-id enum-name-id)
            variant-id))
        fallback))))

;; Run the active exits, then return the already-built result value.
(define (lower-return-after-exits
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [ret-ty : ast.AstType]) : ResultLowerState
  (let
    [exit-state : LowerState
      (try (lower-emit-active-exits ctx state env type-env))]
    (Ok
      (lower-state-emit exit-state (Return (lower-return-maybe value ret-ty))))))

;; The error exit of `try` returns the enclosing function's Err variant the way
;; a returned constructor does: written straight into the hidden sret slot when
;; the enum is returned in memory, otherwise built as the value the return ABI
;; carries (the register group of a 16-byte enum). As with `return`, the value
;; is complete before the active exits run, so no scope reset can clobber the
;; payload it is copied from.
(define (lower-return-result-err
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [return-info : tc_core.TcResultInfo]
  [payload : ir.CompilerIrValue]) : ResultLowerState
  (let
    [enum-id : i64
      (tc_core.tc-result-info-enum-id (lower-global-shared-view return-info))]
    [enum-name : String (tc_core.tc-nominal-name-id-display enum-id)]
    [err-id : i64
      (tc_core.tc-result-info-err-id (lower-global-shared-view return-info))]
    [err-name : String
      (tc_core.tc-qualified-variant-name
        (lower-global-shared-view enum-name)
        (tc_core.tc-env-key-name-text err-id))]
    [handle : i64
      (lower-result-info-variant-handle-or
        ctx
        return-info
        err-id
        (csym.compiler-symbols-missing-handle))]
    [ret-ty : ast.AstType (Enum enum-id)]
    [sret-var : i64 (lower-current-sret-var state env)]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (csym.compiler-registries-variant-fields-indexed
        (tc_core.tc-context-symbols ctx)
        handle)
        [(Ok fields)
          (let
            [field-types : ast.AstTypeList
              (lower-variant-payload-fields-for-handle
                ctx
                handle
                (lower-global-shared-view ret-ty)
                fields)]
            ;; An option family's absence variant carries no payload.
            [values : ir.CompilerIrValueSeq
              (if (ast.ast-type-list-empty? (& field-types))
                (ir.compiler-ir-value-seq-empty)
                (ir.compiler-ir-value-seq1 payload))]
            (if (and
              (>= sret-var 0)
              (lower-inline-aggregate-abi-copy-needed?
                ctx
                (lower-global-shared-view ret-ty)))
              (let
                [built : LowerState
                  (try
                    (lower-construct-enum-inline-into-from-values
                      ctx
                      state
                      (Var sret-var)
                      err-name
                      handle
                      values
                      field-types
                      enum-id
                      enum-name))]
                (lower-return-after-exits
                  ctx
                  built
                  env
                  type-env
                  (Var sret-var)
                  ret-ty))
              (let
                [built
                  (try
                    (lower-construct-enum-inline-from-values
                      ctx
                      state
                      err-name
                      handle
                      values
                      field-types
                      enum-name
                      (lower-global-shared-view ret-ty)))]
                (match built
                  [(Expr built-state value _)
                    (let
                      [prepared
                        (try
                          (lower-prepare-internal-return-value
                            ctx
                            built-state
                            env
                            value
                            (lower-global-shared-view ret-ty)))]
                      (match prepared
                        [(Expr ret-state ret-value _)
                          (lower-return-after-exits
                            ctx
                            ret-state
                            env
                            type-env
                            ret-value
                            ret-ty)]))]))))]
        [(Err message) (Err (box (lower-diagnostic message)))])
      (Err
        (box
          (lower-diagnostic
            (str_cat.str-cat "lower: unknown variant " err-name)))))))

;; The try tag/payload reads below address the operand as MEMORY. A
;; register-resident Result/Option (e.g. 16-byte (Ok i64)/(Err i64)) is carried
;; as word(s), so spill it to a temp inline slot first and continue with the
;; slot address; otherwise the tag load dereferences the packed value.
(define (lower-try-spill-resident-operand
  [ctx : tc_core.TcContext]
  [lowered : ResultLowerExpr]) : ResultLowerExpr
  (let
    [expr : LowerExpr (try lowered)]
    (match (lower-global-shared-view expr)
      [(Expr state value ty)
        (if (lower-type-register-resident? ctx (lower-global-shared-view ty))
          (let
            [spilled
              (try
                (lower-copy-inline-aggregate-to-inline
                  ctx
                  state
                  value
                  (lower-global-shared-view ty)))]
            (match spilled
              [(Expr spill-state slot _) (Ok (Expr spill-state slot ty))]))
          (Ok expr))])))

(define (lower-try-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [result-value : ir.CompilerIrValue]
  [operand-info : tc_core.TcResultInfo]
  [return-info : tc_core.TcResultInfo]
  [ok-label : i64]
  [err-label : i64]) : ResultLowerExpr
  (let
    [err-start : LowerState (lower-state-finish-block state err-label)]
    (match (lower-load-single-payload
      ctx
      err-start
      (lower-global-shared-view result-value)
      (tc_core.tc-result-info-err-type (lower-global-shared-view operand-info)))
      [(Expr err-payload-state err-payload _)
        (let
          [returned-state : LowerState
            (try
              (lower-return-result-err
                ctx
                err-payload-state
                env
                type-env
                return-info
                err-payload))]
          [ok-start : LowerState
            (lower-state-finish-block returned-state ok-label)]
          (match (lower-load-single-payload
            ctx
            ok-start
            result-value
            (tc_core.tc-result-info-ok-type operand-info))
            [(Expr ok-state ok-payload ok-ty)
              (Ok (Expr ok-state ok-payload ok-ty))]))])))

(define (lower-try-with-info
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [result-value : ir.CompilerIrValue]
  [operand-info : tc_core.TcResultInfo]
  [return-info : tc_core.TcResultInfo]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [ok-id : i64
      (tc_core.tc-result-info-ok-id (lower-global-shared-view operand-info))]
    [ok-name : String
      (tc_core.tc-qualified-variant-name
        (tc_core.tc-nominal-name-id-display
          (tc_core.tc-result-info-enum-id
            (lower-global-shared-view operand-info)))
        (tc_core.tc-env-key-name-text ok-id))]
    [ok-handle : i64
      (lower-result-info-variant-handle-or
        ctx
        (lower-global-shared-view operand-info)
        ok-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? ok-handle)
      (match (lower-load-at-offset state result-value 0 (I64))
        [(Expr tag-state tag-value _)
          (match (lower-state-alloc-var tag-state)
            [(Alloc eq-alloc eq-var)
              (match (lower-state-fresh-label eq-alloc "try_ok")
                [(Label ok-label-state ok-label)
                  (match (lower-state-fresh-label ok-label-state "try_err")
                    [(Label err-label-state err-label)
                      (let
                        [eq-state : LowerState
                          (lower-state-emit-at-expr
                            ctx
                            err-label-state
                            (BinOp
                              eq-var
                              Eq
                              tag-value
                              (I64
                                (csym.compiler-registry-handle-child-index
                                  ok-handle))
                              (I64))
                            origin)]
                        (lower-try-finish
                          ctx
                          (lower-state-emit
                            eq-state
                            (Branch (Var eq-var) ok-label err-label))
                          env
                          type-env
                          result-value
                          operand-info
                          return-info
                          ok-label
                          err-label))])])])])
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            (str_cat.str-cat "lower: unknown variant " ok-name)))))))

(define (lower-try
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [lowered : LowerExpr
      (try
        (lower-try-spill-resident-operand
          ctx
          (lower-expr ctx state env type-env inner)))]
    (match lowered
      [(Expr result-state result-value result-ty)
        (match (tc_core.tc-current-return-type type-env)
          [(Ok return-ty)
            (match (tc_core.tc-try-query
              ctx
              result-ty
              return-ty
              TcTryEarlyExitAllowed)
              [(TcTryQueryCompatible operand-info return-info)
                (lower-try-with-info
                  ctx
                  result-state
                  env
                  type-env
                  result-value
                  operand-info
                  return-info
                  origin)]
              [(TcTryQueryIncompatible _ _ reason)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      (tc_core.tc-try-incompatibility-message reason))))])]
          [(Err _)
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  "typecheck: try requires enclosing Result-like function")))])])))

(define (lower-top-level-value-handle-id
  [ctx : tc_core.TcContext]
  [name-id : i64]) : i64
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
    [module : String (tc_core.tc-context-module ctx)]
    [module-id : i64 (tc_core.tc-context-module-id ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not
        (tc_core.tc-name-qualified-id?
          (tc_core.tc-context-structural-session ctx)
          name-id)))
      (csym.compiler-symbols-lookup-value-in-module-id-or
        symbols
        module-id
        name-id
        (csym.compiler-symbols-missing-handle))
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        name-id
        (csym.compiler-symbols-missing-handle)))))

(define (lower-top-level-value-defined-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (csym.compiler-symbols-handle-found?
    (lower-top-level-value-handle-id ctx name-id)))

;; A bare `stdlib.string` helper spelling (`string-concat`, `string-eq`, ...)
;; is shadowed only by a local or by the definition an ordinary call of that
;; spelling reaches through the lowering name cache: one the current module
;; declares, or one it imports unqualified (`m.*`, `m.item`), which resolves to
;; that module's key.
;; The runtime prelude's private helpers (its `string-concat` implements the
;; `tl_string_concat` ABI) and stdlib.string's own definitions are what the
;; spelling names, not shadows of it. An unresolved bare name in the root file
;; also reaches other modules' bare alias keys; the root can name those
;; definitions only qualified, so they do not shadow either.
(define (lower-stdlib-string-helper-unshadowed-id?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [state : LowerState]
  [name-id : i64]) : bool
  (and
    (not (sym_i64_env.sym-i64-contains-id env name-id))
    (let
      [names : LowerNameCache (lower-state-names state)]
      [resolved-id : i64
        (lower-name-cache-resolve-logical-id (& names) name-id name-id)]
      [handle : i64 (lower-top-level-value-handle-id ctx resolved-id)]
      (or
        (not (csym.compiler-symbols-handle-found? handle))
        (let
          [owner : i64
            (csym.compiler-symbols-owner-module-id-at-index-or
              (tc_core.tc-context-symbols ctx)
              (csym.compiler-symbol-handle-index handle)
              -1)]
          [module : String (tc_core.tc-context-module ctx)]
          (or
            (= owner cbi.compiler-builtin-id-runtime-module)
            (= owner cbi.compiler-builtin-id-fix-stdlib_dot_string)
            (and
              (= (string.string-length module) 0)
              (not (csym.compiler-symbol-root-module-id? owner))
              (not
                (tc_core.tc-name-qualified-id?
                  (tc_core.tc-context-structural-session ctx)
                  resolved-id)))))))))

(define (lower-top-level-callable-defined-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
    [module : String (tc_core.tc-context-module ctx)]
    [module-id : i64 (tc_core.tc-context-module-id ctx)]
    [handle : i64
      (if (and
        (> (string.string-length module) 0)
        (not
          (tc_core.tc-name-qualified-id?
            (tc_core.tc-context-structural-session ctx)
            name-id)))
        (csym.compiler-symbols-lookup-value-in-module-id-or
          symbols
          module-id
          name-id
          (csym.compiler-symbols-missing-handle))
        (csym.compiler-symbols-lookup-value-id-or
          symbols
          name-id
          (csym.compiler-symbols-missing-handle)))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [kind : i64 (csym.compiler-symbol-handle-kind handle)]
        (or
          (= kind (csym.compiler-symbol-kind-function-define))
          (= kind (csym.compiler-symbol-kind-extern))
          (= kind (csym.compiler-symbol-kind-defdispatch))))
      false)))

(define (lower-top-level-callable-lookup-id?
  [ctx : tc_core.TcContext]
  [lookup-id : i64]) : bool
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        (tc_core.tc-context-symbols ctx)
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [kind : i64 (csym.compiler-symbol-handle-kind handle)]
        (or
          (= kind (csym.compiler-symbol-kind-function-define))
          (= kind (csym.compiler-symbol-kind-extern))
          (= kind (csym.compiler-symbol-kind-defdispatch))))
      false)))

(define (lower-top-level-value-define-lookup-id?
  [ctx : tc_core.TcContext]
  [lookup-id : i64]) : bool
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        (tc_core.tc-context-symbols ctx)
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-value-define)))))

(define (lower-callable-lookup-id
  [ctx : tc_core.TcContext]
  [source-id : i64]
  [lookup-id : i64]) : i64
  (let
    [module : String (tc_core.tc-context-module ctx)]
    [module-id : i64 (tc_core.tc-context-module-id ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not
        (tc_core.tc-name-qualified-id?
          (tc_core.tc-context-structural-session ctx)
          source-id))
      (lower-top-level-callable-defined-id? ctx source-id))
      (csym.compiler-symbol-module-key-id-by-id module-id source-id)
      lookup-id)))

(define (lower-builtin-call-available-id?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]) : bool
  (and
    (not (sym_i64_env.sym-i64-contains-id env name-id))
    (not (lower-top-level-value-defined-id? ctx name-id))))

(define (lower-top-level-builtin-available-id?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : bool
  (if (cbi.compiler-builtin-private-intrinsic-id? name-id)
    (tc_core.tc-private-intrinsic-unshadowed-id? ctx type-env name-id)
    (not (lower-top-level-value-defined-id? ctx name-id))))

(define (lower-string-runtime-builtin? [name : String]) : bool
  (let
    [_ : String name]
    false))

;; First-class arena primitives. arena-mark/arena-rewind reuse the
;; existing region runtime (they snapshot/rewind the current arena's bump).
(define (lower-arena-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-arena-id? name-id))

(define (lower-arena-builtin-nullary-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-arena-nullary-id? name-id))

(define (lower-arena-builtin-symbol-id [name-id : i64]) : i64
  (cbi.compiler-builtin-refresh!)
  (cond
    [(cbi.compiler-builtin-lower-arena-make-id? name-id)
      cbi.compiler-builtin-id-tl-arena-make]
    [(cbi.compiler-builtin-lower-arena-make-atomic-id? name-id)
      cbi.compiler-builtin-id-tl-arena-make-atomic]
    [(cbi.compiler-builtin-lower-arena-current-id? name-id)
      (lower-tl-arena-current-symbol)]
    [(cbi.compiler-builtin-lower-arena-mark-id? name-id)
      (lower-tl-region-mark-symbol)]
    [(cbi.compiler-builtin-lower-arena-set-id? name-id)
      (lower-tl-arena-set-symbol)]
    [(cbi.compiler-builtin-lower-arena-destroy-id? name-id)
      cbi.compiler-builtin-id-tl-arena-destroy]
    [else (lower-tl-region-reset-symbol)]))

(define (lower-arena-builtin-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-arena-builtin-nullary-id? name-id)
    (lower-runtime-call-values
      state
      (lower-arena-builtin-symbol-id name-id)
      (ir.compiler-ir-value-seq-empty)
      result-ty)
    (if (= args.len 1)
      (let
        [arg : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
        [lowered (try (lower-expr ctx state env type-env arg))]
        (match lowered
          [(Expr arg-state arg-value arg-ty)
            (match (lower-cast-value arg-state arg-value arg-ty (I64))
              [(Expr cast-state cast-value _)
                (lower-runtime-call-values
                  cast-state
                  (lower-arena-builtin-symbol-id name-id)
                  (ir.compiler-ir-value-seq1 cast-value)
                  result-ty)])]))
      (Err (box (lower-diagnostic "lower: arena builtin expects one argument"))))))

(define (lower-tls-current-arena-read-call
  [state : LowerState]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (= args.len 0)
    (lower-runtime-call-values
      state
      cbi.compiler-builtin-id-tl-tls-current-arena-load
      (ir.compiler-ir-value-seq-empty)
      result-ty)
    (Err
      (box (lower-diagnostic "lower: tls-current-arena expects no arguments")))))

(define (lower-tls-current-arena-set-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [lowered (try (lower-expr ctx state env type-env arg))]
      (match lowered
        [(Expr arg-state arg-value arg-ty)
          (match (lower-cast-value arg-state arg-value arg-ty (I64))
            [(Expr cast-state cast-value _)
              (lower-runtime-call-values
                cast-state
                cbi.compiler-builtin-id-tl-tls-current-arena-store
                (ir.compiler-ir-value-seq1 cast-value)
                result-ty)])]))
    (Err
      (box
        (lower-diagnostic
          "lower: tls-current-arena-set! expects exactly one argument")))))

(define (lower-tls-current-arena-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (cbi.compiler-builtin-lower-tls-current-arena-read-id? name-id)
    (lower-tls-current-arena-read-call state args result-ty)
    (lower-tls-current-arena-set-call ctx state env type-env args result-ty)))

(define (lower-float-sqrt-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [lowered
        (try
          (lower-expr-expected
            ctx
            state
            env
            type-env
            (lower-global-shared-view arg)
            (lower-global-shared-view result-ty)
            arg))]
      (match lowered
        [(Expr arg-state arg-value _)
          (match (lower-state-alloc-var arg-state)
            [(Alloc allocated var-id)
              (Ok
                (Expr
                  (lower-state-emit-at-expr
                    ctx
                    allocated
                    (UnOp
                      var-id
                      (Sqrt)
                      arg-value
                      (lower-global-shared-view result-ty))
                    origin)
                  (Var var-id)
                  result-ty))])]))
    (Err
      (box
        (lower-diagnostic-at-expr
          ctx
          origin
          "lower: __tl_float_sqrt expects exactly one argument")))))

(define (lower-float-literal-to-bits-value
  [lit : ast.AstLiteral]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerMaybeIrValue
  (match lit
    [(Float text)
      (if (lower-literal-float-to-bits?
        (lower-global-shared-view from-ty)
        to-ty)
        (Some (I64 (cast (lower-float-literal-bits text from-ty) : i64)))
        (No))]
    [_ (No)]))

(define (lower-float-bitcast-inner-literal-value
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerMaybeIrValue
  (match expr
    [(Spanned inner-box _)
      (lower-float-bitcast-inner-literal-value
        ctx
        (lower-context-expr-get ctx inner-box)
        from-ty
        to-ty)]
    [(Literal lit) (lower-float-literal-to-bits-value lit from-ty to-ty)]
    [_ (No)]))

(define (lower-float-bitcast-literal-value
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]
  [to-ty : ast.AstType]) : LowerMaybeIrValue
  (match expr
    [(Spanned inner-box _)
      (lower-float-bitcast-literal-value
        ctx
        (lower-context-expr-get ctx inner-box)
        to-ty)]
    [(Ann inner-box from-ty-id)
      (lower-float-bitcast-inner-literal-value
        ctx
        (lower-context-expr-get ctx inner-box)
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type
            ctx
            (tc_core.tc-context-type-get ctx from-ty-id)))
        to-ty)]
    [(Cast inner-box from-ty-id)
      (lower-float-bitcast-inner-literal-value
        ctx
        (lower-context-expr-get ctx inner-box)
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type
            ctx
            (tc_core.tc-context-type-get ctx from-ty-id)))
        to-ty)]
    [(Literal lit)
      (match (tc_core.tc-type-strip-region (lower-global-shared-view to-ty))
        [(U32) (lower-float-literal-to-bits-value lit (F32) to-ty)]
        [_ (lower-float-literal-to-bits-value lit (F64) to-ty)])]
    [_ (No)]))

(define (lower-float-bitcast-literal-call?
  [ctx : tc_core.TcContext]
  [args : (& args ast.AstExprList)]
  [result-ty : ast.AstType]) : bool
  (if (= args.len 1)
    (match (lower-float-bitcast-literal-value
      ctx
      (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))
      result-ty)
      [(Some _) true]
      [(No) false])
    false))

(define (lower-float-bitcast-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (lower-float-bitcast-literal-value
        ctx
        (lower-global-shared-view arg)
        (lower-global-shared-view result-ty))
        [(Some value)
          ;; Mirror ordinary integer literal lowering: one integer `Mov`, no
          ;; float materialization or runtime `Bitcast`.
          (lower-materialize-at-expr ctx state value result-ty origin)]
        [(No)
          (let
            [lowered (try (lower-expr ctx state env type-env arg))]
            (match lowered
              [(Expr arg-state arg-value arg-ty)
                (Ok (lower-bitcast-value arg-state arg-value arg-ty result-ty))]))]))
    (Err
      (box
        (lower-diagnostic-at-expr
          ctx
          origin
          "lower: float bitcast expects exactly one argument")))))

;; Lower `(clone x)`: the canonical deep-copy / arena-escape. A String
;; copies its buffer through `tl_substring`; tuple, fixed-array, and dynamic-
;; array values allocate fresh storage and recursively clone each element; Box
;; values allocate a fresh box for the cloned inner value; named aggregates
;; dispatch to synthesized `clone$<Name>` helpers (compiler_clone.tl) so
;; recursive enum/struct values recurse at runtime instead of lower time; and
;; scalar values are returned as-is.
;; sret ABI: the synthesized `clone$<Name>` helper returns an aggregate,
;; so it carries the hidden sret param; append the result-slot pointer here to
;; match (the same gate as the helper's definition, so a non-aggregate clone$
;; target -- e.g. a type variable -- passes only the value).
(define (lower-clone-type-key-id [ctx : tc_core.TcContext] [name-id : i64]) : i64
  (let
    [fallback : i64
      (if (csym.compiler-composite-pair-key-id? name-id)
        name-id
        (clone_support.clone-name-key-id-in-module
          (tc_core.tc-context-module-id ctx)
          name-id))]
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc_core.tc-context-symbols ctx)
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (tc_core.tc-nominal-owner-id-or ctx handle fallback)
      fallback)))

(define (lower-clone-helper-lookup-id
  [type-key-id : i64]
  [helper-name-id : i64]) : i64
  (if (clone_support.clone-name-key-qualified? type-key-id)
    (csym.compiler-symbol-module-key-id-by-id
      (clone_support.clone-name-key-module-id type-key-id)
      helper-name-id)
    helper-name-id))

(define (lower-clone-named
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (let
    [requested-key-id : i64 (lower-clone-type-key-id ctx name-id)]
    [type-key-id : i64
      (lower-name-cache-clone-key-id (lower-state-names state) requested-key-id)]
    [helper-name-id : i64
      (if (< type-key-id 0)
        -1
        (lower-name-cache-clone-helper-id (lower-state-names state) type-key-id))]
    (if (< helper-name-id 0)
      (Err
        (box
          (lower-diagnostic
            (str_cat.str-cat
              "lower: missing generated clone helper for "
              (tc_core.tc-nominal-name-id-display name-id)))))
      (match (lower-call-append-sret-arg
        ctx
        state
        (ir.compiler-ir-value-seq1 value)
        (lower-global-shared-view ty))
        [(Ok sret-state sret-values)
          (match (lower-state-alloc-var sret-state)
            [(Alloc allocated var-id)
              (let
                [call-name : i64
                  (lower-resolve-call-name-id
                    allocated
                    env
                    (lower-clone-helper-lookup-id type-key-id helper-name-id))]
                (Ok
                  (Expr
                    (lower-state-emit
                      allocated
                      (Call
                        var-id
                        call-name
                        (lower-call-args-with-nominal-sret
                          ctx
                          sret-values
                          (lower-global-shared-view ty))
                        (lower-global-shared-view ty)))
                    (Var var-id)
                    ty)))])]
        [(Err message) (Err message)]))))

(define (lower-clone-scalar-type? [ty : ast.AstType]) : bool
  (match ty
    [(I64) true]
    [(I32) true]
    [(I16) true]
    [(I8) true]
    [(U64) true]
    [(U32) true]
    [(U16) true]
    [(U8) true]
    [(F64) true]
    [(F32) true]
    [(Bool) true]
    [(Char) true]
    [(Unit) true]
    [(Never) true]
    [_ false]))

(define (lower-clone-bulk-copy-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [clone-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view clone-ty)
      [(Struct _) (lower-type-register-resident? ctx clone-ty)]
      [(StructArgs _ _) (lower-type-register-resident? ctx clone-ty)]
      [(Enum _) (lower-type-register-resident? ctx clone-ty)]
      [(EnumArgs _ _) (lower-type-register-resident? ctx clone-ty)]
      [_ (lower-clone-scalar-type? clone-ty)])))

(define (lower-clone-dynarray-advance
  [state : LowerState]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(Alloc inc-alloc inc-var)
      (Ok
        (lower-state-finish-block
          (lower-state-emit
            (lower-state-emit
              (lower-state-emit
                inc-alloc
                (BinOp inc-var Add (Var index-var) (I64 1) (I64)))
              (Mov index-var (Var inc-var) (I64)))
            (Jump header-label))
          exit-label))]))

(define (lower-clone-dynarray-store-and-advance
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [new-buf : ir.CompilerIrValue]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]
  [clone-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    new-buf
    (Var index-var)
    (lower-global-shared-view elem-ty))
    [(Expr dst-gep-state dst-ptr _)
      (lower-clone-dynarray-advance
        (lower-array-elem-store-state
          ctx
          dst-gep-state
          dst-ptr
          clone-value
          elem-ty)
        index-var
        header-label
        exit-label)]))

(define (lower-clone-dynarray-copy-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]
  [elem-ty : ast.AstType]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    old-buf
    (Var index-var)
    (lower-global-shared-view elem-ty))
    [(Expr src-gep-state src-ptr _)
      (match (lower-load-inline-value-at-offset
        ctx
        src-gep-state
        src-ptr
        0
        (lower-global-shared-view elem-ty))
        [(Expr load-state elem-value _)
          (let
            [cloned
              (try
                (lower-clone-dispatch
                  ctx
                  load-state
                  env
                  type-env
                  elem-value
                  (lower-global-shared-view elem-ty)))]
            (match cloned
              [(Expr clone-state clone-value _)
                (lower-clone-dynarray-store-and-advance
                  ctx
                  clone-state
                  new-buf
                  index-var
                  header-label
                  exit-label
                  clone-value
                  elem-ty)]))])]))

(define (lower-clone-dynarray-copy-nonempty
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : ResultLowerState
  (match (lower-state-fresh-label state "clone_array_header")
    [(Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "clone_array_body")
        [(Label body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "clone_array_exit")
            [(Label exit-label-state exit-label)
              (match (lower-state-alloc-var exit-label-state)
                [(Alloc index-alloc index-var)
                  (let
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            index-alloc
                            (Mov index-var (I64 0) (I64)))
                          (Jump header-label))
                        header-label)]
                    (match (lower-state-alloc-var header-start)
                      [(Alloc cond-alloc cond-var)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                (lower-state-emit
                                  cond-alloc
                                  (BinOp cond-var Lt (Var index-var) len (I64)))
                                (Branch (Var cond-var) body-label exit-label))
                              body-label)]
                          (lower-clone-dynarray-copy-body
                            ctx
                            body-start
                            env
                            type-env
                            old-buf
                            new-buf
                            index-var
                            header-label
                            exit-label
                            elem-ty))]))])])])]))

(define (lower-clone-dynarray-copy-loop
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [byte-count : ir.CompilerIrValue]) : ResultLowerState
  (if (= elem-size 0)
    (Ok state)
    (if (lower-clone-bulk-copy-type? ctx (lower-global-shared-view elem-ty))
      (Ok (lower-emit-memcpy-value state new-buf 0 old-buf 0 byte-count))
      (lower-clone-dynarray-copy-nonempty
        ctx
        state
        env
        type-env
        old-buf
        new-buf
        len
        elem-ty))))

(define (lower-clone-dynarray-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [old-buf : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [byte-count : ir.CompilerIrValue]
  [buf-var : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 result-ty)
    [(Expr arr-state arr-value _)
      (let
        [copied-state
          (try
            (lower-clone-dynarray-copy-loop
              ctx
              arr-state
              env
              type-env
              old-buf
              (Var buf-var)
              (lower-global-shared-view len)
              elem-ty
              elem-size
              byte-count))]
        (Ok
          (Expr
            (lower-store-at-offset
              (lower-store-at-offset
                copied-state
                arr-value
                0
                (Var buf-var)
                (U64))
              arr-value
              8
              len
              (I64))
            arr-value
            result-ty)))]))

(define (lower-clone-dynarray-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-load-at-offset state value 8 (I64))
    [(Expr len-state len _)
      (match (lower-load-at-offset len-state value 0 (U64))
        [(Expr ptr-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            (match (if (= elem-size 0)
              (Expr ptr-state (I64 1) (I64))
              (lower-emit-binop
                ptr-state
                Mul
                (lower-global-shared-view len)
                (I64 elem-size)
                (I64)))
              [(Expr byte-state byte-count _)
                (match (lower-state-alloc-var byte-state)
                  [(Alloc buf-alloc buf-var)
                    (lower-clone-dynarray-finish
                      ctx
                      (lower-state-emit
                        buf-alloc
                        (Call
                          buf-var
                          (lower-tl-alloc-symbol)
                          (One (lower-global-shared-view byte-count))
                          (U64)))
                      env
                      type-env
                      old-buf
                      len
                      elem-ty
                      elem-size
                      byte-count
                      buf-var
                      result-ty)])]))])]))

(define (lower-clone-box-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [inner-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  ;; A (Box T) with inline struct/enum T addresses the T storage at the
  ;; box pointer; load it as a value (pointer) rather than scalar-loading the
  ;; leading word, mirroring lower-box-get.
  (match (lower-load-inline-value-at-offset
    ctx
    state
    value
    0
    (lower-global-shared-view inner-ty))
    [(Expr load-state inner-value _)
      (let
        [cloned
          (try
            (lower-clone-dispatch
              ctx
              load-state
              env
              type-env
              inner-value
              (lower-global-shared-view inner-ty)))]
        (match cloned
          [(Expr clone-state clone-value _)
            (match (lower-reserve-heap-storage
              clone-state
              (lower-type-size ctx inner-ty)
              result-ty)
              [(Expr box-state box-value _)
                (Ok
                  (Expr
                    (lower-store-inline-value-at-offset
                      ctx
                      box-state
                      box-value
                      0
                      clone-value
                      (lower-global-shared-view inner-ty)
                      (lower-type-size ctx inner-ty))
                    box-value
                    result-ty))])]))]))

;; SROA-2 item 2. A memory-resident nominal aggregate whose every field and
;; payload is Copy -- no owning handle anywhere inside it, no `cleanup`
;; destructor on any declaration it reaches, which is exactly what the move
;; checker's `tc-type-copyable?` decides -- has nothing for a generated clone
;; helper to do beyond reproducing its bytes. The helper spells that as a match
;; on the tag with a per-arm rebuild into an sret buffer, and after the
;; aggregate word split that match survives as phis over the arms even though
;; the value it produces is the source verbatim. Lower it as the whole-buffer
;; copy it is: one fresh inline buffer and one `copy_bytes`, which the split
;; then turns into word loads from the source with no match at all.
;;
;; This is the lowering half of the packet's item 2 rather than a fold in the
;; split, because the split can only ever recover the copy from a shape it has
;; to re-prove per call site, and this decides it once from the type.
(define (lower-clone-whole-buffer-copy?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (tc_core.tc-type-copyable? ctx ty))

(define (lower-clone-dispatch
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ResultLowerExpr
  (let
    [clone-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view clone-ty)
      [(String) (lower-capture-snapshot-string-value state value)]
      [(Tuple elem-tys)
        (lower-copy-tuple-value
          ctx
          state
          env
          type-env
          (Clone)
          value
          (deref elem-tys)
          clone-ty)]
      [(Array elem-ty count)
        (lower-copy-fixed-array-value
          ctx
          state
          env
          type-env
          (Clone)
          value
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx elem-ty))
          count
          clone-ty)]
      [(DynArray elem-ty)
        (lower-clone-dynarray-value
          ctx
          state
          env
          type-env
          value
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx elem-ty))
          clone-ty)]
      [(Box elem-ty)
        (lower-clone-box-value
          ctx
          state
          env
          type-env
          value
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx elem-ty))
          clone-ty)]
      ;; A register-resident aggregate is word-class POD held in a
      ;; register, so cloning it is a value copy -- no deep-clone helper, no
      ;; memory traversal.
      [(Enum name)
        (cond
          [(lower-type-register-resident?
              ctx
              (lower-global-shared-view clone-ty))
            (Ok (Expr state value clone-ty))]
          [(lower-clone-whole-buffer-copy?
              ctx
              (lower-global-shared-view clone-ty))
            (lower-copy-inline-aggregate-to-inline ctx state value clone-ty)]
          [else (lower-clone-named ctx state env name value clone-ty)])]
      [(Struct name)
        (cond
          [(lower-type-register-resident?
              ctx
              (lower-global-shared-view clone-ty))
            (Ok (Expr state value clone-ty))]
          [(lower-clone-whole-buffer-copy?
              ctx
              (lower-global-shared-view clone-ty))
            (lower-copy-inline-aggregate-to-inline ctx state value clone-ty)]
          [else (lower-clone-named ctx state env name value clone-ty)])]
      [(Var name) (lower-clone-named ctx state env name value clone-ty)]
      [_
        (if (lower-clone-scalar-type? (lower-global-shared-view clone-ty))
          (Ok (Expr state value clone-ty))
          (Err
            (box
              (lower-diagnostic
                (str_cat.str-cat
                  "lower: clone unsupported type "
                  (tc_core.tc-type-render clone-ty))))))])))

(define (lower-clone-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]) : ResultLowerExpr
  (let
    [lowered : LowerExpr (try (lower-expr ctx state env type-env arg))]
    (match lowered
      [(Expr arg-state arg-value arg-ty)
        (lower-clone-dispatch ctx arg-state env type-env arg-value arg-ty)])))

(define (lower-call-explicit-mut-borrow-var-id
  [ctx : tc_core.TcContext]
  [arg : ast.AstExpr]) : tc_core.TcMaybeNameId
  (match (ast.ast-expr-unspan arg)
    [(Borrow mutable _ place-box)
      (if mutable
        (match (ast.ast-expr-unspan (lower-context-expr-get ctx place-box))
          [(Var name) (Some name)]
          [_ (No)])
        (No))]
    [_ (No)]))

;; Pack a borrowed fixed-array reference into the structural Slice ABI group.
;; The source expression is lowered exactly once; word0 is its data pointer and
;; word1 is the compile-time fixed length.  This helper is called only after
;; the typechecker has accepted the closed call-only unsize predicate.
(define (lower-call-array-ref-to-slice-pack
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [expected : ast.AstType]
  [actual : ast.AstType]) : ResultLowerExpr
  (let
    [actual-resolved : ast.AstType
      (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (lower-global-shared-view actual)))]
    [array-len : i64
      (match actual-resolved
        [(Ref _ inner)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx inner)))
            [(Array _ count) count]
            [_ -1])]
        [(MutRef _ inner)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx inner)))
            [(Array _ count) count]
            [_ -1])]
        [_ -1])]
    (if (< array-len 0)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            arg
            "lower: Slice unsize requires fixed-array reference")))
      (let
        [lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view arg)
              (tc_core.tc-type-without-regions actual)
              arg))]
        (match lowered
          [(Expr arg-state value value-ty)
            (match (lower-emit-cast arg-state value value-ty (U64))
              [(Expr cast-state ptr _)
                (Ok
                  (lower-emit-pack
                    cast-state
                    (ir.compiler-ir-value-seq2 ptr (I64 array-len))
                    (tc_core.tc-type-without-regions expected)))])])))))

(define (lower-call-arg-normal-basic
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [effective-arg : ast.AstExpr]
  [arg-ty : ast.AstType]) : ResultLowerCallArg
  (let
    [lowered : LowerExpr
      (try
        (lower-expr-expected ctx state env type-env effective-arg arg-ty arg))]
    (match lowered
      [(Expr arg-state value _) (Ok (Arg arg-state value (No)))])))

;; The type fact recorded for an explicit borrow can be contextualized to the
;; Slice formal by the time lowering runs, so it no longer describes the
;; borrowed place's fixed-array referent. Recover that provenance only on the
;; Slice-formal path. Other argument forms retain the ordinary fact lookup,
;; which is needed for variables that already hold an Array or Slice reference.
(define (lower-call-slice-formal-actual-type
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [effective-arg : ast.AstExpr]) : tc_core.ResultTcType
  (match (ast.ast-expr-unspan (lower-global-shared-view effective-arg))
    [(Borrow mutable _ place-box)
      (let
        [place-expr : ast.AstExpr (lower-context-expr-get ctx place-box)]
        [place : tc_core.TcBorrowPlace
          (try
            (tc_core.tc-borrow-place
              ctx
              (tc_core.tc-context-expr-bases ctx)
              type-env
              place-expr))]
        (match place
          [(TcBorrowPlace lifetime referent-ty)
            (Ok
              (if mutable
                (ast.ast-ty-mut-ref-with-pools
                  (tc_core.tc-context-pools ctx)
                  lifetime
                  referent-ty)
                (ast.ast-ty-ref-with-pools
                  (tc_core.tc-context-pools ctx)
                  lifetime
                  referent-ty)))]))]
    [_ (tc_core.tc-call-arg-expr-type ctx type-env effective-arg)]))

(define (lower-call-arg-normal-as
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [effective-arg : ast.AstExpr]
  [arg-ty : ast.AstType]) : ResultLowerCallArg
  (let
    [disarmed-state : LowerState
      (lower-disarm-move-aware-resource-expr
        state
        env
        (lower-global-shared-view effective-arg))]
    (if (tc_core.tc-call-slice-ref-formal?
      ctx
      (lower-global-shared-view arg-ty))
      (match (lower-call-slice-formal-actual-type
        ctx
        type-env
        (lower-global-shared-view effective-arg))
        [(Ok actual-ty)
          (if (tc_core.tc-call-array-ref-to-slice-ref-shape?
            ctx
            (lower-global-shared-view arg-ty)
            (lower-global-shared-view actual-ty))
            (let
              [packed
                (try
                  (lower-call-array-ref-to-slice-pack
                    ctx
                    disarmed-state
                    env
                    type-env
                    effective-arg
                    arg-ty
                    actual-ty))]
              (match packed
                [(Expr packed-state value _) (Ok (Arg packed-state value (No)))]))
            (lower-call-arg-normal-basic
              ctx
              disarmed-state
              env
              type-env
              arg
              effective-arg
              arg-ty))]
        [(Err _)
          (lower-call-arg-normal-basic
            ctx
            disarmed-state
            env
            type-env
            arg
            effective-arg
            arg-ty)])
      (lower-call-arg-normal-basic
        ctx
        disarmed-state
        env
        type-env
        arg
        effective-arg
        arg-ty))))

(define (lower-call-arg-mut-borrow-var-as
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [effective-arg : ast.AstExpr]
  [arg-ty : ast.AstType]
  [name-id : i64]) : ResultLowerCallArg
  (match (tc_core.tc-lookup-id type-env name-id)
    [(Ok place-ty)
      (let
        [referent-ty : ast.AstType
          (tc_core.tc-borrow-referent-type (lower-global-shared-view place-ty))]
        [referent-ir-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx (lower-global-shared-view referent-ty)))]
        (if (or
          (tc_core.tc-type-contains-reference? place-ty)
          (lower-borrow-place-value-reference? ctx referent-ty))
          (lower-call-arg-normal-as
            ctx
            state
            env
            type-env
            arg
            effective-arg
            arg-ty)
          (let
            [local-id : i64
              (sym_i64_env.sym-i64-lookup-id-or
                env
                name-id
                (csym.compiler-symbols-missing-handle))]
            (if (csym.compiler-symbols-handle-found? local-id)
              (match (lower-borrow-copy-to-inline-storage
                ctx
                state
                (Var local-id)
                (lower-global-shared-view referent-ir-ty)
                arg-ty)
                [(Expr arg-state storage _)
                  (Ok
                    (Arg
                      arg-state
                      (lower-global-shared-view storage)
                      (Some (Writeback local-id storage referent-ir-ty arg))))])
              (lower-call-arg-normal-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty)))))]
    [(Err _)
      (lower-call-arg-normal-as ctx state env type-env arg effective-arg arg-ty)]))

;; Whether any call argument borrows a temporary (section 3.10).
(define (lower-call-args-borrow-temporary?
  [ctx : tc_core.TcContext]
  [args : (& args ast.AstExprList)]) : bool
  (let
    [expr-bases : i64 (tc_core.tc-context-expr-bases ctx)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index args.len))
      (if (tc_core.tc-call-temporary-borrow-arg-id?
        expr-bases
        (ast.ast-expr-list-get args index 0))
        (set! found true)
        unit)
      (set! index (+ index 1)))
    found))

;; The symbol of a cleanup-owning type's declared cleanup function.
(define (lower-cleanup-symbol-for-type
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [ty : ast.AstType]) : tc_core.ResultTcNameId
  (let
    [cleanup-id
      (try (lower-struct-cleanup-id-for-type (lower-state-owner state) ctx ty))]
    (tc_core.ResultTcNameId.Ok
      (lower-resolve-call-name-id state env cleanup-id))))

;; A call argument that borrows a temporary (section 3.10). The operand is
;; evaluated by value into storage that lives until the call returns: an inline
;; aggregate already denotes its storage, a `String` is its own `str` view, and
;; any other value is copied into a frame slot. A fixed array passed to a
;; `Slice` formal is packed with its length. A cleanup-owning value is cleaned
;; after the call returns.
(define (lower-call-arg-temporary-borrow
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [arg-ty : ast.AstType]) : ResultLowerCallArg
  (let
    [operand : ast.AstExpr
      (lower-context-expr-get
        ctx
        (tc_core.tc-call-temporary-borrow-operand-id
          (tc_core.tc-context-expr-bases ctx)
          (lower-global-shared-view arg)))]
    [hint : ast.AstMaybeType
      (tc_core.tc-call-temporary-referent-hint
        ctx
        (lower-global-shared-view arg-ty)
        (lower-global-shared-view operand))]
    [lowered : ResultLowerExpr
      (match hint
        [(ast.AstMaybeType.Some hint-ty)
          (lower-expr-expected
            ctx
            state
            env
            type-env
            (lower-global-shared-view operand)
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx hint-ty))
            operand)]
        [(ast.AstMaybeType.No) (lower-expr ctx state env type-env operand)])]
    [lowered-operand (try lowered)]
    (match lowered-operand
      [(LowerExpr.Expr value-state value value-ty)
        (let
          [resolved-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx (lower-global-shared-view value-ty)))]
          [copied : bool
            (not
              (or
                (lower-str-ref-type? ctx (lower-global-shared-view arg-ty))
                (lower-borrow-place-value-reference?
                  ctx
                  (lower-global-shared-view resolved-ty))))]
          [stored : LowerExpr
            (if copied
              (lower-borrow-copy-to-inline-storage
                ctx
                value-state
                (lower-global-shared-view value)
                (lower-global-shared-view resolved-ty)
                (lower-global-shared-view arg-ty))
              (LowerExpr.Expr
                value-state
                (lower-global-shared-view value)
                (lower-global-shared-view arg-ty)))]
          (match stored
            [(LowerExpr.Expr stored-state reference _)
              (let
                [passed : LowerExpr
                  (match (tc_core.tc-type-strip-region
                    (lower-global-shared-view resolved-ty))
                    [(ast.AstType.Array _ count)
                      (if (tc_core.tc-call-slice-ref-formal?
                        ctx
                        (lower-global-shared-view arg-ty))
                        (match (lower-emit-cast
                          stored-state
                          (lower-global-shared-view reference)
                          ;; Until packed, this is the array's one-word
                          ;; reference, not the two-word Slice formal.
                          (ast.ast-ty-ref-with-pools
                            (tc_core.tc-context-pools ctx)
                            (tc_core.tc-call-temporary-lifetime-id)
                            (lower-global-shared-view resolved-ty))
                          (ast.AstType.U64))
                          [(LowerExpr.Expr cast-state ptr _)
                            (lower-emit-pack
                              cast-state
                              (ir.compiler-ir-value-seq2
                                ptr
                                (ir.CompilerIrValue.I64 count))
                              (lower-global-shared-view arg-ty))])
                        (LowerExpr.Expr
                          stored-state
                          (lower-global-shared-view reference)
                          (lower-global-shared-view arg-ty)))]
                    [_
                      (LowerExpr.Expr
                        stored-state
                        (lower-global-shared-view reference)
                        (lower-global-shared-view arg-ty))])]
                (match passed
                  [(LowerExpr.Expr passed-state passed-value _)
                    (if (tc_core.tc-cleanup-owning-aggregate-type?
                      ctx
                      (lower-global-shared-view resolved-ty))
                      (match (lower-cleanup-symbol-for-type
                        ctx
                        passed-state
                        env
                        (lower-global-shared-view resolved-ty))
                        [(tc_core.ResultTcNameId.Ok cleanup-symbol)
                          (ResultLowerCallArg.Ok
                            (LowerCallArg.Arg
                              passed-state
                              passed-value
                              (LowerMaybeArgWriteback.Some
                                (LowerArgWriteback.Cleanup
                                  reference
                                  resolved-ty
                                  copied
                                  cleanup-symbol
                                  arg))))]
                        [(tc_core.ResultTcNameId.Err message)
                          (ResultLowerCallArg.Err
                            (box (lower-diagnostic-at-expr ctx arg message)))])
                      (ResultLowerCallArg.Ok
                        (LowerCallArg.Arg
                          passed-state
                          passed-value
                          (LowerMaybeArgWriteback.No))))]))]))])))

(define (lower-call-arg-as
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]
  [expected : ast.AstType]
  [arg-ty : ast.AstType]) : ResultLowerCallArg
  ;; Only a reference formal takes a borrowed temporary.
  (if (and
    (match (lower-global-shared-view arg-ty)
      [(ast.AstType.Ref _ _) true]
      [(ast.AstType.MutRef _ _) true]
      [_ false])
    (tc_core.tc-call-temporary-borrow-arg?
      (tc_core.tc-context-expr-bases ctx)
      (lower-global-shared-view arg)))
    (lower-call-arg-temporary-borrow ctx state env type-env arg arg-ty)
    (match (tc_core.tc-call-effective-arg-expr
      ctx
      type-env
      (lower-global-shared-view arg)
      expected)
      [(Ok effective-arg)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx (lower-global-shared-view arg-ty)))
          [(MutRef _ _)
            (match (lower-call-explicit-mut-borrow-var-id
              ctx
              (lower-global-shared-view effective-arg))
              [(Some name-id)
                (lower-call-arg-mut-borrow-var-as
                  ctx
                  state
                  env
                  type-env
                  arg
                  effective-arg
                  arg-ty
                  name-id)]
              [(No)
                (lower-call-arg-normal-as
                  ctx
                  state
                  env
                  type-env
                  arg
                  effective-arg
                  arg-ty)])]
          [_
            (lower-call-arg-normal-as
              ctx
              state
              env
              type-env
              arg
              effective-arg
              arg-ty)])]
      [(Err message) (Err (box (lower-diagnostic-at-expr ctx arg message)))])))

;; Arguments lower left-to-right, so append each writeback before recurring.
;; This preserves post-call writeback order without a prepend/copy pass.
(define (lower-call-arg-writebacks-push-maybe
  [writebacks : (&mut writebacks lower_arg_writeback_vec.Vec)]
  [maybe-writeback : LowerMaybeArgWriteback]) : unit
  (match maybe-writeback
    [(No) unit]
    [(Some writeback) (lower_arg_writeback_vec.push-ref! writebacks writeback)]))

(define (lower-call-args-as
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [types : ast.AstTypeList]) : ResultLowerCallArgs
  (lower-call-args-as-at
    ctx
    state
    env
    type-env
    (& args)
    (& types)
    0
    (lower_arg_writeback_vec.new)))

(define (lower-call-args-as-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [writebacks : lower_arg_writeback_vec.Vec]) : ResultLowerCallArgs
  (if (>= index args.len)
    (if (>= index (ast.ast-type-list-len types))
      (Ok
        state
        (ir.compiler-ir-value-seq-empty)
        (LowerArgWritebacks.Some writebacks))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [arg : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [expected-id : i64
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))]
        [expected : ast.AstType (tc_core.tc-context-type-get ctx expected-id)]
        [arg-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-type-strip-invalidate
              (tc_core.tc-resolve-type ctx (lower-global-shared-view expected))))]
        [lowered-arg
          (try (lower-call-arg-as ctx state env type-env arg expected arg-ty))]
        (match lowered-arg
          [(Arg arg-state value maybe-writeback)
            (let
              [next-writebacks : lower_arg_writeback_vec.Vec writebacks]
              (lower-call-arg-writebacks-push-maybe
                (&mut next-writebacks)
                maybe-writeback)
              (match (lower-call-args-as-at
                ctx
                arg-state
                env
                type-env
                args
                types
                (+ index 1)
                next-writebacks)
                [(Ok rest-state rest-values rest-writebacks)
                  (Ok
                    rest-state
                    (ir.compiler-ir-value-seq-prepend value rest-values)
                    rest-writebacks)]
                [(Err message) (Err message)]))])))))

(define (lower-apply-arg-writeback
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [writeback : LowerArgWriteback]) : LowerState
  (match writeback
    [(LowerArgWriteback.Writeback local-id storage referent-ty origin)
      (match (lower-load-register-resident-from-ptr
        ctx
        state
        storage
        (lower-global-shared-view referent-ty))
        [(LowerExpr.Expr load-state loaded _)
          (lower-state-emit-at-expr
            ctx
            load-state
            (ir.CompilerIrInstr.Mov local-id loaded referent-ty)
            origin)])]
    [(LowerArgWriteback.Cleanup value value-ty copied cleanup-symbol origin)
      (match (if copied
        (lower-load-register-resident-from-ptr
          ctx
          state
          value
          (lower-global-shared-view value-ty))
        (LowerExpr.Expr state value value-ty))
        [(LowerExpr.Expr load-state current _)
          (match (lower-state-alloc-var load-state)
            [(LowerAlloc.Alloc allocated var-id)
              (lower-state-emit-at-expr
                ctx
                allocated
                (ir.CompilerIrInstr.Call
                  var-id
                  cleanup-symbol
                  (ir.CompilerIrCallArgs.One current)
                  (ast.AstType.Unit))
                origin)])])]))

(define lower-arg-writeback-fallback : LowerArgWriteback
  (Writeback 0 (I64 0) (I64) (Literal (ast.ast-lit-int 0))))

(define (lower-apply-arg-writebacks
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [writebacks : LowerArgWritebacks]) : LowerState
  (match writebacks
    [(None) state]
    [(Some items)
      (let
        [count : i64 (lower_arg_writeback_vec.len (& items))]
        [index : i64 0]
        [out : LowerState state]
        (while (< index count)
          (set!
            out
            (lower-apply-arg-writeback
              ctx
              out
              (lower_arg_writeback_vec.get
                (& items)
                index
                (lower-global-shared-view lower-arg-writeback-fallback))))
          (set! index (+ index 1)))
        out)]))

(define (lower-bootstrap-runtime-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-bootstrap-runtime-id? name-id))

(define (lower-args-as
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [types : ast.AstTypeList]) : ResultLowerArgs
  (lower-args-as-at ctx state env type-env (& args) (& types) 0))

(define (lower-args-as-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index args.len)
    (if (>= index (ast.ast-type-list-len types))
      (Ok state (ir.compiler-ir-value-seq-empty))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [arg : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [expected-id : i64
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))]
        [expected : ast.AstType (tc_core.tc-context-type-get ctx expected-id)]
        [arg-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx (lower-global-shared-view expected)))]
        (match (tc_core.tc-call-effective-arg-expr
          ctx
          type-env
          (lower-global-shared-view arg)
          expected)
          [(Ok effective-arg)
            (let
              [lowered
                (try
                  (lower-expr-expected
                    ctx
                    (lower-disarm-move-aware-resource-expr
                      state
                      env
                      (lower-global-shared-view effective-arg))
                    env
                    type-env
                    effective-arg
                    arg-ty
                    arg))]
              (match lowered
                [(Expr arg-state value _)
                  (match (lower-args-as-at
                    ctx
                    arg-state
                    env
                    type-env
                    args
                    types
                    (+ index 1))
                    [(Ok rest-state rest-values)
                      (Ok
                        rest-state
                        (ir.compiler-ir-value-seq-prepend value rest-values))]
                    [(Err message) (Err message)])]))]
          [(Err message) (Err (box (lower-diagnostic-at-expr ctx arg message)))])))))

;; Mutable-reference formals need call-aware lowering for writebacks, while
;; borrowed Slice formals need it for the closed call-local unsize path.
;; Whether a call's arguments need the call-aware lowering that can attach
;; writebacks: a `&mut` or Slice-reference formal, or a borrowed temporary
;; (section 3.10), which only a reference formal can take.
(define (lower-call-args-need-call-aware-lowering?
  [ctx : tc_core.TcContext]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (let
      [head : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [stripped : ast.AstType
        (tc_core.tc-type-strip-region (lower-global-shared-view head))]
      (match (lower-global-shared-view stripped)
        [(ast.AstType.MutRef _ _) true]
        [_
          (cond
            [(tc_core.tc-call-slice-ref-formal? ctx head) true]
            [(and
                (match (lower-global-shared-view stripped)
                  [(ast.AstType.Ref _ _) true]
                  [(ast.AstType.Var _) true]
                  [(ast.AstType.VarArgs _ _) true]
                  [(ast.AstType.Invalidate _ _) true]
                  [_ false])
                (< index args.len)
                (tc_core.tc-call-temporary-borrow-arg-id?
                  (tc_core.tc-context-expr-bases ctx)
                  (ast.ast-expr-list-get args index 0)))
              true]
            [else
              (lower-call-args-need-call-aware-lowering?
                ctx
                args
                types
                (+ index 1))])]))))

;; Mutable-reference formals need call-aware lowering for writebacks, while
;; borrowed Slice formals need it for the closed call-local unsize path.
(define (lower-call-type-list-needs-call-aware-args?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]) : bool
  (lower-call-type-list-needs-call-aware-args-at? ctx (& types) 0))

(define (lower-call-type-list-needs-call-aware-args-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (let
      [head : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (match (tc_core.tc-type-strip-region (lower-global-shared-view head))
        [(MutRef _ _) true]
        [_
          (if (tc_core.tc-call-slice-ref-formal? ctx head)
            true
            (lower-call-type-list-needs-call-aware-args-at?
              ctx
              types
              (+ index 1)))]))))

(define (lower-call-args-as-needed
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [types : ast.AstTypeList]) : ResultLowerCallArgs
  (if (lower-call-args-need-call-aware-lowering? ctx args (& types) 0)
    (lower-call-args-as ctx state env type-env args types)
    (match (lower-args-as ctx state env type-env args types)
      [(ResultLowerArgs.Ok args-state values)
        (ResultLowerCallArgs.Ok args-state values (LowerArgWritebacks.None))]
      [(ResultLowerArgs.Err message) (ResultLowerCallArgs.Err message)])))

(define (lower-construct-struct-inline-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [struct-name : String]
  [values : ir.CompilerIrValueSeq]
  [fields : ast.AstFieldDefList]
  [struct-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-inline-aggregate-layout-for-id
    ctx
    (lower-struct-type-name-id-or struct-ty -1))
    [(Ok layout)
      (match (lower-global-shared-view layout)
        [(Struct size _ _)
          ;; A register-resident struct is built directly in registers by
          ;; packing its fields with shift/or; no stack slot, no stores. A 2-word
          ;; struct packs each word and combines them with
          ;; CompilerIrInstr.Pack.
          (if (tc_core.tc-inline-aggregate-layout-register-resident?
            (lower-global-shared-view layout))
            (if (lower-type-register-group?
              ctx
              (lower-global-shared-view struct-ty))
              (lower-construct-struct-register-group
                ctx
                state
                values
                fields
                layout
                struct-ty)
              (let
                [packed : LowerExpr
                  (try
                    (lower-pack-inline-struct-values
                      ctx
                      state
                      (I64 0)
                      (I64)
                      values
                      fields
                      layout))]
                (match packed
                  [(Expr packed-state packed-value packed-ty)
                    (match (lower-materialize-register-word
                      packed-state
                      packed-value
                      packed-ty
                      (lower-register-word-type ctx struct-ty 0))
                      [(Expr word-state word-value _)
                        (Ok (Expr word-state word-value struct-ty))])])))
            (match (lower-reserve-inline-storage state size struct-ty)
              [(Expr base-state base _)
                (let
                  [done-state
                    (try
                      (lower-store-inline-struct-values
                        ctx
                        base-state
                        (lower-global-shared-view base)
                        values
                        fields
                        layout))]
                  (Ok (Expr done-state base struct-ty)))]))]
        [(Enum _ _ _)
          (Err
            (box
              (lower-diagnostic
                (str_cat.str-cat
                  "lower: inline layout for struct is enum "
                  struct-name))))])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

;; TWO-PHASE CONSTRUCTOR LOWERING -- THE ORDER IS LOAD-BEARING (issue #6930).
;;
;; Every `-into` path in this family materializes ALL constructor arguments to
;; values first (`lower-args-as` / `lower-args-as-at` runs to completion) and
;; only then writes the tag and payload bytes of `dst`. That order is what makes
;; writing straight into an sret slot or a `set!` place correct WITHOUT alias
;; analysis. The proof follows the ordinary by-value rules in SPEC sections
;; 3.3 and 4.7.2:
;;
;;   1. each constructor operand is an ordinary by-value position. Copy values
;;      are copied and non-Copy values move exactly once, left to right. Moving
;;      a source invalidates its ownership; it does NOT prove that an IR value
;;      already materialized from that source cannot name `dst` storage;
;;   2. every runtime by-value parameter is owned callee storage. Memory-class
;;      arguments may travel across the ABI by pointer, but call lowering
;;      snapshots them into a private callee representation before body code
;;      can write its hidden sret slot. That disjointness starts only AFTER
;;      argument materialization; it cannot justify writes while lowering the
;;      argument expressions themselves;
;;   3. a hidden sret is caller-owned and may be forwarded unchanged through a
;;      tail-call chain. `set!` may reinitialize the place its RHS just moved
;;      from, so an earlier result slot may become the next consumed accumulator
;;      argument. If one backing place supplies an argument and receives the
;;      new result, rule (2)'s snapshot must complete before any result write.
;;
;; Consequently `dst` carries NO general `noalias` guarantee against operand
;; places at this point in lowering. Accumulator threading such as
;; `(set! acc (f acc x))` and tail-sret forwarding are the canonical cross-call
;; cases; direct `set!` constructors expose the same ordering within one frame.
;; Interleaving destination writes with argument evaluation MISCOMPILES whenever
;; `dst` aliases an operand place. Forwarding the destination here was tried
;; and broke stage1; keep the source order explicit.
;;
;; Destination forwarding belongs in `compiler_optimize.tl`, where the whole
;; window is visible and the alias side condition can actually be discharged --
;; see the `ctor_fwd` pass (`opt-ctor-fwd-*`) and its guard.
(define (lower-construct-struct-inline-into-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [values : ir.CompilerIrValueSeq]
  [fields : ast.AstFieldDefList]) : ResultLowerState
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx struct-id)
    [(Ok layout)
      (match (lower-global-shared-view layout)
        [(Struct _ _ _)
          (lower-store-inline-struct-values ctx state dst values fields layout)]
        [(Enum _ _ _)
          (Err
            (box
              (lower-diagnostic
                (str_cat.str-cat
                  "lower: inline layout for struct is enum "
                  struct-name))))])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

(define (lower-construct-enum-inline-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [variant-name : String]
  [handle : i64]
  [values : ir.CompilerIrValueSeq]
  [fields : ast.AstTypeList]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-inline-aggregate-layout-for-id
    ctx
    (lower-enum-type-name-id-or enum-ty -1))
    [(Ok layout)
      (match (lower-global-shared-view layout)
        [(Enum size _ _)
          ;; A 1-word register-resident enum is nullary, so its single word
          ;; is the discriminant tag. A 2-word register-group enum packs the tag
          ;; into word0 and the variant payload into word1.
          (if (tc_core.tc-inline-aggregate-layout-register-resident?
            (lower-global-shared-view layout))
            ;; A register-resident enum is 8 (nullary tag) or 16 bytes (tag
            ;; word0 + payload word1); derive the 2-word group case from the size we
            ;; already have rather than rebuilding the layout (lower-type-register-
            ;; group?), whose transient per-call allocation -- summed over every
            ;; construct/match/bind site during the per-function scratch arena
            ;; window -- was heavy enough to overflow the scratch arena into a
            ;; second chunk and trip its rewind, corrupting later lowering.
            (if (= size 16)
              (lower-construct-enum-register-group
                ctx
                state
                handle
                values
                fields
                enum-ty)
              (Ok
                (Expr
                  state
                  (I64 (csym.compiler-registry-handle-child-index handle))
                  enum-ty)))
            (let
              [layout-variant-name : String
                (lower-member-name-base variant-name)]
              [layout-variant-name-id : i64
                (match (csym.compiler-registries-variant-name-id-indexed
                  (tc_core.tc-context-symbols ctx)
                  handle)
                  [(option_i64.Some name-id) name-id]
                  [(option_i64.None) -1])]
              (match (lower-reserve-inline-storage state size enum-ty)
                [(Expr base-state base _)
                  (let
                    [tag-state : LowerState
                      (lower-store-at-offset
                        base-state
                        base
                        0
                        (I64 (csym.compiler-registry-handle-child-index handle))
                        (I64))]
                    [done-state
                      (try
                        (lower-store-inline-payload-values
                          ctx
                          tag-state
                          (lower-global-shared-view base)
                          values
                          fields
                          layout
                          layout-variant-name
                          layout-variant-name-id
                          0))]
                    (Ok (Expr done-state base enum-ty)))])))]
        [(Struct _ _ _)
          (Err
            (box
              (lower-diagnostic
                (str_cat.str-cat
                  "lower: inline layout for enum is struct "
                  enum-name))))])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

(define (lower-construct-enum-inline-into-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [dst : ir.CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [values : ir.CompilerIrValueSeq]
  [fields : ast.AstTypeList]
  [enum-id : i64]
  [enum-name : String]) : ResultLowerState
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx enum-id)
    [(Ok layout)
      (match (lower-global-shared-view layout)
        [(Enum _ _ _)
          (let
            [layout-variant-name : String (lower-member-name-base variant-name)]
            [layout-variant-name-id : i64
              (match (csym.compiler-registries-variant-name-id-indexed
                (tc_core.tc-context-symbols ctx)
                handle)
                [(option_i64.Some name-id) name-id]
                [(option_i64.None) -1])]
            [tag-state : LowerState
              (lower-store-at-offset
                state
                dst
                0
                (I64 (csym.compiler-registry-handle-child-index handle))
                (I64))]
            (lower-store-inline-payload-values
              ctx
              tag-state
              dst
              values
              fields
              layout
              layout-variant-name
              layout-variant-name-id
              0))]
        [(Struct _ _ _)
          (Err
            (box
              (lower-diagnostic
                (str_cat.str-cat
                  "lower: inline layout for enum is struct "
                  enum-name))))])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

(define (lower-enum-constructor-fields-for-result
  [ctx : tc_core.TcContext]
  [enum-ty : ast.AstType]
  [fields : ast.AstTypeList]) : ast.AstTypeList
  (match enum-ty
    [(EnumArgs enum-id lifetimes)
      (match (tc_core.tc-lifetime-subst-from-nominal-args-id
        ctx
        enum-id
        (deref lifetimes))
        [(Ok subst) (tc_core.tc-lifetime-subst-type-list subst fields)]
        [(Err _) fields])]
    [(VarArgs enum-id lifetimes)
      (match (tc_core.tc-lifetime-subst-from-nominal-args-id
        ctx
        enum-id
        (deref lifetimes))
        [(Ok subst) (tc_core.tc-lifetime-subst-type-list subst fields)]
        [(Err _) fields])]
    [_ fields]))

(define (lower-variant-payload-fields-for-handle
  [ctx : tc_core.TcContext]
  [handle : i64]
  [resolved-scrut-ty : ast.AstType]
  [fields : ast.AstTypeList]) : ast.AstTypeList
  (let
    [field-ctx : tc_core.TcContext
      (tc_core.tc-context-with-nominal-owner-handle-module
        ctx
        (csym.compiler-registry-variant-owner-handle handle))]
    (tc_core.tc-resolve-type-list
      field-ctx
      (lower-enum-constructor-fields-for-result
        field-ctx
        resolved-scrut-ty
        fields))))

(define (lower-construct-enum-with-name
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [variant-name : String]
  [handle : i64]
  [args : ast.AstExprList]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerExpr
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
    (match (csym.compiler-registries-variant-fields-indexed symbols handle)
      [(Ok fields)
        (let
          [field-ctx : tc_core.TcContext
            (tc_core.tc-context-with-nominal-owner-handle-module ctx handle)]
          [resolved-fields : ast.AstTypeList
            (tc_core.tc-resolve-type-list
              field-ctx
              (lower-enum-constructor-fields-for-result
                field-ctx
                (lower-global-shared-view enum-ty)
                fields))]
          (match (lower-args-as
            ctx
            state
            env
            type-env
            args
            (lower-global-shared-view resolved-fields))
            [(Ok args-state values)
              (lower-construct-enum-inline-from-values
                ctx
                args-state
                variant-name
                handle
                values
                resolved-fields
                enum-name
                enum-ty)]
            [(Err message) (Err message)]))]
      [(Err message) (Err (box (lower-diagnostic message)))])))

(define (lower-construct-enum-with-handle
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [variant-name : String]
  [handle : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [enum-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx result-ty))]
    (match (lower-global-shared-view enum-ty)
      [(Enum enum-name)
        (lower-construct-enum-with-name
          ctx
          state
          env
          type-env
          variant-name
          handle
          args
          (tc_core.tc-nominal-name-id-display enum-name)
          enum-ty)]
      [(EnumArgs enum-name _)
        (lower-construct-enum-with-name
          ctx
          state
          env
          type-env
          variant-name
          handle
          args
          (tc_core.tc-nominal-name-id-display enum-name)
          enum-ty)]
      [_
        (Err
          (box
            (lower-diagnostic
              (str_cat.str-cat
                "lower: enum constructor result is not enum: "
                variant-name))))])))

;; Two-phase order (arguments first, destination bytes second) is load-bearing
;; here too -- see the two-phase note at `lower-construct-struct-inline-into-from-values`.
(define (lower-construct-enum-with-name-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [args : ast.AstExprList]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerState
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
    (match (csym.compiler-registries-variant-fields-indexed symbols handle)
      [(Ok fields)
        (let
          [field-ctx : tc_core.TcContext
            (tc_core.tc-context-with-nominal-owner-handle-module ctx handle)]
          [resolved-fields : ast.AstTypeList
            (tc_core.tc-resolve-type-list
              field-ctx
              (lower-enum-constructor-fields-for-result
                field-ctx
                (lower-global-shared-view enum-ty)
                fields))]
          (match (lower-args-as
            ctx
            state
            env
            type-env
            args
            (lower-global-shared-view resolved-fields))
            [(Ok args-state values)
              (lower-construct-enum-inline-into-from-values
                ctx
                args-state
                dst
                variant-name
                handle
                values
                resolved-fields
                (lower-enum-type-name-id-or enum-ty -1)
                enum-name)]
            [(Err message) (Err message)]))]
      [(Err message) (Err (box (lower-diagnostic message)))])))

;; Two-phase order (arguments first, destination bytes second) is load-bearing
;; here too -- see the two-phase note at `lower-construct-struct-inline-into-from-values`.
(define (lower-construct-enum-with-handle-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerState
  (let
    [enum-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx result-ty))]
    (match (lower-global-shared-view enum-ty)
      [(Enum enum-name)
        (lower-construct-enum-with-name-into
          ctx
          state
          env
          type-env
          dst
          variant-name
          handle
          args
          (tc_core.tc-nominal-name-id-display enum-name)
          enum-ty)]
      [(EnumArgs enum-name _)
        (lower-construct-enum-with-name-into
          ctx
          state
          env
          type-env
          dst
          variant-name
          handle
          args
          (tc_core.tc-nominal-name-id-display enum-name)
          enum-ty)]
      [_
        (Err
          (box
            (lower-diagnostic
              (str_cat.str-cat
                "lower: enum constructor result is not enum: "
                variant-name))))])))

(define (lower-struct-constructor-field-types-for-result
  [ctx : tc_core.TcContext]
  [struct-ty : ast.AstType]
  [fields : ast.AstFieldDefList]) : ast.AstTypeList
  (let
    [field-types : ast.AstTypeList (tc_core.tc-field-type-list ctx fields)]
    (match struct-ty
      [(StructArgs struct-id lifetimes)
        (match (tc_core.tc-lifetime-subst-from-nominal-args-id
          ctx
          struct-id
          (deref lifetimes))
          [(Ok subst) (tc_core.tc-lifetime-subst-type-list subst field-types)]
          [(Err _) field-types])]
      [(VarArgs struct-id lifetimes)
        (match (tc_core.tc-lifetime-subst-from-nominal-args-id
          ctx
          struct-id
          (deref lifetimes))
          [(Ok subst) (tc_core.tc-lifetime-subst-type-list subst field-types)]
          [(Err _) field-types])]
      [_ field-types])))

(define (lower-context-with-nominal-owner-module-id
  [ctx : tc_core.TcContext]
  [nominal-id : i64]) : tc_core.TcContext
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc_core.tc-context-symbols ctx)
        nominal-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [module-id : i64
          (csym.compiler-symbols-owner-module-id-at-index-or
            (tc_core.tc-context-symbols ctx)
            (csym.compiler-symbol-handle-index handle)
            cbi.compiler-builtin-id-fix-empty)]
        (if (>= module-id 0)
          (tc_core.tc-context-with-module-id
            ctx
            (tc_core.tc-env-key-name-text module-id)
            module-id)
          (tc_core.tc-context-with-module-id
            ctx
            ""
            cbi.compiler-builtin-id-fix-empty)))
      (if (tc_core.tc-name-qualified-id?
        (tc_core.tc-context-structural-session ctx)
        nominal-id)
        (let
          [module-id : i64 (tc_core.tc-qualified-name-module-id nominal-id)]
          (tc_core.tc-context-with-module-id
            ctx
            (tc_core.tc-env-key-name-text module-id)
            module-id))
        ctx))))

(define (lower-construct-struct
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [struct-name : String]
  [struct-handle : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  ;; Field annotations are scoped to the declaring module. Resolve them there
  ;; before lowering arguments or storage so a dotted imported aggregate keeps
  ;; the layout of its nested nominal fields.
  (let
    [result-struct-id : i64 (lower-struct-type-name-id-or result-ty -1)]
    [struct-id : i64
      (if (csym.compiler-symbols-handle-found? struct-handle)
        (tc_core.tc-nominal-owner-id-or ctx struct-handle result-struct-id)
        result-struct-id)]
    [field-ctx : tc_core.TcContext
      (if (csym.compiler-symbols-handle-found? struct-handle)
        (tc_core.tc-context-with-nominal-owner-handle-module ctx struct-handle)
        (lower-context-with-nominal-owner-module-id ctx struct-id))]
    (match (if (csym.compiler-symbols-handle-found? struct-handle)
      (lower-struct-fields-at-handle
        field-ctx
        struct-handle
        (lower-global-shared-view struct-name))
      (lower-struct-fields-id
        field-ctx
        struct-id
        (lower-global-shared-view struct-name)))
      [(Ok fields)
        (let
          [struct-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx result-ty))]
          [field-types : ast.AstTypeList
            (tc_core.tc-resolve-type-list
              field-ctx
              (lower-struct-constructor-field-types-for-result
                field-ctx
                (lower-global-shared-view struct-ty)
                (lower-global-shared-view fields)))]
          (match (lower-args-as ctx state env type-env args field-types)
            [(Ok args-state values)
              (lower-construct-struct-inline-from-values
                field-ctx
                args-state
                struct-name
                values
                fields
                struct-ty)]
            [(Err message) (Err message)]))]
      [(Err message) (Err (box (lower-diagnostic message)))])))

;; Two-phase order (arguments first, destination bytes second) is load-bearing
;; here too -- see the two-phase note at `lower-construct-struct-inline-into-from-values`.
(define (lower-construct-struct-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [struct-name : String]
  [struct-handle : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerState
  (let
    [result-struct-id : i64 (lower-struct-type-name-id-or result-ty -1)]
    [struct-id : i64
      (if (csym.compiler-symbols-handle-found? struct-handle)
        (tc_core.tc-nominal-owner-id-or ctx struct-handle result-struct-id)
        result-struct-id)]
    [field-ctx : tc_core.TcContext
      (if (csym.compiler-symbols-handle-found? struct-handle)
        (tc_core.tc-context-with-nominal-owner-handle-module ctx struct-handle)
        (lower-context-with-nominal-owner-module-id ctx struct-id))]
    (match (if (csym.compiler-symbols-handle-found? struct-handle)
      (lower-struct-fields-at-handle
        field-ctx
        struct-handle
        (lower-global-shared-view struct-name))
      (lower-struct-fields-id
        field-ctx
        struct-id
        (lower-global-shared-view struct-name)))
      [(Ok fields)
        (let
          [struct-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx result-ty))]
          [field-types : ast.AstTypeList
            (tc_core.tc-resolve-type-list
              field-ctx
              (lower-struct-constructor-field-types-for-result
                field-ctx
                struct-ty
                (lower-global-shared-view fields)))]
          (match (lower-args-as ctx state env type-env args field-types)
            [(Ok args-state values)
              (lower-construct-struct-inline-into-from-values
                field-ctx
                args-state
                dst
                struct-id
                struct-name
                values
                fields)]
            [(Err message) (Err message)]))]
      [(Err message) (Err (box (lower-diagnostic message)))])))

(define (lower-init-expr-list-from-types
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : ast.AstExprList
  (lower-init-expr-list-from-types-at ctx (& types) 0))

(define (lower-init-expr-list-from-types-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstExprList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-expr-list-new)
    (let
      [head : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (ast.ast-expr-cons
        (ast.ast-expr-init head)
        (lower-init-expr-list-from-types-at ctx types (+ index 1))))))

(define (lower-init-expr-list-repeat [ty : ast.AstType] [count : i64]) : ast.AstExprList
  (if (<= count 0)
    (ast.ast-expr-list-new)
    (ast.ast-expr-cons
      (ast.ast-expr-init (lower-global-shared-view ty))
      (lower-init-expr-list-repeat ty (- count 1)))))

(define (lower-init-scalar
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (lower-materialize-at-expr ctx state value ty origin))

(define (lower-init-struct
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [struct-name : String]
  [struct-ty : ast.AstType]) : ResultLowerExpr
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-struct-type-name-id-or struct-ty -1))]
    (if (lower-struct-repr-c-id?
      field-ctx
      (lower-struct-type-name-id-or struct-ty -1))
      (Err
        (box
          (lower-diagnostic "lower: init supports only default-layout structs")))
      (match (lower-struct-fields-id
        field-ctx
        (lower-struct-type-name-id-or struct-ty -1)
        (lower-global-shared-view struct-name))
        [(Ok fields)
          (let
            [field-types : ast.AstTypeList
              (tc_core.tc-resolve-type-list
                field-ctx
                (lower-struct-constructor-field-types-for-result
                  field-ctx
                  (lower-global-shared-view struct-ty)
                  fields))]
            (lower-construct-struct
              ctx
              state
              env
              type-env
              struct-name
              (lower-struct-type-handle-or
                ctx
                (lower-global-shared-view struct-ty)
                (csym.compiler-symbols-missing-handle))
              (lower-init-expr-list-from-types ctx field-types)
              struct-ty))]
        [(Err message) (Err (box (lower-diagnostic message)))]))))

(define (lower-init-enum
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerExpr
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-enum-type-name-id-or enum-ty -1))]
    (match (tc_core.tc-enum-decl-id
      field-ctx
      (lower-enum-type-name-id-or enum-ty -1))
      [(Ok decl)
        (match decl
          [(TcEnumDecl _ variants)
            (if (ast.ast-variant-def-list-empty? (& variants))
              (Err
                (box
                  (lower-diagnostic
                    "lower: init requires enum with at least one variant")))
              (let
                [variant : ast.AstVariantDef
                  (ast.ast-variant-def-list-get
                    (& variants)
                    0
                    (ast.ast-variant-def-fallback))]
                (match variant
                  [(Def variant-name fields _)
                    (let
                      [lookup-name : String
                        (tc_core.tc-variant-name-for-enum
                          (lower-global-shared-view enum-name)
                          (tc_core.tc-env-key-name-text variant-name))]
                      [payload-types : ast.AstTypeList
                        (tc_core.tc-resolve-type-list
                          field-ctx
                          (lower-enum-constructor-fields-for-result
                            field-ctx
                            (lower-global-shared-view enum-ty)
                            fields))]
                      [handle : i64
                        (lower-variant-constructor-handle-id-or
                          ctx
                          (tc_core.tc-env-key-name-text variant-name)
                          variant-name
                          (lower-global-shared-view enum-ty)
                          (csym.compiler-symbols-missing-handle))]
                      (if (csym.compiler-symbols-handle-found? handle)
                        (lower-construct-enum-with-name
                          ctx
                          state
                          env
                          type-env
                          lookup-name
                          handle
                          (lower-init-expr-list-from-types ctx payload-types)
                          enum-name
                          enum-ty)
                        (Err
                          (box
                            (lower-diagnostic
                              (str_cat.str-cat
                                "lower: unknown variant "
                                lookup-name))))))])))])]
      [(Err message) (Err (box (lower-diagnostic message)))])))

(define (lower-init-struct-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [struct-name : String]
  [struct-ty : ast.AstType]) : ResultLowerState
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-struct-type-name-id-or struct-ty -1))]
    (if (lower-struct-repr-c-id?
      field-ctx
      (lower-struct-type-name-id-or struct-ty -1))
      (Err
        (box
          (lower-diagnostic "lower: init supports only default-layout structs")))
      (match (lower-struct-fields-id
        field-ctx
        (lower-struct-type-name-id-or struct-ty -1)
        (lower-global-shared-view struct-name))
        [(Ok fields)
          (let
            [field-types : ast.AstTypeList
              (tc_core.tc-resolve-type-list
                field-ctx
                (lower-struct-constructor-field-types-for-result
                  field-ctx
                  (lower-global-shared-view struct-ty)
                  fields))]
            (lower-construct-struct-into
              ctx
              state
              env
              type-env
              dst
              struct-name
              (lower-struct-type-handle-or
                ctx
                (lower-global-shared-view struct-ty)
                (csym.compiler-symbols-missing-handle))
              (lower-init-expr-list-from-types ctx field-types)
              struct-ty))]
        [(Err message) (Err (box (lower-diagnostic message)))]))))

(define (lower-init-enum-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [enum-name : String]
  [enum-ty : ast.AstType]) : ResultLowerState
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-enum-type-name-id-or enum-ty -1))]
    (match (tc_core.tc-enum-decl-id
      field-ctx
      (lower-enum-type-name-id-or enum-ty -1))
      [(Ok decl)
        (match decl
          [(TcEnumDecl _ variants)
            (if (ast.ast-variant-def-list-empty? (& variants))
              (Err
                (box
                  (lower-diagnostic
                    "lower: init requires enum with at least one variant")))
              (let
                [variant : ast.AstVariantDef
                  (ast.ast-variant-def-list-get
                    (& variants)
                    0
                    (ast.ast-variant-def-fallback))]
                (match variant
                  [(Def variant-name fields _)
                    (let
                      [lookup-name : String
                        (tc_core.tc-variant-name-for-enum
                          (lower-global-shared-view enum-name)
                          (tc_core.tc-env-key-name-text variant-name))]
                      [payload-types : ast.AstTypeList
                        (tc_core.tc-resolve-type-list
                          field-ctx
                          (lower-enum-constructor-fields-for-result
                            field-ctx
                            (lower-global-shared-view enum-ty)
                            fields))]
                      [handle : i64
                        (lower-variant-constructor-handle-id-or
                          ctx
                          (tc_core.tc-env-key-name-text variant-name)
                          variant-name
                          (lower-global-shared-view enum-ty)
                          (csym.compiler-symbols-missing-handle))]
                      (if (csym.compiler-symbols-handle-found? handle)
                        (lower-construct-enum-with-name-into
                          ctx
                          state
                          env
                          type-env
                          dst
                          lookup-name
                          handle
                          (lower-init-expr-list-from-types ctx payload-types)
                          enum-name
                          enum-ty)
                        (Err
                          (box
                            (lower-diagnostic
                              (str_cat.str-cat
                                "lower: unknown variant "
                                lookup-name))))))])))])]
      [(Err message) (Err (box (lower-diagnostic message)))])))

(define (lower-init-expr-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerState
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view resolved)
      [(Struct name)
        (lower-init-struct-into
          ctx
          state
          env
          type-env
          dst
          (tc_core.tc-nominal-name-id-display name)
          resolved)]
      [(StructArgs name _)
        (lower-init-struct-into
          ctx
          state
          env
          type-env
          dst
          (tc_core.tc-nominal-name-id-display name)
          resolved)]
      [(Enum name)
        (lower-init-enum-into
          ctx
          state
          env
          type-env
          dst
          (tc_core.tc-nominal-name-id-display name)
          resolved)]
      [(EnumArgs name _)
        (lower-init-enum-into
          ctx
          state
          env
          type-env
          dst
          (tc_core.tc-nominal-name-id-display name)
          resolved)]
      [_
        (Err
          (box
            (lower-diagnostic-at-expr
              ctx
              origin
              (str_cat.str-cat
                "lower: init unsupported type "
                (tc_core.tc-type-render resolved)))))])))

(define (lower-init-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [ty : ast.AstType]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (if (tc_core.tc-integer-type? (lower-global-shared-view resolved))
      (lower-init-scalar ctx state (I64 0) expr-ty origin)
      (match (lower-global-shared-view resolved)
        [(F64)
          (lower-init-scalar
            ctx
            state
            (F64 (lower-float-literal-bits "0.0" (F64)))
            expr-ty
            origin)]
        [(F32)
          (lower-init-scalar
            ctx
            state
            (F64 (lower-float-literal-bits "0.0" (F32)))
            expr-ty
            origin)]
        [(Bool) (lower-init-scalar ctx state (Bool false) expr-ty origin)]
        [(Char) (lower-init-scalar ctx state (Char '\0') expr-ty origin)]
        [(Unit) (Ok (Expr state Unit expr-ty))]
        [(String) (lower-init-scalar ctx state (String "") expr-ty origin)]
        [(Ptr _)
          (let
            [lowered : LowerExpr (try (lower-materialize state (I64 0) (U64)))]
            (match lowered
              [(Expr null-state null-value _)
                (Ok (Expr null-state null-value expr-ty))]))]
        [(MutPtr _)
          (let
            [lowered : LowerExpr (try (lower-materialize state (I64 0) (U64)))]
            (match lowered
              [(Expr null-state null-value _)
                (Ok (Expr null-state null-value expr-ty))]))]
        [(CFunc _ mode)
          (if (ast.ast-c-function-mode-nullable? mode)
            (lower-init-scalar ctx state (I64 0) expr-ty origin)
            (Err
              (box
                (lower-diagnostic
                  "lower: init cannot create a non-null C function pointer"))))]
        [(DynArray elem)
          (lower-make-array-from-len
            ctx
            state
            env
            type-env
            (tc_core.tc-context-type-get ctx elem)
            (I64 0)
            (I64)
            (Literal (ast.ast-lit-int 0))
            origin)]
        [(Box elem) (lower-box ctx state env type-env (Init elem) expr-ty)]
        [(Tuple elems)
          (lower-tuple
            ctx
            state
            env
            type-env
            (lower-init-expr-list-from-types ctx (deref elems))
            expr-ty
            origin)]
        [(Array elem count)
          (if (< count 0)
            (Err
              (box
                (lower-diagnostic
                  "lower: init fixed array length must be non-negative")))
            (lower-array-literal
              ctx
              state
              env
              type-env
              (lower-init-expr-list-repeat
                (tc_core.tc-context-type-get ctx elem)
                count)
              expr-ty
              origin))]
        [(Struct name)
          (lower-init-struct
            ctx
            state
            env
            type-env
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(StructArgs name _)
          (lower-init-struct
            ctx
            state
            env
            type-env
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(Enum name)
          (lower-init-enum
            ctx
            state
            env
            type-env
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(EnumArgs name _)
          (lower-init-enum
            ctx
            state
            env
            type-env
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [_
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                origin
                (str_cat.str-cat
                  "lower: init unsupported type "
                  (tc_core.tc-type-render resolved)))))]))))

(define (lower-nullary-variant-result-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(Enum _) true]
    [(EnumArgs _ _) true]
    [_ false]))

(define (lower-nullary-variant-or-function-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-nullary-variant-result-type? (lower-global-shared-view expr-ty))
    (let
      [lookup-name : String
        (lower-variant-constructor-lookup-name
          ctx
          (lower-global-shared-view name)
          raw-name-id
          (lower-global-shared-view expr-ty))]
      [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
      [handle : i64
        (lower-variant-constructor-handle-id-or
          ctx
          name
          raw-name-id
          (lower-global-shared-view expr-ty)
          (csym.compiler-symbols-missing-handle))]
      (if (csym.compiler-symbols-handle-found? handle)
        (match (csym.compiler-registries-variant-fields-indexed symbols handle)
          [(Ok fields)
            (if (ast.ast-type-list-empty? (& fields))
              (lower-construct-enum-with-handle
                ctx
                state
                env
                type-env
                lookup-name
                handle
                (ast.ast-expr-list-new)
                expr-ty)
              (lower-function-value-or-var-id
                ctx
                state
                env
                lookup-name-id
                expr-ty))]
          [(Err _)
            (lower-function-value-or-var-id
              ctx
              state
              env
              lookup-name-id
              expr-ty)])
        (lower-function-value-or-var-id ctx state env lookup-name-id expr-ty)))
    (lower-function-value-or-var-id ctx state env lookup-name-id expr-ty)))

;; A register-group GLOBAL stores its two words inline at the symbol; a
;; read of it yields `CompilerIrValue.Global name` (the storage), which must be
;; materialized into a register-group VALUE by loading both words from the
;; symbol's address. Local group vars (CompilerIrValue.Var) and non-group values pass
;; through unchanged.
(define (lower-materialize-group-global
  [ctx : tc_core.TcContext]
  [result : ResultLowerExpr]) : ResultLowerExpr
  (let
    [lowered : LowerExpr (try result)]
    (match (lower-global-shared-view lowered)
      [(Expr s v t)
        (match v
          [(Global name)
            (if (lower-type-register-group? ctx (lower-global-shared-view t))
              (match (lower-load-group-from-ptr
                ctx
                s
                (GlobalAddr name)
                (lower-global-shared-view t))
                [(Expr ls lv _) (Ok (Expr ls lv t))])
              (Ok lowered))]
          [_ (Ok lowered)])])))

(define (lower-var-or-nullary-variant-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  ;; Mirror lower-var-or-nullary-variant -- a register-group GLOBAL read
  ;; yields CompilerIrValue.Global and must be materialized into a group VALUE (load both
  ;; words) before any CompilerIrInstr.Word/struct-get/match extraction; main's interned
  ;; -id path dropped this wrapper, so reg-group globals faulted.
  (lower-materialize-group-global
    ctx
    (if (sym_i64_env.sym-i64-contains-id env name-id)
      (lower-var-id-storage-aware ctx state env name-id expr-ty)
      (let
        [name : String
          (lower-context-intern-str
            ctx
            (tc_core.macro-hygiene-global-source-name-id-or
              (tc_core.tc-context-structural-session ctx)
              name-id
              name-id))]
        (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
          ctx
          type-env
          name
          name-id
          true)
          [(Ok lookup-name lookup-name-id)
            (lower-nullary-variant-or-function-value
              ctx
              state
              env
              type-env
              lookup-name
              name-id
              lookup-name-id
              expr-ty)]
          [(Err message) (Err (box (lower-diagnostic message)))])))))

(define (lower-call-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : tc_core.ResultTcType
  (match (ast.ast-expr-unspan func)
    [(Var name)
      (let
        [source-id : i64
          (tc_core.macro-hygiene-global-source-name-id-or
            (tc_core.tc-context-structural-session ctx)
            name
            name)]
        (if (and
          (cbi.compiler-builtin-lower-clone-id? source-id)
          (= args.len 1)
          (not
            (tc_core.macro-hygiene-global-user-binding-id?
              (tc_core.tc-context-structural-session ctx)
              name)))
          (lower-expr-result-type-fast
            ctx
            env
            type-env
            type-cache
            function-state
            (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0)))
          (match (lower-lookup-type-id
            ctx
            (lower-global-shared-view type-cache)
            env
            type-env
            name)
            [(Ok fn-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx (lower-global-shared-view fn-ty)))
                [(Func _ ret)
                  (Ok
                    (tc_core.tc-type-without-regions
                      (tc_core.tc-resolve-type
                        ctx
                        (tc_core.tc-context-type-get ctx ret))))]
                [(Enum _) (Ok (tc_core.tc-type-without-regions fn-ty))]
                [_ (Err "lower: call result type is not fast-pathable")])]
            [(Err message)
              (if (lower-builtin-call-available-id? ctx env source-id)
                (cond
                  [(cbi.compiler-builtin-lower-length-call-id? source-id)
                    (Ok (I64))]
                  [(cbi.compiler-builtin-lower-string-ref-call-id? source-id)
                    (Ok (Char))]
                  [(cbi.compiler-builtin-lower-clone-id? source-id)
                    (if (= args.len 1)
                      (lower-expr-result-type-fast
                        ctx
                        env
                        type-env
                        type-cache
                        function-state
                        (lower-context-expr-get
                          ctx
                          (ast.ast-expr-list-get (& args) 0 0)))
                      (Err "lower: call result type is not fast-pathable"))]
                  [else (Err message)])
                (Err message))])))]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            [fn-ty : ast.AstType
              (try
                (tc_core.tc-lambda-expr-allow-ref-captures
                  ctx
                  type-env
                  params
                  maybe-ret
                  body))]
            (match fn-ty
              [(Func _ ret)
                (Ok
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type
                      ctx
                      (tc_core.tc-context-type-get ctx ret))))]
              [_ (Err "lower: call result type is not fast-pathable")]))])]
    [_ (Err "lower: call result type is not fast-pathable")]))

(define (lower-binary-result-type-fast
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : tc_core.ResultTcType
  (let
    [binop-types : tc_core.TcBinOpTypes
      (try (tc_core.tc-binop-expr-types ctx type-env op left right))]
    (match binop-types
      [(TcBinOpTypes _ _ result-ty)
        (Ok
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx result-ty)))])))

(define (lower-binop-types-with-result
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]
  [expr-ty : ast.AstType]) : tc_core.ResultTcBinOpTypes
  (let
    [operand-expected : ast.AstType
      (tc_core.tc-type-without-regions
        (tc_core.tc-resolve-type ctx (lower-global-shared-view expr-ty)))]
    (match (tc_core.tc-binop-contextual-operand-type op operand-expected)
      [(No) (tc_core.tc-binop-expr-types ctx type-env op left right)]
      [(Some operand-ty)
        (let
          [left-ty
            (try
              (tc_core.tc-expr-with-expected-or-actual
                ctx
                type-env
                (lower-global-shared-view left)
                (lower-global-shared-view operand-ty)))]
          [right-ty
            (try
              (tc_core.tc-expr-with-expected-or-actual
                ctx
                type-env
                (lower-global-shared-view right)
                operand-ty))]
          (match (tc_core.tc-binop-type
            op
            (lower-global-shared-view left-ty)
            (lower-global-shared-view right-ty))
            [(Ok result-ty)
              (if (tc_core.tc-type-compatible?
                (lower-global-shared-view expr-ty)
                (lower-global-shared-view result-ty))
                (Ok
                  (TcBinOpTypes
                    left-ty
                    right-ty
                    (tc_core.tc-contextual-result-type expr-ty result-ty)))
                (tc_core.tc-binop-expr-types ctx type-env op left right))]
            [(Err _) (tc_core.tc-binop-expr-types ctx type-env op left right)]))])))

(define (lower-unop-type-with-result
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstUnOp]
  [inner : ast.AstExpr]
  [expr-ty : ast.AstType]) : tc_core.ResultTcType
  (let
    [operand-expected : ast.AstType
      (tc_core.tc-type-without-regions
        (tc_core.tc-resolve-type ctx (lower-global-shared-view expr-ty)))]
    (match (tc_core.tc-unop-contextual-operand-type op operand-expected)
      [(No)
        (let
          [inner-ty : ast.AstType (try (tc_core.tc-expr ctx type-env inner))]
          (tc_core.tc-unop-type op inner-ty))]
      [(Some operand-ty)
        (let
          [inner-ty
            (try
              (tc_core.tc-expr-with-expected-or-actual
                ctx
                type-env
                (lower-global-shared-view inner)
                operand-ty))]
          (match (tc_core.tc-unop-type op (lower-global-shared-view inner-ty))
            [(Ok result-ty)
              (if (tc_core.tc-type-compatible?
                (lower-global-shared-view expr-ty)
                (lower-global-shared-view result-ty))
                (Ok (tc_core.tc-contextual-result-type expr-ty result-ty))
                (tc_core.tc-unop-type op inner-ty))]
            [(Err _)
              (let
                [actual-ty : ast.AstType
                  (try (tc_core.tc-expr ctx type-env inner))]
                (tc_core.tc-unop-type op actual-ty))]))])))

(define (lower-if-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]) : tc_core.ResultTcType
  (let
    [then-ty
      (try
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          (lower-global-shared-view type-cache)
          function-state
          (lower-global-shared-view then-branch)))]
    [else-ty
      (try
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          (lower-global-shared-view else-branch)))]
    (match (tc_core.tc-merge-branch-type
      ctx
      type-env
      (lower-global-shared-view then-ty)
      (lower-global-shared-view else-ty))
      [(Ok merged) (Ok merged)]
      [(Err message)
        (if (and
          (tc_core.tc-integer-literal-expr?
            ctx
            (lower-global-shared-view then-branch))
          (tc_core.tc-integer-type? (lower-global-shared-view else-ty)))
          (let
            [contextual-then
              (try
                (tc_core.tc-integer-literal-expr-with-expected
                  ctx
                  then-branch
                  (lower-global-shared-view else-ty)))]
            (tc_core.tc-merge-branch-type ctx type-env contextual-then else-ty))
          (if (and
            (tc_core.tc-integer-literal-expr?
              ctx
              (lower-global-shared-view else-branch))
            (tc_core.tc-integer-type? (lower-global-shared-view then-ty)))
            (let
              [contextual-else
                (try
                  (tc_core.tc-integer-literal-expr-with-expected
                    ctx
                    else-branch
                    (lower-global-shared-view then-ty)))]
              (tc_core.tc-merge-branch-type
                ctx
                type-env
                then-ty
                contextual-else))
            (Err message)))])))

(define (lower-expr-list-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [exprs : ast.AstExprList]) : tc_core.ResultTcType
  (let
    [len : i64 exprs.len]
    (if (= len 0)
      (Ok (Unit))
      (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        function-state
        (lower-context-expr-get
          ctx
          (ast.ast-expr-list-get (& exprs) (- len 1) 0))))))

(define (lower-pattern-list-bind-local-names
  [env : sym_i64_env.SymI64Env]
  [patterns : ast.AstPatternList]) : sym_i64_env.SymI64Env
  (lower-pattern-list-bind-local-names-at env (& patterns) 0))

(define (lower-pattern-list-bind-local-names-at
  [env : sym_i64_env.SymI64Env]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]) : sym_i64_env.SymI64Env
  (if (>= index patterns.len)
    env
    (lower-pattern-list-bind-local-names-at
      (lower-pattern-bind-local-names
        env
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback)))
      patterns
      (+ index 1))))

(define (lower-pattern-bind-local-names
  [env : sym_i64_env.SymI64Env]
  [pattern : ast.AstPattern]) : sym_i64_env.SymI64Env
  (match pattern
    [(Var name _) (sym_i64_env.sym-i64-bind-id env name 0)]
    [(Tuple patterns-box)
      (let
        [patterns : ast.AstPatternList (deref patterns-box)]
        (lower-pattern-list-bind-local-names env patterns))]
    [(Array patterns-box)
      (let
        [patterns : ast.AstPatternList (deref patterns-box)]
        (lower-pattern-list-bind-local-names env patterns))]
    [(Slice patterns-box _)
      (let
        [patterns : ast.AstPatternList (deref patterns-box)]
        (lower-pattern-list-bind-local-names env patterns))]
    [(Binding name) (sym_i64_env.sym-i64-bind-id env name 0)]
    [(Variant _ args-box)
      (let
        [args : ast.AstPatternList (deref args-box)]
        (lower-pattern-list-bind-local-names env args))]
    [_ env]))

(define (lower-match-pattern-bind-local-names
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : sym_i64_env.SymI64Env
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))
    [(Enum _)
      (match pattern
        [(Variant _ args-box)
          (let
            [args : ast.AstPatternList (deref args-box)]
            (lower-pattern-list-bind-local-names env args))]
        [_ env])]
    [_ (lower-pattern-bind-local-names env pattern)]))

(define (lower-match-arm-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]) : tc_core.ResultTcType
  (match arm
    [(Arm pattern body-box)
      (let
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        [arm-type-env
          (try
            (tc_core.tc-bind-match-pattern
              ctx
              type-env
              (lower-global-shared-view scrut-ty)
              (lower-global-shared-view pattern)))]
        (lower-expr-result-type-fast
          ctx
          (lower-match-pattern-bind-local-names ctx env scrut-ty pattern)
          arm-type-env
          type-cache
          function-state
          body))]))

(define (lower-match-rest-result-types-fast-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [want : ast.AstType]) : tc_core.ResultTcType
  (if (>= index arms.len)
    (Ok want)
    (let
      [got
        (try
          (lower-match-arm-result-type-fast
            ctx
            env
            type-env
            (lower-global-shared-view type-cache)
            function-state
            (lower-global-shared-view scrut-ty)
            (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))))]
      [merged : ast.AstType
        (try (tc_core.tc-merge-branch-type ctx type-env want got))]
      (lower-match-rest-result-types-fast-at
        ctx
        env
        type-env
        type-cache
        function-state
        scrut-ty
        arms
        (+ index 1)
        merged))))

(define (lower-match-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [scrutinee : ast.AstExpr]
  [arms : (& arms ast.AstMatchArmList)]) : tc_core.ResultTcType
  (let
    [scrut-ty
      (try
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          (lower-global-shared-view type-cache)
          function-state
          scrutinee))]
    (if (ast.ast-match-arm-list-empty? (& arms))
      (Err "lower: match result type is not fast-pathable")
      (let
        [first-ty
          (try
            (lower-match-arm-result-type-fast
              ctx
              env
              type-env
              (lower-global-shared-view type-cache)
              function-state
              (lower-global-shared-view scrut-ty)
              (ast.ast-match-arm-list-get
                (& arms)
                0
                (ast.ast-match-arm-fallback))))]
        (lower-match-rest-result-types-fast-at
          ctx
          env
          type-env
          type-cache
          function-state
          scrut-ty
          (& arms)
          1
          first-ty)))))

(define (lower-let-binding-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]) : tc_core.ResultTcType
  (match maybe-ty
    [(Some ty)
      (Ok (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty)))]
    [(No)
      (if (tc_core.tc-ref-capturing-lambda-init?
        (tc_core.tc-context-expr-bases ctx)
        type-env
        (lower-global-shared-view init))
        (match (ast.ast-expr-unspan (lower-global-shared-view init))
          [(Lambda lambda-box)
            (match (__tl-box-place lambda-box)
              [(Lambda params maybe-ret body-box)
                (let
                  [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
                  (tc_core.tc-lambda-expr-allow-ref-captures
                    ctx
                    type-env
                    params
                    maybe-ret
                    body))])]
          [_
            (lower-expr-result-type-fast
              ctx
              env
              type-env
              type-cache
              function-state
              init)])
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          init))]))

(define (lower-let-bindings-type-env-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [bindings : (& bindings ast.AstLetBindingList)]) : tc_core.ResultTcEnv
  (lower-let-bindings-type-env-fast-at
    ctx
    env
    type-env
    type-cache
    function-state
    (& bindings)
    0))

(define (lower-let-bindings-type-env-fast-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : tc_core.ResultTcEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok type-env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [name-id : i64 name]
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [binding-ty
            (try
              (lower-let-binding-result-type-fast
                ctx
                env
                type-env
                (lower-global-shared-view type-cache)
                function-state
                maybe-ty
                (lower-global-shared-view init)))]
          (lower-let-bindings-type-env-fast-at
            ctx
            (sym_i64_env.sym-i64-bind-id env name-id 0)
            (tc_core.tc-bind-initialized-value-id
              ctx
              type-env
              name-id
              binding-ty
              init)
            type-cache
            function-state
            bindings
            (+ index 1)))])))

(define (lower-let-bindings-local-env
  [env : sym_i64_env.SymI64Env]
  [bindings : ast.AstLetBindingList]) : sym_i64_env.SymI64Env
  (lower-let-bindings-local-env-at env (& bindings) 0))

(define (lower-let-bindings-local-env-at
  [env : sym_i64_env.SymI64Env]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : sym_i64_env.SymI64Env
  (if (>= index (ast.ast-let-binding-list-len bindings))
    env
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name _ _)
        (lower-let-bindings-local-env-at
          (sym_i64_env.sym-i64-bind-id env name 0)
          bindings
          (+ index 1))])))

(define (lower-projected-result-type-fast
  [ctx : tc_core.TcContext]
  [container-ty : ast.AstType]
  [projected-ty : ast.AstType]) : ast.AstType
  (tc_core.tc-type-without-regions
    (tc_core.tc-resolve-type
      ctx
      (tc_core.tc-project-from-region-container container-ty projected-ty))))

(define (lower-index-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [index : ast.AstExpr]) : tc_core.ResultTcType
  ;; The type checker contextually adopts i64 for a bare integer index. Do not
  ;; let the syntax-only result cache reintroduce the default i32 type and a
  ;; narrowing/sign-extension pair after that checked decision.
  (if (tc_core.tc-integer-literal-expr? ctx (lower-global-shared-view index))
    (Ok (I64))
    (let
      [index-ty : ast.AstType
        (try
          (lower-expr-result-type-fast
            ctx
            env
            type-env
            type-cache
            function-state
            index))]
      (if (tc_core.tc-integer-type? (lower-global-shared-view index-ty))
        (Ok index-ty)
        (Err "lower: index result type is not fast-pathable")))))

(define (lower-unary-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [op : ast.AstUnOp]
  [inner : ast.AstExpr]) : tc_core.ResultTcType
  (let
    [inner-ty : ast.AstType
      (try
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          inner))]
    [result-ty : ast.AstType (try (tc_core.tc-unop-type op inner-ty))]
    (Ok
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx result-ty)))))

(define (lower-tuple-ref-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [tuple-expr : ast.AstExpr]
  [index : i64]) : tc_core.ResultTcType
  (let
    [tuple-ty : ast.AstType
      (try
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          tuple-expr))]
    (match (tc_core.tc-type-strip-region
      (tc_core.tc-resolve-type ctx (lower-global-shared-view tuple-ty)))
      [(Tuple elem-tys)
        (let
          [elem-ty : ast.AstType
            (try (tc_core.tc-type-list-ref (deref elem-tys) index))]
          (Ok (lower-projected-result-type-fast ctx tuple-ty elem-ty)))]
      [_ (Err "lower: tuple-ref result type is not fast-pathable")])))

(define (lower-array-ref-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [array-expr : ast.AstExpr]
  [index : ast.AstExpr]) : tc_core.ResultTcType
  (let
    [_
      (try
        (lower-index-result-type-fast
          ctx
          env
          type-env
          (lower-global-shared-view type-cache)
          function-state
          index))]
    [array-ty : ast.AstType
      (try
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          array-expr))]
    (match (tc_core.tc-type-strip-region
      (tc_core.tc-resolve-type ctx (lower-global-shared-view array-ty)))
      [(Array elem-ty _)
        (Ok
          (lower-projected-result-type-fast
            ctx
            array-ty
            (tc_core.tc-context-type-get ctx elem-ty)))]
      [(DynArray elem-ty)
        (Ok
          (lower-projected-result-type-fast
            ctx
            array-ty
            (tc_core.tc-context-type-get ctx elem-ty)))]
      [_ (Err "lower: array-ref result type is not fast-pathable")])))

(define (lower-string-ref-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [str : ast.AstExpr]
  [index : ast.AstExpr]) : tc_core.ResultTcType
  (let
    [_
      (try
        (lower-index-result-type-fast
          ctx
          env
          type-env
          (lower-global-shared-view type-cache)
          function-state
          index))]
    [str-ty : ast.AstType
      (try
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          str))]
    (if (lower-string-handle-type? ctx str-ty)
      (Ok (Char))
      (Err "lower: string-ref result type is not fast-pathable"))))

(define (lower-struct-get-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [receiver : ast.AstExpr]
  [field : i64]) : tc_core.ResultTcType
  (let
    [receiver-ty : ast.AstType
      (try
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          receiver))]
    (match (tc_core.tc-type-strip-region
      (tc_core.tc-resolve-type ctx (lower-global-shared-view receiver-ty)))
      [(Struct struct-name)
        (let
          [field-ty : ast.AstType
            (try (tc_core.tc-struct-field-type-id ctx struct-name field))]
          (Ok (lower-projected-result-type-fast ctx receiver-ty field-ty)))]
      [(StructArgs struct-name lifetimes)
        (let
          [field-ty : ast.AstType
            (try
              (tc_core.tc-struct-field-type-with-args-id
                ctx
                struct-name
                (deref lifetimes)
                field))]
          (Ok (lower-projected-result-type-fast ctx receiver-ty field-ty)))]
      [_ (Err "lower: field projection result type is not fast-pathable")])))

(define (lower-box-get-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [box-expr : ast.AstExpr]) : tc_core.ResultTcType
  (let
    [box-ty : ast.AstType
      (try
        (lower-expr-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          box-expr))]
    (match (tc_core.tc-type-strip-region
      (tc_core.tc-resolve-type ctx (lower-global-shared-view box-ty)))
      [(Box inner-ty)
        (Ok
          (lower-projected-result-type-fast
            ctx
            box-ty
            (tc_core.tc-context-type-get ctx inner-ty)))]
      [_ (Err "lower: deref result type is not fast-pathable")])))

;; Compile-time: memoize lower-expr-result-type-fast by AST node id.
;; lower-expr-origin computes each expr's result type (walking the result-
;; determining spine) BEFORE lowering, and lowering the children re-walks their
;; spines -- so for deeply-nested functions a node's spine is recomputed once per
;; ancestor: O(N^2), the dominant lower-phase cost without this memo. The
;; owner lazily retains fixed
;; direct-mapped backing while each explicitly passed function state carries a
;; distinct generation. Nested lambdas/helpers may interleave safely: a nested
;; function can evict slots, but the enclosing generation then misses instead
;; of reading the nested function's scratch-owned type.
(define (lower-expr-result-type-fast
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [expr : ast.AstExpr]) : tc_core.ResultTcType
  (match expr
    [(Spanned inner-box _)
      (let
        [storage : CompilerLowerFunctionMemoStorage
          (compiler-lower-function-memo-storage
            (compiler-lower-function-state-owner function-state))]
        [generation : i64
          (compiler-lower-function-state-rtf-generation function-state)]
        [slot : i64 (% inner-box tc-rtf-cap)]
        (if (if (= (array-ref storage.rtf-generations slot) generation)
          (= (array-ref storage.rtf-ids slot) inner-box)
          false)
          (Ok (lower-global-array-element-shared-view storage.rtf-types slot))
          (let
            [ty
              (try
                (lower-expr-result-type-fast
                  ctx
                  env
                  type-env
                  type-cache
                  function-state
                  (lower-context-expr-get ctx inner-box)))]
            (set! (array-ref storage.rtf-generations slot) generation)
            (set! (array-ref storage.rtf-ids slot) inner-box)
            (set! (array-ref storage.rtf-types slot) ty)
            (Ok ty))))]
    [(MacroExpansion inner-box _ _)
      (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        function-state
        (lower-context-expr-get ctx inner-box))]
    [(Literal lit) (Ok (tc_core.tc-literal-type lit))]
    [(BinaryData _) (Ok (ast.ast-ty-dyn-array (U8)))]
    [(SpmdProgramIndex) (Ok (I64))]
    [(SpmdProgramCount) (Ok (I64))]
    [(Var name)
      (let
        [expr-ty (try (lower-lookup-type-id ctx type-cache env type-env name))]
        (Ok (tc_core.tc-type-without-regions expr-ty)))]
    [(Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id-with-pools
        (tc_core.tc-context-pools ctx)
        maybe-ty-id)
        [(Some ty)
          (Ok
            (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty)))]
        [(No) (Err "lower: contextual init requires an expected type")])]
    [(Ann _ ty-id)
      (Ok
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx ty-id))))]
    [(Cast _ ty-id)
      (Ok
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx ty-id))))]
    [(Unary op inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-unary-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          op
          inner))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (lower-call-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          func
          args))]
    [(Binary op left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (lower-binary-result-type-fast ctx type-env op left right))]
    [(If _ then-branch-box else-branch-box)
      (let
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-if-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          then-branch
          else-branch))]
    [(Begin exprs)
      (lower-expr-list-result-type-fast
        ctx
        env
        type-env
        type-cache
        function-state
        exprs)]
    [(Unsafe exprs)
      (lower-expr-list-result-type-fast
        ctx
        env
        (tc_core.tc-enter-unsafe type-env)
        type-cache
        function-state
        exprs)]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-match-result-type-fast
              ctx
              env
              type-env
              type-cache
              function-state
              scrutinee
              arms))])]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            [body-type-env
              (try
                (lower-let-bindings-type-env-fast
                  ctx
                  env
                  type-env
                  (lower-global-shared-view type-cache)
                  function-state
                  bindings))]
            (lower-expr-result-type-fast
              ctx
              (lower-let-bindings-local-env env bindings)
              body-type-env
              type-cache
              function-state
              body))])]
    [(TupleRef tuple-expr-box index)
      (let
        [tuple-expr : ast.AstExpr (lower-context-expr-get ctx tuple-expr-box)]
        (lower-tuple-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          tuple-expr
          index))]
    [(ArrayRef array-expr-box index-box)
      (let
        [array-expr : ast.AstExpr (lower-context-expr-get ctx array-expr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-array-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          array-expr
          index))]
    [(StringRef str-box index-box)
      (let
        [str : ast.AstExpr (lower-context-expr-get ctx str-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-string-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          str
          index))]
    [(StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-struct-get-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          receiver
          field))]
    [(BoxGet box-expr-box)
      (let
        [box-expr : ast.AstExpr (lower-context-expr-get ctx box-expr-box)]
        (lower-box-get-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          box-expr))]
    [(BoxTake box-expr-box)
      (let
        [box-expr : ast.AstExpr (lower-context-expr-get ctx box-expr-box)]
        (lower-box-get-result-type-fast
          ctx
          env
          type-env
          type-cache
          function-state
          box-expr))]
    [(Replace place-box _)
      (tc_core.tc-replace-place-value-type
        ctx
        type-env
        (lower-context-expr-get ctx place-box))]
    [(Set _ _) (Ok (Unit))]
    [(StructSet _ _ _) (Ok (Unit))]
    [(BoxSet _ _) (Ok (Unit))]
    [_ (Err "lower: expression result type is not fast-pathable")]))

(define (lower-expr-result-type-or-check
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [expr : (& expr ast.AstExpr)]) : tc_core.ResultTcType
  (let
    [expr : ast.AstExpr (owned_view.compiler-owned-reference-shared-view expr)]
    (match (lower-expr-result-type-fast
      ctx
      env
      type-env
      type-cache
      function-state
      (lower-global-shared-view expr))
      [(Ok expr-ty) (Ok expr-ty)]
      [(Err _) (tc_core.tc-expr ctx type-env expr)])))

(define (lower-index-result-type-or-check
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [index : ast.AstExpr]) : tc_core.ResultTcType
  (match (lower-index-result-type-fast
    ctx
    env
    type-env
    type-cache
    function-state
    (lower-global-shared-view index))
    [(Ok index-ty) (Ok index-ty)]
    [(Err _)
      (let
        [index-ty : ast.AstType
          (try
            (tc_core.tc-expr-with-expected-or-actual ctx type-env index (I64)))]
        (if (tc_core.tc-integer-type? (lower-global-shared-view index-ty))
          (Ok
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx index-ty)))
          (Err "lower: index result type is not fast-pathable")))]))

(define (lower-ptr-addr-of-local-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? local-id)
      (match (lower-lookup-type-id
        ctx
        (lower-state-type-cache state)
        env
        type-env
        name)
        [(Ok place-ty)
          (if (lower-ptr-addr-of-storage-value-reference?
            ctx
            (lower-global-shared-view place-ty))
            (Ok
              (Expr
                state
                (Var local-id)
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx place-ty))))
            (match (lower-state-alloc-var state)
              [(Alloc allocated var-id)
                (let
                  [addr-state : LowerState
                    (lower-state-emit-at-expr
                      ctx
                      allocated
                      (AddrOf var-id local-id)
                      origin)]
                  [marked-state : LowerState
                    (if (lower-type-register-resident?
                      ctx
                      (lower-global-shared-view place-ty))
                      (lower-state-register-address-taken-mark
                        addr-state
                        local-id)
                      addr-state)]
                  [addr-ty : ast.AstType
                    (tc_core.tc-type-without-regions
                      (tc_core.tc-resolve-type ctx place-ty))]
                  (Ok (Expr marked-state (Var var-id) addr-ty)))]))]
        [(Err message)
          (Err (box (lower-diagnostic-at-expr ctx origin message)))])
      (match (lower-lookup-type-id
        ctx
        (lower-state-type-cache state)
        env
        type-env
        name)
        [(Ok place-ty)
          (Ok
            (Expr
              state
              (if (lower-ptr-addr-of-storage-value-reference?
                ctx
                (lower-global-shared-view place-ty))
                (Global (lower-resolve-name-symbol-id state name))
                (GlobalAddr (lower-resolve-name-symbol-id state name)))
              (tc_core.tc-type-without-regions
                (tc_core.tc-resolve-type ctx place-ty))))]
        [(Err message)
          (Err (box (lower-diagnostic-at-expr ctx origin message)))]))))

(define (lower-integer-expr-with-expected-or-actual
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [expected-ty : ast.AstType]
  [non-integer-message : String]) : ResultLowerExpr
  (match (tc_core.tc-expr-with-expected-or-actual
    ctx
    type-env
    (lower-global-shared-view expr)
    expected-ty)
    [(Ok expr-ty)
      (let
        [resolved-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx expr-ty))]
        (if (tc_core.tc-integer-type? (lower-global-shared-view resolved-ty))
          (lower-expr-expected
            ctx
            state
            env
            type-env
            (lower-global-shared-view expr)
            resolved-ty
            expr)
          (Err (box (lower-diagnostic-at-expr ctx expr non-integer-message)))))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx expr message)))]))

(define (lower-for-owned-name-id [ctx : tc_core.TcContext] [expr-id : i64]) : i64
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    (match (ast.ast-expr-unspan-with-pools
      pools
      (lower-context-expr-get ctx expr-id))
      [(Var name) name]
      [_ -1])))

(define (lower-for-owned-state
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-name-id : i64]
  [index-name-id : i64]
  [source-id : i64]
  [body-id : i64]) : ResultLowerExpr
  (let
    [source-name : i64 (lower-for-owned-name-id ctx source-name-id)]
    [index-name : i64 (lower-for-owned-name-id ctx index-name-id)]
    [source : ast.AstExpr (lower-context-expr-get ctx source-id)]
    [body : ast.AstExpr (lower-context-expr-get ctx body-id)]
    (if (or (< source-name 0) (< index-name 0))
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            source
            "lower: invalid scalar for owned-array state names")))
      (let
        [lowered-source : LowerExpr
          (try (lower-expr ctx state env type-env source))]
        (match lowered-source
          [(Expr source-state source-value source-ty)
            (match (lower-state-alloc-var source-state)
              [(Alloc source-allocated source-var)
                (match (lower-state-alloc-var
                  (lower-state-emit
                    source-allocated
                    (Mov
                      source-var
                      source-value
                      (lower-one-word-register-storage-type ctx source-ty))))
                  [(Alloc index-allocated index-var)
                    (let
                      [bound-env : sym_i64_env.SymI64Env
                        (sym_i64_env.sym-i64-bind-id
                          (sym_i64_env.sym-i64-bind-id
                            env
                            source-name
                            source-var)
                          index-name
                          index-var)]
                      [bound-type-env : tc_core.TcTypeEnv
                        (tc_core.tc-bind-id
                          (tc_core.tc-bind-id type-env source-name source-ty)
                          index-name
                          (I64))]
                      [lowered-body : LowerExpr
                        (try
                          (lower-expr
                            ctx
                            (lower-state-emit
                              index-allocated
                              (Mov index-var (I64 0) (I64)))
                            bound-env
                            bound-type-env
                            body))]
                      (match lowered-body
                        [(Expr body-state _ body-ty)
                          (Ok
                            (Expr
                              body-state
                              Unit
                              (if (tc_core.tc-never-type?
                                (lower-global-shared-view body-ty))
                                body-ty
                                (Unit))))]))])])])))))

(define (lower-for-owned-step-generated
  [ctx : tc_core.TcContext]
  [source-id : i64]
  [index-id : i64]
  [binding-id : i64]
  [done-id : i64]
  [body-id : i64]
  [length : i64]) : i64
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    [index-name : i64 (lower-for-owned-name-id ctx index-id)]
    [binding-name : i64 (lower-for-owned-name-id ctx binding-id)]
    [done-name : i64 (lower-for-owned-name-id ctx done-id)]
    [one-id : i64
      (ast.ast-node-pool-context-expr-push pools (Literal (ast.ast-lit-int 1)))]
    [length-id : i64
      (ast.ast-node-pool-context-expr-push
        pools
        (Literal (ast.ast-lit-int length)))]
    [true-id : i64
      (ast.ast-node-pool-context-expr-push pools (Literal (Bool true)))]
    [item-id : i64 (ast.ast-expr-array-ref-with-pools pools source-id index-id)]
    [next-index-id : i64
      (ast.ast-expr-binary-with-pools pools (Add) index-id one-id)]
    [set-index-id : i64
      (ast.ast-expr-set-id-with-pools pools index-name next-index-id)]
    [item-body-items : ast.AstExprList (ast.ast-expr-list-with-capacity 2)]
    [item-bindings : ast.AstLetBindingList
      (ast.ast-let-binding-list-with-capacity 1)]
    (ast.ast-expr-list-push (&mut item-body-items) set-index-id)
    (ast.ast-expr-list-push (&mut item-body-items) body-id)
    (ast.ast-let-binding-list-push
      (&mut item-bindings)
      (ast.ast-let-binding-id binding-name (No) item-id))
    (ast.ast-expr-if-with-pools
      pools
      (ast.ast-expr-binary-with-pools pools (Lt) index-id length-id)
      (ast.ast-expr-let-with-pools
        pools
        item-bindings
        (ast.ast-node-pool-context-expr-push pools (Begin item-body-items)))
      (ast.ast-expr-set-id-with-pools pools done-name true-id))))

(define (lower-for-owned-step
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [index-id : i64]
  [binding-id : i64]
  [done-id : i64]
  [body-id : i64]) : ResultLowerExpr
  (match (let
    [type-cache (lower-state-type-cache state)]
    [function-state (lower-state-function-state state)]
    [expr (lower-context-expr-get ctx source-id)]
    (lower-expr-result-type-or-check
      ctx
      env
      type-env
      type-cache
      function-state
      expr))
    [(Ok source-ty)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx source-ty))
        [(Array _ length)
          (let
            [generated-id : i64
              (lower-for-owned-step-generated
                ctx
                source-id
                index-id
                binding-id
                done-id
                body-id
                length)]
            (lower-expr
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx generated-id)))]
        [_
          (Err
            (box
              (lower-diagnostic
                "lower: scalar for owned step requires fixed-array state")))])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

(define (lower-expr-typechecked
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-expr ctx type-env (lower-global-shared-view expr))
    [(Ok expr-ty)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc_core.tc-type-without-regions expr-ty))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx origin message)))]))

(define (lower-cast-source-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (tc_core.tc-integer-literal-expr? ctx (lower-global-shared-view expr))
    (lower-expr-with-type ctx state env type-env expr origin (I64))
    (lower-expr ctx state env type-env expr)))

;; Lowering runs after full-program typecheck. For result types that are
;; syntactically available, avoid re-running recursive expression typecheck;
;; the fallback below keeps the typecheck path for anything ambiguous.
(define (lower-expr-origin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-global-shared-view expr)
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-origin ctx state env type-env inner origin))]
    [(MacroExpansion inner-box _ _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-origin ctx state env type-env inner origin))]
    [(Literal lit)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc_core.tc-literal-type lit))]
    [(BinaryData _)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (ast.ast-ty-dyn-array (U8)))]
    [(Var name)
      (if (tc_core.tc-dotted-local-field-name-id? type-env name)
        (match (tc_core.tc-dotted-local-field-expr-id type-env name)
          [(Ok virtual-id)
            (lower-expr-origin
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin)]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx origin message)))])
        (match (lower-lookup-type-id
          ctx
          (lower-state-type-cache state)
          env
          type-env
          name)
          [(Ok expr-ty)
            (lower-expr-with-type
              ctx
              state
              env
              type-env
              expr
              origin
              (tc_core.tc-type-without-regions expr-ty))]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx origin message)))]))]
    [(Ann _ ty-id)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx ty-id))))]
    [(Cast _ ty-id)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx (tc_core.tc-context-type-get ctx ty-id))))]
    [(Binary op left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (match (lower-binary-result-type-fast ctx type-env op left right)
          [(Ok expr-ty)
            (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
          [(Err _) (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (match (lower-call-result-type-fast
          ctx
          env
          type-env
          (lower-state-type-cache state)
          (lower-state-function-state (lower-state-clone state))
          func
          args)
          [(Ok expr-ty)
            (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
          [(Err _) (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(Ok binding-state body-env body-type-env)
                (lower-expr ctx binding-state body-env body-type-env body)]
              [(Err message) (Err message)]))])]
    [(Begin exprs) (lower-begin ctx state env type-env exprs)]
    [(Unsafe exprs)
      (lower-begin ctx state env (tc_core.tc-enter-unsafe type-env) exprs)]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (match (lower-if-result-type-fast
          ctx
          env
          type-env
          (lower-state-type-cache state)
          (lower-state-function-state state)
          (lower-global-shared-view then-branch)
          (lower-global-shared-view else-branch))
          [(Ok expr-ty)
            (lower-if
              ctx
              state
              env
              type-env
              cond
              then-branch
              else-branch
              expr-ty)]
          [(Err _) (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (match (lower-match-result-type-fast
              ctx
              env
              type-env
              (lower-state-type-cache state)
              (lower-state-function-state state)
              (lower-global-shared-view scrutinee)
              arms)
              [(Ok expr-ty)
                (lower-match ctx state env type-env scrutinee arms expr-ty)]
              [(Err _)
                (lower-expr-typechecked ctx state env type-env expr origin)]))])]
    [_
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        (lower-state-type-cache state)
        (lower-state-function-state state)
        (lower-global-shared-view expr))
        [(Ok expr-ty)
          (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
        [(Err _) (lower-expr-typechecked ctx state env type-env expr origin)])]))

(define (lower-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (lower-expr-origin
    ctx
    state
    env
    type-env
    (lower-global-shared-view expr)
    expr))

;; Raw-pointer expressions stay grouped outside the main expression dispatcher.
;; Keeping their lowering helpers adjacent makes the shared representation rule
;; visible: pointers are scalar values, while pointee aggregates and register
;; groups still use the ordinary storage helpers on reads and writes.
(define (lower-c-fn-check-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (= args.len 1)
    (let
      [lowered
        (try
          (lower-expr
            ctx
            state
            env
            type-env
            (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))))]
      (match lowered
        [(Expr value-state value _)
          (match (lower-emit-binop
            value-state
            Eq
            (lower-global-shared-view value)
            (I64 0)
            (Bool))
            [(Expr condition-state condition _)
              (match (lower-state-fresh-label condition-state "c_fn_null")
                [(Label fail-state fail-label)
                  (match (lower-state-fresh-label fail-state "c_fn_checked")
                    [(Label labels-state checked-label)
                      (let
                        [fail-start : LowerState
                          (lower-state-finish-block
                            (lower-state-emit
                              labels-state
                              (Branch condition fail-label checked-label))
                            fail-label)]
                        (match (lower-state-alloc-var fail-start)
                          [(Alloc allocated ignored)
                            (cbi.compiler-builtin-refresh!)
                            (Ok
                              (Expr
                                (lower-state-finish-block
                                  (lower-state-emit
                                    (lower-state-emit
                                      allocated
                                      (Call
                                        ignored
                                        cbi.compiler-builtin-id-tl-c-fn-null-abort
                                        (Nil)
                                        (Never)))
                                    (Jump checked-label))
                                  checked-label)
                                value
                                result-ty))]))])])])]))
    (Err
      (box (lower-diagnostic "lower: c-fn-check expects exactly one argument")))))

(define (lower-ptr-null-expr [state : LowerState] [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [lowered (try (lower-materialize state (I64 0) (U64)))]
    (match lowered
      [(Expr null-state null-value _) (Ok (Expr null-state null-value expr-ty))])))

;; Operand context determines how the child is lowered; both paths share the
;; same fresh result and source-attributed emission after child lowering.
(define (lower-unary-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstUnOp]
  [inner-box : i64]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
    (match (lower-unop-type-with-result
      ctx
      type-env
      op
      (lower-global-shared-view inner)
      expr-ty)
      [(Ok result-ty)
        (let
          [lowered
            (try
              (match (tc_core.tc-unop-contextual-operand-type
                op
                (lower-global-shared-view result-ty))
                [(No) (lower-expr ctx state env type-env inner)]
                [(Some operand-ty)
                  (lower-expr-expected
                    ctx
                    state
                    env
                    type-env
                    (lower-global-shared-view inner)
                    operand-ty
                    inner)]))]
          (match lowered
            [(Expr inner-state value _)
              (match (lower-state-alloc-var inner-state)
                [(Alloc allocated var-id)
                  (Ok
                    (Expr
                      (lower-state-emit-at-expr
                        ctx
                        allocated
                        (UnOp
                          var-id
                          (lower-unop op)
                          value
                          (lower-global-shared-view result-ty))
                        origin)
                      (Var var-id)
                      result-ty))])]))]
      [(Err message) (Err (box (lower-diagnostic-at-expr ctx origin message)))])))

;; Logical operators lower through the existing conditional path. Other
;; operators lower left then right, carrying the returned state forward once.
(define (lower-binary-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstBinOp]
  [left-box : i64]
  [right-box : i64]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
    [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
    (match op
      [(And)
        (lower-if
          ctx
          state
          env
          type-env
          left
          right
          (Literal (Bool false))
          expr-ty)]
      [(Or)
        (lower-if
          ctx
          state
          env
          type-env
          left
          (Literal (Bool true))
          right
          expr-ty)]
      [_
        (match (lower-binop-types-with-result
          ctx
          type-env
          op
          (lower-global-shared-view left)
          (lower-global-shared-view right)
          expr-ty)
          [(Ok binop-types)
            (match binop-types
              [(TcBinOpTypes left-ty right-ty result-ty)
                (let
                  [left-lowered
                    (try
                      (lower-expr-expected
                        ctx
                        state
                        env
                        type-env
                        (lower-global-shared-view left)
                        (lower-global-shared-view left-ty)
                        left))]
                  (match left-lowered
                    [(Expr left-state left-value _)
                      (let
                        [right-lowered
                          (try
                            (lower-expr-expected
                              ctx
                              left-state
                              env
                              type-env
                              (lower-global-shared-view right)
                              (lower-global-shared-view right-ty)
                              right))]
                        (match right-lowered
                          [(Expr right-state right-value _)
                            (if (and
                              (lower-binop-group-eq? op)
                              (lower-type-register-group?
                                ctx
                                (lower-global-shared-view left-ty)))
                              (lower-group-equality
                                ctx
                                right-state
                                op
                                left-value
                                right-value
                                left-ty
                                result-ty
                                origin)
                              (match (lower-state-alloc-var right-state)
                                [(Alloc allocated var-id)
                                  (Ok
                                    (Expr
                                      (lower-state-emit-at-expr
                                        ctx
                                        allocated
                                        (BinOp
                                          var-id
                                          (lower-binop
                                            op
                                            (lower-global-shared-view right-ty))
                                          left-value
                                          right-value
                                          (if (ir.compiler-ir-binop-compare?
                                            (lower-binop op right-ty))
                                            left-ty
                                            (owned_view.compiler-owned-shared-view
                                              result-ty)))
                                        origin)
                                      (Var var-id)
                                      result-ty))]))]))]))])]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx origin message)))])])))

(define (lower-expr-with-type
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-with-type ctx state env type-env inner origin expr-ty))]
    [(MacroExpansion inner-box _ _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-with-type ctx state env type-env inner origin expr-ty))]
    [(Literal lit)
      (lower-materialize-at-expr
        ctx
        state
        (lower-literal-value-with-type
          (tc_core.tc-context-source-names ctx)
          lit
          (lower-global-shared-view expr-ty))
        expr-ty
        origin)]
    [(BinaryData bytes)
      (lower-materialize-at-expr ctx state (Bytes bytes) expr-ty origin)]
    [(SpmdProgramIndex)
      (lower-materialize-at-expr ctx state (I64 0) expr-ty origin)]
    [(SpmdProgramCount)
      (lower-materialize-at-expr ctx state (I64 1) expr-ty origin)]
    [(Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id-with-pools
        (tc_core.tc-context-pools ctx)
        maybe-ty-id)
        [(Some ty) (lower-init-expr ctx state env type-env ty origin expr-ty)]
        [(No)
          (lower-init-expr
            ctx
            state
            env
            type-env
            (lower-global-shared-view expr-ty)
            origin
            expr-ty)])]
    [(Var name)
      (if (tc_core.tc-dotted-local-field-name-id? type-env name)
        (match (tc_core.tc-dotted-local-field-expr-id type-env name)
          [(Ok virtual-id)
            (lower-expr-with-type
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin
              expr-ty)]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx origin message)))])
        (lower-var-or-nullary-variant-id ctx state env type-env name expr-ty))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              inner
              (lower-global-shared-view expr-ty)
              origin))]
        (match lowered
          [(Expr inner-state value _) (Ok (Expr inner-state value expr-ty))]))]
    [(Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [lowered : LowerExpr
          (try (lower-cast-source-expr ctx state env type-env inner origin))]
        (match lowered
          [(Expr inner-state value inner-ty)
            (Ok (lower-cast-value inner-state value inner-ty expr-ty))]))]
    [(Borrow _ _ inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-borrow-expr ctx state env type-env inner origin expr-ty))]
    [(Unary op inner-box)
      (lower-unary-expr ctx state env type-env op inner-box origin expr-ty)]
    [(Binary op left-box right-box)
      (lower-binary-expr
        ctx
        state
        env
        type-env
        op
        left-box
        right-box
        origin
        expr-ty)]
    [(Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (lower-call ctx state env type-env func args expr-ty origin))]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (lower-lambda
              ctx
              state
              env
              type-env
              params
              maybe-ret
              body
              origin
              expr-ty))])]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(Ok binding-state body-env body-type-env)
                (lower-expr-expected
                  ctx
                  binding-state
                  body-env
                  body-type-env
                  (lower-global-shared-view body)
                  expr-ty
                  body)]
              [(Err message) (Err message)]))])]
    [(Begin exprs) (lower-begin-expected ctx state env type-env exprs expr-ty)]
    [(Unsafe exprs)
      (lower-begin-expected
        ctx
        state
        env
        (tc_core.tc-enter-unsafe type-env)
        exprs
        expr-ty)]
    [(Set name value-box)
      (let
        [name-id : i64 name]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [name-text : String (tc_core.tc-env-key-name-text name)]
        (if (tc_core.tc-dotted-local-field-name-id? type-env name)
          (match (tc_core.tc-dotted-local-field-set-expr-id
            (tc_core.tc-context-expr-bases ctx)
            type-env
            name
            value-box)
            [(Ok virtual-id)
              (lower-expr-with-type
                ctx
                state
                env
                type-env
                (lower-context-expr-get ctx virtual-id)
                origin
                expr-ty)]
            [(Err message)
              (Err (box (lower-diagnostic-at-expr ctx origin message)))])
          (match (lower-lookup-type-id
            ctx
            (lower-state-type-cache state)
            env
            type-env
            name-id)
            [(Ok store-ty)
              (let
                [target-ty : ast.AstType
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx store-ty))]
                [target-ir-ty : ast.AstType
                  (lower-one-word-register-storage-type ctx target-ty)]
                [lowered
                  (try
                    (lower-expr-expected
                      ctx
                      state
                      env
                      type-env
                      (lower-global-shared-view value)
                      (lower-global-shared-view target-ty)
                      value))]
                (match lowered
                  [(Expr value-state value-ir _)
                    (let
                      [id : i64
                        (sym_i64_env.sym-i64-lookup-id-or
                          env
                          name-id
                          (csym.compiler-symbols-missing-handle))]
                      (if (csym.compiler-symbols-handle-found? id)
                        (let
                          [assignment
                            (try
                              (lower-local-assignment-value
                                ctx
                                value-state
                                value-ir
                                (lower-global-shared-view target-ty)
                                id))]
                          (match assignment
                            [(Expr assign-value-state assign-ir _)
                              (let
                                [assign-state
                                  : LowerState
                                  ;; A rebound aggregate param may point at
                                  ;; current-frame storage, so its var id no
                                  ;; longer proves tail-call forwarding is safe.
                                  (if (and
                                    (lower-state-tail-param-range-contains?
                                      assign-value-state
                                      id)
                                    (lower-type-contains-inline-aggregate?
                                      ctx
                                      target-ty))
                                    (lower-state-clear-tail-param-range
                                      assign-value-state)
                                    assign-value-state)]
                                (Ok
                                  (Expr
                                    (lower-state-emit-at-expr
                                      ctx
                                      assign-state
                                      (Mov id assign-ir target-ir-ty)
                                      origin)
                                    Unit
                                    expr-ty)))]))
                        (let
                          [store-copy : LowerExpr
                            (try
                              (lower-return-abi-value
                                ctx
                                value-state
                                value-ir
                                target-ty))]
                          (match store-copy
                            [(Expr store-state store-ir _)
                              (let
                                [target-id : i64
                                  (lower-resolve-name-symbol-id
                                    store-state
                                    name-id)]
                                (Ok
                                  (Expr
                                    (lower-state-emit-at-expr
                                      ctx
                                      store-state
                                      (Store target-id store-ir target-ir-ty)
                                      origin)
                                    Unit
                                    expr-ty)))]))))]))]
            [(Err _)
              (Err
                (box
                  (lower-diagnostic-at-expr
                    ctx
                    origin
                    (str_cat.str-cat
                      "lower: assignment to unknown local "
                      name-text))))])))]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-if ctx state env type-env cond then-branch else-branch expr-ty))]
    [(While cond-box body-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [body : ast.AstExpr (Begin body-box)]
        (lower-while ctx state env type-env cond body))]
    [(ForOwnedState payload)
      (lower-for-owned-state
        ctx
        state
        env
        type-env
        (ast.ast-for-owned-state-source-name (& payload))
        (ast.ast-for-owned-state-index-name (& payload))
        (ast.ast-for-owned-state-source (& payload))
        (ast.ast-for-owned-state-body (& payload)))]
    [(ForOwnedStep payload)
      (lower-for-owned-step
        ctx
        state
        env
        type-env
        (ast.ast-for-owned-step-source-name (& payload))
        (ast.ast-for-owned-step-index-name (& payload))
        (ast.ast-for-owned-step-binding-name (& payload))
        (ast.ast-for-owned-step-done-name (& payload))
        (ast.ast-for-owned-step-body (& payload)))]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach index index-ty start-box end-box body-box)
          (let
            [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
            [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (lower-foreach
              ctx
              state
              env
              type-env
              index
              (tc_core.tc-env-key-name-text index)
              index-ty
              start
              end
              body))]
        [(Foreach2 outer _ a-box b-box inner _ c-box d-box body-box)
          (lower-foreach2
            ctx
            state
            env
            type-env
            outer
            a-box
            b-box
            inner
            c-box
            d-box
            body-box)])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce op index index-ty start-box end-box init-box value-box)
          (let
            [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
            [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
            [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
            [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
            (lower-spmd-reduce
              ctx
              state
              env
              type-env
              expr-ty
              op
              index
              (tc_core.tc-env-key-name-text index)
              index-ty
              start
              end
              init
              value))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
            [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
            [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
            [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (lower-spmd-scan
              ctx
              state
              env
              type-env
              op
              index
              (tc_core.tc-env-key-name-text index)
              index-ty
              start
              end
              prefix
              (tc_core.tc-env-key-name-text prefix)
              prefix-ty
              init
              value
              body))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact index _ start-box end-box slot _ init-box keep-box body-box)
          (let
            [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
            [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
            [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
            [keep : ast.AstExpr (lower-context-expr-get ctx keep-box)]
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (lower-spmd-compact
              ctx
              state
              env
              type-env
              index
              start
              end
              slot
              init
              keep
              body))])]
    [(SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (lower-spmd-broadcast ctx state env type-env value lane))]
    [(SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (lower-spmd-shuffle ctx state env type-env value lane))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-match ctx state env type-env scrutinee arms expr-ty))])]
    [(StringRef str-box index-box)
      (let
        [str : ast.AstExpr (lower-context-expr-get ctx str-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-string-ref ctx state env type-env str index origin))]
    [(StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-field-get ctx state env type-env receiver field expr-ty))]
    [(StructSet receiver-box field value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-struct-set ctx state env type-env receiver field value origin))]
    [(FixedMakeArray _ _)
      (lower-init-expr
        ctx
        state
        env
        type-env
        (lower-global-shared-view expr-ty)
        origin
        expr-ty)]
    [(MakeArray elem-ty-id len-box)
      (let
        [len : ast.AstExpr (lower-context-expr-get ctx len-box)]
        (lower-make-array
          ctx
          state
          env
          type-env
          (tc_core.tc-context-type-get ctx elem-ty-id)
          len
          origin))]
    [(Array values)
      (lower-array-literal ctx state env type-env values expr-ty origin)]
    [(DynArray values)
      (lower-dyn-array-literal ctx state env type-env values expr-ty origin)]
    [(ArrayRef arr-box index-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-array-ref ctx state env type-env arr index))]
    [(ArraySet arr-box index-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-array-set ctx state env type-env arr index value))]
    [(ArrayTake arr-box live-box index-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [live : ast.AstExpr (lower-context-expr-get ctx live-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-array-take ctx state env type-env arr live index expr-ty))]
    [(Replace place-box replacement-box)
      (let
        [place : ast.AstExpr (lower-context-expr-get ctx place-box)]
        [replacement : ast.AstExpr (lower-context-expr-get ctx replacement-box)]
        (lower-replace ctx state env type-env place replacement expr-ty origin))]
    [(ArrayPush arr-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-array-push ctx state env type-env arr value))]
    [(Tuple values) (lower-tuple ctx state env type-env values expr-ty origin)]
    [(TupleRef tuple-expr-box index)
      (let
        [tuple-expr : ast.AstExpr (lower-context-expr-get ctx tuple-expr-box)]
        (lower-tuple-ref ctx state env type-env tuple-expr index expr-ty))]
    [(WithRegion _ body) (lower-with-arena ctx state env type-env body)]
    [(WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr (lower-context-expr-get ctx scratch-box)]
        (lower-with-escape ctx state env type-env scratch body))]
    [(WithScratch body) (lower-with-scratch ctx state env type-env body)]
    [(InArena arena-box body)
      (let
        [arena : ast.AstExpr (lower-context-expr-get ctx arena-box)]
        (lower-in-arena ctx state env type-env arena body))]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (lower-with-resource ctx state env type-env bindings body)])]
    [(Box inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box ctx state env type-env inner expr-ty))]
    [(BoxGet inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expr-ty))]
    [(BoxTake inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expr-ty))]
    [(BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-box-set ctx state env type-env inner value origin))]
    [(Try inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-try ctx state env type-env inner origin))]
    [(Return value-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-return-form ctx state env type-env value origin))]
    [(Break) (lower-loop-control-form ctx state env type-env origin "break")]
    [(Continue)
      (lower-loop-control-form ctx state env type-env origin "continue")]
    ;; `(comptime expr)` folds to a literal via the scalar CTFE evaluator.
    ;; Successful folds reuse the ordinary literal path; CTFE rejections (free
    ;; runtime vars and unsupported CTFE forms surface as lower errors.
    [(Comptime inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [ctfe-env : ctfe.CtfeEnv
          (tc_core.tc-ctfe-env-for-comptime
            ctx
            (lower-global-shared-view inner))]
        (match (ctfe.compiler-ctfe-eval inner ctfe-env (ctfe.ctfe-fuel-limit))
          [(Ok value _)
            (match (lower-global-shared-view value)
              [(Type ty)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      (str_cat.str-cat
                        "type value "
                        (tc_core.tc-type-render
                          (tc_core.tc-resolve-type ctx ty))
                        " is compile-time only"))))]
              [(String _ _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "String value is compile-time only")))]
              [(Name _ _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "String value is compile-time only")))]
              [(Expr _ _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "Expr value is compile-time only")))]
              [(ExprList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "ExprList value is compile-time only")))]
              [(ExprClause _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "ExprClause value is compile-time only")))]
              [(ExprClauseList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "ExprClauseList value is compile-time only")))]
              [(ExprBindingClause _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "ExprBindingClause value is compile-time only")))]
              [(ExprBindingClauseList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "ExprBindingClauseList value is compile-time only")))]
              [(Pattern _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "Pattern value is compile-time only")))]
              [(PatternList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "PatternList value is compile-time only")))]
              [(MatchArm _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "MatchArm value is compile-time only")))]
              [(MatchArmList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "MatchArmList value is compile-time only")))]
              [(LetBinding _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "LetBinding value is compile-time only")))]
              [(LetBindingList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "LetBindingList value is compile-time only")))]
              [(TypeInfo _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "TypeInfo value is compile-time only")))]
              [(TypeInfoBox _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "TypeInfo box value is compile-time only")))]
              [(TypeInfoList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "TypeInfoList value is compile-time only")))]
              [(TypeField _ _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "TypeField value is compile-time only")))]
              [(TypeFieldList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "TypeFieldList value is compile-time only")))]
              [(TypeVariantPayload _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "TypeVariantPayload value is compile-time only")))]
              [(TypeVariantPayloadList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "TypeVariantPayloadList value is compile-time only")))]
              [(TypeVariant _ _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "TypeVariant value is compile-time only")))]
              [(TypeVariantList _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      origin
                      "TypeVariantList value is compile-time only")))]
              [_
                (lower-materialize
                  state
                  (lower-literal-value-with-type
                    (tc_core.tc-context-source-names ctx)
                    (ctfe.ctfe-value-to-literal-for-type
                      value
                      (lower-global-shared-view expr-ty))
                    (lower-global-shared-view expr-ty))
                  expr-ty)])]
          [(Err diag) (Err diag)]))]
    [(Quote _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "Expr value is compile-time only")))]
    [(Quasiquote _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "Expr value is compile-time only")))]
    [(Unquote _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "unquote is only valid inside quasiquote")))]
    [(UnquoteSplicing _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "unquote-splicing is only valid inside quasiquote")))]
    [(TypeLiteral ty-id)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            (str_cat.str-cat
              "type value "
              (tc_core.tc-type-render
                (tc_core.tc-resolve-type
                  ctx
                  (tc_core.tc-context-type-get ctx ty-id)))
              " is compile-time only"))))]
    ;; `(ptr-null : T)` is a pointer-sized zero (pointer ABI size is 8);
    ;; `(ptr-null? p)` is `p == 0` producing a `bool`. No new IR/asm needed.
    [(PtrNull _) (lower-ptr-null-expr state expr-ty)]
    [(PtrNullCheck inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [lowered : LowerExpr (try (lower-expr ctx state env type-env inner))]
        (match lowered
          [(Expr inner-state inner-value _)
            (Ok (lower-emit-binop inner-state Eq inner-value (I64 0) (Bool)))]))]
    [(PtrAddrOf place-box)
      (let
        [place : ast.AstExpr (lower-context-expr-get ctx place-box)]
        (match (tc_core.tc-ptr-addr-of-place
          ctx
          type-env
          (lower-global-shared-view place))
          [(Ok _)
            (let
              [lowered
                (try
                  (match (ast.ast-expr-unspan (lower-global-shared-view place))
                    [(Var name)
                      (lower-ptr-addr-of-local-address
                        ctx
                        state
                        env
                        type-env
                        name
                        origin)]
                    [_
                      (lower-mutable-place-address
                        ctx
                        state
                        env
                        type-env
                        place
                        origin)]))]
              (match lowered
                [(Expr addr-state addr-value _)
                  (Ok (Expr addr-state addr-value expr-ty))]))]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx origin message)))]))]
    [(PtrRead ptr-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        [lowered : LowerExpr (try (lower-expr ctx state env type-env ptr))]
        (match lowered
          [(Expr ptr-state ptr-value _)
            (lower-array-elem-ref-result ctx ptr-state ptr-value expr-ty)]))]
    [(PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [ptr-lowered : LowerExpr (try (lower-expr ctx state env type-env ptr))]
        (match ptr-lowered
          [(Expr ptr-state ptr-value ptr-ty)
            ;; Preserve left-to-right evaluation: the value expression may
            ;; lower to calls or other effects, so keep the pointer in its own
            ;; raw pointer temp before lowering the value.
            (match (lower-state-alloc-var ptr-state)
              [(Alloc ptr-allocated ptr-var)
                (let
                  [ptr-home-state : LowerState
                    (lower-state-emit
                      ptr-allocated
                      (Mov
                        ptr-var
                        ptr-value
                        (lower-raw-pointer-ir-type
                          (lower-global-shared-view ptr-ty))))]
                  (match (tc_core.tc-mut-pointer-elem
                    (tc_core.tc-resolve-type ctx ptr-ty)
                    "lower: ptr-write! requires MutPtr pointer operand")
                    [(Ok elem-ty)
                      (let
                        [value-lowered
                          (try
                            (lower-expr-expected
                              ctx
                              ptr-home-state
                              env
                              type-env
                              (lower-global-shared-view value)
                              (tc_core.tc-type-without-regions elem-ty)
                              value))]
                        (match value-lowered
                          [(Expr value-state value-ir value-ty)
                            (Ok
                              (Expr
                                ;; Raw-pointer writes use the same storage
                                ;; contract as array element writes.
                                ;; Memory aggregates are represented by
                                ;; an address and must copy their complete
                                ;; inline representation; StorePtr would
                                ;; otherwise write that address into only
                                ;; the first word. Two-word register
                                ;; groups likewise need both words.
                                (if (and
                                  (lower-type-inline-storage? ctx value-ty)
                                  (not
                                    (lower-type-register-resident?
                                      ctx
                                      (lower-global-shared-view value-ty))))
                                  (lower-copy-bytes
                                    value-state
                                    (Var ptr-var)
                                    0
                                    value-ir
                                    0
                                    (lower-type-size ctx value-ty))
                                  (if (lower-type-register-group?
                                    ctx
                                    (lower-global-shared-view value-ty))
                                    (lower-store-group-at-ptr
                                      ctx
                                      value-state
                                      (Var ptr-var)
                                      value-ir
                                      value-ty)
                                    (lower-state-emit-at-expr
                                      ctx
                                      value-state
                                      (StorePtr (Var ptr-var) value-ir value-ty)
                                      origin)))
                                Unit
                                expr-ty))]))]
                    [(Err message)
                      (Err (box (lower-diagnostic-at-expr ctx origin message)))]))])]))]
    [(PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        [offset : ast.AstExpr (lower-context-expr-get ctx offset-box)]
        [ptr-lowered : LowerExpr (try (lower-expr ctx state env type-env ptr))]
        (match ptr-lowered
          [(Expr ptr-state ptr-value ptr-ty)
            (let
              [offset-lowered
                (try
                  (lower-expr-expected
                    ctx
                    ptr-state
                    env
                    type-env
                    (lower-global-shared-view offset)
                    (I64)
                    offset))]
              (match offset-lowered
                [(Expr offset-state offset-value _)
                  (match (tc_core.tc-type-strip-region
                    (tc_core.tc-resolve-type ctx ptr-ty))
                    [(Ptr elem-ty)
                      (match (lower-emit-elem-addr-gep
                        ctx
                        offset-state
                        ptr-value
                        offset-value
                        (tc_core.tc-context-type-get ctx elem-ty))
                        [(Expr gep-state gep-value _)
                          (Ok (Expr gep-state gep-value expr-ty))])]
                    [(MutPtr elem-ty)
                      (match (lower-emit-elem-addr-gep
                        ctx
                        offset-state
                        ptr-value
                        offset-value
                        (tc_core.tc-context-type-get ctx elem-ty))
                        [(Expr gep-state gep-value _)
                          (Ok (Expr gep-state gep-value expr-ty))])]
                    [_
                      (Err
                        (box
                          (lower-diagnostic-at-expr
                            ctx
                            origin
                            "lower: ptr-offset requires raw pointer")))])]))]))]
    [(PtrCast ptr-box _)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        [lowered : LowerExpr (try (lower-expr ctx state env type-env ptr))]
        (match lowered
          [(Expr ptr-state ptr-value ptr-ty)
            (Ok (lower-cast-value ptr-state ptr-value ptr-ty expr-ty))]))]
    [(PtrToInt ptr-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        [lowered : LowerExpr (try (lower-expr ctx state env type-env ptr))]
        (match lowered
          [(Expr ptr-state ptr-value ptr-ty)
            (Ok (lower-cast-value ptr-state ptr-value ptr-ty expr-ty))]))]
    [(IntToPtr value-box _)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lowered : LowerExpr (try (lower-expr ctx state env type-env value))]
        (match lowered
          [(Expr value-state value-ir value-ty)
            (Ok (lower-cast-value value-state value-ir value-ty expr-ty))]))]
    [(StringData str-box)
      (let
        [str : ast.AstExpr (lower-context-expr-get ctx str-box)]
        (lower-string-data ctx state env type-env str expr-ty))]
    [(StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (lower-context-expr-get ctx ptr-box)]
        [len : ast.AstExpr (lower-context-expr-get ctx len-box)]
        (lower-string-from-bytes ctx state env type-env ptr len))]
    [(ArrayData array-box)
      (let
        [array : ast.AstExpr (lower-context-expr-get ctx array-box)]
        (lower-array-data ctx state env type-env array expr-ty))]
    [(ProgramArgc) (lower-entry-load state 0 expr-ty)]
    [(ProgramArgv) (lower-entry-load state 1 expr-ty)]
    [(ProgramEnvp) (lower-entry-load state 2 expr-ty)]
    [(CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : ast.AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 0))]
    [(CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : ast.AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 1))]
    [(CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : ast.AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 2))]
    [(CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : ast.AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 3))]
    [(Xgetbv index-box)
      (let
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-xgetbv ctx state env type-env index))]
    [(Syscall args) (lower-syscall ctx state env type-env args)]
    [(ForeachActive lane body-box)
      (if (lower-mode-simd? (lower-state-mode state))
        (Err
          (box
            (lower-diagnostic-at-expr
              ctx
              origin
              (lower-foreach-active-simd-message (lower-state-mode state)))))
        (lower-scalar-foreach-active
          ctx
          state
          env
          type-env
          lane
          (lower-context-expr-get ctx body-box)))]
    [(LaneValue value-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-expr-expected
          ctx
          state
          env
          type-env
          (lower-global-shared-view value)
          expr-ty
          value))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr ctx origin "lower: unsupported expression")))]))

(define (lower-expr-with-type-and-coerce
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]
  [expr-ty : ast.AstType]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (let
    [lowered : LowerExpr
      (try (lower-expr-with-type ctx state env type-env expr origin expr-ty))]
    (match lowered
      [(Expr next-state value actual-ty)
        (Ok (lower-coerce-value next-state value actual-ty expected-ty))])))

(define (lower-expr-and-coerce
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-expr-with-expected-or-actual
    ctx
    type-env
    (lower-global-shared-view expr)
    (lower-global-shared-view expected-ty))
    [(Ok actual-ty)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        (lower-global-shared-view expr)
        expr
        (tc_core.tc-type-without-regions
          (tc_core.tc-resolve-type ctx actual-ty))
        expected-ty)]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx expr message)))]))

(define (lower-expr-expected
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [expected-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-global-shared-view expr)
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-expected ctx state env type-env inner expected-ty origin))]
    [(MacroExpansion inner-box _ _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-expected ctx state env type-env inner expected-ty origin))]
    [(Literal lit)
      (lower-materialize-at-expr
        ctx
        state
        (lower-literal-value-with-type
          (tc_core.tc-context-source-names ctx)
          lit
          (lower-global-shared-view expected-ty))
        expected-ty
        origin)]
    [(Unary _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        (lower-global-shared-view expected-ty)
        expected-ty)]
    [(Binary _ _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        (lower-global-shared-view expected-ty)
        expected-ty)]
    [(Let _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        (lower-global-shared-view expected-ty)
        expected-ty)]
    [(Begin _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        (lower-global-shared-view expected-ty)
        expected-ty)]
    [(Unsafe _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        (lower-global-shared-view expected-ty)
        expected-ty)]
    [(Array _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        (lower-global-shared-view expected-ty)
        expected-ty)]
    [(DynArray _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        (lower-global-shared-view expected-ty)
        expected-ty)]
    [(Tuple _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        (lower-global-shared-view expected-ty)
        expected-ty)]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-if
          ctx
          state
          env
          type-env
          cond
          then-branch
          else-branch
          expected-ty))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-match ctx state env type-env scrutinee arms expected-ty))])]
    [(Box inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box ctx state env type-env inner expected-ty))]
    [(BoxGet inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expected-ty))]
    [(BoxTake inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expected-ty))]
    [(Borrow _ _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        (lower-global-shared-view expected-ty)
        expected-ty)]
    [(Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id-with-pools
        (tc_core.tc-context-pools ctx)
        maybe-ty-id)
        [(No)
          (lower-init-expr
            ctx
            state
            env
            type-env
            (lower-global-shared-view expected-ty)
            origin
            expected-ty)]
        [(Some _)
          (lower-expr-and-coerce ctx state env type-env expr expected-ty)])]
    [(Call func-box _)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        [expected-resolved : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx (lower-global-shared-view expected-ty)))]
        (if (match (tc_core.tc-type-strip-region
          (lower-global-shared-view expected-resolved))
          [(Enum _) true]
          [(EnumArgs _ _) true]
          [_ false])
          (lower-expr-with-type-and-coerce
            ctx
            state
            env
            type-env
            expr
            origin
            expected-resolved
            expected-ty)
          (match (ast.ast-expr-unspan func)
            [(Var name)
              (match (lower-lookup-type-id
                ctx
                (lower-state-type-cache state)
                env
                type-env
                name)
                [(Ok fn-ty)
                  (match (tc_core.tc-type-strip-region
                    (tc_core.tc-resolve-type ctx fn-ty))
                    [(Func _ ret-ty)
                      (let
                        [actual-ty : ast.AstType
                          (tc_core.tc-type-without-regions
                            (tc_core.tc-resolve-type
                              ctx
                              (tc_core.tc-context-type-get ctx ret-ty)))]
                        (if (tc_core.tc-type-eq
                          (lower-global-shared-view actual-ty)
                          expected-resolved)
                          (lower-expr-with-type-and-coerce
                            ctx
                            state
                            env
                            type-env
                            expr
                            origin
                            actual-ty
                            expected-ty)
                          (lower-expr-and-coerce
                            ctx
                            state
                            env
                            type-env
                            expr
                            expected-ty)))]
                    [_
                      (lower-expr-and-coerce
                        ctx
                        state
                        env
                        type-env
                        expr
                        expected-ty)])]
                [(Err _)
                  (lower-expr-and-coerce
                    ctx
                    state
                    env
                    type-env
                    expr
                    expected-ty)])]
            [_ (lower-expr-and-coerce ctx state env type-env expr expected-ty)])))]
    [_ (lower-expr-and-coerce ctx state env type-env expr expected-ty)]))

(define (lower-owned-handle-type? [ctx : tc_core.TcContext] [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(DynArray _) true]
    [(String) true]
    [_ false]))

(define (lower-struct-get-named
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [receiver-value : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field : String]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [info : LowerFieldInfo
      (try (lower-struct-field-info ctx struct-id struct-name field))]
    (match info
      [(Info offset field-ty)
        ;; When the receiver is a register-resident struct, its value is
        ;; the packed word itself; extract the field with shift/mask instead of
        ;; computing an address and loading from memory.
        (if (tc_core.tc-name-register-resident-id? ctx struct-id)
          (if (lower-type-register-group? ctx (Struct struct-id))
            ;; 2-word register-group receiver: select the field's word with
            ;; CompilerIrInstr.Word, then shift/mask within that word at its relative
            ;; offset.
            (match (lower-emit-word
              state
              receiver-value
              (/ offset 8)
              (let
                [ty (ast.AstType.Struct struct-id)]
                (lower-register-word-type ctx ty (/ offset 8))))
              [(Expr w-state w-value _)
                (match (lower-extract-word-field
                  ctx
                  w-state
                  w-value
                  (let
                    [ty (ast.AstType.Struct struct-id)]
                    (lower-register-word-type ctx ty (/ offset 8)))
                  (- offset (* (/ offset 8) 8))
                  field-ty)
                  [(Expr ext-state ext-value _)
                    (Ok (Expr ext-state ext-value result-ty))])])
            (match (lower-extract-word-field
              ctx
              state
              receiver-value
              (let
                [ty (ast.AstType.Struct struct-id)]
                (lower-register-word-type ctx ty 0))
              offset
              field-ty)
              [(Expr ext-state ext-value _)
                (Ok (Expr ext-state ext-value result-ty))]))
          (lower-struct-field-load-at-offset
            ctx
            state
            receiver-value
            struct-id
            offset
            field-ty
            result-ty))])))

;; Read the field of struct `struct-id` stored `offset` bytes from `base`.
(define (lower-struct-field-load-at-offset
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [offset : i64]
  [field-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-gep-byte state base offset)
    [(Expr ptr-state ptr _)
      ;; A register-resident field is carried as a packed word,
      ;; so its value is the LOADED word, never the field address --
      ;; exclude it from the in-place pointer-return shape (otherwise a
      ;; later `match`/`=` would read the address as if it were the tag).
      ;; A genuine memory aggregate field still returns its in-place
      ;; pointer. This mirrors `lower-load-inline-value-at-offset`.
      (cond
        [(and
            (not
              (lower-type-register-resident?
                ctx
                (lower-global-shared-view field-ty)))
            (or
              (and
                (lower-struct-repr-c-id? ctx struct-id)
                (lower-repr-c-inline-field?
                  ctx
                  (lower-global-shared-view field-ty)))
              (lower-type-inline-storage? ctx field-ty)))
          (Ok (Expr ptr-state ptr result-ty))]
        [(lower-type-register-group? ctx (lower-global-shared-view field-ty))
          (match (lower-load-group-from-ptr ctx ptr-state ptr field-ty)
            [(Expr g-state g-value _) (Ok (Expr g-state g-value result-ty))])]
        [(lower-type-register-resident? ctx (lower-global-shared-view field-ty))
          (match (lower-state-alloc-var ptr-state)
            [(Alloc allocated var-id)
              (Ok
                (Expr
                  (lower-state-emit
                    allocated
                    (Load var-id ptr (lower-register-word-type ctx field-ty 0)))
                  (Var var-id)
                  result-ty))])]
        [else
          (match (lower-state-alloc-var ptr-state)
            [(Alloc allocated var-id)
              (Ok
                (Expr
                  (lower-state-emit allocated (Load var-id ptr field-ty))
                  (Var var-id)
                  result-ty))])])]))

;; A struct-field read. A field place rooted at a raw-pointer `deref`, as in
;; `(deref p).a.b`, loads just that field at its offset from `p`, so the
;; pointee is never copied, even a struct otherwise carried in registers. Any
;; other receiver is lowered as a value first.
(define (lower-field-get
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [field : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (if (lower-raw-deref-place?
    ctx
    state
    env
    type-env
    (lower-global-shared-view receiver))
    (let
      [lowered : LowerExpr
        (try (lower-raw-deref-place-address ctx state env type-env receiver))]
      (match lowered
        [(Expr place-state base receiver-ty)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx receiver-ty))
            [(Struct struct-id)
              (lower-raw-deref-field-load
                ctx
                place-state
                base
                struct-id
                (tc_core.tc-env-key-name-text field)
                result-ty)]
            [(StructArgs struct-id _)
              (lower-raw-deref-field-load
                ctx
                place-state
                base
                struct-id
                (tc_core.tc-env-key-name-text field)
                result-ty)]
            [_
              (Err
                (box
                  (lower-diagnostic "lower: field projection requires struct")))])]))
    (lower-struct-get ctx state env type-env receiver field result-ty)))

;; Whether `place` is a struct-field place rooted at `(deref p)` over a raw
;; pointer `p`. The typechecker admits such a deref only as a struct-field
;; projection receiver (`tc-raw-deref-whole-message`).
(define (lower-raw-deref-place?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]) : bool
  (match place
    [(Spanned inner-box _)
      (lower-raw-deref-place?
        ctx
        state
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(StructGet receiver-box _)
      (lower-raw-deref-place?
        ctx
        state
        env
        type-env
        (lower-context-expr-get ctx receiver-box))]
    [(BoxTake pointer-box)
      (let
        [pointer : ast.AstExpr (lower-context-expr-get ctx pointer-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          (lower-state-function-state state)
          pointer)
          [(Ok pointer-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type ctx pointer-ty))
              [(Ptr _) true]
              [(MutPtr _) true]
              [_ false])]
          [(Err _) false]))]
    [_ false]))

;; The address of a field place rooted at a raw-pointer `deref`
;; (`lower-raw-deref-place?`): the pointer plus each field's offset, typed as
;; the place.
(define (lower-raw-deref-place-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]) : ResultLowerExpr
  (match (lower-global-shared-view place)
    [(Spanned inner-box _)
      (lower-raw-deref-place-address
        ctx
        state
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [lowered : LowerExpr
          (try (lower-raw-deref-place-address ctx state env type-env receiver))]
        (match lowered
          [(Expr receiver-state base receiver-ty)
            (lower-struct-field-address-from-place
              ctx
              receiver-state
              base
              receiver-ty
              (tc_core.tc-env-key-name-text field)
              place)]))]
    [(BoxTake pointer-box)
      (let
        [pointer : ast.AstExpr (lower-context-expr-get ctx pointer-box)]
        [lowered : LowerExpr (try (lower-expr ctx state env type-env pointer))]
        (match lowered
          [(Expr pointer-state pointer-value pointer-ty)
            (match (tc_core.tc-raw-pointer-elem
              (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx pointer-ty))
              "lower: raw-pointer field place requires a raw pointer")
              [(Ok elem-ty)
                (Ok
                  (Expr
                    pointer-state
                    pointer-value
                    (tc_core.tc-resolve-type ctx elem-ty)))]
              [(Err message)
                (Err (box (lower-diagnostic-at-expr ctx place message)))])]))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            place
            "lower: expected a field place rooted at a raw-pointer deref")))]))

(define (lower-raw-deref-field-load
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [field : String]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [info : LowerFieldInfo
      (try
        (lower-struct-field-info
          ctx
          struct-id
          (tc_core.tc-nominal-name-id-display struct-id)
          field))]
    (match info
      [(Info offset field-ty)
        (lower-struct-field-load-at-offset
          ctx
          state
          base
          struct-id
          offset
          field-ty
          result-ty)])))

(define (lower-struct-get-through-reference
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [receiver-value : ir.CompilerIrValue]
  [referent-ty : ast.AstType]
  [struct-id : i64]
  [struct-name : String]
  [field : String]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (if (lower-type-register-resident?
    ctx
    (lower-global-shared-view referent-ty))
    (lower-load-register-resident-from-ptr ctx state receiver-value referent-ty)
    (Expr state receiver-value referent-ty))
    [(Expr value-state value _)
      (lower-struct-get-named
        ctx
        value-state
        value
        struct-id
        struct-name
        field
        result-ty)]))

(define (lower-struct-get
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [field : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [field-name : String (tc_core.tc-env-key-name-text field)]
    [lowered
      (try
        (lower-expr ctx state env type-env (lower-global-shared-view receiver)))]
    (match lowered
      [(Expr receiver-state receiver-value receiver-ty)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx receiver-ty))
          [(Struct struct-name)
            (lower-struct-get-named
              ctx
              receiver-state
              receiver-value
              struct-name
              (tc_core.tc-nominal-name-id-display struct-name)
              field-name
              result-ty)]
          [(StructArgs struct-name _)
            (lower-struct-get-named
              ctx
              receiver-state
              receiver-value
              struct-name
              (tc_core.tc-nominal-name-id-display struct-name)
              field-name
              result-ty)]
          [(Ref _ referent-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (tc_core.tc-context-type-get ctx referent-ty)))
              [(Struct struct-name)
                (lower-struct-get-through-reference
                  ctx
                  receiver-state
                  receiver-value
                  (tc_core.tc-context-type-get ctx referent-ty)
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field-name
                  result-ty)]
              [(StructArgs struct-name _)
                (lower-struct-get-through-reference
                  ctx
                  receiver-state
                  receiver-value
                  (tc_core.tc-context-type-get ctx referent-ty)
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field-name
                  result-ty)]
              [_
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      receiver
                      "lower: field projection requires struct")))])]
          [(MutRef _ referent-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (tc_core.tc-context-type-get ctx referent-ty)))
              [(Struct struct-name)
                (lower-struct-get-through-reference
                  ctx
                  receiver-state
                  receiver-value
                  (tc_core.tc-context-type-get ctx referent-ty)
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field-name
                  result-ty)]
              [(StructArgs struct-name _)
                (lower-struct-get-through-reference
                  ctx
                  receiver-state
                  receiver-value
                  (tc_core.tc-context-type-get ctx referent-ty)
                  struct-name
                  (tc_core.tc-nominal-name-id-display struct-name)
                  field-name
                  result-ty)]
              [_
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      receiver
                      "lower: field projection requires struct")))])]
          [_
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  receiver
                  "lower: field projection requires struct")))])])))

;; Lower `(box expr)`: evaluate `expr`, reserve arena storage sized for
;; its (pointer-shaped) value via `tl_alloc`, store the value at offset 0, and
;; return the box handle (the storage pointer) typed as the `(Box T)` result.
(define (lower-box
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-box-set-inner-type
    ctx
    (lower-global-shared-view result-ty))
    [(Ok expected-inner-ty)
      (let
        [lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view inner)
              (tc_core.tc-type-without-regions expected-inner-ty)
              inner))]
        (match lowered
          [(Expr inner-state inner-value inner-ty)
            (match (lower-reserve-heap-storage
              inner-state
              (lower-type-size ctx inner-ty)
              result-ty)
              [(Expr base-state base _)
                ;; A register-resident inner value is a word; store it
                ;; scalar into the box rather than byte-copying from a pointer.
                (if (and
                  (lower-type-inline-storage? ctx inner-ty)
                  (not
                    (lower-type-register-resident?
                      ctx
                      (lower-global-shared-view inner-ty))))
                  (match (lower-inline-aggregate-copy-size ctx inner-ty)
                    [(Ok size)
                      (Ok
                        (Expr
                          (lower-copy-bytes
                            base-state
                            (lower-global-shared-view base)
                            0
                            inner-value
                            0
                            size)
                          base
                          result-ty))]
                    [(Err message) (Err (box (lower-diagnostic message)))])
                  (if (lower-type-register-group?
                    ctx
                    (lower-global-shared-view inner-ty))
                    (Ok
                      (Expr
                        (lower-store-group-at-ptr
                          ctx
                          base-state
                          (lower-global-shared-view base)
                          inner-value
                          inner-ty)
                        base
                        result-ty))
                    (Ok
                      (Expr
                        (lower-store-at-offset
                          base-state
                          base
                          0
                          inner-value
                          inner-ty)
                        base
                        result-ty))))])]))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx inner message)))]))

(define (lower-deref-from-expected-receiver
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [receiver-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [lowered
      (try
        (lower-expr-expected
          ctx
          state
          env
          type-env
          (lower-global-shared-view receiver)
          receiver-ty
          receiver))]
    (match lowered
      [(Expr receiver-state receiver-value _)
        (Ok
          (lower-load-inline-value-at-offset
            ctx
            receiver-state
            receiver-value
            0
            result-ty))])))

;; Lower a Box/reference projection: both handles are pointers to the projected
;; value's storage, so the load shape is identical after receiver validation.
(define (lower-box-get
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [inner : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    inner)
    [(Ok receiver-ty)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (lower-global-shared-view receiver-ty)))
        [(Box _)
          (lower-deref-from-expected-receiver
            ctx
            state
            env
            type-env
            inner
            (ast.ast-ty-box (lower-global-shared-view result-ty))
            result-ty)]
        [(Ref _ _)
          (lower-deref-from-expected-receiver
            ctx
            state
            env
            type-env
            inner
            receiver-ty
            result-ty)]
        [(MutRef _ _)
          (lower-deref-from-expected-receiver
            ctx
            state
            env
            type-env
            inner
            receiver-ty
            result-ty)]
        [_
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                inner
                "lower: deref requires Box or reference type")))])]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx inner message)))]))

(define (lower-box-storage-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [box-expr : ast.AstExpr]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]
  [allow-shared : bool]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    box-expr)
    [(Ok box-ty)
      (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx box-ty))
        [(Box _)
          (let
            [lowered : LowerExpr
              (try (lower-expr ctx state env type-env box-expr))]
            (match lowered
              [(Expr box-state box-value _)
                (Ok (Expr box-state box-value result-ty))]))]
        [(MutRef _ _)
          (let
            [lowered : LowerExpr
              (try (lower-expr ctx state env type-env box-expr))]
            (match lowered
              [(Expr receiver-state receiver-value _)
                (Ok (Expr receiver-state receiver-value result-ty))]))]
        ;; The raw pointer is the address of its pointee.
        [(MutPtr _)
          (let
            [lowered : LowerExpr
              (try (lower-expr ctx state env type-env box-expr))]
            (match lowered
              [(Expr receiver-state receiver-value _)
                (Ok (Expr receiver-state receiver-value result-ty))]))]
        [(Ref _ _)
          (if allow-shared
            (let
              [lowered : LowerExpr
                (try (lower-expr ctx state env type-env box-expr))]
              (match lowered
                [(Expr receiver-state receiver-value _)
                  (Ok (Expr receiver-state receiver-value result-ty))]))
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  "lower: deref mutation requires mutable access"))))]
        [_
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                origin
                "lower: deref requires Box or reference type")))])]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx box-expr message)))]))

;; Locate the byte offset and resolved type of tuple element `target` within the
;; element-type list, laying fields out exactly like a struct over those types
;; (each field aligned to its own alignment), as the inline aggregate layout lays
;; out struct fields, but indexed by position rather than name.
(define (lower-tuple-elem-info
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]
  [target : i64]
  [index : i64]
  [cursor : i64]) : ResultLowerFieldInfo
  (if (>= index (ast.ast-type-list-len (& types)))
    (Err (box (lower-diagnostic "lower: tuple-ref index out of range")))
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get (& types) index (ast.ast-type-id-fallback)))]
      [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      (if (= index target)
        (Ok (Info offset resolved))
        (lower-tuple-elem-info
          ctx
          types
          target
          (+ index 1)
          (+ offset (lower-type-size ctx resolved)))))))

;; Evaluate each tuple element (preserving side effects even for zero-sized
;; elements) and store the sized ones into the aggregate at their field offset,
;; threading the lowering state. Mirrors the per-field store loop of `lower-box`
;; generalized over the element-type list.
(define (lower-tuple-store-elems
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [values : ast.AstExprList]
  [types : ast.AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-tuple-store-elems-at
    ctx
    state
    env
    type-env
    base
    (& values)
    (& types)
    0
    cursor))

(define (lower-tuple-store-elems-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [values : (& values ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [cursor : i64]) : ResultLowerState
  (if (>= index values.len)
    (Ok state)
    (if (>= index (ast.ast-type-list-len types))
      (Err (box (lower-diagnostic "lower: tuple arity mismatch")))
      (let
        [value : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get values index 0))]
        [ty : ast.AstType
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        [size : i64 (lower-type-size ctx resolved)]
        [lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view value)
              (lower-global-shared-view resolved)
              value))]
        (match lowered
          [(Expr elem-state elem-value _)
            (lower-tuple-store-elems-at
              ctx
              (if (> size 0)
                (lower-store-inline-value-at-offset
                  ctx
                  elem-state
                  base
                  offset
                  elem-value
                  resolved
                  size)
                elem-state)
              env
              type-env
              base
              values
              types
              (+ index 1)
              (+ offset size))])))))

;; Lower `(tuple v0 v1 ...)`: reserve struct-shaped aggregate storage for the
;; element types, store each element at its field offset, and return the storage
;; pointer typed as the tuple. Tuple expressions remain address-shaped even
;; though their inline byte layout is recursive (nested copies use the bytes).
;; Mirrors `src/lower.rs` `lower_tuple`.
(define (lower-tuple
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [values : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-resolve-type ctx (lower-global-shared-view result-ty))
    [(Tuple elem-tys)
      ;; A tuple literal is an ordinary inline value, like a fixed-array
      ;; literal: constructing or returning one never allocates (#7070).
      (match (lower-reserve-inline-storage
        state
        (lower-type-list-storage-size ctx (lower-box-shared-view elem-tys))
        result-ty)
        [(Expr base-state base _)
          (let
            [final-state
              (try
                (lower-tuple-store-elems
                  ctx
                  base-state
                  env
                  type-env
                  (lower-global-shared-view base)
                  values
                  (deref elem-tys)
                  0))]
            (Ok (Expr final-state base result-ty)))])]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: tuple requires tuple type")))]))

;; Evaluate each fixed-array-literal element (preserving side effects even for
;; zero-sized elements) and store the sized ones at `index * elem-size` into the
;; reserved inline storage, threading the lowering state. Mirrors
;; `lower-tuple-store-elems`, specialized to a single homogeneous element type.
(define (lower-array-literal-store-elems
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [values : ast.AstExprList]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [offset : i64]) : ResultLowerState
  (lower-array-literal-store-elems-at
    ctx
    state
    env
    type-env
    base
    (& values)
    0
    elem-ty
    elem-size
    offset))

(define (lower-array-literal-store-elems-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [values : (& values ast.AstExprList)]
  [value-index : i64]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [offset : i64]) : ResultLowerState
  (if (>= value-index values.len)
    (Ok state)
    (let
      [value : ast.AstExpr
        (lower-context-expr-get
          ctx
          (ast.ast-expr-list-get values value-index 0))]
      (if (> elem-size 0)
        (match (lower-direct-store-rhs-at-offset
          ctx
          state
          env
          type-env
          (lower-global-shared-view base)
          offset
          (lower-global-shared-view value)
          (lower-global-shared-view elem-ty)
          (lower-global-shared-view value))
          [(Store elem-state)
            (lower-array-literal-store-elems-at
              ctx
              elem-state
              env
              type-env
              base
              values
              (+ value-index 1)
              elem-ty
              elem-size
              (+ offset elem-size))]
          [(Err message) (Err message)]
          [(No)
            (let
              [lowered
                (try
                  (lower-expr-expected
                    ctx
                    state
                    env
                    type-env
                    (lower-global-shared-view value)
                    (lower-global-shared-view elem-ty)
                    value))]
              (match lowered
                [(Expr elem-state elem-value _)
                  (lower-array-literal-store-elems-at
                    ctx
                    (lower-store-inline-value-at-offset
                      ctx
                      elem-state
                      base
                      offset
                      elem-value
                      (lower-global-shared-view elem-ty)
                      elem-size)
                    env
                    type-env
                    base
                    values
                    (+ value-index 1)
                    elem-ty
                    elem-size
                    (+ offset elem-size))]))])
        (let
          [lowered
            (try
              (lower-expr-expected
                ctx
                state
                env
                type-env
                (lower-global-shared-view value)
                (lower-global-shared-view elem-ty)
                value))]
          (match lowered
            [(Expr elem-state _ _)
              (lower-array-literal-store-elems-at
                ctx
                elem-state
                env
                type-env
                base
                values
                (+ value-index 1)
                elem-ty
                elem-size
                (+ offset elem-size))]))))))

;; Lower `(array v0 v1 ...)`: reserve inline storage for `count` elements of the
;; element type, store each element at `index * elem-size`, and return the
;; storage pointer typed as the fixed array. A fixed-array value is pointer-
;; shaped (a pointer to inline storage), matching `array-ref`/`array-set!`, which
;; index off the same base. Mirrors `src/lower.rs` `lower_array_literal`.
(define (lower-array-literal
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [values : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-resolve-type ctx (lower-global-shared-view result-ty))
    [(Array elem-ty count)
      (let
        [resolved-elem : ast.AstType
          (tc_core.tc-resolve-type
            ctx
            (tc_core.tc-context-type-get ctx elem-ty))]
        [elem-size : i64
          (let
            [ty (tc_core.tc-context-type-get ctx elem-ty)]
            (lower-type-size ctx ty))]
        [storage-size : i64 (lower-type-size ctx result-ty)]
        (match (lower-reserve-inline-storage state storage-size result-ty)
          [(Expr base-state base _)
            (let
              [final-state
                (try
                  (lower-array-literal-store-elems
                    ctx
                    base-state
                    env
                    type-env
                    (lower-global-shared-view base)
                    values
                    resolved-elem
                    elem-size
                    0))]
              (Ok (Expr final-state base result-ty)))]))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: array literal requires fixed-array type")))]))

(define (lower-dyn-array-literal-store-elems-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [values : (& values ast.AstExprList)]
  [value-index : i64]
  [elem-ty : ast.AstType]
  [elem-size : i64]) : ResultLowerState
  (if (>= value-index values.len)
    (Ok state)
    (let
      [value : ast.AstExpr
        (lower-context-expr-get
          ctx
          (ast.ast-expr-list-get values value-index 0))]
      (if (> elem-size 0)
        (match (lower-emit-elem-addr-gep
          ctx
          state
          (lower-global-shared-view buf-value)
          (I64 value-index)
          (lower-global-shared-view elem-ty))
          [(Expr addr-state elem-ptr _)
            (match (lower-direct-store-rhs-into
              ctx
              addr-state
              env
              type-env
              (lower-global-shared-view elem-ptr)
              (lower-global-shared-view value)
              (lower-global-shared-view elem-ty)
              (lower-global-shared-view value))
              [(Store elem-state)
                (lower-dyn-array-literal-store-elems-at
                  ctx
                  elem-state
                  env
                  type-env
                  buf-value
                  values
                  (+ value-index 1)
                  elem-ty
                  elem-size)]
              [(Err message) (Err message)]
              [(No)
                (let
                  [lowered
                    (try
                      (lower-expr-expected
                        ctx
                        addr-state
                        env
                        type-env
                        (lower-global-shared-view value)
                        (lower-global-shared-view elem-ty)
                        value))]
                  (match lowered
                    [(Expr elem-state elem-value _)
                      (lower-dyn-array-literal-store-elems-at
                        ctx
                        (lower-array-elem-store-state
                          ctx
                          elem-state
                          elem-ptr
                          elem-value
                          (lower-global-shared-view elem-ty))
                        env
                        type-env
                        buf-value
                        values
                        (+ value-index 1)
                        elem-ty
                        elem-size)]))])])
        (let
          [lowered
            (try
              (lower-expr-expected
                ctx
                state
                env
                type-env
                (lower-global-shared-view value)
                (lower-global-shared-view elem-ty)
                value))]
          (match lowered
            [(Expr elem-state _ _)
              (lower-dyn-array-literal-store-elems-at
                ctx
                elem-state
                env
                type-env
                buf-value
                values
                (+ value-index 1)
                elem-ty
                elem-size)]))))))

(define (lower-dyn-array-literal-store-elems
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [values : ast.AstExprList]
  [elem-ty : ast.AstType]
  [elem-size : i64]) : ResultLowerState
  (lower-dyn-array-literal-store-elems-at
    ctx
    state
    env
    type-env
    buf-value
    (& values)
    0
    elem-ty
    elem-size))

(define (lower-dyn-array-literal
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [values : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx result-ty))
    [(DynArray elem-ty)
      (let
        [resolved-elem : ast.AstType
          (tc_core.tc-resolve-type
            ctx
            (tc_core.tc-context-type-get ctx elem-ty))]
        [elem-size : i64 (lower-type-size ctx resolved-elem)]
        [count : i64
          (tc_core.tc-expr-list-len (lower-global-shared-view values))]
        [byte-count : ir.CompilerIrValue (I64 (* count elem-size))]
        [arr-ty : ast.AstType
          (ast.ast-ty-dyn-array (lower-global-shared-view resolved-elem))]
        (match (lower-state-alloc-var state)
          [(Alloc buf-alloc buf-var)
            (let
              [alloc-state : LowerState
                (lower-state-emit
                  buf-alloc
                  (Call buf-var (lower-tl-alloc-symbol) (One byte-count) (U64)))]
              [final-state : LowerState
                (try
                  (lower-dyn-array-literal-store-elems
                    ctx
                    alloc-state
                    env
                    type-env
                    (Var buf-var)
                    values
                    resolved-elem
                    elem-size))]
              (lower-make-array-store-fat
                final-state
                arr-ty
                buf-var
                (I64 count)))]))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: dynamic array literal requires dynamic-array type")))]))

;; Lower `(tuple-ref t i)`: evaluate the tuple, compute element `i`'s offset, and
;; load it (returning the unit value for a zero-sized element, which was never
;; stored). Mirrors `src/lower.rs` `lower_tuple_ref`.
(define (lower-tuple-ref
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [tuple-expr : ast.AstExpr]
  [index : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [lowered
      (try
        (lower-expr
          ctx
          state
          env
          type-env
          (lower-global-shared-view tuple-expr)))]
    (match lowered
      [(Expr tuple-state tuple-value tuple-ty)
        (match (tc_core.tc-resolve-type ctx tuple-ty)
          [(Tuple elem-tys)
            (let
              [info : LowerFieldInfo
                (try (lower-tuple-elem-info ctx (deref elem-tys) index 0 0))]
              (match info
                [(Info offset elem-ty)
                  (if (> (lower-type-size ctx elem-ty) 0)
                    (match (lower-load-inline-value-at-offset
                      ctx
                      tuple-state
                      tuple-value
                      offset
                      elem-ty)
                      [(Expr load-state load-value _)
                        (Ok (Expr load-state load-value result-ty))])
                    (Ok (Expr tuple-state Unit result-ty)))]))]
          [_
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  tuple-expr
                  "lower: tuple-ref requires tuple")))])])))

(define (lower-string-ref-byte
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc gep-alloc gep-var)
      (let
        [gep-state : LowerState
          (lower-state-emit gep-alloc (Gep gep-var data-ptr index-value (Char)))]
        (match (lower-state-alloc-var gep-state)
          [(Alloc load-alloc load-var)
            (Ok
              (Expr
                (lower-state-emit
                  load-alloc
                  (Load load-var (Var gep-var) (Char)))
                (Var load-var)
                (Char)))]))]))

(define (lower-string-ref-load
  [state : LowerState]
  [str-value : ir.CompilerIrValue]
  [index-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state str-value)
    [(Fields fields-state data-ptr str-len)
      (match (lower-cast-value
        fields-state
        (lower-global-shared-view index-value)
        (I64)
        (U64))
        [(Expr index-u-state index-u _)
          (match (lower-cast-value index-u-state str-len (I64) (U64))
            [(Expr len-u-state len-u _)
              (match (lower-state-fresh-label len-u-state "str_bounds_ok")
                [(Label bounds-ok-state bounds-ok-label)
                  (lower-string-ref-byte
                    (lower-state-emit
                      bounds-ok-state
                      (BoundsCheck index-u len-u bounds-ok-label))
                    data-ptr
                    index-value)])])])]))

(define (lower-string-ref
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [str : ast.AstExpr]
  [index : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [lowered-str
      (try (lower-expr ctx state env type-env (lower-global-shared-view str)))]
    (match lowered-str
      [(Expr str-state str-value str-ty)
        (if (lower-string-handle-type? ctx str-ty)
          (let
            [lowered-index : LowerExpr
              (try
                (lower-integer-expr-with-expected-or-actual
                  ctx
                  str-state
                  env
                  type-env
                  index
                  (I64)
                  "lower: string index must be integer"))]
            (match lowered-index
              [(Expr index-state index-raw index-ty)
                (match (lower-cast-value index-state index-raw index-ty (I64))
                  [(Expr index-i-state index-value _)
                    (let
                      [loaded : LowerExpr
                        (try
                          (lower-string-ref-load
                            index-i-state
                            str-value
                            index-value))]
                      (match loaded
                        [(Expr loaded-state value ty)
                          (Ok
                            (Expr
                              (lower-state-record-latest-bounds-check-named-at-expr
                                ctx
                                loaded-state
                                "str_bounds_ok"
                                origin)
                              value
                              ty))]))])]))
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                str
                "lower: string-ref requires String"))))])))

(define (lower-slice-view-static-source-fields
  [state : LowerState]
  [source-value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [elem-ty : ast.AstType]
  [count : i64]) : ResultLowerSliceViewSourceFields
  ;; Fixed arrays and references to fixed arrays are represented as a raw
  ;; pointer to their inline storage.  Cast that pointer to the ABI's U64 word
  ;; and carry the compile-time element count as an I64 value.
  (match (lower-cast-value state source-value source-ty (U64))
    [(Expr ptr-state ptr _) (Ok (Fields ptr-state ptr (I64 count) elem-ty))]))

(define (lower-slice-view-dynamic-source-fields
  [state : LowerState]
  [source-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : ResultLowerSliceViewSourceFields
  ;; Dynamic arrays (and references to them) point at a two-word descriptor:
  ;; data pointer at byte offset 0, signed length at byte offset 8.
  (match (lower-load-at-offset state source-value 0 (U64))
    [(Expr ptr-state ptr _)
      (match (lower-load-at-offset ptr-state source-value 8 (I64))
        [(Expr len-state len _) (Ok (Fields len-state ptr len elem-ty))])]))

(define (lower-slice-view-reference-slice-fields
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [source-value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [elem-ty : ast.AstType]) : ResultLowerSliceViewSourceFields
  ;; A borrowed Slice is already a two-word register group.  Extracting both
  ;; words preserves the source value without touching a descriptor.
  (match (lower-emit-word
    state
    (lower-global-shared-view source-value)
    0
    (lower-register-word-type ctx source-ty 0))
    [(Expr ptr-state ptr _)
      (match (lower-emit-word
        ptr-state
        source-value
        1
        (lower-register-word-type ctx source-ty 1))
        [(Expr len-state len _) (Ok (Fields len-state ptr len elem-ty))])]))

(define (lower-slice-view-invalid-source
  [ctx : tc_core.TcContext]
  [source : ast.AstExpr]) : ResultLowerSliceViewSourceFields
  (Err
    (box
      (lower-diagnostic-at-expr
        ctx
        source
        "lower: slice-view source must be a fixed array, dynamic array, or borrowed reference to one"))))

(define (lower-slice-view-referent-fields
  [ctx : tc_core.TcContext]
  [source-state : LowerState]
  [source-value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [referent : ast.AstType]
  [source : ast.AstExpr]) : ResultLowerSliceViewSourceFields
  (match referent
    [(Array elem count)
      (lower-slice-view-static-source-fields
        source-state
        source-value
        source-ty
        (tc_core.tc-context-type-get ctx elem)
        count)]
    [(DynArray elem)
      (lower-slice-view-dynamic-source-fields
        source-state
        source-value
        (tc_core.tc-context-type-get ctx elem))]
    [(Slice elem)
      (lower-slice-view-reference-slice-fields
        ctx
        source-state
        source-value
        source-ty
        (tc_core.tc-context-type-get ctx elem))]
    ;; A `str` reference points at its `{data_ptr, length}` record, laid out
    ;; like a dynamic-array descriptor; `bytes` is a two-word view like Slice.
    [(Str)
      (lower-slice-view-dynamic-source-fields source-state source-value (U8))]
    [(Bytes)
      (lower-slice-view-reference-slice-fields
        ctx
        source-state
        source-value
        source-ty
        (U8))]
    [_ (lower-slice-view-invalid-source ctx source)]))

(define (lower-slice-view-source-fields
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source : ast.AstExpr]) : ResultLowerSliceViewSourceFields
  (let
    [lowered
      (try
        (lower-expr ctx state env type-env (lower-global-shared-view source)))]
    (match lowered
      [(Expr source-state source-value source-ty)
        (let
          [resolved : ast.AstType
            (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type ctx (lower-global-shared-view source-ty)))]
          (match resolved
            [(Array elem count)
              (lower-slice-view-static-source-fields
                source-state
                source-value
                source-ty
                (tc_core.tc-context-type-get ctx elem)
                count)]
            [(DynArray elem)
              (lower-slice-view-dynamic-source-fields
                source-state
                source-value
                (tc_core.tc-context-type-get ctx elem))]
            [(Ref _ inner)
              (lower-slice-view-referent-fields
                ctx
                source-state
                source-value
                source-ty
                (tc_core.tc-type-strip-region
                  (tc_core.tc-resolve-type
                    ctx
                    (tc_core.tc-context-type-get ctx inner)))
                source)]
            [(MutRef _ inner)
              (lower-slice-view-referent-fields
                ctx
                source-state
                source-value
                source-ty
                (tc_core.tc-type-strip-region
                  (tc_core.tc-resolve-type
                    ctx
                    (tc_core.tc-context-type-get ctx inner)))
                source)]
            [_ (lower-slice-view-invalid-source ctx source)]))])))

(define (lower-slice-view-pack
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (lower-emit-pack state (ir.compiler-ir-value-seq2 ptr len-value) result-ty))

(define (lower-slice-view-finish-after-len-check
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [len-ok-var : i64]
  [fail-label : i64]
  [copy-label : i64]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [fail-start : LowerState
      (lower-state-finish-block
        (lower-state-emit state (Branch (Var len-ok-var) copy-label fail-label))
        fail-label)]
    [copy-start : LowerState
      (lower-state-finish-block
        (lower-state-emit (lower-oob-abort fail-start) (Jump copy-label))
        copy-label)]
    [checked-start : LowerState
      (lower-state-record-latest-bounds-check-named-at-expr
        ctx
        copy-start
        "slice_view_ok"
        origin)]
    (if (= (lower-type-size ctx elem-ty) 0)
      (Ok (lower-slice-view-pack checked-start src-ptr len-value result-ty))
      (match (lower-emit-elem-addr-gep
        ctx
        checked-start
        src-ptr
        start-value
        elem-ty)
        [(Expr ptr-state ptr _)
          (Ok (lower-slice-view-pack ptr-state ptr len-value result-ty))]))))

(define (lower-slice-view-check-len
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [fail-label : i64]
  [copy-label : i64]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  ;; Once start <= source length holds, subtract in signed space and compare
  ;; the requested length as unsigned.  This avoids overflow from `start+len`
  ;; while still rejecting negative inputs through the unsigned comparisons.
  (match (lower-emit-binop
    state
    Sub
    src-len
    (lower-global-shared-view start-value)
    (I64))
    [(Expr rem-state remaining _)
      (match (lower-cast-value rem-state remaining (I64) (U64))
        [(Expr rem-u-state remaining-u _)
          (match (lower-cast-value
            rem-u-state
            (lower-global-shared-view len-value)
            (I64)
            (U64))
            [(Expr len-u-state len-u _)
              (match (lower-state-alloc-var len-u-state)
                [(Alloc len-ok-alloc len-ok-var)
                  (lower-slice-view-finish-after-len-check
                    ctx
                    (lower-state-emit
                      len-ok-alloc
                      (BinOp len-ok-var Le len-u remaining-u (U64)))
                    src-ptr
                    start-value
                    len-value
                    len-ok-var
                    fail-label
                    copy-label
                    elem-ty
                    result-ty
                    origin)])])])]))

;; The first half of a view's range check: branch to PREFIX_bounds_fail unless
;; start <= source length, as unsigned. Checked carries the state in the
;; PREFIX_start_ok block, the fail label and the PREFIX_ok label the length
;; check continues with.
(defenum LowerRangeStart
  (Checked LowerState i64 i64))

(define (lower-range-start-checked
  [state : LowerState]
  [src-len : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [prefix : String]) : LowerRangeStart
  (match (lower-cast-value state start-value (I64) (U64))
    [(Expr start-u-state start-u _)
      (match (lower-cast-value start-u-state src-len (I64) (U64))
        [(Expr src-len-u-state src-len-u _)
          (match (lower-state-alloc-var src-len-u-state)
            [(Alloc start-ok-alloc start-ok-var)
              (let
                [start-ok-state : LowerState
                  (lower-state-emit
                    start-ok-alloc
                    (BinOp start-ok-var Le start-u src-len-u (U64)))]
                (match (lower-state-fresh-label
                  start-ok-state
                  (str_cat.str-cat
                    (lower-global-shared-view prefix)
                    "_start_ok"))
                  [(Label rem-label-state rem-label)
                    (match (lower-state-fresh-label
                      rem-label-state
                      (str_cat.str-cat
                        (lower-global-shared-view prefix)
                        "_bounds_fail"))
                      [(Label fail-label-state fail-label)
                        (match (lower-state-fresh-label
                          fail-label-state
                          (str_cat.str-cat prefix "_ok"))
                          [(Label copy-label-state copy-label)
                            (Checked
                              (lower-state-finish-block
                                (lower-state-emit
                                  copy-label-state
                                  (Branch
                                    (Var start-ok-var)
                                    rem-label
                                    fail-label))
                                rem-label)
                              fail-label
                              copy-label)])])]))])])]))

(define (lower-slice-view-bounds-checked
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-range-start-checked
    state
    (lower-global-shared-view src-len)
    (lower-global-shared-view start-value)
    "slice_view")
    [(Checked rem-start fail-label copy-label)
      (lower-slice-view-check-len
        ctx
        rem-start
        src-ptr
        src-len
        start-value
        len-value
        fail-label
        copy-label
        elem-ty
        result-ty
        origin)]))

(define (lower-slice-view-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 3)
    (let
      [source : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [start : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [len : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 2 0))]
      [fields
        (try (lower-slice-view-source-fields ctx state env type-env source))]
      (match fields
        [(Fields source-state src-ptr src-len elem-ty)
          (let
            [lowered-start
              (try
                (lower-integer-expr-with-expected-or-actual
                  ctx
                  source-state
                  env
                  type-env
                  start
                  (I64)
                  "lower: slice-view start must be integer"))]
            (match lowered-start
              [(Expr start-state start-raw start-ty)
                (match (lower-cast-value start-state start-raw start-ty (I64))
                  [(Expr start-i-state start-value _)
                    (let
                      [lowered-len
                        (try
                          (lower-integer-expr-with-expected-or-actual
                            ctx
                            start-i-state
                            env
                            type-env
                            len
                            (I64)
                            "lower: slice-view length must be integer"))]
                      (match lowered-len
                        [(Expr len-state len-raw len-ty)
                          (match (lower-cast-value
                            len-state
                            len-raw
                            len-ty
                            (I64))
                            [(Expr len-i-state len-value _)
                              (lower-slice-view-bounds-checked
                                ctx
                                len-i-state
                                src-ptr
                                src-len
                                start-value
                                len-value
                                elem-ty
                                result-ty
                                origin)])]))])]))]))
    (Err
      (box
        (lower-diagnostic-at-expr
          ctx
          origin
          "lower: slice-view expects exactly three arguments")))))

(define (lower-slice-split-half-type
  [ctx : tc_core.TcContext]
  [result-ty : ast.AstType]) : tc_core.ResultTcType
  (match (tc_core.tc-resolve-type ctx result-ty)
    [(Tuple elems-box)
      (let
        [elems : ast.AstTypeList (deref elems-box)]
        (if (= (ast.ast-type-list-len (& elems)) 2)
          (Ok
            (tc_core.tc-context-type-get
              ctx
              (ast.ast-type-list-get (& elems) 0 (ast.ast-type-id-fallback))))
          (Err "lower: slice-split-at result must contain two Slice references")))]
    [_ (Err "lower: slice-split-at result must be a two-element tuple")]))

(define (lower-slice-split-pack-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [right-ptr : ir.CompilerIrValue]
  [mid : ir.CompilerIrValue]
  [remaining : ir.CompilerIrValue]
  [half-ty : ast.AstType]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-slice-view-pack
    state
    src-ptr
    mid
    (lower-global-shared-view half-ty))
    [(Expr left-state left-value _)
      (match (lower-slice-view-pack
        left-state
        right-ptr
        remaining
        (lower-global-shared-view half-ty))
        [(Expr right-state right-value _)
          (match (lower-reserve-inline-storage
            right-state
            (lower-type-size ctx result-ty)
            result-ty)
            [(Expr tuple-state tuple-ptr _)
              (let
                [half-size : i64 (lower-type-size ctx half-ty)]
                [with-left : LowerState
                  (lower-store-inline-value-at-offset
                    ctx
                    tuple-state
                    tuple-ptr
                    0
                    left-value
                    (lower-global-shared-view half-ty)
                    half-size)]
                [with-right : LowerState
                  (lower-store-inline-value-at-offset
                    ctx
                    with-left
                    tuple-ptr
                    half-size
                    right-value
                    half-ty
                    half-size)]
                (Ok (Expr with-right tuple-ptr result-ty)))])])]))

(define (lower-slice-split-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [mid : ir.CompilerIrValue]
  [mid-ok-var : i64]
  [fail-label : i64]
  [ok-label : i64]
  [elem-ty : ast.AstType]
  [half-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [fail-start : LowerState
      (lower-state-finish-block
        (lower-state-emit state (Branch (Var mid-ok-var) ok-label fail-label))
        fail-label)]
    [ok-start : LowerState
      (lower-state-record-latest-bounds-check-named-at-expr
        ctx
        (lower-state-finish-block
          (lower-state-emit (lower-oob-abort fail-start) (Jump ok-label))
          ok-label)
        "slice_split_at_ok"
        origin)]
    (match (lower-emit-binop
      ok-start
      Sub
      src-len
      (lower-global-shared-view mid)
      (I64))
      [(Expr remaining-state remaining _)
        (if (= (lower-type-size ctx elem-ty) 0)
          (lower-slice-split-pack-result
            ctx
            remaining-state
            (lower-global-shared-view src-ptr)
            src-ptr
            mid
            remaining
            half-ty
            result-ty)
          (match (lower-emit-elem-addr-gep
            ctx
            remaining-state
            (lower-global-shared-view src-ptr)
            (lower-global-shared-view mid)
            elem-ty)
            [(Expr ptr-state right-ptr _)
              (lower-slice-split-pack-result
                ctx
                ptr-state
                src-ptr
                right-ptr
                mid
                remaining
                half-ty
                result-ty)]))])))

(define (lower-slice-split-bounds-checked
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [mid : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [half-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  ;; One unsigned comparison simultaneously rejects negative mids and values
  ;; above the non-negative Slice length. Pointer arithmetic happens only in
  ;; the success block.
  (match (lower-cast-value state (lower-global-shared-view mid) (I64) (U64))
    [(Expr mid-u-state mid-u _)
      (match (lower-cast-value
        mid-u-state
        (lower-global-shared-view src-len)
        (I64)
        (U64))
        [(Expr len-u-state len-u _)
          (match (lower-state-alloc-var len-u-state)
            [(Alloc cmp-state mid-ok-var)
              (match (lower-state-fresh-label cmp-state "slice_split_at_fail")
                [(Label fail-state fail-label)
                  (match (lower-state-fresh-label
                    fail-state
                    "slice_split_at_ok")
                    [(Label labels-state ok-label)
                      (lower-slice-split-finish
                        ctx
                        (lower-state-emit
                          labels-state
                          (BinOp mid-ok-var Le mid-u len-u (U64)))
                        src-ptr
                        src-len
                        mid
                        mid-ok-var
                        fail-label
                        ok-label
                        elem-ty
                        half-ty
                        result-ty
                        origin)])])])])]))

(define (lower-slice-split-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 2)
    (let
      [source : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [mid-expr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [fields
        (try (lower-slice-view-source-fields ctx state env type-env source))]
      (match fields
        [(Fields source-state src-ptr src-len elem-ty)
          (let
            [lowered-mid
              (try
                (lower-integer-expr-with-expected-or-actual
                  ctx
                  source-state
                  env
                  type-env
                  mid-expr
                  (I64)
                  "lower: slice-split-at midpoint must be integer"))]
            (match lowered-mid
              [(Expr mid-state mid-raw mid-ty)
                (match (lower-cast-value mid-state mid-raw mid-ty (I64))
                  [(Expr mid-i-state mid _)
                    (match (lower-slice-split-half-type
                      ctx
                      (lower-global-shared-view result-ty))
                      [(Ok half-ty)
                        (lower-slice-split-bounds-checked
                          ctx
                          mid-i-state
                          src-ptr
                          src-len
                          mid
                          elem-ty
                          half-ty
                          result-ty
                          origin)]
                      [(Err message)
                        (Err
                          (box (lower-diagnostic-at-expr ctx origin message)))])])]))]))
    (Err
      (box
        (lower-diagnostic-at-expr
          ctx
          origin
          "lower: slice-split-at expects exactly two arguments")))))

(define (lower-substring-call-runtime
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Ok
        (Expr
          (lower-state-emit
            allocated
            (Call
              var-id
              (lower-tl-substring-symbol)
              (ir.compiler-ir-call-args-from-seq
                (ir.compiler-ir-value-seq3 src-ptr start-value len-value))
              (String)))
          (Var var-id)
          (String)))]))

(define (lower-substring-finish-after-len-check
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [len-ok-var : i64]
  [fail-label : i64]
  [copy-label : i64]) : ResultLowerExpr
  (let
    [fail-start : LowerState
      (lower-state-finish-block
        (lower-state-emit state (Branch (Var len-ok-var) copy-label fail-label))
        fail-label)]
    [copy-start : LowerState
      (lower-state-finish-block
        (lower-state-emit (lower-oob-abort fail-start) (Jump copy-label))
        copy-label)]
    (lower-substring-call-runtime copy-start src-ptr start-value len-value)))

(define (lower-substring-check-len
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [fail-label : i64]
  [copy-label : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc rem-alloc rem-var)
      (let
        [rem-state : LowerState
          (lower-state-emit
            rem-alloc
            (BinOp
              rem-var
              Sub
              src-len
              (lower-global-shared-view start-value)
              (I64)))]
        (match (lower-cast-value rem-state (Var rem-var) (I64) (U64))
          [(Expr rem-u-state rem-u _)
            (match (lower-cast-value
              rem-u-state
              (lower-global-shared-view len-value)
              (I64)
              (U64))
              [(Expr len-u-state len-u _)
                (match (lower-state-alloc-var len-u-state)
                  [(Alloc len-ok-alloc len-ok-var)
                    (let
                      [len-ok-state : LowerState
                        (lower-state-emit
                          len-ok-alloc
                          (BinOp len-ok-var Le len-u rem-u (U64)))]
                      (lower-substring-finish-after-len-check
                        len-ok-state
                        src-ptr
                        start-value
                        len-value
                        len-ok-var
                        fail-label
                        copy-label))])])]))]))

(define (lower-substring-bounds-checked
  [state : LowerState]
  [src-ptr : ir.CompilerIrValue]
  [src-len : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-range-start-checked
    state
    (lower-global-shared-view src-len)
    (lower-global-shared-view start-value)
    "substr")
    [(Checked rem-start fail-label copy-label)
      (lower-substring-check-len
        rem-start
        src-ptr
        src-len
        start-value
        len-value
        fail-label
        copy-label)]))

(define (lower-substring
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [str : ast.AstExpr]
  [start : ast.AstExpr]
  [len : ast.AstExpr]) : ResultLowerExpr
  (let
    [lowered-str
      (try (lower-expr ctx state env type-env (lower-global-shared-view str)))]
    (match lowered-str
      [(Expr str-state str-value str-ty)
        (if (lower-string-handle-type? ctx str-ty)
          (match (lower-string-fields str-state str-value)
            [(Fields fields-state src-ptr src-len)
              (let
                [lowered-start : LowerExpr
                  (try
                    (lower-integer-expr-with-expected-or-actual
                      ctx
                      fields-state
                      env
                      type-env
                      start
                      (I64)
                      "lower: substring start must be integer"))]
                (match lowered-start
                  [(Expr start-state start-raw start-ty)
                    (match (lower-cast-value
                      start-state
                      start-raw
                      start-ty
                      (I64))
                      [(Expr start-i-state start-value _)
                        (let
                          [lowered-len : LowerExpr
                            (try
                              (lower-integer-expr-with-expected-or-actual
                                ctx
                                start-i-state
                                env
                                type-env
                                len
                                (I64)
                                "lower: substring length must be integer"))]
                          (match lowered-len
                            [(Expr len-state len-raw len-ty)
                              (match (lower-cast-value
                                len-state
                                len-raw
                                len-ty
                                (I64))
                                [(Expr len-i-state len-value _)
                                  (lower-substring-bounds-checked
                                    len-i-state
                                    src-ptr
                                    src-len
                                    start-value
                                    len-value)])]))])]))])
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                str
                "lower: substring requires String"))))])))

(define (lower-string-concat
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [exprs : ast.AstExprList
      (lower-string-concat-exprs-all ctx env state type-env args)]
    ;; A single public stdlib wrapper call already has compact, stable codegen.
    ;; Keep it on the ordinary direct-call path; only a nested public tree needs
    ;; the fused runtime batches. Legacy intrinsics have always used the runtime
    ;; path, including their two-leaf form.
    (if (and (lower-string-concat-public-target? name) (= exprs.len 2))
      (lower-direct-call-id
        ctx
        state
        env
        type-env
        source-id
        name
        args
        result-ty
        origin)
      (lower-string-concat-exprs ctx state env type-env exprs))))

(define (lower-c-abi-runtime-handle-extern? [name : String]) : bool
  (or
    (lower-string-prefix-at? (lower-global-shared-view name) "tl_" 0)
    (lower-string-prefix-at? name ".L_tl_" 0)))

(define (lower-c-abi-extern-call?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [name : String]) : bool
  (cond
    [(not (lower-mode-c-abi? (lower-state-mode state))) false]
    [(sym_i64_env.sym-i64-contains-id env name-id) false]
    [(lower-c-abi-runtime-handle-extern? name) false]
    [else
      (let
        [handle : i64
          (csym.compiler-symbols-lookup-value-id-or
            (tc_core.tc-context-symbols ctx)
            name-id
            (csym.compiler-symbols-missing-handle))]
        (and
          (csym.compiler-symbols-handle-found? handle)
          (=
            (csym.compiler-symbol-handle-kind handle)
            (csym.compiler-symbol-kind-extern))
          (lower-symbol-function-value-id? ctx name-id)))]))

(define (lower-c-abi-extern-value-call?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [name : String]) : bool
  (cond
    [(not (lower-mode-c-abi? (lower-state-mode state))) false]
    [(sym_i64_env.sym-i64-contains-id env name-id) false]
    [(lower-c-abi-runtime-handle-extern? name) false]
    [else (lower-extern-value-decl-id? ctx name-id)]))

(define (lower-c-abi-integer-field-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(I64) true]
    [(U64) true]
    [(I32) true]
    [(U32) true]
    [(I16) true]
    [(U16) true]
    [(I8) true]
    [(U8) true]
    [(Bool) true]
    [(Char) true]
    [(CFunc _ _) true]
    [(Ptr _) true]
    [(MutPtr _) true]
    [_ false]))

(define (lower-c-abi-inline-fields-integer-only?
  [ctx : tc_core.TcContext]
  [fields : (& fields tc_core.TcInlineFieldLayoutList)]) : bool
  (lower-c-abi-inline-fields-integer-only-at? ctx fields 0))

(define (lower-c-abi-inline-fields-integer-only-at?
  [ctx : tc_core.TcContext]
  [fields : (& fields tc_core.TcInlineFieldLayoutList)]
  [index : i64]) : bool
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    true
    (and
      (lower-c-abi-integer-field-type?
        ctx
        (tc_core.tc-inline-field-layout-type
          (tc_core.tc-inline-field-layout-list-ref fields index)))
      (lower-c-abi-inline-fields-integer-only-at? ctx fields (+ index 1)))))

(define (lower-c-abi-win64-register-struct-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
    [(Ok layout)
      (match layout
        [(Struct _ _ fields)
          (lower-c-abi-inline-fields-win64-register? ctx fields)]
        [(Enum _ _ _) false])]
    [(Err _) false]))

(define (lower-c-abi-win64-register-field-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view ty)))
    [(Struct name) (lower-c-abi-win64-register-struct-id? ctx name)]
    [(StructArgs name _) (lower-c-abi-win64-register-struct-id? ctx name)]
    [(F32) true]
    [(F64) true]
    [_ (lower-c-abi-integer-field-type? ctx ty)]))

(define (lower-c-abi-inline-fields-win64-register?
  [ctx : tc_core.TcContext]
  [fields : (& fields tc_core.TcInlineFieldLayoutList)]) : bool
  (lower-c-abi-inline-fields-win64-register-at? ctx fields 0))

(define (lower-c-abi-inline-fields-win64-register-at?
  [ctx : tc_core.TcContext]
  [fields : (& fields tc_core.TcInlineFieldLayoutList)]
  [index : i64]) : bool
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    true
    (and
      (lower-c-abi-win64-register-field-type?
        ctx
        (tc_core.tc-inline-field-layout-type
          (tc_core.tc-inline-field-layout-list-ref fields index)))
      (lower-c-abi-inline-fields-win64-register-at? ctx fields (+ index 1)))))

(define (lower-c-abi-register-aggregate-fields-ok?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [fields : (& fields tc_core.TcInlineFieldLayoutList)]) : bool
  (if (lower-mode-windows-c-abi? mode)
    (lower-c-abi-inline-fields-win64-register? ctx fields)
    (lower-c-abi-inline-fields-integer-only? ctx fields)))

(define (lower-c-abi-integer-scalar-type [size : i64]) : ast.AstType
  (cond [(<= size 1) (U8)] [(<= size 2) (U16)] [(<= size 4) (U32)] [else (U64)]))

(define (lower-c-abi-target-name [mode : CompilerLowerMode]) : String
  (if (lower-mode-windows-c-abi? mode)
    "windows-x86_64"
    "linux-x86_64"))

(define (lower-c-abi-register-aggregate-size?
  [mode : CompilerLowerMode]
  [size : i64]) : bool
  (if (lower-mode-windows-c-abi? mode)
    (or (= size 1) (= size 2) (= size 4) (= size 8))
    (and (> size 0) (<= size 8))))

(define (lower-c-abi-aggregate-size-message [mode : CompilerLowerMode]) : String
  (if (lower-mode-windows-c-abi? mode)
    "scalar structs of size 1, 2, 4, or 8 bytes, including nested scalar struct fields"
    "System V aggregate structs/enums, including register-class and MEMORY-class layouts"))

(define (lower-c-abi-unsupported-message
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    "lower: unsupported "
    (lower-c-abi-target-name mode)
    " C aggregate ABI for "
    (tc_core.tc-type-render ty)
    "; this slice supports "
    (lower-c-abi-aggregate-size-message mode)))

(define (lower-internal-abi-unsupported-message
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    "lower: unsupported "
    (lower-c-abi-target-name mode)
    " internal aggregate ABI for "
    (tc_core.tc-type-render ty)
    "; tuple/fixed-array parameters and returns require a non-zero finite inline layout"))

(define (lower-c-abi-two-register-return-message [ty : ast.AstType]) : String
  (str_cat.str-cat
    "lower: unsupported linux-x86_64 C two-register aggregate return ABI for "
    (tc_core.tc-type-render ty)))

(define (lower-c-abi-sysv-slot-size [size : i64] [slot-index : i64]) : i64
  (if (= slot-index 0)
    (if (> size 8)
      8
      size)
    (- size 8)))

(define (lower-c-abi-sysv-merge-integer [current : LowerCAbiEightbyteClass]) : LowerCAbiEightbyteClass
  (match current
    [(Unsupported) (Unsupported)]
    [_ (Integer)]))

(define (lower-c-abi-sysv-slot-base [offset : i64]) : i64
  (* (/ offset 8) 8))

(define (lower-c-abi-sysv-pack-f32-sse?
  [current-ty : ast.AstType]
  [current-offset : i64]
  [next-ty : ast.AstType]
  [next-offset : i64]) : bool
  (match current-ty
    [(F32)
      (match next-ty
        [(F32)
          (let
            [base : i64 (lower-c-abi-sysv-slot-base current-offset)]
            (and
              (= (lower-c-abi-sysv-slot-base next-offset) base)
              (= current-offset base)
              (= next-offset (+ base 4))))]
        [_ false])]
    [_ false]))

(define (lower-c-abi-sysv-merge-sse
  [current : LowerCAbiEightbyteClass]
  [ty : ast.AstType]
  [offset : i64]) : LowerCAbiEightbyteClass
  (match current
    [(Empty) (Sse ty offset)]
    [(Integer) (Integer)]
    [(Sse current-ty current-offset)
      (if (lower-c-abi-sysv-pack-f32-sse? current-ty current-offset ty offset)
        ;; A `{ f32, f32 }` eightbyte is still an SSE-class argument. Carry it
        ;; as an opaque 8-byte XMM payload, not as an INTEGER slot.
        (Sse (F64) (lower-c-abi-sysv-slot-base offset))
        (Unsupported))]
    [(Unsupported) (Unsupported)]))

(define (lower-c-abi-sysv-mark-integer-slot
  [slots : LowerCAbiSysvSlots]
  [slot-index : i64]) : LowerCAbiSysvSlots
  (match slots
    [(Slots first second)
      (if (= slot-index 0)
        (Slots (lower-c-abi-sysv-merge-integer first) second)
        (if (= slot-index 1)
          (Slots first (lower-c-abi-sysv-merge-integer second))
          (Unsupported)))]
    [(Unsupported) (Unsupported)]))

(define (lower-c-abi-sysv-mark-integer-range
  [slots : LowerCAbiSysvSlots]
  [offset : i64]
  [size : i64]) : LowerCAbiSysvSlots
  (if (<= size 0)
    slots
    (let
      [first-slot : i64 (/ offset 8)]
      [last-slot : i64 (/ (+ offset (- size 1)) 8)]
      (if (= first-slot last-slot)
        (lower-c-abi-sysv-mark-integer-slot slots first-slot)
        (lower-c-abi-sysv-mark-integer-slot
          (lower-c-abi-sysv-mark-integer-slot slots first-slot)
          last-slot)))))

(define (lower-c-abi-sysv-mark-sse-slot
  [slots : LowerCAbiSysvSlots]
  [ty : ast.AstType]
  [offset : i64]) : LowerCAbiSysvSlots
  (let
    [slot-index : i64 (/ offset 8)]
    (match slots
      [(Slots first second)
        (if (= slot-index 0)
          (Slots (lower-c-abi-sysv-merge-sse first ty offset) second)
          (if (= slot-index 1)
            (Slots first (lower-c-abi-sysv-merge-sse second ty offset))
            (Unsupported)))]
      [(Unsupported) (Unsupported)])))

(define (lower-c-abi-sysv-classify-fields
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-c-abi-sysv-classify-fields-at ctx fields base-offset slots 0))

(define (lower-c-abi-sysv-classify-fields-at
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    slots
    (let
      [field : tc_core.TcInlineFieldLayout
        (tc_core.tc-inline-field-layout-list-ref fields index)]
      (lower-c-abi-sysv-classify-fields-at
        ctx
        fields
        base-offset
        (lower-c-abi-sysv-classify-type
          ctx
          (tc_core.tc-inline-field-layout-type (lower-global-shared-view field))
          (+ base-offset (tc_core.tc-inline-field-layout-offset field))
          slots)
        (+ index 1)))))

(define (lower-c-abi-sysv-classify-payloads
  [ctx : tc_core.TcContext]
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-c-abi-sysv-classify-payloads-at ctx payloads base-offset slots 0))

(define (lower-c-abi-sysv-classify-payloads-at
  [ctx : tc_core.TcContext]
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-payload-layout-list-count payloads))
    slots
    (let
      [payload : tc_core.TcInlinePayloadLayout
        (tc_core.tc-inline-payload-layout-list-ref payloads index)]
      (lower-c-abi-sysv-classify-payloads-at
        ctx
        payloads
        base-offset
        (lower-c-abi-sysv-classify-type
          ctx
          (tc_core.tc-inline-payload-layout-type
            (lower-global-shared-view payload))
          (+ base-offset (tc_core.tc-inline-payload-layout-offset payload))
          slots)
        (+ index 1)))))

(define (lower-c-abi-sysv-classify-variants
  [ctx : tc_core.TcContext]
  [variants : tc_core.TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-c-abi-sysv-classify-variants-at ctx variants base-offset slots 0))

(define (lower-c-abi-sysv-classify-variants-at
  [ctx : tc_core.TcContext]
  [variants : tc_core.TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-variant-layout-list-count variants))
    slots
    (match (tc_core.tc-inline-variant-layout-list-ref variants index)
      [(Variant _ _ _ payloads)
        (lower-c-abi-sysv-classify-variants-at
          ctx
          variants
          base-offset
          (lower-c-abi-sysv-classify-payloads ctx payloads base-offset slots)
          (+ index 1))])))

(define (lower-c-abi-sysv-classify-layout
  [ctx : tc_core.TcContext]
  [layout : tc_core.TcInlineAggregateLayout]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match layout
    [(Struct _ _ fields)
      (lower-c-abi-sysv-classify-fields ctx fields base-offset slots)]
    [(Enum _ _ variants)
      ;; Synthetic tagged-union view: int64 tag at offset 0 plus every variant
      ;; payload overlaid in the union region starting at offset 8.
      (lower-c-abi-sysv-classify-variants
        ctx
        variants
        base-offset
        (lower-c-abi-sysv-mark-integer-range slots base-offset 8))]))

(define (lower-c-abi-sysv-classify-struct-id
  [ctx : tc_core.TcContext]
  [name-id : i64]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
    [(Ok layout)
      (lower-c-abi-sysv-classify-layout ctx layout base-offset slots)]
    [(Err _) (Unsupported)]))

(define (lower-c-abi-sysv-classify-type
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view resolved)
      [(Struct name)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(StructArgs name _)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(Enum name) (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(EnumArgs name _)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(F64) (lower-c-abi-sysv-mark-sse-slot slots (F64) offset)]
      [(F32) (lower-c-abi-sysv-mark-sse-slot slots (F32) offset)]
      [_
        (if (lower-c-abi-integer-field-type?
          ctx
          (lower-global-shared-view resolved))
          (lower-c-abi-sysv-mark-integer-range
            slots
            offset
            (lower-type-size ctx resolved))
          (Unsupported))])))

(define (lower-c-abi-sysv-slot-from-class
  [class : LowerCAbiEightbyteClass]
  [size : i64]
  [slot-index : i64]) : LowerCAbiSlot
  (let
    [slot-size : i64 (lower-c-abi-sysv-slot-size size slot-index)]
    [slot-offset : i64 (* slot-index 8)]
    (match class
      [(Sse ty offset) (Slot ty offset)]
      [_ (Slot (lower-c-abi-integer-scalar-type slot-size) slot-offset)])))

(define (lower-c-abi-slot-list-count [slots : (& slots LowerCAbiSlotList)]) : i64
  slots.count)

(define (lower-c-abi-slot-list-ref
  [slots : (& slots LowerCAbiSlotList)]
  [index : i64]) : LowerCAbiSlot
  (let
    [slots : LowerCAbiSlotList
      (owned_view.compiler-owned-reference-shared-view slots)]
    (array-ref slots.items index)))

(define (lower-c-abi-slot-list-single [slot : LowerCAbiSlot]) : LowerCAbiSlotList
  (let
    [items : (__tl_dyn-array LowerCAbiSlot) (__tl_make-array LowerCAbiSlot 1)]
    (set! (array-ref items 0) slot)
    (LowerCAbiSlotList items 1)))

(define (lower-c-abi-slot-list-pair
  [first : LowerCAbiSlot]
  [second : LowerCAbiSlot]) : LowerCAbiSlotList
  (let
    [items : (__tl_dyn-array LowerCAbiSlot) (__tl_make-array LowerCAbiSlot 2)]
    (set! (array-ref items 0) first)
    (set! (array-ref items 1) second)
    (LowerCAbiSlotList items 2)))

(define (lower-sysv-register-aggregate-from-slots
  [size : i64]
  [slots : LowerCAbiSysvSlots]
  [allow-return? : bool]
  [unsupported-message : String]) : LowerCAbiAggregate
  (cond
    [(<= size 0) (Unsupported unsupported-message)]
    [(> size 16)
      (if allow-return?
        (Sret size)
        (Memory size))]
    [else
      (match slots
        [(Slots first second)
          (match (lower-global-shared-view first)
            [(Unsupported) (Unsupported unsupported-message)]
            [_
              (match (lower-global-shared-view second)
                [(Unsupported) (Unsupported unsupported-message)]
                [_
                  (if (> size 8)
                    (Register
                      (lower-c-abi-slot-list-pair
                        (lower-c-abi-sysv-slot-from-class first size 0)
                        (lower-c-abi-sysv-slot-from-class second size 1))
                      size)
                    (Register
                      (lower-c-abi-slot-list-single
                        (lower-c-abi-sysv-slot-from-class first size 0))
                      size))])])]
        [(Unsupported) (Unsupported unsupported-message)])]))

(define (lower-c-abi-sysv-register-aggregate-from-slots
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [slots : LowerCAbiSysvSlots]
  [allow-return? : bool]) : LowerCAbiAggregate
  (lower-sysv-register-aggregate-from-slots
    size
    slots
    allow-return?
    (lower-c-abi-unsupported-message mode resolved)))

(define (lower-internal-sysv-register-aggregate-from-slots
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [slots : LowerCAbiSysvSlots]
  [allow-return? : bool]) : LowerCAbiAggregate
  (lower-sysv-register-aggregate-from-slots
    size
    slots
    allow-return?
    (lower-internal-abi-unsupported-message mode resolved)))

(define (lower-c-abi-sysv-register-aggregate
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [fields : tc_core.TcInlineFieldLayoutList]
  [allow-return? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0) (Unsupported (lower-c-abi-unsupported-message mode resolved))]
    [(> size 16)
      (if allow-return?
        (Sret size)
        (Memory size))]
    [(and
        (lower-c-abi-register-aggregate-size? mode size)
        (lower-c-abi-register-aggregate-fields-ok? ctx mode fields))
      (Integer (lower-c-abi-integer-scalar-type size) size)]
    [else
      (lower-c-abi-sysv-register-aggregate-from-slots
        mode
        resolved
        size
        (lower-c-abi-sysv-classify-fields ctx fields 0 (Slots (Empty) (Empty)))
        allow-return?)]))

(define (lower-c-abi-sysv-register-enum-aggregate
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [align : i64]
  [variants : tc_core.TcInlineVariantLayoutList]
  [allow-return? : bool]) : LowerCAbiAggregate
  (if (tc_core.tc-inline-enum-layout-tag-only?
    size
    (lower-global-shared-view variants))
    (Integer (lower-c-abi-integer-scalar-type size) size)
    (lower-c-abi-sysv-register-aggregate-from-slots
      mode
      resolved
      size
      (lower-c-abi-sysv-classify-layout
        ctx
        (Enum size align variants)
        0
        (Slots (Empty) (Empty)))
      allow-return?)))

(define (lower-c-abi-win64-aggregate-class
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [register-ok? : bool]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (cond
    [(and (lower-c-abi-register-aggregate-size? mode size) register-ok?)
      (Integer (lower-c-abi-integer-scalar-type size) size)]
    [(and allow-sret? (> size 8)) (Sret size)]
    [(and allow-byref? (not (lower-c-abi-register-aggregate-size? mode size)))
      (ByRef size)]
    [else (Unsupported (lower-c-abi-unsupported-message mode resolved))]))

(define (lower-c-abi-aggregate-class-from-layout
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [layout : tc_core.TcInlineAggregateLayout]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (match layout
    [(Struct size _ fields)
      (if (lower-mode-windows-c-abi? mode)
        (lower-c-abi-win64-aggregate-class
          mode
          resolved
          size
          (lower-c-abi-register-aggregate-fields-ok? ctx mode fields)
          allow-sret?
          allow-byref?)
        (lower-c-abi-sysv-register-aggregate
          ctx
          mode
          resolved
          size
          fields
          allow-sret?))]
    [(Enum size align variants)
      (if (lower-mode-windows-c-abi? mode)
        ;; Model the default enum layout as a synthetic C aggregate:
        ;; int64 tag at offset 0 plus the max-sized payload union at offset 8.
        (lower-c-abi-win64-aggregate-class
          mode
          resolved
          size
          (tc_core.tc-inline-enum-layout-tag-only? size variants)
          allow-sret?
          allow-byref?)
        (if (lower-mode-linux-c-abi? mode)
          (lower-c-abi-sysv-register-enum-aggregate
            ctx
            mode
            resolved
            size
            align
            variants
            allow-sret?)
          (Unsupported (lower-c-abi-unsupported-message mode resolved))))]))

(define (lower-c-abi-aggregate-class-for-nominal
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [name-id : i64]
  [resolved : ast.AstType]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
    [(Ok layout)
      (lower-c-abi-aggregate-class-from-layout
        ctx
        mode
        resolved
        layout
        allow-sret?
        allow-byref?)]
    [(Err message) (Unsupported message)]))

(define (lower-c-abi-aggregate-class-with-flags
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view resolved)
      [(Struct name)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [(StructArgs name _)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [(Enum name)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [(EnumArgs name _)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [_ (No)])))

(define (lower-c-abi-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (lower-c-abi-aggregate-class-with-flags ctx mode ty false true))

(define (lower-c-abi-return-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (lower-c-abi-aggregate-class-with-flags ctx mode ty true false))

;; Internal aggregate ABI classification is deliberately separate from the C
;; extern classifier above.  The latter is selected only for nominal
;; Struct/Enum declarations and is part of the existing extern contract;
;; these helpers select only structural Tuple/Array values for future internal
;; parameter/return lowering.
(define (lower-internal-sysv-classify-tuple-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [cursor : i64]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (if (>= index (ast.ast-type-list-len types))
    slots
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [resolved : ast.AstType (tc_core.tc-resolve-type ctx ty)]
      [field-align : i64 (lower-type-align ctx resolved)]
      [field-size : i64 (lower-type-size ctx resolved)]
      [offset : i64 (lower-align-up cursor field-align)]
      (lower-internal-sysv-classify-tuple-at
        ctx
        types
        (+ index 1)
        (+ offset field-size)
        base-offset
        (if (<= field-size 0)
          slots
          (lower-internal-sysv-classify-type
            ctx
            resolved
            (+ base-offset offset)
            slots))))))

(define (lower-internal-sysv-classify-array-at
  [ctx : tc_core.TcContext]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [stride : i64]
  [index : i64]
  [count : i64]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (if (>= index count)
    slots
    (lower-internal-sysv-classify-array-at
      ctx
      (lower-global-shared-view elem-ty)
      elem-size
      stride
      (+ index 1)
      count
      base-offset
      (if (<= elem-size 0)
        slots
        (lower-internal-sysv-classify-type
          ctx
          elem-ty
          (+ base-offset (* index stride))
          slots)))))

(define (lower-internal-sysv-classify-type
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view resolved)
      [(Tuple elem-types)
        (let
          [types : ast.AstTypeList (deref elem-types)]
          (lower-internal-sysv-classify-tuple-at ctx (& types) 0 0 offset slots))]
      [(Array elem-id count)
        (let
          [elem-ty : ast.AstType (tc_core.tc-context-type-get ctx elem-id)]
          [elem-size : i64 (lower-type-size ctx elem-ty)]
          [elem-align : i64 (lower-type-align ctx elem-ty)]
          (lower-internal-sysv-classify-array-at
            ctx
            elem-ty
            elem-size
            (lower-align-up elem-size elem-align)
            0
            count
            offset
            slots))]
      [(Struct name)
        (lower-internal-sysv-classify-nominal-id ctx name offset slots)]
      [(StructArgs name _)
        (lower-internal-sysv-classify-nominal-id ctx name offset slots)]
      [(Enum name)
        (lower-internal-sysv-classify-nominal-id ctx name offset slots)]
      [(EnumArgs name _)
        (lower-internal-sysv-classify-nominal-id ctx name offset slots)]
      [(F64) (lower-c-abi-sysv-mark-sse-slot slots (F64) offset)]
      [(F32) (lower-c-abi-sysv-mark-sse-slot slots (F32) offset)]
      [_
        ;; Every other successfully laid-out value is carried by its actual
        ;; bytes.  TypeLisp handles (String, Box, Func, DynArray, ordinary
        ;; references, and inferred handles) therefore occupy INTEGER
        ;; eightbytes even though they are not C-eligible extern fields.
        (match (tc_core.tc-inline-aggregate-type-layout ctx resolved)
          [(Ok info)
            (let
              [size : i64 (tc_core.tc-layout-info-size info)]
              (if (<= size 0)
                slots
                (lower-c-abi-sysv-mark-integer-range slots offset size)))]
          [(Err _) (Unsupported)])])))

(define (lower-internal-sysv-classify-fields
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-internal-sysv-classify-fields-at ctx fields base-offset slots 0))

(define (lower-internal-sysv-classify-fields-at
  [ctx : tc_core.TcContext]
  [fields : tc_core.TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-field-layout-list-count fields))
    slots
    (let
      [field : tc_core.TcInlineFieldLayout
        (tc_core.tc-inline-field-layout-list-ref fields index)]
      (lower-internal-sysv-classify-fields-at
        ctx
        fields
        base-offset
        (lower-internal-sysv-classify-type
          ctx
          (tc_core.tc-inline-field-layout-type (lower-global-shared-view field))
          (+ base-offset (tc_core.tc-inline-field-layout-offset field))
          slots)
        (+ index 1)))))

(define (lower-internal-sysv-classify-payloads
  [ctx : tc_core.TcContext]
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-internal-sysv-classify-payloads-at ctx payloads base-offset slots 0))

(define (lower-internal-sysv-classify-payloads-at
  [ctx : tc_core.TcContext]
  [payloads : tc_core.TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-payload-layout-list-count payloads))
    slots
    (let
      [payload : tc_core.TcInlinePayloadLayout
        (tc_core.tc-inline-payload-layout-list-ref payloads index)]
      (lower-internal-sysv-classify-payloads-at
        ctx
        payloads
        base-offset
        (lower-internal-sysv-classify-type
          ctx
          (tc_core.tc-inline-payload-layout-type
            (lower-global-shared-view payload))
          (+ base-offset (tc_core.tc-inline-payload-layout-offset payload))
          slots)
        (+ index 1)))))

(define (lower-internal-sysv-classify-variants
  [ctx : tc_core.TcContext]
  [variants : tc_core.TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (lower-internal-sysv-classify-variants-at ctx variants base-offset slots 0))

(define (lower-internal-sysv-classify-variants-at
  [ctx : tc_core.TcContext]
  [variants : tc_core.TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]
  [index : i64]) : LowerCAbiSysvSlots
  (if (>= index (tc_core.tc-inline-variant-layout-list-count variants))
    slots
    (match (tc_core.tc-inline-variant-layout-list-ref variants index)
      [(Variant _ _ _ payloads)
        (lower-internal-sysv-classify-variants-at
          ctx
          variants
          base-offset
          (lower-internal-sysv-classify-payloads ctx payloads base-offset slots)
          (+ index 1))])))

(define (lower-internal-sysv-classify-layout
  [ctx : tc_core.TcContext]
  [layout : tc_core.TcInlineAggregateLayout]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match layout
    [(Struct _ _ fields)
      (lower-internal-sysv-classify-fields ctx fields base-offset slots)]
    [(Enum _ _ variants)
      ;; Synthetic tagged-union view: int64 tag at offset 0 plus every variant
      ;; payload overlaid in the union region starting at offset 8.
      (lower-internal-sysv-classify-variants
        ctx
        variants
        base-offset
        (lower-c-abi-sysv-mark-integer-range slots base-offset 8))]))

(define (lower-internal-sysv-classify-nominal-id
  [ctx : tc_core.TcContext]
  [name-id : i64]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
    [(Ok layout)
      (lower-internal-sysv-classify-layout ctx layout base-offset slots)]
    [(Err _) (Unsupported)]))

(define (lower-internal-sysv-register-aggregate
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [allow-return? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0)
      (Unsupported (lower-internal-abi-unsupported-message mode resolved))]
    [(> size 16)
      (if allow-return?
        (Sret size)
        (Memory size))]
    [else
      (lower-internal-sysv-register-aggregate-from-slots
        mode
        (lower-global-shared-view resolved)
        size
        (lower-internal-sysv-classify-type
          ctx
          resolved
          0
          (Slots (Empty) (Empty)))
        allow-return?)]))

(define (lower-internal-win64-type-supported?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-inline-aggregate-type-layout ctx ty)
    [(Ok _) true]
    [(Err _) false]))

(define (lower-internal-win64-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [allow-return? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0)
      (Unsupported (lower-internal-abi-unsupported-message mode resolved))]
    [(not (lower-mode-windows-c-abi? mode))
      (Unsupported (lower-internal-abi-unsupported-message mode resolved))]
    [(not
        (lower-internal-win64-type-supported?
          ctx
          (lower-global-shared-view resolved)))
      (Unsupported (lower-internal-abi-unsupported-message mode resolved))]
    [(lower-c-abi-register-aggregate-size? mode size)
      (Integer (lower-c-abi-integer-scalar-type size) size)]
    [allow-return? (Sret size)]
    [(and allow-byref? (not (lower-c-abi-register-aggregate-size? mode size)))
      (ByRef size)]
    [else (Unsupported (lower-internal-abi-unsupported-message mode resolved))]))

(define (lower-internal-aggregate-class-with-flags
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]
  [allow-return? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view resolved)
      [(Tuple _)
        (match (tc_core.tc-inline-aggregate-type-layout
          ctx
          (lower-global-shared-view resolved))
          [(Ok info)
            (lower-internal-aggregate-class-from-size
              ctx
              mode
              resolved
              (tc_core.tc-layout-info-size info)
              allow-return?
              allow-byref?)]
          [(Err _)
            (Unsupported (lower-internal-abi-unsupported-message mode resolved))])]
      [(Array _ _)
        (match (tc_core.tc-inline-aggregate-type-layout
          ctx
          (lower-global-shared-view resolved))
          [(Ok info)
            (lower-internal-aggregate-class-from-size
              ctx
              mode
              resolved
              (tc_core.tc-layout-info-size info)
              allow-return?
              allow-byref?)]
          [(Err _)
            (Unsupported (lower-internal-abi-unsupported-message mode resolved))])]
      [_ (No)])))

(define (lower-internal-aggregate-class-from-size
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [resolved : ast.AstType]
  [size : i64]
  [allow-return? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (if (lower-mode-windows-c-abi? mode)
    (lower-internal-win64-aggregate-class
      ctx
      mode
      resolved
      size
      allow-return?
      allow-byref?)
    (lower-internal-sysv-register-aggregate
      ctx
      mode
      resolved
      size
      allow-return?)))

(define (lower-internal-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (lower-internal-aggregate-class-with-flags ctx mode ty false true))

(define (lower-internal-return-aggregate-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (lower-internal-aggregate-class-with-flags ctx mode ty true false))

;; Structural values use the internal convention only for Tuple/Array roots.
;; Keep this predicate alongside the classifier so all signature, call and
;; return paths agree on the same source-level gate.
(define (lower-internal-structural-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(Tuple _) true]
    [(Array _ _) true]
    [_ false]))

;; Call sites pass a type list resolved by the type checker already. Keep this
;; root-only check free of another per-element type resolution on the scalar
;; fast path; regions are transparent for the ABI gate.
(define (lower-internal-structural-resolved-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(Tuple _) true]
    [(Array _ _) true]
    [_ false]))

(define (lower-internal-structural-resolved-type-list?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]) : bool
  (lower-internal-structural-resolved-type-list-at? ctx (& types) 0))

(define (lower-internal-structural-resolved-type-list-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (or
        (lower-internal-structural-resolved-type? ty)
        (lower-internal-structural-resolved-type-list-at? ctx types (+ index 1))))))

(define (lower-internal-structural-type-list?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : bool
  (lower-internal-structural-type-list-at? ctx (& types) 0))

(define (lower-internal-structural-type-list-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (or
        (lower-internal-structural-type? ctx ty)
        (lower-internal-structural-type-list-at? ctx types (+ index 1))))))

(define (lower-internal-aggregate-key
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : String
  (let
    [empty-infos : ctfe.CtfeReflectInfoList (ctfe.ctfe-reflect-info-list-empty)]
    (ctfe.ctfe-type-key-with-reflections-and-pools
      (tc_core.tc-context-pools ctx)
      empty-infos
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty)))))

(define (lower-internal-group-mask-from-slots [slots : LowerCAbiSlotList]) : i64
  (if (= (lower-c-abi-slot-list-count slots) 2)
    (let
      [first : LowerCAbiSlot (lower-c-abi-slot-list-ref slots 0)]
      [second : LowerCAbiSlot (lower-c-abi-slot-list-ref slots 1)]
      [first-sse : bool
        (match first
          [(Slot scalar-ty _) (lower-register-word-sse-type? scalar-ty)])]
      [second-sse : bool
        (match second
          [(Slot scalar-ty _) (lower-register-word-sse-type? scalar-ty)])]
      (+
        (if first-sse
          1
          0)
        (if second-sse
          2
          0)))
    0))

;; Physical transport nominal types are intentionally opaque to the source
;; checker. Their display spelling is consumed by backend ABI classification;
;; the canonical source type key makes collisions impossible across nested
;; tuples/arrays and mixed integer/SSE groups.
(define (lower-internal-transport-type
  [ctx : tc_core.TcContext]
  [resolved : ast.AstType]
  [classification : LowerCAbiAggregate]) : ast.AstType
  (match classification
    [(Integer scalar-ty _) scalar-ty]
    [(Register slots _)
      (if (= (lower-c-abi-slot-list-count slots) 1)
        (match (lower-c-abi-slot-list-ref slots 0)
          [(Slot scalar-ty _) scalar-ty])
        (let
          [mask : i64 (lower-internal-group-mask-from-slots slots)]
          [key : String (lower-internal-aggregate-key ctx resolved)]
          [encoded : String
            (str_cat.str-cat
              "__tl_internal_abi_group_m"
              (string.int->string mask)
              "__"
              key)]
          (Struct (lower-derived-symbol-id encoded))))]
    [(Memory size)
      (let
        [key : String (lower-internal-aggregate-key ctx resolved)]
        [encoded : String
          (str_cat.str-cat
            "__tl_internal_abi_mem_s"
            (string.int->string size)
            "__"
            key)]
        (Struct (lower-derived-symbol-id encoded)))]
    [(ByRef _) (U64)]
    [(Sret _) (U64)]
    [_ (lower-one-word-register-storage-type ctx resolved)]))

(define (lower-internal-param-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (if (lower-internal-structural-type? ctx (lower-global-shared-view ty))
    (lower-internal-aggregate-class ctx mode ty)
    (No)))

(define (lower-internal-return-class
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : LowerCAbiAggregate
  (if (lower-internal-structural-type? ctx (lower-global-shared-view ty))
    (lower-internal-return-aggregate-class ctx mode ty)
    (No)))

(define (lower-internal-param-physical-type
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : ast.AstType
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions
        (tc_core.tc-type-strip-invalidate (tc_core.tc-resolve-type ctx ty)))]
    (lower-internal-transport-type
      ctx
      (lower-global-shared-view resolved)
      (lower-internal-param-class ctx mode resolved))))

(define (lower-internal-return-physical-type
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : ast.AstType
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    [classification : LowerCAbiAggregate
      (lower-internal-return-class ctx mode (lower-global-shared-view resolved))]
    (match (lower-global-shared-view classification)
      [(No) (lower-one-word-register-storage-type ctx resolved)]
      [_ (lower-internal-transport-type ctx resolved classification)])))

(define (lower-c-abi-register-resident-to-scalar
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [agg-ty : ast.AstType]
  [scalar-ty : ast.AstType]) : LowerExpr
  (let
    [storage-ty : ast.AstType (lower-one-word-register-storage-type ctx agg-ty)]
    (if (and
      (lower-register-word-sse-type? (lower-global-shared-view storage-ty))
      (not
        (tc_core.tc-type-eq
          (lower-global-shared-view storage-ty)
          (lower-global-shared-view scalar-ty))))
      (lower-bitcast-value state value storage-ty scalar-ty)
      (Expr state value scalar-ty))))

(define (lower-c-abi-scalar-to-register-resident
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [scalar-ty : ast.AstType]
  [agg-ty : ast.AstType]) : LowerExpr
  (let
    [storage-ty : ast.AstType (lower-one-word-register-storage-type ctx agg-ty)]
    (if (and
      (lower-register-word-sse-type? (lower-global-shared-view storage-ty))
      (not
        (tc_core.tc-type-eq
          (lower-global-shared-view scalar-ty)
          (lower-global-shared-view storage-ty))))
      (match (lower-bitcast-value state value scalar-ty storage-ty)
        [(Expr bit-state bit-value _) (Expr bit-state bit-value agg-ty)])
      (Expr state value agg-ty))))

(define (lower-c-abi-args-as
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]) : ResultLowerArgs
  (lower-c-abi-args-as-at ctx state env type-env (& args) (& types) 0))

(define (lower-c-abi-args-as-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index args.len)
    (if (>= index (ast.ast-type-list-len types))
      (Ok state (ir.compiler-ir-value-seq-empty))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [arg : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [expected-id : i64
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))]
        [expected : ast.AstType (tc_core.tc-context-type-get ctx expected-id)]
        [arg-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx expected))]
        [lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view arg)
              (lower-global-shared-view arg-ty)
              (lower-global-shared-view arg)))]
        (match lowered
          [(Expr arg-state value _)
            (match (lower-c-abi-aggregate-class
              ctx
              (lower-state-mode arg-state)
              (lower-global-shared-view arg-ty))
              [(No)
                (match (lower-c-abi-args-as-at
                  ctx
                  arg-state
                  env
                  type-env
                  args
                  types
                  (+ index 1))
                  [(Ok rest-state rest-values)
                    (Ok
                      rest-state
                      (ir.compiler-ir-value-seq-prepend value rest-values))]
                  [(Err message) (Err message)])]
              [(Integer scalar-ty size)
                ;; A register-resident aggregate is carried as a
                ;; single-word scalar -- `value` is already the word the C
                ;; ABI wants in a register, so pass it directly. Any other
                ;; aggregate (a memory-backed value, e.g. a mixed
                ;; int/float sub-word struct) is a pointer, so load the
                ;; scalar out of it. Gate on the same residency predicate
                ;; that chose the value representation -- not on `size`,
                ;; since mixed sub-word float structs can still be
                ;; memory-backed at 8 bytes.
                (match (if (lower-type-register-resident?
                  ctx
                  (lower-global-shared-view arg-ty))
                  (lower-c-abi-register-resident-to-scalar
                    ctx
                    arg-state
                    value
                    arg-ty
                    scalar-ty)
                  (lower-load-at-offset arg-state value 0 scalar-ty))
                  [(Expr scalar-state scalar-value _)
                    (match (lower-c-abi-args-as-at
                      ctx
                      scalar-state
                      env
                      type-env
                      args
                      types
                      (+ index 1))
                      [(Ok rest-state rest-values)
                        (Ok
                          rest-state
                          (ir.compiler-ir-value-seq-prepend
                            scalar-value
                            rest-values))]
                      [(Err message) (Err message)])])]
              [(Register slots _)
                (match (lower-c-abi-register-arg-slot-values
                  ctx
                  arg-state
                  value
                  arg-ty
                  slots)
                  [(Ok slot-state slot-values)
                    (match (lower-c-abi-args-as-at
                      ctx
                      slot-state
                      env
                      type-env
                      args
                      types
                      (+ index 1))
                      [(Ok rest-state rest-values)
                        (Ok
                          rest-state
                          (lower-value-seq-append slot-values rest-values))]
                      [(Err message) (Err message)])]
                  [(Err message) (Err message)])]
              [(Memory size)
                ;; The backend consumes size/unit markers and copies the aggregate to %rsp.
                (match (lower-c-abi-args-as-at
                  ctx
                  arg-state
                  env
                  type-env
                  args
                  types
                  (+ index 1))
                  [(Ok rest-state rest-values)
                    (Ok
                      rest-state
                      (lower-value-seq-append
                        (ir.compiler-ir-value-seq3 value (I64 size) (Unit))
                        rest-values))]
                  [(Err message) (Err message)])]
              [(ByRef _)
                ;; The ABI argument is the address of a caller-owned copy,
                ;; not the aggregate itself. The copy lives in this
                ;; function's frame, not the arena, so a call in a loop
                ;; allocates nothing (#7885).
                (let
                  [copied
                    (try
                      (lower-copy-inline-aggregate-to-inline-as
                        ctx
                        arg-state
                        value
                        arg-ty
                        (U64)))]
                  (match copied
                    [(Expr copy-state copy-value _)
                      (match (lower-c-abi-args-as-at
                        ctx
                        copy-state
                        env
                        type-env
                        args
                        types
                        (+ index 1))
                        [(Ok rest-state rest-values)
                          (Ok
                            rest-state
                            (ir.compiler-ir-value-seq-prepend
                              copy-value
                              rest-values))]
                        [(Err message) (Err message)])]))]
              [(Unsupported message)
                (Err (box (lower-diagnostic-at-expr ctx arg message)))]
              [(Sret _)
                (Err
                  (box
                    (lower-diagnostic-at-expr
                      ctx
                      arg
                      (lower-c-abi-unsupported-message
                        (lower-state-mode arg-state)
                        arg-ty))))])])))))

(define (lower-c-abi-register-arg-slot-values-from
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [arg-ty : ast.AstType]
  [slots : LowerCAbiSlotList]
  [index : i64]) : ResultLowerArgs
  (if (>= index (lower-c-abi-slot-list-count slots))
    (Ok state (ir.compiler-ir-value-seq-empty))
    (match (lower-c-abi-slot-list-ref slots index)
      [(Slot scalar-ty offset)
        (match (if (lower-type-register-resident?
          ctx
          (lower-global-shared-view arg-ty))
          (if (lower-type-register-group? ctx (lower-global-shared-view arg-ty))
            (lower-emit-word
              state
              (lower-global-shared-view value)
              (/ offset 8)
              scalar-ty)
            (Expr state (lower-global-shared-view value) scalar-ty))
          (lower-load-at-offset state value offset scalar-ty))
          [(Expr slot-state slot-value _)
            (match (lower-c-abi-register-arg-slot-values-from
              ctx
              slot-state
              value
              arg-ty
              slots
              (+ index 1))
              [(Ok rest-state rest-values)
                (Ok
                  rest-state
                  (ir.compiler-ir-value-seq-prepend slot-value rest-values))]
              [(Err message) (Err message)])])])))

(define (lower-c-abi-register-arg-slot-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [arg-ty : ast.AstType]
  [slots : LowerCAbiSlotList]) : ResultLowerArgs
  (lower-c-abi-register-arg-slot-values-from ctx state value arg-ty slots 0))

(define (lower-value-seq-append
  [values : ir.CompilerIrValueSeq]
  [tail : ir.CompilerIrValueSeq]) : ir.CompilerIrValueSeq
  (ir.compiler-ir-value-seq-append values tail))

(define (lower-c-abi-ir-return-slots-from
  [slots : LowerCAbiSlotList]
  [out : (&mut out (__tl_dyn-array ir.CompilerIrCAbiReturnSlot))]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (match (lower-c-abi-slot-list-ref slots index)
      [(Slot scalar-ty offset)
        (set!
          (array-ref out index)
          (ir.CompilerIrCAbiReturnSlot.Slot scalar-ty offset))
        (lower-c-abi-ir-return-slots-from slots out (+ index 1) count)])))

(define (lower-c-abi-ir-return-slots [slots : LowerCAbiSlotList]) : ir.CompilerIrCAbiReturnSlotSeq
  (let
    [count : i64 (lower-c-abi-slot-list-count slots)]
    [out : (__tl_dyn-array ir.CompilerIrCAbiReturnSlot)
      (__tl_make-array ir.CompilerIrCAbiReturnSlot count)]
    (lower-c-abi-ir-return-slots-from slots (&mut out) 0 count)
    (ir.CompilerIrCAbiReturnSlotSeq out count)))

(define (lower-c-abi-materialize-stored-register-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (if (lower-type-register-group? ctx (lower-global-shared-view result-ty))
    (lower-load-group-from-ptr ctx state base result-ty)
    (Expr state base result-ty)))

(define (lower-c-abi-finish-call-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [call-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [abi : LowerCAbiAggregate]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match abi
    [(No) (Ok (Expr state call-value result-ty))]
    [(Integer scalar-ty size)
      ;; A register-resident aggregate is carried as a single-word scalar --
      ;; the C call returns the whole value in a register, which IS that word
      ;; representation, so hand it back directly. Any other aggregate (a
      ;; memory-backed value, e.g. a mixed int/float sub-word struct) is
      ;; referenced by pointer, so spill the returned scalar
      ;; into a fresh slot and return the pointer. Gate on the same residency
      ;; predicate that chose the value representation -- not on `size`, since
      ;; mixed sub-word float structs can still be memory-backed at 8 bytes.
      (if (lower-type-register-resident?
        ctx
        (lower-global-shared-view result-ty))
        (Ok
          (lower-c-abi-scalar-to-register-resident
            ctx
            state
            call-value
            scalar-ty
            result-ty))
        (match (lower-reserve-inline-storage state size result-ty)
          [(Expr base-state base _)
            (Ok
              (Expr
                (lower-store-at-offset base-state base 0 call-value scalar-ty)
                base
                result-ty))]))]
    [(Register slots size)
      (let
        [slot-count : i64 (lower-c-abi-slot-list-count slots)]
        (cond
          [(= slot-count 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(Slot scalar-ty offset)
                (if (lower-type-register-resident?
                  ctx
                  (lower-global-shared-view result-ty))
                  (Ok (Expr state call-value result-ty))
                  (match (lower-reserve-inline-storage state size result-ty)
                    [(Expr base-state base _)
                      (Ok
                        (Expr
                          (lower-store-at-offset
                            base-state
                            base
                            offset
                            call-value
                            scalar-ty)
                          base
                          result-ty))]))])]
          [(= slot-count 0)
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  (lower-c-abi-unsupported-message
                    (lower-state-mode state)
                    result-ty))))]
          [else
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  (lower-c-abi-two-register-return-message result-ty))))]))]
    [(ByRef _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(Memory _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(Sret _)
      ;; The C callee wrote the >8B result into the caller-provided sret
      ;; buffer, so `call-value` is the buffer pointer. A register-resident result
      ;; (a 16B word-class struct: a 2-word register group in this backend) must
      ;; be materialized back into that two-word group VALUE -- load both words
      ;; and Pack -- or downstream consumers that expect a register pair (e.g. a
      ;; by-value call argument) get the pointer in word0 and garbage in word1.
      ;; A genuine memory aggregate (>16B, or float-containing) stays the pointer.
      (if (lower-type-register-group? ctx (lower-global-shared-view result-ty))
        (Ok (lower-load-group-from-ptr ctx state call-value result-ty))
        (Ok (Expr state call-value result-ty)))]
    [(Unsupported message)
      (Err (box (lower-diagnostic-at-expr ctx origin message)))]))

(define (lower-direct-c-abi-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [param-types : ast.AstTypeList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-c-abi-args-as ctx state env type-env args param-types)
    [(Ok args-state values)
      (lower-c-abi-call-values
        ctx
        args-state
        (Direct env name-id name)
        values
        result-ty
        origin)]
    [(Err message) (Err message)]))

;; The callee of a lowered call: a named function (resolved once the call's
;; destination var is allocated) or a function value.
(defenum LowerCallTarget
  (Direct sym_i64_env.SymI64Env i64 String)
  (Indirect ir.CompilerIrValue))

;; The call instruction for `target`: `Call` for a named callee and, for a
;; function value, `CallIndirectC` under the C ABI or `CallIndirect` under the
;; internal one.
(define (lower-call-target-instr
  [state : LowerState]
  [target : LowerCallTarget]
  [c-abi? : bool]
  [dst : i64]
  [args : ir.CompilerIrCallArgs]
  [ty : ast.AstType]) : ir.CompilerIrInstr
  (match target
    [(Direct env source-id name)
      (Call
        dst
        (lower-resolve-call-name-id-with-display state env source-id name)
        args
        ty)]
    [(Indirect func-value)
      (if c-abi?
        (CallIndirectC dst func-value args ty)
        (CallIndirect dst func-value args ty))]))

(define (lower-call-target-store-result-instr
  [state : LowerState]
  [target : LowerCallTarget]
  [base : ir.CompilerIrValue]
  [args : ir.CompilerIrCallArgs]
  [slots : ir.CompilerIrCAbiReturnSlotSeq]) : ir.CompilerIrInstr
  (match target
    [(Direct env source-id name)
      (ir.ir-instr-call-cabi-store-result
        base
        (lower-resolve-call-name-id-with-display state env source-id name)
        args
        slots)]
    [(Indirect func-value)
      (ir.ir-instr-call-indirect-cabi-store-result base func-value args slots)]))

(define (lower-c-abi-call-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [target : LowerCallTarget]
  [values : ir.CompilerIrValueSeq]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-c-abi-return-aggregate-class
    ctx
    (lower-state-mode state)
    (lower-global-shared-view result-ty))
    [(Unsupported message)
      (Err (box (lower-diagnostic-at-expr ctx origin message)))]
    [(No)
      (match (lower-state-alloc-var state)
        [(Alloc allocated var-id)
          (let
            [instr : ir.CompilerIrInstr
              (lower-call-target-instr
                allocated
                target
                true
                var-id
                (ir.compiler-ir-call-args-from-seq values)
                (lower-global-shared-view result-ty))]
            (lower-c-abi-finish-call-result
              ctx
              (lower-state-emit-at-expr
                ctx
                allocated
                instr
                (lower-global-shared-view origin))
              (Var var-id)
              result-ty
              (No)
              origin))])]
    [(Integer scalar-ty size)
      (match (lower-state-alloc-var state)
        [(Alloc allocated var-id)
          (let
            [instr : ir.CompilerIrInstr
              (lower-call-target-instr
                allocated
                target
                true
                var-id
                (ir.compiler-ir-call-args-from-seq values)
                (lower-global-shared-view scalar-ty))]
            (lower-c-abi-finish-call-result
              ctx
              (lower-state-emit-at-expr
                ctx
                allocated
                instr
                (lower-global-shared-view origin))
              (Var var-id)
              result-ty
              (Integer scalar-ty size)
              origin))])]
    [(Register slots size)
      (let
        [slot-count : i64 (lower-c-abi-slot-list-count slots)]
        (cond
          [(= slot-count 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(Slot scalar-ty _)
                (match (lower-state-alloc-var state)
                  [(Alloc allocated var-id)
                    (let
                      [instr : ir.CompilerIrInstr
                        (lower-call-target-instr
                          allocated
                          target
                          true
                          var-id
                          (ir.compiler-ir-call-args-from-seq values)
                          scalar-ty)]
                      (lower-c-abi-finish-call-result
                        ctx
                        (lower-state-emit-at-expr
                          ctx
                          allocated
                          instr
                          (lower-global-shared-view origin))
                        (Var var-id)
                        result-ty
                        (Register slots size)
                        origin))])])]
          [(= slot-count 0)
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  (lower-c-abi-unsupported-message
                    (lower-state-mode state)
                    result-ty))))]
          [else
            (match (lower-reserve-inline-storage state size result-ty)
              [(Expr base-state base _)
                (let
                  [instr : ir.CompilerIrInstr
                    (lower-call-target-store-result-instr
                      base-state
                      target
                      (lower-global-shared-view base)
                      (ir.compiler-ir-call-args-from-seq values)
                      (lower-c-abi-ir-return-slots slots))]
                  (match (lower-c-abi-materialize-stored-register-result
                    ctx
                    (lower-state-emit-at-expr ctx base-state instr origin)
                    base
                    result-ty)
                    [(Expr out-state out-value out-ty)
                      (Ok (Expr out-state out-value out-ty))]))])]))]
    [(ByRef _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(Memory _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(Sret size)
      ;; The sret buffer is caller frame storage, as for an internal sret
      ;; result. Its address is an `addr_of` value, which is a single pointer
      ;; word even when `result-ty` is a register group, so the backend never
      ;; splits the hidden argument into two registers. The call marks it as
      ;; the sret argument: colouring keeps the slot live through every use of
      ;; the call's result, and a loop-carried result is snapshotted at its
      ;; assignment, so a later execution of this call never overwrites a
      ;; result that is still live. The result materialization reads the value
      ;; back through `base` using `result-ty` explicitly.
      (match (lower-reserve-inline-storage state size result-ty)
        [(Expr base-state base _)
          (match (lower-state-alloc-var base-state)
            [(Alloc allocated var-id)
              (let
                [instr : ir.CompilerIrInstr
                  (lower-call-target-instr
                    allocated
                    target
                    true
                    var-id
                    (ir.compiler-ir-call-args-sret-from-seq
                      (ir.compiler-ir-value-seq-prepend
                        (lower-global-shared-view base)
                        values)
                      0)
                    (U64))]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr
                    ctx
                    allocated
                    instr
                    (lower-global-shared-view origin))
                  base
                  result-ty
                  (Sret size)
                  origin))])])]))

(define (lower-extern-value-c-abi-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]
  [param-types : ast.AstTypeList]
  [fn-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [lowered-func
      (try (lower-var-id state env name-id (lower-global-shared-view fn-ty)))]
    (match lowered-func
      [(Expr func-state func-value _)
        (match (lower-state-alloc-var func-state)
          [(Alloc allocated func-var)
            (let
              [loaded-state : LowerState
                (lower-state-emit-at-expr
                  ctx
                  allocated
                  (Mov func-var func-value fn-ty)
                  (lower-global-shared-view origin))]
              (match (lower-c-abi-args-as
                ctx
                loaded-state
                env
                type-env
                args
                param-types)
                [(Ok args-state values)
                  (lower-c-abi-call-values
                    ctx
                    args-state
                    (Indirect (Var func-var))
                    values
                    result-ty
                    origin)]
                [(Err message) (Err message)]))])])))

;; sret ABI caller side: append the sret pointer as the trailing arg to a
;; value list (matching the callee's `__sret` param).
(define (lower-value-seq-append-one
  [values : ir.CompilerIrValueSeq]
  [extra : ir.CompilerIrValue]) : ir.CompilerIrValueSeq
  (ir.compiler-ir-value-seq-append-one values extra))

;; For a call whose result is an inline aggregate, allocate the result slot on
;; the caller's stack and append its pointer as the hidden trailing arg. Uses
;; the same gate/size as the callee's sret return, so the call's return value is
;; that pointer and callers consume the result exactly as before. Non-aggregate
;; results pass through unchanged.
(define (lower-call-append-sret-arg
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [values : ir.CompilerIrValueSeq]
  [result-ty : ast.AstType]) : ResultLowerArgs
  ;; Structural Tuple/Array sret is a leading ABI argument handled by the
  ;; internal call path below. This legacy helper is nominal Struct/Enum only.
  (if (and
    (lower-type-inline-struct-or-enum? ctx (lower-global-shared-view result-ty))
    (lower-inline-aggregate-abi-copy-needed?
      ctx
      (lower-global-shared-view result-ty)))
    (match (lower-inline-aggregate-copy-size
      ctx
      (lower-global-shared-view result-ty))
      [(Ok size)
        (match (lower-reserve-inline-storage state size result-ty)
          [(Expr slot-state slot-ptr _)
            (Ok slot-state (lower-value-seq-append-one values slot-ptr))])]
      [(Err message) (Err (box (lower-diagnostic message)))])
    (Ok state values)))

;; Keep the ownership role on the IR argument carrier. The ABI still sees the
;; same physical values, but colouring need not guess from position.
(define (lower-call-args-with-nominal-sret
  [ctx : tc_core.TcContext]
  [values : ir.CompilerIrValueSeq]
  [result-ty : ast.AstType]) : ir.CompilerIrCallArgs
  (if (and
    (lower-type-inline-struct-or-enum? ctx (lower-global-shared-view result-ty))
    (lower-inline-aggregate-abi-copy-needed? ctx result-ty))
    (let
      [index : i64 (- values.len 1)]
      (ir.compiler-ir-call-args-sret-from-seq values index))
    (ir.compiler-ir-call-args-from-seq values)))

(define (lower-value-seq-prepend-one
  [head : ir.CompilerIrValue]
  [tail : ir.CompilerIrValueSeq]) : ir.CompilerIrValueSeq
  (ir.compiler-ir-value-seq-prepend head tail))

(define (lower-internal-return-class-for-symbol
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [names : LowerNameCache]
  [symbol : i64]
  [result-ty : ast.AstType]) : LowerCAbiAggregate
  ;; Global initializers are invoked by startup code, which owns the stable
  ;; arena result path rather than a caller stack slot.
  (if (lower-global-init-function-symbol? names symbol)
    (No)
    (lower-internal-return-class ctx mode result-ty)))

(define (lower-internal-call-register-two
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [classification : LowerCAbiAggregate]
  [slots : LowerCAbiSlotList]) : ResultLowerArgs
  (match (lower-c-abi-register-arg-slot-values
    ctx
    state
    value
    (lower-global-shared-view source-ty)
    slots)
    [(Ok slot-state slot-values)
      (if (= slot-values.len 2)
        (match (lower-emit-pack
          slot-state
          (ir.compiler-ir-value-seq2
            (ir.compiler-ir-value-seq-ref slot-values 0)
            (ir.compiler-ir-value-seq-ref slot-values 1))
          (lower-internal-transport-type ctx source-ty classification))
          [(Expr packed-state packed-value _)
            (Ok packed-state (ir.compiler-ir-value-seq1 packed-value))])
        (Err (box (lower-diagnostic "lower: structural register group arity"))))]
    [(Err message) (Err message)]))

(define (lower-internal-call-arg-one
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [classification : LowerCAbiAggregate]
  [origin : ast.AstExpr]) : ResultLowerArgs
  (match (lower-global-shared-view classification)
    [(No) (Ok state (ir.compiler-ir-value-seq1 value))]
    [(Integer scalar-ty _)
      (match (lower-load-at-offset state value 0 scalar-ty)
        [(Expr loaded loaded-value _)
          (Ok loaded (ir.compiler-ir-value-seq1 loaded-value))])]
    [(Register slots _)
      (if (= (lower-c-abi-slot-list-count slots) 1)
        (match (lower-c-abi-slot-list-ref slots 0)
          [(Slot scalar-ty offset)
            (match (lower-load-at-offset state value offset scalar-ty)
              [(Expr loaded loaded-value _)
                (Ok loaded (ir.compiler-ir-value-seq1 loaded-value))])])
        (lower-internal-call-register-two
          ctx
          state
          value
          source-ty
          classification
          slots))]
    [(Memory size)
      (let
        [physical-ty : ast.AstType
          (lower-internal-transport-type ctx source-ty classification)]
        (match (lower-state-alloc-var state)
          [(Alloc allocated var-id)
            (Ok
              (lower-state-emit allocated (Mov var-id value physical-ty))
              (ir.compiler-ir-value-seq1 (Var var-id)))]))]
    [(ByRef size)
      (match (lower-reserve-inline-storage state size source-ty)
        [(Expr copy-state copy-ptr _)
          (let
            [copied : LowerState
              (lower-copy-bytes
                copy-state
                (lower-global-shared-view copy-ptr)
                0
                value
                0
                size)]
            (match (lower-cast-value copied copy-ptr source-ty (U64))
              [(Expr cast-state pointer _)
                (Ok cast-state (ir.compiler-ir-value-seq1 pointer))]))])]
    [(Unsupported message)
      (Err (box (lower-diagnostic-at-expr ctx origin message)))]
    [(Sret _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: structural return classification used for parameter")))]))

(define (lower-internal-call-args-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [state : LowerState]
  [values : ir.CompilerIrValueSeq]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [origin : ast.AstExpr]) : ResultLowerArgs
  (if (>= index values.len)
    (if (>= index (ast.ast-type-list-len types))
      (Ok state (ir.compiler-ir-value-seq-empty))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (Err (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [source-ty : ast.AstType
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        (match (lower-internal-call-arg-one
          ctx
          state
          (ir.compiler-ir-value-seq-ref values index)
          (lower-global-shared-view source-ty)
          (lower-internal-param-class ctx mode source-ty)
          (lower-global-shared-view origin))
          [(Ok arg-state arg-values)
            (match (lower-internal-call-args-at
              ctx
              mode
              arg-state
              values
              types
              (+ index 1)
              origin)
              [(Ok rest-state rest-values)
                (Ok rest-state (lower-value-seq-append arg-values rest-values))]
              [(Err message) (Err message)])]
          [(Err message) (Err message)])))))

(define (lower-internal-call-args
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [state : LowerState]
  [values : ir.CompilerIrValueSeq]
  [types : ast.AstTypeList]
  [origin : ast.AstExpr]) : ResultLowerArgs
  (if (lower-internal-structural-resolved-type-list? ctx types)
    (lower-internal-call-args-at ctx mode state values (& types) 0 origin)
    (Ok state values)))

(define (lower-internal-materialize-result-two
  [call-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [slots : LowerCAbiSlotList]
  [storage : ir.CompilerIrValue]
  [storage-state : LowerState]) : ResultLowerExpr
  (match (lower-c-abi-slot-list-ref slots 0)
    [(Slot first-ty first-offset)
      (match (lower-emit-word
        storage-state
        (lower-global-shared-view call-value)
        0
        (lower-global-shared-view first-ty))
        [(Expr first-state first-value _)
          (match (lower-c-abi-slot-list-ref slots 1)
            [(Slot second-ty second-offset)
              (match (lower-emit-word
                first-state
                call-value
                1
                (lower-global-shared-view second-ty))
                [(Expr second-state second-value _)
                  (let
                    [with0 : LowerState
                      (lower-store-at-offset
                        second-state
                        storage
                        first-offset
                        first-value
                        first-ty)]
                    [with1 : LowerState
                      (lower-store-at-offset
                        with0
                        storage
                        second-offset
                        second-value
                        second-ty)]
                    (Ok (Expr with1 storage result-ty)))])])])]))

(define (lower-internal-materialize-call-result
  [state : LowerState]
  [call-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [classification : LowerCAbiAggregate]) : ResultLowerExpr
  (match classification
    [(Integer scalar-ty size)
      (match (lower-reserve-inline-storage state size result-ty)
        [(Expr storage-state storage _)
          (Ok
            (Expr
              (lower-store-at-offset
                storage-state
                storage
                0
                call-value
                scalar-ty)
              storage
              result-ty))])]
    [(Register slots size)
      (match (lower-reserve-inline-storage state size result-ty)
        [(Expr storage-state storage _)
          (if (= (lower-c-abi-slot-list-count slots) 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(Slot scalar-ty offset)
                (Ok
                  (Expr
                    (lower-store-at-offset
                      storage-state
                      storage
                      offset
                      call-value
                      scalar-ty)
                    storage
                    result-ty))])
            (lower-internal-materialize-result-two
              call-value
              result-ty
              slots
              storage
              storage-state))])]
    [_
      (Err (box (lower-diagnostic "lower: unsupported structural call result")))]))

(define (lower-internal-call-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [target : LowerCallTarget]
  [values : ir.CompilerIrValueSeq]
  [param-types : ast.AstTypeList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [mode : CompilerLowerMode (lower-state-mode state)]
    [result-class : LowerCAbiAggregate
      (lower-internal-return-class
        ctx
        mode
        (lower-global-shared-view result-ty))]
    (match (lower-internal-call-args
      ctx
      mode
      state
      values
      param-types
      (lower-global-shared-view origin))
      [(Ok args-state physical-values)
        (match (lower-global-shared-view result-class)
          [(Sret size)
            (match (lower-reserve-inline-storage args-state size result-ty)
              [(Expr slot-state slot-ptr _)
                (match (lower-cast-value
                  slot-state
                  (lower-global-shared-view slot-ptr)
                  (lower-global-shared-view result-ty)
                  (U64))
                  [(Expr cast-state sret-pointer _)
                    (match (lower-state-alloc-var cast-state)
                      [(Alloc allocated call-var)
                        (Ok
                          (Expr
                            (lower-state-emit-at-expr
                              ctx
                              allocated
                              (lower-call-target-instr
                                allocated
                                target
                                false
                                call-var
                                (ir.compiler-ir-call-args-sret-from-seq
                                  (lower-value-seq-prepend-one
                                    sret-pointer
                                    physical-values)
                                  0)
                                (U64))
                              origin)
                            slot-ptr
                            result-ty))])])])]
          [(No)
            (lower-call-values
              ctx
              args-state
              target
              physical-values
              result-ty
              origin)]
          [(Unsupported message)
            (Err (box (lower-diagnostic-at-expr ctx origin message)))]
          [_
            (match (lower-state-alloc-var args-state)
              [(Alloc allocated call-var)
                (let
                  [physical-ret : ast.AstType
                    (lower-internal-transport-type
                      ctx
                      (lower-global-shared-view result-ty)
                      (lower-global-shared-view result-class))]
                  [call-state : LowerState
                    (lower-state-emit-at-expr
                      ctx
                      allocated
                      (lower-call-target-instr
                        allocated
                        target
                        false
                        call-var
                        (ir.compiler-ir-call-args-from-seq physical-values)
                        physical-ret)
                      origin)]
                  (lower-internal-materialize-call-result
                    call-state
                    (Var call-var)
                    result-ty
                    result-class))])])]
      [(Err message) (Err message)])))

(define (lower-bytes-view-from-parts-result
  [state : LowerState]
  [ptr-value : ir.CompilerIrValue]
  [len-value : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : ResultLowerExpr
  ;; A `bytes` view is the two-word fat reference itself: no record, no
  ;; storage and no runtime call.
  (Ok
    (lower-emit-pack
      state
      (ir.compiler-ir-value-seq2 ptr-value len-value)
      result-ty)))

(define (lower-bytes-view-from-parts-values
  [ctx : tc_core.TcContext]
  [args-result : ResultLowerArgs]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match args-result
    [(Ok args-state values)
      (if (= values.len 3)
        (lower-bytes-view-from-parts-result
          args-state
          (ir.compiler-ir-value-seq-ref values 0)
          (ir.compiler-ir-value-seq-ref values 1)
          result-ty)
        (Err
          (box
            (lower-diagnostic-at-expr
              ctx
              origin
              "lower: bytes view helper expects data, length, owner"))))]
    [(Err message) (Err message)]))

(define (lower-bytes-view-from-parts-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (lower-bytes-view-from-parts-values
    ctx
    (lower-args ctx state env type-env args)
    result-ty
    origin))

(define (lower-direct-call-from-args
  [ctx : tc_core.TcContext]
  [args-result : ResultLowerArgs]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [name : String]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match args-result
    [(Ok args-state values)
      (lower-call-values
        ctx
        args-state
        (Direct env source-id name)
        values
        result-ty
        origin)]
    [(Err message) (Err message)]))

(define (lower-direct-call-from-call-args
  [ctx : tc_core.TcContext]
  [args-result : ResultLowerCallArgs]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [name : String]
  [param-types : ast.AstTypeList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match args-result
    [(Ok args-state values writebacks)
      (let
        [lowered : LowerExpr
          (try
            (lower-internal-call-values
              ctx
              args-state
              (Direct env source-id name)
              values
              param-types
              result-ty
              origin))]
        (match lowered
          [(Expr call-state call-value call-ty)
            (Ok
              (Expr
                (lower-apply-arg-writebacks ctx call-state writebacks)
                call-value
                call-ty))]))]
    [(Err message) (Err message)]))

(define (lower-direct-call-param-types
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : tc_core.ResultTcTypeList
  (match (tc_core.tc-call-extern-abi-for-name-id ctx name-id)
    [(Some abi)
      (if (tc_core.tc-call-dynamic-c-varargs-abi?
        (lower-global-shared-view abi))
        (tc_core.tc-call-extern-varargs-params
          ctx
          type-env
          (Var name-id)
          args
          params
          abi)
        (Ok params))]
    [(No) (Ok params)]))

(define (lower-direct-call-id-with-lookup-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (lower-bytes-view-from-parts-name? (lower-global-shared-view name))
    (lower-bytes-view-from-parts-call
      ctx
      state
      env
      type-env
      args
      result-ty
      origin)
    (match (lower-lookup-type-id
      ctx
      (lower-state-type-cache state)
      env
      type-env
      lookup-id)
      [(Ok fn-ty)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx (lower-global-shared-view fn-ty)))
          [(CFunc _ _)
            (let
              [lowered
                (try
                  (lower-var-or-nullary-variant-id
                    ctx
                    state
                    env
                    type-env
                    source-id
                    (lower-global-shared-view fn-ty)))]
              (match lowered
                [(Expr value-state value _)
                  (lower-indirect-c-abi-call
                    ctx
                    value-state
                    env
                    type-env
                    fn-ty
                    value
                    args
                    result-ty
                    origin)]))]
          [(Func param-types _)
            (match (lower-direct-call-param-types
              ctx
              type-env
              source-id
              (lower-global-shared-view args)
              (tc_core.tc-resolve-type-list ctx (deref param-types)))
              [(Ok call-param-types)
                (if (lower-c-abi-extern-call?
                  ctx
                  state
                  env
                  (if (>= lookup-id 0)
                    lookup-id
                    source-id)
                  (lower-global-shared-view name))
                  (lower-direct-c-abi-call
                    ctx
                    state
                    env
                    type-env
                    (if (>= lookup-id 0)
                      lookup-id
                      source-id)
                    name
                    args
                    call-param-types
                    result-ty
                    origin)
                  (if (lower-c-abi-extern-value-call?
                    ctx
                    state
                    env
                    (if (>= lookup-id 0)
                      lookup-id
                      source-id)
                    (lower-global-shared-view name))
                    (lower-extern-value-c-abi-call
                      ctx
                      state
                      env
                      type-env
                      (if (>= lookup-id 0)
                        lookup-id
                        source-id)
                      args
                      call-param-types
                      (tc_core.tc-type-strip-region
                        (tc_core.tc-resolve-type ctx fn-ty))
                      result-ty
                      origin)
                    (lower-direct-call-from-call-args
                      ctx
                      (lower-call-args-as-needed
                        ctx
                        state
                        env
                        type-env
                        args
                        (lower-global-shared-view call-param-types))
                      env
                      source-id
                      name
                      call-param-types
                      result-ty
                      origin)))]
              [(Err message)
                (Err (box (lower-diagnostic-at-expr ctx origin message)))])]
          [_
            (lower-direct-call-from-args
              ctx
              (lower-args ctx state env type-env args)
              env
              source-id
              name
              result-ty
              origin)])]
      [(Err _)
        (lower-direct-call-from-args
          ctx
          (lower-args ctx state env type-env args)
          env
          source-id
          name
          result-ty
          origin)])))

(define (lower-direct-call-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (lower-direct-call-id-with-lookup-id
    ctx
    state
    env
    type-env
    source-id
    source-id
    name
    args
    result-ty
    origin))

(define (lower-call-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [target : LowerCallTarget]
  [values : ir.CompilerIrValueSeq]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-call-append-sret-arg
    ctx
    state
    values
    (lower-global-shared-view result-ty))
    [(Ok sret-state sret-values)
      (match (lower-state-alloc-var sret-state)
        [(Alloc allocated var-id)
          (let
            [result-ir-ty : ast.AstType
              (lower-one-word-register-storage-type ctx result-ty)]
            [instr : ir.CompilerIrInstr
              (lower-call-target-instr
                allocated
                target
                false
                var-id
                (lower-call-args-with-nominal-sret
                  ctx
                  sret-values
                  (lower-global-shared-view result-ty))
                result-ir-ty)]
            (Ok
              (Expr
                (lower-state-emit-at-expr ctx allocated instr origin)
                (Var var-id)
                result-ty)))])]
    [(Err message) (Err message)]))

(define (lower-indirect-call-args
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [func-ty : ast.AstType]) : ResultLowerArgs
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx func-ty))
    [(Func param-types _)
      (lower-args-as
        ctx
        state
        env
        type-env
        args
        (tc_core.tc-resolve-type-list ctx (deref param-types)))]
    [_ (lower-args ctx state env type-env args)]))

(define (lower-indirect-call-args-with-writebacks
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [func-ty : ast.AstType]) : ResultLowerCallArgs
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx func-ty))
    [(Func param-types _)
      (lower-call-args-as-needed
        ctx
        state
        env
        type-env
        args
        (tc_core.tc-resolve-type-list ctx (deref param-types)))]
    [_
      (match (lower-args ctx state env type-env args)
        [(Ok args-state values) (Ok args-state values (None))]
        [(Err message) (Err message)])]))

(define (lower-indirect-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func-ty : ast.AstType]
  [func-value : ir.CompilerIrValue]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (lower-c-function-type? (lower-global-shared-view func-ty))
    (lower-indirect-c-abi-call
      ctx
      state
      env
      type-env
      func-ty
      func-value
      args
      result-ty
      origin)
    (match (lower-indirect-call-args-with-writebacks
      ctx
      state
      env
      type-env
      args
      (lower-global-shared-view func-ty))
      [(Ok args-state values writebacks)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx func-ty))
          [(Func param-types _)
            (let
              [lowered
                (try
                  (lower-internal-call-values
                    ctx
                    args-state
                    (Indirect func-value)
                    values
                    (tc_core.tc-resolve-type-list ctx (deref param-types))
                    result-ty
                    origin))]
              (match lowered
                [(Expr call-state call-value call-ty)
                  (Ok
                    (Expr
                      (lower-apply-arg-writebacks ctx call-state writebacks)
                      call-value
                      call-ty))]))]
          [_
            (let
              [lowered
                (try
                  (lower-call-values
                    ctx
                    args-state
                    (Indirect func-value)
                    values
                    result-ty
                    origin))]
              (match lowered
                [(Expr call-state call-value call-ty)
                  (Ok
                    (Expr
                      (lower-apply-arg-writebacks ctx call-state writebacks)
                      call-value
                      call-ty))]))])]
      [(Err message) (Err message)])))

(define (lower-indirect-c-abi-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func-ty : ast.AstType]
  [func-value : ir.CompilerIrValue]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view func-ty)))
    [(CFunc signature _)
      (let
        [signature-type : ast.AstType
          (tc_core.tc-context-type-get ctx signature)]
        (match (lower-global-shared-view signature-type)
          [(Func _ _)
            (lower-indirect-c-abi-call
              ctx
              state
              env
              type-env
              signature-type
              func-value
              args
              result-ty
              origin)]
          [_
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  "lower: invalid C function signature")))]))]
    [(Func param-types _)
      (match (lower-c-abi-args-as
        ctx
        state
        env
        type-env
        args
        (tc_core.tc-resolve-type-list ctx (deref param-types)))
        [(Ok args-state values)
          (lower-c-abi-call-values
            ctx
            args-state
            (Indirect func-value)
            values
            result-ty
            origin)]
        [(Err message) (Err message)])]
    [_
      (lower-indirect-call
        ctx
        state
        env
        type-env
        func-ty
        func-value
        args
        result-ty
        origin)]))

(define (lower-substring-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 3)
    (let
      [str : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [start : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [len : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 2 0))]
      (lower-substring ctx state env type-env str start len))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-string-concat-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 2)
    (lower-string-concat
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-string-runtime-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (or (string.eq name "substring") (string.eq name "string-slice"))
    (lower-substring-call
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)
    (lower-string-concat-call
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-runtime-call-values
  [state : LowerState]
  [name : i64]
  [values : ir.CompilerIrValueSeq]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Ok
        (Expr
          (lower-state-emit
            allocated
            (Call
              var-id
              name
              (ir.compiler-ir-call-args-from-seq values)
              (lower-global-shared-view result-ty)))
          (Var var-id)
          result-ty))]))

(define (lower-inline-string-eq-finish
  [state : LowerState]
  [_true-label : i64]
  [false-label : i64]
  [done-label : i64]
  [result-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (let
    [false-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-state-emit state (Mov result-var (Bool true) (Bool)))
          (Jump done-label))
        false-label)]
    [done-start : LowerState
      (lower-state-finish-block
        (lower-state-emit false-start (Jump done-label))
        done-label)]
    (Expr done-start (Var result-var) result-ty)))

(define (lower-inline-string-eq-body
  [state : LowerState]
  [header-label : i64]
  [true-label : i64]
  [false-label : i64]
  [done-label : i64]
  [result-var : i64]
  [index-var : i64]
  [left-ptr : ir.CompilerIrValue]
  [right-ptr : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-gep state left-ptr (Var index-var) (U8))
    [(Expr left-gep-state left-addr _)
      (match (lower-emit-load left-gep-state left-addr (U8))
        [(Expr left-load-state left-byte _)
          (match (lower-emit-gep left-load-state right-ptr (Var index-var) (U8))
            [(Expr right-gep-state right-addr _)
              (match (lower-emit-load right-gep-state right-addr (U8))
                [(Expr right-load-state right-byte _)
                  (match (lower-emit-cast right-load-state left-byte (U8) (I64))
                    [(Expr left-cast-state left-i64 _)
                      (match (lower-emit-cast
                        left-cast-state
                        right-byte
                        (U8)
                        (I64))
                        [(Expr right-cast-state right-i64 _)
                          (match (lower-emit-binop
                            right-cast-state
                            Eq
                            left-i64
                            right-i64
                            (I64))
                            [(Expr byte-eq-state byte-eq _)
                              (match (lower-emit-binop
                                byte-eq-state
                                Add
                                (Var index-var)
                                (I64 1)
                                (I64))
                                [(Expr inc-state next-index _)
                                  (lower-inline-string-eq-finish
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        (lower-state-emit
                                          inc-state
                                          (Mov index-var next-index (I64)))
                                        (Branch
                                          byte-eq
                                          header-label
                                          false-label))
                                      true-label)
                                    true-label
                                    false-label
                                    done-label
                                    result-var
                                    result-ty)])])])])])])])]))

(define (lower-inline-string-eq-fields
  [state : LowerState]
  [left-ptr : ir.CompilerIrValue]
  [left-len : ir.CompilerIrValue]
  [right-ptr : ir.CompilerIrValue]
  [right-len : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-state-fresh-label state "string_eq_header")
    [(Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "string_eq_body")
        [(Label body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "string_eq_true")
            [(Label true-label-state true-label)
              (match (lower-state-fresh-label
                true-label-state
                "string_eq_false")
                [(Label false-label-state false-label)
                  (match (lower-state-fresh-label
                    false-label-state
                    "string_eq_done")
                    [(Label done-label-state done-label)
                      (match (lower-state-alloc-var done-label-state)
                        [(Alloc result-alloc result-var)
                          (match (lower-state-alloc-var result-alloc)
                            [(Alloc index-alloc index-var)
                              (match (lower-emit-binop
                                (lower-state-emit
                                  (lower-state-emit
                                    index-alloc
                                    (Mov result-var (Bool false) (Bool)))
                                  (Mov index-var (I64 0) (I64)))
                                Eq
                                (lower-global-shared-view left-len)
                                right-len
                                (I64))
                                [(Expr len-state len-ok _)
                                  (let
                                    [header-start : LowerState
                                      (lower-state-finish-block
                                        (lower-state-emit
                                          len-state
                                          (Branch
                                            len-ok
                                            header-label
                                            false-label))
                                        header-label)]
                                    (match (lower-emit-binop
                                      header-start
                                      Lt
                                      (Var index-var)
                                      left-len
                                      (I64))
                                      [(Expr cond-state cond-value _)
                                        (lower-inline-string-eq-body
                                          (lower-state-finish-block
                                            (lower-state-emit
                                              cond-state
                                              (Branch
                                                cond-value
                                                body-label
                                                true-label))
                                            body-label)
                                          header-label
                                          true-label
                                          false-label
                                          done-label
                                          result-var
                                          index-var
                                          left-ptr
                                          right-ptr
                                          result-ty)]))])])])])])])])]))

(define (lower-inline-string-to-int-negate
  [state : LowerState]
  [negate-label : i64]
  [done-label : i64]
  [value-var : i64]
  [negative-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (let
    [negate-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          state
          (Branch (Var negative-var) negate-label done-label))
        negate-label)]
    (match (lower-emit-binop negate-start Sub (I64 0) (Var value-var) (I64))
      [(Expr neg-state neg-value _)
        (let
          [done-start : LowerState
            (lower-state-finish-block
              (lower-state-emit
                (lower-state-emit neg-state (Mov value-var neg-value (I64)))
                (Jump done-label))
              done-label)]
          (Expr done-start (Var value-var) result-ty))])))

(define (lower-inline-string-to-int-body
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [header-label : i64]
  [apply-label : i64]
  [negate-label : i64]
  [done-label : i64]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-gep state ptr (Var index-var) (U8))
    [(Expr byte-gep-state byte-addr _)
      (match (lower-emit-load byte-gep-state byte-addr (U8))
        [(Expr byte-load-state byte-value _)
          (match (lower-emit-cast byte-load-state byte-value (U8) (I64))
            [(Expr byte-cast-state byte-i64 _)
              (match (lower-emit-binop
                byte-cast-state
                Sub
                byte-i64
                (I64 48)
                (I64))
                [(Expr digit-state digit _)
                  (match (lower-emit-binop
                    digit-state
                    Mul
                    (Var value-var)
                    (I64 10)
                    (I64))
                    [(Expr scaled-state scaled _)
                      (match (lower-emit-binop
                        scaled-state
                        Add
                        scaled
                        digit
                        (I64))
                        [(Expr next-state next-value _)
                          (match (lower-emit-binop
                            next-state
                            Add
                            (Var index-var)
                            (I64 1)
                            (I64))
                            [(Expr inc-state next-index _)
                              (lower-inline-string-to-int-negate
                                (lower-state-finish-block
                                  (lower-state-emit
                                    (lower-state-emit
                                      (lower-state-emit
                                        inc-state
                                        (Mov value-var next-value (I64)))
                                      (Mov index-var next-index (I64)))
                                    (Jump header-label))
                                  apply-label)
                                negate-label
                                done-label
                                value-var
                                negative-var
                                result-ty)])])])])])])]))

(define (lower-inline-string-to-int-loop
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [body-label : i64]
  [apply-label : i64]
  [header-label : i64]
  [negate-label : i64]
  [done-label : i64]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-binop state Lt (Var index-var) len (I64))
    [(Expr cond-state cond-value _)
      (lower-inline-string-to-int-body
        (lower-state-finish-block
          (lower-state-emit
            cond-state
            (Branch cond-value body-label apply-label))
          body-label)
        ptr
        header-label
        apply-label
        negate-label
        done-label
        value-var
        index-var
        negative-var
        result-ty)]))

(define (lower-inline-string-to-int-sign
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [minus-label : i64]
  [header-label : i64]
  [body-label : i64]
  [apply-label : i64]
  [negate-label : i64]
  [done-label : i64]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-gep state (lower-global-shared-view ptr) (I64 0) (U8))
    [(Expr first-gep-state first-addr _)
      (match (lower-emit-load first-gep-state first-addr (U8))
        [(Expr first-load-state first-byte _)
          (match (lower-emit-cast first-load-state first-byte (U8) (I64))
            [(Expr first-cast-state first-i64 _)
              (match (lower-emit-binop
                first-cast-state
                Eq
                first-i64
                (I64 45)
                (I64))
                [(Expr minus-test-state minus? _)
                  (let
                    [minus-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          minus-test-state
                          (Branch minus? minus-label header-label))
                        minus-label)]
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            (lower-state-emit
                              minus-start
                              (Mov negative-var (Bool true) (Bool)))
                            (Mov index-var (I64 1) (I64)))
                          (Jump header-label))
                        header-label)]
                    (lower-inline-string-to-int-loop
                      header-start
                      ptr
                      len
                      body-label
                      apply-label
                      header-label
                      negate-label
                      done-label
                      value-var
                      index-var
                      negative-var
                      result-ty))])])])]))

(define (lower-inline-string-to-int-fields
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [result-ty : ast.AstType]) : LowerExpr
  (match (lower-state-fresh-label state "string_to_int_sign")
    [(Label sign-label-state sign-label)
      (match (lower-state-fresh-label sign-label-state "string_to_int_minus")
        [(Label minus-label-state minus-label)
          (match (lower-state-fresh-label
            minus-label-state
            "string_to_int_header")
            [(Label header-label-state header-label)
              (match (lower-state-fresh-label
                header-label-state
                "string_to_int_body")
                [(Label body-label-state body-label)
                  (match (lower-state-fresh-label
                    body-label-state
                    "string_to_int_apply_sign")
                    [(Label apply-label-state apply-label)
                      (match (lower-state-fresh-label
                        apply-label-state
                        "string_to_int_negate")
                        [(Label negate-label-state negate-label)
                          (match (lower-state-fresh-label
                            negate-label-state
                            "string_to_int_done")
                            [(Label done-label-state done-label)
                              (match (lower-state-alloc-var done-label-state)
                                [(Alloc value-alloc value-var)
                                  (match (lower-state-alloc-var value-alloc)
                                    [(Alloc index-alloc index-var)
                                      (match (lower-state-alloc-var index-alloc)
                                        [(Alloc negative-alloc negative-var)
                                          (match (lower-emit-binop
                                            (lower-state-emit
                                              (lower-state-emit
                                                (lower-state-emit
                                                  negative-alloc
                                                  (Mov value-var (I64 0) (I64)))
                                                (Mov index-var (I64 0) (I64)))
                                              (Mov
                                                negative-var
                                                (Bool false)
                                                (Bool)))
                                            Gt
                                            (lower-global-shared-view len)
                                            (I64 0)
                                            (I64))
                                            [(Expr nonempty-state nonempty _)
                                              (lower-inline-string-to-int-sign
                                                (lower-state-finish-block
                                                  (lower-state-emit
                                                    nonempty-state
                                                    (Branch
                                                      nonempty
                                                      sign-label
                                                      done-label))
                                                  sign-label)
                                                ptr
                                                len
                                                minus-label
                                                header-label
                                                body-label
                                                apply-label
                                                negate-label
                                                done-label
                                                value-var
                                                index-var
                                                negative-var
                                                result-ty)])])])])])])])])])])]))

(define (lower-string-to-int-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [lowered
        (try (lower-expr ctx state env type-env (lower-global-shared-view arg)))]
      (match lowered
        [(Expr arg-state arg-value arg-ty)
          (if (lower-string-handle-type? ctx arg-ty)
            (match (lower-string-fields arg-state arg-value)
              [(Fields fields-state ptr len)
                (Ok
                  (lower-inline-string-to-int-fields
                    fields-state
                    ptr
                    len
                    result-ty))])
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  arg
                  "lower: string.>int requires String"))))]))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      cbi.compiler-builtin-id-tl-private-string-to-int
      "__tl_string_to_int"
      args
      result-ty
      origin)))

(define (lower-string-eq-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 2)
    (let
      [left : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [right : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [lowered-left (try (lower-expr ctx state env type-env left))]
      (match lowered-left
        [(Expr left-state left-value _)
          (let
            [lowered-right (try (lower-expr ctx left-state env type-env right))]
            (match lowered-right
              [(Expr right-state right-value _)
                (match (lower-string-fields right-state left-value)
                  [(Fields left-fields-state left-ptr left-len)
                    (match (lower-string-fields left-fields-state right-value)
                      [(Fields done-fields-state right-ptr right-len)
                        (Ok
                          (lower-inline-string-eq-fields
                            done-fields-state
                            left-ptr
                            left-len
                            right-ptr
                            right-len
                            result-ty))])])]))]))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      cbi.compiler-builtin-id-tl-private-string-eq
      "__tl_string_eq"
      args
      result-ty
      origin)))

(define (lower-bootstrap-runtime-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (lower-string-eq-helper-call-id?
    ctx
    env
    state
    type-env
    source-id
    source-id)
    (lower-string-eq-call ctx state env type-env args result-ty origin)
    (if (lower-private-string-to-int-helper-call-id? ctx type-env source-id)
      (lower-string-to-int-call ctx state env type-env args result-ty origin)
      (lower-direct-call-id
        ctx
        state
        env
        type-env
        source-id
        name
        args
        result-ty
        origin))))

;; The spellings typecheck types as the `__tl_string_eq` builtin
;; (`tc-string-eq-helper-call-id?`, asked through the visibility test it is
;; built from): the private intrinsic where it is available, and bare `eq`,
;; `string-eq` and `string=?` where stdlib.string's helpers are visible and
;; user code does not shadow them. A qualified `string.eq` stays an ordinary
;; call of stdlib.string's `eq`.
(define (lower-string-eq-helper-call-id?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name-id : i64]) : bool
  (or
    (and
      (cbi.compiler-builtin-typecheck-string-eq-id? name-id)
      (lower-top-level-builtin-available-id? ctx type-env name-id))
    (and
      (cond
        [(= source-id cbi.compiler-builtin-id-eq)
          (tc_core.tc-stdlib-string-helper-visible-or-wrapper-id?
            ctx
            type-env
            source-id
            true
            name-id
            cbi.compiler-builtin-id-eq
            "eq")]
        [(= source-id cbi.compiler-builtin-id-string-eq-question)
          (tc_core.tc-stdlib-string-helper-visible-or-wrapper-id?
            ctx
            type-env
            source-id
            true
            name-id
            cbi.compiler-builtin-id-string-eq-question
            "string=?")]
        [(= source-id cbi.compiler-builtin-id-string-eq)
          (tc_core.tc-stdlib-string-helper-visible-or-wrapper-id?
            ctx
            type-env
            source-id
            true
            name-id
            cbi.compiler-builtin-id-string-eq
            "string-eq")]
        [else false])
      (lower-stdlib-string-helper-unshadowed-id? ctx env state name-id))))

(define (lower-private-string-to-int-helper-call-id?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : bool
  (and
    (cbi.compiler-builtin-typecheck-string-to-int-id? name-id)
    (lower-top-level-builtin-available-id? ctx type-env name-id)))

;; Lower an unshadowed `(__tl_string_ref s i)` intrinsic call to the
;; bounds-checked String byte index, like the parser-owned `AstExpr.StringRef`
;; node.
(define (lower-string-ref-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 2)
    (let
      [str : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [index : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      (lower-string-ref ctx state env type-env str index origin))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-module-lookup-name [ctx : tc_core.TcContext] [name : String]) : String
  (let
    [module : String (tc_core.tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc_core.tc-name-qualified? name)))
      (csym.compiler-symbol-module-key module name)
      name)))

(define (lower-call-name-matches-nominal?
  [ctx : tc_core.TcContext]
  [name : (& name str)]
  [nominal-name : String]) : bool
  (if (tc_core.tc-name-qualified? name)
    (string.eq name nominal-name)
    (and
      (string.eq
        (tc_core.tc-qualified-name-module
          (lower-global-shared-view nominal-name))
        (tc_core.tc-context-module ctx))
      (string.eq name (tc_core.tc-qualified-name-base nominal-name)))))

(define (lower-variant-constructor-lookup-name
  [ctx : tc_core.TcContext]
  [name : String]
  [name-id : i64]
  [result-ty : ast.AstType]) : String
  (let
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        (tc_core.tc-context-structural-session ctx)
        name-id
        name-id)]
    (match (tc_core.tc-type-strip-region result-ty)
      [(Enum enum-name)
        (let
          [enum-name-str : String
            (tc_core.tc-nominal-name-id-display enum-name)]
          (if (or
            (tc_core.tc-name-qualified? name)
            (string.eq
              (tc_core.tc-qualified-name-module
                (lower-global-shared-view enum-name-str))
              (tc_core.tc-context-module ctx)))
            (tc_core.tc-source-variant-name-for-enum-id
              ctx
              enum-name-str
              name
              source-id)
            (lower-module-lookup-name ctx name)))]
      [(EnumArgs enum-name _)
        (let
          [enum-name-str : String
            (tc_core.tc-nominal-name-id-display enum-name)]
          (if (or
            (tc_core.tc-name-qualified? name)
            (string.eq
              (tc_core.tc-qualified-name-module
                (lower-global-shared-view enum-name-str))
              (tc_core.tc-context-module ctx)))
            (tc_core.tc-source-variant-name-for-enum-id
              ctx
              enum-name-str
              name
              source-id)
            (lower-module-lookup-name ctx name)))]
      [_ ""])))

(define (lower-variant-constructor-handle-id-or
  [ctx : tc_core.TcContext]
  [_ : String]
  [raw-name-id : i64]
  [result-ty : ast.AstType]
  [fallback : i64]) : i64
  (let
    [source-name-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or
        (tc_core.tc-context-structural-session ctx)
        raw-name-id
        raw-name-id)]
    [source-key-id : i64
      (csym.compiler-symbol-dotted-variant-key-id-in-module-or
        source-name-id
        (tc_core.tc-context-module-id ctx)
        -1)]
    [source-handle : i64
      (if (>= source-key-id 0)
        (csym.compiler-registries-lookup-variant-key-id-or
          (tc_core.tc-context-registries ctx)
          source-key-id
          fallback)
        fallback)]
    [enum-name-id : i64
      (match (tc_core.tc-type-strip-region result-ty)
        [(Enum name) name]
        [(EnumArgs name _) name]
        [_ -1])]
    [variant-name-id : i64
      (if (and
        (>= source-name-id 0)
        (<
          source-name-id
          (ci.intern-source-name-session-handle-capacity
            (tc_core.tc-context-source-names ctx))))
        (ci.intern-source-name-session-handle-dotted-final-id
          (tc_core.tc-context-source-names ctx)
          (if (ci.intern-source-name-session-handle-qualified?
            (tc_core.tc-context-source-names ctx)
            source-name-id)
            (ci.intern-source-name-session-handle-qualified-base-id
              (tc_core.tc-context-source-names ctx)
              source-name-id)
            source-name-id))
        -1)]
    [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
    [direct-variant-handle : i64
      (csym.compiler-registries-lookup-variant-id-or
        (tc_core.tc-context-registries ctx)
        source-name-id
        fallback)]
    [direct-variant-owner-index : i64
      (if (csym.compiler-symbols-handle-found? direct-variant-handle)
        (csym.compiler-registry-handle-owner-index direct-variant-handle)
        -1)]
    [direct-variant-owner-id : i64
      (csym.compiler-symbols-owner-id-at-index-or
        symbols
        direct-variant-owner-index
        -1)]
    [direct-variant-module-id : i64
      (csym.compiler-symbols-owner-module-id-at-index-or
        symbols
        direct-variant-owner-index
        -1)]
    [direct-variant-owner-matches : bool
      (and
        (csym.compiler-symbols-handle-found? direct-variant-handle)
        (or
          (=
            direct-variant-owner-id
            (csym.compiler-symbol-name-id-key enum-name-id))
          (tc_core.tc-current-module-owner-name-matches-id?
            (tc_core.tc-context-structural-session ctx)
            enum-name-id
            direct-variant-owner-id))
        (if (csym.compiler-composite-pair-key-id? enum-name-id)
          (=
            direct-variant-module-id
            (csym.compiler-composite-pair-left-id enum-name-id))
          (if (tc_core.tc-name-qualified-id?
            (tc_core.tc-context-structural-session ctx)
            enum-name-id)
            (=
              direct-variant-module-id
              (tc_core.tc-qualified-name-module-id enum-name-id))
            true)))]
    (cond
      [direct-variant-owner-matches direct-variant-handle]
      [(csym.compiler-symbols-handle-found? source-handle) source-handle]
      [(and (>= enum-name-id 0) (>= variant-name-id 0))
        (let
          [direct-enum-handle : i64
            (csym.compiler-symbols-lookup-type-id-or
              symbols
              enum-name-id
              fallback)]
          [enum-base-id : i64
            (if (>= enum-name-id 0)
              (tc_core.tc-qualified-name-base-id enum-name-id)
              -1)]
          [enum-handle : i64
            (cond
              [(csym.compiler-symbols-handle-found? direct-enum-handle)
                direct-enum-handle]
              [(>= enum-base-id 0)
                (csym.compiler-symbols-lookup-type-id-or
                  symbols
                  (csym.compiler-symbol-module-key-id-by-id
                    (tc_core.tc-context-module-id ctx)
                    enum-base-id)
                  fallback)]
              [else fallback])]
          (if (csym.compiler-symbols-handle-found? enum-handle)
            (let
              [enum-index : i64 (csym.compiler-symbol-handle-index enum-handle)]
              [module-id : i64
                (csym.compiler-symbols-owner-module-id-at-index-or
                  symbols
                  enum-index
                  (csym.compiler-symbol-root-module-id))]
              [key-id : i64
                (csym.compiler-symbol-module-key-id-by-id
                  module-id
                  (csym.compiler-enum-qualified-variant-name-id
                    enum-base-id
                    variant-name-id))]
              (csym.compiler-registries-lookup-variant-key-id-or
                (tc_core.tc-context-registries ctx)
                key-id
                fallback))
            fallback))]
      [else fallback])))

(define (lower-value-define-or-direct-call-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (lower-top-level-value-define-lookup-id? ctx lookup-name-id)
    ;; A top-level value cell remains mutable through `set!`. Even when its
    ;; declared type is callable, the symbol names DATA holding the current
    ;; callable value. Lower the variable read first so calls observe the latest
    ;; stored value; indirect dispatch selects C code or a closure from its type.
    (match (lower-lookup-type-id
      ctx
      (lower-state-type-cache state)
      env
      type-env
      lookup-name-id)
      [(Ok fn-ty)
        (let
          [lowered-func
            (try
              (lower-var-or-nullary-variant-id
                ctx
                state
                env
                type-env
                raw-name-id
                (lower-global-shared-view fn-ty)))]
          (match lowered-func
            [(Expr func-state func-value _)
              (lower-indirect-call
                ctx
                func-state
                env
                type-env
                fn-ty
                func-value
                args
                result-ty
                origin)]))]
      [(Err message) (Err (box (lower-diagnostic-at-expr ctx origin message)))])
    (lower-direct-call-id-with-lookup-id
      ctx
      state
      env
      type-env
      raw-name-id
      lookup-name-id
      name
      args
      result-ty
      origin)))

(define (lower-call-non-builtin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [resolved-name-id : i64 raw-name-id]
    (if (and
      (>= resolved-name-id 0)
      (sym_i64_env.sym-i64-contains-id env resolved-name-id))
      (lower-direct-call-id
        ctx
        state
        env
        type-env
        resolved-name-id
        name
        args
        result-ty
        origin)
      (let
        [source-name : String
          (lower-hygiene-source-name (lower-global-shared-view name))]
        [callable-lookup-id : i64
          (lower-callable-lookup-id ctx raw-name-id lookup-name-id)]
        [function-value : bool
          (lower-top-level-callable-lookup-id? ctx callable-lookup-id)]
        [variant-name : String
          (lower-variant-constructor-lookup-name
            ctx
            (lower-global-shared-view source-name)
            raw-name-id
            (lower-global-shared-view result-ty))]
        [struct-name : String
          (match (tc_core.tc-type-strip-region
            (lower-global-shared-view result-ty))
            [(Struct resolved-struct)
              (if (lower-call-name-matches-nominal?
                ctx
                source-name
                (tc_core.tc-nominal-name-id-display resolved-struct))
                (tc_core.tc-nominal-name-id-display resolved-struct)
                (lower-module-lookup-name
                  ctx
                  (lower-global-shared-view source-name)))]
            [(StructArgs resolved-struct _)
              (if (lower-call-name-matches-nominal?
                ctx
                source-name
                (tc_core.tc-nominal-name-id-display resolved-struct))
                (tc_core.tc-nominal-name-id-display resolved-struct)
                (lower-module-lookup-name
                  ctx
                  (lower-global-shared-view source-name)))]
            [_
              (lower-module-lookup-name
                ctx
                (lower-global-shared-view source-name))])]
        [variant-handle : i64
          (lower-variant-constructor-handle-id-or
            ctx
            source-name
            raw-name-id
            (lower-global-shared-view result-ty)
            (csym.compiler-symbols-missing-handle))]
        [struct-handle : i64
          (lower-struct-constructor-handle-id-or
            ctx
            state
            raw-name-id
            callable-lookup-id
            (lower-global-shared-view result-ty)
            (csym.compiler-symbols-missing-handle))]
        (if (and
          (not function-value)
          (csym.compiler-symbols-handle-found? variant-handle))
          (lower-construct-enum-with-handle
            ctx
            state
            env
            type-env
            variant-name
            variant-handle
            args
            result-ty)
          (if (and
            (or
              (tc_core.tc-constructor-source-name-id? ctx raw-name-id)
              (tc_core.tc-constructor-source-name-id? ctx callable-lookup-id))
            (csym.compiler-symbols-handle-found? struct-handle)
            (=
              (csym.compiler-symbol-handle-kind struct-handle)
              (csym.compiler-symbol-kind-defstruct)))
            (lower-construct-struct
              ctx
              state
              env
              type-env
              struct-name
              struct-handle
              args
              result-ty)
            (lower-value-define-or-direct-call-id
              ctx
              state
              env
              type-env
              name
              raw-name-id
              callable-lookup-id
              args
              result-ty
              origin)))))))

(define (lower-direct-store-target?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (and
    (lower-type-inline-struct-or-enum? ctx (lower-global-shared-view ty))
    (not (lower-type-register-resident? ctx ty))))

(define (lower-direct-store-result [result : ResultLowerState]) : LowerMaybeDirectStore
  (match result
    [(Ok done-state) (Store done-state)]
    [(Err message) (Err message)]))

(define (lower-direct-constructor-call-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [name : String]
  [raw-name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [_origin : ast.AstExpr]) : LowerMaybeDirectStore
  (if (sym_i64_env.sym-i64-contains-id env raw-name-id)
    (No)
    (let
      [source-name : String
        (lower-hygiene-source-name (lower-global-shared-view name))]
      [lookup-name-id : i64
        (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
          ctx
          type-env
          name
          raw-name-id
          true)
          [(Ok _ resolved-id) resolved-id]
          [(Err _) raw-name-id])]
      [callable-lookup-id : i64
        (lower-callable-lookup-id ctx raw-name-id lookup-name-id)]
      [function-value : bool
        (lower-top-level-callable-lookup-id? ctx callable-lookup-id)]
      [variant-name : String
        (lower-variant-constructor-lookup-name
          ctx
          (lower-global-shared-view source-name)
          raw-name-id
          (lower-global-shared-view result-ty))]
      [struct-name : String
        (match (tc_core.tc-type-strip-region
          (lower-global-shared-view result-ty))
          [(Struct resolved-struct)
            (if (lower-call-name-matches-nominal?
              ctx
              source-name
              (tc_core.tc-nominal-name-id-display resolved-struct))
              (tc_core.tc-nominal-name-id-display resolved-struct)
              (lower-module-lookup-name
                ctx
                (lower-global-shared-view source-name)))]
          [(StructArgs resolved-struct _)
            (if (lower-call-name-matches-nominal?
              ctx
              source-name
              (tc_core.tc-nominal-name-id-display resolved-struct))
              (tc_core.tc-nominal-name-id-display resolved-struct)
              (lower-module-lookup-name
                ctx
                (lower-global-shared-view source-name)))]
          [_
            (lower-module-lookup-name
              ctx
              (lower-global-shared-view source-name))])]
      [variant-handle : i64
        (lower-variant-constructor-handle-id-or
          ctx
          source-name
          raw-name-id
          (lower-global-shared-view result-ty)
          (csym.compiler-symbols-missing-handle))]
      [struct-handle : i64
        (lower-struct-constructor-handle-id-or
          ctx
          state
          raw-name-id
          callable-lookup-id
          (lower-global-shared-view result-ty)
          (csym.compiler-symbols-missing-handle))]
      (if (and
        (not function-value)
        (csym.compiler-symbols-handle-found? variant-handle))
        (lower-direct-store-result
          (lower-construct-enum-with-handle-into
            ctx
            state
            env
            type-env
            dst
            variant-name
            variant-handle
            args
            result-ty))
        (if (and
          (or
            (tc_core.tc-constructor-source-name-id? ctx raw-name-id)
            (tc_core.tc-constructor-source-name-id? ctx callable-lookup-id))
          (csym.compiler-symbols-handle-found? struct-handle)
          (=
            (csym.compiler-symbol-handle-kind struct-handle)
            (csym.compiler-symbol-kind-defstruct)))
          (lower-direct-store-result
            (lower-construct-struct-into
              ctx
              state
              env
              type-env
              dst
              struct-name
              struct-handle
              args
              result-ty))
          (No))))))

(define (lower-direct-nullary-variant-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [name : String]
  [raw-name-id : i64]
  [result-ty : ast.AstType]) : LowerMaybeDirectStore
  (if (sym_i64_env.sym-i64-contains-id env raw-name-id)
    (No)
    (let
      [source-name : String (lower-hygiene-source-name name)]
      [symbols : (& ctx csym.CompilerSymbols) (tc_core.tc-context-symbols ctx)]
      [function-value : bool
        (or
          (lower-top-level-callable-defined-id? ctx raw-name-id)
          (lower-symbol-function-value-id? ctx raw-name-id))]
      [variant-name : String
        (lower-variant-constructor-lookup-name
          ctx
          (lower-global-shared-view source-name)
          raw-name-id
          (lower-global-shared-view result-ty))]
      [handle : i64
        (lower-variant-constructor-handle-id-or
          ctx
          source-name
          raw-name-id
          (lower-global-shared-view result-ty)
          (csym.compiler-symbols-missing-handle))]
      (if (and
        (not function-value)
        (csym.compiler-symbols-handle-found? handle))
        (match (csym.compiler-registries-variant-fields-indexed symbols handle)
          [(Ok fields)
            (if (ast.ast-type-list-empty? (& fields))
              (lower-direct-store-result
                (lower-construct-enum-with-handle-into
                  ctx
                  state
                  env
                  type-env
                  dst
                  variant-name
                  handle
                  (ast.ast-expr-list-new)
                  result-ty))
              (No))]
          [(Err message) (Err (box (lower-diagnostic message)))])
        (No)))))

(define (lower-direct-init-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [maybe-ty : ast.AstMaybeType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeDirectStore
  (match maybe-ty
    [(No)
      (lower-direct-store-result
        (lower-init-expr-into ctx state env type-env dst result-ty origin))]
    [(Some ty)
      (let
        [resolved-init : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx (lower-global-shared-view ty)))]
        [resolved-result : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx result-ty))]
        (if (tc_core.tc-type-eq resolved-init resolved-result)
          (lower-direct-store-result
            (lower-init-expr-into ctx state env type-env dst ty origin))
          (No)))]))

(define (lower-direct-store-rhs-into
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [value : ast.AstExpr]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeDirectStore
  (if (lower-direct-store-target? ctx (lower-global-shared-view result-ty))
    (match value
      [(Spanned inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-direct-store-rhs-into
            ctx
            state
            env
            type-env
            dst
            inner
            result-ty
            origin))]
      [(Ann inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-direct-store-rhs-into
            ctx
            state
            env
            type-env
            dst
            inner
            result-ty
            origin))]
      [(Init maybe-ty-id)
        (lower-direct-init-into
          ctx
          state
          env
          type-env
          dst
          (ast.ast-maybe-type-from-id-with-pools
            (tc_core.tc-context-pools ctx)
            maybe-ty-id)
          result-ty
          origin)]
      [(Call func-box args)
        (let
          [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
          (match (ast.ast-expr-unspan func)
            [(Var name)
              (lower-direct-constructor-call-into
                ctx
                state
                env
                type-env
                dst
                (lower-context-intern-str
                  ctx
                  (tc_core.macro-hygiene-global-source-name-id-or
                    (tc_core.tc-context-structural-session ctx)
                    name
                    name))
                name
                args
                result-ty
                origin)]
            [_ (No)]))]
      [(Var name)
        (if (tc_core.tc-dotted-local-field-name-id? type-env name)
          (No)
          (lower-direct-nullary-variant-into
            ctx
            state
            env
            type-env
            dst
            (lower-context-intern-str
              ctx
              (tc_core.macro-hygiene-global-source-name-id-or
                (tc_core.tc-context-structural-session ctx)
                name
                name))
            name
            result-ty))]
      [_ (No)])
    (No)))

(define (lower-direct-store-rhs-at-offset
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [value : ast.AstExpr]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeDirectStore
  (if (lower-direct-store-target? ctx (lower-global-shared-view result-ty))
    (if (= offset 0)
      (lower-direct-store-rhs-into
        ctx
        state
        env
        type-env
        base
        value
        result-ty
        origin)
      (match (lower-gep-byte state base offset)
        [(Expr ptr-state ptr _)
          (lower-direct-store-rhs-into
            ctx
            ptr-state
            env
            type-env
            ptr
            value
            result-ty
            origin)]))
    (No)))

(define (lower-spmd-scalar-arg-varying?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [arg : ast.AstExpr]) : bool
  (>
    (let
      [mode (CompilerLowerMode.Avx512)]
      [lane-locals (lower-masked-vector-empty-lane-locals)]
      (lower-masked-vector-expr-lanes-with-locals
        ctx
        function-state
        mode
        env
        type-env
        index
        lane-locals
        arg))
    0))

(define (lower-spmd-call-args-from-values
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstParamList)]
  [values : ir.CompilerIrValueSeq]) : ir.CompilerIrSpmdCallArgSeq
  (let
    [builder : ir.CompilerIrSpmdCallArgBuilder
      (ir.compiler-ir-spmd-call-arg-builder-with-capacity
        (ast.ast-param-list-len (& params)))]
    (lower-spmd-call-args-from-values-at
      ctx
      function-state
      env
      type-env
      index
      (& args)
      (& params)
      values
      0
      (&mut builder))
    (ir.compiler-ir-spmd-call-arg-builder-to-seq builder)))

(define (lower-spmd-call-args-from-values-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstParamList)]
  [values : ir.CompilerIrValueSeq]
  [arg-index : i64]
  [builder : (&mut builder ir.CompilerIrSpmdCallArgBuilder)]) : unit
  (if (or
    (>= arg-index args.len)
    (>= arg-index (ast.ast-param-list-len params))
    (>= arg-index values.len))
    unit
    (match (ast.ast-param-list-get params arg-index (ast.ast-param-fallback))
      [(Param _ param-ty _)
        (let
          [resolved-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx param-ty))]
          [arg : ast.AstExpr
            (lower-context-expr-get
              ctx
              (ast.ast-expr-list-get args arg-index 0))]
          [varying : bool
            (lower-spmd-scalar-arg-varying?
              ctx
              function-state
              env
              type-env
              (lower-global-shared-view index)
              arg)]
          (ir.compiler-ir-spmd-call-arg-builder-push!
            builder
            (ir.CompilerIrSpmdCallArg.Arg
              (lower-spmd-ir-value-class
                (lower-global-shared-view resolved-ty)
                varying)
              (ir.compiler-ir-value-seq-ref values arg-index)
              resolved-ty))
          (lower-spmd-call-args-from-values-at
            ctx
            function-state
            env
            type-env
            index
            args
            params
            values
            (+ arg-index 1)
            builder))])))

(define (lower-imported-spmd-scalar-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [owner : String]
  [version : String]
  [canonical-name : ci.InternId]
  [fn-ty : ast.AstType]
  [callables : ast.AstImportedSpmdCallableList]
  [args : (& args ast.AstExprList)]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeSpmdCall
  (match fn-ty
    [(Func param-types ret-id)
      (let
        [params : ast.AstParamList
          (lower-imported-spmd-params ctx (deref param-types))]
        [ret : ast.AstType (tc_core.tc-context-type-get ctx ret-id)]
        (if (<=
          (lower-spmd-call-args-lanes
            ctx
            (lower-state-function-state (lower-state-clone state))
            (CompilerLowerMode.Avx512)
            env
            type-env
            (lower-global-shared-view index)
            (lower-masked-vector-empty-lane-locals)
            args)
          0)
          (No)
          (match (lower-call-args-as-needed
            ctx
            state
            env
            type-env
            args
            (tc_core.tc-param-type-list ctx (lower-global-shared-view params)))
            [(Err message) (Err message)]
            [(Ok args-state values writebacks)
              (let
                [call-args : ir.CompilerIrSpmdCallArgSeq
                  (lower-spmd-call-args-from-values
                    ctx
                    (lower-state-function-state args-state)
                    env
                    type-env
                    (lower-global-shared-view index)
                    args
                    params
                    values)]
                [args-code : String
                  (lower-imported-spmd-call-args-code
                    (lower-global-shared-view call-args))]
                [signature : String
                  (lower-spmd-source-signature
                    params
                    (lower-global-shared-view ret))]
                [requested-index-param : i64
                  (lower-imported-spmd-index-param ctx index args)]
                [imported-interns : ci.InternCompatState
                  (compiler-lower-state-interns
                    (lower-state-owner (lower-state-clone args-state)))]
                (match (lower-imported-spmd-select
                  (& imported-interns)
                  (tc_core.tc-context-pools ctx)
                  canonical-name
                  (& callables)
                  (string.copy signature)
                  (Scalar)
                  1
                  args-code
                  requested-index-param
                  ret
                  origin)
                  [(Err message) (Err message)]
                  [(Ok specialization)
                    (match (lower-avx512-emit-spmd-call
                      ctx
                      args-state
                      (lower-imported-spmd-ir-symbol
                        (&mut imported-interns)
                        specialization)
                      (Scalar)
                      (Bool true)
                      1
                      call-args
                      result-ty
                      (lower-imported-spmd-result-varying?
                        (& imported-interns)
                        specialization)
                      origin
                      (lower-imported-spmd-call-origin
                        (& imported-interns)
                        owner
                        version
                        canonical-name
                        signature
                        specialization))
                      [(Err message) (Err message)]
                      [(Ok lowered)
                        (match lowered
                          [(Expr call-state value ty)
                            (Some
                              (Expr
                                (lower-apply-arg-writebacks
                                  ctx
                                  call-state
                                  writebacks)
                                value
                                ty))])])]))])))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: imported SPMD helper does not have function type")))]))

(define (lower-spmd-scalar-call-maybe
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : LowerMaybeSpmdCall
  (match (compiler-lower-function-state-scalar-call-context
    (lower-state-function-state state))
    [(No) (No)]
    [(Some index)
      (match (lower-spmd-inline-helper-lookup
        ctx
        (lower-state-function-state state)
        env
        type-env
        (lower-id-set-empty)
        (lower-global-shared-view func))
        [(Ok helper)
          (match helper
            [(Some _ params ret body)
              (if (and
                (lower-spmd-helper-out-of-line?
                  ctx
                  (lower-global-shared-view body))
                (>
                  (lower-spmd-call-args-lanes
                    ctx
                    (lower-state-function-state state)
                    (CompilerLowerMode.Avx512)
                    env
                    type-env
                    (lower-global-shared-view index)
                    (lower-masked-vector-empty-lane-locals)
                    args)
                  0))
                (match (lower-call-args-as-needed
                  ctx
                  state
                  env
                  type-env
                  args
                  (tc_core.tc-param-type-list
                    ctx
                    (lower-global-shared-view params)))
                  [(Ok args-state values writebacks)
                    (match (lower-state-fresh-lambda-name args-state)
                      [(Name named-state hidden-name)
                        (let
                          [call-args : ir.CompilerIrSpmdCallArgSeq
                            (lower-spmd-call-args-from-values
                              ctx
                              (lower-state-function-state named-state)
                              env
                              type-env
                              (lower-global-shared-view index)
                              args
                              params
                              values)]
                          [helper-function-state : CompilerLowerFunctionState
                            (compiler-lower-function-state-new-with-stack
                              (lower-state-owner named-state)
                              (compiler-lower-function-state-inline-helper-stack
                                (lower-state-function-state named-state)))]
                          [result-varying : bool
                            (>
                              (lower-spmd-direct-call-result-lanes
                                ctx
                                (lower-state-function-state named-state)
                                (CompilerLowerMode.Avx512)
                                env
                                type-env
                                index
                                (lower-masked-vector-empty-lane-locals)
                                func
                                args)
                              0)]
                          (match (lower-spmd-specialized-helper-function
                            ctx
                            type-env
                            (lower-state-type-cache named-state)
                            helper-function-state
                            hidden-name
                            params
                            ret
                            result-varying
                            body
                            (Scalar)
                            call-args
                            1
                            ""
                            -1
                            (lower-state-spans named-state)
                            (lower-state-names named-state)
                            (lower-state-mode named-state))
                            [(Ok functions helper-spans)
                              (match (lower-spmd-generated-helper-abi
                                (lower-global-shared-view functions)
                                hidden-name)
                                [(SpmdPrivate helper-abi)
                                  (match (lower-avx512-emit-spmd-call
                                    ctx
                                    (lower-state-add-functions
                                      named-state
                                      functions
                                      helper-spans)
                                    hidden-name
                                    (Scalar)
                                    (Bool true)
                                    1
                                    call-args
                                    result-ty
                                    result-varying
                                    origin
                                    (Private helper-abi))
                                    [(Ok lowered)
                                      (match lowered
                                        [(Expr call-state value ty)
                                          (Some
                                            (Expr
                                              (lower-apply-arg-writebacks
                                                ctx
                                                call-state
                                                writebacks)
                                              value
                                              ty))])]
                                    [(Err message) (Err message)])]
                                [(Ordinary)
                                  (Err
                                    (box
                                      (lower-diagnostic-at-expr
                                        ctx
                                        origin
                                        "lower: generated SPMD helper has no private ABI descriptor")))])]
                            [(Err message) (Err message)]))])]
                  [(Err message) (Err message)])
                (No))]
            [(Imported owner version canonical-name fn-ty callables)
              (lower-imported-spmd-scalar-call
                ctx
                state
                env
                type-env
                index
                owner
                version
                canonical-name
                fn-ty
                (deref callables)
                args
                result-ty
                origin)]
            [(No) (No)])]
        [(Err message) (Err message)])]))

;; A call of a named function that no builtin claims: an SPMD scalar call, or
;; a direct call of `lowered-name`.
(define (lower-call-ordinary
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [lowered-name : String]
  [raw-name : i64]
  [lookup-name-id : i64]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-spmd-scalar-call-maybe
    ctx
    state
    env
    type-env
    func
    args
    (lower-global-shared-view result-ty)
    (lower-global-shared-view origin))
    [(Some lowered) (Ok lowered)]
    [(Err message) (Err message)]
    [(No)
      (lower-call-non-builtin
        ctx
        state
        env
        type-env
        lowered-name
        raw-name
        lookup-name-id
        args
        result-ty
        origin)]))

(define (lower-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (ast.ast-expr-unspan (lower-global-shared-view func))
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (tc_core.tc-lambda-expr-allow-ref-captures
              ctx
              type-env
              (lower-global-shared-view params)
              (lower-global-shared-view maybe-ret)
              (lower-global-shared-view body))
              [(Ok fn-ty)
                (let
                  [lowered-func
                    (try
                      (lower-lambda
                        ctx
                        state
                        env
                        type-env
                        params
                        maybe-ret
                        body
                        func
                        (lower-global-shared-view fn-ty)))]
                  (match lowered-func
                    [(Expr func-state func-value _)
                      (lower-indirect-call
                        ctx
                        func-state
                        env
                        type-env
                        fn-ty
                        func-value
                        args
                        result-ty
                        origin)]))]
              [(Err message)
                (Err (box (lower-diagnostic-at-expr ctx func message)))]))])]
    [(Var raw-name)
      ;; Builtins reached from a macro expansion arrive hygiene-renamed
      ;; (`__tl_macro_global$string.string-length`); strip the prefix so the builtin
      ;; dispatch below (length/string-length inline loads, etc.) fires just as it
      ;; does for hand-written calls. `raw-name` still keys the local-variable
      ;; lookup, and the generic call path strips the prefix itself.
      (let
        [raw-text : String
          (if (or
            (tc_core.macro-hygiene-global-id?
              (tc_core.tc-context-structural-session ctx)
              raw-name)
            (tc_core.macro-hygiene-local-id?
              (tc_core.tc-context-structural-session ctx)
              raw-name))
            (lower-context-intern-str
              ctx
              (tc_core.macro-hygiene-structural-source-name-id
                (tc_core.tc-context-structural-session ctx)
                raw-name))
            (tc_core.tc-env-key-name-text raw-name))]
        (if (tc_core.tc-dotted-local-field-name-id? type-env raw-name)
          (let
            [lowered-func
              (try
                (lower-expr
                  ctx
                  state
                  env
                  type-env
                  (lower-global-shared-view func)))]
            (match lowered-func
              [(Expr func-state func-value func-ty)
                (if (lower-function-type? (lower-global-shared-view func-ty))
                  (lower-indirect-call
                    ctx
                    func-state
                    env
                    type-env
                    func-ty
                    func-value
                    args
                    result-ty
                    origin)
                  (Err
                    (box
                      (lower-diagnostic-at-expr
                        ctx
                        func
                        "lower: call target is not a function"))))]))
          (let
            [local-id : i64
              (sym_i64_env.sym-i64-lookup-id-or
                env
                raw-name
                (csym.compiler-symbols-missing-handle))]
            (if (csym.compiler-symbols-handle-found? local-id)
              (match (tc_core.tc-lookup-id type-env raw-name)
                [(Ok fn-ty)
                  (if (lower-function-type? (lower-global-shared-view fn-ty))
                    (lower-indirect-call
                      ctx
                      state
                      env
                      type-env
                      fn-ty
                      (Var local-id)
                      args
                      result-ty
                      origin)
                    (Err
                      (box
                        (lower-diagnostic-at-expr
                          ctx
                          func
                          "lower: call target is not a function"))))]
                [(Err message)
                  (Err (box (lower-diagnostic-at-expr ctx func message)))])
              (let
                [hygiene-global : bool
                  (or
                    (tc_core.macro-hygiene-global-id?
                      (tc_core.tc-context-structural-session ctx)
                      raw-name)
                    (tc_core.tc-hygiene-global-name? raw-text))]
                (match (if hygiene-global
                  (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
                    ctx
                    type-env
                    (lower-global-shared-view raw-text)
                    raw-name
                    true)
                    [(Ok _ resolved-id)
                      (tc_core.TcNameLookup.Ok
                        (tc_core.tc-hygiene-global-call-name raw-text)
                        resolved-id)]
                    [(Err _)
                      (tc_core.TcNameLookup.Ok
                        (tc_core.tc-hygiene-global-call-name raw-text)
                        raw-name)])
                  (if (tc_core.tc-source-slash-qualified-id?
                    (tc_core.tc-context-structural-session ctx)
                    (lower-global-shared-view raw-text)
                    raw-name)
                    (tc_core.TcNameLookup.Ok raw-text raw-name)
                    (tc_core.tc-source-name-lookup-key-with-field-check-lookup
                      ctx
                      type-env
                      raw-text
                      raw-name
                      true)))
                  [(Ok name lookup-name-id)
                    ;; `array-length`/`length` on a dynamic array and private
                    ;; string intrinsics load fat-value fields directly instead of
                    ;; calling runtime symbols. Other `length` argument types keep
                    ;; the ordinary direct-call path.
                    (let
                      [source-id : i64
                        (if hygiene-global
                          (tc_core.macro-hygiene-global-source-name-id-or
                            (tc_core.tc-context-structural-session ctx)
                            raw-name
                            raw-name)
                          raw-name)]
                      [source-key-id : i64
                        (tc_core.tc-env-name-key-id
                          (tc_core.tc-context-structural-session ctx)
                          source-id)]
                      [lowered-name : String
                        (if hygiene-global
                          (match (lower-name-cache-lookup-id
                            (lower-state-names state)
                            source-key-id)
                            [(Some logical-name) logical-name]
                            [(No)
                              (lower-hygiene-source-name-in-context-id
                                (lower-state-owner state)
                                ctx
                                type-env
                                raw-name)])
                          (owned_view.compiler-owned-shared-view name))]
                      [name-id : i64 source-key-id]
                      [builtin-available : bool
                        (lower-top-level-builtin-available-id?
                          ctx
                          type-env
                          name-id)]
                      ;; Macro hygiene retains the defining-module spelling in
                      ;; `name`, while the typechecker classifies public Slice
                      ;; intrinsics from their source name. Reuse that exact
                      ;; shadow-aware classifier so generated declarations do
                      ;; not lower slice-view as an ordinary external call.
                      [slice-call-kind : tc_core.TcSliceViewCallKind
                        (tc_core.tc-slice-view-call-kind-name
                          ctx
                          type-env
                          source-id
                          (lower-context-intern-str ctx source-id))]
                      [atomic-symbol : String
                        (lower-atomic-extern-symbol-for-name-id
                          ctx
                          (lower-global-shared-view name)
                          lookup-name-id)]
                      (cond
                        [(> (string.string-length atomic-symbol) 0)
                          (lower-atomic-call
                            ctx
                            state
                            env
                            type-env
                            atomic-symbol
                            args
                            result-ty
                            origin)]
                        ;; Typecheck gives such a call no builtin spelling
                        ;; (`tc-builtin-call-name-id`), so none of the
                        ;; spelling-based arms below may claim it.
                        [(and
                            hygiene-global
                            (tc_core.macro-hygiene-global-user-binding-id?
                              (tc_core.tc-context-structural-session ctx)
                              raw-name))
                          (lower-call-ordinary
                            ctx
                            state
                            env
                            type-env
                            func
                            lowered-name
                            raw-name
                            lookup-name-id
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (lower-atomic-pointer-name? name))
                          (lower-atomic-pointer-call
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (tc_core.tc-layout-query-name?
                              (lower-global-shared-view name)))
                          (Err
                            (box
                              (lower-diagnostic-at-expr
                                ctx
                                origin
                                (str_cat.str-cat
                                  "lower: "
                                  name
                                  " is compile-time only; wrap it in (comptime ...)"))))]
                        [(tc_core.tc-slice-call-split? slice-call-kind)
                          (lower-slice-split-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(not
                            (= slice-call-kind tc_core.TcSliceViewCallKind.None))
                          (lower-slice-view-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(tc_core.tc-string-ref-helper-call-id?
                            ctx
                            type-env
                            source-id
                            name-id)
                          (lower-string-ref-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(tc_core.tc-string-length-helper-call-id?
                            ctx
                            type-env
                            source-id
                            name-id)
                          (lower-array-length
                            ctx
                            state
                            env
                            type-env
                            cbi.compiler-builtin-id-tl-private-string-length
                            "__tl_string_length"
                            args
                            result-ty
                            origin)]
                        [(lower-string-eq-helper-call-id?
                            ctx
                            env
                            state
                            type-env
                            source-id
                            name-id)
                          (lower-string-eq-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(lower-private-string-to-int-helper-call-id?
                            ctx
                            type-env
                            name-id)
                          (lower-string-to-int-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(or
                            (lower-string-concat-public-target? name)
                            (lower-string-concat-legacy-call-id?
                              ctx
                              env
                              state
                              type-env
                              source-id
                              name-id))
                          (lower-string-concat-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            (lower-float-bitcast-literal-call?
                              ctx
                              args
                              (lower-global-shared-view result-ty))
                            (lower-float-to-bits-public-target? name))
                          (lower-float-bitcast-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-string-ref-call-id?
                              name-id))
                          (lower-string-ref-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-length-call-id? name-id))
                          (lower-array-length
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (lower-string-runtime-builtin?
                              (lower-global-shared-view name)))
                          (lower-string-runtime-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-cpuid-id? name-id))
                          (lower-cpuid-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-xgetbv-id? name-id))
                          (lower-xgetbv-call ctx state env type-env args origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-c-fn-check-id? name-id))
                          (lower-c-fn-check-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-clone-id? name-id))
                          (if (= args.len 1)
                            (lower-clone-call
                              ctx
                              state
                              env
                              type-env
                              (lower-context-expr-get
                                ctx
                                (ast.ast-expr-list-get (& args) 0 0)))
                            (Err
                              (box
                                (lower-diagnostic
                                  "lower: clone expects one argument"))))]
                        [(and
                            builtin-available
                            (lower-arena-builtin-id? name-id))
                          (lower-arena-builtin-call
                            ctx
                            state
                            env
                            type-env
                            name-id
                            args
                            result-ty)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-float-sqrt-id? name-id))
                          (lower-float-sqrt-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-float-bitcast-id?
                              name-id))
                          (lower-float-bitcast-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-tls-current-arena-id?
                              name-id))
                          (lower-tls-current-arena-call
                            ctx
                            state
                            env
                            type-env
                            name-id
                            args
                            result-ty)]
                        [(and
                            builtin-available
                            (lower-bootstrap-runtime-builtin-id? name-id))
                          (lower-bootstrap-runtime-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(lower-comptime-error-source-or-lookup-id?
                            (lower-state-owner state)
                            source-id
                            name-id)
                          (Err
                            (box
                              (lower-diagnostic-at-expr
                                ctx
                                origin
                                "lower: comptime-error is compile-time only")))]
                        [else
                          (lower-call-ordinary
                            ctx
                            state
                            env
                            type-env
                            func
                            lowered-name
                            raw-name
                            lookup-name-id
                            args
                            result-ty
                            origin)]))]
                  [(Err message)
                    (Err (box (lower-diagnostic-at-expr ctx origin message)))]))))))]
    [_
      (let
        [lowered-func
          (try
            (lower-expr ctx state env type-env (lower-global-shared-view func)))]
        (match lowered-func
          [(Expr func-state func-value func-ty)
            (if (lower-function-type? (lower-global-shared-view func-ty))
              (lower-indirect-call
                ctx
                func-state
                env
                type-env
                func-ty
                func-value
                args
                result-ty
                origin)
              (Err
                (box
                  (lower-diagnostic-at-expr
                    ctx
                    func
                    "lower: call target is not a function"))))]))]))

;; A dynamic-array value is a pointer to inline fat storage `{data_ptr, length}`
;; with the i64 length at byte offset 8. `Gep` scales the index by the element
;; size, so index 1 with element type i64 addresses that length field, which a
;; typed `Load` then reads. Dynamic-array and borrowed-Slice calls plus
;; core/private string-length calls are intercepted; other `length` arguments
;; fall back to a direct call.
(define (lower-array-length
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 1)
    (let
      [arr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        (lower-state-type-cache state)
        (lower-state-function-state state)
        (lower-global-shared-view arr))
        [(Ok arr-ty)
          (lower-array-length-with-type
            ctx
            state
            env
            type-env
            source-id
            name
            args
            result-ty
            origin
            arr
            arr-ty)]
        [(Err _)
          (match (tc_core.tc-expr ctx type-env (lower-global-shared-view arr))
            [(Ok arr-ty)
              (lower-array-length-with-type
                ctx
                state
                env
                type-env
                source-id
                name
                args
                result-ty
                origin
                arr
                arr-ty)]
            [(Err _)
              (lower-direct-call-id
                ctx
                state
                env
                type-env
                source-id
                name
                args
                result-ty
                origin)])]))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-array-length-with-type
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]
  [arr : ast.AstExpr]
  [arr-ty : ast.AstType]) : ResultLowerExpr
  (match (tc_core.tc-array-length-receiver
    ctx
    (lower-global-shared-view arr-ty))
    [(Ok _) (lower-array-length-load ctx state env type-env arr)]
    [(Err _)
      (if (and
        (cbi.compiler-builtin-lower-string-length-load-id? source-id)
        (lower-length-handle-type? ctx arr-ty))
        (lower-array-length-load ctx state env type-env arr)
        (lower-direct-call-id
          ctx
          state
          env
          type-env
          source-id
          name
          args
          result-ty
          origin))]))

(define (lower-fixed-array-length-or
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [fallback : i64]) : i64
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(Array _ count) count]
    [(Ref _ inner)
      (let
        [inner-ty : ast.AstType (tc_core.tc-context-type-get ctx inner)]
        (lower-fixed-array-length-or ctx inner-ty fallback))]
    [(MutRef _ inner)
      (let
        [inner-ty : ast.AstType (tc_core.tc-context-type-get ctx inner)]
        (lower-fixed-array-length-or ctx inner-ty fallback))]
    [_ fallback]))

(define (lower-array-length-load
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]) : ResultLowerExpr
  (let
    [lowered (try (lower-expr ctx state env type-env arr))]
    (match lowered
      [(Expr arr-state arr-value arr-ty)
        (let
          [resolved : ast.AstType
            (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type ctx (lower-global-shared-view arr-ty)))]
          [fixed-count : i64
            (lower-fixed-array-length-or
              ctx
              (lower-global-shared-view resolved)
              -1)]
          (if (>= fixed-count 0)
            (Ok (Expr arr-state (I64 fixed-count) (I64)))
            (match resolved
              [(Ref _ inner)
                (if (lower-fat-reference? ctx inner)
                  (match (lower-emit-word
                    arr-state
                    arr-value
                    1
                    (lower-register-word-type ctx arr-ty 1))
                    [(Expr length-state length-value _)
                      (Ok (Expr length-state length-value (I64)))])
                  (lower-array-length-load-descriptor arr-state arr-value))]
              [(MutRef _ inner)
                (if (lower-fat-reference? ctx inner)
                  (match (lower-emit-word
                    arr-state
                    arr-value
                    1
                    (lower-register-word-type ctx arr-ty 1))
                    [(Expr length-state length-value _)
                      (Ok (Expr length-state length-value (I64)))])
                  (lower-array-length-load-descriptor arr-state arr-value))]
              [_ (lower-array-length-load-descriptor arr-state arr-value)])))])))

(define (lower-array-length-load-descriptor
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc gep-alloc gep-var)
      (let
        [gep-state : LowerState
          (lower-state-emit gep-alloc (Gep gep-var arr-value (I64 1) (I64)))]
        (match (lower-state-alloc-var gep-state)
          [(Alloc load-alloc load-var)
            (Ok
              (Expr
                (lower-state-emit
                  load-alloc
                  (Load load-var (Var gep-var) (I64)))
                (Var load-var)
                (I64)))]))]))

(define (lower-string-data
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [str : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [lowered : LowerExpr (try (lower-expr ctx state env type-env str))]
    (match lowered
      [(Expr str-state str-value str-ty)
        (match (if (lower-type-register-resident? ctx str-ty)
          ;; A `bytes` view is a two-word fat reference; its data pointer is
          ;; word 0. A `str` or String points at its `{data_ptr, len}` record.
          (lower-emit-word
            str-state
            str-value
            0
            (lower-global-shared-view result-ty))
          (lower-load-at-offset
            str-state
            str-value
            0
            (lower-global-shared-view result-ty)))
          [(Expr data-state data-value _)
            (Ok (Expr data-state data-value result-ty))])])))

(define (lower-array-data
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [array : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (let
    [lowered : LowerExpr (try (lower-expr ctx state env type-env array))]
    (match lowered
      [(Expr array-state array-value array-ty)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx (lower-global-shared-view array-ty)))
          [(DynArray _)
            (match (lower-load-at-offset
              array-state
              array-value
              0
              (lower-global-shared-view result-ty))
              [(Expr data-state data-value _)
                (Ok (Expr data-state data-value result-ty))])]
          [(Array _ _)
            (Ok (lower-cast-value array-state array-value array-ty result-ty))]
          [_
            (Err
              (box (lower-diagnostic "lower: __tl_array-data requires array")))])])))

(define (lower-string-from-bytes
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [ptr : ast.AstExpr]
  [len : ast.AstExpr]) : ResultLowerExpr
  (let
    [ptr-lowered : LowerExpr (try (lower-expr ctx state env type-env ptr))]
    (match ptr-lowered
      [(Expr ptr-state ptr-value ptr-ty)
        (let
          [len-lowered : LowerExpr
            (try
              (lower-integer-expr-with-expected-or-actual
                ctx
                ptr-state
                env
                type-env
                len
                (I64)
                "lower: string-from-bytes length must be integer"))]
          (match len-lowered
            [(Expr len-state len-value len-ty)
              (match (lower-cast-value len-state len-value len-ty (I64))
                [(Expr len-i-state len-i-value _)
                  (match (let
                    [ty (ast.AstType.String)]
                    (lower-reserve-heap-storage len-i-state 16 ty))
                    [(Expr base-state base-value _)
                      (let
                        [with-ptr : LowerState
                          (lower-store-at-offset
                            base-state
                            base-value
                            0
                            ptr-value
                            (lower-raw-pointer-ir-type ptr-ty))]
                        [with-len : LowerState
                          (lower-store-at-offset
                            with-ptr
                            base-value
                            8
                            len-i-value
                            (I64))]
                        (Ok (Expr with-len base-value (String))))])])]))])))

(define (lower-entry-load
  [state : LowerState]
  [kind : i64]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (let
        [instr : ir.CompilerIrInstr
          (if (= kind 0)
            (EntryArgc var-id)
            (if (= kind 1)
              (EntryArgv var-id)
              (EntryEnvp var-id)))]
        (Ok (Expr (lower-state-emit allocated instr) (Var var-id) result-ty)))]))

(define (lower-cpuid-like
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [leaf : ast.AstExpr]
  [subleaf : ast.AstExpr]
  [reg-index : i64]) : ResultLowerExpr
  (let
    [leaf-lowered : LowerExpr
      (try
        (lower-integer-expr-with-expected-or-actual
          ctx
          state
          env
          type-env
          leaf
          (I64)
          "lower: cpuid leaf must be integer"))]
    (match leaf-lowered
      [(Expr leaf-state leaf-value leaf-ty)
        (match (lower-cast-value leaf-state leaf-value leaf-ty (I64))
          [(Expr leaf-i-state leaf-i-value _)
            (let
              [subleaf-lowered : LowerExpr
                (try
                  (lower-integer-expr-with-expected-or-actual
                    ctx
                    leaf-i-state
                    env
                    type-env
                    subleaf
                    (I64)
                    "lower: cpuid subleaf must be integer"))]
              (match subleaf-lowered
                [(Expr subleaf-state subleaf-value subleaf-ty)
                  (match (lower-cast-value
                    subleaf-state
                    subleaf-value
                    subleaf-ty
                    (I64))
                    [(Expr subleaf-i-state subleaf-i-value _)
                      (match (lower-state-alloc-var subleaf-i-state)
                        [(Alloc allocated var-id)
                          (Ok
                            (Expr
                              (lower-state-emit
                                allocated
                                (CpuId
                                  var-id
                                  leaf-i-value
                                  subleaf-i-value
                                  reg-index))
                              (Var var-id)
                              (I64)))])])]))])])))

(define (lower-xgetbv
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : ast.AstExpr]) : ResultLowerExpr
  (let
    [lowered : LowerExpr
      (try
        (lower-integer-expr-with-expected-or-actual
          ctx
          state
          env
          type-env
          index
          (I64)
          "lower: xgetbv index must be integer"))]
    (match lowered
      [(Expr index-state index-value index-ty)
        (match (lower-cast-value index-state index-value index-ty (I64))
          [(Expr index-i-state index-i-value _)
            (match (lower-state-alloc-var index-i-state)
              [(Alloc allocated var-id)
                (Ok
                  (Expr
                    (lower-state-emit allocated (Xgetbv var-id index-i-value))
                    (Var var-id)
                    (I64)))])])])))

(define (lower-cpuid-store-field
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [leaf : ir.CompilerIrValue]
  [subleaf : ir.CompilerIrValue]
  [reg-index : i64]
  [offset : i64]) : LowerState
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (lower-store-at-offset
        (lower-state-emit allocated (CpuId var-id leaf subleaf reg-index))
        base
        offset
        (Var var-id)
        (I32))]))

(define (lower-cpuid-tuple-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [leaf : ir.CompilerIrValue]
  [subleaf : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-resolve-type ctx (lower-global-shared-view result-ty))
    [(Tuple elem-tys)
      ;; The CPUID result tuple is an ordinary inline value (#7070).
      (match (lower-reserve-inline-storage
        state
        (lower-type-list-storage-size ctx (deref elem-tys))
        result-ty)
        [(Expr base-state base _)
          (let
            [eax-state : LowerState
              (lower-cpuid-store-field
                base-state
                (lower-global-shared-view base)
                (lower-global-shared-view leaf)
                (lower-global-shared-view subleaf)
                0
                0)]
            [ebx-state : LowerState
              (lower-cpuid-store-field
                eax-state
                (lower-global-shared-view base)
                (lower-global-shared-view leaf)
                (lower-global-shared-view subleaf)
                1
                4)]
            [ecx-state : LowerState
              (lower-cpuid-store-field
                ebx-state
                (lower-global-shared-view base)
                (lower-global-shared-view leaf)
                (lower-global-shared-view subleaf)
                2
                8)]
            [edx-state : LowerState
              (lower-cpuid-store-field
                ecx-state
                (lower-global-shared-view base)
                leaf
                subleaf
                3
                12)]
            (Ok (Expr edx-state base result-ty)))])]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: cpuid requires tuple result")))]))

(define (lower-cpuid-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 2)
    (let
      [leaf : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [subleaf : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [leaf-lowered
        (try
          (lower-integer-expr-with-expected-or-actual
            ctx
            state
            env
            type-env
            leaf
            (I64)
            "lower: cpuid leaf must be integer"))]
      (match leaf-lowered
        [(Expr leaf-state leaf-value leaf-ty)
          (match (lower-cast-value leaf-state leaf-value leaf-ty (I64))
            [(Expr leaf-i-state leaf-i-value _)
              (let
                [subleaf-lowered
                  (try
                    (lower-integer-expr-with-expected-or-actual
                      ctx
                      leaf-i-state
                      env
                      type-env
                      subleaf
                      (I64)
                      "lower: cpuid subleaf must be integer"))]
                (match subleaf-lowered
                  [(Expr subleaf-state subleaf-value subleaf-ty)
                    (match (lower-cast-value
                      subleaf-state
                      subleaf-value
                      subleaf-ty
                      (I64))
                      [(Expr subleaf-i-state subleaf-i-value _)
                        (lower-cpuid-tuple-values
                          ctx
                          subleaf-i-state
                          leaf-i-value
                          subleaf-i-value
                          result-ty
                          origin)])]))])]))
    (Err (box (lower-diagnostic "lower: cpuid expects two arguments")))))

(define (lower-xgetbv-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (= args.len 1)
    (lower-xgetbv
      ctx
      state
      env
      type-env
      (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0)))
    (Err
      (box
        (lower-diagnostic-at-expr
          ctx
          origin
          "lower: xgetbv expects one argument")))))

;; Small emit helpers: allocate a fresh var, emit one instruction, and return a
;; `LowerExpr` carrying the updated state plus the result value. These flatten
;; the otherwise deeply-nested alloc/emit chains in the array-access lowering.
(define (lower-emit-cast
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (Cast v value from-ty (lower-global-shared-view to-ty)))
        (Var v)
        to-ty)]))

(define (lower-emit-gep
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [gep-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (Gep v base index (lower-global-shared-view gep-ty)))
        (Var v)
        gep-ty)]))

(define (lower-emit-load
  [state : LowerState]
  [addr : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit s (Load v addr (lower-global-shared-view ty)))
        (Var v)
        ty)]))

(define (lower-emit-binop
  [state : LowerState]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (BinOp
            v
            (lower-global-shared-view op)
            lhs
            rhs
            (lower-global-shared-view ty)))
        (Var v)
        (ir.compiler-ir-binop-result-type op ty))]))

;; A BoundsCheck is emitted as one unsigned `cmpq length, index`, so a operand
;; that is already a width-64 integer needs no materialised `Cast ... : u64`:
;; i64 and u64 share the single 64-bit register/stack home the compare reads,
;; and the emitted instruction is identical either way. A negative i64 index
;; still traps, because the unsigned compare sees its sign-extended pattern as a
;; huge value -- which is exactly what the cast would produce.
;;
;; The IR already carries raw i64 bounds-check operands: the gather lane checks
;; and the vector-map lane-array checks pass array lengths and computed indices
;; straight through with no cast at all. The optimizer likewise already assumes
;; the identity, canonicalising an `I64->U64` bounds operand back to its source
;; before keying redundancy facts (opt-bounds-cast-canon).
;;
;; Emitting the cast anyway costs one extra SSA value per operand -- two per
;; array access -- that the register allocator must give a home. Under pressure
;; that home is a spill slot, and because the slot colouring re-derives slots
;; per variable it need not be the source's slot, so the "no-op" cast
;; materialises as a real staged slot-to-slot copy in front of every check.
;;
;; Narrower operands keep their cast: those extensions are real work.
(define (lower-bounds-operand-width-64? [ty : ast.AstType]) : bool
  (match ty
    [(I64) true]
    [(U64) true]
    [_ false]))

(define (lower-emit-bounds-operand
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [from-ty : ast.AstType]) : LowerExpr
  (if (lower-bounds-operand-width-64? (lower-global-shared-view from-ty))
    (Expr state value from-ty)
    (lower-emit-cast state value from-ty (U64))))

(define (lower-emit-bounds-check
  [state : LowerState]
  [index : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]) : LowerState
  (match (lower-state-fresh-label state "bounds_ok")
    [(Label bounds-ok-state bounds-ok-label)
      (lower-state-emit
        bounds-ok-state
        (BoundsCheck index length bounds-ok-label))]))

;; Address an array element, striding by the element's full inline
;; size. Memory aggregates use a byte-offset GEP so fixed arrays, structs, and
;; enums use their real layout size instead of an address-sized backend scale.
;; Scalars and pointer-slot handles keep the type-scaled GEP.
(define (lower-emit-elem-addr-gep
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [idx-off : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : LowerExpr
  (if (lower-type-inline-storage? ctx elem-ty)
    (match (lower-emit-binop
      state
      Mul
      idx-off
      (I64 (lower-type-size ctx elem-ty))
      (I64))
      [(Expr mul-state byte-off _)
        (lower-emit-gep mul-state base byte-off (U8))])
    (lower-emit-gep state base idx-off elem-ty)))

;; Tail of `lower-array-element-addr`: after the explicit bounds check, load the
;; buffer pointer (fat offset 0, a raw U64 address) and Gep it by the index to
;; the element address (striding by the real inline element size).
(define (lower-array-element-addr-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [idx-off : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-gep state arr-value (I64 0) (I64))
    [(Expr buf-gep-state buf-gep _)
      (match (lower-emit-load buf-gep-state buf-gep (U64))
        [(Expr buf-state buf-val _)
          (lower-emit-elem-addr-gep ctx buf-state buf-val idx-off elem-ty)])]))

;; Compute the address of element `idx-value` in dynamic array `arr-value`,
;; emitting an unsigned bounds check (negative indices wrap large and also
;; fail). Returns the element pointer as an `elem-ty`-typed value.
(define (lower-array-element-addr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-bounds-operand
    state
    (lower-global-shared-view idx-value)
    (lower-global-shared-view idx-ty))
    [(Expr s1 idx-u _)
      (match (lower-emit-cast s1 idx-value idx-ty (I64))
        [(Expr s2 idx-off _)
          (match (lower-emit-gep
            s2
            (lower-global-shared-view arr-value)
            (I64 1)
            (I64))
            [(Expr s3 len-gep _)
              (match (lower-emit-load s3 len-gep (I64))
                [(Expr s4 len-val _)
                  (match (lower-emit-bounds-operand s4 len-val (I64))
                    [(Expr s5 len-u _)
                      (lower-array-element-addr-finish
                        ctx
                        (lower-emit-bounds-check s5 idx-u len-u)
                        arr-value
                        idx-off
                        elem-ty)])])])])]))

;; Compute a checked element address for a borrowed Slice register group.
;; Word0 is the data pointer and word1 is the signed length, so this path
;; never loads a dynamic-array descriptor.
(define (lower-slice-element-addr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [slice-value : ir.CompilerIrValue]
  [slice-ty : ast.AstType]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-word
    state
    (lower-global-shared-view slice-value)
    0
    (lower-register-word-type ctx slice-ty 0))
    [(Expr s0 data-ptr _)
      (match (lower-emit-word
        s0
        slice-value
        1
        (lower-register-word-type ctx slice-ty 1))
        [(Expr s1 length-i64 _)
          (match (lower-emit-bounds-operand
            s1
            (lower-global-shared-view idx-value)
            (lower-global-shared-view idx-ty))
            [(Expr s2 idx-u _)
              (match (lower-emit-cast s2 idx-value idx-ty (I64))
                [(Expr s3 idx-off _)
                  (match (lower-emit-bounds-operand s3 length-i64 (I64))
                    [(Expr s4 length-u _)
                      (lower-emit-elem-addr-gep
                        ctx
                        (lower-emit-bounds-check s4 idx-u length-u)
                        data-ptr
                        idx-off
                        elem-ty)])])])])]))

(define (lower-atomic-elem-type [symbol : (& symbol str)]) : ast.AstType
  (if (or
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add"))
    (I32)
    (I64)))

(define (lower-atomic-raw-symbol [symbol : (& symbol str)]) : i64
  (lower-derived-symbol-id
    (cond
      [(string.eq symbol "tl_atomic_i64_load") "tl_atomic_i64_load_ptr"]
      [(string.eq symbol "tl_atomic_i64_store") "tl_atomic_i64_store_ptr"]
      [(string.eq symbol "tl_atomic_i64_add") "tl_atomic_i64_add_ptr"]
      [(string.eq symbol "tl_atomic_i64_fetch_add")
        "tl_atomic_i64_fetch_add_ptr"]
      [(string.eq symbol "tl_atomic_i32_load") "tl_atomic_i32_load_ptr"]
      [(string.eq symbol "tl_atomic_i32_store") "tl_atomic_i32_store_ptr"]
      [(string.eq symbol "tl_atomic_i32_add") "tl_atomic_i32_add_ptr"]
      [else "tl_atomic_i32_fetch_add_ptr"])))

(define (lower-atomic-pointer-name? [name : (& name str)]) : bool
  (or
    (string.eq name "atomic-load")
    (string.eq name "atomic-store!")
    (string.eq name "atomic-add!")
    (string.eq name "atomic-fetch-add!")
    (string.eq name "atomic-cas!")
    (string.eq name "volatile-load")
    (string.eq name "volatile-store!")))

(define (lower-atomic-pointer-func?
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan func)
    [(Var raw-name)
      (let
        [name-id : i64
          (tc_core.macro-hygiene-global-source-name-id-or
            (tc_core.tc-type-env-structural-session type-env)
            raw-name
            raw-name)]
        [name : String (tc_core.tc-env-key-name-text name-id)]
        (and
          (lower-atomic-pointer-name? name)
          (not (tc_core.tc-name-bound-id? type-env name-id))
          (not
            (tc_core.macro-hygiene-global-user-binding-id?
              (tc_core.tc-type-env-structural-session type-env)
              raw-name))))]
    [_ false]))

(define (lower-atomic-pointer-load-name? [name : (& name str)]) : bool
  (or (string.eq name "atomic-load") (string.eq name "volatile-load")))

(define (lower-atomic-pointer-cas-name? [name : (& name str)]) : bool
  (string.eq name "atomic-cas!"))

(define (lower-atomic-pointer-volatile-name? [name : (& name str)]) : bool
  (or (string.eq name "volatile-load") (string.eq name "volatile-store!")))

(define (lower-atomic-pointer-width-prefix
  [name : (& name str)]
  [elem-ty : ast.AstType]) : String
  (match (tc_core.tc-type-strip-region elem-ty)
    [(I32)
      (if (lower-atomic-pointer-volatile-name? name)
        "tl_volatile_i32_"
        "tl_atomic_i32_")]
    [(U32)
      (if (lower-atomic-pointer-volatile-name? name)
        "tl_volatile_i32_"
        "tl_atomic_i32_")]
    [_
      (if (lower-atomic-pointer-volatile-name? name)
        "tl_volatile_i64_"
        "tl_atomic_i64_")]))

(define (lower-atomic-pointer-op-suffix [name : (& name str)]) : String
  (cond
    [(string.eq name "atomic-load") "load_ptr"]
    [(string.eq name "atomic-store!") "store_ptr"]
    [(string.eq name "atomic-add!") "add_ptr"]
    [(string.eq name "atomic-fetch-add!") "fetch_add_ptr"]
    [(string.eq name "volatile-load") "load_ptr"]
    [(string.eq name "volatile-store!") "store_ptr"]
    [else "cas_ptr"]))

(define (lower-atomic-pointer-raw-symbol
  [name : (& name str)]
  [elem-ty : ast.AstType]) : i64
  (lower-derived-symbol-id
    (str_cat.str-cat
      (lower-atomic-pointer-width-prefix name elem-ty)
      (lower-atomic-pointer-op-suffix name)
      ""
      "")))

(define (lower-atomic-pointer-elem
  [ctx : tc_core.TcContext]
  [name : String]
  [ptr-ty : ast.AstType]) : tc_core.ResultTcType
  (tc_core.tc-atomic-pointer-elem ctx name ptr-ty))

(define (lower-atomic-pointer-load-arity-message [name : String]) : String
  (str_cat.str-cat "lower: " name " expects exactly one argument"))

(define (lower-atomic-pointer-update-arity-message [name : (& name str)]) : String
  (if (lower-atomic-pointer-volatile-name? name)
    "lower: volatile-store! expects exactly two arguments"
    "lower: atomic update expects exactly two arguments"))

(define (lower-atomic-pointer-emit-load
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [name : String]
  [ptr : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Ok
        (Expr
          (lower-state-emit-at-expr
            ctx
            allocated
            (Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (One ptr)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-emit-update
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [name : (& name str)]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Ok
        (Expr
          (lower-state-emit-at-expr
            ctx
            allocated
            (Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (Two ptr value)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-emit-cas
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [name : (& name str)]
  [ptr : ir.CompilerIrValue]
  [expected : ir.CompilerIrValue]
  [new-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Ok
        (Expr
          (lower-state-emit-at-expr
            ctx
            allocated
            (Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (ir.compiler-ir-call-args-from-seq
                (ir.compiler-ir-value-seq3 ptr expected new-value))
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-update-tail
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [name : (& name str)]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]
  [tail : ast.AstExprList]) : ResultLowerExpr
  (if (= tail.len 0)
    (lower-atomic-pointer-emit-update
      ctx
      state
      name
      ptr
      value
      elem-ty
      result-ty
      origin)
    (Err
      (box (lower-diagnostic (lower-atomic-pointer-update-arity-message name))))))

(define (lower-atomic-pointer-cas-tail
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : (& name str)]
  [ptr : ir.CompilerIrValue]
  [expected : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]
  [tail : ast.AstExprList]) : ResultLowerExpr
  (if (= tail.len 1)
    (let
      [new-value : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& tail) 0 0))]
      [new-lowered
        (try
          (lower-expr-expected
            ctx
            state
            env
            type-env
            (lower-global-shared-view new-value)
            (lower-global-shared-view elem-ty)
            new-value))]
      (match new-lowered
        [(Expr new-state new-ir _)
          (lower-atomic-pointer-emit-cas
            ctx
            new-state
            name
            ptr
            expected
            new-ir
            elem-ty
            result-ty
            origin)]))
    (Err
      (box
        (lower-diagnostic "lower: atomic-cas! expects exactly three arguments")))))

(define (lower-atomic-pointer-nonload-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : (& name str)]
  [ptr : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [tail0 : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (> tail0.len 0)
    (let
      [value : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& tail0) 0 0))]
      [tail1 : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& tail0) 1)]
      [value-lowered
        (try
          (lower-expr-expected
            ctx
            state
            env
            type-env
            (lower-global-shared-view value)
            (lower-global-shared-view elem-ty)
            value))]
      (match value-lowered
        [(Expr value-state value-ir _)
          (if (lower-atomic-pointer-cas-name? name)
            (lower-atomic-pointer-cas-tail
              ctx
              value-state
              env
              type-env
              name
              ptr
              value-ir
              elem-ty
              result-ty
              origin
              tail1)
            (lower-atomic-pointer-update-tail
              ctx
              value-state
              name
              ptr
              value-ir
              elem-ty
              result-ty
              origin
              tail1))]))
    (Err
      (box
        (lower-diagnostic
          (if (lower-atomic-pointer-cas-name? name)
            "lower: atomic-cas! expects exactly three arguments"
            (lower-atomic-pointer-update-arity-message name)))))))

(define (lower-atomic-pointer-call-with-elem
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [ptr : ast.AstExpr]
  [ptr-ty : ast.AstType]
  [elem-ty : ast.AstType]
  [tail0 : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [ptr-lowered
      (try
        (lower-expr-expected
          ctx
          state
          env
          type-env
          (lower-global-shared-view ptr)
          ptr-ty
          ptr))]
    (match ptr-lowered
      [(Expr ptr-state ptr-ir _)
        (if (lower-atomic-pointer-load-name? name)
          (if (= tail0.len 0)
            (lower-atomic-pointer-emit-load
              ctx
              ptr-state
              name
              ptr-ir
              elem-ty
              result-ty
              origin)
            (Err
              (box
                (lower-diagnostic
                  (lower-atomic-pointer-load-arity-message name)))))
          (lower-atomic-pointer-nonload-call
            ctx
            ptr-state
            env
            type-env
            name
            ptr-ir
            elem-ty
            tail0
            result-ty
            origin))])))

(define (lower-atomic-pointer-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (> args.len 0)
    (let
      [ptr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [tail0 : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& args) 1)]
      (match (tc_core.tc-expr ctx type-env (lower-global-shared-view ptr))
        [(Ok ptr-ty)
          (match (lower-atomic-pointer-elem
            ctx
            (lower-global-shared-view name)
            (lower-global-shared-view ptr-ty))
            [(Ok elem-ty)
              (lower-atomic-pointer-call-with-elem
                ctx
                state
                env
                type-env
                name
                ptr
                ptr-ty
                elem-ty
                tail0
                result-ty
                origin)]
            [(Err message)
              (Err (box (lower-diagnostic-at-expr ctx ptr message)))])]
        [(Err message) (Err (box (lower-diagnostic-at-expr ctx ptr message)))]))
    (Err
      (box
        (lower-diagnostic
          (if (lower-atomic-pointer-load-name? name)
            (lower-atomic-pointer-load-arity-message name)
            (if (lower-atomic-pointer-cas-name? name)
              "lower: atomic-cas! expects exactly three arguments"
              (lower-atomic-pointer-update-arity-message name))))))))

(define (lower-atomic-load-symbol? [symbol : (& symbol str)]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i32_load")))

(define (lower-atomic-emit-load
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [symbol : (& symbol str)]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Ok
        (Expr
          (lower-state-emit-at-expr
            ctx
            allocated
            (Call
              var-id
              (lower-atomic-raw-symbol symbol)
              (One ptr)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (Var var-id)
          result-ty))]))

(define (lower-atomic-emit-update
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [symbol : (& symbol str)]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc allocated var-id)
      (Ok
        (Expr
          (lower-state-emit-at-expr
            ctx
            allocated
            (Call
              var-id
              (lower-atomic-raw-symbol symbol)
              (Two ptr value)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (Var var-id)
          result-ty))]))

(define (lower-atomic-storage-array
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [storage : ast.AstExpr]
  [elem-ty : ast.AstType]) : ResultLowerExpr
  (let
    [array-ty : ast.AstType (ast.ast-ty-dyn-array elem-ty)]
    [lowered
      (try
        (lower-expr ctx state env type-env (lower-global-shared-view storage)))]
    (match lowered
      [(Expr storage-state storage-value storage-ty)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx storage-ty))
          [(DynArray _) (Ok (Expr storage-state storage-value array-ty))]
          [(Ref _ referent-ty)
            (let
              [referent : ast.AstType
                (tc_core.tc-context-type-get ctx referent-ty)]
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type
                  ctx
                  (lower-global-shared-view referent)))
                [(Struct struct-name)
                  (lower-struct-get-through-reference
                    ctx
                    storage-state
                    storage-value
                    referent
                    struct-name
                    (tc_core.tc-nominal-name-id-display struct-name)
                    "slots"
                    array-ty)]
                [(StructArgs struct-name _)
                  (lower-struct-get-through-reference
                    ctx
                    storage-state
                    storage-value
                    referent
                    struct-name
                    (tc_core.tc-nominal-name-id-display struct-name)
                    "slots"
                    array-ty)]
                [_
                  (Err
                    (box
                      (lower-diagnostic-at-expr
                        ctx
                        storage
                        "lower: atomic storage expects an atomic buffer")))]))]
          [_
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  storage
                  "lower: atomic storage expects an atomic buffer")))])])))

(define (lower-atomic-array-element-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [array : ast.AstExpr]
  [index : ast.AstExpr]
  [elem-ty : ast.AstType]) : ResultLowerExpr
  (let
    [arr-lowered
      (try
        (lower-atomic-storage-array
          ctx
          state
          env
          type-env
          array
          (lower-global-shared-view elem-ty)))]
    (match arr-lowered
      [(Expr arr-state arr-value _)
        (match (lower-index-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache arr-state)
          (lower-state-function-state arr-state)
          (lower-global-shared-view index))
          [(Ok idx-ty)
            (let
              [idx-lowered
                (try
                  (lower-expr-expected
                    ctx
                    arr-state
                    env
                    type-env
                    (lower-global-shared-view index)
                    idx-ty
                    (lower-global-shared-view index)))]
              (match idx-lowered
                [(Expr idx-state idx-value idx-value-ty)
                  (match (lower-array-element-addr
                    ctx
                    idx-state
                    arr-value
                    idx-value
                    idx-value-ty
                    elem-ty)
                    [(Expr addr-state elem-ptr elem-ptr-ty)
                      (Ok
                        (Expr
                          (lower-state-record-latest-bounds-check-at-expr
                            ctx
                            addr-state
                            index)
                          elem-ptr
                          elem-ptr-ty))])]))]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx index message)))])])))

(define (lower-atomic-call-load
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [symbol : (& symbol str)]
  [array : ast.AstExpr]
  [index : ast.AstExpr]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [addr : LowerExpr
      (try
        (lower-atomic-array-element-address
          ctx
          state
          env
          type-env
          array
          index
          elem-ty))]
    (match addr
      [(Expr addr-state ptr _)
        (lower-atomic-emit-load ctx addr-state ptr symbol result-ty origin)])))

(define (lower-atomic-call-update
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [symbol : (& symbol str)]
  [array : ast.AstExpr]
  [index : ast.AstExpr]
  [value : ast.AstExpr]
  [elem-ty : ast.AstType]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [addr
      (try
        (lower-atomic-array-element-address
          ctx
          state
          env
          type-env
          array
          index
          (lower-global-shared-view elem-ty)))]
    (match addr
      [(Expr addr-state ptr _)
        (let
          [value-lowered
            (try
              (lower-expr-expected
                ctx
                addr-state
                env
                type-env
                (lower-global-shared-view value)
                elem-ty
                value))]
          (match value-lowered
            [(Expr value-state value-ir _)
              (lower-atomic-emit-update
                ctx
                value-state
                ptr
                value-ir
                symbol
                result-ty
                origin)]))])))

(define (lower-atomic-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [symbol : (& symbol str)]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [elem-ty : ast.AstType (lower-atomic-elem-type symbol)]
    [count : i64 args.len]
    (if (= count 0)
      (Err (box (lower-diagnostic "lower: atomic helper expects arguments")))
      (if (= count 1)
        (Err
          (box
            (lower-diagnostic
              "lower: atomic helper expects at least two arguments")))
        (let
          [array : ast.AstExpr
            (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
          [index : ast.AstExpr
            (lower-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
          (if (lower-atomic-load-symbol? symbol)
            (if (= count 2)
              (lower-atomic-call-load
                ctx
                state
                env
                type-env
                symbol
                array
                index
                elem-ty
                result-ty
                origin)
              (Err
                (box
                  (lower-diagnostic "lower: atomic load expects two arguments"))))
            (if (= count 3)
              (lower-atomic-call-update
                ctx
                state
                env
                type-env
                symbol
                array
                index
                (lower-context-expr-get
                  ctx
                  (ast.ast-expr-list-get (& args) 2 0))
                elem-ty
                result-ty
                origin)
              (Err
                (box
                  (lower-diagnostic
                    "lower: atomic update expects three arguments"))))))))))

;; Fixed arrays are inline element storage. Bounds check against the static
;; length, then Gep directly from the array handle without loading dynamic-array
;; fat fields.
(define (lower-fixed-array-element-addr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [elem-ty : ast.AstType]
  [elem-count : i64]) : LowerExpr
  (match (lower-emit-bounds-operand
    state
    (lower-global-shared-view idx-value)
    (lower-global-shared-view idx-ty))
    [(Expr s1 idx-u _)
      (match (lower-emit-cast s1 idx-value idx-ty (I64))
        [(Expr s2 idx-off _)
          (lower-emit-elem-addr-gep
            ctx
            (lower-emit-bounds-check s2 idx-u (I64 elem-count))
            arr-value
            idx-off
            elem-ty)])]))

;; `(__tl_make-array T len)` -> checked length, `tl_alloc` element buffer, and a
;; heap-backed dynamic-array fat value `{ ptr, len }`.
(define (lower-make-array-store-fat
  [state : LowerState]
  [arr-ty : ast.AstType]
  [buf-var : i64]
  [len-i64 : ir.CompilerIrValue]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 arr-ty)
    [(Expr arr-state arr-value _)
      (Ok
        (Expr
          (lower-store-at-offset
            (lower-store-at-offset arr-state arr-value 0 (Var buf-var) (U64))
            arr-value
            8
            len-i64
            (I64))
          arr-value
          arr-ty))]))

(define (lower-init-default-share-safe-type-list?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : bool
  (lower-init-default-share-safe-type-list-at? ctx (& types) 0))

(define (lower-init-default-share-safe-type-list-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (let
      [head : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (if (lower-init-default-share-safe? ctx head)
        (lower-init-default-share-safe-type-list-at? ctx types (+ index 1))
        false))))

(define (lower-init-default-share-safe-struct?
  [ctx : tc_core.TcContext]
  [_ : String]
  [struct-ty : ast.AstType]) : bool
  (match (tc_core.tc-struct-decl-id
    ctx
    (lower-struct-type-name-id-or struct-ty -1))
    [(Ok decl)
      (match decl
        [(TcStructDecl repr cleanup fields)
          (if (ast.ast-struct-repr-c? repr)
            false
            (if (ast.ast-struct-cleanup? cleanup)
              false
              (let
                [field-types : ast.AstTypeList
                  (tc_core.tc-resolve-type-list
                    ctx
                    (lower-struct-constructor-field-types-for-result
                      ctx
                      struct-ty
                      fields))]
                (lower-init-default-share-safe-type-list? ctx field-types))))])]
    [(Err _) false]))

(define (lower-init-default-share-safe-enum?
  [ctx : tc_core.TcContext]
  [_ : String]
  [enum-ty : ast.AstType]) : bool
  (match (tc_core.tc-enum-decl-id ctx (lower-enum-type-name-id-or enum-ty -1))
    [(Ok decl)
      (match decl
        [(TcEnumDecl cleanup variants)
          (if (ast.ast-enum-cleanup? cleanup)
            false
            (if (ast.ast-variant-def-list-empty? (& variants))
              false
              (let
                [variant : ast.AstVariantDef
                  (ast.ast-variant-def-list-get
                    (& variants)
                    0
                    (ast.ast-variant-def-fallback))]
                (match variant
                  [(Def _ fields _)
                    (let
                      [field-types : ast.AstTypeList
                        (tc_core.tc-resolve-type-list
                          ctx
                          (lower-enum-constructor-fields-for-result
                            ctx
                            enum-ty
                            fields))]
                      (lower-init-default-share-safe-type-list? ctx field-types))]))))])]
    [(Err _) false]))

(define (lower-init-default-share-safe?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (if (tc_core.tc-integer-type? (lower-global-shared-view resolved))
      true
      (match (lower-global-shared-view resolved)
        [(F64) true]
        [(F32) true]
        [(Bool) true]
        [(Char) true]
        [(Unit) true]
        [(String) true]
        [(Ptr _) true]
        [(MutPtr _) true]
        [(CFunc _ mode) (ast.ast-c-function-mode-nullable? mode)]
        [(Tuple elems)
          (lower-init-default-share-safe-type-list? ctx (deref elems))]
        [(Struct name)
          (lower-init-default-share-safe-struct?
            ctx
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(StructArgs name _)
          (lower-init-default-share-safe-struct?
            ctx
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(Enum name)
          (lower-init-default-share-safe-enum?
            ctx
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [(EnumArgs name _)
          (lower-init-default-share-safe-enum?
            ctx
            (tc_core.tc-nominal-name-id-display name)
            resolved)]
        [_ false]))))

(define (lower-make-array-init-advance
  [state : LowerState]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(Alloc inc-alloc inc-var)
      (Ok
        (lower-state-finish-block
          (lower-state-emit
            (lower-state-emit
              (lower-state-emit
                inc-alloc
                (BinOp inc-var Add (Var index-var) (I64 1) (I64)))
              (Mov index-var (Var inc-var) (I64)))
            (Jump header-label))
          exit-label))]))

(define (lower-make-array-store-init-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]
  [elem-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    buf-value
    (Var index-var)
    (lower-global-shared-view elem-ty))
    [(Expr gep-state elem-ptr _)
      (lower-make-array-init-advance
        (lower-array-elem-store-state ctx gep-state elem-ptr init-value elem-ty)
        index-var
        header-label
        exit-label)]))

(define (lower-make-array-init-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [index-var : i64]
  [header-label : i64]
  [exit-label : i64]
  [elem-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerState
  (let
    [lowered-init
      (try
        (lower-init-expr
          ctx
          state
          env
          type-env
          (lower-global-shared-view elem-ty)
          origin
          (lower-global-shared-view elem-ty)))]
    (match lowered-init
      [(Expr init-state init-value _)
        (match (lower-emit-elem-addr-gep
          ctx
          init-state
          buf-value
          (Var index-var)
          (lower-global-shared-view elem-ty))
          [(Expr gep-state elem-ptr _)
            (lower-make-array-init-advance
              (lower-array-elem-store-state
                ctx
                gep-state
                elem-ptr
                init-value
                elem-ty)
              index-var
              header-label
              exit-label)])])))

(define (lower-make-array-init-loop-with-labels
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [origin : ast.AstExpr]
  [header-label : i64]
  [body-label : i64]
  [exit-label : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(Alloc index-alloc index-var)
      (let
        [header-start : LowerState
          (lower-state-finish-block
            (lower-state-emit
              (lower-state-emit index-alloc (Mov index-var (I64 0) (I64)))
              (Jump header-label))
            header-label)]
        (match (lower-emit-binop header-start Lt (Var index-var) len-i64 (I64))
          [(Expr cond-state cond-value _)
            (let
              [body-start : LowerState
                (lower-state-finish-block
                  (lower-state-emit
                    cond-state
                    (Branch cond-value body-label exit-label))
                  body-label)]
              (lower-make-array-init-body
                ctx
                body-start
                env
                type-env
                buf-value
                index-var
                header-label
                exit-label
                elem-ty
                origin))]))]))

(define (lower-make-array-store-init-loop-with-labels
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]
  [header-label : i64]
  [body-label : i64]
  [exit-label : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(Alloc index-alloc index-var)
      (let
        [header-start : LowerState
          (lower-state-finish-block
            (lower-state-emit
              (lower-state-emit index-alloc (Mov index-var (I64 0) (I64)))
              (Jump header-label))
            header-label)]
        (match (lower-emit-binop header-start Lt (Var index-var) len-i64 (I64))
          [(Expr cond-state cond-value _)
            (let
              [body-start : LowerState
                (lower-state-finish-block
                  (lower-state-emit
                    cond-state
                    (Branch cond-value body-label exit-label))
                  body-label)]
              (lower-make-array-store-init-body
                ctx
                body-start
                buf-value
                index-var
                header-label
                exit-label
                elem-ty
                init-value))]))]))

(define (lower-make-array-init-loop-runtime
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (if (= elem-size 0)
    (Ok state)
    (match (lower-state-fresh-label state "make_array_init_header")
      [(Label header-label-state header-label)
        (match (lower-state-fresh-label
          header-label-state
          "make_array_init_body")
          [(Label body-label-state body-label)
            (match (lower-state-fresh-label
              body-label-state
              "make_array_init_exit")
              [(Label exit-label-state exit-label)
                (lower-make-array-init-loop-with-labels
                  ctx
                  exit-label-state
                  env
                  type-env
                  buf-value
                  len-i64
                  elem-ty
                  origin
                  header-label
                  body-label
                  exit-label)])])])))

(define (lower-make-array-store-init-loop-runtime
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [init-value : ir.CompilerIrValue]) : ResultLowerState
  (if (= elem-size 0)
    (Ok state)
    (match (lower-state-fresh-label state "make_array_init_header")
      [(Label header-label-state header-label)
        (match (lower-state-fresh-label
          header-label-state
          "make_array_init_body")
          [(Label body-label-state body-label)
            (match (lower-state-fresh-label
              body-label-state
              "make_array_init_exit")
              [(Label exit-label-state exit-label)
                (lower-make-array-store-init-loop-with-labels
                  ctx
                  exit-label-state
                  buf-value
                  len-i64
                  elem-ty
                  init-value
                  header-label
                  body-label
                  exit-label)])])])))

(define (lower-make-array-fill8
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [init-value : ir.CompilerIrValue]) : ResultLowerState
  (let
    [lowered : LowerExpr
      (try
        (lower-runtime-call-values
          state
          (lower-tl-array-fill8-symbol)
          (ir.compiler-ir-value-seq3 buf-value len-i64 init-value)
          (Unit)))]
    (match lowered
      [(Expr done-state _ _) (Ok done-state)])))

(define (lower-make-array-fill8-supported?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (and
      (= (lower-type-size ctx resolved) 8)
      (not (tc_core.tc-type-eq (lower-global-shared-view resolved) (F64)))
      ;; Memory-resident inline aggregates are pointers to
      ;; storage, but a one-word register-resident aggregate is the word
      ;; itself, so fill8 can replicate it directly.
      (or
        (not (lower-type-inline-storage? ctx resolved))
        (lower-type-register-resident? ctx (lower-global-shared-view resolved)))
      (lower-init-default-share-safe? ctx resolved))))

(define (lower-make-array-zero-fill-supported?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (if (tc_core.tc-integer-type? (lower-global-shared-view resolved))
      true
      (match (lower-global-shared-view resolved)
        [(F64) true]
        [(F32) true]
        [(Bool) true]
        [(Char) true]
        [(Unit) true]
        [(Ptr _) true]
        [(MutPtr _) true]
        [(Struct _) (lower-make-array-zero-fill-struct-supported? ctx resolved)]
        [(StructArgs _ _)
          (lower-make-array-zero-fill-struct-supported? ctx resolved)]
        [(Enum _) (lower-make-array-zero-fill-enum-supported? ctx resolved)]
        [(EnumArgs _ _)
          (lower-make-array-zero-fill-enum-supported? ctx resolved)]
        [(Tuple elems)
          (lower-make-array-zero-fill-type-list-supported? ctx (deref elems) 0)]
        [(Array elem _)
          (lower-make-array-zero-fill-supported?
            ctx
            (tc_core.tc-context-type-get ctx elem))]
        [_ false]))))

;; Every type in `types` (starting at `index`) must have an all-zero-bytes
;; default value. Used to decide whether make-array can zero its backing
;; store instead of running the per-element default-init loop.
(define (lower-make-array-zero-fill-type-list-supported?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len (& types)))
    true
    (if (lower-make-array-zero-fill-supported?
      ctx
      (tc_core.tc-context-type-get
        ctx
        (ast.ast-type-list-get (& types) index (ast.ast-type-id-fallback))))
      (lower-make-array-zero-fill-type-list-supported? ctx types (+ index 1))
      false)))

;; A struct can be zero-filled when every field's default is all-zero bytes
;; (default-layout only, mirroring lower-init-struct).
(define (lower-make-array-zero-fill-struct-supported?
  [ctx : tc_core.TcContext]
  [struct-ty : ast.AstType]) : bool
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-struct-type-name-id-or struct-ty -1))]
    (if (lower-struct-repr-c-id?
      field-ctx
      (lower-struct-type-name-id-or struct-ty -1))
      false
      (match (lower-struct-fields-id
        field-ctx
        (lower-struct-type-name-id-or struct-ty -1)
        (tc_core.tc-nominal-name-id-display
          (lower-struct-type-name-id-or struct-ty -1)))
        [(Ok fields)
          (lower-make-array-zero-fill-type-list-supported?
            field-ctx
            (tc_core.tc-resolve-type-list
              field-ctx
              (lower-struct-constructor-field-types-for-result
                field-ctx
                struct-ty
                fields))
            0)]
        [(Err _) false]))))

;; An enum can be zero-filled when its default value is all-zero bytes. That
;; default (`lower-init-enum`) is the first variant -- tag 0 -- built from each
;; payload field's own default, so it is all-zero bytes exactly when every
;; payload field type is zero-fillable; a fieldless first variant is the empty
;; case. Payload bytes past the variant's fields are don't-care. (A payload
;; field with a non-zero default, such as a String, keeps the init loop.)
(define (lower-make-array-zero-fill-enum-supported?
  [ctx : tc_core.TcContext]
  [enum-ty : ast.AstType]) : bool
  (let
    [field-ctx : tc_core.TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-enum-type-name-id-or enum-ty -1))]
    (match (tc_core.tc-enum-decl-id
      field-ctx
      (lower-enum-type-name-id-or enum-ty -1))
      [(Ok decl)
        (match decl
          [(TcEnumDecl _ variants)
            (if (ast.ast-variant-def-list-empty? (& variants))
              false
              (match (ast.ast-variant-def-list-get
                (& variants)
                0
                (ast.ast-variant-def-fallback))
                [(Def _ fields _)
                  (or
                    (ast.ast-type-list-empty? (& fields))
                    (lower-make-array-zero-fill-type-list-supported?
                      field-ctx
                      (tc_core.tc-resolve-type-list
                        field-ctx
                        (lower-enum-constructor-fields-for-result
                          field-ctx
                          enum-ty
                          fields))
                      0))]))])]
      [(Err _) false])))

(define (lower-make-array-zero-fill
  [state : LowerState]
  [buf-value : ir.CompilerIrValue]
  [byte-count : ir.CompilerIrValue]) : ResultLowerState
  (let
    [lowered
      (try
        (lower-runtime-call-values
          state
          (lower-tl-array-zero-symbol)
          (ir.compiler-ir-value-seq2 buf-value byte-count)
          (Unit)))]
    (match lowered
      [(Expr done-state _ _) (Ok done-state)])))

(define (lower-make-array-zero-literal-length? [len : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan len)
    [(Literal (Int value _)) (= value 0)]
    [_ false]))

(define (lower-make-array-init-loop-nonzero
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [byte-count : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (cond
    [(= elem-size 0) (Ok state)]
    [(lower-make-array-zero-fill-supported?
        ctx
        (lower-global-shared-view elem-ty))
      (lower-make-array-zero-fill state buf-value byte-count)]
    [(lower-init-default-share-safe? ctx (lower-global-shared-view elem-ty))
      (let
        [lowered-init
          (try
            (lower-init-expr
              ctx
              state
              env
              type-env
              (lower-global-shared-view elem-ty)
              origin
              (lower-global-shared-view elem-ty)))]
        (match lowered-init
          [(Expr init-state init-value _)
            (if (lower-make-array-fill8-supported?
              ctx
              (lower-global-shared-view elem-ty))
              (lower-make-array-fill8 init-state buf-value len-i64 init-value)
              (lower-make-array-store-init-loop-runtime
                ctx
                init-state
                buf-value
                len-i64
                elem-ty
                elem-size
                init-value))]))]
    [else
      (lower-make-array-init-loop-runtime
        ctx
        state
        env
        type-env
        buf-value
        len-i64
        elem-ty
        elem-size
        origin)]))

(define (lower-make-array-init-loop
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [buf-value : ir.CompilerIrValue]
  [len-i64 : ir.CompilerIrValue]
  [byte-count : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : ast.AstExpr]) : ResultLowerState
  (if zero-literal-length
    (Ok state)
    (match (lower-global-shared-view len-i64)
      [(I64 literal-len)
        (if (= literal-len 0)
          (Ok state)
          (lower-make-array-init-loop-nonzero
            ctx
            state
            env
            type-env
            buf-value
            len-i64
            byte-count
            elem-ty
            elem-size
            origin))]
      [_
        (lower-make-array-init-loop-nonzero
          ctx
          state
          env
          type-env
          buf-value
          len-i64
          byte-count
          elem-ty
          elem-size
          origin)])))

(define (lower-make-array-alloc-buffer
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr-ty : ast.AstType]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-emit-binop
    state
    (Mul)
    (lower-global-shared-view len-i64)
    (I64 elem-size)
    (I64))
    [(Expr byte-state byte-count _)
      (match (lower-state-alloc-var byte-state)
        [(Alloc buf-alloc buf-var)
          (let
            [alloc-state : LowerState
              (lower-state-emit
                buf-alloc
                (Call
                  buf-var
                  (lower-tl-alloc-symbol)
                  (One (lower-global-shared-view byte-count))
                  (U64)))]
            [init-state
              (try
                (lower-make-array-init-loop
                  ctx
                  alloc-state
                  env
                  type-env
                  (Var buf-var)
                  (lower-global-shared-view len-i64)
                  byte-count
                  elem-ty
                  elem-size
                  zero-literal-length
                  origin))]
            (lower-make-array-store-fat init-state arr-ty buf-var len-i64))])]))

(define (lower-make-array-after-max-check
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [fail-label : i64]
  [alloc-label : i64]
  [arr-ty : ast.AstType]
  [len-i64 : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [fail-start : LowerState (lower-state-finish-block state fail-label)]
    [alloc-start : LowerState
      (lower-state-finish-block
        (lower-state-emit (lower-oob-abort fail-start) (Jump alloc-label))
        alloc-label)]
    (lower-make-array-alloc-buffer
      ctx
      alloc-start
      env
      type-env
      arr-ty
      len-i64
      elem-ty
      elem-size
      zero-literal-length
      origin)))

(define (lower-make-array-from-len
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [elem-ty : ast.AstType]
  [len-value : ir.CompilerIrValue]
  [len-ty : ast.AstType]
  [len-expr : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [resolved-elem : ast.AstType (tc_core.tc-resolve-type ctx elem-ty)]
    (match (lower-cast-value state len-value len-ty (I64))
      [(Expr len-state len-i64 _)
        (let
          [elem-size : i64 (lower-type-size ctx resolved-elem)]
          [arr-ty : ast.AstType
            (ast.ast-ty-dyn-array (lower-global-shared-view resolved-elem))]
          (match (lower-state-fresh-label len-state "make_array_len_nonneg")
            [(Label s1 check-max-label)
              (match (lower-state-fresh-label s1 "make_array_len_fail")
                [(Label s2 fail-label)
                  (match (lower-state-fresh-label s2 "make_array_len_ok")
                    [(Label s3 alloc-label)
                      (match (lower-emit-binop
                        s3
                        (Le)
                        (I64 0)
                        (lower-global-shared-view len-i64)
                        (I64))
                        [(Expr s4 non-negative _)
                          (let
                            [check-start : LowerState
                              (lower-state-finish-block
                                (lower-state-emit
                                  s4
                                  (Branch
                                    non-negative
                                    check-max-label
                                    fail-label))
                                check-max-label)]
                            [max-len : i64
                              (if (= elem-size 0)
                                9223372036854775807
                                (/ 9223372036854775807 elem-size))]
                            (match (lower-emit-binop
                              check-start
                              (Le)
                              (lower-global-shared-view len-i64)
                              (I64 max-len)
                              (I64))
                              [(Expr s5 within-max _)
                                (lower-make-array-after-max-check
                                  ctx
                                  (lower-state-emit
                                    s5
                                    (Branch within-max alloc-label fail-label))
                                  env
                                  type-env
                                  fail-label
                                  alloc-label
                                  arr-ty
                                  len-i64
                                  resolved-elem
                                  elem-size
                                  (lower-make-array-zero-literal-length?
                                    len-expr)
                                  origin)]))])])])]))])))

(define (lower-make-array
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [elem-ty : ast.AstType]
  [len : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [lowered
      (try
        (lower-integer-expr-with-expected-or-actual
          ctx
          state
          env
          type-env
          (lower-global-shared-view len)
          (I64)
          "lower: __tl_make-array length must be integer"))]
    (match lowered
      [(Expr len-state len-value len-ty)
        (lower-make-array-from-len
          ctx
          len-state
          env
          type-env
          elem-ty
          len-value
          len-ty
          len
          origin)])))

;; `(array-ref arr index)` -> bounds-checked typed element load.
;; Read an array element given its address. For a memory aggregate
;; element the address IS the value (pointer representation); for scalars and
;; pointer-slot types (box/dynarray/string handles) load the register-width
;; value. Mirrors lower-load-inline-value-at-offset at offset 0 but preserves the
;; exact lower-emit-load scalar path.
(define (lower-array-elem-ref-result
  [ctx : tc_core.TcContext]
  [addr-state : LowerState]
  [elem-ptr : ir.CompilerIrValue]
  [elem-ir-ty : ast.AstType]) : ResultLowerExpr
  ;; A register-resident element is loaded as a word, not returned as the
  ;; element address.
  (if (and
    (lower-type-inline-storage? ctx elem-ir-ty)
    (not
      (lower-type-register-resident? ctx (lower-global-shared-view elem-ir-ty))))
    (Ok (Expr addr-state elem-ptr elem-ir-ty))
    (if (lower-type-register-group? ctx (lower-global-shared-view elem-ir-ty))
      (match (lower-load-group-from-ptr
        ctx
        addr-state
        elem-ptr
        (lower-global-shared-view elem-ir-ty))
        [(Expr load-state load-value _)
          (Ok (Expr load-state load-value elem-ir-ty))])
      (match (lower-emit-load
        addr-state
        elem-ptr
        (lower-global-shared-view elem-ir-ty))
        [(Expr load-state load-value _)
          (Ok (Expr load-state load-value elem-ir-ty))]))))

(define (lower-array-take-length
  [state : LowerState]
  [array-value : ir.CompilerIrValue]) : LowerExpr
  (match (lower-emit-gep state array-value (I64 1) (I64))
    [(Expr gep-state gep-value _) (lower-emit-load gep-state gep-value (I64))]))

(define (lower-array-take-store-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [result-base : ir.CompilerIrValue]
  [elem-offset : i64]
  [elem-ty : ast.AstType]
  [available : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]) : LowerState
  (lower-store-inline-value-at-offset
    ctx
    (lower-store-at-offset state result-base 0 available (Bool))
    result-base
    elem-offset
    value
    (lower-global-shared-view elem-ty)
    (lower-type-size ctx elem-ty)))

;; Finish a checked dynamic-array extraction once its availability flag is
;; initialized to false. The payload is meaningful only when that flag is true.
;; Both dynamic lengths are checked before either element address is formed;
;; clearing the bitmap precedes the payload load, making a repeated extraction
;; observe false instead of moving again.
(define (lower-array-take-after-result-flag
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [array-value : ir.CompilerIrValue]
  [live-value : ir.CompilerIrValue]
  [index-value : ir.CompilerIrValue]
  [index-ty : ast.AstType]
  [elem-ty : ast.AstType]
  [result-base : ir.CompilerIrValue]
  [result-ty : ast.AstType]
  [elem-offset : i64]) : ResultLowerExpr
  (match (lower-array-take-length state (lower-global-shared-view array-value))
    [(Expr array-len-state array-len _)
      (match (lower-array-take-length
        array-len-state
        (lower-global-shared-view live-value))
        [(Expr live-len-state live-len _)
          (match (lower-emit-cast
            live-len-state
            (lower-global-shared-view index-value)
            (lower-global-shared-view index-ty)
            (U64))
            [(Expr index-state index-u _)
              (match (lower-emit-cast index-state array-len (I64) (U64))
                [(Expr array-len-state2 array-len-u _)
                  (match (lower-emit-cast array-len-state2 live-len (I64) (U64))
                    [(Expr live-len-state2 live-len-u _)
                      (match (lower-emit-binop
                        live-len-state2
                        Lt
                        (lower-global-shared-view index-u)
                        array-len-u
                        (U64))
                        [(Expr array-ok-state array-ok _)
                          (match (lower-emit-binop
                            array-ok-state
                            Lt
                            index-u
                            live-len-u
                            (U64))
                            [(Expr live-ok-state live-ok _)
                              (match (lower-emit-binop
                                live-ok-state
                                And
                                array-ok
                                live-ok
                                (Bool))
                                [(Expr bounds-state bounds-ok _)
                                  (match (lower-state-fresh-label
                                    bounds-state
                                    "array_take_live")
                                    [(Label live-label-state live-label)
                                      (match (lower-state-fresh-label
                                        live-label-state
                                        "array_take_value")
                                        [(Label take-label-state take-label)
                                          (match (lower-state-fresh-label
                                            take-label-state
                                            "array_take_done")
                                            [(Label done-label-state done-label)
                                              (let
                                                [live-start : LowerState
                                                  (lower-state-finish-block
                                                    (lower-state-emit
                                                      done-label-state
                                                      (Branch
                                                        bounds-ok
                                                        live-label
                                                        done-label))
                                                    live-label)]
                                                (match (lower-array-element-addr
                                                  ctx
                                                  live-start
                                                  live-value
                                                  (lower-global-shared-view
                                                    index-value)
                                                  (lower-global-shared-view
                                                    index-ty)
                                                  (Bool))
                                                  [(Expr
                                                      live-addr-state
                                                      live-ptr
                                                      _)
                                                    (let
                                                      [live-read
                                                        (try
                                                          (lower-array-elem-ref-result
                                                            ctx
                                                            live-addr-state
                                                            (lower-global-shared-view
                                                              live-ptr)
                                                            (Bool)))]
                                                      (match live-read
                                                        [(Expr
                                                            live-read-state
                                                            live-bit
                                                            _)
                                                          (let
                                                            [take-start : LowerState
                                                              (lower-state-finish-block
                                                                (lower-state-emit
                                                                  live-read-state
                                                                  (Branch
                                                                    live-bit
                                                                    take-label
                                                                    done-label))
                                                                take-label)]
                                                            (match (lower-array-element-addr
                                                              ctx
                                                              take-start
                                                              array-value
                                                              index-value
                                                              index-ty
                                                              (lower-global-shared-view
                                                                elem-ty))
                                                              [(Expr
                                                                  elem-addr-state
                                                                  elem-ptr
                                                                  _)
                                                                (let
                                                                  [value-read
                                                                    (try
                                                                      (lower-array-elem-ref-result
                                                                        ctx
                                                                        elem-addr-state
                                                                        elem-ptr
                                                                        (lower-global-shared-view
                                                                          elem-ty)))]
                                                                  (match value-read
                                                                    [(Expr
                                                                        value-state
                                                                        value
                                                                        _)
                                                                      (let
                                                                        [cleared-state : LowerState
                                                                          (lower-array-elem-store-state
                                                                            ctx
                                                                            value-state
                                                                            live-ptr
                                                                            (Bool
                                                                              false)
                                                                            (Bool))]
                                                                        [stored-state : LowerState
                                                                          (lower-array-take-store-result
                                                                            ctx
                                                                            cleared-state
                                                                            (lower-global-shared-view
                                                                              result-base)
                                                                            elem-offset
                                                                            elem-ty
                                                                            (Bool
                                                                              true)
                                                                            value)]
                                                                        (Ok
                                                                          (Expr
                                                                            (lower-state-finish-block
                                                                              (lower-state-emit
                                                                                stored-state
                                                                                (Jump
                                                                                  done-label))
                                                                              done-label)
                                                                            result-base
                                                                            result-ty)))]))]))]))]))])])])])])])])])])])]))

(define (lower-array-take
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [array : ast.AstExpr]
  [live : ast.AstExpr]
  [index : ast.AstExpr]
  [result-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    array)
    [(Ok array-ty)
      (match (tc_core.tc-array-set-receiver ctx array-ty)
        [(Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx container-ty))
                [(DynArray _)
                  (let
                    [elem-ir-ty : ast.AstType
                      (tc_core.tc-type-without-regions
                        (tc_core.tc-resolve-type ctx elem-ty))]
                    [array-lowered : LowerExpr
                      (try (lower-expr ctx state env type-env array))]
                    (match array-lowered
                      [(Expr array-state array-value _)
                        (let
                          [live-lowered : LowerExpr
                            (try (lower-expr ctx array-state env type-env live))]
                          (match live-lowered
                            [(Expr live-state live-value _)
                              (let
                                [index-lowered : LowerExpr
                                  (try
                                    (lower-integer-expr-with-expected-or-actual
                                      ctx
                                      live-state
                                      env
                                      type-env
                                      index
                                      (I64)
                                      "lower: __tl_array-take! index must be integer"))]
                                (match index-lowered
                                  [(Expr index-state index-value index-ty)
                                    (let
                                      [elem-offset : i64
                                        (lower-align-up
                                          1
                                          (lower-type-align ctx elem-ir-ty))]
                                      [result-storage-size : i64
                                        (lower-type-list-storage-size
                                          ctx
                                          (ast.ast-type-cons
                                            (Bool)
                                            (ast.ast-type-cons
                                              (lower-global-shared-view
                                                elem-ir-ty)
                                              (ast.ast-type-list-new))))]
                                      (match (lower-reserve-heap-storage
                                        index-state
                                        result-storage-size
                                        result-ty)
                                        [(Expr result-state result-base _)
                                          (lower-array-take-after-result-flag
                                            ctx
                                            (lower-store-at-offset
                                              result-state
                                              result-base
                                              0
                                              (Bool false)
                                              (Bool))
                                            array-value
                                            live-value
                                            index-value
                                            index-ty
                                            elem-ir-ty
                                            result-base
                                            result-ty
                                            elem-offset)]))]))]))]))]
                [_
                  (Err
                    (box
                      (lower-diagnostic-at-expr
                        ctx
                        array
                        "lower: __tl_array-take! requires dynamic array storage")))])])]
        [(Err message) (Err (box (lower-diagnostic-at-expr ctx array message)))])]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx array message)))]))

;; Materialize a place's old value before the place is overwritten. Scalar and
;; register-group loads are already independent values; an inline memory
;; aggregate needs a distinct local copy because its lowered value is an
;; address into the place's storage itself.
(define (lower-place-old-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [place-ptr : ir.CompilerIrValue]
  [value-ty : ast.AstType]) : ResultLowerExpr
  (if (= (lower-type-size ctx value-ty) 0)
    (Ok (Expr state Unit value-ty))
    (let
      [old
        (try
          (lower-array-elem-ref-result
            ctx
            state
            place-ptr
            (lower-global-shared-view value-ty)))]
      (match (lower-global-shared-view old)
        [(Expr old-state old-value _)
          (if (and
            (lower-type-inline-storage? ctx value-ty)
            (not
              (lower-type-register-resident?
                ctx
                (lower-global-shared-view value-ty))))
            (lower-copy-inline-aggregate-to-inline
              ctx
              old-state
              old-value
              value-ty)
            (Ok old))]))))

(define (lower-array-ref
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [index : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    arr)
    [(Ok arr-ty)
      (match (tc_core.tc-array-readable-receiver ctx arr-ty)
        [(Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (let
                [elem-ir-ty : ast.AstType
                  (tc_core.tc-type-without-regions elem-ty)]
                [arr-lowered
                  (try
                    (lower-expr
                      ctx
                      state
                      env
                      type-env
                      (lower-global-shared-view arr)))]
                (match arr-lowered
                  [(Expr arr-state arr-value _)
                    (match (lower-index-result-type-or-check
                      ctx
                      env
                      type-env
                      (lower-state-type-cache arr-state)
                      (lower-state-function-state arr-state)
                      (lower-global-shared-view index))
                      [(Ok idx-ty)
                        (let
                          [idx-lowered
                            (try
                              (lower-expr-expected
                                ctx
                                arr-state
                                env
                                type-env
                                (lower-global-shared-view index)
                                idx-ty
                                (lower-global-shared-view index)))]
                          (match idx-lowered
                            [(Expr idx-state idx-value idx-value-ty)
                              (match (tc_core.tc-type-strip-region
                                (tc_core.tc-resolve-type
                                  ctx
                                  (lower-global-shared-view container-ty)))
                                [(DynArray _)
                                  (match (lower-array-element-addr
                                    ctx
                                    idx-state
                                    arr-value
                                    idx-value
                                    idx-value-ty
                                    (lower-global-shared-view elem-ir-ty))
                                    [(Expr addr-state elem-ptr _)
                                      (lower-array-elem-ref-result
                                        ctx
                                        (lower-state-record-latest-bounds-check-at-expr
                                          ctx
                                          addr-state
                                          index)
                                        elem-ptr
                                        elem-ir-ty)])]
                                [(Ref _ inner)
                                  (if (lower-fat-reference? ctx inner)
                                    (match (lower-slice-element-addr
                                      ctx
                                      idx-state
                                      arr-value
                                      container-ty
                                      idx-value
                                      idx-value-ty
                                      (lower-global-shared-view elem-ir-ty))
                                      [(Expr addr-state elem-ptr _)
                                        (lower-array-elem-ref-result
                                          ctx
                                          (lower-state-record-latest-bounds-check-at-expr
                                            ctx
                                            addr-state
                                            index)
                                          elem-ptr
                                          elem-ir-ty)])
                                    (Err
                                      (box
                                        (lower-diagnostic-at-expr
                                          ctx
                                          arr
                                          "lower: array-ref requires array type"))))]
                                [(MutRef _ inner)
                                  (if (lower-fat-reference? ctx inner)
                                    (match (lower-slice-element-addr
                                      ctx
                                      idx-state
                                      arr-value
                                      container-ty
                                      idx-value
                                      idx-value-ty
                                      (lower-global-shared-view elem-ir-ty))
                                      [(Expr addr-state elem-ptr _)
                                        (lower-array-elem-ref-result
                                          ctx
                                          (lower-state-record-latest-bounds-check-at-expr
                                            ctx
                                            addr-state
                                            index)
                                          elem-ptr
                                          elem-ir-ty)])
                                    (Err
                                      (box
                                        (lower-diagnostic-at-expr
                                          ctx
                                          arr
                                          "lower: array-ref requires array type"))))]
                                [(Array _ elem-count)
                                  (match (lower-fixed-array-element-addr
                                    ctx
                                    idx-state
                                    arr-value
                                    idx-value
                                    idx-value-ty
                                    (lower-global-shared-view elem-ir-ty)
                                    elem-count)
                                    [(Expr addr-state elem-ptr _)
                                      (if (= (lower-type-size ctx elem-ir-ty) 0)
                                        (Ok
                                          (Expr
                                            (lower-state-record-latest-bounds-check-at-expr
                                              ctx
                                              addr-state
                                              index)
                                            Unit
                                            elem-ir-ty))
                                        (lower-array-elem-ref-result
                                          ctx
                                          (lower-state-record-latest-bounds-check-at-expr
                                            ctx
                                            addr-state
                                            index)
                                          elem-ptr
                                          elem-ir-ty))])]
                                [_
                                  (Err
                                    (box
                                      (lower-diagnostic-at-expr
                                        ctx
                                        arr
                                        "lower: array-ref requires array type")))])]))]
                      [(Err message)
                        (Err (box (lower-diagnostic-at-expr ctx index message)))])]))])]
        [(Err message) (Err (box (lower-diagnostic-at-expr ctx arr message)))])]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx arr message)))]))

;; `(set! (array-ref arr index) value)` -> bounds-checked typed element store.
;; Store a value into an array element slot. A memory aggregate
;; value is byte-copied into the full-size element slot; scalars and pointer-slot
;; handles use a register-width store.
(define (lower-array-elem-store-state
  [ctx : tc_core.TcContext]
  [addr-state : LowerState]
  [elem-ptr : ir.CompilerIrValue]
  [value-ir : ir.CompilerIrValue]
  [elem-ir-ty : ast.AstType]) : LowerState
  ;; A register-resident element value is a word; store it scalar instead
  ;; of byte-copying from a pointer.
  (if (and
    (lower-type-inline-storage? ctx elem-ir-ty)
    (not
      (lower-type-register-resident? ctx (lower-global-shared-view elem-ir-ty))))
    (lower-copy-bytes
      addr-state
      elem-ptr
      0
      value-ir
      0
      (lower-type-size ctx elem-ir-ty))
    (if (lower-type-register-group? ctx (lower-global-shared-view elem-ir-ty))
      (lower-store-group-at-ptr ctx addr-state elem-ptr value-ir elem-ir-ty)
      (lower-state-emit addr-state (StorePtr elem-ptr value-ir elem-ir-ty)))))

(define (lower-array-set-store-materialized
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr : ast.AstExpr]
  [origin : ast.AstExpr]
  [arr-value : ir.CompilerIrValue]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [container-ty : ast.AstType]
  [elem-ir-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view container-ty)))
    [(DynArray _)
      (match (lower-array-element-addr
        ctx
        state
        arr-value
        idx-value
        idx-ty
        (lower-global-shared-view elem-ir-ty))
        [(Expr addr-state elem-ptr _)
          (Ok
            (Expr
              (lower-array-elem-store-state
                ctx
                (lower-state-record-latest-bounds-check-at-expr
                  ctx
                  addr-state
                  origin)
                elem-ptr
                value-ir
                elem-ir-ty)
              Unit
              (Unit)))])]
    [(Array _ elem-count)
      (match (lower-fixed-array-element-addr
        ctx
        state
        arr-value
        idx-value
        idx-ty
        (lower-global-shared-view elem-ir-ty)
        elem-count)
        [(Expr addr-state elem-ptr _)
          (if (= (lower-type-size ctx elem-ir-ty) 0)
            (Ok
              (Expr
                (lower-state-record-latest-bounds-check-at-expr
                  ctx
                  addr-state
                  origin)
                Unit
                (Unit)))
            (Ok
              (Expr
                (lower-array-elem-store-state
                  ctx
                  (lower-state-record-latest-bounds-check-at-expr
                    ctx
                    addr-state
                    origin)
                  elem-ptr
                  value-ir
                  elem-ir-ty)
                Unit
                (Unit))))])]
    [(Ref _ inner)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            arr
            "lower: set! array element requires mutable array access")))]
    [(MutRef _ inner)
      (if (lower-fat-reference? ctx inner)
        (match (lower-slice-element-addr
          ctx
          state
          arr-value
          container-ty
          idx-value
          idx-ty
          (lower-global-shared-view elem-ir-ty))
          [(Expr addr-state elem-ptr _)
            (if (= (lower-type-size ctx elem-ir-ty) 0)
              (Ok
                (Expr
                  (lower-state-record-latest-bounds-check-at-expr
                    ctx
                    addr-state
                    origin)
                  Unit
                  (Unit)))
              (Ok
                (Expr
                  (lower-array-elem-store-state
                    ctx
                    (lower-state-record-latest-bounds-check-at-expr
                      ctx
                      addr-state
                      origin)
                    elem-ptr
                    value-ir
                    elem-ir-ty)
                  Unit
                  (Unit))))])
        (Err
          (box
            (lower-diagnostic-at-expr
              ctx
              arr
              "lower: set! array element requires array type"))))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            arr
            "lower: set! array element requires array type")))]))

(define (lower-array-set-direct-store
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [origin : ast.AstExpr]
  [arr-value : ir.CompilerIrValue]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [container-ty : ast.AstType]
  [elem-ir-ty : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeDirectStore
  (if (and
    (> (lower-type-size ctx elem-ir-ty) 0)
    (lower-direct-store-target? ctx (lower-global-shared-view elem-ir-ty)))
    (match (tc_core.tc-type-strip-region
      (tc_core.tc-resolve-type ctx (lower-global-shared-view container-ty)))
      [(DynArray _)
        (match (lower-array-element-addr
          ctx
          state
          arr-value
          idx-value
          idx-ty
          (lower-global-shared-view elem-ir-ty))
          [(Expr addr-state elem-ptr _)
            (lower-direct-store-rhs-into
              ctx
              (lower-state-record-latest-bounds-check-at-expr
                ctx
                addr-state
                origin)
              env
              type-env
              elem-ptr
              (lower-global-shared-view value)
              elem-ir-ty
              value)])]
      [(Array _ elem-count)
        (match (lower-fixed-array-element-addr
          ctx
          state
          arr-value
          idx-value
          idx-ty
          (lower-global-shared-view elem-ir-ty)
          elem-count)
          [(Expr addr-state elem-ptr _)
            (lower-direct-store-rhs-into
              ctx
              (lower-state-record-latest-bounds-check-at-expr
                ctx
                addr-state
                origin)
              env
              type-env
              elem-ptr
              (lower-global-shared-view value)
              elem-ir-ty
              value)])]
      [(Ref _ inner)
        (Err
          (box
            (lower-diagnostic-at-expr
              ctx
              arr
              "lower: set! array element requires mutable array access")))]
      [(MutRef _ inner)
        (if (lower-fat-reference? ctx inner)
          (match (lower-slice-element-addr
            ctx
            state
            arr-value
            container-ty
            idx-value
            idx-ty
            (lower-global-shared-view elem-ir-ty))
            [(Expr addr-state elem-ptr _)
              (lower-direct-store-rhs-into
                ctx
                (lower-state-record-latest-bounds-check-at-expr
                  ctx
                  addr-state
                  origin)
                env
                type-env
                elem-ptr
                (lower-global-shared-view value)
                elem-ir-ty
                value)])
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                arr
                "lower: set! array element requires array type"))))]
      [_
        (Err
          (box
            (lower-diagnostic-at-expr
              ctx
              arr
              "lower: set! array element requires array type")))])
    (No)))

(define (lower-mutable-var-storage-address-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : i64]
  [place-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? local-id)
      (match (lower-state-alloc-var state)
        [(Alloc allocated var-id)
          (let
            [addr-state : LowerState
              (lower-state-emit-at-expr
                ctx
                allocated
                (AddrOf var-id local-id)
                origin)]
            (Ok
              (Expr
                (if (lower-type-register-resident?
                  ctx
                  (lower-global-shared-view place-ty))
                  (lower-state-register-address-taken-mark addr-state local-id)
                  addr-state)
                (Var var-id)
                place-ty)))])
      (Ok
        (Expr
          state
          (GlobalAddr (lower-resolve-name-symbol-id state name))
          place-ty)))))

(define (lower-mutable-var-address-id
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(Ok place-ty)
      (let
        [resolved : ast.AstType
          (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx (lower-global-shared-view place-ty)))]
        (match resolved
          [(MutRef _ referent-ty)
            (let
              [lowered (try (lower-var-id state env name place-ty))]
              (match lowered
                [(Expr ref-state ref-value _)
                  (Ok
                    (Expr
                      ref-state
                      ref-value
                      (tc_core.tc-context-type-get ctx referent-ty)))]))]
          [(Ref _ _)
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  "lower: set! struct field requires mutable struct access")))]
          [_
            (if (lower-borrow-place-value-reference?
              ctx
              (lower-global-shared-view place-ty))
              (lower-var-id state env name place-ty)
              (lower-mutable-var-storage-address-id
                ctx
                state
                env
                name
                place-ty
                origin))]))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx origin message)))]))

(define (lower-struct-field-address-from-place
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [receiver-ty : ast.AstType]
  [field : String]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view receiver-ty)))
    [(Struct struct-name)
      (let
        [info : LowerFieldInfo
          (try
            (lower-struct-field-info
              ctx
              struct-name
              (tc_core.tc-nominal-name-id-display struct-name)
              field))]
        (match info
          [(Info offset field-ty)
            (match (lower-gep-byte state base offset)
              [(Expr ptr-state ptr _)
                (Ok
                  (Expr
                    ptr-state
                    ptr
                    (tc_core.tc-type-without-regions field-ty)))])]))]
    [(StructArgs struct-name _)
      (let
        [info : LowerFieldInfo
          (try
            (lower-struct-field-info
              ctx
              struct-name
              (tc_core.tc-nominal-name-id-display struct-name)
              field))]
        (match info
          [(Info offset field-ty)
            (match (lower-gep-byte state base offset)
              [(Expr ptr-state ptr _)
                (Ok
                  (Expr
                    ptr-state
                    ptr
                    (tc_core.tc-type-without-regions field-ty)))])]))]
    [(MutRef _ referent-ty)
      (match (lower-emit-load state base receiver-ty)
        [(Expr ref-state ref-value _)
          (lower-struct-field-address-from-place
            ctx
            ref-state
            ref-value
            (tc_core.tc-context-type-get ctx referent-ty)
            field
            origin)])]
    [(Ref _ _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: set! struct field requires mutable struct access")))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: set! struct field requires struct")))]))

(define (lower-tuple-field-address-from-place
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [tuple-ty : ast.AstType]
  [index : i64]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view tuple-ty)))
    [(Tuple elem-tys)
      (let
        [info : LowerFieldInfo
          (try (lower-tuple-elem-info ctx (deref elem-tys) index 0 0))]
        (match info
          [(Info offset elem-ty)
            (match (lower-gep-byte state base offset)
              [(Expr ptr-state ptr _)
                (Ok
                  (Expr ptr-state ptr (tc_core.tc-type-without-regions elem-ty)))])]))]
    [(MutRef _ referent-ty)
      (match (lower-emit-load state base tuple-ty)
        [(Expr ref-state ref-value _)
          (lower-tuple-field-address-from-place
            ctx
            ref-state
            ref-value
            (tc_core.tc-context-type-get ctx referent-ty)
            index
            origin)])]
    [(Ref _ _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: set! struct field requires mutable tuple access")))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: tuple-ref requires tuple place")))]))

(define (lower-mutable-array-element-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [index : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    arr)
    [(Ok arr-ty)
      (match (tc_core.tc-array-set-receiver ctx arr-ty)
        [(Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (lower-borrow-array-element-address
                ctx
                state
                env
                type-env
                arr
                index
                origin
                (tc_core.tc-type-without-regions elem-ty))])]
        [(Err message)
          (Err (box (lower-diagnostic-at-expr ctx origin message)))])]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx arr message)))]))

(define (lower-mutable-place-address
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (ast.ast-expr-unspan place)
    [(Var name)
      (if (tc_core.tc-dotted-local-field-name-id? type-env name)
        (match (tc_core.tc-dotted-local-field-expr-id type-env name)
          [(Ok virtual-id)
            (lower-mutable-place-address
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin)]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx origin message)))])
        (lower-mutable-var-address-id ctx state env type-env name origin))]
    [(StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [lowered
          (try
            (lower-mutable-place-address
              ctx
              state
              env
              type-env
              receiver
              (lower-global-shared-view origin)))]
        (match lowered
          [(Expr receiver-state receiver-base receiver-ty)
            (lower-struct-field-address-from-place
              ctx
              receiver-state
              receiver-base
              receiver-ty
              (tc_core.tc-env-key-name-text field)
              origin)]))]
    [(TupleRef tuple-box index)
      (let
        [tuple : ast.AstExpr (lower-context-expr-get ctx tuple-box)]
        [lowered
          (try
            (lower-mutable-place-address
              ctx
              state
              env
              type-env
              tuple
              (lower-global-shared-view origin)))]
        (match lowered
          [(Expr tuple-state tuple-base tuple-ty)
            (lower-tuple-field-address-from-place
              ctx
              tuple-state
              tuple-base
              tuple-ty
              index
              origin)]))]
    [(ArrayRef arr-box index-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (lower-mutable-array-element-address
          ctx
          state
          env
          type-env
          arr
          index
          origin))]
    [(BoxGet box-box)
      (let
        [box-expr : ast.AstExpr (lower-context-expr-get ctx box-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          (lower-state-function-state state)
          box-expr)
          [(Ok box-ty)
            (match (tc_core.tc-box-set-inner-type ctx box-ty)
              [(Ok inner-ty)
                (lower-box-storage-address
                  ctx
                  state
                  env
                  type-env
                  box-expr
                  origin
                  (tc_core.tc-type-without-regions inner-ty)
                  false)]
              [(Err message)
                (Err (box (lower-diagnostic-at-expr ctx origin message)))])]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx box-expr message)))]))]
    [(BoxTake receiver-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          (lower-state-function-state state)
          receiver)
          [(Ok receiver-ty)
            (match (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (lower-global-shared-view receiver-ty)))
              ;; A field assignment through a raw pointer stores at its offset
              ;; from the pointer (`tc-raw-deref-whole-message`).
              [(MutPtr elem-ty)
                (tc_core.ResultTcType.Ok
                  (tc_core.tc-context-type-get ctx elem-ty))]
              [_ (tc_core.tc-box-set-inner-type ctx receiver-ty)])
              [(Ok inner-ty)
                (lower-box-storage-address
                  ctx
                  state
                  env
                  type-env
                  receiver
                  origin
                  (tc_core.tc-type-without-regions inner-ty)
                  false)]
              [(Err message)
                (Err (box (lower-diagnostic-at-expr ctx origin message)))])]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx receiver message)))]))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: set! target must be a storage place")))]))

(define (lower-struct-field-store-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [field-ptr : ir.CompilerIrValue]
  [value-ir : ir.CompilerIrValue]
  [field-ir-ty : ast.AstType]) : ResultLowerExpr
  (if (= (lower-type-size ctx field-ir-ty) 0)
    (Ok (Expr state Unit (Unit)))
    (Ok
      (Expr
        (if (lower-owned-handle-type?
          ctx
          (lower-global-shared-view field-ir-ty))
          (lower-store-owned-at-offset state field-ptr 0 value-ir field-ir-ty)
          (lower-store-inline-value-at-offset
            ctx
            state
            field-ptr
            0
            value-ir
            (lower-global-shared-view field-ir-ty)
            (lower-type-size ctx field-ir-ty)))
        Unit
        (Unit)))))

(define (lower-store-expr-into-address-result
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst : ir.CompilerIrValue]
  [value : ast.AstExpr]
  [value-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (if (> (lower-type-size ctx value-ty) 0)
    (match (lower-direct-store-rhs-into
      ctx
      state
      env
      type-env
      (lower-global-shared-view dst)
      (lower-global-shared-view value)
      (lower-global-shared-view value-ty)
      (lower-global-shared-view origin))
      [(Store done-state) (Ok (Expr done-state Unit (Unit)))]
      [(Err message) (Err message)]
      [(No)
        (let
          [value-lowered
            (try
              (lower-expr-expected
                ctx
                state
                env
                type-env
                value
                (lower-global-shared-view value-ty)
                origin))]
          (match value-lowered
            [(Expr value-state value-ir _)
              (lower-struct-field-store-result
                ctx
                value-state
                dst
                value-ir
                value-ty)]))])
    (let
      [value-lowered
        (try
          (lower-expr-expected
            ctx
            state
            env
            type-env
            value
            (lower-global-shared-view value-ty)
            origin))]
      (match value-lowered
        [(Expr value-state value-ir _)
          (lower-struct-field-store-result
            ctx
            value-state
            dst
            value-ir
            value-ty)]))))

(define (lower-box-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [box-expr : ast.AstExpr]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    box-expr)
    [(Ok box-ty)
      (match (tc_core.tc-box-set-inner-type ctx box-ty)
        [(Ok inner-ty)
          (let
            [inner-ir-ty : ast.AstType
              (tc_core.tc-type-without-regions inner-ty)]
            [place-lowered
              (try
                (lower-box-storage-address
                  ctx
                  state
                  env
                  type-env
                  box-expr
                  origin
                  (lower-global-shared-view inner-ir-ty)
                  false))]
            (match place-lowered
              [(Expr place-state box-ptr _)
                (lower-store-expr-into-address-result
                  ctx
                  place-state
                  env
                  type-env
                  box-ptr
                  (lower-global-shared-view value)
                  inner-ir-ty
                  value)]))]
        [(Err message)
          (Err (box (lower-diagnostic-at-expr ctx origin message)))])]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx box-expr message)))]))

(define (lower-refresh-register-resident-root-after-store
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (tc_core.tc-move-root-projection-var-id
    (tc_core.tc-context-expr-bases ctx)
    place)
    [(Some root-id)
      (let
        [local-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            root-id
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? local-id)
          (match (tc_core.tc-lookup-id type-env root-id)
            [(Ok root-ty)
              (let
                [resolved : ast.AstType
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx root-ty))]
                (if (lower-type-register-resident?
                  ctx
                  (lower-global-shared-view resolved))
                  (match (lower-state-alloc-var state)
                    [(Alloc addr-alloc addr-var)
                      (match (lower-load-register-resident-from-ptr
                        ctx
                        (lower-state-emit-at-expr
                          ctx
                          addr-alloc
                          (AddrOf addr-var local-id)
                          (lower-global-shared-view origin))
                        (Var addr-var)
                        (lower-global-shared-view resolved))
                        [(Expr load-state loaded _)
                          (Ok
                            (lower-state-emit-at-expr
                              ctx
                              load-state
                              (Mov local-id loaded resolved)
                              origin))])])
                  (Ok state)))]
            [(Err message)
              (Err (box (lower-diagnostic-at-expr ctx origin message)))])
          (Ok state)))]
    [(No) (Ok state)]))

(define (lower-replace
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]
  [replacement : ast.AstExpr]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (let
    [addressed
      (try
        (lower-mutable-place-address
          ctx
          state
          env
          type-env
          (lower-global-shared-view place)
          (lower-global-shared-view origin)))]
    (match addressed
      [(Expr place-state place-ptr place-ty)
        (let
          [value-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx place-ty))]
          [lowered-replacement
            (try
              (lower-expr-expected
                ctx
                place-state
                env
                type-env
                (lower-global-shared-view replacement)
                (lower-global-shared-view value-ty)
                replacement))]
          (match lowered-replacement
            [(Expr replacement-state replacement-value _)
              (let
                [old
                  (try
                    (lower-place-old-value
                      ctx
                      replacement-state
                      (lower-global-shared-view place-ptr)
                      (lower-global-shared-view value-ty)))]
                (match old
                  [(Expr old-state old-value _)
                    (let
                      [stored-state : LowerState
                        (if (= (lower-type-size ctx value-ty) 0)
                          old-state
                          (lower-array-elem-store-state
                            ctx
                            old-state
                            place-ptr
                            replacement-value
                            value-ty))]
                      [refreshed : LowerState
                        (try
                          (lower-refresh-register-resident-root-after-store
                            ctx
                            stored-state
                            env
                            type-env
                            place
                            origin))]
                      (Ok (Expr refreshed old-value result-ty)))]))]))])))

(define (lower-register-resident-local-place?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [receiver : ast.AstExpr]
  [receiver-ty : ast.AstType]) : bool
  (if (lower-type-register-resident? ctx receiver-ty)
    (match (ast.ast-expr-unspan receiver)
      [(Var name) (sym_i64_env.sym-i64-contains-id env name)]
      [_ false])
    false))

(define (lower-reload-register-resident-local-from-storage
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [storage-ptr : ir.CompilerIrValue]
  [local-id : i64]
  [receiver-ir-ty : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (lower-load-register-resident-from-ptr
    ctx
    state
    storage-ptr
    (lower-global-shared-view receiver-ir-ty))
    [(Expr load-state loaded _)
      (Ok
        (Expr
          (lower-state-emit-at-expr
            ctx
            load-state
            (Mov local-id loaded receiver-ir-ty)
            origin)
          Unit
          (Unit)))]))

(define (lower-struct-set-register-resident-local
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [receiver-ty : ast.AstType]
  [field : String]
  [field-ir-ty : ast.AstType]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (ast.ast-expr-unspan receiver)
    [(Var name)
      (let
        [local-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? local-id)
          (let
            [receiver-ir-ty : ast.AstType
              (tc_core.tc-type-without-regions
                (tc_core.tc-resolve-type ctx receiver-ty))]
            [receiver-size : i64 (lower-type-size ctx receiver-ir-ty)]
            (match (lower-reserve-inline-storage
              state
              (if (= receiver-size 0)
                1
                receiver-size)
              receiver-ir-ty)
              [(Expr storage-state storage-ptr _)
                (let
                  [stored-root-state : LowerState
                    (if (= receiver-size 0)
                      storage-state
                      (lower-store-inline-value-at-offset
                        ctx
                        storage-state
                        storage-ptr
                        0
                        (Var local-id)
                        (lower-global-shared-view receiver-ir-ty)
                        receiver-size))]
                  [place-lowered
                    (try
                      (lower-struct-field-address-from-place
                        ctx
                        stored-root-state
                        (lower-global-shared-view storage-ptr)
                        (lower-global-shared-view receiver-ir-ty)
                        field
                        (lower-global-shared-view origin)))]
                  (match place-lowered
                    [(Expr place-state field-ptr _)
                      (let
                        [stored-field
                          (try
                            (lower-store-expr-into-address-result
                              ctx
                              place-state
                              env
                              type-env
                              field-ptr
                              (lower-global-shared-view value)
                              field-ir-ty
                              value))]
                        (match stored-field
                          [(Expr store-state _ _)
                            (lower-reload-register-resident-local-from-storage
                              ctx
                              store-state
                              storage-ptr
                              local-id
                              receiver-ir-ty
                              origin)]))]))]))
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                origin
                "lower: set! struct field requires local storage")))))]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: set! struct field requires local storage")))]))

(define (lower-tuple-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [receiver-ty : ast.AstType]
  [index : i64]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-tuple-set-element-type ctx receiver-ty index)
    [(Ok elem-ty)
      (let
        [elem-ir-ty : ast.AstType (tc_core.tc-type-without-regions elem-ty)]
        [place-lowered
          (try
            (lower-mutable-place-address
              ctx
              state
              env
              type-env
              (lower-global-shared-view receiver)
              (lower-global-shared-view origin)))]
        (match place-lowered
          [(Expr place-state place-ptr place-ty)
            (let
              [elem-lowered
                (try
                  (lower-tuple-field-address-from-place
                    ctx
                    place-state
                    place-ptr
                    place-ty
                    index
                    (lower-global-shared-view origin)))]
              (match elem-lowered
                [(Expr elem-state elem-ptr _)
                  (let
                    [stored
                      (try
                        (lower-store-expr-into-address-result
                          ctx
                          elem-state
                          env
                          type-env
                          elem-ptr
                          (lower-global-shared-view value)
                          elem-ir-ty
                          value))]
                    (match stored
                      [(Expr store-state _ _)
                        (let
                          [refreshed-state : LowerState
                            (try
                              (lower-refresh-register-resident-root-after-store
                                ctx
                                store-state
                                env
                                type-env
                                receiver
                                origin))]
                          (Ok (Expr refreshed-state Unit (Unit))))]))]))]))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx origin message)))]))

(define (lower-struct-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [receiver : ast.AstExpr]
  [field-id : i64]
  [value : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    receiver)
    [(Ok receiver-ty) (tc_core.ResultTcType.Ok receiver-ty)]
    ;; A raw-pointer `deref` has a type only as a field receiver.
    [(Err _)
      (tc_core.tc-field-receiver-type
        ctx
        type-env
        (lower-global-shared-view receiver))])
    [(Ok receiver-ty)
      (if (ast.ast-tuple-set-field-id? field-id)
        (lower-tuple-set
          ctx
          state
          env
          type-env
          receiver
          receiver-ty
          (ast.ast-tuple-set-index-from-field-id field-id)
          value
          origin)
        (match (tc_core.tc-struct-set-field-type-id
          ctx
          (lower-global-shared-view receiver-ty)
          field-id)
          [(Ok field-ty)
            (let
              [field : String (tc_core.tc-env-key-name-text field-id)]
              [field-ir-ty : ast.AstType
                (tc_core.tc-type-without-regions field-ty)]
              (if (lower-register-resident-local-place?
                ctx
                env
                (lower-global-shared-view receiver)
                (lower-global-shared-view receiver-ty))
                (lower-struct-set-register-resident-local
                  ctx
                  state
                  env
                  type-env
                  receiver
                  receiver-ty
                  field
                  field-ir-ty
                  value
                  origin)
                (let
                  [place-lowered
                    (try
                      (lower-mutable-place-address
                        ctx
                        state
                        env
                        type-env
                        (lower-global-shared-view receiver)
                        (lower-global-shared-view origin)))]
                  (match place-lowered
                    [(Expr place-state place-ptr place-ty)
                      (let
                        [field-lowered
                          (try
                            (lower-struct-field-address-from-place
                              ctx
                              place-state
                              place-ptr
                              place-ty
                              field
                              (lower-global-shared-view origin)))]
                        (match field-lowered
                          [(Expr field-state field-ptr _)
                            (let
                              [stored
                                (try
                                  (lower-store-expr-into-address-result
                                    ctx
                                    field-state
                                    env
                                    type-env
                                    field-ptr
                                    (lower-global-shared-view value)
                                    field-ir-ty
                                    value))]
                              (match stored
                                [(Expr store-state _ _)
                                  (let
                                    [refreshed-state : LowerState
                                      (try
                                        (lower-refresh-register-resident-root-after-store
                                          ctx
                                          store-state
                                          env
                                          type-env
                                          receiver
                                          origin))]
                                    (Ok (Expr refreshed-state Unit (Unit))))]))]))]))))]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx origin message)))]))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx receiver message)))]))

(define (lower-array-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [index : ast.AstExpr]
  [value : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    arr)
    [(Ok arr-ty)
      (match (tc_core.tc-array-set-receiver ctx arr-ty)
        [(Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (let
                [elem-ir-ty : ast.AstType
                  (tc_core.tc-type-without-regions elem-ty)]
                [arr-lowered
                  (try
                    (lower-expr
                      ctx
                      state
                      env
                      type-env
                      (lower-global-shared-view arr)))]
                (match arr-lowered
                  [(Expr arr-state arr-value _)
                    (match (lower-index-result-type-or-check
                      ctx
                      env
                      type-env
                      (lower-state-type-cache arr-state)
                      (lower-state-function-state arr-state)
                      (lower-global-shared-view index))
                      [(Ok idx-ty)
                        (let
                          [idx-lowered
                            (try
                              (lower-expr-expected
                                ctx
                                arr-state
                                env
                                type-env
                                (lower-global-shared-view index)
                                idx-ty
                                (lower-global-shared-view index)))]
                          (match idx-lowered
                            [(Expr idx-state idx-value idx-value-ty)
                              (match (lower-array-set-direct-store
                                ctx
                                (lower-state-clone idx-state)
                                env
                                type-env
                                (lower-global-shared-view arr)
                                (lower-global-shared-view index)
                                (lower-global-shared-view arr-value)
                                (lower-global-shared-view idx-value)
                                (lower-global-shared-view idx-value-ty)
                                (lower-global-shared-view container-ty)
                                (lower-global-shared-view elem-ir-ty)
                                (lower-global-shared-view value))
                                [(Store direct-state)
                                  (Ok (Expr direct-state Unit (Unit)))]
                                [(Err message) (Err message)]
                                [(No)
                                  (let
                                    [value-lowered
                                      (try
                                        (lower-expr-expected
                                          ctx
                                          idx-state
                                          env
                                          type-env
                                          (lower-global-shared-view value)
                                          (lower-global-shared-view elem-ir-ty)
                                          value))]
                                    (match value-lowered
                                      [(Expr value-state value-ir _)
                                        (lower-array-set-store-materialized
                                          ctx
                                          value-state
                                          arr
                                          index
                                          arr-value
                                          idx-value
                                          idx-value-ty
                                          container-ty
                                          elem-ir-ty
                                          value-ir)]))])]))]
                      [(Err message)
                        (Err (box (lower-diagnostic-at-expr ctx index message)))])]))])]
        [(Err message) (Err (box (lower-diagnostic-at-expr ctx arr message)))])]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx arr message)))]))

;; Copy old dynamic-array elements into a freshly allocated buffer. The loop is
;; emitted as explicit IR so `array-push!` works for runtime lengths.
(define (lower-array-push-copy-loop
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [old-buf : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [old-len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]) : LowerState
  (match (lower-state-fresh-label state "array_push_copy_header")
    [(Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "array_push_copy_body")
        [(Label body-label-state body-label)
          (match (lower-state-fresh-label
            body-label-state
            "array_push_copy_exit")
            [(Label exit-label-state exit-label)
              (match (lower-state-alloc-var exit-label-state)
                [(Alloc index-alloc index-var)
                  (let
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            index-alloc
                            (Mov index-var (I64 0) (I64)))
                          (Jump header-label))
                        header-label)]
                    (match (lower-state-alloc-var header-start)
                      [(Alloc cond-alloc cond-var)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                (lower-state-emit
                                  cond-alloc
                                  (BinOp
                                    cond-var
                                    Lt
                                    (Var index-var)
                                    old-len
                                    (I64)))
                                (Branch (Var cond-var) body-label exit-label))
                              body-label)]
                          (match (lower-emit-elem-addr-gep
                            ctx
                            body-start
                            old-buf
                            (Var index-var)
                            (lower-global-shared-view elem-ty))
                            [(Expr src-gep-state src-ptr _)
                              (match (lower-load-inline-value-at-offset
                                ctx
                                src-gep-state
                                src-ptr
                                0
                                (lower-global-shared-view elem-ty))
                                [(Expr load-state elem-value _)
                                  (match (lower-emit-elem-addr-gep
                                    ctx
                                    load-state
                                    new-buf
                                    (Var index-var)
                                    (lower-global-shared-view elem-ty))
                                    [(Expr dst-gep-state dst-ptr _)
                                      (match (lower-state-alloc-var
                                        (lower-array-elem-store-state
                                          ctx
                                          dst-gep-state
                                          dst-ptr
                                          elem-value
                                          elem-ty))
                                        [(Alloc inc-alloc inc-var)
                                          (lower-state-finish-block
                                            (lower-state-emit
                                              (lower-state-emit
                                                (lower-state-emit
                                                  inc-alloc
                                                  (BinOp
                                                    inc-var
                                                    Add
                                                    (Var index-var)
                                                    (I64 1)
                                                    (I64)))
                                                (Mov
                                                  index-var
                                                  (Var inc-var)
                                                  (I64)))
                                              (Jump header-label))
                                            exit-label)])])])]))]))])])])]))

(define (lower-array-push-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [old-buf : ir.CompilerIrValue]
  [old-len : ir.CompilerIrValue]
  [new-buf : ir.CompilerIrValue]
  [new-len : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : LowerExpr
  (match (lower-emit-elem-addr-gep
    ctx
    (lower-array-push-copy-loop
      ctx
      state
      old-buf
      (lower-global-shared-view new-buf)
      (lower-global-shared-view old-len)
      (lower-global-shared-view elem-ty))
    (lower-global-shared-view new-buf)
    old-len
    (lower-global-shared-view elem-ty))
    [(Expr tail-gep-state tail-ptr _)
      (Expr
        (lower-store-at-offset
          (lower-store-at-offset
            (lower-array-elem-store-state
              ctx
              tail-gep-state
              tail-ptr
              value-ir
              elem-ty)
            arr-value
            0
            new-buf
            (U64))
          arr-value
          8
          new-len
          (I64))
        Unit
        (Unit))]))

(define (lower-array-push-alloc-buffer
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [old-buf : ir.CompilerIrValue]
  [old-len : ir.CompilerIrValue]
  [elem-size : i64]
  [elem-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : LowerExpr
  (match (lower-emit-binop
    state
    Add
    (lower-global-shared-view old-len)
    (I64 1)
    (I64))
    [(Expr len-state new-len _)
      (match (lower-emit-binop
        len-state
        Mul
        (lower-global-shared-view new-len)
        (I64 elem-size)
        (I64))
        [(Expr byte-state byte-count _)
          (match (lower-state-alloc-var byte-state)
            [(Alloc buf-alloc buf-var)
              (lower-array-push-finish
                ctx
                (lower-state-emit
                  buf-alloc
                  (Call buf-var (lower-tl-alloc-symbol) (One byte-count) (U64)))
                arr-value
                old-buf
                old-len
                (Var buf-var)
                new-len
                elem-ty
                value-ir)])])]))

(define (lower-array-push-after-max-check
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [fail-label : i64]
  [alloc-label : i64]
  [arr-value : ir.CompilerIrValue]
  [old-buf : ir.CompilerIrValue]
  [old-len : ir.CompilerIrValue]
  [elem-size : i64]
  [elem-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : LowerExpr
  (let
    [fail-start : LowerState (lower-state-finish-block state fail-label)]
    [alloc-start : LowerState
      (lower-state-finish-block
        (lower-state-emit (lower-oob-abort fail-start) (Jump alloc-label))
        alloc-label)]
    (lower-array-push-alloc-buffer
      ctx
      alloc-start
      arr-value
      old-buf
      old-len
      elem-size
      elem-ty
      value-ir)))

(define (lower-array-push-from-values
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [value-ir : ir.CompilerIrValue]) : LowerExpr
  (match (lower-load-at-offset state arr-value 8 (I64))
    [(Expr len-state old-len _)
      (match (lower-load-at-offset len-state arr-value 0 (U64))
        [(Expr buf-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            [max-old-len : i64
              (if (= elem-size 0)
                9223372036854775806
                (- (/ 9223372036854775807 elem-size) 1))]
            (match (lower-state-fresh-label buf-state "array_push_alloc")
              [(Label alloc-label-state alloc-label)
                (match (lower-state-fresh-label
                  alloc-label-state
                  "array_push_fail")
                  [(Label fail-label-state fail-label)
                    (match (lower-emit-binop
                      fail-label-state
                      Le
                      (lower-global-shared-view old-len)
                      (I64 max-old-len)
                      (I64))
                      [(Expr check-state within-max _)
                        (lower-array-push-after-max-check
                          ctx
                          (lower-state-emit
                            check-state
                            (Branch within-max alloc-label fail-label))
                          fail-label
                          alloc-label
                          arr-value
                          old-buf
                          old-len
                          elem-size
                          elem-ty
                          value-ir)])])]))])]))

;; `(__tl_array-push! arr value)` -> allocate a new element buffer in the active
;; arena, copy old elements, append `value`, and update the fat `{ptr, len}`.
(define (lower-array-push
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arr : ast.AstExpr]
  [value : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    arr)
    [(Ok arr-ty)
      (match (tc_core.tc-array-push-receiver ctx arr-ty)
        [(Ok receiver)
          (match receiver
            [(TcArrayReceiver _ elem-ty)
              (let
                [elem-ir-ty : ast.AstType
                  (tc_core.tc-type-without-regions elem-ty)]
                [arr-lowered : LowerExpr
                  (try (lower-expr ctx state env type-env arr))]
                (match arr-lowered
                  [(Expr arr-state arr-value _)
                    (let
                      [value-lowered
                        (try
                          (lower-expr-expected
                            ctx
                            arr-state
                            env
                            type-env
                            (lower-global-shared-view value)
                            (lower-global-shared-view elem-ir-ty)
                            value))]
                      (match value-lowered
                        [(Expr value-state value-ir _)
                          (Ok
                            (lower-array-push-from-values
                              ctx
                              value-state
                              arr-value
                              elem-ir-ty
                              value-ir))]))]))])]
        [(Err message) (Err (box (lower-diagnostic-at-expr ctx arr message)))])]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx arr message)))]))

;; Lower each syscall operand and widen it to i64 (the kernel reads the full
;; 64-bit registers). Mirrors `lower-args` but inserts the cast.
(define (lower-syscall-args
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]) : ResultLowerArgs
  (lower-syscall-args-at ctx state env type-env (& args) 0))

(define (lower-syscall-args-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index args.len)
    (Ok state (ir.compiler-ir-value-seq-empty))
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      [lowered (try (lower-expr ctx state env type-env arg))]
      (match lowered
        [(Expr arg-state value value-ty)
          (match (lower-cast-value arg-state value value-ty (I64))
            [(Expr cast-state cast-value _)
              (match (lower-syscall-args-at
                ctx
                cast-state
                env
                type-env
                args
                (+ index 1))
                [(Ok rest-state rest-values)
                  (Ok
                    rest-state
                    (ir.compiler-ir-value-seq-prepend cast-value rest-values))]
                [(Err message) (Err message)])])]))))

(define (lower-syscall
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]) : ResultLowerExpr
  (match (lower-syscall-args ctx state env type-env args)
    [(Ok args-state values)
      (match (lower-state-alloc-var args-state)
        [(Alloc allocated var-id)
          (Ok
            (Expr
              (lower-state-emit
                allocated
                (Syscall var-id (ir.compiler-ir-call-args-from-seq values)))
              (Var var-id)
              (I64)))])]
    [(Err message) (Err message)]))

(define (lower-args
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]) : ResultLowerArgs
  (lower-args-at ctx state env type-env (& args) 0))

(define (lower-args-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index args.len)
    (Ok state (ir.compiler-ir-value-seq-empty))
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      [lowered (try (lower-expr ctx state env type-env arg))]
      (match lowered
        [(Expr arg-state value _)
          (match (lower-args-at ctx arg-state env type-env args (+ index 1))
            [(Ok rest-state rest-values)
              (Ok
                rest-state
                (ir.compiler-ir-value-seq-prepend value rest-values))]
            [(Err message) (Err message)])]))))

(define (lower-let-binding-type
  [ctx : tc_core.TcContext]
  [maybe-ty : ast.AstMaybeType]
  [init-ty : ast.AstType]) : ast.AstType
  (match maybe-ty
    [(Some ty)
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    [(No) (tc_core.tc-type-without-regions init-ty)]))

(define (lower-let-init
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]) : ResultLowerExpr
  (match maybe-ty
    [(Some ty)
      (if (tc_core.tc-ref-capturing-lambda-init?
        (tc_core.tc-context-expr-bases ctx)
        type-env
        (lower-global-shared-view init))
        (match (ast.ast-expr-unspan (lower-global-shared-view init))
          [(Lambda lambda-box)
            (match (__tl-box-place lambda-box)
              [(Lambda params lambda-ret body-box)
                (let
                  [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
                  [expected-ty : ast.AstType
                    (tc_core.tc-type-without-regions
                      (tc_core.tc-resolve-type ctx ty))]
                  [lowered
                    (try
                      (lower-lambda
                        ctx
                        state
                        env
                        type-env
                        params
                        lambda-ret
                        body
                        init
                        (lower-global-shared-view expected-ty)))]
                  (match lowered
                    [(Expr next-state value actual-ty)
                      (Ok
                        (lower-coerce-value
                          next-state
                          value
                          actual-ty
                          expected-ty))]))])]
          [_
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view init)
              (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))
              init)])
        (lower-expr-expected
          ctx
          state
          env
          type-env
          (lower-global-shared-view init)
          (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))
          init))]
    [(No)
      (if (tc_core.tc-ref-capturing-lambda-init?
        (tc_core.tc-context-expr-bases ctx)
        type-env
        (lower-global-shared-view init))
        (match (ast.ast-expr-unspan (lower-global-shared-view init))
          [(Lambda lambda-box)
            (match (__tl-box-place lambda-box)
              [(Lambda params lambda-ret body-box)
                (let
                  [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
                  (match (tc_core.tc-lambda-expr-allow-ref-captures
                    ctx
                    type-env
                    (lower-global-shared-view params)
                    (lower-global-shared-view lambda-ret)
                    (lower-global-shared-view body))
                    [(Ok lambda-ty)
                      (lower-lambda
                        ctx
                        state
                        env
                        type-env
                        params
                        lambda-ret
                        body
                        init
                        lambda-ty)]
                    [(Err message)
                      (Err (box (lower-diagnostic-at-expr ctx init message)))]))])]
          [_ (lower-expr ctx state env type-env init)])
        (lower-expr ctx state env type-env init))]))

(define (lower-let-bindings
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : ast.AstLetBindingList]) : ResultLowerEnv
  (lower-let-bindings-at ctx state env type-env (& bindings) 0))

(define (lower-let-bindings-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : ResultLowerEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok state env type-env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [name-id : i64 name]
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [lowered
            (try
              (lower-let-init
                ctx
                state
                env
                type-env
                (lower-global-shared-view maybe-ty)
                (lower-global-shared-view init)))]
          (match lowered
            [(Expr init-state init-value init-ty)
              (let
                [binding-ty : ast.AstType
                  (lower-let-binding-type ctx maybe-ty init-ty)]
                [_debug-type : unit
                  (lower-debug-type-root!
                    (lower-state-owner init-state)
                    ctx
                    (lower-global-shared-view binding-ty))]
                [binding-ir-ty : ast.AstType
                  (lower-one-word-register-storage-type ctx binding-ty)]
                (match (lower-state-alloc-var init-state)
                  [(Alloc allocated var-id)
                    (let
                      [next-type-env : tc_core.TcTypeEnv
                        (tc_core.tc-bind-initialized-value-id
                          ctx
                          type-env
                          name-id
                          binding-ty
                          init)]
                      (lower-let-bindings-at
                        ctx
                        (lower-state-emit
                          allocated
                          (Mov var-id init-value binding-ir-ty))
                        (sym_i64_env.sym-i64-bind-id env name-id var-id)
                        next-type-env
                        bindings
                        (+ index 1)))]))]))])))

(define (lower-resource-bindings
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : ast.AstResourceBindingList]
  [cleanups : LowerCleanupStack]) : ResultLowerResourceBindings
  (lower-resource-bindings-at ctx state env type-env (& bindings) cleanups 0))

(define (lower-resource-bindings-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [cleanups : LowerCleanupStack]
  [index : i64]) : ResultLowerResourceBindings
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (Ok (Bindings state env type-env cleanups))
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name init-box cleanup-box move-aware?)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [cleanup : ast.AstExpr (lower-context-expr-get ctx cleanup-box)]
          (match (tc_core.tc-resource-cleanup-resource-type
            ctx
            type-env
            (lower-global-shared-view cleanup))
            [(Ok expected-init-ty)
              (let
                [lowered
                  (try
                    (lower-expr-expected
                      ctx
                      state
                      env
                      type-env
                      (lower-global-shared-view init)
                      (tc_core.tc-type-without-regions expected-init-ty)
                      init))]
                (match lowered
                  [(Expr init-state init-value init-ty)
                    (match (lower-cleanup-name-id-from-expr
                      (lower-global-shared-view cleanup))
                      [(Ok cleanup-name-id)
                        (let
                          [binding-ty : ast.AstType
                            (tc_core.tc-type-without-regions init-ty)]
                          [binding-ir-ty : ast.AstType
                            (lower-one-word-register-storage-type
                              ctx
                              binding-ty)]
                          (match (lower-state-alloc-var init-state)
                            [(Alloc allocated var-id)
                              (let
                                [hidden-name-id : i64
                                  (cis.intern-lower-private-identity-raw
                                    (lower-cleanup-hidden-name-id
                                      allocated
                                      var-id))]
                                [bound-state : LowerState
                                  (lower-state-emit
                                    allocated
                                    (Mov var-id init-value binding-ir-ty))]
                                [bound-env : sym_i64_env.SymI64Env
                                  (sym_i64_env.sym-i64-bind-id
                                    (sym_i64_env.sym-i64-bind-id
                                      env
                                      name
                                      var-id)
                                    hidden-name-id
                                    var-id)]
                                [bound-type-env : tc_core.TcTypeEnv
                                  (lower-type-env-push-cleanup
                                    bound-state
                                    (tc_core.tc-bind-id
                                      type-env
                                      name
                                      (lower-global-shared-view binding-ty))
                                    hidden-name-id
                                    cleanup-name-id)]
                                (if move-aware?
                                  (match (lower-state-alloc-var bound-state)
                                    [(Alloc live-state live-var-id)
                                      (let
                                        [live-name-id : i64
                                          (cis.intern-lower-private-identity-raw
                                            (lower-cleanup-live-name-id
                                              live-state
                                              var-id))]
                                        [move-aware-type-env : tc_core.TcTypeEnv
                                          (lower-type-env-push-move-aware-cleanup
                                            live-state
                                            (tc_core.tc-bind-id
                                              type-env
                                              name
                                              binding-ty)
                                            hidden-name-id
                                            cleanup-name-id
                                            live-name-id)]
                                        (lower-resource-bindings-at
                                          ctx
                                          (lower-state-emit
                                            live-state
                                            (Mov live-var-id (Bool true) (Bool)))
                                          (sym_i64_env.sym-i64-bind-id
                                            bound-env
                                            live-name-id
                                            live-var-id)
                                          move-aware-type-env
                                          bindings
                                          (lower-cleanup-stack-push-move-aware
                                            cleanups
                                            hidden-name-id
                                            cleanup-name-id
                                            live-name-id)
                                          (+ index 1)))])
                                  (lower-resource-bindings-at
                                    ctx
                                    bound-state
                                    bound-env
                                    bound-type-env
                                    bindings
                                    (lower-cleanup-stack-push
                                      cleanups
                                      hidden-name-id
                                      cleanup-name-id)
                                    (+ index 1))))]))]
                      [(Err message)
                        (Err
                          (box (lower-diagnostic-at-expr ctx cleanup message)))])]))]
            [(Err message)
              (Err (box (lower-diagnostic-at-expr ctx cleanup message)))]))])))

(define (lower-with-resource
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : ast.AstResourceBindingList]
  [body : ast.AstExprList]) : ResultLowerExpr
  (let
    [lowered-bindings : LowerResourceBindings
      (try
        (lower-resource-bindings
          ctx
          state
          env
          type-env
          bindings
          (lower-cleanup-stack-empty)))]
    (match lowered-bindings
      [(Bindings binding-state body-env body-type-env cleanups)
        (let
          [lowered-body : LowerExpr
            (try (lower-begin ctx binding-state body-env body-type-env body))]
          (match lowered-body
            [(Expr body-state value body-ty)
              (if (tc_core.tc-never-type? (lower-global-shared-view body-ty))
                (Ok (Expr body-state value body-ty))
                (let
                  [cleanup-state : LowerState
                    (try
                      (lower-emit-cleanup-stack body-state body-env cleanups))]
                  (Ok (Expr cleanup-state value body-ty))))]))])))

(define (lower-begin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultLowerExpr
  (lower-begin-at ctx state env type-env (& exprs) 0))

(define (lower-begin-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultLowerExpr
  (let
    [len : i64 exprs.len]
    (if (>= index len)
      (Ok (Expr state Unit (Unit)))
      (let
        [expr : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
        (if (= (+ index 1) len)
          (lower-expr ctx state env type-env expr)
          (let
            [lowered : LowerExpr (try (lower-expr ctx state env type-env expr))]
            (match lowered
              [(Expr next-state _ expr-ty)
                (if (tc_core.tc-never-type? expr-ty)
                  (Ok (Expr next-state Unit (Never)))
                  (lower-begin-at ctx next-state env type-env exprs (+ index 1)))])))))))

(define (lower-begin-expected
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (lower-begin-expected-at ctx state env type-env (& exprs) 0 expected-ty))

(define (lower-begin-expected-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (let
    [len : i64 exprs.len]
    (if (>= index len)
      (Ok (Expr state Unit (Unit)))
      (let
        [expr : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
        (if (= (+ index 1) len)
          (lower-expr-expected
            ctx
            state
            env
            type-env
            (lower-global-shared-view expr)
            expected-ty
            expr)
          (let
            [lowered : LowerExpr (try (lower-expr ctx state env type-env expr))]
            (match lowered
              [(Expr next-state _ expr-ty)
                (if (tc_core.tc-never-type? expr-ty)
                  (Ok (Expr next-state Unit (Never)))
                  (lower-begin-expected-at
                    ctx
                    next-state
                    env
                    type-env
                    exprs
                    (+ index 1)
                    expected-ty))])))))))

(define (lower-with-arena
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [body : ast.AstExprList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc mark-allocated mark-var)
      (let
        [hidden-name-id : i64
          (cis.intern-lower-private-identity-raw
            (lower-region-hidden-name-id mark-allocated mark-var))]
        [marked-state : LowerState
          (lower-state-emit
            mark-allocated
            (Call mark-var (lower-tl-region-mark-symbol) (Nil) (U64)))]
        [region-env : sym_i64_env.SymI64Env
          (sym_i64_env.sym-i64-bind-id env hidden-name-id mark-var)]
        [region-type-env : tc_core.TcTypeEnv
          (lower-type-env-push-region-reset
            marked-state
            type-env
            hidden-name-id)]
        [lowered : LowerExpr
          (try (lower-begin ctx marked-state region-env region-type-env body))]
        (match lowered
          [(Expr body-state value body-ty)
            (if (tc_core.tc-never-type? (lower-global-shared-view body-ty))
              (Ok (Expr body-state value body-ty))
              (match (lower-state-alloc-var body-state)
                [(Alloc reset-allocated reset-var)
                  (Ok
                    (Expr
                      (lower-state-emit
                        reset-allocated
                        (Call
                          reset-var
                          (lower-tl-region-reset-symbol)
                          (One (Var mark-var))
                          (Unit)))
                      value
                      body-ty))]))]))]))

(define (lower-arena-handle
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arena : ast.AstExpr]
  [form : String]) : ResultLowerExpr
  (let
    [lowered : LowerExpr (try (lower-expr ctx state env type-env arena))]
    (match lowered
      [(Expr arena-state arena-value arena-ty)
        (if (tc_core.tc-arena-type? ctx (lower-global-shared-view arena-ty))
          (lower-struct-get-named
            ctx
            arena-state
            arena-value
            (let
              [ty
                (tc_core.tc-resolve-type
                  ctx
                  (lower-global-shared-view arena-ty))]
              (lower-struct-type-name-id-or ty -1))
            (lower-struct-type-name-or-empty
              (tc_core.tc-resolve-type ctx arena-ty))
            "handle"
            (I64))
          (Err
            (box
              (lower-diagnostic
                (str_cat.str-cat "lower: " form " arena must be Arena")))))])))

(define (lower-in-arena
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [arena : ast.AstExpr]
  [body : ast.AstExprList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc saved-allocated saved-var)
      (let
        [saved-state : LowerState
          (lower-state-emit
            saved-allocated
            (Call saved-var (lower-tl-arena-current-symbol) Nil (I64)))]
        [arena-lowered : LowerExpr
          (try
            (lower-arena-handle ctx saved-state env type-env arena "in-arena"))]
        (match arena-lowered
          [(Expr arena-state arena-value _)
            (let
              [set-lowered : LowerExpr
                (try
                  (lower-runtime-call-values
                    arena-state
                    (lower-tl-arena-set-symbol)
                    (ir.compiler-ir-value-seq1 arena-value)
                    (Unit)))]
              (match set-lowered
                [(Expr set-state _ _)
                  (let
                    [hidden-name-id : i64
                      (cis.intern-lower-private-identity-raw
                        (lower-arena-restore-hidden-name-id set-state saved-var))]
                    [body-env : sym_i64_env.SymI64Env
                      (sym_i64_env.sym-i64-bind-id env hidden-name-id saved-var)]
                    [body-type-env : tc_core.TcTypeEnv
                      (lower-type-env-push-arena-restore
                        set-state
                        type-env
                        hidden-name-id)]
                    [body-lowered : LowerExpr
                      (try
                        (lower-begin ctx set-state body-env body-type-env body))]
                    (match body-lowered
                      [(Expr body-state value body-ty)
                        (if (tc_core.tc-never-type?
                          (lower-global-shared-view body-ty))
                          (Ok (Expr body-state value body-ty))
                          (let
                            [restore-lowered : LowerExpr
                              (try
                                (lower-runtime-call-values
                                  body-state
                                  (lower-tl-arena-set-symbol)
                                  (ir.compiler-ir-value-seq1 (Var saved-var))
                                  (Unit)))]
                            (match restore-lowered
                              [(Expr restore-state _ _)
                                (Ok (Expr restore-state value body-ty))])))]))]))]))]))

(define (lower-with-escape-final
  [final-lowered : LowerExpr]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (match final-lowered
    [(Expr final-state _ _) (Ok (Expr final-state escaped-value escaped-ty))]))

(define (lower-with-escape-rewind
  [state : LowerState]
  [mark-value : ir.CompilerIrValue]
  [new-enclosing-value : ir.CompilerIrValue]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (let
    [rewind-lowered : LowerExpr
      (try
        (lower-runtime-call-values
          state
          (lower-tl-region-reset-symbol)
          (ir.compiler-ir-value-seq1 mark-value)
          (Unit)))]
    (match rewind-lowered
      [(Expr rewind-state _ _)
        (let
          [final-lowered : LowerExpr
            (try
              (lower-runtime-call-values
                rewind-state
                (lower-tl-arena-set-symbol)
                (ir.compiler-ir-value-seq1 new-enclosing-value)
                (Unit)))]
          (lower-with-escape-final final-lowered escaped-value escaped-ty))])))

(define (lower-with-escape-cleanup
  [state : LowerState]
  [scratch-head-value : ir.CompilerIrValue]
  [mark-value : ir.CompilerIrValue]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (let
    [new-enclosing-lowered : LowerExpr
      (try
        (lower-runtime-call-values
          state
          (lower-tl-arena-current-symbol)
          (ir.compiler-ir-value-seq-empty)
          (I64)))]
    (match new-enclosing-lowered
      [(Expr new-enclosing-state new-enclosing-value _)
        (let
          [restore-scratch-lowered : LowerExpr
            (try
              (lower-runtime-call-values
                new-enclosing-state
                (lower-tl-arena-set-symbol)
                (ir.compiler-ir-value-seq1 scratch-head-value)
                (Unit)))]
          (match restore-scratch-lowered
            [(Expr restore-scratch-state _ _)
              (lower-with-escape-rewind
                restore-scratch-state
                mark-value
                new-enclosing-value
                escaped-value
                escaped-ty)]))])))

(define (lower-with-escape-clone
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scratch-head-value : ir.CompilerIrValue]
  [mark-value : ir.CompilerIrValue]
  [body-value : ir.CompilerIrValue]
  [body-ty : ast.AstType]) : ResultLowerExpr
  (let
    [escaped-lowered : LowerExpr
      (try (lower-clone-dispatch ctx state env type-env body-value body-ty))]
    (match escaped-lowered
      [(Expr escaped-state escaped-value escaped-ty)
        (lower-with-escape-cleanup
          escaped-state
          scratch-head-value
          mark-value
          escaped-value
          escaped-ty)])))

(define (lower-with-escape-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [enclosing-value : ir.CompilerIrValue]
  [mark-value : ir.CompilerIrValue]
  [body : ast.AstExprList]) : ResultLowerExpr
  (let
    [body-lowered : LowerExpr (try (lower-begin ctx state env type-env body))]
    (match body-lowered
      [(Expr body-state body-value body-ty)
        (let
          [scratch-head-lowered : LowerExpr
            (try
              (lower-runtime-call-values
                body-state
                (lower-tl-arena-current-symbol)
                (ir.compiler-ir-value-seq-empty)
                (I64)))]
          (match scratch-head-lowered
            [(Expr scratch-head-state scratch-head-value _)
              (let
                [restore-enclosing-lowered : LowerExpr
                  (try
                    (lower-runtime-call-values
                      scratch-head-state
                      (lower-tl-arena-set-symbol)
                      (ir.compiler-ir-value-seq1 enclosing-value)
                      (Unit)))]
                (match restore-enclosing-lowered
                  [(Expr restore-state _ _)
                    (lower-with-escape-clone
                      ctx
                      restore-state
                      env
                      type-env
                      scratch-head-value
                      mark-value
                      body-value
                      body-ty)]))]))])))

(define (lower-with-escape
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scratch : ast.AstExpr]
  [body : ast.AstExprList]) : ResultLowerExpr
  (let
    [enclosing-lowered : LowerExpr
      (try
        (lower-runtime-call-values
          state
          (lower-tl-arena-current-symbol)
          (ir.compiler-ir-value-seq-empty)
          (I64)))]
    (match enclosing-lowered
      [(Expr enclosing-state enclosing-value _)
        (let
          [scratch-lowered : LowerExpr
            (try
              (lower-arena-handle
                ctx
                enclosing-state
                env
                type-env
                scratch
                "with-escape"))]
          (match scratch-lowered
            [(Expr scratch-state scratch-value _)
              (let
                [set-scratch-lowered : LowerExpr
                  (try
                    (lower-runtime-call-values
                      scratch-state
                      (lower-tl-arena-set-symbol)
                      (ir.compiler-ir-value-seq1 scratch-value)
                      (Unit)))]
                (match set-scratch-lowered
                  [(Expr set-scratch-state _ _)
                    (let
                      [mark-lowered : LowerExpr
                        (try
                          (lower-runtime-call-values
                            set-scratch-state
                            (lower-tl-region-mark-symbol)
                            (ir.compiler-ir-value-seq-empty)
                            (U64)))]
                      (match mark-lowered
                        [(Expr mark-state mark-value _)
                          (lower-with-escape-body
                            ctx
                            mark-state
                            env
                            type-env
                            enclosing-value
                            mark-value
                            body)]))]))]))])))

(define (lower-with-scratch-final-restore
  [state : LowerState]
  [new-enclosing-value : ir.CompilerIrValue]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (let
    [final-lowered : LowerExpr
      (try
        (lower-runtime-call-values
          state
          (lower-tl-arena-set-symbol)
          (ir.compiler-ir-value-seq1 new-enclosing-value)
          (Unit)))]
    (lower-with-escape-final final-lowered escaped-value escaped-ty)))

(define (lower-with-scratch-cleanup
  [state : LowerState]
  [scratch-head-value : ir.CompilerIrValue]
  [escaped-value : ir.CompilerIrValue]
  [escaped-ty : ast.AstType]) : ResultLowerExpr
  (let
    [new-enclosing-lowered : LowerExpr
      (try
        (lower-runtime-call-values
          state
          (lower-tl-arena-current-symbol)
          (ir.compiler-ir-value-seq-empty)
          (I64)))]
    (match new-enclosing-lowered
      [(Expr new-enclosing-state new-enclosing-value _)
        (let
          [destroy-lowered : LowerExpr
            (try
              (lower-runtime-call-values
                new-enclosing-state
                (lower-tl-arena-destroy-symbol)
                (ir.compiler-ir-value-seq1 scratch-head-value)
                (Unit)))]
          (match destroy-lowered
            [(Expr destroy-state _ _)
              (lower-with-scratch-final-restore
                destroy-state
                new-enclosing-value
                escaped-value
                escaped-ty)]))])))

(define (lower-with-scratch-clone
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scratch-head-value : ir.CompilerIrValue]
  [body-value : ir.CompilerIrValue]
  [body-ty : ast.AstType]) : ResultLowerExpr
  (let
    [escaped-lowered : LowerExpr
      (try (lower-clone-dispatch ctx state env type-env body-value body-ty))]
    (match escaped-lowered
      [(Expr escaped-state escaped-value escaped-ty)
        (lower-with-scratch-cleanup
          escaped-state
          scratch-head-value
          escaped-value
          escaped-ty)])))

(define (lower-with-scratch-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [enclosing-value : ir.CompilerIrValue]
  [body : ast.AstExprList]) : ResultLowerExpr
  (let
    [body-lowered : LowerExpr (try (lower-begin ctx state env type-env body))]
    (match body-lowered
      [(Expr body-state body-value body-ty)
        (let
          [scratch-head-lowered : LowerExpr
            (try
              (lower-runtime-call-values
                body-state
                (lower-tl-arena-current-symbol)
                (ir.compiler-ir-value-seq-empty)
                (I64)))]
          (match scratch-head-lowered
            [(Expr scratch-head-state scratch-head-value _)
              (let
                [restore-enclosing-lowered : LowerExpr
                  (try
                    (lower-runtime-call-values
                      scratch-head-state
                      (lower-tl-arena-set-symbol)
                      (ir.compiler-ir-value-seq1 enclosing-value)
                      (Unit)))]
                (match restore-enclosing-lowered
                  [(Expr restore-state _ _)
                    (lower-with-scratch-clone
                      ctx
                      restore-state
                      env
                      type-env
                      scratch-head-value
                      body-value
                      body-ty)]))]))])))

(define (lower-with-scratch
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [body : ast.AstExprList]) : ResultLowerExpr
  (let
    [enclosing-lowered : LowerExpr
      (try
        (lower-runtime-call-values
          state
          (lower-tl-arena-current-symbol)
          (ir.compiler-ir-value-seq-empty)
          (I64)))]
    (match enclosing-lowered
      [(Expr enclosing-state enclosing-value _)
        (let
          [scratch-lowered : LowerExpr
            (try
              (lower-runtime-call-values
                enclosing-state
                (lower-tl-arena-make-symbol)
                (ir.compiler-ir-value-seq-empty)
                (I64)))]
          (match scratch-lowered
            [(Expr scratch-state scratch-value _)
              (let
                [set-scratch-lowered : LowerExpr
                  (try
                    (lower-runtime-call-values
                      scratch-state
                      (lower-tl-arena-set-symbol)
                      (ir.compiler-ir-value-seq1 scratch-value)
                      (Unit)))]
                (match set-scratch-lowered
                  [(Expr set-scratch-state _ _)
                    (lower-with-scratch-body
                      ctx
                      set-scratch-state
                      env
                      type-env
                      enclosing-value
                      body)]))]))])))

(define (lower-if-merge
  [ctx : tc_core.TcContext]
  [else-state : LowerState]
  [then-value : ir.CompilerIrValue]
  [then-end-label : i64]
  [else-value : ir.CompilerIrValue]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [else-end-label : i64 (lower-state-current-label else-state)]
    [expr-ir-ty : ast.AstType
      (lower-one-word-register-storage-type ctx expr-ty)]
    [merge-start : LowerState
      (lower-state-finish-block
        (lower-state-emit else-state (Jump merge-label))
        merge-label)]
    (match (lower-state-alloc-var merge-start)
      [(Alloc allocated var-id)
        (Ok
          (Expr
            (lower-state-emit
              allocated
              (Phi
                var-id
                (ir.compiler-ir-phi-input-seq-prepend
                  then-value
                  then-end-label
                  (ir.compiler-ir-phi-input-seq-prepend
                    else-value
                    else-end-label
                    (ir.compiler-ir-phi-input-seq-empty)))
                expr-ir-ty))
            (Var var-id)
            expr-ty))])))

(define (lower-if-single-merge
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [merge-start : LowerState
      (lower-state-finish-block
        (lower-state-emit state (Jump merge-label))
        merge-label)]
    (Ok (Expr merge-start value expr-ty))))

(define (lower-if-finish
  [ctx : tc_core.TcContext]
  [then-value : ir.CompilerIrValue]
  [then-ty : ast.AstType]
  [then-end-label : i64]
  [else-state : LowerState]
  [else-value : ir.CompilerIrValue]
  [else-ty : ast.AstType]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (if (tc_core.tc-never-type? then-ty)
    (if (tc_core.tc-never-type? else-ty)
      (Ok (Expr (lower-state-finish-block else-state merge-label) Unit (Never)))
      (lower-if-single-merge else-state else-value merge-label expr-ty))
    (if (tc_core.tc-never-type? else-ty)
      (Ok
        (Expr
          (lower-state-finish-block else-state merge-label)
          then-value
          expr-ty))
      (lower-if-merge
        ctx
        else-state
        then-value
        then-end-label
        else-value
        merge-label
        expr-ty))))

(define (lower-if-else
  [ctx : tc_core.TcContext]
  [else-start : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [else-branch : ast.AstExpr]
  [then-value : ir.CompilerIrValue]
  [then-ty : ast.AstType]
  [then-end-label : i64]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [else-lowered
      (try
        (lower-expr-expected
          ctx
          else-start
          env
          type-env
          (lower-global-shared-view else-branch)
          (lower-global-shared-view expr-ty)
          else-branch))]
    (match else-lowered
      [(Expr else-state else-value else-ty)
        (lower-if-finish
          ctx
          then-value
          then-ty
          then-end-label
          else-state
          else-value
          else-ty
          merge-label
          expr-ty)])))

(define (lower-if-then
  [ctx : tc_core.TcContext]
  [then-start : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]
  [else-label : i64]
  [merge-label : i64]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [then-lowered
      (try
        (lower-expr-expected
          ctx
          then-start
          env
          type-env
          (lower-global-shared-view then-branch)
          (lower-global-shared-view expr-ty)
          then-branch))]
    (match then-lowered
      [(Expr then-state then-value then-ty)
        (let
          [then-end-label : i64 (lower-state-current-label then-state)]
          [else-start : LowerState
            (if (tc_core.tc-never-type? (lower-global-shared-view then-ty))
              (lower-state-finish-block then-state else-label)
              (lower-state-finish-block
                (lower-state-emit then-state (Jump merge-label))
                else-label))]
          (lower-if-else
            ctx
            else-start
            env
            type-env
            else-branch
            then-value
            then-ty
            then-end-label
            merge-label
            expr-ty))])))

(define (lower-if
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [cond : ast.AstExpr]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [cond-lowered
      (try (lower-expr ctx state env type-env (lower-global-shared-view cond)))]
    (match cond-lowered
      [(Expr cond-state cond-value cond-ty)
        (if (tc_core.tc-type-compatible? (Bool) cond-ty)
          (match (lower-state-fresh-label cond-state "if_then")
            [(Label then-label-state then-label)
              (match (lower-state-fresh-label then-label-state "if_else")
                [(Label else-label-state else-label)
                  (match (lower-state-fresh-label else-label-state "if_merge")
                    [(Label merge-label-state merge-label)
                      (let
                        [branch-state : LowerState
                          (lower-state-emit
                            merge-label-state
                            (Branch cond-value then-label else-label))]
                        (lower-if-then
                          ctx
                          (lower-state-finish-block branch-state then-label)
                          env
                          type-env
                          then-branch
                          else-branch
                          else-label
                          merge-label
                          expr-ty))])])])
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                cond
                "typecheck: if condition must be bool"))))])))

(define (lower-while-active
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [cond : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-fresh-label (lower-state-clone state) "while_header")
    [(Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "while_body")
        [(Label body-label-state body-label)
          (match (lower-state-fresh-label
            (lower-state-clone body-label-state)
            "while_exit")
            [(Label exit-label-state exit-label)
              (let
                [header-start : LowerState
                  (lower-state-finish-block
                    (lower-state-emit exit-label-state (Jump header-label))
                    header-label)]
                [cond-lowered : LowerExpr
                  (try (lower-expr ctx header-start env type-env cond))]
                (match cond-lowered
                  [(Expr cond-state cond-value _)
                    (let
                      [body-start : LowerState
                        (lower-state-finish-block
                          (lower-state-emit
                            cond-state
                            (Branch cond-value body-label exit-label))
                          body-label)]
                      [body-lowered
                        (try
                          (lower-expr
                            ctx
                            body-start
                            env
                            (lower-enter-loop-target
                              type-env
                              (cis.intern-lower-private-identity-raw
                                (lower-while-exit-label-id
                                  body-label-state
                                  (lower-state-next-label-number
                                    body-label-state)))
                              (cis.intern-lower-private-identity-raw
                                (lower-while-header-label-id
                                  state
                                  (lower-state-next-label-number state))))
                            body))]
                      (match body-lowered
                        [(Expr body-state _ body-ty)
                          (Ok
                            (Expr
                              (if (tc_core.tc-never-type? body-ty)
                                (lower-state-finish-block body-state exit-label)
                                (lower-state-finish-block
                                  (lower-state-emit
                                    body-state
                                    (Jump header-label))
                                  exit-label))
                              Unit
                              (Unit)))]))]))])])]))

(define (lower-while
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [cond : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [lower-state : CompilerLowerState (lower-state-owner state)]
    [previous-function : i64 (lower-state-active-loop-function state)]
    [previous-var-limit : i64 (lower-state-active-loop-entry-var-limit state)]
    (compiler-lower-state-write!
      lower-state
      i64
      active-loop-function
      (lower-state-current-function-id state))
    (compiler-lower-state-write!
      lower-state
      i64
      active-loop-entry-var-limit
      (lower-state-next-var state))
    (let
      [result : ResultLowerExpr
        (lower-while-active ctx state env type-env cond body)]
      (compiler-lower-state-write!
        lower-state
        i64
        active-loop-function
        previous-function)
      (compiler-lower-state-write!
        lower-state
        i64
        active-loop-entry-var-limit
        previous-var-limit)
      result)))

;; Per-iteration accumulator update for an associative binop fold
;; (`sum`/`all`/`any`): `(set! acc (<op> acc value))`. `value` appears once so it
;; is evaluated exactly once per iteration.
(define (spmd-reduce-acc-binop-update
  [state : LowerState]
  [pools : ast.AstNodePoolContext]
  [op : ast.AstBinOp]
  [value : i64]) : i64
  (let
    [acc-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-reduce-acc-id state))]
    (ast.ast-expr-set-id-with-pools
      pools
      acc-id
      (ast.ast-expr-binary-with-pools
        pools
        op
        (ast.ast-node-pool-context-expr-push pools (Var acc-id))
        value))))

;; Per-iteration accumulator update for a select fold (`min`/`max`): bind `value`
;; once into a temp, then keep it when `(<cmp> val acc)` holds, else keep `acc`.
;; The temp keeps `value` to a single evaluation even though the select names it
;; twice.
(define (spmd-reduce-acc-select-update
  [state : LowerState]
  [pools : ast.AstNodePoolContext]
  [cmp : ast.AstBinOp]
  [value : i64]) : i64
  (let
    [acc-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-reduce-acc-id state))]
    [value-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-reduce-val-id state))]
    (ast.ast-expr-let-with-pools
      pools
      (ast.ast-let-binding-cons
        (ast.ast-let-binding-id value-id (No) value)
        (ast.ast-let-binding-list-new))
      (ast.ast-expr-set-id-with-pools
        pools
        acc-id
        (ast.ast-expr-if-with-pools
          pools
          (ast.ast-expr-binary-with-pools
            pools
            cmp
            (ast.ast-node-pool-context-expr-push pools (Var value-id))
            (ast.ast-node-pool-context-expr-push pools (Var acc-id)))
          (ast.ast-node-pool-context-expr-push pools (Var value-id))
          (ast.ast-node-pool-context-expr-push pools (Var acc-id)))))))

(define (spmd-reduce-acc-update-expr
  [state : LowerState]
  [pools : ast.AstNodePoolContext]
  [op : ast.AstReduceOp]
  [value : i64]) : i64
  (match op
    [(Sum) (spmd-reduce-acc-binop-update state pools (Add) value)]
    [(All) (spmd-reduce-acc-binop-update state pools (And) value)]
    [(Any) (spmd-reduce-acc-binop-update state pools (Or) value)]
    [(Min) (spmd-reduce-acc-select-update state pools (Lt) value)]
    [(Max) (spmd-reduce-acc-select-update state pools (Gt) value)]))

;; Conservative scan used by the reduction addend split: does `expr` write
;; `name` (`set!`) anywhere, or rebind `name` with a `let` binding? Either one
;; means a `Var name` read at the top of the reduce value cannot be hoisted out
;; of the loop as-is. Variants that are not explicitly walked (match, nested
;; loops/comprehensions, quotes, region/escape blocks, ...) bail out with
;; `true` so the split simply does not fire on exotic value expressions.
(define (lower-spmd-reduce-expr-writes-id?
  [ctx : tc_core.TcContext]
  [name : i64]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(Spanned inner-box _)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(Ann inner-box _) (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(Cast inner-box _) (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(Borrow _ _ inner-box)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(Unary _ inner-box) (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(Binary _ left-box right-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name left-box)
        (lower-spmd-reduce-node-writes-id? ctx name right-box))]
    [(Call func-box args)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name func-box)
        (lower-spmd-reduce-expr-list-writes-id? ctx name args))]
    [(BracketClause items)
      (lower-spmd-reduce-expr-list-writes-id? ctx name items)]
    [(If cond-box then-box else-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name cond-box)
        (lower-spmd-reduce-node-writes-id? ctx name then-box)
        (lower-spmd-reduce-node-writes-id? ctx name else-box))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (or
            (lower-spmd-reduce-let-bindings-write-id? ctx name bindings)
            (lower-spmd-reduce-node-writes-id? ctx name body-box))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda _ _ body-box)
          (lower-spmd-reduce-node-writes-id? ctx name body-box)])]
    [(Tuple exprs) (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(Array exprs) (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(DynArray exprs) (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(TupleRef tuple-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name tuple-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(FixedMakeArray _ len-box)
      (lower-spmd-reduce-node-writes-id? ctx name len-box)]
    [(MakeArray _ len-box) (lower-spmd-reduce-node-writes-id? ctx name len-box)]
    [(ArrayRef array-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(ArraySet array-box index-box value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(ArrayTake array-box live-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name live-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(Replace _ _) true]
    [(ArrayPush array-box value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(StringRef string-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name string-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(While cond-box body-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name cond-box)
        (lower-spmd-reduce-expr-list-writes-id? ctx name body-box))]
    [(Begin exprs) (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(Unsafe exprs) (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(Set set-name value-box)
      (or
        (= set-name name)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(StructGet target-box _)
      (lower-spmd-reduce-node-writes-id? ctx name target-box)]
    [(StructSet target-box _ value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name target-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(Box value-box) (lower-spmd-reduce-node-writes-id? ctx name value-box)]
    [(BoxGet value-box) (lower-spmd-reduce-node-writes-id? ctx name value-box)]
    [(BoxTake value-box) (lower-spmd-reduce-node-writes-id? ctx name value-box)]
    [(BoxSet target-box value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name target-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(Literal _) false]
    [(Var _) false]
    [_ true]))

(define (lower-spmd-reduce-node-writes-id?
  [ctx : tc_core.TcContext]
  [name : i64]
  [id : i64]) : bool
  (lower-spmd-reduce-expr-writes-id? ctx name (lower-context-expr-get ctx id)))

(define (lower-spmd-reduce-expr-list-writes-id?
  [ctx : tc_core.TcContext]
  [name : i64]
  [exprs : ast.AstExprList]) : bool
  (lower-spmd-reduce-expr-list-writes-id-at? ctx name (& exprs) 0))

(define (lower-spmd-reduce-expr-list-writes-id-at?
  [ctx : tc_core.TcContext]
  [name : i64]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : bool
  (if (>= expr-index exprs.len)
    false
    (or
      (lower-spmd-reduce-node-writes-id?
        ctx
        name
        (ast.ast-expr-list-get exprs expr-index 0))
      (lower-spmd-reduce-expr-list-writes-id-at?
        ctx
        name
        exprs
        (+ expr-index 1)))))

;; A `let` binding list blocks the split when it rebinds `name` (a `Var name`
;; read inside would no longer mean the outer variable) or when any binding
;; init writes `name`.
(define (lower-spmd-reduce-let-bindings-write-id?
  [ctx : tc_core.TcContext]
  [name : i64]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-spmd-reduce-let-bindings-write-id-at? ctx name (& bindings) 0))

(define (lower-spmd-reduce-let-bindings-write-id-at?
  [ctx : tc_core.TcContext]
  [name : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (or
      (match (ast.ast-let-binding-list-get
        bindings
        binding-index
        (ast.ast-let-binding-fallback))
        [(Binding bind-name _ init-box)
          (or
            (= bind-name name)
            (lower-spmd-reduce-node-writes-id? ctx name init-box))])
      (lower-spmd-reduce-let-bindings-write-id-at?
        ctx
        name
        bindings
        (+ binding-index 1)))))

;; Strip `Spanned`/`Ann` wrappers to see the syntactic head of an expression
;; (mirrors the unwrapping in `lower-simple-vector-reduce`).
(define (lower-spmd-reduce-split-unwrap
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : ast.AstExpr
  (match (lower-global-shared-view expr)
    [(Spanned inner-box _)
      (lower-spmd-reduce-split-unwrap
        ctx
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-spmd-reduce-split-unwrap
        ctx
        (lower-context-expr-get ctx inner-box))]
    [_ expr]))

;; If `operand` (an expr-pool id) is a plain variable reference that is
;; invariant across the reduction, return its id; otherwise -1. Invariant
;; here means: not the loop index, never `set!` inside the whole value
;; expression, and never rebound by a `let` inside it. A `Var` read is pure,
;; so hoisting it out of the loop is then unobservable.
(define (lower-spmd-reduce-split-uniform-var
  [ctx : tc_core.TcContext]
  [index-id : i64]
  [value : ast.AstExpr]
  [operand : i64]) : i64
  (match (lower-spmd-reduce-split-unwrap
    ctx
    (lower-context-expr-get ctx operand))
    [(Var u-id)
      (if (and
        (not (= u-id index-id))
        (not (lower-spmd-reduce-expr-writes-id? ctx u-id value)))
        u-id
        (- 0 1))]
    [_ (- 0 1)]))

;; Reduction addend split matcher: recognize a scalar `sum` reduce whose value
;; is `(+ X U)` (either operand order) with `U` a reduction-invariant variable
;; and an i64/u64 accumulator whose type matches the loop index type (the exit
;; trip count is computed in the index type, so the split stays within one
;; wrapping integer type). Returns `Split x-id u-id` with the varying addend's
;; expr-pool id and the uniform addend's variable id.
(define (lower-spmd-reduce-split-addend
  [ctx : tc_core.TcContext]
  [op : ast.AstReduceOp]
  [acc-ty : ast.AstType]
  [index-id : i64]
  [index-ty : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeReduceSplit
  (match op
    [(Sum)
      (match (lower-global-shared-view acc-ty)
        [(I64)
          (lower-spmd-reduce-split-addend-typed
            ctx
            acc-ty
            index-id
            index-ty
            value)]
        [(U64)
          (lower-spmd-reduce-split-addend-typed
            ctx
            acc-ty
            index-id
            index-ty
            value)]
        [_ (No)])]
    [_ (No)]))

(define (lower-spmd-reduce-split-addend-typed
  [ctx : tc_core.TcContext]
  [acc-ty : ast.AstType]
  [index-id : i64]
  [index-ty : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeReduceSplit
  (if (not
    (tc_core.tc-type-eq (tc_core.tc-type-without-regions index-ty) acc-ty))
    (No)
    (match (lower-spmd-reduce-split-unwrap ctx (lower-global-shared-view value))
      [(Binary (Add) left-box right-box)
        (let
          [left-uniform : i64
            (lower-spmd-reduce-split-uniform-var
              ctx
              index-id
              (lower-global-shared-view value)
              left-box)]
          (if (>= left-uniform 0)
            (Split right-box left-uniform)
            (let
              [right-uniform : i64
                (lower-spmd-reduce-split-uniform-var
                  ctx
                  index-id
                  value
                  right-box)]
              (if (>= right-uniform 0)
                (Split left-box right-uniform)
                (No)))))]
      [_ (No)])))

;; Scalar `spmd-reduce` loop scaffold: desugar to an accumulator loop and
;; reuse the let/while/set lowering. `acc`/`end`/index are bound once before the
;; loop (so `init`/`end`/`start` evaluate exactly once); an empty range returns
;; `init` without evaluating `acc-update`. `acc`/`end`/temp use lexer-impossible
;; names so they cannot collide with a user binding. The ordered left-to-right
;; fold matches the spec reference semantics.
;;   (spmd-reduce <op> ([i : ty start end]) init value)
;;     === (let [acc : result-ty init] [end' end] [i start]
;;           (begin (while (< i end') (begin <acc-update> (set! i (+ i 1)))) acc))
;; With a `LowerMaybeReduceSplit.Split` plan (a `sum` over `(+ X U)` with a
;; reduction-invariant `U`, see `lower-spmd-reduce-split-addend`) the scaffold
;; additionally binds `start'` and the hoisted uniform addend `u'`, the
;; accumulator update adds only `X`, and the loop tail returns
;; `(+ acc (* (- i start') u'))`:
;;     === (let [acc : result-ty init] [end' end] [start' start] [i start']
;;             [u' U]
;;           (begin
;;             (while (< i end') (begin <acc-update-X> (set! i (+ i 1))))
;;             (+ acc (* (- i start') u'))))
;; Exactness: `i` counts up by one per trip, so `(- i start')` after the loop
;; is the trip count n (0 for an empty range), and over wrapping i64/u64
;; arithmetic `init + Σ_k (X_k + U) == init + Σ_k X_k + n*U` because wrapping
;; `+` and `*` are the mod-2^64 ring operations. `u'` reads `U` once before
;; the loop; that is unobservable because a `Var` read is pure and the split
;; plan guarantees `U` is never written inside the value expression.
(define (lower-spmd-reduce-scaffold
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [_result-ty : ast.AstType]
  [index-id : i64]
  [_index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [init : ast.AstExpr]
  [acc-ty : ast.AstType]
  [acc-update : i64]
  [split : LowerMaybeReduceSplit]) : ResultLowerExpr
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    [acc-name-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-reduce-acc-id state))]
    [end-name-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-reduce-end-id state))]
    [start-name-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-reduce-start-id state))]
    [uniform-name-id : i64
      (cis.intern-lower-private-identity-raw
        (lower-spmd-reduce-uniform-id state))]
    [loop-id : i64
      (ast.ast-expr-while-with-pools
        pools
        (ast.ast-expr-binary-with-pools
          pools
          (Lt)
          (ast.ast-node-pool-context-expr-push pools (Var index-id))
          (ast.ast-node-pool-context-expr-push pools (Var end-name-id)))
        (ast.ast-node-pool-context-expr-push
          pools
          (Begin
            (ast.ast-expr-cons
              acc-update
              (ast.ast-expr-cons
                (ast.ast-expr-set-id-with-pools
                  pools
                  index-id
                  (ast.ast-expr-binary-with-pools
                    pools
                    (Add)
                    (ast.ast-node-pool-context-expr-push pools (Var index-id))
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (Literal (ast.ast-lit-int 1)))))
                (ast.ast-expr-list-new))))))]
    [root-id : i64
      (match split
        [(Split _ u-id)
          (ast.ast-expr-let-with-pools
            pools
            (ast.ast-let-binding-cons
              (ast.ast-let-binding-id
                acc-name-id
                (Some acc-ty)
                (ast.ast-node-pool-context-expr-push pools init))
              (ast.ast-let-binding-cons
                (ast.ast-let-binding-id
                  end-name-id
                  (Some (lower-global-shared-view index-ty))
                  (ast.ast-node-pool-context-expr-push pools end))
                (ast.ast-let-binding-cons
                  (ast.ast-let-binding-id
                    start-name-id
                    (Some (lower-global-shared-view index-ty))
                    (ast.ast-node-pool-context-expr-push pools start))
                  (ast.ast-let-binding-cons
                    (ast.ast-let-binding-id
                      index-id
                      (Some index-ty)
                      (ast.ast-node-pool-context-expr-push
                        pools
                        (Var start-name-id)))
                    (ast.ast-let-binding-cons
                      (ast.ast-let-binding-id
                        uniform-name-id
                        (No)
                        (ast.ast-node-pool-context-expr-push pools (Var u-id)))
                      (ast.ast-let-binding-list-new))))))
            (ast.ast-node-pool-context-expr-push
              pools
              (Begin
                (ast.ast-expr-cons
                  loop-id
                  (ast.ast-expr-cons
                    (ast.ast-expr-binary-with-pools
                      pools
                      (Add)
                      (ast.ast-node-pool-context-expr-push
                        pools
                        (Var acc-name-id))
                      (ast.ast-expr-binary-with-pools
                        pools
                        (Mul)
                        (ast.ast-expr-binary-with-pools
                          pools
                          (Sub)
                          (ast.ast-node-pool-context-expr-push
                            pools
                            (Var index-id))
                          (ast.ast-node-pool-context-expr-push
                            pools
                            (Var start-name-id)))
                        (ast.ast-node-pool-context-expr-push
                          pools
                          (Var uniform-name-id))))
                    (ast.ast-expr-list-new))))))]
        [_
          (ast.ast-expr-let-with-pools
            pools
            (ast.ast-let-binding-cons
              (ast.ast-let-binding-id
                acc-name-id
                (Some acc-ty)
                (ast.ast-node-pool-context-expr-push pools init))
              (ast.ast-let-binding-cons
                (ast.ast-let-binding-id
                  end-name-id
                  (Some (lower-global-shared-view index-ty))
                  (ast.ast-node-pool-context-expr-push pools end))
                (ast.ast-let-binding-cons
                  (ast.ast-let-binding-id
                    index-id
                    (Some index-ty)
                    (ast.ast-node-pool-context-expr-push pools start))
                  (ast.ast-let-binding-list-new))))
            (ast.ast-node-pool-context-expr-push
              pools
              (Begin
                (ast.ast-expr-cons
                  loop-id
                  (ast.ast-expr-cons
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (Var acc-name-id))
                    (ast.ast-expr-list-new))))))])]
    [root : ast.AstExpr (lower-context-expr-get ctx root-id)]
    (lower-expr ctx state env type-env root)))

;; Scalar lowering for all reduction ops: `sum` (wrapping `+`, also f64
;; ordered add), `all`/`any` (boolean `and`/`or`), and `min`/`max` (ordered
;; select). Each supplies its per-iteration accumulator update to the shared
;; loop scaffold. A `sum` whose value is `(+ X U)` with reduction-invariant
;; `U` takes the addend split (see `lower-spmd-reduce-split-addend`): the loop
;; accumulates only `X` and the scaffold adds `(* trip-count U)` once at the
;; end. The SIMD-mode vector plan, when it applies, is unaffected.
(define (lower-spmd-reduce
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [result-ty : ast.AstType]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [init : ast.AstExpr]
  [value : ast.AstExpr]) : ResultLowerExpr
  (match (tc_core.tc-expr
    ctx
    (tc_core.tc-bind-id type-env index-id (lower-global-shared-view index-ty))
    (lower-global-shared-view value))
    [(Ok value-ty)
      (let
        [acc-ty : ast.AstType (tc_core.tc-type-without-regions value-ty)]
        [split : LowerMaybeReduceSplit
          (lower-spmd-reduce-split-addend
            ctx
            op
            (lower-global-shared-view acc-ty)
            index-id
            (lower-global-shared-view index-ty)
            (lower-global-shared-view value))]
        [acc-update : i64
          (match split
            [(Split x-id _)
              (spmd-reduce-acc-binop-update
                state
                (tc_core.tc-context-pools ctx)
                (Add)
                x-id)]
            [_
              (spmd-reduce-acc-update-expr
                state
                (tc_core.tc-context-pools ctx)
                op
                (lower-context-expr-push ctx (lower-global-shared-view value)))])]
        (if (and
          (lower-mode-simd? (lower-state-mode state))
          (lower-type-i64? (lower-global-shared-view index-ty)))
          (let
            [plan : LowerMaybeVectorReduce
              (lower-simple-vector-reduce
                ctx
                (lower-state-mode state)
                env
                type-env
                op
                index
                (lower-global-shared-view acc-ty)
                (lower-global-shared-view value))]
            (match (lower-global-shared-view plan)
              [(Array _ _ _ _)
                (lower-avx2-spmd-reduce-lowered
                  ctx
                  state
                  env
                  type-env
                  index-ty
                  start
                  end
                  init
                  op
                  plan)]
              [(Value _ _ _ _)
                (lower-avx2-spmd-reduce-lowered
                  ctx
                  state
                  env
                  type-env
                  index-ty
                  start
                  end
                  init
                  op
                  plan)]
              [(No)
                (match (lower-spmd-numeric-failure
                  ctx
                  (lower-state-function-state state)
                  (lower-state-mode state)
                  env
                  (tc_core.tc-bind-id
                    type-env
                    index-id
                    (lower-global-shared-view index-ty))
                  (FusedReduction)
                  value)
                  [(Some origin decision)
                    (Err
                      (box
                        (lower-diagnostic-at-expr
                          ctx
                          origin
                          (lower-spmd-numeric-failure-message decision))))]
                  [(No)
                    (lower-spmd-reduce-scaffold
                      ctx
                      state
                      env
                      type-env
                      result-ty
                      index-id
                      index
                      index-ty
                      start
                      end
                      init
                      acc-ty
                      acc-update
                      split)])]))
          (lower-spmd-reduce-scaffold
            ctx
            state
            env
            type-env
            result-ty
            index-id
            index
            index-ty
            start
            end
            init
            acc-ty
            acc-update
            split)))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx value message)))]))

(define (spmd-scan-binop-prefix
  [state : LowerState]
  [pools : ast.AstNodePoolContext]
  [op : ast.AstBinOp]
  [value : i64]) : i64
  (let
    [acc-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-scan-acc-id state))]
    (ast.ast-expr-binary-with-pools
      pools
      op
      (ast.ast-node-pool-context-expr-push pools (Var acc-id))
      value)))

(define (spmd-scan-select-prefix
  [state : LowerState]
  [pools : ast.AstNodePoolContext]
  [cmp : ast.AstBinOp]
  [value : i64]) : i64
  (let
    [acc-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-scan-acc-id state))]
    [value-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-scan-val-id state))]
    (ast.ast-expr-let-with-pools
      pools
      (ast.ast-let-binding-cons
        (ast.ast-let-binding-id value-id (No) value)
        (ast.ast-let-binding-list-new))
      (ast.ast-expr-if-with-pools
        pools
        (ast.ast-expr-binary-with-pools
          pools
          cmp
          (ast.ast-node-pool-context-expr-push pools (Var value-id))
          (ast.ast-node-pool-context-expr-push pools (Var acc-id)))
        (ast.ast-node-pool-context-expr-push pools (Var value-id))
        (ast.ast-node-pool-context-expr-push pools (Var acc-id))))))

(define (spmd-scan-prefix-expr
  [state : LowerState]
  [pools : ast.AstNodePoolContext]
  [op : ast.AstReduceOp]
  [value : i64]) : i64
  (match op
    [(Sum) (spmd-scan-binop-prefix state pools (Add) value)]
    [(All) (spmd-scan-binop-prefix state pools (And) value)]
    [(Any) (spmd-scan-binop-prefix state pools (Or) value)]
    [(Min) (spmd-scan-select-prefix state pools (Lt) value)]
    [(Max) (spmd-scan-select-prefix state pools (Gt) value)]))

(define (lower-spmd-scan-scaffold
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [_index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [prefix-id : i64]
  [_prefix : String]
  [prefix-ty : ast.AstType]
  [init : ast.AstExpr]
  [prefix-value : i64]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    [acc-name-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-scan-acc-id state))]
    [end-name-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-scan-end-id state))]
    (lower-expr
      ctx
      state
      env
      type-env
      (lower-context-expr-get
        ctx
        (ast.ast-expr-let-with-pools
          pools
          (ast.ast-let-binding-cons
            (ast.ast-let-binding-id
              acc-name-id
              (Some (lower-global-shared-view prefix-ty))
              (ast.ast-node-pool-context-expr-push pools init))
            (ast.ast-let-binding-cons
              (ast.ast-let-binding-id
                end-name-id
                (Some (lower-global-shared-view index-ty))
                (ast.ast-node-pool-context-expr-push pools end))
              (ast.ast-let-binding-cons
                (ast.ast-let-binding-id
                  index-id
                  (Some index-ty)
                  (ast.ast-node-pool-context-expr-push pools start))
                (ast.ast-let-binding-list-new))))
          (ast.ast-node-pool-context-expr-push
            pools
            (Begin
              (ast.ast-expr-cons
                (ast.ast-expr-while-with-pools
                  pools
                  (ast.ast-expr-binary-with-pools
                    pools
                    (Lt)
                    (ast.ast-node-pool-context-expr-push pools (Var index-id))
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (Var end-name-id)))
                  (ast.ast-expr-let-with-pools
                    pools
                    (ast.ast-let-binding-cons
                      (ast.ast-let-binding-id
                        prefix-id
                        (Some prefix-ty)
                        prefix-value)
                      (ast.ast-let-binding-list-new))
                    (ast.ast-node-pool-context-expr-push
                      pools
                      (Begin
                        (ast.ast-expr-cons
                          (ast.ast-expr-set-id-with-pools
                            pools
                            acc-name-id
                            (ast.ast-node-pool-context-expr-push
                              pools
                              (Var prefix-id)))
                          (ast.ast-expr-cons
                            (ast.ast-node-pool-context-expr-push pools body)
                            (ast.ast-expr-cons
                              (ast.ast-expr-set-id-with-pools
                                pools
                                index-id
                                (ast.ast-expr-binary-with-pools
                                  pools
                                  (Add)
                                  (ast.ast-node-pool-context-expr-push
                                    pools
                                    (Var index-id))
                                  (ast.ast-node-pool-context-expr-push
                                    pools
                                    (Literal (ast.ast-lit-int 1)))))
                              (ast.ast-expr-list-new))))))))
                (ast.ast-expr-list-new)))))))))

(define (lower-spmd-scan
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [prefix-id : i64]
  [prefix : String]
  [prefix-ty : ast.AstType]
  [init : ast.AstExpr]
  [value : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [scalar-prefix : i64
      (spmd-scan-prefix-expr
        state
        (tc_core.tc-context-pools ctx)
        op
        (lower-context-expr-push ctx (lower-global-shared-view value)))]
    [vector-plan : LowerMaybeVectorScan
      (lower-simple-vector-scan
        ctx
        (lower-state-mode state)
        env
        type-env
        op
        index
        prefix
        (lower-global-shared-view prefix-ty)
        (lower-global-shared-view value)
        (lower-global-shared-view body))]
    (if (and
      (lower-mode-simd? (lower-state-mode state))
      (lower-type-i64? (lower-global-shared-view index-ty)))
      (match (lower-global-shared-view vector-plan)
        [(Scan _ _ _ _ _)
          (lower-simd-spmd-scan-lowered
            ctx
            state
            env
            type-env
            op
            index-id
            index-ty
            start
            end
            prefix-id
            prefix-ty
            init
            value
            body
            vector-plan)]
        [(No)
          (lower-spmd-scan-scaffold
            ctx
            state
            env
            type-env
            index-id
            index
            index-ty
            start
            end
            prefix-id
            prefix
            prefix-ty
            init
            scalar-prefix
            body)])
      (lower-spmd-scan-scaffold
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start
        end
        prefix-id
        prefix
        prefix-ty
        init
        scalar-prefix
        body))))

;; `spmd-compact` deliberately has one lowering in every backend mode. Keeping
;; the scalar reference scaffold here makes the source-order and overflow
;; contract independent of whichever SIMD lowering happens to be selected for
;; surrounding code.
(define (lower-spmd-compact
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [slot-id : i64]
  [init : ast.AstExpr]
  [keep : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    [cursor-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-scan-acc-id state))]
    [end-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-scan-end-id state))]
    [zero-id : i64
      (ast.ast-node-pool-context-expr-push pools (Literal (ast.ast-lit-int 0)))]
    [one-id : i64
      (ast.ast-node-pool-context-expr-push pools (Literal (ast.ast-lit-int 1)))]
    [unit-id : i64 (ast.ast-node-pool-context-expr-push pools (Literal Unit))]
    [max-id : i64
      (ast.ast-node-pool-context-expr-push
        pools
        (Literal (ast.ast-lit-int 9223372036854775807)))]
    ;; A zero-length fixed-array read is the compiler's existing typed OOB
    ;; trap expression. It has unit type, so it composes with the unit body and
    ;; reaches the same runtime abort path as ordinary checked array access.
    [overflow-trap-id : i64
      (ast.ast-expr-array-ref-with-pools
        pools
        (ast.ast-expr-fixed-make-array-with-pools pools (Unit) zero-id)
        zero-id)]
    [overflow-check-id : i64
      (ast.ast-expr-if-with-pools
        pools
        (ast.ast-expr-binary-with-pools
          pools
          (Eq)
          (ast.ast-node-pool-context-expr-push pools (Var slot-id))
          max-id)
        overflow-trap-id
        unit-id)]
    [selected-id : i64
      (ast.ast-expr-let-with-pools
        pools
        (ast.ast-let-binding-cons
          (ast.ast-let-binding-id
            slot-id
            (Some (I64))
            (ast.ast-node-pool-context-expr-push pools (Var cursor-id)))
          (ast.ast-let-binding-list-new))
        (ast.ast-node-pool-context-expr-push
          pools
          (Begin
            (ast.ast-expr-cons
              overflow-check-id
              (ast.ast-expr-cons
                (ast.ast-node-pool-context-expr-push pools body)
                (ast.ast-expr-cons
                  (ast.ast-expr-set-id-with-pools
                    pools
                    cursor-id
                    (ast.ast-expr-binary-with-pools
                      pools
                      (Add)
                      (ast.ast-node-pool-context-expr-push pools (Var slot-id))
                      one-id))
                  (ast.ast-expr-list-new)))))))]
    [loop-id : i64
      (ast.ast-expr-while-with-pools
        pools
        (ast.ast-expr-binary-with-pools
          pools
          (Lt)
          (ast.ast-node-pool-context-expr-push pools (Var index-id))
          (ast.ast-node-pool-context-expr-push pools (Var end-id)))
        (ast.ast-node-pool-context-expr-push
          pools
          (Begin
            (ast.ast-expr-cons
              (ast.ast-expr-if-with-pools
                pools
                (ast.ast-node-pool-context-expr-push pools keep)
                selected-id
                unit-id)
              (ast.ast-expr-cons
                (ast.ast-expr-set-id-with-pools
                  pools
                  index-id
                  (ast.ast-expr-binary-with-pools
                    pools
                    (Add)
                    (ast.ast-node-pool-context-expr-push pools (Var index-id))
                    one-id))
                (ast.ast-expr-list-new))))))]
    [root-id : i64
      (ast.ast-expr-let-with-pools
        pools
        (ast.ast-let-binding-cons
          (ast.ast-let-binding-id
            index-id
            (Some (I64))
            (ast.ast-node-pool-context-expr-push pools start))
          (ast.ast-let-binding-cons
            (ast.ast-let-binding-id
              end-id
              (Some (I64))
              (ast.ast-node-pool-context-expr-push pools end))
            (ast.ast-let-binding-cons
              (ast.ast-let-binding-id
                cursor-id
                (Some (I64))
                (ast.ast-node-pool-context-expr-push pools init))
              (ast.ast-let-binding-list-new))))
        (ast.ast-node-pool-context-expr-push
          pools
          (Begin
            (ast.ast-expr-cons
              loop-id
              (ast.ast-expr-cons
                (ast.ast-node-pool-context-expr-push pools (Var cursor-id))
                (ast.ast-expr-list-new))))))]
    (lower-expr ctx state env type-env (lower-context-expr-get ctx root-id))))

;; A rank-2 foreach has one lowering in every backend mode, the scalar
;; reference: nested loops with the inner coordinate fastest. The four bounds
;; are evaluated once, in binding order, into private locals. Both dimensions
;; are tested for emptiness before any span arithmetic, so an empty domain
;; never traps; otherwise each span and the domain product are checked against
;; i64 overflow before the first body effect.
(define (lower-foreach2
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [outer-id : i64]
  [outer-start : i64]
  [outer-end : i64]
  [inner-id : i64]
  [inner-start : i64]
  [inner-end : i64]
  [body : i64]) : ResultLowerExpr
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    [y0 : i64
      (cis.intern-lower-private-identity-raw
        (lower-private-identity state (SpmdDomainBound 0)))]
    [y1 : i64
      (cis.intern-lower-private-identity-raw
        (lower-private-identity state (SpmdDomainBound 1)))]
    [x0 : i64
      (cis.intern-lower-private-identity-raw
        (lower-private-identity state (SpmdDomainBound 2)))]
    [x1 : i64
      (cis.intern-lower-private-identity-raw
        (lower-private-identity state (SpmdDomainBound 3)))]
    [zero-id : i64
      (ast.ast-node-pool-context-expr-push pools (Literal (ast.ast-lit-int 0)))]
    [unit-id : i64 (ast.ast-node-pool-context-expr-push pools (Literal Unit))]
    ;; The typed zero-length array read is the same checked-access abort that
    ;; `spmd-compact` uses for its overflow trap.
    [trap-id : i64
      (ast.ast-expr-array-ref-with-pools
        pools
        (ast.ast-expr-fixed-make-array-with-pools pools (Unit) zero-id)
        zero-id)]
    [y-span : i64 (lower-foreach2-binary pools (Sub) y1 y0)]
    [x-span : i64 (lower-foreach2-binary pools (Sub) x1 x0)]
    [checks : i64
      (ast.ast-node-pool-context-expr-push
        pools
        (Begin
          (ast.ast-expr-cons
            (lower-foreach2-trap-if
              pools
              (ast.ast-expr-binary-with-pools pools (Lt) y-span zero-id)
              trap-id
              unit-id)
            (ast.ast-expr-cons
              (lower-foreach2-trap-if
                pools
                (ast.ast-expr-binary-with-pools pools (Lt) x-span zero-id)
                trap-id
                unit-id)
              (ast.ast-expr-cons
                (lower-foreach2-trap-if
                  pools
                  (ast.ast-expr-binary-with-pools
                    pools
                    (Gt)
                    y-span
                    (ast.ast-expr-binary-with-pools
                      pools
                      (Div)
                      (ast.ast-node-pool-context-expr-push
                        pools
                        (Literal (ast.ast-lit-int 9223372036854775807)))
                      x-span))
                  trap-id
                  unit-id)
                (ast.ast-expr-list-new))))))]
    [inner-loop : i64 (lower-foreach2-loop pools inner-id x0 x1 body)]
    [outer-loop : i64 (lower-foreach2-loop pools outer-id y0 y1 inner-loop)]
    [nonempty : i64
      (ast.ast-node-pool-context-expr-push
        pools
        (Begin
          (ast.ast-expr-cons
            checks
            (ast.ast-expr-cons outer-loop (ast.ast-expr-list-new)))))]
    [root-id : i64
      (ast.ast-expr-let-with-pools
        pools
        (ast.ast-let-binding-cons
          (ast.ast-let-binding-id y0 (Some (I64)) outer-start)
          (ast.ast-let-binding-cons
            (ast.ast-let-binding-id y1 (Some (I64)) outer-end)
            (ast.ast-let-binding-cons
              (ast.ast-let-binding-id x0 (Some (I64)) inner-start)
              (ast.ast-let-binding-cons
                (ast.ast-let-binding-id x1 (Some (I64)) inner-end)
                (ast.ast-let-binding-list-new)))))
        (ast.ast-expr-if-with-pools
          pools
          (ast.ast-expr-binary-with-pools
            pools
            (Lt)
            (lower-foreach2-var pools y0)
            (lower-foreach2-var pools y1))
          (ast.ast-expr-if-with-pools
            pools
            (ast.ast-expr-binary-with-pools
              pools
              (Lt)
              (lower-foreach2-var pools x0)
              (lower-foreach2-var pools x1))
            nonempty
            unit-id)
          unit-id))]
    (lower-expr ctx state env type-env (lower-context-expr-get ctx root-id))))

(define (lower-foreach2-var [pools : ast.AstNodePoolContext] [id : i64]) : i64
  (ast.ast-node-pool-context-expr-push pools (Var id)))

(define (lower-foreach2-binary
  [pools : ast.AstNodePoolContext]
  [op : ast.AstBinOp]
  [left-id : i64]
  [right-id : i64]) : i64
  (ast.ast-expr-binary-with-pools
    pools
    op
    (lower-foreach2-var pools left-id)
    (lower-foreach2-var pools right-id)))

(define (lower-foreach2-trap-if
  [pools : ast.AstNodePoolContext]
  [cond : i64]
  [trap-id : i64]
  [unit-id : i64]) : i64
  (ast.ast-expr-if-with-pools pools cond trap-id unit-id))

;; (let [coord : i64 begin] (while (< coord end) (begin body (set! coord (+ coord 1)))))
(define (lower-foreach2-loop
  [pools : ast.AstNodePoolContext]
  [coord : i64]
  [begin-id : i64]
  [end-id : i64]
  [body : i64]) : i64
  (ast.ast-expr-let-with-pools
    pools
    (ast.ast-let-binding-cons
      (ast.ast-let-binding-id
        coord
        (Some (I64))
        (lower-foreach2-var pools begin-id))
      (ast.ast-let-binding-list-new))
    (ast.ast-expr-while-with-pools
      pools
      (lower-foreach2-binary pools (Lt) coord end-id)
      (ast.ast-node-pool-context-expr-push
        pools
        (Begin
          (ast.ast-expr-cons
            body
            (ast.ast-expr-cons
              (ast.ast-expr-set-id-with-pools
                pools
                coord
                (ast.ast-expr-binary-with-pools
                  pools
                  (Add)
                  (lower-foreach2-var pools coord)
                  (ast.ast-node-pool-context-expr-push
                    pools
                    (Literal (ast.ast-lit-int 1)))))
              (ast.ast-expr-list-new))))))))

(define (lower-spmd-broadcast
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ast.AstExpr]
  [lane : ast.AstExpr]) : ResultLowerExpr
  (let
    [lane-lowered
      (try
        (lower-expr-expected
          ctx
          state
          env
          type-env
          (lower-global-shared-view lane)
          (I64)
          lane))]
    (match lane-lowered
      [(Expr lane-state lane-value _)
        (lower-expr
          ctx
          (lower-emit-spmd-broadcast-lane-check lane-state lane-value (I64 1))
          env
          type-env
          value)])))

(define (lower-spmd-shuffle-diagnostic) : String
  "lower: SPMD spmd-shuffle requires scalar backend until SIMD shuffle lowering lands")

(define (lower-spmd-shuffle
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ast.AstExpr]
  [lane : ast.AstExpr]) : ResultLowerExpr
  (if (lower-mode-simd? (lower-state-mode state))
    (Err (box (lower-diagnostic (lower-spmd-shuffle-diagnostic))))
    (let
      [lane-lowered
        (try
          (lower-expr-expected
            ctx
            state
            env
            type-env
            (lower-global-shared-view lane)
            (I64)
            lane))]
      (match lane-lowered
        [(Expr lane-state lane-value _)
          (lower-expr
            ctx
            (lower-emit-spmd-broadcast-lane-check lane-state lane-value (I64 1))
            env
            type-env
            value)]))))

(define (lower-mode-simd? [mode : CompilerLowerMode]) : bool
  (match (lower-mode-simd mode)
    [(Scalar) false]
    [_ true]))

(define (lower-mode-avx2? [mode : CompilerLowerMode]) : bool
  (match (lower-mode-simd mode)
    [(Avx2) true]
    [_ false]))

(define (lower-mode-avx512? [mode : CompilerLowerMode]) : bool
  (match (lower-mode-simd mode)
    [(Avx512) true]
    [_ false]))

(define (lower-spmd-numeric-backend [mode : CompilerLowerMode]) : spmd_numeric.CompilerSpmdNumericBackend
  (if (lower-mode-avx2? mode)
    (Avx2)
    (if (lower-mode-avx512? mode)
      (Avx512)
      (Scalar))))

(define (lower-avx2-masked-if-diagnostic) : String
  "lower: SPMD masked if is not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-avx2-varying-while-diagnostic) : String
  "lower: SPMD varying while is not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-simd-foreach-fallback-diagnostic) : String
  "lower: SPMD foreach does not match a SIMD lowering pattern for this backend mode; use scalar or a contiguous map/zip body with supported array and uniform operands")

(define (lower-mode-linux-c-abi? [mode : CompilerLowerMode]) : bool
  (match (lower-mode-abi mode)
    [(Linux) true]
    [_ false]))

(define (lower-mode-windows-c-abi? [mode : CompilerLowerMode]) : bool
  (match (lower-mode-abi mode)
    [(Windows) true]
    [_ false]))

(define (lower-mode-c-abi? [mode : CompilerLowerMode]) : bool
  (or (lower-mode-linux-c-abi? mode) (lower-mode-windows-c-abi? mode)))

(define (lower-type-i64? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(I64) true]
    [_ false]))

(define (lower-type-bool? [ty : (& ty ast.AstType)]) : bool
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (match (tc_core.tc-type-without-regions ty)
      [(Bool) true]
      [_ false])))

(define (lower-avx512-bool-lanes [mode : CompilerLowerMode]) : i64
  (lower-simd-vector-bytes mode))

;; Lanes of one vector register for element type `ty`: the register width over
;; the element size, 0 in scalar mode or for a non-numeric element.
(define (lower-simd-lanes-for-elem
  [mode : CompilerLowerMode]
  [ty : ast.AstType]) : i64
  (let
    [elem-bytes : i64
      (match (tc_core.tc-type-without-regions ty)
        [(I64) 8]
        [(U64) 8]
        [(F64) 8]
        [(F32) 4]
        [(I32) 4]
        [(U32) 4]
        [(I16) 2]
        [(U16) 2]
        [(I8) 1]
        [(U8) 1]
        [_ 0])]
    (if (= elem-bytes 0)
      0
      (/ (lower-simd-vector-bytes mode) elem-bytes))))

(define (lower-expr-is-var?
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]
  [name : (& name str)]) : bool
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-is-var? ctx inner name))]
    [(Var found) (string.eq (tc_core.tc-env-key-name-text found) name)]
    [_ false]))

(define (lower-expr-is-program-index?
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(Spanned inner-box _)
      (lower-expr-is-program-index? ctx (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-expr-is-program-index? ctx (lower-context-expr-get ctx inner-box))]
    [(SpmdProgramIndex) true]
    [_ false]))

;; SPMD plans carry a sequence variable id naming a dynamic-array descriptor.
;; Native Slice references are register groups instead: word 0 is the data
;; pointer and word 1 is the length. Keep the compact plan representation by
;; tagging Slice ids as `-(id + 1)`; function-local IR ids are non-negative.
(define (lower-sequence-var-slice [var-id : i64]) : i64
  (- 0 (+ var-id 1)))

(define (lower-sequence-var-slice? [sequence-var : i64]) : bool
  (< sequence-var 0))

(define (lower-sequence-var-id [sequence-var : i64]) : i64
  (if (lower-sequence-var-slice? sequence-var)
    (- 0 (+ sequence-var 1))
    sequence-var))

(define (lower-sequence-ir-value [sequence-var : i64]) : ir.CompilerIrValue
  (Var (lower-sequence-var-id sequence-var)))

(define (lower-contiguous-sequence-var
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : LowerMaybeArrayVar
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-contiguous-sequence-var ctx env type-env inner))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-contiguous-sequence-var ctx env type-env inner))]
    [(Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? var-id)
          (match (tc_core.tc-lookup-id type-env name)
            [(Ok ty)
              (match (tc_core.tc-type-strip-region ty)
                [(DynArray elem-ty)
                  (Some
                    var-id
                    (tc_core.tc-type-without-regions
                      (tc_core.tc-context-type-get ctx elem-ty)))]
                [(Ref _ referent-ty)
                  (match (tc_core.tc-type-strip-region
                    (tc_core.tc-context-type-get ctx referent-ty))
                    [(DynArray elem-ty)
                      (Some
                        var-id
                        (tc_core.tc-type-without-regions
                          (tc_core.tc-context-type-get ctx elem-ty)))]
                    ;; Slice references are tagged here so emitters extract the
                    ;; two words from the register group instead of loading a
                    ;; dynamic-array descriptor through the data pointer.
                    [(Slice elem-ty)
                      (Some
                        (lower-sequence-var-slice var-id)
                        (tc_core.tc-type-without-regions
                          (tc_core.tc-context-type-get ctx elem-ty)))]
                    [_ (No)])]
                [(MutRef _ referent-ty)
                  (match (tc_core.tc-type-strip-region
                    (tc_core.tc-context-type-get ctx referent-ty))
                    [(DynArray elem-ty)
                      (Some
                        var-id
                        (tc_core.tc-type-without-regions
                          (tc_core.tc-context-type-get ctx elem-ty)))]
                    [(Slice elem-ty)
                      (Some
                        (lower-sequence-var-slice var-id)
                        (tc_core.tc-type-without-regions
                          (tc_core.tc-context-type-get ctx elem-ty)))]
                    [_ (No)])]
                [_ (No)])]
            [(Err _) (No)])
          (No)))]
    [_ (No)]))

(define (lower-array-ref-var-for-index
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [index : (& index str)]) : LowerMaybeArrayVar
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-array-ref-var-for-index ctx env type-env inner index))]
    [(ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (if (lower-expr-is-var? ctx idx index)
          (lower-contiguous-sequence-var ctx env type-env arr)
          (No)))]
    [_ (No)]))

(define (lower-array-ref-var-for-program-index
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : LowerMaybeArrayVar
  (match expr
    [(Spanned inner-box _)
      (lower-array-ref-var-for-program-index
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (if (lower-expr-is-program-index? ctx idx)
          (lower-contiguous-sequence-var ctx env type-env arr)
          (No)))]
    [_ (No)]))

(define (lower-simple-spmd-broadcast-lane
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : LowerMaybeIrValue
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-spmd-broadcast-lane ctx env type-env inner))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-spmd-broadcast-lane ctx env type-env inner))]
    [(Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-spmd-broadcast-lane ctx env type-env inner))]
    [(Literal (Int n text))
      (Some (I64 (ast.ast-int-literal-value-or-payload n text)))]
    [(Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? var-id)
          (match (tc_core.tc-lookup-id type-env name)
            [(Ok ty)
              (if (tc_core.tc-type-eq
                (tc_core.tc-type-without-regions ty)
                (I64))
                (Some (Var var-id))
                (No))]
            [(Err _) (No)])
          (No)))]
    [_ (No)]))

(define (lower-array-var-set-empty) : LowerArrayVarSet
  (LowerArrayVarSet (__tl_make-array i64 0) (__tl_make-array i64 0) 0))

(define (lower-array-var-set-add
  [set : LowerArrayVarSet]
  [var : i64]
  [offset : i64]) : LowerArrayVarSet
  (let
    [vars : (__tl_dyn-array i64) set.vars]
    [offsets : (__tl_dyn-array i64) set.offsets]
    [count : i64 set.count]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (if (= (array-ref vars index) var)
        (begin
          (if (> offset (array-ref offsets index))
            (set! (array-ref offsets index) offset)
            unit)
          (set! found true))
        (set! index (+ index 1))))
    (if found
      (LowerArrayVarSet vars offsets count)
      (begin
        (__tl_array-push! vars var)
        (__tl_array-push! offsets offset)
        (LowerArrayVarSet vars offsets (+ count 1))))))

(define (lower-array-var-set-merge
  [left : LowerArrayVarSet]
  [right : LowerArrayVarSet]) : LowerArrayVarSet
  (let
    [vars : (__tl_dyn-array i64) right.vars]
    [offsets : (__tl_dyn-array i64) right.offsets]
    [count : i64 right.count]
    [index : i64 0]
    [out : LowerArrayVarSet left]
    (while (< index count)
      (set!
        out
        (lower-array-var-set-add
          out
          (array-ref vars index)
          (array-ref offsets index)))
      (set! index (+ index 1)))
    out))

(define (lower-array-var-set-max-offset [set : (& set LowerArrayVarSet)]) : i64
  (let
    [offsets : (__tl_dyn-array i64) set.offsets]
    [count : i64 set.count]
    [index : i64 0]
    [max-offset : i64 0]
    (while (< index count)
      (let
        [offset : i64 (array-ref offsets index)]
        (if (> offset max-offset)
          (set! max-offset offset)
          unit)
        (set! index (+ index 1))))
    max-offset))

(define (lower-masked-vector-index-literal-offset
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-literal-offset ctx inner))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-literal-offset ctx inner))]
    [(Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-literal-offset ctx inner))]
    [(Literal (Int n text))
      (let
        [value : i64 (ast.ast-int-literal-value-or-payload n text)]
        (if (>= value 0)
          value
          -1))]
    [_ -1]))

(define (lower-masked-vector-positive-power-two-literal
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-positive-power-two-literal ctx inner))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-positive-power-two-literal ctx inner))]
    [(Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-positive-power-two-literal ctx inner))]
    [(Literal (Int n text))
      (let
        [value : i64 (ast.ast-int-literal-value-or-payload n text)]
        (if (> value 0)
          (if (= (bit-and value (- value 1)) 0)
            value
            -1)
          -1))]
    [_ -1]))

(define (lower-masked-vector-index-offset
  [ctx : tc_core.TcContext]
  [index : (& index str)]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-offset ctx index inner))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-offset ctx index inner))]
    [(Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-offset ctx index inner))]
    [(Var name)
      (if (string.eq (tc_core.tc-env-key-name-text name) index)
        0
        -1)]
    [(Binary op left-box right-box)
      (match op
        [(Add)
          (let
            [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
            [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
            [left-offset : i64
              (lower-masked-vector-index-offset
                ctx
                index
                (lower-global-shared-view left))]
            [right-offset : i64
              (lower-masked-vector-index-offset
                ctx
                index
                (lower-global-shared-view right))]
            (if (= left-offset 0)
              (lower-masked-vector-index-literal-offset ctx right)
              (if (= right-offset 0)
                (lower-masked-vector-index-literal-offset ctx left)
                -1)))]
        [_ -1])]
    [_ -1]))

(define (lower-masked-vector-lanes-merge [left : i64] [right : i64]) : i64
  (cond
    [(< left 0) -1]
    [(< right 0) -1]
    [(= left 0) right]
    [(= right 0) left]
    [(= left right) left]
    [else -1]))

(define (lower-masked-vector-binop-supported?
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [op : ast.AstBinOp]) : bool
  (match op
    ;; These are bool operations rather than numeric rows.
    [(And) true]
    [(Or) true]
    [_
      ;; Type checking has already excluded float bitwise/remainder rows.
      ;; Numeric admission is otherwise width-independent at lane census time.
      (let
        [destination : ast.AstType
          (if (spmd_numeric.compiler-spmd-numeric-comparison-op? op)
            (Bool)
            (I64))]
        [helper-body : bool
          (>
            (compiler-lower-function-state-inline-helper-stack function-state).len
            0)]
        (if helper-body
          (and
            (spmd_numeric.compiler-spmd-numeric-decision-supported?
              (spmd_numeric.compiler-spmd-numeric-binary-decision
                (I64)
                (lower-global-shared-view destination)
                (InlineHelper)
                (lower-spmd-numeric-backend mode)
                op))
            (spmd_numeric.compiler-spmd-numeric-decision-supported?
              (spmd_numeric.compiler-spmd-numeric-binary-decision
                (I64)
                destination
                (PrivateHelper)
                (lower-spmd-numeric-backend mode)
                op)))
          (spmd_numeric.compiler-spmd-numeric-decision-supported?
            (spmd_numeric.compiler-spmd-numeric-binary-decision
              (I64)
              destination
              (MaskedControl)
              (lower-spmd-numeric-backend mode)
              op))))]))

(define (lower-masked-spmd-numeric-expr-type
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : tc_core.ResultTcType
  (match (tc_core.tc-expr ctx type-env (lower-global-shared-view expr))
    [(Ok ty) (Ok ty)]
    [(Err _)
      ;; The foreach index is represented by the planner rather than bound in
      ;; this outer type environment. Recover the checked lane type from common
      ;; SPMD value forms without mutating or rendering policy state.
      (match expr
        [(Spanned inner-box _)
          (lower-masked-spmd-numeric-expr-type
            ctx
            env
            type-env
            (lower-context-expr-get ctx inner-box))]
        [(Ann inner-box _)
          (lower-masked-spmd-numeric-expr-type
            ctx
            env
            type-env
            (lower-context-expr-get ctx inner-box))]
        [(ArrayRef array-box _)
          (match (lower-contiguous-sequence-var
            ctx
            env
            type-env
            (lower-context-expr-get ctx array-box))
            [(Some _ elem-ty) (Ok elem-ty)]
            [(No) (Err "lower: cannot recover SPMD numeric array element type")])]
        [(Var name) (tc_core.tc-lookup-id type-env name)]
        [(Binary _ left-box _)
          (lower-masked-spmd-numeric-expr-type
            ctx
            env
            type-env
            (lower-context-expr-get ctx left-box))]
        [(Cast _ target-ty-id)
          (Ok (tc_core.tc-context-type-get ctx target-ty-id))]
        [(Literal literal) (Ok (tc_core.tc-literal-type literal))]
        [_ (Err "lower: cannot recover SPMD numeric expression type")])]))

;; Test builds can make the masked census admit every typed cast, so lowerer
;; tests reach the masked emitter's own cast check (#7306).
(cfg
  test
  (define lower-masked-census-admits-every-cast : bool
    false))

(cfg
  test
  (define (lower-masked-census-admit-every-cast! [admit : bool]) : unit
    (set! lower-masked-census-admits-every-cast admit)))

(define (lower-masked-spmd-numeric-conversion-supported?
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [source : ast.AstType]
  [destination : ast.AstType]) : bool
  (let
    [helper-body : bool
      (>
        (compiler-lower-function-state-inline-helper-stack function-state).len
        0)]
    (or
      (cfg test lower-masked-census-admits-every-cast false)
      (if helper-body
        (and
          (spmd_numeric.compiler-spmd-numeric-decision-supported?
            (spmd_numeric.compiler-spmd-numeric-conversion-decision
              (lower-global-shared-view source)
              (lower-global-shared-view destination)
              (InlineHelper)
              (lower-spmd-numeric-backend mode)))
          (spmd_numeric.compiler-spmd-numeric-decision-supported?
            (spmd_numeric.compiler-spmd-numeric-conversion-decision
              source
              destination
              (PrivateHelper)
              (lower-spmd-numeric-backend mode))))
        (spmd_numeric.compiler-spmd-numeric-decision-supported?
          (spmd_numeric.compiler-spmd-numeric-conversion-decision
            source
            destination
            (MaskedControl)
            (lower-spmd-numeric-backend mode)))))))

(define (lower-masked-vector-unop-supported? [op : ast.AstUnOp]) : bool
  (match op
    [(Not) true]
    [_ false]))

(define (lower-masked-vector-empty-lane-locals) : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 16))

(define (lower-masked-vector-lane-locals-from-set
  [items : (& items LowerIdSet)]
  [lanes : i64]) : lower_i64_i64_map.Map
  (let
    [out : lower_i64_i64_map.Map (lower-masked-vector-empty-lane-locals)]
    [index : i64 items.len]
    (while (> index 0)
      (set! index (- index 1))
      (lower_i64_i64_map.insert-ref!
        (&mut out)
        (array-ref items.slots index)
        lanes))
    out))

(define (lower-masked-vector-lane-locals-bind-if-varying
  [lane-locals : lower_i64_i64_map.Map]
  [name : i64]
  [lanes : i64]) : lower_i64_i64_map.Map
  (if (> lanes 0)
    (let
      [out : lower_i64_i64_map.Map lane-locals]
      (lower_i64_i64_map.insert-ref! (&mut out) name lanes)
      out)
    lane-locals))

(define (lower-spmd-numeric-let-type-env-at
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : tc_core.TcTypeEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    type-env
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          (match (tc_core.tc-expr ctx type-env init)
            [(Ok init-ty)
              (lower-spmd-numeric-let-type-env-at
                ctx
                (tc_core.tc-bind-id
                  type-env
                  name
                  (lower-let-binding-type ctx maybe-ty init-ty))
                bindings
                (+ index 1))]
            [(Err _) type-env]))])))

(define (lower-spmd-numeric-let-type-env
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]) : tc_core.TcTypeEnv
  (lower-spmd-numeric-let-type-env-at ctx type-env (& bindings) 0))

(define (lower-masked-vector-expr-list-lanes-with-locals
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : ast.AstExprList]) : i64
  (lower-masked-vector-expr-list-lanes-with-locals-at
    ctx
    function-state
    mode
    env
    type-env
    index
    lane-locals
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-lanes-with-locals-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : i64
  (if (>= expr-index exprs.len)
    0
    (let
      [expr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0))]
      (lower-masked-vector-lanes-merge
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          function-state
          mode
          env
          type-env
          (lower-global-shared-view index)
          lane-locals
          expr)
        (lower-masked-vector-expr-list-lanes-with-locals-at
          ctx
          function-state
          mode
          env
          type-env
          index
          lane-locals
          exprs
          (+ expr-index 1))))))

(define (lower-masked-vector-let-bindings-locals
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings ast.AstLetBindingList)]) : lower_i64_i64_map.Map
  (lower-masked-vector-let-bindings-locals-at
    ctx
    function-state
    mode
    env
    type-env
    index
    lane-locals
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-locals-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : lower_i64_i64_map.Map
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    lane-locals
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding name _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [init-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              (lower-global-shared-view index)
              lane-locals
              init)]
          [next-locals : lower_i64_i64_map.Map
            (lower-masked-vector-lane-locals-bind-if-varying
              lane-locals
              name
              init-lanes)]
          (lower-masked-vector-let-bindings-locals-at
            ctx
            function-state
            mode
            env
            type-env
            index
            next-locals
            bindings
            (+ binding-index 1)))])))

(define (lower-masked-vector-let-bindings-lanes-with-locals
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : ast.AstLetBindingList]) : i64
  (lower-masked-vector-let-bindings-lanes-with-locals-at
    ctx
    function-state
    mode
    env
    type-env
    index
    lane-locals
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-lanes-with-locals-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : i64
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    0
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding name _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [init-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              (lower-global-shared-view index)
              lane-locals
              init)]
          [next-locals : lower_i64_i64_map.Map
            (lower-masked-vector-lane-locals-bind-if-varying
              lane-locals
              name
              init-lanes)]
          (lower-masked-vector-lanes-merge
            init-lanes
            (lower-masked-vector-let-bindings-lanes-with-locals-at
              ctx
              function-state
              mode
              env
              type-env
              index
              next-locals
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-pattern-locals
  [pattern : ast.AstPattern]
  [scrut-lanes : i64]
  [lane-locals : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (if (> scrut-lanes 0)
    (match pattern
      [(Var name _)
        (lower-masked-vector-lane-locals-bind-if-varying
          lane-locals
          name
          scrut-lanes)]
      [(Tuple patterns-box)
        (lower-masked-vector-pattern-list-locals
          (deref patterns-box)
          scrut-lanes
          lane-locals)]
      [(Array patterns-box)
        (lower-masked-vector-pattern-list-locals
          (deref patterns-box)
          scrut-lanes
          lane-locals)]
      [(Slice patterns-box _)
        (lower-masked-vector-pattern-list-locals
          (deref patterns-box)
          scrut-lanes
          lane-locals)]
      [(Binding name)
        (lower-masked-vector-lane-locals-bind-if-varying
          lane-locals
          name
          scrut-lanes)]
      [(Variant _ patterns-box)
        (lower-masked-vector-pattern-list-locals
          (deref patterns-box)
          scrut-lanes
          lane-locals)]
      [_ lane-locals])
    lane-locals))

(define (lower-masked-vector-pattern-list-locals
  [patterns : ast.AstPatternList]
  [scrut-lanes : i64]
  [lane-locals : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (lower-masked-vector-pattern-list-locals-at
    (& patterns)
    scrut-lanes
    lane-locals
    0))

(define (lower-masked-vector-pattern-list-locals-at
  [patterns : (& patterns ast.AstPatternList)]
  [scrut-lanes : i64]
  [lane-locals : lower_i64_i64_map.Map]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index patterns.len)
    lane-locals
    (lower-masked-vector-pattern-list-locals-at
      patterns
      scrut-lanes
      (lower-masked-vector-pattern-locals
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
        scrut-lanes
        lane-locals)
      (+ index 1))))

(define (lower-masked-vector-match-arms-lanes-with-locals
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [scrut-lanes : i64]
  [arms : ast.AstMatchArmList]) : i64
  (lower-masked-vector-match-arms-lanes-with-locals-at
    ctx
    function-state
    mode
    env
    type-env
    index
    lane-locals
    scrut-lanes
    (& arms)
    0))

(define (lower-masked-vector-match-arms-lanes-with-locals-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [scrut-lanes : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [arm-index : i64]) : i64
  (if (>= arm-index arms.len)
    0
    (match (ast.ast-match-arm-list-get
      arms
      arm-index
      (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
          [body-locals : lower_i64_i64_map.Map
            (lower-masked-vector-pattern-locals
              pattern
              scrut-lanes
              (lower-global-shared-view lane-locals))]
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              (lower-global-shared-view index)
              body-locals
              body)
            (lower-masked-vector-match-arms-lanes-with-locals-at
              ctx
              function-state
              mode
              env
              type-env
              index
              lane-locals
              scrut-lanes
              arms
              (+ arm-index 1))))])))

(define (lower-spmd-call-args-lanes
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [args : (& args ast.AstExprList)]) : i64
  (lower-spmd-call-args-lanes-at
    ctx
    function-state
    mode
    env
    type-env
    index
    lane-locals
    (& args)
    0))

(define (lower-spmd-call-args-lanes-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]) : i64
  (if (>= arg-index args.len)
    0
    (lower-masked-vector-lanes-merge
      (lower-masked-vector-expr-lanes-with-locals
        ctx
        function-state
        mode
        env
        type-env
        (lower-global-shared-view index)
        lane-locals
        (lower-context-expr-get ctx (ast.ast-expr-list-get args arg-index 0)))
      (lower-spmd-call-args-lanes-at
        ctx
        function-state
        mode
        env
        type-env
        index
        lane-locals
        args
        (+ arg-index 1)))))

(define (lower-spmd-helper-param-locals
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [caller-locals : lower_i64_i64_map.Map]
  [params : ast.AstParamList]
  [args : (& args ast.AstExprList)]) : lower_i64_i64_map.Map
  (lower-spmd-helper-param-locals-at
    ctx
    function-state
    mode
    env
    type-env
    index
    caller-locals
    (& params)
    (& args)
    0
    (lower-masked-vector-empty-lane-locals)))

(define (lower-spmd-helper-param-locals-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [caller-locals : lower_i64_i64_map.Map]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (if (or
    (>= arg-index (ast.ast-param-list-len params))
    (>= arg-index args.len))
    out
    (match (ast.ast-param-list-get params arg-index (ast.ast-param-fallback))
      [(Param name _ _)
        (let
          [arg-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              (lower-global-shared-view index)
              caller-locals
              (lower-context-expr-get
                ctx
                (ast.ast-expr-list-get args arg-index 0)))]
          (lower-spmd-helper-param-locals-at
            ctx
            function-state
            mode
            env
            type-env
            index
            caller-locals
            params
            args
            (+ arg-index 1)
            (lower-masked-vector-lane-locals-bind-if-varying out name arg-lanes)))])))

(define (lower-imported-spmd-source-args-code-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]) : String
  (if (>= arg-index args.len)
    ""
    (let
      [arg-lanes : i64
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          function-state
          mode
          env
          type-env
          (lower-global-shared-view index)
          lane-locals
          (lower-context-expr-get ctx (ast.ast-expr-list-get args arg-index 0)))]
      (str_cat.str-cat
        (cond [(> arg-lanes 0) "v"] [(= arg-lanes 0) "u"] [else "?"])
        (lower-imported-spmd-source-args-code-at
          ctx
          function-state
          mode
          env
          type-env
          index
          lane-locals
          args
          (+ arg-index 1))))))

(define (lower-imported-spmd-direct-call-result-lanes
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]
  [canonical-name : ci.InternId]
  [fn-ty : ast.AstType]
  [callables : ast.AstImportedSpmdCallableList]) : i64
  (match fn-ty
    [(Func param-types ret-id)
      (let
        [params : ast.AstParamList
          (lower-imported-spmd-params ctx (deref param-types))]
        [ret : ast.AstType (tc_core.tc-context-type-get ctx ret-id)]
        [arg-lanes : i64
          (lower-spmd-call-args-lanes
            ctx
            function-state
            mode
            env
            type-env
            (lower-global-shared-view index)
            (lower-global-shared-view lane-locals)
            args)]
        [backend : ir.CompilerIrSpmdBackend
          (cond
            [(lower-mode-avx512? mode) (Avx512)]
            [(lower-mode-avx2? mode) (Avx2)]
            [else (Scalar)])]
        [lanes : i64
          (match backend
            [(Scalar) 1]
            [_ arg-lanes])]
        [args-code : String
          (lower-imported-spmd-source-args-code-at
            ctx
            function-state
            mode
            env
            type-env
            (lower-global-shared-view index)
            lane-locals
            (& args)
            0)]
        [unknown-arg-code : String "?"]
        [imported-interns : ci.InternCompatState
          (compiler-lower-state-interns
            (compiler-lower-function-state-owner function-state))]
        (cond
          [(= arg-lanes 0) 0]
          [(or
              (< arg-lanes 0)
              (string.contains (& args-code) (& unknown-arg-code)))
            -1]
          [else
            (match (lower-imported-spmd-select
              (& imported-interns)
              (tc_core.tc-context-pools ctx)
              canonical-name
              (& callables)
              (lower-spmd-source-signature
                params
                (lower-global-shared-view ret))
              backend
              lanes
              args-code
              (lower-imported-spmd-index-param ctx index args)
              (lower-global-shared-view ret)
              func)
              [(Err _) -1]
              [(Ok specialization)
                (if (or
                  (tc_core.tc-type-eq
                    (tc_core.tc-type-without-regions ret)
                    (Unit))
                  (lower-imported-spmd-result-varying?
                    (& imported-interns)
                    specialization))
                  arg-lanes
                  0)])]))]
    [_ -1]))

(define (lower-spmd-direct-call-result-lanes
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]) : i64
  (let
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    (match (ast.ast-expr-unspan-with-pools
      (& pools)
      (lower-global-shared-view func))
      [(Var raw-name)
        (if (sym_i64_env.sym-i64-contains-id env raw-name)
          -1
          (match (lower-spmd-inline-helper-lookup
            ctx
            function-state
            env
            type-env
            (lower-id-set-empty)
            (lower-global-shared-view func))
            [(Ok helper)
              (match helper
                [(Some name params _ body)
                  (let
                    [arg-lanes : i64
                      (lower-spmd-call-args-lanes
                        ctx
                        function-state
                        mode
                        env
                        type-env
                        (lower-global-shared-view index)
                        (lower-global-shared-view lane-locals)
                        args)]
                    (if (< arg-lanes 0)
                      -1
                      (let
                        [previous : LowerIdSet
                          (compiler-lower-function-state-inline-helper-stack
                            function-state)]
                        [result : i64 -1]
                        (compiler-lower-function-state-inline-helper-stack-set!
                          function-state
                          (lower-id-set-insert
                            (lower-global-shared-view previous)
                            name))
                        (set!
                          result
                          (let
                            [lane-locals-arg
                              (lower-spmd-helper-param-locals
                                ctx
                                function-state
                                mode
                                env
                                type-env
                                index
                                lane-locals
                                params
                                args)]
                            (lower-masked-vector-expr-lanes-with-locals
                              ctx
                              function-state
                              mode
                              env
                              type-env
                              ""
                              lane-locals-arg
                              body)))
                        (compiler-lower-function-state-inline-helper-stack-set!
                          function-state
                          previous)
                        (if (< result 0)
                          arg-lanes
                          result))))]
                [(Imported _ _ canonical-name fn-ty callables)
                  (lower-imported-spmd-direct-call-result-lanes
                    ctx
                    function-state
                    mode
                    env
                    type-env
                    index
                    lane-locals
                    func
                    args
                    canonical-name
                    fn-ty
                    (deref callables))]
                [(No) -1])]
            [(Err _) -1]))]
      [_ -1])))

(define (lower-masked-vector-expr-lanes-with-locals
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [lane-locals : (& lane-locals lower_i64_i64_map.Map)]
  [expr : ast.AstExpr]) : i64
  (let
    [lane-locals : lower_i64_i64_map.Map
      (owned_view.compiler-owned-reference-shared-view lane-locals)]
    (match expr
      [(Spanned inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            function-state
            mode
            env
            type-env
            index
            lane-locals
            inner))]
      [(Ann inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            function-state
            mode
            env
            type-env
            index
            lane-locals
            inner))]
      [(Cast inner-box cast-ty-id)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          [target-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type
                ctx
                (tc_core.tc-context-type-get ctx cast-ty-id)))]
          (if (or
            (tc_core.tc-integer-literal-expr?
              ctx
              (lower-global-shared-view inner))
            (tc_core.tc-float-literal-expr?
              ctx
              (lower-global-shared-view inner)))
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              index
              lane-locals
              inner)
            (match (lower-masked-spmd-numeric-expr-type
              ctx
              env
              type-env
              (lower-global-shared-view inner))
              [(Ok source-ty)
                (if (lower-masked-spmd-numeric-conversion-supported?
                  function-state
                  mode
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx source-ty))
                  target-ty)
                  (lower-masked-vector-expr-lanes-with-locals
                    ctx
                    function-state
                    mode
                    env
                    type-env
                    index
                    lane-locals
                    inner)
                  -1)]
              [(Err _) -1])))]
      [(Literal _) 0]
      [(Var name)
        (let
          [name-text : String (tc_core.tc-env-key-name-text name)]
          (match (lower_i64_i64_map.get (& lane-locals) name)
            [(LookupFound lanes) lanes]
            [(LookupMissing)
              (if (string.eq name-text index)
                (lower-simd-lanes-for-elem mode (I64))
                0)]))]
      [(Unary op inner-box)
        (if (lower-masked-vector-unop-supported? op)
          (let
            [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              index
              lane-locals
              inner))
          -1)]
      [(Binary op left-box right-box)
        (let
          [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
          [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
          [operand-lanes : i64
            (lower-masked-vector-lanes-merge
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                function-state
                mode
                env
                type-env
                (lower-global-shared-view index)
                lane-locals
                left)
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                function-state
                mode
                env
                type-env
                index
                lane-locals
                right))]
          (if (lower-masked-vector-binop-supported? function-state mode op)
            operand-lanes
            -1))]
      [(Call func-box args)
        (lower-spmd-direct-call-result-lanes
          ctx
          function-state
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx func-box)
          args)]
      [(Let let-box)
        (match (__tl-box-place let-box)
          [(Let bindings body-box)
            (let
              [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
              [body-locals : lower_i64_i64_map.Map
                (lower-masked-vector-let-bindings-locals
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  (lower-global-shared-view index)
                  (lower-global-shared-view lane-locals)
                  bindings)]
              [body-type-env : tc_core.TcTypeEnv
                (lower-spmd-numeric-let-type-env ctx type-env bindings)]
              (lower-masked-vector-lanes-merge
                (lower-masked-vector-let-bindings-lanes-with-locals
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  (lower-global-shared-view index)
                  lane-locals
                  bindings)
                (lower-masked-vector-expr-lanes-with-locals
                  ctx
                  function-state
                  mode
                  env
                  body-type-env
                  index
                  body-locals
                  body)))])]
      [(If cond-box then-box else-box)
        (let
          [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
          [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
          [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              (lower-global-shared-view index)
              lane-locals
              cond)
            (lower-masked-vector-lanes-merge
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                function-state
                mode
                env
                type-env
                (lower-global-shared-view index)
                lane-locals
                then-branch)
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                function-state
                mode
                env
                type-env
                index
                lane-locals
                else-branch))))]
      [(While cond-box body-box)
        (let
          [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
          [body : ast.AstExpr (Begin body-box)]
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              (lower-global-shared-view index)
              lane-locals
              cond)
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              index
              lane-locals
              body)))]
      [(Match match-box)
        (match (__tl-box-place match-box)
          [(Match scrutinee-box arms)
            (let
              [scrutinee : ast.AstExpr
                (lower-context-expr-get ctx scrutinee-box)]
              [scrut-lanes : i64
                (lower-masked-vector-expr-lanes-with-locals
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  (lower-global-shared-view index)
                  lane-locals
                  scrutinee)]
              (lower-masked-vector-lanes-merge
                scrut-lanes
                (lower-masked-vector-match-arms-lanes-with-locals
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  index
                  lane-locals
                  scrut-lanes
                  arms)))])]
      [(Begin exprs)
        (lower-masked-vector-expr-list-lanes-with-locals
          ctx
          function-state
          mode
          env
          type-env
          index
          lane-locals
          exprs)]
      [(ArrayRef arr-box idx-box)
        (let
          [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
          [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
          (if (>= (lower-masked-vector-index-offset ctx index idx) 0)
            (match (lower-contiguous-sequence-var ctx env type-env arr)
              [(Some _ elem-ty)
                (if (lower-type-bool? elem-ty)
                  (lower-avx512-bool-lanes mode)
                  (lower-simd-lanes-for-elem mode elem-ty))]
              [(No) -1])
            -1))]
      [(ArraySet arr-box idx-box value-box)
        (let
          [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
          [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
          [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
          (if (>= (lower-masked-vector-index-offset ctx index idx) 0)
            (match (lower-contiguous-sequence-var ctx env type-env arr)
              [(Some _ elem-ty)
                (if (lower-type-bool? elem-ty)
                  (let
                    [value-lanes : i64
                      (lower-masked-vector-expr-lanes-with-locals
                        ctx
                        function-state
                        mode
                        env
                        type-env
                        index
                        lane-locals
                        value)]
                    (if (< value-lanes 0)
                      -1
                      (if (= value-lanes 0)
                        (lower-avx512-bool-lanes mode)
                        value-lanes)))
                  (lower-masked-vector-lanes-merge
                    (lower-simd-lanes-for-elem mode elem-ty)
                    (lower-masked-vector-expr-lanes-with-locals
                      ctx
                      function-state
                      mode
                      env
                      type-env
                      index
                      lane-locals
                      value)))]
              [(No) -1])
            -1))]
      [(StructSet receiver-box _ value-box)
        (let
          [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
          [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              (lower-global-shared-view index)
              lane-locals
              receiver)
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              index
              lane-locals
              value)))]
      [_ -1])))

(define (lower-masked-vector-expr-lanes
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [expr : ast.AstExpr]) : i64
  (let
    [lane-locals (lower-masked-vector-empty-lane-locals)]
    (lower-masked-vector-expr-lanes-with-locals
      ctx
      function-state
      mode
      env
      type-env
      index
      lane-locals
      expr)))

;; The control forms that need the masked SPMD strategy when their condition or
;; scrutinee varies across lanes.
(defenum LowerMaskedVaryingForm
  (If)
  (While)
  (Match))

;; Whether `expr` holds a FORM whose condition (if, while) or scrutinee (match)
;; has lanes. One walk serves all three questions: every form descends through
;; the same scalar, let, begin and array/struct store shapes with the same
;; lane-local scoping, and they differ only where the walk meets an if, while
;; or match. An if condition that varies answers If without looking further,
;; and only the While and Match questions descend into loops and matches.
(define (lower-masked-vector-body-has-varying-with-locals?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [form : LowerMaskedVaryingForm]
  [index : String]
  [lane-locals : (& lane-locals lower_i64_i64_map.Map)]
  [expr : ast.AstExpr]) : bool
  (let
    [lane-locals : lower_i64_i64_map.Map
      (owned_view.compiler-owned-reference-shared-view lane-locals)]
    (match expr
      [(Spanned inner-box _)
        (lower-masked-vector-body-has-varying-with-locals?
          ctx
          function-state
          mode
          env
          type-env
          form
          index
          lane-locals
          (lower-context-expr-get ctx inner-box))]
      [(Ann inner-box _)
        (lower-masked-vector-body-has-varying-with-locals?
          ctx
          function-state
          mode
          env
          type-env
          form
          index
          lane-locals
          (lower-context-expr-get ctx inner-box))]
      [(Cast inner-box _)
        (lower-masked-vector-body-has-varying-with-locals?
          ctx
          function-state
          mode
          env
          type-env
          form
          index
          lane-locals
          (lower-context-expr-get ctx inner-box))]
      [(Unary _ inner-box)
        (lower-masked-vector-body-has-varying-with-locals?
          ctx
          function-state
          mode
          env
          type-env
          form
          index
          lane-locals
          (lower-context-expr-get ctx inner-box))]
      [(Binary _ left-box right-box)
        (or
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            (lower-global-shared-view index)
            lane-locals
            (lower-context-expr-get ctx left-box))
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            index
            lane-locals
            (lower-context-expr-get ctx right-box)))]
      [(If cond-box then-box else-box)
        (or
          (match form
            [(If)
              (>
                (lower-masked-vector-expr-lanes-with-locals
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  (lower-global-shared-view index)
                  lane-locals
                  (lower-context-expr-get ctx cond-box))
                0)]
            [_
              (lower-masked-vector-body-has-varying-with-locals?
                ctx
                function-state
                mode
                env
                type-env
                form
                (lower-global-shared-view index)
                lane-locals
                (lower-context-expr-get ctx cond-box))])
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            (lower-global-shared-view index)
            lane-locals
            (lower-context-expr-get ctx then-box))
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            index
            lane-locals
            (lower-context-expr-get ctx else-box)))]
      [(While cond-box body-box)
        (match form
          [(While)
            (let
              [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
              (or
                (>
                  (lower-masked-vector-expr-lanes-with-locals
                    ctx
                    function-state
                    mode
                    env
                    type-env
                    (lower-global-shared-view index)
                    lane-locals
                    (lower-global-shared-view cond))
                  0)
                (lower-masked-vector-body-has-varying-with-locals?
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  form
                  (lower-global-shared-view index)
                  lane-locals
                  cond)
                (lower-masked-vector-body-has-varying-with-locals?
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  form
                  index
                  lane-locals
                  (Begin body-box))))]
          [_ false])]
      [(Match match-box)
        (match form
          [(Match)
            (match (__tl-box-place match-box)
              [(Match scrutinee-box arms)
                (let
                  [scrut-lanes : i64
                    (lower-masked-vector-expr-lanes-with-locals
                      ctx
                      function-state
                      mode
                      env
                      type-env
                      (lower-global-shared-view index)
                      lane-locals
                      (lower-context-expr-get ctx scrutinee-box))]
                  (or
                    (> scrut-lanes 0)
                    (lower-masked-vector-match-arms-have-varying-with-locals-at?
                      ctx
                      function-state
                      mode
                      env
                      type-env
                      form
                      index
                      lane-locals
                      scrut-lanes
                      (& arms)
                      0)))])]
          [_ false])]
      [(Let let-box)
        ;; The body's lane locals extend views of `lane-locals` in place, so the
        ;; binding scan can see them when they are computed first. If and While
        ;; compute them first and Match last; each keeps its order.
        (match (__tl-box-place let-box)
          [(Let bindings body-box)
            (match form
              [(Match)
                (or
                  (lower-masked-vector-let-bindings-have-varying-with-locals-at?
                    ctx
                    function-state
                    mode
                    env
                    type-env
                    form
                    (lower-global-shared-view index)
                    (lower-global-shared-view lane-locals)
                    (& bindings)
                    0)
                  (let
                    [index-arg (lower-global-shared-view index)]
                    [lane-locals-arg
                      (lower-masked-vector-let-bindings-locals
                        ctx
                        function-state
                        mode
                        env
                        type-env
                        index
                        lane-locals
                        bindings)]
                    (lower-masked-vector-body-has-varying-with-locals?
                      ctx
                      function-state
                      mode
                      env
                      type-env
                      form
                      index-arg
                      lane-locals-arg
                      (lower-context-expr-get ctx body-box))))]
              [_
                (let
                  [body-locals : lower_i64_i64_map.Map
                    (lower-masked-vector-let-bindings-locals
                      ctx
                      function-state
                      mode
                      env
                      type-env
                      (lower-global-shared-view index)
                      (lower-global-shared-view lane-locals)
                      bindings)]
                  (or
                    (lower-masked-vector-let-bindings-have-varying-with-locals-at?
                      ctx
                      function-state
                      mode
                      env
                      type-env
                      form
                      (lower-global-shared-view index)
                      lane-locals
                      (& bindings)
                      0)
                    (lower-masked-vector-body-has-varying-with-locals?
                      ctx
                      function-state
                      mode
                      env
                      type-env
                      form
                      index
                      body-locals
                      (lower-context-expr-get ctx body-box))))])])]
      [(Begin exprs)
        (lower-masked-vector-expr-list-has-varying-with-locals-at?
          ctx
          function-state
          mode
          env
          type-env
          form
          index
          lane-locals
          (& exprs)
          0)]
      [(ArrayRef arr-box idx-box)
        (or
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            (lower-global-shared-view index)
            lane-locals
            (lower-context-expr-get ctx arr-box))
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            index
            lane-locals
            (lower-context-expr-get ctx idx-box)))]
      [(ArraySet arr-box idx-box value-box)
        (or
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            (lower-global-shared-view index)
            lane-locals
            (lower-context-expr-get ctx arr-box))
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            (lower-global-shared-view index)
            lane-locals
            (lower-context-expr-get ctx idx-box))
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            index
            lane-locals
            (lower-context-expr-get ctx value-box)))]
      [(StructSet receiver-box _ value-box)
        (or
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            (lower-global-shared-view index)
            lane-locals
            (lower-context-expr-get ctx receiver-box))
          (lower-masked-vector-body-has-varying-with-locals?
            ctx
            function-state
            mode
            env
            type-env
            form
            index
            lane-locals
            (lower-context-expr-get ctx value-box)))]
      [_ false])))

(define (lower-masked-vector-expr-list-has-varying-with-locals-at?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [form : LowerMaskedVaryingForm]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : bool
  (if (>= expr-index exprs.len)
    false
    (or
      (lower-masked-vector-body-has-varying-with-locals?
        ctx
        function-state
        mode
        env
        type-env
        form
        (lower-global-shared-view index)
        lane-locals
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      (lower-masked-vector-expr-list-has-varying-with-locals-at?
        ctx
        function-state
        mode
        env
        type-env
        form
        index
        lane-locals
        exprs
        (+ expr-index 1)))))

(define (lower-masked-vector-let-bindings-have-varying-with-locals-at?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [form : LowerMaskedVaryingForm]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding name _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [init-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              function-state
              mode
              env
              type-env
              (lower-global-shared-view index)
              lane-locals
              (lower-global-shared-view init))]
          [init-has-varying : bool
            (lower-masked-vector-body-has-varying-with-locals?
              ctx
              function-state
              mode
              env
              type-env
              form
              (lower-global-shared-view index)
              lane-locals
              init)]
          [next-locals : lower_i64_i64_map.Map
            (lower-masked-vector-lane-locals-bind-if-varying
              lane-locals
              name
              init-lanes)]
          (or
            init-has-varying
            (lower-masked-vector-let-bindings-have-varying-with-locals-at?
              ctx
              function-state
              mode
              env
              type-env
              form
              index
              next-locals
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-match-arms-have-varying-with-locals-at?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [form : LowerMaskedVaryingForm]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [scrut-lanes : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [arm-index : i64]) : bool
  (if (>= arm-index arms.len)
    false
    (match (ast.ast-match-arm-list-get
      arms
      arm-index
      (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (or
          (let
            [index-arg (lower-global-shared-view index)]
            [lane-locals-arg
              (lower-masked-vector-pattern-locals
                pattern
                scrut-lanes
                (lower-global-shared-view lane-locals))]
            (lower-masked-vector-body-has-varying-with-locals?
              ctx
              function-state
              mode
              env
              type-env
              form
              index-arg
              lane-locals-arg
              (lower-context-expr-get ctx body-box)))
          (lower-masked-vector-match-arms-have-varying-with-locals-at?
            ctx
            function-state
            mode
            env
            type-env
            form
            index
            lane-locals
            scrut-lanes
            arms
            (+ arm-index 1)))])))

(define (lower-masked-vector-body-has-varying?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [form : LowerMaskedVaryingForm]
  [index : String]
  [expr : ast.AstExpr]) : bool
  (let
    [lane-locals (lower-masked-vector-empty-lane-locals)]
    (lower-masked-vector-body-has-varying-with-locals?
      ctx
      function-state
      mode
      env
      type-env
      form
      index
      lane-locals
      expr)))

(define (lower-spmd-enum-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region ty)
    [(Enum _) true]
    [(EnumArgs _ _) true]
    [_ false]))

(define (lower-masked-vector-array-ref-varying-enum?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [arr : ast.AstExpr]
  [idx : ast.AstExpr]) : bool
  (and
    (>= (lower-masked-vector-index-offset ctx index idx) 0)
    (match (lower-contiguous-sequence-var ctx env type-env arr)
      [(Some _ elem-ty) (lower-spmd-enum-type? elem-ty)]
      [(No) false])))

(define (lower-masked-vector-expr-varying-enum-with-locals?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : (& enum-locals LowerIdSet)]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(Spanned inner-box _)
      (lower-masked-vector-expr-varying-enum-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-masked-vector-expr-varying-enum-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(Cast inner-box _)
      (lower-masked-vector-expr-varying-enum-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx inner-box))]
    [(Var name) (lower-id-set-contains? enum-locals name)]
    [(ArrayRef arr-box idx-box)
      (lower-masked-vector-array-ref-varying-enum?
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx arr-box)
        (lower-context-expr-get ctx idx-box))]
    [_ false]))

(define (lower-masked-vector-enum-let-locals
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : LowerIdSet]
  [bindings : ast.AstLetBindingList]) : LowerIdSet
  (lower-masked-vector-enum-let-locals-at
    ctx
    env
    type-env
    index
    enum-locals
    (& bindings)
    0))

(define (lower-masked-vector-enum-let-locals-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : LowerIdSet]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : LowerIdSet
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    enum-locals
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding name _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [next-locals : LowerIdSet
            (if (lower-masked-vector-expr-varying-enum-with-locals?
              ctx
              env
              type-env
              index
              enum-locals
              init)
              (lower-id-set-insert enum-locals name)
              enum-locals)]
          (lower-masked-vector-enum-let-locals-at
            ctx
            env
            type-env
            index
            next-locals
            bindings
            (+ binding-index 1)))])))

(define (lower-masked-vector-body-has-varying-enum-match-with-locals?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : (& enum-locals LowerIdSet)]
  [expr : ast.AstExpr]) : bool
  (let
    [enum-locals : LowerIdSet
      (owned_view.compiler-owned-reference-shared-view enum-locals)]
    (match expr
      [(Spanned inner-box _)
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx inner-box))]
      [(Ann inner-box _)
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx inner-box))]
      [(Cast inner-box _)
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx inner-box))]
      [(Unary _ inner-box)
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          (lower-context-expr-get ctx inner-box))]
      [(Binary _ left-box right-box)
        (or
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx left-box))
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx right-box)))]
      [(Let let-box)
        (match (__tl-box-place let-box)
          [(Let bindings body-box)
            (or
              (lower-masked-vector-let-bindings-have-varying-enum-match-with-locals?
                ctx
                env
                type-env
                index
                (lower-global-shared-view enum-locals)
                bindings)
              (let
                [enum-locals-arg
                  (lower-masked-vector-enum-let-locals
                    ctx
                    env
                    type-env
                    index
                    enum-locals
                    bindings)]
                (lower-masked-vector-body-has-varying-enum-match-with-locals?
                  ctx
                  env
                  type-env
                  index
                  enum-locals-arg
                  (lower-context-expr-get ctx body-box))))])]
      [(If cond-box then-box else-box)
        (or
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx cond-box))
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx then-box))
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx else-box)))]
      [(Match match-box)
        (match (__tl-box-place match-box)
          [(Match scrutinee-box arms)
            (let
              [scrutinee : ast.AstExpr
                (lower-context-expr-get ctx scrutinee-box)]
              (or
                (lower-masked-vector-expr-varying-enum-with-locals?
                  ctx
                  env
                  type-env
                  index
                  enum-locals
                  (lower-global-shared-view scrutinee))
                (lower-masked-vector-body-has-varying-enum-match-with-locals?
                  ctx
                  env
                  type-env
                  index
                  enum-locals
                  scrutinee)
                (lower-masked-vector-match-arms-have-varying-enum-match-with-locals?
                  ctx
                  env
                  type-env
                  index
                  enum-locals
                  arms)))])]
      [(Begin exprs)
        (lower-masked-vector-expr-list-has-varying-enum-match-with-locals?
          ctx
          env
          type-env
          index
          enum-locals
          exprs)]
      [(ArrayRef arr-box idx-box)
        (or
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx arr-box))
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx idx-box)))]
      [(ArraySet arr-box idx-box value-box)
        (or
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx arr-box))
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx idx-box))
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx value-box)))]
      [(StructSet receiver-box _ value-box)
        (or
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx receiver-box))
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx value-box)))]
      [_ false])))

(define (lower-masked-vector-expr-list-has-varying-enum-match-with-locals?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : LowerIdSet]
  [exprs : ast.AstExprList]) : bool
  (lower-masked-vector-expr-list-has-varying-enum-match-with-locals-at?
    ctx
    env
    type-env
    index
    enum-locals
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-has-varying-enum-match-with-locals-at?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : LowerIdSet]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : bool
  (if (>= expr-index exprs.len)
    false
    (or
      (lower-masked-vector-body-has-varying-enum-match-with-locals?
        ctx
        env
        type-env
        index
        enum-locals
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      (lower-masked-vector-expr-list-has-varying-enum-match-with-locals-at?
        ctx
        env
        type-env
        index
        enum-locals
        exprs
        (+ expr-index 1)))))

(define (lower-masked-vector-let-bindings-have-varying-enum-match-with-locals?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : LowerIdSet]
  [bindings : (& bindings ast.AstLetBindingList)]) : bool
  (lower-masked-vector-let-bindings-have-varying-enum-match-with-locals-at?
    ctx
    env
    type-env
    index
    enum-locals
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-have-varying-enum-match-with-locals-at?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : LowerIdSet]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding name _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [next-locals : LowerIdSet
            (if (lower-masked-vector-expr-varying-enum-with-locals?
              ctx
              env
              type-env
              index
              enum-locals
              (lower-global-shared-view init))
              (lower-id-set-insert (lower-global-shared-view enum-locals) name)
              (owned_view.compiler-owned-shared-view enum-locals))]
          (or
            (lower-masked-vector-body-has-varying-enum-match-with-locals?
              ctx
              env
              type-env
              index
              enum-locals
              init)
            (lower-masked-vector-let-bindings-have-varying-enum-match-with-locals-at?
              ctx
              env
              type-env
              index
              next-locals
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-match-arms-have-varying-enum-match-with-locals?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : LowerIdSet]
  [arms : ast.AstMatchArmList]) : bool
  (lower-masked-vector-match-arms-have-varying-enum-match-with-locals-at?
    ctx
    env
    type-env
    index
    enum-locals
    (& arms)
    0))

(define (lower-masked-vector-match-arms-have-varying-enum-match-with-locals-at?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [enum-locals : LowerIdSet]
  [arms : (& arms ast.AstMatchArmList)]
  [arm-index : i64]) : bool
  (if (>= arm-index arms.len)
    false
    (match (ast.ast-match-arm-list-get
      arms
      arm-index
      (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (or
          (lower-masked-vector-body-has-varying-enum-match-with-locals?
            ctx
            env
            type-env
            index
            enum-locals
            (lower-context-expr-get ctx body-box))
          (lower-masked-vector-match-arms-have-varying-enum-match-with-locals-at?
            ctx
