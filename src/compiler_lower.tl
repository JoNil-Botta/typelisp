  [index : String]
  [enum-locals : LowerStringSet]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (or
        (lower-masked-vector-body-has-varying-enum-match-with-locals?
          env
          type-env
          index
          enum-locals
          (ast-node-get expr))
        (lower-masked-vector-expr-list-has-varying-enum-match-with-locals?
          env
          type-env
          index
          enum-locals
          (box-get rest)))]))

(define (lower-masked-vector-let-bindings-have-varying-enum-match-with-locals?
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [enum-locals : LowerStringSet]
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (match binding
        [(AstLetBinding.Binding name _ init-box)
          (let
            [init : AstExpr (ast-node-get init-box)]
            [next-locals : LowerStringSet
              (if (lower-masked-vector-expr-varying-enum-with-locals?
                env
                type-env
                index
                enum-locals
                init)
                (lower-string-set-insert enum-locals (intern-str name))
                enum-locals)]
            (or
              (lower-masked-vector-body-has-varying-enum-match-with-locals?
                env
                type-env
                index
                enum-locals
                init)
              (lower-masked-vector-let-bindings-have-varying-enum-match-with-locals?
                env
                type-env
                index
                next-locals
                (box-get rest))))])]))

(define (lower-masked-vector-match-arms-have-varying-enum-match-with-locals?
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [enum-locals : LowerStringSet]
  [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmList.Nil) false]
    [(AstMatchArmList.Cons arm rest)
      (match arm
        [(AstMatchArm.Arm _ body-box)
          (or
            (lower-masked-vector-body-has-varying-enum-match-with-locals?
              env
              type-env
              index
              enum-locals
              (ast-node-get body-box))
            (lower-masked-vector-match-arms-have-varying-enum-match-with-locals?
              env
              type-env
              index
              enum-locals
              (box-get rest)))])]))

(define (lower-masked-vector-body-has-varying-enum-match?
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : bool
  (lower-masked-vector-body-has-varying-enum-match-with-locals?
    env
    type-env
    index
    LowerStringNil
    expr))

(define (lower-masked-vector-bool-array-lane?
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [arr : AstExpr]
  [idx : AstExpr]) : bool
  (if (>= (lower-masked-vector-index-offset index idx) 0)
    (match (lower-dynamic-array-var env type-env arr)
      [(LowerSomeArrayVar _ elem-ty) (lower-type-bool? elem-ty)]
      [LowerNoArrayVar false])
    false))

(define (lower-masked-vector-body-has-bool-array-lane?
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-body-has-bool-array-lane? env type-env index inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-body-has-bool-array-lane? env type-env index inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-body-has-bool-array-lane? env type-env index inner))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-body-has-bool-array-lane? env type-env index inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            env
            type-env
            index
            left)
          (lower-masked-vector-body-has-bool-array-lane?
            env
            type-env
            index
            right)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (lower-masked-vector-let-bindings-have-bool-array-lane?
                env
                type-env
                index
                bindings)
              (lower-masked-vector-body-has-bool-array-lane?
                env
                type-env
                index
                body)))])]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            env
            type-env
            index
            cond)
          (lower-masked-vector-body-has-bool-array-lane?
            env
            type-env
            index
            then-branch)
          (lower-masked-vector-body-has-bool-array-lane?
            env
            type-env
            index
            else-branch)))]
    [(AstExpr.While cond-box body-box)
      (or
        (lower-masked-vector-body-has-bool-array-lane?
          env
          type-env
          index
          (ast-node-get cond-box))
        (lower-masked-vector-body-has-bool-array-lane?
          env
          type-env
          index
          (ast-node-get body-box)))]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-bool-array-lane?
        env
        type-env
        index
        exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        (lower-masked-vector-bool-array-lane? env type-env index arr idx))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-masked-vector-bool-array-lane? env type-env index arr idx)
          (lower-masked-vector-body-has-bool-array-lane?
            env
            type-env
            index
            value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            env
            type-env
            index
            receiver)
          (lower-masked-vector-body-has-bool-array-lane?
            env
            type-env
            index
            value)))]
    [_ false]))

(define (lower-masked-vector-expr-list-has-bool-array-lane?
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            env
            type-env
            index
            expr)
          (lower-masked-vector-expr-list-has-bool-array-lane?
            env
            type-env
            index
            rest)))]))

(define (lower-masked-vector-let-bindings-have-bool-array-lane?
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (or
                (lower-masked-vector-body-has-bool-array-lane?
                  env
                  type-env
                  index
                  init)
                (lower-masked-vector-let-bindings-have-bool-array-lane?
                  env
                  type-env
                  index
                  rest)))]))]))

(define (lower-masked-vector-map
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [body : AstExpr]) : LowerMaybeMaskedVectorMap
  (if (and
    (lower-mode-avx512? mode)
    (or
      (lower-masked-vector-body-has-varying-if? mode env type-env index body)
      (lower-masked-vector-body-has-varying-while? mode env type-env index body)
      (lower-masked-vector-body-has-varying-match? mode env type-env index body)
      (lower-masked-vector-body-has-bool-array-lane? env type-env index body)))
    (let
      [lanes : i64
        (lower-masked-vector-expr-lanes mode env type-env index body)]
      (if (> lanes 0)
        (LowerSomeMaskedVectorMap lanes)
        LowerNoMaskedVectorMap))
    LowerNoMaskedVectorMap))

(define (lower-masked-vector-array-vars
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : LowerArrayVarSet
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-array-vars env type-env index inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-array-vars env type-env index inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-array-vars env type-env index inner))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-masked-vector-array-vars env type-env index inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars env type-env index left)
          (lower-masked-vector-array-vars env type-env index right)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (lower-array-var-set-merge
              (lower-masked-vector-let-binding-array-vars
                env
                type-env
                index
                bindings)
              (lower-masked-vector-array-vars env type-env index body)))])]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars env type-env index cond)
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars env type-env index then-branch)
            (lower-masked-vector-array-vars env type-env index else-branch))))]
    [(AstExpr.While cond-box body-box)
      (lower-array-var-set-merge
        (lower-masked-vector-array-vars
          env
          type-env
          index
          (ast-node-get cond-box))
        (lower-masked-vector-array-vars
          env
          type-env
          index
          (ast-node-get body-box)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars
              env
              type-env
              index
              (ast-node-get scrutinee-box))
            (lower-masked-vector-match-arms-array-vars env type-env index arms))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-array-vars env type-env index exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        [idx-offset : i64 (lower-masked-vector-index-offset index idx)]
        (if (>= idx-offset 0)
          (match (lower-dynamic-array-var env type-env arr)
            [(LowerSomeArrayVar var _)
              (lower-array-var-set-add
                (lower-array-var-set-empty)
                var
                idx-offset)]
            [LowerNoArrayVar (lower-array-var-set-empty)])
          (lower-array-var-set-empty)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        [value : AstExpr (ast-node-get value-box)]
        [idx-offset : i64 (lower-masked-vector-index-offset index idx)]
        (lower-array-var-set-merge
          (if (>= idx-offset 0)
            (match (lower-dynamic-array-var env type-env arr)
              [(LowerSomeArrayVar var _)
                (lower-array-var-set-add
                  (lower-array-var-set-empty)
                  var
                  idx-offset)]
              [LowerNoArrayVar (lower-array-var-set-empty)])
            (lower-array-var-set-empty))
          (lower-masked-vector-array-vars env type-env index value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars env type-env index receiver)
          (lower-masked-vector-array-vars env type-env index value)))]
    [_ (lower-array-var-set-empty)]))

(define (lower-masked-vector-expr-list-array-vars
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : AstExprList]) : LowerArrayVarSet
  (match exprs
    [(AstExprList.Nil) (lower-array-var-set-empty)]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars env type-env index expr)
          (lower-masked-vector-expr-list-array-vars env type-env index rest)))]))

(define (lower-masked-vector-match-arms-array-vars
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [arms : AstMatchArmList]) : LowerArrayVarSet
  (match arms
    [(AstMatchArmList.Nil) (lower-array-var-set-empty)]
    [(AstMatchArmList.Cons arm rest)
      (match arm
        [(AstMatchArm.Arm _ body-box)
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars
              env
              type-env
              index
              (ast-node-get body-box))
            (lower-masked-vector-match-arms-array-vars
              env
              type-env
              index
              (box-get rest)))])]))

(define (lower-masked-vector-let-binding-array-vars
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [bindings : AstLetBindingList]) : LowerArrayVarSet
  (match bindings
    [(AstLetBindingList.Nil) (lower-array-var-set-empty)]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (lower-array-var-set-merge
                (lower-masked-vector-array-vars env type-env index init)
                (lower-masked-vector-let-binding-array-vars
                  env
                  type-env
                  index
                  rest)))]))]))

(define (lower-masked-vector-let-binding-names
  [bindings : AstLetBindingList]
  [lane-locals : LowerStringSet]) : LowerStringSet
  (match bindings
    [(AstLetBindingList.Nil) lane-locals]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name _ _)
            (lower-masked-vector-let-binding-names
              rest
              (lower-string-set-insert lane-locals (intern-str name)))]))]))

(define (lower-vector-body-has-array-read? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-array-read? inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-array-read? inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-array-read? inner))]
    [(AstExpr.ArrayRef _ _) true]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-array-read? inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or
          (lower-vector-body-has-array-read? left)
          (lower-vector-body-has-array-read? right)))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (or
          (lower-vector-body-has-array-read? cond)
          (lower-vector-body-has-array-read? then-branch)
          (lower-vector-body-has-array-read? else-branch)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (or
            (lower-vector-body-has-array-read? (ast-node-get scrutinee-box))
            (lower-match-arms-have-array-read? arms))])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (lower-vector-let-bindings-have-array-read? bindings)
              (lower-vector-body-has-array-read? body)))])]
    [(AstExpr.Begin exprs) (lower-vector-expr-list-has-array-read? exprs)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (lower-vector-body-has-array-read? func)
          (lower-vector-expr-list-has-array-read? args)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-vector-body-has-array-read? arr)
          (lower-vector-body-has-array-read? idx)
          (lower-vector-body-has-array-read? value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-vector-body-has-array-read? receiver)
          (lower-vector-body-has-array-read? value)))]
    [_ false]))

(define (lower-match-arms-have-array-read? [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmList.Nil) false]
    [(AstMatchArmList.Cons arm rest)
      (match arm
        [(AstMatchArm.Arm _ body-box)
          (or
            (lower-vector-body-has-array-read? (ast-node-get body-box))
            (lower-match-arms-have-array-read? (box-get rest)))])]))

(define (lower-vector-expr-list-has-array-read? [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (let
        [inner : AstExpr (ast-node-get expr)]
        [next : AstExprList (box-get rest)]
        (or
          (lower-vector-body-has-array-read? inner)
          (lower-vector-expr-list-has-array-read? next)))]))

(define (lower-vector-let-bindings-have-array-read?
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (let
        [next : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (or
                (lower-vector-body-has-array-read? init)
                (lower-vector-let-bindings-have-array-read? next)))]))]))

(define (lower-vector-body-has-spmd-shuffle? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-spmd-shuffle? inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-spmd-shuffle? inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-spmd-shuffle? inner))]
    [(AstExpr.SpmdShuffle _ _) true]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? value)
          (lower-vector-body-has-spmd-shuffle? lane)))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? arr)
          (lower-vector-body-has-spmd-shuffle? idx)))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-spmd-shuffle? inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? left)
          (lower-vector-body-has-spmd-shuffle? right)))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? cond)
          (lower-vector-body-has-spmd-shuffle? then-branch)
          (lower-vector-body-has-spmd-shuffle? else-branch)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (lower-vector-let-bindings-have-spmd-shuffle? bindings)
              (lower-vector-body-has-spmd-shuffle? body)))])]
    [(AstExpr.Begin exprs) (lower-vector-expr-list-has-spmd-shuffle? exprs)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? func)
          (lower-vector-expr-list-has-spmd-shuffle? args)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? arr)
          (lower-vector-body-has-spmd-shuffle? idx)
          (lower-vector-body-has-spmd-shuffle? value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? receiver)
          (lower-vector-body-has-spmd-shuffle? value)))]
    [_ false]))

(define (lower-vector-expr-list-has-spmd-shuffle? [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (let
        [inner : AstExpr (ast-node-get expr)]
        [next : AstExprList (box-get rest)]
        (or
          (lower-vector-body-has-spmd-shuffle? inner)
          (lower-vector-expr-list-has-spmd-shuffle? next)))]))

(define (lower-vector-let-bindings-have-spmd-shuffle?
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (let
        [next : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (or
                (lower-vector-body-has-spmd-shuffle? init)
                (lower-vector-let-bindings-have-spmd-shuffle? next)))]))]))

(define (lower-vector-body-has-atomic-call?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-atomic-call? ctx type-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-atomic-call? ctx type-env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-atomic-call? ctx type-env inner))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-vector-body-has-atomic-call? ctx type-env inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx type-env left)
          (lower-vector-body-has-atomic-call? ctx type-env right)))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx type-env cond)
          (lower-vector-body-has-atomic-call? ctx type-env then-branch)
          (lower-vector-body-has-atomic-call? ctx type-env else-branch)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (lower-vector-let-bindings-have-atomic-call?
                ctx
                type-env
                bindings)
              (lower-vector-body-has-atomic-call? ctx type-env body)))])]
    [(AstExpr.Begin exprs)
      (lower-vector-expr-list-has-atomic-call? ctx type-env exprs)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (>
            (string.string-length
              (lower-atomic-extern-symbol-for-func ctx type-env func))
            0)
          (lower-atomic-pointer-func? type-env func)
          (lower-vector-body-has-atomic-call? ctx type-env func)
          (lower-vector-expr-list-has-atomic-call? ctx type-env args)))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx type-env arr)
          (lower-vector-body-has-atomic-call? ctx type-env idx)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx type-env arr)
          (lower-vector-body-has-atomic-call? ctx type-env idx)
          (lower-vector-body-has-atomic-call? ctx type-env value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx type-env receiver)
          (lower-vector-body-has-atomic-call? ctx type-env value)))]
    [_ false]))

(define (lower-vector-expr-list-has-atomic-call?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (let
        [inner : AstExpr (ast-node-get expr)]
        [next : AstExprList (box-get rest)]
        (or
          (lower-vector-body-has-atomic-call? ctx type-env inner)
          (lower-vector-expr-list-has-atomic-call? ctx type-env next)))]))

(define (lower-vector-let-bindings-have-atomic-call?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (let
        [next : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (or
                (lower-vector-body-has-atomic-call? ctx type-env init)
                (lower-vector-let-bindings-have-atomic-call? ctx type-env next)))]))]))

(define (lower-simple-vector-map-binop-supported?
  [mode : CompilerLowerMode]
  [elem-ty : AstType]
  [op : AstBinOp]) : bool
  (match op
    [(AstBinOp.Add) true]
    [(AstBinOp.Mul)
      (and
        (> (lower-simd-lanes-for-elem mode elem-ty) 0)
        (not (lower-spmd-byte-lane-type? elem-ty)))]
    [_ false]))

(define (lower-spmd-byte-lane-type? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.I8) true]
    [(AstType.U8) true]
    [_ false]))

(define (lower-spmd-byte-mul-diagnostic) : String
  "lower: SPMD foreach SIMD lowering does not support 8-bit lane multiplication; use scalar or widen before multiplying")

(define (lower-spmd-expr-has-mul? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-spmd-expr-has-mul? inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-spmd-expr-has-mul? inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-spmd-expr-has-mul? inner))]
    [(AstExpr.Binary op lhs-box rhs-box)
      (match op
        [(AstBinOp.Mul) true]
        [_
          (or
            (lower-spmd-expr-has-mul? (ast-node-get lhs-box))
            (lower-spmd-expr-has-mul? (ast-node-get rhs-box)))])]
    [(AstExpr.ArraySet arr-box index-box value-box)
      (or
        (lower-spmd-expr-has-mul? (ast-node-get arr-box))
        (lower-spmd-expr-has-mul? (ast-node-get index-box))
        (lower-spmd-expr-has-mul? (ast-node-get value-box)))]
    [(AstExpr.Begin exprs) (lower-spmd-expr-list-has-mul? exprs)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-spmd-let-bindings-have-mul? bindings)
            (lower-spmd-expr-has-mul? (ast-node-get body-box)))])]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-spmd-expr-has-mul? (ast-node-get cond-box))
        (lower-spmd-expr-has-mul? (ast-node-get then-box))
        (lower-spmd-expr-has-mul? (ast-node-get else-box)))]
    [_ false]))

(define (lower-spmd-expr-list-has-mul? [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (or
        (lower-spmd-expr-has-mul? (ast-node-get expr))
        (lower-spmd-expr-list-has-mul? (box-get rest)))]))

(define (lower-spmd-let-bindings-have-mul? [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (match binding
        [(AstLetBinding.Binding _ _ init-box)
          (or
            (lower-spmd-expr-has-mul? (ast-node-get init-box))
            (lower-spmd-let-bindings-have-mul? (box-get rest)))])]))

(define (lower-simple-vector-map-has-unsupported-byte-mul?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [body : AstExpr]) : bool
  (match body
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-simple-vector-map-has-unsupported-byte-mul?
          mode
          env
          type-env
          index
          inner))]
    [(AstExpr.ArraySet arr-box set-index-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [set-index : AstExpr (ast-node-get set-index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (if (lower-expr-is-var? set-index index)
          (match (lower-dynamic-array-var env type-env arr)
            [(LowerSomeArrayVar _ dst-elem)
              (and
                (> (lower-simd-lanes-for-elem mode dst-elem) 0)
                (lower-spmd-byte-lane-type? dst-elem)
                (lower-spmd-expr-has-mul? value))]
            [LowerNoArrayVar false])
          false))]
    [_ false]))

(define (lower-simple-vector-map-casted-literal
  [mode : CompilerLowerMode]
  [target-ty : AstType]
  [dst-elem : AstType]
  [value : AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-simple-vector-map-casted-literal mode target-ty dst-elem inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-simple-vector-map-casted-literal mode target-ty dst-elem inner))]
    [(AstExpr.Literal lit)
      (if (and
        (> (lower-simd-lanes-for-elem mode target-ty) 0)
        (tc-type-eq target-ty dst-elem))
        (LowerSomeVectorMapValue
          (LowerVectorMapUniform (lower-literal-value-with-type lit target-ty)))
        LowerNoVectorMapValue)]
    [_ LowerNoVectorMapValue]))

(define (lower-simple-vector-map-value
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [dst-elem : AstType]
  [value : AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-simple-vector-map-value mode env type-env index dst-elem inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-simple-vector-map-value mode env type-env index dst-elem inner))]
    [(AstExpr.Cast inner-box cast-ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [target-ty : AstType (tc-type-without-regions cast-ty)]
        (match (lower-simple-vector-map-casted-literal
          mode
          target-ty
          dst-elem
          inner)
          [(LowerSomeVectorMapValue plan) (LowerSomeVectorMapValue plan)]
          [LowerNoVectorMapValue
            (lower-simple-vector-map-value
              mode
              env
              type-env
              index
              dst-elem
              inner)]))]
    [(AstExpr.ArrayRef _ _)
      (match (lower-array-ref-var-for-index env type-env value index)
        [(LowerSomeArrayVar array-var array-elem)
          (if (tc-type-eq array-elem dst-elem)
            (LowerSomeVectorMapValue (LowerVectorMapArray array-var))
            LowerNoVectorMapValue)]
        [LowerNoArrayVar LowerNoVectorMapValue])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [source : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (lower-simple-spmd-broadcast-lane env type-env lane)
          [(LowerSomeIrValue lane-value)
            (match (lower-array-ref-var-for-index env type-env source index)
              [(LowerSomeArrayVar array-var array-elem)
                (if (tc-type-eq array-elem dst-elem)
                  (LowerSomeVectorMapValue
                    (LowerVectorMapBroadcastArray array-var lane-value))
                  LowerNoVectorMapValue)]
              [LowerNoArrayVar
                (lower-simple-vector-map-value
                  mode
                  env
                  type-env
                  index
                  dst-elem
                  source)])]
          [LowerNoIrValue LowerNoVectorMapValue]))]
    [(AstExpr.SpmdProgramIndex)
      (if (and
        (> (lower-simd-lanes-for-elem mode dst-elem) 0)
        (tc-type-eq dst-elem (AstType.I64)))
        (LowerSomeVectorMapValue (LowerVectorMapLaneIndex))
        LowerNoVectorMapValue)]
    [(AstExpr.SpmdProgramCount)
      (if (and
        (> (lower-simd-lanes-for-elem mode dst-elem) 0)
        (tc-type-eq dst-elem (AstType.I64)))
        (LowerSomeVectorMapValue (LowerVectorMapLaneCount))
        LowerNoVectorMapValue)]
    [(AstExpr.Var name)
      (let
        [lookup-name : String (intern-str name)]
        (if (string.eq lookup-name index)
          LowerNoVectorMapValue
          (let
            [var-id : i64
              (sym_i64_env.sym-i64-lookup-id-or
                env
                name
                (compiler-symbols-missing-handle))]
            (if (compiler-symbols-handle-found? var-id)
              (match (tc-lookup type-env lookup-name)
                [(ResultTcType.Ok ty)
                  (let
                    [scalar-ty : AstType (tc-type-without-regions ty)]
                    (if (and
                      (> (lower-simd-lanes-for-elem mode scalar-ty) 0)
                      (tc-type-eq scalar-ty dst-elem))
                      (LowerSomeVectorMapValue
                        (LowerVectorMapUniform (CompilerIrValue.Var var-id)))
                      LowerNoVectorMapValue))]
                [(ResultTcType.Err _) LowerNoVectorMapValue])
              LowerNoVectorMapValue))))]
    [(AstExpr.Literal lit)
      (let
        [lit-ty : AstType (tc-literal-type lit)]
        (match lit
          [(AstLiteral.Int _ _)
            (if (and
              (> (lower-simd-lanes-for-elem mode dst-elem) 0)
              (tc-integer-type? dst-elem))
              (LowerSomeVectorMapValue
                (LowerVectorMapUniform
                  (lower-literal-value-with-type lit dst-elem)))
              LowerNoVectorMapValue)]
          [_
            (if (and
              (> (lower-simd-lanes-for-elem mode lit-ty) 0)
              (tc-type-eq lit-ty dst-elem))
              (LowerSomeVectorMapValue
                (LowerVectorMapUniform
                  (lower-literal-value-with-type lit dst-elem)))
              LowerNoVectorMapValue)]))]
    [(AstExpr.Binary op lhs-box rhs-box)
      (if (lower-simple-vector-map-binop-supported? mode dst-elem op)
        (let
          [lhs : AstExpr (ast-node-get lhs-box)]
          [rhs : AstExpr (ast-node-get rhs-box)]
          (match (lower-simple-vector-map-value
            mode
            env
            type-env
            index
            dst-elem
            lhs)
            [(LowerSomeVectorMapValue lhs-plan)
              (match (lower-simple-vector-map-value
                mode
                env
                type-env
                index
                dst-elem
                rhs)
                [(LowerSomeVectorMapValue rhs-plan)
                  (LowerSomeVectorMapValue
                    (LowerVectorMapBinOp
                      (lower-binop op)
                      (box lhs-plan)
                      (box rhs-plan)))]
                [LowerNoVectorMapValue LowerNoVectorMapValue])]
            [LowerNoVectorMapValue LowerNoVectorMapValue]))
        LowerNoVectorMapValue)]
    [_ LowerNoVectorMapValue]))

(define (lower-vector-map-value-array-vars [plan : LowerVectorMapValue]) : LowerArrayVarSet
  (match plan
    [(LowerVectorMapArray array-var)
      (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
    [(LowerVectorMapUniform _) (lower-array-var-set-empty)]
    [(LowerVectorMapBroadcastArray array-var _)
      (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
    [(LowerVectorMapLaneIndex) (lower-array-var-set-empty)]
    [(LowerVectorMapLaneCount) (lower-array-var-set-empty)]
    [(LowerVectorMapBinOp _ lhs rhs)
      (lower-array-var-set-merge
        (lower-vector-map-value-array-vars (box-get lhs))
        (lower-vector-map-value-array-vars (box-get rhs)))]))

(define (lower-simple-vector-map
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [body : AstExpr]) : LowerMaybeVectorMap
  (match body
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-simple-vector-map mode env type-env index inner))]
    [(AstExpr.ArraySet arr-box set-index-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [set-index : AstExpr (ast-node-get set-index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (if (lower-expr-is-var? set-index index)
          (match (lower-dynamic-array-var env type-env arr)
            [(LowerSomeArrayVar dst-var dst-elem)
              (let
                [lanes : i64 (lower-simd-lanes-for-elem mode dst-elem)]
                (if (> lanes 0)
                  (match (lower-simple-vector-map-value
                    mode
                    env
                    type-env
                    index
                    dst-elem
                    value)
                    [(LowerSomeVectorMapValue plan)
                      (LowerSomeVectorMap dst-var plan dst-elem lanes)]
                    [LowerNoVectorMapValue LowerNoVectorMap])
                  LowerNoVectorMap))]
            [LowerNoArrayVar LowerNoVectorMap])
          LowerNoVectorMap))]
    [_ LowerNoVectorMap]))

(define (lower-simple-vector-reduce-op-supported?
  [mode : CompilerLowerMode]
  [op : AstReduceOp]
  [elem : AstType]) : bool
  (match op
    [(AstReduceOp.Sum)
      (match elem
        [(AstType.I64) true]
        [(AstType.I32) true]
        [(AstType.F64) true]
        [_ false])]
    [(AstReduceOp.Min)
      (match elem
        [(AstType.I32) true]
        [(AstType.I64) (lower-mode-avx512? mode)]
        [_ false])]
    [(AstReduceOp.Max)
      (match elem
        [(AstType.I32) true]
        [(AstType.I64) (lower-mode-avx512? mode)]
        [_ false])]
    [_ false]))

(define (lower-simple-vector-reduce-op [op : AstReduceOp]) : CompilerIrVectorReduceOp
  (match op
    [(AstReduceOp.Min) (CompilerIrVectorReduceOp.Min)]
    [(AstReduceOp.Max) (CompilerIrVectorReduceOp.Max)]
    [_ (CompilerIrVectorReduceOp.Sum)]))

(define (lower-simple-vector-reduce
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index : String]
  [value-ty : AstType]
  [value : AstExpr]) : LowerMaybeVectorReduce
  (if (lower-mode-simd? mode)
    (match value
      [(AstExpr.Spanned inner-box _)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (lower-simple-vector-reduce mode env type-env op index value-ty inner))]
      [(AstExpr.Ann inner-box _)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (lower-simple-vector-reduce mode env type-env op index value-ty inner))]
      [_
        (match (lower-array-ref-var-for-index env type-env value index)
          [(LowerSomeArrayVar array-var elem-ty)
            (let
              [elem : AstType (tc-type-without-regions elem-ty)]
              [lanes : i64 (lower-simd-lanes-for-elem mode elem)]
              (if (and
                (> lanes 0)
                (lower-simple-vector-reduce-op-supported? mode op elem))
                (LowerSomeVectorReduce
                  array-var
                  (lower-simple-vector-reduce-op op)
                  elem
                  lanes)
                LowerNoVectorReduce))]
          [LowerNoArrayVar
            (let
              [elem : AstType (tc-type-without-regions value-ty)]
              [lanes : i64 (lower-simd-lanes-for-elem mode elem)]
              (if (and
                (> lanes 0)
                (lower-simple-vector-reduce-op-supported? mode op elem))
                (match (lower-simple-vector-map-value
                  mode
                  env
                  type-env
                  index
                  elem
                  value)
                  [(LowerSomeVectorMapValue value-plan)
                    (if (=
                      (struct-get
                        (lower-vector-map-value-array-vars value-plan)
                        count)
                      0)
                      (LowerSomeVectorValueReduce
                        value-plan
                        (lower-simple-vector-reduce-op op)
                        elem
                        lanes)
                      LowerNoVectorReduce)]
                  [LowerNoVectorMapValue LowerNoVectorReduce])
                LowerNoVectorReduce))])])
    LowerNoVectorReduce))

(define (lower-array-len-value
  [state : LowerState]
  [arr-value : CompilerIrValue]) : LowerExpr
  (match (lower-emit-gep state arr-value (CompilerIrValue.I64 1) (AstType.I64))
    [(LowerExpr gep-state len-gep _)
      (lower-emit-load gep-state len-gep (AstType.I64))]))

(define (lower-array-data-pointer-value
  [state : LowerState]
  [arr-value : CompilerIrValue]) : LowerExpr
  ;; Dynamic-array fat header slot 0 is the element data pointer. Emit it as a
  ;; normal load keyed by the array header value so redundant-load CSE can see
  ;; repeated SIMD accesses to the same base.
  (lower-emit-load state arr-value (AstType.U64)))

(define (lower-emit-vector-load
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr data-state data-ptr _)
      (match (lower-state-alloc-var data-state)
        [(LowerAlloc s v)
          (LowerExpr
            (lower-state-emit
              s
              (CompilerIrInstr.VectorLoad v data-ptr index lanes elem-ty))
            (CompilerIrValue.Var v)
            elem-ty)])]))

(define (lower-emit-vector-store
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [value : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerState
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr data-state data-ptr _)
      (lower-state-emit
        data-state
        (ir-instr-vector-store data-ptr index value lanes elem-ty))]))

(define (lower-emit-vector-binop
  [state : LowerState]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (ir-instr-vector-bin-op v op lhs rhs lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-splat
  [state : LowerState]
  [value : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.Splat v value lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-lane-id
  [state : LowerState]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.LaneId v lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-foreach-index-vector
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]) : LowerExpr
  (match (lower-emit-splat
    state
    (CompilerIrValue.Var index-var)
    lanes
    (AstType.I64))
    [(LowerExpr base-state base-value _)
      (match (lower-emit-lane-id base-state lanes (AstType.I64))
        [(LowerExpr lane-state lane-value _)
          (lower-emit-vector-binop
            lane-state
            (CompilerIrBinOp.Add)
            base-value
            lane-value
            lanes
            (AstType.I64))])]))

(define (lower-emit-vector-compare
  [state : LowerState]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit
          s
          (ir-instr-vector-compare v op lhs rhs lanes elem-ty))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-mask-binop
  [state : LowerState]
  [op : CompilerIrMaskBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.MaskBinOp v op lhs rhs lanes))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-mask-not
  [state : LowerState]
  [src : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.MaskNot v src lanes))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-mask-reduce
  [state : LowerState]
  [op : CompilerIrMaskReduceOp]
  [src : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.MaskReduce v op src lanes))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-mask-select
  [state : LowerState]
  [then-mask : CompilerIrValue]
  [then-value : CompilerIrValue]
  [else-mask : CompilerIrValue]
  [else-value : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [then-bits : CompilerIrValue CompilerIrValue.Unit]
    [else-bits : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-emit-mask-binop
        s
        (CompilerIrMaskBinOp.And)
        then-mask
        then-value
        lanes)
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! then-bits value))])
      (match (lower-emit-mask-binop
        s
        (CompilerIrMaskBinOp.And)
        else-mask
        else-value
        lanes)
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! else-bits value))])
      (lower-emit-mask-binop
        s
        (CompilerIrMaskBinOp.Or)
        then-bits
        else-bits
        lanes))))

(define (lower-emit-select
  [state : LowerState]
  [mask : CompilerIrValue]
  [on-true : CompilerIrValue]
  [on-false : CompilerIrValue]
  [lanes : i64]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (ir-instr-select v mask on-true on-false lanes ty))
        (CompilerIrValue.Var v)
        ty)]))

(define (lower-emit-vector-reduce
  [state : LowerState]
  [op : CompilerIrVectorReduceOp]
  [src : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit
          s
          (CompilerIrInstr.VectorReduce v op src lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-spmd-reduce-apply-update
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [acc-var : i64]
  [elem-ty : AstType]
  [value-var : i64]) : ResultLowerExpr
  (let
    [acc-name-id : i64 (lower-spmd-reduce-acc-id)]
    [current-name-id : i64 (lower-spmd-reduce-current-id)]
    (lower-expr
      ctx
      state
      (sym_i64_env.sym-i64-bind-id
        (sym_i64_env.sym-i64-bind-id env acc-name-id acc-var)
        current-name-id
        value-var)
      (tc-bind-id
        (tc-bind-id type-env acc-name-id elem-ty)
        current-name-id
        elem-ty)
      (ast-node-get
        (spmd-reduce-acc-update-expr
          op
          (ast-node-push (AstExpr.Var current-name-id)))))))

(define (lower-avx2-reduce-ok
  [state : LowerState]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [end-value : CompilerIrValue]
  [array-len : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [ok : CompilerIrValue CompilerIrValue.Unit]
    [within : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Ge)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 0)
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 (- 9223372036854775807 lanes))
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        next-index
        end-value
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        next-index
        array-len
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool)))))

(define (lower-avx2-reduce-range-ok
  [state : LowerState]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [end-value : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [ok : CompilerIrValue CompilerIrValue.Unit]
    [within : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 (- 9223372036854775807 lanes))
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        next-index
        end-value
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool)))))

(define (lower-avx2-reduce-vector-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [acc-var : i64]
  [array-var : i64]
  [vector-op : CompilerIrVectorReduceOp]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-vector-load
    state
    (CompilerIrValue.Var array-var)
    (CompilerIrValue.Var index-var)
    lanes
    elem-ty)
    [(LowerExpr load-state chunk-vec _)
      (match (lower-emit-vector-reduce
        load-state
        vector-op
        chunk-vec
        lanes
        elem-ty)
        [(LowerExpr reduce-state reduced _)
          (match reduced
            [(CompilerIrValue.Var reduced-var)
              (match (lower-spmd-reduce-apply-update
                ctx
                reduce-state
                env
                type-env
                op
                acc-var
                elem-ty
                reduced-var)
                [(OkLowerExpr update-lowered)
                  (match update-lowered
                    [(LowerExpr update-state _ _)
                      (OkLowerExpr
                        (LowerExpr
                          (lower-state-emit
                            update-state
                            (CompilerIrInstr.Mov
                              index-var
                              next-index
                              (AstType.I64)))
                          CompilerIrValue.Unit
                          (AstType.Unit)))])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])]
            [_
              (ErrLowerExpr
                (box (lower-diagnostic "lower: invalid vector reduce result")))])])]))

(define (lower-avx2-reduce-vector-value-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [acc-var : i64]
  [value-plan : LowerVectorMapValue]
  [vector-op : CompilerIrVectorReduceOp]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-vector-map-value
    ctx
    state
    index-var
    lanes
    elem-ty
    value-plan)
    [(LowerExpr value-state chunk-vec _)
      (match (lower-emit-vector-reduce
        value-state
        vector-op
        chunk-vec
        lanes
        elem-ty)
        [(LowerExpr reduce-state reduced _)
          (match reduced
            [(CompilerIrValue.Var reduced-var)
              (match (lower-spmd-reduce-apply-update
                ctx
                reduce-state
                env
                type-env
                op
                acc-var
                elem-ty
                reduced-var)
                [(OkLowerExpr update-lowered)
                  (match update-lowered
                    [(LowerExpr update-state _ _)
                      (OkLowerExpr
                        (LowerExpr
                          (lower-state-emit
                            update-state
                            (CompilerIrInstr.Mov
                              index-var
                              next-index
                              (AstType.I64)))
                          CompilerIrValue.Unit
                          (AstType.Unit)))])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])]
            [_
              (ErrLowerExpr
                (box (lower-diagnostic "lower: invalid vector reduce result")))])])]))

(define (lower-spmd-reduce-scalar-tail-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-var : i64]
  [index-ty : AstType]
  [acc-var : i64]
  [array-var : i64]
  [elem-ty : AstType]) : ResultLowerExpr
  (match (lower-array-element-addr
    ctx
    state
    (CompilerIrValue.Var array-var)
    (CompilerIrValue.Var index-var)
    index-ty
    elem-ty)
    [(LowerExpr addr-state elem-ptr _)
      (match (lower-emit-load addr-state elem-ptr elem-ty)
        [(LowerExpr load-state loaded _)
          (match loaded
            [(CompilerIrValue.Var loaded-var)
              (match (lower-spmd-reduce-apply-update
                ctx
                load-state
                env
                type-env
                op
                acc-var
                elem-ty
                loaded-var)
                [(OkLowerExpr update-lowered)
                  (match update-lowered
                    [(LowerExpr update-state _ _)
                      (match (lower-state-alloc-var update-state)
                        [(LowerAlloc inc-alloc inc-var)
                          (OkLowerExpr
                            (LowerExpr
                              (lower-state-emit
                                (lower-state-emit
                                  inc-alloc
                                  (CompilerIrInstr.BinOp
                                    inc-var
                                    CompilerIrBinOp.Add
                                    (CompilerIrValue.Var index-var)
                                    (CompilerIrValue.I64 1)
                                    index-ty))
                                (CompilerIrInstr.Mov
                                  index-var
                                  (CompilerIrValue.Var inc-var)
                                  index-ty))
                              CompilerIrValue.Unit
                              (AstType.Unit)))])])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])]
            [_
              (ErrLowerExpr
                (box (lower-diagnostic "lower: invalid scalar reduce load")))])])]))

(define (lower-spmd-reduce-scalar-tail-value-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [base-index-var : i64]
  [current-index-var : i64]
  [active-lanes : CompilerIrValue]
  [index-ty : AstType]
  [acc-var : i64]
  [value-plan : LowerVectorMapValue]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-scalar-vector-map-value
    ctx
    state
    base-index-var
    current-index-var
    active-lanes
    lanes
    elem-ty
    value-plan)
    [(LowerExpr value-state scalar-value _)
      (let
        [s : LowerState value-state]
        [value-var : i64 0]
        (begin
          (match scalar-value
            [(CompilerIrValue.Var var) (set! value-var var)]
            [_
              (match (lower-state-alloc-var s)
                [(LowerAlloc alloc-state tmp-var)
                  (begin
                    (set!
                      s
                      (lower-state-emit
                        alloc-state
                        (CompilerIrInstr.Mov tmp-var scalar-value elem-ty)))
                    (set! value-var tmp-var))])])
          (match (lower-spmd-reduce-apply-update
            ctx
            s
            env
            type-env
            op
            acc-var
            elem-ty
            value-var)
            [(OkLowerExpr update-lowered)
              (match update-lowered
                [(LowerExpr update-state _ _)
                  (match (lower-state-alloc-var update-state)
                    [(LowerAlloc inc-alloc inc-var)
                      (OkLowerExpr
                        (LowerExpr
                          (lower-state-emit
                            (lower-state-emit
                              inc-alloc
                              (CompilerIrInstr.BinOp
                                inc-var
                                CompilerIrBinOp.Add
                                (CompilerIrValue.Var current-index-var)
                                (CompilerIrValue.I64 1)
                                index-ty))
                            (CompilerIrInstr.Mov
                              current-index-var
                              (CompilerIrValue.Var inc-var)
                              index-ty))
                          CompilerIrValue.Unit
                          (AstType.Unit)))])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])))]))

(define (lower-avx2-spmd-reduce-build
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-ty : AstType]
  [init-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [start-value : CompilerIrValue]
  [op : AstReduceOp]
  [array-var : i64]
  [vector-op : CompilerIrVectorReduceOp]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc acc-alloc acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-alloc
          (CompilerIrInstr.Mov acc-var init-value elem-ty)))
        [(LowerAlloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov index-var start-value index-ty))]
            [header-label : String ""]
            [body-label : String ""]
            [tail-header-label : String ""]
            [tail-body-label : String ""]
            [exit-label : String ""]
            [array-len : CompilerIrValue CompilerIrValue.Unit]
            [next-index : CompilerIrValue CompilerIrValue.Unit]
            [vector-ok : CompilerIrValue CompilerIrValue.Unit]
            [tail-cond : CompilerIrValue CompilerIrValue.Unit]
            (begin
              (match (lower-state-fresh-label s "spmd_reduce_avx2_header")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_avx2_body")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_tail_header")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_tail_body")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_exit")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (match (lower-array-len-value s (CompilerIrValue.Var array-var))
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! array-len value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (CompilerIrInstr.Jump header-label))
                  header-label))
              (match (lower-emit-binop
                s
                (CompilerIrBinOp.Add)
                (CompilerIrValue.Var index-var)
                (CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! next-index value))])
              (match (lower-avx2-reduce-ok
                s
                index-var
                next-index
                end-value
                array-len
                lanes)
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      vector-ok
                      body-label
                      tail-header-label))
                  body-label))
              (match (lower-avx2-reduce-vector-body
                ctx
                s
                env
                type-env
                op
                index-var
                next-index
                acc-var
                array-var
                vector-op
                elem-ty
                lanes)
                [(OkLowerExpr body-lowered)
                  (match body-lowered
                    [(LowerExpr body-state _ _)
                      (begin
                        (set! s body-state)
                        (set!
                          s
                          (lower-state-finish-block
                            (lower-state-emit
                              s
                              (CompilerIrInstr.Jump header-label))
                            tail-header-label))
                        (match (lower-emit-binop
                          s
                          (CompilerIrBinOp.Lt)
                          (CompilerIrValue.Var index-var)
                          end-value
                          (AstType.Bool))
                          [(LowerExpr next-s value _)
                            (begin
                              (set! s next-s)
                              (set! tail-cond value))])
                        (set!
                          s
                          (lower-state-finish-block
                            (lower-state-emit
                              s
                              (CompilerIrInstr.Branch
                                tail-cond
                                tail-body-label
                                exit-label))
                            tail-body-label))
                        (match (lower-spmd-reduce-scalar-tail-body
                          ctx
                          s
                          env
                          type-env
                          op
                          index-var
                          index-ty
                          acc-var
                          array-var
                          elem-ty)
                          [(OkLowerExpr tail-lowered)
                            (match tail-lowered
                              [(LowerExpr tail-state _ _)
                                (OkLowerExpr
                                  (LowerExpr
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        tail-state
                                        (CompilerIrInstr.Jump tail-header-label))
                                      exit-label)
                                    (CompilerIrValue.Var acc-var)
                                    elem-ty))])]
                          [(ErrLowerExpr message) (ErrLowerExpr message)]))])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])))])]))

(define (lower-avx2-spmd-reduce-value-build
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-ty : AstType]
  [init-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [start-value : CompilerIrValue]
  [op : AstReduceOp]
  [value-plan : LowerVectorMapValue]
  [vector-op : CompilerIrVectorReduceOp]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc acc-alloc acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-alloc
          (CompilerIrInstr.Mov acc-var init-value elem-ty)))
        [(LowerAlloc index-alloc index-var)
          (match (lower-state-alloc-var
            (lower-state-emit
              index-alloc
              (CompilerIrInstr.Mov index-var start-value index-ty)))
            [(LowerAlloc base-alloc tail-base-var)
              (let
                [s : LowerState base-alloc]
                [header-label : String ""]
                [body-label : String ""]
                [tail-init-label : String ""]
                [tail-check-label : String ""]
                [tail-body-label : String ""]
                [exit-label : String ""]
                [next-index : CompilerIrValue CompilerIrValue.Unit]
                [vector-ok : CompilerIrValue CompilerIrValue.Unit]
                [active-lanes : CompilerIrValue CompilerIrValue.Unit]
                [tail-cond : CompilerIrValue CompilerIrValue.Unit]
                (begin
                  (match (lower-state-fresh-label s "spmd_reduce_value_header")
                    [(LowerLabel next-s label)
                      (begin
                        (set! s next-s)
                        (set! header-label label))])
                  (match (lower-state-fresh-label s "spmd_reduce_value_body")
                    [(LowerLabel next-s label)
                      (begin
                        (set! s next-s)
                        (set! body-label label))])
                  (match (lower-state-fresh-label
                    s
                    "spmd_reduce_value_tail_init")
                    [(LowerLabel next-s label)
                      (begin
                        (set! s next-s)
                        (set! tail-init-label label))])
                  (match (lower-state-fresh-label
                    s
                    "spmd_reduce_value_tail_check")
                    [(LowerLabel next-s label)
                      (begin
                        (set! s next-s)
                        (set! tail-check-label label))])
                  (match (lower-state-fresh-label
                    s
                    "spmd_reduce_value_tail_body")
                    [(LowerLabel next-s label)
                      (begin
                        (set! s next-s)
                        (set! tail-body-label label))])
                  (match (lower-state-fresh-label s "spmd_reduce_value_exit")
                    [(LowerLabel next-s label)
                      (begin
                        (set! s next-s)
                        (set! exit-label label))])
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit s (CompilerIrInstr.Jump header-label))
                      header-label))
                  (match (lower-emit-binop
                    s
                    (CompilerIrBinOp.Add)
                    (CompilerIrValue.Var index-var)
                    (CompilerIrValue.I64 lanes)
                    index-ty)
                    [(LowerExpr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! next-index value))])
                  (match (lower-avx2-reduce-range-ok
                    s
                    index-var
                    next-index
                    end-value
                    lanes)
                    [(LowerExpr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! vector-ok value))])
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (CompilerIrInstr.Branch
                          vector-ok
                          body-label
                          tail-init-label))
                      body-label))
                  (match (lower-avx2-reduce-vector-value-body
                    ctx
                    s
                    env
                    type-env
                    op
                    index-var
                    next-index
                    acc-var
                    value-plan
                    vector-op
                    elem-ty
                    lanes)
                    [(OkLowerExpr body-lowered)
                      (match body-lowered
                        [(LowerExpr body-state _ _)
                          (begin
                            (set! s body-state)
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (CompilerIrInstr.Jump header-label))
                                tail-init-label))
                            (set!
                              s
                              (lower-state-emit
                                s
                                (CompilerIrInstr.Mov
                                  tail-base-var
                                  (CompilerIrValue.Var index-var)
                                  index-ty)))
                            (match (lower-emit-binop
                              s
                              CompilerIrBinOp.Sub
                              end-value
                              (CompilerIrValue.Var index-var)
                              (AstType.I64))
                              [(LowerExpr next-s value _)
                                (begin
                                  (set! s next-s)
                                  (set! active-lanes value))])
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (CompilerIrInstr.Jump tail-check-label))
                                tail-check-label))
                            (match (lower-emit-binop
                              s
                              (CompilerIrBinOp.Lt)
                              (CompilerIrValue.Var index-var)
                              end-value
                              (AstType.Bool))
                              [(LowerExpr next-s value _)
                                (begin
                                  (set! s next-s)
                                  (set! tail-cond value))])
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (CompilerIrInstr.Branch
                                    tail-cond
                                    tail-body-label
                                    exit-label))
                                tail-body-label))
                            (match (lower-spmd-reduce-scalar-tail-value-body
                              ctx
                              s
                              env
                              type-env
                              op
                              tail-base-var
                              index-var
                              active-lanes
                              index-ty
                              acc-var
                              value-plan
                              elem-ty
                              lanes)
                              [(OkLowerExpr tail-lowered)
                                (match tail-lowered
                                  [(LowerExpr tail-state _ _)
                                    (OkLowerExpr
                                      (LowerExpr
                                        (lower-state-finish-block
                                          (lower-state-emit
                                            tail-state
                                            (CompilerIrInstr.Jump
                                              tail-check-label))
                                          exit-label)
                                        (CompilerIrValue.Var acc-var)
                                        elem-ty))])]
                              [(ErrLowerExpr message) (ErrLowerExpr message)]))])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)])))])])]))

(define (lower-avx2-spmd-reduce-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [init : AstExpr]
  [op : AstReduceOp]
  [plan : LowerMaybeVectorReduce]) : ResultLowerExpr
  (match plan
    [(LowerSomeVectorReduce array-var vector-op elem-ty lanes)
      (match (lower-expr-expected ctx state env type-env init elem-ty init)
        [(OkLowerExpr init-lowered)
          (match init-lowered
            [(LowerExpr init-state init-value _)
              (match (lower-expr ctx init-state env type-env end)
                [(OkLowerExpr end-lowered)
                  (match end-lowered
                    [(LowerExpr end-state end-value _)
                      (match (lower-expr ctx end-state env type-env start)
                        [(OkLowerExpr start-lowered)
                          (match start-lowered
                            [(LowerExpr start-state start-value _)
                              (lower-avx2-spmd-reduce-build
                                ctx
                                start-state
                                env
                                type-env
                                index-ty
                                init-value
                                end-value
                                start-value
                                op
                                array-var
                                vector-op
                                elem-ty
                                lanes)])]
                        [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(LowerSomeVectorValueReduce value-plan vector-op elem-ty lanes)
      (match (lower-expr-expected ctx state env type-env init elem-ty init)
        [(OkLowerExpr init-lowered)
          (match init-lowered
            [(LowerExpr init-state init-value _)
              (match (lower-expr ctx init-state env type-env end)
                [(OkLowerExpr end-lowered)
                  (match end-lowered
                    [(LowerExpr end-state end-value _)
                      (match (lower-expr ctx end-state env type-env start)
                        [(OkLowerExpr start-lowered)
                          (match start-lowered
                            [(LowerExpr start-state start-value _)
                              (lower-avx2-spmd-reduce-value-build
                                ctx
                                start-state
                                env
                                type-env
                                index-ty
                                init-value
                                end-value
                                start-value
                                op
                                value-plan
                                vector-op
                                elem-ty
                                lanes)])]
                        [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [LowerNoVectorReduce
      (ErrLowerExpr
        (box (lower-diagnostic "lower: missing vector reduce plan")))]))

(define (lower-emit-tail-mask
  [state : LowerState]
  [index : CompilerIrValue]
  [end-value : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc s v)
      (LowerExpr
        (lower-state-emit s (CompilerIrInstr.TailMask v index end-value lanes))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-predicated-load
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [mask : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr data-state data-ptr _)
      (match (lower-state-alloc-var data-state)
        [(LowerAlloc s v)
          (LowerExpr
            (lower-state-emit
              s
              (ir-instr-predicated-load v data-ptr index mask lanes elem-ty))
            (CompilerIrValue.Var v)
            elem-ty)])]))

(define (lower-emit-predicated-store
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [value : CompilerIrValue]
  [mask : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerState
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr data-state data-ptr _)
      (lower-state-emit
        data-state
        (ir-instr-predicated-store data-ptr index value mask lanes elem-ty))]))

(define (lower-emit-spmd-broadcast-lane-check
  [state : LowerState]
  [lane : CompilerIrValue]
  [active-lanes : CompilerIrValue]) : LowerState
  (match (lower-emit-cast state lane (AstType.I64) (AstType.U64))
    [(LowerExpr lane-state lane-u _)
      (match (lower-emit-cast
        lane-state
        active-lanes
        (AstType.I64)
        (AstType.U64))
        [(LowerExpr count-state count-u _)
          (lower-emit-bounds-check count-state lane-u count-u)])]))

(define (lower-emit-spmd-broadcast-array
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [array-var : i64]
  [lane : CompilerIrValue]
  [active-lanes : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-emit-binop
    (lower-emit-spmd-broadcast-lane-check state lane active-lanes)
    CompilerIrBinOp.Add
    (CompilerIrValue.Var index-var)
    lane
    (AstType.I64))
    [(LowerExpr index-state source-index _)
      (match (lower-array-element-addr
        ctx
        index-state
        (CompilerIrValue.Var array-var)
        source-index
        (AstType.I64)
        elem-ty)
        [(LowerExpr addr-state source-addr _)
          (match (lower-emit-load addr-state source-addr elem-ty)
            [(LowerExpr load-state source-value _)
              (lower-emit-splat load-state source-value lanes elem-ty)])])]))

(define (lower-emit-vector-map-value
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(LowerVectorMapArray array-var)
      (lower-emit-vector-load
        state
        (CompilerIrValue.Var array-var)
        (CompilerIrValue.Var index-var)
        lanes
        elem-ty)]
    [(LowerVectorMapUniform value) (lower-emit-splat state value lanes elem-ty)]
    [(LowerVectorMapBroadcastArray array-var lane)
      (lower-emit-spmd-broadcast-array
        ctx
        state
        index-var
        array-var
        lane
        (CompilerIrValue.I64 lanes)
        lanes
        elem-ty)]
    [(LowerVectorMapLaneIndex) (lower-emit-lane-id state lanes elem-ty)]
    [(LowerVectorMapLaneCount)
      (lower-emit-splat state (CompilerIrValue.I64 lanes) lanes elem-ty)]
    [(LowerVectorMapBinOp op lhs rhs)
      (match (lower-emit-vector-map-value
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get lhs))
        [(LowerExpr lhs-state lhs-value _)
          (match (lower-emit-vector-map-value
            ctx
            lhs-state
            index-var
            lanes
            elem-ty
            (box-get rhs))
            [(LowerExpr rhs-state rhs-value _)
              (lower-emit-vector-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                elem-ty)])])]))

(define (lower-emit-predicated-vector-map-value
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : CompilerIrValue]
  [mask : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(LowerVectorMapArray array-var)
      (lower-emit-predicated-load
        state
        (CompilerIrValue.Var array-var)
        (CompilerIrValue.Var index-var)
        mask
        lanes
        elem-ty)]
    [(LowerVectorMapUniform value) (lower-emit-splat state value lanes elem-ty)]
    [(LowerVectorMapBroadcastArray array-var lane)
      (match (lower-emit-binop
        state
        CompilerIrBinOp.Sub
        end-value
        (CompilerIrValue.Var index-var)
        (AstType.I64))
        [(LowerExpr count-state active-lanes _)
          (lower-emit-spmd-broadcast-array
            ctx
            count-state
            index-var
            array-var
            lane
            active-lanes
            lanes
            elem-ty)])]
    [(LowerVectorMapLaneIndex) (lower-emit-lane-id state lanes elem-ty)]
    [(LowerVectorMapLaneCount)
      (lower-emit-splat state (CompilerIrValue.I64 lanes) lanes elem-ty)]
    [(LowerVectorMapBinOp op lhs rhs)
      (match (lower-emit-predicated-vector-map-value
        ctx
        state
        index-var
        end-value
        mask
        lanes
        elem-ty
        (box-get lhs))
        [(LowerExpr lhs-state lhs-value _)
          (match (lower-emit-predicated-vector-map-value
            ctx
            lhs-state
            index-var
            end-value
            mask
            lanes
            elem-ty
            (box-get rhs))
            [(LowerExpr rhs-state rhs-value _)
              (lower-emit-vector-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                elem-ty)])])]))

(define (lower-vector-map-value-has-broadcast? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapBroadcastArray _ _) true]
    [(LowerVectorMapBinOp _ lhs rhs)
      (or
        (lower-vector-map-value-has-broadcast? (box-get lhs))
        (lower-vector-map-value-has-broadcast? (box-get rhs)))]
    [_ false]))

(define (lower-vector-map-value-needs-scalar-tail? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapBroadcastArray _ _) true]
    [(LowerVectorMapLaneIndex) true]
    [(LowerVectorMapLaneCount) true]
    [(LowerVectorMapBinOp _ lhs rhs)
      (or
        (lower-vector-map-value-needs-scalar-tail? (box-get lhs))
        (lower-vector-map-value-needs-scalar-tail? (box-get rhs)))]
    [_ false]))

(define (lower-maybe-vector-map-needs-scalar-tail? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(LowerSomeVectorMap _ value-plan _ _)
      (lower-vector-map-value-needs-scalar-tail? value-plan)]
    [LowerNoVectorMap false]))

(define (lower-emit-scalar-vector-map-value
  [ctx : TcContext]
  [state : LowerState]
  [base-index-var : i64]
  [current-index-var : i64]
  [active-lanes : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(LowerVectorMapArray array-var)
      (match (lower-array-element-addr
        ctx
        state
        (CompilerIrValue.Var array-var)
        (CompilerIrValue.Var current-index-var)
        (AstType.I64)
        elem-ty)
        [(LowerExpr addr-state elem-ptr _)
          (lower-emit-load addr-state elem-ptr elem-ty)])]
    [(LowerVectorMapUniform value) (LowerExpr state value elem-ty)]
    [(LowerVectorMapBroadcastArray array-var lane)
      (match (lower-emit-binop
        (lower-emit-spmd-broadcast-lane-check state lane active-lanes)
        CompilerIrBinOp.Add
        (CompilerIrValue.Var base-index-var)
        lane
        (AstType.I64))
        [(LowerExpr index-state source-index _)
          (match (lower-array-element-addr
            ctx
            index-state
            (CompilerIrValue.Var array-var)
            source-index
            (AstType.I64)
            elem-ty)
            [(LowerExpr addr-state elem-ptr _)
              (lower-emit-load addr-state elem-ptr elem-ty)])])]
    [(LowerVectorMapLaneIndex)
      (lower-emit-binop
        state
        CompilerIrBinOp.Sub
        (CompilerIrValue.Var current-index-var)
        (CompilerIrValue.Var base-index-var)
        elem-ty)]
    [(LowerVectorMapLaneCount)
      (LowerExpr state (CompilerIrValue.I64 lanes) elem-ty)]
    [(LowerVectorMapBinOp op lhs rhs)
      (match (lower-emit-scalar-vector-map-value
        ctx
        state
        base-index-var
        current-index-var
        active-lanes
        lanes
        elem-ty
        (box-get lhs))
        [(LowerExpr lhs-state lhs-value _)
          (match (lower-emit-scalar-vector-map-value
            ctx
            lhs-state
            base-index-var
            current-index-var
            active-lanes
            lanes
            elem-ty
            (box-get rhs))
            [(LowerExpr rhs-state rhs-value _)
              (lower-emit-binop rhs-state op lhs-value rhs-value elem-ty)])])]))

(define (lower-avx2-broadcast-tail-map-body
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : CompilerIrValue]
  [dst-array : i64]
  [value-plan : LowerVectorMapValue]
  [elem-ty : AstType]
  [exit-label : String]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc alloc-state tail-var)
      (let
        [s : LowerState
          (lower-state-emit
            alloc-state
            (CompilerIrInstr.Mov
              tail-var
              (CompilerIrValue.Var index-var)
              (AstType.I64)))]
        [header-label : String ""]
        [body-label : String ""]
        [active-lanes : CompilerIrValue CompilerIrValue.Unit]
        [tail-cond : CompilerIrValue CompilerIrValue.Unit]
        [scalar-value : CompilerIrValue CompilerIrValue.Unit]
        [elem-ptr : CompilerIrValue CompilerIrValue.Unit]
        (begin
          (match (lower-state-fresh-label s "foreach_broadcast_tail_header")
            [(LowerLabel next-s label)
              (begin
                (set! s next-s)
                (set! header-label label))])
          (match (lower-state-fresh-label s "foreach_broadcast_tail_body")
            [(LowerLabel next-s label)
              (begin
                (set! s next-s)
                (set! body-label label))])
          (match (lower-emit-binop
            s
            CompilerIrBinOp.Sub
            end-value
            (CompilerIrValue.Var index-var)
            (AstType.I64))
            [(LowerExpr next-s value _)
              (begin
                (set! s next-s)
                (set! active-lanes value))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit s (CompilerIrInstr.Jump header-label))
              header-label))
          (match (lower-emit-binop
            s
            CompilerIrBinOp.Lt
            (CompilerIrValue.Var tail-var)
            end-value
            (AstType.Bool))
            [(LowerExpr next-s value _)
              (begin
                (set! s next-s)
                (set! tail-cond value))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit
                s
                (CompilerIrInstr.Branch tail-cond body-label exit-label))
              body-label))
          (match (lower-emit-scalar-vector-map-value
            ctx
            s
            index-var
            tail-var
            active-lanes
            (lower-simd-lanes-for-elem (lower-state-mode s) elem-ty)
            elem-ty
            value-plan)
            [(LowerExpr next-s value _)
              (begin
                (set! s next-s)
                (set! scalar-value value))])
          (match (lower-array-element-addr
            ctx
            s
            (CompilerIrValue.Var dst-array)
            (CompilerIrValue.Var tail-var)
            (AstType.I64)
            elem-ty)
            [(LowerExpr next-s value _)
              (begin
                (set! s next-s)
                (set! elem-ptr value))])
          (set!
            s
            (lower-array-elem-store-state ctx s elem-ptr scalar-value elem-ty))
          (match (lower-state-alloc-var s)
            [(LowerAlloc inc-alloc inc-var)
              (OkLowerExpr
                (LowerExpr
                  (lower-state-finish-block
                    (lower-state-emit
                      (lower-state-emit
                        (lower-state-emit
                          inc-alloc
                          (CompilerIrInstr.BinOp
                            inc-var
                            CompilerIrBinOp.Add
                            (CompilerIrValue.Var tail-var)
                            (CompilerIrValue.I64 1)
                            (AstType.I64)))
                        (CompilerIrInstr.Mov
                          tail-var
                          (CompilerIrValue.Var inc-var)
                          (AstType.I64)))
                      (CompilerIrInstr.Jump header-label))
                    exit-label)
                  CompilerIrValue.Unit
                  (AstType.Unit)))])))]))

(define (lower-avx2-vector-map-body
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [plan : LowerMaybeVectorMap]) : LowerState
  (match plan
    [(LowerSomeVectorMap dst-array value-plan elem-ty lanes)
      (let
        [s : LowerState state]
        [result-vec : CompilerIrValue CompilerIrValue.Unit]
        (begin
          (match (lower-emit-vector-map-value
            ctx
            s
            index-var
            lanes
            elem-ty
            value-plan)
            [(LowerExpr next-s value _)
              (begin
                (set! s next-s)
                (set! result-vec value))])
          (lower-state-emit
            (lower-emit-vector-store
              s
              (CompilerIrValue.Var dst-array)
              (CompilerIrValue.Var index-var)
              result-vec
              lanes
              elem-ty)
            (CompilerIrInstr.Mov index-var next-index (AstType.I64)))))]
    [LowerNoVectorMap state]))

(define (lower-avx2-vector-ok
  [state : LowerState]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [end-value : CompilerIrValue]
  [out-len : CompilerIrValue]
  [lhs-len : CompilerIrValue]
  [rhs-len : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [ok : CompilerIrValue CompilerIrValue.Unit]
    [within : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Ge)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 0)
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 (- 9223372036854775807 lanes))
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        next-index
        end-value
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        next-index
        out-len
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        next-index
        lhs-len
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        next-index
        rhs-len
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool)))))

(define (lower-avx512-tail-ok
  [state : LowerState]
  [index-var : i64]
  [end-value : CompilerIrValue]
  [out-len : CompilerIrValue]
  [lhs-len : CompilerIrValue]
  [rhs-len : CompilerIrValue]) : LowerExpr
  (let
    [s : LowerState state]
    [ok : CompilerIrValue CompilerIrValue.Unit]
    [within : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Ge)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 0)
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        (CompilerIrValue.Var index-var)
        end-value
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        end-value
        out-len
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        end-value
        lhs-len
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        end-value
        rhs-len
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool)))))

(define (lower-avx512-index-plus-offset
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]) : LowerExpr
  (if (> offset 0)
    (lower-emit-binop
      state
      (CompilerIrBinOp.Add)
      base
      (CompilerIrValue.I64 offset)
      (AstType.I64))
    (LowerExpr state base (AstType.I64))))

(define (lower-avx512-array-set-next-ok
  [state : LowerState]
  [ok : CompilerIrValue]
  [next-index : CompilerIrValue]
  [arrays : LowerArrayVarSet]) : LowerExpr
  (let
    [s : LowerState state]
    [next-ok : CompilerIrValue ok]
    [index : i64 0]
    [count : i64 (struct-get arrays count)]
    (begin
      (while (< index count)
        (let
          [array-var : i64 (array-ref (struct-get arrays vars) index)]
          [offset : i64 (array-ref (struct-get arrays offsets) index)]
          (begin
            (match (lower-avx512-index-plus-offset s next-index offset)
              [(LowerExpr index-state limit-index _)
                (match (lower-array-len-value
                  index-state
                  (CompilerIrValue.Var array-var))
                  [(LowerExpr len-state array-len _)
                    (match (lower-emit-binop
                      len-state
                      (CompilerIrBinOp.Le)
                      limit-index
                      array-len
                      (AstType.Bool))
                      [(LowerExpr cmp-state within _)
                        (match (lower-emit-binop
                          cmp-state
                          (CompilerIrBinOp.And)
                          next-ok
                          within
                          (AstType.Bool))
                          [(LowerExpr next-state value _)
                            (begin
                              (set! s next-state)
                              (set! next-ok value))])])])])
            (set! index (+ index 1)))))
      (LowerExpr s next-ok (AstType.Bool)))))

(define (lower-avx512-array-set-end-ok
  [state : LowerState]
  [ok : CompilerIrValue]
  [end-value : CompilerIrValue]
  [arrays : LowerArrayVarSet]) : LowerExpr
  (let
    [s : LowerState state]
    [next-ok : CompilerIrValue ok]
    [index : i64 0]
    [count : i64 (struct-get arrays count)]
    (begin
      (while (< index count)
        (let
          [array-var : i64 (array-ref (struct-get arrays vars) index)]
          [offset : i64 (array-ref (struct-get arrays offsets) index)]
          (begin
            (match (lower-avx512-index-plus-offset s end-value offset)
              [(LowerExpr index-state limit-index _)
                (match (lower-array-len-value
                  index-state
                  (CompilerIrValue.Var array-var))
                  [(LowerExpr len-state array-len _)
                    (match (lower-emit-binop
                      len-state
                      (CompilerIrBinOp.Le)
                      limit-index
                      array-len
                      (AstType.Bool))
                      [(LowerExpr cmp-state within _)
                        (match (lower-emit-binop
                          cmp-state
                          (CompilerIrBinOp.And)
                          next-ok
                          within
                          (AstType.Bool))
                          [(LowerExpr next-state value _)
                            (begin
                              (set! s next-state)
                              (set! next-ok value))])])])])
            (set! index (+ index 1)))))
      (LowerExpr s next-ok (AstType.Bool)))))

(define (lower-avx512-masked-index-limit [lanes : i64] [offset : i64]) : i64
  (let
    [base : i64 (- 9223372036854775807 lanes)]
    (if (> offset base)
      -1
      (- base offset))))

(define (lower-avx512-masked-tail-limit [offset : i64]) : i64
  (- 9223372036854775807 offset))

(define (lower-avx512-masked-vector-ok
  [state : LowerState]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [end-value : CompilerIrValue]
  [arrays : LowerArrayVarSet]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [max-offset : i64 (lower-array-var-set-max-offset arrays)]
    [ok : CompilerIrValue CompilerIrValue.Unit]
    [within : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Ge)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 0)
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 (lower-avx512-masked-index-limit lanes max-offset))
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        next-index
        end-value
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (lower-avx512-array-set-next-ok next-s value next-index arrays)]))))

(define (lower-avx512-masked-tail-ok
  [state : LowerState]
  [index-var : i64]
  [end-value : CompilerIrValue]
  [arrays : LowerArrayVarSet]) : LowerExpr
  (let
    [s : LowerState state]
    [max-offset : i64 (lower-array-var-set-max-offset arrays)]
    [ok : CompilerIrValue CompilerIrValue.Unit]
    [within : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Ge)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 0)
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        end-value
        (CompilerIrValue.I64 (lower-avx512-masked-tail-limit max-offset))
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Le)
        (CompilerIrValue.Var index-var)
        end-value
        (AstType.Bool))
        [(LowerExpr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr next-s value _)
          (lower-avx512-array-set-end-ok next-s value end-value arrays)]))))

(define (lower-avx512-masked-unsupported [expr : AstExpr] [detail : String]) : ResultLowerExpr
  (ErrLowerExpr
    (box
      (lower-diagnostic-at-expr
        expr
        (string.append "lower: SPMD masked if does not support " detail)))))

(define (lower-avx512-masked-index-value
  [state : LowerState]
  [index : String]
  [index-var : i64]
  [expr : AstExpr]) : ResultLowerExpr
  (let
    [offset : i64 (lower-masked-vector-index-offset index expr)]
    (if (< offset 0)
      (lower-avx512-masked-unsupported
        expr
        "non-contiguous array indexes in this AVX-512 slice")
      (if (= offset 0)
        (OkLowerExpr
          (LowerExpr state (CompilerIrValue.Var index-var) (AstType.I64)))
        (OkLowerExpr
          (lower-emit-binop
            state
            (CompilerIrBinOp.Add)
            (CompilerIrValue.Var index-var)
            (CompilerIrValue.I64 offset)
            (AstType.I64)))))))

(define (lower-avx512-masked-bool-literal
  [state : LowerState]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [value : bool]) : LowerExpr
  (if value
    (LowerExpr state active-mask (AstType.Bool))
    (lower-emit-mask-not state active-mask lanes)))

(define (lower-avx512-masked-var
  [_ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [lanes : i64]
  [expr : AstExpr]
  [name : String]) : ResultLowerExpr
  (if (lower-string-set-contains? lane-locals name)
    (let
      [var-id : i64
        (sym_i64_env.sym-i64-lookup-or
          env
          name
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? var-id)
        (match (tc-lookup type-env name)
          [(ResultTcType.Ok ty)
            (OkLowerExpr
              (LowerExpr
                state
                (CompilerIrValue.Var var-id)
                (tc-type-without-regions ty)))]
          [(ResultTcType.Err message)
            (ErrLowerExpr (box (lower-diagnostic-at-expr expr message)))])
        (lower-avx512-masked-unsupported expr "unknown lane-local binding")))
    (if (string.eq name index)
      (OkLowerExpr (lower-emit-foreach-index-vector state index-var lanes))
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? var-id)
          (match (tc-lookup type-env name)
            [(ResultTcType.Ok ty)
              (let
                [lane-ty : AstType (tc-type-without-regions ty)]
                (if (>
                  (lower-simd-lanes-for-elem (lower-state-mode state) lane-ty)
                  0)
                  (OkLowerExpr
                    (lower-emit-splat
                      state
                      (CompilerIrValue.Var var-id)
                      lanes
                      lane-ty))
                  (lower-avx512-masked-unsupported
                    expr
                    "uniform non-lane values inside masked vector expressions")))]
            [(ResultTcType.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr expr message)))])
          (lower-avx512-masked-unsupported
            expr
            "unbound values inside masked vector expressions"))))))

(define (lower-avx512-masked-array-ref
  [_ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [arr : AstExpr]
  [idx : AstExpr]) : ResultLowerExpr
  (match (lower-dynamic-array-var env type-env arr)
    [(LowerSomeArrayVar array-var elem-ty)
      (let
        [lane-ty : AstType (tc-type-without-regions elem-ty)]
        (if (lower-type-bool? lane-ty)
          (match (lower-avx512-masked-index-value state index index-var idx)
            [(OkLowerExpr idx-lowered)
              (match idx-lowered
                [(LowerExpr idx-state idx-value _)
                  (OkLowerExpr
                    (lower-emit-predicated-load
                      idx-state
                      (CompilerIrValue.Var array-var)
                      idx-value
                      active-mask
                      lanes
                      lane-ty))])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])
          (if (=
            (lower-simd-lanes-for-elem (lower-state-mode state) lane-ty)
            lanes)
            (match (lower-avx512-masked-index-value state index index-var idx)
              [(OkLowerExpr idx-lowered)
                (match idx-lowered
                  [(LowerExpr idx-state idx-value _)
                    (OkLowerExpr
                      (lower-emit-predicated-load
                        idx-state
                        (CompilerIrValue.Var array-var)
                        idx-value
                        active-mask
                        lanes
                        lane-ty))])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])
            (lower-avx512-masked-unsupported
              expr
              "mixed lane widths inside one masked foreach"))))]
    [LowerNoArrayVar
      (lower-avx512-masked-unsupported
        expr
        "non-dynamic-array reads inside masked branches")]))

(define (lower-avx512-masked-array-set
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [arr : AstExpr]
  [idx : AstExpr]
  [value : AstExpr]) : ResultLowerExpr
  (match (lower-dynamic-array-var env type-env arr)
    [(LowerSomeArrayVar array-var elem-ty)
      (let
        [lane-ty : AstType (tc-type-without-regions elem-ty)]
        (if (lower-type-bool? lane-ty)
          (match (lower-avx512-masked-index-value state index index-var idx)
            [(OkLowerExpr idx-lowered)
              (match idx-lowered
                [(LowerExpr idx-state idx-value _)
                  (match (lower-avx512-masked-expr-expected
                    ctx
                    idx-state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    value
                    lane-ty)
                    [(OkLowerExpr value-lowered)
                      (match value-lowered
                        [(LowerExpr value-state value-ir _)
                          (OkLowerExpr
                            (LowerExpr
                              (lower-emit-predicated-store
                                value-state
                                (CompilerIrValue.Var array-var)
                                idx-value
                                value-ir
                                active-mask
                                lanes
                                lane-ty)
                              CompilerIrValue.Unit
                              (AstType.Unit)))])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])
          (if (=
            (lower-simd-lanes-for-elem (lower-state-mode state) lane-ty)
            lanes)
            (match (lower-avx512-masked-index-value state index index-var idx)
              [(OkLowerExpr idx-lowered)
                (match idx-lowered
                  [(LowerExpr idx-state idx-value _)
                    (match (lower-avx512-masked-expr-expected
                      ctx
                      idx-state
                      env
                      type-env
                      lane-locals
                      index
                      index-var
                      active-mask
                      lanes
                      value
                      lane-ty)
                      [(OkLowerExpr value-lowered)
                        (match value-lowered
                          [(LowerExpr value-state value-ir _)
                            (OkLowerExpr
                              (LowerExpr
                                (lower-emit-predicated-store
                                  value-state
                                  (CompilerIrValue.Var array-var)
                                  idx-value
                                  value-ir
                                  active-mask
                                  lanes
                                  lane-ty)
                                CompilerIrValue.Unit
                                (AstType.Unit)))])]
                      [(ErrLowerExpr message) (ErrLowerExpr message)])])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])
            (lower-avx512-masked-unsupported
              expr
              "mixed lane widths inside one masked foreach"))))]
    [LowerNoArrayVar
      (lower-avx512-masked-unsupported
        expr
        "non-dynamic-array writes inside masked branches")]))

(define (lower-avx512-masked-let-bindings
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [bindings : AstLetBindingList]) : ResultLowerEnv
  (match bindings
    [(AstLetBindingList.Nil) (OkLowerEnv state env type-env)]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (lower-avx512-masked-expr
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                init)
                [(OkLowerExpr lowered)
                  (match lowered
                    [(LowerExpr init-state init-value init-ty)
                      (let
                        [binding-ty : AstType
                          (lower-let-binding-type ctx maybe-ty init-ty)]
                        (match init-value
                          [(CompilerIrValue.Var init-var)
                            (lower-avx512-masked-let-bindings
                              ctx
                              init-state
                              (sym_i64_env.sym-i64-bind-id env name init-var)
                              (tc-bind-id type-env name binding-ty)
                              (lower-string-set-insert
                                lane-locals
                                (intern-str name))
                              index
                              index-var
                              active-mask
                              lanes
                              rest)]
                          [_
                            (ErrLowerEnv
                              (box
                                (lower-diagnostic-at-expr
                                  init
                                  "lower: masked let init did not produce an IR variable")))]))])]
                [(ErrLowerExpr message) (ErrLowerEnv message)]))]))]))

(define (lower-avx512-masked-begin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [exprs : AstExprList]) : ResultLowerExpr
  (match exprs
    [(AstExprList.Nil)
      (OkLowerExpr (LowerExpr state CompilerIrValue.Unit (AstType.Unit)))]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr next-state value ty)
                (match rest
                  [(AstExprList.Nil)
                    (OkLowerExpr (LowerExpr next-state value ty))]
                  [_
                    (lower-avx512-masked-begin
                      ctx
                      next-state
                      env
                      type-env
                      lane-locals
                      index
                      index-var
                      active-mask
                      lanes
                      rest)])])]
          [(ErrLowerExpr message) (ErrLowerExpr message)]))]))

(define (lower-avx512-masked-select-result-supported?
  [state : LowerState]
  [lanes : i64]
  [ty : AstType]) : bool
  (=
    (lower-simd-lanes-for-elem
      (lower-state-mode state)
      (tc-type-without-regions ty))
    lanes))

(define (lower-avx512-masked-while
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [cond : AstExpr]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc mask-alloc loop-mask-var)
      (let
        [s : LowerState
          (lower-state-emit
            mask-alloc
            (CompilerIrInstr.MaskBinOp
              loop-mask-var
              (CompilerIrMaskBinOp.Or)
              active-mask
              active-mask
              lanes))]
        [header-label : String ""]
        [body-label : String ""]
        [exit-label : String ""]
        [cond-active : CompilerIrValue CompilerIrValue.Unit]
        [any-active : CompilerIrValue CompilerIrValue.Unit]
        (begin
          (match (lower-state-fresh-label s "spmd_vwhile_header")
            [(LowerLabel next-s label)
              (begin
                (set! s next-s)
                (set! header-label label))])
          (match (lower-state-fresh-label s "spmd_vwhile_body")
            [(LowerLabel next-s label)
              (begin
                (set! s next-s)
                (set! body-label label))])
          (match (lower-state-fresh-label s "spmd_vwhile_exit")
            [(LowerLabel next-s label)
              (begin
                (set! s next-s)
                (set! exit-label label))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit s (CompilerIrInstr.Jump header-label))
              header-label))
          (match (lower-avx512-masked-expr
            ctx
            s
            env
            type-env
            lane-locals
            index
            index-var
            (CompilerIrValue.Var loop-mask-var)
            lanes
            cond)
            [(OkLowerExpr cond-lowered)
              (match cond-lowered
                [(LowerExpr cond-state cond-mask _)
                  (begin
                    (match (lower-emit-mask-binop
                      cond-state
                      (CompilerIrMaskBinOp.And)
                      (CompilerIrValue.Var loop-mask-var)
                      cond-mask
                      lanes)
                      [(LowerExpr next-s value _)
                        (begin
                          (set! s next-s)
                          (set! cond-active value))])
                    (match (lower-emit-mask-reduce
                      s
                      (CompilerIrMaskReduceOp.Any)
                      cond-active
                      lanes)
                      [(LowerExpr next-s value _)
                        (begin
                          (set! s next-s)
                          (set! any-active value))]))])]
            [(ErrLowerExpr message) (return (ErrLowerExpr message))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit
                s
                (CompilerIrInstr.Branch any-active body-label exit-label))
              body-label))
          (match (lower-avx512-masked-expr-expected
            ctx
            s
            env
            type-env
            lane-locals
            index
            index-var
            cond-active
            lanes
            body
            (AstType.Unit))
            [(OkLowerExpr body-lowered)
              (match body-lowered
                [(LowerExpr body-state _ _)
                  (set!
                    s
                    (lower-state-emit
                      body-state
                      (CompilerIrInstr.MaskBinOp
                        loop-mask-var
                        (CompilerIrMaskBinOp.Or)
                        cond-active
                        cond-active
                        lanes)))])]
            [(ErrLowerExpr message) (return (ErrLowerExpr message))])
          (OkLowerExpr
            (LowerExpr
              (lower-state-finish-block
                (lower-state-emit s (CompilerIrInstr.Jump header-label))
                exit-label)
              CompilerIrValue.Unit
              (AstType.Unit)))))]))

(define (lower-avx512-masked-if
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [cond : AstExpr]
  [then-branch : AstExpr]
  [else-branch : AstExpr]) : ResultLowerExpr
  (match (lower-avx512-masked-expr
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    cond)
    [(OkLowerExpr cond-lowered)
      (match cond-lowered
        [(LowerExpr cond-state cond-mask _)
          (match (lower-emit-mask-binop
            cond-state
            (CompilerIrMaskBinOp.And)
            active-mask
            cond-mask
            lanes)
            [(LowerExpr then-mask-state then-mask _)
              (match (lower-emit-mask-not then-mask-state cond-mask lanes)
                [(LowerExpr not-state not-mask _)
                  (match (lower-emit-mask-binop
                    not-state
                    (CompilerIrMaskBinOp.And)
                    active-mask
                    not-mask
                    lanes)
                    [(LowerExpr else-mask-state else-mask _)
                      (match (lower-avx512-masked-expr-expected
                        ctx
                        else-mask-state
                        env
                        type-env
                        lane-locals
                        index
                        index-var
                        then-mask
                        lanes
                        then-branch
                        result-ty)
                        [(OkLowerExpr then-lowered)
                          (match then-lowered
                            [(LowerExpr then-state then-value then-ty)
                              (match (lower-avx512-masked-expr-expected
                                ctx
                                then-state
                                env
                                type-env
                                lane-locals
                                index
                                index-var
                                else-mask
                                lanes
                                else-branch
                                result-ty)
                                [(OkLowerExpr else-lowered)
                                  (match else-lowered
                                    [(LowerExpr else-state else-value else-ty)
                                      (match then-ty
                                        [(AstType.Unit)
                                          (OkLowerExpr
                                            (LowerExpr
                                              else-state
                                              CompilerIrValue.Unit
                                              (AstType.Unit)))]
                                        [_
                                          (if (and
                                            (ast-type-eq? then-ty else-ty)
                                            (lower-type-bool? then-ty))
                                            (OkLowerExpr
                                              (lower-emit-mask-select
                                                else-state
                                                then-mask
                                                then-value
                                                else-mask
                                                else-value
                                                lanes))
                                            (if (and
                                              (ast-type-eq? then-ty else-ty)
                                              (lower-avx512-masked-select-result-supported?
                                                else-state
                                                lanes
                                                then-ty))
                                              (OkLowerExpr
                                                (lower-emit-select
                                                  else-state
                                                  then-mask
                                                  then-value
                                                  else-value
                                                  lanes
                                                  then-ty))
                                              (lower-avx512-masked-unsupported
                                                expr
                                                "this value-producing masked if result type")))])])]
                                [(ErrLowerExpr message) (ErrLowerExpr message)])])]
                        [(ErrLowerExpr message) (ErrLowerExpr message)])])])])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-avx512-masked-binary
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultLowerExpr
  (match op
    [(AstBinOp.And)
      (match (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        left)
        [(OkLowerExpr left-lowered)
          (match left-lowered
            [(LowerExpr left-state left-value _)
              (match (lower-avx512-masked-expr
                ctx
                left-state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                right)
                [(OkLowerExpr right-lowered)
                  (match right-lowered
                    [(LowerExpr right-state right-value _)
                      (OkLowerExpr
                        (lower-emit-mask-binop
                          right-state
                          (CompilerIrMaskBinOp.And)
                          left-value
                          right-value
                          lanes))])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(AstBinOp.Or)
      (match (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        left)
        [(OkLowerExpr left-lowered)
          (match left-lowered
            [(LowerExpr left-state left-value _)
              (match (lower-avx512-masked-expr
                ctx
                left-state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                right)
                [(OkLowerExpr right-lowered)
                  (match right-lowered
                    [(LowerExpr right-state right-value _)
                      (OkLowerExpr
                        (lower-emit-mask-binop
                          right-state
                          (CompilerIrMaskBinOp.Or)
                          left-value
                          right-value
                          lanes))])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(AstBinOp.Add)
      (match (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        left)
        [(OkLowerExpr left-lowered)
          (match left-lowered
            [(LowerExpr left-state left-value left-ty)
              (match (lower-avx512-masked-expr-expected
                ctx
                left-state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                right
                left-ty)
                [(OkLowerExpr right-lowered)
                  (match right-lowered
                    [(LowerExpr right-state right-value _)
                      (OkLowerExpr
                        (lower-emit-vector-binop
                          right-state
                          (CompilerIrBinOp.Add)
                          left-value
                          right-value
                          lanes
                          left-ty))])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(AstBinOp.Mod)
      (let
        [divisor : i64 (lower-masked-vector-positive-power-two-literal right)]
        [index-offset : i64 (lower-masked-vector-index-offset index left)]
        (if (and (> divisor 0) (>= index-offset 0))
          (match (lower-avx512-masked-expr
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            left)
            [(OkLowerExpr left-lowered)
              (match left-lowered
                [(LowerExpr left-state left-value left-ty)
                  (match (lower-emit-splat
                    left-state
                    (CompilerIrValue.I64 (- divisor 1))
                    lanes
                    left-ty)
                    [(LowerExpr rhs-state rhs-value _)
                      (OkLowerExpr
                        (lower-emit-vector-binop
                          rhs-state
                          (CompilerIrBinOp.BitAnd)
                          left-value
                          rhs-value
                          lanes
                          left-ty))])])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])
          (lower-avx512-masked-unsupported expr "this binary operator")))]
    [(AstBinOp.Eq)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Eq)
        left
        right)]
    [(AstBinOp.Ne)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Ne)
        left
        right)]
    [(AstBinOp.Lt)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Lt)
        left
        right)]
    [(AstBinOp.Le)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Le)
        left
        right)]
    [(AstBinOp.Gt)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Gt)
        left
        right)]
    [(AstBinOp.Ge)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Ge)
        left
        right)]
    [_ (lower-avx512-masked-unsupported expr "this binary operator")]))

(define (lower-avx512-masked-compare
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [_expr : AstExpr]
  [op : CompilerIrBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultLowerExpr
  (match (lower-avx512-masked-expr
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    left)
    [(OkLowerExpr left-lowered)
      (match left-lowered
        [(LowerExpr left-state left-value left-ty)
          (match (lower-avx512-masked-expr-expected
            ctx
            left-state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            right
            left-ty)
            [(OkLowerExpr right-lowered)
              (match right-lowered
                [(LowerExpr right-state right-value _)
                  (OkLowerExpr
                    (lower-emit-vector-compare
                      right-state
                      op
                      left-value
                      right-value
                      lanes
                      left-ty))])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-avx512-masked-match-literal-mask
  [state : LowerState]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [lanes : i64]
  [lit : AstLiteral]) : ResultLowerExpr
  (match (tc-type-without-regions scrut-ty)
    [(AstType.Bool)
      (match lit
        [(AstLiteral.Bool value)
          (if value
            (OkLowerExpr (LowerExpr state scrut-value (AstType.Bool)))
            (OkLowerExpr (lower-emit-mask-not state scrut-value lanes)))]
        [_
          (ErrLowerExpr
            (box
              (lower-diagnostic "lower: unsupported bool literal match pattern")))])]
    [_
      (match (lower-emit-splat
        state
        (lower-literal-value-with-type lit (tc-type-without-regions scrut-ty))
        lanes
        (tc-type-without-regions scrut-ty))
        [(LowerExpr lit-state lit-value _)
          (OkLowerExpr
            (lower-emit-vector-compare
              lit-state
              (CompilerIrBinOp.Eq)
              scrut-value
              lit-value
              lanes
              (tc-type-without-regions scrut-ty)))])]))

(define (lower-avx512-masked-match-literal-arm-masks
  [state : LowerState]
  [active-mask : CompilerIrValue]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [lanes : i64]
  [lit : AstLiteral]) : ResultLowerMaskedMatchMasks
  (match (lower-avx512-masked-match-literal-mask
    state
    scrut-value
    scrut-ty
    lanes
    lit)
    [(OkLowerExpr cond-lowered)
      (match cond-lowered
        [(LowerExpr cond-state cond-mask _)
          (match (lower-emit-mask-binop
            cond-state
            (CompilerIrMaskBinOp.And)
            active-mask
            cond-mask
            lanes)
            [(LowerExpr arm-mask-state arm-mask _)
              (match (lower-emit-mask-not arm-mask-state cond-mask lanes)
                [(LowerExpr not-state not-mask _)
                  (match (lower-emit-mask-binop
                    not-state
                    (CompilerIrMaskBinOp.And)
                    active-mask
                    not-mask
                    lanes)
                    [(LowerExpr rest-mask-state rest-mask _)
                      (OkLowerMaskedMatchMasks
                        (LowerMaskedMatchMasks
                          rest-mask-state
                          arm-mask
                          rest-mask))])])])])]
    [(ErrLowerExpr message) (ErrLowerMaskedMatchMasks message)]))

(define (lower-avx512-masked-match-select
  [state : LowerState]
  [arm-mask : CompilerIrValue]
  [arm-value : CompilerIrValue]
  [rest-mask : CompilerIrValue]
  [rest-value : CompilerIrValue]
  [lanes : i64]
  [ty : AstType]
  [expr : AstExpr]) : ResultLowerExpr
  (if (lower-type-bool? ty)
    (OkLowerExpr
      (lower-emit-mask-select
        state
        arm-mask
        arm-value
        rest-mask
        rest-value
        lanes))
    (if (lower-avx512-masked-select-result-supported? state lanes ty)
      (OkLowerExpr
        (lower-emit-select
          state
          arm-mask
          arm-value
          rest-value
          lanes
          (tc-type-without-regions ty)))
      (lower-avx512-masked-unsupported
        expr
        "this value-producing varying match result type"))))

(define (lower-avx512-masked-match-after-body
  [ctx : TcContext]
  [body-state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [arm-mask : CompilerIrValue]
  [rest-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [body-value : CompilerIrValue]
  [body-ty : AstType]
  [rest : AstMatchArmList]) : ResultLowerExpr
  (match body-ty
    [(AstType.Unit)
      (lower-avx512-masked-match-arms
        ctx
        body-state
        env
        type-env
        lane-locals
        index
        index-var
        rest-mask
        lanes
        result-ty
        expr
        scrut-value
        scrut-ty
        rest)]
    [_
      (match (lower-avx512-masked-match-arms
        ctx
        body-state
        env
        type-env
        lane-locals
        index
        index-var
        rest-mask
        lanes
        result-ty
        expr
        scrut-value
        scrut-ty
        rest)
        [(OkLowerExpr rest-lowered)
          (match rest-lowered
            [(LowerExpr rest-state rest-value rest-ty)
              (if (ast-type-eq?
                (tc-type-without-regions body-ty)
                (tc-type-without-regions rest-ty))
                (lower-avx512-masked-match-select
                  rest-state
                  arm-mask
                  body-value
                  rest-mask
                  rest-value
                  lanes
                  body-ty
                  expr)
                (lower-avx512-masked-unsupported
                  expr
                  "mixed varying match arm result types"))])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]))

(define (lower-avx512-masked-match-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [pattern : AstPattern]
  [body : AstExpr]
  [rest : AstMatchArmList]) : ResultLowerExpr
  (match pattern
    [(AstPattern.Literal lit)
      (match rest
        [(AstMatchArmList.Nil)
          (lower-avx512-masked-expr-expected
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            body
            result-ty)]
        [_
          (match (lower-avx512-masked-match-literal-arm-masks
            state
            active-mask
            scrut-value
            scrut-ty
            lanes
            lit)
            [(OkLowerMaskedMatchMasks masks)
              (match masks
                [(LowerMaskedMatchMasks mask-state arm-mask rest-mask)
                  (match (lower-avx512-masked-expr-expected
                    ctx
                    mask-state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    arm-mask
                    lanes
                    body
                    result-ty)
                    [(OkLowerExpr body-lowered)
                      (match body-lowered
                        [(LowerExpr body-state body-value body-ty)
                          (lower-avx512-masked-match-after-body
                            ctx
                            body-state
                            env
                            type-env
                            lane-locals
                            index
                            index-var
                            arm-mask
                            rest-mask
                            lanes
                            result-ty
                            expr
                            scrut-value
                            scrut-ty
                            body-value
                            body-ty
                            rest)])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)])])]
            [(ErrLowerMaskedMatchMasks message) (ErrLowerExpr message)])])]
    [(AstPattern.Wildcard)
      (lower-avx512-masked-expr-expected
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        body
        result-ty)]
    [(AstPattern.Var name _)
      (match scrut-value
        [(CompilerIrValue.Var scrut-var)
          (lower-avx512-masked-expr-expected
            ctx
            state
            (sym_i64_env.sym-i64-bind-id env name scrut-var)
            (tc-bind-id type-env name scrut-ty)
            (lower-string-set-insert lane-locals (intern-str name))
            index
            index-var
            active-mask
            lanes
            body
            result-ty)]
        [_
          (lower-avx512-masked-unsupported
            expr
            "non-variable match binding values in this AVX-512 slice")])]
    [(AstPattern.Binding name)
      (match scrut-value
        [(CompilerIrValue.Var scrut-var)
          (lower-avx512-masked-expr-expected
            ctx
            state
            (sym_i64_env.sym-i64-bind-id env name scrut-var)
            (tc-bind-id type-env name scrut-ty)
            (lower-string-set-insert lane-locals (intern-str name))
            index
            index-var
            active-mask
            lanes
            body
            result-ty)]
        [_
          (lower-avx512-masked-unsupported
            expr
            "non-variable match binding values in this AVX-512 slice")])]
    [_
      (lower-avx512-masked-unsupported
        expr
        "this varying match pattern in the AVX-512 slice")]))

(define (lower-avx512-masked-match-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultLowerExpr
  (match arms
    [(AstMatchArmList.Nil)
      (lower-avx512-masked-unsupported
        expr
        "match with no arms in this AVX-512 slice")]
    [(AstMatchArmList.Cons arm rest)
      (match arm
        [(AstMatchArm.Arm pattern body-box)
          (lower-avx512-masked-match-arm
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            result-ty
            expr
            scrut-value
            scrut-ty
            pattern
            (ast-node-get body-box)
            (box-get rest))])]))

(define (lower-avx512-masked-match
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]) : ResultLowerExpr
  (match (lower-avx512-masked-expr
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    scrutinee)
    [(OkLowerExpr scrut-lowered)
      (match scrut-lowered
        [(LowerExpr scrut-state scrut-value scrut-ty)
          (lower-avx512-masked-match-arms
            ctx
            scrut-state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            result-ty
            expr
            scrut-value
            scrut-ty
            arms)])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-avx512-masked-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner))]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Bool value)
          (OkLowerExpr
            (lower-avx512-masked-bool-literal state active-mask lanes value))]
        [_
          (OkLowerExpr
            (lower-emit-splat
              state
              (lower-literal-value-with-type lit (tc-literal-type lit))
              lanes
              (tc-literal-type lit)))])]
    [(AstExpr.SpmdProgramIndex)
      (OkLowerExpr (lower-emit-lane-id state lanes (AstType.I64)))]
    [(AstExpr.SpmdProgramCount)
      (OkLowerExpr
        (lower-emit-splat state (CompilerIrValue.I64 lanes) lanes (AstType.I64)))]
    [(AstExpr.Var name)
      (lower-avx512-masked-var
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        lanes
        expr
        (intern-str name))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match op
          [(AstUnOp.Not)
            (match (lower-avx512-masked-expr
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              inner)
              [(OkLowerExpr lowered)
                (match lowered
                  [(LowerExpr next-state value _)
                    (OkLowerExpr (lower-emit-mask-not next-state value lanes))])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]
          [_ (lower-avx512-masked-unsupported expr "this unary operator")]))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (lower-avx512-masked-binary
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr
          op
          left
          right))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (lower-avx512-masked-let-bindings
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              bindings)
              [(OkLowerEnv bound-state bound-env bound-type-env)
                (lower-avx512-masked-expr
                  ctx
                  bound-state
                  bound-env
                  bound-type-env
                  (lower-masked-vector-let-binding-names bindings lane-locals)
                  index
                  index-var
                  active-mask
                  lanes
                  body)]
              [(ErrLowerEnv message) (ErrLowerExpr message)]))])]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          expr)
          [(ResultTcType.Ok result-ty)
            (lower-avx512-masked-if
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              result-ty
              expr
              cond
              then-branch
              else-branch)]
          [(ResultTcType.Err message)
            (ErrLowerExpr (box (lower-diagnostic-at-expr expr message)))]))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (match (lower-expr-result-type-or-check
            ctx
            env
            type-env
            (lower-state-type-cache state)
            expr)
            [(ResultTcType.Ok result-ty)
              (lower-avx512-masked-match
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                result-ty
                expr
                (ast-node-get scrutinee-box)
                arms)]
            [(ResultTcType.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr expr message)))])])]
    [(AstExpr.While cond-box body-box)
      (lower-avx512-masked-while
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        (ast-node-get cond-box)
        (ast-node-get body-box))]
    [(AstExpr.Begin exprs)
      (lower-avx512-masked-begin
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        (lower-avx512-masked-array-ref
          ctx
          state
          env
          type-env
          index
          index-var
          active-mask
          lanes
          expr
          arr
          idx))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (ast-node-get arr-box)]
        [idx : AstExpr (ast-node-get idx-box)]
        [value : AstExpr (ast-node-get value-box)]
        (lower-avx512-masked-array-set
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr
          arr
          idx
          value))]
    [_ (lower-avx512-masked-unsupported expr "this branch expression")]))

(define (lower-avx512-masked-expr-expected
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerStringSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [expected-ty : AstType]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner
          expected-ty))]
    [(AstExpr.Literal lit)
      (OkLowerExpr
        (lower-emit-splat
          state
          (lower-literal-value-with-type
            lit
            (tc-type-without-regions expected-ty))
          lanes
          (tc-type-without-regions expected-ty)))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (lower-avx512-masked-if
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expected-ty
          expr
          cond
          then-branch
          else-branch))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (lower-avx512-masked-match
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            expected-ty
            expr
            (ast-node-get scrutinee-box)
            arms)])]
    [_
      (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr)]))

(define (lower-avx512-tail-map-body
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : CompilerIrValue]
  [plan : LowerMaybeVectorMap]) : LowerState
  (match plan
    [(LowerSomeVectorMap dst-array value-plan elem-ty lanes)
      (let
        [s : LowerState state]
        [mask : CompilerIrValue CompilerIrValue.Unit]
        [result-vec : CompilerIrValue CompilerIrValue.Unit]
        (begin
          (match (lower-emit-tail-mask
            s
            (CompilerIrValue.Var index-var)
            end-value
            lanes)
            [(LowerExpr next-s value _)
              (begin
                (set! s next-s)
                (set! mask value))])
          (match (lower-emit-predicated-vector-map-value
            ctx
            s
            index-var
            end-value
            mask
            lanes
            elem-ty
            value-plan)
            [(LowerExpr next-s value _)
              (begin
                (set! s next-s)
                (set! result-vec value))])
          (lower-emit-predicated-store
            s
            (CompilerIrValue.Var dst-array)
            (CompilerIrValue.Var index-var)
            result-vec
            mask
            lanes
            elem-ty)))]
    [LowerNoVectorMap state]))

(define (lower-avx512-masked-map-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [body : AstExpr]) : ResultLowerExpr
  (lower-avx512-masked-expr
    ctx
    state
    (sym_i64_env.sym-i64-bind env index index-var)
    (tc-bind type-env index index-ty)
    LowerStringNil
    index
    index-var
    active-mask
    lanes
    body))

(define (lower-avx512-masked-foreach-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]
  [plan : LowerMaybeMaskedVectorMap]) : ResultLowerExpr
  (match plan
    [(LowerSomeMaskedVectorMap lanes)
      (match (lower-state-alloc-var state)
        [(LowerAlloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov index-var start-value index-ty))]
            [body-env : sym_i64_env.SymI64Env
              (sym_i64_env.sym-i64-bind env index index-var)]
            [body-type-env : TcTypeEnv (tc-bind type-env index index-ty)]
            [arrays : LowerArrayVarSet
              (lower-masked-vector-array-vars body-env body-type-env index body)]
            [header-label : String ""]
            [body-label : String ""]
            [tail-header-label : String ""]
            [tail-check-label : String ""]
            [tail-mask-label : String ""]
            [tail-body-label : String ""]
            [exit-label : String ""]
            [next-index : CompilerIrValue CompilerIrValue.Unit]
            [vector-ok : CompilerIrValue CompilerIrValue.Unit]
            [tail-cond : CompilerIrValue CompilerIrValue.Unit]
            [tail-safe : CompilerIrValue CompilerIrValue.Unit]
            [active-mask : CompilerIrValue CompilerIrValue.Unit]
            (begin
              (match (lower-state-fresh-label s "foreach_avx512_mask_header")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "foreach_avx512_mask_body")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "foreach_tail_header")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (match (lower-state-fresh-label s "foreach_tail_check")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-check-label label))])
              (match (lower-state-fresh-label s "foreach_tail_mask")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-mask-label label))])
              (match (lower-state-fresh-label s "foreach_tail_body")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "foreach_exit")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (CompilerIrInstr.Jump header-label))
                  header-label))
              (match (lower-emit-binop
                s
                (CompilerIrBinOp.Add)
                (CompilerIrValue.Var index-var)
                (CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! next-index value))])
              (match (lower-avx512-masked-vector-ok
                s
                index-var
                next-index
                end-value
                arrays
                lanes)
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      vector-ok
                      body-label
                      tail-header-label))
                  body-label))
              (match (lower-emit-tail-mask
                s
                (CompilerIrValue.Var index-var)
                next-index
                lanes)
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! active-mask value))])
              (match (lower-avx512-masked-map-body
                ctx
                s
                env
                type-env
                index
                index-ty
                index-var
                active-mask
                lanes
                body)
                [(OkLowerExpr lowered-body)
                  (match lowered-body
                    [(LowerExpr body-state _ _)
                      (set!
                        s
                        (lower-state-emit
                          body-state
                          (CompilerIrInstr.Mov index-var next-index index-ty)))])]
                [(ErrLowerExpr message) (return (ErrLowerExpr message))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (CompilerIrInstr.Jump header-label))
                  tail-header-label))
              (match (lower-emit-binop
                s
                (CompilerIrBinOp.Lt)
                (CompilerIrValue.Var index-var)
                end-value
                (AstType.Bool))
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! tail-cond value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      tail-cond
                      tail-check-label
                      exit-label))
                  tail-check-label))
              (match (lower-avx512-masked-tail-ok s index-var end-value arrays)
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! tail-safe value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      tail-safe
                      tail-mask-label
                      tail-body-label))
                  tail-mask-label))
              (match (lower-emit-tail-mask
                s
                (CompilerIrValue.Var index-var)
                end-value
                lanes)
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! active-mask value))])
              (match (lower-avx512-masked-map-body
                ctx
                s
                env
                type-env
                index
                index-ty
                index-var
                active-mask
                lanes
                body)
                [(OkLowerExpr lowered-tail)
                  (match lowered-tail
                    [(LowerExpr tail-state _ _)
                      (set!
                        s
                        (lower-state-finish-block
                          (lower-state-emit
                            tail-state
                            (CompilerIrInstr.Jump exit-label))
                          tail-body-label))])]
                [(ErrLowerExpr message) (return (ErrLowerExpr message))])
              (match (lower-expr ctx s body-env body-type-env body)
                [(OkLowerExpr scalar-tail-lowered)
                  (match scalar-tail-lowered
                    [(LowerExpr post-body-state _ _)
                      (match (lower-state-alloc-var post-body-state)
                        [(LowerAlloc inc-alloc inc-var)
                          (OkLowerExpr
                            (LowerExpr
                              (lower-state-finish-block
                                (lower-state-emit
                                  (lower-state-emit
                                    (lower-state-emit
                                      inc-alloc
                                      (CompilerIrInstr.BinOp
                                        inc-var
                                        CompilerIrBinOp.Add
                                        (CompilerIrValue.Var index-var)
                                        (CompilerIrValue.I64 1)
                                        index-ty))
                                    (CompilerIrInstr.Mov
                                      index-var
                                      (CompilerIrValue.Var inc-var)
                                      index-ty))
                                  (CompilerIrInstr.Jump tail-header-label))
                                exit-label)
                              CompilerIrValue.Unit
                              (AstType.Unit)))])])]
                [(ErrLowerExpr message) (ErrLowerExpr message)])))])]
    [LowerNoMaskedVectorMap
      (lower-scalar-foreach-lowered
        ctx
        state
        env
        type-env
        index
        index-ty
        start-value
        end-value
        body)]))

;; Scalar `foreach` lowering (#1012). `(foreach ([i : ty start end]) body)`
;; lowers to the half-open reference loop `i = start; while (i < end) { body;
;; i = i + 1 }`, yielding unit. `start` and `end` are each lowered exactly once
;; before the loop; the index binding is scoped to the body. Mirrors lower-while
;; with an index var, a `<` guard, and a `+ 1` increment.
(define (lower-scalar-foreach-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc index-alloc index-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          index-alloc
          (CompilerIrInstr.Mov index-var start-value index-ty))
        "foreach_header")
        [(LowerLabel header-ls header-label)
          (match (lower-state-fresh-label header-ls "foreach_body")
            [(LowerLabel body-ls body-label)
              (match (lower-state-fresh-label body-ls "foreach_exit")
                [(LowerLabel exit-ls exit-label)
                  (match (lower-state-alloc-var
                    (lower-state-finish-block
                      (lower-state-emit
                        exit-ls
                        (CompilerIrInstr.Jump header-label))
                      header-label))
                    [(LowerAlloc cond-alloc cond-var)
                      (match (lower-expr
                        ctx
                        (lower-state-finish-block
                          (lower-state-emit
                            (lower-state-emit
                              cond-alloc
                              (CompilerIrInstr.BinOp
                                cond-var
                                CompilerIrBinOp.Lt
                                (CompilerIrValue.Var index-var)
                                end-value
                                index-ty))
                            (CompilerIrInstr.Branch
                              (CompilerIrValue.Var cond-var)
                              body-label
                              exit-label))
                          body-label)
                        (sym_i64_env.sym-i64-bind env index index-var)
                        (tc-bind type-env index index-ty)
                        body)
                        [(OkLowerExpr body-lowered)
                          (match body-lowered
                            [(LowerExpr post-body-state _ _)
                              (match (lower-state-alloc-var post-body-state)
                                [(LowerAlloc inc-alloc inc-var)
                                  (OkLowerExpr
                                    (LowerExpr
                                      (lower-state-finish-block
                                        (lower-state-emit
                                          (lower-state-emit
                                            (lower-state-emit
                                              inc-alloc
                                              (CompilerIrInstr.BinOp
                                                inc-var
                                                CompilerIrBinOp.Add
                                                (CompilerIrValue.Var index-var)
                                                (CompilerIrValue.I64 1)
                                                index-ty))
                                            (CompilerIrInstr.Mov
                                              index-var
                                              (CompilerIrValue.Var inc-var)
                                              index-ty))
                                          (CompilerIrInstr.Jump header-label))
                                        exit-label)
                                      CompilerIrValue.Unit
                                      (AstType.Unit)))])])]
                        [(ErrLowerExpr message) (ErrLowerExpr message)])])])])])]))

(define (lower-avx2-foreach-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]
  [plan : LowerMaybeVectorMap]) : ResultLowerExpr
  (match plan
    [(LowerSomeVectorMap dst-array value-plan _ lanes)
      (match (lower-state-alloc-var state)
        [(LowerAlloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov index-var start-value index-ty))]
            [arrays : LowerArrayVarSet
              (lower-array-var-set-add
                (lower-vector-map-value-array-vars value-plan)
                dst-array
                0)]
            [header-label : String ""]
            [body-label : String ""]
            [tail-header-label : String ""]
            [tail-check-label : String ""]
            [tail-mask-label : String ""]
            [tail-body-label : String ""]
            [exit-label : String ""]
            [next-index : CompilerIrValue CompilerIrValue.Unit]
            [vector-ok : CompilerIrValue CompilerIrValue.Unit]
            [tail-cond : CompilerIrValue CompilerIrValue.Unit]
            [tail-safe : CompilerIrValue CompilerIrValue.Unit]
            (begin
              (match (lower-state-fresh-label s "foreach_avx2_header")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "foreach_avx2_body")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "foreach_tail_header")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (match (lower-state-fresh-label s "foreach_tail_check")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-check-label label))])
              (match (lower-state-fresh-label s "foreach_tail_mask")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-mask-label label))])
              (match (lower-state-fresh-label s "foreach_tail_body")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "foreach_exit")
                [(LowerLabel next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (CompilerIrInstr.Jump header-label))
                  header-label))
              (match (lower-emit-binop
                s
                (CompilerIrBinOp.Add)
                (CompilerIrValue.Var index-var)
                (CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! next-index value))])
              (match (lower-avx512-masked-vector-ok
                s
                index-var
                next-index
                end-value
                arrays
                lanes)
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      vector-ok
                      body-label
                      tail-header-label))
                  body-label))
              (set!
                s
                (lower-avx2-vector-map-body ctx s index-var next-index plan))
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (CompilerIrInstr.Jump header-label))
                  tail-header-label))
              (match (lower-emit-binop
                s
                (CompilerIrBinOp.Lt)
                (CompilerIrValue.Var index-var)
                end-value
                (AstType.Bool))
                [(LowerExpr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! tail-cond value))])
              (set!
                s
                (if (lower-mode-avx512? (lower-state-mode s))
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (CompilerIrInstr.Branch
                        tail-cond
                        tail-check-label
                        exit-label))
                    tail-check-label)
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (CompilerIrInstr.Branch
                        tail-cond
                        tail-body-label
                        exit-label))
                    tail-body-label)))
              (if (lower-mode-avx512? (lower-state-mode s))
                (begin
                  (match (lower-avx512-masked-tail-ok
                    s
                    index-var
                    end-value
                    arrays)
                    [(LowerExpr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! tail-safe value))])
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (CompilerIrInstr.Branch
                          tail-safe
                          tail-mask-label
                          tail-body-label))
                      tail-mask-label))
                  (set!
                    s
                    (lower-avx512-tail-map-body ctx s index-var end-value plan))
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit s (CompilerIrInstr.Jump exit-label))
                      tail-body-label)))
                unit)
              (if (and
                (not (lower-mode-avx512? (lower-state-mode s)))
                (lower-maybe-vector-map-needs-scalar-tail? plan))
                (match plan
                  [(LowerSomeVectorMap dst-array value-plan elem-ty _)
                    (lower-avx2-broadcast-tail-map-body
                      ctx
                      s
                      index-var
                      end-value
                      dst-array
                      value-plan
                      elem-ty
                      exit-label)]
                  [LowerNoVectorMap
                    (ErrLowerExpr
                      (box (lower-diagnostic "lower: missing vector map plan")))])
                (match (lower-expr
                  ctx
                  s
                  (sym_i64_env.sym-i64-bind env index index-var)
                  (tc-bind type-env index index-ty)
                  body)
                  [(OkLowerExpr body-lowered)
                    (match body-lowered
                      [(LowerExpr post-body-state _ _)
                        (match (lower-state-alloc-var post-body-state)
                          [(LowerAlloc inc-alloc inc-var)
                            (OkLowerExpr
                              (LowerExpr
                                (lower-state-finish-block
                                  (lower-state-emit
                                    (lower-state-emit
                                      (lower-state-emit
                                        inc-alloc
                                        (CompilerIrInstr.BinOp
                                          inc-var
                                          CompilerIrBinOp.Add
                                          (CompilerIrValue.Var index-var)
                                          (CompilerIrValue.I64 1)
                                          index-ty))
                                      (CompilerIrInstr.Mov
                                        index-var
                                        (CompilerIrValue.Var inc-var)
                                        index-ty))
                                    (CompilerIrInstr.Jump tail-header-label))
                                  exit-label)
                                CompilerIrValue.Unit
                                (AstType.Unit)))])])]
                  [(ErrLowerExpr message) (ErrLowerExpr message)]))))])]
    [LowerNoVectorMap
      (lower-scalar-foreach-lowered
        ctx
        state
        env
        type-env
        index
        index-ty
        start-value
        end-value
        body)]))

(define (lower-foreach-lowered-inlined
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]) : ResultLowerExpr
  (if (and
    (lower-mode-simd? (lower-state-mode state))
    (lower-type-i64? index-ty))
    (match (lower-simple-vector-map
      (lower-state-mode state)
      env
      type-env
      index
      body)
      [(LowerSomeVectorMap _ _ _ _)
        (lower-avx2-foreach-lowered
          ctx
          state
          env
          type-env
          index
          index-ty
          start-value
          end-value
          body
          (lower-simple-vector-map
            (lower-state-mode state)
            env
            type-env
            index
            body))]
      [LowerNoVectorMap
        (if (lower-vector-body-has-atomic-call? ctx type-env body)
          (lower-scalar-foreach-lowered
            ctx
            state
            env
            type-env
            index
            index-ty
            start-value
            end-value
            body)
          (match (lower-masked-vector-map
            (lower-state-mode state)
            env
            type-env
            index
            body)
            [(LowerSomeMaskedVectorMap _)
              (lower-avx512-masked-foreach-lowered
                ctx
                state
                env
                type-env
                index
                index-ty
                start-value
                end-value
                body
                (lower-masked-vector-map
                  (lower-state-mode state)
                  env
                  type-env
                  index
                  body))]
            [LowerNoMaskedVectorMap
              (cond
                [(lower-masked-vector-body-has-varying-while?
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          (lower-avx2-varying-while-diagnostic)
                          "lower: SPMD varying while AVX-512 lowering is not available for this backend mode or loop shape"))))]
                [(lower-masked-vector-body-has-varying-if?
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          (lower-avx2-masked-if-diagnostic)
                          "lower: SPMD masked if AVX-512 lowering is not available for this backend mode or branch shape"))))]
                [(lower-masked-vector-body-has-varying-enum-match?
                    env
                    type-env
                    index
                    body)
                  (if (lower-mode-avx2? (lower-state-mode state))
                    (ErrLowerExpr
                      (box
                        (lower-diagnostic-at-expr
                          body
                          (lower-avx2-varying-match-diagnostic))))
                    (lower-scalar-foreach-lowered
                      ctx
                      state
                      env
                      type-env
                      index
                      index-ty
                      start-value
                      end-value
                      body))]
                [(lower-masked-vector-body-has-varying-match?
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          (lower-avx2-varying-match-diagnostic)
                          "lower: SPMD varying match AVX-512 lowering is not available for this backend mode or match shape"))))]
                [(and
                    (lower-mode-avx2? (lower-state-mode state))
                    (lower-masked-vector-body-has-bool-array-lane?
                      env
                      type-env
                      index
                      body))
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (lower-spmd-bool-lane-diagnostic))))]
                [(lower-vector-body-has-spmd-shuffle? body)
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (lower-spmd-shuffle-diagnostic))))]
                [(lower-vector-body-has-array-read? body)
                  (if (lower-simple-vector-map-has-unsupported-byte-mul?
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                    (ErrLowerExpr
                      (box
                        (lower-diagnostic-at-expr
                          body
                          (lower-spmd-byte-mul-diagnostic))))
                    (ErrLowerExpr
                      (box
                        (lower-diagnostic-at-expr
                          body
                          (lower-simd-foreach-fallback-diagnostic)))))]
                [else
                  (lower-scalar-foreach-lowered
                    ctx
                    state
                    env
                    type-env
                    index
                    index-ty
                    start-value
                    end-value
                    body)])]))])
    (lower-scalar-foreach-lowered
      ctx
      state
      env
      type-env
      index
      index-ty
      start-value
      end-value
      body)))

(define (lower-foreach-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-spmd-inline-expr
    ctx
    env
    type-env
    body
    LowerSpmdInlineSubstNil
    (lower-string-set-insert LowerStringNil index))
    [(OkLowerAstExpr inlined-body)
      (lower-foreach-lowered-inlined
        ctx
        state
        env
        type-env
        index
        index-ty
        start-value
        end-value
        inlined-body)]
    [(ErrLowerAstExpr diag) (ErrLowerExpr diag)]))

(define (lower-foreach
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-expr-expected ctx state env type-env start index-ty start)
    [(OkLowerExpr start-lowered)
      (match start-lowered
        [(LowerExpr start-state start-value _)
          (match (lower-expr-expected
            ctx
            start-state
            env
            type-env
            end
            index-ty
            end)
            [(OkLowerExpr end-lowered)
              (match end-lowered
                [(LowerExpr end-state end-value _)
                  (lower-foreach-lowered
                    ctx
                    end-state
                    env
                    type-env
                    index
                    index-ty
                    start-value
                    end-value
                    body)])]
            [(ErrLowerExpr message) (ErrLowerExpr message)])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

;; Scalar `match` lowering (#568). The scrutinee is lowered once into a fresh
;; local, then literal arms become a chain of `CompilerIrBinOp.Eq` tests + `CompilerIrInstr.Branch`
;; (mirroring `lower-if`). The typechecker guarantees exhaustiveness and arm-type
;; agreement, so the final arm reached must match: it is lowered as an
;; irrefutable catch-all (no test, jump straight to the merge block). A
;; value-typed match merges arm results with an `CompilerIrInstr.Phi`; a `unit`-typed
;; match emits no value phi. Enum matches reuse the same merge path, but load the
;; heap tag once and dispatch variant arms by tag (#517).
(define (lower-match-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env scrutinee)
    [(OkLowerExpr scrut-lowered)
      (match scrut-lowered
        [(LowerExpr scrut-state scrut-value scrut-ty)
          (match (lower-state-alloc-var scrut-state)
            [(LowerAlloc scrut-alloc scrut-var)
              (match (lower-state-fresh-label
                (lower-state-emit
                  scrut-alloc
                  (CompilerIrInstr.Mov scrut-var scrut-value scrut-ty))
                "match_merge")
                [(LowerLabel merge-state merge-label)
                  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
                    [(AstType.Enum _)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        (TcMaybeString.No)
                        false)]
                    [(AstType.EnumArgs _ _)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        (TcMaybeString.No)
                        false)]
                    [(AstType.Ref borrow-lifetime referent-box)
                      (let
                        [referent-ty : AstType
                          (tc-type-strip-region
                            (tc-resolve-type ctx (ty-node-get referent-box)))]
                        (match referent-ty
                          [(AstType.Enum _)
                            (lower-match-enum
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              referent-ty
                              arms
                              merge-label
                              expr-ty
                              (TcMaybeString.Some borrow-lifetime)
                              true)]
                          [(AstType.EnumArgs _ _)
                            (lower-match-enum
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              referent-ty
                              arms
                              merge-label
                              expr-ty
                              (TcMaybeString.Some borrow-lifetime)
                              true)]
                          [_
                            (lower-match-arms
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              scrut-ty
                              arms
                              merge-label
                              expr-ty
                              CompilerIrPhiInputList.Nil)]))]
                    [(AstType.VarArgs _ _)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        (TcMaybeString.No)
                        false)]
                    [_
                      (lower-match-arms
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        CompilerIrPhiInputList.Nil)])])])])]
    [(ErrLowerExpr message) (ErrLowerExpr message)]))

(define (lower-match-borrowed-enum
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [place : AstExpr]
  [borrow-lifetime : String]
  [enum-ty : AstType]
  [arms : AstMatchArmList]
  [expr-ty : AstType]) : ResultLowerExpr
  (let
    [resident : bool (lower-type-register-resident? ctx enum-ty)]
    (match (lower-expr ctx state env type-env place)
      [(OkLowerExpr place-lowered)
        (match place-lowered
          [(LowerExpr place-state place-value _)
            ;; #2386: the borrowed payload bindings and literal compares below
            ;; address the scrutinee as MEMORY (gep off the pointer). A
            ;; register-resident enum place lowers to its packed word(s), so
            ;; spill it to a temp inline slot and run the whole match on the
            ;; slot address (force-memory). The Mov is typed U64 in that case:
            ;; the var holds an address, not a register group.
            (match (if resident
              (lower-copy-inline-aggregate-to-inline
                ctx
                place-state
                place-value
                enum-ty)
              (OkLowerExpr (LowerExpr place-state place-value enum-ty)))
              [(OkLowerExpr scrut-expr)
                (match scrut-expr
                  [(LowerExpr scrut-state scrut-value _)
                    (match (lower-state-alloc-var scrut-state)
                      [(LowerAlloc scrut-alloc scrut-var)
                        (match (lower-state-fresh-label
                          (lower-state-emit
                            scrut-alloc
                            (CompilerIrInstr.Mov
                              scrut-var
                              scrut-value
                              (if resident
                                (AstType.U64)
                                enum-ty)))
                          "match_merge")
                          [(LowerLabel merge-state merge-label)
                            (lower-match-enum
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              enum-ty
                              arms
                              merge-label
                              expr-ty
                              (TcMaybeString.Some borrow-lifetime)
                              resident)])])])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])])]
      [(ErrLowerExpr message) (ErrLowerExpr message)])))

(define (lower-match
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (ast-expr-unspan scrutinee)
    [(AstExpr.Borrow mutable _ place-box)
      (if mutable
        (lower-match-value ctx state env type-env scrutinee arms expr-ty)
        (let
          [place : AstExpr (ast-node-get place-box)]
          (match (tc-expr ctx type-env scrutinee)
            [(ResultTcType.Ok scrut-ty)
              (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
                [(AstType.Ref borrow-lifetime referent-box)
                  (let
                    [referent-ty : AstType
                      (tc-type-strip-region
                        (tc-resolve-type ctx (ty-node-get referent-box)))]
                    (match referent-ty
                      [(AstType.Enum _)
                        (lower-match-borrowed-enum
                          ctx
                          state
                          env
                          type-env
                          place
                          borrow-lifetime
                          referent-ty
                          arms
                          expr-ty)]
                      [(AstType.EnumArgs _ _)
                        (lower-match-borrowed-enum
                          ctx
                          state
                          env
                          type-env
                          place
                          borrow-lifetime
                          referent-ty
                          arms
                          expr-ty)]
                      [_
                        (lower-match-value
                          ctx
                          state
                          env
                          type-env
                          scrutinee
                          arms
                          expr-ty)]))]
                [_
                  (lower-match-value
                    ctx
                    state
                    env
                    type-env
                    scrutinee
                    arms
                    expr-ty)])]
            [(ResultTcType.Err message)
              (ErrLowerExpr (box (lower-diagnostic-at-expr scrutinee message)))])))]
    [_ (lower-match-value ctx state env type-env scrutinee arms expr-ty)]))

(define (lower-match-enum
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeString]
  [force-memory : bool]) : ResultLowerExpr
  ;; #2386: a 1-word register-resident enum value IS the tag word (nullary, no
  ;; payload); match on `scrut-var` directly. A 2-word register-group enum holds
  ;; the tag in word0; extract it with IrInstrWord. Neither touches memory. One
  ;; layout build (lower-type-register-words) decides all three cases.
  ;; `force-memory` (borrowed match of a spilled register-resident scrutinee)
  ;; overrides the value paths: scrut-var then holds the ADDRESS of the enum
  ;; bytes and tag/payloads are read through it like any memory enum.
  (let
    [scrut-words : i64 (lower-type-register-words ctx scrut-ty)]
    (if (and (> scrut-words 0) (not force-memory))
      (if (= scrut-words 2)
        (match (lower-emit-word
          state
          (CompilerIrValue.Var scrut-var)
          0
          (AstType.I64))
          [(LowerExpr tag-state tag-value _)
            (match tag-value
              [(CompilerIrValue.Var tag-var)
                (lower-match-enum-arms
                  ctx
                  tag-state
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  arms
                  merge-label
                  expr-ty
                  borrow-lifetime
                  CompilerIrPhiInputList.Nil
                  true)]
              [_
                (ErrLowerExpr
                  (box
                    (lower-diagnostic "lower: internal enum tag extract failed")))])])
        (lower-match-enum-arms
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          scrut-var
          arms
          merge-label
          expr-ty
          borrow-lifetime
          CompilerIrPhiInputList.Nil
          false))
      (match (lower-load-at-offset
        state
        (CompilerIrValue.Var scrut-var)
        0
        (AstType.I64))
        [(LowerExpr tag-state tag-value _)
          (match tag-value
            [(CompilerIrValue.Var tag-var)
              (lower-match-enum-arms
                ctx
                tag-state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arms
                merge-label
                expr-ty
                borrow-lifetime
                CompilerIrPhiInputList.Nil
                false)]
            [_
              (ErrLowerExpr
                (box (lower-diagnostic "lower: internal enum tag load failed")))])]))))

(define (lower-box-pattern-for-type?
  [ctx : TcContext]
  [scrut-ty : AstType]
  [name : i64]) : bool
  (if (lower-box-pattern-name? name)
    (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
      [(AstType.Box _) true]
      [_ false])
    false))

(define (lower-struct-pattern-for-type?
  [ctx : TcContext]
  [scrut-ty : AstType]
  [name : i64]) : bool
  (let
    [pattern-name : String (intern-str name)]
    (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
      [(AstType.Struct struct-name)
        (tc-struct-pattern-name-matches?
          ctx
          (intern-str struct-name)
          pattern-name)]
      [(AstType.StructArgs struct-name _)
        (tc-struct-pattern-name-matches?
          ctx
          (intern-str struct-name)
          pattern-name)]
      [_ false])))

(define (lower-bind-struct-field-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [struct-name : String]
  [field-name : String]
  [pattern : AstPattern]
  [field-ty : AstType]) : ResultLowerEnv
  (match pattern
    [(AstPattern.Wildcard) (OkLowerEnv state env type-env)]
    [(AstPattern.Var name _)
      (match (lower-struct-get-named
        ctx
        state
        base
        struct-name
        field-name
        field-ty)
        [(OkLowerExpr lowered)
          (match lowered
            [(LowerExpr field-state field-value _)
              (match field-value
                [(CompilerIrValue.Var field-var)
                  (OkLowerEnv
                    field-state
                    (sym_i64_env.sym-i64-bind-id env name field-var)
                    (tc-bind-id type-env name field-ty))]
                [_
                  (ErrLowerEnv
                    (box
                      (lower-diagnostic
                        "lower: internal struct field pattern load failed")))])])]
        [(ErrLowerExpr message) (ErrLowerEnv message)])]
    [(AstPattern.Binding name)
      (match (lower-struct-get-named
        ctx
        state
        base
        struct-name
        field-name
        field-ty)
        [(OkLowerExpr lowered)
          (match lowered
            [(LowerExpr field-state field-value _)
              (match field-value
                [(CompilerIrValue.Var field-var)
                  (OkLowerEnv
                    field-state
                    (sym_i64_env.sym-i64-bind-id env name field-var)
                    (tc-bind-id type-env name field-ty))]
                [_
                  (ErrLowerEnv
                    (box
                      (lower-diagnostic
                        "lower: internal struct field pattern load failed")))])])]
        [(ErrLowerExpr message) (ErrLowerEnv message)])]
    [(AstPattern.Variant name args-box)
      (if (lower-struct-pattern-for-type? ctx field-ty name)
        (match (lower-struct-get-named
          ctx
          state
          base
          struct-name
          field-name
          field-ty)
          [(OkLowerExpr lowered)
            (match lowered
              [(LowerExpr field-state field-value _)
                (lower-bind-struct-pattern
                  ctx
                  field-state
                  env
                  type-env
                  field-value
                  field-ty
                  (lower-struct-type-name-or-empty
                    (tc-type-strip-region (tc-resolve-type ctx field-ty)))
                  (box-get args-box))])]
          [(ErrLowerExpr message) (ErrLowerEnv message)])
        (ErrLowerEnv
          (box (lower-diagnostic "lower: unsupported struct field pattern"))))]
    [_
      (ErrLowerEnv
        (box (lower-diagnostic "lower: unsupported struct field pattern")))]))

(define (lower-bind-struct-pattern-fields
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [struct-name : String]
  [patterns : AstPatternList]
  [fields : AstFieldDefList]
  [types : AstTypeList]) : ResultLowerEnv
  (match patterns
    [(AstPatternList.Nil)
      (match types
        [(AstTypeList.Nil) (OkLowerEnv state env type-env)]
        [_
          (ErrLowerEnv
            (box (lower-diagnostic "lower: struct pattern arity mismatch")))])]
    [(AstPatternList.Cons pattern rest-patterns)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest-patterns : AstPatternList (box-get rest-patterns)]
        (match fields
          [(AstFieldDefList.Cons field rest-fields)
            (let
              [rest-fields : AstFieldDefList (box-get rest-fields)]
              (match field
                [(AstFieldDef.Def field-name _ _)
                  (match types
                    [(AstTypeList.Cons ty rest-types)
                      (let
                        [ty : AstType (ty-node-get ty)]
                        [rest-types : AstTypeList (box-get rest-types)]
                        (match (lower-bind-struct-field-pattern
                          ctx
                          state
                          env
                          type-env
                          base
                          struct-name
                          (intern-str field-name)
                          pattern
                          ty)
                          [(OkLowerEnv next-state next-env next-type-env)
                            (lower-bind-struct-pattern-fields
                              ctx
                              next-state
                              next-env
                              next-type-env
                              base
                              struct-name
                              rest-patterns
                              rest-fields
                              rest-types)]
                          [(ErrLowerEnv message) (ErrLowerEnv message)]))]
                    [(AstTypeList.Nil)
                      (ErrLowerEnv
                        (box
                          (lower-diagnostic
                            "lower: struct pattern arity mismatch")))])]))]
          [(AstFieldDefList.Nil)
            (ErrLowerEnv
              (box (lower-diagnostic "lower: struct pattern arity mismatch")))]))]))

(define (lower-bind-struct-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [scrut-ty : AstType]
  [struct-name : String]
  [args : AstPatternList]) : ResultLowerEnv
  (match (lower-struct-fields ctx struct-name)
    [(ResultAstFieldDefList.Ok fields)
      (match (tc-struct-pattern-field-types-for-scrut
        ctx
        struct-name
        scrut-ty
        fields)
        [(ResultTcTypeList.Ok field-types)
          (lower-bind-struct-pattern-fields
            ctx
            state
            env
            type-env
            base
            struct-name
            args
            fields
            field-types)]
        [(ResultTcTypeList.Err message)
          (ErrLowerEnv (box (lower-diagnostic message)))])]
    [(ResultAstFieldDefList.Err message)
      (ErrLowerEnv (box (lower-diagnostic message)))]))

(define (lower-bind-match-catch-all-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : ResultLowerEnv
  (match pattern
    [(AstPattern.Binding name)
      (OkLowerEnv
        state
        (sym_i64_env.sym-i64-bind-id env name scrut-var)
        (tc-bind-id type-env name scrut-ty))]
    [(AstPattern.Variant name args-box)
      (if (lower-box-pattern-for-type? ctx scrut-ty name)
        (lower-bind-box-pattern
          ctx
          state
          env
          type-env
          (CompilerIrValue.Var scrut-var)
          scrut-ty
          (box-get args-box))
        (if (lower-struct-pattern-for-type? ctx scrut-ty name)
          (lower-bind-struct-pattern
            ctx
            state
            env
            type-env
            (CompilerIrValue.Var scrut-var)
            scrut-ty
            (lower-struct-type-name-or-empty
              (tc-type-strip-region (tc-resolve-type ctx scrut-ty)))
            (box-get args-box))
          (ErrLowerEnv
            (box (lower-diagnostic "lower: unsupported match pattern")))))]
    [_ (OkLowerEnv state env type-env)]))

(define (lower-match-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [phi-inputs : CompilerIrPhiInputList]) : ResultLowerExpr
  (match arms
    [(AstMatchArmList.Nil)
      (ErrLowerExpr (box (lower-diagnostic "lower: match with no arms")))]
    [(AstMatchArmList.Cons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match rest
          [(AstMatchArmList.Nil)
            (lower-match-catch-all
              ctx
              state
              env
              type-env
              scrut-var
              scrut-ty
              arm
              merge-label
              expr-ty
              phi-inputs)]
          [_
            (match arm
              [(AstMatchArm.Arm pat body-box)
                (let
                  [body : AstExpr (ast-node-get body-box)]
                  (match pat
                    [(AstPattern.Literal lit)
                      (lower-match-literal-arm
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        lit
                        body
                        rest
                        merge-label
                        expr-ty
                        phi-inputs)]
                    [(AstPattern.Binding _)
                      (lower-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        merge-label
                        expr-ty
                        phi-inputs)]
                    [(AstPattern.Wildcard)
                      (lower-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        merge-label
                        expr-ty
                        phi-inputs)]
                    [(AstPattern.Variant variant-name _)
                      (if (lower-box-pattern-for-type?
                        ctx
                        scrut-ty
                        variant-name)
                        (lower-match-catch-all
                          ctx
                          state
                          env
                          type-env
                          scrut-var
                          scrut-ty
                          arm
                          merge-label
                          expr-ty
                          phi-inputs)
                        (if (lower-struct-pattern-for-type?
                          ctx
                          scrut-ty
                          variant-name)
                          (lower-match-catch-all
                            ctx
                            state
                            env
                            type-env
                            scrut-var
                            scrut-ty
                            arm
                            merge-label
                            expr-ty
                            phi-inputs)
                          (ErrLowerExpr
                            (box
                              (lower-diagnostic
                                (lower-unsupported-match-pattern-message
                                  ctx
                                  scrut-ty
                                  (intern-str variant-name)))))))]
                    [_
                      (ErrLowerExpr
                        (box
                          (lower-diagnostic "lower: unsupported match pattern")))]))])]))]))

(define (lower-match-enum-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [arms : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeString]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match arms
    [(AstMatchArmList.Nil)
      (ErrLowerExpr (box (lower-diagnostic "lower: match with no arms")))]
    [(AstMatchArmList.Cons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm.Arm pat body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match rest
                [(AstMatchArmList.Nil)
                  (match pat
                    [(AstPattern.Wildcard)
                      (lower-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        merge-label
                        expr-ty
                        phi-inputs)]
                    [(AstPattern.Binding variant-name)
                      (lower-match-variant-final
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        (intern-str variant-name)
                        AstPatternList.Nil
                        body
                        merge-label
                        expr-ty
                        borrow-lifetime
                        phi-inputs
                        scrut-reg-group?)]
                    [(AstPattern.Variant variant-name args-box)
                      (let
                        [args : AstPatternList (box-get args-box)]
                        (lower-match-variant-final
                          ctx
                          state
                          env
                          type-env
                          scrut-var
                          scrut-ty
                          (intern-str variant-name)
                          args
                          body
                          merge-label
                          expr-ty
                          borrow-lifetime
                          phi-inputs
                          scrut-reg-group?))]
                    [_
                      (ErrLowerExpr
                        (box
                          (lower-diagnostic
                            "lower: unsupported enum match pattern")))])]
                [_
                  (match pat
                    [(AstPattern.Wildcard)
                      (lower-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        merge-label
                        expr-ty
                        phi-inputs)]
                    [(AstPattern.Binding variant-name)
                      (lower-match-variant-arm
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        tag-var
                        (intern-str variant-name)
                        AstPatternList.Nil
                        body
                        rest
                        merge-label
                        expr-ty
                        borrow-lifetime
                        phi-inputs
                        scrut-reg-group?)]
                    [(AstPattern.Variant variant-name args-box)
                      (let
                        [args : AstPatternList (box-get args-box)]
                        (lower-match-variant-arm
                          ctx
                          state
                          env
                          type-env
                          scrut-var
                          scrut-ty
                          tag-var
                          (intern-str variant-name)
                          args
                          body
                          rest
                          merge-label
                          expr-ty
                          borrow-lifetime
                          phi-inputs
                          scrut-reg-group?))]
                    [_
                      (ErrLowerExpr
                        (box
                          (lower-diagnostic
                            "lower: unsupported enum match pattern")))])]))]))]))

(define (lower-match-variant-final
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [variant-name : String]
  [args : AstPatternList]
  [body : AstExpr]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeString]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match ctx
    [(TcContext _ symbols registries _ _)
      (let
        [resolved-scrut-ty : AstType
          (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
        [lookup-name : String
          (lower-variant-lookup-name-for-scrut
            ctx
            resolved-scrut-ty
            variant-name)]
        [handle : i64
          (compiler-registries-lookup-variant-or
            registries
            lookup-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-registries-variant-fields-indexed symbols handle)
            [(ResultAstTypeList.Ok fields)
              (let
                [resolved-fields : AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    resolved-scrut-ty
                    fields)]
                ;; The final arm has no next-arm continuation, so a refutable
                ;; payload subpattern here would have nowhere to fall through to;
                ;; require a trailing catch-all instead (#651).
                (if (lower-pattern-list-refutable-for-types?
                  ctx
                  args
                  resolved-fields)
                  (ErrLowerExpr
                    (box
                      (lower-diagnostic
                        "lower: refutable payload pattern in final match arm requires a trailing catch-all")))
                  (match (lower-bind-match-variant-payloads
                    ctx
                    state
                    env
                    type-env
                    borrow-lifetime
                    (CompilerIrValue.Var scrut-var)
                    args
                    resolved-fields
                    (lower-state-mode state)
                    (lower-enum-type-name-or-empty resolved-scrut-ty)
                    variant-name
                    0
                    8
                    merge-label
                    scrut-reg-group?)
                    [(OkLowerEnv body-start body-env body-type-env)
                      (match (lower-expr-expected
                        ctx
                        body-start
                        body-env
                        body-type-env
                        body
                        expr-ty
                        body)
                        [(OkLowerExpr body-lowered)
                          (match body-lowered
                            [(LowerExpr body-state body-value body-ty)
                              (let
                                [body-end-label : String
                                  (lower-state-current-label body-state)]
                                (if (tc-never-type? body-ty)
                                  (lower-match-finish
                                    ctx
                                    body-state
                                    merge-label
                                    expr-ty
                                    phi-inputs)
                                  (lower-match-finish
                                    ctx
                                    (lower-state-emit
                                      body-state
                                      (CompilerIrInstr.Jump merge-label))
                                    merge-label
                                    expr-ty
                                    (compiler-ir-phi-input-cons
                                      body-value
                                      body-end-label
                                      phi-inputs))))])]
                        [(ErrLowerExpr message) (ErrLowerExpr message)])]
                    [(ErrLowerEnv message) (ErrLowerExpr message)])))]
            [(ResultAstTypeList.Err message)
              (ErrLowerExpr (box (lower-diagnostic message)))])
          (ErrLowerExpr
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))))]))

(define (lower-match-variant-body
  [ctx : TcContext]
  [body-start : LowerState]
  [next-label : String]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [variant-name : String]
  [fields : AstTypeList]
  [args : AstPatternList]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeString]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match (lower-bind-match-variant-payloads
    ctx
    body-start
    env
    type-env
    borrow-lifetime
    (CompilerIrValue.Var scrut-var)
    args
    fields
    (lower-state-mode body-start)
    (lower-enum-type-name-or-empty scrut-ty)
    variant-name
    0
    8
    next-label
    scrut-reg-group?)
    [(OkLowerEnv bound-state body-env body-type-env)
      (match (lower-expr-expected
        ctx
        bound-state
        body-env
        body-type-env
        body
        expr-ty
        body)
        [(OkLowerExpr body-lowered)
          (match body-lowered
            [(LowerExpr body-state body-value body-ty)
              (let
                [body-end-label : String (lower-state-current-label body-state)]
                (lower-match-enum-arms
                  ctx
                  (if (tc-never-type? body-ty)
                    (lower-state-finish-block body-state next-label)
                    (lower-state-finish-block
                      (lower-state-emit
                        body-state
                        (CompilerIrInstr.Jump merge-label))
                      next-label))
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  rest
                  merge-label
                  expr-ty
                  borrow-lifetime
                  (if (tc-never-type? body-ty)
                    phi-inputs
                    (compiler-ir-phi-input-cons
                      body-value
                      body-end-label
                      phi-inputs))
                  scrut-reg-group?))])]
        [(ErrLowerExpr message) (ErrLowerExpr message)])]
    [(ErrLowerEnv message) (ErrLowerExpr message)]))

(define (lower-match-variant-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [variant-name : String]
  [args : AstPatternList]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeString]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match ctx
    [(TcContext _ symbols registries _ _)
      (let
        [resolved-scrut-ty : AstType
          (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
        [lookup-name : String
          (lower-variant-lookup-name-for-scrut
            ctx
            resolved-scrut-ty
            variant-name)]
        [handle : i64
          (compiler-registries-lookup-variant-or
            registries
            lookup-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-registries-variant-fields-indexed symbols handle)
            [(ResultAstTypeList.Ok fields)
              (let
                [resolved-fields : AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    resolved-scrut-ty
                    fields)]
                (match (lower-state-alloc-var state)
                  [(LowerAlloc eq-alloc eq-var)
                    (let
                      [eq-state : LowerState
                        (lower-state-emit
                          eq-alloc
                          (CompilerIrInstr.BinOp
                            eq-var
                            CompilerIrBinOp.Eq
                            (CompilerIrValue.Var tag-var)
                            (CompilerIrValue.I64
                              (compiler-registry-handle-child-index handle))
                            (AstType.I64)))]
                      (match (lower-state-fresh-label eq-state "match_arm")
                        [(LowerLabel body-label-state body-label)
                          (match (lower-state-fresh-label
                            body-label-state
                            "match_next")
                            [(LowerLabel next-label-state next-label)
                              (let
                                [body-start : LowerState
                                  (lower-state-finish-block
                                    (lower-state-emit
                                      next-label-state
                                      (CompilerIrInstr.Branch
                                        (CompilerIrValue.Var eq-var)
                                        body-label
                                        next-label))
                                    body-label)]
                                (lower-match-variant-body
                                  ctx
                                  body-start
                                  next-label
                                  env
                                  type-env
                                  scrut-var
                                  scrut-ty
                                  tag-var
                                  variant-name
                                  resolved-fields
                                  args
                                  body
                                  rest
                                  merge-label
                                  expr-ty
                                  borrow-lifetime
                                  phi-inputs
                                  scrut-reg-group?))])]))]))]
            [(ResultAstTypeList.Err message)
              (ErrLowerExpr (box (lower-diagnostic message)))])
          (ErrLowerExpr
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))))]))

(define (lower-match-literal-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [lit : AstLiteral]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [phi-inputs : CompilerIrPhiInputList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc eq-alloc eq-var)
      (let
        [eq-state : LowerState
          (lower-state-emit
            eq-alloc
            (CompilerIrInstr.BinOp
              eq-var
              CompilerIrBinOp.Eq
              (CompilerIrValue.Var scrut-var)
              (lower-literal-value-with-type lit scrut-ty)
              scrut-ty))]
        (match (lower-state-fresh-label eq-state "match_arm")
          [(LowerLabel body-label-state body-label)
            (match (lower-state-fresh-label body-label-state "match_next")
              [(LowerLabel next-label-state next-label)
                (let
                  [body-start : LowerState
                    (lower-state-finish-block
                      (lower-state-emit
                        next-label-state
                        (CompilerIrInstr.Branch
                          (CompilerIrValue.Var eq-var)
                          body-label
                          next-label))
                      body-label)]
                  (match (lower-expr-expected
                    ctx
                    body-start
                    env
                    type-env
                    body
                    expr-ty
                    body)
                    [(OkLowerExpr body-lowered)
                      (match body-lowered
                        [(LowerExpr body-state body-value body-ty)
                          (let
                            [body-end-label : String
                              (lower-state-current-label body-state)]
                            (lower-match-arms
                              ctx
                              (if (tc-never-type? body-ty)
                                (lower-state-finish-block body-state next-label)
                                (lower-state-finish-block
                                  (lower-state-emit
                                    body-state
                                    (CompilerIrInstr.Jump merge-label))
                                  next-label))
                              env
                              type-env
                              scrut-var
                              scrut-ty
                              rest
                              merge-label
                              expr-ty
                              (if (tc-never-type? body-ty)
                                phi-inputs
                                (compiler-ir-phi-input-cons
                                  body-value
                                  body-end-label
                                  phi-inputs))))])]
                    [(ErrLowerExpr message) (ErrLowerExpr message)]))])]))]))

(define (lower-match-catch-all
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arm : AstMatchArm]
  [merge-label : String]
  [expr-ty : AstType]
  [phi-inputs : CompilerIrPhiInputList]) : ResultLowerExpr
  (match arm
    [(AstMatchArm.Arm pat body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (lower-bind-match-catch-all-pattern
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          pat)
          [(OkLowerEnv body-start body-env body-type-env)
            (match (lower-expr-expected
              ctx
              body-start
              body-env
              body-type-env
              body
              expr-ty
              body)
              [(OkLowerExpr body-lowered)
                (match body-lowered
                  [(LowerExpr body-state body-value body-ty)
                    (let
                      [body-end-label : String
                        (lower-state-current-label body-state)]
                      (if (tc-never-type? body-ty)
                        (lower-match-finish
                          ctx
                          body-state
                          merge-label
                          expr-ty
                          phi-inputs)
                        (lower-match-finish
                          ctx
                          (lower-state-emit
                            body-state
                            (CompilerIrInstr.Jump merge-label))
                          merge-label
                          expr-ty
                          (compiler-ir-phi-input-cons
                            body-value
                            body-end-label
                            phi-inputs))))])]
              [(ErrLowerExpr message) (ErrLowerExpr message)])]
          [(ErrLowerEnv message) (ErrLowerExpr message)]))]))

(define (lower-phi-input-list-empty? [phi-inputs : CompilerIrPhiInputList]) : bool
  (match phi-inputs
    [(CompilerIrPhiInputList.Nil) true]
    [_ false]))

(define (lower-match-finish
  [ctx : TcContext]
  [state : LowerState]
  [merge-label : String]
  [expr-ty : AstType]
  [phi-inputs : CompilerIrPhiInputList]) : ResultLowerExpr
  (let
    [merge-start : LowerState (lower-state-finish-block state merge-label)]
    [expr-ir-ty : AstType (lower-one-word-register-storage-type ctx expr-ty)]
    (if (lower-phi-input-list-empty? phi-inputs)
      (OkLowerExpr (LowerExpr merge-start CompilerIrValue.Unit (AstType.Never)))
      (match expr-ty
        [(AstType.Unit)
          (OkLowerExpr (LowerExpr merge-start CompilerIrValue.Unit expr-ty))]
        [_
          (match (lower-state-alloc-var merge-start)
            [(LowerAlloc allocated var-id)
              (OkLowerExpr
                (LowerExpr
                  (lower-state-emit
                    allocated
                    (CompilerIrInstr.Phi var-id phi-inputs expr-ir-ty))
                  (CompilerIrValue.Var var-id)
                  expr-ty))])]))))

(define (lower-tail-call-var-unshadowed?
  [env : sym_i64_env.SymI64Env]
  [name : i64]) : bool
  (not (sym_i64_env.sym-i64-contains-id env name)))

(define (lower-tail-call-local-indirect-safe?
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]) : bool
  (if (sym_i64_env.sym-i64-contains-id env name)
    (not (lower-type-env-contains-reference? type-env))
    true))

(define (lower-tail-call-reference-capturing-lambda?
  [type-env : TcTypeEnv]
  [callee : AstExpr]) : bool
  (match (ast-expr-unspan callee)
    [(AstExpr.Ann inner-box _)
      (lower-tail-call-reference-capturing-lambda?
        type-env
        (ast-node-get inner-box))]
    [(AstExpr.Cast inner-box _)
      (lower-tail-call-reference-capturing-lambda?
        type-env
        (ast-node-get inner-box))]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-lambda-captures-reference? type-env params body))])]
    [_ false]))

(define (lower-tail-call-target?
  [_state : LowerState]
  [_env : sym_i64_env.SymI64Env]
  [_callee : AstExpr]) : bool
  true)

(define (lower-tail-call-self-target? [state : LowerState] [name : i64]) : bool
  (string.eq
    (lower-resolve-name state (intern-str name))
    (lower-state-current-function state)))

(define (lower-symbol-function-define? [ctx : TcContext] [name : String]) : bool
  (let
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [handle : i64 (lower-symbols-lookup-value-hygiene symbols name)]
    (if (compiler-symbols-handle-found? handle)
      (=
        (compiler-symbol-handle-kind handle)
        (compiler-symbol-kind-function-define))
      false)))

(define (lower-tail-call-compatible-return?
  [ctx : TcContext]
  [callee-ret : AstType]
  [ret-ty : AstType]) : bool
  (tc-type-eq
    (tc-type-without-regions (tc-resolve-type ctx callee-ret))
    (tc-type-without-regions (tc-resolve-type ctx ret-ty))))

(define (lower-tail-call-direct-supported?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]
  [ret-ty : AstType]) : bool
  (if (and
    ;; Direct aggregate tail calls also forward the current sret slot. A callee
    ;; early-exit path may return a heap aggregate pointer instead of filling it.
    (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty)
    (lower-rvo-callee-has-early-return? state env (intern-str name)))
    false
    (if (lower-tail-call-self-target? state name)
      true
      (let
        [source-name : String (intern-str name)]
        (if (lower-symbol-function-define? ctx source-name)
          (match (lower-lookup-type-id
            ctx
            (lower-state-type-cache state)
            env
            type-env
            name)
            [(ResultTcType.Ok fn-ty)
              (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
                [(AstType.Func param-types callee-ret)
                  (lower-tail-call-compatible-return?
                    ctx
                    (tc-context-type-get ctx callee-ret)
                    ret-ty)]
                [_ false])]
            [(ResultTcType.Err _) false])
          false)))))

(define (lower-tail-call-args-for-target
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]
  [args : AstExprList]) : ResultLowerArgs
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(ResultTcType.Ok fn-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
        [(AstType.Func param-types _)
          (lower-args-as
            ctx
            state
            env
            type-env
            args
            (tc-resolve-type-list ctx (box-get param-types)))]
        [_ (lower-args ctx state env type-env args)])]
    [(ResultTcType.Err _) (lower-args ctx state env type-env args)]))

(define (lower-tail-call-indirect-supported?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func-ty : AstType]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]) : bool
  (if (lower-tail-call-inline-aggregate-risk?
    ctx
    state
    env
    type-env
    args
    ret-ty
    sret-var)
    false
    (match (tc-type-strip-region (tc-resolve-type ctx func-ty))
      [(AstType.Func _ callee-ret)
        (lower-tail-call-compatible-return?
          ctx
          (tc-context-type-get ctx callee-ret)
          ret-ty)]
      [_ false])))

(define (lower-tail-call-indirect-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [callee : AstExpr]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (match (tc-expr ctx type-env callee)
    [(ResultTcType.Ok func-ty)
      (if (lower-tail-call-indirect-supported?
        ctx
        state
        env
        type-env
        func-ty
        args
        ret-ty
        sret-var)
        (match (lower-expr ctx state env type-env callee)
          [(OkLowerExpr lowered-func)
            (match lowered-func
              [(LowerExpr func-state func-value lowered-func-ty)
                (match (lower-indirect-call-args
                  ctx
                  func-state
                  env
                  type-env
                  args
                  lowered-func-ty)
                  [(OkLowerArgs args-state values)
                    (match (lower-tail-call-append-current-sret-arg
                      ctx
                      args-state
                      values
                      ret-ty
                      sret-var)
                      [(OkLowerArgs tail-state tail-values)
                        (OkLowerState
                          (lower-state-emit-at-expr
                            tail-state
                            (CompilerIrInstr.TailCallIndirect
                              func-value
                              (compiler-ir-call-args-from-list tail-values)
                              (lower-one-word-register-storage-type ctx ret-ty))
                            origin))]
                      [(ErrLowerArgs message) (ErrLowerState message)])]
                  [(ErrLowerArgs message) (ErrLowerState message)])])]
          [(ErrLowerExpr message) (ErrLowerState message)])
        (lower-return-expr ctx state env type-env origin ret-ty sret-var))]
    [(ResultTcType.Err message)
      (ErrLowerState (box (lower-diagnostic-at-expr callee message)))]))

(define (lower-tail-let-bindings-candidate-env
  [env : sym_i64_env.SymI64Env]
  [bindings : AstLetBindingList]) : sym_i64_env.SymI64Env
  (match bindings
    [(AstLetBindingList.Nil) env]
    [(AstLetBindingList.Cons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding.Binding name _ _)
            (lower-tail-let-bindings-candidate-env
              (sym_i64_env.sym-i64-bind-id env name 0)
              rest)]))]))

(define (lower-tail-begin-candidate?
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprList.Nil) (lower-tail-expr-candidate? state env expr)]
          [_ (lower-tail-begin-candidate? state env rest)]))]))

(define (lower-tail-match-arms-candidate?
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmList.Nil) false]
    [(AstMatchArmList.Cons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm.Arm pat body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              [body-env : sym_i64_env.SymI64Env
                (match pat
                  [(AstPattern.Binding name)
                    (sym_i64_env.sym-i64-bind-id env name 0)]
                  [_ env])]
              (if (lower-tail-expr-candidate? state body-env body)
                true
                (lower-tail-match-arms-candidate? state env rest)))]))]))

(define (lower-tail-expr-candidate?
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-tail-expr-candidate? state env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-tail-expr-candidate? state env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-tail-expr-candidate? state env inner))]
    [(AstExpr.Call callee-box _)
      (let
        [callee : AstExpr (ast-node-get callee-box)]
        (lower-tail-call-target? state env callee))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (lower-tail-expr-candidate?
              state
              (lower-tail-let-bindings-candidate-env env bindings)
              body))])]
    [(AstExpr.Begin exprs) (lower-tail-begin-candidate? state env exprs)]
    [(AstExpr.Unsafe exprs) (lower-tail-begin-candidate? state env exprs)]
    [(AstExpr.If _ then-branch-box else-branch-box)
      (let
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (if (lower-tail-expr-candidate? state env then-branch)
          true
          (lower-tail-expr-candidate? state env else-branch)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match _ arms)
          (lower-tail-match-arms-candidate? state env arms)])]
    [_ false]))

;; #1867 sret return ABI (Phase 1): when `sret-var` >= 0 the caller passed a
;; hidden result-slot pointer (bound to that var). Copy the result aggregate
;; into the caller's slot and return the slot pointer -- no per-return arena
;; alloc + escape copy. `sret-var` < 0 keeps the arena escape-copy path, which
;; is always correct (every call site uses the call's return value), so a
;; non-threaded return path simply stays unoptimized rather than incorrect.
(define (lower-return-expr-to-sret
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-inline-aggregate-copy-size ctx ret-ty)
    [(OkLowerSize size)
      (OkLowerState
        (lower-state-emit
          (lower-copy-bytes state (CompilerIrValue.Var sret-var) 0 value 0 size)
          (CompilerIrInstr.Return
            (lower-return-maybe (CompilerIrValue.Var sret-var) ret-ty))))]
    [(ErrLowerSize message) (ErrLowerState (box (lower-diagnostic message)))]))

(define (lower-return-expr-generic
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-expr-expected ctx state env type-env expr ret-ty expr)
    [(OkLowerExpr lowered)
      (match lowered
        [(LowerExpr body-state value expr-ty)
          (if (tc-never-type? expr-ty)
            (OkLowerState body-state)
            (if (>= sret-var 0)
              (lower-return-expr-to-sret ctx body-state value ret-ty sret-var)
              (match (lower-return-abi-value ctx body-state value ret-ty)
                [(OkLowerExpr return-copy)
                  (match return-copy
                    [(LowerExpr return-state return-value _)
                      (OkLowerState
                        (lower-state-emit
                          return-state
                          (CompilerIrInstr.Return
                            (lower-return-maybe return-value ret-ty))))])]
                [(ErrLowerExpr message) (ErrLowerState message)])))])]
    [(ErrLowerExpr message) (ErrLowerState message)]))

(define (lower-return-sret
  [state : LowerState]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (OkLowerState
    (lower-state-emit
      state
      (CompilerIrInstr.Return
        (lower-return-maybe (CompilerIrValue.Var sret-var) ret-ty)))))

(define (lower-rvo-node-has-early-return? [id : i64]) : bool
  (lower-rvo-expr-has-early-return? (ast-node-get id)))

(define (lower-rvo-expr-list-has-early-return? [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons head rest)
      (or
        (lower-rvo-node-has-early-return? head)
        (lower-rvo-expr-list-has-early-return? (box-get rest)))]))

(define (lower-rvo-let-bindings-have-early-return?
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (or
        (match binding
          [(AstLetBinding.Binding _ _ init-box)
            (lower-rvo-node-has-early-return? init-box)])
        (lower-rvo-let-bindings-have-early-return? (box-get rest)))]))

(define (lower-rvo-match-arms-have-early-return? [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmList.Nil) false]
    [(AstMatchArmList.Cons arm rest)
      (or
        (match arm
          [(AstMatchArm.Arm _ body-box)
            (lower-rvo-node-has-early-return? body-box)])
        (lower-rvo-match-arms-have-early-return? (box-get rest)))]))

(define (lower-rvo-resource-bindings-have-early-return?
  [bindings : AstResourceBindingList]) : bool
  (match bindings
    [(AstResourceBindingList.Nil) false]
    [(AstResourceBindingList.Cons binding rest)
      (or
        (match binding
          [(AstResourceBinding.Binding _ acquire-box cleanup-box)
            (or
              (lower-rvo-node-has-early-return? acquire-box)
              (lower-rvo-node-has-early-return? cleanup-box))])
        (lower-rvo-resource-bindings-have-early-return? (box-get rest)))]))

(define (lower-rvo-expr-has-early-return? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Return _) true]
    [(AstExpr.Try _) true]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrAddrOf _) false]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.Spanned inner-box _) (lower-rvo-node-has-early-return? inner-box)]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (lower-rvo-node-has-early-return? left-box)
        (lower-rvo-node-has-early-return? right-box))]
    [(AstExpr.Unary _ inner-box) (lower-rvo-node-has-early-return? inner-box)]
    [(AstExpr.Ann inner-box _) (lower-rvo-node-has-early-return? inner-box)]
    [(AstExpr.Cast inner-box _) (lower-rvo-node-has-early-return? inner-box)]
    [(AstExpr.Borrow _ _ inner-box)
      (lower-rvo-node-has-early-return? inner-box)]
    [(AstExpr.Call func-box args)
      (or
        (lower-rvo-node-has-early-return? func-box)
        (lower-rvo-expr-list-has-early-return? args))]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-rvo-node-has-early-return? cond-box)
        (lower-rvo-node-has-early-return? then-box)
        (lower-rvo-node-has-early-return? else-box))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-rvo-let-bindings-have-early-return? bindings)
            (lower-rvo-node-has-early-return? body-box))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (lower-rvo-node-has-early-return? body-box)])]
    [(AstExpr.Tuple exprs) (lower-rvo-expr-list-has-early-return? exprs)]
    [(AstExpr.TupleRef tuple-box index-box)
      (or
        (lower-rvo-node-has-early-return? tuple-box)
        (lower-rvo-node-has-early-return? index-box))]
    [(AstExpr.Array exprs) (lower-rvo-expr-list-has-early-return? exprs)]
    [(AstExpr.MakeArray _ len-box) (lower-rvo-node-has-early-return? len-box)]
    [(AstExpr.ArrayRef arr-box index-box)
      (or
        (lower-rvo-node-has-early-return? arr-box)
        (lower-rvo-node-has-early-return? index-box))]
    [(AstExpr.ArraySet arr-box index-box value-box)
      (or
        (lower-rvo-node-has-early-return? arr-box)
        (lower-rvo-node-has-early-return? index-box)
        (lower-rvo-node-has-early-return? value-box))]
    [(AstExpr.ArrayPush arr-box value-box)
      (or
        (lower-rvo-node-has-early-return? arr-box)
        (lower-rvo-node-has-early-return? value-box))]
    [(AstExpr.StringRef str-box index-box)
      (or
        (lower-rvo-node-has-early-return? str-box)
        (lower-rvo-node-has-early-return? index-box))]
    [(AstExpr.While cond-box body-box)
      (or
        (lower-rvo-node-has-early-return? cond-box)
        (lower-rvo-node-has-early-return? body-box))]
    [(AstExpr.Begin exprs) (lower-rvo-expr-list-has-early-return? exprs)]
    [(AstExpr.Unsafe exprs) (lower-rvo-expr-list-has-early-return? exprs)]
    [(AstExpr.Set _ rhs-box) (lower-rvo-node-has-early-return? rhs-box)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (or
            (lower-rvo-node-has-early-return? scrut-box)
            (lower-rvo-match-arms-have-early-return? arms))])]
    [(AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(AstForeach.Foreach _ _ start-box end-box body-box)
          (or
            (lower-rvo-node-has-early-return? start-box)
            (lower-rvo-node-has-early-return? end-box)
            (lower-rvo-node-has-early-return? body-box))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (or
            (lower-rvo-node-has-early-return? start-box)
            (lower-rvo-node-has-early-return? end-box)
            (lower-rvo-node-has-early-return? init-box)
            (lower-rvo-node-has-early-return? value-box))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (or
            (lower-rvo-node-has-early-return? start-box)
            (lower-rvo-node-has-early-return? end-box)
            (lower-rvo-node-has-early-return? init-box)
            (lower-rvo-node-has-early-return? value-box)
            (lower-rvo-node-has-early-return? body-box))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (or
        (lower-rvo-node-has-early-return? value-box)
        (lower-rvo-node-has-early-return? lane-box))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (or
        (lower-rvo-node-has-early-return? value-box)
        (lower-rvo-node-has-early-return? lane-box))]
    [(AstExpr.StructGet receiver-box _)
      (lower-rvo-node-has-early-return? receiver-box)]
    [(AstExpr.StructSet receiver-box _ value-box)
      (or
        (lower-rvo-node-has-early-return? receiver-box)
        (lower-rvo-node-has-early-return? value-box))]
    [(AstExpr.WithRegion _ body) (lower-rvo-expr-list-has-early-return? body)]
    [(AstExpr.WithEscape scratch-box body)
      (or
        (lower-rvo-node-has-early-return? scratch-box)
        (lower-rvo-expr-list-has-early-return? body))]
    [(AstExpr.WithScratch body) (lower-rvo-expr-list-has-early-return? body)]
    [(AstExpr.InArena arena-box body)
      (or
        (lower-rvo-node-has-early-return? arena-box)
        (lower-rvo-expr-list-has-early-return? body))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (or
            (lower-rvo-resource-bindings-have-early-return? bindings)
            (lower-rvo-expr-list-has-early-return? body))])]
    [(AstExpr.Box inner-box) (lower-rvo-node-has-early-return? inner-box)]
    [(AstExpr.BoxGet inner-box) (lower-rvo-node-has-early-return? inner-box)]
    [(AstExpr.BoxTake inner-box) (lower-rvo-node-has-early-return? inner-box)]
    [(AstExpr.BoxSet inner-box value-box)
      (or
        (lower-rvo-node-has-early-return? inner-box)
        (lower-rvo-node-has-early-return? value-box))]
    [(AstExpr.Comptime _) false]
    [(AstExpr.Quote _) false]
    [(AstExpr.Quasiquote _) false]
    [(AstExpr.Unquote _) false]
    [(AstExpr.UnquoteSplicing _) false]
    [(AstExpr.BracketClause items)
      (lower-rvo-expr-list-has-early-return? items)]
    [(AstExpr.PtrNullCheck inner-box)
      (lower-rvo-node-has-early-return? inner-box)]
    [(AstExpr.PtrRead ptr-box) (lower-rvo-node-has-early-return? ptr-box)]
    [(AstExpr.PtrWrite ptr-box value-box)
      (or
        (lower-rvo-node-has-early-return? ptr-box)
        (lower-rvo-node-has-early-return? value-box))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (or
        (lower-rvo-node-has-early-return? ptr-box)
        (lower-rvo-node-has-early-return? offset-box))]
    [(AstExpr.PtrCast ptr-box _) (lower-rvo-node-has-early-return? ptr-box)]
    [(AstExpr.PtrToInt ptr-box) (lower-rvo-node-has-early-return? ptr-box)]
    [(AstExpr.IntToPtr value-box _)
      (lower-rvo-node-has-early-return? value-box)]
    [(AstExpr.StringData str-box) (lower-rvo-node-has-early-return? str-box)]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (or
        (lower-rvo-node-has-early-return? ptr-box)
        (lower-rvo-node-has-early-return? len-box))]
    [(AstExpr.ArrayData array-box) (lower-rvo-node-has-early-return? array-box)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? leaf-box)
        (lower-rvo-node-has-early-return? subleaf-box))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? leaf-box)
        (lower-rvo-node-has-early-return? subleaf-box))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? leaf-box)
        (lower-rvo-node-has-early-return? subleaf-box))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? leaf-box)
        (lower-rvo-node-has-early-return? subleaf-box))]
    [(AstExpr.Xgetbv index-box) (lower-rvo-node-has-early-return? index-box)]
    [(AstExpr.Syscall args) (lower-rvo-expr-list-has-early-return? args)]
    [_ true]))

;; #3792 aliasing guard for sret-forwarding RVO. The forwarded sret is the
;; current function's result slot, which a CALLER may legally have aliased with
;; one of this call's arguments (the `(set! place (f place ...))` /
;; aggregate-place-update pattern -- HARD CONSTRAINT #4). If a callee then reads
;; such an argument and writes its result in place through the (aliased) sret --
;; e.g. it returns an enum/struct WRAPPING one of its parameters, like
;; `string-i64-map-remove-borrowed` returning `(RemoveOk map)` -- the
;; materialize-into-fresh-temp step of the value path is what makes that safe.
;; Forwarding the sret removes that buffer, so we only forward when NO argument
;; can alias the sret. An argument cannot alias the caller-owned result slot when
;; it is a scalar (carries no inline-aggregate storage) or is itself a
;; fresh-producing call/constructor whose result is an OWNED inline struct/enum
;; (materialized into a distinct fresh temp). A place-expression of aggregate
;; type (var/field/index/deref) or any reference/borrow may alias and is unsafe.
(define (lower-rvo-arg-cannot-alias-sret?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [arg : AstExpr]) : bool
  (match (tc-expr ctx type-env arg)
    [(ResultTcType.Ok ty)
      (or
        (not (lower-type-contains-inline-aggregate? ctx ty))
        (and
          (match (ast-expr-unspan arg)
            [(AstExpr.Call _ _) true]
            [_ false])
          (lower-type-inline-struct-or-enum? ctx ty)))]
    [(ResultTcType.Err _) false]))

(define (lower-rvo-args-cannot-alias-sret?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [args : AstExprList]) : bool
  (match args
    [(AstExprList.Nil) true]
    [(AstExprList.Cons arg rest)
      (and
        (lower-rvo-arg-cannot-alias-sret? ctx type-env (ast-node-get arg))
        (lower-rvo-args-cannot-alias-sret? ctx type-env (box-get rest)))]))

(define (lower-rvo-callee-has-early-return?
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : String]) : bool
  (hashmap.string-i64-map-contains?
    lower-rvo-early-return-functions
    (lower-resolve-call-name state env name)))

;; #3792 call-slot RVO for a tail-position direct CALL whose aggregate result is
;; returned by the current function. The value path lowers the call into a fresh
;; reserved result slot (`lower-call-append-sret-arg`) and then `lower-copy-bytes`
;; copies that slot into the caller-owned sret. Instead, forward the caller's own
;; sret pointer as the callee's hidden sret argument so the callee writes the
;; final result DIRECTLY into the return slot, eliminating the materialize+copy.
;;
;; Correctness: the call's arguments are evaluated BEFORE the call exactly as on
;; the value path, the would-be temporary's sole consumer is this return, and the
;; `lower-rvo-args-cannot-alias-sret?` guard above ensures no argument can alias
;; the destination -- so substituting the destination is sound. This mirrors
;; `lower-direct-call`'s ordinary (non-builtin, non-C-ABI) sret path verbatim,
;; only swapping the reserved slot for the provided `sret-var` and ending with the
;; return. Anything outside that path (builtins, C-ABI/extern, bytes-view,
;; indirect targets, incompatible/aliasing returns) yields `LowerNoDirectStore`
;; and falls back to the unchanged value+copy path.
(define (lower-return-direct-call-into-sret
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : LowerMaybeDirectStore
  (if (or
    ;; Require a genuine top-level function-define so a direct `CompilerIrInstr.Call` to
    ;; this symbol is the correct lowering. This excludes builtins, C-ABI/extern
    ;; declarations, and -- critically -- top-level function-VALUE globals /
    ;; closures, whose call must go through an INDIRECT load of the variable
    ;; (emitting a direct symbol call there would call into data). Same eligibility
    ;; rule `lower-tail-call-direct-supported?` uses for direct TCO.
    (not (lower-symbol-function-define? ctx (lower-hygiene-source-name name)))
    ;; Explicit early exits are still lowered through return paths that may hand
    ;; back an allocated aggregate in `rax` instead of filling the forwarded sret.
    (lower-rvo-callee-has-early-return? state env name)
    (lower-bytes-view-from-parts-name? name)
    (lower-c-abi-extern-call? ctx state env name)
    (lower-c-abi-extern-value-call? ctx state env name)
    ;; An argument that may alias the caller-owned sret makes in-place forwarding
    ;; unsound (see `lower-rvo-args-cannot-alias-sret?`).
    (not (lower-rvo-args-cannot-alias-sret? ctx type-env args)))
    (LowerNoDirectStore)
    (match (lower-lookup-type
      ctx
      (lower-state-type-cache state)
      env
      type-env
      name)
      [(ResultTcType.Ok fn-ty)
        (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
          [(AstType.Func param-types fn-ret)
            (if (not
              (lower-tail-call-compatible-return?
                ctx
                (ty-node-get fn-ret)
                ret-ty))
              ;; The callee's declared return type differs from this function's
              ;; return type (beyond regions): the value path coerces the call
              ;; result into the sret slot, so forwarding the slot to the callee
              ;; -- which would write its OWN-typed result -- is unsound. Keep the
              ;; materialize+copy path. (Same compatibility rule TCO requires.)
              (LowerNoDirectStore)
              (match (lower-direct-call-param-types
                ctx
                type-env
                name
                args
                (tc-resolve-type-list ctx (box-get param-types)))
                [(ResultTcTypeList.Ok call-param-types)
                  (match (lower-call-args-as-needed
                    ctx
                    state
                    env
                    type-env
                    args
                    call-param-types)
                    [(OkLowerCallArgs args-state values writebacks)
                      (match (lower-state-alloc-var args-state)
                        [(LowerAlloc allocated call-var)
                          (let
                            [result-ir-ty : AstType
                              (lower-one-word-register-storage-type ctx ret-ty)]
                            [sret-values : CompilerIrValueList
                              (lower-value-list-append-one
                                values
                                (CompilerIrValue.Var sret-var))]
                            [call-state : LowerState
                              (lower-state-emit-at-expr
                                allocated
                                (CompilerIrInstr.Call
                                  call-var
                                  (lower-resolve-call-name allocated env name)
                                  (compiler-ir-call-args-from-list sret-values)
                                  result-ir-ty)
                                origin)]
                            [writeback-state : LowerState
                              (lower-apply-arg-writebacks
                                ctx
                                call-state
                                writebacks)]
                            (LowerDirectStore
                              (lower-state-emit
                                writeback-state
                                (CompilerIrInstr.Return
                                  (lower-return-maybe
                                    (CompilerIrValue.Var sret-var)
                                    ret-ty)))))])]
                    [(ErrLowerCallArgs message) (LowerDirectStoreErr message)])]
                [(ResultTcTypeList.Err message)
                  (LowerDirectStoreErr
                    (box (lower-diagnostic-at-expr origin message)))]))]
          [_ (LowerNoDirectStore)])]
      [(ResultTcType.Err _) (LowerNoDirectStore)])))

;; Tail-position direct-call fallback shared by the non-constructor branches of
;; `lower-return-call-name-to-sret`: try the call-slot RVO above, otherwise keep
;; the unchanged materialize-into-temp + copy-to-sret behavior.
(define (lower-return-call-fallback-to-sret
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (match (lower-return-direct-call-into-sret
    ctx
    state
    env
    type-env
    name
    args
    ret-ty
    sret-var
    origin)
    [(LowerDirectStore done-state) (OkLowerState done-state)]
    [(LowerDirectStoreErr message) (ErrLowerState message)]
    [(LowerNoDirectStore)
      (lower-return-expr-generic ctx state env type-env origin ret-ty sret-var)]))

(define (lower-return-call-name-to-sret
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (let
    [source-name : String (lower-hygiene-source-name name)]
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [registries : CompilerRegistries (tc-context-registries ctx)]
    [variant-name : String
      (lower-variant-constructor-lookup-name ctx source-name ret-ty)]
    [struct-name : String
      (match (tc-type-strip-region ret-ty)
        [(AstType.Struct resolved-struct)
          (if (lower-call-name-matches-nominal?
            ctx
            source-name
            (intern-str resolved-struct))
            (intern-str resolved-struct)
            (lower-module-lookup-name ctx source-name))]
        [(AstType.StructArgs resolved-struct _)
          (if (lower-call-name-matches-nominal?
            ctx
            source-name
            (intern-str resolved-struct))
            (intern-str resolved-struct)
            (lower-module-lookup-name ctx source-name))]
        [_ (lower-module-lookup-name ctx source-name)])]
    [variant-handle : i64
      (compiler-registries-lookup-variant-or
        registries
        variant-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? variant-handle)
      (match (lower-construct-enum-with-handle-into
        ctx
        state
        env
        type-env
        (CompilerIrValue.Var sret-var)
        variant-name
        variant-handle
        args
        ret-ty)
        [(OkLowerState done-state)
          (lower-return-sret done-state ret-ty sret-var)]
        [(ErrLowerState message) (ErrLowerState message)])
      (let
        [struct-handle : i64
          (compiler-symbols-lookup-type-or
            symbols
            struct-name
            (compiler-symbols-missing-handle))]
        (if (and
          (compiler-symbols-handle-found? struct-handle)
          (=
            (compiler-symbol-handle-kind struct-handle)
            (compiler-symbol-kind-defstruct)))
          (match (lower-construct-struct-into
            ctx
            state
            env
            type-env
            (CompilerIrValue.Var sret-var)
            struct-name
            args
            ret-ty)
            [(OkLowerState done-state)
              (lower-return-sret done-state ret-ty sret-var)]
            [(ErrLowerState message) (ErrLowerState message)])
          (lower-return-call-fallback-to-sret
            ctx
            state
            env
            type-env
            name
            args
            ret-ty
            sret-var
            origin))))))

(define (lower-return-call-to-sret
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [raw-text : String (intern-str raw-name)]
        (if (tc-dotted-local-field-name? type-env raw-text)
          (lower-return-expr-generic
            ctx
            state
            env
            type-env
            origin
            ret-ty
            sret-var)
          (if (sym_i64_env.sym-i64-contains env raw-text)
            (lower-return-expr-generic
              ctx
              state
              env
              type-env
              origin
              ret-ty
              sret-var)
            (match (if (tc-hygiene-global-name? raw-text)
              (ResultTcString.Ok
                (lower-hygiene-source-name-in-context ctx type-env raw-text))
              (lower-source-name-lookup-key ctx type-env raw-text))
              [(ResultTcString.Ok name)
                (lower-return-call-name-to-sret
                  ctx
                  state
                  env
                  type-env
                  name
                  args
                  ret-ty
                  sret-var
                  origin)]
              [(ResultTcString.Err _)
                (lower-return-expr-generic
                  ctx
                  state
                  env
                  type-env
                  origin
                  ret-ty
                  sret-var)]))))]
    [_
      (lower-return-expr-generic ctx state env type-env origin ret-ty sret-var)]))

(define (lower-return-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (if (and
    (>= sret-var 0)
    (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
    (match expr
      [(AstExpr.Spanned inner-box _)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (lower-return-expr ctx state env type-env inner ret-ty sret-var))]
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (lower-return-call-to-sret
            ctx
            state
            env
            type-env
            func
            args
            ret-ty
            sret-var
            expr))]
      [_
        (lower-return-expr-generic ctx state env type-env expr ret-ty sret-var)])
    (lower-return-expr-generic ctx state env type-env expr ret-ty sret-var)))

(define (lower-tail-call-safe-param-aggregate-arg?
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-tail-call-safe-param-aggregate-arg?
        state
        env
        (ast-node-get inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-tail-call-safe-param-aggregate-arg?
        state
        env
        (ast-node-get inner-box))]
    [(AstExpr.Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? var-id)
          (lower-state-tail-param-range-contains? state var-id)
          false))]
    [_ false]))

(define (lower-expr-list-contains-unsafe-inline-aggregate?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-expr ctx type-env expr)
          [(ResultTcType.Ok ty)
            (or
              (and
                (lower-type-contains-inline-aggregate? ctx ty)
                (not (lower-tail-call-safe-param-aggregate-arg? state env expr)))
              (lower-expr-list-contains-unsafe-inline-aggregate?
                ctx
                state
                env
                type-env
                rest))]
          [(ResultTcType.Err _)
            (lower-expr-list-contains-unsafe-inline-aggregate?
              ctx
              state
              env
              type-env
              rest)]))]))

(define (lower-tail-call-inline-aggregate-risk?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]) : bool
  (or
    ;; Aggregate returns do not make frame reuse unsafe when the current
    ;; function has the caller-owned sret slot to forward to the callee.
    (and
      (< sret-var 0)
      (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
    (lower-expr-list-contains-unsafe-inline-aggregate?
      ctx
      state
      env
      type-env
      args)))

(define (lower-tail-call-append-current-sret-arg
  [ctx : TcContext]
  [state : LowerState]
  [values : CompilerIrValueList]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerArgs
  (if (and
    (>= sret-var 0)
    (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
    (OkLowerArgs
      state
      (lower-value-list-append-one values (CompilerIrValue.Var sret-var)))
    (OkLowerArgs state values)))

(define (lower-tail-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [callee : AstExpr]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (match (ast-expr-unspan callee)
    [(AstExpr.Var name)
      (let
        [unshadowed : bool (lower-tail-call-var-unshadowed? env name)]
        (cond
          [(and unshadowed (lower-comptime-error-call-id? name))
            (ErrLowerState
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: comptime-error is compile-time only")))]
          [(and
              unshadowed
              ;; #2357: only suppress TCO when THIS call actually involves inline
              ;; aggregates (sret/by-value risk); a broad inline-aggregates-mode guard
              ;; disabled tail-call optimization for every call (mode is always on),
              ;; losing TCO entirely (deep self-recursion, smoke shape failure).
              (not
                (lower-tail-call-inline-aggregate-risk?
                  ctx
                  state
                  env
                  type-env
                  args
                  ret-ty
                  sret-var))
              (lower-tail-call-direct-supported?
                ctx
                state
                env
                type-env
                name
                ret-ty))
            (match (lower-tail-call-args-for-target
              ctx
              state
              env
              type-env
              name
              args)
              [(OkLowerArgs args-state values)
                (match (lower-tail-call-append-current-sret-arg
                  ctx
                  args-state
                  values
                  ret-ty
                  sret-var)
                  [(OkLowerArgs tail-state tail-values)
                    (OkLowerState
                      (lower-state-emit-at-expr
                        tail-state
                        (CompilerIrInstr.TailCall
                          (lower-resolve-name tail-state (intern-str name))
                          (compiler-ir-call-args-from-list tail-values)
                          (lower-one-word-register-storage-type ctx ret-ty))
                        origin))]
                  [(ErrLowerArgs message) (ErrLowerState message)])]
              [(ErrLowerArgs message) (ErrLowerState message)])]
          [unshadowed
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]
          [(lower-tail-call-local-indirect-safe? env type-env name)
            (lower-tail-call-indirect-expr
              ctx
              state
              env
              type-env
              callee
              args
              ret-ty
              sret-var
              origin)]
          [else
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]))]
    [_
      (if (lower-tail-call-reference-capturing-lambda? type-env callee)
        (lower-return-expr ctx state env type-env origin ret-ty sret-var)
        (lower-tail-call-indirect-expr
          ctx
          state
          env
          type-env
          callee
          args
          ret-ty
          sret-var
          origin))]))

(define (lower-tail-begin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match exprs
    [(AstExprList.Nil)
      (OkLowerState
        (lower-state-emit
          state
          (CompilerIrInstr.Return
            (lower-return-maybe CompilerIrValue.Unit ret-ty))))]
    [(AstExprList.Cons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprList.Nil)
            (lower-tail-expr ctx state env type-env expr ret-ty sret-var)]
          [_
            (match (lower-expr ctx state env type-env expr)
              [(OkLowerExpr lowered)
                (match lowered
                  [(LowerExpr next-state _ expr-ty)
                    (if (tc-never-type? expr-ty)
                      (OkLowerState next-state)
                      (lower-tail-begin
                        ctx
                        next-state
                        env
                        type-env
                        rest
                        ret-ty
                        sret-var))])]
              [(ErrLowerExpr message) (ErrLowerState message)])]))]))

(define (lower-tail-if
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [cond : AstExpr]
  [then-branch : AstExpr]
  [else-branch : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-expr ctx state env type-env cond)
    [(OkLowerExpr cond-lowered)
      (match cond-lowered
        [(LowerExpr cond-state cond-value _)
          (match (lower-state-fresh-label cond-state "if_then")
            [(LowerLabel then-label-state then-label)
              (match (lower-state-fresh-label then-label-state "if_else")
                [(LowerLabel else-label-state else-label)
                  (let
                    [branch-state : LowerState
                      (lower-state-emit
                        else-label-state
                        (CompilerIrInstr.Branch
                          cond-value
                          then-label
                          else-label))]
                    (match (lower-tail-expr
                      ctx
                      (lower-state-finish-block branch-state then-label)
                      env
                      type-env
                      then-branch
                      ret-ty
                      sret-var)
                      [(OkLowerState then-state)
                        (lower-tail-expr
                          ctx
                          (lower-state-finish-block then-state else-label)
                          env
                          type-env
                          else-branch
                          ret-ty
                          sret-var)]
                      [(ErrLowerState message) (ErrLowerState message)]))])])])]
    [(ErrLowerExpr message) (ErrLowerState message)]))

(define (lower-tail-match-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match arms
    [(AstMatchArmList.Nil)
      (ErrLowerState (box (lower-diagnostic "lower: match with no arms")))]
    [(AstMatchArmList.Cons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match rest
          [(AstMatchArmList.Nil)
            (lower-tail-match-catch-all
              ctx
              state
              env
              type-env
              scrut-var
              scrut-ty
              arm
              ret-ty
              sret-var)]
          [_
            (match arm
              [(AstMatchArm.Arm pat body-box)
                (let
                  [body : AstExpr (ast-node-get body-box)]
                  (match pat
                    [(AstPattern.Literal lit)
                      (lower-tail-match-literal-arm
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        lit
                        body
                        rest
                        ret-ty
                        sret-var)]
                    [(AstPattern.Binding _)
                      (lower-tail-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        ret-ty
                        sret-var)]
                    [(AstPattern.Wildcard)
                      (lower-tail-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        ret-ty
                        sret-var)]
                    [(AstPattern.Variant variant-name _)
                      (if (lower-box-pattern-for-type?
                        ctx
                        scrut-ty
                        variant-name)
                        (lower-tail-match-catch-all
                          ctx
                          state
                          env
                          type-env
                          scrut-var
                          scrut-ty
                          arm
                          ret-ty
                          sret-var)
                        (if (lower-struct-pattern-for-type?
                          ctx
                          scrut-ty
                          variant-name)
                          (lower-tail-match-catch-all
                            ctx
                            state
                            env
                            type-env
                            scrut-var
                            scrut-ty
                            arm
                            ret-ty
                            sret-var)
                          (ErrLowerState
                            (box
                              (lower-diagnostic
                                "lower: unsupported match pattern")))))]
                    [_
                      (ErrLowerState
                        (box
                          (lower-diagnostic "lower: unsupported match pattern")))]))])]))]))

(define (lower-tail-match-literal-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [lit : AstLiteral]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc eq-alloc eq-var)
      (let
        [eq-state : LowerState
          (lower-state-emit
            eq-alloc
            (CompilerIrInstr.BinOp
              eq-var
              CompilerIrBinOp.Eq
              (CompilerIrValue.Var scrut-var)
              (lower-literal-value-with-type lit scrut-ty)
              scrut-ty))]
        (match (lower-state-fresh-label eq-state "match_arm")
          [(LowerLabel body-label-state body-label)
            (match (lower-state-fresh-label body-label-state "match_next")
              [(LowerLabel next-label-state next-label)
                (let
                  [body-start : LowerState
                    (lower-state-finish-block
                      (lower-state-emit
                        next-label-state
                        (CompilerIrInstr.Branch
                          (CompilerIrValue.Var eq-var)
                          body-label
                          next-label))
                      body-label)]
                  (match (lower-tail-expr
                    ctx
                    body-start
                    env
                    type-env
                    body
                    ret-ty
                    sret-var)
                    [(OkLowerState body-state)
                      (lower-tail-match-arms
                        ctx
                        (lower-state-finish-block body-state next-label)
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        rest
                        ret-ty
                        sret-var)]
                    [(ErrLowerState message) (ErrLowerState message)]))])]))]))

(define (lower-tail-match-catch-all
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arm : AstMatchArm]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match arm
    [(AstMatchArm.Arm pat body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (lower-bind-match-catch-all-pattern
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          pat)
          [(OkLowerEnv body-start body-env body-type-env)
            (lower-tail-expr
              ctx
              body-start
              body-env
              body-type-env
              body
              ret-ty
              sret-var)]
          [(ErrLowerEnv message) (ErrLowerState message)]))]))

(define (lower-tail-match-enum
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [force-memory : bool]) : ResultLowerState
  (let
    [scrut-words : i64 (lower-type-register-words ctx scrut-ty)]
    (if (and (> scrut-words 0) (not force-memory))
      (if (= scrut-words 2)
        (match (lower-emit-word
          state
          (CompilerIrValue.Var scrut-var)
          0
          (AstType.I64))
          [(LowerExpr tag-state tag-value _)
            (match tag-value
              [(CompilerIrValue.Var tag-var)
                (lower-tail-match-enum-arms
                  ctx
                  tag-state
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  arms
                  ret-ty
                  sret-var
                  (TcMaybeString.No)
                  true)]
              [_
                (ErrLowerState
                  (box
                    (lower-diagnostic "lower: internal enum tag extract failed")))])])
        (lower-tail-match-enum-arms
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          scrut-var
          arms
          ret-ty
          sret-var
          (TcMaybeString.No)
          false))
      (match (lower-load-at-offset
        state
        (CompilerIrValue.Var scrut-var)
        0
        (AstType.I64))
        [(LowerExpr tag-state tag-value _)
          (match tag-value
            [(CompilerIrValue.Var tag-var)
              (lower-tail-match-enum-arms
                ctx
                tag-state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arms
                ret-ty
                sret-var
                (TcMaybeString.No)
                false)]
            [_
              (ErrLowerState
                (box (lower-diagnostic "lower: internal enum tag load failed")))])]))))

(define (lower-tail-match-enum-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [arms : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeString]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match arms
    [(AstMatchArmList.Nil)
      (ErrLowerState (box (lower-diagnostic "lower: match with no arms")))]
    [(AstMatchArmList.Cons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm.Arm pat body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match rest
                [(AstMatchArmList.Nil)
                  (match pat
                    [(AstPattern.Wildcard)
                      (lower-tail-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        ret-ty
                        sret-var)]
                    [(AstPattern.Binding variant-name)
                      (lower-tail-match-variant-final
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        (intern-str variant-name)
                        AstPatternList.Nil
                        body
                        ret-ty
                        sret-var
                        borrow-lifetime
                        scrut-reg-group?)]
                    [(AstPattern.Variant variant-name args-box)
                      (let
                        [args : AstPatternList (box-get args-box)]
                        (lower-tail-match-variant-final
                          ctx
                          state
                          env
                          type-env
                          scrut-var
                          scrut-ty
                          (intern-str variant-name)
                          args
                          body
                          ret-ty
                          sret-var
                          borrow-lifetime
                          scrut-reg-group?))]
                    [_
                      (ErrLowerState
                        (box
                          (lower-diagnostic
                            "lower: unsupported enum match pattern")))])]
                [_
                  (match pat
                    [(AstPattern.Wildcard)
                      (lower-tail-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        ret-ty
                        sret-var)]
                    [(AstPattern.Binding variant-name)
                      (lower-tail-match-variant-arm
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        tag-var
                        (intern-str variant-name)
                        AstPatternList.Nil
                        body
                        rest
                        ret-ty
                        sret-var
                        borrow-lifetime
                        scrut-reg-group?)]
                    [(AstPattern.Variant variant-name args-box)
                      (let
                        [args : AstPatternList (box-get args-box)]
                        (lower-tail-match-variant-arm
                          ctx
                          state
                          env
                          type-env
                          scrut-var
                          scrut-ty
                          tag-var
                          (intern-str variant-name)
                          args
                          body
                          rest
                          ret-ty
                          sret-var
                          borrow-lifetime
                          scrut-reg-group?))]
                    [_
                      (ErrLowerState
                        (box
                          (lower-diagnostic
                            "lower: unsupported enum match pattern")))])]))]))]))

(define (lower-tail-match-variant-final
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [variant-name : String]
  [args : AstPatternList]
  [body : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeString]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match ctx
    [(TcContext _ symbols registries _ _)
      (let
        [resolved-scrut-ty : AstType
          (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
        [lookup-name : String
          (lower-variant-lookup-name-for-scrut
            ctx
            resolved-scrut-ty
            variant-name)]
        [handle : i64
          (compiler-registries-lookup-variant-or
            registries
            lookup-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-registries-variant-fields-indexed symbols handle)
            [(ResultAstTypeList.Ok fields)
              (let
                [resolved-fields : AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    resolved-scrut-ty
                    fields)]
                (if (lower-pattern-list-refutable-for-types?
                  ctx
                  args
                  resolved-fields)
                  (ErrLowerState
                    (box
                      (lower-diagnostic
                        "lower: refutable payload pattern in final match arm requires a trailing catch-all")))
                  (match (lower-bind-match-variant-payloads
                    ctx
                    state
                    env
                    type-env
                    borrow-lifetime
                    (CompilerIrValue.Var scrut-var)
                    args
                    resolved-fields
                    (lower-state-mode state)
                    (lower-enum-type-name-or-empty resolved-scrut-ty)
                    variant-name
                    0
                    8
                    (lower-state-current-label state)
                    scrut-reg-group?)
                    [(OkLowerEnv body-start body-env body-type-env)
                      (lower-tail-expr
                        ctx
                        body-start
                        body-env
                        body-type-env
                        body
                        ret-ty
                        sret-var)]
                    [(ErrLowerEnv message) (ErrLowerState message)])))]
            [(ResultAstTypeList.Err message)
              (ErrLowerState (box (lower-diagnostic message)))])
          (ErrLowerState
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))))]))

(define (lower-tail-match-variant-body
  [ctx : TcContext]
  [body-start : LowerState]
  [next-label : String]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [variant-name : String]
  [fields : AstTypeList]
  [args : AstPatternList]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeString]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match (lower-bind-match-variant-payloads
    ctx
    body-start
    env
    type-env
    borrow-lifetime
    (CompilerIrValue.Var scrut-var)
    args
    fields
    (lower-state-mode body-start)
    (lower-enum-type-name-or-empty scrut-ty)
    variant-name
    0
    8
    next-label
    scrut-reg-group?)
    [(OkLowerEnv bound-state body-env body-type-env)
      (match (lower-tail-expr
        ctx
        bound-state
        body-env
        body-type-env
        body
        ret-ty
        sret-var)
        [(OkLowerState body-state)
          (lower-tail-match-enum-arms
            ctx
            (lower-state-finish-block body-state next-label)
            env
            type-env
            scrut-var
            scrut-ty
            tag-var
            rest
            ret-ty
            sret-var
            borrow-lifetime
            scrut-reg-group?)]
        [(ErrLowerState message) (ErrLowerState message)])]
    [(ErrLowerEnv message) (ErrLowerState message)]))

(define (lower-tail-match-variant-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [variant-name : String]
  [args : AstPatternList]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeString]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match ctx
    [(TcContext _ symbols registries _ _)
      (let
        [resolved-scrut-ty : AstType
          (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
        [lookup-name : String
          (lower-variant-lookup-name-for-scrut
            ctx
            resolved-scrut-ty
            variant-name)]
        [handle : i64
          (compiler-registries-lookup-variant-or
            registries
            lookup-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-registries-variant-fields-indexed symbols handle)
            [(ResultAstTypeList.Ok fields)
              (let
                [resolved-fields : AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    resolved-scrut-ty
                    fields)]
                (match (lower-state-alloc-var state)
                  [(LowerAlloc eq-alloc eq-var)
                    (let
                      [eq-state : LowerState
                        (lower-state-emit
                          eq-alloc
                          (CompilerIrInstr.BinOp
                            eq-var
                            CompilerIrBinOp.Eq
                            (CompilerIrValue.Var tag-var)
                            (CompilerIrValue.I64
                              (compiler-registry-handle-child-index handle))
                            (AstType.I64)))]
                      (match (lower-state-fresh-label eq-state "match_arm")
                        [(LowerLabel body-label-state body-label)
                          (match (lower-state-fresh-label
                            body-label-state
                            "match_next")
                            [(LowerLabel next-label-state next-label)
                              (let
                                [body-start : LowerState
                                  (lower-state-finish-block
                                    (lower-state-emit
                                      next-label-state
                                      (CompilerIrInstr.Branch
                                        (CompilerIrValue.Var eq-var)
                                        body-label
                                        next-label))
                                    body-label)]
                                (lower-tail-match-variant-body
                                  ctx
                                  body-start
                                  next-label
                                  env
                                  type-env
                                  scrut-var
                                  scrut-ty
                                  tag-var
                                  variant-name
                                  resolved-fields
                                  args
                                  body
                                  rest
                                  ret-ty
                                  sret-var
                                  borrow-lifetime
                                  scrut-reg-group?))])]))]))]
            [(ResultAstTypeList.Err message)
              (ErrLowerState (box (lower-diagnostic message)))])
          (ErrLowerState
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))))]))

(define (lower-borrowed-enum-match-scrutinee?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [scrutinee : AstExpr]) : bool
  (match (ast-expr-unspan scrutinee)
    [(AstExpr.Borrow mutable _ _)
      (if mutable
        false
        (match (tc-expr ctx type-env scrutinee)
          [(ResultTcType.Ok scrut-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
              [(AstType.Ref _ referent-box)
                (let
                  [referent-ty : AstType
                    (tc-type-strip-region
                      (tc-resolve-type ctx (ty-node-get referent-box)))]
                  (match referent-ty
                    [(AstType.Enum _) true]
                    [(AstType.EnumArgs _ _) true]
                    [_ false]))]
              [_ false])]
          [(ResultTcType.Err _) false]))]
    [_ false]))

(define (lower-tail-match
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (if (lower-borrowed-enum-match-scrutinee? ctx type-env scrutinee)
    (lower-return-expr ctx state env type-env origin ret-ty sret-var)
    (match (lower-expr ctx state env type-env scrutinee)
      [(OkLowerExpr scrut-lowered)
        (match scrut-lowered
          [(LowerExpr scrut-state scrut-value scrut-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
              [(AstType.Enum _)
                (match (lower-state-alloc-var scrut-state)
                  [(LowerAlloc scrut-alloc scrut-var)
                    (lower-tail-match-enum
                      ctx
                      (lower-state-emit
                        scrut-alloc
                        (CompilerIrInstr.Mov scrut-var scrut-value scrut-ty))
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var
                      false)])]
              [(AstType.EnumArgs _ _)
                (match (lower-state-alloc-var scrut-state)
                  [(LowerAlloc scrut-alloc scrut-var)
                    (lower-tail-match-enum
                      ctx
                      (lower-state-emit
                        scrut-alloc
                        (CompilerIrInstr.Mov scrut-var scrut-value scrut-ty))
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var
                      false)])]
              [(AstType.VarArgs _ _)
                (match (lower-state-alloc-var scrut-state)
                  [(LowerAlloc scrut-alloc scrut-var)
                    (lower-tail-match-enum
                      ctx
                      (lower-state-emit
                        scrut-alloc
                        (CompilerIrInstr.Mov scrut-var scrut-value scrut-ty))
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var
                      false)])]
              [_
                (match (lower-state-alloc-var scrut-state)
                  [(LowerAlloc scrut-alloc scrut-var)
                    (lower-tail-match-arms
                      ctx
                      (lower-state-emit
                        scrut-alloc
                        (CompilerIrInstr.Mov scrut-var scrut-value scrut-ty))
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var)])])])]
      [(ErrLowerExpr message) (ErrLowerState message)])))

(define (lower-tail-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (if (lower-tail-expr-candidate? state env expr)
    (match expr
      [(AstExpr.Spanned inner-box _)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (lower-tail-expr ctx state env type-env inner ret-ty sret-var))]
      [(AstExpr.Ann inner-box _)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (lower-tail-expr ctx state env type-env inner ret-ty sret-var))]
      [(AstExpr.Cast inner-box _)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (tc-expr ctx type-env inner)
            [(ResultTcType.Ok inner-ty)
              (if (tc-type-eq (tc-type-without-regions inner-ty) ret-ty)
                (lower-tail-expr ctx state env type-env inner ret-ty sret-var)
                (lower-return-expr ctx state env type-env expr ret-ty sret-var))]
            [(ResultTcType.Err message)
              (ErrLowerState (box (lower-diagnostic-at-expr inner message)))]))]
      [(AstExpr.Call callee-box args)
        (let
          [callee : AstExpr (ast-node-get callee-box)]
          (lower-tail-call
            ctx
            state
            env
            type-env
            callee
            args
            ret-ty
            sret-var
            expr))]
      [(AstExpr.Let let-box)
        (match (box-get let-box)
          [(AstLet.Let bindings body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (lower-let-bindings ctx state env type-env bindings)
                [(OkLowerEnv binding-state body-env body-type-env)
                  (lower-tail-expr
                    ctx
                    binding-state
                    body-env
                    body-type-env
                    body
                    ret-ty
                    sret-var)]
                [(ErrLowerEnv message) (ErrLowerState message)]))])]
      [(AstExpr.Begin exprs)
        (lower-tail-begin ctx state env type-env exprs ret-ty sret-var)]
      [(AstExpr.Unsafe exprs)
        (lower-tail-begin
          ctx
          state
          env
          (tc-enter-unsafe type-env)
          exprs
          ret-ty
          sret-var)]
      [(AstExpr.If cond-box then-branch-box else-branch-box)
        (let
          [cond : AstExpr (ast-node-get cond-box)]
          [then-branch : AstExpr (ast-node-get then-branch-box)]
          [else-branch : AstExpr (ast-node-get else-branch-box)]
          (lower-tail-if
            ctx
            state
            env
            type-env
            cond
            then-branch
            else-branch
            ret-ty
            sret-var))]
      [(AstExpr.Match match-box)
        (match (box-get match-box)
          [(AstMatch.Match scrutinee-box arms)
            (let
              [scrutinee : AstExpr (ast-node-get scrutinee-box)]
              (lower-tail-match
                ctx
                state
                env
                type-env
                scrutinee
                arms
                ret-ty
                sret-var
                expr))])]
      [_ (lower-return-expr ctx state env type-env expr ret-ty sret-var)])
    (lower-return-expr ctx state env type-env expr ret-ty sret-var)))

(define (lower-param-count [params : AstParamList]) : i64
  (match params
    [(AstParamList.Nil) 0]
    [(AstParamList.Cons _ rest)
      (let
        [rest : AstParamList (box-get rest)]
        (+ 1 (lower-param-count rest)))]))

(define (lower-bind-params
  [params : AstParamList]
  [idx : i64]
  [env : sym_i64_env.SymI64Env]) : sym_i64_env.SymI64Env
  (match params
    [(AstParamList.Nil) env]
    [(AstParamList.Cons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam.Param name _ _)
            (lower-bind-params
              rest
              (+ idx 1)
              (sym_i64_env.sym-i64-bind-id env name idx))]))]))

(define (lower-param-list [ctx : TcContext] [params : AstParamList] [idx : i64]) : CompilerIrParamList
  (match params
    [(AstParamList.Nil) IrParamNil]
    [(AstParamList.Cons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam.Param name ty _)
            (compiler-ir-param-cons
              (CompilerIrParam.Param
                (intern-str name)
                (lower-one-word-register-storage-type
                  ctx
                  (tc-type-without-regions (tc-resolve-type ctx ty)))
                idx)
              (lower-param-list ctx rest (+ idx 1)))]))]))

;; #1867 sret ABI: append the hidden result-slot pointer param at index
;; `sret-var` (the var id reserved just past the real params). Internal calling
;; convention only -- C-ABI externs keep their own ABI on a separate path.
(define (lower-param-list-append-sret
  [params : CompilerIrParamList]
  [sret-var : i64]) : CompilerIrParamList
  (match params
    [(IrParamNil)
      (compiler-ir-param-cons
        (CompilerIrParam.Param "__sret" (AstType.U64) sret-var)
        IrParamNil)]
    [(IrParamCons head rest)
      (compiler-ir-param-cons
        head
        (lower-param-list-append-sret (box-get rest) sret-var))]))

(define (lower-supported-function-param-type? [ctx : TcContext] [ty : AstType]) : bool
  (lower-supported-reference-type? ctx ty))

(define (lower-type-contains-inline-aggregate? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Tuple elems)
      (lower-type-list-contains-inline-aggregate? ctx (box-get elems))]
    [(AstType.Array _ _) true]
    [(AstType.Region _ inner)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc-context-type-get ctx inner))]
    ;; #1867: a reference can point INTO the current frame (memory-aggregate
    ;; locals live in frame slots now), so a ref arg whose referent is or
    ;; contains an inline aggregate makes a tail call unsafe -- the callee
    ;; would read through a pointer into the reused/abandoned frame.
    [(AstType.Ref _ referent)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc-context-type-get ctx referent))]
    [(AstType.MutRef _ referent)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc-context-type-get ctx referent))]
    [_ false]))

(define (lower-type-list-contains-inline-aggregate?
  [ctx : TcContext]
  [types : AstTypeList]) : bool
  (match types
    [(AstTypeList.Nil) false]
    [(AstTypeList.Cons ty rest)
      (let
        [ty : AstType (tc-context-type-get ctx ty)]
        [rest : AstTypeList (box-get rest)]
        (or
          (lower-type-contains-inline-aggregate? ctx ty)
          (lower-type-list-contains-inline-aggregate? ctx rest)))]))

(define (lower-param-list-contains-inline-aggregate?
  [ctx : TcContext]
  [params : AstParamList]) : bool
  (match params
    [(AstParamList.Nil) false]
    [(AstParamList.Cons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam.Param _ ty _)
            (or
              (lower-type-contains-inline-aggregate? ctx ty)
              (lower-param-list-contains-inline-aggregate? ctx rest))]))]))

(define (lower-param-list-contains-unsupported-reference?
  [ctx : TcContext]
  [params : AstParamList]) : bool
  (match params
    [(AstParamList.Nil) false]
    [(AstParamList.Cons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam.Param _ ty _)
            (or
              (not (lower-supported-function-param-type? ctx ty))
              (lower-param-list-contains-unsupported-reference? ctx rest))]))]))

(define (lower-supported-function-return-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-resolve-type ctx ty)
    [(AstType.Region _ inner)
      (lower-supported-function-return-type?
        ctx
        (tc-context-type-get ctx inner))]
    [_ true]))

(define (lower-logical-name-has-suffix?
  [logical-name : String]
  [suffix : String]) : bool
  (let
    [name-len : i64 (string.string-length logical-name)]
    [suffix-len : i64 (string.string-length suffix)]
    (and
      (>= name-len suffix-len)
      (string.eq
        (string.substring logical-name (- name-len suffix-len) suffix-len)
        suffix))))

(define (lower-logical-name-has-prefix?
  [logical-name : String]
  [prefix : String]) : bool
  (let
    [name-len : i64 (string.string-length logical-name)]
    [prefix-len : i64 (string.string-length prefix)]
    (and
      (>= name-len prefix-len)
      (string.eq (string.substring logical-name 0 prefix-len) prefix))))

;; #1867 sret ABI: a `__global_init_<name>` initializer's result is stored into
;; a forever-lived global by the backend's startup sequence (not a normal call
;; site), so it must return stable arena storage -- never a caller stack sret
;; slot. Keep these on the arena return path.
(define (lower-global-init-function? [logical-name : String]) : bool
  (lower-logical-name-has-prefix? logical-name "__global_init_"))

(define (lower-function
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : String]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (if (or
    (lower-param-list-contains-unsupported-reference? ctx params)
    (not (lower-supported-reference-type? ctx ret)))
    (ErrLowerFunction
      (box (lower-diagnostic (lower-reference-support-message))))
    (let
      [param-count : i64 (lower-param-count params)]
      [ret-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ret))]
      [ret-ir-ty : AstType (lower-one-word-register-storage-type ctx ret-ty)]
      ;; #1867 sret ABI: an aggregate-returning function takes a hidden
      ;; result-slot pointer at var `param-count` (just past the real params);
      ;; the body writes the result through it instead of arena-copying.
      [sret-needed : bool
        (and
          (lower-mode-inline-aggregates? mode)
          (not (lower-global-init-function? logical-name))
          (lower-type-inline-struct-or-enum? ctx ret-ty)
          (not (lower-type-register-resident? ctx ret-ty)))]
      [sret-var : i64
        (if sret-needed
          param-count
          (- 0 1))]
      [env : sym_i64_env.SymI64Env
        (lower-bind-params params 0 (sym_i64_env.sym-i64-empty))]
      [type-env : TcTypeEnv
        (tc-bind-return-type
          (tc-bind-params ctx (tc-hygiene-global-env top-env) params)
          ret-ty)]
      [function-spans : CompilerSourceSpans
        (lower-record-function-span spans logical-name body)]
      [state : LowerState
        (LowerState
          (if sret-needed
            (+ param-count 1)
            param-count)
          0
          0
          "entry"
          (box CompilerIrInstrList.Nil)
          (box CompilerIrBlockList.Nil)
          (box CompilerIrFunctionList.Nil)
          logical-name
          (box function-spans)
          names
          type-cache
          mode
          0
          param-count)]
      (if (lower-supported-function-return-type? ctx ret-ty)
        (match (lower-tail-expr ctx state env type-env body ret-ty sret-var)
          [(OkLowerState final-state)
            (OkLowerFunction
              (compiler-ir-function-cons
                (CompilerIrFunction.Function
                  logical-name
                  (if (>= sret-var 0)
                    (lower-param-list-append-sret
                      (lower-param-list ctx params 0)
                      sret-var)
                    (lower-param-list ctx params 0))
                  ret-ir-ty
                  (lower-state-next-var final-state)
                  (lower-state-build-function-blocks final-state))
                (lower-state-functions final-state))
              (lower-state-spans final-state))]
          [(ErrLowerState message) (ErrLowerFunction message)])
        (ErrLowerFunction
          (box (lower-diagnostic-at-expr body "lower: unsupported expression")))))))

(define (lower-global-value
  [names : LowerNameCache]
  [expr : AstExpr]
  [ty : AstType]) : ResultLowerValue
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-global-value names inner ty))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-global-value names inner ty))]
    [(AstExpr.Cast inner-box cast-ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (lower-global-value names inner cast-ty))]
    [(AstExpr.Literal lit)
      (OkLowerValue (lower-literal-value-with-type lit ty))]
    [(AstExpr.BinaryData bytes) (OkLowerValue (CompilerIrValue.Bytes bytes))]
    [(AstExpr.SpmdProgramIndex) (OkLowerValue (CompilerIrValue.I64 0))]
    [(AstExpr.SpmdProgramCount) (OkLowerValue (CompilerIrValue.I64 1))]
    [(AstExpr.Var name)
      (OkLowerValue
        (CompilerIrValue.Global
          (lower-name-cache-resolve names (intern-str name))))]
    [_
      (ErrLowerValue
        (box (lower-diagnostic "lower: unsupported global initializer")))]))

(define (lower-global-init-function-name [global-name : String]) : String
  (string.append "__global_init_" global-name))

(define (lower-top-decl-type-or-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcType
  (match decl
    [(AstDecl.Def name _ _)
      (match (tc-lookup-id env name)
        [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
        [(ResultTcType.Err _) (tc-top-decl-type-with-env ctx env decl)])]
    [_ (tc-top-decl-type-with-env ctx env decl)]))

;; Record `name -> body span` into the provenance table (#605). A function whose
;;
;; body carries no source span leaves the table unchanged, so the backend simply
;;
;; falls back to its default location for that function.
(define (lower-record-function-span
  [spans : CompilerSourceSpans]
  [name : String]
  [body : AstExpr]) : CompilerSourceSpans
  (match (lower-ast-expr-span body)
    [(CompilerMaybeSourceSpan.Some span)
      (compiler-source-spans-insert spans name span)]
    [(CompilerMaybeSourceSpan.No) spans]))

;; Reusable per-function lowering scratch arena (#1917). Lowering one function
;; allocates a fresh `LowerState` plus the transient IR/AST-walk scratch the bump
;; allocator never frees; summed across cli.tl's ~5000 functions this transient
;; dominates the lower phase's peak live (the headline self-build memory number).
;; We lower each function inside one shared scratch arena and `tl_region_reset` it
;; after deep-`clone`ing ONLY the produced IR function list back into the
;; enclosing (program) arena -- reclaiming the per-function transient before the
;; next function. The arena is created lazily once and reused (rewound, never
;; remapped) per function, mirroring the optimizer's per-function escape
;; (`optimize-function-escaping`). The spans side-table insertion is recomputed
;; in the enclosing arena (it never affects emitted assembly, only backend-error
;; source locations). `lower-function-escaping` is only ever called at decl
;; granularity (never re-entrant within `lower-function`'s body walk), so a
;; single shared mark/rewind region is sound. Output stays byte-identical: the
;; clone is a structural deep copy, so the escaped IR lowers to the same assembly
;; as the in-place IR did.
;; Dotted imports create transient lookup-key strings during function lowering
;; (`module/name` from `alias.name`). Any new intern entry made from those
;; strings must survive the scratch rewind, so the scope mirrors
;; `tc-check-fn-decl-scoped` and forces persistent intern storage while active.
(defstruct CompilerLowerArenaState
  (scratch-arena (Array i64))
  (ir-arena (Array i64)))

(define lower-scratch-arena : i64
  0)

(define (lower-scratch-arena-get) : i64
  (if (= lower-scratch-arena 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! lower-scratch-arena scratch)
        scratch))
    lower-scratch-arena))

(define (lower-scratch-arena-release!) : unit
  (if (= lower-scratch-arena 0)
    unit
    (begin
      (unsafe
        (arena.tl_arena_destroy lower-scratch-arena))
      (set! lower-scratch-arena 0))))

;; #2596: dedicated arena for the escaped (lowered) IR function bodies. The
;; lowered IR is consumed exactly once: at opt levels >= 1 the optimizer
;; deep-clones every surviving function into the enclosing arena
;; (optimize-function-escaping), after which the entire input IR is dead --
;; ~172MB on a cli.tl self-compile that the program-lifetime arena would
;; never reclaim. Cloning the lowered functions into this arena instead lets
;; the driver destroy it right after optimization. At opt level 0 the
;; program flows to the backend unchanged, so the arena must stay alive for
;; the whole compile (the driver only releases it for levels >= 1; batch
;; compiles release it between entries). Globals, externs, and the spans
;; side-table are NOT allocated here -- they outlive optimization.
(define lower-ir-arena : i64
  0)

(define (lower-ir-arena-get) : i64
  (if (= lower-ir-arena 0)
    (let
      [arena : i64 (arena.tl_arena_make)]
      (begin
        (set! lower-ir-arena arena)
        arena))
    lower-ir-arena))

(define (lower-ir-arena-release!) : unit
  (if (= lower-ir-arena 0)
    unit
    (begin
      (unsafe
        (arena.tl_arena_destroy lower-ir-arena))
      (set! lower-ir-arena 0))))

(define (lower-arenas-release!) : unit
  (begin
    (lower-scratch-arena-release!)
    (lower-ir-arena-release!)))

(define (compiler-lower-arena-state-new) : CompilerLowerArenaState
  (let
    [scratch : (Array i64) (make-array i64 1)]
    [ir : (Array i64) (make-array i64 1)]
    (begin
      (array-set! scratch 0 0)
      (array-set! ir 0 0)
      (CompilerLowerArenaState scratch ir))))

(define (compiler-lower-arena-state-scratch-arena
  [state : CompilerLowerArenaState]) : i64
  (array-ref (struct-get state scratch-arena) 0))

(define (compiler-lower-arena-state-ir-arena [state : CompilerLowerArenaState]) : i64
  (array-ref (struct-get state ir-arena) 0))

(define (compiler-lower-arena-state-set!
  [state : CompilerLowerArenaState]
  [scratch : i64]
  [ir : i64]) : unit
  (begin
    (array-set! (struct-get state scratch-arena) 0 scratch)
    (array-set! (struct-get state ir-arena) 0 ir)))

(define (compiler-lower-arena-state-capture-from-globals!
  [state : CompilerLowerArenaState]) : unit
  (compiler-lower-arena-state-set! state lower-scratch-arena lower-ir-arena))

(define (compiler-lower-arena-state-capture) : CompilerLowerArenaState
  (let
    [state : CompilerLowerArenaState (compiler-lower-arena-state-new)]
    (begin
      (compiler-lower-arena-state-capture-from-globals! state)
      state)))

(define (compiler-lower-arena-state-install! [state : CompilerLowerArenaState]) : unit
  (begin
    (set! lower-scratch-arena (compiler-lower-arena-state-scratch-arena state))
    (set! lower-ir-arena (compiler-lower-arena-state-ir-arena state))))

(define (lower-function-escaping
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : String]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [prev-persist : bool (intern-persistent-storage-on?)]
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (lower-scratch-arena-get)]
    (begin
      ;; Type-name/owner caches may contain keys allocated by earlier
      ;; typecheck or lower scratch scopes. Keep them scoped to this lowering
      ;; pass and invalidate them before rewinding this function's scratch arena.
      (tc-nominal-owner-cache-reset!)
      (intern-persistent-storage-enable!)
      ;; #2386 (compile-time): new generation for the result-type-fast memo, so
      ;; this function's cached node types are independent of every other
      ;; function's (and never outlive this function's scratch arena).
      (tc-rtf-next-gen!)
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        (match (lower-function
          ctx
          top-env
          type-cache
          logical-name
          params
          ret
          body
          spans
          names
          mode)
          [(OkLowerFunction fns _function-spans)
            (let
              [scratch-head : i64 (arena.tl_arena_current)]
              (begin
                ;; The IR function clones go to the dedicated lowered-IR
                ;; arena (released by the driver after optimization); the
                ;; spans side-table is rebuilt in the enclosing arena since
                ;; it outlives the lowered IR. The stored handle must follow
                ;; the arena's grown head, or every later allocation re-walks
                ;; the overflow path from the full first segment.
                (unsafe
                  (arena.tl_arena_set (lower-ir-arena-get)))
                (let
                  [escaped-fns : CompilerIrFunctionList
                    (compiler-ir-clone-function-list fns)]
                  (begin
                    (set! lower-ir-arena (arena.tl_arena_current))
                    (unsafe
                      (arena.tl_arena_set enclosing))
                    (let
                      [escaped-spans : CompilerSourceSpans
                        (lower-record-function-span spans logical-name body)]
                      [new-enclosing : i64 (arena.tl_arena_current)]
                      (begin
                        (unsafe
                          (arena.tl_arena_set scratch-head)
                          (arena.tl_region_reset mark)
                          (arena.tl_arena_set new-enclosing))
                        (tc-nominal-owner-cache-reset!)
                        (if prev-persist
                          unit
                          (intern-persistent-storage-disable!))
                        (OkLowerFunction escaped-fns escaped-spans)))))))]
          [(ErrLowerFunction message)
            (let
              [scratch-head : i64 (arena.tl_arena_current)]
              (begin
                (unsafe
                  (arena.tl_arena_set enclosing))
                (let
                  [escaped-message : (Box CompilerDiagnostic) (clone message)]
                  [new-enclosing : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set new-enclosing))
                    (tc-nominal-owner-cache-reset!)
                    (if prev-persist
                      unit
                      (intern-persistent-storage-disable!))
                    (ErrLowerFunction escaped-message)))))])))))

(define (lower-struct-cleanup-param-name) : String
  "__tl_cleanup_value")

(define (lower-struct-cleanup-qualified-name
  [struct-name : String]
  [cleanup-name : String]) : String
  (if (tc-name-qualified? cleanup-name)
    cleanup-name
    (compiler-symbol-module-key
      (tc-qualified-name-module struct-name)
      cleanup-name)))

(define (lower-struct-cleanup-name-for-struct
  [ctx : TcContext]
  [struct-name : String]) : ResultTcString
  (match (tc-struct-decl ctx struct-name)
    [(ResultTcStructDecl.Ok decl)
      (match decl
        [(TcStructDecl _ cleanup _)
          (match cleanup
            [(AstStructCleanup.Fn cleanup-name)
              (ResultTcString.Ok
                (lower-struct-cleanup-qualified-name
                  struct-name
                  (intern-str cleanup-name)))]
            [(AstStructCleanup.No)
              (ResultTcString.Err
                (string.append
                  "lower: owned cleanup field type has no cleanup function "
                  struct-name))])])]
    [(ResultTcStructDecl.Err message) (ResultTcString.Err message)]))

(define (lower-struct-cleanup-name-for-type [ctx : TcContext] [ty : AstType]) : ResultTcString
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Struct name)
        (lower-struct-cleanup-name-for-struct ctx (intern-str name))]
      [(AstType.StructArgs name _)
        (lower-struct-cleanup-name-for-struct ctx (intern-str name))]
      [_
        (ResultTcString.Err
          (string.append
            "lower: owned cleanup field type is not a cleanup-owning struct "
            (tc-type-render resolved)))])))

(define (lower-struct-cleanup-call-expr
  [cleanup-name : String]
  [value-name : String]
  [field-name : String]) : i64
  (ast-expr-call
    (ast-node-push (AstExpr.Var (intern cleanup-name)))
    (ast-expr-cons
      (ast-expr-struct-get
        (ast-node-push (AstExpr.Var (intern value-name)))
        field-name)
      AstExprList.Nil)))

(define (lower-struct-cleanup-field-exprs
  [ctx : TcContext]
  [value-name : String]
  [field : AstFieldDef]
  [acc : AstExprList]) : ResultAstExprList
  (match field
    [(AstFieldDef.Def field-name ty cleanup)
      (match cleanup
        [(AstFieldCleanup.No) (ResultAstExprList.Ok acc)]
        [(AstFieldCleanup.Fn cleanup-name)
          (ResultAstExprList.Ok
            (ast-expr-cons
              (lower-struct-cleanup-call-expr
                (intern-str cleanup-name)
                value-name
                (intern-str field-name))
              acc))]
        [(AstFieldCleanup.Owned)
          (match (lower-struct-cleanup-name-for-type ctx ty)
            [(ResultTcString.Ok cleanup-name)
              (ResultAstExprList.Ok
                (ast-expr-cons
                  (lower-struct-cleanup-call-expr
                    cleanup-name
                    value-name
                    (intern-str field-name))
                  acc))]
            [(ResultTcString.Err message) (ResultAstExprList.Err message)])])]))

(define (lower-struct-cleanup-body-fields
  [ctx : TcContext]
  [value-name : String]
  [fields : AstFieldDefList]
  [acc : AstExprList]) : ResultAstExprList
  (match fields
    [(AstFieldDefList.Nil) (ResultAstExprList.Ok acc)]
    [(AstFieldDefList.Cons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match (lower-struct-cleanup-field-exprs ctx value-name field acc)
          [(ResultAstExprList.Ok next)
            (lower-struct-cleanup-body-fields ctx value-name rest next)]
          [(ResultAstExprList.Err message) (ResultAstExprList.Err message)]))]))

(define (lower-struct-cleanup-function
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : String]
  [struct-ty : AstType]
  [fields : AstFieldDefList]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [value-name : String (lower-struct-cleanup-param-name)]
    (match (lower-struct-cleanup-body-fields
      ctx
      value-name
      fields
      AstExprList.Nil)
      [(ResultAstExprList.Ok exprs)
        (let
          [params : AstParamList
            (ast-param-cons
              (ast-param value-name struct-ty false)
              AstParamList.Nil)]
          [body : AstExpr
            (match exprs
              [(AstExprList.Nil) (AstExpr.Literal AstLiteral.Unit)]
              [_ (AstExpr.Begin exprs)])]
          (lower-function-escaping
            ctx
            top-env
            type-cache
            logical-name
            params
            (AstType.Unit)
            body
            spans
            names
            mode))]
      [(ResultAstExprList.Err message)
        (ErrLowerFunction (box (lower-diagnostic message)))])))

(define (lower-struct-cleanup-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : String]
  [cleanup : AstStructCleanup]
  [struct-ty : AstType]
  [fields : AstFieldDefList]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match cleanup
    [(AstStructCleanup.No) (OkLowerFunction CompilerIrFunctionList.Nil spans)]
    [(AstStructCleanup.Fn _)
      (lower-struct-cleanup-function
        ctx
        top-env
        type-cache
        logical-name
        struct-ty
        fields
        spans
        names
        mode)]))

(define (lower-dispatch-cache-name [logical-name : String]) : String
  (string.append "__tl_dispatch_cache_" logical-name))

(define (lower-dispatch-variant-prefix [isa : AstDispatchIsa]) : String
  (match isa
    [(AstDispatchIsa.Scalar) "__tl_dispatch_variant_scalar_"]
    [(AstDispatchIsa.Avx2) "__tl_dispatch_variant_avx2_"]
    [(AstDispatchIsa.Avx512) "__tl_dispatch_variant_avx512_"]))

(define (lower-dispatch-variant-internal-name
  [dispatch-name : String]
  [isa : AstDispatchIsa]
  [variant-name : String]) : String
  (string.append
    (lower-dispatch-variant-prefix isa)
    (string.append dispatch-name (string.append "__" variant-name))))

(define (lower-dispatch-lower-mode
  [isa : AstDispatchIsa]
  [mode : CompilerLowerMode]) : CompilerLowerMode
  (match isa
    [(AstDispatchIsa.Scalar)
      (if (lower-mode-windows-c-abi? mode)
        (CompilerLowerWindowsScalar)
        (if (lower-mode-linux-c-abi? mode)
          (CompilerLowerLinuxScalar)
          (CompilerLowerScalar)))]
    [(AstDispatchIsa.Avx2)
      (if (lower-mode-windows-c-abi? mode)
        (CompilerLowerWindowsAvx2)
        (if (lower-mode-linux-c-abi? mode)
          (CompilerLowerLinuxAvx2)
          (CompilerLowerAvx2)))]
    [(AstDispatchIsa.Avx512)
      (if (lower-mode-windows-c-abi? mode)
        (CompilerLowerWindowsAvx512)
        (if (lower-mode-linux-c-abi? mode)
          (CompilerLowerLinuxAvx512)
          (CompilerLowerAvx512)))]))

(define (lower-dispatch-type-list-without-regions [types : AstTypeList]) : AstTypeList
  (match types
    [(AstTypeList.Nil) AstTypeList.Nil]
    [(AstTypeList.Cons ty rest)
      (let
        [ty : AstType (ty-node-get ty)]
        [rest : AstTypeList (box-get rest)]
        (ast-type-cons
          (tc-type-without-regions ty)
          (lower-dispatch-type-list-without-regions rest)))]))

(define (lower-dispatch-param-type-count [types : AstTypeList]) : i64
  (match types
    [(AstTypeList.Nil) 0]
    [(AstTypeList.Cons _ rest)
      (let
        [rest : AstTypeList (box-get rest)]
        (+ 1 (lower-dispatch-param-type-count rest)))]))

(define (lower-dispatch-param-list-from-types [types : AstTypeList] [idx : i64]) : CompilerIrParamList
  (match types
    [(AstTypeList.Nil) IrParamNil]
    [(AstTypeList.Cons ty rest)
      (let
        [ty : AstType (ty-node-get ty)]
        [rest : AstTypeList (box-get rest)]
        (compiler-ir-param-cons
          (CompilerIrParam.Param
            (string.append "arg" (string.int->string idx))
            (tc-type-without-regions ty)
            idx)
          (lower-dispatch-param-list-from-types rest (+ idx 1))))]))

(define (lower-dispatch-param-values [types : AstTypeList] [idx : i64]) : CompilerIrValueList
  (match types
    [(AstTypeList.Nil) IrValueNil]
    [(AstTypeList.Cons _ rest)
      (let
        [rest : AstTypeList (box-get rest)]
        (compiler-ir-value-cons
          (CompilerIrValue.Var idx)
          (lower-dispatch-param-values rest (+ idx 1))))]))

(define (lower-dispatch-find-internal-name
  [variants : AstDispatchVariantList]
  [module : String]
  [names : LowerNameCache]
  [dispatch-name : String]
  [wanted : AstDispatchIsa]) : TcMaybeString
  (match variants
    [(AstDispatchVariantList.Nil) (TcMaybeString.No)]
    [(AstDispatchVariantList.Cons variant rest)
      (let
        [rest : AstDispatchVariantList (box-get rest)]
        (match variant
          [(AstDispatchVariant.Variant isa variant-name)
            (if (tc-dispatch-isa-eq? isa wanted)
              (TcMaybeString.Some
                (lower-dispatch-variant-internal-name
                  dispatch-name
                  isa
                  (lower-dispatch-variant-logical-name
                    module
                    names
                    variant-name)))
              (lower-dispatch-find-internal-name
                rest
                module
                names
                dispatch-name
                wanted))]))]))

(define (lower-dispatch-call-return-instr [call-var : i64] [ret-ty : AstType]) : CompilerIrInstr
  (CompilerIrInstr.Return
    (lower-return-maybe (CompilerIrValue.Var call-var) ret-ty)))

(define (lower-dispatch-cached-block
  [cache-name : String]
  [args : CompilerIrCallArgs]
  [ret-ty : AstType]
  [call-var : i64]) : CompilerIrBlock
  (compiler-ir-block
    "cached"
    (compiler-ir-instr-cons
      (CompilerIrInstr.CallIndirect
        call-var
        (CompilerIrValue.Global cache-name)
        args
        ret-ty)
      (compiler-ir-instr-cons
        (lower-dispatch-call-return-instr call-var ret-ty)
        CompilerIrInstrList.Nil))))

(define (lower-dispatch-select-block
  [label : String]
  [cache-name : String]
  [fn-name : String]
  [fn-ty : AstType]
  [args : CompilerIrCallArgs]
  [ret-ty : AstType]
  [call-var : i64]) : CompilerIrBlock
  (compiler-ir-block
    label
    (compiler-ir-instr-cons
      (CompilerIrInstr.Store
        cache-name
        (CompilerIrValue.Function fn-name)
        fn-ty)
      (compiler-ir-instr-cons
        (CompilerIrInstr.CallIndirect
          call-var
          (CompilerIrValue.Function fn-name)
          args
          ret-ty)
        (compiler-ir-instr-cons
          (lower-dispatch-call-return-instr call-var ret-ty)
          CompilerIrInstrList.Nil)))))

(define (lower-dispatch-entry-block
  [cache-name : String]
  [_fn-ty : AstType]
  [cached-var : i64]
  [resolve-label : String]) : CompilerIrBlock
  (compiler-ir-block
    "entry"
    (compiler-ir-instr-cons
      (CompilerIrInstr.BinOp
        cached-var
        CompilerIrBinOp.Ne
        (CompilerIrValue.Global cache-name)
        (CompilerIrValue.I64 0)
        (AstType.Bool))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Branch
          (CompilerIrValue.Var cached-var)
          "cached"
          resolve-label)
        CompilerIrInstrList.Nil))))

(define (lower-dispatch-feature-blocks
  [prefix : String]
  [xcr0-mask : i64]
  [feature-mask : i64]
  [select-label : String]
  [fallback-label : String]
  [base : i64]
  [tail : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [check-label : String (clone prefix)]
    [osxsave-label : String (string.append (clone prefix) "_osxsave")]
    [xcr0-label : String (string.append (clone prefix) "_xcr0")]
    [leaf7-label : String (string.append prefix "_leaf7")]
    [max-leaf-var : i64 base]
    [max-ok-var : i64 (+ base 1)]
    [leaf1-ecx-var : i64 (+ base 2)]
    [osxsave-mask-var : i64 (+ base 3)]
    [osxsave-ok-var : i64 (+ base 4)]
    [xcr0-var : i64 (+ base 5)]
    [xcr0-mask-var : i64 (+ base 6)]
    [xcr0-ok-var : i64 (+ base 7)]
    [leaf7-ebx-var : i64 (+ base 8)]
    [feature-mask-var : i64 (+ base 9)]
    [feature-ok-var : i64 (+ base 10)]
    (compiler-ir-block-cons
      (compiler-ir-block
        check-label
        (compiler-ir-instr-cons
          (CompilerIrInstr.CpuId
            max-leaf-var
            (CompilerIrValue.I64 0)
            (CompilerIrValue.I64 0)
            0)
          (compiler-ir-instr-cons
            (CompilerIrInstr.BinOp
              max-ok-var
              CompilerIrBinOp.Ge
              (CompilerIrValue.Var max-leaf-var)
              (CompilerIrValue.I64 7)
              (AstType.Bool))
            (compiler-ir-instr-cons
              (CompilerIrInstr.Branch
                (CompilerIrValue.Var max-ok-var)
                osxsave-label
                fallback-label)
              CompilerIrInstrList.Nil))))
      (compiler-ir-block-cons
        (compiler-ir-block
          osxsave-label
          (compiler-ir-instr-cons
            (CompilerIrInstr.CpuId
              leaf1-ecx-var
              (CompilerIrValue.I64 1)
              (CompilerIrValue.I64 0)
              2)
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                osxsave-mask-var
                CompilerIrBinOp.BitAnd
                (CompilerIrValue.Var leaf1-ecx-var)
                (CompilerIrValue.I64 134217728)
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.BinOp
                  osxsave-ok-var
                  CompilerIrBinOp.Ne
                  (CompilerIrValue.Var osxsave-mask-var)
                  (CompilerIrValue.I64 0)
                  (AstType.Bool))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Branch
                    (CompilerIrValue.Var osxsave-ok-var)
                    xcr0-label
                    fallback-label)
                  CompilerIrInstrList.Nil)))))
        (compiler-ir-block-cons
          (compiler-ir-block
            xcr0-label
            (compiler-ir-instr-cons
              (CompilerIrInstr.Xgetbv xcr0-var (CompilerIrValue.I64 0))
              (compiler-ir-instr-cons
                (CompilerIrInstr.BinOp
                  xcr0-mask-var
                  CompilerIrBinOp.BitAnd
                  (CompilerIrValue.Var xcr0-var)
                  (CompilerIrValue.I64 xcr0-mask)
                  (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.BinOp
                    xcr0-ok-var
                    CompilerIrBinOp.Eq
                    (CompilerIrValue.Var xcr0-mask-var)
                    (CompilerIrValue.I64 xcr0-mask)
                    (AstType.Bool))
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Branch
                      (CompilerIrValue.Var xcr0-ok-var)
                      leaf7-label
                      fallback-label)
                    CompilerIrInstrList.Nil)))))
          (compiler-ir-block-cons
            (compiler-ir-block
              leaf7-label
              (compiler-ir-instr-cons
                (CompilerIrInstr.CpuId
                  leaf7-ebx-var
                  (CompilerIrValue.I64 7)
                  (CompilerIrValue.I64 0)
                  1)
                (compiler-ir-instr-cons
                  (CompilerIrInstr.BinOp
                    feature-mask-var
                    CompilerIrBinOp.BitAnd
                    (CompilerIrValue.Var leaf7-ebx-var)
                    (CompilerIrValue.I64 feature-mask)
                    (AstType.I64))
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.BinOp
                      feature-ok-var
                      CompilerIrBinOp.Eq
                      (CompilerIrValue.Var feature-mask-var)
                      (CompilerIrValue.I64 feature-mask)
                      (AstType.Bool))
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Branch
                        (CompilerIrValue.Var feature-ok-var)
                        select-label
                        fallback-label)
                      CompilerIrInstrList.Nil)))))
            tail))))))

(define (lower-dispatch-select-blocks
  [cache-name : String]
  [fn-ty : AstType]
  [args : CompilerIrCallArgs]
  [ret-ty : AstType]
  [scalar-name : String]
  [maybe-avx2 : TcMaybeString]
  [maybe-avx512 : TcMaybeString]
  [base : i64]) : CompilerIrBlockList
  (let
    [scalar-blocks : CompilerIrBlockList
      (compiler-ir-block-cons
        (lower-dispatch-select-block
          "select_scalar"
          cache-name
          scalar-name
          fn-ty
          args
          ret-ty
          (+ base 24))
        CompilerIrBlockList.Nil)]
    [with-avx2 : CompilerIrBlockList
      (match maybe-avx2
        [(TcMaybeString.Some avx2-name)
          (compiler-ir-block-cons
            (lower-dispatch-select-block
              "select_avx2"
              cache-name
              avx2-name
              fn-ty
              args
              ret-ty
              (+ base 25))
            scalar-blocks)]
        [(TcMaybeString.No) scalar-blocks])]
    (match maybe-avx512
      [(TcMaybeString.Some avx512-name)
        (compiler-ir-block-cons
          (lower-dispatch-select-block
            "select_avx512"
            cache-name
            avx512-name
            fn-ty
            args
            ret-ty
            (+ base 26))
          with-avx2)]
      [(TcMaybeString.No) with-avx2])))

(define (lower-dispatch-resolve-label
  [maybe-avx2 : TcMaybeString]
  [maybe-avx512 : TcMaybeString]) : String
  (match maybe-avx512
    [(TcMaybeString.Some _) "check_avx512"]
    [(TcMaybeString.No)
      (match maybe-avx2
        [(TcMaybeString.Some _) "check_avx2"]
        [(TcMaybeString.No) "select_scalar"])]))

(define (lower-dispatch-resolve-blocks
  [maybe-avx2 : TcMaybeString]
  [maybe-avx512 : TcMaybeString]
  [base : i64]
  [tail : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [with-avx2 : CompilerIrBlockList
      (match maybe-avx2
        [(TcMaybeString.Some _)
          (lower-dispatch-feature-blocks
            "check_avx2"
            6
            32
            "select_avx2"
            "select_scalar"
            (+ base 12)
            tail)]
        [(TcMaybeString.No) tail])]
    (match maybe-avx512
      [(TcMaybeString.Some _)
        (lower-dispatch-feature-blocks
          "check_avx512"
          230
          1073807360
          "select_avx512"
          (match maybe-avx2
            [(TcMaybeString.Some _) "check_avx2"]
            [(TcMaybeString.No) "select_scalar"])
          (+ base 1)
          with-avx2)]
      [(TcMaybeString.No) with-avx2])))

(define (lower-dispatch-thunk-function
  [logical-name : String]
  [fn-ty : AstType]
  [variants : AstDispatchVariantList]
  [module : String]
  [names : LowerNameCache]
  [spans : CompilerSourceSpans]) : ResultLowerFunction
  (match fn-ty
    [(AstType.Func param-types ret-box)
      (let
        [ret-ty : AstType (tc-type-without-regions (ty-node-get ret-box))]
        [clean-param-types : AstTypeList
          (lower-dispatch-type-list-without-regions (box-get param-types))]
        [param-count : i64 (lower-dispatch-param-type-count clean-param-types)]
        [cache-name : String (lower-dispatch-cache-name logical-name)]
        [args : CompilerIrCallArgs
          (compiler-ir-call-args-from-list
            (lower-dispatch-param-values clean-param-types 0))]
        [maybe-avx2 : TcMaybeString
          (lower-dispatch-find-internal-name
            variants
            module
            names
            logical-name
            (AstDispatchIsa.Avx2))]
        [maybe-avx512 : TcMaybeString
          (lower-dispatch-find-internal-name
            variants
            module
            names
            logical-name
            (AstDispatchIsa.Avx512))]
        (match (lower-dispatch-find-internal-name
          variants
          module
          names
          logical-name
          (AstDispatchIsa.Scalar))
          [(TcMaybeString.Some scalar-name)
            (let
              [blocks : CompilerIrBlockList
                (compiler-ir-block-cons
                  (lower-dispatch-entry-block
                    cache-name
                    fn-ty
                    param-count
                    (lower-dispatch-resolve-label maybe-avx2 maybe-avx512))
                  (compiler-ir-block-cons
                    (lower-dispatch-cached-block
                      cache-name
                      args
                      ret-ty
                      (+ param-count 23))
                    (lower-dispatch-resolve-blocks
                      maybe-avx2
                      maybe-avx512
                      param-count
                      (lower-dispatch-select-blocks
                        cache-name
                        fn-ty
                        args
                        ret-ty
                        scalar-name
                        maybe-avx2
                        maybe-avx512
                        param-count))))]
              (OkLowerFunction
                (compiler-ir-function-cons
                  (CompilerIrFunction.Function
                    logical-name
                    (lower-dispatch-param-list-from-types clean-param-types 0)
                    ret-ty
                    (+ param-count 27)
                    (compiler-ir-block-list-compact blocks))
                  CompilerIrFunctionList.Nil)
                spans))]
          [(TcMaybeString.No)
            (ErrLowerFunction
              (box
                (lower-diagnostic
                  "lower: defdispatch requires a scalar variant")))]))]
    [_
      (ErrLowerFunction
        (box
          (lower-diagnostic
            "lower: defdispatch did not typecheck as a function")))]))

(define (lower-dispatch-lower-variant-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [internal-name : String]
  [isa : AstDispatchIsa]
  [decl : AstDecl]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match decl
    [(AstDecl.DefFn _ params ret body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (lower-function-escaping
          ctx
          top-env
          type-cache
          internal-name
          params
          ret
          body
          spans
          names
          (lower-dispatch-lower-mode isa mode)))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-dispatch-lower-variant-decl
          ctx
          top-env
          type-cache
          internal-name
          isa
          inner
          spans
          names
          mode))]
    [_
      (ErrLowerFunction
        (box
          (lower-diagnostic
            "lower: defdispatch variants must be local functions")))]))

(define (lower-dispatch-lower-variant
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-name : String]
  [variant : AstDispatchVariant]
  [module : String]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match variant
    [(AstDispatchVariant.Variant isa variant-name)
      (let
        [lookup-name : String (lower-dispatch-source-name module variant-name)]
        [variant-logical : String (lower-name-cache-resolve names lookup-name)]
        [internal-name : String
          (lower-dispatch-variant-internal-name
            dispatch-name
            isa
            variant-logical)]
        [handle : i64
          (compiler-symbols-lookup-value-or
            (tc-context-symbols ctx)
            lookup-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-program-decl-at-index
            (tc-context-program ctx)
            (compiler-symbol-handle-index handle))
            [(ResultAstDecl.Ok decl)
              (lower-dispatch-lower-variant-decl
                ctx
                top-env
                type-cache
                internal-name
                isa
                decl
                spans
                names
                mode)]
            [(ResultAstDecl.Err message)
              (ErrLowerFunction (box (lower-diagnostic message)))])
          (ErrLowerFunction
            (box
              (lower-diagnostic
                (string.append
                  "lower: unknown defdispatch variant "
                  variant-name))))))]))

(define (lower-dispatch-lower-variants
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-name : String]
  [variants : AstDispatchVariantList]
  [module : String]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]
  [functions : CompilerIrFunctionList]) : ResultLowerFunction
  (match variants
    [(AstDispatchVariantList.Nil) (OkLowerFunction functions spans)]
    [(AstDispatchVariantList.Cons variant rest)
      (let
        [rest : AstDispatchVariantList (box-get rest)]
        (match (lower-dispatch-lower-variant
          ctx
          top-env
          type-cache
          dispatch-name
          variant
          module
          spans
          names
          mode)
          [(OkLowerFunction lowered-functions function-spans)
            (lower-dispatch-lower-variants
              ctx
              top-env
              type-cache
              dispatch-name
              rest
              module
              function-spans
              names
              mode
              (lower-function-list-append lowered-functions functions))]
          [(ErrLowerFunction message) (ErrLowerFunction message)]))]))

(define (lower-dispatch-decl
  [ctx : TcContext]
  [_top-env : TcTypeEnv]
  [local-top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [name : String]
  [variants : AstDispatchVariantList]
  [spans : CompilerSourceSpans]
  [name-cache : LowerNameCache]
  [mode : CompilerLowerMode]
  [module : String]) : ResultLowerDispatchDecl
  (let
    [decl-ctx : TcContext (tc-context-with-module ctx module)]
    [logical-name : String
      (lower-current-decl-logical-name-cache name-cache module name)]
    (match (tc-lookup local-top-env name)
      [(ResultTcType.Ok dispatch-ty)
        (let
          [fn-ty : AstType
            (tc-type-without-regions (tc-resolve-type decl-ctx dispatch-ty))]
          (match (lower-dispatch-lower-variants
            decl-ctx
            local-top-env
            type-cache
            logical-name
            variants
            module
            spans
            name-cache
            mode
            CompilerIrFunctionList.Nil)
            [(OkLowerFunction variant-functions variant-spans)
              (match (lower-dispatch-thunk-function
                logical-name
                fn-ty
                variants
                module
                name-cache
                variant-spans)
                [(OkLowerFunction thunk-functions thunk-spans)
                  (OkLowerDispatchDecl
                    (box
                      (LowerDispatchDecl
                        (CompilerIrGlobal.Global
                          (lower-dispatch-cache-name logical-name)
                          fn-ty
                          (CompilerIrValue.I64 0))
                        (lower-function-list-append
                          thunk-functions
                          variant-functions)
                        thunk-spans)))]
                [(ErrLowerFunction message) (ErrLowerDispatchDecl message)])]
            [(ErrLowerFunction message) (ErrLowerDispatchDecl message)]))]
      [(ResultTcType.Err message)
        (ErrLowerDispatchDecl (box (lower-diagnostic message)))])))

(define (lower-rvo-early-return-functions-from-decls-in-module
  [decls : AstDeclList]
  [names : LowerNameEnv]
  [module : String]
  [out : hashmap.StringI64Map]) : hashmap.StringI64Map
  (match decls
    [(AstDeclList.Nil) out]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.Module next-module)
            (lower-rvo-early-return-functions-from-decls-in-module
              rest
              names
              (intern-str next-module)
              out)]
          [(AstDecl.Unsafe inner-box)
            (lower-rvo-early-return-functions-from-decls-in-module
              (ast-decl-cons (box-get inner-box) rest)
              names
              module
              out)]
          [(AstDecl.ComptimeDecl _ template-box)
            (lower-rvo-early-return-functions-from-decls-in-module
              (ast-decl-cons (box-get template-box) rest)
              names
              module
              out)]
          [(AstDecl.DefFn name _ _ body-box _)
            (let
              [next-out : hashmap.StringI64Map
                (if (lower-rvo-node-has-early-return? body-box)
                  (hashmap.string-i64-map-put
                    out
                    (lower-current-decl-logical-name
                      names
                      module
                      (intern-str name))
                    1)
                  out)]
              (lower-rvo-early-return-functions-from-decls-in-module
                rest
                names
                module
                next-out))]
          [_
            (lower-rvo-early-return-functions-from-decls-in-module
              rest
              names
              module
              out)]))]))

(define (lower-rvo-early-return-functions-from-decls
  [decls : AstDeclList]
  [names : LowerNameEnv]) : hashmap.StringI64Map
  (lower-rvo-early-return-functions-from-decls-in-module
    decls
    names
    ""
    (hashmap.string-i64-map-with-capacity 8192)))

(define (lower-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [globals : CompilerIrGlobalList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [spans : CompilerSourceSpans]
  [names : LowerNameEnv]
  [mode : CompilerLowerMode]) : ResultLowerDecls
  (let
    [dispatch-name-cache : LowerNameCache (lower-name-cache-from-env names)]
    [dispatch-variants : hashmap.StringI64Map
      (lower-dispatch-variant-set-from-decls
        decls
        AstDeclPathList.Nil
        "<source>"
        dispatch-name-cache)]
    (begin
      ;; #3759: build the shared global name/type caches once; per-module caches
      ;; are small overlays that fall through to them. The initial cur caches are
      ;; empty overlays (everything resolves via the global caches) for decls in
      ;; the leading "" module before the first (module ...) marker.
      (set! lower-active-global-name-cache (lower-name-cache-from-env names))
      (set! lower-decls-global-type-cache (lower-type-cache-from-env top-env))
      (set!
        lower-rvo-early-return-functions
        (lower-rvo-early-return-functions-from-decls decls names))
      (lower-decls-in-module
        ctx
        top-env
        top-env
        decls
        globals
        functions
        externs
        spans
        names
        (lower-name-cache-overlay (LowerNameNil))
        (lower-type-cache-overlay (TcTypeEnv.Nil))
        dispatch-variants
        mode
        ""))))

;; #2598: lower every top-level decl of the expanded program. This used to be
;; a tail-recursive walk (one call per decl), but the inline-aggregate TCO
;; guard (#2597) declines frame reuse here, so a whole-compiler input stacked
;; one ~56KB frame per decl (7,035 frames = 402MB of the measured 502MB stack
;; peak that forced the 1GB Windows reserves, #2599). Iterate instead; the
;; threaded accumulators become loop state.
(define (lower-skip-runtime-until-next-module [decls : AstDeclList]) : AstDeclList
  (match decls
    [(AstDeclList.Nil) AstDeclList.Nil]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.Module _) decls]
          [_
            (let
              [kept-rest : AstDeclList
                (lower-skip-runtime-until-next-module rest)]
              (if (lower-type-decl? decl)
                (ast-decl-cons decl kept-rest)
                kept-rest))]))]))

(define (lower-decls-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-top-env : TcTypeEnv]
  [decls : AstDeclList]
  [globals : CompilerIrGlobalList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [spans : CompilerSourceSpans]
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [type-cache : LowerTypeCache]
  [dispatch-variants : hashmap.StringI64Map]
  [mode : CompilerLowerMode]
  [module : String]) : ResultLowerDecls
  (let
    [cur-decls : AstDeclList decls]
    [cur-local-top-env : TcTypeEnv local-top-env]
    [cur-globals : CompilerIrGlobalList globals]
    [cur-functions : CompilerIrFunctionList functions]
    [cur-externs : CompilerIrExternList externs]
    [cur-spans : CompilerSourceSpans spans]
    [cur-name-cache : LowerNameCache name-cache]
    [cur-type-cache : LowerTypeCache type-cache]
    [cur-module : String module]
    [result : ResultLowerDecls
      (ErrLowerDecls (box (lower-diagnostic "lower: internal decls walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match cur-decls
          [(AstDeclList.Nil)
            (begin
              (set!
                result
                (OkLowerDecls
                  (box
                    (LowerDeclsSuccess
                      (lower-global-list-reverse cur-globals)
                      (lower-function-list-reverse cur-functions)
                      (lower-extern-list-reverse cur-externs)
                      cur-spans))))
              (set! done true))]
          [(AstDeclList.Cons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              (match decl
                [(AstDecl.Unsafe inner-box)
                  (let
                    [inner : AstDecl (box-get inner-box)]
                    (set! cur-decls (ast-decl-cons inner rest)))]
                [(AstDecl.ModuleBody _ _) (set! cur-decls rest)]
                [(AstDecl.Def name _ expr-box)
                  (let
                    [expr : AstExpr (ast-node-get expr-box)]
                    [decl-ctx : TcContext
                      (tc-context-with-module ctx cur-module)]
                    (match (lower-top-decl-type-or-check
                      decl-ctx
                      cur-local-top-env
                      decl)
                      [(ResultTcType.Ok ty)
                        (let
                          [global-ty : AstType (tc-type-without-regions ty)]
                          [global-name : String
                            (lower-current-decl-logical-name-cache
                              cur-name-cache
                              cur-module
                              (intern-str name))]
                          (match (lower-global-value
                            cur-name-cache
                            expr
                            global-ty)
                            [(OkLowerValue value)
                              (begin
                                (set!
                                  cur-globals
                                  (compiler-ir-global-cons
                                    (CompilerIrGlobal.Global
                                      global-name
                                      global-ty
                                      value)
                                    cur-globals))
                                (set! cur-decls rest))]
                            ;; A global whose initializer is not a compile-time
                            ;; constant is evaluated at startup by a hidden
                            ;; `__global_init_<name>` function whose return
                            ;; value the backend stores into the global before
                            ;; `main`. This applies to any non-unit type
                            ;; (scalars as well as aggregates), mirroring the
                            ;; former Rust lowerer, which emits an init function
                            ;; whenever `extract_const` yields no constant.
                            [(ErrLowerValue _)
                              (match (lower-function-escaping
                                decl-ctx
                                cur-local-top-env
                                cur-type-cache
                                (lower-global-init-function-name global-name)
                                AstParamList.Nil
                                global-ty
                                expr
                                cur-spans
                                cur-name-cache
                                mode)
                                [(OkLowerFunction init-funcs init-spans)
                                  (begin
                                    (set!
                                      cur-globals
                                      (compiler-ir-global-cons
                                        (CompilerIrGlobal.Global
                                          global-name
                                          global-ty
                                          CompilerIrValue.Unit)
                                        cur-globals))
                                    (set!
                                      cur-functions
                                      (lower-function-list-append
                                        init-funcs
                                        cur-functions))
                                    (set! cur-spans init-spans)
                                    (set! cur-decls rest))]
                                [(ErrLowerFunction init-message)
                                  (begin
                                    (set! result (ErrLowerDecls init-message))
                                    (set! done true))])]))]
                      [(ResultTcType.Err message)
                        (begin
                          (set!
                            result
                            (ErrLowerDecls (box (lower-diagnostic message))))
                          (set! done true))]))]
                [(AstDecl.Extern name _ metadata ty)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module ctx cur-module)]
                    [resolved-ty : AstType (tc-resolve-type decl-ctx ty)]
                    (if (and
                      (tc-type-contains-reference? resolved-ty)
                      (not
                        (lower-supported-reference-extern?
                          decl-ctx
                          name
                          resolved-ty)))
                      (begin
                        (set!
                          result
                          (ErrLowerDecls
                            (box
                              (lower-diagnostic
                                (lower-reference-support-message)))))
                        (set! done true))
                      (begin
                        (set!
                          cur-externs
                          (compiler-ir-extern-cons
                            (CompilerIrExtern.Extern
                              (intern-str name)
                              (tc-type-without-regions resolved-ty)
                              (ast-extern-metadata-abi metadata)
                              (ast-extern-metadata-symbol metadata)
                              (ast-extern-metadata-link-inputs metadata)
                              false)
                            cur-externs))
                        (set! cur-decls rest))))]
                [(AstDecl.DefFn name params ret body-box export)
                  (let
                    [body : AstExpr (ast-node-get body-box)]
                    [decl-ctx : TcContext
                      (tc-context-with-module ctx cur-module)]
                    [logical-name : String
                      (lower-current-decl-logical-name-cache
                        cur-name-cache
                        cur-module
                        (intern-str name))]
                    (if (hashmap.string-i64-map-contains?
                      dispatch-variants
                      logical-name)
                      (set! cur-decls rest)
                      (begin
                        (cfg
                          compile-profile
                          (compiler-lower-profile-detail-start))
                        (match (lower-function-escaping
                          decl-ctx
                          cur-local-top-env
                          cur-type-cache
                          logical-name
                          params
                          ret
                          body
                          cur-spans
                          cur-name-cache
                          mode)
                          [(OkLowerFunction lowered-functions function-spans)
                            (let
                              [next-externs : CompilerIrExternList
                                (match export
                                  [(AstFnExport.No) cur-externs]
                                  [(AstFnExport.Export symbol)
                                    (compiler-ir-extern-cons
                                      (CompilerIrExtern.Extern
                                        logical-name
                                        (ast-ty-func
                                          (tc-type-list-without-regions
                                            (tc-param-type-list decl-ctx params))
                                          (tc-type-without-regions
                                            (tc-resolve-type decl-ctx ret)))
                                        (AstExternAbi.C)
                                        (intern-str symbol)
                                        AstExternLinkInputList.Nil
                                        true)
                                      cur-externs)])]
                              (begin
                                (cfg
                                  compile-profile
                                  (compiler-lower-profile-detail-finish
                                    "function"
                                    logical-name))
                                (set!
                                  cur-functions
                                  (lower-function-list-append
                                    lowered-functions
                                    cur-functions))
                                (set! cur-externs next-externs)
                                (set! cur-spans function-spans)
                                (set! cur-decls rest)))]
                          [(ErrLowerFunction message)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-lower-profile-detail-finish
                                  "function"
                                  logical-name))
                              (set! result (ErrLowerDecls message))
                              (set! done true))]))))]
                [(AstDecl.DefMacro _ _ _ _) (set! cur-decls rest)]
                [(AstDecl.DefDispatch name variants)
                  (match (lower-dispatch-decl
                    ctx
                    top-env
                    cur-local-top-env
                    cur-type-cache
                    (intern-str name)
                    variants
                    cur-spans
                    cur-name-cache
                    mode
                    cur-module)
                    [(OkLowerDispatchDecl lowered)
                      (match (box-get lowered)
                        [(LowerDispatchDecl
                            cache-global
                            lowered-functions
                            function-spans)
                          (begin
                            (set!
                              cur-globals
                              (compiler-ir-global-cons cache-global cur-globals))
                            (set!
                              cur-functions
                              (lower-function-list-append
                                lowered-functions
                                cur-functions))
                            (set! cur-spans function-spans)
                            (set! cur-decls rest))])]
                    [(ErrLowerDispatchDecl message)
                      (begin
                        (set! result (ErrLowerDecls message))
                        (set! done true))])]
                [(AstDecl.Import _) (set! cur-decls rest)]
                [(AstDecl.IncludeStr _ _) (set! cur-decls rest)]
                [(AstDecl.IncludeBin _ _) (set! cur-decls rest)]
                [(AstDecl.Module next-module)
                  (let
                    [next-module-str : String (intern-str next-module)]
                    [skip-runtime : bool
                      (lower-comptime-runtime-skip-module? next-module-str)]
                    (match (lower-module-local-envs
                      ctx
                      top-env
                      names
                      cur-name-cache
                      next-module-str)
                      [(OkLowerModuleLocalEnv
                          next-local-top-env
                          _
                          local-type-env
                          local-name-only)
                        (begin
                          (set! cur-local-top-env next-local-top-env)
                          ;; #3759: overlay just this module's local names;
                          ;; misses fall through to the shared global name cache
                          ;; (set once) instead of rebuilding the whole global
                          ;; name set per module.
                          (set!
                            cur-name-cache
                            (lower-name-cache-overlay local-name-only))
                          ;; #3759: overlay just this module's local type
                          ;; bindings; misses fall through to the shared global
                          ;; type cache (set once from top-env) instead of
                          ;; rebuilding the whole global type set per module.
                          (set!
                            cur-type-cache
                            (lower-type-cache-overlay local-type-env))
                          (set! cur-module next-module-str)
                          (set!
                            cur-decls
                            (if skip-runtime
                              (lower-skip-runtime-until-next-module rest)
                              rest)))]
                      [(ErrLowerModuleLocalEnv message)
                        (begin
                          (set!
                            result
                            (ErrLowerDecls (box (lower-diagnostic message))))
                          (set! done true))]))]
                [(AstDecl.Test _ _ _) (set! cur-decls rest)]
                [(AstDecl.DefEnum name _ variants)
                  (begin
                    (if (lower-comptime-runtime-skip-module? cur-module)
                      unit
                      (set!
                        cur-globals
                        (lower-nullary-variant-globals
                          (lower-current-decl-logical-name-cache
                            cur-name-cache
                            cur-module
                            (intern-str name))
                          variants
                          0
                          cur-globals)))
                    (set! cur-decls rest))]
                [(AstDecl.DefEnumLifetimes name _ _ variants)
                  (begin
                    (if (lower-comptime-runtime-skip-module? cur-module)
                      unit
                      (set!
                        cur-globals
                        (lower-nullary-variant-globals
                          (lower-current-decl-logical-name
                            names
                            cur-module
                            (intern-str name))
                          variants
                          0
                          cur-globals)))
                    (set! cur-decls rest))]
                [(AstDecl.DefStruct name _ cleanup fields)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module ctx cur-module)]
                    [logical-name : String
                      (match cleanup
                        [(AstStructCleanup.No) ""]
                        [(AstStructCleanup.Fn cleanup-name)
                          (lower-current-decl-logical-name-cache
                            cur-name-cache
                            cur-module
                            (intern-str cleanup-name))])]
                    [struct-ty : AstType
                      (AstType.Struct
                        (intern
                          (compiler-symbol-module-key
                            cur-module
                            (intern-str name))))]
                    (match (lower-struct-cleanup-decl
                      decl-ctx
                      cur-local-top-env
                      cur-type-cache
                      logical-name
                      cleanup
                      struct-ty
                      fields
                      cur-spans
                      cur-name-cache
                      mode)
                      [(OkLowerFunction cleanup-functions cleanup-spans)
                        (begin
                          (set!
                            cur-functions
                            (lower-function-list-append
                              cleanup-functions
                              cur-functions))
                          (set! cur-spans cleanup-spans)
                          (set! cur-decls rest))]
                      [(ErrLowerFunction message)
                        (begin
                          (set! result (ErrLowerDecls message))
                          (set! done true))]))]
                [(AstDecl.DefStructLifetimes name lifetimes _ cleanup fields)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module ctx cur-module)]
                    [logical-name : String
                      (match cleanup
                        [(AstStructCleanup.No) ""]
                        [(AstStructCleanup.Fn cleanup-name)
                          (lower-current-decl-logical-name-cache
                            cur-name-cache
                            cur-module
                            (intern-str cleanup-name))])]
                    [struct-ty : AstType
                      (ast-ty-struct-args
                        (intern
                          (compiler-symbol-module-key
                            cur-module
                            (intern-str name)))
                        lifetimes)]
                    (match (lower-struct-cleanup-decl
                      decl-ctx
                      cur-local-top-env
                      cur-type-cache
                      logical-name
                      cleanup
                      struct-ty
                      fields
                      cur-spans
                      cur-name-cache
                      mode)
                      [(OkLowerFunction cleanup-functions cleanup-spans)
                        (begin
                          (set!
                            cur-functions
                            (lower-function-list-append
                              cleanup-functions
                              cur-functions))
                          (set! cur-spans cleanup-spans)
                          (set! cur-decls rest))]
                      [(ErrLowerFunction message)
                        (begin
                          (set! result (ErrLowerDecls message))
                          (set! done true))]))]
                [(AstDecl.ComptimeDecl _ template-box)
                  (let
                    [template : AstDecl (box-get template-box)]
                    (set! cur-decls (ast-decl-cons template rest)))]))]))
      result)))

(define (lower-compiler-program-checked-with-names-mode
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [program : AstProgram]
  [names : LowerNameEnv]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (begin
    (lower-refresh-marker-ids!)
    ;; Clone-root discovery and checked typechecking can probe aggregate layout
    ;; with helper contexts before final lowering. Emitted code must use one
    ;; internally consistent layout view for all functions in this pass.
    (tc-agg-caches-reset!)
    (tc-nominal-owner-cache-reset!)
    (match program
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (match (lower-decls
            ctx
            top-env
            decls
            CompilerIrGlobalList.Nil
            CompilerIrFunctionList.Nil
            CompilerIrExternList.Nil
            (compiler-source-spans-empty)
            names
            mode)
            [(OkLowerDecls payload)
              (let
                [success : LowerDeclsSuccess (box-get payload)]
                (OkCompilerLower
                  (CompilerIrProgram.Program
                    (struct-get success globals)
                    (compiler-ir-function-list-compact
                      (struct-get success functions))
                    (struct-get success externs))
                  (struct-get success spans)))]
            [(ErrLowerDecls message) (ErrCompilerLower message)]))])))

(define (lower-compiler-program-checked-with-names
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [program : AstProgram]
  [names : LowerNameEnv]) : ResultCompilerLower
  (lower-compiler-program-checked-with-names-mode
    ctx
    top-env
    program
    names
    (CompilerLowerScalar)))

(define (lower-compiler-program-checked
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [program : AstProgram]) : ResultCompilerLower
  (lower-compiler-program-checked-with-names ctx top-env program LowerNameNil))

;; Internal `expanded` workers assume macro expansion has already run; the
;; public `-mode` wrappers below own the expand -> specialize -> typecheck
;; boundary so every lowering path (scalar and SPMD) expands exactly once.
(define (lower-compiler-expanded-program-unlocated-mode
  [program : AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (match (compiler-specialize-program program)
    [(ResultSpecProgram.Ok specialized)
      (match (typecheck-compiler-specialized-program-with-paths-checked
        specialized
        AstDeclPathList.Nil)
        [(ResultCompilerTypecheckChecked.Ok _ ctx top-env)
          (let
            [alias-names : LowerNameEnv
              (match specialized
                [(AstProgram.Program decls-box)
                  (let
                    [decls : AstDeclList (box-get decls-box)]
                    (lower-name-env-with-import-aliases
                      decls
                      AstDeclPathList.Nil
                      "<source>"
                      LowerNameNil
                      false))])]
            (lower-compiler-program-checked-with-names-mode
              ctx
              top-env
              specialized
              alias-names
              mode))]
        [(ResultCompilerTypecheckChecked.Err diag) (ErrCompilerLower diag)])]
    [(ResultSpecProgram.Err diag) (ErrCompilerLower diag)]))

(define (lower-compiler-program-unlocated-mode
  [program : AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (begin
    (tc-agg-caches-reset!)
    ;; Generate declaration families before macro expansion (see
    ;; typecheck-compiler-program-with-paths for why).
    (match (gen-normalize-program program)
      [(ResultGenProgram.Ok generated)
        (match (macro-expand-program generated)
          [(ResultMacroExpand.Ok expanded _)
            (lower-compiler-expanded-program-unlocated-mode expanded mode)]
          [(ResultMacroExpand.Err diag) (ErrCompilerLower diag)])]
      [(ResultGenProgram.Err diag) (ErrCompilerLower diag)])))

(define (lower-compiler-program-unlocated [program : AstProgram]) : ResultCompilerLower
  (lower-compiler-program-unlocated-mode program (CompilerLowerScalar)))

(define (lower-compiler-program-with-path-mode
  [path : String]
  [program : AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (match (lower-compiler-program-unlocated-mode program mode)
    [(OkCompilerLower ir spans) (OkCompilerLower ir spans)]
    [(ErrCompilerLower diag)
      (ErrCompilerLower (box (lower-diagnostic-with-path (box-get diag) path)))]))

(define (lower-compiler-program-with-path
  [path : String]
  [program : AstProgram]) : ResultCompilerLower
  (lower-compiler-program-with-path-mode path program (CompilerLowerScalar)))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-active-and-pools
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerLower
  (begin
    (ast-node-pool-context-install! pools)
    (cfg compile-profile (compiler-lower-profile-start))
    (let
      [needs-specialization : bool (compiler-specialize-needed? program)]
      [specialized-paths : AstDeclPathList
        (if needs-specialization
          AstDeclPathList.Nil
          paths)]
      [names : LowerNameEnv
        (match program
          [(AstProgram.Program decls-box)
            (let
              [decls : AstDeclList (box-get decls-box)]
              (lower-name-env-from-decls decls paths entry-path LowerNameNil))])]
      (match (if needs-specialization
        (compiler-specialize-program-with-pools program pools)
        (ResultSpecProgram.Ok program))
        [(ResultSpecProgram.Ok specialized)
          (begin
            (ast-node-pool-context-install! pools)
            (cfg compile-profile (compiler-lower-profile-finish "specialize"))
            (cfg compile-profile (compiler-lower-profile-start))
            (let
              [prune-names : LowerNameEnv
                (if needs-specialization
                  (match specialized
                    [(AstProgram.Program decls-box)
                      (let
                        [decls : AstDeclList (box-get decls-box)]
                        (lower-name-env-from-decls
                          decls
                          specialized-paths
                          entry-path
                          LowerNameNil))])
                  names)]
              (match (lower-prune-unreachable-functions-with-clone-roots
                entry-path
                specialized
                specialized-paths
                prune-names
                (CloneNameList.Nil))
                [(LowerPrunedProgram base-program base-paths)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-lower-profile-finish "prune"))
                    (cfg compile-profile (compiler-lower-profile-start))
                    (ast-node-pool-context-capture-active! pools)
                    (let
                      [clone-pools : AstNodePoolContext pools]
                      (match (lower-reachable-clone-roots
                        clone-pools
                        base-program
                        base-paths
                        prune-names)
                        [(OkLowerCloneRoots clone-roots)
                          (begin
                            (cfg
                              compile-profile
                              (compiler-lower-profile-finish "clone_roots"))
                            (cfg compile-profile (compiler-lower-profile-start))
                            (let
                              [checked-program : AstProgram
                                (clone-augment-program-with-roots-and-pools
                                  clone-pools
                                  base-program
                                  clone-roots)]
                              [checked-paths : AstDeclPathList base-paths]
                              [checked-names : LowerNameEnv
                                (match checked-program
                                  [(AstProgram.Program decls-box)
                                    (let
                                      [decls : AstDeclList (box-get decls-box)]
                                      (lower-name-env-from-decls
                                        decls
                                        checked-paths
                                        entry-path
                                        LowerNameNil))])]
                              [lower-names : LowerNameEnv
                                (if needs-specialization
                                  (match checked-program
                                    [(AstProgram.Program decls-box)
                                      (let
                                        [decls : AstDeclList
                                          (box-get decls-box)]
                                        (lower-name-env-add-clone-decls
                                          decls
                                          checked-paths
                                          entry-path
                                          names))])
                                  checked-names)]
                              (begin
                                (ast-node-pool-context-install! clone-pools)
                                (cfg
                                  compile-profile
                                  (compiler-lower-profile-finish
                                    "clone_augment_names"))
                                (cfg
                                  compile-profile
                                  (compiler-lower-profile-start))
                                (match (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools
                                  checked-program
                                  checked-paths
                                  stdlib-roots
                                  cache-scope
                                  clone-pools)
                                  [(ResultCompilerTypecheckChecked.Ok
                                      _
                                      ctx
                                      top-env)
                                    (begin
                                      (ast-node-pool-context-install!
                                        clone-pools)
                                      (cfg
                                        compile-profile
                                        (compiler-lower-profile-finish
                                          "typecheck"))
                                      (cfg
                                        compile-profile
                                        (compiler-lower-profile-pools
                                          "typecheck"
                                          clone-pools))
                                      (cfg
                                        compile-profile
                                        (compiler-lower-profile-pools
                                          "pre_decls"
                                          clone-pools))
                                      (cfg
                                        compile-profile
                                        (compiler-lower-profile-program-counts
                                          "pre_decls"
                                          checked-program))
                                      (cfg
                                        compile-profile
                                        (compiler-lower-profile-start))
                                      (match (lower-compiler-program-checked-with-names-mode
                                        ctx
                                        top-env
                                        checked-program
                                        lower-names
                                        mode)
                                        [(OkCompilerLower ir spans)
                                          (begin
                                            (cfg
                                              compile-profile
                                              (compiler-lower-profile-finish
                                                "decls"))
                                            (cfg
                                              compile-profile
                                              (compiler-lower-profile-ir-shape
                                                "after_decls"
                                                ir))
                                            (cfg
                                              compile-profile
                                              (compiler-lower-profile-ir-arena
                                                "after_decls"))
                                            (OkCompilerLower ir spans))]
                                        [(ErrCompilerLower diag)
                                          (begin
                                            (cfg
                                              compile-profile
                                              (compiler-lower-profile-finish
                                                "decls"))
                                            (ErrCompilerLower
                                              (box
                                                (lower-diagnostic-with-path
                                                  (box-get diag)
                                                  entry-path))))]))]
                                  [(ResultCompilerTypecheckChecked.Err diag)
                                    (begin
                                      (cfg
                                        compile-profile
                                        (compiler-lower-profile-finish
                                          "typecheck"))
                                      (ErrCompilerLower diag))]))))]
                        [(ErrLowerCloneRoots diag)
                          (begin
                            (cfg
                              compile-profile
                              (compiler-lower-profile-finish "clone_roots"))
                            (ErrCompilerLower diag))])))])))]
        [(ResultSpecProgram.Err diag)
          (begin
            (cfg compile-profile (compiler-lower-profile-finish "specialize"))
            (ErrCompilerLower
              (box (lower-diagnostic-with-path (box-get diag) entry-path))))]))))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-active
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]) : ResultCompilerLower
  (lower-compiler-expanded-program-with-decl-paths-mode-cache-active-and-pools
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    (ast-node-pool-context-capture-active)))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]) : ResultCompilerLower
  (let
    [prev-active : bool lower-entry-main-module-active]
    [prev-module : String lower-entry-main-module]
    [selection : LowerMaybeEntryMainModule
      (lower-entry-main-selection-for-program entry-path program paths)]
    (begin
      ;; Inline-test harnesses are generated inside the source module so they
      ;; can call private helpers; the selected entry still needs ABI name main.
      (lower-entry-main-selection-install! selection)
      (let
        [result : ResultCompilerLower
          (lower-compiler-expanded-program-with-decl-paths-mode-cache-active
            entry-path
            program
            paths
            mode
            stdlib-roots
            cache-scope)]
        (begin
          (lower-entry-main-selection-restore! prev-active prev-module)
          result)))))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerLower
  (begin
    (ast-node-pool-context-install! pools)
    (let
      [prev-active : bool lower-entry-main-module-active]
      [prev-module : String lower-entry-main-module]
      [selection : LowerMaybeEntryMainModule
        (lower-entry-main-selection-for-program entry-path program paths)]
      (begin
        (lower-entry-main-selection-install! selection)
        (let
          [result : ResultCompilerLower
            (lower-compiler-expanded-program-with-decl-paths-mode-cache-active-and-pools
              entry-path
              program
              paths
              mode
              stdlib-roots
              cache-scope
              pools)]
          (begin
            (lower-entry-main-selection-restore! prev-active prev-module)
            result))))))

(define (lower-compiler-expanded-program-with-decl-paths-mode
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-expanded-program-with-decl-paths-mode-cache
    entry-path
    program
    paths
    mode
    (vector.string-vec-new)
    (tc-prefix-default-cache-scope)))

(define (lower-compiler-program-with-decl-paths-mode-cache
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    (ast-node-pool-context-capture-active)))

(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerLower
  (begin
    (ast-node-pool-context-install! pools)
    (cfg compile-profile (compiler-lower-profile-start))
    (tc-agg-caches-reset!)
    ;; Generate declaration families before macro expansion (see
    ;; typecheck-compiler-program-with-paths for why).
    (match (gen-normalize-program-with-paths-and-pools
      program
      paths
      entry-path
      pools)
      [(ResultGenProgramWithPaths.Ok generated generated-paths)
        (begin
          (ast-node-pool-context-install! pools)
          (match (macro-expand-program-with-paths-and-pools-roots-cfg
            generated
            generated-paths
            pools
            stdlib-roots
            (typecheck-compiler-source-language-cfgs))
            [(ResultMacroExpand.Ok expanded expanded-paths)
              (begin
                (ast-node-pool-context-install! pools)
                (cfg
                  compile-profile
                  (compiler-lower-profile-finish "macro_expand"))
                (cfg
                  compile-profile
                  (compiler-lower-profile-pools "macro_expand" pools))
                (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools
                  entry-path
                  expanded
                  expanded-paths
                  mode
                  stdlib-roots
                  cache-scope
                  pools))]
            [(ResultMacroExpand.Err diag)
              (begin
                (cfg
                  compile-profile
                  (compiler-lower-profile-finish "macro_expand"))
                (ErrCompilerLower
                  (box (lower-diagnostic-with-path (box-get diag) entry-path))))]))]
      [(ResultGenProgramWithPaths.Err diag)
        (begin
          (cfg compile-profile (compiler-lower-profile-finish "macro_expand"))
          (ErrCompilerLower
            (box (lower-diagnostic-with-path (box-get diag) entry-path))))])))

(define (lower-compiler-program-with-decl-paths-mode
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache
    entry-path
    program
    paths
    mode
    (vector.string-vec-new)
    (tc-prefix-default-cache-scope)))

(define (lower-compiler-program-with-decl-paths
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode
    entry-path
    program
    paths
    (CompilerLowerScalar)))

(define (lower-compiler-program [program : AstProgram]) : ResultCompilerLower
  (lower-compiler-program-with-path "<source>" program))

(define (lower-compiler-source [src : String]) : ResultCompilerLower
  (lower-compiler-source-with-path "<source>" src))

(define (lower-compiler-source-with-mode
  [src : String]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode "<source>" src mode))

(define (lower-source-decls-define-module?
  [decls : AstDeclList]
  [module : String]) : bool
  (match decls
    [(AstDeclList.Nil) false]
    [(AstDeclList.Cons decl rest)
      (match decl
        [(AstDecl.Module name)
          (if (string.eq (intern-str name) module)
            true
            (lower-source-decls-define-module? (box-get rest) module))]
        [_ (lower-source-decls-define-module? (box-get rest) module)])]))

(define (lower-source-stdlib-import-needs-loader?
  [all-decls : AstDeclList]
  [kind : AstImportKind]
  [path : String]) : bool
  (if (typecheck-compiler-source-stdlib-import-kind? kind path)
    (match kind
      [(AstImportKind.Module)
        (not (lower-source-decls-define-module? all-decls path))]
      [_ true])
    false))

(define (lower-source-node-has-import-call? [id : i64]) : bool
  (lower-source-expr-has-import-call? (ast-node-get id)))

(define (lower-source-expr-list-has-import-call? [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprList.Nil) false]
    [(AstExprList.Cons head rest)
      (or
        (lower-source-node-has-import-call? head)
        (lower-source-expr-list-has-import-call? (box-get rest)))]))

(define (lower-source-let-bindings-have-import-call?
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingList.Nil) false]
    [(AstLetBindingList.Cons binding rest)
      (or
        (match binding
          [(AstLetBinding.Binding _ _ init-box)
            (lower-source-node-has-import-call? init-box)])
        (lower-source-let-bindings-have-import-call? (box-get rest)))]))

(define (lower-source-match-arms-have-import-call? [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmList.Nil) false]
    [(AstMatchArmList.Cons arm rest)
      (or
        (match arm
          [(AstMatchArm.Arm _ body-box)
            (lower-source-node-has-import-call? body-box)])
        (lower-source-match-arms-have-import-call? (box-get rest)))]))

(define (lower-source-resource-bindings-have-import-call?
  [bindings : AstResourceBindingList]) : bool
  (match bindings
    [(AstResourceBindingList.Nil) false]
    [(AstResourceBindingList.Cons binding rest)
      (or
        (match binding
          [(AstResourceBinding.Binding _ acquire-box cleanup-box)
            (or
              (lower-source-node-has-import-call? acquire-box)
              (lower-source-node-has-import-call? cleanup-box))])
        (lower-source-resource-bindings-have-import-call? (box-get rest)))]))

(define (lower-source-call-head-import? [func-box : i64]) : bool
  (match (ast-expr-unspan (ast-node-get func-box))
    [(AstExpr.Var name) (= name (intern "import"))]
    [_ false]))

(define (lower-source-expr-has-import-call? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Call func-box args)
      (or
        (lower-source-call-head-import? func-box)
        (lower-source-node-has-import-call? func-box)
        (lower-source-expr-list-has-import-call? args))]
    [(AstExpr.BracketClause items)
      (lower-source-expr-list-has-import-call? items)]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (lower-source-node-has-import-call? left-box)
        (lower-source-node-has-import-call? right-box))]
    [(AstExpr.Unary _ inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-source-node-has-import-call? cond-box)
        (lower-source-node-has-import-call? then-box)
        (lower-source-node-has-import-call? else-box))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-source-let-bindings-have-import-call? bindings)
            (lower-source-node-has-import-call? body-box))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (lower-source-node-has-import-call? body-box)])]
    [(AstExpr.Tuple exprs) (lower-source-expr-list-has-import-call? exprs)]
    [(AstExpr.TupleRef tuple-box index-box)
      (or
        (lower-source-node-has-import-call? tuple-box)
        (lower-source-node-has-import-call? index-box))]
    [(AstExpr.Array exprs) (lower-source-expr-list-has-import-call? exprs)]
    [(AstExpr.MakeArray _ len-box) (lower-source-node-has-import-call? len-box)]
    [(AstExpr.ArrayRef array-box index-box)
      (or
        (lower-source-node-has-import-call? array-box)
        (lower-source-node-has-import-call? index-box))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (or
        (lower-source-node-has-import-call? array-box)
        (lower-source-node-has-import-call? index-box)
        (lower-source-node-has-import-call? value-box))]
    [(AstExpr.ArrayPush array-box value-box)
      (or
        (lower-source-node-has-import-call? array-box)
        (lower-source-node-has-import-call? value-box))]
    [(AstExpr.StringRef string-box index-box)
      (or
        (lower-source-node-has-import-call? string-box)
        (lower-source-node-has-import-call? index-box))]
    [(AstExpr.While cond-box body-box)
      (or
        (lower-source-node-has-import-call? cond-box)
        (lower-source-node-has-import-call? body-box))]
    [(AstExpr.Begin exprs) (lower-source-expr-list-has-import-call? exprs)]
    [(AstExpr.Unsafe exprs) (lower-source-expr-list-has-import-call? exprs)]
    [(AstExpr.Set _ rhs-box) (lower-source-node-has-import-call? rhs-box)]
    [(AstExpr.Ann inner-box _) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Cast inner-box _) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Borrow _ _ inner-box)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (or
            (lower-source-node-has-import-call? scrutinee-box)
            (lower-source-match-arms-have-import-call? arms))])]
    [(AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(AstForeach.Foreach _ _ start-box end-box body-box)
          (or
            (lower-source-node-has-import-call? start-box)
            (lower-source-node-has-import-call? end-box)
            (lower-source-node-has-import-call? body-box))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (or
            (lower-source-node-has-import-call? start-box)
            (lower-source-node-has-import-call? end-box)
            (lower-source-node-has-import-call? init-box)
            (lower-source-node-has-import-call? value-box))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            init-box
            _
            value-box
            body-box
            _)
          (or
            (lower-source-node-has-import-call? start-box)
            (lower-source-node-has-import-call? end-box)
            (lower-source-node-has-import-call? init-box)
            (lower-source-node-has-import-call? value-box)
            (lower-source-node-has-import-call? body-box))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (or
        (lower-source-node-has-import-call? value-box)
        (lower-source-node-has-import-call? lane-box))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (or
        (lower-source-node-has-import-call? value-box)
        (lower-source-node-has-import-call? lane-box))]
    [(AstExpr.StructGet target-box _)
      (lower-source-node-has-import-call? target-box)]
    [(AstExpr.StructSet target-box _ value-box)
      (or
        (lower-source-node-has-import-call? target-box)
        (lower-source-node-has-import-call? value-box))]
    [(AstExpr.WithRegion _ exprs)
      (lower-source-expr-list-has-import-call? exprs)]
    [(AstExpr.WithEscape escape-box exprs)
      (or
        (lower-source-node-has-import-call? escape-box)
        (lower-source-expr-list-has-import-call? exprs))]
    [(AstExpr.WithScratch exprs)
      (lower-source-expr-list-has-import-call? exprs)]
    [(AstExpr.InArena arena-box exprs)
      (or
        (lower-source-node-has-import-call? arena-box)
        (lower-source-expr-list-has-import-call? exprs))]
    [(AstExpr.WithResource resource-box)
      (match (box-get resource-box)
        [(AstWithResource.WithResource bindings body)
          (or
            (lower-source-resource-bindings-have-import-call? bindings)
            (lower-source-expr-list-has-import-call? body))])]
    [(AstExpr.Box inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.BoxGet inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.BoxTake inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.BoxSet inner-box value-box)
      (or
        (lower-source-node-has-import-call? inner-box)
        (lower-source-node-has-import-call? value-box))]
    [(AstExpr.Comptime inner-box)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Quote inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Quasiquote inner-box)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Unquote inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.UnquoteSplicing inner-box)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Try inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Return inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.PtrNullCheck inner-box)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.PtrRead inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.PtrWrite pointer-box value-box)
      (or
        (lower-source-node-has-import-call? pointer-box)
        (lower-source-node-has-import-call? value-box))]
    [(AstExpr.PtrOffset pointer-box offset-box)
      (or
        (lower-source-node-has-import-call? pointer-box)
        (lower-source-node-has-import-call? offset-box))]
    [(AstExpr.PtrCast inner-box _)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.PtrToInt inner-box)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.IntToPtr inner-box _)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.StringData inner-box)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.StringFromBytes data-box len-box)
      (or
        (lower-source-node-has-import-call? data-box)
        (lower-source-node-has-import-call? len-box))]
    [(AstExpr.ArrayData inner-box)
      (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.CpuIdEax left-box right-box)
      (or
        (lower-source-node-has-import-call? left-box)
        (lower-source-node-has-import-call? right-box))]
    [(AstExpr.CpuIdEbx left-box right-box)
      (or
        (lower-source-node-has-import-call? left-box)
        (lower-source-node-has-import-call? right-box))]
    [(AstExpr.CpuIdEcx left-box right-box)
      (or
        (lower-source-node-has-import-call? left-box)
        (lower-source-node-has-import-call? right-box))]
    [(AstExpr.CpuIdEdx left-box right-box)
      (or
        (lower-source-node-has-import-call? left-box)
        (lower-source-node-has-import-call? right-box))]
    [(AstExpr.Xgetbv inner-box) (lower-source-node-has-import-call? inner-box)]
    [(AstExpr.Syscall exprs) (lower-source-expr-list-has-import-call? exprs)]
    [_ false]))

(define (lower-source-decl-needs-loader?
  [decl : AstDecl]
  [all-decls : AstDeclList]) : bool
  (match decl
    [(AstDecl.Import (AstImportSpec.Spec kind path _ _ _))
      (lower-source-stdlib-import-needs-loader? all-decls kind path)]
    [(AstDecl.DefMacro _ _ ret body-box)
      (and
        (tc-macro-result-decl-emitting? ret)
        (lower-source-node-has-import-call? body-box))]
    [(AstDecl.Unsafe inner-box)
      (lower-source-decl-needs-loader? (box-get inner-box) all-decls)]
    [(AstDecl.ComptimeDecl _ template-box)
      (lower-source-decl-needs-loader? (box-get template-box) all-decls)]
    [_ false]))

(define (lower-source-decls-need-loader?
  [decls : AstDeclList]
  [all-decls : AstDeclList]) : bool
  (match decls
    [(AstDeclList.Nil) false]
    [(AstDeclList.Cons decl rest)
      (or
        (lower-source-decl-needs-loader? decl all-decls)
        (lower-source-decls-need-loader? (box-get rest) all-decls))]))

(define (lower-source-program-needs-loader? [program : AstProgram]) : bool
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (lower-source-decls-need-loader? decls decls))]))

(define (lower-compiler-source-with-path-mode
  [path : String]
  [src : String]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (begin
    ;; Each standalone single-source compile (smoke self-tests, emit-source,
    ;; check tools) runs in a fresh arena, so interned name strings from a
    ;; previous compile are freed. Reset the persistent intern table here so a
    ;; later compile never probes a dangling key. The multi-file driver compiles
    ;; through the loader, not this entry, so cli.tl's fixpoint is unaffected.
    (intern-reset!)
    (cbi.compiler-builtin-reset!)
    (match (parse-ast-source src)
      [(ResultAstProgram.Ok program)
        (if (lower-source-program-needs-loader? program)
          (let
            [stdlib-roots : vector.StringVec (vector.string-vec-new)]
            [cfgs : sym_i64_env.SymI64Env
              (typecheck-compiler-source-language-cfgs)]
            (match (typecheck-compiler-source-load src)
              [(ResultCompilerLoadWithPaths.Ok decls paths _ _)
                (lower-compiler-program-with-decl-paths-mode-cache
                  path
                  (ast-program decls)
                  paths
                  mode
                  stdlib-roots
                  (compiler-typecheck-prefix-cache-scope
                    "typecheck-prefix-lower"
                    stdlib-roots
                    cfgs))]
              [(ResultCompilerLoadWithPaths.Err diag) (ErrCompilerLower diag)]))
          (lower-compiler-program-with-path-mode path program mode))]
      [(ResultAstProgram.Err message)
        (ErrCompilerLower
          (box (lower-diagnostic-with-path (lower-diagnostic message) path)))])))

(define (lower-compiler-source-with-path [path : String] [src : String]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode path src (CompilerLowerScalar)))

(define (compiler-lower-smoke-source) : String
  "(extern (print-i64 [arg0 : i64]) : unit)
(define answer : i64 40)
(define (inc [x : i64]) : i64 (+ x 1))
(define (main [flag : bool]) : i64
  (let
    [x : i64 (inc answer)]
    (begin
      (set! x (+ x 1))
      (while (< x 45)
        (set! x (+ x 1)))
      (if flag x 0))))")

(define (compiler-lower-export-source) : String
  "(define answer : i64 42)
(define (main) : i64 answer)")

(define (compiler-lower-macro-expand-source) : String
  "(defmacro (and2 [lhs : bool] [rhs : bool]) : bool
  (expr-if lhs rhs (expr-bool false)))
(define (main) : i64 (if (and2 true true) 1 0))")

(define (compiler-lower-macro-expr-clause-source) : String
  "(defmacro (pick [arm : ExprClause]) : i64
  `(if ,(expr-clause-first arm) ,(expr-clause-second arm) 0))
(define (main) : i64 (pick [true 7]))")

(define (compiler-lower-macro-expr-clause-variadic-source) : String
  "(defmacro (pick-first [arms : ExprClause ...]) : i64
  (if (expr-clause-list-empty? arms)
    (expr-int 0)
    `(if ,(expr-clause-first (expr-clause-list-head arms))
       ,(expr-clause-second (expr-clause-list-head arms))
       (pick-first ,@(expr-clause-list->expr-list (expr-clause-list-tail arms))))))
(define (main) : i64 (pick-first [false 1] [true 9] [true 3]))")

(define (compiler-lower-macro-expr-clause-to-expr-error-source) : String
  "(defmacro (id [x : Expr]) : i64 x)
(define (main) : i64 (id [true 1]))")

(define (compiler-lower-macro-expr-to-clause-error-source) : String
  "(defmacro (need [arm : ExprClause]) : i64
  (expr-clause-second arm))
(define (main) : i64 (need 1))")

(define (compiler-lower-macro-expr-clause-shape-error-source) : String
  "(defmacro (need [arm : ExprClause]) : i64
  (expr-clause-second arm))
(define (main) : i64 (need [true 1 2]))")

(define (compiler-lower-bracket-ordinary-call-error-source) : String
  "(define (take [x : i64]) : i64 x)
(define (main) : i64 (take [true 1]))")

(define (compiler-lower-macro-arity-source) : String
  "(defmacro (and2 [lhs : bool] [rhs : bool]) : bool
  (expr-if lhs rhs (expr-bool false)))
(define (main) : i64 (if (and2 true) 1 0))")

(define (compiler-lower-macro-hygiene-definition-source) : String
  "(define (macro-helper [x : bool]) : bool (not x))
(defmacro (unless2 [condition : bool] [body : unit]) : unit
  `(if (macro-helper ,condition)
     ,body
     unit))
(define (main) : unit
  (let ([macro-helper : bool true])
    (unless2 false unit)))")

;; A fixed-array literal `(array ...)`: it type-checks to `(Array i64 N)` and now
;; lowers to inline storage with each element stored at its offset, returning the
;; storage pointer (the same representation `array-ref`/`array-set!` index off).
(define (compiler-lower-array-literal-source) : String
  "(define (main) : i64
  (let [a : (Array i64 3) (array 1 2 3)]
    (array-ref a 2)))")

(define (compiler-lower-fixed-array-aggregate-literal-source) : String
  "(defstruct Pair (x i64) (y i64))
(define (main) : i64
  (let
    [items : (Array Pair 2) (array (Pair 1 2) (Pair 3 4))]
    (struct-get (array-ref items 1) y)))")

(define (compiler-lower-fixed-array-return-source) : String
  "(define (main) : (Array i64 3)
  (array 1 2 3))")

(define (compiler-lower-box-source) : String
  "(define (main) : i64 (box-get (box 7)))")

(define (compiler-lower-box-get-source) : String
  "(define (main [b : (Box i64)]) : i64 (box-get b))")

(define (compiler-lower-reference-source) : String
  "(define (take [r : (& n i64)]) : unit unit)
(define (main [n : i64]) : unit
  (take (& n)))")

(define (compiler-lower-reference-auto-borrow-source) : String
  "(define (take [r : (& n i64)]) : unit unit)
(define (main [n : i64]) : unit
  (take n))")

(define (compiler-lower-reference-return-source) : String
  "(define (ref-return [n : i64]) : (& n i64) (& n))
(define (ref-id [r : (& n i64)]) : (& n i64) r)
(define (make-ref-tuple [n : i64]) : (Tuple (& n i64) i64)
  (tuple (& n) 7))
(define (make-ref-array [n : i64]) : (Array (& n i64) 1)
  (array (& n)))
(define (main [n : i64]) : i64
  (let
    [pair : (Tuple (& n i64) i64) (tuple (& n) 7)]
    [items : (Array (& n i64) 1) (array (& n))]
    (begin
      (ref-id (ref-return n))
      (make-ref-tuple n)
      (make-ref-array n)
      (tuple-ref pair 1)
      (array-ref items 0)
      42)))")

(define (compiler-lower-reference-place-source) : String
  "(defstruct Pair (left i64) (right i64))
(define (borrow-pair [p : Pair]) : (& p i64)
  (& (struct-get p left)))
(define (borrow-tuple [t : (Tuple i64 bool)]) : (& t i64)
  (& (tuple-ref t 0)))
(define (borrow-array [items : (Array i64 2)]) : (& items i64)
  (& (array-ref items 0)))
(define (main) : i64
  (let
    [p : Pair (Pair 40 2)]
    [t : (Tuple i64 bool) (tuple 41 true)]
    [items : (Array i64 2) (array 42 7)]
    (begin
      (borrow-pair p)
      (borrow-tuple t)
      (borrow-array items)
      42)))")

(define (compiler-lower-reference-inline-struct-field-source) : String
  "(defstruct Inner (name String) (line i64))
(defstruct Outer (prefix i64) (inner Inner))
(define (take-inner [inner : (& inner Inner)]) : i64
  (struct-get inner line))
(define (main [outer : Outer]) : i64
  (take-inner (& (struct-get outer inner))))")

(define (compiler-lower-reference-struct-result-source) : String
  "(defstruct RefBox
  (:lifetimes text)
  (borrowed (& text str))
  (owned String)
  (is-owned bool))
(define (ref-box-borrowed [text : (& text str)] [owned : String]) : (RefBox text)
  (RefBox text owned false))
(define (ref-box-owned [text : (& text str)] [owned : String]) : (RefBox text)
  (RefBox text owned true))
(define (ref-box-length [item : (RefBox text)]) : i64
  (if (struct-get item is-owned)
    (__tl_string_length (struct-get item owned))
    (__tl_string_length (struct-get item borrowed))))
(define (main [text : String] [owned : String]) : i64
  (let
    [borrowed : (RefBox text) (ref-box-borrowed (& text) owned)]
    [owned-box : (RefBox text) (ref-box-owned (& text) owned)]
    (+ (ref-box-length borrowed) (ref-box-length owned-box))))")

(define (compiler-lower-reference-struct-multi-result-source) : String
  "(defstruct ReplaceResult
  (:lifetimes text old replacement)
  (borrowed (& text str))
  (old-text (& old str))
  (replacement-text (& replacement str))
  (owned String)
  (is-owned bool))
(define (replace-borrowed
  [text : (& text str)]
  [old : (& old str)]
  [replacement : (& replacement str)]
  [owned : String]) : (ReplaceResult text old replacement)
  (ReplaceResult text old replacement owned false))
(define (replace-owned
  [text : (& text str)]
  [old : (& old str)]
  [replacement : (& replacement str)]
  [owned : String]) : (ReplaceResult text old replacement)
  (ReplaceResult text old replacement owned true))
(define (replace-score [item : (ReplaceResult text old replacement)]) : i64
  (+
    (__tl_string_length (struct-get item old-text))
    (+
      (__tl_string_length (struct-get item replacement-text))
      (if (struct-get item is-owned)
        (__tl_string_length (struct-get item owned))
        (__tl_string_length (struct-get item borrowed))))))
(define (main [text : String] [old : String] [replacement : String] [owned : String]) : i64
  (let
    [borrowed : (ReplaceResult text old replacement)
      (replace-borrowed (& text) (& old) (& replacement) owned)]
    [owned-result : (ReplaceResult text old replacement)
      (replace-owned (& text) (& old) (& replacement) owned)]
    (+ (replace-score borrowed) (replace-score owned-result))))")

(define (compiler-lower-reference-enum-result-source) : String
  "(defenum RefChoice
  (:lifetimes text)
  (RefChoiceBorrowed (& text str))
  (RefChoiceOwned String))
(define (borrowed-choice [text : (& text str)]) : (RefChoice text)
  (RefChoiceBorrowed text))
(define (owned-choice [text : (& text str)] [owned : String]) : (RefChoice text)
  (RefChoiceOwned owned))
(define (choice-length [choice : (RefChoice text)]) : i64
  (match choice
    [(RefChoiceBorrowed value) (__tl_string_length value)]
    [(RefChoiceOwned value) (__tl_string_length value)]))
(define (choice-loop [choice : (RefChoice text)] [count : i64]) : i64
  (match choice
    [(RefChoiceBorrowed value)
      (if (> count 0)
        (choice-loop (RefChoiceBorrowed value) (- count 1))
        (__tl_string_length value))]
    [(RefChoiceOwned value) (__tl_string_length value)]))
(define (main [text : String] [owned : String]) : i64
  (+
    (choice-length (borrowed-choice (& text)))
    (choice-loop (owned-choice (& text) owned) 1)))")

(define (compiler-lower-function-value-source) : String
  "(define (inc [x : i64]) : i64 (+ x 1))
(define (apply1 [f : (-> i64 i64)] [x : i64]) : i64
  (f x))
(define (shadow-inc [inc : (-> i64 i64)] [x : i64]) : i64
  (inc x))
(define (main) : i64
  (+ (apply1 inc 41) (shadow-inc inc 1)))")

(define (compiler-lower-function-value-contextual-init-source) : String
  "(define (inc [x : i64]) : i64 (+ x 1))
(define (main) : i64
  (let
    [f : (-> i64 i64) inc]
    (f (init))))")

(define (compiler-lower-noncapturing-lambda-value-source) : String
  "(define (get-fn) : (-> i64 i64)
  (lambda ([x : i64]) : i64 (+ x 1)))")

(define (compiler-lower-immediate-lambda-call-source) : String
  "(define (main) : i64
  ((lambda ([x : i64]) : i64 (+ x 1)) 41))")

(define (compiler-lower-unit-lambda-call-source) : String
  "(extern (print-i64 [arg0 : i64]) : unit)
(define (main) : unit
  ((lambda () : unit (print-i64 1))))")

(define (compiler-lower-capturing-lambda-scalar-source) : String
  "(define (main) : i64
  (let
    [n : i64 10]
    ((lambda ([x : i64]) : i64 (+ x n)) 32)))")

(define (compiler-lower-capturing-lambda-function-value-source) : String
  "(define (main) : i64
  (let
    [inc : (-> i64 i64) (lambda ([x : i64]) : i64 (+ x 1))]
    [n : i64 9]
    ((lambda ([x : i64]) : i64 (inc (+ x n))) 32)))")

(define (compiler-lower-capturing-lambda-fat-handle-source) : String
  "(define (main [n : i64]) : i64
  (let
    [s : String \"hello\"]
    [a : (Array i64) (make-array i64 2)]
    (begin
      (array-set! a 0 n)
      ((lambda () : i64 (+ (__tl_string_length s) (array-ref a 0)))))))")

(define (compiler-lower-capturing-lambda-aggregate-source) : String
  "(defstruct Point (x i64) (y i64))
(defenum Shape (Rect i64 i64) (None))
(define (main) : i64
  (let
    [t : (Tuple i64 i64) (tuple 5 99)]
    [p : Point (Point 7 1)]
    [a : (Array i64 2) (array 3 10)]
    [s : Shape (Rect 4 5)]
    ((lambda () : i64
       (+
         (tuple-ref t 0)
         (+
           (struct-get p x)
           (+
             (array-ref a 1)
             (match s
               [(Rect w h) (* w h)]
               [(None) 0]))))))))")

(define (compiler-lower-capturing-lambda-shadow-source) : String
  "(define (main) : i64
  (let
    [n : i64 10]
    ((lambda ([x : i64]) : i64
       (+
         n
         (let
           [n : i64 100]
           (+ x n))))
     32)))")

(define (compiler-lower-capturing-lambda-reference-source) : String
  "(define (main [n : i64]) : i64
  (let [r : (& n i64) (& n)]
    (let [f : (-> i64) (lambda () : i64 (let [copy : (& n i64) r] 42))]
      (f))))")

(define (compiler-lower-capturing-lambda-reference-immediate-source) : String
  "(define (main [n : i64]) : i64
  (let [r : (& n i64) (& n)]
    ((lambda () : i64 (let [copy : (& n i64) r] 42)))))")

;; `(comptime expr)` folds to a literal via the scalar CTFE evaluator (#719).
;; These fixtures exercise arithmetic, f64, `if`, and `let` folds, plus the
;; runtime-variable rejection path.
(define (compiler-lower-comptime-arith-source) : String
  "(define (main) : i64 (comptime (+ 1 2)))")

(define (compiler-lower-comptime-if-source) : String
  "(define (main) : i64 (comptime (if (< 1 2) (* 6 7) 0)))")

(define (compiler-lower-comptime-let-source) : String
  "(define (main) : i64 (comptime (let [x 40] (+ x 2))))")

(define (compiler-lower-comptime-runtime-var-source) : String
  "(define (main [x : i64]) : i64 (comptime x))")

(define (compiler-lower-comptime-f64-source) : String
  "(define (main) : f64 (comptime 1.5))")

(define (compiler-lower-comptime-f32-source) : String
  "(define (main) : f32 (comptime (cast 1.00000001 : f32)))")

(define (compiler-lower-duplicate-function-source) : String
