    (Box CompilerIrBlockList)
    (Box CompilerIrFunctionList)
    String
    (Box CompilerSourceSpans)
    LowerNameCache
    LowerTypeCache
    CompilerLowerMode
    ;; Tail-call-safe current function parameter var range: [start, end).
    i64
    i64))

(defenum LowerMaybeArrayVar
  (LowerNoArrayVar)
  (LowerSomeArrayVar i64 AstType))

(defenum LowerMaybeIrValue
