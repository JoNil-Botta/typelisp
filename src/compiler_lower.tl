;; compiler_lower.tl - Selfhost compiler AST-to-IR lowering.
;;
;; The lowerer accepts the checked program and builds a deterministic
;; CompilerIrProgram.
(import stdlib.arena)
(import stdlib.array)
(import stdlib.vector)
(import (vector.vector String) as svec)
(import compiler_typecheck_core as tc_core)
(import compiler_symbols as csym)
(import compiler_specialize as spec)
(import compiler_parse_core as parser)
(import compiler_load as load)
(import compiler_cfg_core as cfg_core)
(import compiler_builtin_ids as cbi)
(import compiler_diagnostic as cdiag)
(import compiler_ir_types as ir)
(import compiler_ast_types as ast)
(import compiler_clone as clone_support)
(import compiler_ctfe as ctfe)
(import compiler_float as cfloat)
(import compiler_intern as ci)
(import stdlib.hashmap)
(import stdlib.hash)
(import (hashmap.hashmap i64 i64) as lower_i64_i64_map)
(import stdlib.string)
(import stdlib.text_buf)
(import stdlib.str_cat_runtime as str_cat)
(cfg compile-profile (import stdlib.profile))
(cfg compile-profile (import stdlib.io))
(import sym_i64_env)

(defstruct LowerNameBinding
  ;; Source/logical identities and the renderable logical symbol. Spellings are
  ;; owned once by the active interner and recovered only when emitted.
  (source-id i64)
  (logical-id i64)
  (symbol-id i64)
  (parent i64))

(defstruct LowerNameFlatBinding
  (source-id i64)
  (logical-id i64)
  (symbol-id i64))

;; Bindings are append-only in fixed segments. Parent indices span the segments;
;; growing the small segment directory never relocates a binding. A snapshot is
;; just a shared store plus an independent head/count pair, so extending a child
;; cannot change its parent.
(defstruct LowerNameStore
  (segments (__tl_dyn-array (__tl_dyn-array LowerNameBinding)))
  (segment-count i64)
  (len i64)
  (arena i64))

(defenum LowerNameEnv
  (Nil)
  (Inline i64 i64 i64)
  (Dense (Box LowerNameStore) i64 i64))

(defenum LowerNameEnvView
  (Nil)
  (Bind i64 i64 i64 LowerNameEnv))

(define (lower-name-arena-owner-root [handle : i64]) : i64
  (if (= handle 0)
    0
    (let
      [root : i64
        (unsafe
          (ptr-read (ptr-offset (int->ptr handle : (Ptr i64)) 5)))]
      (if (= root 0)
        handle
        root))))

(define (lower-name-arena-owner-current-head [handle : i64]) : i64
  (let
    [root : i64 (lower-name-arena-owner-root handle)]
    (if (= root 0)
      0
      (let
        [head : i64
          (unsafe
            (ptr-read (ptr-offset (int->ptr root : (Ptr i64)) 7)))]
        (if (= head 0)
          root
          head)))))

(define (lower-name-arena-restore-after-owner-alloc!
  [previous-arena : i64]
  [owner : i64]) : unit
  ;; If the caller was already in this owner, allocation may have advanced its
  ;; head and that new head must remain active. Otherwise resume the unrelated
  ;; caller owner at its own current head.
  (if (=
    (lower-name-arena-owner-root previous-arena)
    (lower-name-arena-owner-root owner))
    unit
    (unsafe
      (arena.tl_arena_set (lower-name-arena-owner-current-head previous-arena)))))

(define (lower-name-store-new) : LowerNameStore
  (begin
    (cfg
      compile-profile
      (set!
        compiler-lower-profile-name-env-stores
        (+ compiler-lower-profile-name-env-stores 1)))
    (let
      [segments : (__tl_dyn-array (__tl_dyn-array LowerNameBinding))
        (make-array (__tl_dyn-array LowerNameBinding) 4)]
      [first : (__tl_dyn-array LowerNameBinding)
        (make-array LowerNameBinding 16)]
      [owner : i64 (lower-name-arena-owner-root (arena.tl_arena_current))]
      (begin
        (array-set! segments 0 first)
        (LowerNameStore segments 1 0 owner)))))

(define (lower-name-store-segments-copy-range!
  [dst : (&mut dst (__tl_dyn-array (__tl_dyn-array LowerNameBinding)))]
  [src : (& src (__tl_dyn-array (__tl_dyn-array LowerNameBinding)))]
  [count : i64]) : unit
  (let
    [index : i64 0]
    (while (< index count)
      (begin
        (array-set! dst index (array-ref src index))
        (set! index (+ index 1))))))

(define (lower-name-store-add-segment! [store : (&mut store LowerNameStore)]) : unit
  (let
    [count : i64 (struct-get store segment-count)]
    [capacity : i64 (array-length (struct-get store segments))]
    [owner : i64 (struct-get store arena)]
    [previous-arena : i64 (arena.tl_arena_current)]
    (begin
      (cfg
        compile-profile
        (set!
          compiler-lower-profile-name-env-store-grows
          (+ compiler-lower-profile-name-env-store-grows 1)))
      (unsafe
        (arena.tl_arena_set (lower-name-arena-owner-current-head owner)))
      (if (< count capacity)
        unit
        (let
          [bigger : (__tl_dyn-array (__tl_dyn-array LowerNameBinding))
            (make-array
              (__tl_dyn-array LowerNameBinding)
              (if (< capacity 1)
                4
                (* capacity 2)))]
          (begin
            (lower-name-store-segments-copy-range!
              (&mut bigger)
              (& (struct-get store segments))
              count)
            (set! (struct-get store segments) bigger))))
      (array-set!
        (struct-get store segments)
        count
        (make-array LowerNameBinding 16))
      (set! (struct-get store segment-count) (+ count 1))
      (lower-name-arena-restore-after-owner-alloc! previous-arena owner))))

(define (lower-name-store-ensure-index!
  [store : (&mut store LowerNameStore)]
  [index : i64]) : unit
  (let
    [segment-index : i64 (/ index 16)]
    (while (>= segment-index (struct-get store segment-count))
      (lower-name-store-add-segment! store))))

(define (lower-name-store-write-index!
  [store : (&mut store LowerNameStore)]
  [index : i64]
  [binding : LowerNameBinding]) : unit
  (let
    [segment-index : i64 (/ index 16)]
    [offset : i64 (- index (* segment-index 16))]
    [segment : (__tl_dyn-array LowerNameBinding)
      (array-ref (struct-get store segments) segment-index)]
    (array-set! segment offset binding)))

(define (lower-name-store-binding-at
  [store : (& store LowerNameStore)]
  [index : i64]) : LowerNameBinding
  ;; Every index comes from a successful push or a checked materialization.
  ;; The raw read avoids repeating a dynamic bounds check on each parent hop.
  (let
    [segment-index : i64 (/ index 16)]
    [offset : i64 (- index (* segment-index 16))]
    [segment : (__tl_dyn-array LowerNameBinding)
      (array-ref (struct-get store segments) segment-index)]
    (unsafe
      (ptr-read (ptr-offset (array-data segment) offset)))))

(define (lower-name-store-push!
  [store : (&mut store LowerNameStore)]
  [binding : LowerNameBinding]) : i64
  (let
    [index : i64 (struct-get store len)]
    (begin
      (lower-name-store-ensure-index! store index)
      (lower-name-store-write-index! store index binding)
      (set! (struct-get store len) (+ index 1))
      index)))

(define (lower-name-env-bind-ids-raw
  [source-id : i64]
  [logical-id : i64]
  [symbol-id : i64]
  [rest : LowerNameEnv]) : LowerNameEnv
  (match rest
    [(LowerNameEnv.Nil) (LowerNameEnv.Inline source-id logical-id symbol-id)]
    [(LowerNameEnv.Inline parent-source-id parent-logical-id parent-symbol-id)
      (let
        [store : (Box LowerNameStore) (box (lower-name-store-new))]
        [parent : i64
          (lower-name-store-push!
            (&mut (box-get store))
            (LowerNameBinding
              parent-source-id
              parent-logical-id
              parent-symbol-id
              -1))]
        [head : i64
          (lower-name-store-push!
            (&mut (box-get store))
            (LowerNameBinding source-id logical-id symbol-id parent))]
        (LowerNameEnv.Dense store head 2))]
    [(LowerNameEnv.Dense store parent count)
      (let
        [head : i64
          (lower-name-store-push!
            (&mut (box-get store))
            (LowerNameBinding source-id logical-id symbol-id parent))]
        (LowerNameEnv.Dense store head (+ count 1)))]))

(define (lower-name-env-bind-ids
  [source-id : i64]
  [logical-id : i64]
  [symbol-id : i64]
  [rest : LowerNameEnv]) : LowerNameEnv
  (begin
    (cfg
      compile-profile
      (set!
        compiler-lower-profile-name-env-binds
        (+ compiler-lower-profile-name-env-binds 1)))
    (lower-name-env-bind-ids-raw source-id logical-id symbol-id rest)))

(define (lower-name-env-view [names : LowerNameEnv]) : LowerNameEnvView
  (match names
    [(LowerNameEnv.Nil) LowerNameEnvView.Nil]
    [(LowerNameEnv.Inline source-id logical-id symbol-id)
      (LowerNameEnvView.Bind source-id logical-id symbol-id LowerNameEnv.Nil)]
    [(LowerNameEnv.Dense store head count)
      (let
        [binding : LowerNameBinding
          (lower-name-store-binding-at (& (box-get store)) head)]
        [parent : i64 (struct-get binding parent)]
        (LowerNameEnvView.Bind
          (struct-get binding source-id)
          (struct-get binding logical-id)
          (struct-get binding symbol-id)
          (if (< parent 0)
            LowerNameEnv.Nil
            (LowerNameEnv.Dense store parent (- count 1)))))]))

;; Like LowerTypeCache, a LowerNameCache carries a `parent` marker.
;; `LowerNameParent.None` is a complete cache (a miss returns the source name
;; unchanged). `LowerNameParent.Global` marks a small per-module overlay that, on
;; a miss, falls through to the process-global lowering name cache
;; `lower-active-global-name-cache`. Each lowering sub-phase that builds
;; per-module name caches (the prune body-index reachability pass and the decl
;; lowering loop) sets that global to its whole-program name cache once before
;; building module overlays; the phases never overlap, so they share the slot.
;; This makes each module's name cache a small overlay of just its module-local
;; names over the shared global cache instead of rebuilding the whole global name
;; set per module (was O(modules x global-names)). A global marker is used rather
;; than an owned parent because the one global cache must be shared by every
;; module overlay.
(defenum LowerNameParent
  (None)
  (Global))

(defstruct LowerModulePathIndex
  (edges lower_i64_i64_map.Map)
  (terminals lower_i64_i64_map.Map)
  (modules lower_i64_i64_map.Map)
  (next-node i64))

(define (lower-module-path-index-empty) : LowerModulePathIndex
  (LowerModulePathIndex
    (lower_i64_i64_map.with-capacity 8)
    (lower_i64_i64_map.with-capacity 8)
    (lower_i64_i64_map.with-capacity 8)
    1))

(defstruct LowerNameCache
  (ids lower_i64_i64_map.Map)
  (logical-ids (__tl_dyn-array i64))
  (symbol-ids (__tl_dyn-array i64))
  (logical-symbols lower_i64_i64_map.Map)
  (module-paths LowerModulePathIndex)
  (clone-roots clone_support.CloneRootEntries)
  (module-id i64)
  (parent LowerNameParent))

(defmacro (lower-global-shared-view [place : Expr]) : Expr
  (cfg
    stage0-seed-bootstrap
    place
    `(unsafe
      (ptr-read (ptr-addr-of ,place)))))

(defmacro (lower-global-array-element-shared-view [items : Expr] [index : Expr]) : Expr
  (cfg
    stage0-seed-bootstrap
    `(array-ref ,items ,index)
    `(unsafe
      (ptr-read (ptr-offset (array-data ,items) ,index)))))

;; The shared global lowering name cache. Set once per sub-phase
;; (prune body-index build, then decl lowering) from that phase's whole-program
;; name env; per-module overlays fall through here.
(define lower-active-global-name-cache : LowerNameCache
  (LowerNameCache
    (lower_i64_i64_map.with-capacity 8)
    (make-array i64 0)
    (make-array i64 0)
    (lower_i64_i64_map.with-capacity 8)
    (lower-module-path-index-empty)
    (clone_support.CloneRootEntries.Empty)
    cbi.compiler-builtin-id-fix-empty
    (LowerNameParent.None)))

;; Final declaration lowering can prove ownership for an unqualified source
;; name even when an in-memory entry point has no filesystem-derived canonical
;; name-cache row. Keep only the already-built symbol registries here; copying
;; CompilerSymbols copies their array/map handles rather than their contents.
(define lower-active-symbols : csym.CompilerSymbols
  (csym.compiler-symbols-empty))
(define lower-active-symbols-ready : bool
  false)

(define (lower-active-global-name-cache-current) : LowerNameCache
  (lower-global-shared-view lower-active-global-name-cache))

(define (lower-active-global-name-cache-set! [cache : LowerNameCache]) : unit
  (set! lower-active-global-name-cache cache))

;; Package builds set this identity before lowering. Source-level
;; `:spmd-callable` declarations are intentionally rejected by ordinary
;; program compilation because their symbols and TLCI records are a package
;; artifact ABI, not a source-visible calling convention.
(define lower-spmd-package-name : String
  "")
(define lower-spmd-package-symbol-identities : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 8))

(defenum LowerSpmdPackageSymbolRegistration
  (New)
  (Existing)
  (Collision String))

(define (lower-spmd-set-package-name! [name : String]) : unit
  (begin
    (set! lower-spmd-package-name name)
    (set!
      lower-spmd-package-symbol-identities
      (lower_i64_i64_map.with-capacity 8))))

(define (lower-spmd-clear-package-name!) : unit
  (begin
    (set! lower-spmd-package-name "")
    (set!
      lower-spmd-package-symbol-identities
      (lower_i64_i64_map.with-capacity 8))))

(define (lower-empty-global-name-cache) : LowerNameCache
  (LowerNameCache
    (lower_i64_i64_map.with-capacity 8)
    (make-array i64 0)
    (make-array i64 0)
    (lower_i64_i64_map.with-capacity 8)
    (lower-module-path-index-empty)
    (clone_support.CloneRootEntries.Empty)
    cbi.compiler-builtin-id-fix-empty
    (LowerNameParent.None)))

;; LowerTypeCache.Some carries a `parent` marker. `LowerTypeParent.None`
;; is a complete cache (a miss = unbound). `LowerTypeParent.Global` marks a small
;; per-module overlay that, on a miss, falls through to the process-global
;; decl-lowering type cache `lower-decls-global-type-cache` (set once per
;; lower-decls run). This lets each module's type cache be a small overlay of
;; just the module-local type bindings over the shared global cache, instead of
;; rebuilding the whole global type set into a fresh cache at every module
;; boundary (was O(modules x global-types)). A global marker (rather than an
;; owned parent value) is used because the single global cache must be shared by
;; every module's overlay, which move semantics forbid for an owned field; the
;; compiler already keeps per-file process-global caches in this style.
(defenum LowerTypeParent
  (None)
  (Global))

(defenum LowerTypeCache
  (No)
  (Some lower_i64_i64_map.Map (__tl_dyn-array ast.AstType) i64 LowerTypeParent))

;; Flattened dotted imports emit a module marker when entering an imported file
;; and another when returning to its importer. Lowering can therefore revisit
;; one module many times even though its immutable local name/type view is
;; unchanged. Keep one phase-local entry per distinct module instead of
;; rebuilding the overlay at every marker.
(defenum LowerMaybeModuleNameCache
  (No)
  (Some LowerNameCache))

(defenum LowerModuleNameCacheList
  (Nil)
  (Cons i64 LowerNameCache (Box LowerModuleNameCacheList)))

(defstruct LowerModuleLocalView
  (local-top-env tc_core.TcTypeEnv)
  (name-cache LowerNameCache)
  (type-cache LowerTypeCache))

(defenum ResultLowerModuleLocalView
  (Ok LowerModuleLocalView)
  (Err String))

(defenum LowerMaybeModuleLocalView
  (No)
  (Some LowerModuleLocalView))

(defenum LowerModuleLocalViewList
  (Nil)
  (Cons i64 LowerModuleLocalView (Box LowerModuleLocalViewList)))

(define lower-active-module-name-caches : LowerModuleNameCacheList
  (LowerModuleNameCacheList.Nil))
(define lower-active-module-local-views : LowerModuleLocalViewList
  (LowerModuleLocalViewList.Nil))

;; IR vars allocated before an enclosing loop survive its backedge. Track the
;; active function too so lowering a nested lambda cannot mistake its fresh,
;; low-numbered vars for locals owned by the enclosing loop.
(define lower-active-loop-function : i64
  -1)
(define lower-active-loop-entry-var-limit : i64
  -1)

(define (lower-module-phase-caches-reset!) : unit
  (begin
    (set! lower-active-module-name-caches (LowerModuleNameCacheList.Nil))
    (set! lower-active-module-local-views (LowerModuleLocalViewList.Nil))
    (set! lower-active-loop-function -1)
    (set! lower-active-loop-entry-var-limit -1)))

;; The shared global decl-lowering type cache (built once per lower-decls
;; from top-env). Per-module overlay caches (LowerTypeParent.Global) fall through
;; here on a miss. Set by lower-decls before the per-module loop runs.
(define lower-decls-global-type-cache : LowerTypeCache
  (LowerTypeCache.No))

;; Call-slot RVO forwards the current function's hidden sret slot to the
;; callee and then returns that slot. Callees whose body can emit an early exit
;; (`return` or `try`) are not yet guaranteed to write that forwarded slot on
;; every path; those older paths may still return a heap aggregate pointer. This
;; set is rebuilt once per lower-decls run and lets the RVO guard stay cheap.
(define lower-rvo-early-return-functions : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 8))

;; Contiguous id set: `slots[0, len)` holds the members oldest first, so the old
;; head-first cons walk is the descending index walk. `lower-id-set-insert` is
;; persistent and copies into a right-sized array, because callers keep both a
;; set and an extension of it live at the same time. Only the reach worklist,
;; which threads one state linearly, uses the in-place push/pop pair.
(defstruct LowerIdSet
  (slots (__tl_dyn-array i64))
  (len i64))

;; Parallel key/value arrays in cons order (oldest first). Lookup scans from the
;; tail so the most recent binding still shadows, and both `cons` and `remove`
;; build fresh arrays so every substitution value stays independent.
(defstruct LowerSpmdInlineSubst
  (names (__tl_dyn-array i64))
  (values (__tl_dyn-array ast.AstExpr))
  (len i64))

;; Function reachability is ID-native. `all-functions` maps the canonical
;; logical ID to a dense slot, `reachable` is slot-keyed, and the worklist/body
;; index carry the same logical ID. Display strings never participate in graph
;; identity.
(defenum LowerReachState
  (State lower_i64_i64_map.Map LowerIdSet))

(defenum LowerUsedTypePathSeed
  (Seed lower_i64_i64_map.Map bool))

(defenum LowerMaybeFunctionBody
  (No)
  (Some ast.AstExpr LowerNameCache i64))

;; Reset once per prune reach walk; lower-reach-process records each reachable
;; function body's source path so type-decl DCE can keep local support types
;; without rescanning every declaration to rediscover those paths.
(define lower-reach-active-runtime-paths : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 8))
(define lower-reach-active-body-used-types : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 8))

(define (lower-reach-scratch-globals-reset!) : unit
  (begin
    (set! lower-active-global-name-cache (lower-empty-global-name-cache))
    (set! lower-active-symbols-ready false)
    (lower-module-phase-caches-reset!)
    (set! lower-reach-active-runtime-paths (lower_i64_i64_map.with-capacity 8))
    (set!
      lower-reach-active-body-used-types
      (lower_i64_i64_map.with-capacity 8))
    unit))

(defenum LowerSpmdInlineHelper
  (No)
  (Some i64 ast.AstParamList ast.AstType ast.AstExpr)
  (Imported i64 ast.AstType (Box ast.AstImportedSpmdCallableList)))

(defenum LowerSpmdScalarCallContext
  (No)
  (Some String))

(defstruct LowerFunctionBodyIndex
  (ids lower_i64_i64_map.Map)
  (bodies (__tl_dyn-array LowerMaybeFunctionBody))
  (next i64))

(defenum LowerPrunedProgram
  (Program ast.AstProgram ast.AstDeclPathList))

(defstruct LowerDeclKeepPlan
  (keep (__tl_dyn-array i64))
  (source-count i64))

(defenum LowerPrunedProgramWithPlan
  (Program ast.AstProgram ast.AstDeclPathList LowerDeclKeepPlan))

(defenum LowerFilteredReachableWithPlan
  (Filtered ast.AstDeclList ast.AstDeclPathList LowerDeclKeepPlan))

(defenum LowerEntryMainScan
  (Scan i64 String i64 bool))

(defenum LowerMaybeEntryMainModule
  (No)
  (Some String i64))

(defenum ResultLowerCheckedContext
  (Ok tc_core.TcContext tc_core.TcTypeEnv)
  (Err String))

(defenum ResultLowerCloneAugment
  (Ok ast.AstProgram ast.AstDeclList)
  (Err String))

(defenum CompilerLowerMode
  (Scalar)
  (LinuxScalar)
  (WindowsScalar)
  (Avx2)
  (LinuxAvx2)
  (WindowsAvx2)
  (Avx512)
  (LinuxAvx512)
  (WindowsAvx512)
  (InlineAggregates))

;; Lowering threads one state through every expression in a function. Keep the
;; public carrier to one word and mutate its function-owned cell in place:
;; returning the former wide value from every variable allocation, emission,
;; and label transition copied the complete state through `tl_memcpy` millions
;; of times. Builders were already shared mutable storage, so this preserves
;; the existing linear state semantics while making that ownership explicit.
(defstruct LowerStateData
  (next-var i64)
  (next-label i64)
  (next-lambda i64)
  (current-label i64)
  (current-instrs ir.CompilerIrInstrBuilder)
  (blocks ir.CompilerIrBlockBuilder)
  (functions ir.CompilerIrFunctionBuilder)
  ;; Exact interned IR function identity. Derive display text only where
  ;; needed; re-interning that text can select a different provenance ID.
  (function i64)
  (spans (Box ir.CompilerSourceSpans))
  (names LowerNameCache)
  (type-cache LowerTypeCache)
  (mode CompilerLowerMode)
  (address-taken lower_i64_i64_map.Map)
  ;; Tail-call-safe current function parameter var range: [start, end).
  (tail-param-start i64)
  (tail-param-end i64))

(defenum LowerState
  (State (Box LowerStateData)))

(define (lower-state-new
  [next-var : i64]
  [next-label : i64]
  [next-lambda : i64]
  [current-label : i64]
  [current-instrs : ir.CompilerIrInstrBuilder]
  [blocks : ir.CompilerIrBlockBuilder]
  [functions : ir.CompilerIrFunctionBuilder]
  [function : i64]
  [spans : (Box ir.CompilerSourceSpans)]
  [names : LowerNameCache]
  [type-cache : LowerTypeCache]
  [mode : CompilerLowerMode]
  [address-taken : lower_i64_i64_map.Map]
  [tail-param-start : i64]
  [tail-param-end : i64]) : LowerState
  (LowerState.State
    (box
      (LowerStateData
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        tail-param-start
        tail-param-end))))

;; Most lowering transitions consume their state linearly. A few control-flow
;; builders deliberately fork from a shared snapshot; clone only at those
;; explicit seams so the fork keeps the former by-value counter/builder heads.
(define (lower-state-clone [state : LowerState]) : LowerState
  (match state
    [(LowerState.State data) (LowerState.State (box (box-get data)))]))

(defenum LowerMaybeArrayVar
  (No)
  (Some i64 ast.AstType))

(defenum LowerMaybeIrValue
  (No)
  (Some ir.CompilerIrValue))

(defenum LowerMaybeAstExpr
  (No)
  (Some ast.AstExpr))

(defenum LowerMaybeAstType
  (No)
  (Some ast.AstType))

(defenum LowerSpmdInlineLetBindings
  (Bindings ast.AstLetBindingList LowerSpmdInlineSubst LowerIdSet))

(defenum LowerVectorMapValue
  (Array i64)
  ;; Gather `source[indexes[i]]`; indexes are contiguous i64 lanes and source
  ;; accesses are non-contiguous reads.
  (Gather i64 i64)
  ;; Gather `source[i + offsets[program-index]]` without materializing a
  ;; logical-index array. The backend forms the i64 index lanes directly.
  (GatherLaneOffset i64 i64)
  ;; A dynamic array indexed by `(program-index)`. Unlike `Array`, this source
  ;; repeats the same lane vector for every foreach gang.
  (LaneArray i64)
  (Uniform ir.CompilerIrValue)
  (BroadcastArray i64 ir.CompilerIrValue)
  (LaneIndex)
  (LaneCount)
  ;; Intra-gang permutation. The selector plan always has i64 elements even
  ;; when the shuffled value uses 32-bit lanes.
  (Shuffle (Box LowerVectorMapValue) (Box LowerVectorMapValue))
  (BinOp ir.CompilerIrBinOp (Box LowerVectorMapValue) (Box LowerVectorMapValue)))

(defenum LowerMaybeVectorMapValue
  (No)
  (Some LowerVectorMapValue))

(defstruct LowerVectorMapStore
  (array-var i64)
  (value LowerVectorMapValue))

(defstruct LowerVectorMapStoreList
