            arms
            (+ arm-index 1)))])))

(define (lower-masked-vector-body-has-varying-enum-match?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : bool
  (lower-masked-vector-body-has-varying-enum-match-with-locals?
    ctx
    env
    type-env
    index
    LowerIdSet.Nil
    expr))

(define (lower-masked-vector-bool-array-lane?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [arr : AstExpr]
  [idx : AstExpr]) : bool
  (if (>= (lower-masked-vector-index-offset ctx index idx) 0)
    (match (lower-dynamic-array-var ctx env type-env arr)
      [(LowerMaybeArrayVar.Some _ elem-ty) (lower-type-bool? elem-ty)]
      [(LowerMaybeArrayVar.No) false])
    false))

(define (lower-masked-vector-body-has-bool-array-lane?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          inner))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            left)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            right)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (or
              (lower-masked-vector-let-bindings-have-bool-array-lane?
                ctx
                env
                type-env
                index
                bindings)
              (lower-masked-vector-body-has-bool-array-lane?
                ctx
                env
                type-env
                index
                body)))])]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            cond)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            then-branch)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            else-branch)))]
    [(AstExpr.While cond-box body-box)
      (or
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          (lower-context-expr-get ctx cond-box))
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          (lower-context-expr-get ctx body-box)))]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-bool-array-lane?
        ctx
        env
        type-env
        index
        exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        (lower-masked-vector-bool-array-lane? ctx env type-env index arr idx))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-masked-vector-bool-array-lane? ctx env type-env index arr idx)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            receiver)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            value)))]
    [_ false]))

(define (lower-masked-vector-expr-list-has-bool-array-lane?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : AstExprList]) : bool
  (lower-masked-vector-expr-list-has-bool-array-lane-at?
    ctx
    env
    type-env
    index
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-has-bool-array-lane-at?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : (& exprs AstExprList)]
  [expr-index : i64]) : bool
  (if (>= expr-index (struct-get exprs len))
    false
    (or
      (lower-masked-vector-body-has-bool-array-lane?
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx (ast-expr-list-get exprs expr-index 0)))
      (lower-masked-vector-expr-list-has-bool-array-lane-at?
        ctx
        env
        type-env
        index
        exprs
        (+ expr-index 1)))))

(define (lower-masked-vector-let-bindings-have-bool-array-lane?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [bindings : AstLetBindingList]) : bool
  (lower-masked-vector-let-bindings-have-bool-array-lane-at?
    ctx
    env
    type-env
    index
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-have-bool-array-lane-at?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          (or
            (lower-masked-vector-body-has-bool-array-lane?
              ctx
              env
              type-env
              index
              init)
            (lower-masked-vector-let-bindings-have-bool-array-lane-at?
              ctx
              env
              type-env
              index
              bindings
              (+ binding-index 1))))])))

(define (lower-spmd-expr-list-has-out-of-line-call?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : bool
  (lower-spmd-expr-list-has-out-of-line-call-at? ctx env type-env (& exprs) 0))

(define (lower-spmd-expr-list-has-out-of-line-call-at?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-spmd-expr-has-out-of-line-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx (ast-expr-list-get exprs index 0)))
      (lower-spmd-expr-list-has-out-of-line-call-at?
        ctx
        env
        type-env
        exprs
        (+ index 1)))))

(define (lower-spmd-let-has-out-of-line-call?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstLetBindingList]) : bool
  (lower-spmd-let-has-out-of-line-call-at? ctx env type-env (& bindings) 0))

(define (lower-spmd-let-has-out-of-line-call-at?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (or
          (lower-spmd-expr-has-out-of-line-call?
            ctx
            env
            type-env
            (lower-context-expr-get ctx init-box))
          (lower-spmd-let-has-out-of-line-call-at?
            ctx
            env
            type-env
            bindings
            (+ index 1)))])))

(define (lower-spmd-expr-has-out-of-line-call?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-spmd-expr-has-out-of-line-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-spmd-expr-has-out-of-line-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Cast inner-box _)
      (lower-spmd-expr-has-out-of-line-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Unary _ inner-box)
      (lower-spmd-expr-has-out-of-line-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx left-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx right-box)))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (lower-context-expr-get ctx func-box)]
        (or
          (match (lower-spmd-inline-helper-lookup
            ctx
            env
            type-env
            LowerIdSet.Nil
            func)
            [(ResultLowerSpmdInlineHelper.Ok helper)
              (match helper
                [(LowerSpmdInlineHelper.Some _ _ _ body)
                  (lower-spmd-helper-out-of-line? ctx body)]
                [(LowerSpmdInlineHelper.Imported _ _ _) true]
                [(LowerSpmdInlineHelper.No) false])]
            [(ResultLowerSpmdInlineHelper.Err _) false])
          (lower-spmd-expr-list-has-out-of-line-call? ctx env type-env args)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-spmd-let-has-out-of-line-call? ctx env type-env bindings)
            (lower-spmd-expr-has-out-of-line-call?
              ctx
              env
              type-env
              (lower-context-expr-get ctx body-box)))])]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx cond-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx then-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx else-box)))]
    [(AstExpr.Begin exprs)
      (lower-spmd-expr-list-has-out-of-line-call? ctx env type-env exprs)]
    [(AstExpr.ArrayRef array-box index-box)
      (or
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx array-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx index-box)))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (or
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx array-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx index-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx value-box)))]
    [_ false]))

(define (lower-masked-vector-map
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [body : AstExpr]) : LowerMaybeMaskedVectorMap
  (let
    [varying-if : bool
      (lower-masked-vector-body-has-varying-if?
        ctx
        mode
        env
        type-env
        index
        body)]
    [varying-while : bool
      (lower-masked-vector-body-has-varying-while?
        ctx
        mode
        env
        type-env
        index
        body)]
    [varying-match : bool
      (lower-masked-vector-body-has-varying-match?
        ctx
        mode
        env
        type-env
        index
        body)]
    [varying-enum-match : bool
      (lower-masked-vector-body-has-varying-enum-match?
        ctx
        env
        type-env
        index
        body)]
    [bool-array-lane : bool
      (lower-masked-vector-body-has-bool-array-lane?
        ctx
        env
        type-env
        index
        body)]
    [out-of-line-call : bool
      (lower-spmd-expr-has-out-of-line-call? ctx env type-env body)]
    (if (or
      (and
        (lower-mode-avx512? mode)
        (not varying-enum-match)
        (or
          varying-if
          varying-while
          varying-match
          bool-array-lane
          out-of-line-call))
      (and
        (lower-mode-avx2? mode)
        (or
          varying-if
          varying-while
          varying-match
          varying-enum-match
          bool-array-lane)))
      (let
        [lanes : i64
          (lower-masked-vector-expr-lanes ctx mode env type-env index body)]
        (if (> lanes 0)
          (LowerMaybeMaskedVectorMap.Some lanes)
          (LowerMaybeMaskedVectorMap.No)))
      (LowerMaybeMaskedVectorMap.No))))

(define (lower-masked-vector-array-vars
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : LowerArrayVarSet
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars ctx env type-env index left)
          (lower-masked-vector-array-vars ctx env type-env index right)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (lower-array-var-set-merge
              (lower-masked-vector-let-binding-array-vars
                ctx
                env
                type-env
                index
                bindings)
              (lower-masked-vector-array-vars ctx env type-env index body)))])]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars ctx env type-env index cond)
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars ctx env type-env index then-branch)
            (lower-masked-vector-array-vars ctx env type-env index else-branch))))]
    [(AstExpr.While cond-box body-box)
      (lower-array-var-set-merge
        (lower-masked-vector-array-vars
          ctx
          env
          type-env
          index
          (lower-context-expr-get ctx cond-box))
        (lower-masked-vector-array-vars
          ctx
          env
          type-env
          index
          (lower-context-expr-get ctx body-box)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars
              ctx
              env
              type-env
              index
              (lower-context-expr-get ctx scrutinee-box))
            (lower-masked-vector-match-arms-array-vars
              ctx
              env
              type-env
              index
              arms))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-array-vars ctx env type-env index exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        [idx-offset : i64 (lower-masked-vector-index-offset ctx index idx)]
        (if (>= idx-offset 0)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some var _)
              (lower-array-var-set-add
                (lower-array-var-set-empty)
                var
                idx-offset)]
            [(LowerMaybeArrayVar.No) (lower-array-var-set-empty)])
          (lower-array-var-set-empty)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        [idx-offset : i64 (lower-masked-vector-index-offset ctx index idx)]
        (lower-array-var-set-merge
          (if (>= idx-offset 0)
            (match (lower-dynamic-array-var ctx env type-env arr)
              [(LowerMaybeArrayVar.Some var _)
                (lower-array-var-set-add
                  (lower-array-var-set-empty)
                  var
                  idx-offset)]
              [(LowerMaybeArrayVar.No) (lower-array-var-set-empty)])
            (lower-array-var-set-empty))
          (lower-masked-vector-array-vars ctx env type-env index value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars ctx env type-env index receiver)
          (lower-masked-vector-array-vars ctx env type-env index value)))]
    [_ (lower-array-var-set-empty)]))

(define (lower-masked-vector-expr-list-array-vars
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : AstExprList]) : LowerArrayVarSet
  (lower-masked-vector-expr-list-array-vars-at
    ctx
    env
    type-env
    index
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-array-vars-at
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : (& exprs AstExprList)]
  [expr-index : i64]) : LowerArrayVarSet
  (if (>= expr-index (struct-get exprs len))
    (lower-array-var-set-empty)
    (lower-array-var-set-merge
      (lower-masked-vector-array-vars
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx (ast-expr-list-get exprs expr-index 0)))
      (lower-masked-vector-expr-list-array-vars-at
        ctx
        env
        type-env
        index
        exprs
        (+ expr-index 1)))))

(define (lower-masked-vector-match-arms-array-vars
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [arms : AstMatchArmList]) : LowerArrayVarSet
  (lower-masked-vector-match-arms-array-vars-at
    ctx
    env
    type-env
    index
    (& arms)
    0))

(define (lower-masked-vector-match-arms-array-vars-at
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [arms : (& arms AstMatchArmList)]
  [arm-index : i64]) : LowerArrayVarSet
  (if (>= arm-index (struct-get arms len))
    (lower-array-var-set-empty)
    (match (ast-match-arm-list-get arms arm-index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars
            ctx
            env
            type-env
            index
            (lower-context-expr-get ctx body-box))
          (lower-masked-vector-match-arms-array-vars-at
            ctx
            env
            type-env
            index
            arms
            (+ arm-index 1)))])))

(define (lower-masked-vector-let-binding-array-vars
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [bindings : AstLetBindingList]) : LowerArrayVarSet
  (lower-masked-vector-let-binding-array-vars-at
    ctx
    env
    type-env
    index
    (& bindings)
    0))

(define (lower-masked-vector-let-binding-array-vars-at
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : LowerArrayVarSet
  (if (>= binding-index (ast-let-binding-list-len bindings))
    (lower-array-var-set-empty)
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars ctx env type-env index init)
            (lower-masked-vector-let-binding-array-vars-at
              ctx
              env
              type-env
              index
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-let-binding-names
  [bindings : AstLetBindingList]
  [lane-locals : LowerIdSet]) : LowerIdSet
  (lower-masked-vector-let-binding-names-at (& bindings) lane-locals 0))

(define (lower-masked-vector-let-binding-names-at
  [bindings : (& bindings AstLetBindingList)]
  [lane-locals : LowerIdSet]
  [binding-index : i64]) : LowerIdSet
  (if (>= binding-index (ast-let-binding-list-len bindings))
    lane-locals
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding name _ _)
        (lower-masked-vector-let-binding-names-at
          bindings
          (lower-id-set-insert lane-locals name)
          (+ binding-index 1))])))

(define (lower-vector-body-has-array-read? [ctx : TcContext] [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-array-read? ctx inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-array-read? ctx inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-array-read? ctx inner))]
    [(AstExpr.ArrayRef _ _) true]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-array-read? ctx inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-vector-body-has-array-read? ctx left)
          (lower-vector-body-has-array-read? ctx right)))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (or
          (lower-vector-body-has-array-read? ctx cond)
          (lower-vector-body-has-array-read? ctx then-branch)
          (lower-vector-body-has-array-read? ctx else-branch)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (or
            (lower-vector-body-has-array-read?
              ctx
              (lower-context-expr-get ctx scrutinee-box))
            (lower-match-arms-have-array-read? ctx arms))])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (or
              (lower-vector-let-bindings-have-array-read? ctx bindings)
              (lower-vector-body-has-array-read? ctx body)))])]
    [(AstExpr.Begin exprs) (lower-vector-expr-list-has-array-read? ctx exprs)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (lower-context-expr-get ctx func-box)]
        (or
          (lower-vector-body-has-array-read? ctx func)
          (lower-vector-expr-list-has-array-read? ctx args)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-array-read? ctx arr)
          (lower-vector-body-has-array-read? ctx idx)
          (lower-vector-body-has-array-read? ctx value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-array-read? ctx receiver)
          (lower-vector-body-has-array-read? ctx value)))]
    [_ false]))

(define (lower-match-arms-have-array-read?
  [ctx : TcContext]
  [arms : AstMatchArmList]) : bool
  (lower-match-arms-have-array-read-at? ctx (& arms) 0))

(define (lower-match-arms-have-array-read-at?
  [ctx : TcContext]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (or
          (lower-vector-body-has-array-read?
            ctx
            (lower-context-expr-get ctx body-box))
          (lower-match-arms-have-array-read-at? ctx arms (+ index 1)))])))

(define (lower-vector-expr-list-has-array-read?
  [ctx : TcContext]
  [exprs : AstExprList]) : bool
  (lower-vector-expr-list-has-array-read-at? ctx (& exprs) 0))

(define (lower-vector-expr-list-has-array-read-at?
  [ctx : TcContext]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-vector-body-has-array-read?
        ctx
        (lower-context-expr-get ctx (ast-expr-list-get exprs index 0)))
      (lower-vector-expr-list-has-array-read-at? ctx exprs (+ index 1)))))

(define (lower-vector-let-bindings-have-array-read?
  [ctx : TcContext]
  [bindings : AstLetBindingList]) : bool
  (lower-vector-let-bindings-have-array-read-at? ctx (& bindings) 0))

(define (lower-vector-let-bindings-have-array-read-at?
  [ctx : TcContext]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          (or
            (lower-vector-body-has-array-read? ctx init)
            (lower-vector-let-bindings-have-array-read-at?
              ctx
              bindings
              (+ binding-index 1))))])))

(define (lower-vector-body-has-spmd-shuffle? [ctx : TcContext] [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-spmd-shuffle? ctx inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-spmd-shuffle? ctx inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-spmd-shuffle? ctx inner))]
    [(AstExpr.SpmdShuffle _ _) true]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        [lane : AstExpr (lower-context-expr-get ctx lane-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx value)
          (lower-vector-body-has-spmd-shuffle? ctx lane)))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx arr)
          (lower-vector-body-has-spmd-shuffle? ctx idx)))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-spmd-shuffle? ctx inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx left)
          (lower-vector-body-has-spmd-shuffle? ctx right)))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx cond)
          (lower-vector-body-has-spmd-shuffle? ctx then-branch)
          (lower-vector-body-has-spmd-shuffle? ctx else-branch)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (or
              (lower-vector-let-bindings-have-spmd-shuffle? ctx bindings)
              (lower-vector-body-has-spmd-shuffle? ctx body)))])]
    [(AstExpr.Begin exprs) (lower-vector-expr-list-has-spmd-shuffle? ctx exprs)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (lower-context-expr-get ctx func-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx func)
          (lower-vector-expr-list-has-spmd-shuffle? ctx args)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx arr)
          (lower-vector-body-has-spmd-shuffle? ctx idx)
          (lower-vector-body-has-spmd-shuffle? ctx value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx receiver)
          (lower-vector-body-has-spmd-shuffle? ctx value)))]
    [_ false]))

(define (lower-vector-expr-list-has-spmd-shuffle?
  [ctx : TcContext]
  [exprs : AstExprList]) : bool
  (lower-vector-expr-list-has-spmd-shuffle-at? ctx (& exprs) 0))

(define (lower-vector-expr-list-has-spmd-shuffle-at?
  [ctx : TcContext]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-vector-body-has-spmd-shuffle?
        ctx
        (lower-context-expr-get ctx (ast-expr-list-get exprs index 0)))
      (lower-vector-expr-list-has-spmd-shuffle-at? ctx exprs (+ index 1)))))

(define (lower-vector-let-bindings-have-spmd-shuffle?
  [ctx : TcContext]
  [bindings : AstLetBindingList]) : bool
  (lower-vector-let-bindings-have-spmd-shuffle-at? ctx (& bindings) 0))

(define (lower-vector-let-bindings-have-spmd-shuffle-at?
  [ctx : TcContext]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          (or
            (lower-vector-body-has-spmd-shuffle? ctx init)
            (lower-vector-let-bindings-have-spmd-shuffle-at?
              ctx
              bindings
              (+ binding-index 1))))])))

(define (lower-vector-body-has-atomic-call?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-atomic-call? ctx env type-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-atomic-call? ctx env type-env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-atomic-call? ctx env type-env inner))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-atomic-call? ctx env type-env inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env left)
          (lower-vector-body-has-atomic-call? ctx env type-env right)))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env cond)
          (lower-vector-body-has-atomic-call? ctx env type-env then-branch)
          (lower-vector-body-has-atomic-call? ctx env type-env else-branch)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (or
              (lower-vector-let-bindings-have-atomic-call?
                ctx
                env
                type-env
                bindings)
              (lower-vector-body-has-atomic-call? ctx env type-env body)))])]
    [(AstExpr.Begin exprs)
      (lower-vector-expr-list-has-atomic-call? ctx env type-env exprs)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (lower-context-expr-get ctx func-box)]
        (or
          (>
            (string.string-length
              (lower-atomic-extern-symbol-for-func ctx type-env func))
            0)
          (lower-atomic-pointer-func? type-env func)
          (lower-vector-call-target-has-atomic? ctx env type-env func)
          (lower-vector-body-has-atomic-call? ctx env type-env func)
          (lower-vector-expr-list-has-atomic-call? ctx env type-env args)))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env arr)
          (lower-vector-body-has-atomic-call? ctx env type-env idx)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env arr)
          (lower-vector-body-has-atomic-call? ctx env type-env idx)
          (lower-vector-body-has-atomic-call? ctx env type-env value)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env receiver)
          (lower-vector-body-has-atomic-call? ctx env type-env value)))]
    [_ false]))

(define (lower-vector-expr-list-has-atomic-call?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : bool
  (lower-vector-expr-list-has-atomic-call-at? ctx env type-env (& exprs) 0))

(define (lower-vector-expr-list-has-atomic-call-at?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-vector-body-has-atomic-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx (ast-expr-list-get exprs index 0)))
      (lower-vector-expr-list-has-atomic-call-at?
        ctx
        env
        type-env
        exprs
        (+ index 1)))))

(define (lower-vector-let-bindings-have-atomic-call?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstLetBindingList]) : bool
  (lower-vector-let-bindings-have-atomic-call-at?
    ctx
    env
    type-env
    (& bindings)
    0))

(define (lower-vector-let-bindings-have-atomic-call-at?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          (or
            (lower-vector-body-has-atomic-call? ctx env type-env init)
            (lower-vector-let-bindings-have-atomic-call-at?
              ctx
              env
              type-env
              bindings
              (+ binding-index 1))))])))

(define (lower-vector-call-target-has-atomic?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (lower-spmd-inline-helper-lookup ctx env type-env LowerIdSet.Nil func)
    [(ResultLowerSpmdInlineHelper.Ok helper)
      (match helper
        [(LowerSpmdInlineHelper.Some name _ _ body)
          (if (lower-id-set-contains? lower-spmd-inline-helper-stack name)
            false
            (let
              [previous : LowerIdSet lower-spmd-inline-helper-stack]
              [result : bool false]
              (begin
                (set!
                  lower-spmd-inline-helper-stack
                  (lower-id-set-insert previous name))
                (set!
                  result
                  (lower-vector-body-has-atomic-call? ctx env type-env body))
                (set! lower-spmd-inline-helper-stack previous)
                result)))]
        [(LowerSpmdInlineHelper.Imported _ _ _) false]
        [(LowerSpmdInlineHelper.No) false])]
    [(ResultLowerSpmdInlineHelper.Err _) false]))

(define (lower-simple-vector-map-binop-supported?
  [mode : CompilerLowerMode]
  [elem-ty : AstType]
  [op : AstBinOp]) : bool
  (match op
    [(AstBinOp.Add) true]
    [(AstBinOp.BitAnd) true]
    [(AstBinOp.Mul)
      (and
        (> (lower-simd-lanes-for-elem mode elem-ty) 0)
        (not (lower-spmd-byte-lane-type? elem-ty)))]
    [_ false]))

(define (lower-spmd-byte-lane-type? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.I8) true]
    [(AstType.U8) true]
    [_ false]))

(define (lower-spmd-byte-mul-diagnostic) : String
  "lower: SPMD foreach SIMD lowering does not support 8-bit lane multiplication; use scalar or widen before multiplying")

(define (lower-spmd-expr-has-mul? [ctx : TcContext] [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-spmd-expr-has-mul? ctx inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-spmd-expr-has-mul? ctx inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-spmd-expr-has-mul? ctx inner))]
    [(AstExpr.Binary op lhs-box rhs-box)
      (match op
        [(AstBinOp.Mul) true]
        [_
          (or
            (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx lhs-box))
            (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx rhs-box)))])]
    [(AstExpr.ArraySet arr-box index-box value-box)
      (or
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx arr-box))
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx index-box))
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx value-box)))]
    [(AstExpr.Begin exprs) (lower-spmd-expr-list-has-mul? ctx exprs)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-spmd-let-bindings-have-mul? ctx bindings)
            (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx body-box)))])]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx cond-box))
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx then-box))
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx else-box)))]
    [_ false]))

(define (lower-spmd-expr-list-has-mul? [ctx : TcContext] [exprs : AstExprList]) : bool
  (lower-spmd-expr-list-has-mul-at? ctx (& exprs) 0))

(define (lower-spmd-expr-list-has-mul-at?
  [ctx : TcContext]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-spmd-expr-has-mul?
        ctx
        (lower-context-expr-get ctx (ast-expr-list-get exprs index 0)))
      (lower-spmd-expr-list-has-mul-at? ctx exprs (+ index 1)))))

(define (lower-spmd-let-bindings-have-mul?
  [ctx : TcContext]
  [bindings : AstLetBindingList]) : bool
  (lower-spmd-let-bindings-have-mul-at? ctx (& bindings) 0))

(define (lower-spmd-let-bindings-have-mul-at?
  [ctx : TcContext]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-let-binding-list-len bindings))
    false
    (or
      (match (ast-let-binding-list-get
        bindings
        binding-index
        (ast-let-binding-fallback))
        [(AstLetBinding.Binding _ _ init-box)
          (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx init-box))])
      (lower-spmd-let-bindings-have-mul-at? ctx bindings (+ binding-index 1)))))

(define (lower-simple-vector-map-has-unsupported-byte-mul?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [body : AstExpr]) : bool
  (match body
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-has-unsupported-byte-mul?
          ctx
          mode
          env
          type-env
          index
          inner))]
    [(AstExpr.ArraySet arr-box set-index-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [set-index : AstExpr (lower-context-expr-get ctx set-index-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (if (lower-expr-is-var? ctx set-index index)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some _ dst-elem)
              (and
                (> (lower-simd-lanes-for-elem mode dst-elem) 0)
                (lower-spmd-byte-lane-type? dst-elem)
                (lower-spmd-expr-has-mul? ctx value))]
            [(LowerMaybeArrayVar.No) false])
          false))]
    [_ false]))

(define (lower-simple-vector-map-casted-literal
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [target-ty : AstType]
  [dst-elem : AstType]
  [value : AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-casted-literal
          ctx
          mode
          target-ty
          dst-elem
          inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-casted-literal
          ctx
          mode
          target-ty
          dst-elem
          inner))]
    [(AstExpr.Literal lit)
      (if (and
        (> (lower-simd-lanes-for-elem mode target-ty) 0)
        (tc-type-eq target-ty dst-elem))
        (LowerMaybeVectorMapValue.Some
          (LowerVectorMapValue.Uniform
            (lower-literal-value-with-type lit target-ty)))
        (LowerMaybeVectorMapValue.No))]
    [_ (LowerMaybeVectorMapValue.No)]))

(define (lower-simple-vector-map-lane-array-value
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst-elem : AstType]
  [value : AstExpr]) : LowerMaybeVectorMapValue
  (match (lower-array-ref-var-for-program-index ctx env type-env value)
    [(LowerMaybeArrayVar.Some array-var array-elem)
      (if (tc-type-eq array-elem dst-elem)
        (LowerMaybeVectorMapValue.Some
          (LowerVectorMapValue.LaneArray array-var))
        (LowerMaybeVectorMapValue.No))]
    [(LowerMaybeArrayVar.No) (LowerMaybeVectorMapValue.No)]))

(define (lower-simple-vector-map-gather-lane-offset-var
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [value : AstExpr]) : LowerMaybeArrayVar
  (match value
    [(AstExpr.Spanned inner-box _)
      (lower-simple-vector-map-gather-lane-offset-var
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-simple-vector-map-gather-lane-offset-var
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Binary (AstBinOp.Add) lhs-box rhs-box)
      (let
        [lhs : AstExpr (lower-context-expr-get ctx lhs-box)]
        [rhs : AstExpr (lower-context-expr-get ctx rhs-box)]
        (if (lower-expr-is-var? ctx lhs index)
          (lower-array-ref-var-for-program-index ctx env type-env rhs)
          (if (lower-expr-is-var? ctx rhs index)
            (lower-array-ref-var-for-program-index ctx env type-env lhs)
            (LowerMaybeArrayVar.No))))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-simple-vector-map-gather-value
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [dst-elem : AstType]
  [value : AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(AstExpr.ArrayRef source-box indexes-box)
      (let
        [source : AstExpr (lower-context-expr-get ctx source-box)]
        [indexes : AstExpr (lower-context-expr-get ctx indexes-box)]
        (match (lower-dynamic-array-var ctx env type-env source)
          [(LowerMaybeArrayVar.Some source-var source-elem)
            (match (lower-array-ref-var-for-index
              ctx
              env
              type-env
              indexes
              index)
              [(LowerMaybeArrayVar.Some indexes-var indexes-elem)
                (if (and
                  (tc-type-eq source-elem dst-elem)
                  (tc-type-eq indexes-elem (AstType.I64)))
                  (LowerMaybeVectorMapValue.Some
                    (LowerVectorMapValue.Gather source-var indexes-var))
                  (LowerMaybeVectorMapValue.No))]
              [(LowerMaybeArrayVar.No)
                (match (lower-simple-vector-map-gather-lane-offset-var
                  ctx
                  env
                  type-env
                  index
                  indexes)
                  [(LowerMaybeArrayVar.Some offsets-var offsets-elem)
                    (if (and
                      (tc-type-eq source-elem dst-elem)
                      (tc-type-eq offsets-elem (AstType.I64)))
                      (LowerMaybeVectorMapValue.Some
                        (LowerVectorMapValue.GatherLaneOffset
                          source-var
                          offsets-var))
                      (LowerMaybeVectorMapValue.No))]
                  [(LowerMaybeArrayVar.No) (LowerMaybeVectorMapValue.No)])])]
          [(LowerMaybeArrayVar.No) (LowerMaybeVectorMapValue.No)]))]
    [_ (LowerMaybeVectorMapValue.No)]))

(define (lower-vector-shuffle-value-type? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.F32) true]
    [(AstType.F64) true]
    [_ false]))

;; Keep shuffle operand evaluation to plans whose inactive lanes can be
;; suppressed by the existing predicated vector machinery. Gather and
;; broadcast plans need their own ordered gang-tail treatment and remain a
;; focused diagnostic instead of silently changing to one-lane semantics.
(define (lower-vector-shuffle-operand-plan? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapValue.Array _) true]
    [(LowerVectorMapValue.Uniform _) true]
    [(LowerVectorMapValue.LaneIndex) true]
    [(LowerVectorMapValue.LaneCount) true]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (and
        (lower-vector-shuffle-operand-plan? (box-get lhs))
        (lower-vector-shuffle-operand-plan? (box-get rhs)))]
    [_ false]))

(define (lower-vector-map-value-has-shuffle? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapValue.Shuffle _ _) true]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-has-shuffle? (box-get lhs))
        (lower-vector-map-value-has-shuffle? (box-get rhs)))]
    [_ false]))

(define (lower-simple-vector-map-value
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [dst-elem : AstType]
  [value : AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-value
          ctx
          mode
          env
          type-env
          index
          dst-elem
          inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-value
          ctx
          mode
          env
          type-env
          index
          dst-elem
          inner))]
    [(AstExpr.Cast inner-box cast-ty)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        [target-ty : AstType (tc-type-without-regions cast-ty)]
        (match (lower-simple-vector-map-casted-literal
          ctx
          mode
          target-ty
          dst-elem
          inner)
          [(LowerMaybeVectorMapValue.Some plan)
            (LowerMaybeVectorMapValue.Some plan)]
          [(LowerMaybeVectorMapValue.No)
            (lower-simple-vector-map-value
              ctx
              mode
              env
              type-env
              index
              dst-elem
              inner)]))]
    [(AstExpr.ArrayRef _ _)
      (match (lower-array-ref-var-for-index ctx env type-env value index)
        [(LowerMaybeArrayVar.Some array-var array-elem)
          (if (tc-type-eq array-elem dst-elem)
            (LowerMaybeVectorMapValue.Some
              (LowerVectorMapValue.Array array-var))
            (LowerMaybeVectorMapValue.No))]
        [(LowerMaybeArrayVar.No)
          (match (lower-simple-vector-map-gather-value
            ctx
            env
            type-env
            index
            dst-elem
            value)
            [(LowerMaybeVectorMapValue.Some plan)
              (LowerMaybeVectorMapValue.Some plan)]
            [(LowerMaybeVectorMapValue.No)
              (lower-simple-vector-map-lane-array-value
                ctx
                env
                type-env
                dst-elem
                value)])])]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [source : AstExpr (lower-context-expr-get ctx value-box)]
        [selector : AstExpr (lower-context-expr-get ctx lane-box)]
        (if (and
          (lower-vector-shuffle-value-type? dst-elem)
          (> (lower-simd-lanes-for-elem mode dst-elem) 0))
          (match (lower-simple-vector-map-value
            ctx
            mode
            env
            type-env
            index
            dst-elem
            source)
            [(LowerMaybeVectorMapValue.Some source-plan)
              (match (lower-simple-vector-map-value
                ctx
                mode
                env
                type-env
                index
                (AstType.I64)
                selector)
                [(LowerMaybeVectorMapValue.Some selector-plan)
                  (if (and
                    (lower-vector-shuffle-operand-plan? source-plan)
                    (lower-vector-shuffle-operand-plan? selector-plan))
                    (LowerMaybeVectorMapValue.Some
                      (LowerVectorMapValue.Shuffle
                        (box source-plan)
                        (box selector-plan)))
                    (LowerMaybeVectorMapValue.No))]
                [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorMapValue.No)])]
            [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorMapValue.No)])
          (LowerMaybeVectorMapValue.No)))]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [source : AstExpr (lower-context-expr-get ctx value-box)]
        [lane : AstExpr (lower-context-expr-get ctx lane-box)]
        (match (lower-simple-spmd-broadcast-lane ctx env type-env lane)
          [(LowerMaybeIrValue.Some lane-value)
            (match (lower-array-ref-var-for-index ctx env type-env source index)
              [(LowerMaybeArrayVar.Some array-var array-elem)
                (if (tc-type-eq array-elem dst-elem)
                  (LowerMaybeVectorMapValue.Some
                    (LowerVectorMapValue.BroadcastArray array-var lane-value))
                  (LowerMaybeVectorMapValue.No))]
              [(LowerMaybeArrayVar.No)
                (lower-simple-vector-map-value
                  ctx
                  mode
                  env
                  type-env
                  index
                  dst-elem
                  source)])]
          [(LowerMaybeIrValue.No) (LowerMaybeVectorMapValue.No)]))]
    [(AstExpr.SpmdProgramIndex)
      (if (and
        (> (lower-simd-lanes-for-elem mode dst-elem) 0)
        (tc-type-eq dst-elem (AstType.I64)))
        (LowerMaybeVectorMapValue.Some (LowerVectorMapValue.LaneIndex))
        (LowerMaybeVectorMapValue.No))]
    [(AstExpr.SpmdProgramCount)
      (if (and
        (> (lower-simd-lanes-for-elem mode dst-elem) 0)
        (tc-type-eq dst-elem (AstType.I64)))
        (LowerMaybeVectorMapValue.Some (LowerVectorMapValue.LaneCount))
        (LowerMaybeVectorMapValue.No))]
    [(AstExpr.Var name)
      (let
        [lookup-name : String (tc-env-key-name-text name)]
        (if (string.eq lookup-name index)
          (LowerMaybeVectorMapValue.No)
          (let
            [var-id : i64
              (sym_i64_env.sym-i64-lookup-id-or
                env
                name
                (compiler-symbols-missing-handle))]
            (if (compiler-symbols-handle-found? var-id)
              (match (tc-lookup-id type-env name)
                [(ResultTcType.Ok ty)
                  (let
                    [scalar-ty : AstType (tc-type-without-regions ty)]
                    (if (and
                      (> (lower-simd-lanes-for-elem mode scalar-ty) 0)
                      (tc-type-eq scalar-ty dst-elem))
                      (LowerMaybeVectorMapValue.Some
                        (LowerVectorMapValue.Uniform
                          (CompilerIrValue.Var var-id)))
                      (LowerMaybeVectorMapValue.No)))]
                [(ResultTcType.Err _) (LowerMaybeVectorMapValue.No)])
              (LowerMaybeVectorMapValue.No)))))]
    [(AstExpr.Literal lit)
      (let
        [lit-ty : AstType (tc-literal-type lit)]
        (match lit
          [(AstLiteral.Int _ _)
            (if (and
              (> (lower-simd-lanes-for-elem mode dst-elem) 0)
              (tc-integer-type? dst-elem))
              (LowerMaybeVectorMapValue.Some
                (LowerVectorMapValue.Uniform
                  (lower-literal-value-with-type lit dst-elem)))
              (LowerMaybeVectorMapValue.No))]
          [_
            (if (and
              (> (lower-simd-lanes-for-elem mode lit-ty) 0)
              (tc-type-eq lit-ty dst-elem))
              (LowerMaybeVectorMapValue.Some
                (LowerVectorMapValue.Uniform
                  (lower-literal-value-with-type lit dst-elem)))
              (LowerMaybeVectorMapValue.No))]))]
    [(AstExpr.Binary op lhs-box rhs-box)
      (if (lower-simple-vector-map-binop-supported? mode dst-elem op)
        (let
          [lhs : AstExpr (lower-context-expr-get ctx lhs-box)]
          [rhs : AstExpr (lower-context-expr-get ctx rhs-box)]
          (match (lower-simple-vector-map-value
            ctx
            mode
            env
            type-env
            index
            dst-elem
            lhs)
            [(LowerMaybeVectorMapValue.Some lhs-plan)
              (match (lower-simple-vector-map-value
                ctx
                mode
                env
                type-env
                index
                dst-elem
                rhs)
                [(LowerMaybeVectorMapValue.Some rhs-plan)
                  (LowerMaybeVectorMapValue.Some
                    (LowerVectorMapValue.BinOp
                      (lower-binop op)
                      (box lhs-plan)
                      (box rhs-plan)))]
                [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorMapValue.No)])]
            [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorMapValue.No)]))
        (LowerMaybeVectorMapValue.No))]
    [_ (LowerMaybeVectorMapValue.No)]))

(define (lower-vector-map-value-array-vars [plan : LowerVectorMapValue]) : LowerArrayVarSet
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
    [(LowerVectorMapValue.Gather _ indexes-var)
      ;; Only the contiguous index stream participates in the vector loop's
      ;; range proof. Gathered source indexes are checked individually below.
      (lower-array-var-set-add (lower-array-var-set-empty) indexes-var 0)]
    [(LowerVectorMapValue.GatherLaneOffset _ _) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.LaneArray _) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.Uniform _) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.BroadcastArray array-var _)
      (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
    [(LowerVectorMapValue.LaneIndex) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.LaneCount) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.Shuffle source selector)
      (lower-array-var-set-merge
        (lower-vector-map-value-array-vars (box-get source))
        (lower-vector-map-value-array-vars (box-get selector)))]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (lower-array-var-set-merge
        (lower-vector-map-value-array-vars (box-get lhs))
        (lower-vector-map-value-array-vars (box-get rhs)))]))

(define (lower-vector-map-value-uses-array?
  [plan : LowerVectorMapValue]
  [array-var : i64]) : bool
  (match plan
    [(LowerVectorMapValue.Array found) (= found array-var)]
    [(LowerVectorMapValue.Gather source indexes)
      (or (= source array-var) (= indexes array-var))]
    [(LowerVectorMapValue.GatherLaneOffset source offsets)
      (or (= source array-var) (= offsets array-var))]
    [(LowerVectorMapValue.LaneArray found) (= found array-var)]
    [(LowerVectorMapValue.BroadcastArray found _) (= found array-var)]
    [(LowerVectorMapValue.Shuffle source selector)
      (or
        (lower-vector-map-value-uses-array? (box-get source) array-var)
        (lower-vector-map-value-uses-array? (box-get selector) array-var))]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-uses-array? (box-get lhs) array-var)
        (lower-vector-map-value-uses-array? (box-get rhs) array-var))]
    [_ false]))

(define (lower-vector-map-store-list-empty) : LowerVectorMapStoreList
  (LowerVectorMapStoreList (make-array LowerVectorMapStore 0) 0))

(define (lower-vector-map-store-list-add
  [stores : LowerVectorMapStoreList]
  [store : LowerVectorMapStore]) : LowerVectorMapStoreList
  (let
    [items : (Array LowerVectorMapStore) (struct-get stores items)]
    [count : i64 (struct-get stores count)]
    (begin
      (array-push! items store)
      (LowerVectorMapStoreList items (+ count 1)))))

(define (lower-vector-map-store-list-ref
  [stores : LowerVectorMapStoreList]
  [index : i64]) : LowerVectorMapStore
  (array-ref (struct-get stores items) index))

(define (lower-vector-map-store-list-has-destination?
  [stores : LowerVectorMapStoreList]
  [array-var : i64]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore array-var-found _)
            (if (= array-var-found array-var)
              (set! found true)
              (set! index (+ index 1)))]))
      found)))

(define (lower-vector-map-store-list-input-uses-destination?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore _ value-plan)
            (let
              [dst-index : i64 0]
              (begin
                (while (and (not found) (< dst-index count))
                  (match (lower-vector-map-store-list-ref stores dst-index)
                    [(LowerVectorMapStore dst-array _)
                      (if (lower-vector-map-value-uses-array?
                        value-plan
                        dst-array)
                        (set! found true)
                        (set! dst-index (+ dst-index 1)))]))
                (set! index (+ index 1))))]))
      found)))

(define (lower-vector-map-store-list-array-vars
  [stores : LowerVectorMapStoreList]) : LowerArrayVarSet
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [arrays : LowerArrayVarSet (lower-array-var-set-empty)]
    (begin
      (while (< index count)
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore dst-array value-plan)
            (begin
              (set!
                arrays
                (lower-array-var-set-merge
                  arrays
                  (lower-vector-map-value-array-vars value-plan)))
              (set! arrays (lower-array-var-set-add arrays dst-array 0))
              (set! index (+ index 1)))]))
      arrays)))

(define (lower-simple-vector-map-store
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : LowerMaybeVectorMapStore
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-simple-vector-map-store
        ctx
        mode
        env
        type-env
        index
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.ArraySet arr-box set-index-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [set-index : AstExpr (lower-context-expr-get ctx set-index-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (if (lower-expr-is-var? ctx set-index index)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some dst-var dst-elem)
              (let
                [lanes : i64 (lower-simd-lanes-for-elem mode dst-elem)]
                (if (> lanes 0)
                  (match (lower-simple-vector-map-value
                    ctx
                    mode
                    env
                    type-env
                    index
                    dst-elem
                    value)
                    [(LowerMaybeVectorMapValue.Some value-plan)
                      (LowerMaybeVectorMapStore.Some
                        (LowerVectorMapStore dst-var value-plan)
                        dst-elem
                        lanes)]
                    [(LowerMaybeVectorMapValue.No)
                      (LowerMaybeVectorMapStore.No)])
                  (LowerMaybeVectorMapStore.No)))]
            [(LowerMaybeArrayVar.No) (LowerMaybeVectorMapStore.No)])
          (LowerMaybeVectorMapStore.No)))]
    [_ (LowerMaybeVectorMapStore.No)]))

(define (lower-simple-vector-map-expr-list
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : AstExprList]) : LowerMaybeVectorMap
  (lower-simple-vector-map-expr-list-at
    ctx
    mode
    env
    type-env
    index
    (& exprs)
    0
    (lower-vector-map-store-list-empty)
    (AstType.Unit)
    0))

(define (lower-simple-vector-map-expr-list-at
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [exprs : (& exprs AstExprList)]
  [expr-index : i64]
  [stores : LowerVectorMapStoreList]
  [elem-ty : AstType]
  [lanes : i64]) : LowerMaybeVectorMap
  (if (>= expr-index (struct-get exprs len))
    (if (and
      (> (struct-get stores count) 0)
      (or
        (= (struct-get stores count) 1)
        (not (lower-vector-map-store-list-input-uses-destination? stores))))
      (LowerMaybeVectorMap.Some stores elem-ty lanes)
      (LowerMaybeVectorMap.No))
    (match (lower-simple-vector-map-store
      ctx
      mode
      env
      type-env
      index
      (lower-context-expr-get ctx (ast-expr-list-get exprs expr-index 0)))
      [(LowerMaybeVectorMapStore.Some store store-elem store-lanes)
        (match store
          [(LowerVectorMapStore dst-array _)
            (if (or
              (lower-vector-map-store-list-has-destination? stores dst-array)
              (and
                (> (struct-get stores count) 0)
                (or
                  (not (tc-type-eq elem-ty store-elem))
                  (not (= lanes store-lanes)))))
              (LowerMaybeVectorMap.No)
              (lower-simple-vector-map-expr-list-at
                ctx
                mode
                env
                type-env
                index
                exprs
                (+ expr-index 1)
                (lower-vector-map-store-list-add stores store)
                store-elem
                store-lanes))])]
      [(LowerMaybeVectorMapStore.No) (LowerMaybeVectorMap.No)])))

(define (lower-simple-vector-map
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [body : AstExpr]) : LowerMaybeVectorMap
  (match body
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map ctx mode env type-env index inner))]
    [(AstExpr.Begin exprs)
      (lower-simple-vector-map-expr-list ctx mode env type-env index exprs)]
    [(AstExpr.ArraySet _ _ _)
      (match (lower-simple-vector-map-store ctx mode env type-env index body)
        [(LowerMaybeVectorMapStore.Some store elem-ty lanes)
          (LowerMaybeVectorMap.Some
            (lower-vector-map-store-list-add
              (lower-vector-map-store-list-empty)
              store)
            elem-ty
            lanes)]
        [(LowerMaybeVectorMapStore.No) (LowerMaybeVectorMap.No)])]
    [_ (LowerMaybeVectorMap.No)]))

(define (lower-simple-vector-reduce-op-supported?
  [mode : CompilerLowerMode]
  [op : AstReduceOp]
  [elem : AstType]) : bool
  (match op
    [(AstReduceOp.Sum)
      (match elem
        [(AstType.I64) true]
        [(AstType.I32) true]
        [(AstType.F32) true]
        [(AstType.F64) true]
        [_ false])]
    [(AstReduceOp.Min)
      (match elem
        [(AstType.I32) true]
        [(AstType.I64) (lower-mode-avx512? mode)]
        [_ false])]
    [(AstReduceOp.Max)
      (match elem
        [(AstType.I32) true]
        [(AstType.I64) (lower-mode-avx512? mode)]
        [_ false])]
    [_ false]))

(define (lower-simple-vector-scan-op-supported?
  [op : AstReduceOp]
  [elem : AstType]) : bool
  (match op
    [(AstReduceOp.Sum)
      (match elem
        [(AstType.I32) true]
        [(AstType.I64) true]
        [_ false])]
    [(AstReduceOp.Min)
      (match elem
        [(AstType.I32) true]
        [(AstType.I64) true]
        [_ false])]
    [(AstReduceOp.Max)
      (match elem
        [(AstType.I32) true]
        [(AstType.I64) true]
        [_ false])]
    [(AstReduceOp.All)
      (match elem
        [(AstType.Bool) true]
        [_ false])]
    [(AstReduceOp.Any)
      (match elem
        [(AstType.Bool) true]
        [_ false])]))

(define (lower-simple-vector-scan-op [op : AstReduceOp]) : CompilerIrVectorPrefixOp
  (match op
    [(AstReduceOp.Sum) (CompilerIrVectorPrefixOp.Sum)]
    [(AstReduceOp.Min) (CompilerIrVectorPrefixOp.Min)]
    [(AstReduceOp.Max) (CompilerIrVectorPrefixOp.Max)]
    [(AstReduceOp.All) (CompilerIrVectorPrefixOp.All)]
    [(AstReduceOp.Any) (CompilerIrVectorPrefixOp.Any)]))

(define (lower-simple-vector-scan-output
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [prefix : String]
  [body : AstExpr]) : LowerMaybeArrayVar
  (match body
    [(AstExpr.Spanned inner-box _)
      (lower-simple-vector-scan-output
        ctx
        env
        type-env
        index
        prefix
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-simple-vector-scan-output
        ctx
        env
        type-env
        index
        prefix
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (if (and
        (lower-expr-is-var? ctx (lower-context-expr-get ctx index-box) index)
        (lower-expr-is-var? ctx (lower-context-expr-get ctx value-box) prefix))
        (lower-dynamic-array-var
          ctx
          env
          type-env
          (lower-context-expr-get ctx array-box))
        (LowerMaybeArrayVar.No))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-simple-vector-scan
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index : String]
  [prefix : String]
  [prefix-ty : AstType]
  [value : AstExpr]
  [body : AstExpr]) : LowerMaybeVectorScan
  (if (not (lower-mode-simd? mode))
    (LowerMaybeVectorScan.No)
    (match (lower-array-ref-var-for-index ctx env type-env value index)
      [(LowerMaybeArrayVar.Some input-var input-ty)
        (match (lower-simple-vector-scan-output
          ctx
          env
          type-env
          index
          prefix
          body)
          [(LowerMaybeArrayVar.Some output-var output-ty)
            (let
              [elem-ty : AstType (tc-type-without-regions input-ty)]
              [lanes : i64
                (if (lower-type-bool? elem-ty)
                  (lower-avx512-bool-lanes mode)
                  (lower-simd-lanes-for-elem mode elem-ty))]
              (if (and
                (> lanes 0)
                (tc-type-eq elem-ty (tc-type-without-regions output-ty))
                (tc-type-eq elem-ty (tc-type-without-regions prefix-ty))
                (lower-simple-vector-scan-op-supported? op elem-ty))
                (LowerMaybeVectorScan.Scan
                  input-var
                  output-var
                  (lower-simple-vector-scan-op op)
                  elem-ty
                  lanes)
                (LowerMaybeVectorScan.No)))]
          [(LowerMaybeArrayVar.No) (LowerMaybeVectorScan.No)])]
      [(LowerMaybeArrayVar.No) (LowerMaybeVectorScan.No)])))

(define (lower-simple-vector-reduce-op [op : AstReduceOp]) : CompilerIrVectorReduceOp
  (match op
    [(AstReduceOp.Min) (CompilerIrVectorReduceOp.Min)]
    [(AstReduceOp.Max) (CompilerIrVectorReduceOp.Max)]
    [_ (CompilerIrVectorReduceOp.Sum)]))

(define (lower-simple-vector-reduce
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index : String]
  [value-ty : AstType]
  [value : AstExpr]) : LowerMaybeVectorReduce
  (if (lower-mode-simd? mode)
    (match value
      [(AstExpr.Spanned inner-box _)
        (let
          [inner : AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-simple-vector-reduce
            ctx
            mode
            env
            type-env
            op
            index
            value-ty
            inner))]
      [(AstExpr.Ann inner-box _)
        (let
          [inner : AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-simple-vector-reduce
            ctx
            mode
            env
            type-env
            op
            index
            value-ty
            inner))]
      [_
        (match (lower-array-ref-var-for-index ctx env type-env value index)
          [(LowerMaybeArrayVar.Some array-var elem-ty)
            (let
              [elem : AstType (tc-type-without-regions elem-ty)]
              [lanes : i64 (lower-simd-lanes-for-elem mode elem)]
              (if (and
                (> lanes 0)
                (lower-simple-vector-reduce-op-supported? mode op elem))
                (LowerMaybeVectorReduce.Array
                  array-var
                  (lower-simple-vector-reduce-op op)
                  elem
                  lanes)
                (LowerMaybeVectorReduce.No)))]
          [(LowerMaybeArrayVar.No)
            (let
              [elem : AstType (tc-type-without-regions value-ty)]
              [lanes : i64 (lower-simd-lanes-for-elem mode elem)]
              (if (and
                (> lanes 0)
                (lower-simple-vector-reduce-op-supported? mode op elem))
                (match (lower-simple-vector-map-value
                  ctx
                  mode
                  env
                  type-env
                  index
                  elem
                  value)
                  [(LowerMaybeVectorMapValue.Some value-plan)
                    (LowerMaybeVectorReduce.Value
                      value-plan
                      (lower-simple-vector-reduce-op op)
                      elem
                      lanes)]
                  [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorReduce.No)])
                (LowerMaybeVectorReduce.No)))])])
    (LowerMaybeVectorReduce.No)))

(define (lower-array-len-value
  [state : LowerState]
  [arr-value : CompilerIrValue]) : LowerExpr
  (match (lower-emit-gep state arr-value (CompilerIrValue.I64 1) (AstType.I64))
    [(LowerExpr.Expr gep-state len-gep _)
      (lower-emit-load gep-state len-gep (AstType.I64))]))

(define (lower-array-data-pointer-value
  [state : LowerState]
  [arr-value : CompilerIrValue]) : LowerExpr
  ;; Dynamic-array fat header slot 0 is the element data pointer. Emit it as a
  ;; normal load keyed by the array header value so redundant-load CSE can see
  ;; repeated SIMD accesses to the same base.
  (lower-emit-load state arr-value (AstType.U64)))

(define (lower-emit-vector-load-data
  [state : LowerState]
  [data-ptr : CompilerIrValue]
  [index : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (CompilerIrInstr.VectorLoad v data-ptr index lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-vector-load
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr.Expr data-state data-ptr _)
      (lower-emit-vector-load-data data-state data-ptr index lanes elem-ty)]))

(define (lower-emit-gather-load
  [state : LowerState]
  [base : CompilerIrValue]
  [index-base : CompilerIrValue]
  [index : CompilerIrValue]
  [lane-offset : bool]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir-instr-gather-load
            v
            base
            index-base
            index
            lane-offset
            lanes
            elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-vector-shuffle-instr
  [state : LowerState]
  [source : CompilerIrValue]
  [selector-low : CompilerIrValue]
  [selector-high : CompilerIrMaybeValue]
  [active-lanes : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir-instr-vector-shuffle
            v
            source
            selector-low
            selector-high
            active-lanes
            lanes
            elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-gather-lane-checks
  [_ctx : TcContext]
  [state : LowerState]
  [indexes-data : CompilerIrValue]
  [base-index-var : i64]
  [lane : i64]
  [lanes : i64]
  [source-len : CompilerIrValue]) : LowerExpr
  (if (>= lane lanes)
    (LowerExpr.Expr state CompilerIrValue.Unit (AstType.Unit))
    (match (if (= lane 0)
      (LowerExpr.Expr state (CompilerIrValue.Var base-index-var) (AstType.I64))
      (lower-emit-binop
        state
        CompilerIrBinOp.Add
        (CompilerIrValue.Var base-index-var)
        (CompilerIrValue.I64 lane)
        (AstType.I64)))
      [(LowerExpr.Expr lane-state logical-index _)
        ;; The vector-loop range guard has already proved this contiguous
        ;; index lane is in bounds. Address it directly so gather validation
        ;; performs only the semantically required source-index check.
        (match (lower-emit-gep
          lane-state
          indexes-data
          logical-index
          (AstType.I64))
          [(LowerExpr.Expr addr-state index-ptr _)
            (match (lower-emit-load addr-state index-ptr (AstType.I64))
              [(LowerExpr.Expr index-state gathered-index _)
                (lower-emit-gather-lane-checks
                  _ctx
                  (lower-emit-bounds-check
                    index-state
                    gathered-index
                    source-len)
                  indexes-data
                  base-index-var
                  (+ lane 1)
                  lanes
                  source-len)])])])))

(define (lower-emit-gather-lane-offset-checks
  [state : LowerState]
  [offsets-data : CompilerIrValue]
  [base-index-var : i64]
  [lane : i64]
  [lanes : i64]
  [source-len : CompilerIrValue]) : LowerExpr
  (if (>= lane lanes)
    (LowerExpr.Expr state CompilerIrValue.Unit (AstType.Unit))
    (match (if (= lane 0)
      (LowerExpr.Expr state (CompilerIrValue.Var base-index-var) (AstType.I64))
      (lower-emit-binop
        state
        CompilerIrBinOp.Add
        (CompilerIrValue.Var base-index-var)
        (CompilerIrValue.I64 lane)
        (AstType.I64)))
      [(LowerExpr.Expr logical-state logical-index _)
        (match (lower-emit-gep
          logical-state
          offsets-data
          (CompilerIrValue.I64 lane)
          (AstType.I64))
          [(LowerExpr.Expr addr-state offset-ptr _)
            (match (lower-emit-load addr-state offset-ptr (AstType.I64))
              [(LowerExpr.Expr offset-state offset _)
                (match (lower-emit-binop
                  offset-state
                  CompilerIrBinOp.Add
                  logical-index
                  offset
                  (AstType.I64))
                  [(LowerExpr.Expr index-state gathered-index _)
                    (lower-emit-gather-lane-offset-checks
                      (lower-emit-bounds-check
                        index-state
                        gathered-index
                        source-len)
                      offsets-data
                      base-index-var
                      (+ lane 1)
                      lanes
                      source-len)])])])])))

(define (lower-emit-vector-store
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [value : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerState
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr.Expr data-state data-ptr _)
      (lower-emit-vector-store-data
        data-state
        data-ptr
        index
        value
        lanes
        elem-ty)]))

(define (lower-emit-vector-store-data
  [state : LowerState]
  [data-ptr : CompilerIrValue]
  [index : CompilerIrValue]
  [value : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerState
  (lower-state-emit
    state
    (ir-instr-vector-store data-ptr index value lanes elem-ty)))

(define (lower-emit-vector-binop
  [state : LowerState]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir-instr-vector-bin-op v op lhs rhs lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-splat
  [state : LowerState]
  [value : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.Splat v value lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-lane-id
  [state : LowerState]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.LaneId v lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-foreach-index-vector
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]) : LowerExpr
  (match (lower-emit-splat
    state
    (CompilerIrValue.Var index-var)
    lanes
    (AstType.I64))
    [(LowerExpr.Expr base-state base-value _)
      (match (lower-emit-lane-id base-state lanes (AstType.I64))
        [(LowerExpr.Expr lane-state lane-value _)
          (lower-emit-vector-binop
            lane-state
            (CompilerIrBinOp.Add)
            base-value
            lane-value
            lanes
            (AstType.I64))])]))

(define (lower-emit-vector-compare
  [state : LowerState]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir-instr-vector-compare v op lhs rhs lanes elem-ty))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-mask-binop
  [state : LowerState]
  [op : CompilerIrMaskBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.MaskBinOp v op lhs rhs lanes))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-mask-not
  [state : LowerState]
  [src : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.MaskNot v src lanes))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-mask-reduce
  [state : LowerState]
  [op : CompilerIrMaskReduceOp]
  [src : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.MaskReduce v op src lanes))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-mask-select
  [state : LowerState]
  [then-mask : CompilerIrValue]
  [then-value : CompilerIrValue]
  [else-mask : CompilerIrValue]
  [else-value : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [then-bits : CompilerIrValue CompilerIrValue.Unit]
    [else-bits : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-emit-mask-binop
        s
        (CompilerIrMaskBinOp.And)
        then-mask
        then-value
        lanes)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! then-bits value))])
      (match (lower-emit-mask-binop
        s
        (CompilerIrMaskBinOp.And)
        else-mask
        else-value
        lanes)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! else-bits value))])
      (lower-emit-mask-binop
        s
        (CompilerIrMaskBinOp.Or)
        then-bits
        else-bits
        lanes))))

(define (lower-emit-select
  [state : LowerState]
  [mask : CompilerIrValue]
  [on-true : CompilerIrValue]
  [on-false : CompilerIrValue]
  [lanes : i64]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir-instr-select v mask on-true on-false lanes ty))
        (CompilerIrValue.Var v)
        ty)]))

;; SIMD loop bounds are invariant across gangs. Build the minimum with scalar
;; mask blends in the preheader so each vector header needs only one compare.
(define (lower-vector-loop-i64-compare
  [state : LowerState]
  [op : CompilerIrBinOp]
  [left : CompilerIrValue]
  [right : CompilerIrValue]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      ;; Comparisons produce a boolean value, but the IR instruction's type is
      ;; the operand width used by the backend comparison.
      (LowerExpr.Expr
        (lower-state-emit
          s
          (CompilerIrInstr.BinOp v op left right (AstType.I64)))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-vector-loop-select
  [state : LowerState]
  [condition : CompilerIrValue]
  [on-true : CompilerIrValue]
  [on-false : CompilerIrValue]) : LowerExpr
  (let
    [s : LowerState state]
    [condition-i64 : CompilerIrValue CompilerIrValue.Unit]
    [mask : CompilerIrValue CompilerIrValue.Unit]
    [different-bits : CompilerIrValue CompilerIrValue.Unit]
    [selected-bits : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-emit-cast s condition (AstType.Bool) (AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! condition-i64 value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.Sub)
        (CompilerIrValue.I64 0)
        condition-i64
        (AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! mask value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.BitXor)
        on-true
        on-false
        (AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! different-bits value))])
      (match (lower-emit-binop
        s
        (CompilerIrBinOp.BitAnd)
        different-bits
        mask
        (AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! selected-bits value))])
      (lower-emit-binop
        s
        (CompilerIrBinOp.BitXor)
        on-false
        selected-bits
        (AstType.I64)))))

(define (lower-vector-loop-min
  [state : LowerState]
  [left : CompilerIrValue]
  [right : CompilerIrValue]) : LowerExpr
  (match (lower-vector-loop-i64-compare state (CompilerIrBinOp.Le) left right)
    [(LowerExpr.Expr cmp-state take-left _)
      (lower-vector-loop-select cmp-state take-left left right)]))

(define (lower-vector-loop-start-ok
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      ;; As u64, every negative i64 start is above INT64_MAX. This one check
      ;; therefore also proves that adding lanes cannot overflow.
      (LowerExpr.Expr
        (lower-state-emit
          s
          (CompilerIrInstr.BinOp
            v
            (CompilerIrBinOp.Le)
            (CompilerIrValue.Var index-var)
            (CompilerIrValue.I64 (- 9223372036854775807 lanes))
            (AstType.U64)))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-vector-loop-array-limit
  [state : LowerState]
  [array-var : i64]
  [offset : i64]) : LowerExpr
  (match (lower-array-len-value state (CompilerIrValue.Var array-var))
    [(LowerExpr.Expr len-state array-len _)
      (if (> offset 0)
        (let
          [s : LowerState len-state]
          [offset-valid : CompilerIrValue CompilerIrValue.Unit]
          [candidate : CompilerIrValue CompilerIrValue.Unit]
          (begin
            (match (lower-vector-loop-i64-compare
              s
              (CompilerIrBinOp.Ge)
              array-len
              (CompilerIrValue.I64 offset))
              [(LowerExpr.Expr next-s value _)
                (begin
                  (set! s next-s)
                  (set! offset-valid value))])
            (match (lower-emit-binop
              s
              (CompilerIrBinOp.Sub)
              array-len
              (CompilerIrValue.I64 offset)
              (AstType.I64))
              [(LowerExpr.Expr next-s value _)
                (begin
                  (set! s next-s)
                  (set! candidate value))])
            ;; A too-short array cannot admit a vector gang. Avoid exposing the
            ;; wrapped subtraction as a large positive bound.
            (lower-vector-loop-select
              s
              offset-valid
              candidate
              (CompilerIrValue.I64 -1))))
        (LowerExpr.Expr len-state array-len (AstType.I64)))]))

(define (lower-vector-loop-limit
  [state : LowerState]
  [end-value : CompilerIrValue]
  [arrays : LowerArrayVarSet]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc alloc-state end-var)
      (let
        [s : LowerState
          (lower-state-emit
            alloc-state
            (CompilerIrInstr.Mov end-var end-value (AstType.I64)))]
        [limit : CompilerIrValue CompilerIrValue.Unit]
        [index : i64 0]
        [count : i64 (struct-get arrays count)]
        (begin
          ;; Materialize the end bound before comparing it: direct literal
          ;; endpoints do not retain their width through scalar min selection.
          ;;
          ;; Besides bounding the first gang, this clamp ensures the next
          ;; header's index + lanes calculation cannot overflow after a
          ;; successful gang.
          (match (lower-vector-loop-min
            s
            (CompilerIrValue.Var end-var)
            (CompilerIrValue.I64 (- 9223372036854775807 lanes)))
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! limit value))])
          (while (< index count)
            (begin
              (match (lower-vector-loop-array-limit
                s
                (array-ref (struct-get arrays vars) index)
                (array-ref (struct-get arrays offsets) index))
                [(LowerExpr.Expr array-state array-limit _)
                  (match (lower-vector-loop-min array-state limit array-limit)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! limit value))])])
              (set! index (+ index 1))))
          (LowerExpr.Expr s limit (AstType.I64))))]))

(define (lower-vector-loop-next-ok
  [state : LowerState]
  [next-index : CompilerIrValue]
  [limit : CompilerIrValue]) : LowerExpr
  (lower-vector-loop-i64-compare state (CompilerIrBinOp.Le) next-index limit))

(define (lower-emit-vector-reduce
  [state : LowerState]
  [op : CompilerIrVectorReduceOp]
  [src : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (CompilerIrInstr.VectorReduce v op src lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-spmd-reduce-apply-update
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [acc-var : i64]
  [elem-ty : AstType]
  [value-var : i64]) : ResultLowerExpr
  (let
    [acc-name-id : i64 (lower-spmd-reduce-acc-id)]
    [current-name-id : i64 (lower-spmd-reduce-current-id)]
    [pools : AstNodePoolContext (tc-context-pools ctx)]
    (lower-expr
      ctx
      state
      (sym_i64_env.sym-i64-bind-id
        (sym_i64_env.sym-i64-bind-id env acc-name-id acc-var)
        current-name-id
        value-var)
      (tc-bind-id
        (tc-bind-id type-env acc-name-id elem-ty)
        current-name-id
        elem-ty)
      (lower-context-expr-get
        ctx
        (spmd-reduce-acc-update-expr
          pools
          op
          (ast-node-pool-context-expr-push pools (AstExpr.Var current-name-id)))))))

(define (lower-spmd-reduce-vector-accumulator? [elem-ty : AstType]) : bool
  (match elem-ty
    [(AstType.I32) true]
    [(AstType.I64) true]
    [_ false]))

(define (lower-spmd-reduce-vector-accumulator-init
  [op : AstReduceOp]
  [acc-var : i64]) : CompilerIrValue
  (match op
    [(AstReduceOp.Sum) (CompilerIrValue.I64 0)]
    ;; Min/max are idempotent, so seeding every lane from the scalar init
    ;; preserves seeded and empty-range semantics without signed-extreme
    ;; constants. The post-loop horizontal result already includes the seed.
    [_ (CompilerIrValue.Var acc-var)]))

(define (lower-spmd-reduce-vector-accumulate
  [state : LowerState]
  [vector-op : CompilerIrVectorReduceOp]
  [vector-acc-var : i64]
  [value : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerState
  (match vector-op
    [(CompilerIrVectorReduceOp.Sum)
      (lower-state-emit
        state
        (ir-instr-vector-bin-op
          vector-acc-var
          CompilerIrBinOp.Add
          (CompilerIrValue.Var vector-acc-var)
          value
          lanes
          elem-ty))]
    [_
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc compare-alloc mask-var)
          (let
            [compare-op : CompilerIrBinOp
              (match vector-op
                [(CompilerIrVectorReduceOp.Min) CompilerIrBinOp.Lt]
                [_ CompilerIrBinOp.Gt])]
            (lower-state-emit
              (lower-state-emit
                compare-alloc
                (ir-instr-vector-compare
                  mask-var
                  compare-op
                  value
                  (CompilerIrValue.Var vector-acc-var)
                  lanes
                  elem-ty))
              (ir-instr-select
                vector-acc-var
                (CompilerIrValue.Var mask-var)
                value
                (CompilerIrValue.Var vector-acc-var)
                lanes
                elem-ty)))])]))

(define (lower-spmd-reduce-finish-vector-accumulator
  [state : LowerState]
  [op : AstReduceOp]
  [acc-var : i64]
  [vector-acc-var : i64]
  [vector-op : CompilerIrVectorReduceOp]
  [lanes : i64]
  [elem-ty : AstType]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc reduce-alloc reduced-var)
      (let
        [reduced-state : LowerState
          (lower-state-emit
            reduce-alloc
            (CompilerIrInstr.VectorReduce
              reduced-var
              vector-op
              (CompilerIrValue.Var vector-acc-var)
              lanes
              elem-ty))]
        (match op
          [(AstReduceOp.Sum)
            (match (lower-state-alloc-var reduced-state)
              [(LowerAlloc.Alloc update-alloc updated-var)
                (lower-state-emit
                  (lower-state-emit
                    update-alloc
                    (CompilerIrInstr.BinOp
                      updated-var
                      CompilerIrBinOp.Add
                      (CompilerIrValue.Var acc-var)
                      (CompilerIrValue.Var reduced-var)
                      elem-ty))
                  (CompilerIrInstr.Mov
                    acc-var
                    (CompilerIrValue.Var updated-var)
                    elem-ty))])]
          ;; Every min/max lane was initialized with acc-var, so the horizontal
          ;; result already contains the scalar seed.
          [_
            (lower-state-emit
              reduced-state
              (CompilerIrInstr.Mov
                acc-var
                (CompilerIrValue.Var reduced-var)
                elem-ty))]))]))

(define (lower-avx2-reduce-vector-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [acc-var : i64]
  [vector-acc-var : i64]
  [data-ptr : CompilerIrValue]
  [vector-op : CompilerIrVectorReduceOp]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-vector-load-data
    state
    data-ptr
    (CompilerIrValue.Var index-var)
    lanes
    elem-ty)
    [(LowerExpr.Expr load-state chunk-vec _)
      (if (lower-spmd-reduce-vector-accumulator? elem-ty)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit
              (lower-spmd-reduce-vector-accumulate
                load-state
                vector-op
                vector-acc-var
                chunk-vec
                lanes
                elem-ty)
              (CompilerIrInstr.Mov index-var next-index (AstType.I64)))
            CompilerIrValue.Unit
            (AstType.Unit)))
        (match (lower-emit-vector-reduce
          load-state
          vector-op
          chunk-vec
          lanes
          elem-ty)
          [(LowerExpr.Expr reduce-state reduced _)
            (match reduced
              [(CompilerIrValue.Var reduced-var)
                (match (lower-spmd-reduce-apply-update
                  ctx
                  reduce-state
                  env
                  type-env
                  op
                  acc-var
                  elem-ty
                  reduced-var)
                  [(ResultLowerExpr.Ok update-lowered)
                    (match update-lowered
                      [(LowerExpr.Expr update-state _ _)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-state-emit
                              update-state
                              (CompilerIrInstr.Mov
                                index-var
                                next-index
                                (AstType.I64)))
                            CompilerIrValue.Unit
                            (AstType.Unit)))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
              [_
                (ResultLowerExpr.Err
                  (box (lower-diagnostic "lower: invalid vector reduce result")))])]))]))

(define (lower-avx2-reduce-vector-value-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [acc-var : i64]
  [vector-acc-var : i64]
  [value-plan : LowerVectorMapValue]
  [preheader-cache : LowerVectorMapValueCache]
  [vector-op : CompilerIrVectorReduceOp]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-vector-map-value-cached
    ctx
    state
    index-var
    lanes
    elem-ty
    value-plan
    (LowerVectorMapEmitMode.Full)
    preheader-cache)
    [(LowerVectorMapCachedEmit.Emit value-state chunk-vec _)
      (if (lower-spmd-reduce-vector-accumulator? elem-ty)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit
              (lower-spmd-reduce-vector-accumulate
                value-state
                vector-op
                vector-acc-var
                chunk-vec
                lanes
                elem-ty)
              (CompilerIrInstr.Mov index-var next-index (AstType.I64)))
            CompilerIrValue.Unit
            (AstType.Unit)))
        (match (lower-emit-vector-reduce
          value-state
          vector-op
          chunk-vec
          lanes
          elem-ty)
          [(LowerExpr.Expr reduce-state reduced _)
            (match reduced
              [(CompilerIrValue.Var reduced-var)
                (match (lower-spmd-reduce-apply-update
                  ctx
                  reduce-state
                  env
                  type-env
                  op
                  acc-var
                  elem-ty
                  reduced-var)
                  [(ResultLowerExpr.Ok update-lowered)
                    (match update-lowered
                      [(LowerExpr.Expr update-state _ _)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-state-emit
                              update-state
                              (CompilerIrInstr.Mov
                                index-var
                                next-index
                                (AstType.I64)))
                            CompilerIrValue.Unit
                            (AstType.Unit)))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
              [_
                (ResultLowerExpr.Err
                  (box (lower-diagnostic "lower: invalid vector reduce result")))])]))]))

(define (lower-spmd-reduce-scalar-tail-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-var : i64]
  [index-ty : AstType]
  [acc-var : i64]
  [array-var : i64]
  [elem-ty : AstType]) : ResultLowerExpr
  (match (lower-array-element-addr
    ctx
    state
    (CompilerIrValue.Var array-var)
    (CompilerIrValue.Var index-var)
    index-ty
    elem-ty)
    [(LowerExpr.Expr addr-state elem-ptr _)
      (match (lower-emit-load addr-state elem-ptr elem-ty)
        [(LowerExpr.Expr load-state loaded _)
          (match loaded
            [(CompilerIrValue.Var loaded-var)
              (match (lower-spmd-reduce-apply-update
                ctx
                load-state
                env
                type-env
                op
                acc-var
                elem-ty
                loaded-var)
                [(ResultLowerExpr.Ok update-lowered)
                  (match update-lowered
                    [(LowerExpr.Expr update-state _ _)
                      (match (lower-state-alloc-var update-state)
                        [(LowerAlloc.Alloc inc-alloc inc-var)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (lower-state-emit
                                (lower-state-emit
                                  inc-alloc
                                  (CompilerIrInstr.BinOp
                                    inc-var
                                    CompilerIrBinOp.Add
                                    (CompilerIrValue.Var index-var)
                                    (CompilerIrValue.I64 1)
                                    index-ty))
                                (CompilerIrInstr.Mov
                                  index-var
                                  (CompilerIrValue.Var inc-var)
                                  index-ty))
                              CompilerIrValue.Unit
                              (AstType.Unit)))])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
            [_
              (ResultLowerExpr.Err
                (box (lower-diagnostic "lower: invalid scalar reduce load")))])])]))

(define (lower-spmd-reduce-scalar-tail-value-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [base-index-var : i64]
  [current-index-var : i64]
  [active-lanes : CompilerIrValue]
  [index-ty : AstType]
  [acc-var : i64]
  [value-plan : LowerVectorMapValue]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-scalar-vector-map-value
    ctx
    state
    base-index-var
    current-index-var
    (CompilerIrValue.I64 0)
    active-lanes
    lanes
    elem-ty
    value-plan)
    [(LowerExpr.Expr value-state scalar-value _)
      (let
        [s : LowerState value-state]
        [value-var : i64 0]
        (begin
          (match scalar-value
            [(CompilerIrValue.Var var) (set! value-var var)]
            [_
              (match (lower-state-alloc-var s)
                [(LowerAlloc.Alloc alloc-state tmp-var)
                  (begin
                    (set!
                      s
                      (lower-state-emit
                        alloc-state
                        (CompilerIrInstr.Mov tmp-var scalar-value elem-ty)))
                    (set! value-var tmp-var))])])
          (match (lower-spmd-reduce-apply-update
            ctx
            s
            env
            type-env
            op
            acc-var
            elem-ty
            value-var)
            [(ResultLowerExpr.Ok update-lowered)
              (match update-lowered
                [(LowerExpr.Expr update-state _ _)
                  (match (lower-state-alloc-var update-state)
                    [(LowerAlloc.Alloc inc-alloc inc-var)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-state-emit
                            (lower-state-emit
                              inc-alloc
                              (CompilerIrInstr.BinOp
                                inc-var
                                CompilerIrBinOp.Add
                                (CompilerIrValue.Var current-index-var)
                                (CompilerIrValue.I64 1)
                                index-ty))
                            (CompilerIrInstr.Mov
                              current-index-var
                              (CompilerIrValue.Var inc-var)
                              index-ty))
                          CompilerIrValue.Unit
                          (AstType.Unit)))])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))]))

(define (lower-spmd-scan-vector-body
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [acc-var : i64]
  [input-var : i64]
  [output-var : i64]
  [prefix-op : CompilerIrVectorPrefixOp]
  [elem-ty : AstType]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [chunk : CompilerIrValue CompilerIrValue.Unit]
    [full-mask : CompilerIrValue CompilerIrValue.Unit]
    [prefix-value : CompilerIrValue CompilerIrValue.Unit]
    [last-index : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (if (lower-type-bool? elem-ty)
        (begin
          (match (lower-emit-tail-mask
            s
            (CompilerIrValue.Var index-var)
            next-index
            lanes)
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! full-mask value))])
          (match (lower-emit-predicated-load
            s
            (CompilerIrValue.Var input-var)
            (CompilerIrValue.Var index-var)
            full-mask
            lanes
            elem-ty)
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! chunk value))]))
        (match (lower-emit-vector-load
          s
          (CompilerIrValue.Var input-var)
          (CompilerIrValue.Var index-var)
          lanes
          elem-ty)
          [(LowerExpr.Expr next-s value _)
            (begin
              (set! s next-s)
              (set! chunk value))]))
      (match (lower-state-alloc-var s)
        [(LowerAlloc.Alloc next-s prefix-var)
          (begin
            (set!
              s
              (lower-state-emit
                next-s
                (ir-instr-vector-prefix
                  prefix-var
                  prefix-op
                  chunk
                  (CompilerIrValue.Var acc-var)
                  lanes
                  elem-ty)))
            (set! prefix-value (CompilerIrValue.Var prefix-var)))])
      (if (lower-type-bool? elem-ty)
        (set!
          s
          (lower-emit-predicated-store
            s
            (CompilerIrValue.Var output-var)
            (CompilerIrValue.Var index-var)
            prefix-value
            full-mask
            lanes
            elem-ty))
        (set!
          s
          (lower-emit-vector-store
            s
            (CompilerIrValue.Var output-var)
            (CompilerIrValue.Var index-var)
            prefix-value
            lanes
            elem-ty)))
      (match (lower-emit-binop
        s
        CompilerIrBinOp.Sub
        next-index
        (CompilerIrValue.I64 1)
        (AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! last-index value))])
      ;; `vector-limit` already proves the whole output gang is in bounds.
      ;; Reload the stored final lane through its raw data pointer so carry
      ;; handoff does not add a redundant scalar bounds-check block.
      (match (lower-array-data-pointer-value s (CompilerIrValue.Var output-var))
        [(LowerExpr.Expr data-state data-ptr _)
          (match (lower-emit-elem-addr-gep
            ctx
            data-state
            data-ptr
            last-index
            elem-ty)
            [(LowerExpr.Expr addr-state last-addr _)
              (match (lower-emit-load addr-state last-addr elem-ty)
                [(LowerExpr.Expr load-state last-value _)
                  (set!
                    s
                    (lower-state-emit
                      load-state
                      (CompilerIrInstr.Mov acc-var last-value elem-ty)))])])])
      (LowerExpr.Expr
        (lower-state-emit
          s
          (CompilerIrInstr.Mov index-var next-index (AstType.I64)))
        CompilerIrValue.Unit
        (AstType.Unit)))))

(define (lower-spmd-scan-scalar-tail-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-id : i64]
  [index-var : i64]
  [index-ty : AstType]
  [prefix-id : i64]
  [acc-var : i64]
  [elem-ty : AstType]
  [value : AstExpr]
  [body : AstExpr]) : ResultLowerExpr
  (let
    [index-env : sym_i64_env.SymI64Env
      (sym_i64_env.sym-i64-bind-id env index-id index-var)]
    [index-type-env : TcTypeEnv (tc-bind-id type-env index-id index-ty)]
    [body-env : sym_i64_env.SymI64Env
      (sym_i64_env.sym-i64-bind-id index-env prefix-id acc-var)]
    [body-type-env : TcTypeEnv (tc-bind-id index-type-env prefix-id elem-ty)]
    (match (lower-expr-expected
      ctx
      state
      index-env
      index-type-env
      value
      elem-ty
      value)
      [(ResultLowerExpr.Ok value-lowered)
        (match value-lowered
          [(LowerExpr.Expr value-state value-ir _)
            (let
              [s : LowerState value-state]
              [value-var : i64 0]
              (begin
                (match value-ir
                  [(CompilerIrValue.Var var) (set! value-var var)]
                  [_
                    (match (lower-state-alloc-var s)
                      [(LowerAlloc.Alloc alloc-state var)
                        (begin
                          (set! value-var var)
                          (set!
                            s
                            (lower-state-emit
                              alloc-state
                              (CompilerIrInstr.Mov var value-ir elem-ty))))])])
                (match (lower-spmd-reduce-apply-update
                  ctx
                  s
                  index-env
                  index-type-env
                  op
                  acc-var
                  elem-ty
                  value-var)
                  [(ResultLowerExpr.Ok update-lowered)
                    (match update-lowered
                      [(LowerExpr.Expr update-state _ _)
                        (match (lower-expr
                          ctx
                          update-state
                          body-env
                          body-type-env
                          body)
                          [(ResultLowerExpr.Ok body-lowered)
                            (match body-lowered
                              [(LowerExpr.Expr body-state _ _)
                                (match (lower-state-alloc-var body-state)
                                  [(LowerAlloc.Alloc inc-state inc-var)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr
                                        (lower-state-emit
                                          (lower-state-emit
                                            inc-state
                                            (CompilerIrInstr.BinOp
                                              inc-var
                                              CompilerIrBinOp.Add
                                              (CompilerIrValue.Var index-var)
                                              (CompilerIrValue.I64 1)
                                              index-ty))
                                          (CompilerIrInstr.Mov
                                            index-var
                                            (CompilerIrValue.Var inc-var)
                                            index-ty))
                                        CompilerIrValue.Unit
                                        (AstType.Unit)))])])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-spmd-scan-vector-label [state : LowerState] [suffix : String]) : String
  (str_cat.str-cat
    "spmd_scan_"
    (if (lower-mode-avx512? (lower-state-mode state))
      "avx512_"
      "avx2_")
    suffix))

(define (lower-simd-spmd-scan-build
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-id : i64]
  [index-ty : AstType]
  [init-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [start-value : CompilerIrValue]
  [prefix-id : i64]
  [value : AstExpr]
  [body : AstExpr]
  [input-var : i64]
  [output-var : i64]
  [prefix-op : CompilerIrVectorPrefixOp]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc acc-state acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-state
          (CompilerIrInstr.Mov acc-var init-value elem-ty)))
        [(LowerAlloc.Alloc index-state index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-state
                (CompilerIrInstr.Mov index-var start-value index-ty))]
            [header-label : String ""]
            [body-label : String ""]
            [tail-header-label : String ""]
            [tail-body-label : String ""]
            [exit-label : String ""]
            [arrays : LowerArrayVarSet
              (lower-array-var-set-add
                (lower-array-var-set-add
                  (lower-array-var-set-empty)
                  input-var
                  0)
                output-var
                0)]
            [vector-limit : CompilerIrValue CompilerIrValue.Unit]
            [vector-start-ok : CompilerIrValue CompilerIrValue.Unit]
            [next-index : CompilerIrValue CompilerIrValue.Unit]
            [vector-ok : CompilerIrValue CompilerIrValue.Unit]
            [tail-cond : CompilerIrValue CompilerIrValue.Unit]
            (begin
              (match (lower-state-fresh-label
                s
                (lower-spmd-scan-vector-label s "header"))
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label
                s
                (lower-spmd-scan-vector-label s "body"))
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "spmd_scan_tail_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (match (lower-state-fresh-label s "spmd_scan_tail_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "spmd_scan_exit")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (match (lower-vector-loop-limit s end-value arrays lanes)
                [(LowerExpr.Expr next-s limit _)
                  (begin
                    (set! s next-s)
                    (set! vector-limit limit))])
              (match (lower-vector-loop-start-ok s index-var lanes)
                [(LowerExpr.Expr next-s ok _)
                  (begin
                    (set! s next-s)
                    (set! vector-start-ok ok))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      vector-start-ok
                      header-label
                      tail-header-label))
                  header-label))
              (match (lower-emit-binop
                s
                CompilerIrBinOp.Add
                (CompilerIrValue.Var index-var)
                (CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr.Expr next-s value-ir _)
                  (begin
                    (set! s next-s)
                    (set! next-index value-ir))])
              (match (lower-vector-loop-next-ok s next-index vector-limit)
                [(LowerExpr.Expr next-s ok _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok ok))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      vector-ok
                      body-label
                      tail-header-label))
                  body-label))
              (match (lower-spmd-scan-vector-body
                ctx
                s
                index-var
                next-index
                acc-var
                input-var
                output-var
                prefix-op
                elem-ty
                lanes)
                [(LowerExpr.Expr body-state _ _)
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        body-state
                        (CompilerIrInstr.Jump header-label))
                      tail-header-label))])
              (match (lower-vector-loop-i64-compare
                s
                CompilerIrBinOp.Lt
                (CompilerIrValue.Var index-var)
                end-value)
                [(LowerExpr.Expr next-s condition _)
                  (begin
                    (set! s next-s)
                    (set! tail-cond condition))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      tail-cond
                      tail-body-label
                      exit-label))
                  tail-body-label))
              (match (lower-spmd-scan-scalar-tail-body
                ctx
                s
                env
                type-env
                op
                index-id
                index-var
                index-ty
                prefix-id
                acc-var
                elem-ty
                value
                body)
                [(ResultLowerExpr.Ok tail-lowered)
                  (match tail-lowered
                    [(LowerExpr.Expr tail-state _ _)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-state-finish-block
                            (lower-state-emit
                              tail-state
                              (CompilerIrInstr.Jump tail-header-label))
                            exit-label)
                          CompilerIrValue.Unit
                          (AstType.Unit)))])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))])]))

(define (lower-simd-spmd-scan-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-id : i64]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [prefix-id : i64]
  [prefix-ty : AstType]
  [init : AstExpr]
  [value : AstExpr]
  [body : AstExpr]
  [plan : LowerMaybeVectorScan]) : ResultLowerExpr
  (match plan
    [(LowerMaybeVectorScan.Scan input-var output-var prefix-op elem-ty lanes)
      (match (lower-expr-expected ctx state env type-env init prefix-ty init)
        [(ResultLowerExpr.Ok init-lowered)
          (match init-lowered
            [(LowerExpr.Expr init-state init-value _)
              (match (lower-expr ctx init-state env type-env end)
                [(ResultLowerExpr.Ok end-lowered)
                  (match end-lowered
                    [(LowerExpr.Expr end-state end-value _)
                      (match (lower-expr ctx end-state env type-env start)
                        [(ResultLowerExpr.Ok start-lowered)
                          (match start-lowered
                            [(LowerExpr.Expr start-state start-value _)
                              (lower-simd-spmd-scan-build
                                ctx
                                start-state
                                env
                                type-env
                                op
                                index-id
                                index-ty
                                init-value
                                end-value
                                start-value
                                prefix-id
                                value
                                body
                                input-var
                                output-var
                                prefix-op
                                elem-ty
                                lanes)])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(LowerMaybeVectorScan.No)
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: missing vector scan plan")))]))

(define (lower-avx2-spmd-reduce-build
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-ty : AstType]
  [init-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [start-value : CompilerIrValue]
  [op : AstReduceOp]
  [array-var : i64]
  [vector-op : CompilerIrVectorReduceOp]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc acc-alloc acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-alloc
          (CompilerIrInstr.Mov acc-var init-value elem-ty)))
        [(LowerAlloc.Alloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov index-var start-value index-ty))]
            [header-label : String ""]
            [body-label : String ""]
            [tail-init-label : String ""]
            [tail-header-label : String ""]
            [tail-body-label : String ""]
            [exit-label : String ""]
            [arrays : LowerArrayVarSet
              (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
            [vector-limit : CompilerIrValue CompilerIrValue.Unit]
            [vector-start-ok : CompilerIrValue CompilerIrValue.Unit]
            [next-index : CompilerIrValue CompilerIrValue.Unit]
            [vector-ok : CompilerIrValue CompilerIrValue.Unit]
            [tail-cond : CompilerIrValue CompilerIrValue.Unit]
            [vector-acc-var : i64 0]
            [data-ptr : CompilerIrValue CompilerIrValue.Unit]
            (begin
              (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                (match (lower-state-alloc-var s)
                  [(LowerAlloc.Alloc next-s var)
                    (begin
                      (set! vector-acc-var var)
                      (set!
                        s
                        (lower-state-emit
                          next-s
                          (CompilerIrInstr.Splat
                            vector-acc-var
                            (lower-spmd-reduce-vector-accumulator-init
                              op
                              acc-var)
                            lanes
                            elem-ty))))])
                unit)
              (match (lower-state-fresh-label s "spmd_reduce_avx2_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_avx2_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_tail_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                (match (lower-state-fresh-label s "spmd_reduce_tail_init")
                  [(LowerLabel.Label next-s label)
                    (begin
                      (set! s next-s)
                      (set! tail-init-label label))])
                unit)
              (match (lower-state-fresh-label s "spmd_reduce_tail_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_exit")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (match (lower-vector-loop-limit s end-value arrays lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-limit value))])
              (match (lower-vector-loop-start-ok s index-var lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-start-ok value))])
              (match (lower-array-data-pointer-value
                s
                (CompilerIrValue.Var array-var))
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! data-ptr value))])
              (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (CompilerIrInstr.Branch
                        vector-start-ok
                        header-label
                        tail-init-label))
                    header-label))
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (CompilerIrInstr.Branch
                        vector-start-ok
                        header-label
                        tail-header-label))
                    header-label)))
              (match (lower-emit-binop
                s
                (CompilerIrBinOp.Add)
                (CompilerIrValue.Var index-var)
                (CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! next-index value))])
              (match (lower-vector-loop-next-ok s next-index vector-limit)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok value))])
              (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (CompilerIrInstr.Branch
                        vector-ok
                        body-label
                        tail-init-label))
                    body-label))
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (CompilerIrInstr.Branch
                        vector-ok
                        body-label
                        tail-header-label))
                    body-label)))
              (match (lower-avx2-reduce-vector-body
                ctx
                s
                env
                type-env
                op
                index-var
                next-index
                acc-var
                vector-acc-var
                data-ptr
                vector-op
                elem-ty
                lanes)
                [(ResultLowerExpr.Ok body-lowered)
                  (match body-lowered
                    [(LowerExpr.Expr body-state _ _)
                      (begin
                        (set! s body-state)
                        (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                          (set!
                            s
                            (lower-state-finish-block
                              (lower-state-emit
                                s
                                (CompilerIrInstr.Jump header-label))
                              tail-init-label))
                          (set!
                            s
                            (lower-state-finish-block
                              (lower-state-emit
                                s
                                (CompilerIrInstr.Jump header-label))
                              tail-header-label)))
                        (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                          (begin
                            (set!
                              s
                              (lower-spmd-reduce-finish-vector-accumulator
                                s
                                op
                                acc-var
                                vector-acc-var
                                vector-op
                                lanes
                                elem-ty))
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (CompilerIrInstr.Jump tail-header-label))
                                tail-header-label)))
                          unit)
                        (match (lower-vector-loop-i64-compare
                          s
                          (CompilerIrBinOp.Lt)
                          (CompilerIrValue.Var index-var)
                          end-value)
                          [(LowerExpr.Expr next-s value _)
                            (begin
                              (set! s next-s)
                              (set! tail-cond value))])
                        (set!
                          s
                          (lower-state-finish-block
                            (lower-state-emit
                              s
                              (CompilerIrInstr.Branch
                                tail-cond
                                tail-body-label
                                exit-label))
                            tail-body-label))
                        (match (lower-spmd-reduce-scalar-tail-body
                          ctx
                          s
                          env
                          type-env
                          op
                          index-var
                          index-ty
                          acc-var
                          array-var
                          elem-ty)
                          [(ResultLowerExpr.Ok tail-lowered)
                            (match tail-lowered
                              [(LowerExpr.Expr tail-state _ _)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        tail-state
                                        (CompilerIrInstr.Jump tail-header-label))
                                      exit-label)
                                    (CompilerIrValue.Var acc-var)
                                    elem-ty))])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)]))])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))])]))

(define (lower-avx2-spmd-reduce-value-build
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-ty : AstType]
  [init-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [start-value : CompilerIrValue]
  [op : AstReduceOp]
  [value-plan : LowerVectorMapValue]
  [vector-op : CompilerIrVectorReduceOp]
  [elem-ty : AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc acc-alloc acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-alloc
          (CompilerIrInstr.Mov acc-var init-value elem-ty)))
        [(LowerAlloc.Alloc index-alloc index-var)
          (match (lower-state-alloc-var
            (lower-state-emit
              index-alloc
              (CompilerIrInstr.Mov index-var start-value index-ty)))
            [(LowerAlloc.Alloc base-alloc tail-base-var)
              (let
                [s : LowerState base-alloc]
                [header-label : String ""]
                [body-label : String ""]
                [tail-init-label : String ""]
                [tail-check-label : String ""]
                [tail-body-label : String ""]
                [exit-label : String ""]
                [arrays : LowerArrayVarSet
                  (lower-vector-map-value-array-vars value-plan)]
                [vector-limit : CompilerIrValue CompilerIrValue.Unit]
                [vector-start-ok : CompilerIrValue CompilerIrValue.Unit]
                [next-index : CompilerIrValue CompilerIrValue.Unit]
                [vector-ok : CompilerIrValue CompilerIrValue.Unit]
                [active-lanes : CompilerIrValue CompilerIrValue.Unit]
                [tail-cond : CompilerIrValue CompilerIrValue.Unit]
                [vector-acc-var : i64 0]
                [preheader-cache : LowerVectorMapValueCache
                  (lower-vector-map-value-cache-empty)]
                (begin
                  (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                    (match (lower-state-alloc-var s)
                      [(LowerAlloc.Alloc next-s var)
                        (begin
                          (set! vector-acc-var var)
                          (set!
                            s
                            (lower-state-emit
                              next-s
                              (CompilerIrInstr.Splat
                                vector-acc-var
                                (lower-spmd-reduce-vector-accumulator-init
                                  op
                                  acc-var)
                                lanes
                                elem-ty))))])
                    unit)
                  (match (lower-state-fresh-label s "spmd_reduce_value_header")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! header-label label))])
                  (match (lower-state-fresh-label s "spmd_reduce_value_body")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! body-label label))])
                  (match (lower-state-fresh-label
                    s
                    "spmd_reduce_value_tail_init")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! tail-init-label label))])
                  (match (lower-state-fresh-label
                    s
                    "spmd_reduce_value_tail_check")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! tail-check-label label))])
                  (match (lower-state-fresh-label
                    s
                    "spmd_reduce_value_tail_body")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! tail-body-label label))])
                  (match (lower-state-fresh-label s "spmd_reduce_value_exit")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! exit-label label))])
                  (match (lower-vector-loop-limit s end-value arrays lanes)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! vector-limit value))])
                  (match (lower-vector-loop-start-ok s index-var lanes)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! vector-start-ok value))])
                  (match (lower-vector-map-preheader-cache-plan
                    s
                    arrays
                    lanes
                    elem-ty
                    value-plan)
                    [(LowerVectorMapCachedEmit.Emit next-s _ next-cache)
                      (begin
                        (set! s next-s)
                        (set! preheader-cache next-cache))])
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (CompilerIrInstr.Branch
                          vector-start-ok
                          header-label
                          tail-init-label))
                      header-label))
                  (match (lower-emit-binop
                    s
                    (CompilerIrBinOp.Add)
                    (CompilerIrValue.Var index-var)
                    (CompilerIrValue.I64 lanes)
                    index-ty)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! next-index value))])
                  (match (lower-vector-loop-next-ok s next-index vector-limit)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! vector-ok value))])
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (CompilerIrInstr.Branch
                          vector-ok
                          body-label
                          tail-init-label))
                      body-label))
                  (match (lower-avx2-reduce-vector-value-body
                    ctx
                    s
                    env
                    type-env
                    op
                    index-var
                    next-index
                    acc-var
                    vector-acc-var
                    value-plan
                    preheader-cache
                    vector-op
                    elem-ty
                    lanes)
                    [(ResultLowerExpr.Ok body-lowered)
                      (match body-lowered
                        [(LowerExpr.Expr body-state _ _)
                          (begin
                            (set! s body-state)
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (CompilerIrInstr.Jump header-label))
                                tail-init-label))
                            (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                              (set!
                                s
                                (lower-spmd-reduce-finish-vector-accumulator
                                  s
                                  op
                                  acc-var
                                  vector-acc-var
                                  vector-op
                                  lanes
                                  elem-ty))
                              unit)
                            (set!
                              s
                              (lower-state-emit
                                s
                                (CompilerIrInstr.Mov
                                  tail-base-var
                                  (CompilerIrValue.Var index-var)
                                  index-ty)))
                            (match (lower-emit-binop
                              s
                              CompilerIrBinOp.Sub
                              end-value
                              (CompilerIrValue.Var index-var)
                              (AstType.I64))
                              [(LowerExpr.Expr next-s value _)
                                (begin
                                  (set! s next-s)
                                  (set! active-lanes value))])
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (CompilerIrInstr.Jump tail-check-label))
                                tail-check-label))
                            (match (lower-vector-loop-i64-compare
                              s
                              (CompilerIrBinOp.Lt)
                              (CompilerIrValue.Var index-var)
                              end-value)
                              [(LowerExpr.Expr next-s value _)
                                (begin
                                  (set! s next-s)
                                  (set! tail-cond value))])
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (CompilerIrInstr.Branch
                                    tail-cond
                                    tail-body-label
                                    exit-label))
                                tail-body-label))
                            (match (lower-spmd-reduce-scalar-tail-value-body
                              ctx
                              s
                              env
                              type-env
                              op
                              tail-base-var
                              index-var
                              active-lanes
                              index-ty
                              acc-var
                              value-plan
                              elem-ty
                              lanes)
                              [(ResultLowerExpr.Ok tail-lowered)
                                (match tail-lowered
                                  [(LowerExpr.Expr tail-state _ _)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr
                                        (lower-state-finish-block
                                          (lower-state-emit
                                            tail-state
                                            (CompilerIrInstr.Jump
                                              tail-check-label))
                                          exit-label)
                                        (CompilerIrValue.Var acc-var)
                                        elem-ty))])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)]))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])))])])]))

(define (lower-avx2-spmd-reduce-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [init : AstExpr]
  [op : AstReduceOp]
  [plan : LowerMaybeVectorReduce]) : ResultLowerExpr
  (match plan
    [(LowerMaybeVectorReduce.Array array-var vector-op elem-ty lanes)
      (match (lower-expr-expected ctx state env type-env init elem-ty init)
        [(ResultLowerExpr.Ok init-lowered)
          (match init-lowered
            [(LowerExpr.Expr init-state init-value _)
              (match (lower-expr ctx init-state env type-env end)
                [(ResultLowerExpr.Ok end-lowered)
                  (match end-lowered
                    [(LowerExpr.Expr end-state end-value _)
                      (match (lower-expr ctx end-state env type-env start)
                        [(ResultLowerExpr.Ok start-lowered)
                          (match start-lowered
                            [(LowerExpr.Expr start-state start-value _)
                              (lower-avx2-spmd-reduce-build
                                ctx
                                start-state
                                env
                                type-env
                                index-ty
                                init-value
                                end-value
                                start-value
                                op
                                array-var
                                vector-op
                                elem-ty
                                lanes)])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(LowerMaybeVectorReduce.Value value-plan vector-op elem-ty lanes)
      (match (lower-expr-expected ctx state env type-env init elem-ty init)
        [(ResultLowerExpr.Ok init-lowered)
          (match init-lowered
            [(LowerExpr.Expr init-state init-value _)
              (match (lower-expr ctx init-state env type-env end)
                [(ResultLowerExpr.Ok end-lowered)
                  (match end-lowered
                    [(LowerExpr.Expr end-state end-value _)
                      (match (lower-expr ctx end-state env type-env start)
                        [(ResultLowerExpr.Ok start-lowered)
                          (match start-lowered
                            [(LowerExpr.Expr start-state start-value _)
                              (lower-avx2-spmd-reduce-value-build
                                ctx
                                start-state
                                env
                                type-env
                                index-ty
                                init-value
                                end-value
                                start-value
                                op
                                value-plan
                                vector-op
                                elem-ty
                                lanes)])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(LowerMaybeVectorReduce.No)
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: missing vector reduce plan")))]))

(define (lower-emit-tail-mask
  [state : LowerState]
  [index : CompilerIrValue]
  [end-value : CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.TailMask v index end-value lanes))
        (CompilerIrValue.Var v)
        (AstType.Bool))]))

(define (lower-emit-predicated-load
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [mask : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr.Expr data-state data-ptr _)
      (lower-emit-predicated-load-data
        data-state
        data-ptr
        index
        mask
        lanes
        elem-ty)]))

(define (lower-emit-predicated-load-data
  [state : LowerState]
  [data-ptr : CompilerIrValue]
  [index : CompilerIrValue]
  [mask : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir-instr-predicated-load v data-ptr index mask lanes elem-ty))
        (CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-predicated-store
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [value : CompilerIrValue]
  [mask : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerState
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr.Expr data-state data-ptr _)
      (lower-emit-predicated-store-data
        data-state
        data-ptr
        index
        value
        mask
        lanes
        elem-ty)]))

(define (lower-emit-predicated-store-data
  [state : LowerState]
  [data-ptr : CompilerIrValue]
  [index : CompilerIrValue]
  [value : CompilerIrValue]
  [mask : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerState
  (lower-state-emit
    state
    (ir-instr-predicated-store data-ptr index value mask lanes elem-ty)))

(define (lower-emit-spmd-broadcast-lane-check
  [state : LowerState]
  [lane : CompilerIrValue]
  [active-lanes : CompilerIrValue]) : LowerState
  (match (lower-emit-cast state lane (AstType.I64) (AstType.U64))
    [(LowerExpr.Expr lane-state lane-u _)
      (match (lower-emit-cast
        lane-state
        active-lanes
        (AstType.I64)
        (AstType.U64))
        [(LowerExpr.Expr count-state count-u _)
          (lower-emit-bounds-check count-state lane-u count-u)])]))

(define (lower-emit-spmd-broadcast-array
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [array-var : i64]
  [lane : CompilerIrValue]
  [active-lanes : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-emit-binop
    (lower-emit-spmd-broadcast-lane-check state lane active-lanes)
    CompilerIrBinOp.Add
    (CompilerIrValue.Var index-var)
    lane
    (AstType.I64))
    [(LowerExpr.Expr index-state source-index _)
      (match (lower-array-element-addr
        ctx
        index-state
        (CompilerIrValue.Var array-var)
        source-index
        (AstType.I64)
        elem-ty)
        [(LowerExpr.Expr addr-state source-addr _)
          (match (lower-emit-load addr-state source-addr elem-ty)
            [(LowerExpr.Expr load-state source-value _)
              (lower-emit-splat load-state source-value lanes elem-ty)])])]))

(define (lower-vector-map-ir-value-eq?
  [left : CompilerIrValue]
  [right : CompilerIrValue]) : bool
  ;; Vector-map uniform values are restricted by the planner to local numeric
  ;; variables and numeric scalar literals. Broadcast lane operands use the
  ;; same subset. Keep this comparator aligned with that invariant instead of
  ;; paying for unrelated pointer, function, string, and unit IR variants.
  (match left
    [(CompilerIrValue.Var a)
      (match right
        [(CompilerIrValue.Var b) (= a b)]
        [_ false])]
    [(CompilerIrValue.I64 a)
      (match right
        [(CompilerIrValue.I64 b) (= a b)]
        [_ false])]
    [(CompilerIrValue.F64 a)
      (match right
        [(CompilerIrValue.F64 b) (= a b)]
        [_ false])]
    [_ false]))

(define (lower-vector-map-binop-eq?
  [left : CompilerIrBinOp]
  [right : CompilerIrBinOp]) : bool
  (match left
    [(CompilerIrBinOp.Add)
      (match right
        [(CompilerIrBinOp.Add) true]
        [_ false])]
    [(CompilerIrBinOp.Mul)
      (match right
        [(CompilerIrBinOp.Mul) true]
        [_ false])]
    [_ false]))

(define (lower-vector-map-value-key-eq?
  [left : LowerVectorMapValueKey]
  [right : LowerVectorMapValueKey]) : bool
  (match left
    [(LowerVectorMapValueKey.Array left-array)
      (match right
        [(LowerVectorMapValueKey.Array right-array) (= left-array right-array)]
        [_ false])]
    [(LowerVectorMapValueKey.ArrayData left-array)
      (match right
        [(LowerVectorMapValueKey.ArrayData right-array)
          (= left-array right-array)]
        [_ false])]
    [(LowerVectorMapValueKey.Gather left-source left-indexes)
      (match right
        [(LowerVectorMapValueKey.Gather right-source right-indexes)
          (and (= left-source right-source) (= left-indexes right-indexes))]
        [_ false])]
    [(LowerVectorMapValueKey.GatherLaneOffset left-source left-offsets)
      (match right
        [(LowerVectorMapValueKey.GatherLaneOffset right-source right-offsets)
          (and (= left-source right-source) (= left-offsets right-offsets))]
        [_ false])]
    [(LowerVectorMapValueKey.LaneArray left-array)
      (match right
        [(LowerVectorMapValueKey.LaneArray right-array)
          (= left-array right-array)]
        [_ false])]
    [(LowerVectorMapValueKey.Uniform left-value)
      (match right
        [(LowerVectorMapValueKey.Uniform right-value)
          (lower-vector-map-ir-value-eq? left-value right-value)]
        [_ false])]
    [(LowerVectorMapValueKey.BroadcastArray left-array left-lane)
      (match right
        [(LowerVectorMapValueKey.BroadcastArray right-array right-lane)
          (and
            (= left-array right-array)
            (lower-vector-map-ir-value-eq? left-lane right-lane))]
        [_ false])]
    [(LowerVectorMapValueKey.LaneIndex)
      (match right
        [(LowerVectorMapValueKey.LaneIndex) true]
        [_ false])]
    [(LowerVectorMapValueKey.LaneCount)
      (match right
        [(LowerVectorMapValueKey.LaneCount) true]
        [_ false])]
    [(LowerVectorMapValueKey.BinOp left-op left-lhs left-rhs)
      (match right
        [(LowerVectorMapValueKey.BinOp right-op right-lhs right-rhs)
          (and
            (lower-vector-map-binop-eq? left-op right-op)
            (lower-vector-map-ir-value-eq? left-lhs right-lhs)
            (lower-vector-map-ir-value-eq? left-rhs right-rhs))]
        [_ false])]))

(define (lower-vector-map-value-cache-empty) : LowerVectorMapValueCache
  (LowerVectorMapValueCache
    (make-array LowerVectorMapValueKey 0)
    (make-array CompilerIrValue 0)
    0))

(define (lower-vector-map-value-cache-lookup
  [cache : LowerVectorMapValueCache]
  [key : LowerVectorMapValueKey]) : LowerMaybeIrValue
  (let
    [index : i64 0]
    [found : LowerMaybeIrValue (LowerMaybeIrValue.No)]
    (begin
      (while (and
        (< index (struct-get cache count))
        (match found
          [(LowerMaybeIrValue.No) true]
          [(LowerMaybeIrValue.Some _) false]))
        (if (lower-vector-map-value-key-eq?
          key
          (array-ref (struct-get cache keys) index))
          (set!
            found
            (LowerMaybeIrValue.Some (array-ref (struct-get cache values) index)))
          (set! index (+ index 1))))
      found)))

(define (lower-vector-map-value-cache-add
  [cache : LowerVectorMapValueCache]
  [key : LowerVectorMapValueKey]
  [value : CompilerIrValue]) : LowerVectorMapValueCache
  (let
    [keys : (Array LowerVectorMapValueKey) (struct-get cache keys)]
    [values : (Array CompilerIrValue) (struct-get cache values)]
    [count : i64 (struct-get cache count)]
    (begin
      (array-push! keys key)
      (array-push! values value)
      (LowerVectorMapValueCache keys values (+ count 1)))))

;; Populate the vector-map cache in the entry block with values whose source
;; operands cannot change between gangs. The simple-map planner accepts only
;; literals and already-bound scalar vars for `Uniform`; safe SPMD rejects
;; mutation of bindings declared outside the body, so these materializations
;; dominate both the full vector loop and its masked AVX-512 tail.
(define (lower-vector-map-preheader-cache-leaves
  [state : LowerState]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (match plan
    [(LowerVectorMapValue.Uniform value)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.Uniform value))
        [(LowerMaybeIrValue.Some cached)
          (LowerVectorMapCachedEmit.Emit state cached cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-splat state value lanes elem-ty)
            (LowerVectorMapValueKey.Uniform value)
            cache)])]
    [(LowerVectorMapValue.LaneIndex)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneIndex))
        [(LowerMaybeIrValue.Some cached)
          (LowerVectorMapCachedEmit.Emit state cached cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-lane-id state lanes elem-ty)
            (LowerVectorMapValueKey.LaneIndex)
            cache)])]
    [(LowerVectorMapValue.LaneCount)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneCount))
        [(LowerMaybeIrValue.Some cached)
          (LowerVectorMapCachedEmit.Emit state cached cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-splat state (CompilerIrValue.I64 lanes) lanes elem-ty)
            (LowerVectorMapValueKey.LaneCount)
            cache)])]
    ;; Shuffle selectors may span two i64 vectors when the element lane count
    ;; exceeds the selector lane count. Its emitter owns that split, so a
    ;; generic leaf cache would materialize an unused, incorrectly shaped ID.
    [(LowerVectorMapValue.Shuffle _ _)
      (LowerVectorMapCachedEmit.Emit state CompilerIrValue.Unit cache)]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (match (lower-vector-map-preheader-cache-leaves
        state
        lanes
        elem-ty
        (box-get lhs)
        cache)
        [(LowerVectorMapCachedEmit.Emit lhs-state _ lhs-cache)
          (lower-vector-map-preheader-cache-leaves
            lhs-state
            lanes
            elem-ty
            (box-get rhs)
            lhs-cache)])]
    [_ (LowerVectorMapCachedEmit.Emit state CompilerIrValue.Unit cache)]))

(define (lower-vector-map-preheader-cache-array-data
  [state : LowerState]
  [arrays : LowerArrayVarSet]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (let
    [s : LowerState state]
    [next-cache : LowerVectorMapValueCache cache]
    [index : i64 0]
    (begin
      (while (< index (struct-get arrays count))
        (let
          [array-var : i64 (array-ref (struct-get arrays vars) index)]
          (begin
            (match (lower-array-data-pointer-value
              s
              (CompilerIrValue.Var array-var))
              [(LowerExpr.Expr next-s data-ptr _)
                (begin
                  (set! s next-s)
                  (set!
                    next-cache
                    (lower-vector-map-value-cache-add
                      next-cache
                      (LowerVectorMapValueKey.ArrayData array-var)
                      data-ptr)))])
            (set! index (+ index 1)))))
      (LowerVectorMapCachedEmit.Emit s CompilerIrValue.Unit next-cache))))

(define (lower-vector-map-preheader-cache-plan
  [state : LowerState]
  [arrays : LowerArrayVarSet]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]) : LowerVectorMapCachedEmit
  (match (lower-vector-map-preheader-cache-array-data
    state
    arrays
    (lower-vector-map-value-cache-empty))
    [(LowerVectorMapCachedEmit.Emit data-state _ data-cache)
      (lower-vector-map-preheader-cache-leaves
        data-state
        lanes
        elem-ty
        plan
        data-cache)]))

(define (lower-vector-map-preheader-cache-stores
  [state : LowerState]
  [arrays : LowerArrayVarSet]
  [stores : LowerVectorMapStoreList]
  [lanes : i64]
  [elem-ty : AstType]) : LowerVectorMapCachedEmit
  (match (lower-vector-map-preheader-cache-array-data
    state
    arrays
    (lower-vector-map-value-cache-empty))
    [(LowerVectorMapCachedEmit.Emit data-state _ data-cache)
      (let
        [s : LowerState data-state]
        [cache : LowerVectorMapValueCache data-cache]
        [index : i64 0]
        (begin
          (while (< index (struct-get stores count))
            (match (lower-vector-map-store-list-ref stores index)
              [(LowerVectorMapStore _ value-plan)
                (match (lower-vector-map-preheader-cache-leaves
                  s
                  lanes
                  elem-ty
                  value-plan
                  cache)
                  [(LowerVectorMapCachedEmit.Emit next-s _ next-cache)
                    (begin
                      (set! s next-s)
                      (set! cache next-cache))])])
            (set! index (+ index 1)))
          (LowerVectorMapCachedEmit.Emit s CompilerIrValue.Unit cache)))]))

(define (lower-emit-shuffle-selector-plan
  [state : LowerState]
  [index : CompilerIrValue]
  [lane-offset : i64]
  [gang-count : CompilerIrValue]
  [lanes : i64]
  [plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (match emit-mode
        [(LowerVectorMapEmitMode.Full)
          (lower-emit-vector-load
            state
            (CompilerIrValue.Var array-var)
            index
            lanes
            (AstType.I64))]
        [(LowerVectorMapEmitMode.Predicated _ mask)
          (lower-emit-predicated-load
            state
            (CompilerIrValue.Var array-var)
            index
            mask
            lanes
            (AstType.I64))])]
    [(LowerVectorMapValue.Uniform value)
      (lower-emit-splat state value lanes (AstType.I64))]
    [(LowerVectorMapValue.LaneIndex)
      (match (lower-emit-lane-id state lanes (AstType.I64))
        [(LowerExpr.Expr lane-state lane-value _)
          (if (= lane-offset 0)
            (LowerExpr.Expr lane-state lane-value (AstType.I64))
            (match (lower-emit-splat
              lane-state
              (CompilerIrValue.I64 lane-offset)
              lanes
              (AstType.I64))
              [(LowerExpr.Expr offset-state offset-value _)
                (lower-emit-vector-binop
                  offset-state
                  CompilerIrBinOp.Add
                  lane-value
                  offset-value
                  lanes
                  (AstType.I64))]))])]
    [(LowerVectorMapValue.LaneCount)
      (lower-emit-splat state (CompilerIrValue.I64 lanes) lanes (AstType.I64))]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-shuffle-selector-plan
        state
        index
        lane-offset
        gang-count
        lanes
        (box-get lhs)
        emit-mode)
        [(LowerExpr.Expr lhs-state lhs-value _)
          (match (lower-emit-shuffle-selector-plan
            lhs-state
            index
            lane-offset
            gang-count
            lanes
            (box-get rhs)
            emit-mode)
            [(LowerExpr.Expr rhs-state rhs-value _)
              (lower-emit-vector-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                (AstType.I64))])])]
    ;; The planner rejects these forms before constructing Shuffle.
    [_ (LowerExpr.Expr state CompilerIrValue.Unit (AstType.I64))]))

(define (lower-emit-vector-shuffle
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : AstType]
  [source-plan : LowerVectorMapValue]
  [selector-plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (let
    [selector-lanes : i64
      (lower-simd-lanes-for-elem (lower-state-mode state) (AstType.I64))]
    [index-value : CompilerIrValue (CompilerIrValue.Var index-var)]
    (match emit-mode
      [(LowerVectorMapEmitMode.Full)
        (match (lower-emit-vector-map-value
          ctx
          state
          index-var
          lanes
          elem-ty
          source-plan)
          [(LowerExpr.Expr source-state source-value _)
            (match (lower-emit-shuffle-selector-plan
              source-state
              index-value
              0
              (CompilerIrValue.I64 lanes)
              selector-lanes
              selector-plan
              (LowerVectorMapEmitMode.Full))
              [(LowerExpr.Expr low-state selector-low _)
                (if (> lanes selector-lanes)
                  (match (lower-emit-binop
                    low-state
                    CompilerIrBinOp.Add
                    index-value
                    (CompilerIrValue.I64 selector-lanes)
                    (AstType.I64))
                    [(LowerExpr.Expr high-index-state high-index _)
                      (match (lower-emit-shuffle-selector-plan
                        high-index-state
                        high-index
                        selector-lanes
                        (CompilerIrValue.I64 lanes)
                        selector-lanes
                        selector-plan
                        (LowerVectorMapEmitMode.Full))
                        [(LowerExpr.Expr high-state selector-high _)
                          (lower-emit-vector-shuffle-instr
                            high-state
                            source-value
                            selector-low
                            (CompilerIrMaybeValue.Some selector-high)
                            (CompilerIrValue.I64 lanes)
                            lanes
                            elem-ty)])])
                  (lower-emit-vector-shuffle-instr
                    low-state
                    source-value
                    selector-low
                    (CompilerIrMaybeValue.No)
                    (CompilerIrValue.I64 lanes)
                    lanes
                    elem-ty))])])]
      [(LowerVectorMapEmitMode.Predicated end-value source-mask)
        (match (lower-emit-binop
          state
          CompilerIrBinOp.Sub
          end-value
          index-value
          (AstType.I64))
          [(LowerExpr.Expr count-state active-lanes _)
            (match (lower-emit-predicated-vector-map-value
              ctx
              count-state
              index-var
              end-value
              source-mask
              lanes
              elem-ty
              source-plan)
              [(LowerExpr.Expr source-state source-value _)
                (match (lower-emit-tail-mask
                  source-state
                  index-value
                  end-value
                  selector-lanes)
                  [(LowerExpr.Expr low-mask-state low-mask _)
                    (match (lower-emit-shuffle-selector-plan
                      low-mask-state
                      index-value
                      0
                      active-lanes
                      selector-lanes
                      selector-plan
                      (LowerVectorMapEmitMode.Predicated end-value low-mask))
                      [(LowerExpr.Expr low-state selector-low _)
                        (if (> lanes selector-lanes)
                          (match (lower-emit-binop
                            low-state
                            CompilerIrBinOp.Add
                            index-value
                            (CompilerIrValue.I64 selector-lanes)
                            (AstType.I64))
                            [(LowerExpr.Expr high-index-state high-index _)
                              (match high-index
                                [(CompilerIrValue.Var high-index-var)
                                  (match (lower-emit-tail-mask
                                    high-index-state
                                    high-index
                                    end-value
                                    selector-lanes)
                                    [(LowerExpr.Expr
                                        high-mask-state
                                        high-mask
                                        _)
                                      (match (lower-emit-shuffle-selector-plan
                                        high-mask-state
                                        high-index
                                        selector-lanes
                                        active-lanes
                                        selector-lanes
                                        selector-plan
                                        (LowerVectorMapEmitMode.Predicated
                                          end-value
                                          high-mask))
                                        [(LowerExpr.Expr
                                            high-state
                                            selector-high
                                            _)
                                          (lower-emit-vector-shuffle-instr
                                            high-state
                                            source-value
                                            selector-low
                                            (CompilerIrMaybeValue.Some
                                              selector-high)
                                            active-lanes
                                            lanes
                                            elem-ty)])])]
                                [_
                                  (LowerExpr.Expr
                                    high-index-state
                                    CompilerIrValue.Unit
                                    elem-ty)])])
                          (lower-emit-vector-shuffle-instr
                            low-state
                            source-value
                            selector-low
                            (CompilerIrMaybeValue.No)
                            active-lanes
                            lanes
                            elem-ty))])])])])])))

(define (lower-emit-vector-map-value
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (lower-emit-vector-load
        state
        (CompilerIrValue.Var array-var)
        (CompilerIrValue.Var index-var)
        lanes
        elem-ty)]
    [(LowerVectorMapValue.Gather source-var indexes-var)
      (match (lower-array-len-value state (CompilerIrValue.Var source-var))
        [(LowerExpr.Expr len-state source-len _)
          (match (lower-array-data-pointer-value
            len-state
            (CompilerIrValue.Var source-var))
            [(LowerExpr.Expr source-state source-data _)
              (match (lower-array-data-pointer-value
                source-state
                (CompilerIrValue.Var indexes-var))
                [(LowerExpr.Expr indexes-state indexes-data _)
                  (match (lower-emit-gather-lane-checks
                    ctx
                    indexes-state
                    indexes-data
                    index-var
                    0
                    lanes
                    source-len)
                    [(LowerExpr.Expr checked-state _ _)
                      (lower-emit-gather-load
                        checked-state
                        source-data
                        indexes-data
                        (CompilerIrValue.Var index-var)
                        false
                        lanes
                        elem-ty)])])])])]
    [(LowerVectorMapValue.GatherLaneOffset source-var offsets-var)
      (match (lower-array-len-value state (CompilerIrValue.Var source-var))
        [(LowerExpr.Expr len-state source-len _)
          (match (lower-array-data-pointer-value
            len-state
            (CompilerIrValue.Var source-var))
            [(LowerExpr.Expr source-state source-data _)
              (match (lower-array-len-value
                source-state
                (CompilerIrValue.Var offsets-var))
                [(LowerExpr.Expr offsets-len-state offsets-len _)
                  (match (lower-array-data-pointer-value
                    (lower-emit-bounds-check
                      offsets-len-state
                      (CompilerIrValue.I64 (- lanes 1))
                      offsets-len)
                    (CompilerIrValue.Var offsets-var))
                    [(LowerExpr.Expr offsets-state offsets-data _)
                      (match (lower-emit-gather-lane-offset-checks
                        offsets-state
                        offsets-data
                        index-var
                        0
                        lanes
                        source-len)
                        [(LowerExpr.Expr checked-state _ _)
                          (lower-emit-gather-load
                            checked-state
                            source-data
                            offsets-data
                            (CompilerIrValue.Var index-var)
                            true
                            lanes
                            elem-ty)])])])])])]
    [(LowerVectorMapValue.LaneArray array-var)
      (match (lower-array-len-value state (CompilerIrValue.Var array-var))
        [(LowerExpr.Expr len-state array-len _)
          (lower-emit-vector-load
            (lower-emit-bounds-check
              len-state
              (CompilerIrValue.I64 (- lanes 1))
              array-len)
            (CompilerIrValue.Var array-var)
            (CompilerIrValue.I64 0)
            lanes
            elem-ty)])]
    [(LowerVectorMapValue.Uniform value)
      (lower-emit-splat state value lanes elem-ty)]
    [(LowerVectorMapValue.BroadcastArray array-var lane)
      (lower-emit-spmd-broadcast-array
        ctx
        state
        index-var
        array-var
        lane
        (CompilerIrValue.I64 lanes)
        lanes
        elem-ty)]
    [(LowerVectorMapValue.LaneIndex) (lower-emit-lane-id state lanes elem-ty)]
    [(LowerVectorMapValue.LaneCount)
      (lower-emit-splat state (CompilerIrValue.I64 lanes) lanes elem-ty)]
    [(LowerVectorMapValue.Shuffle source selector)
      (lower-emit-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get source)
        (box-get selector)
        (LowerVectorMapEmitMode.Full))]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-vector-map-value
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get lhs))
        [(LowerExpr.Expr lhs-state lhs-value _)
          (match (lower-emit-vector-map-value
            ctx
            lhs-state
            index-var
            lanes
            elem-ty
            (box-get rhs))
            [(LowerExpr.Expr rhs-state rhs-value _)
              (lower-emit-vector-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                elem-ty)])])]))

(define (lower-vector-map-cache-emitted
  [emitted : LowerExpr]
  [key : LowerVectorMapValueKey]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (match emitted
    [(LowerExpr.Expr state value _)
      (LowerVectorMapCachedEmit.Emit
        state
        value
        (lower-vector-map-value-cache-add cache key value))]))

(define (lower-emit-vector-map-value-for-mode
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match emit-mode
    [(LowerVectorMapEmitMode.Full)
      (lower-emit-vector-map-value ctx state index-var lanes elem-ty plan)]
    [(LowerVectorMapEmitMode.Predicated end-value mask)
      (lower-emit-predicated-vector-map-value
        ctx
        state
        index-var
        end-value
        mask
        lanes
        elem-ty
        plan)]))

(define (lower-emit-vector-array-data-for-mode
  [state : LowerState]
  [data-ptr : CompilerIrValue]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : AstType]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match emit-mode
    [(LowerVectorMapEmitMode.Full)
      (lower-emit-vector-load-data
        state
        data-ptr
        (CompilerIrValue.Var index-var)
        lanes
        elem-ty)]
    [(LowerVectorMapEmitMode.Predicated _ mask)
      (lower-emit-predicated-load-data
        state
        data-ptr
        (CompilerIrValue.Var index-var)
        mask
        lanes
        elem-ty)]))

(define (lower-emit-vector-map-value-cached
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.Array array-var))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (match (lower-vector-map-value-cache-lookup
            cache
            (LowerVectorMapValueKey.ArrayData array-var))
            [(LowerMaybeIrValue.Some data-ptr)
              (lower-vector-map-cache-emitted
                (lower-emit-vector-array-data-for-mode
                  state
                  data-ptr
                  index-var
                  lanes
                  elem-ty
                  emit-mode)
                (LowerVectorMapValueKey.Array array-var)
                cache)]
            [(LowerMaybeIrValue.No)
              (lower-vector-map-cache-emitted
                (lower-emit-vector-map-value-for-mode
                  ctx
                  state
                  index-var
                  lanes
                  elem-ty
                  (LowerVectorMapValue.Array array-var)
                  emit-mode)
                (LowerVectorMapValueKey.Array array-var)
                cache)])])]
    [(LowerVectorMapValue.Gather source-var indexes-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.Gather source-var indexes-var))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.Gather source-var indexes-var)
              emit-mode)
            (LowerVectorMapValueKey.Gather source-var indexes-var)
            cache)])]
    [(LowerVectorMapValue.GatherLaneOffset source-var offsets-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.GatherLaneOffset source-var offsets-var))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.GatherLaneOffset source-var offsets-var)
              emit-mode)
            (LowerVectorMapValueKey.GatherLaneOffset source-var offsets-var)
            cache)])]
    [(LowerVectorMapValue.LaneArray array-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneArray array-var))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.LaneArray array-var)
              emit-mode)
            (LowerVectorMapValueKey.LaneArray array-var)
            cache)])]
    [(LowerVectorMapValue.Uniform uniform-value)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.Uniform uniform-value))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.Uniform uniform-value)
              emit-mode)
            (LowerVectorMapValueKey.Uniform uniform-value)
            cache)])]
    [(LowerVectorMapValue.BroadcastArray array-var lane)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.BroadcastArray array-var lane))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.BroadcastArray array-var lane)
              emit-mode)
            (LowerVectorMapValueKey.BroadcastArray array-var lane)
            cache)])]
    [(LowerVectorMapValue.LaneIndex)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneIndex))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.LaneIndex)
              emit-mode)
            (LowerVectorMapValueKey.LaneIndex)
            cache)])]
    [(LowerVectorMapValue.LaneCount)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneCount))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.LaneCount)
              emit-mode)
            (LowerVectorMapValueKey.LaneCount)
            cache)])]
    [(LowerVectorMapValue.Shuffle source selector)
      (match (lower-emit-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get source)
        (box-get selector)
        emit-mode)
        [(LowerExpr.Expr shuffle-state shuffle-value _)
          (LowerVectorMapCachedEmit.Emit shuffle-state shuffle-value cache)])]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-vector-map-value-cached
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get lhs)
        emit-mode
        cache)
        [(LowerVectorMapCachedEmit.Emit lhs-state lhs-value lhs-cache)
          (match (lower-emit-vector-map-value-cached
            ctx
            lhs-state
            index-var
            lanes
            elem-ty
            (box-get rhs)
            emit-mode
            lhs-cache)
            [(LowerVectorMapCachedEmit.Emit rhs-state rhs-value rhs-cache)
              (match (lower-vector-map-value-cache-lookup
                rhs-cache
                (LowerVectorMapValueKey.BinOp op lhs-value rhs-value))
                [(LowerMaybeIrValue.Some value)
                  (LowerVectorMapCachedEmit.Emit rhs-state value rhs-cache)]
                [(LowerMaybeIrValue.No)
                  (lower-vector-map-cache-emitted
                    (lower-emit-vector-binop
                      rhs-state
                      op
                      lhs-value
                      rhs-value
                      lanes
                      elem-ty)
                    (LowerVectorMapValueKey.BinOp op lhs-value rhs-value)
                    rhs-cache)])])])]))

(define (lower-emit-predicated-vector-map-value
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : CompilerIrValue]
  [mask : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (lower-emit-predicated-load
        state
        (CompilerIrValue.Var array-var)
        (CompilerIrValue.Var index-var)
        mask
        lanes
        elem-ty)]
    ;; Gather maps use the scalar tail path so only active lanes are checked.
    [(LowerVectorMapValue.Gather _ _)
      (LowerExpr.Expr state CompilerIrValue.Unit elem-ty)]
    [(LowerVectorMapValue.GatherLaneOffset _ _)
      (LowerExpr.Expr state CompilerIrValue.Unit elem-ty)]
    [(LowerVectorMapValue.LaneArray array-var)
      (match (lower-emit-binop
        state
        CompilerIrBinOp.Sub
        end-value
        (CompilerIrValue.Var index-var)
        (AstType.I64))
        [(LowerExpr.Expr count-state active-lanes _)
          (match (lower-emit-binop
            count-state
            CompilerIrBinOp.Sub
            active-lanes
            (CompilerIrValue.I64 1)
            (AstType.I64))
            [(LowerExpr.Expr last-state last-lane _)
              (match (lower-array-len-value
                last-state
                (CompilerIrValue.Var array-var))
                [(LowerExpr.Expr len-state array-len _)
                  (lower-emit-predicated-load
                    (lower-emit-bounds-check len-state last-lane array-len)
                    (CompilerIrValue.Var array-var)
                    (CompilerIrValue.I64 0)
                    mask
                    lanes
                    elem-ty)])])])]
    [(LowerVectorMapValue.Uniform value)
      (lower-emit-splat state value lanes elem-ty)]
    [(LowerVectorMapValue.BroadcastArray array-var lane)
      (match (lower-emit-binop
        state
        CompilerIrBinOp.Sub
        end-value
        (CompilerIrValue.Var index-var)
        (AstType.I64))
        [(LowerExpr.Expr count-state active-lanes _)
          (lower-emit-spmd-broadcast-array
            ctx
            count-state
            index-var
            array-var
            lane
            active-lanes
            lanes
            elem-ty)])]
    [(LowerVectorMapValue.LaneIndex) (lower-emit-lane-id state lanes elem-ty)]
    [(LowerVectorMapValue.LaneCount)
      (lower-emit-splat state (CompilerIrValue.I64 lanes) lanes elem-ty)]
    [(LowerVectorMapValue.Shuffle source selector)
      (lower-emit-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get source)
        (box-get selector)
        (LowerVectorMapEmitMode.Predicated end-value mask))]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-predicated-vector-map-value
        ctx
        state
        index-var
        end-value
        mask
        lanes
        elem-ty
        (box-get lhs))
        [(LowerExpr.Expr lhs-state lhs-value _)
          (match (lower-emit-predicated-vector-map-value
            ctx
            lhs-state
            index-var
            end-value
            mask
            lanes
            elem-ty
            (box-get rhs))
            [(LowerExpr.Expr rhs-state rhs-value _)
              (lower-emit-vector-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                elem-ty)])])]))

(define (lower-vector-map-value-needs-scalar-tail? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapValue.Gather _ _) true]
    [(LowerVectorMapValue.GatherLaneOffset _ _) true]
    [(LowerVectorMapValue.BroadcastArray _ _) true]
    [(LowerVectorMapValue.LaneArray _) true]
    [(LowerVectorMapValue.LaneIndex) true]
    [(LowerVectorMapValue.LaneCount) true]
    [(LowerVectorMapValue.Shuffle _ _) true]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-needs-scalar-tail? (box-get lhs))
        (lower-vector-map-value-needs-scalar-tail? (box-get rhs)))]
    [_ false]))

(define (lower-vector-map-value-has-gather? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapValue.Gather _ _) true]
    [(LowerVectorMapValue.GatherLaneOffset _ _) true]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-has-gather? (box-get lhs))
        (lower-vector-map-value-has-gather? (box-get rhs)))]
    [_ false]))

(define (lower-vector-map-store-list-needs-scalar-tail?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [needs-tail : bool false]
    (begin
      (while (and (not needs-tail) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore _ value-plan)
            (if (lower-vector-map-value-needs-scalar-tail? value-plan)
              (set! needs-tail true)
              (set! index (+ index 1)))]))
      needs-tail)))

(define (lower-vector-map-store-list-has-gather?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [has-gather : bool false]
    (begin
      (while (and (not has-gather) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore _ value-plan)
            (if (lower-vector-map-value-has-gather? value-plan)
              (set! has-gather true)
              (set! index (+ index 1)))]))
      has-gather)))

(define (lower-vector-map-store-list-has-shuffle?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [has-shuffle : bool false]
    (begin
      (while (and (not has-shuffle) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore _ value-plan)
            (if (lower-vector-map-value-has-shuffle? value-plan)
              (set! has-shuffle true)
              (set! index (+ index 1)))]))
      has-shuffle)))

(define (lower-maybe-vector-map-needs-scalar-tail? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(LowerMaybeVectorMap.Some stores _ _)
      (lower-vector-map-store-list-needs-scalar-tail? stores)]
    [(LowerMaybeVectorMap.No) false]))

(define (lower-maybe-vector-map-has-gather? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(LowerMaybeVectorMap.Some stores _ _)
      (lower-vector-map-store-list-has-gather? stores)]
    [(LowerMaybeVectorMap.No) false]))

(define (lower-maybe-vector-map-has-shuffle? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(LowerMaybeVectorMap.Some stores _ _)
      (lower-vector-map-store-list-has-shuffle? stores)]
    [(LowerMaybeVectorMap.No) false]))

(define (lower-emit-scalar-vector-map-value
  [ctx : TcContext]
  [state : LowerState]
  [base-index-var : i64]
  [current-index-var : i64]
  [lane-index : CompilerIrValue]
  [active-lanes : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (match (lower-array-element-addr
        ctx
        state
        (CompilerIrValue.Var array-var)
        (CompilerIrValue.Var current-index-var)
        (AstType.I64)
        elem-ty)
        [(LowerExpr.Expr addr-state elem-ptr _)
          (lower-emit-load addr-state elem-ptr elem-ty)])]
    [(LowerVectorMapValue.Gather source-var indexes-var)
      (match (lower-array-element-addr
        ctx
        state
        (CompilerIrValue.Var indexes-var)
        (CompilerIrValue.Var current-index-var)
        (AstType.I64)
        (AstType.I64))
        [(LowerExpr.Expr index-addr-state index-ptr _)
          (match (lower-emit-load index-addr-state index-ptr (AstType.I64))
            [(LowerExpr.Expr index-state gathered-index _)
              (match (lower-array-element-addr
                ctx
                index-state
                (CompilerIrValue.Var source-var)
                gathered-index
                (AstType.I64)
                elem-ty)
                [(LowerExpr.Expr source-addr-state source-ptr _)
                  (lower-emit-load source-addr-state source-ptr elem-ty)])])])]
    [(LowerVectorMapValue.GatherLaneOffset source-var offsets-var)
      ;; The tail loop mutates `current-index-var`. Emit this subtraction raw
      ;; instead of using the lowering-time copy folder, which otherwise sees
      ;; the loop's initial `current == base` assignment and freezes every tail
      ;; iteration to lane zero.
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc lane-alloc-state lane-var)
          (match (lower-array-element-addr
            ctx
            (lower-state-emit
              lane-alloc-state
              (CompilerIrInstr.BinOp
                lane-var
                CompilerIrBinOp.Sub
                (CompilerIrValue.Var current-index-var)
                (CompilerIrValue.Var base-index-var)
                (AstType.I64)))
            (CompilerIrValue.Var offsets-var)
            (CompilerIrValue.Var lane-var)
            (AstType.I64)
            (AstType.I64))
            [(LowerExpr.Expr offset-addr-state offset-ptr _)
              (match (lower-emit-load
                offset-addr-state
                offset-ptr
                (AstType.I64))
                [(LowerExpr.Expr offset-state offset _)
                  (match (lower-emit-binop
                    offset-state
                    CompilerIrBinOp.Add
                    (CompilerIrValue.Var current-index-var)
                    offset
                    (AstType.I64))
                    [(LowerExpr.Expr index-state gathered-index _)
                      (match (lower-array-element-addr
                        ctx
                        index-state
                        (CompilerIrValue.Var source-var)
                        gathered-index
                        (AstType.I64)
                        elem-ty)
                        [(LowerExpr.Expr source-addr-state source-ptr _)
                          (lower-emit-load source-addr-state source-ptr elem-ty)])])])])])]
    [(LowerVectorMapValue.LaneArray array-var)
      (match (lower-emit-binop
        state
        CompilerIrBinOp.Sub
        (CompilerIrValue.Var current-index-var)
        (CompilerIrValue.Var base-index-var)
        (AstType.I64))
        [(LowerExpr.Expr lane-state lane-index _)
          (match (lower-array-element-addr
            ctx
            lane-state
            (CompilerIrValue.Var array-var)
            lane-index
            (AstType.I64)
            elem-ty)
            [(LowerExpr.Expr addr-state elem-ptr _)
              (lower-emit-load addr-state elem-ptr elem-ty)])])]
    [(LowerVectorMapValue.Uniform value) (LowerExpr.Expr state value elem-ty)]
    [(LowerVectorMapValue.BroadcastArray array-var lane)
      (match (lower-emit-binop
        (lower-emit-spmd-broadcast-lane-check state lane active-lanes)
        CompilerIrBinOp.Add
        (CompilerIrValue.Var base-index-var)
        lane
        (AstType.I64))
        [(LowerExpr.Expr index-state source-index _)
          (match (lower-array-element-addr
            ctx
            index-state
            (CompilerIrValue.Var array-var)
            source-index
            (AstType.I64)
            elem-ty)
            [(LowerExpr.Expr addr-state elem-ptr _)
              (lower-emit-load addr-state elem-ptr elem-ty)])])]
    [(LowerVectorMapValue.LaneIndex)
      (lower-emit-binop
        state
        CompilerIrBinOp.Sub
        (CompilerIrValue.Var current-index-var)
        (CompilerIrValue.Var base-index-var)
        elem-ty)]
    [(LowerVectorMapValue.LaneCount)
      (LowerExpr.Expr state (CompilerIrValue.I64 lanes) elem-ty)]
    [(LowerVectorMapValue.Shuffle source selector)
      (match (lower-emit-scalar-vector-map-value
        ctx
        state
        base-index-var
        current-index-var
        lane-index
        active-lanes
        lanes
        (AstType.I64)
        (box-get selector))
        [(LowerExpr.Expr selector-state selector-value _)
          (match (lower-state-alloc-var
            (lower-emit-spmd-broadcast-lane-check
              selector-state
              selector-value
              active-lanes))
            [(LowerAlloc.Alloc source-index-state source-index-var)
              (lower-emit-scalar-vector-map-value
                ctx
                (lower-state-emit
                  source-index-state
                  (CompilerIrInstr.BinOp
                    source-index-var
                    CompilerIrBinOp.Add
                    (CompilerIrValue.Var base-index-var)
                    selector-value
                    (AstType.I64)))
                base-index-var
                source-index-var
                selector-value
                active-lanes
                lanes
                elem-ty
                (box-get source))])])]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-scalar-vector-map-value
        ctx
        state
        base-index-var
        current-index-var
        lane-index
        active-lanes
        lanes
        elem-ty
        (box-get lhs))
        [(LowerExpr.Expr lhs-state lhs-value _)
          (match (lower-emit-scalar-vector-map-value
            ctx
            lhs-state
            base-index-var
            current-index-var
            lane-index
            active-lanes
            lanes
            elem-ty
            (box-get rhs))
            [(LowerExpr.Expr rhs-state rhs-value _)
              (lower-emit-binop rhs-state op lhs-value rhs-value elem-ty)])])]))

(define (lower-avx2-broadcast-tail-map-body
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : CompilerIrValue]
  [stores : LowerVectorMapStoreList]
  [elem-ty : AstType]
  [lanes : i64]
  [exit-label : String]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc alloc-state tail-var)
      (let
        [s : LowerState
          (lower-state-emit
            alloc-state
            (CompilerIrInstr.Mov
              tail-var
              (CompilerIrValue.Var index-var)
              (AstType.I64)))]
        [tail-lane-var : i64 0]
        [header-label : String ""]
        [body-label : String ""]
        [active-lanes : CompilerIrValue CompilerIrValue.Unit]
        [tail-cond : CompilerIrValue CompilerIrValue.Unit]
        [scalar-value : CompilerIrValue CompilerIrValue.Unit]
        [elem-ptr : CompilerIrValue CompilerIrValue.Unit]
        [store-index : i64 0]
        (begin
          (match (lower-state-alloc-var s)
            [(LowerAlloc.Alloc next-s var)
              (begin
                (set! s next-s)
                (set! tail-lane-var var))])
          (set!
            s
            (lower-state-emit
              s
              (CompilerIrInstr.Mov
                tail-lane-var
                (CompilerIrValue.I64 0)
                (AstType.I64))))
          (match (lower-state-fresh-label s "foreach_broadcast_tail_header")
            [(LowerLabel.Label next-s label)
              (begin
                (set! s next-s)
                (set! header-label label))])
          (match (lower-state-fresh-label s "foreach_broadcast_tail_body")
            [(LowerLabel.Label next-s label)
              (begin
                (set! s next-s)
                (set! body-label label))])
          (match (lower-emit-binop
            s
            CompilerIrBinOp.Sub
            end-value
            (CompilerIrValue.Var index-var)
            (AstType.I64))
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! active-lanes value))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit s (CompilerIrInstr.Jump header-label))
              header-label))
          (match (lower-emit-binop
            s
            CompilerIrBinOp.Lt
            (CompilerIrValue.Var tail-var)
            end-value
            (AstType.I64))
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! tail-cond value))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit
                s
                (CompilerIrInstr.Branch tail-cond body-label exit-label))
              body-label))
          (while (< store-index (struct-get stores count))
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore dst-array value-plan)
                (begin
                  (match (lower-emit-scalar-vector-map-value
                    ctx
                    s
                    index-var
                    tail-var
                    (CompilerIrValue.Var tail-lane-var)
                    active-lanes
                    lanes
                    elem-ty
                    value-plan)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! scalar-value value))])
                  (match (lower-array-element-addr
                    ctx
                    s
                    (CompilerIrValue.Var dst-array)
                    (CompilerIrValue.Var tail-var)
                    (AstType.I64)
                    elem-ty)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! elem-ptr value))])
                  (set!
                    s
                    (lower-array-elem-store-state
                      ctx
                      s
                      elem-ptr
                      scalar-value
                      elem-ty))
                  (set! store-index (+ store-index 1)))]))
          (match (lower-state-alloc-var s)
            [(LowerAlloc.Alloc inc-alloc inc-var)
              (match (lower-state-alloc-var inc-alloc)
                [(LowerAlloc.Alloc lane-inc-alloc lane-inc-var)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            (lower-state-emit
                              (lower-state-emit
                                (lower-state-emit
                                  lane-inc-alloc
                                  (CompilerIrInstr.BinOp
                                    inc-var
                                    CompilerIrBinOp.Add
                                    (CompilerIrValue.Var tail-var)
                                    (CompilerIrValue.I64 1)
                                    (AstType.I64)))
                                (CompilerIrInstr.Mov
                                  tail-var
                                  (CompilerIrValue.Var inc-var)
                                  (AstType.I64)))
                              (CompilerIrInstr.BinOp
                                lane-inc-var
                                CompilerIrBinOp.Add
                                (CompilerIrValue.Var tail-lane-var)
                                (CompilerIrValue.I64 1)
                                (AstType.I64)))
                            (CompilerIrInstr.Mov
                              tail-lane-var
                              (CompilerIrValue.Var lane-inc-var)
                              (AstType.I64)))
                          (CompilerIrInstr.Jump header-label))
                        exit-label)
                      CompilerIrValue.Unit
                      (AstType.Unit)))])])))]))

(define (lower-avx2-vector-map-body
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [next-index : CompilerIrValue]
  [plan : LowerMaybeVectorMap]
  [preheader-cache : LowerVectorMapValueCache]) : LowerState
  (match plan
    [(LowerMaybeVectorMap.Some stores elem-ty lanes)
      (let
        [s : LowerState state]
        [count : i64 (struct-get stores count)]
        [results : (Array CompilerIrValue) (make-array CompilerIrValue count)]
        [store-index : i64 0]
        [cache : LowerVectorMapValueCache preheader-cache]
        [result-vec : CompilerIrValue CompilerIrValue.Unit]
        (begin
          ;; Evaluate all values before the first store so common loads and
          ;; products stay in one side-effect-free region for normal CSE.
          (while (< store-index count)
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore _ value-plan)
                (begin
                  (match (lower-emit-vector-map-value-cached
                    ctx
                    s
                    index-var
                    lanes
                    elem-ty
                    value-plan
                    (LowerVectorMapEmitMode.Full)
                    cache)
                    [(LowerVectorMapCachedEmit.Emit next-s value next-cache)
                      (begin
                        (set! s next-s)
                        (set! result-vec value)
                        (set! cache next-cache))])
                  (array-set! results store-index result-vec)
                  (set! store-index (+ store-index 1)))]))
          (set! store-index 0)
          (while (< store-index count)
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore dst-array _)
                (begin
                  (match (lower-vector-map-value-cache-lookup
                    cache
                    (LowerVectorMapValueKey.ArrayData dst-array))
                    [(LowerMaybeIrValue.Some data-ptr)
                      (set!
                        s
                        (lower-emit-vector-store-data
                          s
                          data-ptr
                          (CompilerIrValue.Var index-var)
                          (array-ref results store-index)
                          lanes
                          elem-ty))]
                    [(LowerMaybeIrValue.No)
                      (set!
                        s
                        (lower-emit-vector-store
                          s
                          (CompilerIrValue.Var dst-array)
                          (CompilerIrValue.Var index-var)
                          (array-ref results store-index)
                          lanes
                          elem-ty))])
                  (set! store-index (+ store-index 1)))]))
          (lower-state-emit
            s
            (CompilerIrInstr.Mov index-var next-index (AstType.I64)))))]
    [(LowerMaybeVectorMap.No) state]))

(define (lower-avx512-index-plus-offset
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]) : LowerExpr
  (if (> offset 0)
    (lower-emit-binop
      state
      (CompilerIrBinOp.Add)
      base
      (CompilerIrValue.I64 offset)
      (AstType.I64))
    (LowerExpr.Expr state base (AstType.I64))))

(define (lower-avx512-array-set-end-ok
  [state : LowerState]
  [ok : CompilerIrValue]
  [end-value : CompilerIrValue]
  [arrays : LowerArrayVarSet]) : LowerExpr
  (let
    [s : LowerState state]
    [next-ok : CompilerIrValue ok]
    [index : i64 0]
    [count : i64 (struct-get arrays count)]
    (begin
      (while (< index count)
        (let
          [array-var : i64 (array-ref (struct-get arrays vars) index)]
          [offset : i64 (array-ref (struct-get arrays offsets) index)]
          (begin
            (match (lower-avx512-index-plus-offset s end-value offset)
              [(LowerExpr.Expr index-state limit-index _)
                (match (lower-array-len-value
                  index-state
                  (CompilerIrValue.Var array-var))
                  [(LowerExpr.Expr len-state array-len _)
                    (match (lower-vector-loop-i64-compare
                      len-state
                      (CompilerIrBinOp.Le)
                      limit-index
                      array-len)
                      [(LowerExpr.Expr cmp-state within _)
                        (match (lower-emit-binop
                          cmp-state
                          (CompilerIrBinOp.And)
                          next-ok
                          within
                          (AstType.Bool))
                          [(LowerExpr.Expr next-state value _)
                            (begin
                              (set! s next-state)
                              (set! next-ok value))])])])])
            (set! index (+ index 1)))))
      (LowerExpr.Expr s next-ok (AstType.Bool)))))

(define (lower-avx512-masked-tail-limit [offset : i64]) : i64
  (- 9223372036854775807 offset))

(define (lower-avx512-masked-tail-ok
  [state : LowerState]
  [index-var : i64]
  [end-value : CompilerIrValue]
  [arrays : LowerArrayVarSet]) : LowerExpr
  (let
    [s : LowerState state]
    [max-offset : i64 (lower-array-var-set-max-offset arrays)]
    [ok : CompilerIrValue CompilerIrValue.Unit]
    [within : CompilerIrValue CompilerIrValue.Unit]
    (begin
      (match (lower-vector-loop-i64-compare
        s
        (CompilerIrBinOp.Ge)
        (CompilerIrValue.Var index-var)
        (CompilerIrValue.I64 0))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-vector-loop-i64-compare
        s
        (CompilerIrBinOp.Le)
        end-value
        (CompilerIrValue.I64 (lower-avx512-masked-tail-limit max-offset)))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-vector-loop-i64-compare
        s
        (CompilerIrBinOp.Le)
        (CompilerIrValue.Var index-var)
        end-value)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop s (CompilerIrBinOp.And) ok within (AstType.Bool))
        [(LowerExpr.Expr next-s value _)
          (lower-avx512-array-set-end-ok next-s value end-value arrays)]))))

(define (lower-avx512-masked-unsupported [expr : AstExpr] [detail : String]) : ResultLowerExpr
  (ResultLowerExpr.Err
    (box
      (lower-diagnostic-at-expr
        expr
        (string.append "lower: SPMD masked if does not support " detail)))))

(define (lower-avx512-masked-index-value
  [ctx : TcContext]
  [state : LowerState]
  [index : String]
  [index-var : i64]
  [expr : AstExpr]) : ResultLowerExpr
  (let
    [offset : i64 (lower-masked-vector-index-offset ctx index expr)]
    (if (< offset 0)
      (lower-avx512-masked-unsupported
        expr
        "non-contiguous array indexes in this AVX-512 slice")
      (if (= offset 0)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr state (CompilerIrValue.Var index-var) (AstType.I64)))
        (ResultLowerExpr.Ok
          (lower-emit-binop
            state
            (CompilerIrBinOp.Add)
            (CompilerIrValue.Var index-var)
            (CompilerIrValue.I64 offset)
            (AstType.I64)))))))

(define (lower-avx512-masked-bool-literal
  [state : LowerState]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [value : bool]) : LowerExpr
  (if value
    (LowerExpr.Expr state active-mask (AstType.Bool))
    (lower-emit-mask-not state active-mask lanes)))

(define (lower-avx512-masked-var
  [_ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [lanes : i64]
  [expr : AstExpr]
  [name : i64]) : ResultLowerExpr
  (if (lower-id-set-contains? lane-locals name)
    (let
      [var-id : i64
        (sym_i64_env.sym-i64-lookup-id-or
          env
          name
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? var-id)
        (match (tc-lookup-id type-env name)
          [(ResultTcType.Ok ty)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                state
                (CompilerIrValue.Var var-id)
                (tc-type-without-regions ty)))]
          [(ResultTcType.Err message)
            (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))])
        (lower-avx512-masked-unsupported expr "unknown lane-local binding")))
    (if (string.eq (tc-env-key-name-text name) index)
      (ResultLowerExpr.Ok
        (lower-emit-foreach-index-vector state index-var lanes))
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? var-id)
          (match (tc-lookup-id type-env name)
            [(ResultTcType.Ok ty)
              (let
                [lane-ty : AstType (tc-type-without-regions ty)]
                (if (>
                  (lower-simd-lanes-for-elem (lower-state-mode state) lane-ty)
                  0)
                  (ResultLowerExpr.Ok
                    (lower-emit-splat
                      state
                      (CompilerIrValue.Var var-id)
                      lanes
                      lane-ty))
                  (lower-avx512-masked-unsupported
                    expr
                    "uniform non-lane values inside masked vector expressions")))]
            [(ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr expr message)))])
          (lower-avx512-masked-unsupported
            expr
            "unbound values inside masked vector expressions"))))))

(define (lower-avx512-masked-array-ref
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [arr : AstExpr]
  [idx : AstExpr]) : ResultLowerExpr
  (match (lower-dynamic-array-var ctx env type-env arr)
    [(LowerMaybeArrayVar.Some array-var elem-ty)
      (let
        [lane-ty : AstType (tc-type-without-regions elem-ty)]
        (if (lower-type-bool? lane-ty)
          (match (lower-avx512-masked-index-value ctx state index index-var idx)
            [(ResultLowerExpr.Ok idx-lowered)
              (match idx-lowered
                [(LowerExpr.Expr idx-state idx-value _)
                  (ResultLowerExpr.Ok
                    (lower-emit-predicated-load
                      idx-state
                      (CompilerIrValue.Var array-var)
                      idx-value
                      active-mask
                      lanes
                      lane-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
          (if (=
            (lower-simd-lanes-for-elem (lower-state-mode state) lane-ty)
            lanes)
            (match (lower-avx512-masked-index-value
              ctx
              state
              index
              index-var
              idx)
              [(ResultLowerExpr.Ok idx-lowered)
                (match idx-lowered
                  [(LowerExpr.Expr idx-state idx-value _)
                    (ResultLowerExpr.Ok
                      (lower-emit-predicated-load
                        idx-state
                        (CompilerIrValue.Var array-var)
                        idx-value
                        active-mask
                        lanes
                        lane-ty))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (lower-avx512-masked-unsupported
              expr
              "mixed lane widths inside one masked foreach"))))]
    [(LowerMaybeArrayVar.No)
      (lower-avx512-masked-unsupported
        expr
        "non-dynamic-array reads inside masked branches")]))

(define (lower-avx512-masked-array-set
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [arr : AstExpr]
  [idx : AstExpr]
  [value : AstExpr]) : ResultLowerExpr
  (match (lower-dynamic-array-var ctx env type-env arr)
    [(LowerMaybeArrayVar.Some array-var elem-ty)
      (let
        [lane-ty : AstType (tc-type-without-regions elem-ty)]
        (if (lower-type-bool? lane-ty)
          (match (lower-avx512-masked-index-value ctx state index index-var idx)
            [(ResultLowerExpr.Ok idx-lowered)
              (match idx-lowered
                [(LowerExpr.Expr idx-state idx-value _)
                  (match (lower-avx512-masked-expr-expected
                    ctx
                    idx-state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    value
                    lane-ty)
                    [(ResultLowerExpr.Ok value-lowered)
                      (match value-lowered
                        [(LowerExpr.Expr value-state value-ir _)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (lower-emit-predicated-store
                                value-state
                                (CompilerIrValue.Var array-var)
                                idx-value
                                value-ir
                                active-mask
                                lanes
                                lane-ty)
                              CompilerIrValue.Unit
                              (AstType.Unit)))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
          (if (=
            (lower-simd-lanes-for-elem (lower-state-mode state) lane-ty)
            lanes)
            (match (lower-avx512-masked-index-value
              ctx
              state
              index
              index-var
              idx)
              [(ResultLowerExpr.Ok idx-lowered)
                (match idx-lowered
                  [(LowerExpr.Expr idx-state idx-value _)
                    (match (lower-avx512-masked-expr-expected
                      ctx
                      idx-state
                      env
                      type-env
                      lane-locals
                      index
                      index-var
                      active-mask
                      lanes
                      value
                      lane-ty)
                      [(ResultLowerExpr.Ok value-lowered)
                        (match value-lowered
                          [(LowerExpr.Expr value-state value-ir _)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                (lower-emit-predicated-store
                                  value-state
                                  (CompilerIrValue.Var array-var)
                                  idx-value
                                  value-ir
                                  active-mask
                                  lanes
                                  lane-ty)
                                CompilerIrValue.Unit
                                (AstType.Unit)))])]
                      [(ResultLowerExpr.Err message)
                        (ResultLowerExpr.Err message)])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (lower-avx512-masked-unsupported
              expr
              "mixed lane widths inside one masked foreach"))))]
    [(LowerMaybeArrayVar.No)
      (lower-avx512-masked-unsupported
        expr
        "non-dynamic-array writes inside masked branches")]))

;; AVX2 has no mask registers and this slice deliberately does not introduce
;; enum gather IR. Keep a varying enum lane as the address of the gang's first
;; contiguous element; tag and payload vectors are assembled below from
;; active-lane-only scalar loads.
(define (lower-avx2-masked-enum-source
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [expr : AstExpr]) : ResultLowerMaskedEnumSource
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-avx2-masked-enum-source
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-avx2-masked-enum-source
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Cast inner-box _)
      (lower-avx2-masked-enum-source
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Var name)
      (if (lower-id-set-contains? lane-locals name)
        (match (tc-lookup-id type-env name)
          [(ResultTcType.Ok ty)
            (let
              [resolved : AstType
                (tc-type-without-regions (tc-resolve-type ctx ty))]
              (if (lower-spmd-enum-type? resolved)
                (let
                  [base-var : i64
                    (sym_i64_env.sym-i64-lookup-id-or
                      env
                      name
                      (compiler-symbols-missing-handle))]
                  (if (compiler-symbols-handle-found? base-var)
                    (ResultLowerMaskedEnumSource.Ok
                      (LowerMaskedEnumSource.Source
                        state
                        (CompilerIrValue.Var base-var)
                        resolved))
                    (ResultLowerMaskedEnumSource.Err
                      (box
                        (lower-diagnostic-at-expr
                          expr
                          "lower: varying enum source has no storage binding")))))
                ResultLowerMaskedEnumSource.No))]
          [(ResultTcType.Err message)
            (ResultLowerMaskedEnumSource.Err
              (box (lower-diagnostic-at-expr expr message)))])
        ResultLowerMaskedEnumSource.No)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        (match (lower-dynamic-array-var ctx env type-env arr)
          [(LowerMaybeArrayVar.Some array-var elem-ty)
            (let
              [resolved : AstType
                (tc-type-without-regions (tc-resolve-type ctx elem-ty))]
              (if (lower-spmd-enum-type? resolved)
                (match (lower-avx512-masked-index-value
                  ctx
                  state
                  index
                  index-var
                  idx)
                  [(ResultLowerExpr.Ok idx-lowered)
                    (match idx-lowered
                      [(LowerExpr.Expr idx-state idx-value _)
                        (match (lower-array-data-pointer-value
                          idx-state
                          (CompilerIrValue.Var array-var))
                          [(LowerExpr.Expr data-state data-ptr _)
                            (match (lower-emit-elem-addr-gep
                              ctx
                              data-state
                              data-ptr
                              idx-value
                              resolved)
                              [(LowerExpr.Expr base-state base _)
                                (ResultLowerMaskedEnumSource.Ok
                                  (LowerMaskedEnumSource.Source
                                    base-state
                                    base
                                    resolved))])])])]
                  [(ResultLowerExpr.Err message)
                    (ResultLowerMaskedEnumSource.Err message)])
                ResultLowerMaskedEnumSource.No))]
          [(LowerMaybeArrayVar.No) ResultLowerMaskedEnumSource.No]))]
    [_ ResultLowerMaskedEnumSource.No]))

(define (lower-avx512-masked-let-bindings
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [bindings : AstLetBindingList]) : ResultLowerEnv
  (lower-avx512-masked-let-bindings-at
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    (& bindings)
    0))

(define (lower-avx512-masked-let-bindings-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : ResultLowerEnv
  (if (>= binding-index (ast-let-binding-list-len bindings))
    (ResultLowerEnv.Ok state env type-env)
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          [enum-source : ResultLowerMaskedEnumSource
            (if (lower-mode-avx2? (lower-state-mode state))
              (lower-avx2-masked-enum-source
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                init)
              ResultLowerMaskedEnumSource.No)]
          (match enum-source
            [(ResultLowerMaskedEnumSource.Ok source)
              (match source
                [(LowerMaskedEnumSource.Source init-state init-value init-ty)
                  (let
                    [binding-ty : AstType
                      (lower-let-binding-type ctx maybe-ty init-ty)]
                    (match init-value
                      [(CompilerIrValue.Var init-var)
                        (lower-avx512-masked-let-bindings-at
                          ctx
                          init-state
                          (sym_i64_env.sym-i64-bind-id env name init-var)
                          (tc-bind-id type-env name binding-ty)
                          (lower-id-set-insert lane-locals name)
                          index
                          index-var
                          active-mask
                          lanes
                          bindings
                          (+ binding-index 1))]
                      [_
                        (ResultLowerEnv.Err
                          (box
                            (lower-diagnostic-at-expr
                              init
                              "lower: varying enum source did not produce an IR variable")))]))])]
            [(ResultLowerMaskedEnumSource.Err message)
              (ResultLowerEnv.Err message)]
            [(ResultLowerMaskedEnumSource.No)
              (match (lower-avx512-masked-expr
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                init)
                [(ResultLowerExpr.Ok lowered)
                  (match lowered
                    [(LowerExpr.Expr init-state init-value init-ty)
                      (let
                        [binding-ty : AstType
                          (lower-let-binding-type ctx maybe-ty init-ty)]
                        (match init-value
                          [(CompilerIrValue.Var init-var)
                            (lower-avx512-masked-let-bindings-at
                              ctx
                              init-state
                              (sym_i64_env.sym-i64-bind-id env name init-var)
                              (tc-bind-id type-env name binding-ty)
                              (lower-id-set-insert lane-locals name)
                              index
                              index-var
                              active-mask
                              lanes
                              bindings
                              (+ binding-index 1))]
                          [_
                            (ResultLowerEnv.Err
                              (box
                                (lower-diagnostic-at-expr
                                  init
                                  "lower: masked let init did not produce an IR variable")))]))])]
                [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])]))])))

(define (lower-avx512-masked-begin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [exprs : AstExprList]) : ResultLowerExpr
  (lower-avx512-masked-begin-at
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    (& exprs)
    0))

(define (lower-avx512-masked-begin-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [exprs : (& exprs AstExprList)]
  [expr-index : i64]) : ResultLowerExpr
  (if (>= expr-index (struct-get exprs len))
    (ResultLowerExpr.Ok
      (LowerExpr.Expr state CompilerIrValue.Unit (AstType.Unit)))
    (let
      [expr : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get exprs expr-index 0))]
      (match (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr next-state value ty)
              (if (= (+ expr-index 1) (struct-get exprs len))
                (ResultLowerExpr.Ok (LowerExpr.Expr next-state value ty))
                (lower-avx512-masked-begin-at
                  ctx
                  next-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lanes
                  exprs
                  (+ expr-index 1)))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))

(define (lower-avx512-masked-select-result-supported?
  [state : LowerState]
  [lanes : i64]
  [ty : AstType]) : bool
  (=
    (lower-simd-lanes-for-elem
      (lower-state-mode state)
      (tc-type-without-regions ty))
    lanes))

(define (lower-avx512-masked-while
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [cond : AstExpr]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc mask-alloc loop-mask-var)
      (let
        [s : LowerState
          (lower-state-emit
            mask-alloc
            (CompilerIrInstr.MaskBinOp
              loop-mask-var
              (CompilerIrMaskBinOp.Or)
              active-mask
              active-mask
              lanes))]
        [header-label : String ""]
        [body-label : String ""]
        [exit-label : String ""]
        [cond-active : CompilerIrValue CompilerIrValue.Unit]
        [any-active : CompilerIrValue CompilerIrValue.Unit]
        (begin
          (match (lower-state-fresh-label s "spmd_vwhile_header")
            [(LowerLabel.Label next-s label)
              (begin
                (set! s next-s)
                (set! header-label label))])
          (match (lower-state-fresh-label s "spmd_vwhile_body")
            [(LowerLabel.Label next-s label)
              (begin
                (set! s next-s)
                (set! body-label label))])
          (match (lower-state-fresh-label s "spmd_vwhile_exit")
            [(LowerLabel.Label next-s label)
              (begin
                (set! s next-s)
                (set! exit-label label))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit s (CompilerIrInstr.Jump header-label))
              header-label))
          (match (lower-avx512-masked-expr
            ctx
            s
            env
            type-env
            lane-locals
            index
            index-var
            (CompilerIrValue.Var loop-mask-var)
            lanes
            cond)
            [(ResultLowerExpr.Ok cond-lowered)
              (match cond-lowered
                [(LowerExpr.Expr cond-state cond-mask _)
                  (begin
                    (match (lower-emit-mask-binop
                      cond-state
                      (CompilerIrMaskBinOp.And)
                      (CompilerIrValue.Var loop-mask-var)
                      cond-mask
                      lanes)
                      [(LowerExpr.Expr next-s value _)
                        (begin
                          (set! s next-s)
                          (set! cond-active value))])
                    (match (lower-emit-mask-reduce
                      s
                      (CompilerIrMaskReduceOp.Any)
                      cond-active
                      lanes)
                      [(LowerExpr.Expr next-s value _)
                        (begin
                          (set! s next-s)
                          (set! any-active value))]))])]
            [(ResultLowerExpr.Err message)
              (return (ResultLowerExpr.Err message))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit
                s
                (CompilerIrInstr.Branch any-active body-label exit-label))
              body-label))
          (match (lower-avx512-masked-expr-expected
            ctx
            s
            env
            type-env
            lane-locals
            index
            index-var
            cond-active
            lanes
            body
            (AstType.Unit))
            [(ResultLowerExpr.Ok body-lowered)
              (match body-lowered
                [(LowerExpr.Expr body-state _ _)
                  (set!
                    s
                    (lower-state-emit
                      body-state
                      (CompilerIrInstr.MaskBinOp
                        loop-mask-var
                        (CompilerIrMaskBinOp.Or)
                        cond-active
                        cond-active
                        lanes)))])]
            [(ResultLowerExpr.Err message)
              (return (ResultLowerExpr.Err message))])
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-state-finish-block
                (lower-state-emit s (CompilerIrInstr.Jump header-label))
                exit-label)
              CompilerIrValue.Unit
              (AstType.Unit)))))]))

(define (lower-avx512-masked-if
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [cond : AstExpr]
  [then-branch : AstExpr]
  [else-branch : AstExpr]) : ResultLowerExpr
  (match (lower-avx512-masked-expr
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    cond)
    [(ResultLowerExpr.Ok cond-lowered)
      (match cond-lowered
        [(LowerExpr.Expr cond-state cond-mask _)
          (match (lower-emit-mask-binop
            cond-state
            (CompilerIrMaskBinOp.And)
            active-mask
            cond-mask
            lanes)
            [(LowerExpr.Expr then-mask-state then-mask _)
              (match (lower-emit-mask-not then-mask-state cond-mask lanes)
                [(LowerExpr.Expr not-state not-mask _)
                  (match (lower-emit-mask-binop
                    not-state
                    (CompilerIrMaskBinOp.And)
                    active-mask
                    not-mask
                    lanes)
                    [(LowerExpr.Expr else-mask-state else-mask _)
                      (match (lower-avx512-masked-expr-expected
                        ctx
                        else-mask-state
                        env
                        type-env
                        lane-locals
                        index
                        index-var
                        then-mask
                        lanes
                        then-branch
                        result-ty)
                        [(ResultLowerExpr.Ok then-lowered)
                          (match then-lowered
                            [(LowerExpr.Expr then-state then-value then-ty)
                              (match (lower-avx512-masked-expr-expected
                                ctx
                                then-state
                                env
                                type-env
                                lane-locals
                                index
                                index-var
                                else-mask
                                lanes
                                else-branch
                                result-ty)
                                [(ResultLowerExpr.Ok else-lowered)
                                  (match else-lowered
                                    [(LowerExpr.Expr
                                        else-state
                                        else-value
                                        else-ty)
                                      (match then-ty
                                        [(AstType.Unit)
                                          (ResultLowerExpr.Ok
                                            (LowerExpr.Expr
                                              else-state
                                              CompilerIrValue.Unit
                                              (AstType.Unit)))]
                                        [_
                                          (if (and
                                            (ast-type-eq? then-ty else-ty)
                                            (lower-type-bool? then-ty))
                                            (ResultLowerExpr.Ok
                                              (lower-emit-mask-select
                                                else-state
                                                then-mask
                                                then-value
                                                else-mask
                                                else-value
                                                lanes))
                                            (if (and
                                              (ast-type-eq? then-ty else-ty)
                                              (lower-avx512-masked-select-result-supported?
                                                else-state
                                                lanes
                                                then-ty))
                                              (ResultLowerExpr.Ok
                                                (lower-emit-select
                                                  else-state
                                                  then-mask
                                                  then-value
                                                  else-value
                                                  lanes
                                                  then-ty))
                                              (lower-avx512-masked-unsupported
                                                expr
                                                "this value-producing masked if result type")))])])]
                                [(ResultLowerExpr.Err message)
                                  (ResultLowerExpr.Err message)])])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])])])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-avx2-masked-index-mod
  [state : LowerState]
  [index-var : i64]
  [index-offset : i64]
  [lanes : i64]
  [divisor : i64]) : ResultLowerExpr
  (let
    [s : LowerState state]
    [lane-id : CompilerIrValue CompilerIrValue.Unit]
    [result : CompilerIrValue CompilerIrValue.Unit]
    [lane : i64 0]
    (begin
      (match (lower-emit-lane-id s lanes (AstType.I64))
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! lane-id value))])
      (match (lower-emit-splat s (CompilerIrValue.I64 0) lanes (AstType.I64))
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! result value))])
      (while (< lane lanes)
        (let
          [one-lane : CompilerIrValue CompilerIrValue.Unit]
          [lane-value : CompilerIrValue CompilerIrValue.Unit]
          [lane-remainder : CompilerIrValue CompilerIrValue.Unit]
          (begin
            (match (lower-emit-splat
              s
              (CompilerIrValue.I64 lane)
              lanes
              (AstType.I64))
              [(LowerExpr.Expr lane-state lane-splat _)
                (match (lower-emit-vector-compare
                  lane-state
                  (CompilerIrBinOp.Eq)
                  lane-id
                  lane-splat
                  lanes
                  (AstType.I64))
                  [(LowerExpr.Expr next-state value _)
                    (begin
                      (set! s next-state)
                      (set! one-lane value))])])
            (match (lower-emit-binop
              s
              (CompilerIrBinOp.Add)
              (CompilerIrValue.Var index-var)
              (CompilerIrValue.I64 (+ index-offset lane))
              (AstType.I64))
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-value value))])
            (match (lower-emit-binop
              s
              (CompilerIrBinOp.Mod)
              lane-value
              (CompilerIrValue.I64 divisor)
              (AstType.I64))
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-remainder value))])
            (match (lower-emit-splat s lane-remainder lanes (AstType.I64))
              [(LowerExpr.Expr splat-state lane-vector _)
                (match (lower-emit-select
                  splat-state
                  one-lane
                  lane-vector
                  result
                  lanes
                  (AstType.I64))
                  [(LowerExpr.Expr next-state value _)
                    (begin
                      (set! s next-state)
                      (set! result value))])])
            (set! lane (+ lane 1)))))
      (ResultLowerExpr.Ok (LowerExpr.Expr s result (AstType.I64))))))

(define (lower-avx512-masked-vector-binop
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [op : CompilerIrBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    expr)
    [(ResultTcType.Ok result-ty)
      (let
        [lane-ty : AstType (tc-type-without-regions result-ty)]
        (match (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          left
          lane-ty)
          [(ResultLowerExpr.Ok left-lowered)
            (match left-lowered
              [(LowerExpr.Expr left-state left-value _)
                (match (lower-avx512-masked-expr-expected
                  ctx
                  left-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lanes
                  right
                  lane-ty)
                  [(ResultLowerExpr.Ok right-lowered)
                    (match right-lowered
                      [(LowerExpr.Expr right-state right-value _)
                        (ResultLowerExpr.Ok
                          (lower-emit-vector-binop
                            right-state
                            op
                            left-value
                            right-value
                            lanes
                            lane-ty))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-masked-shift-op-name [op : AstBinOp]) : String
  (match op
    [(AstBinOp.Shl) "shl"]
    [(AstBinOp.Shr) "shr"]
    [_ "unknown"]))

(define (lower-masked-shift-mode-name [mode : CompilerLowerMode]) : String
  (if (lower-mode-avx2? mode)
    "AVX2"
    "AVX-512"))

(define (lower-masked-shift-lane-supported? [ty : AstType]) : bool
  (match ty
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I64) true]
    [(AstType.U64) true]
    [_ false]))

(define (lower-masked-shift-width [ty : AstType]) : i64
  (match ty
    [(AstType.I32) 32]
    [(AstType.U32) 32]
    [(AstType.I64) 64]
    [(AstType.U64) 64]
    [_ 0]))

(define (lower-masked-shift-unsupported
  [state : LowerState]
  [expr : AstExpr]
  [op : AstBinOp]
  [lane-ty : AstType]) : ResultLowerExpr
  (lower-avx512-masked-unsupported
    expr
    (str_cat.str-cat
      "masked shift '"
      (lower-masked-shift-op-name op)
      "' for lane type "
      (tc-type-render lane-ty)
      " in "
      (lower-masked-shift-mode-name (lower-state-mode state))
      " backend mode; supported lane types are i32, u32, i64, and u64")))

(define (lower-avx512-masked-shift-guard-and-emit
  [state : LowerState]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [op : CompilerIrBinOp]
  [left-value : CompilerIrValue]
  [right-value : CompilerIrValue]
  [lane-ty : AstType]
  [count-ty : AstType]) : ResultLowerExpr
  (let
    [s : LowerState state]
    [zero : CompilerIrValue CompilerIrValue.Unit]
    [width : CompilerIrValue CompilerIrValue.Unit]
    [negative : CompilerIrValue CompilerIrValue.Unit]
    [too-large : CompilerIrValue CompilerIrValue.Unit]
    [invalid : CompilerIrValue CompilerIrValue.Unit]
    [active-invalid : CompilerIrValue CompilerIrValue.Unit]
    [any-invalid : CompilerIrValue CompilerIrValue.Unit]
    [abort-label : String ""]
    [continue-label : String ""]
    (begin
      (match (lower-emit-splat s (CompilerIrValue.I64 0) lanes count-ty)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! zero value))])
      (match (lower-emit-splat
        s
        (CompilerIrValue.I64 (lower-masked-shift-width lane-ty))
        lanes
        count-ty)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! width value))])
      (match (if (lower-type-signed? count-ty)
        (lower-emit-vector-compare
          s
          (CompilerIrBinOp.Lt)
          right-value
          zero
          lanes
          count-ty)
        ;; Unsigned counts cannot be negative. Materialize an all-false mask
        ;; without relying on the backend's signed/unsigned compare expansion.
        (lower-emit-vector-compare
          s
          (CompilerIrBinOp.Ne)
          zero
          zero
          lanes
          count-ty))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! negative value))])
      (match (lower-emit-vector-compare
        s
        (CompilerIrBinOp.Ge)
        right-value
        width
        lanes
        count-ty)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! too-large value))])
      (match (lower-emit-mask-binop
        s
        (CompilerIrMaskBinOp.Or)
        negative
        too-large
        lanes)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! invalid value))])
      (match (lower-emit-mask-binop
        s
        (CompilerIrMaskBinOp.And)
        invalid
        active-mask
        lanes)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! active-invalid value))])
      (match (lower-emit-mask-reduce
        s
        (CompilerIrMaskReduceOp.Any)
        active-invalid
        lanes)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! any-invalid value))])
      (match (lower-state-fresh-label s "spmd_shift_abort")
        [(LowerLabel.Label next-s label)
          (begin
            (set! s next-s)
            (set! abort-label label))])
      (match (lower-state-fresh-label s "spmd_shift_continue")
        [(LowerLabel.Label next-s label)
          (begin
            (set! s next-s)
            (set! continue-label label))])
      (set!
        s
        (lower-state-finish-block
          (lower-state-emit
            s
            (CompilerIrInstr.Branch any-invalid abort-label continue-label))
          abort-label))
      (set!
        s
        (lower-state-finish-block
          (lower-state-emit
            (lower-shift-abort s)
            (CompilerIrInstr.Jump continue-label))
          continue-label))
      (ResultLowerExpr.Ok
        (lower-emit-vector-binop s op left-value right-value lanes lane-ty)))))

(define (lower-avx512-masked-shift
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [ast-op : AstBinOp]
  [ir-op : CompilerIrBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    expr)
    [(ResultTcType.Ok result-ty)
      (let
        [lane-ty : AstType (tc-type-without-regions result-ty)]
        (if (not (lower-masked-shift-lane-supported? lane-ty))
          (lower-masked-shift-unsupported state expr ast-op lane-ty)
          (match (lower-avx512-masked-expr-expected
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            left
            lane-ty)
            [(ResultLowerExpr.Ok left-lowered)
              (match left-lowered
                [(LowerExpr.Expr left-state left-value _)
                  (match (lower-avx512-masked-expr-expected
                    ctx
                    left-state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    right
                    lane-ty)
                    [(ResultLowerExpr.Ok right-lowered)
                      (match right-lowered
                        [(LowerExpr.Expr right-state right-value right-ty)
                          (let
                            [count-ty : AstType
                              (tc-type-without-regions right-ty)]
                            (if (and
                              (tc-integer-type? count-ty)
                              (=
                                (lower-simd-lanes-for-elem
                                  (lower-state-mode state)
                                  count-ty)
                                lanes))
                              (lower-avx512-masked-shift-guard-and-emit
                                right-state
                                active-mask
                                lanes
                                ir-op
                                left-value
                                right-value
                                lane-ty
                                count-ty)
                              (lower-avx512-masked-unsupported
                                expr
                                (str_cat.str-cat
                                  "masked shift '"
                                  (lower-masked-shift-op-name ast-op)
                                  "' count lane type "
                                  (tc-type-render count-ty)
                                  "; the count must have the same SIMD lane width as "
                                  (tc-type-render lane-ty)))))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-avx512-masked-binary
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultLowerExpr
  (match op
    [(AstBinOp.And)
      (match (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        left)
        [(ResultLowerExpr.Ok left-lowered)
          (match left-lowered
            [(LowerExpr.Expr left-state left-value _)
              (match (lower-avx512-masked-expr
                ctx
                left-state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                right)
                [(ResultLowerExpr.Ok right-lowered)
                  (match right-lowered
                    [(LowerExpr.Expr right-state right-value _)
                      (ResultLowerExpr.Ok
                        (lower-emit-mask-binop
                          right-state
                          (CompilerIrMaskBinOp.And)
                          left-value
                          right-value
                          lanes))])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(AstBinOp.Or)
      (match (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        left)
        [(ResultLowerExpr.Ok left-lowered)
          (match left-lowered
            [(LowerExpr.Expr left-state left-value _)
              (match (lower-avx512-masked-expr
                ctx
                left-state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                right)
                [(ResultLowerExpr.Ok right-lowered)
                  (match right-lowered
                    [(LowerExpr.Expr right-state right-value _)
                      (ResultLowerExpr.Ok
                        (lower-emit-mask-binop
                          right-state
                          (CompilerIrMaskBinOp.Or)
                          left-value
                          right-value
                          lanes))])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(AstBinOp.Add)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Add)
        left
        right)]
    [(AstBinOp.Sub)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Sub)
        left
        right)]
    [(AstBinOp.Shl)
      (lower-avx512-masked-shift
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        op
        (CompilerIrBinOp.Shl)
        left
        right)]
    [(AstBinOp.Shr)
      (lower-avx512-masked-shift
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        op
        (CompilerIrBinOp.Shr)
        left
        right)]
    [(AstBinOp.BitAnd)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.BitAnd)
        left
        right)]
    [(AstBinOp.BitOr)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.BitOr)
        left
        right)]
    [(AstBinOp.BitXor)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.BitXor)
        left
        right)]
    [(AstBinOp.Mul)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Mul)
        left
        right)]
    [(AstBinOp.Mod)
      (let
        [divisor : i64
          (lower-masked-vector-positive-power-two-literal ctx right)]
        [positive-divisor : i64
          (lower-masked-vector-index-literal-offset ctx right)]
        [index-offset : i64 (lower-masked-vector-index-offset ctx index left)]
        (if (and
          (lower-mode-avx2? (lower-state-mode state))
          (> positive-divisor 0)
          (>= index-offset 0)
          (=
            lanes
            (lower-simd-lanes-for-elem (lower-state-mode state) (AstType.I64))))
          (lower-avx2-masked-index-mod
            state
            index-var
            index-offset
            lanes
            positive-divisor)
          (if (and (> divisor 0) (>= index-offset 0))
            (match (lower-avx512-masked-expr
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              left)
              [(ResultLowerExpr.Ok left-lowered)
                (match left-lowered
                  [(LowerExpr.Expr left-state left-value left-ty)
                    (match (lower-emit-splat
                      left-state
                      (CompilerIrValue.I64 (- divisor 1))
                      lanes
                      left-ty)
                      [(LowerExpr.Expr rhs-state rhs-value _)
                        (ResultLowerExpr.Ok
                          (lower-emit-vector-binop
                            rhs-state
                            (CompilerIrBinOp.BitAnd)
                            left-value
                            rhs-value
                            lanes
                            left-ty))])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (lower-avx512-masked-unsupported expr "this binary operator"))))]
    [(AstBinOp.Eq)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Eq)
        left
        right)]
    [(AstBinOp.Ne)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Ne)
        left
        right)]
    [(AstBinOp.Lt)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Lt)
        left
        right)]
    [(AstBinOp.Le)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Le)
        left
        right)]
    [(AstBinOp.Gt)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Gt)
        left
        right)]
    [(AstBinOp.Ge)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (CompilerIrBinOp.Ge)
        left
        right)]
    [_ (lower-avx512-masked-unsupported expr "this binary operator")]))

(define (lower-avx512-masked-compare
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [_expr : AstExpr]
  [op : CompilerIrBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultLowerExpr
  (match (lower-avx512-masked-expr
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    left)
    [(ResultLowerExpr.Ok left-lowered)
      (match left-lowered
        [(LowerExpr.Expr left-state left-value left-ty)
          (match (lower-avx512-masked-expr-expected
            ctx
            left-state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            right
            left-ty)
            [(ResultLowerExpr.Ok right-lowered)
              (match right-lowered
                [(LowerExpr.Expr right-state right-value _)
                  (ResultLowerExpr.Ok
                    (lower-emit-vector-compare
                      right-state
                      op
                      left-value
                      right-value
                      lanes
                      left-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-avx2-enum-mask-lane-type [lanes : i64]) : AstType
  (cond
    [(= lanes 4) (AstType.I64)]
    [(= lanes 8) (AstType.I32)]
    [(= lanes 16) (AstType.I16)]
    [else (AstType.I8)]))

(define (lower-avx2-enum-zero-value [ty : AstType]) : CompilerIrValue
  (match (tc-type-without-regions ty)
    [(AstType.F64) (CompilerIrValue.F64 (cast 0 : u64))]
    [(AstType.F32) (CompilerIrValue.F64 (cast 0 : u64))]
    [(AstType.Bool) (CompilerIrValue.Bool false)]
    [_ (CompilerIrValue.I64 0)]))

(define (lower-avx2-enum-zero-mask
  [state : LowerState]
  [lane-id : CompilerIrValue]
  [lanes : i64]
  [lane-ty : AstType]) : LowerExpr
  (lower-emit-vector-compare
    state
    (CompilerIrBinOp.Ne)
    lane-id
    lane-id
    lanes
    lane-ty))

(define (lower-avx2-enum-one-lane-mask
  [state : LowerState]
  [lane-id : CompilerIrValue]
  [lane : i64]
  [lanes : i64]
  [lane-ty : AstType]) : LowerExpr
  (match (lower-emit-splat state (CompilerIrValue.I64 lane) lanes lane-ty)
    [(LowerExpr.Expr lane-state lane-value _)
      (lower-emit-vector-compare
        lane-state
        (CompilerIrBinOp.Eq)
        lane-id
        lane-value
        lanes
        lane-ty)]))

;; Guard the load in scalar control flow. This is required for both masked arms
;; and the final partial gang: inactive lanes must not touch enum storage.
(define (lower-avx2-enum-load-active-lane
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [active : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc slot-state slot-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          slot-state
          (CompilerIrInstr.Mov slot-var (lower-avx2-enum-zero-value ty) ty))
        "spmd_match_lane_load")
        [(LowerLabel.Label load-label-state load-label)
          (match (lower-state-fresh-label
            load-label-state
            "spmd_match_lane_join")
            [(LowerLabel.Label join-label-state join-label)
              (let
                [load-state : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      join-label-state
                      (CompilerIrInstr.Branch active load-label join-label))
                    load-label)]
                (match (lower-load-at-offset load-state base offset ty)
                  [(LowerExpr.Expr loaded-state loaded _)
                    (LowerExpr.Expr
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            loaded-state
                            (CompilerIrInstr.Mov slot-var loaded ty))
                          (CompilerIrInstr.Jump join-label))
                        join-label)
                      (CompilerIrValue.Var slot-var)
                      ty)]))])])]))

(define (lower-avx2-enum-scalar-bool-lane-mask
  [state : LowerState]
  [condition : CompilerIrValue]
  [one-lane-mask : CompilerIrValue]
  [lanes : i64]
  [lane-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc word-state word-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          word-state
          (CompilerIrInstr.Mov word-var (CompilerIrValue.I64 0) lane-ty))
        "spmd_match_lane_true")
        [(LowerLabel.Label true-label-state true-label)
          (match (lower-state-fresh-label
            true-label-state
            "spmd_match_lane_bool")
            [(LowerLabel.Label join-label-state join-label)
              (let
                [true-state : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      join-label-state
                      (CompilerIrInstr.Branch condition true-label join-label))
                    true-label)]
                (match (lower-emit-splat
                  (lower-state-finish-block
                    (lower-state-emit
                      (lower-state-emit
                        true-state
                        (CompilerIrInstr.Mov
                          word-var
                          (CompilerIrValue.I64 -1)
                          lane-ty))
                      (CompilerIrInstr.Jump join-label))
                    join-label)
                  (CompilerIrValue.Var word-var)
                  lanes
                  lane-ty)
                  [(LowerExpr.Expr splat-state splat-value _)
                    (lower-emit-mask-binop
                      splat-state
                      (CompilerIrMaskBinOp.And)
                      one-lane-mask
                      splat-value
                      lanes)]))])])]))

;; Reconstruct one payload field as a varying vector without adding a gather
;; opcode: load each active lane and select its splat into a one-lane mask.
(define (lower-avx2-enum-field-vector
  [state : LowerState]
  [base : CompilerIrValue]
  [stride : i64]
  [field-offset : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [field-ty : AstType]) : LowerExpr
  (let
    [s : LowerState state]
    [lane-ty : AstType (lower-avx2-enum-mask-lane-type lanes)]
    [lane-id : CompilerIrValue CompilerIrValue.Unit]
    [result : CompilerIrValue CompilerIrValue.Unit]
    [lane : i64 0]
    (begin
      (match (lower-emit-lane-id s lanes lane-ty)
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! lane-id value))])
      (match (if (lower-type-bool? field-ty)
        (lower-avx2-enum-zero-mask s lane-id lanes lane-ty)
        (lower-emit-splat
          s
          (lower-avx2-enum-zero-value field-ty)
          lanes
          field-ty))
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! result value))])
      (while (< lane lanes)
        (let
          [one-lane : CompilerIrValue CompilerIrValue.Unit]
          [lane-active-mask : CompilerIrValue CompilerIrValue.Unit]
          [lane-active : CompilerIrValue CompilerIrValue.Unit]
          [loaded : CompilerIrValue CompilerIrValue.Unit]
          (begin
            (match (lower-avx2-enum-one-lane-mask s lane-id lane lanes lane-ty)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! one-lane value))])
            (match (lower-emit-mask-binop
              s
              (CompilerIrMaskBinOp.And)
              active-mask
              one-lane
              lanes)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-active-mask value))])
            (match (lower-emit-mask-reduce
              s
              (CompilerIrMaskReduceOp.Any)
              lane-active-mask
              lanes)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-active value))])
            (match (lower-avx2-enum-load-active-lane
              s
              base
              (+ field-offset (* lane stride))
              lane-active
              field-ty)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! loaded value))])
            (if (lower-type-bool? field-ty)
              (match (lower-avx2-enum-scalar-bool-lane-mask
                s
                loaded
                one-lane
                lanes
                lane-ty)
                [(LowerExpr.Expr lane-state lane-value _)
                  (match (lower-emit-mask-binop
                    lane-state
                    (CompilerIrMaskBinOp.Or)
                    result
                    lane-value
                    lanes)
                    [(LowerExpr.Expr next-state value _)
                      (begin
                        (set! s next-state)
                        (set! result value))])])
              (match (lower-emit-splat s loaded lanes field-ty)
                [(LowerExpr.Expr lane-state lane-value _)
                  (match (lower-emit-select
                    lane-state
                    one-lane
                    lane-value
                    result
                    lanes
                    field-ty)
                    [(LowerExpr.Expr next-state value _)
                      (begin
                        (set! s next-state)
                        (set! result value))])]))
            (set! lane (+ lane 1)))))
      (LowerExpr.Expr s result field-ty))))

(define (lower-avx2-enum-tag-arm-masks
  [state : LowerState]
  [base : CompilerIrValue]
  [stride : i64]
  [active-mask : CompilerIrValue]
  [lane-id : CompilerIrValue]
  [lanes : i64]
  [lane-ty : AstType]
  [tag : i64]) : ResultLowerMaskedMatchMasks
  (let
    [s : LowerState state]
    [arm-mask : CompilerIrValue CompilerIrValue.Unit]
    [lane : i64 0]
    (begin
      (match (lower-avx2-enum-zero-mask s lane-id lanes lane-ty)
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! arm-mask value))])
      (while (< lane lanes)
        (let
          [one-lane : CompilerIrValue CompilerIrValue.Unit]
          [lane-active-mask : CompilerIrValue CompilerIrValue.Unit]
          [lane-active : CompilerIrValue CompilerIrValue.Unit]
          [loaded-tag : CompilerIrValue CompilerIrValue.Unit]
          [tag-eq : CompilerIrValue CompilerIrValue.Unit]
          (begin
            (match (lower-avx2-enum-one-lane-mask s lane-id lane lanes lane-ty)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! one-lane value))])
            (match (lower-emit-mask-binop
              s
              (CompilerIrMaskBinOp.And)
              active-mask
              one-lane
              lanes)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-active-mask value))])
            (match (lower-emit-mask-reduce
              s
              (CompilerIrMaskReduceOp.Any)
              lane-active-mask
              lanes)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-active value))])
            (match (lower-avx2-enum-load-active-lane
              s
              base
              (* lane stride)
              lane-active
              (AstType.I64))
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! loaded-tag value))])
            (match (lower-emit-binop
              s
              (CompilerIrBinOp.Eq)
              loaded-tag
              (CompilerIrValue.I64 tag)
              (AstType.I64))
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! tag-eq value))])
            (match (lower-avx2-enum-scalar-bool-lane-mask
              s
              tag-eq
              one-lane
              lanes
              lane-ty)
              [(LowerExpr.Expr lane-state lane-match _)
                (match (lower-emit-mask-binop
                  lane-state
                  (CompilerIrMaskBinOp.Or)
                  arm-mask
                  lane-match
                  lanes)
                  [(LowerExpr.Expr next-state value _)
                    (begin
                      (set! s next-state)
                      (set! arm-mask value))])])
            (set! lane (+ lane 1)))))
      (match (lower-emit-mask-binop
        s
        (CompilerIrMaskBinOp.And)
        active-mask
        arm-mask
        lanes)
        [(LowerExpr.Expr active-arm-state active-arm-mask _)
          (match (lower-emit-mask-not active-arm-state active-arm-mask lanes)
            [(LowerExpr.Expr not-state not-mask _)
              (match (lower-emit-mask-binop
                not-state
                (CompilerIrMaskBinOp.And)
                active-mask
                not-mask
                lanes)
                [(LowerExpr.Expr rest-state rest-mask _)
                  (ResultLowerMaskedMatchMasks.Ok
                    (LowerMaskedMatchMasks.Masks
                      rest-state
                      active-arm-mask
                      rest-mask))])])]))))

(define (lower-avx2-enum-final-arm-masks
  [state : LowerState]
  [active-mask : CompilerIrValue]
  [lane-id : CompilerIrValue]
  [lanes : i64]
  [lane-ty : AstType]) : ResultLowerMaskedMatchMasks
  (match (lower-avx2-enum-zero-mask state lane-id lanes lane-ty)
    [(LowerExpr.Expr next-state zero-mask _)
      (ResultLowerMaskedMatchMasks.Ok
        (LowerMaskedMatchMasks.Masks next-state active-mask zero-mask))]))

(define (lower-avx2-enum-pattern-arm-masks
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [enum-ty : AstType]
  [active-mask : CompilerIrValue]
  [lane-id : CompilerIrValue]
  [lanes : i64]
  [lane-ty : AstType]
  [pattern : AstPattern]
  [final? : bool]
  [expr : AstExpr]) : ResultLowerMaskedMatchMasks
  (if final?
    (lower-avx2-enum-final-arm-masks state active-mask lane-id lanes lane-ty)
    (match pattern
      [(AstPattern.Binding name)
        (let
          [handle : i64
            (lower-variant-handle-for-scrut-id-or
              ctx
              enum-ty
              name
              (compiler-symbols-missing-handle))]
          (if (compiler-symbols-handle-found? handle)
            (lower-avx2-enum-tag-arm-masks
              state
              base
              (lower-type-size ctx enum-ty)
              active-mask
              lane-id
              lanes
              lane-ty
              (compiler-registry-handle-child-index handle))
            (ResultLowerMaskedMatchMasks.Err
              (box
                (lower-diagnostic-at-expr
                  expr
                  "lower: varying enum pattern has no registered variant")))))]
      [(AstPattern.Variant name _)
        (let
          [handle : i64
            (lower-variant-handle-for-scrut-id-or
              ctx
              enum-ty
              name
              (compiler-symbols-missing-handle))]
          (if (compiler-symbols-handle-found? handle)
            (lower-avx2-enum-tag-arm-masks
              state
              base
              (lower-type-size ctx enum-ty)
              active-mask
              lane-id
              lanes
              lane-ty
              (compiler-registry-handle-child-index handle))
            (ResultLowerMaskedMatchMasks.Err
              (box
                (lower-diagnostic-at-expr
                  expr
                  "lower: varying enum pattern has no registered variant")))))]
      [(AstPattern.Wildcard)
        (lower-avx2-enum-final-arm-masks
          state
          active-mask
          lane-id
          lanes
          lane-ty)]
      [_
        (ResultLowerMaskedMatchMasks.Err
          (box
            (lower-diagnostic-at-expr
              expr
              "lower: unsupported AVX2 varying enum match pattern")))])))

(define (lower-avx2-enum-bind-payloads
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [base : CompilerIrValue]
  [enum-ty : AstType]
  [variant-name-id : i64]
  [patterns : AstPatternList]
  [fields : AstTypeList]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [pattern-index : i64]
  [cursor : i64]
  [expr : AstExpr]) : ResultLowerMaskedEnumEnv
  (if (>= pattern-index (struct-get (& patterns) len))
    (if (>= pattern-index (ast-type-list-len (& fields)))
      (ResultLowerMaskedEnumEnv.Ok state env type-env lane-locals)
      (ResultLowerMaskedEnumEnv.Err
        (box
          (lower-diagnostic-at-expr
            expr
            "lower: varying enum payload pattern arity mismatch"))))
    (if (>= pattern-index (ast-type-list-len (& fields)))
      (ResultLowerMaskedEnumEnv.Err
        (box
          (lower-diagnostic-at-expr
            expr
            "lower: varying enum payload pattern arity mismatch")))
      (let
        [pattern : AstPattern
          (ast-pattern-list-get
            (& patterns)
            pattern-index
            (ast-pattern-fallback))]
        [field-node : i64
          (ast-type-list-get (& fields) pattern-index (ast-type-id-fallback))]
        [field-ty : AstType
          (tc-type-without-regions
            (tc-resolve-type ctx (tc-context-type-get ctx field-node)))]
        [default-offset : i64
          (lower-align-up cursor (lower-type-align ctx field-ty))]
        [enum-id : i64 (lower-enum-type-name-id-or enum-ty -1)]
        [enum-name : String (lower-enum-type-name-or-empty enum-ty)]
        [variant-name : String (tc-env-key-name-text variant-name-id)]
        [field-offset : i64
          (lower-variant-payload-offset
            ctx
            (lower-state-mode state)
            enum-id
            enum-name
            variant-name
            variant-name-id
            pattern-index
            cursor
            field-ty)]
        [next-cursor : i64 (+ default-offset (lower-type-size ctx field-ty))]
        (if (< field-offset 0)
          (ResultLowerMaskedEnumEnv.Err
            (box
              (lower-diagnostic-at-expr
                expr
                "lower: varying enum payload layout is unavailable")))
          (match pattern
            [(AstPattern.Wildcard)
              (lower-avx2-enum-bind-payloads
                ctx
                state
                env
                type-env
                lane-locals
                base
                enum-ty
                variant-name-id
                patterns
                fields
                active-mask
                lanes
                (+ pattern-index 1)
                next-cursor
                expr)]
            [(AstPattern.Binding name)
              (match (lower-avx2-enum-field-vector
                state
                base
                (lower-type-size ctx enum-ty)
                field-offset
                active-mask
                lanes
                field-ty)
                [(LowerExpr.Expr next-state value _)
                  (match value
                    [(CompilerIrValue.Var field-var)
                      (lower-avx2-enum-bind-payloads
                        ctx
                        next-state
                        (sym_i64_env.sym-i64-bind-id env name field-var)
                        (tc-bind-id type-env name field-ty)
                        (lower-id-set-insert lane-locals name)
                        base
                        enum-ty
                        variant-name-id
                        patterns
                        fields
                        active-mask
                        lanes
                        (+ pattern-index 1)
                        next-cursor
                        expr)]
                    [_
                      (ResultLowerMaskedEnumEnv.Err
                        (box
                          (lower-diagnostic-at-expr
                            expr
                            "lower: varying enum payload did not produce an IR variable")))])])]
            [(AstPattern.Var name _)
              (match (lower-avx2-enum-field-vector
                state
                base
                (lower-type-size ctx enum-ty)
                field-offset
                active-mask
                lanes
                field-ty)
                [(LowerExpr.Expr next-state value _)
                  (match value
                    [(CompilerIrValue.Var field-var)
                      (lower-avx2-enum-bind-payloads
                        ctx
                        next-state
                        (sym_i64_env.sym-i64-bind-id env name field-var)
                        (tc-bind-id type-env name field-ty)
                        (lower-id-set-insert lane-locals name)
                        base
                        enum-ty
                        variant-name-id
                        patterns
                        fields
                        active-mask
                        lanes
                        (+ pattern-index 1)
                        next-cursor
                        expr)]
                    [_
                      (ResultLowerMaskedEnumEnv.Err
                        (box
                          (lower-diagnostic-at-expr
                            expr
                            "lower: varying enum payload did not produce an IR variable")))])])]
            [_
              (ResultLowerMaskedEnumEnv.Err
                (box
                  (lower-diagnostic-at-expr
                    expr
                    "lower: AVX2 varying enum payload patterns support bindings and wildcards")))]))))))

(define (lower-avx2-enum-bind-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [base : CompilerIrValue]
  [enum-ty : AstType]
  [pattern : AstPattern]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]) : ResultLowerMaskedEnumEnv
  (match pattern
    [(AstPattern.Binding _)
      (ResultLowerMaskedEnumEnv.Ok state env type-env lane-locals)]
    [(AstPattern.Variant name patterns-box)
      (let
        [handle : i64
          (lower-variant-handle-for-scrut-id-or
            ctx
            enum-ty
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-registries-variant-fields-indexed
            (tc-context-symbols ctx)
            handle)
            [(ResultAstTypeList.Ok raw-fields)
              (let
                [variant-name-id : i64
                  (lower-variant-handle-name-id-or ctx handle name)]
                [fields : AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    enum-ty
                    raw-fields)]
                (lower-avx2-enum-bind-payloads
                  ctx
                  state
                  env
                  type-env
                  lane-locals
                  base
                  enum-ty
                  variant-name-id
                  (box-get patterns-box)
                  fields
                  active-mask
                  lanes
                  0
                  8
                  expr))]
            [(ResultAstTypeList.Err message)
              (ResultLowerMaskedEnumEnv.Err
                (box (lower-diagnostic-at-expr expr message)))])
          (ResultLowerMaskedEnumEnv.Err
            (box
              (lower-diagnostic-at-expr
                expr
                "lower: varying enum pattern has no registered variant")))))]
    [(AstPattern.Wildcard)
      (ResultLowerMaskedEnumEnv.Ok state env type-env lane-locals)]
    [_
      (ResultLowerMaskedEnumEnv.Err
        (box
          (lower-diagnostic-at-expr
            expr
            "lower: unsupported AVX2 varying enum match pattern")))]))

(define (lower-avx2-enum-match-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lane-id : CompilerIrValue]
  [lanes : i64]
  [lane-ty : AstType]
  [result-ty : AstType]
  [expr : AstExpr]
  [base : CompilerIrValue]
  [enum-ty : AstType]
  [arms : AstMatchArmList]) : ResultLowerExpr
  (if (ast-match-arm-list-empty? (& arms))
    (lower-avx512-masked-unsupported
      expr
      "AVX2 varying enum match with no arms")
    (match (ast-match-arm-list-get (& arms) 0 (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [rest : AstMatchArmList (ast-match-arm-list-tail arms)]
          [final? : bool (ast-match-arm-list-empty? (& rest))]
          [body : AstExpr (lower-context-expr-get ctx body-box)]
          (match (lower-avx2-enum-pattern-arm-masks
            ctx
            state
            base
            enum-ty
            active-mask
            lane-id
            lanes
            lane-ty
            pattern
            final?
            expr)
            [(ResultLowerMaskedMatchMasks.Ok masks)
              (match masks
                [(LowerMaskedMatchMasks.Masks mask-state arm-mask rest-mask)
                  (match (lower-avx2-enum-bind-pattern
                    ctx
                    mask-state
                    env
                    type-env
                    lane-locals
                    base
                    enum-ty
                    pattern
                    arm-mask
                    lanes
                    expr)
                    [(ResultLowerMaskedEnumEnv.Ok
                        bound-state
                        bound-env
                        bound-type-env
                        bound-lane-locals)
                      (match (lower-avx512-masked-expr-expected
                        ctx
                        bound-state
                        bound-env
                        bound-type-env
                        bound-lane-locals
                        index
                        index-var
                        arm-mask
                        lanes
                        body
                        result-ty)
                        [(ResultLowerExpr.Ok body-lowered)
                          (match body-lowered
                            [(LowerExpr.Expr body-state body-value body-ty)
                              (if final?
                                (ResultLowerExpr.Ok body-lowered)
                                (match (lower-avx2-enum-match-arms
                                  ctx
                                  body-state
                                  env
                                  type-env
                                  lane-locals
                                  index
                                  index-var
                                  rest-mask
                                  lane-id
                                  lanes
                                  lane-ty
                                  result-ty
                                  expr
                                  base
                                  enum-ty
                                  rest)
                                  [(ResultLowerExpr.Ok rest-lowered)
                                    (match rest-lowered
                                      [(LowerExpr.Expr
                                          rest-state
                                          rest-value
                                          rest-ty)
                                        (match body-ty
                                          [(AstType.Unit)
                                            (ResultLowerExpr.Ok
                                              (LowerExpr.Expr
                                                rest-state
                                                CompilerIrValue.Unit
                                                (AstType.Unit)))]
                                          [_
                                            (if (ast-type-eq?
                                              (tc-type-without-regions body-ty)
                                              (tc-type-without-regions rest-ty))
                                              (lower-avx512-masked-match-select
                                                rest-state
                                                arm-mask
                                                body-value
                                                rest-mask
                                                rest-value
                                                lanes
                                                body-ty
                                                expr)
                                              (lower-avx512-masked-unsupported
                                                expr
                                                "mixed AVX2 varying enum match arm result types"))])])]
                                  [(ResultLowerExpr.Err message)
                                    (ResultLowerExpr.Err message)]))])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])]
                    [(ResultLowerMaskedEnumEnv.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerMaskedMatchMasks.Err message)
              (ResultLowerExpr.Err message)]))])))

(define (lower-avx2-masked-enum-match
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]) : ResultLowerExpr
  (match (lower-avx2-masked-enum-source
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    scrutinee)
    [(ResultLowerMaskedEnumSource.Ok source)
      (match source
        [(LowerMaskedEnumSource.Source source-state base enum-ty)
          (let
            [lane-ty : AstType (lower-avx2-enum-mask-lane-type lanes)]
            (match (lower-emit-lane-id source-state lanes lane-ty)
              [(LowerExpr.Expr lane-state lane-id _)
                (lower-avx2-enum-match-arms
                  ctx
                  lane-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lane-id
                  lanes
                  lane-ty
                  result-ty
                  expr
                  base
                  enum-ty
                  arms)]))])]
    [(ResultLowerMaskedEnumSource.Err message) (ResultLowerExpr.Err message)]
    [(ResultLowerMaskedEnumSource.No)
      (lower-avx512-masked-unsupported
        expr
        "an AVX2 varying enum match source outside a contiguous array lane")]))

(define (lower-avx512-masked-match-literal-mask
  [state : LowerState]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [lanes : i64]
  [lit : AstLiteral]) : ResultLowerExpr
  (match (tc-type-without-regions scrut-ty)
    [(AstType.Bool)
      (match lit
        [(AstLiteral.Bool value)
          (if value
            (ResultLowerExpr.Ok
              (LowerExpr.Expr state scrut-value (AstType.Bool)))
            (ResultLowerExpr.Ok (lower-emit-mask-not state scrut-value lanes)))]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic "lower: unsupported bool literal match pattern")))])]
    [_
      (match (lower-emit-splat
        state
        (lower-literal-value-with-type lit (tc-type-without-regions scrut-ty))
        lanes
        (tc-type-without-regions scrut-ty))
        [(LowerExpr.Expr lit-state lit-value _)
          (ResultLowerExpr.Ok
            (lower-emit-vector-compare
              lit-state
              (CompilerIrBinOp.Eq)
              scrut-value
              lit-value
              lanes
              (tc-type-without-regions scrut-ty)))])]))

(define (lower-avx512-masked-match-literal-arm-masks
  [state : LowerState]
  [active-mask : CompilerIrValue]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [lanes : i64]
  [lit : AstLiteral]) : ResultLowerMaskedMatchMasks
  (match (lower-avx512-masked-match-literal-mask
    state
    scrut-value
    scrut-ty
    lanes
    lit)
    [(ResultLowerExpr.Ok cond-lowered)
      (match cond-lowered
        [(LowerExpr.Expr cond-state cond-mask _)
          (match (lower-emit-mask-binop
            cond-state
            (CompilerIrMaskBinOp.And)
            active-mask
            cond-mask
            lanes)
            [(LowerExpr.Expr arm-mask-state arm-mask _)
              (match (lower-emit-mask-not arm-mask-state cond-mask lanes)
                [(LowerExpr.Expr not-state not-mask _)
                  (match (lower-emit-mask-binop
                    not-state
                    (CompilerIrMaskBinOp.And)
                    active-mask
                    not-mask
                    lanes)
                    [(LowerExpr.Expr rest-mask-state rest-mask _)
                      (ResultLowerMaskedMatchMasks.Ok
                        (LowerMaskedMatchMasks.Masks
                          rest-mask-state
                          arm-mask
                          rest-mask))])])])])]
    [(ResultLowerExpr.Err message) (ResultLowerMaskedMatchMasks.Err message)]))

(define (lower-avx512-masked-match-select
  [state : LowerState]
  [arm-mask : CompilerIrValue]
  [arm-value : CompilerIrValue]
  [rest-mask : CompilerIrValue]
  [rest-value : CompilerIrValue]
  [lanes : i64]
  [ty : AstType]
  [expr : AstExpr]) : ResultLowerExpr
  (if (lower-type-bool? ty)
    (ResultLowerExpr.Ok
      (lower-emit-mask-select
        state
        arm-mask
        arm-value
        rest-mask
        rest-value
        lanes))
    (if (lower-avx512-masked-select-result-supported? state lanes ty)
      (ResultLowerExpr.Ok
        (lower-emit-select
          state
          arm-mask
          arm-value
          rest-value
          lanes
          (tc-type-without-regions ty)))
      (lower-avx512-masked-unsupported
        expr
        "this value-producing varying match result type"))))

(define (lower-avx512-masked-match-after-body
  [ctx : TcContext]
  [body-state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [arm-mask : CompilerIrValue]
  [rest-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [body-value : CompilerIrValue]
  [body-ty : AstType]
  [rest : AstMatchArmList]) : ResultLowerExpr
  (match body-ty
    [(AstType.Unit)
      (lower-avx512-masked-match-arms
        ctx
        body-state
        env
        type-env
        lane-locals
        index
        index-var
        rest-mask
        lanes
        result-ty
        expr
        scrut-value
        scrut-ty
        rest)]
    [_
      (match (lower-avx512-masked-match-arms
        ctx
        body-state
        env
        type-env
        lane-locals
        index
        index-var
        rest-mask
        lanes
        result-ty
        expr
        scrut-value
        scrut-ty
        rest)
        [(ResultLowerExpr.Ok rest-lowered)
          (match rest-lowered
            [(LowerExpr.Expr rest-state rest-value rest-ty)
              (if (ast-type-eq?
                (tc-type-without-regions body-ty)
                (tc-type-without-regions rest-ty))
                (lower-avx512-masked-match-select
                  rest-state
                  arm-mask
                  body-value
                  rest-mask
                  rest-value
                  lanes
                  body-ty
                  expr)
                (lower-avx512-masked-unsupported
                  expr
                  "mixed varying match arm result types"))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-avx512-masked-match-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [pattern : AstPattern]
  [body : AstExpr]
  [rest : AstMatchArmList]) : ResultLowerExpr
  (match pattern
    [(AstPattern.Literal lit)
      (if (ast-match-arm-list-empty? (& rest))
        (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          body
          result-ty)
        (match (lower-avx512-masked-match-literal-arm-masks
          state
          active-mask
          scrut-value
          scrut-ty
          lanes
          lit)
          [(ResultLowerMaskedMatchMasks.Ok masks)
            (match masks
              [(LowerMaskedMatchMasks.Masks mask-state arm-mask rest-mask)
                (match (lower-avx512-masked-expr-expected
                  ctx
                  mask-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  arm-mask
                  lanes
                  body
                  result-ty)
                  [(ResultLowerExpr.Ok body-lowered)
                    (match body-lowered
                      [(LowerExpr.Expr body-state body-value body-ty)
                        (lower-avx512-masked-match-after-body
                          ctx
                          body-state
                          env
                          type-env
                          lane-locals
                          index
                          index-var
                          arm-mask
                          rest-mask
                          lanes
                          result-ty
                          expr
                          scrut-value
                          scrut-ty
                          body-value
                          body-ty
                          rest)])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
          [(ResultLowerMaskedMatchMasks.Err message)
            (ResultLowerExpr.Err message)]))]
    [(AstPattern.Wildcard)
      (lower-avx512-masked-expr-expected
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        body
        result-ty)]
    [(AstPattern.Var name _)
      (match scrut-value
        [(CompilerIrValue.Var scrut-var)
          (lower-avx512-masked-expr-expected
            ctx
            state
            (sym_i64_env.sym-i64-bind-id env name scrut-var)
            (tc-bind-id type-env name scrut-ty)
            (lower-id-set-insert lane-locals name)
            index
            index-var
            active-mask
            lanes
            body
            result-ty)]
        [_
          (lower-avx512-masked-unsupported
            expr
            "non-variable match binding values in this AVX-512 slice")])]
    [(AstPattern.Binding name)
      (match scrut-value
        [(CompilerIrValue.Var scrut-var)
          (lower-avx512-masked-expr-expected
            ctx
            state
            (sym_i64_env.sym-i64-bind-id env name scrut-var)
            (tc-bind-id type-env name scrut-ty)
            (lower-id-set-insert lane-locals name)
            index
            index-var
            active-mask
            lanes
            body
            result-ty)]
        [_
          (lower-avx512-masked-unsupported
            expr
            "non-variable match binding values in this AVX-512 slice")])]
    [_
      (lower-avx512-masked-unsupported
        expr
        "this varying match pattern in the AVX-512 slice")]))

(define (lower-avx512-masked-match-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultLowerExpr
  (if (ast-match-arm-list-empty? (& arms))
    (lower-avx512-masked-unsupported
      expr
      "match with no arms in this AVX-512 slice")
    (match (ast-match-arm-list-get (& arms) 0 (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (lower-avx512-masked-match-arm
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          result-ty
          expr
          scrut-value
          scrut-ty
          pattern
          (lower-context-expr-get ctx body-box)
          (ast-match-arm-list-tail arms))])))

(define (lower-avx512-masked-match
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [result-ty : AstType]
  [expr : AstExpr]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]) : ResultLowerExpr
  (if (and
    (lower-mode-avx2? (lower-state-mode state))
    (match (lower-expr-result-type-or-check
      ctx
      env
      type-env
      (lower-state-type-cache state)
      scrutinee)
      [(ResultTcType.Ok scrut-ty) (lower-spmd-enum-type? scrut-ty)]
      [(ResultTcType.Err _) false]))
    (lower-avx2-masked-enum-match
      ctx
      state
      env
      type-env
      lane-locals
      index
      index-var
      active-mask
      lanes
      result-ty
      expr
      scrutinee
      arms)
    (match (lower-avx512-masked-expr
      ctx
      state
      env
      type-env
      lane-locals
      index
      index-var
      active-mask
      lanes
      scrutinee)
      [(ResultLowerExpr.Ok scrut-lowered)
        (match scrut-lowered
          [(LowerExpr.Expr scrut-state scrut-value scrut-ty)
            (lower-avx512-masked-match-arms
              ctx
              scrut-state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              result-ty
              expr
              scrut-value
              scrut-ty
              arms)])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-spmd-ir-value-class [ty : AstType] [varying : bool]) : CompilerIrSpmdValueClass
  (if varying
    (if (lower-type-bool? ty)
      (CompilerIrSpmdValueClass.Mask)
      (CompilerIrSpmdValueClass.Varying))
    (CompilerIrSpmdValueClass.Uniform)))

(define (lower-avx512-spmd-call-args
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [params : AstParamList]
  [args : AstExprList]) : ResultLowerSpmdCallArgs
  (lower-avx512-spmd-call-args-at
    ctx
    state
    env
    type-env
    lane-locals
    (lower-masked-vector-lane-locals-from-set lane-locals lanes)
    index
    index-var
    active-mask
    lanes
    (& params)
    (& args)
    0))

(define (lower-avx512-spmd-call-args-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [analysis-locals : lower_i64_i64_map.Map]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [params : (& params AstParamList)]
  [args : (& args AstExprList)]
  [arg-index : i64]) : ResultLowerSpmdCallArgs
  (cond
    [(and
        (>= arg-index (ast-param-list-len params))
        (>= arg-index (struct-get args len)))
      (ResultLowerSpmdCallArgs.Ok state CompilerIrSpmdCallArgList.Nil false)]
    [(or
        (>= arg-index (ast-param-list-len params))
        (>= arg-index (struct-get args len)))
      (ResultLowerSpmdCallArgs.Err
        (box (lower-diagnostic "lower: SPMD helper call arity mismatch")))]
    [else
      (match (ast-param-list-get params arg-index (ast-param-fallback))
        [(AstParam.Param _ param-ty _ _)
          (let
            [arg : AstExpr
              (lower-context-expr-get ctx (ast-expr-list-get args arg-index 0))]
            [resolved-ty : AstType
              (tc-type-without-regions (tc-resolve-type ctx param-ty))]
            [arg-lanes : i64
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                (lower-state-mode state)
                env
                type-env
                index
                analysis-locals
                arg)]
            [varying : bool (> arg-lanes 0)]
            (if (< arg-lanes 0)
              (ResultLowerSpmdCallArgs.Err
                (box
                  (lower-diagnostic-at-expr
                    arg
                    "lower: unsupported SPMD helper argument expression")))
              (match (if varying
                (lower-avx512-masked-expr-expected
                  ctx
                  state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lanes
                  arg
                  resolved-ty)
                (lower-expr-expected ctx state env type-env arg resolved-ty arg))
                [(ResultLowerExpr.Ok lowered)
                  (match lowered
                    [(LowerExpr.Expr arg-state arg-value _)
                      (match (lower-avx512-spmd-call-args-at
                        ctx
                        arg-state
                        env
                        type-env
                        lane-locals
                        analysis-locals
                        index
                        index-var
                        active-mask
                        lanes
                        params
                        args
                        (+ arg-index 1))
                        [(ResultLowerSpmdCallArgs.Ok
                            rest-state
                            rest-args
                            rest-varying)
                          (ResultLowerSpmdCallArgs.Ok
                            rest-state
                            (ir-spmd-call-arg-cons
                              (CompilerIrSpmdCallArg.Arg
                                (lower-spmd-ir-value-class resolved-ty varying)
                                arg-value
                                resolved-ty)
                              rest-args)
                            (or varying rest-varying))]
                        [(ResultLowerSpmdCallArgs.Err message)
                          (ResultLowerSpmdCallArgs.Err message)])])]
                [(ResultLowerExpr.Err message)
                  (ResultLowerSpmdCallArgs.Err message)])))])]))

(define (lower-spmd-call-lane-locals
  [params : AstParamList]
  [args : CompilerIrSpmdCallArgList]) : LowerIdSet
  (lower-spmd-call-lane-locals-at (& params) args 0 LowerIdSet.Nil))

(define (lower-spmd-call-lane-locals-at
  [params : (& params AstParamList)]
  [args : CompilerIrSpmdCallArgList]
  [index : i64]
  [out : LowerIdSet]) : LowerIdSet
  (if (>= index (ast-param-list-len params))
    out
    (match args
      [(CompilerIrSpmdCallArgList.Array seq)
        (lower-spmd-call-lane-locals-seq-at params seq index out)]
      [(CompilerIrSpmdCallArgList.Cons arg rest)
        (match (ast-param-list-get params index (ast-param-fallback))
          [(AstParam.Param name _ _ _)
            (match arg
              [(CompilerIrSpmdCallArg.Arg class _ _)
                (lower-spmd-call-lane-locals-at
                  params
                  (box-get rest)
                  (+ index 1)
                  (match class
                    [(CompilerIrSpmdValueClass.Uniform) out]
                    [_ (lower-id-set-insert out name)]))])])]
      [(CompilerIrSpmdCallArgList.Nil) out])))

(define (lower-spmd-call-lane-locals-seq-at
  [params : (& params AstParamList)]
  [args : CompilerIrSpmdCallArgSeq]
  [index : i64]
  [out : LowerIdSet]) : LowerIdSet
  (if (or
    (>= index (ast-param-list-len params))
    (>= index (struct-get args len)))
    out
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name _ _ _)
        (match (array-ref (struct-get args slots) index)
          [(CompilerIrSpmdCallArg.Arg class _ _)
            (lower-spmd-call-lane-locals-seq-at
              params
              args
              (+ index 1)
              (match class
                [(CompilerIrSpmdValueClass.Uniform) out]
                [_ (lower-id-set-insert out name)]))])])))

(define (lower-spmd-source-param-types-at
  [params : (& params AstParamList)]
  [index : i64]
  [out : (&mut out AstTypeList)]) : unit
  (if (>= index (ast-param-list-len params))
    unit
    (begin
      (match (ast-param-list-get params index (ast-param-fallback))
        [(AstParam.Param _ ty _ consume?)
          (ast-type-list-push
            out
            (ast-node-pool-reader-type-push
              (if consume?
                (ast-ty-consume ty)
                ty)))])
      (lower-spmd-source-param-types-at params (+ index 1) out))))

(define (lower-spmd-source-signature [params : AstParamList] [ret : AstType]) : String
  (let
    [types : AstTypeList
      (ast-type-list-with-capacity (ast-param-list-len (& params)))]
    (begin
      (lower-spmd-source-param-types-at (& params) 0 (&mut types))
      (tc-type-render (ast-ty-func types ret)))))

(define (lower-imported-spmd-params-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]
  [out : (&mut out AstParamList)]) : unit
  (if (>= index (ast-type-list-len types))
    unit
    (let
      [ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      (begin
        (match ty
          [(AstType.Consume inner)
            (ast-param-list-push
              out
              (AstParam.Param
                cbi.compiler-builtin-id-fix-empty
                (tc-context-type-get ctx inner)
                false
                true))]
          [_
            (ast-param-list-push
              out
              (AstParam.Param cbi.compiler-builtin-id-fix-empty ty false false))])
        (lower-imported-spmd-params-at ctx types (+ index 1) out)))))

(define (lower-imported-spmd-params [ctx : TcContext] [types : AstTypeList]) : AstParamList
  (let
    [out : AstParamList
      (ast-param-list-with-capacity (ast-type-list-len (& types)))]
    (begin
      (lower-imported-spmd-params-at ctx (& types) 0 (&mut out))
      out)))

(define (lower-imported-spmd-call-arg-code [arg : CompilerIrSpmdCallArg]) : String
  (match arg
    [(CompilerIrSpmdCallArg.Arg class _ _)
      (match class
        [(CompilerIrSpmdValueClass.Uniform) "u"]
        [_ "v"])]))

(define (lower-imported-spmd-call-args-code-at
  [args : CompilerIrSpmdCallArgList]
  [index : i64]
  [count : i64]) : String
  (if (>= index count)
    ""
    (str_cat.str-cat
      (lower-imported-spmd-call-arg-code (lower-spmd-call-arg-at args index))
      (lower-imported-spmd-call-args-code-at args (+ index 1) count))))

(define (lower-imported-spmd-call-args-code [args : CompilerIrSpmdCallArgList]) : String
  (lower-imported-spmd-call-args-code-at
    args
    0
    (compiler-ir-spmd-call-arg-count args)))

;; TLCI records the final archive/link name, while existing `SpmdCall` IR
;; carries a logical TypeLisp name that the backend decorates with `_tl_`.
;; Private ABI v1 symbols are generated by that backend rule, so remove its
;; prefix exactly once before reusing the established IR.
(define (lower-imported-spmd-ir-symbol [item : AstImportedSpmdSpecialization]) : i64
  (let
    [link-symbol-id : i64 (struct-get item symbol)]
    [link-symbol : String (intern-str link-symbol-id)]
    [link-symbol-len : i64 (string.string-length link-symbol)]
    (if (and
      (> link-symbol-len 4)
      (lower-string-prefix-at? link-symbol "_tl_" 0))
      (ci.intern-generated-canonical-name
        (string.substring link-symbol 4 (- link-symbol-len 4)))
      link-symbol-id)))

(define (lower-imported-spmd-backend-name [backend : CompilerIrSpmdBackend]) : String
  (match backend
    [(CompilerIrSpmdBackend.Scalar) "scalar"]
    [(CompilerIrSpmdBackend.Avx2) "avx2"]
    [(CompilerIrSpmdBackend.Avx512) "avx512"]))

(define (lower-imported-spmd-specialization-key-matches?
  [item : AstImportedSpmdSpecialization]
  [backend : String]
  [lanes : i64]
  [args-code : String]
  [index-param : i64]) : bool
  (and
    (string.eq (intern-str (struct-get item backend)) backend)
    (= (struct-get item lanes) lanes)
    (string.eq (intern-str (struct-get item args)) args-code)
    (= (struct-get item index-param) index-param)))

(define (lower-imported-spmd-result-compatible?
  [item : AstImportedSpmdSpecialization]
  [ret : AstType]) : bool
  (let
    [result : String (intern-str (struct-get item result))]
    (if (tc-type-eq (tc-type-without-regions ret) (AstType.Unit))
      (string.eq result "unit")
      (or (string.eq result "u") (string.eq result "v")))))

(define (lower-imported-spmd-selection-error
  [origin : AstExpr]
  [canonical-name : String]
  [message : String]) : ResultLowerImportedSpmdSpecialization
  (ResultLowerImportedSpmdSpecialization.Err
    (box
      (lower-diagnostic-at-expr
        origin
        (str_cat.str-cat
          "lower: imported SPMD helper `"
          canonical-name
          "` "
          message)))))

(define (lower-imported-spmd-selection-scan-new) : LowerImportedSpmdSelectionScan
  (LowerImportedSpmdSelectionScan
    0
    0
    -1
    -1
    0
    (ast-imported-spmd-specialization-fallback)))

(define (lower-imported-spmd-selection-scan-specializations-at
  [specializations : (& specializations AstImportedSpmdSpecializationList)]
  [index : i64]
  [backend-name : String]
  [lanes : i64]
  [args-code : String]
  [requested-index-param : i64]
  [ret : AstType]
  [scan : LowerImportedSpmdSelectionScan]) : LowerImportedSpmdSelectionScan
  (if (>= index (ast-imported-spmd-specialization-list-len specializations))
    scan
    (let
      [item : AstImportedSpmdSpecialization
        (ast-imported-spmd-specialization-list-get
          specializations
          index
          (ast-imported-spmd-specialization-fallback))]
      [abi-id : i64 (struct-get item abi)]
      [abi : String (intern-str abi-id)]
      [key-matches : bool
        (and
          (lower-imported-spmd-specialization-key-matches?
            item
            backend-name
            lanes
            args-code
            requested-index-param)
          (lower-imported-spmd-result-compatible? item ret))]
      [next : LowerImportedSpmdSelectionScan
        (if (string.eq abi "spmd-call-v1")
          (LowerImportedSpmdSelectionScan
            (struct-get scan signature-count)
            (+ (struct-get scan supported-abi-count) 1)
            (struct-get scan unsupported-abi-id)
            (struct-get scan unsupported-key-abi-id)
            (if key-matches
              (+ (struct-get scan selected-count) 1)
              (struct-get scan selected-count))
            (if key-matches
              item
              (struct-get scan selected)))
          (LowerImportedSpmdSelectionScan
            (struct-get scan signature-count)
            (struct-get scan supported-abi-count)
            (if (< (struct-get scan unsupported-abi-id) 0)
              abi-id
              (struct-get scan unsupported-abi-id))
            (if (and key-matches (< (struct-get scan unsupported-key-abi-id) 0))
              abi-id
              (struct-get scan unsupported-key-abi-id))
            (struct-get scan selected-count)
            (struct-get scan selected)))]
      (lower-imported-spmd-selection-scan-specializations-at
        specializations
        (+ index 1)
        backend-name
        lanes
        args-code
        requested-index-param
        ret
        next))))

(define (lower-imported-spmd-selection-scan-callables-at
  [callables : (& callables AstImportedSpmdCallableList)]
  [index : i64]
  [signature : String]
  [backend-name : String]
  [lanes : i64]
  [args-code : String]
  [requested-index-param : i64]
  [ret : AstType]
  [scan : LowerImportedSpmdSelectionScan]) : LowerImportedSpmdSelectionScan
  (if (>= index (ast-imported-spmd-callable-list-len callables))
    scan
    (let
      [callable : AstImportedSpmdCallable
        (ast-imported-spmd-callable-list-get
          callables
          index
          (ast-imported-spmd-callable-fallback))]
      [matches-signature : bool
        (string.eq (intern-str (struct-get callable signature)) signature)]
      [signature-scan : LowerImportedSpmdSelectionScan
        (if matches-signature
          (LowerImportedSpmdSelectionScan
            (+ (struct-get scan signature-count) 1)
            (struct-get scan supported-abi-count)
            (struct-get scan unsupported-abi-id)
            (struct-get scan unsupported-key-abi-id)
            (struct-get scan selected-count)
            (struct-get scan selected))
          scan)]
      [specializations : AstImportedSpmdSpecializationList
        (struct-get callable specializations)]
      [next : LowerImportedSpmdSelectionScan
        (if matches-signature
          (lower-imported-spmd-selection-scan-specializations-at
            (& specializations)
            0
            backend-name
            lanes
            args-code
            requested-index-param
            ret
            signature-scan)
          signature-scan)]
      (lower-imported-spmd-selection-scan-callables-at
        callables
        (+ index 1)
        signature
        backend-name
        lanes
        args-code
        requested-index-param
        ret
        next))))

(define (lower-imported-spmd-select
  [canonical-name-id : i64]
  [callables : (& callables AstImportedSpmdCallableList)]
  [signature : String]
  [backend : CompilerIrSpmdBackend]
  [lanes : i64]
  [args-code : String]
  [requested-index-param : i64]
  [ret : AstType]
  [origin : AstExpr]) : ResultLowerImportedSpmdSpecialization
  (let
    [canonical-name : String (intern-str canonical-name-id)]
    [backend-name : String (lower-imported-spmd-backend-name backend)]
    [callable-count : i64 (ast-imported-spmd-callable-list-len callables)]
    [scan : LowerImportedSpmdSelectionScan
      (lower-imported-spmd-selection-scan-callables-at
        callables
        0
        signature
        backend-name
        lanes
        args-code
        requested-index-param
        ret
        (lower-imported-spmd-selection-scan-new))]
    (cond
      [(= callable-count 0)
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          "has no TLCI callable metadata")]
      [(= (struct-get scan signature-count) 0)
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "ordinary signature mismatch; consumer resolved "
            signature))]
      [(= (struct-get scan selected-count) 1)
        (ResultLowerImportedSpmdSpecialization.Ok (struct-get scan selected))]
      [(> (struct-get scan selected-count) 1)
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "has duplicate TLCI specializations for the requested key (backend="
            backend-name
            ", lanes="
            (string.int->string lanes)
            ", args="
            args-code
            ", index-param="
            (string.int->string requested-index-param)
            ")"))]
      [(>= (struct-get scan unsupported-key-abi-id) 0)
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "uses unsupported private ABI `"
            (intern-str (struct-get scan unsupported-key-abi-id))
            "`"))]
      [(and
          (= (struct-get scan supported-abi-count) 0)
          (>= (struct-get scan unsupported-abi-id) 0))
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "has no supported private ABI; first advertised ABI is `"
            (intern-str (struct-get scan unsupported-abi-id))
            "`"))]
      [(string.eq backend-name "avx2")
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          "is not supported in AVX2 backend mode")]
      [else
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "has no requested specialization (backend="
            backend-name
            ", lanes="
            (string.int->string lanes)
            ", args="
            args-code
            ", index-param="
            (string.int->string requested-index-param)
            ")"))])))

(define (lower-imported-spmd-result-varying?
  [item : AstImportedSpmdSpecialization]) : bool
  (string.eq (intern-str (struct-get item result)) "v"))

(define (lower-imported-spmd-index-param-at
  [ctx : TcContext]
  [index-name : String]
  [args : (& args AstExprList)]
  [arg-index : i64]) : i64
  (if (or
    (= (string.string-length index-name) 0)
    (>= arg-index (struct-get args len)))
    -1
    (let
      [arg : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get args arg-index 0))]
      (if (= (lower-masked-vector-index-offset ctx index-name arg) 0)
        arg-index
        (lower-imported-spmd-index-param-at ctx index-name args (+ arg-index 1))))))

(define (lower-imported-spmd-index-param
  [ctx : TcContext]
  [index-name : String]
  [args : AstExprList]) : i64
  (lower-imported-spmd-index-param-at ctx index-name (& args) 0))

(define (lower-spmd-ast-param-class-code [class : AstSpmdParamClass]) : String
  (match class
    [(AstSpmdParamClass.Uniform) "u"]
    [(AstSpmdParamClass.Varying) "v"]))

(define (lower-spmd-ast-result-class-code [class : AstSpmdResultClass]) : String
  (match class
    [(AstSpmdResultClass.Unit) "unit"]
    [(AstSpmdResultClass.Uniform) "u"]
    [(AstSpmdResultClass.Varying) "v"]))

(define (lower-spmd-ast-param-classes-code-at
  [items : (& items AstSpmdParamClassList)]
  [index : i64]) : String
  (if (>= index (ast-spmd-param-class-list-len items))
    ""
    (string.append
      (lower-spmd-ast-param-class-code
        (ast-spmd-param-class-list-get items index AstSpmdParamClass.Uniform))
      (lower-spmd-ast-param-classes-code-at items (+ index 1)))))

(define (lower-spmd-ast-param-classes-code [items : AstSpmdParamClassList]) : String
  (lower-spmd-ast-param-classes-code-at (& items) 0))

(define (lower-spmd-package-backend-name [backend : CompilerIrSpmdBackend]) : String
  (match backend
    [(CompilerIrSpmdBackend.Scalar) "scalar"]
    [(CompilerIrSpmdBackend.Avx2) "avx2"]
    [(CompilerIrSpmdBackend.Avx512) "avx512"]))

(define lower-spmd-package-abi : String
  "spmd-call-v1")

(define (lower-spmd-package-symbol-identity
  [package-name : String]
  [canonical-name : String]
  [signature : String]
  [backend : CompilerIrSpmdBackend]
  [lanes : i64]
  [args : String]
  [result : String]
  [index-param : i64]) : String
  (str_cat.str-cat
    package-name
    "|"
    canonical-name
    "|"
    signature
    "|"
    lower-spmd-package-abi
    "|"
    (lower-spmd-package-backend-name backend)
    "|"
    (string.int->string lanes)
    "|"
    args
    "|"
    result
    "|"
    (string.int->string index-param)))

(define (lower-spmd-package-symbol
  [package-name : String]
  [canonical-name : String]
  [signature : String]
  [result-ty : AstType]
  [backend : CompilerIrSpmdBackend]
  [lanes : i64]
  [args : String]
  [result : String]
  [index-param : i64]) : String
  (let
    [identity : String
      (lower-spmd-package-symbol-identity
        package-name
        canonical-name
        signature
        backend
        lanes
        args
        result
        index-param)]
    [hash : i64 (stdlib.hash.string-key (& identity))]
    [stable-name : String
      (string.append "__tl_spmd_pkg_" (string.int->string hash))]
    ;; The private AVX-512 ABI is selected by the function-name prefix in the
    ;; backend.  Keep the stable package hash intact after that prefix so the
    ;; archive and TLCI still share one deterministic logical identity.
    (match backend
      [(CompilerIrSpmdBackend.Avx512)
        (if (string.eq result "v")
          (if (lower-type-bool? result-ty)
            (string.append "__tl_spmd_ret_mask_" stable-name)
            (string.append "__tl_spmd_ret_varying_" stable-name))
          (string.append "__tl_spmd_ret_uniform_" stable-name))]
      [_ stable-name])))

(define (lower-spmd-package-symbol-register [symbol : i64] [identity : String]) : LowerSpmdPackageSymbolRegistration
  (let
    [identity-id : i64 (ci.intern-generated-canonical-name identity)]
    (match (lower_i64_i64_map.get
      (& lower-spmd-package-symbol-identities)
      symbol)
      [(lower_i64_i64_map.LookupFound previous)
        (if (= previous identity-id)
          LowerSpmdPackageSymbolRegistration.Existing
          (LowerSpmdPackageSymbolRegistration.Collision
            (string.append
              "lower: :spmd-callable stable symbol collision for "
              (compiler-ir-symbol-text symbol))))]
      [(lower_i64_i64_map.LookupMissing)
        (begin
          (lower_i64_i64_map.insert-ref!
            (&mut lower-spmd-package-symbol-identities)
            symbol
            identity-id)
          LowerSpmdPackageSymbolRegistration.New)])))

(define (lower-spmd-package-lane-width-supported? [lanes : i64]) : bool
  (or (= lanes 8) (= lanes 16) (= lanes 32) (= lanes 64)))

(define (lower-spmd-package-call-args-at
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [classes : (& classes AstSpmdParamClassList)]
  [index : i64]) : CompilerIrSpmdCallArgList
  (if (>= index (ast-param-list-len params))
    CompilerIrSpmdCallArgList.Nil
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _ _)
        (let
          [resolved : AstType
            (tc-type-without-regions (tc-resolve-type ctx ty))]
          [class : CompilerIrSpmdValueClass
            (match (ast-spmd-param-class-list-get
              classes
              index
              AstSpmdParamClass.Uniform)
              [(AstSpmdParamClass.Uniform) CompilerIrSpmdValueClass.Uniform]
              [(AstSpmdParamClass.Varying)
                (if (lower-type-bool? resolved)
                  CompilerIrSpmdValueClass.Mask
                  CompilerIrSpmdValueClass.Varying)])]
          (ir-spmd-call-arg-cons
            (CompilerIrSpmdCallArg.Arg class CompilerIrValue.Unit resolved)
            (lower-spmd-package-call-args-at ctx params classes (+ index 1))))])))

(define (lower-spmd-package-index-name
  [params : (& params AstParamList)]
  [index : i64]) : String
  (if (< index 0)
    ""
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name _ _ _) (intern-str name)])))

(define (lower-spmd-package-index-param-i64?
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [index : i64]) : bool
  (if (< index 0)
    true
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _ _)
        (lower-type-i64? (tc-type-without-regions (tc-resolve-type ctx ty)))])))

(define (lower-spmd-package-abi-type-supported? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.Bool) true]
    [(AstType.Unit) true]
    [_ false]))

(define (lower-spmd-package-param-validation-error-at
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [classes : (& classes AstSpmdParamClassList)]
  [lanes : i64]
  [index : i64]) : String
  (if (>= index (ast-param-list-len params))
    ""
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _ _)
        (let
          [resolved : AstType
            (tc-type-without-regions (tc-resolve-type ctx ty))]
          [class : AstSpmdParamClass
            (ast-spmd-param-class-list-get
              classes
              index
              AstSpmdParamClass.Uniform)]
          (cond
            [(not (lower-spmd-package-abi-type-supported? resolved))
              "lower: :spmd-callable parameter type is not supported by private ABI v1"]
            [(and
                (match class
                  [(AstSpmdParamClass.Varying) true]
                  [_ false])
                (not (lower-type-bool? resolved))
                (not
                  (=
                    (lower-simd-lanes-for-elem
                      (CompilerLowerMode.Avx512)
                      resolved)
                    lanes)))
              "lower: :spmd-callable lane width does not match varying parameter type"]
            [else
              (lower-spmd-package-param-validation-error-at
                ctx
                params
                classes
                lanes
                (+ index 1))]))])))

(define (lower-spmd-package-specialization-validation-error
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [specialization : AstSpmdSpecialization]) : String
  (let
    [classes : AstSpmdParamClassList (box-get (struct-get specialization args))]
    [index-param : i64 (struct-get specialization index-param)]
    [call-args : CompilerIrSpmdCallArgList
      (lower-spmd-package-call-args-at ctx (& params) (& classes) 0)]
    [index-name : String (lower-spmd-package-index-name (& params) index-param)]
    [ret-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ret))]
    [param-error : String
      (lower-spmd-package-param-validation-error-at
        ctx
        (& params)
        (& classes)
        (struct-get specialization lanes)
        0)]
    [env : sym_i64_env.SymI64Env
      (lower-bind-params params 1 (sym_i64_env.sym-i64-empty))]
    [type-env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-params ctx (tc-hygiene-global-env top-env) params)
        ret-ty)]
    [_recursion-reset : unit (set! lower-spmd-inline-recursion-detected false)]
    [body-lanes : i64
      (lower-masked-vector-expr-lanes-with-locals
        ctx
        (CompilerLowerMode.Avx512)
        env
        type-env
        index-name
        (lower-masked-vector-lane-locals-from-set
          (lower-spmd-call-lane-locals params call-args)
          (struct-get specialization lanes))
        body)]
    (cond
      [(not
          (lower-spmd-package-lane-width-supported?
            (struct-get specialization lanes)))
        "lower: :spmd-callable lane width is not supported by private ABI v1"]
      [(not (string.eq param-error "")) param-error]
      [(not (lower-spmd-package-abi-type-supported? ret-ty))
        "lower: :spmd-callable return type is not supported by private ABI v1"]
      [(and
          (match (struct-get specialization result)
            [(AstSpmdResultClass.Varying) true]
            [_ false])
          (not (lower-type-bool? ret-ty))
          (not
            (=
              (lower-simd-lanes-for-elem (CompilerLowerMode.Avx512) ret-ty)
              (struct-get specialization lanes))))
        "lower: :spmd-callable lane width does not match varying return type"]
      [(and
          (>= index-param 0)
          (match (ast-spmd-param-class-list-get
            (& classes)
            index-param
            AstSpmdParamClass.Uniform)
            [(AstSpmdParamClass.Varying) false]
            [_ true]))
        "lower: :spmd-callable index-param must name a varying argument"]
      [(not (lower-spmd-package-index-param-i64? ctx (& params) index-param))
        "lower: :spmd-callable index-param must name an i64 parameter"]
      [lower-spmd-inline-recursion-detected
        (lower-spmd-inline-recursive-message)]
      [(< body-lanes 0)
        "lower: :spmd-callable body does not support SPMD specialization"]
      [(tc-type-eq ret-ty (AstType.Unit))
        (match (struct-get specialization result)
          [(AstSpmdResultClass.Unit) ""]
          [_ "lower: :spmd-callable unit return requires result unit"])]
      [(match (struct-get specialization result)
          [(AstSpmdResultClass.Unit) true]
          [_ false])
        "lower: :spmd-callable non-unit return cannot use result unit"]
      [(and
          (> body-lanes 0)
          (match (struct-get specialization result)
            [(AstSpmdResultClass.Varying) false]
            [_ true]))
        "lower: :spmd-callable varying body requires result varying"]
      [(and
          (= body-lanes 0)
          (match (struct-get specialization result)
            [(AstSpmdResultClass.Uniform) false]
            [_ true]))
        "lower: :spmd-callable uniform body requires result uniform"]
      [else ""])))

;; Private AVX-512 helpers keep source types on their parameters, so preserve
;; the SPMD value class in the otherwise-internal parameter name.  The backend
;; and register planner use these prefixes to select the private vector/opmask
;; ABI without exposing a vector type in the source type system.
(define (lower-spmd-private-param-name
  [name : i64]
  [class : CompilerIrSpmdValueClass]) : String
  (match class
    [(CompilerIrSpmdValueClass.Uniform) (tc-env-key-name-text name)]
    [(CompilerIrSpmdValueClass.Varying)
      (string.append "__tl_spmd_varying_arg_" (tc-env-key-name-text name))]
    [(CompilerIrSpmdValueClass.Mask)
      (string.append "__tl_spmd_mask_arg_" (tc-env-key-name-text name))]))

(define (lower-spmd-call-arg-at
  [args : CompilerIrSpmdCallArgList]
  [index : i64]) : CompilerIrSpmdCallArg
  (match args
    [(CompilerIrSpmdCallArgList.Nil)
      (CompilerIrSpmdCallArg.Arg
        (CompilerIrSpmdValueClass.Uniform)
        CompilerIrValue.Unit
        (AstType.Unit))]
    [(CompilerIrSpmdCallArgList.Array seq)
      (if (and (>= index 0) (< index (struct-get seq len)))
        (array-ref (struct-get seq slots) index)
        (CompilerIrSpmdCallArg.Arg
          (CompilerIrSpmdValueClass.Uniform)
          CompilerIrValue.Unit
          (AstType.Unit)))]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (if (= index 0)
        arg
        (lower-spmd-call-arg-at (box-get rest) (- index 1)))]))

(define (lower-spmd-private-param-list
  [ctx : TcContext]
  [params : AstParamList]
  [args : CompilerIrSpmdCallArgList]
  [idx : i64]) : CompilerIrParamList
  (lower-spmd-private-param-list-at ctx (& params) args 0 idx))

(define (lower-spmd-private-param-list-at
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [args : CompilerIrSpmdCallArgList]
  [index : i64]
  [idx : i64]) : CompilerIrParamList
  (if (>= index (ast-param-list-len params))
    CompilerIrParamList.Nil
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name ty _ _)
        (match (lower-spmd-call-arg-at args index)
          [(CompilerIrSpmdCallArg.Arg class _ _)
            (compiler-ir-param-cons
              (CompilerIrParam.Param
                (lower-spmd-private-param-name name class)
                (lower-one-word-register-storage-type
                  ctx
                  (tc-type-without-regions (tc-resolve-type ctx ty)))
                idx)
              (lower-spmd-private-param-list-at
                ctx
                params
                args
                (+ index 1)
                (+ idx 1)))])])))

(define (lower-spmd-private-helper-name
  [hidden-name : i64]
  [result-ty : AstType]
  [result-varying : bool]) : i64
  (let
    [hidden-text : String (compiler-ir-symbol-text hidden-name)]
    [private-name : String
      (if result-varying
        (if (lower-type-bool? result-ty)
          (string.append "__tl_spmd_ret_mask_" hidden-text)
          (string.append "__tl_spmd_ret_varying_" hidden-text))
        (string.append "__tl_spmd_ret_uniform_" hidden-text))]
    (ci.intern-generated-canonical-name private-name)))

(define (lower-spmd-helper-index-param-at
  [ctx : TcContext]
  [index-name : String]
  [params : (& params AstParamList)]
  [args : (& args AstExprList)]
  [arg-index : i64]) : String
  (if (or
    (= (string.string-length index-name) 0)
    (>= arg-index (ast-param-list-len params))
    (>= arg-index (struct-get args len)))
    ""
    (let
      [arg : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get args arg-index 0))]
      (if (= (lower-masked-vector-index-offset ctx index-name arg) 0)
        (match (ast-param-list-get params arg-index (ast-param-fallback))
          [(AstParam.Param param-name _ _ _) (tc-env-key-name-text param-name)])
        (lower-spmd-helper-index-param-at
          ctx
          index-name
          params
          args
          (+ arg-index 1))))))

(define (lower-spmd-helper-index-param
  [ctx : TcContext]
  [index-name : String]
  [params : AstParamList]
  [args : AstExprList]) : String
  (lower-spmd-helper-index-param-at ctx index-name (& params) (& args) 0))

(define (lower-spmd-call-args-copy-from
  [args : CompilerIrSpmdCallArgList]
  [index : i64]
  [extra : CompilerIrSpmdCallArg]) : CompilerIrSpmdCallArgList
  (if (>= index (compiler-ir-spmd-call-arg-count args))
    (ir-spmd-call-arg-cons extra CompilerIrSpmdCallArgList.Nil)
    (ir-spmd-call-arg-cons
      (lower-spmd-call-arg-at args index)
      (lower-spmd-call-args-copy-from args (+ index 1) extra))))

(define (lower-spmd-call-args-append
  [args : CompilerIrSpmdCallArgList]
  [extra : CompilerIrSpmdCallArg]) : CompilerIrSpmdCallArgList
  (lower-spmd-call-args-copy-from args 0 extra))

(define (lower-spmd-private-param-list-append-index
  [params : CompilerIrParamList]
  [var-id : i64]) : CompilerIrParamList
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil)
      (compiler-ir-param-cons
        (CompilerIrParam.Param "__tl_spmd_index_base" (AstType.I64) var-id)
        CompilerIrParamList.Nil)]
    [(CompilerIrParamList.Array seq)
      (lower-spmd-private-param-list-append-index
        (compiler-ir-param-seq-to-list seq)
        var-id)]
    [(CompilerIrParamList.Cons head rest)
      (compiler-ir-param-cons
        head
        (lower-spmd-private-param-list-append-index (box-get rest) var-id))]))

(define (lower-spmd-avx512-helper-function
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [hidden-name : i64]
  [params : AstParamList]
  [ret : AstType]
  [result-varying : bool]
  [body : AstExpr]
  [call-args : CompilerIrSpmdCallArgList]
  [lanes : i64]
  [helper-index : String]
  [helper-index-source-param : i64]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [source-param-count : i64 (+ 1 (lower-param-count params))]
    [param-count : i64
      (if (or
        (= (string.string-length helper-index) 0)
        (>= helper-index-source-param 0))
        source-param-count
        (+ source-param-count 1))]
    [ret-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ret))]
    [hidden-name-text : String (compiler-ir-symbol-text hidden-name)]
    [function-spans : CompilerSourceSpans
      (lower-record-function-span spans hidden-name-text body)]
    [state : LowerState
      (LowerState.State
        param-count
        0
        0
        "entry"
        (compiler-ir-instr-builder-new)
        (compiler-ir-block-builder-new)
        (compiler-ir-function-builder-new)
        hidden-name-text
        (box function-spans)
        names
        type-cache
        mode
        (lower_i64_i64_map.with-capacity 8)
        1
        param-count)]
    [env : sym_i64_env.SymI64Env
      (lower-bind-params params 1 (sym_i64_env.sym-i64-empty))]
    [type-env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-params ctx (tc-hygiene-global-env top-env) params)
        ret-ty)]
    (match (lower-avx512-masked-expr
      ctx
      state
      env
      type-env
      (lower-spmd-call-lane-locals params call-args)
      helper-index
      (if (= (string.string-length helper-index) 0)
        (- 0 1)
        (if (>= helper-index-source-param 0)
          (+ helper-index-source-param 1)
          source-param-count))
      (CompilerIrValue.Var 0)
      lanes
      body)
      [(ResultLowerExpr.Ok lowered)
        (match lowered
          [(LowerExpr.Expr body-state value _)
            (let
              [return-expr
                : LowerExpr
                ;; Masked lowering represents a uniform result as identical
                ;; lanes; the private uniform ABI returns one scalar value.
                (cond
                  [(or result-varying (tc-type-eq ret-ty (AstType.Unit)))
                    lowered]
                  [(lower-type-bool? ret-ty)
                    (lower-emit-mask-reduce
                      body-state
                      (CompilerIrMaskReduceOp.Any)
                      value
                      lanes)]
                  [else
                    (lower-emit-vector-reduce
                      body-state
                      (CompilerIrVectorReduceOp.Min)
                      value
                      lanes
                      ret-ty)])]
              [return-state : LowerState
                (match return-expr
                  [(LowerExpr.Expr next-state _ _) next-state])]
              [return-value : CompilerIrValue
                (match return-expr
                  [(LowerExpr.Expr _ next-value _) next-value])]
              [final-state : LowerState
                (lower-state-emit
                  return-state
                  (CompilerIrInstr.Return
                    (if (tc-type-eq ret-ty (AstType.Unit))
                      (CompilerIrMaybeValue.No)
                      (CompilerIrMaybeValue.Some return-value))))]
              (ResultLowerFunction.Ok
                (lower-state-build-functions-with
                  final-state
                  (CompilerIrFunction.Function
                    hidden-name
                    (compiler-ir-param-cons
                      (CompilerIrParam.Param
                        "__tl_spmd_active_mask"
                        (AstType.Bool)
                        0)
                      (let
                        [source-params : CompilerIrParamList
                          (lower-spmd-private-param-list ctx params call-args 1)]
                        (if (or
                          (= (string.string-length helper-index) 0)
                          (>= helper-index-source-param 0))
                          source-params
                          (lower-spmd-private-param-list-append-index
                            source-params
                            source-param-count))))
                    ret-ty
                    (lower-state-next-var final-state)
                    (lower-state-build-function-blocks final-state)))
                (lower-state-spans final-state)))])]
      [(ResultLowerExpr.Err message) (ResultLowerFunction.Err message)])))

(define (lower-spmd-scalar-helper-function
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [hidden-name : i64]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [param-count : i64 (+ 1 (lower-param-count params))]
    [ret-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ret))]
    [hidden-name-text : String (compiler-ir-symbol-text hidden-name)]
    [function-spans : CompilerSourceSpans
      (lower-record-function-span spans hidden-name-text body)]
    [state : LowerState
      (LowerState.State
        param-count
        0
        0
        "entry"
        (compiler-ir-instr-builder-new)
        (compiler-ir-block-builder-new)
        (compiler-ir-function-builder-new)
        hidden-name-text
        (box function-spans)
        names
        type-cache
        mode
        (lower_i64_i64_map.with-capacity 8)
        1
        param-count)]
    [env : sym_i64_env.SymI64Env
      (lower-bind-params params 1 (sym_i64_env.sym-i64-empty))]
    [type-env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-params ctx (tc-hygiene-global-env top-env) params)
        ret-ty)]
    (match (lower-tail-expr ctx state env type-env body ret-ty (- 0 1))
      [(ResultLowerState.Ok final-state)
        (ResultLowerFunction.Ok
          (lower-state-build-functions-with
            final-state
            (CompilerIrFunction.Function
              hidden-name
              (compiler-ir-param-cons
                (CompilerIrParam.Param "__tl_spmd_active_mask" (AstType.Bool) 0)
                (lower-param-list ctx params 1))
              ret-ty
              (lower-state-next-var final-state)
              (lower-state-build-function-blocks final-state)))
          (lower-state-spans final-state))]
      [(ResultLowerState.Err message) (ResultLowerFunction.Err message)])))

(define (lower-spmd-specialized-helper-function
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [hidden-name : i64]
  [params : AstParamList]
  [ret : AstType]
  [result-varying : bool]
  [body : AstExpr]
  [backend : CompilerIrSpmdBackend]
  [call-args : CompilerIrSpmdCallArgList]
  [lanes : i64]
  [helper-index : String]
  [helper-index-source-param : i64]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match backend
    [(CompilerIrSpmdBackend.Scalar)
      (lower-spmd-scalar-helper-function
        ctx
        top-env
        type-cache
        hidden-name
        params
        ret
        body
        spans
        names
        mode)]
    [(CompilerIrSpmdBackend.Avx512)
      (lower-spmd-avx512-helper-function
        ctx
        top-env
        type-cache
        hidden-name
        params
        ret
        result-varying
        body
        call-args
        lanes
        helper-index
        helper-index-source-param
        spans
        names
        mode)]
    [(CompilerIrSpmdBackend.Avx2)
      (ResultLowerFunction.Err
        (box
          (lower-diagnostic
            "lower: out-of-line varying SPMD calls are not supported in AVX2 backend mode; use scalar or avx512")))]))

(define (lower-spmd-package-specialization-function-active
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [specialization : AstSpmdSpecialization]
  [backend : CompilerIrSpmdBackend]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [validation-error : String
      (lower-spmd-package-specialization-validation-error
        ctx
        top-env
        params
        ret
        body
        specialization)]
    (if (not (string.eq validation-error ""))
      (ResultLowerFunction.Err (box (lower-diagnostic validation-error)))
      (let
        [classes : AstSpmdParamClassList
          (box-get (struct-get specialization args))]
        [args-code : String (lower-spmd-ast-param-classes-code classes)]
        [result-code : String
          (lower-spmd-ast-result-class-code (struct-get specialization result))]
        [signature : String (lower-spmd-source-signature params ret)]
        [lanes : i64
          (match backend
            [(CompilerIrSpmdBackend.Scalar) 1]
            [_ (struct-get specialization lanes)])]
        [index-param : i64 (struct-get specialization index-param)]
        [hidden-name-text : String
          (lower-spmd-package-symbol
            lower-spmd-package-name
            canonical-name
            signature
            ret
            backend
            lanes
            args-code
            result-code
            index-param)]
        [hidden-name : i64
          (ci.intern-generated-canonical-name hidden-name-text)]
        [symbol-identity : String
          (lower-spmd-package-symbol-identity
            lower-spmd-package-name
            canonical-name
            signature
            backend
            lanes
            args-code
            result-code
            index-param)]
        [registration : LowerSpmdPackageSymbolRegistration
          (lower-spmd-package-symbol-register hidden-name symbol-identity)]
        [call-args : CompilerIrSpmdCallArgList
          (lower-spmd-package-call-args-at ctx (& params) (& classes) 0)]
        [index-name : String
          (lower-spmd-package-index-name (& params) index-param)]
        (match registration
          [(LowerSpmdPackageSymbolRegistration.Existing)
            (ResultLowerFunction.Ok CompilerIrFunctionList.Nil spans)]
          [(LowerSpmdPackageSymbolRegistration.Collision collision-error)
            (ResultLowerFunction.Err (box (lower-diagnostic collision-error)))]
          [(LowerSpmdPackageSymbolRegistration.New)
            (lower-spmd-specialized-helper-function
              ctx
              top-env
              type-cache
              hidden-name
              params
              ret
              (match (struct-get specialization result)
                [(AstSpmdResultClass.Varying) true]
                [_ false])
              body
              backend
              call-args
              lanes
              index-name
              index-param
              spans
              names
              mode)])))))

(define (lower-spmd-package-specialization-function
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [specialization : AstSpmdSpecialization]
  [backend : CompilerIrSpmdBackend]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [previous : LowerIdSet lower-spmd-inline-helper-stack]
    (begin
      (set!
        lower-spmd-inline-helper-stack
        (lower-id-set-insert previous canonical-handle))
      (let
        [result : ResultLowerFunction
          (lower-spmd-package-specialization-function-active
            ctx
            top-env
            type-cache
            canonical-name
            params
            ret
            body
            specialization
            backend
            spans
            names
            mode)]
        (begin
          (set! lower-spmd-inline-helper-stack previous)
          result)))))

(define (lower-spmd-package-specializations-from
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [specializations : (& specializations AstSpmdSpecializationList)]
  [index : i64]
  [limit : i64]
  [backend : CompilerIrSpmdBackend]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]
  [functions : CompilerIrFunctionBuilder]) : ResultLowerFunction
  (if (or
    (>= index limit)
    (>= index (ast-spmd-specialization-list-len specializations)))
    (ResultLowerFunction.Ok
      (compiler-ir-function-builder-to-list functions)
      spans)
    (let
      [fallback : AstSpmdSpecialization
        (AstSpmdSpecialization
          2
          (box (ast-spmd-param-class-list-new))
          AstSpmdResultClass.Unit
          -1)]
      (match (lower-spmd-package-specialization-function
        ctx
        top-env
        type-cache
        canonical-name
        canonical-handle
        params
        ret
        body
        (ast-spmd-specialization-list-get specializations index fallback)
        backend
        spans
        names
        mode)
        [(ResultLowerFunction.Err message) (ResultLowerFunction.Err message)]
        [(ResultLowerFunction.Ok lowered next-spans)
          (let
            [next-functions : CompilerIrFunctionBuilder functions]
            (begin
              (compiler-ir-function-builder-append-list!
                (&mut next-functions)
                lowered)
              (lower-spmd-package-specializations-from
                ctx
                top-env
                type-cache
                canonical-name
                canonical-handle
                params
                ret
                body
                specializations
                (+ index 1)
                limit
                backend
                next-spans
                names
                mode
                next-functions)))]))))

(define (lower-spmd-package-callable-functions
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [callable : AstSpmdCallable]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match callable
    [(AstSpmdCallable.No)
      (ResultLowerFunction.Ok CompilerIrFunctionList.Nil spans)]
    [(AstSpmdCallable.Callable specializations)
      (if (= (string.string-length lower-spmd-package-name) 0)
        (ResultLowerFunction.Err
          (box
            (lower-diagnostic
              "lower: :spmd-callable is only supported while building a package")))
        (if (lower-mode-avx2? mode)
          (ResultLowerFunction.Err
            (box
              (lower-diagnostic
                "lower: :spmd-callable is not supported in AVX2 backend mode; use scalar or avx512")))
          (let
            [backend : CompilerIrSpmdBackend
              (if (lower-mode-avx512? mode)
                CompilerIrSpmdBackend.Avx512
                CompilerIrSpmdBackend.Scalar)]
            [count : i64 (ast-spmd-specialization-list-len (& specializations))]
            (lower-spmd-package-specializations-from
              ctx
              top-env
              type-cache
              canonical-name
              canonical-handle
              params
              ret
              body
              (& specializations)
              0
              count
              backend
              spans
              names
              mode
              (compiler-ir-function-builder-with-capacity count)))))]))

(define (lower-avx512-emit-spmd-call
  [state : LowerState]
  [hidden-name : i64]
  [backend : CompilerIrSpmdBackend]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [call-args : CompilerIrSpmdCallArgList]
  [result-ty : AstType]
  [result-varying : bool]
  [expr : AstExpr]) : ResultLowerExpr
  (if (tc-type-eq result-ty (AstType.Unit))
    (let
      [instr : CompilerIrInstr
        (ir-instr-spmd-call
          hidden-name
          backend
          lanes
          active-mask
          call-args
          (CompilerIrSpmdCallResult.Unit))]
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr state instr expr)
          CompilerIrValue.Unit
          result-ty)))
    (match (lower-state-alloc-var state)
      [(LowerAlloc.Alloc allocated result-var)
        (let
          [result-class : CompilerIrSpmdValueClass
            (lower-spmd-ir-value-class result-ty result-varying)]
          [instr : CompilerIrInstr
            (ir-instr-spmd-call
              hidden-name
              backend
              lanes
              active-mask
              call-args
              (CompilerIrSpmdCallResult.Value result-var result-class result-ty))]
          [call-state : LowerState
            (lower-state-emit-at-expr allocated instr expr)]
          (if (or
            result-varying
            (match backend
              [(CompilerIrSpmdBackend.Scalar) true]
              [_ false]))
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                call-state
                (CompilerIrValue.Var result-var)
                result-ty))
            (ResultLowerExpr.Ok
              (lower-emit-splat
                call-state
                (CompilerIrValue.Var result-var)
                lanes
                result-ty))))])))

(define (lower-avx512-uniform-spmd-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [result-ty : AstType]
  [lanes : i64]
  [expr : AstExpr]) : ResultLowerExpr
  (match (lower-call ctx state env type-env func args result-ty expr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr call-state call-value call-ty)
          (if (or
            (tc-type-eq call-ty (AstType.Unit))
            (lower-type-bool? call-ty))
            (ResultLowerExpr.Ok lowered)
            (ResultLowerExpr.Ok
              (lower-emit-splat call-state call-value lanes call-ty)))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-imported-spmd-avx512-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]
  [canonical-name : i64]
  [fn-ty : AstType]
  [callables : AstImportedSpmdCallableList]) : ResultLowerExpr
  (match fn-ty
    [(AstType.Func param-types ret-id)
      (match (lower-expr-result-type-or-check
        ctx
        env
        type-env
        (lower-state-type-cache state)
        expr)
        [(ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]
        [(ResultTcType.Ok result-ty)
          (let
            [params : AstParamList
              (lower-imported-spmd-params ctx (box-get param-types))]
            [ret : AstType (tc-context-type-get ctx ret-id)]
            [arg-lanes : i64
              (lower-spmd-call-args-lanes
                ctx
                (lower-state-mode state)
                env
                type-env
                index
                (lower-masked-vector-lane-locals-from-set lane-locals lanes)
                args)]
            (if (= arg-lanes 0)
              (lower-avx512-uniform-spmd-call
                ctx
                state
                env
                type-env
                func
                args
                result-ty
                lanes
                expr)
              (match (lower-avx512-spmd-call-args
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                params
                args)
                [(ResultLowerSpmdCallArgs.Err message)
                  (ResultLowerExpr.Err message)]
                [(ResultLowerSpmdCallArgs.Ok args-state call-args any-varying)
                  (if (not any-varying)
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          expr
                          "lower: inconsistent imported SPMD helper argument classification")))
                    (let
                      [args-code : String
                        (lower-imported-spmd-call-args-code call-args)]
                      [signature : String
                        (lower-spmd-source-signature params ret)]
                      [requested-index-param : i64
                        (lower-imported-spmd-index-param ctx index args)]
                      (match (lower-imported-spmd-select
                        canonical-name
                        (& callables)
                        signature
                        (CompilerIrSpmdBackend.Avx512)
                        lanes
                        args-code
                        requested-index-param
                        ret
                        expr)
                        [(ResultLowerImportedSpmdSpecialization.Err message)
                          (ResultLowerExpr.Err message)]
                        [(ResultLowerImportedSpmdSpecialization.Ok
                            specialization)
                          (lower-avx512-emit-spmd-call
                            args-state
                            (lower-imported-spmd-ir-symbol specialization)
                            (CompilerIrSpmdBackend.Avx512)
                            active-mask
                            lanes
                            call-args
                            result-ty
                            (lower-imported-spmd-result-varying? specialization)
                            expr)])))])))])]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            expr
            "lower: imported SPMD helper does not have function type")))]))

(define (lower-avx512-spmd-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]) : ResultLowerExpr
  (match (lower-spmd-inline-helper-lookup ctx env type-env lane-locals func)
    [(ResultLowerSpmdInlineHelper.Ok helper)
      (match helper
        [(LowerSpmdInlineHelper.Some name params ret body)
          (match (lower-expr-result-type-or-check
            ctx
            env
            type-env
            (lower-state-type-cache state)
            expr)
            [(ResultTcType.Ok result-ty)
              (let
                [arg-lanes : i64
                  (lower-spmd-call-args-lanes
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    (lower-masked-vector-lane-locals-from-set lane-locals lanes)
                    args)]
                (if (= arg-lanes 0)
                  (lower-avx512-uniform-spmd-call
                    ctx
                    state
                    env
                    type-env
                    func
                    args
                    result-ty
                    lanes
                    expr)
                  (match (lower-avx512-spmd-call-args
                    ctx
                    state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    params
                    args)
                    [(ResultLowerSpmdCallArgs.Ok
                        args-state
                        call-args
                        any-varying)
                      (if (not any-varying)
                        (ResultLowerExpr.Err
                          (box
                            (lower-diagnostic-at-expr
                              expr
                              "lower: inconsistent SPMD helper argument classification")))
                        (match (lower-state-fresh-lambda-name args-state)
                          [(LowerLambdaName.Name named-state hidden-name)
                            (let
                              [helper-index : String
                                (lower-spmd-helper-index-param
                                  ctx
                                  index
                                  params
                                  args)]
                              [abi-call-args : CompilerIrSpmdCallArgList
                                (if (= (string.string-length helper-index) 0)
                                  call-args
                                  (lower-spmd-call-args-append
                                    call-args
                                    (CompilerIrSpmdCallArg.Arg
                                      (CompilerIrSpmdValueClass.Uniform)
                                      (CompilerIrValue.Var index-var)
                                      (AstType.I64))))]
                              [result-varying : bool
                                (>
                                  (lower-spmd-direct-call-result-lanes
                                    ctx
                                    (lower-state-mode named-state)
                                    env
                                    type-env
                                    index
                                    (lower-masked-vector-lane-locals-from-set
                                      lane-locals
                                      lanes)
                                    func
                                    args)
                                  0)]
                              [private-name : i64
                                (lower-spmd-private-helper-name
                                  hidden-name
                                  result-ty
                                  result-varying)]
                              (match (lower-spmd-specialized-helper-function
                                ctx
                                type-env
                                (lower-state-type-cache named-state)
                                private-name
                                params
                                ret
                                result-varying
                                body
                                (CompilerIrSpmdBackend.Avx512)
                                abi-call-args
                                lanes
                                helper-index
                                -1
                                (lower-state-spans named-state)
                                (lower-state-names named-state)
                                (lower-state-mode named-state))
                                [(ResultLowerFunction.Ok functions helper-spans)
                                  (lower-avx512-emit-spmd-call
                                    (lower-state-add-functions
                                      named-state
                                      functions
                                      helper-spans)
                                    private-name
                                    (CompilerIrSpmdBackend.Avx512)
                                    active-mask
                                    lanes
                                    abi-call-args
                                    result-ty
                                    result-varying
                                    expr)]
                                [(ResultLowerFunction.Err message)
                                  (ResultLowerExpr.Err message)]))]))]
                    [(ResultLowerSpmdCallArgs.Err message)
                      (ResultLowerExpr.Err message)])))]
            [(ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr expr message)))])]
        [(LowerSpmdInlineHelper.Imported canonical-name fn-ty callables)
          (lower-imported-spmd-avx512-call
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            expr
            func
            args
            canonical-name
            fn-ty
            (box-get callables))]
        [(LowerSpmdInlineHelper.No)
          (lower-avx512-masked-unsupported expr "non-direct SPMD helper calls")])]
    [(ResultLowerSpmdInlineHelper.Err message) (ResultLowerExpr.Err message)]))

(define (lower-avx512-masked-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner))]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Bool value)
          (ResultLowerExpr.Ok
            (lower-avx512-masked-bool-literal state active-mask lanes value))]
        [_
          (ResultLowerExpr.Ok
            (lower-emit-splat
              state
              (lower-literal-value-with-type lit (tc-literal-type lit))
              lanes
              (tc-literal-type lit)))])]
    [(AstExpr.SpmdProgramIndex)
      (ResultLowerExpr.Ok (lower-emit-lane-id state lanes (AstType.I64)))]
    [(AstExpr.SpmdProgramCount)
      (ResultLowerExpr.Ok
        (lower-emit-splat state (CompilerIrValue.I64 lanes) lanes (AstType.I64)))]
    [(AstExpr.Var name)
      (lower-avx512-masked-var
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        lanes
        expr
        name)]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match op
          [(AstUnOp.Not)
            (match (lower-avx512-masked-expr
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              inner)
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr next-state value _)
                    (ResultLowerExpr.Ok
                      (lower-emit-mask-not next-state value lanes))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [_ (lower-avx512-masked-unsupported expr "this unary operator")]))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (lower-avx512-masked-binary
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr
          op
          left
          right))]
    [(AstExpr.Call func-box args)
      (lower-avx512-spmd-call
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (lower-context-expr-get ctx func-box)
        args)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-avx512-masked-let-bindings
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              bindings)
              [(ResultLowerEnv.Ok bound-state bound-env bound-type-env)
                (lower-avx512-masked-expr
                  ctx
                  bound-state
                  bound-env
                  bound-type-env
                  (lower-masked-vector-let-binding-names bindings lane-locals)
                  index
                  index-var
                  active-mask
                  lanes
                  body)]
              [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))])]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          expr)
          [(ResultTcType.Ok result-ty)
            (lower-avx512-masked-if
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              result-ty
              expr
              cond
              then-branch
              else-branch)]
          [(ResultTcType.Err message)
            (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (match (lower-expr-result-type-or-check
            ctx
            env
            type-env
            (lower-state-type-cache state)
            expr)
            [(ResultTcType.Ok result-ty)
              (lower-avx512-masked-match
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                result-ty
                expr
                (lower-context-expr-get ctx scrutinee-box)
                arms)]
            [(ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr expr message)))])])]
    [(AstExpr.While cond-box body-box)
      (lower-avx512-masked-while
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        (lower-context-expr-get ctx cond-box)
        (lower-context-expr-get ctx body-box))]
    [(AstExpr.Begin exprs)
      (lower-avx512-masked-begin
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        (lower-avx512-masked-array-ref
          ctx
          state
          env
          type-env
          index
          index-var
          active-mask
          lanes
          expr
          arr
          idx))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (lower-avx512-masked-array-set
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr
          arr
          idx
          value))]
    [_ (lower-avx512-masked-unsupported expr "this branch expression")]))

(define (lower-avx512-masked-expr-expected
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [expr : AstExpr]
  [expected-ty : AstType]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner
          expected-ty))]
    [(AstExpr.Literal lit)
      (ResultLowerExpr.Ok
        (lower-emit-splat
          state
          (lower-literal-value-with-type
            lit
            (tc-type-without-regions expected-ty))
          lanes
          (tc-type-without-regions expected-ty)))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (lower-avx512-masked-if
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expected-ty
          expr
          cond
          then-branch
          else-branch))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (lower-avx512-masked-match
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            expected-ty
            expr
            (lower-context-expr-get ctx scrutinee-box)
            arms)])]
    [_
      (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr)]))

(define (lower-avx512-tail-map-body
  [ctx : TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : CompilerIrValue]
  [plan : LowerMaybeVectorMap]) : LowerState
  (match plan
    [(LowerMaybeVectorMap.Some stores elem-ty lanes)
      (let
        [s : LowerState state]
        [count : i64 (struct-get stores count)]
        [results : (Array CompilerIrValue) (make-array CompilerIrValue count)]
        [store-index : i64 0]
        [cache : LowerVectorMapValueCache (lower-vector-map-value-cache-empty)]
        [mask : CompilerIrValue CompilerIrValue.Unit]
        [result-vec : CompilerIrValue CompilerIrValue.Unit]
        (begin
          (match (lower-emit-tail-mask
            s
            (CompilerIrValue.Var index-var)
            end-value
            lanes)
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! mask value))])
          (while (< store-index count)
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore _ value-plan)
                (begin
                  (match (lower-emit-vector-map-value-cached
                    ctx
                    s
                    index-var
                    lanes
                    elem-ty
                    value-plan
                    (LowerVectorMapEmitMode.Predicated end-value mask)
                    cache)
                    [(LowerVectorMapCachedEmit.Emit next-s value next-cache)
                      (begin
                        (set! s next-s)
                        (set! result-vec value)
                        (set! cache next-cache))])
                  (array-set! results store-index result-vec)
                  (set! store-index (+ store-index 1)))]))
          (set! store-index 0)
          (while (< store-index count)
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore dst-array _)
                (begin
                  (set!
                    s
                    (lower-emit-predicated-store
                      s
                      (CompilerIrValue.Var dst-array)
                      (CompilerIrValue.Var index-var)
                      (array-ref results store-index)
                      mask
                      lanes
                      elem-ty))
                  (set! store-index (+ store-index 1)))]))
          s))]
    [(LowerMaybeVectorMap.No) state]))

(define (lower-avx512-masked-map-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : AstType]
  [index-var : i64]
  [active-mask : CompilerIrValue]
  [lanes : i64]
  [body : AstExpr]) : ResultLowerExpr
  (lower-avx512-masked-expr
    ctx
    state
    (sym_i64_env.sym-i64-bind-id env index-id index-var)
    (tc-bind-id type-env index-id index-ty)
    LowerIdSet.Nil
    index
    index-var
    active-mask
    lanes
    body))

(define (lower-avx512-masked-foreach-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]
  [plan : LowerMaybeMaskedVectorMap]) : ResultLowerExpr
  (match plan
    [(LowerMaybeMaskedVectorMap.Some lanes)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov index-var start-value index-ty))]
            [body-env : sym_i64_env.SymI64Env
              (sym_i64_env.sym-i64-bind-id env index-id index-var)]
            [body-type-env : TcTypeEnv (tc-bind-id type-env index-id index-ty)]
            [arrays : LowerArrayVarSet
              (lower-masked-vector-array-vars
                ctx
                body-env
                body-type-env
                index
                body)]
            [header-label : String ""]
            [body-label : String ""]
            [tail-header-label : String ""]
            [tail-check-label : String ""]
            [tail-mask-label : String ""]
            [tail-body-label : String ""]
            [exit-label : String ""]
            [vector-limit : CompilerIrValue CompilerIrValue.Unit]
            [vector-start-ok : CompilerIrValue CompilerIrValue.Unit]
            [next-index : CompilerIrValue CompilerIrValue.Unit]
            [vector-ok : CompilerIrValue CompilerIrValue.Unit]
            [tail-cond : CompilerIrValue CompilerIrValue.Unit]
            [tail-safe : CompilerIrValue CompilerIrValue.Unit]
            [active-mask : CompilerIrValue CompilerIrValue.Unit]
            (begin
              (match (lower-state-fresh-label s "foreach_avx512_mask_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "foreach_avx512_mask_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "foreach_tail_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (match (lower-state-fresh-label s "foreach_tail_check")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-check-label label))])
              (match (lower-state-fresh-label s "foreach_tail_mask")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-mask-label label))])
              (match (lower-state-fresh-label s "foreach_tail_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "foreach_exit")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (match (lower-vector-loop-limit s end-value arrays lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-limit value))])
              (match (lower-vector-loop-start-ok s index-var lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-start-ok value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      vector-start-ok
                      header-label
                      tail-header-label))
                  header-label))
              (match (lower-emit-binop
                s
                (CompilerIrBinOp.Add)
                (CompilerIrValue.Var index-var)
                (CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! next-index value))])
              (match (lower-vector-loop-next-ok s next-index vector-limit)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      vector-ok
                      body-label
                      tail-header-label))
                  body-label))
              (match (lower-emit-tail-mask
                s
                (CompilerIrValue.Var index-var)
                next-index
                lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! active-mask value))])
              (match (lower-avx512-masked-map-body
                ctx
                s
                env
                type-env
                index-id
                index
                index-ty
                index-var
                active-mask
                lanes
                body)
                [(ResultLowerExpr.Ok lowered-body)
                  (match lowered-body
                    [(LowerExpr.Expr body-state _ _)
                      (set!
                        s
                        (lower-state-emit
                          body-state
                          (CompilerIrInstr.Mov index-var next-index index-ty)))])]
                [(ResultLowerExpr.Err message)
                  (return (ResultLowerExpr.Err message))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (CompilerIrInstr.Jump header-label))
                  tail-header-label))
              (match (lower-vector-loop-i64-compare
                s
                (CompilerIrBinOp.Lt)
                (CompilerIrValue.Var index-var)
                end-value)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! tail-cond value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      tail-cond
                      tail-check-label
                      exit-label))
                  tail-check-label))
              (match (lower-avx512-masked-tail-ok s index-var end-value arrays)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! tail-safe value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      tail-safe
                      tail-mask-label
                      tail-body-label))
                  tail-mask-label))
              (match (lower-emit-tail-mask
                s
                (CompilerIrValue.Var index-var)
                end-value
                lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! active-mask value))])
              (match (lower-avx512-masked-map-body
                ctx
                s
                env
                type-env
                index-id
                index
                index-ty
                index-var
                active-mask
                lanes
                body)
                [(ResultLowerExpr.Ok lowered-tail)
                  (match lowered-tail
                    [(LowerExpr.Expr tail-state _ _)
                      (set!
                        s
                        (lower-state-finish-block
                          (lower-state-emit
                            tail-state
                            (CompilerIrInstr.Jump exit-label))
                          tail-body-label))])]
                [(ResultLowerExpr.Err message)
                  (return (ResultLowerExpr.Err message))])
              (match (lower-expr ctx s body-env body-type-env body)
                [(ResultLowerExpr.Ok scalar-tail-lowered)
                  (match scalar-tail-lowered
                    [(LowerExpr.Expr post-body-state _ _)
                      (match (lower-state-alloc-var post-body-state)
                        [(LowerAlloc.Alloc inc-alloc inc-var)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (lower-state-finish-block
                                (lower-state-emit
                                  (lower-state-emit
                                    (lower-state-emit
                                      inc-alloc
                                      (CompilerIrInstr.BinOp
                                        inc-var
                                        CompilerIrBinOp.Add
                                        (CompilerIrValue.Var index-var)
                                        (CompilerIrValue.I64 1)
                                        index-ty))
                                    (CompilerIrInstr.Mov
                                      index-var
                                      (CompilerIrValue.Var inc-var)
                                      index-ty))
                                  (CompilerIrInstr.Jump tail-header-label))
                                exit-label)
                              CompilerIrValue.Unit
                              (AstType.Unit)))])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))])]
    [(LowerMaybeMaskedVectorMap.No)
      (lower-scalar-foreach-lowered
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start-value
        end-value
        body)]))

;; Scalar `foreach` lowering. `(foreach ([i : ty start end]) body)`
;; lowers to the half-open reference loop `i = start; while (i < end) { body;
;; i = i + 1 }`, yielding unit. `start` and `end` are each lowered exactly once
;; before the loop; the index binding is scoped to the body. Mirrors lower-while
;; with an index var, a `<` guard, and a `+ 1` increment.
(define (lower-spmd-scalar-body-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [body : AstExpr]) : ResultLowerExpr
  (let
    [previous : LowerSpmdScalarCallContext lower-spmd-scalar-call-context]
    [result : ResultLowerExpr
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: SPMD scalar body lowering failed")))]
    (begin
      (set!
        lower-spmd-scalar-call-context
        (LowerSpmdScalarCallContext.Some index))
      (set! result (lower-expr ctx state env type-env body))
      (set! lower-spmd-scalar-call-context previous)
      result)))

(define (lower-scalar-foreach-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc index-alloc index-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          index-alloc
          (CompilerIrInstr.Mov index-var start-value index-ty))
        "foreach_header")
        [(LowerLabel.Label header-ls header-label)
          (match (lower-state-fresh-label header-ls "foreach_body")
            [(LowerLabel.Label body-ls body-label)
              (match (lower-state-fresh-label body-ls "foreach_exit")
                [(LowerLabel.Label exit-ls exit-label)
                  (match (lower-state-alloc-var
                    (lower-state-finish-block
                      (lower-state-emit
                        exit-ls
                        (CompilerIrInstr.Jump header-label))
                      header-label))
                    [(LowerAlloc.Alloc cond-alloc cond-var)
                      (match (lower-spmd-scalar-body-expr
                        ctx
                        (lower-state-finish-block
                          (lower-state-emit
                            (lower-state-emit
                              cond-alloc
                              (CompilerIrInstr.BinOp
                                cond-var
                                CompilerIrBinOp.Lt
                                (CompilerIrValue.Var index-var)
                                end-value
                                index-ty))
                            (CompilerIrInstr.Branch
                              (CompilerIrValue.Var cond-var)
                              body-label
                              exit-label))
                          body-label)
                        (sym_i64_env.sym-i64-bind-id env index-id index-var)
                        (tc-bind-id type-env index-id index-ty)
                        index
                        body)
                        [(ResultLowerExpr.Ok body-lowered)
                          (match body-lowered
                            [(LowerExpr.Expr post-body-state _ _)
                              (match (lower-state-alloc-var post-body-state)
                                [(LowerAlloc.Alloc inc-alloc inc-var)
                                  (ResultLowerExpr.Ok
                                    (LowerExpr.Expr
                                      (lower-state-finish-block
                                        (lower-state-emit
                                          (lower-state-emit
                                            (lower-state-emit
                                              inc-alloc
                                              (CompilerIrInstr.BinOp
                                                inc-var
                                                CompilerIrBinOp.Add
                                                (CompilerIrValue.Var index-var)
                                                (CompilerIrValue.I64 1)
                                                index-ty))
                                            (CompilerIrInstr.Mov
                                              index-var
                                              (CompilerIrValue.Var inc-var)
                                              index-ty))
                                          (CompilerIrInstr.Jump header-label))
                                        exit-label)
                                      CompilerIrValue.Unit
                                      (AstType.Unit)))])])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])])])])]))

(define (lower-avx2-foreach-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]
  [plan : LowerMaybeVectorMap]) : ResultLowerExpr
  (match plan
    [(LowerMaybeVectorMap.Some stores elem-ty lanes)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov index-var start-value index-ty))]
            [arrays : LowerArrayVarSet
              (lower-vector-map-store-list-array-vars stores)]
            [header-label : String ""]
            [body-label : String ""]
            [tail-header-label : String ""]
            [tail-check-label : String ""]
            [tail-mask-label : String ""]
            [tail-body-label : String ""]
            [exit-label : String ""]
            [vector-limit : CompilerIrValue CompilerIrValue.Unit]
            [vector-start-ok : CompilerIrValue CompilerIrValue.Unit]
            [next-index : CompilerIrValue CompilerIrValue.Unit]
            [vector-ok : CompilerIrValue CompilerIrValue.Unit]
            [tail-cond : CompilerIrValue CompilerIrValue.Unit]
            [tail-safe : CompilerIrValue CompilerIrValue.Unit]
            [preheader-cache : LowerVectorMapValueCache
              (lower-vector-map-value-cache-empty)]
            (begin
              (match (lower-state-fresh-label s "foreach_avx2_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "foreach_avx2_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "foreach_tail_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (match (lower-state-fresh-label s "foreach_tail_check")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-check-label label))])
              (match (lower-state-fresh-label s "foreach_tail_mask")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-mask-label label))])
              (match (lower-state-fresh-label s "foreach_tail_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "foreach_exit")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (match (lower-vector-loop-limit s end-value arrays lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-limit value))])
              (match (lower-vector-loop-start-ok s index-var lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-start-ok value))])
              (match (lower-vector-map-preheader-cache-stores
                s
                arrays
                stores
                lanes
                elem-ty)
                [(LowerVectorMapCachedEmit.Emit next-s _ next-cache)
                  (begin
                    (set! s next-s)
                    (set! preheader-cache next-cache))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      vector-start-ok
                      header-label
                      tail-header-label))
                  header-label))
              (match (lower-emit-binop
                s
                (CompilerIrBinOp.Add)
                (CompilerIrValue.Var index-var)
                (CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! next-index value))])
              (match (lower-vector-loop-next-ok s next-index vector-limit)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (CompilerIrInstr.Branch
                      vector-ok
                      body-label
                      tail-header-label))
                  body-label))
              (set!
                s
                (lower-avx2-vector-map-body
                  ctx
                  s
                  index-var
                  next-index
                  plan
                  preheader-cache))
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (CompilerIrInstr.Jump header-label))
                  tail-header-label))
              (match (lower-vector-loop-i64-compare
                s
                (CompilerIrBinOp.Lt)
                (CompilerIrValue.Var index-var)
                end-value)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! tail-cond value))])
              (set!
                s
                (if (lower-mode-avx512? (lower-state-mode s))
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (CompilerIrInstr.Branch
                        tail-cond
                        tail-check-label
                        exit-label))
                    tail-check-label)
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (CompilerIrInstr.Branch
                        tail-cond
                        tail-body-label
                        exit-label))
                    tail-body-label)))
              (if (lower-mode-avx512? (lower-state-mode s))
                (if (lower-maybe-vector-map-has-gather? plan)
                  ;; Gather sources require per-lane scalar tail semantics.
                  ;; Enter the ordinary one-iteration tail body directly
                  ;; instead of materializing a predicated vector value that
                  ;; cannot represent those source checks.
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (CompilerIrInstr.Jump tail-body-label))
                      tail-body-label))
                  (begin
                    (match (lower-avx512-masked-tail-ok
                      s
                      index-var
                      end-value
                      arrays)
                      [(LowerExpr.Expr next-s value _)
                        (begin
                          (set! s next-s)
                          (set! tail-safe value))])
                    (set!
                      s
                      (lower-state-finish-block
                        (lower-state-emit
                          s
                          (CompilerIrInstr.Branch
                            tail-safe
                            tail-mask-label
                            tail-body-label))
                        tail-mask-label))
                    (set!
                      s
                      (lower-avx512-tail-map-body
                        ctx
                        s
                        index-var
                        end-value
                        plan))
                    (set!
                      s
                      (lower-state-finish-block
                        (lower-state-emit s (CompilerIrInstr.Jump exit-label))
                        tail-body-label))))
                unit)
              (if (and
                (lower-maybe-vector-map-needs-scalar-tail? plan)
                (or
                  (not (lower-mode-avx512? (lower-state-mode s)))
                  (lower-maybe-vector-map-has-gather? plan)
                  (lower-maybe-vector-map-has-shuffle? plan)))
                (match plan
                  [(LowerMaybeVectorMap.Some stores elem-ty store-lanes)
                    (lower-avx2-broadcast-tail-map-body
                      ctx
                      s
                      index-var
                      end-value
                      stores
                      elem-ty
                      store-lanes
                      exit-label)]
                  [(LowerMaybeVectorMap.No)
                    (ResultLowerExpr.Err
                      (box (lower-diagnostic "lower: missing vector map plan")))])
                (match (lower-expr
                  ctx
                  s
                  (sym_i64_env.sym-i64-bind-id env index-id index-var)
                  (tc-bind-id type-env index-id index-ty)
                  body)
                  [(ResultLowerExpr.Ok body-lowered)
                    (match body-lowered
                      [(LowerExpr.Expr post-body-state _ _)
                        (match (lower-state-alloc-var post-body-state)
                          [(LowerAlloc.Alloc inc-alloc inc-var)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                (lower-state-finish-block
                                  (lower-state-emit
                                    (lower-state-emit
                                      (lower-state-emit
                                        inc-alloc
                                        (CompilerIrInstr.BinOp
                                          inc-var
                                          CompilerIrBinOp.Add
                                          (CompilerIrValue.Var index-var)
                                          (CompilerIrValue.I64 1)
                                          index-ty))
                                      (CompilerIrInstr.Mov
                                        index-var
                                        (CompilerIrValue.Var inc-var)
                                        index-ty))
                                    (CompilerIrInstr.Jump tail-header-label))
                                  exit-label)
                                CompilerIrValue.Unit
                                (AstType.Unit)))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))])]
    [(LowerMaybeVectorMap.No)
      (lower-scalar-foreach-lowered
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start-value
        end-value
        body)]))

(define (lower-foreach-lowered-inlined
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]) : ResultLowerExpr
  (if (and
    (lower-mode-simd? (lower-state-mode state))
    (lower-type-i64? index-ty))
    (match (lower-simple-vector-map
      ctx
      (lower-state-mode state)
      env
      type-env
      index
      body)
      [(LowerMaybeVectorMap.Some _ _ _)
        (lower-avx2-foreach-lowered
          ctx
          state
          env
          type-env
          index-id
          index
          index-ty
          start-value
          end-value
          body
          (lower-simple-vector-map
            ctx
            (lower-state-mode state)
            env
            type-env
            index
            body))]
      [(LowerMaybeVectorMap.No)
        (if (lower-vector-body-has-atomic-call? ctx env type-env body)
          (lower-scalar-foreach-lowered
            ctx
            state
            env
            type-env
            index-id
            index
            index-ty
            start-value
            end-value
            body)
          (match (lower-masked-vector-map
            ctx
            (lower-state-mode state)
            env
            type-env
            index
            body)
            [(LowerMaybeMaskedVectorMap.Some _)
              (lower-avx512-masked-foreach-lowered
                ctx
                state
                env
                type-env
                index-id
                index
                index-ty
                start-value
                end-value
                body
                (lower-masked-vector-map
                  ctx
                  (lower-state-mode state)
                  env
                  type-env
                  index
                  body))]
            [(LowerMaybeMaskedVectorMap.No)
              (cond
                [(lower-masked-vector-body-has-varying-while?
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          (lower-avx2-varying-while-diagnostic)
                          "lower: SPMD varying while AVX-512 lowering is not available for this backend mode or loop shape"))))]
                [(lower-masked-vector-body-has-varying-if?
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          (lower-avx2-masked-if-diagnostic)
                          "lower: SPMD masked if AVX-512 lowering is not available for this backend mode or branch shape"))))]
                [(lower-masked-vector-body-has-varying-enum-match?
                    ctx
                    env
                    type-env
                    index
                    body)
                  (if (lower-mode-avx2? (lower-state-mode state))
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          body
                          "lower: AVX2 varying enum match requires a contiguous dynamic-array lane source and supported payload bindings")))
                    (lower-scalar-foreach-lowered
                      ctx
                      state
                      env
                      type-env
                      index-id
                      index
                      index-ty
                      start-value
                      end-value
                      body))]
                [(lower-masked-vector-body-has-varying-match?
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          "lower: SPMD varying match AVX2 lowering is not available for this match shape"
                          "lower: SPMD varying match AVX-512 lowering is not available for this backend mode or match shape"))))]
                [(lower-vector-body-has-spmd-shuffle? ctx body)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (lower-spmd-shuffle-diagnostic))))]
                [(lower-vector-body-has-array-read? ctx body)
                  (if (lower-simple-vector-map-has-unsupported-byte-mul?
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          body
                          (lower-spmd-byte-mul-diagnostic))))
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          body
                          (lower-simd-foreach-fallback-diagnostic)))))]
                [else
                  (lower-scalar-foreach-lowered
                    ctx
                    state
                    env
                    type-env
                    index-id
                    index
                    index-ty
                    start-value
                    end-value
                    body)])]))])
    (lower-scalar-foreach-lowered
      ctx
      state
      env
      type-env
      index-id
      index
      index-ty
      start-value
      end-value
      body)))

(define (lower-foreach-lowered
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : AstType]
  [start-value : CompilerIrValue]
  [end-value : CompilerIrValue]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-spmd-inline-expr
    ctx
    env
    type-env
    body
    LowerSpmdInlineSubst.Nil
    (lower-id-set-insert LowerIdSet.Nil index-id))
    [(ResultLowerAstExpr.Ok inlined-body)
      (if (and
        (lower-mode-avx2? (lower-state-mode state))
        (lower-spmd-expr-has-out-of-line-call? ctx env type-env inlined-body))
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic-at-expr
              inlined-body
              (lower-avx2-spmd-call-diagnostic))))
        (lower-foreach-lowered-inlined
          ctx
          state
          env
          type-env
          index-id
          index
          index-ty
          start-value
          end-value
          inlined-body))]
    [(ResultLowerAstExpr.Err diag) (ResultLowerExpr.Err diag)]))

(define (lower-foreach
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-expr-expected ctx state env type-env start index-ty start)
    [(ResultLowerExpr.Ok start-lowered)
      (match start-lowered
        [(LowerExpr.Expr start-state start-value _)
          (match (lower-expr-expected
            ctx
            start-state
            env
            type-env
            end
            index-ty
            end)
            [(ResultLowerExpr.Ok end-lowered)
              (match end-lowered
                [(LowerExpr.Expr end-state end-value _)
                  (lower-foreach-lowered
                    ctx
                    end-state
                    env
                    type-env
                    index-id
                    index
                    index-ty
                    start-value
                    end-value
                    body)])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; Scalar `match` lowering. The scrutinee is lowered once into a fresh
;; local, then literal arms become a chain of `CompilerIrBinOp.Eq` tests + `CompilerIrInstr.Branch`
;; (mirroring `lower-if`). The typechecker guarantees exhaustiveness and arm-type
;; agreement, so the final arm reached must match: it is lowered as an
;; irrefutable catch-all (no test, jump straight to the merge block). A
;; value-typed match merges arm results with an `CompilerIrInstr.Phi`; a `unit`-typed
;; match emits no value phi. Enum matches reuse the same merge path, but load the
;; heap tag once and dispatch variant arms by tag.
(define (lower-match-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env scrutinee)
    [(ResultLowerExpr.Ok scrut-lowered)
      (match scrut-lowered
        [(LowerExpr.Expr scrut-state scrut-value scrut-ty)
          ;; Use the scrutinee var directly when it is already a var, like the
          ;; tail path: a copying Mov into a fresh home makes a 2-word enum pay
          ;; a Pack round-trip per copy.
          (match (lower-tail-match-scrutinee-home
            scrut-state
            scrut-value
            scrut-ty)
            [(LowerScrutineeHome.Home home-state scrut-var)
              (match (lower-state-fresh-label home-state "match_merge")
                [(LowerLabel.Label merge-state merge-label)
                  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
                    [(AstType.Enum _)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        (TcMaybeNameId.No)
                        false)]
                    [(AstType.EnumArgs _ _)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        (TcMaybeNameId.No)
                        false)]
                    [(AstType.Ref borrow-lifetime referent-box)
                      (let
                        [referent-ty : AstType
                          (tc-type-strip-region
                            (tc-resolve-type
                              ctx
                              (tc-context-type-get ctx referent-box)))]
                        (match referent-ty
                          [(AstType.Enum _)
                            (lower-match-enum
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              referent-ty
                              arms
                              merge-label
                              expr-ty
                              (TcMaybeNameId.Some borrow-lifetime)
                              true)]
                          [(AstType.EnumArgs _ _)
                            (lower-match-enum
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              referent-ty
                              arms
                              merge-label
                              expr-ty
                              (TcMaybeNameId.Some borrow-lifetime)
                              true)]
                          [_
                            (lower-match-arms
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              scrut-ty
                              arms
                              merge-label
                              expr-ty
                              CompilerIrPhiInputList.Nil)]))]
                    [(AstType.VarArgs _ _)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        (TcMaybeNameId.No)
                        false)]
                    [_
                      (lower-match-arms
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        CompilerIrPhiInputList.Nil)])])])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-match-borrowed-enum
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [place : AstExpr]
  [borrow-lifetime : i64]
  [enum-ty : AstType]
  [arms : AstMatchArmList]
  [expr-ty : AstType]) : ResultLowerExpr
  (let
    [resident : bool (lower-type-register-resident? ctx enum-ty)]
    (match (lower-expr ctx state env type-env place)
      [(ResultLowerExpr.Ok place-lowered)
        (match place-lowered
          [(LowerExpr.Expr place-state place-value _)
            ;; The borrowed payload bindings and literal compares below
            ;; address the scrutinee as MEMORY (gep off the pointer). A
            ;; register-resident enum place lowers to its packed word(s), so
            ;; spill it to a temp inline slot and run the whole match on the
            ;; slot address (force-memory). The Mov is typed U64 in that case:
            ;; the var holds an address, not a register group.
            (match (if resident
              (lower-copy-inline-aggregate-to-inline
                ctx
                place-state
                place-value
                enum-ty)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr place-state place-value enum-ty)))
              [(ResultLowerExpr.Ok scrut-expr)
                (match scrut-expr
                  [(LowerExpr.Expr scrut-state scrut-value _)
                    (match (lower-state-alloc-var scrut-state)
                      [(LowerAlloc.Alloc scrut-alloc scrut-var)
                        (match (lower-state-fresh-label
                          (lower-state-emit
                            scrut-alloc
                            (CompilerIrInstr.Mov
                              scrut-var
                              scrut-value
                              (if resident
                                (AstType.U64)
                                enum-ty)))
                          "match_merge")
                          [(LowerLabel.Label merge-state merge-label)
                            (lower-match-enum
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              enum-ty
                              arms
                              merge-label
                              expr-ty
                              (TcMaybeNameId.Some borrow-lifetime)
                              resident)])])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-match
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (ast-expr-unspan scrutinee)
    [(AstExpr.Borrow mutable _ place-box)
      (if mutable
        (lower-match-value ctx state env type-env scrutinee arms expr-ty)
        (let
          [place : AstExpr (lower-context-expr-get ctx place-box)]
          (match (tc-expr ctx type-env scrutinee)
            [(ResultTcType.Ok scrut-ty)
              (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
                [(AstType.Ref borrow-lifetime referent-box)
                  (let
                    [referent-ty : AstType
                      (tc-type-strip-region
                        (tc-resolve-type
                          ctx
                          (tc-context-type-get ctx referent-box)))]
                    (match referent-ty
                      [(AstType.Enum _)
                        (lower-match-borrowed-enum
                          ctx
                          state
                          env
                          type-env
                          place
                          borrow-lifetime
                          referent-ty
                          arms
                          expr-ty)]
                      [(AstType.EnumArgs _ _)
                        (lower-match-borrowed-enum
                          ctx
                          state
                          env
                          type-env
                          place
                          borrow-lifetime
                          referent-ty
                          arms
                          expr-ty)]
                      [_
                        (lower-match-value
                          ctx
                          state
                          env
                          type-env
                          scrutinee
                          arms
                          expr-ty)]))]
                [_
                  (lower-match-value
                    ctx
                    state
                    env
                    type-env
                    scrutinee
                    arms
                    expr-ty)])]
            [(ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr scrutinee message)))])))]
    [_ (lower-match-value ctx state env type-env scrutinee arms expr-ty)]))

(define (lower-match-enum
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeNameId]
  [force-memory : bool]) : ResultLowerExpr
  ;; A 1-word register-resident enum value IS the tag word (nullary, no
  ;; payload); match on `scrut-var` directly. A 2-word register-group enum holds
  ;; the tag in word0; extract it with IrInstrWord. Neither touches memory. One
  ;; layout build (lower-type-register-words) decides all three cases.
  ;; `force-memory` (borrowed match of a spilled register-resident scrutinee)
  ;; overrides the value paths: scrut-var then holds the ADDRESS of the enum
  ;; bytes and tag/payloads are read through it like any memory enum.
  (let
    [scrut-words : i64 (lower-type-register-words ctx scrut-ty)]
    (if (and (> scrut-words 0) (not force-memory))
      (if (= scrut-words 2)
        (match (lower-emit-word
          state
          (CompilerIrValue.Var scrut-var)
          0
          (AstType.I64))
          [(LowerExpr.Expr tag-state tag-value _)
            (match tag-value
              [(CompilerIrValue.Var tag-var)
                (lower-match-enum-arms
                  ctx
                  tag-state
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  arms
                  merge-label
                  expr-ty
                  borrow-lifetime
                  CompilerIrPhiInputList.Nil
                  true)]
              [_
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic "lower: internal enum tag extract failed")))])])
        (lower-match-enum-arms
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          scrut-var
          arms
          merge-label
          expr-ty
          borrow-lifetime
          CompilerIrPhiInputList.Nil
          false))
      (match (lower-load-at-offset
        state
        (CompilerIrValue.Var scrut-var)
        0
        (AstType.I64))
        [(LowerExpr.Expr tag-state tag-value _)
          (match tag-value
            [(CompilerIrValue.Var tag-var)
              (lower-match-enum-arms
                ctx
                tag-state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arms
                merge-label
                expr-ty
                borrow-lifetime
                CompilerIrPhiInputList.Nil
                false)]
            [_
              (ResultLowerExpr.Err
                (box (lower-diagnostic "lower: internal enum tag load failed")))])]))))

(define (lower-box-pattern-for-type?
  [ctx : TcContext]
  [scrut-ty : AstType]
  [name : i64]) : bool
  (if (lower-box-pattern-name? name)
    (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
      [(AstType.Box _) true]
      [_ false])
    false))

(define (lower-struct-pattern-for-type?
  [ctx : TcContext]
  [scrut-ty : AstType]
  [name : i64]) : bool
  (let
    [pattern-name : String (tc-env-key-name-text name)]
    (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
      [(AstType.Struct struct-name)
        (tc-struct-pattern-name-matches?
          ctx
          (tc-nominal-name-id-display struct-name)
          pattern-name
          name)]
      [(AstType.StructArgs struct-name _)
        (tc-struct-pattern-name-matches?
          ctx
          (tc-nominal-name-id-display struct-name)
          pattern-name
          name)]
      [_ false])))

(define (lower-bind-struct-field-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field-name-id : i64]
  [field-name : String]
  [pattern : AstPattern]
  [field-ty : AstType]) : ResultLowerEnv
  (match pattern
    [(AstPattern.Wildcard) (ResultLowerEnv.Ok state env type-env)]
    [(AstPattern.Var name _)
      (match (lower-struct-get-named
        ctx
        state
        base
        struct-id
        struct-name
        field-name-id
        field-name
        field-ty)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr field-state field-value _)
              (match field-value
                [(CompilerIrValue.Var field-var)
                  (ResultLowerEnv.Ok
                    field-state
                    (sym_i64_env.sym-i64-bind-id env name field-var)
                    (tc-bind-id type-env name field-ty))]
                [_
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: internal struct field pattern load failed")))])])]
        [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])]
    [(AstPattern.Binding name)
      (match (lower-struct-get-named
        ctx
        state
        base
        struct-id
        struct-name
        field-name-id
        field-name
        field-ty)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr field-state field-value _)
              (match field-value
                [(CompilerIrValue.Var field-var)
                  (ResultLowerEnv.Ok
                    field-state
                    (sym_i64_env.sym-i64-bind-id env name field-var)
                    (tc-bind-id type-env name field-ty))]
                [_
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: internal struct field pattern load failed")))])])]
        [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])]
    [(AstPattern.Variant name args-box)
      (if (lower-struct-pattern-for-type? ctx field-ty name)
        (match (lower-struct-get-named
          ctx
          state
          base
          struct-id
          struct-name
          field-name-id
          field-name
          field-ty)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr field-state field-value _)
                (lower-bind-struct-pattern
                  ctx
                  field-state
                  env
                  type-env
                  field-value
                  field-ty
                  (lower-struct-type-name-or-empty
                    (tc-type-strip-region (tc-resolve-type ctx field-ty)))
                  (box-get args-box))])]
          [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])
        (ResultLowerEnv.Err
          (box (lower-diagnostic "lower: unsupported struct field pattern"))))]
    [_
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: unsupported struct field pattern")))]))

(define (lower-bind-struct-pattern-fields
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [patterns : AstPatternList]
  [fields : AstFieldDefList]
  [types : AstTypeList]) : ResultLowerEnv
  (lower-bind-struct-pattern-fields-at
    ctx
    state
    env
    type-env
    base
    struct-id
    struct-name
    patterns
    (& fields)
    0
    types))

(define (lower-bind-struct-pattern-fields-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [patterns : AstPatternList]
  [fields : (& fields AstFieldDefList)]
  [field-index : i64]
  [types : AstTypeList]) : ResultLowerEnv
  (if (ast-pattern-list-empty? (& patterns))
    (if (>= field-index (ast-type-list-len (& types)))
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: struct pattern arity mismatch"))))
    (let
      [pattern : AstPattern
        (ast-pattern-list-get (& patterns) 0 (ast-pattern-fallback))]
      [rest-patterns : AstPatternList (ast-pattern-list-tail patterns)]
      (if (or
        (>= field-index (ast-field-def-list-len fields))
        (>= field-index (ast-type-list-len (& types))))
        (ResultLowerEnv.Err
          (box (lower-diagnostic "lower: struct pattern arity mismatch")))
        (match (ast-field-def-list-get
          fields
          field-index
          (ast-field-def-fallback))
          [(AstFieldDef.Def field-name _ _)
            (let
              [ty : AstType
                (tc-context-type-get
                  ctx
                  (ast-type-list-get
                    (& types)
                    field-index
                    (ast-type-id-fallback)))]
              (match (lower-bind-struct-field-pattern
                ctx
                state
                env
                type-env
                base
                struct-id
                struct-name
                field-name
                (tc-env-key-name-text field-name)
                pattern
                ty)
                [(ResultLowerEnv.Ok next-state next-env next-type-env)
                  (lower-bind-struct-pattern-fields-at
                    ctx
                    next-state
                    next-env
                    next-type-env
                    base
                    struct-id
                    struct-name
                    rest-patterns
                    fields
                    (+ field-index 1)
                    types)]
                [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)]))])))))

(define (lower-bind-struct-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [scrut-ty : AstType]
  [struct-name : String]
  [args : AstPatternList]) : ResultLowerEnv
  (match (lower-struct-fields-id
    ctx
    (lower-struct-type-name-id-or scrut-ty -1)
    struct-name)
    [(ResultAstFieldDefList.Ok fields)
      (match (tc-struct-pattern-field-types-for-scrut
        ctx
        (lower-struct-type-name-id-or scrut-ty -1)
        scrut-ty
        fields)
        [(ResultTcTypeList.Ok field-types)
          (lower-bind-struct-pattern-fields
            ctx
            state
            env
            type-env
            base
            (lower-struct-type-name-id-or scrut-ty -1)
            struct-name
            args
            fields
            field-types)]
        [(ResultTcTypeList.Err message)
          (ResultLowerEnv.Err (box (lower-diagnostic message)))])]
    [(ResultAstFieldDefList.Err message)
      (ResultLowerEnv.Err (box (lower-diagnostic message)))]))

(define (lower-bind-match-catch-all-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : ResultLowerEnv
  (match pattern
    [(AstPattern.Binding name)
      (ResultLowerEnv.Ok
        state
        (sym_i64_env.sym-i64-bind-id env name scrut-var)
        (tc-bind-id type-env name scrut-ty))]
    [(AstPattern.Variant name args-box)
      (if (lower-box-pattern-for-type? ctx scrut-ty name)
        (lower-bind-box-pattern
          ctx
          state
          env
          type-env
          (CompilerIrValue.Var scrut-var)
          scrut-ty
          (box-get args-box))
        (if (lower-struct-pattern-for-type? ctx scrut-ty name)
          (lower-bind-struct-pattern
            ctx
            state
            env
            type-env
            (CompilerIrValue.Var scrut-var)
            scrut-ty
            (lower-struct-type-name-or-empty
              (tc-type-strip-region (tc-resolve-type ctx scrut-ty)))
            (box-get args-box))
          (ResultLowerEnv.Err
            (box (lower-diagnostic "lower: unsupported match pattern")))))]
    [_ (ResultLowerEnv.Ok state env type-env)]))

(define (lower-match-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [phi-inputs : CompilerIrPhiInputList]) : ResultLowerExpr
  (if (ast-match-arm-list-empty? (& arms))
    (ResultLowerExpr.Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : AstMatchArm
        (ast-match-arm-list-get (& arms) 0 (ast-match-arm-fallback))]
      [rest : AstMatchArmList (ast-match-arm-list-tail arms)]
      (if (ast-match-arm-list-empty? (& rest))
        (lower-match-catch-all
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          arm
          merge-label
          expr-ty
          phi-inputs)
        (match arm
          [(AstMatchArm.Arm pat body-box)
            (let
              [body : AstExpr (lower-context-expr-get ctx body-box)]
              (match pat
                [(AstPattern.Literal lit)
                  (lower-match-literal-arm
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    lit
                    body
                    rest
                    merge-label
                    expr-ty
                    phi-inputs)]
                [(AstPattern.Binding _)
                  (lower-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    merge-label
                    expr-ty
                    phi-inputs)]
                [(AstPattern.Wildcard)
                  (lower-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    merge-label
                    expr-ty
                    phi-inputs)]
                [(AstPattern.Variant variant-name _)
                  (if (lower-box-pattern-for-type? ctx scrut-ty variant-name)
                    (lower-match-catch-all
                      ctx
                      state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arm
                      merge-label
                      expr-ty
                      phi-inputs)
                    (if (lower-struct-pattern-for-type?
                      ctx
                      scrut-ty
                      variant-name)
                      (lower-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        merge-label
                        expr-ty
                        phi-inputs)
                      (ResultLowerExpr.Err
                        (box
                          (lower-diagnostic
                            (lower-unsupported-match-pattern-message
                              ctx
                              scrut-ty
                              (tc-env-key-name-text variant-name)))))))]
                [_
                  (ResultLowerExpr.Err
                    (box (lower-diagnostic "lower: unsupported match pattern")))]))])))))

(define (lower-match-enum-final-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arm : AstMatchArm]
  [pat : AstPattern]
  [body : AstExpr]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeNameId]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match pat
    [(AstPattern.Wildcard)
      (lower-match-catch-all
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arm
        merge-label
        expr-ty
        phi-inputs)]
    [(AstPattern.Binding variant-name)
      (lower-match-variant-final
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        variant-name
        (ast-pattern-list-new)
        body
        merge-label
        expr-ty
        borrow-lifetime
        phi-inputs
        scrut-reg-group?)]
    [(AstPattern.Variant variant-name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (lower-match-variant-final
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          variant-name
          args
          body
          merge-label
          expr-ty
          borrow-lifetime
          phi-inputs
          scrut-reg-group?))]
    [_
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-match-enum-branch-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [arm : AstMatchArm]
  [pat : AstPattern]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeNameId]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match pat
    [(AstPattern.Wildcard)
      (lower-match-catch-all
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arm
        merge-label
        expr-ty
        phi-inputs)]
    [(AstPattern.Binding variant-name)
      (lower-match-variant-arm
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        tag-var
        variant-name
        (ast-pattern-list-new)
        body
        rest
        merge-label
        expr-ty
        borrow-lifetime
        phi-inputs
        scrut-reg-group?)]
    [(AstPattern.Variant variant-name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (lower-match-variant-arm
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          tag-var
          variant-name
          args
          body
          rest
          merge-label
          expr-ty
          borrow-lifetime
          phi-inputs
          scrut-reg-group?))]
    [_
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-match-enum-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [arms : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeNameId]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (if (ast-match-arm-list-empty? (& arms))
    (ResultLowerExpr.Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : AstMatchArm
        (ast-match-arm-list-get (& arms) 0 (ast-match-arm-fallback))]
      [rest : AstMatchArmList (ast-match-arm-list-tail arms)]
      (match arm
        [(AstMatchArm.Arm pat body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (if (ast-match-arm-list-empty? (& rest))
              (lower-match-enum-final-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                arm
                pat
                body
                merge-label
                expr-ty
                borrow-lifetime
                phi-inputs
                scrut-reg-group?)
              (lower-match-enum-branch-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arm
                pat
                body
                rest
                merge-label
                expr-ty
                borrow-lifetime
                phi-inputs
                scrut-reg-group?)))]))))

(define (lower-match-variant-final
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [variant-name-id : i64]
  [args : AstPatternList]
  [body : AstExpr]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeNameId]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match ctx
    [(TcContext _ symbols registries _ _ _ _ _)
      (let
        [variant-name : String (tc-env-key-name-text variant-name-id)]
        [resolved-scrut-ty : AstType
          (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
        [handle : i64
          (lower-variant-constructor-handle-id-or
            ctx
            variant-name
            variant-name-id
            resolved-scrut-ty
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-registries-variant-fields-indexed symbols handle)
            [(ResultAstTypeList.Ok fields)
              (let
                [resolved-fields : AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    resolved-scrut-ty
                    fields)]
                ;; The final arm has no next-arm continuation, so a refutable
                ;; payload subpattern here would have nowhere to fall through to;
                ;; require a trailing catch-all instead.
                (if (lower-pattern-list-refutable-for-types?
                  ctx
                  args
                  resolved-fields)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic
                        "lower: refutable payload pattern in final match arm requires a trailing catch-all")))
                  (match (lower-bind-match-variant-payloads
                    ctx
                    state
                    env
                    type-env
                    borrow-lifetime
                    (CompilerIrValue.Var scrut-var)
                    args
                    resolved-fields
                    (lower-state-mode state)
                    (lower-enum-type-name-id-or resolved-scrut-ty -1)
                    (lower-enum-type-name-or-empty resolved-scrut-ty)
                    variant-name
                    (lower-variant-handle-name-id-or ctx handle variant-name-id)
                    0
                    8
                    merge-label
                    scrut-reg-group?)
                    [(ResultLowerEnv.Ok body-start body-env body-type-env)
                      (match (lower-expr-expected
                        ctx
                        body-start
                        body-env
                        body-type-env
                        body
                        expr-ty
                        body)
                        [(ResultLowerExpr.Ok body-lowered)
                          (match body-lowered
                            [(LowerExpr.Expr body-state body-value body-ty)
                              (let
                                [body-end-label : String
                                  (lower-state-current-label body-state)]
                                (if (tc-never-type? body-ty)
                                  (lower-match-finish
                                    ctx
                                    body-state
                                    merge-label
                                    expr-ty
                                    phi-inputs)
                                  (lower-match-finish
                                    ctx
                                    (lower-state-emit
                                      body-state
                                      (CompilerIrInstr.Jump merge-label))
                                    merge-label
                                    expr-ty
                                    (compiler-ir-phi-input-cons
                                      body-value
                                      body-end-label
                                      phi-inputs))))])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])]
                    [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)])))]
            [(ResultAstTypeList.Err message)
              (ResultLowerExpr.Err (box (lower-diagnostic message)))])
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))))]))

(define (lower-match-variant-body
  [ctx : TcContext]
  [body-start : LowerState]
  [next-label : String]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [variant-name : String]
  [variant-name-id : i64]
  [fields : AstTypeList]
  [args : AstPatternList]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeNameId]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match (lower-bind-match-variant-payloads
    ctx
    body-start
    env
    type-env
    borrow-lifetime
    (CompilerIrValue.Var scrut-var)
    args
    fields
    (lower-state-mode body-start)
    (lower-enum-type-name-id-or scrut-ty -1)
    (lower-enum-type-name-or-empty scrut-ty)
    variant-name
    variant-name-id
    0
    8
    next-label
    scrut-reg-group?)
    [(ResultLowerEnv.Ok bound-state body-env body-type-env)
      (match (lower-expr-expected
        ctx
        bound-state
        body-env
        body-type-env
        body
        expr-ty
        body)
        [(ResultLowerExpr.Ok body-lowered)
          (match body-lowered
            [(LowerExpr.Expr body-state body-value body-ty)
              (let
                [body-end-label : String (lower-state-current-label body-state)]
                (lower-match-enum-arms
                  ctx
                  (if (tc-never-type? body-ty)
                    (lower-state-finish-block body-state next-label)
                    (lower-state-finish-block
                      (lower-state-emit
                        body-state
                        (CompilerIrInstr.Jump merge-label))
                      next-label))
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  rest
                  merge-label
                  expr-ty
                  borrow-lifetime
                  (if (tc-never-type? body-ty)
                    phi-inputs
                    (compiler-ir-phi-input-cons
                      body-value
                      body-end-label
                      phi-inputs))
                  scrut-reg-group?))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))

;; The switch-form pass is deliberately the only place that may materialize
;; the final enum tag and unreachable default.  Lowering keeps the classic
;; fallthrough instruction shape and carries only a compiler-owned label marker
;; on exhaustive all-variant matches large enough to meet switch formation's
;; existing four-comparison threshold.  Two-variant (and all other small)
;; matches therefore remain byte-for-byte identical at the lowered-IR stage.
(define (lower-total-enum-switch-rest-explicit-from?
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (ast-match-arm-list-len arms))
    true
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pat _)
        (match pat
          [(AstPattern.Binding _)
            (lower-total-enum-switch-rest-explicit-from? arms (+ index 1))]
          [(AstPattern.Variant _ _)
            (lower-total-enum-switch-rest-explicit-from? arms (+ index 1))]
          [_ false])])))

(define (lower-enum-match-next-label-base
  [current-label : String]
  [rest : AstMatchArmList]) : String
  ;; Seed the proof once four explicit comparisons remain, carry it only along
  ;; the outer compare chain, and put the durable marker on the final arm's
  ;; classic fallthrough label. The distinct chain/default spellings prevent a
  ;; nested match lowered inside the final arm from inheriting the outer proof.
  (let
    [remaining : i64 (ast-match-arm-list-len (& rest))]
    [chain-marker : String "match_total_enum_chain"]
    [total-chain? : bool
      (or
        (string.contains (& current-label) (& chain-marker))
        (and
          (= remaining 4)
          (lower-total-enum-switch-rest-explicit-from? (& rest) 0)))]
    (if total-chain?
      (if (= remaining 1)
        "match_total_enum_default"
        "match_total_enum_chain")
      "match_next")))

(define (lower-match-variant-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [variant-name-id : i64]
  [args : AstPatternList]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [borrow-lifetime : TcMaybeNameId]
  [phi-inputs : CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match ctx
    [(TcContext _ symbols registries _ _ _ _ _)
      (let
        [variant-name : String (tc-env-key-name-text variant-name-id)]
        [resolved-scrut-ty : AstType
          (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
        [handle : i64
          (lower-variant-constructor-handle-id-or
            ctx
            variant-name
            variant-name-id
            resolved-scrut-ty
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-registries-variant-fields-indexed symbols handle)
            [(ResultAstTypeList.Ok fields)
              (let
                [resolved-fields : AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    resolved-scrut-ty
                    fields)]
                (match (lower-state-alloc-var state)
                  [(LowerAlloc.Alloc eq-alloc eq-var)
                    (let
                      [eq-state : LowerState
                        (lower-state-emit
                          eq-alloc
                          (CompilerIrInstr.BinOp
                            eq-var
                            CompilerIrBinOp.Eq
                            (CompilerIrValue.Var tag-var)
                            (CompilerIrValue.I64
                              (compiler-registry-handle-child-index handle))
                            (AstType.I64)))]
                      (match (lower-state-fresh-label eq-state "match_arm")
                        [(LowerLabel.Label body-label-state body-label)
                          (match (lower-state-fresh-label
                            body-label-state
                            (lower-enum-match-next-label-base
                              (lower-state-current-label state)
                              rest))
                            [(LowerLabel.Label next-label-state next-label)
                              (let
                                [body-start : LowerState
                                  (lower-state-finish-block
                                    (lower-state-emit
                                      next-label-state
                                      (CompilerIrInstr.Branch
                                        (CompilerIrValue.Var eq-var)
                                        body-label
                                        next-label))
                                    body-label)]
                                (lower-match-variant-body
                                  ctx
                                  body-start
                                  next-label
                                  env
                                  type-env
                                  scrut-var
                                  scrut-ty
                                  tag-var
                                  variant-name
                                  (lower-variant-handle-name-id-or
                                    ctx
                                    handle
                                    variant-name-id)
                                  resolved-fields
                                  args
                                  body
                                  rest
                                  merge-label
                                  expr-ty
                                  borrow-lifetime
                                  phi-inputs
                                  scrut-reg-group?))])]))]))]
            [(ResultAstTypeList.Err message)
              (ResultLowerExpr.Err (box (lower-diagnostic message)))])
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))))]))

(define (lower-match-literal-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [lit : AstLiteral]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [merge-label : String]
  [expr-ty : AstType]
  [phi-inputs : CompilerIrPhiInputList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc eq-alloc eq-var)
      (let
        [eq-state : LowerState
          (lower-state-emit
            eq-alloc
            (CompilerIrInstr.BinOp
              eq-var
              CompilerIrBinOp.Eq
              (CompilerIrValue.Var scrut-var)
              (lower-literal-value-with-type lit scrut-ty)
              scrut-ty))]
        (match (lower-state-fresh-label eq-state "match_arm")
          [(LowerLabel.Label body-label-state body-label)
            (match (lower-state-fresh-label body-label-state "match_next")
              [(LowerLabel.Label next-label-state next-label)
                (let
                  [body-start : LowerState
                    (lower-state-finish-block
                      (lower-state-emit
                        next-label-state
                        (CompilerIrInstr.Branch
                          (CompilerIrValue.Var eq-var)
                          body-label
                          next-label))
                      body-label)]
                  (match (lower-expr-expected
                    ctx
                    body-start
                    env
                    type-env
                    body
                    expr-ty
                    body)
                    [(ResultLowerExpr.Ok body-lowered)
                      (match body-lowered
                        [(LowerExpr.Expr body-state body-value body-ty)
                          (let
                            [body-end-label : String
                              (lower-state-current-label body-state)]
                            (lower-match-arms
                              ctx
                              (if (tc-never-type? body-ty)
                                (lower-state-finish-block body-state next-label)
                                (lower-state-finish-block
                                  (lower-state-emit
                                    body-state
                                    (CompilerIrInstr.Jump merge-label))
                                  next-label))
                              env
                              type-env
                              scrut-var
                              scrut-ty
                              rest
                              merge-label
                              expr-ty
                              (if (tc-never-type? body-ty)
                                phi-inputs
                                (compiler-ir-phi-input-cons
                                  body-value
                                  body-end-label
                                  phi-inputs))))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)]))])]))]))

(define (lower-match-catch-all
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arm : AstMatchArm]
  [merge-label : String]
  [expr-ty : AstType]
  [phi-inputs : CompilerIrPhiInputList]) : ResultLowerExpr
  (match arm
    [(AstMatchArm.Arm pat body-box)
      (let
        [body : AstExpr (lower-context-expr-get ctx body-box)]
        (match (lower-bind-match-catch-all-pattern
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          pat)
          [(ResultLowerEnv.Ok body-start body-env body-type-env)
            (match (lower-expr-expected
              ctx
              body-start
              body-env
              body-type-env
              body
              expr-ty
              body)
              [(ResultLowerExpr.Ok body-lowered)
                (match body-lowered
                  [(LowerExpr.Expr body-state body-value body-ty)
                    (let
                      [body-end-label : String
                        (lower-state-current-label body-state)]
                      (if (tc-never-type? body-ty)
                        (lower-match-finish
                          ctx
                          body-state
                          merge-label
                          expr-ty
                          phi-inputs)
                        (lower-match-finish
                          ctx
                          (lower-state-emit
                            body-state
                            (CompilerIrInstr.Jump merge-label))
                          merge-label
                          expr-ty
                          (compiler-ir-phi-input-cons
                            body-value
                            body-end-label
                            phi-inputs))))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))]))

(define (lower-phi-input-list-empty? [phi-inputs : CompilerIrPhiInputList]) : bool
  (match (compiler-ir-phi-input-list-force-cons phi-inputs)
    [(CompilerIrPhiInputList.Nil) true]
    [_ false]))

(define (lower-match-finish
  [ctx : TcContext]
  [state : LowerState]
  [merge-label : String]
  [expr-ty : AstType]
  [phi-inputs : CompilerIrPhiInputList]) : ResultLowerExpr
  (let
    [merge-start : LowerState (lower-state-finish-block state merge-label)]
    [expr-ir-ty : AstType (lower-one-word-register-storage-type ctx expr-ty)]
    (if (lower-phi-input-list-empty? phi-inputs)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr merge-start CompilerIrValue.Unit (AstType.Never)))
      (match expr-ty
        [(AstType.Unit)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr merge-start CompilerIrValue.Unit expr-ty))]
        [_
          (match (lower-state-alloc-var merge-start)
            [(LowerAlloc.Alloc allocated var-id)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-state-emit
                    allocated
                    (CompilerIrInstr.Phi var-id phi-inputs expr-ir-ty))
                  (CompilerIrValue.Var var-id)
                  expr-ty))])]))))

(define (lower-tail-call-var-unshadowed?
  [env : sym_i64_env.SymI64Env]
  [name : i64]) : bool
  (not (sym_i64_env.sym-i64-contains-id env name)))

(define (lower-tail-call-local-indirect-safe?
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]) : bool
  (if (sym_i64_env.sym-i64-contains-id env name)
    (not (lower-type-env-contains-reference? type-env))
    true))

(define (lower-tail-call-reference-capturing-lambda?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [callee : AstExpr]) : bool
  (match (ast-expr-unspan callee)
    [(AstExpr.Ann inner-box _)
      (lower-tail-call-reference-capturing-lambda?
        ctx
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Cast inner-box _)
      (lower-tail-call-reference-capturing-lambda?
        ctx
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (tc-lambda-captures-reference? type-env params body))])]
    [_ false]))

(define (lower-tail-call-self-target? [state : LowerState] [name : i64]) : bool
  (string.eq
    (lower-resolve-name-id state name)
    (lower-state-current-function state)))

(define (lower-symbol-function-define-id? [ctx : TcContext] [name-id : i64]) : bool
  (let
    [handle : i64
      (compiler-symbols-lookup-value-id-or
        (tc-context-symbols ctx)
        name-id
        (compiler-symbols-missing-handle))]
    (and
      (compiler-symbols-handle-found? handle)
      (=
        (compiler-symbol-handle-kind handle)
        (compiler-symbol-kind-function-define)))))

(define (lower-tail-call-compatible-return?
  [ctx : TcContext]
  [callee-ret : AstType]
  [ret-ty : AstType]) : bool
  (tc-type-eq
    (tc-type-without-regions (tc-resolve-type ctx callee-ret))
    (tc-type-without-regions (tc-resolve-type ctx ret-ty))))

(define (lower-tail-call-direct-supported?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]
  [ret-ty : AstType]) : bool
  (cond
    [(and
        ;; Direct aggregate tail calls also forward the current sret slot. A callee
        ;; early-exit path may return a heap aggregate pointer instead of filling it.
        (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty)
        (lower-rvo-callee-has-early-return-id? state env name))
      false]
    [(lower-tail-call-self-target? state name) true]
    [(lower-symbol-function-define-id? ctx name)
      (match (lower-lookup-type-id
        ctx
        (lower-state-type-cache state)
        env
        type-env
        name)
        [(ResultTcType.Ok fn-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
            [(AstType.Func param-types callee-ret)
              (lower-tail-call-compatible-return?
                ctx
                (tc-context-type-get ctx callee-ret)
                ret-ty)]
            [_ false])]
        [(ResultTcType.Err _) false])]
    [else false]))

(define (lower-tail-call-args-for-target
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]
  [args : AstExprList]) : ResultLowerArgs
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(ResultTcType.Ok fn-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
        [(AstType.Func param-types _)
          (lower-args-as
            ctx
            state
            env
            type-env
            args
            (tc-resolve-type-list ctx (box-get param-types)))]
        [_ (lower-args ctx state env type-env args)])]
    [(ResultTcType.Err _) (lower-args ctx state env type-env args)]))

(define (lower-tail-call-indirect-supported?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func-ty : AstType]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]) : bool
  (if (lower-tail-call-inline-aggregate-risk?
    ctx
    state
    env
    type-env
    args
    ret-ty
    sret-var)
    false
    (match (tc-type-strip-region (tc-resolve-type ctx func-ty))
      [(AstType.Func _ callee-ret)
        (lower-tail-call-compatible-return?
          ctx
          (tc-context-type-get ctx callee-ret)
          ret-ty)]
      [_ false])))

(define (lower-tail-call-indirect-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [callee : AstExpr]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (match (tc-expr ctx type-env callee)
    [(ResultTcType.Ok func-ty)
      (if (lower-tail-call-indirect-supported?
        ctx
        state
        env
        type-env
        func-ty
        args
        ret-ty
        sret-var)
        (match (lower-expr ctx state env type-env callee)
          [(ResultLowerExpr.Ok lowered-func)
            (match lowered-func
              [(LowerExpr.Expr func-state func-value lowered-func-ty)
                (match (lower-indirect-call-args
                  ctx
                  func-state
                  env
                  type-env
                  args
                  lowered-func-ty)
                  [(ResultLowerArgs.Ok args-state values)
                    (match (lower-tail-call-append-current-sret-arg
                      ctx
                      args-state
                      values
                      ret-ty
                      sret-var)
                      [(ResultLowerArgs.Ok tail-state tail-values)
                        (ResultLowerState.Ok
                          (lower-state-emit-at-expr
                            tail-state
                            (CompilerIrInstr.TailCallIndirect
                              func-value
                              (compiler-ir-call-args-from-list tail-values)
                              (lower-one-word-register-storage-type ctx ret-ty))
                            origin))]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerState.Err message)])]
                  [(ResultLowerArgs.Err message) (ResultLowerState.Err message)])])]
          [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])
        (lower-return-expr ctx state env type-env origin ret-ty sret-var))]
    [(ResultTcType.Err message)
      (ResultLowerState.Err (box (lower-diagnostic-at-expr callee message)))]))

;; sret return ABI: when `sret-var` >= 0 the caller passed a
;; hidden result-slot pointer (bound to that var). Copy the result aggregate
;; into the caller's slot and return the slot pointer -- no per-return arena
;; alloc + escape copy. `sret-var` < 0 keeps the arena escape-copy path, which
;; is always correct (every call site uses the call's return value), so a
;; non-threaded return path simply stays unoptimized rather than incorrect.
(define (lower-return-expr-to-sret
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-inline-aggregate-copy-size ctx ret-ty)
    [(ResultLowerSize.Ok size)
      (ResultLowerState.Ok
        (lower-state-emit
          (lower-copy-bytes state (CompilerIrValue.Var sret-var) 0 value 0 size)
          (CompilerIrInstr.Return
            (lower-return-maybe (CompilerIrValue.Var sret-var) ret-ty))))]
    [(ResultLowerSize.Err message)
      (ResultLowerState.Err (box (lower-diagnostic message)))]))

(define (lower-return-expr-generic
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-expr-expected ctx state env type-env expr ret-ty expr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr body-state value expr-ty)
          (if (tc-never-type? expr-ty)
            (ResultLowerState.Ok body-state)
            (if (>= sret-var 0)
              (lower-return-expr-to-sret ctx body-state value ret-ty sret-var)
              (match (lower-return-abi-value ctx body-state value ret-ty)
                [(ResultLowerExpr.Ok return-copy)
                  (match return-copy
                    [(LowerExpr.Expr return-state return-value _)
                      (ResultLowerState.Ok
                        (lower-state-emit
                          return-state
                          (CompilerIrInstr.Return
                            (lower-return-maybe return-value ret-ty))))])]
                [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])))])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-return-sret
  [state : LowerState]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (ResultLowerState.Ok
    (lower-state-emit
      state
      (CompilerIrInstr.Return
        (lower-return-maybe (CompilerIrValue.Var sret-var) ret-ty)))))

(define (lower-rvo-node-has-early-return? [ctx : TcContext] [id : i64]) : bool
  (lower-rvo-expr-has-early-return? ctx (lower-context-expr-get ctx id)))

(define (lower-rvo-expr-list-has-early-return?
  [ctx : TcContext]
  [exprs : AstExprList]) : bool
  (lower-rvo-expr-list-has-early-return-at? ctx (& exprs) 0))

(define (lower-rvo-expr-list-has-early-return-at?
  [ctx : TcContext]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-rvo-node-has-early-return? ctx (ast-expr-list-get exprs index 0))
      (lower-rvo-expr-list-has-early-return-at? ctx exprs (+ index 1)))))

(define (lower-rvo-let-bindings-have-early-return?
  [ctx : TcContext]
  [bindings : AstLetBindingList]) : bool
  (lower-rvo-let-bindings-have-early-return-at? ctx (& bindings) 0))

(define (lower-rvo-let-bindings-have-early-return-at?
  [ctx : TcContext]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-let-binding-list-len bindings))
    false
    (or
      (match (ast-let-binding-list-get
        bindings
        binding-index
        (ast-let-binding-fallback))
        [(AstLetBinding.Binding _ _ init-box)
          (lower-rvo-node-has-early-return? ctx init-box)])
      (lower-rvo-let-bindings-have-early-return-at?
        ctx
        bindings
        (+ binding-index 1)))))

(define (lower-rvo-match-arms-have-early-return?
  [ctx : TcContext]
  [arms : AstMatchArmList]) : bool
  (lower-rvo-match-arms-have-early-return-at? ctx (& arms) 0))

(define (lower-rvo-match-arms-have-early-return-at?
  [ctx : TcContext]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (or
          (lower-rvo-node-has-early-return? ctx body-box)
          (lower-rvo-match-arms-have-early-return-at? ctx arms (+ index 1)))])))

(define (lower-rvo-resource-bindings-have-early-return?
  [ctx : TcContext]
  [bindings : AstResourceBindingList]) : bool
  (lower-rvo-resource-bindings-have-early-return-at? ctx (& bindings) 0))

(define (lower-rvo-resource-bindings-have-early-return-at?
  [ctx : TcContext]
  [bindings : (& bindings AstResourceBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-resource-binding-list-len bindings))
    false
    (or
      (match (ast-resource-binding-list-get
        bindings
        binding-index
        (ast-resource-binding-fallback))
        [(AstResourceBinding.Binding _ acquire-box cleanup-box _)
          (or
            (lower-rvo-node-has-early-return? ctx acquire-box)
            (lower-rvo-node-has-early-return? ctx cleanup-box))])
      (lower-rvo-resource-bindings-have-early-return-at?
        ctx
        bindings
        (+ binding-index 1)))))

(define (lower-rvo-expr-has-early-return? [ctx : TcContext] [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Return _) true]
    [(AstExpr.Try _) true]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrAddrOf place-box)
      (lower-rvo-node-has-early-return? ctx place-box)]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.Spanned inner-box _)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (lower-rvo-node-has-early-return? ctx left-box)
        (lower-rvo-node-has-early-return? ctx right-box))]
    [(AstExpr.Unary _ inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(AstExpr.Ann inner-box _) (lower-rvo-node-has-early-return? ctx inner-box)]
    [(AstExpr.Cast inner-box _)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(AstExpr.Borrow _ _ inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(AstExpr.Call func-box args)
      (or
        (lower-rvo-node-has-early-return? ctx func-box)
        (lower-rvo-expr-list-has-early-return? ctx args))]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-rvo-node-has-early-return? ctx cond-box)
        (lower-rvo-node-has-early-return? ctx then-box)
        (lower-rvo-node-has-early-return? ctx else-box))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-rvo-let-bindings-have-early-return? ctx bindings)
            (lower-rvo-node-has-early-return? ctx body-box))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (lower-rvo-node-has-early-return? ctx body-box)])]
    [(AstExpr.Tuple exprs) (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(AstExpr.TupleRef tuple-box index-box)
      (or
        (lower-rvo-node-has-early-return? ctx tuple-box)
        (lower-rvo-node-has-early-return? ctx index-box))]
    [(AstExpr.Array exprs) (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(AstExpr.DynArray exprs) (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(AstExpr.MakeArray _ len-box)
      (lower-rvo-node-has-early-return? ctx len-box)]
    [(AstExpr.ArrayRef arr-box index-box)
      (or
        (lower-rvo-node-has-early-return? ctx arr-box)
        (lower-rvo-node-has-early-return? ctx index-box))]
    [(AstExpr.ArraySet arr-box index-box value-box)
      (or
        (lower-rvo-node-has-early-return? ctx arr-box)
        (lower-rvo-node-has-early-return? ctx index-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(AstExpr.ArrayPush arr-box value-box)
      (or
        (lower-rvo-node-has-early-return? ctx arr-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(AstExpr.StringRef str-box index-box)
      (or
        (lower-rvo-node-has-early-return? ctx str-box)
        (lower-rvo-node-has-early-return? ctx index-box))]
    [(AstExpr.While cond-box body-box)
      (or
        (lower-rvo-node-has-early-return? ctx cond-box)
        (lower-rvo-node-has-early-return? ctx body-box))]
    [(AstExpr.Begin exprs) (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(AstExpr.Unsafe exprs) (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(AstExpr.Set _ rhs-box) (lower-rvo-node-has-early-return? ctx rhs-box)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (or
            (lower-rvo-node-has-early-return? ctx scrut-box)
            (lower-rvo-match-arms-have-early-return? ctx arms))])]
    [(AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(AstForeach.Foreach _ _ start-box end-box body-box)
          (or
            (lower-rvo-node-has-early-return? ctx start-box)
            (lower-rvo-node-has-early-return? ctx end-box)
            (lower-rvo-node-has-early-return? ctx body-box))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (or
            (lower-rvo-node-has-early-return? ctx start-box)
            (lower-rvo-node-has-early-return? ctx end-box)
            (lower-rvo-node-has-early-return? ctx init-box)
            (lower-rvo-node-has-early-return? ctx value-box))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (or
            (lower-rvo-node-has-early-return? ctx start-box)
            (lower-rvo-node-has-early-return? ctx end-box)
            (lower-rvo-node-has-early-return? ctx init-box)
            (lower-rvo-node-has-early-return? ctx value-box)
            (lower-rvo-node-has-early-return? ctx body-box))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (or
        (lower-rvo-node-has-early-return? ctx value-box)
        (lower-rvo-node-has-early-return? ctx lane-box))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (or
        (lower-rvo-node-has-early-return? ctx value-box)
        (lower-rvo-node-has-early-return? ctx lane-box))]
    [(AstExpr.StructGet receiver-box _)
      (lower-rvo-node-has-early-return? ctx receiver-box)]
    [(AstExpr.StructSet receiver-box _ value-box)
      (or
        (lower-rvo-node-has-early-return? ctx receiver-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(AstExpr.WithRegion _ body)
      (lower-rvo-expr-list-has-early-return? ctx body)]
    [(AstExpr.WithEscape scratch-box body)
      (or
        (lower-rvo-node-has-early-return? ctx scratch-box)
        (lower-rvo-expr-list-has-early-return? ctx body))]
    [(AstExpr.WithScratch body)
      (lower-rvo-expr-list-has-early-return? ctx body)]
    [(AstExpr.InArena arena-box body)
      (or
        (lower-rvo-node-has-early-return? ctx arena-box)
        (lower-rvo-expr-list-has-early-return? ctx body))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (or
            (lower-rvo-resource-bindings-have-early-return? ctx bindings)
            (lower-rvo-expr-list-has-early-return? ctx body))])]
    [(AstExpr.Box inner-box) (lower-rvo-node-has-early-return? ctx inner-box)]
    [(AstExpr.BoxGet inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(AstExpr.BoxTake inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(AstExpr.BoxSet inner-box value-box)
      (or
        (lower-rvo-node-has-early-return? ctx inner-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(AstExpr.Comptime _) false]
    [(AstExpr.Quote _) false]
    [(AstExpr.Quasiquote _) false]
    [(AstExpr.Unquote _) false]
    [(AstExpr.UnquoteSplicing _) false]
    [(AstExpr.BracketClause items)
      (lower-rvo-expr-list-has-early-return? ctx items)]
    [(AstExpr.PtrNullCheck inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(AstExpr.PtrRead ptr-box) (lower-rvo-node-has-early-return? ctx ptr-box)]
    [(AstExpr.PtrWrite ptr-box value-box)
      (or
        (lower-rvo-node-has-early-return? ctx ptr-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (or
        (lower-rvo-node-has-early-return? ctx ptr-box)
        (lower-rvo-node-has-early-return? ctx offset-box))]
    [(AstExpr.PtrCast ptr-box _) (lower-rvo-node-has-early-return? ctx ptr-box)]
    [(AstExpr.PtrToInt ptr-box) (lower-rvo-node-has-early-return? ctx ptr-box)]
    [(AstExpr.IntToPtr value-box _)
      (lower-rvo-node-has-early-return? ctx value-box)]
    [(AstExpr.StringData str-box)
      (lower-rvo-node-has-early-return? ctx str-box)]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (or
        (lower-rvo-node-has-early-return? ctx ptr-box)
        (lower-rvo-node-has-early-return? ctx len-box))]
    [(AstExpr.ArrayData array-box)
      (lower-rvo-node-has-early-return? ctx array-box)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? ctx leaf-box)
        (lower-rvo-node-has-early-return? ctx subleaf-box))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? ctx leaf-box)
        (lower-rvo-node-has-early-return? ctx subleaf-box))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? ctx leaf-box)
        (lower-rvo-node-has-early-return? ctx subleaf-box))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? ctx leaf-box)
        (lower-rvo-node-has-early-return? ctx subleaf-box))]
    [(AstExpr.Xgetbv index-box)
      (lower-rvo-node-has-early-return? ctx index-box)]
    [(AstExpr.Syscall args) (lower-rvo-expr-list-has-early-return? ctx args)]
    [_ true]))

;; Aliasing guard for sret-forwarding RVO. The forwarded sret is the
;; current function's result slot, which a CALLER may legally have aliased with
;; one of this call's arguments (the `(set! place (f place ...))` /
;; aggregate-place-update pattern -- HARD CONSTRAINT #4). If a callee then reads
;; such an argument and writes its result in place through the (aliased) sret --
;; e.g. it returns an enum/struct WRAPPING one of its parameters, like
;; a generated String -> i64 map remove returning `(RemoveOk map)` -- the
;; materialize-into-fresh-temp step of the value path is what makes that safe.
;; Forwarding the sret removes that buffer, so we only forward when NO argument
;; can alias the sret. An argument cannot alias the caller-owned result slot when
;; it is a scalar (carries no inline-aggregate storage) or is itself a
;; fresh-producing call/constructor whose result is an OWNED inline struct/enum
;; (materialized into a distinct fresh temp). A place-expression of aggregate
;; type (var/field/index/deref) or any reference/borrow may alias and is unsafe.
(define (lower-rvo-arg-cannot-alias-sret?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [arg : AstExpr]) : bool
  (match (tc-expr ctx type-env arg)
    [(ResultTcType.Ok ty)
      (or
        (not (lower-type-contains-inline-aggregate? ctx ty))
        (and
          (match (ast-expr-unspan arg)
            [(AstExpr.Call _ _) true]
            [_ false])
          (lower-type-inline-struct-or-enum? ctx ty)))]
    [(ResultTcType.Err _) false]))

(define (lower-rvo-args-cannot-alias-sret?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [args : AstExprList]) : bool
  (lower-rvo-args-cannot-alias-sret-at? ctx type-env (& args) 0))

(define (lower-rvo-args-cannot-alias-sret-at?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [args : (& args AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get args len))
    true
    (and
      (lower-rvo-arg-cannot-alias-sret?
        ctx
        type-env
        (lower-context-expr-get ctx (ast-expr-list-get args index 0)))
      (lower-rvo-args-cannot-alias-sret-at? ctx type-env args (+ index 1)))))

(define (lower-rvo-callee-has-early-return-id?
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]) : bool
  (let
    [logical-id : i64
      (if (sym_i64_env.sym-i64-contains-id env name-id)
        name-id
        (let
          [names : LowerNameCache (lower-state-names state)]
          (lower-name-cache-resolve-logical-id (& names) name-id name-id)))]
    (lower_i64_i64_map.contains?
      (& lower-rvo-early-return-functions)
      logical-id)))

;; Call-slot RVO for a tail-position direct CALL whose aggregate result is
;; returned by the current function. The value path lowers the call into a fresh
;; reserved result slot (`lower-call-append-sret-arg`) and then `lower-copy-bytes`
;; copies that slot into the caller-owned sret. Instead, forward the caller's own
;; sret pointer as the callee's hidden sret argument so the callee writes the
;; final result DIRECTLY into the return slot, eliminating the materialize+copy.
;;
;; Correctness: the call's arguments are evaluated BEFORE the call exactly as on
;; the value path, the would-be temporary's sole consumer is this return, and the
;; `lower-rvo-args-cannot-alias-sret?` guard above ensures no argument can alias
;; the destination -- so substituting the destination is sound. This mirrors
;; `lower-direct-call-id`'s ordinary (non-builtin, non-C-ABI) sret path verbatim,
;; only swapping the reserved slot for the provided `sret-var` and ending with the
;; return. Anything outside that path (builtins, C-ABI/extern, bytes-view,
;; indirect targets, incompatible/aliasing returns) yields `LowerMaybeDirectStore.No`
;; and falls back to the unchanged value+copy path.
(define (lower-return-direct-call-into-sret
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : LowerMaybeDirectStore
  (if (or
    ;; Require a genuine top-level function-define so a direct `CompilerIrInstr.Call` to
    ;; this symbol is the correct lowering. This excludes builtins, C-ABI/extern
    ;; declarations, and -- critically -- top-level function-VALUE globals /
    ;; closures, whose call must go through an INDIRECT load of the variable
    ;; (emitting a direct symbol call there would call into data). Same eligibility
    ;; rule `lower-tail-call-direct-supported?` uses for direct TCO.
    (not (lower-symbol-function-define-id? ctx name-id))
    ;; Explicit early exits are still lowered through return paths that may hand
    ;; back an allocated aggregate in `rax` instead of filling the forwarded sret.
    (lower-rvo-callee-has-early-return-id? state env name-id)
    (lower-bytes-view-from-parts-name? name)
    (lower-c-abi-extern-call? ctx state env name-id name)
    (lower-c-abi-extern-value-call? ctx state env name-id name)
    ;; An argument that may alias the caller-owned sret makes in-place forwarding
    ;; unsound (see `lower-rvo-args-cannot-alias-sret?`).
    (not (lower-rvo-args-cannot-alias-sret? ctx type-env args)))
    (LowerMaybeDirectStore.No)
    (match (lower-lookup-type-id
      ctx
      (lower-state-type-cache state)
      env
      type-env
      name-id)
      [(ResultTcType.Ok fn-ty)
        (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
          [(AstType.Func param-types fn-ret)
            (if (not
              (lower-tail-call-compatible-return?
                ctx
                (tc-context-type-get ctx fn-ret)
                ret-ty))
              ;; The callee's declared return type differs from this function's
              ;; return type (beyond regions): the value path coerces the call
              ;; result into the sret slot, so forwarding the slot to the callee
              ;; -- which would write its OWN-typed result -- is unsound. Keep the
              ;; materialize+copy path. (Same compatibility rule TCO requires.)
              (LowerMaybeDirectStore.No)
              (match (lower-direct-call-param-types
                ctx
                type-env
                name-id
                args
                (tc-resolve-type-list ctx (box-get param-types)))
                [(ResultTcTypeList.Ok call-param-types)
                  (match (lower-call-args-as-needed
                    ctx
                    state
                    env
                    type-env
                    args
                    call-param-types)
                    [(ResultLowerCallArgs.Ok args-state values writebacks)
                      (match (lower-state-alloc-var args-state)
                        [(LowerAlloc.Alloc allocated call-var)
                          (let
                            [result-ir-ty : AstType
                              (lower-one-word-register-storage-type ctx ret-ty)]
                            [sret-values : CompilerIrValueList
                              (lower-value-list-append-one
                                values
                                (CompilerIrValue.Var sret-var))]
                            [call-state : LowerState
                              (lower-state-emit-at-expr
                                allocated
                                (CompilerIrInstr.Call
                                  call-var
                                  (lower-resolve-call-name-id-with-display
                                    allocated
                                    env
                                    name-id
                                    name)
                                  (compiler-ir-call-args-from-list sret-values)
                                  result-ir-ty)
                                origin)]
                            [writeback-state : LowerState
                              (lower-apply-arg-writebacks
                                ctx
                                call-state
                                writebacks)]
                            (LowerMaybeDirectStore.Store
                              (lower-state-emit
                                writeback-state
                                (CompilerIrInstr.Return
                                  (lower-return-maybe
                                    (CompilerIrValue.Var sret-var)
                                    ret-ty)))))])]
                    [(ResultLowerCallArgs.Err message)
                      (LowerMaybeDirectStore.Err message)])]
                [(ResultTcTypeList.Err message)
                  (LowerMaybeDirectStore.Err
                    (box (lower-diagnostic-at-expr origin message)))]))]
          [_ (LowerMaybeDirectStore.No)])]
      [(ResultTcType.Err _) (LowerMaybeDirectStore.No)])))

;; Tail-position direct-call fallback shared by the non-constructor branches of
;; `lower-return-call-name-to-sret`: try the call-slot RVO above, otherwise keep
;; the unchanged materialize-into-temp + copy-to-sret behavior.
(define (lower-return-call-fallback-to-sret
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (match (lower-return-direct-call-into-sret
    ctx
    state
    env
    type-env
    name
    name-id
    args
    ret-ty
    sret-var
    origin)
    [(LowerMaybeDirectStore.Store done-state) (ResultLowerState.Ok done-state)]
    [(LowerMaybeDirectStore.Err message) (ResultLowerState.Err message)]
    [(LowerMaybeDirectStore.No)
      (lower-return-expr-generic ctx state env type-env origin ret-ty sret-var)]))

(define (lower-return-call-name-to-sret
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (let
    [source-name : String (lower-hygiene-source-name name)]
    [variant-name : String
      (lower-variant-constructor-lookup-name ctx source-name raw-name-id ret-ty)]
    [struct-name : String
      (match (tc-type-strip-region ret-ty)
        [(AstType.Struct resolved-struct)
          (if (lower-call-name-matches-nominal?
            ctx
            source-name
            (tc-nominal-name-id-display resolved-struct))
            (tc-nominal-name-id-display resolved-struct)
            (lower-module-lookup-name ctx source-name))]
        [(AstType.StructArgs resolved-struct _)
          (if (lower-call-name-matches-nominal?
            ctx
            source-name
            (tc-nominal-name-id-display resolved-struct))
            (tc-nominal-name-id-display resolved-struct)
            (lower-module-lookup-name ctx source-name))]
        [_ (lower-module-lookup-name ctx source-name)])]
    [variant-handle : i64
      (lower-variant-constructor-handle-id-or
        ctx
        source-name
        raw-name-id
        ret-ty
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? variant-handle)
      (match (lower-construct-enum-with-handle-into
        ctx
        state
        env
        type-env
        (CompilerIrValue.Var sret-var)
        variant-name
        variant-handle
        args
        ret-ty)
        [(ResultLowerState.Ok done-state)
          (lower-return-sret done-state ret-ty sret-var)]
        [(ResultLowerState.Err message) (ResultLowerState.Err message)])
      (let
        [struct-handle : i64
          (lower-struct-constructor-handle-id-or
            ctx
            state
            raw-name-id
            lookup-name-id
            ret-ty
            (compiler-symbols-missing-handle))]
        (if (and
          (or
            (tc-constructor-name-id? ctx raw-name-id)
            (tc-constructor-name-id? ctx lookup-name-id))
          (compiler-symbols-handle-found? struct-handle)
          (=
            (compiler-symbol-handle-kind struct-handle)
            (compiler-symbol-kind-defstruct)))
          (match (lower-construct-struct-into
            ctx
            state
            env
            type-env
            (CompilerIrValue.Var sret-var)
            struct-name
            struct-handle
            args
            ret-ty)
            [(ResultLowerState.Ok done-state)
              (lower-return-sret done-state ret-ty sret-var)]
            [(ResultLowerState.Err message) (ResultLowerState.Err message)])
          (lower-return-call-fallback-to-sret
            ctx
            state
            env
            type-env
            name
            lookup-name-id
            args
            ret-ty
            sret-var
            origin))))))

(define (lower-return-call-to-sret
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or raw-name raw-name)]
        [raw-text : String (intern-str source-id)]
        (if (tc-dotted-local-field-name-id? type-env raw-name)
          (lower-return-expr-generic
            ctx
            state
            env
            type-env
            origin
            ret-ty
            sret-var)
          (if (sym_i64_env.sym-i64-contains-id env raw-name)
            (lower-return-expr-generic
              ctx
              state
              env
              type-env
              origin
              ret-ty
              sret-var)
            (match (if (or
              (macro-hygiene-global-id? raw-name)
              (tc-hygiene-global-name? raw-text))
              (match (tc-source-name-lookup-key-with-field-check-lookup
                ctx
                type-env
                raw-text
                raw-name
                true)
                [(TcNameLookup.Ok _ resolved-id)
                  (TcNameLookup.Ok
                    (lower-hygiene-source-name-in-context-id
                      ctx
                      type-env
                      raw-name)
                    resolved-id)]
                [(TcNameLookup.Err _)
                  (TcNameLookup.Ok
                    (lower-hygiene-source-name-in-context-id
                      ctx
                      type-env
                      raw-name)
                    raw-name)])
              (if (tc-source-slash-qualified-id? raw-text source-id)
                (TcNameLookup.Ok raw-text source-id)
                (tc-source-name-lookup-key-with-field-check-lookup
                  ctx
                  type-env
                  raw-text
                  raw-name
                  true)))
              [(TcNameLookup.Ok name lookup-name-id)
                (lower-return-call-name-to-sret
                  ctx
                  state
                  env
                  type-env
                  name
                  raw-name
                  lookup-name-id
                  args
                  ret-ty
                  sret-var
                  origin)]
              [(TcNameLookup.Err _)
                (lower-return-expr-generic
                  ctx
                  state
                  env
                  type-env
                  origin
                  ret-ty
                  sret-var)]))))]
    [_
      (lower-return-expr-generic ctx state env type-env origin ret-ty sret-var)]))

(define (lower-return-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (if (and
    (>= sret-var 0)
    (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
    (match expr
      [(AstExpr.Spanned inner-box _)
        (let
          [inner : AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-return-expr ctx state env type-env inner ret-ty sret-var))]
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (lower-context-expr-get ctx func-box)]
          (lower-return-call-to-sret
            ctx
            state
            env
            type-env
            func
            args
            ret-ty
            sret-var
            expr))]
      [_
        (lower-return-expr-generic ctx state env type-env expr ret-ty sret-var)])
    (lower-return-expr-generic ctx state env type-env expr ret-ty sret-var)))

(define (lower-tail-call-safe-param-aggregate-arg?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-tail-call-safe-param-aggregate-arg?
        ctx
        state
        env
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-tail-call-safe-param-aggregate-arg?
        ctx
        state
        env
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? var-id)
          (lower-state-tail-param-range-contains? state var-id)
          false))]
    [_ false]))

(define (lower-expr-list-contains-unsafe-inline-aggregate?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : bool
  (lower-expr-list-contains-unsafe-inline-aggregate-at?
    ctx
    state
    env
    type-env
    (& exprs)
    0))

(define (lower-expr-list-contains-unsafe-inline-aggregate-at?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (let
      [expr : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get exprs index 0))]
      (match (tc-expr ctx type-env expr)
        [(ResultTcType.Ok ty)
          (or
            (and
              (lower-type-contains-inline-aggregate? ctx ty)
              (not
                (lower-tail-call-safe-param-aggregate-arg? ctx state env expr)))
            (lower-expr-list-contains-unsafe-inline-aggregate-at?
              ctx
              state
              env
              type-env
              exprs
              (+ index 1)))]
        [(ResultTcType.Err _)
          (lower-expr-list-contains-unsafe-inline-aggregate-at?
            ctx
            state
            env
            type-env
            exprs
            (+ index 1))]))))

(define (lower-tail-call-inline-aggregate-risk?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]) : bool
  (or
    ;; Aggregate returns do not make frame reuse unsafe when the current
    ;; function has the caller-owned sret slot to forward to the callee.
    (and
      (< sret-var 0)
      (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
    (lower-expr-list-contains-unsafe-inline-aggregate?
      ctx
      state
      env
      type-env
      args)))

(define (lower-tail-call-append-current-sret-arg
  [ctx : TcContext]
  [state : LowerState]
  [values : CompilerIrValueList]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerArgs
  (if (and
    (>= sret-var 0)
    (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
    (ResultLowerArgs.Ok
      state
      (lower-value-list-append-one values (CompilerIrValue.Var sret-var)))
    (ResultLowerArgs.Ok state values)))

(define (lower-tail-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [callee : AstExpr]
  [args : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (match (ast-expr-unspan callee)
    [(AstExpr.Var name)
      (let
        [unshadowed : bool (lower-tail-call-var-unshadowed? env name)]
        (cond
          [(and unshadowed (lower-comptime-error-call-id? name))
            (ResultLowerState.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: comptime-error is compile-time only")))]
          [(and
              unshadowed
              (lower-string-concat-call-source? ctx env type-env name))
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]
          [(and
              unshadowed
              ;; Only suppress TCO when THIS call actually involves inline
              ;; aggregates (sret/by-value risk); a broad inline-aggregates-mode guard
              ;; disabled tail-call optimization for every call (mode is always on),
              ;; losing TCO entirely (deep self-recursion, smoke shape failure).
              (not
                (lower-tail-call-inline-aggregate-risk?
                  ctx
                  state
                  env
                  type-env
                  args
                  ret-ty
                  sret-var))
              (lower-tail-call-direct-supported?
                ctx
                state
                env
                type-env
                name
                ret-ty))
            (match (lower-tail-call-args-for-target
              ctx
              state
              env
              type-env
              name
              args)
              [(ResultLowerArgs.Ok args-state values)
                (match (lower-tail-call-append-current-sret-arg
                  ctx
                  args-state
                  values
                  ret-ty
                  sret-var)
                  [(ResultLowerArgs.Ok tail-state tail-values)
                    (ResultLowerState.Ok
                      (lower-state-emit-at-expr
                        tail-state
                        (CompilerIrInstr.TailCall
                          (lower-resolve-name-symbol-id tail-state name)
                          (compiler-ir-call-args-from-list tail-values)
                          (lower-one-word-register-storage-type ctx ret-ty))
                        origin))]
                  [(ResultLowerArgs.Err message) (ResultLowerState.Err message)])]
              [(ResultLowerArgs.Err message) (ResultLowerState.Err message)])]
          [unshadowed
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]
          [(lower-tail-call-local-indirect-safe? env type-env name)
            (lower-tail-call-indirect-expr
              ctx
              state
              env
              type-env
              callee
              args
              ret-ty
              sret-var
              origin)]
          [else
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]))]
    [_
      (if (lower-tail-call-reference-capturing-lambda? ctx type-env callee)
        (lower-return-expr ctx state env type-env origin ret-ty sret-var)
        (lower-tail-call-indirect-expr
          ctx
          state
          env
          type-env
          callee
          args
          ret-ty
          sret-var
          origin))]))

(define (lower-tail-begin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (lower-tail-begin-at ctx state env type-env (& exprs) 0 ret-ty sret-var))

(define (lower-tail-begin-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (let
    [len : i64 (struct-get exprs len)]
    (if (>= index len)
      (ResultLowerState.Ok
        (lower-state-emit
          state
          (CompilerIrInstr.Return
            (lower-return-maybe CompilerIrValue.Unit ret-ty))))
      (let
        [expr : AstExpr
          (lower-context-expr-get ctx (ast-expr-list-get exprs index 0))]
        (if (= (+ index 1) len)
          (lower-tail-expr ctx state env type-env expr ret-ty sret-var)
          (match (lower-expr ctx state env type-env expr)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr next-state _ expr-ty)
                  (if (tc-never-type? expr-ty)
                    (ResultLowerState.Ok next-state)
                    (lower-tail-begin-at
                      ctx
                      next-state
                      env
                      type-env
                      exprs
                      (+ index 1)
                      ret-ty
                      sret-var))])]
            [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))))))

(define (lower-tail-if
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [cond : AstExpr]
  [then-branch : AstExpr]
  [else-branch : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-expr ctx state env type-env cond)
    [(ResultLowerExpr.Ok cond-lowered)
      (match cond-lowered
        [(LowerExpr.Expr cond-state cond-value _)
          (match (lower-state-fresh-label cond-state "if_then")
            [(LowerLabel.Label then-label-state then-label)
              (match (lower-state-fresh-label then-label-state "if_else")
                [(LowerLabel.Label else-label-state else-label)
                  (let
                    [branch-state : LowerState
                      (lower-state-emit
                        else-label-state
                        (CompilerIrInstr.Branch
                          cond-value
                          then-label
                          else-label))]
                    (match (lower-tail-expr
                      ctx
                      (lower-state-finish-block branch-state then-label)
                      env
                      type-env
                      then-branch
                      ret-ty
                      sret-var)
                      [(ResultLowerState.Ok then-state)
                        (lower-tail-expr
                          ctx
                          (lower-state-finish-block then-state else-label)
                          env
                          type-env
                          else-branch
                          ret-ty
                          sret-var)]
                      [(ResultLowerState.Err message)
                        (ResultLowerState.Err message)]))])])])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-tail-match-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (if (ast-match-arm-list-empty? (& arms))
    (ResultLowerState.Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : AstMatchArm
        (ast-match-arm-list-get (& arms) 0 (ast-match-arm-fallback))]
      [rest : AstMatchArmList (ast-match-arm-list-tail arms)]
      (if (ast-match-arm-list-empty? (& rest))
        (lower-tail-match-catch-all
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          arm
          ret-ty
          sret-var)
        (match arm
          [(AstMatchArm.Arm pat body-box)
            (let
              [body : AstExpr (lower-context-expr-get ctx body-box)]
              (match pat
                [(AstPattern.Literal lit)
                  (lower-tail-match-literal-arm
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    lit
                    body
                    rest
                    ret-ty
                    sret-var)]
                [(AstPattern.Binding _)
                  (lower-tail-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    ret-ty
                    sret-var)]
                [(AstPattern.Wildcard)
                  (lower-tail-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    ret-ty
                    sret-var)]
                [(AstPattern.Variant variant-name _)
                  (if (lower-box-pattern-for-type? ctx scrut-ty variant-name)
                    (lower-tail-match-catch-all
                      ctx
                      state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arm
                      ret-ty
                      sret-var)
                    (if (lower-struct-pattern-for-type?
                      ctx
                      scrut-ty
                      variant-name)
                      (lower-tail-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        ret-ty
                        sret-var)
                      (ResultLowerState.Err
                        (box
                          (lower-diagnostic "lower: unsupported match pattern")))))]
                [_
                  (ResultLowerState.Err
                    (box (lower-diagnostic "lower: unsupported match pattern")))]))])))))

(define (lower-tail-match-literal-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [lit : AstLiteral]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc eq-alloc eq-var)
      (let
        [eq-state : LowerState
          (lower-state-emit
            eq-alloc
            (CompilerIrInstr.BinOp
              eq-var
              CompilerIrBinOp.Eq
              (CompilerIrValue.Var scrut-var)
              (lower-literal-value-with-type lit scrut-ty)
              scrut-ty))]
        (match (lower-state-fresh-label eq-state "match_arm")
          [(LowerLabel.Label body-label-state body-label)
            (match (lower-state-fresh-label body-label-state "match_next")
              [(LowerLabel.Label next-label-state next-label)
                (let
                  [body-start : LowerState
                    (lower-state-finish-block
                      (lower-state-emit
                        next-label-state
                        (CompilerIrInstr.Branch
                          (CompilerIrValue.Var eq-var)
                          body-label
                          next-label))
                      body-label)]
                  (match (lower-tail-expr
                    ctx
                    body-start
                    env
                    type-env
                    body
                    ret-ty
                    sret-var)
                    [(ResultLowerState.Ok body-state)
                      (lower-tail-match-arms
                        ctx
                        (lower-state-finish-block body-state next-label)
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        rest
                        ret-ty
                        sret-var)]
                    [(ResultLowerState.Err message)
                      (ResultLowerState.Err message)]))])]))]))

(define (lower-tail-match-catch-all
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arm : AstMatchArm]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match arm
    [(AstMatchArm.Arm pat body-box)
      (let
        [body : AstExpr (lower-context-expr-get ctx body-box)]
        (match (lower-bind-match-catch-all-pattern
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          pat)
          [(ResultLowerEnv.Ok body-start body-env body-type-env)
            (lower-tail-expr
              ctx
              body-start
              body-env
              body-type-env
              body
              ret-ty
              sret-var)]
          [(ResultLowerEnv.Err message) (ResultLowerState.Err message)]))]))

(define (lower-tail-match-enum
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeNameId]
  [force-memory : bool]) : ResultLowerState
  (let
    [scrut-words : i64 (lower-type-register-words ctx scrut-ty)]
    (if (and (> scrut-words 0) (not force-memory))
      (if (= scrut-words 2)
        (match (lower-emit-word
          state
          (CompilerIrValue.Var scrut-var)
          0
          (AstType.I64))
          [(LowerExpr.Expr tag-state tag-value _)
            (match tag-value
              [(CompilerIrValue.Var tag-var)
                (lower-tail-match-enum-arms
                  ctx
                  tag-state
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  arms
                  ret-ty
                  sret-var
                  borrow-lifetime
                  true)]
              [_
                (ResultLowerState.Err
                  (box
                    (lower-diagnostic "lower: internal enum tag extract failed")))])])
        (lower-tail-match-enum-arms
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          scrut-var
          arms
          ret-ty
          sret-var
          borrow-lifetime
          false))
      (match (lower-load-at-offset
        state
        (CompilerIrValue.Var scrut-var)
        0
        (AstType.I64))
        [(LowerExpr.Expr tag-state tag-value _)
          (match tag-value
            [(CompilerIrValue.Var tag-var)
              (lower-tail-match-enum-arms
                ctx
                tag-state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arms
                ret-ty
                sret-var
                borrow-lifetime
                false)]
            [_
              (ResultLowerState.Err
                (box (lower-diagnostic "lower: internal enum tag load failed")))])]))))

(define (lower-tail-match-enum-final-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [arm : AstMatchArm]
  [pat : AstPattern]
  [body : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match pat
    [(AstPattern.Wildcard)
      (lower-tail-match-catch-all
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arm
        ret-ty
        sret-var)]
    [(AstPattern.Binding variant-name)
      (lower-tail-match-variant-final
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        variant-name
        (ast-pattern-list-new)
        body
        ret-ty
        sret-var
        borrow-lifetime
        scrut-reg-group?)]
    [(AstPattern.Variant variant-name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (lower-tail-match-variant-final
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          variant-name
          args
          body
          ret-ty
          sret-var
          borrow-lifetime
          scrut-reg-group?))]
    [_
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-tail-match-enum-branch-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [arm : AstMatchArm]
  [pat : AstPattern]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match pat
    [(AstPattern.Wildcard)
      (lower-tail-match-catch-all
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arm
        ret-ty
        sret-var)]
    [(AstPattern.Binding variant-name)
      (lower-tail-match-variant-arm
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        tag-var
        variant-name
        (ast-pattern-list-new)
        body
        rest
        ret-ty
        sret-var
        borrow-lifetime
        scrut-reg-group?)]
    [(AstPattern.Variant variant-name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (lower-tail-match-variant-arm
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          tag-var
          variant-name
          args
          body
          rest
          ret-ty
          sret-var
          borrow-lifetime
          scrut-reg-group?))]
    [_
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-tail-match-enum-arms
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [arms : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerState
  (if (ast-match-arm-list-empty? (& arms))
    (ResultLowerState.Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : AstMatchArm
        (ast-match-arm-list-get (& arms) 0 (ast-match-arm-fallback))]
      [rest : AstMatchArmList (ast-match-arm-list-tail arms)]
      (match arm
        [(AstMatchArm.Arm pat body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (if (ast-match-arm-list-empty? (& rest))
              (lower-tail-match-enum-final-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                arm
                pat
                body
                ret-ty
                sret-var
                borrow-lifetime
                scrut-reg-group?)
              (lower-tail-match-enum-branch-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arm
                pat
                body
                rest
                ret-ty
                sret-var
                borrow-lifetime
                scrut-reg-group?)))]))))

;; Per-match variant arm resolution memo. Each arm of one match re-runs the
;; same constructor/payload resolution chain (tc-env-key-name-text, scrutinee
;; type resolution, lower-variant-constructor-handle-id-or,
;; compiler-registries-variant-fields-indexed,
;; lower-variant-payload-fields-for-handle,
;; lower-variant-handle-name-id-or), whose inputs are constant across the
;; arms of one match and pure (registries and ctx caches only grow during one
;; function's lowering). Memoize the resolution per (variant-name-id,
;; scrutinee type) for the lifetime of one function in a small direct-mapped
;; cache in program-arena arrays allocated at module init, tagged by a
;; generation bumped in lower-function-escaping (next to tc-rtf-next-gen!).
;; Collisions simply evict; the result is exact either way.
(defenum LowerVariantArmResolution
  (Missing String)
  (FieldsErr String)
  (Some String AstType i64 AstTypeList i64))

(define lower-variant-arm-memo-generation : i64
  0)
(define lower-variant-arm-memo-stamps : (Array i64)
  (array.make-array i64 256))
(define lower-variant-arm-memo-keys : (Array i64)
  (array.make-array i64 256))
(define lower-variant-arm-memo-scrut-tys : (Array AstType)
  (array.make-array AstType 256))
(define lower-variant-arm-memo-outcomes : (Array LowerVariantArmResolution)
  (array.make-array LowerVariantArmResolution 256))

(define (lower-variant-arm-memo-next-gen!) : unit
  (set!
    lower-variant-arm-memo-generation
    (+ lower-variant-arm-memo-generation 1)))

(define (lower-variant-arm-resolution-compute
  [ctx : TcContext]
  [symbols : CompilerSymbols]
  [scrut-ty : AstType]
  [variant-name-id : i64]) : LowerVariantArmResolution
  (let
    [variant-name : String (tc-env-key-name-text variant-name-id)]
    [resolved-scrut-ty : AstType
      (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
    [handle : i64
      (lower-variant-constructor-handle-id-or
        ctx
        variant-name
        variant-name-id
        resolved-scrut-ty
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (compiler-registries-variant-fields-indexed symbols handle)
        [(ResultAstTypeList.Ok fields)
          (LowerVariantArmResolution.Some
            variant-name
            resolved-scrut-ty
            handle
            (lower-variant-payload-fields-for-handle
              ctx
              handle
              resolved-scrut-ty
              fields)
            (lower-variant-handle-name-id-or ctx handle variant-name-id))]
        [(ResultAstTypeList.Err message)
          (LowerVariantArmResolution.FieldsErr message)])
      (LowerVariantArmResolution.Missing variant-name))))

(define (lower-variant-arm-resolution
  [ctx : TcContext]
  [symbols : CompilerSymbols]
  [scrut-ty : AstType]
  [variant-name-id : i64]) : LowerVariantArmResolution
  (let
    [slot : i64 (- variant-name-id (* (/ variant-name-id 256) 256))]
    (if (and
      (=
        (array-ref lower-variant-arm-memo-stamps slot)
        lower-variant-arm-memo-generation)
      (= (array-ref lower-variant-arm-memo-keys slot) variant-name-id)
      (ast-type-eq? (array-ref lower-variant-arm-memo-scrut-tys slot) scrut-ty))
      (array-ref lower-variant-arm-memo-outcomes slot)
      (let
        [result : LowerVariantArmResolution
          (lower-variant-arm-resolution-compute
            ctx
            symbols
            scrut-ty
            variant-name-id)]
        (begin
          (match result
            ;; Error results stay recomputed: diagnostics are cold paths and
            ;; must not pin a stale message across scrutinee types.
            [(LowerVariantArmResolution.FieldsErr _) unit]
            [_
              (begin
                (array-set!
                  lower-variant-arm-memo-stamps
                  slot
                  lower-variant-arm-memo-generation)
                (array-set! lower-variant-arm-memo-keys slot variant-name-id)
                (array-set! lower-variant-arm-memo-scrut-tys slot scrut-ty)
                (array-set! lower-variant-arm-memo-outcomes slot result))])
          result)))))

(define (lower-tail-match-variant-final
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [variant-name-id : i64]
  [args : AstPatternList]
  [body : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match ctx
    [(TcContext _ symbols registries _ _ _ _ _)
      (match (lower-variant-arm-resolution ctx symbols scrut-ty variant-name-id)
        [(LowerVariantArmResolution.Missing variant-name)
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))]
        [(LowerVariantArmResolution.FieldsErr message)
          (ResultLowerState.Err (box (lower-diagnostic message)))]
        [(LowerVariantArmResolution.Some
            variant-name
            resolved-scrut-ty
            handle
            resolved-fields
            handle-name-id)
          (if (lower-pattern-list-refutable-for-types? ctx args resolved-fields)
            (ResultLowerState.Err
              (box
                (lower-diagnostic
                  "lower: refutable payload pattern in final match arm requires a trailing catch-all")))
            (match (lower-bind-match-variant-payloads
              ctx
              state
              env
              type-env
              borrow-lifetime
              (CompilerIrValue.Var scrut-var)
              args
              resolved-fields
              (lower-state-mode state)
              (lower-enum-type-name-id-or resolved-scrut-ty -1)
              (lower-enum-type-name-or-empty resolved-scrut-ty)
              variant-name
              handle-name-id
              0
              8
              (lower-state-current-label state)
              scrut-reg-group?)
              [(ResultLowerEnv.Ok body-start body-env body-type-env)
                (lower-tail-expr
                  ctx
                  body-start
                  body-env
                  body-type-env
                  body
                  ret-ty
                  sret-var)]
              [(ResultLowerEnv.Err message) (ResultLowerState.Err message)]))])]))

(define (lower-tail-match-variant-body
  [ctx : TcContext]
  [body-start : LowerState]
  [next-label : String]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [variant-name : String]
  [variant-name-id : i64]
  [fields : AstTypeList]
  [args : AstPatternList]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match (lower-bind-match-variant-payloads
    ctx
    body-start
    env
    type-env
    borrow-lifetime
    (CompilerIrValue.Var scrut-var)
    args
    fields
    (lower-state-mode body-start)
    (lower-enum-type-name-id-or scrut-ty -1)
    (lower-enum-type-name-or-empty scrut-ty)
    variant-name
    variant-name-id
    0
    8
    next-label
    scrut-reg-group?)
    [(ResultLowerEnv.Ok bound-state body-env body-type-env)
      (match (lower-tail-expr
        ctx
        bound-state
        body-env
        body-type-env
        body
        ret-ty
        sret-var)
        [(ResultLowerState.Ok body-state)
          (lower-tail-match-enum-arms
            ctx
            (lower-state-finish-block body-state next-label)
            env
            type-env
            scrut-var
            scrut-ty
            tag-var
            rest
            ret-ty
            sret-var
            borrow-lifetime
            scrut-reg-group?)]
        [(ResultLowerState.Err message) (ResultLowerState.Err message)])]
    [(ResultLowerEnv.Err message) (ResultLowerState.Err message)]))

(define (lower-tail-match-variant-arm
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : AstType]
  [tag-var : i64]
  [variant-name-id : i64]
  [args : AstPatternList]
  [body : AstExpr]
  [rest : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [borrow-lifetime : TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match ctx
    [(TcContext _ symbols registries _ _ _ _ _)
      (match (lower-variant-arm-resolution ctx symbols scrut-ty variant-name-id)
        [(LowerVariantArmResolution.Missing variant-name)
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))]
        [(LowerVariantArmResolution.FieldsErr message)
          (ResultLowerState.Err (box (lower-diagnostic message)))]
        [(LowerVariantArmResolution.Some
            variant-name
            resolved-scrut-ty
            handle
            resolved-fields
            handle-name-id)
          (match (lower-state-alloc-var state)
            [(LowerAlloc.Alloc eq-alloc eq-var)
              (let
                [eq-state : LowerState
                  (lower-state-emit
                    eq-alloc
                    (CompilerIrInstr.BinOp
                      eq-var
                      CompilerIrBinOp.Eq
                      (CompilerIrValue.Var tag-var)
                      (CompilerIrValue.I64
                        (compiler-registry-handle-child-index handle))
                      (AstType.I64)))]
                (match (lower-state-fresh-label eq-state "match_arm")
                  [(LowerLabel.Label body-label-state body-label)
                    (match (lower-state-fresh-label
                      body-label-state
                      (lower-enum-match-next-label-base
                        (lower-state-current-label state)
                        rest))
                      [(LowerLabel.Label next-label-state next-label)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                next-label-state
                                (CompilerIrInstr.Branch
                                  (CompilerIrValue.Var eq-var)
                                  body-label
                                  next-label))
                              body-label)]
                          (lower-tail-match-variant-body
                            ctx
                            body-start
                            next-label
                            env
                            type-env
                            scrut-var
                            scrut-ty
                            tag-var
                            variant-name
                            handle-name-id
                            resolved-fields
                            args
                            body
                            rest
                            ret-ty
                            sret-var
                            borrow-lifetime
                            scrut-reg-group?))])]))])])]))

(define (lower-borrowed-enum-match-scrutinee?
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [scrutinee : AstExpr]) : bool
  (match (ast-expr-unspan scrutinee)
    [(AstExpr.Borrow mutable _ _)
      (if mutable
        false
        (match (tc-expr ctx type-env scrutinee)
          [(ResultTcType.Ok scrut-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
              [(AstType.Ref _ referent-box)
                (let
                  [referent-ty : AstType
                    (tc-type-strip-region
                      (tc-resolve-type
                        ctx
                        (tc-context-type-get ctx referent-box)))]
                  (match referent-ty
                    [(AstType.Enum _) true]
                    [(AstType.EnumArgs _ _) true]
                    [_ false]))]
              [_ false])]
          [(ResultTcType.Err _) false]))]
    [_ false]))

;; Where the scrutinee of a match should live: when it is already a var (the
;; common case -- a local, an array-ref result, a call result) use that var
;; directly instead of allocating a fresh one and emitting a group-copying
;; Mov into it (a 2-word enum pays a Pack round-trip per copy).
(defenum LowerScrutineeHome
  (Home LowerState i64))

(define (lower-tail-match-scrutinee-home
  [state : LowerState]
  [scrut-value : CompilerIrValue]
  [scrut-ty : AstType]) : LowerScrutineeHome
  (match scrut-value
    [(CompilerIrValue.Var scrutinee-var)
      (LowerScrutineeHome.Home state scrutinee-var)]
    [_
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc scrut-alloc scrut-var)
          (LowerScrutineeHome.Home
            (lower-state-emit
              scrut-alloc
              (CompilerIrInstr.Mov scrut-var scrut-value scrut-ty))
            scrut-var)])]))

(define (lower-tail-match
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]
  [ret-ty : AstType]
  [sret-var : i64]
  [origin : AstExpr]) : ResultLowerState
  (if (lower-borrowed-enum-match-scrutinee? ctx type-env scrutinee)
    (lower-return-expr ctx state env type-env origin ret-ty sret-var)
    (match (lower-expr ctx state env type-env scrutinee)
      [(ResultLowerExpr.Ok scrut-lowered)
        (match scrut-lowered
          [(LowerExpr.Expr scrut-state scrut-value scrut-ty)
            (match (lower-tail-match-scrutinee-home
              scrut-state
              scrut-value
              scrut-ty)
              [(LowerScrutineeHome.Home match-state scrut-var)
                (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
                  [(AstType.Enum _)
                    (lower-tail-match-enum
                      ctx
                      match-state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var
                      (TcMaybeNameId.No)
                      false)]
                  [(AstType.EnumArgs _ _)
                    (lower-tail-match-enum
                      ctx
                      match-state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var
                      (TcMaybeNameId.No)
                      false)]
                  [(AstType.Ref borrow-lifetime referent-box)
                    (let
                      [referent-ty : AstType
                        (tc-type-strip-region
                          (tc-resolve-type
                            ctx
                            (tc-context-type-get ctx referent-box)))]
                      (match referent-ty
                        [(AstType.Enum _)
                          (lower-tail-match-enum
                            ctx
                            match-state
                            env
                            type-env
                            scrut-var
                            referent-ty
                            arms
                            ret-ty
                            sret-var
                            (TcMaybeNameId.Some borrow-lifetime)
                            true)]
                        [(AstType.EnumArgs _ _)
                          (lower-tail-match-enum
                            ctx
                            match-state
                            env
                            type-env
                            scrut-var
                            referent-ty
                            arms
                            ret-ty
                            sret-var
                            (TcMaybeNameId.Some borrow-lifetime)
                            true)]
                        [_
                          (lower-tail-match-arms
                            ctx
                            match-state
                            env
                            type-env
                            scrut-var
                            scrut-ty
                            arms
                            ret-ty
                            sret-var)]))]
                  [(AstType.VarArgs _ _)
                    (lower-tail-match-enum
                      ctx
                      match-state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var
                      (TcMaybeNameId.No)
                      false)]
                  [_
                    (lower-tail-match-arms
                      ctx
                      match-state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var)])])])]
      [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])))

(define (lower-tail-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [ret-ty : AstType]
  [sret-var : i64]) : ResultLowerState
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-tail-expr ctx state env type-env inner ret-ty sret-var))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-tail-expr ctx state env type-env inner ret-ty sret-var))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (tc-expr ctx type-env inner)
          [(ResultTcType.Ok inner-ty)
            (if (tc-type-eq (tc-type-without-regions inner-ty) ret-ty)
              (lower-tail-expr ctx state env type-env inner ret-ty sret-var)
              (lower-return-expr ctx state env type-env expr ret-ty sret-var))]
          [(ResultTcType.Err message)
            (ResultLowerState.Err
              (box (lower-diagnostic-at-expr inner message)))]))]
    [(AstExpr.Call callee-box args)
      (let
        [callee : AstExpr (lower-context-expr-get ctx callee-box)]
        (lower-tail-call
          ctx
          state
          env
          type-env
          callee
          args
          ret-ty
          sret-var
          expr))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(ResultLowerEnv.Ok binding-state body-env body-type-env)
                (lower-tail-expr
                  ctx
                  binding-state
                  body-env
                  body-type-env
                  body
                  ret-ty
                  sret-var)]
              [(ResultLowerEnv.Err message) (ResultLowerState.Err message)]))])]
    [(AstExpr.Begin exprs)
      (lower-tail-begin ctx state env type-env exprs ret-ty sret-var)]
    [(AstExpr.Unsafe exprs)
      (lower-tail-begin
        ctx
        state
        env
        (tc-enter-unsafe type-env)
        exprs
        ret-ty
        sret-var)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-tail-if
          ctx
          state
          env
          type-env
          cond
          then-branch
          else-branch
          ret-ty
          sret-var))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-tail-match
              ctx
              state
              env
              type-env
              scrutinee
              arms
              ret-ty
              sret-var
              expr))])]
    [_ (lower-return-expr ctx state env type-env expr ret-ty sret-var)]))

(define (lower-param-count [params : AstParamList]) : i64
  (ast-param-list-len (& params)))

(define (lower-bind-params
  [params : AstParamList]
  [idx : i64]
  [env : sym_i64_env.SymI64Env]) : sym_i64_env.SymI64Env
  (lower-bind-params-at (& params) 0 idx env))

(define (lower-bind-params-at
  [params : (& params AstParamList)]
  [index : i64]
  [idx : i64]
  [env : sym_i64_env.SymI64Env]) : sym_i64_env.SymI64Env
  (if (>= index (ast-param-list-len params))
    env
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name _ _ _)
        (lower-bind-params-at
          params
          (+ index 1)
          (+ idx 1)
          (sym_i64_env.sym-i64-bind-id env name idx))])))

(define (lower-param-list [ctx : TcContext] [params : AstParamList] [idx : i64]) : CompilerIrParamList
  (lower-param-list-at ctx (& params) 0 idx))

(define (lower-param-list-at
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [index : i64]
  [idx : i64]) : CompilerIrParamList
  (if (>= index (ast-param-list-len params))
    CompilerIrParamList.Nil
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name ty _ _)
        (compiler-ir-param-cons
          (CompilerIrParam.Param
            (tc-env-key-name-text name)
            (lower-one-word-register-storage-type
              ctx
              (tc-type-without-regions (tc-resolve-type ctx ty)))
            idx)
          (lower-param-list-at ctx params (+ index 1) (+ idx 1)))])))

;; sret ABI: append the hidden result-slot pointer param at index
;; `sret-var` (the var id reserved just past the real params). Internal calling
;; convention only -- C-ABI externs keep their own ABI on a separate path.
(define (lower-param-list-append-sret
  [params : CompilerIrParamList]
  [sret-var : i64]) : CompilerIrParamList
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil)
      (compiler-ir-param-cons
        (CompilerIrParam.Param "__sret" (AstType.U64) sret-var)
        CompilerIrParamList.Nil)]
    [(CompilerIrParamList.Array seq)
      (lower-param-list-append-sret
        (compiler-ir-param-seq-to-list seq)
        sret-var)]
    [(CompilerIrParamList.Cons head rest)
      (compiler-ir-param-cons
        head
        (lower-param-list-append-sret (box-get rest) sret-var))]))

(define (lower-supported-function-param-type? [ctx : TcContext] [ty : AstType]) : bool
  (lower-supported-reference-type? ctx ty))

(define (lower-type-contains-inline-aggregate? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Tuple elems)
      (lower-type-list-contains-inline-aggregate? ctx (box-get elems))]
    [(AstType.Array _ _) true]
    [(AstType.Region _ inner)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc-context-type-get ctx inner))]
    ;; A reference can point INTO the current frame (memory-aggregate
    ;; locals live in frame slots), so a ref arg whose referent is or
    ;; contains an inline aggregate makes a tail call unsafe -- the callee
    ;; would read through a pointer into the reused/abandoned frame.
    [(AstType.Ref _ referent)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc-context-type-get ctx referent))]
    [(AstType.MutRef _ referent)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc-context-type-get ctx referent))]
    [_ false]))

(define (lower-type-list-contains-inline-aggregate?
  [ctx : TcContext]
  [types : AstTypeList]) : bool
  (lower-type-list-contains-inline-aggregate-at? ctx (& types) 0))

(define (lower-type-list-contains-inline-aggregate-at?
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (let
      [ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      (or
        (lower-type-contains-inline-aggregate? ctx ty)
        (lower-type-list-contains-inline-aggregate-at? ctx types (+ index 1))))))

(define (lower-param-list-contains-unsupported-reference?
  [ctx : TcContext]
  [params : AstParamList]) : bool
  (lower-param-list-contains-unsupported-reference-at? ctx (& params) 0))

(define (lower-param-list-contains-unsupported-reference-at?
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [index : i64]) : bool
  (if (>= index (ast-param-list-len params))
    false
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _ _)
        (or
          (not (lower-supported-function-param-type? ctx ty))
          (lower-param-list-contains-unsupported-reference-at?
            ctx
            params
            (+ index 1)))])))

(define (lower-supported-function-return-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-resolve-type ctx ty)
    [(AstType.Region _ inner)
      (lower-supported-function-return-type?
        ctx
        (tc-context-type-get ctx inner))]
    [_ true]))

(define (lower-logical-name-has-prefix?
  [logical-name : String]
  [prefix : String]) : bool
  (let
    [name-len : i64 (string.string-length logical-name)]
    [prefix-len : i64 (string.string-length prefix)]
    (and
      (>= name-len prefix-len)
      (string.eq (string.substring logical-name 0 prefix-len) prefix))))

;; sret ABI: a `__global_init_<name>` initializer's result is stored into
;; a forever-lived global by the backend's startup sequence (not a normal call
;; site), so it must return stable arena storage -- never a caller stack sret
;; slot. Keep these on the arena return path.
(define (lower-global-init-function? [logical-name : String]) : bool
  (lower-logical-name-has-prefix? logical-name "__global_init_"))

(define (lower-function
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (if (or
    (lower-param-list-contains-unsupported-reference? ctx params)
    (not (lower-supported-reference-type? ctx ret)))
    (ResultLowerFunction.Err
      (box (lower-diagnostic (lower-reference-support-message))))
    (let
      [logical-name-text : String (compiler-ir-symbol-text logical-name)]
      [param-count : i64 (lower-param-count params)]
      [ret-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ret))]
      [ret-ir-ty : AstType (lower-one-word-register-storage-type ctx ret-ty)]
      ;; sret ABI: an aggregate-returning function takes a hidden
      ;; result-slot pointer at var `param-count` (just past the real params);
      ;; the body writes the result through it instead of arena-copying.
      [sret-needed : bool
        (and
          (lower-mode-inline-aggregates? mode)
          (not (lower-global-init-function? logical-name-text))
          (lower-type-inline-struct-or-enum? ctx ret-ty)
          (not (lower-type-register-resident? ctx ret-ty)))]
      [sret-var : i64
        (if sret-needed
          param-count
          (- 0 1))]
      [env : sym_i64_env.SymI64Env
        (lower-bind-params params 0 (sym_i64_env.sym-i64-empty))]
      [type-env : TcTypeEnv
        (tc-bind-return-type
          (tc-bind-params ctx (tc-hygiene-global-env top-env) params)
          ret-ty)]
      [function-spans : CompilerSourceSpans
        (lower-record-function-span spans logical-name-text body)]
      [state : LowerState
        (LowerState.State
          (if sret-needed
            (+ param-count 1)
            param-count)
          0
          0
          "entry"
          (compiler-ir-instr-builder-new)
          (compiler-ir-block-builder-new)
          (compiler-ir-function-builder-new)
          logical-name-text
          (box function-spans)
          names
          type-cache
          mode
          (lower_i64_i64_map.with-capacity 8)
          0
          param-count)]
      (if (lower-supported-function-return-type? ctx ret-ty)
        (match (lower-tail-expr ctx state env type-env body ret-ty sret-var)
          [(ResultLowerState.Ok final-state)
            (ResultLowerFunction.Ok
              (lower-state-build-functions-with
                final-state
                (CompilerIrFunction.Function
                  logical-name
                  (if (>= sret-var 0)
                    (lower-param-list-append-sret
                      (lower-param-list ctx params 0)
                      sret-var)
                    (lower-param-list ctx params 0))
                  ret-ir-ty
                  (lower-state-next-var final-state)
                  (lower-state-build-function-blocks final-state)))
              (lower-state-spans final-state))]
          [(ResultLowerState.Err message) (ResultLowerFunction.Err message)])
        (ResultLowerFunction.Err
          (box (lower-diagnostic-at-expr body "lower: unsupported expression")))))))

(define (lower-global-value
  [ctx : TcContext]
  [names : LowerNameCache]
  [expr : AstExpr]
  [ty : AstType]) : ResultLowerValue
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value ctx names inner ty))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value ctx names inner ty))]
    [(AstExpr.Cast inner-box cast-ty)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value ctx names inner cast-ty))]
    [(AstExpr.Literal lit)
      (ResultLowerValue.Ok (lower-literal-value-with-type lit ty))]
    [(AstExpr.BinaryData bytes)
      (ResultLowerValue.Ok (CompilerIrValue.Bytes bytes))]
    [(AstExpr.SpmdProgramIndex) (ResultLowerValue.Ok (CompilerIrValue.I64 0))]
    [(AstExpr.SpmdProgramCount) (ResultLowerValue.Ok (CompilerIrValue.I64 1))]
    [(AstExpr.Var name)
      (let
        [logical-id : i64
          (lower-name-cache-resolve-logical-id (& names) name name)]
        [display-name : String
          (match (lower-name-cache-resolve-id-display names name)
            [(TcMaybeString.Some resolved) resolved]
            [(TcMaybeString.No)
              (intern-str (macro-hygiene-global-source-name-id-or name name))])]
        (ResultLowerValue.Ok
          (CompilerIrValue.Global
            (lower-name-cache-ir-symbol names logical-id name display-name))))]
    [_
      (ResultLowerValue.Err
        (box (lower-diagnostic "lower: unsupported global initializer")))]))

(define (lower-global-init-function-name [global : i64]) : i64
  (ci.intern-generated-name
    (string.append "__global_init_" (compiler-ir-symbol-text global))))

(define (lower-top-decl-type-or-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcType
  (let
    [actual : AstDecl (ast-decl-unwrapped decl)]
    (match actual
      [(AstDecl.Def decl-meta name _ _)
        (match (tc-lookup-id env name)
          [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
          [(ResultTcType.Err _) (tc-top-decl-type-with-env ctx env actual)])]
      [_ (tc-top-decl-type-with-env ctx env actual)])))

;; Record `name -> body span` into the provenance table. A function whose
;;
;; body carries no source span leaves the table unchanged, so the backend simply
;;
;; falls back to its default location for that function.
(define (lower-record-function-span
  [spans : CompilerSourceSpans]
  [name : String]
  [body : AstExpr]) : CompilerSourceSpans
  (match (lower-ast-expr-direct-span body)
    [(CompilerMaybeSourceSpan.Some span)
      (compiler-source-spans-insert spans name span)]
    [(CompilerMaybeSourceSpan.No) spans]))

;; Reusable per-function lowering scratch arena. Lowering one function
;; allocates a fresh `LowerState` plus the transient IR/AST-walk scratch the bump
;; allocator never frees; summed across cli.tl's ~5000 functions this transient
;; dominates the lower phase's peak live (the headline self-build memory number).
;; We lower each function inside one shared scratch arena and `tl_region_reset` it
;; after deep-`clone`ing ONLY the produced IR function list back into the
;; enclosing (program) arena -- reclaiming the per-function transient before the
;; next function. The arena is created lazily once and reused (rewound, never
;; remapped) per function, mirroring the optimizer's per-function escape
;; (`optimize-function-escaping`). The spans side-table insertion is recomputed
;; in the enclosing arena (it never affects emitted assembly, only backend-error
;; source locations). `lower-function-escaping` is only ever called at decl
;; granularity (never re-entrant within `lower-function`'s body walk), so a
;; single shared mark/rewind region is sound. Output stays byte-identical: the
;; clone is a structural deep copy, so the escaped IR lowers to the same assembly
;; as the in-place IR did.
;; Dotted imports create transient lookup-key strings during function lowering
;; (`module/name` from `alias.name`). Any new intern entry made from those
;; strings must survive the scratch rewind, so the scope mirrors
;; `tc-check-fn-decl-scoped` and forces persistent intern storage while active.
(defstruct CompilerLowerArenaState
  (scratch-arena (Array i64))
  (ir-arena (Array i64)))

(define lower-scratch-arena : i64
  0)

(define (lower-scratch-arena-get) : i64
  (if (= lower-scratch-arena 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! lower-scratch-arena scratch)
        scratch))
    lower-scratch-arena))

(define (lower-scratch-arena-release!) : unit
  (if (= lower-scratch-arena 0)
    unit
    (begin
      (unsafe
        (arena.tl_arena_destroy lower-scratch-arena))
      (set! lower-scratch-arena 0))))

(define (lower-scratch-arena-release-after-overflow!
  [scratch : i64]
  [scratch-head : i64]) : unit
  ;; Region reset retains overflow mappings to preserve the public stale-address
  ;; semantics. A lowered function has already cloned every live result into the
  ;; IR/enclosing arenas, so recycle an overflowed internal scratch arena here
  ;; instead of accumulating one 64 MiB mapping per large function.
  (if (= scratch scratch-head)
    unit
    (lower-scratch-arena-release!)))

;; Dedicated arena for the escaped (lowered) IR function bodies. The
;; lowered IR is consumed exactly once: at opt levels >= 1 the optimizer
;; deep-clones every surviving function into the enclosing arena
;; (optimize-function-escaping), after which the entire input IR is dead --
;; ~172MB on a cli.tl self-compile that the program-lifetime arena would
;; never reclaim. Cloning the lowered functions into this arena instead lets
;; the driver destroy it right after optimization. At opt level 0 the
;; program flows to the backend unchanged, so the arena must stay alive for
;; the whole compile (the driver only releases it for levels >= 1; batch
;; compiles release it between entries). Globals, externs, and the spans
;; side-table are NOT allocated here -- they outlive optimization.
(define lower-ir-arena : i64
  0)

(define (lower-ir-arena-get) : i64
  (if (= lower-ir-arena 0)
    (let
      [arena : i64 (arena.tl_arena_make)]
      (begin
        (set! lower-ir-arena arena)
        arena))
    lower-ir-arena))

(define (lower-ir-arena-release!) : unit
  (if (= lower-ir-arena 0)
    unit
    (begin
      (unsafe
        (arena.tl_arena_destroy lower-ir-arena))
      (set! lower-ir-arena 0))))

(define (lower-arenas-release!) : unit
  (begin
    (lower-scratch-arena-release!)
    (lower-ir-arena-release!)))

(define (compiler-lower-arena-state-new) : CompilerLowerArenaState
  (let
    [scratch : (Array i64) (make-array i64 1)]
    [ir : (Array i64) (make-array i64 1)]
    (begin
      (array-set! scratch 0 0)
      (array-set! ir 0 0)
      (CompilerLowerArenaState scratch ir))))

(define (compiler-lower-arena-state-scratch-arena
  [state : CompilerLowerArenaState]) : i64
  (array-ref (struct-get state scratch-arena) 0))

(define (compiler-lower-arena-state-ir-arena [state : CompilerLowerArenaState]) : i64
  (array-ref (struct-get state ir-arena) 0))

(define (compiler-lower-arena-state-set!
  [state : CompilerLowerArenaState]
  [scratch : i64]
  [ir : i64]) : unit
  (begin
    (array-set! (struct-get state scratch-arena) 0 scratch)
    (array-set! (struct-get state ir-arena) 0 ir)))

(define (compiler-lower-arena-state-capture-from-globals!
  [state : CompilerLowerArenaState]) : unit
  (compiler-lower-arena-state-set! state lower-scratch-arena lower-ir-arena))

(define (compiler-lower-arena-state-install! [state : CompilerLowerArenaState]) : unit
  (begin
    (set! lower-scratch-arena (compiler-lower-arena-state-scratch-arena state))
    (set! lower-ir-arena (compiler-lower-arena-state-ir-arena state))))

(define (lower-function-list-escape-to-ir-arena
  [functions : CompilerIrFunctionList]) : CompilerIrFunctionList
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    (begin
      (unsafe
        (arena.tl_arena_set (lower-ir-arena-get)))
      (let
        [escaped : CompilerIrFunctionList
          (compiler-ir-clone-function-list functions)]
        (begin
          (set! lower-ir-arena (arena.tl_arena_current))
          (unsafe
            (arena.tl_arena_set enclosing))
          escaped)))))

(define (lower-function-escaping
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (lower-scratch-arena-get)]
    (begin
      ;; Type-name/owner caches may contain keys allocated by earlier
      ;; typecheck or lower scratch scopes. Keep them scoped to this lowering
      ;; pass and invalidate them before rewinding this function's scratch arena.
      (tc-nominal-owner-cache-reset!)
      ;; Compile-time: new generation for the result-type-fast memo, so
      ;; this function's cached node types are independent of every other
      ;; function's (and never outlive this function's scratch arena).
      (tc-rtf-next-gen!)
      ;; Same generation discipline for the per-match variant arm
      ;; resolution memo.
      (lower-variant-arm-memo-next-gen!)
      ;; The scalar context and recursive-helper stack carry scratch-owned
      ;; values while lowering one function. Never let those scoped values
      ;; cross the per-function arena rewind into the next top-level function.
      (set! lower-spmd-scalar-call-context (LowerSpmdScalarCallContext.No))
      (set!
        lower-spmd-inline-helper-stack
        (lower-spmd-inline-empty-helper-stack))
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        (match (lower-function
          ctx
          top-env
          type-cache
          logical-name
          params
          ret
          body
          spans
          names
          mode)
          [(ResultLowerFunction.Ok fns _function-spans)
            (let
              [scratch-head : i64 (arena.tl_arena_current)]
              [escaped-fns : CompilerIrFunctionList
                (lower-function-list-escape-to-ir-arena fns)]
              ;; The IR function clones go to the dedicated lowered-IR
              ;; arena (released by the driver after optimization); the
              ;; spans side-table is rebuilt in the enclosing arena since
              ;; it outlives the lowered IR. The stored handle must follow
              ;; the arena's grown head, or every later allocation re-walks
              ;; the overflow path from the full first segment.
              (begin
                (unsafe
                  (arena.tl_arena_set enclosing))
                (set!
                  lower-spmd-inline-helper-stack
                  (lower-spmd-inline-empty-helper-stack))
                (let
                  [escaped-spans : CompilerSourceSpans
                    (lower-record-function-span
                      spans
                      (compiler-ir-symbol-text logical-name)
                      body)]
                  [new-enclosing : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set new-enclosing))
                    (lower-scratch-arena-release-after-overflow!
                      scratch
                      scratch-head)
                    (tc-nominal-owner-cache-reset!)
                    (ResultLowerFunction.Ok escaped-fns escaped-spans)))))]
          [(ResultLowerFunction.Err message)
            (let
              [scratch-head : i64 (arena.tl_arena_current)]
              (begin
                (unsafe
                  (arena.tl_arena_set enclosing))
                (set!
                  lower-spmd-inline-helper-stack
                  (lower-spmd-inline-empty-helper-stack))
                (let
                  [escaped-message : (Box CompilerDiagnostic) (clone message)]
                  [new-enclosing : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set new-enclosing))
                    (lower-scratch-arena-release-after-overflow!
                      scratch
                      scratch-head)
                    (tc-nominal-owner-cache-reset!)
                    (ResultLowerFunction.Err escaped-message)))))])))))

(define lower-struct-cleanup-param-id-cache : i64
  -1)
(define lower-struct-cleanup-param-id-cache-generation : i64
  -1)

(define (lower-struct-cleanup-param-id) : i64
  (if (= lower-struct-cleanup-param-id-cache-generation (ci.intern-generation))
    lower-struct-cleanup-param-id-cache
    (let
      [id : i64 (ci.intern-generated-name "__tl_cleanup_value")]
      (begin
        (set! lower-struct-cleanup-param-id-cache id)
        (set!
          lower-struct-cleanup-param-id-cache-generation
          (ci.intern-generation))
        id))))

(define (lower-struct-cleanup-qualified-id
  [ctx : TcContext]
  [struct-id : i64]
  [cleanup-id : i64]) : i64
  (if (or (tc-name-qualified-id? cleanup-id) (>= cleanup-id (intern-capacity)))
    cleanup-id
    (let
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [handle : i64
        (compiler-symbols-lookup-type-id-or
          symbols
          struct-id
          (compiler-symbols-missing-handle))]
      [module-id : i64
        (if (compiler-symbols-handle-found? handle)
          (compiler-symbols-owner-module-id-at-index-or
            symbols
            (compiler-symbol-handle-index handle)
            cbi.compiler-builtin-id-fix-empty)
          cbi.compiler-builtin-id-fix-empty)]
      (if (or (< module-id 0) (= module-id cbi.compiler-builtin-id-fix-empty))
        cleanup-id
        (ci.intern-generated-canonical-qualified-name
          (compiler-symbol-module-key
            (intern-str module-id)
            (tc-env-key-name-text cleanup-id))
          module-id
          cleanup-id)))))

(define (lower-struct-cleanup-id-for-struct [ctx : TcContext] [struct-id : i64]) : ResultTcNameId
  (match (tc-struct-decl-id ctx struct-id)
    [(ResultTcStructDecl.Ok decl)
      (match decl
        [(TcStructDecl _ cleanup _)
          (match cleanup
            [(AstStructCleanup.Fn cleanup-name)
              (ResultTcNameId.Ok
                (lower-struct-cleanup-qualified-id ctx struct-id cleanup-name))]
            [(AstStructCleanup.No)
              (ResultTcNameId.Err
                (string.append
                  "lower: owned cleanup field type has no cleanup function "
                  (tc-nominal-name-id-display struct-id)))])])]
    [(ResultTcStructDecl.Err message) (ResultTcNameId.Err message)]))

(define (lower-enum-cleanup-id-for-enum [ctx : TcContext] [enum-id : i64]) : ResultTcNameId
  (match (tc-enum-decl-id ctx enum-id)
    [(ResultTcEnumDecl.Ok decl)
      (match decl
        [(TcEnumDecl cleanup _)
          (match cleanup
            [(AstEnumCleanup.Fn cleanup-name)
              (ResultTcNameId.Ok
                (lower-struct-cleanup-qualified-id ctx enum-id cleanup-name))]
            [(AstEnumCleanup.No)
              (ResultTcNameId.Err
                (string.append
                  "lower: owned cleanup payload type has no cleanup function "
                  (tc-nominal-name-id-display enum-id)))])])]
    [(ResultTcEnumDecl.Err message) (ResultTcNameId.Err message)]))

(define (lower-struct-cleanup-id-for-type [ctx : TcContext] [ty : AstType]) : ResultTcNameId
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Struct name) (lower-struct-cleanup-id-for-struct ctx name)]
      [(AstType.StructArgs name _)
        (lower-struct-cleanup-id-for-struct ctx name)]
      [(AstType.Enum name) (lower-enum-cleanup-id-for-enum ctx name)]
      [(AstType.EnumArgs name _) (lower-enum-cleanup-id-for-enum ctx name)]
      [_
        (ResultTcNameId.Err
          (string.append
            "lower: owned cleanup field type is not a cleanup-owning aggregate "
            (tc-type-render resolved)))])))

(define (lower-struct-cleanup-call-expr
  [cleanup-name-id : i64]
  [value-name-id : i64]
  [field-name-id : i64]) : i64
  (ast-expr-call
    (ast-node-push (AstExpr.Var cleanup-name-id))
    (ast-expr-cons
      (ast-expr-struct-get-id
        (ast-node-push (AstExpr.Var value-name-id))
        field-name-id)
      (ast-expr-list-new))))

(define (lower-struct-cleanup-field-exprs
  [ctx : TcContext]
  [value-name-id : i64]
  [field : AstFieldDef]
  [acc : AstExprList]) : ResultAstExprList
  (match field
    [(AstFieldDef.Def field-name ty cleanup)
      (match cleanup
        [(AstFieldCleanup.No) (ResultAstExprList.Ok acc)]
        [(AstFieldCleanup.Fn cleanup-name)
          (ResultAstExprList.Ok
            (ast-expr-cons
              (lower-struct-cleanup-call-expr
                cleanup-name
                value-name-id
                field-name)
              acc))]
        [(AstFieldCleanup.Owned)
          (match (lower-struct-cleanup-id-for-type ctx ty)
            [(ResultTcNameId.Ok cleanup-name-id)
              (ResultAstExprList.Ok
                (ast-expr-cons
                  (lower-struct-cleanup-call-expr
                    cleanup-name-id
                    value-name-id
                    field-name)
                  acc))]
            [(ResultTcNameId.Err message) (ResultAstExprList.Err message)])])]))

(define (lower-struct-cleanup-body-fields
  [ctx : TcContext]
  [value-name-id : i64]
  [fields : AstFieldDefList]
  [acc : AstExprList]) : ResultAstExprList
  (lower-struct-cleanup-body-fields-at ctx value-name-id (& fields) acc 0))

(define (lower-struct-cleanup-body-fields-at
  [ctx : TcContext]
  [value-name-id : i64]
  [fields : (& fields AstFieldDefList)]
  [acc : AstExprList]
  [index : i64]) : ResultAstExprList
  (if (>= index (struct-get fields len))
    (ResultAstExprList.Ok acc)
    (match (lower-struct-cleanup-field-exprs
      ctx
      value-name-id
      (ast-field-def-list-get fields index (ast-field-def-fallback))
      acc)
      [(ResultAstExprList.Ok next)
        (lower-struct-cleanup-body-fields-at
          ctx
          value-name-id
          fields
          next
          (+ index 1))]
      [(ResultAstExprList.Err message) (ResultAstExprList.Err message)])))

(define (lower-struct-cleanup-function
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [struct-ty : AstType]
  [fields : AstFieldDefList]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [value-name-id : i64 (lower-struct-cleanup-param-id)]
    (match (lower-struct-cleanup-body-fields
      ctx
      value-name-id
      fields
      (ast-expr-list-new))
      [(ResultAstExprList.Ok exprs)
        (let
          [params : AstParamList
            (ast-param-cons
              (ast-param-id value-name-id struct-ty false)
              (ast-param-list-new))]
          [body : AstExpr
            (if (= (struct-get (& exprs) len) 0)
              (AstExpr.Literal AstLiteral.Unit)
              (AstExpr.Begin exprs))]
          (lower-function-escaping
            ctx
            top-env
            type-cache
            logical-name
            params
            (AstType.Unit)
            body
            spans
            names
            mode))]
      [(ResultAstExprList.Err message)
        (ResultLowerFunction.Err (box (lower-diagnostic message)))])))

(define (lower-struct-cleanup-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [cleanup : AstStructCleanup]
  [struct-ty : AstType]
  [fields : AstFieldDefList]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match cleanup
    [(AstStructCleanup.No)
      (ResultLowerFunction.Ok CompilerIrFunctionList.Nil spans)]
    [(AstStructCleanup.Fn _)
      (lower-struct-cleanup-function
        ctx
        top-env
        type-cache
        logical-name
        struct-ty
        fields
        spans
        names
        mode)]))

(define (lower-enum-cleanup-payload-id [index : i64]) : i64
  (ci.intern-generated-canonical-name
    (string.append "__tl_cleanup_payload_" (string.int->string index))))

(define (lower-enum-cleanup-call-expr
  [cleanup-name-id : i64]
  [value-name-id : i64]) : i64
  (ast-expr-call
    (ast-node-push (AstExpr.Var cleanup-name-id))
    (ast-expr-cons
      (ast-node-push (AstExpr.Var value-name-id))
      (ast-expr-list-new))))

(define (lower-enum-cleanup-payload-patterns [count : i64]) : AstPatternList
  (lower-enum-cleanup-payload-patterns-at
    count
    0
    (ast-pattern-list-with-capacity count)))

(define (lower-enum-cleanup-payload-patterns-at
  [count : i64]
  [index : i64]
  [out : AstPatternList]) : AstPatternList
  (if (>= index count)
    out
    (let
      [next : AstPatternList out]
      (begin
        (ast-pattern-list-push
          (&mut next)
          (ast-pat-binding-id (lower-enum-cleanup-payload-id index)))
        (lower-enum-cleanup-payload-patterns-at count (+ index 1) next)))))

(define (lower-enum-cleanup-payload-exprs
  [ctx : TcContext]
  [payloads : AstTypeList]
  [cleanups : AstVariantPayloadCleanupList]) : ResultAstExprList
  (lower-enum-cleanup-payload-exprs-at
    ctx
    (& payloads)
    (& cleanups)
    0
    (ast-expr-list-new)))

(define (lower-enum-cleanup-payload-exprs-at
  [ctx : TcContext]
  [payloads : (& payloads AstTypeList)]
  [cleanups : (& cleanups AstVariantPayloadCleanupList)]
  [index : i64]
  [acc : AstExprList]) : ResultAstExprList
  (if (>= index (ast-type-list-len payloads))
    (ResultAstExprList.Ok acc)
    (let
      [cleanup : AstVariantPayloadCleanup
        (ast-variant-payload-cleanup-list-get
          cleanups
          index
          (ast-variant-payload-cleanup-fallback))]
      [value-name-id : i64 (lower-enum-cleanup-payload-id index)]
      (match cleanup
        [(AstVariantPayloadCleanup.No)
          (lower-enum-cleanup-payload-exprs-at
            ctx
            payloads
            cleanups
            (+ index 1)
            acc)]
        [(AstVariantPayloadCleanup.Fn cleanup-name)
          (lower-enum-cleanup-payload-exprs-at
            ctx
            payloads
            cleanups
            (+ index 1)
            (ast-expr-cons
              (lower-enum-cleanup-call-expr cleanup-name value-name-id)
              acc))]
        [(AstVariantPayloadCleanup.Owned)
          (match (lower-struct-cleanup-id-for-type
            ctx
            (tc-context-type-get
              ctx
              (ast-type-list-get payloads index (ast-type-id-fallback))))
            [(ResultTcNameId.Ok cleanup-name-id)
              (lower-enum-cleanup-payload-exprs-at
                ctx
                payloads
                cleanups
                (+ index 1)
                (ast-expr-cons
                  (lower-enum-cleanup-call-expr cleanup-name-id value-name-id)
                  acc))]
            [(ResultTcNameId.Err message) (ResultAstExprList.Err message)])]))))

(define (lower-enum-cleanup-arm [ctx : TcContext] [variant : AstVariantDef]) : ResultAstMatchArm
  (match variant
    [(AstVariantDef.Def name payloads cleanups)
      (match (lower-enum-cleanup-payload-exprs ctx payloads cleanups)
        [(ResultAstExprList.Ok exprs)
          (ResultAstMatchArm.Ok
            (ast-match-arm
              (ast-pat-variant-id
                name
                (lower-enum-cleanup-payload-patterns
                  (ast-type-list-len (& payloads))))
              (ast-node-push
                (if (= (ast-expr-list-len exprs) 0)
                  (AstExpr.Literal AstLiteral.Unit)
                  (AstExpr.Begin exprs)))))]
        [(ResultAstExprList.Err message) (ResultAstMatchArm.Err message)])]))

(define (lower-enum-cleanup-arms
  [ctx : TcContext]
  [variants : AstVariantDefList]) : ResultAstMatchArmList
  (lower-enum-cleanup-arms-at
    ctx
    (& variants)
    0
    (ast-match-arm-list-with-capacity (ast-variant-def-list-len (& variants)))))

(define (lower-enum-cleanup-arms-at
  [ctx : TcContext]
  [variants : (& variants AstVariantDefList)]
  [index : i64]
  [out : AstMatchArmList]) : ResultAstMatchArmList
  (if (>= index (ast-variant-def-list-len variants))
    (ResultAstMatchArmList.Ok out)
    (match (lower-enum-cleanup-arm
      ctx
      (ast-variant-def-list-get variants index (ast-variant-def-fallback)))
      [(ResultAstMatchArm.Ok arm)
        (let
          [next : AstMatchArmList out]
          (begin
            (ast-match-arm-list-push (&mut next) arm)
            (lower-enum-cleanup-arms-at ctx variants (+ index 1) next)))]
      [(ResultAstMatchArm.Err message) (ResultAstMatchArmList.Err message)])))

(define (lower-enum-cleanup-function
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [enum-ty : AstType]
  [variants : AstVariantDefList]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [value-name-id : i64 (lower-struct-cleanup-param-id)]
    (match (lower-enum-cleanup-arms ctx variants)
      [(ResultAstMatchArmList.Ok arms)
        (lower-function-escaping
          ctx
          top-env
          type-cache
          logical-name
          (ast-param-cons
            (ast-param-id value-name-id enum-ty false)
            (ast-param-list-new))
          (AstType.Unit)
          (ast-node-get
            (ast-expr-match (ast-node-push (AstExpr.Var value-name-id)) arms))
          spans
          names
          mode)]
      [(ResultAstMatchArmList.Err message)
        (ResultLowerFunction.Err (box (lower-diagnostic message)))])))

(define (lower-enum-cleanup-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]
  [variants : AstVariantDefList]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match cleanup
    [(AstEnumCleanup.No)
      (ResultLowerFunction.Ok CompilerIrFunctionList.Nil spans)]
    [(AstEnumCleanup.Fn _)
      (lower-enum-cleanup-function
        ctx
        top-env
        type-cache
        logical-name
        enum-ty
        variants
        spans
        names
        mode)]))

(define (lower-dispatch-cache-name [logical-name : String]) : String
  (string.append "__tl_dispatch_cache_" logical-name))

(define (lower-dispatch-variant-prefix [isa : AstDispatchIsa]) : String
  (match isa
    [(AstDispatchIsa.Scalar) "__tl_dispatch_variant_scalar_"]
    [(AstDispatchIsa.Avx2) "__tl_dispatch_variant_avx2_"]
    [(AstDispatchIsa.Avx512) "__tl_dispatch_variant_avx512_"]))

(define (lower-dispatch-variant-internal-name
  [dispatch-name : String]
  [isa : AstDispatchIsa]
  [variant-name : String]) : String
  (string.append
    (lower-dispatch-variant-prefix isa)
    (string.append dispatch-name (string.append "__" variant-name))))

(define (lower-dispatch-lower-mode
  [isa : AstDispatchIsa]
  [mode : CompilerLowerMode]) : CompilerLowerMode
  (match isa
    [(AstDispatchIsa.Scalar)
      (if (lower-mode-windows-c-abi? mode)
        (CompilerLowerMode.WindowsScalar)
        (if (lower-mode-linux-c-abi? mode)
          (CompilerLowerMode.LinuxScalar)
          (CompilerLowerMode.Scalar)))]
    [(AstDispatchIsa.Avx2)
      (if (lower-mode-windows-c-abi? mode)
        (CompilerLowerMode.WindowsAvx2)
        (if (lower-mode-linux-c-abi? mode)
          (CompilerLowerMode.LinuxAvx2)
          (CompilerLowerMode.Avx2)))]
    [(AstDispatchIsa.Avx512)
      (if (lower-mode-windows-c-abi? mode)
        (CompilerLowerMode.WindowsAvx512)
        (if (lower-mode-linux-c-abi? mode)
          (CompilerLowerMode.LinuxAvx512)
          (CompilerLowerMode.Avx512)))]))

(define (lower-dispatch-type-list-without-regions
  [ctx : TcContext]
  [types : AstTypeList]) : AstTypeList
  (lower-dispatch-type-list-without-regions-at ctx (& types) 0))

(define (lower-dispatch-type-list-without-regions-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (tc-type-without-regions
        (ast-type-strip-consuming-param
          (tc-context-type-get
            ctx
            (ast-type-list-get types index (ast-type-id-fallback)))))
      (lower-dispatch-type-list-without-regions-at ctx types (+ index 1)))))

(define (lower-dispatch-param-type-count [types : AstTypeList]) : i64
  (ast-type-list-len (& types)))

(define (lower-dispatch-param-list-from-types
  [ctx : TcContext]
  [types : AstTypeList]
  [idx : i64]) : CompilerIrParamList
  (lower-dispatch-param-list-from-types-at ctx (& types) idx))

(define (lower-dispatch-param-list-from-types-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [idx : i64]) : CompilerIrParamList
  (if (>= idx (ast-type-list-len types))
    CompilerIrParamList.Nil
    (compiler-ir-param-cons
      (CompilerIrParam.Param
        (string.append "arg" (string.int->string idx))
        (tc-type-without-regions
          (tc-context-type-get
            ctx
            (ast-type-list-get types idx (ast-type-id-fallback))))
        idx)
      (lower-dispatch-param-list-from-types-at ctx types (+ idx 1)))))

(define (lower-dispatch-param-values [types : AstTypeList] [idx : i64]) : CompilerIrValueList
  (if (>= idx (ast-type-list-len (& types)))
    CompilerIrValueList.Nil
    (compiler-ir-value-cons
      (CompilerIrValue.Var idx)
      (lower-dispatch-param-values types (+ idx 1)))))

(define (lower-dispatch-find-internal-name-from
  [variants : (& variants AstDispatchVariantList)]
  [index : i64]
  [module-id : i64]
  [names : LowerNameCache]
  [dispatch-name : String]
  [wanted : AstDispatchIsa]) : LowerMaybeIrSymbol
  (if (>= index (struct-get variants len))
    (LowerMaybeIrSymbol.No)
    (match (ast-dispatch-variant-list-get
      variants
      index
      (ast-dispatch-variant-fallback))
      [(AstDispatchVariant.Variant isa variant-name)
        (if (tc-dispatch-isa-eq? isa wanted)
          (LowerMaybeIrSymbol.Some
            (lower-derived-symbol-id
              (lower-dispatch-variant-internal-name
                dispatch-name
                isa
                (lower-dispatch-variant-logical-name
                  module-id
                  names
                  variant-name))))
          (lower-dispatch-find-internal-name-from
            variants
            (+ index 1)
            module-id
            names
            dispatch-name
            wanted))])))

(define (lower-dispatch-find-internal-name
  [variants : AstDispatchVariantList]
  [module-id : i64]
  [names : LowerNameCache]
  [dispatch-name : String]
  [wanted : AstDispatchIsa]) : LowerMaybeIrSymbol
  (lower-dispatch-find-internal-name-from
    (& variants)
    0
    module-id
    names
    dispatch-name
    wanted))

(define (lower-dispatch-call-return-instr [call-var : i64] [ret-ty : AstType]) : CompilerIrInstr
  (CompilerIrInstr.Return
    (lower-return-maybe (CompilerIrValue.Var call-var) ret-ty)))

(define (lower-dispatch-cached-block
  [cache-name : i64]
  [args : CompilerIrCallArgs]
  [ret-ty : AstType]
  [call-var : i64]) : CompilerIrBlock
  (compiler-ir-block
    "cached"
    (compiler-ir-instr-cons
      (CompilerIrInstr.CallIndirect
        call-var
        (CompilerIrValue.Global cache-name)
        args
        ret-ty)
      (compiler-ir-instr-cons
        (lower-dispatch-call-return-instr call-var ret-ty)
        CompilerIrInstrList.Nil))))

(define (lower-dispatch-select-block
  [label : String]
  [cache-name : i64]
  [fn-name : i64]
  [fn-ty : AstType]
  [args : CompilerIrCallArgs]
  [ret-ty : AstType]
  [call-var : i64]) : CompilerIrBlock
  (compiler-ir-block
    label
    (compiler-ir-instr-cons
      (CompilerIrInstr.Store
        cache-name
        (CompilerIrValue.Function fn-name)
        fn-ty)
      (compiler-ir-instr-cons
        (CompilerIrInstr.CallIndirect
          call-var
          (CompilerIrValue.Function fn-name)
          args
          ret-ty)
        (compiler-ir-instr-cons
          (lower-dispatch-call-return-instr call-var ret-ty)
          CompilerIrInstrList.Nil)))))

(define (lower-dispatch-entry-block
  [cache-name : i64]
  [_fn-ty : AstType]
  [cached-var : i64]
  [resolve-label : String]) : CompilerIrBlock
  (compiler-ir-block
    "entry"
    (compiler-ir-instr-cons
      (CompilerIrInstr.BinOp
        cached-var
        CompilerIrBinOp.Ne
        (CompilerIrValue.Global cache-name)
        (CompilerIrValue.I64 0)
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Branch
          (CompilerIrValue.Var cached-var)
          "cached"
          resolve-label)
        CompilerIrInstrList.Nil))))

(define lower-dispatch-avx512-required-feature-mask : i64
  ;; CPUID.7.0:EBX AVX512F bit 16, AVX512DQ bit 17, AVX512BW bit 30.
  1073938432)

(define (lower-dispatch-feature-blocks
  [prefix : String]
  [xcr0-mask : i64]
  [feature-mask : i64]
  [select-label : String]
  [fallback-label : String]
  [base : i64]
  [tail : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [check-label : String (clone prefix)]
    [osxsave-label : String (string.append (clone prefix) "_osxsave")]
    [xcr0-label : String (string.append (clone prefix) "_xcr0")]
    [leaf7-label : String (string.append prefix "_leaf7")]
    [max-leaf-var : i64 base]
    [max-ok-var : i64 (+ base 1)]
    [leaf1-ecx-var : i64 (+ base 2)]
    [osxsave-mask-var : i64 (+ base 3)]
    [osxsave-ok-var : i64 (+ base 4)]
    [xcr0-var : i64 (+ base 5)]
    [xcr0-mask-var : i64 (+ base 6)]
    [xcr0-ok-var : i64 (+ base 7)]
    [leaf7-ebx-var : i64 (+ base 8)]
    [feature-mask-var : i64 (+ base 9)]
    [feature-ok-var : i64 (+ base 10)]
    [blocks : CompilerIrBlockBuilder
      (compiler-ir-block-builder-with-capacity
        (+ 4 (compiler-ir-block-list-count tail)))]
    (begin
      (compiler-ir-block-builder-push!
        (&mut blocks)
        (compiler-ir-block
          check-label
          (compiler-ir-instr-cons
            (CompilerIrInstr.CpuId
              max-leaf-var
              (CompilerIrValue.I64 0)
              (CompilerIrValue.I64 0)
              0)
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                max-ok-var
                CompilerIrBinOp.Ge
                (CompilerIrValue.Var max-leaf-var)
                (CompilerIrValue.I64 7)
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.Branch
                  (CompilerIrValue.Var max-ok-var)
                  osxsave-label
                  fallback-label)
                CompilerIrInstrList.Nil)))))
      (compiler-ir-block-builder-push!
        (&mut blocks)
        (compiler-ir-block
          osxsave-label
          (compiler-ir-instr-cons
            (CompilerIrInstr.CpuId
              leaf1-ecx-var
              (CompilerIrValue.I64 1)
              (CompilerIrValue.I64 0)
              2)
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                osxsave-mask-var
                CompilerIrBinOp.BitAnd
                (CompilerIrValue.Var leaf1-ecx-var)
                (CompilerIrValue.I64 134217728)
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.BinOp
                  osxsave-ok-var
                  CompilerIrBinOp.Ne
                  (CompilerIrValue.Var osxsave-mask-var)
                  (CompilerIrValue.I64 0)
                  (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Branch
                    (CompilerIrValue.Var osxsave-ok-var)
                    xcr0-label
                    fallback-label)
                  CompilerIrInstrList.Nil))))))
      (compiler-ir-block-builder-push!
        (&mut blocks)
        (compiler-ir-block
          xcr0-label
          (compiler-ir-instr-cons
            (CompilerIrInstr.Xgetbv xcr0-var (CompilerIrValue.I64 0))
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                xcr0-mask-var
                CompilerIrBinOp.BitAnd
                (CompilerIrValue.Var xcr0-var)
                (CompilerIrValue.I64 xcr0-mask)
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.BinOp
                  xcr0-ok-var
                  CompilerIrBinOp.Eq
                  (CompilerIrValue.Var xcr0-mask-var)
                  (CompilerIrValue.I64 xcr0-mask)
                  (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Branch
                    (CompilerIrValue.Var xcr0-ok-var)
                    leaf7-label
                    fallback-label)
                  CompilerIrInstrList.Nil))))))
      (compiler-ir-block-builder-push!
        (&mut blocks)
        (compiler-ir-block
          leaf7-label
          (compiler-ir-instr-cons
            (CompilerIrInstr.CpuId
              leaf7-ebx-var
              (CompilerIrValue.I64 7)
              (CompilerIrValue.I64 0)
              1)
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                feature-mask-var
                CompilerIrBinOp.BitAnd
                (CompilerIrValue.Var leaf7-ebx-var)
                (CompilerIrValue.I64 feature-mask)
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.BinOp
                  feature-ok-var
                  CompilerIrBinOp.Eq
                  (CompilerIrValue.Var feature-mask-var)
                  (CompilerIrValue.I64 feature-mask)
                  (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Branch
                    (CompilerIrValue.Var feature-ok-var)
                    select-label
                    fallback-label)
                  CompilerIrInstrList.Nil))))))
      (compiler-ir-block-builder-append-list! (&mut blocks) tail)
      (compiler-ir-block-builder-to-list blocks))))

(define (lower-dispatch-select-blocks
  [cache-name : i64]
  [fn-ty : AstType]
  [args : CompilerIrCallArgs]
  [ret-ty : AstType]
  [scalar-name : i64]
  [maybe-avx2 : LowerMaybeIrSymbol]
  [maybe-avx512 : LowerMaybeIrSymbol]
  [base : i64]) : CompilerIrBlockList
  (let
    [blocks : CompilerIrBlockBuilder
      (compiler-ir-block-builder-with-capacity 3)]
    (begin
      (match maybe-avx512
        [(LowerMaybeIrSymbol.Some avx512-name)
          (compiler-ir-block-builder-push!
            (&mut blocks)
            (lower-dispatch-select-block
              "select_avx512"
              cache-name
              avx512-name
              fn-ty
              args
              ret-ty
              (+ base 26)))]
        [(LowerMaybeIrSymbol.No) unit])
      (match maybe-avx2
        [(LowerMaybeIrSymbol.Some avx2-name)
          (compiler-ir-block-builder-push!
            (&mut blocks)
            (lower-dispatch-select-block
              "select_avx2"
              cache-name
              avx2-name
              fn-ty
              args
              ret-ty
              (+ base 25)))]
        [(LowerMaybeIrSymbol.No) unit])
      (compiler-ir-block-builder-push!
        (&mut blocks)
        (lower-dispatch-select-block
          "select_scalar"
          cache-name
          scalar-name
          fn-ty
          args
          ret-ty
          (+ base 24)))
      (compiler-ir-block-builder-to-list blocks))))

(define (lower-dispatch-resolve-label
  [maybe-avx2 : LowerMaybeIrSymbol]
  [maybe-avx512 : LowerMaybeIrSymbol]) : String
  (match maybe-avx512
    [(LowerMaybeIrSymbol.Some _) "check_avx512"]
    [(LowerMaybeIrSymbol.No)
      (match maybe-avx2
        [(LowerMaybeIrSymbol.Some _) "check_avx2"]
        [(LowerMaybeIrSymbol.No) "select_scalar"])]))

(define (lower-dispatch-resolve-blocks
  [maybe-avx2 : LowerMaybeIrSymbol]
  [maybe-avx512 : LowerMaybeIrSymbol]
  [base : i64]
  [tail : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [with-avx2 : CompilerIrBlockList
      (match maybe-avx2
        [(LowerMaybeIrSymbol.Some _)
          (lower-dispatch-feature-blocks
            "check_avx2"
            6
            32
            "select_avx2"
            "select_scalar"
            (+ base 12)
            tail)]
        [(LowerMaybeIrSymbol.No) tail])]
    (match maybe-avx512
      [(LowerMaybeIrSymbol.Some _)
        (lower-dispatch-feature-blocks
          "check_avx512"
          230
          lower-dispatch-avx512-required-feature-mask
          "select_avx512"
          (match maybe-avx2
            [(LowerMaybeIrSymbol.Some _) "check_avx2"]
            [(LowerMaybeIrSymbol.No) "select_scalar"])
          (+ base 1)
          with-avx2)]
      [(LowerMaybeIrSymbol.No) with-avx2])))

(define (lower-dispatch-thunk-function
  [ctx : TcContext]
  [logical-name : i64]
  [cache-name : i64]
  [fn-ty : AstType]
  [variants : AstDispatchVariantList]
  [module-id : i64]
  [names : LowerNameCache]
  [spans : CompilerSourceSpans]) : ResultLowerFunction
  (match fn-ty
    [(AstType.Func param-types ret-box)
      (let
        [logical-name-text : String (compiler-ir-symbol-text logical-name)]
        [ret-ty : AstType
          (tc-type-without-regions (tc-context-type-get ctx ret-box))]
        [clean-param-types : AstTypeList
          (lower-dispatch-type-list-without-regions ctx (box-get param-types))]
        [param-count : i64 (lower-dispatch-param-type-count clean-param-types)]
        [args : CompilerIrCallArgs
          (compiler-ir-call-args-from-list
            (lower-dispatch-param-values clean-param-types 0))]
        [maybe-avx2 : LowerMaybeIrSymbol
          (lower-dispatch-find-internal-name
            variants
            module-id
            names
            logical-name-text
            (AstDispatchIsa.Avx2))]
        [maybe-avx512 : LowerMaybeIrSymbol
          (lower-dispatch-find-internal-name
            variants
            module-id
            names
            logical-name-text
            (AstDispatchIsa.Avx512))]
        (match (lower-dispatch-find-internal-name
          variants
          module-id
          names
          logical-name-text
          (AstDispatchIsa.Scalar))
          [(LowerMaybeIrSymbol.Some scalar-name)
            (let
              [tail-blocks : CompilerIrBlockList
                (lower-dispatch-resolve-blocks
                  maybe-avx2
                  maybe-avx512
                  param-count
                  (lower-dispatch-select-blocks
                    cache-name
                    fn-ty
                    args
                    ret-ty
                    scalar-name
                    maybe-avx2
                    maybe-avx512
                    param-count))]
              [blocks : CompilerIrBlockBuilder
                (compiler-ir-block-builder-with-capacity
                  (+ 2 (compiler-ir-block-list-count tail-blocks)))]
              (begin
                (compiler-ir-block-builder-push!
                  (&mut blocks)
                  (lower-dispatch-entry-block
                    cache-name
                    fn-ty
                    param-count
                    (lower-dispatch-resolve-label maybe-avx2 maybe-avx512)))
                (compiler-ir-block-builder-push!
                  (&mut blocks)
                  (lower-dispatch-cached-block
                    cache-name
                    args
                    ret-ty
                    (+ param-count 23)))
                (compiler-ir-block-builder-append-list!
                  (&mut blocks)
                  tail-blocks)
                (ResultLowerFunction.Ok
                  (compiler-ir-function-list-single
                    (CompilerIrFunction.Function
                      logical-name
                      (lower-dispatch-param-list-from-types
                        ctx
                        clean-param-types
                        0)
                      ret-ty
                      (+ param-count 27)
                      (compiler-ir-block-builder-to-list blocks)))
                  spans)))]
          [(LowerMaybeIrSymbol.No)
            (ResultLowerFunction.Err
              (box
                (lower-diagnostic
                  "lower: defdispatch requires a scalar variant")))]))]
    [_
      (ResultLowerFunction.Err
        (box
          (lower-diagnostic
            "lower: defdispatch did not typecheck as a function")))]))

(define (lower-dispatch-lower-variant-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [internal-name : i64]
  [isa : AstDispatchIsa]
  [decl : AstDecl]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match decl
    [(AstDecl.DefFn decl-meta _ params ret body-box _)
      (let
        [body : AstExpr (lower-context-expr-get ctx body-box)]
        (lower-function-escaping
          ctx
          top-env
          type-cache
          internal-name
          params
          ret
          body
          spans
          names
          (lower-dispatch-lower-mode isa mode)))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-dispatch-lower-variant-decl
          ctx
          top-env
          type-cache
          internal-name
          isa
          inner
          spans
          names
          mode))]
    [_
      (ResultLowerFunction.Err
        (box
          (lower-diagnostic
            "lower: defdispatch variants must be local functions")))]))

(define (lower-dispatch-lower-variant
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-name : String]
  [variant : AstDispatchVariant]
  [module-id : i64]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match variant
    [(AstDispatchVariant.Variant isa variant-name)
      (let
        [variant-logical : String
          (lower-dispatch-variant-logical-name module-id names variant-name)]
        [internal-name : i64
          (lower-derived-symbol-id
            (lower-dispatch-variant-internal-name
              dispatch-name
              isa
              variant-logical))]
        [handle : i64
          (if (tc-name-qualified-id? variant-name)
            (compiler-symbols-lookup-value-id-or
              (tc-context-symbols ctx)
              variant-name
              (compiler-symbols-missing-handle))
            (compiler-symbols-lookup-value-in-module-id-or
              (tc-context-symbols ctx)
              module-id
              variant-name
              (compiler-symbols-missing-handle)))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-program-decl-at-index
            (tc-context-program ctx)
            (compiler-symbol-handle-index handle))
            [(ResultAstDecl.Ok decl)
              (lower-dispatch-lower-variant-decl
                ctx
                top-env
                type-cache
                internal-name
                isa
                decl
                spans
                names
                mode)]
            [(ResultAstDecl.Err message)
              (ResultLowerFunction.Err (box (lower-diagnostic message)))])
          (ResultLowerFunction.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: unknown defdispatch variant "
                  (tc-env-key-name-text variant-name)))))))]))

(define (lower-dispatch-lower-variants-from
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-name : String]
  [variants : (& variants AstDispatchVariantList)]
  [index : i64]
  [module-id : i64]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]
  [functions : CompilerIrFunctionBuilder]) : ResultLowerFunction
  (if (>= index (struct-get variants len))
    (ResultLowerFunction.Ok
      (compiler-ir-function-builder-to-list functions)
      spans)
    (match (lower-dispatch-lower-variant
      ctx
      top-env
      type-cache
      dispatch-name
      (ast-dispatch-variant-list-get
        variants
        index
        (ast-dispatch-variant-fallback))
      module-id
      spans
      names
      mode)
      [(ResultLowerFunction.Ok lowered-functions function-spans)
        (let
          [next-functions : CompilerIrFunctionBuilder functions]
          (begin
            (compiler-ir-function-builder-append-list!
              (&mut next-functions)
              lowered-functions)
            (lower-dispatch-lower-variants-from
              ctx
              top-env
              type-cache
              dispatch-name
              variants
              (+ index 1)
              module-id
              function-spans
              names
              mode
              next-functions)))]
      [(ResultLowerFunction.Err message) (ResultLowerFunction.Err message)])))

(define (lower-dispatch-lower-variants
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-name : String]
  [variants : AstDispatchVariantList]
  [module-id : i64]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (lower-dispatch-lower-variants-from
    ctx
    top-env
    type-cache
    dispatch-name
    (& variants)
    0
    module-id
    spans
    names
    mode
    (compiler-ir-function-builder-new)))

(define (lower-dispatch-decl
  [ctx : TcContext]
  [_top-env : TcTypeEnv]
  [local-top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [name-id : i64]
  [variants : AstDispatchVariantList]
  [spans : CompilerSourceSpans]
  [name-cache : LowerNameCache]
  [mode : CompilerLowerMode]
  [module : String]
  [module-id : i64]
  [logical-module : String]
  [logical-module-id : i64]) : ResultLowerDispatchDecl
  (let
    [name : String (tc-env-key-name-text name-id)]
    [decl-ctx : TcContext (tc-context-with-module-id ctx module module-id)]
    [logical-name : String
      (lower-current-decl-logical-name-cache-id
        name-cache
        logical-module
        name
        name-id)]
    [key-id : i64 (lower-module-name-key-id-by-id logical-module-id name-id)]
    [logical-id : i64
      (lower-name-cache-lookup-logical-id (& name-cache) key-id key-id)]
    [logical-symbol : i64
      (lower-name-cache-ir-symbol name-cache logical-id name-id logical-name)]
    [cache-text : String (lower-dispatch-cache-name logical-name)]
    [cache-id : i64 (ci.intern-generated-name cache-text)]
    [cache-symbol : i64 cache-id]
    (match (tc-lookup-id local-top-env name-id)
      [(ResultTcType.Ok dispatch-ty)
        (let
          [fn-ty : AstType
            (tc-type-without-regions (tc-resolve-type decl-ctx dispatch-ty))]
          (match (lower-dispatch-lower-variants
            decl-ctx
            local-top-env
            type-cache
            logical-name
            variants
            module-id
            spans
            name-cache
            mode)
            [(ResultLowerFunction.Ok variant-functions variant-spans)
              (match (lower-dispatch-thunk-function
                decl-ctx
                logical-symbol
                cache-symbol
                fn-ty
                variants
                module-id
                name-cache
                variant-spans)
                [(ResultLowerFunction.Ok thunk-functions thunk-spans)
                  (let
                    ;; The synthesized thunk is built directly in the enclosing
                    ;; source arena, so give it the same lifetime as variants
                    ;; lowered through lower-function-escaping.
                    [escaped-thunk-functions : CompilerIrFunctionList
                      (lower-function-list-escape-to-ir-arena thunk-functions)]
                    [functions : CompilerIrFunctionBuilder
                      (compiler-ir-function-builder-with-capacity
                        (+
                          (compiler-ir-function-list-count variant-functions)
                          (compiler-ir-function-list-count
                            escaped-thunk-functions)))]
                    (begin
                      (compiler-ir-function-builder-append-list!
                        (&mut functions)
                        variant-functions)
                      (compiler-ir-function-builder-append-list!
                        (&mut functions)
                        escaped-thunk-functions)
                      (ResultLowerDispatchDecl.Ok
                        (box
                          (LowerDispatchDecl.Decl
                            (CompilerIrGlobal.Global
                              cache-symbol
                              fn-ty
                              (CompilerIrValue.I64 0))
                            (compiler-ir-function-builder-to-list functions)
                            thunk-spans)))))]
                [(ResultLowerFunction.Err message)
                  (ResultLowerDispatchDecl.Err message)])]
            [(ResultLowerFunction.Err message)
              (ResultLowerDispatchDecl.Err message)]))]
      [(ResultTcType.Err message)
        (ResultLowerDispatchDecl.Err (box (lower-diagnostic message)))])))

(define (lower-rvo-early-return-functions-from-decls-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [names : LowerNameEnv]
  [_ : String]
  [module-id : i64]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [name-cache : LowerNameCache (lower-name-cache-from-env names)]
    [cur-out : lower_i64_i64_map.Map out]
    (begin
      (while (< index count)
        (let
          [decl : AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          (begin
            (match (ast-decl-unwrapped decl)
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [(AstDecl.DefFn decl-meta name _ _ body-box _)
                (let
                  [has-early-return : bool
                    (match (tc-body-early-exit-fact body-box)
                      [(TcBodyEarlyExitFact.Known value) value]
                      [(TcBodyEarlyExitFact.Unknown)
                        (lower-rvo-node-has-early-return? ctx body-box)])]
                  (if has-early-return
                    (let
                      [key-id : i64
                        (lower-module-name-key-id-by-id cur-module-id name)]
                      (lower_i64_i64_map.insert-ref!
                        (&mut cur-out)
                        (lower-name-cache-lookup-logical-id
                          (& name-cache)
                          key-id
                          key-id)
                        1))
                    unit))]
              [_ unit])
            (set! index (+ index 1)))))
      cur-out)))

(define (lower-rvo-early-return-functions-from-decls
  [ctx : TcContext]
  [decls : AstDeclList]
  [names : LowerNameEnv]) : lower_i64_i64_map.Map
  (lower-rvo-early-return-functions-from-decls-in-module
    ctx
    decls
    names
    ""
    cbi.compiler-builtin-id-fix-empty
    (lower_i64_i64_map.with-capacity 8192)))

(define (lower-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [globals : CompilerIrGlobalList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [spans : CompilerSourceSpans]
  [names : LowerNameEnv]
  [clone-roots : CloneNameList]
  [mode : CompilerLowerMode]) : ResultLowerDecls
  (let
    [dispatch-name-cache : LowerNameCache
      (lower-name-cache-with-clone-roots
        (lower-name-cache-from-env names)
        clone-roots)]
    [dispatch-variants : lower_i64_i64_map.Map
      (lower-dispatch-variant-set-from-decls
        decls
        paths
        entry-path
        dispatch-name-cache)]
    (begin
      ;; Build the shared global name/type caches once; per-module caches
      ;; are small overlays that fall through to them. The initial cur caches are
      ;; empty overlays (everything resolves via the global caches) for decls in
      ;; the leading "" module before the first (module ...) marker.
      (set! lower-active-global-name-cache dispatch-name-cache)
      (set! lower-decls-global-type-cache (lower-type-cache-from-env top-env))
      (set!
        lower-rvo-early-return-functions
        (lower-rvo-early-return-functions-from-decls ctx decls names))
      (lower-decls-in-module
        ctx
        top-env
        top-env
        decls
        paths
        entry-path
        globals
        functions
        externs
        spans
        names
        (lower-name-cache-overlay
          (LowerNameEnv.Nil)
          cbi.compiler-builtin-id-fix-empty)
        (lower-type-cache-overlay (TcTypeEnv.Nil))
        dispatch-variants
        mode
        ""
        cbi.compiler-builtin-id-fix-empty))))

;; Lower every top-level decl of the expanded program. This used to be
;; a tail-recursive walk (one call per decl), but the inline-aggregate TCO
;; guard declines frame reuse here, so a whole-compiler input stacked
;; one ~56KB frame per decl (7,035 frames = 402MB of the measured 502MB stack
;; peak that forced the 1GB Windows reserves). Iterate instead; the
;; threaded accumulators become loop state.
(define (lower-skip-runtime-until-next-module [decls : AstDeclList]) : AstDeclList
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (ast-decl-list-new)]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module _) decls]
          [_
            (let
              [kept-rest : AstDeclList
                (lower-skip-runtime-until-next-module rest)]
              (if (lower-type-decl? decl)
                (ast-decl-list-prepend-builder decl kept-rest)
                kept-rest))]))]))

(defenum LowerSkippedRuntimeWithPaths
  (Skipped AstDeclList AstDeclPathList))

(define (lower-skip-runtime-until-next-module-with-paths
  [decls : AstDeclList]
  [paths : AstDeclPathList]) : LowerSkippedRuntimeWithPaths
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil)
      (LowerSkippedRuntimeWithPaths.Skipped
        (ast-decl-list-new)
        (ast-decl-path-list-new))]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String (ast-decl-path-list-get (& paths) 0 "")]
        [owner-id : i64
          (ast-decl-path-list-owner-id
            (& paths)
            0
            cbi.compiler-builtin-id-fix-empty)]
        [rest-paths : AstDeclPathList (ast-decl-path-list-tail paths)]
        (match decl
          [(AstDecl.Module _)
            (LowerSkippedRuntimeWithPaths.Skipped decls paths)]
          [_
            (match (lower-skip-runtime-until-next-module-with-paths
              rest
              rest-paths)
              [(LowerSkippedRuntimeWithPaths.Skipped kept kept-paths)
                (if (lower-type-decl? decl)
                  (LowerSkippedRuntimeWithPaths.Skipped
                    (ast-decl-list-prepend-builder decl kept)
                    (ast-decl-path-list-prepend-builder-with-owner-id
                      decl-path
                      owner-id
                      kept-paths))
                  (LowerSkippedRuntimeWithPaths.Skipped kept kept-paths))])]))]))

(define (lower-decls-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [local-top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [globals : CompilerIrGlobalList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [spans : CompilerSourceSpans]
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [type-cache : LowerTypeCache]
  [dispatch-variants : lower_i64_i64_map.Map]
  [mode : CompilerLowerMode]
  [module : String]
  [module-id : i64]) : ResultLowerDecls
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-local-top-env : TcTypeEnv local-top-env]
    [cur-globals : CompilerIrGlobalList globals]
    [cur-functions : CompilerIrFunctionBuilder
      (compiler-ir-function-builder-from-list functions)]
    [cur-externs : CompilerIrExternList externs]
    [cur-spans : CompilerSourceSpans spans]
    [cur-name-cache : LowerNameCache name-cache]
    [cur-type-cache : LowerTypeCache type-cache]
    [cur-module : String module]
    [cur-module-id : i64 module-id]
    [result : ResultLowerDecls
      (ResultLowerDecls.Err
        (box (lower-diagnostic "lower: internal decls walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cur-decls)
          [(AstDeclListStep.Nil)
            (begin
              (set!
                result
                (ResultLowerDecls.Ok
                  (box
                    (LowerDeclsSuccess
                      (compiler-ir-global-list-compact-reversed cur-globals)
                      (compiler-ir-function-builder-snapshot-list
                        (& cur-functions))
                      (compiler-ir-extern-list-compact-reversed cur-externs)
                      cur-spans))))
              (set! done true))]
          [(AstDeclListStep.Cons decl rest)
            (let
              [rest : AstDeclList rest]
              [decl-path : String
                (ast-decl-path-list-get (& cur-paths) 0 entry-path)]
              [logical-module-id : i64
                (lower-decl-owner-module-id
                  (& cur-paths)
                  0
                  entry-path
                  decl-path
                  cur-module-id)]
              [logical-module : String
                (lower-decl-owner-module-name cur-module-id logical-module-id)]
              [decl-name-cache : LowerNameCache
                (lower-name-cache-with-module-id
                  cur-name-cache
                  logical-module-id)]
              [rest-paths : AstDeclPathList (ast-decl-path-list-tail cur-paths)]
              [_advance-paths : unit (set! cur-paths rest-paths)]
              (match (ast-decl-unwrapped decl)
                [(AstDecl.ModuleBody _ _) (set! cur-decls rest)]
                [(AstDecl.Def decl-meta name _ expr-box)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module-id ctx cur-module cur-module-id)]
                    [expr : AstExpr (lower-context-expr-get decl-ctx expr-box)]
                    (match (lower-top-decl-type-or-check
                      decl-ctx
                      cur-local-top-env
                      decl)
                      [(ResultTcType.Ok ty)
                        (let
                          [global-ty : AstType (tc-type-without-regions ty)]
                          [global-name : String
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              logical-module
                              (tc-env-key-name-text name)
                              name)]
                          [global-key-id : i64
                            (lower-module-name-key-id-by-id
                              logical-module-id
                              name)]
                          [global-id : i64
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              global-key-id
                              global-key-id)]
                          [global-symbol : i64
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              global-id
                              name
                              global-name)]
                          (match (lower-global-value
                            decl-ctx
                            decl-name-cache
                            expr
                            global-ty)
                            [(ResultLowerValue.Ok value)
                              (begin
                                (set!
                                  cur-globals
                                  (compiler-ir-global-cons
                                    (CompilerIrGlobal.Global
                                      global-symbol
                                      global-ty
                                      value)
                                    cur-globals))
                                (set! cur-decls rest))]
                            ;; A global whose initializer is not a compile-time
                            ;; constant is evaluated at startup by a hidden
                            ;; `__global_init_<name>` function whose return
                            ;; value the backend stores into the global before
                            ;; `main`. This applies to any non-unit type
                            ;; (scalars as well as aggregates), mirroring the
                            ;; former Rust lowerer, which emits an init function
                            ;; whenever `extract_const` yields no constant.
                            [(ResultLowerValue.Err _)
                              (let
                                [init-symbol : i64
                                  (lower-global-init-function-name
                                    global-symbol)]
                                (match (lower-function-escaping
                                  decl-ctx
                                  cur-local-top-env
                                  cur-type-cache
                                  init-symbol
                                  (ast-param-list-new)
                                  global-ty
                                  expr
                                  cur-spans
                                  decl-name-cache
                                  mode)
                                  [(ResultLowerFunction.Ok
                                      init-funcs
                                      init-spans)
                                    (begin
                                      (set!
                                        cur-globals
                                        (compiler-ir-global-cons
                                          (CompilerIrGlobal.Global
                                            global-symbol
                                            global-ty
                                            (CompilerIrValue.RuntimeGlobal
                                              init-symbol))
                                          cur-globals))
                                      (compiler-ir-function-builder-append-list!
                                        (&mut cur-functions)
                                        init-funcs)
                                      (set! cur-spans init-spans)
                                      (set! cur-decls rest))]
                                  [(ResultLowerFunction.Err init-message)
                                    (begin
                                      (set!
                                        result
                                        (ResultLowerDecls.Err init-message))
                                      (set! done true))]))]))]
                      [(ResultTcType.Err message)
                        (begin
                          (set!
                            result
                            (ResultLowerDecls.Err
                              (box (lower-diagnostic message))))
                          (set! done true))]))]
                [(AstDecl.Extern decl-meta name _ metadata ty)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module-id ctx cur-module cur-module-id)]
                    [resolved-ty : AstType (tc-resolve-type decl-ctx ty)]
                    [logical-name : String
                      (lower-current-decl-logical-name-cache-id
                        decl-name-cache
                        logical-module
                        (tc-env-key-name-text name)
                        name)]
                    [logical-key-id : i64
                      (lower-module-name-key-id-by-id logical-module-id name)]
                    [logical-id : i64
                      (lower-name-cache-lookup-logical-id
                        (& decl-name-cache)
                        logical-key-id
                        logical-key-id)]
                    (if (and
                      (tc-type-contains-reference? resolved-ty)
                      (not
                        (lower-supported-reference-extern?
                          decl-ctx
                          name
                          resolved-ty)))
                      (begin
                        (set!
                          result
                          (ResultLowerDecls.Err
                            (box
                              (lower-diagnostic
                                (lower-reference-support-message)))))
                        (set! done true))
                      (begin
                        (set!
                          cur-externs
                          (compiler-ir-extern-cons
                            (CompilerIrExtern.Extern
                              (lower-extern-logical-symbol-id
                                logical-id
                                logical-name
                                name
                                (box-get metadata))
                              name
                              logical-name
                              (tc-type-without-regions resolved-ty)
                              (ast-extern-metadata-abi (box-get metadata))
                              (ast-extern-metadata-symbol-id (box-get metadata))
                              (ast-extern-metadata-link-inputs
                                (box-get metadata))
                              false)
                            cur-externs))
                        (set! cur-decls rest))))]
                [(AstDecl.DefFn decl-meta name params ret body-box metadata)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module-id ctx cur-module cur-module-id)]
                    [body : AstExpr (lower-context-expr-get decl-ctx body-box)]
                    [logical-id : i64
                      (lower-decl-logical-id
                        entry-path
                        decl-path
                        logical-module
                        logical-module-id
                        name
                        (tc-env-key-name-text name))]
                    [logical-name : String
                      (if (= logical-id cbi.compiler-builtin-id-fix-main)
                        "main"
                        (lower-current-decl-logical-name-cache-id
                          decl-name-cache
                          logical-module
                          (tc-env-key-name-text name)
                          name))]
                    [function-symbol : i64
                      (lower-decl-function-symbol-id
                        decl-name-cache
                        logical-id
                        name
                        logical-name)]
                    (if (lower_i64_i64_map.contains?
                      (& dispatch-variants)
                      logical-id)
                      (set! cur-decls rest)
                      (begin
                        (cfg
                          compile-profile
                          (compiler-lower-profile-detail-start))
                        (match (lower-function-escaping
                          decl-ctx
                          cur-local-top-env
                          cur-type-cache
                          function-symbol
                          params
                          ret
                          body
                          cur-spans
                          decl-name-cache
                          mode)
                          [(ResultLowerFunction.Ok
                              lowered-functions
                              function-spans)
                            (match (lower-spmd-package-callable-functions
                              decl-ctx
                              cur-local-top-env
                              cur-type-cache
                              (compiler-symbol-module-key
                                (if (= (string.string-length cur-module) 0)
                                  lower-spmd-package-name
                                  cur-module)
                                (tc-env-key-name-text name))
                              (compiler-symbols-lookup-value-id-or
                                (tc-context-symbols decl-ctx)
                                logical-id
                                (compiler-symbols-lookup-value-id-or
                                  (tc-context-symbols decl-ctx)
                                  name
                                  (compiler-symbols-missing-handle)))
                              params
                              ret
                              body
                              (ast-fn-metadata-spmd-callable metadata)
                              function-spans
                              cur-name-cache
                              mode)
                              [(ResultLowerFunction.Err message)
                                (begin
                                  (cfg
                                    compile-profile
                                    (compiler-lower-profile-detail-finish
                                      "function"
                                      logical-name))
                                  (set! result (ResultLowerDecls.Err message))
                                  (set! done true))]
                              [(ResultLowerFunction.Ok
                                  callable-functions
                                  next-spans)
                                (let
                                  [next-externs : CompilerIrExternList
                                    (match (ast-fn-metadata-export metadata)
                                      [(AstFnExport.No) cur-externs]
                                      [(AstFnExport.Export symbol)
                                        (compiler-ir-extern-cons
                                          (CompilerIrExtern.Extern
                                            function-symbol
                                            function-symbol
                                            logical-name
                                            (ast-ty-func
                                              (tc-type-list-without-regions
                                                (tc-param-type-list
                                                  decl-ctx
                                                  params))
                                              (tc-type-without-regions
                                                (tc-resolve-type decl-ctx ret)))
                                            (AstExternAbi.C)
                                            symbol
                                            (ast-extern-link-input-list-new)
                                            true)
                                          cur-externs)])]
                                  (begin
                                    (cfg
                                      compile-profile
                                      (compiler-lower-profile-detail-finish
                                        "function"
                                        logical-name))
                                    (compiler-ir-function-builder-append-list!
                                      (&mut cur-functions)
                                      lowered-functions)
                                    (compiler-ir-function-builder-append-list!
                                      (&mut cur-functions)
                                      callable-functions)
                                    (set! cur-externs next-externs)
                                    (set! cur-spans next-spans)
                                    (set! cur-decls rest)))])]
                          [(ResultLowerFunction.Err message)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-lower-profile-detail-finish
                                  "function"
                                  logical-name))
                              (set! result (ResultLowerDecls.Err message))
                              (set! done true))]))))]
                [(AstDecl.DefMacro decl-meta _ _ _ _) (set! cur-decls rest)]
                [(AstDecl.DefDispatch decl-meta name variants)
                  (match (lower-dispatch-decl
                    ctx
                    top-env
                    cur-local-top-env
                    cur-type-cache
                    name
                    variants
                    cur-spans
                    decl-name-cache
                    mode
                    cur-module
                    cur-module-id
                    logical-module
                    logical-module-id)
                    [(ResultLowerDispatchDecl.Ok lowered)
                      (match (box-get lowered)
                        [(LowerDispatchDecl.Decl
                            cache-global
                            lowered-functions
                            function-spans)
                          (begin
                            (set!
                              cur-globals
                              (compiler-ir-global-cons cache-global cur-globals))
                            (compiler-ir-function-builder-append-list!
                              (&mut cur-functions)
                              lowered-functions)
                            (set! cur-spans function-spans)
                            (set! cur-decls rest))])]
                    [(ResultLowerDispatchDecl.Err message)
                      (begin
                        (set! result (ResultLowerDecls.Err message))
                        (set! done true))])]
                [(AstDecl.Import decl-meta _) (set! cur-decls rest)]
                [(AstDecl.IncludeStr _ _) (set! cur-decls rest)]
                [(AstDecl.IncludeStrComptime _ _) (set! cur-decls rest)]
                [(AstDecl.IncludeStrLzss _ _) (set! cur-decls rest)]
                [(AstDecl.IncludeBin _ _) (set! cur-decls rest)]
                [(AstDecl.Module next-module)
                  (let
                    [next-module-str : String (intern-str next-module)]
                    [skip-runtime : bool
                      (lower-comptime-runtime-skip-module? next-module-str)]
                    (match (lower-module-local-envs
                      ctx
                      top-env
                      names
                      cur-name-cache
                      next-module-str
                      next-module)
                      [(ResultLowerModuleLocalEnv.Ok
                          next-local-top-env
                          local-type-env
                          local-name-only)
                        (begin
                          (set! cur-local-top-env next-local-top-env)
                          ;; Overlay just this module's local names;
                          ;; misses fall through to the shared global name cache
                          ;; (set once) instead of rebuilding the whole global
                          ;; name set per module.
                          (set!
                            cur-name-cache
                            (lower-name-cache-overlay
                              local-name-only
                              next-module))
                          ;; Overlay just this module's local type
                          ;; bindings; misses fall through to the shared global
                          ;; type cache (set once from top-env) instead of
                          ;; rebuilding the whole global type set per module.
                          (set!
                            cur-type-cache
                            (lower-type-cache-overlay local-type-env))
                          (set! cur-module next-module-str)
                          (set! cur-module-id next-module)
                          (if skip-runtime
                            (match (lower-skip-runtime-until-next-module-with-paths
                              rest
                              cur-paths)
                              [(LowerSkippedRuntimeWithPaths.Skipped
                                  kept-decls
                                  kept-paths)
                                (begin
                                  (set! cur-decls kept-decls)
                                  (set! cur-paths kept-paths))])
                            (set! cur-decls rest)))]
                      [(ResultLowerModuleLocalEnv.Err message)
                        (begin
                          (set!
                            result
                            (ResultLowerDecls.Err
                              (box (lower-diagnostic message))))
                          (set! done true))]))]
                [(AstDecl.Test _ _ _) (set! cur-decls rest)]
                [(AstDecl.DefEnum decl-meta name cleanup variants)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module-id ctx cur-module cur-module-id)]
                    [logical-name : i64
                      (match cleanup
                        [(AstEnumCleanup.No) -1]
                        [(AstEnumCleanup.Fn cleanup-name)
                          (let
                            [key-id : i64
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                cleanup-name)]
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              (lower-name-cache-lookup-logical-id
                                (& decl-name-cache)
                                key-id
                                key-id)
                              cleanup-name
                              (lower-current-decl-logical-name-cache-id
                                decl-name-cache
                                logical-module
                                (tc-env-key-name-text cleanup-name)
                                cleanup-name)))])]
                    [enum-id : i64
                      (compiler-symbol-module-key-id-by-id cur-module-id name)]
                    (begin
                      (if (lower-comptime-runtime-skip-module? cur-module)
                        unit
                        (set!
                          cur-globals
                          (lower-nullary-variant-globals
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                name)
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                name))
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              logical-module
                              (tc-env-key-name-text name)
                              name)
                            variants
                            0
                            cur-globals)))
                      (match (lower-enum-cleanup-decl
                        decl-ctx
                        cur-local-top-env
                        cur-type-cache
                        logical-name
                        cleanup
                        (AstType.Enum enum-id)
                        variants
                        cur-spans
                        decl-name-cache
                        mode)
                        [(ResultLowerFunction.Ok
                            cleanup-functions
                            cleanup-spans)
                          (begin
                            (compiler-ir-function-builder-append-list!
                              (&mut cur-functions)
                              cleanup-functions)
                            (set! cur-spans cleanup-spans)
                            (set! cur-decls rest))]
                        [(ResultLowerFunction.Err message)
                          (begin
                            (set! result (ResultLowerDecls.Err message))
                            (set! done true))])))]
                [(AstDecl.DefEnumLifetimes
                    decl-meta
                    name
                    lifetimes
                    cleanup
                    variants)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module-id ctx cur-module cur-module-id)]
                    [logical-name : i64
                      (match cleanup
                        [(AstEnumCleanup.No) -1]
                        [(AstEnumCleanup.Fn cleanup-name)
                          (let
                            [key-id : i64
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                cleanup-name)]
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              (lower-name-cache-lookup-logical-id
                                (& decl-name-cache)
                                key-id
                                key-id)
                              cleanup-name
                              (lower-current-decl-logical-name-cache-id
                                decl-name-cache
                                logical-module
                                (tc-env-key-name-text cleanup-name)
                                cleanup-name)))])]
                    [enum-id : i64
                      (compiler-symbol-module-key-id-by-id cur-module-id name)]
                    (begin
                      (if (lower-comptime-runtime-skip-module? cur-module)
                        unit
                        (set!
                          cur-globals
                          (lower-nullary-variant-globals
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                name)
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                name))
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              logical-module
                              (tc-env-key-name-text name)
                              name)
                            variants
                            0
                            cur-globals)))
                      (match (lower-enum-cleanup-decl
                        decl-ctx
                        cur-local-top-env
                        cur-type-cache
                        logical-name
                        cleanup
                        (ast-ty-enum-args enum-id lifetimes)
                        variants
                        cur-spans
                        decl-name-cache
                        mode)
                        [(ResultLowerFunction.Ok
                            cleanup-functions
                            cleanup-spans)
                          (begin
                            (compiler-ir-function-builder-append-list!
                              (&mut cur-functions)
                              cleanup-functions)
                            (set! cur-spans cleanup-spans)
                            (set! cur-decls rest))]
                        [(ResultLowerFunction.Err message)
                          (begin
                            (set! result (ResultLowerDecls.Err message))
                            (set! done true))])))]
                [(AstDecl.DefStruct decl-meta name _ cleanup fields)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module-id ctx cur-module cur-module-id)]
                    [logical-name : i64
                      (match cleanup
                        [(AstStructCleanup.No) -1]
                        [(AstStructCleanup.Fn cleanup-name)
                          (let
                            [key-id : i64
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                cleanup-name)]
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              (lower-name-cache-lookup-logical-id
                                (& decl-name-cache)
                                key-id
                                key-id)
                              cleanup-name
                              (lower-current-decl-logical-name-cache-id
                                decl-name-cache
                                logical-module
                                (tc-env-key-name-text cleanup-name)
                                cleanup-name)))])]
                    [struct-ty : AstType
                      (AstType.Struct
                        (compiler-symbol-module-key-id-by-id cur-module-id name))]
                    (match (lower-struct-cleanup-decl
                      decl-ctx
                      cur-local-top-env
                      cur-type-cache
                      logical-name
                      cleanup
                      struct-ty
                      fields
                      cur-spans
                      decl-name-cache
                      mode)
                      [(ResultLowerFunction.Ok cleanup-functions cleanup-spans)
                        (begin
                          (compiler-ir-function-builder-append-list!
                            (&mut cur-functions)
                            cleanup-functions)
                          (set! cur-spans cleanup-spans)
                          (set! cur-decls rest))]
                      [(ResultLowerFunction.Err message)
                        (begin
                          (set! result (ResultLowerDecls.Err message))
                          (set! done true))]))]
                [(AstDecl.DefStructLifetimes
                    decl-meta
                    name
                    lifetimes
                    _
                    cleanup
                    fields)
                  (let
                    [decl-ctx : TcContext
                      (tc-context-with-module-id ctx cur-module cur-module-id)]
                    [logical-name : i64
                      (match cleanup
                        [(AstStructCleanup.No) -1]
                        [(AstStructCleanup.Fn cleanup-name)
                          (let
                            [key-id : i64
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                cleanup-name)]
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              (lower-name-cache-lookup-logical-id
                                (& decl-name-cache)
                                key-id
                                key-id)
                              cleanup-name
                              (lower-current-decl-logical-name-cache-id
                                decl-name-cache
                                logical-module
                                (tc-env-key-name-text cleanup-name)
                                cleanup-name)))])]
                    [struct-ty : AstType
                      (ast-ty-struct-args
                        (compiler-symbol-module-key-id-by-id cur-module-id name)
                        lifetimes)]
                    (match (lower-struct-cleanup-decl
                      decl-ctx
                      cur-local-top-env
                      cur-type-cache
                      logical-name
                      cleanup
                      struct-ty
                      fields
                      cur-spans
                      decl-name-cache
                      mode)
                      [(ResultLowerFunction.Ok cleanup-functions cleanup-spans)
                        (begin
                          (compiler-ir-function-builder-append-list!
                            (&mut cur-functions)
                            cleanup-functions)
                          (set! cur-spans cleanup-spans)
                          (set! cur-decls rest))]
                      [(ResultLowerFunction.Err message)
                        (begin
                          (set! result (ResultLowerDecls.Err message))
                          (set! done true))]))]
                [(AstDecl.Unsafe _) (set! cur-decls rest)]))]))
      result)))

(define (lower-compiler-program-checked-with-names-mode
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [clone-roots : CloneNameList]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (begin
    ;; Clone-root discovery and checked typechecking can probe aggregate layout
    ;; with helper contexts before final lowering. Emitted code must use one
    ;; internally consistent layout view for all functions in this pass.
    (tc-agg-caches-reset!)
    (tc-nominal-owner-cache-reset!)
    (match program
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (match (lower-decls
            ctx
            top-env
            decls
            paths
            entry-path
            CompilerIrGlobalList.Nil
            CompilerIrFunctionList.Nil
            CompilerIrExternList.Nil
            (compiler-source-spans-empty)
            names
            clone-roots
            mode)
            [(ResultLowerDecls.Ok payload)
              (let
                [success : LowerDeclsSuccess (box-get payload)]
                (ResultCompilerLower.Ok
                  (CompilerIrProgram.Program
                    (struct-get success globals)
                    (struct-get success functions)
                    (struct-get success externs))
                  (struct-get success spans)))]
            [(ResultLowerDecls.Err message) (ResultCompilerLower.Err message)]))])))

;; Internal `expanded` workers assume macro expansion has already run; the
;; public `-mode` wrappers below own the expand -> specialize -> typecheck
;; boundary so every lowering path (scalar and SPMD) expands exactly once.
(define (lower-compiler-expanded-program-unlocated-mode
  [program : AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (match (compiler-specialize-program program)
    [(ResultSpecProgram.Ok specialized)
      (let
        [paths : AstDeclPathList (ast-decl-path-list-new)]
        [pools : AstNodePoolContext (ast-node-pool-context-capture-active)]
        [keep-plan : LowerDeclKeepPlan
          (match specialized
            [(AstProgram.Program decls-box)
              (lower-decl-keep-plan-all
                (ast-decl-list-len (& (box-get decls-box))))])]
        [alias-names : LowerNameEnv
          (match specialized
            [(AstProgram.Program decls-box)
              (lower-name-env-with-import-aliases
                (box-get decls-box)
                paths
                "<source>"
                LowerNameEnv.Nil
                false)])]
        (begin
          (tc-clone-root-collection-use! specialized)
          (lower-typecheck-clone-and-lower
            "<source>"
            specialized
            paths
            keep-plan
            alias-names
            true
            mode
            (svec.new)
            (tc-prefix-default-cache-scope)
            pools)))]
    [(ResultSpecProgram.Err diag) (ResultCompilerLower.Err diag)]))

(define (lower-compiler-program-unlocated-mode
  [program : AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (begin
    (tc-agg-caches-reset!)
    ;; Generate declaration families before macro expansion (see
    ;; typecheck-compiler-program-with-paths for why).
    (match (gen-normalize-program program)
      [(ResultGenProgram.Ok generated)
        (match (macro-expand-program generated)
          [(ResultMacroExpand.Ok expanded _)
            (lower-compiler-expanded-program-unlocated-mode expanded mode)]
          [(ResultMacroExpand.Err diag) (ResultCompilerLower.Err diag)])]
      [(ResultGenProgram.Err diag) (ResultCompilerLower.Err diag)])))

(define (lower-compiler-program-with-path-mode
  [path : String]
  [program : AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (match (lower-compiler-program-unlocated-mode program mode)
    [(ResultCompilerLower.Ok ir spans) (ResultCompilerLower.Ok ir spans)]
    [(ResultCompilerLower.Err diag)
      (ResultCompilerLower.Err
        (box (lower-diagnostic-with-path (box-get diag) path)))]))

(define (lower-compiler-program-with-path
  [path : String]
  [program : AstProgram]) : ResultCompilerLower
  (lower-compiler-program-with-path-mode
    path
    program
    (CompilerLowerMode.Scalar)))

;; Check source declarations once, collect clone-helper roots as a side effect
;; of that real semantic walk, then append the generated helpers and extend the
;; checked context with only the appended function signatures. Generated clone
;; declarations have never been checked by tc-check-decls (they are trusted
;; compiler output), so building them before typecheck only forced a redundant
;; symbols/registries/top-env construction and a shadow expression typecheck.
(define (lower-typecheck-clone-and-lower-with-source-names
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [keep-plan : LowerDeclKeepPlan]
  [escaped-names : LowerNameEnv]
  [needs-specialization : bool]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (match (let
    [_start-early-exit-facts : unit (tc-body-early-exit-facts-start! pools)]
    (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools-and-source-names
      program
      paths
      stdlib-roots
      cache-scope
      pools
      source-names))
    [(ResultCompilerTypecheckChecked.Ok _ source-ctx source-top-env _)
      (let
        [_finish-early-exit-facts : unit (tc-body-early-exit-facts-finish!)]
        [clone-roots : CloneNameList
          (tc-clone-root-collection-finish! source-ctx)]
        [source-decl-count : i64
          (match program
            [(AstProgram.Program decls-box)
              (ast-decl-list-len (& (box-get decls-box)))])]
        [checked-keep-plan : LowerDeclKeepPlan
          (lower-decl-keep-plan-add-clone-roots keep-plan program clone-roots)]
        [clone-able : CloneNameSet (tc-clone-able-set source-ctx)]
        [_install-clone-pools : unit (ast-node-pool-context-install! pools)]
        [clone-augmentation : ResultLowerCloneAugment
          (lower-clone-handoff-augment
            source-ctx
            source-top-env
            entry-path
            program
            clone-able
            clone-roots
            pools)]
        [checked-program : AstProgram
          (match clone-augmentation
            [(ResultLowerCloneAugment.Ok augmented _) augmented]
            [(ResultLowerCloneAugment.Err _) program])]
        [_install-augmented-pools : unit (ast-node-pool-context-install! pools)]
        [checked-context : ResultLowerCheckedContext
          (match clone-augmentation
            [(ResultLowerCloneAugment.Ok _ _)
              (lower-extend-checked-context-with-clone-decls
                source-ctx
                source-top-env
                source-decl-count
                checked-program)]
            [(ResultLowerCloneAugment.Err message)
              (ResultLowerCheckedContext.Err message)])]
        [lower-names : LowerNameEnv
          (match checked-program
            [(AstProgram.Program decls-box)
              (let
                [decls : AstDeclList (box-get decls-box)]
                (if needs-specialization
                  (lower-name-env-add-clone-decls
                    decls
                    paths
                    entry-path
                    escaped-names)
                  (lower-name-env-from-decls
                    decls
                    paths
                    entry-path
                    LowerNameEnv.Nil)))])]
        (begin
          (cfg compile-profile (compiler-lower-profile-finish "typecheck"))
          (cfg compile-profile (compiler-lower-profile-start))
          (match checked-context
            [(ResultLowerCheckedContext.Ok ctx top-env)
              (begin
                (cfg
                  compile-profile
                  (compiler-lower-profile-finish "clone_augment_names"))
                (cfg
                  compile-profile
                  (compiler-lower-profile-pools "typecheck" pools))
                (cfg
                  compile-profile
                  (compiler-lower-profile-pools "pre_decls" pools))
                (cfg
                  compile-profile
                  (compiler-lower-profile-program-counts
                    "pre_decls"
                    checked-program))
                (cfg compile-profile (compiler-lower-profile-start))
                ;; Whole-program source typecheck is complete. Apply the
                ;; declaration decisions retained by reachability; clone
                ;; helpers are appended and marked by add-clone-roots.
                (let
                  [pruned-program : AstProgram
                    (lower-decl-keep-plan-apply
                      checked-keep-plan
                      checked-program)]
                  (begin
                    (cfg
                      compile-profile
                      (compiler-lower-profile-finish "prune_apply"))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-program-counts
                        "reachable"
                        pruned-program))
                    (cfg compile-profile (compiler-lower-profile-start))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-string-concat-reset))
                    (match (lower-compiler-program-checked-with-names-mode
                      ctx
                      top-env
                      pruned-program
                      (lower-decl-keep-plan-apply-paths checked-keep-plan paths)
                      entry-path
                      lower-names
                      clone-roots
                      mode)
                      [(ResultCompilerLower.Ok ir spans)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-lower-profile-string-concat-finish))
                          (cfg
                            compile-profile
                            (compiler-lower-profile-finish "decls"))
                          (cfg
                            compile-profile
                            (compiler-lower-profile-ir-shape "after_decls" ir))
                          (cfg
                            compile-profile
                            (compiler-lower-profile-ir-arena "after_decls"))
                          (ResultCompilerLower.Ok ir spans))]
                      [(ResultCompilerLower.Err diag)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-lower-profile-string-concat-finish))
                          (cfg
                            compile-profile
                            (compiler-lower-profile-finish "decls"))
                          (ResultCompilerLower.Err
                            (box
                              (lower-diagnostic-with-path
                                (box-get diag)
                                entry-path))))]))))]
            [(ResultLowerCheckedContext.Err message)
              (begin
                (cfg
                  compile-profile
                  (compiler-lower-profile-finish "clone_augment_names"))
                (ResultCompilerLower.Err (box (lower-diagnostic message))))])))]
    [(ResultCompilerTypecheckChecked.Err diag)
      (begin
        (tc-body-early-exit-facts-abort!)
        (tc-clone-root-collection-abort!)
        (cfg compile-profile (compiler-lower-profile-finish "typecheck"))
        (ResultCompilerLower.Err diag))]))

(define (lower-typecheck-clone-and-lower
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [keep-plan : LowerDeclKeepPlan]
  [escaped-names : LowerNameEnv]
  [needs-specialization : bool]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerLower
  (lower-typecheck-clone-and-lower-with-source-names
    entry-path
    program
    paths
    keep-plan
    escaped-names
    needs-specialization
    mode
    stdlib-roots
    cache-scope
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-active-and-pools-and-source-names
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (begin
    (cfg compile-profile (compiler-lower-profile-start))
    (let
      [needs-specialization : bool
        (compiler-specialize-needed-with-pools program pools)]
      [names : LowerNameEnv
        (match program
          [(AstProgram.Program decls-box)
            (let
              [decls : AstDeclList (box-get decls-box)]
              (lower-name-env-from-decls
                decls
                paths
                entry-path
                LowerNameEnv.Nil))])]
      (match (if needs-specialization
        (compiler-specialize-program-with-paths-and-pools
          program
          paths
          entry-path
          pools)
        (ResultSpecProgramWithPaths.Ok program paths))
        [(ResultSpecProgramWithPaths.Ok specialized specialized-paths)
          (begin
            (cfg compile-profile (compiler-lower-profile-finish "specialize"))
            (cfg compile-profile (compiler-lower-profile-start))
            (let
              [prune-names : LowerNameEnv
                (if needs-specialization
                  (match specialized
                    [(AstProgram.Program decls-box)
                      (let
                        [decls : AstDeclList (box-get decls-box)]
                        (lower-name-env-from-decls
                          decls
                          specialized-paths
                          entry-path
                          LowerNameEnv.Nil))])
                  names)]
              ;; Typecheck remains complete and whole-program while lower,
              ;; optimize, and codegen are gated on reachability. This up-front
              ;; walk records the dense declaration selection consumed both by
              ;; typecheck's clone-root observer and by the final linear prune.
              (match (lower-prune-unreachable-functions-with-clone-roots-and-plan
                pools
                entry-path
                specialized
                specialized-paths
                prune-names
                (CloneNameList.Nil))
                [(LowerPrunedProgramWithPlan.Program
                    reach-program
                    _reach-paths
                    reach-keep-plan)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-lower-profile-finish "prune"))
                    (cfg compile-profile (compiler-lower-profile-start))
                    ;; Capture stable retained declaration keys before optional
                    ;; pool compaction releases the reach-program AST.
                    (tc-clone-root-collection-use! reach-program)
                    (let
                      [detach-source? : bool lower-checked-dest-pools-active]
                      [source-compaction : AstProgramCompaction
                        (if detach-source?
                          (ast-program-compact-with-pools
                            pools
                            lower-checked-dest-pools-context
                            specialized)
                          (AstProgramCompaction specialized pools))]
                      [source-program : AstProgram
                        (match source-compaction
                          [(AstProgramCompaction out _) out])]
                      [source-pools : AstNodePoolContext
                        (match source-compaction
                          [(AstProgramCompaction _ out-pools) out-pools])]
                      [source-entry-path : String
                        (if detach-source?
                          (lower-copy-string-into-pools entry-path source-pools)
                          entry-path)]
                      [source-cache-scope : String
                        (if detach-source?
                          (lower-copy-string-into-pools
                            cache-scope
                            source-pools)
                          cache-scope)]
                      [source-paths : AstDeclPathList
                        (if detach-source?
                          (lower-copy-paths-into-pools
                            specialized-paths
                            source-pools)
                          specialized-paths)]
                      [source-keep-plan : LowerDeclKeepPlan
                        (if detach-source?
                          (lower-decl-keep-plan-copy-into-pools
                            reach-keep-plan
                            source-pools)
                          reach-keep-plan)]
                      [escaped-names : LowerNameEnv
                        (if (and detach-source? needs-specialization)
                          (lower-name-env-copy-into-pools names source-pools)
                          names)]
                      [_clear-source-derived-caches : unit
                        (if detach-source?
                          (lower-clear-macro-expanded-source-caches-into-pools!
                            source-pools)
                          unit)]
                      [_commit-dest : unit
                        (lower-checked-dest-pools-commit! source-pools)]
                      (lower-typecheck-clone-and-lower-with-source-names
                        source-entry-path
                        source-program
                        source-paths
                        source-keep-plan
                        escaped-names
                        needs-specialization
                        mode
                        stdlib-roots
                        source-cache-scope
                        source-pools
                        source-names)))])))]
        [(ResultSpecProgramWithPaths.Err diag)
          (begin
            (cfg compile-profile (compiler-lower-profile-finish "specialize"))
            (ResultCompilerLower.Err
              (box (lower-diagnostic-with-path (box-get diag) entry-path))))]))))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools-and-source-names
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (let
    [prev-active : bool lower-entry-main-module-active]
    [prev-module : String lower-entry-main-module]
    [prev-module-id : i64 lower-entry-main-module-id]
    [selection : LowerMaybeEntryMainModule
      (lower-entry-main-selection-for-program entry-path program paths)]
    (begin
      (lower-entry-main-selection-install! selection)
      (let
        [result : ResultCompilerLower
          (lower-compiler-expanded-program-with-decl-paths-mode-cache-active-and-pools-and-source-names
            entry-path
            program
            paths
            mode
            stdlib-roots
            cache-scope
            pools
            source-names)]
        (begin
          (lower-entry-main-selection-restore!
            prev-active
            prev-module
            prev-module-id)
          result)))))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerLower
  (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools-and-source-names
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(define (lower-compiler-program-with-decl-paths-mode-cache
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    (ast-node-pool-context-capture-active)))

(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state
  [load-state : CompilerLoadSessionState]
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (begin
    (cfg compile-profile (compiler-lower-profile-start))
    (tc-agg-caches-reset!)
    ;; Generate declaration families before macro expansion (see
    ;; typecheck-compiler-program-with-paths for why).
    (match (gen-normalize-program-with-paths-and-pools
      program
      paths
      entry-path
      pools)
      [(ResultGenProgramWithPaths.Ok generated generated-paths)
        (let
          [detach-before-macro? : bool lower-checked-dest-pools-active]
          [generated-compaction : AstProgramCompaction
            (if detach-before-macro?
              (ast-program-compact-with-pools
                pools
                (compiler-lower-checked-dest-pools-current)
                generated)
              (AstProgramCompaction generated pools))]
          [macro-program : AstProgram
            (match generated-compaction
              [(AstProgramCompaction out _) out])]
          [macro-pools : AstNodePoolContext
            (match generated-compaction
              [(AstProgramCompaction _ out-pools) out-pools])]
          [macro-entry-path : String
            (if detach-before-macro?
              (lower-copy-string-into-pools entry-path macro-pools)
              entry-path)]
          [macro-cache-scope : String
            (if detach-before-macro?
              (lower-copy-string-into-pools cache-scope macro-pools)
              cache-scope)]
          [macro-paths : AstDeclPathList
            (if detach-before-macro?
              (lower-copy-paths-into-pools generated-paths macro-pools)
              generated-paths)]
          [_clear-source-derived-caches : unit
            (if detach-before-macro?
              (begin
                (lower-clear-macro-expanded-source-caches-into-pools!
                  macro-pools)
                (compiler-load-program-cache-clear!)
                (compiler-load-runtime-prelude-cache-clear!)
                (tc-prefix-snapshot-cache-clear!))
              unit)]
          [_commit-generated-pools : unit
            (if detach-before-macro?
              (lower-checked-dest-pools-commit! macro-pools)
              unit)]
          [committed-macro-pools : AstNodePoolContext
            (if detach-before-macro?
              (compiler-lower-checked-dest-pools-current)
              macro-pools)]
          [_arm-post-macro-detach : unit
            (if detach-before-macro?
              (lower-checked-dest-pools-rollover-for-macro!)
              unit)]
          (match (macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names
            load-state
            macro-program
            macro-paths
            committed-macro-pools
            source-names
            stdlib-roots
            (typecheck-compiler-source-language-cfgs))
            [(ResultMacroExpand.Ok expanded expanded-paths)
              (begin
                (cfg
                  compile-profile
                  (compiler-lower-profile-finish "macro_expand"))
                (cfg
                  compile-profile
                  (compiler-lower-profile-pools
                    "macro_expand"
                    committed-macro-pools))
                (let
                  [checked-detach? : bool lower-checked-dest-pools-active]
                  [macro-changed? : bool
                    (macro-expand-program-structurally-changed?)]
                  [retain-macro-source? : bool
                    (and checked-detach? (not macro-changed?))]
                  [detach-load-pools? : bool
                    (and checked-detach? macro-changed?)]
                  [_detach-profile-decision : unit
                    (cfg
                      compile-profile
                      (begin
                        (compiler-lower-profile-counter
                          "macro_detach.fast_path_hits"
                          (if retain-macro-source?
                            1
                            0))
                        (compiler-lower-profile-counter
                          "macro_detach.fast_path_misses"
                          (if detach-load-pools?
                            1
                            0))
                        (compiler-lower-profile-counter
                          "macro_detach.change_reasons"
                          (macro-expand-program-structural-change-reasons-value))))]
                  [_detach-profile-start : unit
                    (if checked-detach?
                      (cfg compile-profile (compiler-lower-profile-start))
                      unit)]
                  [detached-compaction : AstProgramCompaction
                    (if detach-load-pools?
                      (ast-program-compact-with-pools
                        committed-macro-pools
                        (compiler-lower-checked-dest-pools-current)
                        expanded)
                      (AstProgramCompaction
                        (if retain-macro-source?
                          macro-program
                          expanded)
                        committed-macro-pools))]
                  [detached-program : AstProgram
                    (match detached-compaction
                      [(AstProgramCompaction out _) out])]
                  [detached-pools : AstNodePoolContext
                    (match detached-compaction
                      [(AstProgramCompaction _ out-pools) out-pools])]
                  [detached-entry-path : String
                    (if detach-load-pools?
                      (lower-copy-string-into-pools
                        macro-entry-path
                        detached-pools)
                      macro-entry-path)]
                  [detached-cache-scope : String
                    (if detach-load-pools?
                      (lower-copy-string-into-pools
                        macro-cache-scope
                        detached-pools)
                      macro-cache-scope)]
                  [detached-paths : AstDeclPathList
                    (if detach-load-pools?
                      (lower-copy-paths-into-pools
                        expanded-paths
                        detached-pools)
                      (if retain-macro-source?
                        macro-paths
                        expanded-paths))]
                  [_clear-source-derived-caches : unit
                    (if checked-detach?
                      (lower-clear-macro-expanded-source-caches-into-pools!
                        detached-pools)
                      unit)]
                  [_commit-detached-pools : unit
                    (cond
                      [detach-load-pools?
                        (lower-checked-dest-pools-commit! detached-pools)]
                      [retain-macro-source?
                        (lower-checked-dest-pools-retain-macro-source!
                          detached-pools)]
                      [else unit])]
                  [committed-pools : AstNodePoolContext
                    (if checked-detach?
                      (compiler-lower-checked-dest-pools-current)
                      detached-pools)]
                  [_disable-late-detach : unit
                    (if checked-detach?
                      (lower-checked-dest-pools-deactivate-after-commit!)
                      unit)]
                  [_detach-profile-finish : unit
                    (if checked-detach?
                      (cfg
                        compile-profile
                        (compiler-lower-profile-finish "macro_detach"))
                      unit)]
                  (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools-and-source-names
                    detached-entry-path
                    detached-program
                    detached-paths
                    mode
                    stdlib-roots
                    detached-cache-scope
                    committed-pools
                    source-names)))]
            [(ResultMacroExpand.Err diag)
              (begin
                (cfg
                  compile-profile
                  (compiler-lower-profile-finish "macro_expand"))
                (ResultCompilerLower.Err
                  (box
                    (compiler-diagnostic-copy
                      (lower-diagnostic-with-path
                        (box-get diag)
                        macro-entry-path)))))]))]
      [(ResultGenProgramWithPaths.Err diag)
        (begin
          (cfg compile-profile (compiler-lower-profile-finish "macro_expand"))
          (ResultCompilerLower.Err
            (box (lower-diagnostic-with-path (box-get diag) entry-path))))])))

;; Serial/test compatibility adapter. Driver-owned compilation uses the
;; explicit load-state entry above.
(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state
    (compiler-load-serial-test-session-state)
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    pools
    source-names))

(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(define (lower-compiler-program-with-decl-paths-mode
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache
    entry-path
    program
    paths
    mode
    (svec.new)
    (tc-prefix-default-cache-scope)))

(define (lower-compiler-program-with-decl-paths
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode
    entry-path
    program
    paths
    (CompilerLowerMode.Scalar)))

(define (lower-compiler-program [program : AstProgram]) : ResultCompilerLower
  (lower-compiler-program-with-path "<source>" program))

(define (lower-compiler-source [src : String]) : ResultCompilerLower
  (lower-compiler-source-with-path "<source>" src))

(define (lower-compiler-source-with-mode
  [src : String]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode "<source>" src mode))

(define (lower-source-decls-define-module?
  [decls : AstDeclList]
  [module : String]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (match decl
        [(AstDecl.Module name)
          (if (string.eq (tc-env-key-name-text name) module)
            true
            (lower-source-decls-define-module? rest module))]
        [_ (lower-source-decls-define-module? rest module)])]))

(define (lower-source-stdlib-import-needs-loader?
  [all-decls : AstDeclList]
  [kind : AstImportKind]
  [path : String]) : bool
  (if (typecheck-compiler-source-stdlib-import-kind? kind path)
    (match kind
      [(AstImportKind.Module)
        (not (lower-source-decls-define-module? all-decls path))]
      [_ true])
    false))

(define (lower-source-node-has-import-call?
  [pools : AstNodePoolContext]
  [id : i64]) : bool
  (lower-source-expr-has-import-call?
    pools
    (ast-node-pool-context-expr-get pools id)))

(define (lower-source-expr-list-has-import-call?
  [pools : AstNodePoolContext]
  [exprs : AstExprList]) : bool
  (lower-source-expr-list-has-import-call-at? pools (& exprs) 0))

(define (lower-source-expr-list-has-import-call-at?
  [pools : AstNodePoolContext]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-source-node-has-import-call?
        pools
        (ast-expr-list-get exprs index 0))
      (lower-source-expr-list-has-import-call-at? pools exprs (+ index 1)))))

(define (lower-source-let-bindings-have-import-call?
  [pools : AstNodePoolContext]
  [bindings : AstLetBindingList]) : bool
  (lower-source-let-bindings-have-import-call-at? pools (& bindings) 0))

(define (lower-source-let-bindings-have-import-call-at?
  [pools : AstNodePoolContext]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-let-binding-list-len bindings))
    false
    (or
      (match (ast-let-binding-list-get
        bindings
        binding-index
        (ast-let-binding-fallback))
        [(AstLetBinding.Binding _ _ init-box)
          (lower-source-node-has-import-call? pools init-box)])
      (lower-source-let-bindings-have-import-call-at?
        pools
        bindings
        (+ binding-index 1)))))

(define (lower-source-match-arms-have-import-call?
  [pools : AstNodePoolContext]
  [arms : AstMatchArmList]) : bool
  (lower-source-match-arms-have-import-call-at? pools (& arms) 0))

(define (lower-source-match-arms-have-import-call-at?
  [pools : AstNodePoolContext]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (or
          (lower-source-node-has-import-call? pools body-box)
          (lower-source-match-arms-have-import-call-at? pools arms (+ index 1)))])))

(define (lower-source-resource-bindings-have-import-call?
  [pools : AstNodePoolContext]
  [bindings : AstResourceBindingList]) : bool
  (lower-source-resource-bindings-have-import-call-at? pools (& bindings) 0))

(define (lower-source-resource-bindings-have-import-call-at?
  [pools : AstNodePoolContext]
  [bindings : (& bindings AstResourceBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-resource-binding-list-len bindings))
    false
    (or
      (match (ast-resource-binding-list-get
        bindings
        binding-index
        (ast-resource-binding-fallback))
        [(AstResourceBinding.Binding _ acquire-box cleanup-box _)
          (or
            (lower-source-node-has-import-call? pools acquire-box)
            (lower-source-node-has-import-call? pools cleanup-box))])
      (lower-source-resource-bindings-have-import-call-at?
        pools
        bindings
        (+ binding-index 1)))))

(define (lower-source-call-head-import?
  [pools : AstNodePoolContext]
  [func-box : i64]) : bool
  (match (ast-expr-unspan-with-pools
    pools
    (ast-node-pool-context-expr-get pools func-box))
    [(AstExpr.Var name) (= name cbi.compiler-builtin-id-fix-import)]
    [_ false]))

(define (lower-source-expr-has-import-call?
  [pools : AstNodePoolContext]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Call func-box args)
      (or
        (lower-source-call-head-import? pools func-box)
        (lower-source-node-has-import-call? pools func-box)
        (lower-source-expr-list-has-import-call? pools args))]
    [(AstExpr.BracketClause items)
      (lower-source-expr-list-has-import-call? pools items)]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(AstExpr.Unary _ inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-source-node-has-import-call? pools cond-box)
        (lower-source-node-has-import-call? pools then-box)
        (lower-source-node-has-import-call? pools else-box))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-source-let-bindings-have-import-call? pools bindings)
            (lower-source-node-has-import-call? pools body-box))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (lower-source-node-has-import-call? pools body-box)])]
    [(AstExpr.Tuple exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(AstExpr.TupleRef tuple-box index-box)
      (or
        (lower-source-node-has-import-call? pools tuple-box)
        (lower-source-node-has-import-call? pools index-box))]
    [(AstExpr.Array exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(AstExpr.DynArray exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(AstExpr.MakeArray _ len-box)
      (lower-source-node-has-import-call? pools len-box)]
    [(AstExpr.ArrayRef array-box index-box)
      (or
        (lower-source-node-has-import-call? pools array-box)
        (lower-source-node-has-import-call? pools index-box))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (or
        (lower-source-node-has-import-call? pools array-box)
        (lower-source-node-has-import-call? pools index-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(AstExpr.ArrayPush array-box value-box)
      (or
        (lower-source-node-has-import-call? pools array-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(AstExpr.StringRef string-box index-box)
      (or
        (lower-source-node-has-import-call? pools string-box)
        (lower-source-node-has-import-call? pools index-box))]
    [(AstExpr.While cond-box body-box)
      (or
        (lower-source-node-has-import-call? pools cond-box)
        (lower-source-node-has-import-call? pools body-box))]
    [(AstExpr.Begin exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(AstExpr.Set _ rhs-box) (lower-source-node-has-import-call? pools rhs-box)]
    [(AstExpr.Ann inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Cast inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Borrow _ _ inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (or
            (lower-source-node-has-import-call? pools scrutinee-box)
            (lower-source-match-arms-have-import-call? pools arms))])]
    [(AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(AstForeach.Foreach _ _ start-box end-box body-box)
          (or
            (lower-source-node-has-import-call? pools start-box)
            (lower-source-node-has-import-call? pools end-box)
            (lower-source-node-has-import-call? pools body-box))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (or
            (lower-source-node-has-import-call? pools start-box)
            (lower-source-node-has-import-call? pools end-box)
            (lower-source-node-has-import-call? pools init-box)
            (lower-source-node-has-import-call? pools value-box))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            init-box
            _
            value-box
            body-box
            _)
          (or
            (lower-source-node-has-import-call? pools start-box)
            (lower-source-node-has-import-call? pools end-box)
            (lower-source-node-has-import-call? pools init-box)
            (lower-source-node-has-import-call? pools value-box)
            (lower-source-node-has-import-call? pools body-box))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (or
        (lower-source-node-has-import-call? pools value-box)
        (lower-source-node-has-import-call? pools lane-box))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (or
        (lower-source-node-has-import-call? pools value-box)
        (lower-source-node-has-import-call? pools lane-box))]
    [(AstExpr.StructGet target-box _)
      (lower-source-node-has-import-call? pools target-box)]
    [(AstExpr.StructSet target-box _ value-box)
      (or
        (lower-source-node-has-import-call? pools target-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(AstExpr.WithRegion _ exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(AstExpr.WithEscape escape-box exprs)
      (or
        (lower-source-node-has-import-call? pools escape-box)
        (lower-source-expr-list-has-import-call? pools exprs))]
    [(AstExpr.WithScratch exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(AstExpr.InArena arena-box exprs)
      (or
        (lower-source-node-has-import-call? pools arena-box)
        (lower-source-expr-list-has-import-call? pools exprs))]
    [(AstExpr.WithResource resource-box)
      (match (box-get resource-box)
        [(AstWithResource.WithResource bindings body)
          (or
            (lower-source-resource-bindings-have-import-call? pools bindings)
            (lower-source-expr-list-has-import-call? pools body))])]
    [(AstExpr.Box inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.BoxGet inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.BoxTake inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.BoxSet inner-box value-box)
      (or
        (lower-source-node-has-import-call? pools inner-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(AstExpr.Comptime inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Quote inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Quasiquote inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Unquote inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.UnquoteSplicing inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Try inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Return inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.PtrNullCheck inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.PtrRead inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.PtrWrite pointer-box value-box)
      (or
        (lower-source-node-has-import-call? pools pointer-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(AstExpr.PtrOffset pointer-box offset-box)
      (or
        (lower-source-node-has-import-call? pools pointer-box)
        (lower-source-node-has-import-call? pools offset-box))]
    [(AstExpr.PtrCast inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.PtrToInt inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.IntToPtr inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.StringData inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.StringFromBytes data-box len-box)
      (or
        (lower-source-node-has-import-call? pools data-box)
        (lower-source-node-has-import-call? pools len-box))]
    [(AstExpr.ArrayData inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.CpuIdEax left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(AstExpr.CpuIdEbx left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(AstExpr.CpuIdEcx left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(AstExpr.CpuIdEdx left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(AstExpr.Xgetbv inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(AstExpr.Syscall exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [_ false]))

(define (lower-source-decl-needs-loader?
  [pools : AstNodePoolContext]
  [decl : AstDecl]
  [all-decls : AstDeclList]) : bool
  (match decl
    [(AstDecl.Import decl-meta (AstImportSpec.Spec kind path _ _ _))
      (lower-source-stdlib-import-needs-loader? all-decls kind path)]
    [(AstDecl.DefMacro decl-meta _ _ ret body-box)
      (and
        (tc-macro-result-decl-emitting? ret)
        (lower-source-node-has-import-call? pools body-box))]
    [(AstDecl.Unsafe inner-box)
      (lower-source-decl-needs-loader? pools (box-get inner-box) all-decls)]
    [_ false]))

(define (lower-source-decls-need-loader?
  [pools : AstNodePoolContext]
  [decls : AstDeclList]
  [all-decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (lower-source-decl-needs-loader? pools decl all-decls)
        (lower-source-decls-need-loader? pools rest all-decls))]))

(define (lower-source-program-needs-loader? [program : AstProgram]) : bool
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        [pools : AstNodePoolContext (ast-node-pool-context-capture-active)]
        (lower-source-decls-need-loader? pools decls decls))]))

(define (lower-compiler-source-with-path-mode
  [path : String]
  [src : String]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (begin
    ;; Each standalone single-source compile (smoke self-tests, emit-source,
    ;; check tools) runs in a fresh arena, so interned name strings from a
    ;; previous compile are freed. Reset the persistent intern table here so a
    ;; later compile never probes a dangling key. The multi-file driver compiles
    ;; through the loader, not this entry, so cli.tl's fixpoint is unaffected.
    (lower-reset-file-state!)
    (compiler-typecheck-reset-file-state!)
    (intern-reset!)
    (lower-reset-intern-owned-state!)
    (cbi.compiler-builtin-reset!)
    (match (parse-ast-source src)
      [(ResultAstProgram.Ok program)
        (if (lower-source-program-needs-loader? program)
          (let
            [stdlib-roots : svec.Vec (svec.new)]
            [cfgs : sym_i64_env.SymI64Env
              (typecheck-compiler-source-language-cfgs)]
            (match (typecheck-compiler-source-load src)
              [(ResultCompilerLoadWithPaths.Ok decls paths _ _)
                (lower-compiler-program-with-decl-paths-mode-cache
                  path
                  (ast-program decls)
                  paths
                  mode
                  stdlib-roots
                  (compiler-typecheck-prefix-cache-scope
                    "typecheck-prefix-lower"
                    stdlib-roots
                    cfgs))]
              [(ResultCompilerLoadWithPaths.Err diag)
                (ResultCompilerLower.Err diag)]))
          (lower-compiler-program-with-path-mode path program mode))]
      [(ResultAstProgram.Err message)
        (ResultCompilerLower.Err
          (box (lower-diagnostic-with-path (lower-diagnostic message) path)))])))

(define (lower-compiler-source-with-path [path : String] [src : String]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode path src (CompilerLowerMode.Scalar)))

(define (compiler-lower-smoke-source) : String
  "(extern (print-i64 [arg0 : i64]) : unit)
(define answer : i64 40)
(define (inc [x : i64]) : i64 (+ x 1))
(define (main [flag : bool]) : i64
  (let
    [x : i64 (inc answer)]
    (begin
      (set! x (+ x 1))
      (while (< x 45)
        (set! x (+ x 1)))
      (if flag x 0))))")

(define (compiler-lower-export-source) : String
  "(define answer : i64 42)
(define (main) : i64 answer)")

(define (compiler-lower-macro-expand-source) : String
  "(defmacro (and2 [lhs : bool] [rhs : bool]) : bool
  (expr-if lhs rhs (expr-bool false)))
(define (main) : i64 (if (and2 true true) 1 0))")

(define (compiler-lower-macro-expr-clause-source) : String
  "(defmacro (pick [arm : ExprClause]) : i64
  `(if ,(expr-clause-first arm) ,(expr-clause-second arm) 0))
(define (main) : i64 (pick [true 7]))")

(define (compiler-lower-macro-expr-clause-variadic-source) : String
  "(defmacro (pick-first [arms : ExprClause ...]) : i64
  `(pick-first-from 0 ,@(expr-clause-list->expr-list arms)))
(defmacro (pick-first-from [idx : Expr] [arms : ExprClause ...]) : i64
  (match idx
    [(Expr.Int i)
      (if (>= i (expr-clause-list-length arms))
        (expr-int 0)
        (let
          [arm : ExprClause (expr-clause-list-nth arms i)]
          `(if ,(expr-clause-first arm)
             ,(expr-clause-second arm)
             (pick-first-from
               ,(expr-int (+ i 1))
               ,@(expr-clause-list->expr-list arms)))))]
    [_ (expr-int 0)]))
(define (main) : i64 (pick-first [false 1] [true 9] [true 3]))")

(define (compiler-lower-macro-expr-clause-to-expr-error-source) : String
  "(defmacro (id [x : Expr]) : i64 x)
(define (main) : i64 (id [true 1]))")

(define (compiler-lower-macro-expr-to-clause-error-source) : String
  "(defmacro (need [arm : ExprClause]) : i64
  (expr-clause-second arm))
(define (main) : i64 (need 1))")

(define (compiler-lower-macro-expr-clause-shape-error-source) : String
  "(defmacro (need [arm : ExprClause]) : i64
  (expr-clause-second arm))
(define (main) : i64 (need [true 1 2]))")

(define (compiler-lower-bracket-ordinary-call-error-source) : String
  "(define (take [x : i64]) : i64 x)
(define (main) : i64 (take [true 1]))")

(define (compiler-lower-macro-arity-source) : String
  "(defmacro (and2 [lhs : bool] [rhs : bool]) : bool
  (expr-if lhs rhs (expr-bool false)))
(define (main) : i64 (if (and2 true) 1 0))")

(define (compiler-lower-macro-hygiene-definition-source) : String
  "(define (macro-helper [x : bool]) : bool (not x))
(defmacro (unless2 [condition : bool] [body : unit]) : unit
  `(if (macro-helper ,condition)
     ,body
     unit))
(define (main) : unit
  (let [macro-helper : bool true]
    (unless2 false unit)))")

;; A fixed-array literal `(array ...)`: it type-checks to `(Array i64 N)` and now
;; lowers to inline storage with each element stored at its offset, returning the
;; storage pointer (the same representation `array-ref`/`array-set!` index off).
(define (compiler-lower-array-literal-source) : String
  "(define (main) : i64
  (let [a : (Array i64 3) (array 1 2 3)]
    (array-ref a 2)))")

(define (compiler-lower-fixed-array-aggregate-literal-source) : String
  "(defstruct Pair (x i64) (y i64))
(define (main) : i64
  (let
    [items : (Array Pair 2) (array (Pair 1 2) (Pair 3 4))]
    (struct-get (array-ref items 1) y)))")

(define (compiler-lower-fixed-array-return-source) : String
  "(define (main) : (Array i64 3)
  (array 1 2 3))")

(define (compiler-lower-box-source) : String
  "(define (main) : i64 (box-get (box 7)))")

(define (compiler-lower-box-get-source) : String
  "(define (main [b : (Box i64)]) : i64 (box-get b))")

(define (compiler-lower-reference-source) : String
  "(define (take [r : (& n i64)]) : unit unit)
(define (main [n : i64]) : unit
  (take (& n)))")

(define (compiler-lower-reference-auto-borrow-source) : String
  "(define (take [r : (& n i64)]) : unit unit)
(define (main [n : i64]) : unit
  (take n))")

(define (compiler-lower-reference-mut-dotted-field-source) : String
  "(defstruct Inner (value i64))
(defstruct World (inner Inner))
(define (set-inner [inner : (&mut inner Inner)]) : unit
  (set! (struct-get inner value) 8))
(define (main) : i64
  (let [w : World (World (Inner 7))]
    (begin
      (set-inner (&mut w.inner))
      (struct-get (struct-get w inner) value))))")

(define (compiler-lower-reference-return-source) : String
  "(define (ref-return [n : i64]) : (& n i64) (& n))
(define (ref-id [r : (& n i64)]) : (& n i64) r)
(define (make-ref-tuple [n : i64]) : (Tuple (& n i64) i64)
  (tuple (& n) 7))
(define (make-ref-array [n : i64]) : (Array (& n i64) 1)
  (array (& n)))
(define (main [n : i64]) : i64
  (let
    [pair : (Tuple (& n i64) i64) (tuple (& n) 7)]
    [items : (Array (& n i64) 1) (array (& n))]
    (begin
      (ref-id (ref-return n))
      (make-ref-tuple n)
      (make-ref-array n)
      (tuple-ref pair 1)
      (array-ref items 0)
      42)))")

(define (compiler-lower-reference-place-source) : String
  "(defstruct Pair (left i64) (right i64))
(define (borrow-pair [p : Pair]) : (& p i64)
  (& (struct-get p left)))
(define (borrow-tuple [t : (Tuple i64 bool)]) : (& t i64)
  (& (tuple-ref t 0)))
(define (borrow-array [items : (Array i64 2)]) : (& items i64)
  (& (array-ref items 0)))
(define (main) : i64
  (let
    [p : Pair (Pair 40 2)]
    [t : (Tuple i64 bool) (tuple 41 true)]
    [items : (Array i64 2) (array 42 7)]
    (begin
      (borrow-pair p)
      (borrow-tuple t)
      (borrow-array items)
      42)))")

(define (compiler-lower-reference-inline-struct-field-source) : String
  "(defstruct Inner (name String) (line i64))
(defstruct Outer (prefix i64) (inner Inner))
(define (take-inner [inner : (& inner Inner)]) : i64
  (struct-get inner line))
(define (main [outer : Outer]) : i64
  (take-inner (& (struct-get outer inner))))")

(define (compiler-lower-reference-struct-result-source) : String
  "(defstruct RefBox
  (:lifetimes text)
  (borrowed (& text str))
  (owned String)
  (is-owned bool))
(define (ref-box-borrowed [text : (& text str)] [owned : String]) : (RefBox text)
  (RefBox text owned false))
(define (ref-box-owned [text : (& text str)] [owned : String]) : (RefBox text)
  (RefBox text owned true))
(define (ref-box-length [item : (RefBox text)]) : i64
  (if (struct-get item is-owned)
    (__tl_string_length (struct-get item owned))
    (__tl_string_length (struct-get item borrowed))))
(define (main [text : String] [owned : String]) : i64
  (let
    [borrowed : (RefBox text) (ref-box-borrowed (& text) owned)]
    [owned-box : (RefBox text) (ref-box-owned (& text) owned)]
    (+ (ref-box-length borrowed) (ref-box-length owned-box))))")

(define (compiler-lower-reference-struct-multi-result-source) : String
  "(defstruct ReplaceResult
  (:lifetimes text old replacement)
  (borrowed (& text str))
  (old-text (& old str))
  (replacement-text (& replacement str))
  (owned String)
  (is-owned bool))
(define (replace-borrowed
  [text : (& text str)]
  [old : (& old str)]
  [replacement : (& replacement str)]
  [owned : String]) : (ReplaceResult text old replacement)
  (ReplaceResult text old replacement owned false))
(define (replace-owned
  [text : (& text str)]
  [old : (& old str)]
  [replacement : (& replacement str)]
  [owned : String]) : (ReplaceResult text old replacement)
  (ReplaceResult text old replacement owned true))
(define (replace-score [item : (ReplaceResult text old replacement)]) : i64
  (+
    (__tl_string_length (struct-get item old-text))
    (+
      (__tl_string_length (struct-get item replacement-text))
      (if (struct-get item is-owned)
        (__tl_string_length (struct-get item owned))
        (__tl_string_length (struct-get item borrowed))))))
(define (main [text : String] [old : String] [replacement : String] [owned : String]) : i64
  (let
    [borrowed : (ReplaceResult text old replacement)
      (replace-borrowed (& text) (& old) (& replacement) owned)]
    [owned-result : (ReplaceResult text old replacement)
      (replace-owned (& text) (& old) (& replacement) owned)]
    (+ (replace-score borrowed) (replace-score owned-result))))")

(define (compiler-lower-reference-enum-result-source) : String
  "(defenum RefChoice
  (:lifetimes text)
  (RefChoiceBorrowed (& text str))
  (RefChoiceOwned String))
(define (borrowed-choice [text : (& text str)]) : (RefChoice text)
  (RefChoiceBorrowed text))
(define (owned-choice [text : (& text str)] [owned : String]) : (RefChoice text)
  (RefChoiceOwned owned))
(define (choice-length [choice : (RefChoice text)]) : i64
  (match choice
    [(RefChoiceBorrowed value) (__tl_string_length value)]
    [(RefChoiceOwned value) (__tl_string_length value)]))
(define (choice-loop [choice : (RefChoice text)] [count : i64]) : i64
  (match choice
    [(RefChoiceBorrowed value)
      (if (> count 0)
        (choice-loop (RefChoiceBorrowed value) (- count 1))
        (__tl_string_length value))]
    [(RefChoiceOwned value) (__tl_string_length value)]))
(define (main [text : String] [owned : String]) : i64
  (+
    (choice-length (borrowed-choice (& text)))
    (choice-loop (owned-choice (& text) owned) 1)))")

(define (compiler-lower-function-value-source) : String
  "(define (inc [x : i64]) : i64 (+ x 1))
(define (apply1 [f : (-> i64 i64)] [x : i64]) : i64
  (f x))
(define (shadow-inc [inc : (-> i64 i64)] [x : i64]) : i64
  (inc x))
(define (main) : i64
  (+ (apply1 inc 41) (shadow-inc inc 1)))")

(define (compiler-lower-function-value-contextual-init-source) : String
  "(define (inc [x : i64]) : i64 (+ x 1))
(define (main) : i64
  (let
    [f : (-> i64 i64) inc]
    (f (init))))")

(define (compiler-lower-noncapturing-lambda-value-source) : String
  "(define (get-fn) : (-> i64 i64)
  (lambda ([x : i64]) : i64 (+ x 1)))")

(define (compiler-lower-immediate-lambda-call-source) : String
  "(define (main) : i64
  ((lambda ([x : i64]) : i64 (+ x 1)) 41))")

(define (compiler-lower-unit-lambda-call-source) : String
  "(extern (print-i64 [arg0 : i64]) : unit)
(define (main) : unit
  ((lambda () : unit (print-i64 1))))")

(define (compiler-lower-capturing-lambda-scalar-source) : String
  "(define (main) : i64
  (let
    [n : i64 10]
    ((lambda ([x : i64]) : i64 (+ x n)) 32)))")

(define (compiler-lower-capturing-lambda-function-value-source) : String
  "(define (main) : i64
  (let
    [inc : (-> i64 i64) (lambda ([x : i64]) : i64 (+ x 1))]
    [n : i64 9]
    ((lambda ([x : i64]) : i64 (inc (+ x n))) 32)))")

(define (compiler-lower-capturing-lambda-fat-handle-source) : String
  "(define (main [n : i64]) : i64
  (let
    [s : String \"hello\"]
    [a : (Array i64) (make-array i64 2)]
    (begin
      (array-set! a 0 n)
      ((lambda () : i64 (+ (__tl_string_length s) (array-ref a 0)))))))")

(define (compiler-lower-capturing-lambda-aggregate-source) : String
  "(defstruct Point (x i64) (y i64))
(defenum Shape (Rect i64 i64) (None))
(define (main) : i64
  (let
    [t : (Tuple i64 i64) (tuple 5 99)]
    [p : Point (Point 7 1)]
    [a : (Array i64 2) (array 3 10)]
    [s : Shape (Rect 4 5)]
    ((lambda () : i64
       (+
         (tuple-ref t 0)
         (+
           (struct-get p x)
           (+
             (array-ref a 1)
             (match s
               [(Rect w h) (* w h)]
               [(None) 0]))))))))")

(define (compiler-lower-capturing-lambda-shadow-source) : String
  "(define (main) : i64
  (let
    [n : i64 10]
    ((lambda ([x : i64]) : i64
       (+
         n
         (let
           [n : i64 100]
           (+ x n))))
     32)))")

(define (compiler-lower-capturing-lambda-reference-source) : String
  "(define (main [n : i64]) : i64
  (let [r : (& n i64) (& n)]
    (let [f : (-> i64) (lambda () : i64 (let [copy : (& n i64) r] 42))]
      (f))))")

(define (compiler-lower-capturing-lambda-reference-immediate-source) : String
  "(define (main [n : i64]) : i64
  (let [r : (& n i64) (& n)]
    ((lambda () : i64 (let [copy : (& n i64) r] 42)))))")

;; `(comptime expr)` folds to a literal via the scalar CTFE evaluator.
;; These fixtures exercise arithmetic, f64, `if`, and `let` folds, plus the
;; runtime-variable rejection path.
(define (compiler-lower-comptime-arith-source) : String
  "(define (main) : i64 (comptime (+ 1 2)))")

(define (compiler-lower-comptime-if-source) : String
  "(define (main) : i64 (comptime (if (< 1 2) (* 6 7) 0)))")

(define (compiler-lower-comptime-let-source) : String
  "(define (main) : i64 (comptime (let [x 40] (+ x 2))))")

(define (compiler-lower-comptime-runtime-var-source) : String
  "(define (main [x : i64]) : i64 (comptime x))")

(define (compiler-lower-comptime-f64-source) : String
  "(define (main) : f64 (comptime 1.5))")

(define (compiler-lower-comptime-f32-source) : String
  "(define (main) : f32 (comptime (cast 1.00000001 : f32)))")

(define (compiler-lower-duplicate-function-source) : String
  "(define (dup) : i64 1)
(define (dup) : i64 2)
(define (main) : i64 (dup))")

(define (compiler-lower-defdispatch-source) : String
  "(define (dot-scalar [x : i64]) : i64 x)
(define (dot-avx2 [x : i64]) : i64 (+ x 2))
(define (dot-avx512 [x : i64]) : i64 (+ x 5))
(defdispatch dot (scalar dot-scalar) (avx2 dot-avx2) (avx512 dot-avx512))
(define (main [x : i64]) : i64 (dot x))")

(define (compiler-lower-defdispatch-shared-helper-source) : String
  "(define (dispatch-helper [x : i64]) : i64 (+ x 1))
(define (dot-scalar [x : i64]) : i64 (dispatch-helper x))
(define (dot-avx2 [x : i64]) : i64 (+ (dispatch-helper x) 2))
(define (dot-avx512 [x : i64]) : i64 (+ (dispatch-helper x) 5))
(defdispatch dot (scalar dot-scalar) (avx2 dot-avx2) (avx512 dot-avx512))
(define (main [x : i64]) : i64 (dot x))")

(define (compiler-lower-error-ok? [src : String] [want : String]) : bool
  (match (lower-compiler-source src)
    [(ResultCompilerLower.Err diag)
      (string.eq (compiler-diagnostic-message (box-get diag)) want)]
    [(ResultCompilerLower.Ok _ _) false]))

(define (compiler-lower-maybe-span-start-ok?
  [found-span : CompilerMaybeSourceSpan]
  [line : i64]
  [col : i64]) : bool
  (match found-span
    [(CompilerMaybeSourceSpan.Some found)
      (and
        (= (ast-source-span-start-line found) line)
        (= (ast-source-span-start-col found) col))]
    [(CompilerMaybeSourceSpan.No) false]))

(define (compiler-lower-nested-expression-diagnostic-span-ok?) : bool
  (let
    [span : AstSourceSpan (ast-source-span 11 3 11 9)]
    [value-id : i64 (ci.intern-generated-name "value")]
    [inner : i64 (ast-node-push (AstExpr.Var value-id))]
    [spanned-inner : i64 (ast-expr-spanned inner span)]
    [wrapped : i64 (ast-expr-cast spanned-inner (AstType.I64))]
    [diag : CompilerDiagnostic
      (lower-diagnostic-at-expr
        (ast-node-get wrapped)
        "lower: nested expression diagnostic")]
    [found-span : CompilerMaybeSourceSpan
      (lower-ast-expr-span (ast-node-get (ast-expr-return spanned-inner)))]
    [diag-ok : bool
      (and
        (string.eq
          (compiler-diagnostic-message diag)
          "lower: nested expression diagnostic")
        (= (compiler-diagnostic-line diag) 11)
        (= (compiler-diagnostic-col diag) 3))]
    [span-ok : bool (compiler-lower-maybe-span-start-ok? found-span 11 3)]
    (and diag-ok span-ok)))

(define (compiler-lower-compound-expression-diagnostic-span-ok?) : bool
  (let
    [span : AstSourceSpan (ast-source-span 17 5 17 12)]
    [compound-value-id : i64 (ci.intern-generated-name "compound-value")]
    [a-id : i64 (ci.intern-generated-name "a")]
    [b-id : i64 (ci.intern-generated-name "b")]
    [i-id : i64 (ci.intern-generated-name "i")]
    [prefix-id : i64 (ci.intern-generated-name "prefix")]
    [plain : i64 (ast-node-push (AstExpr.Literal AstLiteral.Unit))]
    [inner : i64 (ast-node-push (AstExpr.Var compound-value-id))]
    [spanned-inner : i64 (ast-expr-spanned inner span)]
    [items : AstExprList
      (ast-expr-cons plain (ast-expr-cons spanned-inner (ast-expr-list-new)))]
    [bindings : AstLetBindingList
      (ast-let-binding-cons
        (ast-let-binding-id a-id (AstMaybeType.No) plain)
        (ast-let-binding-cons
          (ast-let-binding-id b-id (AstMaybeType.No) spanned-inner)
          (ast-let-binding-list-new)))]
    [arms : AstMatchArmList
      (ast-match-arm-cons
        (ast-match-arm (AstPattern.Wildcard) plain)
        (ast-match-arm-cons
          (ast-match-arm (AstPattern.Wildcard) spanned-inner)
          (ast-match-arm-list-new)))]
    [resources : AstResourceBindingList
      (ast-resource-binding-cons
        (ast-resource-binding-id a-id plain plain)
        (ast-resource-binding-cons
          (ast-resource-binding-id b-id spanned-inner plain)
          (ast-resource-binding-list-new)))]
    [ok : bool true]
    (begin
      (unless
        (compiler-lower-maybe-span-start-ok?
          (lower-ast-expr-span
            (AstExpr.Binary (AstBinOp.Add) plain spanned-inner))
          17
          5)
        (set! ok false))
      (unless
        (compiler-lower-maybe-span-start-ok?
          (lower-ast-expr-span (AstExpr.Call plain items))
          17
          5)
        (set! ok false))
      (unless
        (compiler-lower-maybe-span-start-ok?
          (lower-ast-expr-span (AstExpr.If plain plain spanned-inner))
          17
          5)
        (set! ok false))
      (unless
        (compiler-lower-maybe-span-start-ok?
          (lower-ast-expr-span (AstExpr.Let (box (AstLet.Let bindings plain))))
          17
          5)
        (set! ok false))
      (unless
        (compiler-lower-maybe-span-start-ok?
          (lower-ast-expr-span
            (AstExpr.Match (box (AstMatch.Match plain arms))))
          17
          5)
        (set! ok false))
      (unless
        (compiler-lower-maybe-span-start-ok?
          (lower-ast-expr-span
            (AstExpr.WithResource
              (box (AstWithResource.WithResource resources items))))
          17
          5)
        (set! ok false))
      (unless
        (compiler-lower-maybe-span-start-ok?
          (lower-ast-expr-span
            (AstExpr.SpmdScan
              (box
                (AstSpmdScan.Scan
                  (AstReduceOp.Sum)
                  i-id
                  (AstType.I64)
                  plain
                  plain
                  prefix-id
                  (AstType.I64)
                  plain
                  plain
                  spanned-inner))))
          17
          5)
        (set! ok false))
      (unless
        (compiler-lower-maybe-span-start-ok?
          (lower-ast-expr-span (AstExpr.Syscall items))
          17
          5)
        (set! ok false))
      ok)))

(define (compiler-lower-mode-error-ok?
  [src : String]
  [mode : CompilerLowerMode]
  [want : String]) : bool
  (match (lower-compiler-source-with-mode src mode)
    [(ResultCompilerLower.Err diag)
      (string.eq (compiler-diagnostic-message (box-get diag)) want)]
    [(ResultCompilerLower.Ok _ _) false]))

(define (compiler-lower-inline-error-ok? [src : String] [want : String]) : bool
  (match (lower-compiler-source-with-mode
    src
    (CompilerLowerMode.InlineAggregates))
    [(ResultCompilerLower.Err diag)
      (string.eq (compiler-diagnostic-message (box-get diag)) want)]
    [(ResultCompilerLower.Ok _ _) false]))

(define (compiler-lower-windows-error-ok? [src : String] [want : String]) : bool
  (match (lower-compiler-source-with-mode src (CompilerLowerMode.WindowsScalar))
    [(ResultCompilerLower.Err diag)
      (string.eq (compiler-diagnostic-message (box-get diag)) want)]
    [(ResultCompilerLower.Ok _ _) false]))

(define (compiler-lower-entry-moduled-main-ok?) : bool
  (let
    [prev-active : bool lower-entry-main-module-active]
    [prev-module : String lower-entry-main-module]
    [prev-module-id : i64 lower-entry-main-module-id]
    [active-ok : bool false]
    (begin
      (lower-entry-main-selection-install!
        (LowerMaybeEntryMainModule.Some "app.main" 123))
      (set!
        active-ok
        (and
          (lower-decl-entry-main? "src/app.tl" "src/app.tl" "app.main" "main")
          (lower-decl-entry-main? "src\\app.tl" "src/app.tl" "app.main" "main")
          (not
            (lower-decl-entry-main? "src/app.tl" "src/lib.tl" "app.main" "main"))
          (not
            (lower-decl-entry-main?
              "src/app.tl"
              "src/app.tl"
              "app.main"
              "helper"))))
      (lower-entry-main-selection-restore!
        prev-active
        prev-module
        prev-module-id)
      (and
        active-ok
        (not
          (lower-decl-entry-main? "src/app.tl" "src/app.tl" "app.main" "main"))))))

;; Scalar match lowering smoke: an i64 literal match with a binding
;; catch-all (value-returning), an exhaustive bool match, and a unit-typed match.
(define (compiler-lower-match-source) : String
  "(extern (print-i64 [arg0 : i64]) : unit)
(define (classify [n : i64]) : i64
  (match n
    [0 100]
    [1 200]
    [other (+ other 1)]))
(define (flag-score [b : bool]) : i64
  (match b
    [true 1]
    [false 0]))
(define (sign [n : i64]) : i64
  (match n
    [0 0]
    [_ 1]))
(define (announce [n : i64]) : unit
  (match n
    [0 (print-i64 0)]
    [other (print-i64 other)]))
(define (main) : i64
  (begin
    (announce (classify 1))
    (+ (sign 7) (+ (classify 1) (flag-score true)))))")

;; Dynamic-array length lowering smoke: `array-length` and `length` on a
;; dynamic array lower to a fat-value length load rather than a runtime call.
(define (compiler-lower-array-length-source) : String
  "(define (dyn-len [a : (Array i64)]) : i64 (array-length a))
(define (dyn-len-alias [a : (Array i64)]) : i64 (length a))
(define (main) : i64 0)")

;; `array-ref`/`array-set!` lower to a bounds-checked typed element load/store.
;; Taking the array as a parameter avoids needing `make-array` here.
(define (compiler-lower-array-access-source) : String
  "(define (get [a : (Array i64)] [i : i64]) : i64 (array-ref a i))
(define (put [a : (Array i64)] [i : i64] [v : i64]) : unit (array-set! a i v))
(define (main) : i64 0)")

;; `array-take!` moves an element only when its companion liveness slot is
;; still true. The primitive returns a false availability flag for exhausted,
;; invalid, or already-taken positions instead of forming an out-of-bounds
;; address; its payload is then intentionally unspecified.
(define (compiler-lower-array-take-source) : String
  "(define (close-fd [fd : i64]) : unit unit)
(defstruct FileHandle
  (:cleanup cleanup-file-handle)
  (fd i64 (:cleanup close-fd)))
(define (take-item [items : (Array i64)] [live : (Array bool)] [i : i64]) : (Tuple bool i64)
  (array-take! items live i))
(define (take-handle [items : (Array FileHandle)] [live : (Array bool)] [i : i64]) : (Tuple bool FileHandle)
  (array-take! items live i))
(define (main [items : (Array i64)] [live : (Array bool)] [handles : (Array FileHandle)] [handle-live : (Array bool)] [i : i64]) : i64
  (begin
    (take-item items live i)
    (if (tuple-ref (take-handle handles handle-live i) 0) 1 0)))")

;; Fixed-array access lowers against inline array storage rather than the
;; dynamic-array fat `{ptr, len}` layout.
(define (compiler-lower-fixed-array-access-source) : String
  "(define (get [a : (Array i64 3)] [i : i64]) : i64 (array-ref a i))
(define (put [a : (Array i64 3)] [i : i64] [v : i64]) : unit (array-set! a i v))
(define (main) : i64 0)")

(define (compiler-lower-mut-ref-array-access-source) : String
  "(define (len [a : (& a (Array i64))]) : i64 (array-length a))
(define (get [a : (& a (Array i64))] [i : i64]) : i64 (array-ref a i))
(define (put [a : (&mut a (Array i64))] [i : i64] [v : i64]) : unit
  (array-set! a i v))
(define (grow [a : (&mut a (Array i64))] [v : i64]) : unit
  (array-push! a v))
(define (main) : i64 0)")

(define (compiler-lower-mut-ref-by-value-writeback-source) : String
  "(defstruct Pair (x i64) (y i64))
(define (set-pair-x! [p : (&mut p Pair)] [value : i64]) : unit
  (set! (struct-get p x) value))
(define (touch-scalar! [n : (&mut n i64)]) : unit unit)
(define (main) : i64
  (let
    [p : Pair (Pair 7 35)]
    [n : i64 41]
    (begin
      (set-pair-x! (&mut p) 40)
      (touch-scalar! (&mut n))
      42)))")

(define (compiler-lower-mut-ref-by-value-writeback-shape-ok?) : bool
  (match (lower-compiler-source
    (compiler-lower-mut-ref-by-value-writeback-source))
    [(ResultCompilerLower.Ok program _)
      (match program
        [(CompilerIrProgram.Program _ functions _)
          (and
            (= (lower-test-function-call-count functions "main" "tl_alloc") 0)
            (>= (lower-test-function-alloc-count functions "main") 2)
            (>= (lower-test-function-addr-of-count functions "main") 2)
            (>= (lower-test-function-load-count functions "main") 2))])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-lower-mut-ref-array-field-access-source) : String
  "(defstruct ArrayBag (items (Array i64)))
(defstruct ArrayBagHandle
  (:lifetimes bag)
  (items (&mut bag (Array i64)))
  (index i64))
(define (array-bag-handle [bag : (&mut bag ArrayBag)] [index : i64]) : (ArrayBagHandle bag)
  (ArrayBagHandle (&mut (struct-get bag items)) index))
(define (len [handle : (ArrayBagHandle bag)]) : i64
  (array-length (struct-get handle items)))
(define (get [handle : (ArrayBagHandle bag)]) : i64
  (array-ref (struct-get handle items) (struct-get handle index)))
(define (put [handle : (ArrayBagHandle bag)] [v : i64]) : unit
  (array-set! (struct-get handle items) (struct-get handle index) v))
(define (main) : i64 0)")

;; `array-push!` lowers to checked arena reallocation, a runtime-length copy,
;; a tail store, and in-place fat `{ptr, len}` updates.
(define (compiler-lower-array-push-source) : String
  "(define (grow [a : (Array i64)] [v : i64]) : unit (array-push! a v))
(define (main) : i64 0)")

;; Fixed arrays have no runtime capacity field and remain unsupported for push.
(define (compiler-lower-fixed-array-push-source) : String
  "(define (grow [a : (Array i64 3)] [v : i64]) : unit (array-push! a v))
(define (main) : i64 0)")

;; `make-array` lowers to checked byte-count math, a `tl_alloc` element buffer,
;; initialized elements, and a dynamic-array fat value. The fixture also
;; immediately uses `array-set!`, `array-ref`, and `array-length` so the
;; generated IR exercises the full dynamic-array primitive set.
(define (compiler-lower-make-array-source) : String
  "(define (main [n : u32]) : i64
  (let
    [a : (Array i64) (make-array i64 n)]
    (begin
      (array-set! a 0 40)
      (array-set! a 1 2)
      (+ (array-length a) (+ (array-ref a 0) (array-ref a 1))))))")

(define (compiler-lower-make-array-init-source) : String
  "(define (main [n : i64]) : i64
  (let
    [items : (Array String) (make-array String n)]
    (array-length items)))")

(define (compiler-lower-dyn-array-literal-source) : String
  "(define dyn-array-literal-trace : i64 0)
(define (side [value : i64]) : i64
  (begin
    (set! dyn-array-literal-trace (+ (* dyn-array-literal-trace 10) value))
    value))
(define (main) : i64
  (let
    [items : (Array i64) (make-array (side 1) (side 2) (side 3))]
    (+ (array-length items)
       (+ (array-ref items 0)
          (+ (array-ref items 1)
             (+ (array-ref items 2) dyn-array-literal-trace))))))")

(define (compiler-lower-make-array-register-resident-fill8-source) : String
  "(defstruct OneWord (value i64))
(define (main [n : i64]) : i64
  (let
    [items : (Array OneWord) (make-array OneWord n)]
    (array-length items)))")

;; Core and private string length lower to the same fat `{ptr, len}` length load
;; as `array-length`: both lay out the i64 length at offset 8.
(define (compiler-lower-string-length-source) : String
  "(define (str-len [s : String]) : i64 (__tl_string_length s))
(define (str-len-alias [s : String]) : i64 (__tl_string_length s))
(define (str-len-borrow [s : String]) : i64 (__tl_string_length (& s)))
(define (str-len-alias-borrow [s : String]) : i64 (__tl_string_length (& s)))
(define (core-str-len [s : String]) : i64 (length s))
(define (core-str-len-borrow [s : (& s str)]) : i64 (length s))
(define (main) : i64 0)")

(define (compiler-lower-float-bitcast-source) : String
  "(define (f64-bits [value : f64]) : u64 (__tl_float_to_bits value))
(define (f32-bits [value : f32]) : u32 (__tl_float_to_bits value))
(define (f64-from [bits : u64]) : f64 (__tl_float_from_bits bits))
(define (f32-from [bits : u32]) : f32 (__tl_float_from_bits bits))
(define (main) : i64 0)")

(define (compiler-lower-stdlib-string-wrapper-prune-source) : String
  "(module stdlib.string)
(define (string.string-length [text : (& text str)]) : i64 0)
(module stdlib.io)
(import stdlib.string)
(import stdlib.vector)
(define (io-len [text : String]) : i64 (string.string-length text))
(define (main) : i64 (io-len \"abc\"))")

(define (compiler-lower-stdlib-string-wrapper-prune-paths) : AstDeclPathList
  (ast-decl-root-path-cons
    "stdlib/string.tl"
    (ast-decl-root-path-cons
      "stdlib/string.tl"
      (ast-decl-root-path-cons
        "stdlib/string.tl"
        (ast-decl-root-path-cons
          "stdlib/tl"
          (ast-decl-root-path-cons
            "stdlib/tl"
            (ast-decl-root-path-cons
              "stdlib/tl"
              (ast-decl-root-path-cons "stdlib/tl" (ast-decl-path-list-new)))))))))

(define (compiler-lower-stdlib-string-wrapper-prune-ok?) : bool
  (match (parse-ast-source (compiler-lower-stdlib-string-wrapper-prune-source))
    [(ResultAstProgram.Ok program)
      (match (lower-compiler-program-with-decl-paths
        "stdlib/tl"
        program
        (compiler-lower-stdlib-string-wrapper-prune-paths))
        [(ResultCompilerLower.Ok lowered _)
          (match lowered
            [(CompilerIrProgram.Program _ functions _)
              (and
                (lower-test-function-defined? functions "tl::stdlib.io/io-len")
                (not
                  (lower-test-function-defined?
                    functions
                    "stdlib/string.tl::stdlib.string/string.string-length"))
                (not
                  (lower-test-function-defined?
                    functions
                    "string.tl::stdlib.string/string.string-length"))
                (not
                  (lower-test-function-defined?
                    functions
                    "stdlib/string.tl::stdlib.string/string-length"))
                (not
                  (lower-test-function-defined?
                    functions
                    "string.tl::stdlib.string/string-length")))])]
        [(ResultCompilerLower.Err _) false])]
    [(ResultAstProgram.Err _) false]))

(define (compiler-lower-string-runtime-source) : String
  "(define (io.print-string [text : String]) : unit
  unit)
(define (io.print-str [text : String]) : unit
  (io.print-string text))
(define (string.append [left : (& left str)] [right : (& right str)]) : String
  \"joined\")
(define (string.substring [text : (& text str)] [start : i64] [len : i64]) : String
  (let
    [probe : char (__tl_string_ref text start)]
    \"slice\"))
(define (string.concat [left : (& left str)] [right : (& right str)]) : String
  (string.append left right))
(define (main) : i64
  (let
    [left : String \"foo\"]
    [right : String \"bar\"]
    [joined : String (string.append (& left) (& right))]
    [mid : String (string.substring (& joined) 2 3)]
    [bang : String \"!\"]
    [extended : String (string.concat (& mid) (& bang))]
    [spaced : String \" x\"]
    [digits : String \"7\"]
    (begin
      (io.print-string joined)
      (io.print-str extended)
      (+ (__tl_string_length (& joined))
        (+ (__tl_string_length (& extended))
          (+ (__tl_string_to_int (& digits))
            (+ (if (__tl_string_eq (& joined) (& extended)) 1 0)
              (cast (__tl_string_ref (& spaced) 0) : i64))))))))")

(define (compiler-lower-string-concat-fusion-source) : String
  "(define (string.append [left : String] [right : String]) : String
  left)
(define (shadowed-tail) : String
  (string.append \"x\" \"y\"))
(define (main) : i64
  (let
    [three : String (string.append \"a\" (string.append \"b\" \"c\"))]
    [four : String
      (string.append \"a\" (string.append \"b\" (string.append \"c\" \"d\")))]
    [five : String
      (string.append
        \"a\"
        (string.append \"b\" (string.append \"c\" (string.append \"d\" \"e\"))))]
    (+ (__tl_string_length three)
      (+ (__tl_string_length four) (__tl_string_length five)))))")

(define (compiler-lower-print-string-stdlib-source) : String
  "(define (io.print-string [text : String]) : unit
  unit)
(define (io.print-str [text : String]) : unit
  (io.print-string text))
(define (main [text : String]) : i64
  (begin
    (io.print-string text)
    (io.print-str text)
    0))")

(define (compiler-lower-borrowed-str-param-source) : String
  "(define (borrowed-score [path : (& path str)]) : i64
  (__tl_string_length path))
(define (main [path : String]) : i64
  (borrowed-score (& path)))")

(define (compiler-lower-stdlib-hash-string-source) : String
  "(define (hash-string [key : (& key str)]) : i64
  (let
    [n : i64 (__tl_string_length key)]
    [i : i64 0]
    [hash : i64 0]
    (begin
      (while (< i n)
        (let
          [next : i64
            (+ (+ (* hash 131) (cast (__tl_string_ref key i) : i64)) 1)]
          [reduced : i64
            (+ (bit-and next 0x7fffffff) (shr next 31))]
          (begin
            (set!
              hash
              (if (>= reduced 0x7fffffff)
                (- reduced 0x7fffffff)
                reduced))
            (set! i (+ i 1)))))
      hash)))
(define (main [key : String]) : i64
  (+ (hash-string (& key)) 0))")

(define (compiler-lower-stdlib-hash-string-paths) : AstDeclPathList
  (ast-decl-root-path-cons
    "stdlib/hash.tl"
    (ast-decl-root-path-cons "app.tl" (ast-decl-path-list-new))))

(define (compiler-lower-string-shadow-source) : String
  "(define (string.string-length [s : String]) : i64 40)
(define (string.append [a : i64] [b : i64]) : i64 (+ a b))
(define (string.string-ref [a : i64] [b : i64]) : i64 (+ a b))
(define (string.char-at [a : i64] [b : i64]) : i64 (* a b))
(define (main) : i64
  (+ (string.string-length \"abc\")
    (+ (string.append 1 1)
      (+ (string.string-ref 10 7) (string.char-at 3 4)))))")

(define (compiler-lower-stdio-source) : String
  "(define stdin-eof-state : bool false)
(define (io.read-stdin-bytes [count : i64]) : String
  (let
    [buf : (Array u8) (make-array u8 count)]
    (unsafe (string-from-bytes (ptr-cast (array-data buf) : (Ptr u8)) count))))
(define (read-stdin-line) : String
  (let
    [buf : (Array u8) (make-array u8 0)]
    (unsafe (string-from-bytes (ptr-cast (array-data buf) : (Ptr u8)) 0))))
(define (stdin-eof?) : bool stdin-eof-state)
(define (flush-stdout) : unit unit)
(define (main) : i64
  (begin
    (flush-stdout)
    (if (stdin-eof?)
        (__tl_string_length (read-stdin-line))
        (__tl_string_length (io.read-stdin-bytes 3)))))")

(define (compiler-lower-stdio-builtin-source) : String
  "(define stdin-eof-state : bool false)
(define (io.read-stdin-bytes [count : i64]) : String
  (let
    [buf : (Array u8) (make-array u8 count)]
    (unsafe (string-from-bytes (ptr-cast (array-data buf) : (Ptr u8)) count))))
(define (read-stdin-line) : String
  (let
    [buf : (Array u8) (make-array u8 0)]
    (unsafe (string-from-bytes (ptr-cast (array-data buf) : (Ptr u8)) 0))))
(define (stdin-eof?) : bool stdin-eof-state)
(define (flush-stdout) : unit unit)
(define (main [count : i64]) : i64
  (begin
    (flush-stdout)
    (if (stdin-eof?)
        (__tl_string_length (read-stdin-line))
        (__tl_string_length (io.read-stdin-bytes count)))))")

(define (compiler-lower-env-builtin-source) : String
  "(define (var-exists? [name : String]) : bool true)
(define (var-value [name : String]) : String name)
(define (path-separator) : String \":\")
(define (main [name : String]) : i64
  (let
    [separator : String (path-separator)]
    [value : String (var-value name)]
    (if (var-exists? name)
      (+ (__tl_string_length value) (__tl_string_length separator))
      (__tl_string_length separator))))")

(define (compiler-lower-cpu-builtin-source) : String
  "(define (main) : i64
  (let
    [r : (Tuple i32 i32 i32 i32) (cpuid 0 0)]
    (+ (cast (tuple-ref r 0) : i64) (xgetbv 0))))")

(define (compiler-lower-fs-status-source) : String
  "(define (current-dir-status) : i64 0)
(define (current-dir) : String \".\")
(define (process-id) : i64 1)
(define (mkdir-status [path : String]) : i64 0)
(define (remove-file-status [path : String]) : i64 0)
(define (remove-dir-status [path : String]) : i64 0)
(define (rename-status [source : String] [destination : String]) : i64 0)
(define (read-dir-status [path : String]) : i64 0)
(define (read-dir [path : String]) : String path)
(define (file-kind-status [path : String]) : i64 0)
(define (file-size-status [path : String]) : i64 0)
(define (file-size [path : String]) : i64 (__tl_string_length path))
(define (main) : i64
  (+ (current-dir-status)
    (+ (__tl_string_length (current-dir))
      (+ (process-id)
        (+ (mkdir-status \"target/typelisp-fs\")
          (+ (remove-file-status \"target/typelisp-fs/artifact.o\")
            (+ (remove-dir-status \"target/typelisp-fs\")
              (+ (rename-status
                  \"target/typelisp-fs/from name\"
                  \"target/typelisp-fs/to name\")
                (+ (read-dir-status \"target/typelisp-fs\")
                  (+ (__tl_string_length (read-dir \"target/typelisp-fs\"))
                    (+ (file-kind-status \"target/typelisp-fs\")
                      (+ (file-size-status \"target/typelisp-fs\")
                        (file-size \"target/typelisp-fs\")))))))))))))")

(define (compiler-lower-raw-pointer-ops-source) : String
  "(extern (raw-make) : (MutPtr i64))
(define (main [n : u64]) : u64
  (let
    [cell : i64 0]
    [local : (MutPtr i64) (unsafe (ptr-addr-of cell))]
    [p : (MutPtr i64) (raw-make)]
    (unsafe
      (ptr-write! local 42)
      (ptr-read local)
      (ptr-write! p 41)
      (ptr-read p)
      (ptr->int (ptr-offset (ptr-cast (int->ptr n : (MutPtr i64)) : (Ptr i64)) 2)))))")

(define (compiler-lower-register-addr-of-source) : String
  "(defstruct Tiny (a i32) (b i32))
(defstruct Pair (x i64) (y i64))
(defstruct Wrap (tiny Tiny))
(define (main) : i64
  (let
    [tiny : Tiny (Tiny (cast 1 : i32) (cast 2 : i32))]
    [pair : Pair (Pair 3 4)]
    [wrap : Wrap (Wrap (Tiny (cast 7 : i32) (cast 8 : i32)))]
    [whole : (MutPtr Pair) (unsafe (ptr-addr-of pair))]
    [tiny-field : (MutPtr i32) (unsafe (ptr-addr-of (struct-get tiny b)))]
    [pair-field : (MutPtr i64) (unsafe (ptr-addr-of (struct-get pair y)))]
    [nested-field : (MutPtr i32)
      (unsafe (ptr-addr-of (struct-get (struct-get wrap tiny) b)))]
    (unsafe
      (ptr-write! tiny-field (cast 5 : i32))
      (ptr-write! pair-field 6)
      (ptr-write! nested-field (cast 9 : i32))
      (+ (cast (ptr->int whole) : i64)
        (+ (cast (ptr-read tiny-field) : i64)
          (+ (ptr-read pair-field)
            (cast (ptr-read nested-field) : i64)))))))")

(define (compiler-lower-raw-pointer-direct-call-source) : String
  "(extern (raw-make) : (MutPtr i64))
(define (main) : unit
  (unsafe
    (ptr-write! (raw-make) 41)))")

(define (compiler-lower-raw-pointer-call-value-source) : String
  "(extern (raw-make) : (MutPtr i64))
(extern (raw-value) : i64)
(define (main) : unit
  (unsafe
    (ptr-write! (raw-make) (raw-value))))")

(define (compiler-lower-aggregate-source) : String
  "(defstruct Point (x i64) (y i64))
(defenum Shape (Nothing) (Circle i64) (Pair Point))
(define (make-point [x : i64] [y : i64]) : Point
  (Point x y))
(define (get-y [p : Point]) : i64
  (struct-get p y))
(define (make-none) : Shape
  Nothing)
(define (make-none-call) : Shape
  (Nothing))
(define (make-circle [r : i64]) : Shape
  (Circle r))
(define (make-pair [x : i64]) : Shape
  (Pair (Point x (+ x 1))))
(define (main) : i64
  (get-y (make-point 20 22)))")

(define (compiler-lower-init-source) : String
  "(defstruct Point (x i64) (flag bool))
(defenum Maybe (None) (Some i64))
(define (take [n : i64]) : i64 n)
(define (main) : i64
  (let
    [n : i64 (init : i64)]
    [flag : bool (init)]
    [ch : char (init)]
    [text : String (init)]
    [ptr : (Ptr i64) (init)]
    [items : (Array i64) (init)]
    [tupled : (Tuple i64 bool) (init)]
    [fixed : (Array i64 2) (array (init) 2)]
    [point : Point (init)]
    [constructed : Point (Point (init) (init))]
    [maybe : Maybe (init)]
    [boxed : (Box i64) (init)]
    [called : i64 (take (init))]
    (begin
      (array-set! fixed 0 (init))
      (+ n (+ called (+ (struct-get point x) (+ (struct-get constructed x) (+ (tuple-ref tupled 0) (+ (array-ref fixed 0) (box-get boxed))))))))))")

;; Tuple construction + ref lowering: `(tuple true 42)` reserves
;; struct-shaped aggregate storage and stores each element at its field offset;
;; `(tuple-ref t 1)` gep+loads the indexed element. The whole computation lives
;; in `main` so it is not pruned as unreachable.
(define (compiler-lower-tuple-source) : String
  "(define (main) : i64
  (let
    [t : (Tuple bool i64) (tuple true 42)]
    (tuple-ref t 1)))")

(define (compiler-lower-tuple-return-source) : String
  "(define (make-pair [a : i64] [b : bool]) : (Tuple i64 bool)
  (tuple a b))")

(define (compiler-lower-clone-source) : String
  "(defstruct Holder
  (name String)
  (fixed (Array String 2))
  (items (Array String))
  (pair (Tuple String String)))
(defenum StringList
  (Nil)
  (Cons String (Box StringList)))
(define (clone-tuple [items : (Array String)]) : i64
  (let [pair : (Tuple String (Array String)) (clone (tuple \"tuple\" items))]
    (__tl_string_length (tuple-ref pair 0))))
(define (clone-fixed) : i64
  (let [fixed : (Array String 2) (clone (array \"left\" \"right\"))]
    (__tl_string_length (array-ref fixed 0))))
(define (clone-dyn [items : (Array String)]) : i64
  (let [copied : (Array String) (clone items)]
    (array-length copied)))
(define (clone-holder [items : (Array String)]) : Holder
  (clone (Holder \"holder\" (array \"x\" \"y\") items (tuple \"p\" \"q\"))))
(define (clone-list [list : StringList]) : StringList
  (clone list))
(define (main [n : i64] [list : StringList]) : i64
  (let
    [items1 : (Array String) (make-array String n)]
    [items2 : (Array String) (make-array String n)]
    [items3 : (Array String) (make-array String n)]
    (begin
      (clone-tuple items1)
      (clone-dyn items2)
      (clone-holder items3)
      (clone-fixed)
      (clone-list list)
      0)))")

(define (compiler-lower-clone-dynarray-bulk-source) : String
  "(defstruct OneWord
  (value i64))
(define (copy-i64-items [items : (Array i64)]) : (Array i64)
  (clone items))
(define (copy-word-items [items : (Array OneWord)]) : (Array OneWord)
  (clone items))
(define (copy-string-items [items : (Array String)]) : (Array String)
  (clone items))")

(define (compiler-lower-clone-unsupported-source) : String
  "(define (inc [x : i64]) : i64 (+ x 1))
(define (main) : (-> i64 i64)
  (clone inc))")

(define (compiler-lower-clone-reachable-source) : String
  "(defstruct UsedClone
  (name String))
(defstruct NestedClone
  (used UsedClone))
(defstruct UnusedClone
  (name String))
(define (make-nested [s : String]) : NestedClone
  (clone (NestedClone (UsedClone s))))
(define (main [s : String]) : i64
  (let
    [item : NestedClone (make-nested s)]
    (__tl_string_length (struct-get (struct-get item used) name))))")

;; Nominal clone helpers are declaration macros now, so clone-producing lowering
;; fixtures must load the same implicit prelude as the compiler driver.
(define (compiler-lower-clone-source-with-prelude [src : String]) : ResultCompilerLower
  (begin
    (intern-reset!)
    (lower-reset-intern-owned-state!)
    (cbi.compiler-builtin-reset!)
    (match (typecheck-compiler-source-load src)
      [(ResultCompilerLoadWithPaths.Ok decls paths _ _)
        (lower-compiler-program-with-decl-paths "" (ast-program decls) paths)]
      [(ResultCompilerLoadWithPaths.Err diag) (ResultCompilerLower.Err diag)])))

;; `main` must lower with both element stores (bool + i64 each written into the
;; aggregate) and a load for the `tuple-ref`.
(define (compiler-lower-tuple-shape-ok?) : bool
  (match (lower-compiler-source (compiler-lower-tuple-source))
    [(ResultCompilerLower.Ok program _)
      (match program
        [(CompilerIrProgram.Program _ functions _)
          (and
            (>= (lower-test-function-store-ptr-count functions "main") 2)
            (>= (lower-test-function-load-count functions "main") 1))])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-lower-clone-shape-ok?) : bool
  (match (compiler-lower-clone-source-with-prelude
    (compiler-lower-clone-source))
    [(ResultCompilerLower.Ok program _)
      (match program
        [(CompilerIrProgram.Program _ functions _)
          (let
            [ok : bool true]
            (begin
              (if (>
                (lower-test-function-call-count
                  functions
                  ".::clone-tuple"
                  "tl_substring")
                0)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-call-count
                  functions
                  ".::clone-tuple"
                  "tl_alloc")
                0)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-call-count
                  functions
                  ".::clone-fixed"
                  "tl_substring")
                1)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-call-count
                  functions
                  ".::clone-dyn"
                  "tl_alloc")
                1)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-branch-count functions ".::clone-dyn")
                0)
                unit
                (set! ok false))
              (if (=
                (lower-test-function-call-count
                  functions
                  ".::clone-holder"
                  ".::clone$Holder")
                1)
                unit
                (set! ok false))
              (if (=
                (lower-test-function-call-count
                  functions
                  ".::clone-list"
                  ".::clone$StringList")
                1)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-call-count
                  functions
                  ".::clone$Holder"
                  "tl_substring")
                0)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-call-count
                  functions
                  ".::clone$Holder"
                  "tl_alloc")
                0)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-call-count
                  functions
                  ".::clone$StringList$acc"
                  "tl_substring")
                0)
                unit
                (set! ok false))
              ok))])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-lower-clone-dynarray-bulk-copy-ok?) : bool
  (match (compiler-lower-clone-source-with-prelude
    (compiler-lower-clone-dynarray-bulk-source))
    [(ResultCompilerLower.Ok program _)
      (match program
        [(CompilerIrProgram.Program _ functions _)
          (let
            [ok : bool true]
            (begin
              (if (=
                (lower-test-function-call-count
                  functions
                  ".::copy-i64-items"
                  "tl_memcpy")
                1)
                unit
                (set! ok false))
              (if (=
                (lower-test-function-branch-count functions ".::copy-i64-items")
                0)
                unit
                (set! ok false))
              (if (=
                (lower-test-function-call-count
                  functions
                  ".::copy-word-items"
                  "tl_memcpy")
                1)
                unit
                (set! ok false))
              (if (=
                (lower-test-function-branch-count
                  functions
                  ".::copy-word-items")
                0)
                unit
                (set! ok false))
              (if (=
                (lower-test-function-call-count
                  functions
                  ".::copy-string-items"
                  "tl_memcpy")
                0)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-call-count
                  functions
                  ".::copy-string-items"
                  "tl_substring")
                0)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-branch-count
                  functions
                  ".::copy-string-items")
                0)
                unit
                (set! ok false))
              ok))])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-lower-clone-reachable-helpers-ok?) : bool
  (match (compiler-lower-clone-source-with-prelude
    (compiler-lower-clone-reachable-source))
    [(ResultCompilerLower.Ok program _)
      (match program
        [(CompilerIrProgram.Program _ functions _)
          (and
            (lower-test-function-defined? functions ".::clone$NestedClone")
            (lower-test-function-defined? functions ".::clone$UsedClone")
            (not
              (lower-test-function-defined? functions ".::clone$UnusedClone"))
            (=
              (lower-test-function-call-count
                functions
                ".::clone$NestedClone"
                ".::clone$UsedClone")
              1))])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-lower-inline-struct-source) : String
  "(defstruct Packet (tag i64) (small u8) (count i64))
(define (main) : i64
  (let
    [p : Packet (Packet 7 (cast 2 : u8) 40)]
    (+
      (struct-get p tag)
      (+
        (cast (struct-get p small) : i64)
        (struct-get p count)))))")

(define (compiler-lower-inline-enum-source) : String
  "(defenum Choice (Empty) (Wide u8 i64))
(define (main) : i64
  (let
    [c : Choice (Wide (cast 1 : u8) 41)]
    (match c
      [Empty 0]
      [(Wide b n) (+ (cast b : i64) n)])))")

(define (compiler-lower-inline-boxed-recursive-source) : String
  "(defenum ListI64 (Nil) (Cons i64 (Box ListI64)))
(define (main) : i64
  (let
    [tail : (Box ListI64) (box Nil)]
    (let
      [list : ListI64 (Cons 41 tail)]
      (match list
        [Nil 0]
        [(Cons head _) (+ head 1)]))))")

(define (compiler-lower-inline-imported-enum-payload-source) : String
  "(module stdlib.maybe_string)
(defenum MaybeString (No) (Some String))
(define (maybe-string-single [value : String]) : MaybeString
  (MaybeString.Some value))
(module main)
(import stdlib.maybe_string)
(define (main) : i64
  (__tl_string_length
    (match (maybe_string.maybe-string-single \"a\")
      [(maybe_string.MaybeString.No) \"\"]
      [(maybe_string.MaybeString.Some head) head])))")

(define (compiler-lower-inline-recursive-error-source) : String
  "(defenum BadList (Nil) (Cons i64 BadList))
(define (main) : i64
  (let
    [x : BadList (BadList.Cons 1 BadList.Nil)]
    0))")

(define (compiler-lower-inline-aggregate-copy-source) : String
  "(defstruct Pair (a i64) (b i64))
(define (id-pair [p : Pair]) : Pair p)
(define (main) : i64
  (struct-get (id-pair (Pair 20 22)) b))")

(define (compiler-lower-inline-mixed16-copy-source) : String
  "(defstruct Mixed16 (tag u32) (value f32) (tail i64))
(define (id-mixed [p : Mixed16]) : Mixed16 p)
(define (main) : i64
  (struct-get (id-mixed (Mixed16 (cast 1 : u32) 2.0 40)) tail))")

(define (compiler-lower-inline-sret-struct-constructor-source) : String
  "(defstruct Wide (a i64) (b i64) (c i64))
(define (make-wide [x : i64]) : Wide
  (Wide x (+ x 1) (+ x 2)))
(define (main) : i64
  (struct-get (make-wide 40) c))")

(define (compiler-lower-inline-sret-enum-constructor-source) : String
  "(defenum WideChoice (Some i64 i64 i64) (None))
(define (make-wide-choice [x : i64]) : WideChoice
  (WideChoice.Some x (+ x 1) (+ x 2)))
(define (main) : i64
  (match (make-wide-choice 40)
    [(WideChoice.Some _ _ c) c]
    [WideChoice.None 0]))")

(define (compiler-lower-inline-sret-enum-match-constructor-source) : String
  "(defstruct Wide (a i64) (b i64) (c i64))
(defenum Choice (Make i64) (Zero))
(define (from-choice [choice : Choice]) : Wide
  (match choice
    [(Make n) (Wide n (+ n 1) (+ n 2))]
    [Zero (Wide 0 1 2)]))
(define (main) : i64
  (struct-get (from-choice (Make 40)) c))")

(define (compiler-lower-inline-sret-enum-match-generic-source) : String
  "(defstruct Wide (a i64) (b i64) (c i64))
(defenum Choice (Make i64) (Wrap Wide))
(define (from-choice [choice : Choice]) : Wide
  (match choice
    [(Make n) (Wide n (+ n 1) (+ n 2))]
    [(Wrap w) w]))
(define (main) : i64
  (struct-get (from-choice (Make 40)) c))")

(define (compiler-lower-inline-hot-loop-struct-source) : String
  "(defstruct Pair (x i64) (y i64))
(define (main [n : i64]) : i64
  (let
    [i : i64 0]
    [sum : i64 0]
    (begin
      (while (< i n)
        (let
          [p : Pair (Pair i (+ i 1))]
          (begin
            (set! sum (+ sum (struct-get p y)))
            (set! i (+ i 1)))))
      sum)))")

(define (compiler-lower-inline-direct-store-source) : String
  "(defstruct Wide (a i64) (b i64) (c i64))
(defstruct Holder (wide Wide) (tail i64))
(define (direct-field [h : Holder]) : i64
  (begin
    (set! (struct-get h wide) (Wide 1 2 3))
    0))
(define (direct-init [h : Holder]) : i64
  (begin
    (set! (struct-get h wide) (init : Wide))
    0))
(define (direct-dyn-array [items : (Array Wide)] [i : i64]) : unit
  (array-set! items i (Wide 4 5 6)))
(define (direct-fixed-array [items : (Array Wide 2)] [i : i64]) : unit
  (array-set! items i (Wide 7 8 9)))
(define (direct-fixed-literal) : (Array Wide 2)
  (array (Wide 10 11 12) (Wide 13 14 15)))")

;; Payload offset lookup must not depend on earlier enum families or on
;; helper/constructor ordering when String and i64 payload result enums coexist.
(define (compiler-lower-inline-enum-layout-cache-order-source-a) : String
  "(defenum FirstResult
  (Err String)
  (Ok i64))
(defenum SecondResult
  (Ok i64)
  (Err String))
(define (first-helper [flag : bool]) : FirstResult
  (if flag
    (FirstResult.Ok 1)
    (FirstResult.Err \"first failed\")))
(define (second-helper [value : i64]) : SecondResult
  (SecondResult.Ok value))
(define (second-value-or [result : SecondResult] [fallback : i64]) : i64
  (match result
    [(SecondResult.Err _) fallback]
    [(SecondResult.Ok value) value]))
(define (main) : i64
  (+
    (match (first-helper false)
      [(FirstResult.Err message) (__tl_string_length message)]
      [(FirstResult.Ok value) value])
    (second-value-or (second-helper 40) 0)))")

(define (compiler-lower-inline-enum-layout-cache-order-source-b) : String
  "(defenum SecondResult
  (Err String)
  (Ok i64))
(defenum FirstResult
  (Ok i64)
  (Err String))
(define (second-value-or [result : SecondResult] [fallback : i64]) : i64
  (match result
    [(SecondResult.Ok value) value]
    [(SecondResult.Err _) fallback]))
(define (first-helper [flag : bool]) : FirstResult
  (if flag
    (FirstResult.Ok 2)
    (FirstResult.Err \"first failed\")))
(define (second-helper [value : i64]) : SecondResult
  (SecondResult.Ok value))
(define (main) : i64
  (+
    (second-value-or (second-helper 40) 0)
    (match (first-helper false)
      [(FirstResult.Ok value) value]
      [(FirstResult.Err message) (__tl_string_length message)])))")

(define (compiler-lower-inline-struct-shape-ok?) : bool
  (match (lower-compiler-source (compiler-lower-inline-struct-source))
    [(ResultCompilerLower.Ok program _)
      (match program
        [(CompilerIrProgram.Program _ functions _)
          (let
            [ok : bool true]
            (begin
              (if (=
                (lower-test-function-call-count functions "main" "tl_alloc")
                0)
                unit
                (set! ok false))
              (if (>= (lower-test-function-alloc-count functions "main") 3)
                unit
                (set! ok false))
              (if (= (lower-test-function-addr-of-count functions "main") 1)
                unit
                (set! ok false))
              (if (>= (lower-test-function-store-ptr-count functions "main") 3)
                unit
                (set! ok false))
              (if (>
                (lower-test-function-gep-offset-count functions "main" 16)
                0)
                unit
                (set! ok false))
              ok))])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-lower-inline-enum-shape-ok?) : bool
  (match (lower-compiler-source (compiler-lower-inline-enum-source))
    [(ResultCompilerLower.Ok program _)
