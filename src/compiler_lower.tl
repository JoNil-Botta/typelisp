;; compiler_lower.tl - Selfhost compiler AST-to-IR lowering.
;;
;; The lowerer accepts the checked program and builds a deterministic
;; CompilerIrProgram.
(import stdlib.arena)
(import stdlib.vector)
(import (vector.vector String) as svec)
(import "compiler_typecheck_api.tl")
(import compiler_builtin_ids as cbi)
(import "compiler_diagnostic.tl")
(import "compiler_ir_types.tl")
(import "compiler_clone.tl")
(import "compiler_ctfe.tl")
(import "compiler_float.tl")
(import stdlib.hashmap)
(import stdlib.hash)
(import (hashmap.hashmap i64 i64) as lower_i64_i64_map)
(import stdlib.string)
(import stdlib.text_buf)
(import stdlib.str_cat_runtime as str_cat)
(cfg compile-profile (import stdlib.profile))
(import sym_i64_env)

(defenum LowerNameEnv
  (Nil)
  ;; Source/logical identities and the renderable logical symbol. Spellings are
  ;; owned once by the active interner and recovered only when emitted.
  (Bind i64 i64 i64 (Box LowerNameEnv)))

;; Like LowerTypeCache, a LowerNameCache carries a `parent` marker.
;; `LowerNameParent.None` is a complete cache (a miss returns the source name
;; unchanged). `LowerNameParent.Global` marks a small per-module overlay that, on
;; a miss, falls through to the process-global lowering name cache
;; `lower-active-global-name-cache`. Each lowering sub-phase that builds
;; per-module name caches (the prune body-index reachability pass and the decl
;; lowering loop) sets that global to its whole-program name cache once before
;; building module overlays; the phases never overlap, so they share the slot.
;; This makes each module's name cache a small overlay of just its module-local
;; names over the shared global cache instead of rebuilding the whole global name
;; set per module (was O(modules x global-names)). A global marker is used rather
;; than an owned parent because the one global cache must be shared by every
;; module overlay.
(defenum LowerNameParent
  (None)
  (Global))

(defstruct LowerModulePathIndex
  (edges lower_i64_i64_map.Map)
  (terminals lower_i64_i64_map.Map)
  (modules lower_i64_i64_map.Map)
  (next-node i64))

(define (lower-module-path-index-empty) : LowerModulePathIndex
  (LowerModulePathIndex
    (lower_i64_i64_map.with-capacity 8)
    (lower_i64_i64_map.with-capacity 8)
    (lower_i64_i64_map.with-capacity 8)
    1))

(defstruct LowerNameCache
  (ids lower_i64_i64_map.Map)
  (logical-ids (Array i64))
  (symbol-ids (Array i64))
  (logical-symbols lower_i64_i64_map.Map)
  (module-paths LowerModulePathIndex)
  (clone-roots CloneNameList)
  (module-id i64)
  (parent LowerNameParent))

;; The shared global lowering name cache. Set once per sub-phase
;; (prune body-index build, then decl lowering) from that phase's whole-program
;; name env; per-module overlays fall through here.
(define lower-active-global-name-cache : LowerNameCache
  (LowerNameCache
    (lower_i64_i64_map.with-capacity 8)
    (make-array i64 0)
    (make-array i64 0)
    (lower_i64_i64_map.with-capacity 8)
    (lower-module-path-index-empty)
    (CloneNameList.Nil)
    cbi.compiler-builtin-id-fix-empty
    (LowerNameParent.None)))

;; Package builds set this identity before lowering. Source-level
;; `:spmd-callable` declarations are intentionally rejected by ordinary
;; program compilation because their symbols and TLCI records are a package
;; artifact ABI, not a source-visible calling convention.
(define lower-spmd-package-name : String
  "")
(define lower-spmd-package-symbol-identities : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 8))

(defenum LowerSpmdPackageSymbolRegistration
  (New)
  (Existing)
  (Collision String))

(define (lower-spmd-set-package-name! [name : String]) : unit
  (begin
    (set! lower-spmd-package-name name)
    (set!
      lower-spmd-package-symbol-identities
      (lower_i64_i64_map.with-capacity 8))))

(define (lower-spmd-clear-package-name!) : unit
  (begin
    (set! lower-spmd-package-name "")
    (set!
      lower-spmd-package-symbol-identities
      (lower_i64_i64_map.with-capacity 8))))

(define (lower-empty-global-name-cache) : LowerNameCache
  (LowerNameCache
    (lower_i64_i64_map.with-capacity 8)
    (make-array i64 0)
    (make-array i64 0)
    (lower_i64_i64_map.with-capacity 8)
    (lower-module-path-index-empty)
    (CloneNameList.Nil)
    cbi.compiler-builtin-id-fix-empty
    (LowerNameParent.None)))

;; LowerTypeCache.Some carries a `parent` marker. `LowerTypeParent.None`
;; is a complete cache (a miss = unbound). `LowerTypeParent.Global` marks a small
;; per-module overlay that, on a miss, falls through to the process-global
;; decl-lowering type cache `lower-decls-global-type-cache` (set once per
;; lower-decls run). This lets each module's type cache be a small overlay of
;; just the module-local type bindings over the shared global cache, instead of
;; rebuilding the whole global type set into a fresh cache at every module
;; boundary (was O(modules x global-types)). A global marker (rather than an
;; owned parent value) is used because the single global cache must be shared by
;; every module's overlay, which move semantics forbid for an owned field; the
;; compiler already keeps per-file process-global caches in this style.
(defenum LowerTypeParent
  (None)
  (Global))

(defenum LowerTypeCache
  (No)
  (Some lower_i64_i64_map.Map (Array AstType) i64 LowerTypeParent))

;; The shared global decl-lowering type cache (built once per lower-decls
;; from top-env). Per-module overlay caches (LowerTypeParent.Global) fall through
;; here on a miss. Set by lower-decls before the per-module loop runs.
(define lower-decls-global-type-cache : LowerTypeCache
  (LowerTypeCache.No))

;; Call-slot RVO forwards the current function's hidden sret slot to the
;; callee and then returns that slot. Callees whose body can emit an early exit
;; (`return` or `try`) are not yet guaranteed to write that forwarded slot on
;; every path; those older paths may still return a heap aggregate pointer. This
;; set is rebuilt once per lower-decls run and lets the RVO guard stay cheap.
(define lower-rvo-early-return-functions : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 8))

(defenum LowerIdSet
  (Nil)
  (Cons i64 (Box LowerIdSet)))

(defenum LowerSpmdInlineSubst
  (Nil)
  (Cons i64 AstExpr (Box LowerSpmdInlineSubst)))

;; Function reachability is ID-native. `all-functions` maps the canonical
;; logical ID to a dense slot, `reachable` is slot-keyed, and the worklist/body
;; index carry the same logical ID. Display strings never participate in graph
;; identity.
(defenum LowerReachState
  (State lower_i64_i64_map.Map LowerIdSet))

(defenum LowerUsedTypePathSeed
  (Seed lower_i64_i64_map.Map bool))

(defenum LowerMaybeFunctionBody
  (No)
  (Some AstExpr LowerNameCache i64))

;; Reset once per prune reach walk; lower-reach-process records each reachable
;; function body's source path so type-decl DCE can keep local support types
;; without rescanning every declaration to rediscover those paths.
(define lower-reach-active-runtime-paths : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 8))
(define lower-reach-active-body-used-types : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 8))

(define (lower-reach-scratch-globals-reset!) : unit
  (begin
    (set! lower-active-global-name-cache (lower-empty-global-name-cache))
    (set! lower-reach-active-runtime-paths (lower_i64_i64_map.with-capacity 8))
    (set!
      lower-reach-active-body-used-types
      (lower_i64_i64_map.with-capacity 8))
    unit))

(defenum LowerSpmdInlineHelper
  (No)
  (Some i64 AstParamList AstType AstExpr)
  (Imported i64 AstType (Box AstImportedSpmdCallableList)))

(defenum LowerSpmdScalarCallContext
  (No)
  (Some String))

(defstruct LowerFunctionBodyIndex
  (ids lower_i64_i64_map.Map)
  (bodies (Array LowerMaybeFunctionBody))
  (next i64))

(defenum LowerPrunedProgram
  (Program AstProgram AstDeclPathList))

(defstruct LowerDeclKeepPlan
  (keep (Array i64))
  (source-count i64))

(defenum LowerPrunedProgramWithPlan
  (Program AstProgram AstDeclPathList LowerDeclKeepPlan))

(defenum LowerFilteredReachableWithPlan
  (Filtered AstDeclList AstDeclPathList LowerDeclKeepPlan))

(defenum LowerEntryMainScan
  (Scan i64 String i64 bool))

(defenum LowerMaybeEntryMainModule
  (No)
  (Some String i64))

(defenum ResultLowerCheckedContext
  (Ok TcContext TcTypeEnv)
  (Err String))

(defenum ResultLowerCloneAugment
  (Ok AstProgram AstDeclList)
  (Err String))

(defenum CompilerLowerMode
  (Scalar)
  (LinuxScalar)
  (WindowsScalar)
  (Avx2)
  (LinuxAvx2)
  (WindowsAvx2)
  (Avx512)
  (LinuxAvx512)
  (WindowsAvx512)
  (InlineAggregates))

(defenum LowerState
  (State
    i64
    i64
    i64
    String
    CompilerIrInstrBuilder
    CompilerIrBlockBuilder
    CompilerIrFunctionBuilder
    String
    (Box CompilerSourceSpans)
    LowerNameCache
    LowerTypeCache
    CompilerLowerMode
    lower_i64_i64_map.Map
    ;; Tail-call-safe current function parameter var range: [start, end).
    i64
    i64))

(defenum LowerMaybeArrayVar
  (No)
  (Some i64 AstType))

(defenum LowerMaybeIrValue
  (No)
  (Some CompilerIrValue))

(defenum LowerMaybeAstExpr
  (No)
  (Some AstExpr))

(defenum LowerSpmdInlineLetBindings
  (Bindings AstLetBindingList LowerSpmdInlineSubst LowerIdSet))

(defenum LowerVectorMapValue
  (Array i64)
  ;; Gather `source[indexes[i]]`; indexes are contiguous i64 lanes and source
  ;; accesses are non-contiguous reads.
  (Gather i64 i64)
  ;; Gather `source[i + offsets[program-index]]` without materializing a
  ;; logical-index array. The backend forms the i64 index lanes directly.
  (GatherLaneOffset i64 i64)
  ;; A dynamic array indexed by `(program-index)`. Unlike `Array`, this source
  ;; repeats the same lane vector for every foreach gang.
  (LaneArray i64)
  (Uniform CompilerIrValue)
  (BroadcastArray i64 CompilerIrValue)
  (LaneIndex)
  (LaneCount)
  ;; Intra-gang permutation. The selector plan always has i64 elements even
  ;; when the shuffled value uses 32-bit lanes.
  (Shuffle (Box LowerVectorMapValue) (Box LowerVectorMapValue))
  (BinOp CompilerIrBinOp (Box LowerVectorMapValue) (Box LowerVectorMapValue)))

(defenum LowerMaybeVectorMapValue
  (No)
  (Some LowerVectorMapValue))

(defstruct LowerVectorMapStore
  (array-var i64)
  (value LowerVectorMapValue))

(defstruct LowerVectorMapStoreList
  (items (Array LowerVectorMapStore))
  (count i64))

(defenum LowerMaybeVectorMapStore
  (No)
  (Some LowerVectorMapStore AstType i64))

(defenum LowerVectorMapValueKey
  (Array i64)
  ;; Loop-invariant dynamic-array header slot 0. Unlike `Array`, which caches
  ;; the varying vector loaded at the current gang index, this value dominates
  ;; every full-gang body reached from the SIMD preheader.
  (ArrayData i64)
  (Gather i64 i64)
  (GatherLaneOffset i64 i64)
  (LaneArray i64)
  (Uniform CompilerIrValue)
  (BroadcastArray i64 CompilerIrValue)
  (LaneIndex)
  (LaneCount)
  (BinOp CompilerIrBinOp CompilerIrValue CompilerIrValue))

(defstruct LowerVectorMapValueCache
  (keys (Array LowerVectorMapValueKey))
  (values (Array CompilerIrValue))
  (count i64))

(defenum LowerVectorMapCachedEmit
  (Emit LowerState CompilerIrValue LowerVectorMapValueCache))

(defenum LowerVectorMapEmitMode
  (Full)
  (Predicated CompilerIrValue CompilerIrValue))

(defenum LowerMaybeVectorMap
  (No)
  (Some LowerVectorMapStoreList AstType i64))

(defenum LowerMaybeMaskedVectorMap
  (No)
  (Some i64))

(defenum LowerMaskedMatchMasks
  (Masks LowerState CompilerIrValue CompilerIrValue))

(defenum ResultLowerMaskedMatchMasks
  (Ok LowerMaskedMatchMasks)
  (Err (Box CompilerDiagnostic)))

(defenum LowerMaskedEnumSource
  (Source LowerState CompilerIrValue AstType))

(defenum ResultLowerMaskedEnumSource
  (No)
  (Ok LowerMaskedEnumSource)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerMaskedEnumEnv
  (Ok LowerState sym_i64_env.SymI64Env TcTypeEnv LowerIdSet)
  (Err (Box CompilerDiagnostic)))

(defenum LowerMaybeVectorReduce
  (No)
  (Array i64 CompilerIrVectorReduceOp AstType i64)
  (Value LowerVectorMapValue CompilerIrVectorReduceOp AstType i64))

(defenum LowerMaybeVectorScan
  (No)
  (Scan i64 i64 CompilerIrVectorPrefixOp AstType i64))

;; Reduction addend split plan for scalar `sum` lowering: `Split x-id u-id`
;; accumulates only the varying addend `x-id` (an expr-pool id) per iteration
;; and adds `(* trip-count u)` once after the loop, where `u-id` is the
;; reduction-invariant addend's variable id.
(defenum LowerMaybeReduceSplit
  (No)
  (Split i64 i64))

(defstruct LowerArrayVarSet
  (vars (Array i64))
  (offsets (Array i64))
  (count i64))

(defenum LowerCapture
  (Capture i64 i64 AstType i64))

(defstruct LowerCaptureList
  (items (Array LowerCapture))
  (count i64))

(defenum LowerCapturePlan
  (Plan LowerCaptureList i64))

(defenum ResultLowerCapturePlan
  (Ok LowerCapturePlan)
  (Err (Box CompilerDiagnostic)))

(defenum LowerAlloc
  (Alloc LowerState i64))

(defenum LowerInlineStorage
  (Storage LowerState i64))

(defenum LowerLabel
  (Label LowerState String))

(defenum LowerLambdaName
  (Name LowerState i64))

(defenum LowerMaybeIrSymbol
  (No)
  (Some i64))

(defenum LowerExpr
  (Expr LowerState CompilerIrValue AstType))

(defenum LowerMaybeSpmdCall
  (No)
  (Some LowerExpr)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerExpr
  (Ok LowerExpr)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerAstExpr
  (Ok AstExpr)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerAstExprList
  (Ok AstExprList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerSpmdInlineLetBindings
  (Ok LowerSpmdInlineLetBindings)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerSpmdInlineLetBindingsBuild
  (Ok LowerSpmdInlineSubst LowerIdSet)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerSpmdInlineSubst
  (Ok LowerSpmdInlineSubst)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerSpmdInlineHelper
  (Ok LowerSpmdInlineHelper)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerSpmdCallArgs
  (Ok LowerState CompilerIrSpmdCallArgList bool)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerImportedSpmdSpecialization
  (Ok AstImportedSpmdSpecialization)
  (Err (Box CompilerDiagnostic)))

(defstruct LowerImportedSpmdSelectionScan
  (signature-count i64)
  (supported-abi-count i64)
  (unsupported-abi-id i64)
  (unsupported-key-abi-id i64)
  (selected-count i64)
  (selected AstImportedSpmdSpecialization))

(defenum ResultLowerArgs
  (Ok LowerState CompilerIrValueList)
  (Err (Box CompilerDiagnostic)))

(defenum LowerArgWriteback
  (Writeback i64 CompilerIrValue AstType AstExpr))

(import (vector.vector LowerArgWriteback core) as lower_arg_writeback_vec)

(defenum LowerArgWritebacks
  (None)
  (Some lower_arg_writeback_vec.Vec))

(defenum LowerMaybeArgWriteback
  (No)
  (Some LowerArgWriteback))

(defenum LowerCallArg
  (Arg LowerState CompilerIrValue LowerMaybeArgWriteback))

(defenum ResultLowerCallArg
  (Ok LowerCallArg)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerCallArgs
  (Ok LowerState CompilerIrValueList LowerArgWritebacks)
  (Err (Box CompilerDiagnostic)))

(defenum LowerCAbiEightbyteClass
  (Empty)
  (Integer)
  (Sse AstType i64)
  (Unsupported))

(defenum LowerCAbiSysvSlots
  (Slots LowerCAbiEightbyteClass LowerCAbiEightbyteClass)
  (Unsupported))

(defenum LowerCAbiSlot
  (Slot AstType i64))

(defstruct LowerCAbiSlotList
  (items (Array LowerCAbiSlot))
  (count i64))

(defenum LowerCAbiAggregate
  (No)
  (Integer AstType i64)
  (Register LowerCAbiSlotList i64)
  (Memory i64)
  (ByRef i64)
  (Sret i64)
  (Unsupported String))

(defenum ResultLowerState
  (Ok LowerState)
  (Err (Box CompilerDiagnostic)))

(defenum LowerMaybeDirectStore
  (No)
  (Store LowerState)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerEnv
  (Ok LowerState sym_i64_env.SymI64Env TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

;; The Ok variant carries the full module-local type env (top-env + local type
;; decls), the module-local-only type env, and the module-local-only name env.
;; The local-only envs build small cache overlays over the shared global caches.
(defenum ResultLowerModuleLocalEnv
  (Ok TcTypeEnv TcTypeEnv LowerNameEnv)
  (Err String))

(defenum ResultLowerModuleTypeEnvs
  (Ok TcTypeEnv TcTypeEnv)
  (Err String))

(defenum ResultLowerValue
  (Ok CompilerIrValue)
  (Err (Box CompilerDiagnostic)))

(defenum ResultLowerSize
  (Ok i64)
  (Err String))

(defenum ResultLowerFunction
  (Ok CompilerIrFunctionList CompilerSourceSpans)
  (Err (Box CompilerDiagnostic)))

;; `lower-decls` also threads the `CompilerSourceSpans` provenance side table
;;
;; so each lowered function's source span is recorded alongside the IR.
(defstruct LowerDeclsSuccess
  (globals CompilerIrGlobalList)
  (functions CompilerIrFunctionList)
  (externs CompilerIrExternList)
  (spans CompilerSourceSpans))

(defenum ResultLowerDecls
  (Ok (Box LowerDeclsSuccess))
  (Err (Box CompilerDiagnostic)))

(defenum LowerDispatchDecl
  (Decl CompilerIrGlobal CompilerIrFunctionList CompilerSourceSpans))

(defenum ResultLowerDispatchDecl
  (Ok (Box LowerDispatchDecl))
  (Err (Box CompilerDiagnostic)))

;; A successful lowering returns the IR `CompilerIrProgram` plus a
;;
;; `CompilerSourceSpans` side table mapping each lowered function's name
;;
;; to the `AstSourceSpan` of its source body, so backend diagnostics can report a
;;
;; real source location. The provenance table is kept outside the IR so the
;;
;; optimizer and liveness data model stay unchanged.
(defenum ResultCompilerLower
  (Ok CompilerIrProgram CompilerSourceSpans)
  (Err (Box CompilerDiagnostic)))

(define lower-checked-dest-pools-active : bool
  false)
(define lower-checked-dest-pools-committed : bool
  false)
(define lower-checked-dest-pools-context : AstNodePoolContext
  (ast-node-pool-context-capture-active))
(define lower-checked-source-release-arena : i64
  0)
(define lower-checked-frontend-release-arena : i64
  0)
(define lower-checked-frontend-released : bool
  false)
(define lower-checked-dest-pools-rolled-over : bool
  false)
(define lower-checked-dest-pools-deferred : bool
  false)
(define lower-checked-dest-pools-deferred-expr-capacity : i64
  1)
(define lower-checked-dest-pools-deferred-type-capacity : i64
  1)

(define (compiler-lower-checked-dest-pools-use!
  [dest-pools : AstNodePoolContext]
  [source-release-arena : i64]
  [frontend-release-arena : i64]) : unit
  (begin
    (set! lower-checked-dest-pools-context dest-pools)
    (set! lower-checked-source-release-arena source-release-arena)
    (set! lower-checked-frontend-release-arena frontend-release-arena)
    (set! lower-checked-frontend-released false)
    (set! lower-checked-dest-pools-rolled-over false)
    (set! lower-checked-dest-pools-deferred false)
    (set! lower-checked-dest-pools-committed false)
    (set! lower-checked-dest-pools-active true)))

(define (compiler-lower-checked-dest-pools-clear!) : unit
  (begin
    (set! lower-checked-dest-pools-active false)
    (set! lower-checked-dest-pools-committed false)
    (set! lower-checked-source-release-arena 0)
    (set! lower-checked-frontend-release-arena 0)
    (set! lower-checked-frontend-released false)
    (set! lower-checked-dest-pools-rolled-over false)
    (set! lower-checked-dest-pools-deferred false)))

(define (compiler-lower-checked-dest-pools-committed?) : bool
  lower-checked-dest-pools-committed)

(define (lower-checked-dest-pools-materialize-deferred!) : unit
  (if lower-checked-dest-pools-deferred
    (let
      [dest-arena : i64 (arena.tl_arena_make)]
      [dest-pools : AstNodePoolContext
        (ast-node-pool-context-new-with-capacities-in-arena
          lower-checked-dest-pools-deferred-expr-capacity
          lower-checked-dest-pools-deferred-type-capacity
          dest-arena)]
      (begin
        (set! lower-checked-dest-pools-context dest-pools)
        (set! lower-checked-dest-pools-deferred false)))
    unit))

(define (compiler-lower-checked-dest-pools-current) : AstNodePoolContext
  (begin
    ;; The post-macro destination is intentionally absent during the macro
    ;; walk. Materialize it only when the caller is ready to compact, after
    ;; macro-owned scratch generations have already been released.
    (lower-checked-dest-pools-materialize-deferred!)
    lower-checked-dest-pools-context))

(define (compiler-lower-checked-frontend-released?) : bool
  lower-checked-frontend-released)

(define (compiler-lower-checked-dest-pools-abort-uncommitted!) : unit
  (if lower-checked-dest-pools-rolled-over
    (begin
      ;; The driver's original destination is the compact macro source after a
      ;; rollover. Release a materialized second destination here; if expansion
      ;; failed before demand, it never existed. The driver then releases the
      ;; original source through its stable owner.
      (if lower-checked-dest-pools-deferred
        unit
        (unsafe
          (arena.tl_arena_destroy
            (ast-node-pool-context-base-arena lower-checked-dest-pools-context))))
      (set! lower-checked-dest-pools-rolled-over false)
      (set! lower-checked-dest-pools-deferred false)
      (set! lower-checked-dest-pools-active false))
    unit))

(define (lower-checked-dest-pools-deactivate-after-commit!) : unit
  (if lower-checked-dest-pools-committed
    (set! lower-checked-dest-pools-active false)
    unit))

(define (lower-checked-dest-pools-rollover-for-macro!) : unit
  (if lower-checked-dest-pools-committed
    (let
      [source-pools : AstNodePoolContext lower-checked-dest-pools-context]
      [source-arena : i64 (ast-node-pool-context-base-arena source-pools)]
      [expr-capacity : i64 (ast-node-pool-context-expr-capacity source-pools)]
      [type-capacity : i64 (ast-node-pool-context-type-capacity source-pools)]
      [macro-frontend-arena : i64 (arena.tl_arena_make)]
      (begin
        ;; The first compact generation is now the macro walk's read/write
        ;; source. Keep macro-owned lists in a fresh frontend arena. Defer the
        ;; second compact generation until expansion returns so its empty
        ;; backing arrays do not overlap the whole macro walk.
        (set! lower-checked-dest-pools-deferred-expr-capacity expr-capacity)
        (set! lower-checked-dest-pools-deferred-type-capacity type-capacity)
        (set! lower-checked-dest-pools-deferred true)
        (set! lower-checked-source-release-arena source-arena)
        (set! lower-checked-frontend-release-arena macro-frontend-arena)
        ;; The driver's original frontend has already been retired. Preserve
        ;; that fact so an error between the two compactions restores allocation
        ;; to the caller arena rather than to the unmapped original frontend.
        (set! lower-checked-frontend-released true)
        (set! lower-checked-dest-pools-committed false)
        (set! lower-checked-dest-pools-rolled-over true)
        (set! lower-checked-dest-pools-active true)
        (unsafe
          (arena.tl_arena_set macro-frontend-arena))))
    unit))

;; Macro expansion rebuilt only temporary list spines and proved that every
;; retained declaration/path/node is still the first compact generation.  Drop
;; the macro frontend, cancel the deferred second destination, and make that
;; generation the driver's committed result.
(define (lower-checked-dest-pools-retain-macro-source!
  [source-pools : AstNodePoolContext]) : unit
  (if (and lower-checked-dest-pools-active lower-checked-dest-pools-rolled-over)
    (let
      [macro-frontend-arena : i64 lower-checked-frontend-release-arena]
      [source-arena : i64 (ast-node-pool-context-base-arena source-pools)]
      (begin
        (unsafe
          (arena.tl_arena_set source-arena))
        (set! lower-checked-dest-pools-context source-pools)
        (ast-node-pool-context-install! lower-checked-dest-pools-context)
        (if (= macro-frontend-arena 0)
          unit
          (unsafe
            (arena.tl_arena_destroy macro-frontend-arena)))
        (set! lower-checked-source-release-arena 0)
        (set! lower-checked-frontend-release-arena 0)
        (set! lower-checked-dest-pools-deferred false)
        (set! lower-checked-dest-pools-rolled-over false)
        (set! lower-checked-dest-pools-committed true)
        (set! lower-checked-dest-pools-active false)
        (set! lower-checked-frontend-released true)))
    unit))

(define (lower-copy-string-into-pools
  [text : String]
  [pools : AstNodePoolContext]) : String
  (let
    [prev-arena : i64 (arena.tl_arena_current)]
    [base-arena : i64 (ast-node-pool-context-base-arena pools)]
    [_set-arena : unit
      (unsafe
        (arena.tl_arena_set base-arena))]
    [out : String (string.copy (& text))]
    (begin
      (ast-node-pool-context-sync-base-arena! pools (arena.tl_arena_current))
      (unsafe
        (arena.tl_arena_set prev-arena))
      out)))

(define (lower-copy-paths-into-pools
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]) : AstDeclPathList
  (let
    [prev-arena : i64 (arena.tl_arena_current)]
    [base-arena : i64 (ast-node-pool-context-base-arena pools)]
    [_set-arena : unit
      (unsafe
        (arena.tl_arena_set base-arena))]
    [count : i64 (ast-decl-path-list-len (& paths))]
    [out : AstDeclPathList (ast-decl-path-list-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [path : String (ast-decl-path-list-get (& paths) index "")]
          [owned-path : String (string.copy (& path))]
          (begin
            (ast-decl-path-list-push-with-owner-id
              (&mut out)
              owned-path
              (ast-decl-path-list-owner-id
                (& paths)
                index
                cbi.compiler-builtin-id-fix-empty))
            (set! index (+ index 1)))))
      (ast-node-pool-context-sync-base-arena! pools (arena.tl_arena_current))
      (unsafe
        (arena.tl_arena_set prev-arena))
      out)))

(define (lower-clear-macro-expanded-source-caches-into-pools!
  [pools : AstNodePoolContext]) : unit
  (let
    [prev-arena : i64 (arena.tl_arena_current)]
    [base-arena : i64 (ast-node-pool-context-base-arena pools)]
    (begin
      (unsafe
        (arena.tl_arena_set base-arena))
      (compiler-load-dotted-path-cache-reset!)
      (compiler-typecheck-clear-macro-expanded-source-caches!)
      (ast-node-pool-context-sync-base-arena! pools (arena.tl_arena_current))
      (unsafe
        (arena.tl_arena_set prev-arena)))))

(define (lower-name-env-copy-active [names : LowerNameEnv]) : LowerNameEnv
  (match names
    [(LowerNameEnv.Nil) LowerNameEnv.Nil]
    [(LowerNameEnv.Bind source-id logical-id symbol-id rest)
      (LowerNameEnv.Bind
        source-id
        logical-id
        symbol-id
        (box (lower-name-env-copy-active (box-get rest))))]))

(define (lower-name-env-copy-into-pools
  [names : LowerNameEnv]
  [pools : AstNodePoolContext]) : LowerNameEnv
  (let
    [prev-arena : i64 (arena.tl_arena_current)]
    [base-arena : i64 (ast-node-pool-context-base-arena pools)]
    [_set-arena : unit
      (unsafe
        (arena.tl_arena_set base-arena))]
    [out : LowerNameEnv (lower-name-env-copy-active names)]
    (begin
      (ast-node-pool-context-sync-base-arena! pools (arena.tl_arena_current))
      (unsafe
        (arena.tl_arena_set prev-arena))
      out)))

(define (lower-checked-dest-pools-commit! [pools : AstNodePoolContext]) : unit
  (if lower-checked-dest-pools-active
    (let
      [old-arena : i64 lower-checked-source-release-arena]
      [old-frontend-arena : i64 lower-checked-frontend-release-arena]
      [dest-arena : i64 (ast-node-pool-context-base-arena pools)]
      [final-expr-state : AstExprNodePoolState
        (array-ref (struct-get pools expr-pool) 0)]
      [final-type-state : AstTypeNodePoolState
        (array-ref (struct-get pools type-pool) 0)]
      (begin
        (set! lower-checked-dest-pools-committed true)
        (set! lower-checked-dest-pools-rolled-over false)
        (set! lower-checked-source-release-arena 0)
        (set! lower-checked-frontend-release-arena 0)
        (unsafe
          (arena.tl_arena_set dest-arena))
        ;; `ast-program-compact-with-pools` and the original destination both
        ;; carry one-element state arrays allocated in the caller arena. Rebuild
        ;; the complete context here so its wrapper cells and aggregate shell,
        ;; not just its large backing pools, survive frontend retirement.
        (set!
          lower-checked-dest-pools-context
          (ast-node-pool-context-new final-expr-state final-type-state))
        (ast-node-pool-context-install! lower-checked-dest-pools-context)
        (if (= old-arena 0)
          unit
          (unsafe
            (arena.tl_arena_destroy old-arena)))
        ;; Macro expansion has compacted every surviving AST node, path, and
        ;; string into `pools`, and the cache reset above removed the remaining
        ;; source-derived globals. Uncached emit jobs can therefore retire the
        ;; distinct load/macro arena here, before typecheck and lowering grow
        ;; the checked pools. Cached sessions pass zero and preserve their
        ;; program-lifetime storage unchanged.
        (if (= old-frontend-arena 0)
          unit
          (begin
            (unsafe
              (arena.tl_arena_destroy old-frontend-arena))
            (set! lower-checked-frontend-released true)))))
    unit))

(defenum LowerFieldInfo
  (Info i64 AstType))

(defenum ResultLowerFieldInfo
  (Ok LowerFieldInfo)
  (Err (Box CompilerDiagnostic)))

(defenum LowerStringFields
  (Fields LowerState CompilerIrValue CompilerIrValue))

(defenum LowerMaybeStringConcatCall
  (No)
  (Some i64 i64))

(defenum ResultLowerStringValues
  (Ok LowerState CompilerIrValueList i64)
  (Err (Box CompilerDiagnostic)))

(defstruct LowerCleanupStack
  (hidden-name-ids (Array i64))
  (cleanup-name-ids (Array i64))
  (live-name-ids (Array i64))
  (count i64))

(defenum LowerResourceBindings
  (Bindings LowerState sym_i64_env.SymI64Env TcTypeEnv LowerCleanupStack))

(defenum ResultLowerResourceBindings
  (Ok LowerResourceBindings)
  (Err (Box CompilerDiagnostic)))

(defenum LowerLoopTarget
  (Target String String))

(defenum ResultLowerLoopTarget
  (Ok LowerLoopTarget)
  (Err (Box CompilerDiagnostic)))

(define (lower-diagnostic [message : String]) : CompilerDiagnostic
  (compiler-diagnostic-at-start "" message))

(cfg
  compile-profile
  (define compiler-lower-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-start-total : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-start-live : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-start-intern : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-start-intern-slice : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-start-intern-generated : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-start-intern-render : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-detail-start-ms : i64
    0))

;; Deep string concat lowering has a deliberately bounded fan-in. Keep these
;; counters in the compile-profile build so the regression fixture can prove
;; that a wide tree is flattened once and emitted as a small number of runtime
;; calls.
(cfg
  compile-profile
  (define compiler-lower-profile-string-concat-trees : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-string-concat-leaves : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-string-concat-runtime-calls : i64
    0))

(define (lower-test-generated-name-id [value : String]) : i64
  (ci.intern-generated-canonical-name value))

;; Non-resetting stage snapshots inside lower.typecheck: the checked-program
;; build's retention decomposes across the walk / clone augmentation / context
;; extension stages. Detail rows carry absolute alloc-live and the running peak
;; so analysis can diff stages without perturbing the phase-level peak math.
;; Kept out of the shipped compiler: the compile-profile verifier gate rejects
;; unexpected detail rows, so these fire only in local measurement builds.
(cfg
  compile-profile
  (define (compiler-lower-profile-field [value : i64]) : String
    (string.append "|" (string.int->string value))))

(cfg
  compile-profile
  (define (compiler-lower-profile-start) : unit
    (begin
      (set! compiler-lower-profile-start-ms (profile.now-ms))
      (set! compiler-lower-profile-start-total (profile.alloc-total))
      (set! compiler-lower-profile-start-live (profile.alloc-live))
      (set!
        compiler-lower-profile-start-intern
        (ci.intern-profile-intern-value))
      (set!
        compiler-lower-profile-start-intern-slice
        (ci.intern-profile-slice-value))
      (set!
        compiler-lower-profile-start-intern-generated
        (ci.intern-profile-generated-value))
      (set!
        compiler-lower-profile-start-intern-render
        (ci.intern-profile-render-value))
      (profile.alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-lower-profile-finish [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64
        (- (profile.alloc-peak) compiler-lower-profile-start-live)]
      (begin
        (io.print-error
          (string.append
            "compile-profile|lower."
            (string.append
              phase
              (string.append
                (compiler-lower-profile-field
                  (- end-ms compiler-lower-profile-start-ms))
                (string.append
                  (compiler-lower-profile-field
                    (- end-total compiler-lower-profile-start-total))
                  (string.append
                    (compiler-lower-profile-field
                      (- end-live compiler-lower-profile-start-live))
                    (string.append
                      (compiler-lower-profile-field peak-delta)
                      "\n")))))))
        (cfg
          compile-profile-summary
          unit
          (io.print-error
            (string.append
              "compile-profile-detail|intern.lower_phase|"
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string
                      (-
                        (ci.intern-profile-intern-value)
                        compiler-lower-profile-start-intern))
                    "\n"))))))
        (cfg
          compile-profile-summary
          unit
          (io.print-error
            (string.append
              "compile-profile-detail|intern.lower_phase.slice|"
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string
                      (-
                        (ci.intern-profile-slice-value)
                        compiler-lower-profile-start-intern-slice))
                    "\n"))))))
        (cfg
          compile-profile-summary
          unit
          (io.print-error
            (string.append
              "compile-profile-detail|intern.lower_phase.render|"
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string
                      (-
                        (ci.intern-profile-render-value)
                        compiler-lower-profile-start-intern-render))
                    "\n"))))))
        (cfg
          compile-profile-summary
          unit
          (io.print-error
            (string.append
              "compile-profile-detail|intern.lower_phase.generated|"
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string
                      (-
                        (ci.intern-profile-generated-value)
                        compiler-lower-profile-start-intern-generated))
                    "\n"))))))))))

(cfg
  compile-profile
  (define (compiler-lower-profile-detail-start) : unit
    (set! compiler-lower-profile-detail-start-ms (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-lower-profile-detail-finish
    [phase : String]
    [name : String]) : unit
    (let
      [elapsed : i64
        (- (profile.now-ms) compiler-lower-profile-detail-start-ms)]
      (cfg
        compile-profile-summary
        unit
        (if (>= elapsed 1)
          (io.print-error
            (string.append
              "compile-profile-detail|lower."
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string elapsed)
                    (string.append "|" (string.append name "\n")))))))
          unit)))))

(cfg
  compile-profile
  ;; Counter rows reuse the six-field phase schema so benchmark profile.tsv
  ;; extraction preserves them; the counter value lives in the live-delta slot.
  (define (compiler-lower-profile-counter [name : String] [value : i64]) : unit
    (io.print-error
      (string.append
        "compile-profile|lower."
        (string.append
          name
          (string.append
            "|0|0"
            (string.append (compiler-lower-profile-field value) "|0\n")))))))

(cfg
  compile-profile
  (define (compiler-lower-profile-string-concat-reset) : unit
    (begin
      (set! compiler-lower-profile-string-concat-trees 0)
      (set! compiler-lower-profile-string-concat-leaves 0)
      (set! compiler-lower-profile-string-concat-runtime-calls 0))))

(cfg
  compile-profile
  (define (compiler-lower-profile-string-concat-finish) : unit
    (begin
      (compiler-lower-profile-counter
        "string_concat.trees"
        compiler-lower-profile-string-concat-trees)
      (compiler-lower-profile-counter
        "string_concat.leaves"
        compiler-lower-profile-string-concat-leaves)
      (compiler-lower-profile-counter
        "string_concat.runtime_calls"
        compiler-lower-profile-string-concat-runtime-calls))))

(cfg
  compile-profile
  (define (compiler-lower-profile-pools
    [point : String]
    [pools : AstNodePoolContext]) : unit
    (begin
      (compiler-lower-profile-counter
        (string.append "ast_expr_pool." (string.append point ".len"))
        (ast-node-pool-context-expr-len pools))
      (compiler-lower-profile-counter
        (string.append "ast_expr_pool." (string.append point ".capacity"))
        (ast-node-pool-context-expr-capacity pools))
      (compiler-lower-profile-counter
        (string.append "ast_type_pool." (string.append point ".len"))
        (ast-node-pool-context-type-len pools))
      (compiler-lower-profile-counter
        (string.append "ast_type_pool." (string.append point ".capacity"))
        (ast-node-pool-context-type-capacity pools)))))

(cfg
  compile-profile
  (define (compiler-lower-profile-decl-list-count [decls : AstDeclList]) : i64
    (ast-decl-list-len (& decls))))

(cfg
  compile-profile
  (define (compiler-lower-profile-program-counts
    [point : String]
    [program : AstProgram]) : unit
    (match program
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (begin
            (compiler-lower-profile-counter
              (string.append "checked_program." (string.append point ".decls"))
              (compiler-lower-profile-decl-list-count decls))
            (compiler-lower-profile-counter
              (string.append
                "checked_program."
                (string.append point ".functions"))
              (lower-function-decl-count decls))))])))

(cfg
  compile-profile
  (define (compiler-lower-profile-ir-shape
    [point : String]
    [program : CompilerIrProgram]) : unit
    (match program
      [(CompilerIrProgram.Program _ functions _)
        (begin
          (compiler-lower-profile-counter
            (string.append "ir." (string.append point ".functions"))
            (compiler-ir-function-list-count functions))
          (compiler-lower-profile-counter
            (string.append "ir." (string.append point ".blocks"))
            (compiler-ir-function-list-block-count functions))
          (compiler-lower-profile-counter
            (string.append "ir." (string.append point ".instructions"))
            (compiler-ir-function-list-instruction-count functions)))])))

(cfg
  compile-profile
  (define (compiler-lower-profile-ir-arena [point : String]) : unit
    (compiler-lower-profile-counter
      (string.append "ir_arena." (string.append point ".active"))
      (if (= lower-ir-arena 0)
        0
        1))))

(define (lower-expr-id-span [expr-id : i64]) : CompilerMaybeSourceSpan
  (lower-ast-expr-span (ast-node-get expr-id)))

(define (lower-expr-id-first-span2 [first : i64] [second : i64]) : CompilerMaybeSourceSpan
  (match (lower-expr-id-span first)
    [(CompilerMaybeSourceSpan.Some span) (CompilerMaybeSourceSpan.Some span)]
    [(CompilerMaybeSourceSpan.No) (lower-expr-id-span second)]))

(define (lower-expr-id-first-span3 [first : i64] [second : i64] [third : i64]) : CompilerMaybeSourceSpan
  (match (lower-expr-id-span first)
    [(CompilerMaybeSourceSpan.Some span) (CompilerMaybeSourceSpan.Some span)]
    [(CompilerMaybeSourceSpan.No) (lower-expr-id-first-span2 second third)]))

(define (lower-expr-list-first-span-at
  [exprs : (& exprs AstExprList)]
  [index : i64]) : CompilerMaybeSourceSpan
  (if (>= index (ast-expr-list-len exprs))
    (CompilerMaybeSourceSpan.No)
    (match (lower-expr-id-span (ast-expr-list-get exprs index 0))
      [(CompilerMaybeSourceSpan.Some span) (CompilerMaybeSourceSpan.Some span)]
      [(CompilerMaybeSourceSpan.No)
        (lower-expr-list-first-span-at exprs (+ index 1))])))

(define (lower-expr-list-first-span [exprs : AstExprList]) : CompilerMaybeSourceSpan
  (lower-expr-list-first-span-at (& exprs) 0))

(define (lower-expr-id-or-list-first-span [first : i64] [exprs : AstExprList]) : CompilerMaybeSourceSpan
  (match (lower-expr-id-span first)
    [(CompilerMaybeSourceSpan.Some span) (CompilerMaybeSourceSpan.Some span)]
    [(CompilerMaybeSourceSpan.No) (lower-expr-list-first-span exprs)]))

(define (lower-let-binding-list-first-span-at
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : CompilerMaybeSourceSpan
  (if (>= index (ast-let-binding-list-len bindings))
    (CompilerMaybeSourceSpan.No)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ value)
        (match (lower-expr-id-span value)
          [(CompilerMaybeSourceSpan.Some span)
            (CompilerMaybeSourceSpan.Some span)]
          [(CompilerMaybeSourceSpan.No)
            (lower-let-binding-list-first-span-at bindings (+ index 1))])])))

(define (lower-let-binding-list-first-span [bindings : AstLetBindingList]) : CompilerMaybeSourceSpan
  (lower-let-binding-list-first-span-at (& bindings) 0))

(define (lower-match-arm-list-first-span-at
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : CompilerMaybeSourceSpan
  (if (>= index (ast-match-arm-list-len arms))
    (CompilerMaybeSourceSpan.No)
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body)
        (match (lower-expr-id-span body)
          [(CompilerMaybeSourceSpan.Some span)
            (CompilerMaybeSourceSpan.Some span)]
          [(CompilerMaybeSourceSpan.No)
            (lower-match-arm-list-first-span-at arms (+ index 1))])])))

(define (lower-match-arm-list-first-span [arms : AstMatchArmList]) : CompilerMaybeSourceSpan
  (lower-match-arm-list-first-span-at (& arms) 0))

(define (lower-resource-binding-list-first-span-at
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : CompilerMaybeSourceSpan
  (if (>= index (ast-resource-binding-list-len bindings))
    (CompilerMaybeSourceSpan.No)
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ init cleanup _)
        (match (lower-expr-id-first-span2 init cleanup)
          [(CompilerMaybeSourceSpan.Some span)
            (CompilerMaybeSourceSpan.Some span)]
          [(CompilerMaybeSourceSpan.No)
            (lower-resource-binding-list-first-span-at bindings (+ index 1))])])))

(define (lower-resource-binding-list-first-span
  [bindings : AstResourceBindingList]) : CompilerMaybeSourceSpan
  (lower-resource-binding-list-first-span-at (& bindings) 0))

(define (lower-ast-expr-direct-span [expr : AstExpr]) : CompilerMaybeSourceSpan
  (match expr
    [(AstExpr.Spanned _ span) (CompilerMaybeSourceSpan.Some span)]
    [_ (CompilerMaybeSourceSpan.No)]))

;; Best-available diagnostic source span for an expression. Prefer the parser's
;; outer `AstExpr.Spanned` wrapper, then fall back to the first source-carrying
;; child of common transformed/generated expression nodes.
(define (lower-ast-expr-span [expr : AstExpr]) : CompilerMaybeSourceSpan
  (match expr
    [(AstExpr.Spanned _ span) (CompilerMaybeSourceSpan.Some span)]
    [(AstExpr.Binary _ left right) (lower-expr-id-first-span2 left right)]
    [(AstExpr.Unary _ inner) (lower-expr-id-span inner)]
    [(AstExpr.Call callee args) (lower-expr-id-or-list-first-span callee args)]
    [(AstExpr.If cond then-expr else-expr)
      (lower-expr-id-first-span3 cond then-expr else-expr)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body)
          (match (lower-let-binding-list-first-span bindings)
            [(CompilerMaybeSourceSpan.Some span)
              (CompilerMaybeSourceSpan.Some span)]
            [(CompilerMaybeSourceSpan.No) (lower-expr-id-span body)])])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body) (lower-expr-id-span body)])]
    [(AstExpr.Tuple values) (lower-expr-list-first-span values)]
    [(AstExpr.TupleRef target _) (lower-expr-id-span target)]
    [(AstExpr.Array values) (lower-expr-list-first-span values)]
    [(AstExpr.DynArray values) (lower-expr-list-first-span values)]
    [(AstExpr.MakeArray _ size) (lower-expr-id-span size)]
    [(AstExpr.ArrayRef target index) (lower-expr-id-first-span2 target index)]
    [(AstExpr.ArraySet target index value)
      (lower-expr-id-first-span3 target index value)]
    [(AstExpr.ArrayTake target live index)
      (lower-expr-id-first-span3 target live index)]
    [(AstExpr.ArrayPush target value) (lower-expr-id-first-span2 target value)]
    [(AstExpr.StringRef target index) (lower-expr-id-first-span2 target index)]
    [(AstExpr.While cond body) (lower-expr-id-first-span2 cond body)]
    [(AstExpr.Begin exprs) (lower-expr-list-first-span exprs)]
    [(AstExpr.Unsafe exprs) (lower-expr-list-first-span exprs)]
    [(AstExpr.Set _ value) (lower-expr-id-span value)]
    [(AstExpr.Ann inner _) (lower-expr-id-span inner)]
    [(AstExpr.Cast inner _) (lower-expr-id-span inner)]
    [(AstExpr.Borrow _ _ inner) (lower-expr-id-span inner)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee arms)
          (match (lower-expr-id-span scrutinee)
            [(CompilerMaybeSourceSpan.Some span)
              (CompilerMaybeSourceSpan.Some span)]
            [(CompilerMaybeSourceSpan.No)
              (lower-match-arm-list-first-span arms)])])]
    [(AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(AstForeach.Foreach _ _ start end body)
          (lower-expr-id-first-span3 start end body)])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start end init value)
          (match (lower-expr-id-first-span3 start end init)
            [(CompilerMaybeSourceSpan.Some span)
              (CompilerMaybeSourceSpan.Some span)]
            [(CompilerMaybeSourceSpan.No) (lower-expr-id-span value)])])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan _ _ _ start end _ _ init value body)
          (match (lower-expr-id-first-span3 start end init)
            [(CompilerMaybeSourceSpan.Some span)
              (CompilerMaybeSourceSpan.Some span)]
            [(CompilerMaybeSourceSpan.No)
              (lower-expr-id-first-span2 value body)])])]
    [(AstExpr.SpmdBroadcast value lane) (lower-expr-id-first-span2 value lane)]
    [(AstExpr.SpmdShuffle value lane) (lower-expr-id-first-span2 value lane)]
    [(AstExpr.StructGet target _) (lower-expr-id-span target)]
    [(AstExpr.StructSet target _ value)
      (lower-expr-id-first-span2 target value)]
    [(AstExpr.WithRegion _ body) (lower-expr-list-first-span body)]
    [(AstExpr.WithEscape escape body)
      (lower-expr-id-or-list-first-span escape body)]
    [(AstExpr.WithScratch body) (lower-expr-list-first-span body)]
    [(AstExpr.InArena arena body) (lower-expr-id-or-list-first-span arena body)]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (lower-resource-binding-list-first-span bindings)
            [(CompilerMaybeSourceSpan.Some span)
              (CompilerMaybeSourceSpan.Some span)]
            [(CompilerMaybeSourceSpan.No) (lower-expr-list-first-span body)])])]
    [(AstExpr.Box value) (lower-expr-id-span value)]
    [(AstExpr.BoxGet value) (lower-expr-id-span value)]
    [(AstExpr.BoxTake value) (lower-expr-id-span value)]
    [(AstExpr.BoxSet target value) (lower-expr-id-first-span2 target value)]
    [(AstExpr.Comptime inner) (lower-expr-id-span inner)]
    [(AstExpr.Quote inner) (lower-expr-id-span inner)]
    [(AstExpr.Quasiquote inner) (lower-expr-id-span inner)]
    [(AstExpr.Unquote inner) (lower-expr-id-span inner)]
    [(AstExpr.UnquoteSplicing inner) (lower-expr-id-span inner)]
    [(AstExpr.Try inner) (lower-expr-id-span inner)]
    [(AstExpr.Return inner) (lower-expr-id-span inner)]
    [(AstExpr.PtrNullCheck inner) (lower-expr-id-span inner)]
    [(AstExpr.PtrAddrOf inner) (lower-expr-id-span inner)]
    [(AstExpr.PtrRead inner) (lower-expr-id-span inner)]
    [(AstExpr.PtrWrite target value) (lower-expr-id-first-span2 target value)]
    [(AstExpr.PtrOffset target offset)
      (lower-expr-id-first-span2 target offset)]
    [(AstExpr.PtrCast inner _) (lower-expr-id-span inner)]
    [(AstExpr.PtrToInt inner) (lower-expr-id-span inner)]
    [(AstExpr.IntToPtr inner _) (lower-expr-id-span inner)]
    [(AstExpr.StringData inner) (lower-expr-id-span inner)]
    [(AstExpr.StringFromBytes data len) (lower-expr-id-first-span2 data len)]
    [(AstExpr.ArrayData inner) (lower-expr-id-span inner)]
    [(AstExpr.CpuIdEax leaf subleaf) (lower-expr-id-first-span2 leaf subleaf)]
    [(AstExpr.CpuIdEbx leaf subleaf) (lower-expr-id-first-span2 leaf subleaf)]
    [(AstExpr.CpuIdEcx leaf subleaf) (lower-expr-id-first-span2 leaf subleaf)]
    [(AstExpr.CpuIdEdx leaf subleaf) (lower-expr-id-first-span2 leaf subleaf)]
    [(AstExpr.Xgetbv inner) (lower-expr-id-span inner)]
    [(AstExpr.Syscall args) (lower-expr-list-first-span args)]
    [(AstExpr.BracketClause items) (lower-expr-list-first-span items)]
    [_ (CompilerMaybeSourceSpan.No)]))

(define (lower-diagnostic-at-expr [expr : AstExpr] [message : String]) : CompilerDiagnostic
  (match (lower-ast-expr-span expr)
    [(CompilerMaybeSourceSpan.Some span)
      (compiler-diagnostic-from-ast-span "" span message)]
    [(CompilerMaybeSourceSpan.No) (lower-diagnostic message)]))

(define (lower-diagnostic-with-path [diag : CompilerDiagnostic] [path : String]) : CompilerDiagnostic
  (compiler-diagnostic-with-path diag path))

(define (lower-reference-support-message) : String
  "lower: reference-typed programs require borrow/reference lowering support")

(define (lower-bytes-view-from-parts-name? [name : String]) : bool
  (let
    [base : String
      (if (tc-name-qualified? name)
        (tc-qualified-name-base name)
        name)]
    (or
      (string.eq base "tl_bytes_view_from_str_parts")
      (string.eq base "tl_bytes_view_from_buf_parts")
      (string.eq base "tl_bytes_mut_view_from_buf_parts")
      (string.eq base "tl_bytes_view_from_bytes_parts")
      (string.eq base "tl_bytes_mut_view_from_bytes_parts"))))

(define (lower-supported-reference-extern?
  [ctx : TcContext]
  [name : i64]
  [ty : AstType]) : bool
  (let
    [_ : TcContext ctx]
    [_ty : AstType ty]
    (or
      (cbi.compiler-builtin-backend-tl-str-view-id? name)
      (string.eq (tc-env-key-name-text name) "tl_str_view")
      (lower-bytes-view-from-parts-name? (tc-env-key-name-text name)))))

(define (lower-name-env-lookup-symbol-id
  [names : LowerNameEnv]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [cur : LowerNameEnv names]
    [result : i64 fallback]
    [done : bool false]
    (begin
      (while (and
        (not done)
        (match cur
          [(LowerNameEnv.Nil) false]
          [_ true]))
        (match cur
          [(LowerNameEnv.Nil) unit]
          [(LowerNameEnv.Bind bind-id _ symbol-id rest)
            (if (and (>= source-id 0) (= bind-id source-id))
              (begin
                (set! result symbol-id)
                (set! done true))
              (set! cur (box-get rest)))]))
      result)))

(define (lower-name-env-lookup-with-id [names : LowerNameEnv] [source-id : i64]) : TcMaybeString
  (let
    [symbol-id : i64 (lower-name-env-lookup-symbol-id names source-id -1)]
    (if (>= symbol-id 0)
      (TcMaybeString.Some (tc-env-key-name-text symbol-id))
      (TcMaybeString.No))))

(define (lower-name-env-resolve-with-id
  [names : LowerNameEnv]
  [source-name : String]
  [source-id : i64]) : String
  (match (lower-name-env-lookup-with-id names source-id)
    [(TcMaybeString.Some logical) logical]
    [(TcMaybeString.No) source-name]))

(define (lower-name-env-count [names : LowerNameEnv]) : i64
  (let
    [cur : LowerNameEnv names]
    [count : i64 0]
    (begin
      (while (match cur
        [(LowerNameEnv.Nil) false]
        [_ true])
        (match cur
          [(LowerNameEnv.Nil) unit]
          [(LowerNameEnv.Bind _ _ _ rest)
            (begin
              (set! count (+ count 1))
              (set! cur (box-get rest)))]))
      count)))

(define (lower-name-env-append [left : LowerNameEnv] [right : LowerNameEnv]) : LowerNameEnv
  (let
    [cur : LowerNameEnv left]
    [reversed : LowerNameEnv LowerNameEnv.Nil]
    [out : LowerNameEnv right]
    (begin
      (while (match cur
        [(LowerNameEnv.Nil) false]
        [_ true])
        (match cur
          [(LowerNameEnv.Nil) unit]
          [(LowerNameEnv.Bind source-id logical-id symbol-id rest)
            (begin
              (set!
                reversed
                (LowerNameEnv.Bind
                  source-id
                  logical-id
                  symbol-id
                  (box reversed)))
              (set! cur (box-get rest)))]))
      (set! cur reversed)
      (while (match cur
        [(LowerNameEnv.Nil) false]
        [_ true])
        (match cur
          [(LowerNameEnv.Nil) unit]
          [(LowerNameEnv.Bind source-id logical-id symbol-id rest)
            (begin
              (set!
                out
                (LowerNameEnv.Bind source-id logical-id symbol-id (box out)))
              (set! cur (box-get rest)))]))
      out)))

(define (lower-name-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (lower-logical-display-name-select
  [display : String]
  [logical-id : i64]
  [direct : bool]) : String
  (if direct
    (intern-str logical-id)
    display))

(define (lower-derived-symbol-id [logical-name : String]) : i64
  (ci.intern-generated-canonical-name logical-name))

(define (lower-logical-symbol-id-select
  [logical-name : String]
  [logical-id : i64]
  [direct : bool]) : i64
  (if direct
    logical-id
    (lower-derived-symbol-id logical-name)))

(define (lower-logical-symbol-id-direct? [logical-id : i64] [source-id : i64]) : bool
  (and (= logical-id source-id) (tc-env-key-has-name-id? logical-id)))

(define (lower-name-cache-logical-module-id [logical-id : i64]) : i64
  (cond
    [(compiler-composite-triple-key-id? logical-id)
      (compiler-composite-triple-left-id logical-id)]
    [(compiler-composite-pair-key-id? logical-id)
      (compiler-composite-pair-left-id logical-id)]
    [else -1]))

(define (lower-module-path-index-add-logical-id
  [index : LowerModulePathIndex]
  [logical-id : i64]) : LowerModulePathIndex
  (let
    [module-id : i64 (lower-name-cache-logical-module-id logical-id)]
    (if (or
      (< module-id 0)
      (>= module-id (intern-capacity))
      (compiler-symbol-root-module-id? module-id))
      index
      (let
        [edges : lower_i64_i64_map.Map (struct-get index edges)]
        [terminals : lower_i64_i64_map.Map (struct-get index terminals)]
        [modules : lower_i64_i64_map.Map (struct-get index modules)]
        [next-node : i64 (struct-get index next-node)]
        (match (lower_i64_i64_map.get (& modules) module-id)
          [(lower_i64_i64_map.LookupFound _) index]
          [(lower_i64_i64_map.LookupMissing)
            (let
              [current : i64 module-id]
              [node : i64 0]
              (begin
                (lower_i64_i64_map.insert-ref! (&mut modules) module-id 1)
                (while (>= current 0)
                  (let
                    [segment : i64
                      (if (intern-dotted? current)
                        (intern-leading-dot-id current)
                        current)]
                    [edge-key : i64
                      (compiler-composite-pair-key-id node segment)]
                    [child : i64
                      (lower_i64_i64_map.get-value-or (& edges) edge-key -1)]
                    (begin
                      (if (< child 0)
                        (begin
                          (set! child next-node)
                          (set! next-node (+ next-node 1))
                          (lower_i64_i64_map.insert-ref!
                            (&mut edges)
                            edge-key
                            child))
                        unit)
                      (set! node child)
                      (set!
                        current
                        (if (intern-dotted? current)
                          (intern-dotted-tail-id current)
                          -1)))))
                (lower_i64_i64_map.insert-ref! (&mut terminals) node module-id)
                (LowerModulePathIndex edges terminals modules next-node)))])))))

(defenum LowerNameCacheMaybeId
  (No)
  (Some i64))

(define (lower-name-env-bind-logical-id
  [source-id : i64]
  [logical-name : String]
  [logical-id : i64]
  [rest : LowerNameEnv]) : LowerNameEnv
  (LowerNameEnv.Bind
    source-id
    logical-id
    (lower-derived-symbol-id logical-name)
    (box rest)))

(define (lower-name-env-bind-logical-symbol-id
  [source-id : i64]
  [logical-id : i64]
  [symbol-id : i64]
  [rest : LowerNameEnv]) : LowerNameEnv
  (LowerNameEnv.Bind source-id logical-id symbol-id (box rest)))

(define (lower-name-env-bind-cached-logical-id
  [source-id : i64]
  [logical-name : String]
  [logical-id : i64]
  [cache : LowerNameCache]
  [rest : LowerNameEnv]) : LowerNameEnv
  (lower-name-env-bind-logical-symbol-id
    source-id
    logical-id
    (lower-name-cache-lookup-symbol-id
      (& cache)
      logical-id
      (lower-derived-symbol-id logical-name))
    rest))

(define (lower-extern-logical-symbol-id
  [logical-id : i64]
  [logical-name : String]
  [source-id : i64]
  [metadata : AstExternMetadata]) : i64
  (let
    [direct : bool (lower-logical-symbol-id-direct? logical-id source-id)]
    [link-id : i64 (ast-extern-metadata-symbol-id metadata)]
    (if (and (ast-extern-metadata-symbol-matches-source? metadata) direct)
      link-id
      (lower-logical-symbol-id-select logical-name logical-id direct))))

(define (lower-name-cache-add-id
  [cache : LowerNameCache]
  [source-id : i64]
  [logical-id : i64]
  [fallback-symbol-id : i64]) : LowerNameCache
  (let
    [ids : lower_i64_i64_map.Map (struct-get cache ids)]
    [logical-ids : (Array i64) (struct-get cache logical-ids)]
    [symbol-ids : (Array i64) (struct-get cache symbol-ids)]
    [logical-symbols : lower_i64_i64_map.Map (struct-get cache logical-symbols)]
    [module-paths : LowerModulePathIndex (struct-get cache module-paths)]
    (if (< source-id 0)
      cache
      (match (lower_i64_i64_map.get (& ids) source-id)
        [(lower_i64_i64_map.LookupFound _) cache]
        [(lower_i64_i64_map.LookupMissing)
          (let
            [next : i64 (lower_i64_i64_map.len (& ids))]
            [logical-slot : i64
              (lower_i64_i64_map.get-value-or (& ids) logical-id -1)]
            [symbol-id : i64
              (if (>= logical-slot 0)
                (array-ref symbol-ids logical-slot)
                (let
                  [local-symbol-id : i64
                    (lower_i64_i64_map.get-value-or
                      (& logical-symbols)
                      logical-id
                      -1)]
                  (if (>= local-symbol-id 0)
                    local-symbol-id
                    (match (struct-get cache parent)
                      [(LowerNameParent.None) -1]
                      [(LowerNameParent.Global)
                        (lower-name-cache-lookup-symbol-id
                          (& lower-active-global-name-cache)
                          logical-id
                          -1)]))))]
            (begin
              (when (< symbol-id 0) (set! symbol-id fallback-symbol-id))
              (array-set! logical-ids next logical-id)
              (array-set! symbol-ids next symbol-id)
              (lower_i64_i64_map.insert-ref! (&mut ids) source-id next)
              (when
                (and (< logical-slot 0) (not (= source-id logical-id)))
                (lower_i64_i64_map.insert-ref!
                  (&mut logical-symbols)
                  logical-id
                  symbol-id))
              (set!
                module-paths
                (lower-module-path-index-add-logical-id module-paths logical-id))
              (LowerNameCache
                ids
                logical-ids
                symbol-ids
                logical-symbols
                module-paths
                (struct-get cache clone-roots)
                (struct-get cache module-id)
                (struct-get cache parent))))]))))

(define (lower-name-cache-from-env-into
  [names : LowerNameEnv]
  [cache : LowerNameCache]) : LowerNameCache
  (let
    [cur : LowerNameEnv names]
    [out : LowerNameCache cache]
    (begin
      (while (match cur
        [(LowerNameEnv.Nil) false]
        [_ true])
        (match cur
          [(LowerNameEnv.Nil) unit]
          [(LowerNameEnv.Bind source-id logical-id symbol-id rest)
            (begin
              (set!
                out
                (lower-name-cache-add-id out source-id logical-id symbol-id))
              (set! cur (box-get rest)))]))
      out)))

(define (lower-name-cache-from-env [names : LowerNameEnv]) : LowerNameCache
  (let
    [count : i64 (lower-name-env-count names)]
    (lower-name-cache-from-env-into
      names
      (LowerNameCache
        (lower_i64_i64_map.with-capacity (lower-name-cache-capacity count))
        (make-array i64 count)
        (make-array i64 count)
        (lower_i64_i64_map.with-capacity 64)
        (lower-module-path-index-empty)
        (CloneNameList.Nil)
        cbi.compiler-builtin-id-fix-empty
        (LowerNameParent.None)))))

;; Build a small overlay name cache from `names` (the module-local names
;; only). On a miss it falls through to the shared global cache
;; `lower-active-global-name-cache` (see lower-name-cache-resolve-logical-id).
(define (lower-name-cache-overlay [names : LowerNameEnv] [module-id : i64]) : LowerNameCache
  (let
    [count : i64 (lower-name-env-count names)]
    (lower-name-cache-from-env-into
      names
      (LowerNameCache
        (lower_i64_i64_map.with-capacity (lower-name-cache-capacity count))
        (make-array i64 count)
        (make-array i64 count)
        (lower_i64_i64_map.with-capacity 16)
        (lower-module-path-index-empty)
        (CloneNameList.Nil)
        module-id
        (LowerNameParent.Global)))))

(define (lower-name-cache-with-module-id
  [cache : LowerNameCache]
  [module-id : i64]) : LowerNameCache
  (LowerNameCache
    (struct-get cache ids)
    (struct-get cache logical-ids)
    (struct-get cache symbol-ids)
    (struct-get cache logical-symbols)
    (struct-get cache module-paths)
    (struct-get cache clone-roots)
    module-id
    (struct-get cache parent)))

(define (lower-name-cache-with-clone-roots
  [cache : LowerNameCache]
  [roots : CloneNameList]) : LowerNameCache
  (LowerNameCache
    (struct-get cache ids)
    (struct-get cache logical-ids)
    (struct-get cache symbol-ids)
    (struct-get cache logical-symbols)
    (struct-get cache module-paths)
    roots
    (struct-get cache module-id)
    (struct-get cache parent)))

(define (lower-name-cache-clone-helper-id
  [cache : LowerNameCache]
  [type-key-id : i64]) : i64
  (let
    [helper-id : i64
      (clone-name-list-helper-id-or
        (struct-get cache clone-roots)
        type-key-id
        -1)]
    (if (>= helper-id 0)
      helper-id
      (match (struct-get cache parent)
        [(LowerNameParent.None) -1]
        [(LowerNameParent.Global)
          (lower-name-cache-clone-helper-id
            lower-active-global-name-cache
            type-key-id)]))))

(define (lower-name-cache-clone-key-id
  [cache : LowerNameCache]
  [type-key-id : i64]) : i64
  (if (>= (lower-name-cache-clone-helper-id cache type-key-id) 0)
    type-key-id
    (let
      [candidate : i64
        (clone-name-list-unique-key-for-base-id-or
          (struct-get cache clone-roots)
          (clone-name-key-base-id type-key-id)
          -1)]
      (if (>= candidate 0)
        candidate
        (match (struct-get cache parent)
          [(LowerNameParent.None) -1]
          [(LowerNameParent.Global)
            (lower-name-cache-clone-key-id
              lower-active-global-name-cache
              type-key-id)])))))

(define (lower-name-cache-lookup-id [cache : LowerNameCache] [source-id : i64]) : TcMaybeString
  (let
    [index : i64
      (lower_i64_i64_map.get-value-or (& (struct-get cache ids)) source-id -1)]
    (if (>= index 0)
      (TcMaybeString.Some
        (tc-env-key-name-text (array-ref (struct-get cache symbol-ids) index)))
      (match (struct-get cache parent)
        [(LowerNameParent.None) (TcMaybeString.No)]
        [(LowerNameParent.Global)
          (lower-name-cache-lookup-id lower-active-global-name-cache source-id)]))))

(define (lower-name-cache-lookup-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [index : i64
      (lower_i64_i64_map.get-value-or (& (struct-get cache ids)) source-id -1)]
    (if (>= index 0)
      (array-ref (struct-get cache logical-ids) index)
      (match (struct-get cache parent)
        [(LowerNameParent.None) fallback]
        [(LowerNameParent.Global)
          (lower-name-cache-lookup-logical-id
            (& lower-active-global-name-cache)
            source-id
            fallback)]))))

(define (lower-name-cache-lookup-symbol-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [index : i64
      (lower_i64_i64_map.get-value-or (& (struct-get cache ids)) source-id -1)]
    (if (>= index 0)
      (array-ref (struct-get cache symbol-ids) index)
      (let
        [symbol-id : i64
          (lower_i64_i64_map.get-value-or
            (& (struct-get cache logical-symbols))
            source-id
            -1)]
        (if (>= symbol-id 0)
          symbol-id
          (match (struct-get cache parent)
            [(LowerNameParent.None) fallback]
            [(LowerNameParent.Global)
              (lower-name-cache-lookup-symbol-id
                (& lower-active-global-name-cache)
                source-id
                fallback)]))))))

(define (lower-module-path-index-resolve-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [paths : LowerModulePathIndex (struct-get cache module-paths)]
    [edges : lower_i64_i64_map.Map (struct-get paths edges)]
    [terminals : lower_i64_i64_map.Map (struct-get paths terminals)]
    [current : i64 source-id]
    [node : i64 0]
    [result : i64 fallback]
    [done : bool false]
    (begin
      (while (and (not done) (intern-dotted? current))
        (let
          [segment : i64 (intern-leading-dot-id current)]
          [remainder : i64 (intern-dotted-tail-id current)]
          [edge-key : i64 (compiler-composite-pair-key-id node segment)]
          [child : i64 (lower_i64_i64_map.get-value-or (& edges) edge-key -1)]
          (if (< child 0)
            (set! done true)
            (let
              [module-id : i64
                (lower_i64_i64_map.get-value-or (& terminals) child -1)]
              (begin
                (set! node child)
                (when
                  (and (>= module-id 0) (>= remainder 0))
                  (let
                    [raw-logical-id : i64
                      (lower-name-cache-lookup-logical-id
                        cache
                        (compiler-symbol-module-key-id-by-id
                          module-id
                          remainder)
                        -1)]
                    (if (>= raw-logical-id 0)
                      (set! result raw-logical-id)
                      (when
                        (and
                          (intern-dotted? remainder)
                          (not
                            (intern-dotted? (intern-dotted-tail-id remainder))))
                        (let
                          [qualified-base-id : i64
                            (compiler-composite-pair-key-id
                              (intern-leading-dot-id remainder)
                              (intern-dotted-tail-id remainder))]
                          [qualified-logical-id : i64
                            (lower-name-cache-lookup-logical-id
                              cache
                              (compiler-symbol-module-key-id-by-id
                                module-id
                                qualified-base-id)
                              -1)]
                          (when
                            (>= qualified-logical-id 0)
                            (set! result qualified-logical-id)))))))
                (set! current remainder))))))
      (if (and
        (< result 0)
        (match (struct-get cache parent)
          [(LowerNameParent.Global) true]
          [(LowerNameParent.None) false]))
        (lower-module-path-index-resolve-logical-id
          (& lower-active-global-name-cache)
          source-id
          fallback)
        result))))

(define (lower-name-cache-resolve-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [module-id : i64 (struct-get cache module-id)]
    [source-key-id : i64 (tc-env-name-key-id source-id)]
    ;; Qualified macro-hygiene symbols carry the macro definition module as
    ;; their qualifier and the parsed source lookup ID as their base. A dotted
    ;; base therefore has all of the structural path information needed to
    ;; resolve the referenced declaration after a direct lookup misses.
    [path-source-id : i64
      (if (and
        (tc-env-key-has-name-id? source-id)
        (intern-qualified? source-id)
        (intern-dotted? (intern-qualified-base-id source-id)))
        (intern-qualified-base-id source-id)
        source-id)]
    [module-local : i64
      (if (and
        (not (compiler-symbol-root-module-id? module-id))
        (= source-key-id source-id)
        (tc-env-key-has-name-id? source-id)
        (not (intern-dotted? source-id)))
        (lower-name-cache-lookup-logical-id
          cache
          (compiler-symbol-module-key-id-by-id module-id source-id)
          -1)
        -1)]
    (if (>= module-local 0)
      module-local
      (let
        [direct : i64
          (lower-name-cache-lookup-logical-id cache source-key-id -1)]
        (if (>= direct 0)
          direct
          (if (and
            (tc-env-key-has-name-id? path-source-id)
            (intern-dotted? path-source-id))
            (let
              [alias-logical-id : i64
                (lower-name-cache-lookup-logical-id
                  cache
                  (compiler-symbol-module-key-id-by-id
                    (intern-leading-dot-id path-source-id)
                    (intern-dotted-tail-id path-source-id))
                  -1)]
              (if (>= alias-logical-id 0)
                alias-logical-id
                (let
                  [path-logical-id : i64
                    (lower-module-path-index-resolve-logical-id
                      cache
                      path-source-id
                      -1)]
                  (if (>= path-logical-id 0)
                    path-logical-id
                    fallback))))
            fallback))))))

(define (lower-name-cache-resolve-symbol-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [logical-id : i64 (lower-name-cache-resolve-logical-id cache source-id -1)]
    (if (< logical-id 0)
      fallback
      (lower-name-cache-lookup-symbol-id cache logical-id fallback))))

(define (lower-name-cache-contains-local-id?
  [cache : LowerNameCache]
  [source-id : i64]) : bool
  (if (< source-id 0)
    false
    (>=
      (lower_i64_i64_map.get-value-or (& (struct-get cache ids)) source-id -1)
      0)))

(define (lower-name-cache-resolve-id-display
  [cache : LowerNameCache]
  [source-id : i64]) : TcMaybeString
  (let
    [source-key-id : i64 (tc-env-name-key-id source-id)]
    [logical-id : i64
      (lower-name-cache-resolve-logical-id (& cache) source-id -1)]
    (match (lower-name-cache-lookup-id cache source-key-id)
      [(TcMaybeString.Some logical-name) (TcMaybeString.Some logical-name)]
      [(TcMaybeString.No)
        (if (< logical-id 0)
          (TcMaybeString.No)
          (lower-name-cache-lookup-id cache logical-id))])))

(define (lower-type-env-count [env : TcTypeEnv]) : i64
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) 0]
    [(TcTypeEnvSpineStep.Cache rest-env) (lower-type-env-count rest-env)]
    [(TcTypeEnvSpineStep.Bind _ _ rest-env)
      (+ 1 (lower-type-env-count rest-env))]))

(define (lower-type-env-contains-reference? [env : TcTypeEnv]) : bool
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) false]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (lower-type-env-contains-reference? rest-env)]
    [(TcTypeEnvSpineStep.Bind _ ty rest-env)
      (if (tc-type-contains-reference? ty)
        true
        (lower-type-env-contains-reference? rest-env))]))

(define (lower-type-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (lower-type-cache-add
  [cache : LowerTypeCache]
  [name-id : i64]
  [ty : AstType]) : LowerTypeCache
  (match cache
    [(LowerTypeCache.No) cache]
    [(LowerTypeCache.Some ids values next parent)
      (match (lower_i64_i64_map.get (& ids) name-id)
        [(lower_i64_i64_map.LookupFound _) cache]
        [(lower_i64_i64_map.LookupMissing)
          (begin
            (array-set! values next ty)
            (lower_i64_i64_map.insert-ref! (&mut ids) name-id next)
            (LowerTypeCache.Some ids values (+ next 1) parent))])]))

(define (lower-type-cache-from-env-into
  [env : TcTypeEnv]
  [cache : LowerTypeCache]) : LowerTypeCache
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) cache]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (lower-type-cache-from-env-into rest-env cache)]
    [(TcTypeEnvSpineStep.Bind name-id ty rest-env)
      (lower-type-cache-from-env-into
        rest-env
        (lower-type-cache-add cache name-id ty))]))

(define (lower-type-cache-from-env [env : TcTypeEnv]) : LowerTypeCache
  (let
    [count : i64 (lower-type-env-count env)]
    (lower-type-cache-from-env-into
      env
      (LowerTypeCache.Some
        (lower_i64_i64_map.with-capacity (lower-type-cache-capacity count))
        (make-array AstType count)
        0
        (LowerTypeParent.None)))))

;; Build a small overlay type cache from `env` (the module-local type
;; bindings only). On a miss it falls through to the shared global cache
;; `lower-decls-global-type-cache` (see lower-type-cache-lookup-id).
(define (lower-type-cache-overlay [env : TcTypeEnv]) : LowerTypeCache
  (let
    [count : i64 (lower-type-env-count env)]
    (lower-type-cache-from-env-into
      env
      (LowerTypeCache.Some
        (lower_i64_i64_map.with-capacity (lower-type-cache-capacity count))
        (make-array AstType count)
        0
        (LowerTypeParent.Global)))))

(define (lower-type-cache-lookup-id
  [cache : LowerTypeCache]
  [name-id : i64]
  [display-name : String]) : ResultTcType
  (match cache
    [(LowerTypeCache.No)
      (ResultTcType.Err (string.append "typecheck: unbound name " display-name))]
    [(LowerTypeCache.Some ids values _ parent)
      (let
        [index : i64 (lower_i64_i64_map.get-value-or (& ids) name-id -1)]
        (if (>= index 0)
          (ResultTcType.Ok (array-ref values index))
          (match parent
            [(LowerTypeParent.None)
              (ResultTcType.Err
                (string.append "typecheck: unbound name " display-name))]
            [(LowerTypeParent.Global)
              (lower-type-cache-lookup-id
                lower-decls-global-type-cache
                name-id
                display-name)])))]))

(define (lower-hygiene-source-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
      [(TcHygieneGlobalName.Context module lookup-name)
        (if (tc-name-qualified? lookup-name)
          lookup-name
          (compiler-symbol-module-key module lookup-name))])
    name))

(define (lower-hygiene-fallback-source-name [name : String]) : TcMaybeString
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneGlobalName.Legacy _) (TcMaybeString.No)]
      [(TcHygieneGlobalName.Context module lookup-name)
        (if (and
          (> (string.string-length module) 0)
          (not (tc-name-qualified? lookup-name)))
          (TcMaybeString.Some lookup-name)
          (TcMaybeString.No))])
    (TcMaybeString.No)))

(define (lower-hygiene-context-source-name-id
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [module : String]
  [module-id : i64]
  [lookup-name : String]
  [lookup-name-id : i64]) : String
  (if (tc-name-qualified-id? lookup-name-id)
    lookup-name
    (if (and
      (>= lookup-name-id 0)
      (< lookup-name-id (intern-capacity))
      (>= (tc-name-first-dot-id lookup-name-id) 0))
      (match (tc-source-name-lookup-key-with-field-check
        (tc-context-with-module-id ctx module module-id)
        type-env
        lookup-name
        lookup-name-id
        true)
        [(ResultTcString.Ok resolved-name) resolved-name]
        [(ResultTcString.Err _) (compiler-symbol-module-key module lookup-name)])
      (compiler-symbol-module-key module lookup-name))))

(define (lower-hygiene-source-name-in-context-id
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [name-id : i64]) : String
  (let
    [structural? : bool (macro-hygiene-global-id? name-id)]
    [source-id : i64 (macro-hygiene-global-source-name-id-or name-id name-id)]
    [name : String (intern-str source-id)]
    (if structural?
      (let
        [module-id : i64 (macro-hygiene-global-module-id name-id)]
        (if (macro-hygiene-global-legacy-id? name-id)
          name
          (lower-hygiene-context-source-name-id
            ctx
            type-env
            (if (compiler-symbol-root-module-id? module-id)
              ""
              (intern-str module-id))
            module-id
            name
            source-id)))
      (if (tc-hygiene-global-name? name)
        (match (tc-hygiene-global-decode name)
          [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
          [(TcHygieneGlobalName.Context module lookup-name)
            (let
              [lookup-name-id : i64
                (macro-hygiene-global-source-name-id-or name-id -1)]
              [module-id : i64 (ci.intern-qualified-module-id name-id)]
              (if (and (>= lookup-name-id 0) (>= module-id 0))
                (lower-hygiene-context-source-name-id
                  ctx
                  type-env
                  module
                  module-id
                  lookup-name
                  lookup-name-id)
                (compiler-symbol-module-key module lookup-name)))])
        name))))

(define (lower-type-cache-lookup-hygiene-id
  [cache : LowerTypeCache]
  [name : String]
  [generated-name-id : i64]) : ResultTcType
  (let
    [source-name : String (lower-hygiene-source-name name)]
    [source-name-id : i64
      (macro-hygiene-global-source-name-id-or generated-name-id -1)]
    [source-key-id : i64 (tc-env-name-key-id source-name-id)]
    [lookup-id : i64
      (if (>= source-name-id 0)
        (tc-env-name-key-id generated-name-id)
        source-key-id)]
    (match (lower-type-cache-lookup-id cache lookup-id source-name)
      [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
      [(ResultTcType.Err message)
        (match (lower-hygiene-fallback-source-name name)
          [(TcMaybeString.Some fallback)
            (match (lower-type-cache-lookup-id
              cache
              (if (>= source-name-id 0)
                source-name-id
                source-key-id)
              fallback)
              [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
              [(ResultTcType.Err _) (ResultTcType.Err message)])]
          [(TcMaybeString.No) (ResultTcType.Err message)])])))

(define (lower-source-name-lookup-key-id
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [source-id : i64]) : ResultTcString
  (let
    [source-name : String (intern-str source-id)]
    (if (tc-source-slash-qualified-id? source-name source-id)
      (ResultTcString.Ok source-name)
      (tc-source-name-lookup-key-with-field-check
        ctx
        type-env
        source-name
        source-id
        true))))

(define (lower-lookup-structural-hygiene-type-id
  [ctx : TcContext]
  [type-cache : LowerTypeCache]
  [type-env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (let
    [source-id : i64 (macro-hygiene-global-source-name-id-or name-id -1)]
    [source-name : String (intern-str source-id)]
    (if (macro-hygiene-global-legacy-id? name-id)
      (lower-type-cache-lookup-id
        type-cache
        (tc-env-name-key-id source-id)
        source-name)
      (let
        [module-id : i64 (macro-hygiene-global-module-id name-id)]
        [definition-ctx : TcContext
          (if (compiler-symbol-root-module-id? module-id)
            (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
            (tc-context-with-module-id ctx (intern-str module-id) module-id))]
        (if (>= (tc-name-first-dot-id source-id) 0)
          (match (tc-source-name-lookup-key-with-field-check-lookup
            definition-ctx
            type-env
            source-name
            source-id
            true)
            [(TcNameLookup.Ok lookup-name lookup-id)
              (lower-type-cache-lookup-id
                type-cache
                (tc-env-name-key-id lookup-id)
                lookup-name)]
            [(TcNameLookup.Err message) (ResultTcType.Err message)])
          (lower-type-cache-lookup-id
            type-cache
            (compiler-symbol-module-key-id-by-id module-id source-id)
            source-name))))))

(define (lower-lookup-type-existing-id
  [ctx : TcContext]
  [type-cache : LowerTypeCache]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [name-id : i64]) : ResultTcType
  (cond
    [(tc-dotted-local-field-name-id? type-env name-id)
      (match (tc-dotted-local-field-expr-id-from-source-name-id name-id)
        [(ResultTcExprId.Ok virtual-id)
          (tc-expr ctx type-env (lower-context-expr-get ctx virtual-id))]
        [(ResultTcExprId.Err message) (ResultTcType.Err message)])]
    [(tc-hygiene-global-name? name)
      (lower-type-cache-lookup-hygiene-id type-cache name name-id)]
    [(tc-source-slash-qualified-id? name name-id)
      (let
        [lookup-key-id : i64 (tc-env-name-key-id name-id)]
        (match (lower-type-cache-lookup-id type-cache lookup-key-id name)
          [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
          [(ResultTcType.Err message)
            (match (tc-lookup-id type-env lookup-key-id)
              [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
              [(ResultTcType.Err _) (ResultTcType.Err message)])]))]
    [else
      (match (tc-source-name-lookup-key-with-field-check-lookup
        ctx
        type-env
        name
        name-id
        false)
        [(TcNameLookup.Ok lookup-name lookup-id)
          (if (sym_i64_env.sym-i64-contains-id env lookup-id)
            (tc-lookup-id type-env lookup-id)
            ;; `type-cache` is the complete global type environment plus the
            ;; current module overlay. Preserve raw generated-name hits, then
            ;; use the canonical module/base key only as the dotted-source
            ;; fallback, matching typechecking without conflating the two ID
            ;; domains.
            (match (lower-type-cache-lookup-id type-cache lookup-id lookup-name)
              [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
              [(ResultTcType.Err message)
                (let
                  [lookup-key-id : i64 (tc-env-name-key-id lookup-id)]
                  (if (= lookup-key-id lookup-id)
                    (tc-variant-constructor-type-for-lookup-or-id
                      ctx
                      lookup-id
                      (tc-source-unbound-display-message
                        ctx
                        name
                        name-id
                        lookup-name
                        message))
                    (match (tc-lookup-id type-env lookup-key-id)
                      [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
                      [(ResultTcType.Err _)
                        (tc-variant-constructor-type-for-lookup-or-id
                          ctx
                          lookup-id
                          (tc-source-unbound-display-message
                            ctx
                            name
                            name-id
                            lookup-name
                            message))])))]))]
        [(TcNameLookup.Err message) (ResultTcType.Err message)])]))

(define (lower-lookup-type-id
  [ctx : TcContext]
  [type-cache : LowerTypeCache]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (cond
    [(sym_i64_env.sym-i64-contains-id env name-id)
      (tc-lookup-id type-env name-id)]
    [(macro-hygiene-global-id? name-id)
      (lower-lookup-structural-hygiene-type-id ctx type-cache type-env name-id)]
    [(tc-env-key-has-name-id? name-id)
      (let
        [name : String (tc-env-key-name-text name-id)]
        (lower-lookup-type-existing-id ctx type-cache env type-env name name-id))]
    [else
      (lower-type-cache-lookup-id
        type-cache
        name-id
        (tc-env-key-display name-id))]))

;; Growable membership set of the interned source-ids already bound into the
;; import-alias overlay currently being built by
;; lower-name-env-from-import-aliases-in-module-cache. That overlay starts empty
;; and is accumulated strictly linearly (single accumulator, no branching or
;; re-entrant overlay builds), so an O(1) hashmap presence check can stand in for
;; the O(n) LowerNameEnv scan that lower-name-env-add-alias-if-free-id otherwise
;; runs for every added alias -- previously O(aliases^2) per module. Only
;; presence matters here, so a bare generated i64 -> i64 map (which grows) is
;; used rather than a fixed-capacity LowerNameCache.
;;
;; `valid` guards the fast path. Every alias bound through this overlay carries
;; an interned (>=0) source id, so the set stays a complete mirror; but should a
;; <0 (never-interned) id ever appear -- the only case lower-name-env-lookup-with-id
;; resolves through its string-compare gate rather than the id gate -- we drop
;; back to the exact scan for the remainder of the overlay so the Some/No result
;; stays byte-identical to the pure linear scan.
(define lower-alias-overlay-ids : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 16))
(define lower-alias-overlay-valid : bool
  true)

(define (lower-alias-overlay-reset!) : unit
  (begin
    (set! lower-alias-overlay-ids (lower_i64_i64_map.with-capacity 16))
    (set! lower-alias-overlay-valid true)))

(define (lower-alias-overlay-contains? [source-id : i64]) : bool
  (match (lower_i64_i64_map.get (& lower-alias-overlay-ids) source-id)
    [(lower_i64_i64_map.LookupFound _) true]
    [(lower_i64_i64_map.LookupMissing) false]))

(define (lower-alias-overlay-record! [source-id : i64]) : unit
  (lower_i64_i64_map.insert-ref! (&mut lower-alias-overlay-ids) source-id 1))

;; Seed the overlay membership set from an existing base environment.
(define (lower-alias-overlay-seed-from-env! [names : LowerNameEnv]) : unit
  (begin
    (set! lower-alias-overlay-ids (lower_i64_i64_map.with-capacity 256))
    (set! lower-alias-overlay-valid true)
    (let
      [cur : LowerNameEnv names]
      (while (match cur
        [(LowerNameEnv.Nil) false]
        [_ true])
        (match cur
          [(LowerNameEnv.Nil) unit]
          [(LowerNameEnv.Bind bind-id _ _ rest)
            (begin
              (if (< bind-id 0)
                (set! lower-alias-overlay-valid false)
                (lower_i64_i64_map.insert-ref!
                  (&mut lower-alias-overlay-ids)
                  bind-id
                  1))
              (set! cur (box-get rest)))])))))

(define (lower-name-env-add-alias-if-free-id
  [names : LowerNameEnv]
  [_ : String]
  [source-id : i64]
  [logical-name : String]
  [logical-id : i64]) : LowerNameEnv
  (match (lower-name-env-lookup-with-id names source-id)
    [(TcMaybeString.Some _) names]
    [(TcMaybeString.No)
      (lower-name-env-bind-logical-symbol-id
        source-id
        logical-id
        (lower-logical-symbol-id-select
          logical-name
          logical-id
          (lower-logical-symbol-id-direct? logical-id source-id))
        names)]))

(define (lower-name-env-add-import-alias-binding-symbol-id
  [names : LowerNameEnv]
  [alias : String]
  [_ : String]
  [source-id : i64]
  [_ : String]
  [logical-id : i64]
  [symbol-id : i64]) : LowerNameEnv
  (begin
    (when (< source-id 0) (set! lower-alias-overlay-valid false))
    ;; Aliased import (non-empty alias): unconditional bind; keep the overlay set
    ;; in sync so a later empty-alias dedup still sees this id as present.
    (when
      (not (string.eq alias ""))
      (when lower-alias-overlay-valid (lower-alias-overlay-record! source-id))
      (return
        (lower-name-env-bind-logical-symbol-id
          source-id
          logical-id
          symbol-id
          names)))
    ;; Empty alias, degraded set (a <0 id appeared): exact linear scan preserves
    ;; the Some/No decision byte-for-byte.
    (when
      (not lower-alias-overlay-valid)
      (return
        (match (lower-name-env-lookup-with-id names source-id)
          [(TcMaybeString.Some _) names]
          [(TcMaybeString.No)
            (lower-name-env-bind-logical-symbol-id
              source-id
              logical-id
              symbol-id
              names)])))
    ;; Fast path: O(1) membership check against the base-seeded overlay set,
    ;; same accept decision as scanning `names`.
    (when (lower-alias-overlay-contains? source-id) (return names))
    (lower-alias-overlay-record! source-id)
    (lower-name-env-bind-logical-symbol-id source-id logical-id symbol-id names)))

(define (lower-name-env-add-import-alias-binding-id
  [names : LowerNameEnv]
  [alias : String]
  [source-name : String]
  [source-id : i64]
  [logical-name : String]
  [logical-id : i64]
  [direct : bool]) : LowerNameEnv
  (lower-name-env-add-import-alias-binding-symbol-id
    names
    alias
    source-name
    source-id
    logical-name
    logical-id
    (lower-logical-symbol-id-select logical-name logical-id direct)))

(define (lower-name-env-add-import-alias-binding-base-id
  [names : LowerNameEnv]
  [alias : String]
  [alias-id : i64]
  [base-name : String]
  [base-id : i64]
  [logical-id : i64]
  [logical-name : String]
  [direct : bool]) : LowerNameEnv
  (lower-name-env-add-import-alias-binding-id
    names
    alias
    (compiler-symbol-module-key alias base-name)
    (compiler-symbol-module-key-id-by-id alias-id base-id)
    logical-name
    logical-id
    direct))

(define (lower-name-env-add-decl-import-alias-binding-base-id
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [alias : String]
  [alias-id : i64]
  [module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]
  [path-aware : bool]) : LowerNameEnv
  (let
    [logical-id : i64 (lower-module-name-key-id-by-id module-id source-id)]
    (lower-name-env-add-import-alias-binding-base-id
      names
      alias
      alias-id
      source-name
      source-id
      logical-id
      (lower-alias-logical-name-id
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name
        path-aware)
      (lower-alias-logical-symbol-direct?
        entry-path
        decl-path
        logical-id
        source-id
        path-aware))))

(define (lower-name-env-add-import-alias-binding-base-symbol-id
  [names : LowerNameEnv]
  [alias : String]
  [alias-id : i64]
  [base-name : String]
  [base-id : i64]
  [logical-id : i64]
  [logical-name : String]
  [symbol-id : i64]) : LowerNameEnv
  (lower-name-env-add-import-alias-binding-symbol-id
    names
    alias
    (compiler-symbol-module-key alias base-name)
    (compiler-symbol-module-key-id-by-id alias-id base-id)
    logical-name
    logical-id
    symbol-id))

(define (lower-name-env-add-import-alias-binding-base-cache-symbol-id
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [alias : String]
  [alias-id : i64]
  [_ : String]
  [base-id : i64]
  [logical-id : i64]
  [_ : String]
  [symbol-id : i64]) : LowerNameEnv
  (let
    [source-id : i64 (compiler-symbol-module-key-id-by-id alias-id base-id)]
    (begin
      (when (< source-id 0) (set! lower-alias-overlay-valid false))
      ;; Aliased import (non-empty alias): unconditional bind; keep the overlay
      ;; set in sync so a later empty-alias dedup still sees this id as present.
      (when
        (not (string.eq alias ""))
        (when lower-alias-overlay-valid (lower-alias-overlay-record! source-id))
        (return
          (lower-name-env-bind-logical-symbol-id
            source-id
            logical-id
            symbol-id
            names)))
      ;; Empty alias already provided by the base module: nothing to add.
      (when
        (and
          dedup-base
          (lower-name-cache-contains-local-id? base-cache source-id))
        (return names))
      ;; Degraded set (a <0 id appeared): exact linear scan preserves the
      ;; Some/No decision byte-for-byte.
      (when
        (not lower-alias-overlay-valid)
        (return
          (match (lower-name-env-lookup-with-id names source-id)
            [(TcMaybeString.Some _) names]
            [(TcMaybeString.No)
              (lower-name-env-bind-logical-symbol-id
                source-id
                logical-id
                symbol-id
                names)])))
      ;; Fast path: O(1) overlay dedup, same accept decision as scanning `names`.
      (when (lower-alias-overlay-contains? source-id) (return names))
      (lower-alias-overlay-record! source-id)
      (lower-name-env-bind-logical-symbol-id
        source-id
        logical-id
        symbol-id
        names))))

(define (lower-name-env-add-import-alias-binding-base-cache-id
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [alias : String]
  [alias-id : i64]
  [base-name : String]
  [base-id : i64]
  [logical-id : i64]
  [logical-name : String]) : LowerNameEnv
  (lower-name-env-add-import-alias-binding-base-cache-symbol-id
    names
    base-cache
    dedup-base
    alias
    alias-id
    base-name
    base-id
    logical-id
    logical-name
    (lower-name-cache-lookup-symbol-id
      (& base-cache)
      logical-id
      (lower-derived-symbol-id logical-name))))

(define (lower-module-name-key-id-by-id [module-id : i64] [name-id : i64]) : i64
  (if (compiler-symbol-root-module-id? module-id)
    name-id
    (compiler-symbol-module-key-id-by-id module-id name-id)))

(define (lower-name-env-add-module-binding-id
  [names : LowerNameEnv]
  [_module : String]
  [module-id : i64]
  [_ : String]
  [source-id : i64]
  [logical-name : String]
  [logical-id : i64]
  [direct : bool]) : LowerNameEnv
  (let
    [symbol-id : i64
      (lower-logical-symbol-id-select
        logical-name
        (if direct
          source-id
          logical-id)
        direct)]
    (if (compiler-symbol-root-module-id? module-id)
      (lower-name-env-bind-logical-symbol-id
        source-id
        logical-id
        symbol-id
        names)
      (lower-name-env-bind-logical-symbol-id
        logical-id
        logical-id
        symbol-id
        names))))

(define (lower-name-env-add-decl-module-binding-id
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]) : LowerNameEnv
  (let
    [logical-id : i64
      (lower-decl-logical-id
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)]
    (lower-name-env-add-module-binding-id
      names
      module
      module-id
      source-name
      source-id
      (lower-decl-logical-name-id
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)
      logical-id
      (lower-decl-logical-symbol-direct?
        entry-path
        decl-path
        logical-id
        source-id))))

(define (lower-name-env-add-module-extern-binding-id
  [names : LowerNameEnv]
  [_module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]
  [metadata : AstExternMetadata]) : LowerNameEnv
  (let
    [logical-id : i64 (lower-module-name-key-id-by-id module-id source-id)]
    [symbol-id : i64
      (lower-extern-logical-symbol-id logical-id source-name source-id metadata)]
    (LowerNameEnv.Bind
      (if (compiler-symbol-root-module-id? module-id)
        source-id
        logical-id)
      logical-id
      symbol-id
      (box names))))

(define (lower-name-env-add-struct-cleanup-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [cleanup : AstStructCleanup]) : LowerNameEnv
  (match cleanup
    [(AstStructCleanup.No) names]
    [(AstStructCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (tc-env-key-name-text cleanup-name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          cleanup-str
          cleanup-name))]))

(define (lower-name-env-add-enum-cleanup-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [cleanup : AstEnumCleanup]) : LowerNameEnv
  (match cleanup
    [(AstEnumCleanup.No) names]
    [(AstEnumCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (tc-env-key-name-text cleanup-name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          cleanup-str
          cleanup-name))]))

(define (lower-name-env-add-local-struct-cleanup
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [cleanup : AstStructCleanup]) : LowerNameEnv
  (match cleanup
    [(AstStructCleanup.No) names]
    [(AstStructCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (tc-env-key-name-text cleanup-name)]
        (lower-name-env-bind-cached-logical-id
          cleanup-name
          (lower-current-decl-logical-name-cache-id
            name-cache
            module
            cleanup-str
            cleanup-name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              cleanup-name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              cleanup-name))
          name-cache
          names))]))

(define (lower-name-env-add-local-enum-cleanup
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [cleanup : AstEnumCleanup]) : LowerNameEnv
  (match cleanup
    [(AstEnumCleanup.No) names]
    [(AstEnumCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (tc-env-key-name-text cleanup-name)]
        (lower-name-env-bind-cached-logical-id
          cleanup-name
          (lower-current-decl-logical-name-cache-id
            name-cache
            module
            cleanup-str
            cleanup-name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              cleanup-name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              cleanup-name))
          name-cache
          names))]))

(define (lower-name-has-clone-prefix? [name : String]) : bool
  (let
    [source-name : String (tc-hygiene-global-call-name name)]
    (if (>= (string.string-length source-name) 6)
      (string.eq (string.substring source-name 0 6) "clone$")
      false)))

(define (lower-resolve-name-id [state : LowerState] [source-id : i64]) : String
  (if (and (>= source-id 0) (< source-id (intern-capacity)))
    (let
      [names : LowerNameCache (lower-state-names state)]
      (match (lower-name-cache-resolve-id-display names source-id)
        [(TcMaybeString.Some logical-name) logical-name]
        [(TcMaybeString.No) (intern-str source-id)]))
    (match (lower-name-cache-lookup-id (lower-state-names state) source-id)
      [(TcMaybeString.Some logical-name) logical-name]
      [(TcMaybeString.No) (tc-nominal-name-id-display source-id)])))

(define (lower-resolve-name-symbol-id [state : LowerState] [source-id : i64]) : i64
  (let
    [names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (lower-name-cache-resolve-logical-id (& names) source-id source-id)]
    [resolved-name : String (lower-resolve-name-id state source-id)]
    [symbol-id : i64
      (lower-name-cache-resolve-symbol-id (& names) source-id -1)]
    (if (>= symbol-id 0)
      symbol-id
      (lower-logical-symbol-id-select
        resolved-name
        logical-id
        (lower-logical-symbol-id-direct? logical-id source-id)))))

(define (lower-name-cache-ir-symbol
  [names : LowerNameCache]
  [logical-id : i64]
  [source-id : i64]
  [display-name : String]) : i64
  (lower-name-cache-lookup-symbol-id
    (& names)
    logical-id
    (lower-logical-symbol-id-select
      display-name
      logical-id
      (lower-logical-symbol-id-direct? logical-id source-id))))

(define (lower-decl-function-symbol-id
  [names : LowerNameCache]
  [logical-id : i64]
  [source-id : i64]
  [logical-name : String]) : i64
  (if (= logical-id cbi.compiler-builtin-id-fix-main)
    source-id
    (lower-name-cache-ir-symbol names logical-id source-id logical-name)))

(define (lower-tl-alloc-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-alloc))

(define (lower-tl-oob-abort-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-oob-abort))

(define (lower-tl-shift-abort-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-shift-abort))

(define (lower-tl-region-reset-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-region-reset))

(define (lower-tl-region-mark-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-region-mark))

(define (lower-tl-arena-set-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-arena-set))

(define (lower-tl-arena-current-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-arena-current))

(define (lower-tl-substring-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-substring))

(define (lower-tl-str-view-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-str-view))

(define (lower-tl-int-to-string-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-int-to-string))

(define (lower-tl-array-fill8-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-array-fill8))

(define (lower-tl-array-zero-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-array-zero))

(define (lower-tl-arena-make-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-arena-make))

(define (lower-tl-arena-destroy-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-arena-destroy))

(define (lower-resolve-call-name-id
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]) : i64
  (let
    [local? : bool (sym_i64_env.sym-i64-contains-id env source-id)]
    [state-names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (if local?
        source-id
        (lower-name-cache-resolve-logical-id
          (& state-names)
          source-id
          source-id))]
    [source-name : String
      (if (and (>= source-id 0) (< source-id (intern-capacity)))
        (intern-str source-id)
        (tc-nominal-name-id-display source-id))]
    [resolved-name : String
      (if local?
        source-name
        (if (and (>= source-id 0) (< source-id (intern-capacity)))
          (lower-resolve-name-id state source-id)
          (match (lower-name-cache-lookup-id state-names source-id)
            [(TcMaybeString.Some logical-name) logical-name]
            [(TcMaybeString.No) source-name])))]
    [symbol-id : i64
      (if local?
        -1
        (lower-name-cache-resolve-symbol-id (& state-names) source-id -1))]
    (if (>= symbol-id 0)
      symbol-id
      (lower-logical-symbol-id-select
        resolved-name
        logical-id
        (lower-logical-symbol-id-direct? logical-id source-id)))))

(define (lower-resolve-call-name-id-with-display
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [display-name : String]) : i64
  (let
    [local? : bool (sym_i64_env.sym-i64-contains-id env source-id)]
    [state-names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (if local?
        source-id
        (lower-name-cache-resolve-logical-id
          (& state-names)
          source-id
          source-id))]
    [logical-display : String
      (if local?
        display-name
        (match (lower-name-cache-resolve-id-display state-names source-id)
          [(TcMaybeString.Some resolved-name) resolved-name]
          [(TcMaybeString.No)
            (if (>= source-id (intern-capacity))
              (tc-env-key-display source-id)
              display-name)]))]
    [symbol-id : i64
      (if local?
        -1
        (lower-name-cache-resolve-symbol-id (& state-names) source-id -1))]
    (if (>= symbol-id 0)
      symbol-id
      (lower-logical-symbol-id-select
        logical-display
        logical-id
        (lower-logical-symbol-id-direct? logical-id source-id)))))

(define (lower-path-separator? [c : char]) : bool
  (or (= c '/') (= c '\\')))

(define (lower-path-drive-qualified? [path : String]) : bool
  (let
    [n : i64 (string.string-length path)]
    (and (> n 1) (= (cast (string.string-ref path 1) : i64) (cast ':' : i64)))))

(define (lower-dirname [path : String]) : String
  (let
    [n : i64 (string.string-length path)]
    [i : i64 0]
    [last : i64 -1]
    (begin
      (while (< i n)
        (begin
          (if (lower-path-separator? (string.string-ref path i))
            (set! last i)
            (set! last last))
          (set! i (+ i 1))))
      (if (< last 0)
        ""
        (string.substring path 0 (+ last 1))))))

;; Join segments with '/' in one linear text-buf build. The fold-with-append
;; version copied the whole accumulated prefix on every segment (quadratic in
;; rendered length) and ran once per normalized path, making it the largest
;; string.append caller in the lowering phase of a self-compile.
(define (lower-path-segment-vec-render [segments : svec.Vec]) : String
  (let
    [count : i64 (svec.len (& segments))]
    (if (<= count 1)
      (svec.get (& segments) 0 "")
      (let
        [buf : text_buf.TextBuf
          (text_buf.append (text_buf.empty) (svec.get (& segments) 0 ""))]
        [i : i64 1]
        (begin
          (while (< i count)
            (begin
              (set!
                buf
                (text_buf.append
                  (text_buf.append buf "/")
                  (svec.get (& segments) i "")))
              (set! i (+ i 1))))
          (text_buf.render buf))))))

(define (lower-path-normalize-segment
  [segment : String]
  [segments : svec.Vec]
  [rooted : bool]) : svec.Vec
  (cond
    [(string.eq segment "") segments]
    [(string.eq segment ".") segments]
    [(not (string.eq segment ".."))
      (let
        [next-segments : svec.Vec segments]
        (begin
          (svec.push (&mut next-segments) segment)
          next-segments))]
    [(<= (svec.len (& segments)) 0)
      (if rooted
        segments
        (let
          [next-segments : svec.Vec segments]
          (begin
            (svec.push (&mut next-segments) segment)
            next-segments)))]
    [else
      (let
        [top : String (svec.last (& segments) "")]
        (if (string.eq top "..")
          (let
            [next-segments : svec.Vec segments]
            (begin
              (svec.push (&mut next-segments) segment)
              next-segments))
          (let
            [next-segments : svec.Vec segments]
            (begin
              (match (svec.pop (&mut next-segments))
                [(svec.Pop.Ok _) unit]
                [svec.Pop.Empty unit])
              next-segments))))]))

(define (lower-path-canonical? [path : String]) : bool
  (let
    [n : i64 (string.string-length path)]
    [i : i64 0]
    [segment-start : i64 0]
    [ok : bool (> n 0)]
    (begin
      (while (and ok (< i n))
        (let
          [c : char (string.string-ref path i)]
          (begin
            (cond
              [(= c '\\') (set! ok false)]
              [(= c '/')
                (let
                  [segment-len : i64 (- i segment-start)]
                  (begin
                    (if (and (= segment-len 0) (not (= i 0)))
                      (set! ok false)
                      unit)
                    (if (and
                      (= segment-len 1)
                      (= (string.string-ref path segment-start) '.'))
                      (set! ok false)
                      unit)
                    (if (and
                      (= segment-len 2)
                      (= (string.string-ref path segment-start) '.')
                      (= (string.string-ref path (+ segment-start 1)) '.'))
                      (set! ok false)
                      unit)
                    (set! segment-start (+ i 1))))]
              [else unit])
            (set! i (+ i 1)))))
      (if (not ok)
        false
        (let
          [segment-len : i64 (- n segment-start)]
          (cond
            [(= segment-len 0)
              (or (= n 1) (and (= n 3) (lower-path-drive-qualified? path)))]
            [(and
                (= segment-len 1)
                (= (string.string-ref path segment-start) '.'))
              false]
            [(and
                (= segment-len 2)
                (= (string.string-ref path segment-start) '.')
                (= (string.string-ref path (+ segment-start 1)) '.'))
              false]
            [else true]))))))

(define (lower-normalize-path [path : String]) : String
  (if (lower-path-canonical? path)
    path
    (let
      [n : i64 (string.string-length path)]
      [drive-root : bool
        (if (> n 2)
          (if (lower-path-drive-qualified? path)
            (lower-path-separator? (string.string-ref path 2))
            false)
          false)]
      [rooted : bool
        (if drive-root
          true
          (if (> n 0)
            (lower-path-separator? (string.string-ref path 0))
            false))]
      [i : i64
        (if drive-root
          3
          (if rooted
            1
            0))]
      [segment-start : i64 i]
      [segments : svec.Vec (svec.new)]
      (begin
        (while (< i n)
          (begin
            (if (lower-path-separator? (string.string-ref path i))
              (begin
                (set!
                  segments
                  (lower-path-normalize-segment
                    (string.substring path segment-start (- i segment-start))
                    segments
                    rooted))
                (set! segment-start (+ i 1)))
              (set! segment-start segment-start))
            (set! i (+ i 1))))
        (set!
          segments
          (lower-path-normalize-segment
            (string.substring path segment-start (- n segment-start))
            segments
            rooted))
        (let
          [body : String (lower-path-segment-vec-render segments)]
          (cond
            [(if drive-root
                (= (string.string-length body) 0)
                false)
              (string.append (string.substring path 0 2) "/")]
            [drive-root
              (string.append
                (string.substring path 0 2)
                (string.append "/" body))]
            [(if rooted
                (= (string.string-length body) 0)
                false)
              "/"]
            [rooted (string.append "/" body)]
            [(= (string.string-length body) 0) "."]
            [else body]))))))

(define (lower-string-prefix-at?
  [text : String]
  [prefix : String]
  [start : i64]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< start 0)
      false
      (if (> (+ start prefix-len) text-len)
        false
        (let
          [i : i64 0]
          [ok : bool true]
          (begin
            (while ok
              (if (< i prefix-len)
                (if (=
                  (cast (string.string-ref text (+ start i)) : i64)
                  (cast (string.string-ref prefix i) : i64))
                  (set! i (+ i 1))
                  (set! ok false))
                (set! ok false)))
            (= i prefix-len)))))))

(define (lower-module-id [entry-path : String] [decl-path : String]) : String
  (let
    [entry-path : String (lower-normalize-path entry-path)]
    [decl-path : String (lower-normalize-path decl-path)]
    [base : String (lower-dirname entry-path)]
    [base-len : i64 (string.string-length base)]
    [decl-len : i64 (string.string-length decl-path)]
    (if (and (> base-len 0) (lower-string-prefix-at? decl-path base 0))
      (string.substring decl-path base-len (- decl-len base-len))
      decl-path)))

(define (lower-module-logical-name
  [entry-path : String]
  [decl-path : String]
  [source-name : String]) : String
  (if (and
    (string.eq source-name "main")
    (string.eq
      (lower-normalize-path decl-path)
      (lower-normalize-path entry-path)))
    "main"
    (string.append
      (string.append (lower-module-id entry-path decl-path) "::")
      source-name)))

(define lower-entry-main-module-active : bool
  false)
(define lower-entry-main-module : String
  "")
(define lower-entry-main-module-id : i64
  -1)

(define (lower-entry-main-module-match? [module : String]) : bool
  (if lower-entry-main-module-active
    (string.eq module lower-entry-main-module)
    (or (string.eq module "") (string.eq module "main"))))

(define (lower-decl-entry-main?
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [source-name : String]) : bool
  (and
    (string.eq source-name "main")
    (lower-entry-main-module-match? module)
    (string.eq
      (lower-normalize-path decl-path)
      (lower-normalize-path entry-path))))

(define (lower-decl-logical-id
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]) : i64
  (if (lower-decl-entry-main? entry-path decl-path module source-name)
    cbi.compiler-builtin-id-fix-main
    (lower-module-name-key-id-by-id module-id source-id)))

(define (lower-decl-entry-path? [entry-path : String] [decl-path : String]) : bool
  (or
    (string.eq entry-path decl-path)
    (string.eq
      (lower-normalize-path entry-path)
      (lower-normalize-path decl-path))))

(define (lower-decl-logical-symbol-direct?
  [_ : String]
  [_ : String]
  [logical-id : i64]
  [_ : i64]) : bool
  (= logical-id cbi.compiler-builtin-id-fix-main))

(define (lower-decl-owner-module-id
  [paths : (& paths AstDeclPathList)]
  [index : i64]
  [entry-path : String]
  [decl-path : String]
  [source-module-id : i64]) : i64
  (if (or
    (not (compiler-symbol-root-module-id? source-module-id))
    (lower-decl-entry-path? entry-path decl-path))
    source-module-id
    (ast-decl-path-list-owner-id paths index source-module-id)))

(define (lower-decl-owner-module-name
  [source-module-id : i64]
  [owner-module-id : i64]) : String
  (if (and
    (not (= source-module-id owner-module-id))
    (intern-generated-id-active? owner-module-id))
    ""
    (intern-str owner-module-id)))

(define (lower-entry-main-decl? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Def decl-meta name _ _) (= name cbi.compiler-builtin-id-fix-main)]
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (= name cbi.compiler-builtin-id-fix-main)]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-entry-main-decl? inner))]
    [_ false]))

(define (lower-entry-main-scan-add
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : AstDecl]
  [scan : LowerEntryMainScan]) : LowerEntryMainScan
  (match scan
    [(LowerEntryMainScan.Scan
        fallback-count
        fallback-module
        fallback-module-id
        preferred)
      (if (and
        (lower-entry-main-decl? decl)
        (string.eq
          (lower-normalize-path decl-path)
          (lower-normalize-path entry-path)))
        (if (or (string.eq module "") (string.eq module "main"))
          (LowerEntryMainScan.Scan
            fallback-count
            fallback-module
            fallback-module-id
            true)
          (LowerEntryMainScan.Scan
            (+ fallback-count 1)
            module
            module-id
            preferred))
        scan)]))

(define (lower-entry-main-scan-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [scan : LowerEntryMainScan]
  [module : String]
  [module-id : i64]) : LowerEntryMainScan
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) scan]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList path-rest]
                path-rest)]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        (match decl
          [(AstDecl.Module next-module)
            (lower-entry-main-scan-decls-in-module
              rest
              rest-paths
              entry-path
              scan
              (intern-str next-module)
              next-module)]
          [_
            (lower-entry-main-scan-decls-in-module
              rest
              rest-paths
              entry-path
              (lower-entry-main-scan-add
                entry-path
                decl-path
                module
                module-id
                decl
                scan)
              module
              module-id)]))]))

(define (lower-entry-main-scan-selection [scan : LowerEntryMainScan]) : LowerMaybeEntryMainModule
  (match scan
    [(LowerEntryMainScan.Scan
        fallback-count
        fallback-module
        fallback-module-id
        preferred)
      (if preferred
        (LowerMaybeEntryMainModule.No)
        (if (= fallback-count 1)
          (LowerMaybeEntryMainModule.Some fallback-module fallback-module-id)
          (LowerMaybeEntryMainModule.No)))]))

(define (lower-entry-main-selection-for-program
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]) : LowerMaybeEntryMainModule
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (lower-entry-main-scan-selection
          (lower-entry-main-scan-decls-in-module
            decls
            paths
            entry-path
            (LowerEntryMainScan.Scan
              0
              ""
              cbi.compiler-builtin-id-fix-empty
              false)
            ""
            cbi.compiler-builtin-id-fix-empty)))]))

(define (lower-entry-main-selection-install!
  [selection : LowerMaybeEntryMainModule]) : unit
  (match selection
    [(LowerMaybeEntryMainModule.No)
      (begin
        (set! lower-entry-main-module-active false)
        (set! lower-entry-main-module "")
        (set! lower-entry-main-module-id cbi.compiler-builtin-id-fix-empty))]
    [(LowerMaybeEntryMainModule.Some module module-id)
      (begin
        (set! lower-entry-main-module-active true)
        (set! lower-entry-main-module module)
        (set! lower-entry-main-module-id module-id))]))

(define (lower-entry-main-selection-restore!
  [active : bool]
  [module : String]
  [module-id : i64]) : unit
  (begin
    (set! lower-entry-main-module-active active)
    (set! lower-entry-main-module module)
    (set! lower-entry-main-module-id module-id)))

(define (lower-entry-main-logical-id [all-functions : lower_i64_i64_map.Map]) : i64
  (if (lower_i64_i64_map.contains?
    (& all-functions)
    cbi.compiler-builtin-id-fix-main)
    cbi.compiler-builtin-id-fix-main
    -1))

(define (lower-decl-logical-name-display
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]) : String
  (let
    [logical-id : i64
      (lower-decl-logical-id
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)]
    (if (= logical-id cbi.compiler-builtin-id-fix-main)
      "main"
      (if (string.eq module "")
        (lower-module-logical-name entry-path decl-path source-name)
        (lower-module-logical-name
          entry-path
          decl-path
          (compiler-symbol-module-key module source-name))))))

(define (lower-decl-logical-name-id
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]) : String
  (let
    [logical-id : i64
      (lower-decl-logical-id
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)]
    (lower-logical-display-name-select
      (lower-decl-logical-name-display
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)
      logical-id
      (lower-decl-logical-symbol-direct?
        entry-path
        decl-path
        logical-id
        source-id))))

(define (lower-current-decl-logical-name-id
  [names : LowerNameEnv]
  [module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]) : String
  (let
    [key : String (compiler-symbol-module-key module source-name)]
    [key-id : i64 (lower-module-name-key-id-by-id module-id source-id)]
    [symbol-id : i64 (lower-name-env-lookup-symbol-id names key-id -1)]
    (if (>= symbol-id 0)
      (tc-env-key-name-text symbol-id)
      (if (and (string.eq module "main") (string.eq source-name "main"))
        "main"
        key))))

(define (lower-current-decl-logical-name-cache-id
  [names : LowerNameCache]
  [module : String]
  [source-name : String]
  [source-id : i64]) : String
  (let
    [key : String (compiler-symbol-module-key module source-name)]
    [key-id : i64
      (lower-module-name-key-id-by-id (struct-get names module-id) source-id)]
    [symbol-id : i64 (lower-name-cache-lookup-symbol-id (& names) key-id -1)]
    (if (>= symbol-id 0)
      (tc-env-key-name-text symbol-id)
      (if (and (string.eq module "main") (string.eq source-name "main"))
        "main"
        key))))

(define (lower-name-env-add-decl-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : AstDecl]) : LowerNameEnv
  (match decl
    [(AstDecl.Def decl-meta name _ _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          name-str
          name))]
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          name-str
          name))]
    [(AstDecl.DefDispatch decl-meta name _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          name-str
          name))]
    [(AstDecl.Extern decl-meta name _ metadata _)
      ;; Calls resolve through the local declaration name; backend metadata owns
      ;; the exact external linker symbol.
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-module-extern-binding-id
          names
          module
          module-id
          name-str
          name
          (box-get metadata)))]
    [(AstDecl.DefEnum decl-meta _ cleanup _)
      (lower-name-env-add-enum-cleanup-in-module
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (lower-name-env-add-enum-cleanup-in-module
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(AstDecl.DefStruct decl-meta _ _ cleanup _)
      (lower-name-env-add-struct-cleanup-in-module
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (lower-name-env-add-struct-cleanup-in-module
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-decl-in-module
          names
          entry-path
          decl-path
          module
          module-id
          inner))]
    [_ names]))

(define (lower-decl-lexical-binding-id [decl : AstDecl]) : LowerNameCacheMaybeId
  (match decl
    [(AstDecl.Def decl-meta name _ _) (LowerNameCacheMaybeId.Some name)]
    [(AstDecl.DefFn decl-meta name _ _ _ _) (LowerNameCacheMaybeId.Some name)]
    [(AstDecl.DefDispatch decl-meta name _) (LowerNameCacheMaybeId.Some name)]
    [(AstDecl.Extern decl-meta name _ _ _) (LowerNameCacheMaybeId.Some name)]
    [(AstDecl.DefEnum decl-meta _ cleanup _)
      (match cleanup
        [(AstEnumCleanup.Fn name) (LowerNameCacheMaybeId.Some name)]
        [(AstEnumCleanup.No) (LowerNameCacheMaybeId.No)])]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (match cleanup
        [(AstEnumCleanup.Fn name) (LowerNameCacheMaybeId.Some name)]
        [(AstEnumCleanup.No) (LowerNameCacheMaybeId.No)])]
    [(AstDecl.DefStruct decl-meta _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.Fn name) (LowerNameCacheMaybeId.Some name)]
        [(AstStructCleanup.No) (LowerNameCacheMaybeId.No)])]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.Fn name) (LowerNameCacheMaybeId.Some name)]
        [(AstStructCleanup.No) (LowerNameCacheMaybeId.No)])]
    [(AstDecl.Unsafe inner-box)
      (lower-decl-lexical-binding-id (box-get inner-box))]
    [_ (LowerNameCacheMaybeId.No)]))

;; A path-loaded file remains in the lexical root namespace even though its
;; emitted declarations use the file/module owner ID. Preserve both keys: the
;; parser ID resolves unqualified source references, while the owner pair is the
;; stable backend/reachability identity.
(define (lower-name-env-add-root-alias-from-latest
  [names : LowerNameEnv]
  [decl : AstDecl]) : LowerNameEnv
  (match (lower-decl-lexical-binding-id decl)
    [(LowerNameCacheMaybeId.No) names]
    [(LowerNameCacheMaybeId.Some source-id)
      (match names
        [(LowerNameEnv.Bind _ logical-id symbol-id _)
          (LowerNameEnv.Bind source-id logical-id symbol-id (box names))]
        [(LowerNameEnv.Nil) names])]))

(define (lower-name-env-from-decls
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]) : LowerNameEnv
  (let
    [base : LowerNameEnv
      (lower-name-env-from-decls-in-module
        decls
        paths
        entry-path
        names
        ""
        cbi.compiler-builtin-id-fix-empty)]
    (lower-name-env-with-import-aliases decls paths entry-path base true)))

(define (lower-name-env-from-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [_module : String]
  [module-id : i64]) : LowerNameEnv
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 module-id]
    (begin
      (while (< index count)
        (let
          [decl : AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          [decl-path : String
            (ast-decl-path-list-get (& paths) index entry-path)]
          [logical-module-id : i64
            (lower-decl-owner-module-id
              (& paths)
              index
              entry-path
              decl-path
              cur-module-id)]
          (begin
            (match decl
              [(AstDecl.Def decl-meta _ _ _) unit]
              [_ unit])
            (match decl
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [_
                (let
                  [owner-names : LowerNameEnv
                    (lower-name-env-add-decl-in-module
                      cur-names
                      entry-path
                      decl-path
                      (lower-decl-owner-module-name
                        cur-module-id
                        logical-module-id)
                      logical-module-id
                      decl)]
                  (set!
                    cur-names
                    (if (and
                      (compiler-symbol-root-module-id? cur-module-id)
                      (not (compiler-symbol-root-module-id? logical-module-id)))
                      (lower-name-env-add-root-alias-from-latest
                        owner-names
                        decl)
                      owner-names)))])
            (set! index (+ index 1)))))
      cur-names)))

(define (lower-name-env-add-clone-decl-in-module-inner
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : AstDecl]) : LowerNameEnv
  (match decl
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (if (lower-name-has-clone-prefix? name-str)
          (lower-name-env-add-decl-module-binding-id
            names
            entry-path
            decl-path
            module
            module-id
            name-str
            name)
          names))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-clone-decl-in-module
          names
          entry-path
          decl-path
          module
          module-id
          inner))]
    [_ names]))

(define (lower-name-env-add-clone-decl-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : AstDecl]) : LowerNameEnv
  (match (ast-decl-generated-meta decl)
    [(AstGeneratedDeclMeta.Some generator item _ _)
      (if (string.eq generator "stdlib.clone/synthesize-helpers")
        (match (ast-decl-unwrapped decl)
          [(AstDecl.DefFn decl-meta name _ _ _ _)
            (lower-name-env-add-decl-module-binding-id
              names
              entry-path
              decl-path
              module
              module-id
              item
              name)]
          [_ names])
        (lower-name-env-add-clone-decl-in-module-inner
          names
          entry-path
          decl-path
          module
          module-id
          decl))]
    [(AstGeneratedDeclMeta.No)
      (lower-name-env-add-clone-decl-in-module-inner
        names
        entry-path
        decl-path
        module
        module-id
        decl)]))

(define (lower-name-env-add-clone-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [initial-module-id : i64]) : LowerNameEnv
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 initial-module-id]
    (begin
      (while (< index count)
        (let
          [decl : AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          [decl-path : String (ast-decl-path-list-get (& paths) index "")]
          (begin
            (match decl
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [_
                (set!
                  cur-names
                  (lower-name-env-add-clone-decl-in-module
                    cur-names
                    entry-path
                    decl-path
                    (intern-str cur-module-id)
                    cur-module-id
                    decl))])
            (set! index (+ index 1)))))
      cur-names)))

(define (lower-name-env-add-clone-decls
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]) : LowerNameEnv
  (lower-name-env-add-clone-decls-in-module
    decls
    paths
    entry-path
    names
    cbi.compiler-builtin-id-fix-empty))

(define (lower-alias-logical-name-id
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]
  [path-aware : bool]) : String
  (if path-aware
    (lower-decl-logical-name-id
      entry-path
      decl-path
      module
      module-id
      source-id
      source-name)
    (compiler-symbol-module-key module source-name)))

(define (lower-alias-logical-symbol-direct?
  [entry-path : String]
  [decl-path : String]
  [logical-id : i64]
  [source-id : i64]
  [path-aware : bool]) : bool
  (if path-aware
    (lower-decl-logical-symbol-direct?
      entry-path
      decl-path
      logical-id
      source-id)
    (lower-logical-symbol-id-direct? logical-id source-id)))

(define (lower-import-alias-key [importer-module : String] [alias : String]) : String
  (if (string.eq alias "")
    importer-module
    alias))

(define (lower-import-alias-key-id [importer-module-id : i64] [alias-id : i64]) : i64
  (if (= alias-id cbi.compiler-builtin-id-fix-empty)
    importer-module-id
    alias-id))

(define (lower-name-env-add-decl-alias-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [alias : String]
  [alias-id : i64]
  [module : String]
  [module-id : i64]
  [decl : AstDecl]
  [path-aware : bool]) : LowerNameEnv
  (match decl
    [(AstDecl.Def decl-meta name _ _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-decl-import-alias-binding-base-id
          names
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          name-str
          name
          path-aware))]
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-decl-import-alias-binding-base-id
          names
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          name-str
          name
          path-aware))]
    [(AstDecl.DefDispatch decl-meta name _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-decl-import-alias-binding-base-id
          names
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          name-str
          name
          path-aware))]
    [(AstDecl.Extern decl-meta name _ metadata _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        [logical-id : i64 (lower-module-name-key-id-by-id module-id name)]
        (lower-name-env-add-import-alias-binding-base-symbol-id
          names
          alias
          alias-id
          name-str
          name
          logical-id
          name-str
          (lower-extern-logical-symbol-id
            logical-id
            name-str
            name
            (box-get metadata))))]
    [(AstDecl.DefEnum decl-meta _ cleanup _)
      (match cleanup
        [(AstEnumCleanup.No) names]
        [(AstEnumCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              names
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name
              path-aware))])]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (match cleanup
        [(AstEnumCleanup.No) names]
        [(AstEnumCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              names
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name
              path-aware))])]
    [(AstDecl.DefStruct decl-meta _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.No) names]
        [(AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              names
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name
              path-aware))])]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.No) names]
        [(AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              names
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name
              path-aware))])]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-decl-alias-in-module
          names
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          inner
          path-aware))]
    [_ names]))

(define (lower-name-env-add-decl-alias-in-module-cache
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [alias : String]
  [alias-id : i64]
  [module : String]
  [module-id : i64]
  [decl : AstDecl]) : LowerNameEnv
  (match decl
    [(AstDecl.Def decl-meta name _ _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-import-alias-binding-base-cache-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          name-str
          name
          (lower-module-name-key-id-by-id module-id name)
          (lower-current-decl-logical-name-cache-id
            base-cache
            module
            name-str
            name)))]
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-import-alias-binding-base-cache-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          name-str
          name
          (lower-module-name-key-id-by-id module-id name)
          (lower-current-decl-logical-name-cache-id
            base-cache
            module
            name-str
            name)))]
    [(AstDecl.DefDispatch decl-meta name _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-add-import-alias-binding-base-cache-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          name-str
          name
          (lower-module-name-key-id-by-id module-id name)
          (lower-current-decl-logical-name-cache-id
            base-cache
            module
            name-str
            name)))]
    [(AstDecl.Extern decl-meta name _ metadata _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        [logical-id : i64 (lower-module-name-key-id-by-id module-id name)]
        (lower-name-env-add-import-alias-binding-base-cache-symbol-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          name-str
          name
          logical-id
          name-str
          (lower-extern-logical-symbol-id
            logical-id
            name-str
            name
            (box-get metadata))))]
    [(AstDecl.DefEnum decl-meta _ cleanup _)
      (match cleanup
        [(AstEnumCleanup.No) names]
        [(AstEnumCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              cleanup-str
              cleanup-name
              (lower-module-name-key-id-by-id module-id cleanup-name)
              (lower-current-decl-logical-name-cache-id
                base-cache
                module
                cleanup-str
                cleanup-name)))])]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (match cleanup
        [(AstEnumCleanup.No) names]
        [(AstEnumCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              cleanup-str
              cleanup-name
              (lower-module-name-key-id-by-id module-id cleanup-name)
              (lower-current-decl-logical-name-cache-id
                base-cache
                module
                cleanup-str
                cleanup-name)))])]
    [(AstDecl.DefStruct decl-meta _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.No) names]
        [(AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              cleanup-str
              cleanup-name
              (lower-module-name-key-id-by-id module-id cleanup-name)
              (lower-current-decl-logical-name-cache-id
                base-cache
                module
                cleanup-str
                cleanup-name)))])]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (match cleanup
        [(AstStructCleanup.No) names]
        [(AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              cleanup-str
              cleanup-name
              (lower-module-name-key-id-by-id module-id cleanup-name)
              (lower-current-decl-logical-name-cache-id
                base-cache
                module
                cleanup-str
                cleanup-name)))])]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-decl-alias-in-module-cache
          names
          base-cache
          dedup-base
          alias
          alias-id
          module
          module-id
          inner))]
    [_ names]))

(define (lower-name-env-add-module-aliases
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [target-module-id : i64]
  [alias-id : i64]
  [_module-id : i64]
  [path-aware : bool]) : LowerNameEnv
  (let
    [cur-names : LowerNameEnv names]
    [target-module : String (intern-str target-module-id)]
    [alias : String (intern-str alias-id)]
    [_ensure : unit (lower-module-decl-index-ensure! decls)]
    [slot : i64 (lower-module-decl-index-slot target-module-id)]
    (if (< slot 0)
      cur-names
      (let
        [index : i64 (array-ref lower-module-decl-index-starts slot)]
        [end : i64 (array-ref lower-module-decl-index-ends slot)]
        [decl-offset : i64 (struct-get decls offset)]
        [decl-slots : (Array AstDecl) (struct-get decls slots)]
        (begin
          (while (< index end)
            (let
              [position : i64
                (array-ref lower-module-decl-index-positions index)]
              [decl : AstDecl (array-ref decl-slots (+ decl-offset position))]
              [decl-path : String
                (ast-decl-path-list-get (& paths) position entry-path)]
              (begin
                (match decl
                  [(AstDecl.Module _) unit]
                  [(AstDecl.Import decl-meta _) unit]
                  [(AstDecl.IncludeStr _ _) unit]
                  [(AstDecl.IncludeStrComptime _ _) unit]
                  [(AstDecl.IncludeStrLzss _ _) unit]
                  [(AstDecl.IncludeBin _ _) unit]
                  [(AstDecl.Test _ _ _) unit]
                  [_
                    (set!
                      cur-names
                      (lower-name-env-add-decl-alias-in-module
                        cur-names
                        entry-path
                        decl-path
                        alias
                        alias-id
                        target-module
                        target-module-id
                        decl
                        path-aware))])
                (set! index (+ index 1)))))
          cur-names)))))

;; --- per-program module -> decl-position index ------------------
;; Import-alias fanout, its cache-backed module-local variant, and
;; lower-module-local-envs-list all need to filter the whole-program decl list
;; down to one module. Scanning every declaration and tracking `(module NAME)`
;; markers for each target made a self-compile pay O(imports x program) work in
;; the initial name-env build, plus repeated module-local scans later. This
;; CSR-shaped index maps each module id to the program-order positions of its
;; declarations (module markers excluded) so all of those consumers touch only
;; the target module's rows. Built lazily per program over the checked decl list,
;; which is immutable for the whole lower run;
;; lower-reset-file-state! drops it between programs and the (len, offset)
;; stamp re-checks the list shape on every ensure.
(define lower-module-decl-index-ready : bool
  false)
(define lower-module-decl-index-decl-count : i64
  -1)
(define lower-module-decl-index-decl-offset : i64
  -1)
(define lower-module-decl-index-modules : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 16))
(define lower-module-decl-index-starts : (Array i64)
  (make-array i64 0))
(define lower-module-decl-index-ends : (Array i64)
  (make-array i64 0))
(define lower-module-decl-index-positions : (Array i64)
  (make-array i64 0))
(define lower-module-decl-index-arena : i64
  0)

(define (lower-module-decl-index-reset!) : unit
  (begin
    (set! lower-module-decl-index-ready false)
    (set! lower-module-decl-index-decl-count -1)
    (set! lower-module-decl-index-decl-offset -1)
    ;; The stale array/map globals are never read while ready is false (every
    ;; consumer goes through ensure!), so destroying their arena here is safe.
    (if (= lower-module-decl-index-arena 0)
      unit
      (begin
        (unsafe
          (arena.tl_arena_destroy lower-module-decl-index-arena))
        (set! lower-module-decl-index-arena 0)))))

(define (lower-module-decl-index-ensure! [decls : AstDeclList]) : unit
  (if (and
    lower-module-decl-index-ready
    (= lower-module-decl-index-decl-count (struct-get decls len))
    (= lower-module-decl-index-decl-offset (struct-get decls offset)))
    unit
    (let
      [count : i64 (struct-get decls len)]
      [decl-offset : i64 (struct-get decls offset)]
      [decl-slots : (Array AstDecl) (struct-get decls slots)]
      [empty-module-id : i64 cbi.compiler-builtin-id-fix-empty]
      ;; The index outlives the transient scratch arenas active during
      ;; lowering, so its backing allocations live in a dedicated arena
      ;; (same idiom as tc-hygiene-module-env-cache-arena): allocating them
      ;; in whatever arena happens to be active would leave the globals
      ;; dangling when that scratch arena is destroyed.
      [prev-arena : i64 (arena.tl_arena_current)]
      [_make-arena : unit
        (if (= lower-module-decl-index-arena 0)
          (set! lower-module-decl-index-arena (arena.tl_arena_make))
          unit)]
      [_switch : unit
        (unsafe
          (arena.tl_arena_set lower-module-decl-index-arena))]
      [modules : lower_i64_i64_map.Map (lower_i64_i64_map.with-capacity 512)]
      [module-count : i64 0]
      [counts : (Array i64) (make-array i64 (+ count 1))]
      [starts : (Array i64) (make-array i64 (+ count 1))]
      [ends : (Array i64) (make-array i64 (+ count 1))]
      [positions : (Array i64) (make-array i64 (+ count 1))]
      [cur-module-id : i64 empty-module-id]
      [i : i64 0]
      [running : i64 0]
      (begin
        ;; Pass 1: assign a dense slot per module id and count its decls.
        (while (< i count)
          (begin
            (match (array-ref decl-slots (+ decl-offset i))
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [_
                (let
                  [slot : i64
                    (match (lower_i64_i64_map.get (& modules) cur-module-id)
                      [(lower_i64_i64_map.LookupFound found-slot) found-slot]
                      [(lower_i64_i64_map.LookupMissing)
                        (let
                          [new-slot : i64 module-count]
                          (begin
                            (lower_i64_i64_map.insert-ref!
                              (&mut modules)
                              cur-module-id
                              new-slot)
                            (set! module-count (+ module-count 1))
                            new-slot))])]
                  (array-set! counts slot (+ (array-ref counts slot) 1)))])
            (set! i (+ i 1))))
        ;; Prefix sums: starts fixed, ends double as fill cursors below.
        (set! i 0)
        (while (< i module-count)
          (begin
            (array-set! starts i running)
            (array-set! ends i running)
            (set! running (+ running (array-ref counts i)))
            (set! i (+ i 1))))
        ;; Pass 2: fill program-order positions per module slot.
        (set! cur-module-id empty-module-id)
        (set! i 0)
        (while (< i count)
          (begin
            (match (array-ref decl-slots (+ decl-offset i))
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [_
                (match (lower_i64_i64_map.get (& modules) cur-module-id)
                  [(lower_i64_i64_map.LookupFound slot)
                    (let
                      [cursor : i64 (array-ref ends slot)]
                      (begin
                        (array-set! positions cursor i)
                        (array-set! ends slot (+ cursor 1))))]
                  [(lower_i64_i64_map.LookupMissing) unit])])
            (set! i (+ i 1))))
        (set! lower-module-decl-index-modules modules)
        (set! lower-module-decl-index-starts starts)
        (set! lower-module-decl-index-ends ends)
        (set! lower-module-decl-index-positions positions)
        (set! lower-module-decl-index-decl-count count)
        (set! lower-module-decl-index-decl-offset decl-offset)
        ;; The arena head advances as it grows; re-capture it so reset!
        ;; destroys the whole chain, then restore the caller's arena.
        (set! lower-module-decl-index-arena (arena.tl_arena_current))
        (unsafe
          (arena.tl_arena_set prev-arena))
        (set! lower-module-decl-index-ready true)))))

;; Dense slot for a module id, or -1 when the module owns no declarations.
(define (lower-module-decl-index-slot [module-id : i64]) : i64
  (match (lower_i64_i64_map.get (& lower-module-decl-index-modules) module-id)
    [(lower_i64_i64_map.LookupFound slot) slot]
    [(lower_i64_i64_map.LookupMissing) -1]))

(define (lower-name-env-add-module-aliases-cache
  [decls : AstDeclList]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [names : LowerNameEnv]
  [target-module-id : i64]
  [alias-id : i64]
  [_module-id : i64]) : LowerNameEnv
  (let
    [cur-names : LowerNameEnv names]
    [_ensure : unit (lower-module-decl-index-ensure! decls)]
    [slot : i64 (lower-module-decl-index-slot target-module-id)]
    (if (< slot 0)
      cur-names
      (let
        [j : i64 (array-ref lower-module-decl-index-starts slot)]
        [end : i64 (array-ref lower-module-decl-index-ends slot)]
        [target-module : String (intern-str target-module-id)]
        [alias : String (intern-str alias-id)]
        (begin
          (while (< j end)
            (let
              [decl : AstDecl
                (array-ref
                  (struct-get decls slots)
                  (+
                    (struct-get decls offset)
                    (array-ref lower-module-decl-index-positions j)))]
              (begin
                (match decl
                  [(AstDecl.Module _) unit]
                  [(AstDecl.Import decl-meta _) unit]
                  [(AstDecl.IncludeStr _ _) unit]
                  [(AstDecl.IncludeStrComptime _ _) unit]
                  [(AstDecl.IncludeStrLzss _ _) unit]
                  [(AstDecl.IncludeBin _ _) unit]
                  [(AstDecl.Test _ _ _) unit]
                  [_
                    (set!
                      cur-names
                      (lower-name-env-add-decl-alias-in-module-cache
                        cur-names
                        base-cache
                        dedup-base
                        alias
                        alias-id
                        target-module
                        target-module-id
                        decl))])
                (set! j (+ j 1)))))
          cur-names)))))

(define (lower-name-env-from-import-aliases
  [all-decls : AstDeclList]
  [all-paths : AstDeclPathList]
  [decls : AstDeclList]
  [_paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [initial-module-id : i64]
  [path-aware : bool]) : LowerNameEnv
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 initial-module-id]
    (begin
      ;; Seed the overlay membership set from the base env so the per-alias
      ;; "already bound?" check below is O(1) instead of an O(base) linear scan.
      (lower-alias-overlay-seed-from-env! cur-names)
      (while (< index count)
        (let
          [decl : AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          (begin
            (match decl
              [(AstDecl.Import
                  decl-meta
                  (AstImportSpec.Spec
                    _
                    _
                    (AstMaybeModuleName.Some target-module)
                    (AstMaybeImportAlias.Some alias)
                    _))
                (set!
                  cur-names
                  (lower-name-env-add-module-aliases
                    all-decls
                    all-paths
                    entry-path
                    cur-names
                    target-module
                    (lower-import-alias-key-id cur-module-id alias)
                    cbi.compiler-builtin-id-fix-empty
                    path-aware))]
              [_ unit])
            (match decl
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [_ unit])
            (set! index (+ index 1)))))
      cur-names)))

(define (lower-name-env-with-import-aliases
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [path-aware : bool]) : LowerNameEnv
  (lower-name-env-from-import-aliases
    decls
    paths
    decls
    paths
    entry-path
    names
    cbi.compiler-builtin-id-fix-empty
    path-aware))

(define (lower-name-env-from-import-aliases-in-module-cache
  [all-decls : AstDeclList]
  [decls : AstDeclList]
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [target-current-module-id : i64]
  [_current-module-id : i64]) : LowerNameEnv
  (let
    [cur-names : LowerNameEnv names]
    [_ensure : unit (lower-module-decl-index-ensure! decls)]
    [slot : i64 (lower-module-decl-index-slot target-current-module-id)]
    (begin
      ;; `names` is always a fresh (empty) overlay here, so seed the overlay
      ;; membership set empty; it then mirrors every alias bound below.
      (lower-alias-overlay-reset!)
      (if (< slot 0)
        cur-names
        (let
          [j : i64 (array-ref lower-module-decl-index-starts slot)]
          [end : i64 (array-ref lower-module-decl-index-ends slot)]
          (begin
            (while (< j end)
              (let
                [decl : AstDecl
                  (array-ref
                    (struct-get decls slots)
                    (+
                      (struct-get decls offset)
                      (array-ref lower-module-decl-index-positions j)))]
                (begin
                  (match decl
                    [(AstDecl.Import
                        decl-meta
                        (AstImportSpec.Spec
                          _
                          _
                          (AstMaybeModuleName.Some target-module)
                          (AstMaybeImportAlias.Some alias)
                          _))
                      (set!
                        cur-names
                        (lower-name-env-add-module-aliases-cache
                          all-decls
                          base-cache
                          dedup-base
                          cur-names
                          target-module
                          alias
                          cbi.compiler-builtin-id-fix-empty))]
                    [_ unit])
                  (set! j (+ j 1)))))
            cur-names))))))

(define (lower-name-env-with-import-aliases-in-module-cache
  [decls : AstDeclList]
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [module-id : i64]) : LowerNameEnv
  ;; Build aliases into a fresh overlay so empty-alias duplicate checks do not
  ;; rescan the whole base env for every imported decl.
  (let
    [dedup-base : bool
      (match names
        [(LowerNameEnv.Nil) false]
        [_ true])]
    [overlay : LowerNameEnv
      (lower-name-env-from-import-aliases-in-module-cache
        decls
        decls
        LowerNameEnv.Nil
        base-cache
        dedup-base
        module-id
        cbi.compiler-builtin-id-fix-empty)]
    (match names
      [(LowerNameEnv.Nil) overlay]
      [_ (lower-name-env-append overlay names)])))

;; `names` is the env to bind onto; `resolve-env` is the env used to
;; resolve dispatch logical names (the only case that consults an env rather than
;; the name cache). For the normal full build the two are identical. The
;; module-local-only overlay build passes a fresh `names` base but the full env
;; as `resolve-env`, so dispatch names still resolve against all in-scope
;; bindings while only the module-local additions are accumulated.
(define (lower-name-env-add-local-decl-resolve
  [names : LowerNameEnv]
  [resolve-env : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [decl : AstDecl]) : LowerNameEnv
  (match decl
    [(AstDecl.Def decl-meta name _ _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-bind-cached-logical-id
          name
          (lower-current-decl-logical-name-cache-id
            name-cache
            module
            name-str
            name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name))
          name-cache
          names))]
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-bind-cached-logical-id
          name
          (lower-current-decl-logical-name-cache-id
            name-cache
            module
            name-str
            name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name))
          name-cache
          names))]
    [(AstDecl.DefDispatch decl-meta name _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        (lower-name-env-bind-cached-logical-id
          name
          (lower-current-decl-logical-name-id
            resolve-env
            module
            (struct-get name-cache module-id)
            name-str
            name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name))
          name-cache
          names))]
    [(AstDecl.Extern decl-meta name _ metadata _)
      (let
        [name-str : String (tc-env-key-name-text name)]
        [logical-id : i64
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name))]
        [logical-name : String (compiler-symbol-module-key module name-str)]
        (LowerNameEnv.Bind
          name
          logical-id
          (lower-derived-symbol-id logical-name)
          (box names)))]
    [(AstDecl.DefEnum decl-meta _ cleanup _)
      (lower-name-env-add-local-enum-cleanup names name-cache module cleanup)]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (lower-name-env-add-local-enum-cleanup names name-cache module cleanup)]
    [(AstDecl.DefStruct decl-meta _ _ cleanup _)
      (lower-name-env-add-local-struct-cleanup names name-cache module cleanup)]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (lower-name-env-add-local-struct-cleanup names name-cache module cleanup)]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-name-env-add-local-decl-resolve
          names
          resolve-env
          name-cache
          module
          inner))]
    [_ names]))

(define (lower-module-local-type-envs-bind-qualified
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [module : i64]
  [name-id : i64]) : ResultLowerModuleTypeEnvs
  (match (tc-lookup-id
    top-env
    (compiler-symbol-module-key-id-by-id module name-id))
    [(ResultTcType.Ok ty)
      (ResultLowerModuleTypeEnvs.Ok
        (tc-bind-id env name-id ty)
        (tc-bind-id local-env name-id ty))]
    [(ResultTcType.Err message) (ResultLowerModuleTypeEnvs.Err message)]))

(define (lower-module-local-type-envs-bind-qualified-id-if-free
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [module : i64]
  [name-id : i64]) : ResultLowerModuleTypeEnvs
  (match (tc-lookup-id
    top-env
    (compiler-symbol-module-key-id-by-id module name-id))
    [(ResultTcType.Ok ty)
      (ResultLowerModuleTypeEnvs.Ok
        (tc-bind-alias-id-if-free env name-id ty)
        (tc-bind-alias-id-if-free local-env name-id ty))]
    [(ResultTcType.Err message) (ResultLowerModuleTypeEnvs.Err message)]))

(define (lower-module-local-type-envs-add-variants
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [module : i64]
  [variants : AstVariantDefList]) : ResultLowerModuleTypeEnvs
  (lower-module-local-type-envs-add-variants-at
    top-env
    env
    local-env
    module
    (& variants)
    0))

(define (lower-module-local-type-envs-add-variants-at
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [module : i64]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : ResultLowerModuleTypeEnvs
  (if (>= index (struct-get variants len))
    (ResultLowerModuleTypeEnvs.Ok env local-env)
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def name _ _)
        (match (lower-module-local-type-envs-bind-qualified-id-if-free
          top-env
          env
          local-env
          module
          name)
          [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
            (lower-module-local-type-envs-add-variants-at
              top-env
              next-env
              next-local-env
              module
              variants
              (+ index 1))]
          [(ResultLowerModuleTypeEnvs.Err message)
            (ResultLowerModuleTypeEnvs.Err message)])])))

(define (lower-module-local-type-envs-add-decl
  [top-env : TcTypeEnv]
  [env : TcTypeEnv]
  [local-env : TcTypeEnv]
  [module : i64]
  [decl : AstDecl]) : ResultLowerModuleTypeEnvs
  (match decl
    [(AstDecl.Def decl-meta name _ _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(AstDecl.DefDispatch decl-meta name _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(AstDecl.Extern decl-meta name _ _ _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(AstDecl.DefEnum decl-meta _ cleanup variants)
      (match (lower-module-local-type-envs-add-variants
        top-env
        env
        local-env
        module
        variants)
        [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
          (match cleanup
            [(AstEnumCleanup.No)
              (ResultLowerModuleTypeEnvs.Ok next-env next-local-env)]
            [(AstEnumCleanup.Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                cleanup-name)])]
        [(ResultLowerModuleTypeEnvs.Err message)
          (ResultLowerModuleTypeEnvs.Err message)])]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ cleanup variants)
      (match (lower-module-local-type-envs-add-variants
        top-env
        env
        local-env
        module
        variants)
        [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
          (match cleanup
            [(AstEnumCleanup.No)
              (ResultLowerModuleTypeEnvs.Ok next-env next-local-env)]
            [(AstEnumCleanup.Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                cleanup-name)])]
        [(ResultLowerModuleTypeEnvs.Err message)
          (ResultLowerModuleTypeEnvs.Err message)])]
    [(AstDecl.DefStruct decl-meta name _ cleanup _)
      (match (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)
        [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
          (match cleanup
            [(AstStructCleanup.No)
              (ResultLowerModuleTypeEnvs.Ok next-env next-local-env)]
            [(AstStructCleanup.Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                cleanup-name)])]
        [(ResultLowerModuleTypeEnvs.Err message)
          (ResultLowerModuleTypeEnvs.Err message)])]
    [(AstDecl.DefStructLifetimes decl-meta name _ _ cleanup _)
      (match (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)
        [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
          (match cleanup
            [(AstStructCleanup.No)
              (ResultLowerModuleTypeEnvs.Ok next-env next-local-env)]
            [(AstStructCleanup.Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                cleanup-name)])]
        [(ResultLowerModuleTypeEnvs.Err message)
          (ResultLowerModuleTypeEnvs.Err message)])]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-module-local-type-envs-add-decl
          top-env
          env
          local-env
          module
          inner))]
    [_ (ResultLowerModuleTypeEnvs.Ok env local-env)]))

(define (lower-module-local-envs-list
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [type-env : TcTypeEnv]
  [local-type-env : TcTypeEnv]
  [resolve-names : LowerNameEnv]
  [local-names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [target-module : String]
  [target-module-id : i64]) : ResultLowerModuleLocalEnv
  (let
    [cur-type-env : TcTypeEnv type-env]
    [cur-local-type-env : TcTypeEnv local-type-env]
    [cur-local-names : LowerNameEnv local-names]
    [_ensure : unit (lower-module-decl-index-ensure! decls)]
    [slot : i64 (lower-module-decl-index-slot target-module-id)]
    [index : i64
      (if (< slot 0)
        0
        (array-ref lower-module-decl-index-starts slot))]
    [count : i64
      (if (< slot 0)
        0
        (array-ref lower-module-decl-index-ends slot))]
    [decl-offset : i64 (struct-get decls offset)]
    [result : ResultLowerModuleLocalEnv
      (ResultLowerModuleLocalEnv.Err "lower: module local env walk")]
    [done : bool false]
    (begin
      (while (and (not done) (< index count))
        (let
          [decl : AstDecl
            (array-ref
              (struct-get decls slots)
              (+
                decl-offset
                (array-ref lower-module-decl-index-positions index)))]
          (begin
            (match decl
              [(AstDecl.Module _) unit]
              [_
                (match (lower-module-local-type-envs-add-decl
                  top-env
                  cur-type-env
                  cur-local-type-env
                  target-module-id
                  decl)
                  [(ResultLowerModuleTypeEnvs.Ok
                      next-type-env
                      next-local-type-env)
                    (let
                      [next-local-names : LowerNameEnv
                        (lower-name-env-add-local-decl-resolve
                          cur-local-names
                          resolve-names
                          name-cache
                          target-module
                          decl)]
                      (begin
                        (set! cur-type-env next-type-env)
                        (set! cur-local-type-env next-local-type-env)
                        (set! cur-local-names next-local-names)))]
                  [(ResultLowerModuleTypeEnvs.Err message)
                    (begin
                      (set! result (ResultLowerModuleLocalEnv.Err message))
                      (set! done true))])])
            (set! index (+ index 1)))))
      (if done
        result
        (ResultLowerModuleLocalEnv.Ok
          cur-type-env
          cur-local-type-env
          cur-local-names)))))

(define (lower-module-local-envs
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [module-id : i64]) : ResultLowerModuleLocalEnv
  (if (string.eq module "")
    (ResultLowerModuleLocalEnv.Ok top-env (TcTypeEnv.Nil) (LowerNameEnv.Nil))
    (match (tc-context-program ctx)
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          ;; The module's import aliases resolve against the global
          ;; name-cache (not the env base), so building them on an empty base
          ;; yields the module-local-only alias env -- the starting point for the
          ;; per-module name-cache overlay (local decl names are added on top in
          ;; lower-module-local-envs-list).
          [local-alias-names : LowerNameEnv
            (lower-name-env-with-import-aliases-in-module-cache
              decls
              (LowerNameEnv.Nil)
              name-cache
              module-id)]
          (lower-module-local-envs-list
            top-env
            decls
            top-env
            (TcTypeEnv.Nil)
            names
            local-alias-names
            name-cache
            module
            module-id))])))

(define (lower-id-set-contains? [items : LowerIdSet] [name : i64]) : bool
  (match items
    [(LowerIdSet.Nil) false]
    [(LowerIdSet.Cons item rest)
      (if (= item name)
        true
        (lower-id-set-contains? (box-get rest) name))]))

(define (lower-id-set-insert [items : LowerIdSet] [name : i64]) : LowerIdSet
  (if (lower-id-set-contains? items name)
    items
    (LowerIdSet.Cons name (box items))))

(define (lower-spmd-inline-empty-helper-stack) : LowerIdSet
  LowerIdSet.Nil)

(define lower-spmd-inline-helper-stack : LowerIdSet
  (lower-spmd-inline-empty-helper-stack))
(define lower-spmd-inline-recursion-detected : bool
  false)
(define lower-spmd-inline-next-temp : i64
  0)
(define lower-spmd-scalar-call-context : LowerSpmdScalarCallContext
  (LowerSpmdScalarCallContext.No))
(define lower-no-main-entry-prune-active : bool
  false)

(define (lower-reset-file-state!) : unit
  (begin
    (set! lower-entry-main-module-active false)
    (set! lower-entry-main-module "")
    (set! lower-entry-main-module-id cbi.compiler-builtin-id-fix-empty)
    (set! lower-spmd-inline-helper-stack (lower-spmd-inline-empty-helper-stack))
    (set! lower-spmd-inline-recursion-detected false)
    (set! lower-spmd-inline-next-temp 0)
    (set! lower-spmd-scalar-call-context (LowerSpmdScalarCallContext.No))
    (lower-reach-scratch-globals-reset!)
    (lower-module-decl-index-reset!)
    (set! lower-no-main-entry-prune-active false)))

(define (lower-reset-intern-owned-state!) : unit
  (compiler-typecheck-reset-intern-owned-state!))

(define (lower-context-expr-get [ctx : TcContext] [id : i64]) : AstExpr
  (tc-context-expr-get ctx id))

(define (lower-context-expr-push [ctx : TcContext] [expr : AstExpr]) : i64
  (ast-node-pool-context-expr-push (tc-context-pools ctx) expr))

(define (lower-spmd-inline-recursive-message) : String
  "lower: recursive SPMD helper call is not supported")

(define (lower-spmd-inline-fresh-local-id [source-name-id : i64]) : i64
  (let
    [next : i64 lower-spmd-inline-next-temp]
    (begin
      (set! lower-spmd-inline-next-temp (+ lower-spmd-inline-next-temp 1))
      (intern-structural-local-id
        next
        (macro-hygiene-global-source-name-id-or source-name-id source-name-id)))))

(define (lower-spmd-inline-subst-lookup
  [subs : LowerSpmdInlineSubst]
  [name : i64]) : LowerMaybeAstExpr
  (match subs
    [(LowerSpmdInlineSubst.Nil) (LowerMaybeAstExpr.No)]
    [(LowerSpmdInlineSubst.Cons key value rest)
      (if (= key name)
        (LowerMaybeAstExpr.Some value)
        (lower-spmd-inline-subst-lookup (box-get rest) name))]))

(define (lower-spmd-inline-subst-remove
  [subs : LowerSpmdInlineSubst]
  [name : i64]) : LowerSpmdInlineSubst
  (match subs
    [(LowerSpmdInlineSubst.Nil) LowerSpmdInlineSubst.Nil]
    [(LowerSpmdInlineSubst.Cons key value rest)
      (if (= key name)
        (lower-spmd-inline-subst-remove (box-get rest) name)
        (LowerSpmdInlineSubst.Cons
          key
          value
          (box (lower-spmd-inline-subst-remove (box-get rest) name))))]))

(define (lower-spmd-inline-subst-cons
  [name : i64]
  [value : AstExpr]
  [rest : LowerSpmdInlineSubst]) : LowerSpmdInlineSubst
  (LowerSpmdInlineSubst.Cons name value (box rest)))

(define (lower-spmd-inline-helper-from-decl
  [ctx : TcContext]
  [handle : i64]
  [decl : AstDecl]) : ResultLowerSpmdInlineHelper
  (match decl
    [(AstDecl.DefFn decl-meta _ params ret body-box _)
      (let
        [body : AstExpr (lower-context-expr-get ctx body-box)]
        (ResultLowerSpmdInlineHelper.Ok
          (LowerSpmdInlineHelper.Some handle params ret body)))]
    [(AstDecl.Extern _ _ (AstExternKind.Function) metadata ty)
      (match (ast-extern-metadata-imported-spmd (box-get metadata))
        [(AstImportedSpmdMetadata.No)
          (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))]
        [(AstImportedSpmdMetadata.Package canonical-name callables)
          (ResultLowerSpmdInlineHelper.Ok
            (LowerSpmdInlineHelper.Imported canonical-name ty callables))])]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-spmd-inline-helper-from-decl ctx handle inner))]
    [_ (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))]))

(define (lower-spmd-inline-helper-lookup
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [shadowed : LowerIdSet]
  [func : AstExpr]) : ResultLowerSpmdInlineHelper
  (lower-spmd-inline-helper-lookup-resolved
    ctx
    func
    (lower-spmd-inline-helper-name-id ctx env type-env shadowed func)))

(define (lower-spmd-inline-helper-name-id
  [ctx : TcContext]
  [_env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [shadowed : LowerIdSet]
  [func : AstExpr]) : TcNameLookup
  (match (ast-expr-unspan-with-pools (tc-context-pools ctx) func)
    [(AstExpr.Var raw-name)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or raw-name raw-name)]
        [raw-text : String (intern-str source-id)]
        (cond
          [(lower-id-set-contains? shadowed raw-name) (TcNameLookup.Err "")]
          [(macro-hygiene-global-id? raw-name)
            (TcNameLookup.Ok
              (lower-hygiene-source-name-in-context-id ctx type-env raw-name)
              source-id)]
          [(tc-hygiene-global-name? raw-text)
            (TcNameLookup.Ok (tc-hygiene-global-call-name raw-text) source-id)]
          [(tc-source-slash-qualified-id? raw-text source-id)
            (TcNameLookup.Ok raw-text source-id)]
          [else
            (tc-source-name-lookup-key-with-field-check-lookup
              ctx
              type-env
              raw-text
              source-id
              true)]))]
    [_ (TcNameLookup.Err "")]))

(define (lower-spmd-inline-helper-lookup-resolved
  [ctx : TcContext]
  [func : AstExpr]
  [resolved : TcNameLookup]) : ResultLowerSpmdInlineHelper
  (match resolved
    [(TcNameLookup.Ok name lookup-id)
      (if (string.eq name "")
        (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))
        (let
          [handle : i64
            (compiler-symbols-lookup-value-id-or
              (tc-context-symbols ctx)
              lookup-id
              (compiler-symbols-missing-handle))]
          (cond
            [(not (compiler-symbols-handle-found? handle))
              (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))]
            [(and
                (=
                  (compiler-symbol-handle-kind handle)
                  (compiler-symbol-kind-function-define))
                (lower-id-set-contains? lower-spmd-inline-helper-stack handle))
              (begin
                (set! lower-spmd-inline-recursion-detected true)
                (ResultLowerSpmdInlineHelper.Err
                  (box
                    (lower-diagnostic-at-expr
                      func
                      (lower-spmd-inline-recursive-message)))))]
            [(or
                (=
                  (compiler-symbol-handle-kind handle)
                  (compiler-symbol-kind-function-define))
                (=
                  (compiler-symbol-handle-kind handle)
                  (compiler-symbol-kind-extern)))
              (match (compiler-symbols-decl-at-index
                (tc-context-symbols ctx)
                (compiler-symbol-handle-index handle))
                [(ResultAstDecl.Ok decl)
                  (lower-spmd-inline-helper-from-decl ctx handle decl)]
                [(ResultAstDecl.Err message)
                  (ResultLowerSpmdInlineHelper.Err
                    (box (lower-diagnostic message)))])]
            [else (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))])))]
    [(TcNameLookup.Err message)
      (if (string.eq message "")
        (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))
        (ResultLowerSpmdInlineHelper.Err
          (box (lower-diagnostic-at-expr func message))))]))

(define (lower-spmd-inline-build-subst
  [ctx : TcContext]
  [params : AstParamList]
  [args : AstExprList]
  [subst : LowerSpmdInlineSubst]
  [origin : AstExpr]) : ResultLowerSpmdInlineSubst
  (lower-spmd-inline-build-subst-at ctx (& params) (& args) 0 subst origin))

(define (lower-spmd-inline-build-subst-at
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [subst : LowerSpmdInlineSubst]
  [origin : AstExpr]) : ResultLowerSpmdInlineSubst
  (cond
    [(>= index (ast-param-list-len params))
      (if (= index (struct-get args len))
        (ResultLowerSpmdInlineSubst.Ok subst)
        (ResultLowerSpmdInlineSubst.Err
          (box (lower-diagnostic-at-expr origin "lower: arity mismatch"))))]
    [(>= index (struct-get args len))
      (ResultLowerSpmdInlineSubst.Err
        (box (lower-diagnostic-at-expr origin "lower: arity mismatch")))]
    [else
      (let
        [arg-id : i64 (ast-expr-list-get args index 0)]
        [arg : AstExpr (lower-context-expr-get ctx arg-id)]
        (match (ast-param-list-get params index (ast-param-fallback))
          [(AstParam.Param param-name _ _ _)
            (lower-spmd-inline-build-subst-at
              ctx
              params
              args
              (+ index 1)
              (lower-spmd-inline-subst-cons param-name arg subst)
              origin)]))]))

(define (lower-spmd-inline-arg-subst
  [ctx : TcContext]
  [params : AstParamList]
  [args : AstExprList]
  [origin : AstExpr]) : ResultLowerSpmdInlineSubst
  (lower-spmd-inline-build-subst
    ctx
    params
    args
    LowerSpmdInlineSubst.Nil
    origin))

(define (lower-spmd-inline-expr-list
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]) : ResultLowerAstExprList
  (let
    [out : AstExprList (ast-expr-list-with-capacity (struct-get (& exprs) len))]
    (match (lower-spmd-inline-expr-list-into
      ctx
      env
      type-env
      (& exprs)
      0
      subst
      shadowed
      (&mut out))
      [(ResultLowerAstExprList.Ok _) (ResultLowerAstExprList.Ok out)]
      [(ResultLowerAstExprList.Err diag) (ResultLowerAstExprList.Err diag)])))

(define (lower-spmd-inline-expr-list-into
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]
  [out : (&mut out AstExprList)]) : ResultLowerAstExprList
  (if (>= index (struct-get exprs len))
    (ResultLowerAstExprList.Ok (ast-expr-list-new))
    (let
      [head-id : i64 (ast-expr-list-get exprs index 0)]
      [head : AstExpr (lower-context-expr-get ctx head-id)]
      (match (lower-spmd-inline-expr ctx env type-env head subst shadowed)
        [(ResultLowerAstExpr.Ok rewritten-head)
          (begin
            (ast-expr-list-push
              out
              (lower-context-expr-push ctx rewritten-head))
            (lower-spmd-inline-expr-list-into
              ctx
              env
              type-env
              exprs
              (+ index 1)
              subst
              shadowed
              out))]
        [(ResultLowerAstExpr.Err diag) (ResultLowerAstExprList.Err diag)]))))

(define (lower-spmd-inline-let-bindings
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstLetBindingList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]) : ResultLowerSpmdInlineLetBindings
  (let
    [out : AstLetBindingList
      (ast-let-binding-list-with-capacity
        (ast-let-binding-list-len (& bindings)))]
    (match (lower-spmd-inline-let-bindings-into
      ctx
      env
      type-env
      (& bindings)
      subst
      shadowed
      0
      (&mut out))
      [(ResultLowerSpmdInlineLetBindingsBuild.Ok body-subst body-shadowed)
        (ResultLowerSpmdInlineLetBindings.Ok
          (LowerSpmdInlineLetBindings.Bindings out body-subst body-shadowed))]
      [(ResultLowerSpmdInlineLetBindingsBuild.Err diag)
        (ResultLowerSpmdInlineLetBindings.Err diag)])))

(define (lower-spmd-inline-let-bindings-into
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : (& bindings AstLetBindingList)]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]
  [index : i64]
  [out : (&mut out AstLetBindingList)]) : ResultLowerSpmdInlineLetBindingsBuild
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultLowerSpmdInlineLetBindingsBuild.Ok subst shadowed)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          [renamed : bool
            (match subst
              [(LowerSpmdInlineSubst.Nil) false]
              [_ true])]
          [bind-id : i64
            (if renamed
              (lower-spmd-inline-fresh-local-id name)
              name)]
          (match (lower-spmd-inline-expr ctx env type-env init subst shadowed)
            [(ResultLowerAstExpr.Ok rewritten-init)
              (begin
                (ast-let-binding-list-push
                  out
                  (ast-let-binding-id
                    bind-id
                    maybe-ty
                    (lower-context-expr-push ctx rewritten-init)))
                (lower-spmd-inline-let-bindings-into
                  ctx
                  env
                  type-env
                  bindings
                  (if renamed
                    (lower-spmd-inline-subst-cons
                      name
                      (AstExpr.Var bind-id)
                      (lower-spmd-inline-subst-remove subst name))
                    (lower-spmd-inline-subst-remove subst name))
                  (lower-id-set-insert shadowed name)
                  (+ index 1)
                  out))]
            [(ResultLowerAstExpr.Err diag)
              (ResultLowerSpmdInlineLetBindingsBuild.Err diag)]))])))

(define (lower-spmd-inline-helper-body
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [handle : i64]
  [params : AstParamList]
  [args : AstExprList]
  [body : AstExpr]
  [origin : AstExpr]) : ResultLowerAstExpr
  (match (lower-spmd-inline-arg-subst ctx params args origin)
    [(ResultLowerSpmdInlineSubst.Ok helper-subst)
      (let
        [previous : LowerIdSet lower-spmd-inline-helper-stack]
        [result : ResultLowerAstExpr
          (ResultLowerAstExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-spmd-inline-recursive-message))))]
        (begin
          (set!
            lower-spmd-inline-helper-stack
            (lower-id-set-insert previous handle))
          (set!
            result
            (lower-spmd-inline-expr
              ctx
              env
              type-env
              body
              helper-subst
              LowerIdSet.Nil))
          (set! lower-spmd-inline-helper-stack previous)
          result))]
    [(ResultLowerSpmdInlineSubst.Err diag) (ResultLowerAstExpr.Err diag)]))

;; Keep the established small-helper rewrite, but stop cloning larger helper
;; bodies into every vector call site. The limit is deliberately an internal
;; lowering choice: it does not add a source attribute or public varying type.
(define lower-spmd-inline-node-limit : i64
  12)

(define (lower-spmd-inline-expr-list-cost
  [ctx : TcContext]
  [exprs : AstExprList]) : i64
  (lower-spmd-inline-expr-list-cost-at ctx (& exprs) 0))

(define (lower-spmd-inline-expr-list-cost-at
  [ctx : TcContext]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : i64
  (if (>= index (struct-get exprs len))
    0
    (+
      (lower-spmd-inline-expr-cost
        ctx
        (lower-context-expr-get ctx (ast-expr-list-get exprs index 0)))
      (lower-spmd-inline-expr-list-cost-at ctx exprs (+ index 1)))))

(define (lower-spmd-inline-let-cost
  [ctx : TcContext]
  [bindings : AstLetBindingList]) : i64
  (lower-spmd-inline-let-cost-at ctx (& bindings) 0))

(define (lower-spmd-inline-let-cost-at
  [ctx : TcContext]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : i64
  (if (>= index (ast-let-binding-list-len bindings))
    0
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx init-box))
          (lower-spmd-inline-let-cost-at ctx bindings (+ index 1)))])))

(define (lower-spmd-inline-expr-cost [ctx : TcContext] [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Cast inner-box _)
      (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Unary _ inner-box)
      (+
        1
        (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box)))]
    [(AstExpr.Binary _ left-box right-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx left-box))
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx right-box))))]
    [(AstExpr.Call func-box args)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx func-box))
          (lower-spmd-inline-expr-list-cost ctx args)))]
    [(AstExpr.If cond-box then-box else-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx cond-box))
          (+
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx then-box))
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx else-box)))))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (+
            1
            (+
              (lower-spmd-inline-let-cost ctx bindings)
              (lower-spmd-inline-expr-cost
                ctx
                (lower-context-expr-get ctx body-box))))])]
    [(AstExpr.Begin exprs) (+ 1 (lower-spmd-inline-expr-list-cost ctx exprs))]
    [(AstExpr.ArrayRef array-box index-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx array-box))
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx index-box))))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx array-box))
          (+
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx index-box))
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx value-box)))))]
    [_ 1]))

(define (lower-spmd-helper-out-of-line? [ctx : TcContext] [body : AstExpr]) : bool
  (> (lower-spmd-inline-expr-cost ctx body) lower-spmd-inline-node-limit))

(define (lower-spmd-preserve-call
  [ctx : TcContext]
  [func : AstExpr]
  [rewritten-args : AstExprList]) : ResultLowerAstExpr
  (ResultLowerAstExpr.Ok
    (lower-context-expr-get
      ctx
      (ast-expr-call-with-pools
        (tc-context-pools ctx)
        (lower-context-expr-push ctx func)
        rewritten-args))))

(define (lower-spmd-inline-call
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]
  [origin : AstExpr]) : ResultLowerAstExpr
  (match (lower-spmd-inline-expr-list ctx env type-env args subst shadowed)
    [(ResultLowerAstExprList.Ok rewritten-args)
      (match (lower-spmd-inline-helper-lookup ctx env type-env shadowed func)
        [(ResultLowerSpmdInlineHelper.Ok helper)
          (match helper
            [(LowerSpmdInlineHelper.Some name params _ body)
              (if (lower-spmd-helper-out-of-line? ctx body)
                (lower-spmd-preserve-call ctx func rewritten-args)
                (lower-spmd-inline-helper-body
                  ctx
                  env
                  type-env
                  name
                  params
                  rewritten-args
                  body
                  origin))]
            [(LowerSpmdInlineHelper.Imported _ _ _)
              (lower-spmd-preserve-call ctx func rewritten-args)]
            [(LowerSpmdInlineHelper.No)
              (match (lower-spmd-inline-expr
                ctx
                env
                type-env
                func
                subst
                shadowed)
                [(ResultLowerAstExpr.Ok rewritten-func)
                  (ResultLowerAstExpr.Ok
                    (lower-context-expr-get
                      ctx
                      (ast-expr-call-with-pools
                        (tc-context-pools ctx)
                        (lower-context-expr-push ctx rewritten-func)
                        rewritten-args)))]
                [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])])]
        [(ResultLowerSpmdInlineHelper.Err diag) (ResultLowerAstExpr.Err diag)])]
    [(ResultLowerAstExprList.Err diag) (ResultLowerAstExpr.Err diag)]))

(define (lower-spmd-inline-expr
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]) : ResultLowerAstExpr
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten)
            (ResultLowerAstExpr.Ok
              (lower-context-expr-get
                ctx
                (ast-expr-spanned-with-pools
                  (tc-context-pools ctx)
                  (lower-context-expr-push ctx rewritten)
                  span)))]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.Var name)
      (match (lower-spmd-inline-subst-lookup subst name)
        [(LowerMaybeAstExpr.Some value) (ResultLowerAstExpr.Ok value)]
        [(LowerMaybeAstExpr.No) (ResultLowerAstExpr.Ok expr)])]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (match (lower-spmd-inline-expr ctx env type-env left subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-left)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              right
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-right)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast-expr-binary-with-pools
                      (tc-context-pools ctx)
                      op
                      (lower-context-expr-push ctx rewritten-left)
                      (lower-context-expr-push ctx rewritten-right))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten)
            (ResultLowerAstExpr.Ok
              (lower-context-expr-get
                ctx
                (ast-expr-unary-with-pools
                  (tc-context-pools ctx)
                  op
                  (lower-context-expr-push ctx rewritten))))]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (lower-context-expr-get ctx func-box)]
        (lower-spmd-inline-call ctx env type-env func args subst shadowed expr))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (match (lower-spmd-inline-expr ctx env type-env cond subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-cond)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              then-branch
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-then)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  else-branch
                  subst
                  shadowed)
                  [(ResultLowerAstExpr.Ok rewritten-else)
                    (ResultLowerAstExpr.Ok
                      (lower-context-expr-get
                        ctx
                        (ast-expr-if-with-pools
                          (tc-context-pools ctx)
                          (lower-context-expr-push ctx rewritten-cond)
                          (lower-context-expr-push ctx rewritten-then)
                          (lower-context-expr-push ctx rewritten-else))))]
                  [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-spmd-inline-let-bindings
              ctx
              env
              type-env
              bindings
              subst
              shadowed)
              [(ResultLowerSpmdInlineLetBindings.Ok rewritten)
                (match rewritten
                  [(LowerSpmdInlineLetBindings.Bindings
                      rewritten-bindings
                      body-subst
                      body-shadowed)
                    (match (lower-spmd-inline-expr
                      ctx
                      env
                      type-env
                      body
                      body-subst
                      body-shadowed)
                      [(ResultLowerAstExpr.Ok rewritten-body)
                        (ResultLowerAstExpr.Ok
                          (lower-context-expr-get
                            ctx
                            (ast-expr-let-with-pools
                              (tc-context-pools ctx)
                              rewritten-bindings
                              (lower-context-expr-push ctx rewritten-body))))]
                      [(ResultLowerAstExpr.Err diag)
                        (ResultLowerAstExpr.Err diag)])])]
              [(ResultLowerSpmdInlineLetBindings.Err diag)
                (ResultLowerAstExpr.Err diag)]))])]
    [(AstExpr.Begin exprs)
      (match (lower-spmd-inline-expr-list ctx env type-env exprs subst shadowed)
        [(ResultLowerAstExprList.Ok rewritten)
          (ResultLowerAstExpr.Ok (AstExpr.Begin rewritten))]
        [(ResultLowerAstExprList.Err diag) (ResultLowerAstExpr.Err diag)])]
    [(AstExpr.Ann inner-box ty)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten)
            (ResultLowerAstExpr.Ok
              (lower-context-expr-get
                ctx
                (ast-expr-ann-with-pools
                  (tc-context-pools ctx)
                  (lower-context-expr-push ctx rewritten)
                  ty)))]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.Cast inner-box ty)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten)
            (ResultLowerAstExpr.Ok
              (lower-context-expr-get
                ctx
                (ast-expr-cast-with-pools
                  (tc-context-pools ctx)
                  (lower-context-expr-push ctx rewritten)
                  ty)))]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (lower-context-expr-get ctx array-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (match (lower-spmd-inline-expr ctx env type-env array subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-array)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              index
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-index)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast-expr-array-ref-with-pools
                      (tc-context-pools ctx)
                      (lower-context-expr-push ctx rewritten-array)
                      (lower-context-expr-push ctx rewritten-index))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (lower-context-expr-get ctx array-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (match (lower-spmd-inline-expr ctx env type-env array subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-array)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              index
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-index)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  value
                  subst
                  shadowed)
                  [(ResultLowerAstExpr.Ok rewritten-value)
                    (ResultLowerAstExpr.Ok
                      (lower-context-expr-get
                        ctx
                        (ast-expr-array-set-with-pools
                          (tc-context-pools ctx)
                          (lower-context-expr-push ctx rewritten-array)
                          (lower-context-expr-push ctx rewritten-index)
                          (lower-context-expr-push ctx rewritten-value))))]
                  [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : AstExpr (lower-context-expr-get ctx array-box)]
        [live : AstExpr (lower-context-expr-get ctx live-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (match (lower-spmd-inline-expr ctx env type-env array subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-array)
            (match (lower-spmd-inline-expr ctx env type-env live subst shadowed)
              [(ResultLowerAstExpr.Ok rewritten-live)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  index
                  subst
                  shadowed)
                  [(ResultLowerAstExpr.Ok rewritten-index)
                    (ResultLowerAstExpr.Ok
                      (lower-context-expr-get
                        ctx
                        (ast-expr-array-take-with-pools
                          (tc-context-pools ctx)
                          (lower-context-expr-push ctx rewritten-array)
                          (lower-context-expr-push ctx rewritten-live)
                          (lower-context-expr-push ctx rewritten-index))))]
                  [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (match (lower-spmd-inline-expr ctx env type-env receiver subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-receiver)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              value
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-value)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast-expr-struct-set-id-with-pools
                      (tc-context-pools ctx)
                      (lower-context-expr-push ctx rewritten-receiver)
                      field
                      (lower-context-expr-push ctx rewritten-value))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (lower-context-expr-get ctx start-box)]
            [end : AstExpr (lower-context-expr-get ctx end-box)]
            [init : AstExpr (lower-context-expr-get ctx init-box)]
            [value : AstExpr (lower-context-expr-get ctx value-box)]
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              start
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-start)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  end
                  subst
                  shadowed)
                  [(ResultLowerAstExpr.Ok rewritten-end)
                    (match (lower-spmd-inline-expr
                      ctx
                      env
                      type-env
                      init
                      subst
                      shadowed)
                      [(ResultLowerAstExpr.Ok rewritten-init)
                        (match (lower-spmd-inline-expr
                          ctx
                          env
                          type-env
                          value
                          subst
                          shadowed)
                          [(ResultLowerAstExpr.Ok rewritten-value)
                            (match (lower-spmd-inline-expr
                              ctx
                              env
                              type-env
                              body
                              subst
                              shadowed)
                              [(ResultLowerAstExpr.Ok rewritten-body)
                                (ResultLowerAstExpr.Ok
                                  (AstExpr.SpmdScan
                                    (box
                                      (AstSpmdScan.Scan
                                        op
                                        index
                                        index-ty
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-start)
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-end)
                                        prefix
                                        prefix-ty
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-init)
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-value)
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-body)))))]
                              [(ResultLowerAstExpr.Err diag)
                                (ResultLowerAstExpr.Err diag)])]
                          [(ResultLowerAstExpr.Err diag)
                            (ResultLowerAstExpr.Err diag)])]
                      [(ResultLowerAstExpr.Err diag)
                        (ResultLowerAstExpr.Err diag)])]
                  [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        [lane : AstExpr (lower-context-expr-get ctx lane-box)]
        (match (lower-spmd-inline-expr ctx env type-env value subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-value)
            (match (lower-spmd-inline-expr ctx env type-env lane subst shadowed)
              [(ResultLowerAstExpr.Ok rewritten-lane)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast-expr-spmd-broadcast-with-pools
                      (tc-context-pools ctx)
                      (lower-context-expr-push ctx rewritten-value)
                      (lower-context-expr-push ctx rewritten-lane))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        [lane : AstExpr (lower-context-expr-get ctx lane-box)]
        (match (lower-spmd-inline-expr ctx env type-env value subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-value)
            (match (lower-spmd-inline-expr ctx env type-env lane subst shadowed)
              [(ResultLowerAstExpr.Ok rewritten-lane)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast-expr-spmd-shuffle-with-pools
                      (tc-context-pools ctx)
                      (lower-context-expr-push ctx rewritten-value)
                      (lower-context-expr-push ctx rewritten-lane))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [_ (ResultLowerAstExpr.Ok expr)]))

(define (lower-function-logical-id-from-decl
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : AstDecl]) : LowerNameCacheMaybeId
  (match decl
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (LowerNameCacheMaybeId.Some
        (lower-decl-logical-id
          entry-path
          decl-path
          module
          module-id
          name
          (tc-env-key-name-text name)))]
    [(AstDecl.Unsafe inner-box)
      (lower-function-logical-id-from-decl
        entry-path
        decl-path
        module
        module-id
        (box-get inner-box))]
    [_ (LowerNameCacheMaybeId.No)]))

(define (lower-function-set-from-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [_module : String]
  [module-id : i64]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [cur-out : lower_i64_i64_map.Map out]
    (begin
      (while (< index count)
        (let
          [decl : AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          [decl-path : String
            (ast-decl-path-list-get (& paths) index entry-path)]
          [logical-module-id : i64
            (lower-decl-owner-module-id
              (& paths)
              index
              entry-path
              decl-path
              cur-module-id)]
          (begin
            (match decl
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [_
                (match (lower-function-logical-id-from-decl
                  entry-path
                  decl-path
                  (lower-decl-owner-module-name cur-module-id logical-module-id)
                  logical-module-id
                  decl)
                  ;; Assign each distinct function name a dense slot
                  ;; (0..N-1, its insertion order) instead of a constant 1, so
                  ;; prune reachability `reachable` can key on that i64 slot.
                  ;; Skip names already present so the slot stays a bijection.
                  [(LowerNameCacheMaybeId.Some logical-id)
                    (if (lower_i64_i64_map.contains? (& cur-out) logical-id)
                      unit
                      (let
                        [slot : i64 (lower_i64_i64_map.len (& cur-out))]
                        (lower_i64_i64_map.insert-ref!
                          (&mut cur-out)
                          logical-id
                          slot)))]
                  [(LowerNameCacheMaybeId.No) unit])])
            (set! index (+ index 1)))))
      cur-out)))

(define (lower-function-set-from-decls
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]) : lower_i64_i64_map.Map
  (lower-function-set-from-decls-in-module
    decls
    paths
    entry-path
    ""
    cbi.compiler-builtin-id-fix-empty
    (lower_i64_i64_map.with-capacity 8192)))

(define (lower-reach-add-logical
  [all-functions : lower_i64_i64_map.Map]
  [state : LowerReachState]
  [logical-id : i64]) : LowerReachState
  (match (lower_i64_i64_map.get (& all-functions) logical-id)
    [(lower_i64_i64_map.LookupMissing) state]
    [(lower_i64_i64_map.LookupFound slot)
      (match state
        [(LowerReachState.State reachable worklist)
          (if (lower_i64_i64_map.contains? (& reachable) slot)
            state
            (let
              [next-reachable : lower_i64_i64_map.Map reachable]
              (begin
                (lower_i64_i64_map.insert-ref! (&mut next-reachable) slot 1)
                (LowerReachState.State
                  next-reachable
                  (LowerIdSet.Cons logical-id (box worklist))))))])]))

(define (lower-runtime-prelude-string-helper-id [source-id : i64]) : i64
  (let
    [raw-id : i64 (macro-hygiene-global-source-name-id-or source-id source-id)]
    [base-id : i64 (tc-qualified-name-base-id raw-id)]
    (cond
      [(= base-id cbi.compiler-builtin-id-tl-int-to-string)
        cbi.compiler-builtin-id-runtime-int-to-string]
      [(= base-id cbi.compiler-builtin-id-tl-substring)
        cbi.compiler-builtin-id-runtime-substring]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-str-view)
          (= base-id cbi.compiler-builtin-id-tl-bytes-view-from-str-parts)
          (= base-id cbi.compiler-builtin-id-tl-bytes-view-from-buf-parts)
          (= base-id cbi.compiler-builtin-id-tl-bytes-mut-view-from-buf-parts)
          (= base-id cbi.compiler-builtin-id-tl-bytes-view-from-bytes-parts)
          (= base-id cbi.compiler-builtin-id-tl-bytes-mut-view-from-bytes-parts))
        cbi.compiler-builtin-id-runtime-str-view]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat)
        cbi.compiler-builtin-id-string-concat]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat3)
        cbi.compiler-builtin-id-runtime-string-concat3]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat4)
        cbi.compiler-builtin-id-runtime-string-concat4]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat5)
        cbi.compiler-builtin-id-runtime-string-concat5]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-load-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-load)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-load-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-load-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-store-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-store)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-store-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-store-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-fetch-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-fetch-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-fetch-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-fetch-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-cas-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-cas)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-cas-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-cas-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-load-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-load)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-load-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-load-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-store-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-store)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-store-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-store-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-fetch-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-fetch-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-fetch-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-fetch-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-cas-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-cas)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-cas-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-cas-ptr]
      [else -1])))

(define (lower-runtime-prelude-selective-export-id?
  [module-id : i64]
  [symbol-id : i64]) : bool
  (and
    (= module-id cbi.compiler-builtin-id-runtime-module)
    (>= (lower-runtime-prelude-string-helper-id symbol-id) 0)))

(define (lower-reach-add-runtime-prelude-string-helper-id
  [all-functions : lower_i64_i64_map.Map]
  [state : LowerReachState]
  [source-id : i64]) : LowerReachState
  (let
    [helper-id : i64 (lower-runtime-prelude-string-helper-id source-id)]
    (if (< helper-id 0)
      state
      (lower-reach-add-logical
        all-functions
        (lower-reach-add-logical all-functions state helper-id)
        (compiler-symbol-module-key-id-by-id
          cbi.compiler-builtin-id-runtime-module
          helper-id)))))

(define (lower-reach-add-string-snapshot-runtime
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]) : LowerReachState
  ;; Clone-out/capture snapshot lowering copies owned String buffers through
  ;; the fixed `tl_substring` ABI helper, so keep its TypeLisp runtime body
  ;; when a reachable source form can synthesize that call after this prune
  ;; pass. Public stdlib string substring helpers are normal source functions;
  ;; explicit `tl_substring` extern references are rooted through the runtime
  ;; prelude helper path instead.
  (lower-reach-add-runtime-prelude-string-helper-resolved-id
    all-functions
    names
    state
    cbi.compiler-builtin-id-tl-substring))

(define (lower-reach-add-runtime-prelude-string-helper-resolved-id
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [source-id : i64]) : LowerReachState
  (let
    [helper-id : i64 (lower-runtime-prelude-string-helper-id source-id)]
    (if (< helper-id 0)
      state
      (let
        [module-helper-id : i64
          (compiler-symbol-module-key-id-by-id
            cbi.compiler-builtin-id-runtime-module
            helper-id)]
        [helper-logical-id : i64
          (lower-name-cache-resolve-logical-id (& names) helper-id helper-id)]
        [module-helper-logical-id : i64
          (lower-name-cache-resolve-logical-id
            (& names)
            module-helper-id
            module-helper-id)]
        (lower-reach-add-logical
          all-functions
          (lower-reach-add-logical
            all-functions
            (lower-reach-add-runtime-prelude-string-helper-id
              all-functions
              state
              source-id)
            helper-logical-id)
          module-helper-logical-id)))))

;; `lower-string-concat` emits one of these fixed ABI calls after source
;; reachability has already completed. Root their TypeLisp runtime exports from
;; the source call so pruning cannot leave the generated call unresolved.
(define (lower-reach-add-string-concat-runtime
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]) : LowerReachState
  (lower-reach-add-runtime-prelude-string-helper-resolved-id
    all-functions
    names
    (lower-reach-add-runtime-prelude-string-helper-resolved-id
      all-functions
      names
      (lower-reach-add-runtime-prelude-string-helper-resolved-id
        all-functions
        names
        (lower-reach-add-runtime-prelude-string-helper-resolved-id
          all-functions
          names
          state
          cbi.compiler-builtin-id-tl-string-concat)
        cbi.compiler-builtin-id-tl-string-concat3)
      cbi.compiler-builtin-id-tl-string-concat4)
    cbi.compiler-builtin-id-tl-string-concat5))

(define (lower-reach-legacy-string-concat-source-id? [source-id : i64]) : bool
  (let
    [raw-id : i64 (macro-hygiene-global-source-name-id-or source-id source-id)]
    ;; These legacy intrinsics have no source definition to resolve. A user
    ;; definition with the same spelling can retain unused runtime exports,
    ;; but it cannot change the source program's behavior.
    (or
      (= raw-id cbi.compiler-builtin-id-string-append)
      (= raw-id cbi.compiler-builtin-id-string-concat))))

(define (lower-reach-stdlib-string-concat-logical-id?
  [names : LowerNameCache]
  [logical-id : i64]) : bool
  ;; Alias spellings are no longer present once the reach worklist reaches the
  ;; public wrapper. Compare its resolved logical identity instead, so a
  ;; compiler-fused `string_mod.append` (or macro-generated alias) also keeps
  ;; the post-prune runtime ABI exports.
  (let
    [module-id : i64 cbi.compiler-builtin-id-fix-stdlib_dot_string]
    [append-id : i64
      (compiler-symbol-module-key-id-by-id
        module-id
        cbi.compiler-builtin-id-fix-append)]
    [concat-id : i64
      (compiler-symbol-module-key-id-by-id
        module-id
        cbi.compiler-builtin-id-fix-concat)]
    (or
      (=
        logical-id
        (lower-name-cache-resolve-logical-id (& names) append-id append-id))
      (=
        logical-id
        (lower-name-cache-resolve-logical-id (& names) concat-id concat-id)))))

(define (lower-reach-public-string-concat-source-id?
  [names : LowerNameCache]
  [source-id : i64]) : bool
  ;; Resolve aliases before deciding whether this source call can be fused. The
  ;; generated runtime calls need reachability roots only for a nested public
  ;; tree, not for every ordinary `string.append` wrapper call.
  (let
    [mapped-source-id : i64
      (macro-hygiene-global-source-name-id-or source-id source-id)]
    [hygiene-key-id : i64 (tc-env-name-key-id source-id)]
    [hygiene-logical-id : i64
      (if (= hygiene-key-id source-id)
        -1
        (lower-name-cache-lookup-logical-id (& names) hygiene-key-id -1))]
    [logical-id : i64
      (if (>= hygiene-logical-id 0)
        hygiene-logical-id
        (lower-name-cache-resolve-logical-id (& names) mapped-source-id -1))]
    (lower-reach-stdlib-string-concat-logical-id? names logical-id)))

(define (lower-reach-string-concat-call?
  [pools : AstNodePoolContext]
  [names : LowerNameCache]
  [expr : AstExpr]) : bool
  (match (ast-expr-unspan-with-pools pools expr)
    [(AstExpr.Call callee-box args)
      (let
        [callee : AstExpr (ast-node-pool-context-expr-get pools callee-box)]
        (match (ast-expr-unspan-with-pools pools callee)
          [(AstExpr.Var name)
            (and
              (= (struct-get (& args) len) 2)
              (or
                (lower-reach-legacy-string-concat-source-id? name)
                (lower-reach-public-string-concat-source-id? names name)))]
          [_ false]))]
    [_ false]))

(define (lower-reach-public-string-concat-tree?
  [pools : AstNodePoolContext]
  [names : LowerNameCache]
  [callee : AstExpr]
  [args : AstExprList]) : bool
  (if (= (struct-get (& args) len) 2)
    (match (ast-expr-unspan-with-pools pools callee)
      [(AstExpr.Var name)
        (and
          (lower-reach-public-string-concat-source-id? names name)
          (let
            [left : AstExpr
              (ast-node-pool-context-expr-get
                pools
                (ast-expr-list-get (& args) 0 0))]
            [right : AstExpr
              (ast-node-pool-context-expr-get
                pools
                (ast-expr-list-get (& args) 1 0))]
            (or
              (lower-reach-string-concat-call? pools names left)
              (lower-reach-string-concat-call? pools names right))))]
      [_ false])
    false))

(define (lower-reach-string-snapshot-source-call? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-clone-id?
    (macro-hygiene-global-source-name-id-or name-id name-id)))

(define (lower-reach-add-source-id
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [source-id : i64]) : LowerReachState
  (let
    [mapped-source-id : i64
      (macro-hygiene-global-source-name-id-or source-id source-id)]
    [hygiene-key-id : i64 (tc-env-name-key-id source-id)]
    [hygiene-logical-id : i64
      (if (= hygiene-key-id source-id)
        -1
        (lower-name-cache-lookup-logical-id (& names) hygiene-key-id -1))]
    [logical-id : i64
      (if (>= hygiene-logical-id 0)
        hygiene-logical-id
        (lower-name-cache-resolve-logical-id (& names) mapped-source-id -1))]
    (lower-reach-add-runtime-prelude-string-helper-resolved-id
      all-functions
      names
      (lower-reach-add-stdlib-string-public-helper-id
        all-functions
        names
        (lower-reach-add-runtime-prelude-string-helper-id
          all-functions
          (lower-reach-add-logical all-functions state logical-id)
          source-id)
        source-id)
      source-id)))

(define (lower-reach-add-stdlib-string-public-helper-id
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [source-id : i64]) : LowerReachState
  (let
    [raw-id : i64 (macro-hygiene-global-source-name-id-or source-id source-id)]
    [base-id : i64 (tc-qualified-name-base-id raw-id)]
    (if (or
      (= base-id cbi.compiler-builtin-id-string-length)
      (= base-id cbi.compiler-builtin-id-string-ref)
      (= base-id cbi.compiler-builtin-id-char-at)
      (= base-id cbi.compiler-builtin-id-string-eq)
      (= base-id cbi.compiler-builtin-id-string-eq-question)
      (= base-id cbi.compiler-builtin-id-string-to-int))
      (let
        [module-source-id : i64
          (compiler-symbol-module-key-id-by-id
            cbi.compiler-builtin-id-fix-stdlib_dot_string
            base-id)]
        (lower-reach-add-logical
          all-functions
          state
          (lower-name-cache-resolve-logical-id
            (& names)
            module-source-id
            module-source-id)))
      state)))

(define (lower-reach-used-type-name-add-source! [name : i64]) : unit
  (if (or (tc-name-qualified-id? name) (>= (tc-name-first-dot-id name) 0))
    (set!
      lower-reach-active-body-used-types
      (lower-used-type-name-add lower-reach-active-body-used-types "" name))
    unit))

(define (lower-reach-used-types-add-pattern-roots! [pattern : AstPattern]) : unit
  (match pattern
    [(AstPattern.Var _ _) unit]
    [(AstPattern.Tuple patterns-box)
      (lower-reach-used-types-add-pattern-list-roots! (box-get patterns-box))]
    [(AstPattern.Wildcard) unit]
    [(AstPattern.Binding _) unit]
    [(AstPattern.Variant name patterns-box)
      (begin
        (lower-reach-used-type-name-add-source! name)
        (lower-reach-used-types-add-pattern-list-roots! (box-get patterns-box)))]
    [(AstPattern.Literal _) unit]))

(define (lower-reach-used-types-add-pattern-list-roots!
  [patterns : AstPatternList]) : unit
  (lower-reach-used-types-add-pattern-list-roots-at! (& patterns) 0))

(define (lower-reach-used-types-add-pattern-list-roots-at!
  [patterns : (& patterns AstPatternList)]
  [index : i64]) : unit
  (if (>= index (struct-get patterns len))
    unit
    (begin
      (lower-reach-used-types-add-pattern-roots!
        (ast-pattern-list-get patterns index (ast-pattern-fallback)))
      (lower-reach-used-types-add-pattern-list-roots-at! patterns (+ index 1)))))

(define (lower-reach-expr-list
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [exprs : AstExprList]) : LowerReachState
  (lower-reach-expr-list-at pools all-functions names state (& exprs) 0))

(define (lower-reach-expr-list-at
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : LowerReachState
  (if (>= index (struct-get exprs len))
    state
    (let
      [expr-id : i64 (ast-expr-list-get exprs index 0)]
      [expr : AstExpr (ast-node-pool-context-expr-get pools expr-id)]
      (lower-reach-expr-list-at
        pools
        all-functions
        names
        (lower-reach-expr pools all-functions names state expr)
        exprs
        (+ index 1)))))

(define (lower-reach-let-bindings
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : AstLetBindingList]) : LowerReachState
  (lower-reach-let-bindings-at pools all-functions names state (& bindings) 0))

(define (lower-reach-let-bindings-at
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : LowerReachState
  (if (>= index (ast-let-binding-list-len bindings))
    state
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ value-box)
        (let
          [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
          (lower-reach-let-bindings-at
            pools
            all-functions
            names
            (lower-reach-expr pools all-functions names state value)
            bindings
            (+ index 1)))])))

(define (lower-reach-match-arms
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [arms : AstMatchArmList]) : LowerReachState
  (lower-reach-match-arms-at pools all-functions names state (& arms) 0))

(define (lower-reach-match-arms-at
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : LowerReachState
  (if (>= index (struct-get arms len))
    state
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-pool-context-expr-get pools body-box)]
          (begin
            (lower-reach-used-types-add-pattern-roots! pattern)
            (lower-reach-match-arms-at
              pools
              all-functions
              names
              (lower-reach-expr pools all-functions names state body)
              arms
              (+ index 1))))])))

(define (lower-reach-resource-bindings
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : AstResourceBindingList]) : LowerReachState
  (lower-reach-resource-bindings-at
    pools
    all-functions
    names
    state
    (& bindings)
    0))

(define (lower-reach-resource-bindings-at
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : LowerReachState
  (if (>= index (ast-resource-binding-list-len bindings))
    state
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ acquire-box cleanup-box _)
        (let
          [acquire : AstExpr (ast-node-pool-context-expr-get pools acquire-box)]
          [cleanup : AstExpr (ast-node-pool-context-expr-get pools cleanup-box)]
          (lower-reach-resource-bindings-at
            pools
            all-functions
            names
            (lower-reach-expr
              pools
              all-functions
              names
              (lower-reach-expr pools all-functions names state acquire)
              cleanup)
            bindings
            (+ index 1)))])))

(define (lower-clone-handoff-type-args
  [ctx : TcContext]
  [pools : AstNodePoolContext]
  [roots : CloneNameList]) : AstExprList
  (match roots
    [(CloneNameList.Nil) (ast-expr-list-new)]
    [(CloneNameList.ConsId root-key-id _ rest)
      (let
        [module-id : i64
          (if (clone-name-key-qualified? root-key-id)
            (clone-name-key-module-id root-key-id)
            cbi.compiler-builtin-id-fix-empty)]
        (ast-expr-cons
          (ast-node-pool-context-expr-push
            pools
            (AstExpr.Literal (AstLiteral.String module-id)))
          (ast-expr-cons
            (ast-node-pool-context-expr-push
              pools
              (AstExpr.TypeLiteral
                (tc-resolve-type ctx (AstType.Var root-key-id))))
            (lower-clone-handoff-type-args ctx pools (box-get rest)))))]))

(define (lower-clone-handoff-request-decl
  [ctx : TcContext]
  [pools : AstNodePoolContext]
  [roots : CloneNameList]) : AstDecl
  (let
    [callee : i64
      (ast-node-pool-context-expr-push
        pools
        (AstExpr.Var
          (macro-hygiene-global-id
            cbi.compiler-builtin-id-fix-stdlib_dot_clone
            cbi.compiler-builtin-id-fix-synthesize_helpers
            false)))]
    [call-id : i64
      (ast-expr-call-with-pools
        pools
        callee
        (lower-clone-handoff-type-args ctx pools roots))]
    (AstDecl.Import
      ast-decl-meta-runtime
      (AstImportSpec.Spec
        (AstImportKind.MacroDecls call-id AstMaybeModuleName.No)
        ""
        AstMaybeModuleName.No
        AstMaybeImportAlias.No
        (box (ast-decl-span-fallback))))))

(define (lower-clone-handoff-generated-origin-count-in-module
  [decls : AstDeclList]
  [root-key-id : i64]
  [helper-name-id : i64]
  [module-id : i64]) : i64
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) 0]
    [(AstDeclListStep.Cons decl rest)
      (match decl
        [(AstDecl.Module next-module)
          (lower-clone-handoff-generated-origin-count-in-module
            rest
            root-key-id
            helper-name-id
            next-module)]
        [_
          (+
            (match (ast-decl-generated-meta decl)
              [(AstGeneratedDeclMeta.Some generator item _ key)
                (if (and
                  (string.eq generator "stdlib.clone/synthesize-helpers")
                  (string.eq item (intern-str helper-name-id))
                  (tc-string-prefix?
                    key
                    "decls:stdlib.clone:stdlib.clone/synthesize-helpers(")
                  (=
                    module-id
                    (if (clone-name-key-qualified? root-key-id)
                      (clone-name-key-module-id root-key-id)
                      cbi.compiler-builtin-id-fix-empty))
                  (=
                    (clone-helper-decl-count
                      (ast-decl-cons
                        (ast-decl-module-id module-id)
                        (ast-decl-cons decl (ast-decl-list-new)))
                      root-key-id
                      helper-name-id)
                    1))
                  1
                  0)]
              [(AstGeneratedDeclMeta.No) 0])
            (lower-clone-handoff-generated-origin-count-in-module
              rest
              root-key-id
              helper-name-id
              module-id))])]))

(define (lower-clone-handoff-generated-origin-count
  [decls : AstDeclList]
  [root-key-id : i64]
  [helper-name-id : i64]) : i64
  (lower-clone-handoff-generated-origin-count-in-module
    decls
    root-key-id
    helper-name-id
    cbi.compiler-builtin-id-fix-empty))

;; Caches that may capture scratch-arena values produced by the handoff
;; expansion. Each is a pure memo rebuilt on demand; resetting them before the
;; scratch arena is destroyed mirrors the macro-walk boundary clears.
(define (lower-clone-handoff-expansion-cache-clear!) : unit
  (begin
    (macro-generated-decls-memo-reset!)
    (macro-generated-module-memo-reset!)
    (tc-macro-helper-env-cache-reset!)
    (tc-nominal-owner-cache-reset!)
    (macro-alias-derived-cache-reset!)
    (ctfe-module-macro-export-reset!)))

;; The handoff expansion runs the full macro/CTFE machinery for every clone
;; root in one shot. Its working set (CTFE values, env spines, memo entries) is
;; dead once the generated helper declarations exist, but unlike the main macro
;; walk it runs after macro_detach -- no later pool compaction retires that
;; garbage, and on a self-compile it retained ~745MB in the persistent base
;; arena for the rest of the compile. Run the expansion in a scratch arena and
;; copy only the returned declarations out (the mark/rewind/clone-out shape of
;; tc-check-fn-decl-scoped): node-pool growth and interned spellings already
;; live in their persistent owners, type-node payloads are persisted at push
;; time by ty-node-persist, and ast-program-copy-append-with-pools deep-copies
;; the decl shells and any scratch-resident expr payloads, remapping the
;; appended expr/type ids.
(define (lower-clone-handoff-expansion-copy-out
  [pools : AstNodePoolContext]
  [raw : ResultMacroDeclExpansion]) : ResultMacroDeclExpansion
  (match raw
    [(ResultMacroDeclExpansion.Ok generated generated-paths)
      (match (ast-program-copy-append-with-pools
        pools
        pools
        (ast-program generated))
        [(AstProgramCompaction copied _)
          (match copied
            [(AstProgram.Program decls-box)
              (ResultMacroDeclExpansion.Ok
                (box-get decls-box)
                (lower-copy-paths-into-pools generated-paths pools))])])]
    [(ResultMacroDeclExpansion.Err diag)
      (ResultMacroDeclExpansion.Err
        (box (compiler-diagnostic-copy (box-get diag))))]))

(define (lower-clone-handoff-expand-one
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [source-decls : AstDeclList]
  [entry-path : String]
  [pools : AstNodePoolContext]
  [roots : CloneNameList]) : ResultMacroDeclExpansion
  (let
    [request : AstDecl (lower-clone-handoff-request-decl ctx pools roots)]
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (arena.tl_arena_make)]
    (begin
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [raw : ResultMacroDeclExpansion
          (macro-expand-decl-with-path
            (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
            top-env
            source-decls
            ""
            cbi.compiler-builtin-id-fix-empty
            request
            entry-path)]
        (begin
          (unsafe
            (arena.tl_arena_set enclosing))
          (ast-node-pool-context-capture-active! pools)
          (let
            [escaped : ResultMacroDeclExpansion
              (lower-clone-handoff-expansion-copy-out pools raw)]
            (begin
              (lower-clone-handoff-expansion-cache-clear!)
              (unsafe
                (arena.tl_arena_destroy scratch))
              (ast-node-pool-context-install! pools)
              escaped)))))))

(define (lower-clone-handoff-source-helper-root-id
  [name-id : i64]
  [module-id : i64]
  [roots : CloneNameList]) : i64
  (match roots
    [(CloneNameList.Nil) -1]
    [(CloneNameList.ConsId root-key-id helper-name-id rest)
      (let
        [root-module-id : i64
          (if (clone-name-key-qualified? root-key-id)
            (clone-name-key-module-id root-key-id)
            cbi.compiler-builtin-id-fix-empty)]
        (if (and
          (= module-id root-module-id)
          (string.eq (tc-env-key-name-text name-id) (intern-str helper-name-id)))
          root-key-id
          (lower-clone-handoff-source-helper-root-id
            name-id
            module-id
            (box-get rest))))]))

(define (lower-clone-handoff-source-conflict-in-module
  [source-decls : AstDeclList]
  [roots : CloneNameList]
  [module-id : i64]) : i64
  (match (ast-decl-list-step source-decls)
    [(AstDeclListStep.Nil) -1]
    [(AstDeclListStep.Cons decl rest)
      (match (ast-decl-unwrapped decl)
        [(AstDecl.Module next-module)
          (lower-clone-handoff-source-conflict-in-module rest roots next-module)]
        [(AstDecl.DefFn decl-meta name _ _ _ _)
          (let
            [root-key-id : i64
              (lower-clone-handoff-source-helper-root-id name module-id roots)]
            (if (>= root-key-id 0)
              root-key-id
              (lower-clone-handoff-source-conflict-in-module
                rest
                roots
                module-id)))]
        [_ (lower-clone-handoff-source-conflict-in-module rest roots module-id)])]))

(define (lower-clone-handoff-source-conflict
  [source-decls : AstDeclList]
  [roots : CloneNameList]) : i64
  (lower-clone-handoff-source-conflict-in-module
    source-decls
    roots
    cbi.compiler-builtin-id-fix-empty))

(define (lower-clone-handoff-generated-roots-ok?
  [generated : AstDeclList]
  [roots : CloneNameList]) : bool
  (match roots
    [(CloneNameList.Nil) true]
    [(CloneNameList.ConsId root-key-id helper-name-id rest)
      (and
        (= (clone-helper-decl-count generated root-key-id helper-name-id) 1)
        (=
          (lower-clone-handoff-generated-origin-count
            generated
            root-key-id
            helper-name-id)
          1)
        (lower-clone-handoff-generated-roots-ok? generated (box-get rest)))]))

;; Expand roots in bounded chunks: the one-shot expansion's macro/CTFE working
;; set scales with the whole root list (hundreds of MB of interpreter churn on
;; a self-compile), but only one chunk's worth needs to be live at a time.
;; Helpers are generated per type key, so chunking preserves the output union.
(defenum LowerCloneRootsChunk
  (Chunk CloneNameList CloneNameList))

(define (lower-clone-name-list-reverse
  [xs : CloneNameList]
  [acc : CloneNameList]) : CloneNameList
  (match xs
    [(CloneNameList.Nil) acc]
    [(CloneNameList.ConsId k h rest)
      (lower-clone-name-list-reverse
        (box-get rest)
        (CloneNameList.ConsId k h (box acc)))]))

(define (lower-clone-handoff-roots-take
  [roots : CloneNameList]
  [n : i64]
  [acc : CloneNameList]) : LowerCloneRootsChunk
  (match roots
    [(CloneNameList.Nil)
      (LowerCloneRootsChunk.Chunk
        (CloneNameList.Nil)
        (lower-clone-name-list-reverse acc (CloneNameList.Nil)))]
    [_
      (if (<= n 0)
        (LowerCloneRootsChunk.Chunk
          roots
          (lower-clone-name-list-reverse acc (CloneNameList.Nil)))
        (match roots
          [(CloneNameList.Nil)
            (LowerCloneRootsChunk.Chunk
              (CloneNameList.Nil)
              (lower-clone-name-list-reverse acc (CloneNameList.Nil)))]
          [(CloneNameList.ConsId k h rest)
            (lower-clone-handoff-roots-take
              (box-get rest)
              (- n 1)
              (CloneNameList.ConsId k h (box acc)))]))]))

(define (lower-clone-handoff-expand-roots
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [source-decls : AstDeclList]
  [entry-path : String]
  [pools : AstNodePoolContext]
  [roots : CloneNameList]
  [acc : AstDeclList]) : ResultMacroDecls
  (match roots
    [(CloneNameList.Nil) (ResultMacroDecls.Ok acc)]
    [_
      (match (lower-clone-handoff-roots-take roots 16 (CloneNameList.Nil))
        [(LowerCloneRootsChunk.Chunk rest chunk)
          (match (lower-clone-handoff-expand-one
            ctx
            top-env
            source-decls
            entry-path
            pools
            chunk)
            [(ResultMacroDeclExpansion.Ok generated _)
              (match chunk
                [(CloneNameList.Nil)
                  (ResultMacroDecls.Err
                    (box
                      (tc-diag-at-start
                        "clone: stdlib handoff produced no helpers")))]
                [(CloneNameList.ConsId root-key-id helper-name-id _)
                  (if (lower-clone-handoff-generated-roots-ok? generated chunk)
                    (begin
                      (ast-node-pool-context-capture-active! pools)
                      (lower-clone-handoff-expand-roots
                        ctx
                        top-env
                        source-decls
                        entry-path
                        pools
                        rest
                        (clone-decl-list-append acc generated)))
                    (ResultMacroDecls.Err
                      (box
                        (tc-diag-at-start
                          (str_cat.str-cat
                            "clone: stdlib handoff produced an invalid or conflicting helper for "
                            (clone-name-key-string root-key-id)
                            " (helper-count="
                            (string.int->string
                              (clone-helper-decl-count
                                generated
                                root-key-id
                                helper-name-id))
                            ", origin-count="
                            (string.int->string
                              (lower-clone-handoff-generated-origin-count
                                generated
                                root-key-id
                                helper-name-id))
                            ")")))))])]
            [(ResultMacroDeclExpansion.Err diag) (ResultMacroDecls.Err diag)])])]))

(define (lower-clone-handoff-augment
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [entry-path : String]
  [program : AstProgram]
  [able : CloneNameSet]
  [roots : CloneNameList]
  [pools : AstNodePoolContext]) : ResultLowerCloneAugment
  (match program
    [(AstProgram.Program decls-box)
      (let
        [source-decls : AstDeclList (box-get decls-box)]
        [handoff-roots : CloneNameList
          (clone-stdlib-handoff-roots pools source-decls able roots)]
        [conflict : i64
          (lower-clone-handoff-source-conflict source-decls handoff-roots)]
        (if (>= conflict 0)
          (ResultLowerCloneAugment.Err
            (str_cat.str-cat
              "clone: conflicting helper producer for "
              (clone-helper-name (clone-name-key-string conflict))))
          (match (lower-clone-handoff-expand-roots
            ctx
            top-env
            source-decls
            entry-path
            pools
            handoff-roots
            (ast-decl-list-new))
            [(ResultMacroDecls.Ok handoff-decls)
              (let
                [augmented-decls : AstDeclList
                  (clone-decl-list-append source-decls handoff-decls)]
                (ResultLowerCloneAugment.Ok
                  (ast-program augmented-decls)
                  handoff-decls))]
            [(ResultMacroDecls.Err diag)
              (ResultLowerCloneAugment.Err
                (compiler-diagnostic-message (box-get diag)))])))]))

(define (lower-extend-checked-context-with-clone-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [source-decl-count : i64]
  [program : AstProgram]) : ResultLowerCheckedContext
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        [clone-decls : AstDeclList (tc-decl-list-drop decls source-decl-count)]
        [next-ctx : TcContext (tc-context-with-program ctx program)]
        (match (env-extend-with-module next-ctx top-env clone-decls)
          [(ResultTcEnv.Ok next-env)
            (begin
              (tc-context-capture-active-pools! next-ctx)
              (tc-hygiene-reset-active-top-env! next-env)
              (tc-macro-helper-env-cache-reset!)
              (ResultLowerCheckedContext.Ok next-ctx next-env))]
          [(ResultTcEnv.Err message) (ResultLowerCheckedContext.Err message)]))]))

(define (lower-reach-call-callee
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [callee : AstExpr]) : LowerReachState
  (match (ast-expr-unspan-with-pools pools callee)
    [(AstExpr.Var name)
      (lower-reach-add-source-id all-functions names state name)]
    [_ (lower-reach-expr pools all-functions names state callee)]))

(define (lower-reach-expr
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [expr : AstExpr]) : LowerReachState
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.Literal _) state]
    [(AstExpr.Var name)
      (lower-reach-add-source-id all-functions names state name)]
    [(AstExpr.Binary _ lhs-box rhs-box)
      (let
        [lhs : AstExpr (ast-node-pool-context-expr-get pools lhs-box)]
        [rhs : AstExpr (ast-node-pool-context-expr-get pools rhs-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state lhs)
          rhs))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.Call callee-box args)
      (let
        [callee : AstExpr (ast-node-pool-context-expr-get pools callee-box)]
        [callee-state : LowerReachState
          (lower-reach-call-callee pools all-functions names state callee)]
        [concat-state : LowerReachState
          (match (ast-expr-unspan-with-pools pools callee)
            [(AstExpr.Var name)
              (if (or
                (lower-reach-legacy-string-concat-source-id? name)
                (lower-reach-public-string-concat-tree? pools names callee args))
                (lower-reach-add-string-concat-runtime
                  all-functions
                  names
                  callee-state)
                callee-state)]
            [_ callee-state])]
        [runtime-state : LowerReachState
          (match (ast-expr-unspan-with-pools pools callee)
            [(AstExpr.Var name)
              (if (lower-reach-string-snapshot-source-call? name)
                (lower-reach-add-string-snapshot-runtime
                  all-functions
                  names
                  concat-state)
                concat-state)]
            [_ concat-state])]
        (lower-reach-expr-list pools all-functions names runtime-state args))]
    [(AstExpr.If cond-box then-expr-box else-expr-box)
      (let
        [cond : AstExpr (ast-node-pool-context-expr-get pools cond-box)]
        [then-expr : AstExpr
          (ast-node-pool-context-expr-get pools then-expr-box)]
        [else-expr : AstExpr
          (ast-node-pool-context-expr-get pools else-expr-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr
            pools
            all-functions
            names
            (lower-reach-expr pools all-functions names state cond)
            then-expr)
          else-expr))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              names
              (lower-reach-let-bindings
                pools
                all-functions
                names
                state
                bindings)
              body))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (let
            [body : AstExpr (ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              names
              (lower-reach-add-string-snapshot-runtime
                all-functions
                names
                state)
              body))])]
    [(AstExpr.Tuple values)
      (lower-reach-expr-list pools all-functions names state values)]
    [(AstExpr.TupleRef value-box _)
      (let
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(AstExpr.Array values)
      (lower-reach-expr-list pools all-functions names state values)]
    [(AstExpr.DynArray values)
      (lower-reach-expr-list pools all-functions names state values)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-pool-context-expr-get pools len-box)]
        (lower-reach-expr pools all-functions names state len))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-pool-context-expr-get pools array-box)]
        [index : AstExpr (ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state array)
          index))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-pool-context-expr-get pools array-box)]
        [index : AstExpr (ast-node-pool-context-expr-get pools index-box)]
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr
            pools
            all-functions
            names
            (lower-reach-expr pools all-functions names state array)
            index)
          value))]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : AstExpr (ast-node-pool-context-expr-get pools array-box)]
        [live : AstExpr (ast-node-pool-context-expr-get pools live-box)]
        [index : AstExpr (ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr
            pools
            all-functions
            names
            (lower-reach-expr pools all-functions names state array)
            live)
          index))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-pool-context-expr-get pools array-box)]
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state array)
          value))]
    [(AstExpr.StringRef text-box index-box)
      (let
        [text : AstExpr (ast-node-pool-context-expr-get pools text-box)]
        [index : AstExpr (ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state text)
          index))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-pool-context-expr-get pools cond-box)]
        [body : AstExpr (ast-node-pool-context-expr-get pools body-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state cond)
          body))]
    [(AstExpr.Begin exprs)
      (lower-reach-expr-list pools all-functions names state exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-reach-expr-list pools all-functions names state exprs)]
    [(AstExpr.Set _ value-box)
      (let
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.Borrow _ _ inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match value-box arms)
          (let
            [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
            (lower-reach-match-arms
              pools
              all-functions
              names
              (lower-reach-expr pools all-functions names state value)
              arms))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ source-box init-box body-box)
          (let
            [source : AstExpr (ast-node-pool-context-expr-get pools source-box)]
            [init : AstExpr (ast-node-pool-context-expr-get pools init-box)]
            [body : AstExpr (ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              names
              (lower-reach-expr
                pools
                all-functions
                names
                (lower-reach-expr pools all-functions names state source)
                init)
              body))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            _
            _
            _
            source-box
            init-box
            map-expr-box
            reduce-expr-box)
          (let
            [source : AstExpr (ast-node-pool-context-expr-get pools source-box)]
            [init : AstExpr (ast-node-pool-context-expr-get pools init-box)]
            [map-expr : AstExpr
              (ast-node-pool-context-expr-get pools map-expr-box)]
            [reduce-expr : AstExpr
              (ast-node-pool-context-expr-get pools reduce-expr-box)]
            (lower-reach-expr
              pools
              all-functions
              names
              (lower-reach-expr
                pools
                all-functions
                names
                (lower-reach-expr
                  pools
                  all-functions
                  names
                  (lower-reach-expr pools all-functions names state source)
                  init)
                map-expr)
              reduce-expr))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-pool-context-expr-get pools start-box)]
            [end : AstExpr (ast-node-pool-context-expr-get pools end-box)]
            [init : AstExpr (ast-node-pool-context-expr-get pools init-box)]
            [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
            [body : AstExpr (ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              names
              (lower-reach-expr
                pools
                all-functions
                names
                (lower-reach-expr
                  pools
                  all-functions
                  names
                  (lower-reach-expr
                    pools
                    all-functions
                    names
                    (lower-reach-expr pools all-functions names state start)
                    end)
                  init)
                value)
              body))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        [lane : AstExpr (ast-node-pool-context-expr-get pools lane-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state value)
          lane))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        [lane : AstExpr (ast-node-pool-context-expr-get pools lane-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state value)
          lane))]
    [(AstExpr.StructGet value-box _)
      (let
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-pool-context-expr-get pools receiver-box)]
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state receiver)
          value))]
    [(AstExpr.WithRegion _ exprs)
      (lower-reach-expr-list pools all-functions names state exprs)]
    [(AstExpr.WithEscape scratch-box exprs)
      (let
        [scratch : AstExpr (ast-node-pool-context-expr-get pools scratch-box)]
        (lower-reach-expr-list
          pools
          all-functions
          names
          (lower-reach-expr
            pools
            all-functions
            names
            (lower-reach-add-string-snapshot-runtime all-functions names state)
            scratch)
          exprs))]
    [(AstExpr.WithScratch exprs)
      (lower-reach-expr-list
        pools
        all-functions
        names
        (lower-reach-add-string-snapshot-runtime all-functions names state)
        exprs)]
    [(AstExpr.InArena arena-box exprs)
      (let
        [arena : AstExpr (ast-node-pool-context-expr-get pools arena-box)]
        (lower-reach-expr-list
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state arena)
          exprs))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (lower-reach-expr-list
            pools
            all-functions
            names
            (lower-reach-resource-bindings
              pools
              all-functions
              names
              state
              bindings)
            body)])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state inner)
          value))]
    [(AstExpr.TypeLiteral _) state]
    [(AstExpr.Init _) state]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.Quote _) state]
    [(AstExpr.Quasiquote _) state]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.BracketClause items)
      (lower-reach-expr-list pools all-functions names state items)]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.Break) state]
    [(AstExpr.Continue) state]
    [(AstExpr.PtrNull _) state]
    [(AstExpr.PtrNullCheck value-box)
      (let
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(AstExpr.PtrAddrOf place-box)
      (let
        [place : AstExpr (ast-node-pool-context-expr-get pools place-box)]
        (lower-reach-expr pools all-functions names state place))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-pool-context-expr-get pools ptr-box)]
        (lower-reach-expr pools all-functions names state ptr))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-pool-context-expr-get pools ptr-box)]
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state ptr)
          value))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-pool-context-expr-get pools ptr-box)]
        [offset : AstExpr (ast-node-pool-context-expr-get pools offset-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state ptr)
          offset))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-pool-context-expr-get pools ptr-box)]
        (lower-reach-expr pools all-functions names state ptr))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-pool-context-expr-get pools ptr-box)]
        (lower-reach-expr pools all-functions names state ptr))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(AstExpr.StringData inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-pool-context-expr-get pools ptr-box)]
        [len : AstExpr (ast-node-pool-context-expr-get pools len-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state ptr)
          len))]
    [(AstExpr.ArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(AstExpr.BinaryData _) state]
    [(AstExpr.SpmdProgramIndex) state]
    [(AstExpr.SpmdProgramCount) state]
    [(AstExpr.ProgramArgc) state]
    [(AstExpr.ProgramArgv) state]
    [(AstExpr.ProgramEnvp) state]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-pool-context-expr-get pools leaf-box)]
        [subleaf : AstExpr (ast-node-pool-context-expr-get pools subleaf-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state leaf)
          subleaf))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-pool-context-expr-get pools leaf-box)]
        [subleaf : AstExpr (ast-node-pool-context-expr-get pools subleaf-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state leaf)
          subleaf))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-pool-context-expr-get pools leaf-box)]
        [subleaf : AstExpr (ast-node-pool-context-expr-get pools subleaf-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state leaf)
          subleaf))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-pool-context-expr-get pools leaf-box)]
        [subleaf : AstExpr (ast-node-pool-context-expr-get pools subleaf-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state leaf)
          subleaf))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr pools all-functions names state index))]
    [(AstExpr.Syscall args)
      (lower-reach-expr-list pools all-functions names state args)]))

(define (lower-reach-global-decl
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [decl : AstDecl]) : LowerReachState
  (match decl
    [(AstDecl.Def decl-meta _ _ expr-box)
      (let
        [expr : AstExpr (ast-node-pool-context-expr-get pools expr-box)]
        (lower-reach-expr pools all-functions names state expr))]
    [(AstDecl.DefMacro decl-meta _ _ _ _) state]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-reach-global-decl pools all-functions names state inner))]
    [_ state]))

(define (lower-reach-global-decls
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module-id : i64]) : LowerReachState
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) state]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            (& paths)
            0
            entry-path
            decl-path
            module-id)]
        [decl-names : LowerNameCache
          (lower-name-cache-with-module-id names logical-module-id)]
        (match decl
          [(AstDecl.Module next-module)
            (lower-reach-global-decls
              pools
              all-functions
              names
              state
              rest
              rest-paths
              entry-path
              next-module)]
          [(AstDecl.Def decl-meta _ _ expr-box)
            (let
              [expr : AstExpr (ast-node-pool-context-expr-get pools expr-box)]
              (lower-reach-global-decls
                pools
                all-functions
                names
                (lower-reach-expr pools all-functions decl-names state expr)
                rest
                rest-paths
                entry-path
                module-id))]
          [(AstDecl.DefMacro decl-meta _ _ _ _)
            (lower-reach-global-decls
              pools
              all-functions
              names
              state
              rest
              rest-paths
              entry-path
              module-id)]
          [(AstDecl.Unsafe inner-box)
            (let
              [inner : AstDecl (box-get inner-box)]
              (lower-reach-global-decls
                pools
                all-functions
                names
                (lower-reach-global-decl
                  pools
                  all-functions
                  decl-names
                  state
                  inner)
                rest
                rest-paths
                entry-path
                module-id))]
          [_
            (lower-reach-global-decls
              pools
              all-functions
              names
              state
              rest
              rest-paths
              entry-path
              module-id)]))]))

(define (lower-reach-struct-field-cleanup-roots
  [all-functions : lower_i64_i64_map.Map]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState]
  [fields : AstFieldDefList]) : LowerReachState
  (lower-reach-struct-field-cleanup-roots-at
    all-functions
    entry-path
    decl-path
    module
    module-id
    names
    state
    (& fields)
    0))

(define (lower-reach-struct-field-cleanup-roots-at
  [all-functions : lower_i64_i64_map.Map]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState]
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : LowerReachState
  (if (>= index (struct-get fields len))
    state
    (let
      [next : LowerReachState
        (match (ast-field-def-list-get fields index (ast-field-def-fallback))
          [(AstFieldDef.Def _ _ cleanup)
            (match cleanup
              [(AstFieldCleanup.Fn cleanup-name)
                (let
                  [logical-id : i64
                    (if (tc-name-qualified-id? cleanup-name)
                      (lower-name-cache-resolve-logical-id
                        (& names)
                        (macro-hygiene-global-source-name-id-or
                          cleanup-name
                          cleanup-name)
                        -1)
                      (lower-module-name-key-id-by-id module-id cleanup-name))]
                  (lower-reach-add-logical all-functions state logical-id))]
              [_ state])])]
      (lower-reach-struct-field-cleanup-roots-at
        all-functions
        entry-path
        decl-path
        module
        module-id
        names
        next
        fields
        (+ index 1)))))

(define (lower-reach-enum-payload-cleanup-roots
  [all-functions : lower_i64_i64_map.Map]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState]
  [variants : AstVariantDefList]) : LowerReachState
  (lower-reach-enum-payload-cleanup-roots-at
    all-functions
    entry-path
    decl-path
    module
    module-id
    names
    state
    (& variants)
    0
    0))

(define (lower-reach-enum-payload-cleanup-roots-at
  [all-functions : lower_i64_i64_map.Map]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState]
  [variants : (& variants AstVariantDefList)]
  [variant-index : i64]
  [payload-index : i64]) : LowerReachState
  (if (>= variant-index (ast-variant-def-list-len variants))
    state
    (match (ast-variant-def-list-get
      variants
      variant-index
      (ast-variant-def-fallback))
      [(AstVariantDef.Def _ _ cleanups)
        (if (>=
          payload-index
          (ast-variant-payload-cleanup-list-len (& cleanups)))
          (lower-reach-enum-payload-cleanup-roots-at
            all-functions
            entry-path
            decl-path
            module
            module-id
            names
            state
            variants
            (+ variant-index 1)
            0)
          (let
            [next : LowerReachState
              (match (ast-variant-payload-cleanup-list-get
                (& cleanups)
                payload-index
                (ast-variant-payload-cleanup-fallback))
                [(AstVariantPayloadCleanup.Fn cleanup-name)
                  (let
                    [logical-id : i64
                      (if (tc-name-qualified-id? cleanup-name)
                        (lower-name-cache-resolve-logical-id
                          (& names)
                          (macro-hygiene-global-source-name-id-or
                            cleanup-name
                            cleanup-name)
                          -1)
                        (lower-module-name-key-id-by-id module-id cleanup-name))]
                    (lower-reach-add-logical all-functions state logical-id))]
                [_ state])]
            (lower-reach-enum-payload-cleanup-roots-at
              all-functions
              entry-path
              decl-path
              module
              module-id
              names
              next
              variants
              variant-index
              (+ payload-index 1))))])))

(define (lower-reach-cleanup-metadata-roots-in-module
  [all-functions : lower_i64_i64_map.Map]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState]) : LowerReachState
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) state]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            (& paths)
            0
            entry-path
            decl-path
            module-id)]
        [logical-module : String
          (lower-decl-owner-module-name module-id logical-module-id)]
        [next : LowerReachState
          (match decl
            [(AstDecl.DefStruct decl-meta _ _ cleanup fields)
              (if (ast-struct-cleanup? cleanup)
                (lower-reach-struct-field-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  fields)
                state)]
            [(AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup fields)
              (if (ast-struct-cleanup? cleanup)
                (lower-reach-struct-field-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  fields)
                state)]
            [(AstDecl.DefEnum decl-meta _ cleanup variants)
              (if (ast-enum-cleanup? cleanup)
                (lower-reach-enum-payload-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  variants)
                state)]
            [(AstDecl.DefEnumLifetimes decl-meta _ _ cleanup variants)
              (if (ast-enum-cleanup? cleanup)
                (lower-reach-enum-payload-cleanup-roots
                  all-functions
                  entry-path
                  decl-path
                  logical-module
                  logical-module-id
                  names
                  state
                  variants)
                state)]
            [(AstDecl.Module next-module)
              (lower-reach-cleanup-metadata-roots-in-module
                all-functions
                rest
                rest-paths
                entry-path
                (intern-str next-module)
                next-module
                names
                state)]
            [_ state])]
        (match decl
          [(AstDecl.Module _) next]
          [_
            (lower-reach-cleanup-metadata-roots-in-module
              all-functions
              rest
              rest-paths
              entry-path
              module
              module-id
              names
              next)]))]))

(define (lower-function-body-index-empty [count : i64]) : LowerFunctionBodyIndex
  (LowerFunctionBodyIndex
    (lower_i64_i64_map.with-capacity 8192)
    (make-array LowerMaybeFunctionBody count)
    0))

;; Accumulate a module's local decl names onto `base-names` while
;; resolving dispatch logical names against `resolve-names` (the full module
;; env), so a module-local-only env can be built for the per-module body
;; name-cache overlay without changing dispatch results.
;; Iterate only the target module's decls through the shared module-decl
;; position index (same classification: decls before the first Module marker
;; belong to the empty module, marker decls excluded, program order kept)
;; instead of filtering the whole program's decl list per module.
(define (lower-function-body-local-names-in-module-resolve
  [decls : AstDeclList]
  [base-names : LowerNameEnv]
  [resolve-names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [target-module : String]
  [target-module-id : i64]
  [_module-id : i64]) : LowerNameEnv
  (let
    [out : LowerNameEnv base-names]
    [decl-offset : i64 (struct-get decls offset)]
    [_ensure : unit (lower-module-decl-index-ensure! decls)]
    [slot : i64 (lower-module-decl-index-slot target-module-id)]
    (if (< slot 0)
      out
      (let
        [j : i64 (array-ref lower-module-decl-index-starts slot)]
        [end : i64 (array-ref lower-module-decl-index-ends slot)]
        (begin
          (while (< j end)
            (begin
              (set!
                out
                (lower-name-env-add-local-decl-resolve
                  out
                  resolve-names
                  base-cache
                  target-module
                  (array-ref
                    (struct-get decls slots)
                    (+
                      decl-offset
                      (array-ref lower-module-decl-index-positions j)))))
              (set! j (+ j 1))))
          out)))))

;; Build a small per-module overlay name cache holding only the module's
;; import aliases + local decl names; misses fall through to the shared global
;; cache `lower-active-global-name-cache` (set by the prune body-index pass).
;; Was O(modules x global-names): a fresh full cache was rebuilt per module.
(define (lower-function-body-name-cache-for-module
  [decls : AstDeclList]
  [_paths : AstDeclPathList]
  [_entry-path : String]
  [base-names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [module : String]
  [module-id : i64]) : LowerNameCache
  (if (string.eq module "")
    base-cache
    (let
      [module-base-names : LowerNameEnv
        (lower-name-env-with-import-aliases-in-module-cache
          decls
          base-names
          base-cache
          module-id)]
      [alias-only-names : LowerNameEnv
        (lower-name-env-with-import-aliases-in-module-cache
          decls
          (LowerNameEnv.Nil)
          base-cache
          module-id)]
      (lower-name-cache-overlay
        (lower-function-body-local-names-in-module-resolve
          decls
          alias-only-names
          module-base-names
          base-cache
          module
          module-id
          cbi.compiler-builtin-id-fix-empty)
        module-id))))

(define (lower-function-decl-count-one [decl : AstDecl]) : i64
  (match decl
    [(AstDecl.DefFn decl-meta _ _ _ _ _) 1]
    [(AstDecl.Unsafe inner-box)
      (lower-function-decl-count-one (box-get inner-box))]
    [_ 0]))

(define (lower-function-decl-count [decls : AstDeclList]) : i64
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [index : i64 0]
    [out : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (+
              out
              (lower-function-decl-count-one
                (array-ref
                  (struct-get decls slots)
                  (+ (struct-get decls offset) index)))))
          (set! index (+ index 1))))
      out)))

(define (lower-function-body-index-add
  [index : LowerFunctionBodyIndex]
  [logical-id : i64]
  [names : LowerNameCache]
  [body : AstExpr]
  [decl-path-owner-id : i64]) : LowerFunctionBodyIndex
  (let
    [ids : lower_i64_i64_map.Map (struct-get index ids)]
    [bodies : (Array LowerMaybeFunctionBody) (struct-get index bodies)]
    [next : i64 (struct-get index next)]
    (begin
      (array-set!
        bodies
        next
        (LowerMaybeFunctionBody.Some body names decl-path-owner-id))
      (lower_i64_i64_map.insert-ref! (&mut ids) logical-id next)
      (LowerFunctionBodyIndex ids bodies (+ next 1)))))

(define (lower-function-body-index-find
  [index : LowerFunctionBodyIndex]
  [target : i64]) : LowerMaybeFunctionBody
  (match (lower_i64_i64_map.get (& (struct-get index ids)) target)
    [(lower_i64_i64_map.LookupFound body-index)
      (array-ref (struct-get index bodies) body-index)]
    [(lower_i64_i64_map.LookupMissing) (LowerMaybeFunctionBody.No)]))

(define (lower-function-body-index-from-decls-in-module
  [pools : AstNodePoolContext]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [all-decls : AstDeclList]
  [all-paths : AstDeclPathList]
  [base-names : LowerNameEnv]
  [base-name-cache : LowerNameCache]
  [module-name-cache : LowerNameCache]
  [index : LowerFunctionBodyIndex]) : LowerFunctionBodyIndex
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) index]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) entry-path])]
        [logical-module-id : i64
          (lower-decl-owner-module-id
            (& paths)
            0
            entry-path
            decl-path
            module-id)]
        [decl-name-cache : LowerNameCache
          (lower-name-cache-with-module-id module-name-cache logical-module-id)]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest)
              (let
                [path-rest : AstDeclPathList path-rest]
                path-rest)]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        (match (ast-decl-unwrapped decl)
          [(AstDecl.Module next-module)
            (let
              [next-module-str : String (intern-str next-module)]
              (lower-function-body-index-from-decls-in-module
                pools
                rest
                rest-paths
                entry-path
                next-module-str
                next-module
                all-decls
                all-paths
                base-names
                base-name-cache
                (lower-function-body-name-cache-for-module
                  all-decls
                  all-paths
                  entry-path
                  base-names
                  base-name-cache
                  next-module-str
                  next-module)
                index))]
          [(AstDecl.DefFn decl-meta name _ _ body-box _)
            (let
              [body : AstExpr (ast-node-pool-context-expr-get pools body-box)]
              (lower-function-body-index-from-decls-in-module
                pools
                rest
                rest-paths
                entry-path
                module
                module-id
                all-decls
                all-paths
                base-names
                base-name-cache
                module-name-cache
                (lower-function-body-index-add
                  index
                  (lower-decl-logical-id
                    entry-path
                    decl-path
                    (lower-decl-owner-module-name module-id logical-module-id)
                    logical-module-id
                    name
                    (tc-env-key-name-text name))
                  decl-name-cache
                  body
                  (ast-decl-path-list-owner-id (& paths) 0 logical-module-id))))]
          [_
            (lower-function-body-index-from-decls-in-module
              pools
              rest
              rest-paths
              entry-path
              module
              module-id
              all-decls
              all-paths
              base-names
              base-name-cache
              module-name-cache
              index)]))]))

(define (lower-function-body-index-from-decls
  [pools : AstNodePoolContext]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [count : i64]) : LowerFunctionBodyIndex
  (let
    [name-cache : LowerNameCache (lower-name-cache-from-env names)]
    (lower-function-body-index-from-decls-in-module
      pools
      decls
      paths
      entry-path
      ""
      cbi.compiler-builtin-id-fix-empty
      decls
      paths
      names
      name-cache
      name-cache
      (lower-function-body-index-empty count))))

(define (lower-reach-process
  [pools : AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [body-index : LowerFunctionBodyIndex]
  [state : LowerReachState]) : LowerReachState
  (match state
    [(LowerReachState.State reachable worklist)
      (match worklist
        [(LowerIdSet.Nil) state]
        [(LowerIdSet.Cons name rest)
          (let
            [popped : LowerReachState
              (LowerReachState.State reachable (box-get rest))]
            (match (lower-function-body-index-find body-index name)
              [(LowerMaybeFunctionBody.Some body body-names body-path-owner-id)
                (begin
                  (set!
                    lower-reach-active-runtime-paths
                    (let
                      [paths : lower_i64_i64_map.Map
                        lower-reach-active-runtime-paths]
                      (begin
                        (lower_i64_i64_map.insert-ref!
                          (&mut paths)
                          body-path-owner-id
                          1)
                        paths)))
                  (lower-reach-process
                    pools
                    all-functions
                    names
                    body-index
                    (lower-reach-expr
                      pools
                      all-functions
                      body-names
                      popped
                      body)))]
              [(LowerMaybeFunctionBody.No)
                (lower-reach-process
                  pools
                  all-functions
                  names
                  body-index
                  popped)]))])]))

(define (lower-dispatch-variant-logical-name
  [module-id : i64]
  [names : LowerNameCache]
  [variant-name : i64]) : String
  (match (lower-name-cache-resolve-id-display
    names
    (lower-dispatch-variant-source-id module-id variant-name))
    [(TcMaybeString.Some logical-name) logical-name]
    [(TcMaybeString.No) (tc-env-key-name-text variant-name)]))

(define (lower-dispatch-variant-source-id
  [module-id : i64]
  [variant-name : i64]) : i64
  (if (or
    (compiler-symbol-root-module-id? module-id)
    (tc-name-qualified-id? variant-name)
    (>= variant-name (intern-capacity)))
    variant-name
    (compiler-symbol-module-key-id-by-id module-id variant-name)))

(define (lower-dispatch-variant-logical-id
  [module-id : i64]
  [names : LowerNameCache]
  [variant-name : i64]) : i64
  (let
    [source-id : i64 (lower-dispatch-variant-source-id module-id variant-name)]
    (lower-name-cache-resolve-logical-id (& names) source-id source-id)))

(define (lower-dispatch-variant-set-add-list-from
  [variants : (& variants AstDispatchVariantList)]
  [index : i64]
  [module-id : i64]
  [names : LowerNameCache]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (if (>= index (struct-get variants len))
    out
    (match (ast-dispatch-variant-list-get
      variants
      index
      (ast-dispatch-variant-fallback))
      [(AstDispatchVariant.Variant _ variant-name)
        (lower-dispatch-variant-set-add-list-from
          variants
          (+ index 1)
          module-id
          names
          (let
            [next-out : lower_i64_i64_map.Map out]
            (begin
              (lower_i64_i64_map.insert-ref!
                (&mut next-out)
                (lower-dispatch-variant-logical-id module-id names variant-name)
                1)
              next-out)))])))

(define (lower-dispatch-variant-set-add-list
  [variants : AstDispatchVariantList]
  [module-id : i64]
  [names : LowerNameCache]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (lower-dispatch-variant-set-add-list-from (& variants) 0 module-id names out))

(define (lower-dispatch-variant-set-add-decl
  [decl : AstDecl]
  [module-id : i64]
  [names : LowerNameCache]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (match decl
    [(AstDecl.DefDispatch decl-meta _ variants)
      (lower-dispatch-variant-set-add-list variants module-id names out)]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-dispatch-variant-set-add-decl inner module-id names out))]
    [_ out]))

(define (lower-dispatch-variant-set-from-decls-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameCache]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [cur-out : lower_i64_i64_map.Map out]
    (begin
      (while (< index count)
        (let
          [decl : AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          [decl-path : String
            (ast-decl-path-list-get (& paths) index entry-path)]
          [logical-module-id : i64
            (lower-decl-owner-module-id
              (& paths)
              index
              entry-path
              decl-path
              cur-module-id)]
          (begin
            (match decl
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [_
                (set!
                  cur-out
                  (lower-dispatch-variant-set-add-decl
                    decl
                    logical-module-id
                    names
                    cur-out))])
            (set! index (+ index 1)))))
      cur-out)))

(define (lower-dispatch-variant-set-from-decls
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [names : LowerNameCache]) : lower_i64_i64_map.Map
  (lower-dispatch-variant-set-from-decls-in-module
    decls
    paths
    entry-path
    names
    (lower_i64_i64_map.with-capacity 1024)))

(define (lower-reach-add-dispatch-variant-list-from
  [all-functions : lower_i64_i64_map.Map]
  [module-id : i64]
  [names : LowerNameCache]
  [variants : (& variants AstDispatchVariantList)]
  [index : i64]
  [state : LowerReachState]) : LowerReachState
  (if (>= index (struct-get variants len))
    state
    (match (ast-dispatch-variant-list-get
      variants
      index
      (ast-dispatch-variant-fallback))
      [(AstDispatchVariant.Variant _ variant-name)
        (lower-reach-add-dispatch-variant-list-from
          all-functions
          module-id
          names
          variants
          (+ index 1)
          (lower-reach-add-logical
            all-functions
            state
            (lower-dispatch-variant-logical-id module-id names variant-name)))])))

(define (lower-reach-add-dispatch-variant-list
  [all-functions : lower_i64_i64_map.Map]
  [module-id : i64]
  [names : LowerNameCache]
  [variants : AstDispatchVariantList]
  [state : LowerReachState]) : LowerReachState
  (lower-reach-add-dispatch-variant-list-from
    all-functions
    module-id
    names
    (& variants)
    0
    state))

(define (lower-reach-add-dispatch-variant-decl
  [all-functions : lower_i64_i64_map.Map]
  [module-id : i64]
  [names : LowerNameCache]
  [decl : AstDecl]
  [state : LowerReachState]) : LowerReachState
  (match decl
    [(AstDecl.DefDispatch decl-meta _ variants)
      (lower-reach-add-dispatch-variant-list
        all-functions
        module-id
        names
        variants
        state)]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-reach-add-dispatch-variant-decl
          all-functions
          module-id
          names
          inner
          state))]
    [_ state]))

(define (lower-reach-add-dispatch-variant-roots-in-module
  [all-functions : lower_i64_i64_map.Map]
  [decls : AstDeclList]
  [module-id : i64]
  [names : LowerNameCache]
  [state : LowerReachState]) : LowerReachState
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) state]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module next-module)
            (lower-reach-add-dispatch-variant-roots-in-module
              all-functions
              rest
              next-module
              names
              state)]
          [_
            (lower-reach-add-dispatch-variant-roots-in-module
              all-functions
              rest
              module-id
              names
              (lower-reach-add-dispatch-variant-decl
                all-functions
                module-id
                names
                decl
                state))]))]))

(define (lower-reach-add-dispatch-variant-roots
  [all-functions : lower_i64_i64_map.Map]
  [decls : AstDeclList]
  [names : LowerNameCache]
  [state : LowerReachState]) : LowerReachState
  (lower-reach-add-dispatch-variant-roots-in-module
    all-functions
    decls
    cbi.compiler-builtin-id-fix-empty
    names
    state))

;; `reachable` is keyed by dense `all-functions` slot; resolve a logical ID's
;; slot through the same map the reach walk used and test membership by i64.
(define (lower-reach-slot-set-contains-id?
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [logical-id : i64]) : bool
  (match (lower_i64_i64_map.get (& all-functions) logical-id)
    [(lower_i64_i64_map.LookupMissing) false]
    [(lower_i64_i64_map.LookupFound slot)
      (lower_i64_i64_map.contains? (& reachable) slot)]))

(define (lower-function-kept-by-reach-or-dispatch?
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [logical-id : i64]) : bool
  (or
    (lower-reach-slot-set-contains-id? all-functions reachable logical-id)
    (lower_i64_i64_map.contains? (& dispatch-variants) logical-id)))

(define (lower-used-type-name-leaf-id [name : i64]) : i64
  (let
    [source-id : i64 (macro-hygiene-global-source-name-id-or name name)]
    [base-id : i64
      (if (tc-name-qualified-id? source-id)
        (tc-qualified-name-base-id source-id)
        source-id)]
    (if (and
      (>= base-id 0)
      (< base-id (intern-capacity))
      (intern-dotted? base-id))
      (intern-dotted-final-id base-id)
      base-id)))

(define (lower-used-type-name-add
  [used : lower_i64_i64_map.Map]
  [_module : String]
  [name : i64]) : lower_i64_i64_map.Map
  (let
    [with-source : lower_i64_i64_map.Map used]
    (begin
      (lower_i64_i64_map.insert-ref! (&mut with-source) name 1)
      (if (or (tc-name-qualified-id? name) (>= (tc-name-first-dot-id name) 0))
        (let
          [leaf : i64 (lower-used-type-name-leaf-id name)]
          (begin
            (if (< leaf 0)
              unit
              (lower_i64_i64_map.insert-ref! (&mut with-source) leaf 1))
            with-source))
        with-source))))

(define (lower-used-type-name-contains?
  [used : lower_i64_i64_map.Map]
  [_module : String]
  [name : i64]) : bool
  (if (lower_i64_i64_map.contains? (& used) name)
    true
    (if (or (tc-name-qualified-id? name) (>= (tc-name-first-dot-id name) 0))
      (let
        [leaf : i64 (lower-used-type-name-leaf-id name)]
        (and (>= leaf 0) (lower_i64_i64_map.contains? (& used) leaf)))
      false)))

(define (lower-used-types-precise-empty) : lower_i64_i64_map.Map
  (let
    [used : lower_i64_i64_map.Map (lower_i64_i64_map.with-capacity 8192)]
    (begin
      (lower_i64_i64_map.insert-ref!
        (&mut used)
        cbi.compiler-builtin-id-fix-dollar_lower_dot_precise_type_dce
        1)
      used)))

(define (lower-used-types-add-type-id
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [ty-id : i64]) : lower_i64_i64_map.Map
  (lower-used-types-add-type
    pools
    used
    module
    (ast-node-pool-context-type-get pools ty-id)))

(define (lower-used-types-add-type-list
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [types : AstTypeList]) : lower_i64_i64_map.Map
  (lower-used-types-add-type-list-at pools used module (& types) 0))

(define (lower-used-types-add-type-list-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [types : (& types AstTypeList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast-type-list-len types))
    used
    (lower-used-types-add-type-list-at
      pools
      (lower-used-types-add-type-id
        pools
        used
        module
        (ast-type-list-get types index (ast-type-id-fallback)))
      module
      types
      (+ index 1))))

(define (lower-used-types-add-type
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [ty : AstType]) : lower_i64_i64_map.Map
  (match ty
    [(AstType.Func args ret)
      (lower-used-types-add-type-id
        pools
        (lower-used-types-add-type-list pools used module (box-get args))
        module
        ret)]
    [(AstType.Tuple elems)
      (lower-used-types-add-type-list pools used module (box-get elems))]
    [(AstType.Array elem _)
      (lower-used-types-add-type-id pools used module elem)]
    [(AstType.DynArray elem)
      (lower-used-types-add-type-id pools used module elem)]
    [(AstType.Box elem) (lower-used-types-add-type-id pools used module elem)]
    [(AstType.Region _ inner)
      (lower-used-types-add-type-id pools used module inner)]
    [(AstType.Ref _ inner)
      (lower-used-types-add-type-id pools used module inner)]
    [(AstType.MutRef _ inner)
      (lower-used-types-add-type-id pools used module inner)]
    [(AstType.Enum name) (lower-used-type-name-add used module name)]
    [(AstType.EnumArgs name _) (lower-used-type-name-add used module name)]
    [(AstType.Struct name) (lower-used-type-name-add used module name)]
    [(AstType.StructArgs name _) (lower-used-type-name-add used module name)]
    [(AstType.Var name) (lower-used-type-name-add used module name)]
    [(AstType.VarArgs name _) (lower-used-type-name-add used module name)]
    [(AstType.Ptr inner) (lower-used-types-add-type-id pools used module inner)]
    [(AstType.MutPtr inner)
      (lower-used-types-add-type-id pools used module inner)]
    [_ used]))

(define (lower-used-types-add-maybe-type
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [maybe-ty : AstMaybeType]) : lower_i64_i64_map.Map
  (match maybe-ty
    [(AstMaybeType.No) used]
    [(AstMaybeType.Some ty) (lower-used-types-add-type pools used module ty)]))

(define (lower-used-types-add-param-list
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [params : AstParamList]) : lower_i64_i64_map.Map
  (lower-used-types-add-param-list-at pools used module (& params) 0))

(define (lower-used-types-add-param-list-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [params : (& params AstParamList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast-param-list-len params))
    used
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _ _)
        (lower-used-types-add-param-list-at
          pools
          (lower-used-types-add-type pools used module ty)
          module
          params
          (+ index 1))])))

(define (lower-used-types-add-macro-param-list
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [params : AstMacroParamList]) : lower_i64_i64_map.Map
  (lower-used-types-add-macro-param-list-at pools used module (& params) 0))

(define (lower-used-types-add-macro-param-list-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [params : (& params AstMacroParamList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast-macro-param-list-len params))
    used
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty _ _)
        (lower-used-types-add-macro-param-list-at
          pools
          (lower-used-types-add-type pools used module ty)
          module
          params
          (+ index 1))])))

(define (lower-used-types-add-expr-id
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [expr-id : i64]) : lower_i64_i64_map.Map
  (lower-used-types-add-expr
    pools
    used
    module
    (ast-node-pool-context-expr-get pools expr-id)))

(define (lower-used-types-add-expr-list
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [exprs : AstExprList]) : lower_i64_i64_map.Map
  (lower-used-types-add-expr-list-at pools used module (& exprs) 0))

(define (lower-used-types-add-expr-list-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get exprs len))
    used
    (lower-used-types-add-expr-list-at
      pools
      (lower-used-types-add-expr-id
        pools
        used
        module
        (ast-expr-list-get exprs index 0))
      module
      exprs
      (+ index 1))))

(define (lower-used-types-add-pattern
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [pattern : AstPattern]) : lower_i64_i64_map.Map
  (match pattern
    [(AstPattern.Var _ maybe-ty)
      (lower-used-types-add-maybe-type pools used module maybe-ty)]
    [(AstPattern.Tuple patterns-box)
      (lower-used-types-add-pattern-list
        pools
        used
        module
        (box-get patterns-box))]
    [(AstPattern.Wildcard) used]
    [(AstPattern.Binding _) used]
    [(AstPattern.Variant name patterns-box)
      (let
        ;; `name` is already the interned id; read the id-keyed metadata slots
        ;; directly instead of re-hashing `(tc-env-key-name-text name)` twice.
        [with-head : lower_i64_i64_map.Map
          (if (or
            (tc-name-qualified-id? name)
            (>= (tc-name-first-dot-id name) 0))
            (lower-used-type-name-add used module name)
            used)]
        (lower-used-types-add-pattern-list
          pools
          with-head
          module
          (box-get patterns-box)))]
    [(AstPattern.Literal _) used]))

(define (lower-used-types-add-pattern-list
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [patterns : AstPatternList]) : lower_i64_i64_map.Map
  (lower-used-types-add-pattern-list-at pools used module (& patterns) 0))

(define (lower-used-types-add-pattern-list-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [patterns : (& patterns AstPatternList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get patterns len))
    used
    (lower-used-types-add-pattern-list-at
      pools
      (lower-used-types-add-pattern
        pools
        used
        module
        (ast-pattern-list-get patterns index (ast-pattern-fallback)))
      module
      patterns
      (+ index 1))))

(define (lower-used-types-add-let-bindings
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [bindings : AstLetBindingList]) : lower_i64_i64_map.Map
  (lower-used-types-add-let-bindings-at pools used module (& bindings) 0))

(define (lower-used-types-add-let-bindings-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast-let-binding-list-len bindings))
    used
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ maybe-ty value-box)
        (lower-used-types-add-let-bindings-at
          pools
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-maybe-type pools used module maybe-ty)
            module
            value-box)
          module
          bindings
          (+ index 1))])))

(define (lower-used-types-add-match-arms
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [arms : AstMatchArmList]) : lower_i64_i64_map.Map
  (lower-used-types-add-match-arms-at pools used module (& arms) 0))

(define (lower-used-types-add-match-arms-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get arms len))
    used
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (lower-used-types-add-match-arms-at
          pools
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-pattern pools used module pattern)
            module
            body-box)
          module
          arms
          (+ index 1))])))

(define (lower-used-types-add-resource-bindings
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [bindings : AstResourceBindingList]) : lower_i64_i64_map.Map
  (lower-used-types-add-resource-bindings-at pools used module (& bindings) 0))

(define (lower-used-types-add-resource-bindings-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (ast-resource-binding-list-len bindings))
    used
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ acquire-box cleanup-box _)
        (lower-used-types-add-resource-bindings-at
          pools
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-expr-id pools used module acquire-box)
            module
            cleanup-box)
          module
          bindings
          (+ index 1))])))

(define (lower-used-types-add-expr
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [expr : AstExpr]) : lower_i64_i64_map.Map
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.Literal _) used]
    [(AstExpr.Var _) used]
    [(AstExpr.Binary _ lhs-box rhs-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module lhs-box)
        module
        rhs-box)]
    [(AstExpr.Unary _ inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.Call callee-box args)
      (lower-used-types-add-expr-list
        pools
        (lower-used-types-add-expr-id pools used module callee-box)
        module
        args)]
    [(AstExpr.If cond-box then-box else-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id
          pools
          (lower-used-types-add-expr-id pools used module cond-box)
          module
          then-box)
        module
        else-box)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-let-bindings pools used module bindings)
            module
            body-box)])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params ret body-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-maybe-type
              pools
              (lower-used-types-add-param-list pools used module params)
              module
              ret)
            module
            body-box)])]
    [(AstExpr.Tuple values)
      (lower-used-types-add-expr-list pools used module values)]
    [(AstExpr.TupleRef value-box _)
      (lower-used-types-add-expr-id pools used module value-box)]
    [(AstExpr.Array values)
      (lower-used-types-add-expr-list pools used module values)]
    [(AstExpr.DynArray values)
      (lower-used-types-add-expr-list pools used module values)]
    [(AstExpr.MakeArray ty len-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type pools used module ty)
        module
        len-box)]
    [(AstExpr.ArrayRef array-box index-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module array-box)
        module
        index-box)]
    [(AstExpr.ArraySet array-box index-box value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id
          pools
          (lower-used-types-add-expr-id pools used module array-box)
          module
          index-box)
        module
        value-box)]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id
          pools
          (lower-used-types-add-expr-id pools used module array-box)
          module
          live-box)
        module
        index-box)]
    [(AstExpr.ArrayPush array-box value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module array-box)
        module
        value-box)]
    [(AstExpr.StringRef text-box index-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module text-box)
        module
        index-box)]
    [(AstExpr.While cond-box body-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module cond-box)
        module
        body-box)]
    [(AstExpr.Begin exprs)
      (lower-used-types-add-expr-list pools used module exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-used-types-add-expr-list pools used module exprs)]
    [(AstExpr.Set _ value-box)
      (lower-used-types-add-expr-id pools used module value-box)]
    [(AstExpr.Ann inner-box ty)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type pools used module ty)
        module
        inner-box)]
    [(AstExpr.Cast inner-box ty)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type pools used module ty)
        module
        inner-box)]
    [(AstExpr.Borrow _ _ inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match value-box arms)
          (lower-used-types-add-match-arms
            pools
            (lower-used-types-add-expr-id pools used module value-box)
            module
            arms)])]
    [(AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(AstForeach.Foreach _ index-ty start-box end-box body-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-expr-id
              pools
              (lower-used-types-add-expr-id
                pools
                (lower-used-types-add-type pools used module index-ty)
                module
                start-box)
              module
              end-box)
            module
            body-box)])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            _
            _
            index-ty
            source-box
            init-box
            map-expr-box
            reduce-expr-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-expr-id
              pools
              (lower-used-types-add-expr-id
                pools
                (lower-used-types-add-expr-id
                  pools
                  (lower-used-types-add-type pools used module index-ty)
                  module
                  source-box)
                module
                init-box)
              module
              map-expr-box)
            module
            reduce-expr-box)])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            index-ty
            start-box
            end-box
            _
            prefix-ty
            init-box
            value-box
            body-box)
          (lower-used-types-add-expr-id
            pools
            (lower-used-types-add-expr-id
              pools
              (lower-used-types-add-expr-id
                pools
                (lower-used-types-add-expr-id
                  pools
                  (lower-used-types-add-expr-id
                    pools
                    (lower-used-types-add-type
                      pools
                      (lower-used-types-add-type pools used module index-ty)
                      module
                      prefix-ty)
                    module
                    start-box)
                  module
                  end-box)
                module
                init-box)
              module
              value-box)
            module
            body-box)])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module value-box)
        module
        lane-box)]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module value-box)
        module
        lane-box)]
    [(AstExpr.StructGet value-box _)
      (lower-used-types-add-expr-id pools used module value-box)]
    [(AstExpr.StructSet receiver-box _ value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module receiver-box)
        module
        value-box)]
    [(AstExpr.WithRegion _ exprs)
      (lower-used-types-add-expr-list pools used module exprs)]
    [(AstExpr.WithEscape scratch-box exprs)
      (lower-used-types-add-expr-list
        pools
        (lower-used-types-add-expr-id pools used module scratch-box)
        module
        exprs)]
    [(AstExpr.WithScratch exprs)
      (lower-used-types-add-expr-list pools used module exprs)]
    [(AstExpr.InArena arena-box exprs)
      (lower-used-types-add-expr-list
        pools
        (lower-used-types-add-expr-id pools used module arena-box)
        module
        exprs)]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (lower-used-types-add-expr-list
            pools
            (lower-used-types-add-resource-bindings pools used module bindings)
            module
            body)])]
    [(AstExpr.Box inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.BoxGet inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.BoxTake inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.BoxSet inner-box value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module inner-box)
        module
        value-box)]
    [(AstExpr.TypeLiteral ty) (lower-used-types-add-type pools used module ty)]
    [(AstExpr.Init maybe-ty)
      (lower-used-types-add-maybe-type pools used module maybe-ty)]
    [(AstExpr.Comptime inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.Quote _) used]
    [(AstExpr.Quasiquote _) used]
    [(AstExpr.Unquote inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.UnquoteSplicing inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.BracketClause items)
      (lower-used-types-add-expr-list pools used module items)]
    [(AstExpr.Try inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.Return inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.Break) used]
    [(AstExpr.Continue) used]
    [(AstExpr.PtrNull ty) (lower-used-types-add-type pools used module ty)]
    [(AstExpr.PtrNullCheck value-box)
      (lower-used-types-add-expr-id pools used module value-box)]
    [(AstExpr.PtrAddrOf place-box)
      (lower-used-types-add-expr-id pools used module place-box)]
    [(AstExpr.PtrRead ptr-box)
      (lower-used-types-add-expr-id pools used module ptr-box)]
    [(AstExpr.PtrWrite ptr-box value-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module ptr-box)
        module
        value-box)]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module ptr-box)
        module
        offset-box)]
    [(AstExpr.PtrCast ptr-box ty)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type pools used module ty)
        module
        ptr-box)]
    [(AstExpr.PtrToInt ptr-box)
      (lower-used-types-add-expr-id pools used module ptr-box)]
    [(AstExpr.IntToPtr value-box ty)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-type pools used module ty)
        module
        value-box)]
    [(AstExpr.StringData inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module ptr-box)
        module
        len-box)]
    [(AstExpr.ArrayData inner-box)
      (lower-used-types-add-expr-id pools used module inner-box)]
    [(AstExpr.BinaryData _) used]
    [(AstExpr.SpmdProgramIndex) used]
    [(AstExpr.SpmdProgramCount) used]
    [(AstExpr.ProgramArgc) used]
    [(AstExpr.ProgramArgv) used]
    [(AstExpr.ProgramEnvp) used]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module leaf-box)
        module
        subleaf-box)]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module leaf-box)
        module
        subleaf-box)]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module leaf-box)
        module
        subleaf-box)]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (lower-used-types-add-expr-id
        pools
        (lower-used-types-add-expr-id pools used module leaf-box)
        module
        subleaf-box)]
    [(AstExpr.Xgetbv index-box)
      (lower-used-types-add-expr-id pools used module index-box)]
    [(AstExpr.Syscall args)
      (lower-used-types-add-expr-list pools used module args)]))

(define (lower-used-types-add-field-list
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [fields : AstFieldDefList]) : lower_i64_i64_map.Map
  (lower-used-types-add-field-list-at pools used module (& fields) 0))

(define (lower-used-types-add-field-list-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get fields len))
    used
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def _ ty _)
        (lower-used-types-add-field-list-at
          pools
          (lower-used-types-add-type pools used module ty)
          module
          fields
          (+ index 1))])))

(define (lower-used-types-add-variant-list
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [variants : AstVariantDefList]) : lower_i64_i64_map.Map
  (lower-used-types-add-variant-list-at pools used module (& variants) 0))

(define (lower-used-types-add-variant-list-at
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get variants len))
    used
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def _ fields _)
        (lower-used-types-add-variant-list-at
          pools
          (lower-used-types-add-type-list pools used module fields)
          module
          variants
          (+ index 1))])))

(define (lower-type-decl? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefEnum decl-meta _ _ _) true]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ _ _) true]
    [(AstDecl.DefStruct decl-meta _ _ _ _) true]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ _ _) true]
    [(AstDecl.Unsafe inner-box) (lower-type-decl? (box-get inner-box))]
    [_ false]))

(define (lower-type-decl-used?
  [module : String]
  [used-types : lower_i64_i64_map.Map]
  [decl : AstDecl]) : bool
  ;; Empty is the fast-path marker for "all type declaration paths are already
  ;; reachable"; precise DCE starts from lower-used-types-precise-empty instead.
  (if (= (lower_i64_i64_map.len (& used-types)) 0)
    true
    (match decl
      [(AstDecl.DefEnum decl-meta name _ variants)
        (lower-used-type-name-contains? used-types module name)]
      [(AstDecl.DefEnumLifetimes decl-meta name _ _ variants)
        (lower-used-type-name-contains? used-types module name)]
      [(AstDecl.DefStruct decl-meta name _ _ _)
        (lower-used-type-name-contains? used-types module name)]
      [(AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
        (lower-used-type-name-contains? used-types module name)]
      [(AstDecl.Unsafe inner-box)
        (lower-type-decl-used? module used-types (box-get inner-box))]
      [_ true])))

(define (lower-used-types-add-kept-runtime-decl
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [decl : AstDecl]) : lower_i64_i64_map.Map
  (match decl
    [(AstDecl.Def decl-meta _ maybe-ty _)
      (lower-used-types-add-maybe-type pools used module maybe-ty)]
    [(AstDecl.DefFn decl-meta _ params ret _ _)
      (lower-used-types-add-type
        pools
        (lower-used-types-add-param-list pools used module params)
        module
        ret)]
    [(AstDecl.DefMacro decl-meta _ params ret _)
      (lower-used-types-add-type
        pools
        (lower-used-types-add-macro-param-list pools used module params)
        module
        ret)]
    [(AstDecl.Extern decl-meta _ _ _ ty)
      (lower-used-types-add-type pools used module ty)]
    [(AstDecl.DefEnum decl-meta _ _ _) used]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ _ _) used]
    [(AstDecl.DefStruct decl-meta _ _ _ _) used]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ _ _) used]
    [(AstDecl.Test _ body-box _)
      (lower-used-types-add-expr-id pools used module body-box)]
    [(AstDecl.Unsafe inner-box)
      (lower-used-types-add-kept-runtime-decl
        pools
        used
        module
        (box-get inner-box))]
    [_ used]))

;; A synthesized clone$<T> helper (`stdlib/clone.tl`). Clone helpers are
;; generated as the exact transitive closure the reachable clone roots need and
;; reference one another through `(clone x)` forms the AST reachability walk does
;; not resolve to names, so a reachable helper's callees would otherwise be
;; dropped (undefined-symbol link error). Keep every synthesized helper.
(define (lower-decl-is-clone-helper-inner? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefFn decl-meta name _ _ _ _)
      (lower-name-has-clone-prefix? (tc-env-key-name-text name))]
    [(AstDecl.Unsafe inner-box)
      (lower-decl-is-clone-helper? (box-get inner-box))]
    [_ false]))

(define (lower-decl-is-clone-helper? [decl : AstDecl]) : bool
  (match (ast-decl-generated-meta decl)
    [(AstGeneratedDeclMeta.Some generator _ _ _)
      (if (string.eq generator "stdlib.clone/synthesize-helpers")
        true
        (lower-decl-is-clone-helper-inner? decl))]
    [(AstGeneratedDeclMeta.No) (lower-decl-is-clone-helper-inner? decl)]))

(define (lower-runtime-decl-kept-by-reach-or-dispatch?
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [decl : AstDecl]) : bool
  (if (lower-decl-is-clone-helper? decl)
    ;; The clone handoff emits exactly the clone$<T> closure reachable code
    ;; needs, so keep it all.
    true
    (match (lower-function-logical-id-from-decl
      entry-path
      decl-path
      module
      module-id
      decl)
      [(LowerNameCacheMaybeId.Some logical-id)
        (lower-function-kept-by-reach-or-dispatch?
          all-functions
          reachable
          dispatch-variants
          logical-id)]
      [(LowerNameCacheMaybeId.No) true])))

(define (lower-used-types-add-type-decl-name
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [decl : AstDecl]) : lower_i64_i64_map.Map
  (match decl
    [(AstDecl.DefEnum decl-meta name _ _)
      (lower-used-type-name-add used module name)]
    [(AstDecl.DefEnumLifetimes decl-meta name _ _ _)
      (lower-used-type-name-add used module name)]
    [(AstDecl.DefStruct decl-meta name _ _ _)
      (lower-used-type-name-add used module name)]
    [(AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
      (lower-used-type-name-add used module name)]
    [(AstDecl.Unsafe inner-box)
      (lower-used-types-add-type-decl-name
        pools
        used
        module
        (box-get inner-box))]
    [_ used]))

(define (lower-used-types-path-seed-in-module
  [pools : AstNodePoolContext]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [reachable-paths : lower_i64_i64_map.Map]
  [used : lower_i64_i64_map.Map]
  [covered : bool]) : LowerUsedTypePathSeed
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (LowerUsedTypePathSeed.Seed used covered)]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        [path-owner-id : i64
          (ast-decl-path-list-owner-id
            (& paths)
            0
            (compiler-symbol-root-module-id))]
        (match decl
          [(AstDecl.Module next-module)
            (lower-used-types-path-seed-in-module
              pools
              rest
              rest-paths
              entry-path
              (intern-str next-module)
              reachable-paths
              used
              covered)]
          [_
            (let
              [is-type-decl : bool (lower-type-decl? decl)]
              [path-covered : bool
                (lower_i64_i64_map.contains? (& reachable-paths) path-owner-id)]
              (lower-used-types-path-seed-in-module
                pools
                rest
                rest-paths
                entry-path
                module
                reachable-paths
                (if (and is-type-decl path-covered)
                  (lower-used-types-add-type-decl-name pools used module decl)
                  used)
                (and covered (or (not is-type-decl) path-covered))))]))]))

(define (lower-used-types-from-kept-decls-in-module
  [pools : AstNodePoolContext]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [used : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) used]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        (match decl
          [(AstDecl.Module next-module)
            (lower-used-types-from-kept-decls-in-module
              pools
              rest
              rest-paths
              entry-path
              (intern-str next-module)
              next-module
              all-functions
              reachable
              dispatch-variants
              used)]
          [_
            (lower-used-types-from-kept-decls-in-module
              pools
              rest
              rest-paths
              entry-path
              module
              module-id
              all-functions
              reachable
              dispatch-variants
              (if (lower-runtime-decl-kept-by-reach-or-dispatch?
                entry-path
                decl-path
                module
                module-id
                all-functions
                reachable
                dispatch-variants
                decl)
                (lower-used-types-add-kept-runtime-decl pools used module decl)
                used))]))]))

(define (lower-used-types-add-stdlib-arena-support-deps
  [_pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [name : i64]) : lower_i64_i64_map.Map
  ;; `in-arena` and allocation lowering use the arena mark support type even
  ;; when source signatures only mention the public Arena wrapper.
  (if (and
    (string.eq module "stdlib.arena")
    (string.eq (tc-env-key-name-text name) "Arena"))
    (lower-used-type-name-add used module cbi.compiler-builtin-id-fix-ArenaMark)
    used))

(define (lower-used-types-add-type-decl-deps
  [pools : AstNodePoolContext]
  [used : lower_i64_i64_map.Map]
  [module : String]
  [decl : AstDecl]) : lower_i64_i64_map.Map
  (match decl
    [(AstDecl.DefEnum decl-meta _ _ variants)
      (lower-used-types-add-variant-list pools used module variants)]
    [(AstDecl.DefEnumLifetimes decl-meta _ _ _ variants)
      (lower-used-types-add-variant-list pools used module variants)]
    [(AstDecl.DefStruct decl-meta name _ _ fields)
      (lower-used-types-add-field-list
        pools
        (lower-used-types-add-stdlib-arena-support-deps pools used module name)
        module
        fields)]
    [(AstDecl.DefStructLifetimes decl-meta _ _ _ _ fields)
      (lower-used-types-add-field-list pools used module fields)]
    [(AstDecl.Unsafe inner-box)
      (lower-used-types-add-type-decl-deps
        pools
        used
        module
        (box-get inner-box))]
    [_ used]))

(define (lower-used-types-add-type-decl-deps-in-module
  [pools : AstNodePoolContext]
  [decls : AstDeclList]
  [module : String]
  [used : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) used]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module next-module)
            (lower-used-types-add-type-decl-deps-in-module
              pools
              rest
              (intern-str next-module)
              used)]
          [_
            (lower-used-types-add-type-decl-deps-in-module
              pools
              rest
              module
              (if (and
                (lower-type-decl? decl)
                (or
                  (lower-comptime-runtime-skip-module? module)
                  (lower-type-decl-used? module used decl)))
                (lower-used-types-add-type-decl-deps pools used module decl)
                used))]))]))

(define (lower-used-types-expand-fixed
  [pools : AstNodePoolContext]
  [decls : AstDeclList]
  [used : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (let
    [current : lower_i64_i64_map.Map used]
    [iterations : i64 0]
    [done : bool false]
    (begin
      (while (not done)
        (let
          [before : i64 (lower_i64_i64_map.len (& current))]
          [next : lower_i64_i64_map.Map
            (lower-used-types-add-type-decl-deps-in-module
              pools
              decls
              ""
              current)]
          (begin
            (set! current next)
            (set! iterations (+ iterations 1))
            (if (or
              (= before (lower_i64_i64_map.len (& current)))
              (>= iterations 8))
              (set! done true)
              unit))))
      current)))

(define (lower-comptime-runtime-skip-module? [module : String]) : bool
  (string.eq module "stdlib.comptime"))

(define (lower-no-main-entry-prune-set! [active : bool]) : unit
  (set! lower-no-main-entry-prune-active active))

(define lower-comptime-error-id-generation : i64
  -1)
(define lower-comptime-error-id : i64
  0)
(define lower-comptime-error-comptime-dot-id : i64
  0)
(define lower-comptime-error-comptime-slash-id : i64
  0)
(define lower-comptime-error-comptime-error-dot-id : i64
  0)
(define lower-comptime-error-comptime-error-slash-id : i64
  0)
(define lower-comptime-error-stdlib-dot-dot-id : i64
  0)
(define lower-comptime-error-stdlib-dot-slash-id : i64
  0)
(define lower-comptime-error-stdlib-slash-dot-id : i64
  0)
(define lower-comptime-error-stdlib-slash-slash-id : i64
  0)
(define lower-comptime-error-stdlib-error-dot-dot-id : i64
  0)
(define lower-comptime-error-stdlib-error-dot-slash-id : i64
  0)
(define lower-comptime-error-stdlib-error-slash-dot-id : i64
  0)
(define lower-comptime-error-stdlib-error-slash-slash-id : i64
  0)

(define (lower-comptime-error-ids-ensure!) : unit
  (if (= lower-comptime-error-id-generation (intern-generation))
    unit
    (begin
      (set! lower-comptime-error-id cbi.compiler-builtin-id-fix-comptime_error)
      (set!
        lower-comptime-error-comptime-dot-id
        cbi.compiler-builtin-id-fix-comptime_dot_comptime_error)
      (set!
        lower-comptime-error-comptime-slash-id
        cbi.compiler-builtin-id-fix-comptime_dot_comptime_error)
      (set!
        lower-comptime-error-comptime-error-dot-id
        cbi.compiler-builtin-id-fix-comptime_dot_error)
      (set!
        lower-comptime-error-comptime-error-slash-id
        cbi.compiler-builtin-id-fix-comptime_dot_error)
      (set!
        lower-comptime-error-stdlib-dot-dot-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_comptime_error)
      (set!
        lower-comptime-error-stdlib-dot-slash-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_comptime_error)
      (set!
        lower-comptime-error-stdlib-slash-dot-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_comptime_error)
      (set!
        lower-comptime-error-stdlib-slash-slash-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_comptime_error)
      (set!
        lower-comptime-error-stdlib-error-dot-dot-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_error)
      (set!
        lower-comptime-error-stdlib-error-dot-slash-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_error)
      (set!
        lower-comptime-error-stdlib-error-slash-dot-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_error)
      (set!
        lower-comptime-error-stdlib-error-slash-slash-id
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime_dot_error)
      (set! lower-comptime-error-id-generation (intern-generation)))))

(define (lower-comptime-error-call-id-with-cache? [id : i64]) : bool
  (or
    (= id lower-comptime-error-id)
    (= id lower-comptime-error-comptime-dot-id)
    (= id lower-comptime-error-comptime-slash-id)
    (= id lower-comptime-error-comptime-error-dot-id)
    (= id lower-comptime-error-comptime-error-slash-id)
    (= id lower-comptime-error-stdlib-dot-dot-id)
    (= id lower-comptime-error-stdlib-dot-slash-id)
    (= id lower-comptime-error-stdlib-slash-dot-id)
    (= id lower-comptime-error-stdlib-slash-slash-id)
    (= id lower-comptime-error-stdlib-error-dot-dot-id)
    (= id lower-comptime-error-stdlib-error-dot-slash-id)
    (= id lower-comptime-error-stdlib-error-slash-dot-id)
    (= id lower-comptime-error-stdlib-error-slash-slash-id)))

(define (lower-comptime-error-call-id? [id : i64]) : bool
  (begin
    (lower-comptime-error-ids-ensure!)
    (lower-comptime-error-call-id-with-cache? id)))

(define (lower-comptime-error-source-or-lookup-id?
  [source-id : i64]
  [lookup-id : i64]) : bool
  (begin
    (lower-comptime-error-ids-ensure!)
    (or
      (= source-id lower-comptime-error-id)
      (= source-id lower-comptime-error-comptime-dot-id)
      (= source-id lower-comptime-error-comptime-slash-id)
      (= source-id lower-comptime-error-comptime-error-dot-id)
      (= source-id lower-comptime-error-comptime-error-slash-id)
      (= source-id lower-comptime-error-stdlib-dot-dot-id)
      (= source-id lower-comptime-error-stdlib-dot-slash-id)
      (= source-id lower-comptime-error-stdlib-slash-dot-id)
      (= source-id lower-comptime-error-stdlib-slash-slash-id)
      (= source-id lower-comptime-error-stdlib-error-dot-dot-id)
      (= source-id lower-comptime-error-stdlib-error-dot-slash-id)
      (= source-id lower-comptime-error-stdlib-error-slash-dot-id)
      (= source-id lower-comptime-error-stdlib-error-slash-slash-id)
      (lower-comptime-error-call-id-with-cache? lookup-id))))

(define (lower-decl-kept-by-reach-or-dispatch?
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [used-types : lower_i64_i64_map.Map]
  [decl : AstDecl]) : bool
  (if (lower-type-decl? decl)
    (or
      (lower-comptime-runtime-skip-module? module)
      (lower-type-decl-used? module used-types decl))
    (lower-runtime-decl-kept-by-reach-or-dispatch?
      entry-path
      decl-path
      module
      module-id
      all-functions
      reachable
      dispatch-variants
      decl)))

(define (lower-filter-reachable-decls-paths-and-plan
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [all-functions : lower_i64_i64_map.Map]
  [reachable : lower_i64_i64_map.Map]
  [dispatch-variants : lower_i64_i64_map.Map]
  [used-types : lower_i64_i64_map.Map]) : LowerFilteredReachableWithPlan
  ;; The first reachability walk must materialize a program for clone-root
  ;; discovery. Record its decision for every source declaration at the same
  ;; time. Clone augmentation preserves source order and appends helpers, so
  ;; this dense plan can be applied after whole-program typecheck without
  ;; rebuilding the function/body/dispatch/type reachability indexes.
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    [out-paths : AstDeclPathList (ast-decl-path-list-with-capacity count)]
    [keep : (Array i64) (make-array i64 count)]
    [source-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [decl : AstDecl
            (ast-decl-list-get (& decls) index (ast-decl-fallback))]
          [decl-path : String
            (ast-decl-path-list-get (& paths) index entry-path)]
          [logical-module-id : i64
            (lower-decl-owner-module-id
              (& paths)
              index
              entry-path
              decl-path
              source-module-id)]
          [kept : bool
            (match decl
              [(AstDecl.Module _) true]
              [_
                (lower-decl-kept-by-reach-or-dispatch?
                  entry-path
                  decl-path
                  (lower-decl-owner-module-name
                    source-module-id
                    logical-module-id)
                  logical-module-id
                  all-functions
                  reachable
                  dispatch-variants
                  used-types
                  decl)])]
          (begin
            (if kept
              (begin
                (array-set! keep index 1)
                (ast-decl-list-push (&mut out) decl)
                (ast-decl-path-list-push-with-owner-id
                  (&mut out-paths)
                  decl-path
                  (ast-decl-path-list-owner-id (& paths) index source-module-id)))
              unit)
            (match decl
              [(AstDecl.Module next-module) (set! source-module-id next-module)]
              [_ unit])
            (set! index (+ index 1)))))
      (LowerFilteredReachableWithPlan.Filtered
        out
        out-paths
        (LowerDeclKeepPlan keep count)))))

(define (lower-decl-keep-plan-all [count : i64]) : LowerDeclKeepPlan
  (let
    [keep : (Array i64) (make-array i64 count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set! keep index 1)
          (set! index (+ index 1))))
      (LowerDeclKeepPlan keep count))))

(define (lower-decl-required-by-clone-roots?
  [roots : CloneNameSet]
  [module-id : i64]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefEnum decl-meta name _ _)
      (clone-name-set-contains-canonical-id? roots module-id name)]
    [(AstDecl.DefStruct decl-meta name _ _ _)
      (clone-name-set-contains-canonical-id? roots module-id name)]
    [(AstDecl.Unsafe inner-box)
      (lower-decl-required-by-clone-roots? roots module-id (box-get inner-box))]
    [_ false]))

(define (lower-decl-keep-plan-add-clone-roots
  [plan : LowerDeclKeepPlan]
  [program : AstProgram]
  [clone-roots : CloneNameList]) : LowerDeclKeepPlan
  ;; Clone-root discovery already computes the exact transitive nominal-type
  ;; closure required by generated helpers. Merge those type declarations into
  ;; the retained plan before source-pool compaction can release their AST.
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        [keep : (Array i64) (struct-get plan keep)]
        [source-count : i64 (struct-get plan source-count)]
        [roots : CloneNameSet
          (clone-name-list-to-set clone-roots (clone-name-set-empty))]
        [module-id : i64 cbi.compiler-builtin-id-fix-empty]
        [index : i64 0]
        [count : i64 (ast-decl-list-len (& decls))]
        (begin
          (while (and (< index count) (< index source-count))
            (let
              [decl : AstDecl
                (ast-decl-list-get (& decls) index (ast-decl-fallback))]
              (begin
                (if (lower-decl-required-by-clone-roots? roots module-id decl)
                  (array-set! keep index 1)
                  unit)
                (match decl
                  [(AstDecl.Module next-module) (set! module-id next-module)]
                  [_ unit])
                (set! index (+ index 1)))))
          (LowerDeclKeepPlan keep source-count)))]))

(define (lower-decl-keep-plan-copy-into-pools
  [plan : LowerDeclKeepPlan]
  [pools : AstNodePoolContext]) : LowerDeclKeepPlan
  (let
    [prev-arena : i64 (arena.tl_arena_current)]
    [base-arena : i64 (ast-node-pool-context-base-arena pools)]
    [_set-arena : unit
      (unsafe
        (arena.tl_arena_set base-arena))]
    [source : (Array i64) (struct-get plan keep)]
    [count : i64 (struct-get plan source-count)]
    [keep : (Array i64) (make-array i64 count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set! keep index (array-ref source index))
          (set! index (+ index 1))))
      (ast-node-pool-context-sync-base-arena! pools (arena.tl_arena_current))
      (unsafe
        (arena.tl_arena_set prev-arena))
      (LowerDeclKeepPlan keep count))))

(define (lower-decl-keep-plan-apply
  [plan : LowerDeclKeepPlan]
  [program : AstProgram]) : AstProgram
  ;; Source declarations retain their indices through clone augmentation;
  ;; generated clone helpers are appended and all are part of the exact root
  ;; closure, so retain them without another graph walk.
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        [count : i64 (ast-decl-list-len (& decls))]
        [source-count : i64 (struct-get plan source-count)]
        [keep : (Array i64) (struct-get plan keep)]
        [out : AstDeclList (ast-decl-list-with-capacity count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (if (or
                (>= index source-count)
                (not (= (array-ref keep index) 0)))
                (ast-decl-list-push
                  (&mut out)
                  (ast-decl-list-get (& decls) index (ast-decl-fallback)))
                unit)
              (set! index (+ index 1))))
          (ast-program out)))]))

(define (lower-decl-keep-plan-apply-paths
  [plan : LowerDeclKeepPlan]
  [paths : AstDeclPathList]) : AstDeclPathList
  (let
    [source-count : i64 (struct-get plan source-count)]
    [keep : (Array i64) (struct-get plan keep)]
    [count : i64 (ast-decl-path-list-len (& paths))]
    [limit : i64
      (if (< source-count count)
        source-count
        count)]
    [out : AstDeclPathList (ast-decl-path-list-with-capacity limit)]
    [index : i64 0]
    (begin
      (while (< index limit)
        (begin
          (when
            (not (= (array-ref keep index) 0))
            (ast-decl-path-list-push-with-owner-id
              (&mut out)
              (ast-decl-path-list-get (& paths) index "")
              (ast-decl-path-list-owner-id
                (& paths)
                index
                cbi.compiler-builtin-id-fix-empty)))
          (set! index (+ index 1))))
      out)))

(define (lower-reach-add-clone-root-helpers
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [roots : CloneNameList]
  [state : LowerReachState]) : LowerReachState
  (match roots
    [(CloneNameList.Nil) state]
    [(CloneNameList.ConsId _ helper-name-id rest)
      (lower-reach-add-clone-root-helpers
        all-functions
        names
        (box-get rest)
        (lower-reach-add-source-id all-functions names state helper-name-id))]))

;; Functions with an `(:export-symbol ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦)` declaration publish a fixed
;; ABI symbol and may be called only from outside TypeLisp IR (e.g. the
;; backend-emitted bounds/division/shift checks call the runtime-prelude
;; handlers). Seed every exported function as a reachability root so the prune
;; keeps it and its transitive callees even with no IR caller.
(define (lower-reach-add-export-root-decl
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [state : LowerReachState]
  [decl : AstDecl]) : LowerReachState
  (match decl
    [(AstDecl.DefFn decl-meta name _ _ _ metadata)
      (let
        [logical-name-id : i64 (lower-module-name-key-id-by-id module-id name)]
        [export-state : LowerReachState
          (match (ast-fn-metadata-export metadata)
            [(AstFnExport.Export symbol)
              (if (lower-runtime-prelude-selective-export-id? module-id symbol)
                state
                (lower-reach-add-logical all-functions state logical-name-id))]
            [(AstFnExport.No) state])]
        (match (ast-fn-metadata-spmd-callable metadata)
          [(AstSpmdCallable.No) export-state]
          [(AstSpmdCallable.Callable _)
            (lower-reach-add-logical all-functions export-state logical-name-id)]))]
    [(AstDecl.Extern decl-meta _ kind metadata _)
      (match kind
        [(AstExternKind.Function)
          (lower-reach-add-runtime-prelude-string-helper-id
            all-functions
            state
            (ast-extern-metadata-symbol-id (box-get metadata)))]
        [(AstExternKind.Value) state])]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (lower-reach-add-export-root-decl
          entry-path
          decl-path
          module
          module-id
          all-functions
          state
          inner))]
    [_ state]))

(define (lower-reach-add-export-roots-in-module
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [entry-path : String]
  [module : String]
  [module-id : i64]
  [all-functions : lower_i64_i64_map.Map]
  [state : LowerReachState]) : LowerReachState
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) state]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        [decl-path : String
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons path _) path]
            [(AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : AstDeclPathList
          (match (ast-decl-path-list-step paths)
            [(AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(AstDeclPathListStep.Nil) (ast-decl-path-list-new)])]
        (match decl
          [(AstDecl.Module next-module)
            (lower-reach-add-export-roots-in-module
              rest
              rest-paths
              entry-path
              (intern-str next-module)
              next-module
              all-functions
              state)]
          [_
            (lower-reach-add-export-roots-in-module
              rest
              rest-paths
              entry-path
              module
              module-id
              all-functions
              (lower-reach-add-export-root-decl
                entry-path
                decl-path
                module
                module-id
                all-functions
                state
                decl))]))]))

(define (lower-prune-unreachable-functions-with-clone-roots-and-plan
  [pools : AstNodePoolContext]
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [names : LowerNameEnv]
  [clone-roots : CloneNameList]) : LowerPrunedProgramWithPlan
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        ;; Publish the whole-program global name cache so the per-module
        ;; body name-cache overlays built inside lower-function-body-index-from-decls
        ;; (and resolved during lower-reach-process below) can fall through to it.
        ;; Kept in the PERSISTENT (caller) arena so it survives the scratch rewind
        ;; below (the original behavior); decl-lowering re-sets it before use.
        [_set-global : unit
          (begin
            (set!
              lower-active-global-name-cache
              (lower-name-cache-from-env names))
            unit)]
        ;; The reachability scratch (function/dispatch sets, body index and
        ;; its per-module name overlays, the reachable map) is the bulk of the
        ;; ~163MB / ~12% opt1 lower-phase prune cost and adds zero AST/type pool
        ;; nodes -- pure transient scratch. Build it inside the dedicated lower
        ;; scratch arena and rewind it once the pruned program is materialized.
        ;; The pruned decl/path lists only reference shared decl nodes (by
        ;; AstNodeId) and interned strings, never the scratch maps, so they are
        ;; safe to keep in the persistent arena after the rewind (mirrors the
        ;; scratch+escape pattern in lower-function-escaping).
        [prev-arena : i64 (arena.tl_arena_current)]
        [scratch : i64 (lower-scratch-arena-get)]
        (begin
          (unsafe
            (arena.tl_arena_set scratch))
          (let
            [mark : i64 (arena.tl_region_mark)]
            [all-functions : lower_i64_i64_map.Map
              (lower-function-set-from-decls decls paths entry-path)]
            [body-index : LowerFunctionBodyIndex
              (lower-function-body-index-from-decls
                pools
                decls
                paths
                entry-path
                names
                (lower-function-decl-count decls))]
            [name-cache : LowerNameCache (lower-name-cache-from-env names)]
            [dispatch-variants : lower_i64_i64_map.Map
              (lower-dispatch-variant-set-from-decls
                decls
                paths
                entry-path
                name-cache)]
            [main-id : i64 (lower-entry-main-logical-id all-functions)]
            [result : LowerPrunedProgramWithPlan
              (if (>= main-id 0)
                (begin
                  (set!
                    lower-reach-active-runtime-paths
                    (lower_i64_i64_map.with-capacity 1024))
                  (set!
                    lower-reach-active-body-used-types
                    (lower-used-types-precise-empty))
                  (let
                    [main-state : LowerReachState
                      (lower-reach-add-logical
                        all-functions
                        (LowerReachState.State
                          (lower_i64_i64_map.with-capacity 8192)
                          LowerIdSet.Nil)
                        main-id)]
                    [export-state : LowerReachState
                      (lower-reach-add-export-roots-in-module
                        decls
                        paths
                        entry-path
                        ""
                        cbi.compiler-builtin-id-fix-empty
                        all-functions
                        main-state)]
                    [cleanup-state : LowerReachState
                      (lower-reach-cleanup-metadata-roots-in-module
                        all-functions
                        decls
                        paths
                        entry-path
                        ""
                        cbi.compiler-builtin-id-fix-empty
                        name-cache
                        export-state)]
                    [clone-state : LowerReachState
                      (lower-reach-add-clone-root-helpers
                        all-functions
                        name-cache
                        clone-roots
                        cleanup-state)]
                    [dispatch-state : LowerReachState
                      (lower-reach-add-dispatch-variant-roots
                        all-functions
                        decls
                        name-cache
                        clone-state)]
                    [global-state : LowerReachState
                      (lower-reach-global-decls
                        pools
                        all-functions
                        name-cache
                        dispatch-state
                        decls
                        paths
                        entry-path
                        cbi.compiler-builtin-id-fix-empty)]
                    [reached-state : LowerReachState
                      (lower-reach-process
                        pools
                        all-functions
                        name-cache
                        body-index
                        global-state)]
                    (match reached-state
                      [(LowerReachState.State reachable _)
                        (let
                          [reachable-runtime-paths : lower_i64_i64_map.Map
                            lower-reach-active-runtime-paths]
                          [type-path-seed : LowerUsedTypePathSeed
                            (lower-used-types-path-seed-in-module
                              pools
                              decls
                              paths
                              entry-path
                              ""
                              reachable-runtime-paths
                              lower-reach-active-body-used-types
                              true)]
                          [used-types : lower_i64_i64_map.Map
                            (match type-path-seed
                              [(LowerUsedTypePathSeed.Seed
                                  reachable-path-type-names
                                  type-paths-covered)
                                (if type-paths-covered
                                  (lower_i64_i64_map.with-capacity 8)
                                  (lower-used-types-expand-fixed
                                    pools
                                    decls
                                    (lower-used-types-from-kept-decls-in-module
                                      pools
                                      decls
                                      paths
                                      entry-path
                                      ""
                                      cbi.compiler-builtin-id-fix-empty
                                      all-functions
                                      reachable
                                      dispatch-variants
                                      reachable-path-type-names)))])]
                          [scratch-head : i64 (arena.tl_arena_current)]
                          (begin
                            ;; Materialize the pruned program back in the persistent
                            ;; arena before rewinding the scratch arena.
                            (unsafe
                              (arena.tl_arena_set prev-arena))
                            (let
                              [filtered : LowerFilteredReachableWithPlan
                                (lower-filter-reachable-decls-paths-and-plan
                                  decls
                                  paths
                                  entry-path
                                  all-functions
                                  reachable
                                  dispatch-variants
                                  used-types)]
                              [pruned : LowerPrunedProgramWithPlan
                                (match filtered
                                  [(LowerFilteredReachableWithPlan.Filtered
                                      filtered-decls
                                      filtered-paths
                                      keep-plan)
                                    (LowerPrunedProgramWithPlan.Program
                                      (ast-program filtered-decls)
                                      filtered-paths
                                      keep-plan)])]
                              [new-prev-arena : i64 (arena.tl_arena_current)]
                              (begin
                                (unsafe
                                  (arena.tl_arena_set scratch-head)
                                  (arena.tl_region_reset mark)
                                  (arena.tl_arena_set new-prev-arena))
                                pruned))))])))
                (let
                  [scratch-head : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set prev-arena))
                    (LowerPrunedProgramWithPlan.Program
                      program
                      paths
                      (lower-decl-keep-plan-all (ast-decl-list-len (& decls)))))))]
            (begin
              (lower-reach-scratch-globals-reset!)
              result))))]))

(define (lower-prune-unreachable-functions-with-clone-roots
  [pools : AstNodePoolContext]
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [names : LowerNameEnv]
  [clone-roots : CloneNameList]) : LowerPrunedProgram
  (match (lower-prune-unreachable-functions-with-clone-roots-and-plan
    pools
    entry-path
    program
    paths
    names
    clone-roots)
    [(LowerPrunedProgramWithPlan.Program pruned-program pruned-paths _)
      (LowerPrunedProgram.Program pruned-program pruned-paths)]))

(define (lower-prune-unreachable-functions
  [pools : AstNodePoolContext]
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [names : LowerNameEnv]) : LowerPrunedProgram
  (lower-prune-unreachable-functions-with-clone-roots
    pools
    entry-path
    program
    paths
    names
    (CloneNameList.Nil)))

(define (lower-test-prune-unreachable-functions
  [entry-path : String]
  [program : AstProgram]
  [paths : AstDeclPathList]
  [names : LowerNameEnv]) : LowerPrunedProgram
  (lower-prune-unreachable-functions
    (ast-node-pool-context-capture-active)
    entry-path
    program
    paths
    names))

(define (lower-state-next-var [state : LowerState]) : i64
  (match state
    [(LowerState.State next-var _ _ _ _ _ _ _ _ _ _ _ _ _ _) next-var]))

(define (lower-state-current-label [state : LowerState]) : String
  (match state
    [(LowerState.State _ _ _ label _ _ _ _ _ _ _ _ _ _ _) label]))

(define (lower-state-current-function [state : LowerState]) : String
  (match state
    [(LowerState.State _ _ _ _ _ _ _ function _ _ _ _ _ _ _) function]))

(define (lower-state-spans [state : LowerState]) : CompilerSourceSpans
  (match state
    [(LowerState.State _ _ _ _ _ _ _ _ spans _ _ _ _ _ _) (box-get spans)]))

(define (lower-state-names [state : LowerState]) : LowerNameCache
  (match state
    [(LowerState.State _ _ _ _ _ _ _ _ _ names _ _ _ _ _) names]))

(define (lower-state-type-cache [state : LowerState]) : LowerTypeCache
  (match state
    [(LowerState.State _ _ _ _ _ _ _ _ _ _ type-cache _ _ _ _) type-cache]))

(define (lower-state-mode [state : LowerState]) : CompilerLowerMode
  (match state
    [(LowerState.State _ _ _ _ _ _ _ _ _ _ _ mode _ _ _) mode]))

(define (lower-state-register-address-taken-var?
  [state : LowerState]
  [var-id : i64]) : bool
  (match state
    [(LowerState.State _ _ _ _ _ _ _ _ _ _ _ _ address-taken _ _)
      (lower_i64_i64_map.contains? (& address-taken) var-id)]))

(define (lower-state-register-address-taken-mark
  [state : LowerState]
  [var-id : i64]) : LowerState
  (match state
    [(LowerState.State
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        tail-param-start
        tail-param-end)
      (let
        [next-address-taken : lower_i64_i64_map.Map address-taken]
        (begin
          (lower_i64_i64_map.insert-ref! (&mut next-address-taken) var-id 1)
          (LowerState.State
            next-var
            next-label
            next-lambda
            current-label
            current-instrs
            blocks
            functions
            function
            spans
            names
            type-cache
            mode
            next-address-taken
            tail-param-start
            tail-param-end)))]))

(define (lower-state-tail-param-start [state : LowerState]) : i64
  (match state
    [(LowerState.State _ _ _ _ _ _ _ _ _ _ _ _ _ param-start _) param-start]))

(define (lower-state-tail-param-end [state : LowerState]) : i64
  (match state
    [(LowerState.State _ _ _ _ _ _ _ _ _ _ _ _ _ _ param-end) param-end]))

(define (lower-state-tail-param-range-contains?
  [state : LowerState]
  [var-id : i64]) : bool
  (and
    (>= var-id (lower-state-tail-param-start state))
    (< var-id (lower-state-tail-param-end state))))

(define (lower-state-clear-tail-param-range [state : LowerState]) : LowerState
  (match state
    [(LowerState.State
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        _
        _)
      (LowerState.State
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        0
        0)]))

(define (lower-state-alloc-var [state : LowerState]) : LowerAlloc
  (match state
    [(LowerState.State
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        tail-param-start
        tail-param-end)
      (LowerAlloc.Alloc
        (LowerState.State
          (+ next-var 1)
          next-label
          next-lambda
          current-label
          current-instrs
          blocks
          functions
          function
          spans
          names
          type-cache
          mode
          address-taken
          tail-param-start
          tail-param-end)
        next-var)]))

(define (lower-state-next-label-number [state : LowerState]) : i64
  (match state
    [(LowerState.State _ next-label _ _ _ _ _ _ _ _ _ _ _ _ _) next-label]))

(define (lower-state-fresh-label [state : LowerState] [prefix : String]) : LowerLabel
  (match state
    [(LowerState.State
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        tail-param-start
        tail-param-end)
      (LowerLabel.Label
        (LowerState.State
          next-var
          (+ next-label 1)
          next-lambda
          current-label
          current-instrs
          blocks
          functions
          function
          spans
          names
          type-cache
          mode
          address-taken
          tail-param-start
          tail-param-end)
        (string.append
          (string.append prefix ".")
          (string.int->string next-label)))]))

(define (lower-state-fresh-lambda-name [state : LowerState]) : LowerLambdaName
  (match state
    [(LowerState.State
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        tail-param-start
        tail-param-end)
      (let
        [lambda-name : String
          (string.append
            (string.append (string.append "__tl_lambda_" function) "_")
            (string.int->string next-lambda))]
        [lambda-id : i64 (ci.intern-generated-name lambda-name)]
        (LowerLambdaName.Name
          (LowerState.State
            next-var
            next-label
            (+ next-lambda 1)
            current-label
            current-instrs
            blocks
            functions
            function
            spans
            names
            type-cache
            mode
            address-taken
            tail-param-start
            tail-param-end)
          lambda-id))]))

(define (lower-state-emit [state : LowerState] [instr : CompilerIrInstr]) : LowerState
  (match state
    [(LowerState.State
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        tail-param-start
        tail-param-end)
      (let
        [next-instrs : CompilerIrInstrBuilder current-instrs]
        (begin
          (compiler-ir-instr-builder-push! (&mut next-instrs) instr)
          (LowerState.State
            next-var
            next-label
            next-lambda
            current-label
            next-instrs
            blocks
            functions
            function
            spans
            names
            type-cache
            mode
            address-taken
            tail-param-start
            tail-param-end)))]))

(define (lower-state-emit-at-expr
  [state : LowerState]
  [instr : CompilerIrInstr]
  [_expr : AstExpr]) : LowerState
  ;; Per-instruction spans are allocated inside per-function scratch arenas and
  ;; are not escaped by `lower-function-escaping`; function-level spans are
  ;; recorded separately after escape.
  (lower-state-emit state instr))

(define (lower-state-finish-block [state : LowerState] [next-label : String]) : LowerState
  (match state
    [(LowerState.State
        next-var
        next-label-id
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        tail-param-start
        tail-param-end)
      (LowerState.State
        next-var
        next-label-id
        next-lambda
        next-label
        (compiler-ir-instr-builder-new)
        (let
          [next-blocks : CompilerIrBlockBuilder blocks]
          (begin
            (compiler-ir-block-builder-push!
              (&mut next-blocks)
              (CompilerIrBlock.Block
                current-label
                (compiler-ir-instr-builder-to-seq current-instrs)))
            next-blocks))
        functions
        function
        spans
        names
        type-cache
        mode
        address-taken
        tail-param-start
        tail-param-end)]))

(define (lower-state-build-blocks [state : LowerState]) : CompilerIrBlockList
  (match state
    [(LowerState.State
        _
        _
        _
        current-label
        current-instrs
        blocks
        _
        _
        _
        _
        _
        _
        _
        _
        _)
      (let
        [current-block : CompilerIrBlock
          (CompilerIrBlock.Block
            current-label
            (compiler-ir-instr-builder-to-seq current-instrs))]
        [next-blocks : CompilerIrBlockBuilder blocks]
        (begin
          (compiler-ir-block-builder-push! (&mut next-blocks) current-block)
          (compiler-ir-block-builder-to-list next-blocks)))]))

(define (lower-state-build-function-blocks [state : LowerState]) : CompilerIrBlockList
  (lower-state-build-blocks state))

(define (lower-state-build-functions-with
  [state : LowerState]
  [func : CompilerIrFunction]) : CompilerIrFunctionList
  (match state
    [(LowerState.State _ _ _ _ _ _ functions _ _ _ _ _ _ _ _)
      (let
        [out : CompilerIrFunctionBuilder functions]
        (begin
          (compiler-ir-function-builder-push! (&mut out) func)
          (compiler-ir-function-builder-to-list out)))]))

(define (lower-state-add-functions
  [state : LowerState]
  [new-functions : CompilerIrFunctionList]
  [new-spans : CompilerSourceSpans]) : LowerState
  (match state
    [(LowerState.State
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        _
        names
        type-cache
        mode
        address-taken
        tail-param-start
        tail-param-end)
      (let
        [next-functions : CompilerIrFunctionBuilder functions]
        (begin
          (compiler-ir-function-builder-append-list!
            (&mut next-functions)
            new-functions)
          (LowerState.State
            next-var
            next-label
            next-lambda
            current-label
            current-instrs
            blocks
            next-functions
            function
            (box new-spans)
            names
            type-cache
            mode
            address-taken
            tail-param-start
            tail-param-end)))]))

(define (lower-materialize
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit allocated (CompilerIrInstr.Mov var-id value ty))
          (CompilerIrValue.Var var-id)
          ty))]))

(define (lower-materialize-at-expr
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]
  [expr : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (let
        [instr : CompilerIrInstr (CompilerIrInstr.Mov var-id value ty)]
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit-at-expr allocated instr expr)
            (CompilerIrValue.Var var-id)
            ty)))]))

(define (lower-float-literal-bits [text : String] [ty : AstType]) : u64
  (match ty
    [(AstType.F32)
      (match (compiler-float-parse-f32-bits text)
        [(CompilerFloatSomeBits bits) bits]
        [(CompilerFloatNoBits) (cast 0 : u64)])]
    [_
      (match (compiler-float-parse-f64-bits text)
        [(CompilerFloatSomeBits bits) bits]
        [(CompilerFloatNoBits) (cast 0 : u64)])]))

(define (lower-literal-value-with-type [lit : AstLiteral] [ty : AstType]) : CompilerIrValue
  (match lit
    [(AstLiteral.Int n _) (CompilerIrValue.I64 n)]
    [(AstLiteral.Float n) (CompilerIrValue.F64 (lower-float-literal-bits n ty))]
    [(AstLiteral.Bool b) (CompilerIrValue.Bool b)]
    [(AstLiteral.Char c) (CompilerIrValue.Char c)]
    [(AstLiteral.String string-id)
      (CompilerIrValue.String (intern-str string-id))]
    [(AstLiteral.Unit) CompilerIrValue.Unit]))

(define (lower-binop [op : AstBinOp]) : CompilerIrBinOp
  (match op
    [(AstBinOp.Add) CompilerIrBinOp.Add]
    [(AstBinOp.Sub) CompilerIrBinOp.Sub]
    [(AstBinOp.Mul) CompilerIrBinOp.Mul]
    [(AstBinOp.Div) CompilerIrBinOp.Div]
    [(AstBinOp.Mod) CompilerIrBinOp.Mod]
    [(AstBinOp.Eq) CompilerIrBinOp.Eq]
    [(AstBinOp.Ne) CompilerIrBinOp.Ne]
    [(AstBinOp.Lt) CompilerIrBinOp.Lt]
    [(AstBinOp.Le) CompilerIrBinOp.Le]
    [(AstBinOp.Gt) CompilerIrBinOp.Gt]
    [(AstBinOp.Ge) CompilerIrBinOp.Ge]
    [(AstBinOp.And) CompilerIrBinOp.And]
    [(AstBinOp.Or) CompilerIrBinOp.Or]
    [(AstBinOp.BitAnd) CompilerIrBinOp.BitAnd]
    [(AstBinOp.BitOr) CompilerIrBinOp.BitOr]
    [(AstBinOp.BitXor) CompilerIrBinOp.BitXor]
    [(AstBinOp.Shl) CompilerIrBinOp.Shl]
    [(AstBinOp.Shr) CompilerIrBinOp.Shr]))

(define (lower-unop [op : AstUnOp]) : CompilerIrUnOp
  (match op
    [(AstUnOp.Neg) CompilerIrUnOp.Neg]
    [(AstUnOp.Not) CompilerIrUnOp.Not]
    [(AstUnOp.BitNot) CompilerIrUnOp.BitNot]))

(define (lower-align-up [n : i64] [align : i64]) : i64
  (if (<= align 1)
    n
    (* (/ (+ n (- align 1)) align) align)))

(define (lower-inline-layout-size-or
  [ctx : TcContext]
  [ty : AstType]
  [fallback : i64]) : i64
  ;; Compile-time: a bare struct/enum size is memoized by stable
  ;; interned type-name id
  ;; (its size is stable; this is the hot type-size query in lowering). Generic
  ;; ...Args / tuples / arrays depend on type arguments, so keep the uncached path.
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (tc-inline-aggregate-size-cached ctx name fallback)]
    [(AstType.Enum name) (tc-inline-aggregate-size-cached ctx name fallback)]
    [_
      (match (tc-inline-aggregate-type-layout ctx ty)
        [(ResultTcLayoutInfo.Ok info) (tc-layout-info-size info)]
        [(ResultTcLayoutInfo.Err _) fallback])]))

(define (lower-inline-layout-align-or
  [ctx : TcContext]
  [ty : AstType]
  [fallback : i64]) : i64
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (tc-inline-aggregate-align-cached ctx name fallback)]
    [(AstType.Enum name) (tc-inline-aggregate-align-cached ctx name fallback)]
    [_
      (match (tc-inline-aggregate-type-layout ctx ty)
        [(ResultTcLayoutInfo.Ok info) (tc-layout-info-align info)]
        [(ResultTcLayoutInfo.Err _) fallback])]))

(define (lower-type-size [ctx : TcContext] [ty : AstType]) : i64
  (match (tc-resolve-type ctx ty)
    [(AstType.I64) 8]
    [(AstType.U64) 8]
    [(AstType.F64) 8]
    [(AstType.I32) 4]
    [(AstType.U32) 4]
    [(AstType.F32) 4]
    [(AstType.I16) 2]
    [(AstType.U16) 2]
    [(AstType.I8) 1]
    [(AstType.U8) 1]
    [(AstType.Bool) 1]
    [(AstType.Char) 1]
    [(AstType.Unit) 0]
    [(AstType.Never) 0]
    [(AstType.Expr) 0]
    [(AstType.ExprList) 0]
    [(AstType.Func _ _) 8]
    [(AstType.Tuple _) 8]
    [(AstType.Array _ _) (lower-inline-layout-size-or ctx ty 8)]
    [(AstType.DynArray _) 8]
    [(AstType.Box _) 8]
    [(AstType.Ptr _) 8]
    [(AstType.MutPtr _) 8]
    [(AstType.Ref _ _) 8]
    [(AstType.MutRef _ _) 8]
    [(AstType.Region _ inner)
      (lower-type-size ctx (tc-context-type-get ctx inner))]
    [(AstType.Enum name)
      (lower-inline-layout-size-or ctx (AstType.Enum name) 8)]
    [(AstType.EnumArgs name lifetimes)
      (lower-inline-layout-size-or ctx (AstType.EnumArgs name lifetimes) 8)]
    [(AstType.Struct name)
      (lower-inline-layout-size-or ctx (AstType.Struct name) 8)]
    [(AstType.StructArgs name lifetimes)
      (lower-inline-layout-size-or ctx (AstType.StructArgs name lifetimes) 8)]
    [(AstType.String) 8]
    [(AstType.Str) 8]
    [(AstType.Bytes) 8]
    [(AstType.Var _) 8]
    [(AstType.VarArgs _ _) 8]
    [(AstType.Consume inner)
      (lower-type-size ctx (tc-context-type-get ctx inner))]))

(define (lower-type-align [ctx : TcContext] [ty : AstType]) : i64
  (match (tc-resolve-type ctx ty)
    [(AstType.I64) 8]
    [(AstType.U64) 8]
    [(AstType.F64) 8]
    [(AstType.I32) 4]
    [(AstType.U32) 4]
    [(AstType.F32) 4]
    [(AstType.I16) 2]
    [(AstType.U16) 2]
    [(AstType.I8) 1]
    [(AstType.U8) 1]
    [(AstType.Bool) 1]
    [(AstType.Char) 1]
    [(AstType.Unit) 1]
    [(AstType.Never) 1]
    [(AstType.Expr) 1]
    [(AstType.ExprList) 1]
    [(AstType.Func _ _) 8]
    [(AstType.Tuple _) 8]
    [(AstType.Array _ _) (lower-inline-layout-align-or ctx ty 8)]
    [(AstType.DynArray _) 8]
    [(AstType.Box _) 8]
    [(AstType.Ptr _) 8]
    [(AstType.MutPtr _) 8]
    [(AstType.Ref _ _) 8]
    [(AstType.MutRef _ _) 8]
    [(AstType.Region _ inner)
      (lower-type-align ctx (tc-context-type-get ctx inner))]
    [(AstType.Enum name)
      (lower-inline-layout-align-or ctx (AstType.Enum name) 8)]
    [(AstType.EnumArgs name lifetimes)
      (lower-inline-layout-align-or ctx (AstType.EnumArgs name lifetimes) 8)]
    [(AstType.Struct name)
      (lower-inline-layout-align-or ctx (AstType.Struct name) 8)]
    [(AstType.StructArgs name lifetimes)
      (lower-inline-layout-align-or ctx (AstType.StructArgs name lifetimes) 8)]
    [(AstType.String) 8]
    [(AstType.Str) 8]
    [(AstType.Bytes) 8]
    [(AstType.Var _) 8]
    [(AstType.VarArgs _ _) 8]
    [(AstType.Consume inner)
      (lower-type-align ctx (tc-context-type-get ctx inner))]))

(define (lower-type-list-extent
  [ctx : TcContext]
  [types : AstTypeList]
  [cursor : i64]) : i64
  (lower-type-list-extent-at ctx (& types) cursor 0))

(define (lower-type-list-extent-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [cursor : i64]
  [index : i64]) : i64
  (if (>= index (ast-type-list-len types))
    cursor
    (let
      [ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      [resolved : AstType (tc-resolve-type ctx ty)]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      (lower-type-list-extent-at
        ctx
        types
        (+ offset (lower-type-size ctx resolved))
        (+ index 1)))))

(define (lower-type-list-storage-size [ctx : TcContext] [types : AstTypeList]) : i64
  (let
    [extent : i64 (lower-type-list-extent ctx types 0)]
    (lower-align-up
      (if (= extent 0)
        1
        extent)
      8)))

(define (lower-variant-fields-storage-size
  [ctx : TcContext]
  [fields : AstTypeList]) : i64
  (lower-align-up (lower-type-list-extent ctx fields 8) 8))

(define (lower-variant-storage-size [ctx : TcContext] [variant : AstVariantDef]) : i64
  (match variant
    [(AstVariantDef.Def _ fields _)
      (lower-variant-fields-storage-size ctx fields)]))

(define (lower-nullary-variant-object-symbol
  [enum-name : String]
  [variant-name : String]) : i64
  (lower-derived-symbol-id
    (string.append
      "__enum_obj_"
      (string.append enum-name (string.append "_" variant-name)))))

(define (lower-nullary-variant-globals
  [enum-name-id : i64]
  [enum-name : String]
  [variants : AstVariantDefList]
  [tag : i64]
  [globals : CompilerIrGlobalList]) : CompilerIrGlobalList
  (if (>= tag (struct-get (& variants) len))
    globals
    (match (ast-variant-def-list-get
      (& variants)
      tag
      (ast-variant-def-fallback))
      [(AstVariantDef.Def variant-name fields _)
        (let
          [next : CompilerIrGlobalList
            (if (ast-type-list-empty? (& fields))
              (let
                [object-name : i64
                  (lower-nullary-variant-object-symbol
                    enum-name
                    (tc-env-key-name-text variant-name))]
                (compiler-ir-global-cons
                  (CompilerIrGlobal.Global
                    object-name
                    (AstType.I64)
                    (CompilerIrValue.I64 tag))
                  globals))
              globals)]
          (lower-nullary-variant-globals
            enum-name-id
            enum-name
            variants
            (+ tag 1)
            next))])))

(define (lower-enum-variants-storage-size
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [max-size : i64]) : i64
  (lower-enum-variants-storage-size-at ctx (& variants) max-size 0))

(define (lower-enum-variants-storage-size-at
  [ctx : TcContext]
  [variants : (& variants AstVariantDefList)]
  [max-size : i64]
  [index : i64]) : i64
  (if (>= index (struct-get variants len))
    max-size
    (let
      [size : i64
        (lower-variant-storage-size
          ctx
          (ast-variant-def-list-get variants index (ast-variant-def-fallback)))]
      (lower-enum-variants-storage-size-at
        ctx
        variants
        (if (> size max-size)
          size
          max-size)
        (+ index 1)))))

(define (lower-enum-storage-size
  [ctx : TcContext]
  [enum-name-id : i64]
  [enum-name : String]) : i64
  (match (tc-context-enum-variants-id ctx enum-name-id enum-name)
    [(ResultAstVariantDefList.Ok variants)
      (lower-enum-variants-storage-size ctx variants 8)]
    [(ResultAstVariantDefList.Err _) 8]))

(define (lower-struct-fields-at-handle
  [ctx : TcContext]
  [handle : i64]
  [struct-name : String]) : ResultAstFieldDefList
  (if (and
    (compiler-symbols-handle-found? handle)
    (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defstruct)))
    (match (compiler-symbols-decl-at-index
      (tc-context-symbols ctx)
      (compiler-symbol-handle-index handle))
      [(ResultAstDecl.Ok decl)
        (match decl
          [(AstDecl.DefStruct decl-meta _ _ _ fields)
            (ResultAstFieldDefList.Ok fields)]
          [(AstDecl.DefStructLifetimes decl-meta _ _ _ _ fields)
            (ResultAstFieldDefList.Ok fields)]
          [_
            (ResultAstFieldDefList.Err
              "lower: struct symbol owner is not a struct")])]
      [(ResultAstDecl.Err message) (ResultAstFieldDefList.Err message)])
    (ResultAstFieldDefList.Err
      (string.append "lower: unknown struct " struct-name))))

(define (lower-struct-fields-id
  [ctx : TcContext]
  [struct-id : i64]
  [struct-name : String]) : ResultAstFieldDefList
  (lower-struct-fields-at-handle
    ctx
    (compiler-symbols-lookup-type-id-or
      (tc-context-symbols ctx)
      struct-id
      (compiler-symbols-missing-handle))
    struct-name))

(define (lower-struct-repr-c-id? [ctx : TcContext] [struct-id : i64]) : bool
  (let
    [handle : i64
      (compiler-symbols-lookup-type-id-or
        (tc-context-symbols ctx)
        struct-id
        (compiler-symbols-missing-handle))]
    (if (and
      (compiler-symbols-handle-found? handle)
      (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defstruct)))
      (match (compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle))
        [(ResultAstDecl.Ok decl)
          (match decl
            [(AstDecl.DefStruct decl-meta _ repr _ _) (ast-struct-repr-c? repr)]
            [(AstDecl.DefStructLifetimes decl-meta _ _ repr _ _)
              (ast-struct-repr-c? repr)]
            [_ false])]
        [(ResultAstDecl.Err _) false])
      false)))

(define (lower-repr-c-inline-field? [ctx : TcContext] [field-ty : AstType]) : bool
  (match (tc-resolve-type ctx field-ty)
    [(AstType.Struct nested) (lower-struct-repr-c-id? ctx nested)]
    [_ false]))

(define (lower-repr-c-field-size [ctx : TcContext] [field-ty : AstType]) : i64
  (match (tc-resolve-type ctx field-ty)
    [(AstType.Struct nested)
      (match (tc-repr-c-struct-layout-id
        ctx
        (tc-nominal-name-id-display nested)
        nested)
        [(ResultTcReprCLayout.Ok layout) (tc-repr-c-layout-size layout)]
        [(ResultTcReprCLayout.Err _) 8])]
    [_ (lower-type-size ctx field-ty)]))

(define (lower-reserve-heap-storage
  [state : LowerState]
  [size : i64]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (LowerExpr.Expr
        (lower-state-emit
          allocated
          (CompilerIrInstr.Call
            var-id
            (lower-tl-alloc-symbol)
            (CompilerIrCallArgs.One (CompilerIrValue.I64 size))
            ty))
        (CompilerIrValue.Var var-id)
        ty)]))

(define (lower-inline-storage-slot-count [size : i64]) : i64
  (if (<= size 8)
    1
    (/ (+ size 7) 8)))

(define (lower-reserve-inline-slot-vars
  [state : LowerState]
  [slots : i64]
  [ty : AstType]) : LowerInlineStorage
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (let
        [next-state : LowerState
          (lower-state-emit allocated (CompilerIrInstr.Alloc var-id ty))]
        (if (<= slots 1)
          (LowerInlineStorage.Storage next-state var-id)
          (lower-reserve-inline-slot-vars next-state (- slots 1) ty)))]))

(define (lower-reserve-inline-storage
  [state : LowerState]
  [size : i64]
  [ty : AstType]) : LowerExpr
  (match (lower-reserve-inline-slot-vars
    state
    (lower-inline-storage-slot-count size)
    ty)
    [(LowerInlineStorage.Storage storage-state storage-var)
      (match (lower-state-alloc-var storage-state)
        [(LowerAlloc.Alloc addr-alloc addr-var)
          (LowerExpr.Expr
            (lower-state-emit
              addr-alloc
              (CompilerIrInstr.AddrOf addr-var storage-var))
            (CompilerIrValue.Var addr-var)
            ty)])]))

(define (lower-gep-byte
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (LowerExpr.Expr
        (lower-state-emit
          allocated
          (CompilerIrInstr.Gep
            var-id
            base
            (CompilerIrValue.I64 offset)
            (AstType.U8)))
        (CompilerIrValue.Var var-id)
        (AstType.U64))]))

(define (lower-store-at-offset
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [value : CompilerIrValue]
  [ty : AstType]) : LowerState
  (match (lower-gep-byte state base offset)
    [(LowerExpr.Expr ptr-state ptr _)
      (lower-state-emit ptr-state (CompilerIrInstr.StorePtr ptr value ty))]))

(define (lower-load-at-offset
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [ty : AstType]) : LowerExpr
  (match (lower-gep-byte state base offset)
    [(LowerExpr.Expr ptr-state ptr _)
      (match (lower-state-alloc-var ptr-state)
        [(LowerAlloc.Alloc allocated var-id)
          (LowerExpr.Expr
            (lower-state-emit allocated (CompilerIrInstr.Load var-id ptr ty))
            (CompilerIrValue.Var var-id)
            ty)])]))

(define (lower-copy-chunk-size [remaining : i64]) : i64
  (cond [(>= remaining 8) 8] [(>= remaining 4) 4] [(>= remaining 2) 2] [else 1]))

(define (lower-copy-chunk-type [chunk : i64]) : AstType
  (cond
    [(= chunk 8) (AstType.U64)]
    [(= chunk 4) (AstType.U32)]
    [(= chunk 2) (AstType.U16)]
    [else (AstType.U8)]))

;; The byte address `base + offset` as an IR value (the base itself when
;; offset is 0, avoiding a no-op gep).
(define (lower-offset-addr
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]) : LowerExpr
  (if (= offset 0)
    (LowerExpr.Expr state base (AstType.U64))
    (lower-gep-byte state base offset)))

;; Inline the hottest by-value aggregate copies. The flip to
;; inline-by-value aggregates made the 17-112 B band, especially
;; AstTypeList/AstType, ResultTcType/ResultTcType.Ok, and CompilerIrInstr copies,
;; dynamically dominant, but the 16 B ceiling pushed every one of them onto a
;; `tl_memcpy` CALL (~88 dynamic instructions each). Inline they cost only
;; `size/8` load+store pairs. Raising the ceiling to 112 B turns that band into straight movs (a few
;; instructions) while still routing genuinely large copies through tl_memcpy so
;; the emitted code does not blow up. Must stay a multiple of 8 so the inline
;; chunk loop (lower-copy-chunk-size: 8/4/2/1) terminates cleanly for any size.
(define lower-inline-copy-threshold : i64
  112)

;; Copy `size` bytes dst<-src via a single tl_memcpy runtime call instead
;; of `size/8` separate gep+load+gep+store chunks. The flip from heap-handle
;; structs to inline-by-value aggregates turned every large by-value
;; aggregate copy (set!, pass/return, clone of a >16 B struct) into a long run of
;; word copies -- the dominant `movq` source at -O1 (the `movq ...,%r10 ; movq
;; off(%r10),%rax ; movq %rax,SLOT` runs). One call collapses each run to a few
;; instructions. tl_memcpy takes (dst, src, len) and is emitted unconditionally in
;; the runtime. Only used for copies large enough that the call beats the inline
;; chunks (see lower-copy-bytes threshold).
(define (lower-emit-memcpy
  [state : LowerState]
  [dst : CompilerIrValue]
  [dst-offset : i64]
  [src : CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (match (lower-offset-addr state dst dst-offset)
    [(LowerExpr.Expr dst-state dst-addr _)
      (match (lower-offset-addr dst-state src src-offset)
        [(LowerExpr.Expr src-state src-addr _)
          (match (lower-state-alloc-var src-state)
            [(LowerAlloc.Alloc call-state call-var)
              (lower-state-emit
                call-state
                (CompilerIrInstr.Call
                  call-var
                  (lower-derived-symbol-id "tl_memcpy")
                  (compiler-ir-call-args-from-list
                    (compiler-ir-value-cons
                      dst-addr
                      (compiler-ir-value-cons
                        src-addr
                        (compiler-ir-value-cons
                          (CompilerIrValue.I64 size)
                          (CompilerIrValueList.Nil)))))
                  (AstType.Unit)))])])]))

(define (lower-emit-memcpy-value
  [state : LowerState]
  [dst : CompilerIrValue]
  [dst-offset : i64]
  [src : CompilerIrValue]
  [src-offset : i64]
  [size : CompilerIrValue]) : LowerState
  (match (lower-offset-addr state dst dst-offset)
    [(LowerExpr.Expr dst-state dst-addr _)
      (match (lower-offset-addr dst-state src src-offset)
        [(LowerExpr.Expr src-state src-addr _)
          (match (lower-state-alloc-var src-state)
            [(LowerAlloc.Alloc call-state call-var)
              (lower-state-emit
                call-state
                (CompilerIrInstr.Call
                  call-var
                  (lower-derived-symbol-id "tl_memcpy")
                  (compiler-ir-call-args-from-list
                    (compiler-ir-value-cons
                      dst-addr
                      (compiler-ir-value-cons
                        src-addr
                        (compiler-ir-value-cons size (CompilerIrValueList.Nil)))))
                  (AstType.Unit)))])])]))

(define (lower-copy-bytes
  [state : LowerState]
  [dst : CompilerIrValue]
  [dst-offset : i64]
  [src : CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (cond
    [(<= size 0) state]
    [(> size lower-inline-copy-threshold)
      (lower-emit-memcpy state dst dst-offset src src-offset size)]
    [(>= size 16)
      (match (lower-offset-addr state dst dst-offset)
        [(LowerExpr.Expr dst-state dst-addr _)
          (match (lower-offset-addr dst-state src src-offset)
            [(LowerExpr.Expr src-state src-addr _)
              (lower-state-emit
                src-state
                (CompilerIrInstr.CopyBytes dst-addr src-addr size))])])]
    [else
      (let
        [chunk : i64 (lower-copy-chunk-size size)]
        [chunk-ty : AstType (lower-copy-chunk-type chunk)]
        (match (lower-load-at-offset state src src-offset chunk-ty)
          [(LowerExpr.Expr loaded value _)
            (lower-copy-bytes
              (lower-store-at-offset loaded dst dst-offset value chunk-ty)
              dst
              (+ dst-offset chunk)
              src
              (+ src-offset chunk)
              (- size chunk))]))]))

;; A value is stored FULL-INLINE (its own bytes, addressed by a pointer) when it
;; is a memory aggregate: a struct/enum or fixed array. Tuples, boxes,
;; dyn-arrays, strings, closures, and scalars keep their existing register-width
;; slot semantics:
;; they use scalar load/store rather than byte-copy or pointer-return.
;; This is the precise gate for choosing inline byte-copy / pointer-return vs.
;; scalar load/store, distinct from the broad lower-type-contains-inline-
;; aggregate? (which is used for the conservative tail-call risk check).
(define (lower-type-inline-storage? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Array _ _) true]
    [_ false]))

(define (lower-type-inline-struct-or-enum? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ false]))

;; A register-resident aggregate is an inline struct/enum that fits in a
;; single 8-byte word and is built only of word-class fields. Such a value is
;; carried through the IR as the packed word itself (an i64-shaped SSA value)
;; rather than a pointer to a stack slot: construction packs the fields with
;; shift/or, `struct-get`/`match` extract them with shift/mask, and the value is
;; passed/returned/cloned exactly like a scalar - never touching memory.
;; AstType.StructArgs/AstType.EnumArgs here are lifetime-arg forms; they share
;; the same layout and representation as the bare declaration.
(define (lower-type-register-resident? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (> (tc-inline-aggregate-regwords-cached ctx name) 0)]
    [(AstType.StructArgs name _)
      (> (tc-inline-aggregate-regwords-cached ctx name) 0)]
    [(AstType.Enum name) (> (tc-inline-aggregate-regwords-cached ctx name) 0)]
    [(AstType.EnumArgs name _)
      (> (tc-inline-aggregate-regwords-cached ctx name) 0)]
    [_ false]))

;; Number of machine words a register-resident aggregate occupies
;; (ceil(size/8)). 1 word => carried as a single scalar value; 2
;; words => carried as a register-group value built with CompilerIrInstr.Pack and read
;; with IrInstrWord. Only meaningful when `lower-type-register-resident?` holds.
;; True for a register-resident aggregate that needs the multi-word
;; register-group representation (2+ words) rather than the single-word scalar
;; representation. Drives the CompilerIrInstr.Pack/CompilerIrInstr.Word lowering paths.
(define (lower-type-register-group? [ctx : TcContext] [ty : AstType]) : bool
  (> (lower-type-register-words ctx ty) 1))

;; Register-residency in ONE inline-layout build, vs the THREE transient
;; layout rebuilds of calling register-resident? + register-group? (which itself
;; rebuilds for resident? and for the size) separately. Returns the machine-word
;; count (1 or 2) of a register-resident aggregate, else 0. Used on the hot match
;; path so the per-function scratch arena keeps the same transient-allocation
;; profile as before this slice (excess rebuilds there overflowed it into a second
;; chunk whose rewind leaked into later lowering).
(define (lower-type-register-words [ctx : TcContext] [ty : AstType]) : i64
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (tc-inline-aggregate-regwords-cached ctx name)]
    [(AstType.StructArgs name _) (tc-inline-aggregate-regwords-cached ctx name)]
    [(AstType.Enum name) (tc-inline-aggregate-regwords-cached ctx name)]
    [(AstType.EnumArgs name _) (tc-inline-aggregate-regwords-cached ctx name)]
    [_ 0]))

(define (lower-f64-register-word-field?
  [field-ty : AstType]
  [offset : i64]
  [word-index : i64]) : bool
  (match (tc-type-strip-region field-ty)
    [(AstType.F64) (and (= (/ offset 8) word-index) (= (% offset 8) 0))]
    [_ false]))

(define (lower-sse-register-word-field?
  [field-ty : AstType]
  [offset : i64]
  [word-index : i64]) : bool
  (match (tc-type-strip-region field-ty)
    [(AstType.F64) (and (= (/ offset 8) word-index) (= (% offset 8) 0))]
    [(AstType.F32) (and (= (/ offset 8) word-index) (= (% offset 4) 0))]
    [_ false]))

(define (lower-register-word-type-merge
  [current : AstType]
  [field-ty : AstType]
  [offset : i64]
  [word-index : i64]) : AstType
  (if (lower-sse-register-word-field? field-ty offset word-index)
    (AstType.F64)
    current))

(define (lower-register-struct-word-type-fields
  [fields : TcInlineFieldLayoutList]
  [word-index : i64]
  [current : AstType]) : AstType
  (match fields
    [(TcInlineFieldLayoutList.Nil) current]
    [(TcInlineFieldLayoutList.Cons field rest)
      (lower-register-struct-word-type-fields
        (box-get rest)
        word-index
        (lower-register-word-type-merge
          current
          (tc-inline-field-layout-type field)
          (tc-inline-field-layout-offset field)
          word-index))]))

(define (lower-register-payload-word-type-fields
  [payloads : TcInlinePayloadLayoutList]
  [word-index : i64]
  [current : AstType]) : AstType
  (match payloads
    [(TcInlinePayloadLayoutList.Nil) current]
    [(TcInlinePayloadLayoutList.Cons payload rest)
      (lower-register-payload-word-type-fields
        (box-get rest)
        word-index
        (lower-register-word-type-merge
          current
          (tc-inline-payload-layout-type payload)
          (tc-inline-payload-layout-offset payload)
          word-index))]))

(define (lower-register-enum-word-type-variants
  [variants : TcInlineVariantLayoutList]
  [word-index : i64]
  [current : AstType]) : AstType
  (match variants
    [(TcInlineVariantLayoutList.Nil) current]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (match variant
        [(TcInlineVariantLayout.Variant _ _ _ payloads)
          (lower-register-enum-word-type-variants
            (box-get rest)
            word-index
            (lower-register-payload-word-type-fields
              payloads
              word-index
              current))])]))

;; Register-resident aggregate word type for lowering/backend movement. INTEGER
;; words are represented as i64 bit words; SSE eightbytes are represented by f64
;; values, including homogeneous packed f32 words carried opaquely in XMM regs.
(define (lower-register-word-type
  [ctx : TcContext]
  [ty : AstType]
  [word-index : i64]) : AstType
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name)
      (match (tc-inline-aggregate-layout-for-id ctx name)
        [(ResultTcInlineAggregateLayout.Ok layout)
          (match layout
            [(TcInlineAggregateLayout.Struct _ _ fields)
              (lower-register-struct-word-type-fields
                fields
                word-index
                (AstType.I64))]
            [(TcInlineAggregateLayout.Enum _ _ _) (AstType.I64)])]
        [(ResultTcInlineAggregateLayout.Err _) (AstType.I64)])]
    [(AstType.StructArgs name _)
      (lower-register-word-type ctx (AstType.Struct name) word-index)]
    [(AstType.Enum name)
      (if (= word-index 0)
        (AstType.I64)
        (match (tc-inline-aggregate-layout-for-id ctx name)
          [(ResultTcInlineAggregateLayout.Ok layout)
            (match layout
              [(TcInlineAggregateLayout.Enum _ _ variants)
                (lower-register-enum-word-type-variants
                  variants
                  word-index
                  (AstType.I64))]
              [(TcInlineAggregateLayout.Struct _ _ _) (AstType.I64)])]
          [(ResultTcInlineAggregateLayout.Err _) (AstType.I64)]))]
    [(AstType.EnumArgs name _)
      (lower-register-word-type ctx (AstType.Enum name) word-index)]
    [_ (AstType.I64)]))

(define (lower-one-word-register-storage-type [ctx : TcContext] [ty : AstType]) : AstType
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Array _ _) (AstType.U64)]
      [_
        (if (and
          (lower-type-register-resident? ctx resolved)
          (not (lower-type-register-group? ctx resolved)))
          (let
            [word-ty : AstType (lower-register-word-type ctx resolved 0)]
            (match (tc-type-strip-region word-ty)
              [(AstType.F64) word-ty]
              [_ resolved]))
          resolved)])))

(define (lower-type-signed? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [_ false]))

;; Low `size` bytes set to 1 (e.g. size 4 -> 0xffffffff). Used to mask a field
;; to its width before OR-ing it into a packed word. size >= 8 is handled by the
;; callers (no mask needed for a full word).
(define (lower-low-bits-mask [size : i64]) : i64
  (cond
    [(>= size 8) -1]
    [(= size 1) 255]
    [(= size 2) 65535]
    [(= size 3) 16777215]
    [(= size 4) 4294967295]
    [(= size 5) 1099511627775]
    [(= size 6) 281474976710655]
    [(= size 7) 72057594037927935]
    [else -1]))

;; Extract a word-class field from the packed word of a register-resident
;; aggregate. The field occupies bytes [byte-offset, byte-offset+size) of the
;; word; a left shift drops the bytes above it, then a 64-bit arithmetic (signed)
;; or logical (unsigned) right shift moves it to the low bits with the same
;; sign/zero extension a typed memory load would produce.
(define (lower-extract-word-field
  [ctx : TcContext]
  [state : LowerState]
  [word : CompilerIrValue]
  [word-ty : AstType]
  [byte-offset : i64]
  [field-ty : AstType]) : LowerExpr
  (let
    [size : i64 (lower-type-size ctx field-ty)]
    (if (>= size 8)
      (LowerExpr.Expr state word field-ty)
      (let
        [bits : LowerExpr
          (match (tc-type-strip-region field-ty)
            [(AstType.F32)
              (lower-bitcast-value state word word-ty (AstType.U64))]
            [_ (LowerExpr.Expr state word (AstType.U64))])]
        [left : i64 (- 64 (* (+ byte-offset size) 8))]
        [right : i64 (- 64 (* size 8))]
        (match bits
          [(LowerExpr.Expr bits-state bits-value _)
            (let
              [shifted : LowerExpr
                (if (> left 0)
                  (lower-emit-binop
                    bits-state
                    CompilerIrBinOp.Shl
                    bits-value
                    (CompilerIrValue.I64 left)
                    (AstType.I64))
                  (LowerExpr.Expr bits-state bits-value (AstType.I64)))]
              (match shifted
                [(LowerExpr.Expr shl-state shl-value _)
                  (match (lower-emit-binop
                    shl-state
                    CompilerIrBinOp.Shr
                    shl-value
                    (CompilerIrValue.I64 right)
                    (if (lower-type-signed? field-ty)
                      (AstType.I64)
                      (AstType.U64)))
                    [(LowerExpr.Expr shr-state shr-value _)
                      (match (tc-type-strip-region field-ty)
                        [(AstType.F32)
                          (lower-bitcast-value
                            shr-state
                            shr-value
                            (AstType.U64)
                            (AstType.F32))]
                        [_ (LowerExpr.Expr shr-state shr-value field-ty)])])]))])))))

;; OR one field value into the packed-word accumulator: mask it to its byte
;; width (so a sign-extended source cannot bleed into neighbouring fields), shift
;; it to its byte offset, and OR it into `acc`.
(define (lower-pack-word-field
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [value : CompilerIrValue]
  [byte-offset : i64]
  [field-ty : AstType]) : LowerExpr
  (let
    [size : i64 (lower-type-size ctx field-ty)]
    (if (and
      (>= size 8)
      (lower-f64-register-word-field? field-ty byte-offset 0))
      (LowerExpr.Expr state value field-ty)
      (let
        [bits : LowerExpr
          (match (tc-type-strip-region field-ty)
            [(AstType.F32)
              (lower-bitcast-value state value field-ty (AstType.U64))]
            [_ (LowerExpr.Expr state value field-ty)])]
        (match bits
          [(LowerExpr.Expr bits-state bits-value _)
            (let
              [masked : LowerExpr
                (if (>= size 8)
                  (LowerExpr.Expr bits-state bits-value (AstType.U64))
                  (lower-emit-binop
                    bits-state
                    CompilerIrBinOp.BitAnd
                    bits-value
                    (CompilerIrValue.I64 (lower-low-bits-mask size))
                    (AstType.U64)))]
              (match masked
                [(LowerExpr.Expr mask-state mask-value _)
                  (let
                    [shifted : LowerExpr
                      (if (> byte-offset 0)
                        (lower-emit-binop
                          mask-state
                          CompilerIrBinOp.Shl
                          mask-value
                          (CompilerIrValue.I64 (* byte-offset 8))
                          (AstType.I64))
                        (LowerExpr.Expr mask-state mask-value (AstType.U64)))]
                    (match shifted
                      [(LowerExpr.Expr shift-state shift-value _)
                        (lower-emit-binop
                          shift-state
                          CompilerIrBinOp.BitOr
                          acc
                          shift-value
                          (AstType.U64))]))]))])))))

;; Build the packed word for a register-resident struct by folding each field
;; (masked + shifted) into a zero accumulator, in declaration order.
(define (lower-pack-inline-struct-values
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [acc-ty : AstType]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [layout : TcInlineAggregateLayout]) : ResultLowerExpr
  (lower-pack-inline-struct-values-at
    ctx
    state
    acc
    acc-ty
    values
    (& fields)
    0
    layout))

(define (lower-pack-inline-struct-values-at
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [acc-ty : AstType]
  [values : CompilerIrValueList]
  [fields : (& fields AstFieldDefList)]
  [field-index : i64]
  [layout : TcInlineAggregateLayout]) : ResultLowerExpr
  (match (compiler-ir-value-list-force-cons values)
    [(CompilerIrValueList.Nil)
      (if (>= field-index (struct-get fields len))
        (ResultLowerExpr.Ok (LowerExpr.Expr state acc acc-ty))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(CompilerIrValueList.Array seq)
      (lower-pack-inline-struct-values-at
        ctx
        state
        acc
        acc-ty
        (compiler-ir-value-seq-to-list seq)
        fields
        field-index
        layout)]
    [(CompilerIrValueList.Cons value rest-values)
      (if (>= field-index (struct-get fields len))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (match (ast-field-def-list-get
          fields
          field-index
          (ast-field-def-fallback))
          [(AstFieldDef.Def name ty _)
            (let
              [name-str : String (tc-env-key-name-text name)]
              [resolved : AstType (tc-resolve-type ctx ty)]
              [offset : i64
                (tc-inline-aggregate-layout-field-offset-id layout name)]
              (if (< offset 0)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic
                      (string.append
                        "lower: inline struct layout missing field "
                        name-str))))
                (match (lower-pack-word-field
                  ctx
                  state
                  acc
                  value
                  offset
                  resolved)
                  [(LowerExpr.Expr packed-state packed-acc packed-ty)
                    (lower-pack-inline-struct-values-at
                      ctx
                      packed-state
                      packed-acc
                      packed-ty
                      (box-get rest-values)
                      fields
                      (+ field-index 1)
                      layout)])))]))]))

;; Emit an CompilerIrInstr.Pack forming a register-group value from its word values.
(define (lower-emit-pack
  [state : LowerState]
  [words : CompilerIrValueList]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (LowerExpr.Expr
        (lower-state-emit allocated (CompilerIrInstr.Pack var-id words ty))
        (CompilerIrValue.Var var-id)
        ty)]))

;; Emit an CompilerIrInstr.Word extracting word `index` of a register-group value.
(define (lower-emit-word
  [state : LowerState]
  [group : CompilerIrValue]
  [index : i64]
  [word-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (LowerExpr.Expr
        (lower-state-emit
          allocated
          (CompilerIrInstr.Word var-id group index word-ty))
        (CompilerIrValue.Var var-id)
        word-ty)]))

(define (lower-register-word-sse-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.F64) true]
    [_ false]))

(define (lower-materialize-register-word
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [word-ty : AstType]) : LowerExpr
  (if (tc-type-eq from-ty word-ty)
    (LowerExpr.Expr state value word-ty)
    (if (lower-register-word-sse-type? word-ty)
      (lower-bitcast-value state value (AstType.U64) word-ty)
      (LowerExpr.Expr state value word-ty))))

;; `=` / `!=` on a 2-word register-group aggregate must compare BOTH
;; words; the scalar CompilerIrInstr.BinOp compared only word0, so two enum values with
;; equal tags but different payloads compared equal.
(define (lower-binop-group-eq? [op : AstBinOp]) : bool
  (match op
    [(AstBinOp.Eq) true]
    [(AstBinOp.Ne) true]
    [_ false]))

(define (lower-group-equality
  [ctx : TcContext]
  [state : LowerState]
  [op : AstBinOp]
  [left : CompilerIrValue]
  [right : CompilerIrValue]
  [group-ty : AstType]
  [expr-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-emit-word
    state
    left
    0
    (lower-register-word-type ctx group-ty 0))
    [(LowerExpr.Expr ls0 l0 _)
      (match (lower-emit-word
        ls0
        left
        1
        (lower-register-word-type ctx group-ty 1))
        [(LowerExpr.Expr ls1 l1 _)
          (match (lower-emit-word
            ls1
            right
            0
            (lower-register-word-type ctx group-ty 0))
            [(LowerExpr.Expr rs0 r0 _)
              (match (lower-emit-word
                rs0
                right
                1
                (lower-register-word-type ctx group-ty 1))
                [(LowerExpr.Expr rs1 r1 _)
                  (match (lower-state-alloc-var rs1)
                    [(LowerAlloc.Alloc alloc0 word0-cmp)
                      (match (lower-state-alloc-var alloc0)
                        [(LowerAlloc.Alloc alloc1 word1-cmp)
                          (match (lower-state-alloc-var alloc1)
                            [(LowerAlloc.Alloc alloc2 combined)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr
                                  (lower-state-emit-at-expr
                                    (lower-state-emit
                                      (lower-state-emit
                                        alloc2
                                        (CompilerIrInstr.BinOp
                                          word0-cmp
                                          (lower-binop op)
                                          l0
                                          r0
                                          (lower-register-word-type
                                            ctx
                                            group-ty
                                            0)))
                                      (CompilerIrInstr.BinOp
                                        word1-cmp
                                        (lower-binop op)
                                        l1
                                        r1
                                        (lower-register-word-type
                                          ctx
                                          group-ty
                                          1)))
                                    (CompilerIrInstr.BinOp
                                      combined
                                      ;; eq: both words equal; ne: either differs.
                                      (match op
                                        [(AstBinOp.Ne) CompilerIrBinOp.BitOr]
                                        [_ CompilerIrBinOp.BitAnd])
                                      (CompilerIrValue.Var word0-cmp)
                                      (CompilerIrValue.Var word1-cmp)
                                      expr-ty)
                                    origin)
                                  (CompilerIrValue.Var combined)
                                  expr-ty))])])])])])])]))

;; Read a payload field of a register-group enum scrutinee. `base` is the
;; enum group var; the field at enum byte `offset` lives in word `offset/8` (the
;; payload word for a 16-byte enum), extracted with CompilerIrInstr.Word then shift/mask at
;; its relative offset.
(define (lower-read-register-group-payload
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [base-ty : AstType]
  [offset : i64]
  [field-ty : AstType]) : LowerExpr
  (match (lower-emit-word
    state
    base
    (/ offset 8)
    (lower-register-word-type ctx base-ty (/ offset 8)))
    [(LowerExpr.Expr w-state w-value _)
      (lower-extract-word-field
        ctx
        w-state
        w-value
        (lower-register-word-type ctx base-ty (/ offset 8))
        (- offset (* (/ offset 8) 8))
        field-ty)]))

;; Store a 2-word register-group `value` to memory at pointer `ptr`
;; (word0 at [ptr], word1 at [ptr+8]) -- used when a group is embedded in a
;; pointer-addressed container (array element, dynarray, box, ...).
(define (lower-store-group-at-ptr
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [ty : AstType]) : LowerState
  (match (lower-emit-word state value 0 (lower-register-word-type ctx ty 0))
    [(LowerExpr.Expr s0 w0 _)
      (match (lower-emit-word s0 value 1 (lower-register-word-type ctx ty 1))
        [(LowerExpr.Expr s1 w1 _)
          (match (lower-gep-byte
            (lower-state-emit
              s1
              (CompilerIrInstr.StorePtr
                ptr
                w0
                (lower-register-word-type ctx ty 0)))
            ptr
            8)
            [(LowerExpr.Expr s2 ptr8 _)
              (lower-state-emit
                s2
                (CompilerIrInstr.StorePtr
                  ptr8
                  w1
                  (lower-register-word-type ctx ty 1)))])])]))

;; Load a 2-word register-group from memory at pointer `ptr` and reassemble
;; it with CompilerIrInstr.Pack (word0 from [ptr], word1 from [ptr+8]).
(define (lower-load-group-from-ptr
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (match (lower-load-at-offset state ptr 0 (lower-register-word-type ctx ty 0))
    [(LowerExpr.Expr s0 w0 _)
      (match (lower-load-at-offset s0 ptr 8 (lower-register-word-type ctx ty 1))
        [(LowerExpr.Expr s1 w1 _)
          (lower-emit-pack
            s1
            (compiler-ir-value-cons
              w0
              (compiler-ir-value-cons w1 CompilerIrValueList.Nil))
            ty)])]))

;; Internal descriptor-pair transport. Source String/DynArray values remain
;; one-word pointers; only values built by this helper become structural
;; Pack/Word groups. The pair order matches descriptor storage exactly:
;; data_ptr in word0, nonnegative length in word1.
(define (lower-load-register-resident-from-ptr
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (if (lower-type-register-group? ctx ty)
    (lower-load-group-from-ptr ctx state ptr ty)
    (match (lower-load-at-offset
      state
      ptr
      0
      (lower-register-word-type ctx ty 0))
      [(LowerExpr.Expr load-state loaded _)
        (LowerExpr.Expr load-state loaded ty)])))

;; Build the packed value for ONE machine word (`word-index`) of a
;; register-group struct: fold in only the fields that live in that word, each at
;; its offset RELATIVE to the word base, leaving an all-zero accumulator for words
;; with no field. Fields straddling a word boundary cannot occur for word-class
;; fields in a C-layout aggregate (each is naturally aligned within a word).
(define (lower-pack-inline-struct-word
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [acc-ty : AstType]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [layout : TcInlineAggregateLayout]
  [word-index : i64]) : ResultLowerExpr
  (lower-pack-inline-struct-word-at
    ctx
    state
    acc
    acc-ty
    values
    (& fields)
    0
    layout
    word-index))

(define (lower-pack-inline-struct-word-at
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [acc-ty : AstType]
  [values : CompilerIrValueList]
  [fields : (& fields AstFieldDefList)]
  [field-index : i64]
  [layout : TcInlineAggregateLayout]
  [word-index : i64]) : ResultLowerExpr
  (match (compiler-ir-value-list-force-cons values)
    [(CompilerIrValueList.Nil)
      (if (>= field-index (struct-get fields len))
        (ResultLowerExpr.Ok (LowerExpr.Expr state acc acc-ty))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(CompilerIrValueList.Array seq)
      (lower-pack-inline-struct-word-at
        ctx
        state
        acc
        acc-ty
        (compiler-ir-value-seq-to-list seq)
        fields
        field-index
        layout
        word-index)]
    [(CompilerIrValueList.Cons value rest-values)
      (if (>= field-index (struct-get fields len))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (match (ast-field-def-list-get
          fields
          field-index
          (ast-field-def-fallback))
          [(AstFieldDef.Def name ty _)
            (let
              [name-str : String (tc-env-key-name-text name)]
              [resolved : AstType (tc-resolve-type ctx ty)]
              [offset : i64
                (tc-inline-aggregate-layout-field-offset-id layout name)]
              (if (< offset 0)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic
                      (string.append
                        "lower: inline struct layout missing field "
                        name-str))))
                (if (= (/ offset 8) word-index)
                  (match (lower-pack-word-field
                    ctx
                    state
                    acc
                    value
                    (- offset (* word-index 8))
                    resolved)
                    [(LowerExpr.Expr packed-state packed-acc packed-ty)
                      (lower-pack-inline-struct-word-at
                        ctx
                        packed-state
                        packed-acc
                        packed-ty
                        (box-get rest-values)
                        fields
                        (+ field-index 1)
                        layout
                        word-index)])
                  (lower-pack-inline-struct-word-at
                    ctx
                    state
                    acc
                    acc-ty
                    (box-get rest-values)
                    fields
                    (+ field-index 1)
                    layout
                    word-index))))]))]))

;; Construct a register-group struct value: pack each machine word and
;; combine them with IrInstrPack. Two-word integer-class structs only.
(define (lower-construct-struct-register-group
  [ctx : TcContext]
  [state : LowerState]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [layout : TcInlineAggregateLayout]
  [struct-ty : AstType]) : ResultLowerExpr
  (match (lower-pack-inline-struct-word
    ctx
    state
    (CompilerIrValue.I64 0)
    (AstType.I64)
    values
    fields
    layout
    0)
    [(ResultLowerExpr.Ok (LowerExpr.Expr s0 raw-word0 raw-ty0))
      (match (lower-materialize-register-word
        s0
        raw-word0
        raw-ty0
        (lower-register-word-type ctx struct-ty 0))
        [(LowerExpr.Expr w0-state word0 _)
          (match (lower-pack-inline-struct-word
            ctx
            w0-state
            (CompilerIrValue.I64 0)
            (AstType.I64)
            values
            fields
            layout
            1)
            [(ResultLowerExpr.Ok (LowerExpr.Expr s1 raw-word1 raw-ty1))
              (match (lower-materialize-register-word
                s1
                raw-word1
                raw-ty1
                (lower-register-word-type ctx struct-ty 1))
                [(LowerExpr.Expr w1-state word1 _)
                  (match (lower-emit-pack
                    w1-state
                    (compiler-ir-value-cons
                      word0
                      (compiler-ir-value-cons word1 CompilerIrValueList.Nil))
                    struct-ty)
                    [(LowerExpr.Expr ps pv _)
                      (ResultLowerExpr.Ok (LowerExpr.Expr ps pv struct-ty))])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; Fold a register-group enum variant's payload values into word1 (the
;; payload word), each field masked + shifted to its offset RELATIVE to the
;; payload word (payload starts at enum byte 8, i.e. relative offset 0).
(define (lower-pack-enum-payload-word
  [ctx : TcContext]
  [state : LowerState]
  [acc : CompilerIrValue]
  [acc-ty : AstType]
  [cursor : i64]
  [values : CompilerIrValueList]
  [fields : AstTypeList]) : ResultLowerExpr
  (match (compiler-ir-value-list-force-cons values)
    [(CompilerIrValueList.Nil)
      (ResultLowerExpr.Ok (LowerExpr.Expr state acc acc-ty))]
    [(CompilerIrValueList.Array seq)
      (lower-pack-enum-payload-word
        ctx
        state
        acc
        acc-ty
        cursor
        (compiler-ir-value-seq-to-list seq)
        fields)]
    [(CompilerIrValueList.Cons value rest-values)
      (if (ast-type-list-empty? (& fields))
        (ResultLowerExpr.Err
          (box (lower-diagnostic "lower: enum payload arity mismatch")))
        (let
          [ty-id : i64 (ast-type-list-get (& fields) 0 (ast-type-id-fallback))]
          [rest-fields : AstTypeList (ast-type-list-slice fields 1)]
          [resolved : AstType
            (tc-resolve-type ctx (tc-context-type-get ctx ty-id))]
          [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
          (match (lower-pack-word-field ctx state acc value offset resolved)
            [(LowerExpr.Expr packed-state packed-acc packed-ty)
              (lower-pack-enum-payload-word
                ctx
                packed-state
                packed-acc
                packed-ty
                (+ offset (lower-type-size ctx resolved))
                (box-get rest-values)
                rest-fields)])))]))

;; Construct a register-group enum value: word0 = discriminant tag, word1 =
;; the variant's packed (word-class) payload (0 for a nullary variant).
(define (lower-construct-enum-register-group
  [ctx : TcContext]
  [state : LowerState]
  [handle : i64]
  [values : CompilerIrValueList]
  [fields : AstTypeList]
  [enum-ty : AstType]) : ResultLowerExpr
  (match (lower-pack-enum-payload-word
    ctx
    state
    (CompilerIrValue.I64 0)
    (AstType.I64)
    0
    values
    fields)
    [(ResultLowerExpr.Ok (LowerExpr.Expr s1 raw-word1 raw-ty1))
      (match (lower-materialize-register-word
        s1
        raw-word1
        raw-ty1
        (lower-register-word-type ctx enum-ty 1))
        [(LowerExpr.Expr w1-state word1 _)
          (match (lower-emit-pack
            w1-state
            (compiler-ir-value-cons
              (CompilerIrValue.I64
                (compiler-registry-handle-child-index handle))
              (compiler-ir-value-cons word1 CompilerIrValueList.Nil))
            enum-ty)
            [(LowerExpr.Expr ps pv _)
              (ResultLowerExpr.Ok (LowerExpr.Expr ps pv enum-ty))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-store-inline-value-at-offset
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [value : CompilerIrValue]
  [ty : AstType]
  [size : i64]) : LowerState
  ;; A register-resident aggregate is carried as a word, so embedding it
  ;; in a memory aggregate is a scalar store of that word, not a byte-copy from a
  ;; pointer. A 2-word register-group stores BOTH words (word0 at offset, word1 at
  ;; offset+8). Only a genuine memory aggregate (inline struct/enum that is not
  ;; register-resident) needs the byte-copy.
  (if (and
    (lower-type-inline-storage? ctx ty)
    (not (lower-type-register-resident? ctx ty)))
    (lower-copy-bytes state base offset value 0 size)
    (if (lower-type-register-group? ctx ty)
      (match (lower-emit-word state value 0 (lower-register-word-type ctx ty 0))
        [(LowerExpr.Expr s0 w0 _)
          (match (lower-emit-word
            s0
            value
            1
            (lower-register-word-type ctx ty 1))
            [(LowerExpr.Expr s1 w1 _)
              (lower-store-at-offset
                (lower-store-at-offset
                  s1
                  base
                  offset
                  w0
                  (lower-register-word-type ctx ty 0))
                base
                (+ offset 8)
                w1
                (lower-register-word-type ctx ty 1))])])
      (lower-store-at-offset
        state
        base
        offset
        value
        (if (lower-type-register-resident? ctx ty)
          (lower-register-word-type ctx ty 0)
          ty)))))

(define (lower-load-inline-value-at-offset
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [ty : AstType]
  [mode : CompilerLowerMode]) : LowerExpr
  ;; A register-resident aggregate field is loaded as a word (a scalar
  ;; load), not returned as a pointer into the containing slot. A 2-word
  ;; register-group loads BOTH words and reassembles them with IrInstrPack. Only a
  ;; genuine memory aggregate keeps the pointer-return shape.
  (cond
    [(and
        (lower-mode-inline-aggregates? mode)
        (lower-type-inline-storage? ctx ty)
        (not (lower-type-register-resident? ctx ty)))
      (match (lower-gep-byte state base offset)
        [(LowerExpr.Expr ptr-state ptr _) (LowerExpr.Expr ptr-state ptr ty)])]
    [(lower-type-register-group? ctx ty)
      (match (lower-load-at-offset
        state
        base
        offset
        (lower-register-word-type ctx ty 0))
        [(LowerExpr.Expr s0 w0 _)
          (match (lower-load-at-offset
            s0
            base
            (+ offset 8)
            (lower-register-word-type ctx ty 1))
            [(LowerExpr.Expr s1 w1 _)
              (lower-emit-pack
                s1
                (compiler-ir-value-cons
                  w0
                  (compiler-ir-value-cons w1 CompilerIrValueList.Nil))
                ty)])])]
    [(lower-type-register-resident? ctx ty)
      (match (lower-load-at-offset
        state
        base
        offset
        (lower-register-word-type ctx ty 0))
        [(LowerExpr.Expr load-state loaded _)
          (LowerExpr.Expr load-state loaded ty)])]
    [else (lower-load-at-offset state base offset ty)]))

(define (lower-copy-bytes-compact
  [state : LowerState]
  [dst : CompilerIrValue]
  [dst-offset : i64]
  [src : CompilerIrValue]
  [src-offset : i64]
  [size : i64]) : LowerState
  (if (<= size 0)
    state
    (if (and (= dst-offset 0) (= src-offset 0))
      (lower-state-emit state (CompilerIrInstr.CopyBytes dst src size))
      (lower-copy-bytes state dst dst-offset src src-offset size))))

(define (lower-inline-aggregate-copy-size [ctx : TcContext] [ty : AstType]) : ResultLowerSize
  (match (tc-inline-aggregate-type-layout ctx ty)
    [(ResultTcLayoutInfo.Ok info)
      (match info
        [(TcLayoutInfo size _) (ResultLowerSize.Ok size)])]
    [(ResultTcLayoutInfo.Err message) (ResultLowerSize.Err message)]))

(define (lower-copy-inline-aggregate-to-inline
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (match (lower-inline-aggregate-copy-size ctx ty)
    [(ResultLowerSize.Ok size)
      (match (lower-reserve-inline-storage state size ty)
        [(LowerExpr.Expr copy-state copy-value _)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              ;; A register-resident source is carried as word(s), so
              ;; materialize via the group-aware store -- a 2-word group must
              ;; write BOTH words (a bare scalar store dropped word1).
              (if (lower-type-register-resident? ctx ty)
                (lower-store-inline-value-at-offset
                  ctx
                  copy-state
                  copy-value
                  0
                  value
                  ty
                  size)
                (lower-copy-bytes-compact copy-state copy-value 0 value 0 size))
              copy-value
              ty))])]
    [(ResultLowerSize.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic message)))]))

(define (lower-copy-inline-aggregate-to-heap-as
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]
  [storage-ty : AstType]) : ResultLowerExpr
  (match (lower-inline-aggregate-copy-size ctx ty)
    [(ResultLowerSize.Ok size)
      (match (lower-reserve-heap-storage state size storage-ty)
        [(LowerExpr.Expr copy-state copy-value _)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              ;; Group-aware store here too -- the Win64 C-ABI byref
              ;; path spills register-resident aggregates through this copy,
              ;; and a 2-word group must write BOTH words.
              (if (lower-type-register-resident? ctx ty)
                (lower-store-inline-value-at-offset
                  ctx
                  copy-state
                  copy-value
                  0
                  value
                  ty
                  size)
                (lower-copy-bytes-compact copy-state copy-value 0 value 0 size))
              copy-value
              storage-ty))])]
    [(ResultLowerSize.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic message)))]))

(define (lower-copy-inline-aggregate-to-heap
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (lower-copy-inline-aggregate-to-heap-as ctx state value ty ty))

(define (lower-inline-aggregate-abi-copy-needed?
  [ctx : TcContext]
  [state : LowerState]
  [ty : AstType]) : bool
  (and
    (lower-mode-inline-aggregates? (lower-state-mode state))
    ;; A register-resident aggregate is returned/passed in a register,
    ;; so it needs neither a heap escape-copy nor a caller-provided sret slot.
    (lower-type-inline-storage? ctx ty)
    (not (lower-type-register-resident? ctx ty))))

(define (lower-return-abi-value
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (if (lower-inline-aggregate-abi-copy-needed? ctx state ty)
    (lower-copy-inline-aggregate-to-heap ctx state value ty)
    (ResultLowerExpr.Ok (LowerExpr.Expr state value ty))))

(define (lower-raw-pointer-ir-type [ty : AstType]) : AstType
  (match (tc-type-strip-region ty)
    [(AstType.Ptr _) (AstType.U64)]
    [(AstType.MutPtr _) (AstType.U64)]
    [_ ty]))

(define (lower-cast-value
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : LowerExpr
  (let
    [ir-from-ty : AstType (lower-raw-pointer-ir-type from-ty)]
    [ir-to-ty : AstType (lower-raw-pointer-ir-type to-ty)]
    (if (or (tc-type-eq from-ty to-ty) (tc-type-eq ir-from-ty ir-to-ty))
      (LowerExpr.Expr state value to-ty)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (LowerExpr.Expr
            (lower-state-emit
              allocated
              (CompilerIrInstr.Cast var-id value ir-from-ty ir-to-ty))
            (CompilerIrValue.Var var-id)
            to-ty)]))))

(define (lower-bitcast-value
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : LowerExpr
  (if (tc-type-eq from-ty to-ty)
    (LowerExpr.Expr state value to-ty)
    (match (lower-state-alloc-var state)
      [(LowerAlloc.Alloc allocated var-id)
        (LowerExpr.Expr
          (lower-state-emit
            allocated
            (CompilerIrInstr.Bitcast var-id value from-ty to-ty))
          (CompilerIrValue.Var var-id)
          to-ty)])))

(define (lower-coerce-value
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : LowerExpr
  (cond
    [(tc-never-type? from-ty) (LowerExpr.Expr state value from-ty)]
    [(tc-type-eq from-ty to-ty) (LowerExpr.Expr state value to-ty)]
    [(tc-type-compatible? to-ty from-ty)
      (lower-cast-value state value from-ty to-ty)]
    [else (LowerExpr.Expr state value to-ty)]))

(define (lower-oob-abort [state : LowerState]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (lower-state-emit
        allocated
        (CompilerIrInstr.Call
          var-id
          (lower-tl-oob-abort-symbol)
          (CompilerIrCallArgs.Nil)
          (AstType.Unit)))]))

(define (lower-shift-abort [state : LowerState]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (lower-state-emit
        allocated
        (CompilerIrInstr.Call
          var-id
          (lower-tl-shift-abort-symbol)
          (CompilerIrCallArgs.Nil)
          (AstType.Unit)))]))

(define (lower-string-fields [state : LowerState] [value : CompilerIrValue]) : LowerStringFields
  (match (lower-load-at-offset state value 0 (AstType.U64))
    [(LowerExpr.Expr ptr-state ptr _)
      (match (lower-load-at-offset ptr-state value 8 (AstType.I64))
        [(LowerExpr.Expr len-state len _)
          (LowerStringFields.Fields len-state ptr len)])]))

(define (lower-str-ref-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Ref _ inner)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(AstType.Str) true]
        [_ false])]
    [_ false]))

(define (lower-bytes-ref-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Ref _ inner)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(AstType.Bytes) true]
        [_ false])]
    [(AstType.MutRef _ inner)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(AstType.Bytes) true]
        [_ false])]
    [_ false]))

(define (lower-string-handle-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.String) true]
    [_ (lower-str-ref-type? ctx ty)]))

(define (lower-bytes-handle-type? [ctx : TcContext] [ty : AstType]) : bool
  (lower-bytes-ref-type? ctx ty))

(define (lower-length-handle-type? [ctx : TcContext] [ty : AstType]) : bool
  (or (lower-string-handle-type? ctx ty) (lower-bytes-handle-type? ctx ty)))

(define (lower-string-concat-legacy-name? [name : String]) : bool
  (or (string.eq name "string-append") (string.eq name "string-concat")))

(define (lower-string-concat-public-target? [name : String]) : bool
  ;; Dotted imports resolve to module-key names before direct-call lowering.
  ;; Match that identity instead of the source spelling, so aliases remain
  ;; eligible while same-shaped user functions remain ordinary calls.
  (or
    (string.eq name (compiler-symbol-module-key "stdlib.string" "append"))
    (string.eq name (compiler-symbol-module-key "stdlib.string" "concat"))))

(define (lower-string-concat-public-source-name? [name : String]) : bool
  ;; These canonical spellings dominate compiler source and must not re-run
  ;; dotted-import resolution at every node of one deep tree. A local binding
  ;; is still rejected by the caller before this fast path is used.
  (or
    (string.eq name "string.append")
    (string.eq name "string.concat")
    (string.eq name "stdlib.string.append")
    (string.eq name "stdlib.string.concat")))

;; A tail call first runs direct-call/TCO eligibility checks over its arguments.
;; Those checks typecheck the whole argument subtree, which is needlessly
;; expensive for a concat tree that will lower to runtime calls rather than a
;; tail call. Recognize the public concat target once at the root and take the
;; ordinary return-expression path directly.
(define (lower-string-concat-call-source?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]) : bool
  (let
    [source-id : i64 (macro-hygiene-global-source-name-id-or name-id name-id)]
    [raw-name : String (intern-str source-id)]
    (and
      (not (tc-dotted-local-field-name-id? type-env source-id))
      (or
        (and
          (lower-string-concat-legacy-name? raw-name)
          (lower-builtin-call-available-id? ctx env name-id))
        (match (lower-source-name-lookup-key-id ctx type-env source-id)
          [(ResultTcString.Ok lookup-name)
            (lower-string-concat-public-target? lookup-name)]
          [(ResultTcString.Err _) false])))))

(define (lower-string-concat-call-parts
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : LowerMaybeStringConcatCall
  (match (ast-expr-unspan-with-pools (tc-context-pools ctx) expr)
    [(AstExpr.Call callee-box args)
      (match (ast-expr-unspan-with-pools
        (tc-context-pools ctx)
        (tc-context-expr-get ctx callee-box))
        [(AstExpr.Var name)
          (let
            [raw-name-id : i64
              (macro-hygiene-global-source-name-id-or name name)]
            [raw-name : String (intern-str raw-name-id)]
            (if (= (struct-get (& args) len) 2)
              (if (or
                (and
                  (lower-string-concat-public-source-name? raw-name)
                  (not (tc-dotted-local-field-name-id? type-env raw-name-id))
                  (not (sym_i64_env.sym-i64-contains-id env raw-name-id))
                  (not (lower-top-level-value-defined-id? ctx raw-name-id)))
                (and
                  (lower-string-concat-legacy-name? raw-name)
                  (lower-builtin-call-available-id? ctx env name))
                (match (lower-source-name-lookup-key-id
                  ctx
                  type-env
                  raw-name-id)
                  [(ResultTcString.Ok lookup-name)
                    (lower-string-concat-public-target? lookup-name)]
                  [(ResultTcString.Err _) false]))
                (LowerMaybeStringConcatCall.Some
                  (ast-expr-list-get (& args) 0 0)
                  (ast-expr-list-get (& args) 1 0))
                (LowerMaybeStringConcatCall.No))
              (LowerMaybeStringConcatCall.No)))]
        [_ (LowerMaybeStringConcatCall.No)])]
    [_ (LowerMaybeStringConcatCall.No)]))

(define (lower-string-concat-work-pop [pending : (&mut pending AstExprList)]) : i64
  (let
    [index : i64 (- (struct-get pending len) 1)]
    (begin
      (set! (struct-get pending len) index)
      (array-ref (struct-get pending slots) index))))

;; Flatten the complete binary concat tree without recursively lowering its
;; children. The explicit LIFO worklist pushes right before left, preserving
;; source evaluation order without the retained LowerState chain that made deep
;; left/right trees grow superlinearly.
(define (lower-string-concat-exprs-all
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : AstExprList
  (let
    [pending : AstExprList (ast-expr-list-with-capacity 16)]
    [out : AstExprList (ast-expr-list-with-capacity 16)]
    (begin
      (ast-expr-list-push (&mut pending) (ast-expr-list-get (& exprs) 1 0))
      (ast-expr-list-push (&mut pending) (ast-expr-list-get (& exprs) 0 0))
      (while (not (ast-expr-list-empty? (& pending)))
        (let
          [expr-id : i64 (lower-string-concat-work-pop (&mut pending))]
          [expr : AstExpr (tc-context-expr-get ctx expr-id)]
          (begin
            (match (lower-string-concat-call-parts ctx env type-env expr)
              [(LowerMaybeStringConcatCall.Some nested-left nested-right)
                (begin
                  (ast-expr-list-push (&mut pending) nested-right)
                  (ast-expr-list-push (&mut pending) nested-left))]
              [(LowerMaybeStringConcatCall.No)
                (ast-expr-list-push (&mut out) expr-id)])
            unit)))
      out)))

(define (lower-string-concat-runtime-name [count : i64]) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    (cond
      [(= count 3) cbi.compiler-builtin-id-tl-string-concat3]
      [(= count 4) cbi.compiler-builtin-id-tl-string-concat4]
      [(= count 5) cbi.compiler-builtin-id-tl-string-concat5]
      [else cbi.compiler-builtin-id-tl-string-concat])))

(define (lower-string-concat-values-rev-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [end : i64]
  [acc : CompilerIrValueList]
  [count : i64]) : ResultLowerStringValues
  (if (>= index end)
    (ResultLowerStringValues.Ok state acc count)
    (let
      [expr : AstExpr
        (tc-context-expr-get ctx (ast-expr-list-get exprs index 0))]
      (match (lower-expr ctx state env type-env expr)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr expr-state value expr-ty)
              (if (lower-string-handle-type? ctx expr-ty)
                (match (lower-string-fields expr-state value)
                  [(LowerStringFields.Fields field-state ptr len)
                    (lower-string-concat-values-rev-at
                      ctx
                      field-state
                      env
                      type-env
                      exprs
                      (+ index 1)
                      end
                      (compiler-ir-value-cons-linked
                        len
                        (compiler-ir-value-cons-linked ptr acc))
                      (+ count 1))])
                (ResultLowerStringValues.Err
                  (box
                    (lower-diagnostic-at-expr
                      expr
                      "lower: string-concat requires String"))))])]
        [(ResultLowerExpr.Err message) (ResultLowerStringValues.Err message)]))))

(define (lower-string-concat-emit
  [state : LowerState]
  [values-rev : CompilerIrValueList]
  [count : i64]) : LowerExpr
  (begin
    (cfg
      compile-profile
      (set!
        compiler-lower-profile-string-concat-runtime-calls
        (+ compiler-lower-profile-string-concat-runtime-calls 1)))
    (match (lower-state-alloc-var state)
      [(LowerAlloc.Alloc allocated var-id)
        (LowerExpr.Expr
          (lower-state-emit
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-string-concat-runtime-name count)
              (compiler-ir-call-args-from-list
                (compiler-ir-value-list-reverse-onto
                  values-rev
                  CompilerIrValueList.Nil))
              (AstType.String)))
          (CompilerIrValue.Var var-id)
          (AstType.String))])))

(define (lower-string-concat-exprs-batched-group
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [end : i64]
  [acc : CompilerIrValueList]
  [count : i64]) : ResultLowerExpr
  (match (lower-string-concat-values-rev-at
    ctx
    state
    env
    type-env
    exprs
    index
    end
    acc
    count)
    [(ResultLowerStringValues.Ok values-state values-rev value-count)
      (match (lower-string-concat-emit values-state values-rev value-count)
        [(LowerExpr.Expr call-state call-value _)
          (lower-string-concat-exprs-batched
            ctx
            call-state
            env
            type-env
            exprs
            end
            (LowerMaybeIrValue.Some call-value))])]
    [(ResultLowerStringValues.Err message) (ResultLowerExpr.Err message)]))

(define (lower-string-concat-exprs-batched
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [carry : LowerMaybeIrValue]) : ResultLowerExpr
  (let
    [remaining : i64 (- (struct-get exprs len) index)]
    (if (<= remaining 0)
      (match carry
        [(LowerMaybeIrValue.Some value)
          (ResultLowerExpr.Ok (LowerExpr.Expr state value (AstType.String)))]
        [(LowerMaybeIrValue.No)
          (ResultLowerExpr.Err
            (box (lower-diagnostic "lower: string-concat requires arguments")))])
      (match carry
        [(LowerMaybeIrValue.No)
          (let
            [take : i64
              (if (> remaining 5)
                5
                remaining)]
            (lower-string-concat-exprs-batched-group
              ctx
              state
              env
              type-env
              exprs
              index
              (+ index take)
              CompilerIrValueList.Nil
              0))]
        [(LowerMaybeIrValue.Some value)
          (match (lower-string-fields state value)
            [(LowerStringFields.Fields carry-state ptr len)
              (let
                [take : i64
                  (if (> remaining 4)
                    4
                    remaining)]
                (lower-string-concat-exprs-batched-group
                  ctx
                  carry-state
                  env
                  type-env
                  exprs
                  index
                  (+ index take)
                  (compiler-ir-value-cons-linked
                    len
                    (compiler-ir-value-cons-linked ptr CompilerIrValueList.Nil))
                  1))])]))))

(define (lower-string-concat-exprs
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : ResultLowerExpr
  (begin
    (cfg
      compile-profile
      (begin
        (set!
          compiler-lower-profile-string-concat-trees
          (+ compiler-lower-profile-string-concat-trees 1))
        (set!
          compiler-lower-profile-string-concat-leaves
          (+
            compiler-lower-profile-string-concat-leaves
            (struct-get (& exprs) len)))))
    (lower-string-concat-exprs-batched
      ctx
      state
      env
      type-env
      (& exprs)
      0
      (LowerMaybeIrValue.No))))

(define (lower-supported-reference-referent-type?
  [ctx : TcContext]
  [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.F64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.F32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Str) true]
    [(AstType.Bytes) true]
    [(AstType.Tuple elems)
      (lower-supported-reference-type-list-with-stack?
        ctx
        (box-get elems)
        LowerIdSet.Nil)]
    [(AstType.Array elem-ty _)
      (not (tc-type-contains-reference? (tc-context-type-get ctx elem-ty)))]
    [(AstType.DynArray elem-ty)
      (not (tc-type-contains-reference? (tc-context-type-get ctx elem-ty)))]
    [(AstType.Struct name)
      (lower-supported-reference-struct-args-with-stack?
        ctx
        name
        (ast-lifetime-list-new)
        LowerIdSet.Nil)]
    [(AstType.StructArgs name lifetimes)
      (lower-supported-reference-struct-args-with-stack?
        ctx
        name
        (box-get lifetimes)
        LowerIdSet.Nil)]
    [(AstType.Enum name)
      (lower-supported-reference-enum-args-with-stack?
        ctx
        name
        (ast-lifetime-list-new)
        LowerIdSet.Nil)]
    [(AstType.EnumArgs name lifetimes)
      (lower-supported-reference-enum-args-with-stack?
        ctx
        name
        (box-get lifetimes)
        LowerIdSet.Nil)]
    [_ false]))

(define (lower-borrow-place-value-reference? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (if (lower-type-register-resident? ctx resolved)
      false
      (match resolved
        [(AstType.Tuple _) true]
        [(AstType.Array _ _) true]
        [(AstType.DynArray _) true]
        [(AstType.Struct _) true]
        [(AstType.StructArgs _ _) true]
        [(AstType.Enum _) true]
        [(AstType.EnumArgs _ _) true]
        [_ false]))))

(define (lower-supported-reference-type-list-with-stack?
  [ctx : TcContext]
  [types : AstTypeList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-type-list-with-stack-at? ctx (& types) stack 0))

(define (lower-supported-reference-type-list-with-stack-at?
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    true
    (and
      (lower-supported-reference-type-with-stack?
        ctx
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))
        stack)
      (lower-supported-reference-type-list-with-stack-at?
        ctx
        types
        stack
        (+ index 1)))))

(define (lower-supported-reference-type-list-subst-with-stack?
  [ctx : TcContext]
  [subst : TcLifetimeSubst]
  [types : AstTypeList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-type-list-subst-with-stack-at?
    ctx
    subst
    (& types)
    stack
    0))

(define (lower-supported-reference-type-list-subst-with-stack-at?
  [ctx : TcContext]
  [subst : TcLifetimeSubst]
  [types : (& types AstTypeList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    true
    (and
      (lower-supported-reference-type-with-stack?
        ctx
        (tc-lifetime-subst-type
          subst
          (tc-context-type-get
            ctx
            (ast-type-list-get types index (ast-type-id-fallback))))
        stack)
      (lower-supported-reference-type-list-subst-with-stack-at?
        ctx
        subst
        types
        stack
        (+ index 1)))))

(define (lower-supported-reference-field-list-with-stack?
  [ctx : TcContext]
  [subst : TcLifetimeSubst]
  [fields : AstFieldDefList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-field-list-with-stack-at?
    ctx
    subst
    (& fields)
    stack
    0))

(define (lower-supported-reference-field-list-with-stack-at?
  [ctx : TcContext]
  [subst : TcLifetimeSubst]
  [fields : (& fields AstFieldDefList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (struct-get fields len))
    true
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def _ ty _)
        (and
          (lower-supported-reference-type-with-stack?
            ctx
            (tc-lifetime-subst-type subst ty)
            stack)
          (lower-supported-reference-field-list-with-stack-at?
            ctx
            subst
            fields
            stack
            (+ index 1)))])))

(define (lower-supported-reference-variant-list-with-stack?
  [ctx : TcContext]
  [subst : TcLifetimeSubst]
  [variants : AstVariantDefList]
  [stack : LowerIdSet]) : bool
  (lower-supported-reference-variant-list-with-stack-at?
    ctx
    subst
    (& variants)
    stack
    0))

(define (lower-supported-reference-variant-list-with-stack-at?
  [ctx : TcContext]
  [subst : TcLifetimeSubst]
  [variants : (& variants AstVariantDefList)]
  [stack : LowerIdSet]
  [index : i64]) : bool
  (if (>= index (struct-get variants len))
    true
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def _ fields _)
        (and
          (lower-supported-reference-type-list-subst-with-stack?
            ctx
            subst
            fields
            stack)
          (lower-supported-reference-variant-list-with-stack-at?
            ctx
            subst
            variants
            stack
            (+ index 1)))])))

(define (lower-supported-reference-struct-args-with-stack?
  [ctx : TcContext]
  [name : i64]
  [lifetimes : AstLifetimeList]
  [stack : LowerIdSet]) : bool
  (if (lower-id-set-contains? stack name)
    true
    (match (tc-lifetime-subst-from-nominal-args-id ctx name lifetimes)
      [(ResultTcLifetimeSubst.Err _) false]
      [(ResultTcLifetimeSubst.Ok subst)
        (match (tc-struct-decl-id ctx name)
          [(ResultTcStructDecl.Err _) false]
          [(ResultTcStructDecl.Ok decl)
            (match decl
              [(TcStructDecl _ _ fields)
                (lower-supported-reference-field-list-with-stack?
                  ctx
                  subst
                  fields
                  (lower-id-set-insert stack name))])])])))

(define (lower-supported-reference-enum-args-with-stack?
  [ctx : TcContext]
  [name : i64]
  [lifetimes : AstLifetimeList]
  [stack : LowerIdSet]) : bool
  (if (lower-id-set-contains? stack name)
    true
    (match (tc-lifetime-subst-from-nominal-args-id ctx name lifetimes)
      [(ResultTcLifetimeSubst.Err _) false]
      [(ResultTcLifetimeSubst.Ok subst)
        (match (tc-context-enum-variants-id
          ctx
          name
          (tc-nominal-name-id-display name))
          [(ResultAstVariantDefList.Err _) false]
          [(ResultAstVariantDefList.Ok variants)
            (lower-supported-reference-variant-list-with-stack?
              ctx
              subst
              variants
              (lower-id-set-insert stack name))])])))

(define (lower-supported-reference-type-with-stack?
  [ctx : TcContext]
  [ty : AstType]
  [stack : LowerIdSet]) : bool
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (if (not (tc-type-contains-reference? resolved))
      true
      (match resolved
        [(AstType.Ref _ inner)
          (lower-supported-reference-referent-type?
            ctx
            (tc-context-type-get ctx inner))]
        [(AstType.MutRef _ inner)
          (lower-supported-reference-referent-type?
            ctx
            (tc-context-type-get ctx inner))]
        [(AstType.Tuple elems)
          (lower-supported-reference-type-list-with-stack?
            ctx
            (box-get elems)
            stack)]
        [(AstType.Array elem _)
          (lower-supported-reference-type-with-stack?
            ctx
            (tc-context-type-get ctx elem)
            stack)]
        [(AstType.Box elem)
          (lower-supported-reference-type-with-stack?
            ctx
            (tc-context-type-get ctx elem)
            stack)]
        [(AstType.Func params ret)
          (and
            (lower-supported-reference-type-list-with-stack?
              ctx
              (box-get params)
              stack)
            (lower-supported-reference-type-with-stack?
              ctx
              (tc-context-type-get ctx ret)
              stack))]
        [(AstType.StructArgs name lifetimes)
          (lower-supported-reference-struct-args-with-stack?
            ctx
            name
            (box-get lifetimes)
            stack)]
        [(AstType.EnumArgs name lifetimes)
          (lower-supported-reference-enum-args-with-stack?
            ctx
            name
            (box-get lifetimes)
            stack)]
        [(AstType.Region _ inner)
          (lower-supported-reference-type-with-stack?
            ctx
            (tc-context-type-get ctx inner)
            stack)]
        [_ false]))))

(define (lower-supported-reference-type? [ctx : TcContext] [ty : AstType]) : bool
  (lower-supported-reference-type-with-stack? ctx ty LowerIdSet.Nil))

(define (lower-borrowed-str-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (lower-str-ref-type? ctx expr-ty)
    (match (lower-expr ctx state env type-env inner)
      [(ResultLowerExpr.Ok lowered)
        (match lowered
          [(LowerExpr.Expr inner-state value _)
            (ResultLowerExpr.Ok (LowerExpr.Expr inner-state value expr-ty))])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
    (ResultLowerExpr.Err
      (box (lower-diagnostic-at-expr origin (lower-reference-support-message))))))

(define (lower-borrow-copy-to-storage
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [referent-ty : AstType]
  [result-ty : AstType]) : LowerExpr
  (let
    [resolved : AstType
      (tc-type-without-regions (tc-resolve-type ctx referent-ty))]
    [size : i64 (lower-type-size ctx resolved)]
    (match (lower-reserve-heap-storage
      state
      (if (= size 0)
        1
        size)
      result-ty)
      [(LowerExpr.Expr base-state base _)
        (LowerExpr.Expr
          (if (> size 0)
            (lower-store-inline-value-at-offset
              ctx
              base-state
              base
              0
              value
              resolved
              size)
            base-state)
          base
          result-ty)])))

(define (lower-borrow-copy-to-inline-storage
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [referent-ty : AstType]
  [result-ty : AstType]) : LowerExpr
  (let
    [resolved : AstType
      (tc-type-without-regions (tc-resolve-type ctx referent-ty))]
    [size : i64 (lower-type-size ctx resolved)]
    (match (lower-reserve-inline-storage
      state
      (if (= size 0)
        1
        size)
      resolved)
      [(LowerExpr.Expr base-state base _)
        (LowerExpr.Expr
          (if (> size 0)
            (lower-store-inline-value-at-offset
              ctx
              base-state
              base
              0
              value
              resolved
              size)
            base-state)
          base
          result-ty)])))

(define (lower-borrow-place-slot-reference
  [ctx : TcContext]
  [state : LowerState]
  [slot : CompilerIrValue]
  [stored-ty : AstType]
  [result-ty : AstType]
  [load-value-reference : bool]) : LowerExpr
  (if (and
    load-value-reference
    (lower-borrow-place-value-reference?
      ctx
      (tc-borrow-referent-type stored-ty)))
    (match (lower-state-alloc-var state)
      [(LowerAlloc.Alloc allocated var-id)
        (LowerExpr.Expr
          (lower-state-emit
            allocated
            (CompilerIrInstr.Load var-id slot stored-ty))
          (CompilerIrValue.Var var-id)
          result-ty)])
    (LowerExpr.Expr state slot result-ty)))

(define (lower-borrow-reference-var-address
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr state (CompilerIrValue.Var id) result-ty))
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (CompilerIrValue.Global (lower-resolve-name-symbol-id state name-id))
          result-ty)))))

(define (lower-borrow-var-address-by-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [place-ty : AstType]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [referent-ty : AstType (tc-borrow-referent-type place-ty)]
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? id)
      (if (lower-borrow-place-value-reference? ctx referent-ty)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr state (CompilerIrValue.Var id) result-ty))
        (match (tc-type-strip-region (tc-resolve-type ctx result-ty))
          [(AstType.MutRef _ _)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: mutable borrow of by-value place requires writeback support")))]
          [_
            (ResultLowerExpr.Ok
              (lower-borrow-copy-to-storage
                ctx
                state
                (CompilerIrValue.Var id)
                referent-ty
                result-ty))]))
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (if (lower-borrow-place-value-reference? ctx referent-ty)
            (CompilerIrValue.Global
              (lower-resolve-name-symbol-id state name-id))
            (CompilerIrValue.GlobalAddr
              (lower-resolve-name-symbol-id state name-id)))
          result-ty)))))

(define (lower-borrow-var-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (tc-lookup-id type-env name)
    [(ResultTcType.Ok place-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx place-ty))
        [(AstType.Ref _ _)
          (lower-borrow-reference-var-address state env name result-ty)]
        [(AstType.MutRef _ _)
          (lower-borrow-reference-var-address state env name result-ty)]
        [_
          (if (and
            (tc-type-contains-reference? place-ty)
            (not (lower-supported-reference-type? ctx place-ty)))
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-reference-support-message))))
            (lower-borrow-var-address-by-value
              ctx
              state
              env
              name
              place-ty
              origin
              result-ty))])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-borrow-struct-field-address-from-memory
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field : String]
  [_origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-struct-field-info ctx struct-id struct-name field)
    [(ResultLowerFieldInfo.Ok info)
      (match info
        [(LowerFieldInfo.Info offset field-ty)
          (let
            [load-value-reference : bool
              (not
                (or
                  (and
                    (lower-struct-repr-c-id? ctx struct-id)
                    (lower-repr-c-inline-field? ctx field-ty))
                  (and
                    (lower-mode-inline-aggregates? (lower-state-mode state))
                    (lower-type-inline-storage? ctx field-ty)
                    (not (lower-type-register-resident? ctx field-ty)))))]
            (match (lower-gep-byte state base offset)
              [(LowerExpr.Expr ptr-state ptr _)
                (ResultLowerExpr.Ok
                  (lower-borrow-place-slot-reference
                    ctx
                    ptr-state
                    ptr
                    field-ty
                    result-ty
                    load-value-reference))]))])]
    [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)]))

(define (lower-borrow-struct-field-address-named
  [ctx : TcContext]
  [state : LowerState]
  [receiver-value : CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field : String]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  ;; A register-resident receiver has no address; materialize the packed
  ;; word to a fresh slot, then take the field address through the same memory
  ;; helper used for borrowed struct references.
  (if (tc-name-register-resident-id? ctx struct-id)
    (match (lower-borrow-copy-to-storage
      ctx
      state
      receiver-value
      (AstType.Struct struct-id)
      result-ty)
      [(LowerExpr.Expr mat-state mat-ptr _)
        (lower-borrow-struct-field-address-from-memory
          ctx
          mat-state
          mat-ptr
          struct-id
          struct-name
          field
          origin
          result-ty)])
    (lower-borrow-struct-field-address-from-memory
      ctx
      state
      receiver-value
      struct-id
      struct-name
      field
      origin
      result-ty)))

(define (lower-borrow-struct-field-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [receiver : AstExpr]
  [field : String]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env receiver)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr receiver-state receiver-value receiver-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
            [(AstType.Struct struct-name)
              (lower-borrow-struct-field-address-named
                ctx
                receiver-state
                receiver-value
                struct-name
                (tc-nominal-name-id-display struct-name)
                field
                origin
                result-ty)]
            [(AstType.StructArgs struct-name _)
              (lower-borrow-struct-field-address-named
                ctx
                receiver-state
                receiver-value
                struct-name
                (tc-nominal-name-id-display struct-name)
                field
                origin
                result-ty)]
            [(AstType.Ref _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
                [(AstType.Struct struct-name)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    struct-name
                    (tc-nominal-name-id-display struct-name)
                    field
                    origin
                    result-ty)]
                [(AstType.StructArgs struct-name _)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    struct-name
                    (tc-nominal-name-id-display struct-name)
                    field
                    origin
                    result-ty)]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: struct-get borrow requires struct place")))])]
            [(AstType.MutRef _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
                [(AstType.Struct struct-name)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    struct-name
                    (tc-nominal-name-id-display struct-name)
                    field
                    origin
                    result-ty)]
                [(AstType.StructArgs struct-name _)
                  (lower-borrow-struct-field-address-from-memory
                    ctx
                    receiver-state
                    receiver-value
                    struct-name
                    (tc-nominal-name-id-display struct-name)
                    field
                    origin
                    result-ty)]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: struct-get borrow requires struct place")))])]
            [_
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "lower: struct-get borrow requires struct place")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-borrow-tuple-field-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [tuple-expr : AstExpr]
  [index : i64]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env tuple-expr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr tuple-state tuple-value tuple-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx tuple-ty))
            [(AstType.Tuple elem-tys)
              (match (lower-tuple-elem-info ctx (box-get elem-tys) index 0 0)
                [(ResultLowerFieldInfo.Ok info)
                  (match info
                    [(LowerFieldInfo.Info offset _)
                      (match (lower-gep-byte tuple-state tuple-value offset)
                        [(LowerExpr.Expr ptr-state ptr _)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr ptr-state ptr result-ty))])])]
                [(ResultLowerFieldInfo.Err message)
                  (ResultLowerExpr.Err message)])]
            [(AstType.Ref _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
                [(AstType.Tuple elem-tys)
                  (match (lower-tuple-elem-info
                    ctx
                    (box-get elem-tys)
                    index
                    0
                    0)
                    [(ResultLowerFieldInfo.Ok info)
                      (match info
                        [(LowerFieldInfo.Info offset _)
                          (match (lower-gep-byte tuple-state tuple-value offset)
                            [(LowerExpr.Expr ptr-state ptr _)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr ptr-state ptr result-ty))])])]
                    [(ResultLowerFieldInfo.Err message)
                      (ResultLowerExpr.Err message)])]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: tuple-ref borrow requires tuple place")))])]
            [(AstType.MutRef _ referent-ty)
              (match (tc-type-strip-region
                (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
                [(AstType.Tuple elem-tys)
                  (match (lower-tuple-elem-info
                    ctx
                    (box-get elem-tys)
                    index
                    0
                    0)
                    [(ResultLowerFieldInfo.Ok info)
                      (match info
                        [(LowerFieldInfo.Info offset _)
                          (match (lower-gep-byte tuple-state tuple-value offset)
                            [(LowerExpr.Expr ptr-state ptr _)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr ptr-state ptr result-ty))])])]
                    [(ResultLowerFieldInfo.Err message)
                      (ResultLowerExpr.Err message)])]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: tuple-ref borrow requires tuple place")))])]
            [_
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "lower: tuple-ref borrow requires tuple place")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-borrow-array-element-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [index : AstExpr]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      ;; A reference-valued iterator field is already an address of its array
      ;; storage. Its element borrow has been typechecked against the stored
      ;; referent, so lower the same dynamic/fixed-array address computation
      ;; instead of requiring the field projection itself to be an Array value.
      (let
        [container-ty : AstType
          (match (tc-type-strip-region (tc-resolve-type ctx arr-ty))
            [(AstType.Ref _ referent-ty) (tc-context-type-get ctx referent-ty)]
            [(AstType.MutRef _ referent-ty)
              (tc-context-type-get ctx referent-ty)]
            [_ arr-ty])]
        (match (tc-type-strip-region (tc-resolve-type ctx container-ty))
          [(AstType.DynArray elem-ty)
            (match (lower-expr ctx state env type-env arr)
              [(ResultLowerExpr.Ok arr-lowered)
                (match arr-lowered
                  [(LowerExpr.Expr arr-state arr-value _)
                    (match (lower-index-result-type-or-check
                      ctx
                      env
                      type-env
                      (lower-state-type-cache arr-state)
                      index)
                      [(ResultTcType.Ok idx-ty)
                        (match (lower-expr-expected
                          ctx
                          arr-state
                          env
                          type-env
                          index
                          idx-ty
                          index)
                          [(ResultLowerExpr.Ok idx-lowered)
                            (match idx-lowered
                              [(LowerExpr.Expr idx-state idx-value idx-value-ty)
                                (match (lower-array-element-addr
                                  ctx
                                  idx-state
                                  arr-value
                                  idx-value
                                  idx-value-ty
                                  (tc-type-without-regions
                                    (tc-context-type-get ctx elem-ty)))
                                  [(LowerExpr.Expr addr-state elem-ptr _)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr
                                        addr-state
                                        elem-ptr
                                        result-ty))])])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])]
                      [(ResultTcType.Err message)
                        (ResultLowerExpr.Err
                          (box (lower-diagnostic-at-expr index message)))])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [(AstType.Array elem-ty elem-count)
            (let
              [fixed-elem-ty : AstType
                (tc-type-without-regions (tc-context-type-get ctx elem-ty))]
              (match (lower-expr ctx state env type-env arr)
                [(ResultLowerExpr.Ok arr-lowered)
                  (match arr-lowered
                    [(LowerExpr.Expr arr-state arr-value _)
                      (match (lower-index-result-type-or-check
                        ctx
                        env
                        type-env
                        (lower-state-type-cache arr-state)
                        index)
                        [(ResultTcType.Ok idx-ty)
                          (match (lower-expr-expected
                            ctx
                            arr-state
                            env
                            type-env
                            index
                            idx-ty
                            index)
                            [(ResultLowerExpr.Ok idx-lowered)
                              (match idx-lowered
                                [(LowerExpr.Expr
                                    idx-state
                                    idx-value
                                    idx-value-ty)
                                  (match (lower-fixed-array-element-addr
                                    ctx
                                    idx-state
                                    arr-value
                                    idx-value
                                    idx-value-ty
                                    fixed-elem-ty
                                    elem-count)
                                    [(LowerExpr.Expr addr-state elem-ptr _)
                                      (ResultLowerExpr.Ok
                                        (LowerExpr.Expr
                                          addr-state
                                          elem-ptr
                                          result-ty))])])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)])]
                        [(ResultTcType.Err message)
                          (ResultLowerExpr.Err
                            (box (lower-diagnostic-at-expr index message)))])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
          [_
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: array-ref borrow requires array place")))]))]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

(define (lower-borrow-place-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [place : AstExpr]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (ast-expr-unspan place)
    [(AstExpr.Var name)
      (if (tc-dotted-local-field-name-id? type-env name)
        (match (tc-dotted-local-field-expr-id type-env name)
          [(ResultTcExprId.Ok virtual-id)
            (lower-borrow-place-address
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin
              result-ty)]
          [(ResultTcExprId.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))])
        (lower-borrow-var-address ctx state env type-env name origin result-ty))]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-borrow-struct-field-address
          ctx
          state
          env
          type-env
          receiver
          (tc-env-key-name-text field)
          origin
          result-ty))]
    [(AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : AstExpr (lower-context-expr-get ctx tuple-expr-box)]
        (lower-borrow-tuple-field-address
          ctx
          state
          env
          type-env
          tuple-expr
          index
          origin
          result-ty))]
    [(AstExpr.ArrayRef arr-box index-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (lower-borrow-array-element-address
          ctx
          state
          env
          type-env
          arr
          index
          origin
          result-ty))]
    [(AstExpr.BoxGet box-box)
      (let
        [box-expr : AstExpr (lower-context-expr-get ctx box-box)]
        (lower-box-storage-address
          ctx
          state
          env
          type-env
          box-expr
          origin
          result-ty))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: borrow requires a local, parameter, or aggregate place")))]))

(define (lower-borrow-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (lower-str-ref-type? ctx expr-ty)
    (lower-borrowed-str-expr ctx state env type-env inner origin expr-ty)
    (match (tc-type-strip-region (tc-resolve-type ctx expr-ty))
      [(AstType.Ref _ referent-ty)
        (if (lower-supported-reference-referent-type?
          ctx
          (tc-context-type-get ctx referent-ty))
          (lower-borrow-place-address
            ctx
            state
            env
            type-env
            inner
            origin
            expr-ty)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-reference-support-message)))))]
      [(AstType.MutRef _ referent-ty)
        (if (lower-supported-reference-referent-type?
          ctx
          (tc-context-type-get ctx referent-ty))
          (lower-borrow-place-address
            ctx
            state
            env
            type-env
            inner
            origin
            expr-ty)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-reference-support-message)))))]
      [_
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic-at-expr origin (lower-reference-support-message))))])))

(define (lower-store-values
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [types : AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-store-values-at ctx state base values (& types) 0 cursor))

(define (lower-store-values-at
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [types : (& types AstTypeList)]
  [type-index : i64]
  [cursor : i64]) : ResultLowerState
  (match values
    [(CompilerIrValueList.Nil)
      (if (>= type-index (ast-type-list-len types))
        (ResultLowerState.Ok state)
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(CompilerIrValueList.Array seq)
      (lower-store-values-at
        ctx
        state
        base
        (compiler-ir-value-seq-to-list seq)
        types
        type-index
        cursor)]
    [(CompilerIrValueList.Cons value rest-values)
      (if (>= type-index (ast-type-list-len types))
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (let
          [ty : AstType
            (tc-context-type-get
              ctx
              (ast-type-list-get types type-index (ast-type-id-fallback)))]
          [resolved : AstType (tc-resolve-type ctx ty)]
          [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
          (lower-store-values-at
            ctx
            (lower-store-at-offset state base offset value resolved)
            base
            (box-get rest-values)
            types
            (+ type-index 1)
            (+ offset (lower-type-size ctx resolved)))))]))

(define (lower-store-repr-c-values
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [fields : TcReprCFieldLayoutList]) : ResultLowerState
  (match values
    [(CompilerIrValueList.Nil)
      (match fields
        [(TcReprCFieldLayoutList.Nil) (ResultLowerState.Ok state)]
        [_
          (ResultLowerState.Err
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]
    [(CompilerIrValueList.Array seq)
      (lower-store-repr-c-values
        ctx
        state
        base
        (compiler-ir-value-seq-to-list seq)
        fields)]
    [(CompilerIrValueList.Cons value rest-values)
      (match fields
        [(TcReprCFieldLayoutList.Cons field rest-fields)
          (match field
            [(TcReprCFieldLayout.Field _ field-ty offset)
              (let
                [stored-state : LowerState
                  (if (lower-repr-c-inline-field? ctx field-ty)
                    (lower-copy-bytes
                      state
                      base
                      offset
                      value
                      0
                      (lower-repr-c-field-size ctx field-ty))
                    (lower-store-at-offset state base offset value field-ty))]
                (lower-store-repr-c-values
                  ctx
                  stored-state
                  base
                  (box-get rest-values)
                  (box-get rest-fields)))])]
        [(TcReprCFieldLayoutList.Nil)
          (ResultLowerState.Err
            (box (lower-diagnostic "lower: constructor arity mismatch")))])]))

(define (lower-store-inline-struct-values
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [layout : TcInlineAggregateLayout]) : ResultLowerState
  (lower-store-inline-struct-values-at
    ctx
    state
    base
    values
    (& fields)
    0
    layout))

(define (lower-store-inline-struct-values-at
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [fields : (& fields AstFieldDefList)]
  [field-index : i64]
  [layout : TcInlineAggregateLayout]) : ResultLowerState
  (match values
    [(CompilerIrValueList.Nil)
      (if (>= field-index (struct-get fields len))
        (ResultLowerState.Ok state)
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(CompilerIrValueList.Array seq)
      (lower-store-inline-struct-values-at
        ctx
        state
        base
        (compiler-ir-value-seq-to-list seq)
        fields
        field-index
        layout)]
    [(CompilerIrValueList.Cons value rest-values)
      (if (>= field-index (struct-get fields len))
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (match (ast-field-def-list-get
          fields
          field-index
          (ast-field-def-fallback))
          [(AstFieldDef.Def name ty _)
            (let
              [name-str : String (tc-env-key-name-text name)]
              [resolved : AstType (tc-resolve-type ctx ty)]
              [offset : i64
                (tc-inline-aggregate-layout-field-offset-id layout name)]
              (if (< offset 0)
                (ResultLowerState.Err
                  (box
                    (lower-diagnostic
                      (string.append
                        "lower: inline struct layout missing field "
                        name-str))))
                (match (tc-inline-aggregate-type-layout ctx resolved)
                  [(ResultTcLayoutInfo.Ok info)
                    (let
                      [stored-state : LowerState
                        (if (<= (tc-layout-info-size info) 0)
                          state
                          (lower-store-inline-value-at-offset
                            ctx
                            state
                            base
                            offset
                            value
                            resolved
                            (tc-layout-info-size info)))]
                      (lower-store-inline-struct-values-at
                        ctx
                        stored-state
                        base
                        (box-get rest-values)
                        fields
                        (+ field-index 1)
                        layout))]
                  [(ResultTcLayoutInfo.Err message)
                    (ResultLowerState.Err (box (lower-diagnostic message)))])))]))]))

(define (lower-store-inline-payload-values
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [types : AstTypeList]
  [layout : TcInlineAggregateLayout]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]) : ResultLowerState
  (lower-store-inline-payload-values-at
    ctx
    state
    base
    values
    (& types)
    layout
    variant-name
    variant-name-id
    index))

(define (lower-store-inline-payload-values-at
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [values : CompilerIrValueList]
  [types : (& types AstTypeList)]
  [layout : TcInlineAggregateLayout]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]) : ResultLowerState
  (match values
    [(CompilerIrValueList.Nil)
      (if (>= index (ast-type-list-len types))
        (ResultLowerState.Ok state)
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch"))))]
    [(CompilerIrValueList.Array seq)
      (lower-store-inline-payload-values-at
        ctx
        state
        base
        (compiler-ir-value-seq-to-list seq)
        types
        layout
        variant-name
        variant-name-id
        index)]
    [(CompilerIrValueList.Cons value rest-values)
      (if (>= index (ast-type-list-len types))
        (ResultLowerState.Err
          (box (lower-diagnostic "lower: constructor arity mismatch")))
        (let
          [ty : AstType
            (tc-context-type-get
              ctx
              (ast-type-list-get types index (ast-type-id-fallback)))]
          [resolved : AstType (tc-resolve-type ctx ty)]
          [offset : i64
            (tc-inline-aggregate-layout-variant-payload-offset-id
              layout
              variant-name-id
              index)]
          (if (< offset 0)
            (ResultLowerState.Err
              (box
                (lower-diagnostic
                  (string.append
                    "lower: inline enum layout missing payload for "
                    variant-name))))
            (match (tc-inline-aggregate-type-layout ctx resolved)
              [(ResultTcLayoutInfo.Ok info)
                (lower-store-inline-payload-values-at
                  ctx
                  (if (<= (tc-layout-info-size info) 0)
                    state
                    (lower-store-inline-value-at-offset
                      ctx
                      state
                      base
                      offset
                      value
                      resolved
                      (tc-layout-info-size info)))
                  base
                  (box-get rest-values)
                  types
                  layout
                  variant-name
                  variant-name-id
                  (+ index 1))]
              [(ResultTcLayoutInfo.Err message)
                (ResultLowerState.Err (box (lower-diagnostic message)))]))))]))

(define (lower-literal-payload-supported? [lit : AstLiteral]) : bool
  (match lit
    [(AstLiteral.Int _ _) true]
    [(AstLiteral.Bool _) true]
    [(AstLiteral.Char _) true]
    [(AstLiteral.String _) true]
    [_ false]))

(define (lower-enum-type-name-or-empty [ty : AstType]) : String
  (match (tc-type-strip-region ty)
    [(AstType.Enum enum-name) (tc-nominal-name-id-display enum-name)]
    [(AstType.EnumArgs enum-name _) (tc-nominal-name-id-display enum-name)]
    [(AstType.Var enum-name) (tc-nominal-name-id-display enum-name)]
    [(AstType.VarArgs enum-name _) (tc-nominal-name-id-display enum-name)]
    [_ ""]))

(define (lower-enum-type-name-id-or [ty : AstType] [fallback : i64]) : i64
  (match (tc-type-strip-region ty)
    [(AstType.Enum enum-name) enum-name]
    [(AstType.EnumArgs enum-name _) enum-name]
    [(AstType.Var enum-name) enum-name]
    [(AstType.VarArgs enum-name _) enum-name]
    [_ fallback]))

(define (lower-struct-type-name-or-empty [ty : AstType]) : String
  (match (tc-type-strip-region ty)
    [(AstType.Struct struct-name) (tc-nominal-name-id-display struct-name)]
    [(AstType.StructArgs struct-name _)
      (tc-nominal-name-id-display struct-name)]
    [(AstType.Var struct-name) (tc-nominal-name-id-display struct-name)]
    [(AstType.VarArgs struct-name _) (tc-nominal-name-id-display struct-name)]
    [_ ""]))

(define (lower-struct-type-name-id-or [ty : AstType] [fallback : i64]) : i64
  (match (tc-type-strip-region ty)
    [(AstType.Struct struct-name) struct-name]
    [(AstType.StructArgs struct-name _) struct-name]
    [(AstType.Var struct-name) struct-name]
    [(AstType.VarArgs struct-name _) struct-name]
    [_ fallback]))

(define (lower-struct-type-handle-or
  [ctx : TcContext]
  [ty : AstType]
  [fallback : i64]) : i64
  (let
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [name-id : i64 (lower-struct-type-name-id-or ty -1)]
    [direct : i64
      (if (>= name-id 0)
        (compiler-symbols-lookup-type-id-or symbols name-id fallback)
        fallback)]
    (if (compiler-symbols-handle-found? direct)
      direct
      (if (and
        (>= name-id 0)
        (< name-id (intern-capacity))
        (not (intern-qualified? name-id)))
        (compiler-symbols-lookup-type-id-or
          symbols
          (compiler-symbol-module-key-id-by-id
            (tc-context-module-id ctx)
            name-id)
          fallback)
        fallback))))

(define (lower-struct-constructor-handle-id-or
  [ctx : TcContext]
  [state : LowerState]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [ty : AstType]
  [fallback : i64]) : i64
  (let
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [result-handle : i64 (lower-struct-type-handle-or ctx ty fallback)]
    [lookup-handle : i64
      (if (>= lookup-name-id 0)
        (compiler-symbols-lookup-type-id-or symbols lookup-name-id fallback)
        fallback)]
    [direct-handle : i64
      (if (>= raw-name-id 0)
        (compiler-symbols-lookup-type-id-or symbols raw-name-id fallback)
        fallback)]
    [names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (if (>= raw-name-id 0)
        (lower-name-cache-resolve-logical-id (& names) raw-name-id raw-name-id)
        raw-name-id)]
    [logical-handle : i64
      (if (>= logical-id 0)
        (compiler-symbols-lookup-type-id-or symbols logical-id fallback)
        fallback)]
    (cond
      [(compiler-symbols-handle-found? result-handle) result-handle]
      [(compiler-symbols-handle-found? lookup-handle) lookup-handle]
      [(compiler-symbols-handle-found? direct-handle) direct-handle]
      [(compiler-symbols-handle-found? logical-handle) logical-handle]
      [else fallback])))

(define (lower-variant-handle-for-scrut-id-or
  [ctx : TcContext]
  [scrut-ty : AstType]
  [variant-name-id : i64]
  [fallback : i64]) : i64
  (match (tc-type-strip-region scrut-ty)
    [(AstType.Enum enum-name-id)
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [(AstType.EnumArgs enum-name-id _)
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [(AstType.Var enum-name-id)
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [(AstType.VarArgs enum-name-id _)
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        fallback)]
    [_
      (compiler-registries-lookup-variant-id-or
        (tc-context-registries ctx)
        variant-name-id
        fallback)]))

(define (lower-variant-owner-id-for-enum
  [ctx : TcContext]
  [enum-name-id : i64]
  [variant-name-id : i64]) : i64
  (let
    [handle : i64
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (tc-variant-owner-id-or ctx handle enum-name-id)
      enum-name-id)))

(define (lower-variant-handle-name-id-or
  [ctx : TcContext]
  [handle : i64]
  [fallback : i64]) : i64
  (match (compiler-registries-variant-name-id-indexed
    (tc-context-symbols ctx)
    handle)
    [(option_i64.Some name-id) name-id]
    [(option_i64.None) fallback]))

(define (lower-type-debug-kind [ty : AstType]) : String
  (match (tc-type-strip-region ty)
    [(AstType.Enum _) "enum"]
    [(AstType.EnumArgs _ _) "enum-args"]
    [(AstType.Struct _) "struct"]
    [(AstType.StructArgs _ _) "struct-args"]
    [(AstType.Var _) "var"]
    [(AstType.VarArgs _ _) "var-args"]
    [(AstType.Ref _ _) "ref"]
    [(AstType.MutRef _ _) "mut-ref"]
    [_ "other"]))

(define (lower-unsupported-match-pattern-message
  [ctx : TcContext]
  [scrut-ty : AstType]
  [variant-name : String]) : String
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
    (str_cat.str-cat
      "lower: unsupported match pattern "
      variant-name
      " in module "
      (tc-context-module ctx)
      " raw "
      (lower-type-debug-kind scrut-ty)
      " "
      (tc-type-render scrut-ty)
      " resolved "
      (lower-type-debug-kind resolved)
      " "
      (tc-type-render resolved))))

(define (lower-member-name-base [name : String]) : String
  (let
    [source : String
      (if (tc-name-qualified? name)
        (tc-qualified-name-base name)
        name)]
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length source)]
    (begin
      (while (< i n)
        (begin
          (if (string.char-eq (string.string-ref source i) '.')
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      (if (and (>= last-dot 0) (< last-dot (- n 1)))
        (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
        source))))

(define (lower-member-name-prefix [name : String]) : String
  (let
    [qualified-module : String
      (if (tc-name-qualified? name)
        (tc-qualified-name-module name)
        "")]
    [source : String
      (if (tc-name-qualified? name)
        (tc-qualified-name-base name)
        name)]
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length source)]
    (begin
      (while (< i n)
        (begin
          (if (string.char-eq (string.string-ref source i) '.')
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      (if (>= last-dot 0)
        (let
          [local-prefix : String (string.substring source 0 last-dot)]
          (if (> (string.string-length qualified-module) 0)
            (compiler-symbol-module-key qualified-module local-prefix)
            local-prefix))
        qualified-module))))

(define (lower-variant-payload-offset
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [_ : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [resolved : AstType]) : i64
  (if (and
    (lower-mode-inline-aggregates? mode)
    (> (string.string-length enum-name) 0))
    (match (tc-inline-aggregate-layout-for-id ctx enum-id)
      [(ResultTcInlineAggregateLayout.Ok layout)
        (tc-inline-aggregate-layout-variant-payload-offset-id
          layout
          variant-name-id
          index)]
      [(ResultTcInlineAggregateLayout.Err _) (- 0 1)])
    (lower-align-up cursor (lower-type-align ctx resolved))))

(define (lower-string-payload-literal-eq
  [state : LowerState]
  [field-value : CompilerIrValue]
  [lit-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state field-value)
    [(LowerStringFields.Fields field-state field-ptr field-len)
      (match (lower-string-fields field-state lit-value)
        [(LowerStringFields.Fields done-state lit-ptr lit-len)
          (ResultLowerExpr.Ok
            (lower-inline-string-eq-fields
              done-state
              field-ptr
              field-len
              lit-ptr
              lit-len
              (AstType.Bool)))])]))

(define (lower-literal-payload-eq
  [ctx : TcContext]
  [state : LowerState]
  [field-value : CompilerIrValue]
  [lit : AstLiteral]
  [resolved : AstType]) : ResultLowerExpr
  (match lit
    [(AstLiteral.String _)
      (if (lower-string-handle-type? ctx resolved)
        (lower-string-payload-literal-eq
          state
          field-value
          (lower-literal-value-with-type lit resolved))
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic
              "lower: unsupported enum payload literal pattern type"))))]
    [_
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc eq-alloc eq-var)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-state-emit
                eq-alloc
                (CompilerIrInstr.BinOp
                  eq-var
                  CompilerIrBinOp.Eq
                  field-value
                  (lower-literal-value-with-type lit resolved)
                  resolved))
              (CompilerIrValue.Var eq-var)
              (AstType.Bool)))])]))

(define (lower-box-pattern-name? [name : i64]) : bool
  (string.eq (tc-env-key-name-text name) "box"))

(define (lower-bind-irrefutable-box-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [pattern : AstPattern]
  [inner-ty : AstType]) : ResultLowerEnv
  (match pattern
    [(AstPattern.Wildcard) (ResultLowerEnv.Ok state env type-env)]
    [(AstPattern.Binding name)
      (match value
        [(CompilerIrValue.Var value-var)
          (ResultLowerEnv.Ok
            state
            (sym_i64_env.sym-i64-bind-id env name value-var)
            (tc-bind-id type-env name inner-ty))]
        [_
          (ResultLowerEnv.Err
            (box (lower-diagnostic "lower: internal box pattern load failed")))])]
    [(AstPattern.Variant name args-box)
      (if (lower-box-pattern-name? name)
        (lower-bind-box-pattern
          ctx
          state
          env
          type-env
          value
          inner-ty
          (box-get args-box))
        (ResultLowerEnv.Err
          (box (lower-diagnostic "lower: unsupported refutable box pattern"))))]
    [_
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: unsupported refutable box pattern")))]))

(define (lower-bind-box-pattern
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [box-value : CompilerIrValue]
  [box-ty : AstType]
  [args : AstPatternList]) : ResultLowerEnv
  (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
    [(AstType.Box inner-node)
      (if (= (struct-get (& args) len) 1)
        (let
          [inner : AstPattern
            (ast-pattern-list-get (& args) 0 (ast-pattern-fallback))]
          [inner-ty : AstType
            (tc-resolve-type ctx (tc-context-type-get ctx inner-node))]
          (match (lower-load-inline-value-at-offset
            ctx
            state
            box-value
            0
            inner-ty
            (lower-state-mode state))
            [(LowerExpr.Expr load-state inner-value _)
              (lower-bind-irrefutable-box-value
                ctx
                load-state
                env
                type-env
                inner-value
                inner
                inner-ty)]))
        (ResultLowerEnv.Err
          (box
            (lower-diagnostic
              "lower: box pattern expects exactly one inner pattern"))))]
    [_
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: box pattern requires Box type")))]))

(define (lower-bind-box-variant-payload
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [nested-args : AstPatternList]
  [resolved : AstType]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [rest-patterns : AstPatternList]
  [rest-types : AstTypeList]
  [offset : i64]
  [next-index : i64]
  [next-cursor : i64]
  [fail-label : String]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match (tc-type-strip-region (tc-resolve-type ctx resolved))
    [(AstType.Box _)
      (match (if scrut-reg-group?
        (lower-read-register-group-payload
          ctx
          state
          base
          (AstType.Enum enum-id)
          offset
          resolved)
        (lower-load-inline-value-at-offset ctx state base offset resolved mode))
        [(LowerExpr.Expr field-state field-value _)
          (match (lower-bind-box-pattern
            ctx
            field-state
            env
            type-env
            field-value
            resolved
            nested-args)
            [(ResultLowerEnv.Ok box-state box-env box-type-env)
              (lower-bind-variant-payloads
                ctx
                box-state
                box-env
                box-type-env
                base
                rest-patterns
                rest-types
                mode
                enum-id
                enum-name
                variant-name
                variant-name-id
                next-index
                next-cursor
                fail-label
                scrut-reg-group?)]
            [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)])])]
    [_
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: box pattern requires Box payload")))]))

(define (lower-bind-struct-variant-payload
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [nested-args : AstPatternList]
  [resolved : AstType]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [rest-patterns : AstPatternList]
  [rest-types : AstTypeList]
  [offset : i64]
  [next-index : i64]
  [next-cursor : i64]
  [fail-label : String]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match (if scrut-reg-group?
    (lower-read-register-group-payload
      ctx
      state
      base
      (AstType.Enum enum-id)
      offset
      resolved)
    (lower-load-inline-value-at-offset ctx state base offset resolved mode))
    [(LowerExpr.Expr field-state field-value _)
      (match (lower-bind-struct-pattern
        ctx
        field-state
        env
        type-env
        field-value
        resolved
        (lower-struct-type-name-or-empty
          (tc-type-strip-region (tc-resolve-type ctx resolved)))
        nested-args)
        [(ResultLowerEnv.Ok struct-state struct-env struct-type-env)
          (lower-bind-variant-payloads
            ctx
            struct-state
            struct-env
            struct-type-env
            base
            rest-patterns
            rest-types
            mode
            enum-id
            enum-name
            variant-name
            variant-name-id
            next-index
            next-cursor
            fail-label
            scrut-reg-group?)]
        [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)])]))

;; Bind a matched variant's payload fields. Irrefutable subpatterns (wildcard,
;; binding) just load/bind; a refutable literal subpattern loads the
;; field, compares it to the literal, and on mismatch branches to `fail-label`
;; (the enclosing arm's next-arm test) so matching continues. Nested variant
;; subpatterns recurse on the field's tag. `fail-label` is unused when every subpattern
;; is irrefutable.
(define (lower-bind-variant-payloads
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [patterns : AstPatternList]
  [types : AstTypeList]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [fail-label : String]
  ;; Whether the scrutinee enum is a 2-word register-group value, computed
  ;; ONCE by the caller and threaded here. Recomputing it per payload field (a full
  ;; transient layout rebuild) at every binding site across the whole compiler was
  ;; heavy enough to overflow the per-function scratch arena into a second chunk
  ;; and trip its rewind, corrupting later lowering.
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (if (ast-pattern-list-empty? (& patterns))
    (if (ast-type-list-empty? (& types))
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: enum payload pattern arity mismatch"))))
    (let
      [pattern : AstPattern
        (ast-pattern-list-get (& patterns) 0 (ast-pattern-fallback))]
      [rest-patterns : AstPatternList (ast-pattern-list-tail patterns)]
      (if (ast-type-list-empty? (& types))
        (ResultLowerEnv.Err
          (box (lower-diagnostic "lower: enum payload pattern arity mismatch")))
        (let
          [ty : i64 (ast-type-list-get (& types) 0 (ast-type-id-fallback))]
          [rest-types : AstTypeList (ast-type-list-slice types 1)]
          (let
            [ty : AstType (tc-context-type-get ctx ty)]
            [field-ctx : TcContext
              (tc-context-with-owner-name-module
                ctx
                (lower-variant-owner-id-for-enum ctx enum-id variant-name-id))]
            [resolved : AstType (tc-resolve-type field-ctx ty)]
            [default-offset : i64
              (lower-align-up cursor (lower-type-align ctx resolved))]
            [offset : i64
              (lower-variant-payload-offset
                ctx
                mode
                enum-id
                enum-name
                variant-name
                variant-name-id
                index
                cursor
                resolved)]
            [next-cursor : i64
              (+ default-offset (lower-type-size ctx resolved))]
            [next-index : i64 (+ index 1)]
            (if (< offset 0)
              (ResultLowerEnv.Err
                (box
                  (lower-diagnostic
                    (string.append
                      "lower: inline enum layout missing payload for "
                      variant-name))))
              (match pattern
                [(AstPattern.Wildcard)
                  (lower-bind-variant-payloads
                    ctx
                    state
                    env
                    type-env
                    base
                    rest-patterns
                    rest-types
                    mode
                    enum-id
                    enum-name
                    variant-name
                    variant-name-id
                    next-index
                    next-cursor
                    fail-label
                    scrut-reg-group?)]
                [(AstPattern.Binding name)
                  (match (if scrut-reg-group?
                    (lower-read-register-group-payload
                      ctx
                      state
                      base
                      (AstType.Enum enum-id)
                      offset
                      resolved)
                    (lower-load-inline-value-at-offset
                      ctx
                      state
                      base
                      offset
                      resolved
                      mode))
                    [(LowerExpr.Expr load-state value _)
                      (match value
                        [(CompilerIrValue.Var field-var)
                          (lower-bind-variant-payloads
                            ctx
                            load-state
                            (sym_i64_env.sym-i64-bind-id env name field-var)
                            (tc-bind-id type-env name resolved)
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label
                            scrut-reg-group?)]
                        [_
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                "lower: internal enum payload load failed")))])])]
                [(AstPattern.Var name _)
                  (match (if scrut-reg-group?
                    (lower-read-register-group-payload
                      ctx
                      state
                      base
                      (AstType.Enum enum-id)
                      offset
                      resolved)
                    (lower-load-inline-value-at-offset
                      ctx
                      state
                      base
                      offset
                      resolved
                      mode))
                    [(LowerExpr.Expr load-state value _)
                      (match value
                        [(CompilerIrValue.Var field-var)
                          (lower-bind-variant-payloads
                            ctx
                            load-state
                            (sym_i64_env.sym-i64-bind-id env name field-var)
                            (tc-bind-id type-env name resolved)
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label
                            scrut-reg-group?)]
                        [_
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                "lower: internal enum payload load failed")))])])]
                [(AstPattern.Literal lit)
                  (if (lower-literal-payload-supported? lit)
                    (match (if scrut-reg-group?
                      (lower-read-register-group-payload
                        ctx
                        state
                        base
                        (AstType.Enum enum-id)
                        offset
                        resolved)
                      (lower-load-at-offset state base offset resolved))
                      [(LowerExpr.Expr load-state field-value _)
                        (match (lower-literal-payload-eq
                          ctx
                          load-state
                          field-value
                          lit
                          resolved)
                          [(ResultLowerExpr.Ok lowered-eq)
                            (match lowered-eq
                              [(LowerExpr.Expr eq-state eq-value _)
                                (match (lower-state-fresh-label
                                  eq-state
                                  "payload_ok")
                                  [(LowerLabel.Label ok-state ok-label)
                                    (lower-bind-variant-payloads
                                      ctx
                                      (lower-state-finish-block
                                        (lower-state-emit
                                          ok-state
                                          (CompilerIrInstr.Branch
                                            eq-value
                                            ok-label
                                            fail-label))
                                        ok-label)
                                      env
                                      type-env
                                      base
                                      rest-patterns
                                      rest-types
                                      mode
                                      enum-id
                                      enum-name
                                      variant-name
                                      variant-name-id
                                      next-index
                                      next-cursor
                                      fail-label
                                      scrut-reg-group?)])])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerEnv.Err message)])])
                    (ResultLowerEnv.Err
                      (box
                        (lower-diagnostic
                          "lower: unsupported enum payload literal pattern type"))))]
                [(AstPattern.Variant nested-name nested-args-box)
                  ;; Refutable nested variant payloads test the loaded
                  ;; enum tag and branch to `fail-label` on mismatch. An
                  ;; explicit `(box ...)` payload pattern is irrefutable here;
                  ;; it loads the boxed value and binds the inner pattern.
                  (let
                    [nested-name-str : String
                      (tc-env-key-name-text nested-name)]
                    [nested-args : AstPatternList (box-get nested-args-box)]
                    (if (lower-box-pattern-name? nested-name)
                      (lower-bind-box-variant-payload
                        ctx
                        state
                        env
                        type-env
                        base
                        nested-args
                        resolved
                        mode
                        enum-id
                        enum-name
                        variant-name
                        variant-name-id
                        rest-patterns
                        rest-types
                        offset
                        next-index
                        next-cursor
                        fail-label
                        scrut-reg-group?)
                      (if (lower-struct-pattern-for-type?
                        ctx
                        resolved
                        nested-name)
                        (lower-bind-struct-variant-payload
                          ctx
                          state
                          env
                          type-env
                          base
                          nested-args
                          resolved
                          mode
                          enum-id
                          enum-name
                          variant-name
                          variant-name-id
                          rest-patterns
                          rest-types
                          offset
                          next-index
                          next-cursor
                          fail-label
                          scrut-reg-group?)
                        (match ctx
                          [(TcContext _ symbols registries _ _ _ _ _)
                            (let
                              [handle : i64
                                (lower-variant-handle-for-scrut-id-or
                                  ctx
                                  resolved
                                  nested-name
                                  (compiler-symbols-missing-handle))]
                              (if (not (compiler-symbols-handle-found? handle))
                                (ResultLowerEnv.Err
                                  (box
                                    (lower-diagnostic
                                      (string.append
                                        "lower: unknown nested variant "
                                        nested-name-str))))
                                (match (compiler-registries-variant-fields-indexed
                                  symbols
                                  handle)
                                  [(ResultAstTypeList.Err message)
                                    (ResultLowerEnv.Err
                                      (box (lower-diagnostic message)))]
                                  [(ResultAstTypeList.Ok nested-fields)
                                    (match (lower-load-inline-value-at-offset
                                      ctx
                                      state
                                      base
                                      offset
                                      resolved
                                      mode)
                                      [(LowerExpr.Expr
                                          field-state
                                          field-value
                                          _)
                                        ;; For a register-resident enum field
                                        ;; the loaded value IS the tag word; for a
                                        ;; memory enum it is a pointer to the field,
                                        ;; so the tag is loaded from offset 0.
                                        ;; Dereferencing a register-resident tag word
                                        ;; would fault (it is a small integer, not an
                                        ;; address).
                                        (match (if (lower-type-register-resident?
                                          ctx
                                          resolved)
                                          (LowerExpr.Expr
                                            field-state
                                            field-value
                                            (AstType.I64))
                                          (lower-load-at-offset
                                            field-state
                                            field-value
                                            0
                                            (AstType.I64)))
                                          [(LowerExpr.Expr
                                              tag-state
                                              tag-value
                                              _)
                                            (match (lower-state-alloc-var
                                              tag-state)
                                              [(LowerAlloc.Alloc
                                                  eq-alloc
                                                  eq-var)
                                                (match (lower-state-fresh-label
                                                  (lower-state-emit
                                                    eq-alloc
                                                    (CompilerIrInstr.BinOp
                                                      eq-var
                                                      CompilerIrBinOp.Eq
                                                      tag-value
                                                      (CompilerIrValue.I64
                                                        (compiler-registry-handle-child-index
                                                          handle))
                                                      (AstType.I64)))
                                                  "payload_ok")
                                                  [(LowerLabel.Label
                                                      ok-state
                                                      ok-label)
                                                    (match (lower-bind-variant-payloads
                                                      ctx
                                                      (lower-state-finish-block
                                                        (lower-state-emit
                                                          ok-state
                                                          (CompilerIrInstr.Branch
                                                            (CompilerIrValue.Var
                                                              eq-var)
                                                            ok-label
                                                            fail-label))
                                                        ok-label)
                                                      env
                                                      type-env
                                                      field-value
                                                      nested-args
                                                      nested-fields
                                                      mode
                                                      (lower-enum-type-name-id-or
                                                        resolved
                                                        -1)
                                                      (lower-enum-type-name-or-empty
                                                        resolved)
                                                      nested-name-str
                                                      (lower-variant-handle-name-id-or
                                                        ctx
                                                        handle
                                                        nested-name)
                                                      0
                                                      8
                                                      fail-label
                                                      ;; nested enum: rare path, so
                                                      ;; computing its group-ness once
                                                      ;; here is cheap.
                                                      (lower-type-register-group?
                                                        ctx
                                                        resolved))
                                                      [(ResultLowerEnv.Ok
                                                          nested-state
                                                          nested-env
                                                          nested-type-env)
                                                        (lower-bind-variant-payloads
                                                          ctx
                                                          nested-state
                                                          nested-env
                                                          nested-type-env
                                                          base
                                                          rest-patterns
                                                          rest-types
                                                          mode
                                                          enum-id
                                                          enum-name
                                                          variant-name
                                                          variant-name-id
                                                          next-index
                                                          next-cursor
                                                          fail-label
                                                          scrut-reg-group?)]
                                                      [(ResultLowerEnv.Err
                                                          message)
                                                        (ResultLowerEnv.Err
                                                          message)])])])])])])))]))))]
                [_
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: unsupported enum payload pattern")))]))))))))

(define (lower-borrowed-payload-ref-expr
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [offset : i64]
  [field-ty : AstType]
  [ref-ty : AstType]) : LowerExpr
  (let
    [referent-ty : AstType (tc-borrow-referent-type field-ty)]
    (if (or
      (lower-str-ref-type? ctx ref-ty)
      (lower-borrow-place-value-reference? ctx referent-ty))
      (let
        [loaded : LowerExpr (lower-load-at-offset state base offset field-ty)]
        (match loaded
          [(LowerExpr.Expr loaded-state value _)
            (LowerExpr.Expr loaded-state value ref-ty)]))
      (match (lower-gep-byte state base offset)
        [(LowerExpr.Expr ptr-state ptr _) (LowerExpr.Expr ptr-state ptr ref-ty)]))))

(define (lower-bind-borrowed-variant-payloads
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [borrow-lifetime : i64]
  [base : CompilerIrValue]
  [patterns : AstPatternList]
  [types : AstTypeList]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [fail-label : String]) : ResultLowerEnv
  (if (ast-pattern-list-empty? (& patterns))
    (if (ast-type-list-empty? (& types))
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: enum payload pattern arity mismatch"))))
    (let
      [pattern : AstPattern
        (ast-pattern-list-get (& patterns) 0 (ast-pattern-fallback))]
      [rest-patterns : AstPatternList (ast-pattern-list-tail patterns)]
      (if (ast-type-list-empty? (& types))
        (ResultLowerEnv.Err
          (box (lower-diagnostic "lower: enum payload pattern arity mismatch")))
        (let
          [ty-id : i64 (ast-type-list-get (& types) 0 (ast-type-id-fallback))]
          [rest-types : AstTypeList (ast-type-list-slice types 1)]
          [ty : AstType (tc-context-type-get ctx ty-id)]
          [field-ctx : TcContext
            (tc-context-with-owner-name-module
              ctx
              (lower-variant-owner-id-for-enum ctx enum-id variant-name-id))]
          [resolved : AstType (tc-resolve-type field-ctx ty)]
          [default-offset : i64
            (lower-align-up cursor (lower-type-align ctx resolved))]
          [offset : i64
            (lower-variant-payload-offset
              ctx
              mode
              enum-id
              enum-name
              variant-name
              variant-name-id
              index
              cursor
              resolved)]
          [next-cursor : i64 (+ default-offset (lower-type-size ctx resolved))]
          [next-index : i64 (+ index 1)]
          (if (< offset 0)
            (ResultLowerEnv.Err
              (box
                (lower-diagnostic
                  (string.append
                    "lower: inline enum layout missing payload for "
                    variant-name))))
            (match pattern
              [(AstPattern.Wildcard)
                (lower-bind-borrowed-variant-payloads
                  ctx
                  state
                  env
                  type-env
                  borrow-lifetime
                  base
                  rest-patterns
                  rest-types
                  mode
                  enum-id
                  enum-name
                  variant-name
                  variant-name-id
                  next-index
                  next-cursor
                  fail-label)]
              [(AstPattern.Binding name)
                (let
                  [ref-ty : AstType
                    (tc-borrowed-field-ref-type borrow-lifetime resolved)]
                  [ref-expr : LowerExpr
                    (lower-borrowed-payload-ref-expr
                      ctx
                      state
                      base
                      offset
                      resolved
                      ref-ty)]
                  (match ref-expr
                    [(LowerExpr.Expr ref-state ref-value _)
                      (match ref-value
                        [(CompilerIrValue.Var field-var)
                          (lower-bind-borrowed-variant-payloads
                            ctx
                            ref-state
                            (sym_i64_env.sym-i64-bind-id env name field-var)
                            (tc-bind-id type-env name ref-ty)
                            borrow-lifetime
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label)]
                        [_
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                "lower: internal borrowed enum payload reference failed")))])]))]
              [(AstPattern.Var name _)
                (let
                  [ref-ty : AstType
                    (tc-borrowed-field-ref-type borrow-lifetime resolved)]
                  [ref-expr : LowerExpr
                    (lower-borrowed-payload-ref-expr
                      ctx
                      state
                      base
                      offset
                      resolved
                      ref-ty)]
                  (match ref-expr
                    [(LowerExpr.Expr ref-state ref-value _)
                      (match ref-value
                        [(CompilerIrValue.Var field-var)
                          (lower-bind-borrowed-variant-payloads
                            ctx
                            ref-state
                            (sym_i64_env.sym-i64-bind-id env name field-var)
                            (tc-bind-id type-env name ref-ty)
                            borrow-lifetime
                            base
                            rest-patterns
                            rest-types
                            mode
                            enum-id
                            enum-name
                            variant-name
                            variant-name-id
                            next-index
                            next-cursor
                            fail-label)]
                        [_
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                "lower: internal borrowed enum payload reference failed")))])]))]
              [(AstPattern.Literal lit)
                (if (lower-literal-payload-supported? lit)
                  (match (lower-load-at-offset state base offset resolved)
                    [(LowerExpr.Expr load-state field-value _)
                      (match (lower-literal-payload-eq
                        ctx
                        load-state
                        field-value
                        lit
                        resolved)
                        [(ResultLowerExpr.Ok lowered-eq)
                          (match lowered-eq
                            [(LowerExpr.Expr eq-state eq-value _)
                              (match (lower-state-fresh-label
                                eq-state
                                "payload_ok")
                                [(LowerLabel.Label ok-state ok-label)
                                  (lower-bind-borrowed-variant-payloads
                                    ctx
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        ok-state
                                        (CompilerIrInstr.Branch
                                          eq-value
                                          ok-label
                                          fail-label))
                                      ok-label)
                                    env
                                    type-env
                                    borrow-lifetime
                                    base
                                    rest-patterns
                                    rest-types
                                    mode
                                    enum-id
                                    enum-name
                                    variant-name
                                    variant-name-id
                                    next-index
                                    next-cursor
                                    fail-label)])])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerEnv.Err message)])])
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: unsupported enum payload literal pattern type"))))]
              [(AstPattern.Variant nested-name nested-args-box)
                (let
                  [nested-args : AstPatternList (box-get nested-args-box)]
                  [nested-name-str : String (tc-env-key-name-text nested-name)]
                  (match ctx
                    [(TcContext _ symbols registries _ _ _ _ _)
                      (let
                        [handle : i64
                          (lower-variant-handle-for-scrut-id-or
                            ctx
                            resolved
                            nested-name
                            (compiler-symbols-missing-handle))]
                        (if (not (compiler-symbols-handle-found? handle))
                          (ResultLowerEnv.Err
                            (box
                              (lower-diagnostic
                                (string.append
                                  "lower: unknown nested variant "
                                  nested-name-str))))
                          (match (compiler-registries-variant-fields-indexed
                            symbols
                            handle)
                            [(ResultAstTypeList.Err message)
                              (ResultLowerEnv.Err
                                (box (lower-diagnostic message)))]
                            [(ResultAstTypeList.Ok nested-fields)
                              (match (lower-load-at-offset
                                state
                                base
                                offset
                                resolved)
                                [(LowerExpr.Expr field-state field-value _)
                                  (match (lower-load-at-offset
                                    field-state
                                    field-value
                                    0
                                    (AstType.I64))
                                    [(LowerExpr.Expr tag-state tag-value _)
                                      (match (lower-state-alloc-var tag-state)
                                        [(LowerAlloc.Alloc eq-alloc eq-var)
                                          (match (lower-state-fresh-label
                                            (lower-state-emit
                                              eq-alloc
                                              (CompilerIrInstr.BinOp
                                                eq-var
                                                CompilerIrBinOp.Eq
                                                tag-value
                                                (CompilerIrValue.I64
                                                  (compiler-registry-handle-child-index
                                                    handle))
                                                (AstType.I64)))
                                            "payload_ok")
                                            [(LowerLabel.Label
                                                ok-state
                                                ok-label)
                                              (match (lower-bind-borrowed-variant-payloads
                                                ctx
                                                (lower-state-finish-block
                                                  (lower-state-emit
                                                    ok-state
                                                    (CompilerIrInstr.Branch
                                                      (CompilerIrValue.Var
                                                        eq-var)
                                                      ok-label
                                                      fail-label))
                                                  ok-label)
                                                env
                                                type-env
                                                borrow-lifetime
                                                field-value
                                                nested-args
                                                nested-fields
                                                mode
                                                (lower-enum-type-name-id-or
                                                  resolved
                                                  -1)
                                                (lower-enum-type-name-or-empty
                                                  resolved)
                                                nested-name-str
                                                (lower-variant-handle-name-id-or
                                                  ctx
                                                  handle
                                                  nested-name)
                                                0
                                                8
                                                fail-label)
                                                [(ResultLowerEnv.Ok
                                                    nested-state
                                                    nested-env
                                                    nested-type-env)
                                                  (lower-bind-borrowed-variant-payloads
                                                    ctx
                                                    nested-state
                                                    nested-env
                                                    nested-type-env
                                                    borrow-lifetime
                                                    base
                                                    rest-patterns
                                                    rest-types
                                                    mode
                                                    enum-id
                                                    enum-name
                                                    variant-name
                                                    variant-name-id
                                                    next-index
                                                    next-cursor
                                                    fail-label)]
                                                [(ResultLowerEnv.Err message)
                                                  (ResultLowerEnv.Err message)])])])])])])))]))]
              [_
                (ResultLowerEnv.Err
                  (box
                    (lower-diagnostic "lower: unsupported enum payload pattern")))])))))))

(define (lower-bind-match-variant-payloads
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [borrow-lifetime : TcMaybeNameId]
  [base : CompilerIrValue]
  [patterns : AstPatternList]
  [types : AstTypeList]
  [mode : CompilerLowerMode]
  [enum-id : i64]
  [enum-name : String]
  [variant-name : String]
  [variant-name-id : i64]
  [index : i64]
  [cursor : i64]
  [fail-label : String]
  [scrut-reg-group? : bool]) : ResultLowerEnv
  (match borrow-lifetime
    [(TcMaybeNameId.No)
      (lower-bind-variant-payloads
        ctx
        state
        env
        type-env
        base
        patterns
        types
        mode
        enum-id
        enum-name
        variant-name
        variant-name-id
        index
        cursor
        fail-label
        scrut-reg-group?)]
    [(TcMaybeNameId.Some lifetime)
      ;; A borrowed scrutinee is always memory-backed (matched behind a pointer),
      ;; never a 2-word register-group value, so the register-group path does not
      ;; apply here.
      (lower-bind-borrowed-variant-payloads
        ctx
        state
        env
        type-env
        lifetime
        base
        patterns
        types
        mode
        enum-id
        enum-name
        variant-name
        variant-name-id
        index
        cursor
        fail-label)]))

;; A payload subpattern is refutable when it can fail to match at run time.
;; Literals and nested enum variants are refutable; `(box ...)` follows its
;; inner pattern, while binding, var, wildcard, and tuple patterns always match.
(define (lower-pattern-refutable? [pattern : AstPattern]) : bool
  (match pattern
    [(AstPattern.Literal _) true]
    [(AstPattern.Variant name args-box)
      (if (lower-box-pattern-name? name)
        (lower-pattern-list-refutable? (box-get args-box))
        true)]
    [_ false]))

(define (lower-pattern-list-refutable? [patterns : AstPatternList]) : bool
  (lower-pattern-list-refutable-at? (& patterns) 0))

(define (lower-pattern-list-refutable-at?
  [patterns : (& patterns AstPatternList)]
  [index : i64]) : bool
  (if (>= index (struct-get patterns len))
    false
    (if (lower-pattern-refutable?
      (ast-pattern-list-get patterns index (ast-pattern-fallback)))
      true
      (lower-pattern-list-refutable-at? patterns (+ index 1)))))

(define (lower-pattern-refutable-for-type?
  [ctx : TcContext]
  [pattern : AstPattern]
  [ty : AstType]) : bool
  (match pattern
    [(AstPattern.Wildcard) false]
    [(AstPattern.Var _ _) false]
    [(AstPattern.Binding _) false]
    [(AstPattern.Tuple _) false]
    [(AstPattern.Literal _) true]
    [(AstPattern.Variant name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (if (lower-box-pattern-name? name)
          (lower-pattern-list-refutable? args)
          (match (tc-type-strip-region (tc-resolve-type ctx ty))
            [(AstType.Struct struct-name)
              (not
                (tc-struct-pattern-irrefutable?
                  ctx
                  (tc-nominal-name-id-display struct-name)
                  struct-name
                  ty
                  (tc-env-key-name-text name)
                  name
                  args))]
            [(AstType.StructArgs struct-name _)
              (not
                (tc-struct-pattern-irrefutable?
                  ctx
                  (tc-nominal-name-id-display struct-name)
                  struct-name
                  ty
                  (tc-env-key-name-text name)
                  name
                  args))]
            [_ true])))]))

(define (lower-pattern-list-refutable-for-types?
  [ctx : TcContext]
  [patterns : AstPatternList]
  [types : AstTypeList]) : bool
  (lower-pattern-list-refutable-for-types-at? ctx (& patterns) 0 types))

(define (lower-pattern-list-refutable-for-types-at?
  [ctx : TcContext]
  [patterns : (& patterns AstPatternList)]
  [index : i64]
  [types : AstTypeList]) : bool
  (if (>= index (ast-pattern-list-len patterns))
    (not (ast-type-list-empty? (& types)))
    (if (ast-type-list-empty? (& types))
      true
      (let
        [ty-id : i64 (ast-type-list-get (& types) 0 (ast-type-id-fallback))]
        [rest-types : AstTypeList (ast-type-list-slice types 1)]
        [ty : AstType (tc-context-type-get ctx ty-id)]
        (if (lower-pattern-refutable-for-type?
          ctx
          (ast-pattern-list-get patterns index (ast-pattern-fallback))
          ty)
          true
          (lower-pattern-list-refutable-for-types-at?
            ctx
            patterns
            (+ index 1)
            rest-types))))))

(define (lower-field-info-from-list
  [ctx : TcContext]
  [fields : AstFieldDefList]
  [field-name : String]
  [cursor : i64]) : ResultLowerFieldInfo
  (lower-field-info-from-list-at ctx (& fields) field-name cursor 0))

(define (lower-field-info-from-list-at
  [ctx : TcContext]
  [fields : (& fields AstFieldDefList)]
  [field-name : String]
  [cursor : i64]
  [index : i64]) : ResultLowerFieldInfo
  (if (>= index (struct-get fields len))
    (ResultLowerFieldInfo.Err
      (box
        (lower-diagnostic
          (string.append "lower: unknown struct field " field-name))))
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def name ty _)
        (let
          [resolved : AstType (tc-resolve-type ctx ty)]
          [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
          (if (string.eq (tc-env-key-name-text name) field-name)
            (ResultLowerFieldInfo.Ok (LowerFieldInfo.Info offset resolved))
            (lower-field-info-from-list-at
              ctx
              fields
              field-name
              (+ offset (lower-type-size ctx resolved))
              (+ index 1))))])))

(define (lower-field-info-from-repr-c-list
  [fields : TcReprCFieldLayoutList]
  [field-name : String]) : ResultLowerFieldInfo
  (match fields
    [(TcReprCFieldLayoutList.Nil)
      (ResultLowerFieldInfo.Err
        (box
          (lower-diagnostic
            (string.append "lower: unknown struct field " field-name))))]
    [(TcReprCFieldLayoutList.Cons field rest)
      (match field
        [(TcReprCFieldLayout.Field name ty offset)
          (if (string.eq name field-name)
            (ResultLowerFieldInfo.Ok (LowerFieldInfo.Info offset ty))
            (lower-field-info-from-repr-c-list (box-get rest) field-name))])]))

(define (lower-struct-field-info
  [ctx : TcContext]
  [struct-id : i64]
  [struct-name : String]
  [field-name : String]) : ResultLowerFieldInfo
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module-id ctx struct-id)]
    (if (lower-struct-repr-c-id? field-ctx struct-id)
      (match (tc-repr-c-struct-layout-id field-ctx struct-name struct-id)
        [(ResultTcReprCLayout.Ok layout)
          (lower-field-info-from-repr-c-list
            (tc-repr-c-layout-fields layout)
            field-name)]
        [(ResultTcReprCLayout.Err message)
          (ResultLowerFieldInfo.Err (box (lower-diagnostic message)))])
      (match (lower-struct-fields-id field-ctx struct-id struct-name)
        [(ResultAstFieldDefList.Ok fields)
          (lower-field-info-from-list field-ctx fields field-name 0)]
        [(ResultAstFieldDefList.Err message)
          (ResultLowerFieldInfo.Err (box (lower-diagnostic message)))]))))

(define (lower-struct-field-info-for-mode
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [struct-id : i64]
  [struct-name : String]
  [field-name-id : i64]
  [field-name : String]) : ResultLowerFieldInfo
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module-id ctx struct-id)]
    (if (lower-mode-inline-aggregates? mode)
      (match (lower-struct-field-info
        field-ctx
        struct-id
        struct-name
        field-name)
        [(ResultLowerFieldInfo.Ok info)
          (match info
            [(LowerFieldInfo.Info _ field-ty)
              (match (tc-inline-aggregate-layout-for-id field-ctx struct-id)
                [(ResultTcInlineAggregateLayout.Ok layout)
                  (let
                    [offset : i64
                      (tc-inline-aggregate-layout-field-offset-id
                        layout
                        field-name-id)]
                    (if (< offset 0)
                      (ResultLowerFieldInfo.Err
                        (box
                          (lower-diagnostic
                            (string.append
                              "lower: inline struct layout missing field "
                              field-name))))
                      (ResultLowerFieldInfo.Ok
                        (LowerFieldInfo.Info offset field-ty))))]
                [(ResultTcInlineAggregateLayout.Err message)
                  (ResultLowerFieldInfo.Err (box (lower-diagnostic message)))])])]
        [(ResultLowerFieldInfo.Err message) (ResultLowerFieldInfo.Err message)])
      (lower-struct-field-info field-ctx struct-id struct-name field-name))))

(define (lower-var-id
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? id)
      (ResultLowerExpr.Ok (LowerExpr.Expr state (CompilerIrValue.Var id) ty))
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (CompilerIrValue.Global (lower-resolve-name-symbol-id state name-id))
          ty)))))

(define (lower-register-address-taken-local-read
  [ctx : TcContext]
  [state : LowerState]
  [local-id : i64]
  [ty : AstType]) : ResultLowerExpr
  (if (and
    (lower-type-register-resident? ctx ty)
    (lower-state-register-address-taken-var? state local-id))
    (match (lower-state-alloc-var state)
      [(LowerAlloc.Alloc addr-state addr-var)
        (match (lower-load-register-resident-from-ptr
          ctx
          (lower-state-emit
            addr-state
            (CompilerIrInstr.AddrOf addr-var local-id))
          (CompilerIrValue.Var addr-var)
          ty)
          [(LowerExpr.Expr load-state loaded _)
            (ResultLowerExpr.Ok (LowerExpr.Expr load-state loaded ty))])])
    (ResultLowerExpr.Ok
      (LowerExpr.Expr state (CompilerIrValue.Var local-id) ty))))

(define (lower-var-id-storage-aware
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : AstType]) : ResultLowerExpr
  (let
    [id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? id)
      (lower-register-address-taken-local-read ctx state id ty)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (CompilerIrValue.Global (lower-resolve-name-symbol-id state name-id))
          ty)))))

(define (lower-disarm-move-aware-resource-name
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]) : LowerState
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name-id
        (compiler-symbols-missing-handle))]
    (if (not (compiler-symbols-handle-found? local-id))
      state
      (let
        [live-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            (lower-cleanup-live-name-id local-id)
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? live-id)
          (lower-state-emit
            state
            (CompilerIrInstr.Mov
              live-id
              (CompilerIrValue.Bool false)
              (AstType.Bool)))
          state)))))

(define (lower-disarm-move-aware-resource-expr
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [expr : AstExpr]) : LowerState
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name) (lower-disarm-move-aware-resource-name state env name)]
    [_ state]))

(define (lower-function-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func _ _) true]
    [_ false]))

(define (lower-atomic-public-symbol? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_store")
    (string.eq symbol "tl_atomic_i64_add")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (lower-atomic-public-name? [name : String]) : bool
  (or
    (string.eq name "atomic-i64-load")
    (string.eq name "atomic-i64-store!")
    (string.eq name "atomic-i64-add!")
    (string.eq name "atomic-i64-fetch-add!")
    (string.eq name "atomic-i32-load")
    (string.eq name "atomic-i32-store!")
    (string.eq name "atomic-i32-add!")
    (string.eq name "atomic-i32-fetch-add!")))

(define (lower-atomic-name-candidate? [name : String]) : bool
  (or
    (lower-atomic-public-name? name)
    (lower-atomic-public-symbol? name)
    (and
      (tc-name-qualified? name)
      (lower-atomic-public-name? (tc-qualified-name-base name)))))

(define (lower-atomic-symbol-for-name [name : String]) : String
  (cond
    [(string.eq name "atomic-i64-load") "tl_atomic_i64_load"]
    [(string.eq name "atomic-i64-store!") "tl_atomic_i64_store"]
    [(string.eq name "atomic-i64-add!") "tl_atomic_i64_add"]
    [(string.eq name "atomic-i64-fetch-add!") "tl_atomic_i64_fetch_add"]
    [(string.eq name "atomic-i32-load") "tl_atomic_i32_load"]
    [(string.eq name "atomic-i32-store!") "tl_atomic_i32_store"]
    [(string.eq name "atomic-i32-add!") "tl_atomic_i32_add"]
    [(string.eq name "atomic-i32-fetch-add!") "tl_atomic_i32_fetch_add"]
    [else ""]))

(define (lower-atomic-import-path? [path : String]) : bool
  (or (string.eq path "stdlib/atomic.tl") (string.eq path "atomic.tl")))

(define (lower-program-imports-atomic? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Import decl-meta (AstImportSpec.Spec _ path _ _ _))
            (or
              (lower-atomic-import-path? path)
              (lower-program-imports-atomic? rest))]
          [_ (lower-program-imports-atomic? rest)]))]))

(define (lower-context-imports-atomic? [ctx : TcContext]) : bool
  (match ctx
    [(TcContext program _ _ _ _ _ _ _)
      (match program
        [(AstProgram.Program decls-box)
          (lower-program-imports-atomic? (box-get decls-box))])]))

(define (lower-atomic-imported-symbol-for-name
  [ctx : TcContext]
  [name : String]) : String
  (if (and (lower-atomic-public-name? name) (lower-context-imports-atomic? ctx))
    (lower-atomic-symbol-for-name name)
    ""))

(define (lower-atomic-extern-symbol-from-handle
  [symbols : CompilerSymbols]
  [handle : i64]) : String
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern))
    (match (compiler-symbols-decl-at-index
      symbols
      (compiler-symbol-handle-index handle))
      [(ResultAstDecl.Ok decl)
        (match decl
          [(AstDecl.Extern decl-meta _ kind metadata _)
            (match kind
              [(AstExternKind.Function)
                (let
                  [symbol : String
                    (ast-extern-metadata-symbol (box-get metadata))]
                  (if (lower-atomic-public-symbol? symbol)
                    symbol
                    ""))]
              [(AstExternKind.Value) ""])]
          [_ ""])]
      [(ResultAstDecl.Err _) ""])
    ""))

(define (lower-atomic-extern-symbol-lookup-id
  [symbols : CompilerSymbols]
  [lookup-id : i64]) : String
  (let
    [handle : i64
      (compiler-symbols-lookup-value-id-or
        symbols
        lookup-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (lower-atomic-extern-symbol-from-handle symbols handle)
      "")))

(define (lower-atomic-extern-symbol-for-name-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : String
  (if (not (lower-atomic-name-candidate? name))
    ""
    (let
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [direct : String (lower-atomic-extern-symbol-lookup-id symbols name-id)]
      [source-name : String (tc-hygiene-global-symbol-name name)]
      (if (> (string.string-length direct) 0)
        direct
        (lower-atomic-imported-symbol-for-name ctx source-name)))))

(define (lower-atomic-extern-symbol-for-func
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [func : AstExpr]) : String
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or raw-name raw-name)]
        [raw-text : String (intern-str source-id)]
        (match (if (or
          (macro-hygiene-global-id? raw-name)
          (tc-hygiene-global-name? raw-text))
          (TcNameLookup.Ok
            (if (macro-hygiene-global-id? raw-name)
              (lower-hygiene-source-name-in-context-id ctx type-env raw-name)
              (tc-hygiene-global-call-name raw-text))
            source-id)
          (if (tc-source-slash-qualified-id? raw-text source-id)
            (TcNameLookup.Ok raw-text source-id)
            (tc-source-name-lookup-key-with-field-check-lookup
              ctx
              type-env
              raw-text
              source-id
              true)))
          [(TcNameLookup.Ok lookup-name lookup-id)
            (lower-atomic-extern-symbol-for-name-id ctx lookup-name lookup-id)]
          [(TcNameLookup.Err _) ""]))]
    [_ ""]))

;; The symbol table is keyed by the module key (module/name) and the bare source
;; name alias, never by the `::` logical/mangled name returned by
;; lower-resolve-name. Look up the bare source name so a function used as a value
;; lowers to CompilerIrValue.Function (its closure-descriptor address) instead of falling
;; through to CompilerIrValue.Global (which would load the function's code bytes and
;; miscompile an indirect call through it).
(define (lower-symbol-function-value-id? [ctx : TcContext] [name-id : i64]) : bool
  (let
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [handle : i64
      (compiler-symbols-lookup-value-id-or
        symbols
        name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (let
        [kind : i64 (compiler-symbol-handle-kind handle)]
        (or
          (= kind (compiler-symbol-kind-function-define))
          (= kind (compiler-symbol-kind-defdispatch))
          (and
            (= kind (compiler-symbol-kind-extern))
            (match (compiler-symbols-decl-at-index
              symbols
              (compiler-symbol-handle-index handle))
              [(ResultAstDecl.Ok decl)
                (match decl
                  [(AstDecl.Extern decl-meta _ extern-kind _ _)
                    (match extern-kind
                      [(AstExternKind.Function) true]
                      [(AstExternKind.Value) false])]
                  [_ false])]
              [(ResultAstDecl.Err _) false]))))
      false)))

(define (lower-extern-value-decl-id? [ctx : TcContext] [name-id : i64]) : bool
  (let
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [handle : i64
      (compiler-symbols-lookup-value-id-or
        symbols
        name-id
        (compiler-symbols-missing-handle))]
    (if (and
      (compiler-symbols-handle-found? handle)
      (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern)))
      (match (compiler-symbols-decl-at-index
        symbols
        (compiler-symbol-handle-index handle))
        [(ResultAstDecl.Ok decl)
          (match decl
            [(AstDecl.Extern decl-meta _ extern-kind _ _)
              (match extern-kind
                [(AstExternKind.Function) false]
                [(AstExternKind.Value) true])]
            [_ false])]
        [(ResultAstDecl.Err _) false])
      false)))

(define (lower-function-value-or-var-id
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [ty : AstType]) : ResultLowerExpr
  (cond
    [(sym_i64_env.sym-i64-contains-id env name-id)
      (lower-var-id state env name-id ty)]
    [(lower-extern-value-decl-id? ctx name-id)
      (match (lower-var-id state env name-id ty)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr value-state value _)
              (match (lower-state-alloc-var value-state)
                [(LowerAlloc.Alloc allocated var-id)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-state-emit
                        allocated
                        (CompilerIrInstr.Mov var-id value ty))
                      (CompilerIrValue.Var var-id)
                      ty))])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(and
        (lower-function-type? ty)
        (lower-symbol-function-value-id? ctx name-id))
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (CompilerIrValue.Function
            (lower-resolve-name-symbol-id state name-id))
          ty))]
    [else (lower-var-id state env name-id ty)]))

(define (lower-lambda-captures-env?
  [outer-env : sym_i64_env.SymI64Env]
  [body : AstExpr]
  [bound : TcStringList]) : bool
  (match outer-env
    [(sym_i64_env.SymI64Nil) false]
    [(sym_i64_env.SymI64Bind name-id _ rest)
      (if (tc-expr-uses-free-name? body (tc-env-key-name-text name-id) bound)
        true
        (lower-lambda-captures-env? (box-get rest) body bound))]))

(define (lower-lambda-ret-type
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [lambda-expr : AstExpr]
  [maybe-ret : AstMaybeType]) : ResultTcType
  (match maybe-ret
    [(AstMaybeType.Some ty) (ResultTcType.Ok (tc-resolve-type ctx ty))]
    [(AstMaybeType.No)
      (match (tc-expr ctx type-env lambda-expr)
        [(ResultTcType.Ok ty)
          (match (tc-type-strip-region ty)
            [(AstType.Func _ ret)
              (ResultTcType.Ok (tc-context-type-get ctx ret))]
            [_
              (ResultTcType.Err "lower: lambda did not typecheck as a function")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]))

(define (lower-capture-list-contains-name?
  [captures : LowerCaptureList]
  [name-id : i64]) : bool
  (let
    [items : (Array LowerCapture) (struct-get captures items)]
    [count : i64 (struct-get captures count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (array-ref items index)
          [(LowerCapture.Capture capture-name-id _ _ _)
            (if (= capture-name-id name-id)
              (set! found true)
              (set! index (+ index 1)))]))
      found)))

(define (lower-capture-list-count [captures : LowerCaptureList]) : i64
  (struct-get captures count))

(define (lower-capture-list-empty) : LowerCaptureList
  (LowerCaptureList (make-array LowerCapture 0) 0))

(define (lower-capture-list-add-front
  [captures : LowerCaptureList]
  [capture : LowerCapture]) : LowerCaptureList
  (let
    [items : (Array LowerCapture) (struct-get captures items)]
    [count : i64 (struct-get captures count)]
    (begin
      (array-push! items capture)
      (LowerCaptureList items (+ count 1)))))

(define (lower-capture-list-storage-entry?
  [captures : LowerCaptureList]
  [index : i64]
  [name-id : i64]
  [var-id : i64]
  [offset : i64]) : bool
  (if (or (< index 0) (>= index (struct-get captures count)))
    false
    (match (array-ref (struct-get captures items) index)
      [(LowerCapture.Capture capture-name-id capture-var-id _ capture-offset)
        (and
          (= capture-name-id name-id)
          (= capture-var-id var-id)
          (= capture-offset offset))])))

(define (lower-unsupported-capture-message) : String
  "lower: unsupported lambda capture type")

(define (lower-capture-support-message [ctx : TcContext] [ty : AstType]) : String
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Ref _ _) (lower-reference-support-message)]
    [(AstType.MutRef _ _) (lower-reference-support-message)]
    [_ (lower-unsupported-capture-message)]))

(define (lower-supported-capture-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.F64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.F32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Ref _ _) true]
    [(AstType.Func _ _) true]
    [(AstType.Tuple _) true]
    [(AstType.Array _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.String) true]
    [(AstType.DynArray _) true]
    [_ false]))

(define (lower-capture-env-size [cursor : i64]) : i64
  (lower-align-up
    (if (= cursor 0)
      1
      cursor)
    8))

(define (lower-capture-slot-type [ty : AstType]) : AstType
  (match (tc-type-strip-region ty)
    [(AstType.Func _ _) (AstType.U64)]
    [(AstType.Tuple _) (AstType.U64)]
    [(AstType.Array _ _) (AstType.U64)]
    [(AstType.Enum _) (AstType.U64)]
    [(AstType.EnumArgs _ _) (AstType.U64)]
    [(AstType.Struct _) (AstType.U64)]
    [(AstType.StructArgs _ _) (AstType.U64)]
    [(AstType.String) (AstType.U64)]
    [(AstType.DynArray _) (AstType.U64)]
    [_ ty]))

(define (lower-fixed-array-storage-size
  [ctx : TcContext]
  [elem-ty : AstType]
  [count : i64]) : i64
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    [extent : i64 (* count elem-size)]
    (lower-align-up
      (if (= extent 0)
        1
        extent)
      8)))

(define (lower-capture-snapshot-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (match (tc-resolve-type ctx ty)
    [(AstType.String) (lower-capture-snapshot-string-value state value)]
    [(AstType.DynArray elem-ty)
      (lower-capture-snapshot-dynarray-value
        ctx
        state
        value
        (tc-type-without-regions (tc-context-type-get ctx elem-ty))
        ty)]
    [(AstType.Tuple elem-tys)
      (lower-capture-snapshot-tuple-value
        ctx
        state
        env
        type-env
        value
        (box-get elem-tys)
        ty)]
    [(AstType.Array elem-ty count)
      (lower-capture-snapshot-fixed-array-value
        ctx
        state
        env
        type-env
        value
        (tc-type-without-regions (tc-context-type-get ctx elem-ty))
        count
        ty)]
    ;; A register-resident aggregate is word-class POD held in a register;
    ;; its capture snapshot is the value itself (nothing on the heap to copy).
    [(AstType.Struct name)
      (if (lower-type-register-resident? ctx ty)
        (ResultLowerExpr.Ok (LowerExpr.Expr state value ty))
        (lower-capture-snapshot-struct-value
          ctx
          state
          env
          type-env
          value
          (tc-nominal-name-id-display name)
          ty))]
    [(AstType.StructArgs name _)
      (lower-capture-snapshot-struct-value
        ctx
        state
        env
        type-env
        value
        (tc-nominal-name-id-display name)
        ty)]
    [(AstType.Enum name)
      (if (lower-type-register-resident? ctx ty)
        (ResultLowerExpr.Ok (LowerExpr.Expr state value ty))
        (lower-capture-snapshot-enum-value
          ctx
          state
          env
          type-env
          value
          name
          (tc-nominal-name-id-display name)
          ty))]
    [(AstType.EnumArgs name _)
      (lower-capture-snapshot-enum-value
        ctx
        state
        env
        type-env
        value
        name
        (tc-nominal-name-id-display name)
        ty)]
    [_ (ResultLowerExpr.Ok (LowerExpr.Expr state value ty))]))

(define (lower-capture-snapshot-string-value
  [state : LowerState]
  [value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state value)
    [(LowerStringFields.Fields fields-state ptr len)
      (lower-substring-call-runtime
        fields-state
        ptr
        (CompilerIrValue.I64 0)
        len)]))

(define (lower-capture-snapshot-dynarray-copy
  [ctx : TcContext]
  [state : LowerState]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]) : LowerState
  (if (= elem-size 0)
    state
    (lower-array-push-copy-loop ctx state old-buf new-buf len elem-ty)))

(define (lower-capture-snapshot-dynarray-finish
  [ctx : TcContext]
  [state : LowerState]
  [old-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [buf-var : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 result-ty)
    [(LowerExpr.Expr arr-state arr-value _)
      (let
        [copied-state : LowerState
          (lower-capture-snapshot-dynarray-copy
            ctx
            arr-state
            old-buf
            (CompilerIrValue.Var buf-var)
            len
            elem-ty
            elem-size)]
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-store-at-offset
              (lower-store-at-offset
                copied-state
                arr-value
                0
                (CompilerIrValue.Var buf-var)
                (AstType.U64))
              arr-value
              8
              len
              (AstType.I64))
            arr-value
            result-ty)))]))

(define (lower-capture-snapshot-dynarray-value
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-load-at-offset state value 8 (AstType.I64))
    [(LowerExpr.Expr len-state len _)
      (match (lower-load-at-offset len-state value 0 (AstType.U64))
        [(LowerExpr.Expr ptr-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            (match (if (= elem-size 0)
              (LowerExpr.Expr ptr-state (CompilerIrValue.I64 1) (AstType.I64))
              (lower-emit-binop
                ptr-state
                CompilerIrBinOp.Mul
                len
                (CompilerIrValue.I64 elem-size)
                (AstType.I64)))
              [(LowerExpr.Expr byte-state byte-count _)
                (match (lower-state-alloc-var byte-state)
                  [(LowerAlloc.Alloc buf-alloc buf-var)
                    (lower-capture-snapshot-dynarray-finish
                      ctx
                      (lower-state-emit
                        buf-alloc
                        (CompilerIrInstr.Call
                          buf-var
                          (lower-tl-alloc-symbol)
                          (CompilerIrCallArgs.One byte-count)
                          (AstType.U64)))
                      old-buf
                      len
                      elem-ty
                      elem-size
                      buf-var
                      result-ty)])]))])]))

(define (lower-capture-snapshot-type-list
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [types : AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-capture-snapshot-type-list-at
    ctx
    state
    env
    type-env
    src
    dst
    (& types)
    cursor
    0))

(define (lower-capture-snapshot-type-list-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [types : (& types AstTypeList)]
  [cursor : i64]
  [index : i64]) : ResultLowerState
  (if (>= index (ast-type-list-len types))
    (ResultLowerState.Ok state)
    (let
      [ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      [size : i64 (lower-type-size ctx resolved)]
      (if (> size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          resolved
          (lower-state-mode state))
          [(LowerExpr.Expr load-state field-value _)
            (match (lower-capture-snapshot-value
              ctx
              load-state
              env
              type-env
              field-value
              resolved)
              [(ResultLowerExpr.Ok snap)
                (match snap
                  [(LowerExpr.Expr snap-state snap-value _)
                    (lower-capture-snapshot-type-list-at
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        snap-state
                        dst
                        offset
                        snap-value
                        resolved
                        size)
                      env
                      type-env
                      src
                      dst
                      types
                      (+ offset size)
                      (+ index 1))])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (lower-capture-snapshot-type-list-at
          ctx
          state
          env
          type-env
          src
          dst
          types
          (+ offset size)
          (+ index 1))))))

(define (lower-capture-snapshot-tuple-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-tys : AstTypeList]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage
    state
    (lower-type-list-storage-size ctx elem-tys)
    result-ty)
    [(LowerExpr.Expr dst-state dst _)
      (match (lower-capture-snapshot-type-list
        ctx
        dst-state
        env
        type-env
        value
        dst
        elem-tys
        0)
        [(ResultLowerState.Ok done-state)
          (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
        [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-capture-snapshot-fixed-array-elems
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [index : i64]
  [count : i64]) : ResultLowerState
  (if (>= index count)
    (ResultLowerState.Ok state)
    (let
      [offset : i64 (* index elem-size)]
      (if (> elem-size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          elem-ty
          (lower-state-mode state))
          [(LowerExpr.Expr load-state elem-value _)
            (match (lower-capture-snapshot-value
              ctx
              load-state
              env
              type-env
              elem-value
              elem-ty)
              [(ResultLowerExpr.Ok snap)
                (match snap
                  [(LowerExpr.Expr snap-state snap-value _)
                    (lower-capture-snapshot-fixed-array-elems
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        snap-state
                        dst
                        offset
                        snap-value
                        elem-ty
                        elem-size)
                      env
                      type-env
                      src
                      dst
                      elem-ty
                      elem-size
                      (+ index 1)
                      count)])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (lower-capture-snapshot-fixed-array-elems
          ctx
          state
          env
          type-env
          src
          dst
          elem-ty
          elem-size
          (+ index 1)
          count)))))

(define (lower-capture-snapshot-fixed-array-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [count : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    (match (lower-reserve-heap-storage
      state
      (lower-fixed-array-storage-size ctx elem-ty count)
      result-ty)
      [(LowerExpr.Expr dst-state dst _)
        (match (lower-capture-snapshot-fixed-array-elems
          ctx
          dst-state
          env
          type-env
          value
          dst
          elem-ty
          elem-size
          0
          count)
          [(ResultLowerState.Ok done-state)
            (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
          [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])))

(define (lower-capture-snapshot-struct-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [struct-name : String]
  [result-ty : AstType]) : ResultLowerExpr
  (if (lower-struct-repr-c-id? ctx (lower-struct-type-name-id-or result-ty -1))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic
          "lower: repr-c aggregate lambda captures need repr-c snapshot lowering")))
    (match (lower-struct-fields-id
      ctx
      (lower-struct-type-name-id-or result-ty -1)
      struct-name)
      [(ResultAstFieldDefList.Ok fields)
        (let
          [field-types : AstTypeList (tc-field-type-list ctx fields)]
          (match (lower-reserve-heap-storage
            state
            (lower-type-list-storage-size ctx field-types)
            result-ty)
            [(LowerExpr.Expr dst-state dst _)
              (match (lower-capture-snapshot-type-list
                ctx
                dst-state
                env
                type-env
                value
                dst
                field-types
                0)
                [(ResultLowerState.Ok done-state)
                  (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
                [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))]
      [(ResultAstFieldDefList.Err message)
        (ResultLowerExpr.Err (box (lower-diagnostic message)))])))

(define (lower-capture-snapshot-enum-variants
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [tag : CompilerIrValue]
  [variants : AstVariantDefList]
  [index : i64]
  [done-label : String]) : ResultLowerState
  (if (>= index (struct-get (& variants) len))
    (ResultLowerState.Ok
      (lower-state-finish-block
        (lower-state-emit state (CompilerIrInstr.Jump done-label))
        done-label))
    (let
      [variant : AstVariantDef
        (ast-variant-def-list-get (& variants) index (ast-variant-def-fallback))]
      (match (lower-state-fresh-label state "capture_enum_variant")
        [(LowerLabel.Label variant-label-state variant-label)
          (match (lower-state-fresh-label
            variant-label-state
            "capture_enum_next")
            [(LowerLabel.Label next-label-state next-label)
              (match (lower-state-alloc-var next-label-state)
                [(LowerAlloc.Alloc cond-state cond-var)
                  (let
                    [branch-state : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            cond-state
                            (CompilerIrInstr.BinOp
                              cond-var
                              CompilerIrBinOp.Eq
                              tag
                              (CompilerIrValue.I64 index)
                              (AstType.I64)))
                          (CompilerIrInstr.Branch
                            (CompilerIrValue.Var cond-var)
                            variant-label
                            next-label))
                        variant-label)]
                    (match variant
                      [(AstVariantDef.Def _ fields _)
                        (match (lower-capture-snapshot-type-list
                          ctx
                          branch-state
                          env
                          type-env
                          src
                          dst
                          fields
                          8)
                          [(ResultLowerState.Ok copied-state)
                            (lower-capture-snapshot-enum-variants
                              ctx
                              (lower-state-finish-block
                                (lower-state-emit
                                  copied-state
                                  (CompilerIrInstr.Jump done-label))
                                next-label)
                              env
                              type-env
                              src
                              dst
                              tag
                              variants
                              (+ index 1)
                              done-label)]
                          [(ResultLowerState.Err message)
                            (ResultLowerState.Err message)])]))])])]))))

(define (lower-capture-snapshot-enum-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [enum-name-id : i64]
  [enum-name : String]
  [result-ty : AstType]) : ResultLowerExpr
  (match ctx
    [(TcContext _ _ _ _ _ _ _ _)
      (match (tc-context-enum-variants-id ctx enum-name-id enum-name)
        [(ResultAstVariantDefList.Ok variants)
          (match (lower-reserve-heap-storage
            state
            (lower-enum-storage-size ctx enum-name-id enum-name)
            result-ty)
            [(LowerExpr.Expr dst-state dst _)
              (match (lower-load-at-offset dst-state value 0 (AstType.I64))
                [(LowerExpr.Expr tag-state tag _)
                  (match (lower-state-fresh-label tag-state "capture_enum_done")
                    [(LowerLabel.Label done-state done-label)
                      (match (lower-capture-snapshot-enum-variants
                        ctx
                        (lower-store-at-offset
                          done-state
                          dst
                          0
                          tag
                          (AstType.I64))
                        env
                        type-env
                        value
                        dst
                        tag
                        variants
                        0
                        done-label)
                        [(ResultLowerState.Ok final-state)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr final-state dst result-ty))]
                        [(ResultLowerState.Err message)
                          (ResultLowerExpr.Err message)])])])])]
        [(ResultAstVariantDefList.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic message)))])]))

(define (lower-capture-plan-scan
  [ctx : TcContext]
  [outer-env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [body : AstExpr]
  [bound : TcStringList]
  [cursor : i64]
  [captures : LowerCaptureList]
  [origin : AstExpr]) : ResultLowerCapturePlan
  (match outer-env
    [(sym_i64_env.SymI64Nil)
      (ResultLowerCapturePlan.Ok
        (LowerCapturePlan.Plan captures (lower-capture-env-size cursor)))]
    [(sym_i64_env.SymI64Bind name-id var-id rest)
      (let
        [name : String (tc-env-key-name-text name-id)]
        (if (or
          (lower-capture-list-contains-name? captures name-id)
          (not (tc-expr-uses-free-name? body name bound)))
          (lower-capture-plan-scan
            ctx
            (box-get rest)
            type-env
            body
            bound
            cursor
            captures
            origin)
          (match (tc-lookup-id type-env name-id)
            [(ResultTcType.Err message)
              (ResultLowerCapturePlan.Err
                (box (lower-diagnostic-at-expr origin message)))]
            [(ResultTcType.Ok found-ty)
              (let
                [capture-ty : AstType
                  (tc-type-without-regions (tc-resolve-type ctx found-ty))]
                (if (lower-supported-capture-type? ctx capture-ty)
                  (let
                    [slot-ty : AstType (lower-capture-slot-type capture-ty)]
                    [offset : i64
                      (lower-align-up cursor (lower-type-align ctx slot-ty))]
                    ;; A register-group capture occupies 16 bytes inline (two
                    ;; words), not an 8-byte handle slot.
                    [slot-size : i64
                      (if (lower-type-register-group? ctx capture-ty)
                        16
                        (lower-type-size ctx slot-ty))]
                    (lower-capture-plan-scan
                      ctx
                      (box-get rest)
                      type-env
                      body
                      bound
                      (+ offset slot-size)
                      (lower-capture-list-add-front
                        captures
                        (LowerCapture.Capture name-id var-id capture-ty offset))
                      origin))
                  (ResultLowerCapturePlan.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        (lower-capture-support-message ctx capture-ty))))))])))]))

(define (lower-capture-plan
  [ctx : TcContext]
  [outer-env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]
  [origin : AstExpr]) : ResultLowerCapturePlan
  (lower-capture-plan-scan
    ctx
    outer-env
    type-env
    body
    (tc-param-bound-names params)
    0
    (lower-capture-list-empty)
    origin))

(define (lower-store-captures-from-index
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [env-value : CompilerIrValue]
  [items : (Array LowerCapture)]
  [index : i64]) : ResultLowerState
  (if (< index 0)
    (ResultLowerState.Ok state)
    (let
      [capture : LowerCapture (array-ref items index)]
      (match capture
        [(LowerCapture.Capture _ var-id capture-ty offset)
          (match (lower-capture-snapshot-value
            ctx
            state
            env
            type-env
            (CompilerIrValue.Var var-id)
            capture-ty)
            [(ResultLowerExpr.Ok snap)
              (match snap
                [(LowerExpr.Expr snap-state snap-value _)
                  (lower-store-captures-from-index
                    ctx
                    (if (lower-type-register-group? ctx capture-ty)
                      ;; A captured 2-word group stores both words.
                      (match (lower-gep-byte snap-state env-value offset)
                        [(LowerExpr.Expr gep-state ptr _)
                          (lower-store-group-at-ptr
                            ctx
                            gep-state
                            ptr
                            snap-value
                            capture-ty)])
                      (lower-store-at-offset
                        snap-state
                        env-value
                        offset
                        snap-value
                        (lower-capture-slot-type capture-ty)))
                    env
                    type-env
                    env-value
                    items
                    (- index 1))])]
            [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])]))))

(define (lower-store-captures
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [env-value : CompilerIrValue]
  [captures : LowerCaptureList]) : ResultLowerState
  (lower-store-captures-from-index
    ctx
    state
    env
    type-env
    env-value
    (struct-get captures items)
    (- (struct-get captures count) 1)))

(define (lower-store-capturing-lambda-descriptor
  [state : LowerState]
  [lambda-name : i64]
  [env-value : CompilerIrValue]
  [expr-ty : AstType]) : LowerExpr
  (match (lower-reserve-heap-storage state 16 expr-ty)
    [(LowerExpr.Expr desc-state desc-value _)
      (LowerExpr.Expr
        (lower-store-at-offset
          (lower-store-at-offset
            desc-state
            desc-value
            0
            (CompilerIrValue.GlobalAddr lambda-name)
            (AstType.U64))
          desc-value
          8
          env-value
          (AstType.U64))
        desc-value
        expr-ty)]))

(define (lower-capturing-lambda-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [lambda-name : i64]
  [captures : LowerCaptureList]
  [capture-size : i64]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state capture-size (AstType.U64))
    [(LowerExpr.Expr env-state env-value _)
      (match (lower-store-captures
        ctx
        env-state
        env
        type-env
        env-value
        captures)
        [(ResultLowerState.Ok captured-state)
          (match (lower-store-capturing-lambda-descriptor
            captured-state
            lambda-name
            env-value
            expr-ty)
            [(LowerExpr.Expr desc-state desc-value desc-ty)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr desc-state desc-value desc-ty))])]
        [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-load-captures-from-index
  [ctx : TcContext]
  [state : LowerState]
  [env-value : CompilerIrValue]
  [items : (Array LowerCapture)]
  [index : i64]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerEnv
  (if (< index 0)
    (ResultLowerEnv.Ok state env type-env)
    (let
      [capture : LowerCapture (array-ref items index)]
      (match capture
        [(LowerCapture.Capture name-id _ capture-ty offset)
          (match (if (lower-type-register-group? ctx capture-ty)
            ;; A captured 2-word group loads both words and repacks.
            (match (lower-gep-byte state env-value offset)
              [(LowerExpr.Expr gep-state ptr _)
                (lower-load-group-from-ptr ctx gep-state ptr capture-ty)])
            (lower-load-at-offset
              state
              env-value
              offset
              (lower-capture-slot-type capture-ty)))
            [(LowerExpr.Expr loaded-state loaded-value _)
              (match loaded-value
                [(CompilerIrValue.Var loaded-var)
                  (lower-load-captures-from-index
                    ctx
                    loaded-state
                    env-value
                    items
                    (- index 1)
                    (sym_i64_env.sym-i64-bind-id env name-id loaded-var)
                    (tc-bind-id type-env name-id capture-ty))]
                [_
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: capture load did not materialize a variable")))])])]))))

(define (lower-load-captures
  [ctx : TcContext]
  [state : LowerState]
  [env-value : CompilerIrValue]
  [captures : LowerCaptureList]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerEnv
  (lower-load-captures-from-index
    ctx
    state
    env-value
    (struct-get captures items)
    (- (struct-get captures count) 1)
    env
    type-env))

(define (lower-captured-param-list [ctx : TcContext] [params : AstParamList]) : CompilerIrParamList
  (compiler-ir-param-cons
    (CompilerIrParam.Param "__tl_env" (AstType.U64) 0)
    (lower-param-list ctx params 1)))

(define (lower-function-with-captures
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [params : AstParamList]
  [ret : AstType]
  [body : AstExpr]
  [captures : LowerCaptureList]
  [spans : CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (if (or
    (lower-param-list-contains-unsupported-reference? ctx params)
    (not (lower-supported-reference-type? ctx ret)))
    (ResultLowerFunction.Err
      (box (lower-diagnostic (lower-reference-support-message))))
    (let
      [param-count : i64 (+ 1 (lower-param-count params))]
      [ret-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ret))]
      ;; sret ABI for closures: hidden result-slot pointer at var
      ;; `param-count` (just past env + real params).
      [sret-needed : bool
        (and
          (lower-mode-inline-aggregates? mode)
          (lower-type-inline-struct-or-enum? ctx ret-ty)
          (not (lower-type-register-resident? ctx ret-ty)))]
      [sret-var : i64
        (if sret-needed
          param-count
          (- 0 1))]
      [logical-name-text : String (compiler-ir-symbol-text logical-name)]
      [function-spans : CompilerSourceSpans
        (lower-record-function-span spans logical-name-text body)]
      [state : LowerState
        (LowerState.State
          (if sret-needed
            (+ param-count 1)
            param-count)
          0
          0
          "entry"
          (compiler-ir-instr-builder-new)
          (compiler-ir-block-builder-new)
          (compiler-ir-function-builder-new)
          logical-name-text
          (box function-spans)
          names
          type-cache
          mode
          (lower_i64_i64_map.with-capacity 8)
          1
          param-count)]
      (match (lower-load-captures
        ctx
        state
        (CompilerIrValue.Var 0)
        captures
        (sym_i64_env.sym-i64-empty)
        (tc-bind-return-type top-env ret-ty))
        [(ResultLowerEnv.Ok captured-state captured-env captured-type-env)
          (let
            [env : sym_i64_env.SymI64Env
              (lower-bind-params params 1 captured-env)]
            [type-env : TcTypeEnv (tc-bind-params ctx captured-type-env params)]
            (match (lower-tail-expr
              ctx
              captured-state
              env
              type-env
              body
              ret-ty
              sret-var)
              [(ResultLowerState.Ok final-state)
                (ResultLowerFunction.Ok
                  (lower-state-build-functions-with
                    final-state
                    (CompilerIrFunction.Function
                      logical-name
                      (if (>= sret-var 0)
                        (lower-param-list-append-sret
                          (lower-captured-param-list ctx params)
                          sret-var)
                        (lower-captured-param-list ctx params))
                      ret-ty
                      (lower-state-next-var final-state)
                      (lower-state-build-function-blocks final-state)))
                  (lower-state-spans final-state))]
              [(ResultLowerState.Err message) (ResultLowerFunction.Err message)]))]
        [(ResultLowerEnv.Err message) (ResultLowerFunction.Err message)]))))

(define (lower-lambda-noncapturing
  [ctx : TcContext]
  [state : LowerState]
  [type-env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-lambda-ret-type ctx type-env origin maybe-ret)
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]
    [(ResultTcType.Ok ret-ty)
      (match (lower-state-fresh-lambda-name state)
        [(LowerLambdaName.Name named-state lambda-name)
          (match (lower-function
            ctx
            type-env
            (lower-state-type-cache state)
            lambda-name
            params
            ret-ty
            body
            (lower-state-spans named-state)
            (lower-state-names named-state)
            (lower-state-mode named-state))
            [(ResultLowerFunction.Ok lambda-functions lambda-spans)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-state-add-functions
                    named-state
                    lambda-functions
                    lambda-spans)
                  (CompilerIrValue.Function lambda-name)
                  expr-ty))]
            [(ResultLowerFunction.Err message) (ResultLowerExpr.Err message)])])]))

(define (lower-lambda-capturing
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-lambda-ret-type ctx type-env origin maybe-ret)
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]
    [(ResultTcType.Ok ret-ty)
      (match (lower-capture-plan ctx env type-env params body origin)
        [(ResultLowerCapturePlan.Err message) (ResultLowerExpr.Err message)]
        [(ResultLowerCapturePlan.Ok plan)
          (match plan
            [(LowerCapturePlan.Plan captures capture-size)
              (match (lower-state-fresh-lambda-name state)
                [(LowerLambdaName.Name named-state lambda-name)
                  (match (lower-function-with-captures
                    ctx
                    type-env
                    (lower-state-type-cache named-state)
                    lambda-name
                    params
                    ret-ty
                    body
                    captures
                    (lower-state-spans named-state)
                    (lower-state-names named-state)
                    (lower-state-mode named-state))
                    [(ResultLowerFunction.Ok lambda-functions lambda-spans)
                      (match (lower-capturing-lambda-value
                        ctx
                        (lower-state-add-functions
                          named-state
                          lambda-functions
                          lambda-spans)
                        env
                        type-env
                        lambda-name
                        captures
                        capture-size
                        expr-ty)
                        [(ResultLowerExpr.Ok lowered)
                          (match lowered
                            [(LowerExpr.Expr value-state value value-ty)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr value-state value value-ty))])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])]
                    [(ResultLowerFunction.Err message)
                      (ResultLowerExpr.Err message)])])])])]))

(define (lower-lambda
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (lower-lambda-captures-env? env body (tc-param-bound-names params))
    (lower-lambda-capturing
      ctx
      state
      env
      type-env
      params
      maybe-ret
      body
      origin
      expr-ty)
    (lower-lambda-noncapturing
      ctx
      state
      type-env
      params
      maybe-ret
      body
      origin
      expr-ty)))

(define (lower-return-maybe [value : CompilerIrValue] [ty : AstType]) : CompilerIrMaybeValue
  (match ty
    [(AstType.Unit) CompilerIrMaybeValue.No]
    [_ (CompilerIrMaybeValue.Some value)]))

(define (lower-private-name-id [kind : i64] [var-id : i64]) : i64
  ;; Parser ids and their typechecker marker keys occupy the ranges nearest
  ;; zero. Lower-only bindings use this disjoint structural namespace.
  (- 0 (+ (* (intern-capacity) 4) (+ (* var-id 16) kind))))

(define (lower-private-name-kind [name-id : i64]) : i64
  (% (- (- 0 name-id) (* (intern-capacity) 4)) 16))

(define (lower-private-name-value [name-id : i64]) : i64
  (/ (- (- 0 name-id) (* (intern-capacity) 4)) 16))

(define (lower-cleanup-marker-id) : i64
  (lower-private-name-id 1 0))

(define (lower-region-reset-marker-id) : i64
  (lower-private-name-id 2 0))

(define (lower-spmd-reduce-acc-id) : i64
  (lower-private-name-id 3 0))

(define (lower-spmd-reduce-end-id) : i64
  (lower-private-name-id 4 0))

(define (lower-spmd-reduce-val-id) : i64
  (lower-private-name-id 5 0))

(define (lower-spmd-reduce-current-id) : i64
  (lower-private-name-id 6 0))

(define (lower-spmd-reduce-start-id) : i64
  (lower-private-name-id 15 0))

(define (lower-spmd-reduce-uniform-id) : i64
  (lower-private-name-id 16 0))

(define (lower-spmd-scan-acc-id) : i64
  (lower-private-name-id 7 0))

(define (lower-spmd-scan-end-id) : i64
  (lower-private-name-id 8 0))

(define (lower-spmd-scan-val-id) : i64
  (lower-private-name-id 9 0))

(define (lower-cleanup-hidden-name-id [var-id : i64]) : i64
  (lower-private-name-id 10 var-id))

(define (lower-cleanup-live-name-id [var-id : i64]) : i64
  ;; Kind 1 value 0 is the cleanup-stack marker. Positive values are its
  ;; per-resource liveness bindings, disjoint from every allocated var id.
  (lower-private-name-id 1 (+ var-id 1)))

(define (lower-region-hidden-name-id [var-id : i64]) : i64
  (lower-private-name-id 11 var-id))

(define (lower-arena-restore-hidden-name-id [var-id : i64]) : i64
  (lower-private-name-id 12 var-id))

(define (lower-while-exit-label-id [label-number : i64]) : i64
  (lower-private-name-id 13 label-number))

(define (lower-while-header-label-id [label-number : i64]) : i64
  (lower-private-name-id 14 label-number))

(define (lower-loop-label-name [name-id : i64]) : String
  (let
    [kind : i64 (lower-private-name-kind name-id)]
    [prefix : String
      (if (= kind 13)
        "while_exit"
        (if (= kind 14)
          "while_header"
          "invalid_loop_label"))]
    (string.append
      (string.append prefix ".")
      (string.int->string (lower-private-name-value name-id)))))

(define (lower-cleanup-metadata-type
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : AstType
  (ast-ty-tuple
    (ast-type-cons
      (AstType.Var hidden-name-id)
      (ast-type-cons (AstType.Var cleanup-name-id) (ast-type-list-new)))))

(define (lower-region-reset-metadata-type [hidden-name-id : i64]) : AstType
  (AstType.Var hidden-name-id))

(define (lower-arena-restore-metadata-type [hidden-name-id : i64]) : AstType
  (ast-ty-tuple
    (ast-type-cons (AstType.Var hidden-name-id) (ast-type-list-new))))

(define (lower-type-env-push-cleanup
  [type-env : TcTypeEnv]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : TcTypeEnv
  (tc-bind-id
    type-env
    (lower-cleanup-marker-id)
    (lower-cleanup-metadata-type hidden-name-id cleanup-name-id)))

(define (lower-type-env-push-move-aware-cleanup
  [type-env : TcTypeEnv]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]
  [live-name-id : i64]) : TcTypeEnv
  (tc-bind-id
    type-env
    (lower-cleanup-marker-id)
    (ast-ty-tuple
      (ast-type-cons
        (AstType.Var hidden-name-id)
        (ast-type-cons
          (AstType.Var cleanup-name-id)
          (ast-type-cons (AstType.Var live-name-id) (ast-type-list-new)))))))

(define (lower-type-env-push-region-reset
  [type-env : TcTypeEnv]
  [hidden-name-id : i64]) : TcTypeEnv
  (tc-bind-id
    type-env
    (lower-region-reset-marker-id)
    (lower-region-reset-metadata-type hidden-name-id)))

(define (lower-type-env-push-arena-restore
  [type-env : TcTypeEnv]
  [hidden-name-id : i64]) : TcTypeEnv
  (tc-bind-id
    type-env
    (lower-region-reset-marker-id)
    (lower-arena-restore-metadata-type hidden-name-id)))

(define (lower-cleanup-name-id-from-expr [cleanup : AstExpr]) : ResultTcExprId
  (match (ast-expr-unspan cleanup)
    [(AstExpr.Var name) (ResultTcExprId.Ok name)]
    [_
      (ResultTcExprId.Err
        "lower: resource cleanup must be a direct function name")]))

(define (lower-emit-cleanup-call
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : ResultLowerState
  (let
    [resource-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        hidden-name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? resource-id)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (ResultLowerState.Ok
            (lower-state-emit
              allocated
              (CompilerIrInstr.Call
                var-id
                (lower-resolve-call-name-id allocated env cleanup-name-id)
                (CompilerIrCallArgs.One (CompilerIrValue.Var resource-id))
                (AstType.Unit))))])
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: missing resource cleanup binding"))))))

(define (lower-emit-cleanup-call-if-live
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]
  [live-name-id : i64]) : ResultLowerState
  (let
    [live-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        live-name-id
        (compiler-symbols-missing-handle))]
    (if (not (compiler-symbols-handle-found? live-id))
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: missing resource liveness binding")))
      (match (lower-state-fresh-label state "cleanup_live")
        [(LowerLabel.Label cleanup-label-state cleanup-label)
          (match (lower-state-fresh-label cleanup-label-state "cleanup_done")
            [(LowerLabel.Label labels-state done-label)
              (let
                [cleanup-state : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      labels-state
                      (CompilerIrInstr.Branch
                        (CompilerIrValue.Var live-id)
                        cleanup-label
                        done-label))
                    cleanup-label)]
                (match (lower-emit-cleanup-call
                  cleanup-state
                  env
                  hidden-name-id
                  cleanup-name-id)
                  [(ResultLowerState.Ok called-state)
                    (ResultLowerState.Ok
                      (lower-state-finish-block
                        (lower-state-emit
                          called-state
                          (CompilerIrInstr.Jump done-label))
                        done-label))]
                  [(ResultLowerState.Err message)
                    (ResultLowerState.Err message)]))])]))))

(define (lower-emit-region-reset
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]) : ResultLowerState
  (let
    [mark-var : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        hidden-name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? mark-var)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated reset-var)
          (ResultLowerState.Ok
            (lower-state-emit
              allocated
              (CompilerIrInstr.Call
                reset-var
                (lower-tl-region-reset-symbol)
                (CompilerIrCallArgs.One (CompilerIrValue.Var mark-var))
                (AstType.Unit))))])
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: missing region reset binding"))))))

(define (lower-emit-arena-restore
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-id : i64]) : ResultLowerState
  (let
    [arena-var : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        hidden-name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? arena-var)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated restore-var)
          (ResultLowerState.Ok
            (lower-state-emit
              allocated
              (CompilerIrInstr.Call
                restore-var
                (lower-tl-arena-set-symbol)
                (CompilerIrCallArgs.One (CompilerIrValue.Var arena-var))
                (AstType.Unit))))])
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: missing arena restore binding"))))))

(define (lower-cleanup-stack-empty) : LowerCleanupStack
  (LowerCleanupStack (make-array i64 0) (make-array i64 0) (make-array i64 0) 0))

(define (lower-cleanup-stack-push
  [cleanups : LowerCleanupStack]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : LowerCleanupStack
  (let
    [hidden-name-ids : (Array i64) (struct-get cleanups hidden-name-ids)]
    [cleanup-name-ids : (Array i64) (struct-get cleanups cleanup-name-ids)]
    [live-name-ids : (Array i64) (struct-get cleanups live-name-ids)]
    [count : i64 (struct-get cleanups count)]
    (begin
      (array-push! hidden-name-ids hidden-name-id)
      (array-push! cleanup-name-ids cleanup-name-id)
      (array-push! live-name-ids 0)
      (LowerCleanupStack
        hidden-name-ids
        cleanup-name-ids
        live-name-ids
        (+ count 1)))))

(define (lower-cleanup-stack-push-move-aware
  [cleanups : LowerCleanupStack]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]
  [live-name-id : i64]) : LowerCleanupStack
  (let
    [hidden-name-ids : (Array i64) (struct-get cleanups hidden-name-ids)]
    [cleanup-name-ids : (Array i64) (struct-get cleanups cleanup-name-ids)]
    [live-name-ids : (Array i64) (struct-get cleanups live-name-ids)]
    [count : i64 (struct-get cleanups count)]
    (begin
      (array-push! hidden-name-ids hidden-name-id)
      (array-push! cleanup-name-ids cleanup-name-id)
      (array-push! live-name-ids live-name-id)
      (LowerCleanupStack
        hidden-name-ids
        cleanup-name-ids
        live-name-ids
        (+ count 1)))))

(define (lower-cleanup-stack-count [cleanups : LowerCleanupStack]) : i64
  (struct-get cleanups count))

(define (lower-cleanup-stack-entry?
  [cleanups : LowerCleanupStack]
  [index : i64]
  [hidden-name-id : i64]
  [cleanup-name-id : i64]) : bool
  (if (or (< index 0) (>= index (struct-get cleanups count)))
    false
    (and
      (= (array-ref (struct-get cleanups hidden-name-ids) index) hidden-name-id)
      (=
        (array-ref (struct-get cleanups cleanup-name-ids) index)
        cleanup-name-id))))

(define (lower-emit-cleanup-stack-at
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [hidden-name-ids : (Array i64)]
  [cleanup-name-ids : (Array i64)]
  [live-name-ids : (Array i64)]
  [index : i64]) : ResultLowerState
  (if (< index 0)
    (ResultLowerState.Ok state)
    (let
      [live-name-id : i64 (array-ref live-name-ids index)]
      (match (if (= live-name-id 0)
        (lower-emit-cleanup-call
          state
          env
          (array-ref hidden-name-ids index)
          (array-ref cleanup-name-ids index))
        (lower-emit-cleanup-call-if-live
          state
          env
          (array-ref hidden-name-ids index)
          (array-ref cleanup-name-ids index)
          live-name-id))
        [(ResultLowerState.Ok next-state)
          (lower-emit-cleanup-stack-at
            next-state
            env
            hidden-name-ids
            cleanup-name-ids
            live-name-ids
            (- index 1))]
        [(ResultLowerState.Err message) (ResultLowerState.Err message)]))))

(define (lower-emit-cleanup-stack
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [cleanups : LowerCleanupStack]) : ResultLowerState
  (lower-emit-cleanup-stack-at
    state
    env
    (struct-get cleanups hidden-name-ids)
    (struct-get cleanups cleanup-name-ids)
    (struct-get cleanups live-name-ids)
    (- (struct-get cleanups count) 1)))

(define (lower-emit-cleanup-marker-tuple
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [types : AstTypeList]) : ResultLowerState
  (if (or
    (= (ast-type-list-len (& types)) 2)
    (= (ast-type-list-len (& types)) 3))
    (let
      [hidden-ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get (& types) 0 (ast-type-id-fallback)))]
      [cleanup-ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get (& types) 1 (ast-type-id-fallback)))]
      (match hidden-ty
        [(AstType.Var hidden-name)
          (match cleanup-ty
            [(AstType.Var cleanup-name)
              (if (= (ast-type-list-len (& types)) 2)
                (lower-emit-cleanup-call state env hidden-name cleanup-name)
                (match (tc-context-type-get
                  ctx
                  (ast-type-list-get (& types) 2 (ast-type-id-fallback)))
                  [(AstType.Var live-name)
                    (lower-emit-cleanup-call-if-live
                      state
                      env
                      hidden-name
                      cleanup-name
                      live-name)]
                  [_ (ResultLowerState.Ok state)]))]
            [_ (ResultLowerState.Ok state)])]
        [_ (ResultLowerState.Ok state)]))
    (ResultLowerState.Ok state)))

(define (lower-emit-arena-restore-marker-tuple
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [types : AstTypeList]) : ResultLowerState
  (if (= (ast-type-list-len (& types)) 1)
    (let
      [hidden-ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get (& types) 0 (ast-type-id-fallback)))]
      (match hidden-ty
        [(AstType.Var hidden-name)
          (lower-emit-arena-restore state env hidden-name)]
        [_ (ResultLowerState.Ok state)]))
    (ResultLowerState.Ok state)))

;; Emit the cleanup/region-reset calls a binding env keeps active. This
;; walks the whole TcTypeEnv chain once per scope exit; it used to be a
;; tail-recursive walk, but the inline-aggregate TCO guard declines
;; frame reuse here, so deep envs stacked one ~12KB frame per binding (8,164
;; frames = 100MB of the measured 502MB stack peak). Iterate instead.
(define (lower-emit-active-exits-with
  [ctx : TcContext]
  [cleanup-marker-id : i64]
  [region-reset-marker-id : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerState
  (let
    [cur-env : TcTypeEnv type-env]
    [cur-state : LowerState state]
    [result : ResultLowerState
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: internal active-exits walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (tc-type-env-spine-step cur-env)
          [(TcTypeEnvSpineStep.Done)
            (begin
              (set! result (ResultLowerState.Ok cur-state))
              (set! done true))]
          [(TcTypeEnvSpineStep.Cache rest-env) (set! cur-env rest-env)]
          [(TcTypeEnvSpineStep.Bind key ty rest-env)
            (begin
              ;; The hygiene global boundary closes the function-local scope:
              ;; cleanup/region-reset markers are only ever bound above it by
              ;; body forms (with-resource/with-arena), never in the module or
              ;; top env below. Stop there instead of walking the whole
              ;; program spine (~24.6k binds per return on a self-compile).
              ;; lint-allow: nested-if-ladder
              (if (= key (tc-hygiene-global-boundary-id))
                (begin
                  (set! result (ResultLowerState.Ok cur-state))
                  (set! done true))
                (if (= key cleanup-marker-id)
                  (match ty
                    [(AstType.Tuple types)
                      (match (lower-emit-cleanup-marker-tuple
                        ctx
                        cur-state
                        env
                        (box-get types))
                        [(ResultLowerState.Ok next-state)
                          (set! cur-state next-state)]
                        [(ResultLowerState.Err message)
                          (begin
                            (set! result (ResultLowerState.Err message))
                            (set! done true))])]
                    [_ unit])
                  (if (= key region-reset-marker-id)
                    (match ty
                      [(AstType.Var hidden-name)
                        (match (lower-emit-region-reset
                          cur-state
                          env
                          hidden-name)
                          [(ResultLowerState.Ok next-state)
                            (set! cur-state next-state)]
                          [(ResultLowerState.Err message)
                            (begin
                              (set! result (ResultLowerState.Err message))
                              (set! done true))])]
                      [(AstType.Tuple types)
                        (match (lower-emit-arena-restore-marker-tuple
                          ctx
                          cur-state
                          env
                          (box-get types))
                          [(ResultLowerState.Ok next-state)
                            (set! cur-state next-state)]
                          [(ResultLowerState.Err message)
                            (begin
                              (set! result (ResultLowerState.Err message))
                              (set! done true))])]
                      [_ unit])
                    unit)))
              (if done
                unit
                (set! cur-env rest-env)))]))
      result)))

(define (lower-emit-active-exits
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerState
  (lower-emit-active-exits-with
    ctx
    (lower-cleanup-marker-id)
    (lower-region-reset-marker-id)
    state
    env
    type-env))

(define (lower-loop-target-type
  [break-label-id : i64]
  [continue-label-id : i64]) : AstType
  (AstType.Tuple
    (box
      (ast-type-cons
        (AstType.Var break-label-id)
        (ast-type-cons (AstType.Var continue-label-id) (ast-type-list-new))))))

(define (lower-enter-loop-target
  [type-env : TcTypeEnv]
  [break-label-id : i64]
  [continue-label-id : i64]) : TcTypeEnv
  (tc-bind-id
    type-env
    (tc-loop-target-id)
    (lower-loop-target-type break-label-id continue-label-id)))

(define (lower-loop-target-missing [origin : AstExpr] [form : String]) : ResultLowerLoopTarget
  (ResultLowerLoopTarget.Err
    (box
      (lower-diagnostic-at-expr
        origin
        (string.append
          "typecheck: "
          (string.append form " requires enclosing scalar while"))))))

(define (lower-loop-target-malformed [origin : AstExpr]) : ResultLowerLoopTarget
  (ResultLowerLoopTarget.Err
    (box (lower-diagnostic-at-expr origin "lower: malformed loop target"))))

(define (lower-current-loop-target-from-types
  [origin : AstExpr]
  [break-ty : AstType]
  [continue-ty : AstType]) : ResultLowerLoopTarget
  (match break-ty
    [(AstType.Var break-name)
      (match continue-ty
        [(AstType.Var continue-name)
          (ResultLowerLoopTarget.Ok
            (LowerLoopTarget.Target
              (lower-loop-label-name break-name)
              (lower-loop-label-name continue-name)))]
        [_ (lower-loop-target-malformed origin)])]
    [_ (lower-loop-target-malformed origin)]))

(define (lower-current-loop-target
  [ctx : TcContext]
  [origin : AstExpr]
  [type-env : TcTypeEnv]
  [form : String]) : ResultLowerLoopTarget
  (match (tc-env-marker-type type-env (tc-loop-target-id))
    [(AstMaybeType.Some ty)
      (match ty
        [(AstType.Tuple types-box)
          (let
            [types : AstTypeList (box-get types-box)]
            (if (= (ast-type-list-len (& types)) 2)
              (let
                [break-ty : AstType
                  (tc-context-type-get
                    ctx
                    (ast-type-list-get (& types) 0 (ast-type-id-fallback)))]
                [continue-ty : AstType
                  (tc-context-type-get
                    ctx
                    (ast-type-list-get (& types) 1 (ast-type-id-fallback)))]
                (lower-current-loop-target-from-types
                  origin
                  break-ty
                  continue-ty))
              (lower-loop-target-malformed origin)))]
        [_ (lower-loop-target-missing origin form)])]
    [(AstMaybeType.No) (lower-loop-target-missing origin form)]))

(define (lower-emit-active-loop-exits-with
  [ctx : TcContext]
  [cleanup-marker-id : i64]
  [region-reset-marker-id : i64]
  [loop-target-id : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerState
  (let
    [cur-env : TcTypeEnv type-env]
    [cur-state : LowerState state]
    [result : ResultLowerState
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: internal active-loop-exits walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (tc-type-env-spine-step cur-env)
          [(TcTypeEnvSpineStep.Done)
            (begin
              (set! result (ResultLowerState.Ok cur-state))
              (set! done true))]
          [(TcTypeEnvSpineStep.Cache rest-env) (set! cur-env rest-env)]
          [(TcTypeEnvSpineStep.Bind key ty rest-env)
            (begin
              ;; lint-allow: nested-if-ladder
              (if (= key loop-target-id)
                (begin
                  (set! result (ResultLowerState.Ok cur-state))
                  (set! done true))
                (if (= key cleanup-marker-id)
                  (match ty
                    [(AstType.Tuple types)
                      (match (lower-emit-cleanup-marker-tuple
                        ctx
                        cur-state
                        env
                        (box-get types))
                        [(ResultLowerState.Ok next-state)
                          (set! cur-state next-state)]
                        [(ResultLowerState.Err message)
                          (begin
                            (set! result (ResultLowerState.Err message))
                            (set! done true))])]
                    [_ unit])
                  (if (= key region-reset-marker-id)
                    (match ty
                      [(AstType.Var hidden-name)
                        (match (lower-emit-region-reset
                          cur-state
                          env
                          hidden-name)
                          [(ResultLowerState.Ok next-state)
                            (set! cur-state next-state)]
                          [(ResultLowerState.Err message)
                            (begin
                              (set! result (ResultLowerState.Err message))
                              (set! done true))])]
                      [(AstType.Tuple types)
                        (match (lower-emit-arena-restore-marker-tuple
                          ctx
                          cur-state
                          env
                          (box-get types))
                          [(ResultLowerState.Ok next-state)
                            (set! cur-state next-state)]
                          [(ResultLowerState.Err message)
                            (begin
                              (set! result (ResultLowerState.Err message))
                              (set! done true))])]
                      [_ unit])
                    unit)))
              (if done
                unit
                (set! cur-env rest-env)))]))
      result)))

(define (lower-emit-active-loop-exits
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]) : ResultLowerState
  (lower-emit-active-loop-exits-with
    ctx
    (lower-cleanup-marker-id)
    (lower-region-reset-marker-id)
    (tc-loop-target-id)
    state
    env
    type-env))

(define (lower-loop-control-form
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [origin : AstExpr]
  [form : String]) : ResultLowerExpr
  (match (lower-current-loop-target ctx origin type-env form)
    [(ResultLowerLoopTarget.Ok target)
      (match target
        [(LowerLoopTarget.Target break-label continue-label)
          (match (lower-emit-active-loop-exits ctx state env type-env)
            [(ResultLowerState.Ok exit-state)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-state-emit-at-expr
                    exit-state
                    (CompilerIrInstr.Jump
                      (if (string.eq form "break")
                        break-label
                        continue-label))
                    origin)
                  CompilerIrValue.Unit
                  (AstType.Never)))]
            [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerLoopTarget.Err message) (ResultLowerExpr.Err message)]))

(define (lower-return-form
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-current-return-type type-env)
    [(ResultTcType.Ok return-ty)
      (match (lower-expr-expected ctx state env type-env value return-ty value)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr value-state value-ir _)
              (match (lower-return-abi-value ctx value-state value-ir return-ty)
                [(ResultLowerExpr.Ok return-copy)
                  (match return-copy
                    [(LowerExpr.Expr return-state return-value _)
                      (match (lower-emit-active-exits
                        ctx
                        return-state
                        env
                        type-env)
                        [(ResultLowerState.Ok cleanup-state)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (lower-state-emit-at-expr
                                cleanup-state
                                (CompilerIrInstr.Return
                                  (lower-return-maybe return-value return-ty))
                                origin)
                              CompilerIrValue.Unit
                              (AstType.Never)))]
                        [(ResultLowerState.Err message)
                          (ResultLowerExpr.Err message)])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(ResultTcType.Err _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "typecheck: return requires enclosing function")))]))

(define (lower-load-single-payload
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Unit) (LowerExpr.Expr state CompilerIrValue.Unit resolved)]
      ;; A Result/Option payload (offset 8 past the i64 tag) can be an
      ;; inline struct/enum; materialize it via the inline-aware load.
      [_
        (lower-load-inline-value-at-offset
          ctx
          state
          base
          8
          resolved
          (lower-state-mode state))])))

(define (lower-result-info-variant-handle-or
  [ctx : TcContext]
  [info : TcResultInfo]
  [variant-id : i64]
  [fallback : i64]) : i64
  (let
    [enum-name-id : i64 (tc-result-info-enum-id info)]
    [qualified-module-id : i64 (tc-qualified-name-module-id enum-name-id)]
    [module-id : i64
      (if (>= qualified-module-id 0)
        qualified-module-id
        (tc-context-module-id ctx))]
    (if (or (< enum-name-id 0) (< variant-id 0))
      fallback
      (compiler-registries-lookup-variant-key-id-or
        (tc-context-registries ctx)
        (compiler-symbol-module-key-id-by-id
          module-id
          (compiler-enum-qualified-variant-name-id
            (tc-qualified-name-base-id enum-name-id)
            variant-id))
        fallback))))

(define (lower-return-result-err
  [ctx : TcContext]
  [state : LowerState]
  [return-info : TcResultInfo]
  [payload : CompilerIrValue]) : ResultLowerState
  (match ctx
    [(TcContext _ _ registries _ _ _ _ _)
      (let
        [enum-name-id : i64 (tc-result-info-enum-id return-info)]
        [enum-name : String (tc-nominal-name-id-display enum-name-id)]
        [err-id : i64 (tc-result-info-err-id return-info)]
        [err-name : String
          (tc-qualified-variant-name enum-name (tc-env-key-name-text err-id))]
        [err-ty : AstType
          (tc-type-without-regions (tc-result-info-err-type return-info))]
        [handle : i64
          (lower-result-info-variant-handle-or
            ctx
            return-info
            err-id
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (lower-reserve-heap-storage
            state
            (lower-enum-storage-size ctx enum-name-id enum-name)
            (AstType.Enum enum-name-id))
            [(LowerExpr.Expr base-state base _)
              (let
                [tag-state : LowerState
                  (lower-store-at-offset
                    base-state
                    base
                    0
                    (CompilerIrValue.I64
                      (compiler-registry-handle-child-index handle))
                    (AstType.I64))]
                [payload-state : LowerState
                  (match err-ty
                    [(AstType.Unit) tag-state]
                    ;; An inline struct/enum err payload must be
                    ;; byte-copied into the err slot, not scalar-stored.
                    [_
                      (lower-store-inline-value-at-offset
                        ctx
                        tag-state
                        base
                        8
                        payload
                        err-ty
                        (lower-type-size ctx err-ty))])]
                [ret-ty : AstType (AstType.Enum enum-name-id)]
                ;; When the function's result enum is register-resident
                ;; the caller reads the return value from registers, so load
                ;; the constructed enum back out of the buffer (word or
                ;; 2-word group) instead of returning the buffer pointer.
                (if (lower-type-register-resident? ctx ret-ty)
                  (match (lower-load-inline-value-at-offset
                    ctx
                    payload-state
                    base
                    0
                    ret-ty
                    (lower-state-mode payload-state))
                    [(LowerExpr.Expr loaded-state loaded _)
                      (ResultLowerState.Ok
                        (lower-state-emit
                          loaded-state
                          (CompilerIrInstr.Return
                            (lower-return-maybe loaded ret-ty))))])
                  (ResultLowerState.Ok
                    (lower-state-emit
                      payload-state
                      (CompilerIrInstr.Return (lower-return-maybe base ret-ty))))))])
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " err-name))))))]))

;; The try tag/payload reads below address the operand as MEMORY. A
;; register-resident Result/Option (e.g. 16-byte (Ok i64)/(Err i64)) is carried
;; as word(s), so spill it to a temp inline slot first and continue with the
;; slot address; otherwise the tag load dereferences the packed value.
(define (lower-try-spill-resident-operand
  [ctx : TcContext]
  [lowered : ResultLowerExpr]) : ResultLowerExpr
  (match lowered
    [(ResultLowerExpr.Ok expr)
      (match expr
        [(LowerExpr.Expr state value ty)
          (if (lower-type-register-resident? ctx ty)
            (match (lower-copy-inline-aggregate-to-inline ctx state value ty)
              [(ResultLowerExpr.Ok spilled)
                (match spilled
                  [(LowerExpr.Expr spill-state slot _)
                    (ResultLowerExpr.Ok (LowerExpr.Expr spill-state slot ty))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (ResultLowerExpr.Ok expr))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-try-finish
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [result-value : CompilerIrValue]
  [operand-info : TcResultInfo]
  [return-info : TcResultInfo]
  [ok-label : String]
  [err-label : String]) : ResultLowerExpr
  (let
    [err-start : LowerState (lower-state-finish-block state err-label)]
    (match (lower-load-single-payload
      ctx
      err-start
      result-value
      (tc-result-info-err-type operand-info))
      [(LowerExpr.Expr err-payload-state err-payload _)
        (match (lower-emit-active-exits ctx err-payload-state env type-env)
          [(ResultLowerState.Ok cleanup-state)
            (match (lower-return-result-err
              ctx
              cleanup-state
              return-info
              err-payload)
              [(ResultLowerState.Ok returned-state)
                (let
                  [ok-start : LowerState
                    (lower-state-finish-block returned-state ok-label)]
                  (match (lower-load-single-payload
                    ctx
                    ok-start
                    result-value
                    (tc-result-info-ok-type operand-info))
                    [(LowerExpr.Expr ok-state ok-payload ok-ty)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr ok-state ok-payload ok-ty))]))]
              [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]
          [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])))

(define (lower-try-with-info
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [result-value : CompilerIrValue]
  [operand-info : TcResultInfo]
  [return-info : TcResultInfo]
  [origin : AstExpr]) : ResultLowerExpr
  (match ctx
    [(TcContext _ _ registries _ _ _ _ _)
      (let
        [ok-id : i64 (tc-result-info-ok-id operand-info)]
        [ok-name : String
          (tc-qualified-variant-name
            (tc-nominal-name-id-display (tc-result-info-enum-id operand-info))
            (tc-env-key-name-text ok-id))]
        [ok-handle : i64
          (lower-result-info-variant-handle-or
            ctx
            operand-info
            ok-id
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? ok-handle)
          (match (lower-load-at-offset state result-value 0 (AstType.I64))
            [(LowerExpr.Expr tag-state tag-value _)
              (match (lower-state-alloc-var tag-state)
                [(LowerAlloc.Alloc eq-alloc eq-var)
                  (match (lower-state-fresh-label eq-alloc "try_ok")
                    [(LowerLabel.Label ok-label-state ok-label)
                      (match (lower-state-fresh-label ok-label-state "try_err")
                        [(LowerLabel.Label err-label-state err-label)
                          (let
                            [eq-state : LowerState
                              (lower-state-emit-at-expr
                                err-label-state
                                (CompilerIrInstr.BinOp
                                  eq-var
                                  CompilerIrBinOp.Eq
                                  tag-value
                                  (CompilerIrValue.I64
                                    (compiler-registry-handle-child-index
                                      ok-handle))
                                  (AstType.I64))
                                origin)]
                            (lower-try-finish
                              ctx
                              (lower-state-emit
                                eq-state
                                (CompilerIrInstr.Branch
                                  (CompilerIrValue.Var eq-var)
                                  ok-label
                                  err-label))
                              env
                              type-env
                              result-value
                              operand-info
                              return-info
                              ok-label
                              err-label))])])])])
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (string.append "lower: unknown variant " ok-name))))))]))

(define (lower-try
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-try-spill-resident-operand
    ctx
    (lower-expr ctx state env type-env inner))
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr result-state result-value result-ty)
          (match (tc-result-info ctx result-ty)
            [(ResultTcResultInfo.Ok operand-info)
              (match (tc-current-return-type type-env)
                [(ResultTcType.Ok return-ty)
                  (match (tc-result-info ctx return-ty)
                    [(ResultTcResultInfo.Ok return-info)
                      (match (tc-try-infos-compatible operand-info return-info)
                        [(ResultTcUnit.Ok)
                          (lower-try-with-info
                            ctx
                            result-state
                            env
                            type-env
                            result-value
                            operand-info
                            return-info
                            origin)]
                        [(ResultTcUnit.Err message)
                          (ResultLowerExpr.Err
                            (box (lower-diagnostic-at-expr origin message)))])]
                    [(ResultTcResultInfo.Err _)
                      (ResultLowerExpr.Err
                        (box
                          (lower-diagnostic-at-expr
                            origin
                            "typecheck: try requires enclosing Result-like function")))])]
                [(ResultTcType.Err _)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "typecheck: try requires enclosing Result-like function")))])]
            [(ResultTcResultInfo.Err _)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "typecheck: try operand must be Result-like enum")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-top-level-value-defined-id? [ctx : TcContext] [name-id : i64]) : bool
  (match ctx
    [(TcContext _ symbols _ module module-id _ _ _)
      (compiler-symbols-handle-found?
        (if (and
          (> (string.string-length module) 0)
          (not (tc-name-qualified-id? name-id)))
          (compiler-symbols-lookup-value-in-module-id-or
            symbols
            module-id
            name-id
            (compiler-symbols-missing-handle))
          (compiler-symbols-lookup-value-id-or
            symbols
            name-id
            (compiler-symbols-missing-handle))))]))

(define (lower-top-level-callable-defined-id? [ctx : TcContext] [name-id : i64]) : bool
  (match ctx
    [(TcContext _ symbols _ module module-id _ _ _)
      (let
        [handle : i64
          (if (and
            (> (string.string-length module) 0)
            (not (tc-name-qualified-id? name-id)))
            (compiler-symbols-lookup-value-in-module-id-or
              symbols
              module-id
              name-id
              (compiler-symbols-missing-handle))
            (compiler-symbols-lookup-value-id-or
              symbols
              name-id
              (compiler-symbols-missing-handle)))]
        (if (compiler-symbols-handle-found? handle)
          (let
            [kind : i64 (compiler-symbol-handle-kind handle)]
            (or
              (= kind (compiler-symbol-kind-function-define))
              (= kind (compiler-symbol-kind-extern))
              (= kind (compiler-symbol-kind-defdispatch))))
          false))]))

(define (lower-top-level-callable-lookup-id?
  [ctx : TcContext]
  [lookup-id : i64]) : bool
  (let
    [handle : i64
      (compiler-symbols-lookup-value-id-or
        (tc-context-symbols ctx)
        lookup-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (let
        [kind : i64 (compiler-symbol-handle-kind handle)]
        (or
          (= kind (compiler-symbol-kind-function-define))
          (= kind (compiler-symbol-kind-extern))
          (= kind (compiler-symbol-kind-defdispatch))))
      false)))

(define (lower-callable-lookup-id
  [ctx : TcContext]
  [source-id : i64]
  [lookup-id : i64]) : i64
  (match ctx
    [(TcContext _ _ _ module module-id _ _ _)
      (if (and
        (> (string.string-length module) 0)
        (not (tc-name-qualified-id? source-id))
        (lower-top-level-callable-defined-id? ctx source-id))
        (compiler-symbol-module-key-id-by-id module-id source-id)
        lookup-id)]))

(define (lower-builtin-call-available-id?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]) : bool
  (and
    (not (sym_i64_env.sym-i64-contains-id env name-id))
    (not (lower-top-level-value-defined-id? ctx name-id))))

(define (lower-string-runtime-builtin? [name : String]) : bool
  (let
    [_ : String name]
    false))

;; First-class arena primitives. arena-mark/arena-rewind reuse the
;; existing region runtime (they snapshot/rewind the current arena's bump).
(define (lower-arena-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-arena-id? name-id))

(define (lower-arena-builtin-nullary-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-arena-nullary-id? name-id))

(define (lower-arena-builtin-symbol-id [name-id : i64]) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    (cond
      [(cbi.compiler-builtin-lower-arena-make-id? name-id)
        cbi.compiler-builtin-id-tl-arena-make]
      [(cbi.compiler-builtin-lower-arena-make-atomic-id? name-id)
        cbi.compiler-builtin-id-tl-arena-make-atomic]
      [(cbi.compiler-builtin-lower-arena-current-id? name-id)
        (lower-tl-arena-current-symbol)]
      [(cbi.compiler-builtin-lower-arena-mark-id? name-id)
        (lower-tl-region-mark-symbol)]
      [(cbi.compiler-builtin-lower-arena-set-id? name-id)
        (lower-tl-arena-set-symbol)]
      [(cbi.compiler-builtin-lower-arena-destroy-id? name-id)
        cbi.compiler-builtin-id-tl-arena-destroy]
      [else (lower-tl-region-reset-symbol)])))

(define (lower-arena-builtin-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (if (lower-arena-builtin-nullary-id? name-id)
    (lower-runtime-call-values
      state
      (lower-arena-builtin-symbol-id name-id)
      CompilerIrValueList.Nil
      result-ty)
    (if (= (struct-get (& args) len) 1)
      (let
        [arg : AstExpr
          (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
        (match (lower-expr ctx state env type-env arg)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr arg-state arg-value arg-ty)
                (match (lower-cast-value
                  arg-state
                  arg-value
                  arg-ty
                  (AstType.I64))
                  [(LowerExpr.Expr cast-state cast-value _)
                    (lower-runtime-call-values
                      cast-state
                      (lower-arena-builtin-symbol-id name-id)
                      (compiler-ir-value-cons
                        cast-value
                        CompilerIrValueList.Nil)
                      result-ty)])])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: arena builtin expects one argument"))))))

(define (lower-tls-current-arena-read-call
  [state : LowerState]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 0)
    (lower-runtime-call-values
      state
      cbi.compiler-builtin-id-tl-tls-current-arena-load
      CompilerIrValueList.Nil
      result-ty)
    (ResultLowerExpr.Err
      (box (lower-diagnostic "lower: tls-current-arena expects no arguments")))))

(define (lower-tls-current-arena-set-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      (match (lower-expr ctx state env type-env arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state arg-value arg-ty)
              (match (lower-cast-value arg-state arg-value arg-ty (AstType.I64))
                [(LowerExpr.Expr cast-state cast-value _)
                  (lower-runtime-call-values
                    cast-state
                    cbi.compiler-builtin-id-tl-tls-current-arena-store
                    (compiler-ir-value-cons cast-value CompilerIrValueList.Nil)
                    result-ty)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic
          "lower: tls-current-arena-set! expects exactly one argument")))))

(define (lower-tls-current-arena-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (if (cbi.compiler-builtin-lower-tls-current-arena-read-id? name-id)
    (lower-tls-current-arena-read-call state args result-ty)
    (lower-tls-current-arena-set-call ctx state env type-env args result-ty)))

(define (lower-float-sqrt-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      (match (lower-expr-expected ctx state env type-env arg result-ty arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state arg-value _)
              (match (lower-state-alloc-var arg-state)
                [(LowerAlloc.Alloc allocated var-id)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-state-emit-at-expr
                        allocated
                        (CompilerIrInstr.UnOp
                          var-id
                          (CompilerIrUnOp.Sqrt)
                          arg-value
                          result-ty)
                        origin)
                      (CompilerIrValue.Var var-id)
                      result-ty))])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic-at-expr
          origin
          "lower: __tl_float_sqrt expects exactly one argument")))))

(define (lower-float-bitcast-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      (match (lower-expr ctx state env type-env arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state arg-value arg-ty)
              (ResultLowerExpr.Ok
                (lower-bitcast-value arg-state arg-value arg-ty result-ty))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic-at-expr
          origin
          "lower: float bitcast expects exactly one argument")))))

;; Lower `(clone x)`: the canonical deep-copy / arena-escape. A String
;; copies its buffer through `tl_substring`; tuple, fixed-array, and dynamic-
;; array values allocate fresh storage and recursively clone each element; Box
;; values allocate a fresh box for the cloned inner value; named aggregates
;; dispatch to synthesized `clone$<Name>` helpers (compiler_clone.tl) so
;; recursive enum/struct values recurse at runtime instead of lower time; and
;; scalar values are returned as-is.
;; sret ABI: the synthesized `clone$<Name>` helper returns an aggregate,
;; so it carries the hidden sret param; append the result-slot pointer here to
;; match (the same gate as the helper's definition, so a non-aggregate clone$
;; target -- e.g. a type variable -- passes only the value).
(define (lower-clone-type-key-id [ctx : TcContext] [name-id : i64]) : i64
  (let
    [fallback : i64
      (if (compiler-composite-pair-key-id? name-id)
        name-id
        (clone-name-key-id-in-module (tc-context-module-id ctx) name-id))]
    [handle : i64
      (compiler-symbols-lookup-type-id-or
        (tc-context-symbols ctx)
        name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (tc-nominal-owner-id-or ctx handle fallback)
      fallback)))

(define (lower-clone-helper-lookup-id
  [type-key-id : i64]
  [helper-name-id : i64]) : i64
  (if (clone-name-key-qualified? type-key-id)
    (compiler-symbol-module-key-id-by-id
      (clone-name-key-module-id type-key-id)
      helper-name-id)
    helper-name-id))

(define (lower-clone-named
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (let
    [requested-key-id : i64 (lower-clone-type-key-id ctx name-id)]
    [type-key-id : i64
      (lower-name-cache-clone-key-id (lower-state-names state) requested-key-id)]
    [helper-name-id : i64
      (if (< type-key-id 0)
        -1
        (lower-name-cache-clone-helper-id (lower-state-names state) type-key-id))]
    (if (< helper-name-id 0)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic
            (string.append
              "lower: missing generated clone helper for "
              (tc-nominal-name-id-display name-id)))))
      (match (lower-call-append-sret-arg
        ctx
        state
        (compiler-ir-value-cons value CompilerIrValueList.Nil)
        ty)
        [(ResultLowerArgs.Ok sret-state sret-values)
          (match (lower-state-alloc-var sret-state)
            [(LowerAlloc.Alloc allocated var-id)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-state-emit
                    allocated
                    (CompilerIrInstr.Call
                      var-id
                      (lower-resolve-call-name-id
                        allocated
                        env
                        (lower-clone-helper-lookup-id
                          type-key-id
                          helper-name-id))
                      (compiler-ir-call-args-from-list sret-values)
                      ty))
                  (CompilerIrValue.Var var-id)
                  ty))])]
        [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))))

(define (lower-clone-scalar-type? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Unit) true]
    [(AstType.Never) true]
    [_ false]))

(define (lower-clone-bulk-copy-type? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [clone-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match clone-ty
      [(AstType.Struct _) (lower-type-register-resident? ctx clone-ty)]
      [(AstType.StructArgs _ _) (lower-type-register-resident? ctx clone-ty)]
      [(AstType.Enum _) (lower-type-register-resident? ctx clone-ty)]
      [(AstType.EnumArgs _ _) (lower-type-register-resident? ctx clone-ty)]
      [_ (lower-clone-scalar-type? clone-ty)])))

(define (lower-clone-type-list
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [types : AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-clone-type-list-at ctx state env type-env src dst (& types) cursor 0))

(define (lower-clone-type-list-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [types : (& types AstTypeList)]
  [cursor : i64]
  [index : i64]) : ResultLowerState
  (if (>= index (ast-type-list-len types))
    (ResultLowerState.Ok state)
    (let
      [ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      [size : i64 (lower-type-size ctx resolved)]
      (if (> size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          resolved
          (lower-state-mode state))
          [(LowerExpr.Expr load-state field-value _)
            (match (lower-clone-dispatch
              ctx
              load-state
              env
              type-env
              field-value
              resolved)
              [(ResultLowerExpr.Ok cloned)
                (match cloned
                  [(LowerExpr.Expr clone-state clone-value _)
                    (lower-clone-type-list-at
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        clone-state
                        dst
                        offset
                        clone-value
                        resolved
                        size)
                      env
                      type-env
                      src
                      dst
                      types
                      (+ offset size)
                      (+ index 1))])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (lower-clone-type-list-at
          ctx
          state
          env
          type-env
          src
          dst
          types
          (+ offset size)
          (+ index 1))))))

(define (lower-clone-tuple-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-tys : AstTypeList]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage
    state
    (lower-type-list-storage-size ctx elem-tys)
    result-ty)
    [(LowerExpr.Expr dst-state dst _)
      (match (lower-clone-type-list
        ctx
        dst-state
        env
        type-env
        value
        dst
        elem-tys
        0)
        [(ResultLowerState.Ok done-state)
          (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
        [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-clone-fixed-array-elems
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [src : CompilerIrValue]
  [dst : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [index : i64]
  [count : i64]) : ResultLowerState
  (if (>= index count)
    (ResultLowerState.Ok state)
    (let
      [offset : i64 (* index elem-size)]
      (if (> elem-size 0)
        (match (lower-load-inline-value-at-offset
          ctx
          state
          src
          offset
          elem-ty
          (lower-state-mode state))
          [(LowerExpr.Expr load-state elem-value _)
            (match (lower-clone-dispatch
              ctx
              load-state
              env
              type-env
              elem-value
              elem-ty)
              [(ResultLowerExpr.Ok cloned)
                (match cloned
                  [(LowerExpr.Expr clone-state clone-value _)
                    (lower-clone-fixed-array-elems
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        clone-state
                        dst
                        offset
                        clone-value
                        elem-ty
                        elem-size)
                      env
                      type-env
                      src
                      dst
                      elem-ty
                      elem-size
                      (+ index 1)
                      count)])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (lower-clone-fixed-array-elems
          ctx
          state
          env
          type-env
          src
          dst
          elem-ty
          elem-size
          (+ index 1)
          count)))))

(define (lower-clone-fixed-array-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [count : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [elem-size : i64 (lower-type-size ctx elem-ty)]
    (match (lower-reserve-heap-storage
      state
      (lower-fixed-array-storage-size ctx elem-ty count)
      result-ty)
      [(LowerExpr.Expr dst-state dst _)
        (match (lower-clone-fixed-array-elems
          ctx
          dst-state
          env
          type-env
          value
          dst
          elem-ty
          elem-size
          0
          count)
          [(ResultLowerState.Ok done-state)
            (ResultLowerExpr.Ok (LowerExpr.Expr done-state dst result-ty))]
          [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])))

(define (lower-clone-dynarray-advance
  [state : LowerState]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc inc-alloc inc-var)
      (ResultLowerState.Ok
        (lower-state-finish-block
          (lower-state-emit
            (lower-state-emit
              (lower-state-emit
                inc-alloc
                (CompilerIrInstr.BinOp
                  inc-var
                  CompilerIrBinOp.Add
                  (CompilerIrValue.Var index-var)
                  (CompilerIrValue.I64 1)
                  (AstType.I64)))
              (CompilerIrInstr.Mov
                index-var
                (CompilerIrValue.Var inc-var)
                (AstType.I64)))
            (CompilerIrInstr.Jump header-label))
          exit-label))]))

(define (lower-clone-dynarray-store-and-advance
  [ctx : TcContext]
  [state : LowerState]
  [new-buf : CompilerIrValue]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]
  [clone-value : CompilerIrValue]
  [elem-ty : AstType]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    new-buf
    (CompilerIrValue.Var index-var)
    elem-ty)
    [(LowerExpr.Expr dst-gep-state dst-ptr _)
      (lower-clone-dynarray-advance
        (lower-array-elem-store-state
          ctx
          dst-gep-state
          dst-ptr
          clone-value
          elem-ty)
        index-var
        header-label
        exit-label)]))

(define (lower-clone-dynarray-copy-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]
  [elem-ty : AstType]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    old-buf
    (CompilerIrValue.Var index-var)
    elem-ty)
    [(LowerExpr.Expr src-gep-state src-ptr _)
      (match (lower-load-inline-value-at-offset
        ctx
        src-gep-state
        src-ptr
        0
        elem-ty
        (lower-state-mode src-gep-state))
        [(LowerExpr.Expr load-state elem-value _)
          (match (lower-clone-dispatch
            ctx
            load-state
            env
            type-env
            elem-value
            elem-ty)
            [(ResultLowerExpr.Ok cloned)
              (match cloned
                [(LowerExpr.Expr clone-state clone-value _)
                  (lower-clone-dynarray-store-and-advance
                    ctx
                    clone-state
                    new-buf
                    index-var
                    header-label
                    exit-label
                    clone-value
                    elem-ty)])]
            [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])]))

(define (lower-clone-dynarray-copy-nonempty
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]) : ResultLowerState
  (match (lower-state-fresh-label state "clone_array_header")
    [(LowerLabel.Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "clone_array_body")
        [(LowerLabel.Label body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "clone_array_exit")
            [(LowerLabel.Label exit-label-state exit-label)
              (match (lower-state-alloc-var exit-label-state)
                [(LowerAlloc.Alloc index-alloc index-var)
                  (let
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            index-alloc
                            (CompilerIrInstr.Mov
                              index-var
                              (CompilerIrValue.I64 0)
                              (AstType.I64)))
                          (CompilerIrInstr.Jump header-label))
                        header-label)]
                    (match (lower-state-alloc-var header-start)
                      [(LowerAlloc.Alloc cond-alloc cond-var)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                (lower-state-emit
                                  cond-alloc
                                  (CompilerIrInstr.BinOp
                                    cond-var
                                    CompilerIrBinOp.Lt
                                    (CompilerIrValue.Var index-var)
                                    len
                                    (AstType.I64)))
                                (CompilerIrInstr.Branch
                                  (CompilerIrValue.Var cond-var)
                                  body-label
                                  exit-label))
                              body-label)]
                          (lower-clone-dynarray-copy-body
                            ctx
                            body-start
                            env
                            type-env
                            old-buf
                            new-buf
                            index-var
                            header-label
                            exit-label
                            elem-ty))]))])])])]))

(define (lower-clone-dynarray-copy-loop
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [byte-count : CompilerIrValue]) : ResultLowerState
  (if (= elem-size 0)
    (ResultLowerState.Ok state)
    (if (lower-clone-bulk-copy-type? ctx elem-ty)
      (ResultLowerState.Ok
        (lower-emit-memcpy-value state new-buf 0 old-buf 0 byte-count))
      (lower-clone-dynarray-copy-nonempty
        ctx
        state
        env
        type-env
        old-buf
        new-buf
        len
        elem-ty))))

(define (lower-clone-dynarray-finish
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [old-buf : CompilerIrValue]
  [len : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [byte-count : CompilerIrValue]
  [buf-var : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 result-ty)
    [(LowerExpr.Expr arr-state arr-value _)
      (match (lower-clone-dynarray-copy-loop
        ctx
        arr-state
        env
        type-env
        old-buf
        (CompilerIrValue.Var buf-var)
        len
        elem-ty
        elem-size
        byte-count)
        [(ResultLowerState.Ok copied-state)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-store-at-offset
                (lower-store-at-offset
                  copied-state
                  arr-value
                  0
                  (CompilerIrValue.Var buf-var)
                  (AstType.U64))
                arr-value
                8
                len
                (AstType.I64))
              arr-value
              result-ty))]
        [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-clone-dynarray-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-load-at-offset state value 8 (AstType.I64))
    [(LowerExpr.Expr len-state len _)
      (match (lower-load-at-offset len-state value 0 (AstType.U64))
        [(LowerExpr.Expr ptr-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            (match (if (= elem-size 0)
              (LowerExpr.Expr ptr-state (CompilerIrValue.I64 1) (AstType.I64))
              (lower-emit-binop
                ptr-state
                CompilerIrBinOp.Mul
                len
                (CompilerIrValue.I64 elem-size)
                (AstType.I64)))
              [(LowerExpr.Expr byte-state byte-count _)
                (match (lower-state-alloc-var byte-state)
                  [(LowerAlloc.Alloc buf-alloc buf-var)
                    (lower-clone-dynarray-finish
                      ctx
                      (lower-state-emit
                        buf-alloc
                        (CompilerIrInstr.Call
                          buf-var
                          (lower-tl-alloc-symbol)
                          (CompilerIrCallArgs.One byte-count)
                          (AstType.U64)))
                      env
                      type-env
                      old-buf
                      len
                      elem-ty
                      elem-size
                      byte-count
                      buf-var
                      result-ty)])]))])]))

(define (lower-clone-box-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [inner-ty : AstType]
  [result-ty : AstType]) : ResultLowerExpr
  ;; A (Box T) with inline struct/enum T addresses the T storage at the
  ;; box pointer; load it as a value (pointer) rather than scalar-loading the
  ;; leading word, mirroring lower-box-get.
  (match (lower-load-inline-value-at-offset
    ctx
    state
    value
    0
    inner-ty
    (lower-state-mode state))
    [(LowerExpr.Expr load-state inner-value _)
      (match (lower-clone-dispatch
        ctx
        load-state
        env
        type-env
        inner-value
        inner-ty)
        [(ResultLowerExpr.Ok cloned)
          (match cloned
            [(LowerExpr.Expr clone-state clone-value _)
              (match (lower-reserve-heap-storage
                clone-state
                (lower-type-size ctx inner-ty)
                result-ty)
                [(LowerExpr.Expr box-state box-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-store-inline-value-at-offset
                        ctx
                        box-state
                        box-value
                        0
                        clone-value
                        inner-ty
                        (lower-type-size ctx inner-ty))
                      box-value
                      result-ty))])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-clone-dispatch
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : CompilerIrValue]
  [ty : AstType]) : ResultLowerExpr
  (let
    [clone-ty : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match clone-ty
      [(AstType.String) (lower-capture-snapshot-string-value state value)]
      [(AstType.Tuple elem-tys)
        (lower-clone-tuple-value
          ctx
          state
          env
          type-env
          value
          (box-get elem-tys)
          clone-ty)]
      [(AstType.Array elem-ty count)
        (lower-clone-fixed-array-value
          ctx
          state
          env
          type-env
          value
          (tc-type-without-regions (tc-context-type-get ctx elem-ty))
          count
          clone-ty)]
      [(AstType.DynArray elem-ty)
        (lower-clone-dynarray-value
          ctx
          state
          env
          type-env
          value
          (tc-type-without-regions (tc-context-type-get ctx elem-ty))
          clone-ty)]
      [(AstType.Box elem-ty)
        (lower-clone-box-value
          ctx
          state
          env
          type-env
          value
          (tc-type-without-regions (tc-context-type-get ctx elem-ty))
          clone-ty)]
      ;; A register-resident aggregate is word-class POD held in a
      ;; register, so cloning it is a value copy -- no deep-clone helper, no
      ;; memory traversal.
      [(AstType.Enum name)
        (if (lower-type-register-resident? ctx clone-ty)
          (ResultLowerExpr.Ok (LowerExpr.Expr state value clone-ty))
          (lower-clone-named ctx state env name value clone-ty))]
      [(AstType.Struct name)
        (if (lower-type-register-resident? ctx clone-ty)
          (ResultLowerExpr.Ok (LowerExpr.Expr state value clone-ty))
          (lower-clone-named ctx state env name value clone-ty))]
      [(AstType.Var name) (lower-clone-named ctx state env name value clone-ty)]
      [_
        (if (lower-clone-scalar-type? clone-ty)
          (ResultLowerExpr.Ok (LowerExpr.Expr state value clone-ty))
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: clone unsupported type "
                  (tc-type-render clone-ty))))))])))

(define (lower-clone-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arg : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arg)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr arg-state arg-value arg-ty)
          (lower-clone-dispatch ctx arg-state env type-env arg-value arg-ty)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-call-explicit-mut-borrow-var-id
  [ctx : TcContext]
  [arg : AstExpr]) : TcMaybeNameId
  (match (ast-expr-unspan arg)
    [(AstExpr.Borrow mutable _ place-box)
      (if mutable
        (match (ast-expr-unspan (lower-context-expr-get ctx place-box))
          [(AstExpr.Var name) (TcMaybeNameId.Some name)]
          [_ (TcMaybeNameId.No)])
        (TcMaybeNameId.No))]
    [_ (TcMaybeNameId.No)]))

(define (lower-call-arg-normal-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arg : AstExpr]
  [effective-arg : AstExpr]
  [arg-ty : AstType]) : ResultLowerCallArg
  (match (lower-expr-expected
    ctx
    (lower-disarm-move-aware-resource-expr state env effective-arg)
    env
    type-env
    effective-arg
    arg-ty
    arg)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr arg-state value _)
          (ResultLowerCallArg.Ok
            (LowerCallArg.Arg arg-state value (LowerMaybeArgWriteback.No)))])]
    [(ResultLowerExpr.Err message) (ResultLowerCallArg.Err message)]))

(define (lower-call-arg-mut-borrow-var-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arg : AstExpr]
  [effective-arg : AstExpr]
  [arg-ty : AstType]
  [name-id : i64]) : ResultLowerCallArg
  (match (tc-lookup-id type-env name-id)
    [(ResultTcType.Ok place-ty)
      (let
        [referent-ty : AstType (tc-borrow-referent-type place-ty)]
        [referent-ir-ty : AstType
          (tc-type-without-regions (tc-resolve-type ctx referent-ty))]
        (if (or
          (tc-type-contains-reference? place-ty)
          (lower-borrow-place-value-reference? ctx referent-ty))
          (lower-call-arg-normal-as
            ctx
            state
            env
            type-env
            arg
            effective-arg
            arg-ty)
          (let
            [local-id : i64
              (sym_i64_env.sym-i64-lookup-id-or
                env
                name-id
                (compiler-symbols-missing-handle))]
            (if (compiler-symbols-handle-found? local-id)
              (match (lower-borrow-copy-to-inline-storage
                ctx
                state
                (CompilerIrValue.Var local-id)
                referent-ir-ty
                arg-ty)
                [(LowerExpr.Expr arg-state storage _)
                  (ResultLowerCallArg.Ok
                    (LowerCallArg.Arg
                      arg-state
                      storage
                      (LowerMaybeArgWriteback.Some
                        (LowerArgWriteback.Writeback
                          local-id
                          storage
                          referent-ir-ty
                          arg))))])
              (lower-call-arg-normal-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty)))))]
    [(ResultTcType.Err _)
      (lower-call-arg-normal-as ctx state env type-env arg effective-arg arg-ty)]))

(define (lower-call-arg-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arg : AstExpr]
  [expected : AstType]
  [arg-ty : AstType]) : ResultLowerCallArg
  (match (tc-call-effective-arg-expr ctx type-env arg expected)
    [(ResultTcExpr.Ok effective-arg)
      (match (tc-type-strip-region (tc-resolve-type ctx arg-ty))
        [(AstType.MutRef _ _)
          (match (lower-call-explicit-mut-borrow-var-id ctx effective-arg)
            [(TcMaybeNameId.Some name-id)
              (lower-call-arg-mut-borrow-var-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty
                name-id)]
            [(TcMaybeNameId.No)
              (lower-call-arg-normal-as
                ctx
                state
                env
                type-env
                arg
                effective-arg
                arg-ty)])]
        [_
          (lower-call-arg-normal-as
            ctx
            state
            env
            type-env
            arg
            effective-arg
            arg-ty)])]
    [(ResultTcExpr.Err message)
      (ResultLowerCallArg.Err (box (lower-diagnostic-at-expr arg message)))]))

;; Arguments lower left-to-right, so append each writeback before recurring.
;; This preserves post-call writeback order without a prepend/copy pass.
(define (lower-call-arg-writebacks-push-maybe
  [writebacks : (&mut writebacks lower_arg_writeback_vec.Vec)]
  [maybe-writeback : LowerMaybeArgWriteback]) : unit
  (match maybe-writeback
    [(LowerMaybeArgWriteback.No) unit]
    [(LowerMaybeArgWriteback.Some writeback)
      (lower_arg_writeback_vec.push writebacks writeback)]))

(define (lower-call-args-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [types : AstTypeList]) : ResultLowerCallArgs
  (lower-call-args-as-at
    ctx
    state
    env
    type-env
    (& args)
    (& types)
    0
    (lower_arg_writeback_vec.new)))

(define (lower-call-args-as-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : (& args AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]
  [writebacks : lower_arg_writeback_vec.Vec]) : ResultLowerCallArgs
  (if (>= index (struct-get args len))
    (if (>= index (ast-type-list-len types))
      (ResultLowerCallArgs.Ok
        state
        CompilerIrValueList.Nil
        (LowerArgWritebacks.Some writebacks))
      (ResultLowerCallArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast-type-list-len types))
      (ResultLowerCallArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [arg : AstExpr
          (lower-context-expr-get ctx (ast-expr-list-get args index 0))]
        [expected-id : i64
          (ast-type-list-get types index (ast-type-id-fallback))]
        [expected : AstType
          (ast-type-strip-consuming-param (tc-context-type-get ctx expected-id))]
        [arg-ty : AstType
          (tc-type-without-regions (tc-resolve-type ctx expected))]
        (match (lower-call-arg-as ctx state env type-env arg expected arg-ty)
          [(ResultLowerCallArg.Ok lowered-arg)
            (match lowered-arg
              [(LowerCallArg.Arg arg-state value maybe-writeback)
                (let
                  [next-writebacks : lower_arg_writeback_vec.Vec writebacks]
                  (begin
                    (lower-call-arg-writebacks-push-maybe
                      (&mut next-writebacks)
                      maybe-writeback)
                    (match (lower-call-args-as-at
                      ctx
                      arg-state
                      env
                      type-env
                      args
                      types
                      (+ index 1)
                      next-writebacks)
                      [(ResultLowerCallArgs.Ok
                          rest-state
                          rest-values
                          rest-writebacks)
                        (ResultLowerCallArgs.Ok
                          rest-state
                          (compiler-ir-value-cons value rest-values)
                          rest-writebacks)]
                      [(ResultLowerCallArgs.Err message)
                        (ResultLowerCallArgs.Err message)])))])]
          [(ResultLowerCallArg.Err message) (ResultLowerCallArgs.Err message)])))))

(define (lower-apply-arg-writeback
  [ctx : TcContext]
  [state : LowerState]
  [writeback : LowerArgWriteback]) : LowerState
  (match writeback
    [(LowerArgWriteback.Writeback local-id storage referent-ty origin)
      (match (lower-load-register-resident-from-ptr
        ctx
        state
        storage
        referent-ty)
        [(LowerExpr.Expr load-state loaded _)
          (lower-state-emit-at-expr
            load-state
            (CompilerIrInstr.Mov local-id loaded referent-ty)
            origin)])]))

(define lower-arg-writeback-fallback : LowerArgWriteback
  (LowerArgWriteback.Writeback
    0
    (CompilerIrValue.I64 0)
    (AstType.I64)
    (AstExpr.Literal (ast-lit-int 0))))

(define (lower-apply-arg-writebacks
  [ctx : TcContext]
  [state : LowerState]
  [writebacks : LowerArgWritebacks]) : LowerState
  (match writebacks
    [(LowerArgWritebacks.None) state]
    [(LowerArgWritebacks.Some items)
      (let
        [count : i64 (lower_arg_writeback_vec.len (& items))]
        [index : i64 0]
        [out : LowerState state]
        (begin
          (while (< index count)
            (begin
              (set!
                out
                (lower-apply-arg-writeback
                  ctx
                  out
                  (lower_arg_writeback_vec.get
                    (& items)
                    index
                    lower-arg-writeback-fallback)))
              (set! index (+ index 1))))
          out))]))

(define (lower-bootstrap-runtime-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-bootstrap-runtime-id? name-id))

(define (lower-args-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [types : AstTypeList]) : ResultLowerArgs
  (lower-args-as-at ctx state env type-env (& args) (& types) 0))

(define (lower-args-as-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : (& args AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index (struct-get args len))
    (if (>= index (ast-type-list-len types))
      (ResultLowerArgs.Ok state CompilerIrValueList.Nil)
      (ResultLowerArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast-type-list-len types))
      (ResultLowerArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [arg : AstExpr
          (lower-context-expr-get ctx (ast-expr-list-get args index 0))]
        [expected-id : i64
          (ast-type-list-get types index (ast-type-id-fallback))]
        [expected : AstType
          (ast-type-strip-consuming-param (tc-context-type-get ctx expected-id))]
        [arg-ty : AstType
          (tc-type-without-regions (tc-resolve-type ctx expected))]
        (match (tc-call-effective-arg-expr ctx type-env arg expected)
          [(ResultTcExpr.Ok effective-arg)
            (match (lower-expr-expected
              ctx
              (lower-disarm-move-aware-resource-expr state env effective-arg)
              env
              type-env
              effective-arg
              arg-ty
              arg)
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr arg-state value _)
                    (match (lower-args-as-at
                      ctx
                      arg-state
                      env
                      type-env
                      args
                      types
                      (+ index 1))
                      [(ResultLowerArgs.Ok rest-state rest-values)
                        (ResultLowerArgs.Ok
                          rest-state
                          (compiler-ir-value-cons value rest-values))]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerArgs.Err message)])])]
              [(ResultLowerExpr.Err message) (ResultLowerArgs.Err message)])]
          [(ResultTcExpr.Err message)
            (ResultLowerArgs.Err (box (lower-diagnostic-at-expr arg message)))])))))

(define (lower-call-type-list-has-mut-ref-formal?
  [ctx : TcContext]
  [types : AstTypeList]) : bool
  (lower-call-type-list-has-mut-ref-formal-at? ctx (& types) 0))

(define (lower-call-type-list-has-mut-ref-formal-at?
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (let
      [head : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      (match (tc-type-strip-region head)
        [(AstType.MutRef _ _) true]
        [_ (lower-call-type-list-has-mut-ref-formal-at? ctx types (+ index 1))]))))

(define (lower-call-args-as-needed
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [types : AstTypeList]) : ResultLowerCallArgs
  (if (lower-call-type-list-has-mut-ref-formal? ctx types)
    (lower-call-args-as ctx state env type-env args types)
    (match (lower-args-as ctx state env type-env args types)
      [(ResultLowerArgs.Ok args-state values)
        (ResultLowerCallArgs.Ok args-state values (LowerArgWritebacks.None))]
      [(ResultLowerArgs.Err message) (ResultLowerCallArgs.Err message)])))

(define (lower-construct-struct-inline-from-values
  [ctx : TcContext]
  [state : LowerState]
  [struct-name : String]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]
  [struct-ty : AstType]) : ResultLowerExpr
  (match (tc-inline-aggregate-layout-for-id
    ctx
    (lower-struct-type-name-id-or struct-ty -1))
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Struct size _ _)
          ;; A register-resident struct is built directly in registers by
          ;; packing its fields with shift/or; no stack slot, no stores. A 2-word
          ;; struct packs each word and combines them with IrInstrPack.
          (if (tc-inline-aggregate-layout-register-resident? layout)
            (if (lower-type-register-group? ctx struct-ty)
              (lower-construct-struct-register-group
                ctx
                state
                values
                fields
                layout
                struct-ty)
              (match (lower-pack-inline-struct-values
                ctx
                state
                (CompilerIrValue.I64 0)
                (AstType.I64)
                values
                fields
                layout)
                [(ResultLowerExpr.Ok packed)
                  (match packed
                    [(LowerExpr.Expr packed-state packed-value packed-ty)
                      (match (lower-materialize-register-word
                        packed-state
                        packed-value
                        packed-ty
                        (lower-register-word-type ctx struct-ty 0))
                        [(LowerExpr.Expr word-state word-value _)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr word-state word-value struct-ty))])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
            (match (lower-reserve-inline-storage state size struct-ty)
              [(LowerExpr.Expr base-state base _)
                (match (lower-store-inline-struct-values
                  ctx
                  base-state
                  base
                  values
                  fields
                  layout)
                  [(ResultLowerState.Ok done-state)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr done-state base struct-ty))]
                  [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))]
        [(TcInlineAggregateLayout.Enum _ _ _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for struct is enum "
                  struct-name))))])]
    [(ResultTcInlineAggregateLayout.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic message)))]))

(define (lower-construct-struct-inline-into-from-values
  [ctx : TcContext]
  [state : LowerState]
  [dst : CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [values : CompilerIrValueList]
  [fields : AstFieldDefList]) : ResultLowerState
  (match (tc-inline-aggregate-layout-for-id ctx struct-id)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Struct _ _ _)
          (lower-store-inline-struct-values ctx state dst values fields layout)]
        [(TcInlineAggregateLayout.Enum _ _ _)
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for struct is enum "
                  struct-name))))])]
    [(ResultTcInlineAggregateLayout.Err message)
      (ResultLowerState.Err (box (lower-diagnostic message)))]))

(define (lower-construct-enum-inline-from-values
  [ctx : TcContext]
  [state : LowerState]
  [variant-name : String]
  [handle : i64]
  [values : CompilerIrValueList]
  [fields : AstTypeList]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerExpr
  (match (tc-inline-aggregate-layout-for-id
    ctx
    (lower-enum-type-name-id-or enum-ty -1))
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Enum size _ _)
          ;; A 1-word register-resident enum is nullary, so its single word
          ;; is the discriminant tag. A 2-word register-group enum packs the tag
          ;; into word0 and the variant payload into word1.
          (if (tc-inline-aggregate-layout-register-resident? layout)
            ;; A register-resident enum is 8 (nullary tag) or 16 bytes (tag
            ;; word0 + payload word1); derive the 2-word group case from the size we
            ;; already have rather than rebuilding the layout (lower-type-register-
            ;; group?), whose transient per-call allocation -- summed over every
            ;; construct/match/bind site during the per-function scratch arena
            ;; window -- was heavy enough to overflow the scratch arena into a
            ;; second chunk and trip its rewind, corrupting later lowering.
            (if (= size 16)
              (lower-construct-enum-register-group
                ctx
                state
                handle
                values
                fields
                enum-ty)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  state
                  (CompilerIrValue.I64
                    (compiler-registry-handle-child-index handle))
                  enum-ty)))
            (let
              [layout-variant-name : String
                (lower-member-name-base variant-name)]
              [layout-variant-name-id : i64
                (match (compiler-registries-variant-name-id-indexed
                  (tc-context-symbols ctx)
                  handle)
                  [(option_i64.Some name-id) name-id]
                  [(option_i64.None) -1])]
              (match (lower-reserve-inline-storage state size enum-ty)
                [(LowerExpr.Expr base-state base _)
                  (let
                    [tag-state : LowerState
                      (lower-store-at-offset
                        base-state
                        base
                        0
                        (CompilerIrValue.I64
                          (compiler-registry-handle-child-index handle))
                        (AstType.I64))]
                    (match (lower-store-inline-payload-values
                      ctx
                      tag-state
                      base
                      values
                      fields
                      layout
                      layout-variant-name
                      layout-variant-name-id
                      0)
                      [(ResultLowerState.Ok done-state)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr done-state base enum-ty))]
                      [(ResultLowerState.Err message)
                        (ResultLowerExpr.Err message)]))])))]
        [(TcInlineAggregateLayout.Struct _ _ _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for enum is struct "
                  enum-name))))])]
    [(ResultTcInlineAggregateLayout.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic message)))]))

(define (lower-construct-enum-inline-into-from-values
  [ctx : TcContext]
  [state : LowerState]
  [dst : CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [values : CompilerIrValueList]
  [fields : AstTypeList]
  [enum-id : i64]
  [enum-name : String]) : ResultLowerState
  (match (tc-inline-aggregate-layout-for-id ctx enum-id)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Enum _ _ _)
          (let
            [layout-variant-name : String (lower-member-name-base variant-name)]
            [layout-variant-name-id : i64
              (match (compiler-registries-variant-name-id-indexed
                (tc-context-symbols ctx)
                handle)
                [(option_i64.Some name-id) name-id]
                [(option_i64.None) -1])]
            [tag-state : LowerState
              (lower-store-at-offset
                state
                dst
                0
                (CompilerIrValue.I64
                  (compiler-registry-handle-child-index handle))
                (AstType.I64))]
            (lower-store-inline-payload-values
              ctx
              tag-state
              dst
              values
              fields
              layout
              layout-variant-name
              layout-variant-name-id
              0))]
        [(TcInlineAggregateLayout.Struct _ _ _)
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: inline layout for enum is struct "
                  enum-name))))])]
    [(ResultTcInlineAggregateLayout.Err message)
      (ResultLowerState.Err (box (lower-diagnostic message)))]))

(define (lower-enum-constructor-fields-for-result
  [ctx : TcContext]
  [enum-ty : AstType]
  [fields : AstTypeList]) : AstTypeList
  (match enum-ty
    [(AstType.EnumArgs enum-id lifetimes)
      (match (tc-lifetime-subst-from-nominal-args-id
        ctx
        enum-id
        (box-get lifetimes))
        [(ResultTcLifetimeSubst.Ok subst)
          (tc-lifetime-subst-type-list subst fields)]
        [(ResultTcLifetimeSubst.Err _) fields])]
    [(AstType.VarArgs enum-id lifetimes)
      (match (tc-lifetime-subst-from-nominal-args-id
        ctx
        enum-id
        (box-get lifetimes))
        [(ResultTcLifetimeSubst.Ok subst)
          (tc-lifetime-subst-type-list subst fields)]
        [(ResultTcLifetimeSubst.Err _) fields])]
    [_ fields]))

(define (lower-variant-payload-fields-for-handle
  [ctx : TcContext]
  [handle : i64]
  [resolved-scrut-ty : AstType]
  [fields : AstTypeList]) : AstTypeList
  (let
    [field-ctx : TcContext
      (tc-context-with-nominal-owner-handle-module
        ctx
        (compiler-registry-variant-owner-handle handle))]
    (tc-resolve-type-list
      field-ctx
      (lower-enum-constructor-fields-for-result
        field-ctx
        resolved-scrut-ty
        fields))))

(define (lower-construct-enum-with-name
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [variant-name : String]
  [handle : i64]
  [args : AstExprList]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerExpr
  (match ctx
    [(TcContext _ symbols _ _ _ _ _ _)
      (match (compiler-registries-variant-fields-indexed symbols handle)
        [(ResultAstTypeList.Ok fields)
          (let
            [field-ctx : TcContext
              (tc-context-with-nominal-owner-handle-module ctx handle)]
            [resolved-fields : AstTypeList
              (tc-resolve-type-list
                field-ctx
                (lower-enum-constructor-fields-for-result
                  field-ctx
                  enum-ty
                  fields))]
            (match (lower-args-as ctx state env type-env args resolved-fields)
              [(ResultLowerArgs.Ok args-state values)
                (if (lower-mode-inline-aggregates?
                  (lower-state-mode args-state))
                  (lower-construct-enum-inline-from-values
                    ctx
                    args-state
                    variant-name
                    handle
                    values
                    resolved-fields
                    enum-name
                    enum-ty)
                  (if (ast-type-list-empty? (& resolved-fields))
                    (match (compiler-registries-variant-name-id-indexed
                      symbols
                      handle)
                      [(option_i64.Some _)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            args-state
                            (CompilerIrValue.GlobalAddr
                              (lower-nullary-variant-object-symbol
                                enum-name
                                variant-name))
                            enum-ty))]
                      [(option_i64.None)
                        (ResultLowerExpr.Err
                          (box
                            (lower-diagnostic
                              "lower: variant handle has no source name")))])
                    (let
                      [size : i64
                        (lower-variant-fields-storage-size ctx resolved-fields)]
                      (match (lower-reserve-heap-storage
                        args-state
                        size
                        enum-ty)
                        [(LowerExpr.Expr base-state base _)
                          (let
                            [tag-state : LowerState
                              (lower-store-at-offset
                                base-state
                                base
                                0
                                (CompilerIrValue.I64
                                  (compiler-registry-handle-child-index handle))
                                (AstType.I64))]
                            (match (lower-store-values
                              ctx
                              tag-state
                              base
                              values
                              resolved-fields
                              8)
                              [(ResultLowerState.Ok done-state)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr done-state base enum-ty))]
                              [(ResultLowerState.Err message)
                                (ResultLowerExpr.Err message)]))]))))]
              [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))]
        [(ResultAstTypeList.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic message)))])]))

(define (lower-construct-enum-with-handle
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [variant-name : String]
  [handle : i64]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [enum-ty : AstType
      (tc-type-without-regions (tc-resolve-type ctx result-ty))]
    (match enum-ty
      [(AstType.Enum enum-name)
        (lower-construct-enum-with-name
          ctx
          state
          env
          type-env
          variant-name
          handle
          args
          (tc-nominal-name-id-display enum-name)
          enum-ty)]
      [(AstType.EnumArgs enum-name _)
        (lower-construct-enum-with-name
          ctx
          state
          env
          type-env
          variant-name
          handle
          args
          (tc-nominal-name-id-display enum-name)
          enum-ty)]
      [_
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic
              (string.append
                "lower: enum constructor result is not enum: "
                variant-name))))])))

(define (lower-construct-enum-with-name-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [args : AstExprList]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerState
  (match ctx
    [(TcContext _ symbols _ _ _ _ _ _)
      (match (compiler-registries-variant-fields-indexed symbols handle)
        [(ResultAstTypeList.Ok fields)
          (let
            [field-ctx : TcContext
              (tc-context-with-nominal-owner-handle-module ctx handle)]
            [resolved-fields : AstTypeList
              (tc-resolve-type-list
                field-ctx
                (lower-enum-constructor-fields-for-result
                  field-ctx
                  enum-ty
                  fields))]
            (match (lower-args-as ctx state env type-env args resolved-fields)
              [(ResultLowerArgs.Ok args-state values)
                (if (lower-mode-inline-aggregates?
                  (lower-state-mode args-state))
                  (lower-construct-enum-inline-into-from-values
                    ctx
                    args-state
                    dst
                    variant-name
                    handle
                    values
                    resolved-fields
                    (lower-enum-type-name-id-or enum-ty -1)
                    enum-name)
                  (ResultLowerState.Err
                    (box
                      (lower-diagnostic
                        "lower: enum destination construction requires inline aggregates"))))]
              [(ResultLowerArgs.Err message) (ResultLowerState.Err message)]))]
        [(ResultAstTypeList.Err message)
          (ResultLowerState.Err (box (lower-diagnostic message)))])]))

(define (lower-construct-enum-with-handle-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [variant-name : String]
  [handle : i64]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerState
  (let
    [enum-ty : AstType
      (tc-type-without-regions (tc-resolve-type ctx result-ty))]
    (match enum-ty
      [(AstType.Enum enum-name)
        (lower-construct-enum-with-name-into
          ctx
          state
          env
          type-env
          dst
          variant-name
          handle
          args
          (tc-nominal-name-id-display enum-name)
          enum-ty)]
      [(AstType.EnumArgs enum-name _)
        (lower-construct-enum-with-name-into
          ctx
          state
          env
          type-env
          dst
          variant-name
          handle
          args
          (tc-nominal-name-id-display enum-name)
          enum-ty)]
      [_
        (ResultLowerState.Err
          (box
            (lower-diagnostic
              (string.append
                "lower: enum constructor result is not enum: "
                variant-name))))])))

(define (lower-struct-constructor-field-types-for-result
  [ctx : TcContext]
  [struct-ty : AstType]
  [fields : AstFieldDefList]) : AstTypeList
  (let
    [field-types : AstTypeList (tc-field-type-list ctx fields)]
    (match struct-ty
      [(AstType.StructArgs struct-id lifetimes)
        (match (tc-lifetime-subst-from-nominal-args-id
          ctx
          struct-id
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ResultTcLifetimeSubst.Err _) field-types])]
      [(AstType.VarArgs struct-id lifetimes)
        (match (tc-lifetime-subst-from-nominal-args-id
          ctx
          struct-id
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ResultTcLifetimeSubst.Err _) field-types])]
      [_ field-types])))

(define (lower-context-with-nominal-owner-module-id
  [ctx : TcContext]
  [nominal-id : i64]) : TcContext
  (let
    [handle : i64
      (compiler-symbols-lookup-type-id-or
        (tc-context-symbols ctx)
        nominal-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (let
        [module-id : i64
          (compiler-symbols-owner-module-id-at-index-or
            (tc-context-symbols ctx)
            (compiler-symbol-handle-index handle)
            cbi.compiler-builtin-id-fix-empty)]
        (if (>= module-id 0)
          (tc-context-with-module-id ctx (intern-str module-id) module-id)
          (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)))
      (if (tc-name-qualified-id? nominal-id)
        (let
          [module-id : i64 (tc-qualified-name-module-id nominal-id)]
          (tc-context-with-module-id ctx (intern-str module-id) module-id))
        ctx))))

(define (lower-construct-struct
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [struct-name : String]
  [struct-handle : i64]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerExpr
  ;; Field annotations are scoped to the declaring module. Resolve them there
  ;; before lowering arguments or storage so a dotted imported aggregate keeps
  ;; the layout of its nested nominal fields.
  (let
    [result-struct-id : i64 (lower-struct-type-name-id-or result-ty -1)]
    [struct-id : i64
      (if (compiler-symbols-handle-found? struct-handle)
        (tc-nominal-owner-id-or ctx struct-handle result-struct-id)
        result-struct-id)]
    [field-ctx : TcContext
      (if (compiler-symbols-handle-found? struct-handle)
        (tc-context-with-nominal-owner-handle-module ctx struct-handle)
        (lower-context-with-nominal-owner-module-id ctx struct-id))]
    (match (if (compiler-symbols-handle-found? struct-handle)
      (lower-struct-fields-at-handle field-ctx struct-handle struct-name)
      (lower-struct-fields-id field-ctx struct-id struct-name))
      [(ResultAstFieldDefList.Ok fields)
        (let
          [struct-ty : AstType
            (tc-type-without-regions (tc-resolve-type ctx result-ty))]
          [field-types : AstTypeList
            (tc-resolve-type-list
              field-ctx
              (lower-struct-constructor-field-types-for-result
                field-ctx
                struct-ty
                fields))]
          (match (lower-args-as ctx state env type-env args field-types)
            [(ResultLowerArgs.Ok args-state values)
              (if (lower-mode-inline-aggregates? (lower-state-mode args-state))
                (lower-construct-struct-inline-from-values
                  field-ctx
                  args-state
                  struct-name
                  values
                  fields
                  struct-ty)
                (if (lower-struct-repr-c-id? field-ctx struct-id)
                  (match (tc-repr-c-struct-layout-id
                    field-ctx
                    struct-name
                    struct-id)
                    [(ResultTcReprCLayout.Ok layout)
                      (match (lower-reserve-heap-storage
                        args-state
                        (tc-repr-c-layout-size layout)
                        struct-ty)
                        [(LowerExpr.Expr base-state base _)
                          (match (lower-store-repr-c-values
                            field-ctx
                            base-state
                            base
                            values
                            (tc-repr-c-layout-fields layout))
                            [(ResultLowerState.Ok done-state)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr done-state base struct-ty))]
                            [(ResultLowerState.Err message)
                              (ResultLowerExpr.Err message)])])]
                    [(ResultTcReprCLayout.Err message)
                      (ResultLowerExpr.Err (box (lower-diagnostic message)))])
                  (let
                    [size : i64
                      (lower-type-list-storage-size field-ctx field-types)]
                    (match (lower-reserve-heap-storage
                      args-state
                      size
                      struct-ty)
                      [(LowerExpr.Expr base-state base _)
                        (match (lower-store-values
                          field-ctx
                          base-state
                          base
                          values
                          field-types
                          0)
                          [(ResultLowerState.Ok done-state)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr done-state base struct-ty))]
                          [(ResultLowerState.Err message)
                            (ResultLowerExpr.Err message)])]))))]
            [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))]
      [(ResultAstFieldDefList.Err message)
        (ResultLowerExpr.Err (box (lower-diagnostic message)))])))

(define (lower-construct-struct-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [struct-name : String]
  [struct-handle : i64]
  [args : AstExprList]
  [result-ty : AstType]) : ResultLowerState
  (let
    [result-struct-id : i64 (lower-struct-type-name-id-or result-ty -1)]
    [struct-id : i64
      (if (compiler-symbols-handle-found? struct-handle)
        (tc-nominal-owner-id-or ctx struct-handle result-struct-id)
        result-struct-id)]
    [field-ctx : TcContext
      (if (compiler-symbols-handle-found? struct-handle)
        (tc-context-with-nominal-owner-handle-module ctx struct-handle)
        (lower-context-with-nominal-owner-module-id ctx struct-id))]
    (match (if (compiler-symbols-handle-found? struct-handle)
      (lower-struct-fields-at-handle field-ctx struct-handle struct-name)
      (lower-struct-fields-id field-ctx struct-id struct-name))
      [(ResultAstFieldDefList.Ok fields)
        (let
          [struct-ty : AstType
            (tc-type-without-regions (tc-resolve-type ctx result-ty))]
          [field-types : AstTypeList
            (tc-resolve-type-list
              field-ctx
              (lower-struct-constructor-field-types-for-result
                field-ctx
                struct-ty
                fields))]
          (match (lower-args-as ctx state env type-env args field-types)
            [(ResultLowerArgs.Ok args-state values)
              (if (lower-mode-inline-aggregates? (lower-state-mode args-state))
                (lower-construct-struct-inline-into-from-values
                  field-ctx
                  args-state
                  dst
                  struct-id
                  struct-name
                  values
                  fields)
                (ResultLowerState.Err
                  (box
                    (lower-diagnostic
                      "lower: struct destination construction requires inline aggregates"))))]
            [(ResultLowerArgs.Err message) (ResultLowerState.Err message)]))]
      [(ResultAstFieldDefList.Err message)
        (ResultLowerState.Err (box (lower-diagnostic message)))])))

(define (lower-init-expr-list-from-types
  [ctx : TcContext]
  [types : AstTypeList]) : AstExprList
  (lower-init-expr-list-from-types-at ctx (& types) 0))

(define (lower-init-expr-list-from-types-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : AstExprList
  (if (>= index (ast-type-list-len types))
    (ast-expr-list-new)
    (let
      [head : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      (ast-expr-cons
        (ast-expr-init head)
        (lower-init-expr-list-from-types-at ctx types (+ index 1))))))

(define (lower-init-expr-list-repeat [ty : AstType] [count : i64]) : AstExprList
  (if (<= count 0)
    (ast-expr-list-new)
    (ast-expr-cons
      (ast-expr-init ty)
      (lower-init-expr-list-repeat ty (- count 1)))))

(define (lower-init-scalar
  [state : LowerState]
  [value : CompilerIrValue]
  [ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (lower-materialize-at-expr state value ty origin))

(define (lower-init-struct
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [struct-name : String]
  [struct-ty : AstType]) : ResultLowerExpr
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-struct-type-name-id-or struct-ty -1))]
    (if (lower-struct-repr-c-id?
      field-ctx
      (lower-struct-type-name-id-or struct-ty -1))
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic "lower: init supports only default-layout structs")))
      (match (lower-struct-fields-id
        field-ctx
        (lower-struct-type-name-id-or struct-ty -1)
        struct-name)
        [(ResultAstFieldDefList.Ok fields)
          (let
            [field-types : AstTypeList
              (tc-resolve-type-list
                field-ctx
                (lower-struct-constructor-field-types-for-result
                  field-ctx
                  struct-ty
                  fields))]
            (lower-construct-struct
              ctx
              state
              env
              type-env
              struct-name
              (lower-struct-type-handle-or
                ctx
                struct-ty
                (compiler-symbols-missing-handle))
              (lower-init-expr-list-from-types ctx field-types)
              struct-ty))]
        [(ResultAstFieldDefList.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic message)))]))))

(define (lower-init-enum
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerExpr
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-enum-type-name-id-or enum-ty -1))]
    (match (tc-enum-decl-id field-ctx (lower-enum-type-name-id-or enum-ty -1))
      [(ResultTcEnumDecl.Ok decl)
        (match decl
          [(TcEnumDecl _ variants)
            (if (ast-variant-def-list-empty? (& variants))
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic
                    "lower: init requires enum with at least one variant")))
              (let
                [variant : AstVariantDef
                  (ast-variant-def-list-get
                    (& variants)
                    0
                    (ast-variant-def-fallback))]
                (match variant
                  [(AstVariantDef.Def variant-name fields _)
                    (let
                      [lookup-name : String
                        (tc-variant-name-for-enum
                          enum-name
                          (tc-env-key-name-text variant-name))]
                      [payload-types : AstTypeList
                        (tc-resolve-type-list
                          field-ctx
                          (lower-enum-constructor-fields-for-result
                            field-ctx
                            enum-ty
                            fields))]
                      [handle : i64
                        (lower-variant-constructor-handle-id-or
                          ctx
                          (tc-env-key-name-text variant-name)
                          variant-name
                          enum-ty
                          (compiler-symbols-missing-handle))]
                      (if (compiler-symbols-handle-found? handle)
                        (lower-construct-enum-with-name
                          ctx
                          state
                          env
                          type-env
                          lookup-name
                          handle
                          (lower-init-expr-list-from-types ctx payload-types)
                          enum-name
                          enum-ty)
                        (ResultLowerExpr.Err
                          (box
                            (lower-diagnostic
                              (string.append
                                "lower: unknown variant "
                                lookup-name))))))])))])]
      [(ResultTcEnumDecl.Err message)
        (ResultLowerExpr.Err (box (lower-diagnostic message)))])))

(define (lower-init-struct-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [struct-name : String]
  [struct-ty : AstType]) : ResultLowerState
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-struct-type-name-id-or struct-ty -1))]
    (if (lower-struct-repr-c-id?
      field-ctx
      (lower-struct-type-name-id-or struct-ty -1))
      (ResultLowerState.Err
        (box
          (lower-diagnostic "lower: init supports only default-layout structs")))
      (match (lower-struct-fields-id
        field-ctx
        (lower-struct-type-name-id-or struct-ty -1)
        struct-name)
        [(ResultAstFieldDefList.Ok fields)
          (let
            [field-types : AstTypeList
              (tc-resolve-type-list
                field-ctx
                (lower-struct-constructor-field-types-for-result
                  field-ctx
                  struct-ty
                  fields))]
            (lower-construct-struct-into
              ctx
              state
              env
              type-env
              dst
              struct-name
              (lower-struct-type-handle-or
                ctx
                struct-ty
                (compiler-symbols-missing-handle))
              (lower-init-expr-list-from-types ctx field-types)
              struct-ty))]
        [(ResultAstFieldDefList.Err message)
          (ResultLowerState.Err (box (lower-diagnostic message)))]))))

(define (lower-init-enum-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [enum-name : String]
  [enum-ty : AstType]) : ResultLowerState
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-enum-type-name-id-or enum-ty -1))]
    (match (tc-enum-decl-id field-ctx (lower-enum-type-name-id-or enum-ty -1))
      [(ResultTcEnumDecl.Ok decl)
        (match decl
          [(TcEnumDecl _ variants)
            (if (ast-variant-def-list-empty? (& variants))
              (ResultLowerState.Err
                (box
                  (lower-diagnostic
                    "lower: init requires enum with at least one variant")))
              (let
                [variant : AstVariantDef
                  (ast-variant-def-list-get
                    (& variants)
                    0
                    (ast-variant-def-fallback))]
                (match variant
                  [(AstVariantDef.Def variant-name fields _)
                    (let
                      [lookup-name : String
                        (tc-variant-name-for-enum
                          enum-name
                          (tc-env-key-name-text variant-name))]
                      [payload-types : AstTypeList
                        (tc-resolve-type-list
                          field-ctx
                          (lower-enum-constructor-fields-for-result
                            field-ctx
                            enum-ty
                            fields))]
                      [handle : i64
                        (lower-variant-constructor-handle-id-or
                          ctx
                          (tc-env-key-name-text variant-name)
                          variant-name
                          enum-ty
                          (compiler-symbols-missing-handle))]
                      (if (compiler-symbols-handle-found? handle)
                        (lower-construct-enum-with-name-into
                          ctx
                          state
                          env
                          type-env
                          dst
                          lookup-name
                          handle
                          (lower-init-expr-list-from-types ctx payload-types)
                          enum-name
                          enum-ty)
                        (ResultLowerState.Err
                          (box
                            (lower-diagnostic
                              (string.append
                                "lower: unknown variant "
                                lookup-name))))))])))])]
      [(ResultTcEnumDecl.Err message)
        (ResultLowerState.Err (box (lower-diagnostic message)))])))

(define (lower-init-expr-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [ty : AstType]
  [origin : AstExpr]) : ResultLowerState
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Struct name)
        (lower-init-struct-into
          ctx
          state
          env
          type-env
          dst
          (tc-nominal-name-id-display name)
          resolved)]
      [(AstType.StructArgs name _)
        (lower-init-struct-into
          ctx
          state
          env
          type-env
          dst
          (tc-nominal-name-id-display name)
          resolved)]
      [(AstType.Enum name)
        (lower-init-enum-into
          ctx
          state
          env
          type-env
          dst
          (tc-nominal-name-id-display name)
          resolved)]
      [(AstType.EnumArgs name _)
        (lower-init-enum-into
          ctx
          state
          env
          type-env
          dst
          (tc-nominal-name-id-display name)
          resolved)]
      [_
        (ResultLowerState.Err
          (box
            (lower-diagnostic-at-expr
              origin
              (string.append
                "lower: init unsupported type "
                (tc-type-render resolved)))))])))

(define (lower-init-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [ty : AstType]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (if (tc-integer-type? resolved)
      (lower-init-scalar state (CompilerIrValue.I64 0) expr-ty origin)
      (match resolved
        [(AstType.F64)
          (lower-init-scalar
            state
            (CompilerIrValue.F64 (lower-float-literal-bits "0.0" (AstType.F64)))
            expr-ty
            origin)]
        [(AstType.F32)
          (lower-init-scalar
            state
            (CompilerIrValue.F64 (lower-float-literal-bits "0.0" (AstType.F32)))
            expr-ty
            origin)]
        [(AstType.Bool)
          (lower-init-scalar state (CompilerIrValue.Bool false) expr-ty origin)]
        [(AstType.Char)
          (lower-init-scalar state (CompilerIrValue.Char '\0') expr-ty origin)]
        [(AstType.Unit)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr state CompilerIrValue.Unit expr-ty))]
        [(AstType.String)
          (lower-init-scalar state (CompilerIrValue.String "") expr-ty origin)]
        [(AstType.Ptr _)
          (match (lower-materialize state (CompilerIrValue.I64 0) (AstType.U64))
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr null-state null-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr null-state null-value expr-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
        [(AstType.MutPtr _)
          (match (lower-materialize state (CompilerIrValue.I64 0) (AstType.U64))
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr null-state null-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr null-state null-value expr-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
        [(AstType.DynArray elem)
          (lower-make-array-from-len
            ctx
            state
            env
            type-env
            (tc-context-type-get ctx elem)
            (CompilerIrValue.I64 0)
            (AstType.I64)
            (AstExpr.Literal (ast-lit-int 0))
            origin)]
        [(AstType.Box elem)
          (lower-box
            ctx
            state
            env
            type-env
            (AstExpr.Init (AstMaybeType.Some (tc-context-type-get ctx elem)))
            expr-ty)]
        [(AstType.Tuple elems)
          (lower-tuple
            ctx
            state
            env
            type-env
            (lower-init-expr-list-from-types ctx (box-get elems))
            expr-ty
            origin)]
        [(AstType.Array elem count)
          (if (< count 0)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic
                  "lower: init fixed array length must be non-negative")))
            (lower-array-literal
              ctx
              state
              env
              type-env
              (lower-init-expr-list-repeat (tc-context-type-get ctx elem) count)
              expr-ty
              origin))]
        [(AstType.Struct name)
          (lower-init-struct
            ctx
            state
            env
            type-env
            (tc-nominal-name-id-display name)
            resolved)]
        [(AstType.StructArgs name _)
          (lower-init-struct
            ctx
            state
            env
            type-env
            (tc-nominal-name-id-display name)
            resolved)]
        [(AstType.Enum name)
          (lower-init-enum
            ctx
            state
            env
            type-env
            (tc-nominal-name-id-display name)
            resolved)]
        [(AstType.EnumArgs name _)
          (lower-init-enum
            ctx
            state
            env
            type-env
            (tc-nominal-name-id-display name)
            resolved)]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (string.append
                  "lower: init unsupported type "
                  (tc-type-render resolved)))))]))))

(define (lower-nullary-variant-result-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ false]))

(define (lower-nullary-variant-or-function-value
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (lower-nullary-variant-result-type? expr-ty)
    (let
      [lookup-name : String
        (lower-variant-constructor-lookup-name ctx name raw-name-id expr-ty)]
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [handle : i64
        (lower-variant-constructor-handle-id-or
          ctx
          name
          raw-name-id
          expr-ty
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? handle)
        (match (compiler-registries-variant-fields-indexed symbols handle)
          [(ResultAstTypeList.Ok fields)
            (if (ast-type-list-empty? (& fields))
              (lower-construct-enum-with-handle
                ctx
                state
                env
                type-env
                lookup-name
                handle
                (ast-expr-list-new)
                expr-ty)
              (lower-function-value-or-var-id
                ctx
                state
                env
                lookup-name-id
                expr-ty))]
          [(ResultAstTypeList.Err _)
            (lower-function-value-or-var-id
              ctx
              state
              env
              lookup-name-id
              expr-ty)])
        (lower-function-value-or-var-id ctx state env lookup-name-id expr-ty)))
    (lower-function-value-or-var-id ctx state env lookup-name-id expr-ty)))

;; A register-group GLOBAL stores its two words inline at the symbol; a
;; read of it yields `CompilerIrValue.Global name` (the storage), which must be
;; materialized into a register-group VALUE by loading both words from the
;; symbol's address. Local group vars (CompilerIrValue.Var) and non-group values pass
;; through unchanged.
(define (lower-materialize-group-global
  [ctx : TcContext]
  [result : ResultLowerExpr]) : ResultLowerExpr
  (match result
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr s v t)
          (match v
            [(CompilerIrValue.Global name)
              (if (lower-type-register-group? ctx t)
                (match (lower-load-group-from-ptr
                  ctx
                  s
                  (CompilerIrValue.GlobalAddr name)
                  t)
                  [(LowerExpr.Expr ls lv _)
                    (ResultLowerExpr.Ok (LowerExpr.Expr ls lv t))])
                (ResultLowerExpr.Ok lowered))]
            [_ (ResultLowerExpr.Ok lowered)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-var-or-nullary-variant-id
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]
  [expr-ty : AstType]) : ResultLowerExpr
  ;; Mirror lower-var-or-nullary-variant -- a register-group GLOBAL read
  ;; yields CompilerIrValue.Global and must be materialized into a group VALUE (load both
  ;; words) before any CompilerIrInstr.Word/struct-get/match extraction; main's interned
  ;; -id path dropped this wrapper, so reg-group globals faulted.
  (lower-materialize-group-global
    ctx
    (if (sym_i64_env.sym-i64-contains-id env name-id)
      (lower-var-id-storage-aware ctx state env name-id expr-ty)
      (let
        [name : String
          (intern-str (macro-hygiene-global-source-name-id-or name-id name-id))]
        (match (tc-source-name-lookup-key-with-field-check-lookup
          ctx
          type-env
          name
          name-id
          true)
          [(TcNameLookup.Ok lookup-name lookup-name-id)
            (lower-nullary-variant-or-function-value
              ctx
              state
              env
              type-env
              lookup-name
              name-id
              lookup-name-id
              expr-ty)]
          [(TcNameLookup.Err message)
            (ResultLowerExpr.Err (box (lower-diagnostic message)))])))))

(define (lower-call-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (match (ast-expr-unspan func)
    [(AstExpr.Var name)
      (let
        [source-id : i64 (macro-hygiene-global-source-name-id-or name name)]
        (if (and
          (cbi.compiler-builtin-lower-clone-id? source-id)
          (= (struct-get (& args) len) 1))
          (lower-expr-result-type-fast
            ctx
            env
            type-env
            type-cache
            (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0)))
          (match (lower-lookup-type-id ctx type-cache env type-env name)
            [(ResultTcType.Ok fn-ty)
              (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
                [(AstType.Func _ ret)
                  (ResultTcType.Ok
                    (tc-type-without-regions
                      (tc-resolve-type ctx (tc-context-type-get ctx ret))))]
                [(AstType.Enum _)
                  (ResultTcType.Ok (tc-type-without-regions fn-ty))]
                [_
                  (ResultTcType.Err
                    "lower: call result type is not fast-pathable")])]
            [(ResultTcType.Err message)
              (if (lower-builtin-call-available-id? ctx env source-id)
                (cond
                  [(cbi.compiler-builtin-lower-length-call-id? source-id)
                    (ResultTcType.Ok (AstType.I64))]
                  [(cbi.compiler-builtin-lower-string-ref-call-id? source-id)
                    (ResultTcType.Ok (AstType.Char))]
                  [(cbi.compiler-builtin-lower-clone-id? source-id)
                    (if (= (struct-get (& args) len) 1)
                      (lower-expr-result-type-fast
                        ctx
                        env
                        type-env
                        type-cache
                        (lower-context-expr-get
                          ctx
                          (ast-expr-list-get (& args) 0 0)))
                      (ResultTcType.Err
                        "lower: call result type is not fast-pathable"))]
                  [else (ResultTcType.Err message)])
                (ResultTcType.Err message))])))]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (match (tc-lambda-expr-allow-ref-captures
              ctx
              type-env
              params
              maybe-ret
              body)
              [(ResultTcType.Ok fn-ty)
                (match fn-ty
                  [(AstType.Func _ ret)
                    (ResultTcType.Ok
                      (tc-type-without-regions
                        (tc-resolve-type ctx (tc-context-type-get ctx ret))))]
                  [_
                    (ResultTcType.Err
                      "lower: call result type is not fast-pathable")])]
              [(ResultTcType.Err message) (ResultTcType.Err message)]))])]
    [_ (ResultTcType.Err "lower: call result type is not fast-pathable")]))

(define (lower-binary-result-type-fast
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultTcType
  (match (tc-binop-expr-types ctx type-env op left right)
    [(ResultTcBinOpTypes.Ok binop-types)
      (match binop-types
        [(TcBinOpTypes _ _ result-ty)
          (ResultTcType.Ok
            (tc-type-without-regions (tc-resolve-type ctx result-ty)))])]
    [(ResultTcBinOpTypes.Err message) (ResultTcType.Err message)]))

(define (lower-binop-types-with-result
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]
  [expr-ty : AstType]) : ResultTcBinOpTypes
  (let
    [operand-expected : AstType
      (tc-type-without-regions (tc-resolve-type ctx expr-ty))]
    (match (tc-binop-contextual-operand-type op operand-expected)
      [(AstMaybeType.No) (tc-binop-expr-types ctx type-env op left right)]
      [(AstMaybeType.Some operand-ty)
        (match (tc-expr-with-expected-or-actual ctx type-env left operand-ty)
          [(ResultTcType.Ok left-ty)
            (match (tc-expr-with-expected-or-actual
              ctx
              type-env
              right
              operand-ty)
              [(ResultTcType.Ok right-ty)
                (match (tc-binop-type op left-ty right-ty)
                  [(ResultTcType.Ok result-ty)
                    (if (tc-type-compatible? expr-ty result-ty)
                      (ResultTcBinOpTypes.Ok
                        (TcBinOpTypes
                          left-ty
                          right-ty
                          (tc-contextual-result-type expr-ty result-ty)))
                      (tc-binop-expr-types ctx type-env op left right))]
                  [(ResultTcType.Err _)
                    (tc-binop-expr-types ctx type-env op left right)])]
              [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])]
          [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])])))

(define (lower-unop-type-with-result
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [op : AstUnOp]
  [inner : AstExpr]
  [expr-ty : AstType]) : ResultTcType
  (let
    [operand-expected : AstType
      (tc-type-without-regions (tc-resolve-type ctx expr-ty))]
    (match (tc-unop-contextual-operand-type op operand-expected)
      [(AstMaybeType.No)
        (match (tc-expr ctx type-env inner)
          [(ResultTcType.Ok inner-ty) (tc-unop-type op inner-ty)]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(AstMaybeType.Some operand-ty)
        (match (tc-expr-with-expected-or-actual ctx type-env inner operand-ty)
          [(ResultTcType.Ok inner-ty)
            (match (tc-unop-type op inner-ty)
              [(ResultTcType.Ok result-ty)
                (if (tc-type-compatible? expr-ty result-ty)
                  (ResultTcType.Ok
                    (tc-contextual-result-type expr-ty result-ty))
                  (tc-unop-type op inner-ty))]
              [(ResultTcType.Err _)
                (match (tc-expr ctx type-env inner)
                  [(ResultTcType.Ok actual-ty) (tc-unop-type op actual-ty)]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (lower-if-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [then-branch : AstExpr]
  [else-branch : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache then-branch)
    [(ResultTcType.Ok then-ty)
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        else-branch)
        [(ResultTcType.Ok else-ty)
          (match (tc-merge-branch-type ctx then-ty else-ty)
            [(ResultTcType.Ok merged) (ResultTcType.Ok merged)]
            [(ResultTcType.Err message)
              (if (and
                (tc-integer-literal-expr? then-branch)
                (tc-integer-type? else-ty))
                (match (tc-integer-literal-expr-with-expected
                  ctx
                  then-branch
                  else-ty)
                  [(ResultTcType.Ok contextual-then)
                    (tc-merge-branch-type ctx contextual-then else-ty)]
                  [(ResultTcType.Err literal-message)
                    (ResultTcType.Err literal-message)])
                (if (and
                  (tc-integer-literal-expr? else-branch)
                  (tc-integer-type? then-ty))
                  (match (tc-integer-literal-expr-with-expected
                    ctx
                    else-branch
                    then-ty)
                    [(ResultTcType.Ok contextual-else)
                      (tc-merge-branch-type ctx then-ty contextual-else)]
                    [(ResultTcType.Err literal-message)
                      (ResultTcType.Err literal-message)])
                  (ResultTcType.Err message)))])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-expr-list-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [exprs : AstExprList]) : ResultTcType
  (let
    [len : i64 (struct-get (& exprs) len)]
    (if (= len 0)
      (ResultTcType.Ok (AstType.Unit))
      (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        (lower-context-expr-get ctx (ast-expr-list-get (& exprs) (- len 1) 0))))))

(define (lower-pattern-list-bind-local-names
  [env : sym_i64_env.SymI64Env]
  [patterns : AstPatternList]) : sym_i64_env.SymI64Env
  (lower-pattern-list-bind-local-names-at env (& patterns) 0))

(define (lower-pattern-list-bind-local-names-at
  [env : sym_i64_env.SymI64Env]
  [patterns : (& patterns AstPatternList)]
  [index : i64]) : sym_i64_env.SymI64Env
  (if (>= index (struct-get patterns len))
    env
    (lower-pattern-list-bind-local-names-at
      (lower-pattern-bind-local-names
        env
        (ast-pattern-list-get patterns index (ast-pattern-fallback)))
      patterns
      (+ index 1))))

(define (lower-pattern-bind-local-names
  [env : sym_i64_env.SymI64Env]
  [pattern : AstPattern]) : sym_i64_env.SymI64Env
  (match pattern
    [(AstPattern.Var name _) (sym_i64_env.sym-i64-bind-id env name 0)]
    [(AstPattern.Tuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (lower-pattern-list-bind-local-names env patterns))]
    [(AstPattern.Binding name) (sym_i64_env.sym-i64-bind-id env name 0)]
    [(AstPattern.Variant _ args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (lower-pattern-list-bind-local-names env args))]
    [_ env]))

(define (lower-match-pattern-bind-local-names
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : sym_i64_env.SymI64Env
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(AstType.Enum _)
      (match pattern
        [(AstPattern.Variant _ args-box)
          (let
            [args : AstPatternList (box-get args-box)]
            (lower-pattern-list-bind-local-names env args))]
        [_ env])]
    [_ (lower-pattern-bind-local-names env pattern)]))

(define (lower-match-arm-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [scrut-ty : AstType]
  [arm : AstMatchArm]) : ResultTcType
  (match arm
    [(AstMatchArm.Arm pattern body-box)
      (let
        [body : AstExpr (lower-context-expr-get ctx body-box)]
        (match (tc-bind-match-pattern ctx type-env scrut-ty pattern)
          [(ResultTcEnv.Ok arm-type-env)
            (lower-expr-result-type-fast
              ctx
              (lower-match-pattern-bind-local-names ctx env scrut-ty pattern)
              arm-type-env
              type-cache
              body)]
          [(ResultTcEnv.Err message) (ResultTcType.Err message)]))]))

(define (lower-match-rest-result-types-fast-at
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [index : i64]
  [want : AstType]) : ResultTcType
  (if (>= index (struct-get arms len))
    (ResultTcType.Ok want)
    (match (lower-match-arm-result-type-fast
      ctx
      env
      type-env
      type-cache
      scrut-ty
      (ast-match-arm-list-get arms index (ast-match-arm-fallback)))
      [(ResultTcType.Ok got)
        (match (tc-merge-branch-type ctx want got)
          [(ResultTcType.Ok merged)
            (lower-match-rest-result-types-fast-at
              ctx
              env
              type-env
              type-cache
              scrut-ty
              arms
              (+ index 1)
              merged)]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (lower-match-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache scrutinee)
    [(ResultTcType.Ok scrut-ty)
      (if (ast-match-arm-list-empty? (& arms))
        (ResultTcType.Err "lower: match result type is not fast-pathable")
        (match (lower-match-arm-result-type-fast
          ctx
          env
          type-env
          type-cache
          scrut-ty
          (ast-match-arm-list-get (& arms) 0 (ast-match-arm-fallback)))
          [(ResultTcType.Ok first-ty)
            (lower-match-rest-result-types-fast-at
              ctx
              env
              type-env
              type-cache
              scrut-ty
              (& arms)
              1
              first-ty)]
          [(ResultTcType.Err message) (ResultTcType.Err message)]))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-let-binding-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]) : ResultTcType
  (match maybe-ty
    [(AstMaybeType.Some ty)
      (ResultTcType.Ok (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstMaybeType.No)
      (if (tc-ref-capturing-lambda-init? type-env init)
        (match (ast-expr-unspan init)
          [(AstExpr.Lambda lambda-box)
            (match (box-get lambda-box)
              [(AstLambda.Lambda params maybe-ret body-box)
                (let
                  [body : AstExpr (lower-context-expr-get ctx body-box)]
                  (tc-lambda-expr-allow-ref-captures
                    ctx
                    type-env
                    params
                    maybe-ret
                    body))])]
          [_ (lower-expr-result-type-fast ctx env type-env type-cache init)])
        (lower-expr-result-type-fast ctx env type-env type-cache init))]))

(define (lower-let-bindings-type-env-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [bindings : AstLetBindingList]) : ResultTcEnv
  (lower-let-bindings-type-env-fast-at
    ctx
    env
    type-env
    type-cache
    (& bindings)
    0))

(define (lower-let-bindings-type-env-fast-at
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultTcEnv.Ok type-env)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [name-id : i64 name]
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          (match (lower-let-binding-result-type-fast
            ctx
            env
            type-env
            type-cache
            maybe-ty
            init)
            [(ResultTcType.Ok binding-ty)
              (lower-let-bindings-type-env-fast-at
                ctx
                (sym_i64_env.sym-i64-bind-id env name-id 0)
                (tc-bind-c-abi-fnptr-if-needed-id
                  ctx
                  type-env
                  name-id
                  binding-ty
                  init)
                type-cache
                bindings
                (+ index 1))]
            [(ResultTcType.Err message) (ResultTcEnv.Err message)]))])))

(define (lower-let-bindings-local-env
  [env : sym_i64_env.SymI64Env]
  [bindings : AstLetBindingList]) : sym_i64_env.SymI64Env
  (lower-let-bindings-local-env-at env (& bindings) 0))

(define (lower-let-bindings-local-env-at
  [env : sym_i64_env.SymI64Env]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : sym_i64_env.SymI64Env
  (if (>= index (ast-let-binding-list-len bindings))
    env
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name _ _)
        (lower-let-bindings-local-env-at
          (sym_i64_env.sym-i64-bind-id env name 0)
          bindings
          (+ index 1))])))

(define (lower-projected-result-type-fast
  [ctx : TcContext]
  [container-ty : AstType]
  [projected-ty : AstType]) : AstType
  (tc-type-without-regions
    (tc-resolve-type
      ctx
      (tc-project-from-region-container container-ty projected-ty))))

(define (lower-index-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [index : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache index)
    [(ResultTcType.Ok index-ty)
      (if (tc-integer-type? index-ty)
        (ResultTcType.Ok index-ty)
        (ResultTcType.Err "lower: index result type is not fast-pathable"))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-unary-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [op : AstUnOp]
  [inner : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache inner)
    [(ResultTcType.Ok inner-ty)
      (match (tc-unop-type op inner-ty)
        [(ResultTcType.Ok result-ty)
          (ResultTcType.Ok
            (tc-type-without-regions (tc-resolve-type ctx result-ty)))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-tuple-ref-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [tuple-expr : AstExpr]
  [index : i64]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache tuple-expr)
    [(ResultTcType.Ok tuple-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx tuple-ty))
        [(AstType.Tuple elem-tys)
          (match (tc-type-list-ref (box-get elem-tys) index)
            [(ResultTcType.Ok elem-ty)
              (ResultTcType.Ok
                (lower-projected-result-type-fast ctx tuple-ty elem-ty))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [_
          (ResultTcType.Err "lower: tuple-ref result type is not fast-pathable")])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-array-ref-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [array-expr : AstExpr]
  [index : AstExpr]) : ResultTcType
  (match (lower-index-result-type-fast ctx env type-env type-cache index)
    [(ResultTcType.Ok _)
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        type-cache
        array-expr)
        [(ResultTcType.Ok array-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
            [(AstType.Array elem-ty _)
              (ResultTcType.Ok
                (lower-projected-result-type-fast
                  ctx
                  array-ty
                  (tc-context-type-get ctx elem-ty)))]
            [(AstType.DynArray elem-ty)
              (ResultTcType.Ok
                (lower-projected-result-type-fast
                  ctx
                  array-ty
                  (tc-context-type-get ctx elem-ty)))]
            [_
              (ResultTcType.Err
                "lower: array-ref result type is not fast-pathable")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-string-ref-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [str : AstExpr]
  [index : AstExpr]) : ResultTcType
  (match (lower-index-result-type-fast ctx env type-env type-cache index)
    [(ResultTcType.Ok _)
      (match (lower-expr-result-type-fast ctx env type-env type-cache str)
        [(ResultTcType.Ok str-ty)
          (if (lower-string-handle-type? ctx str-ty)
            (ResultTcType.Ok (AstType.Char))
            (ResultTcType.Err
              "lower: string-ref result type is not fast-pathable"))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-struct-get-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [receiver : AstExpr]
  [field : i64]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache receiver)
    [(ResultTcType.Ok receiver-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
        [(AstType.Struct struct-name)
          (match (tc-struct-field-type-id ctx struct-name field)
            [(ResultTcType.Ok field-ty)
              (ResultTcType.Ok
                (lower-projected-result-type-fast ctx receiver-ty field-ty))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(AstType.StructArgs struct-name lifetimes)
          (match (tc-struct-field-type-with-args-id
            ctx
            struct-name
            (box-get lifetimes)
            field)
            [(ResultTcType.Ok field-ty)
              (ResultTcType.Ok
                (lower-projected-result-type-fast ctx receiver-ty field-ty))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [_
          (ResultTcType.Err
            "lower: struct-get result type is not fast-pathable")])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (lower-box-get-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [box-expr : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache box-expr)
    [(ResultTcType.Ok box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstType.Box inner-ty)
          (ResultTcType.Ok
            (lower-projected-result-type-fast
              ctx
              box-ty
              (tc-context-type-get ctx inner-ty)))]
        [_ (ResultTcType.Err "lower: box-get result type is not fast-pathable")])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

;; Compile-time: memoize lower-expr-result-type-fast by AST node id.
;; lower-expr-origin computes each expr's result type (walking the result-
;; determining spine) BEFORE lowering, and lowering the children re-walks their
;; spines -- so for deeply-nested functions a node's spine is recomputed once per
;; ancestor: O(N^2), the dominant lower-phase cost (single big functions allocated
;; hundreds of MB of transient). The cache is a fixed direct-mapped global array
;; keyed by the spanned node id, validated by a PER-FUNCTION generation counter
;; (tc-rtf-next-gen! is bumped at each lower-function-escaping). The generation
;; makes it both correct (a node's type-env is fixed within its own function) and
;; arena-safe (an entry is only ever read within the same function's lowering,
;; while that function's scratch arena is still live -- the next function bumps
;; the generation, so a stale scratch-allocated type is never read). A slot
;; collision (different id, same slot) misses via the stored-id check.
(define tc-rtf-cap : i64
  65536)
(define tc-rtf-gen-arr : (Array i64)
  (make-array i64 tc-rtf-cap))
(define tc-rtf-id-arr : (Array i64)
  (make-array i64 tc-rtf-cap))
(define tc-rtf-ty-arr : (Array AstType)
  (make-array AstType tc-rtf-cap))
(define tc-rtf-current-gen : i64
  0)
(define tc-rtf-filled : bool
  false)

(define (tc-rtf-ensure!) : unit
  (if tc-rtf-filled
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-rtf-cap)
          (begin
            (array-set! tc-rtf-gen-arr i 0)
            (set! i (+ i 1))))
        (set! tc-rtf-filled true)))))

(define (tc-rtf-next-gen!) : unit
  (begin
    (tc-rtf-ensure!)
    (set! tc-rtf-current-gen (+ tc-rtf-current-gen 1))))

(define (lower-expr-result-type-fast
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [expr : AstExpr]) : ResultTcType
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [slot : i64 (% inner-box tc-rtf-cap)]
        (if (if (= (array-ref tc-rtf-gen-arr slot) tc-rtf-current-gen)
          (= (array-ref tc-rtf-id-arr slot) inner-box)
          false)
          (ResultTcType.Ok (array-ref tc-rtf-ty-arr slot))
          (match (lower-expr-result-type-fast
            ctx
            env
            type-env
            type-cache
            (lower-context-expr-get ctx inner-box))
            [(ResultTcType.Ok ty)
              (begin
                (array-set! tc-rtf-gen-arr slot tc-rtf-current-gen)
                (array-set! tc-rtf-id-arr slot inner-box)
                (array-set! tc-rtf-ty-arr slot ty)
                (ResultTcType.Ok ty))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])))]
    [(AstExpr.Literal lit) (ResultTcType.Ok (tc-literal-type lit))]
    [(AstExpr.BinaryData _) (ResultTcType.Ok (ast-ty-dyn-array (AstType.U8)))]
    [(AstExpr.SpmdProgramIndex) (ResultTcType.Ok (AstType.I64))]
    [(AstExpr.SpmdProgramCount) (ResultTcType.Ok (AstType.I64))]
    [(AstExpr.Var name)
      (match (lower-lookup-type-id ctx type-cache env type-env name)
        [(ResultTcType.Ok expr-ty)
          (ResultTcType.Ok (tc-type-without-regions expr-ty))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.Some ty)
          (ResultTcType.Ok (tc-type-without-regions (tc-resolve-type ctx ty)))]
        [(AstMaybeType.No)
          (ResultTcType.Err "lower: contextual init requires an expected type")])]
    [(AstExpr.Ann _ ty)
      (ResultTcType.Ok (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstExpr.Cast _ ty)
      (ResultTcType.Ok (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-unary-result-type-fast ctx env type-env type-cache op inner))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (lower-context-expr-get ctx func-box)]
        (lower-call-result-type-fast ctx env type-env type-cache func args))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (lower-binary-result-type-fast ctx type-env op left right))]
    [(AstExpr.If _ then-branch-box else-branch-box)
      (let
        [then-branch : AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-if-result-type-fast
          ctx
          env
          type-env
          type-cache
          then-branch
          else-branch))]
    [(AstExpr.Begin exprs)
      (lower-expr-list-result-type-fast ctx env type-env type-cache exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-expr-list-result-type-fast
        ctx
        env
        (tc-enter-unsafe type-env)
        type-cache
        exprs)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-match-result-type-fast
              ctx
              env
              type-env
              type-cache
              scrutinee
              arms))])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings-type-env-fast
              ctx
              env
              type-env
              type-cache
              bindings)
              [(ResultTcEnv.Ok body-type-env)
                (lower-expr-result-type-fast
                  ctx
                  (lower-let-bindings-local-env env bindings)
                  body-type-env
                  type-cache
                  body)]
              [(ResultTcEnv.Err message) (ResultTcType.Err message)]))])]
    [(AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : AstExpr (lower-context-expr-get ctx tuple-expr-box)]
        (lower-tuple-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          tuple-expr
          index))]
    [(AstExpr.ArrayRef array-expr-box index-box)
      (let
        [array-expr : AstExpr (lower-context-expr-get ctx array-expr-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (lower-array-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          array-expr
          index))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (lower-context-expr-get ctx str-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (lower-string-ref-result-type-fast
          ctx
          env
          type-env
          type-cache
          str
          index))]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-struct-get-result-type-fast
          ctx
          env
          type-env
          type-cache
          receiver
          field))]
    [(AstExpr.BoxGet box-expr-box)
      (let
        [box-expr : AstExpr (lower-context-expr-get ctx box-expr-box)]
        (lower-box-get-result-type-fast ctx env type-env type-cache box-expr))]
    [(AstExpr.BoxTake box-expr-box)
      (let
        [box-expr : AstExpr (lower-context-expr-get ctx box-expr-box)]
        (lower-box-get-result-type-fast ctx env type-env type-cache box-expr))]
    [(AstExpr.Set _ _) (ResultTcType.Ok (AstType.Unit))]
    [(AstExpr.StructSet _ _ _) (ResultTcType.Ok (AstType.Unit))]
    [(AstExpr.BoxSet _ _) (ResultTcType.Ok (AstType.Unit))]
    [_ (ResultTcType.Err "lower: expression result type is not fast-pathable")]))

(define (lower-expr-result-type-or-check
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [expr : AstExpr]) : ResultTcType
  (match (lower-expr-result-type-fast ctx env type-env type-cache expr)
    [(ResultTcType.Ok expr-ty) (ResultTcType.Ok expr-ty)]
    [(ResultTcType.Err _) (tc-expr ctx type-env expr)]))

(define (lower-index-result-type-or-check
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [type-cache : LowerTypeCache]
  [index : AstExpr]) : ResultTcType
  (match (lower-index-result-type-fast ctx env type-env type-cache index)
    [(ResultTcType.Ok index-ty) (ResultTcType.Ok index-ty)]
    [(ResultTcType.Err _)
      (match (tc-expr-with-expected-or-actual ctx type-env index (AstType.I64))
        [(ResultTcType.Ok index-ty)
          (if (tc-integer-type? index-ty)
            (ResultTcType.Ok
              (tc-type-without-regions (tc-resolve-type ctx index-ty)))
            (ResultTcType.Err "lower: index result type is not fast-pathable"))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]))

(define (lower-ptr-addr-of-local-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? local-id)
      (match (lower-lookup-type-id
        ctx
        (lower-state-type-cache state)
        env
        type-env
        name)
        [(ResultTcType.Ok place-ty)
          (if (lower-borrow-place-value-reference? ctx place-ty)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                state
                (CompilerIrValue.Var local-id)
                (tc-type-without-regions (tc-resolve-type ctx place-ty))))
            (match (lower-state-alloc-var state)
              [(LowerAlloc.Alloc allocated var-id)
                (let
                  [addr-state : LowerState
                    (lower-state-emit-at-expr
                      allocated
                      (CompilerIrInstr.AddrOf var-id local-id)
                      origin)]
                  [marked-state : LowerState
                    (if (lower-type-register-resident? ctx place-ty)
                      (lower-state-register-address-taken-mark
                        addr-state
                        local-id)
                      addr-state)]
                  [addr-ty : AstType
                    (tc-type-without-regions (tc-resolve-type ctx place-ty))]
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      marked-state
                      (CompilerIrValue.Var var-id)
                      addr-ty)))]))]
        [(ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))])
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: ptr-addr-of requires local or parameter storage"))))))

(define (lower-integer-expr-with-expected-or-actual
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [expected-ty : AstType]
  [non-integer-message : String]) : ResultLowerExpr
  (match (tc-expr-with-expected-or-actual ctx type-env expr expected-ty)
    [(ResultTcType.Ok expr-ty)
      (let
        [resolved-ty : AstType
          (tc-type-without-regions (tc-resolve-type ctx expr-ty))]
        (if (tc-integer-type? resolved-ty)
          (lower-expr-expected ctx state env type-env expr resolved-ty expr)
          (ResultLowerExpr.Err
            (box (lower-diagnostic-at-expr expr non-integer-message)))))]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-expr-typechecked
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-expr ctx type-env expr)
    [(ResultTcType.Ok expr-ty)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc-type-without-regions expr-ty))]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-cast-source-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (if (tc-integer-literal-expr? expr)
    (lower-expr-with-type ctx state env type-env expr origin (AstType.I64))
    (lower-expr ctx state env type-env expr)))

;; Lowering runs after full-program typecheck. For result types that are
;; syntactically available, avoid re-running recursive expression typecheck;
;; the fallback below preserves the old path for anything ambiguous.
(define (lower-expr-origin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-origin ctx state env type-env inner origin))]
    [(AstExpr.Literal lit)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc-literal-type lit))]
    [(AstExpr.BinaryData _)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (ast-ty-dyn-array (AstType.U8)))]
    [(AstExpr.Var name)
      (if (tc-dotted-local-field-name-id? type-env name)
        (match (tc-dotted-local-field-expr-id type-env name)
          [(ResultTcExprId.Ok virtual-id)
            (lower-expr-origin
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin)]
          [(ResultTcExprId.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))])
        (match (lower-lookup-type-id
          ctx
          (lower-state-type-cache state)
          env
          type-env
          name)
          [(ResultTcType.Ok expr-ty)
            (lower-expr-with-type
              ctx
              state
              env
              type-env
              expr
              origin
              (tc-type-without-regions expr-ty))]
          [(ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))]))]
    [(AstExpr.Ann _ ty)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstExpr.Cast _ ty)
      (lower-expr-with-type
        ctx
        state
        env
        type-env
        expr
        origin
        (tc-type-without-regions (tc-resolve-type ctx ty)))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (match (lower-binary-result-type-fast ctx type-env op left right)
          [(ResultTcType.Ok expr-ty)
            (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
          [(ResultTcType.Err _)
            (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (lower-context-expr-get ctx func-box)]
        (match (lower-call-result-type-fast
          ctx
          env
          type-env
          (lower-state-type-cache state)
          func
          args)
          [(ResultTcType.Ok expr-ty)
            (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
          [(ResultTcType.Err _)
            (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(ResultLowerEnv.Ok binding-state body-env body-type-env)
                (lower-expr ctx binding-state body-env body-type-env body)]
              [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))])]
    [(AstExpr.Begin exprs) (lower-begin ctx state env type-env exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-begin ctx state env (tc-enter-unsafe type-env) exprs)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-branch-box)]
        (match (lower-if-result-type-fast
          ctx
          env
          type-env
          (lower-state-type-cache state)
          then-branch
          else-branch)
          [(ResultTcType.Ok expr-ty)
            (lower-if
              ctx
              state
              env
              type-env
              cond
              then-branch
              else-branch
              expr-ty)]
          [(ResultTcType.Err _)
            (lower-expr-typechecked ctx state env type-env expr origin)]))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (match (lower-match-result-type-fast
              ctx
              env
              type-env
              (lower-state-type-cache state)
              scrutinee
              arms)
              [(ResultTcType.Ok expr-ty)
                (lower-match ctx state env type-env scrutinee arms expr-ty)]
              [(ResultTcType.Err _)
                (lower-expr-typechecked ctx state env type-env expr origin)]))])]
    [_
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        (lower-state-type-cache state)
        expr)
        [(ResultTcType.Ok expr-ty)
          (lower-expr-with-type ctx state env type-env expr origin expr-ty)]
        [(ResultTcType.Err _)
          (lower-expr-typechecked ctx state env type-env expr origin)])]))

(define (lower-expr
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : ResultLowerExpr
  (lower-expr-origin ctx state env type-env expr expr))

(define (lower-expr-with-type
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-with-type ctx state env type-env inner origin expr-ty))]
    [(AstExpr.Literal lit)
      (lower-materialize-at-expr
        state
        (lower-literal-value-with-type lit expr-ty)
        expr-ty
        origin)]
    [(AstExpr.BinaryData bytes)
      (lower-materialize-at-expr
        state
        (CompilerIrValue.Bytes bytes)
        expr-ty
        origin)]
    [(AstExpr.SpmdProgramIndex)
      (lower-materialize-at-expr state (CompilerIrValue.I64 0) expr-ty origin)]
    [(AstExpr.SpmdProgramCount)
      (lower-materialize-at-expr state (CompilerIrValue.I64 1) expr-ty origin)]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.Some ty)
          (lower-init-expr ctx state env type-env ty origin expr-ty)]
        [(AstMaybeType.No)
          (lower-init-expr ctx state env type-env expr-ty origin expr-ty)])]
    [(AstExpr.Var name)
      (if (tc-dotted-local-field-name-id? type-env name)
        (match (tc-dotted-local-field-expr-id type-env name)
          [(ResultTcExprId.Ok virtual-id)
            (lower-expr-with-type
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin
              expr-ty)]
          [(ResultTcExprId.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))])
        (lower-var-or-nullary-variant-id ctx state env type-env name expr-ty))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-expr-expected ctx state env type-env inner expr-ty origin)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr inner-state value _)
                (ResultLowerExpr.Ok (LowerExpr.Expr inner-state value expr-ty))])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-cast-source-expr ctx state env type-env inner origin)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr inner-state value inner-ty)
                (ResultLowerExpr.Ok
                  (lower-cast-value inner-state value inner-ty expr-ty))])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(AstExpr.Borrow _ _ inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-borrow-expr ctx state env type-env inner origin expr-ty))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-unop-type-with-result ctx type-env op inner expr-ty)
          [(ResultTcType.Ok result-ty)
            (match (tc-unop-contextual-operand-type op result-ty)
              [(AstMaybeType.No)
                (match (lower-expr ctx state env type-env inner)
                  [(ResultLowerExpr.Ok lowered)
                    (match lowered
                      [(LowerExpr.Expr inner-state value _)
                        (match (lower-state-alloc-var inner-state)
                          [(LowerAlloc.Alloc allocated var-id)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                (lower-state-emit-at-expr
                                  allocated
                                  (CompilerIrInstr.UnOp
                                    var-id
                                    (lower-unop op)
                                    value
                                    result-ty)
                                  origin)
                                (CompilerIrValue.Var var-id)
                                result-ty))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
              [(AstMaybeType.Some operand-ty)
                (match (lower-expr-expected
                  ctx
                  state
                  env
                  type-env
                  inner
                  operand-ty
                  inner)
                  [(ResultLowerExpr.Ok lowered)
                    (match lowered
                      [(LowerExpr.Expr inner-state value _)
                        (match (lower-state-alloc-var inner-state)
                          [(LowerAlloc.Alloc allocated var-id)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                (lower-state-emit-at-expr
                                  allocated
                                  (CompilerIrInstr.UnOp
                                    var-id
                                    (lower-unop op)
                                    value
                                    result-ty)
                                  origin)
                                (CompilerIrValue.Var var-id)
                                result-ty))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
          [(ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))]))]
    [(AstExpr.Binary op left-box right-box)
      ;; `and`/`or` short-circuit: desugar to a conditional branch so the right
      ;; operand is evaluated only when the left does not already decide the
      ;; result, matching the Rust lowerer in `src/lower.rs`:
      ;; `(and a b)` -> `(if a b false)`, `(or a b)` -> `(if a true b)`. Every
      ;; other binop evaluates both operands eagerly into an `CompilerIrInstr.BinOp`.
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (match op
          [(AstBinOp.And)
            (lower-if
              ctx
              state
              env
              type-env
              left
              right
              (AstExpr.Literal (AstLiteral.Bool false))
              expr-ty)]
          [(AstBinOp.Or)
            (lower-if
              ctx
              state
              env
              type-env
              left
              (AstExpr.Literal (AstLiteral.Bool true))
              right
              expr-ty)]
          [_
            (match (lower-binop-types-with-result
              ctx
              type-env
              op
              left
              right
              expr-ty)
              [(ResultTcBinOpTypes.Ok binop-types)
                (match binop-types
                  [(TcBinOpTypes left-ty right-ty result-ty)
                    (match (lower-expr-expected
                      ctx
                      state
                      env
                      type-env
                      left
                      left-ty
                      left)
                      [(ResultLowerExpr.Ok left-lowered)
                        (match left-lowered
                          [(LowerExpr.Expr left-state left-value _)
                            (match (lower-expr-expected
                              ctx
                              left-state
                              env
                              type-env
                              right
                              right-ty
                              right)
                              [(ResultLowerExpr.Ok right-lowered)
                                (match right-lowered
                                  [(LowerExpr.Expr right-state right-value _)
                                    (if (and
                                      (lower-binop-group-eq? op)
                                      (lower-type-register-group? ctx left-ty))
                                      (lower-group-equality
                                        ctx
                                        right-state
                                        op
                                        left-value
                                        right-value
                                        left-ty
                                        result-ty
                                        origin)
                                      (match (lower-state-alloc-var right-state)
                                        [(LowerAlloc.Alloc allocated var-id)
                                          (ResultLowerExpr.Ok
                                            (LowerExpr.Expr
                                              (lower-state-emit-at-expr
                                                allocated
                                                (CompilerIrInstr.BinOp
                                                  var-id
                                                  (lower-binop op)
                                                  left-value
                                                  right-value
                                                  (if (compiler-ir-binop-compare?
                                                    (lower-binop op))
                                                    left-ty
                                                    result-ty))
                                                origin)
                                              (CompilerIrValue.Var var-id)
                                              result-ty))]))])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])])]
                      [(ResultLowerExpr.Err message)
                        (ResultLowerExpr.Err message)])])]
              [(ResultTcBinOpTypes.Err message)
                (ResultLowerExpr.Err
                  (box (lower-diagnostic-at-expr origin message)))])]))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (lower-context-expr-get ctx func-box)]
        (lower-call ctx state env type-env func args expr-ty origin))]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (lower-lambda
              ctx
              state
              env
              type-env
              params
              maybe-ret
              body
              origin
              expr-ty))])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(ResultLowerEnv.Ok binding-state body-env body-type-env)
                (lower-expr-expected
                  ctx
                  binding-state
                  body-env
                  body-type-env
                  body
                  expr-ty
                  body)]
              [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))])]
    [(AstExpr.Begin exprs)
      (lower-begin-expected ctx state env type-env exprs expr-ty)]
    [(AstExpr.Unsafe exprs)
      (lower-begin-expected
        ctx
        state
        env
        (tc-enter-unsafe type-env)
        exprs
        expr-ty)]
    [(AstExpr.Set name value-box)
      (let
        [name-id : i64 name]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        [name-text : String (tc-env-key-name-text name)]
        (if (tc-dotted-local-field-name-id? type-env name)
          (match (tc-dotted-local-field-set-expr-id type-env name value-box)
            [(ResultTcExprId.Ok virtual-id)
              (lower-expr-with-type
                ctx
                state
                env
                type-env
                (lower-context-expr-get ctx virtual-id)
                origin
                expr-ty)]
            [(ResultTcExprId.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr origin message)))])
          (match (lower-lookup-type-id
            ctx
            (lower-state-type-cache state)
            env
            type-env
            name-id)
            [(ResultTcType.Ok store-ty)
              (let
                [target-ty : AstType
                  (tc-type-without-regions (tc-resolve-type ctx store-ty))]
                [target-ir-ty : AstType
                  (lower-one-word-register-storage-type ctx target-ty)]
                (match (lower-expr-expected
                  ctx
                  state
                  env
                  type-env
                  value
                  target-ty
                  value)
                  [(ResultLowerExpr.Ok lowered)
                    (match lowered
                      [(LowerExpr.Expr value-state value-ir _)
                        (let
                          [id : i64
                            (sym_i64_env.sym-i64-lookup-id-or
                              env
                              name-id
                              (compiler-symbols-missing-handle))]
                          (if (compiler-symbols-handle-found? id)
                            (let
                              [assign-state
                                : LowerState
                                ;; A rebound aggregate param may point at
                                ;; current-frame storage, so its var id no
                                ;; longer proves tail-call forwarding is safe.
                                (if (and
                                  (lower-state-tail-param-range-contains?
                                    value-state
                                    id)
                                  (lower-type-contains-inline-aggregate?
                                    ctx
                                    target-ty))
                                  (lower-state-clear-tail-param-range
                                    value-state)
                                  value-state)]
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr
                                  (lower-state-emit-at-expr
                                    assign-state
                                    (CompilerIrInstr.Mov
                                      id
                                      value-ir
                                      target-ir-ty)
                                    origin)
                                  CompilerIrValue.Unit
                                  expr-ty)))
                            (match (lower-return-abi-value
                              ctx
                              value-state
                              value-ir
                              target-ty)
                              [(ResultLowerExpr.Ok store-copy)
                                (match store-copy
                                  [(LowerExpr.Expr store-state store-ir _)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr
                                        (lower-state-emit-at-expr
                                          store-state
                                          (CompilerIrInstr.Store
                                            (lower-resolve-name-symbol-id
                                              store-state
                                              name-id)
                                            store-ir
                                            target-ir-ty)
                                          origin)
                                        CompilerIrValue.Unit
                                        expr-ty))])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
            [(ResultTcType.Err _)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    (string.append
                      "lower: assignment to unknown local "
                      name-text))))])))]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-if ctx state env type-env cond then-branch else-branch expr-ty))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [body : AstExpr (lower-context-expr-get ctx body-box)]
        (lower-while ctx state env type-env cond body))]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (lower-context-expr-get ctx start-box)]
            [end : AstExpr (lower-context-expr-get ctx end-box)]
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (lower-foreach
              ctx
              state
              env
              type-env
              index
              (tc-env-key-name-text index)
              index-ty
              start
              end
              body))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            op
            index
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : AstExpr (lower-context-expr-get ctx start-box)]
            [end : AstExpr (lower-context-expr-get ctx end-box)]
            [init : AstExpr (lower-context-expr-get ctx init-box)]
            [value : AstExpr (lower-context-expr-get ctx value-box)]
            (lower-spmd-reduce
              ctx
              state
              env
              type-env
              expr-ty
              op
              index
              (tc-env-key-name-text index)
              index-ty
              start
              end
              init
              value))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (lower-context-expr-get ctx start-box)]
            [end : AstExpr (lower-context-expr-get ctx end-box)]
            [init : AstExpr (lower-context-expr-get ctx init-box)]
            [value : AstExpr (lower-context-expr-get ctx value-box)]
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (lower-spmd-scan
              ctx
              state
              env
              type-env
              op
              index
              (tc-env-key-name-text index)
              index-ty
              start
              end
              prefix
              (tc-env-key-name-text prefix)
              prefix-ty
              init
              value
              body))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        [lane : AstExpr (lower-context-expr-get ctx lane-box)]
        (lower-spmd-broadcast ctx state env type-env value lane))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        [lane : AstExpr (lower-context-expr-get ctx lane-box)]
        (lower-spmd-shuffle ctx state env type-env value lane))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-match ctx state env type-env scrutinee arms expr-ty))])]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (lower-context-expr-get ctx str-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (lower-string-ref ctx state env type-env str index))]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        (lower-struct-get ctx state env type-env receiver field expr-ty))]
    [(AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (lower-struct-set ctx state env type-env receiver field value origin))]
    [(AstExpr.MakeArray elem-ty len-box)
      (let
        [len : AstExpr (lower-context-expr-get ctx len-box)]
        (lower-make-array ctx state env type-env elem-ty len origin))]
    [(AstExpr.Array values)
      (lower-array-literal ctx state env type-env values expr-ty origin)]
    [(AstExpr.DynArray values)
      (lower-dyn-array-literal ctx state env type-env values expr-ty origin)]
    [(AstExpr.ArrayRef arr-box index-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (lower-array-ref ctx state env type-env arr index))]
    [(AstExpr.ArraySet arr-box index-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (lower-array-set ctx state env type-env arr index value))]
    [(AstExpr.ArrayTake arr-box live-box index-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [live : AstExpr (lower-context-expr-get ctx live-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (lower-array-take ctx state env type-env arr live index expr-ty))]
    [(AstExpr.ArrayPush arr-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (lower-array-push ctx state env type-env arr value))]
    [(AstExpr.Tuple values)
      (lower-tuple ctx state env type-env values expr-ty origin)]
    [(AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : AstExpr (lower-context-expr-get ctx tuple-expr-box)]
        (lower-tuple-ref ctx state env type-env tuple-expr index expr-ty))]
    [(AstExpr.WithRegion _ body) (lower-with-arena ctx state env type-env body)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (lower-context-expr-get ctx scratch-box)]
        (lower-with-escape ctx state env type-env scratch body))]
    [(AstExpr.WithScratch body)
      (lower-with-scratch ctx state env type-env body)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (lower-context-expr-get ctx arena-box)]
        (lower-in-arena ctx state env type-env arena body))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (lower-with-resource ctx state env type-env bindings body)])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box ctx state env type-env inner expr-ty))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expr-ty))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expr-ty))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (lower-box-set ctx state env type-env inner value origin))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-try ctx state env type-env inner origin))]
    [(AstExpr.Return value-box)
      (let
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (lower-return-form ctx state env type-env value origin))]
    [(AstExpr.Break)
      (lower-loop-control-form ctx state env type-env origin "break")]
    [(AstExpr.Continue)
      (lower-loop-control-form ctx state env type-env origin "continue")]
    ;; `(comptime expr)` folds to a literal via the scalar CTFE evaluator.
    ;; Successful folds reuse the ordinary literal path; CTFE rejections (free
    ;; runtime vars and unsupported CTFE forms surface as lower errors.
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (compiler-ctfe-eval inner (tc-ctfe-env ctx) (ctfe-fuel-limit))
          [(ResultCtfe.Ok value _)
            (match value
              [(CompilerCtfeValue.Type ty)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      (string.append
                        "type value "
                        (string.append
                          (tc-type-render (tc-resolve-type ctx ty))
                          " is compile-time only")))))]
              [(CompilerCtfeValue.String _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "String value is compile-time only")))]
              [(CompilerCtfeValue.Name _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "String value is compile-time only")))]
              [(CompilerCtfeValue.Expr _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "Expr value is compile-time only")))]
              [(CompilerCtfeValue.ExprList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprList value is compile-time only")))]
              [(CompilerCtfeValue.ExprClause _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprClause value is compile-time only")))]
              [(CompilerCtfeValue.ExprClauseList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprClauseList value is compile-time only")))]
              [(CompilerCtfeValue.ExprBindingClause _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprBindingClause value is compile-time only")))]
              [(CompilerCtfeValue.ExprBindingClauseList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "ExprBindingClauseList value is compile-time only")))]
              [(CompilerCtfeValue.Pattern _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "Pattern value is compile-time only")))]
              [(CompilerCtfeValue.PatternList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "PatternList value is compile-time only")))]
              [(CompilerCtfeValue.MatchArm _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "MatchArm value is compile-time only")))]
              [(CompilerCtfeValue.MatchArmList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "MatchArmList value is compile-time only")))]
              [(CompilerCtfeValue.TypeInfo _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeInfo value is compile-time only")))]
              [(CompilerCtfeValue.TypeInfoBox _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeInfo box value is compile-time only")))]
              [(CompilerCtfeValue.TypeInfoList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeInfoList value is compile-time only")))]
              [(CompilerCtfeValue.TypeField _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeField value is compile-time only")))]
              [(CompilerCtfeValue.TypeFieldList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeFieldList value is compile-time only")))]
              [(CompilerCtfeValue.TypeVariantPayload _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariantPayload value is compile-time only")))]
              [(CompilerCtfeValue.TypeVariantPayloadList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariantPayloadList value is compile-time only")))]
              [(CompilerCtfeValue.TypeVariant _ _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariant value is compile-time only")))]
              [(CompilerCtfeValue.TypeVariantList _)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      "TypeVariantList value is compile-time only")))]
              [_
                (lower-materialize
                  state
                  (lower-literal-value-with-type
                    (ctfe-value-to-literal-for-type value expr-ty)
                    expr-ty)
                  expr-ty)])]
          [(ResultCtfe.Err diag) (ResultLowerExpr.Err diag)]))]
    [(AstExpr.Quote _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr origin "Expr value is compile-time only")))]
    [(AstExpr.Quasiquote _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr origin "Expr value is compile-time only")))]
    [(AstExpr.Unquote _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "unquote is only valid inside quasiquote")))]
    [(AstExpr.UnquoteSplicing _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "unquote-splicing is only valid inside quasiquote")))]
    [(AstExpr.TypeLiteral ty)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (string.append
              "type value "
              (string.append
                (tc-type-render (tc-resolve-type ctx ty))
                " is compile-time only")))))]
    ;; `(ptr-null : T)` is a pointer-sized zero (pointer ABI size is 8);
    ;; `(ptr-null? p)` is `p == 0` producing a `bool`. No new IR/asm needed.
    [(AstExpr.PtrNull _)
      (match (lower-materialize state (CompilerIrValue.I64 0) (AstType.U64))
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr null-state null-value _)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr null-state null-value expr-ty))])]
        [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)])]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-expr ctx state env type-env inner)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr inner-state inner-value _)
                (ResultLowerExpr.Ok
                  (lower-emit-binop
                    inner-state
                    CompilerIrBinOp.Eq
                    inner-value
                    (CompilerIrValue.I64 0)
                    (AstType.Bool)))])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(AstExpr.PtrAddrOf place-box)
      (let
        [place : AstExpr (lower-context-expr-get ctx place-box)]
        (match (tc-ptr-addr-of-place ctx type-env place)
          [(ResultTcType.Ok _)
            (match (match (ast-expr-unspan place)
              [(AstExpr.Var name)
                (lower-ptr-addr-of-local-address
                  ctx
                  state
                  env
                  type-env
                  name
                  origin)]
              [_
                (lower-mutable-place-address
                  ctx
                  state
                  env
                  type-env
                  place
                  origin)])
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr addr-state addr-value _)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr addr-state addr-value expr-ty))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [(ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))]))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (lower-context-expr-get ctx ptr-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr ptr-state ptr-value _)
                (lower-array-elem-ref-result ctx ptr-state ptr-value expr-ty)])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (lower-context-expr-get ctx ptr-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok ptr-lowered)
            (match ptr-lowered
              [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
                ;; Preserve left-to-right evaluation: the value expression may
                ;; lower to calls or other effects, so keep the pointer in its own
                ;; raw pointer temp before lowering the value.
                (match (lower-state-alloc-var ptr-state)
                  [(LowerAlloc.Alloc ptr-allocated ptr-var)
                    (let
                      [ptr-home-state : LowerState
                        (lower-state-emit
                          ptr-allocated
                          (CompilerIrInstr.Mov
                            ptr-var
                            ptr-value
                            (lower-raw-pointer-ir-type ptr-ty)))]
                      (match (tc-mut-pointer-elem
                        (tc-resolve-type ctx ptr-ty)
                        "lower: ptr-write! requires MutPtr pointer operand")
                        [(ResultTcType.Ok elem-ty)
                          (match (lower-expr-expected
                            ctx
                            ptr-home-state
                            env
                            type-env
                            value
                            (tc-type-without-regions elem-ty)
                            value)
                            [(ResultLowerExpr.Ok value-lowered)
                              (match value-lowered
                                [(LowerExpr.Expr value-state value-ir value-ty)
                                  (ResultLowerExpr.Ok
                                    (LowerExpr.Expr
                                      (lower-state-emit-at-expr
                                        value-state
                                        (CompilerIrInstr.StorePtr
                                          (CompilerIrValue.Var ptr-var)
                                          value-ir
                                          value-ty)
                                        origin)
                                      CompilerIrValue.Unit
                                      expr-ty))])]
                            [(ResultLowerExpr.Err diag)
                              (ResultLowerExpr.Err diag)])]
                        [(ResultTcType.Err message)
                          (ResultLowerExpr.Err
                            (box (lower-diagnostic-at-expr origin message)))]))])])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (lower-context-expr-get ctx ptr-box)]
        [offset : AstExpr (lower-context-expr-get ctx offset-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok ptr-lowered)
            (match ptr-lowered
              [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
                (match (lower-expr-expected
                  ctx
                  ptr-state
                  env
                  type-env
                  offset
                  (AstType.I64)
                  offset)
                  [(ResultLowerExpr.Ok offset-lowered)
                    (match offset-lowered
                      [(LowerExpr.Expr offset-state offset-value _)
                        (match (tc-type-strip-region
                          (tc-resolve-type ctx ptr-ty))
                          [(AstType.Ptr elem-ty)
                            (match (lower-emit-elem-addr-gep
                              ctx
                              offset-state
                              ptr-value
                              offset-value
                              (tc-context-type-get ctx elem-ty))
                              [(LowerExpr.Expr gep-state gep-value _)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr gep-state gep-value expr-ty))])]
                          [(AstType.MutPtr elem-ty)
                            (match (lower-emit-elem-addr-gep
                              ctx
                              offset-state
                              ptr-value
                              offset-value
                              (tc-context-type-get ctx elem-ty))
                              [(LowerExpr.Expr gep-state gep-value _)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr gep-state gep-value expr-ty))])]
                          [_
                            (ResultLowerExpr.Err
                              (box
                                (lower-diagnostic-at-expr
                                  origin
                                  "lower: ptr-offset requires raw pointer")))])])]
                  [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)])])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (lower-context-expr-get ctx ptr-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
                (ResultLowerExpr.Ok
                  (lower-cast-value ptr-state ptr-value ptr-ty expr-ty))])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (lower-context-expr-get ctx ptr-box)]
        (match (lower-expr ctx state env type-env ptr)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
                (ResultLowerExpr.Ok
                  (lower-cast-value ptr-state ptr-value ptr-ty expr-ty))])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (match (lower-expr ctx state env type-env value)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr value-state value-ir value-ty)
                (ResultLowerExpr.Ok
                  (lower-cast-value value-state value-ir value-ty expr-ty))])]
          [(ResultLowerExpr.Err diag) (ResultLowerExpr.Err diag)]))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (lower-context-expr-get ctx str-box)]
        (lower-string-data ctx state env type-env str expr-ty))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (lower-context-expr-get ctx ptr-box)]
        [len : AstExpr (lower-context-expr-get ctx len-box)]
        (lower-string-from-bytes ctx state env type-env ptr len))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (lower-context-expr-get ctx array-box)]
        (lower-array-data ctx state env type-env array expr-ty))]
    [(AstExpr.ProgramArgc) (lower-entry-load state 0 expr-ty)]
    [(AstExpr.ProgramArgv) (lower-entry-load state 1 expr-ty)]
    [(AstExpr.ProgramEnvp) (lower-entry-load state 2 expr-ty)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 0))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 1))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 2))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (lower-context-expr-get ctx leaf-box)]
        [subleaf : AstExpr (lower-context-expr-get ctx subleaf-box)]
        (lower-cpuid-like ctx state env type-env leaf subleaf 3))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (lower-xgetbv ctx state env type-env index))]
    [(AstExpr.Syscall args) (lower-syscall ctx state env type-env args)]
    [_
      (ResultLowerExpr.Err
        (box (lower-diagnostic-at-expr origin "lower: unsupported expression")))]))

(define (lower-expr-with-type-and-coerce
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [origin : AstExpr]
  [expr-ty : AstType]
  [expected-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-with-type ctx state env type-env expr origin expr-ty)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr next-state value actual-ty)
          (ResultLowerExpr.Ok
            (lower-coerce-value next-state value actual-ty expected-ty))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-expr-and-coerce
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [expected-ty : AstType]) : ResultLowerExpr
  (match (tc-expr-with-expected-or-actual ctx type-env expr expected-ty)
    [(ResultTcType.Ok actual-ty)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        expr
        (tc-type-without-regions (tc-resolve-type ctx actual-ty))
        expected-ty)]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-expr-expected
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [expected-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-expected ctx state env type-env inner expected-ty origin))]
    [(AstExpr.Literal lit)
      (lower-materialize-at-expr
        state
        (lower-literal-value-with-type lit expected-ty)
        expected-ty
        origin)]
    [(AstExpr.Unary _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Binary _ _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Let _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Begin _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Unsafe _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Array _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.DynArray _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Tuple _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-if
          ctx
          state
          env
          type-env
          cond
          then-branch
          else-branch
          expected-ty))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-match ctx state env type-env scrutinee arms expected-ty))])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box ctx state env type-env inner expected-ty))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expected-ty))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-box-get ctx state env type-env inner expected-ty))]
    [(AstExpr.Borrow _ _ _)
      (lower-expr-with-type-and-coerce
        ctx
        state
        env
        type-env
        expr
        origin
        expected-ty
        expected-ty)]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.No)
          (lower-init-expr
            ctx
            state
            env
            type-env
            expected-ty
            origin
            expected-ty)]
        [(AstMaybeType.Some _)
          (lower-expr-and-coerce ctx state env type-env expr expected-ty)])]
    [(AstExpr.Call func-box _)
      (let
        [func : AstExpr (lower-context-expr-get ctx func-box)]
        [expected-resolved : AstType
          (tc-type-without-regions (tc-resolve-type ctx expected-ty))]
        (if (match (tc-type-strip-region expected-resolved)
          [(AstType.Enum _) true]
          [(AstType.EnumArgs _ _) true]
          [_ false])
          (lower-expr-with-type-and-coerce
            ctx
            state
            env
            type-env
            expr
            origin
            expected-resolved
            expected-ty)
          (match (ast-expr-unspan func)
            [(AstExpr.Var name)
              (match (lower-lookup-type-id
                ctx
                (lower-state-type-cache state)
                env
                type-env
                name)
                [(ResultTcType.Ok fn-ty)
                  (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
                    [(AstType.Func _ ret-ty)
                      (let
                        [actual-ty : AstType
                          (tc-type-without-regions
                            (tc-resolve-type
                              ctx
                              (tc-context-type-get ctx ret-ty)))]
                        (if (tc-type-eq actual-ty expected-resolved)
                          (lower-expr-with-type-and-coerce
                            ctx
                            state
                            env
                            type-env
                            expr
                            origin
                            actual-ty
                            expected-ty)
                          (lower-expr-and-coerce
                            ctx
                            state
                            env
                            type-env
                            expr
                            expected-ty)))]
                    [_
                      (lower-expr-and-coerce
                        ctx
                        state
                        env
                        type-env
                        expr
                        expected-ty)])]
                [(ResultTcType.Err _)
                  (lower-expr-and-coerce
                    ctx
                    state
                    env
                    type-env
                    expr
                    expected-ty)])]
            [_ (lower-expr-and-coerce ctx state env type-env expr expected-ty)])))]
    [_ (lower-expr-and-coerce ctx state env type-env expr expected-ty)]))

(define (lower-struct-get-named
  [ctx : TcContext]
  [state : LowerState]
  [receiver-value : CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field-id : i64]
  [field : String]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-struct-field-info-for-mode
    ctx
    (lower-state-mode state)
    struct-id
    struct-name
    field-id
    field)
    [(ResultLowerFieldInfo.Ok info)
      (match info
        [(LowerFieldInfo.Info offset field-ty)
          ;; When the receiver is a register-resident struct, its value is
          ;; the packed word itself; extract the field with shift/mask instead of
          ;; computing an address and loading from memory.
          (if (tc-name-register-resident-id? ctx struct-id)
            (if (lower-type-register-group? ctx (AstType.Struct struct-id))
              ;; 2-word register-group receiver: select the field's word with
              ;; CompilerIrInstr.Word, then shift/mask within that word at its relative
              ;; offset.
              (match (lower-emit-word
                state
                receiver-value
                (/ offset 8)
                (lower-register-word-type
                  ctx
                  (AstType.Struct struct-id)
                  (/ offset 8)))
                [(LowerExpr.Expr w-state w-value _)
                  (match (lower-extract-word-field
                    ctx
                    w-state
                    w-value
                    (lower-register-word-type
                      ctx
                      (AstType.Struct struct-id)
                      (/ offset 8))
                    (- offset (* (/ offset 8) 8))
                    field-ty)
                    [(LowerExpr.Expr ext-state ext-value _)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr ext-state ext-value result-ty))])])
              (match (lower-extract-word-field
                ctx
                state
                receiver-value
                (lower-register-word-type ctx (AstType.Struct struct-id) 0)
                offset
                field-ty)
                [(LowerExpr.Expr ext-state ext-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr ext-state ext-value result-ty))]))
            (match (lower-gep-byte state receiver-value offset)
              [(LowerExpr.Expr ptr-state ptr _)
                ;; A register-resident field is carried as a packed word,
                ;; so its value is the LOADED word, never the field address --
                ;; exclude it from the in-place pointer-return shape (otherwise a
                ;; later `match`/`=` would read the address as if it were the tag).
                ;; A genuine memory aggregate field still returns its in-place
                ;; pointer. This mirrors `lower-load-inline-value-at-offset`.
                (cond
                  [(and
                      (not (lower-type-register-resident? ctx field-ty))
                      (or
                        (and
                          (lower-struct-repr-c-id? ctx struct-id)
                          (lower-repr-c-inline-field? ctx field-ty))
                        (and
                          (lower-mode-inline-aggregates?
                            (lower-state-mode ptr-state))
                          (lower-type-inline-storage? ctx field-ty))))
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr ptr-state ptr result-ty))]
                  [(lower-type-register-group? ctx field-ty)
                    (match (lower-load-group-from-ptr
                      ctx
                      ptr-state
                      ptr
                      field-ty)
                      [(LowerExpr.Expr g-state g-value _)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr g-state g-value result-ty))])]
                  [(lower-type-register-resident? ctx field-ty)
                    (match (lower-state-alloc-var ptr-state)
                      [(LowerAlloc.Alloc allocated var-id)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-state-emit
                              allocated
                              (CompilerIrInstr.Load
                                var-id
                                ptr
                                (lower-register-word-type ctx field-ty 0)))
                            (CompilerIrValue.Var var-id)
                            result-ty))])]
                  [else
                    (match (lower-state-alloc-var ptr-state)
                      [(LowerAlloc.Alloc allocated var-id)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-state-emit
                              allocated
                              (CompilerIrInstr.Load var-id ptr field-ty))
                            (CompilerIrValue.Var var-id)
                            result-ty))])])]))])]
    [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)]))

(define (lower-struct-get-through-reference
  [ctx : TcContext]
  [state : LowerState]
  [receiver-value : CompilerIrValue]
  [referent-ty : AstType]
  [struct-id : i64]
  [struct-name : String]
  [field-id : i64]
  [field : String]
  [result-ty : AstType]) : ResultLowerExpr
  (match (if (lower-type-register-resident? ctx referent-ty)
    (lower-load-register-resident-from-ptr ctx state receiver-value referent-ty)
    (LowerExpr.Expr state receiver-value referent-ty))
    [(LowerExpr.Expr value-state value _)
      (lower-struct-get-named
        ctx
        value-state
        value
        struct-id
        struct-name
        field-id
        field
        result-ty)]))

(define (lower-struct-get
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [receiver : AstExpr]
  [field : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (let
    [field-name : String (tc-env-key-name-text field)]
    (match (lower-expr ctx state env type-env receiver)
      [(ResultLowerExpr.Ok lowered)
        (match lowered
          [(LowerExpr.Expr receiver-state receiver-value receiver-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
              [(AstType.Struct struct-name)
                (lower-struct-get-named
                  ctx
                  receiver-state
                  receiver-value
                  struct-name
                  (tc-nominal-name-id-display struct-name)
                  field
                  field-name
                  result-ty)]
              [(AstType.StructArgs struct-name _)
                (lower-struct-get-named
                  ctx
                  receiver-state
                  receiver-value
                  struct-name
                  (tc-nominal-name-id-display struct-name)
                  field
                  field-name
                  result-ty)]
              [(AstType.Ref _ referent-ty)
                (match (tc-type-strip-region
                  (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
                  [(AstType.Struct struct-name)
                    (lower-struct-get-through-reference
                      ctx
                      receiver-state
                      receiver-value
                      (tc-context-type-get ctx referent-ty)
                      struct-name
                      (tc-nominal-name-id-display struct-name)
                      field
                      field-name
                      result-ty)]
                  [(AstType.StructArgs struct-name _)
                    (lower-struct-get-through-reference
                      ctx
                      receiver-state
                      receiver-value
                      (tc-context-type-get ctx referent-ty)
                      struct-name
                      (tc-nominal-name-id-display struct-name)
                      field
                      field-name
                      result-ty)]
                  [_
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          receiver
                          "lower: struct-get requires struct")))])]
              [(AstType.MutRef _ referent-ty)
                (match (tc-type-strip-region
                  (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
                  [(AstType.Struct struct-name)
                    (lower-struct-get-through-reference
                      ctx
                      receiver-state
                      receiver-value
                      (tc-context-type-get ctx referent-ty)
                      struct-name
                      (tc-nominal-name-id-display struct-name)
                      field
                      field-name
                      result-ty)]
                  [(AstType.StructArgs struct-name _)
                    (lower-struct-get-through-reference
                      ctx
                      receiver-state
                      receiver-value
                      (tc-context-type-get ctx referent-ty)
                      struct-name
                      (tc-nominal-name-id-display struct-name)
                      field
                      field-name
                      result-ty)]
                  [_
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          receiver
                          "lower: struct-get requires struct")))])]
              [_
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      receiver
                      "lower: struct-get requires struct")))])])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

;; Lower `(box expr)`: evaluate `expr`, reserve arena storage sized for
;; its (pointer-shaped) value via `tl_alloc`, store the value at offset 0, and
;; return the box handle (the storage pointer) typed as the `(Box T)` result.
(define (lower-box
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (tc-box-set-inner-type ctx result-ty)
    [(ResultTcType.Ok expected-inner-ty)
      (match (lower-expr-expected
        ctx
        state
        env
        type-env
        inner
        (tc-type-without-regions expected-inner-ty)
        inner)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr inner-state inner-value inner-ty)
              (match (lower-reserve-heap-storage
                inner-state
                (lower-type-size ctx inner-ty)
                result-ty)
                [(LowerExpr.Expr base-state base _)
                  ;; A register-resident inner value is a word; store it
                  ;; scalar into the box rather than byte-copying from a pointer.
                  (if (and
                    (lower-type-inline-storage? ctx inner-ty)
                    (not (lower-type-register-resident? ctx inner-ty)))
                    (match (lower-inline-aggregate-copy-size ctx inner-ty)
                      [(ResultLowerSize.Ok size)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-copy-bytes
                              base-state
                              base
                              0
                              inner-value
                              0
                              size)
                            base
                            result-ty))]
                      [(ResultLowerSize.Err message)
                        (ResultLowerExpr.Err (box (lower-diagnostic message)))])
                    (if (lower-type-register-group? ctx inner-ty)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-store-group-at-ptr
                            ctx
                            base-state
                            base
                            inner-value
                            inner-ty)
                          base
                          result-ty))
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-store-at-offset
                            base-state
                            base
                            0
                            inner-value
                            inner-ty)
                          base
                          result-ty))))])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr inner message)))]))

;; Lower `(box-get b)`: evaluate the box handle and load the boxed value
;; of type `T` (the result type) from offset 0 of the box storage.
(define (lower-box-get
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [inner : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    state
    env
    type-env
    inner
    (ast-ty-box result-ty)
    inner)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr box-state box-value _)
          ;; When the boxed value is an inline aggregate, the box pointer
          ;; already addresses the T storage, so box-get yields that pointer
          ;; (offset 0) rather than scalar-loading the first 8 bytes (which would
          ;; read only the leading word, e.g. an enum tag, and treat it as the
          ;; whole value). Scalars still load. Mirrors lower-struct-get.
          (ResultLowerExpr.Ok
            (lower-load-inline-value-at-offset
              ctx
              box-state
              box-value
              0
              result-ty
              (lower-state-mode box-state)))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-box-storage-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [box-expr : AstExpr]
  [origin : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    box-expr)
    [(ResultTcType.Ok box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstType.Box _)
          (match (lower-expr ctx state env type-env box-expr)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr box-state box-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr box-state box-value result-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
        [(AstType.Ref _ _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: box-get requires Box storage")))]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: box-get requires Box type")))])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr box-expr message)))]))

;; Locate the byte offset and resolved type of tuple element `target` within the
;; element-type list, laying fields out exactly like a struct over those types
;; (each field aligned to its own alignment). Mirrors `lower-field-info-from-list`
;; but indexes by position rather than name.
(define (lower-tuple-elem-info
  [ctx : TcContext]
  [types : AstTypeList]
  [target : i64]
  [index : i64]
  [cursor : i64]) : ResultLowerFieldInfo
  (if (>= index (ast-type-list-len (& types)))
    (ResultLowerFieldInfo.Err
      (box (lower-diagnostic "lower: tuple-ref index out of range")))
    (let
      [ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get (& types) index (ast-type-id-fallback)))]
      [resolved : AstType (tc-resolve-type ctx ty)]
      [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
      (if (= index target)
        (ResultLowerFieldInfo.Ok (LowerFieldInfo.Info offset resolved))
        (lower-tuple-elem-info
          ctx
          types
          target
          (+ index 1)
          (+ offset (lower-type-size ctx resolved)))))))

;; Evaluate each tuple element (preserving side effects even for zero-sized
;; elements) and store the sized ones into the aggregate at their field offset,
;; threading the lowering state. Mirrors the per-field store loop of `lower-box`
;; generalized over the element-type list.
(define (lower-tuple-store-elems
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [values : AstExprList]
  [types : AstTypeList]
  [cursor : i64]) : ResultLowerState
  (lower-tuple-store-elems-at
    ctx
    state
    env
    type-env
    base
    (& values)
    (& types)
    0
    cursor))

(define (lower-tuple-store-elems-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [values : (& values AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]
  [cursor : i64]) : ResultLowerState
  (if (>= index (struct-get values len))
    (ResultLowerState.Ok state)
    (if (>= index (ast-type-list-len types))
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: tuple arity mismatch")))
      (let
        [value : AstExpr
          (lower-context-expr-get ctx (ast-expr-list-get values index 0))]
        [ty : AstType
          (tc-context-type-get
            ctx
            (ast-type-list-get types index (ast-type-id-fallback)))]
        [resolved : AstType (tc-resolve-type ctx ty)]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        [size : i64 (lower-type-size ctx resolved)]
        (match (lower-expr-expected ctx state env type-env value resolved value)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr elem-state elem-value _)
                (lower-tuple-store-elems-at
                  ctx
                  (if (> size 0)
                    (lower-store-inline-value-at-offset
                      ctx
                      elem-state
                      base
                      offset
                      elem-value
                      resolved
                      size)
                    elem-state)
                  env
                  type-env
                  base
                  values
                  types
                  (+ index 1)
                  (+ offset size))])]
          [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])))))

;; Lower `(tuple v0 v1 ...)`: reserve struct-shaped aggregate storage for the
;; element types, store each element at its field offset, and return the storage
;; pointer typed as the tuple. The tuple value is pointer-shaped (size 8), like a
;; struct/box handle. Mirrors `src/lower.rs` `lower_tuple`.
(define (lower-tuple
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [values : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-resolve-type ctx result-ty)
    [(AstType.Tuple elem-tys)
      (match (lower-reserve-heap-storage
        state
        (lower-type-list-storage-size ctx (box-get elem-tys))
        result-ty)
        [(LowerExpr.Expr base-state base _)
          (match (lower-tuple-store-elems
            ctx
            base-state
            env
            type-env
            base
            values
            (box-get elem-tys)
            0)
            [(ResultLowerState.Ok final-state)
              (ResultLowerExpr.Ok (LowerExpr.Expr final-state base result-ty))]
            [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])])]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr origin "lower: tuple requires tuple type")))]))

;; Evaluate each fixed-array-literal element (preserving side effects even for
;; zero-sized elements) and store the sized ones at `index * elem-size` into the
;; reserved inline storage, threading the lowering state. Mirrors
;; `lower-tuple-store-elems`, specialized to a single homogeneous element type.
(define (lower-array-literal-store-elems
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [values : AstExprList]
  [elem-ty : AstType]
  [elem-size : i64]
  [offset : i64]) : ResultLowerState
  (lower-array-literal-store-elems-at
    ctx
    state
    env
    type-env
    base
    (& values)
    0
    elem-ty
    elem-size
    offset))

(define (lower-array-literal-store-elems-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [values : (& values AstExprList)]
  [value-index : i64]
  [elem-ty : AstType]
  [elem-size : i64]
  [offset : i64]) : ResultLowerState
  (if (>= value-index (struct-get values len))
    (ResultLowerState.Ok state)
    (let
      [value : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get values value-index 0))]
      (if (> elem-size 0)
        (match (lower-direct-store-rhs-at-offset
          ctx
          state
          env
          type-env
          base
          offset
          value
          elem-ty
          value)
          [(LowerMaybeDirectStore.Store elem-state)
            (lower-array-literal-store-elems-at
              ctx
              elem-state
              env
              type-env
              base
              values
              (+ value-index 1)
              elem-ty
              elem-size
              (+ offset elem-size))]
          [(LowerMaybeDirectStore.Err message) (ResultLowerState.Err message)]
          [(LowerMaybeDirectStore.No)
            (match (lower-expr-expected
              ctx
              state
              env
              type-env
              value
              elem-ty
              value)
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr elem-state elem-value _)
                    (lower-array-literal-store-elems-at
                      ctx
                      (lower-store-inline-value-at-offset
                        ctx
                        elem-state
                        base
                        offset
                        elem-value
                        elem-ty
                        elem-size)
                      env
                      type-env
                      base
                      values
                      (+ value-index 1)
                      elem-ty
                      elem-size
                      (+ offset elem-size))])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])
        (match (lower-expr-expected ctx state env type-env value elem-ty value)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr elem-state _ _)
                (lower-array-literal-store-elems-at
                  ctx
                  elem-state
                  env
                  type-env
                  base
                  values
                  (+ value-index 1)
                  elem-ty
                  elem-size
                  (+ offset elem-size))])]
          [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])))))

;; Lower `(array v0 v1 ...)`: reserve inline storage for `count` elements of the
;; element type, store each element at `index * elem-size`, and return the
;; storage pointer typed as the fixed array. A fixed-array value is pointer-
;; shaped (a pointer to inline storage), matching `array-ref`/`array-set!`, which
;; index off the same base. Mirrors `src/lower.rs` `lower_array_literal`.
(define (lower-array-literal
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [values : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-resolve-type ctx result-ty)
    [(AstType.Array elem-ty count)
      (let
        [resolved-elem : AstType
          (tc-resolve-type ctx (tc-context-type-get ctx elem-ty))]
        [elem-size : i64
          (lower-type-size ctx (tc-context-type-get ctx elem-ty))]
        [storage-size : i64 (lower-type-size ctx result-ty)]
        (match (lower-reserve-inline-storage state storage-size result-ty)
          [(LowerExpr.Expr base-state base _)
            (match (lower-array-literal-store-elems
              ctx
              base-state
              env
              type-env
              base
              values
              resolved-elem
              elem-size
              0)
              [(ResultLowerState.Ok final-state)
                (ResultLowerExpr.Ok (LowerExpr.Expr final-state base result-ty))]
              [(ResultLowerState.Err message) (ResultLowerExpr.Err message)])]))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: array literal requires fixed-array type")))]))

(define (lower-dyn-array-literal-store-elems-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [values : (& values AstExprList)]
  [value-index : i64]
  [elem-ty : AstType]
  [elem-size : i64]) : ResultLowerState
  (if (>= value-index (struct-get values len))
    (ResultLowerState.Ok state)
    (let
      [value : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get values value-index 0))]
      (if (> elem-size 0)
        (match (lower-emit-elem-addr-gep
          ctx
          state
          buf-value
          (CompilerIrValue.I64 value-index)
          elem-ty)
          [(LowerExpr.Expr addr-state elem-ptr _)
            (match (lower-direct-store-rhs-into
              ctx
              addr-state
              env
              type-env
              elem-ptr
              value
              elem-ty
              value)
              [(LowerMaybeDirectStore.Store elem-state)
                (lower-dyn-array-literal-store-elems-at
                  ctx
                  elem-state
                  env
                  type-env
                  buf-value
                  values
                  (+ value-index 1)
                  elem-ty
                  elem-size)]
              [(LowerMaybeDirectStore.Err message)
                (ResultLowerState.Err message)]
              [(LowerMaybeDirectStore.No)
                (match (lower-expr-expected
                  ctx
                  addr-state
                  env
                  type-env
                  value
                  elem-ty
                  value)
                  [(ResultLowerExpr.Ok lowered)
                    (match lowered
                      [(LowerExpr.Expr elem-state elem-value _)
                        (lower-dyn-array-literal-store-elems-at
                          ctx
                          (lower-array-elem-store-state
                            ctx
                            elem-state
                            elem-ptr
                            elem-value
                            elem-ty)
                          env
                          type-env
                          buf-value
                          values
                          (+ value-index 1)
                          elem-ty
                          elem-size)])]
                  [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])])])
        (match (lower-expr-expected ctx state env type-env value elem-ty value)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr elem-state _ _)
                (lower-dyn-array-literal-store-elems-at
                  ctx
                  elem-state
                  env
                  type-env
                  buf-value
                  values
                  (+ value-index 1)
                  elem-ty
                  elem-size)])]
          [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])))))

(define (lower-dyn-array-literal-store-elems
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [values : AstExprList]
  [elem-ty : AstType]
  [elem-size : i64]) : ResultLowerState
  (lower-dyn-array-literal-store-elems-at
    ctx
    state
    env
    type-env
    buf-value
    (& values)
    0
    elem-ty
    elem-size))

(define (lower-dyn-array-literal
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [values : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-type-strip-region (tc-resolve-type ctx result-ty))
    [(AstType.DynArray elem-ty)
      (let
        [resolved-elem : AstType
          (tc-resolve-type ctx (tc-context-type-get ctx elem-ty))]
        [elem-size : i64 (lower-type-size ctx resolved-elem)]
        [count : i64 (tc-expr-list-len values)]
        [byte-count : CompilerIrValue (CompilerIrValue.I64 (* count elem-size))]
        [arr-ty : AstType (ast-ty-dyn-array resolved-elem)]
        (match (lower-state-alloc-var state)
          [(LowerAlloc.Alloc buf-alloc buf-var)
            (let
              [alloc-state : LowerState
                (lower-state-emit
                  buf-alloc
                  (CompilerIrInstr.Call
                    buf-var
                    (lower-tl-alloc-symbol)
                    (CompilerIrCallArgs.One byte-count)
                    (AstType.U64)))]
              (match (lower-dyn-array-literal-store-elems
                ctx
                alloc-state
                env
                type-env
                (CompilerIrValue.Var buf-var)
                values
                resolved-elem
                elem-size)
                [(ResultLowerState.Ok final-state)
                  (lower-make-array-store-fat
                    final-state
                    arr-ty
                    buf-var
                    (CompilerIrValue.I64 count))]
                [(ResultLowerState.Err message) (ResultLowerExpr.Err message)]))]))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: dynamic array literal requires dynamic-array type")))]))

;; Lower `(tuple-ref t i)`: evaluate the tuple, compute element `i`'s offset, and
;; load it (returning the unit value for a zero-sized element, which was never
;; stored). Mirrors `src/lower.rs` `lower_tuple_ref`.
(define (lower-tuple-ref
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [tuple-expr : AstExpr]
  [index : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env tuple-expr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr tuple-state tuple-value tuple-ty)
          (match (tc-resolve-type ctx tuple-ty)
            [(AstType.Tuple elem-tys)
              (match (lower-tuple-elem-info ctx (box-get elem-tys) index 0 0)
                [(ResultLowerFieldInfo.Ok info)
                  (match info
                    [(LowerFieldInfo.Info offset elem-ty)
                      (if (> (lower-type-size ctx elem-ty) 0)
                        (match (lower-load-inline-value-at-offset
                          ctx
                          tuple-state
                          tuple-value
                          offset
                          elem-ty
                          (lower-state-mode tuple-state))
                          [(LowerExpr.Expr load-state load-value _)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr load-state load-value result-ty))])
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            tuple-state
                            CompilerIrValue.Unit
                            result-ty)))])]
                [(ResultLowerFieldInfo.Err message)
                  (ResultLowerExpr.Err message)])]
            [_
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    tuple-expr
                    "lower: tuple-ref requires tuple")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-string-ref-byte
  [state : LowerState]
  [data-ptr : CompilerIrValue]
  [index-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc gep-alloc gep-var)
      (let
        [gep-state : LowerState
          (lower-state-emit
            gep-alloc
            (CompilerIrInstr.Gep gep-var data-ptr index-value (AstType.Char)))]
        (match (lower-state-alloc-var gep-state)
          [(LowerAlloc.Alloc load-alloc load-var)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-state-emit
                  load-alloc
                  (CompilerIrInstr.Load
                    load-var
                    (CompilerIrValue.Var gep-var)
                    (AstType.Char)))
                (CompilerIrValue.Var load-var)
                (AstType.Char)))]))]))

(define (lower-string-ref-load
  [state : LowerState]
  [str-value : CompilerIrValue]
  [index-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-string-fields state str-value)
    [(LowerStringFields.Fields fields-state data-ptr str-len)
      (match (lower-cast-value
        fields-state
        index-value
        (AstType.I64)
        (AstType.U64))
        [(LowerExpr.Expr index-u-state index-u _)
          (match (lower-cast-value
            index-u-state
            str-len
            (AstType.I64)
            (AstType.U64))
            [(LowerExpr.Expr len-u-state len-u _)
              (match (lower-state-fresh-label len-u-state "str_bounds_ok")
                [(LowerLabel.Label bounds-ok-state bounds-ok-label)
                  (lower-string-ref-byte
                    (lower-state-emit
                      bounds-ok-state
                      (CompilerIrInstr.BoundsCheck
                        index-u
                        len-u
                        bounds-ok-label))
                    data-ptr
                    index-value)])])])]))

(define (lower-string-ref
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [str : AstExpr]
  [index : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env str)
    [(ResultLowerExpr.Ok lowered-str)
      (match lowered-str
        [(LowerExpr.Expr str-state str-value str-ty)
          (if (lower-string-handle-type? ctx str-ty)
            (match (lower-integer-expr-with-expected-or-actual
              ctx
              str-state
              env
              type-env
              index
              (AstType.I64)
              "lower: string index must be integer")
              [(ResultLowerExpr.Ok lowered-index)
                (match lowered-index
                  [(LowerExpr.Expr index-state index-raw index-ty)
                    (match (lower-cast-value
                      index-state
                      index-raw
                      index-ty
                      (AstType.I64))
                      [(LowerExpr.Expr index-i-state index-value _)
                        (lower-string-ref-load
                          index-i-state
                          str-value
                          index-value)])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  str
                  "lower: string-ref requires String"))))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-substring-call-runtime
  [state : LowerState]
  [src-ptr : CompilerIrValue]
  [start-value : CompilerIrValue]
  [len-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-tl-substring-symbol)
              (compiler-ir-call-args-from-list
                (compiler-ir-value-cons
                  src-ptr
                  (compiler-ir-value-cons
                    start-value
                    (compiler-ir-value-cons len-value CompilerIrValueList.Nil))))
              (AstType.String)))
          (CompilerIrValue.Var var-id)
          (AstType.String)))]))

(define (lower-substring-finish-after-len-check
  [state : LowerState]
  [src-ptr : CompilerIrValue]
  [start-value : CompilerIrValue]
  [len-value : CompilerIrValue]
  [len-ok-var : i64]
  [fail-label : String]
  [copy-label : String]) : ResultLowerExpr
  (let
    [fail-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          state
          (CompilerIrInstr.Branch
            (CompilerIrValue.Var len-ok-var)
            copy-label
            fail-label))
        fail-label)]
    [copy-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (CompilerIrInstr.Jump copy-label))
        copy-label)]
    (lower-substring-call-runtime copy-start src-ptr start-value len-value)))

(define (lower-substring-check-len
  [state : LowerState]
  [src-ptr : CompilerIrValue]
  [src-len : CompilerIrValue]
  [start-value : CompilerIrValue]
  [len-value : CompilerIrValue]
  [fail-label : String]
  [copy-label : String]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc rem-alloc rem-var)
      (let
        [rem-state : LowerState
          (lower-state-emit
            rem-alloc
            (CompilerIrInstr.BinOp
              rem-var
              CompilerIrBinOp.Sub
              src-len
              start-value
              (AstType.I64)))]
        (match (lower-cast-value
          rem-state
          (CompilerIrValue.Var rem-var)
          (AstType.I64)
          (AstType.U64))
          [(LowerExpr.Expr rem-u-state rem-u _)
            (match (lower-cast-value
              rem-u-state
              len-value
              (AstType.I64)
              (AstType.U64))
              [(LowerExpr.Expr len-u-state len-u _)
                (match (lower-state-alloc-var len-u-state)
                  [(LowerAlloc.Alloc len-ok-alloc len-ok-var)
                    (let
                      [len-ok-state : LowerState
                        (lower-state-emit
                          len-ok-alloc
                          (CompilerIrInstr.BinOp
                            len-ok-var
                            CompilerIrBinOp.Le
                            len-u
                            rem-u
                            (AstType.U64)))]
                      (lower-substring-finish-after-len-check
                        len-ok-state
                        src-ptr
                        start-value
                        len-value
                        len-ok-var
                        fail-label
                        copy-label))])])]))]))

(define (lower-substring-bounds-checked
  [state : LowerState]
  [src-ptr : CompilerIrValue]
  [src-len : CompilerIrValue]
  [start-value : CompilerIrValue]
  [len-value : CompilerIrValue]) : ResultLowerExpr
  (match (lower-cast-value state start-value (AstType.I64) (AstType.U64))
    [(LowerExpr.Expr start-u-state start-u _)
      (match (lower-cast-value
        start-u-state
        src-len
        (AstType.I64)
        (AstType.U64))
        [(LowerExpr.Expr src-len-u-state src-len-u _)
          (match (lower-state-alloc-var src-len-u-state)
            [(LowerAlloc.Alloc start-ok-alloc start-ok-var)
              (let
                [start-ok-state : LowerState
                  (lower-state-emit
                    start-ok-alloc
                    (CompilerIrInstr.BinOp
                      start-ok-var
                      CompilerIrBinOp.Le
                      start-u
                      src-len-u
                      (AstType.U64)))]
                (match (lower-state-fresh-label
                  start-ok-state
                  "substr_start_ok")
                  [(LowerLabel.Label rem-label-state rem-label)
                    (match (lower-state-fresh-label
                      rem-label-state
                      "substr_bounds_fail")
                      [(LowerLabel.Label fail-label-state fail-label)
                        (match (lower-state-fresh-label
                          fail-label-state
                          "substr_ok")
                          [(LowerLabel.Label copy-label-state copy-label)
                            (let
                              [rem-start : LowerState
                                (lower-state-finish-block
                                  (lower-state-emit
                                    copy-label-state
                                    (CompilerIrInstr.Branch
                                      (CompilerIrValue.Var start-ok-var)
                                      rem-label
                                      fail-label))
                                  rem-label)]
                              (lower-substring-check-len
                                rem-start
                                src-ptr
                                src-len
                                start-value
                                len-value
                                fail-label
                                copy-label))])])]))])])]))

(define (lower-substring
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [str : AstExpr]
  [start : AstExpr]
  [len : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env str)
    [(ResultLowerExpr.Ok lowered-str)
      (match lowered-str
        [(LowerExpr.Expr str-state str-value str-ty)
          (if (lower-string-handle-type? ctx str-ty)
            (match (lower-string-fields str-state str-value)
              [(LowerStringFields.Fields fields-state src-ptr src-len)
                (match (lower-integer-expr-with-expected-or-actual
                  ctx
                  fields-state
                  env
                  type-env
                  start
                  (AstType.I64)
                  "lower: substring start must be integer")
                  [(ResultLowerExpr.Ok lowered-start)
                    (match lowered-start
                      [(LowerExpr.Expr start-state start-raw start-ty)
                        (match (lower-cast-value
                          start-state
                          start-raw
                          start-ty
                          (AstType.I64))
                          [(LowerExpr.Expr start-i-state start-value _)
                            (match (lower-integer-expr-with-expected-or-actual
                              ctx
                              start-i-state
                              env
                              type-env
                              len
                              (AstType.I64)
                              "lower: substring length must be integer")
                              [(ResultLowerExpr.Ok lowered-len)
                                (match lowered-len
                                  [(LowerExpr.Expr len-state len-raw len-ty)
                                    (match (lower-cast-value
                                      len-state
                                      len-raw
                                      len-ty
                                      (AstType.I64))
                                      [(LowerExpr.Expr len-i-state len-value _)
                                        (lower-substring-bounds-checked
                                          len-i-state
                                          src-ptr
                                          src-len
                                          start-value
                                          len-value)])])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  str
                  "lower: substring requires String"))))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-string-concat
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [exprs : AstExprList (lower-string-concat-exprs-all ctx env type-env args)]
    ;; A single public stdlib wrapper call already has compact, stable codegen.
    ;; Keep it on the ordinary direct-call path; only a nested public tree needs
    ;; the fused runtime batches. Legacy intrinsics have always used the runtime
    ;; path, including their two-leaf form.
    (if (and
      (lower-string-concat-public-target? name)
      (= (struct-get (& exprs) len) 2))
      (lower-direct-call-id
        ctx
        state
        env
        type-env
        source-id
        name
        args
        result-ty
        origin)
      (lower-string-concat-exprs ctx state env type-env exprs))))

(define (lower-c-abi-runtime-handle-extern? [name : String]) : bool
  (or
    (lower-string-prefix-at? name "tl_" 0)
    (lower-string-prefix-at? name ".L_tl_" 0)))

(define (lower-c-abi-extern-call?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [name : String]) : bool
  (cond
    [(not (lower-mode-c-abi? (lower-state-mode state))) false]
    [(sym_i64_env.sym-i64-contains-id env name-id) false]
    [(lower-c-abi-runtime-handle-extern? name) false]
    [else
      (let
        [handle : i64
          (compiler-symbols-lookup-value-id-or
            (tc-context-symbols ctx)
            name-id
            (compiler-symbols-missing-handle))]
        (and
          (compiler-symbols-handle-found? handle)
          (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern))
          (lower-symbol-function-value-id? ctx name-id)))]))

(define (lower-c-abi-extern-value-call?
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]
  [name : String]) : bool
  (cond
    [(not (lower-mode-c-abi? (lower-state-mode state))) false]
    [(sym_i64_env.sym-i64-contains-id env name-id) false]
    [(lower-c-abi-runtime-handle-extern? name) false]
    [else (lower-extern-value-decl-id? ctx name-id)]))

(define (lower-c-abi-integer-field-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [_ false]))

(define (lower-c-abi-inline-fields-integer-only?
  [ctx : TcContext]
  [fields : TcInlineFieldLayoutList]) : bool
  (match fields
    [(TcInlineFieldLayoutList.Nil) true]
    [(TcInlineFieldLayoutList.Cons field rest)
      (and
        (lower-c-abi-integer-field-type?
          ctx
          (tc-inline-field-layout-type field))
        (lower-c-abi-inline-fields-integer-only? ctx (box-get rest)))]))

(define (lower-c-abi-win64-register-struct-id?
  [ctx : TcContext]
  [name-id : i64]) : bool
  (match (tc-inline-aggregate-layout-for-id ctx name-id)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (match layout
        [(TcInlineAggregateLayout.Struct _ _ fields)
          (lower-c-abi-inline-fields-win64-register? ctx fields)]
        [(TcInlineAggregateLayout.Enum _ _ _) false])]
    [(ResultTcInlineAggregateLayout.Err _) false]))

(define (lower-c-abi-win64-register-field-type?
  [ctx : TcContext]
  [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (lower-c-abi-win64-register-struct-id? ctx name)]
    [(AstType.StructArgs name _)
      (lower-c-abi-win64-register-struct-id? ctx name)]
    [(AstType.F32) true]
    [(AstType.F64) true]
    [_ (lower-c-abi-integer-field-type? ctx ty)]))

(define (lower-c-abi-inline-fields-win64-register?
  [ctx : TcContext]
  [fields : TcInlineFieldLayoutList]) : bool
  (match fields
    [(TcInlineFieldLayoutList.Nil) true]
    [(TcInlineFieldLayoutList.Cons field rest)
      (and
        (lower-c-abi-win64-register-field-type?
          ctx
          (tc-inline-field-layout-type field))
        (lower-c-abi-inline-fields-win64-register? ctx (box-get rest)))]))

(define (lower-c-abi-register-aggregate-fields-ok?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [fields : TcInlineFieldLayoutList]) : bool
  (if (lower-mode-windows-c-abi? mode)
    (lower-c-abi-inline-fields-win64-register? ctx fields)
    (lower-c-abi-inline-fields-integer-only? ctx fields)))

(define (lower-c-abi-integer-scalar-type [size : i64]) : AstType
  (cond
    [(<= size 1) (AstType.U8)]
    [(<= size 2) (AstType.U16)]
    [(<= size 4) (AstType.U32)]
    [else (AstType.U64)]))

(define (lower-c-abi-target-name [mode : CompilerLowerMode]) : String
  (if (lower-mode-windows-c-abi? mode)
    "windows-x86_64"
    "linux-x86_64"))

(define (lower-c-abi-register-aggregate-size?
  [mode : CompilerLowerMode]
  [size : i64]) : bool
  (if (lower-mode-windows-c-abi? mode)
    (or (= size 1) (= size 2) (= size 4) (= size 8))
    (and (> size 0) (<= size 8))))

(define (lower-c-abi-aggregate-size-message [mode : CompilerLowerMode]) : String
  (if (lower-mode-windows-c-abi? mode)
    "scalar structs of size 1, 2, 4, or 8 bytes, including nested scalar struct fields"
    "System V aggregate structs/enums, including register-class and MEMORY-class layouts"))

(define (lower-c-abi-unsupported-message
  [mode : CompilerLowerMode]
  [ty : AstType]) : String
  (string.append
    (string.append "lower: unsupported " (lower-c-abi-target-name mode))
    (string.append
      " C aggregate ABI for "
      (string.append
        (tc-type-render ty)
        (string.append
          "; this slice supports "
          (lower-c-abi-aggregate-size-message mode))))))

(define (lower-c-abi-two-register-return-message [ty : AstType]) : String
  (string.append
    "lower: unsupported linux-x86_64 C two-register aggregate return ABI for "
    (tc-type-render ty)))

(define (lower-c-abi-sysv-slot-size [size : i64] [slot-index : i64]) : i64
  (if (= slot-index 0)
    (if (> size 8)
      8
      size)
    (- size 8)))

(define (lower-c-abi-sysv-merge-integer [current : LowerCAbiEightbyteClass]) : LowerCAbiEightbyteClass
  (match current
    [(LowerCAbiEightbyteClass.Unsupported)
      (LowerCAbiEightbyteClass.Unsupported)]
    [_ (LowerCAbiEightbyteClass.Integer)]))

(define (lower-c-abi-sysv-slot-base [offset : i64]) : i64
  (* (/ offset 8) 8))

(define (lower-c-abi-sysv-pack-f32-sse?
  [current-ty : AstType]
  [current-offset : i64]
  [next-ty : AstType]
  [next-offset : i64]) : bool
  (match current-ty
    [(AstType.F32)
      (match next-ty
        [(AstType.F32)
          (let
            [base : i64 (lower-c-abi-sysv-slot-base current-offset)]
            (and
              (= (lower-c-abi-sysv-slot-base next-offset) base)
              (= current-offset base)
              (= next-offset (+ base 4))))]
        [_ false])]
    [_ false]))

(define (lower-c-abi-sysv-merge-sse
  [current : LowerCAbiEightbyteClass]
  [ty : AstType]
  [offset : i64]) : LowerCAbiEightbyteClass
  (match current
    [(LowerCAbiEightbyteClass.Empty) (LowerCAbiEightbyteClass.Sse ty offset)]
    [(LowerCAbiEightbyteClass.Integer) (LowerCAbiEightbyteClass.Integer)]
    [(LowerCAbiEightbyteClass.Sse current-ty current-offset)
      (if (lower-c-abi-sysv-pack-f32-sse? current-ty current-offset ty offset)
        ;; A `{ f32, f32 }` eightbyte is still an SSE-class argument. Carry it
        ;; as an opaque 8-byte XMM payload, not as an INTEGER slot.
        (LowerCAbiEightbyteClass.Sse
          (AstType.F64)
          (lower-c-abi-sysv-slot-base offset))
        (LowerCAbiEightbyteClass.Unsupported))]
    [(LowerCAbiEightbyteClass.Unsupported)
      (LowerCAbiEightbyteClass.Unsupported)]))

(define (lower-c-abi-sysv-mark-integer-slot
  [slots : LowerCAbiSysvSlots]
  [slot-index : i64]) : LowerCAbiSysvSlots
  (match slots
    [(LowerCAbiSysvSlots.Slots first second)
      (if (= slot-index 0)
        (LowerCAbiSysvSlots.Slots (lower-c-abi-sysv-merge-integer first) second)
        (if (= slot-index 1)
          (LowerCAbiSysvSlots.Slots
            first
            (lower-c-abi-sysv-merge-integer second))
          (LowerCAbiSysvSlots.Unsupported)))]
    [(LowerCAbiSysvSlots.Unsupported) (LowerCAbiSysvSlots.Unsupported)]))

(define (lower-c-abi-sysv-mark-integer-range
  [slots : LowerCAbiSysvSlots]
  [offset : i64]
  [size : i64]) : LowerCAbiSysvSlots
  (if (<= size 0)
    slots
    (let
      [first-slot : i64 (/ offset 8)]
      [last-slot : i64 (/ (+ offset (- size 1)) 8)]
      (if (= first-slot last-slot)
        (lower-c-abi-sysv-mark-integer-slot slots first-slot)
        (lower-c-abi-sysv-mark-integer-slot
          (lower-c-abi-sysv-mark-integer-slot slots first-slot)
          last-slot)))))

(define (lower-c-abi-sysv-mark-sse-slot
  [slots : LowerCAbiSysvSlots]
  [ty : AstType]
  [offset : i64]) : LowerCAbiSysvSlots
  (let
    [slot-index : i64 (/ offset 8)]
    (match slots
      [(LowerCAbiSysvSlots.Slots first second)
        (if (= slot-index 0)
          (LowerCAbiSysvSlots.Slots
            (lower-c-abi-sysv-merge-sse first ty offset)
            second)
          (if (= slot-index 1)
            (LowerCAbiSysvSlots.Slots
              first
              (lower-c-abi-sysv-merge-sse second ty offset))
            (LowerCAbiSysvSlots.Unsupported)))]
      [(LowerCAbiSysvSlots.Unsupported) (LowerCAbiSysvSlots.Unsupported)])))

(define (lower-c-abi-sysv-classify-fields
  [ctx : TcContext]
  [fields : TcInlineFieldLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match fields
    [(TcInlineFieldLayoutList.Nil) slots]
    [(TcInlineFieldLayoutList.Cons field rest)
      (lower-c-abi-sysv-classify-fields
        ctx
        (box-get rest)
        base-offset
        (lower-c-abi-sysv-classify-type
          ctx
          (tc-inline-field-layout-type field)
          (+ base-offset (tc-inline-field-layout-offset field))
          slots))]))

(define (lower-c-abi-sysv-classify-payloads
  [ctx : TcContext]
  [payloads : TcInlinePayloadLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match payloads
    [(TcInlinePayloadLayoutList.Nil) slots]
    [(TcInlinePayloadLayoutList.Cons payload rest)
      (lower-c-abi-sysv-classify-payloads
        ctx
        (box-get rest)
        base-offset
        (lower-c-abi-sysv-classify-type
          ctx
          (tc-inline-payload-layout-type payload)
          (+ base-offset (tc-inline-payload-layout-offset payload))
          slots))]))

(define (lower-c-abi-sysv-classify-variants
  [ctx : TcContext]
  [variants : TcInlineVariantLayoutList]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match variants
    [(TcInlineVariantLayoutList.Nil) slots]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (match variant
        [(TcInlineVariantLayout.Variant _ _ _ payloads)
          (lower-c-abi-sysv-classify-variants
            ctx
            (box-get rest)
            base-offset
            (lower-c-abi-sysv-classify-payloads ctx payloads base-offset slots))])]))

(define (lower-c-abi-sysv-classify-layout
  [ctx : TcContext]
  [layout : TcInlineAggregateLayout]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match layout
    [(TcInlineAggregateLayout.Struct _ _ fields)
      (lower-c-abi-sysv-classify-fields ctx fields base-offset slots)]
    [(TcInlineAggregateLayout.Enum _ _ variants)
      ;; Synthetic tagged-union view: int64 tag at offset 0 plus every variant
      ;; payload overlaid in the union region starting at offset 8.
      (lower-c-abi-sysv-classify-variants
        ctx
        variants
        base-offset
        (lower-c-abi-sysv-mark-integer-range slots base-offset 8))]))

(define (lower-c-abi-sysv-classify-struct-id
  [ctx : TcContext]
  [name-id : i64]
  [base-offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (match (tc-inline-aggregate-layout-for-id ctx name-id)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (lower-c-abi-sysv-classify-layout ctx layout base-offset slots)]
    [(ResultTcInlineAggregateLayout.Err _) (LowerCAbiSysvSlots.Unsupported)]))

(define (lower-c-abi-sysv-classify-type
  [ctx : TcContext]
  [ty : AstType]
  [offset : i64]
  [slots : LowerCAbiSysvSlots]) : LowerCAbiSysvSlots
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Struct name)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(AstType.StructArgs name _)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(AstType.Enum name)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(AstType.EnumArgs name _)
        (lower-c-abi-sysv-classify-struct-id ctx name offset slots)]
      [(AstType.F64)
        (lower-c-abi-sysv-mark-sse-slot slots (AstType.F64) offset)]
      [(AstType.F32)
        (lower-c-abi-sysv-mark-sse-slot slots (AstType.F32) offset)]
      [_
        (if (lower-c-abi-integer-field-type? ctx resolved)
          (lower-c-abi-sysv-mark-integer-range
            slots
            offset
            (lower-type-size ctx resolved))
          (LowerCAbiSysvSlots.Unsupported))])))

(define (lower-c-abi-sysv-slot-from-class
  [class : LowerCAbiEightbyteClass]
  [size : i64]
  [slot-index : i64]) : LowerCAbiSlot
  (let
    [slot-size : i64 (lower-c-abi-sysv-slot-size size slot-index)]
    [slot-offset : i64 (* slot-index 8)]
    (match class
      [(LowerCAbiEightbyteClass.Sse ty offset) (LowerCAbiSlot.Slot ty offset)]
      [_
        (LowerCAbiSlot.Slot
          (lower-c-abi-integer-scalar-type slot-size)
          slot-offset)])))

(define (lower-c-abi-slot-list-count [slots : LowerCAbiSlotList]) : i64
  (struct-get slots count))

(define (lower-c-abi-slot-list-ref [slots : LowerCAbiSlotList] [index : i64]) : LowerCAbiSlot
  (array-ref (struct-get slots items) index))

(define (lower-c-abi-slot-list-single [slot : LowerCAbiSlot]) : LowerCAbiSlotList
  (let
    [items : (Array LowerCAbiSlot) (make-array LowerCAbiSlot 1)]
    (begin
      (array-set! items 0 slot)
      (LowerCAbiSlotList items 1))))

(define (lower-c-abi-slot-list-pair
  [first : LowerCAbiSlot]
  [second : LowerCAbiSlot]) : LowerCAbiSlotList
  (let
    [items : (Array LowerCAbiSlot) (make-array LowerCAbiSlot 2)]
    (begin
      (array-set! items 0 first)
      (array-set! items 1 second)
      (LowerCAbiSlotList items 2))))

(define (lower-c-abi-sysv-register-aggregate-from-slots
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [size : i64]
  [slots : LowerCAbiSysvSlots]
  [allow-return? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0)
      (LowerCAbiAggregate.Unsupported
        (lower-c-abi-unsupported-message mode resolved))]
    [(> size 16)
      (if allow-return?
        (LowerCAbiAggregate.Sret size)
        (LowerCAbiAggregate.Memory size))]
    [else
      (match slots
        [(LowerCAbiSysvSlots.Slots first second)
          (match first
            [(LowerCAbiEightbyteClass.Unsupported)
              (LowerCAbiAggregate.Unsupported
                (lower-c-abi-unsupported-message mode resolved))]
            [_
              (match second
                [(LowerCAbiEightbyteClass.Unsupported)
                  (LowerCAbiAggregate.Unsupported
                    (lower-c-abi-unsupported-message mode resolved))]
                [_
                  (if (> size 8)
                    (LowerCAbiAggregate.Register
                      (lower-c-abi-slot-list-pair
                        (lower-c-abi-sysv-slot-from-class first size 0)
                        (lower-c-abi-sysv-slot-from-class second size 1))
                      size)
                    (LowerCAbiAggregate.Register
                      (lower-c-abi-slot-list-single
                        (lower-c-abi-sysv-slot-from-class first size 0))
                      size))])])]
        [(LowerCAbiSysvSlots.Unsupported)
          (LowerCAbiAggregate.Unsupported
            (lower-c-abi-unsupported-message mode resolved))])]))

(define (lower-c-abi-sysv-register-aggregate
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [size : i64]
  [fields : TcInlineFieldLayoutList]
  [allow-return? : bool]) : LowerCAbiAggregate
  (cond
    [(<= size 0)
      (LowerCAbiAggregate.Unsupported
        (lower-c-abi-unsupported-message mode resolved))]
    [(> size 16)
      (if allow-return?
        (LowerCAbiAggregate.Sret size)
        (LowerCAbiAggregate.Memory size))]
    [(and
        (lower-c-abi-register-aggregate-size? mode size)
        (lower-c-abi-register-aggregate-fields-ok? ctx mode fields))
      (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)]
    [else
      (lower-c-abi-sysv-register-aggregate-from-slots
        mode
        resolved
        size
        (lower-c-abi-sysv-classify-fields
          ctx
          fields
          0
          (LowerCAbiSysvSlots.Slots
            (LowerCAbiEightbyteClass.Empty)
            (LowerCAbiEightbyteClass.Empty)))
        allow-return?)]))

(define (lower-c-abi-sysv-register-enum-aggregate
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [size : i64]
  [align : i64]
  [variants : TcInlineVariantLayoutList]
  [allow-return? : bool]) : LowerCAbiAggregate
  (if (tc-inline-enum-layout-tag-only? size variants)
    (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)
    (lower-c-abi-sysv-register-aggregate-from-slots
      mode
      resolved
      size
      (lower-c-abi-sysv-classify-layout
        ctx
        (TcInlineAggregateLayout.Enum size align variants)
        0
        (LowerCAbiSysvSlots.Slots
          (LowerCAbiEightbyteClass.Empty)
          (LowerCAbiEightbyteClass.Empty)))
      allow-return?)))

(define (lower-c-abi-win64-aggregate-class
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [size : i64]
  [register-ok? : bool]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (cond
    [(and (lower-c-abi-register-aggregate-size? mode size) register-ok?)
      (LowerCAbiAggregate.Integer (lower-c-abi-integer-scalar-type size) size)]
    [(and allow-sret? (> size 8)) (LowerCAbiAggregate.Sret size)]
    [(and allow-byref? (not (lower-c-abi-register-aggregate-size? mode size)))
      (LowerCAbiAggregate.ByRef size)]
    [else
      (LowerCAbiAggregate.Unsupported
        (lower-c-abi-unsupported-message mode resolved))]))

(define (lower-c-abi-aggregate-class-from-layout
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [resolved : AstType]
  [layout : TcInlineAggregateLayout]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (match layout
    [(TcInlineAggregateLayout.Struct size _ fields)
      (if (lower-mode-windows-c-abi? mode)
        (lower-c-abi-win64-aggregate-class
          mode
          resolved
          size
          (lower-c-abi-register-aggregate-fields-ok? ctx mode fields)
          allow-sret?
          allow-byref?)
        (lower-c-abi-sysv-register-aggregate
          ctx
          mode
          resolved
          size
          fields
          allow-sret?))]
    [(TcInlineAggregateLayout.Enum size align variants)
      (if (lower-mode-windows-c-abi? mode)
        ;; Model the default enum layout as a synthetic C aggregate:
        ;; int64 tag at offset 0 plus the max-sized payload union at offset 8.
        (lower-c-abi-win64-aggregate-class
          mode
          resolved
          size
          (tc-inline-enum-layout-tag-only? size variants)
          allow-sret?
          allow-byref?)
        (if (lower-mode-linux-c-abi? mode)
          (lower-c-abi-sysv-register-enum-aggregate
            ctx
            mode
            resolved
            size
            align
            variants
            allow-sret?)
          (LowerCAbiAggregate.Unsupported
            (lower-c-abi-unsupported-message mode resolved))))]))

(define (lower-c-abi-aggregate-class-for-nominal
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [name-id : i64]
  [resolved : AstType]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (match (tc-inline-aggregate-layout-for-id ctx name-id)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (lower-c-abi-aggregate-class-from-layout
        ctx
        mode
        resolved
        layout
        allow-sret?
        allow-byref?)]
    [(ResultTcInlineAggregateLayout.Err message)
      (LowerCAbiAggregate.Unsupported message)]))

(define (lower-c-abi-aggregate-class-with-flags
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [ty : AstType]
  [allow-sret? : bool]
  [allow-byref? : bool]) : LowerCAbiAggregate
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Struct name)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [(AstType.StructArgs name _)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [(AstType.Enum name)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [(AstType.EnumArgs name _)
        (lower-c-abi-aggregate-class-for-nominal
          ctx
          mode
          name
          resolved
          allow-sret?
          allow-byref?)]
      [_ (LowerCAbiAggregate.No)])))

(define (lower-c-abi-aggregate-class
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [ty : AstType]) : LowerCAbiAggregate
  (lower-c-abi-aggregate-class-with-flags ctx mode ty false true))

(define (lower-c-abi-return-aggregate-class
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [ty : AstType]) : LowerCAbiAggregate
  (lower-c-abi-aggregate-class-with-flags ctx mode ty true false))

(define (lower-c-abi-register-resident-to-scalar
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [agg-ty : AstType]
  [scalar-ty : AstType]) : LowerExpr
  (let
    [storage-ty : AstType (lower-one-word-register-storage-type ctx agg-ty)]
    (if (and
      (lower-register-word-sse-type? storage-ty)
      (not (tc-type-eq storage-ty scalar-ty)))
      (lower-bitcast-value state value storage-ty scalar-ty)
      (LowerExpr.Expr state value scalar-ty))))

(define (lower-c-abi-scalar-to-register-resident
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [scalar-ty : AstType]
  [agg-ty : AstType]) : LowerExpr
  (let
    [storage-ty : AstType (lower-one-word-register-storage-type ctx agg-ty)]
    (if (and
      (lower-register-word-sse-type? storage-ty)
      (not (tc-type-eq scalar-ty storage-ty)))
      (match (lower-bitcast-value state value scalar-ty storage-ty)
        [(LowerExpr.Expr bit-state bit-value _)
          (LowerExpr.Expr bit-state bit-value agg-ty)])
      (LowerExpr.Expr state value agg-ty))))

(define (lower-c-abi-args-as
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [types : AstTypeList]) : ResultLowerArgs
  (lower-c-abi-args-as-at ctx state env type-env (& args) (& types) 0))

(define (lower-c-abi-args-as-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : (& args AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index (struct-get args len))
    (if (>= index (ast-type-list-len types))
      (ResultLowerArgs.Ok state CompilerIrValueList.Nil)
      (ResultLowerArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch"))))
    (if (>= index (ast-type-list-len types))
      (ResultLowerArgs.Err
        (box (lower-diagnostic "lower: constructor arity mismatch")))
      (let
        [arg : AstExpr
          (lower-context-expr-get ctx (ast-expr-list-get args index 0))]
        [expected-id : i64
          (ast-type-list-get types index (ast-type-id-fallback))]
        [expected : AstType (tc-context-type-get ctx expected-id)]
        [arg-ty : AstType
          (tc-type-without-regions (tc-resolve-type ctx expected))]
        (match (lower-expr-expected ctx state env type-env arg arg-ty arg)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr arg-state value _)
                (match (lower-c-abi-aggregate-class
                  ctx
                  (lower-state-mode arg-state)
                  arg-ty)
                  [(LowerCAbiAggregate.No)
                    (match (lower-c-abi-args-as-at
                      ctx
                      arg-state
                      env
                      type-env
                      args
                      types
                      (+ index 1))
                      [(ResultLowerArgs.Ok rest-state rest-values)
                        (ResultLowerArgs.Ok
                          rest-state
                          (compiler-ir-value-cons value rest-values))]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerArgs.Err message)])]
                  [(LowerCAbiAggregate.Integer scalar-ty size)
                    ;; A register-resident aggregate is carried as a
                    ;; single-word scalar -- `value` is already the word the C
                    ;; ABI wants in a register, so pass it directly. Any other
                    ;; aggregate (a memory-backed value, e.g. a mixed
                    ;; int/float sub-word struct) is a pointer, so load the
                    ;; scalar out of it. Gate on the same residency predicate
                    ;; that chose the value representation -- not on `size`,
                    ;; since mixed sub-word float structs can still be
                    ;; memory-backed at 8 bytes.
                    (match (if (lower-type-register-resident? ctx arg-ty)
                      (lower-c-abi-register-resident-to-scalar
                        ctx
                        arg-state
                        value
                        arg-ty
                        scalar-ty)
                      (lower-load-at-offset arg-state value 0 scalar-ty))
                      [(LowerExpr.Expr scalar-state scalar-value _)
                        (match (lower-c-abi-args-as-at
                          ctx
                          scalar-state
                          env
                          type-env
                          args
                          types
                          (+ index 1))
                          [(ResultLowerArgs.Ok rest-state rest-values)
                            (ResultLowerArgs.Ok
                              rest-state
                              (compiler-ir-value-cons scalar-value rest-values))]
                          [(ResultLowerArgs.Err message)
                            (ResultLowerArgs.Err message)])])]
                  [(LowerCAbiAggregate.Register slots _)
                    (match (lower-c-abi-register-arg-slot-values
                      ctx
                      arg-state
                      value
                      arg-ty
                      slots)
                      [(ResultLowerArgs.Ok slot-state slot-values)
                        (match (lower-c-abi-args-as-at
                          ctx
                          slot-state
                          env
                          type-env
                          args
                          types
                          (+ index 1))
                          [(ResultLowerArgs.Ok rest-state rest-values)
                            (ResultLowerArgs.Ok
                              rest-state
                              (lower-value-list-append slot-values rest-values))]
                          [(ResultLowerArgs.Err message)
                            (ResultLowerArgs.Err message)])]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerArgs.Err message)])]
                  [(LowerCAbiAggregate.Memory size)
                    ;; The backend consumes size/unit markers and copies the aggregate to %rsp.
                    (match (lower-c-abi-args-as-at
                      ctx
                      arg-state
                      env
                      type-env
                      args
                      types
                      (+ index 1))
                      [(ResultLowerArgs.Ok rest-state rest-values)
                        (ResultLowerArgs.Ok
                          rest-state
                          (compiler-ir-value-cons
                            value
                            (compiler-ir-value-cons
                              (CompilerIrValue.I64 size)
                              (compiler-ir-value-cons
                                (CompilerIrValue.Unit)
                                rest-values))))]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerArgs.Err message)])]
                  [(LowerCAbiAggregate.ByRef _)
                    ;; The ABI argument is the address of the copied object,
                    ;; not the aggregate itself. Type the value as u64 so
                    ;; direct extern-call register assignment does not
                    ;; reclassify this pointer as a multi-word group.
                    (match (lower-copy-inline-aggregate-to-heap-as
                      ctx
                      arg-state
                      value
                      arg-ty
                      (AstType.U64))
                      [(ResultLowerExpr.Ok copied)
                        (match copied
                          [(LowerExpr.Expr copy-state copy-value _)
                            (match (lower-c-abi-args-as-at
                              ctx
                              copy-state
                              env
                              type-env
                              args
                              types
                              (+ index 1))
                              [(ResultLowerArgs.Ok rest-state rest-values)
                                (ResultLowerArgs.Ok
                                  rest-state
                                  (compiler-ir-value-cons
                                    copy-value
                                    rest-values))]
                              [(ResultLowerArgs.Err message)
                                (ResultLowerArgs.Err message)])])]
                      [(ResultLowerExpr.Err message)
                        (ResultLowerArgs.Err message)])]
                  [(LowerCAbiAggregate.Unsupported message)
                    (ResultLowerArgs.Err
                      (box (lower-diagnostic-at-expr arg message)))]
                  [(LowerCAbiAggregate.Sret _)
                    (ResultLowerArgs.Err
                      (box
                        (lower-diagnostic-at-expr
                          arg
                          (lower-c-abi-unsupported-message
                            (lower-state-mode arg-state)
                            arg-ty))))])])]
          [(ResultLowerExpr.Err message) (ResultLowerArgs.Err message)])))))

(define (lower-c-abi-register-arg-slot-values-from
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [arg-ty : AstType]
  [slots : LowerCAbiSlotList]
  [index : i64]) : ResultLowerArgs
  (if (>= index (lower-c-abi-slot-list-count slots))
    (ResultLowerArgs.Ok state CompilerIrValueList.Nil)
    (match (lower-c-abi-slot-list-ref slots index)
      [(LowerCAbiSlot.Slot scalar-ty offset)
        (match (if (lower-type-register-resident? ctx arg-ty)
          (if (lower-type-register-group? ctx arg-ty)
            (lower-emit-word state value (/ offset 8) scalar-ty)
            (LowerExpr.Expr state value scalar-ty))
          (lower-load-at-offset state value offset scalar-ty))
          [(LowerExpr.Expr slot-state slot-value _)
            (match (lower-c-abi-register-arg-slot-values-from
              ctx
              slot-state
              value
              arg-ty
              slots
              (+ index 1))
              [(ResultLowerArgs.Ok rest-state rest-values)
                (ResultLowerArgs.Ok
                  rest-state
                  (compiler-ir-value-cons slot-value rest-values))]
              [(ResultLowerArgs.Err message) (ResultLowerArgs.Err message)])])])))

(define (lower-c-abi-register-arg-slot-values
  [ctx : TcContext]
  [state : LowerState]
  [value : CompilerIrValue]
  [arg-ty : AstType]
  [slots : LowerCAbiSlotList]) : ResultLowerArgs
  (lower-c-abi-register-arg-slot-values-from ctx state value arg-ty slots 0))

(define (lower-value-list-append
  [values : CompilerIrValueList]
  [tail : CompilerIrValueList]) : CompilerIrValueList
  (match values
    [(CompilerIrValueList.Nil) tail]
    [(CompilerIrValueList.Array seq)
      (lower-value-list-append (compiler-ir-value-seq-to-list seq) tail)]
    [(CompilerIrValueList.Cons head rest)
      (compiler-ir-value-cons
        head
        (lower-value-list-append (box-get rest) tail))]))

(define (lower-c-abi-ir-return-slots-from
  [slots : LowerCAbiSlotList]
  [out : (Array CompilerIrCAbiReturnSlot)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (match (lower-c-abi-slot-list-ref slots index)
      [(LowerCAbiSlot.Slot scalar-ty offset)
        (begin
          (array-set!
            out
            index
            (CompilerIrCAbiReturnSlot.Slot scalar-ty offset))
          (lower-c-abi-ir-return-slots-from slots out (+ index 1) count))])))

(define (lower-c-abi-ir-return-slots [slots : LowerCAbiSlotList]) : CompilerIrCAbiReturnSlotList
  (let
    [count : i64 (lower-c-abi-slot-list-count slots)]
    [out : (Array CompilerIrCAbiReturnSlot)
      (array.make-array CompilerIrCAbiReturnSlot count)]
    (begin
      (lower-c-abi-ir-return-slots-from slots out 0 count)
      (CompilerIrCAbiReturnSlotList.Array
        (CompilerIrCAbiReturnSlotSeq out count)))))

(define (lower-c-abi-materialize-stored-register-result
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [result-ty : AstType]) : LowerExpr
  (if (lower-type-register-group? ctx result-ty)
    (lower-load-group-from-ptr ctx state base result-ty)
    (LowerExpr.Expr state base result-ty)))

(define (lower-c-abi-finish-call-result
  [ctx : TcContext]
  [state : LowerState]
  [call-value : CompilerIrValue]
  [result-ty : AstType]
  [abi : LowerCAbiAggregate]
  [origin : AstExpr]) : ResultLowerExpr
  (match abi
    [(LowerCAbiAggregate.No)
      (ResultLowerExpr.Ok (LowerExpr.Expr state call-value result-ty))]
    [(LowerCAbiAggregate.Integer scalar-ty size)
      ;; A register-resident aggregate is carried as a single-word scalar --
      ;; the C call returns the whole value in a register, which IS that word
      ;; representation, so hand it back directly. Any other aggregate (a
      ;; memory-backed value, e.g. a mixed int/float sub-word struct) is
      ;; referenced by pointer, so spill the returned scalar
      ;; into a fresh slot and return the pointer. Gate on the same residency
      ;; predicate that chose the value representation -- not on `size`, since
      ;; mixed sub-word float structs can still be memory-backed at 8 bytes.
      (if (lower-type-register-resident? ctx result-ty)
        (ResultLowerExpr.Ok
          (lower-c-abi-scalar-to-register-resident
            ctx
            state
            call-value
            scalar-ty
            result-ty))
        (match (lower-reserve-heap-storage state size result-ty)
          [(LowerExpr.Expr base-state base _)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-store-at-offset base-state base 0 call-value scalar-ty)
                base
                result-ty))]))]
    [(LowerCAbiAggregate.Register slots size)
      (let
        [slot-count : i64 (lower-c-abi-slot-list-count slots)]
        (cond
          [(= slot-count 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(LowerCAbiSlot.Slot scalar-ty offset)
                (if (lower-type-register-resident? ctx result-ty)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr state call-value result-ty))
                  (match (lower-reserve-heap-storage state size result-ty)
                    [(LowerExpr.Expr base-state base _)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-store-at-offset
                            base-state
                            base
                            offset
                            call-value
                            scalar-ty)
                          base
                          result-ty))]))])]
          [(= slot-count 0)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-c-abi-unsupported-message
                    (lower-state-mode state)
                    result-ty))))]
          [else
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-c-abi-two-register-return-message result-ty))))]))]
    [(LowerCAbiAggregate.ByRef _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Memory _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Sret _)
      ;; The C callee wrote the >8B result into the caller-provided sret
      ;; buffer, so `call-value` is the buffer pointer. A register-resident result
      ;; (a 16B word-class struct: a 2-word register group in this backend) must
      ;; be materialized back into that two-word group VALUE -- load both words
      ;; and Pack -- or downstream consumers that expect a register pair (e.g. a
      ;; by-value call argument) get the pointer in word0 and garbage in word1.
      ;; A genuine memory aggregate (>16B, or float-containing) stays the pointer.
      (if (lower-type-register-group? ctx result-ty)
        (ResultLowerExpr.Ok
          (lower-load-group-from-ptr ctx state call-value result-ty))
        (ResultLowerExpr.Ok (LowerExpr.Expr state call-value result-ty)))]
    [(LowerCAbiAggregate.Unsupported message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-direct-c-abi-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]
  [name : String]
  [args : AstExprList]
  [param-types : AstTypeList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-c-abi-args-as ctx state env type-env args param-types)
    [(ResultLowerArgs.Ok args-state values)
      (match (lower-c-abi-return-aggregate-class
        ctx
        (lower-state-mode args-state)
        result-ty)
        [(LowerCAbiAggregate.Unsupported message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]
        [(LowerCAbiAggregate.No)
          (match (lower-state-alloc-var args-state)
            [(LowerAlloc.Alloc allocated var-id)
              (let
                [instr : CompilerIrInstr
                  (CompilerIrInstr.Call
                    var-id
                    (lower-resolve-call-name-id-with-display
                      allocated
                      env
                      name-id
                      name)
                    (compiler-ir-call-args-from-list values)
                    result-ty)]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr allocated instr origin)
                  (CompilerIrValue.Var var-id)
                  result-ty
                  (LowerCAbiAggregate.No)
                  origin))])]
        [(LowerCAbiAggregate.Integer scalar-ty size)
          (match (lower-state-alloc-var args-state)
            [(LowerAlloc.Alloc allocated var-id)
              (let
                [instr : CompilerIrInstr
                  (CompilerIrInstr.Call
                    var-id
                    (lower-resolve-call-name-id-with-display
                      allocated
                      env
                      name-id
                      name)
                    (compiler-ir-call-args-from-list values)
                    scalar-ty)]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr allocated instr origin)
                  (CompilerIrValue.Var var-id)
                  result-ty
                  (LowerCAbiAggregate.Integer scalar-ty size)
                  origin))])]
        [(LowerCAbiAggregate.Register slots size)
          (let
            [slot-count : i64 (lower-c-abi-slot-list-count slots)]
            (cond
              [(= slot-count 1)
                (match (lower-c-abi-slot-list-ref slots 0)
                  [(LowerCAbiSlot.Slot scalar-ty _)
                    (match (lower-state-alloc-var args-state)
                      [(LowerAlloc.Alloc allocated var-id)
                        (let
                          [instr : CompilerIrInstr
                            (CompilerIrInstr.Call
                              var-id
                              (lower-resolve-call-name-id-with-display
                                allocated
                                env
                                name-id
                                name)
                              (compiler-ir-call-args-from-list values)
                              scalar-ty)]
                          (lower-c-abi-finish-call-result
                            ctx
                            (lower-state-emit-at-expr allocated instr origin)
                            (CompilerIrValue.Var var-id)
                            result-ty
                            (LowerCAbiAggregate.Register slots size)
                            origin))])])]
              [(= slot-count 0)
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      origin
                      (lower-c-abi-unsupported-message
                        (lower-state-mode args-state)
                        result-ty))))]
              [else
                (match (lower-reserve-heap-storage args-state size result-ty)
                  [(LowerExpr.Expr base-state base _)
                    (let
                      [instr : CompilerIrInstr
                        (ir-instr-call-cabi-store-result
                          base
                          (lower-resolve-call-name-id-with-display
                            base-state
                            env
                            name-id
                            name)
                          (compiler-ir-call-args-from-list values)
                          (lower-c-abi-ir-return-slots slots))]
                      (match (lower-c-abi-materialize-stored-register-result
                        ctx
                        (lower-state-emit-at-expr base-state instr origin)
                        base
                        result-ty)
                        [(LowerExpr.Expr out-state out-value out-ty)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr out-state out-value out-ty))]))])]))]
        [(LowerCAbiAggregate.ByRef _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-c-abi-unsupported-message
                  (lower-state-mode args-state)
                  result-ty))))]
        [(LowerCAbiAggregate.Memory _)
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-c-abi-unsupported-message
                  (lower-state-mode args-state)
                  result-ty))))]
        [(LowerCAbiAggregate.Sret size)
          ;; Reserve the sret buffer typed as a scalar pointer (U64), NOT
          ;; the aggregate result type. A register-resident result type would make
          ;; the backend classify the hidden sret pointer as a 2-word register
          ;; group, shifting every real argument by one slot (and reading an
          ;; undefined second word). Typing it U64 keeps the hidden pointer in a
          ;; single integer register, and it survives copy-propagation (there is
          ;; no copy to fold). The result materialization below reads the 2 words
          ;; back from the buffer using `result-ty` explicitly.
          (match (lower-reserve-heap-storage args-state size (AstType.U64))
            [(LowerExpr.Expr base-state base _)
              (match (lower-state-alloc-var base-state)
                [(LowerAlloc.Alloc allocated var-id)
                  (let
                    [instr : CompilerIrInstr
                      (CompilerIrInstr.Call
                        var-id
                        (lower-resolve-call-name-id-with-display
                          allocated
                          env
                          name-id
                          name)
                        (compiler-ir-call-args-from-list
                          (compiler-ir-value-cons base values))
                        (AstType.U64))]
                    (lower-c-abi-finish-call-result
                      ctx
                      (lower-state-emit-at-expr allocated instr origin)
                      base
                      result-ty
                      (LowerCAbiAggregate.Sret size)
                      origin))])])])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-indirect-c-abi-call-values
  [ctx : TcContext]
  [state : LowerState]
  [func-value : CompilerIrValue]
  [values : CompilerIrValueList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-c-abi-return-aggregate-class
    ctx
    (lower-state-mode state)
    result-ty)
    [(LowerCAbiAggregate.Unsupported message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]
    [(LowerCAbiAggregate.No)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [instr : CompilerIrInstr
              (CompilerIrInstr.CallIndirectC
                var-id
                func-value
                (compiler-ir-call-args-from-list values)
                result-ty)]
            (lower-c-abi-finish-call-result
              ctx
              (lower-state-emit-at-expr allocated instr origin)
              (CompilerIrValue.Var var-id)
              result-ty
              (LowerCAbiAggregate.No)
              origin))])]
    [(LowerCAbiAggregate.Integer scalar-ty size)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [instr : CompilerIrInstr
              (CompilerIrInstr.CallIndirectC
                var-id
                func-value
                (compiler-ir-call-args-from-list values)
                scalar-ty)]
            (lower-c-abi-finish-call-result
              ctx
              (lower-state-emit-at-expr allocated instr origin)
              (CompilerIrValue.Var var-id)
              result-ty
              (LowerCAbiAggregate.Integer scalar-ty size)
              origin))])]
    [(LowerCAbiAggregate.Register slots size)
      (let
        [slot-count : i64 (lower-c-abi-slot-list-count slots)]
        (cond
          [(= slot-count 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(LowerCAbiSlot.Slot scalar-ty _)
                (match (lower-state-alloc-var state)
                  [(LowerAlloc.Alloc allocated var-id)
                    (let
                      [instr : CompilerIrInstr
                        (CompilerIrInstr.CallIndirectC
                          var-id
                          func-value
                          (compiler-ir-call-args-from-list values)
                          scalar-ty)]
                      (lower-c-abi-finish-call-result
                        ctx
                        (lower-state-emit-at-expr allocated instr origin)
                        (CompilerIrValue.Var var-id)
                        result-ty
                        (LowerCAbiAggregate.Register slots size)
                        origin))])])]
          [(= slot-count 0)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  (lower-c-abi-unsupported-message
                    (lower-state-mode state)
                    result-ty))))]
          [else
            (match (lower-reserve-heap-storage state size result-ty)
              [(LowerExpr.Expr base-state base _)
                (let
                  [instr : CompilerIrInstr
                    (ir-instr-call-indirect-cabi-store-result
                      base
                      func-value
                      (compiler-ir-call-args-from-list values)
                      (lower-c-abi-ir-return-slots slots))]
                  (match (lower-c-abi-materialize-stored-register-result
                    ctx
                    (lower-state-emit-at-expr base-state instr origin)
                    base
                    result-ty)
                    [(LowerExpr.Expr out-state out-value out-ty)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr out-state out-value out-ty))]))])]))]
    [(LowerCAbiAggregate.ByRef _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Memory _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            (lower-c-abi-unsupported-message (lower-state-mode state) result-ty))))]
    [(LowerCAbiAggregate.Sret size)
      ;; Reserve the sret buffer typed as a scalar pointer (U64) -- see
      ;; lower-direct-c-abi-call -- so a register-resident result type does not make
      ;; the backend classify the hidden sret pointer as a 2-register group arg.
      (match (lower-reserve-heap-storage state size (AstType.U64))
        [(LowerExpr.Expr base-state base _)
          (match (lower-state-alloc-var base-state)
            [(LowerAlloc.Alloc allocated var-id)
              (let
                [instr : CompilerIrInstr
                  (CompilerIrInstr.CallIndirectC
                    var-id
                    func-value
                    (compiler-ir-call-args-from-list
                      (compiler-ir-value-cons base values))
                    (AstType.U64))]
                (lower-c-abi-finish-call-result
                  ctx
                  (lower-state-emit-at-expr allocated instr origin)
                  base
                  result-ty
                  (LowerCAbiAggregate.Sret size)
                  origin))])])]))

(define (lower-extern-value-c-abi-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name-id : i64]
  [args : AstExprList]
  [param-types : AstTypeList]
  [fn-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-var-id state env name-id fn-ty)
    [(ResultLowerExpr.Ok lowered-func)
      (match lowered-func
        [(LowerExpr.Expr func-state func-value _)
          (match (lower-state-alloc-var func-state)
            [(LowerAlloc.Alloc allocated func-var)
              (let
                [loaded-state : LowerState
                  (lower-state-emit-at-expr
                    allocated
                    (CompilerIrInstr.Mov func-var func-value fn-ty)
                    origin)]
                (match (lower-c-abi-args-as
                  ctx
                  loaded-state
                  env
                  type-env
                  args
                  param-types)
                  [(ResultLowerArgs.Ok args-state values)
                    (lower-indirect-c-abi-call-values
                      ctx
                      args-state
                      (CompilerIrValue.Var func-var)
                      values
                      result-ty
                      origin)]
                  [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; sret ABI caller side: append the sret pointer as the trailing arg to a
;; value list (matching the callee's `__sret` param).
(define (lower-value-list-append-one
  [values : CompilerIrValueList]
  [extra : CompilerIrValue]) : CompilerIrValueList
  (match values
    [(CompilerIrValueList.Nil)
      (compiler-ir-value-cons extra CompilerIrValueList.Nil)]
    [(CompilerIrValueList.Array seq)
      (lower-value-list-append-one (compiler-ir-value-seq-to-list seq) extra)]
    [(CompilerIrValueList.Cons head rest)
      (compiler-ir-value-cons
        head
        (lower-value-list-append-one (box-get rest) extra))]))

;; For a call whose result is an inline aggregate, allocate the result slot on
;; the caller's stack and append its pointer as the hidden trailing arg. Uses
;; the same gate/size as the callee's sret return, so the call's return value is
;; that pointer and callers consume the result exactly as before. Non-aggregate
;; results pass through unchanged.
(define (lower-call-append-sret-arg
  [ctx : TcContext]
  [state : LowerState]
  [values : CompilerIrValueList]
  [result-ty : AstType]) : ResultLowerArgs
  (if (lower-inline-aggregate-abi-copy-needed? ctx state result-ty)
    (match (lower-inline-aggregate-copy-size ctx result-ty)
      [(ResultLowerSize.Ok size)
        (match (lower-reserve-inline-storage state size result-ty)
          [(LowerExpr.Expr slot-state slot-ptr _)
            (ResultLowerArgs.Ok
              slot-state
              (lower-value-list-append-one values slot-ptr))])]
      [(ResultLowerSize.Err message)
        (ResultLowerArgs.Err (box (lower-diagnostic message)))])
    (ResultLowerArgs.Ok state values)))

(define (lower-direct-call-values
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [name : String]
  [values : CompilerIrValueList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-call-append-sret-arg ctx state values result-ty)
    [(ResultLowerArgs.Ok sret-state sret-values)
      (match (lower-state-alloc-var sret-state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [result-ir-ty : AstType
              (lower-one-word-register-storage-type ctx result-ty)]
            [callee : i64
              (lower-resolve-call-name-id-with-display
                allocated
                env
                source-id
                name)]
            [instr : CompilerIrInstr
              (CompilerIrInstr.Call
                var-id
                callee
                (compiler-ir-call-args-from-list sret-values)
                result-ir-ty)]
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-state-emit-at-expr allocated instr origin)
                (CompilerIrValue.Var var-id)
                result-ty)))])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-bytes-view-from-parts-result
  [ctx : TcContext]
  [state : LowerState]
  [ptr-value : CompilerIrValue]
  [len-value : CompilerIrValue]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-reserve-inline-storage state 16 (AstType.String))
    [(LowerExpr.Expr base-state base-value _)
      (let
        [with-ptr : LowerState
          (lower-store-at-offset
            base-state
            base-value
            0
            ptr-value
            (AstType.U64))]
        [with-len : LowerState
          (lower-store-at-offset with-ptr base-value 8 len-value (AstType.I64))]
        (match (lower-state-alloc-var with-len)
          [(LowerAlloc.Alloc call-state call-var)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-state-emit-at-expr
                  call-state
                  (CompilerIrInstr.Call
                    call-var
                    (lower-tl-str-view-symbol)
                    (compiler-ir-call-args-from-list
                      (compiler-ir-value-cons
                        base-value
                        (compiler-ir-value-cons
                          (CompilerIrValue.I64 0)
                          (compiler-ir-value-cons
                            len-value
                            CompilerIrValueList.Nil))))
                    (lower-one-word-register-storage-type ctx result-ty))
                  origin)
                (CompilerIrValue.Var call-var)
                result-ty))]))]))

(define (lower-bytes-view-from-parts-values
  [ctx : TcContext]
  [args-result : ResultLowerArgs]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args-result
    [(ResultLowerArgs.Ok args-state values)
      (match (compiler-ir-value-list-force-cons values)
        [(CompilerIrValueList.Array seq)
          (lower-bytes-view-from-parts-values
            ctx
            (ResultLowerArgs.Ok args-state (compiler-ir-value-seq-to-list seq))
            result-ty
            origin)]
        [(CompilerIrValueList.Cons data-value rest0)
          (match (box-get rest0)
            [(CompilerIrValueList.Cons len-value rest1)
              (match (box-get rest1)
                [(CompilerIrValueList.Cons _ rest2)
                  (match (box-get rest2)
                    [(CompilerIrValueList.Nil)
                      (lower-bytes-view-from-parts-result
                        ctx
                        args-state
                        data-value
                        len-value
                        result-ty
                        origin)]
                    [_
                      (ResultLowerExpr.Err
                        (box
                          (lower-diagnostic-at-expr
                            origin
                            "lower: bytes view helper expects data, length, owner")))])]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        origin
                        "lower: bytes view helper expects data, length, owner")))])]
            [_
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic-at-expr
                    origin
                    "lower: bytes view helper expects data, length, owner")))])]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: bytes view helper expects data, length, owner")))])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-bytes-view-from-parts-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (lower-bytes-view-from-parts-values
    ctx
    (lower-args ctx state env type-env args)
    result-ty
    origin))

(define (lower-direct-call-from-args
  [ctx : TcContext]
  [args-result : ResultLowerArgs]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [name : String]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args-result
    [(ResultLowerArgs.Ok args-state values)
      (lower-direct-call-values
        ctx
        args-state
        env
        source-id
        name
        values
        result-ty
        origin)]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-direct-call-from-call-args
  [ctx : TcContext]
  [args-result : ResultLowerCallArgs]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [name : String]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match args-result
    [(ResultLowerCallArgs.Ok args-state values writebacks)
      (match (lower-direct-call-values
        ctx
        args-state
        env
        source-id
        name
        values
        result-ty
        origin)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr call-state call-value call-ty)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-apply-arg-writebacks ctx call-state writebacks)
                  call-value
                  call-ty))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(ResultLowerCallArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-direct-call-param-types
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [name-id : i64]
  [args : AstExprList]
  [params : AstTypeList]) : ResultTcTypeList
  (match (tc-call-extern-abi-for-name-id ctx name-id)
    [(TcMaybeExternAbi.Some abi)
      (if (tc-call-dynamic-c-varargs-abi? abi)
        (tc-call-extern-varargs-params
          ctx
          type-env
          (AstExpr.Var name-id)
          args
          params
          abi)
        (ResultTcTypeList.Ok params))]
    [(TcMaybeExternAbi.No) (ResultTcTypeList.Ok params)]))

(define (lower-direct-call-id-with-lookup-id
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (lower-bytes-view-from-parts-name? name)
    (lower-bytes-view-from-parts-call
      ctx
      state
      env
      type-env
      args
      result-ty
      origin)
    (match (lower-lookup-type-id
      ctx
      (lower-state-type-cache state)
      env
      type-env
      lookup-id)
      [(ResultTcType.Ok fn-ty)
        (match (tc-type-strip-region (tc-resolve-type ctx fn-ty))
          [(AstType.Func param-types _)
            (match (lower-direct-call-param-types
              ctx
              type-env
              source-id
              args
              (tc-resolve-type-list ctx (box-get param-types)))
              [(ResultTcTypeList.Ok call-param-types)
                (if (lower-c-abi-extern-call?
                  ctx
                  state
                  env
                  (if (>= lookup-id 0)
                    lookup-id
                    source-id)
                  name)
                  (lower-direct-c-abi-call
                    ctx
                    state
                    env
                    type-env
                    (if (>= lookup-id 0)
                      lookup-id
                      source-id)
                    name
                    args
                    call-param-types
                    result-ty
                    origin)
                  (if (lower-c-abi-extern-value-call?
                    ctx
                    state
                    env
                    (if (>= lookup-id 0)
                      lookup-id
                      source-id)
                    name)
                    (lower-extern-value-c-abi-call
                      ctx
                      state
                      env
                      type-env
                      (if (>= lookup-id 0)
                        lookup-id
                        source-id)
                      args
                      call-param-types
                      (tc-type-strip-region (tc-resolve-type ctx fn-ty))
                      result-ty
                      origin)
                    (lower-direct-call-from-call-args
                      ctx
                      (lower-call-args-as-needed
                        ctx
                        state
                        env
                        type-env
                        args
                        call-param-types)
                      env
                      source-id
                      name
                      result-ty
                      origin)))]
              [(ResultTcTypeList.Err message)
                (ResultLowerExpr.Err
                  (box (lower-diagnostic-at-expr origin message)))])]
          [_
            (lower-direct-call-from-args
              ctx
              (lower-args ctx state env type-env args)
              env
              source-id
              name
              result-ty
              origin)])]
      [(ResultTcType.Err _)
        (lower-direct-call-from-args
          ctx
          (lower-args ctx state env type-env args)
          env
          source-id
          name
          result-ty
          origin)])))

(define (lower-direct-call-id
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (lower-direct-call-id-with-lookup-id
    ctx
    state
    env
    type-env
    source-id
    source-id
    name
    args
    result-ty
    origin))

(define (lower-indirect-call-values
  [ctx : TcContext]
  [state : LowerState]
  [func-value : CompilerIrValue]
  [values : CompilerIrValueList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-call-append-sret-arg ctx state values result-ty)
    [(ResultLowerArgs.Ok sret-state sret-values)
      (match (lower-state-alloc-var sret-state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [result-ir-ty : AstType
              (lower-one-word-register-storage-type ctx result-ty)]
            [instr : CompilerIrInstr
              (CompilerIrInstr.CallIndirect
                var-id
                func-value
                (compiler-ir-call-args-from-list sret-values)
                result-ir-ty)]
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-state-emit-at-expr allocated instr origin)
                (CompilerIrValue.Var var-id)
                result-ty)))])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-indirect-call-args
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [func-ty : AstType]) : ResultLowerArgs
  (match (tc-type-strip-region (tc-resolve-type ctx func-ty))
    [(AstType.Func param-types _)
      (lower-args-as
        ctx
        state
        env
        type-env
        args
        (tc-resolve-type-list ctx (box-get param-types)))]
    [_ (lower-args ctx state env type-env args)]))

(define (lower-indirect-call-args-with-writebacks
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [func-ty : AstType]) : ResultLowerCallArgs
  (match (tc-type-strip-region (tc-resolve-type ctx func-ty))
    [(AstType.Func param-types _)
      (lower-call-args-as-needed
        ctx
        state
        env
        type-env
        args
        (tc-resolve-type-list ctx (box-get param-types)))]
    [_
      (match (lower-args ctx state env type-env args)
        [(ResultLowerArgs.Ok args-state values)
          (ResultLowerCallArgs.Ok args-state values (LowerArgWritebacks.None))]
        [(ResultLowerArgs.Err message) (ResultLowerCallArgs.Err message)])]))

(define (lower-indirect-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func-ty : AstType]
  [func-value : CompilerIrValue]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-indirect-call-args-with-writebacks
    ctx
    state
    env
    type-env
    args
    func-ty)
    [(ResultLowerCallArgs.Ok args-state values writebacks)
      (match (lower-indirect-call-values
        ctx
        args-state
        func-value
        values
        result-ty
        origin)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr call-state call-value call-ty)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-apply-arg-writebacks ctx call-state writebacks)
                  call-value
                  call-ty))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(ResultLowerCallArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-indirect-c-abi-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func-ty : AstType]
  [func-value : CompilerIrValue]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-type-strip-region (tc-resolve-type ctx func-ty))
    [(AstType.Func param-types _)
      (match (lower-c-abi-args-as
        ctx
        state
        env
        type-env
        args
        (tc-resolve-type-list ctx (box-get param-types)))
        [(ResultLowerArgs.Ok args-state values)
          (lower-indirect-c-abi-call-values
            ctx
            args-state
            func-value
            values
            result-ty
            origin)]
        [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)])]
    [_
      (lower-indirect-call
        ctx
        state
        env
        type-env
        func-ty
        func-value
        args
        result-ty
        origin)]))

(define (lower-substring-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 3)
    (let
      [str : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      [start : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 1 0))]
      [len : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 2 0))]
      (lower-substring ctx state env type-env str start len))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-string-concat-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 2)
    (lower-string-concat
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-string-runtime-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (or (string.eq name "substring") (string.eq name "string-slice"))
    (lower-substring-call
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)
    (lower-string-concat-call
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-runtime-call-values
  [state : LowerState]
  [name : i64]
  [values : CompilerIrValueList]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit
            allocated
            (CompilerIrInstr.Call
              var-id
              name
              (compiler-ir-call-args-from-list values)
              result-ty))
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-inline-string-eq-finish
  [state : LowerState]
  [_true-label : String]
  [false-label : String]
  [done-label : String]
  [result-var : i64]
  [result-ty : AstType]) : LowerExpr
  (let
    [false-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-state-emit
            state
            (CompilerIrInstr.Mov
              result-var
              (CompilerIrValue.Bool true)
              (AstType.Bool)))
          (CompilerIrInstr.Jump done-label))
        false-label)]
    [done-start : LowerState
      (lower-state-finish-block
        (lower-state-emit false-start (CompilerIrInstr.Jump done-label))
        done-label)]
    (LowerExpr.Expr done-start (CompilerIrValue.Var result-var) result-ty)))

(define (lower-inline-string-eq-body
  [state : LowerState]
  [header-label : String]
  [true-label : String]
  [false-label : String]
  [done-label : String]
  [result-var : i64]
  [index-var : i64]
  [left-ptr : CompilerIrValue]
  [right-ptr : CompilerIrValue]
  [result-ty : AstType]) : LowerExpr
  (match (lower-emit-gep
    state
    left-ptr
    (CompilerIrValue.Var index-var)
    (AstType.U8))
    [(LowerExpr.Expr left-gep-state left-addr _)
      (match (lower-emit-load left-gep-state left-addr (AstType.U8))
        [(LowerExpr.Expr left-load-state left-byte _)
          (match (lower-emit-gep
            left-load-state
            right-ptr
            (CompilerIrValue.Var index-var)
            (AstType.U8))
            [(LowerExpr.Expr right-gep-state right-addr _)
              (match (lower-emit-load right-gep-state right-addr (AstType.U8))
                [(LowerExpr.Expr right-load-state right-byte _)
                  (match (lower-emit-cast
                    right-load-state
                    left-byte
                    (AstType.U8)
                    (AstType.I64))
                    [(LowerExpr.Expr left-cast-state left-i64 _)
                      (match (lower-emit-cast
                        left-cast-state
                        right-byte
                        (AstType.U8)
                        (AstType.I64))
                        [(LowerExpr.Expr right-cast-state right-i64 _)
                          (match (lower-emit-binop
                            right-cast-state
                            CompilerIrBinOp.Eq
                            left-i64
                            right-i64
                            (AstType.I64))
                            [(LowerExpr.Expr byte-eq-state byte-eq _)
                              (match (lower-emit-binop
                                byte-eq-state
                                CompilerIrBinOp.Add
                                (CompilerIrValue.Var index-var)
                                (CompilerIrValue.I64 1)
                                (AstType.I64))
                                [(LowerExpr.Expr inc-state next-index _)
                                  (lower-inline-string-eq-finish
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        (lower-state-emit
                                          inc-state
                                          (CompilerIrInstr.Mov
                                            index-var
                                            next-index
                                            (AstType.I64)))
                                        (CompilerIrInstr.Branch
                                          byte-eq
                                          header-label
                                          false-label))
                                      true-label)
                                    true-label
                                    false-label
                                    done-label
                                    result-var
                                    result-ty)])])])])])])])]))

(define (lower-inline-string-eq-fields
  [state : LowerState]
  [left-ptr : CompilerIrValue]
  [left-len : CompilerIrValue]
  [right-ptr : CompilerIrValue]
  [right-len : CompilerIrValue]
  [result-ty : AstType]) : LowerExpr
  (match (lower-state-fresh-label state "string_eq_header")
    [(LowerLabel.Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "string_eq_body")
        [(LowerLabel.Label body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "string_eq_true")
            [(LowerLabel.Label true-label-state true-label)
              (match (lower-state-fresh-label
                true-label-state
                "string_eq_false")
                [(LowerLabel.Label false-label-state false-label)
                  (match (lower-state-fresh-label
                    false-label-state
                    "string_eq_done")
                    [(LowerLabel.Label done-label-state done-label)
                      (match (lower-state-alloc-var done-label-state)
                        [(LowerAlloc.Alloc result-alloc result-var)
                          (match (lower-state-alloc-var result-alloc)
                            [(LowerAlloc.Alloc index-alloc index-var)
                              (match (lower-emit-binop
                                (lower-state-emit
                                  (lower-state-emit
                                    index-alloc
                                    (CompilerIrInstr.Mov
                                      result-var
                                      (CompilerIrValue.Bool false)
                                      (AstType.Bool)))
                                  (CompilerIrInstr.Mov
                                    index-var
                                    (CompilerIrValue.I64 0)
                                    (AstType.I64)))
                                CompilerIrBinOp.Eq
                                left-len
                                right-len
                                (AstType.I64))
                                [(LowerExpr.Expr len-state len-ok _)
                                  (let
                                    [header-start : LowerState
                                      (lower-state-finish-block
                                        (lower-state-emit
                                          len-state
                                          (CompilerIrInstr.Branch
                                            len-ok
                                            header-label
                                            false-label))
                                        header-label)]
                                    (match (lower-emit-binop
                                      header-start
                                      CompilerIrBinOp.Lt
                                      (CompilerIrValue.Var index-var)
                                      left-len
                                      (AstType.I64))
                                      [(LowerExpr.Expr cond-state cond-value _)
                                        (lower-inline-string-eq-body
                                          (lower-state-finish-block
                                            (lower-state-emit
                                              cond-state
                                              (CompilerIrInstr.Branch
                                                cond-value
                                                body-label
                                                true-label))
                                            body-label)
                                          header-label
                                          true-label
                                          false-label
                                          done-label
                                          result-var
                                          index-var
                                          left-ptr
                                          right-ptr
                                          result-ty)]))])])])])])])])]))

(define (lower-inline-string-to-int-negate
  [state : LowerState]
  [negate-label : String]
  [done-label : String]
  [value-var : i64]
  [negative-var : i64]
  [result-ty : AstType]) : LowerExpr
  (let
    [negate-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          state
          (CompilerIrInstr.Branch
            (CompilerIrValue.Var negative-var)
            negate-label
            done-label))
        negate-label)]
    (match (lower-emit-binop
      negate-start
      CompilerIrBinOp.Sub
      (CompilerIrValue.I64 0)
      (CompilerIrValue.Var value-var)
      (AstType.I64))
      [(LowerExpr.Expr neg-state neg-value _)
        (let
          [done-start : LowerState
            (lower-state-finish-block
              (lower-state-emit
                (lower-state-emit
                  neg-state
                  (CompilerIrInstr.Mov value-var neg-value (AstType.I64)))
                (CompilerIrInstr.Jump done-label))
              done-label)]
          (LowerExpr.Expr done-start (CompilerIrValue.Var value-var) result-ty))])))

(define (lower-inline-string-to-int-body
  [state : LowerState]
  [ptr : CompilerIrValue]
  [header-label : String]
  [apply-label : String]
  [negate-label : String]
  [done-label : String]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : AstType]) : LowerExpr
  (match (lower-emit-gep state ptr (CompilerIrValue.Var index-var) (AstType.U8))
    [(LowerExpr.Expr byte-gep-state byte-addr _)
      (match (lower-emit-load byte-gep-state byte-addr (AstType.U8))
        [(LowerExpr.Expr byte-load-state byte-value _)
          (match (lower-emit-cast
            byte-load-state
            byte-value
            (AstType.U8)
            (AstType.I64))
            [(LowerExpr.Expr byte-cast-state byte-i64 _)
              (match (lower-emit-binop
                byte-cast-state
                CompilerIrBinOp.Sub
                byte-i64
                (CompilerIrValue.I64 48)
                (AstType.I64))
                [(LowerExpr.Expr digit-state digit _)
                  (match (lower-emit-binop
                    digit-state
                    CompilerIrBinOp.Mul
                    (CompilerIrValue.Var value-var)
                    (CompilerIrValue.I64 10)
                    (AstType.I64))
                    [(LowerExpr.Expr scaled-state scaled _)
                      (match (lower-emit-binop
                        scaled-state
                        CompilerIrBinOp.Add
                        scaled
                        digit
                        (AstType.I64))
                        [(LowerExpr.Expr next-state next-value _)
                          (match (lower-emit-binop
                            next-state
                            CompilerIrBinOp.Add
                            (CompilerIrValue.Var index-var)
                            (CompilerIrValue.I64 1)
                            (AstType.I64))
                            [(LowerExpr.Expr inc-state next-index _)
                              (lower-inline-string-to-int-negate
                                (lower-state-finish-block
                                  (lower-state-emit
                                    (lower-state-emit
                                      (lower-state-emit
                                        inc-state
                                        (CompilerIrInstr.Mov
                                          value-var
                                          next-value
                                          (AstType.I64)))
                                      (CompilerIrInstr.Mov
                                        index-var
                                        next-index
                                        (AstType.I64)))
                                    (CompilerIrInstr.Jump header-label))
                                  apply-label)
                                negate-label
                                done-label
                                value-var
                                negative-var
                                result-ty)])])])])])])]))

(define (lower-inline-string-to-int-loop
  [state : LowerState]
  [ptr : CompilerIrValue]
  [len : CompilerIrValue]
  [body-label : String]
  [apply-label : String]
  [header-label : String]
  [negate-label : String]
  [done-label : String]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : AstType]) : LowerExpr
  (match (lower-emit-binop
    state
    CompilerIrBinOp.Lt
    (CompilerIrValue.Var index-var)
    len
    (AstType.I64))
    [(LowerExpr.Expr cond-state cond-value _)
      (lower-inline-string-to-int-body
        (lower-state-finish-block
          (lower-state-emit
            cond-state
            (CompilerIrInstr.Branch cond-value body-label apply-label))
          body-label)
        ptr
        header-label
        apply-label
        negate-label
        done-label
        value-var
        index-var
        negative-var
        result-ty)]))

(define (lower-inline-string-to-int-sign
  [state : LowerState]
  [ptr : CompilerIrValue]
  [len : CompilerIrValue]
  [minus-label : String]
  [header-label : String]
  [body-label : String]
  [apply-label : String]
  [negate-label : String]
  [done-label : String]
  [value-var : i64]
  [index-var : i64]
  [negative-var : i64]
  [result-ty : AstType]) : LowerExpr
  (match (lower-emit-gep state ptr (CompilerIrValue.I64 0) (AstType.U8))
    [(LowerExpr.Expr first-gep-state first-addr _)
      (match (lower-emit-load first-gep-state first-addr (AstType.U8))
        [(LowerExpr.Expr first-load-state first-byte _)
          (match (lower-emit-cast
            first-load-state
            first-byte
            (AstType.U8)
            (AstType.I64))
            [(LowerExpr.Expr first-cast-state first-i64 _)
              (match (lower-emit-binop
                first-cast-state
                CompilerIrBinOp.Eq
                first-i64
                (CompilerIrValue.I64 45)
                (AstType.I64))
                [(LowerExpr.Expr minus-test-state minus? _)
                  (let
                    [minus-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          minus-test-state
                          (CompilerIrInstr.Branch
                            minus?
                            minus-label
                            header-label))
                        minus-label)]
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            (lower-state-emit
                              minus-start
                              (CompilerIrInstr.Mov
                                negative-var
                                (CompilerIrValue.Bool true)
                                (AstType.Bool)))
                            (CompilerIrInstr.Mov
                              index-var
                              (CompilerIrValue.I64 1)
                              (AstType.I64)))
                          (CompilerIrInstr.Jump header-label))
                        header-label)]
                    (lower-inline-string-to-int-loop
                      header-start
                      ptr
                      len
                      body-label
                      apply-label
                      header-label
                      negate-label
                      done-label
                      value-var
                      index-var
                      negative-var
                      result-ty))])])])]))

(define (lower-inline-string-to-int-fields
  [state : LowerState]
  [ptr : CompilerIrValue]
  [len : CompilerIrValue]
  [result-ty : AstType]) : LowerExpr
  (match (lower-state-fresh-label state "string_to_int_sign")
    [(LowerLabel.Label sign-label-state sign-label)
      (match (lower-state-fresh-label sign-label-state "string_to_int_minus")
        [(LowerLabel.Label minus-label-state minus-label)
          (match (lower-state-fresh-label
            minus-label-state
            "string_to_int_header")
            [(LowerLabel.Label header-label-state header-label)
              (match (lower-state-fresh-label
                header-label-state
                "string_to_int_body")
                [(LowerLabel.Label body-label-state body-label)
                  (match (lower-state-fresh-label
                    body-label-state
                    "string_to_int_apply_sign")
                    [(LowerLabel.Label apply-label-state apply-label)
                      (match (lower-state-fresh-label
                        apply-label-state
                        "string_to_int_negate")
                        [(LowerLabel.Label negate-label-state negate-label)
                          (match (lower-state-fresh-label
                            negate-label-state
                            "string_to_int_done")
                            [(LowerLabel.Label done-label-state done-label)
                              (match (lower-state-alloc-var done-label-state)
                                [(LowerAlloc.Alloc value-alloc value-var)
                                  (match (lower-state-alloc-var value-alloc)
                                    [(LowerAlloc.Alloc index-alloc index-var)
                                      (match (lower-state-alloc-var index-alloc)
                                        [(LowerAlloc.Alloc
                                            negative-alloc
                                            negative-var)
                                          (match (lower-emit-binop
                                            (lower-state-emit
                                              (lower-state-emit
                                                (lower-state-emit
                                                  negative-alloc
                                                  (CompilerIrInstr.Mov
                                                    value-var
                                                    (CompilerIrValue.I64 0)
                                                    (AstType.I64)))
                                                (CompilerIrInstr.Mov
                                                  index-var
                                                  (CompilerIrValue.I64 0)
                                                  (AstType.I64)))
                                              (CompilerIrInstr.Mov
                                                negative-var
                                                (CompilerIrValue.Bool false)
                                                (AstType.Bool)))
                                            CompilerIrBinOp.Gt
                                            len
                                            (CompilerIrValue.I64 0)
                                            (AstType.I64))
                                            [(LowerExpr.Expr
                                                nonempty-state
                                                nonempty
                                                _)
                                              (lower-inline-string-to-int-sign
                                                (lower-state-finish-block
                                                  (lower-state-emit
                                                    nonempty-state
                                                    (CompilerIrInstr.Branch
                                                      nonempty
                                                      sign-label
                                                      done-label))
                                                  sign-label)
                                                ptr
                                                len
                                                minus-label
                                                header-label
                                                body-label
                                                apply-label
                                                negate-label
                                                done-label
                                                value-var
                                                index-var
                                                negative-var
                                                result-ty)])])])])])])])])])])]))

(define (lower-string-to-int-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      (match (lower-expr ctx state env type-env arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state arg-value arg-ty)
              (if (lower-string-handle-type? ctx arg-ty)
                (match (lower-string-fields arg-state arg-value)
                  [(LowerStringFields.Fields fields-state ptr len)
                    (ResultLowerExpr.Ok
                      (lower-inline-string-to-int-fields
                        fields-state
                        ptr
                        len
                        result-ty))])
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      arg
                      "lower: string->int requires String"))))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      cbi.compiler-builtin-id-tl-private-string-to-int
      "__tl_string_to_int"
      args
      result-ty
      origin)))

(define (lower-string-eq-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 2)
    (let
      [left : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      [right : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 1 0))]
      (match (lower-expr ctx state env type-env left)
        [(ResultLowerExpr.Ok lowered-left)
          (match lowered-left
            [(LowerExpr.Expr left-state left-value _)
              (match (lower-expr ctx left-state env type-env right)
                [(ResultLowerExpr.Ok lowered-right)
                  (match lowered-right
                    [(LowerExpr.Expr right-state right-value _)
                      (match (lower-string-fields right-state left-value)
                        [(LowerStringFields.Fields
                            left-fields-state
                            left-ptr
                            left-len)
                          (match (lower-string-fields
                            left-fields-state
                            right-value)
                            [(LowerStringFields.Fields
                                done-fields-state
                                right-ptr
                                right-len)
                              (ResultLowerExpr.Ok
                                (lower-inline-string-eq-fields
                                  done-fields-state
                                  left-ptr
                                  left-len
                                  right-ptr
                                  right-len
                                  result-ty))])])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      cbi.compiler-builtin-id-tl-private-string-eq
      "__tl_string_eq"
      args
      result-ty
      origin)))

(define (lower-bootstrap-runtime-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (lower-private-string-eq-helper-call-id? type-env source-id)
    (lower-string-eq-call ctx state env type-env args result-ty origin)
    (if (tc-string-to-int-helper-call-id? type-env source-id)
      (lower-string-to-int-call ctx state env type-env args result-ty origin)
      (lower-direct-call-id
        ctx
        state
        env
        type-env
        source-id
        name
        args
        result-ty
        origin))))

(define (lower-private-string-eq-helper-call-id?
  [type-env : TcTypeEnv]
  [name-id : i64]) : bool
  (and
    (cbi.compiler-builtin-typecheck-string-eq-id? name-id)
    (tc-default-builtin-unshadowed-id? type-env name-id)))

;; Lower an unshadowed `(__tl_string_ref s i)` intrinsic call to the
;; bounds-checked String byte index, like the parser-owned `AstExpr.StringRef`
;; node.
(define (lower-string-ref-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 2)
    (let
      [str : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      [index : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 1 0))]
      (lower-string-ref ctx state env type-env str index))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-module-lookup-name [ctx : TcContext] [name : String]) : String
  (let
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified? name)))
      (compiler-symbol-module-key module name)
      name)))

(define (lower-call-name-matches-nominal?
  [ctx : TcContext]
  [name : String]
  [nominal-name : String]) : bool
  (if (tc-name-qualified? name)
    (string.eq name nominal-name)
    (and
      (string.eq
        (tc-qualified-name-module nominal-name)
        (tc-context-module ctx))
      (string.eq name (tc-qualified-name-base nominal-name)))))

(define (lower-variant-constructor-lookup-name
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [result-ty : AstType]) : String
  (let
    [source-id : i64 (macro-hygiene-global-source-name-id-or name-id name-id)]
    (match (tc-type-strip-region result-ty)
      [(AstType.Enum enum-name)
        (let
          [enum-name-str : String (tc-nominal-name-id-display enum-name)]
          (if (or
            (tc-name-qualified? name)
            (string.eq
              (tc-qualified-name-module enum-name-str)
              (tc-context-module ctx)))
            (tc-source-variant-name-for-enum-id
              ctx
              enum-name-str
              name
              source-id)
            (lower-module-lookup-name ctx name)))]
      [(AstType.EnumArgs enum-name _)
        (let
          [enum-name-str : String (tc-nominal-name-id-display enum-name)]
          (if (or
            (tc-name-qualified? name)
            (string.eq
              (tc-qualified-name-module enum-name-str)
              (tc-context-module ctx)))
            (tc-source-variant-name-for-enum-id
              ctx
              enum-name-str
              name
              source-id)
            (lower-module-lookup-name ctx name)))]
      [_ ""])))

(define (lower-variant-constructor-handle-id-or
  [ctx : TcContext]
  [_ : String]
  [raw-name-id : i64]
  [result-ty : AstType]
  [fallback : i64]) : i64
  (let
    [source-name-id : i64
      (macro-hygiene-global-source-name-id-or raw-name-id raw-name-id)]
    [source-key-id : i64
      (compiler-symbol-dotted-variant-key-id-in-module-or
        source-name-id
        (tc-context-module-id ctx)
        -1)]
    [source-handle : i64
      (if (>= source-key-id 0)
        (compiler-registries-lookup-variant-key-id-or
          (tc-context-registries ctx)
          source-key-id
          fallback)
        fallback)]
    [enum-name-id : i64
      (match (tc-type-strip-region result-ty)
        [(AstType.Enum name) name]
        [(AstType.EnumArgs name _) name]
        [_ -1])]
    [variant-name-id : i64
      (if (and (>= source-name-id 0) (< source-name-id (intern-capacity)))
        (intern-dotted-final-id (tc-qualified-name-base-id source-name-id))
        -1)]
    [symbols : CompilerSymbols (tc-context-symbols ctx)]
    [direct-variant-handle : i64
      (compiler-registries-lookup-variant-id-or
        (tc-context-registries ctx)
        source-name-id
        fallback)]
    [direct-variant-owner-index : i64
      (if (compiler-symbols-handle-found? direct-variant-handle)
        (compiler-registry-handle-owner-index direct-variant-handle)
        -1)]
    [direct-variant-owner-id : i64
      (compiler-symbols-owner-id-at-index-or
        symbols
        direct-variant-owner-index
        -1)]
    [direct-variant-module-id : i64
      (compiler-symbols-owner-module-id-at-index-or
        symbols
        direct-variant-owner-index
        -1)]
    [direct-variant-owner-matches : bool
      (and
        (compiler-symbols-handle-found? direct-variant-handle)
        (or
          (= direct-variant-owner-id (compiler-symbol-name-id-key enum-name-id))
          (tc-current-module-owner-name-matches-id?
            enum-name-id
            direct-variant-owner-id))
        (if (compiler-composite-pair-key-id? enum-name-id)
          (=
            direct-variant-module-id
            (compiler-composite-pair-left-id enum-name-id))
          (if (tc-name-qualified-id? enum-name-id)
            (=
              direct-variant-module-id
              (tc-qualified-name-module-id enum-name-id))
            true)))]
    (cond
      [direct-variant-owner-matches direct-variant-handle]
      [(compiler-symbols-handle-found? source-handle) source-handle]
      [(and (>= enum-name-id 0) (>= variant-name-id 0))
        (let
          [direct-enum-handle : i64
            (compiler-symbols-lookup-type-id-or symbols enum-name-id fallback)]
          [enum-base-id : i64
            (if (>= enum-name-id 0)
              (tc-qualified-name-base-id enum-name-id)
              -1)]
          [enum-handle : i64
            (cond
              [(compiler-symbols-handle-found? direct-enum-handle)
                direct-enum-handle]
              [(>= enum-base-id 0)
                (compiler-symbols-lookup-type-id-or
                  symbols
                  (compiler-symbol-module-key-id-by-id
                    (tc-context-module-id ctx)
                    enum-base-id)
                  fallback)]
              [else fallback])]
          (if (compiler-symbols-handle-found? enum-handle)
            (let
              [enum-index : i64 (compiler-symbol-handle-index enum-handle)]
              [module-id : i64
                (compiler-symbols-owner-module-id-at-index-or
                  symbols
                  enum-index
                  (compiler-symbol-root-module-id))]
              [key-id : i64
                (compiler-symbol-module-key-id-by-id
                  module-id
                  (compiler-enum-qualified-variant-name-id
                    enum-base-id
                    variant-name-id))]
              (compiler-registries-lookup-variant-key-id-or
                (tc-context-registries ctx)
                key-id
                fallback))
            fallback))]
      [else fallback])))

(define (lower-call-non-builtin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [resolved-name-id : i64 raw-name-id]
    (if (and
      (>= resolved-name-id 0)
      (sym_i64_env.sym-i64-contains-id env resolved-name-id))
      (lower-direct-call-id
        ctx
        state
        env
        type-env
        resolved-name-id
        name
        args
        result-ty
        origin)
      (let
        [source-name : String (lower-hygiene-source-name name)]
        [callable-lookup-id : i64
          (lower-callable-lookup-id ctx raw-name-id lookup-name-id)]
        [function-value : bool
          (lower-top-level-callable-lookup-id? ctx callable-lookup-id)]
        [variant-name : String
          (lower-variant-constructor-lookup-name
            ctx
            source-name
            raw-name-id
            result-ty)]
        [struct-name : String
          (match (tc-type-strip-region result-ty)
            [(AstType.Struct resolved-struct)
              (if (lower-call-name-matches-nominal?
                ctx
                source-name
                (tc-nominal-name-id-display resolved-struct))
                (tc-nominal-name-id-display resolved-struct)
                (lower-module-lookup-name ctx source-name))]
            [(AstType.StructArgs resolved-struct _)
              (if (lower-call-name-matches-nominal?
                ctx
                source-name
                (tc-nominal-name-id-display resolved-struct))
                (tc-nominal-name-id-display resolved-struct)
                (lower-module-lookup-name ctx source-name))]
            [_ (lower-module-lookup-name ctx source-name)])]
        [variant-handle : i64
          (lower-variant-constructor-handle-id-or
            ctx
            source-name
            raw-name-id
            result-ty
            (compiler-symbols-missing-handle))]
        [struct-handle : i64
          (lower-struct-constructor-handle-id-or
            ctx
            state
            raw-name-id
            callable-lookup-id
            result-ty
            (compiler-symbols-missing-handle))]
        (if (and
          (not function-value)
          (compiler-symbols-handle-found? variant-handle))
          (lower-construct-enum-with-handle
            ctx
            state
            env
            type-env
            variant-name
            variant-handle
            args
            result-ty)
          (if (and
            (or
              (tc-constructor-name-id? ctx raw-name-id)
              (tc-constructor-name-id? ctx callable-lookup-id))
            (compiler-symbols-handle-found? struct-handle)
            (=
              (compiler-symbol-handle-kind struct-handle)
              (compiler-symbol-kind-defstruct)))
            (lower-construct-struct
              ctx
              state
              env
              type-env
              struct-name
              struct-handle
              args
              result-ty)
            (lower-direct-call-id-with-lookup-id
              ctx
              state
              env
              type-env
              raw-name-id
              callable-lookup-id
              name
              args
              result-ty
              origin)))))))

(define (lower-direct-store-target?
  [ctx : TcContext]
  [state : LowerState]
  [ty : AstType]) : bool
  (and
    (lower-mode-inline-aggregates? (lower-state-mode state))
    (lower-type-inline-struct-or-enum? ctx ty)
    (not (lower-type-register-resident? ctx ty))))

(define (lower-direct-store-result [result : ResultLowerState]) : LowerMaybeDirectStore
  (match result
    [(ResultLowerState.Ok done-state) (LowerMaybeDirectStore.Store done-state)]
    [(ResultLowerState.Err message) (LowerMaybeDirectStore.Err message)]))

(define (lower-direct-constructor-call-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [name : String]
  [raw-name-id : i64]
  [args : AstExprList]
  [result-ty : AstType]
  [_origin : AstExpr]) : LowerMaybeDirectStore
  (if (sym_i64_env.sym-i64-contains-id env raw-name-id)
    (LowerMaybeDirectStore.No)
    (let
      [source-name : String (lower-hygiene-source-name name)]
      [lookup-name-id : i64
        (match (tc-source-name-lookup-key-with-field-check-lookup
          ctx
          type-env
          name
          raw-name-id
          true)
          [(TcNameLookup.Ok _ resolved-id) resolved-id]
          [(TcNameLookup.Err _) raw-name-id])]
      [callable-lookup-id : i64
        (lower-callable-lookup-id ctx raw-name-id lookup-name-id)]
      [function-value : bool
        (lower-top-level-callable-lookup-id? ctx callable-lookup-id)]
      [variant-name : String
        (lower-variant-constructor-lookup-name
          ctx
          source-name
          raw-name-id
          result-ty)]
      [struct-name : String
        (match (tc-type-strip-region result-ty)
          [(AstType.Struct resolved-struct)
            (if (lower-call-name-matches-nominal?
              ctx
              source-name
              (tc-nominal-name-id-display resolved-struct))
              (tc-nominal-name-id-display resolved-struct)
              (lower-module-lookup-name ctx source-name))]
          [(AstType.StructArgs resolved-struct _)
            (if (lower-call-name-matches-nominal?
              ctx
              source-name
              (tc-nominal-name-id-display resolved-struct))
              (tc-nominal-name-id-display resolved-struct)
              (lower-module-lookup-name ctx source-name))]
          [_ (lower-module-lookup-name ctx source-name)])]
      [variant-handle : i64
        (lower-variant-constructor-handle-id-or
          ctx
          source-name
          raw-name-id
          result-ty
          (compiler-symbols-missing-handle))]
      [struct-handle : i64
        (lower-struct-constructor-handle-id-or
          ctx
          state
          raw-name-id
          callable-lookup-id
          result-ty
          (compiler-symbols-missing-handle))]
      (if (and
        (not function-value)
        (compiler-symbols-handle-found? variant-handle))
        (lower-direct-store-result
          (lower-construct-enum-with-handle-into
            ctx
            state
            env
            type-env
            dst
            variant-name
            variant-handle
            args
            result-ty))
        (if (and
          (or
            (tc-constructor-name-id? ctx raw-name-id)
            (tc-constructor-name-id? ctx callable-lookup-id))
          (compiler-symbols-handle-found? struct-handle)
          (=
            (compiler-symbol-handle-kind struct-handle)
            (compiler-symbol-kind-defstruct)))
          (lower-direct-store-result
            (lower-construct-struct-into
              ctx
              state
              env
              type-env
              dst
              struct-name
              struct-handle
              args
              result-ty))
          (LowerMaybeDirectStore.No))))))

(define (lower-direct-nullary-variant-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [name : String]
  [raw-name-id : i64]
  [result-ty : AstType]) : LowerMaybeDirectStore
  (if (sym_i64_env.sym-i64-contains-id env raw-name-id)
    (LowerMaybeDirectStore.No)
    (let
      [source-name : String (lower-hygiene-source-name name)]
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [function-value : bool
        (or
          (lower-top-level-callable-defined-id? ctx raw-name-id)
          (lower-symbol-function-value-id? ctx raw-name-id))]
      [variant-name : String
        (lower-variant-constructor-lookup-name
          ctx
          source-name
          raw-name-id
          result-ty)]
      [handle : i64
        (lower-variant-constructor-handle-id-or
          ctx
          source-name
          raw-name-id
          result-ty
          (compiler-symbols-missing-handle))]
      (if (and (not function-value) (compiler-symbols-handle-found? handle))
        (match (compiler-registries-variant-fields-indexed symbols handle)
          [(ResultAstTypeList.Ok fields)
            (if (ast-type-list-empty? (& fields))
              (lower-direct-store-result
                (lower-construct-enum-with-handle-into
                  ctx
                  state
                  env
                  type-env
                  dst
                  variant-name
                  handle
                  (ast-expr-list-new)
                  result-ty))
              (LowerMaybeDirectStore.No))]
          [(ResultAstTypeList.Err message)
            (LowerMaybeDirectStore.Err (box (lower-diagnostic message)))])
        (LowerMaybeDirectStore.No)))))

(define (lower-direct-init-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [maybe-ty : AstMaybeType]
  [result-ty : AstType]
  [origin : AstExpr]) : LowerMaybeDirectStore
  (match maybe-ty
    [(AstMaybeType.No)
      (lower-direct-store-result
        (lower-init-expr-into ctx state env type-env dst result-ty origin))]
    [(AstMaybeType.Some ty)
      (let
        [resolved-init : AstType
          (tc-type-without-regions (tc-resolve-type ctx ty))]
        [resolved-result : AstType
          (tc-type-without-regions (tc-resolve-type ctx result-ty))]
        (if (tc-type-eq resolved-init resolved-result)
          (lower-direct-store-result
            (lower-init-expr-into ctx state env type-env dst ty origin))
          (LowerMaybeDirectStore.No)))]))

(define (lower-direct-store-rhs-into
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [value : AstExpr]
  [result-ty : AstType]
  [origin : AstExpr]) : LowerMaybeDirectStore
  (if (lower-direct-store-target? ctx state result-ty)
    (match value
      [(AstExpr.Spanned inner-box _)
        (let
          [inner : AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-direct-store-rhs-into
            ctx
            state
            env
            type-env
            dst
            inner
            result-ty
            origin))]
      [(AstExpr.Ann inner-box _)
        (let
          [inner : AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-direct-store-rhs-into
            ctx
            state
            env
            type-env
            dst
            inner
            result-ty
            origin))]
      [(AstExpr.Init maybe-ty)
        (lower-direct-init-into
          ctx
          state
          env
          type-env
          dst
          maybe-ty
          result-ty
          origin)]
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (lower-context-expr-get ctx func-box)]
          (match (ast-expr-unspan func)
            [(AstExpr.Var name)
              (lower-direct-constructor-call-into
                ctx
                state
                env
                type-env
                dst
                (intern-str (macro-hygiene-global-source-name-id-or name name))
                name
                args
                result-ty
                origin)]
            [_ (LowerMaybeDirectStore.No)]))]
      [(AstExpr.Var name)
        (if (tc-dotted-local-field-name-id? type-env name)
          (LowerMaybeDirectStore.No)
          (lower-direct-nullary-variant-into
            ctx
            state
            env
            type-env
            dst
            (intern-str (macro-hygiene-global-source-name-id-or name name))
            name
            result-ty))]
      [_ (LowerMaybeDirectStore.No)])
    (LowerMaybeDirectStore.No)))

(define (lower-direct-store-rhs-at-offset
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [base : CompilerIrValue]
  [offset : i64]
  [value : AstExpr]
  [result-ty : AstType]
  [origin : AstExpr]) : LowerMaybeDirectStore
  (if (lower-direct-store-target? ctx state result-ty)
    (if (= offset 0)
      (lower-direct-store-rhs-into
        ctx
        state
        env
        type-env
        base
        value
        result-ty
        origin)
      (match (lower-gep-byte state base offset)
        [(LowerExpr.Expr ptr-state ptr _)
          (lower-direct-store-rhs-into
            ctx
            ptr-state
            env
            type-env
            ptr
            value
            result-ty
            origin)]))
    (LowerMaybeDirectStore.No)))

(define (lower-spmd-scalar-arg-varying?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [arg : AstExpr]) : bool
  (>
    (lower-masked-vector-expr-lanes-with-locals
      ctx
      (CompilerLowerMode.Avx512)
      env
      type-env
      index
      (lower-masked-vector-empty-lane-locals)
      arg)
    0))

(define (lower-spmd-call-args-from-values
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [args : AstExprList]
  [params : AstParamList]
  [values : CompilerIrValueList]) : CompilerIrSpmdCallArgList
  (lower-spmd-call-args-from-values-at
    ctx
    env
    type-env
    index
    (& args)
    (& params)
    (compiler-ir-value-list-force-cons values)
    0))

(define (lower-spmd-call-args-from-values-at
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [args : (& args AstExprList)]
  [params : (& params AstParamList)]
  [values : CompilerIrValueList]
  [arg-index : i64]) : CompilerIrSpmdCallArgList
  (if (or
    (>= arg-index (struct-get args len))
    (>= arg-index (ast-param-list-len params)))
    CompilerIrSpmdCallArgList.Nil
    (match values
      [(CompilerIrValueList.Array seq)
        (lower-spmd-call-args-from-values-at
          ctx
          env
          type-env
          index
          args
          params
          (compiler-ir-value-seq-to-list seq)
          arg-index)]
      [(CompilerIrValueList.Cons value rest)
        (match (ast-param-list-get params arg-index (ast-param-fallback))
          [(AstParam.Param _ param-ty _ _)
            (let
              [resolved-ty : AstType
                (tc-type-without-regions (tc-resolve-type ctx param-ty))]
              [arg : AstExpr
                (lower-context-expr-get
                  ctx
                  (ast-expr-list-get args arg-index 0))]
              [varying : bool
                (lower-spmd-scalar-arg-varying? ctx env type-env index arg)]
              (ir-spmd-call-arg-cons
                (CompilerIrSpmdCallArg.Arg
                  (lower-spmd-ir-value-class resolved-ty varying)
                  value
                  resolved-ty)
                (lower-spmd-call-args-from-values-at
                  ctx
                  env
                  type-env
                  index
                  args
                  params
                  (box-get rest)
                  (+ arg-index 1))))])]
      [(CompilerIrValueList.Nil) CompilerIrSpmdCallArgList.Nil])))

(define (lower-imported-spmd-scalar-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [canonical-name : i64]
  [fn-ty : AstType]
  [callables : AstImportedSpmdCallableList]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : LowerMaybeSpmdCall
  (match fn-ty
    [(AstType.Func param-types ret-id)
      (let
        [params : AstParamList
          (lower-imported-spmd-params ctx (box-get param-types))]
        [ret : AstType (tc-context-type-get ctx ret-id)]
        (if (<=
          (lower-spmd-call-args-lanes
            ctx
            (CompilerLowerMode.Avx512)
            env
            type-env
            index
            (lower-masked-vector-empty-lane-locals)
            args)
          0)
          (LowerMaybeSpmdCall.No)
          (match (lower-call-args-as-needed
            ctx
            state
            env
            type-env
            args
            (tc-param-type-list ctx params))
            [(ResultLowerCallArgs.Err message) (LowerMaybeSpmdCall.Err message)]
            [(ResultLowerCallArgs.Ok args-state values writebacks)
              (let
                [call-args : CompilerIrSpmdCallArgList
                  (lower-spmd-call-args-from-values
                    ctx
                    env
                    type-env
                    index
                    args
                    params
                    values)]
                [args-code : String
                  (lower-imported-spmd-call-args-code call-args)]
                [signature : String (lower-spmd-source-signature params ret)]
                [requested-index-param : i64
                  (lower-imported-spmd-index-param ctx index args)]
                (match (lower-imported-spmd-select
                  canonical-name
                  (& callables)
                  signature
                  (CompilerIrSpmdBackend.Scalar)
                  1
                  args-code
                  requested-index-param
                  ret
                  origin)
                  [(ResultLowerImportedSpmdSpecialization.Err message)
                    (LowerMaybeSpmdCall.Err message)]
                  [(ResultLowerImportedSpmdSpecialization.Ok specialization)
                    (match (lower-avx512-emit-spmd-call
                      args-state
                      (lower-imported-spmd-ir-symbol specialization)
                      (CompilerIrSpmdBackend.Scalar)
                      (CompilerIrValue.Bool true)
                      1
                      call-args
                      result-ty
                      (lower-imported-spmd-result-varying? specialization)
                      origin)
                      [(ResultLowerExpr.Err message)
                        (LowerMaybeSpmdCall.Err message)]
                      [(ResultLowerExpr.Ok lowered)
                        (match lowered
                          [(LowerExpr.Expr call-state value ty)
                            (LowerMaybeSpmdCall.Some
                              (LowerExpr.Expr
                                (lower-apply-arg-writebacks
                                  ctx
                                  call-state
                                  writebacks)
                                value
                                ty))])])]))])))]
    [_
      (LowerMaybeSpmdCall.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: imported SPMD helper does not have function type")))]))

(define (lower-spmd-scalar-call-maybe
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : LowerMaybeSpmdCall
  (match lower-spmd-scalar-call-context
    [(LowerSpmdScalarCallContext.No) (LowerMaybeSpmdCall.No)]
    [(LowerSpmdScalarCallContext.Some index)
      (match (lower-spmd-inline-helper-lookup
        ctx
        env
        type-env
        LowerIdSet.Nil
        func)
        [(ResultLowerSpmdInlineHelper.Ok helper)
          (match helper
            [(LowerSpmdInlineHelper.Some _ params ret body)
              (if (and
                (lower-spmd-helper-out-of-line? ctx body)
                (>
                  (lower-spmd-call-args-lanes
                    ctx
                    (CompilerLowerMode.Avx512)
                    env
                    type-env
                    index
                    (lower-masked-vector-empty-lane-locals)
                    args)
                  0))
                (match (lower-call-args-as-needed
                  ctx
                  state
                  env
                  type-env
                  args
                  (tc-param-type-list ctx params))
                  [(ResultLowerCallArgs.Ok args-state values writebacks)
                    (match (lower-state-fresh-lambda-name args-state)
                      [(LowerLambdaName.Name named-state hidden-name)
                        (let
                          [call-args : CompilerIrSpmdCallArgList
                            (lower-spmd-call-args-from-values
                              ctx
                              env
                              type-env
                              index
                              args
                              params
                              values)]
                          (match (lower-spmd-specialized-helper-function
                            ctx
                            type-env
                            (lower-state-type-cache named-state)
                            hidden-name
                            params
                            ret
                            false
                            body
                            (CompilerIrSpmdBackend.Scalar)
                            call-args
                            1
                            ""
                            -1
                            (lower-state-spans named-state)
                            (lower-state-names named-state)
                            (lower-state-mode named-state))
                            [(ResultLowerFunction.Ok functions helper-spans)
                              (match (lower-avx512-emit-spmd-call
                                (lower-state-add-functions
                                  named-state
                                  functions
                                  helper-spans)
                                hidden-name
                                (CompilerIrSpmdBackend.Scalar)
                                (CompilerIrValue.Bool true)
                                1
                                call-args
                                result-ty
                                (>
                                  (lower-spmd-direct-call-result-lanes
                                    ctx
                                    (CompilerLowerMode.Avx512)
                                    env
                                    type-env
                                    index
                                    (lower-masked-vector-empty-lane-locals)
                                    func
                                    args)
                                  0)
                                origin)
                                [(ResultLowerExpr.Ok lowered)
                                  (match lowered
                                    [(LowerExpr.Expr call-state value ty)
                                      (LowerMaybeSpmdCall.Some
                                        (LowerExpr.Expr
                                          (lower-apply-arg-writebacks
                                            ctx
                                            call-state
                                            writebacks)
                                          value
                                          ty))])]
                                [(ResultLowerExpr.Err message)
                                  (LowerMaybeSpmdCall.Err message)])]
                            [(ResultLowerFunction.Err message)
                              (LowerMaybeSpmdCall.Err message)]))])]
                  [(ResultLowerCallArgs.Err message)
                    (LowerMaybeSpmdCall.Err message)])
                (LowerMaybeSpmdCall.No))]
            [(LowerSpmdInlineHelper.Imported canonical-name fn-ty callables)
              (lower-imported-spmd-scalar-call
                ctx
                state
                env
                type-env
                index
                canonical-name
                fn-ty
                (box-get callables)
                args
                result-ty
                origin)]
            [(LowerSpmdInlineHelper.No) (LowerMaybeSpmdCall.No)])]
        [(ResultLowerSpmdInlineHelper.Err message)
          (LowerMaybeSpmdCall.Err message)])]))

(define (lower-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (ast-expr-unspan func)
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            (match (tc-lambda-expr-allow-ref-captures
              ctx
              type-env
              params
              maybe-ret
              body)
              [(ResultTcType.Ok fn-ty)
                (match (lower-lambda
                  ctx
                  state
                  env
                  type-env
                  params
                  maybe-ret
                  body
                  func
                  fn-ty)
                  [(ResultLowerExpr.Ok lowered-func)
                    (match lowered-func
                      [(LowerExpr.Expr func-state func-value _)
                        (lower-indirect-call
                          ctx
                          func-state
                          env
                          type-env
                          fn-ty
                          func-value
                          args
                          result-ty
                          origin)])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
              [(ResultTcType.Err message)
                (ResultLowerExpr.Err
                  (box (lower-diagnostic-at-expr func message)))]))])]
    [(AstExpr.Var raw-name)
      ;; Builtins reached from a macro expansion arrive hygiene-renamed
      ;; (`__tl_macro_global$string.string-length`); strip the prefix so the builtin
      ;; dispatch below (length/string-length inline loads, etc.) fires just as it
      ;; does for hand-written calls. `raw-name` still keys the local-variable
      ;; lookup, and the generic call path strips the prefix itself.
      (let
        [raw-text : String
          (if (or
            (macro-hygiene-global-id? raw-name)
            (macro-hygiene-local-id? raw-name))
            (intern-str (macro-hygiene-structural-source-name-id raw-name))
            (tc-env-key-name-text raw-name))]
        (if (tc-dotted-local-field-name-id? type-env raw-name)
          (match (lower-expr ctx state env type-env func)
            [(ResultLowerExpr.Ok lowered-func)
              (match lowered-func
                [(LowerExpr.Expr func-state func-value func-ty)
                  (if (lower-function-type? func-ty)
                    (if (tc-expr-c-abi-fnptr? ctx type-env func)
                      (lower-indirect-c-abi-call
                        ctx
                        func-state
                        env
                        type-env
                        func-ty
                        func-value
                        args
                        result-ty
                        origin)
                      (lower-indirect-call
                        ctx
                        func-state
                        env
                        type-env
                        func-ty
                        func-value
                        args
                        result-ty
                        origin))
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          func
                          "lower: call target is not a function"))))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
          (let
            [local-id : i64
              (sym_i64_env.sym-i64-lookup-id-or
                env
                raw-name
                (compiler-symbols-missing-handle))]
            (if (compiler-symbols-handle-found? local-id)
              (match (tc-lookup-id type-env raw-name)
                [(ResultTcType.Ok fn-ty)
                  (if (lower-function-type? fn-ty)
                    (if (tc-binding-c-abi-fnptr-id? type-env raw-name)
                      (lower-indirect-c-abi-call
                        ctx
                        state
                        env
                        type-env
                        fn-ty
                        (CompilerIrValue.Var local-id)
                        args
                        result-ty
                        origin)
                      (lower-indirect-call
                        ctx
                        state
                        env
                        type-env
                        fn-ty
                        (CompilerIrValue.Var local-id)
                        args
                        result-ty
                        origin))
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          func
                          "lower: call target is not a function"))))]
                [(ResultTcType.Err message)
                  (ResultLowerExpr.Err
                    (box (lower-diagnostic-at-expr func message)))])
              (let
                [hygiene-global : bool
                  (or
                    (macro-hygiene-global-id? raw-name)
                    (tc-hygiene-global-name? raw-text))]
                (match (if hygiene-global
                  (match (tc-source-name-lookup-key-with-field-check-lookup
                    ctx
                    type-env
                    raw-text
                    raw-name
                    true)
                    [(TcNameLookup.Ok _ resolved-id)
                      (TcNameLookup.Ok
                        (tc-hygiene-global-call-name raw-text)
                        resolved-id)]
                    [(TcNameLookup.Err _)
                      (TcNameLookup.Ok
                        (tc-hygiene-global-call-name raw-text)
                        raw-name)])
                  (if (tc-source-slash-qualified-id? raw-text raw-name)
                    (TcNameLookup.Ok raw-text raw-name)
                    (tc-source-name-lookup-key-with-field-check-lookup
                      ctx
                      type-env
                      raw-text
                      raw-name
                      true)))
                  [(TcNameLookup.Ok name lookup-name-id)
                    ;; `array-length`/`length` on a dynamic array and private
                    ;; string intrinsics load fat-value fields directly instead of
                    ;; calling runtime symbols. Other `length` argument types keep
                    ;; the ordinary direct-call path.
                    (let
                      [source-id : i64
                        (if hygiene-global
                          (macro-hygiene-global-source-name-id-or
                            raw-name
                            raw-name)
                          raw-name)]
                      [source-key-id : i64 (tc-env-name-key-id source-id)]
                      [lowered-name : String
                        (if hygiene-global
                          (match (lower-name-cache-lookup-id
                            (lower-state-names state)
                            source-key-id)
                            [(TcMaybeString.Some logical-name) logical-name]
                            [(TcMaybeString.No)
                              (lower-hygiene-source-name-in-context-id
                                ctx
                                type-env
                                raw-name)])
                          name)]
                      [name-id : i64 source-key-id]
                      [builtin-available : bool
                        (not (lower-top-level-value-defined-id? ctx name-id))]
                      [atomic-symbol : String
                        (lower-atomic-extern-symbol-for-name-id
                          ctx
                          name
                          lookup-name-id)]
                      (cond
                        [(> (string.string-length atomic-symbol) 0)
                          (lower-atomic-call
                            ctx
                            state
                            env
                            type-env
                            atomic-symbol
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (lower-atomic-pointer-name? name))
                          (lower-atomic-pointer-call
                            ctx
                            state
                            env
                            type-env
                            name
                            args
                            result-ty
                            origin)]
                        [(and builtin-available (tc-layout-query-name? name))
                          (ResultLowerExpr.Err
                            (box
                              (lower-diagnostic-at-expr
                                origin
                                (string.append
                                  "lower: "
                                  (string.append
                                    name
                                    " is compile-time only; wrap it in (comptime ...)")))))]
                        [(tc-string-ref-helper-call-id?
                            ctx
                            type-env
                            source-id
                            name-id)
                          (lower-string-ref-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(tc-string-length-helper-call-id?
                            ctx
                            type-env
                            source-id
                            name-id)
                          (lower-array-length
                            ctx
                            state
                            env
                            type-env
                            cbi.compiler-builtin-id-tl-private-string-length
                            "__tl_string_length"
                            args
                            result-ty
                            origin)]
                        [(lower-private-string-eq-helper-call-id?
                            type-env
                            name-id)
                          (lower-string-eq-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(tc-string-to-int-helper-call-id? type-env name-id)
                          (lower-string-to-int-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(or
                            (lower-string-concat-public-target? name)
                            (and
                              builtin-available
                              (lower-string-concat-legacy-name? name)))
                          (lower-string-concat-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-string-ref-call-id?
                              name-id))
                          (lower-string-ref-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-length-call-id? name-id))
                          (lower-array-length
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (lower-string-runtime-builtin? name))
                          (lower-string-runtime-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-cpuid-id? name-id))
                          (lower-cpuid-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-xgetbv-id? name-id))
                          (lower-xgetbv-call ctx state env type-env args origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-clone-id? name-id))
                          (if (= (struct-get (& args) len) 1)
                            (lower-clone-call
                              ctx
                              state
                              env
                              type-env
                              (lower-context-expr-get
                                ctx
                                (ast-expr-list-get (& args) 0 0)))
                            (ResultLowerExpr.Err
                              (box
                                (lower-diagnostic
                                  "lower: clone expects one argument"))))]
                        [(and
                            builtin-available
                            (lower-arena-builtin-id? name-id))
                          (lower-arena-builtin-call
                            ctx
                            state
                            env
                            type-env
                            name-id
                            args
                            result-ty)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-float-sqrt-id? name-id))
                          (lower-float-sqrt-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-float-bitcast-id?
                              name-id))
                          (lower-float-bitcast-call
                            ctx
                            state
                            env
                            type-env
                            args
                            result-ty
                            origin)]
                        [(and
                            builtin-available
                            (cbi.compiler-builtin-lower-tls-current-arena-id?
                              name-id))
                          (lower-tls-current-arena-call
                            ctx
                            state
                            env
                            type-env
                            name-id
                            args
                            result-ty)]
                        [(and
                            builtin-available
                            (lower-bootstrap-runtime-builtin-id? name-id))
                          (lower-bootstrap-runtime-call
                            ctx
                            state
                            env
                            type-env
                            source-id
                            name
                            args
                            result-ty
                            origin)]
                        [(lower-comptime-error-source-or-lookup-id?
                            source-id
                            name-id)
                          (ResultLowerExpr.Err
                            (box
                              (lower-diagnostic-at-expr
                                origin
                                "lower: comptime-error is compile-time only")))]
                        [else
                          (match (lower-spmd-scalar-call-maybe
                            ctx
                            state
                            env
                            type-env
                            func
                            args
                            result-ty
                            origin)
                            [(LowerMaybeSpmdCall.Some lowered)
                              (ResultLowerExpr.Ok lowered)]
                            [(LowerMaybeSpmdCall.Err message)
                              (ResultLowerExpr.Err message)]
                            [(LowerMaybeSpmdCall.No)
                              (lower-call-non-builtin
                                ctx
                                state
                                env
                                type-env
                                lowered-name
                                raw-name
                                lookup-name-id
                                args
                                result-ty
                                origin)])]))]
                  [(TcNameLookup.Err message)
                    (ResultLowerExpr.Err
                      (box (lower-diagnostic-at-expr origin message)))]))))))]
    [_
      (match (lower-expr ctx state env type-env func)
        [(ResultLowerExpr.Ok lowered-func)
          (match lowered-func
            [(LowerExpr.Expr func-state func-value func-ty)
              (if (lower-function-type? func-ty)
                (if (tc-expr-c-abi-fnptr? ctx type-env func)
                  (lower-indirect-c-abi-call
                    ctx
                    func-state
                    env
                    type-env
                    func-ty
                    func-value
                    args
                    result-ty
                    origin)
                  (lower-indirect-call
                    ctx
                    func-state
                    env
                    type-env
                    func-ty
                    func-value
                    args
                    result-ty
                    origin))
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic-at-expr
                      func
                      "lower: call target is not a function"))))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]))

;; A dynamic-array value is a pointer to inline fat storage `{data_ptr, length}`
;; with the i64 length at byte offset 8. `Gep` scales the index by the element
;; size, so index 1 with element type i64 addresses that length field, which a
;; typed `Load` then reads. Dynamic-array calls plus core/private string-length
;; calls are intercepted; other `length` arguments fall back to a direct call.
(define (lower-array-length
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (let
      [arr : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      (match (lower-expr-result-type-fast
        ctx
        env
        type-env
        (lower-state-type-cache state)
        arr)
        [(ResultTcType.Ok arr-ty)
          (lower-array-length-with-type
            ctx
            state
            env
            type-env
            source-id
            name
            args
            result-ty
            origin
            arr
            arr-ty)]
        [(ResultTcType.Err _)
          (match (tc-expr ctx type-env arr)
            [(ResultTcType.Ok arr-ty)
              (lower-array-length-with-type
                ctx
                state
                env
                type-env
                source-id
                name
                args
                result-ty
                origin
                arr
                arr-ty)]
            [(ResultTcType.Err _)
              (lower-direct-call-id
                ctx
                state
                env
                type-env
                source-id
                name
                args
                result-ty
                origin)])]))
    (lower-direct-call-id
      ctx
      state
      env
      type-env
      source-id
      name
      args
      result-ty
      origin)))

(define (lower-array-length-with-type
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [source-id : i64]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]
  [arr : AstExpr]
  [arr-ty : AstType]) : ResultLowerExpr
  (match (tc-array-length-receiver ctx arr-ty)
    [(ResultTcArrayReceiver.Ok _)
      (lower-array-length-load ctx state env type-env arr)]
    [(ResultTcArrayReceiver.Err _)
      (if (and
        (cbi.compiler-builtin-lower-string-length-load-id? source-id)
        (lower-length-handle-type? ctx arr-ty))
        (lower-array-length-load ctx state env type-env arr)
        (lower-direct-call-id
          ctx
          state
          env
          type-env
          source-id
          name
          args
          result-ty
          origin))]))

(define (lower-array-length-load
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr arr-state arr-value _)
          (match (lower-state-alloc-var arr-state)
            [(LowerAlloc.Alloc gep-alloc gep-var)
              (let
                [gep-state : LowerState
                  (lower-state-emit
                    gep-alloc
                    (CompilerIrInstr.Gep
                      gep-var
                      arr-value
                      (CompilerIrValue.I64 1)
                      (AstType.I64)))]
                (match (lower-state-alloc-var gep-state)
                  [(LowerAlloc.Alloc load-alloc load-var)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr
                        (lower-state-emit
                          load-alloc
                          (CompilerIrInstr.Load
                            load-var
                            (CompilerIrValue.Var gep-var)
                            (AstType.I64)))
                        (CompilerIrValue.Var load-var)
                        (AstType.I64)))]))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-string-data
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [str : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env str)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr str-state str-value _)
          (match (lower-load-at-offset str-state str-value 0 result-ty)
            [(LowerExpr.Expr data-state data-value _)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr data-state data-value result-ty))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-array-data
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [array : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env array)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr array-state array-value array-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
            [(AstType.DynArray _)
              (match (lower-load-at-offset array-state array-value 0 result-ty)
                [(LowerExpr.Expr data-state data-value _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr data-state data-value result-ty))])]
            [(AstType.Array _ _)
              (ResultLowerExpr.Ok
                (lower-cast-value array-state array-value array-ty result-ty))]
            [_
              (ResultLowerExpr.Err
                (box (lower-diagnostic "lower: array-data requires array")))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-string-from-bytes
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [ptr : AstExpr]
  [len : AstExpr]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env ptr)
    [(ResultLowerExpr.Ok ptr-lowered)
      (match ptr-lowered
        [(LowerExpr.Expr ptr-state ptr-value ptr-ty)
          (match (lower-integer-expr-with-expected-or-actual
            ctx
            ptr-state
            env
            type-env
            len
            (AstType.I64)
            "lower: string-from-bytes length must be integer")
            [(ResultLowerExpr.Ok len-lowered)
              (match len-lowered
                [(LowerExpr.Expr len-state len-value len-ty)
                  (match (lower-cast-value
                    len-state
                    len-value
                    len-ty
                    (AstType.I64))
                    [(LowerExpr.Expr len-i-state len-i-value _)
                      (match (lower-reserve-heap-storage
                        len-i-state
                        16
                        (AstType.String))
                        [(LowerExpr.Expr base-state base-value _)
                          (let
                            [with-ptr : LowerState
                              (lower-store-at-offset
                                base-state
                                base-value
                                0
                                ptr-value
                                (lower-raw-pointer-ir-type ptr-ty))]
                            [with-len : LowerState
                              (lower-store-at-offset
                                with-ptr
                                base-value
                                8
                                len-i-value
                                (AstType.I64))]
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                with-len
                                base-value
                                (AstType.String))))])])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-entry-load
  [state : LowerState]
  [kind : i64]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (let
        [instr : CompilerIrInstr
          (if (= kind 0)
            (CompilerIrInstr.EntryArgc var-id)
            (if (= kind 1)
              (CompilerIrInstr.EntryArgv var-id)
              (CompilerIrInstr.EntryEnvp var-id)))]
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit allocated instr)
            (CompilerIrValue.Var var-id)
            result-ty)))]))

(define (lower-cpuid-like
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [leaf : AstExpr]
  [subleaf : AstExpr]
  [reg-index : i64]) : ResultLowerExpr
  (match (lower-integer-expr-with-expected-or-actual
    ctx
    state
    env
    type-env
    leaf
    (AstType.I64)
    "lower: cpuid leaf must be integer")
    [(ResultLowerExpr.Ok leaf-lowered)
      (match leaf-lowered
        [(LowerExpr.Expr leaf-state leaf-value leaf-ty)
          (match (lower-cast-value leaf-state leaf-value leaf-ty (AstType.I64))
            [(LowerExpr.Expr leaf-i-state leaf-i-value _)
              (match (lower-integer-expr-with-expected-or-actual
                ctx
                leaf-i-state
                env
                type-env
                subleaf
                (AstType.I64)
                "lower: cpuid subleaf must be integer")
                [(ResultLowerExpr.Ok subleaf-lowered)
                  (match subleaf-lowered
                    [(LowerExpr.Expr subleaf-state subleaf-value subleaf-ty)
                      (match (lower-cast-value
                        subleaf-state
                        subleaf-value
                        subleaf-ty
                        (AstType.I64))
                        [(LowerExpr.Expr subleaf-i-state subleaf-i-value _)
                          (match (lower-state-alloc-var subleaf-i-state)
                            [(LowerAlloc.Alloc allocated var-id)
                              (ResultLowerExpr.Ok
                                (LowerExpr.Expr
                                  (lower-state-emit
                                    allocated
                                    (CompilerIrInstr.CpuId
                                      var-id
                                      leaf-i-value
                                      subleaf-i-value
                                      reg-index))
                                  (CompilerIrValue.Var var-id)
                                  (AstType.I64)))])])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-xgetbv
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : AstExpr]) : ResultLowerExpr
  (match (lower-integer-expr-with-expected-or-actual
    ctx
    state
    env
    type-env
    index
    (AstType.I64)
    "lower: xgetbv index must be integer")
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr index-state index-value index-ty)
          (match (lower-cast-value
            index-state
            index-value
            index-ty
            (AstType.I64))
            [(LowerExpr.Expr index-i-state index-i-value _)
              (match (lower-state-alloc-var index-i-state)
                [(LowerAlloc.Alloc allocated var-id)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-state-emit
                        allocated
                        (CompilerIrInstr.Xgetbv var-id index-i-value))
                      (CompilerIrValue.Var var-id)
                      (AstType.I64)))])])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-cpuid-store-field
  [state : LowerState]
  [base : CompilerIrValue]
  [leaf : CompilerIrValue]
  [subleaf : CompilerIrValue]
  [reg-index : i64]
  [offset : i64]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (lower-store-at-offset
        (lower-state-emit
          allocated
          (CompilerIrInstr.CpuId var-id leaf subleaf reg-index))
        base
        offset
        (CompilerIrValue.Var var-id)
        (AstType.I32))]))

(define (lower-cpuid-tuple-values
  [ctx : TcContext]
  [state : LowerState]
  [leaf : CompilerIrValue]
  [subleaf : CompilerIrValue]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-resolve-type ctx result-ty)
    [(AstType.Tuple elem-tys)
      (match (lower-reserve-heap-storage
        state
        (lower-type-list-storage-size ctx (box-get elem-tys))
        result-ty)
        [(LowerExpr.Expr base-state base _)
          (let
            [eax-state : LowerState
              (lower-cpuid-store-field base-state base leaf subleaf 0 0)]
            [ebx-state : LowerState
              (lower-cpuid-store-field eax-state base leaf subleaf 1 4)]
            [ecx-state : LowerState
              (lower-cpuid-store-field ebx-state base leaf subleaf 2 8)]
            [edx-state : LowerState
              (lower-cpuid-store-field ecx-state base leaf subleaf 3 12)]
            (ResultLowerExpr.Ok (LowerExpr.Expr edx-state base result-ty)))])]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr origin "lower: cpuid requires tuple result")))]))

(define (lower-cpuid-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 2)
    (let
      [leaf : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      [subleaf : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 1 0))]
      (match (lower-integer-expr-with-expected-or-actual
        ctx
        state
        env
        type-env
        leaf
        (AstType.I64)
        "lower: cpuid leaf must be integer")
        [(ResultLowerExpr.Ok leaf-lowered)
          (match leaf-lowered
            [(LowerExpr.Expr leaf-state leaf-value leaf-ty)
              (match (lower-cast-value
                leaf-state
                leaf-value
                leaf-ty
                (AstType.I64))
                [(LowerExpr.Expr leaf-i-state leaf-i-value _)
                  (match (lower-integer-expr-with-expected-or-actual
                    ctx
                    leaf-i-state
                    env
                    type-env
                    subleaf
                    (AstType.I64)
                    "lower: cpuid subleaf must be integer")
                    [(ResultLowerExpr.Ok subleaf-lowered)
                      (match subleaf-lowered
                        [(LowerExpr.Expr subleaf-state subleaf-value subleaf-ty)
                          (match (lower-cast-value
                            subleaf-state
                            subleaf-value
                            subleaf-ty
                            (AstType.I64))
                            [(LowerExpr.Expr subleaf-i-state subleaf-i-value _)
                              (lower-cpuid-tuple-values
                                ctx
                                subleaf-i-state
                                leaf-i-value
                                subleaf-i-value
                                result-ty
                                origin)])])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box (lower-diagnostic "lower: cpuid expects two arguments")))))

(define (lower-xgetbv-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]
  [origin : AstExpr]) : ResultLowerExpr
  (if (= (struct-get (& args) len) 1)
    (lower-xgetbv
      ctx
      state
      env
      type-env
      (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0)))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic-at-expr origin "lower: xgetbv expects one argument")))))

;; Small emit helpers: allocate a fresh var, emit one instruction, and return a
;; `LowerExpr` carrying the updated state plus the result value. These flatten
;; the otherwise deeply-nested alloc/emit chains in the array-access lowering.
(define (lower-emit-cast
  [state : LowerState]
  [value : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.Cast v value from-ty to-ty))
        (CompilerIrValue.Var v)
        to-ty)]))

(define (lower-emit-gep
  [state : LowerState]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [gep-ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.Gep v base index gep-ty))
        (CompilerIrValue.Var v)
        gep-ty)]))

(define (lower-emit-load
  [state : LowerState]
  [addr : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.Load v addr ty))
        (CompilerIrValue.Var v)
        ty)]))

(define (lower-emit-binop
  [state : LowerState]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (CompilerIrInstr.BinOp v op lhs rhs ty))
        (CompilerIrValue.Var v)
        (compiler-ir-binop-result-type op ty))]))

(define (lower-emit-bounds-check
  [state : LowerState]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : LowerState
  (match (lower-state-fresh-label state "bounds_ok")
    [(LowerLabel.Label bounds-ok-state bounds-ok-label)
      (lower-state-emit
        bounds-ok-state
        (CompilerIrInstr.BoundsCheck index length bounds-ok-label))]))

;; Address an array element, striding by the element's full inline
;; size. Memory aggregates use a byte-offset GEP so fixed arrays, structs, and
;; enums use their real layout size instead of an address-sized backend scale.
;; Scalars and pointer-slot handles keep the type-scaled GEP.
(define (lower-emit-elem-addr-gep
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [idx-off : CompilerIrValue]
  [elem-ty : AstType]) : LowerExpr
  (if (lower-type-inline-storage? ctx elem-ty)
    (match (lower-emit-binop
      state
      CompilerIrBinOp.Mul
      idx-off
      (CompilerIrValue.I64 (lower-type-size ctx elem-ty))
      (AstType.I64))
      [(LowerExpr.Expr mul-state byte-off _)
        (lower-emit-gep mul-state base byte-off (AstType.U8))])
    (lower-emit-gep state base idx-off elem-ty)))

;; Tail of `lower-array-element-addr`: after the explicit bounds check, load the
;; buffer pointer (fat offset 0, a raw U64 address) and Gep it by the index to
;; the element address (striding by the real inline element size).
(define (lower-array-element-addr-finish
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [idx-off : CompilerIrValue]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-emit-gep state arr-value (CompilerIrValue.I64 0) (AstType.I64))
    [(LowerExpr.Expr buf-gep-state buf-gep _)
      (match (lower-emit-load buf-gep-state buf-gep (AstType.U64))
        [(LowerExpr.Expr buf-state buf-val _)
          (lower-emit-elem-addr-gep ctx buf-state buf-val idx-off elem-ty)])]))

;; Compute the address of element `idx-value` in dynamic array `arr-value`,
;; emitting an unsigned bounds check (negative indices wrap large and also
;; fail). Returns the element pointer as an `elem-ty`-typed value.
(define (lower-array-element-addr
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [idx-value : CompilerIrValue]
  [idx-ty : AstType]
  [elem-ty : AstType]) : LowerExpr
  (match (lower-emit-cast state idx-value idx-ty (AstType.U64))
    [(LowerExpr.Expr s1 idx-u _)
      (match (lower-emit-cast s1 idx-value idx-ty (AstType.I64))
        [(LowerExpr.Expr s2 idx-off _)
          (match (lower-emit-gep
            s2
            arr-value
            (CompilerIrValue.I64 1)
            (AstType.I64))
            [(LowerExpr.Expr s3 len-gep _)
              (match (lower-emit-load s3 len-gep (AstType.I64))
                [(LowerExpr.Expr s4 len-val _)
                  (match (lower-emit-cast
                    s4
                    len-val
                    (AstType.I64)
                    (AstType.U64))
                    [(LowerExpr.Expr s5 len-u _)
                      (lower-array-element-addr-finish
                        ctx
                        (lower-emit-bounds-check s5 idx-u len-u)
                        arr-value
                        idx-off
                        elem-ty)])])])])]))

(define (lower-atomic-elem-type [symbol : String]) : AstType
  (if (or
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add"))
    (AstType.I32)
    (AstType.I64)))

(define (lower-atomic-raw-symbol [symbol : String]) : i64
  (lower-derived-symbol-id
    (cond
      [(string.eq symbol "tl_atomic_i64_load") "tl_atomic_i64_load_ptr"]
      [(string.eq symbol "tl_atomic_i64_store") "tl_atomic_i64_store_ptr"]
      [(string.eq symbol "tl_atomic_i64_add") "tl_atomic_i64_add_ptr"]
      [(string.eq symbol "tl_atomic_i64_fetch_add")
        "tl_atomic_i64_fetch_add_ptr"]
      [(string.eq symbol "tl_atomic_i32_load") "tl_atomic_i32_load_ptr"]
      [(string.eq symbol "tl_atomic_i32_store") "tl_atomic_i32_store_ptr"]
      [(string.eq symbol "tl_atomic_i32_add") "tl_atomic_i32_add_ptr"]
      [else "tl_atomic_i32_fetch_add_ptr"])))

(define (lower-atomic-pointer-name? [name : String]) : bool
  (or
    (string.eq name "atomic-load")
    (string.eq name "atomic-store!")
    (string.eq name "atomic-add!")
    (string.eq name "atomic-fetch-add!")
    (string.eq name "atomic-cas!")
    (string.eq name "volatile-load")
    (string.eq name "volatile-store!")))

(define (lower-atomic-pointer-func? [type-env : TcTypeEnv] [func : AstExpr]) : bool
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [name-id : i64
          (macro-hygiene-global-source-name-id-or raw-name raw-name)]
        [name : String (tc-env-key-name-text name-id)]
        (and
          (lower-atomic-pointer-name? name)
          (not (tc-name-bound-id? type-env name-id))))]
    [_ false]))

(define (lower-atomic-pointer-load-name? [name : String]) : bool
  (or (string.eq name "atomic-load") (string.eq name "volatile-load")))

(define (lower-atomic-pointer-cas-name? [name : String]) : bool
  (string.eq name "atomic-cas!"))

(define (lower-atomic-pointer-volatile-name? [name : String]) : bool
  (or (string.eq name "volatile-load") (string.eq name "volatile-store!")))

(define (lower-atomic-pointer-width-prefix [name : String] [elem-ty : AstType]) : String
  (match (tc-type-strip-region elem-ty)
    [(AstType.I32)
      (if (lower-atomic-pointer-volatile-name? name)
        "tl_volatile_i32_"
        "tl_atomic_i32_")]
    [(AstType.U32)
      (if (lower-atomic-pointer-volatile-name? name)
        "tl_volatile_i32_"
        "tl_atomic_i32_")]
    [_
      (if (lower-atomic-pointer-volatile-name? name)
        "tl_volatile_i64_"
        "tl_atomic_i64_")]))

(define (lower-atomic-pointer-op-suffix [name : String]) : String
  (cond
    [(string.eq name "atomic-load") "load_ptr"]
    [(string.eq name "atomic-store!") "store_ptr"]
    [(string.eq name "atomic-add!") "add_ptr"]
    [(string.eq name "atomic-fetch-add!") "fetch_add_ptr"]
    [(string.eq name "volatile-load") "load_ptr"]
    [(string.eq name "volatile-store!") "store_ptr"]
    [else "cas_ptr"]))

(define (lower-atomic-pointer-raw-symbol [name : String] [elem-ty : AstType]) : i64
  (lower-derived-symbol-id
    (str_cat.str-cat
      (lower-atomic-pointer-width-prefix name elem-ty)
      (lower-atomic-pointer-op-suffix name)
      ""
      "")))

(define (lower-atomic-pointer-elem
  [ctx : TcContext]
  [name : String]
  [ptr-ty : AstType]) : ResultTcType
  (tc-atomic-pointer-elem ctx name ptr-ty))

(define (lower-atomic-pointer-load-arity-message [name : String]) : String
  (string.append "lower: " (string.append name " expects exactly one argument")))

(define (lower-atomic-pointer-update-arity-message [name : String]) : String
  (if (lower-atomic-pointer-volatile-name? name)
    "lower: volatile-store! expects exactly two arguments"
    "lower: atomic update expects exactly two arguments"))

(define (lower-atomic-pointer-emit-load
  [ctx : TcContext]
  [state : LowerState]
  [name : String]
  [ptr : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (CompilerIrCallArgs.One ptr)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-emit-update
  [ctx : TcContext]
  [state : LowerState]
  [name : String]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (CompilerIrCallArgs.Two ptr value)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-emit-cas
  [ctx : TcContext]
  [state : LowerState]
  [name : String]
  [ptr : CompilerIrValue]
  [expected : CompilerIrValue]
  [new-value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-pointer-raw-symbol name elem-ty)
              (compiler-ir-call-args-from-list
                (compiler-ir-value-cons
                  ptr
                  (compiler-ir-value-cons
                    expected
                    (compiler-ir-value-cons new-value (CompilerIrValueList.Nil)))))
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-pointer-update-tail
  [ctx : TcContext]
  [state : LowerState]
  [name : String]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]
  [tail : AstExprList]) : ResultLowerExpr
  (if (= (struct-get (& tail) len) 0)
    (lower-atomic-pointer-emit-update
      ctx
      state
      name
      ptr
      value
      elem-ty
      result-ty
      origin)
    (ResultLowerExpr.Err
      (box (lower-diagnostic (lower-atomic-pointer-update-arity-message name))))))

(define (lower-atomic-pointer-cas-tail
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [ptr : CompilerIrValue]
  [expected : CompilerIrValue]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]
  [tail : AstExprList]) : ResultLowerExpr
  (if (= (struct-get (& tail) len) 1)
    (let
      [new-value : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& tail) 0 0))]
      (match (lower-expr-expected
        ctx
        state
        env
        type-env
        new-value
        elem-ty
        new-value)
        [(ResultLowerExpr.Ok new-lowered)
          (match new-lowered
            [(LowerExpr.Expr new-state new-ir _)
              (lower-atomic-pointer-emit-cas
                ctx
                new-state
                name
                ptr
                expected
                new-ir
                elem-ty
                result-ty
                origin)])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic "lower: atomic-cas! expects exactly three arguments")))))

(define (lower-atomic-pointer-nonload-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [ptr : CompilerIrValue]
  [elem-ty : AstType]
  [tail0 : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (> (struct-get (& tail0) len) 0)
    (let
      [value : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& tail0) 0 0))]
      [tail1 : AstExprList (ast-expr-list-tail-from-ref (& tail0) 1)]
      (match (lower-expr-expected ctx state env type-env value elem-ty value)
        [(ResultLowerExpr.Ok value-lowered)
          (match value-lowered
            [(LowerExpr.Expr value-state value-ir _)
              (if (lower-atomic-pointer-cas-name? name)
                (lower-atomic-pointer-cas-tail
                  ctx
                  value-state
                  env
                  type-env
                  name
                  ptr
                  value-ir
                  elem-ty
                  result-ty
                  origin
                  tail1)
                (lower-atomic-pointer-update-tail
                  ctx
                  value-state
                  name
                  ptr
                  value-ir
                  elem-ty
                  result-ty
                  origin
                  tail1))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic
          (if (lower-atomic-pointer-cas-name? name)
            "lower: atomic-cas! expects exactly three arguments"
            (lower-atomic-pointer-update-arity-message name)))))))

(define (lower-atomic-pointer-call-with-elem
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [ptr-ty : AstType]
  [elem-ty : AstType]
  [tail0 : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-expr-expected ctx state env type-env ptr ptr-ty ptr)
    [(ResultLowerExpr.Ok ptr-lowered)
      (match ptr-lowered
        [(LowerExpr.Expr ptr-state ptr-ir _)
          (if (lower-atomic-pointer-load-name? name)
            (if (= (struct-get (& tail0) len) 0)
              (lower-atomic-pointer-emit-load
                ctx
                ptr-state
                name
                ptr-ir
                elem-ty
                result-ty
                origin)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic
                    (lower-atomic-pointer-load-arity-message name)))))
            (lower-atomic-pointer-nonload-call
              ctx
              ptr-state
              env
              type-env
              name
              ptr-ir
              elem-ty
              tail0
              result-ty
              origin))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-atomic-pointer-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (> (struct-get (& args) len) 0)
    (let
      [ptr : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
      [tail0 : AstExprList (ast-expr-list-tail-from-ref (& args) 1)]
      (match (tc-expr ctx type-env ptr)
        [(ResultTcType.Ok ptr-ty)
          (match (lower-atomic-pointer-elem ctx name ptr-ty)
            [(ResultTcType.Ok elem-ty)
              (lower-atomic-pointer-call-with-elem
                ctx
                state
                env
                type-env
                name
                ptr
                ptr-ty
                elem-ty
                tail0
                result-ty
                origin)]
            [(ResultTcType.Err message)
              (ResultLowerExpr.Err (box (lower-diagnostic-at-expr ptr message)))])]
        [(ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr ptr message)))]))
    (ResultLowerExpr.Err
      (box
        (lower-diagnostic
          (if (lower-atomic-pointer-load-name? name)
            (lower-atomic-pointer-load-arity-message name)
            (if (lower-atomic-pointer-cas-name? name)
              "lower: atomic-cas! expects exactly three arguments"
              (lower-atomic-pointer-update-arity-message name))))))))

(define (lower-atomic-load-symbol? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i32_load")))

(define (lower-atomic-emit-load
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [symbol : String]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-raw-symbol symbol)
              (CompilerIrCallArgs.One ptr)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-emit-update
  [ctx : TcContext]
  [state : LowerState]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [symbol : String]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc allocated var-id)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            allocated
            (CompilerIrInstr.Call
              var-id
              (lower-atomic-raw-symbol symbol)
              (CompilerIrCallArgs.Two ptr value)
              (lower-one-word-register-storage-type ctx result-ty))
            origin)
          (CompilerIrValue.Var var-id)
          result-ty))]))

(define (lower-atomic-array-element-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [array : AstExpr]
  [index : AstExpr]
  [elem-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    state
    env
    type-env
    array
    (ast-ty-dyn-array elem-ty)
    array)
    [(ResultLowerExpr.Ok arr-lowered)
      (match arr-lowered
        [(LowerExpr.Expr arr-state arr-value _)
          (match (lower-index-result-type-or-check
            ctx
            env
            type-env
            (lower-state-type-cache arr-state)
            index)
            [(ResultTcType.Ok idx-ty)
              (match (lower-expr-expected
                ctx
                arr-state
                env
                type-env
                index
                idx-ty
                index)
                [(ResultLowerExpr.Ok idx-lowered)
                  (match idx-lowered
                    [(LowerExpr.Expr idx-state idx-value idx-value-ty)
                      (ResultLowerExpr.Ok
                        (lower-array-element-addr
                          ctx
                          idx-state
                          arr-value
                          idx-value
                          idx-value-ty
                          elem-ty))])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
            [(ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr index message)))])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-atomic-call-load
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [symbol : String]
  [array : AstExpr]
  [index : AstExpr]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-atomic-array-element-address
    ctx
    state
    env
    type-env
    array
    index
    elem-ty)
    [(ResultLowerExpr.Ok addr)
      (match addr
        [(LowerExpr.Expr addr-state ptr _)
          (lower-atomic-emit-load ctx addr-state ptr symbol result-ty origin)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-atomic-call-update
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [symbol : String]
  [array : AstExpr]
  [index : AstExpr]
  [value : AstExpr]
  [elem-ty : AstType]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-atomic-array-element-address
    ctx
    state
    env
    type-env
    array
    index
    elem-ty)
    [(ResultLowerExpr.Ok addr)
      (match addr
        [(LowerExpr.Expr addr-state ptr _)
          (match (lower-expr-expected
            ctx
            addr-state
            env
            type-env
            value
            elem-ty
            value)
            [(ResultLowerExpr.Ok value-lowered)
              (match value-lowered
                [(LowerExpr.Expr value-state value-ir _)
                  (lower-atomic-emit-update
                    ctx
                    value-state
                    ptr
                    value-ir
                    symbol
                    result-ty
                    origin)])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-atomic-call
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [symbol : String]
  [args : AstExprList]
  [result-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [elem-ty : AstType (lower-atomic-elem-type symbol)]
    [count : i64 (struct-get (& args) len)]
    (if (= count 0)
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: atomic helper expects arguments")))
      (if (= count 1)
        (ResultLowerExpr.Err
          (box
            (lower-diagnostic
              "lower: atomic helper expects at least two arguments")))
        (let
          [array : AstExpr
            (lower-context-expr-get ctx (ast-expr-list-get (& args) 0 0))]
          [index : AstExpr
            (lower-context-expr-get ctx (ast-expr-list-get (& args) 1 0))]
          (if (lower-atomic-load-symbol? symbol)
            (if (= count 2)
              (lower-atomic-call-load
                ctx
                state
                env
                type-env
                symbol
                array
                index
                elem-ty
                result-ty
                origin)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic "lower: atomic load expects two arguments"))))
            (if (= count 3)
              (lower-atomic-call-update
                ctx
                state
                env
                type-env
                symbol
                array
                index
                (lower-context-expr-get ctx (ast-expr-list-get (& args) 2 0))
                elem-ty
                result-ty
                origin)
              (ResultLowerExpr.Err
                (box
                  (lower-diagnostic
                    "lower: atomic update expects three arguments"))))))))))

;; Fixed arrays are inline element storage. Bounds check against the static
;; length, then Gep directly from the array handle without loading dynamic-array
;; fat fields.
(define (lower-fixed-array-element-addr
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [idx-value : CompilerIrValue]
  [idx-ty : AstType]
  [elem-ty : AstType]
  [elem-count : i64]) : LowerExpr
  (match (lower-emit-cast state idx-value idx-ty (AstType.U64))
    [(LowerExpr.Expr s1 idx-u _)
      (match (lower-emit-cast s1 idx-value idx-ty (AstType.I64))
        [(LowerExpr.Expr s2 idx-off _)
          (lower-emit-elem-addr-gep
            ctx
            (lower-emit-bounds-check s2 idx-u (CompilerIrValue.I64 elem-count))
            arr-value
            idx-off
            elem-ty)])]))

;; `(make-array T len)` -> checked length, `tl_alloc` element buffer, and a
;; heap-backed dynamic-array fat value `{ ptr, len }`.
(define (lower-make-array-store-fat
  [state : LowerState]
  [arr-ty : AstType]
  [buf-var : i64]
  [len-i64 : CompilerIrValue]) : ResultLowerExpr
  (match (lower-reserve-heap-storage state 16 arr-ty)
    [(LowerExpr.Expr arr-state arr-value _)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-store-at-offset
            (lower-store-at-offset
              arr-state
              arr-value
              0
              (CompilerIrValue.Var buf-var)
              (AstType.U64))
            arr-value
            8
            len-i64
            (AstType.I64))
          arr-value
          arr-ty))]))

(define (lower-init-default-share-safe-type-list?
  [ctx : TcContext]
  [types : AstTypeList]) : bool
  (lower-init-default-share-safe-type-list-at? ctx (& types) 0))

(define (lower-init-default-share-safe-type-list-at?
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    true
    (let
      [head : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      (if (lower-init-default-share-safe? ctx head)
        (lower-init-default-share-safe-type-list-at? ctx types (+ index 1))
        false))))

(define (lower-init-default-share-safe-struct?
  [ctx : TcContext]
  [_ : String]
  [struct-ty : AstType]) : bool
  (match (tc-struct-decl-id ctx (lower-struct-type-name-id-or struct-ty -1))
    [(ResultTcStructDecl.Ok decl)
      (match decl
        [(TcStructDecl repr cleanup fields)
          (if (ast-struct-repr-c? repr)
            false
            (if (ast-struct-cleanup? cleanup)
              false
              (let
                [field-types : AstTypeList
                  (tc-resolve-type-list
                    ctx
                    (lower-struct-constructor-field-types-for-result
                      ctx
                      struct-ty
                      fields))]
                (lower-init-default-share-safe-type-list? ctx field-types))))])]
    [(ResultTcStructDecl.Err _) false]))

(define (lower-init-default-share-safe-enum?
  [ctx : TcContext]
  [_ : String]
  [enum-ty : AstType]) : bool
  (match (tc-enum-decl-id ctx (lower-enum-type-name-id-or enum-ty -1))
    [(ResultTcEnumDecl.Ok decl)
      (match decl
        [(TcEnumDecl cleanup variants)
          (if (ast-enum-cleanup? cleanup)
            false
            (if (ast-variant-def-list-empty? (& variants))
              false
              (let
                [variant : AstVariantDef
                  (ast-variant-def-list-get
                    (& variants)
                    0
                    (ast-variant-def-fallback))]
                (match variant
                  [(AstVariantDef.Def _ fields _)
                    (let
                      [field-types : AstTypeList
                        (tc-resolve-type-list
                          ctx
                          (lower-enum-constructor-fields-for-result
                            ctx
                            enum-ty
                            fields))]
                      (lower-init-default-share-safe-type-list? ctx field-types))]))))])]
    [(ResultTcEnumDecl.Err _) false]))

(define (lower-init-default-share-safe? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (if (tc-integer-type? resolved)
      true
      (match resolved
        [(AstType.F64) true]
        [(AstType.F32) true]
        [(AstType.Bool) true]
        [(AstType.Char) true]
        [(AstType.Unit) true]
        [(AstType.String) true]
        [(AstType.Ptr _) true]
        [(AstType.MutPtr _) true]
        [(AstType.Tuple elems)
          (lower-init-default-share-safe-type-list? ctx (box-get elems))]
        [(AstType.Struct name)
          (lower-init-default-share-safe-struct?
            ctx
            (tc-nominal-name-id-display name)
            resolved)]
        [(AstType.StructArgs name _)
          (lower-init-default-share-safe-struct?
            ctx
            (tc-nominal-name-id-display name)
            resolved)]
        [(AstType.Enum name)
          (lower-init-default-share-safe-enum?
            ctx
            (tc-nominal-name-id-display name)
            resolved)]
        [(AstType.EnumArgs name _)
          (lower-init-default-share-safe-enum?
            ctx
            (tc-nominal-name-id-display name)
            resolved)]
        [_ false]))))

(define (lower-make-array-init-advance
  [state : LowerState]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc inc-alloc inc-var)
      (ResultLowerState.Ok
        (lower-state-finish-block
          (lower-state-emit
            (lower-state-emit
              (lower-state-emit
                inc-alloc
                (CompilerIrInstr.BinOp
                  inc-var
                  CompilerIrBinOp.Add
                  (CompilerIrValue.Var index-var)
                  (CompilerIrValue.I64 1)
                  (AstType.I64)))
              (CompilerIrInstr.Mov
                index-var
                (CompilerIrValue.Var inc-var)
                (AstType.I64)))
            (CompilerIrInstr.Jump header-label))
          exit-label))]))

(define (lower-make-array-store-init-body
  [ctx : TcContext]
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]
  [elem-ty : AstType]
  [init-value : CompilerIrValue]) : ResultLowerState
  (match (lower-emit-elem-addr-gep
    ctx
    state
    buf-value
    (CompilerIrValue.Var index-var)
    elem-ty)
    [(LowerExpr.Expr gep-state elem-ptr _)
      (lower-make-array-init-advance
        (lower-array-elem-store-state ctx gep-state elem-ptr init-value elem-ty)
        index-var
        header-label
        exit-label)]))

(define (lower-make-array-init-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [index-var : i64]
  [header-label : String]
  [exit-label : String]
  [elem-ty : AstType]
  [origin : AstExpr]) : ResultLowerState
  (match (lower-init-expr ctx state env type-env elem-ty origin elem-ty)
    [(ResultLowerExpr.Ok lowered-init)
      (match lowered-init
        [(LowerExpr.Expr init-state init-value _)
          (match (lower-emit-elem-addr-gep
            ctx
            init-state
            buf-value
            (CompilerIrValue.Var index-var)
            elem-ty)
            [(LowerExpr.Expr gep-state elem-ptr _)
              (lower-make-array-init-advance
                (lower-array-elem-store-state
                  ctx
                  gep-state
                  elem-ptr
                  init-value
                  elem-ty)
                index-var
                header-label
                exit-label)])])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-make-array-init-loop-with-labels
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [origin : AstExpr]
  [header-label : String]
  [body-label : String]
  [exit-label : String]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc index-alloc index-var)
      (let
        [header-start : LowerState
          (lower-state-finish-block
            (lower-state-emit
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov
                  index-var
                  (CompilerIrValue.I64 0)
                  (AstType.I64)))
              (CompilerIrInstr.Jump header-label))
            header-label)]
        (match (lower-emit-binop
          header-start
          CompilerIrBinOp.Lt
          (CompilerIrValue.Var index-var)
          len-i64
          (AstType.I64))
          [(LowerExpr.Expr cond-state cond-value _)
            (let
              [body-start : LowerState
                (lower-state-finish-block
                  (lower-state-emit
                    cond-state
                    (CompilerIrInstr.Branch cond-value body-label exit-label))
                  body-label)]
              (lower-make-array-init-body
                ctx
                body-start
                env
                type-env
                buf-value
                index-var
                header-label
                exit-label
                elem-ty
                origin))]))]))

(define (lower-make-array-store-init-loop-with-labels
  [ctx : TcContext]
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [init-value : CompilerIrValue]
  [header-label : String]
  [body-label : String]
  [exit-label : String]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc index-alloc index-var)
      (let
        [header-start : LowerState
          (lower-state-finish-block
            (lower-state-emit
              (lower-state-emit
                index-alloc
                (CompilerIrInstr.Mov
                  index-var
                  (CompilerIrValue.I64 0)
                  (AstType.I64)))
              (CompilerIrInstr.Jump header-label))
            header-label)]
        (match (lower-emit-binop
          header-start
          CompilerIrBinOp.Lt
          (CompilerIrValue.Var index-var)
          len-i64
          (AstType.I64))
          [(LowerExpr.Expr cond-state cond-value _)
            (let
              [body-start : LowerState
                (lower-state-finish-block
                  (lower-state-emit
                    cond-state
                    (CompilerIrInstr.Branch cond-value body-label exit-label))
                  body-label)]
              (lower-make-array-store-init-body
                ctx
                body-start
                buf-value
                index-var
                header-label
                exit-label
                elem-ty
                init-value))]))]))

(define (lower-make-array-init-loop-runtime
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [origin : AstExpr]) : ResultLowerState
  (if (= elem-size 0)
    (ResultLowerState.Ok state)
    (match (lower-state-fresh-label state "make_array_init_header")
      [(LowerLabel.Label header-label-state header-label)
        (match (lower-state-fresh-label
          header-label-state
          "make_array_init_body")
          [(LowerLabel.Label body-label-state body-label)
            (match (lower-state-fresh-label
              body-label-state
              "make_array_init_exit")
              [(LowerLabel.Label exit-label-state exit-label)
                (lower-make-array-init-loop-with-labels
                  ctx
                  exit-label-state
                  env
                  type-env
                  buf-value
                  len-i64
                  elem-ty
                  origin
                  header-label
                  body-label
                  exit-label)])])])))

(define (lower-make-array-store-init-loop-runtime
  [ctx : TcContext]
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [init-value : CompilerIrValue]) : ResultLowerState
  (if (= elem-size 0)
    (ResultLowerState.Ok state)
    (match (lower-state-fresh-label state "make_array_init_header")
      [(LowerLabel.Label header-label-state header-label)
        (match (lower-state-fresh-label
          header-label-state
          "make_array_init_body")
          [(LowerLabel.Label body-label-state body-label)
            (match (lower-state-fresh-label
              body-label-state
              "make_array_init_exit")
              [(LowerLabel.Label exit-label-state exit-label)
                (lower-make-array-store-init-loop-with-labels
                  ctx
                  exit-label-state
                  buf-value
                  len-i64
                  elem-ty
                  init-value
                  header-label
                  body-label
                  exit-label)])])])))

(define (lower-make-array-fill8
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [init-value : CompilerIrValue]) : ResultLowerState
  (match (lower-runtime-call-values
    state
    (lower-tl-array-fill8-symbol)
    (compiler-ir-value-cons
      buf-value
      (compiler-ir-value-cons
        len-i64
        (compiler-ir-value-cons init-value CompilerIrValueList.Nil)))
    (AstType.Unit))
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr done-state _ _) (ResultLowerState.Ok done-state)])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-make-array-fill8-supported? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (and
      (= (lower-type-size ctx resolved) 8)
      (not (tc-type-eq resolved (AstType.F64)))
      ;; Memory-resident inline aggregates are pointers to
      ;; storage, but a one-word register-resident aggregate is the word
      ;; itself, so fill8 can replicate it directly.
      (or
        (not (lower-type-inline-storage? ctx resolved))
        (lower-type-register-resident? ctx resolved))
      (lower-init-default-share-safe? ctx resolved))))

(define (lower-make-array-zero-fill-supported? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (if (tc-integer-type? resolved)
      true
      (match resolved
        [(AstType.F64) true]
        [(AstType.F32) true]
        [(AstType.Bool) true]
        [(AstType.Char) true]
        [(AstType.Unit) true]
        [(AstType.Ptr _) true]
        [(AstType.MutPtr _) true]
        [(AstType.Struct _)
          (lower-make-array-zero-fill-struct-supported? ctx resolved)]
        [(AstType.StructArgs _ _)
          (lower-make-array-zero-fill-struct-supported? ctx resolved)]
        [(AstType.Enum _)
          (lower-make-array-zero-fill-enum-supported? ctx resolved)]
        [(AstType.EnumArgs _ _)
          (lower-make-array-zero-fill-enum-supported? ctx resolved)]
        [(AstType.Tuple elems)
          (lower-make-array-zero-fill-type-list-supported?
            ctx
            (box-get elems)
            0)]
        [(AstType.Array elem _)
          (lower-make-array-zero-fill-supported?
            ctx
            (tc-context-type-get ctx elem))]
        [_ false]))))

;; Every type in `types` (starting at `index`) must have an all-zero-bytes
;; default value. Used to decide whether make-array can zero its backing
;; store instead of running the per-element default-init loop.
(define (lower-make-array-zero-fill-type-list-supported?
  [ctx : TcContext]
  [types : AstTypeList]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len (& types)))
    true
    (if (lower-make-array-zero-fill-supported?
      ctx
      (tc-context-type-get
        ctx
        (ast-type-list-get (& types) index (ast-type-id-fallback))))
      (lower-make-array-zero-fill-type-list-supported? ctx types (+ index 1))
      false)))

;; A struct can be zero-filled when every field's default is all-zero bytes
;; (default-layout only, mirroring lower-init-struct).
(define (lower-make-array-zero-fill-struct-supported?
  [ctx : TcContext]
  [struct-ty : AstType]) : bool
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-struct-type-name-id-or struct-ty -1))]
    (if (lower-struct-repr-c-id?
      field-ctx
      (lower-struct-type-name-id-or struct-ty -1))
      false
      (match (lower-struct-fields-id
        field-ctx
        (lower-struct-type-name-id-or struct-ty -1)
        (tc-nominal-name-id-display (lower-struct-type-name-id-or struct-ty -1)))
        [(ResultAstFieldDefList.Ok fields)
          (lower-make-array-zero-fill-type-list-supported?
            field-ctx
            (tc-resolve-type-list
              field-ctx
              (lower-struct-constructor-field-types-for-result
                field-ctx
                struct-ty
                fields))
            0)]
        [(ResultAstFieldDefList.Err _) false]))))

;; An enum can be zero-filled when its first variant (tag 0) is fieldless:
;; the default value is then the zero tag word plus don't-care payload bytes,
;; which zeroing satisfies. (A payloaded first variant could have a non-zero
;; default, so those enums keep the init loop.)
(define (lower-make-array-zero-fill-enum-supported?
  [ctx : TcContext]
  [enum-ty : AstType]) : bool
  (let
    [field-ctx : TcContext
      (lower-context-with-nominal-owner-module-id
        ctx
        (lower-enum-type-name-id-or enum-ty -1))]
    (match (tc-enum-decl-id field-ctx (lower-enum-type-name-id-or enum-ty -1))
      [(ResultTcEnumDecl.Ok decl)
        (match decl
          [(TcEnumDecl _ variants)
            (if (ast-variant-def-list-empty? (& variants))
              false
              (match (ast-variant-def-list-get
                (& variants)
                0
                (ast-variant-def-fallback))
                [(AstVariantDef.Def _ fields _)
                  (ast-type-list-empty? (& fields))]))])]
      [(ResultTcEnumDecl.Err _) false])))

(define (lower-make-array-zero-fill
  [state : LowerState]
  [buf-value : CompilerIrValue]
  [byte-count : CompilerIrValue]) : ResultLowerState
  (match (lower-runtime-call-values
    state
    (lower-tl-array-zero-symbol)
    (compiler-ir-value-cons
      buf-value
      (compiler-ir-value-cons byte-count CompilerIrValueList.Nil))
    (AstType.Unit))
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr done-state _ _) (ResultLowerState.Ok done-state)])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-make-array-zero-literal-length? [len : AstExpr]) : bool
  (match (ast-expr-unspan len)
    [(AstExpr.Literal (AstLiteral.Int value _)) (= value 0)]
    [_ false]))

(define (lower-make-array-init-loop-nonzero
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [byte-count : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [origin : AstExpr]) : ResultLowerState
  (cond
    [(= elem-size 0) (ResultLowerState.Ok state)]
    [(lower-make-array-zero-fill-supported? ctx elem-ty)
      (lower-make-array-zero-fill state buf-value byte-count)]
    [(lower-init-default-share-safe? ctx elem-ty)
      (match (lower-init-expr ctx state env type-env elem-ty origin elem-ty)
        [(ResultLowerExpr.Ok lowered-init)
          (match lowered-init
            [(LowerExpr.Expr init-state init-value _)
              (if (lower-make-array-fill8-supported? ctx elem-ty)
                (lower-make-array-fill8 init-state buf-value len-i64 init-value)
                (lower-make-array-store-init-loop-runtime
                  ctx
                  init-state
                  buf-value
                  len-i64
                  elem-ty
                  elem-size
                  init-value))])]
        [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])]
    [else
      (lower-make-array-init-loop-runtime
        ctx
        state
        env
        type-env
        buf-value
        len-i64
        elem-ty
        elem-size
        origin)]))

(define (lower-make-array-init-loop
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [buf-value : CompilerIrValue]
  [len-i64 : CompilerIrValue]
  [byte-count : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : AstExpr]) : ResultLowerState
  (if zero-literal-length
    (ResultLowerState.Ok state)
    (match len-i64
      [(CompilerIrValue.I64 literal-len)
        (if (= literal-len 0)
          (ResultLowerState.Ok state)
          (lower-make-array-init-loop-nonzero
            ctx
            state
            env
            type-env
            buf-value
            len-i64
            byte-count
            elem-ty
            elem-size
            origin))]
      [_
        (lower-make-array-init-loop-nonzero
          ctx
          state
          env
          type-env
          buf-value
          len-i64
          byte-count
          elem-ty
          elem-size
          origin)])))

(define (lower-make-array-alloc-buffer
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr-ty : AstType]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-emit-binop
    state
    (CompilerIrBinOp.Mul)
    len-i64
    (CompilerIrValue.I64 elem-size)
    (AstType.I64))
    [(LowerExpr.Expr byte-state byte-count _)
      (match (lower-state-alloc-var byte-state)
        [(LowerAlloc.Alloc buf-alloc buf-var)
          (let
            [alloc-state : LowerState
              (lower-state-emit
                buf-alloc
                (CompilerIrInstr.Call
                  buf-var
                  (lower-tl-alloc-symbol)
                  (CompilerIrCallArgs.One byte-count)
                  (AstType.U64)))]
            (match (lower-make-array-init-loop
              ctx
              alloc-state
              env
              type-env
              (CompilerIrValue.Var buf-var)
              len-i64
              byte-count
              elem-ty
              elem-size
              zero-literal-length
              origin)
              [(ResultLowerState.Ok init-state)
                (lower-make-array-store-fat init-state arr-ty buf-var len-i64)]
              [(ResultLowerState.Err message) (ResultLowerExpr.Err message)]))])]))

(define (lower-make-array-after-max-check
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [fail-label : String]
  [alloc-label : String]
  [arr-ty : AstType]
  [len-i64 : CompilerIrValue]
  [elem-ty : AstType]
  [elem-size : i64]
  [zero-literal-length : bool]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [fail-start : LowerState (lower-state-finish-block state fail-label)]
    [alloc-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (CompilerIrInstr.Jump alloc-label))
        alloc-label)]
    (lower-make-array-alloc-buffer
      ctx
      alloc-start
      env
      type-env
      arr-ty
      len-i64
      elem-ty
      elem-size
      zero-literal-length
      origin)))

(define (lower-make-array-from-len
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [elem-ty : AstType]
  [len-value : CompilerIrValue]
  [len-ty : AstType]
  [len-expr : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [resolved-elem : AstType (tc-resolve-type ctx elem-ty)]
    (match (lower-cast-value state len-value len-ty (AstType.I64))
      [(LowerExpr.Expr len-state len-i64 _)
        (let
          [elem-size : i64 (lower-type-size ctx resolved-elem)]
          [arr-ty : AstType (ast-ty-dyn-array resolved-elem)]
          (match (lower-state-fresh-label len-state "make_array_len_nonneg")
            [(LowerLabel.Label s1 check-max-label)
              (match (lower-state-fresh-label s1 "make_array_len_fail")
                [(LowerLabel.Label s2 fail-label)
                  (match (lower-state-fresh-label s2 "make_array_len_ok")
                    [(LowerLabel.Label s3 alloc-label)
                      (match (lower-emit-binop
                        s3
                        (CompilerIrBinOp.Le)
                        (CompilerIrValue.I64 0)
                        len-i64
                        (AstType.I64))
                        [(LowerExpr.Expr s4 non-negative _)
                          (let
                            [check-start : LowerState
                              (lower-state-finish-block
                                (lower-state-emit
                                  s4
                                  (CompilerIrInstr.Branch
                                    non-negative
                                    check-max-label
                                    fail-label))
                                check-max-label)]
                            [max-len : i64
                              (if (= elem-size 0)
                                9223372036854775807
                                (/ 9223372036854775807 elem-size))]
                            (match (lower-emit-binop
                              check-start
                              (CompilerIrBinOp.Le)
                              len-i64
                              (CompilerIrValue.I64 max-len)
                              (AstType.I64))
                              [(LowerExpr.Expr s5 within-max _)
                                (lower-make-array-after-max-check
                                  ctx
                                  (lower-state-emit
                                    s5
                                    (CompilerIrInstr.Branch
                                      within-max
                                      alloc-label
                                      fail-label))
                                  env
                                  type-env
                                  fail-label
                                  alloc-label
                                  arr-ty
                                  len-i64
                                  resolved-elem
                                  elem-size
                                  (lower-make-array-zero-literal-length?
                                    len-expr)
                                  origin)]))])])])]))])))

(define (lower-make-array
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [elem-ty : AstType]
  [len : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-integer-expr-with-expected-or-actual
    ctx
    state
    env
    type-env
    len
    (AstType.I64)
    "lower: make-array length must be integer")
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr len-state len-value len-ty)
          (lower-make-array-from-len
            ctx
            len-state
            env
            type-env
            elem-ty
            len-value
            len-ty
            len
            origin)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; `(array-ref arr index)` -> bounds-checked typed element load.
;; Read an array element given its address. For a memory aggregate
;; element the address IS the value (pointer representation); for scalars and
;; pointer-slot types (tuple/box/dynarray/string handles) load the register-width
;; value. Mirrors lower-load-inline-value-at-offset at offset 0 but preserves the
;; exact lower-emit-load scalar path.
(define (lower-array-elem-ref-result
  [ctx : TcContext]
  [addr-state : LowerState]
  [elem-ptr : CompilerIrValue]
  [elem-ir-ty : AstType]) : ResultLowerExpr
  ;; A register-resident element is loaded as a word, not returned as the
  ;; element address.
  (if (and
    (lower-mode-inline-aggregates? (lower-state-mode addr-state))
    (lower-type-inline-storage? ctx elem-ir-ty)
    (not (lower-type-register-resident? ctx elem-ir-ty)))
    (ResultLowerExpr.Ok (LowerExpr.Expr addr-state elem-ptr elem-ir-ty))
    (if (lower-type-register-group? ctx elem-ir-ty)
      (match (lower-load-group-from-ptr ctx addr-state elem-ptr elem-ir-ty)
        [(LowerExpr.Expr load-state load-value _)
          (ResultLowerExpr.Ok (LowerExpr.Expr load-state load-value elem-ir-ty))])
      (match (lower-emit-load addr-state elem-ptr elem-ir-ty)
        [(LowerExpr.Expr load-state load-value _)
          (ResultLowerExpr.Ok (LowerExpr.Expr load-state load-value elem-ir-ty))]))))

(define (lower-array-take-length
  [state : LowerState]
  [array-value : CompilerIrValue]) : LowerExpr
  (match (lower-emit-gep
    state
    array-value
    (CompilerIrValue.I64 1)
    (AstType.I64))
    [(LowerExpr.Expr gep-state gep-value _)
      (lower-emit-load gep-state gep-value (AstType.I64))]))

(define (lower-array-take-store-result
  [ctx : TcContext]
  [state : LowerState]
  [result-base : CompilerIrValue]
  [elem-offset : i64]
  [elem-ty : AstType]
  [available : CompilerIrValue]
  [value : CompilerIrValue]) : LowerState
  (lower-store-inline-value-at-offset
    ctx
    (lower-store-at-offset state result-base 0 available (AstType.Bool))
    result-base
    elem-offset
    value
    elem-ty
    (lower-type-size ctx elem-ty)))

;; Finish a checked dynamic-array extraction once its availability flag is
;; initialized to false. The payload is meaningful only when that flag is true.
;; Both dynamic lengths are checked before either element address is formed;
;; clearing the bitmap precedes the payload load, making a repeated extraction
;; observe false instead of moving again.
(define (lower-array-take-after-result-flag
  [ctx : TcContext]
  [state : LowerState]
  [array-value : CompilerIrValue]
  [live-value : CompilerIrValue]
  [index-value : CompilerIrValue]
  [index-ty : AstType]
  [elem-ty : AstType]
  [result-base : CompilerIrValue]
  [result-ty : AstType]
  [elem-offset : i64]) : ResultLowerExpr
  (match (lower-array-take-length state array-value)
    [(LowerExpr.Expr array-len-state array-len _)
      (match (lower-array-take-length array-len-state live-value)
        [(LowerExpr.Expr live-len-state live-len _)
          (match (lower-emit-cast
            live-len-state
            index-value
            index-ty
            (AstType.U64))
            [(LowerExpr.Expr index-state index-u _)
              (match (lower-emit-cast
                index-state
                array-len
                (AstType.I64)
                (AstType.U64))
                [(LowerExpr.Expr array-len-state2 array-len-u _)
                  (match (lower-emit-cast
                    array-len-state2
                    live-len
                    (AstType.I64)
                    (AstType.U64))
                    [(LowerExpr.Expr live-len-state2 live-len-u _)
                      (match (lower-emit-binop
                        live-len-state2
                        CompilerIrBinOp.Lt
                        index-u
                        array-len-u
                        (AstType.U64))
                        [(LowerExpr.Expr array-ok-state array-ok _)
                          (match (lower-emit-binop
                            array-ok-state
                            CompilerIrBinOp.Lt
                            index-u
                            live-len-u
                            (AstType.U64))
                            [(LowerExpr.Expr live-ok-state live-ok _)
                              (match (lower-emit-binop
                                live-ok-state
                                CompilerIrBinOp.And
                                array-ok
                                live-ok
                                (AstType.Bool))
                                [(LowerExpr.Expr bounds-state bounds-ok _)
                                  (match (lower-state-fresh-label
                                    bounds-state
                                    "array_take_live")
                                    [(LowerLabel.Label
                                        live-label-state
                                        live-label)
                                      (match (lower-state-fresh-label
                                        live-label-state
                                        "array_take_value")
                                        [(LowerLabel.Label
                                            take-label-state
                                            take-label)
                                          (match (lower-state-fresh-label
                                            take-label-state
                                            "array_take_done")
                                            [(LowerLabel.Label
                                                done-label-state
                                                done-label)
                                              (let
                                                [live-start : LowerState
                                                  (lower-state-finish-block
                                                    (lower-state-emit
                                                      done-label-state
                                                      (CompilerIrInstr.Branch
                                                        bounds-ok
                                                        live-label
                                                        done-label))
                                                    live-label)]
                                                (match (lower-array-element-addr
                                                  ctx
                                                  live-start
                                                  live-value
                                                  index-value
                                                  index-ty
                                                  (AstType.Bool))
                                                  [(LowerExpr.Expr
                                                      live-addr-state
                                                      live-ptr
                                                      _)
                                                    (match (lower-array-elem-ref-result
                                                      ctx
                                                      live-addr-state
                                                      live-ptr
                                                      (AstType.Bool))
                                                      [(ResultLowerExpr.Ok
                                                          live-read)
                                                        (match live-read
                                                          [(LowerExpr.Expr
                                                              live-read-state
                                                              live-bit
                                                              _)
                                                            (let
                                                              [take-start : LowerState
                                                                (lower-state-finish-block
                                                                  (lower-state-emit
                                                                    live-read-state
                                                                    (CompilerIrInstr.Branch
                                                                      live-bit
                                                                      take-label
                                                                      done-label))
                                                                  take-label)]
                                                              (match (lower-array-element-addr
                                                                ctx
                                                                take-start
                                                                array-value
                                                                index-value
                                                                index-ty
                                                                elem-ty)
                                                                [(LowerExpr.Expr
                                                                    elem-addr-state
                                                                    elem-ptr
                                                                    _)
                                                                  (match (lower-array-elem-ref-result
                                                                    ctx
                                                                    elem-addr-state
                                                                    elem-ptr
                                                                    elem-ty)
                                                                    [(ResultLowerExpr.Ok
                                                                        value-read)
                                                                      (match value-read
                                                                        [(LowerExpr.Expr
                                                                            value-state
                                                                            value
                                                                            _)
                                                                          (let
                                                                            [cleared-state : LowerState
                                                                              (lower-array-elem-store-state
                                                                                ctx
                                                                                value-state
                                                                                live-ptr
                                                                                (CompilerIrValue.Bool
                                                                                  false)
                                                                                (AstType.Bool))]
                                                                            [stored-state : LowerState
                                                                              (lower-array-take-store-result
                                                                                ctx
                                                                                cleared-state
                                                                                result-base
                                                                                elem-offset
                                                                                elem-ty
                                                                                (CompilerIrValue.Bool
                                                                                  true)
                                                                                value)]
                                                                            (ResultLowerExpr.Ok
                                                                              (LowerExpr.Expr
                                                                                (lower-state-finish-block
                                                                                  (lower-state-emit
                                                                                    stored-state
                                                                                    (CompilerIrInstr.Jump
                                                                                      done-label))
                                                                                  done-label)
                                                                                result-base
                                                                                result-ty)))])]
                                                                    [(ResultLowerExpr.Err
                                                                        message)
                                                                      (ResultLowerExpr.Err
                                                                        message)])]))])]
                                                      [(ResultLowerExpr.Err
                                                          message)
                                                        (ResultLowerExpr.Err
                                                          message)])]))])])])])])])])])])])]))

(define (lower-array-take
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [array : AstExpr]
  [live : AstExpr]
  [index : AstExpr]
  [result-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    array)
    [(ResultTcType.Ok array-ty)
      (match (tc-array-set-receiver ctx array-ty)
        [(ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (match (tc-type-strip-region (tc-resolve-type ctx container-ty))
                [(AstType.DynArray _)
                  (let
                    [elem-ir-ty : AstType
                      (tc-type-without-regions (tc-resolve-type ctx elem-ty))]
                    (match (lower-expr ctx state env type-env array)
                      [(ResultLowerExpr.Ok array-lowered)
                        (match array-lowered
                          [(LowerExpr.Expr array-state array-value _)
                            (match (lower-expr
                              ctx
                              array-state
                              env
                              type-env
                              live)
                              [(ResultLowerExpr.Ok live-lowered)
                                (match live-lowered
                                  [(LowerExpr.Expr live-state live-value _)
                                    (match (lower-integer-expr-with-expected-or-actual
                                      ctx
                                      live-state
                                      env
                                      type-env
                                      index
                                      (AstType.I64)
                                      "lower: array-take! index must be integer")
                                      [(ResultLowerExpr.Ok index-lowered)
                                        (match index-lowered
                                          [(LowerExpr.Expr
                                              index-state
                                              index-value
                                              index-ty)
                                            (let
                                              [elem-offset : i64
                                                (lower-align-up
                                                  1
                                                  (lower-type-align
                                                    ctx
                                                    elem-ir-ty))]
                                              [result-storage-size : i64
                                                (lower-type-list-storage-size
                                                  ctx
                                                  (ast-type-cons
                                                    (AstType.Bool)
                                                    (ast-type-cons
                                                      elem-ir-ty
                                                      (ast-type-list-new))))]
                                              (match (lower-reserve-heap-storage
                                                index-state
                                                result-storage-size
                                                result-ty)
                                                [(LowerExpr.Expr
                                                    result-state
                                                    result-base
                                                    _)
                                                  (lower-array-take-after-result-flag
                                                    ctx
                                                    (lower-store-at-offset
                                                      result-state
                                                      result-base
                                                      0
                                                      (CompilerIrValue.Bool
                                                        false)
                                                      (AstType.Bool))
                                                    array-value
                                                    live-value
                                                    index-value
                                                    index-ty
                                                    elem-ir-ty
                                                    result-base
                                                    result-ty
                                                    elem-offset)]))])]
                                      [(ResultLowerExpr.Err message)
                                        (ResultLowerExpr.Err message)])])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])])]
                      [(ResultLowerExpr.Err message)
                        (ResultLowerExpr.Err message)]))]
                [_
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        array
                        "lower: array-take! requires dynamic array storage")))])])]
        [(ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr array message)))])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr array message)))]))

(define (lower-array-ref
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [index : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      (match (tc-array-readable-receiver ctx arr-ty)
        [(ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (let
                [elem-ir-ty : AstType (tc-type-without-regions elem-ty)]
                (match (lower-expr ctx state env type-env arr)
                  [(ResultLowerExpr.Ok arr-lowered)
                    (match arr-lowered
                      [(LowerExpr.Expr arr-state arr-value _)
                        (match (lower-index-result-type-or-check
                          ctx
                          env
                          type-env
                          (lower-state-type-cache arr-state)
                          index)
                          [(ResultTcType.Ok idx-ty)
                            (match (lower-expr-expected
                              ctx
                              arr-state
                              env
                              type-env
                              index
                              idx-ty
                              index)
                              [(ResultLowerExpr.Ok idx-lowered)
                                (match idx-lowered
                                  [(LowerExpr.Expr
                                      idx-state
                                      idx-value
                                      idx-value-ty)
                                    (match (tc-type-strip-region
                                      (tc-resolve-type ctx container-ty))
                                      [(AstType.DynArray _)
                                        (match (lower-array-element-addr
                                          ctx
                                          idx-state
                                          arr-value
                                          idx-value
                                          idx-value-ty
                                          elem-ir-ty)
                                          [(LowerExpr.Expr
                                              addr-state
                                              elem-ptr
                                              _)
                                            (lower-array-elem-ref-result
                                              ctx
                                              addr-state
                                              elem-ptr
                                              elem-ir-ty)])]
                                      [(AstType.Array _ elem-count)
                                        (match (lower-fixed-array-element-addr
                                          ctx
                                          idx-state
                                          arr-value
                                          idx-value
                                          idx-value-ty
                                          elem-ir-ty
                                          elem-count)
                                          [(LowerExpr.Expr
                                              addr-state
                                              elem-ptr
                                              _)
                                            (if (=
                                              (lower-type-size ctx elem-ir-ty)
                                              0)
                                              (ResultLowerExpr.Ok
                                                (LowerExpr.Expr
                                                  addr-state
                                                  CompilerIrValue.Unit
                                                  elem-ir-ty))
                                              (lower-array-elem-ref-result
                                                ctx
                                                addr-state
                                                elem-ptr
                                                elem-ir-ty))])]
                                      [_
                                        (ResultLowerExpr.Err
                                          (box
                                            (lower-diagnostic-at-expr
                                              arr
                                              "lower: array-ref requires array type")))])])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])]
                          [(ResultTcType.Err message)
                            (ResultLowerExpr.Err
                              (box (lower-diagnostic-at-expr index message)))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))])]
        [(ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

;; `(array-set! arr index value)` -> bounds-checked typed element store.
;; Store a value into an array element slot. A memory aggregate
;; value is byte-copied into the full-size element slot; scalars and pointer-slot
;; handles use a register-width store.
(define (lower-array-elem-store-state
  [ctx : TcContext]
  [addr-state : LowerState]
  [elem-ptr : CompilerIrValue]
  [value-ir : CompilerIrValue]
  [elem-ir-ty : AstType]) : LowerState
  ;; A register-resident element value is a word; store it scalar instead
  ;; of byte-copying from a pointer.
  (if (and
    (lower-mode-inline-aggregates? (lower-state-mode addr-state))
    (lower-type-inline-storage? ctx elem-ir-ty)
    (not (lower-type-register-resident? ctx elem-ir-ty)))
    (lower-copy-bytes
      addr-state
      elem-ptr
      0
      value-ir
      0
      (lower-type-size ctx elem-ir-ty))
    (if (lower-type-register-group? ctx elem-ir-ty)
      (lower-store-group-at-ptr ctx addr-state elem-ptr value-ir elem-ir-ty)
      (lower-state-emit
        addr-state
        (CompilerIrInstr.StorePtr elem-ptr value-ir elem-ir-ty)))))

(define (lower-array-set-store-materialized
  [ctx : TcContext]
  [state : LowerState]
  [arr : AstExpr]
  [arr-value : CompilerIrValue]
  [idx-value : CompilerIrValue]
  [idx-ty : AstType]
  [container-ty : AstType]
  [elem-ir-ty : AstType]
  [value-ir : CompilerIrValue]) : ResultLowerExpr
  (match (tc-type-strip-region (tc-resolve-type ctx container-ty))
    [(AstType.DynArray _)
      (match (lower-array-element-addr
        ctx
        state
        arr-value
        idx-value
        idx-ty
        elem-ir-ty)
        [(LowerExpr.Expr addr-state elem-ptr _)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-array-elem-store-state
                ctx
                addr-state
                elem-ptr
                value-ir
                elem-ir-ty)
              CompilerIrValue.Unit
              (AstType.Unit)))])]
    [(AstType.Array _ elem-count)
      (match (lower-fixed-array-element-addr
        ctx
        state
        arr-value
        idx-value
        idx-ty
        elem-ir-ty
        elem-count)
        [(LowerExpr.Expr addr-state elem-ptr _)
          (if (= (lower-type-size ctx elem-ir-ty) 0)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr addr-state CompilerIrValue.Unit (AstType.Unit)))
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (lower-array-elem-store-state
                  ctx
                  addr-state
                  elem-ptr
                  value-ir
                  elem-ir-ty)
                CompilerIrValue.Unit
                (AstType.Unit))))])]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr arr "lower: array-set! requires array type")))]))

(define (lower-array-set-direct-store
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [arr-value : CompilerIrValue]
  [idx-value : CompilerIrValue]
  [idx-ty : AstType]
  [container-ty : AstType]
  [elem-ir-ty : AstType]
  [value : AstExpr]) : LowerMaybeDirectStore
  (if (and
    (> (lower-type-size ctx elem-ir-ty) 0)
    (lower-direct-store-target? ctx state elem-ir-ty))
    (match (tc-type-strip-region (tc-resolve-type ctx container-ty))
      [(AstType.DynArray _)
        (match (lower-array-element-addr
          ctx
          state
          arr-value
          idx-value
          idx-ty
          elem-ir-ty)
          [(LowerExpr.Expr addr-state elem-ptr _)
            (lower-direct-store-rhs-into
              ctx
              addr-state
              env
              type-env
              elem-ptr
              value
              elem-ir-ty
              value)])]
      [(AstType.Array _ elem-count)
        (match (lower-fixed-array-element-addr
          ctx
          state
          arr-value
          idx-value
          idx-ty
          elem-ir-ty
          elem-count)
          [(LowerExpr.Expr addr-state elem-ptr _)
            (lower-direct-store-rhs-into
              ctx
              addr-state
              env
              type-env
              elem-ptr
              value
              elem-ir-ty
              value)])]
      [_
        (LowerMaybeDirectStore.Err
          (box
            (lower-diagnostic-at-expr
              arr
              "lower: array-set! requires array type")))])
    (LowerMaybeDirectStore.No)))

(define (lower-mutable-var-storage-address-id
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name : i64]
  [place-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (let
    [local-id : i64
      (sym_i64_env.sym-i64-lookup-id-or
        env
        name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? local-id)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc allocated var-id)
          (let
            [addr-state : LowerState
              (lower-state-emit-at-expr
                allocated
                (CompilerIrInstr.AddrOf var-id local-id)
                origin)]
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                (if (lower-type-register-resident? ctx place-ty)
                  (lower-state-register-address-taken-mark addr-state local-id)
                  addr-state)
                (CompilerIrValue.Var var-id)
                place-ty)))])
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          state
          (CompilerIrValue.GlobalAddr (lower-resolve-name-symbol-id state name))
          place-ty)))))

(define (lower-mutable-var-address-id
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [name : i64]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(ResultTcType.Ok place-ty)
      (let
        [resolved : AstType
          (tc-type-strip-region (tc-resolve-type ctx place-ty))]
        (match resolved
          [(AstType.MutRef _ referent-ty)
            (match (lower-var-id state env name place-ty)
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr ref-state ref-value _)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr
                        ref-state
                        ref-value
                        (tc-context-type-get ctx referent-ty)))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [(AstType.Ref _ _)
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: set! struct field requires mutable struct access")))]
          [_
            (if (lower-borrow-place-value-reference? ctx place-ty)
              (lower-var-id state env name place-ty)
              (lower-mutable-var-storage-address-id
                ctx
                state
                env
                name
                place-ty
                origin))]))]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]))

(define (lower-struct-field-address-from-place
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [receiver-ty : AstType]
  [field : String]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstType.Struct struct-name)
      (match (lower-struct-field-info
        ctx
        struct-name
        (tc-nominal-name-id-display struct-name)
        field)
        [(ResultLowerFieldInfo.Ok info)
          (match info
            [(LowerFieldInfo.Info offset field-ty)
              (match (lower-gep-byte state base offset)
                [(LowerExpr.Expr ptr-state ptr _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      ptr-state
                      ptr
                      (tc-type-without-regions field-ty)))])])]
        [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)])]
    [(AstType.StructArgs struct-name _)
      (match (lower-struct-field-info
        ctx
        struct-name
        (tc-nominal-name-id-display struct-name)
        field)
        [(ResultLowerFieldInfo.Ok info)
          (match info
            [(LowerFieldInfo.Info offset field-ty)
              (match (lower-gep-byte state base offset)
                [(LowerExpr.Expr ptr-state ptr _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      ptr-state
                      ptr
                      (tc-type-without-regions field-ty)))])])]
        [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)])]
    [(AstType.MutRef _ referent-ty)
      (match (lower-emit-load state base receiver-ty)
        [(LowerExpr.Expr ref-state ref-value _)
          (lower-struct-field-address-from-place
            ctx
            ref-state
            ref-value
            (tc-context-type-get ctx referent-ty)
            field
            origin)])]
    [(AstType.Ref _ _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires mutable struct access")))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires struct")))]))

(define (lower-tuple-field-address-from-place
  [ctx : TcContext]
  [state : LowerState]
  [base : CompilerIrValue]
  [tuple-ty : AstType]
  [index : i64]
  [origin : AstExpr]) : ResultLowerExpr
  (match (tc-type-strip-region (tc-resolve-type ctx tuple-ty))
    [(AstType.Tuple elem-tys)
      (match (lower-tuple-elem-info ctx (box-get elem-tys) index 0 0)
        [(ResultLowerFieldInfo.Ok info)
          (match info
            [(LowerFieldInfo.Info offset elem-ty)
              (match (lower-gep-byte state base offset)
                [(LowerExpr.Expr ptr-state ptr _)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      ptr-state
                      ptr
                      (tc-type-without-regions elem-ty)))])])]
        [(ResultLowerFieldInfo.Err message) (ResultLowerExpr.Err message)])]
    [(AstType.MutRef _ referent-ty)
      (match (lower-emit-load state base tuple-ty)
        [(LowerExpr.Expr ref-state ref-value _)
          (lower-tuple-field-address-from-place
            ctx
            ref-state
            ref-value
            (tc-context-type-get ctx referent-ty)
            index
            origin)])]
    [(AstType.Ref _ _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires mutable tuple access")))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: tuple-ref requires tuple place")))]))

(define (lower-mutable-array-element-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [index : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      (match (tc-array-set-receiver ctx arr-ty)
        [(ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (lower-borrow-array-element-address
                ctx
                state
                env
                type-env
                arr
                index
                origin
                (tc-type-without-regions elem-ty))])]
        [(ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

(define (lower-mutable-place-address
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [place : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (ast-expr-unspan place)
    [(AstExpr.Var name)
      (if (tc-dotted-local-field-name-id? type-env name)
        (match (tc-dotted-local-field-expr-id type-env name)
          [(ResultTcExprId.Ok virtual-id)
            (lower-mutable-place-address
              ctx
              state
              env
              type-env
              (lower-context-expr-get ctx virtual-id)
              origin)]
          [(ResultTcExprId.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr origin message)))])
        (lower-mutable-var-address-id ctx state env type-env name origin))]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        (match (lower-mutable-place-address
          ctx
          state
          env
          type-env
          receiver
          origin)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr receiver-state receiver-base receiver-ty)
                (lower-struct-field-address-from-place
                  ctx
                  receiver-state
                  receiver-base
                  receiver-ty
                  (tc-env-key-name-text field)
                  origin)])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(AstExpr.TupleRef tuple-box index)
      (let
        [tuple : AstExpr (lower-context-expr-get ctx tuple-box)]
        (match (lower-mutable-place-address ctx state env type-env tuple origin)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr tuple-state tuple-base tuple-ty)
                (lower-tuple-field-address-from-place
                  ctx
                  tuple-state
                  tuple-base
                  tuple-ty
                  index
                  origin)])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(AstExpr.ArrayRef arr-box index-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [index : AstExpr (lower-context-expr-get ctx index-box)]
        (lower-mutable-array-element-address
          ctx
          state
          env
          type-env
          arr
          index
          origin))]
    [(AstExpr.BoxGet box-box)
      (let
        [box-expr : AstExpr (lower-context-expr-get ctx box-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          box-expr)
          [(ResultTcType.Ok box-ty)
            (match (tc-box-set-inner-type ctx box-ty)
              [(ResultTcType.Ok inner-ty)
                (lower-box-storage-address
                  ctx
                  state
                  env
                  type-env
                  box-expr
                  origin
                  (tc-type-without-regions inner-ty))]
              [(ResultTcType.Err message)
                (ResultLowerExpr.Err
                  (box (lower-diagnostic-at-expr origin message)))])]
          [(ResultTcType.Err message)
            (ResultLowerExpr.Err
              (box (lower-diagnostic-at-expr box-expr message)))]))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! target must be a storage place")))]))

(define (lower-struct-field-store-result
  [ctx : TcContext]
  [state : LowerState]
  [field-ptr : CompilerIrValue]
  [value-ir : CompilerIrValue]
  [field-ir-ty : AstType]) : ResultLowerExpr
  (if (= (lower-type-size ctx field-ir-ty) 0)
    (ResultLowerExpr.Ok
      (LowerExpr.Expr state CompilerIrValue.Unit (AstType.Unit)))
    (ResultLowerExpr.Ok
      (LowerExpr.Expr
        (lower-store-inline-value-at-offset
          ctx
          state
          field-ptr
          0
          value-ir
          field-ir-ty
          (lower-type-size ctx field-ir-ty))
        CompilerIrValue.Unit
        (AstType.Unit)))))

(define (lower-store-expr-into-address-result
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [dst : CompilerIrValue]
  [value : AstExpr]
  [value-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (if (> (lower-type-size ctx value-ty) 0)
    (match (lower-direct-store-rhs-into
      ctx
      state
      env
      type-env
      dst
      value
      value-ty
      origin)
      [(LowerMaybeDirectStore.Store done-state)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr done-state CompilerIrValue.Unit (AstType.Unit)))]
      [(LowerMaybeDirectStore.Err message) (ResultLowerExpr.Err message)]
      [(LowerMaybeDirectStore.No)
        (match (lower-expr-expected
          ctx
          state
          env
          type-env
          value
          value-ty
          origin)
          [(ResultLowerExpr.Ok value-lowered)
            (match value-lowered
              [(LowerExpr.Expr value-state value-ir _)
                (lower-struct-field-store-result
                  ctx
                  value-state
                  dst
                  value-ir
                  value-ty)])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])
    (match (lower-expr-expected ctx state env type-env value value-ty origin)
      [(ResultLowerExpr.Ok value-lowered)
        (match value-lowered
          [(LowerExpr.Expr value-state value-ir _)
            (lower-struct-field-store-result
              ctx
              value-state
              dst
              value-ir
              value-ty)])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-box-set
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [box-expr : AstExpr]
  [value : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    box-expr)
    [(ResultTcType.Ok box-ty)
      (match (tc-box-set-inner-type ctx box-ty)
        [(ResultTcType.Ok inner-ty)
          (let
            [inner-ir-ty : AstType (tc-type-without-regions inner-ty)]
            (match (lower-box-storage-address
              ctx
              state
              env
              type-env
              box-expr
              origin
              inner-ir-ty)
              [(ResultLowerExpr.Ok place-lowered)
                (match place-lowered
                  [(LowerExpr.Expr place-state box-ptr _)
                    (lower-store-expr-into-address-result
                      ctx
                      place-state
                      env
                      type-env
                      box-ptr
                      value
                      inner-ir-ty
                      value)])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
        [(ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr box-expr message)))]))

(define (lower-refresh-register-resident-root-after-store
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [place : AstExpr]
  [origin : AstExpr]) : ResultLowerState
  (match (tc-move-root-projection-var-id place)
    [(TcMaybeNameId.Some root-id)
      (let
        [local-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            root-id
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? local-id)
          (match (tc-lookup-id type-env root-id)
            [(ResultTcType.Ok root-ty)
              (let
                [resolved : AstType
                  (tc-type-without-regions (tc-resolve-type ctx root-ty))]
                (if (lower-type-register-resident? ctx resolved)
                  (match (lower-state-alloc-var state)
                    [(LowerAlloc.Alloc addr-alloc addr-var)
                      (match (lower-load-register-resident-from-ptr
                        ctx
                        (lower-state-emit-at-expr
                          addr-alloc
                          (CompilerIrInstr.AddrOf addr-var local-id)
                          origin)
                        (CompilerIrValue.Var addr-var)
                        resolved)
                        [(LowerExpr.Expr load-state loaded _)
                          (ResultLowerState.Ok
                            (lower-state-emit-at-expr
                              load-state
                              (CompilerIrInstr.Mov local-id loaded resolved)
                              origin))])])
                  (ResultLowerState.Ok state)))]
            [(ResultTcType.Err message)
              (ResultLowerState.Err
                (box (lower-diagnostic-at-expr origin message)))])
          (ResultLowerState.Ok state)))]
    [(TcMaybeNameId.No) (ResultLowerState.Ok state)]))

(define (lower-register-resident-local-place?
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [receiver : AstExpr]
  [receiver-ty : AstType]) : bool
  (if (lower-type-register-resident? ctx receiver-ty)
    (match (ast-expr-unspan receiver)
      [(AstExpr.Var name) (sym_i64_env.sym-i64-contains-id env name)]
      [_ false])
    false))

(define (lower-reload-register-resident-local-from-storage
  [ctx : TcContext]
  [state : LowerState]
  [storage-ptr : CompilerIrValue]
  [local-id : i64]
  [receiver-ir-ty : AstType]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-load-register-resident-from-ptr
    ctx
    state
    storage-ptr
    receiver-ir-ty)
    [(LowerExpr.Expr load-state loaded _)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr
            load-state
            (CompilerIrInstr.Mov local-id loaded receiver-ir-ty)
            origin)
          CompilerIrValue.Unit
          (AstType.Unit)))]))

(define (lower-struct-set-register-resident-local
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [receiver : AstExpr]
  [receiver-ty : AstType]
  [field : String]
  [field-ir-ty : AstType]
  [value : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (ast-expr-unspan receiver)
    [(AstExpr.Var name)
      (let
        [local-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? local-id)
          (let
            [receiver-ir-ty : AstType
              (tc-type-without-regions (tc-resolve-type ctx receiver-ty))]
            [receiver-size : i64 (lower-type-size ctx receiver-ir-ty)]
            (match (lower-reserve-inline-storage
              state
              (if (= receiver-size 0)
                1
                receiver-size)
              receiver-ir-ty)
              [(LowerExpr.Expr storage-state storage-ptr _)
                (let
                  [stored-root-state : LowerState
                    (if (= receiver-size 0)
                      storage-state
                      (lower-store-inline-value-at-offset
                        ctx
                        storage-state
                        storage-ptr
                        0
                        (CompilerIrValue.Var local-id)
                        receiver-ir-ty
                        receiver-size))]
                  (match (lower-struct-field-address-from-place
                    ctx
                    stored-root-state
                    storage-ptr
                    receiver-ir-ty
                    field
                    origin)
                    [(ResultLowerExpr.Ok place-lowered)
                      (match place-lowered
                        [(LowerExpr.Expr place-state field-ptr _)
                          (match (lower-store-expr-into-address-result
                            ctx
                            place-state
                            env
                            type-env
                            field-ptr
                            value
                            field-ir-ty
                            value)
                            [(ResultLowerExpr.Ok stored-field)
                              (match stored-field
                                [(LowerExpr.Expr store-state _ _)
                                  (lower-reload-register-resident-local-from-storage
                                    ctx
                                    store-state
                                    storage-ptr
                                    local-id
                                    receiver-ir-ty
                                    origin)])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)])])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)]))]))
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                "lower: set! struct field requires local storage")))))]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: set! struct field requires local storage")))]))

(define (lower-struct-set
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [receiver : AstExpr]
  [field-id : i64]
  [value : AstExpr]
  [origin : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    receiver)
    [(ResultTcType.Ok receiver-ty)
      (match (tc-struct-set-field-type-id ctx receiver-ty field-id)
        [(ResultTcType.Ok field-ty)
          (let
            [field : String (tc-env-key-name-text field-id)]
            [field-ir-ty : AstType (tc-type-without-regions field-ty)]
            (if (lower-register-resident-local-place?
              ctx
              env
              receiver
              receiver-ty)
              (lower-struct-set-register-resident-local
                ctx
                state
                env
                type-env
                receiver
                receiver-ty
                field
                field-ir-ty
                value
                origin)
              (match (lower-mutable-place-address
                ctx
                state
                env
                type-env
                receiver
                origin)
                [(ResultLowerExpr.Ok place-lowered)
                  (match place-lowered
                    [(LowerExpr.Expr place-state place-ptr place-ty)
                      (match (lower-struct-field-address-from-place
                        ctx
                        place-state
                        place-ptr
                        place-ty
                        field
                        origin)
                        [(ResultLowerExpr.Ok field-lowered)
                          (match field-lowered
                            [(LowerExpr.Expr field-state field-ptr _)
                              (match (lower-store-expr-into-address-result
                                ctx
                                field-state
                                env
                                type-env
                                field-ptr
                                value
                                field-ir-ty
                                value)
                                [(ResultLowerExpr.Ok stored)
                                  (match stored
                                    [(LowerExpr.Expr store-state _ _)
                                      (match (lower-refresh-register-resident-root-after-store
                                        ctx
                                        store-state
                                        env
                                        type-env
                                        receiver
                                        origin)
                                        [(ResultLowerState.Ok refreshed-state)
                                          (ResultLowerExpr.Ok
                                            (LowerExpr.Expr
                                              refreshed-state
                                              CompilerIrValue.Unit
                                              (AstType.Unit)))]
                                        [(ResultLowerState.Err message)
                                          (ResultLowerExpr.Err message)])])]
                                [(ResultLowerExpr.Err message)
                                  (ResultLowerExpr.Err message)])])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))]
        [(ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr receiver message)))]))

(define (lower-array-set
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [index : AstExpr]
  [value : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      (match (tc-array-set-receiver ctx arr-ty)
        [(ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(TcArrayReceiver container-ty elem-ty)
              (let
                [elem-ir-ty : AstType (tc-type-without-regions elem-ty)]
                (match (lower-expr ctx state env type-env arr)
                  [(ResultLowerExpr.Ok arr-lowered)
                    (match arr-lowered
                      [(LowerExpr.Expr arr-state arr-value _)
                        (match (lower-index-result-type-or-check
                          ctx
                          env
                          type-env
                          (lower-state-type-cache arr-state)
                          index)
                          [(ResultTcType.Ok idx-ty)
                            (match (lower-expr-expected
                              ctx
                              arr-state
                              env
                              type-env
                              index
                              idx-ty
                              index)
                              [(ResultLowerExpr.Ok idx-lowered)
                                (match idx-lowered
                                  [(LowerExpr.Expr
                                      idx-state
                                      idx-value
                                      idx-value-ty)
                                    (match (lower-array-set-direct-store
                                      ctx
                                      idx-state
                                      env
                                      type-env
                                      arr
                                      arr-value
                                      idx-value
                                      idx-value-ty
                                      container-ty
                                      elem-ir-ty
                                      value)
                                      [(LowerMaybeDirectStore.Store
                                          direct-state)
                                        (ResultLowerExpr.Ok
                                          (LowerExpr.Expr
                                            direct-state
                                            CompilerIrValue.Unit
                                            (AstType.Unit)))]
                                      [(LowerMaybeDirectStore.Err message)
                                        (ResultLowerExpr.Err message)]
                                      [(LowerMaybeDirectStore.No)
                                        (match (lower-expr-expected
                                          ctx
                                          idx-state
                                          env
                                          type-env
                                          value
                                          elem-ir-ty
                                          value)
                                          [(ResultLowerExpr.Ok value-lowered)
                                            (match value-lowered
                                              [(LowerExpr.Expr
                                                  value-state
                                                  value-ir
                                                  _)
                                                (lower-array-set-store-materialized
                                                  ctx
                                                  value-state
                                                  arr
                                                  arr-value
                                                  idx-value
                                                  idx-value-ty
                                                  container-ty
                                                  elem-ir-ty
                                                  value-ir)])]
                                          [(ResultLowerExpr.Err message)
                                            (ResultLowerExpr.Err message)])])])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)])]
                          [(ResultTcType.Err message)
                            (ResultLowerExpr.Err
                              (box (lower-diagnostic-at-expr index message)))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))])]
        [(ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

;; Copy old dynamic-array elements into a freshly allocated buffer. The loop is
;; emitted as explicit IR so `array-push!` works for runtime lengths.
(define (lower-array-push-copy-loop
  [ctx : TcContext]
  [state : LowerState]
  [old-buf : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [old-len : CompilerIrValue]
  [elem-ty : AstType]) : LowerState
  (match (lower-state-fresh-label state "array_push_copy_header")
    [(LowerLabel.Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "array_push_copy_body")
        [(LowerLabel.Label body-label-state body-label)
          (match (lower-state-fresh-label
            body-label-state
            "array_push_copy_exit")
            [(LowerLabel.Label exit-label-state exit-label)
              (match (lower-state-alloc-var exit-label-state)
                [(LowerAlloc.Alloc index-alloc index-var)
                  (let
                    [header-start : LowerState
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            index-alloc
                            (CompilerIrInstr.Mov
                              index-var
                              (CompilerIrValue.I64 0)
                              (AstType.I64)))
                          (CompilerIrInstr.Jump header-label))
                        header-label)]
                    (match (lower-state-alloc-var header-start)
                      [(LowerAlloc.Alloc cond-alloc cond-var)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                (lower-state-emit
                                  cond-alloc
                                  (CompilerIrInstr.BinOp
                                    cond-var
                                    CompilerIrBinOp.Lt
                                    (CompilerIrValue.Var index-var)
                                    old-len
                                    (AstType.I64)))
                                (CompilerIrInstr.Branch
                                  (CompilerIrValue.Var cond-var)
                                  body-label
                                  exit-label))
                              body-label)]
                          (match (lower-emit-elem-addr-gep
                            ctx
                            body-start
                            old-buf
                            (CompilerIrValue.Var index-var)
                            elem-ty)
                            [(LowerExpr.Expr src-gep-state src-ptr _)
                              (match (lower-load-inline-value-at-offset
                                ctx
                                src-gep-state
                                src-ptr
                                0
                                elem-ty
                                (lower-state-mode src-gep-state))
                                [(LowerExpr.Expr load-state elem-value _)
                                  (match (lower-emit-elem-addr-gep
                                    ctx
                                    load-state
                                    new-buf
                                    (CompilerIrValue.Var index-var)
                                    elem-ty)
                                    [(LowerExpr.Expr dst-gep-state dst-ptr _)
                                      (match (lower-state-alloc-var
                                        (lower-array-elem-store-state
                                          ctx
                                          dst-gep-state
                                          dst-ptr
                                          elem-value
                                          elem-ty))
                                        [(LowerAlloc.Alloc inc-alloc inc-var)
                                          (lower-state-finish-block
                                            (lower-state-emit
                                              (lower-state-emit
                                                (lower-state-emit
                                                  inc-alloc
                                                  (CompilerIrInstr.BinOp
                                                    inc-var
                                                    CompilerIrBinOp.Add
                                                    (CompilerIrValue.Var
                                                      index-var)
                                                    (CompilerIrValue.I64 1)
                                                    (AstType.I64)))
                                                (CompilerIrInstr.Mov
                                                  index-var
                                                  (CompilerIrValue.Var inc-var)
                                                  (AstType.I64)))
                                              (CompilerIrInstr.Jump
                                                header-label))
                                            exit-label)])])])]))]))])])])]))

(define (lower-array-push-finish
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [old-buf : CompilerIrValue]
  [old-len : CompilerIrValue]
  [new-buf : CompilerIrValue]
  [new-len : CompilerIrValue]
  [elem-ty : AstType]
  [value-ir : CompilerIrValue]) : LowerExpr
  (match (lower-emit-elem-addr-gep
    ctx
    (lower-array-push-copy-loop ctx state old-buf new-buf old-len elem-ty)
    new-buf
    old-len
    elem-ty)
    [(LowerExpr.Expr tail-gep-state tail-ptr _)
      (LowerExpr.Expr
        (lower-store-at-offset
          (lower-store-at-offset
            (lower-array-elem-store-state
              ctx
              tail-gep-state
              tail-ptr
              value-ir
              elem-ty)
            arr-value
            0
            new-buf
            (AstType.U64))
          arr-value
          8
          new-len
          (AstType.I64))
        CompilerIrValue.Unit
        (AstType.Unit))]))

(define (lower-array-push-alloc-buffer
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [old-buf : CompilerIrValue]
  [old-len : CompilerIrValue]
  [elem-size : i64]
  [elem-ty : AstType]
  [value-ir : CompilerIrValue]) : LowerExpr
  (match (lower-emit-binop
    state
    CompilerIrBinOp.Add
    old-len
    (CompilerIrValue.I64 1)
    (AstType.I64))
    [(LowerExpr.Expr len-state new-len _)
      (match (lower-emit-binop
        len-state
        CompilerIrBinOp.Mul
        new-len
        (CompilerIrValue.I64 elem-size)
        (AstType.I64))
        [(LowerExpr.Expr byte-state byte-count _)
          (match (lower-state-alloc-var byte-state)
            [(LowerAlloc.Alloc buf-alloc buf-var)
              (lower-array-push-finish
                ctx
                (lower-state-emit
                  buf-alloc
                  (CompilerIrInstr.Call
                    buf-var
                    (lower-tl-alloc-symbol)
                    (CompilerIrCallArgs.One byte-count)
                    (AstType.U64)))
                arr-value
                old-buf
                old-len
                (CompilerIrValue.Var buf-var)
                new-len
                elem-ty
                value-ir)])])]))

(define (lower-array-push-after-max-check
  [ctx : TcContext]
  [state : LowerState]
  [fail-label : String]
  [alloc-label : String]
  [arr-value : CompilerIrValue]
  [old-buf : CompilerIrValue]
  [old-len : CompilerIrValue]
  [elem-size : i64]
  [elem-ty : AstType]
  [value-ir : CompilerIrValue]) : LowerExpr
  (let
    [fail-start : LowerState (lower-state-finish-block state fail-label)]
    [alloc-start : LowerState
      (lower-state-finish-block
        (lower-state-emit
          (lower-oob-abort fail-start)
          (CompilerIrInstr.Jump alloc-label))
        alloc-label)]
    (lower-array-push-alloc-buffer
      ctx
      alloc-start
      arr-value
      old-buf
      old-len
      elem-size
      elem-ty
      value-ir)))

(define (lower-array-push-from-values
  [ctx : TcContext]
  [state : LowerState]
  [arr-value : CompilerIrValue]
  [elem-ty : AstType]
  [value-ir : CompilerIrValue]) : LowerExpr
  (match (lower-load-at-offset state arr-value 8 (AstType.I64))
    [(LowerExpr.Expr len-state old-len _)
      (match (lower-load-at-offset len-state arr-value 0 (AstType.U64))
        [(LowerExpr.Expr buf-state old-buf _)
          (let
            [elem-size : i64 (lower-type-size ctx elem-ty)]
            [max-old-len : i64
              (if (= elem-size 0)
                9223372036854775806
                (- (/ 9223372036854775807 elem-size) 1))]
            (match (lower-state-fresh-label buf-state "array_push_alloc")
              [(LowerLabel.Label alloc-label-state alloc-label)
                (match (lower-state-fresh-label
                  alloc-label-state
                  "array_push_fail")
                  [(LowerLabel.Label fail-label-state fail-label)
                    (match (lower-emit-binop
                      fail-label-state
                      CompilerIrBinOp.Le
                      old-len
                      (CompilerIrValue.I64 max-old-len)
                      (AstType.I64))
                      [(LowerExpr.Expr check-state within-max _)
                        (lower-array-push-after-max-check
                          ctx
                          (lower-state-emit
                            check-state
                            (CompilerIrInstr.Branch
                              within-max
                              alloc-label
                              fail-label))
                          fail-label
                          alloc-label
                          arr-value
                          old-buf
                          old-len
                          elem-size
                          elem-ty
                          value-ir)])])]))])]))

;; `(array-push! arr value)` -> allocate a new element buffer in the active
;; arena, copy old elements, append `value`, and update the fat `{ptr, len}`.
(define (lower-array-push
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arr : AstExpr]
  [value : AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    arr)
    [(ResultTcType.Ok arr-ty)
      (match (tc-array-push-receiver ctx arr-ty)
        [(ResultTcArrayReceiver.Ok receiver)
          (match receiver
            [(TcArrayReceiver _ elem-ty)
              (let
                [elem-ir-ty : AstType (tc-type-without-regions elem-ty)]
                (match (lower-expr ctx state env type-env arr)
                  [(ResultLowerExpr.Ok arr-lowered)
                    (match arr-lowered
                      [(LowerExpr.Expr arr-state arr-value _)
                        (match (lower-expr-expected
                          ctx
                          arr-state
                          env
                          type-env
                          value
                          elem-ir-ty
                          value)
                          [(ResultLowerExpr.Ok value-lowered)
                            (match value-lowered
                              [(LowerExpr.Expr value-state value-ir _)
                                (ResultLowerExpr.Ok
                                  (lower-array-push-from-values
                                    ctx
                                    value-state
                                    arr-value
                                    elem-ir-ty
                                    value-ir))])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))])]
        [(ResultTcArrayReceiver.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))])]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr arr message)))]))

;; Lower each syscall operand and widen it to i64 (the kernel reads the full
;; 64-bit registers). Mirrors `lower-args` but inserts the cast.
(define (lower-syscall-args
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]) : ResultLowerArgs
  (lower-syscall-args-at ctx state env type-env (& args) 0))

(define (lower-syscall-args-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : (& args AstExprList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index (struct-get args len))
    (ResultLowerArgs.Ok state CompilerIrValueList.Nil)
    (let
      [arg : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get args index 0))]
      (match (lower-expr ctx state env type-env arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state value value-ty)
              (match (lower-cast-value arg-state value value-ty (AstType.I64))
                [(LowerExpr.Expr cast-state cast-value _)
                  (match (lower-syscall-args-at
                    ctx
                    cast-state
                    env
                    type-env
                    args
                    (+ index 1))
                    [(ResultLowerArgs.Ok rest-state rest-values)
                      (ResultLowerArgs.Ok
                        rest-state
                        (compiler-ir-value-cons cast-value rest-values))]
                    [(ResultLowerArgs.Err message)
                      (ResultLowerArgs.Err message)])])])]
        [(ResultLowerExpr.Err message) (ResultLowerArgs.Err message)]))))

(define (lower-syscall
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]) : ResultLowerExpr
  (match (lower-syscall-args ctx state env type-env args)
    [(ResultLowerArgs.Ok args-state values)
      (match (lower-state-alloc-var args-state)
        [(LowerAlloc.Alloc allocated var-id)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-state-emit
                allocated
                (CompilerIrInstr.Syscall
                  var-id
                  (compiler-ir-call-args-from-list values)))
              (CompilerIrValue.Var var-id)
              (AstType.I64)))])]
    [(ResultLowerArgs.Err message) (ResultLowerExpr.Err message)]))

(define (lower-args
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : AstExprList]) : ResultLowerArgs
  (lower-args-at ctx state env type-env (& args) 0))

(define (lower-args-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [args : (& args AstExprList)]
  [index : i64]) : ResultLowerArgs
  (if (>= index (struct-get args len))
    (ResultLowerArgs.Ok state CompilerIrValueList.Nil)
    (let
      [arg : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get args index 0))]
      (match (lower-expr ctx state env type-env arg)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr arg-state value _)
              (match (lower-args-at ctx arg-state env type-env args (+ index 1))
                [(ResultLowerArgs.Ok rest-state rest-values)
                  (ResultLowerArgs.Ok
                    rest-state
                    (compiler-ir-value-cons value rest-values))]
                [(ResultLowerArgs.Err message) (ResultLowerArgs.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerArgs.Err message)]))))

(define (lower-let-binding-type
  [ctx : TcContext]
  [maybe-ty : AstMaybeType]
  [init-ty : AstType]) : AstType
  (match maybe-ty
    [(AstMaybeType.Some ty) (tc-type-without-regions (tc-resolve-type ctx ty))]
    [(AstMaybeType.No) (tc-type-without-regions init-ty)]))

(define (lower-let-init
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]) : ResultLowerExpr
  (match maybe-ty
    [(AstMaybeType.Some ty)
      (if (tc-ref-capturing-lambda-init? type-env init)
        (match (ast-expr-unspan init)
          [(AstExpr.Lambda lambda-box)
            (match (box-get lambda-box)
              [(AstLambda.Lambda params lambda-ret body-box)
                (let
                  [body : AstExpr (lower-context-expr-get ctx body-box)]
                  [expected-ty : AstType
                    (tc-type-without-regions (tc-resolve-type ctx ty))]
                  (match (lower-lambda
                    ctx
                    state
                    env
                    type-env
                    params
                    lambda-ret
                    body
                    init
                    expected-ty)
                    [(ResultLowerExpr.Ok lowered)
                      (match lowered
                        [(LowerExpr.Expr next-state value actual-ty)
                          (ResultLowerExpr.Ok
                            (lower-coerce-value
                              next-state
                              value
                              actual-ty
                              expected-ty))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)]))])]
          [_
            (lower-expr-expected
              ctx
              state
              env
              type-env
              init
              (tc-type-without-regions (tc-resolve-type ctx ty))
              init)])
        (lower-expr-expected
          ctx
          state
          env
          type-env
          init
          (tc-type-without-regions (tc-resolve-type ctx ty))
          init))]
    [(AstMaybeType.No)
      (if (tc-ref-capturing-lambda-init? type-env init)
        (match (ast-expr-unspan init)
          [(AstExpr.Lambda lambda-box)
            (match (box-get lambda-box)
              [(AstLambda.Lambda params lambda-ret body-box)
                (let
                  [body : AstExpr (lower-context-expr-get ctx body-box)]
                  (match (tc-lambda-expr-allow-ref-captures
                    ctx
                    type-env
                    params
                    lambda-ret
                    body)
                    [(ResultTcType.Ok lambda-ty)
                      (lower-lambda
                        ctx
                        state
                        env
                        type-env
                        params
                        lambda-ret
                        body
                        init
                        lambda-ty)]
                    [(ResultTcType.Err message)
                      (ResultLowerExpr.Err
                        (box (lower-diagnostic-at-expr init message)))]))])]
          [_ (lower-expr ctx state env type-env init)])
        (lower-expr ctx state env type-env init))]))

(define (lower-let-bindings
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstLetBindingList]) : ResultLowerEnv
  (lower-let-bindings-at ctx state env type-env (& bindings) 0))

(define (lower-let-bindings-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : ResultLowerEnv
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultLowerEnv.Ok state env type-env)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [name-id : i64 name]
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          (match (lower-let-init ctx state env type-env maybe-ty init)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr init-state init-value init-ty)
                  (let
                    [binding-ty : AstType
                      (lower-let-binding-type ctx maybe-ty init-ty)]
                    [binding-ir-ty : AstType
                      (lower-one-word-register-storage-type ctx binding-ty)]
                    (match (lower-state-alloc-var init-state)
                      [(LowerAlloc.Alloc allocated var-id)
                        (let
                          [next-type-env : TcTypeEnv
                            (tc-bind-c-abi-fnptr-if-needed-id
                              ctx
                              type-env
                              name-id
                              binding-ty
                              init)]
                          (lower-let-bindings-at
                            ctx
                            (lower-state-emit
                              allocated
                              (CompilerIrInstr.Mov
                                var-id
                                init-value
                                binding-ir-ty))
                            (sym_i64_env.sym-i64-bind-id env name-id var-id)
                            next-type-env
                            bindings
                            (+ index 1)))]))])]
            [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)]))])))

(define (lower-resource-bindings
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstResourceBindingList]
  [cleanups : LowerCleanupStack]) : ResultLowerResourceBindings
  (lower-resource-bindings-at ctx state env type-env (& bindings) cleanups 0))

(define (lower-resource-bindings-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : (& bindings AstResourceBindingList)]
  [cleanups : LowerCleanupStack]
  [index : i64]) : ResultLowerResourceBindings
  (if (>= index (ast-resource-binding-list-len bindings))
    (ResultLowerResourceBindings.Ok
      (LowerResourceBindings.Bindings state env type-env cleanups))
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box cleanup-box move-aware?)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          [cleanup : AstExpr (lower-context-expr-get ctx cleanup-box)]
          (match (tc-resource-cleanup-resource-type ctx type-env cleanup)
            [(ResultTcType.Ok expected-init-ty)
              (match (lower-expr-expected
                ctx
                state
                env
                type-env
                init
                (tc-type-without-regions expected-init-ty)
                init)
                [(ResultLowerExpr.Ok lowered)
                  (match lowered
                    [(LowerExpr.Expr init-state init-value init-ty)
                      (match (lower-cleanup-name-id-from-expr cleanup)
                        [(ResultTcExprId.Ok cleanup-name-id)
                          (let
                            [binding-ty : AstType
                              (tc-type-without-regions init-ty)]
                            [binding-ir-ty : AstType
                              (lower-one-word-register-storage-type
                                ctx
                                binding-ty)]
                            (match (lower-state-alloc-var init-state)
                              [(LowerAlloc.Alloc allocated var-id)
                                (let
                                  [hidden-name-id : i64
                                    (lower-cleanup-hidden-name-id var-id)]
                                  [bound-state : LowerState
                                    (lower-state-emit
                                      allocated
                                      (CompilerIrInstr.Mov
                                        var-id
                                        init-value
                                        binding-ir-ty))]
                                  [bound-env : sym_i64_env.SymI64Env
                                    (sym_i64_env.sym-i64-bind-id
                                      (sym_i64_env.sym-i64-bind-id
                                        env
                                        name
                                        var-id)
                                      hidden-name-id
                                      var-id)]
                                  [bound-type-env : TcTypeEnv
                                    (lower-type-env-push-cleanup
                                      (tc-bind-id type-env name binding-ty)
                                      hidden-name-id
                                      cleanup-name-id)]
                                  (if move-aware?
                                    (match (lower-state-alloc-var bound-state)
                                      [(LowerAlloc.Alloc live-state live-var-id)
                                        (let
                                          [live-name-id : i64
                                            (lower-cleanup-live-name-id var-id)]
                                          (lower-resource-bindings-at
                                            ctx
                                            (lower-state-emit
                                              live-state
                                              (CompilerIrInstr.Mov
                                                live-var-id
                                                (CompilerIrValue.Bool true)
                                                (AstType.Bool)))
                                            (sym_i64_env.sym-i64-bind-id
                                              bound-env
                                              live-name-id
                                              live-var-id)
                                            (lower-type-env-push-move-aware-cleanup
                                              (tc-bind-id
                                                type-env
                                                name
                                                binding-ty)
                                              hidden-name-id
                                              cleanup-name-id
                                              live-name-id)
                                            bindings
                                            (lower-cleanup-stack-push-move-aware
                                              cleanups
                                              hidden-name-id
                                              cleanup-name-id
                                              live-name-id)
                                            (+ index 1)))])
                                    (lower-resource-bindings-at
                                      ctx
                                      bound-state
                                      bound-env
                                      bound-type-env
                                      bindings
                                      (lower-cleanup-stack-push
                                        cleanups
                                        hidden-name-id
                                        cleanup-name-id)
                                      (+ index 1))))]))]
                        [(ResultTcExprId.Err message)
                          (ResultLowerResourceBindings.Err
                            (box (lower-diagnostic-at-expr cleanup message)))])])]
                [(ResultLowerExpr.Err message)
                  (ResultLowerResourceBindings.Err message)])]
            [(ResultTcType.Err message)
              (ResultLowerResourceBindings.Err
                (box (lower-diagnostic-at-expr cleanup message)))]))])))

(define (lower-with-resource
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [bindings : AstResourceBindingList]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-resource-bindings
    ctx
    state
    env
    type-env
    bindings
    (lower-cleanup-stack-empty))
    [(ResultLowerResourceBindings.Ok lowered-bindings)
      (match lowered-bindings
        [(LowerResourceBindings.Bindings
            binding-state
            body-env
            body-type-env
            cleanups)
          (match (lower-begin ctx binding-state body-env body-type-env body)
            [(ResultLowerExpr.Ok lowered-body)
              (match lowered-body
                [(LowerExpr.Expr body-state value body-ty)
                  (if (tc-never-type? body-ty)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr body-state value body-ty))
                    (match (lower-emit-cleanup-stack
                      body-state
                      body-env
                      cleanups)
                      [(ResultLowerState.Ok cleanup-state)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr cleanup-state value body-ty))]
                      [(ResultLowerState.Err message)
                        (ResultLowerExpr.Err message)]))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerResourceBindings.Err message) (ResultLowerExpr.Err message)]))

(define (lower-begin
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]) : ResultLowerExpr
  (lower-begin-at ctx state env type-env (& exprs) 0))

(define (lower-begin-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultLowerExpr
  (let
    [len : i64 (struct-get exprs len)]
    (if (>= index len)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr state CompilerIrValue.Unit (AstType.Unit)))
      (let
        [expr : AstExpr
          (lower-context-expr-get ctx (ast-expr-list-get exprs index 0))]
        (if (= (+ index 1) len)
          (lower-expr ctx state env type-env expr)
          (match (lower-expr ctx state env type-env expr)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr next-state _ expr-ty)
                  (if (tc-never-type? expr-ty)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr
                        next-state
                        CompilerIrValue.Unit
                        (AstType.Never)))
                    (lower-begin-at
                      ctx
                      next-state
                      env
                      type-env
                      exprs
                      (+ index 1)))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))))

(define (lower-begin-expected
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : AstExprList]
  [expected-ty : AstType]) : ResultLowerExpr
  (lower-begin-expected-at ctx state env type-env (& exprs) 0 expected-ty))

(define (lower-begin-expected-at
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [expected-ty : AstType]) : ResultLowerExpr
  (let
    [len : i64 (struct-get exprs len)]
    (if (>= index len)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr state CompilerIrValue.Unit (AstType.Unit)))
      (let
        [expr : AstExpr
          (lower-context-expr-get ctx (ast-expr-list-get exprs index 0))]
        (if (= (+ index 1) len)
          (lower-expr-expected ctx state env type-env expr expected-ty expr)
          (match (lower-expr ctx state env type-env expr)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr next-state _ expr-ty)
                  (if (tc-never-type? expr-ty)
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr
                        next-state
                        CompilerIrValue.Unit
                        (AstType.Never)))
                    (lower-begin-expected-at
                      ctx
                      next-state
                      env
                      type-env
                      exprs
                      (+ index 1)
                      expected-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))))

(define (lower-with-arena
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc mark-allocated mark-var)
      (let
        [hidden-name-id : i64 (lower-region-hidden-name-id mark-var)]
        [marked-state : LowerState
          (lower-state-emit
            mark-allocated
            (CompilerIrInstr.Call
              mark-var
              (lower-tl-region-mark-symbol)
              (CompilerIrCallArgs.Nil)
              (AstType.U64)))]
        [region-env : SymI64Env
          (sym_i64_env.sym-i64-bind-id env hidden-name-id mark-var)]
        [region-type-env : TcTypeEnv
          (lower-type-env-push-region-reset type-env hidden-name-id)]
        (match (lower-begin ctx marked-state region-env region-type-env body)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr body-state value body-ty)
                (if (tc-never-type? body-ty)
                  (ResultLowerExpr.Ok (LowerExpr.Expr body-state value body-ty))
                  (match (lower-state-alloc-var body-state)
                    [(LowerAlloc.Alloc reset-allocated reset-var)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-state-emit
                            reset-allocated
                            (CompilerIrInstr.Call
                              reset-var
                              (lower-tl-region-reset-symbol)
                              (CompilerIrCallArgs.One
                                (CompilerIrValue.Var mark-var))
                              (AstType.Unit)))
                          value
                          body-ty))]))])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]))

(define (lower-arena-handle
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arena : AstExpr]
  [form : String]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env arena)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr arena-state arena-value arena-ty)
          (if (tc-arena-type? ctx arena-ty)
            (lower-struct-get-named
              ctx
              arena-state
              arena-value
              (lower-struct-type-name-id-or (tc-resolve-type ctx arena-ty) -1)
              (lower-struct-type-name-or-empty (tc-resolve-type ctx arena-ty))
              cbi.compiler-builtin-id-fix-handle
              "handle"
              (AstType.I64))
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic
                  (str_cat.str-cat "lower: " form " arena must be Arena")))))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-in-arena
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [arena : AstExpr]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc saved-allocated saved-var)
      (let
        [saved-state : LowerState
          (lower-state-emit
            saved-allocated
            (CompilerIrInstr.Call
              saved-var
              (lower-tl-arena-current-symbol)
              CompilerIrCallArgs.Nil
              (AstType.I64)))]
        (match (lower-arena-handle
          ctx
          saved-state
          env
          type-env
          arena
          "in-arena")
          [(ResultLowerExpr.Ok arena-lowered)
            (match arena-lowered
              [(LowerExpr.Expr arena-state arena-value _)
                (match (lower-runtime-call-values
                  arena-state
                  (lower-tl-arena-set-symbol)
                  (compiler-ir-value-cons arena-value CompilerIrValueList.Nil)
                  (AstType.Unit))
                  [(ResultLowerExpr.Ok set-lowered)
                    (match set-lowered
                      [(LowerExpr.Expr set-state _ _)
                        (let
                          [hidden-name-id : i64
                            (lower-arena-restore-hidden-name-id saved-var)]
                          [body-env : sym_i64_env.SymI64Env
                            (sym_i64_env.sym-i64-bind-id
                              env
                              hidden-name-id
                              saved-var)]
                          [body-type-env : TcTypeEnv
                            (lower-type-env-push-arena-restore
                              type-env
                              hidden-name-id)]
                          (match (lower-begin
                            ctx
                            set-state
                            body-env
                            body-type-env
                            body)
                            [(ResultLowerExpr.Ok body-lowered)
                              (match body-lowered
                                [(LowerExpr.Expr body-state value body-ty)
                                  (if (tc-never-type? body-ty)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr body-state value body-ty))
                                    (match (lower-runtime-call-values
                                      body-state
                                      (lower-tl-arena-set-symbol)
                                      (compiler-ir-value-cons
                                        (CompilerIrValue.Var saved-var)
                                        CompilerIrValueList.Nil)
                                      (AstType.Unit))
                                      [(ResultLowerExpr.Ok restore-lowered)
                                        (match restore-lowered
                                          [(LowerExpr.Expr restore-state _ _)
                                            (ResultLowerExpr.Ok
                                              (LowerExpr.Expr
                                                restore-state
                                                value
                                                body-ty))])]
                                      [(ResultLowerExpr.Err message)
                                        (ResultLowerExpr.Err message)]))])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)]))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]))

(define (lower-with-escape-final
  [final-lowered : LowerExpr]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match final-lowered
    [(LowerExpr.Expr final-state _ _)
      (ResultLowerExpr.Ok (LowerExpr.Expr final-state escaped-value escaped-ty))]))

(define (lower-with-escape-rewind
  [state : LowerState]
  [mark-value : CompilerIrValue]
  [new-enclosing-value : CompilerIrValue]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-region-reset-symbol)
    (compiler-ir-value-cons mark-value CompilerIrValueList.Nil)
    (AstType.Unit))
    [(ResultLowerExpr.Ok rewind-lowered)
      (match rewind-lowered
        [(LowerExpr.Expr rewind-state _ _)
          (match (lower-runtime-call-values
            rewind-state
            (lower-tl-arena-set-symbol)
            (compiler-ir-value-cons new-enclosing-value CompilerIrValueList.Nil)
            (AstType.Unit))
            [(ResultLowerExpr.Ok final-lowered)
              (lower-with-escape-final final-lowered escaped-value escaped-ty)]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-escape-cleanup
  [state : LowerState]
  [scratch-head-value : CompilerIrValue]
  [mark-value : CompilerIrValue]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-current-symbol)
    CompilerIrValueList.Nil
    (AstType.I64))
    [(ResultLowerExpr.Ok new-enclosing-lowered)
      (match new-enclosing-lowered
        [(LowerExpr.Expr new-enclosing-state new-enclosing-value _)
          (match (lower-runtime-call-values
            new-enclosing-state
            (lower-tl-arena-set-symbol)
            (compiler-ir-value-cons scratch-head-value CompilerIrValueList.Nil)
            (AstType.Unit))
            [(ResultLowerExpr.Ok restore-scratch-lowered)
              (match restore-scratch-lowered
                [(LowerExpr.Expr restore-scratch-state _ _)
                  (lower-with-escape-rewind
                    restore-scratch-state
                    mark-value
                    new-enclosing-value
                    escaped-value
                    escaped-ty)])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-escape-clone
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scratch-head-value : CompilerIrValue]
  [mark-value : CompilerIrValue]
  [body-value : CompilerIrValue]
  [body-ty : AstType]) : ResultLowerExpr
  (match (lower-clone-dispatch ctx state env type-env body-value body-ty)
    [(ResultLowerExpr.Ok escaped-lowered)
      (match escaped-lowered
        [(LowerExpr.Expr escaped-state escaped-value escaped-ty)
          (lower-with-escape-cleanup
            escaped-state
            scratch-head-value
            mark-value
            escaped-value
            escaped-ty)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-escape-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [enclosing-value : CompilerIrValue]
  [mark-value : CompilerIrValue]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-begin ctx state env type-env body)
    [(ResultLowerExpr.Ok body-lowered)
      (match body-lowered
        [(LowerExpr.Expr body-state body-value body-ty)
          (match (lower-runtime-call-values
            body-state
            (lower-tl-arena-current-symbol)
            CompilerIrValueList.Nil
            (AstType.I64))
            [(ResultLowerExpr.Ok scratch-head-lowered)
              (match scratch-head-lowered
                [(LowerExpr.Expr scratch-head-state scratch-head-value _)
                  (match (lower-runtime-call-values
                    scratch-head-state
                    (lower-tl-arena-set-symbol)
                    (compiler-ir-value-cons
                      enclosing-value
                      CompilerIrValueList.Nil)
                    (AstType.Unit))
                    [(ResultLowerExpr.Ok restore-enclosing-lowered)
                      (match restore-enclosing-lowered
                        [(LowerExpr.Expr restore-state _ _)
                          (lower-with-escape-clone
                            ctx
                            restore-state
                            env
                            type-env
                            scratch-head-value
                            mark-value
                            body-value
                            body-ty)])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-escape
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scratch : AstExpr]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-current-symbol)
    CompilerIrValueList.Nil
    (AstType.I64))
    [(ResultLowerExpr.Ok enclosing-lowered)
      (match enclosing-lowered
        [(LowerExpr.Expr enclosing-state enclosing-value _)
          (match (lower-arena-handle
            ctx
            enclosing-state
            env
            type-env
            scratch
            "with-escape")
            [(ResultLowerExpr.Ok scratch-lowered)
              (match scratch-lowered
                [(LowerExpr.Expr scratch-state scratch-value _)
                  (match (lower-runtime-call-values
                    scratch-state
                    (lower-tl-arena-set-symbol)
                    (compiler-ir-value-cons
                      scratch-value
                      CompilerIrValueList.Nil)
                    (AstType.Unit))
                    [(ResultLowerExpr.Ok set-scratch-lowered)
                      (match set-scratch-lowered
                        [(LowerExpr.Expr set-scratch-state _ _)
                          (match (lower-runtime-call-values
                            set-scratch-state
                            (lower-tl-region-mark-symbol)
                            CompilerIrValueList.Nil
                            (AstType.U64))
                            [(ResultLowerExpr.Ok mark-lowered)
                              (match mark-lowered
                                [(LowerExpr.Expr mark-state mark-value _)
                                  (lower-with-escape-body
                                    ctx
                                    mark-state
                                    env
                                    type-env
                                    enclosing-value
                                    mark-value
                                    body)])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)])])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch-final-restore
  [state : LowerState]
  [new-enclosing-value : CompilerIrValue]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-set-symbol)
    (compiler-ir-value-cons new-enclosing-value CompilerIrValueList.Nil)
    (AstType.Unit))
    [(ResultLowerExpr.Ok final-lowered)
      (lower-with-escape-final final-lowered escaped-value escaped-ty)]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch-cleanup
  [state : LowerState]
  [scratch-head-value : CompilerIrValue]
  [escaped-value : CompilerIrValue]
  [escaped-ty : AstType]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-current-symbol)
    CompilerIrValueList.Nil
    (AstType.I64))
    [(ResultLowerExpr.Ok new-enclosing-lowered)
      (match new-enclosing-lowered
        [(LowerExpr.Expr new-enclosing-state new-enclosing-value _)
          (match (lower-runtime-call-values
            new-enclosing-state
            (lower-tl-arena-destroy-symbol)
            (compiler-ir-value-cons scratch-head-value CompilerIrValueList.Nil)
            (AstType.Unit))
            [(ResultLowerExpr.Ok destroy-lowered)
              (match destroy-lowered
                [(LowerExpr.Expr destroy-state _ _)
                  (lower-with-scratch-final-restore
                    destroy-state
                    new-enclosing-value
                    escaped-value
                    escaped-ty)])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch-clone
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [scratch-head-value : CompilerIrValue]
  [body-value : CompilerIrValue]
  [body-ty : AstType]) : ResultLowerExpr
  (match (lower-clone-dispatch ctx state env type-env body-value body-ty)
    [(ResultLowerExpr.Ok escaped-lowered)
      (match escaped-lowered
        [(LowerExpr.Expr escaped-state escaped-value escaped-ty)
          (lower-with-scratch-cleanup
            escaped-state
            scratch-head-value
            escaped-value
            escaped-ty)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch-body
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [enclosing-value : CompilerIrValue]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-begin ctx state env type-env body)
    [(ResultLowerExpr.Ok body-lowered)
      (match body-lowered
        [(LowerExpr.Expr body-state body-value body-ty)
          (match (lower-runtime-call-values
            body-state
            (lower-tl-arena-current-symbol)
            CompilerIrValueList.Nil
            (AstType.I64))
            [(ResultLowerExpr.Ok scratch-head-lowered)
              (match scratch-head-lowered
                [(LowerExpr.Expr scratch-head-state scratch-head-value _)
                  (match (lower-runtime-call-values
                    scratch-head-state
                    (lower-tl-arena-set-symbol)
                    (compiler-ir-value-cons
                      enclosing-value
                      CompilerIrValueList.Nil)
                    (AstType.Unit))
                    [(ResultLowerExpr.Ok restore-enclosing-lowered)
                      (match restore-enclosing-lowered
                        [(LowerExpr.Expr restore-state _ _)
                          (lower-with-scratch-clone
                            ctx
                            restore-state
                            env
                            type-env
                            scratch-head-value
                            body-value
                            body-ty)])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-with-scratch
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [body : AstExprList]) : ResultLowerExpr
  (match (lower-runtime-call-values
    state
    (lower-tl-arena-current-symbol)
    CompilerIrValueList.Nil
    (AstType.I64))
    [(ResultLowerExpr.Ok enclosing-lowered)
      (match enclosing-lowered
        [(LowerExpr.Expr enclosing-state enclosing-value _)
          (match (lower-runtime-call-values
            enclosing-state
            (lower-tl-arena-make-symbol)
            CompilerIrValueList.Nil
            (AstType.I64))
            [(ResultLowerExpr.Ok scratch-lowered)
              (match scratch-lowered
                [(LowerExpr.Expr scratch-state scratch-value _)
                  (match (lower-runtime-call-values
                    scratch-state
                    (lower-tl-arena-set-symbol)
                    (compiler-ir-value-cons
                      scratch-value
                      CompilerIrValueList.Nil)
                    (AstType.Unit))
                    [(ResultLowerExpr.Ok set-scratch-lowered)
                      (match set-scratch-lowered
                        [(LowerExpr.Expr set-scratch-state _ _)
                          (lower-with-scratch-body
                            ctx
                            set-scratch-state
                            env
                            type-env
                            enclosing-value
                            body)])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-if-merge
  [ctx : TcContext]
  [else-state : LowerState]
  [then-value : CompilerIrValue]
  [then-end-label : String]
  [else-value : CompilerIrValue]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (let
    [else-end-label : String (lower-state-current-label else-state)]
    [expr-ir-ty : AstType (lower-one-word-register-storage-type ctx expr-ty)]
    [merge-start : LowerState
      (lower-state-finish-block
        (lower-state-emit else-state (CompilerIrInstr.Jump merge-label))
        merge-label)]
    (match (lower-state-alloc-var merge-start)
      [(LowerAlloc.Alloc allocated var-id)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit
              allocated
              (CompilerIrInstr.Phi
                var-id
                (compiler-ir-phi-input-cons
                  then-value
                  then-end-label
                  (compiler-ir-phi-input-cons
                    else-value
                    else-end-label
                    CompilerIrPhiInputList.Nil))
                expr-ir-ty))
            (CompilerIrValue.Var var-id)
            expr-ty))])))

(define (lower-if-single-merge
  [state : LowerState]
  [value : CompilerIrValue]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (let
    [merge-start : LowerState
      (lower-state-finish-block
        (lower-state-emit state (CompilerIrInstr.Jump merge-label))
        merge-label)]
    (ResultLowerExpr.Ok (LowerExpr.Expr merge-start value expr-ty))))

(define (lower-if-finish
  [ctx : TcContext]
  [then-value : CompilerIrValue]
  [then-ty : AstType]
  [then-end-label : String]
  [else-state : LowerState]
  [else-value : CompilerIrValue]
  [else-ty : AstType]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (if (tc-never-type? then-ty)
    (if (tc-never-type? else-ty)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-finish-block else-state merge-label)
          CompilerIrValue.Unit
          (AstType.Never)))
      (lower-if-single-merge else-state else-value merge-label expr-ty))
    (if (tc-never-type? else-ty)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-finish-block else-state merge-label)
          then-value
          expr-ty))
      (lower-if-merge
        ctx
        else-state
        then-value
        then-end-label
        else-value
        merge-label
        expr-ty))))

(define (lower-if-else
  [ctx : TcContext]
  [else-start : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [else-branch : AstExpr]
  [then-value : CompilerIrValue]
  [then-ty : AstType]
  [then-end-label : String]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    else-start
    env
    type-env
    else-branch
    expr-ty
    else-branch)
    [(ResultLowerExpr.Ok else-lowered)
      (match else-lowered
        [(LowerExpr.Expr else-state else-value else-ty)
          (lower-if-finish
            ctx
            then-value
            then-ty
            then-end-label
            else-state
            else-value
            else-ty
            merge-label
            expr-ty)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-if-then
  [ctx : TcContext]
  [then-start : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [then-branch : AstExpr]
  [else-branch : AstExpr]
  [else-label : String]
  [merge-label : String]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-expr-expected
    ctx
    then-start
    env
    type-env
    then-branch
    expr-ty
    then-branch)
    [(ResultLowerExpr.Ok then-lowered)
      (match then-lowered
        [(LowerExpr.Expr then-state then-value then-ty)
          (let
            [then-end-label : String (lower-state-current-label then-state)]
            [else-start : LowerState
              (if (tc-never-type? then-ty)
                (lower-state-finish-block then-state else-label)
                (lower-state-finish-block
                  (lower-state-emit
                    then-state
                    (CompilerIrInstr.Jump merge-label))
                  else-label))]
            (lower-if-else
              ctx
              else-start
              env
              type-env
              else-branch
              then-value
              then-ty
              then-end-label
              merge-label
              expr-ty))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-if
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [cond : AstExpr]
  [then-branch : AstExpr]
  [else-branch : AstExpr]
  [expr-ty : AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env cond)
    [(ResultLowerExpr.Ok cond-lowered)
      (match cond-lowered
        [(LowerExpr.Expr cond-state cond-value cond-ty)
          (if (tc-type-compatible? (AstType.Bool) cond-ty)
            (match (lower-state-fresh-label cond-state "if_then")
              [(LowerLabel.Label then-label-state then-label)
                (match (lower-state-fresh-label then-label-state "if_else")
                  [(LowerLabel.Label else-label-state else-label)
                    (match (lower-state-fresh-label else-label-state "if_merge")
                      [(LowerLabel.Label merge-label-state merge-label)
                        (let
                          [branch-state : LowerState
                            (lower-state-emit
                              merge-label-state
                              (CompilerIrInstr.Branch
                                cond-value
                                then-label
                                else-label))]
                          (lower-if-then
                            ctx
                            (lower-state-finish-block branch-state then-label)
                            env
                            type-env
                            then-branch
                            else-branch
                            else-label
                            merge-label
                            expr-ty))])])])
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  cond
                  "typecheck: if condition must be bool"))))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-while
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [cond : AstExpr]
  [body : AstExpr]) : ResultLowerExpr
  (match (lower-state-fresh-label state "while_header")
    [(LowerLabel.Label header-label-state header-label)
      (match (lower-state-fresh-label header-label-state "while_body")
        [(LowerLabel.Label body-label-state body-label)
          (match (lower-state-fresh-label body-label-state "while_exit")
            [(LowerLabel.Label exit-label-state exit-label)
              (let
                [header-start : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      exit-label-state
                      (CompilerIrInstr.Jump header-label))
                    header-label)]
                (match (lower-expr ctx header-start env type-env cond)
                  [(ResultLowerExpr.Ok cond-lowered)
                    (match cond-lowered
                      [(LowerExpr.Expr cond-state cond-value _)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                cond-state
                                (CompilerIrInstr.Branch
                                  cond-value
                                  body-label
                                  exit-label))
                              body-label)]
                          (match (lower-expr
                            ctx
                            body-start
                            env
                            (lower-enter-loop-target
                              type-env
                              (lower-while-exit-label-id
                                (lower-state-next-label-number body-label-state))
                              (lower-while-header-label-id
                                (lower-state-next-label-number state)))
                            body)
                            [(ResultLowerExpr.Ok body-lowered)
                              (match body-lowered
                                [(LowerExpr.Expr body-state _ body-ty)
                                  (ResultLowerExpr.Ok
                                    (LowerExpr.Expr
                                      (if (tc-never-type? body-ty)
                                        (lower-state-finish-block
                                          body-state
                                          exit-label)
                                        (lower-state-finish-block
                                          (lower-state-emit
                                            body-state
                                            (CompilerIrInstr.Jump header-label))
                                          exit-label))
                                      CompilerIrValue.Unit
                                      (AstType.Unit)))])]
                            [(ResultLowerExpr.Err message)
                              (ResultLowerExpr.Err message)]))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))])])]))

;; Per-iteration accumulator update for an associative binop fold
;; (`sum`/`all`/`any`): `(set! acc (<op> acc value))`. `value` appears once so it
;; is evaluated exactly once per iteration.
(define (spmd-reduce-acc-binop-update
  [pools : AstNodePoolContext]
  [op : AstBinOp]
  [value : i64]) : i64
  (ast-expr-set-id-with-pools
    pools
    (lower-spmd-reduce-acc-id)
    (ast-expr-binary-with-pools
      pools
      op
      (ast-node-pool-context-expr-push
        pools
        (AstExpr.Var (lower-spmd-reduce-acc-id)))
      value)))

;; Per-iteration accumulator update for a select fold (`min`/`max`): bind `value`
;; once into a temp, then keep it when `(<cmp> val acc)` holds, else keep `acc`.
;; The temp keeps `value` to a single evaluation even though the select names it
;; twice.
(define (spmd-reduce-acc-select-update
  [pools : AstNodePoolContext]
  [cmp : AstBinOp]
  [value : i64]) : i64
  (ast-expr-let-with-pools
    pools
    (ast-let-binding-cons
      (ast-let-binding-id (lower-spmd-reduce-val-id) (AstMaybeType.No) value)
      (ast-let-binding-list-new))
    (ast-expr-set-id-with-pools
      pools
      (lower-spmd-reduce-acc-id)
      (ast-expr-if-with-pools
        pools
        (ast-expr-binary-with-pools
          pools
          cmp
          (ast-node-pool-context-expr-push
            pools
            (AstExpr.Var (lower-spmd-reduce-val-id)))
          (ast-node-pool-context-expr-push
            pools
            (AstExpr.Var (lower-spmd-reduce-acc-id))))
        (ast-node-pool-context-expr-push
          pools
          (AstExpr.Var (lower-spmd-reduce-val-id)))
        (ast-node-pool-context-expr-push
          pools
          (AstExpr.Var (lower-spmd-reduce-acc-id)))))))

(define (spmd-reduce-acc-update-expr
  [pools : AstNodePoolContext]
  [op : AstReduceOp]
  [value : i64]) : i64
  (match op
    [(AstReduceOp.Sum)
      (spmd-reduce-acc-binop-update pools (AstBinOp.Add) value)]
    [(AstReduceOp.All)
      (spmd-reduce-acc-binop-update pools (AstBinOp.And) value)]
    [(AstReduceOp.Any) (spmd-reduce-acc-binop-update pools (AstBinOp.Or) value)]
    [(AstReduceOp.Min)
      (spmd-reduce-acc-select-update pools (AstBinOp.Lt) value)]
    [(AstReduceOp.Max)
      (spmd-reduce-acc-select-update pools (AstBinOp.Gt) value)]))

;; Conservative scan used by the reduction addend split: does `expr` write
;; `name` (`set!`) anywhere, or rebind `name` with a `let` binding? Either one
;; means a `Var name` read at the top of the reduce value cannot be hoisted out
;; of the loop as-is. Variants that are not explicitly walked (match, nested
;; loops/comprehensions, quotes, region/escape blocks, ...) bail out with
;; `true` so the split simply does not fire on exotic value expressions.
(define (lower-spmd-reduce-expr-writes-id?
  [ctx : TcContext]
  [name : i64]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(AstExpr.Ann inner-box _)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(AstExpr.Cast inner-box _)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(AstExpr.Borrow _ _ inner-box)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(AstExpr.Unary _ inner-box)
      (lower-spmd-reduce-node-writes-id? ctx name inner-box)]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name left-box)
        (lower-spmd-reduce-node-writes-id? ctx name right-box))]
    [(AstExpr.Call func-box args)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name func-box)
        (lower-spmd-reduce-expr-list-writes-id? ctx name args))]
    [(AstExpr.BracketClause items)
      (lower-spmd-reduce-expr-list-writes-id? ctx name items)]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name cond-box)
        (lower-spmd-reduce-node-writes-id? ctx name then-box)
        (lower-spmd-reduce-node-writes-id? ctx name else-box))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-spmd-reduce-let-bindings-write-id? ctx name bindings)
            (lower-spmd-reduce-node-writes-id? ctx name body-box))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (lower-spmd-reduce-node-writes-id? ctx name body-box)])]
    [(AstExpr.Tuple exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(AstExpr.Array exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(AstExpr.DynArray exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(AstExpr.TupleRef tuple-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name tuple-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(AstExpr.MakeArray _ len-box)
      (lower-spmd-reduce-node-writes-id? ctx name len-box)]
    [(AstExpr.ArrayRef array-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(AstExpr.ArrayTake array-box live-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name live-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(AstExpr.ArrayPush array-box value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name array-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(AstExpr.StringRef string-box index-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name string-box)
        (lower-spmd-reduce-node-writes-id? ctx name index-box))]
    [(AstExpr.While cond-box body-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name cond-box)
        (lower-spmd-reduce-node-writes-id? ctx name body-box))]
    [(AstExpr.Begin exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(AstExpr.Unsafe exprs)
      (lower-spmd-reduce-expr-list-writes-id? ctx name exprs)]
    [(AstExpr.Set set-name value-box)
      (or
        (= set-name name)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(AstExpr.StructGet target-box _)
      (lower-spmd-reduce-node-writes-id? ctx name target-box)]
    [(AstExpr.StructSet target-box _ value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name target-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(AstExpr.Box value-box)
      (lower-spmd-reduce-node-writes-id? ctx name value-box)]
    [(AstExpr.BoxGet value-box)
      (lower-spmd-reduce-node-writes-id? ctx name value-box)]
    [(AstExpr.BoxTake value-box)
      (lower-spmd-reduce-node-writes-id? ctx name value-box)]
    [(AstExpr.BoxSet target-box value-box)
      (or
        (lower-spmd-reduce-node-writes-id? ctx name target-box)
        (lower-spmd-reduce-node-writes-id? ctx name value-box))]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [_ true]))

(define (lower-spmd-reduce-node-writes-id?
  [ctx : TcContext]
  [name : i64]
  [id : i64]) : bool
  (lower-spmd-reduce-expr-writes-id? ctx name (lower-context-expr-get ctx id)))

(define (lower-spmd-reduce-expr-list-writes-id?
  [ctx : TcContext]
  [name : i64]
  [exprs : AstExprList]) : bool
  (lower-spmd-reduce-expr-list-writes-id-at? ctx name (& exprs) 0))

(define (lower-spmd-reduce-expr-list-writes-id-at?
  [ctx : TcContext]
  [name : i64]
  [exprs : (& exprs AstExprList)]
  [expr-index : i64]) : bool
  (if (>= expr-index (struct-get exprs len))
    false
    (or
      (lower-spmd-reduce-node-writes-id?
        ctx
        name
        (ast-expr-list-get exprs expr-index 0))
      (lower-spmd-reduce-expr-list-writes-id-at?
        ctx
        name
        exprs
        (+ expr-index 1)))))

;; A `let` binding list blocks the split when it rebinds `name` (a `Var name`
;; read inside would no longer mean the outer variable) or when any binding
;; init writes `name`.
(define (lower-spmd-reduce-let-bindings-write-id?
  [ctx : TcContext]
  [name : i64]
  [bindings : AstLetBindingList]) : bool
  (lower-spmd-reduce-let-bindings-write-id-at? ctx name (& bindings) 0))

(define (lower-spmd-reduce-let-bindings-write-id-at?
  [ctx : TcContext]
  [name : i64]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast-let-binding-list-len bindings))
    false
    (or
      (match (ast-let-binding-list-get
        bindings
        binding-index
        (ast-let-binding-fallback))
        [(AstLetBinding.Binding bind-name _ init-box)
          (or
            (= bind-name name)
            (lower-spmd-reduce-node-writes-id? ctx name init-box))])
      (lower-spmd-reduce-let-bindings-write-id-at?
        ctx
        name
        bindings
        (+ binding-index 1)))))

;; Strip `Spanned`/`Ann` wrappers to see the syntactic head of an expression
;; (mirrors the unwrapping in `lower-simple-vector-reduce`).
(define (lower-spmd-reduce-split-unwrap [ctx : TcContext] [expr : AstExpr]) : AstExpr
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-spmd-reduce-split-unwrap
        ctx
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-spmd-reduce-split-unwrap
        ctx
        (lower-context-expr-get ctx inner-box))]
    [_ expr]))

;; If `operand` (an expr-pool id) is a plain variable reference that is
;; invariant across the reduction, return its id; otherwise -1. Invariant
;; here means: not the loop index, never `set!` inside the whole value
;; expression, and never rebound by a `let` inside it. A `Var` read is pure,
;; so hoisting it out of the loop is then unobservable.
(define (lower-spmd-reduce-split-uniform-var
  [ctx : TcContext]
  [index-id : i64]
  [value : AstExpr]
  [operand : i64]) : i64
  (match (lower-spmd-reduce-split-unwrap
    ctx
    (lower-context-expr-get ctx operand))
    [(AstExpr.Var u-id)
      (if (and
        (not (= u-id index-id))
        (not (lower-spmd-reduce-expr-writes-id? ctx u-id value)))
        u-id
        (- 0 1))]
    [_ (- 0 1)]))

;; Reduction addend split matcher: recognize a scalar `sum` reduce whose value
;; is `(+ X U)` (either operand order) with `U` a reduction-invariant variable
;; and an i64/u64 accumulator whose type matches the loop index type (the exit
;; trip count is computed in the index type, so the split stays within one
;; wrapping integer type). Returns `Split x-id u-id` with the varying addend's
;; expr-pool id and the uniform addend's variable id.
(define (lower-spmd-reduce-split-addend
  [ctx : TcContext]
  [op : AstReduceOp]
  [acc-ty : AstType]
  [index-id : i64]
  [index-ty : AstType]
  [value : AstExpr]) : LowerMaybeReduceSplit
  (match op
    [(AstReduceOp.Sum)
      (match acc-ty
        [(AstType.I64)
          (lower-spmd-reduce-split-addend-typed
            ctx
            acc-ty
            index-id
            index-ty
            value)]
        [(AstType.U64)
          (lower-spmd-reduce-split-addend-typed
            ctx
            acc-ty
            index-id
            index-ty
            value)]
        [_ (LowerMaybeReduceSplit.No)])]
    [_ (LowerMaybeReduceSplit.No)]))

(define (lower-spmd-reduce-split-addend-typed
  [ctx : TcContext]
  [acc-ty : AstType]
  [index-id : i64]
  [index-ty : AstType]
  [value : AstExpr]) : LowerMaybeReduceSplit
  (if (not (tc-type-eq (tc-type-without-regions index-ty) acc-ty))
    (LowerMaybeReduceSplit.No)
    (match (lower-spmd-reduce-split-unwrap ctx value)
      [(AstExpr.Binary (AstBinOp.Add) left-box right-box)
        (let
          [left-uniform : i64
            (lower-spmd-reduce-split-uniform-var ctx index-id value left-box)]
          (if (>= left-uniform 0)
            (LowerMaybeReduceSplit.Split right-box left-uniform)
            (let
              [right-uniform : i64
                (lower-spmd-reduce-split-uniform-var
                  ctx
                  index-id
                  value
                  right-box)]
              (if (>= right-uniform 0)
                (LowerMaybeReduceSplit.Split left-box right-uniform)
                (LowerMaybeReduceSplit.No)))))]
      [_ (LowerMaybeReduceSplit.No)])))

;; Scalar `spmd-reduce` loop scaffold: desugar to an accumulator loop and
;; reuse the let/while/set lowering. `acc`/`end`/index are bound once before the
;; loop (so `init`/`end`/`start` evaluate exactly once); an empty range returns
;; `init` without evaluating `acc-update`. `acc`/`end`/temp use lexer-impossible
;; names so they cannot collide with a user binding. The ordered left-to-right
;; fold matches the spec reference semantics.
;;   (spmd-reduce <op> ([i : ty start end]) init value)
;;     === (let [acc : result-ty init] [end' end] [i start]
;;           (begin (while (< i end') (begin <acc-update> (set! i (+ i 1)))) acc))
;; With a `LowerMaybeReduceSplit.Split` plan (a `sum` over `(+ X U)` with a
;; reduction-invariant `U`, see `lower-spmd-reduce-split-addend`) the scaffold
;; additionally binds `start'` and the hoisted uniform addend `u'`, the
;; accumulator update adds only `X`, and the loop tail returns
;; `(+ acc (* (- i start') u'))`:
;;     === (let [acc : result-ty init] [end' end] [start' start] [i start']
;;             [u' U]
;;           (begin
;;             (while (< i end') (begin <acc-update-X> (set! i (+ i 1))))
;;             (+ acc (* (- i start') u'))))
;; Exactness: `i` counts up by one per trip, so `(- i start')` after the loop
;; is the trip count n (0 for an empty range), and over wrapping i64/u64
;; arithmetic `init + Σ_k (X_k + U) == init + Σ_k X_k + n*U` because wrapping
;; `+` and `*` are the mod-2^64 ring operations. `u'` reads `U` once before
;; the loop; that is unobservable because a `Var` read is pure and the split
;; plan guarantees `U` is never written inside the value expression.
(define (lower-spmd-reduce-scaffold
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [_result-ty : AstType]
  [index-id : i64]
  [_index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [init : AstExpr]
  [acc-ty : AstType]
  [acc-update : i64]
  [split : LowerMaybeReduceSplit]) : ResultLowerExpr
  (let
    [pools : AstNodePoolContext (tc-context-pools ctx)]
    [loop-id : i64
      (ast-expr-while-with-pools
        pools
        (ast-expr-binary-with-pools
          pools
          (AstBinOp.Lt)
          (ast-node-pool-context-expr-push pools (AstExpr.Var index-id))
          (ast-node-pool-context-expr-push
            pools
            (AstExpr.Var (lower-spmd-reduce-end-id))))
        (ast-node-pool-context-expr-push
          pools
          (AstExpr.Begin
            (ast-expr-cons
              acc-update
              (ast-expr-cons
                (ast-expr-set-id-with-pools
                  pools
                  index-id
                  (ast-expr-binary-with-pools
                    pools
                    (AstBinOp.Add)
                    (ast-node-pool-context-expr-push
                      pools
                      (AstExpr.Var index-id))
                    (ast-node-pool-context-expr-push
                      pools
                      (AstExpr.Literal (ast-lit-int 1)))))
                (ast-expr-list-new))))))]
    [root-id : i64
      (match split
        [(LowerMaybeReduceSplit.Split _ u-id)
          (ast-expr-let-with-pools
            pools
            (ast-let-binding-cons
              (ast-let-binding-id
                (lower-spmd-reduce-acc-id)
                (AstMaybeType.Some acc-ty)
                (ast-node-pool-context-expr-push pools init))
              (ast-let-binding-cons
                (ast-let-binding-id
                  (lower-spmd-reduce-end-id)
                  (AstMaybeType.Some index-ty)
                  (ast-node-pool-context-expr-push pools end))
                (ast-let-binding-cons
                  (ast-let-binding-id
                    (lower-spmd-reduce-start-id)
                    (AstMaybeType.Some index-ty)
                    (ast-node-pool-context-expr-push pools start))
                  (ast-let-binding-cons
                    (ast-let-binding-id
                      index-id
                      (AstMaybeType.Some index-ty)
                      (ast-node-pool-context-expr-push
                        pools
                        (AstExpr.Var (lower-spmd-reduce-start-id))))
                    (ast-let-binding-cons
                      (ast-let-binding-id
                        (lower-spmd-reduce-uniform-id)
                        (AstMaybeType.No)
                        (ast-node-pool-context-expr-push
                          pools
                          (AstExpr.Var u-id)))
                      (ast-let-binding-list-new))))))
            (ast-node-pool-context-expr-push
              pools
              (AstExpr.Begin
                (ast-expr-cons
                  loop-id
                  (ast-expr-cons
                    (ast-expr-binary-with-pools
                      pools
                      (AstBinOp.Add)
                      (ast-node-pool-context-expr-push
                        pools
                        (AstExpr.Var (lower-spmd-reduce-acc-id)))
                      (ast-expr-binary-with-pools
                        pools
                        (AstBinOp.Mul)
                        (ast-expr-binary-with-pools
                          pools
                          (AstBinOp.Sub)
                          (ast-node-pool-context-expr-push
                            pools
                            (AstExpr.Var index-id))
                          (ast-node-pool-context-expr-push
                            pools
                            (AstExpr.Var (lower-spmd-reduce-start-id))))
                        (ast-node-pool-context-expr-push
                          pools
                          (AstExpr.Var (lower-spmd-reduce-uniform-id)))))
                    (ast-expr-list-new))))))]
        [_
          (ast-expr-let-with-pools
            pools
            (ast-let-binding-cons
              (ast-let-binding-id
                (lower-spmd-reduce-acc-id)
                (AstMaybeType.Some acc-ty)
                (ast-node-pool-context-expr-push pools init))
              (ast-let-binding-cons
                (ast-let-binding-id
                  (lower-spmd-reduce-end-id)
                  (AstMaybeType.Some index-ty)
                  (ast-node-pool-context-expr-push pools end))
                (ast-let-binding-cons
                  (ast-let-binding-id
                    index-id
                    (AstMaybeType.Some index-ty)
                    (ast-node-pool-context-expr-push pools start))
                  (ast-let-binding-list-new))))
            (ast-node-pool-context-expr-push
              pools
              (AstExpr.Begin
                (ast-expr-cons
                  loop-id
                  (ast-expr-cons
                    (ast-node-pool-context-expr-push
                      pools
                      (AstExpr.Var (lower-spmd-reduce-acc-id)))
                    (ast-expr-list-new))))))])]
    [root : AstExpr (lower-context-expr-get ctx root-id)]
    (lower-expr ctx state env type-env root)))

;; Scalar lowering for all reduction ops: `sum` (wrapping `+`, also f64
;; ordered add), `all`/`any` (boolean `and`/`or`), and `min`/`max` (ordered
;; select). Each supplies its per-iteration accumulator update to the shared
;; loop scaffold. A `sum` whose value is `(+ X U)` with reduction-invariant
;; `U` takes the addend split (see `lower-spmd-reduce-split-addend`): the loop
;; accumulates only `X` and the scaffold adds `(* trip-count U)` once at the
;; end. The SIMD-mode vector plan, when it applies, is unaffected.
(define (lower-spmd-reduce
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [result-ty : AstType]
  [op : AstReduceOp]
  [index-id : i64]
  [index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [init : AstExpr]
  [value : AstExpr]) : ResultLowerExpr
  (match (tc-expr ctx (tc-bind-id type-env index-id index-ty) value)
    [(ResultTcType.Ok value-ty)
      (let
        [acc-ty : AstType (tc-type-without-regions value-ty)]
        [split : LowerMaybeReduceSplit
          (lower-spmd-reduce-split-addend ctx op acc-ty index-id index-ty value)]
        [acc-update : i64
          (match split
            [(LowerMaybeReduceSplit.Split x-id _)
              (spmd-reduce-acc-binop-update
                (tc-context-pools ctx)
                (AstBinOp.Add)
                x-id)]
            [_
              (spmd-reduce-acc-update-expr
                (tc-context-pools ctx)
                op
                (lower-context-expr-push ctx value))])]
        (if (and
          (lower-mode-simd? (lower-state-mode state))
          (lower-type-i64? index-ty))
          (let
            [plan : LowerMaybeVectorReduce
              (lower-simple-vector-reduce
                ctx
                (lower-state-mode state)
                env
                type-env
                op
                index
                acc-ty
                value)]
            (match plan
              [(LowerMaybeVectorReduce.Array _ _ _ _)
                (lower-avx2-spmd-reduce-lowered
                  ctx
                  state
                  env
                  type-env
                  index-ty
                  start
                  end
                  init
                  op
                  plan)]
              [(LowerMaybeVectorReduce.Value _ _ _ _)
                (lower-avx2-spmd-reduce-lowered
                  ctx
                  state
                  env
                  type-env
                  index-ty
                  start
                  end
                  init
                  op
                  plan)]
              [(LowerMaybeVectorReduce.No)
                (lower-spmd-reduce-scaffold
                  ctx
                  state
                  env
                  type-env
                  result-ty
                  index-id
                  index
                  index-ty
                  start
                  end
                  init
                  acc-ty
                  acc-update
                  split)]))
          (lower-spmd-reduce-scaffold
            ctx
            state
            env
            type-env
            result-ty
            index-id
            index
            index-ty
            start
            end
            init
            acc-ty
            acc-update
            split)))]
    [(ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr value message)))]))

(define (spmd-scan-binop-prefix
  [pools : AstNodePoolContext]
  [op : AstBinOp]
  [value : i64]) : i64
  (ast-expr-binary-with-pools
    pools
    op
    (ast-node-pool-context-expr-push
      pools
      (AstExpr.Var (lower-spmd-scan-acc-id)))
    value))

(define (spmd-scan-select-prefix
  [pools : AstNodePoolContext]
  [cmp : AstBinOp]
  [value : i64]) : i64
  (ast-expr-let-with-pools
    pools
    (ast-let-binding-cons
      (ast-let-binding-id (lower-spmd-scan-val-id) (AstMaybeType.No) value)
      (ast-let-binding-list-new))
    (ast-expr-if-with-pools
      pools
      (ast-expr-binary-with-pools
        pools
        cmp
        (ast-node-pool-context-expr-push
          pools
          (AstExpr.Var (lower-spmd-scan-val-id)))
        (ast-node-pool-context-expr-push
          pools
          (AstExpr.Var (lower-spmd-scan-acc-id))))
      (ast-node-pool-context-expr-push
        pools
        (AstExpr.Var (lower-spmd-scan-val-id)))
      (ast-node-pool-context-expr-push
        pools
        (AstExpr.Var (lower-spmd-scan-acc-id))))))

(define (spmd-scan-prefix-expr
  [pools : AstNodePoolContext]
  [op : AstReduceOp]
  [value : i64]) : i64
  (match op
    [(AstReduceOp.Sum) (spmd-scan-binop-prefix pools (AstBinOp.Add) value)]
    [(AstReduceOp.All) (spmd-scan-binop-prefix pools (AstBinOp.And) value)]
    [(AstReduceOp.Any) (spmd-scan-binop-prefix pools (AstBinOp.Or) value)]
    [(AstReduceOp.Min) (spmd-scan-select-prefix pools (AstBinOp.Lt) value)]
    [(AstReduceOp.Max) (spmd-scan-select-prefix pools (AstBinOp.Gt) value)]))

(define (lower-spmd-scan-scaffold
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index-id : i64]
  [_index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [prefix-id : i64]
  [_prefix : String]
  [prefix-ty : AstType]
  [init : AstExpr]
  [prefix-value : i64]
  [body : AstExpr]) : ResultLowerExpr
  (let
    [pools : AstNodePoolContext (tc-context-pools ctx)]
    (lower-expr
      ctx
      state
      env
      type-env
      (lower-context-expr-get
        ctx
        (ast-expr-let-with-pools
          pools
          (ast-let-binding-cons
            (ast-let-binding-id
              (lower-spmd-scan-acc-id)
              (AstMaybeType.Some prefix-ty)
              (ast-node-pool-context-expr-push pools init))
            (ast-let-binding-cons
              (ast-let-binding-id
                (lower-spmd-scan-end-id)
                (AstMaybeType.Some index-ty)
                (ast-node-pool-context-expr-push pools end))
              (ast-let-binding-cons
                (ast-let-binding-id
                  index-id
                  (AstMaybeType.Some index-ty)
                  (ast-node-pool-context-expr-push pools start))
                (ast-let-binding-list-new))))
          (ast-node-pool-context-expr-push
            pools
            (AstExpr.Begin
              (ast-expr-cons
                (ast-expr-while-with-pools
                  pools
                  (ast-expr-binary-with-pools
                    pools
                    (AstBinOp.Lt)
                    (ast-node-pool-context-expr-push
                      pools
                      (AstExpr.Var index-id))
                    (ast-node-pool-context-expr-push
                      pools
                      (AstExpr.Var (lower-spmd-scan-end-id))))
                  (ast-expr-let-with-pools
                    pools
                    (ast-let-binding-cons
                      (ast-let-binding-id
                        prefix-id
                        (AstMaybeType.Some prefix-ty)
                        prefix-value)
                      (ast-let-binding-list-new))
                    (ast-node-pool-context-expr-push
                      pools
                      (AstExpr.Begin
                        (ast-expr-cons
                          (ast-expr-set-id-with-pools
                            pools
                            (lower-spmd-scan-acc-id)
                            (ast-node-pool-context-expr-push
                              pools
                              (AstExpr.Var prefix-id)))
                          (ast-expr-cons
                            (ast-node-pool-context-expr-push pools body)
                            (ast-expr-cons
                              (ast-expr-set-id-with-pools
                                pools
                                index-id
                                (ast-expr-binary-with-pools
                                  pools
                                  (AstBinOp.Add)
                                  (ast-node-pool-context-expr-push
                                    pools
                                    (AstExpr.Var index-id))
                                  (ast-node-pool-context-expr-push
                                    pools
                                    (AstExpr.Literal (ast-lit-int 1)))))
                              (ast-expr-list-new))))))))
                (ast-expr-list-new)))))))))

(define (lower-spmd-scan
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [op : AstReduceOp]
  [index-id : i64]
  [index : String]
  [index-ty : AstType]
  [start : AstExpr]
  [end : AstExpr]
  [prefix-id : i64]
  [prefix : String]
  [prefix-ty : AstType]
  [init : AstExpr]
  [value : AstExpr]
  [body : AstExpr]) : ResultLowerExpr
  (let
    [scalar-prefix : i64
      (spmd-scan-prefix-expr
        (tc-context-pools ctx)
        op
        (lower-context-expr-push ctx value))]
    [vector-plan : LowerMaybeVectorScan
      (lower-simple-vector-scan
        ctx
        (lower-state-mode state)
        env
        type-env
        op
        index
        prefix
        prefix-ty
        value
        body)]
    (if (and
      (lower-mode-simd? (lower-state-mode state))
      (lower-type-i64? index-ty))
      (match vector-plan
        [(LowerMaybeVectorScan.Scan _ _ _ _ _)
          (lower-simd-spmd-scan-lowered
            ctx
            state
            env
            type-env
            op
            index-id
            index-ty
            start
            end
            prefix-id
            prefix-ty
            init
            value
            body
            vector-plan)]
        [(LowerMaybeVectorScan.No)
          (lower-spmd-scan-scaffold
            ctx
            state
            env
            type-env
            index-id
            index
            index-ty
            start
            end
            prefix-id
            prefix
            prefix-ty
            init
            scalar-prefix
            body)])
      (lower-spmd-scan-scaffold
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start
        end
        prefix-id
        prefix
        prefix-ty
        init
        scalar-prefix
        body))))

(define (lower-spmd-broadcast
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : AstExpr]
  [lane : AstExpr]) : ResultLowerExpr
  (match (lower-expr-expected ctx state env type-env lane (AstType.I64) lane)
    [(ResultLowerExpr.Ok lane-lowered)
      (match lane-lowered
        [(LowerExpr.Expr lane-state lane-value _)
          (lower-expr
            ctx
            (lower-emit-spmd-broadcast-lane-check
              lane-state
              lane-value
              (CompilerIrValue.I64 1))
            env
            type-env
            value)])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-spmd-shuffle-diagnostic) : String
  "lower: SPMD spmd-shuffle requires scalar backend until SIMD shuffle lowering lands")

(define (lower-spmd-shuffle
  [ctx : TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [value : AstExpr]
  [lane : AstExpr]) : ResultLowerExpr
  (if (lower-mode-simd? (lower-state-mode state))
    (ResultLowerExpr.Err
      (box (lower-diagnostic (lower-spmd-shuffle-diagnostic))))
    (match (lower-expr-expected ctx state env type-env lane (AstType.I64) lane)
      [(ResultLowerExpr.Ok lane-lowered)
        (match lane-lowered
          [(LowerExpr.Expr lane-state lane-value _)
            (lower-expr
              ctx
              (lower-emit-spmd-broadcast-lane-check
                lane-state
                lane-value
                (CompilerIrValue.I64 1))
              env
              type-env
              value)])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-mode-simd? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.Avx2) true]
    [(CompilerLowerMode.LinuxAvx2) true]
    [(CompilerLowerMode.WindowsAvx2) true]
    [(CompilerLowerMode.Avx512) true]
    [(CompilerLowerMode.LinuxAvx512) true]
    [(CompilerLowerMode.WindowsAvx512) true]
    [_ false]))

(define (lower-mode-avx2? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.Avx2) true]
    [(CompilerLowerMode.LinuxAvx2) true]
    [(CompilerLowerMode.WindowsAvx2) true]
    [_ false]))

(define (lower-mode-avx512? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.Avx512) true]
    [(CompilerLowerMode.LinuxAvx512) true]
    [(CompilerLowerMode.WindowsAvx512) true]
    [_ false]))

(define (lower-avx2-masked-if-diagnostic) : String
  "lower: SPMD masked if is not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-avx2-varying-while-diagnostic) : String
  "lower: SPMD varying while is not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-avx2-spmd-call-diagnostic) : String
  "lower: out-of-line varying SPMD calls are not supported in AVX2 backend mode; use scalar or avx512")

(define (lower-simd-foreach-fallback-diagnostic) : String
  "lower: SPMD foreach does not match a SIMD lowering pattern for this backend mode; use scalar or a contiguous map/zip body with supported array and uniform operands")

(define (lower-mode-inline-aggregates? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.Scalar) true]
    [(CompilerLowerMode.LinuxScalar) true]
    [(CompilerLowerMode.WindowsScalar) true]
    [(CompilerLowerMode.Avx2) true]
    [(CompilerLowerMode.LinuxAvx2) true]
    [(CompilerLowerMode.WindowsAvx2) true]
    [(CompilerLowerMode.Avx512) true]
    [(CompilerLowerMode.LinuxAvx512) true]
    [(CompilerLowerMode.WindowsAvx512) true]
    [(CompilerLowerMode.InlineAggregates) true]
    [_ false]))

(define (lower-mode-linux-c-abi? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.LinuxScalar) true]
    [(CompilerLowerMode.LinuxAvx2) true]
    [(CompilerLowerMode.LinuxAvx512) true]
    [_ false]))

(define (lower-mode-windows-c-abi? [mode : CompilerLowerMode]) : bool
  (match mode
    [(CompilerLowerMode.WindowsScalar) true]
    [(CompilerLowerMode.WindowsAvx2) true]
    [(CompilerLowerMode.WindowsAvx512) true]
    [_ false]))

(define (lower-mode-c-abi? [mode : CompilerLowerMode]) : bool
  (or (lower-mode-linux-c-abi? mode) (lower-mode-windows-c-abi? mode)))

(define (lower-type-i64? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.I64) true]
    [_ false]))

(define (lower-type-bool? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.Bool) true]
    [_ false]))

(define (lower-avx512-bool-lanes [mode : CompilerLowerMode]) : i64
  (if (lower-mode-avx512? mode)
    64
    (if (lower-mode-avx2? mode)
      32
      0)))

(define (lower-simd-lanes-for-elem [mode : CompilerLowerMode] [ty : AstType]) : i64
  (match mode
    [(CompilerLowerMode.Avx2)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 4]
        [(AstType.U64) 4]
        [(AstType.F64) 4]
        [(AstType.F32) 8]
        [(AstType.I32) 8]
        [(AstType.U32) 8]
        [(AstType.I16) 16]
        [(AstType.U16) 16]
        [(AstType.I8) 32]
        [(AstType.U8) 32]
        [_ 0])]
    [(CompilerLowerMode.LinuxAvx2)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 4]
        [(AstType.U64) 4]
        [(AstType.F64) 4]
        [(AstType.F32) 8]
        [(AstType.I32) 8]
        [(AstType.U32) 8]
        [(AstType.I16) 16]
        [(AstType.U16) 16]
        [(AstType.I8) 32]
        [(AstType.U8) 32]
        [_ 0])]
    [(CompilerLowerMode.WindowsAvx2)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 4]
        [(AstType.U64) 4]
        [(AstType.F64) 4]
        [(AstType.F32) 8]
        [(AstType.I32) 8]
        [(AstType.U32) 8]
        [(AstType.I16) 16]
        [(AstType.U16) 16]
        [(AstType.I8) 32]
        [(AstType.U8) 32]
        [_ 0])]
    [(CompilerLowerMode.Avx512)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 8]
        [(AstType.U64) 8]
        [(AstType.F64) 8]
        [(AstType.F32) 16]
        [(AstType.I32) 16]
        [(AstType.U32) 16]
        [(AstType.I16) 32]
        [(AstType.U16) 32]
        [(AstType.I8) 64]
        [(AstType.U8) 64]
        [_ 0])]
    [(CompilerLowerMode.LinuxAvx512)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 8]
        [(AstType.U64) 8]
        [(AstType.F64) 8]
        [(AstType.F32) 16]
        [(AstType.I32) 16]
        [(AstType.U32) 16]
        [(AstType.I16) 32]
        [(AstType.U16) 32]
        [(AstType.I8) 64]
        [(AstType.U8) 64]
        [_ 0])]
    [(CompilerLowerMode.WindowsAvx512)
      (match (tc-type-without-regions ty)
        [(AstType.I64) 8]
        [(AstType.U64) 8]
        [(AstType.F64) 8]
        [(AstType.F32) 16]
        [(AstType.I32) 16]
        [(AstType.U32) 16]
        [(AstType.I16) 32]
        [(AstType.U16) 32]
        [(AstType.I8) 64]
        [(AstType.U8) 64]
        [_ 0])]
    [_ 0]))

(define (lower-expr-is-var? [ctx : TcContext] [expr : AstExpr] [name : String]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-expr-is-var? ctx inner name))]
    [(AstExpr.Var found) (string.eq (tc-env-key-name-text found) name)]
    [_ false]))

(define (lower-expr-is-program-index? [ctx : TcContext] [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-expr-is-program-index? ctx (lower-context-expr-get ctx inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-expr-is-program-index? ctx (lower-context-expr-get ctx inner-box))]
    [(AstExpr.SpmdProgramIndex) true]
    [_ false]))

(define (lower-dynamic-array-var
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : LowerMaybeArrayVar
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-dynamic-array-var ctx env type-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-dynamic-array-var ctx env type-env inner))]
    [(AstExpr.Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? var-id)
          (match (tc-lookup-id type-env name)
            [(ResultTcType.Ok ty)
              (match (tc-type-strip-region ty)
                [(AstType.DynArray elem-ty)
                  (LowerMaybeArrayVar.Some
                    var-id
                    (tc-type-without-regions (tc-context-type-get ctx elem-ty)))]
                [(AstType.Ref _ referent-ty)
                  (match (tc-type-strip-region
                    (tc-context-type-get ctx referent-ty))
                    [(AstType.DynArray elem-ty)
                      (LowerMaybeArrayVar.Some
                        var-id
                        (tc-type-without-regions
                          (tc-context-type-get ctx elem-ty)))]
                    [_ (LowerMaybeArrayVar.No)])]
                [(AstType.MutRef _ referent-ty)
                  (match (tc-type-strip-region
                    (tc-context-type-get ctx referent-ty))
                    [(AstType.DynArray elem-ty)
                      (LowerMaybeArrayVar.Some
                        var-id
                        (tc-type-without-regions
                          (tc-context-type-get ctx elem-ty)))]
                    [_ (LowerMaybeArrayVar.No)])]
                [_ (LowerMaybeArrayVar.No)])]
            [(ResultTcType.Err _) (LowerMaybeArrayVar.No)])
          (LowerMaybeArrayVar.No)))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-array-ref-var-for-index
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]
  [index : String]) : LowerMaybeArrayVar
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-array-ref-var-for-index ctx env type-env inner index))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        (if (lower-expr-is-var? ctx idx index)
          (lower-dynamic-array-var ctx env type-env arr)
          (LowerMaybeArrayVar.No)))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-array-ref-var-for-program-index
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : LowerMaybeArrayVar
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-array-ref-var-for-program-index
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        (if (lower-expr-is-program-index? ctx idx)
          (lower-dynamic-array-var ctx env type-env arr)
          (LowerMaybeArrayVar.No)))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-simple-spmd-broadcast-lane
  [ctx : TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [expr : AstExpr]) : LowerMaybeIrValue
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-spmd-broadcast-lane ctx env type-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-spmd-broadcast-lane ctx env type-env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-spmd-broadcast-lane ctx env type-env inner))]
    [(AstExpr.Literal (AstLiteral.Int n _))
      (LowerMaybeIrValue.Some (CompilerIrValue.I64 n))]
    [(AstExpr.Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? var-id)
          (match (tc-lookup-id type-env name)
            [(ResultTcType.Ok ty)
              (if (tc-type-eq (tc-type-without-regions ty) (AstType.I64))
                (LowerMaybeIrValue.Some (CompilerIrValue.Var var-id))
                (LowerMaybeIrValue.No))]
            [(ResultTcType.Err _) (LowerMaybeIrValue.No)])
          (LowerMaybeIrValue.No)))]
    [_ (LowerMaybeIrValue.No)]))

(define (lower-array-var-set-empty) : LowerArrayVarSet
  (LowerArrayVarSet (make-array i64 0) (make-array i64 0) 0))

(define (lower-array-var-set-add
  [set : LowerArrayVarSet]
  [var : i64]
  [offset : i64]) : LowerArrayVarSet
  (let
    [vars : (Array i64) (struct-get set vars)]
    [offsets : (Array i64) (struct-get set offsets)]
    [count : i64 (struct-get set count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (if (= (array-ref vars index) var)
          (begin
            (if (> offset (array-ref offsets index))
              (array-set! offsets index offset)
              unit)
            (set! found true))
          (set! index (+ index 1))))
      (if found
        (LowerArrayVarSet vars offsets count)
        (begin
          (array-push! vars var)
          (array-push! offsets offset)
          (LowerArrayVarSet vars offsets (+ count 1)))))))

(define (lower-array-var-set-merge
  [left : LowerArrayVarSet]
  [right : LowerArrayVarSet]) : LowerArrayVarSet
  (let
    [vars : (Array i64) (struct-get right vars)]
    [offsets : (Array i64) (struct-get right offsets)]
    [count : i64 (struct-get right count)]
    [index : i64 0]
    [out : LowerArrayVarSet left]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (lower-array-var-set-add
              out
              (array-ref vars index)
              (array-ref offsets index)))
          (set! index (+ index 1))))
      out)))

(define (lower-array-var-set-max-offset [set : LowerArrayVarSet]) : i64
  (let
    [offsets : (Array i64) (struct-get set offsets)]
    [count : i64 (struct-get set count)]
    [index : i64 0]
    [max-offset : i64 0]
    (begin
      (while (< index count)
        (let
          [offset : i64 (array-ref offsets index)]
          (begin
            (if (> offset max-offset)
              (set! max-offset offset)
              unit)
            (set! index (+ index 1)))))
      max-offset)))

(define (compiler-lower-array-var-set-ok?) : bool
  (let
    [left : LowerArrayVarSet
      (lower-array-var-set-add
        (lower-array-var-set-add
          (lower-array-var-set-add (lower-array-var-set-empty) 10 1)
          20
          2)
        10
        4)]
    [right : LowerArrayVarSet
      (lower-array-var-set-add
        (lower-array-var-set-add (lower-array-var-set-empty) 30 3)
        20
        1)]
    [merged : LowerArrayVarSet (lower-array-var-set-merge left right)]
    [vars : (Array i64) (struct-get merged vars)]
    [offsets : (Array i64) (struct-get merged offsets)]
    (and
      (= (struct-get merged count) 3)
      (= (array-length vars) 3)
      (= (array-length offsets) 3)
      (= (array-ref vars 0) 10)
      (= (array-ref offsets 0) 4)
      (= (array-ref vars 1) 20)
      (= (array-ref offsets 1) 2)
      (= (array-ref vars 2) 30)
      (= (array-ref offsets 2) 3)
      (= (lower-array-var-set-max-offset merged) 4))))

(define (lower-masked-vector-index-literal-offset
  [ctx : TcContext]
  [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-literal-offset ctx inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-literal-offset ctx inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-literal-offset ctx inner))]
    [(AstExpr.Literal (AstLiteral.Int n _))
      (if (>= n 0)
        n
        -1)]
    [_ -1]))

(define (lower-masked-vector-positive-power-two-literal
  [ctx : TcContext]
  [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-positive-power-two-literal ctx inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-positive-power-two-literal ctx inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-positive-power-two-literal ctx inner))]
    [(AstExpr.Literal (AstLiteral.Int n _))
      (if (> n 0)
        (if (= (bit-and n (- n 1)) 0)
          n
          -1)
        -1)]
    [_ -1]))

(define (lower-masked-vector-index-offset
  [ctx : TcContext]
  [index : String]
  [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-offset ctx index inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-offset ctx index inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-index-offset ctx index inner))]
    [(AstExpr.Var name)
      (if (string.eq (tc-env-key-name-text name) index)
        0
        -1)]
    [(AstExpr.Binary op left-box right-box)
      (match op
        [(AstBinOp.Add)
          (let
            [left : AstExpr (lower-context-expr-get ctx left-box)]
            [right : AstExpr (lower-context-expr-get ctx right-box)]
            [left-offset : i64
              (lower-masked-vector-index-offset ctx index left)]
            [right-offset : i64
              (lower-masked-vector-index-offset ctx index right)]
            (if (= left-offset 0)
              (lower-masked-vector-index-literal-offset ctx right)
              (if (= right-offset 0)
                (lower-masked-vector-index-literal-offset ctx left)
                -1)))]
        [_ -1])]
    [_ -1]))

(define (lower-masked-vector-lanes-merge [left : i64] [right : i64]) : i64
  (cond
    [(< left 0) -1]
    [(< right 0) -1]
    [(= left 0) right]
    [(= right 0) left]
    [(= left right) left]
    [else -1]))

(define (lower-masked-vector-binop-supported? [op : AstBinOp]) : bool
  (match op
    [(AstBinOp.Add) true]
    [(AstBinOp.Sub) true]
    [(AstBinOp.Mod) true]
    [(AstBinOp.BitAnd) true]
    [(AstBinOp.BitOr) true]
    [(AstBinOp.BitXor) true]
    [(AstBinOp.Shl) true]
    [(AstBinOp.Shr) true]
    [(AstBinOp.Eq) true]
    [(AstBinOp.Ne) true]
    [(AstBinOp.Lt) true]
    [(AstBinOp.Le) true]
    [(AstBinOp.Gt) true]
    [(AstBinOp.Ge) true]
    [(AstBinOp.And) true]
    [(AstBinOp.Or) true]
    [_ false]))

(define (lower-masked-vector-unop-supported? [op : AstUnOp]) : bool
  (match op
    [(AstUnOp.Not) true]
    [_ false]))

(define (lower-masked-vector-empty-lane-locals) : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 16))

(define (lower-masked-vector-lane-locals-from-set-at
  [items : LowerIdSet]
  [lanes : i64]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (match items
    [(LowerIdSet.Nil) out]
    [(LowerIdSet.Cons name rest)
      (let
        [next-out : lower_i64_i64_map.Map out]
        (begin
          (lower_i64_i64_map.insert-ref! (&mut next-out) name lanes)
          (lower-masked-vector-lane-locals-from-set-at
            (box-get rest)
            lanes
            next-out)))]))

(define (lower-masked-vector-lane-locals-from-set
  [items : LowerIdSet]
  [lanes : i64]) : lower_i64_i64_map.Map
  (lower-masked-vector-lane-locals-from-set-at
    items
    lanes
    (lower-masked-vector-empty-lane-locals)))

(define (lower-masked-vector-lane-locals-bind-if-varying
  [lane-locals : lower_i64_i64_map.Map]
  [name : i64]
  [lanes : i64]) : lower_i64_i64_map.Map
  (if (> lanes 0)
    (begin
      (lower_i64_i64_map.insert-ref! (&mut lane-locals) name lanes)
      lane-locals)
    lane-locals))

(define (lower-masked-vector-expr-list-lanes-with-locals
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : AstExprList]) : i64
  (lower-masked-vector-expr-list-lanes-with-locals-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-lanes-with-locals-at
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [exprs : (& exprs AstExprList)]
  [expr-index : i64]) : i64
  (if (>= expr-index (struct-get exprs len))
    0
    (let
      [expr : AstExpr
        (lower-context-expr-get ctx (ast-expr-list-get exprs expr-index 0))]
      (lower-masked-vector-lanes-merge
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          expr)
        (lower-masked-vector-expr-list-lanes-with-locals-at
          ctx
          mode
          env
          type-env
          index
          lane-locals
          exprs
          (+ expr-index 1))))))

(define (lower-masked-vector-let-bindings-locals
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : AstLetBindingList]) : lower_i64_i64_map.Map
  (lower-masked-vector-let-bindings-locals-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-locals-at
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : lower_i64_i64_map.Map
  (if (>= binding-index (ast-let-binding-list-len bindings))
    lane-locals
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding name _ init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          [init-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              init)]
          [next-locals : lower_i64_i64_map.Map
            (lower-masked-vector-lane-locals-bind-if-varying
              lane-locals
              name
              init-lanes)]
          (lower-masked-vector-let-bindings-locals-at
            ctx
            mode
            env
            type-env
            index
            next-locals
            bindings
            (+ binding-index 1)))])))

(define (lower-masked-vector-let-bindings-lanes-with-locals
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : AstLetBindingList]) : i64
  (lower-masked-vector-let-bindings-lanes-with-locals-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-lanes-with-locals-at
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [bindings : (& bindings AstLetBindingList)]
  [binding-index : i64]) : i64
  (if (>= binding-index (ast-let-binding-list-len bindings))
    0
    (match (ast-let-binding-list-get
      bindings
      binding-index
      (ast-let-binding-fallback))
      [(AstLetBinding.Binding name _ init-box)
        (let
          [init : AstExpr (lower-context-expr-get ctx init-box)]
          [init-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              init)]
          [next-locals : lower_i64_i64_map.Map
            (lower-masked-vector-lane-locals-bind-if-varying
              lane-locals
              name
              init-lanes)]
          (lower-masked-vector-lanes-merge
            init-lanes
            (lower-masked-vector-let-bindings-lanes-with-locals-at
              ctx
              mode
              env
              type-env
              index
              next-locals
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-pattern-locals
  [pattern : AstPattern]
  [scrut-lanes : i64]
  [lane-locals : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (if (> scrut-lanes 0)
    (match pattern
      [(AstPattern.Var name _)
        (lower-masked-vector-lane-locals-bind-if-varying
          lane-locals
          name
          scrut-lanes)]
      [(AstPattern.Tuple patterns-box)
        (lower-masked-vector-pattern-list-locals
          (box-get patterns-box)
          scrut-lanes
          lane-locals)]
      [(AstPattern.Binding name)
        (lower-masked-vector-lane-locals-bind-if-varying
          lane-locals
          name
          scrut-lanes)]
      [(AstPattern.Variant _ patterns-box)
        (lower-masked-vector-pattern-list-locals
          (box-get patterns-box)
          scrut-lanes
          lane-locals)]
      [_ lane-locals])
    lane-locals))

(define (lower-masked-vector-pattern-list-locals
  [patterns : AstPatternList]
  [scrut-lanes : i64]
  [lane-locals : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (lower-masked-vector-pattern-list-locals-at
    (& patterns)
    scrut-lanes
    lane-locals
    0))

(define (lower-masked-vector-pattern-list-locals-at
  [patterns : (& patterns AstPatternList)]
  [scrut-lanes : i64]
  [lane-locals : lower_i64_i64_map.Map]
  [index : i64]) : lower_i64_i64_map.Map
  (if (>= index (struct-get patterns len))
    lane-locals
    (lower-masked-vector-pattern-list-locals-at
      patterns
      scrut-lanes
      (lower-masked-vector-pattern-locals
        (ast-pattern-list-get patterns index (ast-pattern-fallback))
        scrut-lanes
        lane-locals)
      (+ index 1))))

(define (lower-masked-vector-match-arms-lanes-with-locals
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [scrut-lanes : i64]
  [arms : AstMatchArmList]) : i64
  (lower-masked-vector-match-arms-lanes-with-locals-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    scrut-lanes
    (& arms)
    0))

(define (lower-masked-vector-match-arms-lanes-with-locals-at
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [scrut-lanes : i64]
  [arms : (& arms AstMatchArmList)]
  [arm-index : i64]) : i64
  (if (>= arm-index (struct-get arms len))
    0
    (match (ast-match-arm-list-get arms arm-index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (lower-context-expr-get ctx body-box)]
          [body-locals : lower_i64_i64_map.Map
            (lower-masked-vector-pattern-locals pattern scrut-lanes lane-locals)]
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              body-locals
              body)
            (lower-masked-vector-match-arms-lanes-with-locals-at
              ctx
              mode
              env
              type-env
              index
              lane-locals
              scrut-lanes
              arms
              (+ arm-index 1))))])))

(define (lower-spmd-call-args-lanes
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [args : AstExprList]) : i64
  (lower-spmd-call-args-lanes-at
    ctx
    mode
    env
    type-env
    index
    lane-locals
    (& args)
    0))

(define (lower-spmd-call-args-lanes-at
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [args : (& args AstExprList)]
  [arg-index : i64]) : i64
  (if (>= arg-index (struct-get args len))
    0
    (lower-masked-vector-lanes-merge
      (lower-masked-vector-expr-lanes-with-locals
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx (ast-expr-list-get args arg-index 0)))
      (lower-spmd-call-args-lanes-at
        ctx
        mode
        env
        type-env
        index
        lane-locals
        args
        (+ arg-index 1)))))

(define (lower-spmd-helper-param-locals
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [caller-locals : lower_i64_i64_map.Map]
  [params : AstParamList]
  [args : AstExprList]) : lower_i64_i64_map.Map
  (lower-spmd-helper-param-locals-at
    ctx
    mode
    env
    type-env
    index
    caller-locals
    (& params)
    (& args)
    0
    (lower-masked-vector-empty-lane-locals)))

(define (lower-spmd-helper-param-locals-at
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [caller-locals : lower_i64_i64_map.Map]
  [params : (& params AstParamList)]
  [args : (& args AstExprList)]
  [arg-index : i64]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (if (or
    (>= arg-index (ast-param-list-len params))
    (>= arg-index (struct-get args len)))
    out
    (match (ast-param-list-get params arg-index (ast-param-fallback))
      [(AstParam.Param name _ _ _)
        (let
          [arg-lanes : i64
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              caller-locals
              (lower-context-expr-get ctx (ast-expr-list-get args arg-index 0)))]
          (lower-spmd-helper-param-locals-at
            ctx
            mode
            env
            type-env
            index
            caller-locals
            params
            args
            (+ arg-index 1)
            (lower-masked-vector-lane-locals-bind-if-varying out name arg-lanes)))])))

(define (lower-imported-spmd-source-args-code-at
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [args : (& args AstExprList)]
  [arg-index : i64]) : String
  (if (>= arg-index (struct-get args len))
    ""
    (let
      [arg-lanes : i64
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          (lower-context-expr-get ctx (ast-expr-list-get args arg-index 0)))]
      (str_cat.str-cat
        (cond [(> arg-lanes 0) "v"] [(= arg-lanes 0) "u"] [else "?"])
        (lower-imported-spmd-source-args-code-at
          ctx
          mode
          env
          type-env
          index
          lane-locals
          args
          (+ arg-index 1))))))

(define (lower-imported-spmd-direct-call-result-lanes
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [func : AstExpr]
  [args : AstExprList]
  [canonical-name : i64]
  [fn-ty : AstType]
  [callables : AstImportedSpmdCallableList]) : i64
  (match fn-ty
    [(AstType.Func param-types ret-id)
      (let
        [params : AstParamList
          (lower-imported-spmd-params ctx (box-get param-types))]
        [ret : AstType (tc-context-type-get ctx ret-id)]
        [arg-lanes : i64
          (lower-spmd-call-args-lanes
            ctx
            mode
            env
            type-env
            index
            lane-locals
            args)]
        [backend : CompilerIrSpmdBackend
          (cond
            [(lower-mode-avx512? mode) (CompilerIrSpmdBackend.Avx512)]
            [(lower-mode-avx2? mode) (CompilerIrSpmdBackend.Avx2)]
            [else (CompilerIrSpmdBackend.Scalar)])]
        [lanes : i64
          (match backend
            [(CompilerIrSpmdBackend.Scalar) 1]
            [_ arg-lanes])]
        [args-code : String
          (lower-imported-spmd-source-args-code-at
            ctx
            mode
            env
            type-env
            index
            lane-locals
            (& args)
            0)]
        [unknown-arg-code : String "?"]
        (cond
          [(= arg-lanes 0) 0]
          [(or
              (< arg-lanes 0)
              (string.contains (& args-code) (& unknown-arg-code)))
            -1]
          [else
            (match (lower-imported-spmd-select
              canonical-name
              (& callables)
              (lower-spmd-source-signature params ret)
              backend
              lanes
              args-code
              (lower-imported-spmd-index-param ctx index args)
              ret
              func)
              [(ResultLowerImportedSpmdSpecialization.Err _) -1]
              [(ResultLowerImportedSpmdSpecialization.Ok specialization)
                (if (or
                  (tc-type-eq (tc-type-without-regions ret) (AstType.Unit))
                  (lower-imported-spmd-result-varying? specialization))
                  arg-lanes
                  0)])]))]
    [_ -1]))

(define (lower-spmd-direct-call-result-lanes
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [func : AstExpr]
  [args : AstExprList]) : i64
  (match (ast-expr-unspan-with-pools (tc-context-pools ctx) func)
    [(AstExpr.Var raw-name)
      (if (sym_i64_env.sym-i64-contains-id env raw-name)
        -1
        (match (lower-spmd-inline-helper-lookup
          ctx
          env
          type-env
          LowerIdSet.Nil
          func)
          [(ResultLowerSpmdInlineHelper.Ok helper)
            (match helper
              [(LowerSpmdInlineHelper.Some name params _ body)
                (let
                  [arg-lanes : i64
                    (lower-spmd-call-args-lanes
                      ctx
                      mode
                      env
                      type-env
                      index
                      lane-locals
                      args)]
                  (if (< arg-lanes 0)
                    -1
                    (let
                      [previous : LowerIdSet lower-spmd-inline-helper-stack]
                      [result : i64 -1]
                      (begin
                        (set!
                          lower-spmd-inline-helper-stack
                          (lower-id-set-insert previous name))
                        (set!
                          result
                          (lower-masked-vector-expr-lanes-with-locals
                            ctx
                            mode
                            env
                            type-env
                            ""
                            (lower-spmd-helper-param-locals
                              ctx
                              mode
                              env
                              type-env
                              index
                              lane-locals
                              params
                              args)
                            body))
                        (set! lower-spmd-inline-helper-stack previous)
                        (if (< result 0)
                          arg-lanes
                          result)))))]
              [(LowerSpmdInlineHelper.Imported canonical-name fn-ty callables)
                (lower-imported-spmd-direct-call-result-lanes
                  ctx
                  mode
                  env
                  type-env
                  index
                  lane-locals
                  func
                  args
                  canonical-name
                  fn-ty
                  (box-get callables))]
              [(LowerSpmdInlineHelper.No) -1])]
          [(ResultLowerSpmdInlineHelper.Err _) -1]))]
    [_ -1]))

(define (lower-masked-vector-expr-lanes-with-locals
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Literal _) 0]
    [(AstExpr.Var name)
      (let
        [name-text : String (tc-env-key-name-text name)]
        (match (lower_i64_i64_map.get (& lane-locals) name)
          [(lower_i64_i64_map.LookupFound lanes) lanes]
          [(lower_i64_i64_map.LookupMissing)
            (if (string.eq name-text index)
              (lower-simd-lanes-for-elem mode (AstType.I64))
              0)]))]
    [(AstExpr.Unary op inner-box)
      (if (lower-masked-vector-unop-supported? op)
        (let
          [inner : AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            inner))
        -1)]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        [operand-lanes : i64
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              left)
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              right))]
        ;; The masked-lane census records widths, not scalar types. Admit the
        ;; widths whose integer/float multiply opcodes already exist; a
        ;; width-neutral expression inherits the enclosing array lane width.
        [vector-mul-width : bool
          (and
            (match op
              [(AstBinOp.Mul) true]
              [_ false])
            (or
              (= operand-lanes 0)
              (= operand-lanes (lower-simd-lanes-for-elem mode (AstType.I64)))
              (= operand-lanes (lower-simd-lanes-for-elem mode (AstType.I32)))
              (= operand-lanes (lower-simd-lanes-for-elem mode (AstType.I16)))))]
        (if (or (lower-masked-vector-binop-supported? op) vector-mul-width)
          operand-lanes
          -1))]
    [(AstExpr.Call func-box args)
      (lower-spmd-direct-call-result-lanes
        ctx
        mode
        env
        type-env
        index
        lane-locals
        (lower-context-expr-get ctx func-box)
        args)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            [body-locals : lower_i64_i64_map.Map
              (lower-masked-vector-let-bindings-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)]
            (lower-masked-vector-lanes-merge
              (lower-masked-vector-let-bindings-lanes-with-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                mode
                env
                type-env
                index
                body-locals
                body)))])]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            cond)
          (lower-masked-vector-lanes-merge
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              then-branch)
            (lower-masked-vector-expr-lanes-with-locals
              ctx
              mode
              env
              type-env
              index
              lane-locals
              else-branch))))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [body : AstExpr (lower-context-expr-get ctx body-box)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            cond)
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            body)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (lower-context-expr-get ctx scrutinee-box)]
            [scrut-lanes : i64
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                scrutinee)]
            (lower-masked-vector-lanes-merge
              scrut-lanes
              (lower-masked-vector-match-arms-lanes-with-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                scrut-lanes
                arms)))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-lanes-with-locals
        ctx
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        (if (>= (lower-masked-vector-index-offset ctx index idx) 0)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some _ elem-ty)
              (if (lower-type-bool? elem-ty)
                (lower-avx512-bool-lanes mode)
                (lower-simd-lanes-for-elem mode elem-ty))]
            [(LowerMaybeArrayVar.No) -1])
          -1))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (if (>= (lower-masked-vector-index-offset ctx index idx) 0)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some _ elem-ty)
              (if (lower-type-bool? elem-ty)
                (let
                  [value-lanes : i64
                    (lower-masked-vector-expr-lanes-with-locals
                      ctx
                      mode
                      env
                      type-env
                      index
                      lane-locals
                      value)]
                  (if (< value-lanes 0)
                    -1
                    (if (= value-lanes 0)
                      (lower-avx512-bool-lanes mode)
                      value-lanes)))
                (lower-masked-vector-lanes-merge
                  (lower-simd-lanes-for-elem mode elem-ty)
                  (lower-masked-vector-expr-lanes-with-locals
                    ctx
                    mode
                    env
                    type-env
                    index
                    lane-locals
                    value)))]
            [(LowerMaybeArrayVar.No) -1])
          -1))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (lower-masked-vector-lanes-merge
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            receiver)
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            value)))]
    [_ -1]))

(define (lower-masked-vector-expr-lanes
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [expr : AstExpr]) : i64
  (lower-masked-vector-expr-lanes-with-locals
    ctx
    mode
    env
    type-env
    index
    (lower-masked-vector-empty-lane-locals)
    expr))

(define (lower-masked-vector-body-has-varying-if-with-locals?
  [ctx : TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : lower_i64_i64_map.Map]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : AstExpr (lower-context-expr-get ctx else-box)]
        (if (>
          (lower-masked-vector-expr-lanes-with-locals
            ctx
            mode
            env
            type-env
            index
            lane-locals
            cond)
          0)
          true
          (or
            (lower-masked-vector-body-has-varying-if-with-locals?
              ctx
              mode
              env
              type-env
              index
              lane-locals
              then-branch)
            (lower-masked-vector-body-has-varying-if-with-locals?
              ctx
              mode
              env
              type-env
              index
              lane-locals
              else-branch))))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (lower-context-expr-get ctx body-box)]
            [body-locals : lower_i64_i64_map.Map
              (lower-masked-vector-let-bindings-locals
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)]
            (or
              (lower-masked-vector-let-bindings-have-varying-if-with-locals?
                ctx
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (lower-masked-vector-body-has-varying-if-with-locals?
                ctx
                mode
                env
                type-env
                index
                body-locals
                body)))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-varying-if-with-locals?
        ctx
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-varying-if-with-locals?
          ctx
          mode
          env
          type-env
          index
          lane-locals
          inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (lower-context-expr-get ctx left-box)]
        [right : AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            left)
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            right)))]
    [(AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            arr)
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            idx)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : AstExpr (lower-context-expr-get ctx idx-box)]
        [value : AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
            arr)
          (lower-masked-vector-body-has-varying-if-with-locals?
            ctx
            mode
            env
            type-env
            index
            lane-locals
