;; compiler_optimize.tl - Selfhost optimizer: pass framework + scalar constant
;; folding.
;;
;; Runs between lowering (`lower-compiler-program`) and backend emission
;; (`compiler-backend-emit-program-for-target`). It performs conservative, scalar-only
;; local rewrites: constant folding, algebraic strength reduction, CSE, copy
;; propagation, conservative global value numbering/cross-block copy
;; propagation, conservative loop-invariant scalar hoisting, redundant
;; bounds-check elimination, conservative CFG simplification, and DCE.
;;
;; Safety:
;; - Integer `+`, `-`, `*`, bitwise ops, shifts, and `neg` are folded through
;;   helpers that normalize the result back to the instruction type. This keeps
;;   narrow signed/unsigned widths and `char` byte semantics explicit.
;; - Division, modulo, and shifts fold only when the static operands avoid the
;;   same runtime traps emitted by lowering: zero divisors, signed MIN / -1, and
;;   out-of-range shift counts remain in the IR.
;; - Tracking is block-local (reset per block), so no value is folded across a
;;   control-flow edge.
;;
;; Out of scope: broad aggregate/String/array IR optimization.
(cfg compile-profile (import stdlib.io))
(cfg compile-profile (import stdlib.profile))
(import stdlib.array)
(import stdlib.vector)
(import compiler_allocation_profile as allocation_profile)
(import compiler_profile_state as profile_state)
(import compiler_builtin_ids as cbi)
(import "compiler_ir_types.tl")
(import "compiler_clone.tl")
(import "compiler_float.tl")
(import stdlib.arena)
(import stdlib.hash)
(import stdlib.hashmap)
(import (hashmap.hashmap i64 i64) as opt_string_i64_map)
(import (hashmap.hashmap i64 i64) as opt_i64_i64_map)
(import stdlib.string)
(import stdlib.str_cat_runtime as str_cat)
(cfg compile-profile-summary (import compiler_profile_summary as cps))
(import stdlib.option)
(import (option.option i64) as option_i64)

(defenum ResultCompilerOptimizeLevel
  (Ok i64)
  (Err))

(defenum CompilerOptimizedProgram
  (Program CompilerIrProgram CompilerSourceSpans))

;; Developer-only optimizer observability. The CLI resets this state before
;; every command, so normal compilation remains silent and allocation-free at
;; pass boundaries.
(define compiler-opt-debug-trace-passes : bool
  false)
(define compiler-opt-debug-dump-pass : String
  "")
(define compiler-opt-debug-dump-text : String
  "")
(define compiler-opt-debug-dump-arena : i64
  0)
(define compiler-opt-debug-verify-ir : bool
  false)
(define compiler-opt-debug-verify-error : String
  "")

(define (compiler-opt-debug-configure!
  [trace-passes : bool]
  [dump-pass : String]
  [verify-ir : bool]) : unit
  (begin
    (set! compiler-opt-debug-trace-passes trace-passes)
    (set! compiler-opt-debug-dump-pass dump-pass)
    (set! compiler-opt-debug-dump-text "")
    (set! compiler-opt-debug-dump-arena (arena.tl_arena_current))
    (set! compiler-opt-debug-verify-ir verify-ir)
    (set! compiler-opt-debug-verify-error "")))

(define (compiler-opt-debug-dump-result) : String
  compiler-opt-debug-dump-text)

(define (compiler-opt-debug-verification-error) : String
  compiler-opt-debug-verify-error)

(define (compiler-opt-debug-pass-selected? [pass : String]) : bool
  (and
    (> (string.string-length compiler-opt-debug-dump-pass) 0)
    (string.eq compiler-opt-debug-dump-pass pass)))

(define (compiler-opt-debug-observe-function
  [type-segment-bases : i64]
  [pass : String]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function name _ _ _ blocks)
      (begin
        (if compiler-opt-debug-trace-passes
          (io.print-error
            (str_cat.str-cat
              "optimizer-pass|"
              (compiler-ir-symbol-text name)
              "|"
              pass
              "|blocks="
              (string.int->string (compiler-ir-block-list-count blocks))
              "|instructions="
              (string.int->string
                (compiler-ir-block-list-instruction-count blocks))
              "\n"))
          unit)
        (if (compiler-opt-debug-pass-selected? pass)
          (let
            [pass-arena : i64 (arena.tl_arena_current)]
            (unsafe
              (begin
                (arena.tl_arena_set compiler-opt-debug-dump-arena)
                (set!
                  compiler-opt-debug-dump-text
                  (str_cat.str-cat
                    compiler-opt-debug-dump-text
                    (if (=
                      (string.string-length compiler-opt-debug-dump-text)
                      0)
                      ""
                      "\n")
                    "after "
                    pass
                    " @"
                    (compiler-ir-symbol-text name)
                    "\n"
                    (compiler-ir-function-render type-segment-bases func)))
                (set! compiler-opt-debug-dump-arena (arena.tl_arena_current))
                (arena.tl_arena_set pass-arena))))
          unit)
        func)]))

(define (compiler-opt-debug-observe-blocks
  [type-segment-bases : i64]
  [pass : String]
  [name : i64]
  [params : CompilerIrParamList]
  [ret-ty : AstType]
  [frame : i64]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (begin
    (compiler-opt-debug-observe-function
      type-segment-bases
      pass
      (CompilerIrFunction.Function name params ret-ty frame blocks))
    blocks))

(defenum OptAggregatePointer
  (Pointer i64 i64))

(import (vector.vector OptAggregatePointer core) as opt_aggregate_pointer_vec)

(defenum OptAggregateAccess
  (Store i64 AstType)
  (Load i64 i64 AstType))

(import (vector.vector OptAggregateAccess core) as opt_aggregate_access_vec)

(defenum OptAggregateAllocCandidate
  (Candidate
    i64
    AstType
    i64
    opt_aggregate_pointer_vec.Vec
    opt_aggregate_access_vec.Vec))

(import (vector.vector OptAggregateAllocCandidate core) as opt_aggregate_candidate_vec)

(defenum OptMaybeAggregateAlloc
  (No)
  (Some i64 AstType i64))

(defenum OptAggregateScanResult
  (Ok opt_aggregate_pointer_vec.Vec opt_aggregate_access_vec.Vec)
  (Reject))

;; Aggregate field-load SROA supporting types.
(defenum OptAggregateLocation
  (No)
  (Some i64 i64))

(defenum OptAggregateStoredValue
  (No)
  (Some CompilerIrValue AstType))

(defenum OptAggregateFieldFacts
  (Nil)
  (Cons i64 i64 CompilerIrValue AstType (Box OptAggregateFieldFacts)))

(defenum OptAggregateSroaResult
  (Result OptAggregateFieldFacts CompilerIrInstr))

(defenum OptAggregatePromoteSlot
  (Slot i64 i64))

(import (vector.vector OptAggregatePromoteSlot core) as opt_aggregate_promote_slot_vec)

(defenum OptAggregatePromoteBuild
  (Build opt_aggregate_promote_slot_vec.Vec i64))

(define opt-aggregate-list-initial-capacity : i64
  4)
(define compiler-optimize-level-default : i64
  1)
(cfg
  compile-profile
  (define compiler-opt-profile-start-ms-metric : i64
    24))
(cfg
  compile-profile
  (define compiler-opt-profile-start-total-metric : i64
    25))
(cfg
  compile-profile
  (define compiler-opt-profile-start-live-metric : i64
    26))
(cfg
  compile-profile
  (define compiler-opt-profile-detail-start-ms-metric : i64
    27))

(cfg
  compile-profile-summary
  (define (compiler-opt-profile-summary-reset!
    [state : profile_state.CompilerProfileState]) : unit
    (cps.compiler-profile-summary-reset! state)))

(cfg
  compile-profile-summary
  (define (compiler-opt-profile-summary-emit
    [state : profile_state.CompilerProfileState]) : unit
    (begin
      (cps.compiler-profile-summary-emit
        state
        cps.compiler-profile-summary-optimizer-pass
        "optimizer"
        "pass")
      (cps.compiler-profile-summary-emit
        state
        cps.compiler-profile-summary-optimizer-function
        "optimizer"
        "function")
      (cps.compiler-profile-summary-emit
        state
        cps.compiler-profile-summary-optimizer-module
        "optimizer"
        "module"))))

(cfg
  compile-profile
  (define (compiler-opt-profile-field [value : i64]) : String
    (string.append "|" (string.int->string value))))

(cfg
  compile-profile
  (define compiler-opt-load-cse-profile-max-table-size : i64
    0))
(cfg
  compile-profile
  (define compiler-opt-load-cse-profile-max-kinds-size : i64
    0))
(cfg
  compile-profile
  (define compiler-opt-load-cse-profile-max-table-cap : i64
    0))
(cfg
  compile-profile
  (define compiler-opt-load-cse-profile-max-kinds-cap : i64
    0))
(cfg
  compile-profile
  (define compiler-opt-load-cse-profile-table-cap-hits : i64
    0))
(cfg
  compile-profile
  (define compiler-opt-load-cse-profile-kinds-cap-hits : i64
    0))
(cfg
  compile-profile
  (define compiler-opt-load-cse-profile-field-key-drops : i64
    0))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-reset) : unit
    (begin
      (set! compiler-opt-load-cse-profile-max-table-size 0)
      (set! compiler-opt-load-cse-profile-max-kinds-size 0)
      (set! compiler-opt-load-cse-profile-max-table-cap 0)
      (set! compiler-opt-load-cse-profile-max-kinds-cap 0)
      (set! compiler-opt-load-cse-profile-table-cap-hits 0)
      (set! compiler-opt-load-cse-profile-kinds-cap-hits 0)
      (set! compiler-opt-load-cse-profile-field-key-drops 0))))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-note-table-size [size : i64]) : unit
    (if (> size compiler-opt-load-cse-profile-max-table-size)
      (set! compiler-opt-load-cse-profile-max-table-size size)
      unit)))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-note-kinds-size [size : i64]) : unit
    (if (> size compiler-opt-load-cse-profile-max-kinds-size)
      (set! compiler-opt-load-cse-profile-max-kinds-size size)
      unit)))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-note-table-cap [cap : i64]) : unit
    (if (> cap compiler-opt-load-cse-profile-max-table-cap)
      (set! compiler-opt-load-cse-profile-max-table-cap cap)
      unit)))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-note-kinds-cap [cap : i64]) : unit
    (if (> cap compiler-opt-load-cse-profile-max-kinds-cap)
      (set! compiler-opt-load-cse-profile-max-kinds-cap cap)
      unit)))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-note-table-cap-hit) : unit
    (set!
      compiler-opt-load-cse-profile-table-cap-hits
      (+ compiler-opt-load-cse-profile-table-cap-hits 1))))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-note-kinds-cap-hit) : unit
    (set!
      compiler-opt-load-cse-profile-kinds-cap-hits
      (+ compiler-opt-load-cse-profile-kinds-cap-hits 1))))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-note-field-key-drop) : unit
    (set!
      compiler-opt-load-cse-profile-field-key-drops
      (+ compiler-opt-load-cse-profile-field-key-drops 1))))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-line [name : String] [value : i64]) : unit
    (io.print-error
      (string.concat5
        "compile-profile|optimize.load_cse."
        name
        "|"
        (string.int->string value)
        "\n"))))

(cfg
  compile-profile
  (define (compiler-opt-load-cse-profile-emit) : unit
    (begin
      (compiler-opt-load-cse-profile-line
        "max_table_size"
        compiler-opt-load-cse-profile-max-table-size)
      (compiler-opt-load-cse-profile-line
        "max_kinds_size"
        compiler-opt-load-cse-profile-max-kinds-size)
      (compiler-opt-load-cse-profile-line
        "max_table_cap"
        compiler-opt-load-cse-profile-max-table-cap)
      (compiler-opt-load-cse-profile-line
        "max_kinds_cap"
        compiler-opt-load-cse-profile-max-kinds-cap)
      (compiler-opt-load-cse-profile-line
        "table_cap_hits"
        compiler-opt-load-cse-profile-table-cap-hits)
      (compiler-opt-load-cse-profile-line
        "kinds_cap_hits"
        compiler-opt-load-cse-profile-kinds-cap-hits)
      (compiler-opt-load-cse-profile-line
        "field_key_drops"
        compiler-opt-load-cse-profile-field-key-drops))))

(cfg
  compile-profile
  (define (compiler-opt-profile-start
    [state : profile_state.CompilerProfileState]) : unit
    (begin
      (profile_state.compiler-profile-state-metric-set!
        state
        compiler-opt-profile-start-ms-metric
        (profile.now-ms))
      (profile_state.compiler-profile-state-metric-set!
        state
        compiler-opt-profile-start-total-metric
        (profile.alloc-total))
      (profile_state.compiler-profile-state-metric-set!
        state
        compiler-opt-profile-start-live-metric
        (profile.alloc-live))
      (profile.alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-opt-profile-finish
    [state : profile_state.CompilerProfileState]
    [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64
        (-
          (profile.alloc-peak)
          (profile_state.compiler-profile-state-metric-value
            state
            compiler-opt-profile-start-live-metric))]
      (io.print-error
        (string.append
          "compile-profile|optimize."
          (string.append
            phase
            (string.append
              (compiler-opt-profile-field
                (-
                  end-ms
                  (profile_state.compiler-profile-state-metric-value
                    state
                    compiler-opt-profile-start-ms-metric)))
              (string.append
                (compiler-opt-profile-field
                  (-
                    end-total
                    (profile_state.compiler-profile-state-metric-value
                      state
                      compiler-opt-profile-start-total-metric)))
                (string.append
                  (compiler-opt-profile-field
                    (-
                      end-live
                      (profile_state.compiler-profile-state-metric-value
                        state
                        compiler-opt-profile-start-live-metric)))
                  (string.append (compiler-opt-profile-field peak-delta) "\n"))))))))))

(cfg
  compile-profile
  (define (compiler-opt-profile-detail-start
    [state : profile_state.CompilerProfileState]) : unit
    (profile_state.compiler-profile-state-metric-set!
      state
      compiler-opt-profile-detail-start-ms-metric
      (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-opt-profile-detail-finish
    [state : profile_state.CompilerProfileState]
    [phase : String]
    [name : String]) : unit
    (let
      [elapsed : i64
        (-
          (profile.now-ms)
          (profile_state.compiler-profile-state-metric-value
            state
            compiler-opt-profile-detail-start-ms-metric))]
      (cfg
        compile-profile-summary
        (if (string.eq phase "function")
          (begin
            (cps.compiler-profile-summary-note!
              state
              cps.compiler-profile-summary-optimizer-function
              name
              elapsed)
            (cps.compiler-profile-summary-note-module!
              state
              cps.compiler-profile-summary-optimizer-module
              name
              elapsed))
          unit)
        (if (>= elapsed 1)
          (io.print-error
            (string.append
              "compile-profile-detail|optimize."
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string elapsed)
                    (string.append "|" (string.append name "\n")))))))
          unit)))))

(cfg
  compile-profile
  (define (compiler-opt-profile-pass-finish
    [state : profile_state.CompilerProfileState]
    [pass : String]
    [name : i64]
    [start-ms : i64]) : unit
    (let
      [elapsed : i64 (- (profile.now-ms) start-ms)]
      (cfg
        compile-profile-summary
        (cps.compiler-profile-summary-note!
          state
          cps.compiler-profile-summary-optimizer-pass
          pass
          elapsed)
        (if (>= elapsed 1)
          (io.print-error
            (string.append
              "compile-profile-detail|optimize.pass."
              (string.append
                pass
                (string.append
                  "|"
                  (string.append
                    (string.int->string elapsed)
                    (string.append
                      "|"
                      (string.append (compiler-ir-symbol-text name) "\n")))))))
          unit)))))

(cfg
  compile-profile
  (define (compiler-opt-profile-escape-finish
    [phase : String]
    [level : i64]
    [name : String]
    [start-ms : i64]) : unit
    (let
      [elapsed : i64 (- (profile.now-ms) start-ms)]
      (cfg
        compile-profile-summary
        unit
        (io.print-error
          (string.concat5
            "compile-profile-detail|optimize.escape."
            phase
            "|"
            (string.int->string elapsed)
            (string.concat5 "|" (string.int->string level) "|" name "\n")))))))

(cfg
  compile-profile
  (define (compiler-opt-profile-function-name [func : CompilerIrFunction]) : String
    (match func
      [(CompilerIrFunction.Function name _ _ _ _)
        (compiler-ir-symbol-text name)])))

(define (compiler-optimize-default-level) : i64
  compiler-optimize-level-default)

(define (compiler-optimize-level-valid? [level : i64]) : bool
  (and (>= level 0) (<= level 2)))

(define (compiler-optimize-parse-level [value : String]) : ResultCompilerOptimizeLevel
  (if (= (string.string-length value) 1)
    (let
      [c : char (string.string-ref value 0)]
      (if (or (= c '0') (= c '1') (= c '2'))
        (ResultCompilerOptimizeLevel.Ok (string.>int value))
        (ResultCompilerOptimizeLevel.Err)))
    (ResultCompilerOptimizeLevel.Err)))

;; --- block-local constant environment: IR var id -> known typed scalar -------
(defenum OptMaybeBool
  (No)
  (Some bool))

(defenum OptKnownConst
  (NoConst)
  (SomeConst CompilerIrValue AstType))

;; The const env is threaded linearly through a single block's fold/strength
;; passes (each block starts fresh at `OptConstEnv.Nil`); it is never forked or
;; reused across blocks. So bind/unbind only ever extend the most recent env.
;; We exploit that: the newest entry for a var always shadows older ones, so
;; `bind` and `unbind` just PREPEND (O(1)) instead of rebuilding the whole list
;; to remove the prior entry (the old O(n)-per-instruction copy made folding a
;; single large block O(n^2) in both time and allocation -- e.g. a function that
;; is one giant `str-cat` lowers to a long `string-append` call chain, and each
;; call's `opt-invalidate-def` rebuilt the entire env). `OptConstEnv.Shadow` records
;; "this var is no longer a known constant" so lookup stops at it.
(defenum OptConstEnv
  (Nil)
  (Cons i64 CompilerIrValue AstType (Box OptConstEnv))
  (Shadow i64 (Box OptConstEnv)))

(define (opt-const-unbind [env : OptConstEnv] [var : i64]) : OptConstEnv
  (OptConstEnv.Shadow var (box env)))

(define (opt-const-bind
  [env : OptConstEnv]
  [var : i64]
  [value : CompilerIrValue]
  [ty : AstType]) : OptConstEnv
  (OptConstEnv.Cons var value ty (box env)))

(define (opt-const-lookup [env : OptConstEnv] [var : i64]) : OptKnownConst
  (match env
    [(OptConstEnv.Nil) (OptKnownConst.NoConst)]
    [(OptConstEnv.Cons id value ty rest)
      (if (= id var)
        (OptKnownConst.SomeConst value ty)
        (opt-const-lookup (box-get rest) var))]
    [(OptConstEnv.Shadow id rest)
      (if (= id var)
        (OptKnownConst.NoConst)
        (opt-const-lookup (box-get rest) var))]))

(define (opt-integer-type? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [_ false]))

(define (opt-signed-integer-type? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [_ false]))

(define (opt-unsigned-integer-type? [ty : AstType]) : bool
  (match ty
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [_ false]))

(define (opt-int-or-char-type? [ty : AstType]) : bool
  (if (opt-integer-type? ty)
    true
    (match ty
      [(AstType.Char) true]
      [_ false])))

(define (opt-bool-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Bool) true]
    [_ false]))

(define (opt-float-type? [ty : AstType]) : bool
  (match ty
    [(AstType.F64) true]
    [(AstType.F32) true]
    [_ false]))

(define (opt-int-width [ty : AstType]) : i64
  (match ty
    [(AstType.I64) 64]
    [(AstType.U64) 64]
    [(AstType.I32) 32]
    [(AstType.U32) 32]
    [(AstType.I16) 16]
    [(AstType.U16) 16]
    [(AstType.I8) 8]
    [(AstType.U8) 8]
    [(AstType.Char) 8]
    [_ 0]))

(define (opt-int-sign-class [ty : AstType]) : i64
  (if (opt-signed-integer-type? ty)
    1
    (if (or
      (opt-unsigned-integer-type? ty)
      (match ty
        [(AstType.Char) true]
        [_ false]))
      2
      0)))

(define (opt-int-cast-as-mov? [from-ty : AstType] [to-ty : AstType]) : bool
  (if (and (opt-int-or-char-type? from-ty) (opt-int-or-char-type? to-ty))
    (let
      [from-width : i64 (opt-int-width from-ty)]
      [to-width : i64 (opt-int-width to-ty)]
      ;; Keep same-width signedness changes as casts; they preserve operator
      ;; type context for cases like `(shr (cast x : u64) ...)`.
      (or
        (< to-width from-width)
        (and
          (= to-width from-width)
          (= (opt-int-sign-class from-ty) (opt-int-sign-class to-ty)))))
    false))

(define (opt-value-to-i64 [value : CompilerIrValue]) : option_i64.Option
  (match value
    [(CompilerIrValue.I64 n) (option_i64.Some n)]
    [(CompilerIrValue.Char c) (option_i64.Some (cast c : i64))]
    [_ (option_i64.None)]))

(define (opt-value-to-bool [value : CompilerIrValue]) : OptMaybeBool
  (match value
    [(CompilerIrValue.Bool b) (OptMaybeBool.Some b)]
    [_ (OptMaybeBool.No)]))

(define (opt-float-round-for-type [value : f64] [ty : AstType]) : f64
  (match ty
    [(AstType.F32) (compiler-float-round-f32-as-f64 value)]
    [_ value]))

(define (opt-value-to-f64 [value : CompilerIrValue] [ty : AstType]) : CompilerFloatMaybeF64
  (match value
    [(CompilerIrValue.F64 bits)
      (let
        [decoded : f64
          (match ty
            [(AstType.F32) (compiler-float-f32-bits-to-f64 bits)]
            [_ (compiler-float-f64-from-bits bits)])]
        (if (compiler-float-f64-finite? decoded)
          (CompilerFloatSomeF64 decoded)
          (CompilerFloatNoF64)))]
    [_ (CompilerFloatNoF64)]))

(define (opt-f64-to-ir-value [value : f64] [ty : AstType]) : CompilerIrMaybeValue
  (let
    [rounded : f64 (opt-float-round-for-type value ty)]
    (if (compiler-float-f64-finite? rounded)
      (CompilerIrMaybeValue.Some
        (CompilerIrValue.F64
          (match ty
            [(AstType.F32)
              (cast (compiler-float-f32-bits-from-f64 rounded) : u64)]
            [_ (compiler-float-f64-bits rounded)])))
      (CompilerIrMaybeValue.No))))

(define (opt-normalize-int-to-i64 [value : i64] [ty : AstType]) : i64
  (match ty
    [(AstType.I64) (cast (cast value : i64) : i64)]
    [(AstType.I32) (cast (cast value : i32) : i64)]
    [(AstType.I16) (cast (cast value : i16) : i64)]
    [(AstType.I8) (cast (cast value : i8) : i64)]
    [(AstType.U64) (cast (cast value : u64) : i64)]
    [(AstType.U32) (cast (cast value : u32) : i64)]
    [(AstType.U16) (cast (cast value : u16) : i64)]
    [(AstType.U8) (cast (cast value : u8) : i64)]
    [(AstType.Char) (cast (cast value : char) : i64)]
    [_ value]))

(define (opt-normalize-const [value : CompilerIrValue] [ty : AstType]) : OptKnownConst
  (if (opt-integer-type? ty)
    (match (opt-value-to-i64 value)
      [(option_i64.Some n)
        (OptKnownConst.SomeConst
          (CompilerIrValue.I64 (opt-normalize-int-to-i64 n ty))
          ty)]
      [(option_i64.None) (OptKnownConst.NoConst)])
    (match ty
      [(AstType.Char)
        (match (opt-value-to-i64 value)
          [(option_i64.Some n)
            (OptKnownConst.SomeConst
              (CompilerIrValue.Char (cast n : char))
              (AstType.Char))]
          [(option_i64.None) (OptKnownConst.NoConst)])]
      [(AstType.Bool)
        (match (opt-value-to-bool value)
          [(OptMaybeBool.Some b)
            (OptKnownConst.SomeConst (CompilerIrValue.Bool b) (AstType.Bool))]
          [(OptMaybeBool.No) (OptKnownConst.NoConst)])]
      [(AstType.F64)
        (match value
          [(CompilerIrValue.F64 _)
            (OptKnownConst.SomeConst value (AstType.F64))]
          [_ (OptKnownConst.NoConst)])]
      [(AstType.F32)
        (match value
          [(CompilerIrValue.F64 _)
            (OptKnownConst.SomeConst value (AstType.F32))]
          [_ (OptKnownConst.NoConst)])]
      [_ (OptKnownConst.NoConst)])))

(define (opt-const-value? [value : CompilerIrValue] [ty : AstType]) : bool
  (match (opt-normalize-const value ty)
    [(OptKnownConst.SomeConst _ _) true]
    [(OptKnownConst.NoConst) false]))

(define (opt-default-immediate-type
  [value : CompilerIrValue]
  [fallback : AstType]) : AstType
  (match value
    [(CompilerIrValue.I64 _)
      (if (opt-int-or-char-type? fallback)
        fallback
        (AstType.I64))]
    [(CompilerIrValue.Char _) (AstType.Char)]
    [(CompilerIrValue.Bool _) (AstType.Bool)]
    [(CompilerIrValue.F64 _)
      (if (opt-float-type? fallback)
        fallback
        (AstType.F64))]
    [(CompilerIrValue.Unit) (AstType.Unit)]
    [_ fallback]))

(define (opt-resolve-known
  [env : OptConstEnv]
  [value : CompilerIrValue]
  [fallback-ty : AstType]) : OptKnownConst
  (match value
    [(CompilerIrValue.Var id)
      (match (opt-const-lookup env id)
        [(OptKnownConst.SomeConst v ty) (OptKnownConst.SomeConst v ty)]
        [(OptKnownConst.NoConst) (OptKnownConst.NoConst)])]
    [_
      (opt-normalize-const value (opt-default-immediate-type value fallback-ty))]))

(define (opt-resolve-value [env : OptConstEnv] [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var id)
      (match (opt-const-lookup env id)
        [(OptKnownConst.SomeConst v _) v]
        [(OptKnownConst.NoConst) value])]
    [_ value]))

;; --- folding rules -----------------------------------------------------------
(define (opt-normalize-scalar-to-i64 [value : CompilerIrValue] [ty : AstType]) : option_i64.Option
  (if (opt-int-or-char-type? ty)
    (match (opt-value-to-i64 value)
      [(option_i64.Some n) (option_i64.Some (opt-normalize-int-to-i64 n ty))]
      [(option_i64.None) (option_i64.None)])
    (option_i64.None)))

(define (opt-binop-operand-type
  [type-segment-bases : i64]
  [op : CompilerIrBinOp]
  [lhs-ty : AstType]
  [rhs-ty : AstType]
  [result-ty : AstType]) : AstType
  (match op
    [(CompilerIrBinOp.Eq)
      (if (opt-type-eq type-segment-bases lhs-ty (AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(CompilerIrBinOp.Ne)
      (if (opt-type-eq type-segment-bases lhs-ty (AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(CompilerIrBinOp.Lt)
      (if (opt-type-eq type-segment-bases lhs-ty (AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(CompilerIrBinOp.Le)
      (if (opt-type-eq type-segment-bases lhs-ty (AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(CompilerIrBinOp.Gt)
      (if (opt-type-eq type-segment-bases lhs-ty (AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(CompilerIrBinOp.Ge)
      (if (opt-type-eq type-segment-bases lhs-ty (AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(CompilerIrBinOp.BitAnd) lhs-ty]
    [(CompilerIrBinOp.BitOr) lhs-ty]
    [(CompilerIrBinOp.BitXor) lhs-ty]
    [(CompilerIrBinOp.Shl) lhs-ty]
    [(CompilerIrBinOp.Shr) lhs-ty]
    [_ result-ty]))

(define (opt-signed-min [ty : AstType]) : i64
  (match ty
    [(AstType.I64) (- (- 0 9223372036854775807) 1)]
    [(AstType.I32) (- 0 2147483648)]
    [(AstType.I16) (- 0 32768)]
    [(AstType.I8) (- 0 128)]
    [_ 0]))

(define (opt-divmod-valid? [a : i64] [b : i64] [ty : AstType]) : bool
  (if (= b 0)
    false
    (if (opt-signed-integer-type? ty)
      (not (and (= a (opt-signed-min ty)) (= b (- 0 1))))
      true)))

(define (opt-fold-div-value [a : i64] [b : i64] [ty : AstType]) : i64
  (match ty
    [(AstType.I64) (cast (/ (cast a : i64) (cast b : i64)) : i64)]
    [(AstType.I32) (cast (/ (cast a : i32) (cast b : i32)) : i64)]
    [(AstType.I16) (cast (/ (cast a : i16) (cast b : i16)) : i64)]
    [(AstType.I8) (cast (/ (cast a : i8) (cast b : i8)) : i64)]
    [(AstType.U64) (cast (/ (cast a : u64) (cast b : u64)) : i64)]
    [(AstType.U32) (cast (/ (cast a : u32) (cast b : u32)) : i64)]
    [(AstType.U16) (cast (/ (cast a : u16) (cast b : u16)) : i64)]
    [(AstType.U8) (cast (/ (cast a : u8) (cast b : u8)) : i64)]
    [_ 0]))

(define (opt-fold-mod-value [a : i64] [b : i64] [ty : AstType]) : i64
  (match ty
    [(AstType.I64) (cast (% (cast a : i64) (cast b : i64)) : i64)]
    [(AstType.I32) (cast (% (cast a : i32) (cast b : i32)) : i64)]
    [(AstType.I16) (cast (% (cast a : i16) (cast b : i16)) : i64)]
    [(AstType.I8) (cast (% (cast a : i8) (cast b : i8)) : i64)]
    [(AstType.U64) (cast (% (cast a : u64) (cast b : u64)) : i64)]
    [(AstType.U32) (cast (% (cast a : u32) (cast b : u32)) : i64)]
    [(AstType.U16) (cast (% (cast a : u16) (cast b : u16)) : i64)]
    [(AstType.U8) (cast (% (cast a : u8) (cast b : u8)) : i64)]
    [_ 0]))

(define (opt-unsigned-lt? [a : i64] [b : i64] [ty : AstType]) : bool
  (match ty
    [(AstType.U64) (< (cast a : u64) (cast b : u64))]
    [_ (< a b)]))

(define (opt-typed-lt? [a : i64] [b : i64] [ty : AstType]) : bool
  (if (opt-unsigned-integer-type? ty)
    (opt-unsigned-lt? a b ty)
    (< a b)))

(define (opt-typed-le? [a : i64] [b : i64] [ty : AstType]) : bool
  (or (= a b) (opt-typed-lt? a b ty)))

(define (opt-typed-gt? [a : i64] [b : i64] [ty : AstType]) : bool
  (opt-typed-lt? b a ty))

(define (opt-typed-ge? [a : i64] [b : i64] [ty : AstType]) : bool
  (or (= a b) (opt-typed-lt? b a ty)))

(define (opt-fold-compare
  [op : CompilerIrBinOp]
  [a : i64]
  [b : i64]
  [ty : AstType]) : CompilerIrMaybeValue
  (match op
    [(CompilerIrBinOp.Eq)
      (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (= a b)))]
    [(CompilerIrBinOp.Ne)
      (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (!= a b)))]
    [(CompilerIrBinOp.Lt)
      (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (opt-typed-lt? a b ty)))]
    [(CompilerIrBinOp.Le)
      (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (opt-typed-le? a b ty)))]
    [(CompilerIrBinOp.Gt)
      (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (opt-typed-gt? a b ty)))]
    [(CompilerIrBinOp.Ge)
      (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (opt-typed-ge? a b ty)))]
    [_ (CompilerIrMaybeValue.No)]))

(define (opt-shift-count-valid?
  [count : i64]
  [count-ty : AstType]
  [width : i64]) : bool
  (if (not (opt-integer-type? count-ty))
    false
    (if (opt-signed-integer-type? count-ty)
      (and (>= count 0) (< count width))
      (match count-ty
        [(AstType.U64) (< (cast count : u64) (cast width : u64))]
        [_ (< count width)]))))

(define (opt-fold-shl-value [a : i64] [count : i64] [ty : AstType]) : i64
  (match ty
    [(AstType.I64) (cast (shl (cast a : i64) (cast count : i64)) : i64)]
    [(AstType.I32) (cast (shl (cast a : i32) (cast count : i32)) : i64)]
    [(AstType.I16) (cast (shl (cast a : i16) (cast count : i16)) : i64)]
    [(AstType.I8) (cast (shl (cast a : i8) (cast count : i8)) : i64)]
    [(AstType.U64) (cast (shl (cast a : u64) (cast count : u64)) : i64)]
    [(AstType.U32) (cast (shl (cast a : u32) (cast count : u32)) : i64)]
    [(AstType.U16) (cast (shl (cast a : u16) (cast count : u16)) : i64)]
    [(AstType.U8) (cast (shl (cast a : u8) (cast count : u8)) : i64)]
    [_ 0]))

(define (opt-fold-shr-value [a : i64] [count : i64] [ty : AstType]) : i64
  (match ty
    [(AstType.I64) (cast (shr (cast a : i64) (cast count : i64)) : i64)]
    [(AstType.I32) (cast (shr (cast a : i32) (cast count : i32)) : i64)]
    [(AstType.I16) (cast (shr (cast a : i16) (cast count : i16)) : i64)]
    [(AstType.I8) (cast (shr (cast a : i8) (cast count : i8)) : i64)]
    [(AstType.U64) (cast (shr (cast a : u64) (cast count : u64)) : i64)]
    [(AstType.U32) (cast (shr (cast a : u32) (cast count : u32)) : i64)]
    [(AstType.U16) (cast (shr (cast a : u16) (cast count : u16)) : i64)]
    [(AstType.U8) (cast (shr (cast a : u8) (cast count : u8)) : i64)]
    [_ 0]))

(define (opt-fold-shift
  [op : CompilerIrBinOp]
  [a : i64]
  [rhs : CompilerIrValue]
  [rhs-ty : AstType]
  [ty : AstType]) : CompilerIrMaybeValue
  (match (opt-normalize-scalar-to-i64 rhs rhs-ty)
    [(option_i64.Some count)
      (if (opt-shift-count-valid? count rhs-ty (opt-int-width ty))
        (match op
          [(CompilerIrBinOp.Shl)
            (CompilerIrMaybeValue.Some
              (CompilerIrValue.I64
                (opt-normalize-int-to-i64 (opt-fold-shl-value a count ty) ty)))]
          [(CompilerIrBinOp.Shr)
            (CompilerIrMaybeValue.Some
              (CompilerIrValue.I64
                (opt-normalize-int-to-i64 (opt-fold-shr-value a count ty) ty)))]
          [_ (CompilerIrMaybeValue.No)])
        (CompilerIrMaybeValue.No))]
    [(option_i64.None) (CompilerIrMaybeValue.No)]))

(define (opt-fold-int-char-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [operand-ty : AstType]
  [rhs-ty : AstType]) : CompilerIrMaybeValue
  (match (opt-normalize-scalar-to-i64 lhs operand-ty)
    [(option_i64.Some a)
      (match op
        [(CompilerIrBinOp.Shl) (opt-fold-shift op a rhs rhs-ty operand-ty)]
        [(CompilerIrBinOp.Shr) (opt-fold-shift op a rhs rhs-ty operand-ty)]
        [_
          (match (opt-normalize-scalar-to-i64 rhs operand-ty)
            [(option_i64.Some b)
              (match op
                [(CompilerIrBinOp.Add)
                  (if (opt-integer-type? operand-ty)
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (+ a b) operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.Sub)
                  (if (opt-integer-type? operand-ty)
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (- a b) operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.Mul)
                  (if (opt-integer-type? operand-ty)
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (* a b) operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.Div)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64 (opt-fold-div-value a b operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.Mod)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64 (opt-fold-mod-value a b operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.SafeDiv)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64 (opt-fold-div-value a b operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.SafeMod)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64 (opt-fold-mod-value a b operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.BitAnd)
                  (if (opt-integer-type? operand-ty)
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (bit-and a b) operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.BitOr)
                  (if (opt-integer-type? operand-ty)
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (bit-or a b) operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.BitXor)
                  (if (opt-integer-type? operand-ty)
                    (CompilerIrMaybeValue.Some
                      (CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (bit-xor a b) operand-ty)))
                    (CompilerIrMaybeValue.No))]
                [(CompilerIrBinOp.Eq) (opt-fold-compare op a b operand-ty)]
                [(CompilerIrBinOp.Ne) (opt-fold-compare op a b operand-ty)]
                [(CompilerIrBinOp.Lt) (opt-fold-compare op a b operand-ty)]
                [(CompilerIrBinOp.Le) (opt-fold-compare op a b operand-ty)]
                [(CompilerIrBinOp.Gt) (opt-fold-compare op a b operand-ty)]
                [(CompilerIrBinOp.Ge) (opt-fold-compare op a b operand-ty)]
                [(CompilerIrBinOp.BitTestEq)
                  (CompilerIrMaybeValue.Some
                    (CompilerIrValue.Bool (= (bit-and a b) 0)))]
                [(CompilerIrBinOp.BitTestNe)
                  (CompilerIrMaybeValue.Some
                    (CompilerIrValue.Bool (!= (bit-and a b) 0)))]
                [_ (CompilerIrMaybeValue.No)])]
            [(option_i64.None) (CompilerIrMaybeValue.No)])])]
    [(option_i64.None) (CompilerIrMaybeValue.No)]))

(define (opt-fold-bool
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : CompilerIrMaybeValue
  (match (opt-value-to-bool lhs)
    [(OptMaybeBool.Some a)
      (match (opt-value-to-bool rhs)
        [(OptMaybeBool.Some b)
          (match op
            [(CompilerIrBinOp.And)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (and a b)))]
            [(CompilerIrBinOp.Or)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (or a b)))]
            [(CompilerIrBinOp.Eq)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (= a b)))]
            [(CompilerIrBinOp.Ne)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (!= a b)))]
            [_ (CompilerIrMaybeValue.No)])]
        [(OptMaybeBool.No) (CompilerIrMaybeValue.No)])]
    [(OptMaybeBool.No) (CompilerIrMaybeValue.No)]))

(define (opt-fold-float-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [operand-ty : AstType]) : CompilerIrMaybeValue
  (match (opt-value-to-f64 lhs operand-ty)
    [(CompilerFloatSomeF64 a)
      (match (opt-value-to-f64 rhs operand-ty)
        [(CompilerFloatSomeF64 b)
          (match op
            [(CompilerIrBinOp.Add) (opt-f64-to-ir-value (+ a b) operand-ty)]
            [(CompilerIrBinOp.Sub) (opt-f64-to-ir-value (- a b) operand-ty)]
            [(CompilerIrBinOp.Mul) (opt-f64-to-ir-value (* a b) operand-ty)]
            [(CompilerIrBinOp.Div)
              (if (= b 0.0)
                (CompilerIrMaybeValue.No)
                (opt-f64-to-ir-value (/ a b) operand-ty))]
            [(CompilerIrBinOp.SafeDiv)
              (if (= b 0.0)
                (CompilerIrMaybeValue.No)
                (opt-f64-to-ir-value (/ a b) operand-ty))]
            [(CompilerIrBinOp.Eq)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (= a b)))]
            [(CompilerIrBinOp.Ne)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (!= a b)))]
            [(CompilerIrBinOp.Lt)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (< a b)))]
            [(CompilerIrBinOp.Le)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (<= a b)))]
            [(CompilerIrBinOp.Gt)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (> a b)))]
            [(CompilerIrBinOp.Ge)
              (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (>= a b)))]
            [_ (CompilerIrMaybeValue.No)])]
        [(CompilerFloatNoF64) (CompilerIrMaybeValue.No)])]
    [(CompilerFloatNoF64) (CompilerIrMaybeValue.No)]))

(define (opt-finite-cast-input [src : OptKnownConst] [from-ty : AstType]) : CompilerFiniteCastInput
  (match src
    [(OptKnownConst.SomeConst value _)
      (match value
        [(CompilerIrValue.I64 n) (CompilerFiniteCastInputI64 n)]
        [(CompilerIrValue.Char c) (CompilerFiniteCastInputChar c)]
        [(CompilerIrValue.F64 bits)
          (match from-ty
            [(AstType.F32)
              (CompilerFiniteCastInputF32 (compiler-float-f32-bits-to-f64 bits))]
            [_ (CompilerFiniteCastInputF64 (compiler-float-f64-from-bits bits))])]
        [_ (CompilerFiniteCastNoInput)])]
    [(OptKnownConst.NoConst) (CompilerFiniteCastNoInput)]))

(define (opt-finite-cast-result-to-ir [result : CompilerFiniteCastResult]) : CompilerIrMaybeValue
  (match result
    [(CompilerFiniteCastResultI64 n)
      (CompilerIrMaybeValue.Some (CompilerIrValue.I64 n))]
    [(CompilerFiniteCastResultChar c)
      (CompilerIrMaybeValue.Some (CompilerIrValue.Char c))]
    [(CompilerFiniteCastResultF64 n) (opt-f64-to-ir-value n (AstType.F64))]
    [(CompilerFiniteCastResultF32 n) (opt-f64-to-ir-value n (AstType.F32))]
    [(CompilerFiniteCastNoResult) (CompilerIrMaybeValue.No)]))

(define (opt-fold-cast
  [src : OptKnownConst]
  [from-ty : AstType]
  [to-ty : AstType]) : CompilerIrMaybeValue
  (let
    [input : CompilerFiniteCastInput (opt-finite-cast-input src from-ty)]
    (match input
      [(CompilerFiniteCastNoInput) (CompilerIrMaybeValue.No)]
      [_
        (opt-finite-cast-result-to-ir
          (compiler-finite-cast-fold input from-ty to-ty))])))

(define (opt-fold-binop
  [type-segment-bases : i64]
  [op : CompilerIrBinOp]
  [lhs : OptKnownConst]
  [rhs : OptKnownConst]
  [result-ty : AstType]) : CompilerIrMaybeValue
  (match lhs
    [(OptKnownConst.SomeConst lhs-value lhs-ty)
      (match rhs
        [(OptKnownConst.SomeConst rhs-value rhs-ty)
          (let
            [operand-ty : AstType
              (opt-binop-operand-type
                type-segment-bases
                op
                lhs-ty
                rhs-ty
                result-ty)]
            (cond
              [(opt-bool-type? operand-ty)
                (opt-fold-bool op lhs-value rhs-value)]
              [(opt-int-or-char-type? operand-ty)
                (opt-fold-int-char-binop
                  op
                  lhs-value
                  rhs-value
                  operand-ty
                  rhs-ty)]
              [(opt-float-type? operand-ty)
                (opt-fold-float-binop op lhs-value rhs-value operand-ty)]
              [else (CompilerIrMaybeValue.No)]))]
        [(OptKnownConst.NoConst) (CompilerIrMaybeValue.No)])]
    [(OptKnownConst.NoConst) (CompilerIrMaybeValue.No)]))

(define (opt-fold-unop
  [op : CompilerIrUnOp]
  [src : OptKnownConst]
  [result-ty : AstType]) : CompilerIrMaybeValue
  (match src
    [(OptKnownConst.SomeConst value _)
      (match op
        [(CompilerIrUnOp.Neg)
          (if (opt-integer-type? result-ty)
            (match (opt-normalize-scalar-to-i64 value result-ty)
              [(option_i64.Some a)
                (CompilerIrMaybeValue.Some
                  (CompilerIrValue.I64
                    (opt-normalize-int-to-i64 (- 0 a) result-ty)))]
              [(option_i64.None) (CompilerIrMaybeValue.No)])
            (if (opt-float-type? result-ty)
              (match (opt-value-to-f64 value result-ty)
                [(CompilerFloatSomeF64 a)
                  (opt-f64-to-ir-value (- 0.0 a) result-ty)]
                [(CompilerFloatNoF64) (CompilerIrMaybeValue.No)])
              (CompilerIrMaybeValue.No)))]
        [(CompilerIrUnOp.Not)
          (if (opt-bool-type? result-ty)
            (match (opt-value-to-bool value)
              [(OptMaybeBool.Some a)
                (CompilerIrMaybeValue.Some (CompilerIrValue.Bool (not a)))]
              [(OptMaybeBool.No) (CompilerIrMaybeValue.No)])
            (CompilerIrMaybeValue.No))]
        [(CompilerIrUnOp.BitNot)
          (if (opt-integer-type? result-ty)
            (match (opt-normalize-scalar-to-i64 value result-ty)
              [(option_i64.Some a)
                (CompilerIrMaybeValue.Some
                  (CompilerIrValue.I64
                    (opt-normalize-int-to-i64 (bit-not a) result-ty)))]
              [(option_i64.None) (CompilerIrMaybeValue.No)])
            (CompilerIrMaybeValue.No))]
        ;; Do not fold sqrt through the compiler host. Runtime SSE2 is the
        ;; specified rounding/NaN implementation and must stay visible in IR.
        [(CompilerIrUnOp.Sqrt) (CompilerIrMaybeValue.No)])]
    [(OptKnownConst.NoConst) (CompilerIrMaybeValue.No)]))

;; --- strength reduction / algebraic identities ------------------------------
;;
;; Rewrite only identities that are valid for all values of the instruction's
;; type. Division, modulo, and shifts intentionally have no identities here, so
;; potentially trapping/edge-sensitive operations stay in the IR.
(define (opt-i64-zero? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.I64 n) (= n 0)]
    [_ false]))

(define (opt-i64-one? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.I64 n) (= n 1)]
    [_ false]))

(define (opt-bool-true? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Bool b) b]
    [_ false]))

(define (opt-bool-false? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Bool b) (not b)]
    [_ false]))

(define (opt-strength-int-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [resolved-lhs : CompilerIrValue]
  [resolved-rhs : CompilerIrValue]) : CompilerIrMaybeValue
  (match op
    [(CompilerIrBinOp.Add)
      (if (opt-i64-zero? resolved-rhs)
        (CompilerIrMaybeValue.Some lhs)
        (if (opt-i64-zero? resolved-lhs)
          (CompilerIrMaybeValue.Some rhs)
          (CompilerIrMaybeValue.No)))]
    [(CompilerIrBinOp.Sub)
      (if (opt-i64-zero? resolved-rhs)
        (CompilerIrMaybeValue.Some lhs)
        (CompilerIrMaybeValue.No))]
    [(CompilerIrBinOp.Mul)
      (cond
        [(or (opt-i64-zero? resolved-lhs) (opt-i64-zero? resolved-rhs))
          (CompilerIrMaybeValue.Some (CompilerIrValue.I64 0))]
        [(opt-i64-one? resolved-rhs) (CompilerIrMaybeValue.Some lhs)]
        [(opt-i64-one? resolved-lhs) (CompilerIrMaybeValue.Some rhs)]
        [else (CompilerIrMaybeValue.No)])]
    [(CompilerIrBinOp.BitOr)
      (if (opt-i64-zero? resolved-rhs)
        (CompilerIrMaybeValue.Some lhs)
        (if (opt-i64-zero? resolved-lhs)
          (CompilerIrMaybeValue.Some rhs)
          (CompilerIrMaybeValue.No)))]
    [(CompilerIrBinOp.BitXor)
      (if (opt-i64-zero? resolved-rhs)
        (CompilerIrMaybeValue.Some lhs)
        (if (opt-i64-zero? resolved-lhs)
          (CompilerIrMaybeValue.Some rhs)
          (CompilerIrMaybeValue.No)))]
    [_ (CompilerIrMaybeValue.No)]))

(define (opt-strength-bool-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [resolved-lhs : CompilerIrValue]
  [resolved-rhs : CompilerIrValue]) : CompilerIrMaybeValue
  (match op
    [(CompilerIrBinOp.And)
      (cond
        [(or (opt-bool-false? resolved-lhs) (opt-bool-false? resolved-rhs))
          (CompilerIrMaybeValue.Some (CompilerIrValue.Bool false))]
        [(opt-bool-true? resolved-rhs) (CompilerIrMaybeValue.Some lhs)]
        [(opt-bool-true? resolved-lhs) (CompilerIrMaybeValue.Some rhs)]
        [else (CompilerIrMaybeValue.No)])]
    [(CompilerIrBinOp.Or)
      (cond
        [(or (opt-bool-true? resolved-lhs) (opt-bool-true? resolved-rhs))
          (CompilerIrMaybeValue.Some (CompilerIrValue.Bool true))]
        [(opt-bool-false? resolved-rhs) (CompilerIrMaybeValue.Some lhs)]
        [(opt-bool-false? resolved-lhs) (CompilerIrMaybeValue.Some rhs)]
        [else (CompilerIrMaybeValue.No)])]
    [_ (CompilerIrMaybeValue.No)]))

(define (opt-strength-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [resolved-lhs : CompilerIrValue]
  [resolved-rhs : CompilerIrValue]
  [ty : AstType]) : CompilerIrMaybeValue
  (if (opt-integer-type? ty)
    (opt-strength-int-binop op lhs rhs resolved-lhs resolved-rhs)
    (if (opt-bool-type? ty)
      (opt-strength-bool-binop op lhs rhs resolved-lhs resolved-rhs)
      (CompilerIrMaybeValue.No))))

;; --- instruction / block / function / program traversal ----------------------
(defenum OptInstrResult
  (Result OptConstEnv CompilerIrInstr))

(define (opt-invalidate-def
  [env : OptConstEnv]
  [dst : i64]
  [instr : CompilerIrInstr]) : OptInstrResult
  (OptInstrResult.Result (opt-const-unbind env dst) instr))

(define (opt-invalidate-addr-of
  [env : OptConstEnv]
  [dst : i64]
  [src : i64]
  [instr : CompilerIrInstr]) : OptInstrResult
  (OptInstrResult.Result
    (opt-const-unbind (opt-const-unbind env dst) src)
    instr))

(define (opt-invalidate-spmd-result
  [env : OptConstEnv]
  [result : CompilerIrSpmdCallResult]
  [instr : CompilerIrInstr]) : OptInstrResult
  (match result
    [(CompilerIrSpmdCallResult.Unit) (OptInstrResult.Result env instr)]
    [(CompilerIrSpmdCallResult.Value dst _ _)
      (opt-invalidate-def env dst instr)]))

(define (opt-fold-mask-binop-op
  [op : CompilerIrMaskBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : CompilerIrMaskBinOp
  (if (opt-value-eq lhs rhs)
    (CompilerIrMaskBinOp.And)
    op))

(define (opt-fold-instr
  [type-segment-bases : i64]
  [env : OptConstEnv]
  [instr : CompilerIrInstr]) : OptInstrResult
  (match instr
    [(CompilerIrInstr.Mov dst value ty)
      (match (opt-resolve-known env value ty)
        [(OptKnownConst.SomeConst folded _)
          (OptInstrResult.Result
            (opt-const-bind env dst folded ty)
            (CompilerIrInstr.Mov dst folded ty))]
        [(OptKnownConst.NoConst)
          (OptInstrResult.Result (opt-const-unbind env dst) instr)])]
    [(CompilerIrInstr.Alloc dst ty) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.AddrOf dst src)
      (opt-invalidate-addr-of env dst src instr)]
    [(CompilerIrInstr.Gep dst base offset ty)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Load dst src ty) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (match (opt-fold-cast (opt-resolve-known env src from-ty) from-ty to-ty)
        [(CompilerIrMaybeValue.Some folded)
          (OptInstrResult.Result
            (opt-const-bind env dst folded to-ty)
            (CompilerIrInstr.Mov dst folded to-ty))]
        [(CompilerIrMaybeValue.No)
          (OptInstrResult.Result
            (opt-const-unbind env dst)
            (if (opt-int-cast-as-mov? from-ty to-ty)
              (CompilerIrInstr.Mov dst src to-ty)
              instr))])]
    [(CompilerIrInstr.Bitcast dst _ _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.BinOp dst op l r ty)
      (let
        [result-ty : AstType (compiler-ir-binop-result-type op ty)]
        (match (opt-fold-binop
          type-segment-bases
          op
          (opt-resolve-known env l ty)
          (opt-resolve-known env r ty)
          ty)
          [(CompilerIrMaybeValue.Some folded)
            (OptInstrResult.Result
              (opt-const-bind env dst folded result-ty)
              (CompilerIrInstr.Mov dst folded result-ty))]
          [(CompilerIrMaybeValue.No)
            (OptInstrResult.Result (opt-const-unbind env dst) instr)]))]
    [(CompilerIrInstr.UnOp dst op v ty)
      (match (opt-fold-unop op (opt-resolve-known env v ty) ty)
        [(CompilerIrMaybeValue.Some folded)
          (OptInstrResult.Result
            (opt-const-bind env dst folded ty)
            (CompilerIrInstr.Mov dst folded ty))]
        [(CompilerIrMaybeValue.No)
          (OptInstrResult.Result (opt-const-unbind env dst) instr)])]
    [(CompilerIrInstr.LaneId dst _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Splat dst _ _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (OptInstrResult.Result
        (opt-const-unbind env dst)
        (CompilerIrInstr.MaskBinOp
          dst
          (opt-fold-mask-binop-op op lhs rhs)
          lhs
          rhs
          lanes))]
    [(CompilerIrInstr.MaskNot dst _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.MaskReduce dst _ _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.TailMask dst _ _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.EntryArgc dst) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.EntryArgv dst) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.EntryEnvp dst) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.CpuId dst _ _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Xgetbv dst _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Syscall dst _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Call dst name args ty) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (opt-invalidate-spmd-result env result instr)])]
    [(CompilerIrInstr.StorePtr _ _ _)
      (OptInstrResult.Result OptConstEnv.Nil instr)]
    [(CompilerIrInstr.CopyBytes _ _ _)
      (OptInstrResult.Result OptConstEnv.Nil instr)]
    [(CompilerIrInstr.TailCall _ _ _) (OptInstrResult.Result env instr)]
    [(CompilerIrInstr.Phi dst inputs ty) (opt-invalidate-def env dst instr)]
    [_ (OptInstrResult.Result env instr)]))

(define (opt-fold-instrs
  [type-segment-bases : i64]
  [env : OptConstEnv]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (match (opt-fold-instr type-segment-bases env instr)
        [(OptInstrResult.Result new-env new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-fold-instrs type-segment-bases new-env (box-get rest)))])]))

(define (opt-strength-instr [env : OptConstEnv] [instr : CompilerIrInstr]) : OptInstrResult
  (match instr
    [(CompilerIrInstr.Mov dst value ty)
      (match (opt-resolve-known env value ty)
        [(OptKnownConst.SomeConst folded _)
          (OptInstrResult.Result
            (opt-const-bind env dst folded ty)
            (CompilerIrInstr.Mov dst folded ty))]
        [(OptKnownConst.NoConst)
          (OptInstrResult.Result (opt-const-unbind env dst) instr)])]
    [(CompilerIrInstr.Alloc dst ty) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.AddrOf dst src)
      (opt-invalidate-addr-of env dst src instr)]
    [(CompilerIrInstr.Gep dst base offset ty)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Load dst src ty) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.BinOp dst op l r ty)
      (match (opt-strength-binop
        op
        l
        r
        (opt-resolve-value env l)
        (opt-resolve-value env r)
        ty)
        [(CompilerIrMaybeValue.Some replacement)
          (if (opt-const-value? replacement ty)
            (OptInstrResult.Result
              (opt-const-bind env dst replacement ty)
              (CompilerIrInstr.Mov dst replacement ty))
            (OptInstrResult.Result
              (opt-const-unbind env dst)
              (CompilerIrInstr.Mov dst replacement ty)))]
        [(CompilerIrMaybeValue.No)
          (OptInstrResult.Result (opt-const-unbind env dst) instr)])]
    [(CompilerIrInstr.UnOp dst op v ty) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.LaneId dst _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Splat dst _ _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (OptInstrResult.Result
        (opt-const-unbind env dst)
        (CompilerIrInstr.MaskBinOp
          dst
          (opt-fold-mask-binop-op op lhs rhs)
          lhs
          rhs
          lanes))]
    [(CompilerIrInstr.MaskNot dst _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.MaskReduce dst _ _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(CompilerIrInstr.TailMask dst _ _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.EntryArgc dst) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.EntryArgv dst) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.EntryEnvp dst) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.CpuId dst _ _ _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Xgetbv dst _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Syscall dst _) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.Call dst name args ty) (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (opt-invalidate-spmd-result env result instr)])]
    [(CompilerIrInstr.StorePtr _ _ _)
      (OptInstrResult.Result OptConstEnv.Nil instr)]
    [(CompilerIrInstr.CopyBytes _ _ _)
      (OptInstrResult.Result OptConstEnv.Nil instr)]
    [(CompilerIrInstr.TailCall _ _ _) (OptInstrResult.Result env instr)]
    [(CompilerIrInstr.Phi dst inputs ty) (opt-invalidate-def env dst instr)]
    [_ (OptInstrResult.Result env instr)]))

(define (opt-strength-instrs [env : OptConstEnv] [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (match (opt-strength-instr env instr)
        [(OptInstrResult.Result new-env new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-strength-instrs new-env (box-get rest)))])]))

;; --- dead-code elimination ---------------------------------------------------
;;
;; Conservative DCE matching the Rust optimizer's first slice: collect every IR
;; var id referenced as an operand anywhere in the function, then drop pure
;; temporary-producing instructions (`Mov`/`BinOp`/`UnOp`/`Phi`) whose result is
;; never used. Calls, stores, jumps, branches, and returns are kept regardless
;; (they have side effects or drive control flow). The used set is gathered over
;; the *whole reachable function* after CFG simplification, so a var used in
;; another remaining block is never dropped. DCE itself does not decide
;; reachability.
;; Used-var set: var ids referenced somewhere in the function. Backed by
;; opt_i64_i64_map.Map (stored value 1 = present) for O(1) membership; previously a linked
;; list with O(n) contains and O(n^2) dedup'd inserts.
(define (opt-used-contains [set : opt_i64_i64_map.Map] [var : i64]) : bool
  (opt_i64_i64_map.contains? (& set) var))

(define (opt-used-add [set : opt_i64_i64_map.Map] [var : i64]) : opt_i64_i64_map.Map
  (let
    [out : opt_i64_i64_map.Map set]
    (begin
      (opt_i64_i64_map.insert-ref! (&mut out) var 1)
      out)))

(define (opt-collect-value-uses
  [set : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : opt_i64_i64_map.Map
  (match value
    [(CompilerIrValue.Var id) (opt-used-add set id)]
    [_ set]))

(define (opt-collect-value-list-uses
  [set : opt_i64_i64_map.Map]
  [values : CompilerIrValueList]) : opt_i64_i64_map.Map
  (match values
    [(CompilerIrValueList.Nil) set]
    [(CompilerIrValueList.Array seq)
      (opt-collect-value-list-uses set (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (opt-collect-value-list-uses
        (opt-collect-value-uses set value)
        (box-get rest))]))

(define (opt-collect-call-args-array-uses
  [set : opt_i64_i64_map.Map]
  [values : (Array CompilerIrValue)]
  [index : i64]) : opt_i64_i64_map.Map
  (if (>= index (array-length values))
    set
    (opt-collect-call-args-array-uses
      (opt-collect-value-uses set (array-ref values index))
      values
      (+ index 1))))

(define (opt-collect-call-args-uses
  [set : opt_i64_i64_map.Map]
  [args : CompilerIrCallArgs]) : opt_i64_i64_map.Map
  (match args
    [(CompilerIrCallArgs.Nil) set]
    [(CompilerIrCallArgs.One value) (opt-collect-value-uses set value)]
    [(CompilerIrCallArgs.Two a b)
      (opt-collect-value-uses (opt-collect-value-uses set a) b)]
    [(CompilerIrCallArgs.Array values)
      (opt-collect-call-args-array-uses set values 0)]))

(define (opt-collect-spmd-call-args-uses
  [set : opt_i64_i64_map.Map]
  [args : CompilerIrSpmdCallArgList]) : opt_i64_i64_map.Map
  (match args
    [(CompilerIrSpmdCallArgList.Nil) set]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (opt-collect-spmd-call-args-uses
            (opt-collect-value-uses set value)
            (box-get rest))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : opt_i64_i64_map.Map set]
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (opt-collect-value-uses out value))])
              (set! i (+ i 1))))
          out))]))

(define (opt-collect-phi-uses
  [set : opt_i64_i64_map.Map]
  [inputs : CompilerIrPhiInputList]) : opt_i64_i64_map.Map
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) set]
    [(CompilerIrPhiInputList.Array seq)
      (opt-collect-phi-uses set (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (opt-collect-phi-uses (opt-collect-value-uses set value) (box-get rest))]))

(define (opt-collect-instr-uses
  [set : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : opt_i64_i64_map.Map
  (match instr
    [(CompilerIrInstr.Mov _ src _) (opt-collect-value-uses set src)]
    [(CompilerIrInstr.BinOp _ _ l r _)
      (opt-collect-value-uses (opt-collect-value-uses set l) r)]
    [(CompilerIrInstr.UnOp _ _ src _) (opt-collect-value-uses set src)]
    [(CompilerIrInstr.Call _ _ args _) (opt-collect-call-args-uses set args)]
    [(CompilerIrInstr.CallIndirect _ func args _)
      (opt-collect-call-args-uses (opt-collect-value-uses set func) args)]
    [(CompilerIrInstr.CallIndirectC _ func args _)
      (opt-collect-call-args-uses (opt-collect-value-uses set func) args)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base _ args _)
          (opt-collect-call-args-uses (opt-collect-value-uses set base) args)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            _)
          (opt-collect-call-args-uses
            (opt-collect-value-uses (opt-collect-value-uses set base) func)
            args)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (opt-collect-spmd-call-args-uses
            (opt-collect-value-uses set active-mask)
            args)])]
    [(CompilerIrInstr.TailCall _ args _) (opt-collect-call-args-uses set args)]
    [(CompilerIrInstr.Store _ value _) (opt-collect-value-uses set value)]
    ;; Pointer/memory ops carry operand uses too; missing any of these would let
    ;; DCE wrongly drop a definition that feeds an address/load/store/cast.
    [(CompilerIrInstr.AddrOf _ src) (opt-used-add set src)]
    [(CompilerIrInstr.Gep _ base offset _)
      (opt-collect-value-uses (opt-collect-value-uses set base) offset)]
    [(CompilerIrInstr.Load _ src _) (opt-collect-value-uses set src)]
    [(CompilerIrInstr.StorePtr ptr value _)
      (opt-collect-value-uses (opt-collect-value-uses set ptr) value)]
    [(CompilerIrInstr.CopyBytes dst src _)
      (opt-collect-value-uses (opt-collect-value-uses set dst) src)]
    [(CompilerIrInstr.BoundsCheck index length _)
      (opt-collect-value-uses (opt-collect-value-uses set index) length)]
    [(CompilerIrInstr.Cast _ src _ _) (opt-collect-value-uses set src)]
    [(CompilerIrInstr.Bitcast _ src _ _) (opt-collect-value-uses set src)]
    [(CompilerIrInstr.Splat _ value _ _) (opt-collect-value-uses set value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (opt-collect-value-uses (opt-collect-value-uses set lhs) rhs)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (opt-collect-value-uses (opt-collect-value-uses set src) carry)])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-collect-value-uses set src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (opt-collect-value-uses (opt-collect-value-uses set lhs) rhs)])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-collect-value-uses (opt-collect-value-uses set lhs) rhs)]
    [(CompilerIrInstr.MaskNot _ src _) (opt-collect-value-uses set src)]
    [(CompilerIrInstr.MaskReduce _ _ src _) (opt-collect-value-uses set src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (opt-collect-value-uses
            (opt-collect-value-uses (opt-collect-value-uses set mask) on-true)
            on-false)])]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (opt-collect-value-uses (opt-collect-value-uses set base) index)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value _ _)
          (opt-collect-value-uses
            (opt-collect-value-uses (opt-collect-value-uses set base) index)
            value)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            _
            _)
          (opt-collect-value-uses
            (opt-collect-value-uses
              (opt-collect-value-uses (opt-collect-value-uses set base) index)
              value)
            mask)])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base index mask _ _)
          (opt-collect-value-uses
            (opt-collect-value-uses (opt-collect-value-uses set base) index)
            mask)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            _
            base
            index-base
            index
            _
            _
            _)
          (opt-collect-value-uses
            (opt-collect-value-uses
              (opt-collect-value-uses set base)
              index-base)
            index)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (opt-collect-value-uses
            (match selector-high
              [(CompilerIrMaybeValue.Some value)
                (opt-collect-value-uses
                  (opt-collect-value-uses
                    (opt-collect-value-uses set source)
                    selector-low)
                  value)]
              [(CompilerIrMaybeValue.No)
                (opt-collect-value-uses
                  (opt-collect-value-uses set source)
                  selector-low)])
            active-lanes)])]
    [(CompilerIrInstr.TailMask _ index length _)
      (opt-collect-value-uses (opt-collect-value-uses set index) length)]
    [(CompilerIrInstr.EntryArgc _) set]
    [(CompilerIrInstr.EntryArgv _) set]
    [(CompilerIrInstr.EntryEnvp _) set]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-collect-value-uses (opt-collect-value-uses set leaf) subleaf)]
    [(CompilerIrInstr.Xgetbv _ index) (opt-collect-value-uses set index)]
    [(CompilerIrInstr.Syscall _ args) (opt-collect-call-args-uses set args)]
    [(CompilerIrInstr.Branch cond _ _) (opt-collect-value-uses set cond)]
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.Some value) (opt-collect-value-uses set value)]
        [(CompilerIrMaybeValue.No) set])]
    [(CompilerIrInstr.Phi _ inputs _) (opt-collect-phi-uses set inputs)]
    ;; Register-group ops use their operands -- Pack uses each word value,
    ;; Word uses the source group. Omitting these would let DCE drop a definition
    ;; that feeds a Pack/Word.
    [(CompilerIrInstr.Pack _ words _) (opt-collect-value-list-uses set words)]
    [(CompilerIrInstr.Word _ src _ _) (opt-collect-value-uses set src)]
    [(CompilerIrInstr.TailCallIndirect func args _)
      (opt-collect-call-args-uses (opt-collect-value-uses set func) args)]
    [(CompilerIrInstr.Switch index _ _ _) (opt-collect-value-uses set index)]
    ;; `CompilerIrInstr.Alloc` has no operand uses; `CompilerIrInstr.Jump` has none either.
    [_ set]))

(define (opt-collect-instrs-uses
  [set : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrList]) : opt_i64_i64_map.Map
  (match instrs
    [(CompilerIrInstrList.Nil) set]
    [(CompilerIrInstrList.Cons instr rest)
      (opt-collect-instrs-uses
        (opt-collect-instr-uses set instr)
        (box-get rest))]))

(define (opt-collect-instr-seq-uses-from
  [set : opt_i64_i64_map.Map]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]) : opt_i64_i64_map.Map
  (if (>= index count)
    set
    (opt-collect-instr-seq-uses-from
      (opt-collect-instr-uses set (array-ref slots index))
      slots
      (+ index 1)
      count)))

(define (opt-collect-instr-seq-uses
  [set : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]) : opt_i64_i64_map.Map
  (opt-collect-instr-seq-uses-from
    set
    (struct-get instrs slots)
    0
    (struct-get instrs len)))

;; Division, modulo, and shift can trap at runtime (zero divisor, signed
;; MIN / -1, shift count out of range), so a BinOp using one of those operators
;; is NOT pure: dropping it as dead would elide the trap the safe-code contract
;; requires. These ops must stay in the IR even when their result is unused.
(define (opt-binop-traps? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Div) true]
    [(CompilerIrBinOp.Mod) true]
    [(CompilerIrBinOp.Shl) true]
    [(CompilerIrBinOp.Shr) true]
    [_ false]))

(define (opt-instr-alloc-dst? [instr : CompilerIrInstr] [dst : i64]) : bool
  (match instr
    [(CompilerIrInstr.Alloc other _) (= other dst)]
    [_ false]))

(define (opt-next-adjacent-alloc? [next : CompilerIrInstrList] [dst : i64]) : bool
  (match next
    [(CompilerIrInstrList.Cons instr _) (opt-instr-alloc-dst? instr (+ dst 1))]
    [_ false]))

(define (opt-array-prev-adjacent-alloc?
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [dst : i64]) : bool
  (if (<= index 0)
    false
    (opt-instr-alloc-dst? (array-ref slots (- index 1)) (- dst 1))))

(define (opt-array-next-adjacent-alloc?
  [slots : (Array CompilerIrInstr)]
  [count : i64]
  [index : i64]
  [dst : i64]) : bool
  (if (>= (+ index 1) count)
    false
    (opt-instr-alloc-dst? (array-ref slots (+ index 1)) (+ dst 1))))

;; A pure temporary-producing instruction is dead when its result var is unused.
;; Calls (side-effecting) and control-flow instructions are never dead here.
;;
;; Address creation (`CompilerIrInstr.AddrOf`), address arithmetic (`CompilerIrInstr.Gep`), value
;; conversions (`CompilerIrInstr.Cast`), and non-volatile reads (`CompilerIrInstr.Load`) are pure
;; or read-only
;; (`compiler-ir-instr-effect` classes `CompilerIrEffect.Pure` / `CompilerIrEffect.MemoryRead`): a
;; dead address calculation/read never writes state and only ever feeds its
;; result var, so when that var is unused the whole computation is dead. These
;; arms let DCE clear the dead length-load / addr-of / gep / cast chain that
;; `opt-loop-bce-blocks` leaves behind once it proves an array index in range,
;; which otherwise survives every later pass because these producers were
;; excluded here.
(define (opt-instr-dead? [set : opt_i64_i64_map.Map] [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov dst _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.AddrOf dst _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.Gep dst _ _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.Cast dst _ _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.Load dst _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.BinOp dst op _ _ _)
      (and (not (opt-binop-traps? op)) (not (opt-used-contains set dst)))]
    [(CompilerIrInstr.UnOp dst _ _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.Phi dst _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.LaneId dst _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.Splat dst _ _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (not (opt-used-contains set dst))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (not (opt-used-contains set dst))])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (not (opt-used-contains set dst))]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (not (opt-used-contains set dst))])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.MaskNot dst _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.MaskReduce dst _ _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (not (opt-used-contains set dst))])]
    [(CompilerIrInstr.TailMask dst _ _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.Pack dst _ _) (not (opt-used-contains set dst))]
    [(CompilerIrInstr.Word dst _ _ _) (not (opt-used-contains set dst))]
    [_ false]))

(define (opt-dce-instrs-from
  [set : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrList]
  [prev-alloc-dst : i64]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (let
        [rest-list : CompilerIrInstrList (box-get rest)]
        (if (opt-instr-dead? set instr)
          (opt-dce-instrs-from set rest-list -2)
          (match instr
            [(CompilerIrInstr.Alloc dst _)
              (if (and
                (not (opt-used-contains set dst))
                (not
                  (or
                    (= prev-alloc-dst (- dst 1))
                    (opt-next-adjacent-alloc? rest-list dst))))
                (opt-dce-instrs-from set rest-list dst)
                (compiler-ir-instr-cons
                  instr
                  (opt-dce-instrs-from set rest-list dst)))]
            [_
              (compiler-ir-instr-cons
                instr
                (opt-dce-instrs-from set rest-list -2))])))]))

(define (opt-dce-instrs
  [set : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (opt-dce-instrs-from set instrs -2))

;; `make-array` already returns zeroed memory, so a fresh use-count array needs
;; no initialising pass. The `opt-used-array-fill` helper existed only to run
;; that pass and had no other caller, so it goes with it.
(define (opt-used-array-new [count : i64]) : (Array i64)
  (array.make-array i64 count))

;; Use counts (not booleans): `add` bumps the count, `contains` reports any live
;; use, and `dec` drops a single use when DCE deletes an instruction. Counting
;; lets one backward DCE sweep retire a whole dead chain -- deleting the cast
;; that fed a removed bounds check decrements its operand load, which then reads
;; as dead when the sweep reaches it, and so on down the gep.
(define (opt-used-array-add [items : (Array i64)] [var : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length items))
      unit
      (begin
        (array-set! items var (+ (array-ref items var) 1))
        unit))))

(define (opt-used-array-dec [items : (Array i64)] [var : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length items))
      unit
      (let
        [current : i64 (array-ref items var)]
        (if (> current 0)
          (begin
            (array-set! items var (- current 1))
            unit)
          unit)))))

(define (opt-used-array-contains [items : (Array i64)] [var : i64]) : bool
  (if (< var 0)
    false
    (if (>= var (array-length items))
      false
      (> (array-ref items var) 0))))

(define (opt-collect-value-uses-array
  [items : (Array i64)]
  [value : CompilerIrValue]) : unit
  (match value
    [(CompilerIrValue.Var id) (opt-used-array-add items id)]
    [_ unit]))

(define (opt-collect-value-list-uses-array
  [items : (Array i64)]
  [values : CompilerIrValueList]) : unit
  (match values
    [(CompilerIrValueList.Nil) unit]
    [(CompilerIrValueList.Array seq)
      (opt-collect-value-list-uses-array
        items
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (begin
        (opt-collect-value-uses-array items value)
        (opt-collect-value-list-uses-array items (box-get rest)))]))

(define (opt-collect-call-args-array-uses-array
  [items : (Array i64)]
  [values : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length values))
    unit
    (begin
      (opt-collect-value-uses-array items (array-ref values index))
      (opt-collect-call-args-array-uses-array items values (+ index 1)))))

(define (opt-collect-call-args-uses-array
  [items : (Array i64)]
  [args : CompilerIrCallArgs]) : unit
  (match args
    [(CompilerIrCallArgs.Nil) unit]
    [(CompilerIrCallArgs.One value) (opt-collect-value-uses-array items value)]
    [(CompilerIrCallArgs.Two a b)
      (begin
        (opt-collect-value-uses-array items a)
        (opt-collect-value-uses-array items b))]
    [(CompilerIrCallArgs.Array values)
      (opt-collect-call-args-array-uses-array items values 0)]))

(define (opt-collect-spmd-call-args-uses-array
  [items : (Array i64)]
  [args : CompilerIrSpmdCallArgList]) : unit
  (match args
    [(CompilerIrSpmdCallArgList.Nil) unit]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (begin
            (opt-collect-value-uses-array items value)
            (opt-collect-spmd-call-args-uses-array items (box-get rest)))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (while (< i count)
          (begin
            (match (array-ref slots i)
              [(CompilerIrSpmdCallArg.Arg _ value _)
                (opt-collect-value-uses-array items value)])
            (set! i (+ i 1)))))]))

(define (opt-collect-phi-uses-array
  [items : (Array i64)]
  [inputs : CompilerIrPhiInputList]) : unit
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) unit]
    [(CompilerIrPhiInputList.Array seq)
      (opt-collect-phi-uses-array items (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (opt-collect-value-uses-array items value)
        (opt-collect-phi-uses-array items (box-get rest)))]))

(define (opt-collect-instr-uses-array
  [items : (Array i64)]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(CompilerIrInstr.Mov _ src _) (opt-collect-value-uses-array items src)]
    [(CompilerIrInstr.BinOp _ _ l r _)
      (begin
        (opt-collect-value-uses-array items l)
        (opt-collect-value-uses-array items r))]
    [(CompilerIrInstr.UnOp _ _ src _) (opt-collect-value-uses-array items src)]
    [(CompilerIrInstr.Call _ _ args _)
      (opt-collect-call-args-uses-array items args)]
    [(CompilerIrInstr.CallIndirect _ func args _)
      (begin
        (opt-collect-value-uses-array items func)
        (opt-collect-call-args-uses-array items args))]
    [(CompilerIrInstr.CallIndirectC _ func args _)
      (begin
        (opt-collect-value-uses-array items func)
        (opt-collect-call-args-uses-array items args))]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base _ args _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-call-args-uses-array items args))])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-value-uses-array items func)
            (opt-collect-call-args-uses-array items args))])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (begin
            (opt-collect-value-uses-array items active-mask)
            (opt-collect-spmd-call-args-uses-array items args))])]
    [(CompilerIrInstr.TailCall _ args _)
      (opt-collect-call-args-uses-array items args)]
    [(CompilerIrInstr.Store _ value _)
      (opt-collect-value-uses-array items value)]
    [(CompilerIrInstr.AddrOf _ src) (opt-used-array-add items src)]
    [(CompilerIrInstr.Gep _ base offset _)
      (begin
        (opt-collect-value-uses-array items base)
        (opt-collect-value-uses-array items offset))]
    [(CompilerIrInstr.Load _ src _) (opt-collect-value-uses-array items src)]
    [(CompilerIrInstr.StorePtr ptr value _)
      (begin
        (opt-collect-value-uses-array items ptr)
        (opt-collect-value-uses-array items value))]
    [(CompilerIrInstr.CopyBytes dst src _)
      (begin
        (opt-collect-value-uses-array items dst)
        (opt-collect-value-uses-array items src))]
    [(CompilerIrInstr.BoundsCheck index length _)
      (begin
        (opt-collect-value-uses-array items index)
        (opt-collect-value-uses-array items length))]
    [(CompilerIrInstr.Cast _ src _ _) (opt-collect-value-uses-array items src)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (opt-collect-value-uses-array items src)]
    [(CompilerIrInstr.Splat _ value _ _)
      (opt-collect-value-uses-array items value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (begin
            (opt-collect-value-uses-array items lhs)
            (opt-collect-value-uses-array items rhs))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (begin
            (opt-collect-value-uses-array items src)
            (opt-collect-value-uses-array items carry))])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-collect-value-uses-array items src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (begin
            (opt-collect-value-uses-array items lhs)
            (opt-collect-value-uses-array items rhs))])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (opt-collect-value-uses-array items lhs)
        (opt-collect-value-uses-array items rhs))]
    [(CompilerIrInstr.MaskNot _ src _) (opt-collect-value-uses-array items src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (opt-collect-value-uses-array items src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (begin
            (opt-collect-value-uses-array items mask)
            (opt-collect-value-uses-array items on-true)
            (opt-collect-value-uses-array items on-false))])]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (begin
        (opt-collect-value-uses-array items base)
        (opt-collect-value-uses-array items index))]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value _ _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-value-uses-array items index)
            (opt-collect-value-uses-array items value))])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            _
            _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-value-uses-array items index)
            (opt-collect-value-uses-array items value)
            (opt-collect-value-uses-array items mask))])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base index mask _ _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-value-uses-array items index)
            (opt-collect-value-uses-array items mask))])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            _
            base
            index-base
            index
            _
            _
            _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-value-uses-array items index-base)
            (opt-collect-value-uses-array items index))])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (begin
            (opt-collect-value-uses-array items source)
            (opt-collect-value-uses-array items selector-low)
            (match selector-high
              [(CompilerIrMaybeValue.Some value)
                (opt-collect-value-uses-array items value)]
              [(CompilerIrMaybeValue.No) unit])
            (opt-collect-value-uses-array items active-lanes))])]
    [(CompilerIrInstr.TailMask _ index length _)
      (begin
        (opt-collect-value-uses-array items index)
        (opt-collect-value-uses-array items length))]
    [(CompilerIrInstr.EntryArgc _) unit]
    [(CompilerIrInstr.EntryArgv _) unit]
    [(CompilerIrInstr.EntryEnvp _) unit]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (begin
        (opt-collect-value-uses-array items leaf)
        (opt-collect-value-uses-array items subleaf))]
    [(CompilerIrInstr.Xgetbv _ index)
      (opt-collect-value-uses-array items index)]
    [(CompilerIrInstr.Syscall _ args)
      (opt-collect-call-args-uses-array items args)]
    [(CompilerIrInstr.Branch cond _ _)
      (opt-collect-value-uses-array items cond)]
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.Some value)
          (opt-collect-value-uses-array items value)]
        [(CompilerIrMaybeValue.No) unit])]
    [(CompilerIrInstr.Phi _ inputs _) (opt-collect-phi-uses-array items inputs)]
    ;; Register-group ops use their operands (Pack: each word; Word: src).
    [(CompilerIrInstr.Pack _ words _)
      (opt-collect-value-list-uses-array items words)]
    [(CompilerIrInstr.Word _ src _ _) (opt-collect-value-uses-array items src)]
    [(CompilerIrInstr.TailCallIndirect func args _)
      (begin
        (opt-collect-value-uses-array items func)
        (opt-collect-call-args-uses-array items args))]
    [(CompilerIrInstr.Switch index _ _ _)
      (opt-collect-value-uses-array items index)]
    [_ unit]))

;; Decrement the operand use counts an instruction contributed. Called when DCE
;; deletes that instruction so a single backward sweep can retire the rest of a
;; now-dead chain. Only the pure/group producers DCE can delete need arms here;
;; anything else leaves the counts untouched (conservative -- it just keeps an
;; instruction).
(define (opt-uncount-value-uses-array
  [items : (Array i64)]
  [value : CompilerIrValue]) : unit
  (match value
    [(CompilerIrValue.Var id) (opt-used-array-dec items id)]
    [_ unit]))

(define (opt-uncount-value-list-uses-array
  [items : (Array i64)]
  [values : CompilerIrValueList]) : unit
  (match values
    [(CompilerIrValueList.Nil) unit]
    [(CompilerIrValueList.Array seq)
      (opt-uncount-value-list-uses-array
        items
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (begin
        (opt-uncount-value-uses-array items value)
        (opt-uncount-value-list-uses-array items (box-get rest)))]))

(define (opt-uncount-phi-uses-array
  [items : (Array i64)]
  [inputs : CompilerIrPhiInputList]) : unit
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) unit]
    [(CompilerIrPhiInputList.Array seq)
      (opt-uncount-phi-uses-array items (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (opt-uncount-value-uses-array items value)
        (opt-uncount-phi-uses-array items (box-get rest)))]))

(define (opt-uncount-instr-uses-array
  [items : (Array i64)]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(CompilerIrInstr.Mov _ src _) (opt-uncount-value-uses-array items src)]
    [(CompilerIrInstr.AddrOf _ src) (opt-used-array-dec items src)]
    [(CompilerIrInstr.Gep _ base offset _)
      (begin
        (opt-uncount-value-uses-array items base)
        (opt-uncount-value-uses-array items offset))]
    [(CompilerIrInstr.Cast _ src _ _) (opt-uncount-value-uses-array items src)]
    [(CompilerIrInstr.Load _ src _) (opt-uncount-value-uses-array items src)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (begin
        (opt-uncount-value-uses-array items lhs)
        (opt-uncount-value-uses-array items rhs))]
    [(CompilerIrInstr.UnOp _ _ src _) (opt-uncount-value-uses-array items src)]
    [(CompilerIrInstr.Phi _ inputs _) (opt-uncount-phi-uses-array items inputs)]
    [(CompilerIrInstr.Splat _ value _ _)
      (opt-uncount-value-uses-array items value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (begin
            (opt-uncount-value-uses-array items lhs)
            (opt-uncount-value-uses-array items rhs))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (begin
            (opt-uncount-value-uses-array items src)
            (opt-uncount-value-uses-array items carry))])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-uncount-value-uses-array items src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (begin
            (opt-uncount-value-uses-array items lhs)
            (opt-uncount-value-uses-array items rhs))])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (opt-uncount-value-uses-array items lhs)
        (opt-uncount-value-uses-array items rhs))]
    [(CompilerIrInstr.MaskNot _ src _) (opt-uncount-value-uses-array items src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (opt-uncount-value-uses-array items src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (begin
            (opt-uncount-value-uses-array items mask)
            (opt-uncount-value-uses-array items on-true)
            (opt-uncount-value-uses-array items on-false))])]
    [(CompilerIrInstr.TailMask _ index length _)
      (begin
        (opt-uncount-value-uses-array items index)
        (opt-uncount-value-uses-array items length))]
    [(CompilerIrInstr.Pack _ words _)
      (opt-uncount-value-list-uses-array items words)]
    [(CompilerIrInstr.Word _ src _ _) (opt-uncount-value-uses-array items src)]
    [_ unit]))

(define (opt-collect-instr-seq-uses-array
  [items : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (opt-collect-instr-uses-array items (array-ref slots index))
          (set! index (+ index 1))))
      unit)))

(define (opt-collect-block-seq-uses-array-into
  [items : (Array i64)]
  [blocks : CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    (while (< index count)
      (begin
        (match (compiler-ir-block-seq-ref blocks index)
          [(CompilerIrBlock.Block _ instrs)
            (opt-collect-instr-seq-uses-array items instrs)])
        (set! index (+ index 1))))))

(define (opt-collect-blocks-uses-array-into
  [items : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (opt-collect-instr-seq-uses-array items instrs)
            (opt-collect-blocks-uses-array-into items (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-collect-block-seq-uses-array-into items seq)]))

(define (opt-collect-blocks-uses-array
  [vars : i64]
  [blocks : CompilerIrBlockList]) : (Array i64)
  (let
    [items : (Array i64) (opt-used-array-new vars)]
    (begin
      (opt-collect-blocks-uses-array-into items blocks)
      items)))

;; Mirror of `opt-instr-dead?` for the array-backed use set the pipeline DCE
;; runs on. The pure/read-only addr-of/gep/cast/load arms drop the dead
;; length-load/address chain that `opt-loop-bce-blocks` strands once a bounds
;; check is proven redundant.
(define (opt-instr-dead-array?
  [items : (Array i64)]
  [slots : (Array CompilerIrInstr)]
  [count : i64]
  [index : i64]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Alloc dst _)
      (and
        (not (opt-used-array-contains items dst))
        (not
          (or
            (opt-array-prev-adjacent-alloc? slots index dst)
            (opt-array-next-adjacent-alloc? slots count index dst))))]
    [(CompilerIrInstr.Mov dst _ _) (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.AddrOf dst _) (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.Gep dst _ _ _) (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.Cast dst _ _ _) (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.Load dst _ _) (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (begin
        ;; This DCE walk already owns the function-wide use counts and visits
        ;; every instruction once. Rewrite an adjacent, single-use mask here
        ;; so compare admission adds no second instruction scan or dispatch.
        (if (and (> index 0) (opt-used-array-contains items dst))
          (match lhs
            [(CompilerIrValue.Var and-var)
              (match rhs
                [(CompilerIrValue.I64 zero)
                  (if (= zero 0)
                    (let
                      [tag : i64 (opt-binop-tag op)]
                      [safe : bool
                        (or (= tag 7) (= tag 8) (= tag 10) (= tag 11))]
                      (if (and safe (= (array-ref items and-var) 1))
                        (match (compiler-ir-instr-scalar-fact
                          (array-ref slots (- index 1)))
                          [(CompilerIrInstrScalarFact.BinOp
                              actual
                              (CompilerIrBinOp.BitAnd)
                              value
                              mask
                              _)
                            (if (and
                              (= actual and-var)
                              (or
                                (not (or (= tag 10) (= tag 11)))
                                (match mask
                                  [(CompilerIrValue.I64 n)
                                    (and (>= n 0) (<= n 127))]
                                  [_ false])))
                              (let
                                [next : CompilerIrInstr
                                  (CompilerIrInstr.BinOp
                                    dst
                                    (if (or (= tag 7) (= tag 10))
                                      (CompilerIrBinOp.BitTestEq)
                                      (CompilerIrBinOp.BitTestNe))
                                    value
                                    mask
                                    ty)]
                                (begin
                                  (array-set! slots index next)
                                  (opt-used-array-dec items and-var)
                                  (opt-collect-instr-uses-array items next)))
                              unit)]
                          [_ unit])
                        unit))
                    unit)]
                [_ unit])]
            [_ unit])
          unit)
        (and
          (not (opt-binop-traps? op))
          (not (opt-used-array-contains items dst))))]
    [(CompilerIrInstr.UnOp dst _ _ _) (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.Phi dst _ _) (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.LaneId dst _ _) (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.Splat dst _ _ _)
      (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (not (opt-used-array-contains items dst))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (not (opt-used-array-contains items dst))])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (not (opt-used-array-contains items dst))])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.MaskNot dst _ _)
      (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.MaskReduce dst _ _ _)
      (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (not (opt-used-array-contains items dst))])]
    [(CompilerIrInstr.TailMask dst _ _ _)
      (not (opt-used-array-contains items dst))]
    ;; Register-group ops are pure producers like the scalar temps above: a
    ;; Pack whose group is never read (every Word extraction folded away) is
    ;; dead, and so is a Word nobody reads. Mirrors `opt-instr-dead?`.
    [(CompilerIrInstr.Pack dst _ _) (not (opt-used-array-contains items dst))]
    [(CompilerIrInstr.Word dst _ _ _) (not (opt-used-array-contains items dst))]
    [_ false]))

;; Retain-only sweep into a fresh dense sequence. The BACKWARD walk is load
;; bearing and is preserved exactly: deleting an instruction drops the uses it
;; made (opt-uncount-instr-uses-array), which is what lets an earlier
;; instruction become dead in the same sweep. Survivors are therefore written
;; from the END of the output array and the live suffix is slid down to index 0
;; afterwards -- the same two-phase shape opt-dce-instr-seq-array-escape already
;; uses, minus the escape clone. Output is fresh; `instrs` is untouched (this is
;; the opt2 path, where the fixpoint driver still needs its input intact --
;; opt-dce-instr-seq-array-in-place! remains the opt1 form). refs #5726
(define (opt-dce-instr-seq-array
  [items : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [out-slots : (Array CompilerIrInstr)
      (array.make-array CompilerIrInstr count)]
    [index : i64 (- count 1)]
    [write : i64 (- count 1)]
    [live-count : i64 0]
    [src : i64 0]
    [dst : i64 0]
    (begin
      (while (>= index 0)
        (begin
          (let
            [instr : CompilerIrInstr (array-ref slots index)]
            (if (opt-instr-dead-array? items slots count index instr)
              (opt-uncount-instr-uses-array items instr)
              (begin
                (array-set! out-slots write (array-ref slots index))
                (set! write (- write 1)))))
          (set! index (- index 1))))
      (set! live-count (- count (+ write 1)))
      (set! src (+ write 1))
      (set! dst 0)
      (while (< dst live-count)
        (begin
          (if (not (= dst src))
            (array-set! out-slots dst (array-ref out-slots src))
            unit)
          (set! dst (+ dst 1))
          (set! src (+ src 1))))
      (CompilerIrInstrSeq out-slots live-count))))

(define (opt-dce-instr-seq-array-in-place!
  [items : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 (- count 1)]
    [write : i64 (- count 1)]
    [live-count : i64 0]
    [src : i64 0]
    [dst : i64 0]
    (begin
      (while (>= index 0)
        (begin
          (let
            [instr : CompilerIrInstr (array-ref slots index)]
            (if (opt-instr-dead-array? items slots count index instr)
              ;; Deleting this instruction drops the uses it made, so a value it
              ;; was the last reader of becomes dead for an earlier sweep step.
              (opt-uncount-instr-uses-array items instr)
              (begin
                (if (not (= write index))
                  (array-set! slots write instr)
                  unit)
                (set! write (- write 1)))))
          (set! index (- index 1))))
      (set! live-count (- count (+ write 1)))
      (set! src (+ write 1))
      (set! dst 0)
      (while (< dst live-count)
        (begin
          (if (not (= dst src))
            (array-set! slots dst (array-ref slots src))
            unit)
          (set! dst (+ dst 1))
          (set! src (+ src 1))))
      (set! (struct-get instrs len) live-count)
      instrs)))

(define (opt-dce-block-array [items : (Array i64)] [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (CompilerIrBlock.Block label (opt-dce-instr-seq-array items instrs))]))

(define (opt-dce-block-array-in-place
  [items : (Array i64)]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (CompilerIrBlock.Block
        label
        (opt-dce-instr-seq-array-in-place! items instrs))]))

(define (opt-dce-block-list-array
  [items : (Array i64)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-dce-block-array items block)
        (opt-dce-block-list-array items (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-dce-block-list-array items (compiler-ir-block-seq-to-list seq))]))

(define (opt-dce-copy-used-from!
  [source : (Array i64)]
  [out : (Array i64)]
  [index : i64]) : unit
  (if (>= index (array-length source))
    unit
    (begin
      (array-set! out index (array-ref source index))
      (opt-dce-copy-used-from! source out (+ index 1)))))

(define (opt-dce-copy-used [source : (Array i64)]) : (Array i64)
  (let
    [out : (Array i64) (array.make-array i64 (array-length source))]
    (begin
      (opt-dce-copy-used-from! source out 0)
      out)))

;; Exact dry run of the backward DCE walk. It mutates only the copied use-count
;; array, including cascading decrements, and allocates no replacement IR.
(define (opt-dce-instr-seq-array-has-dead!
  [items : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : bool
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 (- count 1)]
    [changed : bool false]
    (begin
      (while (>= index 0)
        (let
          [instr : CompilerIrInstr (array-ref slots index)]
          (begin
            (if (opt-instr-dead-array? items slots count index instr)
              (begin
                (set! changed true)
                (opt-uncount-instr-uses-array items instr))
              unit)
            (set! index (- index 1)))))
      changed)))

(define (opt-dce-blocks-array-have-dead!
  [items : (Array i64)]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [block-changed : bool
              (opt-dce-instr-seq-array-has-dead! items instrs)]
            (or
              block-changed
              (opt-dce-blocks-array-have-dead! items (box-get rest))))])]
    [(CompilerIrBlockList.Array seq)
      (opt-dce-blocks-array-have-dead!
        items
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-dce-block-list-array-pass
  [items : (Array i64)]
  [blocks : CompilerIrBlockList]) : OptBlockListPassResult
  (if (opt-dce-blocks-array-have-dead! (opt-dce-copy-used items) blocks)
    (OptBlockListPassResult.Result (opt-dce-block-list-array items blocks) true)
    (OptBlockListPassResult.Result blocks false)))

(define (opt-dce-block-seq-array-in-place!
  [items : (Array i64)]
  [seq : CompilerIrBlockSeq]) : unit
  (let
    [slots : (Array CompilerIrBlock) (struct-get seq slots)]
    [count : i64 (struct-get seq len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            slots
            index
            (opt-dce-block-array-in-place items (array-ref slots index)))
          (set! index (+ index 1))))
      unit)))

(define (opt-dce-block-list-array-in-place
  [items : (Array i64)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-dce-block-array-in-place items block)
        (opt-dce-block-list-array-in-place items (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (begin
        (opt-dce-block-seq-array-in-place! items seq)
        blocks)]))

(define (opt-dce-instr-seq-array-escape
  [pools : AstNodePoolContext]
  [items : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [src-slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [out-slots : (Array CompilerIrInstr)
      (array.make-array CompilerIrInstr count)]
    [index : i64 (- count 1)]
    [write : i64 (- count 1)]
    [live-count : i64 0]
    [src : i64 0]
    [dst : i64 0]
    (begin
      (while (>= index 0)
        (begin
          (let
            [instr : CompilerIrInstr (array-ref src-slots index)]
            (if (opt-instr-dead-array? items src-slots count index instr)
              ;; Deleting this instruction drops the uses it made, so a value it
              ;; was the last reader of becomes dead for an earlier sweep step.
              (opt-uncount-instr-uses-array items instr)
              (begin
                (array-set!
                  out-slots
                  write
                  (compiler-ir-clone-instr pools instr))
                (set! write (- write 1)))))
          (set! index (- index 1))))
      (set! live-count (- count (+ write 1)))
      (set! src (+ write 1))
      (set! dst 0)
      (while (< dst live-count)
        (begin
          (if (not (= dst src))
            (array-set! out-slots dst (array-ref out-slots src))
            unit)
          (set! dst (+ dst 1))
          (set! src (+ src 1))))
      (CompilerIrInstrSeq out-slots live-count))))

(define (opt-dce-block-array-escape
  [pools : AstNodePoolContext]
  [items : (Array i64)]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (CompilerIrBlock.Block
        (clone label)
        (opt-dce-instr-seq-array-escape pools items instrs))]))

(define (opt-dce-block-list-array-escape-fill
  [pools : AstNodePoolContext]
  [items : (Array i64)]
  [blocks : CompilerIrBlockList]
  [slots : (Array CompilerIrBlock)]
  [index : i64]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) index]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (array-set! slots index (opt-dce-block-array-escape pools items block))
        (opt-dce-block-list-array-escape-fill
          pools
          items
          (box-get rest)
          slots
          (+ index 1)))]
    [(CompilerIrBlockList.Array seq)
      (let
        [src-slots : (Array CompilerIrBlock) (struct-get seq slots)]
        [count : i64 (struct-get seq len)]
        [offset : i64 0]
        (begin
          (while (< offset count)
            (begin
              (array-set!
                slots
                (+ index offset)
                (opt-dce-block-array-escape
                  pools
                  items
                  (array-ref src-slots offset)))
              (set! offset (+ offset 1))))
          (+ index count)))]))

(define (opt-dce-block-list-array-escape
  [pools : AstNodePoolContext]
  [items : (Array i64)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [count : i64 (compiler-ir-block-list-count blocks)]
    [slots : (Array CompilerIrBlock) (array.make-array CompilerIrBlock count)]
    [written : i64
      (opt-dce-block-list-array-escape-fill pools items blocks slots 0)]
    (CompilerIrBlockList.Array (CompilerIrBlockSeq slots written))))

;; --- aggregate allocation candidate analysis --------------------------------
;;
;; This is intentionally analysis-only. It recognizes heap aggregate allocations
;; that stay local to a function and records the constant-offset derived pointers
;; plus load/store accesses that a later scalar-replacement slice can consume.
(define (opt-aggregate-fixed-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Tuple _) true]
    [(AstType.Array _ _) true]
    [_ false]))

(define (opt-aggregate-tl-alloc-size [args : CompilerIrCallArgs]) : option_i64.Option
  (match args
    [(CompilerIrCallArgs.One value)
      (match value
        [(CompilerIrValue.I64 size) (option_i64.Some size)]
        [_ (option_i64.None)])]
    [_ (option_i64.None)]))

(define (opt-aggregate-direct-alloc [instr : CompilerIrInstr]) : OptMaybeAggregateAlloc
  (match instr
    [(CompilerIrInstr.Call dst name args ty)
      (if (and
        (compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)
        (opt-aggregate-fixed-type? ty))
        (match (opt-aggregate-tl-alloc-size args)
          [(option_i64.Some size)
            (if (> size 0)
              (OptMaybeAggregateAlloc.Some dst ty size)
              (OptMaybeAggregateAlloc.No))]
          [(option_i64.None) (OptMaybeAggregateAlloc.No)])
        (OptMaybeAggregateAlloc.No))]
    [_ (OptMaybeAggregateAlloc.No)]))

(define (opt-aggregate-pointer-list-lookup-from
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [var : i64]
  [index : i64]) : option_i64.Option
  (if (< index 0)
    (option_i64.None)
    (match (opt_aggregate_pointer_vec.get
      (& ptrs)
      index
      (OptAggregatePointer.Pointer 0 0))
      [(OptAggregatePointer.Pointer ptr-var offset)
        (if (= ptr-var var)
          (option_i64.Some offset)
          (opt-aggregate-pointer-list-lookup-from ptrs var (- index 1)))])))

(define (opt-aggregate-pointer-list-lookup
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [var : i64]) : option_i64.Option
  (opt-aggregate-pointer-list-lookup-from
    ptrs
    var
    (- (opt_aggregate_pointer_vec.len (& ptrs)) 1)))

(define (opt-aggregate-value-offset
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [value : CompilerIrValue]) : option_i64.Option
  (match value
    [(CompilerIrValue.Var var)
      (if (= var base)
        (option_i64.Some 0)
        (opt-aggregate-pointer-list-lookup ptrs var))]
    [_ (option_i64.None)]))

(define (opt-aggregate-value-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [value : CompilerIrValue]) : bool
  (match (opt-aggregate-value-offset base ptrs value)
    [(option_i64.Some _) true]
    [(option_i64.None) false]))

(define (opt-aggregate-call-args-array-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [values : (Array CompilerIrValue)]
  [index : i64]) : bool
  (if (>= index (array-length values))
    false
    (or
      (opt-aggregate-value-has-pointer? base ptrs (array-ref values index))
      (opt-aggregate-call-args-array-has-pointer? base ptrs values (+ index 1)))))

(define (opt-aggregate-call-args-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [args : CompilerIrCallArgs]) : bool
  (match args
    [(CompilerIrCallArgs.Nil) false]
    [(CompilerIrCallArgs.One value)
      (opt-aggregate-value-has-pointer? base ptrs value)]
    [(CompilerIrCallArgs.Two a b)
      (or
        (opt-aggregate-value-has-pointer? base ptrs a)
        (opt-aggregate-value-has-pointer? base ptrs b))]
    [(CompilerIrCallArgs.Array values)
      (opt-aggregate-call-args-array-has-pointer? base ptrs values 0)]))

(define (opt-aggregate-spmd-call-args-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [args : CompilerIrSpmdCallArgList]) : bool
  (match args
    [(CompilerIrSpmdCallArgList.Nil) false]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs value)
            (opt-aggregate-spmd-call-args-has-pointer? base ptrs (box-get rest)))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [found : bool false]
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (begin
          (while (and (< i count) (not found))
            (begin
              (match (array-ref slots i)
                [(CompilerIrSpmdCallArg.Arg _ value _)
                  (if (opt-aggregate-value-has-pointer? base ptrs value)
                    (set! found true)
                    unit)])
              (set! i (+ i 1))))
          found))]))

(define (opt-aggregate-maybe-value-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [maybe : CompilerIrMaybeValue]) : bool
  (match maybe
    [(CompilerIrMaybeValue.No) false]
    [(CompilerIrMaybeValue.Some value)
      (opt-aggregate-value-has-pointer? base ptrs value)]))

(define (opt-aggregate-phi-inputs-have-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [inputs : CompilerIrPhiInputList]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) false]
    [(CompilerIrPhiInputList.Array seq)
      (opt-aggregate-phi-inputs-have-pointer?
        base
        ptrs
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (or
        (opt-aggregate-value-has-pointer? base ptrs value)
        (opt-aggregate-phi-inputs-have-pointer? base ptrs (box-get rest)))]))

(define (opt-aggregate-raw-var-is-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [var : i64]) : bool
  (or
    (= var base)
    (match (opt-aggregate-pointer-list-lookup ptrs var)
      [(option_i64.Some _) true]
      [(option_i64.None) false])))

(define (opt-aggregate-instr-has-pointer?
  [instr : CompilerIrInstr]
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.AddrOf _ src)
      (opt-aggregate-raw-var-is-pointer? base ptrs src)]
    [(CompilerIrInstr.Gep _ src offset _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs src)
        (opt-aggregate-value-has-pointer? base ptrs offset))]
    [(CompilerIrInstr.Load _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.StorePtr ptr value _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs ptr)
        (opt-aggregate-value-has-pointer? base ptrs value))]
    [(CompilerIrInstr.CopyBytes dst src _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs dst)
        (opt-aggregate-value-has-pointer? base ptrs src))]
    [(CompilerIrInstr.BoundsCheck index length _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs index)
        (opt-aggregate-value-has-pointer? base ptrs length))]
    [(CompilerIrInstr.Cast _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs lhs)
        (opt-aggregate-value-has-pointer? base ptrs rhs))]
    [(CompilerIrInstr.UnOp _ _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.Splat _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs lhs)
            (opt-aggregate-value-has-pointer? base ptrs rhs))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs src)
            (opt-aggregate-value-has-pointer? base ptrs carry))])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs lhs)
            (opt-aggregate-value-has-pointer? base ptrs rhs))])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs lhs)
        (opt-aggregate-value-has-pointer? base ptrs rhs))]
    [(CompilerIrInstr.MaskNot _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs mask)
            (opt-aggregate-value-has-pointer? base ptrs on-true)
            (opt-aggregate-value-has-pointer? base ptrs on-false))])]
    [(CompilerIrInstr.VectorLoad _ vector-base index _ _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs vector-base)
        (opt-aggregate-value-has-pointer? base ptrs index))]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload vector-base index value _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs vector-base)
            (opt-aggregate-value-has-pointer? base ptrs index)
            (opt-aggregate-value-has-pointer? base ptrs value))])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            store-base
            index
            value
            mask
            _
            _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs store-base)
            (opt-aggregate-value-has-pointer? base ptrs index)
            (opt-aggregate-value-has-pointer? base ptrs value)
            (opt-aggregate-value-has-pointer? base ptrs mask))])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload
            _
            load-base
            index
            mask
            _
            _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs load-base)
            (opt-aggregate-value-has-pointer? base ptrs index)
            (opt-aggregate-value-has-pointer? base ptrs mask))])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            _
            load-base
            index-base
            index
            _
            _
            _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs load-base)
            (opt-aggregate-value-has-pointer? base ptrs index-base)
            (opt-aggregate-value-has-pointer? base ptrs index))])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs source)
            (opt-aggregate-value-has-pointer? base ptrs selector-low)
            (match selector-high
              [(CompilerIrMaybeValue.Some value)
                (opt-aggregate-value-has-pointer? base ptrs value)]
              [(CompilerIrMaybeValue.No) false])
            (opt-aggregate-value-has-pointer? base ptrs active-lanes))])]
    [(CompilerIrInstr.TailMask _ index length _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs index)
        (opt-aggregate-value-has-pointer? base ptrs length))]
    [(CompilerIrInstr.EntryArgc _) false]
    [(CompilerIrInstr.EntryArgv _) false]
    [(CompilerIrInstr.EntryEnvp _) false]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs leaf)
        (opt-aggregate-value-has-pointer? base ptrs subleaf))]
    [(CompilerIrInstr.Xgetbv _ index)
      (opt-aggregate-value-has-pointer? base ptrs index)]
    [(CompilerIrInstr.Syscall _ args)
      (opt-aggregate-call-args-has-pointer? base ptrs args)]
    [(CompilerIrInstr.Call _ _ args _)
      (opt-aggregate-call-args-has-pointer? base ptrs args)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload store-base _ args _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs store-base)
            (opt-aggregate-call-args-has-pointer? base ptrs args))])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            store-base
            func
            args
            _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs store-base)
            (opt-aggregate-value-has-pointer? base ptrs func)
            (opt-aggregate-call-args-has-pointer? base ptrs args))])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs active-mask)
            (opt-aggregate-spmd-call-args-has-pointer? base ptrs args))])]
    [(CompilerIrInstr.TailCall _ args _)
      (opt-aggregate-call-args-has-pointer? base ptrs args)]
    [(CompilerIrInstr.Store _ value _)
      (opt-aggregate-value-has-pointer? base ptrs value)]
    [(CompilerIrInstr.Branch cond _ _)
      (opt-aggregate-value-has-pointer? base ptrs cond)]
    [(CompilerIrInstr.Return maybe)
      (opt-aggregate-maybe-value-has-pointer? base ptrs maybe)]
    [(CompilerIrInstr.Phi _ inputs _)
      (opt-aggregate-phi-inputs-have-pointer? base ptrs inputs)]
    [(CompilerIrInstr.TailCallIndirect func args _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs func)
        (opt-aggregate-call-args-has-pointer? base ptrs args))]
    [_ false]))

(define (opt-aggregate-instrs-touch-candidate?
  [instrs : CompilerIrInstrList]
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]) : bool
  (match instrs
    [(CompilerIrInstrList.Nil) false]
    [(CompilerIrInstrList.Cons instr rest)
      (or
        (opt-aggregate-instr-has-pointer? instr base ptrs)
        (opt-aggregate-instrs-touch-candidate? (box-get rest) base ptrs))]))

(define (opt-aggregate-instr-known-safe?
  [instr : CompilerIrInstr]
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]) : bool
  (match instr
    [(CompilerIrInstr.Call dst name _ _)
      (and
        (= dst base)
        (compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc))]
    [(CompilerIrInstr.Gep _ src offset _)
      (match (opt-aggregate-value-offset base ptrs src)
        [(option_i64.Some _)
          (match offset
            [(CompilerIrValue.I64 _) true]
            [_ false])]
        [(option_i64.None) false])]
    [(CompilerIrInstr.Load _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(CompilerIrInstr.StorePtr ptr value _)
      (and
        (opt-aggregate-value-has-pointer? base ptrs ptr)
        (not (opt-aggregate-value-has-pointer? base ptrs value)))]
    [(CompilerIrInstr.CopyBytes _ _ _) false]
    [_ false]))

(define (opt-aggregate-instr-crosses-unknown-effect?
  [instr : CompilerIrInstr]
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]) : bool
  (if (opt-aggregate-instr-known-safe? instr base ptrs)
    false
    (compiler-ir-effect-invalidates-cse? (compiler-ir-instr-effect instr))))

(define (opt-aggregate-scan-instrs
  [type-segment-bases : i64]
  [base : i64]
  [ty : AstType]
  [size : i64]
  [instrs : CompilerIrInstrList]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [accesses : opt_aggregate_access_vec.Vec]
  [seen-alloc : bool]) : OptAggregateScanResult
  (match instrs
    [(CompilerIrInstrList.Nil)
      (if seen-alloc
        (OptAggregateScanResult.Ok ptrs accesses)
        (OptAggregateScanResult.Reject))]
    [(CompilerIrInstrList.Cons instr rest)
      (if (not seen-alloc)
        (match (opt-aggregate-direct-alloc instr)
          [(OptMaybeAggregateAlloc.Some dst alloc-ty alloc-size)
            (if (and
              (= dst base)
              (= alloc-size size)
              (opt-type-eq type-segment-bases alloc-ty ty))
              (opt-aggregate-scan-instrs
                type-segment-bases
                base
                ty
                size
                (box-get rest)
                ptrs
                accesses
                true)
              (opt-aggregate-scan-instrs
                type-segment-bases
                base
                ty
                size
                (box-get rest)
                ptrs
                accesses
                false))]
          [(OptMaybeAggregateAlloc.No)
            (opt-aggregate-scan-instrs
              type-segment-bases
              base
              ty
              size
              (box-get rest)
              ptrs
              accesses
              false)])
        (match instr
          [(CompilerIrInstr.Gep dst src offset _)
            (match (opt-aggregate-value-offset base ptrs src)
              [(option_i64.Some base-offset)
                (match offset
                  [(CompilerIrValue.I64 field-offset)
                    (begin
                      (opt_aggregate_pointer_vec.push
                        (&mut ptrs)
                        (OptAggregatePointer.Pointer
                          dst
                          (+ base-offset field-offset)))
                      (opt-aggregate-scan-instrs
                        type-segment-bases
                        base
                        ty
                        size
                        (box-get rest)
                        ptrs
                        accesses
                        true))]
                  [_ (OptAggregateScanResult.Reject)])]
              [(option_i64.None)
                (if (opt-aggregate-value-has-pointer? base ptrs offset)
                  (OptAggregateScanResult.Reject)
                  (opt-aggregate-scan-instrs
                    type-segment-bases
                    base
                    ty
                    size
                    (box-get rest)
                    ptrs
                    accesses
                    true))])]
          [(CompilerIrInstr.Load dst src load-ty)
            (match (opt-aggregate-value-offset base ptrs src)
              [(option_i64.Some offset)
                (begin
                  (opt_aggregate_access_vec.push
                    (&mut accesses)
                    (OptAggregateAccess.Load dst offset load-ty))
                  (opt-aggregate-scan-instrs
                    type-segment-bases
                    base
                    ty
                    size
                    (box-get rest)
                    ptrs
                    accesses
                    true))]
              [(option_i64.None)
                (if (opt-aggregate-instrs-touch-candidate?
                  (box-get rest)
                  base
                  ptrs)
                  (OptAggregateScanResult.Reject)
                  (opt-aggregate-scan-instrs
                    type-segment-bases
                    base
                    ty
                    size
                    (box-get rest)
                    ptrs
                    accesses
                    true))])]
          [(CompilerIrInstr.StorePtr ptr value store-ty)
            (match (opt-aggregate-value-offset base ptrs ptr)
              [(option_i64.Some offset)
                (if (opt-aggregate-value-has-pointer? base ptrs value)
                  (OptAggregateScanResult.Reject)
                  (begin
                    (opt_aggregate_access_vec.push
                      (&mut accesses)
                      (OptAggregateAccess.Store offset store-ty))
                    (opt-aggregate-scan-instrs
                      type-segment-bases
                      base
                      ty
                      size
                      (box-get rest)
                      ptrs
                      accesses
                      true)))]
              [(option_i64.None)
                (if (or
                  (opt-aggregate-value-has-pointer? base ptrs value)
                  (and
                    (compiler-ir-effect-invalidates-cse?
                      (compiler-ir-instr-effect instr))
                    (opt-aggregate-instrs-touch-candidate?
                      (box-get rest)
                      base
                      ptrs)))
                  (OptAggregateScanResult.Reject)
                  (opt-aggregate-scan-instrs
                    type-segment-bases
                    base
                    ty
                    size
                    (box-get rest)
                    ptrs
                    accesses
                    true))])]
          [_
            (if (opt-aggregate-instr-has-pointer? instr base ptrs)
              (OptAggregateScanResult.Reject)
              (if (and
                (opt-aggregate-instr-crosses-unknown-effect? instr base ptrs)
                (opt-aggregate-instrs-touch-candidate? (box-get rest) base ptrs))
                (OptAggregateScanResult.Reject)
                (opt-aggregate-scan-instrs
                  type-segment-bases
                  base
                  ty
                  size
                  (box-get rest)
                  ptrs
                  accesses
                  true)))]))]))

(define (opt-aggregate-classify-one
  [type-segment-bases : i64]
  [base : i64]
  [ty : AstType]
  [size : i64]
  [instrs : CompilerIrInstrList]) : OptAggregateScanResult
  (opt-aggregate-scan-instrs
    type-segment-bases
    base
    ty
    size
    instrs
    (opt_aggregate_pointer_vec.with-capacity
      opt-aggregate-list-initial-capacity)
    (opt_aggregate_access_vec.with-capacity opt-aggregate-list-initial-capacity)
    false))

(define (opt-aggregate-candidates-from-instrs
  [type-segment-bases : i64]
  [scan : CompilerIrInstrList]
  [candidates : opt_aggregate_candidate_vec.Vec]) : opt_aggregate_candidate_vec.Vec
  (match scan
    [(CompilerIrInstrList.Nil) candidates]
    [(CompilerIrInstrList.Cons instr rest)
      (match (opt-aggregate-direct-alloc instr)
        [(OptMaybeAggregateAlloc.Some base ty size)
          (match (opt-aggregate-classify-one
            type-segment-bases
            base
            ty
            size
            scan)
            [(OptAggregateScanResult.Ok ptrs accesses)
              (begin
                (opt_aggregate_candidate_vec.push
                  (&mut candidates)
                  (OptAggregateAllocCandidate.Candidate
                    base
                    ty
                    size
                    ptrs
                    accesses))
                (opt-aggregate-candidates-from-instrs
                  type-segment-bases
                  (box-get rest)
                  candidates))]
            [(OptAggregateScanResult.Reject)
              (opt-aggregate-candidates-from-instrs
                type-segment-bases
                (box-get rest)
                candidates)])]
        [(OptMaybeAggregateAlloc.No)
          (opt-aggregate-candidates-from-instrs
            type-segment-bases
            (box-get rest)
            candidates)])]))

(define (opt-aggregate-instr-list-append
  [left : CompilerIrInstrList]
  [right : CompilerIrInstrList]) : CompilerIrInstrList
  (match left
    [(CompilerIrInstrList.Nil) right]
    [(CompilerIrInstrList.Cons head rest)
      (compiler-ir-instr-cons
        head
        (opt-aggregate-instr-list-append (box-get rest) right))]))

(define (opt-aggregate-instr-seq-append-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [right : CompilerIrInstrList]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    right
    (compiler-ir-instr-cons
      (compiler-ir-instr-seq-ref instrs index)
      (opt-aggregate-instr-seq-append-from instrs (+ index 1) right))))

(define (opt-aggregate-flatten-blocks [blocks : CompilerIrBlockList]) : CompilerIrInstrList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-aggregate-instr-seq-append-from
            instrs
            0
            (opt-aggregate-flatten-blocks (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-aggregate-flatten-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-aggregate-allocation-candidates-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : opt_aggregate_candidate_vec.Vec
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (let
        [instrs : CompilerIrInstrList (opt-aggregate-flatten-blocks blocks)]
        (opt-aggregate-candidates-from-instrs
          type-segment-bases
          instrs
          (opt_aggregate_candidate_vec.with-capacity
            opt-aggregate-list-initial-capacity)))]))

(define (opt-aggregate-candidate-list-append
  [left : opt_aggregate_candidate_vec.Vec]
  [right : opt_aggregate_candidate_vec.Vec]) : opt_aggregate_candidate_vec.Vec
  (let
    [right-count : i64 (opt_aggregate_candidate_vec.len (& right))]
    [i : i64 0]
    (begin
      (while (< i right-count)
        (begin
          (opt_aggregate_candidate_vec.push
            (&mut left)
            (array-ref (opt_aggregate_candidate_vec.slots (& right)) i))
          (set! i (+ i 1))))
      left)))

(define (opt-aggregate-allocation-candidates-functions
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]) : opt_aggregate_candidate_vec.Vec
  (match functions
    [(CompilerIrFunctionList.Nil) (opt_aggregate_candidate_vec.with-capacity 0)]
    [(CompilerIrFunctionList.Cons func rest)
      (opt-aggregate-candidate-list-append
        (opt-aggregate-allocation-candidates-function type-segment-bases func)
        (opt-aggregate-allocation-candidates-functions
          type-segment-bases
          (box-get rest)))]
    [(CompilerIrFunctionList.Array seq)
      (opt-aggregate-allocation-candidates-functions
        type-segment-bases
        (compiler-ir-function-seq-to-list seq))]))

(define (opt-aggregate-allocation-candidates
  [type-segment-bases : i64]
  [program : CompilerIrProgram]) : opt_aggregate_candidate_vec.Vec
  (match program
    [(CompilerIrProgram.Program _ functions _)
      (opt-aggregate-allocation-candidates-functions
        type-segment-bases
        functions)]))

(define (opt-aggregate-candidate-list-count
  [candidates : opt_aggregate_candidate_vec.Vec]) : i64
  (opt_aggregate_candidate_vec.len (& candidates)))

(define (opt-aggregate-pointer-list-count
  [ptrs : opt_aggregate_pointer_vec.Vec]) : i64
  (opt_aggregate_pointer_vec.len (& ptrs)))

(define (opt-aggregate-access-list-load-count-from
  [accesses : opt_aggregate_access_vec.Vec]
  [index : i64]) : i64
  (if (>= index (opt_aggregate_access_vec.len (& accesses)))
    0
    (+
      (match (opt_aggregate_access_vec.get
        (& accesses)
        index
        (OptAggregateAccess.Store 0 (AstType.Unit)))
        [(OptAggregateAccess.Load _ _ _) 1]
        [_ 0])
      (opt-aggregate-access-list-load-count-from accesses (+ index 1)))))

(define (opt-aggregate-access-list-load-count
  [accesses : opt_aggregate_access_vec.Vec]) : i64
  (opt-aggregate-access-list-load-count-from accesses 0))

(define (opt-aggregate-access-list-store-count-from
  [accesses : opt_aggregate_access_vec.Vec]
  [index : i64]) : i64
  (if (>= index (opt_aggregate_access_vec.len (& accesses)))
    0
    (+
      (match (opt_aggregate_access_vec.get
        (& accesses)
        index
        (OptAggregateAccess.Store 0 (AstType.Unit)))
        [(OptAggregateAccess.Store _ _) 1]
        [_ 0])
      (opt-aggregate-access-list-store-count-from accesses (+ index 1)))))

(define (opt-aggregate-access-list-store-count
  [accesses : opt_aggregate_access_vec.Vec]) : i64
  (opt-aggregate-access-list-store-count-from accesses 0))

;; --- aggregate stack promotion ----------------------------------------------
;;
;; Reuse the non-escaping aggregate classifier, but keep this first promotion
;; slice conservative: only fixed handle-shaped structs/enums/tuples are moved
;; onto local frame storage. Dynamic arrays and array payloads stay heap-backed.
;;
;; The backend frame model exposes 8-byte slots. To preserve positive byte
;; offsets from the aggregate base, the address points at the lowest-addressed
;; reserved slot; offset +8 then walks back toward earlier reserved slots.
(define (opt-aggregate-stack-promote-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Tuple _) true]
    [_ false]))

(define (opt-aggregate-stack-promote-instr-candidate? [instr : CompilerIrInstr]) : bool
  (match (opt-aggregate-direct-alloc instr)
    [(OptMaybeAggregateAlloc.Some _ ty _)
      (opt-aggregate-stack-promote-type? ty)]
    [(OptMaybeAggregateAlloc.No) false]))

(define (opt-aggregate-stack-promote-instr-seq-candidate-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-aggregate-stack-promote-instr-candidate?
      (compiler-ir-instr-seq-ref instrs index))
      true
      (opt-aggregate-stack-promote-instr-seq-candidate-from? instrs (+ index 1)))))

(define (opt-aggregate-stack-promote-block-candidate? [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (opt-aggregate-stack-promote-instr-seq-candidate-from? instrs 0)]))

(define (opt-aggregate-stack-promote-block-seq-candidate-from?
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-block-seq-count blocks))
    false
    (if (opt-aggregate-stack-promote-block-candidate?
      (compiler-ir-block-seq-ref blocks index))
      true
      (opt-aggregate-stack-promote-block-seq-candidate-from? blocks (+ index 1)))))

(define (opt-aggregate-stack-promote-blocks-have-candidate?
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-aggregate-stack-promote-block-candidate? block)
        true
        (opt-aggregate-stack-promote-blocks-have-candidate? (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-aggregate-stack-promote-block-seq-candidate-from? seq 0)]))

(define (opt-aggregate-stack-slot-count [size : i64]) : i64
  (/ (+ size 7) 8))

(define (opt-aggregate-promote-build
  [candidates : opt_aggregate_candidate_vec.Vec]
  [next-frame : i64]) : OptAggregatePromoteBuild
  (let
    [candidate-slots : (& candidates (Array OptAggregateAllocCandidate))
      (opt_aggregate_candidate_vec.slots (& candidates))]
    [candidate-count : i64 (opt_aggregate_candidate_vec.len (& candidates))]
    [promote-slots : opt_aggregate_promote_slot_vec.Vec
      (opt_aggregate_promote_slot_vec.with-capacity
        opt-aggregate-list-initial-capacity)]
    [frame : i64 next-frame]
    [index : i64 0]
    (begin
      (while (< index candidate-count)
        (begin
          (match (array-ref candidate-slots index)
            [(OptAggregateAllocCandidate.Candidate base ty size _ _)
              (if (opt-aggregate-stack-promote-type? ty)
                (let
                  [slot-count : i64 (opt-aggregate-stack-slot-count size)]
                  [storage : i64 (+ frame (- slot-count 1))]
                  (begin
                    (opt_aggregate_promote_slot_vec.push
                      (&mut promote-slots)
                      (OptAggregatePromoteSlot.Slot base storage))
                    (set! frame (+ frame slot-count))))
                unit)])
          (set! index (+ index 1))))
      (OptAggregatePromoteBuild.Build promote-slots frame))))

(define (opt-aggregate-promote-lookup-from
  [slot-list : opt_aggregate_promote_slot_vec.Vec]
  [base : i64]
  [index : i64]) : option_i64.Option
  (if (>= index (opt_aggregate_promote_slot_vec.len (& slot-list)))
    (option_i64.None)
    (match (opt_aggregate_promote_slot_vec.get
      (& slot-list)
      index
      (OptAggregatePromoteSlot.Slot 0 0))
      [(OptAggregatePromoteSlot.Slot found storage)
        (if (= found base)
          (option_i64.Some storage)
          (opt-aggregate-promote-lookup-from slot-list base (+ index 1)))])))

(define (opt-aggregate-promote-lookup
  [slots : opt_aggregate_promote_slot_vec.Vec]
  [base : i64]) : option_i64.Option
  (opt-aggregate-promote-lookup-from slots base 0))

(define (opt-aggregate-promote-rewrite-instr
  [slots : opt_aggregate_promote_slot_vec.Vec]
  [instr : CompilerIrInstr]) : CompilerIrInstrList
  (match (opt-aggregate-direct-alloc instr)
    [(OptMaybeAggregateAlloc.Some base ty _)
      (match (opt-aggregate-promote-lookup slots base)
        [(option_i64.Some storage)
          (compiler-ir-instr-cons
            (CompilerIrInstr.Alloc storage ty)
            (compiler-ir-instr-cons
              (CompilerIrInstr.AddrOf base storage)
              CompilerIrInstrList.Nil))]
        [(option_i64.None)
          (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)])]
    [(OptMaybeAggregateAlloc.No)
      (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)]))

(define (opt-aggregate-promote-instr-seq-from
  [slots : opt_aggregate_promote_slot_vec.Vec]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [acc : CompilerIrInstrList]) : CompilerIrInstrList
  (if (< index 0)
    acc
    (opt-aggregate-promote-instr-seq-from
      slots
      instrs
      (- index 1)
      (opt-aggregate-instr-list-append
        (opt-aggregate-promote-rewrite-instr
          slots
          (compiler-ir-instr-seq-ref instrs index))
        acc))))

(define (opt-aggregate-promote-instr-seq
  [slots : opt_aggregate_promote_slot_vec.Vec]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-aggregate-promote-instr-seq-from
    slots
    instrs
    (- (compiler-ir-instr-seq-count instrs) 1)
    CompilerIrInstrList.Nil))

(define (opt-aggregate-promote-block
  [slots : opt_aggregate_promote_slot_vec.Vec]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (compiler-ir-block label (opt-aggregate-promote-instr-seq slots instrs))]))

(define (opt-aggregate-promote-blocks
  [slots : opt_aggregate_promote_slot_vec.Vec]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-aggregate-promote-block slots block)
        (opt-aggregate-promote-blocks slots (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-aggregate-promote-blocks slots (compiler-ir-block-seq-to-list seq))]))

(define (opt-aggregate-stack-promote-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (opt-aggregate-stack-promote-blocks-have-candidate? blocks)
        (match (opt-aggregate-promote-build
          (opt-aggregate-allocation-candidates-function type-segment-bases func)
          frame)
          [(OptAggregatePromoteBuild.Build slots promoted-frame)
            (if (= (opt_aggregate_promote_slot_vec.len (& slots)) 0)
              func
              (CompilerIrFunction.Function
                name
                params
                ret-ty
                promoted-frame
                (opt-aggregate-promote-blocks slots blocks)))])
        func)]))

;; --- aggregate field-load scalar replacement (SROA) --------------------------
;; Replaces loads of fields from non-escaping aggregate allocations with the
;; scalar value last stored to that field. Runs after stack promotion so it
;; handles aggregates that promotion left in memory.
(define (opt-aggregate-scalar-replace-type? [ty : AstType]) : bool
  (if (opt-int-or-char-type? ty)
    true
    (match ty
      [(AstType.Bool) true]
      [(AstType.Unit) true]
      [_ false])))

(define (opt-aggregate-candidate-location
  [candidate : OptAggregateAllocCandidate]
  [value : CompilerIrValue]) : OptAggregateLocation
  (match candidate
    [(OptAggregateAllocCandidate.Candidate base _ _ ptrs _)
      (match (opt-aggregate-value-offset base ptrs value)
        [(option_i64.Some offset) (OptAggregateLocation.Some base offset)]
        [(option_i64.None) (OptAggregateLocation.No)])]))

(define (opt-aggregate-location-for-value-from
  [candidates : opt_aggregate_candidate_vec.Vec]
  [value : CompilerIrValue]
  [index : i64]) : OptAggregateLocation
  (if (>= index (opt_aggregate_candidate_vec.len (& candidates)))
    (OptAggregateLocation.No)
    (match (opt-aggregate-candidate-location
      (array-ref (opt_aggregate_candidate_vec.slots (& candidates)) index)
      value)
      [(OptAggregateLocation.Some base offset)
        (OptAggregateLocation.Some base offset)]
      [(OptAggregateLocation.No)
        (opt-aggregate-location-for-value-from candidates value (+ index 1))])))

(define (opt-aggregate-location-for-value
  [candidates : opt_aggregate_candidate_vec.Vec]
  [value : CompilerIrValue]) : OptAggregateLocation
  (opt-aggregate-location-for-value-from candidates value 0))

(define (opt-aggregate-value-is-candidate-pointer?
  [candidates : opt_aggregate_candidate_vec.Vec]
  [value : CompilerIrValue]) : bool
  (match (opt-aggregate-location-for-value candidates value)
    [(OptAggregateLocation.Some _ _) true]
    [(OptAggregateLocation.No) false]))

(define (opt-aggregate-field-facts-unbind
  [facts : OptAggregateFieldFacts]
  [base : i64]
  [offset : i64]) : OptAggregateFieldFacts
  (match facts
    [(OptAggregateFieldFacts.Nil) (OptAggregateFieldFacts.Nil)]
    [(OptAggregateFieldFacts.Cons fact-base fact-offset value ty rest)
      (let
        [rest2 : OptAggregateFieldFacts
          (opt-aggregate-field-facts-unbind (box-get rest) base offset)]
        (if (and (= fact-base base) (= fact-offset offset))
          rest2
          (OptAggregateFieldFacts.Cons
            fact-base
            fact-offset
            value
            ty
            (box rest2))))]))

(define (opt-aggregate-field-facts-unbind-base
  [facts : OptAggregateFieldFacts]
  [base : i64]) : OptAggregateFieldFacts
  (match facts
    [(OptAggregateFieldFacts.Nil) (OptAggregateFieldFacts.Nil)]
    [(OptAggregateFieldFacts.Cons fact-base fact-offset value ty rest)
      (let
        [rest2 : OptAggregateFieldFacts
          (opt-aggregate-field-facts-unbind-base (box-get rest) base)]
        (if (= fact-base base)
          rest2
          (OptAggregateFieldFacts.Cons
            fact-base
            fact-offset
            value
            ty
            (box rest2))))]))

(define (opt-aggregate-field-facts-bind
  [facts : OptAggregateFieldFacts]
  [base : i64]
  [offset : i64]
  [value : CompilerIrValue]
  [ty : AstType]) : OptAggregateFieldFacts
  (OptAggregateFieldFacts.Cons
    base
    offset
    value
    ty
    (box (opt-aggregate-field-facts-unbind facts base offset))))

(define (opt-aggregate-field-facts-lookup
  [type-segment-bases : i64]
  [facts : OptAggregateFieldFacts]
  [base : i64]
  [offset : i64]
  [ty : AstType]) : OptAggregateStoredValue
  (match facts
    [(OptAggregateFieldFacts.Nil) (OptAggregateStoredValue.No)]
    [(OptAggregateFieldFacts.Cons fact-base fact-offset value fact-ty rest)
      (if (and
        (= fact-base base)
        (= fact-offset offset)
        (opt-type-eq type-segment-bases fact-ty ty))
        (OptAggregateStoredValue.Some value fact-ty)
        (opt-aggregate-field-facts-lookup
          type-segment-bases
          (box-get rest)
          base
          offset
          ty))]))

(define (opt-aggregate-field-facts-invalidate-var
  [facts : OptAggregateFieldFacts]
  [var : i64]) : OptAggregateFieldFacts
  (match facts
    [(OptAggregateFieldFacts.Nil) (OptAggregateFieldFacts.Nil)]
    [(OptAggregateFieldFacts.Cons base offset value ty rest)
      (let
        [rest2 : OptAggregateFieldFacts
          (opt-aggregate-field-facts-invalidate-var (box-get rest) var)]
        (if (or (= base var) (opt-value-is-var? value var))
          rest2
          (OptAggregateFieldFacts.Cons base offset value ty (box rest2))))]))

(define (opt-aggregate-sroa-invalidate-def
  [facts : OptAggregateFieldFacts]
  [instr : CompilerIrInstr]) : OptAggregateFieldFacts
  (match instr
    [(CompilerIrInstr.Mov dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Alloc dst _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.AddrOf dst _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Gep dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Load dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Cast dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Bitcast dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.BinOp dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.UnOp dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.LaneId dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Splat dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.MaskNot dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(CompilerIrInstr.TailMask dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.EntryArgc dst)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.EntryArgv dst)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.EntryEnvp dst)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.CpuId dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Xgetbv dst _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Syscall dst _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Call dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(CompilerIrInstr.Phi dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [_ facts]))

(define (opt-aggregate-sroa-store
  [candidates : opt_aggregate_candidate_vec.Vec]
  [facts : OptAggregateFieldFacts]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [ty : AstType]
  [instr : CompilerIrInstr]) : OptAggregateSroaResult
  (match (opt-aggregate-location-for-value candidates ptr)
    [(OptAggregateLocation.Some base offset)
      (if (and
        (opt-aggregate-scalar-replace-type? ty)
        (opt-copy-safe-source? value)
        (not (opt-aggregate-value-is-candidate-pointer? candidates value)))
        (OptAggregateSroaResult.Result
          (opt-aggregate-field-facts-bind facts base offset value ty)
          instr)
        (OptAggregateSroaResult.Result
          (opt-aggregate-field-facts-unbind-base facts base)
          instr))]
    [(OptAggregateLocation.No)
      (OptAggregateSroaResult.Result (OptAggregateFieldFacts.Nil) instr)]))

(define (opt-aggregate-sroa-load
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [facts : OptAggregateFieldFacts]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]
  [instr : CompilerIrInstr]) : OptAggregateSroaResult
  (let
    [next-facts : OptAggregateFieldFacts
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    (match (opt-aggregate-location-for-value candidates src)
      [(OptAggregateLocation.Some base offset)
        (match (opt-aggregate-field-facts-lookup
          type-segment-bases
          facts
          base
          offset
          ty)
          [(OptAggregateStoredValue.Some value _)
            (OptAggregateSroaResult.Result
              next-facts
              (CompilerIrInstr.Mov dst value ty))]
          [(OptAggregateStoredValue.No)
            (OptAggregateSroaResult.Result next-facts instr)])]
      [(OptAggregateLocation.No)
        (OptAggregateSroaResult.Result next-facts instr)])))

(define (opt-aggregate-sroa-instr
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [facts : OptAggregateFieldFacts]
  [instr : CompilerIrInstr]) : OptAggregateSroaResult
  (match instr
    [(CompilerIrInstr.StorePtr ptr value ty)
      (opt-aggregate-sroa-store candidates facts ptr value ty instr)]
    [(CompilerIrInstr.Load dst src ty)
      (opt-aggregate-sroa-load
        type-segment-bases
        candidates
        facts
        dst
        src
        ty
        instr)]
    [_
      (let
        [def-facts : OptAggregateFieldFacts
          (opt-aggregate-sroa-invalidate-def facts instr)]
        (if (compiler-ir-effect-invalidates-cse?
          (compiler-ir-instr-effect instr))
          (OptAggregateSroaResult.Result (OptAggregateFieldFacts.Nil) instr)
          (OptAggregateSroaResult.Result def-facts instr)))]))

(define (opt-aggregate-sroa-instr-seq-from
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [facts : OptAggregateFieldFacts]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    CompilerIrInstrList.Nil
    (match (opt-aggregate-sroa-instr
      type-segment-bases
      candidates
      facts
      (compiler-ir-instr-seq-ref instrs index))
      [(OptAggregateSroaResult.Result next-facts next-instr)
        (compiler-ir-instr-cons
          next-instr
          (opt-aggregate-sroa-instr-seq-from
            type-segment-bases
            candidates
            next-facts
            instrs
            (+ index 1)))])))

(define (opt-aggregate-sroa-instr-seq
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-aggregate-sroa-instr-seq-from
    type-segment-bases
    candidates
    (OptAggregateFieldFacts.Nil)
    instrs
    0))

(define (opt-aggregate-sroa-block
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (compiler-ir-block
        label
        (opt-aggregate-sroa-instr-seq type-segment-bases candidates instrs))]))

(define (opt-aggregate-sroa-blocks
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-aggregate-sroa-block type-segment-bases candidates block)
        (opt-aggregate-sroa-blocks type-segment-bases candidates (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-aggregate-sroa-blocks
        type-segment-bases
        candidates
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-aggregate-sroa-function-pass
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [candidates : opt_aggregate_candidate_vec.Vec
          (opt-aggregate-allocation-candidates-function type-segment-bases func)]
        (if (= (opt_aggregate_candidate_vec.len (& candidates)) 0)
          (OptFunctionPassResult.Result func false)
          (OptFunctionPassResult.Result
            (CompilerIrFunction.Function
              name
              params
              ret-ty
              frame
              (opt-aggregate-sroa-blocks type-segment-bases candidates blocks))
            true)))]))

(define (opt-aggregate-sroa-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-aggregate-sroa-function-pass type-segment-bases func)
    [(OptFunctionPassResult.Result next _) next]))

;; --- block-local common subexpression elimination ---------------------------
;;
;; Within a single basic block, track an available-expression table mapping a
;; pure scalar `BinOp`/`UnOp` expression (operator + operand values) or a
;; repeatable CPU feature probe to the var that first computed it. A later
;; identical expression is rewritten to an `CompilerIrInstr.Mov` from that earlier var.
;; Scope is intentionally block-local and only covers pure scalar arithmetic
;; plus process-stable `cpuid`/`xgetbv` results; memory ops are not CSE'd.
;;
;; Invalidation keeps this correct even though the IR is not strictly SSA: when
;; an instruction (re)defines a var, every table entry whose key references that
;; var as an operand, or whose result is that var, is dropped. Calls, stores
;; (`Store`/`StorePtr`), and all control-flow boundaries clear the whole table
;; (conservative, matching the spec). Commutative operands are NOT canonicalized
;; in this slice.
(defenum OptExprKey
  (BinKey CompilerIrBinOp CompilerIrValue CompilerIrValue AstType)
  (UnKey CompilerIrUnOp CompilerIrValue AstType)
  (CpuIdKey CompilerIrValue CompilerIrValue i64)
  (XgetbvKey CompilerIrValue))

(defenum OptExprTable
  (Nil)
  (Cons OptExprKey i64 (Box OptExprTable)))

(define (opt-binop-tag [op : CompilerIrBinOp]) : i64
  (match op
    [(CompilerIrBinOp.Add) 0]
    [(CompilerIrBinOp.Sub) 1]
    [(CompilerIrBinOp.Mul) 2]
    [(CompilerIrBinOp.Div) 3]
    [(CompilerIrBinOp.Mod) 4]
    [(CompilerIrBinOp.SafeDiv) 5]
    [(CompilerIrBinOp.SafeMod) 6]
    [(CompilerIrBinOp.Eq) 7]
    [(CompilerIrBinOp.Ne) 8]
    [(CompilerIrBinOp.Lt) 9]
    [(CompilerIrBinOp.Le) 10]
    [(CompilerIrBinOp.Gt) 11]
    [(CompilerIrBinOp.Ge) 12]
    [(CompilerIrBinOp.And) 13]
    [(CompilerIrBinOp.Or) 14]
    [(CompilerIrBinOp.BitAnd) 15]
    [(CompilerIrBinOp.BitOr) 16]
    [(CompilerIrBinOp.BitXor) 17]
    [(CompilerIrBinOp.Shl) 18]
    [(CompilerIrBinOp.Shr) 19]
    [(CompilerIrBinOp.BitTestEq) 20]
    [(CompilerIrBinOp.BitTestNe) 21]))

(define (opt-binop-eq [a : CompilerIrBinOp] [b : CompilerIrBinOp]) : bool
  (= (opt-binop-tag a) (opt-binop-tag b)))

(define (opt-unop-tag [op : CompilerIrUnOp]) : i64
  (match op
    [(CompilerIrUnOp.Neg) 0]
    [(CompilerIrUnOp.Not) 1]
    [(CompilerIrUnOp.BitNot) 2]
    [(CompilerIrUnOp.Sqrt) 3]))

(define (opt-unop-eq [a : CompilerIrUnOp] [b : CompilerIrUnOp]) : bool
  (= (opt-unop-tag a) (opt-unop-tag b)))

(define (opt-mask-binop-tag [op : CompilerIrMaskBinOp]) : i64
  (match op
    [(CompilerIrMaskBinOp.And) 0]
    [(CompilerIrMaskBinOp.Or) 1]))

(define (opt-mask-binop-eq [a : CompilerIrMaskBinOp] [b : CompilerIrMaskBinOp]) : bool
  (= (opt-mask-binop-tag a) (opt-mask-binop-tag b)))

(define (opt-vector-reduce-tag [op : CompilerIrVectorReduceOp]) : i64
  (match op
    [(CompilerIrVectorReduceOp.Sum) 0]
    [(CompilerIrVectorReduceOp.Min) 1]
    [(CompilerIrVectorReduceOp.Max) 2]))

(define (opt-vector-reduce-eq
  [a : CompilerIrVectorReduceOp]
  [b : CompilerIrVectorReduceOp]) : bool
  (= (opt-vector-reduce-tag a) (opt-vector-reduce-tag b)))

(define (opt-vector-prefix-op-tag [op : CompilerIrVectorPrefixOp]) : i64
  (match op
    [(CompilerIrVectorPrefixOp.Sum) 0]
    [(CompilerIrVectorPrefixOp.Min) 1]
    [(CompilerIrVectorPrefixOp.Max) 2]
    [(CompilerIrVectorPrefixOp.All) 3]
    [(CompilerIrVectorPrefixOp.Any) 4]))

(define (opt-vector-prefix-op-eq?
  [a : CompilerIrVectorPrefixOp]
  [b : CompilerIrVectorPrefixOp]) : bool
  (= (opt-vector-prefix-op-tag a) (opt-vector-prefix-op-tag b)))

(define (opt-mask-reduce-tag [op : CompilerIrMaskReduceOp]) : i64
  (match op
    [(CompilerIrMaskReduceOp.All) 0]
    [(CompilerIrMaskReduceOp.Any) 1]))

(define (opt-mask-reduce-eq
  [a : CompilerIrMaskReduceOp]
  [b : CompilerIrMaskReduceOp]) : bool
  (= (opt-mask-reduce-tag a) (opt-mask-reduce-tag b)))

(define (opt-value-eq [a : CompilerIrValue] [b : CompilerIrValue]) : bool
  (match a
    [(CompilerIrValue.Var ia)
      (match b
        [(CompilerIrValue.Var ib) (= ia ib)]
        [_ false])]
    [(CompilerIrValue.Global ga)
      (match b
        [(CompilerIrValue.Global gb) (compiler-ir-symbol-eq? ga gb)]
        [_ false])]
    [(CompilerIrValue.GlobalAddr ga)
      (match b
        [(CompilerIrValue.GlobalAddr gb) (compiler-ir-symbol-eq? ga gb)]
        [_ false])]
    [(CompilerIrValue.Function fa)
      (match b
        [(CompilerIrValue.Function fb) (compiler-ir-symbol-eq? fa fb)]
        [_ false])]
    [(CompilerIrValue.I64 na)
      (match b
        [(CompilerIrValue.I64 nb) (= na nb)]
        [_ false])]
    [(CompilerIrValue.F64 fa)
      (match b
        [(CompilerIrValue.F64 fb) (= fa fb)]
        [_ false])]
    [(CompilerIrValue.Bool ba)
      (match b
        [(CompilerIrValue.Bool bb)
          (if ba
            bb
            (not bb))]
        [_ false])]
    [(CompilerIrValue.Char ca)
      (match b
        [(CompilerIrValue.Char cb) (= ca cb)]
        [_ false])]
    [(CompilerIrValue.String sa)
      (match b
        [(CompilerIrValue.String sb) (string.eq sa sb)]
        [_ false])]
    [(CompilerIrValue.Bytes sa)
      (match b
        [(CompilerIrValue.Bytes sb) (string.eq sa sb)]
        [_ false])]
    [(CompilerIrValue.RuntimeGlobal ia)
      (match b
        [(CompilerIrValue.RuntimeGlobal ib) (compiler-ir-symbol-eq? ia ib)]
        [_ false])]
    [(CompilerIrValue.Unit)
      (match b
        [(CompilerIrValue.Unit) true]
        [_ false])]))

(define (opt-type-list-eq-at
  [type-segment-bases : i64]
  [a : (& a AstTypeList)]
  [b : (& b AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len a))
    true
    (and
      (opt-type-eq
        type-segment-bases
        (ast-type-segment-bases-get
          type-segment-bases
          (ast-type-list-get a index (ast-type-id-fallback)))
        (ast-type-segment-bases-get
          type-segment-bases
          (ast-type-list-get b index (ast-type-id-fallback))))
      (opt-type-list-eq-at type-segment-bases a b (+ index 1)))))

(define (opt-type-list-eq
  [type-segment-bases : i64]
  [a : AstTypeList]
  [b : AstTypeList]) : bool
  (and
    (= (ast-type-list-len (& a)) (ast-type-list-len (& b)))
    (opt-type-list-eq-at type-segment-bases (& a) (& b) 0)))

(define (opt-lifetime-list-eq-at
  [a : (& a AstLifetimeList)]
  [b : (& b AstLifetimeList)]
  [index : i64]) : bool
  (if (>= index (ast-lifetime-list-len a))
    true
    (and
      (=
        (ast-lifetime-list-get a index (ast-lifetime-fallback))
        (ast-lifetime-list-get b index (ast-lifetime-fallback)))
      (opt-lifetime-list-eq-at a b (+ index 1)))))

(define (opt-lifetime-list-eq [a : AstLifetimeList] [b : AstLifetimeList]) : bool
  (and
    (= (ast-lifetime-list-len (& a)) (ast-lifetime-list-len (& b)))
    (opt-lifetime-list-eq-at (& a) (& b) 0)))

(define (opt-type-eq [type-segment-bases : i64] [a : AstType] [b : AstType]) : bool
  (match a
    [(AstType.I64)
      (match b
        [(AstType.I64) true]
        [_ false])]
    [(AstType.I32)
      (match b
        [(AstType.I32) true]
        [_ false])]
    [(AstType.I16)
      (match b
        [(AstType.I16) true]
        [_ false])]
    [(AstType.I8)
      (match b
        [(AstType.I8) true]
        [_ false])]
    [(AstType.U64)
      (match b
        [(AstType.U64) true]
        [_ false])]
    [(AstType.U32)
      (match b
        [(AstType.U32) true]
        [_ false])]
    [(AstType.U16)
      (match b
        [(AstType.U16) true]
        [_ false])]
    [(AstType.U8)
      (match b
        [(AstType.U8) true]
        [_ false])]
    [(AstType.F64)
      (match b
        [(AstType.F64) true]
        [_ false])]
    [(AstType.F32)
      (match b
        [(AstType.F32) true]
        [_ false])]
    [(AstType.Bool)
      (match b
        [(AstType.Bool) true]
        [_ false])]
    [(AstType.Char)
      (match b
        [(AstType.Char) true]
        [_ false])]
    [(AstType.String)
      (match b
        [(AstType.String) true]
        [_ false])]
    [(AstType.Str)
      (match b
        [(AstType.Str) true]
        [_ false])]
    [(AstType.Bytes)
      (match b
        [(AstType.Bytes) true]
        [_ false])]
    [(AstType.Unit)
      (match b
        [(AstType.Unit) true]
        [_ false])]
    [(AstType.Never)
      (match b
        [(AstType.Never) true]
        [_ false])]
    [(AstType.Expr)
      (match b
        [(AstType.Expr) true]
        [_ false])]
    [(AstType.ExprList)
      (match b
        [(AstType.ExprList) true]
        [_ false])]
    [(AstType.Func a-params a-ret)
      (match b
        [(AstType.Func b-params b-ret)
          (and
            (opt-type-list-eq
              type-segment-bases
              (box-get a-params)
              (box-get b-params))
            (opt-type-eq
              type-segment-bases
              (ast-type-segment-bases-get type-segment-bases a-ret)
              (ast-type-segment-bases-get type-segment-bases b-ret)))]
        [_ false])]
    [(AstType.Tuple a-items)
      (match b
        [(AstType.Tuple b-items)
          (opt-type-list-eq
            type-segment-bases
            (box-get a-items)
            (box-get b-items))]
        [_ false])]
    [(AstType.Array a-item a-len)
      (match b
        [(AstType.Array b-item b-len)
          (and
            (= a-len b-len)
            (opt-type-eq
              type-segment-bases
              (ast-type-segment-bases-get type-segment-bases a-item)
              (ast-type-segment-bases-get type-segment-bases b-item)))]
        [_ false])]
    [(AstType.DynArray a-item)
      (match b
        [(AstType.DynArray b-item)
          (opt-type-eq
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases a-item)
            (ast-type-segment-bases-get type-segment-bases b-item))]
        [_ false])]
    [(AstType.Box a-item)
      (match b
        [(AstType.Box b-item)
          (opt-type-eq
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases a-item)
            (ast-type-segment-bases-get type-segment-bases b-item))]
        [_ false])]
    [(AstType.Ptr a-item)
      (match b
        [(AstType.Ptr b-item)
          (opt-type-eq
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases a-item)
            (ast-type-segment-bases-get type-segment-bases b-item))]
        [_ false])]
    [(AstType.MutPtr a-item)
      (match b
        [(AstType.MutPtr b-item)
          (opt-type-eq
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases a-item)
            (ast-type-segment-bases-get type-segment-bases b-item))]
        [_ false])]
    [(AstType.Ref a-region a-inner)
      (match b
        [(AstType.Ref b-region b-inner)
          (and
            (= a-region b-region)
            (opt-type-eq
              type-segment-bases
              (ast-type-segment-bases-get type-segment-bases a-inner)
              (ast-type-segment-bases-get type-segment-bases b-inner)))]
        [_ false])]
    [(AstType.MutRef a-region a-inner)
      (match b
        [(AstType.MutRef b-region b-inner)
          (and
            (= a-region b-region)
            (opt-type-eq
              type-segment-bases
              (ast-type-segment-bases-get type-segment-bases a-inner)
              (ast-type-segment-bases-get type-segment-bases b-inner)))]
        [_ false])]
    [(AstType.Region a-region a-inner)
      (match b
        [(AstType.Region b-region b-inner)
          (and
            (= a-region b-region)
            (opt-type-eq
              type-segment-bases
              (ast-type-segment-bases-get type-segment-bases a-inner)
              (ast-type-segment-bases-get type-segment-bases b-inner)))]
        [_ false])]
    [(AstType.Enum a-name)
      (match b
        [(AstType.Enum b-name) (= a-name b-name)]
        [_ false])]
    [(AstType.EnumArgs a-name a-lifetimes)
      (match b
        [(AstType.EnumArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (opt-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstType.Struct a-name)
      (match b
        [(AstType.Struct b-name) (= a-name b-name)]
        [_ false])]
    [(AstType.StructArgs a-name a-lifetimes)
      (match b
        [(AstType.StructArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (opt-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstType.Var a-name)
      (match b
        [(AstType.Var b-name) (= a-name b-name)]
        [_ false])]
    [(AstType.VarArgs a-name a-lifetimes)
      (match b
        [(AstType.VarArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (opt-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstType.Consume a-inner)
      (match b
        [(AstType.Consume b-inner)
          (opt-type-eq
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases a-inner)
            (ast-type-segment-bases-get type-segment-bases b-inner))]
        [_ false])]))

(define (opt-symbol-hash [symbol : i64]) : i64
  (let
    [name-id : i64 (compiler-ir-symbol-id symbol)]
    (if (>= name-id 0)
      (hash.i64 name-id)
      (let
        [text : String (compiler-ir-symbol-text symbol)]
        (hash.string-key (& text))))))

(define (opt-value-hash [value : CompilerIrValue]) : i64
  (match value
    [(CompilerIrValue.Var id) (hash.combine 1 (hash.i64 id))]
    [(CompilerIrValue.Global name) (hash.combine 2 (opt-symbol-hash name))]
    [(CompilerIrValue.GlobalAddr name) (hash.combine 3 (opt-symbol-hash name))]
    [(CompilerIrValue.Function name) (hash.combine 4 (opt-symbol-hash name))]
    [(CompilerIrValue.I64 value) (hash.combine 5 (hash.i64 value))]
    [(CompilerIrValue.F64 value) (hash.combine 6 (hash.i64 (cast value : i64)))]
    [(CompilerIrValue.Bool value) (hash.combine 7 (hash.bool value))]
    [(CompilerIrValue.Char value) (hash.combine 8 (hash.char value))]
    [(CompilerIrValue.String value)
      (hash.combine 9 (hash.string-key (& value)))]
    [(CompilerIrValue.Bytes value)
      (hash.combine 11 (hash.string-key (& value)))]
    [(CompilerIrValue.RuntimeGlobal init)
      (hash.combine 12 (opt-symbol-hash init))]
    [(CompilerIrValue.Unit) (hash.i64 10)]))

(define (opt-expr-key-hash [type-segment-bases : i64] [key : OptExprKey]) : i64
  (match key
    [(OptExprKey.BinKey op lhs rhs ty)
      (hash.combine
        1
        (hash.combine
          (opt-type-hash type-segment-bases ty)
          (hash.combine
            (hash.i64 (opt-binop-tag op))
            (hash.combine (opt-value-hash lhs) (opt-value-hash rhs)))))]
    [(OptExprKey.UnKey op value ty)
      (hash.combine
        2
        (hash.combine
          (opt-type-hash type-segment-bases ty)
          (hash.combine (hash.i64 (opt-unop-tag op)) (opt-value-hash value))))]
    [(OptExprKey.CpuIdKey leaf subleaf reg-index)
      (hash.combine
        3
        (hash.combine
          (hash.i64 reg-index)
          (hash.combine (opt-value-hash leaf) (opt-value-hash subleaf))))]
    [(OptExprKey.XgetbvKey index) (hash.combine 4 (opt-value-hash index))]))

(define (opt-type-list-hash-at
  [type-segment-bases : i64]
  [types : (& types AstTypeList)]
  [index : i64]) : i64
  (if (>= index (ast-type-list-len types))
    (hash.i64 0)
    (hash.combine
      1
      (hash.combine
        (opt-type-hash
          type-segment-bases
          (ast-type-segment-bases-get
            type-segment-bases
            (ast-type-list-get types index (ast-type-id-fallback))))
        (opt-type-list-hash-at type-segment-bases types (+ index 1))))))

(define (opt-type-list-hash [type-segment-bases : i64] [types : AstTypeList]) : i64
  (opt-type-list-hash-at type-segment-bases (& types) 0))

(define (opt-lifetime-list-hash-at
  [lifetimes : (& lifetimes AstLifetimeList)]
  [index : i64]) : i64
  (if (>= index (ast-lifetime-list-len lifetimes))
    (hash.i64 0)
    (let
      [head : i64
        (ast-lifetime-list-get lifetimes index (ast-lifetime-fallback))]
      (hash.combine
        1
        (hash.combine
          (hash.i64 head)
          (opt-lifetime-list-hash-at lifetimes (+ index 1)))))))

(define (opt-lifetime-list-hash [lifetimes : AstLifetimeList]) : i64
  (opt-lifetime-list-hash-at (& lifetimes) 0))

(define (opt-type-hash [type-segment-bases : i64] [ty : AstType]) : i64
  (match ty
    [(AstType.I64) (hash.i64 1)]
    [(AstType.I32) (hash.i64 2)]
    [(AstType.I16) (hash.i64 3)]
    [(AstType.I8) (hash.i64 4)]
    [(AstType.U64) (hash.i64 5)]
    [(AstType.U32) (hash.i64 6)]
    [(AstType.U16) (hash.i64 7)]
    [(AstType.U8) (hash.i64 8)]
    [(AstType.F64) (hash.i64 9)]
    [(AstType.F32) (hash.i64 10)]
    [(AstType.Bool) (hash.i64 11)]
    [(AstType.Char) (hash.i64 12)]
    [(AstType.String) (hash.i64 13)]
    [(AstType.Str) (hash.i64 14)]
    [(AstType.Bytes) (hash.i64 35)]
    [(AstType.Unit) (hash.i64 15)]
    [(AstType.Never) (hash.i64 16)]
    [(AstType.Expr) (hash.i64 17)]
    [(AstType.ExprList) (hash.i64 18)]
    [(AstType.Func params ret)
      (hash.combine
        19
        (hash.combine
          (opt-type-list-hash type-segment-bases (box-get params))
          (opt-type-hash
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases ret))))]
    [(AstType.Tuple items)
      (hash.combine 20 (opt-type-list-hash type-segment-bases (box-get items)))]
    [(AstType.Array item len)
      (hash.combine
        21
        (hash.combine
          (opt-type-hash
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases item))
          (hash.i64 len)))]
    [(AstType.DynArray item)
      (hash.combine
        22
        (opt-type-hash
          type-segment-bases
          (ast-type-segment-bases-get type-segment-bases item)))]
    [(AstType.Box item)
      (hash.combine
        23
        (opt-type-hash
          type-segment-bases
          (ast-type-segment-bases-get type-segment-bases item)))]
    [(AstType.Ptr item)
      (hash.combine
        24
        (opt-type-hash
          type-segment-bases
          (ast-type-segment-bases-get type-segment-bases item)))]
    [(AstType.MutPtr item)
      (hash.combine
        25
        (opt-type-hash
          type-segment-bases
          (ast-type-segment-bases-get type-segment-bases item)))]
    [(AstType.Ref region inner)
      (hash.combine
        26
        (hash.combine
          (hash.i64 region)
          (opt-type-hash
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases inner))))]
    [(AstType.MutRef region inner)
      (hash.combine
        27
        (hash.combine
          (hash.i64 region)
          (opt-type-hash
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases inner))))]
    [(AstType.Region region inner)
      (hash.combine
        28
        (hash.combine
          (hash.i64 region)
          (opt-type-hash
            type-segment-bases
            (ast-type-segment-bases-get type-segment-bases inner))))]
    [(AstType.Enum name) (hash.combine 29 (hash.i64 name))]
    [(AstType.EnumArgs name lifetimes)
      (hash.combine
        30
        (hash.combine
          (hash.i64 name)
          (opt-lifetime-list-hash (box-get lifetimes))))]
    [(AstType.Struct name) (hash.combine 31 (hash.i64 name))]
    [(AstType.StructArgs name lifetimes)
      (hash.combine
        32
        (hash.combine
          (hash.i64 name)
          (opt-lifetime-list-hash (box-get lifetimes))))]
    [(AstType.Var name) (hash.combine 33 (hash.i64 name))]
    [(AstType.VarArgs name lifetimes)
      (hash.combine
        34
        (hash.combine
          (hash.i64 name)
          (opt-lifetime-list-hash (box-get lifetimes))))]
    [(AstType.Consume inner)
      (hash.combine
        36
        (opt-type-hash
          type-segment-bases
          (ast-type-segment-bases-get type-segment-bases inner)))]))

(define (opt-maybe-value-eq
  [a : CompilerIrMaybeValue]
  [b : CompilerIrMaybeValue]) : bool
  (match a
    [(CompilerIrMaybeValue.No)
      (match b
        [(CompilerIrMaybeValue.No) true]
        [_ false])]
    [(CompilerIrMaybeValue.Some av)
      (match b
        [(CompilerIrMaybeValue.Some bv) (opt-value-eq av bv)]
        [_ false])]))

(define (opt-value-list-eq [a : CompilerIrValueList] [b : CompilerIrValueList]) : bool
  (match a
    [(CompilerIrValueList.Nil)
      (match b
        [(CompilerIrValueList.Nil) true]
        [(CompilerIrValueList.Array seq)
          (opt-value-list-eq a (compiler-ir-value-seq-to-list seq))]
        [_ false])]
    [(CompilerIrValueList.Array seq)
      (opt-value-list-eq (compiler-ir-value-seq-to-list seq) b)]
    [(CompilerIrValueList.Cons ah at)
      (match b
        [(CompilerIrValueList.Array seq)
          (opt-value-list-eq a (compiler-ir-value-seq-to-list seq))]
        [(CompilerIrValueList.Cons bh bt)
          (and
            (opt-value-eq ah bh)
            (opt-value-list-eq (box-get at) (box-get bt)))]
        [_ false])]))

(define (opt-call-args-array-eq
  [a : (Array CompilerIrValue)]
  [b : (Array CompilerIrValue)]
  [index : i64]) : bool
  (if (>= index (array-length a))
    true
    (and
      (opt-value-eq (array-ref a index) (array-ref b index))
      (opt-call-args-array-eq a b (+ index 1)))))

(define (opt-call-args-eq [a : CompilerIrCallArgs] [b : CompilerIrCallArgs]) : bool
  (match a
    [(CompilerIrCallArgs.Nil)
      (match b
        [(CompilerIrCallArgs.Nil) true]
        [_ false])]
    [(CompilerIrCallArgs.One av)
      (match b
        [(CompilerIrCallArgs.One bv) (opt-value-eq av bv)]
        [_ false])]
    [(CompilerIrCallArgs.Two aa ab)
      (match b
        [(CompilerIrCallArgs.Two ba bb)
          (and (opt-value-eq aa ba) (opt-value-eq ab bb))]
        [_ false])]
    [(CompilerIrCallArgs.Array av)
      (match b
        [(CompilerIrCallArgs.Array bv)
          (and
            (= (array-length av) (array-length bv))
            (opt-call-args-array-eq av bv 0))]
        [_ false])]))

(define (opt-phi-input-eq
  [av : CompilerIrValue]
  [alabel : i64]
  [bv : CompilerIrValue]
  [blabel : i64]) : bool
  (and (= alabel blabel) (opt-value-eq av bv)))

(define (opt-phi-input-list-eq
  [a : CompilerIrPhiInputList]
  [b : CompilerIrPhiInputList]) : bool
  (match (compiler-ir-phi-input-list-force-cons a)
    [(CompilerIrPhiInputList.Nil)
      (match (compiler-ir-phi-input-list-force-cons b)
        [(CompilerIrPhiInputList.Nil) true]
        [(CompilerIrPhiInputList.Array seq)
          (opt-phi-input-list-eq
            CompilerIrPhiInputList.Nil
            (compiler-ir-phi-input-seq-to-list seq))]
        [_ false])]
    [(CompilerIrPhiInputList.Array seq)
      (opt-phi-input-list-eq (compiler-ir-phi-input-seq-to-list seq) b)]
    [(CompilerIrPhiInputList.Cons av alabel at)
      (match (compiler-ir-phi-input-list-force-cons b)
        [(CompilerIrPhiInputList.Cons bv blabel bt)
          (and
            (opt-phi-input-eq av alabel bv blabel)
            (opt-phi-input-list-eq (box-get at) (box-get bt)))]
        [(CompilerIrPhiInputList.Array seq)
          (opt-phi-input-list-eq
            (compiler-ir-phi-input-cons-linked av alabel (box-get at))
            (compiler-ir-phi-input-seq-to-list seq))]
        [_ false])]))

(define (opt-switch-case-eq
  [a : CompilerIrSwitchCase]
  [b : CompilerIrSwitchCase]) : bool
  (match a
    [(CompilerIrSwitchCase.Case at alabel)
      (match b
        [(CompilerIrSwitchCase.Case bt blabel)
          (and (= at bt) (= alabel blabel))])]))

(define (opt-switch-case-list-eq
  [a : CompilerIrSwitchCaseList]
  [b : CompilerIrSwitchCaseList]) : bool
  (match (compiler-ir-switch-case-list-force-cons a)
    [(CompilerIrSwitchCaseList.Nil)
      (match (compiler-ir-switch-case-list-force-cons b)
        [(CompilerIrSwitchCaseList.Nil) true]
        [(CompilerIrSwitchCaseList.Array seq) (= (struct-get seq len) 0)]
        [_ false])]
    [(CompilerIrSwitchCaseList.Cons acase at)
      (match (compiler-ir-switch-case-list-force-cons b)
        [(CompilerIrSwitchCaseList.Cons bcase bt)
          (and
            (opt-switch-case-eq acase bcase)
            (opt-switch-case-list-eq (box-get at) (box-get bt)))]
        [(CompilerIrSwitchCaseList.Array seq)
          (match acase
            [(CompilerIrSwitchCase.Case tag label)
              (opt-switch-case-list-eq
                (compiler-ir-switch-case-cons-linked tag label (box-get at))
                (compiler-ir-switch-case-seq-to-list seq))])]
        [_ false])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-switch-case-list-eq (compiler-ir-switch-case-seq-to-list seq) b)]))

(define (opt-c-abi-return-slot-eq
  [type-segment-bases : i64]
  [a : CompilerIrCAbiReturnSlot]
  [b : CompilerIrCAbiReturnSlot]) : bool
  (match a
    [(CompilerIrCAbiReturnSlot.Slot aty aoffset)
      (match b
        [(CompilerIrCAbiReturnSlot.Slot bty boffset)
          (and (= aoffset boffset) (opt-type-eq type-segment-bases aty bty))])]))

(define (opt-c-abi-return-slot-seq-eq-from
  [type-segment-bases : i64]
  [a : (Array CompilerIrCAbiReturnSlot)]
  [b : (Array CompilerIrCAbiReturnSlot)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    true
    (and
      (opt-c-abi-return-slot-eq
        type-segment-bases
        (array-ref a index)
        (array-ref b index))
      (opt-c-abi-return-slot-seq-eq-from
        type-segment-bases
        a
        b
        (+ index 1)
        count))))

(define (opt-c-abi-return-slot-seq-eq
  [type-segment-bases : i64]
  [a : CompilerIrCAbiReturnSlotSeq]
  [b : CompilerIrCAbiReturnSlotSeq]) : bool
  (let
    [count : i64 (struct-get a len)]
    (and
      (= count (struct-get b len))
      (opt-c-abi-return-slot-seq-eq-from
        type-segment-bases
        (struct-get a slots)
        (struct-get b slots)
        0
        count))))

(define (opt-c-abi-return-slot-list-eq
  [type-segment-bases : i64]
  [a : CompilerIrCAbiReturnSlotList]
  [b : CompilerIrCAbiReturnSlotList]) : bool
  (match a
    [(CompilerIrCAbiReturnSlotList.Nil)
      (match b
        [(CompilerIrCAbiReturnSlotList.Nil) true]
        [(CompilerIrCAbiReturnSlotList.Array seq) (= (struct-get seq len) 0)]
        [_ false])]
    [(CompilerIrCAbiReturnSlotList.Cons aslot arest)
      (match b
        [(CompilerIrCAbiReturnSlotList.Cons bslot brest)
          (and
            (opt-c-abi-return-slot-eq type-segment-bases aslot bslot)
            (opt-c-abi-return-slot-list-eq
              type-segment-bases
              (box-get arest)
              (box-get brest)))]
        [(CompilerIrCAbiReturnSlotList.Array seq)
          (opt-c-abi-return-slot-list-eq
            type-segment-bases
            (compiler-ir-c-abi-return-slot-cons-linked aslot (box-get arest))
            (compiler-ir-c-abi-return-slot-seq-to-list seq))]
        [_ false])]
    [(CompilerIrCAbiReturnSlotList.Array aseq)
      (match b
        [(CompilerIrCAbiReturnSlotList.Array bseq)
          (opt-c-abi-return-slot-seq-eq type-segment-bases aseq bseq)]
        [_
          (opt-c-abi-return-slot-list-eq
            type-segment-bases
            (compiler-ir-c-abi-return-slot-seq-to-list aseq)
            b)])]))

(define (opt-instr-eq
  [type-segment-bases : i64]
  [a : CompilerIrInstr]
  [b : CompilerIrInstr]) : bool
  (match a
    [(CompilerIrInstr.Mov ad av aty)
      (match b
        [(CompilerIrInstr.Mov bd bv bty)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.Alloc ad aty)
      (match b
        [(CompilerIrInstr.Alloc bd bty)
          (and (= ad bd) (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.AddrOf ad av)
      (match b
        [(CompilerIrInstr.AddrOf bd bv) (and (= ad bd) (= av bv))]
        [_ false])]
    [(CompilerIrInstr.Gep ad abase aoffset aty)
      (match b
        [(CompilerIrInstr.Gep bd bbase boffset bty)
          (and
            (= ad bd)
            (opt-value-eq abase bbase)
            (opt-value-eq aoffset boffset)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.Load ad av aty)
      (match b
        [(CompilerIrInstr.Load bd bv bty)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.StorePtr aptr av aty)
      (match b
        [(CompilerIrInstr.StorePtr bptr bv bty)
          (and
            (opt-value-eq aptr bptr)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.CopyBytes adst asrc asize)
      (match b
        [(CompilerIrInstr.CopyBytes bdst bsrc bsize)
          (and
            (= asize bsize)
            (opt-value-eq adst bdst)
            (opt-value-eq asrc bsrc))]
        [_ false])]
    [(CompilerIrInstr.Cast ad av afrom ato)
      (match b
        [(CompilerIrInstr.Cast bd bv bfrom bto)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases afrom bfrom)
            (opt-type-eq type-segment-bases ato bto))]
        [_ false])]
    [(CompilerIrInstr.Bitcast ad av afrom ato)
      (match b
        [(CompilerIrInstr.Bitcast bd bv bfrom bto)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases afrom bfrom)
            (opt-type-eq type-segment-bases ato bto))]
        [_ false])]
    [(CompilerIrInstr.BinOp ad aop al ar aty)
      (match b
        [(CompilerIrInstr.BinOp bd bop bl br bty)
          (and
            (= ad bd)
            (opt-binop-eq aop bop)
            (opt-value-eq al bl)
            (opt-value-eq ar br)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.UnOp ad aop av aty)
      (match b
        [(CompilerIrInstr.UnOp bd bop bv bty)
          (and
            (= ad bd)
            (opt-unop-eq aop bop)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.LaneId ad alanes aty)
      (match b
        [(CompilerIrInstr.LaneId bd blanes bty)
          (and
            (= ad bd)
            (= alanes blanes)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.Splat ad av alanes aty)
      (match b
        [(CompilerIrInstr.Splat bd bv blanes bty)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (= alanes blanes)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload ad aop al ar alanes aty)
          (match b
            [(CompilerIrInstr.VectorBinOp other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrVectorBinOpPayload.Payload
                    bd
                    bop
                    bl
                    br
                    blanes
                    bty)
                  (and
                    (= ad bd)
                    (opt-binop-eq aop bop)
                    (opt-value-eq al bl)
                    (opt-value-eq ar br)
                    (= alanes blanes)
                    (opt-type-eq type-segment-bases aty bty))])]
            [_ false])])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload ad aop as ac alanes aty)
          (match b
            [(CompilerIrInstr.VectorPrefix other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrVectorPrefixPayload.Payload
                    bd
                    bop
                    bs
                    bc
                    blanes
                    bty)
                  (and
                    (= ad bd)
                    (opt-vector-prefix-op-eq? aop bop)
                    (opt-value-eq as bs)
                    (opt-value-eq ac bc)
                    (= alanes blanes)
                    (opt-type-eq type-segment-bases aty bty))])]
            [_ false])])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            ad
            abase
            aindex-base
            aindex
            alane-offset
            alanes
            aty)
          (match b
            [(CompilerIrInstr.GatherLoad other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrGatherLoadPayload.Payload
                    bd
                    bbase
                    bindex-base
                    bindex
                    blane-offset
                    blanes
                    bty)
                  (and
                    (= ad bd)
                    (opt-value-eq abase bbase)
                    (opt-value-eq aindex-base bindex-base)
                    (opt-value-eq aindex bindex)
                    (if alane-offset
                      blane-offset
                      (not blane-offset))
                    (= alanes blanes)
                    (opt-type-eq type-segment-bases aty bty))])]
            [_ false])])]
    [(CompilerIrInstr.VectorReduce ad aop av alanes aty)
      (match b
        [(CompilerIrInstr.VectorReduce bd bop bv blanes bty)
          (and
            (= ad bd)
            (opt-vector-reduce-eq aop bop)
            (opt-value-eq av bv)
            (= alanes blanes)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload ad aop al ar alanes aty)
          (match b
            [(CompilerIrInstr.VectorCompare other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrVectorComparePayload.Payload
                    bd
                    bop
                    bl
                    br
                    blanes
                    bty)
                  (and
                    (= ad bd)
                    (opt-binop-eq aop bop)
                    (opt-value-eq al bl)
                    (opt-value-eq ar br)
                    (= alanes blanes)
                    (opt-type-eq type-segment-bases aty bty))])]
            [_ false])])]
    [(CompilerIrInstr.MaskBinOp ad aop al ar alanes)
      (match b
        [(CompilerIrInstr.MaskBinOp bd bop bl br blanes)
          (and
            (= ad bd)
            (opt-mask-binop-eq aop bop)
            (opt-value-eq al bl)
            (opt-value-eq ar br)
            (= alanes blanes))]
        [_ false])]
    [(CompilerIrInstr.MaskNot ad av alanes)
      (match b
        [(CompilerIrInstr.MaskNot bd bv blanes)
          (and (= ad bd) (opt-value-eq av bv) (= alanes blanes))]
        [_ false])]
    [(CompilerIrInstr.MaskReduce ad aop av alanes)
      (match b
        [(CompilerIrInstr.MaskReduce bd bop bv blanes)
          (and
            (= ad bd)
            (opt-mask-reduce-eq aop bop)
            (opt-value-eq av bv)
            (= alanes blanes))]
        [_ false])]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload ad amask at af alanes aty)
          (match b
            [(CompilerIrInstr.Select other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrSelectPayload.Payload
                    bd
                    bmask
                    bt
                    bf
                    blanes
                    bty)
                  (and
                    (= ad bd)
                    (opt-value-eq amask bmask)
                    (opt-value-eq at bt)
                    (opt-value-eq af bf)
                    (= alanes blanes)
                    (opt-type-eq type-segment-bases aty bty))])]
            [_ false])])]
    [(CompilerIrInstr.VectorLoad ad abase aindex alanes aty)
      (match b
        [(CompilerIrInstr.VectorLoad bd bbase bindex blanes bty)
          (and
            (= ad bd)
            (opt-value-eq abase bbase)
            (opt-value-eq aindex bindex)
            (= alanes blanes)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload abase aindex av alanes aty)
          (match b
            [(CompilerIrInstr.VectorStore other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrVectorStorePayload.Payload
                    bbase
                    bindex
                    bv
                    blanes
                    bty)
                  (and
                    (opt-value-eq abase bbase)
                    (opt-value-eq aindex bindex)
                    (opt-value-eq av bv)
                    (= alanes blanes)
                    (opt-type-eq type-segment-bases aty bty))])]
            [_ false])])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            abase
            aindex
            av
            amask
            alanes
            aty)
          (match b
            [(CompilerIrInstr.PredicatedStore other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrPredicatedStorePayload.Payload
                    bbase
                    bindex
                    bv
                    bmask
                    blanes
                    bty)
                  (and
                    (opt-value-eq abase bbase)
                    (opt-value-eq aindex bindex)
                    (opt-value-eq av bv)
                    (opt-value-eq amask bmask)
                    (= alanes blanes)
                    (opt-type-eq type-segment-bases aty bty))])]
            [_ false])])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload
            ad
            abase
            aindex
            amask
            alanes
            aty)
          (match b
            [(CompilerIrInstr.PredicatedLoad other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrPredicatedLoadPayload.Payload
                    bd
                    bbase
                    bindex
                    bmask
                    blanes
                    bty)
                  (and
                    (= ad bd)
                    (opt-value-eq abase bbase)
                    (opt-value-eq aindex bindex)
                    (opt-value-eq amask bmask)
                    (= alanes blanes)
                    (opt-type-eq type-segment-bases aty bty))])]
            [_ false])])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            ad
            asource
            aselector-low
            aselector-high
            aactive-lanes
            alanes
            aty)
          (match b
            [(CompilerIrInstr.VectorShuffle other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrVectorShufflePayload.Payload
                    bd
                    bsource
                    bselector-low
                    bselector-high
                    bactive-lanes
                    blanes
                    bty)
                  (and
                    (= ad bd)
                    (opt-value-eq asource bsource)
                    (opt-value-eq aselector-low bselector-low)
                    (opt-maybe-value-eq aselector-high bselector-high)
                    (opt-value-eq aactive-lanes bactive-lanes)
                    (= alanes blanes)
                    (opt-type-eq type-segment-bases aty bty))])]
            [_ false])])]
    [(CompilerIrInstr.TailMask ad aindex alength alanes)
      (match b
        [(CompilerIrInstr.TailMask bd bindex blength blanes)
          (and
            (= ad bd)
            (opt-value-eq aindex bindex)
            (opt-value-eq alength blength)
            (= alanes blanes))]
        [_ false])]
    [(CompilerIrInstr.EntryArgc ad)
      (match b
        [(CompilerIrInstr.EntryArgc bd) (= ad bd)]
        [_ false])]
    [(CompilerIrInstr.EntryArgv ad)
      (match b
        [(CompilerIrInstr.EntryArgv bd) (= ad bd)]
        [_ false])]
    [(CompilerIrInstr.EntryEnvp ad)
      (match b
        [(CompilerIrInstr.EntryEnvp bd) (= ad bd)]
        [_ false])]
    [(CompilerIrInstr.CpuId ad aleaf asubleaf areg)
      (match b
        [(CompilerIrInstr.CpuId bd bleaf bsubleaf breg)
          (and
            (= ad bd)
            (opt-value-eq aleaf bleaf)
            (opt-value-eq asubleaf bsubleaf)
            (= areg breg))]
        [_ false])]
    [(CompilerIrInstr.Xgetbv ad aindex)
      (match b
        [(CompilerIrInstr.Xgetbv bd bindex)
          (and (= ad bd) (opt-value-eq aindex bindex))]
        [_ false])]
    [(CompilerIrInstr.Syscall ad aargs)
      (match b
        [(CompilerIrInstr.Syscall bd bargs)
          (and (= ad bd) (opt-call-args-eq aargs bargs))]
        [_ false])]
    [(CompilerIrInstr.Call ad aname aargs aty)
      (match b
        [(CompilerIrInstr.Call bd bname bargs bty)
          (and
            (= ad bd)
            (compiler-ir-symbol-eq? aname bname)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.CallIndirect ad afunc aargs aty)
      (match b
        [(CompilerIrInstr.CallIndirect bd bfunc bargs bty)
          (and
            (= ad bd)
            (opt-value-eq afunc bfunc)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.CallIndirectC ad afunc aargs aty)
      (match b
        [(CompilerIrInstr.CallIndirectC bd bfunc bargs bty)
          (and
            (= ad bd)
            (opt-value-eq afunc bfunc)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload
            abase
            aname
            aargs
            aslots)
          (match b
            [(CompilerIrInstr.CallCAbiStoreResult other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrCallCAbiStoreResultPayload.Payload
                    bbase
                    bname
                    bargs
                    bslots)
                  (and
                    (opt-value-eq abase bbase)
                    (compiler-ir-symbol-eq? aname bname)
                    (opt-call-args-eq aargs bargs)
                    (opt-c-abi-return-slot-list-eq
                      type-segment-bases
                      aslots
                      bslots))])]
            [_ false])])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            abase
            afunc
            aargs
            aslots)
          (match b
            [(CompilerIrInstr.CallIndirectCAbiStoreResult other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
                    bbase
                    bfunc
                    bargs
                    bslots)
                  (and
                    (opt-value-eq abase bbase)
                    (opt-value-eq afunc bfunc)
                    (opt-call-args-eq aargs bargs)
                    (opt-c-abi-return-slot-list-eq
                      type-segment-bases
                      aslots
                      bslots))])]
            [_ false])])]
    [(CompilerIrInstr.SpmdCall _) false]
    [(CompilerIrInstr.TailCall aname aargs aty)
      (match b
        [(CompilerIrInstr.TailCall bname bargs bty)
          (and
            (compiler-ir-symbol-eq? aname bname)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.TailCallIndirect afunc aargs aty)
      (match b
        [(CompilerIrInstr.TailCallIndirect bfunc bargs bty)
          (and
            (opt-value-eq afunc bfunc)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.Store aname av aty)
      (match b
        [(CompilerIrInstr.Store bname bv bty)
          (and
            (compiler-ir-symbol-eq? aname bname)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.BoundsCheck aindex alength alabel)
      (match b
        [(CompilerIrInstr.BoundsCheck bindex blength blabel)
          (and
            (opt-value-eq aindex bindex)
            (opt-value-eq alength blength)
            (= alabel blabel))]
        [_ false])]
    [(CompilerIrInstr.Jump alabel)
      (match b
        [(CompilerIrInstr.Jump blabel) (= alabel blabel)]
        [_ false])]
    [(CompilerIrInstr.Branch av at bt)
      (match b
        [(CompilerIrInstr.Branch bv af bf)
          (and (= at af) (= bt bf) (opt-value-eq av bv))]
        [_ false])]
    [(CompilerIrInstr.Return av)
      (match b
        [(CompilerIrInstr.Return bv) (opt-maybe-value-eq av bv)]
        [_ false])]
    [(CompilerIrInstr.Phi ad ainputs aty)
      (match b
        [(CompilerIrInstr.Phi bd binputs bty)
          (and
            (= ad bd)
            (opt-phi-input-list-eq ainputs binputs)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.Pack ad awords aty)
      (match b
        [(CompilerIrInstr.Pack bd bwords bty)
          (and
            (= ad bd)
            (opt-value-list-eq awords bwords)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.Word ad asrc ai aty)
      (match b
        [(CompilerIrInstr.Word bd bsrc bi bty)
          (and
            (= ad bd)
            (opt-value-eq asrc bsrc)
            (= ai bi)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(CompilerIrInstr.Switch av abase acases adefault)
      (match b
        [(CompilerIrInstr.Switch bv bbase bcases bdefault)
          (and
            (opt-value-eq av bv)
            (= abase bbase)
            (opt-switch-case-list-eq acases bcases)
            (= adefault bdefault))]
        [_ false])]))

(define (opt-instr-list-eq
  [type-segment-bases : i64]
  [a : CompilerIrInstrList]
  [b : CompilerIrInstrList]) : bool
  (match a
    [(CompilerIrInstrList.Nil)
      (match b
        [(CompilerIrInstrList.Nil) true]
        [_ false])]
    [(CompilerIrInstrList.Cons ah at)
      (match b
        [(CompilerIrInstrList.Cons bh bt)
          (and
            (opt-instr-eq type-segment-bases ah bh)
            (opt-instr-list-eq type-segment-bases (box-get at) (box-get bt)))]
        [_ false])]))

(define (opt-instr-seq-eq-from
  [type-segment-bases : i64]
  [a : CompilerIrInstrSeq]
  [b : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : bool
  (let
    [cursor : i64 index]
    (begin
      (while (< cursor count)
        (if (opt-instr-eq
          type-segment-bases
          (compiler-ir-instr-seq-ref a cursor)
          (compiler-ir-instr-seq-ref b cursor))
          (set! cursor (+ cursor 1))
          (return false)))
      true)))

(define (opt-instr-seq-eq
  [type-segment-bases : i64]
  [a : CompilerIrInstrSeq]
  [b : CompilerIrInstrSeq]) : bool
  (let
    [acount : i64 (compiler-ir-instr-seq-count a)]
    [bcount : i64 (compiler-ir-instr-seq-count b)]
    (and
      (= acount bcount)
      (opt-instr-seq-eq-from type-segment-bases a b 0 acount))))

(define (opt-block-eq
  [type-segment-bases : i64]
  [a : CompilerIrBlock]
  [b : CompilerIrBlock]) : bool
  (match a
    [(CompilerIrBlock.Block alabel ainstrs)
      (match b
        [(CompilerIrBlock.Block blabel binstrs)
          (and
            (= alabel blabel)
            (opt-instr-seq-eq type-segment-bases ainstrs binstrs))])]))

(define (opt-block-list-eq
  [type-segment-bases : i64]
  [a : CompilerIrBlockList]
  [b : CompilerIrBlockList]) : bool
  (match a
    [(CompilerIrBlockList.Nil)
      (match b
        [(CompilerIrBlockList.Nil) true]
        [_ false])]
    [(CompilerIrBlockList.Cons ah at)
      (match b
        [(CompilerIrBlockList.Cons bh bt)
          (and
            (opt-block-eq type-segment-bases ah bh)
            (opt-block-list-eq type-segment-bases (box-get at) (box-get bt)))]
        [(CompilerIrBlockList.Array seq)
          (opt-block-list-eq
            type-segment-bases
            a
            (compiler-ir-block-seq-to-list seq))]
        [_ false])]
    [(CompilerIrBlockList.Array seq)
      (opt-block-list-eq
        type-segment-bases
        (compiler-ir-block-seq-to-list seq)
        b)]))

(define (opt-param-eq
  [type-segment-bases : i64]
  [a : CompilerIrParam]
  [b : CompilerIrParam]) : bool
  (match a
    [(CompilerIrParam.Param aname aty aid)
      (match b
        [(CompilerIrParam.Param bname bty bid)
          (and
            (string.eq aname bname)
            (= aid bid)
            (opt-type-eq type-segment-bases aty bty))])]))

(define (opt-param-list-eq
  [type-segment-bases : i64]
  [a : CompilerIrParamList]
  [b : CompilerIrParamList]) : bool
  (match a
    [(CompilerIrParamList.Nil)
      (match b
        [(CompilerIrParamList.Nil) true]
        [(CompilerIrParamList.Array seq)
          (opt-param-list-eq
            type-segment-bases
            a
            (compiler-ir-param-seq-to-list seq))]
        [_ false])]
    [(CompilerIrParamList.Cons ah at)
      (match b
        [(CompilerIrParamList.Cons bh bt)
          (and
            (opt-param-eq type-segment-bases ah bh)
            (opt-param-list-eq type-segment-bases (box-get at) (box-get bt)))]
        [(CompilerIrParamList.Array seq)
          (opt-param-list-eq
            type-segment-bases
            a
            (compiler-ir-param-seq-to-list seq))]
        [_ false])]
    [(CompilerIrParamList.Array seq)
      (opt-param-list-eq
        type-segment-bases
        (compiler-ir-param-seq-to-list seq)
        b)]))

(define (opt-function-eq
  [type-segment-bases : i64]
  [a : CompilerIrFunction]
  [b : CompilerIrFunction]) : bool
  (match a
    [(CompilerIrFunction.Function aname aparams aret aframe ablocks)
      (match b
        [(CompilerIrFunction.Function bname bparams bret bframe bblocks)
          (and
            (compiler-ir-symbol-eq? aname bname)
            (= aframe bframe)
            (opt-param-list-eq type-segment-bases aparams bparams)
            (opt-type-eq type-segment-bases aret bret)
            (opt-block-list-eq type-segment-bases ablocks bblocks))])]))

(define (opt-function-list-eq
  [type-segment-bases : i64]
  [a : CompilerIrFunctionList]
  [b : CompilerIrFunctionList]) : bool
  (match a
    [(CompilerIrFunctionList.Nil)
      (match b
        [(CompilerIrFunctionList.Nil) true]
        [_ false])]
    [(CompilerIrFunctionList.Cons ah at)
      (match b
        [(CompilerIrFunctionList.Cons bh bt)
          (and
            (opt-function-eq type-segment-bases ah bh)
            (opt-function-list-eq type-segment-bases (box-get at) (box-get bt)))]
        [(CompilerIrFunctionList.Array bseq)
          (opt-function-list-eq
            type-segment-bases
            a
            (compiler-ir-function-seq-to-list bseq))]
        [_ false])]
    [(CompilerIrFunctionList.Array aseq)
      (opt-function-list-eq
        type-segment-bases
        (compiler-ir-function-seq-to-list aseq)
        b)]))

(define (opt-global-eq
  [type-segment-bases : i64]
  [a : CompilerIrGlobal]
  [b : CompilerIrGlobal]) : bool
  (match a
    [(CompilerIrGlobal.Global aname aty avalue)
      (match b
        [(CompilerIrGlobal.Global bname bty bvalue)
          (and
            (compiler-ir-symbol-eq? aname bname)
            (opt-type-eq type-segment-bases aty bty)
            (opt-value-eq avalue bvalue))])]))

(define (opt-global-list-eq
  [type-segment-bases : i64]
  [a : CompilerIrGlobalList]
  [b : CompilerIrGlobalList]) : bool
  (match a
    [(CompilerIrGlobalList.Nil)
      (match b
        [(CompilerIrGlobalList.Nil) true]
        [(CompilerIrGlobalList.Array bseq)
          (opt-global-list-eq
            type-segment-bases
            CompilerIrGlobalList.Nil
            (compiler-ir-global-seq-to-list bseq))]
        [_ false])]
    [(CompilerIrGlobalList.Cons ah at)
      (match b
        [(CompilerIrGlobalList.Cons bh bt)
          (and
            (opt-global-eq type-segment-bases ah bh)
            (opt-global-list-eq type-segment-bases (box-get at) (box-get bt)))]
        [(CompilerIrGlobalList.Array bseq)
          (opt-global-list-eq
            type-segment-bases
            a
            (compiler-ir-global-seq-to-list bseq))]
        [_ false])]
    [(CompilerIrGlobalList.Array aseq)
      (opt-global-list-eq
        type-segment-bases
        (compiler-ir-global-seq-to-list aseq)
        b)]))

(define (opt-extern-eq
  [type-segment-bases : i64]
  [a : CompilerIrExtern]
  [b : CompilerIrExtern]) : bool
  (match a
    [(CompilerIrExtern.Extern
        aid
        asource
        aname
        aty
        aabi
        asymbol
        alinks
        aprovided)
      (match b
        [(CompilerIrExtern.Extern
            bid
            bsource
            bname
            bty
            babi
            bsymbol
            blinks
            bprovided)
          (and
            (= aid bid)
            (= asource bsource)
            (string.eq aname bname)
            (opt-type-eq type-segment-bases aty bty)
            (ast-extern-abi-eq? aabi babi)
            (= asymbol bsymbol)
            (ast-extern-link-input-list-eq? alinks blinks)
            (= aprovided bprovided))])]))

(define (opt-extern-list-eq
  [type-segment-bases : i64]
  [a : CompilerIrExternList]
  [b : CompilerIrExternList]) : bool
  (match a
    [(CompilerIrExternList.Nil)
      (match b
        [(CompilerIrExternList.Nil) true]
        [(CompilerIrExternList.Array bseq)
          (opt-extern-list-eq
            type-segment-bases
            CompilerIrExternList.Nil
            (compiler-ir-extern-seq-to-list bseq))]
        [_ false])]
    [(CompilerIrExternList.Cons ah at)
      (match b
        [(CompilerIrExternList.Cons bh bt)
          (and
            (opt-extern-eq type-segment-bases ah bh)
            (opt-extern-list-eq type-segment-bases (box-get at) (box-get bt)))]
        [(CompilerIrExternList.Array bseq)
          (opt-extern-list-eq
            type-segment-bases
            a
            (compiler-ir-extern-seq-to-list bseq))]
        [_ false])]
    [(CompilerIrExternList.Array aseq)
      (opt-extern-list-eq
        type-segment-bases
        (compiler-ir-extern-seq-to-list aseq)
        b)]))

(define (opt-program-eq
  [type-segment-bases : i64]
  [a : CompilerIrProgram]
  [b : CompilerIrProgram]) : bool
  (match a
    [(CompilerIrProgram.Program aglobals afunctions aexterns)
      (match b
        [(CompilerIrProgram.Program bglobals bfunctions bexterns)
          (and
            (opt-global-list-eq type-segment-bases aglobals bglobals)
            (opt-function-list-eq type-segment-bases afunctions bfunctions)
            (opt-extern-list-eq type-segment-bases aexterns bexterns))])]))

(define (opt-expr-key-eq
  [type-segment-bases : i64]
  [a : OptExprKey]
  [b : OptExprKey]) : bool
  (match a
    [(OptExprKey.BinKey opa la ra ta)
      (match b
        [(OptExprKey.BinKey opb lb rb tb)
          (and
            (opt-binop-eq opa opb)
            (opt-type-eq type-segment-bases ta tb)
            (opt-value-eq la lb)
            (opt-value-eq ra rb))]
        [_ false])]
    [(OptExprKey.UnKey opa va ta)
      (match b
        [(OptExprKey.UnKey opb vb tb)
          (and
            (opt-unop-eq opa opb)
            (opt-type-eq type-segment-bases ta tb)
            (opt-value-eq va vb))]
        [_ false])]
    [(OptExprKey.CpuIdKey aleaf asubleaf areg)
      (match b
        [(OptExprKey.CpuIdKey bleaf bsubleaf breg)
          (and
            (= areg breg)
            (opt-value-eq aleaf bleaf)
            (opt-value-eq asubleaf bsubleaf))]
        [_ false])]
    [(OptExprKey.XgetbvKey aindex)
      (match b
        [(OptExprKey.XgetbvKey bindex) (opt-value-eq aindex bindex)]
        [_ false])]))

(define (opt-expr-lookup
  [type-segment-bases : i64]
  [table : OptExprTable]
  [key : OptExprKey]) : CompilerIrMaybeValue
  (match table
    [(OptExprTable.Nil) (CompilerIrMaybeValue.No)]
    [(OptExprTable.Cons k var rest)
      (let
        [rest : OptExprTable (box-get rest)]
        (if (opt-expr-key-eq type-segment-bases k key)
          (CompilerIrMaybeValue.Some (CompilerIrValue.Var var))
          (opt-expr-lookup type-segment-bases rest key)))]))

(define (opt-value-is-var? [value : CompilerIrValue] [var : i64]) : bool
  (match value
    [(CompilerIrValue.Var id) (= id var)]
    [_ false]))

(define (opt-key-uses-var? [key : OptExprKey] [var : i64]) : bool
  (match key
    [(OptExprKey.BinKey _ l r _)
      (or (opt-value-is-var? l var) (opt-value-is-var? r var))]
    [(OptExprKey.UnKey _ v _) (opt-value-is-var? v var)]
    [(OptExprKey.CpuIdKey leaf subleaf _)
      (or (opt-value-is-var? leaf var) (opt-value-is-var? subleaf var))]
    [(OptExprKey.XgetbvKey index) (opt-value-is-var? index var)]))

;; Drop every entry whose key references `var` (a stale operand) or whose result
;; is `var` (a stale definition).
(define (opt-expr-invalidate-var [table : OptExprTable] [var : i64]) : OptExprTable
  (match table
    [(OptExprTable.Nil) (OptExprTable.Nil)]
    [(OptExprTable.Cons k v rest)
      (let
        [rest2 : OptExprTable (opt-expr-invalidate-var (box-get rest) var)]
        (if (or (opt-key-uses-var? k var) (= v var))
          rest2
          (OptExprTable.Cons k v (box rest2))))]))

(defenum OptCseResult
  (Result OptExprTable CompilerIrInstr))

(define (opt-cse-instr
  [type-segment-bases : i64]
  [table : OptExprTable]
  [instr : CompilerIrInstr]) : OptCseResult
  (match instr
    [(CompilerIrInstr.BinOp dst op l r ty)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptExprKey.BinKey op l r ty)]
        (match (opt-expr-lookup type-segment-bases t1 key)
          [(CompilerIrMaybeValue.Some earlier)
            (OptCseResult.Result
              t1
              (CompilerIrInstr.Mov
                dst
                earlier
                (compiler-ir-binop-result-type op ty)))]
          [(CompilerIrMaybeValue.No)
            (OptCseResult.Result (OptExprTable.Cons key dst (box t1)) instr)]))]
    [(CompilerIrInstr.UnOp dst op v ty)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptExprKey.UnKey op v ty)]
        (match (opt-expr-lookup type-segment-bases t1 key)
          [(CompilerIrMaybeValue.Some earlier)
            (OptCseResult.Result t1 (CompilerIrInstr.Mov dst earlier ty))]
          [(CompilerIrMaybeValue.No)
            (OptCseResult.Result (OptExprTable.Cons key dst (box t1)) instr)]))]
    [(CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptExprKey.CpuIdKey leaf subleaf reg-index)]
        (match (opt-expr-lookup type-segment-bases t1 key)
          [(CompilerIrMaybeValue.Some earlier)
            (OptCseResult.Result
              t1
              (CompilerIrInstr.Mov dst earlier (AstType.I64)))]
          [(CompilerIrMaybeValue.No)
            (OptCseResult.Result (OptExprTable.Cons key dst (box t1)) instr)]))]
    [(CompilerIrInstr.Xgetbv dst index)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptExprKey.XgetbvKey index)]
        (match (opt-expr-lookup type-segment-bases t1 key)
          [(CompilerIrMaybeValue.Some earlier)
            (OptCseResult.Result
              t1
              (CompilerIrInstr.Mov dst earlier (AstType.I64)))]
          [(CompilerIrMaybeValue.No)
            (OptCseResult.Result (OptExprTable.Cons key dst (box t1)) instr)]))]
    ;; Other defining instructions: invalidate their dst, keep the instruction.
    [(CompilerIrInstr.Mov dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Alloc dst _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.AddrOf dst _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Gep dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Load dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Cast dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Bitcast dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Phi dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.LaneId dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Splat dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.MaskNot dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.MaskReduce dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)])]
    [(CompilerIrInstr.TailMask dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.EntryArgc dst)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.EntryArgv dst)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.EntryEnvp dst)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    ;; Calls, stores, and control flow clear all available expressions.
    [(CompilerIrInstr.Syscall _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.Call _ _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.CallIndirect _ _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.CallIndirectC _ _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ _ _ _)
          (OptCseResult.Result (OptExprTable.Nil) instr)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload _ _ _ _)
          (OptCseResult.Result (OptExprTable.Nil) instr)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ _)
          (OptCseResult.Result (OptExprTable.Nil) instr)])]
    [(CompilerIrInstr.VectorShuffle _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.TailCall _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.Store _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.StorePtr _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.CopyBytes _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload _ _ _ _ _)
          (OptCseResult.Result (OptExprTable.Nil) instr)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload _ _ _ _ _ _)
          (OptCseResult.Result (OptExprTable.Nil) instr)])]
    [(CompilerIrInstr.BoundsCheck _ _ _) (OptCseResult.Result table instr)]
    [(CompilerIrInstr.Jump _) (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.Branch _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.Return _) (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(CompilerIrInstr.TailCallIndirect _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    ;; Register-group ops are plain defining instructions -- invalidate
    ;; their dst, keep the instruction (no CSE key for them).
    [(CompilerIrInstr.Pack dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Word dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(CompilerIrInstr.Switch _ _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]))

(define (opt-cse-instrs
  [type-segment-bases : i64]
  [table : OptExprTable]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (match (opt-cse-instr type-segment-bases table instr)
        [(OptCseResult.Result new-table new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-cse-instrs type-segment-bases new-table (box-get rest)))])]))

;; --- block-local copy propagation -------------------------------------------
;;
;; The lowerer and the CSE pass both materialize values through `CompilerIrInstr.Mov`
;; into fresh vars (CSE rewrites a redundant expression to `Mov dst earlier`).
;; Within a single basic block, track copies `dst -> source` and rewrite later
;; operand uses of `CompilerIrValue.Var dst` to `source`, so DCE can then drop the now
;; unused copy. This needs no register allocation or CFG dataflow.
;;
;; Conservative for the first slice: only `CompilerIrValue.Var` and unambiguous scalar
;; literals are recorded as copy sources (`CompilerIrValue.F64`, `CompilerIrValue.String`, and
;; globals are excluded until their backend paths are settled); `CompilerIrInstr.Phi`
;; inputs belong to predecessor edges and are never rewritten; and `CompilerIrInstr.AddrOf`
;; carries a raw var id (a storage slot), not a value operand, so it is left
;; alone. On any instruction that defines var `v`, both the mapping for `v` and
;; any mapping whose source is `CompilerIrValue.Var v` are dropped, so a reused var id in
;; the non-SSA IR never triggers a stale rewrite.
(defenum OptCopyEnv
  (Nil)
  (Cons i64 CompilerIrValue (Box OptCopyEnv))
  (PackWordCons i64 i64 CompilerIrValue (Box OptCopyEnv)))

(define (opt-copy-lookup [env : OptCopyEnv] [var : i64]) : CompilerIrMaybeValue
  (match env
    [(OptCopyEnv.Nil) (CompilerIrMaybeValue.No)]
    [(OptCopyEnv.Cons id value rest)
      (let
        [rest : OptCopyEnv (box-get rest)]
        (if (= id var)
          (CompilerIrMaybeValue.Some value)
          (opt-copy-lookup rest var)))]
    [(OptCopyEnv.PackWordCons _ _ _ rest) (opt-copy-lookup (box-get rest) var)]))

(define (opt-copy-pack-word-lookup
  [env : OptCopyEnv]
  [group : i64]
  [index : i64]) : CompilerIrMaybeValue
  (match env
    [(OptCopyEnv.Nil) (CompilerIrMaybeValue.No)]
    [(OptCopyEnv.Cons _ _ rest)
      (opt-copy-pack-word-lookup (box-get rest) group index)]
    [(OptCopyEnv.PackWordCons found-group found-index value rest)
      (if (and (= found-group group) (= found-index index))
        (CompilerIrMaybeValue.Some value)
        (opt-copy-pack-word-lookup (box-get rest) group index))]))

;; Drop the mapping for `var` and any mapping whose replacement is `CompilerIrValue.Var
;; var`, so redefining either a copied destination or a copied source clears the
;; stale copy fact.
(define (opt-copy-invalidate-var [env : OptCopyEnv] [var : i64]) : OptCopyEnv
  (match env
    [(OptCopyEnv.Nil) (OptCopyEnv.Nil)]
    [(OptCopyEnv.Cons id value rest)
      (let
        [rest2 : OptCopyEnv (opt-copy-invalidate-var (box-get rest) var)]
        (if (or (= id var) (opt-value-is-var? value var))
          rest2
          (OptCopyEnv.Cons id value (box rest2))))]
    [(OptCopyEnv.PackWordCons group index value rest)
      (let
        [rest2 : OptCopyEnv (opt-copy-invalidate-var (box-get rest) var)]
        (if (or (= group var) (opt-value-is-var? value var))
          rest2
          (OptCopyEnv.PackWordCons group index value (box rest2))))]))

;; Only var copies and unambiguous scalar literals are safe to propagate in this
;; slice; F64/String/global sources stay put until their backend paths exist.
(define (opt-copy-safe-source? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var _) true]
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.Bool _) true]
    [(CompilerIrValue.Char _) true]
    [(CompilerIrValue.Unit) true]
    [(CompilerIrValue.F64 _) false]
    [(CompilerIrValue.String _) false]
    [(CompilerIrValue.Bytes _) false]
    [(CompilerIrValue.Global _) false]
    [(CompilerIrValue.GlobalAddr _) false]
    [(CompilerIrValue.Function _) false]
    [(CompilerIrValue.RuntimeGlobal _) false]))

(define (opt-copy-add-pack-word
  [env : OptCopyEnv]
  [group : i64]
  [index : i64]
  [value : CompilerIrValue]) : OptCopyEnv
  (if (and (opt-copy-safe-source? value) (not (opt-value-is-var? value group)))
    (OptCopyEnv.PackWordCons group index value (box env))
    env))

(define (opt-copy-add-pack-words-from
  [env : OptCopyEnv]
  [group : i64]
  [index : i64]
  [words : CompilerIrValueList]) : OptCopyEnv
  (match words
    [(CompilerIrValueList.Nil) env]
    [(CompilerIrValueList.Array seq)
      (opt-copy-add-pack-words-from
        env
        group
        index
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (opt-copy-add-pack-words-from
        (opt-copy-add-pack-word env group index value)
        group
        (+ index 1)
        (box-get rest))]))

(define (opt-copy-update-pack-env
  [env : OptCopyEnv]
  [dst : i64]
  [words : CompilerIrValueList]) : OptCopyEnv
  (opt-copy-add-pack-words-from (opt-copy-invalidate-var env dst) dst 0 words))

(define (opt-copy-mask-source? [value : CompilerIrValue] [dst : i64]) : bool
  (match value
    [(CompilerIrValue.Var _) (not (opt-value-is-var? value dst))]
    [_ false]))

(define (opt-copy-resolve [env : OptCopyEnv] [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var id)
      (match (opt-copy-lookup env id)
        [(CompilerIrMaybeValue.Some v) v]
        [(CompilerIrMaybeValue.No) value])]
    [_ value]))

(define (opt-copy-resolve-mask [env : OptCopyEnv] [value : CompilerIrValue]) : CompilerIrValue
  (let
    [resolved : CompilerIrValue (opt-copy-resolve env value)]
    (match resolved
      [(CompilerIrValue.Var _) resolved]
      [_ value])))

(define (opt-copy-subst-value-list
  [env : OptCopyEnv]
  [values : CompilerIrValueList]) : CompilerIrValueList
  (match values
    [(CompilerIrValueList.Nil) (CompilerIrValueList.Nil)]
    [(CompilerIrValueList.Array seq)
      (opt-copy-subst-value-list env (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (compiler-ir-value-cons
        (opt-copy-resolve env value)
        (opt-copy-subst-value-list env (box-get rest)))]))

(define (opt-copy-subst-call-args-array
  [env : OptCopyEnv]
  [src : (Array CompilerIrValue)]
  [dst : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set! dst index (opt-copy-resolve env (array-ref src index)))
      (opt-copy-subst-call-args-array env src dst (+ index 1)))))

(define (opt-copy-subst-call-args
  [env : OptCopyEnv]
  [args : CompilerIrCallArgs]) : CompilerIrCallArgs
  (match args
    [(CompilerIrCallArgs.Nil) (CompilerIrCallArgs.Nil)]
    [(CompilerIrCallArgs.One value)
      (CompilerIrCallArgs.One (opt-copy-resolve env value))]
    [(CompilerIrCallArgs.Two a b)
      (CompilerIrCallArgs.Two (opt-copy-resolve env a) (opt-copy-resolve env b))]
    [(CompilerIrCallArgs.Array values)
      (let
        [out : (Array CompilerIrValue)
          (array.make-array CompilerIrValue (array-length values))]
        (begin
          (opt-copy-subst-call-args-array env values out 0)
          (CompilerIrCallArgs.Array out)))]))

(define (opt-copy-resolve-spmd-value
  [env : OptCopyEnv]
  [class : CompilerIrSpmdValueClass]
  [value : CompilerIrValue]) : CompilerIrValue
  (match class
    [(CompilerIrSpmdValueClass.Uniform) (opt-copy-resolve env value)]
    [(CompilerIrSpmdValueClass.Varying) (opt-copy-resolve-mask env value)]
    [(CompilerIrSpmdValueClass.Mask) (opt-copy-resolve-mask env value)]))

(define (opt-copy-subst-spmd-call-arg
  [env : OptCopyEnv]
  [arg : CompilerIrSpmdCallArg]) : CompilerIrSpmdCallArg
  (match arg
    [(CompilerIrSpmdCallArg.Arg class value ty)
      (CompilerIrSpmdCallArg.Arg
        class
        (opt-copy-resolve-spmd-value env class value)
        ty)]))

(define (opt-copy-subst-spmd-call-args-array
  [env : OptCopyEnv]
  [src : (Array CompilerIrSpmdCallArg)]
  [dst : (Array CompilerIrSpmdCallArg)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set!
        dst
        index
        (opt-copy-subst-spmd-call-arg env (array-ref src index)))
      (opt-copy-subst-spmd-call-args-array env src dst (+ index 1)))))

(define (opt-copy-subst-spmd-call-args
  [env : OptCopyEnv]
  [args : CompilerIrSpmdCallArgList]) : CompilerIrSpmdCallArgList
  (match args
    [(CompilerIrSpmdCallArgList.Nil) CompilerIrSpmdCallArgList.Nil]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (CompilerIrSpmdCallArgList.Cons
        (opt-copy-subst-spmd-call-arg env arg)
        (box (opt-copy-subst-spmd-call-args env (box-get rest))))]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 (struct-get seq len)]
        [src : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        [out : (Array CompilerIrSpmdCallArg)
          (array.make-array CompilerIrSpmdCallArg count)]
        (begin
          (opt-copy-subst-spmd-call-args-array env src out 0)
          (CompilerIrSpmdCallArgList.Array (CompilerIrSpmdCallArgSeq out count))))]))

;; Rewrite the value-use operands of an instruction through the copy env. Phi
;; inputs and the raw var id of `CompilerIrInstr.AddrOf` are intentionally not rewritten.
(define (opt-copy-subst-instr [env : OptCopyEnv] [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (CompilerIrInstr.Mov dst (opt-copy-resolve env src) ty)]
    [(CompilerIrInstr.Gep dst base offset ty)
      (CompilerIrInstr.Gep
        dst
        (opt-copy-resolve env base)
        (opt-copy-resolve env offset)
        ty)]
    [(CompilerIrInstr.Load dst src ty)
      (CompilerIrInstr.Load dst (opt-copy-resolve env src) ty)]
    [(CompilerIrInstr.StorePtr ptr value ty)
      (CompilerIrInstr.StorePtr
        (opt-copy-resolve env ptr)
        (opt-copy-resolve env value)
        ty)]
    [(CompilerIrInstr.CopyBytes dst src size)
      (CompilerIrInstr.CopyBytes
        (opt-copy-resolve env dst)
        (opt-copy-resolve env src)
        size)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (CompilerIrInstr.Cast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (CompilerIrInstr.Bitcast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(CompilerIrInstr.BinOp dst op l r ty)
      (CompilerIrInstr.BinOp
        dst
        op
        (opt-copy-resolve env l)
        (opt-copy-resolve env r)
        ty)]
    [(CompilerIrInstr.UnOp dst op v ty)
      (CompilerIrInstr.UnOp dst op (opt-copy-resolve env v) ty)]
    [(CompilerIrInstr.Splat dst value lanes ty)
      (CompilerIrInstr.Splat dst (opt-copy-resolve env value) lanes ty)]
    ;; Vector IR uses private aggregate values that the scalar copy pass cannot
    ;; type-check yet, so leave those operands untouched until a vector-aware
    ;; propagation pass exists. Mask operands are private too, so only var-to-var
    ;; mask copies are substituted; scalar bool literals are not mask constants.
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.VectorReduce _ _ _ _ _) instr]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-copy-resolve-mask env lhs)
        (opt-copy-resolve-mask env rhs)
        lanes)]
    [(CompilerIrInstr.MaskNot dst src lanes)
      (CompilerIrInstr.MaskNot dst (opt-copy-resolve-mask env src) lanes)]
    [(CompilerIrInstr.MaskReduce dst op src lanes)
      (CompilerIrInstr.MaskReduce dst op (opt-copy-resolve-mask env src) lanes)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.VectorLoad _ _ _ _ _) instr]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload _ _ _ _ _) instr])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.GatherLoad _) instr]
    [(CompilerIrInstr.VectorShuffle _) instr]
    [(CompilerIrInstr.TailMask _ _ _ _) instr]
    [(CompilerIrInstr.EntryArgc _) instr]
    [(CompilerIrInstr.EntryArgv _) instr]
    [(CompilerIrInstr.EntryEnvp _) instr]
    [(CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (CompilerIrInstr.CpuId
        dst
        (opt-copy-resolve env leaf)
        (opt-copy-resolve env subleaf)
        reg-index)]
    [(CompilerIrInstr.Xgetbv dst index)
      (CompilerIrInstr.Xgetbv dst (opt-copy-resolve env index))]
    [(CompilerIrInstr.Syscall dst args)
      (CompilerIrInstr.Syscall dst (opt-copy-subst-call-args env args))]
    [(CompilerIrInstr.Call dst name args ty)
      (CompilerIrInstr.Call dst name (opt-copy-subst-call-args env args) ty)]
    [(CompilerIrInstr.CallIndirect dst func args ty)
      (CompilerIrInstr.CallIndirect
        dst
        (opt-copy-resolve env func)
        (opt-copy-subst-call-args env args)
        ty)]
    [(CompilerIrInstr.CallIndirectC dst func args ty)
      (CompilerIrInstr.CallIndirectC
        dst
        (opt-copy-resolve env func)
        (opt-copy-subst-call-args env args)
        ty)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload
            base
            name
            args
            slots)
          (ir-instr-call-cabi-store-result
            (opt-copy-resolve env base)
            name
            (opt-copy-subst-call-args env args)
            slots)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            slots)
          (ir-instr-call-indirect-cabi-store-result
            (opt-copy-resolve env base)
            (opt-copy-resolve env func)
            (opt-copy-subst-call-args env args)
            slots)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload
            callee
            backend
            lanes
            active-mask
            args
            result)
          (ir-instr-spmd-call
            callee
            backend
            lanes
            (opt-copy-resolve-mask env active-mask)
            (opt-copy-subst-spmd-call-args env args)
            result)])]
    [(CompilerIrInstr.TailCall name args ty)
      (CompilerIrInstr.TailCall name (opt-copy-subst-call-args env args) ty)]
    [(CompilerIrInstr.Store name value ty)
      (CompilerIrInstr.Store name (opt-copy-resolve env value) ty)]
    [(CompilerIrInstr.BoundsCheck index length ok-label)
      (CompilerIrInstr.BoundsCheck
        (opt-copy-resolve env index)
        (opt-copy-resolve env length)
        ok-label)]
    [(CompilerIrInstr.Branch cond a b)
      (CompilerIrInstr.Branch (opt-copy-resolve env cond) a b)]
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.Some value)
          (CompilerIrInstr.Return
            (CompilerIrMaybeValue.Some (opt-copy-resolve env value)))]
        [(CompilerIrMaybeValue.No) instr])]
    ;; `CompilerIrInstr.AddrOf` takes the address of a storage slot named by a raw var id,
    ;; not a value, so its operand must not be copy-substituted.
    [(CompilerIrInstr.AddrOf _ _) instr]
    ;; `CompilerIrInstr.Alloc`/`CompilerIrInstr.Jump` have no value operands; `CompilerIrInstr.Phi` inputs
    ;; belong to predecessor edges and are not block-local copies.
    [(CompilerIrInstr.Alloc _ _) instr]
    [(CompilerIrInstr.LaneId _ _ _) instr]
    [(CompilerIrInstr.Jump _) instr]
    [(CompilerIrInstr.Phi _ _ _) instr]
    ;; Register-group ops carry value operands -- substitute copies into
    ;; the packed words / the extracted source group.
    [(CompilerIrInstr.Pack dst words ty)
      (CompilerIrInstr.Pack dst (opt-copy-subst-value-list env words) ty)]
    [(CompilerIrInstr.Word dst src index ty)
      (let
        [resolved-src : CompilerIrValue (opt-copy-resolve env src)]
        (match resolved-src
          [(CompilerIrValue.Var group)
            (match (opt-copy-pack-word-lookup env group index)
              [(CompilerIrMaybeValue.Some word)
                (CompilerIrInstr.Mov dst (opt-copy-resolve env word) ty)]
              [(CompilerIrMaybeValue.No)
                (CompilerIrInstr.Word dst resolved-src index ty)])]
          [_ (CompilerIrInstr.Word dst resolved-src index ty)]))]
    [(CompilerIrInstr.TailCallIndirect func args ty)
      (CompilerIrInstr.TailCallIndirect
        (opt-copy-resolve env func)
        (opt-copy-subst-call-args env args)
        ty)]
    [(CompilerIrInstr.Switch index base cases default-label)
      (CompilerIrInstr.Switch
        (opt-copy-resolve env index)
        base
        cases
        default-label)]))

;; Update the copy env after an instruction. A `Mov dst src` (with `src` already
;; substituted) records a copy when `src` is a safe, non-self source. Every other
;; defining instruction invalidates its destination. Stores and terminators
;; define no var, so the copy facts are unaffected (the env resets per block).
(define (opt-copy-update-env [env : OptCopyEnv] [instr : CompilerIrInstr]) : OptCopyEnv
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (let
        [e1 : OptCopyEnv (opt-copy-invalidate-var env dst)]
        (if (and (opt-copy-safe-source? src) (not (opt-value-is-var? src dst)))
          (OptCopyEnv.Cons dst src (box e1))
          e1))]
    [(CompilerIrInstr.Alloc dst _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.AddrOf dst src)
      (opt-copy-invalidate-var (opt-copy-invalidate-var env dst) src)]
    [(CompilerIrInstr.Gep dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.Load dst _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.Cast dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.Bitcast dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.BinOp dst _ _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.UnOp dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.LaneId dst _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.Splat dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(CompilerIrInstr.MaskBinOp dst _ lhs rhs _)
      (let
        [e1 : OptCopyEnv (opt-copy-invalidate-var env dst)]
        (if (and (opt-value-eq lhs rhs) (opt-copy-mask-source? lhs dst))
          (OptCopyEnv.Cons dst lhs (box e1))
          e1))]
    [(CompilerIrInstr.MaskNot dst _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.MaskReduce dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(CompilerIrInstr.TailMask dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.EntryArgc dst) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.EntryArgv dst) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.EntryEnvp dst) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.CpuId dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.Xgetbv dst _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.Syscall dst _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.Call dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.CallIndirect dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (match result
            [(CompilerIrSpmdCallResult.Unit) env]
            [(CompilerIrSpmdCallResult.Value dst _ _)
              (opt-copy-invalidate-var env dst)])])]
    [(CompilerIrInstr.Phi dst _ _) (opt-copy-invalidate-var env dst)]
    ;; Register-group ops define their dst -- drop any stale copy fact for
    ;; it (a reused var id must not trigger a later stale rewrite).
    [(CompilerIrInstr.Pack dst words _)
      (opt-copy-update-pack-env env dst words)]
    [(CompilerIrInstr.Word dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(CompilerIrInstr.StorePtr _ _ _) (OptCopyEnv.Nil)]
    [(CompilerIrInstr.CopyBytes _ _ _) (OptCopyEnv.Nil)]
    [_ env]))

(defenum OptCopyResult
  (Result OptCopyEnv CompilerIrInstr))

(define (opt-copy-instr [env : OptCopyEnv] [instr : CompilerIrInstr]) : OptCopyResult
  (let
    [rewritten : CompilerIrInstr (opt-copy-subst-instr env instr)]
    (OptCopyResult.Result (opt-copy-update-env env rewritten) rewritten)))

(define (opt-copy-instrs [env : OptCopyEnv] [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (match (opt-copy-instr env instr)
        [(OptCopyResult.Result new-env new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-copy-instrs new-env (box-get rest)))])]))

;; --- block-local redundant bounds-check elimination -------------------------
;;
;; `CompilerIrInstr.BoundsCheck index length ok-label` is a trapping side-effect: it must be kept
;; unless the same `(index, length)` pair has already been checked on every
;; preceding path within the same basic block. This pass is deliberately local.
;; It records successful checks after copy propagation has resolved operands,
;; invalidates facts when either operand var is redefined, and clears all facts
;; across calls, stores, control-flow boundaries, and phi boundaries.
(defenum OptBoundsFact
  (Fact CompilerIrValue CompilerIrValue))

(defenum OptBoundsFacts
  (Nil)
  (Cons OptBoundsFact (Box OptBoundsFacts)))

(defenum OptObjectLengthFact
  (None)
  (Known i64 i64))

(define (opt-bounds-length-uses-var? [length : CompilerIrValue] [var : i64]) : bool
  (match length
    [(CompilerIrValue.Var id)
      (if (< id 0)
        (= (- (- 0 id) 1) var)
        (= id var))]
    [_ false]))

(define (opt-object-length-lookup [fact : OptObjectLengthFact] [var : i64]) : option_i64.Option
  (match fact
    [(OptObjectLengthFact.Known fact-var object-var)
      (if (= fact-var var)
        (option_i64.Some object-var)
        (option_i64.None))]
    [(OptObjectLengthFact.None) (option_i64.None)]))

(define (opt-bounds-length-value
  [facts : OptObjectLengthFact]
  [length : CompilerIrValue]) : CompilerIrValue
  (match length
    [(CompilerIrValue.Var var)
      (match (opt-object-length-lookup facts var)
        [(option_i64.Some object-var)
          (CompilerIrValue.Var (- 0 (+ object-var 1)))]
        [(option_i64.None) length])]
    [_ length]))

(define (opt-bounds-fact-eq
  [fact : OptBoundsFact]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : bool
  (match fact
    [(OptBoundsFact.Fact fact-index fact-length)
      (and (opt-value-eq fact-index index) (opt-value-eq fact-length length))]))

(define (opt-bounds-contains
  [facts : OptBoundsFacts]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : bool
  (match facts
    [(OptBoundsFacts.Nil) false]
    [(OptBoundsFacts.Cons fact rest)
      (let
        [rest : OptBoundsFacts (box-get rest)]
        (if (opt-bounds-fact-eq fact index length)
          true
          (opt-bounds-contains rest index length)))]))

(define (opt-bounds-add
  [facts : OptBoundsFacts]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : OptBoundsFacts
  (if (opt-bounds-contains facts index length)
    facts
    (OptBoundsFacts.Cons (OptBoundsFact.Fact index length) (box facts))))

(define (opt-bounds-fact-uses-var? [fact : OptBoundsFact] [var : i64]) : bool
  (match fact
    [(OptBoundsFact.Fact index length)
      (or
        (opt-value-is-var? index var)
        (opt-bounds-length-uses-var? length var))]))

(define (opt-bounds-invalidate-var [facts : OptBoundsFacts] [var : i64]) : OptBoundsFacts
  (match facts
    [(OptBoundsFacts.Nil) (OptBoundsFacts.Nil)]
    [(OptBoundsFacts.Cons fact rest)
      (let
        [rest2 : OptBoundsFacts (opt-bounds-invalidate-var (box-get rest) var)]
        (if (opt-bounds-fact-uses-var? fact var)
          rest2
          (OptBoundsFacts.Cons fact (box rest2))))]))

;; Index canonicalization: an array index is lowered to a fresh
;; `Cast(idx, I64->U64)` per access (see `lower-array-element-addr`), so two
;; bounds checks on the *same* logical index (e.g. read-then-write `xs[i]` in a
;; swap) carry distinct cast vars and never match by `opt-value-eq`. The cast is
;; a bit-preserving reinterpret, so the unsigned bounds comparison is identical
;; and keying the fact on the pre-cast source value is sound. `OptBoundsCastEnv`
;; maps each `I64->U64` cast dst back to its source; entries are dropped when the
;; dst or the source var is redefined, and the whole env is cleared wherever the
;; bounds facts are (calls/stores/CF/phi), so it can never outlive a redefinition
;; of the source.
(defenum OptBoundsCastEnv
  (Nil)
  (Cons i64 CompilerIrValue (Box OptBoundsCastEnv)))

(define (opt-bounds-cast-unbind [env : OptBoundsCastEnv] [var : i64]) : OptBoundsCastEnv
  (match env
    [(OptBoundsCastEnv.Nil) (OptBoundsCastEnv.Nil)]
    [(OptBoundsCastEnv.Cons dst src rest)
      (let
        [tail : OptBoundsCastEnv (opt-bounds-cast-unbind (box-get rest) var)]
        (if (or (= dst var) (opt-value-is-var? src var))
          tail
          (OptBoundsCastEnv.Cons dst src (box tail))))]))

(define (opt-bounds-cast-bind
  [env : OptBoundsCastEnv]
  [dst : i64]
  [src : CompilerIrValue]) : OptBoundsCastEnv
  (OptBoundsCastEnv.Cons dst src (box (opt-bounds-cast-unbind env dst))))

;; Resolve `value` back through one `I64->U64` reinterpret cast, if recorded.
(define (opt-bounds-cast-canon
  [env : OptBoundsCastEnv]
  [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var var)
      (match env
        [(OptBoundsCastEnv.Nil) value]
        [(OptBoundsCastEnv.Cons dst src rest)
          (if (= dst var)
            src
            (opt-bounds-cast-canon (box-get rest) value))])]
    [_ value]))

;; Record an `I64->U64` reinterpret cast (the index/length unsigned-compare form)
;; so its dst canonicalizes to the source; other casts only invalidate the dst.
(define (opt-bounds-cast-update
  [type-segment-bases : i64]
  [env : OptBoundsCastEnv]
  [dst : i64]
  [src : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : OptBoundsCastEnv
  (if (and
    (opt-type-eq type-segment-bases from-ty (AstType.I64))
    (opt-type-eq type-segment-bases to-ty (AstType.U64)))
    (opt-bounds-cast-bind env dst src)
    (opt-bounds-cast-unbind env dst)))

(define (opt-object-length-invalidate-var
  [fact : OptObjectLengthFact]
  [var : i64]) : OptObjectLengthFact
  (match fact
    [(OptObjectLengthFact.Known length-var object-var)
      (if (or (= length-var var) (= object-var var))
        (OptObjectLengthFact.None)
        fact)]
    [(OptObjectLengthFact.None) fact]))

(define (opt-object-length-bind
  [_fact : OptObjectLengthFact]
  [length-var : i64]
  [object-var : i64]) : OptObjectLengthFact
  (OptObjectLengthFact.Known length-var object-var))

(define (opt-bounds-object-length-slot?
  [type-segment-bases : i64]
  [offset : CompilerIrValue]
  [ty : AstType]) : bool
  (match offset
    [(CompilerIrValue.I64 value)
      (or
        (and (= value 1) (opt-type-eq type-segment-bases ty (AstType.I64)))
        (and (= value 8) (opt-type-eq type-segment-bases ty (AstType.U8))))]
    [_ false]))

(define (opt-bounds-update-facts
  [facts : OptBoundsFacts]
  [instr : CompilerIrInstr]) : OptBoundsFacts
  (match instr
    [(CompilerIrInstr.Mov dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.Alloc dst _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.AddrOf dst _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.Gep dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.Load dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.Cast dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.Bitcast dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.BinOp dst _ _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.UnOp dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.LaneId dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.Splat dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.MaskNot dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(CompilerIrInstr.TailMask dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.EntryArgc dst) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.EntryArgv dst) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.EntryEnvp dst) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.CpuId _ _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.Xgetbv _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.Syscall _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.Call _ _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.CallIndirect _ _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.CallIndirectC _ _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ _ _ _)
          (OptBoundsFacts.Nil)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload _ _ _ _)
          (OptBoundsFacts.Nil)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ _)
          (OptBoundsFacts.Nil)])]
    [(CompilerIrInstr.VectorShuffle _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.TailCall _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.Store _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.StorePtr _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.CopyBytes _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload _ _ _ _ _)
          (OptBoundsFacts.Nil)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload _ _ _ _ _ _)
          (OptBoundsFacts.Nil)])]
    [(CompilerIrInstr.Jump _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.Branch _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.Return _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.Phi _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.BoundsCheck _ _ _) facts]
    [(CompilerIrInstr.Pack dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.Word dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(CompilerIrInstr.TailCallIndirect _ _ _) (OptBoundsFacts.Nil)]
    [(CompilerIrInstr.Switch _ _ _ _) (OptBoundsFacts.Nil)]))

(define (opt-bounds-instrs-with-object
  [type-segment-bases : i64]
  [facts : OptBoundsFacts]
  [lengths : OptObjectLengthFact]
  [ptrs : OptObjectLengthFact]
  [casts : OptBoundsCastEnv]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (match instr
        [(CompilerIrInstr.BoundsCheck index length _)
          (let
            [index-key : CompilerIrValue (opt-bounds-cast-canon casts index)]
            [length-key : CompilerIrValue
              (opt-bounds-length-value lengths length)]
            (if (opt-bounds-contains facts index-key length-key)
              (opt-bounds-instrs-with-object
                type-segment-bases
                facts
                lengths
                ptrs
                casts
                (box-get rest))
              (compiler-ir-instr-cons
                instr
                (opt-bounds-instrs-with-object
                  type-segment-bases
                  (opt-bounds-add facts index-key length-key)
                  lengths
                  ptrs
                  casts
                  (box-get rest)))))]
        [(CompilerIrInstr.Gep dst base offset ty)
          (let
            [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [lengths2 : OptObjectLengthFact
              (opt-object-length-invalidate-var lengths dst)]
            [ptrs2 : OptObjectLengthFact
              (opt-object-length-invalidate-var ptrs dst)]
            [ptrs3 : OptObjectLengthFact
              (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
                (match base
                  [(CompilerIrValue.Var object-var)
                    (opt-object-length-bind ptrs2 dst object-var)]
                  [_ ptrs2])
                ptrs2)]
            (compiler-ir-instr-cons
              instr
              (opt-bounds-instrs-with-object
                type-segment-bases
                facts2
                lengths2
                ptrs3
                (opt-bounds-cast-unbind casts dst)
                (box-get rest))))]
        [(CompilerIrInstr.Load dst src ty)
          (let
            [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [lengths2 : OptObjectLengthFact
              (opt-object-length-invalidate-var lengths dst)]
            [ptrs2 : OptObjectLengthFact
              (opt-object-length-invalidate-var ptrs dst)]
            [lengths3 : OptObjectLengthFact
              (if (opt-type-eq type-segment-bases ty (AstType.I64))
                (match src
                  [(CompilerIrValue.Var ptr-var)
                    (match (opt-object-length-lookup ptrs2 ptr-var)
                      [(option_i64.Some object-var)
                        (opt-object-length-bind lengths2 dst object-var)]
                      [(option_i64.None) lengths2])]
                  [_ lengths2])
                lengths2)]
            (compiler-ir-instr-cons
              instr
              (opt-bounds-instrs-with-object
                type-segment-bases
                facts2
                lengths3
                ptrs2
                (opt-bounds-cast-unbind casts dst)
                (box-get rest))))]
        [(CompilerIrInstr.Cast dst src from-ty to-ty)
          (let
            [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [lengths2 : OptObjectLengthFact
              (opt-object-length-invalidate-var lengths dst)]
            [ptrs2 : OptObjectLengthFact
              (opt-object-length-invalidate-var ptrs dst)]
            [lengths3 : OptObjectLengthFact
              (if (and
                (opt-type-eq type-segment-bases from-ty (AstType.I64))
                (opt-type-eq type-segment-bases to-ty (AstType.U64)))
                (match src
                  [(CompilerIrValue.Var length-var)
                    (match (opt-object-length-lookup lengths2 length-var)
                      [(option_i64.Some object-var)
                        (opt-object-length-bind lengths2 dst object-var)]
                      [(option_i64.None) lengths2])]
                  [_ lengths2])
                lengths2)]
            (compiler-ir-instr-cons
              instr
              (opt-bounds-instrs-with-object
                type-segment-bases
                facts2
                lengths3
                ptrs2
                (opt-bounds-cast-update
                  type-segment-bases
                  casts
                  dst
                  src
                  from-ty
                  to-ty)
                (box-get rest))))]
        ;; An array element store cannot change any array's LENGTH (in TL a
        ;; length slot is only ever written by make-array, and user code cannot
        ;; obtain a raw pointer to it), so the (index, length-token) bounds facts
        ;; survive it. Only a store whose target is a tracked length-slot pointer
        ;; (the make-array length write) clears the facts; element stores -- which
        ;; never alias a length slot -- keep object mode and its facts. This lets a
        ;; read-then-write of the same slot (qs-swap) drop the write's check.
        [(CompilerIrInstr.StorePtr ptr _ _)
          (match ptr
            [(CompilerIrValue.Var ptr-var)
              (match (opt-object-length-lookup ptrs ptr-var)
                [(option_i64.Some _)
                  (compiler-ir-instr-cons
                    instr
                    (opt-bounds-instrs
                      type-segment-bases
                      (OptBoundsFacts.Nil)
                      casts
                      (box-get rest)))]
                [(option_i64.None)
                  (compiler-ir-instr-cons
                    instr
                    (opt-bounds-instrs-with-object
                      type-segment-bases
                      facts
                      lengths
                      ptrs
                      casts
                      (box-get rest)))])]
            [_
              (compiler-ir-instr-cons
                instr
                (opt-bounds-instrs
                  type-segment-bases
                  (OptBoundsFacts.Nil)
                  casts
                  (box-get rest)))])]
        [_
          (let
            [next-facts : OptBoundsFacts (opt-bounds-update-facts facts instr)]
            [casts2 : OptBoundsCastEnv
              (match (opt-instr-def-var instr)
                [(option_i64.Some dst) (opt-bounds-cast-unbind casts dst)]
                [(option_i64.None) casts])]
            (match next-facts
              [(OptBoundsFacts.Nil)
                (compiler-ir-instr-cons
                  instr
                  (opt-bounds-instrs
                    type-segment-bases
                    next-facts
                    casts2
                    (box-get rest)))]
              [_
                (match (opt-instr-def-var instr)
                  [(option_i64.Some dst)
                    (compiler-ir-instr-cons
                      instr
                      (opt-bounds-instrs-with-object
                        type-segment-bases
                        next-facts
                        (opt-object-length-invalidate-var lengths dst)
                        (opt-object-length-invalidate-var ptrs dst)
                        casts2
                        (box-get rest)))]
                  [(option_i64.None)
                    (compiler-ir-instr-cons
                      instr
                      (opt-bounds-instrs-with-object
                        type-segment-bases
                        next-facts
                        lengths
                        ptrs
                        casts2
                        (box-get rest)))])]))])]))

(define (opt-bounds-instrs
  [type-segment-bases : i64]
  [facts : OptBoundsFacts]
  [casts : OptBoundsCastEnv]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (match instr
        [(CompilerIrInstr.BoundsCheck index length _)
          (let
            [index-key : CompilerIrValue (opt-bounds-cast-canon casts index)]
            (if (opt-bounds-contains facts index-key length)
              (opt-bounds-instrs type-segment-bases facts casts (box-get rest))
              (compiler-ir-instr-cons
                instr
                (opt-bounds-instrs
                  type-segment-bases
                  (opt-bounds-add facts index-key length)
                  casts
                  (box-get rest)))))]
        [(CompilerIrInstr.Gep dst base offset ty)
          (let
            [next-facts : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [casts2 : OptBoundsCastEnv (opt-bounds-cast-unbind casts dst)]
            (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
              (compiler-ir-instr-cons
                instr
                (opt-bounds-instrs-with-object
                  type-segment-bases
                  next-facts
                  (OptObjectLengthFact.None)
                  (match base
                    [(CompilerIrValue.Var object-var)
                      (opt-object-length-bind
                        (OptObjectLengthFact.None)
                        dst
                        object-var)]
                    [_ (OptObjectLengthFact.None)])
                  casts2
                  (box-get rest)))
              (compiler-ir-instr-cons
                instr
                (opt-bounds-instrs
                  type-segment-bases
                  next-facts
                  casts2
                  (box-get rest)))))]
        [(CompilerIrInstr.Cast dst src from-ty to-ty)
          (compiler-ir-instr-cons
            instr
            (opt-bounds-instrs
              type-segment-bases
              (opt-bounds-update-facts facts instr)
              (opt-bounds-cast-update
                type-segment-bases
                casts
                dst
                src
                from-ty
                to-ty)
              (box-get rest)))]
        [_
          (compiler-ir-instr-cons
            instr
            (opt-bounds-instrs
              type-segment-bases
              (opt-bounds-update-facts facts instr)
              (match (opt-instr-def-var instr)
                [(option_i64.Some dst) (opt-bounds-cast-unbind casts dst)]
                [(option_i64.None) casts])
              (box-get rest)))])]))

(defenum OptBoundsSeqState
  (Plain OptBoundsFacts OptBoundsCastEnv)
  (Object
    OptBoundsFacts
    OptObjectLengthFact
    OptObjectLengthFact
    OptBoundsCastEnv))

(defenum OptBoundsSeqStep
  (Step OptBoundsSeqState bool))

(define (opt-bounds-casts-after
  [casts : OptBoundsCastEnv]
  [instr : CompilerIrInstr]) : OptBoundsCastEnv
  (match (opt-instr-def-var instr)
    [(option_i64.Some dst) (opt-bounds-cast-unbind casts dst)]
    [(option_i64.None) casts]))

(define (opt-bounds-seq-step-plain
  [type-segment-bases : i64]
  [facts : OptBoundsFacts]
  [casts : OptBoundsCastEnv]
  [instr : CompilerIrInstr]) : OptBoundsSeqStep
  (match instr
    [(CompilerIrInstr.BoundsCheck index length _)
      (let
        [index-key : CompilerIrValue (opt-bounds-cast-canon casts index)]
        (if (opt-bounds-contains facts index-key length)
          (OptBoundsSeqStep.Step (OptBoundsSeqState.Plain facts casts) false)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Plain
              (opt-bounds-add facts index-key length)
              casts)
            true)))]
    [(CompilerIrInstr.Gep dst base offset ty)
      (let
        [next-facts : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
        [next-casts : OptBoundsCastEnv (opt-bounds-cast-unbind casts dst)]
        (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Object
              next-facts
              (OptObjectLengthFact.None)
              (match base
                [(CompilerIrValue.Var object-var)
                  (opt-object-length-bind
                    (OptObjectLengthFact.None)
                    dst
                    object-var)]
                [_ (OptObjectLengthFact.None)])
              next-casts)
            true)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Plain next-facts next-casts)
            true)))]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (OptBoundsSeqStep.Step
        (OptBoundsSeqState.Plain
          (opt-bounds-update-facts facts instr)
          (opt-bounds-cast-update
            type-segment-bases
            casts
            dst
            src
            from-ty
            to-ty))
        true)]
    [_
      (OptBoundsSeqStep.Step
        (OptBoundsSeqState.Plain
          (opt-bounds-update-facts facts instr)
          (opt-bounds-casts-after casts instr))
        true)]))

(define (opt-bounds-seq-step-object
  [type-segment-bases : i64]
  [facts : OptBoundsFacts]
  [lengths : OptObjectLengthFact]
  [ptrs : OptObjectLengthFact]
  [casts : OptBoundsCastEnv]
  [instr : CompilerIrInstr]) : OptBoundsSeqStep
  (match instr
    [(CompilerIrInstr.BoundsCheck index length _)
      (let
        [index-key : CompilerIrValue (opt-bounds-cast-canon casts index)]
        [length-key : CompilerIrValue (opt-bounds-length-value lengths length)]
        (if (opt-bounds-contains facts index-key length-key)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Object facts lengths ptrs casts)
            false)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Object
              (opt-bounds-add facts index-key length-key)
              lengths
              ptrs
              casts)
            true)))]
    [(CompilerIrInstr.Gep dst base offset ty)
      (let
        [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
        [lengths2 : OptObjectLengthFact
          (opt-object-length-invalidate-var lengths dst)]
        [ptrs2 : OptObjectLengthFact
          (opt-object-length-invalidate-var ptrs dst)]
        [ptrs3 : OptObjectLengthFact
          (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
            (match base
              [(CompilerIrValue.Var object-var)
                (opt-object-length-bind ptrs2 dst object-var)]
              [_ ptrs2])
            ptrs2)]
        (OptBoundsSeqStep.Step
          (OptBoundsSeqState.Object
            facts2
            lengths2
            ptrs3
            (opt-bounds-cast-unbind casts dst))
          true))]
    [(CompilerIrInstr.Load dst src ty)
      (let
        [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
        [lengths2 : OptObjectLengthFact
          (opt-object-length-invalidate-var lengths dst)]
        [ptrs2 : OptObjectLengthFact
          (opt-object-length-invalidate-var ptrs dst)]
        [lengths3 : OptObjectLengthFact
          (if (opt-type-eq type-segment-bases ty (AstType.I64))
            (match src
              [(CompilerIrValue.Var ptr-var)
                (match (opt-object-length-lookup ptrs2 ptr-var)
                  [(option_i64.Some object-var)
                    (opt-object-length-bind lengths2 dst object-var)]
                  [(option_i64.None) lengths2])]
              [_ lengths2])
            lengths2)]
        (OptBoundsSeqStep.Step
          (OptBoundsSeqState.Object
            facts2
            lengths3
            ptrs2
            (opt-bounds-cast-unbind casts dst))
          true))]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (let
        [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
        [lengths2 : OptObjectLengthFact
          (opt-object-length-invalidate-var lengths dst)]
        [ptrs2 : OptObjectLengthFact
          (opt-object-length-invalidate-var ptrs dst)]
        [lengths3 : OptObjectLengthFact
          (if (and
            (opt-type-eq type-segment-bases from-ty (AstType.I64))
            (opt-type-eq type-segment-bases to-ty (AstType.U64)))
            (match src
              [(CompilerIrValue.Var length-var)
                (match (opt-object-length-lookup lengths2 length-var)
                  [(option_i64.Some object-var)
                    (opt-object-length-bind lengths2 dst object-var)]
                  [(option_i64.None) lengths2])]
              [_ lengths2])
            lengths2)]
        (OptBoundsSeqStep.Step
          (OptBoundsSeqState.Object
            facts2
            lengths3
            ptrs2
            (opt-bounds-cast-update
              type-segment-bases
              casts
              dst
              src
              from-ty
              to-ty))
          true))]
    [(CompilerIrInstr.StorePtr ptr _ _)
      (match ptr
        [(CompilerIrValue.Var ptr-var)
          (match (opt-object-length-lookup ptrs ptr-var)
            [(option_i64.Some _)
              (OptBoundsSeqStep.Step
                (OptBoundsSeqState.Plain (OptBoundsFacts.Nil) casts)
                true)]
            [(option_i64.None)
              (OptBoundsSeqStep.Step
                (OptBoundsSeqState.Object facts lengths ptrs casts)
                true)])]
        [_
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Plain (OptBoundsFacts.Nil) casts)
            true)])]
    [_
      (let
        [next-facts : OptBoundsFacts (opt-bounds-update-facts facts instr)]
        [next-casts : OptBoundsCastEnv (opt-bounds-casts-after casts instr)]
        (match next-facts
          [(OptBoundsFacts.Nil)
            (OptBoundsSeqStep.Step
              (OptBoundsSeqState.Plain next-facts next-casts)
              true)]
          [_
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (OptBoundsSeqStep.Step
                  (OptBoundsSeqState.Object
                    next-facts
                    (opt-object-length-invalidate-var lengths dst)
                    (opt-object-length-invalidate-var ptrs dst)
                    next-casts)
                  true)]
              [(option_i64.None)
                (OptBoundsSeqStep.Step
                  (OptBoundsSeqState.Object next-facts lengths ptrs next-casts)
                  true)])]))]))

(define (opt-bounds-instr-seq-rewrite!
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [read : i64 0]
    [write : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [state : OptBoundsSeqState
      (OptBoundsSeqState.Plain (OptBoundsFacts.Nil) (OptBoundsCastEnv.Nil))]
    (begin
      (while (< read count)
        (let
          [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs read)]
          [step : OptBoundsSeqStep
            (match state
              [(OptBoundsSeqState.Plain facts casts)
                (opt-bounds-seq-step-plain type-segment-bases facts casts instr)]
              [(OptBoundsSeqState.Object facts lengths ptrs casts)
                (opt-bounds-seq-step-object
                  type-segment-bases
                  facts
                  lengths
                  ptrs
                  casts
                  instr)])]
          (match step
            [(OptBoundsSeqStep.Step next-state keep)
              (begin
                (if keep
                  (begin
                    (if (not (= write read))
                      (compiler-ir-instr-seq-set! instrs write instr)
                      unit)
                    (set! write (+ write 1)))
                  unit)
                (set! state next-state)
                (set! read (+ read 1)))])))
      (set! (struct-get instrs len) write))))

;; --- conservative CFG simplification ----------------------------------------
;;
;; Runs after block-local constant/copy propagation has exposed literal branch
;; conditions. It rewrites known boolean branches to jumps, computes reachable
;; blocks from the function entry block, drops unreachable blocks, and trims phi
;; inputs from predecessors that are no longer reachable.
(defenum OptLabelSet
  (Nil)
  ;; Slot zero is the shared high-water length; labels occupy slots 1..len in
  ;; oldest-first order. The logical set head is `items[len]`, so recursive
  ;; consumers can take an allocation-free tail view by decrementing `len`.
  ;; Extending a prefix is in-place only while it is the unique high-water
  ;; view. Extending a tail or an already-branched prefix copies first, keeping
  ;; the persistent cons semantics callers had with the old linked list.
  (Dense (Array i64) i64))

(define (opt-dense-next-capacity [len : i64]) : i64
  (if (< len 4)
    4
    (* len 2)))

(define (opt-label-ref [set : OptLabelSet] [index : i64]) : i64
  (match set
    [(OptLabelSet.Nil) (compiler-ir-label-none)]
    [(OptLabelSet.Dense items len) (array-ref items (- len index))]))

(define (opt-label-tail [set : OptLabelSet]) : OptLabelSet
  (match set
    [(OptLabelSet.Nil) (OptLabelSet.Nil)]
    [(OptLabelSet.Dense items len)
      (if (<= len 1)
        (OptLabelSet.Nil)
        (OptLabelSet.Dense items (- len 1)))]))

(define (opt-label-cons [label : i64] [set : OptLabelSet]) : OptLabelSet
  (match set
    [(OptLabelSet.Nil)
      (let
        [items : (Array i64) (array.make-array i64 5)]
        (begin
          (array-set! items 0 1)
          (array-set! items 1 label)
          (OptLabelSet.Dense items 1)))]
    [(OptLabelSet.Dense items len)
      (if (and (= len (array-ref items 0)) (< len (- (array-length items) 1)))
        (begin
          (array-set! items (+ len 1) label)
          (array-set! items 0 (+ len 1))
          (OptLabelSet.Dense items (+ len 1)))
        (let
          [old-capacity : i64 (- (array-length items) 1)]
          [capacity : i64
            (if (< len old-capacity)
              old-capacity
              (opt-dense-next-capacity len))]
          [bigger : (Array i64) (array.make-array i64 (+ capacity 1))]
          [index : i64 0]
          (begin
            (while (< index len)
              (begin
                (array-set! bigger (+ index 1) (array-ref items (+ index 1)))
                (set! index (+ index 1))))
            (array-set! bigger 0 (+ len 1))
            (array-set! bigger (+ len 1) label)
            (OptLabelSet.Dense bigger (+ len 1)))))]))

(define (opt-label-contains [set : OptLabelSet] [label : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (opt-label-count set)]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (if (= (opt-label-ref set index) label)
          (set! found true)
          (set! index (+ index 1))))
      found)))

(define (opt-label-add [set : OptLabelSet] [label : i64]) : OptLabelSet
  (if (opt-label-contains set label)
    set
    (opt-label-cons label set)))

(define (opt-label-count [set : OptLabelSet]) : i64
  (match set
    [(OptLabelSet.Nil) 0]
    [(OptLabelSet.Dense _ len) len]))

(define (opt-label-subset? [a : OptLabelSet] [b : OptLabelSet]) : bool
  (match a
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (and
        (opt-label-contains b (opt-label-ref a 0))
        (opt-label-subset? (opt-label-tail a) b))]))

(define (opt-label-set-eq? [a : OptLabelSet] [b : OptLabelSet]) : bool
  (and (opt-label-subset? a b) (opt-label-subset? b a)))

(define (opt-label-intersection [a : OptLabelSet] [b : OptLabelSet]) : OptLabelSet
  (match a
    [(OptLabelSet.Nil) (OptLabelSet.Nil)]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref a 0)]
        [tail : OptLabelSet (opt-label-intersection (opt-label-tail a) b)]
        (if (opt-label-contains b label)
          (opt-label-add tail label)
          tail))]))

(defenum OptMaybeBlock
  (No)
  (Some CompilerIrBlock))

(define (opt-cfg-find-block [blocks : CompilerIrBlockList] [label : i64]) : OptMaybeBlock
  (let
    [cursor : CompilerIrBlockList blocks]
    (begin
      (while true
        (match cursor
          [(CompilerIrBlockList.Nil) (return (OptMaybeBlock.No))]
          [(CompilerIrBlockList.Cons block rest)
            (match block
              [(CompilerIrBlock.Block block-label _)
                (if (= block-label label)
                  (return (OptMaybeBlock.Some block))
                  (set! cursor (box-get rest)))])]
          [(CompilerIrBlockList.Array seq)
            (let
              [index : i64 0]
              [count : i64 (compiler-ir-block-seq-count seq)]
              (begin
                (while (< index count)
                  (let
                    [block : CompilerIrBlock
                      (compiler-ir-block-seq-ref seq index)]
                    (match block
                      [(CompilerIrBlock.Block block-label _)
                        (if (= block-label label)
                          (return (OptMaybeBlock.Some block))
                          (set! index (+ index 1)))])))
                (return (OptMaybeBlock.No))))]))
      (OptMaybeBlock.No))))

(define (opt-cfg-block-exists? [blocks : CompilerIrBlockList] [label : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.Some _) true]
    [(OptMaybeBlock.No) false]))

(define (opt-cfg-entry-label [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) (compiler-ir-label-none)]
    [(CompilerIrBlockList.Cons block _)
      (match block
        [(CompilerIrBlock.Block label _) label])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-entry-label (compiler-ir-block-seq-to-list seq))]))

;; A hash-set seen-check; the incremental label-list scan made this
;; O(blocks^2) string comparisons on large functions.
(define (opt-cfg-block-labels-unique-map?
  [blocks : CompilerIrBlockList]
  [seen : opt_string_i64_map.Map]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (if (opt_string_i64_map.contains? (& seen) label)
            false
            (begin
              (opt_string_i64_map.insert-ref! (&mut seen) label 1)
              (opt-cfg-block-labels-unique-map? (box-get rest) seen)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-block-labels-unique-map?
        (compiler-ir-block-seq-to-list seq)
        seen)]))

(define (opt-cfg-block-labels-unique? [blocks : CompilerIrBlockList]) : bool
  (opt-cfg-block-labels-unique-map?
    blocks
    (opt_string_i64_map.with-capacity 64)))

(define (opt-cfg-block-label-map
  [blocks : CompilerIrBlockList]
  [seen : opt_string_i64_map.Map]) : opt_string_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) seen]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (begin
            (opt_string_i64_map.insert-ref! (&mut seen) label 1)
            (opt-cfg-block-label-map (box-get rest) seen))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-block-label-map (compiler-ir-block-seq-to-list seq) seen)]))

(define (opt-cfg-label-set-known-in-map?
  [labels : OptLabelSet]
  [known : opt_string_i64_map.Map]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (and
          (opt_string_i64_map.contains? (& known) label)
          (opt-cfg-label-set-known-in-map? (opt-label-tail labels) known)))]))

(define (opt-cfg-successor-targets-known-map?
  [blocks : CompilerIrBlockList]
  [known : opt_string_i64_map.Map]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (and
        (opt-cfg-label-set-known-in-map?
          (opt-cfg-block-successors-with-next
            block
            (opt-cfg-entry-label (box-get rest)))
          known)
        (opt-cfg-successor-targets-known-map? (box-get rest) known))]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-successor-targets-known-map?
        (compiler-ir-block-seq-to-list seq)
        known)]))

(define (opt-cfg-successor-targets-known? [blocks : CompilerIrBlockList]) : bool
  (opt-cfg-successor-targets-known-map?
    blocks
    (opt-cfg-block-label-map blocks (opt_string_i64_map.with-capacity 64))))

(define (opt-cfg-predecessors-scan [blocks : CompilerIrBlockList] [label : i64]) : OptLabelSet
  (match blocks
    [(CompilerIrBlockList.Nil) (OptLabelSet.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block block-label _)
          (let
            [tail : OptLabelSet
              (opt-cfg-predecessors-scan (box-get rest) label)]
            (if (opt-label-contains
              (opt-cfg-block-successors-with-next
                block
                (opt-cfg-entry-label (box-get rest)))
              label)
              (opt-label-add tail block-label)
              tail))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-predecessors-scan (compiler-ir-block-seq-to-list seq) label)]))

(define (opt-cfg-predecessors [blocks : CompilerIrBlockList] [label : i64]) : OptLabelSet
  (opt-cfg-index-predecessors (opt-cfg-index-build blocks) label))

(define (opt-cfg-filter-blocks-by-labels
  [labels : OptLabelSet]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (if (opt-label-contains labels label)
            (compiler-ir-block-cons
              block
              (opt-cfg-filter-blocks-by-labels labels (box-get rest)))
            (opt-cfg-filter-blocks-by-labels labels (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-filter-blocks-by-labels
        labels
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-reachable-block-order [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-cfg-filter-blocks-by-labels (opt-cfg-reachable-blocks blocks) blocks))

(defenum OptDomEntry
  (Entry i64 OptLabelSet))

(defenum OptLegacyDomTable
  (Nil)
  (Cons OptDomEntry (Box OptLegacyDomTable)))

(define (opt-dom-table-lookup [table : OptLegacyDomTable] [label : i64]) : OptLabelSet
  (match table
    [(OptLegacyDomTable.Nil) (OptLabelSet.Nil)]
    [(OptLegacyDomTable.Cons entry rest)
      (let
        [rest : OptLegacyDomTable (box-get rest)]
        (match entry
          [(OptDomEntry.Entry entry-label labels)
            (if (= entry-label label)
              labels
              (opt-dom-table-lookup rest label))]))]))

(define (opt-dom-entry-eq? [a : OptDomEntry] [b : OptDomEntry]) : bool
  (match a
    [(OptDomEntry.Entry a-label a-labels)
      (match b
        [(OptDomEntry.Entry b-label b-labels)
          (and (= a-label b-label) (opt-label-set-eq? a-labels b-labels))])]))

(define (opt-dom-table-eq? [a : OptLegacyDomTable] [b : OptLegacyDomTable]) : bool
  (match a
    [(OptLegacyDomTable.Nil)
      (match b
        [(OptLegacyDomTable.Nil) true]
        [_ false])]
    [(OptLegacyDomTable.Cons a-entry a-rest)
      (match b
        [(OptLegacyDomTable.Cons b-entry b-rest)
          (and
            (opt-dom-entry-eq? a-entry b-entry)
            (opt-dom-table-eq? (box-get a-rest) (box-get b-rest)))]
        [_ false])]))

(define (opt-dom-intersect-preds-rest
  [table : OptLegacyDomTable]
  [preds : OptLabelSet]
  [current : OptLabelSet]) : OptLabelSet
  (match preds
    [(OptLabelSet.Nil) current]
    [(OptLabelSet.Dense _ _)
      (opt-dom-intersect-preds-rest
        table
        (opt-label-tail preds)
        (opt-label-intersection
          current
          (opt-dom-table-lookup table (opt-label-ref preds 0))))]))

(define (opt-dom-intersect-preds
  [table : OptLegacyDomTable]
  [preds : OptLabelSet]) : OptLabelSet
  (match preds
    [(OptLabelSet.Nil) (OptLabelSet.Nil)]
    [(OptLabelSet.Dense _ _)
      (opt-dom-intersect-preds-rest
        table
        (opt-label-tail preds)
        (opt-dom-table-lookup table (opt-label-ref preds 0)))]))

(define (opt-cfg-dominators-initial
  [blocks : CompilerIrBlockList]
  [reachable : OptLabelSet]
  [entry-label : i64]
  [all-reachable : OptLabelSet]) : OptLegacyDomTable
  (match blocks
    [(CompilerIrBlockList.Nil) (OptLegacyDomTable.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (if (opt-label-contains reachable label)
            (OptLegacyDomTable.Cons
              (OptDomEntry.Entry
                label
                (if (= label entry-label)
                  (opt-label-add (OptLabelSet.Nil) label)
                  all-reachable))
              (box
                (opt-cfg-dominators-initial
                  (box-get rest)
                  reachable
                  entry-label
                  all-reachable)))
            (opt-cfg-dominators-initial
              (box-get rest)
              reachable
              entry-label
              all-reachable))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-dominators-initial
        (compiler-ir-block-seq-to-list seq)
        reachable
        entry-label
        all-reachable)]))

;; CFG index: integer block ids are assigned in block-list order and
;; reused for successor/predecessor CSR rows, reachability, RPO, and RPO slot
;; lookup. Existing callers still consume OptLabelSet adapters, but each CFG
;; snapshot is indexed once and rebuilt only after block-list-mutating
;; optimization passes.
(defenum OptI64List
  (Nil)
  (Cons i64 (Box OptI64List)))

;; Label id -> dense CFG index, without a hash map. Block labels are interned
;; ids drawn densely from `compiler-ir-label-count`, so one array indexed by the
;; label id answers the query directly. A per-build generation stamp makes
;; "belongs to this CFG" a compare instead of a clear, so a rebuild costs one
;; counter bump rather than a pass over the table (refs #5718, proposal 3).
(define opt-cfg-label-slot : (Array i64)
  (array.make-array i64 1))
(define opt-cfg-label-stamp : (Array i64)
  (array.make-array i64 1))
(define opt-cfg-label-generation : i64
  0)

;; The table outlives every optimizer scratch rewind, so it is bound in the IR
;; label arena -- the same dedicated, never-reset arena the label pool uses.
;; Growing it in the ambient arena instead leaves the globals pointing into
;; memory a later rewind frees.
(define (opt-cfg-label-table-reserve! [count : i64]) : unit
  (if (<= count (array-length opt-cfg-label-slot))
    unit
    (let
      [size : i64 (array-length opt-cfg-label-slot)]
      [previous-arena : i64 (arena.tl_arena_current)]
      (begin
        (while (< size count)
          (set! size (* size 2)))
        (unsafe
          (arena.tl_arena_set (compiler-ir-label-arena)))
        (set! opt-cfg-label-slot (array.make-array i64 size))
        (set! opt-cfg-label-stamp (array.make-array i64 size))
        (unsafe
          (arena.tl_arena_set previous-arena))
        ;; A fresh stamp array reads as generation 0, so restart the counter
        ;; above it rather than leaving stale entries live.
        (set! opt-cfg-label-generation 0)))))

(define (opt-cfg-label-table-begin!) : i64
  (begin
    (opt-cfg-label-table-reserve! (compiler-ir-label-count-value))
    (set! opt-cfg-label-generation (+ opt-cfg-label-generation 1))
    opt-cfg-label-generation))

(define (opt-cfg-label-table-put! [label : i64] [id : i64] [generation : i64]) : unit
  (if (or (< label 0) (>= label (array-length opt-cfg-label-slot)))
    unit
    (begin
      (array-set! opt-cfg-label-slot label id)
      (array-set! opt-cfg-label-stamp label generation))))

(define (opt-cfg-label-table-get [label : i64] [generation : i64]) : i64
  (if (or (< label 0) (>= label (array-length opt-cfg-label-stamp)))
    -1
    (if (= (array-ref opt-cfg-label-stamp label) generation)
      (array-ref opt-cfg-label-slot label)
      -1)))

(defstruct OptCfgCsr
  (offsets (Array i64))
  (edges (Array i64)))

;; `targets-known` is one of the optimizer verifier's two structural CFG checks.
;; It falls out of the build for free: `opt-cfg-index-label-set-to-ids` drops
;; successor labels it cannot resolve, so an unknown target is a short CSR row.
;; The other check needs no field -- see `opt-cfg-index-labels-unique?`. Together
;; they replace rebuilding a label map and rehashing every label and every
;; successor edge, once per verified function (refs #5718).
(defstruct OptCfgIndex
  (label-generation i64)
  (labels-unique bool)
  (labels (Array i64))
  ;; Dense block values share CFG id order. Passes that reuse a topology
  ;; context after replacing block values refresh this array once from their
  ;; exact current list before indexed reads.
  (blocks (Array CompilerIrBlock))
  (succs OptCfgCsr)
  (preds OptCfgCsr)
  (reachable (Array bool))
  (reach-count i64)
  (rpo (Array i64))
  (rpo-num (Array i64))
  (targets-known bool))

(defstruct OptPredMap
  (index OptCfgIndex))

(define (opt-cfg-index-fill-label-seq!
  [blocks : CompilerIrBlockSeq]
  [generation : i64]
  [labels : (Array i64)]
  [dense-blocks : (Array CompilerIrBlock)]
  [base : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    [unique : bool true]
    (begin
      (while (< index count)
        (let
          [block : CompilerIrBlock (compiler-ir-block-seq-ref blocks index)]
          (begin
            (array-set! dense-blocks (+ base index) block)
            (match block
              [(CompilerIrBlock.Block label _)
                (let
                  [fresh : bool
                    (< (opt-cfg-label-table-get label generation) 0)]
                  (begin
                    (array-set! labels (+ base index) label)
                    ;; Preserve `find-block`'s first-match behavior for an
                    ;; invalid duplicate-label CFG. Valid CFGs are unique.
                    (if fresh
                      (opt-cfg-label-table-put! label (+ base index) generation)
                      (set! unique false))))])
            (set! index (+ index 1)))))
      unique)))

(define (opt-cfg-index-fill-labels!
  [blocks : CompilerIrBlockList]
  [generation : i64]
  [labels : (Array i64)]
  [dense-blocks : (Array CompilerIrBlock)]
  [index : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (let
            [fresh : bool (< (opt-cfg-label-table-get label generation) 0)]
            (begin
              (array-set! dense-blocks index block)
              (array-set! labels index label)
              (if fresh
                (opt-cfg-label-table-put! label index generation)
                unit)
              ;; the recursion runs first: `and` short-circuits and the rest of
              ;; the labels still have to be stamped
              (and
                (opt-cfg-index-fill-labels!
                  (box-get rest)
                  generation
                  labels
                  dense-blocks
                  (+ index 1))
                fresh)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-index-fill-label-seq! seq generation labels dense-blocks index)]))

(define (opt-i64-list-contains? [items : OptI64List] [value : i64]) : bool
  (match items
    [(OptI64List.Nil) false]
    [(OptI64List.Cons head rest)
      (if (= head value)
        true
        (opt-i64-list-contains? (box-get rest) value))]))

(define (opt-i64-list-add [items : OptI64List] [value : i64]) : OptI64List
  (if (opt-i64-list-contains? items value)
    items
    (OptI64List.Cons value (box items))))

(define (opt-i64-list-reverse-onto [items : OptI64List] [acc : OptI64List]) : OptI64List
  (match items
    [(OptI64List.Nil) acc]
    [(OptI64List.Cons head rest)
      (opt-i64-list-reverse-onto
        (box-get rest)
        (OptI64List.Cons head (box acc)))]))

(define (opt-i64-list-reverse [items : OptI64List]) : OptI64List
  (opt-i64-list-reverse-onto items (OptI64List.Nil)))

(define (opt-i64-list-count [items : OptI64List]) : i64
  (match items
    [(OptI64List.Nil) 0]
    [(OptI64List.Cons _ rest) (+ 1 (opt-i64-list-count (box-get rest)))]))

(define (opt-i64-list-fill-edges!
  [items : OptI64List]
  [edges : (Array i64)]
  [index : i64]) : i64
  (match items
    [(OptI64List.Nil) index]
    [(OptI64List.Cons head rest)
      (begin
        (array-set! edges index head)
        (opt-i64-list-fill-edges! (box-get rest) edges (+ index 1)))]))

(define (opt-cfg-row-list-total
  [rows : (Array OptI64List)]
  [count : i64]
  [index : i64]
  [total : i64]) : i64
  (if (>= index count)
    total
    (opt-cfg-row-list-total
      rows
      count
      (+ index 1)
      (+ total (opt-i64-list-count (array-ref rows index))))))

(define (opt-cfg-i64-list-array-fill-empty!
  [rows : (Array OptI64List)]
  [count : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! rows i (OptI64List.Nil))
          (set! i (+ i 1))))
      unit)))

(define (opt-cfg-index-label-set-to-ids
  [labels : OptLabelSet]
  [generation : i64]) : OptI64List
  (match labels
    [(OptLabelSet.Nil) (OptI64List.Nil)]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        [tail : OptI64List
          (opt-cfg-index-label-set-to-ids (opt-label-tail labels) generation)]
        [idx : i64 (opt-cfg-label-table-get label generation)]
        (if (< idx 0)
          tail
          (OptI64List.Cons idx (box tail))))]))

;; The successor row for this block already holds every resolved target id, in
;; label-set order, with unresolvable labels dropped -- exactly the sequence the
;; label-walking version produced. Reuse it instead of hashing each successor
;; label a second time: `opt-cfg-index-label-set-to-ids` has already paid one
;; `opt_string_i64_map.get` per edge.
(define (opt-cfg-index-add-pred-edges-from-ids!
  [pred-rows : (Array OptI64List)]
  [source-id : i64]
  [succ-ids : OptI64List]) : unit
  (match succ-ids
    [(OptI64List.Nil) unit]
    [(OptI64List.Cons idx rest)
      (begin
        (array-set!
          pred-rows
          idx
          (opt-i64-list-add (array-ref pred-rows idx) source-id))
        (opt-cfg-index-add-pred-edges-from-ids!
          pred-rows
          source-id
          (box-get rest)))]))

;; Returns whether every successor label resolved. `opt-cfg-index-label-set-to-ids`
;; drops the ones that miss, so a short row is exactly an unknown target -- the
;; question `opt-cfg-successor-targets-known?` answered by rebuilding the label
;; map and reprobing it.
(define (opt-cfg-index-fill-row-seq!
  [blocks : CompilerIrBlockSeq]
  [generation : i64]
  [succ-rows : (Array OptI64List)]
  [pred-rows : (Array OptI64List)]
  [base : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    [known : bool true]
    (begin
      (while (< index count)
        (let
          [block : CompilerIrBlock (compiler-ir-block-seq-ref blocks index)]
          [next-label : i64
            (if (< (+ index 1) count)
              (match (compiler-ir-block-seq-ref blocks (+ index 1))
                [(CompilerIrBlock.Block label _) label])
              (compiler-ir-label-none))]
          [succs : OptLabelSet
            (opt-cfg-block-successors-with-next block next-label)]
          [row : i64 (+ base index)]
          [succ-ids : OptI64List
            (opt-cfg-index-label-set-to-ids succs generation)]
          (begin
            (array-set! succ-rows row succ-ids)
            (opt-cfg-index-add-pred-edges-from-ids! pred-rows row succ-ids)
            (unless
              (= (opt-label-count succs) (opt-i64-list-count succ-ids))
              (set! known false))
            (set! index (+ index 1)))))
      known)))

(define (opt-cfg-index-fill-rows!
  [blocks : CompilerIrBlockList]
  [generation : i64]
  [succ-rows : (Array OptI64List)]
  [pred-rows : (Array OptI64List)]
  [index : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ _)
          (let
            [succs : OptLabelSet
              (opt-cfg-block-successors-with-next
                block
                (opt-cfg-entry-label (box-get rest)))]
            [succ-ids : OptI64List
              (opt-cfg-index-label-set-to-ids succs generation)]
            [known : bool
              (= (opt-label-count succs) (opt-i64-list-count succ-ids))]
            (begin
              (array-set! succ-rows index succ-ids)
              (opt-cfg-index-add-pred-edges-from-ids! pred-rows index succ-ids)
              ;; The recursion comes first: `and` short-circuits, and the rest of
              ;; the rows still have to be filled.
              (and
                (opt-cfg-index-fill-rows!
                  (box-get rest)
                  generation
                  succ-rows
                  pred-rows
                  (+ index 1))
                known)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-index-fill-row-seq! seq generation succ-rows pred-rows index)]))

(define (opt-cfg-csr-fill-rows!
  [rows : (Array OptI64List)]
  [count : i64]
  [offsets : (Array i64)]
  [edges : (Array i64)]
  [row : i64]
  [edge-index : i64]) : unit
  (if (>= row count)
    (array-set! offsets count edge-index)
    (let
      [next-edge : i64
        (opt-i64-list-fill-edges!
          (opt-i64-list-reverse (array-ref rows row))
          edges
          edge-index)]
      (begin
        (array-set! offsets row edge-index)
        (opt-cfg-csr-fill-rows! rows count offsets edges (+ row 1) next-edge)))))

(define (opt-cfg-csr-build [rows : (Array OptI64List)] [count : i64]) : OptCfgCsr
  (let
    [edge-count : i64 (opt-cfg-row-list-total rows count 0 0)]
    [offsets : (Array i64) (array.make-array i64 (+ count 1))]
    [edges : (Array i64) (array.make-array i64 edge-count)]
    (begin
      (opt-cfg-csr-fill-rows! rows count offsets edges 0 0)
      (OptCfgCsr offsets edges))))

;; Only for arrays being *re*-initialised. `make-array` already hands back
;; zeroed memory -- `tl_array_zero` either fills the allocation or skips the
;; fill precisely when the arena is virgin and therefore already zero -- so
;; clearing a freshly allocated array to `false` repeats work the allocator has
;; already done, with a scalar loop instead of `rep stosq`.
(define (opt-cfg-fill-bool!
  [values : (Array bool)]
  [count : i64]
  [value : bool]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! values i value)
          (set! i (+ i 1))))
      unit)))

(define (opt-cfg-fill-i64! [values : (Array i64)] [count : i64] [value : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! values i value)
          (set! i (+ i 1))))
      unit)))

(define (opt-cfg-index-dfs-edges!
  [succs : OptCfgCsr]
  [reachable : (Array bool)]
  [postorder : (Array i64)]
  [edge : i64]
  [end : i64]
  [post-count : i64]) : i64
  (if (>= edge end)
    post-count
    (opt-cfg-index-dfs-edges!
      succs
      reachable
      postorder
      (+ edge 1)
      end
      (opt-cfg-index-dfs-postorder!
        succs
        reachable
        postorder
        (array-ref (struct-get succs edges) edge)
        post-count))))

(define (opt-cfg-index-dfs-postorder!
  [succs : OptCfgCsr]
  [reachable : (Array bool)]
  [postorder : (Array i64)]
  [id : i64]
  [post-count : i64]) : i64
  (if (array-ref reachable id)
    post-count
    (let
      [edge : i64 (array-ref (struct-get succs offsets) id)]
      [end : i64 (array-ref (struct-get succs offsets) (+ id 1))]
      [next-count : i64
        (begin
          (array-set! reachable id true)
          (opt-cfg-index-dfs-edges!
            succs
            reachable
            postorder
            edge
            end
            post-count))]
      (begin
        (array-set! postorder next-count id)
        (+ next-count 1)))))

(define (opt-cfg-index-fill-rpo!
  [postorder : (Array i64)]
  [rpo : (Array i64)]
  [reach-count : i64]
  [index : i64]) : unit
  (if (>= index reach-count)
    unit
    (begin
      (array-set! rpo index (array-ref postorder (- (- reach-count 1) index)))
      (opt-cfg-index-fill-rpo! postorder rpo reach-count (+ index 1)))))

(define (opt-cfg-index-fill-rpo-num!
  [rpo : (Array i64)]
  [rpo-num : (Array i64)]
  [reach-count : i64]
  [slot : i64]) : unit
  (if (>= slot reach-count)
    unit
    (begin
      (array-set! rpo-num (array-ref rpo slot) slot)
      (opt-cfg-index-fill-rpo-num! rpo rpo-num reach-count (+ slot 1)))))

(define (opt-cfg-index-build [blocks : CompilerIrBlockList]) : OptCfgIndex
  (let
    [count : i64 (compiler-ir-block-list-count blocks)]
    [labels : (Array i64) (array.make-array i64 count)]
    [dense-blocks : (Array CompilerIrBlock)
      (array.make-array CompilerIrBlock count)]
    [generation : i64 (opt-cfg-label-table-begin!)]
    [labels-unique : bool
      (opt-cfg-index-fill-labels! blocks generation labels dense-blocks 0)]
    [succ-rows : (Array OptI64List) (array.make-array OptI64List count)]
    [pred-rows : (Array OptI64List) (array.make-array OptI64List count)]
    [reachable : (Array bool) (array.make-array bool count)]
    [postorder : (Array i64) (array.make-array i64 count)]
    [rpo : (Array i64) (array.make-array i64 count)]
    [rpo-num : (Array i64) (array.make-array i64 count)]
    [reach-count : i64 0]
    [targets-known : bool true]
    (begin
      (opt-cfg-i64-list-array-fill-empty! succ-rows count)
      (opt-cfg-i64-list-array-fill-empty! pred-rows count)
      (set!
        targets-known
        (opt-cfg-index-fill-rows! blocks generation succ-rows pred-rows 0))
      (opt-cfg-fill-i64! postorder count (- 0 1))
      (opt-cfg-fill-i64! rpo count (- 0 1))
      (opt-cfg-fill-i64! rpo-num count (- 0 1))
      (let
        [succ-csr : OptCfgCsr (opt-cfg-csr-build succ-rows count)]
        [pred-csr : OptCfgCsr (opt-cfg-csr-build pred-rows count)]
        (begin
          (if (> count 0)
            (set!
              reach-count
              (opt-cfg-index-dfs-postorder! succ-csr reachable postorder 0 0))
            unit)
          (opt-cfg-index-fill-rpo! postorder rpo reach-count 0)
          (opt-cfg-index-fill-rpo-num! rpo rpo-num reach-count 0)
          (OptCfgIndex
            generation
            labels-unique
            labels
            dense-blocks
            succ-csr
            pred-csr
            reachable
            reach-count
            rpo
            rpo-num
            targets-known))))))

(define (opt-cfg-index-block-count [index : OptCfgIndex]) : i64
  (array-length (struct-get index labels)))

;; `opt-cfg-index-fill-labels!` records whether every label inserted exactly
;; once. The reverse table keeps the first entry for duplicate labels so indexed
;; lookup agrees with the legacy list scan even before the verifier rejects the
;; malformed CFG.
(define (opt-cfg-index-labels-unique? [index : OptCfgIndex]) : bool
  (struct-get index labels-unique))

(define (opt-cfg-index-label [index : OptCfgIndex] [id : i64]) : i64
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (array-ref (struct-get index labels) id)
    (compiler-ir-label-none)))

;; The shared table holds one build at a time. An index that is still live when
;; a later build stamps over it therefore misses, and falls back to scanning its
;; own id -> label array -- correct either way, because the fast path is only
;; taken when the stamp proves the slot belongs to this build.
(define (opt-cfg-index-id-scan [labels : (Array i64)] [label : i64] [id : i64]) : option_i64.Option
  (if (>= id (array-length labels))
    (option_i64.None)
    (if (= (array-ref labels id) label)
      (option_i64.Some id)
      (opt-cfg-index-id-scan labels label (+ id 1)))))

(define (opt-cfg-index-id [index : OptCfgIndex] [label : i64]) : option_i64.Option
  (let
    [id : i64
      (opt-cfg-label-table-get label (struct-get index label-generation))]
    (if (>= id 0)
      (option_i64.Some id)
      (opt-cfg-index-id-scan (struct-get index labels) label 0))))

(define (opt-cfg-index-refresh-block-seq!
  [out : (Array CompilerIrBlock)]
  [blocks : CompilerIrBlockSeq]
  [base : i64]) : i64
  (let
    [slot : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    (begin
      (while (< slot count)
        (begin
          (array-set! out (+ base slot) (compiler-ir-block-seq-ref blocks slot))
          (set! slot (+ slot 1))))
      (+ base count))))

(define (opt-cfg-index-refresh-blocks-from!
  [out : (Array CompilerIrBlock)]
  [blocks : CompilerIrBlockList]
  [index : i64]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) index]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (array-set! out index block)
        (opt-cfg-index-refresh-blocks-from! out (box-get rest) (+ index 1)))]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-index-refresh-block-seq! out seq index)]))

(define (opt-cfg-index-refresh-blocks!
  [index : OptCfgIndex]
  [blocks : CompilerIrBlockList]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    (if (= count (compiler-ir-block-list-count blocks))
      (begin
        (opt-cfg-index-refresh-blocks-from! (struct-get index blocks) blocks 0)
        unit)
      unit)))

(define (opt-cfg-index-block [index : OptCfgIndex] [id : i64]) : OptMaybeBlock
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (OptMaybeBlock.Some (array-ref (struct-get index blocks) id))
    (OptMaybeBlock.No)))

(define (opt-cfg-index-find-block [index : OptCfgIndex] [label : i64]) : OptMaybeBlock
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (opt-cfg-index-block index id)]
    [(option_i64.None) (OptMaybeBlock.No)]))

(define (opt-cfg-index-row-labels-from
  [index : OptCfgIndex]
  [csr : OptCfgCsr]
  [edge : i64]
  [end : i64]
  [labels : OptLabelSet]) : OptLabelSet
  (if (>= edge end)
    labels
    (opt-cfg-index-row-labels-from
      index
      csr
      (+ edge 1)
      end
      (opt-label-add
        labels
        (opt-cfg-index-label index (array-ref (struct-get csr edges) edge))))))

(define (opt-cfg-index-row-labels
  [index : OptCfgIndex]
  [csr : OptCfgCsr]
  [id : i64]) : OptLabelSet
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (opt-cfg-index-row-labels-from
      index
      csr
      (array-ref (struct-get csr offsets) id)
      (array-ref (struct-get csr offsets) (+ id 1))
      (OptLabelSet.Nil))
    (OptLabelSet.Nil)))

(define (opt-cfg-index-successors [index : OptCfgIndex] [label : i64]) : OptLabelSet
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id)
      (opt-cfg-index-row-labels index (struct-get index succs) id)]
    [(option_i64.None) (OptLabelSet.Nil)]))

(define (opt-cfg-index-predecessors [index : OptCfgIndex] [label : i64]) : OptLabelSet
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id)
      (opt-cfg-index-row-labels index (struct-get index preds) id)]
    [(option_i64.None) (OptLabelSet.Nil)]))

(define (opt-cfg-index-reachable? [index : OptCfgIndex] [label : i64]) : bool
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (array-ref (struct-get index reachable) id)]
    [(option_i64.None) false]))

(define (opt-cfg-csr-row-contains-id?
  [csr : OptCfgCsr]
  [row : i64]
  [wanted : i64]) : bool
  (let
    [edge : i64 (array-ref (struct-get csr offsets) row)]
    [end : i64 (array-ref (struct-get csr offsets) (+ row 1))]
    [edges : (Array i64) (struct-get csr edges)]
    (begin
      (while (< edge end)
        (if (= (array-ref edges edge) wanted)
          (return true)
          (set! edge (+ edge 1))))
      false)))

(define (opt-cfg-index-reachable-predecessor?
  [index : OptCfgIndex]
  [block-id : i64]
  [predecessor-label : i64]) : bool
  (match (opt-cfg-index-id index predecessor-label)
    [(option_i64.Some predecessor-id)
      (and
        (array-ref (struct-get index reachable) predecessor-id)
        (opt-cfg-csr-row-contains-id?
          (struct-get index preds)
          block-id
          predecessor-id))]
    [(option_i64.None) false]))

;; One entry per reachable block, deduped through a hash set rather than
;; `opt-label-add`'s linear `string.eq` scan. `opt-label-add` prepends only on
;; first occurrence, and this applies the same rule, so the list -- including
;; its descending-id order -- is unchanged even when two blocks somehow share a
;; label. That case is a verifier error rather than something this function may
;; assume away, which is why the dedup is kept instead of dropped.
(define (opt-cfg-index-reachable-labels-from-seen
  [index : OptCfgIndex]
  [id : i64]
  [labels : OptLabelSet]
  [seen : opt_string_i64_map.Map]) : OptLabelSet
  (if (>= id (opt-cfg-index-block-count index))
    labels
    (opt-cfg-index-reachable-labels-from-seen
      index
      (+ id 1)
      (if (array-ref (struct-get index reachable) id)
        (let
          [label : i64 (opt-cfg-index-label index id)]
          (if (opt_string_i64_map.contains? (& seen) label)
            labels
            (begin
              (opt_string_i64_map.insert-ref! (&mut seen) label 1)
              (opt-label-cons label labels))))
        labels)
      seen)))

;; The linear original, kept for small functions. `opt-label-add` prepends only
;; on first occurrence, which is exactly what the hashed variant above does, so
;; the two build the identical list and the choice between them is invisible.
(define (opt-cfg-index-reachable-labels-from-linear
  [index : OptCfgIndex]
  [id : i64]
  [labels : OptLabelSet]) : OptLabelSet
  (if (>= id (opt-cfg-index-block-count index))
    labels
    (opt-cfg-index-reachable-labels-from-linear
      index
      (+ id 1)
      (if (array-ref (struct-get index reachable) id)
        (opt-label-add labels (opt-cfg-index-label index id))
        labels))))

;; Which dedup to use is a size question. The map is not reclaimed, so building
;; one per CFG index build costs real peak memory in the optimizer, while the
;; linear scan it replaces only becomes expensive once a function has many
;; blocks. Below the threshold the scan is cheaper than the allocation; above
;; it, the O(blocks^2) comparisons dominate and the map pays for itself.
(define (opt-cfg-index-reachable-hash-threshold) : i64
  32)

(define (opt-cfg-index-reachable-labels [index : OptCfgIndex]) : OptLabelSet
  (if (<
    (opt-cfg-index-block-count index)
    (opt-cfg-index-reachable-hash-threshold))
    (opt-cfg-index-reachable-labels-from-linear index 0 (OptLabelSet.Nil))
    (opt-cfg-index-reachable-labels-from-seen
      index
      0
      (OptLabelSet.Nil)
      (opt_string_i64_map.with-capacity (opt-cfg-index-block-count index)))))

(define (opt-cfg-index-rpo-id [index : OptCfgIndex] [slot : i64]) : i64
  (if (and (>= slot 0) (< slot (struct-get index reach-count)))
    (array-ref (struct-get index rpo) slot)
    (- 0 1)))

(define (opt-cfg-index-rpo-num [index : OptCfgIndex] [id : i64]) : i64
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (array-ref (struct-get index rpo-num) id)
    (- 0 1)))

(define (opt-cfg-index-rpo-label [index : OptCfgIndex] [slot : i64]) : i64
  (opt-cfg-index-label index (opt-cfg-index-rpo-id index slot)))

(define (opt-pred-map-lookup [map : OptPredMap] [label : i64]) : OptLabelSet
  (opt-cfg-index-predecessors (struct-get map index) label))

(define (opt-pred-map-successors [map : OptPredMap] [label : i64]) : OptLabelSet
  (opt-cfg-index-successors (struct-get map index) label))

(define (opt-cfg-dominators-step-entry
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : i64]
  [old : OptLegacyDomTable]
  [entry : OptDomEntry]) : OptDomEntry
  (match entry
    [(OptDomEntry.Entry label _)
      (if (= label entry-label)
        (OptDomEntry.Entry label (opt-label-add (OptLabelSet.Nil) label))
        (let
          [preds : OptLabelSet
            (opt-label-intersection
              (opt-pred-map-lookup pred-map label)
              reachable)]
          (OptDomEntry.Entry
            label
            (opt-label-add (opt-dom-intersect-preds old preds) label))))]))

(define (opt-cfg-dominators-step
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : i64]
  [old : OptLegacyDomTable]
  [remaining : OptLegacyDomTable]) : OptLegacyDomTable
  (match remaining
    [(OptLegacyDomTable.Nil) (OptLegacyDomTable.Nil)]
    [(OptLegacyDomTable.Cons entry rest)
      (OptLegacyDomTable.Cons
        (opt-cfg-dominators-step-entry pred-map reachable entry-label old entry)
        (box
          (opt-cfg-dominators-step
            pred-map
            reachable
            entry-label
            old
            (box-get rest))))]))

(define (opt-cfg-dominators-fixed
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : i64]
  [table : OptLegacyDomTable]
  [remaining : i64]) : OptLegacyDomTable
  (if (<= remaining 0)
    table
    (let
      [next : OptLegacyDomTable
        (opt-cfg-dominators-step pred-map reachable entry-label table table)]
      (if (opt-dom-table-eq? table next)
        next
        (opt-cfg-dominators-fixed
          pred-map
          reachable
          entry-label
          next
          (- remaining 1))))))

(define (opt-cfg-dominators-legacy-with
  [blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : i64]) : OptLegacyDomTable
  (let
    [initial : OptLegacyDomTable
      (opt-cfg-dominators-initial blocks reachable entry-label reachable)]
    (opt-cfg-dominators-fixed
      pred-map
      reachable
      entry-label
      initial
      (+ (compiler-ir-block-list-count blocks) 1))))

(define (opt-bits-words [bits : i64]) : i64
  (/ (+ bits 62) 63))

(define (opt-bits-set! [row : (Array i64)] [base : i64] [bit : i64]) : unit
  (let
    [w : i64 (+ base (/ bit 63))]
    (array-set! row w (bit-or (array-ref row w) (shl 1 (% bit 63))))))

(define (opt-bits-test [row : (Array i64)] [base : i64] [bit : i64]) : bool
  (not (= (bit-and (array-ref row (+ base (/ bit 63))) (shl 1 (% bit 63))) 0)))

(define (opt-bits-clear! [row : (Array i64)] [base : i64] [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (array-set! row (+ base w) 0)
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-and-into!
  [dst : (Array i64)]
  [dst-base : i64]
  [src : (Array i64)]
  [src-base : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (array-set!
            dst
            (+ dst-base w)
            (bit-and
              (array-ref dst (+ dst-base w))
              (array-ref src (+ src-base w))))
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-copy!
  [dst : (Array i64)]
  [dst-base : i64]
  [src : (Array i64)]
  [src-base : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (array-set! dst (+ dst-base w) (array-ref src (+ src-base w)))
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-eq?
  [a : (Array i64)]
  [a-base : i64]
  [b : (Array i64)]
  [b-base : i64]
  [words : i64]) : bool
  (let
    [w : i64 0]
    [same : bool true]
    (begin
      (while (and same (< w words))
        (begin
          (if (= (array-ref a (+ a-base w)) (array-ref b (+ b-base w)))
            unit
            (set! same false))
          (set! w (+ w 1))))
      same)))

(defstruct OptDomInfo
  (index OptCfgIndex)
  (words i64)
  (rows (Array i64))
  (idom (Array i64))
  (tin (Array i64))
  (tout (Array i64)))

(define (opt-dom-row-base [words : i64] [id : i64]) : i64
  (* id words))

(define (opt-dom-fill-reachable-universe!
  [index : OptCfgIndex]
  [row : (Array i64)]
  [base : i64]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [id : i64 0]
    (begin
      (while (< id count)
        (begin
          (if (array-ref (struct-get index reachable) id)
            (opt-bits-set! row base id)
            unit)
          (set! id (+ id 1))))
      unit)))

(define (opt-dom-init-row!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [words : i64]
  [entry-id : i64]
  [id : i64]) : unit
  (let
    [base : i64 (opt-dom-row-base words id)]
    (begin
      (opt-bits-clear! rows base words)
      (if (array-ref (struct-get index reachable) id)
        (if (= id entry-id)
          (opt-bits-set! rows base id)
          (opt-dom-fill-reachable-universe! index rows base))
        unit))))

(define (opt-dom-init-rows!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [words : i64]
  [entry-id : i64]) : unit
  (let
    [id : i64 0]
    [count : i64 (opt-cfg-index-block-count index)]
    (begin
      (while (< id count)
        (begin
          (opt-dom-init-row! index rows words entry-id id)
          (set! id (+ id 1))))
      unit)))

(define (opt-dom-row-from-preds!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [scratch : (Array i64)]
  [words : i64]
  [id : i64]) : unit
  (let
    [preds : OptCfgCsr (struct-get index preds)]
    [edge : i64 (array-ref (struct-get preds offsets) id)]
    [end : i64 (array-ref (struct-get preds offsets) (+ id 1))]
    [saw : bool false]
    (begin
      (opt-bits-clear! scratch 0 words)
      (opt-dom-fill-reachable-universe! index scratch 0)
      (while (< edge end)
        (let
          [pred : i64 (array-ref (struct-get preds edges) edge)]
          (begin
            (if (array-ref (struct-get index reachable) pred)
              (begin
                (opt-bits-and-into!
                  scratch
                  0
                  rows
                  (opt-dom-row-base words pred)
                  words)
                (set! saw true))
              unit)
            (set! edge (+ edge 1)))))
      (if saw
        unit
        (opt-bits-clear! scratch 0 words))
      (opt-bits-set! scratch 0 id))))

(define (opt-dom-update-row!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [scratch : (Array i64)]
  [words : i64]
  [entry-id : i64]
  [id : i64]) : bool
  (if (or (= id entry-id) (not (array-ref (struct-get index reachable) id)))
    false
    (let
      [base : i64 (opt-dom-row-base words id)]
      (begin
        (opt-dom-row-from-preds! index rows scratch words id)
        (if (opt-bits-eq? rows base scratch 0 words)
          false
          (begin
            (opt-bits-copy! rows base scratch 0 words)
            true))))))

(define (opt-dom-iterate-rpo!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [scratch : (Array i64)]
  [words : i64]
  [entry-id : i64]) : bool
  (let
    [slot : i64 0]
    [changed : bool false]
    (begin
      (while (< slot (struct-get index reach-count))
        (begin
          (if (opt-dom-update-row!
            index
            rows
            scratch
            words
            entry-id
            (opt-cfg-index-rpo-id index slot))
            (set! changed true)
            unit)
          (set! slot (+ slot 1))))
      changed)))

(define (opt-dom-fixpoint!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [scratch : (Array i64)]
  [words : i64]
  [entry-id : i64]
  [remaining : i64]) : unit
  (if (<= remaining 0)
    unit
    (if (opt-dom-iterate-rpo! index rows scratch words entry-id)
      (opt-dom-fixpoint! index rows scratch words entry-id (- remaining 1))
      unit)))

(define (opt-cfg-dominators-bitset-with
  [index : OptCfgIndex]
  [entry-label : i64]) : OptDomInfo
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [words : i64 (opt-bits-words count)]
    [rows : (Array i64) (array.make-array i64 (* count words))]
    [scratch : (Array i64) (array.make-array i64 words)]
    [empty : (Array i64) (array.make-array i64 0)]
    [entry-id : i64 (- 0 1)]
    (begin
      (match (opt-cfg-index-id index entry-label)
        [(option_i64.Some id) (set! entry-id id)]
        [(option_i64.None) unit])
      (opt-dom-init-rows! index rows words entry-id)
      (if (>= entry-id 0)
        (opt-dom-fixpoint! index rows scratch words entry-id (+ count 1))
        unit)
      (OptDomInfo index words rows empty empty empty))))

(define (opt-dom-intersect-idom
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [left : i64]
  [right : i64]) : i64
  (let
    [a : i64 left]
    [b : i64 right]
    (begin
      (while (!= a b)
        (begin
          (while (>
            (opt-cfg-index-rpo-num index a)
            (opt-cfg-index-rpo-num index b))
            (set! a (array-ref idom a)))
          (while (>
            (opt-cfg-index-rpo-num index b)
            (opt-cfg-index-rpo-num index a))
            (set! b (array-ref idom b)))))
      a)))

(define (opt-dom-idom-from-preds
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [id : i64]) : i64
  (let
    [preds : OptCfgCsr (struct-get index preds)]
    [edge : i64 (array-ref (struct-get preds offsets) id)]
    [end : i64 (array-ref (struct-get preds offsets) (+ id 1))]
    [candidate : i64 (- 0 1)]
    (begin
      (while (< edge end)
        (let
          [pred : i64 (array-ref (struct-get preds edges) edge)]
          (begin
            (if (and
              (array-ref (struct-get index reachable) pred)
              (>= (array-ref idom pred) 0))
              (if (< candidate 0)
                (set! candidate pred)
                (set!
                  candidate
                  (opt-dom-intersect-idom index idom pred candidate)))
              unit)
            (set! edge (+ edge 1)))))
      candidate)))

(define (opt-dom-idom-iterate-rpo!
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [entry-id : i64]) : bool
  (let
    [slot : i64 1]
    [changed : bool false]
    (begin
      (while (< slot (struct-get index reach-count))
        (let
          [id : i64 (opt-cfg-index-rpo-id index slot)]
          [new-idom : i64 (opt-dom-idom-from-preds index idom id)]
          (begin
            (if (and
              (!= id entry-id)
              (>= new-idom 0)
              (!= (array-ref idom id) new-idom))
              (begin
                (array-set! idom id new-idom)
                (set! changed true))
              unit)
            (set! slot (+ slot 1)))))
      changed)))

(define (opt-dom-idom-fixpoint!
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [entry-id : i64]
  [remaining : i64]) : unit
  (if (<= remaining 0)
    unit
    (if (opt-dom-idom-iterate-rpo! index idom entry-id)
      (opt-dom-idom-fixpoint! index idom entry-id (- remaining 1))
      unit)))

(define (opt-dom-child-rows-fill!
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [rows : (Array OptI64List)]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [id : i64 0]
    (begin
      (while (< id count)
        (let
          [parent : i64 (array-ref idom id)]
          (begin
            (if (and
              (array-ref (struct-get index reachable) id)
              (>= parent 0)
              (!= parent id))
              (array-set!
                rows
                parent
                (opt-i64-list-add (array-ref rows parent) id))
              unit)
            (set! id (+ id 1)))))
      unit)))

(define (opt-dom-euler-dfs!
  [children : OptCfgCsr]
  [tin : (Array i64)]
  [tout : (Array i64)]
  [id : i64]
  [time : i64]) : i64
  (let
    [next : i64 (+ time 1)]
    [edge : i64 (array-ref (struct-get children offsets) id)]
    [end : i64 (array-ref (struct-get children offsets) (+ id 1))]
    (begin
      (array-set! tin id time)
      (while (< edge end)
        (begin
          (set!
            next
            (opt-dom-euler-dfs!
              children
              tin
              tout
              (array-ref (struct-get children edges) edge)
              next))
          (set! edge (+ edge 1))))
      (array-set! tout id next)
      next)))

(define (opt-dom-build-euler!
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [tin : (Array i64)]
  [tout : (Array i64)]
  [entry-id : i64]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [child-rows : (Array OptI64List) (array.make-array OptI64List count)]
    (begin
      (opt-cfg-fill-i64! tin count (- 0 1))
      (opt-cfg-fill-i64! tout count (- 0 1))
      (if (>= entry-id 0)
        (begin
          (opt-cfg-i64-list-array-fill-empty! child-rows count)
          (opt-dom-child-rows-fill! index idom child-rows)
          (let
            [children : OptCfgCsr (opt-cfg-csr-build child-rows count)]
            (begin
              (opt-dom-euler-dfs! children tin tout entry-id 0)
              unit)))
        unit))))

(define (opt-cfg-dominators-with [index : OptCfgIndex] [entry-label : i64]) : OptDomInfo
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [idom : (Array i64) (array.make-array i64 count)]
    [tin : (Array i64) (array.make-array i64 count)]
    [tout : (Array i64) (array.make-array i64 count)]
    [empty : (Array i64) (array.make-array i64 0)]
    [entry-id : i64 (- 0 1)]
    (begin
      (opt-cfg-fill-i64! idom count (- 0 1))
      (match (opt-cfg-index-id index entry-label)
        [(option_i64.Some id) (set! entry-id id)]
        [(option_i64.None) unit])
      (if (and
        (>= entry-id 0)
        (array-ref (struct-get index reachable) entry-id))
        (begin
          (array-set! idom entry-id entry-id)
          (opt-dom-idom-fixpoint! index idom entry-id (+ count 1))
          (opt-dom-build-euler! index idom tin tout entry-id))
        (begin
          (opt-cfg-fill-i64! tin count (- 0 1))
          (opt-cfg-fill-i64! tout count (- 0 1))))
      (OptDomInfo index 0 empty idom tin tout))))

(define (opt-dom-info-dominates-id?
  [info : OptDomInfo]
  [dominator-id : i64]
  [label-id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and
      (>= dominator-id 0)
      (< dominator-id count)
      (>= label-id 0)
      (< label-id count))
      (if (and
        (array-ref (struct-get index reachable) dominator-id)
        (array-ref (struct-get index reachable) label-id))
        (let
          [dom-tin : i64 (array-ref (struct-get info tin) dominator-id)]
          [dom-tout : i64 (array-ref (struct-get info tout) dominator-id)]
          [label-tin : i64 (array-ref (struct-get info tin) label-id)]
          [label-tout : i64 (array-ref (struct-get info tout) label-id)]
          (and
            (>= dom-tin 0)
            (>= label-tin 0)
            (<= dom-tin label-tin)
            (<= label-tout dom-tout)))
        false)
      false)))

(define (opt-dom-bitset-info-dominates-id?
  [info : OptDomInfo]
  [dominator-id : i64]
  [label-id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and
      (>= dominator-id 0)
      (< dominator-id count)
      (>= label-id 0)
      (< label-id count))
      (if (and
        (array-ref (struct-get index reachable) dominator-id)
        (array-ref (struct-get index reachable) label-id))
        (opt-bits-test
          (struct-get info rows)
          (opt-dom-row-base (struct-get info words) label-id)
          dominator-id)
        false)
      false)))

(define (opt-dom-info-row-matches-legacy?
  [info : OptDomInfo]
  [legacy-labels : OptLabelSet]
  [label-id : i64]
  [dominator-id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= dominator-id count)
      true
      (let
        [label : i64 (opt-cfg-index-label index dominator-id)]
        [legacy-has : bool (opt-label-contains legacy-labels label)]
        [info-has : bool
          (opt-dom-info-dominates-id? info dominator-id label-id)]
        (if (or (and legacy-has info-has) (and (not legacy-has) (not info-has)))
          (opt-dom-info-row-matches-legacy?
            info
            legacy-labels
            label-id
            (+ dominator-id 1))
          false)))))

(define (opt-dom-info-matches-legacy-from?
  [info : OptDomInfo]
  [legacy : OptLegacyDomTable]
  [id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= id count)
      true
      (if (array-ref (struct-get index reachable) id)
        (let
          [label : i64 (opt-cfg-index-label index id)]
          [legacy-labels : OptLabelSet (opt-dom-table-lookup legacy label)]
          (if (opt-dom-info-row-matches-legacy? info legacy-labels id 0)
            (opt-dom-info-matches-legacy-from? info legacy (+ id 1))
            false))
        (opt-dom-info-matches-legacy-from? info legacy (+ id 1))))))

(define (opt-dom-info-matches-legacy?
  [info : OptDomInfo]
  [legacy : OptLegacyDomTable]) : bool
  (opt-dom-info-matches-legacy-from? info legacy 0))

(define (opt-dom-info-row-matches-bitset?
  [info : OptDomInfo]
  [bitset : OptDomInfo]
  [label-id : i64]
  [dominator-id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= dominator-id count)
      true
      (let
        [info-has : bool
          (opt-dom-info-dominates-id? info dominator-id label-id)]
        [bitset-has : bool
          (opt-dom-bitset-info-dominates-id? bitset dominator-id label-id)]
        (if (or (and info-has bitset-has) (and (not info-has) (not bitset-has)))
          (opt-dom-info-row-matches-bitset?
            info
            bitset
            label-id
            (+ dominator-id 1))
          false)))))

(define (opt-dom-info-matches-bitset-from?
  [info : OptDomInfo]
  [bitset : OptDomInfo]
  [id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= id count)
      true
      (if (opt-dom-info-row-matches-bitset? info bitset id 0)
        (opt-dom-info-matches-bitset-from? info bitset (+ id 1))
        false))))

(define (opt-dom-info-matches-bitset? [info : OptDomInfo] [bitset : OptDomInfo]) : bool
  (opt-dom-info-matches-bitset-from? info bitset 0))

(defstruct OptCfgContext
  (index OptCfgIndex)
  (pred-map OptPredMap)
  (reachable OptLabelSet)
  (entry-label i64)
  (doms OptDomInfo))

(define (opt-cfg-context-build [blocks : CompilerIrBlockList]) : OptCfgContext
  (let
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    [pred-map : OptPredMap (OptPredMap index)]
    [reachable : OptLabelSet (opt-cfg-index-reachable-labels index)]
    [entry-label : i64 (opt-cfg-entry-label blocks)]
    [doms : OptDomInfo (opt-cfg-dominators-with index entry-label)]
    (OptCfgContext index pred-map reachable entry-label doms)))

;; A cheap placeholder context built from an empty CFG. Used only as the
;; sentinel paired with a function on the non-heavy pass path, where the threaded
;; context is never consumed (all heavy passes are skipped together).
(define (opt-cfg-context-empty) : OptCfgContext
  (opt-cfg-context-build (CompilerIrBlockList.Nil)))

;; Carries an optimized function together with an OptCfgContext that is
;; valid for the returned function's *current* blocks, so the next pass in
;; optimize-function-once can reuse it for entry verification and dominance
;; queries instead of rebuilding from scratch. The context is only paired with
;; the exact block list it was built from; passes that rewrite the CFG build a
;; fresh context for their output before handing it back.
(defenum OptFunctionCtxResult
  (Result CompilerIrFunction OptCfgContext))

(defenum OptBlockCtxResult
  (Result CompilerIrBlockList OptCfgContext bool))

;; Uniform changed-result carriers. Function-level passes all return
;; OptFunctionPassResult; lower-level helpers use the carrier matching their
;; payload. An unchanged result must carry the exact input value so callers can
;; preserve identity without rebuilding enclosing IR.
(defenum OptFunctionPassResult
  (Result CompilerIrFunction bool))

(defenum OptBlockListPassResult
  (Result CompilerIrBlockList bool))

(defenum OptBlockPassResult
  (Result CompilerIrBlock bool))

(define (opt-cfg-context-all-blocks-reachable? [context : OptCfgContext]) : bool
  (let
    [index : OptCfgIndex (struct-get context index)]
    (= (struct-get index reach-count) (opt-cfg-index-block-count index))))

(define (opt-cfg-dominators [blocks : CompilerIrBlockList]) : OptDomInfo
  (struct-get (opt-cfg-context-build blocks) doms))

(define (opt-cfg-dominators-match-legacy? [blocks : CompilerIrBlockList]) : bool
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (opt-dom-info-matches-legacy?
      (struct-get context doms)
      (opt-cfg-dominators-legacy-with
        blocks
        (struct-get context pred-map)
        (struct-get context reachable)
        (struct-get context entry-label)))))

(define (opt-cfg-dominators-match-bitset? [blocks : CompilerIrBlockList]) : bool
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (opt-dom-info-matches-bitset?
      (struct-get context doms)
      (opt-cfg-dominators-bitset-with
        (struct-get context index)
        (struct-get context entry-label)))))

(define (opt-dom-dominates?
  [table : OptDomInfo]
  [dominator : i64]
  [label : i64]) : bool
  (match (opt-cfg-index-id (struct-get table index) dominator)
    [(option_i64.Some dominator-id)
      (match (opt-cfg-index-id (struct-get table index) label)
        [(option_i64.Some label-id)
          (opt-dom-info-dominates-id? table dominator-id label-id)]
        [(option_i64.None) false])]
    [(option_i64.None) false]))

(define (opt-cfg-frontier-has-reachable-pred-id?
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [label-id : i64]
  [edge : i64]
  [end : i64]) : bool
  (if (>= edge end)
    false
    (let
      [pred-id : i64
        (array-ref (struct-get (struct-get index preds) edges) edge)]
      (if (and
        (array-ref (struct-get index reachable) pred-id)
        (opt-dom-info-dominates-id? doms label-id pred-id))
        true
        (opt-cfg-frontier-has-reachable-pred-id?
          index
          doms
          label-id
          (+ edge 1)
          end)))))

(define (opt-cfg-dominance-frontier-block?
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [label-id : i64]
  [block-id : i64]) : bool
  (let
    [preds : OptCfgCsr (struct-get index preds)]
    (and
      (array-ref (struct-get index reachable) block-id)
      (opt-cfg-frontier-has-reachable-pred-id?
        index
        doms
        label-id
        (array-ref (struct-get preds offsets) block-id)
        (array-ref (struct-get preds offsets) (+ block-id 1)))
      (not
        (and
          (!= label-id block-id)
          (opt-dom-info-dominates-id? doms label-id block-id))))))

;; `remaining` starts as the block list `index` was built from, so the walk
;; position is the block id.
(define (opt-cfg-dominance-frontier-blocks
  [remaining : CompilerIrBlockList]
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [label-id : i64]
  [block-id : i64]) : OptLabelSet
  (match remaining
    [(CompilerIrBlockList.Nil) (OptLabelSet.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block block-label _)
          (let
            [tail : OptLabelSet
              (opt-cfg-dominance-frontier-blocks
                (box-get rest)
                index
                doms
                label-id
                (+ block-id 1))]
            (if (and
              (< block-id (opt-cfg-index-block-count index))
              (opt-cfg-dominance-frontier-block? index doms label-id block-id))
              (opt-label-add tail block-label)
              tail))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-dominance-frontier-blocks
        (compiler-ir-block-seq-to-list seq)
        index
        doms
        label-id
        block-id)]))

(define (opt-cfg-dominance-frontier-with-context
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [label : i64]) : OptLabelSet
  (let
    [index : OptCfgIndex (struct-get context index)]
    [label-id : i64
      (match (opt-cfg-index-id index label)
        [(option_i64.Some id) id]
        [(option_i64.None) (- 0 1)])]
    (opt-cfg-dominance-frontier-blocks
      blocks
      index
      (struct-get context doms)
      label-id
      0)))

(define (opt-cfg-dominance-frontier
  [blocks : CompilerIrBlockList]
  [label : i64]) : OptLabelSet
  (opt-cfg-dominance-frontier-with-context
    blocks
    (opt-cfg-context-build blocks)
    label))

(defenum ResultCompilerOptimizeVerify
  (Ok)
  (Err String))

(define (opt-verify-ok? [result : ResultCompilerOptimizeVerify]) : bool
  (match result
    [(ResultCompilerOptimizeVerify.Ok) true]
    [(ResultCompilerOptimizeVerify.Err _) false]))

(define (opt-verify-error-ok?
  [result : ResultCompilerOptimizeVerify]
  [want : String]) : bool
  (match result
    [(ResultCompilerOptimizeVerify.Err message) (string.eq message want)]
    [(ResultCompilerOptimizeVerify.Ok) false]))

;; The block is the CFG index's dense block id, not its label. Definitions are
;; collected by walking the same block list the paired `OptCfgContext` was built
;; from, and `opt-cfg-index-build` numbers blocks in that walk order, so the
;; position is the id. Recovering it by hashing the label was the single largest
;; `opt-cfg-index-id` caller (refs #5718).
(defenum OptVarDef
  (Def i64 i64 i64))

(defenum OptVarDefList
  (Nil)
  (Cons OptVarDef (Box OptVarDefList)))

(defenum OptMaybeVarDef
  (No)
  (Some OptVarDef))

;; Function virtual-register ids are dense in [0, vars). Verification only
;; needs duplicate membership, so a bitmap avoids hashing every definition and
;; rejects malformed out-of-range ids at the same boundary.
(define (opt-var-set-add-unique! [set : (Array bool)] [var : i64]) : bool
  (if (or (< var 0) (>= var (array-length set)))
    false
    (if (array-ref set var)
      false
      (begin
        (array-set! set var true)
        true))))

(define (opt-instr-def-var [instr : CompilerIrInstr]) : option_i64.Option
  (match instr
    [(CompilerIrInstr.Mov dst _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.Alloc dst _) (option_i64.Some dst)]
    [(CompilerIrInstr.AddrOf dst _) (option_i64.Some dst)]
    [(CompilerIrInstr.Gep dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.Load dst _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.Cast dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.Bitcast dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.BinOp dst _ _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.UnOp dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.LaneId dst _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.Splat dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (option_i64.Some dst)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (option_i64.Some dst)])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (option_i64.Some dst)])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.MaskNot dst _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.MaskReduce dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (option_i64.Some dst)])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (option_i64.Some dst)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (option_i64.Some dst)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
          (option_i64.Some dst)])]
    [(CompilerIrInstr.TailMask dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.EntryArgc dst) (option_i64.Some dst)]
    [(CompilerIrInstr.EntryArgv dst) (option_i64.Some dst)]
    [(CompilerIrInstr.EntryEnvp dst) (option_i64.Some dst)]
    [(CompilerIrInstr.CpuId dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.Xgetbv dst _) (option_i64.Some dst)]
    [(CompilerIrInstr.Syscall dst _) (option_i64.Some dst)]
    [(CompilerIrInstr.Call dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (match result
            [(CompilerIrSpmdCallResult.Unit) (option_i64.None)]
            [(CompilerIrSpmdCallResult.Value dst _ _) (option_i64.Some dst)])])]
    [(CompilerIrInstr.Phi dst _ _) (option_i64.Some dst)]
    ;; Pack/Word define their dst like any scalar op. Without these arms
    ;; the verifier saw every use of a register-group word as use-before-def
    ;; and silently knocked aggregate-using functions out of SSA/GVN/LICM.
    [(CompilerIrInstr.Pack dst _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.Word dst _ _ _) (option_i64.Some dst)]
    [_ (option_i64.None)]))

(define (opt-instr-def-position [instr : CompilerIrInstr] [pos : i64]) : i64
  (match instr
    [(CompilerIrInstr.Phi _ _ _) 0]
    [_ pos]))

(define (opt-verify-param-def-set
  [params : CompilerIrParamList]
  [set : (Array bool)]) : bool
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) true]
    [(CompilerIrParamList.Array seq)
      (opt-verify-param-def-set (compiler-ir-param-seq-to-list seq) set)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ var)
          (and
            (opt-var-set-add-unique! set var)
            (opt-verify-param-def-set (box-get rest) set))])]))

(define (opt-verify-instr-def-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [set : (Array bool)]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs index))
      [(option_i64.Some var)
        (and
          (opt-var-set-add-unique! set var)
          (opt-verify-instr-def-seq-from instrs (+ index 1) set))]
      [(option_i64.None) (opt-verify-instr-def-seq-from instrs (+ index 1) set)])))

(define (opt-verify-block-def-set
  [blocks : CompilerIrBlockList]
  [set : (Array bool)]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (and
            (opt-verify-instr-def-seq-from instrs 0 set)
            (opt-verify-block-def-set (box-get rest) set))])]
    [(CompilerIrBlockList.Array seq)
      (opt-verify-block-def-set (compiler-ir-block-seq-to-list seq) set)]))

(define (opt-verify-single-defs?
  [params : CompilerIrParamList]
  [vars : i64]
  [blocks : CompilerIrBlockList]) : bool
  (if (< vars 0)
    false
    (let
      [set : (Array bool) (array.make-array bool vars)]
      (and
        (opt-verify-param-def-set params set)
        (opt-verify-block-def-set blocks set)))))

(define (opt-var-defs-from-params
  [params : CompilerIrParamList]
  [defs : OptVarDefList]) : OptVarDefList
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) defs]
    [(CompilerIrParamList.Array seq)
      (opt-var-defs-from-params (compiler-ir-param-seq-to-list seq) defs)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ var)
          (opt-var-defs-from-params
            (box-get rest)
            (OptVarDefList.Cons (OptVarDef.Def var 0 0) (box defs)))])]))

(define (opt-var-defs-from-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [block-id : i64]
  [index : i64]
  [pos : i64]
  [defs : OptVarDefList]) : OptVarDefList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    defs
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some var)
          (opt-var-defs-from-instr-seq-from
            instrs
            block-id
            (+ index 1)
            (+ pos 1)
            (OptVarDefList.Cons
              (OptVarDef.Def var block-id (opt-instr-def-position instr pos))
              (box defs)))]
        [(option_i64.None)
          (opt-var-defs-from-instr-seq-from
            instrs
            block-id
            (+ index 1)
            (+ pos 1)
            defs)]))))

(define (opt-var-defs-from-blocks
  [blocks : CompilerIrBlockList]
  [block-id : i64]
  [defs : OptVarDefList]) : OptVarDefList
  (match blocks
    [(CompilerIrBlockList.Nil) defs]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-var-defs-from-blocks
            (box-get rest)
            (+ block-id 1)
            (opt-var-defs-from-instr-seq-from instrs block-id 0 1 defs))])]
    [(CompilerIrBlockList.Array seq)
      (opt-var-defs-from-blocks
        (compiler-ir-block-seq-to-list seq)
        block-id
        defs)]))

;; Parameter definitions belong to the entry block, which `opt-cfg-index-build`
;; always numbers 0. An empty block list has no ids at all, and every id-keyed
;; dominance query range-checks against the block count, so the placeholder 0
;; answers exactly like the old missing-label lookup did.
(define (opt-var-defs-from-function
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptVarDefList
  (opt-var-defs-from-blocks
    blocks
    0
    (opt-var-defs-from-params params (OptVarDefList.Nil))))

;; The use verifier resolves every operand's defining block, so the
;; def list is indexed into a var-id-keyed array once per verification
;; (the list scan per use made the verifier quadratic on large functions).
(define (opt-var-defs-max-id [defs : OptVarDefList] [highest : i64]) : i64
  (match defs
    [(OptVarDefList.Nil) highest]
    [(OptVarDefList.Cons def rest)
      (match def
        [(OptVarDef.Def var _ _)
          (opt-var-defs-max-id
            (box-get rest)
            (if (> var highest)
              var
              highest))])]))

(define (opt-var-defs-index-fill!
  [items : (Array OptMaybeVarDef)]
  [defs : OptVarDefList]) : unit
  (match defs
    [(OptVarDefList.Nil) unit]
    [(OptVarDefList.Cons def rest)
      (begin
        (match def
          [(OptVarDef.Def var _ _)
            (if (and (>= var 0) (< var (array-length items)))
              (array-set! items var (OptMaybeVarDef.Some def))
              unit)])
        (opt-var-defs-index-fill! items (box-get rest)))]))

;; `OptMaybeVarDef.No` is the fieldless tag-0 variant, so its representation is
;; all-zero bytes and `make-array` already produces it for every slot -- see
;; `lower-make-array-zero-fill-enum-supported?`. Re-writing `.No` over the whole
;; array with a scalar loop only repeats what the allocation just did.
(define (opt-var-defs-index [defs : OptVarDefList]) : (Array OptMaybeVarDef)
  (let
    [count : i64 (+ (opt-var-defs-max-id defs (- 0 1)) 1)]
    [items : (Array OptMaybeVarDef) (array.make-array OptMaybeVarDef count)]
    (begin
      (opt-var-defs-index-fill! items defs)
      items)))

(define (opt-var-def-lookup [defs : (Array OptMaybeVarDef)] [var : i64]) : OptMaybeVarDef
  (if (and (>= var 0) (< var (array-length defs)))
    (array-ref defs var)
    (OptMaybeVarDef.No)))

;; Block labels are unique -- every entry point into this family checks that
;; first -- so id equality decides label equality without a `string.eq`.
(define (opt-verify-var-use
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [var : i64]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match (opt-var-def-lookup defs var)
    [(OptMaybeVarDef.No)
      (ResultCompilerOptimizeVerify.Err
        "optimizer verify: use before definition")]
    [(OptMaybeVarDef.Some def)
      (match def
        [(OptVarDef.Def _ def-block def-pos)
          (if (not (opt-dom-info-dominates-id? doms def-block use-block))
            (ResultCompilerOptimizeVerify.Err
              "optimizer verify: use is not dominated by definition")
            (if (and (= def-block use-block) (>= def-pos use-pos))
              (ResultCompilerOptimizeVerify.Err
                "optimizer verify: use before definition")
              (ResultCompilerOptimizeVerify.Ok)))])]))

(define (opt-verify-var-use-on-edge
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [var : i64]
  [pred-label : i64]) : ResultCompilerOptimizeVerify
  (match (opt-var-def-lookup defs var)
    [(OptMaybeVarDef.No)
      (ResultCompilerOptimizeVerify.Err
        "optimizer verify: use before definition")]
    [(OptMaybeVarDef.Some def)
      (match def
        [(OptVarDef.Def _ def-block _)
          (if (opt-dom-info-dominates-id?
            doms
            def-block
            (match (opt-cfg-index-id (struct-get doms index) pred-label)
              [(option_i64.Some pred-id) pred-id]
              [(option_i64.None) (- 0 1)]))
            (ResultCompilerOptimizeVerify.Ok)
            (ResultCompilerOptimizeVerify.Err
              "optimizer verify: use is not dominated by definition"))])]))

(define (opt-verify-value-use
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [value : CompilerIrValue]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match value
    [(CompilerIrValue.Var var)
      (opt-verify-var-use defs doms var use-block use-pos)]
    [_ (ResultCompilerOptimizeVerify.Ok)]))

(define (opt-verify-value-list-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [values : CompilerIrValueList]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match values
    [(CompilerIrValueList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrValueList.Array seq)
      (opt-verify-value-list-uses
        defs
        doms
        (compiler-ir-value-seq-to-list seq)
        use-block
        use-pos)]
    [(CompilerIrValueList.Cons value rest)
      (match (opt-verify-value-use defs doms value use-block use-pos)
        [(ResultCompilerOptimizeVerify.Ok)
          (opt-verify-value-list-uses
            defs
            doms
            (box-get rest)
            use-block
            use-pos)]
        [(ResultCompilerOptimizeVerify.Err message)
          (ResultCompilerOptimizeVerify.Err message)])]))

(define (opt-verify-call-args-array-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [values : (Array CompilerIrValue)]
  [use-block : i64]
  [use-pos : i64]
  [index : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (array-length values))
    (ResultCompilerOptimizeVerify.Ok)
    (match (opt-verify-value-use
      defs
      doms
      (array-ref values index)
      use-block
      use-pos)
      [(ResultCompilerOptimizeVerify.Ok)
        (opt-verify-call-args-array-uses
          defs
          doms
          values
          use-block
          use-pos
          (+ index 1))]
      [(ResultCompilerOptimizeVerify.Err message)
        (ResultCompilerOptimizeVerify.Err message)])))

(define (opt-verify-call-args-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [args : CompilerIrCallArgs]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match args
    [(CompilerIrCallArgs.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrCallArgs.One value)
      (opt-verify-value-use defs doms value use-block use-pos)]
    [(CompilerIrCallArgs.Two a b)
      (opt-verify-two
        (opt-verify-value-use defs doms a use-block use-pos)
        (opt-verify-value-use defs doms b use-block use-pos))]
    [(CompilerIrCallArgs.Array values)
      (opt-verify-call-args-array-uses defs doms values use-block use-pos 0)]))

(define (opt-verify-spmd-call-args-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [args : CompilerIrSpmdCallArgList]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match args
    [(CompilerIrSpmdCallArgList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (opt-verify-two
            (opt-verify-value-use defs doms value use-block use-pos)
            (opt-verify-spmd-call-args-uses
              defs
              doms
              (box-get rest)
              use-block
              use-pos))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [i : i64 0]
        [result : ResultCompilerOptimizeVerify
          (ResultCompilerOptimizeVerify.Ok)]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (begin
          (while (< i count)
            (match result
              [(ResultCompilerOptimizeVerify.Err _) (set! i count)]
              [(ResultCompilerOptimizeVerify.Ok)
                (begin
                  (match (array-ref slots i)
                    [(CompilerIrSpmdCallArg.Arg _ value _)
                      (set!
                        result
                        (opt-verify-value-use defs doms value use-block use-pos))])
                  (set! i (+ i 1)))]))
          result))]))

(define (opt-verify-maybe-value-use
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [value : CompilerIrMaybeValue]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match value
    [(CompilerIrMaybeValue.No) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrMaybeValue.Some inner)
      (opt-verify-value-use defs doms inner use-block use-pos)]))

(define (opt-verify-phi-input-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [inputs : CompilerIrPhiInputList]) : ResultCompilerOptimizeVerify
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-verify-phi-input-uses
        defs
        doms
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value pred-label rest)
      (match value
        [(CompilerIrValue.Var var)
          (match (opt-verify-var-use-on-edge defs doms var pred-label)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-phi-input-uses defs doms (box-get rest))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err message)])]
        [_ (opt-verify-phi-input-uses defs doms (box-get rest))])]))

(define (opt-verify-two
  [a : ResultCompilerOptimizeVerify]
  [b : ResultCompilerOptimizeVerify]) : ResultCompilerOptimizeVerify
  (match a
    [(ResultCompilerOptimizeVerify.Ok) b]
    [(ResultCompilerOptimizeVerify.Err message)
      (ResultCompilerOptimizeVerify.Err message)]))

(define (opt-verify-instr-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [block-id : i64]
  [pos : i64]
  [instr : CompilerIrInstr]) : ResultCompilerOptimizeVerify
  (match instr
    [(CompilerIrInstr.Mov _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.AddrOf _ src)
      (opt-verify-var-use defs doms src block-id pos)]
    [(CompilerIrInstr.Gep _ base offset _)
      (opt-verify-two
        (opt-verify-value-use defs doms base block-id pos)
        (opt-verify-value-use defs doms offset block-id pos))]
    [(CompilerIrInstr.Load _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.StorePtr ptr value _)
      (opt-verify-two
        (opt-verify-value-use defs doms ptr block-id pos)
        (opt-verify-value-use defs doms value block-id pos))]
    [(CompilerIrInstr.CopyBytes dst src _)
      (opt-verify-two
        (opt-verify-value-use defs doms dst block-id pos)
        (opt-verify-value-use defs doms src block-id pos))]
    [(CompilerIrInstr.BoundsCheck index length _)
      (opt-verify-two
        (opt-verify-value-use defs doms index block-id pos)
        (opt-verify-value-use defs doms length block-id pos))]
    [(CompilerIrInstr.Cast _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (opt-verify-two
        (opt-verify-value-use defs doms lhs block-id pos)
        (opt-verify-value-use defs doms rhs block-id pos))]
    [(CompilerIrInstr.UnOp _ _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.Splat _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms lhs block-id pos)
            (opt-verify-value-use defs doms rhs block-id pos))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms src block-id pos)
            (opt-verify-value-use defs doms carry block-id pos))])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms lhs block-id pos)
            (opt-verify-value-use defs doms rhs block-id pos))])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-verify-two
        (opt-verify-value-use defs doms lhs block-id pos)
        (opt-verify-value-use defs doms rhs block-id pos))]
    [(CompilerIrInstr.MaskNot _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms mask block-id pos)
            (opt-verify-two
              (opt-verify-value-use defs doms on-true block-id pos)
              (opt-verify-value-use defs doms on-false block-id pos)))])]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (opt-verify-two
        (opt-verify-value-use defs doms base block-id pos)
        (opt-verify-value-use defs doms index block-id pos))]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-id pos)
            (opt-verify-two
              (opt-verify-value-use defs doms index block-id pos)
              (opt-verify-value-use defs doms value block-id pos)))])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            _
            _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-id pos)
            (opt-verify-two
              (opt-verify-value-use defs doms index block-id pos)
              (opt-verify-two
                (opt-verify-value-use defs doms value block-id pos)
                (opt-verify-value-use defs doms mask block-id pos))))])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base index mask _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-id pos)
            (opt-verify-two
              (opt-verify-value-use defs doms index block-id pos)
              (opt-verify-value-use defs doms mask block-id pos)))])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            _
            base
            index-base
            index
            _
            _
            _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-id pos)
            (opt-verify-two
              (opt-verify-value-use defs doms index-base block-id pos)
              (opt-verify-value-use defs doms index block-id pos)))])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (opt-verify-two
            (opt-verify-value-use defs doms source block-id pos)
            (opt-verify-two
              (opt-verify-value-use defs doms selector-low block-id pos)
              (opt-verify-two
                (opt-verify-maybe-value-use
                  defs
                  doms
                  selector-high
                  block-id
                  pos)
                (opt-verify-value-use defs doms active-lanes block-id pos))))])]
    [(CompilerIrInstr.TailMask _ index length _)
      (opt-verify-two
        (opt-verify-value-use defs doms index block-id pos)
        (opt-verify-value-use defs doms length block-id pos))]
    [(CompilerIrInstr.EntryArgc _) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrInstr.EntryArgv _) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrInstr.EntryEnvp _) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-verify-two
        (opt-verify-value-use defs doms leaf block-id pos)
        (opt-verify-value-use defs doms subleaf block-id pos))]
    [(CompilerIrInstr.Xgetbv _ index)
      (opt-verify-value-use defs doms index block-id pos)]
    [(CompilerIrInstr.Syscall _ args)
      (opt-verify-call-args-uses defs doms args block-id pos)]
    [(CompilerIrInstr.Call _ _ args _)
      (opt-verify-call-args-uses defs doms args block-id pos)]
    [(CompilerIrInstr.CallIndirect _ func args _)
      (opt-verify-two
        (opt-verify-value-use defs doms func block-id pos)
        (opt-verify-call-args-uses defs doms args block-id pos))]
    [(CompilerIrInstr.CallIndirectC _ func args _)
      (opt-verify-two
        (opt-verify-value-use defs doms func block-id pos)
        (opt-verify-call-args-uses defs doms args block-id pos))]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base _ args _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-id pos)
            (opt-verify-call-args-uses defs doms args block-id pos))])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-id pos)
            (opt-verify-two
              (opt-verify-value-use defs doms func block-id pos)
              (opt-verify-call-args-uses defs doms args block-id pos)))])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (opt-verify-two
            (opt-verify-value-use defs doms active-mask block-id pos)
            (opt-verify-spmd-call-args-uses defs doms args block-id pos))])]
    [(CompilerIrInstr.TailCall _ args _)
      (opt-verify-call-args-uses defs doms args block-id pos)]
    [(CompilerIrInstr.Store _ value _)
      (opt-verify-value-use defs doms value block-id pos)]
    [(CompilerIrInstr.Branch cond _ _)
      (opt-verify-value-use defs doms cond block-id pos)]
    [(CompilerIrInstr.Return maybe)
      (opt-verify-maybe-value-use defs doms maybe block-id pos)]
    [(CompilerIrInstr.Phi _ inputs _)
      (opt-verify-phi-input-uses defs doms inputs)]
    [(CompilerIrInstr.Alloc _ _) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrInstr.LaneId _ _ _) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrInstr.Jump _) (ResultCompilerOptimizeVerify.Ok)]
    ;; Verify register-group operands dominate their use.
    [(CompilerIrInstr.Pack _ words _)
      (opt-verify-value-list-uses defs doms words block-id pos)]
    [(CompilerIrInstr.Word _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(CompilerIrInstr.TailCallIndirect func args _)
      (opt-verify-two
        (opt-verify-value-use defs doms func block-id pos)
        (opt-verify-call-args-uses defs doms args block-id pos))]
    [(CompilerIrInstr.Switch index _ _ _)
      (opt-verify-value-use defs doms index block-id pos)]))

(define (opt-verify-instr-seq-uses-from
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [block-id : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [pos : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (ResultCompilerOptimizeVerify.Ok)
    (match (opt-verify-instr-uses
      defs
      doms
      block-id
      pos
      (compiler-ir-instr-seq-ref instrs index))
      [(ResultCompilerOptimizeVerify.Ok)
        (opt-verify-instr-seq-uses-from
          defs
          doms
          block-id
          instrs
          (+ index 1)
          (+ pos 1))]
      [(ResultCompilerOptimizeVerify.Err message)
        (ResultCompilerOptimizeVerify.Err message)])))

(define (opt-phi-input-labels [inputs : CompilerIrPhiInputList]) : OptLabelSet
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (OptLabelSet.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-phi-input-labels (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons _ label rest)
      (opt-label-add (opt-phi-input-labels (box-get rest)) label)]))

(define (opt-phi-input-labels-unique-from?
  [inputs : CompilerIrPhiInputList]
  [seen : OptLabelSet]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) true]
    [(CompilerIrPhiInputList.Array seq)
      (opt-phi-input-labels-unique-from?
        (compiler-ir-phi-input-seq-to-list seq)
        seen)]
    [(CompilerIrPhiInputList.Cons _ label rest)
      (if (opt-label-contains seen label)
        false
        (opt-phi-input-labels-unique-from?
          (box-get rest)
          (opt-label-add seen label)))]))

(define (opt-phi-input-labels-match?
  [inputs : CompilerIrPhiInputList]
  [preds : OptLabelSet]) : bool
  (and
    (opt-phi-input-labels-unique-from? inputs (OptLabelSet.Nil))
    (opt-label-set-eq? (opt-phi-input-labels inputs) preds)))

(define (opt-verify-phi-predecessors-instr-seq-from
  [pred-map : OptPredMap]
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (ResultCompilerOptimizeVerify.Ok)
    (match (& (array-ref (struct-get instrs slots) index))
      [(CompilerIrInstr.Phi _ _ _)
        (match (compiler-ir-instr-seq-ref instrs index)
          [(CompilerIrInstr.Phi _ inputs _)
            (if (opt-phi-input-labels-match?
              inputs
              (opt-pred-map-lookup pred-map block-label))
              (opt-verify-phi-predecessors-instr-seq-from
                pred-map
                block-label
                instrs
                (+ index 1))
              (ResultCompilerOptimizeVerify.Err
                "optimizer verify: phi predecessor mismatch"))]
          [_
            (opt-verify-phi-predecessors-instr-seq-from
              pred-map
              block-label
              instrs
              (+ index 1))])]
      [_
        (opt-verify-phi-predecessors-instr-seq-from
          pred-map
          block-label
          instrs
          (+ index 1))])))

(define (opt-verify-phi-predecessors-blocks
  [pred-map : OptPredMap]
  [remaining : CompilerIrBlockList]) : ResultCompilerOptimizeVerify
  (match remaining
    [(CompilerIrBlockList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (match (opt-verify-phi-predecessors-instr-seq-from
            pred-map
            label
            instrs
            0)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-phi-predecessors-blocks pred-map (box-get rest))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err message)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-verify-phi-predecessors-blocks
        pred-map
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-verify-block-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [blocks : CompilerIrBlockList]
  [block-id : i64]) : ResultCompilerOptimizeVerify
  (match blocks
    [(CompilerIrBlockList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (opt-verify-instr-seq-uses-from defs doms block-id instrs 0 1)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-block-uses defs doms (box-get rest) (+ block-id 1))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err message)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-verify-block-uses
        defs
        doms
        (compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-verify-instr-seq-uses-contextual
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [block-id : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [pos : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (ResultCompilerOptimizeVerify.Ok)
    (match (opt-verify-instr-uses
      defs
      doms
      block-id
      pos
      (compiler-ir-instr-seq-ref instrs index))
      [(ResultCompilerOptimizeVerify.Ok)
        (opt-verify-instr-seq-uses-contextual
          defs
          doms
          block-id
          instrs
          (+ index 1)
          (+ pos 1))]
      [(ResultCompilerOptimizeVerify.Err message)
        (ResultCompilerOptimizeVerify.Err
          (str_cat.str-cat
            "block "
            (compiler-ir-label-text
              (opt-cfg-index-label (struct-get doms index) block-id))
            " instruction "
            (string.int->string index)
            ": "
            message))])))

(define (opt-verify-block-uses-contextual
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [blocks : CompilerIrBlockList]
  [block-id : i64]) : ResultCompilerOptimizeVerify
  (match blocks
    [(CompilerIrBlockList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (opt-verify-instr-seq-uses-contextual
            defs
            doms
            block-id
            instrs
            0
            1)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-block-uses-contextual
                defs
                doms
                (box-get rest)
                (+ block-id 1))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err message)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-verify-block-uses-contextual
        defs
        doms
        (compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-verify-function-body-with-context
  [func : CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (match func
    [(CompilerIrFunction.Function _ params _ vars blocks)
      (cond
        [(not (opt-verify-single-defs? params vars blocks))
          (ResultCompilerOptimizeVerify.Err
            "optimizer verify: duplicate var definition")]
        [else
          (let
            [doms : OptDomInfo (struct-get context doms)]
            [pred-map : OptPredMap (struct-get context pred-map)]
            [defs : (Array OptMaybeVarDef)
              (opt-var-defs-index (opt-var-defs-from-function params blocks))]
            (match (opt-verify-phi-predecessors-blocks pred-map blocks)
              [(ResultCompilerOptimizeVerify.Ok)
                (opt-verify-block-uses defs doms blocks 0)]
              [(ResultCompilerOptimizeVerify.Err message)
                (ResultCompilerOptimizeVerify.Err message)]))])]))

(define (opt-verify-final-function-body-with-context
  [func : CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (match func
    [(CompilerIrFunction.Function _ params _ vars blocks)
      (cond
        [(not (opt-verify-single-defs? params vars blocks))
          (ResultCompilerOptimizeVerify.Err
            "optimizer verify: duplicate var definition")]
        [else
          (let
            [doms : OptDomInfo (struct-get context doms)]
            [pred-map : OptPredMap (struct-get context pred-map)]
            [defs : (Array OptMaybeVarDef)
              (opt-var-defs-index (opt-var-defs-from-function params blocks))]
            (match (opt-verify-phi-predecessors-blocks pred-map blocks)
              [(ResultCompilerOptimizeVerify.Ok)
                (opt-verify-block-uses-contextual defs doms blocks 0)]
              [(ResultCompilerOptimizeVerify.Err message)
                (ResultCompilerOptimizeVerify.Err message)]))])]))

;; The structural CFG contract, read off the context's index rather than
;; recomputed. `context` must be valid for the function's blocks, which is the
;; standing pairing invariant for every `*-with-context` entry point.
(define (opt-verify-structure [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (let
    [index : OptCfgIndex (struct-get context index)]
    (cond
      [(not (opt-cfg-index-labels-unique? index))
        (ResultCompilerOptimizeVerify.Err
          "optimizer verify: duplicate block label")]
      [(not (struct-get index targets-known))
        (ResultCompilerOptimizeVerify.Err
          "optimizer verify: unknown successor label")]
      [else (ResultCompilerOptimizeVerify.Ok)])))

(define (opt-verify-function-with-context
  [func : CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (match (opt-verify-structure context)
    [(ResultCompilerOptimizeVerify.Ok)
      (opt-verify-function-body-with-context func context)]
    [(ResultCompilerOptimizeVerify.Err message)
      (ResultCompilerOptimizeVerify.Err message)]))

;; Pipeline-level verification consolidation: the opt2 pipeline verifies the
;; SSA function once per iteration before the loop-pass cluster and threads
;; the result through `verified?`. Passes in the cluster then skip their own
;; entry verify -- each pass in the cluster preserves IR validity for valid
;; input, and every mutating pass still post-verifies its own rewrite when it
;; changed something, so the per-pass entry verify only repeated the upstream
;; result. Callers outside the pipeline (tests, standalone drivers) pass
;; `false` and keep the defensive entry verify.
(define (opt-verify-gate
  [verified? : bool]
  [func : CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (if verified?
    (ResultCompilerOptimizeVerify.Ok)
    (opt-verify-function-with-context func context)))

(define (opt-verify-function [func : CompilerIrFunction]) : ResultCompilerOptimizeVerify
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-verify-function-with-context func (opt-cfg-context-build blocks))]))

(define (opt-verify-final-function [func : CompilerIrFunction]) : ResultCompilerOptimizeVerify
  (match func
    [(CompilerIrFunction.Function _ params _ vars blocks)
      (let
        [context : OptCfgContext (opt-cfg-context-build blocks)]
        (match (opt-verify-structure context)
          [(ResultCompilerOptimizeVerify.Ok)
            ;; Final backend IR is not required to be SSA. Apply dominance/use
            ;; checks when it is SSA-shaped; otherwise the structural CFG checks
            ;; are the valid final-IR contract.
            (if (opt-verify-single-defs? params vars blocks)
              (opt-verify-final-function-body-with-context func context)
              (ResultCompilerOptimizeVerify.Ok))]
          [(ResultCompilerOptimizeVerify.Err message)
            (ResultCompilerOptimizeVerify.Err message)]))]))

(define (opt-verify-function-list [functions : CompilerIrFunctionList]) : ResultCompilerOptimizeVerify
  (match (compiler-ir-function-list-force-cons functions)
    [(CompilerIrFunctionList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(CompilerIrFunctionList.Array seq)
      (opt-verify-function-list (compiler-ir-function-seq-to-list seq))]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ _)
          (match (opt-verify-final-function func)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-function-list (box-get rest))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err
                (str_cat.str-cat
                  "function @"
                  (compiler-ir-symbol-text name)
                  ": "
                  message))])])]))

(define (opt-verify-program [program : CompilerIrProgram]) : ResultCompilerOptimizeVerify
  (match program
    [(CompilerIrProgram.Program _ functions _)
      (opt-verify-function-list functions)]))

(define (compiler-opt-debug-finish-program [program : CompilerIrProgram]) : CompilerIrProgram
  (begin
    (if compiler-opt-debug-verify-ir
      (match (opt-verify-program program)
        [(ResultCompilerOptimizeVerify.Ok)
          (set! compiler-opt-debug-verify-error "")]
        [(ResultCompilerOptimizeVerify.Err message)
          (set! compiler-opt-debug-verify-error message)])
      unit)
    program))

(define (compiler-optimize-debug-verifier-self-test) : i64
  (let
    [name : i64 (compiler-ir-test-symbol "debug-invalid")]
    [blocks : CompilerIrBlockList
      (compiler-ir-block-cons
        (compiler-ir-block
          (compiler-ir-label "entry")
          (compiler-ir-instr-cons
            (CompilerIrInstr.Return
              (CompilerIrMaybeValue.Some (CompilerIrValue.Var 0)))
            CompilerIrInstrList.Nil))
        CompilerIrBlockList.Nil)]
    [program : CompilerIrProgram
      (CompilerIrProgram.Program
        CompilerIrGlobalList.Nil
        (compiler-ir-function-cons
          (CompilerIrFunction.Function
            name
            CompilerIrParamList.Nil
            (AstType.I64)
            1
            blocks)
          CompilerIrFunctionList.Nil)
        CompilerIrExternList.Nil)]
    (match (opt-verify-program program)
      [(ResultCompilerOptimizeVerify.Err message)
        (if (string.eq
          message
          "function @debug-invalid: block entry instruction 0: optimizer verify: use before definition")
          42
          1)]
      [(ResultCompilerOptimizeVerify.Ok) 2])))

;; --- standalone scalar SSA construction / mem2reg --------------------------
;;
;; This constructor rewrites repeated scalar virtual-register definitions into
;; single-assignment form and inserts phis at dominance frontiers. It is
;; deliberately verifier-gated: unsupported shapes leave the function unchanged.
;; This first slice handles functions without pre-existing phi nodes, which keeps
;; edge-sensitive phi-input rewriting separate from the lowering-time phis.
(defenum OptMaybeAstType
  (No)
  (Some AstType))

(defenum OptSsaVarTypes
  (Nil)
  (Cons i64 AstType (Box OptSsaVarTypes)))

(defenum OptSsaFacts
  (Facts opt_i64_i64_map.Map opt_i64_i64_map.Map OptSsaVarTypes))

(defenum OptSsaVarBlocks
  (Nil)
  (Cons i64 OptLabelSet (Array bool) (Box OptSsaVarBlocks)))

(defenum OptSsaPhiSite
  (Site i64 i64 AstType i64))

(defenum OptSsaPhiSites
  (Nil)
  (Cons OptSsaPhiSite (Box OptSsaPhiSites)))

(defenum OptSsaPhiInsertState
  (State OptSsaPhiSites i64 OptLabelSet (Array bool) (Array bool)))

(defenum OptSsaRenameEnv
  (Nil)
  (Cons i64 i64 (Box OptSsaRenameEnv)))

(defenum OptSsaRenameBlock
  (Block i64 CompilerIrInstrList))

(defenum OptSsaRenameBlocks
  (Nil)
  (Cons OptSsaRenameBlock (Box OptSsaRenameBlocks)))

(defenum OptSsaBlockOut
  (Out i64 OptSsaRenameEnv))

(defenum OptSsaBlockOuts
  (Nil)
  (Cons OptSsaBlockOut (Box OptSsaBlockOuts)))

(defenum OptSsaRenameState
  (State OptSsaRenameBlocks OptSsaBlockOuts i64))

(defenum OptSsaDstResult
  (Result i64 OptSsaRenameEnv i64))

(defenum OptSsaInstrResult
  (Result CompilerIrInstr OptSsaRenameEnv i64))

(defenum OptSsaBlockResult
  (Result CompilerIrInstrList OptSsaRenameEnv i64))

(define (opt-ssa-count [counts : opt_i64_i64_map.Map] [var : i64]) : i64
  (match (opt_i64_i64_map.get (& counts) var)
    [(opt_i64_i64_map.LookupFound n) n]
    [(opt_i64_i64_map.LookupMissing) 0]))

(define (opt-ssa-count-add [counts : opt_i64_i64_map.Map] [var : i64]) : opt_i64_i64_map.Map
  (let
    [next-count : i64 (+ 1 (opt-ssa-count counts var))]
    [out : opt_i64_i64_map.Map counts]
    (begin
      (opt_i64_i64_map.insert-ref! (&mut out) var next-count)
      out)))

(define (opt-ssa-scalar-type? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [(AstType.Ref _ _) true]
    [(AstType.MutRef _ _) true]
    [_ false]))

(define (opt-ssa-var-type-lookup [types : OptSsaVarTypes] [var : i64]) : OptMaybeAstType
  (match types
    [(OptSsaVarTypes.Nil) (OptMaybeAstType.No)]
    [(OptSsaVarTypes.Cons id ty rest)
      (if (= id var)
        (OptMaybeAstType.Some ty)
        (opt-ssa-var-type-lookup (box-get rest) var))]))

(define (opt-ssa-facts-bad-var [facts : OptSsaFacts] [var : i64]) : OptSsaFacts
  (match facts
    [(OptSsaFacts.Facts counts bad types)
      (OptSsaFacts.Facts counts (opt-used-add bad var) types)]))

(define (opt-ssa-facts-add-def-bad [facts : OptSsaFacts] [var : i64]) : OptSsaFacts
  (match facts
    [(OptSsaFacts.Facts counts bad types)
      (OptSsaFacts.Facts
        (opt-ssa-count-add counts var)
        (opt-used-add bad var)
        types)]))

(define (opt-ssa-facts-add-def-ty
  [type-segment-bases : i64]
  [facts : OptSsaFacts]
  [var : i64]
  [ty : AstType]) : OptSsaFacts
  (match facts
    [(OptSsaFacts.Facts counts bad types)
      (let
        [next-counts : opt_i64_i64_map.Map (opt-ssa-count-add counts var)]
        (if (not (opt-ssa-scalar-type? ty))
          (OptSsaFacts.Facts next-counts (opt-used-add bad var) types)
          (match (opt-ssa-var-type-lookup types var)
            [(OptMaybeAstType.No)
              (OptSsaFacts.Facts
                next-counts
                bad
                (OptSsaVarTypes.Cons var ty (box types)))]
            [(OptMaybeAstType.Some old)
              (OptSsaFacts.Facts
                next-counts
                (if (opt-type-eq type-segment-bases old ty)
                  bad
                  (opt-used-add bad var))
                types)])))]))

(define (opt-ssa-facts-add-param
  [type-segment-bases : i64]
  [facts : OptSsaFacts]
  [param : CompilerIrParam]) : OptSsaFacts
  (match param
    [(CompilerIrParam.Param _ ty var)
      (opt-ssa-facts-add-def-ty type-segment-bases facts var ty)]))

(define (opt-ssa-facts-add-params
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [facts : OptSsaFacts]) : OptSsaFacts
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) facts]
    [(CompilerIrParamList.Array seq)
      (opt-ssa-facts-add-params
        type-segment-bases
        (compiler-ir-param-seq-to-list seq)
        facts)]
    [(CompilerIrParamList.Cons param rest)
      (opt-ssa-facts-add-params
        type-segment-bases
        (box-get rest)
        (opt-ssa-facts-add-param type-segment-bases facts param))]))

(define (opt-ssa-facts-add-instr
  [type-segment-bases : i64]
  [facts : OptSsaFacts]
  [instr : CompilerIrInstr]) : OptSsaFacts
  (match instr
    [(CompilerIrInstr.Mov dst _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(CompilerIrInstr.Load dst _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(CompilerIrInstr.Cast dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(CompilerIrInstr.Bitcast dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(CompilerIrInstr.BinOp dst op _ _ ty)
      (opt-ssa-facts-add-def-ty
        type-segment-bases
        facts
        dst
        (compiler-ir-binop-result-type op ty))]
    [(CompilerIrInstr.UnOp dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(CompilerIrInstr.Call dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(CompilerIrInstr.CallIndirect dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(CompilerIrInstr.CallIndirectC dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (match result
            [(CompilerIrSpmdCallResult.Unit) facts]
            [(CompilerIrSpmdCallResult.Value dst class ty)
              (match class
                [(CompilerIrSpmdValueClass.Uniform)
                  (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
                [(CompilerIrSpmdValueClass.Varying)
                  (opt-ssa-facts-add-def-bad facts dst)]
                [(CompilerIrSpmdValueClass.Mask)
                  (opt-ssa-facts-add-def-bad facts dst)])])])]
    [(CompilerIrInstr.Phi dst _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(CompilerIrInstr.EntryArgc dst)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst (AstType.I64))]
    [(CompilerIrInstr.AddrOf dst src)
      (opt-ssa-facts-bad-var (opt-ssa-facts-add-def-bad facts dst) src)]
    [(CompilerIrInstr.Alloc dst _) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.Gep dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.LaneId dst _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.Splat dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.MaskNot dst _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(CompilerIrInstr.TailMask dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.EntryArgv dst) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.EntryEnvp dst) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.CpuId dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.Xgetbv dst _) (opt-ssa-facts-add-def-bad facts dst)]
    [(CompilerIrInstr.Syscall dst _) (opt-ssa-facts-add-def-bad facts dst)]
    [_ facts]))

(define (opt-ssa-facts-add-instr-seq-from
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [facts : OptSsaFacts]) : OptSsaFacts
  (if (>= index (compiler-ir-instr-seq-count instrs))
    facts
    (opt-ssa-facts-add-instr-seq-from
      type-segment-bases
      instrs
      (+ index 1)
      (opt-ssa-facts-add-instr
        type-segment-bases
        facts
        (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-ssa-facts-add-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]) : OptSsaFacts
  (match blocks
    [(CompilerIrBlockList.Nil) facts]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-ssa-facts-add-blocks
            type-segment-bases
            (box-get rest)
            (opt-ssa-facts-add-instr-seq-from type-segment-bases instrs 0 facts))])]
    [(CompilerIrBlockList.Array seq)
      (opt-ssa-facts-add-blocks
        type-segment-bases
        (compiler-ir-block-seq-to-list seq)
        facts)]))

(define (opt-ssa-facts-from-function
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptSsaFacts
  (opt-ssa-facts-add-blocks
    type-segment-bases
    blocks
    (opt-ssa-facts-add-params
      type-segment-bases
      params
      (OptSsaFacts.Facts
        (opt_i64_i64_map.with-capacity 64)
        (opt_i64_i64_map.with-capacity 64)
        (OptSsaVarTypes.Nil)))))

(define (opt-ssa-candidate? [facts : OptSsaFacts] [var : i64]) : bool
  (match facts
    [(OptSsaFacts.Facts counts bad types)
      (and
        (> (opt-ssa-count counts var) 1)
        (not (opt-used-contains bad var))
        (match (opt-ssa-var-type-lookup types var)
          [(OptMaybeAstType.Some _) true]
          [(OptMaybeAstType.No) false]))]))

(define (opt-ssa-any-candidate-types?
  [facts : OptSsaFacts]
  [types : OptSsaVarTypes]) : bool
  (match types
    [(OptSsaVarTypes.Nil) false]
    [(OptSsaVarTypes.Cons var _ rest)
      (if (opt-ssa-candidate? facts var)
        true
        (opt-ssa-any-candidate-types? facts (box-get rest)))]))

(define (opt-ssa-any-candidate? [facts : OptSsaFacts]) : bool
  (match facts
    [(OptSsaFacts.Facts _ _ types) (opt-ssa-any-candidate-types? facts types)]))

(define (opt-ssa-label-members-new [index : OptCfgIndex]) : (Array bool)
  (array.make-array bool (opt-cfg-index-block-count index)))

(define (opt-ssa-label-member? [members : (Array bool)] [id : i64]) : bool
  (if (and (>= id 0) (< id (array-length members)))
    (array-ref members id)
    false))

(define (opt-ssa-label-add-with-members
  [index : OptCfgIndex]
  [members : (Array bool)]
  [labels : OptLabelSet]
  [label : i64]) : OptLabelSet
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id)
      (if (opt-ssa-label-member? members id)
        labels
        (begin
          (array-set! members id true)
          (opt-label-cons label labels)))]
    [(option_i64.None) (opt-label-add labels label)]))

(define (opt-ssa-label-mark-members!
  [index : OptCfgIndex]
  [members : (Array bool)]
  [labels : OptLabelSet]) : unit
  (match labels
    [(OptLabelSet.Nil) unit]
    [(OptLabelSet.Dense _ _)
      (begin
        (match (opt-cfg-index-id index (opt-label-ref labels 0))
          [(option_i64.Some id)
            (if (and (>= id 0) (< id (array-length members)))
              (array-set! members id true)
              unit)]
          [(option_i64.None) unit])
        (opt-ssa-label-mark-members! index members (opt-label-tail labels)))]))

(define (opt-ssa-var-blocks-add
  [index : OptCfgIndex]
  [blocks : OptSsaVarBlocks]
  [var : i64]
  [label : i64]) : OptSsaVarBlocks
  (match blocks
    [(OptSsaVarBlocks.Nil)
      (let
        [members : (Array bool) (opt-ssa-label-members-new index)]
        [labels : OptLabelSet
          (opt-ssa-label-add-with-members index members (OptLabelSet.Nil) label)]
        (OptSsaVarBlocks.Cons var labels members (box (OptSsaVarBlocks.Nil))))]
    [(OptSsaVarBlocks.Cons id labels members rest)
      (if (= id var)
        (OptSsaVarBlocks.Cons
          id
          (opt-ssa-label-add-with-members index members labels label)
          members
          rest)
        (OptSsaVarBlocks.Cons
          id
          labels
          members
          (box (opt-ssa-var-blocks-add index (box-get rest) var label))))]))

(define (opt-ssa-var-blocks-lookup [blocks : OptSsaVarBlocks] [var : i64]) : OptLabelSet
  (match blocks
    [(OptSsaVarBlocks.Nil) (OptLabelSet.Nil)]
    [(OptSsaVarBlocks.Cons id labels _ rest)
      (if (= id var)
        labels
        (opt-ssa-var-blocks-lookup (box-get rest) var))]))

(define (opt-ssa-def-blocks-add-param
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : i64]
  [defs : OptSsaVarBlocks]
  [param : CompilerIrParam]) : OptSsaVarBlocks
  (match param
    [(CompilerIrParam.Param _ _ var)
      (if (opt-ssa-candidate? facts var)
        (opt-ssa-var-blocks-add index defs var label)
        defs)]))

(define (opt-ssa-def-blocks-add-params
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : i64]
  [defs : OptSsaVarBlocks]
  [params : CompilerIrParamList]) : OptSsaVarBlocks
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) defs]
    [(CompilerIrParamList.Array seq)
      (opt-ssa-def-blocks-add-params
        index
        facts
        label
        defs
        (compiler-ir-param-seq-to-list seq))]
    [(CompilerIrParamList.Cons param rest)
      (opt-ssa-def-blocks-add-params
        index
        facts
        label
        (opt-ssa-def-blocks-add-param index facts label defs param)
        (box-get rest))]))

(define (opt-ssa-def-blocks-add-instr
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : i64]
  [defs : OptSsaVarBlocks]
  [instr : CompilerIrInstr]) : OptSsaVarBlocks
  (match (opt-instr-def-var instr)
    [(option_i64.Some var)
      (if (opt-ssa-candidate? facts var)
        (opt-ssa-var-blocks-add index defs var label)
        defs)]
    [(option_i64.None) defs]))

(define (opt-ssa-def-blocks-add-instr-seq-from
  [cfg-index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [instr-index : i64]
  [defs : OptSsaVarBlocks]) : OptSsaVarBlocks
  (if (>= instr-index (compiler-ir-instr-seq-count instrs))
    defs
    (opt-ssa-def-blocks-add-instr-seq-from
      cfg-index
      facts
      label
      instrs
      (+ instr-index 1)
      (opt-ssa-def-blocks-add-instr
        cfg-index
        facts
        label
        defs
        (compiler-ir-instr-seq-ref instrs instr-index)))))

(define (opt-ssa-def-blocks-add-blocks
  [cfg-index : OptCfgIndex]
  [facts : OptSsaFacts]
  [blocks : CompilerIrBlockList]
  [defs : OptSsaVarBlocks]) : OptSsaVarBlocks
  (match blocks
    [(CompilerIrBlockList.Nil) defs]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (opt-ssa-def-blocks-add-blocks
            cfg-index
            facts
            (box-get rest)
            (opt-ssa-def-blocks-add-instr-seq-from
              cfg-index
              facts
              label
              instrs
              0
              defs))])]
    [(CompilerIrBlockList.Array seq)
      (opt-ssa-def-blocks-add-blocks
        cfg-index
        facts
        (compiler-ir-block-seq-to-list seq)
        defs)]))

(define (opt-ssa-def-blocks-from-function
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptSsaVarBlocks
  (opt-ssa-def-blocks-add-blocks
    index
    facts
    blocks
    (opt-ssa-def-blocks-add-params
      index
      facts
      (opt-cfg-entry-label blocks)
      (OptSsaVarBlocks.Nil)
      params)))

(define (opt-ssa-phi-add-site
  [index : OptCfgIndex]
  [state : OptSsaPhiInsertState]
  [var : i64]
  [ty : AstType]
  [label : i64]) : OptSsaPhiInsertState
  (match state
    [(OptSsaPhiInsertState.State
        sites
        next-var
        worklist
        work-members
        site-members)
      (match (opt-cfg-index-id index label)
        [(option_i64.Some id)
          (if (opt-ssa-label-member? site-members id)
            state
            (begin
              (array-set! site-members id true)
              (OptSsaPhiInsertState.State
                (OptSsaPhiSites.Cons
                  (OptSsaPhiSite.Site var label ty next-var)
                  (box sites))
                (+ next-var 1)
                (if (opt-ssa-label-member? work-members id)
                  worklist
                  (begin
                    (array-set! work-members id true)
                    (opt-label-cons label worklist)))
                work-members
                site-members)))]
        [(option_i64.None) state])]))

(define (opt-ssa-phi-add-frontier
  [index : OptCfgIndex]
  [var : i64]
  [ty : AstType]
  [frontier : OptLabelSet]
  [state : OptSsaPhiInsertState]) : OptSsaPhiInsertState
  (match frontier
    [(OptLabelSet.Nil) state]
    [(OptLabelSet.Dense _ _)
      (opt-ssa-phi-add-frontier
        index
        var
        ty
        (opt-label-tail frontier)
        (opt-ssa-phi-add-site index state var ty (opt-label-ref frontier 0)))]))

(define (opt-ssa-insert-phis-worklist
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [var : i64]
  [ty : AstType]
  [state : OptSsaPhiInsertState]) : OptSsaPhiInsertState
  (match state
    [(OptSsaPhiInsertState.State
        sites
        next-var
        worklist
        work-members
        site-members)
      (match worklist
        [(OptLabelSet.Nil) state]
        [(OptLabelSet.Dense _ _)
          (let
            [label : i64 (opt-label-ref worklist 0)]
            (opt-ssa-insert-phis-worklist
              context
              blocks
              var
              ty
              (opt-ssa-phi-add-frontier
                (struct-get context index)
                var
                ty
                (opt-cfg-dominance-frontier-with-context blocks context label)
                (OptSsaPhiInsertState.State
                  sites
                  next-var
                  (opt-label-tail worklist)
                  work-members
                  site-members))))])]))

(define (opt-ssa-insert-phis-for-var
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [defs : OptSsaVarBlocks]
  [state : OptSsaPhiInsertState]
  [var : i64]
  [ty : AstType]) : OptSsaPhiInsertState
  (match state
    [(OptSsaPhiInsertState.State sites next-var _ work-members site-members)
      (let
        [index : OptCfgIndex (struct-get context index)]
        [worklist : OptLabelSet (opt-ssa-var-blocks-lookup defs var)]
        (begin
          (opt-cfg-fill-bool! work-members (array-length work-members) false)
          (opt-cfg-fill-bool! site-members (array-length site-members) false)
          (opt-ssa-label-mark-members! index work-members worklist)
          (opt-ssa-insert-phis-worklist
            context
            blocks
            var
            ty
            (OptSsaPhiInsertState.State
              sites
              next-var
              worklist
              work-members
              site-members))))]))

(define (opt-ssa-insert-phis-types
  [facts : OptSsaFacts]
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [defs : OptSsaVarBlocks]
  [types : OptSsaVarTypes]
  [state : OptSsaPhiInsertState]) : OptSsaPhiInsertState
  (match types
    [(OptSsaVarTypes.Nil) state]
    [(OptSsaVarTypes.Cons var ty rest)
      (opt-ssa-insert-phis-types
        facts
        context
        blocks
        defs
        (box-get rest)
        (if (opt-ssa-candidate? facts var)
          (opt-ssa-insert-phis-for-var context blocks defs state var ty)
          state))]))

(define (opt-ssa-insert-phis
  [facts : OptSsaFacts]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [frame : i64]
  [blocks : CompilerIrBlockList]) : OptSsaPhiInsertState
  (match facts
    [(OptSsaFacts.Facts _ _ types)
      (let
        [index : OptCfgIndex (struct-get context index)]
        [work-members : (Array bool) (opt-ssa-label-members-new index)]
        [site-members : (Array bool) (opt-ssa-label-members-new index)]
        (opt-ssa-insert-phis-types
          facts
          context
          blocks
          (opt-ssa-def-blocks-from-function index facts params blocks)
          types
          (OptSsaPhiInsertState.State
            (OptSsaPhiSites.Nil)
            frame
            (OptLabelSet.Nil)
            work-members
            site-members)))]))

(define (opt-ssa-env-lookup [env : OptSsaRenameEnv] [var : i64]) : option_i64.Option
  (match env
    [(OptSsaRenameEnv.Nil) (option_i64.None)]
    [(OptSsaRenameEnv.Cons original current rest)
      (if (= original var)
        (option_i64.Some current)
        (opt-ssa-env-lookup (box-get rest) var))]))

(define (opt-ssa-env-bind
  [env : OptSsaRenameEnv]
  [original : i64]
  [current : i64]) : OptSsaRenameEnv
  (OptSsaRenameEnv.Cons original current (box env)))

(define (opt-ssa-env-from-params
  [facts : OptSsaFacts]
  [params : CompilerIrParamList]
  [env : OptSsaRenameEnv]) : OptSsaRenameEnv
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) env]
    [(CompilerIrParamList.Array seq)
      (opt-ssa-env-from-params facts (compiler-ir-param-seq-to-list seq) env)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ var)
          (opt-ssa-env-from-params
            facts
            (box-get rest)
            (if (opt-ssa-candidate? facts var)
              (opt-ssa-env-bind env var var)
              env))])]))

(define (opt-ssa-env-bind-phis
  [sites : OptSsaPhiSites]
  [label : i64]
  [env : OptSsaRenameEnv]) : OptSsaRenameEnv
  (match sites
    [(OptSsaPhiSites.Nil) env]
    [(OptSsaPhiSites.Cons site rest)
      (match site
        [(OptSsaPhiSite.Site var site-label _ phi-var)
          (opt-ssa-env-bind-phis
            (box-get rest)
            label
            (if (= label site-label)
              (opt-ssa-env-bind env var phi-var)
              env))])]))

(define (opt-ssa-rewrite-value
  [env : OptSsaRenameEnv]
  [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var var)
      (match (opt-ssa-env-lookup env var)
        [(option_i64.Some current) (CompilerIrValue.Var current)]
        [(option_i64.None) value])]
    [_ value]))

(define (opt-ssa-rewrite-maybe-value
  [env : OptSsaRenameEnv]
  [value : CompilerIrMaybeValue]) : CompilerIrMaybeValue
  (match value
    [(CompilerIrMaybeValue.No) (CompilerIrMaybeValue.No)]
    [(CompilerIrMaybeValue.Some inner)
      (CompilerIrMaybeValue.Some (opt-ssa-rewrite-value env inner))]))

(define (opt-ssa-rewrite-value-list
  [env : OptSsaRenameEnv]
  [values : CompilerIrValueList]) : CompilerIrValueList
  (match values
    [(CompilerIrValueList.Nil) (CompilerIrValueList.Nil)]
    [(CompilerIrValueList.Array seq)
      (opt-ssa-rewrite-value-list env (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (compiler-ir-value-cons
        (opt-ssa-rewrite-value env value)
        (opt-ssa-rewrite-value-list env (box-get rest)))]))

(define (opt-ssa-rewrite-call-args-array
  [env : OptSsaRenameEnv]
  [src : (Array CompilerIrValue)]
  [dst : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set! dst index (opt-ssa-rewrite-value env (array-ref src index)))
      (opt-ssa-rewrite-call-args-array env src dst (+ index 1)))))

(define (opt-ssa-rewrite-call-args
  [env : OptSsaRenameEnv]
  [args : CompilerIrCallArgs]) : CompilerIrCallArgs
  (match args
    [(CompilerIrCallArgs.Nil) (CompilerIrCallArgs.Nil)]
    [(CompilerIrCallArgs.One value)
      (CompilerIrCallArgs.One (opt-ssa-rewrite-value env value))]
    [(CompilerIrCallArgs.Two a b)
      (CompilerIrCallArgs.Two
        (opt-ssa-rewrite-value env a)
        (opt-ssa-rewrite-value env b))]
    [(CompilerIrCallArgs.Array values)
      (let
        [out : (Array CompilerIrValue)
          (array.make-array CompilerIrValue (array-length values))]
        (begin
          (opt-ssa-rewrite-call-args-array env values out 0)
          (CompilerIrCallArgs.Array out)))]))

(define (opt-ssa-rewrite-spmd-call-arg
  [env : OptSsaRenameEnv]
  [arg : CompilerIrSpmdCallArg]) : CompilerIrSpmdCallArg
  (match arg
    [(CompilerIrSpmdCallArg.Arg class value ty)
      (CompilerIrSpmdCallArg.Arg class (opt-ssa-rewrite-value env value) ty)]))

(define (opt-ssa-rewrite-spmd-call-args-array
  [env : OptSsaRenameEnv]
  [src : (Array CompilerIrSpmdCallArg)]
  [dst : (Array CompilerIrSpmdCallArg)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set!
        dst
        index
        (opt-ssa-rewrite-spmd-call-arg env (array-ref src index)))
      (opt-ssa-rewrite-spmd-call-args-array env src dst (+ index 1)))))

(define (opt-ssa-rewrite-spmd-call-args
  [env : OptSsaRenameEnv]
  [args : CompilerIrSpmdCallArgList]) : CompilerIrSpmdCallArgList
  (match args
    [(CompilerIrSpmdCallArgList.Nil) CompilerIrSpmdCallArgList.Nil]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (CompilerIrSpmdCallArgList.Cons
        (opt-ssa-rewrite-spmd-call-arg env arg)
        (box (opt-ssa-rewrite-spmd-call-args env (box-get rest))))]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 (struct-get seq len)]
        [src : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        [out : (Array CompilerIrSpmdCallArg)
          (array.make-array CompilerIrSpmdCallArg count)]
        (begin
          (opt-ssa-rewrite-spmd-call-args-array env src out 0)
          (CompilerIrSpmdCallArgList.Array (CompilerIrSpmdCallArgSeq out count))))]))

(define (opt-ssa-rename-dst
  [facts : OptSsaFacts]
  [env : OptSsaRenameEnv]
  [next-var : i64]
  [dst : i64]) : OptSsaDstResult
  (if (opt-ssa-candidate? facts dst)
    (OptSsaDstResult.Result
      next-var
      (opt-ssa-env-bind env dst next-var)
      (+ next-var 1))
    (OptSsaDstResult.Result dst env next-var)))

(define (opt-ssa-rename-instr
  [facts : OptSsaFacts]
  [env : OptSsaRenameEnv]
  [next-var : i64]
  [instr : CompilerIrInstr]) : OptSsaInstrResult
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.Mov out-dst (opt-ssa-rewrite-value env src) ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.Load dst src ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.Load out-dst (opt-ssa-rewrite-value env src) ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.Cast
              out-dst
              (opt-ssa-rewrite-value env src)
              from-ty
              to-ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.Bitcast
              out-dst
              (opt-ssa-rewrite-value env src)
              from-ty
              to-ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.BinOp
              out-dst
              op
              (opt-ssa-rewrite-value env lhs)
              (opt-ssa-rewrite-value env rhs)
              ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.UnOp dst op src ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.UnOp out-dst op (opt-ssa-rewrite-value env src) ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.Call dst name args ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.Call
              out-dst
              name
              (opt-ssa-rewrite-call-args env args)
              ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.CallIndirect dst func args ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.CallIndirect
              out-dst
              (opt-ssa-rewrite-value env func)
              (opt-ssa-rewrite-call-args env args)
              ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.CallIndirectC dst func args ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.CallIndirectC
              out-dst
              (opt-ssa-rewrite-value env func)
              (opt-ssa-rewrite-call-args env args)
              ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload
            base
            name
            args
            slots)
          (OptSsaInstrResult.Result
            (ir-instr-call-cabi-store-result
              (opt-ssa-rewrite-value env base)
              name
              (opt-ssa-rewrite-call-args env args)
              slots)
            env
            next-var)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            dst
            base
            index-base
            index
            lane-offset
            lanes
            ty)
          (OptSsaInstrResult.Result
            (ir-instr-gather-load
              dst
              (opt-ssa-rewrite-value env base)
              (opt-ssa-rewrite-value env index-base)
              (opt-ssa-rewrite-value env index)
              lane-offset
              lanes
              ty)
            env
            next-var)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            slots)
          (OptSsaInstrResult.Result
            (ir-instr-call-indirect-cabi-store-result
              (opt-ssa-rewrite-value env base)
              (opt-ssa-rewrite-value env func)
              (opt-ssa-rewrite-call-args env args)
              slots)
            env
            next-var)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload
            callee
            backend
            lanes
            active-mask
            args
            result)
          (match result
            [(CompilerIrSpmdCallResult.Unit)
              (OptSsaInstrResult.Result
                (ir-instr-spmd-call
                  callee
                  backend
                  lanes
                  (opt-ssa-rewrite-value env active-mask)
                  (opt-ssa-rewrite-spmd-call-args env args)
                  result)
                env
                next-var)]
            [(CompilerIrSpmdCallResult.Value dst class ty)
              (match (opt-ssa-rename-dst facts env next-var dst)
                [(OptSsaDstResult.Result out-dst next-env out-next)
                  (OptSsaInstrResult.Result
                    (ir-instr-spmd-call
                      callee
                      backend
                      lanes
                      (opt-ssa-rewrite-value env active-mask)
                      (opt-ssa-rewrite-spmd-call-args env args)
                      (CompilerIrSpmdCallResult.Value out-dst class ty))
                    next-env
                    out-next)])])])]
    [(CompilerIrInstr.EntryArgc dst)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.EntryArgc out-dst)
            next-env
            out-next)])]
    [(CompilerIrInstr.Gep dst base offset ty)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.Gep
          dst
          (opt-ssa-rewrite-value env base)
          (opt-ssa-rewrite-value env offset)
          ty)
        env
        next-var)]
    [(CompilerIrInstr.StorePtr ptr value ty)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.StorePtr
          (opt-ssa-rewrite-value env ptr)
          (opt-ssa-rewrite-value env value)
          ty)
        env
        next-var)]
    [(CompilerIrInstr.CopyBytes dst src size)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.CopyBytes
          (opt-ssa-rewrite-value env dst)
          (opt-ssa-rewrite-value env src)
          size)
        env
        next-var)]
    [(CompilerIrInstr.BoundsCheck index length ok-label)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.BoundsCheck
          (opt-ssa-rewrite-value env index)
          (opt-ssa-rewrite-value env length)
          ok-label)
        env
        next-var)]
    [(CompilerIrInstr.Splat dst value lanes ty)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.Splat dst (opt-ssa-rewrite-value env value) lanes ty)
        env
        next-var)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst op lhs rhs lanes ty)
          (OptSsaInstrResult.Result
            (ir-instr-vector-bin-op
              dst
              op
              (opt-ssa-rewrite-value env lhs)
              (opt-ssa-rewrite-value env rhs)
              lanes
              ty)
            env
            next-var)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst op src carry lanes ty)
          (OptSsaInstrResult.Result
            (ir-instr-vector-prefix
              dst
              op
              (opt-ssa-rewrite-value env src)
              (opt-ssa-rewrite-value env carry)
              lanes
              ty)
            env
            next-var)])]
    [(CompilerIrInstr.VectorReduce dst op src lanes ty)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.VectorReduce
          dst
          op
          (opt-ssa-rewrite-value env src)
          lanes
          ty)
        env
        next-var)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst op lhs rhs lanes ty)
          (OptSsaInstrResult.Result
            (ir-instr-vector-compare
              dst
              op
              (opt-ssa-rewrite-value env lhs)
              (opt-ssa-rewrite-value env rhs)
              lanes
              ty)
            env
            next-var)])]
    [(CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.MaskBinOp
          dst
          op
          (opt-ssa-rewrite-value env lhs)
          (opt-ssa-rewrite-value env rhs)
          lanes)
        env
        next-var)]
    [(CompilerIrInstr.MaskNot dst src lanes)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.MaskNot dst (opt-ssa-rewrite-value env src) lanes)
        env
        next-var)]
    [(CompilerIrInstr.MaskReduce dst op src lanes)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.MaskReduce
          dst
          op
          (opt-ssa-rewrite-value env src)
          lanes)
        env
        next-var)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload
            dst
            mask
            on-true
            on-false
            lanes
            ty)
          (OptSsaInstrResult.Result
            (ir-instr-select
              dst
              (opt-ssa-rewrite-value env mask)
              (opt-ssa-rewrite-value env on-true)
              (opt-ssa-rewrite-value env on-false)
              lanes
              ty)
            env
            next-var)])]
    [(CompilerIrInstr.VectorLoad dst base index lanes ty)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.VectorLoad
          dst
          (opt-ssa-rewrite-value env base)
          (opt-ssa-rewrite-value env index)
          lanes
          ty)
        env
        next-var)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value lanes ty)
          (OptSsaInstrResult.Result
            (ir-instr-vector-store
              (opt-ssa-rewrite-value env base)
              (opt-ssa-rewrite-value env index)
              (opt-ssa-rewrite-value env value)
              lanes
              ty)
            env
            next-var)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            lanes
            ty)
          (OptSsaInstrResult.Result
            (ir-instr-predicated-store
              (opt-ssa-rewrite-value env base)
              (opt-ssa-rewrite-value env index)
              (opt-ssa-rewrite-value env value)
              (opt-ssa-rewrite-value env mask)
              lanes
              ty)
            env
            next-var)])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload
            dst
            base
            index
            mask
            lanes
            ty)
          (OptSsaInstrResult.Result
            (ir-instr-predicated-load
              dst
              (opt-ssa-rewrite-value env base)
              (opt-ssa-rewrite-value env index)
              (opt-ssa-rewrite-value env mask)
              lanes
              ty)
            env
            next-var)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            dst
            source
            selector-low
            selector-high
            active-lanes
            lanes
            ty)
          (OptSsaInstrResult.Result
            (ir-instr-vector-shuffle
              dst
              (opt-ssa-rewrite-value env source)
              (opt-ssa-rewrite-value env selector-low)
              (opt-ssa-rewrite-maybe-value env selector-high)
              (opt-ssa-rewrite-value env active-lanes)
              lanes
              ty)
            env
            next-var)])]
    [(CompilerIrInstr.TailMask dst index length lanes)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.TailMask
          dst
          (opt-ssa-rewrite-value env index)
          (opt-ssa-rewrite-value env length)
          lanes)
        env
        next-var)]
    [(CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.CpuId
          dst
          (opt-ssa-rewrite-value env leaf)
          (opt-ssa-rewrite-value env subleaf)
          reg-index)
        env
        next-var)]
    [(CompilerIrInstr.Xgetbv dst index)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.Xgetbv dst (opt-ssa-rewrite-value env index))
        env
        next-var)]
    [(CompilerIrInstr.Syscall dst args)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.Syscall dst (opt-ssa-rewrite-call-args env args))
        env
        next-var)]
    [(CompilerIrInstr.Store name value ty)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.Store name (opt-ssa-rewrite-value env value) ty)
        env
        next-var)]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.Branch
          (opt-ssa-rewrite-value env cond)
          true-label
          false-label)
        env
        next-var)]
    [(CompilerIrInstr.Return maybe)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.Return (opt-ssa-rewrite-maybe-value env maybe))
        env
        next-var)]
    [(CompilerIrInstr.TailCall name args ty)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.TailCall name (opt-ssa-rewrite-call-args env args) ty)
        env
        next-var)]
    [(CompilerIrInstr.Alloc _ _) (OptSsaInstrResult.Result instr env next-var)]
    [(CompilerIrInstr.AddrOf _ _) (OptSsaInstrResult.Result instr env next-var)]
    [(CompilerIrInstr.LaneId _ _ _)
      (OptSsaInstrResult.Result instr env next-var)]
    [(CompilerIrInstr.EntryArgv _)
      (OptSsaInstrResult.Result instr env next-var)]
    [(CompilerIrInstr.EntryEnvp _)
      (OptSsaInstrResult.Result instr env next-var)]
    [(CompilerIrInstr.Jump _) (OptSsaInstrResult.Result instr env next-var)]
    [(CompilerIrInstr.Phi _ _ _) (OptSsaInstrResult.Result instr env next-var)]
    ;; SSA-rename register-group ops -- rewrite operands with the current
    ;; env, then rename the dst.
    [(CompilerIrInstr.Pack dst words ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.Pack
              out-dst
              (opt-ssa-rewrite-value-list env words)
              ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.Word dst src index ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (CompilerIrInstr.Word
              out-dst
              (opt-ssa-rewrite-value env src)
              index
              ty)
            next-env
            out-next)])]
    [(CompilerIrInstr.TailCallIndirect func args ty)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.TailCallIndirect
          (opt-ssa-rewrite-value env func)
          (opt-ssa-rewrite-call-args env args)
          ty)
        env
        next-var)]
    [(CompilerIrInstr.Switch index base cases default-label)
      (OptSsaInstrResult.Result
        (CompilerIrInstr.Switch
          (opt-ssa-rewrite-value env index)
          base
          cases
          default-label)
        env
        next-var)]))

(define (opt-ssa-rename-instr-seq-from
  [facts : OptSsaFacts]
  [env : OptSsaRenameEnv]
  [next-var : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptSsaBlockResult
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptSsaBlockResult.Result (CompilerIrInstrList.Nil) env next-var)
    (match (opt-ssa-rename-instr
      facts
      env
      next-var
      (compiler-ir-instr-seq-ref instrs index))
      [(OptSsaInstrResult.Result instr next-env instr-next)
        (match (opt-ssa-rename-instr-seq-from
          facts
          next-env
          instr-next
          instrs
          (+ index 1))
          [(OptSsaBlockResult.Result rest out-env out-next)
            (OptSsaBlockResult.Result
              (compiler-ir-instr-cons instr rest)
              out-env
              out-next)])])))

(define (opt-ssa-rename-blocks-contains?
  [blocks : OptSsaRenameBlocks]
  [label : i64]) : bool
  (match blocks
    [(OptSsaRenameBlocks.Nil) false]
    [(OptSsaRenameBlocks.Cons block rest)
      (match block
        [(OptSsaRenameBlock.Block block-label _)
          (if (= block-label label)
            true
            (opt-ssa-rename-blocks-contains? (box-get rest) label))])]))

(define (opt-ssa-rename-blocks-lookup
  [blocks : OptSsaRenameBlocks]
  [label : i64]) : CompilerIrInstrList
  (match blocks
    [(OptSsaRenameBlocks.Nil) (CompilerIrInstrList.Nil)]
    [(OptSsaRenameBlocks.Cons block rest)
      (match block
        [(OptSsaRenameBlock.Block block-label instrs)
          (if (= block-label label)
            instrs
            (opt-ssa-rename-blocks-lookup (box-get rest) label))])]))

(define (opt-ssa-block-out-lookup [outs : OptSsaBlockOuts] [label : i64]) : OptSsaRenameEnv
  (match outs
    [(OptSsaBlockOuts.Nil) (OptSsaRenameEnv.Nil)]
    [(OptSsaBlockOuts.Cons out rest)
      (match out
        [(OptSsaBlockOut.Out out-label env)
          (if (= out-label label)
            env
            (opt-ssa-block-out-lookup (box-get rest) label))])]))

(define (opt-ssa-rename-state-add-block
  [state : OptSsaRenameState]
  [label : i64]
  [instrs : CompilerIrInstrList]
  [env : OptSsaRenameEnv]
  [next-var : i64]) : OptSsaRenameState
  (match state
    [(OptSsaRenameState.State blocks outs _)
      (OptSsaRenameState.State
        (OptSsaRenameBlocks.Cons
          (OptSsaRenameBlock.Block label instrs)
          (box blocks))
        (OptSsaBlockOuts.Cons (OptSsaBlockOut.Out label env) (box outs))
        next-var)]))

(define (opt-ssa-rename-id
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [id : i64]
  [env : OptSsaRenameEnv]
  [state : OptSsaRenameState]) : OptSsaRenameState
  (let
    [index : OptCfgIndex (struct-get context index)]
    [label : i64 (array-ref (struct-get index labels) id)]
    (match (opt-cfg-index-block index id)
      [(OptMaybeBlock.No) state]
      [(OptMaybeBlock.Some block)
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (let
              [entry-env : OptSsaRenameEnv
                (opt-ssa-env-bind-phis sites label env)]
              (match (opt-ssa-rename-instr-seq-from
                facts
                entry-env
                (match state
                  [(OptSsaRenameState.State _ _ next-var) next-var])
                instrs
                0)
                [(OptSsaBlockResult.Result renamed out-env next-var)
                  (opt-ssa-rename-children
                    context
                    blocks
                    facts
                    sites
                    id
                    out-env
                    (opt-ssa-rename-state-add-block
                      state
                      label
                      renamed
                      out-env
                      next-var)
                    0)]))])])))

(define (opt-ssa-rename-children
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [parent-id : i64]
  [env : OptSsaRenameEnv]
  [state : OptSsaRenameState]
  [child-id : i64]) : OptSsaRenameState
  (let
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= child-id count)
      state
      (let
        [idom : (Array i64) (struct-get (struct-get context doms) idom)]
        [next-state : OptSsaRenameState
          (if (and
            (not (= child-id parent-id))
            (array-ref (struct-get index reachable) child-id)
            (= (array-ref idom child-id) parent-id))
            (opt-ssa-rename-id context blocks facts sites child-id env state)
            state)]
        (opt-ssa-rename-children
          context
          blocks
          facts
          sites
          parent-id
          env
          next-state
          (+ child-id 1))))))

(define (opt-ssa-rename-missing-blocks
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [initial-env : OptSsaRenameEnv]
  [state : OptSsaRenameState]) : OptSsaRenameState
  (match blocks
    [(CompilerIrBlockList.Nil) state]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [next-state : OptSsaRenameState
              (match state
                [(OptSsaRenameState.State renamed _ next-var)
                  (if (opt-ssa-rename-blocks-contains? renamed label)
                    state
                    (match (opt-ssa-rename-instr-seq-from
                      facts
                      (opt-ssa-env-bind-phis sites label initial-env)
                      next-var
                      instrs
                      0)
                      [(OptSsaBlockResult.Result out out-env out-next)
                        (opt-ssa-rename-state-add-block
                          state
                          label
                          out
                          out-env
                          out-next)]))])]
            (opt-ssa-rename-missing-blocks
              (box-get rest)
              facts
              sites
              initial-env
              next-state))])]
    [(CompilerIrBlockList.Array seq)
      (opt-ssa-rename-missing-blocks
        (compiler-ir-block-seq-to-list seq)
        facts
        sites
        initial-env
        state)]))

(define (opt-ssa-rename-function-blocks
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [frame : i64]
  [blocks : CompilerIrBlockList]) : OptSsaRenameState
  (let
    [initial-env : OptSsaRenameEnv
      (opt-ssa-env-from-params facts params (OptSsaRenameEnv.Nil))]
    [entry-label : i64 (opt-cfg-entry-label blocks)]
    [index : OptCfgIndex (struct-get context index)]
    (begin
      (opt-cfg-index-refresh-blocks! index blocks)
      (match (opt-cfg-index-id index entry-label)
        [(option_i64.Some entry-id)
          (opt-ssa-rename-missing-blocks
            blocks
            facts
            sites
            initial-env
            (opt-ssa-rename-id
              context
              blocks
              facts
              sites
              entry-id
              initial-env
              (OptSsaRenameState.State
                (OptSsaRenameBlocks.Nil)
                (OptSsaBlockOuts.Nil)
                frame)))]
        [(option_i64.None)
          (OptSsaRenameState.State
            (OptSsaRenameBlocks.Nil)
            (OptSsaBlockOuts.Nil)
            frame)]))))

;; Dead-path phi input: a candidate var can reach a phi over an edge on which
;; it has no definition -- e.g. an inner-loop counter's phi at the OUTER loop
;; header sees the function-entry path, where the counter is first defined only
;; inside the outer body. A well-formed source never READS the var along such a
;; path, so the input value is unobservable there. The previous fallback named
;; the ORIGINAL var, which made the materialized function fail the
;; use-before-definition verify and silently disabled SSA construction (and
;; with it every SSA-gated pass: GVN, load-GVN, preheaders, LICM, induction,
;; loop-BCE) for every function with a nested loop. Feed a typed zero constant
;; instead: it renders and allocates like any other constant phi input, and
;; phis whose value is never used are removed by DCE.
(define (opt-ssa-phi-undef-input [ty : AstType]) : CompilerIrValue
  (if (opt-float-type? ty)
    (CompilerIrValue.F64 0)
    (if (opt-bool-type? ty)
      (CompilerIrValue.Bool false)
      (CompilerIrValue.I64 0))))

(define (opt-ssa-phi-inputs
  [preds : OptLabelSet]
  [outs : OptSsaBlockOuts]
  [var : i64]
  [ty : AstType]) : CompilerIrPhiInputList
  (match preds
    [(OptLabelSet.Nil) (CompilerIrPhiInputList.Nil)]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        [env : OptSsaRenameEnv (opt-ssa-block-out-lookup outs pred)]
        [value : CompilerIrValue
          (match (opt-ssa-env-lookup env var)
            [(option_i64.Some current) (CompilerIrValue.Var current)]
            [(option_i64.None) (opt-ssa-phi-undef-input ty)])]
        (compiler-ir-phi-input-cons
          value
          pred
          (opt-ssa-phi-inputs (opt-label-tail preds) outs var ty)))]))

(define (opt-ssa-phis-for-label
  [pred-map : OptPredMap]
  [outs : OptSsaBlockOuts]
  [sites : OptSsaPhiSites]
  [label : i64]) : CompilerIrInstrList
  (match sites
    [(OptSsaPhiSites.Nil) (CompilerIrInstrList.Nil)]
    [(OptSsaPhiSites.Cons site rest)
      (let
        [tail : CompilerIrInstrList
          (opt-ssa-phis-for-label pred-map outs (box-get rest) label)]
        (match site
          [(OptSsaPhiSite.Site var site-label ty phi-var)
            (if (= site-label label)
              (compiler-ir-instr-cons
                (CompilerIrInstr.Phi
                  phi-var
                  (opt-ssa-phi-inputs
                    (opt-pred-map-lookup pred-map label)
                    outs
                    var
                    ty)
                  ty)
                tail)
              tail)]))]))

(define (opt-ssa-materialize-blocks
  [blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [facts : OptSsaFacts]
  [renamed : OptSsaRenameBlocks]
  [outs : OptSsaBlockOuts]
  [sites : OptSsaPhiSites]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (let
            [phis : CompilerIrInstrList
              (opt-ssa-phis-for-label pred-map outs sites label)]
            [body : CompilerIrInstrList
              (opt-ssa-rewrite-preexisting-instrs
                facts
                outs
                (opt-ssa-rename-blocks-lookup renamed label))]
            (compiler-ir-block-cons
              (compiler-ir-block
                label
                (opt-aggregate-instr-list-append phis body))
              (opt-ssa-materialize-blocks
                (box-get rest)
                pred-map
                facts
                renamed
                outs
                sites)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-ssa-materialize-blocks
        (compiler-ir-block-seq-to-list seq)
        pred-map
        facts
        renamed
        outs
        sites)]))

;; Pre-existing (lowerer-emitted) phis: value-producing `if`/`match` joins
;; lower directly to Phi instructions, so a function can arrive at SSA
;; construction with phis AND multi-def `set!` locals. The renamer passes
;; such phis through untouched (their inputs are edge uses that must NOT be
;; rewritten with the current block env); the materializer rewrites each
;; input with the PREDECESSOR's out-env below, exactly like the inserted phi
;; sites, so the renamed defs reach the pre-existing joins per edge. A
;; candidate input with no binding on some edge is the dead-path case and
;; takes the typed undef constant (see opt-ssa-phi-undef-input).
(define (opt-ssa-rewrite-preexisting-phi-inputs
  [facts : OptSsaFacts]
  [outs : OptSsaBlockOuts]
  [inputs : CompilerIrPhiInputList]
  [ty : AstType]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-ssa-rewrite-preexisting-phi-inputs
        facts
        outs
        (compiler-ir-phi-input-seq-to-list seq)
        ty)]
    [(CompilerIrPhiInputList.Cons value pred rest)
      (compiler-ir-phi-input-cons
        (match value
          [(CompilerIrValue.Var v)
            (if (opt-ssa-candidate? facts v)
              (match (opt-ssa-env-lookup (opt-ssa-block-out-lookup outs pred) v)
                [(option_i64.Some current) (CompilerIrValue.Var current)]
                [(option_i64.None) (opt-ssa-phi-undef-input ty)])
              value)]
          [_ value])
        pred
        (opt-ssa-rewrite-preexisting-phi-inputs facts outs (box-get rest) ty))]))

(define (opt-ssa-rewrite-preexisting-instrs
  [facts : OptSsaFacts]
  [outs : OptSsaBlockOuts]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (compiler-ir-instr-cons
        (match instr
          [(CompilerIrInstr.Phi dst inputs ty)
            (CompilerIrInstr.Phi
              dst
              (opt-ssa-rewrite-preexisting-phi-inputs facts outs inputs ty)
              ty)]
          [_ instr])
        (opt-ssa-rewrite-preexisting-instrs facts outs (box-get rest)))]))

;; A pre-existing phi whose DST is itself a rename candidate would need its
;; definition versioned per edge -- out of scope; skip construction (the
;; lowerer emits fresh single-def phi dsts, so this does not fire today).
(define (opt-ssa-instr-seq-has-candidate-phi-dst?
  [facts : OptSsaFacts]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi dst _ _)
        (if (opt-ssa-candidate? facts dst)
          true
          (opt-ssa-instr-seq-has-candidate-phi-dst? facts instrs (+ index 1)))]
      [_ (opt-ssa-instr-seq-has-candidate-phi-dst? facts instrs (+ index 1))])))

(define (opt-ssa-blocks-have-candidate-phi-dst?
  [facts : OptSsaFacts]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-ssa-instr-seq-has-candidate-phi-dst? facts instrs 0)
            true
            (opt-ssa-blocks-have-candidate-phi-dst? facts (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-ssa-blocks-have-candidate-phi-dst?
        facts
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-ssa-instr-seq-has-phi? [instrs : CompilerIrInstrSeq] [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ _ _) true]
      [_ (opt-ssa-instr-seq-has-phi? instrs (+ index 1))])))

(define (opt-ssa-blocks-have-phi? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-ssa-instr-seq-has-phi? instrs 0)
            true
            (opt-ssa-blocks-have-phi? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-ssa-blocks-have-phi? (compiler-ir-block-seq-to-list seq))]))

(define (opt-ssa-construct-checked
  [fallback : CompilerIrFunction]
  [next : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-verify-function next)
    [(ResultCompilerOptimizeVerify.Ok) next]
    [(ResultCompilerOptimizeVerify.Err _) fallback]))

(define (opt-ssa-construct-materialized
  [fallback : CompilerIrFunction]
  [name : i64]
  [params : CompilerIrParamList]
  [ret-ty : AstType]
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [state : OptSsaRenameState]) : CompilerIrFunction
  (match state
    [(OptSsaRenameState.State renamed outs next-frame)
      (opt-ssa-construct-checked
        fallback
        (CompilerIrFunction.Function
          name
          params
          ret-ty
          next-frame
          (opt-ssa-materialize-blocks
            blocks
            (struct-get context pred-map)
            facts
            renamed
            outs
            sites)))]))

(define (opt-ssa-construct-materialized-with-context-result
  [fallback : CompilerIrFunction]
  [name : i64]
  [params : CompilerIrParamList]
  [ret-ty : AstType]
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [state : OptSsaRenameState]) : OptFunctionCtxResult
  (match state
    [(OptSsaRenameState.State renamed outs next-frame)
      (let
        [next-blocks : CompilerIrBlockList
          (opt-ssa-materialize-blocks
            blocks
            (struct-get context pred-map)
            facts
            renamed
            outs
            sites)]
        [next : CompilerIrFunction
          (CompilerIrFunction.Function
            name
            params
            ret-ty
            next-frame
            next-blocks)]
        [next-context : OptCfgContext (opt-cfg-context-build next-blocks)]
        (match (opt-verify-function-with-context next next-context)
          [(ResultCompilerOptimizeVerify.Ok)
            (OptFunctionCtxResult.Result next next-context)]
          [(ResultCompilerOptimizeVerify.Err _)
            (OptFunctionCtxResult.Result fallback context)]))]))

;; True when the entry block has an explicit CFG predecessor (e.g. the
;; tail-recursion-to-loop back edge jumps to the function entry block).
(define (opt-ssa-entry-has-preds? [context : OptCfgContext]) : bool
  (let
    [index : OptCfgIndex (struct-get context index)]
    (match (opt-cfg-index-id index (struct-get context entry-label))
      [(option_i64.Some id)
        (let
          [preds : OptCfgCsr (struct-get index preds)]
          [offsets : (Array i64) (struct-get preds offsets)]
          (> (- (array-ref offsets (+ id 1)) (array-ref offsets id)) 0))]
      [(option_i64.None) false])))

;; Give the implicit function-entry edge an ordinary CFG label when a backedge
;; targets the first lowered block. Parameters dominate this fresh preheader,
;; which makes their initial values available as normal phi inputs at the old
;; entry. The old entry remains the loop header and every existing backedge
;; remains untouched. A label collision fails closed by returning the original
;; blocks; the caller observes that their entry still has predecessors.
(define (opt-ssa-explicit-entry-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [entry : i64 (opt-cfg-entry-label blocks)]
    [preheader : i64
      (compiler-ir-label
        (string.append (compiler-ir-label-text entry) "__ssa_entry"))]
    (if (or
      (not (compiler-ir-label-some? entry))
      (opt-cfg-block-exists? blocks preheader))
      blocks
      (compiler-ir-block-cons
        (compiler-ir-block
          preheader
          (compiler-ir-instr-cons
            (CompilerIrInstr.Jump entry)
            (CompilerIrInstrList.Nil)))
        blocks))))

(define (opt-ssa-construct-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (opt-verify-single-defs? params frame blocks)
        func
        (let
          [facts : OptSsaFacts
            (opt-ssa-facts-from-function type-segment-bases params blocks)]
          ;; Pre-existing lowerer phis are fine (their inputs are rewritten
          ;; per edge during materialization); only a phi DST that is itself
          ;; a rename candidate is out of scope.
          (if (opt-ssa-blocks-have-candidate-phi-dst? facts blocks)
            func
            (if (not (opt-ssa-any-candidate? facts))
              func
              (let
                [context : OptCfgContext (opt-cfg-context-build blocks)]
                (if (opt-ssa-entry-has-preds? context)
                  func
                  (opt-ssa-construct-with-context
                    func
                    name
                    params
                    ret-ty
                    frame
                    blocks
                    facts
                    context)))))))]))

(define (opt-ssa-construct-with-context
  [func : CompilerIrFunction]
  [name : i64]
  [params : CompilerIrParamList]
  [ret-ty : AstType]
  [frame : i64]
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [context : OptCfgContext]) : CompilerIrFunction
  (let
    [phi-state : OptSsaPhiInsertState
      (opt-ssa-insert-phis facts context params frame blocks)]
    (match phi-state
      [(OptSsaPhiInsertState.State sites phi-next _ _ _)
        (opt-ssa-construct-materialized
          func
          name
          params
          ret-ty
          blocks
          context
          facts
          sites
          (opt-ssa-rename-function-blocks
            context
            params
            facts
            sites
            phi-next
            blocks))])))

(define (opt-ssa-construct-with-context-result
  [func : CompilerIrFunction]
  [name : i64]
  [params : CompilerIrParamList]
  [ret-ty : AstType]
  [frame : i64]
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [context : OptCfgContext]) : OptFunctionCtxResult
  (let
    [phi-state : OptSsaPhiInsertState
      (opt-ssa-insert-phis facts context params frame blocks)]
    (match phi-state
      [(OptSsaPhiInsertState.State sites phi-next _ _ _)
        (opt-ssa-construct-materialized-with-context-result
          func
          name
          params
          ret-ty
          blocks
          context
          facts
          sites
          (opt-ssa-rename-function-blocks
            context
            params
            facts
            sites
            phi-next
            blocks))])))

;; `entry-context` is consumed only when `entry-context-valid?` reports that it
;; was built for `func`'s current blocks; otherwise this builds its own, exactly
;; as before. The pre-SSA rotation pass hands its context down this way.
(define (opt-ssa-construct-function-from-context-result
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [entry-context : OptCfgContext]
  [entry-context-valid? : bool]) : OptFunctionCtxResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [context : OptCfgContext
          (if entry-context-valid?
            entry-context
            (opt-cfg-context-build blocks))]
        (if (opt-verify-single-defs? params frame blocks)
          (OptFunctionCtxResult.Result func context)
          (let
            [facts : OptSsaFacts
              (opt-ssa-facts-from-function type-segment-bases params blocks)]
            (cond
              ;; Pre-existing lowerer phis are fine (their inputs are rewritten
              ;; per edge during materialization); only a phi DST that is
              ;; itself a rename candidate is out of scope.
              [(opt-ssa-blocks-have-candidate-phi-dst? facts blocks)
                (OptFunctionCtxResult.Result func context)]
              [(not (opt-ssa-any-candidate? facts))
                (OptFunctionCtxResult.Result func context)]
              [(opt-ssa-entry-has-preds? context)
                (OptFunctionCtxResult.Result func context)]
              [else
                (opt-ssa-construct-with-context-result
                  func
                  name
                  params
                  ret-ty
                  frame
                  blocks
                  facts
                  context)]))))]))

;; --- conservative global value numbering / cross-block copies ---------------
;;
;; This pass is deliberately SSA-gated. If the function verifier cannot prove
;; single definitions and dominance for every use, the pass leaves the function
;; unchanged and the existing block-local optimizer still runs. For verified
;; functions, a copy/expression fact is available only in the defining block
;; after the defining instruction, or in a block dominated by the definition's
;; block. Phi inputs are resolved at the end of their named predecessor, never
;; at the phi block itself.
(defenum OptGlobalExprKey
  (MovKey CompilerIrValue AstType)
  (GepKey CompilerIrValue CompilerIrValue AstType)
  (CastKey CompilerIrValue AstType AstType)
  (BinKey CompilerIrBinOp CompilerIrValue CompilerIrValue AstType)
  (UnKey CompilerIrUnOp CompilerIrValue AstType))

(defenum OptMaybeGlobalExprKey
  (No)
  (Some OptGlobalExprKey))

(defenum OptGlobalExprFact
  (Fact OptGlobalExprKey i64 i64 i64))

(defenum OptGlobalExprFacts
  (Nil)
  (Cons OptGlobalExprFact (Box OptGlobalExprFacts)))

(defstruct OptGlobalExprFactTable
  (buckets (Array OptGlobalExprFacts)))

(defenum OptGlobalCopyFact
  (Fact i64 CompilerIrValue i64 i64))

(defenum OptGlobalCopyFacts
  (Nil)
  (Cons OptGlobalCopyFact (Box OptGlobalCopyFacts)))

(defstruct OptGlobalCopyFactTable
  (buckets (Array OptGlobalCopyFacts)))

;; SSA-only Pack/Word facts. Unlike the block-local pre-SSA copy fold, these
;; facts may safely carry a Var word across blocks: a verified Pack is dominated
;; by every Var in its word list, and the Pack in turn dominates any Word fact
;; accepted by the lookup below.
(defenum OptGlobalPackWordFact
  (Fact i64 i64 CompilerIrValue i64 i64))

(defenum OptGlobalPackWordFacts
  (Nil)
  (Cons OptGlobalPackWordFact (Box OptGlobalPackWordFacts)))

(defstruct OptGlobalPackWordFactTable
  (buckets (Array OptGlobalPackWordFacts)))

(define (opt-global-expr-key-eq
  [type-segment-bases : i64]
  [a : OptGlobalExprKey]
  [b : OptGlobalExprKey]) : bool
  (match a
    [(OptGlobalExprKey.MovKey av aty)
      (match b
        [(OptGlobalExprKey.MovKey bv bty)
          (and (opt-value-eq av bv) (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(OptGlobalExprKey.GepKey abase aoff aty)
      (match b
        [(OptGlobalExprKey.GepKey bbase boff bty)
          (and
            (opt-value-eq abase bbase)
            (opt-value-eq aoff boff)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(OptGlobalExprKey.CastKey av afrom ato)
      (match b
        [(OptGlobalExprKey.CastKey bv bfrom bto)
          (and
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases afrom bfrom)
            (opt-type-eq type-segment-bases ato bto))]
        [_ false])]
    [(OptGlobalExprKey.BinKey aop al ar aty)
      (match b
        [(OptGlobalExprKey.BinKey bop bl br bty)
          (and
            (opt-binop-eq aop bop)
            (opt-value-eq al bl)
            (opt-value-eq ar br)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(OptGlobalExprKey.UnKey aop av aty)
      (match b
        [(OptGlobalExprKey.UnKey bop bv bty)
          (and
            (opt-unop-eq aop bop)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]))

(define (opt-global-expr-key-hash
  [type-segment-bases : i64]
  [key : OptGlobalExprKey]) : i64
  (match key
    [(OptGlobalExprKey.MovKey value ty)
      (hash.combine
        1
        (hash.combine
          (opt-value-hash value)
          (opt-type-hash type-segment-bases ty)))]
    [(OptGlobalExprKey.GepKey base offset ty)
      (hash.combine
        2
        (hash.combine
          (opt-value-hash base)
          (hash.combine
            (opt-value-hash offset)
            (opt-type-hash type-segment-bases ty))))]
    [(OptGlobalExprKey.CastKey value from-ty to-ty)
      (hash.combine
        3
        (hash.combine
          (opt-value-hash value)
          (hash.combine
            (opt-type-hash type-segment-bases from-ty)
            (opt-type-hash type-segment-bases to-ty))))]
    [(OptGlobalExprKey.BinKey op lhs rhs ty)
      (hash.combine
        4
        (hash.combine
          (hash.i64 (opt-binop-tag op))
          (hash.combine
            (opt-value-hash lhs)
            (hash.combine
              (opt-value-hash rhs)
              (opt-type-hash type-segment-bases ty)))))]
    [(OptGlobalExprKey.UnKey op value ty)
      (hash.combine
        5
        (hash.combine
          (hash.i64 (opt-unop-tag op))
          (hash.combine
            (opt-value-hash value)
            (opt-type-hash type-segment-bases ty))))]))

;; Key operands must hold a single unchanging value for the fact's lifetime.
;; An `CompilerIrValue.Global` operand is a hidden LOAD of a mutable global (the backend
;; emits a rip-relative read at each use site), so an instruction using one is
;; not a pure expression: reusing its result across an intervening store/call
;; that mutates the global yields a stale value. The opt2 self-build miscompile
;; was exactly this -- `ty-node-push` reused the pre-grow capacity address of
;; `ty-node-pool-slots` after the grow call replaced the array, so the bounds
;; check compared against the old capacity and aborted once the pool grew.
;; `opt-copy-safe-source?` already encodes the safe operand set: vars
;; (single-def under this pass's SSA gate) and unambiguous scalar literals.
(define (opt-global-key-for-instr [instr : CompilerIrInstr]) : OptMaybeGlobalExprKey
  (match instr
    [(CompilerIrInstr.Mov _ src ty)
      (if (opt-copy-safe-source? src)
        (OptMaybeGlobalExprKey.Some (OptGlobalExprKey.MovKey src ty))
        (OptMaybeGlobalExprKey.No))]
    [(CompilerIrInstr.Gep _ base offset ty)
      (if (and (opt-copy-safe-source? base) (opt-copy-safe-source? offset))
        (OptMaybeGlobalExprKey.Some (OptGlobalExprKey.GepKey base offset ty))
        (OptMaybeGlobalExprKey.No))]
    [(CompilerIrInstr.Cast _ src from-ty to-ty)
      (if (opt-copy-safe-source? src)
        (OptMaybeGlobalExprKey.Some
          (OptGlobalExprKey.CastKey src from-ty to-ty))
        (OptMaybeGlobalExprKey.No))]
    [(CompilerIrInstr.BinOp _ op lhs rhs ty)
      (if (and (opt-copy-safe-source? lhs) (opt-copy-safe-source? rhs))
        (OptMaybeGlobalExprKey.Some (OptGlobalExprKey.BinKey op lhs rhs ty))
        (OptMaybeGlobalExprKey.No))]
    [(CompilerIrInstr.UnOp _ op src ty)
      (if (opt-copy-safe-source? src)
        (OptMaybeGlobalExprKey.Some (OptGlobalExprKey.UnKey op src ty))
        (OptMaybeGlobalExprKey.No))]
    [_ (OptMaybeGlobalExprKey.No)]))

(define (opt-global-fact-available?
  [def-block-id : i64]
  [def-pos : i64]
  [use-block-id : i64]
  [use-pos : i64]
  [doms : OptDomInfo]) : bool
  (if (= def-block-id use-block-id)
    (< def-pos use-pos)
    (opt-dom-info-dominates-id? doms def-block-id use-block-id)))

(define (opt-global-block-id [doms : OptDomInfo] [label : i64]) : i64
  (match (opt-cfg-index-id (struct-get doms index) label)
    [(option_i64.Some id) id]
    [(option_i64.None) (- 0 1)]))

(define (opt-global-copy-facts-from-instr-seq-from
  [block-id : i64]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [tail : OptGlobalCopyFacts]) : OptGlobalCopyFacts
  (if (< index 0)
    tail
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [rest-facts : OptGlobalCopyFacts tail]
      [next-tail : OptGlobalCopyFacts
        (match instr
          [(CompilerIrInstr.Mov dst src _)
            (if (and
              (opt-copy-safe-source? src)
              (not (opt-value-is-var? src dst)))
              (OptGlobalCopyFacts.Cons
                (OptGlobalCopyFact.Fact dst src block-id (+ index 1))
                (box rest-facts))
              rest-facts)]
          [_ rest-facts])]
      (opt-global-copy-facts-from-instr-seq-from
        block-id
        slots
        (- index 1)
        next-tail))))

(define (opt-global-copy-facts-from-instr-seq
  [block-id : i64]
  [instrs : CompilerIrInstrSeq]
  [tail : OptGlobalCopyFacts]) : OptGlobalCopyFacts
  (opt-global-copy-facts-from-instr-seq-from
    block-id
    (struct-get instrs slots)
    (- (struct-get instrs len) 1)
    tail))

(define (opt-global-copy-facts-from-blocks
  [blocks : CompilerIrBlockList]
  [block-id : i64]
  [tail : OptGlobalCopyFacts]) : OptGlobalCopyFacts
  (match blocks
    [(CompilerIrBlockList.Nil) tail]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [rest-facts : OptGlobalCopyFacts
          (opt-global-copy-facts-from-blocks (box-get rest) (+ block-id 1) tail)]
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (opt-global-copy-facts-from-instr-seq block-id instrs rest-facts)]))]
    [(CompilerIrBlockList.Array seq)
      (opt-global-copy-facts-from-blocks
        (compiler-ir-block-seq-to-list seq)
        block-id
        tail)]))

(define (opt-global-copy-facts-max-dst
  [facts : OptGlobalCopyFacts]
  [max-dst : i64]) : i64
  (match facts
    [(OptGlobalCopyFacts.Nil) max-dst]
    [(OptGlobalCopyFacts.Cons fact rest)
      (match fact
        [(OptGlobalCopyFact.Fact dst _ _ _)
          (opt-global-copy-facts-max-dst
            (box-get rest)
            (if (> dst max-dst)
              dst
              max-dst))])]))

(define (opt-global-copy-buckets-fill-empty!
  [buckets : (Array OptGlobalCopyFacts)]
  [index : i64]) : unit
  (if (>= index (array-length buckets))
    unit
    (begin
      (array-set! buckets index (OptGlobalCopyFacts.Nil))
      (opt-global-copy-buckets-fill-empty! buckets (+ index 1)))))

(define (opt-global-copy-table-insert!
  [table : OptGlobalCopyFactTable]
  [fact : OptGlobalCopyFact]) : unit
  (match fact
    [(OptGlobalCopyFact.Fact dst _ _ _)
      (let
        [buckets : (Array OptGlobalCopyFacts) (struct-get table buckets)]
        (if (and (>= dst 0) (< dst (array-length buckets)))
          (array-set!
            buckets
            dst
            (OptGlobalCopyFacts.Cons fact (box (array-ref buckets dst))))
          unit))]))

(define (opt-global-copy-table-insert-reversed!
  [table : OptGlobalCopyFactTable]
  [facts : OptGlobalCopyFacts]) : unit
  (match facts
    [(OptGlobalCopyFacts.Nil) unit]
    [(OptGlobalCopyFacts.Cons fact rest)
      (begin
        (opt-global-copy-table-insert-reversed! table (box-get rest))
        (opt-global-copy-table-insert! table fact))]))

(define (opt-global-copy-table-from-facts [facts : OptGlobalCopyFacts]) : OptGlobalCopyFactTable
  (let
    [max-dst : i64 (opt-global-copy-facts-max-dst facts (- 0 1))]
    [capacity : i64
      (if (< max-dst 0)
        1
        (+ max-dst 1))]
    [buckets : (Array OptGlobalCopyFacts)
      (array.make-array OptGlobalCopyFacts capacity)]
    [table : OptGlobalCopyFactTable (OptGlobalCopyFactTable buckets)]
    (begin
      (opt-global-copy-buckets-fill-empty! buckets 0)
      (opt-global-copy-table-insert-reversed! table facts)
      table)))

(define (opt-global-pack-word-facts-from-words
  [group : i64]
  [block-id : i64]
  [def-pos : i64]
  [index : i64]
  [words : CompilerIrValueList]
  [tail : OptGlobalPackWordFacts]) : OptGlobalPackWordFacts
  (match words
    [(CompilerIrValueList.Nil) tail]
    [(CompilerIrValueList.Array seq)
      (opt-global-pack-word-facts-from-words
        group
        block-id
        def-pos
        index
        (compiler-ir-value-seq-to-list seq)
        tail)]
    [(CompilerIrValueList.Cons value rest)
      (opt-global-pack-word-facts-from-words
        group
        block-id
        def-pos
        (+ index 1)
        (box-get rest)
        (if (and
          (opt-copy-safe-source? value)
          (not (opt-value-is-var? value group)))
          (OptGlobalPackWordFacts.Cons
            (OptGlobalPackWordFact.Fact group index value block-id def-pos)
            (box tail))
          tail))]))

(define (opt-global-pack-word-facts-from-instr-seq-from
  [block-id : i64]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [tail : OptGlobalPackWordFacts]) : OptGlobalPackWordFacts
  (if (< index 0)
    tail
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [next-tail : OptGlobalPackWordFacts
        (match instr
          [(CompilerIrInstr.Pack group words _)
            (opt-global-pack-word-facts-from-words
              group
              block-id
              (+ index 1)
              0
              words
              tail)]
          [_ tail])]
      (opt-global-pack-word-facts-from-instr-seq-from
        block-id
        slots
        (- index 1)
        next-tail))))

(define (opt-global-pack-word-facts-from-blocks
  [blocks : CompilerIrBlockList]
  [block-id : i64]
  [tail : OptGlobalPackWordFacts]) : OptGlobalPackWordFacts
  (match blocks
    [(CompilerIrBlockList.Nil) tail]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [rest-facts : OptGlobalPackWordFacts
          (opt-global-pack-word-facts-from-blocks
            (box-get rest)
            (+ block-id 1)
            tail)]
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (opt-global-pack-word-facts-from-instr-seq-from
              block-id
              (struct-get instrs slots)
              (- (struct-get instrs len) 1)
              rest-facts)]))]
    [(CompilerIrBlockList.Array seq)
      (opt-global-pack-word-facts-from-blocks
        (compiler-ir-block-seq-to-list seq)
        block-id
        tail)]))

(define (opt-global-pack-word-facts-max-group
  [facts : OptGlobalPackWordFacts]
  [max-group : i64]) : i64
  (match facts
    [(OptGlobalPackWordFacts.Nil) max-group]
    [(OptGlobalPackWordFacts.Cons fact rest)
      (match fact
        [(OptGlobalPackWordFact.Fact group _ _ _ _)
          (opt-global-pack-word-facts-max-group
            (box-get rest)
            (if (> group max-group)
              group
              max-group))])]))

(define (opt-global-pack-word-buckets-fill-empty!
  [buckets : (Array OptGlobalPackWordFacts)]
  [index : i64]) : unit
  (if (>= index (array-length buckets))
    unit
    (begin
      (array-set! buckets index (OptGlobalPackWordFacts.Nil))
      (opt-global-pack-word-buckets-fill-empty! buckets (+ index 1)))))

(define (opt-global-pack-word-table-insert!
  [table : OptGlobalPackWordFactTable]
  [fact : OptGlobalPackWordFact]) : unit
  (match fact
    [(OptGlobalPackWordFact.Fact group _ _ _ _)
      (let
        [buckets : (Array OptGlobalPackWordFacts) (struct-get table buckets)]
        (if (and (>= group 0) (< group (array-length buckets)))
          (array-set!
            buckets
            group
            (OptGlobalPackWordFacts.Cons fact (box (array-ref buckets group))))
          unit))]))

(define (opt-global-pack-word-table-insert-reversed!
  [table : OptGlobalPackWordFactTable]
  [facts : OptGlobalPackWordFacts]) : unit
  (match facts
    [(OptGlobalPackWordFacts.Nil) unit]
    [(OptGlobalPackWordFacts.Cons fact rest)
      (begin
        (opt-global-pack-word-table-insert-reversed! table (box-get rest))
        (opt-global-pack-word-table-insert! table fact))]))

(define (opt-global-pack-word-table-from-facts [facts : OptGlobalPackWordFacts]) : OptGlobalPackWordFactTable
  (let
    [max-group : i64 (opt-global-pack-word-facts-max-group facts (- 0 1))]
    [capacity : i64
      (if (< max-group 0)
        1
        (+ max-group 1))]
    [buckets : (Array OptGlobalPackWordFacts)
      (array.make-array OptGlobalPackWordFacts capacity)]
    [table : OptGlobalPackWordFactTable (OptGlobalPackWordFactTable buckets)]
    (begin
      (opt-global-pack-word-buckets-fill-empty! buckets 0)
      (opt-global-pack-word-table-insert-reversed! table facts)
      table)))

(define (opt-global-pack-word-lookup-list
  [facts : OptGlobalPackWordFacts]
  [group : i64]
  [index : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (match facts
    [(OptGlobalPackWordFacts.Nil) (CompilerIrMaybeValue.No)]
    [(OptGlobalPackWordFacts.Cons fact rest)
      (match fact
        [(OptGlobalPackWordFact.Fact
            found-group
            found-index
            value
            def-block-id
            def-pos)
          (if (and
            (= found-group group)
            (= found-index index)
            (opt-global-fact-available?
              def-block-id
              def-pos
              use-block-id
              use-pos
              doms))
            (CompilerIrMaybeValue.Some value)
            (opt-global-pack-word-lookup-list
              (box-get rest)
              group
              index
              doms
              use-block-id
              use-pos))])]))

(define (opt-global-pack-word-lookup
  [table : OptGlobalPackWordFactTable]
  [group : i64]
  [index : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (let
    [buckets : (Array OptGlobalPackWordFacts) (struct-get table buckets)]
    (if (and (>= group 0) (< group (array-length buckets)))
      (opt-global-pack-word-lookup-list
        (array-ref buckets group)
        group
        index
        doms
        use-block-id
        use-pos)
      (CompilerIrMaybeValue.No))))

(define (opt-global-copy-lookup-list
  [facts : OptGlobalCopyFacts]
  [var : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (match facts
    [(OptGlobalCopyFacts.Nil) (CompilerIrMaybeValue.No)]
    [(OptGlobalCopyFacts.Cons fact rest)
      (match fact
        [(OptGlobalCopyFact.Fact dst src def-block-id def-pos)
          (if (and
            (= dst var)
            (opt-global-fact-available?
              def-block-id
              def-pos
              use-block-id
              use-pos
              doms))
            (CompilerIrMaybeValue.Some src)
            (opt-global-copy-lookup-list
              (box-get rest)
              var
              doms
              use-block-id
              use-pos))])]))

(define (opt-global-copy-lookup
  [table : OptGlobalCopyFactTable]
  [var : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (let
    [buckets : (Array OptGlobalCopyFacts) (struct-get table buckets)]
    (if (and (>= var 0) (< var (array-length buckets)))
      (opt-global-copy-lookup-list
        (array-ref buckets var)
        var
        doms
        use-block-id
        use-pos)
      (CompilerIrMaybeValue.No))))

(define (opt-global-copy-resolve-depth
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [value : CompilerIrValue]
  [remaining : i64]) : CompilerIrValue
  (if (<= remaining 0)
    value
    (match value
      [(CompilerIrValue.Var id)
        (match (opt-global-copy-lookup facts id doms use-block-id use-pos)
          [(CompilerIrMaybeValue.Some replacement)
            (opt-global-copy-resolve-depth
              facts
              doms
              use-block-id
              use-pos
              replacement
              (- remaining 1))]
          [(CompilerIrMaybeValue.No) value])]
      [_ value])))

(define (opt-global-copy-resolve
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [value : CompilerIrValue]) : CompilerIrValue
  (opt-global-copy-resolve-depth facts doms use-block-id use-pos value 8))

(define (opt-global-copy-resolve-mask
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [value : CompilerIrValue]) : CompilerIrValue
  (let
    [resolved : CompilerIrValue
      (opt-global-copy-resolve facts doms use-block-id use-pos value)]
    (match resolved
      [(CompilerIrValue.Var _) resolved]
      [_ value])))

(define (opt-global-copy-subst-call-args-array
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [src : (Array CompilerIrValue)]
  [dst : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set!
        dst
        index
        (opt-global-copy-resolve
          facts
          doms
          use-block-id
          use-pos
          (array-ref src index)))
      (opt-global-copy-subst-call-args-array
        facts
        doms
        use-block-id
        use-pos
        src
        dst
        (+ index 1)))))

(define (opt-global-copy-subst-call-args
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [args : CompilerIrCallArgs]) : CompilerIrCallArgs
  (match args
    [(CompilerIrCallArgs.Nil) (CompilerIrCallArgs.Nil)]
    [(CompilerIrCallArgs.One value)
      (CompilerIrCallArgs.One
        (opt-global-copy-resolve facts doms use-block-id use-pos value))]
    [(CompilerIrCallArgs.Two a b)
      (CompilerIrCallArgs.Two
        (opt-global-copy-resolve facts doms use-block-id use-pos a)
        (opt-global-copy-resolve facts doms use-block-id use-pos b))]
    [(CompilerIrCallArgs.Array values)
      (let
        [out : (Array CompilerIrValue)
          (array.make-array CompilerIrValue (array-length values))]
        (begin
          (opt-global-copy-subst-call-args-array
            facts
            doms
            use-block-id
            use-pos
            values
            out
            0)
          (CompilerIrCallArgs.Array out)))]))

(define (opt-global-copy-resolve-spmd-value
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [class : CompilerIrSpmdValueClass]
  [value : CompilerIrValue]) : CompilerIrValue
  (match class
    [(CompilerIrSpmdValueClass.Uniform)
      (opt-global-copy-resolve facts doms use-block-id use-pos value)]
    [(CompilerIrSpmdValueClass.Varying)
      (opt-global-copy-resolve-mask facts doms use-block-id use-pos value)]
    [(CompilerIrSpmdValueClass.Mask)
      (opt-global-copy-resolve-mask facts doms use-block-id use-pos value)]))

(define (opt-global-copy-subst-spmd-call-arg
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [arg : CompilerIrSpmdCallArg]) : CompilerIrSpmdCallArg
  (match arg
    [(CompilerIrSpmdCallArg.Arg class value ty)
      (CompilerIrSpmdCallArg.Arg
        class
        (opt-global-copy-resolve-spmd-value
          facts
          doms
          use-block-id
          use-pos
          class
          value)
        ty)]))

(define (opt-global-copy-subst-spmd-call-args-array
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [src : (Array CompilerIrSpmdCallArg)]
  [dst : (Array CompilerIrSpmdCallArg)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set!
        dst
        index
        (opt-global-copy-subst-spmd-call-arg
          facts
          doms
          use-block-id
          use-pos
          (array-ref src index)))
      (opt-global-copy-subst-spmd-call-args-array
        facts
        doms
        use-block-id
        use-pos
        src
        dst
        (+ index 1)))))

(define (opt-global-copy-subst-spmd-call-args
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [args : CompilerIrSpmdCallArgList]) : CompilerIrSpmdCallArgList
  (match args
    [(CompilerIrSpmdCallArgList.Nil) CompilerIrSpmdCallArgList.Nil]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (CompilerIrSpmdCallArgList.Cons
        (opt-global-copy-subst-spmd-call-arg
          facts
          doms
          use-block-id
          use-pos
          arg)
        (box
          (opt-global-copy-subst-spmd-call-args
            facts
            doms
            use-block-id
            use-pos
            (box-get rest))))]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 (struct-get seq len)]
        [src : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        [out : (Array CompilerIrSpmdCallArg)
          (array.make-array CompilerIrSpmdCallArg count)]
        (begin
          (opt-global-copy-subst-spmd-call-args-array
            facts
            doms
            use-block-id
            use-pos
            src
            out
            0)
          (CompilerIrSpmdCallArgList.Array (CompilerIrSpmdCallArgSeq out count))))]))

;; A phi input is read on its named predecessor edge. Resolve a copy using the
;; predecessor as the use block and a position after its final instruction.
;; This folds latch-local copies such as `%next = mov %step` directly into a
;; loop-header phi without relying on whole-function register pressure for the
;; allocator to coalesce them.
(define (opt-global-copy-subst-phi-inputs
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [uses : (Array i64)]
  [inputs : CompilerIrPhiInputList]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-global-copy-subst-phi-inputs
        facts
        doms
        uses
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        (match value
          [(CompilerIrValue.Var var)
            ;; A multiply-used copy can be an intentional live-range split.
            ;; Forward only a single-use copy into its phi edge; this removes
            ;; redundant latch/arm copies without extending the source across
            ;; other outgoing edges or phi consumers.
            (if (and
              (>= var 0)
              (< var (array-length uses))
              (= (array-ref uses var) 1))
              (opt-global-copy-resolve
                facts
                doms
                (opt-global-block-id doms label)
                9223372036854775807
                value)
              value)]
          [_ value])
        label
        (opt-global-copy-subst-phi-inputs facts doms uses (box-get rest)))]))

(define (opt-global-copy-subst-instr
  [facts : OptGlobalCopyFactTable]
  [pack-facts : OptGlobalPackWordFactTable]
  [doms : OptDomInfo]
  [uses : (Array i64)]
  [block-id : i64]
  [pos : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (CompilerIrInstr.Mov
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        ty)]
    [(CompilerIrInstr.Gep dst base offset ty)
      (CompilerIrInstr.Gep
        dst
        (opt-global-copy-resolve facts doms block-id pos base)
        (opt-global-copy-resolve facts doms block-id pos offset)
        ty)]
    [(CompilerIrInstr.Load dst src ty)
      (CompilerIrInstr.Load
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        ty)]
    [(CompilerIrInstr.StorePtr ptr value ty)
      (CompilerIrInstr.StorePtr
        (opt-global-copy-resolve facts doms block-id pos ptr)
        (opt-global-copy-resolve facts doms block-id pos value)
        ty)]
    [(CompilerIrInstr.CopyBytes dst src size)
      (CompilerIrInstr.CopyBytes
        (opt-global-copy-resolve facts doms block-id pos dst)
        (opt-global-copy-resolve facts doms block-id pos src)
        size)]
    [(CompilerIrInstr.BoundsCheck index length ok-label)
      (CompilerIrInstr.BoundsCheck
        (opt-global-copy-resolve facts doms block-id pos index)
        (opt-global-copy-resolve facts doms block-id pos length)
        ok-label)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (CompilerIrInstr.Cast
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (CompilerIrInstr.Bitcast
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (CompilerIrInstr.BinOp
        dst
        op
        (opt-global-copy-resolve facts doms block-id pos lhs)
        (opt-global-copy-resolve facts doms block-id pos rhs)
        ty)]
    [(CompilerIrInstr.UnOp dst op src ty)
      (CompilerIrInstr.UnOp
        dst
        op
        (opt-global-copy-resolve facts doms block-id pos src)
        ty)]
    [(CompilerIrInstr.Splat dst src lanes ty)
      (CompilerIrInstr.Splat
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        lanes
        ty)]
    [(CompilerIrInstr.Call dst name args ty)
      (CompilerIrInstr.Call
        dst
        name
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(CompilerIrInstr.CallIndirect dst func args ty)
      (CompilerIrInstr.CallIndirect
        dst
        (opt-global-copy-resolve facts doms block-id pos func)
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(CompilerIrInstr.CallIndirectC dst func args ty)
      (CompilerIrInstr.CallIndirectC
        dst
        (opt-global-copy-resolve facts doms block-id pos func)
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload
            base
            name
            args
            slots)
          (ir-instr-call-cabi-store-result
            (opt-global-copy-resolve facts doms block-id pos base)
            name
            (opt-global-copy-subst-call-args facts doms block-id pos args)
            slots)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            slots)
          (ir-instr-call-indirect-cabi-store-result
            (opt-global-copy-resolve facts doms block-id pos base)
            (opt-global-copy-resolve facts doms block-id pos func)
            (opt-global-copy-subst-call-args facts doms block-id pos args)
            slots)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload
            callee
            backend
            lanes
            active-mask
            args
            result)
          (ir-instr-spmd-call
            callee
            backend
            lanes
            (opt-global-copy-resolve-mask facts doms block-id pos active-mask)
            (opt-global-copy-subst-spmd-call-args facts doms block-id pos args)
            result)])]
    [(CompilerIrInstr.TailCall name args ty)
      (CompilerIrInstr.TailCall
        name
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(CompilerIrInstr.Store name value ty)
      (CompilerIrInstr.Store
        name
        (opt-global-copy-resolve facts doms block-id pos value)
        ty)]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (CompilerIrInstr.Branch
        (opt-global-copy-resolve facts doms block-id pos cond)
        true-label
        false-label)]
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.Some value)
          (CompilerIrInstr.Return
            (CompilerIrMaybeValue.Some
              (opt-global-copy-resolve facts doms block-id pos value)))]
        [(CompilerIrMaybeValue.No) instr])]
    [(CompilerIrInstr.EntryArgc _) instr]
    [(CompilerIrInstr.EntryArgv _) instr]
    [(CompilerIrInstr.EntryEnvp _) instr]
    [(CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (CompilerIrInstr.CpuId
        dst
        (opt-global-copy-resolve facts doms block-id pos leaf)
        (opt-global-copy-resolve facts doms block-id pos subleaf)
        reg-index)]
    [(CompilerIrInstr.Xgetbv dst index)
      (CompilerIrInstr.Xgetbv
        dst
        (opt-global-copy-resolve facts doms block-id pos index))]
    [(CompilerIrInstr.Syscall dst args)
      (CompilerIrInstr.Syscall
        dst
        (opt-global-copy-subst-call-args facts doms block-id pos args))]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.VectorReduce _ _ _ _ _) instr]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-global-copy-resolve-mask facts doms block-id pos lhs)
        (opt-global-copy-resolve-mask facts doms block-id pos rhs)
        lanes)]
    [(CompilerIrInstr.MaskNot dst src lanes)
      (CompilerIrInstr.MaskNot
        dst
        (opt-global-copy-resolve-mask facts doms block-id pos src)
        lanes)]
    [(CompilerIrInstr.MaskReduce dst op src lanes)
      (CompilerIrInstr.MaskReduce
        dst
        op
        (opt-global-copy-resolve-mask facts doms block-id pos src)
        lanes)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.VectorLoad _ _ _ _ _) instr]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload _ _ _ _ _) instr])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ _ _ _ _ _) instr])]
    [(CompilerIrInstr.GatherLoad _) instr]
    [(CompilerIrInstr.VectorShuffle _) instr]
    [(CompilerIrInstr.TailMask _ _ _ _) instr]
    [(CompilerIrInstr.AddrOf _ _) instr]
    [(CompilerIrInstr.Alloc _ _) instr]
    [(CompilerIrInstr.LaneId _ _ _) instr]
    [(CompilerIrInstr.Jump _) instr]
    [(CompilerIrInstr.Phi dst inputs ty)
      (CompilerIrInstr.Phi
        dst
        (opt-global-copy-subst-phi-inputs facts doms uses inputs)
        ty)]
    ;; Pack operands remain unchanged. A dominated Word of a known Pack becomes
    ;; an ordinary copy; the pass's second copy sweep forwards that copy into
    ;; all non-phi uses, and late DCE retires the dead Word/Pack chain.
    [(CompilerIrInstr.Pack _ _ _) instr]
    [(CompilerIrInstr.Word dst src index ty)
      (match src
        [(CompilerIrValue.Var group)
          (match (opt-global-pack-word-lookup
            pack-facts
            group
            index
            doms
            block-id
            pos)
            [(CompilerIrMaybeValue.Some value)
              (CompilerIrInstr.Mov dst value ty)]
            [(CompilerIrMaybeValue.No) instr])]
        [_ instr])]
    [(CompilerIrInstr.TailCallIndirect func args ty)
      (CompilerIrInstr.TailCallIndirect
        (opt-global-copy-resolve facts doms block-id pos func)
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(CompilerIrInstr.Switch index base cases default-label)
      (CompilerIrInstr.Switch
        (opt-global-copy-resolve facts doms block-id pos index)
        base
        cases
        default-label)]))

;; 1:1 rewrite: the output has exactly the input's length, so it is built
;; straight into a right-sized dense array instead of a cons spine that
;; `compiler-ir-block` would then have to re-count and re-copy. The result is a
;; FRESH sequence and `instrs` is not touched, so this needs no unique-ownership
;; argument -- which matters, because the opt2 fixpoint driver
;; (optimize-function-pass-with-summaries) falls back to its INPUT function when
;; a round changes nothing, and the pipeline head can still alias it. refs #5726
(define (opt-global-copy-instr-seq
  [facts : OptGlobalCopyFactTable]
  [pack-facts : OptGlobalPackWordFactTable]
  [doms : OptDomInfo]
  [uses : (Array i64)]
  [block-id : i64]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [out : (Array CompilerIrInstr) (array.make-array CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            out
            index
            (opt-global-copy-subst-instr
              facts
              pack-facts
              doms
              uses
              block-id
              (+ index 1)
              (array-ref slots index)))
          (set! index (+ index 1))))
      (CompilerIrInstrSeq out count))))

;; Every rewrite in this pass keeps the block sequence -- only block contents
;; change -- so the walk position stays the id `doms`'s index assigned.
(define (opt-global-copy-blocks
  [facts : OptGlobalCopyFactTable]
  [pack-facts : OptGlobalPackWordFactTable]
  [doms : OptDomInfo]
  [uses : (Array i64)]
  [blocks : CompilerIrBlockList]
  [block-id : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (CompilerIrBlock.Block
              label
              (opt-global-copy-instr-seq
                facts
                pack-facts
                doms
                uses
                block-id
                instrs))
            (opt-global-copy-blocks
              facts
              pack-facts
              doms
              uses
              (box-get rest)
              (+ block-id 1)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-global-copy-blocks
        facts
        pack-facts
        doms
        uses
        (compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-global-expr-facts-from-instr-seq-from
  [block-id : i64]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [tail : OptGlobalExprFacts]) : OptGlobalExprFacts
  (if (< index 0)
    tail
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [rest-facts : OptGlobalExprFacts tail]
      [next-tail : OptGlobalExprFacts
        (match (opt-global-key-for-instr instr)
          [(OptMaybeGlobalExprKey.Some key)
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (OptGlobalExprFacts.Cons
                  (OptGlobalExprFact.Fact key dst block-id (+ index 1))
                  (box rest-facts))]
              [(option_i64.None) rest-facts])]
          [(OptMaybeGlobalExprKey.No) rest-facts])]
      (opt-global-expr-facts-from-instr-seq-from
        block-id
        slots
        (- index 1)
        next-tail))))

(define (opt-global-expr-facts-from-instr-seq
  [block-id : i64]
  [instrs : CompilerIrInstrSeq]
  [tail : OptGlobalExprFacts]) : OptGlobalExprFacts
  (opt-global-expr-facts-from-instr-seq-from
    block-id
    (struct-get instrs slots)
    (- (struct-get instrs len) 1)
    tail))

(define (opt-global-expr-facts-from-blocks
  [blocks : CompilerIrBlockList]
  [block-id : i64]
  [tail : OptGlobalExprFacts]) : OptGlobalExprFacts
  (match blocks
    [(CompilerIrBlockList.Nil) tail]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [rest-facts : OptGlobalExprFacts
          (opt-global-expr-facts-from-blocks (box-get rest) (+ block-id 1) tail)]
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (opt-global-expr-facts-from-instr-seq block-id instrs rest-facts)]))]
    [(CompilerIrBlockList.Array seq)
      (opt-global-expr-facts-from-blocks
        (compiler-ir-block-seq-to-list seq)
        block-id
        tail)]))

(define (opt-global-fact-bucket-capacity [count : i64]) : i64
  (let
    [target : i64
      (if (< count 1)
        1
        (* count 2))]
    [capacity : i64 1]
    (begin
      (while (< capacity target)
        (set! capacity (* capacity 2)))
      capacity)))

(define (opt-global-expr-facts-count [facts : OptGlobalExprFacts]) : i64
  (match facts
    [(OptGlobalExprFacts.Nil) 0]
    [(OptGlobalExprFacts.Cons _ rest)
      (+ 1 (opt-global-expr-facts-count (box-get rest)))]))

(define (opt-global-expr-buckets-fill-empty!
  [buckets : (Array OptGlobalExprFacts)]
  [index : i64]) : unit
  (if (>= index (array-length buckets))
    unit
    (begin
      (array-set! buckets index (OptGlobalExprFacts.Nil))
      (opt-global-expr-buckets-fill-empty! buckets (+ index 1)))))

(define (opt-global-expr-bucket-index
  [type-segment-bases : i64]
  [buckets : (Array OptGlobalExprFacts)]
  [key : OptGlobalExprKey]) : i64
  (bit-and
    (opt-global-expr-key-hash type-segment-bases key)
    (- (array-length buckets) 1)))

(define (opt-global-expr-table-insert!
  [type-segment-bases : i64]
  [table : OptGlobalExprFactTable]
  [fact : OptGlobalExprFact]) : unit
  (match fact
    [(OptGlobalExprFact.Fact key _ _ _)
      (let
        [buckets : (Array OptGlobalExprFacts) (struct-get table buckets)]
        [bucket : i64
          (opt-global-expr-bucket-index type-segment-bases buckets key)]
        (array-set!
          buckets
          bucket
          (OptGlobalExprFacts.Cons fact (box (array-ref buckets bucket)))))]))

(define (opt-global-expr-table-insert-reversed!
  [type-segment-bases : i64]
  [table : OptGlobalExprFactTable]
  [facts : OptGlobalExprFacts]) : unit
  (match facts
    [(OptGlobalExprFacts.Nil) unit]
    [(OptGlobalExprFacts.Cons fact rest)
      (begin
        (opt-global-expr-table-insert-reversed!
          type-segment-bases
          table
          (box-get rest))
        (opt-global-expr-table-insert! type-segment-bases table fact))]))

(define (opt-global-expr-table-from-facts
  [type-segment-bases : i64]
  [facts : OptGlobalExprFacts]) : OptGlobalExprFactTable
  (let
    [capacity : i64
      (opt-global-fact-bucket-capacity (opt-global-expr-facts-count facts))]
    [buckets : (Array OptGlobalExprFacts)
      (array.make-array OptGlobalExprFacts capacity)]
    [table : OptGlobalExprFactTable (OptGlobalExprFactTable buckets)]
    (begin
      (opt-global-expr-buckets-fill-empty! buckets 0)
      (opt-global-expr-table-insert-reversed! type-segment-bases table facts)
      table)))

(define (opt-global-expr-lookup-list
  [type-segment-bases : i64]
  [facts : OptGlobalExprFacts]
  [key : OptGlobalExprKey]
  [dst : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (match facts
    [(OptGlobalExprFacts.Nil) (CompilerIrMaybeValue.No)]
    [(OptGlobalExprFacts.Cons fact rest)
      (match fact
        [(OptGlobalExprFact.Fact fact-key fact-dst def-block-id def-pos)
          (if (and
            (not (= fact-dst dst))
            (opt-global-expr-key-eq type-segment-bases fact-key key)
            (opt-global-fact-available?
              def-block-id
              def-pos
              use-block-id
              use-pos
              doms))
            (CompilerIrMaybeValue.Some (CompilerIrValue.Var fact-dst))
            (opt-global-expr-lookup-list
              type-segment-bases
              (box-get rest)
              key
              dst
              doms
              use-block-id
              use-pos))])]))

(define (opt-global-expr-lookup
  [type-segment-bases : i64]
  [table : OptGlobalExprFactTable]
  [key : OptGlobalExprKey]
  [dst : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (let
    [buckets : (Array OptGlobalExprFacts) (struct-get table buckets)]
    (opt-global-expr-lookup-list
      type-segment-bases
      (array-ref
        buckets
        (opt-global-expr-bucket-index type-segment-bases buckets key))
      key
      dst
      doms
      use-block-id
      use-pos)))

(define (opt-global-cse-instr
  [type-segment-bases : i64]
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [block-id : i64]
  [pos : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match (opt-global-key-for-instr instr)
    [(OptMaybeGlobalExprKey.Some key)
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (match (opt-global-expr-lookup
            type-segment-bases
            facts
            key
            dst
            doms
            block-id
            pos)
            [(CompilerIrMaybeValue.Some earlier)
              (match instr
                [(CompilerIrInstr.Mov _ _ ty)
                  (CompilerIrInstr.Mov dst earlier ty)]
                [(CompilerIrInstr.Gep _ _ _ ty)
                  (CompilerIrInstr.Mov dst earlier ty)]
                [(CompilerIrInstr.Cast _ _ _ to-ty)
                  (CompilerIrInstr.Mov dst earlier to-ty)]
                [(CompilerIrInstr.BinOp _ op _ _ ty)
                  (CompilerIrInstr.Mov
                    dst
                    earlier
                    (compiler-ir-binop-result-type op ty))]
                [(CompilerIrInstr.UnOp _ _ _ ty)
                  (CompilerIrInstr.Mov dst earlier ty)]
                [_ instr])]
            [(CompilerIrMaybeValue.No) instr])]
        [(option_i64.None) instr])]
    [(OptMaybeGlobalExprKey.No) instr]))

;; The late And-branch rewrite clones shared pure compares into its source and
;; fresh `__bool_and` blocks so both the original branch and the new guard edge
;; reach backend compare/branch fusion. On the next optimizer fixpoint
;; iteration, CSE must not merge those clones back into a dominating comparison
;; -- doing so recreates the setcc/test materialization the CFG rewrite removed.
(define (opt-bool-branch-chain-generated-label? [label : i64]) : bool
  (let
    [marker : String "__bool_and."]
    [text : String (compiler-ir-label-text label)]
    (string.contains (& text) (& marker))))

(define (opt-bool-branch-chain-check-block?
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]) : bool
  (if (opt-bool-branch-chain-generated-label? block-label)
    true
    (let
      [count : i64 (compiler-ir-instr-seq-count instrs)]
      (if (<= count 0)
        false
        (match (compiler-ir-instr-seq-ref instrs (- count 1))
          [(CompilerIrInstr.Branch _ true-label false-label)
            (or
              (opt-bool-branch-chain-generated-label? true-label)
              (opt-bool-branch-chain-generated-label? false-label))]
          [_ false])))))

(define (opt-global-cse-bool-chain-compare?
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]
  [instr : CompilerIrInstr]) : bool
  (and
    (opt-bool-branch-chain-check-block? block-label instrs)
    (match instr
      [(CompilerIrInstr.BinOp _ op _ _ _) (opt-bool-branch-compare-op? op)]
      [_ false])))

;; The x2 conditional-loop unroller emits address-only `i + 1` values in each
;; copy-1 block. Keeping those equivalent adds local to their own block lets
;; the backend prove that every use is a same-block Gep index and fold them to
;; SIB displacements. Cross-block CSE would merge them into one dominating add
;; and force the offset into a register again.
(define (opt-global-cse-unroll2-address-offset?
  [block-label : i64]
  [instr : CompilerIrInstr]) : bool
  (let
    [marker : String "__unroll2_1"]
    [text : String (compiler-ir-label-text block-label)]
    (and
      (string.contains (& text) (& marker))
      (match instr
        [(CompilerIrInstr.BinOp _ op _ rhs _)
          (and
            (match op
              [(CompilerIrBinOp.Add) true]
              [_ false])
            (match rhs
              [(CompilerIrValue.I64 n) (= n 1)]
              [_ false]))]
        [_ false]))))

;; 1:1 rewrite -> dense output sequence (see opt-global-copy-instr-seq). refs #5726
(define (opt-global-cse-instr-seq
  [type-segment-bases : i64]
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [block-label : i64]
  [block-id : i64]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [out : (Array CompilerIrInstr) (array.make-array CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [instr : CompilerIrInstr (array-ref slots index)]
          (begin
            (array-set!
              out
              index
              (if (or
                (opt-global-cse-bool-chain-compare? block-label instrs instr)
                (opt-global-cse-unroll2-address-offset? block-label instr))
                instr
                (opt-global-cse-instr
                  type-segment-bases
                  facts
                  doms
                  block-id
                  (+ index 1)
                  instr)))
            (set! index (+ index 1)))))
      (CompilerIrInstrSeq out count))))

(define (opt-global-cse-blocks
  [type-segment-bases : i64]
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [all-blocks : CompilerIrBlockList]
  [blocks : CompilerIrBlockList]
  [block-id : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (if (opt-induction-switch-arm?
              (struct-get doms index)
              all-blocks
              label
              instrs)
              block
              (CompilerIrBlock.Block
                label
                (opt-global-cse-instr-seq
                  type-segment-bases
                  facts
                  doms
                  label
                  block-id
                  instrs)))
            (opt-global-cse-blocks
              type-segment-bases
              facts
              doms
              all-blocks
              (box-get rest)
              (+ block-id 1)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-global-cse-blocks
        type-segment-bases
        facts
        doms
        all-blocks
        (compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-global-value-number-blocks-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [frame : i64]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [doms : OptDomInfo (struct-get context doms)]
    [copy-fact-list : OptGlobalCopyFacts
      (opt-global-copy-facts-from-blocks blocks 0 (OptGlobalCopyFacts.Nil))]
    [copy-facts : OptGlobalCopyFactTable
      (opt-global-copy-table-from-facts copy-fact-list)]
    [pack-word-fact-list : OptGlobalPackWordFacts
      (opt-global-pack-word-facts-from-blocks
        blocks
        0
        (OptGlobalPackWordFacts.Nil))]
    [pack-word-facts : OptGlobalPackWordFactTable
      (opt-global-pack-word-table-from-facts pack-word-fact-list)]
    [uses : (Array i64) (opt-collect-blocks-uses-array frame blocks)]
    [copied : CompilerIrBlockList
      (opt-global-copy-blocks copy-facts pack-word-facts doms uses blocks 0)]
    [expr-fact-list : OptGlobalExprFacts
      (opt-global-expr-facts-from-blocks copied 0 (OptGlobalExprFacts.Nil))]
    [expr-facts : OptGlobalExprFactTable
      (opt-global-expr-table-from-facts type-segment-bases expr-fact-list)]
    [cse : CompilerIrBlockList
      (opt-global-cse-blocks type-segment-bases expr-facts doms copied copied 0)]
    [cse-copy-fact-list : OptGlobalCopyFacts
      (opt-global-copy-facts-from-blocks cse 0 (OptGlobalCopyFacts.Nil))]
    [cse-copy-facts : OptGlobalCopyFactTable
      (opt-global-copy-table-from-facts cse-copy-fact-list)]
    [cse-uses : (Array i64) (opt-collect-blocks-uses-array frame cse)]
    (opt-global-copy-blocks cse-copy-facts pack-word-facts doms cse-uses cse 0)))

(define (opt-global-value-number-function-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : CompilerIrFunction
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  ;; The opt2 pipeline threads the loop-cluster verification through
  ;; `verified?`: every cluster pass post-verifies its own rewrite (falling
  ;; back to its verified input on rejection), so a verified cluster input
  ;; reaches this pass still verified and the entry verify is skipped.
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(CompilerIrFunction.Function name params ret-ty frame blocks)
          (CompilerIrFunction.Function
            name
            params
            ret-ty
            frame
            (opt-global-value-number-blocks-with-context
              type-segment-bases
              context
              frame
              blocks))])]
    [(ResultCompilerOptimizeVerify.Err _) func]))

(define (opt-global-value-number-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-global-value-number-function-with-context
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        func)]))

(define (opt-cfg-foldable-branch-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Branch cond _ _)
      (match cond
        [(CompilerIrValue.Bool _) true]
        [_ false])]
    [_ false]))

(define (opt-cfg-foldable-branch-instr-seq?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-cfg-foldable-branch-instr?
      (compiler-ir-instr-seq-ref instrs index))
      true
      (opt-cfg-foldable-branch-instr-seq? instrs (+ index 1)))))

(define (opt-cfg-foldable-branch-block? [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (opt-cfg-foldable-branch-instr-seq? instrs 0)]))

(define (opt-cfg-blocks-have-foldable-branch? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-cfg-foldable-branch-block? block)
        true
        (opt-cfg-blocks-have-foldable-branch? (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-blocks-have-foldable-branch? (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-fold-branch [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Branch cond true-label false-label)
      (match cond
        [(CompilerIrValue.Bool known)
          (if known
            (CompilerIrInstr.Jump true-label)
            (CompilerIrInstr.Jump false-label))]
        [_ instr])]
    [_ instr]))

;; 1:1 rewrite -> dense output sequence (see opt-global-copy-instr-seq). The
;; in-place twin below (-instr-seq-rewrite!) stays reserved for the opt1 path,
;; which owns its blocks; this form is the one the opt2 fixpoint can use,
;; because it leaves its input alone. refs #5726
(define (opt-cfg-fold-branches-instr-seq [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [out : (Array CompilerIrInstr) (array.make-array CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set! out index (opt-cfg-fold-branch (array-ref slots index)))
          (set! index (+ index 1))))
      (CompilerIrInstrSeq out count))))

(define (opt-cfg-fold-branches-block [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (CompilerIrBlock.Block label (opt-cfg-fold-branches-instr-seq instrs))]))

(define (opt-cfg-fold-branches-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-cfg-fold-branches-block block)
        (opt-cfg-fold-branches-blocks (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-fold-branches-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-fold-branches-instr-seq-rewrite! [instrs : CompilerIrInstrSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (while (< index count)
      (begin
        (compiler-ir-instr-seq-set!
          instrs
          index
          (opt-cfg-fold-branch (compiler-ir-instr-seq-ref instrs index)))
        (set! index (+ index 1))))))

(define (opt-cfg-fold-branches-block-seq-rewrite! [blocks : CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    (while (< index count)
      (begin
        (match (compiler-ir-block-seq-ref blocks index)
          [(CompilerIrBlock.Block _ instrs)
            (opt-cfg-fold-branches-instr-seq-rewrite! instrs)])
        (set! index (+ index 1))))))

(define (opt-cfg-fold-branches-blocks-rewrite! [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (opt-cfg-fold-branches-instr-seq-rewrite! instrs)])
        (opt-cfg-fold-branches-blocks-rewrite! (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-fold-branches-block-seq-rewrite! seq)]))

(define (opt-cfg-instr-successors [set : OptLabelSet] [instr : CompilerIrInstr]) : OptLabelSet
  (match instr
    [(CompilerIrInstr.Jump label) (opt-label-add set label)]
    [(CompilerIrInstr.Branch _ true-label false-label)
      (opt-label-add (opt-label-add set true-label) false-label)]
    [(CompilerIrInstr.Switch _ _ cases default-label)
      (opt-cfg-switch-case-successors (opt-label-add set default-label) cases)]
    [_ set]))

;; Above this many cases, dedup through a hash set instead of `opt-label-add`'s
;; linear `string.eq` scan. `opt-label-add` prepends only on first occurrence, so
;; seeding the seen-set from `set` and applying the same first-occurrence rule
;; reproduces the identical list, order included. Small switches keep the linear
;; path: seeding and allocating a map is not worth it for a handful of arms, and
;; leaving them alone keeps their output trivially unchanged.
(define (opt-cfg-switch-case-hash-threshold) : i64
  16)

(define (opt-cfg-switch-seen-seed
  [set : OptLabelSet]
  [seen : opt_string_i64_map.Map]) : opt_string_i64_map.Map
  (match set
    [(OptLabelSet.Nil) seen]
    [(OptLabelSet.Dense _ _)
      (begin
        (opt_string_i64_map.insert-ref! (&mut seen) (opt-label-ref set 0) 1)
        (opt-cfg-switch-seen-seed (opt-label-tail set) seen))]))

(define (opt-cfg-switch-case-successors-hashed
  [set : OptLabelSet]
  [cases : CompilerIrSwitchCaseList]
  [seen : opt_string_i64_map.Map]) : OptLabelSet
  (match cases
    [(CompilerIrSwitchCaseList.Nil) set]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case _ label)
          (if (opt_string_i64_map.contains? (& seen) label)
            (opt-cfg-switch-case-successors-hashed set (box-get rest) seen)
            (begin
              (opt_string_i64_map.insert-ref! (&mut seen) label 1)
              (opt-cfg-switch-case-successors-hashed
                (opt-label-cons label set)
                (box-get rest)
                seen)))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-cfg-switch-case-successors-hashed
        set
        (compiler-ir-switch-case-seq-to-list seq)
        seen)]))

(define (opt-cfg-switch-case-successors-linear
  [set : OptLabelSet]
  [cases : CompilerIrSwitchCaseList]) : OptLabelSet
  (match cases
    [(CompilerIrSwitchCaseList.Nil) set]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case _ label)
          (opt-cfg-switch-case-successors-linear
            (opt-label-add set label)
            (box-get rest))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-cfg-switch-case-successors-linear
        set
        (compiler-ir-switch-case-seq-to-list seq))]))

(define (opt-cfg-switch-case-successors
  [set : OptLabelSet]
  [cases : CompilerIrSwitchCaseList]) : OptLabelSet
  (if (<
    (compiler-ir-switch-case-list-count cases)
    (opt-cfg-switch-case-hash-threshold))
    (opt-cfg-switch-case-successors-linear set cases)
    (opt-cfg-switch-case-successors-hashed
      set
      cases
      (opt-cfg-switch-seen-seed set (opt_string_i64_map.with-capacity 64)))))

(define (opt-cfg-instr-seq-successors
  [set : OptLabelSet]
  [instrs : CompilerIrInstrSeq]) : OptLabelSet
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [out : OptLabelSet set]
    (begin
      (while (< index count)
        (begin
          (set! out (opt-cfg-instr-successors out (array-ref slots index)))
          (set! index (+ index 1))))
      out)))

(define (opt-cfg-terminator-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Jump _) true]
    [(CompilerIrInstr.Branch _ _ _) true]
    [(CompilerIrInstr.Return _) true]
    [(CompilerIrInstr.TailCall _ _ _) true]
    [(CompilerIrInstr.TailCallIndirect _ _ _) true]
    [(CompilerIrInstr.Switch _ _ _ _) true]
    [_ false]))

(define (opt-cfg-instr-seq-can-fallthrough? [instrs : CompilerIrInstrSeq]) : bool
  (let
    [count : i64 (struct-get instrs len)]
    (if (= count 0)
      true
      (not
        (opt-cfg-terminator-instr?
          (array-ref (struct-get instrs slots) (- count 1)))))))

(define (opt-cfg-block-successors-with-next
  [block : CompilerIrBlock]
  [next-label : i64]) : OptLabelSet
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [explicit : OptLabelSet
          (opt-cfg-instr-seq-successors (OptLabelSet.Nil) instrs)]
        (if (and
          (compiler-ir-label-some? next-label)
          (opt-cfg-instr-seq-can-fallthrough? instrs))
          (opt-label-add explicit next-label)
          explicit))]))

(define (opt-cfg-blocks-successors-scan
  [blocks : CompilerIrBlockList]
  [label : i64]) : OptLabelSet
  (match blocks
    [(CompilerIrBlockList.Nil) (OptLabelSet.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block block-label _)
          (if (= block-label label)
            (opt-cfg-block-successors-with-next
              block
              (opt-cfg-entry-label (box-get rest)))
            (opt-cfg-blocks-successors-scan (box-get rest) label))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-blocks-successors-scan (compiler-ir-block-seq-to-list seq) label)]))

(define (opt-cfg-reachable-blocks [blocks : CompilerIrBlockList]) : OptLabelSet
  (opt-cfg-index-reachable-labels (opt-cfg-index-build blocks)))

(defenum OptLoopPreheader
  (No)
  (Some i64))

(defenum OptLoopPreheaderCandidate
  (None)
  (One i64)
  (Many))

(defstruct OptLoopBody
  (labels OptLabelSet)
  (members (Array bool))
  (blocks CompilerIrBlockList))

(defenum OptNaturalLoop
  (Loop i64 i64 OptLoopBody OptLoopPreheader))

(defenum OptMaybeNaturalLoop
  (No)
  (Some OptNaturalLoop))

(defenum OptNaturalLoopList
  (Nil)
  (Cons OptNaturalLoop (Box OptNaturalLoopList)))

(defenum OptNaturalLoopCollectState
  (State OptLabelSet OptLabelSet))

(define (opt-loop-body-fill-members!
  [index : OptCfgIndex]
  [members : (Array bool)]
  [labels : OptLabelSet]) : unit
  (match labels
    [(OptLabelSet.Nil) unit]
    [(OptLabelSet.Dense _ _)
      (begin
        (match (opt-cfg-index-id index (opt-label-ref labels 0))
          [(option_i64.Some id)
            (if (and (>= id 0) (< id (array-length members)))
              (array-set! members id true)
              unit)]
          [(option_i64.None) unit])
        (opt-loop-body-fill-members! index members (opt-label-tail labels)))]))

(define (opt-loop-body-member-array-contains-id?
  [members : (Array bool)]
  [id : i64]) : bool
  (if (and (>= id 0) (< id (array-length members)))
    (array-ref members id)
    false))

;; `blocks` is the list `index` was built from, so the walk position is the
;; block id. `opt-loop-body-member-array-contains-id?` range-checks it, which is
;; what the old missing-label arm did.
(define (opt-loop-body-blocks-from
  [members : (Array bool)]
  [blocks : CompilerIrBlockList]
  [block-id : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ _)
          (let
            [tail : CompilerIrBlockList
              (opt-loop-body-blocks-from members (box-get rest) (+ block-id 1))]
            (if (opt-loop-body-member-array-contains-id? members block-id)
              (compiler-ir-block-cons block tail)
              tail))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-body-blocks-from
        members
        (compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-loop-body-build
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [labels : OptLabelSet]) : OptLoopBody
  (let
    [members : (Array bool)
      (array.make-array bool (opt-cfg-index-block-count index))]
    (begin
      (opt-loop-body-fill-members! index members labels)
      (OptLoopBody labels members (opt-loop-body-blocks-from members blocks 0)))))

(define (opt-loop-body-labels [body : OptLoopBody]) : OptLabelSet
  (struct-get body labels))

(define (opt-loop-body-blocks [body : OptLoopBody]) : CompilerIrBlockList
  (struct-get body blocks))

(define (opt-loop-body-contains-id? [body : OptLoopBody] [id : i64]) : bool
  (opt-loop-body-member-array-contains-id? (struct-get body members) id))

(define (opt-loop-body-label-member?
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [label : i64]) : bool
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (opt-loop-body-contains-id? body id)]
    [(option_i64.None) false]))

(define (opt-loop-body-current-blocks-from
  [body : OptLoopBody]
  [blocks : CompilerIrBlockList]
  [block-id : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ _)
          (let
            [tail : CompilerIrBlockList
              (opt-loop-body-current-blocks-from
                body
                (box-get rest)
                (+ block-id 1))]
            (if (opt-loop-body-contains-id? body block-id)
              (compiler-ir-block-cons block tail)
              tail))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-body-current-blocks-from
        body
        (compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-natural-loop-header [loop : OptNaturalLoop]) : i64
  (match loop
    [(OptNaturalLoop.Loop header _ _ _) header]))

(define (opt-natural-loop-latch [loop : OptNaturalLoop]) : i64
  (match loop
    [(OptNaturalLoop.Loop _ latch _ _) latch]))

(define (opt-natural-loop-body-info [loop : OptNaturalLoop]) : OptLoopBody
  (match loop
    [(OptNaturalLoop.Loop _ _ body _) body]))

(define (opt-natural-loop-body [loop : OptNaturalLoop]) : OptLabelSet
  (match loop
    [(OptNaturalLoop.Loop _ _ body _) (opt-loop-body-labels body)]))

(define (opt-natural-loop-body-blocks [loop : OptNaturalLoop]) : CompilerIrBlockList
  (opt-loop-body-blocks (opt-natural-loop-body-info loop)))

(define (opt-natural-loop-body-contains-id? [loop : OptNaturalLoop] [id : i64]) : bool
  (opt-loop-body-contains-id? (opt-natural-loop-body-info loop) id))

(define (opt-natural-loop-current-body-blocks
  [loop : OptNaturalLoop]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-loop-body-current-blocks-from (opt-natural-loop-body-info loop) blocks 0))

(define (opt-natural-loop-preheader [loop : OptNaturalLoop]) : OptLoopPreheader
  (match loop
    [(OptNaturalLoop.Loop _ _ _ preheader) preheader]))

(define (opt-natural-loop-list-count [loops : OptNaturalLoopList]) : i64
  (match loops
    [(OptNaturalLoopList.Nil) 0]
    [(OptNaturalLoopList.Cons _ rest)
      (+ 1 (opt-natural-loop-list-count (box-get rest)))]))

(define (opt-natural-loop-find
  [loops : OptNaturalLoopList]
  [header : i64]
  [latch : i64]) : OptMaybeNaturalLoop
  (match loops
    [(OptNaturalLoopList.Nil) (OptMaybeNaturalLoop.No)]
    [(OptNaturalLoopList.Cons loop rest)
      (if (and
        (= (opt-natural-loop-header loop) header)
        (= (opt-natural-loop-latch loop) latch))
        (OptMaybeNaturalLoop.Some loop)
        (opt-natural-loop-find (box-get rest) header latch))]))

;; Membership during body collection is an O(1) id-indexed marks
;; array (the body/worklist LISTS keep their exact construction order, so
;; downstream output is byte-identical); reachability reads the CFG index's
;; bool array instead of scanning the label list.
(define (opt-natural-loop-collect-add-pred
  [index : OptCfgIndex]
  [marks : (Array bool)]
  [state : OptNaturalLoopCollectState]
  [pred : i64]) : OptNaturalLoopCollectState
  (match state
    [(OptNaturalLoopCollectState.State body worklist)
      (match (opt-cfg-index-id index pred)
        [(option_i64.Some pred-id)
          (if (and
            (array-ref (struct-get index reachable) pred-id)
            (not (array-ref marks pred-id)))
            (begin
              (array-set! marks pred-id true)
              ;; `marks` is the authoritative dedup here: it is seeded with the
              ;; header and the latch, this branch runs only when
              ;; `marks[pred-id]` is clear, and it is set immediately above. So
              ;; `pred` is provably absent from both sets and `opt-label-add`'s
              ;; `string.eq` membership scan always returns false. Prepending
              ;; directly builds the identical lists and drops an O(body^2)
              ;; scan per natural loop.
              (OptNaturalLoopCollectState.State
                (opt-label-cons pred body)
                (opt-label-cons pred worklist)))
            state)]
        [(option_i64.None) state])]))

(define (opt-natural-loop-collect-add-preds
  [index : OptCfgIndex]
  [marks : (Array bool)]
  [preds : OptLabelSet]
  [state : OptNaturalLoopCollectState]) : OptNaturalLoopCollectState
  (match preds
    [(OptLabelSet.Nil) state]
    [(OptLabelSet.Dense _ _)
      (opt-natural-loop-collect-add-preds
        index
        marks
        (opt-label-tail preds)
        (opt-natural-loop-collect-add-pred
          index
          marks
          state
          (opt-label-ref preds 0)))]))

(define (opt-natural-loop-collect-body
  [pred-map : OptPredMap]
  [index : OptCfgIndex]
  [marks : (Array bool)]
  [body : OptLabelSet]
  [worklist : OptLabelSet]) : OptLabelSet
  (match worklist
    [(OptLabelSet.Nil) body]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref worklist 0)]
        [state : OptNaturalLoopCollectState
          (opt-natural-loop-collect-add-preds
            index
            marks
            (opt-pred-map-lookup pred-map label)
            (OptNaturalLoopCollectState.State body (opt-label-tail worklist)))]
        (match state
          [(OptNaturalLoopCollectState.State next-body next-worklist)
            (opt-natural-loop-collect-body
              pred-map
              index
              marks
              next-body
              next-worklist)]))]))

(define (opt-natural-loop-mark-label!
  [index : OptCfgIndex]
  [marks : (Array bool)]
  [label : i64]) : unit
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (array-set! marks id true)]
    [(option_i64.None) unit]))

(define (opt-natural-loop-safe-preheader-block?
  [pred-map : OptPredMap]
  [label : i64]
  [header : i64]) : bool
  (let
    [successors : OptLabelSet (opt-pred-map-successors pred-map label)]
    (and
      (= (opt-label-count successors) 1)
      (opt-label-contains successors header))))

(define (opt-natural-loop-preheader-candidate-add
  [pred-map : OptPredMap]
  [header : i64]
  [candidate : OptLoopPreheaderCandidate]
  [pred : i64]) : OptLoopPreheaderCandidate
  (match candidate
    [(OptLoopPreheaderCandidate.Many) (OptLoopPreheaderCandidate.Many)]
    [(OptLoopPreheaderCandidate.None)
      (if (opt-natural-loop-safe-preheader-block? pred-map pred header)
        (OptLoopPreheaderCandidate.One pred)
        (OptLoopPreheaderCandidate.Many))]
    [(OptLoopPreheaderCandidate.One _) (OptLoopPreheaderCandidate.Many)]))

(define (opt-natural-loop-preheader-candidate-scan
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [header : i64]
  [body : OptLabelSet]
  [preds : OptLabelSet]
  [candidate : OptLoopPreheaderCandidate]) : OptLoopPreheaderCandidate
  (match preds
    [(OptLabelSet.Nil) candidate]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (if (and
          (opt-label-contains reachable pred)
          (not (opt-label-contains body pred)))
          (opt-natural-loop-preheader-candidate-scan
            pred-map
            reachable
            header
            body
            (opt-label-tail preds)
            (opt-natural-loop-preheader-candidate-add
              pred-map
              header
              candidate
              pred))
          (opt-natural-loop-preheader-candidate-scan
            pred-map
            reachable
            header
            body
            (opt-label-tail preds)
            candidate)))]))

(define (opt-natural-loop-preheader-from-candidate
  [candidate : OptLoopPreheaderCandidate]) : OptLoopPreheader
  (match candidate
    [(OptLoopPreheaderCandidate.One label) (OptLoopPreheader.Some label)]
    [_ (OptLoopPreheader.No)]))

(define (opt-natural-loop-find-preheader
  [_blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [header : i64]
  [body : OptLabelSet]) : OptLoopPreheader
  (opt-natural-loop-preheader-from-candidate
    (opt-natural-loop-preheader-candidate-scan
      pred-map
      reachable
      header
      body
      (opt-pred-map-lookup pred-map header)
      (OptLoopPreheaderCandidate.None))))

(define (opt-natural-loop-build
  [blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [header : i64]
  [latch : i64]) : OptNaturalLoop
  (let
    [index : OptCfgIndex (struct-get pred-map index)]
    [marks : (Array bool)
      (array.make-array bool (opt-cfg-index-block-count index))]
    [_seed-header : unit (opt-natural-loop-mark-label! index marks header)]
    [_seed-latch : unit (opt-natural-loop-mark-label! index marks latch)]
    ;; #M-E: a self-loop (latch == header) has body {header}. Seeding the
    ;; worklist with the latch unconditionally walked the HEADER's own
    ;; predecessors, pulling the outside guard block into the body -- which
    ;; left every rotated single-block loop with zero outside predecessors, so
    ;; preheader detection AND synthesis failed and LICM/induction never ran
    ;; on them. The classic algorithm only expands predecessors of body nodes
    ;; other than the header.
    [body-labels : OptLabelSet
      (opt-natural-loop-collect-body
        pred-map
        index
        marks
        (opt-label-add (opt-label-add (OptLabelSet.Nil) header) latch)
        (if (= header latch)
          (OptLabelSet.Nil)
          (opt-label-add (OptLabelSet.Nil) latch)))]
    [body : OptLoopBody
      (opt-loop-body-build blocks (struct-get pred-map index) body-labels)]
    (OptNaturalLoop.Loop
      header
      latch
      body
      (opt-natural-loop-find-preheader
        blocks
        pred-map
        reachable
        header
        body-labels))))

(define (opt-cfg-natural-loop-successors
  [blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [source-id : i64]
  [source : i64]
  [successors : OptLabelSet]
  [tail : OptNaturalLoopList]) : OptNaturalLoopList
  (match successors
    [(OptLabelSet.Nil) tail]
    [(OptLabelSet.Dense _ _)
      (let
        [header : i64 (opt-label-ref successors 0)]
        [next : OptNaturalLoopList
          (opt-cfg-natural-loop-successors
            blocks
            pred-map
            reachable
            doms
            source-id
            source
            (opt-label-tail successors)
            tail)]
        (match (opt-cfg-index-id (struct-get doms index) header)
          [(option_i64.Some header-id)
            ;; `reachable` is the flattened form of this very index's
            ;; `reachable` array (opt-cfg-index-reachable-labels builds one from
            ;; the other), so testing the array at `header-id` decides exactly
            ;; what scanning the set for `header` decided -- without the linear
            ;; `string.eq` walk over every reachable label in the function.
            (if (and
              (array-ref
                (struct-get (struct-get doms index) reachable)
                header-id)
              (opt-dom-info-dominates-id? doms header-id source-id))
              (OptNaturalLoopList.Cons
                (opt-natural-loop-build blocks pred-map reachable header source)
                (box next))
              next)]
          [(option_i64.None) next]))]))

;; `remaining` starts as the very block list `doms`'s index was built from, and
;; `opt-cfg-index-build` numbers blocks in this walk order, so `source-id` is the
;; walk position. The range guard replaces the old missing-label arm: an id past
;; the indexed block count is exactly the case a label lookup would have missed.
(define (opt-cfg-natural-loop-blocks
  [all-blocks : CompilerIrBlockList]
  [remaining : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [source-id : i64]) : OptNaturalLoopList
  (match remaining
    [(CompilerIrBlockList.Nil) (OptNaturalLoopList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (let
            [tail : OptNaturalLoopList
              (opt-cfg-natural-loop-blocks
                all-blocks
                (box-get rest)
                pred-map
                reachable
                doms
                (+ source-id 1))]
            [reachable-ids : (Array bool)
              (struct-get (struct-get doms index) reachable)]
            (if (and
              (< source-id (array-length reachable-ids))
              (array-ref reachable-ids source-id))
              (opt-cfg-natural-loop-successors
                all-blocks
                pred-map
                reachable
                doms
                source-id
                label
                (opt-cfg-block-successors-with-next
                  block
                  (opt-cfg-entry-label (box-get rest)))
                tail)
              tail))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-natural-loop-blocks
        all-blocks
        (compiler-ir-block-seq-to-list seq)
        pred-map
        reachable
        doms
        source-id)]))

;; Allocation-free natural-loop scan for Array block lists: walks the block
;; seq directly and reads each block's successor row from the context's CSR
;; index instead of consing a seq->list copy and recomputing per-block
;; successor sets from instructions. The CSR row holds exactly the
;; deduplicated opt-cfg-block-successors-with-next set in reverse insertion
;; order (opt-label-add prepends; opt-cfg-csr-fill-rows! reverses the row),
;; so iterating blocks from last to first and each CSR row forward while
;; front-consing emits loops in precisely the order the cons-list scan
;; produced. Reachability and ids come from the same index the set scan
;; consulted (the reachable set is built from this reachable array).
(define (opt-cfg-natural-loop-edges-csr
  [all-blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [source-id : i64]
  [source : i64]
  [edge : i64]
  [end : i64]
  [acc : OptNaturalLoopList]) : OptNaturalLoopList
  (if (>= edge end)
    acc
    (let
      [header-id : i64
        (array-ref (struct-get (struct-get index succs) edges) edge)]
      [next-acc : OptNaturalLoopList
        (if (and
          (>= header-id 0)
          (< header-id (array-length (struct-get index reachable))))
          (if (and
            (array-ref (struct-get index reachable) header-id)
            (opt-dom-info-dominates-id? doms header-id source-id))
            (OptNaturalLoopList.Cons
              (opt-natural-loop-build
                all-blocks
                pred-map
                reachable
                (array-ref (struct-get index labels) header-id)
                source)
              (box acc))
            acc)
          acc)]
      (opt-cfg-natural-loop-edges-csr
        all-blocks
        index
        pred-map
        reachable
        doms
        source-id
        source
        (+ edge 1)
        end
        next-acc))))

(define (opt-cfg-natural-loop-block-seq-csr
  [all-blocks : CompilerIrBlockList]
  [seq : CompilerIrBlockSeq]
  [pos : i64]
  [context : OptCfgContext]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [acc : OptNaturalLoopList]) : OptNaturalLoopList
  (if (< pos 0)
    acc
    (match (compiler-ir-block-seq-ref seq pos)
      [(CompilerIrBlock.Block label _)
        (let
          [index : OptCfgIndex (struct-get context index)]
          ;; `blocks` is this seq, and the index numbers its blocks in seq
          ;; order, so the seq position is the block id.
          [next-acc : OptNaturalLoopList
            (if (< pos (array-length (struct-get index reachable)))
              (opt-cfg-natural-loop-edges-csr
                all-blocks
                index
                pred-map
                reachable
                doms
                pos
                label
                (array-ref (struct-get (struct-get index succs) offsets) pos)
                (array-ref
                  (struct-get (struct-get index succs) offsets)
                  (+ pos 1))
                acc)
              acc)]
          (opt-cfg-natural-loop-block-seq-csr
            all-blocks
            seq
            (- pos 1)
            context
            pred-map
            reachable
            doms
            next-acc))])))

(define (opt-cfg-natural-loops-with-context
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]) : OptNaturalLoopList
  (match blocks
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-natural-loop-block-seq-csr
        blocks
        seq
        (- (compiler-ir-block-seq-count seq) 1)
        context
        (struct-get context pred-map)
        (struct-get context reachable)
        (struct-get context doms)
        (OptNaturalLoopList.Nil))]
    [_
      (opt-cfg-natural-loop-blocks
        blocks
        blocks
        (struct-get context pred-map)
        (struct-get context reachable)
        (struct-get context doms)
        0)]))

(define (opt-cfg-natural-loops [blocks : CompilerIrBlockList]) : OptNaturalLoopList
  (opt-cfg-natural-loops-with-context blocks (opt-cfg-context-build blocks)))

;; --- safe loop preheader synthesis ------------------------------------------
;;
;; LICM and induction only operate on loops with a dedicated outside predecessor
;; whose only successor is the loop header. This pass creates that block for
;; conservative natural loops and falls back to the original function if the
;; verifier rejects the result.
(defenum OptLoopPreheadersPhiRewriteResult
  (Result CompilerIrPhiInputList bool))

(define (opt-loop-preheaders-outside-preds-scan
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [header : i64]
  [body : OptLabelSet]
  [preds : OptLabelSet]) : OptLabelSet
  (match preds
    [(OptLabelSet.Nil) (OptLabelSet.Nil)]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        [tail : OptLabelSet
          (opt-loop-preheaders-outside-preds-scan
            reachable
            doms
            header
            body
            (opt-label-tail preds))]
        (if (and
          (opt-label-contains reachable pred)
          (not (opt-label-contains body pred))
          (not (opt-dom-dominates? doms header pred)))
          (opt-label-add tail pred)
          tail))]))

(define (opt-loop-preheaders-outside-preds
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [header : i64]
  [body : OptLabelSet]) : OptLabelSet
  (opt-loop-preheaders-outside-preds-scan
    reachable
    doms
    header
    body
    (opt-pred-map-lookup pred-map header)))

(define (opt-loop-preheaders-candidate-label [header : i64] [suffix : i64]) : i64
  (compiler-ir-label
    (if (= suffix 0)
      (string.append (compiler-ir-label-text header) "__preheader")
      (string.append
        (compiler-ir-label-text header)
        (string.append "__preheader" (string.int->string suffix))))))

(define (opt-loop-preheaders-fresh-label
  [blocks : CompilerIrBlockList]
  [header : i64]
  [suffix : i64]) : i64
  (let
    [candidate : i64 (opt-loop-preheaders-candidate-label header suffix)]
    (if (opt-cfg-block-exists? blocks candidate)
      (opt-loop-preheaders-fresh-label blocks header (+ suffix 1))
      candidate)))

(define (opt-loop-preheaders-phi-outside-values-compatible?
  [outside : OptLabelSet]
  [inputs : CompilerIrPhiInputList]
  [seen : CompilerIrMaybeValue]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) true]
    [(CompilerIrPhiInputList.Array seq)
      (opt-loop-preheaders-phi-outside-values-compatible?
        outside
        (compiler-ir-phi-input-seq-to-list seq)
        seen)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains outside label)
        (match seen
          [(CompilerIrMaybeValue.No)
            (opt-loop-preheaders-phi-outside-values-compatible?
              outside
              (box-get rest)
              (CompilerIrMaybeValue.Some value))]
          [(CompilerIrMaybeValue.Some first)
            (and
              (opt-value-eq first value)
              (opt-loop-preheaders-phi-outside-values-compatible?
                outside
                (box-get rest)
                seen))])
        (opt-loop-preheaders-phi-outside-values-compatible?
          outside
          (box-get rest)
          seen))]))

(define (opt-loop-preheaders-header-instr-compatible?
  [outside : OptLabelSet]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Phi _ inputs _)
      (opt-loop-preheaders-phi-outside-values-compatible?
        outside
        inputs
        (CompilerIrMaybeValue.No))]
    [_ true]))

(define (opt-loop-preheaders-header-instrs-compatible-from?
  [outside : OptLabelSet]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-loop-preheaders-header-instr-compatible?
        outside
        (compiler-ir-instr-seq-ref instrs index))
      (opt-loop-preheaders-header-instrs-compatible-from?
        outside
        instrs
        (+ index 1)))))

(define (opt-loop-preheaders-header-compatible?
  [blocks : CompilerIrBlockList]
  [header : i64]
  [outside : OptLabelSet]) : bool
  (match (opt-cfg-find-block blocks header)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-loop-preheaders-header-instrs-compatible-from? outside instrs 0)])]))

(define (opt-loop-preheaders-existing-candidate-scan
  [pred-map : OptPredMap]
  [header : i64]
  [outside : OptLabelSet]
  [candidate : OptLoopPreheaderCandidate]) : OptLoopPreheaderCandidate
  (match outside
    [(OptLabelSet.Nil) candidate]
    [(OptLabelSet.Dense _ _)
      (opt-loop-preheaders-existing-candidate-scan
        pred-map
        header
        (opt-label-tail outside)
        (opt-natural-loop-preheader-candidate-add
          pred-map
          header
          candidate
          (opt-label-ref outside 0)))]))

(define (opt-loop-preheaders-existing-safe-preheader?
  [pred-map : OptPredMap]
  [header : i64]
  [outside : OptLabelSet]) : bool
  (match (opt-natural-loop-preheader-from-candidate
    (opt-loop-preheaders-existing-candidate-scan
      pred-map
      header
      outside
      (OptLoopPreheaderCandidate.None)))
    [(OptLoopPreheader.Some _) true]
    [(OptLoopPreheader.No) false]))

(define (opt-loop-preheaders-rewrite-phi-inputs-acc
  [inputs : CompilerIrPhiInputList]
  [outside : OptLabelSet]
  [preheader : i64]
  [emitted : bool]
  [acc : CompilerIrPhiInputList]) : OptLoopPreheadersPhiRewriteResult
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil)
      (OptLoopPreheadersPhiRewriteResult.Result
        (compiler-ir-phi-input-list-reverse-onto
          acc
          (CompilerIrPhiInputList.Nil))
        emitted)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-loop-preheaders-rewrite-phi-inputs-acc
        (compiler-ir-phi-input-seq-to-list seq)
        outside
        preheader
        emitted
        acc)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains outside label)
        (if emitted
          (opt-loop-preheaders-rewrite-phi-inputs-acc
            (box-get rest)
            outside
            preheader
            true
            acc)
          (opt-loop-preheaders-rewrite-phi-inputs-acc
            (box-get rest)
            outside
            preheader
            true
            (compiler-ir-phi-input-cons value preheader acc)))
        (opt-loop-preheaders-rewrite-phi-inputs-acc
          (box-get rest)
          outside
          preheader
          emitted
          (compiler-ir-phi-input-cons value label acc)))]))

(define (opt-loop-preheaders-rewrite-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [outside : OptLabelSet]
  [preheader : i64]) : CompilerIrPhiInputList
  (match (opt-loop-preheaders-rewrite-phi-inputs-acc
    inputs
    outside
    preheader
    false
    (CompilerIrPhiInputList.Nil))
    [(OptLoopPreheadersPhiRewriteResult.Result rewritten _) rewritten]))

(define (opt-loop-preheaders-rewrite-header-instr
  [outside : OptLabelSet]
  [preheader : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Phi dst inputs ty)
      (CompilerIrInstr.Phi
        dst
        (opt-loop-preheaders-rewrite-phi-inputs inputs outside preheader)
        ty)]
    [_ instr]))

(define (opt-loop-preheaders-rewrite-header-instrs-from
  [outside : OptLabelSet]
  [preheader : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (compiler-ir-instr-cons
      (opt-loop-preheaders-rewrite-header-instr
        outside
        preheader
        (compiler-ir-instr-seq-ref instrs index))
      (opt-loop-preheaders-rewrite-header-instrs-from
        outside
        preheader
        instrs
        (+ index 1)))))

(define (opt-loop-preheaders-retarget-label
  [label : i64]
  [header : i64]
  [preheader : i64]) : i64
  (if (= label header)
    preheader
    label))

(define (opt-loop-preheaders-retarget-switch-cases-acc
  [cases : CompilerIrSwitchCaseList]
  [header : i64]
  [preheader : i64]
  [acc : CompilerIrSwitchCaseList]) : CompilerIrSwitchCaseList
  (match (compiler-ir-switch-case-list-force-cons cases)
    [(CompilerIrSwitchCaseList.Nil) acc]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case tag label)
          (opt-loop-preheaders-retarget-switch-cases-acc
            (box-get rest)
            header
            preheader
            (compiler-ir-switch-case-cons-linked
              tag
              (opt-loop-preheaders-retarget-label label header preheader)
              acc))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-loop-preheaders-retarget-switch-cases-acc
        (compiler-ir-switch-case-seq-to-list seq)
        header
        preheader
        acc)]))

(define (opt-loop-preheaders-retarget-switch-cases
  [cases : CompilerIrSwitchCaseList]
  [header : i64]
  [preheader : i64]) : CompilerIrSwitchCaseList
  (compiler-ir-switch-case-list-compact-reversed
    (opt-loop-preheaders-retarget-switch-cases-acc
      cases
      header
      preheader
      CompilerIrSwitchCaseList.Nil)))

(define (opt-loop-preheaders-retarget-instr
  [instr : CompilerIrInstr]
  [header : i64]
  [preheader : i64]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Jump label)
      (CompilerIrInstr.Jump
        (opt-loop-preheaders-retarget-label label header preheader))]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (CompilerIrInstr.Branch
        cond
        (opt-loop-preheaders-retarget-label true-label header preheader)
        (opt-loop-preheaders-retarget-label false-label header preheader))]
    [(CompilerIrInstr.Switch index base cases default-label)
      (CompilerIrInstr.Switch
        index
        base
        (opt-loop-preheaders-retarget-switch-cases cases header preheader)
        (opt-loop-preheaders-retarget-label default-label header preheader))]
    [_ instr]))

(define (opt-loop-preheaders-retarget-instrs-from
  [instrs : CompilerIrInstrSeq]
  [header : i64]
  [preheader : i64]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (compiler-ir-instr-cons
      (opt-loop-preheaders-retarget-instr
        (compiler-ir-instr-seq-ref instrs index)
        header
        preheader)
      (opt-loop-preheaders-retarget-instrs-from
        instrs
        header
        preheader
        (+ index 1)))))

(define (opt-loop-preheaders-append-jump
  [instrs : CompilerIrInstrList]
  [target : i64]) : CompilerIrInstrList
  (opt-aggregate-instr-list-append
    instrs
    (compiler-ir-instr-cons
      (CompilerIrInstr.Jump target)
      (CompilerIrInstrList.Nil))))

(define (opt-loop-preheaders-rewrite-block
  [block : CompilerIrBlock]
  [next-label : i64]
  [header : i64]
  [outside : OptLabelSet]
  [preheader : i64]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (if (= label header)
        (compiler-ir-block
          label
          (opt-loop-preheaders-rewrite-header-instrs-from
            outside
            preheader
            instrs
            0))
        (if (opt-label-contains outside label)
          (let
            [retargeted : CompilerIrInstrList
              (opt-loop-preheaders-retarget-instrs-from
                instrs
                header
                preheader
                0)]
            (compiler-ir-block
              label
              (if (and
                (= next-label header)
                (opt-cfg-instr-seq-can-fallthrough? instrs))
                (opt-loop-preheaders-append-jump retargeted preheader)
                retargeted)))
          block))]))

(define (opt-loop-preheaders-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [header : i64]
  [outside : OptLabelSet]
  [preheader : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-loop-preheaders-rewrite-block
          block
          (opt-cfg-entry-label (box-get rest))
          header
          outside
          preheader)
        (opt-loop-preheaders-rewrite-blocks
          (box-get rest)
          header
          outside
          preheader))]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-preheaders-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        header
        outside
        preheader)]))

(define (opt-loop-preheaders-new-block [preheader : i64] [header : i64]) : CompilerIrBlock
  (compiler-ir-block
    preheader
    (compiler-ir-instr-cons
      (CompilerIrInstr.Jump header)
      (CompilerIrInstrList.Nil))))

(define (opt-loop-preheaders-insert-before-header
  [blocks : CompilerIrBlockList]
  [header : i64]
  [preheader : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (if (= label header)
            (compiler-ir-block-cons
              (opt-loop-preheaders-new-block preheader header)
              (compiler-ir-block-cons block (box-get rest)))
            (compiler-ir-block-cons
              block
              (opt-loop-preheaders-insert-before-header
                (box-get rest)
                header
                preheader)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-preheaders-insert-before-header
        (compiler-ir-block-seq-to-list seq)
        header
        preheader)]))

(define (opt-loop-preheaders-synthesize-loop
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [loop : OptNaturalLoop]) : OptBlockListPassResult
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.Some _) (OptBlockListPassResult.Result blocks false)]
    [(OptLoopPreheader.No)
      (let
        [header : i64 (opt-natural-loop-header loop)]
        [body : OptLabelSet (opt-natural-loop-body loop)]
        [outside : OptLabelSet
          (opt-loop-preheaders-outside-preds
            (struct-get context pred-map)
            (struct-get context reachable)
            (struct-get context doms)
            header
            body)]
        (if (and
          (> (opt-label-count outside) 0)
          (not
            (opt-loop-preheaders-existing-safe-preheader?
              (struct-get context pred-map)
              header
              outside))
          (opt-loop-preheaders-header-compatible? blocks header outside))
          (let
            [preheader : i64 (opt-loop-preheaders-fresh-label blocks header 0)]
            [rewritten : CompilerIrBlockList
              (opt-loop-preheaders-rewrite-blocks
                blocks
                header
                outside
                preheader)]
            (OptBlockListPassResult.Result
              (opt-loop-preheaders-insert-before-header
                rewritten
                header
                preheader)
              true))
          (OptBlockListPassResult.Result blocks false)))]))

(define (opt-loop-preheaders-synthesize-loops
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]) : OptBlockListPassResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-loop-preheaders-synthesize-loop blocks context loop)
        [(OptBlockListPassResult.Result next changed)
          (if changed
            (OptBlockListPassResult.Result next true)
            (opt-loop-preheaders-synthesize-loops blocks context (box-get rest)))])]))

(define (opt-loop-preheaders-blocks-once [blocks : CompilerIrBlockList]) : OptBlockListPassResult
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (opt-loop-preheaders-synthesize-loops
      blocks
      context
      (opt-cfg-natural-loops-with-context blocks context))))

(define (opt-loop-preheaders-blocks-once-with-context
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]) : OptBlockListPassResult
  ;; `context` must be valid for `blocks` (the caller's pipeline context).
  (opt-loop-preheaders-synthesize-loops
    blocks
    context
    (opt-cfg-natural-loops-with-context blocks context)))

(define (opt-loop-preheaders-blocks-fixed-result
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [remaining : i64]
  [any-changed : bool]
  [first-round? : bool]) : OptBlockListPassResult
  ;; The first round reuses the pipeline's CFG context (valid for `blocks`);
  ;; only rounds after an actual synthesis (which rewrote the CFG) pay for a
  ;; fresh context build.
  (if (<= remaining 0)
    (OptBlockListPassResult.Result blocks any-changed)
    (match (if first-round?
      (opt-loop-preheaders-blocks-once-with-context context blocks)
      (opt-loop-preheaders-blocks-once blocks))
      [(OptBlockListPassResult.Result next changed)
        (if changed
          (opt-loop-preheaders-blocks-fixed-result
            next
            context
            (- remaining 1)
            true
            false)
          (OptBlockListPassResult.Result next any-changed))])))

(define (opt-loop-preheaders-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match (opt-loop-preheaders-blocks-fixed-result
    blocks
    (opt-cfg-context-build blocks)
    (+ 1 (compiler-ir-block-list-count blocks))
    false
    true)
    [(OptBlockListPassResult.Result next _) next]))

(define (opt-loop-preheaders-function-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-loop-preheaders-blocks-fixed-result
            blocks
            context
            (+ 1 (compiler-ir-block-list-count blocks))
            false
            true)
            [(OptBlockListPassResult.Result next-blocks preheaders-changed?)
              (if (not preheaders-changed?)
                ;; No preheader was synthesized: the input context still
                ;; describes the unchanged CFG, so skip the context rebuild
                ;; and the post-pass verify entirely.
                (OptFunctionCtxResult.Result func context)
                (let
                  [next : CompilerIrFunction
                    (CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      frame
                      next-blocks)]
                  ;; Preheader synthesis may have inserted blocks, so build one
                  ;; fresh context for the rewritten CFG, reuse it for the
                  ;; post-pass verify, and hand it back for the next pass.
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)])))])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-loop-preheaders-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-loop-preheaders-function-with-context-result
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; --- simple top-test loop rotation ------------------------------------------
;;
;; This runs before scalar SSA construction. It only rotates non-SSA loops whose
;; header is a side-effect-free scalar guard ending in a conditional branch, with
;; one safe preheader and one latch. Duplicating the guard into the preheader and
;; latch preserves the zero-trip check while making the steady-state backedge
;; jump directly to the loop body. SSA construction then inserts the phis needed
;; for loop-carried values and rejects unsupported shapes through its existing
;; verifier gate.
(defenum OptLoopRotationHeader
  (No)
  (Header CompilerIrInstrList))

(define (opt-loop-rotation-header-count
  [loops : OptNaturalLoopList]
  [header : i64]) : i64
  (match loops
    [(OptNaturalLoopList.Nil) 0]
    [(OptNaturalLoopList.Cons loop rest)
      (+
        (if (= (opt-natural-loop-header loop) header)
          1
          0)
        (opt-loop-rotation-header-count (box-get rest) header))]))

(define (opt-loop-rotation-guard-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ _ _) true]
    [(CompilerIrInstr.Cast _ _ _ _) true]
    [(CompilerIrInstr.Bitcast _ _ _ _) true]
    [(CompilerIrInstr.BinOp _ op _ _ _) (not (opt-binop-traps? op))]
    [(CompilerIrInstr.UnOp _ _ _ _) true]
    [_ false]))

(define (opt-loop-rotation-header-prefix-ok?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-loop-rotation-guard-instr? (compiler-ir-instr-seq-ref instrs index))
      (opt-loop-rotation-header-prefix-ok? instrs (+ index 1) last))))

(define (opt-loop-rotation-header-list-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (compiler-ir-instr-cons
      (compiler-ir-instr-seq-ref instrs index)
      (opt-loop-rotation-header-list-from instrs (+ index 1)))))

(define (opt-loop-rotation-body-target?
  [body : OptLabelSet]
  [header : i64]
  [label : i64]) : bool
  (and (not (= label header)) (opt-label-contains body label)))

(define (opt-loop-rotation-exit-target? [body : OptLabelSet] [label : i64]) : bool
  (not (opt-label-contains body label)))

(define (opt-loop-rotation-header-shape
  [blocks : CompilerIrBlockList]
  [header : i64]
  [body : OptLabelSet]) : OptLoopRotationHeader
  (match (opt-cfg-find-block blocks header)
    [(OptMaybeBlock.No) (OptLoopRotationHeader.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (if (<= count 0)
              (OptLoopRotationHeader.No)
              (let
                [last : i64 (- count 1)]
                (match (compiler-ir-instr-seq-ref instrs last)
                  [(CompilerIrInstr.Branch _ true-label false-label)
                    (if (and
                      (opt-loop-rotation-header-prefix-ok? instrs 0 last)
                      (or
                        (and
                          (opt-loop-rotation-body-target?
                            body
                            header
                            true-label)
                          (opt-loop-rotation-exit-target? body false-label))
                        (and
                          (opt-loop-rotation-body-target?
                            body
                            header
                            false-label)
                          (opt-loop-rotation-exit-target? body true-label))))
                      (OptLoopRotationHeader.Header
                        (opt-loop-rotation-header-list-from instrs 0))
                      (OptLoopRotationHeader.No))]
                  [_ (OptLoopRotationHeader.No)]))))])]))

(define (opt-loop-rotation-final-jump-to?
  [instrs : CompilerIrInstrSeq]
  [target : i64]) : bool
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (if (<= count 0)
      false
      (match (compiler-ir-instr-seq-ref instrs (- count 1))
        [(CompilerIrInstr.Jump label) (= label target)]
        [_ false]))))

(define (opt-loop-rotation-edge-compatible?
  [blocks : CompilerIrBlockList]
  [label : i64]
  [target : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-loop-rotation-final-jump-to? instrs target)])]))

(define (opt-loop-rotation-prefix-before-final-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : CompilerIrInstrList
  (if (>= index last)
    (CompilerIrInstrList.Nil)
    (compiler-ir-instr-cons
      (compiler-ir-instr-seq-ref instrs index)
      (opt-loop-rotation-prefix-before-final-from instrs (+ index 1) last))))

(define (opt-loop-rotation-replace-final-jump
  [pools : AstNodePoolContext]
  [instrs : CompilerIrInstrSeq]
  [guard : CompilerIrInstrList]) : CompilerIrInstrList
  (opt-aggregate-instr-list-append
    (opt-loop-rotation-prefix-before-final-from
      instrs
      0
      (- (compiler-ir-instr-seq-count instrs) 1))
    (compiler-ir-clone-instr-list pools guard)))

(define (opt-loop-rotation-rewrite-block
  [pools : AstNodePoolContext]
  [block : CompilerIrBlock]
  [preheader : i64]
  [latch : i64]
  [guard : CompilerIrInstrList]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (if (or (= label preheader) (= label latch))
        (compiler-ir-block
          label
          (opt-loop-rotation-replace-final-jump pools instrs guard))
        block)]))

(define (opt-loop-rotation-rewrite-blocks
  [pools : AstNodePoolContext]
  [blocks : CompilerIrBlockList]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [guard : CompilerIrInstrList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (if (= label header)
            (opt-loop-rotation-rewrite-blocks
              pools
              (box-get rest)
              header
              preheader
              latch
              guard)
            (compiler-ir-block-cons
              (opt-loop-rotation-rewrite-block
                pools
                block
                preheader
                latch
                guard)
              (opt-loop-rotation-rewrite-blocks
                pools
                (box-get rest)
                header
                preheader
                latch
                guard)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-rotation-rewrite-blocks
        pools
        (compiler-ir-block-seq-to-list seq)
        header
        preheader
        latch
        guard)]))

(define (opt-loop-rotation-apply-guard
  [pools : AstNodePoolContext]
  [blocks : CompilerIrBlockList]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [guard : CompilerIrInstrList]) : OptBlockListPassResult
  (let
    [next : CompilerIrBlockList
      (opt-loop-rotation-rewrite-blocks
        pools
        blocks
        header
        preheader
        latch
        guard)]
    (if (and
      (opt-cfg-block-labels-unique? next)
      (opt-cfg-successor-targets-known? next))
      (OptBlockListPassResult.Result next true)
      (OptBlockListPassResult.Result blocks false))))

(define (opt-loop-rotation-loop
  [pools : AstNodePoolContext]
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]
  [loop : OptNaturalLoop]) : OptBlockListPassResult
  (let
    [header : i64 (opt-natural-loop-header loop)]
    [latch : i64 (opt-natural-loop-latch loop)]
    [body : OptLabelSet (opt-natural-loop-body loop)]
    [preds : OptLabelSet
      (opt-pred-map-lookup (struct-get context pred-map) header)]
    (match (opt-natural-loop-preheader loop)
      [(OptLoopPreheader.No) (OptBlockListPassResult.Result blocks false)]
      [(OptLoopPreheader.Some preheader)
        (if (and
          (= (opt-loop-rotation-header-count loops header) 1)
          (= (opt-label-count preds) 2)
          (opt-label-contains preds preheader)
          (opt-label-contains preds latch)
          (opt-loop-rotation-edge-compatible? blocks preheader header)
          (opt-loop-rotation-edge-compatible? blocks latch header))
          (match (opt-loop-rotation-header-shape blocks header body)
            [(OptLoopRotationHeader.No)
              (OptBlockListPassResult.Result blocks false)]
            [(OptLoopRotationHeader.Header guard)
              (opt-loop-rotation-apply-guard
                pools
                blocks
                header
                preheader
                latch
                guard)])
          (OptBlockListPassResult.Result blocks false))])))

(define (opt-loop-rotation-loops
  [pools : AstNodePoolContext]
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]
  [remaining : OptNaturalLoopList]) : OptBlockListPassResult
  (match remaining
    [(OptNaturalLoopList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-loop-rotation-loop pools blocks context loops loop)
        [(OptBlockListPassResult.Result next changed)
          (if changed
            (OptBlockListPassResult.Result next true)
            (opt-loop-rotation-loops pools blocks context loops (box-get rest)))])]))

;; The step already builds a CFG context for `blocks`. Carry it out so the
;; fixpoint below can hand the LAST step's context -- the one built for the
;; blocks that did not rotate, i.e. exactly the blocks this pass returns -- to
;; the next pass instead of making it build an identical one.
(defenum OptLoopRotationCtxResult
  (Result CompilerIrBlockList bool OptCfgContext))

(define (opt-loop-rotation-blocks-once-result
  [pools : AstNodePoolContext]
  [blocks : CompilerIrBlockList]) : OptLoopRotationCtxResult
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    [loops : OptNaturalLoopList
      (opt-cfg-natural-loops-with-context blocks context)]
    (match (opt-loop-rotation-loops pools blocks context loops loops)
      [(OptBlockListPassResult.Result next changed)
        (OptLoopRotationCtxResult.Result next changed context)])))

(define (opt-loop-rotation-blocks-fixed-result
  [pools : AstNodePoolContext]
  [blocks : CompilerIrBlockList]
  [remaining : i64]) : OptBlockCtxResult
  (if (<= remaining 0)
    (OptBlockCtxResult.Result blocks (opt-cfg-context-empty) false)
    (match (opt-loop-rotation-blocks-once-result pools blocks)
      [(OptLoopRotationCtxResult.Result next changed context)
        (if changed
          (opt-loop-rotation-blocks-fixed-result pools next (- remaining 1))
          ;; Every arm of `opt-loop-rotation-loops` returns its input verbatim
          ;; when it reports no change, so `context` is valid for `next`.
          (OptBlockCtxResult.Result next context true))])))

(define (opt-loop-rotation-blocks-result
  [pools : AstNodePoolContext]
  [blocks : CompilerIrBlockList]) : OptBlockCtxResult
  ;; The natural-loop finder is dominance based, so let it decide whether the
  ;; CFG contains a loop. Textual block order is not a loop property: inlining
  ;; and block layout may put a latch before its header.
  (if (opt-ssa-blocks-have-phi? blocks)
    (OptBlockCtxResult.Result blocks (opt-cfg-context-empty) false)
    (opt-loop-rotation-blocks-fixed-result
      pools
      blocks
      (+ 1 (compiler-ir-block-list-count blocks)))))

(define (opt-loop-rotation-blocks
  [pools : AstNodePoolContext]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match (opt-loop-rotation-blocks-result pools blocks)
    [(OptBlockCtxResult.Result out _ _) out]))

(define (opt-loop-rotation-function-result
  [pools : AstNodePoolContext]
  [func : CompilerIrFunction]) : OptBlockCtxResult
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-loop-rotation-blocks-result pools blocks)]))

;; --- post-SSA loop rotation (rotate_ssa) -------------------------------------
;;
;; The pre-SSA rotation pass (#2458) never fires on lowered while-loops: their
;; preheaders are synthesized by the loop-preheaders pass (#2457), which runs
;; after scalar SSA construction, so nested/inner loops stay top-tested (a
;; guard block plus a jump back on every iteration) and loop BCE misses the
;; facts it derives from the rotated shape. This pass rotates one SSA-form
;; natural loop per invocation (the surrounding fixpoint handles the rest):
;; the header's phis move to the top of the loop-body block, the header's
;; side-effect-free guard prefix plus conditional branch is cloned into the
;; preheader and the latch with fresh destinations (phi uses remapped to that
;; edge's input value), loop-carried values used after the loop are merged
;; through fresh exit phis, and the header block is replaced by an empty
;; landing block on the preheader guard's loop edge. The landing block keeps a
;; dedicated single-successor preheader for the rotated loop (the guard makes
;; the old preheader multi-successor), so LICM can still hoist loop-invariant
;; work in the same pipeline iteration; the moved phis take their preheader
;; input from the landing block, while the exit phis keep the direct
;; preheader/latch edges. The rewrite is verifier-gated; any rejected shape or
;; failed verify returns the input function unchanged.
(defenum OptRotateSsaPhiRecs
  (Nil)
  (Cons i64 CompilerIrValue CompilerIrValue AstType (Box OptRotateSsaPhiRecs)))

(defenum OptRotateSsaMaybePhiRecs
  (No)
  (Some OptRotateSsaPhiRecs))

(defstruct OptRotateSsaShape
  (phis CompilerIrInstrList)
  (recs OptRotateSsaPhiRecs)
  (guard CompilerIrInstrList)
  (cond-value CompilerIrValue)
  (true-label i64)
  (false-label i64)
  (body-label i64)
  (exit-label i64))

(defenum OptRotateSsaMaybeShape
  (No)
  (Some OptRotateSsaShape))

(defenum OptRotateSsaClone
  (Clone CompilerIrInstrList i64))

(defenum OptRotateSsaExitPhis
  (Result CompilerIrInstrList OptCopyEnv i64))

(defenum OptRotateSsaRewrite
  (No)
  (Some CompilerIrBlockList i64))

(defstruct OptRotateSsaPlan
  (header i64)
  (preheader i64)
  (latch i64)
  (land-label i64)
  (body-label i64)
  (exit-label i64)
  (body OptLabelSet)
  (phis CompilerIrInstrList)
  (preheader-guard CompilerIrInstrList)
  (latch-guard CompilerIrInstrList)
  (exit-phis CompilerIrInstrList)
  (exit-env OptCopyEnv))

(define (opt-rotate-ssa-land-label [header : i64]) : i64
  (compiler-ir-label
    (string.append (compiler-ir-label-text header) "__rotate_land")))

(define (opt-rotate-ssa-only-label? [set : OptLabelSet] [label : i64]) : bool
  (and (= (opt-label-count set) 1) (opt-label-contains set label)))

(define (opt-rotate-ssa-leading-phi-end
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    index
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ _ _)
        (opt-rotate-ssa-leading-phi-end instrs (+ index 1))]
      [_ index])))

;; Each header phi must carry exactly the two loop-edge inputs {preheader,
;; latch}; the record keeps (dst, preheader input, latch input, type).
(define (opt-rotate-ssa-phi-recs
  [phis : CompilerIrInstrList]
  [preheader : i64]
  [latch : i64]) : OptRotateSsaMaybePhiRecs
  (match phis
    [(CompilerIrInstrList.Nil)
      (OptRotateSsaMaybePhiRecs.Some (OptRotateSsaPhiRecs.Nil))]
    [(CompilerIrInstrList.Cons instr rest)
      (match (opt-rotate-ssa-phi-recs (box-get rest) preheader latch)
        [(OptRotateSsaMaybePhiRecs.No) (OptRotateSsaMaybePhiRecs.No)]
        [(OptRotateSsaMaybePhiRecs.Some recs)
          (match instr
            [(CompilerIrInstr.Phi dst inputs ty)
              (match (compiler-ir-phi-input-list-force-cons inputs)
                [(CompilerIrPhiInputList.Cons first-value first-label rest1)
                  (match (box-get rest1)
                    [(CompilerIrPhiInputList.Cons
                        second-value
                        second-label
                        rest2)
                      (match (box-get rest2)
                        [(CompilerIrPhiInputList.Nil)
                          (cond
                            [(and
                                (= first-label preheader)
                                (= second-label latch))
                              (OptRotateSsaMaybePhiRecs.Some
                                (OptRotateSsaPhiRecs.Cons
                                  dst
                                  first-value
                                  second-value
                                  ty
                                  (box recs)))]
                            [(and
                                (= first-label latch)
                                (= second-label preheader))
                              (OptRotateSsaMaybePhiRecs.Some
                                (OptRotateSsaPhiRecs.Cons
                                  dst
                                  second-value
                                  first-value
                                  ty
                                  (box recs)))]
                            [else (OptRotateSsaMaybePhiRecs.No)])]
                        [_ (OptRotateSsaMaybePhiRecs.No)])]
                    [_ (OptRotateSsaMaybePhiRecs.No)])]
                [_ (OptRotateSsaMaybePhiRecs.No)])]
            [_ (OptRotateSsaMaybePhiRecs.No)])])]))

(define (opt-rotate-ssa-shape-from-branch
  [instrs : CompilerIrInstrSeq]
  [phi-end : i64]
  [last : i64]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [body : OptLabelSet]
  [cond-value : CompilerIrValue]
  [true-label : i64]
  [false-label : i64]) : OptRotateSsaMaybeShape
  (let
    [true-is-body : bool
      (and
        (opt-loop-rotation-body-target? body header true-label)
        (opt-loop-rotation-exit-target? body false-label))]
    [false-is-body : bool
      (and
        (opt-loop-rotation-body-target? body header false-label)
        (opt-loop-rotation-exit-target? body true-label))]
    (if (or true-is-body false-is-body)
      (match (opt-rotate-ssa-phi-recs
        (opt-loop-rotation-prefix-before-final-from instrs 0 phi-end)
        preheader
        latch)
        [(OptRotateSsaMaybePhiRecs.No) (OptRotateSsaMaybeShape.No)]
        [(OptRotateSsaMaybePhiRecs.Some recs)
          (OptRotateSsaMaybeShape.Some
            (OptRotateSsaShape
              (opt-loop-rotation-prefix-before-final-from instrs 0 phi-end)
              recs
              (opt-loop-rotation-prefix-before-final-from instrs phi-end last)
              cond-value
              true-label
              false-label
              (if true-is-body
                true-label
                false-label)
              (if true-is-body
                false-label
                true-label)))])
      (OptRotateSsaMaybeShape.No))))

;; Header shape: leading phis (zero or more), then a whitelisted pure guard
;; prefix (possibly empty), then a conditional branch with one arm into the
;; loop body (never the header itself: self-loops are already rotated) and one
;; arm out of it.
(define (opt-rotate-ssa-header-shape
  [blocks : CompilerIrBlockList]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [body : OptLabelSet]) : OptRotateSsaMaybeShape
  (match (opt-cfg-find-block blocks header)
    [(OptMaybeBlock.No) (OptRotateSsaMaybeShape.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (if (<= count 0)
              (OptRotateSsaMaybeShape.No)
              (let
                [last : i64 (- count 1)]
                [phi-end : i64 (opt-rotate-ssa-leading-phi-end instrs 0)]
                (if (not
                  (opt-loop-rotation-header-prefix-ok? instrs phi-end last))
                  (OptRotateSsaMaybeShape.No)
                  (match (compiler-ir-instr-seq-ref instrs last)
                    [(CompilerIrInstr.Branch cond-value true-label false-label)
                      (opt-rotate-ssa-shape-from-branch
                        instrs
                        phi-end
                        last
                        header
                        preheader
                        latch
                        body
                        cond-value
                        true-label
                        false-label)]
                    [_ (OptRotateSsaMaybeShape.No)])))))])]))

(define (opt-rotate-ssa-instr-seq-has-phi?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ _ _) true]
      [_ (opt-rotate-ssa-instr-seq-has-phi? instrs (+ index 1))])))

;; The rewrite prepends phis to the body and exit blocks; a pre-existing phi
;; there would have a single input labeled with the deleted header, so such
;; blocks are rejected (a missing block is rejected too).
(define (opt-rotate-ssa-block-has-phi?
  [blocks : CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) true]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-rotate-ssa-instr-seq-has-phi? instrs 0)])]))

;; Reject break-style side exits: no loop-body block other than the header may
;; branch to the exit label.
(define (opt-rotate-ssa-body-avoids-exit?
  [pred-map : OptPredMap]
  [body : OptLabelSet]
  [header : i64]
  [exit-label : i64]) : bool
  (match body
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref body 0)]
        (and
          (or
            (= label header)
            (not
              (opt-label-contains
                (opt-pred-map-successors pred-map label)
                exit-label)))
          (opt-rotate-ssa-body-avoids-exit?
            pred-map
            (opt-label-tail body)
            header
            exit-label)))]))

(define (opt-rotate-ssa-uses-except-header
  [set : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]
  [header : i64]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (opt-rotate-ssa-uses-except-header
            (if (= label header)
              set
              (opt-collect-instr-seq-uses set instrs))
            (box-get rest)
            header)])]
    [(CompilerIrBlockList.Array seq)
      (opt-rotate-ssa-uses-except-header
        set
        (compiler-ir-block-seq-to-list seq)
        header)]))

(define (opt-rotate-ssa-uses-outside-body
  [set : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]
  [body : OptLabelSet]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (opt-rotate-ssa-uses-outside-body
            (if (opt-label-contains body label)
              set
              (opt-collect-instr-seq-uses set instrs))
            (box-get rest)
            body)])]
    [(CompilerIrBlockList.Array seq)
      (opt-rotate-ssa-uses-outside-body
        set
        (compiler-ir-block-seq-to-list seq)
        body)]))

(define (opt-rotate-ssa-instr-dst [instr : CompilerIrInstr]) : i64
  (match instr
    [(CompilerIrInstr.Mov dst _ _) dst]
    [(CompilerIrInstr.Cast dst _ _ _) dst]
    [(CompilerIrInstr.Bitcast dst _ _ _) dst]
    [(CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [(CompilerIrInstr.UnOp dst _ _ _) dst]
    [_ (- 0 1)]))

;; The guard prefix is deleted with the header and only re-materialized with
;; fresh destinations, so every guard destination must be used exclusively
;; inside the header by the guard/branch itself; `uses` covers all other
;; blocks plus the header's own phi inputs.
(define (opt-rotate-ssa-guard-dsts-local?
  [guard : CompilerIrInstrList]
  [uses : opt_i64_i64_map.Map]) : bool
  (match guard
    [(CompilerIrInstrList.Nil) true]
    [(CompilerIrInstrList.Cons instr rest)
      (let
        [dst : i64 (opt-rotate-ssa-instr-dst instr)]
        (and
          (>= dst 0)
          (not (opt-used-contains uses dst))
          (opt-rotate-ssa-guard-dsts-local? (box-get rest) uses)))]))

;; Map each header-phi destination to the input value carried by one loop
;; edge: the preheader input for the preheader clone, the latch input for the
;; latch clone.
(define (opt-rotate-ssa-edge-env [recs : OptRotateSsaPhiRecs] [use-init : bool]) : OptCopyEnv
  (match recs
    [(OptRotateSsaPhiRecs.Nil) (OptCopyEnv.Nil)]
    [(OptRotateSsaPhiRecs.Cons dst init back _ rest)
      (OptCopyEnv.Cons
        dst
        (if use-init
          init
          back)
        (box (opt-rotate-ssa-edge-env (box-get rest) use-init)))]))

(define (opt-rotate-ssa-clone-guard-instr
  [env : OptCopyEnv]
  [dst : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov _ src ty)
      (CompilerIrInstr.Mov dst (opt-copy-resolve env src) ty)]
    [(CompilerIrInstr.Cast _ src from-ty to-ty)
      (CompilerIrInstr.Cast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(CompilerIrInstr.Bitcast _ src from-ty to-ty)
      (CompilerIrInstr.Bitcast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(CompilerIrInstr.BinOp _ op lhs rhs ty)
      (CompilerIrInstr.BinOp
        dst
        op
        (opt-copy-resolve env lhs)
        (opt-copy-resolve env rhs)
        ty)]
    [(CompilerIrInstr.UnOp _ op src ty)
      (CompilerIrInstr.UnOp dst op (opt-copy-resolve env src) ty)]
    ;; Unreachable: the guard prefix is restricted to the whitelist above; the
    ;; post-rewrite verifier rejects any duplicate definition this would leave.
    [_ instr]))

;; Clone the guard prefix with fresh destinations, remapping intra-guard uses
;; of earlier guard destinations to their fresh clones and phi-destination
;; uses through the edge env, then end with the header's branch (same arm
;; orientation) on the remapped condition.
(define (opt-rotate-ssa-clone-guard
  [env : OptCopyEnv]
  [guard : CompilerIrInstrList]
  [cond-value : CompilerIrValue]
  [true-label : i64]
  [false-label : i64]
  [next-var : i64]) : OptRotateSsaClone
  (match guard
    [(CompilerIrInstrList.Nil)
      (OptRotateSsaClone.Clone
        (compiler-ir-instr-cons
          (CompilerIrInstr.Branch
            (opt-copy-resolve env cond-value)
            true-label
            false-label)
          (CompilerIrInstrList.Nil))
        next-var)]
    [(CompilerIrInstrList.Cons instr rest)
      (let
        [cloned : CompilerIrInstr
          (opt-rotate-ssa-clone-guard-instr env next-var instr)]
        [next-env : OptCopyEnv
          (OptCopyEnv.Cons
            (opt-rotate-ssa-instr-dst instr)
            (CompilerIrValue.Var next-var)
            (box env))]
        (match (opt-rotate-ssa-clone-guard
          next-env
          (box-get rest)
          cond-value
          true-label
          false-label
          (+ next-var 1))
          [(OptRotateSsaClone.Clone cloned-rest out-var)
            (OptRotateSsaClone.Clone
              (compiler-ir-instr-cons cloned cloned-rest)
              out-var)]))]))

;; Rebuild the header phis for the top of the loop-body block: same
;; destinations, initial input relabeled to the landing block (the body's new
;; preheader-side predecessor), latch input unchanged.
(define (opt-rotate-ssa-moved-phis
  [recs : OptRotateSsaPhiRecs]
  [land-label : i64]
  [latch : i64]) : CompilerIrInstrList
  (match recs
    [(OptRotateSsaPhiRecs.Nil) (CompilerIrInstrList.Nil)]
    [(OptRotateSsaPhiRecs.Cons dst init back ty rest)
      (compiler-ir-instr-cons
        (CompilerIrInstr.Phi
          dst
          (compiler-ir-phi-input-cons
            init
            land-label
            (compiler-ir-phi-input-cons back latch (CompilerIrPhiInputList.Nil)))
          ty)
        (opt-rotate-ssa-moved-phis (box-get rest) land-label latch))]))

;; For each header phi whose destination is used outside the loop body, mint a
;; fresh exit phi merging the same edge inputs at the exit block, and record
;; the destination remap for the outside-use rewrite.
(define (opt-rotate-ssa-exit-phis
  [recs : OptRotateSsaPhiRecs]
  [outside-uses : opt_i64_i64_map.Map]
  [preheader : i64]
  [latch : i64]
  [next-var : i64]) : OptRotateSsaExitPhis
  (match recs
    [(OptRotateSsaPhiRecs.Nil)
      (OptRotateSsaExitPhis.Result
        (CompilerIrInstrList.Nil)
        (OptCopyEnv.Nil)
        next-var)]
    [(OptRotateSsaPhiRecs.Cons dst init back ty rest)
      (if (opt-used-contains outside-uses dst)
        (match (opt-rotate-ssa-exit-phis
          (box-get rest)
          outside-uses
          preheader
          latch
          (+ next-var 1))
          [(OptRotateSsaExitPhis.Result phis env out-var)
            (OptRotateSsaExitPhis.Result
              (compiler-ir-instr-cons
                (CompilerIrInstr.Phi
                  next-var
                  (compiler-ir-phi-input-cons
                    init
                    preheader
                    (compiler-ir-phi-input-cons
                      back
                      latch
                      (CompilerIrPhiInputList.Nil)))
                  ty)
                phis)
              (OptCopyEnv.Cons dst (CompilerIrValue.Var next-var) (box env))
              out-var)])
        (opt-rotate-ssa-exit-phis
          (box-get rest)
          outside-uses
          preheader
          latch
          next-var))]))

(define (opt-rotate-ssa-subst-phi-inputs
  [env : OptCopyEnv]
  [inputs : CompilerIrPhiInputList]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-rotate-ssa-subst-phi-inputs
        env
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        (opt-copy-resolve env value)
        label
        (opt-rotate-ssa-subst-phi-inputs env (box-get rest)))]))

;; Outside-the-loop use rewriting must also rewrite phi inputs (the block-local
;; copy substitution deliberately skips them), so wrap opt-copy-subst-instr.
(define (opt-rotate-ssa-subst-instr
  [env : OptCopyEnv]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Phi dst inputs ty)
      (CompilerIrInstr.Phi dst (opt-rotate-ssa-subst-phi-inputs env inputs) ty)]
    [_ (opt-copy-subst-instr env instr)]))

(define (opt-rotate-ssa-rewrite-instr-seq-from
  [env : OptCopyEnv]
  [subst? : bool]
  [replace-index : i64]
  [guard : CompilerIrInstrList]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [acc : CompilerIrInstrList]) : CompilerIrInstrList
  (if (< index 0)
    acc
    (if (= index replace-index)
      (opt-rotate-ssa-rewrite-instr-seq-from
        env
        subst?
        replace-index
        guard
        instrs
        (- index 1)
        guard)
      (let
        [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
        [rewritten : CompilerIrInstr
          (if subst?
            (opt-rotate-ssa-subst-instr env instr)
            instr)]
        (opt-rotate-ssa-rewrite-instr-seq-from
          env
          subst?
          replace-index
          guard
          instrs
          (- index 1)
          (compiler-ir-instr-cons rewritten acc))))))

(define (opt-rotate-ssa-rewrite-instr-seq
  [env : OptCopyEnv]
  [subst? : bool]
  [replace-final? : bool]
  [guard : CompilerIrInstrList]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [replace-index : i64
      (if (and replace-final? (> count 0))
        (- count 1)
        (- 0 1))]
    [initial : CompilerIrInstrList
      (if (and replace-final? (= count 0))
        guard
        CompilerIrInstrList.Nil)]
    (opt-rotate-ssa-rewrite-instr-seq-from
      env
      subst?
      replace-index
      guard
      instrs
      (- count 1)
      initial)))

(define (opt-rotate-ssa-block-touched? [plan : OptRotateSsaPlan] [label : i64]) : bool
  (or
    (= label (struct-get plan preheader))
    (= label (struct-get plan latch))
    (= label (struct-get plan body-label))
    (= label (struct-get plan exit-label))
    (and
      (not (opt-label-contains (struct-get plan body) label))
      (match (struct-get plan exit-env)
        [(OptCopyEnv.Nil) false]
        [_ true]))))

(define (opt-rotate-ssa-rewrite-instrs
  [plan : OptRotateSsaPlan]
  [label : i64]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (let
    [replace-final? : bool
      (or
        (= label (struct-get plan preheader))
        (= label (struct-get plan latch)))]
    [guard : CompilerIrInstrList
      (cond
        [(= label (struct-get plan preheader))
          (struct-get plan preheader-guard)]
        [(= label (struct-get plan latch)) (struct-get plan latch-guard)]
        [else CompilerIrInstrList.Nil])]
    [retargeted : CompilerIrInstrList
      (opt-rotate-ssa-rewrite-instr-seq
        (struct-get plan exit-env)
        (not (opt-label-contains (struct-get plan body) label))
        replace-final?
        guard
        instrs)]
    (cond
      [(= label (struct-get plan body-label))
        (opt-aggregate-instr-list-append (struct-get plan phis) retargeted)]
      [(= label (struct-get plan exit-label))
        (opt-aggregate-instr-list-append (struct-get plan exit-phis) retargeted)]
      [else retargeted])))

;; The deleted header's slot in the block list is reused for the landing
;; block, keeping the layout deterministic; the accepted shape guarantees no
;; block falls through into that position (the preheader and latch end with an
;; explicit jump and any other fallthrough predecessor was rejected).
(define (opt-rotate-ssa-rewrite-blocks
  [plan : OptRotateSsaPlan]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (if (= label (struct-get plan header))
              (compiler-ir-block
                (struct-get plan land-label)
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Jump (struct-get plan body-label))
                  (CompilerIrInstrList.Nil)))
              (if (opt-rotate-ssa-block-touched? plan label)
                (compiler-ir-block
                  label
                  (opt-rotate-ssa-rewrite-instrs plan label instrs))
                block))
            (opt-rotate-ssa-rewrite-blocks plan (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-rotate-ssa-rewrite-blocks plan (compiler-ir-block-seq-to-list seq))]))

(define (opt-rotate-ssa-apply
  [blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [frame : i64]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [body : OptLabelSet]
  [shape : OptRotateSsaShape]) : OptRotateSsaRewrite
  (let
    [body-label : i64 (struct-get shape body-label)]
    [exit-label : i64 (struct-get shape exit-label)]
    [land-label : i64 (opt-rotate-ssa-land-label header)]
    [phis : CompilerIrInstrList (struct-get shape phis)]
    [recs : OptRotateSsaPhiRecs (struct-get shape recs)]
    [guard : CompilerIrInstrList (struct-get shape guard)]
    (if (and
      (not (= exit-label preheader))
      (not (opt-cfg-block-exists? blocks land-label))
      (opt-rotate-ssa-only-label?
        (opt-pred-map-lookup pred-map body-label)
        header)
      (opt-rotate-ssa-only-label?
        (opt-pred-map-lookup pred-map exit-label)
        header)
      (opt-rotate-ssa-body-avoids-exit? pred-map body header exit-label)
      (not (opt-rotate-ssa-block-has-phi? blocks body-label))
      (not (opt-rotate-ssa-block-has-phi? blocks exit-label))
      (opt-rotate-ssa-guard-dsts-local?
        guard
        (opt-rotate-ssa-uses-except-header
          (opt-collect-instrs-uses (opt_i64_i64_map.with-capacity 64) phis)
          blocks
          header)))
      ;; The preheader clone's loop arm targets the landing block instead of
      ;; the body so the rotated loop keeps a dedicated single-successor
      ;; preheader for LICM; the latch clone branches straight to the body.
      (match (opt-rotate-ssa-clone-guard
        (opt-rotate-ssa-edge-env recs true)
        guard
        (struct-get shape cond-value)
        (if (= (struct-get shape true-label) body-label)
          land-label
          (struct-get shape true-label))
        (if (= (struct-get shape false-label) body-label)
          land-label
          (struct-get shape false-label))
        frame)
        [(OptRotateSsaClone.Clone preheader-guard after-preheader)
          (match (opt-rotate-ssa-clone-guard
            (opt-rotate-ssa-edge-env recs false)
            guard
            (struct-get shape cond-value)
            (struct-get shape true-label)
            (struct-get shape false-label)
            after-preheader)
            [(OptRotateSsaClone.Clone latch-guard after-latch)
              (match (opt-rotate-ssa-exit-phis
                recs
                (opt-rotate-ssa-uses-outside-body
                  (opt_i64_i64_map.with-capacity 64)
                  blocks
                  body)
                preheader
                latch
                after-latch)
                [(OptRotateSsaExitPhis.Result exit-phis exit-env next-frame)
                  (OptRotateSsaRewrite.Some
                    (opt-rotate-ssa-rewrite-blocks
                      (OptRotateSsaPlan
                        header
                        preheader
                        latch
                        land-label
                        body-label
                        exit-label
                        body
                        (opt-rotate-ssa-moved-phis recs land-label latch)
                        preheader-guard
                        latch-guard
                        exit-phis
                        exit-env)
                      blocks)
                    next-frame)])])])
      (OptRotateSsaRewrite.No))))

(define (opt-rotate-ssa-loop
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptRotateSsaRewrite
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.No) (OptRotateSsaRewrite.No)]
    [(OptLoopPreheader.Some preheader)
      (let
        [header : i64 (opt-natural-loop-header loop)]
        [latch : i64 (opt-natural-loop-latch loop)]
        [body : OptLabelSet (opt-natural-loop-body loop)]
        [pred-map : OptPredMap (struct-get context pred-map)]
        [header-preds : OptLabelSet (opt-pred-map-lookup pred-map header)]
        (if (and
          (not (= header latch))
          (opt-rotate-ssa-only-label?
            (opt-pred-map-successors pred-map preheader)
            header)
          (opt-loop-rotation-edge-compatible? blocks preheader header)
          (opt-loop-rotation-edge-compatible? blocks latch header)
          (= (opt-label-count header-preds) 2)
          (opt-label-contains header-preds preheader)
          (opt-label-contains header-preds latch))
          (match (opt-rotate-ssa-header-shape
            blocks
            header
            preheader
            latch
            body)
            [(OptRotateSsaMaybeShape.No) (OptRotateSsaRewrite.No)]
            [(OptRotateSsaMaybeShape.Some shape)
              (opt-rotate-ssa-apply
                blocks
                pred-map
                frame
                header
                preheader
                latch
                body
                shape)])
          (OptRotateSsaRewrite.No)))]))

(define (opt-rotate-ssa-loops
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [loops : OptNaturalLoopList]) : OptRotateSsaRewrite
  (match loops
    [(OptNaturalLoopList.Nil) (OptRotateSsaRewrite.No)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-rotate-ssa-loop blocks context frame loop)
        [(OptRotateSsaRewrite.Some next-blocks next-frame)
          (OptRotateSsaRewrite.Some next-blocks next-frame)]
        [(OptRotateSsaRewrite.No)
          (opt-rotate-ssa-loops blocks context frame (box-get rest))])]))

(define (opt-rotate-ssa-function-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (match (opt-verify-gate verified? func context)
        [(ResultCompilerOptimizeVerify.Ok)
          (match (opt-rotate-ssa-loops
            blocks
            context
            frame
            (opt-cfg-natural-loops-with-context blocks context))
            [(OptRotateSsaRewrite.No)
              (OptFunctionCtxResult.Result func context)]
            [(OptRotateSsaRewrite.Some next-blocks next-frame)
              (let
                [next : CompilerIrFunction
                  (CompilerIrFunction.Function
                    name
                    params
                    ret-ty
                    next-frame
                    next-blocks)]
                ;; Rotation rewires the CFG, so build one fresh context for
                ;; the rewritten blocks, reuse it for the post-pass verify,
                ;; and hand it back for the next pass. Any verifier rejection
                ;; falls back to the input function unchanged.
                [next-context : OptCfgContext
                  (opt-cfg-context-build next-blocks)]
                (match (opt-verify-function-with-context next next-context)
                  [(ResultCompilerOptimizeVerify.Ok)
                    (OptFunctionCtxResult.Result next next-context)]
                  [(ResultCompilerOptimizeVerify.Err _)
                    (OptFunctionCtxResult.Result func context)]))])]
        [(ResultCompilerOptimizeVerify.Err _)
          (OptFunctionCtxResult.Result func context)])]))

;; --- conservative loop-invariant code motion --------------------------------
;;
;; LICM is verifier-gated. It moves non-trapping scalar `BinOp`/`UnOp`
;; definitions from natural loops with a single safe preheader. Memory LICM adds
;; a conservative load slice: invariant address GEPs and plain loads may move
;; only when the whole loop has no alias-fact-clearing memory/call/unknown
;; effect. A candidate's value operands must be defined outside the loop or by
;; an earlier instruction already selected for the same hoist. Stores, calls,
;; allocations, bounds checks, phis, vector memory ops, and trapping arithmetic
;; are left in place.
(defenum OptLicmInstrsResult
  (Result CompilerIrInstrList CompilerIrInstrList opt_i64_i64_map.Map bool))

(defenum OptLicmBlocksResult
  (Result CompilerIrBlockList CompilerIrInstrList opt_i64_i64_map.Map bool))

;; Result of applying LICM to a block list: the rewritten blocks plus whether
;; any loop actually hoisted. When nothing changed the caller can skip the
;; rewritten-CFG context rebuild and post-pass verify -- the input context
;; stays valid for the unchanged function.
(defstruct OptLicmStoreSummary
  (call-or-unknown? bool)
  (header-or-unknown-store? bool)
  (element-only-store? bool))

(defenum OptLicmPtrKind
  (Unknown)
  (HeaderSlot i64)
  (DataSlot i64)
  (DataBuffer i64)
  (DataElement i64))

(defenum OptLicmPtrEnv
  (Nil)
  (Cons i64 OptLicmPtrKind (Box OptLicmPtrEnv)))

(defenum OptLicmRoot
  (NoRoot)
  (Fresh i64)
  (Exclusive i64)
  (Shared i64))

(defenum OptMaybeLicmRoot
  (No)
  (Some OptLicmRoot))

(defstruct OptLicmRootEnv
  (map opt_i64_i64_map.Map))

(defenum OptLicmStoreRootList
  (Nil)
  (Cons OptLicmRoot (Box OptLicmStoreRootList)))

(defstruct OptLicmStoreState
  (summary OptLicmStoreSummary)
  ;; `summary` excludes proven-rooted stores so a distinct checked root can use
  ;; the stronger disjointness proof. Preserve the excluded stores separately;
  ;; composing the two summaries once per loop retains the old LICM decision
  ;; for unrooted loads without merging every ordinary effect twice.
  (rooted-summary OptLicmStoreSummary)
  (ptrs OptLicmPtrEnv)
  (roots OptLicmRootEnv)
  (store-roots OptLicmStoreRootList)
  (any-call? bool))

(define (opt-licm-root-env-with-capacity [capacity : i64]) : OptLicmRootEnv
  (OptLicmRootEnv (opt_i64_i64_map.with-capacity capacity)))

(define (opt-licm-root-encode [root : OptLicmRoot]) : i64
  (match root
    [(OptLicmRoot.NoRoot) -1]
    [(OptLicmRoot.Fresh id) (+ (* id 3) 0)]
    [(OptLicmRoot.Exclusive id) (+ (* id 3) 1)]
    [(OptLicmRoot.Shared id) (+ (* id 3) 2)]))

(define (opt-licm-root-decode [value : i64]) : OptLicmRoot
  (if (< value 0)
    (OptLicmRoot.NoRoot)
    (let
      [id : i64 (/ value 3)]
      [tag : i64 (% value 3)]
      (cond
        [(= tag 0) (OptLicmRoot.Fresh id)]
        [(= tag 1) (OptLicmRoot.Exclusive id)]
        [else (OptLicmRoot.Shared id)]))))

(define (opt-licm-root-eq? [a : OptLicmRoot] [b : OptLicmRoot]) : bool
  (= (opt-licm-root-encode a) (opt-licm-root-encode b)))

(define (opt-licm-root-env-remove! [env : OptLicmRootEnv] [var : i64]) : unit
  (begin
    (opt_i64_i64_map.remove-ref! (&mut (struct-get env map)) var)
    unit))

(define (opt-licm-root-env-bind!
  [env : OptLicmRootEnv]
  [var : i64]
  [root : OptLicmRoot]) : unit
  (match root
    [(OptLicmRoot.NoRoot) (opt-licm-root-env-remove! env var)]
    [_
      (opt_i64_i64_map.insert-ref!
        (&mut (struct-get env map))
        var
        (opt-licm-root-encode root))]))

(define (opt-licm-root-env-lookup [env : OptLicmRootEnv] [var : i64]) : OptLicmRoot
  (match (opt_i64_i64_map.get (& (struct-get env map)) var)
    [(opt_i64_i64_map.LookupFound value) (opt-licm-root-decode value)]
    [(opt_i64_i64_map.LookupMissing) (OptLicmRoot.NoRoot)]))

(define (opt-licm-root-of-value
  [env : OptLicmRootEnv]
  [value : CompilerIrValue]) : OptLicmRoot
  (match value
    [(CompilerIrValue.Var var) (opt-licm-root-env-lookup env var)]
    [_ (OptLicmRoot.NoRoot)]))

(define (opt-licm-root-env-copy!
  [env : OptLicmRootEnv]
  [dst : i64]
  [src : CompilerIrValue]) : unit
  (opt-licm-root-env-bind! env dst (opt-licm-root-of-value env src)))

(define (opt-licm-root-disjoint-store?
  [store-root : OptLicmRoot]
  [load-root : OptLicmRoot]) : bool
  (match store-root
    [(OptLicmRoot.Fresh store-id)
      (match load-root
        [(OptLicmRoot.Fresh load-id) (not (= store-id load-id))]
        [(OptLicmRoot.Exclusive load-id) (not (= store-id load-id))]
        [(OptLicmRoot.Shared load-id) (not (= store-id load-id))]
        [(OptLicmRoot.NoRoot) false])]
    [(OptLicmRoot.Exclusive store-id)
      (match load-root
        [(OptLicmRoot.Fresh load-id) (not (= store-id load-id))]
        [(OptLicmRoot.Exclusive load-id) (not (= store-id load-id))]
        [(OptLicmRoot.Shared load-id) (not (= store-id load-id))]
        [(OptLicmRoot.NoRoot) false])]
    [(OptLicmRoot.Shared _) false]
    [(OptLicmRoot.NoRoot) false]))

(define (opt-licm-store-roots-safe?
  [stores : OptLicmStoreRootList]
  [load-root : OptLicmRoot]) : bool
  (match stores
    [(OptLicmStoreRootList.Nil) true]
    [(OptLicmStoreRootList.Cons store-root rest)
      (and
        (opt-licm-root-disjoint-store? store-root load-root)
        (opt-licm-store-roots-safe? (box-get rest) load-root))]))

(define (opt-licm-body-map-capacity [body-blocks : CompilerIrBlockList]) : i64
  (+ 1 (compiler-ir-block-list-instruction-count body-blocks)))

(define (opt-licm-collect-defs-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [set : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index (compiler-ir-instr-seq-count instrs))
    set
    (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs index))
      [(option_i64.Some var)
        (opt-licm-collect-defs-instr-seq-from
          instrs
          (+ index 1)
          (opt-used-add set var))]
      [(option_i64.None)
        (opt-licm-collect-defs-instr-seq-from instrs (+ index 1) set)])))

(define (opt-licm-collect-defs-instr-seq
  [instrs : CompilerIrInstrSeq]
  [set : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (opt-licm-collect-defs-instr-seq-from instrs 0 set))

(define (opt-licm-collect-defs-blocks
  [blocks : CompilerIrBlockList]
  [set : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-licm-collect-defs-blocks
            (box-get rest)
            (opt-licm-collect-defs-instr-seq instrs set))])]
    [(CompilerIrBlockList.Array seq)
      (opt-licm-collect-defs-blocks (compiler-ir-block-seq-to-list seq) set)]))

(define (opt-licm-value-invariant?
  [loop-defs : opt_i64_i64_map.Map]
  [hoisted : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var)
      (or
        (not (opt-used-contains loop-defs var))
        (opt-used-contains hoisted var))]
    ;; A global operand is a hidden load of mutable state (the backend reads it
    ;; rip-relative at the use site), so it is NOT loop-invariant: a store or
    ;; call inside the loop can change it between iterations. Only literals are
    ;; unconditionally invariant.
    [(CompilerIrValue.Global _) false]
    [_ true]))

(define (opt-licm-values-invariant?
  [loop-defs : opt_i64_i64_map.Map]
  [hoisted : opt_i64_i64_map.Map]
  [a : CompilerIrValue]
  [b : CompilerIrValue]) : bool
  (and
    (opt-licm-value-invariant? loop-defs hoisted a)
    (opt-licm-value-invariant? loop-defs hoisted b)))

(define (opt-licm-store-summary-empty) : OptLicmStoreSummary
  (OptLicmStoreSummary false false false))

(define (opt-licm-store-summary-call-or-unknown) : OptLicmStoreSummary
  (OptLicmStoreSummary true false false))

(define (opt-licm-store-summary-header-or-unknown-store) : OptLicmStoreSummary
  (OptLicmStoreSummary false true false))

(define (opt-licm-store-summary-element-only-store) : OptLicmStoreSummary
  (OptLicmStoreSummary false false true))

(define (opt-licm-store-summary-merge
  [left : OptLicmStoreSummary]
  [right : OptLicmStoreSummary]) : OptLicmStoreSummary
  (OptLicmStoreSummary
    (or (struct-get left call-or-unknown?) (struct-get right call-or-unknown?))
    (or
      (struct-get left header-or-unknown-store?)
      (struct-get right header-or-unknown-store?))
    (or
      (struct-get left element-only-store?)
      (struct-get right element-only-store?))))

(define (opt-licm-store-summary-clean? [summary : OptLicmStoreSummary]) : bool
  (and
    (not (struct-get summary call-or-unknown?))
    (not (struct-get summary header-or-unknown-store?))
    (not (struct-get summary element-only-store?))))

(define (opt-licm-store-summary-header-load-safe?
  [summary : OptLicmStoreSummary]) : bool
  (and
    (not (struct-get summary call-or-unknown?))
    (not (struct-get summary header-or-unknown-store?))))

(define (opt-licm-store-summary-from-effect [effect : CompilerIrEffect]) : OptLicmStoreSummary
  (match effect
    [(CompilerIrEffect.MemoryWrite)
      (opt-licm-store-summary-header-or-unknown-store)]
    [(CompilerIrEffect.CpuProbe) (opt-licm-store-summary-call-or-unknown)]
    [(CompilerIrEffect.Unknown) (opt-licm-store-summary-call-or-unknown)]
    [_ (opt-licm-store-summary-empty)]))

(define (opt-licm-store-summary-for-direct-call
  [direct-call-clean : opt_i64_i64_map.Map]
  [name : i64]) : OptLicmStoreSummary
  (if (opt_i64_i64_map.contains?
    (& direct-call-clean)
    (compiler-ir-symbol-id name))
    (opt-licm-store-summary-empty)
    (match (compiler-ir-direct-call-effect-id name)
      [(CompilerIrEffect.MemoryRead) (opt-licm-store-summary-empty)]
      [(CompilerIrEffect.MemoryWrite)
        (opt-licm-store-summary-header-or-unknown-store)]
      [_ (opt-licm-store-summary-call-or-unknown)])))

(define (opt-licm-ptr-unbind [env : OptLicmPtrEnv] [var : i64]) : OptLicmPtrEnv
  (match env
    [(OptLicmPtrEnv.Nil) (OptLicmPtrEnv.Nil)]
    [(OptLicmPtrEnv.Cons id kind rest)
      (let
        [tail : OptLicmPtrEnv (opt-licm-ptr-unbind (box-get rest) var)]
        (if (= id var)
          tail
          (OptLicmPtrEnv.Cons id kind (box tail))))]))

(define (opt-licm-ptr-bind
  [env : OptLicmPtrEnv]
  [var : i64]
  [kind : OptLicmPtrKind]) : OptLicmPtrEnv
  (match kind
    [(OptLicmPtrKind.Unknown) (opt-licm-ptr-unbind env var)]
    [_ (OptLicmPtrEnv.Cons var kind (box (opt-licm-ptr-unbind env var)))]))

(define (opt-licm-ptr-lookup [env : OptLicmPtrEnv] [var : i64]) : OptLicmPtrKind
  (match env
    [(OptLicmPtrEnv.Nil) (OptLicmPtrKind.Unknown)]
    [(OptLicmPtrEnv.Cons id kind rest)
      (if (= id var)
        kind
        (opt-licm-ptr-lookup (box-get rest) var))]))

(define (opt-licm-type-env-bind
  [types : OptSsaVarTypes]
  [var : i64]
  [ty : AstType]) : OptSsaVarTypes
  (OptSsaVarTypes.Cons var ty (box types)))

(define (opt-licm-type-env-add-param
  [types : OptSsaVarTypes]
  [param : CompilerIrParam]) : OptSsaVarTypes
  (match param
    [(CompilerIrParam.Param _ ty var) (opt-licm-type-env-bind types var ty)]))

(define (opt-licm-type-env-add-params
  [params : CompilerIrParamList]
  [types : OptSsaVarTypes]) : OptSsaVarTypes
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) types]
    [(CompilerIrParamList.Array seq)
      (opt-licm-type-env-add-params (compiler-ir-param-seq-to-list seq) types)]
    [(CompilerIrParamList.Cons param rest)
      (opt-licm-type-env-add-params
        (box-get rest)
        (opt-licm-type-env-add-param types param))]))

(define (opt-licm-type-env-add-instr
  [types : OptSsaVarTypes]
  [instr : CompilerIrInstr]) : OptSsaVarTypes
  (match instr
    [(CompilerIrInstr.Mov dst _ ty) (opt-licm-type-env-bind types dst ty)]
    [(CompilerIrInstr.Load dst _ ty) (opt-licm-type-env-bind types dst ty)]
    [(CompilerIrInstr.Call dst _ _ ty) (opt-licm-type-env-bind types dst ty)]
    [(CompilerIrInstr.CallIndirect dst _ _ ty)
      (opt-licm-type-env-bind types dst ty)]
    [(CompilerIrInstr.CallIndirectC dst _ _ ty)
      (opt-licm-type-env-bind types dst ty)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (match result
            [(CompilerIrSpmdCallResult.Unit) types]
            [(CompilerIrSpmdCallResult.Value dst class ty)
              (match class
                [(CompilerIrSpmdValueClass.Uniform)
                  (opt-licm-type-env-bind types dst ty)]
                [_ types])])])]
    [(CompilerIrInstr.Phi dst _ ty) (opt-licm-type-env-bind types dst ty)]
    [_ types]))

(define (opt-licm-type-env-add-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [types : OptSsaVarTypes]) : OptSsaVarTypes
  (if (>= index (compiler-ir-instr-seq-count instrs))
    types
    (opt-licm-type-env-add-instr-seq-from
      instrs
      (+ index 1)
      (opt-licm-type-env-add-instr
        types
        (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-licm-type-env-add-blocks
  [blocks : CompilerIrBlockList]
  [types : OptSsaVarTypes]) : OptSsaVarTypes
  (match blocks
    [(CompilerIrBlockList.Nil) types]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-licm-type-env-add-blocks
            (box-get rest)
            (opt-licm-type-env-add-instr-seq-from instrs 0 types))])]
    [(CompilerIrBlockList.Array seq)
      (opt-licm-type-env-add-blocks (compiler-ir-block-seq-to-list seq) types)]))

(define (opt-licm-type-env-from-function
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptSsaVarTypes
  (opt-licm-type-env-add-blocks
    blocks
    (opt-licm-type-env-add-params params (OptSsaVarTypes.Nil))))

(define (opt-licm-param-root
  [type-segment-bases : i64]
  [ty : AstType]
  [var : i64]) : OptLicmRoot
  (match ty
    [(AstType.Ref _ _) (OptLicmRoot.Shared var)]
    [(AstType.MutRef _ _) (OptLicmRoot.Exclusive var)]
    [(AstType.Region _ inner)
      (opt-licm-param-root
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner)
        var)]
    [_ (OptLicmRoot.NoRoot)]))

(define (opt-licm-root-env-seed-param!
  [type-segment-bases : i64]
  [env : OptLicmRootEnv]
  [param : CompilerIrParam]) : unit
  (match param
    [(CompilerIrParam.Param _ ty var)
      (opt-licm-root-env-bind!
        env
        var
        (opt-licm-param-root type-segment-bases ty var))]))

(define (opt-licm-root-env-seed-params!
  [type-segment-bases : i64]
  [env : OptLicmRootEnv]
  [params : CompilerIrParamList]) : unit
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) unit]
    [(CompilerIrParamList.Array seq)
      (opt-licm-root-env-seed-params!
        type-segment-bases
        env
        (compiler-ir-param-seq-to-list seq))]
    [(CompilerIrParamList.Cons param rest)
      (begin
        (opt-licm-root-env-seed-param! type-segment-bases env param)
        (opt-licm-root-env-seed-params! type-segment-bases env (box-get rest)))]))

(define (opt-licm-phi-root
  [env : OptLicmRootEnv]
  [inputs : CompilerIrPhiInputList]
  [found : OptMaybeLicmRoot]) : OptMaybeLicmRoot
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) found]
    [(CompilerIrPhiInputList.Array seq)
      (opt-licm-phi-root env (compiler-ir-phi-input-seq-to-list seq) found)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (let
        [root : OptLicmRoot (opt-licm-root-of-value env value)]
        (match root
          [(OptLicmRoot.NoRoot) (OptMaybeLicmRoot.No)]
          [_
            (match found
              [(OptMaybeLicmRoot.No)
                (opt-licm-phi-root
                  env
                  (box-get rest)
                  (OptMaybeLicmRoot.Some root))]
              [(OptMaybeLicmRoot.Some previous)
                (if (opt-licm-root-eq? previous root)
                  (opt-licm-phi-root env (box-get rest) found)
                  (OptMaybeLicmRoot.No))])]))]))

(define (opt-licm-root-env-update-instr!
  [env : OptLicmRootEnv]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(CompilerIrInstr.Alloc dst _)
      (opt-licm-root-env-bind! env dst (OptLicmRoot.Fresh dst))]
    [(CompilerIrInstr.Gep dst base _ _) (opt-licm-root-env-copy! env dst base)]
    [(CompilerIrInstr.Mov dst src _) (opt-licm-root-env-copy! env dst src)]
    [(CompilerIrInstr.Cast dst src _ _) (opt-licm-root-env-copy! env dst src)]
    [(CompilerIrInstr.Bitcast dst src _ _)
      (opt-licm-root-env-copy! env dst src)]
    [(CompilerIrInstr.Phi dst inputs _)
      (match (opt-licm-phi-root env inputs (OptMaybeLicmRoot.No))
        [(OptMaybeLicmRoot.No) (opt-licm-root-env-remove! env dst)]
        [(OptMaybeLicmRoot.Some root) (opt-licm-root-env-bind! env dst root)])]
    ;; A descriptor-data Load may be rebound by
    ;; opt-licm-provenance-state-instr immediately after this update.
    [(CompilerIrInstr.Load dst _ _) (opt-licm-root-env-remove! env dst)]
    [(CompilerIrInstr.Call dst name _ _)
      (if (compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)
        (opt-licm-root-env-bind! env dst (OptLicmRoot.Fresh dst))
        unit)]
    [_ unit]))

(define (opt-licm-array-header-type? [type-segment-bases : i64] [ty : AstType]) : bool
  (match ty
    [(AstType.DynArray _) true]
    [(AstType.String) true]
    [(AstType.Str) true]
    [(AstType.Bytes) true]
    [(AstType.Ref _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [(AstType.MutRef _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [(AstType.Region _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [_ false]))

(define (opt-licm-array-header-var?
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [var : i64]) : bool
  (match (opt-ssa-var-type-lookup types var)
    [(OptMaybeAstType.Some ty)
      (opt-licm-array-header-type? type-segment-bases ty)]
    [(OptMaybeAstType.No) false]))

;; #M-E: the data-pointer slot of an array/string descriptor is fat offset 0.
;; A zero literal offset addresses byte 0 regardless of the GEP's scale type,
;; so accept any element type here: the real array lowering emits
;; `Gep arr 0 i64` (lower-array-element-addr-finish) while the string path
;; emits `Gep arr 0 u8` -- the old U8-only match classified array data-slot
;; GEPs as Unknown, which turned element stores into header-or-unknown stores
;; and blocked descriptor-load hoisting.
(define (opt-licm-data-slot? [offset : CompilerIrValue] [_ty : AstType]) : bool
  (match offset
    [(CompilerIrValue.I64 value) (= value 0)]
    [_ false]))

(define (opt-licm-header-slot-gep?
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [ty : AstType]) : bool
  (match base
    [(CompilerIrValue.Var base-var)
      (and
        (opt-licm-array-header-var? type-segment-bases types base-var)
        (or
          (opt-bounds-object-length-slot? type-segment-bases offset ty)
          (opt-licm-data-slot? offset ty)))]
    [_ false]))

(define (opt-licm-header-slot-ptr-kind? [kind : OptLicmPtrKind]) : bool
  (match kind
    [(OptLicmPtrKind.HeaderSlot _) true]
    [(OptLicmPtrKind.DataSlot _) true]
    [_ false]))

(define (opt-licm-header-slot-source?
  [ptrs : OptLicmPtrEnv]
  [src : CompilerIrValue]) : bool
  (match src
    [(CompilerIrValue.Var ptr-var)
      (opt-licm-header-slot-ptr-kind? (opt-licm-ptr-lookup ptrs ptr-var))]
    [_ false]))

(define (opt-licm-gep-kind
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [ptrs : OptLicmPtrEnv]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [ty : AstType]) : OptLicmPtrKind
  (match base
    [(CompilerIrValue.Var base-var)
      (let
        [base-kind : OptLicmPtrKind (opt-licm-ptr-lookup ptrs base-var)]
        (match base-kind
          [(OptLicmPtrKind.DataBuffer object)
            (OptLicmPtrKind.DataElement object)]
          [(OptLicmPtrKind.DataElement object)
            ;; Address adjustment within a loaded data buffer stays in that
            ;; buffer. Lowering commonly emits one Gep for the scaled slot
            ;; address and another for an inline field within the slot.
            (OptLicmPtrKind.DataElement object)]
          [_
            (if (opt-licm-array-header-var? type-segment-bases types base-var)
              (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
                (OptLicmPtrKind.HeaderSlot base-var)
                (if (opt-licm-data-slot? offset ty)
                  (OptLicmPtrKind.DataSlot base-var)
                  (OptLicmPtrKind.Unknown)))
              (OptLicmPtrKind.Unknown))]))]
    [_ (OptLicmPtrKind.Unknown)]))

(define (opt-licm-store-state-with-provenance
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]) : OptLicmStoreState
  (OptLicmStoreState
    (opt-licm-store-summary-empty)
    (opt-licm-store-summary-empty)
    ptrs
    roots
    (OptLicmStoreRootList.Nil)
    false))

(define (opt-licm-store-state-add-summary
  [state : OptLicmStoreState]
  [summary : OptLicmStoreSummary]) : OptLicmStoreState
  (OptLicmStoreState
    (opt-licm-store-summary-merge (struct-get state summary) summary)
    (struct-get state rooted-summary)
    (struct-get state ptrs)
    (struct-get state roots)
    (struct-get state store-roots)
    (struct-get state any-call?)))

(define (opt-licm-store-state-bind-ptr
  [state : OptLicmStoreState]
  [var : i64]
  [kind : OptLicmPtrKind]) : OptLicmStoreState
  (OptLicmStoreState
    (struct-get state summary)
    (struct-get state rooted-summary)
    (opt-licm-ptr-bind (struct-get state ptrs) var kind)
    (struct-get state roots)
    (struct-get state store-roots)
    (struct-get state any-call?)))

(define (opt-licm-store-state-bind-root
  [state : OptLicmStoreState]
  [var : i64]
  [root : OptLicmRoot]) : OptLicmStoreState
  (begin
    (opt-licm-root-env-bind! (struct-get state roots) var root)
    state))

(define (opt-licm-store-state-add-rooted-store
  [state : OptLicmStoreState]
  [root : OptLicmRoot]
  [summary : OptLicmStoreSummary]) : OptLicmStoreState
  (OptLicmStoreState
    (struct-get state summary)
    (opt-licm-store-summary-merge (struct-get state rooted-summary) summary)
    (struct-get state ptrs)
    (struct-get state roots)
    (OptLicmStoreRootList.Cons root (box (struct-get state store-roots)))
    (struct-get state any-call?)))

(define (opt-licm-store-state-mark-call [state : OptLicmStoreState]) : OptLicmStoreState
  (OptLicmStoreState
    (struct-get state summary)
    (struct-get state rooted-summary)
    (struct-get state ptrs)
    (struct-get state roots)
    (struct-get state store-roots)
    true))

(define (opt-licm-store-state-invalidate-ptr-def
  [state : OptLicmStoreState]
  [var : i64]) : OptLicmStoreState
  (OptLicmStoreState
    (struct-get state summary)
    (struct-get state rooted-summary)
    (opt-licm-ptr-unbind (struct-get state ptrs) var)
    (struct-get state roots)
    (struct-get state store-roots)
    (struct-get state any-call?)))

(define (opt-licm-store-state-invalidate-ptr-instr
  [state : OptLicmStoreState]
  [instr : CompilerIrInstr]) : OptLicmStoreState
  (match (opt-instr-def-var instr)
    [(option_i64.Some var) (opt-licm-store-state-invalidate-ptr-def state var)]
    [(option_i64.None) state]))

(define (opt-licm-store-summary-for-storeptr
  [ptrs : OptLicmPtrEnv]
  [ptr : CompilerIrValue]) : OptLicmStoreSummary
  (match ptr
    [(CompilerIrValue.Var ptr-var)
      (match (opt-licm-ptr-lookup ptrs ptr-var)
        [(OptLicmPtrKind.DataBuffer _)
          (opt-licm-store-summary-element-only-store)]
        [(OptLicmPtrKind.DataElement _)
          (opt-licm-store-summary-element-only-store)]
        [_ (opt-licm-store-summary-header-or-unknown-store)])]
    [_ (opt-licm-store-summary-header-or-unknown-store)]))

(define (opt-licm-provenance-state-instr
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [state : OptLicmStoreState]
  [instr : CompilerIrInstr]) : OptLicmStoreState
  (let
    [invalid : OptLicmStoreState
      (opt-licm-store-state-invalidate-ptr-instr state instr)]
    [_roots : unit
      (opt-licm-root-env-update-instr! (struct-get invalid roots) instr)]
    (match instr
      [(CompilerIrInstr.Mov dst src _)
        (match src
          [(CompilerIrValue.Var src-var)
            (opt-licm-store-state-bind-ptr
              invalid
              dst
              (opt-licm-ptr-lookup (struct-get invalid ptrs) src-var))]
          [_ invalid])]
      [(CompilerIrInstr.Gep dst base offset ty)
        (opt-licm-store-state-bind-ptr
          invalid
          dst
          (opt-licm-gep-kind
            type-segment-bases
            types
            (struct-get invalid ptrs)
            base
            offset
            ty))]
      [(CompilerIrInstr.Load dst src _)
        (match src
          [(CompilerIrValue.Var ptr-var)
            (match (opt-licm-ptr-lookup (struct-get invalid ptrs) ptr-var)
              [(OptLicmPtrKind.DataSlot object)
                (opt-licm-store-state-bind-root
                  (opt-licm-store-state-bind-ptr
                    invalid
                    dst
                    (OptLicmPtrKind.DataBuffer object))
                  dst
                  (opt-licm-root-env-lookup (struct-get invalid roots) object))]
              [_ invalid])]
          [_ invalid])]
      [_ invalid])))

(define (opt-licm-store-state-instr
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [state : OptLicmStoreState]
  [direct-call-clean : opt_i64_i64_map.Map]
  [track-provenance? : bool]
  [instr : CompilerIrInstr]) : OptLicmStoreState
  (let
    [provenance : OptLicmStoreState
      (if track-provenance?
        (opt-licm-provenance-state-instr type-segment-bases types state instr)
        state)]
    (match instr
      [(CompilerIrInstr.Call _ name _ _)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-for-direct-call direct-call-clean name))]
      [(CompilerIrInstr.CallIndirect _ _ _ _)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-call-or-unknown))]
      [(CompilerIrInstr.CallIndirectC _ _ _ _)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-call-or-unknown))]
      [(CompilerIrInstr.CallCAbiStoreResult payload-box)
        (match (box-get payload-box)
          [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ _ _ _)
            (opt-licm-store-state-add-summary
              (opt-licm-store-state-mark-call provenance)
              (opt-licm-store-summary-call-or-unknown))])]
      [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
        (match (box-get payload-box)
          [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload _ _ _ _)
            (opt-licm-store-state-add-summary
              (opt-licm-store-state-mark-call provenance)
              (opt-licm-store-summary-call-or-unknown))])]
      [(CompilerIrInstr.SpmdCall payload-box)
        (match (box-get payload-box)
          [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ _)
            (opt-licm-store-state-add-summary
              (opt-licm-store-state-mark-call provenance)
              (opt-licm-store-summary-call-or-unknown))])]
      [(CompilerIrInstr.TailCall name _ _)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-for-direct-call direct-call-clean name))]
      [(CompilerIrInstr.TailCallIndirect _ _ _)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-call-or-unknown))]
      [(CompilerIrInstr.StorePtr ptr _ _)
        (let
          [root : OptLicmRoot
            (opt-licm-root-of-value (struct-get provenance roots) ptr)]
          [legacy-summary : OptLicmStoreSummary
            (opt-licm-store-summary-for-storeptr
              (struct-get provenance ptrs)
              ptr)]
          (match root
            [(OptLicmRoot.Fresh _)
              (opt-licm-store-state-add-rooted-store
                provenance
                root
                legacy-summary)]
            [(OptLicmRoot.Exclusive _)
              (opt-licm-store-state-add-rooted-store
                provenance
                root
                legacy-summary)]
            [_ (opt-licm-store-state-add-summary provenance legacy-summary)]))]
      [(CompilerIrInstr.CopyBytes _ _ _)
        (opt-licm-store-state-add-summary
          provenance
          (opt-licm-store-summary-header-or-unknown-store))]
      [_
        (opt-licm-store-state-add-summary
          provenance
          (opt-licm-store-summary-from-effect (compiler-ir-instr-effect instr)))])))

(define (opt-licm-store-state-instr-seq-from
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [direct-call-clean : opt_i64_i64_map.Map]
  [track-provenance? : bool]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (if (>= index (compiler-ir-instr-seq-count instrs))
    state
    (opt-licm-store-state-instr-seq-from
      type-segment-bases
      types
      instrs
      (+ index 1)
      direct-call-clean
      track-provenance?
      (opt-licm-store-state-instr
        type-segment-bases
        types
        state
        direct-call-clean
        track-provenance?
        (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-licm-store-state-instr-seq
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [instrs : CompilerIrInstrSeq]
  [direct-call-clean : opt_i64_i64_map.Map]
  [track-provenance? : bool]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (opt-licm-store-state-instr-seq-from
    type-segment-bases
    types
    instrs
    0
    direct-call-clean
    track-provenance?
    state))

(define (opt-licm-store-state-blocks
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [direct-call-clean : opt_i64_i64_map.Map]
  [track-provenance? : bool]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (match blocks
    [(CompilerIrBlockList.Nil) state]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-licm-store-state-blocks
            type-segment-bases
            types
            (box-get rest)
            direct-call-clean
            track-provenance?
            (opt-licm-store-state-instr-seq
              type-segment-bases
              types
              instrs
              direct-call-clean
              track-provenance?
              state))])]
    [(CompilerIrBlockList.Array seq)
      (opt-licm-store-state-blocks
        type-segment-bases
        types
        (compiler-ir-block-seq-to-list seq)
        direct-call-clean
        track-provenance?
        state)]))

(define (opt-licm-provenance-state-instr-seq-from
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (if (>= index (compiler-ir-instr-seq-count instrs))
    state
    (opt-licm-provenance-state-instr-seq-from
      type-segment-bases
      types
      instrs
      (+ index 1)
      (opt-licm-provenance-state-instr
        type-segment-bases
        types
        state
        (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-licm-provenance-state-blocks
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (match blocks
    [(CompilerIrBlockList.Nil) state]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-licm-provenance-state-blocks
            type-segment-bases
            types
            (box-get rest)
            (opt-licm-provenance-state-instr-seq-from
              type-segment-bases
              types
              instrs
              0
              state))])]
    [(CompilerIrBlockList.Array seq)
      (opt-licm-provenance-state-blocks
        type-segment-bases
        types
        (compiler-ir-block-seq-to-list seq)
        state)]))

;; Collect canonical checked-reference/fresh-allocation roots for the whole
;; verified SSA function. A second pass resolves same-root Phi joins whose
;; backedge or later-listed predecessor was not known on the first pass; an
;; unresolved/mixed join remains unrooted and therefore conservative.
(define (opt-licm-provenance-state-from-function
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]) : OptLicmStoreState
  (let
    ;; Rooted pointer values are sparse even in functions with large SSA
    ;; frames. Starting this map at the full frame size retained hundreds of
    ;; megabytes across compiler optimization; let the generated hashmap grow
    ;; only when a function actually carries many checked/fresh roots.
    [roots : OptLicmRootEnv (opt-licm-root-env-with-capacity 17)]
    [_params : unit
      (opt-licm-root-env-seed-params! type-segment-bases roots params)]
    [initial : OptLicmStoreState
      (opt-licm-store-state-with-provenance (OptLicmPtrEnv.Nil) roots)]
    [first : OptLicmStoreState
      (opt-licm-provenance-state-blocks type-segment-bases types blocks initial)]
    (opt-licm-provenance-state-blocks type-segment-bases types blocks first)))

(define (opt-licm-store-summary-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [summary : OptLicmStoreSummary]) : OptLicmStoreSummary
  (let
    [state : OptLicmStoreState
      (opt-licm-store-state-blocks
        type-segment-bases
        (OptSsaVarTypes.Nil)
        blocks
        (opt_i64_i64_map.with-capacity 1)
        true
        (OptLicmStoreState
          summary
          (opt-licm-store-summary-empty)
          (OptLicmPtrEnv.Nil)
          (opt-licm-root-env-with-capacity 17)
          (OptLicmStoreRootList.Nil)
          false))]
    (opt-licm-store-summary-merge
      (struct-get state summary)
      (struct-get state rooted-summary))))

(define (opt-licm-memory-safe?
  [root-summary : OptLicmStoreSummary]
  [legacy-summary : OptLicmStoreSummary]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [load-root : OptLicmRoot]
  [legacy-special-safe? : bool]) : bool
  (match load-root
    [(OptLicmRoot.NoRoot)
      (or (opt-licm-store-summary-clean? legacy-summary) legacy-special-safe?)]
    [_
      (and
        (not any-call?)
        (or
          ;; Root identity is a coarse object-level fact. Preserve the older,
          ;; more precise descriptor-header proof when stores touch only data
          ;; elements of that same object.
          legacy-special-safe?
          (and
            (opt-licm-store-summary-clean? root-summary)
            (opt-licm-store-roots-safe? store-roots load-root))))]))

(define (opt-licm-candidate?
  [type-segment-bases : i64]
  [loop-defs : opt_i64_i64_map.Map]
  [hoisted : opt_i64_i64_map.Map]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [store-summary : OptLicmStoreSummary]
  [legacy-store-summary : OptLicmStoreSummary]
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ op lhs rhs _)
      (and
        (not (opt-binop-traps? op))
        (opt-licm-values-invariant? loop-defs hoisted lhs rhs))]
    [(CompilerIrInstr.UnOp _ _ src _)
      (opt-licm-value-invariant? loop-defs hoisted src)]
    [(CompilerIrInstr.Gep dst base offset ty)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-licm-values-invariant? loop-defs hoisted base offset)
        (opt-licm-memory-safe?
          store-summary
          legacy-store-summary
          store-roots
          any-call?
          (opt-licm-root-of-value roots base)
          (and
            (opt-licm-store-summary-header-load-safe? legacy-store-summary)
            (opt-licm-header-slot-gep? type-segment-bases types base offset ty))))]
    [(CompilerIrInstr.Load dst src _)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources src)
        (opt-licm-value-invariant? loop-defs hoisted src)
        (opt-licm-memory-safe?
          store-summary
          legacy-store-summary
          store-roots
          any-call?
          (opt-licm-root-of-value roots src)
          (and
            (opt-licm-store-summary-header-load-safe? legacy-store-summary)
            (opt-licm-header-slot-source? ptrs src))))]
    [_ false]))

(define (opt-licm-add-hoisted-def
  [hoisted : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : opt_i64_i64_map.Map
  (match (opt-instr-def-var instr)
    [(option_i64.Some var) (opt-used-add hoisted var)]
    [(option_i64.None) hoisted]))

(define (opt-licm-filter-instr-seq-from
  [type-segment-bases : i64]
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [store-summary : OptLicmStoreSummary]
  [legacy-store-summary : OptLicmStoreSummary]
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [hoisted : opt_i64_i64_map.Map]) : OptLicmInstrsResult
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptLicmInstrsResult.Result
      (CompilerIrInstrList.Nil)
      (CompilerIrInstrList.Nil)
      hoisted
      false)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (if (opt-licm-candidate?
        type-segment-bases
        loop-defs
        hoisted
        sources
        types
        store-summary
        legacy-store-summary
        ptrs
        roots
        store-roots
        any-call?
        instr)
        (match (opt-licm-filter-instr-seq-from
          type-segment-bases
          loop-defs
          instrs
          (+ index 1)
          sources
          types
          store-summary
          legacy-store-summary
          ptrs
          roots
          store-roots
          any-call?
          (opt-licm-add-hoisted-def hoisted instr))
          [(OptLicmInstrsResult.Result kept moved next-hoisted _)
            (OptLicmInstrsResult.Result
              kept
              (compiler-ir-instr-cons instr moved)
              next-hoisted
              true)])
        (match (opt-licm-filter-instr-seq-from
          type-segment-bases
          loop-defs
          instrs
          (+ index 1)
          sources
          types
          store-summary
          legacy-store-summary
          ptrs
          roots
          store-roots
          any-call?
          hoisted)
          [(OptLicmInstrsResult.Result kept moved next-hoisted changed)
            (OptLicmInstrsResult.Result
              (compiler-ir-instr-cons instr kept)
              moved
              next-hoisted
              changed)])))))

(define (opt-licm-filter-instr-seq
  [type-segment-bases : i64]
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [store-summary : OptLicmStoreSummary]
  [legacy-store-summary : OptLicmStoreSummary]
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [hoisted : opt_i64_i64_map.Map]) : OptLicmInstrsResult
  (opt-licm-filter-instr-seq-from
    type-segment-bases
    loop-defs
    instrs
    0
    sources
    types
    store-summary
    legacy-store-summary
    ptrs
    roots
    store-roots
    any-call?
    hoisted))

(define (opt-licm-filter-body-blocks
  [type-segment-bases : i64]
  [loop-defs : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [store-summary : OptLicmStoreSummary]
  [legacy-store-summary : OptLicmStoreSummary]
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [hoisted : opt_i64_i64_map.Map]) : OptLicmBlocksResult
  (match blocks
    [(CompilerIrBlockList.Nil)
      (OptLicmBlocksResult.Result
        (CompilerIrBlockList.Nil)
        (CompilerIrInstrList.Nil)
        hoisted
        false)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (match (opt-licm-filter-instr-seq
            type-segment-bases
            loop-defs
            instrs
            sources
            types
            store-summary
            legacy-store-summary
            ptrs
            roots
            store-roots
            any-call?
            hoisted)
            [(OptLicmInstrsResult.Result kept moved next-hoisted block-changed)
              (match (opt-licm-filter-body-blocks
                type-segment-bases
                loop-defs
                (box-get rest)
                sources
                types
                store-summary
                legacy-store-summary
                ptrs
                roots
                store-roots
                any-call?
                next-hoisted)
                [(OptLicmBlocksResult.Result
                    rest-blocks
                    rest-moved
                    final-hoisted
                    rest-changed)
                  (OptLicmBlocksResult.Result
                    (compiler-ir-block-cons
                      (compiler-ir-block label kept)
                      rest-blocks)
                    (opt-aggregate-instr-list-append moved rest-moved)
                    final-hoisted
                    (or block-changed rest-changed))])])])]
    [(CompilerIrBlockList.Array seq)
      (opt-licm-filter-body-blocks
        type-segment-bases
        loop-defs
        (compiler-ir-block-seq-to-list seq)
        sources
        types
        store-summary
        legacy-store-summary
        ptrs
        roots
        store-roots
        any-call?
        hoisted)]))

(define (opt-licm-replace-body-blocks
  [blocks : CompilerIrBlockList]
  [body-blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match body-blocks
    [(CompilerIrBlockList.Nil) blocks]
    [(CompilerIrBlockList.Cons replacement replacement-rest)
      (match blocks
        [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
        [(CompilerIrBlockList.Cons block rest)
          (match block
            [(CompilerIrBlock.Block label _)
              (match replacement
                [(CompilerIrBlock.Block replacement-label _)
                  (if (= label replacement-label)
                    (compiler-ir-block-cons
                      replacement
                      (opt-licm-replace-body-blocks
                        (box-get rest)
                        (box-get replacement-rest)))
                    (compiler-ir-block-cons
                      block
                      (opt-licm-replace-body-blocks (box-get rest) body-blocks)))])])]
        [(CompilerIrBlockList.Array seq)
          (opt-licm-replace-body-blocks
            (compiler-ir-block-seq-to-list seq)
            body-blocks)])]
    [(CompilerIrBlockList.Array seq)
      (opt-licm-replace-body-blocks blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-insert-before-terminator
  [hoisted : CompilerIrInstrList]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match hoisted
    [(CompilerIrInstrList.Nil) instrs]
    [_
      (match instrs
        [(CompilerIrInstrList.Nil) hoisted]
        [(CompilerIrInstrList.Cons instr rest)
          (if (opt-cfg-terminator-instr? instr)
            (opt-aggregate-instr-list-append hoisted instrs)
            (compiler-ir-instr-cons
              instr
              (opt-licm-insert-before-terminator hoisted (box-get rest))))])]))

(define (opt-licm-insert-before-terminator-seq-from
  [hoisted : CompilerIrInstrList]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (match hoisted
    [(CompilerIrInstrList.Nil)
      (opt-aggregate-instr-seq-append-from instrs index CompilerIrInstrList.Nil)]
    [_
      (if (>= index (compiler-ir-instr-seq-count instrs))
        hoisted
        (let
          [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
          (if (opt-cfg-terminator-instr? instr)
            (opt-aggregate-instr-list-append
              hoisted
              (opt-aggregate-instr-seq-append-from
                instrs
                index
                CompilerIrInstrList.Nil))
            (compiler-ir-instr-cons
              instr
              (opt-licm-insert-before-terminator-seq-from
                hoisted
                instrs
                (+ index 1))))))]))

(define (opt-licm-insert-before-terminator-seq
  [hoisted : CompilerIrInstrList]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-licm-insert-before-terminator-seq-from hoisted instrs 0))

(define (opt-licm-insert-preheader-blocks
  [preheader : i64]
  [hoisted : CompilerIrInstrList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (if (= label preheader)
              (compiler-ir-block
                label
                (opt-licm-insert-before-terminator-seq hoisted instrs))
              block)
            (opt-licm-insert-preheader-blocks preheader hoisted (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-licm-insert-preheader-blocks
        preheader
        hoisted
        (compiler-ir-block-seq-to-list seq))]))

;; M-G (B1): duplicate-hoist dedup. The filter hoists EVERY invariant load/gep
;; individually, so a loop whose body loads the same descriptor slot at N sites
;; (one gep+load pair per inlined bounds check, kept distinct in-body because
;; element stores conservatively clear the block-local load-CSE table) lands N
;; IDENTICAL gep+load pairs in the preheader -- N live registers carrying one
;; value through the loop (measured: qs_partition hoists the data-slot load 5x
;; and the len-slot load 3x -> 3 spilled vars + per-iteration spill/scavenge
;; traffic in a zero-call loop). Build a substitution env mapping every
;; duplicate's dst to the FIRST hoisted def of the same (operand-substituted)
;; shape, then rewrite all uses in the preheader instructions and the loop
;; body. The duplicate defs are KEPT (their dsts become dead-or-preheader-local,
;; zero loop-carried pressure), so any use the substituter conservatively skips
;; (phi inputs, AddrOf raw vars) still reads a defined var -- partial
;; substitution is always sound. Dsts are single-def (opt-gvn-stable-var? gates
;; candidacy), so a body use can only see the preheader def.
(defenum OptLicmDup
  (OptLicmDupNone)
  (OptLicmDupVar i64))

;; First selected instruction computing the same value as `instr` (whose
;; operands are already substituted through the env-so-far): loads must match
;; on source value + type, geps on base + offset + element type.
(define (opt-licm-dup-of
  [type-segment-bases : i64]
  [selected : CompilerIrInstrList]
  [instr : CompilerIrInstr]) : OptLicmDup
  (match selected
    [(CompilerIrInstrList.Nil) (OptLicmDupNone)]
    [(CompilerIrInstrList.Cons prev rest)
      (match prev
        [(CompilerIrInstr.Load pdst psrc pty)
          (match instr
            [(CompilerIrInstr.Load _ src ty)
              (if (and
                (opt-value-eq psrc src)
                (opt-type-eq type-segment-bases pty ty))
                (OptLicmDupVar pdst)
                (opt-licm-dup-of type-segment-bases (box-get rest) instr))]
            [_ (opt-licm-dup-of type-segment-bases (box-get rest) instr)])]
        [(CompilerIrInstr.Gep pdst pbase poffset pty)
          (match instr
            [(CompilerIrInstr.Gep _ base offset ty)
              (if (and
                (opt-value-eq pbase base)
                (opt-value-eq poffset offset)
                (opt-type-eq type-segment-bases pty ty))
                (OptLicmDupVar pdst)
                (opt-licm-dup-of type-segment-bases (box-get rest) instr))]
            [_ (opt-licm-dup-of type-segment-bases (box-get rest) instr)])]
        [_ (opt-licm-dup-of type-segment-bases (box-get rest) instr)])]))

;; Walk the hoisted list in program order, accumulating dup-dst -> canonical
;; var bindings. Each instruction is operand-substituted through the env built
;; so far BEFORE comparison, so a load through a duplicate gep matches the
;; canonical load (its source resolves to the canonical gep dst).
(define (opt-licm-dedup-env
  [type-segment-bases : i64]
  [moved : CompilerIrInstrList]
  [selected : CompilerIrInstrList]
  [env : OptCopyEnv]) : OptCopyEnv
  (match moved
    [(CompilerIrInstrList.Nil) env]
    [(CompilerIrInstrList.Cons instr rest)
      (let
        [subst : CompilerIrInstr (opt-copy-subst-instr env instr)]
        (match (opt-licm-dup-of type-segment-bases selected subst)
          [(OptLicmDupVar canon)
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (opt-licm-dedup-env
                  type-segment-bases
                  (box-get rest)
                  selected
                  (OptCopyEnv.Cons dst (CompilerIrValue.Var canon) (box env)))]
              [(option_i64.None)
                (opt-licm-dedup-env
                  type-segment-bases
                  (box-get rest)
                  selected
                  env)])]
          [(OptLicmDupNone)
            (opt-licm-dedup-env
              type-segment-bases
              (box-get rest)
              (compiler-ir-instr-cons subst selected)
              env)]))]))

(define (opt-licm-subst-instr-list
  [env : OptCopyEnv]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (compiler-ir-instr-cons
        (opt-copy-subst-instr env instr)
        (opt-licm-subst-instr-list env (box-get rest)))]))

(define (opt-licm-subst-instr-seq-from
  [env : OptCopyEnv]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [acc : CompilerIrInstrList]) : CompilerIrInstrList
  (if (< index 0)
    acc
    (opt-licm-subst-instr-seq-from
      env
      instrs
      (- index 1)
      (compiler-ir-instr-cons
        (opt-copy-subst-instr env (compiler-ir-instr-seq-ref instrs index))
        acc))))

(define (opt-licm-subst-instr-seq
  [env : OptCopyEnv]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-licm-subst-instr-seq-from
    env
    instrs
    (- (compiler-ir-instr-seq-count instrs) 1)
    CompilerIrInstrList.Nil))

(define (opt-licm-subst-body-blocks
  [env : OptCopyEnv]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (compiler-ir-block label (opt-licm-subst-instr-seq env instrs))
            (opt-licm-subst-body-blocks env (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-licm-subst-body-blocks env (compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-switch-case-outside?
  [body : OptLabelSet]
  [cases : CompilerIrSwitchCaseList]) : bool
  (match cases
    [(CompilerIrSwitchCaseList.Nil) false]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case _ label)
          (if (not (opt-label-contains body label))
            true
            (opt-licm-switch-case-outside? body (box-get rest)))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-licm-switch-case-outside?
        body
        (compiler-ir-switch-case-seq-to-list seq))]))

;; Pure register staging that a return path may perform without counting as
;; "more work": scalar copies/arithmetic and the group packing a multi-word
;; return needs. A direct call whose effect is an aborting ControlFlow
;; runtime (tl_oob_abort and friends) is also allowed -- that exit terminates
;; the process. Loads, stores, geps, bounds checks, and real calls make the
;; exit a break into further work instead.
(define (opt-licm-return-staging-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ _ _) true]
    [(CompilerIrInstr.Phi _ _ _) true]
    [(CompilerIrInstr.Pack _ _ _) true]
    [(CompilerIrInstr.Word _ _ _ _) true]
    [(CompilerIrInstr.Cast _ _ _ _) true]
    [(CompilerIrInstr.Bitcast _ _ _ _) true]
    [(CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(CompilerIrInstr.UnOp _ _ _ _) true]
    ;; A found/insert exit does bounded memory work (compute the entry address,
    ;; read/write the slot) before returning. That still makes the loop a
    ;; short-trip SEARCH -- it returns as soon as the slot is located -- so
    ;; hoisting a loop-invariant load into it does not pay and (under high
    ;; register pressure) strands the hoisted value's live range across the
    ;; probe loop. Allow the memory ops on the way OUT; a path that instead
    ;; loops back into more iterations never reaches a Return within the walk
    ;; fuel, so it still classifies as break-into-work.
    [(CompilerIrInstr.Gep _ _ _ _) true]
    [(CompilerIrInstr.Load _ _ _) true]
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [(CompilerIrInstr.BoundsCheck _ _ _) true]
    [(CompilerIrInstr.Store _ _ _) true]
    [(CompilerIrInstr.Call _ name _ _)
      (compiler-ir-runtime-control-flow-id? name)]
    [(CompilerIrInstr.Jump _) true]
    ;; a Branch is only ever a terminator; the walk itself validates both
    ;; of its arms.
    [(CompilerIrInstr.Branch _ _ _) true]
    [(CompilerIrInstr.Return _) true]
    [_ false]))

(define (opt-licm-return-staging-block?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-licm-return-staging-instr? (compiler-ir-instr-seq-ref instrs index))
      (opt-licm-return-staging-block? instrs (+ index 1)))))

;; A RETURN-SHAPED exit target reaches a Return through at most `fuel`
;; staging-only blocks (chained by unconditional Jumps).
(define (opt-licm-return-shaped-target?
  [blocks : CompilerIrBlockList]
  [label : i64]
  [fuel : i64]) : bool
  (if (<= fuel 0)
    false
    (match (opt-cfg-find-block blocks label)
      [(OptMaybeBlock.No) false]
      [(OptMaybeBlock.Some block)
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (let
              [count : i64 (compiler-ir-instr-seq-count instrs)]
              (if (= count 0)
                false
                (if (not (opt-licm-return-staging-block? instrs 0))
                  false
                  (match (compiler-ir-instr-seq-ref instrs (- count 1))
                    [(CompilerIrInstr.Return _) true]
                    [(CompilerIrInstr.Jump target)
                      (opt-licm-return-shaped-target? blocks target (- fuel 1))]
                    ;; a staging-only diamond on the way out (the probe's
                    ;; first-tombstone select) stays return-shaped when both
                    ;; arms are.
                    [(CompilerIrInstr.Branch _ then-label else-label)
                      (and
                        (opt-licm-return-shaped-target?
                          blocks
                          then-label
                          (- fuel 1))
                        (opt-licm-return-shaped-target?
                          blocks
                          else-label
                          (- fuel 1)))]
                    [_ false]))))])])))

(define (opt-licm-branch-exit-return-shaped?
  [blocks : CompilerIrBlockList]
  [body : OptLabelSet]
  [target : i64]) : bool
  (if (opt-label-contains body target)
    true
    (opt-licm-return-shaped-target? blocks target 8)))

;; Tri-state side-exit classification: 0 = no side exits, 1 = every side exit
;; is return-shaped, 2 = at least one side exit breaks into further work.
(define (opt-licm-instr-side-exit-kind
  [blocks : CompilerIrBlockList]
  [body : OptLabelSet]
  [instr : CompilerIrInstr]) : i64
  (match instr
    [(CompilerIrInstr.Jump target)
      (if (opt-label-contains body target)
        0
        (if (opt-licm-return-shaped-target? blocks target 8)
          1
          2))]
    [(CompilerIrInstr.Branch _ then-label else-label)
      (if (and
        (opt-label-contains body then-label)
        (opt-label-contains body else-label))
        0
        (if (and
          (opt-licm-branch-exit-return-shaped? blocks body then-label)
          (opt-licm-branch-exit-return-shaped? blocks body else-label))
          1
          2))]
    [(CompilerIrInstr.Switch _ _ cases default-label)
      (if (or
        (not (opt-label-contains body default-label))
        (opt-licm-switch-case-outside? body cases))
        (if (and
          (opt-licm-branch-exit-return-shaped? blocks body default-label)
          (opt-licm-switch-cases-return-shaped? blocks body cases))
          1
          2)
        0)]
    [_ 0]))

(define (opt-licm-switch-cases-return-shaped?
  [blocks : CompilerIrBlockList]
  [body : OptLabelSet]
  [cases : CompilerIrSwitchCaseList]) : bool
  (match cases
    [(CompilerIrSwitchCaseList.Nil) true]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case _ label)
          (and
            (opt-licm-branch-exit-return-shaped? blocks body label)
            (opt-licm-switch-cases-return-shaped? blocks body (box-get rest)))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-licm-switch-cases-return-shaped?
        blocks
        body
        (compiler-ir-switch-case-seq-to-list seq))]))

;; Suppression kind for the whole loop: max over the non-header body blocks'
;; terminator classifications.
(define (opt-licm-loop-side-exit-kind
  [blocks : CompilerIrBlockList]
  [header : i64]
  [latch : i64]
  [body : OptLabelSet]
  [body-blocks : CompilerIrBlockList]) : i64
  (match body-blocks
    [(CompilerIrBlockList.Nil) 0]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [here : i64
          (match block
            [(CompilerIrBlock.Block label instrs)
              ;; the header's AND the latch's loop-exit branches are the
              ;; normal counted exits (a rotated loop tests at its latch);
              ;; only OTHER blocks' exits mark the early-return probe shape.
              (if (or
                (= label header)
                (= label latch)
                (= (compiler-ir-instr-seq-count instrs) 0))
                0
                (opt-licm-instr-side-exit-kind
                  blocks
                  body
                  (compiler-ir-instr-seq-ref
                    instrs
                    (- (compiler-ir-instr-seq-count instrs) 1))))])]
        (if (= here 2)
          2
          (let
            [rest-kind : i64
              (opt-licm-loop-side-exit-kind
                blocks
                header
                latch
                body
                (box-get rest))]
            (if (> rest-kind here)
              rest-kind
              here))))]
    [(CompilerIrBlockList.Array seq)
      (opt-licm-loop-side-exit-kind
        blocks
        header
        latch
        body
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-apply-loop
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [provenance : OptLicmStoreState]
  [direct-call-clean : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]) : OptBlockListPassResult
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.Some preheader)
      (let
        [body-blocks : CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        [map-capacity : i64 (opt-licm-body-map-capacity body-blocks)]
        [loop-defs : opt_i64_i64_map.Map
          (opt-licm-collect-defs-blocks
            body-blocks
            (opt_i64_i64_map.with-capacity map-capacity))]
        [store-state : OptLicmStoreState
          (opt-licm-store-state-blocks
            type-segment-bases
            types
            body-blocks
            direct-call-clean
            false
            (opt-licm-store-state-with-provenance
              (struct-get provenance ptrs)
              (struct-get provenance roots)))]
        [raw-summary : OptLicmStoreSummary (struct-get store-state summary)]
        [raw-rooted-summary : OptLicmStoreSummary
          (struct-get store-state rooted-summary)]
        [raw-legacy-summary : OptLicmStoreSummary
          (opt-licm-store-summary-merge raw-summary raw-rooted-summary)]
        [side-exit-kind : i64
          (opt-licm-loop-side-exit-kind
            blocks
            (opt-natural-loop-header loop)
            (opt-natural-loop-latch loop)
            (opt-natural-loop-body loop)
            body-blocks)]
        ;; Measured (cachegrind, three rounds): hoisting invariant loads out
        ;; of PROBE-SHAPED loops -- every side exit an early RETURN, trips
        ;; averaging one or two iterations -- is pure register pressure: the
        ;; extra live-across-loop values push other values into spill staging
        ;; on the return paths (hashmap_get +1.2%, hashmap_insert +0.6%,
        ;; self_compile +0.74%). Suppressing ALL side-exit loops overshot the
        ;; other way: break-into-work side exits mark long-trip kernels
        ;; (spmd_zip +50%, opt_quicksort +1.0% under the broad gate). So the
        ;; load/gep hoist is suppressed exactly when every side exit is
        ;; return-shaped (reaches Return through staging-only blocks; an
        ;; aborting runtime call also qualifies), by folding a header-store
        ;; poison into the summary. Pure BinOp/UnOp hoisting is unaffected.
        [store-summary : OptLicmStoreSummary
          (if (= side-exit-kind 1)
            (opt-licm-store-summary-merge
              raw-summary
              (opt-licm-store-summary-header-or-unknown-store))
            raw-summary)]
        [legacy-store-summary : OptLicmStoreSummary
          (if (= side-exit-kind 1)
            (opt-licm-store-summary-merge
              raw-legacy-summary
              (opt-licm-store-summary-header-or-unknown-store))
            raw-legacy-summary)]
        [ptrs : OptLicmPtrEnv (struct-get store-state ptrs)]
        [roots : OptLicmRootEnv (struct-get store-state roots)]
        [store-roots : OptLicmStoreRootList
          (struct-get store-state store-roots)]
        [any-call? : bool (struct-get store-state any-call?)]
        (match (opt-licm-filter-body-blocks
          type-segment-bases
          loop-defs
          body-blocks
          sources
          types
          store-summary
          legacy-store-summary
          ptrs
          roots
          store-roots
          any-call?
          (opt_i64_i64_map.with-capacity map-capacity))
          [(OptLicmBlocksResult.Result filtered-body hoisted _ changed)
            (if changed
              ;; M-G (B1): fold duplicate hoisted loads/geps onto their first
              ;; occurrence (see opt-licm-dedup-env). An empty env means no
              ;; duplicates -- skip the rewrite, byte-identical to pre-B1.
              (let
                [dedup-env : OptCopyEnv
                  (opt-licm-dedup-env
                    type-segment-bases
                    hoisted
                    (CompilerIrInstrList.Nil)
                    (OptCopyEnv.Nil))]
                (match dedup-env
                  [(OptCopyEnv.Nil)
                    (OptBlockListPassResult.Result
                      (opt-licm-insert-preheader-blocks
                        preheader
                        hoisted
                        (opt-licm-replace-body-blocks blocks filtered-body))
                      true)]
                  [_
                    (OptBlockListPassResult.Result
                      (opt-licm-insert-preheader-blocks
                        preheader
                        (opt-licm-subst-instr-list dedup-env hoisted)
                        (opt-licm-replace-body-blocks
                          blocks
                          (opt-licm-subst-body-blocks dedup-env filtered-body)))
                      true)]))
              (OptBlockListPassResult.Result blocks false))]))]
    [(OptLoopPreheader.No) (OptBlockListPassResult.Result blocks false)]))

(define (opt-licm-apply-loops
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [provenance : OptLicmStoreState]
  [direct-call-clean : opt_i64_i64_map.Map]
  [loops : OptNaturalLoopList]
  [blocks : CompilerIrBlockList]) : OptBlockListPassResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-licm-apply-loop
        type-segment-bases
        sources
        types
        provenance
        direct-call-clean
        blocks
        loop)
        [(OptBlockListPassResult.Result loop-blocks loop-changed)
          (match (opt-licm-apply-loops
            type-segment-bases
            sources
            types
            provenance
            direct-call-clean
            (box-get rest)
            loop-blocks)
            [(OptBlockListPassResult.Result rest-blocks rest-changed)
              (OptBlockListPassResult.Result
                rest-blocks
                (or loop-changed rest-changed))])])]))

(define (opt-licm-blocks-with-context-and-direct-call-clean
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [provenance : OptLicmStoreState]
  [direct-call-clean : opt_i64_i64_map.Map]
  [loops : OptNaturalLoopList]
  [blocks : CompilerIrBlockList]) : OptBlockListPassResult
  (opt-licm-apply-loops
    type-segment-bases
    sources
    types
    provenance
    direct-call-clean
    loops
    blocks))

(define (opt-licm-function-with-context-result-and-direct-call-clean
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [direct-call-clean : opt_i64_i64_map.Map]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(CompilerIrFunction.Function name params ret-ty frame blocks)
          (let
            [sources : opt_i64_i64_map.Map
              (opt-gvn-sources-blocks
                blocks
                (opt-gvn-sources-params
                  params
                  (opt_i64_i64_map.with-capacity 64)))]
            [types : OptSsaVarTypes
              (opt-licm-type-env-from-function params blocks)]
            [loops : OptNaturalLoopList
              (opt-cfg-natural-loops-with-context blocks context)]
            (match loops
              [(OptNaturalLoopList.Nil)
                (OptFunctionCtxResult.Result func context)]
              [_
                (let
                  [provenance : OptLicmStoreState
                    (opt-licm-provenance-state-from-function
                      type-segment-bases
                      params
                      types
                      blocks)]
                  (match (opt-licm-blocks-with-context-and-direct-call-clean
                    type-segment-bases
                    sources
                    types
                    provenance
                    direct-call-clean
                    loops
                    blocks)
                    [(OptBlockListPassResult.Result
                        hoisted-blocks
                        licm-changed?)
                      (if (not licm-changed?)
                        ;; Nothing hoisted: the input context still describes the
                        ;; unchanged CFG, so skip the context rebuild and the
                        ;; post-pass verify entirely.
                        (OptFunctionCtxResult.Result func context)
                        (let
                          [hoisted : CompilerIrFunction
                            (CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              frame
                              hoisted-blocks)]
                          ;; LICM may hoist into a synthesized preheader edge, so build
                          ;; one fresh context for the rewritten CFG, reuse it for the
                          ;; post-pass verify, and hand it back for the next pass.
                          [hoisted-context : OptCfgContext
                            (opt-cfg-context-build hoisted-blocks)]
                          (match (opt-verify-function-with-context
                            hoisted
                            hoisted-context)
                            [(ResultCompilerOptimizeVerify.Ok)
                              (OptFunctionCtxResult.Result
                                hoisted
                                hoisted-context)]
                            [(ResultCompilerOptimizeVerify.Err _)
                              (OptFunctionCtxResult.Result func context)])))]))]))])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-licm-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  (opt-licm-function-with-context-result-and-direct-call-clean
    type-segment-bases
    context
    false
    (opt_i64_i64_map.with-capacity 1)
    func))

(define (opt-licm-function-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-licm-function-with-context-result type-segment-bases context func)
    [(OptFunctionCtxResult.Result next _) next]))

(define (opt-licm-function-with-direct-call-clean
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [direct-call-clean : opt_i64_i64_map.Map]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-licm-function-with-context-result-and-direct-call-clean
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        direct-call-clean
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

(define (opt-licm-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-licm-function-with-context
        type-segment-bases
        (opt-cfg-context-build blocks)
        func)]))

;; --- simple induction-derived cleanup --------------------------------------
;;
;; This first induction slice recognizes canonical `i64` loop-carried phis:
;; `i = phi(preheader_seed, latch_next)` where `latch_next` is `i +/- const`,
;; chasing the copy chains SSA renaming leaves between the add and the phi.
;; It then strength-reduces repeated derived offset/address families per loop by
;; adding matching derived phis: plain `mul i, k` products, and `gep` addresses
;; whose per-iteration byte stride does NOT fold into the x86 addressing mode
;; (a folded address is free at each use, so an address IV there only adds a
;; latch add and a loop-live range). Ordinary stores do not invalidate the
;; affine SSA recurrence; allocation, vector/predicated memory, syscall,
;; target-probe, copy-bytes, calls, and tail-call shapes stay fail-closed (a
;; derived phi is loop-live, so across a call it would spill more than the
;; per-iteration mul/gep it replaces). Bounds checks are left in place. The
;; function verifier gates the final rewritten function.
(defenum OptInductionPhiInputs
  (No)
  (Some CompilerIrValue i64))

(defenum OptInductionFact
  (Fact i64 CompilerIrValue i64 i64 AstType))

(defenum OptMaybeInductionFact
  (No)
  (Some OptInductionFact))

(defenum OptInductionDerived
  (Mul i64 i64 AstType)
  (Gep CompilerIrValue i64 AstType)
  ;; A `gep base, (mul phi, scale)` address (the offset var's def is a plain
  ;; scaled recurrence, not an affine phi+const): base, scale, element type.
  ;; The derived phi is the ADDRESS itself, stepping step*scale elements per
  ;; iteration, which folds the fetch into the load's addressing mode.
  (GepScaled CompilerIrValue i64 AstType))

(defenum OptInductionDerivedList
  (Nil)
  (Cons OptInductionDerived (Box OptInductionDerivedList)))

(defenum OptMaybeInductionDerived
  (No)
  (Some OptInductionDerived))

(defenum OptInductionApplyResult
  (Result CompilerIrBlockList i64 bool))

(define (opt-induction-fact-start [fact : OptInductionFact]) : CompilerIrValue
  (match fact
    [(OptInductionFact.Fact _ start _ _ _) start]))

(define (opt-induction-fact-step [fact : OptInductionFact]) : i64
  (match fact
    [(OptInductionFact.Fact _ _ _ step _) step]))

(define (opt-induction-i64-type? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [_ false]))

(define (opt-induction-nonzero-step [step : i64]) : option_i64.Option
  (if (= step 0)
    (option_i64.None)
    (option_i64.Some step)))

(define (opt-induction-phi-input-pair
  [a-value : CompilerIrValue]
  [a-label : i64]
  [b-value : CompilerIrValue]
  [b-label : i64]
  [preheader : i64]
  [latch : i64]) : OptInductionPhiInputs
  (if (and (= a-label preheader) (= b-label latch))
    (match b-value
      [(CompilerIrValue.Var back) (OptInductionPhiInputs.Some a-value back)]
      [_ (OptInductionPhiInputs.No)])
    (if (and (= b-label preheader) (= a-label latch))
      (match a-value
        [(CompilerIrValue.Var back) (OptInductionPhiInputs.Some b-value back)]
        [_ (OptInductionPhiInputs.No)])
      (OptInductionPhiInputs.No))))

(define (opt-induction-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [preheader : i64]
  [latch : i64]) : OptInductionPhiInputs
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Cons a-value a-label rest)
      (match (box-get rest)
        [(CompilerIrPhiInputList.Cons b-value b-label rest2)
          (match (box-get rest2)
            [(CompilerIrPhiInputList.Nil)
              (opt-induction-phi-input-pair
                a-value
                a-label
                b-value
                b-label
                preheader
                latch)]
            [_ (OptInductionPhiInputs.No)])]
        [_ (OptInductionPhiInputs.No)])]
    [_ (OptInductionPhiInputs.No)]))

(define (opt-induction-step-from-add
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(CompilerIrValue.I64 step) (opt-induction-nonzero-step step)]
          [_ (option_i64.None)])
        (option_i64.None))]
    [(CompilerIrValue.I64 step)
      (match rhs
        [(CompilerIrValue.Var var)
          (if (= var phi-var)
            (opt-induction-nonzero-step step)
            (option_i64.None))]
        [_ (option_i64.None)])]
    [_ (option_i64.None)]))

(define (opt-induction-step-from-sub
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(CompilerIrValue.I64 step) (opt-induction-nonzero-step (- 0 step))]
          [_ (option_i64.None)])
        (option_i64.None))]
    [_ (option_i64.None)]))

(define (opt-induction-step-from-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match op
    [(CompilerIrBinOp.Add) (opt-induction-step-from-add lhs rhs phi-var)]
    [(CompilerIrBinOp.Sub) (opt-induction-step-from-sub lhs rhs phi-var)]
    [_ (option_i64.None)]))

(define (opt-induction-update-step-instr
  [type-segment-bases : i64]
  [instr : CompilerIrInstr]
  [phi-var : i64]
  [next-var : i64]
  [ty : AstType]) : option_i64.Option
  (match instr
    [(CompilerIrInstr.BinOp dst op lhs rhs instr-ty)
      (if (and
        (= dst next-var)
        (opt-type-eq type-segment-bases instr-ty ty)
        (opt-induction-i64-type? ty))
        (opt-induction-step-from-binop op lhs rhs phi-var)
        (option_i64.None))]
    [_ (option_i64.None)]))

(define (opt-induction-find-update-instr-seq-from
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [phi-var : i64]
  [next-var : i64]
  [ty : AstType]) : option_i64.Option
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (option_i64.None)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (= dst next-var)
            (opt-induction-update-step-instr
              type-segment-bases
              instr
              phi-var
              next-var
              ty)
            (opt-induction-find-update-instr-seq-from
              type-segment-bases
              instrs
              (+ index 1)
              phi-var
              next-var
              ty))]
        [(option_i64.None)
          (opt-induction-find-update-instr-seq-from
            type-segment-bases
            instrs
            (+ index 1)
            phi-var
            next-var
            ty)]))))

(define (opt-induction-find-update-instr-seq
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [phi-var : i64]
  [next-var : i64]
  [ty : AstType]) : option_i64.Option
  (opt-induction-find-update-instr-seq-from
    type-segment-bases
    instrs
    0
    phi-var
    next-var
    ty))

(define (opt-induction-find-update-blocks
  [type-segment-bases : i64]
  [body-blocks : CompilerIrBlockList]
  [phi-var : i64]
  [next-var : i64]
  [ty : AstType]) : option_i64.Option
  (match body-blocks
    [(CompilerIrBlockList.Nil) (option_i64.None)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (opt-induction-find-update-instr-seq
            type-segment-bases
            instrs
            phi-var
            next-var
            ty)
            [(option_i64.Some step) (option_i64.Some step)]
            [(option_i64.None)
              (opt-induction-find-update-blocks
                type-segment-bases
                (box-get rest)
                phi-var
                next-var
                ty)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-find-update-blocks
        type-segment-bases
        (compiler-ir-block-seq-to-list seq)
        phi-var
        next-var
        ty)]))

;; Find the var a Mov copies from -- the SSA renaming hop between the latch's
;; recurrence value and the arithmetic that computes it.
(define (opt-induction-mov-source-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : option_i64.Option
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (option_i64.None)
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Mov dst src _)
        (if (= dst var)
          (match src
            [(CompilerIrValue.Var src-var) (option_i64.Some src-var)]
            [_ (option_i64.None)])
          (opt-induction-mov-source-instr-seq-from instrs (+ index 1) var))]
      [_ (opt-induction-mov-source-instr-seq-from instrs (+ index 1) var)])))

(define (opt-induction-mov-source-instr-seq
  [instrs : CompilerIrInstrSeq]
  [var : i64]) : option_i64.Option
  (opt-induction-mov-source-instr-seq-from instrs 0 var))

(define (opt-induction-mov-source-blocks
  [body-blocks : CompilerIrBlockList]
  [var : i64]) : option_i64.Option
  (match body-blocks
    [(CompilerIrBlockList.Nil) (option_i64.None)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (opt-induction-mov-source-instr-seq instrs var)
            [(option_i64.Some src) (option_i64.Some src)]
            [(option_i64.None)
              (opt-induction-mov-source-blocks (box-get rest) var)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-mov-source-blocks (compiler-ir-block-seq-to-list seq) var)]))

;; Chase up to 4 copy hops (the cap guards against mov cycles in non-SSA
;; fallbacks): `next = mov t; t = add i, k` resolves to the add's var.
(define (opt-induction-mov-chain-var
  [body-blocks : CompilerIrBlockList]
  [var : i64]
  [depth : i64]) : option_i64.Option
  (if (>= depth 4)
    (option_i64.None)
    (match (opt-induction-mov-source-blocks body-blocks var)
      [(option_i64.Some src)
        (match (opt-induction-mov-chain-var body-blocks src (+ depth 1))
          [(option_i64.Some resolved) (option_i64.Some resolved)]
          [(option_i64.None) (option_i64.Some src)])]
      [(option_i64.None) (option_i64.None)])))

(define (opt-induction-fact-from-phi
  [type-segment-bases : i64]
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [instr : CompilerIrInstr]) : OptMaybeInductionFact
  (match instr
    [(CompilerIrInstr.Phi phi-var inputs ty)
      (if (opt-induction-i64-type? ty)
        (match (opt-induction-phi-inputs
          inputs
          preheader
          (opt-natural-loop-latch loop))
          [(OptInductionPhiInputs.Some start next-var)
            (match (opt-induction-find-update-blocks
              type-segment-bases
              body-blocks
              phi-var
              next-var
              ty)
              [(option_i64.Some step)
                (OptMaybeInductionFact.Some
                  (OptInductionFact.Fact phi-var start next-var step ty))]
              [(option_i64.None)
                ;; SSA renaming often routes the latch recurrence through a
                ;; copy chain; chase it to the arithmetic before giving up.
                (match (opt-induction-mov-chain-var body-blocks next-var 0)
                  [(option_i64.Some resolved)
                    (match (opt-induction-find-update-blocks
                      type-segment-bases
                      body-blocks
                      phi-var
                      resolved
                      ty)
                      [(option_i64.Some step)
                        (OptMaybeInductionFact.Some
                          (OptInductionFact.Fact phi-var start next-var step ty))]
                      [(option_i64.None) (OptMaybeInductionFact.No)])]
                  [(option_i64.None) (OptMaybeInductionFact.No)])])]
          [(OptInductionPhiInputs.No) (OptMaybeInductionFact.No)])
        (OptMaybeInductionFact.No))]
    [_ (OptMaybeInductionFact.No)]))

(define (opt-induction-find-fact-instr-seq-from
  [type-segment-bases : i64]
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptMaybeInductionFact
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptMaybeInductionFact.No)
    (match (opt-induction-fact-from-phi
      type-segment-bases
      body-blocks
      loop
      preheader
      (compiler-ir-instr-seq-ref instrs index))
      [(OptMaybeInductionFact.Some fact) (OptMaybeInductionFact.Some fact)]
      [(OptMaybeInductionFact.No)
        (opt-induction-find-fact-instr-seq-from
          type-segment-bases
          body-blocks
          loop
          preheader
          instrs
          (+ index 1))])))

(define (opt-induction-find-fact-instr-seq
  [type-segment-bases : i64]
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [instrs : CompilerIrInstrSeq]) : OptMaybeInductionFact
  (opt-induction-find-fact-instr-seq-from
    type-segment-bases
    body-blocks
    loop
    preheader
    instrs
    0))

(define (opt-induction-find-fact
  [type-segment-bases : i64]
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]) : OptMaybeInductionFact
  (match (opt-cfg-find-block body-blocks (opt-natural-loop-header loop))
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-induction-find-fact-instr-seq
            type-segment-bases
            body-blocks
            loop
            preheader
            instrs)])]
    [(OptMaybeBlock.No) (OptMaybeInductionFact.No)]))

(define (opt-induction-blocker-instr-seq-at?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (match (& (array-ref (struct-get instrs slots) index))
    [(CompilerIrInstr.Alloc _ _) true]
    [(CompilerIrInstr.CopyBytes _ _ _) true]
    [(CompilerIrInstr.VectorStore _) true]
    [(CompilerIrInstr.PredicatedStore _) true]
    [(CompilerIrInstr.CpuId _ _ _ _) true]
    [(CompilerIrInstr.Xgetbv _ _) true]
    [(CompilerIrInstr.Syscall _ _) true]
    [(CompilerIrInstr.SpmdCall _) true]
    [(CompilerIrInstr.TailCall _ _ _) true]
    [(CompilerIrInstr.TailCallIndirect _ _ _) true]
    ;; A derived phi is loop-live: across a call it must ride in a
    ;; callee-saved register or spill slot, and that traffic costs more than
    ;; the per-iteration mul/gep the IV replaces. Loops with calls keep their
    ;; plain recurrences.
    [(CompilerIrInstr.Call _ _ _ _) true]
    [(CompilerIrInstr.CallIndirect _ _ _ _) true]
    [_ false]))

(define (opt-induction-blocker-instr-seq-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-induction-blocker-instr-seq-at? instrs index)
      (opt-induction-blocker-instr-seq-from? instrs (+ index 1)))))

(define (opt-induction-blocker-instr-seq? [instrs : CompilerIrInstrSeq]) : bool
  (opt-induction-blocker-instr-seq-from? instrs 0))

(define (opt-induction-loop-blocked? [body-blocks : CompilerIrBlockList]) : bool
  (match body-blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-induction-blocker-instr-seq? instrs)
            true
            (opt-induction-loop-blocked? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-loop-blocked? (compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-small-const? [value : i64]) : bool
  (and (>= value (- 0 1000000)) (<= value 1000000)))

(define (opt-induction-scale-ok? [step : i64] [scale : i64]) : bool
  (and
    (not (= scale 0))
    (not (= scale 1))
    (opt-induction-small-const? step)
    (opt-induction-small-const? scale)))

(define (opt-induction-offset-ok? [offset : i64]) : bool
  (opt-induction-small-const? offset))

(define (opt-induction-affine-offset-from-add
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(CompilerIrValue.I64 offset)
            (if (opt-induction-offset-ok? offset)
              (option_i64.Some offset)
              (option_i64.None))]
          [_ (option_i64.None)])
        (option_i64.None))]
    [(CompilerIrValue.I64 offset)
      (match rhs
        [(CompilerIrValue.Var var)
          (if (and (= var phi-var) (opt-induction-offset-ok? offset))
            (option_i64.Some offset)
            (option_i64.None))]
        [_ (option_i64.None)])]
    [_ (option_i64.None)]))

(define (opt-induction-affine-offset-from-sub
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(CompilerIrValue.I64 offset)
            (if (opt-induction-offset-ok? offset)
              (let
                [negated : i64 (- 0 offset)]
                (if (opt-induction-offset-ok? negated)
                  (option_i64.Some negated)
                  (option_i64.None)))
              (option_i64.None))]
          [_ (option_i64.None)])
        (option_i64.None))]
    [_ (option_i64.None)]))

(define (opt-induction-affine-offset-from-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match op
    [(CompilerIrBinOp.Add)
      (opt-induction-affine-offset-from-add lhs rhs phi-var)]
    [(CompilerIrBinOp.Sub)
      (opt-induction-affine-offset-from-sub lhs rhs phi-var)]
    [_ (option_i64.None)]))

(define (opt-induction-affine-offset-env-instr
  [env : opt_i64_i64_map.Map]
  [phi-var : i64]
  [instr : CompilerIrInstr]) : opt_i64_i64_map.Map
  (match instr
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (opt-induction-i64-type? ty)
        (match (opt-induction-affine-offset-from-binop op lhs rhs phi-var)
          [(option_i64.Some offset)
            (let
              [out : opt_i64_i64_map.Map env]
              (begin
                (opt_i64_i64_map.insert-ref! (&mut out) dst offset)
                out))]
          [(option_i64.None) env])
        env)]
    [_ env]))

(define (opt-induction-affine-offset-env-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [phi-var : i64]
  [env : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index (compiler-ir-instr-seq-count instrs))
    env
    (opt-induction-affine-offset-env-instr-seq-from
      instrs
      (+ index 1)
      phi-var
      (opt-induction-affine-offset-env-instr
        env
        phi-var
        (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-induction-affine-offset-env-instr-seq
  [instrs : CompilerIrInstrSeq]
  [phi-var : i64]
  [env : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (opt-induction-affine-offset-env-instr-seq-from instrs 0 phi-var env))

(define (opt-induction-affine-offset-env-blocks
  [body-blocks : CompilerIrBlockList]
  [phi-var : i64]
  [env : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match body-blocks
    [(CompilerIrBlockList.Nil) env]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-induction-affine-offset-env-blocks
            (box-get rest)
            phi-var
            (opt-induction-affine-offset-env-instr-seq instrs phi-var env))])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-affine-offset-env-blocks
        (compiler-ir-block-seq-to-list seq)
        phi-var
        env)]))

(define (opt-induction-affine-offset-env
  [body-blocks : CompilerIrBlockList]
  [fact : OptInductionFact]) : opt_i64_i64_map.Map
  (match fact
    [(OptInductionFact.Fact phi-var _ _ _ _)
      (opt-induction-affine-offset-env-blocks
        body-blocks
        phi-var
        (opt_i64_i64_map.with-capacity (opt-licm-body-map-capacity body-blocks)))]))

(define (opt-induction-value-offset
  [offsets : opt_i64_i64_map.Map]
  [value : CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match value
    [(CompilerIrValue.Var var)
      (if (= var phi-var)
        (option_i64.Some 0)
        (match (opt_i64_i64_map.get (& offsets) var)
          [(opt_i64_i64_map.LookupFound offset) (option_i64.Some offset)]
          [(opt_i64_i64_map.LookupMissing) (option_i64.None)]))]
    [_ (option_i64.None)]))

(define (opt-induction-mul-derived
  [offsets : opt_i64_i64_map.Map]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]
  [step : i64]
  [ty : AstType]) : OptMaybeInductionDerived
  (match (opt-induction-value-offset offsets lhs phi-var)
    [(option_i64.Some offset)
      (match rhs
        [(CompilerIrValue.I64 scale)
          (if (opt-induction-scale-ok? step scale)
            (OptMaybeInductionDerived.Some
              (OptInductionDerived.Mul scale offset ty))
            (OptMaybeInductionDerived.No))]
        [_ (OptMaybeInductionDerived.No)])]
    [(option_i64.None)
      (match lhs
        [(CompilerIrValue.I64 scale)
          (match (opt-induction-value-offset offsets rhs phi-var)
            [(option_i64.Some offset)
              (if (opt-induction-scale-ok? step scale)
                (OptMaybeInductionDerived.Some
                  (OptInductionDerived.Mul scale offset ty))
                (OptMaybeInductionDerived.No))]
            [(option_i64.None) (OptMaybeInductionDerived.No)])]
        [_ (OptMaybeInductionDerived.No)])]))

;; Induction runs without a hoisted set, so GEP-base loop-invariance is
;; `opt-licm-value-invariant?` with an empty `hoisted` map: a var is invariant
;; iff it is not defined inside the loop body. Evaluating it directly avoids
;; allocating an empty sentinel map per GEP candidate.
(define (opt-induction-value-base-invariant?
  [loop-defs : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var) (not (opt-used-contains loop-defs var))]
    [_ true]))

;; The scale of a `mul phi, scale-lit` (either operand order), if it is one.
(define (opt-induction-mul-scale-of
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(CompilerIrValue.I64 scale) (option_i64.Some scale)]
          [_ (option_i64.None)])
        (option_i64.None))]
    [(CompilerIrValue.I64 scale)
      (match rhs
        [(CompilerIrValue.Var var)
          (if (= var phi-var)
            (option_i64.Some scale)
            (option_i64.None))]
        [_ (option_i64.None)])]
    [_ (option_i64.None)]))

;; Vars used as a gep's var offset (invariant base only, mirroring the
;; derived-collection rule).
(define (opt-induction-gep-offset-vars-instr-seq-from
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [vars : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index (compiler-ir-instr-seq-count instrs))
    vars
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Gep _ base offset _)
        (match offset
          [(CompilerIrValue.Var offset-var)
            (if (opt-induction-value-base-invariant? loop-defs base)
              (opt-induction-gep-offset-vars-instr-seq-from
                loop-defs
                instrs
                (+ index 1)
                (opt-used-add vars offset-var))
              (opt-induction-gep-offset-vars-instr-seq-from
                loop-defs
                instrs
                (+ index 1)
                vars))]
          [_
            (opt-induction-gep-offset-vars-instr-seq-from
              loop-defs
              instrs
              (+ index 1)
              vars)])]
      [_
        (opt-induction-gep-offset-vars-instr-seq-from
          loop-defs
          instrs
          (+ index 1)
          vars)])))

(define (opt-induction-gep-offset-vars-blocks-from
  [loop-defs : opt_i64_i64_map.Map]
  [body-blocks : CompilerIrBlockList]
  [vars : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match body-blocks
    [(CompilerIrBlockList.Nil) vars]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-induction-gep-offset-vars-blocks-from
            loop-defs
            (box-get rest)
            (opt-induction-gep-offset-vars-instr-seq-from
              loop-defs
              instrs
              0
              vars))])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-gep-offset-vars-blocks-from
        loop-defs
        (compiler-ir-block-seq-to-list seq)
        vars)]))

(define (opt-induction-gep-offset-vars-blocks
  [loop-defs : opt_i64_i64_map.Map]
  [body-blocks : CompilerIrBlockList]) : opt_i64_i64_map.Map
  (opt-induction-gep-offset-vars-blocks-from
    loop-defs
    body-blocks
    (opt_i64_i64_map.with-capacity 17)))

;; The scaled-offset env: vars defined as `mul phi, scale` that actually feed
;; a gep offset. Such muls are covered by the GepScaled derived (the address
;; itself becomes the induction value), so the plain Mul derived skips them.
(define (opt-induction-scaled-env-instr-seq-from
  [phi-var : i64]
  [step : i64]
  [feeders : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [env : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index (compiler-ir-instr-seq-count instrs))
    env
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.BinOp dst op lhs rhs ty)
        (match op
          [(CompilerIrBinOp.Mul)
            (if (and
              (opt-induction-i64-type? ty)
              (opt-used-contains feeders dst))
              (match (opt-induction-mul-scale-of lhs rhs phi-var)
                [(option_i64.Some scale)
                  (if (opt-induction-scale-ok? step scale)
                    (let
                      [out : opt_i64_i64_map.Map env]
                      (begin
                        (opt_i64_i64_map.insert-ref! (&mut out) dst scale)
                        (opt-induction-scaled-env-instr-seq-from
                          phi-var
                          step
                          feeders
                          instrs
                          (+ index 1)
                          out)))
                    (opt-induction-scaled-env-instr-seq-from
                      phi-var
                      step
                      feeders
                      instrs
                      (+ index 1)
                      env))]
                [(option_i64.None)
                  (opt-induction-scaled-env-instr-seq-from
                    phi-var
                    step
                    feeders
                    instrs
                    (+ index 1)
                    env)])
              (opt-induction-scaled-env-instr-seq-from
                phi-var
                step
                feeders
                instrs
                (+ index 1)
                env))]
          [_
            (opt-induction-scaled-env-instr-seq-from
              phi-var
              step
              feeders
              instrs
              (+ index 1)
              env)])]
      [_
        (opt-induction-scaled-env-instr-seq-from
          phi-var
          step
          feeders
          instrs
          (+ index 1)
          env)])))

(define (opt-induction-scaled-env-list-from
  [phi-var : i64]
  [step : i64]
  [feeders : opt_i64_i64_map.Map]
  [body-blocks : CompilerIrBlockList]
  [env : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match body-blocks
    [(CompilerIrBlockList.Nil) env]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-induction-scaled-env-list-from
            phi-var
            step
            feeders
            (box-get rest)
            (opt-induction-scaled-env-instr-seq-from
              phi-var
              step
              feeders
              instrs
              0
              env))])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-scaled-env-list-from
        phi-var
        step
        feeders
        (compiler-ir-block-seq-to-list seq)
        env)]))

(define (opt-induction-scaled-env-blocks
  [fact : OptInductionFact]
  [loop-defs : opt_i64_i64_map.Map]
  [body-blocks : CompilerIrBlockList]) : opt_i64_i64_map.Map
  (match fact
    [(OptInductionFact.Fact phi-var _ _ step _)
      (let
        [feeders : opt_i64_i64_map.Map
          (opt-induction-gep-offset-vars-blocks loop-defs body-blocks)]
        (match body-blocks
          [(CompilerIrBlockList.Nil) (opt_i64_i64_map.with-capacity 17)]
          [(CompilerIrBlockList.Cons _ _)
            (opt-induction-scaled-env-list-from
              phi-var
              step
              feeders
              body-blocks
              (opt_i64_i64_map.with-capacity 17))]
          [(CompilerIrBlockList.Array seq)
            (opt-induction-scaled-env-list-from
              phi-var
              step
              feeders
              (compiler-ir-block-seq-to-list seq)
              (opt_i64_i64_map.with-capacity 17))]))]))

;; A stride the x86 addressing mode folds (1/2/4/8) makes the address free at
;; each use; a pointer IV there only adds a latch add and a loop-live range.
;; Fire the address deriveds only when the per-iteration byte stride does not
;; fold (16-byte enum elements, 24-byte entries, ...).
(define (opt-induction-gep-stride-pays?
  [type-segment-bases : i64]
  [scale : i64]
  [ty : AstType]) : bool
  (let
    [stride : i64 (* scale (opt-load-loc-type-size type-segment-bases ty))]
    (and (> stride 2) (not (= stride 4)) (not (= stride 8)))))

(define (opt-induction-find-derived-instr
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [loop-defs : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : OptMaybeInductionDerived
  (match fact
    [(OptInductionFact.Fact phi-var _ _ step _)
      (match instr
        [(CompilerIrInstr.BinOp dst op lhs rhs ty)
          (match op
            [(CompilerIrBinOp.Mul)
              (if (and
                (opt-induction-i64-type? ty)
                (not (opt-used-contains scaled dst)))
                (opt-induction-mul-derived offsets lhs rhs phi-var step ty)
                (OptMaybeInductionDerived.No))]
            [_ (OptMaybeInductionDerived.No)])]
        [(CompilerIrInstr.Gep _ base offset ty)
          (match (opt-induction-value-offset offsets offset phi-var)
            [(option_i64.Some derived-offset)
              (if (and
                (opt-induction-gep-stride-pays? type-segment-bases 1 ty)
                (opt-induction-value-base-invariant? loop-defs base))
                (OptMaybeInductionDerived.Some
                  (OptInductionDerived.Gep base derived-offset ty))
                (OptMaybeInductionDerived.No))]
            [(option_i64.None)
              (match offset
                [(CompilerIrValue.Var offset-var)
                  (match (opt_i64_i64_map.get (& scaled) offset-var)
                    [(opt_i64_i64_map.LookupFound scale)
                      (if (and
                        (opt-induction-gep-stride-pays?
                          type-segment-bases
                          scale
                          ty)
                        (opt-induction-value-base-invariant? loop-defs base))
                        (OptMaybeInductionDerived.Some
                          (OptInductionDerived.GepScaled base scale ty))
                        (OptMaybeInductionDerived.No))]
                    [(opt_i64_i64_map.LookupMissing)
                      (OptMaybeInductionDerived.No)])]
                [_ (OptMaybeInductionDerived.No)])])]
        [_ (OptMaybeInductionDerived.No)])]))

(define (opt-induction-derived-eq?
  [type-segment-bases : i64]
  [left : OptInductionDerived]
  [right : OptInductionDerived]) : bool
  (match left
    [(OptInductionDerived.Mul left-scale left-offset left-ty)
      (match right
        [(OptInductionDerived.Mul right-scale right-offset right-ty)
          (and
            (= left-scale right-scale)
            (= left-offset right-offset)
            (opt-type-eq type-segment-bases left-ty right-ty))]
        [_ false])]
    [(OptInductionDerived.Gep left-base left-offset left-ty)
      (match right
        [(OptInductionDerived.Gep right-base right-offset right-ty)
          (and
            (opt-value-eq left-base right-base)
            (= left-offset right-offset)
            (opt-type-eq type-segment-bases left-ty right-ty))]
        [_ false])]
    [(OptInductionDerived.GepScaled left-base left-scale left-ty)
      (match right
        [(OptInductionDerived.GepScaled right-base right-scale right-ty)
          (and
            (opt-value-eq left-base right-base)
            (= left-scale right-scale)
            (opt-type-eq type-segment-bases left-ty right-ty))]
        [_ false])]))

(define (opt-induction-derived-list-contains?
  [type-segment-bases : i64]
  [deriveds : OptInductionDerivedList]
  [derived : OptInductionDerived]) : bool
  (match deriveds
    [(OptInductionDerivedList.Nil) false]
    [(OptInductionDerivedList.Cons head rest)
      (if (opt-induction-derived-eq? type-segment-bases head derived)
        true
        (opt-induction-derived-list-contains?
          type-segment-bases
          (box-get rest)
          derived))]))

(define (opt-induction-derived-list-append
  [deriveds : OptInductionDerivedList]
  [derived : OptInductionDerived]) : OptInductionDerivedList
  (match deriveds
    [(OptInductionDerivedList.Nil)
      (OptInductionDerivedList.Cons derived (box (OptInductionDerivedList.Nil)))]
    [(OptInductionDerivedList.Cons head rest)
      (OptInductionDerivedList.Cons
        head
        (box (opt-induction-derived-list-append (box-get rest) derived)))]))

(define (opt-induction-derived-list-append-unique
  [type-segment-bases : i64]
  [deriveds : OptInductionDerivedList]
  [derived : OptInductionDerived]) : OptInductionDerivedList
  (if (opt-induction-derived-list-contains? type-segment-bases deriveds derived)
    deriveds
    (opt-induction-derived-list-append deriveds derived)))

(define (opt-induction-derived-list-count [deriveds : OptInductionDerivedList]) : i64
  (match deriveds
    [(OptInductionDerivedList.Nil) 0]
    [(OptInductionDerivedList.Cons _ rest)
      (+ 1 (opt-induction-derived-list-count (box-get rest)))]))

(define (opt-induction-derived-list-slot-count
  [deriveds : OptInductionDerivedList]) : i64
  (match deriveds
    [(OptInductionDerivedList.Nil) 0]
    [(OptInductionDerivedList.Cons derived rest)
      (+
        (opt-induction-derived-slot-count derived)
        (opt-induction-derived-list-slot-count (box-get rest)))]))

(define (opt-induction-collect-derived-instr-seq-from
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [deriveds : OptInductionDerivedList]) : OptInductionDerivedList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    deriveds
    (match (opt-induction-find-derived-instr
      type-segment-bases
      fact
      offsets
      scaled
      loop-defs
      (compiler-ir-instr-seq-ref instrs index))
      [(OptMaybeInductionDerived.Some derived)
        (opt-induction-collect-derived-instr-seq-from
          type-segment-bases
          fact
          offsets
          scaled
          loop-defs
          instrs
          (+ index 1)
          (opt-induction-derived-list-append-unique
            type-segment-bases
            deriveds
            derived))]
      [(OptMaybeInductionDerived.No)
        (opt-induction-collect-derived-instr-seq-from
          type-segment-bases
          fact
          offsets
          scaled
          loop-defs
          instrs
          (+ index 1)
          deriveds)])))

(define (opt-induction-collect-derived-instr-seq
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [deriveds : OptInductionDerivedList]) : OptInductionDerivedList
  (opt-induction-collect-derived-instr-seq-from
    type-segment-bases
    fact
    offsets
    scaled
    loop-defs
    instrs
    0
    deriveds))

(define (opt-induction-remat-address-dst
  [instr : CompilerIrInstr]
  [mul-dst : i64]) : option_i64.Option
  (match instr
    [(CompilerIrInstr.BinOp dst (CompilerIrBinOp.Add) lhs rhs _)
      (if (or (opt-value-is-var? lhs mul-dst) (opt-value-is-var? rhs mul-dst))
        (option_i64.Some dst)
        (option_i64.None))]
    [(CompilerIrInstr.Gep dst _ offset _)
      (if (opt-value-is-var? offset mul-dst)
        (option_i64.Some dst)
        (option_i64.None))]
    [_ (option_i64.None)]))

(define (opt-induction-remat-arm-seq?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= (+ index 3) (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.BinOp mul-dst (CompilerIrBinOp.Mul) _ _ _)
        (match (opt-induction-remat-address-dst
          (compiler-ir-instr-seq-ref instrs (+ index 1))
          mul-dst)
          [(option_i64.Some address-dst)
            (match (compiler-ir-instr-seq-ref instrs (+ index 2))
              [(CompilerIrInstr.Gep gep-dst base _ _)
                (and
                  (opt-value-is-var? base address-dst)
                  (match (compiler-ir-instr-seq-ref instrs (+ index 3))
                    [(CompilerIrInstr.Load _ src _)
                      (opt-value-is-var? src gep-dst)]
                    [_ false]))]
              [_ false])]
          [(option_i64.None) false])]
      [_ (opt-induction-remat-arm-seq? instrs (+ index 1))])))

(define (opt-induction-switch-predecessor?
  [blocks : CompilerIrBlockList]
  [target : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (if (and
              (> count 0)
              (match (compiler-ir-instr-seq-ref instrs (- count 1))
                [(CompilerIrInstr.Switch _ _ _ _) true]
                [_ false])
              (opt-label-contains
                (opt-cfg-instr-successors
                  (OptLabelSet.Nil)
                  (compiler-ir-instr-seq-ref instrs (- count 1)))
                target))
              true
              (opt-induction-switch-predecessor? (box-get rest) target)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-switch-predecessor?
        (compiler-ir-block-seq-to-list seq)
        target)]))

(define (opt-induction-switch-arm?
  [_index : OptCfgIndex]
  [blocks : CompilerIrBlockList]
  [label : i64]
  [arm-instrs : CompilerIrInstrSeq]) : bool
  (and
    (opt-induction-remat-arm-seq? arm-instrs 0)
    (opt-induction-switch-predecessor? blocks label)))

(define (opt-induction-collect-derived-blocks
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [loop-defs : opt_i64_i64_map.Map]
  [all-body-blocks : CompilerIrBlockList]
  [body-blocks : CompilerIrBlockList]
  [deriveds : OptInductionDerivedList]) : OptInductionDerivedList
  (match body-blocks
    [(CompilerIrBlockList.Nil) deriveds]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (opt-induction-collect-derived-blocks
            type-segment-bases
            index
            fact
            offsets
            scaled
            loop-defs
            all-body-blocks
            (box-get rest)
            (if (opt-induction-switch-arm? index all-body-blocks label instrs)
              deriveds
              (opt-induction-collect-derived-instr-seq
                type-segment-bases
                fact
                offsets
                scaled
                loop-defs
                instrs
                deriveds)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-collect-derived-blocks
        type-segment-bases
        index
        fact
        offsets
        scaled
        loop-defs
        all-body-blocks
        (compiler-ir-block-seq-to-list seq)
        deriveds)]))

(define (opt-induction-derived-matches?
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [derived : OptInductionDerived]
  [instr : CompilerIrInstr]) : bool
  (match fact
    [(OptInductionFact.Fact phi-var _ _ step _)
      (match derived
        [(OptInductionDerived.Mul scale offset ty)
          (match instr
            [(CompilerIrInstr.BinOp _ op lhs rhs instr-ty)
              (match op
                [(CompilerIrBinOp.Mul)
                  (and
                    (opt-type-eq type-segment-bases instr-ty ty)
                    (match (opt-induction-mul-derived
                      offsets
                      lhs
                      rhs
                      phi-var
                      step
                      ty)
                      [(OptMaybeInductionDerived.Some found)
                        (opt-induction-derived-eq?
                          type-segment-bases
                          found
                          derived)]
                      [(OptMaybeInductionDerived.No) false]))]
                [_ false])]
            [_ false])]
        [(OptInductionDerived.Gep base derived-offset ty)
          (match instr
            [(CompilerIrInstr.Gep _ instr-base instr-offset instr-ty)
              (and
                (opt-type-eq type-segment-bases instr-ty ty)
                (opt-value-eq instr-base base)
                (match (opt-induction-value-offset offsets instr-offset phi-var)
                  [(option_i64.Some found-offset)
                    (= found-offset derived-offset)]
                  [(option_i64.None) false]))]
            [_ false])]
        [(OptInductionDerived.GepScaled base scale ty)
          (match instr
            [(CompilerIrInstr.Gep _ instr-base instr-offset instr-ty)
              (and
                (opt-type-eq type-segment-bases instr-ty ty)
                (opt-value-eq instr-base base)
                (match instr-offset
                  [(CompilerIrValue.Var offset-var)
                    (match (opt_i64_i64_map.get (& scaled) offset-var)
                      [(opt_i64_i64_map.LookupFound found-scale)
                        (= found-scale scale)]
                      [(opt_i64_i64_map.LookupMissing) false])]
                  [_ false]))]
            [_ false])])]))

;; The rewrite mov must carry the PHI's type: for address deriveds that is
;; the word type, never the element type -- a `mov %ptr : u8` lets the
;; backend truncate the 64-bit pointer (spill/reload sizing), which used to
;; crash byte-buffer loops as soon as the mov-chase let the pass fire there.
(define (opt-induction-rewrite-instr
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (if (opt-induction-derived-matches?
    type-segment-bases
    fact
    offsets
    scaled
    derived
    instr)
    (match (opt-instr-def-var instr)
      [(option_i64.Some dst)
        (CompilerIrInstr.Mov
          dst
          (CompilerIrValue.Var derived-phi)
          (opt-induction-derived-phi-type derived))]
      [(option_i64.None) instr])
    instr))

(define (opt-induction-rewrite-instr-seq-from
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    CompilerIrInstrList.Nil
    (compiler-ir-instr-cons
      (opt-induction-rewrite-instr
        type-segment-bases
        fact
        offsets
        scaled
        derived
        derived-phi
        (compiler-ir-instr-seq-ref instrs index))
      (opt-induction-rewrite-instr-seq-from
        type-segment-bases
        fact
        offsets
        scaled
        derived
        derived-phi
        instrs
        (+ index 1)))))

(define (opt-induction-rewrite-instr-seq
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-induction-rewrite-instr-seq-from
    type-segment-bases
    fact
    offsets
    scaled
    derived
    derived-phi
    instrs
    0))

(define (opt-induction-rewrite-blocks
  [type-segment-bases : i64]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [all-blocks : CompilerIrBlockList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (if (and
              (opt-loop-body-label-member? body index label)
              (not (opt-induction-switch-arm? index all-blocks label instrs)))
              (compiler-ir-block
                label
                (opt-induction-rewrite-instr-seq
                  type-segment-bases
                  fact
                  offsets
                  scaled
                  derived
                  derived-phi
                  instrs))
              block)
            (opt-induction-rewrite-blocks
              type-segment-bases
              body
              index
              fact
              offsets
              scaled
              derived
              derived-phi
              all-blocks
              (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-rewrite-blocks
        type-segment-bases
        body
        index
        fact
        offsets
        scaled
        derived
        derived-phi
        all-blocks
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-rewrite-derived-list-blocks
  [type-segment-bases : i64]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [deriveds : OptInductionDerivedList]
  [frame : i64]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match deriveds
    [(OptInductionDerivedList.Nil) blocks]
    [(OptInductionDerivedList.Cons derived rest)
      (opt-induction-rewrite-derived-list-blocks
        type-segment-bases
        body
        index
        fact
        offsets
        scaled
        (box-get rest)
        (+ frame (opt-induction-derived-slot-count derived))
        (opt-induction-rewrite-blocks
          type-segment-bases
          body
          index
          fact
          offsets
          scaled
          derived
          (opt-induction-derived-phi-var derived frame)
          blocks
          blocks))]))

;; GepScaled has no affine offset; it reports a nonzero value so it takes the
;; 4-slot layout (mul tmp, seed, phi, next) its two-instruction seed needs.
(define (opt-induction-derived-offset [derived : OptInductionDerived]) : i64
  (match derived
    [(OptInductionDerived.Mul _ offset _) offset]
    [(OptInductionDerived.Gep _ offset _) offset]
    [(OptInductionDerived.GepScaled _ _ _) 1]))

(define (opt-induction-derived-slot-count [derived : OptInductionDerived]) : i64
  (if (= (opt-induction-derived-offset derived) 0)
    3
    4))

(define (opt-induction-derived-seed-var
  [derived : OptInductionDerived]
  [frame : i64]) : i64
  (if (= (opt-induction-derived-offset derived) 0)
    frame
    (+ frame 1)))

(define (opt-induction-derived-phi-var
  [derived : OptInductionDerived]
  [frame : i64]) : i64
  (if (= (opt-induction-derived-offset derived) 0)
    (+ frame 1)
    (+ frame 2)))

(define (opt-induction-derived-next-var
  [derived : OptInductionDerived]
  [frame : i64]) : i64
  (if (= (opt-induction-derived-offset derived) 0)
    (+ frame 2)
    (+ frame 3)))

(define (opt-induction-offset-seed-instr
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [offset-var : i64]) : CompilerIrInstr
  (match fact
    [(OptInductionFact.Fact _ start _ _ ty)
      (match derived
        [(OptInductionDerived.GepScaled _ scale _)
          ;; The scaled seed's element offset is start*scale, not start+offset.
          (CompilerIrInstr.BinOp
            offset-var
            (CompilerIrBinOp.Mul)
            start
            (CompilerIrValue.I64 scale)
            ty)]
        [_
          (CompilerIrInstr.BinOp
            offset-var
            (CompilerIrBinOp.Add)
            start
            (CompilerIrValue.I64 (opt-induction-derived-offset derived))
            ty)])]))

(define (opt-induction-final-seed-instr
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [seed-var : i64]) : CompilerIrInstr
  (match derived
    [(OptInductionDerived.Mul scale offset ty)
      (CompilerIrInstr.BinOp
        seed-var
        (CompilerIrBinOp.Mul)
        (if (= offset 0)
          (opt-induction-fact-start fact)
          (CompilerIrValue.Var (- seed-var 1)))
        (CompilerIrValue.I64 scale)
        ty)]
    [(OptInductionDerived.Gep base offset ty)
      (CompilerIrInstr.Gep
        seed-var
        base
        (if (= offset 0)
          (opt-induction-fact-start fact)
          (CompilerIrValue.Var (- seed-var 1)))
        ty)]
    [(OptInductionDerived.GepScaled base _ ty)
      (CompilerIrInstr.Gep
        seed-var
        base
        (CompilerIrValue.Var (- seed-var 1))
        ty)]))

(define (opt-induction-seed-instrs-for-derived
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [frame : i64]) : CompilerIrInstrList
  (let
    [seed-var : i64 (opt-induction-derived-seed-var derived frame)]
    (if (= (opt-induction-derived-offset derived) 0)
      (compiler-ir-instr-cons
        (opt-induction-final-seed-instr fact derived seed-var)
        CompilerIrInstrList.Nil)
      (compiler-ir-instr-cons
        (opt-induction-offset-seed-instr fact derived frame)
        (compiler-ir-instr-cons
          (opt-induction-final-seed-instr fact derived seed-var)
          CompilerIrInstrList.Nil)))))

(define (opt-induction-next-instr
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [next-var : i64]) : CompilerIrInstr
  (match derived
    [(OptInductionDerived.Mul scale _ ty)
      (CompilerIrInstr.BinOp
        next-var
        (CompilerIrBinOp.Add)
        (CompilerIrValue.Var derived-phi)
        (CompilerIrValue.I64 (* (opt-induction-fact-step fact) scale))
        ty)]
    [(OptInductionDerived.Gep _ _ ty)
      (CompilerIrInstr.Gep
        next-var
        (CompilerIrValue.Var derived-phi)
        (CompilerIrValue.I64 (opt-induction-fact-step fact))
        ty)]
    [(OptInductionDerived.GepScaled _ scale ty)
      (CompilerIrInstr.Gep
        next-var
        (CompilerIrValue.Var derived-phi)
        (CompilerIrValue.I64 (* (opt-induction-fact-step fact) scale))
        ty)]))

;; A Gep-derived induction value is an ADDRESS: its phi must be word-typed.
;; The backend sizes spilled phi copies by the PHI's type, so an
;; element-typed pointer phi over a sub-word array (a byte buffer's moving
;; pointer) would reload only the low element-width bits of the pointer on
;; the back edge. Mul-derived values keep their (i64-gated) scalar type.
(define (opt-induction-derived-phi-type [derived : OptInductionDerived]) : AstType
  (match derived
    [(OptInductionDerived.Mul _ _ ty) ty]
    [(OptInductionDerived.Gep _ _ _) (AstType.I64)]
    [(OptInductionDerived.GepScaled _ _ _) (AstType.I64)]))

(define (opt-induction-phi-instr
  [derived : OptInductionDerived]
  [preheader : i64]
  [latch : i64]
  [seed-var : i64]
  [derived-phi : i64]
  [next-var : i64]) : CompilerIrInstr
  (CompilerIrInstr.Phi
    derived-phi
    (compiler-ir-phi-input-cons
      (CompilerIrValue.Var seed-var)
      preheader
      (compiler-ir-phi-input-cons
        (CompilerIrValue.Var next-var)
        latch
        (CompilerIrPhiInputList.Nil)))
    (opt-induction-derived-phi-type derived)))

(define (opt-induction-seed-instrs
  [fact : OptInductionFact]
  [deriveds : OptInductionDerivedList]
  [frame : i64]) : CompilerIrInstrList
  (match deriveds
    [(OptInductionDerivedList.Nil) CompilerIrInstrList.Nil]
    [(OptInductionDerivedList.Cons derived rest)
      (opt-aggregate-instr-list-append
        (opt-induction-seed-instrs-for-derived fact derived frame)
        (opt-induction-seed-instrs
          fact
          (box-get rest)
          (+ frame (opt-induction-derived-slot-count derived))))]))

(define (opt-induction-phi-instrs
  [deriveds : OptInductionDerivedList]
  [preheader : i64]
  [latch : i64]
  [frame : i64]) : CompilerIrInstrList
  (match deriveds
    [(OptInductionDerivedList.Nil) CompilerIrInstrList.Nil]
    [(OptInductionDerivedList.Cons derived rest)
      (compiler-ir-instr-cons
        (opt-induction-phi-instr
          derived
          preheader
          latch
          (opt-induction-derived-seed-var derived frame)
          (opt-induction-derived-phi-var derived frame)
          (opt-induction-derived-next-var derived frame))
        (opt-induction-phi-instrs
          (box-get rest)
          preheader
          latch
          (+ frame (opt-induction-derived-slot-count derived))))]))

(define (opt-induction-next-instrs
  [fact : OptInductionFact]
  [deriveds : OptInductionDerivedList]
  [frame : i64]) : CompilerIrInstrList
  (match deriveds
    [(OptInductionDerivedList.Nil) CompilerIrInstrList.Nil]
    [(OptInductionDerivedList.Cons derived rest)
      (compiler-ir-instr-cons
        (opt-induction-next-instr
          fact
          derived
          (opt-induction-derived-phi-var derived frame)
          (opt-induction-derived-next-var derived frame))
        (opt-induction-next-instrs
          fact
          (box-get rest)
          (+ frame (opt-induction-derived-slot-count derived))))]))

(define (opt-induction-insert-support-blocks
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [seed-instrs : CompilerIrInstrList]
  [phi-instrs : CompilerIrInstrList]
  [next-instrs : CompilerIrInstrList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [list-instrs : CompilerIrInstrList
              (opt-aggregate-instr-seq-append-from
                instrs
                0
                CompilerIrInstrList.Nil)]
            [with-phi : CompilerIrInstrList
              (if (= label header)
                (opt-aggregate-instr-list-append phi-instrs list-instrs)
                list-instrs)]
            [with-seed : CompilerIrInstrList
              (if (= label preheader)
                (opt-licm-insert-before-terminator seed-instrs with-phi)
                with-phi)]
            [with-next : CompilerIrInstrList
              (if (= label latch)
                (opt-licm-insert-before-terminator next-instrs with-seed)
                with-seed)]
            (compiler-ir-block-cons
              (compiler-ir-block label with-next)
              (opt-induction-insert-support-blocks
                header
                preheader
                latch
                seed-instrs
                phi-instrs
                next-instrs
                (box-get rest))))])]
    [(CompilerIrBlockList.Array seq)
      (opt-induction-insert-support-blocks
        header
        preheader
        latch
        seed-instrs
        phi-instrs
        next-instrs
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-apply-loop
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptInductionApplyResult
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.Some preheader)
      (let
        [body : OptLoopBody (opt-natural-loop-body-info loop)]
        [body-blocks : CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        (if (opt-induction-loop-blocked? body-blocks)
          (OptInductionApplyResult.Result blocks frame false)
          (match (opt-induction-find-fact
            type-segment-bases
            body-blocks
            loop
            preheader)
            [(OptMaybeInductionFact.Some fact)
              (let
                [loop-defs : opt_i64_i64_map.Map
                  (opt-licm-collect-defs-blocks
                    body-blocks
                    (opt_i64_i64_map.with-capacity
                      (opt-licm-body-map-capacity body-blocks)))]
                [offsets : opt_i64_i64_map.Map
                  (opt-induction-affine-offset-env body-blocks fact)]
                [scaled : opt_i64_i64_map.Map
                  (opt-induction-scaled-env-blocks fact loop-defs body-blocks)]
                [deriveds : OptInductionDerivedList
                  (opt-induction-collect-derived-blocks
                    type-segment-bases
                    index
                    fact
                    offsets
                    scaled
                    loop-defs
                    blocks
                    body-blocks
                    (OptInductionDerivedList.Nil))]
                [derived-count : i64
                  (opt-induction-derived-list-count deriveds)]
                (if (= derived-count 0)
                  (OptInductionApplyResult.Result blocks frame false)
                  (let
                    [rewritten : CompilerIrBlockList
                      (opt-induction-rewrite-derived-list-blocks
                        type-segment-bases
                        body
                        index
                        fact
                        offsets
                        scaled
                        deriveds
                        frame
                        blocks)]
                    [seed-instrs : CompilerIrInstrList
                      (opt-induction-seed-instrs fact deriveds frame)]
                    [phi-instrs : CompilerIrInstrList
                      (opt-induction-phi-instrs
                        deriveds
                        preheader
                        (opt-natural-loop-latch loop)
                        frame)]
                    [next-instrs : CompilerIrInstrList
                      (opt-induction-next-instrs fact deriveds frame)]
                    (OptInductionApplyResult.Result
                      (opt-induction-insert-support-blocks
                        (opt-natural-loop-header loop)
                        preheader
                        (opt-natural-loop-latch loop)
                        seed-instrs
                        phi-instrs
                        next-instrs
                        rewritten)
                      (+ frame (opt-induction-derived-list-slot-count deriveds))
                      true))))]
            [(OptMaybeInductionFact.No)
              (OptInductionApplyResult.Result blocks frame false)])))]
    [(OptLoopPreheader.No) (OptInductionApplyResult.Result blocks frame false)]))

(define (opt-induction-apply-loops
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [changed : bool]) : OptInductionApplyResult
  (match loops
    [(OptNaturalLoopList.Nil)
      (OptInductionApplyResult.Result blocks frame changed)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-induction-apply-loop
        type-segment-bases
        index
        blocks
        frame
        loop)
        [(OptInductionApplyResult.Result next-blocks next-frame loop-changed)
          (opt-induction-apply-loops
            type-segment-bases
            index
            (box-get rest)
            next-blocks
            next-frame
            (or changed loop-changed))])]))

(define (opt-induction-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-induction-apply-loops
            type-segment-bases
            (struct-get context index)
            (opt-cfg-natural-loops-with-context blocks context)
            blocks
            frame
            false)
            [(OptInductionApplyResult.Result next-blocks next-frame changed)
              (if changed
                (let
                  [next : CompilerIrFunction
                    (CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      next-frame
                      next-blocks)]
                  ;; Induction cleanup can rewrite latch/exit edges, so build one
                  ;; fresh context for the rewritten CFG, reuse it for the
                  ;; post-pass verify, and hand it back for the next pass.
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)]))
                (OptFunctionCtxResult.Result func context))])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-induction-function-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-induction-function-with-context-result
    type-segment-bases
    context
    false
    func)
    [(OptFunctionCtxResult.Result next _) next]))

(define (opt-induction-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-induction-function-with-context
        type-segment-bases
        (opt-cfg-context-build blocks)
        func)]))

;; --- linear-function test replacement (LFTR) -------------------------------
;;
;; The induction slice above strength-reduces a loop's derived addresses into
;; pointer phis. That regularly leaves the original i64 counter phi with
;; nothing left to do but feed its own latch increment and the loop's exit
;; compare, and that residue still costs an `add` plus a loop-live register on
;; every iteration.
;;
;; LFTR retires such a counter. When the counter phi's uses across the WHOLE
;; function are exactly its `+ 1` latch increment, the copy hop that carries
;; the increment back into the phi, the exit compare, and instructions that are
;; already dead, the exit test is rewritten onto a derived pointer phi of the
;; same loop and the counter's phi/increment/copy are deleted outright.
;;
;; The residue is a phi <-> add <-> mov CYCLE. The pipeline's use-count DCE
;; sweep retires dead chains, not cycles, so this pass deletes the retired
;; instructions itself instead of leaving them for a cleanup that never comes.
;;
;; Shape (both latch compare forms are handled):
;;
;;   preheader: p0 = <pointer seed>        end = gep p0, (bound - seed) * K
;;   header:    i  = phi [seed, ph], [i2, latch]
;;              p  = phi [p0, ph],   [p2, latch]
;;   latch:     i2 = i + 1                 (deleted, with i and the copy)
;;              p2 = gep p, K
;;              c  = lt i,  bound  ->      c = lt p,  end        (form A)
;;              c  = lt i2, bound  ->      c = lt p2, end        (form B)
;;
;; Correctness. Both phis take their preheader value on the same edge and are
;; advanced unconditionally on the same latch edge, the counter by exactly + 1
;; and the pointer by exactly K elements, so at every header entry
;; `p = p0 + (i - seed) * K` elements. That map is strictly increasing, so
;; `i < bound` <=> `p < p0 + (bound - seed) * K` as long as the right-hand
;; address does not wrap.
;;
;; No-wrap: eligibility requires the counter to carry NO bounds check. A bounds
;; check reads the counter and is neither the increment nor the compare, so its
;; presence rejects the loop. Every indexed access built from this counter was
;; therefore already proven in range, which bounds the exit test's `bound` by
;; the element count of the SAME allocation the pointer walks, and
;; `p0 + (bound - seed) * K` is then at most one past that allocation's last
;; element. Addresses stay below 2^47 on both supported targets, so the
;; rewritten compare keeps the original signed i64 predicate and remains
;; order-equivalent to the index compare it replaces.
;;
;; Pipeline position: after bce_version and unroll. Both key their own rewrites
;; on the counter phi -- the per-edge bounds proofs read the counter's seed and
;; step, and the counted-loop unroll shape matches on the counter's phi/next
;; pair -- so retiring it before them would silently remove their input.
;; Running here leaves both untouched and hands the retired form to
;; affine-fold/GVN and the backend.
(defenum OptLftrMaybeInstr
  (No)
  (Some CompilerIrInstr))

;; Counter phi var, `i + 1` destination var, the phi's latch-input var (equal
;; to the increment when SSA renaming left no copy hop), constant seed.
(defenum OptLftrCounter
  (Counter i64 i64 i64 i64))

(defenum OptLftrMaybeCounter
  (No)
  (Some OptLftrCounter))

;; Pointer phi var, its preheader seed var, the latch `gep phi, K` destination
;; var, the gep's element type, the element step K, and that gep's index inside
;; the latch block (form B needs the step to precede the compare).
(defenum OptLftrPointer
  (Pointer i64 i64 i64 AstType i64 i64))

(defenum OptLftrMaybePointer
  (No)
  (Some OptLftrPointer))

;; Compare destination, operand type, compare op, bound value, and whether the
;; compare reads the increment (form B) instead of the phi (form A).
(defenum OptLftrTest
  (Test i64 AstType CompilerIrBinOp CompilerIrValue bool))

(defenum OptLftrMaybeTestSite
  (No)
  ;; test, the block label holding it, its index inside that block
  (Some OptLftrTest i64 i64))

;; Kill count, kill vars, rewritten compare destination, rewritten compare,
;; preheader label, preheader instructions, new frame.
(defenum OptLftrPlan
  (Plan i64 (Array i64) i64 CompilerIrInstr i64 CompilerIrInstrList i64))

(defenum OptLftrMaybePlan
  (No)
  (Some OptLftrPlan))

(defenum OptLftrApplyResult
  (Result CompilerIrBlockList i64 bool))

;; Retiring the counter deletes its phi, its increment, its copy hop, and any
;; already-dead readers. Three fixed slots plus a small dead-reader budget keeps
;; the census bounded; a loop with more dead readers than this is left alone.
(define (opt-lftr-kill-cap) : i64
  8)

(define (opt-lftr-kill-fixed) : i64
  3)

(define (opt-lftr-plan-frame [plan : OptLftrPlan]) : i64
  (match plan
    [(OptLftrPlan.Plan _ _ _ _ _ _ frame) frame]))

(define (opt-lftr-def-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptLftrMaybeInstr
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptLftrMaybeInstr.No)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (= dst var)
            (OptLftrMaybeInstr.Some instr)
            (opt-lftr-def-instr-seq-from instrs (+ index 1) var))]
        [(option_i64.None) (opt-lftr-def-instr-seq-from instrs (+ index 1) var)]))))

(define (opt-lftr-def-instr-blocks [blocks : CompilerIrBlockList] [var : i64]) : OptLftrMaybeInstr
  (match blocks
    [(CompilerIrBlockList.Nil) (OptLftrMaybeInstr.No)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (opt-lftr-def-instr-seq-from instrs 0 var)
            [(OptLftrMaybeInstr.Some instr) (OptLftrMaybeInstr.Some instr)]
            [(OptLftrMaybeInstr.No)
              (opt-lftr-def-instr-blocks (box-get rest) var)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-lftr-def-instr-blocks (compiler-ir-block-seq-to-list seq) var)]))

;; The index of `var`'s definition inside one block, or -1 when it is not
;; defined there.
(define (opt-lftr-def-index-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs index))
      [(option_i64.Some dst)
        (if (= dst var)
          index
          (opt-lftr-def-index-seq-from instrs (+ index 1) var))]
      [(option_i64.None) (opt-lftr-def-index-seq-from instrs (+ index 1) var)])))

(define (opt-lftr-value-is-var? [value : CompilerIrValue] [var : i64]) : bool
  (match value
    [(CompilerIrValue.Var id) (= id var)]
    [_ false]))

;; `i + 1` in either operand order.
(define (opt-lftr-unit-increment? [instr : CompilerIrInstr] [phi-var : i64]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ op lhs rhs ty)
      (and
        (opt-induction-i64-type? ty)
        (match op
          [(CompilerIrBinOp.Add) true]
          [_ false])
        (if (opt-lftr-value-is-var? lhs phi-var)
          (match rhs
            [(CompilerIrValue.I64 step) (= step 1)]
            [_ false])
          (and
            (opt-lftr-value-is-var? rhs phi-var)
            (match lhs
              [(CompilerIrValue.I64 step) (= step 1)]
              [_ false]))))]
    [_ false]))

;; The source var of `dst = mov src`, or -1.
(define (opt-lftr-mov-source [instr : CompilerIrInstr]) : i64
  (match instr
    [(CompilerIrInstr.Mov _ src ty)
      (if (opt-induction-i64-type? ty)
        (match src
          [(CompilerIrValue.Var var) var]
          [_ (- 0 1)])
        (- 0 1))]
    [_ (- 0 1)]))

;; The phi's latch input is either the increment itself or a single copy hop
;; away from it. Deeper chains are rejected: the retirement deletes every
;; instruction it names, so the named set has to be closed.
(define (opt-lftr-counter-resolve
  [body-blocks : CompilerIrBlockList]
  [phi-var : i64]
  [seed : i64]
  [back : i64]) : OptLftrMaybeCounter
  (match (opt-lftr-def-instr-blocks body-blocks back)
    [(OptLftrMaybeInstr.No) (OptLftrMaybeCounter.No)]
    [(OptLftrMaybeInstr.Some instr)
      (if (opt-lftr-unit-increment? instr phi-var)
        (OptLftrMaybeCounter.Some
          (OptLftrCounter.Counter phi-var back back seed))
        (let
          [source : i64 (opt-lftr-mov-source instr)]
          (if (< source 0)
            (OptLftrMaybeCounter.No)
            (match (opt-lftr-def-instr-blocks body-blocks source)
              [(OptLftrMaybeInstr.No) (OptLftrMaybeCounter.No)]
              [(OptLftrMaybeInstr.Some source-instr)
                (if (opt-lftr-unit-increment? source-instr phi-var)
                  (OptLftrMaybeCounter.Some
                    (OptLftrCounter.Counter phi-var source back seed))
                  (OptLftrMaybeCounter.No))]))))]))

(define (opt-lftr-counter-from-phi
  [body-blocks : CompilerIrBlockList]
  [preheader : i64]
  [latch : i64]
  [instr : CompilerIrInstr]) : OptLftrMaybeCounter
  (match instr
    [(CompilerIrInstr.Phi phi-var inputs ty)
      (if (opt-induction-i64-type? ty)
        (match (opt-induction-phi-inputs inputs preheader latch)
          [(OptInductionPhiInputs.Some start back)
            (match start
              [(CompilerIrValue.I64 seed)
                (if (opt-induction-small-const? seed)
                  (opt-lftr-counter-resolve body-blocks phi-var seed back)
                  (OptLftrMaybeCounter.No))]
              [_ (OptLftrMaybeCounter.No)])]
          [(OptInductionPhiInputs.No) (OptLftrMaybeCounter.No)])
        (OptLftrMaybeCounter.No))]
    [_ (OptLftrMaybeCounter.No)]))

(define (opt-lftr-find-counter-seq-from
  [body-blocks : CompilerIrBlockList]
  [preheader : i64]
  [latch : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptLftrMaybeCounter
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptLftrMaybeCounter.No)
    (match (opt-lftr-counter-from-phi
      body-blocks
      preheader
      latch
      (compiler-ir-instr-seq-ref instrs index))
      [(OptLftrMaybeCounter.Some counter) (OptLftrMaybeCounter.Some counter)]
      [(OptLftrMaybeCounter.No)
        (opt-lftr-find-counter-seq-from
          body-blocks
          preheader
          latch
          instrs
          (+ index 1))])))

;; A pointer induction phi of the same loop: seeded from the preheader and
;; advanced by a constant, strictly positive element step in the latch.
(define (opt-lftr-pointer-from-phi
  [type-segment-bases : i64]
  [latch-instrs : CompilerIrInstrSeq]
  [preheader : i64]
  [latch : i64]
  [counter-phi : i64]
  [instr : CompilerIrInstr]) : OptLftrMaybePointer
  (match instr
    [(CompilerIrInstr.Phi phi-var inputs ty)
      (if (and (not (= phi-var counter-phi)) (opt-induction-i64-type? ty))
        (match (opt-induction-phi-inputs inputs preheader latch)
          [(OptInductionPhiInputs.Some start next-var)
            (match start
              [(CompilerIrValue.Var seed-var)
                (let
                  [step-index : i64
                    (opt-lftr-def-index-seq-from latch-instrs 0 next-var)]
                  (if (< step-index 0)
                    (OptLftrMaybePointer.No)
                    (match (compiler-ir-instr-seq-ref latch-instrs step-index)
                      [(CompilerIrInstr.Gep _ base offset gep-ty)
                        (if (opt-lftr-value-is-var? base phi-var)
                          (match offset
                            [(CompilerIrValue.I64 step)
                              (if (and
                                (> step 0)
                                (opt-induction-small-const? step)
                                (>
                                  (opt-load-loc-type-size
                                    type-segment-bases
                                    gep-ty)
                                  0))
                                (OptLftrMaybePointer.Some
                                  (OptLftrPointer.Pointer
                                    phi-var
                                    seed-var
                                    next-var
                                    gep-ty
                                    step
                                    step-index))
                                (OptLftrMaybePointer.No))]
                            [_ (OptLftrMaybePointer.No)])
                          (OptLftrMaybePointer.No))]
                      [_ (OptLftrMaybePointer.No)])))]
              [_ (OptLftrMaybePointer.No)])]
          [(OptInductionPhiInputs.No) (OptLftrMaybePointer.No)])
        (OptLftrMaybePointer.No))]
    [_ (OptLftrMaybePointer.No)]))

(define (opt-lftr-find-pointer-seq-from
  [type-segment-bases : i64]
  [latch-instrs : CompilerIrInstrSeq]
  [preheader : i64]
  [latch : i64]
  [counter-phi : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptLftrMaybePointer
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptLftrMaybePointer.No)
    (match (opt-lftr-pointer-from-phi
      type-segment-bases
      latch-instrs
      preheader
      latch
      counter-phi
      (compiler-ir-instr-seq-ref instrs index))
      [(OptLftrMaybePointer.Some pointer) (OptLftrMaybePointer.Some pointer)]
      [(OptLftrMaybePointer.No)
        (opt-lftr-find-pointer-seq-from
          type-segment-bases
          latch-instrs
          preheader
          latch
          counter-phi
          instrs
          (+ index 1))])))

;; Only the two ordering predicates that a strictly increasing index-to-address
;; map preserves in both directions are admitted here.
(define (opt-lftr-order-op? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Lt) true]
    [(CompilerIrBinOp.Le) true]
    [_ false]))

;; The bound is re-used as an operand of the preheader's end-address
;; arithmetic, so only the scalar forms that arithmetic accepts qualify.
(define (opt-lftr-bound-value? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.Var _) true]
    [_ false]))

(define (opt-lftr-test-from-instr
  [loop-defs : opt_i64_i64_map.Map]
  [phi-var : i64]
  [next-var : i64]
  [instr : CompilerIrInstr]) : OptLftrMaybeTestSite
  (match instr
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (and
        (opt-induction-i64-type? ty)
        (opt-lftr-order-op? op)
        (opt-lftr-bound-value? rhs)
        (opt-induction-value-base-invariant? loop-defs rhs))
        (if (opt-lftr-value-is-var? lhs phi-var)
          (OptLftrMaybeTestSite.Some (OptLftrTest.Test dst ty op rhs false) 0 0)
          (if (opt-lftr-value-is-var? lhs next-var)
            (OptLftrMaybeTestSite.Some
              (OptLftrTest.Test dst ty op rhs true)
              0
              0)
            (OptLftrMaybeTestSite.No)))
        (OptLftrMaybeTestSite.No))]
    [_ (OptLftrMaybeTestSite.No)]))

(define (opt-lftr-find-test-seq-from
  [loop-defs : opt_i64_i64_map.Map]
  [phi-var : i64]
  [next-var : i64]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptLftrMaybeTestSite
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptLftrMaybeTestSite.No)
    (match (opt-lftr-test-from-instr
      loop-defs
      phi-var
      next-var
      (compiler-ir-instr-seq-ref instrs index))
      [(OptLftrMaybeTestSite.Some test _ _)
        (OptLftrMaybeTestSite.Some test label index)]
      [(OptLftrMaybeTestSite.No)
        (opt-lftr-find-test-seq-from
          loop-defs
          phi-var
          next-var
          label
          instrs
          (+ index 1))])))

(define (opt-lftr-find-test-blocks
  [loop-defs : opt_i64_i64_map.Map]
  [phi-var : i64]
  [next-var : i64]
  [blocks : CompilerIrBlockList]) : OptLftrMaybeTestSite
  (match blocks
    [(CompilerIrBlockList.Nil) (OptLftrMaybeTestSite.No)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (match (opt-lftr-find-test-seq-from
            loop-defs
            phi-var
            next-var
            label
            instrs
            0)
            [(OptLftrMaybeTestSite.Some test site-label site-index)
              (OptLftrMaybeTestSite.Some test site-label site-index)]
            [(OptLftrMaybeTestSite.No)
              (opt-lftr-find-test-blocks
                loop-defs
                phi-var
                next-var
                (box-get rest))])])]
    [(CompilerIrBlockList.Array seq)
      (opt-lftr-find-test-blocks
        loop-defs
        phi-var
        next-var
        (compiler-ir-block-seq-to-list seq))]))

;; Pure, destination-only instructions whose result is unused: the census may
;; treat these as non-uses because the retirement deletes them too.
(define (opt-lftr-dead-removable?
  [uses : (Array i64)]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov dst _ _) (not (opt-used-array-contains uses dst))]
    [(CompilerIrInstr.Cast dst _ _ _) (not (opt-used-array-contains uses dst))]
    [(CompilerIrInstr.Bitcast dst _ _ _)
      (not (opt-used-array-contains uses dst))]
    [(CompilerIrInstr.Gep dst _ _ _) (not (opt-used-array-contains uses dst))]
    [(CompilerIrInstr.BinOp dst op _ _ _)
      (and (not (opt-binop-traps? op)) (not (opt-used-array-contains uses dst)))]
    [(CompilerIrInstr.UnOp dst _ _ _) (not (opt-used-array-contains uses dst))]
    [_ false]))

(define (opt-lftr-in-kills-from?
  [kills : (Array i64)]
  [count : i64]
  [index : i64]
  [var : i64]) : bool
  (if (>= index count)
    false
    (if (= (array-ref kills index) var)
      true
      (opt-lftr-in-kills-from? kills count (+ index 1) var))))

(define (opt-lftr-in-kills? [plan : OptLftrPlan] [var : i64]) : bool
  (match plan
    [(OptLftrPlan.Plan count kills _ _ _ _ _)
      (opt-lftr-in-kills-from? kills count 0 var)]))

;; The scratch array accumulates per-instruction use counts monotonically, so a
;; strict increase on any of the three retiring vars identifies the instruction
;; as a reader without a per-instruction map allocation.
(define (opt-lftr-reads-kill?
  [scratch : (Array i64)]
  [kills : (Array i64)]
  [before-phi : i64]
  [before-next : i64]
  [before-back : i64]) : bool
  (or
    (> (array-ref scratch (array-ref kills 0)) before-phi)
    (> (array-ref scratch (array-ref kills 1)) before-next)
    (> (array-ref scratch (array-ref kills 2)) before-back)))

(define (opt-lftr-census-instr
  [uses : (Array i64)]
  [scratch : (Array i64)]
  [kills : (Array i64)]
  [count : (Array i64)]
  [compare-dst : i64]
  [instr : CompilerIrInstr]) : bool
  (let
    [before-phi : i64 (array-ref scratch (array-ref kills 0))]
    [before-next : i64 (array-ref scratch (array-ref kills 1))]
    [before-back : i64 (array-ref scratch (array-ref kills 2))]
    [_collect : unit (opt-collect-instr-uses-array scratch instr)]
    (if (not
      (opt-lftr-reads-kill? scratch kills before-phi before-next before-back))
      true
      (match (opt-instr-def-var instr)
        [(option_i64.None) false]
        [(option_i64.Some dst)
          (cond
            [(opt-lftr-in-kills-from? kills (opt-lftr-kill-fixed) 0 dst) true]
            [(= dst compare-dst) true]
            [(and
                (opt-lftr-dead-removable? uses instr)
                (< (array-ref count 0) (opt-lftr-kill-cap)))
              (begin
                (array-set! kills (array-ref count 0) dst)
                (array-set! count 0 (+ (array-ref count 0) 1))
                true)]
            [else false])]))))

(define (opt-lftr-census-seq-from
  [uses : (Array i64)]
  [scratch : (Array i64)]
  [kills : (Array i64)]
  [count : (Array i64)]
  [compare-dst : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-lftr-census-instr
        uses
        scratch
        kills
        count
        compare-dst
        (compiler-ir-instr-seq-ref instrs index))
      (opt-lftr-census-seq-from
        uses
        scratch
        kills
        count
        compare-dst
        instrs
        (+ index 1)))))

(define (opt-lftr-census-blocks
  [uses : (Array i64)]
  [scratch : (Array i64)]
  [kills : (Array i64)]
  [count : (Array i64)]
  [compare-dst : i64]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (and
            (opt-lftr-census-seq-from
              uses
              scratch
              kills
              count
              compare-dst
              instrs
              0)
            (opt-lftr-census-blocks
              uses
              scratch
              kills
              count
              compare-dst
              (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-lftr-census-blocks
        uses
        scratch
        kills
        count
        compare-dst
        (compiler-ir-block-seq-to-list seq))]))

;; `end = p0 + (bound - seed) * K` elements. A literal bound folds to a single
;; gep; a variable bound pays the subtract only for a nonzero seed and the
;; multiply only for a multi-element step.
(define (opt-lftr-end-instrs
  [pointer : OptLftrPointer]
  [seed : i64]
  [bound : CompilerIrValue]
  [frame : i64]) : CompilerIrInstrList
  (match pointer
    [(OptLftrPointer.Pointer _ seed-var _ gep-ty step _)
      (let
        [sub-var : i64 frame]
        [mul-var : i64 (+ frame 1)]
        [end-var : i64 (+ frame 2)]
        (match bound
          [(CompilerIrValue.I64 limit)
            (compiler-ir-instr-cons
              (CompilerIrInstr.Gep
                end-var
                (CompilerIrValue.Var seed-var)
                (CompilerIrValue.I64 (* (- limit seed) step))
                gep-ty)
              (CompilerIrInstrList.Nil))]
          [_
            (let
              [offset-instrs : CompilerIrInstrList
                (if (= seed 0)
                  (CompilerIrInstrList.Nil)
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.BinOp
                      sub-var
                      (CompilerIrBinOp.Sub)
                      bound
                      (CompilerIrValue.I64 seed)
                      (AstType.I64))
                    (CompilerIrInstrList.Nil)))]
              [offset-value : CompilerIrValue
                (if (= seed 0)
                  bound
                  (CompilerIrValue.Var sub-var))]
              [scaled-instrs : CompilerIrInstrList
                (if (= step 1)
                  offset-instrs
                  (opt-aggregate-instr-list-append
                    offset-instrs
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.BinOp
                        mul-var
                        (CompilerIrBinOp.Mul)
                        offset-value
                        (CompilerIrValue.I64 step)
                        (AstType.I64))
                      (CompilerIrInstrList.Nil))))]
              [scaled-value : CompilerIrValue
                (if (= step 1)
                  offset-value
                  (CompilerIrValue.Var mul-var))]
              (opt-aggregate-instr-list-append
                scaled-instrs
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Gep
                    end-var
                    (CompilerIrValue.Var seed-var)
                    scaled-value
                    gep-ty)
                  (CompilerIrInstrList.Nil))))]))]))

;; A literal bound is materialised as one folded gep displacement, so keep the
;; folded product inside the pass's ordinary small-constant window.
(define (opt-lftr-literal-bound-ok?
  [seed : i64]
  [step : i64]
  [bound : CompilerIrValue]) : bool
  (match bound
    [(CompilerIrValue.I64 limit)
      (and
        (opt-induction-small-const? limit)
        (opt-induction-small-const? (* (- limit seed) step)))]
    [_ true]))

;; The census indexes its use arrays by the retiring vars directly, so a var id
;; outside the function's frame would read past them. Frames are authoritative
;; for well-formed IR; this keeps a malformed one fail-closed instead of
;; trapping.
(define (opt-lftr-frame-var? [frame : i64] [var : i64]) : bool
  (and (>= var 0) (< var frame)))

(define (opt-lftr-build-plan
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [preheader : i64]
  [counter : OptLftrCounter]
  [pointer : OptLftrPointer]
  [test : OptLftrTest]) : OptLftrMaybePlan
  (match counter
    [(OptLftrCounter.Counter phi-var next-var back-var seed)
      (match pointer
        [(OptLftrPointer.Pointer pointer-phi _ pointer-next _ step _)
          (match test
            [(OptLftrTest.Test compare-dst compare-ty op bound reads-next?)
              (if (not
                (and
                  (opt-lftr-literal-bound-ok? seed step bound)
                  (opt-lftr-frame-var? frame phi-var)
                  (opt-lftr-frame-var? frame next-var)
                  (opt-lftr-frame-var? frame back-var)))
                (OptLftrMaybePlan.No)
                (let
                  [kills : (Array i64)
                    (array.make-array i64 (opt-lftr-kill-cap))]
                  [count : (Array i64) (array.make-array i64 1)]
                  [uses : (Array i64)
                    (opt-collect-blocks-uses-array frame blocks)]
                  [scratch : (Array i64) (opt-used-array-new frame)]
                  [_seed-kills : unit
                    (begin
                      (array-set! kills 0 phi-var)
                      (array-set! kills 1 next-var)
                      (array-set! kills 2 back-var)
                      (array-set! count 0 (opt-lftr-kill-fixed)))]
                  (if (not
                    (opt-lftr-census-blocks
                      uses
                      scratch
                      kills
                      count
                      compare-dst
                      blocks))
                    (OptLftrMaybePlan.No)
                    (OptLftrMaybePlan.Some
                      (OptLftrPlan.Plan
                        (array-ref count 0)
                        kills
                        compare-dst
                        (CompilerIrInstr.BinOp
                          compare-dst
                          op
                          (CompilerIrValue.Var
                            (if reads-next?
                              pointer-next
                              pointer-phi))
                          (CompilerIrValue.Var (+ frame 2))
                          compare-ty)
                        preheader
                        (opt-lftr-end-instrs pointer seed bound frame)
                        (+ frame 3))))))])])]))

;; Form B compares the incremented counter, so the pointer's advanced value has
;; to be the one the compare reads: it must be defined in the same latch block,
;; ahead of the compare. Form A reads the header phi, which dominates the whole
;; body.
(define (opt-lftr-test-site-ok?
  [pointer : OptLftrPointer]
  [test : OptLftrTest]
  [latch : i64]
  [site-label : i64]
  [site-index : i64]) : bool
  (match test
    [(OptLftrTest.Test _ _ _ _ reads-next?)
      (if (not reads-next?)
        true
        (match pointer
          [(OptLftrPointer.Pointer _ _ _ _ _ step-index)
            (and (= site-label latch) (< step-index site-index))]))]))

(define (opt-lftr-plan
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [body-blocks : CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]
  [preheader : i64]) : OptLftrMaybePlan
  (let
    [header : i64 (opt-natural-loop-header loop)]
    [latch : i64 (opt-natural-loop-latch loop)]
    (match (opt-cfg-find-block body-blocks header)
      [(OptMaybeBlock.No) (OptLftrMaybePlan.No)]
      [(OptMaybeBlock.Some header-block)
        (match (opt-cfg-find-block body-blocks latch)
          [(OptMaybeBlock.No) (OptLftrMaybePlan.No)]
          [(OptMaybeBlock.Some latch-block)
            (match header-block
              [(CompilerIrBlock.Block _ header-instrs)
                (match latch-block
                  [(CompilerIrBlock.Block _ latch-instrs)
                    (match (opt-lftr-find-counter-seq-from
                      body-blocks
                      preheader
                      latch
                      header-instrs
                      0)
                      [(OptLftrMaybeCounter.No) (OptLftrMaybePlan.No)]
                      [(OptLftrMaybeCounter.Some counter)
                        (match counter
                          [(OptLftrCounter.Counter phi-var next-var _ _)
                            (match (opt-lftr-find-pointer-seq-from
                              type-segment-bases
                              latch-instrs
                              preheader
                              latch
                              phi-var
                              header-instrs
                              0)
                              [(OptLftrMaybePointer.No) (OptLftrMaybePlan.No)]
                              [(OptLftrMaybePointer.Some pointer)
                                (match (opt-lftr-find-test-blocks
                                  (opt-licm-collect-defs-blocks
                                    body-blocks
                                    (opt_i64_i64_map.with-capacity
                                      (opt-licm-body-map-capacity body-blocks)))
                                  phi-var
                                  next-var
                                  body-blocks)
                                  [(OptLftrMaybeTestSite.No)
                                    (OptLftrMaybePlan.No)]
                                  [(OptLftrMaybeTestSite.Some
                                      test
                                      site-label
                                      site-index)
                                    (if (opt-lftr-test-site-ok?
                                      pointer
                                      test
                                      latch
                                      site-label
                                      site-index)
                                      (opt-lftr-build-plan
                                        blocks
                                        frame
                                        preheader
                                        counter
                                        pointer
                                        test)
                                      (OptLftrMaybePlan.No))])])])])])])])])))

(define (opt-lftr-rewrite-instr [plan : OptLftrPlan] [instr : CompilerIrInstr]) : CompilerIrInstr
  (match plan
    [(OptLftrPlan.Plan _ _ compare-dst compare _ _ _)
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (= dst compare-dst)
            compare
            instr)]
        [(option_i64.None) instr])]))

(define (opt-lftr-rewrite-instr-seq-from
  [plan : OptLftrPlan]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      [rest : CompilerIrInstrList
        (opt-lftr-rewrite-instr-seq-from plan instrs (+ index 1))]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (opt-lftr-in-kills? plan dst)
            rest
            (compiler-ir-instr-cons (opt-lftr-rewrite-instr plan instr) rest))]
        [(option_i64.None) (compiler-ir-instr-cons instr rest)]))))

(define (opt-lftr-rewrite-blocks
  [plan : OptLftrPlan]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (match plan
            [(OptLftrPlan.Plan _ _ _ _ preheader end-instrs _)
              (compiler-ir-block-cons
                (compiler-ir-block
                  label
                  (if (= label preheader)
                    (opt-licm-insert-before-terminator
                      end-instrs
                      (opt-lftr-rewrite-instr-seq-from plan instrs 0))
                    (opt-lftr-rewrite-instr-seq-from plan instrs 0)))
                (opt-lftr-rewrite-blocks plan (box-get rest)))])])]
    [(CompilerIrBlockList.Array seq)
      (opt-lftr-rewrite-blocks plan (compiler-ir-block-seq-to-list seq))]))

(define (opt-lftr-apply-loop
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptLftrApplyResult
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.No) (OptLftrApplyResult.Result blocks frame false)]
    [(OptLoopPreheader.Some preheader)
      (let
        [body-blocks : CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        ;; Same fail-closed body gate the induction slice uses: the retirement
        ;; keeps a loop-live `end` where the counter used to be, so the loops
        ;; whose recurrences that pass declines are declined here too.
        (if (opt-induction-loop-blocked? body-blocks)
          (OptLftrApplyResult.Result blocks frame false)
          (match (opt-lftr-plan
            type-segment-bases
            blocks
            body-blocks
            frame
            loop
            preheader)
            [(OptLftrMaybePlan.No)
              (OptLftrApplyResult.Result blocks frame false)]
            [(OptLftrMaybePlan.Some plan)
              (OptLftrApplyResult.Result
                (opt-lftr-rewrite-blocks plan blocks)
                (opt-lftr-plan-frame plan)
                true)])))]))

(define (opt-lftr-apply-loops
  [type-segment-bases : i64]
  [loops : OptNaturalLoopList]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [changed : bool]) : OptLftrApplyResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptLftrApplyResult.Result blocks frame changed)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-lftr-apply-loop type-segment-bases blocks frame loop)
        [(OptLftrApplyResult.Result next-blocks next-frame loop-changed)
          (opt-lftr-apply-loops
            type-segment-bases
            (box-get rest)
            next-blocks
            next-frame
            (or changed loop-changed))])]))

(define (opt-lftr-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-lftr-apply-loops
            type-segment-bases
            (opt-cfg-natural-loops-with-context blocks context)
            blocks
            frame
            false)
            [(OptLftrApplyResult.Result next-blocks next-frame changed)
              (if (not changed)
                (OptFunctionCtxResult.Result func context)
                (let
                  [next : CompilerIrFunction
                    (CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      next-frame
                      next-blocks)]
                  ;; The rewrite only edits instructions, but the deleted phi
                  ;; changes the header's phi prefix, so build one fresh context
                  ;; for the rewritten blocks, reuse it for the post-pass
                  ;; verify, and hand it to the next pass.
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)])))])])]))

(define (opt-lftr-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-lftr-function-with-context-result
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; Branch folding can leave both source blocks reachable while removing only
;; one source-to-phi edge. Filter against the destination's actual reachable
;; predecessor set, not global reachability alone, so neither stale edges from
;; reachable blocks nor edges from unreachable blocks survive CFG cleanup.
(define (opt-cfg-filter-phi-inputs
  [index : OptCfgIndex]
  [block-id : i64]
  [inputs : CompilerIrPhiInputList]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-cfg-filter-phi-inputs
        index
        block-id
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (opt-cfg-index-reachable-predecessor? index block-id label)
        (compiler-ir-phi-input-cons
          value
          label
          (opt-cfg-filter-phi-inputs index block-id (box-get rest)))
        (opt-cfg-filter-phi-inputs index block-id (box-get rest)))]))

(define (opt-phi-input-count [inputs : CompilerIrPhiInputList]) : i64
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) 0]
    [(CompilerIrPhiInputList.Array seq)
      (opt-phi-input-count (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons _ _ rest)
      (+ 1 (opt-phi-input-count (box-get rest)))]))

(define (opt-phi-single-value [inputs : CompilerIrPhiInputList]) : CompilerIrMaybeValue
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Array seq)
      (opt-phi-single-value (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (match (compiler-ir-phi-input-list-force-cons (box-get rest))
        [(CompilerIrPhiInputList.Nil) (CompilerIrMaybeValue.Some value)]
        [(CompilerIrPhiInputList.Array seq)
          (if (= (struct-get seq len) 0)
            (CompilerIrMaybeValue.Some value)
            (CompilerIrMaybeValue.No))]
        [_ (CompilerIrMaybeValue.No)])]
    [_ (CompilerIrMaybeValue.No)]))

(define (opt-cfg-clean-instr
  [index : OptCfgIndex]
  [block-id : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Phi dst inputs ty)
      (let
        [kept : CompilerIrPhiInputList
          (opt-cfg-filter-phi-inputs index block-id inputs)]
        (if (= (opt-phi-input-count kept) 1)
          (match (opt-phi-single-value kept)
            [(CompilerIrMaybeValue.Some value)
              (if (opt-value-is-var? value dst)
                (CompilerIrInstr.Phi dst kept ty)
                (CompilerIrInstr.Mov dst value ty))]
            [(CompilerIrMaybeValue.No) (CompilerIrInstr.Phi dst kept ty)])
          (CompilerIrInstr.Phi dst kept ty)))]
    [_ instr]))

;; 1:1 rewrite -> dense output sequence (see opt-global-copy-instr-seq). refs #5726
(define (opt-cfg-clean-instr-seq
  [index : OptCfgIndex]
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [block-id : i64
      (match (opt-cfg-index-id index block-label)
        [(option_i64.Some id) id]
        [(option_i64.None) (- 0 1)])]
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [out : (Array CompilerIrInstr) (array.make-array CompilerIrInstr count)]
    [pos : i64 0]
    (begin
      (while (< pos count)
        (begin
          (array-set!
            out
            pos
            (opt-cfg-clean-instr index block-id (array-ref slots pos)))
          (set! pos (+ pos 1))))
      (CompilerIrInstrSeq out count))))

(define (opt-cfg-clean-block [index : OptCfgIndex] [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (CompilerIrBlock.Block label (opt-cfg-clean-instr-seq index label instrs))]))

(define (opt-cfg-filter-clean-blocks
  [index : OptCfgIndex]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (if (opt-cfg-index-reachable? index label)
            (compiler-ir-block-cons
              (opt-cfg-clean-block index block)
              (opt-cfg-filter-clean-blocks index (box-get rest)))
            (opt-cfg-filter-clean-blocks index (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-cfg-filter-clean-blocks index (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-simplify-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [folded : CompilerIrBlockList (opt-cfg-fold-branches-blocks blocks)]
    [index : OptCfgIndex (opt-cfg-index-build folded)]
    (opt-cfg-filter-clean-blocks index folded)))

(define (opt-cfg-clean-instr-seq-rewrite!
  [index : OptCfgIndex]
  [block-label : i64]
  [used : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [block-id : i64
      (match (opt-cfg-index-id index block-label)
        [(option_i64.Some id) id]
        [(option_i64.None) (- 0 1)])]
    [pos : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (while (< pos count)
      (let
        [cleaned : CompilerIrInstr
          (opt-cfg-clean-instr
            index
            block-id
            (compiler-ir-instr-seq-ref instrs pos))]
        (begin
          (compiler-ir-instr-seq-set! instrs pos cleaned)
          (opt-collect-instr-uses-array used cleaned)
          (set! pos (+ pos 1)))))))

(define (opt-cfg-filter-clean-block-seq-rewrite!
  [index : OptCfgIndex]
  [used : (Array i64)]
  [blocks : CompilerIrBlockSeq]) : unit
  (let
    [slots : (Array CompilerIrBlock) (struct-get blocks slots)]
    [reachable : (Array bool) (struct-get index reachable)]
    [count : i64 (struct-get blocks len)]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (begin
          (if (array-ref reachable read)
            (let
              [block : CompilerIrBlock (array-ref slots read)]
              (begin
                (match block
                  [(CompilerIrBlock.Block label instrs)
                    (opt-cfg-clean-instr-seq-rewrite! index label used instrs)])
                (if (not (= write read))
                  (array-set! slots write block)
                  unit)
                (set! write (+ write 1))))
            unit)
          (set! read (+ read 1))))
      (set! (struct-get blocks len) write))))

;; Level 1 owns its post-fold block/instruction arrays in the per-function
;; scratch arena. Keep that representation through CFG cleanup: fold branches
;; and phis in place, compact unreachable blocks in the outer sequence, and let
;; the final DCE+escape traversal clone only the live result.
(define (opt-cfg-simplify-blocks-in-place
  [blocks : CompilerIrBlockList]
  [used : (Array i64)]) : CompilerIrBlockList
  (let
    [folded : CompilerIrBlockList (compiler-ir-block-list-compact blocks)]
    (begin
      (opt-cfg-fold-branches-blocks-rewrite! folded)
      (let
        [index : OptCfgIndex (opt-cfg-index-build folded)]
        (begin
          (match folded
            [(CompilerIrBlockList.Array seq)
              (opt-cfg-filter-clean-block-seq-rewrite! index used seq)]
            [_ unit])
          folded)))))

(define (opt-cfg-simplify-blocks-with-context-result
  [input : OptBlockCtxResult]) : OptBlockCtxResult
  (match input
    [(OptBlockCtxResult.Result blocks context context-valid)
      (if (and
        context-valid
        (not (opt-cfg-blocks-have-foldable-branch? blocks))
        (opt-cfg-context-all-blocks-reachable? context))
        (OptBlockCtxResult.Result
          (opt-cfg-filter-clean-blocks (struct-get context index) blocks)
          context
          true)
        (let
          [simplified : CompilerIrBlockList (opt-cfg-simplify-blocks blocks)]
          (OptBlockCtxResult.Result
            simplified
            (opt-cfg-context-build simplified)
            true)))]))

;; A short-circuit boolean lowered as `(if c1 c2 false)` has this late SSA
;; shape after inlining and scalar cleanup:
;;
;;   left:  %cmp = compare ...; jump merge
;;   right: jump merge
;;   merge: %cond = phi [%cmp, left], [false, right]; branch %cond, yes, no
;;
;; Materializing both comparison and phi booleans makes the backend emit
;; setcc/movzbq/test. Redirect the two predecessor jumps to the final branch
;; targets instead. The variable arm is accepted only when its value is the
;; immediately preceding pure scalar comparison; calls, loads, and other
;; potentially effectful condition producers stay untouched. A match whose arms
;; all return literal booleans produces the simpler `%cond = phi [true/false,
;; pred]` form. Thread every such predecessor directly to the selected final
;; target, expanding any successor-phi input from the merge block over the
;; redirected predecessors. Both forms require the phi result to have no use
;; beyond the branch; blocks with any other instruction (including another phi)
;; stay untouched.
(defenum OptBoolBranchDef
  (No)
  (Some CompilerIrInstr i64))

(defenum OptBoolBranchConjBuild
  (No)
  (Some CompilerIrInstrList))

(defenum OptBoolBranchChainRewrite
  (No)
  (Some CompilerIrBlockList i64))

(defenum OptBoolBranchChainResult
  (Result CompilerIrBlockList i64 bool))

(defenum OptBoolBranchPhiInputs
  (No)
  (Two CompilerIrValue i64 CompilerIrValue i64))

(defenum OptBoolBranchConstantInputs
  (No)
  (Some OptLabelSet OptLabelSet i64))

(defenum OptBoolBranchPredRewrite
  (No)
  (Some CompilerIrInstrSeq i64 CompilerIrInstr bool))

(define (opt-bool-branch-compare-op? [op : CompilerIrBinOp]) : bool
  (compiler-ir-binop-compare? op))

(define (opt-bool-branch-use-count [uses : (Array i64)] [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length uses)))
    0
    (array-ref uses var)))

;; A materialized boolean And tree feeding one Branch is the same late
;; opportunity as the phi threading below, but it needs real short-circuit CFG
;; edges rather than predecessor retargeting:
;;
;;   %a = compare ...
;;   %b = compare ...
;;   %ab = and %a, %b
;;   branch %ab, yes, no
;;
;; becomes `compare; branch` in the source block followed by one fresh block per
;; remaining conjunct. And results must have no uses outside the condition DAG.
;; A comparison leaf may also feed another branch (BCE guards commonly share
;; the loop-entry compare after GVN); clone that pure compare into the chain so
;; both uses become single-use compare/branch pairs. Repeated leaves are emitted
;; once, folding the compiler-generated `x && y && y` guard shape as part of the
;; rewrite. Or is deliberately not admitted in this first cut.
(define (opt-bool-branch-defs-fill-instrs!
  [defs : (Array OptBoolBranchDef)]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : unit
  (if (>= index (compiler-ir-instr-seq-count instrs))
    unit
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (begin
        (match instr
          [(CompilerIrInstr.BinOp dst _ _ _ _)
            (if (and (>= dst 0) (< dst (array-length defs)))
              (array-set! defs dst (OptBoolBranchDef.Some instr label))
              unit)]
          [_ unit])
        (opt-bool-branch-defs-fill-instrs! defs label instrs (+ index 1))))))

(define (opt-bool-branch-defs-fill-blocks!
  [defs : (Array OptBoolBranchDef)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block label instrs)
            (opt-bool-branch-defs-fill-instrs! defs label instrs 0)])
        (opt-bool-branch-defs-fill-blocks! defs (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-bool-branch-defs-fill-blocks!
        defs
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-bool-branch-defs [frame : i64] [blocks : CompilerIrBlockList]) : (Array
    OptBoolBranchDef)
  (let
    [defs : (Array OptBoolBranchDef) (array.make-array OptBoolBranchDef frame)]
    [index : i64 0]
    (begin
      (while (< index frame)
        (begin
          (array-set! defs index (OptBoolBranchDef.No))
          (set! index (+ index 1))))
      (opt-bool-branch-defs-fill-blocks! defs blocks)
      defs)))

(define (opt-bool-branch-def [defs : (Array OptBoolBranchDef)] [var : i64]) : OptBoolBranchDef
  (if (and (>= var 0) (< var (array-length defs)))
    (array-ref defs var)
    (OptBoolBranchDef.No)))

(define (opt-bool-branch-chain-note-ref! [refs : (Array i64)] [var : i64]) : bool
  (if (or (< var 0) (>= var (array-length refs)))
    false
    (begin
      (array-set! refs var (+ (array-ref refs var) 1))
      true)))

(define (opt-bool-branch-chain-collect-value!
  [type-segment-bases : i64]
  [defs : (Array OptBoolBranchDef)]
  [refs : (Array i64)]
  [visited : (Array bool)]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var)
      (and
        (opt-bool-branch-chain-note-ref! refs var)
        (if (array-ref visited var)
          true
          (begin
            (array-set! visited var true)
            (match (opt-bool-branch-def defs var)
              [(OptBoolBranchDef.No) false]
              [(OptBoolBranchDef.Some instr _)
                (match instr
                  [(CompilerIrInstr.BinOp dst op lhs rhs ty)
                    (if (not (= dst var))
                      false
                      (match op
                        [(CompilerIrBinOp.And)
                          (and
                            (opt-type-eq type-segment-bases ty (AstType.Bool))
                            (opt-bool-branch-chain-collect-value!
                              type-segment-bases
                              defs
                              refs
                              visited
                              lhs)
                            (opt-bool-branch-chain-collect-value!
                              type-segment-bases
                              defs
                              refs
                              visited
                              rhs))]
                        [(CompilerIrBinOp.Eq) true]
                        [(CompilerIrBinOp.Ne) true]
                        [(CompilerIrBinOp.Lt) true]
                        [(CompilerIrBinOp.Le) true]
                        [(CompilerIrBinOp.Gt) true]
                        [(CompilerIrBinOp.Ge) true]
                        [_ false]))]
                  [_ false])]))))]
    [_ false]))

(define (opt-bool-branch-chain-uses-ok-from?
  [defs : (Array OptBoolBranchDef)]
  [uses : (Array i64)]
  [refs : (Array i64)]
  [visited : (Array bool)]
  [index : i64]) : bool
  (if (>= index (array-length visited))
    true
    (if (not (array-ref visited index))
      (opt-bool-branch-chain-uses-ok-from? defs uses refs visited (+ index 1))
      (match (opt-bool-branch-def defs index)
        [(OptBoolBranchDef.No) false]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(CompilerIrInstr.BinOp _ op _ _ _)
              (and
                (match op
                  [(CompilerIrBinOp.And)
                    (=
                      (opt-bool-branch-use-count uses index)
                      (array-ref refs index))]
                  [_
                    (>=
                      (opt-bool-branch-use-count uses index)
                      (array-ref refs index))])
                (opt-bool-branch-chain-uses-ok-from?
                  defs
                  uses
                  refs
                  visited
                  (+ index 1)))]
            [_ false])]))))

(define (opt-bool-branch-chain-flatten-value
  [defs : (Array OptBoolBranchDef)]
  [uses : (Array i64)]
  [refs : (Array i64)]
  [expanded : (Array bool)]
  [emitted : (Array bool)]
  [remove : (Array bool)]
  [source-label : i64]
  [cell : (Array i64)]
  [value : CompilerIrValue]) : OptBoolBranchConjBuild
  (match value
    [(CompilerIrValue.Var var)
      (match (opt-bool-branch-def defs var)
        [(OptBoolBranchDef.No) (OptBoolBranchConjBuild.No)]
        [(OptBoolBranchDef.Some instr def-label)
          (match instr
            [(CompilerIrInstr.BinOp dst op lhs rhs ty)
              (match op
                [(CompilerIrBinOp.And)
                  (if (array-ref expanded var)
                    (OptBoolBranchConjBuild.Some (CompilerIrInstrList.Nil))
                    (begin
                      (array-set! expanded var true)
                      (if (= def-label source-label)
                        (array-set! remove dst true)
                        unit)
                      (match (opt-bool-branch-chain-flatten-value
                        defs
                        uses
                        refs
                        expanded
                        emitted
                        remove
                        source-label
                        cell
                        lhs)
                        [(OptBoolBranchConjBuild.No)
                          (OptBoolBranchConjBuild.No)]
                        [(OptBoolBranchConjBuild.Some left)
                          (match (opt-bool-branch-chain-flatten-value
                            defs
                            uses
                            refs
                            expanded
                            emitted
                            remove
                            source-label
                            cell
                            rhs)
                            [(OptBoolBranchConjBuild.No)
                              (OptBoolBranchConjBuild.No)]
                            [(OptBoolBranchConjBuild.Some right)
                              (OptBoolBranchConjBuild.Some
                                (opt-aggregate-instr-list-append left right))])])))]
                [_
                  (if (array-ref emitted var)
                    (OptBoolBranchConjBuild.Some (CompilerIrInstrList.Nil))
                    (let
                      [move? : bool
                        (and
                          (= def-label source-label)
                          (=
                            (opt-bool-branch-use-count uses var)
                            (array-ref refs var)))]
                      [next-dst : i64
                        (if move?
                          dst
                          (let
                            [fresh : i64 (array-ref cell 0)]
                            (begin
                              (array-set! cell 0 (+ fresh 1))
                              fresh)))]
                      (begin
                        (array-set! emitted var true)
                        (if move?
                          (array-set! remove dst true)
                          unit)
                        (OptBoolBranchConjBuild.Some
                          (compiler-ir-instr-cons
                            (CompilerIrInstr.BinOp next-dst op lhs rhs ty)
                            (CompilerIrInstrList.Nil))))))])]
            [_ (OptBoolBranchConjBuild.No)])])]
    [_ (OptBoolBranchConjBuild.No)]))

(define (opt-bool-branch-chain-conj-count [conjs : CompilerIrInstrList]) : i64
  (match conjs
    [(CompilerIrInstrList.Nil) 0]
    [(CompilerIrInstrList.Cons _ rest)
      (+ 1 (opt-bool-branch-chain-conj-count (box-get rest)))]))

(define (opt-bool-branch-chain-label-candidate
  [source-label : i64]
  [suffix : i64]) : i64
  (compiler-ir-label
    (string.append
      (compiler-ir-label-text source-label)
      (string.append "__bool_and." (string.int->string suffix)))))

(define (opt-bool-branch-chain-labels
  [blocks : CompilerIrBlockList]
  [source-label : i64]
  [remaining : i64]
  [suffix : i64]
  [made : OptLabelSet]) : OptLabelSet
  (if (<= remaining 0)
    (OptLabelSet.Nil)
    (let
      [candidate : i64
        (opt-bool-branch-chain-label-candidate source-label suffix)]
      (if (or
        (opt-cfg-block-exists? blocks candidate)
        (opt-label-contains made candidate))
        (opt-bool-branch-chain-labels
          blocks
          source-label
          remaining
          (+ suffix 1)
          made)
        (opt-label-cons
          candidate
          (opt-bool-branch-chain-labels
            blocks
            source-label
            (- remaining 1)
            (+ suffix 1)
            (opt-label-add made candidate)))))))

(define (opt-bool-branch-chain-label-set
  [labels : OptLabelSet]
  [set : OptLabelSet]) : OptLabelSet
  (match labels
    [(OptLabelSet.Nil) set]
    [(OptLabelSet.Dense _ _)
      (opt-bool-branch-chain-label-set
        (opt-label-tail labels)
        (opt-label-add set (opt-label-ref labels 0)))]))

(define (opt-bool-branch-chain-last-label
  [labels : OptLabelSet]
  [fallback : i64]) : i64
  (let
    [count : i64 (opt-label-count labels)]
    (if (= count 0)
      fallback
      (opt-label-ref labels (- count 1)))))

(define (opt-bool-branch-chain-first-label
  [labels : OptLabelSet]
  [fallback : i64]) : i64
  (match labels
    [(OptLabelSet.Nil) fallback]
    [(OptLabelSet.Dense _ _) (opt-label-ref labels 0)]))

(define (opt-bool-branch-chain-prefix
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [remove : (Array bool)]) : CompilerIrInstrList
  (if (>= index last)
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      [tail : CompilerIrInstrList
        (opt-bool-branch-chain-prefix instrs (+ index 1) last remove)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (and
            (>= dst 0)
            (< dst (array-length remove))
            (array-ref remove dst))
            tail
            (compiler-ir-instr-cons instr tail))]
        [(option_i64.None) (compiler-ir-instr-cons instr tail)]))))

(define (opt-bool-branch-chain-conj-var [instr : CompilerIrInstr]) : i64
  (match instr
    [(CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [_ (- 0 1)]))

(define (opt-bool-branch-chain-fresh-blocks
  [conjs : CompilerIrInstrList]
  [labels : OptLabelSet]
  [true-label : i64]
  [false-label : i64]) : CompilerIrBlockList
  (match conjs
    [(CompilerIrInstrList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrInstrList.Cons conj conj-rest)
      (match labels
        [(OptLabelSet.Nil) (CompilerIrBlockList.Nil)]
        [(OptLabelSet.Dense _ _)
          (let
            [label : i64 (opt-label-ref labels 0)]
            [label-rest : OptLabelSet (opt-label-tail labels)]
            [next-label : i64
              (opt-bool-branch-chain-first-label label-rest true-label)]
            (compiler-ir-block-cons
              (compiler-ir-block
                label
                (compiler-ir-instr-cons
                  conj
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Branch
                      (CompilerIrValue.Var
                        (opt-bool-branch-chain-conj-var conj))
                      next-label
                      false-label)
                    (CompilerIrInstrList.Nil))))
              (opt-bool-branch-chain-fresh-blocks
                (box-get conj-rest)
                label-rest
                true-label
                false-label)))])]))

(define (opt-bool-branch-chain-prepend-blocks
  [prefix : CompilerIrBlockList]
  [tail : CompilerIrBlockList]) : CompilerIrBlockList
  (match prefix
    [(CompilerIrBlockList.Nil) tail]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        block
        (opt-bool-branch-chain-prepend-blocks (box-get rest) tail))]
    [(CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-prepend-blocks
        (compiler-ir-block-seq-to-list seq)
        tail)]))

(define (opt-bool-branch-chain-replace-block
  [blocks : CompilerIrBlockList]
  [source-label : i64]
  [source : CompilerIrBlock]
  [fresh : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (if (= label source-label)
            (compiler-ir-block-cons
              source
              (opt-bool-branch-chain-prepend-blocks fresh (box-get rest)))
            (compiler-ir-block-cons
              block
              (opt-bool-branch-chain-replace-block
                (box-get rest)
                source-label
                source
                fresh)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-replace-block
        (compiler-ir-block-seq-to-list seq)
        source-label
        source
        fresh)]))

(define (opt-bool-branch-chain-phi-inputs-have-none-except?
  [inputs : CompilerIrPhiInputList]
  [labels : OptLabelSet]
  [old-label : i64]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (and
          (if (= label old-label)
            true
            (not (opt-bool-branch-phi-input-has-label? inputs label)))
          (opt-bool-branch-chain-phi-inputs-have-none-except?
            inputs
            (opt-label-tail labels)
            old-label)))]))

(define (opt-bool-branch-chain-target-phis-repairable-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [old-label : i64]
  [new-preds : OptLabelSet]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ inputs _)
        (and
          (opt-bool-branch-phi-input-has-label? inputs old-label)
          (opt-bool-branch-chain-phi-inputs-have-none-except?
            inputs
            new-preds
            old-label)
          (opt-bool-branch-chain-target-phis-repairable-from?
            instrs
            (+ index 1)
            old-label
            new-preds))]
      [_ true])))

(define (opt-bool-branch-chain-target-phis-repairable?
  [blocks : CompilerIrBlockList]
  [target-label : i64]
  [old-label : i64]
  [new-preds : OptLabelSet]) : bool
  (match (opt-cfg-find-block blocks target-label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-bool-branch-chain-target-phis-repairable-from?
            instrs
            0
            old-label
            new-preds)])]))

(define (opt-bool-branch-chain-try-block
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [defs : (Array OptBoolBranchDef)]
  [uses : (Array i64)]
  [block : CompilerIrBlock]) : OptBoolBranchChainRewrite
  (match block
    [(CompilerIrBlock.Block source-label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (<= count 0)
          (OptBoolBranchChainRewrite.No)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Branch
                (CompilerIrValue.Var root)
                true-label
                false-label)
              (if (or (= source-label true-label) (= source-label false-label))
                (OptBoolBranchChainRewrite.No)
                (match (opt-bool-branch-def defs root)
                  [(OptBoolBranchDef.No) (OptBoolBranchChainRewrite.No)]
                  [(OptBoolBranchDef.Some root-instr _)
                    (match root-instr
                      [(CompilerIrInstr.BinOp _ root-op _ _ _)
                        (let
                          [and-root? : bool
                            (match root-op
                              [(CompilerIrBinOp.And) true]
                              [_ false])]
                          (if (not and-root?)
                            (OptBoolBranchChainRewrite.No)
                            (let
                              [refs : (Array i64) (opt-used-array-new frame)]
                              [visited : (Array bool)
                                (array.make-array bool frame)]
                              [collected? : bool
                                (opt-bool-branch-chain-collect-value!
                                  type-segment-bases
                                  defs
                                  refs
                                  visited
                                  (CompilerIrValue.Var root))]
                              (if (or
                                (not collected?)
                                (not
                                  (opt-bool-branch-chain-uses-ok-from?
                                    defs
                                    uses
                                    refs
                                    visited
                                    0)))
                                (OptBoolBranchChainRewrite.No)
                                (let
                                  [expanded : (Array bool)
                                    (array.make-array bool frame)]
                                  [emitted : (Array bool)
                                    (array.make-array bool frame)]
                                  [remove : (Array bool)
                                    (array.make-array bool frame)]
                                  [_expanded : unit
                                    (opt-cfg-fill-bool! expanded frame false)]
                                  [_emitted : unit
                                    (opt-cfg-fill-bool! emitted frame false)]
                                  [_remove : unit
                                    (opt-cfg-fill-bool! remove frame false)]
                                  [cell : (Array i64) (array.make-array i64 1)]
                                  [_cell : unit (array-set! cell 0 frame)]
                                  [built : OptBoolBranchConjBuild
                                    (opt-bool-branch-chain-flatten-value
                                      defs
                                      uses
                                      refs
                                      expanded
                                      emitted
                                      remove
                                      source-label
                                      cell
                                      (CompilerIrValue.Var root))]
                                  (match built
                                    [(OptBoolBranchConjBuild.No)
                                      (OptBoolBranchChainRewrite.No)]
                                    [(OptBoolBranchConjBuild.Some conjs)
                                      (match conjs
                                        [(CompilerIrInstrList.Nil)
                                          (OptBoolBranchChainRewrite.No)]
                                        [(CompilerIrInstrList.Cons first rest)
                                          (let
                                            [labels : OptLabelSet
                                              (opt-bool-branch-chain-labels
                                                blocks
                                                source-label
                                                (-
                                                  (opt-bool-branch-chain-conj-count
                                                    conjs)
                                                  1)
                                                0
                                                (OptLabelSet.Nil))]
                                            [false-preds : OptLabelSet
                                              (opt-bool-branch-chain-label-set
                                                labels
                                                (opt-label-add
                                                  (OptLabelSet.Nil)
                                                  source-label))]
                                            [true-preds : OptLabelSet
                                              (opt-label-add
                                                (OptLabelSet.Nil)
                                                (opt-bool-branch-chain-last-label
                                                  labels
                                                  source-label))]
                                            [same-target? : bool
                                              (= true-label false-label)]
                                            [all-preds : OptLabelSet
                                              (if same-target?
                                                false-preds
                                                (OptLabelSet.Nil))]
                                            (if (if same-target?
                                              (not
                                                (opt-bool-branch-chain-target-phis-repairable?
                                                  blocks
                                                  true-label
                                                  source-label
                                                  all-preds))
                                              (or
                                                (not
                                                  (opt-bool-branch-chain-target-phis-repairable?
                                                    blocks
                                                    true-label
                                                    source-label
                                                    true-preds))
                                                (not
                                                  (opt-bool-branch-chain-target-phis-repairable?
                                                    blocks
                                                    false-label
                                                    source-label
                                                    false-preds))))
                                              (OptBoolBranchChainRewrite.No)
                                              (let
                                                [source-prefix : CompilerIrInstrList
                                                  (opt-bool-branch-chain-prefix
                                                    instrs
                                                    0
                                                    (- count 1)
                                                    remove)]
                                                [source : CompilerIrBlock
                                                  (compiler-ir-block
                                                    source-label
                                                    (opt-aggregate-instr-list-append
                                                      source-prefix
                                                      (compiler-ir-instr-cons
                                                        first
                                                        (compiler-ir-instr-cons
                                                          (CompilerIrInstr.Branch
                                                            (CompilerIrValue.Var
                                                              (opt-bool-branch-chain-conj-var
                                                                first))
                                                            (opt-bool-branch-chain-first-label
                                                              labels
                                                              true-label)
                                                            false-label)
                                                          (CompilerIrInstrList.Nil)))))]
                                                [fresh : CompilerIrBlockList
                                                  (opt-bool-branch-chain-fresh-blocks
                                                    (box-get rest)
                                                    labels
                                                    true-label
                                                    false-label)]
                                                (begin
                                                  (if same-target?
                                                    (opt-bool-branch-repair-target-phis!
                                                      blocks
                                                      true-label
                                                      source-label
                                                      all-preds)
                                                    (begin
                                                      (opt-bool-branch-repair-target-phis!
                                                        blocks
                                                        true-label
                                                        source-label
                                                        true-preds)
                                                      (opt-bool-branch-repair-target-phis!
                                                        blocks
                                                        false-label
                                                        source-label
                                                        false-preds)))
                                                  (OptBoolBranchChainRewrite.Some
                                                    (opt-bool-branch-chain-replace-block
                                                      blocks
                                                      source-label
                                                      source
                                                      fresh)
                                                    (array-ref cell 0))))))])]))))))]
                      [_ (OptBoolBranchChainRewrite.No)])]))]
            [_ (OptBoolBranchChainRewrite.No)])))]))

(define (opt-bool-branch-chain-first-list
  [type-segment-bases : i64]
  [all-blocks : CompilerIrBlockList]
  [frame : i64]
  [defs : (Array OptBoolBranchDef)]
  [uses : (Array i64)]
  [blocks : CompilerIrBlockList]) : OptBoolBranchChainRewrite
  (match blocks
    [(CompilerIrBlockList.Nil) (OptBoolBranchChainRewrite.No)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-bool-branch-chain-try-block
        type-segment-bases
        all-blocks
        frame
        defs
        uses
        block)
        [(OptBoolBranchChainRewrite.Some next next-frame)
          (OptBoolBranchChainRewrite.Some next next-frame)]
        [(OptBoolBranchChainRewrite.No)
          (opt-bool-branch-chain-first-list
            type-segment-bases
            all-blocks
            frame
            defs
            uses
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-first-list
        type-segment-bases
        all-blocks
        frame
        defs
        uses
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-bool-branch-chain-blocks-raw
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [remaining : i64]) : OptBoolBranchChainResult
  (if (<= remaining 0)
    (OptBoolBranchChainResult.Result blocks frame false)
    (let
      [defs : (Array OptBoolBranchDef) (opt-bool-branch-defs frame blocks)]
      [uses : (Array i64) (opt-collect-blocks-uses-array frame blocks)]
      (match (opt-bool-branch-chain-first-list
        type-segment-bases
        blocks
        frame
        defs
        uses
        blocks)
        [(OptBoolBranchChainRewrite.No)
          (OptBoolBranchChainResult.Result blocks frame false)]
        [(OptBoolBranchChainRewrite.Some next next-frame)
          (match (opt-bool-branch-chain-blocks-raw
            type-segment-bases
            next
            next-frame
            (- remaining 1))
            [(OptBoolBranchChainResult.Result final final-frame _)
              (OptBoolBranchChainResult.Result final final-frame true)])]))))

(define (opt-bool-branch-phi-inputs [inputs : CompilerIrPhiInputList]) : OptBoolBranchPhiInputs
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Cons first first-label first-rest)
      (match (compiler-ir-phi-input-list-force-cons (box-get first-rest))
        [(CompilerIrPhiInputList.Cons second second-label second-rest)
          (match (compiler-ir-phi-input-list-force-cons (box-get second-rest))
            [(CompilerIrPhiInputList.Nil)
              (OptBoolBranchPhiInputs.Two first first-label second second-label)]
            [_ (OptBoolBranchPhiInputs.No)])]
        [_ (OptBoolBranchPhiInputs.No)])]
    [_ (OptBoolBranchPhiInputs.No)]))

(define (opt-bool-branch-constant-inputs-acc
  [inputs : CompilerIrPhiInputList]
  [true-preds : OptLabelSet]
  [false-preds : OptLabelSet]
  [count : i64]) : OptBoolBranchConstantInputs
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil)
      (OptBoolBranchConstantInputs.Some true-preds false-preds count)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bool-branch-constant-inputs-acc
        (compiler-ir-phi-input-seq-to-list seq)
        true-preds
        false-preds
        count)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (or
        (opt-label-contains true-preds label)
        (opt-label-contains false-preds label))
        (OptBoolBranchConstantInputs.No)
        (match value
          [(CompilerIrValue.Bool known)
            (opt-bool-branch-constant-inputs-acc
              (box-get rest)
              (if known
                (opt-label-add true-preds label)
                true-preds)
              (if known
                false-preds
                (opt-label-add false-preds label))
              (+ count 1))]
          [_ (OptBoolBranchConstantInputs.No)]))]))

(define (opt-bool-branch-constant-inputs [inputs : CompilerIrPhiInputList]) : OptBoolBranchConstantInputs
  (opt-bool-branch-constant-inputs-acc
    inputs
    (OptLabelSet.Nil)
    (OptLabelSet.Nil)
    0))

(define (opt-bool-branch-label-union [from : OptLabelSet] [into : OptLabelSet]) : OptLabelSet
  (match from
    [(OptLabelSet.Nil) into]
    [(OptLabelSet.Dense _ _)
      (opt-bool-branch-label-union
        (opt-label-tail from)
        (opt-label-add into (opt-label-ref from 0)))]))

(define (opt-bool-branch-pred-constant-rewriteable?
  [blocks : CompilerIrBlockList]
  [merge-label : i64]
  [pred-label : i64]) : bool
  (match (opt-cfg-find-block blocks pred-label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (and
              (> count 0)
              (match (compiler-ir-instr-seq-ref instrs (- count 1))
                [(CompilerIrInstr.Jump target) (= target merge-label)]
                [_ false])))])]))

(define (opt-bool-branch-preds-constant-rewriteable?
  [blocks : CompilerIrBlockList]
  [merge-label : i64]
  [preds : OptLabelSet]) : bool
  (match preds
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [pred-label : i64 (opt-label-ref preds 0)]
        (and
          (opt-bool-branch-pred-constant-rewriteable?
            blocks
            merge-label
            pred-label)
          (opt-bool-branch-preds-constant-rewriteable?
            blocks
            merge-label
            (opt-label-tail preds))))]))

(define (opt-bool-branch-phi-input-has-label?
  [inputs : CompilerIrPhiInputList]
  [needle : i64]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) false]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bool-branch-phi-input-has-label?
        (compiler-ir-phi-input-seq-to-list seq)
        needle)]
    [(CompilerIrPhiInputList.Cons _ label rest)
      (if (= label needle)
        true
        (opt-bool-branch-phi-input-has-label? (box-get rest) needle))]))

(define (opt-bool-branch-phi-inputs-have-none?
  [inputs : CompilerIrPhiInputList]
  [labels : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (and
          (not (opt-bool-branch-phi-input-has-label? inputs label))
          (opt-bool-branch-phi-inputs-have-none? inputs (opt-label-tail labels))))]))

(define (opt-bool-branch-target-phis-repairable-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ inputs _)
        (and
          (opt-bool-branch-phi-input-has-label? inputs merge-label)
          (opt-bool-branch-phi-inputs-have-none? inputs new-preds)
          (opt-bool-branch-target-phis-repairable-from?
            instrs
            (+ index 1)
            merge-label
            new-preds))]
      [_ true])))

(define (opt-bool-branch-target-phis-repairable?
  [blocks : CompilerIrBlockList]
  [target-label : i64]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : bool
  (match (opt-cfg-find-block blocks target-label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-bool-branch-target-phis-repairable-from?
            instrs
            0
            merge-label
            new-preds)])]))

(define (opt-bool-branch-prepend-phi-inputs
  [value : CompilerIrValue]
  [preds : OptLabelSet]
  [tail : CompilerIrPhiInputList]) : CompilerIrPhiInputList
  (match preds
    [(OptLabelSet.Nil) tail]
    [(OptLabelSet.Dense _ _)
      (compiler-ir-phi-input-cons
        value
        (opt-label-ref preds 0)
        (opt-bool-branch-prepend-phi-inputs value (opt-label-tail preds) tail))]))

(define (opt-bool-branch-repair-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bool-branch-repair-phi-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        merge-label
        new-preds)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : CompilerIrPhiInputList
          (opt-bool-branch-repair-phi-inputs
            (box-get rest)
            merge-label
            new-preds)]
        (if (= label merge-label)
          (opt-bool-branch-prepend-phi-inputs value new-preds tail)
          (compiler-ir-phi-input-cons value label tail)))]))

(define (opt-bool-branch-repair-target-phis-from!
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : unit
  (if (< index (compiler-ir-instr-seq-count instrs))
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi dst inputs ty)
        (begin
          (compiler-ir-instr-seq-set!
            instrs
            index
            (CompilerIrInstr.Phi
              dst
              (opt-bool-branch-repair-phi-inputs inputs merge-label new-preds)
              ty))
          (opt-bool-branch-repair-target-phis-from!
            instrs
            (+ index 1)
            merge-label
            new-preds))]
      [_ unit])
    unit))

(define (opt-bool-branch-repair-target-phis!
  [blocks : CompilerIrBlockList]
  [target-label : i64]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : unit
  (match (opt-cfg-find-block blocks target-label)
    [(OptMaybeBlock.No) unit]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-bool-branch-repair-target-phis-from!
            instrs
            0
            merge-label
            new-preds)])]))

(define (opt-bool-branch-apply-constant-pred-rewrites!
  [blocks : CompilerIrBlockList]
  [preds : OptLabelSet]
  [target-label : i64]) : unit
  (match preds
    [(OptLabelSet.Nil) unit]
    [(OptLabelSet.Dense _ _)
      (let
        [pred-label : i64 (opt-label-ref preds 0)]
        (begin
          (match (opt-cfg-find-block blocks pred-label)
            [(OptMaybeBlock.No) unit]
            [(OptMaybeBlock.Some block)
              (match block
                [(CompilerIrBlock.Block _ instrs)
                  (let
                    [last : i64 (- (compiler-ir-instr-seq-count instrs) 1)]
                    (compiler-ir-instr-seq-set!
                      instrs
                      last
                      (CompilerIrInstr.Jump target-label)))])])
          (opt-bool-branch-apply-constant-pred-rewrites!
            blocks
            (opt-label-tail preds)
            target-label)))]))

(define (opt-bool-branch-fuse-constant-phi!
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (Array i64)]
  [merge-label : i64]
  [dst : i64]
  [inputs : CompilerIrPhiInputList]
  [ty : AstType]
  [cond-var : i64]
  [true-label : i64]
  [false-label : i64]) : bool
  (if (or
    (not (= dst cond-var))
    (not (= (opt-bool-branch-use-count uses dst) 1))
    (not (opt-type-eq type-segment-bases ty (AstType.Bool)))
    (= merge-label true-label)
    (= merge-label false-label))
    false
    (match (opt-bool-branch-constant-inputs inputs)
      [(OptBoolBranchConstantInputs.No) false]
      [(OptBoolBranchConstantInputs.Some true-preds false-preds input-count)
        (let
          [preds : OptLabelSet (opt-cfg-index-predecessors index merge-label)]
          [same-target? : bool (= true-label false-label)]
          [all-preds : OptLabelSet
            (opt-bool-branch-label-union true-preds false-preds)]
          (if (or
            (<= input-count 0)
            (not (= input-count (opt-label-count preds)))
            (not (opt-label-set-eq? all-preds preds))
            (not
              (opt-bool-branch-preds-constant-rewriteable?
                blocks
                merge-label
                true-preds))
            (not
              (opt-bool-branch-preds-constant-rewriteable?
                blocks
                merge-label
                false-preds))
            (if same-target?
              (not
                (opt-bool-branch-target-phis-repairable?
                  blocks
                  true-label
                  merge-label
                  all-preds))
              (or
                (not
                  (opt-bool-branch-target-phis-repairable?
                    blocks
                    true-label
                    merge-label
                    true-preds))
                (not
                  (opt-bool-branch-target-phis-repairable?
                    blocks
                    false-label
                    merge-label
                    false-preds)))))
            false
            (begin
              (opt-bool-branch-apply-constant-pred-rewrites!
                blocks
                true-preds
                true-label)
              (opt-bool-branch-apply-constant-pred-rewrites!
                blocks
                false-preds
                false-label)
              (if same-target?
                (opt-bool-branch-repair-target-phis!
                  blocks
                  true-label
                  merge-label
                  all-preds)
                (begin
                  (opt-bool-branch-repair-target-phis!
                    blocks
                    true-label
                    merge-label
                    true-preds)
                  (opt-bool-branch-repair-target-phis!
                    blocks
                    false-label
                    merge-label
                    false-preds)))
              true)))])))

(define (opt-bool-branch-target-has-phi?
  [blocks : CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (= (compiler-ir-instr-seq-count instrs) 0)
            false
            (match (compiler-ir-instr-seq-ref instrs 0)
              [(CompilerIrInstr.Phi _ _ _) true]
              [_ false]))])]
    [(OptMaybeBlock.No) true]))

(define (opt-bool-branch-pred-rewrite
  [blocks : CompilerIrBlockList]
  [merge-label : i64]
  [value : CompilerIrValue]
  [pred-label : i64]
  [true-label : i64]
  [false-label : i64]) : OptBoolBranchPredRewrite
  (match (opt-cfg-find-block blocks pred-label)
    [(OptMaybeBlock.No) (OptBoolBranchPredRewrite.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (if (= count 0)
              (OptBoolBranchPredRewrite.No)
              (match (compiler-ir-instr-seq-ref instrs (- count 1))
                [(CompilerIrInstr.Jump target)
                  (if (not (= target merge-label))
                    (OptBoolBranchPredRewrite.No)
                    (match value
                      [(CompilerIrValue.Bool known)
                        (OptBoolBranchPredRewrite.Some
                          instrs
                          (- count 1)
                          (CompilerIrInstr.Jump
                            (if known
                              true-label
                              false-label))
                          false)]
                      [(CompilerIrValue.Var cond-var)
                        (if (< count 2)
                          (OptBoolBranchPredRewrite.No)
                          (match (compiler-ir-instr-seq-ref instrs (- count 2))
                            [(CompilerIrInstr.BinOp dst op _ _ ty)
                              (if (and
                                (= dst cond-var)
                                (opt-bool-branch-compare-op? op))
                                (OptBoolBranchPredRewrite.Some
                                  instrs
                                  (- count 1)
                                  (CompilerIrInstr.Branch
                                    value
                                    true-label
                                    false-label)
                                  true)
                                (OptBoolBranchPredRewrite.No))]
                            [_ (OptBoolBranchPredRewrite.No)]))]
                      [_ (OptBoolBranchPredRewrite.No)]))]
                [_ (OptBoolBranchPredRewrite.No)])))])]))

(define (opt-bool-branch-apply-rewrites!
  [first : OptBoolBranchPredRewrite]
  [second : OptBoolBranchPredRewrite]) : bool
  (match first
    [(OptBoolBranchPredRewrite.No) false]
    [(OptBoolBranchPredRewrite.Some
        first-instrs
        first-pos
        first-term
        first-compare)
      (match second
        [(OptBoolBranchPredRewrite.No) false]
        [(OptBoolBranchPredRewrite.Some
            second-instrs
            second-pos
            second-term
            second-compare)
          (if (not (or first-compare second-compare))
            false
            (begin
              (compiler-ir-instr-seq-set! first-instrs first-pos first-term)
              (compiler-ir-instr-seq-set! second-instrs second-pos second-term)
              true))])]))

(define (opt-bool-branch-fuse-compare-phi!
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (Array i64)]
  [merge-label : i64]
  [dst : i64]
  [inputs : CompilerIrPhiInputList]
  [ty : AstType]
  [cond-var : i64]
  [true-label : i64]
  [false-label : i64]) : bool
  (if (or
    (not (= dst cond-var))
    (not (= (opt-bool-branch-use-count uses dst) 1))
    (not (opt-type-eq type-segment-bases ty (AstType.Bool)))
    (= merge-label true-label)
    (= merge-label false-label)
    (opt-bool-branch-target-has-phi? blocks true-label)
    (opt-bool-branch-target-has-phi? blocks false-label))
    false
    (match (opt-bool-branch-phi-inputs inputs)
      [(OptBoolBranchPhiInputs.No) false]
      [(OptBoolBranchPhiInputs.Two first first-label second second-label)
        (let
          [preds : OptLabelSet (opt-cfg-index-predecessors index merge-label)]
          (if (or
            (= first-label second-label)
            (not (= (opt-label-count preds) 2))
            (not (opt-label-contains preds first-label))
            (not (opt-label-contains preds second-label)))
            false
            (opt-bool-branch-apply-rewrites!
              (opt-bool-branch-pred-rewrite
                blocks
                merge-label
                first
                first-label
                true-label
                false-label)
              (opt-bool-branch-pred-rewrite
                blocks
                merge-label
                second
                second-label
                true-label
                false-label))))])))

(define (opt-bool-branch-fuse-phi!
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (Array i64)]
  [merge-label : i64]
  [dst : i64]
  [inputs : CompilerIrPhiInputList]
  [ty : AstType]
  [cond-var : i64]
  [true-label : i64]
  [false-label : i64]) : bool
  (if (opt-bool-branch-fuse-constant-phi!
    type-segment-bases
    blocks
    index
    uses
    merge-label
    dst
    inputs
    ty
    cond-var
    true-label
    false-label)
    true
    (opt-bool-branch-fuse-compare-phi!
      type-segment-bases
      blocks
      index
      uses
      merge-label
      dst
      inputs
      ty
      cond-var
      true-label
      false-label)))

(define (opt-bool-branch-fuse-block!
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (Array i64)]
  [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block merge-label instrs)
      (if (not (= (compiler-ir-instr-seq-count instrs) 2))
        false
        (match (compiler-ir-instr-seq-ref instrs 0)
          [(CompilerIrInstr.Phi dst inputs ty)
            (match (compiler-ir-instr-seq-ref instrs 1)
              [(CompilerIrInstr.Branch
                  (CompilerIrValue.Var cond-var)
                  true-label
                  false-label)
                (opt-bool-branch-fuse-phi!
                  type-segment-bases
                  blocks
                  index
                  uses
                  merge-label
                  dst
                  inputs
                  ty
                  cond-var
                  true-label
                  false-label)]
              [_ false])]
          [_ false]))]))

(define (opt-bool-branch-fuse-first-list!
  [type-segment-bases : i64]
  [all-blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (Array i64)]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-bool-branch-fuse-block!
        type-segment-bases
        all-blocks
        index
        uses
        block)
        true
        (opt-bool-branch-fuse-first-list!
          type-segment-bases
          all-blocks
          index
          uses
          (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (let
        [pos : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (begin
          (while (< pos count)
            (if (opt-bool-branch-fuse-block!
              type-segment-bases
              all-blocks
              index
              uses
              (compiler-ir-block-seq-ref seq pos))
              (return true)
              (set! pos (+ pos 1))))
          false))]))

;; The bool-branch fuser mutates its working copy, so it clones the block
;; contents first. The clone used to go seq -> cons list -> seq: it built a
;; 112 B node per instruction and then `compiler-ir-block` re-counted the spine
;; and copied it back into an array, purely to reproduce the array it started
;; from. It is a straight row copy. refs #5726
(define (opt-bool-branch-clone-instr-seq [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [out : (Array CompilerIrInstr) (array.make-array CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set! out index (array-ref slots index))
          (set! index (+ index 1))))
      (CompilerIrInstrSeq out count))))

(define (opt-bool-branch-clone-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (CompilerIrBlock.Block
              label
              (opt-bool-branch-clone-instr-seq instrs))
            (opt-bool-branch-clone-blocks (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bool-branch-clone-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-bool-branch-fuse-blocks-raw
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [remaining : i64]) : OptBlockListPassResult
  (if (<= remaining 0)
    (OptBlockListPassResult.Result blocks false)
    (let
      [index : OptCfgIndex (opt-cfg-index-build blocks)]
      [uses : (Array i64) (opt-collect-blocks-uses-array frame blocks)]
      (if (opt-bool-branch-fuse-first-list!
        type-segment-bases
        blocks
        index
        uses
        blocks)
        (match (opt-bool-branch-fuse-blocks-raw
          type-segment-bases
          (opt-cfg-simplify-blocks blocks)
          frame
          (- remaining 1))
          [(OptBlockListPassResult.Result next _)
            (OptBlockListPassResult.Result next true)])
        (OptBlockListPassResult.Result blocks false)))))

(define (opt-bool-branch-fuse-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [remaining : i64]) : OptBlockListPassResult
  (opt-bool-branch-fuse-blocks-raw
    type-segment-bases
    (opt-bool-branch-clone-blocks blocks)
    frame
    remaining))

(define (opt-bool-branch-block-candidate?
  [type-segment-bases : i64]
  [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (and
        (= (compiler-ir-instr-seq-count instrs) 2)
        (match (compiler-ir-instr-seq-ref instrs 0)
          [(CompilerIrInstr.Phi dst _ ty)
            (and
              (opt-type-eq type-segment-bases ty (AstType.Bool))
              (match (compiler-ir-instr-seq-ref instrs 1)
                [(CompilerIrInstr.Branch (CompilerIrValue.Var cond-var) _ _)
                  (= dst cond-var)]
                [_ false]))]
          [_ false]))]))

(define (opt-bool-branch-blocks-have-candidate?
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-bool-branch-block-candidate? type-segment-bases block)
        true
        (opt-bool-branch-blocks-have-candidate?
          type-segment-bases
          (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-bool-branch-blocks-have-candidate?
        type-segment-bases
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-bool-branch-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionPassResult
  ;; The block pass mutates instruction sequences, so it always works on a deep
  ;; block/instruction clone. A failed post-pass verify can therefore return the
  ;; byte-for-byte input function instead of retaining a partial edge rewrite.
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (not
        (opt-bool-branch-blocks-have-candidate? type-segment-bases blocks))
        (OptFunctionPassResult.Result func false)
        (match (opt-verify-gate verified? func context)
          [(ResultCompilerOptimizeVerify.Err _)
            (OptFunctionPassResult.Result func false)]
          [(ResultCompilerOptimizeVerify.Ok)
            (match (opt-bool-branch-fuse-blocks
              type-segment-bases
              blocks
              frame
              16)
              [(OptBlockListPassResult.Result next-blocks changed)
                (if changed
                  (let
                    [next : CompilerIrFunction
                      (CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        frame
                        next-blocks)]
                    [next-context : OptCfgContext
                      (opt-cfg-context-build next-blocks)]
                    (match (opt-verify-function-with-context next next-context)
                      [(ResultCompilerOptimizeVerify.Ok)
                        (OptFunctionPassResult.Result next true)]
                      [(ResultCompilerOptimizeVerify.Err _)
                        (OptFunctionPassResult.Result func false)]))
                  (OptFunctionPassResult.Result func false))])]))]))

(define (opt-bool-branch-chain-instrs-define-root-and?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [root : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.BinOp dst op _ _ _)
        (if (and
          (= dst root)
          (match op
            [(CompilerIrBinOp.And) true]
            [_ false]))
          true
          (opt-bool-branch-chain-instrs-define-root-and?
            instrs
            (+ index 1)
            root))]
      [_
        (opt-bool-branch-chain-instrs-define-root-and? instrs (+ index 1) root)])))

(define (opt-bool-branch-chain-blocks-define-root-and?
  [blocks : CompilerIrBlockList]
  [root : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (or
            (opt-bool-branch-chain-instrs-define-root-and? instrs 0 root)
            (opt-bool-branch-chain-blocks-define-root-and? (box-get rest) root))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-blocks-define-root-and?
        (compiler-ir-block-seq-to-list seq)
        root)]))

(define (opt-bool-branch-chain-block-candidate?
  [all-blocks : CompilerIrBlockList]
  [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (and
          (> count 0)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Branch (CompilerIrValue.Var cond-var) _ _)
              (opt-bool-branch-chain-blocks-define-root-and?
                all-blocks
                cond-var)]
            [_ false])))]))

(define (opt-bool-branch-chain-blocks-have-candidate-from?
  [all-blocks : CompilerIrBlockList]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-bool-branch-chain-block-candidate? all-blocks block)
        true
        (opt-bool-branch-chain-blocks-have-candidate-from?
          all-blocks
          (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-blocks-have-candidate-from?
        all-blocks
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-bool-branch-chain-blocks-have-candidate?
  [blocks : CompilerIrBlockList]) : bool
  (opt-bool-branch-chain-blocks-have-candidate-from? blocks blocks))

(define (opt-bool-branch-chain-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (not (opt-bool-branch-chain-blocks-have-candidate? blocks))
        (OptFunctionPassResult.Result func false)
        (match (opt-verify-gate verified? func context)
          [(ResultCompilerOptimizeVerify.Err _)
            (OptFunctionPassResult.Result func false)]
          [(ResultCompilerOptimizeVerify.Ok)
            (match (opt-bool-branch-chain-blocks-raw
              type-segment-bases
              (opt-bool-branch-clone-blocks blocks)
              frame
              64)
              [(OptBoolBranchChainResult.Result next-blocks next-frame changed)
                (if changed
                  (let
                    [next : CompilerIrFunction
                      (CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        next-frame
                        next-blocks)]
                    [next-context : OptCfgContext
                      (opt-cfg-context-build next-blocks)]
                    (match (opt-verify-function-with-context next next-context)
                      [(ResultCompilerOptimizeVerify.Ok)
                        (OptFunctionPassResult.Result next true)]
                      [(ResultCompilerOptimizeVerify.Err _)
                        (OptFunctionPassResult.Result func false)]))
                  (OptFunctionPassResult.Result func false))])]))]))

;; --- sparse conditional constant propagation -------------------------------
;;
;; SCCP v1 runs after the local scalar simplifier. It keeps a small scalar
;; lattice for SSA vars and CFG-id-backed executable block flags. Unknown values
;; are not rewritten; overdefined values keep the original instruction; proven
;; constants rewrite value uses and scalar-producing instructions. The evaluator
;; deliberately reuses the local folding helpers above so divide/modulo/shift
;; trap preservation stays identical.
(defenum OptSccpValue
  (Unknown)
  (Const CompilerIrValue AstType)
  (Overdefined))

;; The SCCP lattice was a persistent assoc list
;; (OptSccpEnvCons id value rest) where opt-sccp-env-set rebuilt the WHOLE list on
;; every bind (via opt-sccp-env-remove) -> O(V) alloc per bind, O(V^2) per analysis
;; sweep, x fixpoint sweeps x all functions (~42s / ~12GB of the -O2 optimize
;; phase). The lattice is a single monotonically-rising map threaded linearly
;; through analysis (never branched), so it is now a mutable array indexed by var
;; id: O(1) lookup/set, no rebuild. Var ids are dense within a function; the array
;; is sized to cover every bound var (params + every instruction dst that
;; opt-sccp-process-instr binds). Out-of-range lookups return Unknown (the same
;; default the list gave for an unbound var), so the analysis result -- and the
;; folded output -- is byte-identical.
(defenum OptSccpEnv
  (Env i64 (Array OptSccpValue)))

(define (opt-sccp-env-fill-unknown!
  [slots : (Array OptSccpValue)]
  [n : i64]
  [i : i64]) : unit
  (if (>= i n)
    unit
    (begin
      (array-set! slots i (OptSccpValue.Unknown))
      (opt-sccp-env-fill-unknown! slots n (+ i 1)))))

(define (opt-sccp-env-make [cap : i64]) : OptSccpEnv
  (let
    [n : i64
      (if (< cap 1)
        1
        cap)]
    [slots : (Array OptSccpValue) (array.make-array OptSccpValue n)]
    (begin
      (opt-sccp-env-fill-unknown! slots n 0)
      (OptSccpEnv.Env n slots))))

;; Destination var bound by `opt-sccp-process-instr`, or -1 for instructions that
;; bind nothing. MUST mirror the binding arms of opt-sccp-process-instr so the
;; environment array is sized to cover every var the analysis can bind.
(define (opt-sccp-instr-dst [instr : CompilerIrInstr]) : i64
  (match instr
    [(CompilerIrInstr.Mov dst _ _) dst]
    [(CompilerIrInstr.Cast dst _ _ _) dst]
    [(CompilerIrInstr.Bitcast dst _ _ _) dst]
    [(CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [(CompilerIrInstr.UnOp dst _ _ _) dst]
    [(CompilerIrInstr.Phi dst _ _) dst]
    [(CompilerIrInstr.Alloc dst _) dst]
    [(CompilerIrInstr.AddrOf dst _) dst]
    [(CompilerIrInstr.Gep dst _ _ _) dst]
    [(CompilerIrInstr.Load dst _ _) dst]
    [(CompilerIrInstr.EntryArgc dst) dst]
    [(CompilerIrInstr.EntryArgv dst) dst]
    [(CompilerIrInstr.EntryEnvp dst) dst]
    [(CompilerIrInstr.CpuId dst _ _ _) dst]
    [(CompilerIrInstr.Xgetbv dst _) dst]
    [(CompilerIrInstr.Syscall dst _) dst]
    [(CompilerIrInstr.LaneId dst _ _) dst]
    [(CompilerIrInstr.Splat dst _ _ _) dst]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _) dst]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _) dst]
    [(CompilerIrInstr.MaskNot dst _ _) dst]
    [(CompilerIrInstr.MaskReduce dst _ _ _) dst]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _) dst]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _) dst])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _) dst])]
    [(CompilerIrInstr.TailMask dst _ _ _) dst]
    [(CompilerIrInstr.Call dst _ _ _) dst]
    [(CompilerIrInstr.CallIndirect dst _ _ _) dst]
    [(CompilerIrInstr.CallIndirectC dst _ _ _) dst]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (match result
            [(CompilerIrSpmdCallResult.Unit) (- 0 1)]
            [(CompilerIrSpmdCallResult.Value dst _ _) dst])])]
    ;; Pack/Word dsts must be counted so opt-sccp-env-make sizes the lattice
    ;; array over them; opt-sccp-env-set silently drops out-of-range writes,
    ;; which would defeat the Overdefined binding in opt-sccp-process-instr.
    [(CompilerIrInstr.Pack dst _ _) dst]
    [(CompilerIrInstr.Word dst _ _ _) dst]
    [_ (- 0 1)]))

(define (opt-sccp-max-var-instr-seq
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    acc
    (let
      [dst : i64 (opt-sccp-instr-dst (compiler-ir-instr-seq-ref instrs index))]
      (opt-sccp-max-var-instr-seq
        instrs
        (+ index 1)
        (if (> dst acc)
          dst
          acc)))))

(define (opt-sccp-max-var-blocks [blocks : CompilerIrBlockList] [acc : i64]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) acc]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-sccp-max-var-blocks
            (box-get rest)
            (opt-sccp-max-var-instr-seq instrs 0 acc))])]
    [(CompilerIrBlockList.Array seq)
      (opt-sccp-max-var-blocks (compiler-ir-block-seq-to-list seq) acc)]))

(define (opt-sccp-max-var-params [params : CompilerIrParamList] [acc : i64]) : i64
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) acc]
    [(CompilerIrParamList.Array seq)
      (opt-sccp-max-var-params (compiler-ir-param-seq-to-list seq) acc)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ id)
          (opt-sccp-max-var-params
            (box-get rest)
            (if (> id acc)
              id
              acc))])]))

(defenum OptSccpState
  ;; The type segment-bases scalar belongs to this analysis instance. Carrying
  ;; it in the already-threaded state keeps SCCP isolated without adding a
  ;; redundant argument to every per-instruction lattice bind.
  (State OptCfgIndex (Array bool) OptSccpEnv bool i64))

(define (opt-sccp-value-eq
  [type-segment-bases : i64]
  [a : OptSccpValue]
  [b : OptSccpValue]) : bool
  (match a
    [(OptSccpValue.Unknown)
      (match b
        [(OptSccpValue.Unknown) true]
        [_ false])]
    [(OptSccpValue.Overdefined)
      (match b
        [(OptSccpValue.Overdefined) true]
        [_ false])]
    [(OptSccpValue.Const av aty)
      (match b
        [(OptSccpValue.Const bv bty)
          (and (opt-value-eq av bv) (opt-type-eq type-segment-bases aty bty))]
        [_ false])]))

(define (opt-sccp-join
  [type-segment-bases : i64]
  [old : OptSccpValue]
  [new : OptSccpValue]) : OptSccpValue
  (match old
    [(OptSccpValue.Unknown) new]
    [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]
    [(OptSccpValue.Const old-value old-ty)
      (match new
        [(OptSccpValue.Unknown) old]
        [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]
        [(OptSccpValue.Const new-value new-ty)
          (if (and
            (opt-value-eq old-value new-value)
            (opt-type-eq type-segment-bases old-ty new-ty))
            old
            (OptSccpValue.Overdefined))])]))

(define (opt-sccp-env-lookup [env : OptSccpEnv] [var : i64]) : OptSccpValue
  (match env
    [(OptSccpEnv.Env cap slots)
      (if (if (>= var 0)
        (< var cap)
        false)
        (array-ref slots var)
        (OptSccpValue.Unknown))]))

;; Whether any lattice slot still holds a Const at analysis end.
;; opt-sccp-rewrite-value substitutes only OptSccpValue.Const hits, so when
;; this is false the whole rewrite is the identity and the caller can skip
;; rebuilding every block. Read once at analysis end: equivalent to tracking
;; an any-const flag through the opt-sccp-env-set bind sites, but exact
;; rather than conservative -- a Const later joined to Overdefined does not
;; keep the rewrite alive.
(define (opt-sccp-env-any-const? [env : OptSccpEnv] [index : i64]) : bool
  (match env
    [(OptSccpEnv.Env cap slots)
      (if (>= index cap)
        false
        (match (array-ref slots index)
          [(OptSccpValue.Const _ _) true]
          [_ (opt-sccp-env-any-const? env (+ index 1))]))]))

;; Mutates the shared lattice array in place and returns the same env. The
;; environment is threaded linearly through the monotone analysis, so in-place
;; update is observationally identical to the old persistent cons/remove.
(define (opt-sccp-env-set [env : OptSccpEnv] [var : i64] [value : OptSccpValue]) : OptSccpEnv
  (match env
    [(OptSccpEnv.Env cap slots)
      (begin
        (if (if (>= var 0)
          (< var cap)
          false)
          (array-set! slots var value)
          unit)
        env)]))

(define (opt-sccp-state-bind
  [state : OptSccpState]
  [var : i64]
  [value : OptSccpValue]) : OptSccpState
  (match state
    [(OptSccpState.State cfg-index executable env changed type-segment-bases)
      (let
        [old : OptSccpValue (opt-sccp-env-lookup env var)]
        [merged : OptSccpValue (opt-sccp-join type-segment-bases old value)]
        (if (opt-sccp-value-eq type-segment-bases old merged)
          state
          (OptSccpState.State
            cfg-index
            executable
            (opt-sccp-env-set env var merged)
            true
            type-segment-bases)))]))

(define (opt-sccp-state-mark-executable [state : OptSccpState] [label : i64]) : OptSccpState
  (match state
    [(OptSccpState.State cfg-index executable env changed type-segment-bases)
      (match (opt-cfg-index-id cfg-index label)
        [(option_i64.Some id)
          (if (and (>= id 0) (< id (array-length executable)))
            (if (array-ref executable id)
              state
              (begin
                (array-set! executable id true)
                (OptSccpState.State
                  cfg-index
                  executable
                  env
                  true
                  type-segment-bases)))
            state)]
        [(option_i64.None) state])]))

(define (opt-sccp-state-reset-changed [state : OptSccpState]) : OptSccpState
  (match state
    [(OptSccpState.State cfg-index executable env _ type-segment-bases)
      (OptSccpState.State cfg-index executable env false type-segment-bases)]))

(define (opt-sccp-immediate [value : CompilerIrValue] [ty : AstType]) : OptSccpValue
  (match (opt-normalize-const value (opt-default-immediate-type value ty))
    [(OptKnownConst.SomeConst folded folded-ty)
      (OptSccpValue.Const folded folded-ty)]
    [(OptKnownConst.NoConst) (OptSccpValue.Overdefined)]))

(define (opt-sccp-value
  [state : OptSccpState]
  [value : CompilerIrValue]
  [ty : AstType]) : OptSccpValue
  (match state
    [(OptSccpState.State _ _ env _ _)
      (match value
        [(CompilerIrValue.Var id) (opt-sccp-env-lookup env id)]
        [_ (opt-sccp-immediate value ty)])]))

(define (opt-sccp-fold-cast-value
  [src : OptSccpValue]
  [from-ty : AstType]
  [to-ty : AstType]) : OptSccpValue
  (match src
    [(OptSccpValue.Unknown) (OptSccpValue.Unknown)]
    [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]
    [(OptSccpValue.Const value ty)
      (match (opt-fold-cast (OptKnownConst.SomeConst value ty) from-ty to-ty)
        [(CompilerIrMaybeValue.Some folded) (OptSccpValue.Const folded to-ty)]
        [(CompilerIrMaybeValue.No) (OptSccpValue.Overdefined)])]))

(define (opt-sccp-fold-binop-value
  [type-segment-bases : i64]
  [op : CompilerIrBinOp]
  [lhs : OptSccpValue]
  [rhs : OptSccpValue]
  [ty : AstType]) : OptSccpValue
  (match lhs
    [(OptSccpValue.Const lhs-value lhs-ty)
      (match rhs
        [(OptSccpValue.Const rhs-value rhs-ty)
          (match (opt-fold-binop
            type-segment-bases
            op
            (OptKnownConst.SomeConst lhs-value lhs-ty)
            (OptKnownConst.SomeConst rhs-value rhs-ty)
            ty)
            [(CompilerIrMaybeValue.Some folded) (OptSccpValue.Const folded ty)]
            [(CompilerIrMaybeValue.No) (OptSccpValue.Overdefined)])]
        [(OptSccpValue.Unknown) (OptSccpValue.Unknown)]
        [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)])]
    [(OptSccpValue.Unknown) (OptSccpValue.Unknown)]
    [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]))

(define (opt-sccp-fold-unop-value
  [op : CompilerIrUnOp]
  [src : OptSccpValue]
  [ty : AstType]) : OptSccpValue
  (match src
    [(OptSccpValue.Const value value-ty)
      (match (opt-fold-unop op (OptKnownConst.SomeConst value value-ty) ty)
        [(CompilerIrMaybeValue.Some folded) (OptSccpValue.Const folded ty)]
        [(CompilerIrMaybeValue.No) (OptSccpValue.Overdefined)])]
    [(OptSccpValue.Unknown) (OptSccpValue.Unknown)]
    [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]))

(define (opt-sccp-phi-input-value
  [state : OptSccpState]
  [value : CompilerIrValue]
  [pred : i64]
  [ty : AstType]) : OptSccpValue
  (match state
    [(OptSccpState.State cfg-index executable _ _ _)
      (match (opt-cfg-index-id cfg-index pred)
        [(option_i64.Some pred-id)
          (if (and
            (>= pred-id 0)
            (< pred-id (array-length executable))
            (array-ref executable pred-id))
            (opt-sccp-value state value ty)
            (OptSccpValue.Unknown))]
        [(option_i64.None) (OptSccpValue.Unknown)])]))

(define (opt-sccp-phi-value
  [type-segment-bases : i64]
  [state : OptSccpState]
  [inputs : CompilerIrPhiInputList]
  [ty : AstType]) : OptSccpValue
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (OptSccpValue.Unknown)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-sccp-phi-value
        type-segment-bases
        state
        (compiler-ir-phi-input-seq-to-list seq)
        ty)]
    [(CompilerIrPhiInputList.Cons value pred rest)
      (opt-sccp-join
        type-segment-bases
        (opt-sccp-phi-input-value state value pred ty)
        (opt-sccp-phi-value type-segment-bases state (box-get rest) ty))]))

(define (opt-sccp-mark-branch-targets
  [state : OptSccpState]
  [cond : CompilerIrValue]
  [true-label : i64]
  [false-label : i64]) : OptSccpState
  (match (opt-sccp-value state cond (AstType.Bool))
    [(OptSccpValue.Const value _)
      (match value
        [(CompilerIrValue.Bool known)
          (if known
            (opt-sccp-state-mark-executable state true-label)
            (opt-sccp-state-mark-executable state false-label))]
        [_
          (opt-sccp-state-mark-executable
            (opt-sccp-state-mark-executable state true-label)
            false-label)])]
    [(OptSccpValue.Overdefined)
      (opt-sccp-state-mark-executable
        (opt-sccp-state-mark-executable state true-label)
        false-label)]
    [(OptSccpValue.Unknown) state]))

(define (opt-sccp-mark-switch-targets
  [state : OptSccpState]
  [cases : CompilerIrSwitchCaseList]) : OptSccpState
  (match cases
    [(CompilerIrSwitchCaseList.Nil) state]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case _ label)
          (opt-sccp-mark-switch-targets
            (opt-sccp-state-mark-executable state label)
            (box-get rest))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-sccp-mark-switch-targets
        state
        (compiler-ir-switch-case-seq-to-list seq))]))

(define (opt-sccp-process-instr
  [type-segment-bases : i64]
  [state : OptSccpState]
  [instr : CompilerIrInstr]) : OptSccpState
  (match instr
    [(CompilerIrInstr.Mov dst value ty)
      (opt-sccp-state-bind state dst (opt-sccp-value state value ty))]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-fold-cast-value
          (opt-sccp-value state src from-ty)
          from-ty
          to-ty))]
    [(CompilerIrInstr.Bitcast dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-fold-binop-value
          type-segment-bases
          op
          (opt-sccp-value state lhs ty)
          (opt-sccp-value state rhs ty)
          ty))]
    [(CompilerIrInstr.UnOp dst op value ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-fold-unop-value op (opt-sccp-value state value ty) ty))]
    [(CompilerIrInstr.Phi dst inputs ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-phi-value type-segment-bases state inputs ty))]
    [(CompilerIrInstr.Jump label) (opt-sccp-state-mark-executable state label)]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (opt-sccp-mark-branch-targets state cond true-label false-label)]
    [(CompilerIrInstr.Alloc dst _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.AddrOf dst _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.Gep dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.Load dst _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.EntryArgc dst)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.EntryArgv dst)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.EntryEnvp dst)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.CpuId dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.Xgetbv dst _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.Syscall dst _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.LaneId dst _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.Splat dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.MaskNot dst _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))])]
    [(CompilerIrInstr.TailMask dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.Call dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (match result
            [(CompilerIrSpmdCallResult.Unit) state]
            [(CompilerIrSpmdCallResult.Value dst _ _)
              (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))])])]
    ;; Register-group dsts: bind Overdefined like loads/calls. Falling
    ;; into the wildcard left them OptSccpValue.Unknown forever, so a branch on a
    ;; Word-extracted enum tag marked NO successor executable and SCCP folded
    ;; match arms away at -O2 (stale-constant miscompile).
    [(CompilerIrInstr.Pack dst _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.Word dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(CompilerIrInstr.Switch _ _ cases default-label)
      (opt-sccp-mark-switch-targets
        (opt-sccp-state-mark-executable state default-label)
        cases)]
    [_ state]))

(define (opt-sccp-process-instr-seq-from
  [type-segment-bases : i64]
  [state : OptSccpState]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptSccpState
  (if (>= index (compiler-ir-instr-seq-count instrs))
    state
    (opt-sccp-process-instr-seq-from
      type-segment-bases
      (opt-sccp-process-instr
        type-segment-bases
        state
        (compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1))))

(define (opt-sccp-process-instr-seq
  [type-segment-bases : i64]
  [state : OptSccpState]
  [instrs : CompilerIrInstrSeq]) : OptSccpState
  (opt-sccp-process-instr-seq-from type-segment-bases state instrs 0))

(define (opt-sccp-process-block
  [type-segment-bases : i64]
  [state : OptSccpState]
  [block : CompilerIrBlock]
  [block-id : i64]) : OptSccpState
  (match state
    [(OptSccpState.State _ executable _ _ _)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (and
            (>= block-id 0)
            (< block-id (array-length executable))
            (array-ref executable block-id))
            (opt-sccp-process-instr-seq type-segment-bases state instrs)
            state)])]))

(define (opt-sccp-process-blocks-from
  [type-segment-bases : i64]
  [state : OptSccpState]
  [blocks : CompilerIrBlockList]
  [block-id : i64]) : OptSccpState
  (match blocks
    [(CompilerIrBlockList.Nil) state]
    [(CompilerIrBlockList.Cons block rest)
      (opt-sccp-process-blocks-from
        type-segment-bases
        (opt-sccp-process-block type-segment-bases state block block-id)
        (box-get rest)
        (+ block-id 1))]
    [(CompilerIrBlockList.Array seq)
      (opt-sccp-process-blocks-from
        type-segment-bases
        state
        (compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-sccp-env-from-params
  [params : CompilerIrParamList]
  [env : OptSccpEnv]) : OptSccpEnv
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) env]
    [(CompilerIrParamList.Array seq)
      (opt-sccp-env-from-params (compiler-ir-param-seq-to-list seq) env)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ id)
          (opt-sccp-env-from-params
            (box-get rest)
            (opt-sccp-env-set env id (OptSccpValue.Overdefined)))])]))

(define (opt-sccp-initial-state
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptSccpState
  (let
    [max-var : i64
      (opt-sccp-max-var-params params (opt-sccp-max-var-blocks blocks (- 0 1)))]
    [executable-count : i64
      (opt-cfg-index-block-count (struct-get context index))]
    [executable-flags : (Array bool) (array.make-array bool executable-count)]
    [_entry : unit
      (match (opt-cfg-index-id
        (struct-get context index)
        (struct-get context entry-label))
        [(option_i64.Some entry-id)
          (if (and (>= entry-id 0) (< entry-id executable-count))
            (array-set! executable-flags entry-id true)
            unit)]
        [(option_i64.None) unit])]
    (OptSccpState.State
      (struct-get context index)
      executable-flags
      (opt-sccp-env-from-params params (opt-sccp-env-make (+ max-var 1)))
      true
      type-segment-bases)))

;; Frame-sized variant: var ids are dense below the function's frame field
;; (the lowerer's next-var counter, the same invariant regalloc relies on),
;; so frame is an exact-or-larger upper bound for the walked max-var.
;; opt-sccp-env-set silently drops out-of-range writes and out-of-range
;; lookups return Unknown either way, so sizing by frame is
;; behavior-identical to sizing by the whole-function max-var walks.
(define (opt-sccp-initial-state-with-frame
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [frame : i64]) : OptSccpState
  (let
    [executable-count : i64
      (opt-cfg-index-block-count (struct-get context index))]
    [executable-flags : (Array bool) (array.make-array bool executable-count)]
    [_entry : unit
      (match (opt-cfg-index-id
        (struct-get context index)
        (struct-get context entry-label))
        [(option_i64.Some entry-id)
          (if (and (>= entry-id 0) (< entry-id executable-count))
            (array-set! executable-flags entry-id true)
            unit)]
        [(option_i64.None) unit])]
    (OptSccpState.State
      (struct-get context index)
      executable-flags
      (opt-sccp-env-from-params params (opt-sccp-env-make frame))
      true
      type-segment-bases)))

(define (opt-sccp-analyze-fixed
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [state : OptSccpState]
  [remaining : i64]) : OptSccpState
  (if (<= remaining 0)
    state
    (let
      [next : OptSccpState
        (opt-sccp-process-blocks-from
          type-segment-bases
          (opt-sccp-state-reset-changed state)
          blocks
          0)]
      (match next
        [(OptSccpState.State _ _ _ changed _)
          (if changed
            (opt-sccp-analyze-fixed
              type-segment-bases
              blocks
              next
              (- remaining 1))
            next)]))))

(define (opt-sccp-analyze
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptSccpState
  (opt-sccp-analyze-fixed
    type-segment-bases
    blocks
    (opt-sccp-initial-state type-segment-bases context params blocks)
    (+
      (+ (compiler-ir-block-list-count blocks) 8)
      (* 2 (compiler-ir-block-list-instruction-count blocks)))))

(define (opt-sccp-analyze-with-frame
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]
  [frame : i64]) : OptSccpState
  (opt-sccp-analyze-fixed
    type-segment-bases
    blocks
    (opt-sccp-initial-state-with-frame type-segment-bases context params frame)
    (+
      (+ (compiler-ir-block-list-count blocks) 8)
      (* 2 (compiler-ir-block-list-instruction-count blocks)))))

(define (opt-sccp-rewrite-value [env : OptSccpEnv] [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var id)
      (match (opt-sccp-env-lookup env id)
        [(OptSccpValue.Const folded _) folded]
        [_ value])]
    [_ value]))

(define (opt-sccp-instr-changes-successors?
  [env : OptSccpEnv]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Branch cond _ _)
      (match (opt-sccp-rewrite-value env cond)
        [(CompilerIrValue.Bool _) true]
        [_ false])]
    [_ false]))

(define (opt-sccp-instr-seq-changes-successors?
  [env : OptSccpEnv]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-sccp-instr-changes-successors?
      env
      (compiler-ir-instr-seq-ref instrs index))
      true
      (opt-sccp-instr-seq-changes-successors? env instrs (+ index 1)))))

(define (opt-sccp-block-changes-successors?
  [env : OptSccpEnv]
  [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (opt-sccp-instr-seq-changes-successors? env instrs 0)]))

(define (opt-sccp-blocks-change-successors?
  [env : OptSccpEnv]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-sccp-block-changes-successors? env block)
        true
        (opt-sccp-blocks-change-successors? env (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-sccp-blocks-change-successors?
        env
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-sccp-rewrite-maybe-value
  [env : OptSccpEnv]
  [value : CompilerIrMaybeValue]) : CompilerIrMaybeValue
  (match value
    [(CompilerIrMaybeValue.No) (CompilerIrMaybeValue.No)]
    [(CompilerIrMaybeValue.Some inner)
      (CompilerIrMaybeValue.Some (opt-sccp-rewrite-value env inner))]))

(define (opt-sccp-rewrite-call-args-array
  [env : OptSccpEnv]
  [src : (Array CompilerIrValue)]
  [dst : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set! dst index (opt-sccp-rewrite-value env (array-ref src index)))
      (opt-sccp-rewrite-call-args-array env src dst (+ index 1)))))

(define (opt-sccp-rewrite-call-args
  [env : OptSccpEnv]
  [args : CompilerIrCallArgs]) : CompilerIrCallArgs
  (match args
    [(CompilerIrCallArgs.Nil) (CompilerIrCallArgs.Nil)]
    [(CompilerIrCallArgs.One value)
      (CompilerIrCallArgs.One (opt-sccp-rewrite-value env value))]
    [(CompilerIrCallArgs.Two a b)
      (CompilerIrCallArgs.Two
        (opt-sccp-rewrite-value env a)
        (opt-sccp-rewrite-value env b))]
    [(CompilerIrCallArgs.Array values)
      (let
        [out : (Array CompilerIrValue)
          (array.make-array CompilerIrValue (array-length values))]
        (begin
          (opt-sccp-rewrite-call-args-array env values out 0)
          (CompilerIrCallArgs.Array out)))]))

(define (opt-sccp-rewrite-spmd-call-arg
  [env : OptSccpEnv]
  [arg : CompilerIrSpmdCallArg]) : CompilerIrSpmdCallArg
  (match arg
    [(CompilerIrSpmdCallArg.Arg class value ty)
      (CompilerIrSpmdCallArg.Arg class (opt-sccp-rewrite-value env value) ty)]))

(define (opt-sccp-rewrite-spmd-call-args-array
  [env : OptSccpEnv]
  [src : (Array CompilerIrSpmdCallArg)]
  [dst : (Array CompilerIrSpmdCallArg)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set!
        dst
        index
        (opt-sccp-rewrite-spmd-call-arg env (array-ref src index)))
      (opt-sccp-rewrite-spmd-call-args-array env src dst (+ index 1)))))

(define (opt-sccp-rewrite-spmd-call-args
  [env : OptSccpEnv]
  [args : CompilerIrSpmdCallArgList]) : CompilerIrSpmdCallArgList
  (match args
    [(CompilerIrSpmdCallArgList.Nil) CompilerIrSpmdCallArgList.Nil]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (CompilerIrSpmdCallArgList.Cons
        (opt-sccp-rewrite-spmd-call-arg env arg)
        (box (opt-sccp-rewrite-spmd-call-args env (box-get rest))))]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 (struct-get seq len)]
        [src : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        [out : (Array CompilerIrSpmdCallArg)
          (array.make-array CompilerIrSpmdCallArg count)]
        (begin
          (opt-sccp-rewrite-spmd-call-args-array env src out 0)
          (CompilerIrSpmdCallArgList.Array (CompilerIrSpmdCallArgSeq out count))))]))

(define (opt-sccp-rewrite-phi-inputs
  [env : OptSccpEnv]
  [inputs : CompilerIrPhiInputList]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-sccp-rewrite-phi-inputs env (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        (opt-sccp-rewrite-value env value)
        label
        (opt-sccp-rewrite-phi-inputs env (box-get rest)))]))

(define (opt-sccp-rewrite-scalar-def
  [env : OptSccpEnv]
  [dst : i64]
  [ty : AstType]
  [fallback : CompilerIrInstr]) : CompilerIrInstr
  (match (opt-sccp-env-lookup env dst)
    [(OptSccpValue.Const value _) (CompilerIrInstr.Mov dst value ty)]
    [_ fallback]))

(define (opt-sccp-rewrite-instr [env : OptSccpEnv] [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst value ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (CompilerIrInstr.Mov dst (opt-sccp-rewrite-value env value) ty))]
    [(CompilerIrInstr.Gep dst base offset ty)
      (CompilerIrInstr.Gep
        dst
        (opt-sccp-rewrite-value env base)
        (opt-sccp-rewrite-value env offset)
        ty)]
    [(CompilerIrInstr.Load dst src ty)
      (CompilerIrInstr.Load dst (opt-sccp-rewrite-value env src) ty)]
    [(CompilerIrInstr.StorePtr ptr value ty)
      (CompilerIrInstr.StorePtr
        (opt-sccp-rewrite-value env ptr)
        (opt-sccp-rewrite-value env value)
        ty)]
    [(CompilerIrInstr.CopyBytes dst src size)
      (CompilerIrInstr.CopyBytes
        (opt-sccp-rewrite-value env dst)
        (opt-sccp-rewrite-value env src)
        size)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        to-ty
        (CompilerIrInstr.Cast
          dst
          (opt-sccp-rewrite-value env src)
          from-ty
          to-ty))]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (CompilerIrInstr.Bitcast
        dst
        (opt-sccp-rewrite-value env src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        (compiler-ir-binop-result-type op ty)
        (CompilerIrInstr.BinOp
          dst
          op
          (opt-sccp-rewrite-value env lhs)
          (opt-sccp-rewrite-value env rhs)
          ty))]
    [(CompilerIrInstr.UnOp dst op value ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (CompilerIrInstr.UnOp dst op (opt-sccp-rewrite-value env value) ty))]
    [(CompilerIrInstr.Splat dst value lanes ty)
      (CompilerIrInstr.Splat dst (opt-sccp-rewrite-value env value) lanes ty)]
    [(CompilerIrInstr.Call dst name args ty)
      (CompilerIrInstr.Call dst name (opt-sccp-rewrite-call-args env args) ty)]
    [(CompilerIrInstr.CallIndirect dst callee args ty)
      (CompilerIrInstr.CallIndirect
        dst
        (opt-sccp-rewrite-value env callee)
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(CompilerIrInstr.CallIndirectC dst callee args ty)
      (CompilerIrInstr.CallIndirectC
        dst
        (opt-sccp-rewrite-value env callee)
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload
            base
            name
            args
            slots)
          (ir-instr-call-cabi-store-result
            (opt-sccp-rewrite-value env base)
            name
            (opt-sccp-rewrite-call-args env args)
            slots)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            callee
            args
            slots)
          (ir-instr-call-indirect-cabi-store-result
            (opt-sccp-rewrite-value env base)
            (opt-sccp-rewrite-value env callee)
            (opt-sccp-rewrite-call-args env args)
            slots)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload
            callee
            backend
            lanes
            active-mask
            args
            result)
          (ir-instr-spmd-call
            callee
            backend
            lanes
            (opt-sccp-rewrite-value env active-mask)
            (opt-sccp-rewrite-spmd-call-args env args)
            result)])]
    [(CompilerIrInstr.TailCall name args ty)
      (CompilerIrInstr.TailCall name (opt-sccp-rewrite-call-args env args) ty)]
    [(CompilerIrInstr.Store name value ty)
      (CompilerIrInstr.Store name (opt-sccp-rewrite-value env value) ty)]
    [(CompilerIrInstr.BoundsCheck index length ok-label)
      (CompilerIrInstr.BoundsCheck
        (opt-sccp-rewrite-value env index)
        (opt-sccp-rewrite-value env length)
        ok-label)]
    [(CompilerIrInstr.EntryArgc _) instr]
    [(CompilerIrInstr.EntryArgv _) instr]
    [(CompilerIrInstr.EntryEnvp _) instr]
    [(CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (CompilerIrInstr.CpuId
        dst
        (opt-sccp-rewrite-value env leaf)
        (opt-sccp-rewrite-value env subleaf)
        reg-index)]
    [(CompilerIrInstr.Xgetbv dst index)
      (CompilerIrInstr.Xgetbv dst (opt-sccp-rewrite-value env index))]
    [(CompilerIrInstr.Syscall dst args)
      (CompilerIrInstr.Syscall dst (opt-sccp-rewrite-call-args env args))]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (let
        [rewritten-cond : CompilerIrValue (opt-sccp-rewrite-value env cond)]
        (match rewritten-cond
          [(CompilerIrValue.Bool known)
            (if known
              (CompilerIrInstr.Jump true-label)
              (CompilerIrInstr.Jump false-label))]
          [_ (CompilerIrInstr.Branch rewritten-cond true-label false-label)]))]
    [(CompilerIrInstr.Return value)
      (CompilerIrInstr.Return (opt-sccp-rewrite-maybe-value env value))]
    [(CompilerIrInstr.Phi dst inputs ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (CompilerIrInstr.Phi dst (opt-sccp-rewrite-phi-inputs env inputs) ty))]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst op lhs rhs lanes ty)
          (ir-instr-vector-bin-op
            dst
            op
            (opt-sccp-rewrite-value env lhs)
            (opt-sccp-rewrite-value env rhs)
            lanes
            ty)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst op src carry lanes ty)
          (ir-instr-vector-prefix
            dst
            op
            (opt-sccp-rewrite-value env src)
            (opt-sccp-rewrite-value env carry)
            lanes
            ty)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            dst
            base
            index-base
            index
            lane-offset
            lanes
            ty)
          (ir-instr-gather-load
            dst
            (opt-sccp-rewrite-value env base)
            (opt-sccp-rewrite-value env index-base)
            (opt-sccp-rewrite-value env index)
            lane-offset
            lanes
            ty)])]
    [(CompilerIrInstr.VectorReduce dst op src lanes ty)
      (CompilerIrInstr.VectorReduce
        dst
        op
        (opt-sccp-rewrite-value env src)
        lanes
        ty)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst op lhs rhs lanes ty)
          (ir-instr-vector-compare
            dst
            op
            (opt-sccp-rewrite-value env lhs)
            (opt-sccp-rewrite-value env rhs)
            lanes
            ty)])]
    [(CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-sccp-rewrite-value env lhs)
        (opt-sccp-rewrite-value env rhs)
        lanes)]
    [(CompilerIrInstr.MaskNot dst src lanes)
      (CompilerIrInstr.MaskNot dst (opt-sccp-rewrite-value env src) lanes)]
    [(CompilerIrInstr.MaskReduce dst op src lanes)
      (CompilerIrInstr.MaskReduce dst op (opt-sccp-rewrite-value env src) lanes)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload
            dst
            mask
            true-value
            false-value
            lanes
            ty)
          (ir-instr-select
            dst
            (opt-sccp-rewrite-value env mask)
            (opt-sccp-rewrite-value env true-value)
            (opt-sccp-rewrite-value env false-value)
            lanes
            ty)])]
    [(CompilerIrInstr.VectorLoad dst base index lanes ty)
      (CompilerIrInstr.VectorLoad
        dst
        (opt-sccp-rewrite-value env base)
        (opt-sccp-rewrite-value env index)
        lanes
        ty)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value lanes ty)
          (ir-instr-vector-store
            (opt-sccp-rewrite-value env base)
            (opt-sccp-rewrite-value env index)
            (opt-sccp-rewrite-value env value)
            lanes
            ty)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            lanes
            ty)
          (ir-instr-predicated-store
            (opt-sccp-rewrite-value env base)
            (opt-sccp-rewrite-value env index)
            (opt-sccp-rewrite-value env value)
            (opt-sccp-rewrite-value env mask)
            lanes
            ty)])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload
            dst
            base
            index
            mask
            lanes
            ty)
          (ir-instr-predicated-load
            dst
            (opt-sccp-rewrite-value env base)
            (opt-sccp-rewrite-value env index)
            (opt-sccp-rewrite-value env mask)
            lanes
            ty)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            dst
            source
            selector-low
            selector-high
            active-lanes
            lanes
            ty)
          (ir-instr-vector-shuffle
            dst
            (opt-sccp-rewrite-value env source)
            (opt-sccp-rewrite-value env selector-low)
            (opt-sccp-rewrite-maybe-value env selector-high)
            (opt-sccp-rewrite-value env active-lanes)
            lanes
            ty)])]
    [(CompilerIrInstr.TailMask dst index length lanes)
      (CompilerIrInstr.TailMask
        dst
        (opt-sccp-rewrite-value env index)
        (opt-sccp-rewrite-value env length)
        lanes)]
    [(CompilerIrInstr.Alloc _ _) instr]
    [(CompilerIrInstr.AddrOf _ _) instr]
    [(CompilerIrInstr.LaneId _ _ _) instr]
    [(CompilerIrInstr.Jump _) instr]
    ;; Register-group ops carry no SCCP-constant operands to fold.
    [(CompilerIrInstr.Pack _ _ _) instr]
    [(CompilerIrInstr.Word _ _ _ _) instr]
    [(CompilerIrInstr.TailCallIndirect callee args ty)
      (CompilerIrInstr.TailCallIndirect
        (opt-sccp-rewrite-value env callee)
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(CompilerIrInstr.Switch index base cases default-label)
      (CompilerIrInstr.Switch
        (opt-sccp-rewrite-value env index)
        base
        cases
        default-label)]))

;; Constant propagation can decide a bounds check outright. Only the in-range
;; case is dropped: an out-of-range literal keeps its check so the trap still
;; fires at the same program point.
(define (opt-sccp-bounds-check-in-range? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BoundsCheck index length _)
      (match index
        [(CompilerIrValue.I64 idx)
          (match length
            [(CompilerIrValue.I64 len) (and (>= idx 0) (>= len 0) (< idx len))]
            [_ false])]
        [_ false])]
    [_ false]))

;; Retain-only rewrite (1:1 substitution, minus the bounds checks SCCP proved
;; in range), so the output length is not known up front: build it with the
;; capacity-managed dense builder seeded at the input length, not a cons
;; accumulator. `opt-sccp-rewrite-instr` is a pure function of `env` and the
;; instruction, so walking forward instead of the old backward-cons produces
;; the identical sequence. Output is fresh; `instrs` is untouched. refs #5726
(define (opt-sccp-rewrite-instr-seq
  [env : OptSccpEnv]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [builder : CompilerIrInstrBuilder
      (compiler-ir-instr-builder-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [rewritten : CompilerIrInstr
            (opt-sccp-rewrite-instr
              env
              (compiler-ir-instr-seq-ref instrs index))]
          (begin
            (if (opt-sccp-bounds-check-in-range? rewritten)
              unit
              (compiler-ir-instr-builder-push! (&mut builder) rewritten))
            (set! index (+ index 1)))))
      (compiler-ir-instr-builder-to-seq builder))))

(define (opt-sccp-rewrite-block [env : OptSccpEnv] [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (CompilerIrBlock.Block label (opt-sccp-rewrite-instr-seq env instrs))]))

(define (opt-sccp-rewrite-blocks
  [env : OptSccpEnv]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-sccp-rewrite-block env block)
        (opt-sccp-rewrite-blocks env (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-sccp-rewrite-blocks env (compiler-ir-block-seq-to-list seq))]))

(define (opt-sccp-blocks
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (match (opt-sccp-analyze type-segment-bases context params blocks)
      [(OptSccpState.State _ _ env _ _)
        (if (opt-sccp-env-any-const? env 0)
          (opt-cfg-simplify-blocks (opt-sccp-rewrite-blocks env blocks))
          ;; No constants bound anywhere: the rewrite is the identity, so
          ;; the simplify sees the input blocks either way.
          (opt-cfg-simplify-blocks blocks))])))

(define (opt-sccp-blocks-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptBlockCtxResult
  (match (opt-sccp-analyze type-segment-bases context params blocks)
    [(OptSccpState.State _ _ env _ _)
      (if (opt-sccp-env-any-const? env 0)
        (opt-cfg-simplify-blocks-with-context-result
          (OptBlockCtxResult.Result
            (opt-sccp-rewrite-blocks env blocks)
            context
            (not (opt-sccp-blocks-change-successors? env blocks))))
        ;; No constants: the rewrite is the identity and no branch condition
        ;; can have folded to a literal, so the context is valid as-is.
        (opt-cfg-simplify-blocks-with-context-result
          (OptBlockCtxResult.Result blocks context true)))]))

;; Pipeline entry point that skips the nested cfg-simplify: the pipeline's own
;; cfg pass runs immediately after sccp and canonicalizes once (literal
;; branches folded, unreachable blocks filtered, phis cleaned -- a second
;; application is a no-op), so simplifying here duplicated that stage
;; back-to-back. opt-sccp-blocks-with-context-result keeps the nested
;; simplify for the sccp self-test, which pins it. The context stays valid
;; for the rewrite output exactly when no branch condition folded to a
;; literal (opt-sccp-blocks-change-successors?).
;; Pipeline entry point that skips the nested cfg-simplify: the pipeline's own
;; cfg pass runs immediately after sccp and canonicalizes once (literal
;; branches folded, unreachable blocks filtered, phis cleaned -- a second
;; application is a no-op), so simplifying here duplicated that stage
;; back-to-back. opt-sccp-blocks-with-context-result keeps the nested
;; simplify for the sccp self-test, which pins it. The context stays valid
;; for the rewrite output exactly when no branch condition folded to a
;; literal (opt-sccp-blocks-change-successors?). The lattice env is sized by
;; the function frame (dense var ids), skipping the max-var walks.
(define (opt-sccp-blocks-with-context-result-raw
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]
  [frame : i64]) : OptBlockCtxResult
  (match (opt-sccp-analyze-with-frame
    type-segment-bases
    context
    params
    blocks
    frame)
    [(OptSccpState.State _ _ env _ _)
      (if (opt-sccp-env-any-const? env 0)
        (OptBlockCtxResult.Result
          (opt-sccp-rewrite-blocks env blocks)
          context
          (not (opt-sccp-blocks-change-successors? env blocks)))
        ;; No constants: the rewrite is the identity and the context is
        ;; valid as-is (no branch condition can have folded to a literal).
        (OptBlockCtxResult.Result blocks context true))]))

;; Non-heavy pipeline entry point: identical to opt-sccp-blocks (nested
;; cfg-simplify included) but sizes the lattice env by the function frame
;; instead of walking the whole function for max-var.
(define (opt-sccp-blocks-with-frame
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]
  [frame : i64]) : CompilerIrBlockList
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (match (opt-sccp-analyze-with-frame
      type-segment-bases
      context
      params
      blocks
      frame)
      [(OptSccpState.State _ _ env _ _)
        (if (opt-sccp-env-any-const? env 0)
          (opt-cfg-simplify-blocks (opt-sccp-rewrite-blocks env blocks))
          (opt-cfg-simplify-blocks blocks))])))

(defenum OptSwitchIndexTag
  (No)
  (Some i64 i64))

(defenum OptSwitchCompare
  (No)
  (Some i64 i64 i64 i64 i64))

(defenum OptSwitchCandidate
  (Candidate i64 i64 i64 i64 i64))

(defenum OptSwitchCandidateList
  (Nil)
  (Dense (Array OptSwitchCandidate) i64))

(define (opt-switch-candidate-ref
  [items : OptSwitchCandidateList]
  [index : i64]) : OptSwitchCandidate
  (match items
    [(OptSwitchCandidateList.Nil) (OptSwitchCandidate.Candidate -1 -1 -1 -1 -1)]
    [(OptSwitchCandidateList.Dense slots len)
      (array-ref slots (- (- len 1) index))]))

(define (opt-switch-candidate-tail [items : OptSwitchCandidateList]) : OptSwitchCandidateList
  (match items
    [(OptSwitchCandidateList.Nil) (OptSwitchCandidateList.Nil)]
    [(OptSwitchCandidateList.Dense slots len)
      (if (<= len 1)
        (OptSwitchCandidateList.Nil)
        (OptSwitchCandidateList.Dense slots (- len 1)))]))

(define (opt-switch-candidate-cons
  [label : i64]
  [tag : i64]
  [eq-var : i64]
  [arm-label : i64]
  [next-label : i64]
  [items : OptSwitchCandidateList]) : OptSwitchCandidateList
  (let
    [candidate : OptSwitchCandidate
      (OptSwitchCandidate.Candidate label tag eq-var arm-label next-label)]
    (match items
      [(OptSwitchCandidateList.Nil)
        (let
          [slots : (Array OptSwitchCandidate)
            (array.make-array OptSwitchCandidate 4)]
          (begin
            (array-set! slots 0 candidate)
            (OptSwitchCandidateList.Dense slots 1)))]
      [(OptSwitchCandidateList.Dense slots len)
        (if (< len (array-length slots))
          (begin
            (array-set! slots len candidate)
            (OptSwitchCandidateList.Dense slots (+ len 1)))
          (let
            [bigger : (Array OptSwitchCandidate)
              (array.make-array
                OptSwitchCandidate
                (opt-dense-next-capacity len))]
            [index : i64 0]
            (begin
              (while (< index len)
                (begin
                  (array-set! bigger index (array-ref slots index))
                  (set! index (+ index 1))))
              (array-set! bigger len candidate)
              (OptSwitchCandidateList.Dense bigger (+ len 1)))))])))

(defenum OptSwitchMaybeLabel
  (NoLabel)
  (SomeLabel i64))

;; The trailing i64 is the chain head's prefix instruction count: a head block
;; whose compare+branch merely TRAIL other instructions (e.g. a dispatch fetch)
;; keeps those instructions ahead of the emitted Switch. Zero is the classic
;; pure compare+branch head.
(defenum OptMaybeSwitchChain
  (No)
  (Some i64 i64 i64 i64 OptSwitchCandidateList i64))

(defenum OptSwitchRewriteResult
  (Result CompilerIrBlockList OptLabelSet bool))

(define (opt-switch-use-count [uses : (Array i64)] [var : i64]) : i64
  (if (< var 0)
    0
    (if (>= var (array-length uses))
      0
      (array-ref uses var))))

(define (opt-switch-index-tag-from-values
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : OptSwitchIndexTag
  (match lhs
    [(CompilerIrValue.Var var)
      (match rhs
        [(CompilerIrValue.I64 tag) (OptSwitchIndexTag.Some var tag)]
        [_ (OptSwitchIndexTag.No)])]
    [(CompilerIrValue.I64 tag)
      (match rhs
        [(CompilerIrValue.Var var) (OptSwitchIndexTag.Some var tag)]
        [_ (OptSwitchIndexTag.No)])]
    [_ (OptSwitchIndexTag.No)]))

(define (opt-switch-parse-compare-block
  [block : CompilerIrBlock]
  [uses : (Array i64)]) : OptSwitchCompare
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (if (= (compiler-ir-instr-seq-count instrs) 2)
        (match (compiler-ir-instr-seq-ref instrs 0)
          [(CompilerIrInstr.BinOp eq-var op lhs rhs _)
            (if (opt-binop-eq op CompilerIrBinOp.Eq)
              (match (opt-switch-index-tag-from-values lhs rhs)
                [(OptSwitchIndexTag.Some index-var tag)
                  (match (compiler-ir-instr-seq-ref instrs 1)
                    [(CompilerIrInstr.Branch
                        (CompilerIrValue.Var cond-var)
                        arm-label
                        next-label)
                      (if (and
                        (= cond-var eq-var)
                        (= (opt-switch-use-count uses eq-var) 1))
                        (OptSwitchCompare.Some
                          index-var
                          tag
                          eq-var
                          arm-label
                          next-label)
                        (OptSwitchCompare.No))]
                    [_ (OptSwitchCompare.No)])]
                [(OptSwitchIndexTag.No) (OptSwitchCompare.No)])
              (OptSwitchCompare.No))]
          [_ (OptSwitchCompare.No)])
        (OptSwitchCompare.No))]))

;; Head-block-only variant: the dispatch compare may TRAIL a non-empty prefix
;; of instructions that execute unconditionally before the branch (a bytecode
;; fetch, a length load, ...). Two head forms are recognized:
;;   * `Eq index, tag` + `Branch(eq, arm, next)` -- the general compare;
;;   * `Branch(index, next, arm)` -- a bare zero-test, which is how an
;;     `Eq index, 0` compare surfaces after earlier branch folding: the false
;;     edge is the tag-0 arm, the true edge continues the chain.
;; The chain rewrite keeps the prefix ahead of the Switch, so semantics are
;; unchanged; the same Eq/use-count checks apply to the compare form. A bare
;; zero-test head only completes a chain when the middle blocks compare the
;; SAME var against further literals, which confirms it is a dispatch index.
;; Middle blocks must stay pure compare+branch because they are consumed
;; wholesale by the rewrite. The trailing i64 in Some is the head prefix
;; instruction count kept ahead of the Switch.
(defenum OptSwitchCompareTail
  (No)
  (Some i64 i64 i64 i64 i64 i64))

(define (opt-switch-parse-compare-block-tail
  [block : CompilerIrBlock]
  [uses : (Array i64)]) : OptSwitchCompareTail
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (= count 0)
          (OptSwitchCompareTail.No)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Branch
                (CompilerIrValue.Var cond-var)
                true-label
                false-label)
              (if (>= count 2)
                (match (compiler-ir-instr-seq-ref instrs (- count 2))
                  [(CompilerIrInstr.BinOp eq-var op lhs rhs _)
                    (if (and
                      (opt-binop-eq op CompilerIrBinOp.Eq)
                      (= cond-var eq-var)
                      (= (opt-switch-use-count uses eq-var) 1))
                      (match (opt-switch-index-tag-from-values lhs rhs)
                        [(OptSwitchIndexTag.Some index-var tag)
                          (OptSwitchCompareTail.Some
                            index-var
                            tag
                            eq-var
                            true-label
                            false-label
                            (- count 2))]
                        [(OptSwitchIndexTag.No) (OptSwitchCompareTail.No)])
                      (OptSwitchCompareTail.No))]
                  [_
                    (OptSwitchCompareTail.Some
                      cond-var
                      0
                      (- 0 1)
                      false-label
                      true-label
                      (- count 1))])
                (OptSwitchCompareTail.Some
                  cond-var
                  0
                  (- 0 1)
                  false-label
                  true-label
                  0))]
            [_ (OptSwitchCompareTail.No)])))]))

;; Chain-head prefix copy facts: a `Mov dst, src` in the head block's prefix
;; means dst and src hold the same value from that point to the dispatch.
;; Block-local copy propagation rewrites same-block compare operands to a
;; copy's source, so the head compare and the middle-block compares may name
;; different vars for the one dispatch value; resolving every candidate var
;; through these facts unifies them onto one logical index var. A pair is
;; dropped as soon as its src is redefined (the copy no longer tracks it),
;; and a redefined dst simply shadows its earlier pair (newest-first lookup).
(defenum OptSwitchCopyEnv
  (Nil)
  (Cons i64 i64 (Box OptSwitchCopyEnv)))

(define (opt-switch-copy-env-resolve [env : OptSwitchCopyEnv] [var : i64]) : i64
  (match env
    [(OptSwitchCopyEnv.Nil) var]
    [(OptSwitchCopyEnv.Cons dst src rest)
      (if (= dst var)
        src
        (opt-switch-copy-env-resolve (box-get rest) var))]))

(define (opt-switch-copy-env-drop-src [env : OptSwitchCopyEnv] [var : i64]) : OptSwitchCopyEnv
  (match env
    [(OptSwitchCopyEnv.Nil) env]
    [(OptSwitchCopyEnv.Cons dst src rest)
      (if (= src var)
        (opt-switch-copy-env-drop-src (box-get rest) var)
        (OptSwitchCopyEnv.Cons
          dst
          src
          (box (opt-switch-copy-env-drop-src (box-get rest) var))))]))

;; Fold one prefix instruction into the copy facts: any definition of var D
;; invalidates pairs whose src is D; a `Mov dst, src` then records dst as a
;; fresh copy of src.
(define (opt-switch-copy-env-note
  [env : OptSwitchCopyEnv]
  [instr : CompilerIrInstr]) : OptSwitchCopyEnv
  (match (opt-instr-def-var instr)
    [(option_i64.Some dst)
      (match instr
        [(CompilerIrInstr.Mov _ (CompilerIrValue.Var src) _)
          (OptSwitchCopyEnv.Cons
            dst
            src
            (box (opt-switch-copy-env-drop-src env dst)))]
        [_ (opt-switch-copy-env-drop-src env dst)])]
    [(option_i64.None) env]))

(define (opt-switch-prefix-copies-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [env : OptSwitchCopyEnv]) : OptSwitchCopyEnv
  (if (>= index last)
    env
    (opt-switch-prefix-copies-from
      instrs
      (+ index 1)
      last
      (opt-switch-copy-env-note env (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-switch-candidate-empty? [items : OptSwitchCandidateList]) : bool
  (match items
    [(OptSwitchCandidateList.Nil) true]
    [_ false]))

(define (opt-switch-candidate-count [items : OptSwitchCandidateList]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) 0]
    [(OptSwitchCandidateList.Dense _ len) len]))

(define (opt-switch-candidate-has-tag?
  [items : OptSwitchCandidateList]
  [tag : i64]) : bool
  (match items
    [(OptSwitchCandidateList.Nil) false]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ item-tag _ _ _)
          (if (= item-tag tag)
            true
            (opt-switch-candidate-has-tag?
              (opt-switch-candidate-tail items)
              tag))])]))

(define (opt-switch-candidate-has-label?
  [items : OptSwitchCandidateList]
  [label : i64]) : bool
  (match items
    [(OptSwitchCandidateList.Nil) false]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate item-label _ _ _ _)
          (if (= item-label label)
            true
            (opt-switch-candidate-has-label?
              (opt-switch-candidate-tail items)
              label))])]))

(define (opt-switch-candidate-min-from
  [items : OptSwitchCandidateList]
  [current : i64]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) current]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ tag _ _ _)
          (opt-switch-candidate-min-from
            (opt-switch-candidate-tail items)
            (if (< tag current)
              tag
              current))])]))

(define (opt-switch-candidate-max-from
  [items : OptSwitchCandidateList]
  [current : i64]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) current]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ tag _ _ _)
          (opt-switch-candidate-max-from
            (opt-switch-candidate-tail items)
            (if (> tag current)
              tag
              current))])]))

(define (opt-switch-candidate-min [items : OptSwitchCandidateList]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) 0]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ tag _ _ _)
          (opt-switch-candidate-min-from (opt-switch-candidate-tail items) tag)])]))

(define (opt-switch-candidate-max [items : OptSwitchCandidateList]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) 0]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ tag _ _ _)
          (opt-switch-candidate-max-from (opt-switch-candidate-tail items) tag)])]))

(define (opt-switch-candidate-label-for-tag
  [items : OptSwitchCandidateList]
  [tag : i64]) : OptSwitchMaybeLabel
  (match items
    [(OptSwitchCandidateList.Nil) (OptSwitchMaybeLabel.NoLabel)]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ item-tag _ arm-label _)
          (if (= item-tag tag)
            (OptSwitchMaybeLabel.SomeLabel arm-label)
            (opt-switch-candidate-label-for-tag
              (opt-switch-candidate-tail items)
              tag))])]))

(define (opt-switch-build-cases-desc
  [items : OptSwitchCandidateList]
  [tag : i64]
  [min-tag : i64]
  [acc : CompilerIrSwitchCaseList]) : CompilerIrSwitchCaseList
  (if (< tag min-tag)
    acc
    (match (opt-switch-candidate-label-for-tag items tag)
      [(OptSwitchMaybeLabel.SomeLabel label)
        (opt-switch-build-cases-desc
          items
          (- tag 1)
          min-tag
          (compiler-ir-switch-case-cons-linked tag label acc))]
      [(OptSwitchMaybeLabel.NoLabel) acc])))

(define (opt-switch-build-cases
  [items : OptSwitchCandidateList]
  [min-tag : i64]
  [max-tag : i64]) : CompilerIrSwitchCaseList
  (compiler-ir-switch-case-list-compact
    (opt-switch-build-cases-desc
      items
      max-tag
      min-tag
      CompilerIrSwitchCaseList.Nil)))

(define (opt-switch-total-enum-trap-block [label : i64] [dst : i64]) : CompilerIrBlock
  (compiler-ir-block
    label
    (compiler-ir-instr-cons
      (CompilerIrInstr.Call
        dst
        cbi.compiler-builtin-id-tl-oob-abort
        (CompilerIrCallArgs.Nil)
        (AstType.Unit))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Jump label)
        CompilerIrInstrList.Nil))))

;; Totality is intentionally materialized only after the complete per-function
;; optimization fixpoint and the final scratch-reset pass. Mid-pipeline loop,
;; versioning, GVN, and verifier gates therefore see the same classic Switch as
;; clean HEAD: cases 0..N-2 and the last exhaustive arm as the default.
(defenum OptLateTotalSwitchCases
  (No)
  (Some CompilerIrSwitchCaseList i64))

(defenum OptLateTotalSwitchBlock
  (Unchanged CompilerIrBlock)
  (Rewritten CompilerIrBlock CompilerIrBlock))

(defenum OptLateTotalSwitchBlocks
  (Result CompilerIrBlockList CompilerIrBlockList))

(define (opt-late-total-switch-marker-label? [label : i64]) : bool
  (let
    [marker : String "match_total_enum_default"]
    [text : String (compiler-ir-label-text label)]
    (string.contains (& text) (& marker))))

(define (opt-late-total-switch-cases-from
  [cases : CompilerIrSwitchCaseList]
  [expected : i64]
  [final-label : i64]) : OptLateTotalSwitchCases
  (match cases
    [(CompilerIrSwitchCaseList.Nil)
      (OptLateTotalSwitchCases.Some
        (compiler-ir-switch-case-cons-linked
          expected
          final-label
          CompilerIrSwitchCaseList.Nil)
        0)]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case tag label)
          (if (= tag expected)
            (match (opt-late-total-switch-cases-from
              (box-get rest)
              (+ expected 1)
              final-label)
              [(OptLateTotalSwitchCases.No) (OptLateTotalSwitchCases.No)]
              [(OptLateTotalSwitchCases.Some tail count)
                (OptLateTotalSwitchCases.Some
                  (compiler-ir-switch-case-cons-linked tag label tail)
                  (+ count 1))])
            (OptLateTotalSwitchCases.No))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-late-total-switch-cases-from
        (compiler-ir-switch-case-seq-to-list seq)
        expected
        final-label)]))

(define (opt-late-total-switch-mark-params!
  [occupied : (Array i64)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (begin
      (array-set! occupied index 1)
      (opt-late-total-switch-mark-params! occupied (+ index 1) count))))

(define (opt-late-total-switch-reserve-var!
  [occupied : (Array i64)]
  [frame-cell : (Array i64)]
  [index : i64]) : i64
  (if (>= index (array-length occupied))
    (let
      [fresh : i64 (array-ref frame-cell 0)]
      (begin
        (array-set! frame-cell 0 (+ fresh 1))
        fresh))
    (if (= (array-ref occupied index) 0)
      (begin
        (array-set! occupied index 1)
        index)
      (opt-late-total-switch-reserve-var! occupied frame-cell (+ index 1)))))

(define (opt-late-total-switch-block
  [block : CompilerIrBlock]
  [occupied : (Array i64)]
  [frame-cell : (Array i64)]) : OptLateTotalSwitchBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (<= count 0)
          (OptLateTotalSwitchBlock.Unchanged block)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Switch index base cases default-label)
              (if (and
                (= base 0)
                (opt-late-total-switch-marker-label? default-label))
                (match (opt-late-total-switch-cases-from cases 0 default-label)
                  [(OptLateTotalSwitchCases.No)
                    (OptLateTotalSwitchBlock.Unchanged block)]
                  [(OptLateTotalSwitchCases.Some total-cases case-count)
                    ;; Four comparisons is switch formation's existing gate.
                    ;; Rechecking it here prevents a marker from authorizing a
                    ;; small or otherwise foreign Switch shape.
                    (if (< case-count 4)
                      (OptLateTotalSwitchBlock.Unchanged block)
                      (let
                        [trap-label : i64
                          (compiler-ir-label
                            (string.append
                              "match_total_trap__"
                              (compiler-ir-label-text label)))]
                        ;; Switch formation removes at least four compare
                        ;; destinations but deliberately leaves the frame
                        ;; numbering stable. Reuse one such unmentioned slot so
                        ;; the cold abort result cannot perturb register/frame
                        ;; allocation; grow only as a defensive fallback.
                        [trap-var : i64
                          (opt-late-total-switch-reserve-var!
                            occupied
                            frame-cell
                            0)]
                        (OptLateTotalSwitchBlock.Rewritten
                          (compiler-ir-block
                            label
                            (opt-switch-head-instrs
                              instrs
                              0
                              (- count 1)
                              (CompilerIrInstr.Switch
                                index
                                base
                                (compiler-ir-switch-case-list-compact
                                  total-cases)
                                trap-label)))
                          (opt-switch-total-enum-trap-block trap-label trap-var))))])
                (OptLateTotalSwitchBlock.Unchanged block))]
            [_ (OptLateTotalSwitchBlock.Unchanged block)])))]))

(define (opt-late-total-switch-blocks
  [blocks : CompilerIrBlockList]
  [occupied : (Array i64)]
  [frame-cell : (Array i64)]) : OptLateTotalSwitchBlocks
  (match blocks
    [(CompilerIrBlockList.Nil)
      (OptLateTotalSwitchBlocks.Result
        CompilerIrBlockList.Nil
        CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-late-total-switch-block block occupied frame-cell)
        [(OptLateTotalSwitchBlock.Unchanged unchanged)
          (match (opt-late-total-switch-blocks
            (box-get rest)
            occupied
            frame-cell)
            [(OptLateTotalSwitchBlocks.Result tail traps)
              (OptLateTotalSwitchBlocks.Result
                (compiler-ir-block-cons unchanged tail)
                traps)])]
        [(OptLateTotalSwitchBlock.Rewritten rewritten trap)
          (match (opt-late-total-switch-blocks
            (box-get rest)
            occupied
            frame-cell)
            [(OptLateTotalSwitchBlocks.Result tail traps)
              (OptLateTotalSwitchBlocks.Result
                (compiler-ir-block-cons rewritten tail)
                (compiler-ir-block-cons trap traps))])])]
    [(CompilerIrBlockList.Array seq)
      (opt-late-total-switch-blocks
        (compiler-ir-block-seq-to-list seq)
        occupied
        frame-cell)]))

(define (opt-late-total-switch-append-blocks
  [blocks : CompilerIrBlockList]
  [tail : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) tail]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        block
        (opt-late-total-switch-append-blocks (box-get rest) tail))]
    [(CompilerIrBlockList.Array seq)
      (opt-late-total-switch-append-blocks
        (compiler-ir-block-seq-to-list seq)
        tail)]))

(define (opt-late-total-switch-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [frame-cell : (Array i64) (array.make-array i64 1)]
        [_frame : unit (array-set! frame-cell 0 frame)]
        [occupied : (Array i64) (opt-collect-blocks-uses-array frame blocks)]
        [_defs : unit (opt-successor-sink-fill-all-defs! frame blocks occupied)]
        [_params : unit
          (opt-late-total-switch-mark-params!
            occupied
            0
            (compiler-ir-param-list-count params))]
        [blocks-result : OptLateTotalSwitchBlocks
          (opt-late-total-switch-blocks blocks occupied frame-cell)]
        [next-blocks : CompilerIrBlockList
          (match blocks-result
            [(OptLateTotalSwitchBlocks.Result main-blocks trap-blocks)
              (compiler-ir-block-list-compact
                (opt-late-total-switch-append-blocks main-blocks trap-blocks))])]
        [rewritten : CompilerIrFunction
          (CompilerIrFunction.Function
            name
            params
            ret-ty
            (array-ref frame-cell 0)
            next-blocks)]
        (compiler-opt-debug-observe-function
          type-segment-bases
          "total_switch"
          rewritten))]))

(define (opt-late-total-switch-function-list
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]) : CompilerIrFunctionList
  (match functions
    [(CompilerIrFunctionList.Nil) CompilerIrFunctionList.Nil]
    [(CompilerIrFunctionList.Cons func rest)
      (compiler-ir-function-cons
        (opt-late-total-switch-function type-segment-bases func)
        (opt-late-total-switch-function-list type-segment-bases (box-get rest)))]
    [(CompilerIrFunctionList.Array seq)
      (opt-late-total-switch-function-list
        type-segment-bases
        (compiler-ir-function-seq-to-list seq))]))

(define (opt-switch-block-starts-with-phi? [index : OptCfgIndex] [label : i64]) : bool
  (match (opt-cfg-index-find-block index label)
    [(OptMaybeBlock.No) true]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (= (compiler-ir-instr-seq-count instrs) 0)
            false
            (match (compiler-ir-instr-seq-ref instrs 0)
              [(CompilerIrInstr.Phi _ _ _) true]
              [_ false]))])]))

(define (opt-switch-targets-safe-from?
  [index : OptCfgIndex]
  [all-items : OptSwitchCandidateList]
  [items : OptSwitchCandidateList]
  [default-label : i64]) : bool
  (if (or
    (opt-switch-candidate-has-label? all-items default-label)
    (opt-switch-block-starts-with-phi? index default-label))
    false
    (match items
      [(OptSwitchCandidateList.Nil) true]
      [(OptSwitchCandidateList.Dense _ _)
        (match (opt-switch-candidate-ref items 0)
          [(OptSwitchCandidate.Candidate _ _ _ arm-label _)
            (and
              (not (opt-switch-candidate-has-label? all-items arm-label))
              (not (opt-switch-block-starts-with-phi? index arm-label))
              (opt-switch-targets-safe-from?
                index
                all-items
                (opt-switch-candidate-tail items)
                default-label))])])))

(define (opt-switch-targets-safe?
  [index : OptCfgIndex]
  [items : OptSwitchCandidateList]
  [default-label : i64]) : bool
  (opt-switch-targets-safe-from? index items items default-label))

(define (opt-switch-single-pred-from?
  [index : OptCfgIndex]
  [label : i64]
  [pred : i64]) : bool
  (let
    [preds : OptLabelSet (opt-cfg-index-predecessors index label)]
    (and (= (opt-label-count preds) 1) (opt-label-contains preds pred))))

(define (opt-switch-finalize-chain
  [index : OptCfgIndex]
  [index-var : i64]
  [items : OptSwitchCandidateList]
  [default-label : i64]
  [head-prefix : i64]) : OptMaybeSwitchChain
  (if (or (= index-var (- 0 1)) (opt-switch-candidate-empty? items))
    (OptMaybeSwitchChain.No)
    (let
      [count : i64 (opt-switch-candidate-count items)]
      [min-tag : i64 (opt-switch-candidate-min items)]
      [max-tag : i64 (opt-switch-candidate-max items)]
      (if (and
        (>= count 4)
        (= (+ (- max-tag min-tag) 1) count)
        (opt-switch-targets-safe? index items default-label))
        (OptMaybeSwitchChain.Some
          index-var
          min-tag
          max-tag
          default-label
          items
          head-prefix)
        (OptMaybeSwitchChain.No)))))

(define (opt-switch-collect-parsed
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (Array i64)]
  [label : i64]
  [index-var : i64]
  [prev-label : i64]
  [seen : OptLabelSet]
  [items : OptSwitchCandidateList]
  [candidate-index : i64]
  [tag : i64]
  [eq-var : i64]
  [arm-label : i64]
  [next-label : i64]
  [head-prefix : i64]
  [copies : OptSwitchCopyEnv]) : OptMaybeSwitchChain
  ;; Candidate vars read through the head prefix's copy Movs: block-local copy
  ;; propagation rewrites same-block compare operands to a copy's source, so
  ;; the head and middle compares may name different vars for one value.
  (let
    [resolved-index : i64 (opt-switch-copy-env-resolve copies candidate-index)]
    (if (and (!= index-var (- 0 1)) (!= resolved-index index-var))
      (opt-switch-finalize-chain index index-var items label head-prefix)
      (let
        [first? : bool (= index-var (- 0 1))]
        [chain-index : i64
          (if first?
            resolved-index
            index-var)]
        (if (or
          (opt-switch-candidate-has-tag? items tag)
          (and
            (not first?)
            (not (opt-switch-single-pred-from? index label prev-label))))
          (OptMaybeSwitchChain.No)
          (opt-switch-collect-chain
            blocks
            index
            uses
            next-label
            chain-index
            label
            (opt-label-add seen label)
            (opt-switch-candidate-cons
              label
              tag
              eq-var
              arm-label
              next-label
              items)
            head-prefix
            copies))))))

(define (opt-switch-collect-chain
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (Array i64)]
  [label : i64]
  [index-var : i64]
  [prev-label : i64]
  [seen : OptLabelSet]
  [items : OptSwitchCandidateList]
  [head-prefix : i64]
  [copies : OptSwitchCopyEnv]) : OptMaybeSwitchChain
  (if (opt-label-contains seen label)
    (OptMaybeSwitchChain.No)
    (match (opt-cfg-index-find-block index label)
      [(OptMaybeBlock.No)
        (opt-switch-finalize-chain index index-var items label head-prefix)]
      [(OptMaybeBlock.Some block)
        (match (opt-switch-parse-compare-block block uses)
          [(OptSwitchCompare.No)
            ;; A chain may still START here: the head block's compare+branch
            ;; may trail an unconditional prefix (fetch/addressing work) that
            ;; the rewrite preserves ahead of the Switch.
            (if (= index-var (- 0 1))
              (match (opt-switch-parse-compare-block-tail block uses)
                [(OptSwitchCompareTail.No)
                  (opt-switch-finalize-chain index index-var items label 0)]
                [(OptSwitchCompareTail.Some
                    candidate-index
                    tag
                    eq-var
                    arm-label
                    next-label
                    prefix)
                  (match block
                    [(CompilerIrBlock.Block _ head-instrs)
                      (opt-switch-collect-parsed
                        blocks
                        index
                        uses
                        label
                        index-var
                        prev-label
                        seen
                        items
                        candidate-index
                        tag
                        eq-var
                        arm-label
                        next-label
                        prefix
                        (opt-switch-prefix-copies-from
                          head-instrs
                          0
                          prefix
                          (OptSwitchCopyEnv.Nil)))])])
              (opt-switch-finalize-chain
                index
                index-var
                items
                label
                head-prefix))]
          [(OptSwitchCompare.Some
              candidate-index
              tag
              eq-var
              arm-label
              next-label)
            (opt-switch-collect-parsed
              blocks
              index
              uses
              label
              index-var
              prev-label
              seen
              items
              candidate-index
              tag
              eq-var
              arm-label
              next-label
              head-prefix
              copies)])])))

(define (opt-switch-skip-candidate-labels
  [items : OptSwitchCandidateList]
  [first-label : i64]
  [skip : OptLabelSet]) : OptLabelSet
  (match items
    [(OptSwitchCandidateList.Nil) skip]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate label _ _ _ _)
          (opt-switch-skip-candidate-labels
            (opt-switch-candidate-tail items)
            first-label
            (if (= label first-label)
              skip
              (opt-label-add skip label)))])]))

;; Rebuilt head block body: the kept unconditional prefix instructions
;; (usually none) followed by the Switch terminator.
(define (opt-switch-head-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [prefix : i64]
  [terminator : CompilerIrInstr]) : CompilerIrInstrList
  (if (>= index prefix)
    (compiler-ir-instr-cons terminator (CompilerIrInstrList.Nil))
    (compiler-ir-instr-cons
      (compiler-ir-instr-seq-ref instrs index)
      (opt-switch-head-instrs instrs (+ index 1) prefix terminator))))

(define (opt-switch-rewrite-block
  [block : CompilerIrBlock]
  [chain : OptMaybeSwitchChain]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (match chain
        [(OptMaybeSwitchChain.Some
            index-var
            min-tag
            max-tag
            default-label
            items
            head-prefix)
          (compiler-ir-block
            label
            (opt-switch-head-instrs
              instrs
              0
              head-prefix
              (CompilerIrInstr.Switch
                (CompilerIrValue.Var index-var)
                min-tag
                (opt-switch-build-cases items min-tag max-tag)
                default-label)))]
        [(OptMaybeSwitchChain.No) block])]))

(define (opt-switch-rewrite-blocks-from
  [remaining : CompilerIrBlockList]
  [all-blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (Array i64)]
  [skip : OptLabelSet]) : OptSwitchRewriteResult
  (match remaining
    [(CompilerIrBlockList.Nil)
      (OptSwitchRewriteResult.Result (CompilerIrBlockList.Nil) skip false)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (if (opt-label-contains skip label)
            (match (opt-switch-rewrite-blocks-from
              (box-get rest)
              all-blocks
              index
              uses
              skip)
              [(OptSwitchRewriteResult.Result tail next-skip _)
                (OptSwitchRewriteResult.Result tail next-skip true)])
            (match (opt-switch-collect-chain
              all-blocks
              index
              uses
              label
              (- 0 1)
              (compiler-ir-label-none)
              (OptLabelSet.Nil)
              (OptSwitchCandidateList.Nil)
              0
              (OptSwitchCopyEnv.Nil))
              [(OptMaybeSwitchChain.Some
                  index-var
                  min-tag
                  max-tag
                  default-label
                  items
                  head-prefix)
                (let
                  [next-skip : OptLabelSet
                    (opt-switch-skip-candidate-labels items label skip)]
                  (match (opt-switch-rewrite-blocks-from
                    (box-get rest)
                    all-blocks
                    index
                    uses
                    next-skip)
                    [(OptSwitchRewriteResult.Result tail final-skip _)
                      (OptSwitchRewriteResult.Result
                        (compiler-ir-block-cons
                          (opt-switch-rewrite-block
                            block
                            (OptMaybeSwitchChain.Some
                              index-var
                              min-tag
                              max-tag
                              default-label
                              items
                              head-prefix))
                          tail)
                        final-skip
                        true)]))]
              [(OptMaybeSwitchChain.No)
                (match (opt-switch-rewrite-blocks-from
                  (box-get rest)
                  all-blocks
                  index
                  uses
                  skip)
                  [(OptSwitchRewriteResult.Result tail final-skip changed)
                    (OptSwitchRewriteResult.Result
                      (compiler-ir-block-cons block tail)
                      final-skip
                      changed)])]))])]
    [(CompilerIrBlockList.Array seq)
      (opt-switch-rewrite-blocks-from
        (compiler-ir-block-seq-to-list seq)
        all-blocks
        index
        uses
        skip)]))

;; A switch chain can only start from a two-instruction compare-and-branch
;; block. Most functions have none, so scan for that shape before paying for
;; the use-count array, the CFG index, and the full rewrite walk.
(define (opt-switch-block-is-compare-shaped? [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (if (= (compiler-ir-instr-seq-count instrs) 2)
        (match (compiler-ir-instr-seq-ref instrs 0)
          [(CompilerIrInstr.BinOp eq-var op lhs rhs _)
            (if (opt-binop-eq op CompilerIrBinOp.Eq)
              (match (opt-switch-index-tag-from-values lhs rhs)
                [(OptSwitchIndexTag.Some _ _)
                  (match (compiler-ir-instr-seq-ref instrs 1)
                    [(CompilerIrInstr.Branch (CompilerIrValue.Var cond-var) _ _)
                      (= cond-var eq-var)]
                    [_ false])]
                [(OptSwitchIndexTag.No) false])
              false)]
          [_ false])
        false)]))

(define (opt-switch-blocks-have-compare? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-switch-block-is-compare-shaped? block)
        true
        (opt-switch-blocks-have-compare? (box-get rest)))]
    [(CompilerIrBlockList.Array seq) (opt-switch-block-seq-has-compare? seq 0)]))

(define (opt-switch-block-seq-has-compare?
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-block-seq-count blocks))
    false
    (if (opt-switch-block-is-compare-shaped?
      (compiler-ir-block-seq-ref blocks index))
      true
      (opt-switch-block-seq-has-compare? blocks (+ index 1)))))

(define (opt-switch-form-function-pass [func : CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (not (opt-switch-blocks-have-compare? blocks))
        (OptFunctionPassResult.Result func false)
        (let
          [uses : (Array i64) (opt-collect-blocks-uses-array frame blocks)]
          [index : OptCfgIndex (opt-cfg-index-build blocks)]
          [rewrite : OptSwitchRewriteResult
            (opt-switch-rewrite-blocks-from
              blocks
              blocks
              index
              uses
              (OptLabelSet.Nil))]
          (match rewrite
            [(OptSwitchRewriteResult.Result rewritten _ changed)
              (if changed
                (let
                  [reachable : CompilerIrBlockList
                    (opt-cfg-reachable-block-order rewritten)]
                  [next : CompilerIrFunction
                    (CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      frame
                      reachable)]
                  (match (opt-verify-function next)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionPassResult.Result next true)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionPassResult.Result func false)]))
                (OptFunctionPassResult.Result func false))])))]))

(define (opt-switch-form-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-switch-form-function-pass func)
    [(OptFunctionPassResult.Result next changed)
      (if changed
        next
        func)]))

(define (optimize-function-max-iterations) : i64
  2)

;; --- cross-block global value numbering -------------------------------------
;;
;; Block-local CSE (`opt-cse-instr`) and copy propagation already collapse
;; redundant pure scalar expressions within a single basic block. This pass
;; lifts that to dominated blocks: a pure `BinOp`/`UnOp`, or an identical CPU
;; feature probe, is replaced by a `Mov` from an equal expression computed in a
;; strictly dominating block, after which the existing copy propagation/DCE
;; remove the dead intermediate. The IR is
;; non-SSA, so a value computed in a dominating block is only reusable at a use
;; if neither the result nor any operand can be reassigned between the two
;; points. The conservative-but-sound v1 condition is "exactly one value source"
;; per var: the value-source count = number of definitions plus one if the var
;; is a function parameter. A var with exactly one source has a single,
;; unchanging value throughout the function, so dominance alone authorizes the
;; reuse. Vars with two or more sources (a reassigned local, or a parameter that
;; is later overwritten) are excluded. Only `BinOp`/`UnOp` and CPU probes over
;; single-source operands and a single-source result are numbered; loads,
;; stores, allocations, calls, and other effectful or many-sourced instructions
;; are left untouched.
;; Phi inputs belong to predecessor edges and are never rewritten. Sibling
;; expressions never global-CSE because a join block is not strictly dominated by
;; either arm.
;; GVN value-source multiset: maps each def-site var id to how many times it is
;; defined (parameter seed + instruction destinations). A var is reusable across
;; dominance only when its count is exactly 1. Backed by opt_i64_i64_map.Map for O(1)
;; membership; previously a linked list scanned O(n) per query inside the
;; per-instruction build and rewrite loops (O(n^2) per GVN pass).
;; The expression table itself is scoped by dominator-tree traversal: each block
;; rewrites against facts inherited from strict dominators, then pushes its own
;; original recordable expressions while visiting children and restores those
;; bucket heads on return. That makes the nearest dominating expression the
;; first same-key bucket entry, without a dominance scan during lookup.
(defenum OptGvnEntry
  (Entry OptExprKey i64 i64))

(defenum OptGvnBucket
  (Nil)
  (Cons OptGvnEntry (Box OptGvnBucket)))

(defstruct OptGvnMap
  (buckets (Array OptGvnBucket)))

(defenum OptGvnScopeChange
  (Change i64 OptGvnBucket))

(defenum OptGvnScopeChanges
  (Nil)
  (Cons OptGvnScopeChange (Box OptGvnScopeChanges)))

(defenum OptGvnBlockResult
  (NoBlock)
  (SomeBlock CompilerIrBlock))

;; Number of times `var` appears as a definition site (instruction destination
;; or seeded parameter) in the collected value-source list.
(define (opt-gvn-count [sources : opt_i64_i64_map.Map] [var : i64]) : i64
  (match (opt_i64_i64_map.get (& sources) var)
    [(opt_i64_i64_map.LookupFound n) n]
    [(opt_i64_i64_map.LookupMissing) 0]))

;; Record one more definition of `var` in the value-source multiset.
(define (opt-gvn-defs-add [sources : opt_i64_i64_map.Map] [var : i64]) : opt_i64_i64_map.Map
  (let
    [next-count : i64 (+ 1 (opt-gvn-count sources var))]
    [out : opt_i64_i64_map.Map sources]
    (begin
      (opt_i64_i64_map.insert-ref! (&mut out) var next-count)
      out)))

;; A var is reusable across dominance only when it has exactly one value source.
(define (opt-gvn-stable-var? [sources : opt_i64_i64_map.Map] [var : i64]) : bool
  (= (opt-gvn-count sources var) 1))

;; Operand values that hold a single unchanging value: literals and single-source
;; vars. Globals, global addresses, function references, and float/string
;; literals are excluded to match the existing copy-propagation conservatism.
(define (opt-gvn-value-stable?
  [sources : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var id) (opt-gvn-stable-var? sources id)]
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.Bool _) true]
    [(CompilerIrValue.Char _) true]
    [(CompilerIrValue.Unit) true]
    [(CompilerIrValue.F64 _) false]
    [(CompilerIrValue.String _) false]
    [(CompilerIrValue.Bytes _) false]
    [(CompilerIrValue.Global _) false]
    [(CompilerIrValue.GlobalAddr _) false]
    [(CompilerIrValue.Function _) false]
    [(CompilerIrValue.RuntimeGlobal _) false]))

;; The destination var of a defining instruction, or -1 for instructions that do
;; not define a var. Mirrors the instruction set handled by `opt-cse-instr`.
(define (opt-gvn-instr-dst [instr : CompilerIrInstr]) : i64
  (match instr
    [(CompilerIrInstr.Mov dst _ _) dst]
    [(CompilerIrInstr.Alloc dst _) dst]
    [(CompilerIrInstr.AddrOf dst _) dst]
    [(CompilerIrInstr.Gep dst _ _ _) dst]
    [(CompilerIrInstr.Load dst _ _) dst]
    [(CompilerIrInstr.Cast dst _ _ _) dst]
    [(CompilerIrInstr.Bitcast dst _ _ _) dst]
    [(CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [(CompilerIrInstr.UnOp dst _ _ _) dst]
    [(CompilerIrInstr.LaneId dst _ _) dst]
    [(CompilerIrInstr.Splat dst _ _ _) dst]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _) dst]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _) dst]
    [(CompilerIrInstr.MaskNot dst _ _) dst]
    [(CompilerIrInstr.MaskReduce dst _ _ _) dst]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _) dst]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _) dst])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _) dst])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _) dst])]
    [(CompilerIrInstr.TailMask dst _ _ _) dst]
    [(CompilerIrInstr.EntryArgc dst) dst]
    [(CompilerIrInstr.EntryArgv dst) dst]
    [(CompilerIrInstr.EntryEnvp dst) dst]
    [(CompilerIrInstr.CpuId dst _ _ _) dst]
    [(CompilerIrInstr.Xgetbv dst _) dst]
    [(CompilerIrInstr.Syscall dst _) dst]
    [(CompilerIrInstr.Call dst _ _ _) dst]
    [(CompilerIrInstr.CallIndirect dst _ _ _) dst]
    [(CompilerIrInstr.CallIndirectC dst _ _ _) dst]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ _ _ _) (- 0 1)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload _ _ _ _)
          (- 0 1)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (match result
            [(CompilerIrSpmdCallResult.Unit) (- 0 1)]
            [(CompilerIrSpmdCallResult.Value dst _ _) dst])])]
    [(CompilerIrInstr.Phi dst _ _) dst]
    [(CompilerIrInstr.StorePtr _ _ _) (- 0 1)]
    [(CompilerIrInstr.CopyBytes _ _ _) (- 0 1)]
    [(CompilerIrInstr.BoundsCheck _ _ _) (- 0 1)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload _ _ _ _ _) (- 0 1)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload _ _ _ _ _ _) (- 0 1)])]
    [(CompilerIrInstr.TailCall _ _ _) (- 0 1)]
    [(CompilerIrInstr.Store _ _ _) (- 0 1)]
    [(CompilerIrInstr.Jump _) (- 0 1)]
    [(CompilerIrInstr.Branch _ _ _) (- 0 1)]
    [(CompilerIrInstr.Return _) (- 0 1)]
    ;; Register-group ops define their dst.
    [(CompilerIrInstr.Pack dst _ _) dst]
    [(CompilerIrInstr.Word dst _ _ _) dst]
    [(CompilerIrInstr.TailCallIndirect _ _ _) (- 0 1)]
    [(CompilerIrInstr.Switch _ _ _ _) (- 0 1)]))

(define (opt-gvn-sources-params
  [params : CompilerIrParamList]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) acc]
    [(CompilerIrParamList.Array seq)
      (opt-gvn-sources-params (compiler-ir-param-seq-to-list seq) acc)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ id)
          (opt-gvn-sources-params (box-get rest) (opt-gvn-defs-add acc id))])]))

(define (opt-gvn-sources-instr-seq-from
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index count)
    acc
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      [next : opt_i64_i64_map.Map
        (if (opt-gvn-record-candidate? instr)
          (opt-gvn-defs-add acc (- 0 1))
          acc)]
      (opt-gvn-sources-instr-seq-from
        slots
        (+ index 1)
        count
        (if (= dst (- 0 1))
          next
          (opt-gvn-defs-add next dst))))))

(define (opt-gvn-sources-blocks
  [blocks : CompilerIrBlockList]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) acc]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-gvn-sources-blocks
            (box-get rest)
            (opt-gvn-sources-instr-seq-from
              (struct-get instrs slots)
              0
              (compiler-ir-instr-seq-count instrs)
              acc))])]
    [(CompilerIrBlockList.Array seq)
      (opt-gvn-sources-blocks (compiler-ir-block-seq-to-list seq) acc)]))

;; Candidate count shares the map's -1 no-destination sentinel. Var ids are
;; non-negative, so stability queries never observe this reserved entry.
(define (opt-gvn-record-candidate? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(CompilerIrInstr.UnOp _ _ _ _) true]
    [(CompilerIrInstr.CpuId _ _ _ _) true]
    [(CompilerIrInstr.Xgetbv _ _) true]
    [_ false]))

(define (opt-gvn-block-id [doms : OptDomInfo] [label : i64]) : i64
  (match (opt-cfg-index-id (struct-get doms index) label)
    [(option_i64.Some id) id]
    [(option_i64.None) (- 0 1)]))

(define (opt-gvn-recordable-instr?
  [instr : CompilerIrInstr]
  [sources : opt_i64_i64_map.Map]) : bool
  (match instr
    [(CompilerIrInstr.BinOp dst _ l r _)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources l)
        (opt-gvn-value-stable? sources r))]
    [(CompilerIrInstr.UnOp dst _ v _)
      (and (opt-gvn-stable-var? sources dst) (opt-gvn-value-stable? sources v))]
    [(CompilerIrInstr.CpuId dst leaf subleaf _)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources leaf)
        (opt-gvn-value-stable? sources subleaf))]
    [(CompilerIrInstr.Xgetbv dst index)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources index))]
    [_ false]))

(define (opt-gvn-bucket-capacity [count : i64]) : i64
  (opt-global-fact-bucket-capacity count))

(define (opt-gvn-buckets-fill-empty!
  [buckets : (Array OptGvnBucket)]
  [index : i64]) : unit
  (if (>= index (array-length buckets))
    unit
    (begin
      (array-set! buckets index (OptGvnBucket.Nil))
      (opt-gvn-buckets-fill-empty! buckets (+ index 1)))))

(define (opt-gvn-map-empty [record-count : i64]) : OptGvnMap
  (let
    [buckets : (Array OptGvnBucket)
      (array.make-array OptGvnBucket (opt-gvn-bucket-capacity record-count))]
    (begin
      (opt-gvn-buckets-fill-empty! buckets 0)
      (OptGvnMap buckets))))

(define (opt-gvn-bucket-index
  [type-segment-bases : i64]
  [buckets : (Array OptGvnBucket)]
  [key : OptExprKey]) : i64
  (bit-and
    (opt-expr-key-hash type-segment-bases key)
    (- (array-length buckets) 1)))

(define (opt-gvn-table-push!
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [entry : OptGvnEntry]
  [changes : OptGvnScopeChanges]) : OptGvnScopeChanges
  (match entry
    [(OptGvnEntry.Entry key _ _)
      (let
        [buckets : (Array OptGvnBucket) (struct-get table buckets)]
        [bucket : i64 (opt-gvn-bucket-index type-segment-bases buckets key)]
        [old-head : OptGvnBucket (array-ref buckets bucket)]
        ;; Under inline-by-value aggregates, `array-ref` of a
        ;; memory-backed aggregate returns the element ADDRESS (in-place), not a
        ;; value snapshot the way the old heap-handle GVN assumed. So the
        ;; scope-change MUST capture old-head's value BEFORE the array-set! below
        ;; overwrites the slot -- otherwise restore writes back the just-pushed
        ;; head and scoped dominance breaks (a dominated sibling reuses a value
        ;; that does not dominate it).
        [result : OptGvnScopeChanges
          (OptGvnScopeChanges.Cons
            (OptGvnScopeChange.Change bucket old-head)
            (box changes))]
        (begin
          (array-set! buckets bucket (OptGvnBucket.Cons entry (box old-head)))
          result))]))

(define (opt-gvn-table-insert!
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [entry : OptGvnEntry]) : unit
  (begin
    (opt-gvn-table-push!
      type-segment-bases
      table
      entry
      (OptGvnScopeChanges.Nil))
    unit))

(define (opt-gvn-table-restore!
  [table : OptGvnMap]
  [changes : OptGvnScopeChanges]) : unit
  (match changes
    [(OptGvnScopeChanges.Nil) unit]
    [(OptGvnScopeChanges.Cons change rest)
      (match change
        [(OptGvnScopeChange.Change bucket old-head)
          (let
            [buckets : (Array OptGvnBucket) (struct-get table buckets)]
            (begin
              (array-set! buckets bucket old-head)
              (opt-gvn-table-restore! table (box-get rest))))])]))

;; Record a `BinOp`/`UnOp`/CPU probe whose result and operands are all
;; single-source as an available value keyed by its expression and tagged with
;; its defining block.
(define (opt-gvn-record
  [type-segment-bases : i64]
  [instr : CompilerIrInstr]
  [def-block-id : i64]
  [sources : opt_i64_i64_map.Map]
  [table : OptGvnMap]
  [changes : OptGvnScopeChanges]) : OptGvnScopeChanges
  (match instr
    [(CompilerIrInstr.BinOp dst op l r ty)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          type-segment-bases
          table
          (OptGvnEntry.Entry (OptExprKey.BinKey op l r ty) dst def-block-id)
          changes)
        changes)]
    [(CompilerIrInstr.UnOp dst op v ty)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          type-segment-bases
          table
          (OptGvnEntry.Entry (OptExprKey.UnKey op v ty) dst def-block-id)
          changes)
        changes)]
    [(CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          type-segment-bases
          table
          (OptGvnEntry.Entry
            (OptExprKey.CpuIdKey leaf subleaf reg-index)
            dst
            def-block-id)
          changes)
        changes)]
    [(CompilerIrInstr.Xgetbv dst index)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          type-segment-bases
          table
          (OptGvnEntry.Entry (OptExprKey.XgetbvKey index) dst def-block-id)
          changes)
        changes)]
    [_ changes]))

(define (opt-gvn-record-scope-instr-seq-from
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [def-block-id : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [table : OptGvnMap]
  [changes : OptGvnScopeChanges]) : OptGvnScopeChanges
  (if (>= index (compiler-ir-instr-seq-count instrs))
    changes
    (opt-gvn-record-scope-instr-seq-from
      type-segment-bases
      sources
      def-block-id
      instrs
      (+ index 1)
      table
      (opt-gvn-record
        type-segment-bases
        (compiler-ir-instr-seq-ref instrs index)
        def-block-id
        sources
        table
        changes))))

;; Find the nearest scoped result var for `key`, or -1 if none qualifies.
;; Dominance is represented by the current table scope; the bucket walk only
;; handles hash collisions and older same-key ancestors.
(define (opt-gvn-lookup-bucket
  [type-segment-bases : i64]
  [bucket : OptGvnBucket]
  [key : OptExprKey]) : i64
  (match bucket
    [(OptGvnBucket.Nil) (- 0 1)]
    [(OptGvnBucket.Cons entry rest)
      (match entry
        [(OptGvnEntry.Entry ekey evar def-block-id)
          (if (and
            (>= def-block-id 0)
            (opt-expr-key-eq type-segment-bases ekey key))
            evar
            (opt-gvn-lookup-bucket type-segment-bases (box-get rest) key))])]))

(define (opt-gvn-lookup
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [key : OptExprKey]) : i64
  (let
    [buckets : (Array OptGvnBucket) (struct-get table buckets)]
    (opt-gvn-lookup-bucket
      type-segment-bases
      (array-ref buckets (opt-gvn-bucket-index type-segment-bases buckets key))
      key)))

;; Rewriting an instruction allocates only when the rewrite fires: scanning a
;; sequence for changes is allocation-free, so unchanged blocks keep their
;; original instruction arrays instead of paying for a cons-list rebuild and
;; an Array->List->Array representation round trip per GVN call.
(defenum OptMaybeInstr
  (No)
  (Some CompilerIrInstr))

(define (opt-gvn-rewrite-instr-maybe
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : OptMaybeInstr
  (match instr
    [(CompilerIrInstr.BinOp dst op l r ty)
      (if (and
        (opt-gvn-value-stable? sources l)
        (opt-gvn-value-stable? sources r))
        (let
          [earlier : i64
            (opt-gvn-lookup
              type-segment-bases
              table
              (OptExprKey.BinKey op l r ty))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (OptMaybeInstr.Some
              (CompilerIrInstr.Mov
                dst
                (CompilerIrValue.Var earlier)
                (compiler-ir-binop-result-type op ty)))
            (OptMaybeInstr.No)))
        (OptMaybeInstr.No))]
    [(CompilerIrInstr.UnOp dst op v ty)
      (if (opt-gvn-value-stable? sources v)
        (let
          [earlier : i64
            (opt-gvn-lookup type-segment-bases table (OptExprKey.UnKey op v ty))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (OptMaybeInstr.Some
              (CompilerIrInstr.Mov dst (CompilerIrValue.Var earlier) ty))
            (OptMaybeInstr.No)))
        (OptMaybeInstr.No))]
    [(CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (if (and
        (opt-gvn-value-stable? sources leaf)
        (opt-gvn-value-stable? sources subleaf))
        (let
          [earlier : i64
            (opt-gvn-lookup
              type-segment-bases
              table
              (OptExprKey.CpuIdKey leaf subleaf reg-index))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (OptMaybeInstr.Some
              (CompilerIrInstr.Mov
                dst
                (CompilerIrValue.Var earlier)
                (AstType.I64)))
            (OptMaybeInstr.No)))
        (OptMaybeInstr.No))]
    [(CompilerIrInstr.Xgetbv dst index)
      (if (opt-gvn-value-stable? sources index)
        (let
          [earlier : i64
            (opt-gvn-lookup
              type-segment-bases
              table
              (OptExprKey.XgetbvKey index))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (OptMaybeInstr.Some
              (CompilerIrInstr.Mov
                dst
                (CompilerIrValue.Var earlier)
                (AstType.I64)))
            (OptMaybeInstr.No)))
        (OptMaybeInstr.No))]
    [_ (OptMaybeInstr.No)]))

(define (opt-gvn-seq-rewrite-changed?
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (< index 0)
    false
    (match (opt-gvn-rewrite-instr-maybe
      type-segment-bases
      table
      sources
      (compiler-ir-instr-seq-ref instrs index))
      [(OptMaybeInstr.Some _) true]
      [(OptMaybeInstr.No)
        (opt-gvn-seq-rewrite-changed?
          type-segment-bases
          table
          sources
          instrs
          (- index 1))])))

(define (opt-gvn-rewrite-instr-seq-from
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [out : CompilerIrInstrList]) : CompilerIrInstrList
  (if (< index 0)
    out
    (opt-gvn-rewrite-instr-seq-from
      type-segment-bases
      table
      sources
      instrs
      (- index 1)
      (compiler-ir-instr-cons
        (match (opt-gvn-rewrite-instr-maybe
          type-segment-bases
          table
          sources
          (compiler-ir-instr-seq-ref instrs index))
          [(OptMaybeInstr.Some rewritten) rewritten]
          [(OptMaybeInstr.No) (compiler-ir-instr-seq-ref instrs index)])
        out))))

(define (opt-gvn-rewrite-instr-seq
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-gvn-rewrite-instr-seq-from
    type-segment-bases
    table
    sources
    instrs
    (- (compiler-ir-instr-seq-count instrs) 1)
    CompilerIrInstrList.Nil))

(define (opt-gvn-rewrite-block
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [block : CompilerIrBlock]) : OptBlockPassResult
  (match block
    [(CompilerIrBlock.Block label instrs)
      (if (opt-gvn-seq-rewrite-changed?
        type-segment-bases
        table
        sources
        instrs
        (- (compiler-ir-instr-seq-count instrs) 1))
        (OptBlockPassResult.Result
          (compiler-ir-block
            label
            (opt-gvn-rewrite-instr-seq type-segment-bases table sources instrs))
          true)
        (OptBlockPassResult.Result block false))]))

(define (opt-gvn-dom-children [doms : OptDomInfo]) : OptCfgCsr
  (let
    [index : OptCfgIndex (struct-get doms index)]
    [count : i64 (opt-cfg-index-block-count index)]
    [child-rows : (Array OptI64List) (array.make-array OptI64List count)]
    (begin
      (opt-cfg-i64-list-array-fill-empty! child-rows count)
      (opt-dom-child-rows-fill! index (struct-get doms idom) child-rows)
      (opt-cfg-csr-build child-rows count))))

(define (opt-gvn-block-results-fill-empty!
  [out : (Array OptGvnBlockResult)]
  [index : i64]) : unit
  (if (>= index (array-length out))
    unit
    (begin
      (array-set! out index (OptGvnBlockResult.NoBlock))
      (opt-gvn-block-results-fill-empty! out (+ index 1)))))

(define (opt-gvn-materialize-blocks
  [doms : OptDomInfo]
  [out : (Array OptGvnBlockResult)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (let
            [block-id : i64 (opt-gvn-block-id doms label)]
            [material : CompilerIrBlock
              (if (and (>= block-id 0) (< block-id (array-length out)))
                (match (array-ref out block-id)
                  [(OptGvnBlockResult.SomeBlock rewritten) rewritten]
                  [(OptGvnBlockResult.NoBlock) block])
                block)]
            (compiler-ir-block-cons
              material
              (opt-gvn-materialize-blocks doms out (box-get rest))))])]
    [(CompilerIrBlockList.Array seq)
      (opt-gvn-materialize-blocks doms out (compiler-ir-block-seq-to-list seq))]))

(define (opt-gvn-rewrite-id
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]
  [out : (Array OptGvnBlockResult)]
  [id : i64]) : i64
  (let
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and (>= id 0) (< id count))
      (match (opt-cfg-index-block index id)
        [(OptMaybeBlock.No) 0]
        [(OptMaybeBlock.Some block)
          (match block
            [(CompilerIrBlock.Block label instrs)
              (match (if (or
                (opt-induction-switch-arm? index blocks label instrs)
                (opt-bool-branch-chain-check-block? label instrs))
                (OptBlockPassResult.Result block false)
                (opt-gvn-rewrite-block type-segment-bases table sources block))
                [(OptBlockPassResult.Result rewritten block-changed)
                  (begin
                    (if block-changed
                      (array-set!
                        out
                        id
                        (OptGvnBlockResult.SomeBlock rewritten))
                      unit)
                    (let
                      [changes : OptGvnScopeChanges
                        (opt-gvn-record-scope-instr-seq-from
                          type-segment-bases
                          sources
                          id
                          instrs
                          0
                          table
                          (OptGvnScopeChanges.Nil))]
                      [children-changed : i64
                        (opt-gvn-rewrite-children
                          type-segment-bases
                          context
                          children
                          table
                          sources
                          blocks
                          out
                          id)]
                      (begin
                        (opt-gvn-table-restore! table changes)
                        (if (or block-changed (= children-changed 1))
                          1
                          0))))])])])
      0)))

(define (opt-gvn-rewrite-children
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]
  [out : (Array OptGvnBlockResult)]
  [parent-id : i64]) : i64
  (let
    [offsets : (Array i64) (struct-get children offsets)]
    [edges : (Array i64) (struct-get children edges)]
    [edge : i64 (array-ref offsets parent-id)]
    [end : i64 (array-ref offsets (+ parent-id 1))]
    [changed : i64 0]
    (begin
      (while (< edge end)
        (begin
          (if (=
            (opt-gvn-rewrite-id
              type-segment-bases
              context
              children
              table
              sources
              blocks
              out
              (array-ref edges edge))
            1)
            (set! changed 1)
            unit)
          (set! edge (+ edge 1))))
      changed)))

(define (opt-gvn-rewrite-dom
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [doms : OptDomInfo (struct-get context doms)]
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    [children : OptCfgCsr (opt-gvn-dom-children doms)]
    [out : (Array OptGvnBlockResult) (array.make-array OptGvnBlockResult count)]
    (begin
      (opt-cfg-index-refresh-blocks! index blocks)
      (opt-gvn-block-results-fill-empty! out 0)
      (let
        [changed : i64
          (match (opt-cfg-index-id index (struct-get context entry-label))
            [(option_i64.Some entry-id)
              (if (and
                (>= entry-id 0)
                (array-ref (struct-get index reachable) entry-id))
                (opt-gvn-rewrite-id
                  type-segment-bases
                  context
                  children
                  table
                  sources
                  blocks
                  out
                  entry-id)
                0)]
            [(option_i64.None) 0])]
        (if (= changed 0)
          blocks
          (opt-gvn-materialize-blocks doms out blocks))))))

;; Replace dominated repeated pure scalar expressions with a copy from the first
;; dominating value; existing copy propagation and DCE remove the dead copies.
(define (opt-gvn-blocks-with-context-and-call-memory
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [call-memory : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [sources : opt_i64_i64_map.Map
      (opt-gvn-sources-blocks
        blocks
        (opt-gvn-sources-params params (opt_i64_i64_map.with-capacity 64)))]
    [table : OptGvnMap (opt-gvn-map-empty (opt-gvn-count sources (- 0 1)))]
    [gvn : CompilerIrBlockList
      (opt-gvn-rewrite-dom type-segment-bases context table sources blocks)]
    [hs : OptLoadHeaderSet
      (opt-load-header-set-from-function type-segment-bases params gvn)]
    (opt-load-gvn-blocks-with-context
      type-segment-bases
      context
      sources
      hs
      params
      call-memory
      gvn)))

(define (opt-gvn-blocks-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-gvn-blocks-with-context-and-call-memory
    type-segment-bases
    context
    params
    (opt_i64_i64_map.with-capacity 1)
    blocks))

(define (opt-gvn-blocks
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-gvn-blocks-with-context
    type-segment-bases
    (opt-cfg-context-build blocks)
    params
    blocks))

;; --- dominated redundant bounds-check elimination ----------------------------
;;
;; The block-local pass (#930) drops duplicate checks within one basic block,
;; but consecutive accesses to the same index usually sit in different blocks
;; (each check's not-taken abort path splits the flow), so read-then-write
;; pairs like a swap re-check the same `(index, length)` several times per
;; iteration. This pass walks the dominator tree carrying `(index, length)`
;; facts: a BoundsCheck whose exact pair was already checked at a DOMINATING
;; point is removable -- the dominating check either aborted or proved the pair
;; in range, and BoundsCheck is a mid-block trap-or-continue, so reaching any
;; dominated point means every check in the dominating prefix passed. A fact is
;; recorded only when both values are literals or single-source vars
;; (opt-gvn-value-stable?), so recorded pairs can never be redefined and no
;; invalidation is needed: stores and calls cannot change an SSA var's value.
;; PRECONDITION: the caller must have verified the function (defs dominate
;; uses). In a fallback non-SSA function a textually-single-def var inside a
;; loop takes a new value each iteration and loop-carried uses precede the
;; redefinition, so "one def instruction" does not imply "one value" there.
;; Runs right after GVN/load-GVN so identical index casts and length loads
;; have been unified into shared vars first. Facts flow down the dominator
;; tree as an immutable list, so sibling subtrees are isolated by construction.
(defenum OptBoundsDomWalk
  (Walk CompilerIrInstrSeq OptBoundsFacts OptDomCmpFacts))

;; GVN rewrites a dominated duplicate expression (e.g. the per-access
;; `Cast(i -> U64)` index) into `Mov dst2 = dst1`, and block-local copy
;; propagation cannot forward that copy into a check in a later block (its env
;; resets per block). Canonicalize check operands through a function-wide
;; copy map restricted to single-source vars on both sides: such a Mov is its
;; dst's unique definition and its source never changes, so dst and source
;; denote the same runtime value everywhere and comparing canonical values is
;; exact. The chase is bounded defensively; chains are Mov-of-Mov artifacts
;; and stay short.
;; A 64-bit integer-to-integer cast is a bit-preserving reinterpret (the #930
;; argument): the unsigned bounds comparison is identical on either side, so
;; the canonical value for dedup purposes is the pre-cast source.
(define (opt-bounds-dom-reinterpret-cast? [from-ty : AstType] [to-ty : AstType]) : bool
  (and
    (opt-integer-type? from-ty)
    (opt-integer-type? to-ty)
    (= (opt-int-width from-ty) 64)
    (= (opt-int-width to-ty) 64)))

(define (opt-bounds-dom-copies-add-instr
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : opt_i64_i64_map.Map
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var s)
          (if (and
            (opt-gvn-stable-var? sources dst)
            (opt-gvn-stable-var? sources s))
            (let
              [out : opt_i64_i64_map.Map copies]
              (begin
                (opt_i64_i64_map.insert-ref! (&mut out) dst s)
                out))
            copies)]
        [_ copies])]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (match src
        [(CompilerIrValue.Var s)
          (if (and
            (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
            (opt-gvn-stable-var? sources dst)
            (opt-gvn-stable-var? sources s))
            (let
              [out : opt_i64_i64_map.Map copies]
              (begin
                (opt_i64_i64_map.insert-ref! (&mut out) dst s)
                out))
            copies)]
        [_ copies])]
    [_ copies]))

(define (opt-bounds-dom-copies-add-blocks
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) copies]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            [i : i64 0]
            [acc : opt_i64_i64_map.Map copies]
            (begin
              (while (< i count)
                (begin
                  (set!
                    acc
                    (opt-bounds-dom-copies-add-instr
                      sources
                      acc
                      (compiler-ir-instr-seq-ref instrs i)))
                  (set! i (+ i 1))))
              (opt-bounds-dom-copies-add-blocks sources acc (box-get rest))))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bounds-dom-copies-add-blocks
        sources
        copies
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-bounds-dom-resolve
  [copies : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var id)
      (let
        [cur : i64 id]
        [hops : i64 0]
        (begin
          (while (< hops 8)
            (match (opt_i64_i64_map.get (& copies) cur)
              [(opt_i64_i64_map.LookupFound next)
                (begin
                  (set! cur next)
                  (set! hops (+ hops 1)))]
              [(opt_i64_i64_map.LookupMissing) (set! hops 8)]))
          (if (= cur id)
            value
            (CompilerIrValue.Var cur))))]
    [_ value]))

;; --- dominating comparison facts --------------------------------------------
;;
;; A conditional branch decides its condition for the whole subtree dominated by
;; the edge it takes, so a later comparison of the same operands is a
;; compile-time constant. Both spellings count: `gt b a` canonicalizes to
;; `lt a b`, and `le a b` is the negation of `lt b a`. Restricted to integer
;; comparisons -- float negation is not a total order under NaN -- and to edge
;; targets whose only entry is that edge, so the fact really does hold
;; everywhere below.
(defenum OptDomCmpFact
  (Fact CompilerIrBinOp CompilerIrValue CompilerIrValue AstType bool))

(defenum OptDomCmpFacts
  (Nil)
  (Cons OptDomCmpFact (Box OptDomCmpFacts)))

(defenum OptDomCmpLookup
  (No)
  (Some bool))

(define (opt-dom-cmp-foldable-op? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Eq) true]
    [(CompilerIrBinOp.Ne) true]
    [(CompilerIrBinOp.Lt) true]
    [(CompilerIrBinOp.Le) true]
    [(CompilerIrBinOp.Gt) true]
    [(CompilerIrBinOp.Ge) true]
    [_ false]))

;; `gt`/`ge` are `lt`/`le` with the operands read the other way round.
(define (opt-dom-cmp-swapped? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Gt) true]
    [(CompilerIrBinOp.Ge) true]
    [_ false]))

(define (opt-dom-cmp-canon-op [op : CompilerIrBinOp]) : CompilerIrBinOp
  (match op
    [(CompilerIrBinOp.Gt) (CompilerIrBinOp.Lt)]
    [(CompilerIrBinOp.Ge) (CompilerIrBinOp.Le)]
    [_ op]))

(define (opt-dom-cmp-canon-lhs
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : CompilerIrValue
  (if (opt-dom-cmp-swapped? op)
    rhs
    lhs))

(define (opt-dom-cmp-canon-rhs
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : CompilerIrValue
  (if (opt-dom-cmp-swapped? op)
    lhs
    rhs))

;; Canonical negations: `not (lt a b)` is `le b a`, `not (le a b)` is `lt b a`,
;; and eq/ne negate in place.
(define (opt-dom-cmp-negated-op [op : CompilerIrBinOp]) : CompilerIrBinOp
  (match op
    [(CompilerIrBinOp.Lt) (CompilerIrBinOp.Le)]
    [(CompilerIrBinOp.Le) (CompilerIrBinOp.Lt)]
    [(CompilerIrBinOp.Eq) (CompilerIrBinOp.Ne)]
    [(CompilerIrBinOp.Ne) (CompilerIrBinOp.Eq)]
    [_ op]))

(define (opt-dom-cmp-negation-swaps? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Lt) true]
    [(CompilerIrBinOp.Le) true]
    [_ false]))

(define (opt-dom-cmp-lookup
  [type-segment-bases : i64]
  [facts : OptDomCmpFacts]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : OptDomCmpLookup
  (match facts
    [(OptDomCmpFacts.Nil) (OptDomCmpLookup.No)]
    [(OptDomCmpFacts.Cons fact rest)
      (match fact
        [(OptDomCmpFact.Fact fact-op fact-lhs fact-rhs fact-ty fact-value)
          (if (and
            (opt-type-eq type-segment-bases ty fact-ty)
            (opt-binop-eq op fact-op)
            (opt-value-eq lhs fact-lhs)
            (opt-value-eq rhs fact-rhs))
            (OptDomCmpLookup.Some fact-value)
            (if (and
              (opt-type-eq type-segment-bases ty fact-ty)
              (opt-binop-eq op (opt-dom-cmp-negated-op fact-op))
              (if (opt-dom-cmp-negation-swaps? fact-op)
                (and (opt-value-eq lhs fact-rhs) (opt-value-eq rhs fact-lhs))
                (and (opt-value-eq lhs fact-lhs) (opt-value-eq rhs fact-rhs))))
              (OptDomCmpLookup.Some (not fact-value))
              (opt-dom-cmp-lookup
                type-segment-bases
                (box-get rest)
                op
                lhs
                rhs
                ty)))])]))

;; The fact an edge into `taken?` establishes, given the branch condition's
;; defining comparison. Operands are resolved through the same copy map the
;; bounds facts use so both sides speak one spelling.
(define (opt-dom-cmp-edge-fact
  [defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [sources : opt_i64_i64_map.Map]
  [cond : CompilerIrValue]
  [taken? : bool]
  [facts : OptDomCmpFacts]) : OptDomCmpFacts
  (match cond
    [(CompilerIrValue.Var var)
      (match (opt-bool-branch-def defs var)
        [(OptBoolBranchDef.No) facts]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(CompilerIrInstr.BinOp _ op lhs rhs ty)
              (let
                [clhs : CompilerIrValue
                  (opt-bounds-dom-resolve
                    copies
                    (opt-dom-cmp-canon-lhs op lhs rhs))]
                [crhs : CompilerIrValue
                  (opt-bounds-dom-resolve
                    copies
                    (opt-dom-cmp-canon-rhs op lhs rhs))]
                (if (and
                  (opt-dom-cmp-foldable-op? op)
                  (opt-integer-type? ty)
                  (opt-gvn-value-stable? sources clhs)
                  (opt-gvn-value-stable? sources crhs))
                  (OptDomCmpFacts.Cons
                    (OptDomCmpFact.Fact
                      (opt-dom-cmp-canon-op op)
                      clhs
                      crhs
                      ty
                      taken?)
                    (box facts))
                  facts))]
            [_ facts])])]
    [_ facts]))

;; Phi definitions by destination, kept in a table of its own so the bool-branch
;; `defs` table stays BinOp-only and the passes reading it are untouched.
(define (opt-bounds-dom-phi-defs-fill-instrs!
  [defs : (Array OptBoolBranchDef)]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : unit
  (if (>= index (compiler-ir-instr-seq-count instrs))
    unit
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (begin
        (match instr
          [(CompilerIrInstr.Phi dst _ _)
            (if (and (>= dst 0) (< dst (array-length defs)))
              (array-set! defs dst (OptBoolBranchDef.Some instr label))
              unit)]
          [(CompilerIrInstr.Cast dst _ _ _)
            (if (and (>= dst 0) (< dst (array-length defs)))
              (array-set! defs dst (OptBoolBranchDef.Some instr label))
              unit)]
          [_ unit])
        (opt-bounds-dom-phi-defs-fill-instrs! defs label instrs (+ index 1))))))

(define (opt-bounds-dom-phi-defs-fill-blocks!
  [defs : (Array OptBoolBranchDef)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block label instrs)
            (opt-bounds-dom-phi-defs-fill-instrs! defs label instrs 0)])
        (opt-bounds-dom-phi-defs-fill-blocks! defs (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-bounds-dom-phi-defs-fill-blocks!
        defs
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-bounds-dom-phi-defs [frame : i64] [blocks : CompilerIrBlockList]) : (Array
    OptBoolBranchDef)
  (let
    [defs : (Array OptBoolBranchDef) (array.make-array OptBoolBranchDef frame)]
    [index : i64 0]
    (begin
      (while (< index frame)
        (begin
          (array-set! defs index (OptBoolBranchDef.No))
          (set! index (+ index 1))))
      (opt-bounds-dom-phi-defs-fill-blocks! defs blocks)
      defs)))

;; See through a same-width signed/unsigned reinterpretation. `bounds_check` is
;; lowered as an unsigned compare and its operands arrive as `i64 -> u64` casts,
;; so without this the mask shape is hidden behind a cast on both sides. Only the
;; 64-bit pair is unwrapped: the bit pattern is identical, so nothing about the
;; value's range changes. A widening or narrowing cast is left alone.
(define (opt-bounds-dom-int-cast-transparent?
  [type-segment-bases : i64]
  [from : AstType]
  [to : AstType]) : bool
  (or
    (and
      (opt-type-eq type-segment-bases from (AstType.I64))
      (opt-type-eq type-segment-bases to (AstType.U64)))
    (and
      (opt-type-eq type-segment-bases from (AstType.U64))
      (opt-type-eq type-segment-bases to (AstType.I64)))))

(define (opt-bounds-dom-strip-int-cast
  [type-segment-bases : i64]
  [extra-defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var var)
      (match (opt-bool-branch-def extra-defs var)
        [(OptBoolBranchDef.No) value]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(CompilerIrInstr.Cast _ source from to)
              (if (opt-bounds-dom-int-cast-transparent?
                type-segment-bases
                from
                to)
                (opt-bounds-dom-resolve copies source)
                value)]
            [_ value])])]
    [_ value]))

;; Is `value` the mask `len - 1` for this exact length value?
(define (opt-bounds-dom-len-minus-one?
  [defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [len : CompilerIrValue]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var)
      (match (opt-bool-branch-def defs var)
        [(OptBoolBranchDef.No) false]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(CompilerIrInstr.BinOp _ op lhs rhs ty)
              (and
                (opt-integer-type? ty)
                (opt-value-eq (opt-bounds-dom-resolve copies lhs) len)
                (or
                  (and
                    (opt-binop-eq op (CompilerIrBinOp.Sub))
                    (match rhs
                      [(CompilerIrValue.I64 one) (= one 1)]
                      [_ false]))
                  (and
                    (opt-binop-eq op (CompilerIrBinOp.Add))
                    (match rhs
                      [(CompilerIrValue.I64 minus-one) (= minus-one (- 0 1))]
                      [_ false]))))]
            [_ false])])]
    [_ false]))

;; Do the facts in scope prove `len >= 1`? A dominating `len >= 1` or `len < 1`
;; edge answers it, and so does a length that is already a positive literal.
(define (opt-bounds-dom-len-positive?
  [type-segment-bases : i64]
  [cmp-facts : OptDomCmpFacts]
  [len : CompilerIrValue]) : bool
  (or
    (match len
      [(CompilerIrValue.I64 count) (>= count 1)]
      [_ false])
    (match (opt-dom-cmp-lookup
      type-segment-bases
      cmp-facts
      (CompilerIrBinOp.Lt)
      len
      (CompilerIrValue.I64 1)
      (AstType.I64))
      [(OptDomCmpLookup.Some value) (not value)]
      [(OptDomCmpLookup.No) false])
    (match (opt-dom-cmp-lookup
      type-segment-bases
      cmp-facts
      (CompilerIrBinOp.Le)
      (CompilerIrValue.I64 1)
      len
      (AstType.I64))
      [(OptDomCmpLookup.Some value) value]
      [(OptDomCmpLookup.No) false])
    ;; `(<= len 0)` guarding an empty-table early return is the other common way
    ;; this gets written, and it decides positivity on its false edge.
    (match (opt-dom-cmp-lookup
      type-segment-bases
      cmp-facts
      (CompilerIrBinOp.Le)
      len
      (CompilerIrValue.I64 0)
      (AstType.I64))
      [(OptDomCmpLookup.Some value) (not value)]
      [(OptDomCmpLookup.No) false])
    (match (opt-dom-cmp-lookup
      type-segment-bases
      cmp-facts
      (CompilerIrBinOp.Lt)
      (CompilerIrValue.I64 0)
      len
      (AstType.I64))
      [(OptDomCmpLookup.Some value) value]
      [(OptDomCmpLookup.No) false])))

;; --- loop-carried counter in range -------------------------------------------
;;
;; A rotated loop puts its per-iteration test at the LATCH, after the body, so no
;; single comparison dominating the body proves `i < n`. The invariant is still
;; there, just spread across the incoming edges: the preheader enters with the
;; seed and the trip-count test, the latch enters having just tested the stepped
;; value. Proving it therefore means discharging each phi input on its own edge:
;;
;;   i = phi [0, preheader], [i + 1, latch]
;;     preheader edge: a dominating fact gives `0 < n`
;;     latch edge:     the latch's own branch tested `i + 1 < n` and took the
;;                     edge into this block on the true side
;;
;; With `i >= 0` implied by a nonnegative seed and positive steps, the unsigned
;; `bounds_check` is then dead.
;; Terminator branch per block id, so a phi input's source label can be resolved
;; back to the test that guarded its edge.
(define (opt-bounds-dom-terms-fill!
  [terms : (Array OptBoolBranchDef)]
  [index : OptCfgIndex]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block label instrs)
            (let
              [count : i64 (compiler-ir-instr-seq-count instrs)]
              (if (< count 1)
                unit
                (match (opt-cfg-index-id index label)
                  [(option_i64.None) unit]
                  [(option_i64.Some id)
                    (if (and (>= id 0) (< id (array-length terms)))
                      (match (compiler-ir-instr-seq-ref instrs (- count 1))
                        [(CompilerIrInstr.Branch cond true-label false-label)
                          (array-set!
                            terms
                            id
                            (OptBoolBranchDef.Some
                              (CompilerIrInstr.Branch
                                cond
                                true-label
                                false-label)
                              label))]
                        [_ unit])
                      unit)])))])
        (opt-bounds-dom-terms-fill! terms index (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-bounds-dom-terms-fill!
        terms
        index
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-bounds-dom-terms
  [index : OptCfgIndex]
  [blocks : CompilerIrBlockList]) : (Array OptBoolBranchDef)
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [terms : (Array OptBoolBranchDef) (array.make-array OptBoolBranchDef count)]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! terms i (OptBoolBranchDef.No))
          (set! i (+ i 1))))
      (opt-bounds-dom-terms-fill! terms index blocks)
      terms)))

;; Does the branch ending `from-label` test exactly `stepped < len` and enter
;; `to-label` on the side that makes the test true? Both edges landing on
;; `to-label` proves nothing, so that is rejected.
(define (opt-bounds-dom-edge-tests-lt?
  [index : OptCfgIndex]
  [terms : (Array OptBoolBranchDef)]
  [defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [from-label : i64]
  [to-label : i64]
  [stepped : CompilerIrValue]
  [len : CompilerIrValue]) : bool
  (match (opt-cfg-index-id index from-label)
    [(option_i64.None) false]
    [(option_i64.Some id)
      (if (or (< id 0) (>= id (array-length terms)))
        false
        (match (array-ref terms id)
          [(OptBoolBranchDef.No) false]
          [(OptBoolBranchDef.Some instr _)
            (match instr
              [(CompilerIrInstr.Branch cond true-label false-label)
                (and
                  (= true-label to-label)
                  (not (= false-label to-label))
                  (match cond
                    [(CompilerIrValue.Var var)
                      (match (opt-bool-branch-def defs var)
                        [(OptBoolBranchDef.No) false]
                        [(OptBoolBranchDef.Some cond-instr _)
                          (match cond-instr
                            [(CompilerIrInstr.BinOp _ op lhs rhs ty)
                              (and
                                (opt-binop-eq op (CompilerIrBinOp.Lt))
                                (opt-integer-type? ty)
                                (opt-value-eq
                                  (opt-bounds-dom-resolve copies lhs)
                                  stepped)
                                (opt-value-eq
                                  (opt-bounds-dom-resolve copies rhs)
                                  len))]
                            [_ false])])]
                    [_ false]))]
              [_ false])]))]))

;; One phi input, discharged on its own edge: a literal seed needs a dominating
;; `seed < len`; anything else must be `self + k` for a positive literal k whose
;; edge was guarded by `self + k < len`.
(define (opt-bounds-dom-counter-input-ok?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [terms : (Array OptBoolBranchDef)]
  [defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [block-label : i64]
  [self : i64]
  [len : CompilerIrValue]
  [value : CompilerIrValue]
  [from-label : i64]) : bool
  (match value
    [(CompilerIrValue.I64 seed)
      (and
        (>= seed 0)
        (match (opt-dom-cmp-lookup
          type-segment-bases
          cmp-facts
          (CompilerIrBinOp.Lt)
          (CompilerIrValue.I64 seed)
          len
          (AstType.I64))
          [(OptDomCmpLookup.Some decided) decided]
          [(OptDomCmpLookup.No) false]))]
    [(CompilerIrValue.Var var)
      (and
        (match (opt-bool-branch-def defs var)
          [(OptBoolBranchDef.No) false]
          [(OptBoolBranchDef.Some instr _)
            (match instr
              [(CompilerIrInstr.BinOp _ op lhs rhs ty)
                (and
                  (opt-binop-eq op (CompilerIrBinOp.Add))
                  (opt-integer-type? ty)
                  (match (opt-bounds-dom-resolve copies lhs)
                    [(CompilerIrValue.Var base) (= base self)]
                    [_ false])
                  (match rhs
                    [(CompilerIrValue.I64 step) (> step 0)]
                    [_ false]))]
              [_ false])])
        (opt-bounds-dom-edge-tests-lt?
          index
          terms
          defs
          copies
          from-label
          block-label
          value
          len))]
    [_ false]))

(define (opt-bounds-dom-counter-inputs-ok?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [terms : (Array OptBoolBranchDef)]
  [defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [block-label : i64]
  [self : i64]
  [len : CompilerIrValue]
  [inputs : CompilerIrPhiInputList]) : bool
  (match inputs
    [(CompilerIrPhiInputList.Nil) false]
    [(CompilerIrPhiInputList.Cons value from-label rest)
      (and
        (opt-bounds-dom-counter-input-ok?
          type-segment-bases
          index
          terms
          defs
          copies
          cmp-facts
          block-label
          self
          len
          (opt-bounds-dom-resolve copies value)
          from-label)
        (match (box-get rest)
          [(CompilerIrPhiInputList.Nil) true]
          [_
            (opt-bounds-dom-counter-inputs-ok?
              type-segment-bases
              index
              terms
              defs
              copies
              cmp-facts
              block-label
              self
              len
              (box-get rest))]))]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bounds-dom-counter-inputs-ok?
        type-segment-bases
        index
        terms
        defs
        copies
        cmp-facts
        block-label
        self
        len
        (compiler-ir-phi-input-seq-to-list seq))]))

(define (opt-bounds-dom-counter-in-range?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [terms : (Array OptBoolBranchDef)]
  [defs : (Array OptBoolBranchDef)]
  [phi-defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [block-label : i64]
  [idx : CompilerIrValue]
  [len : CompilerIrValue]) : bool
  (match idx
    [(CompilerIrValue.Var var)
      (match (opt-bool-branch-def phi-defs var)
        [(OptBoolBranchDef.No) false]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(CompilerIrInstr.Phi dst inputs ty)
              (and
                (opt-integer-type? ty)
                (opt-bounds-dom-counter-inputs-ok?
                  type-segment-bases
                  index
                  terms
                  defs
                  copies
                  cmp-facts
                  block-label
                  dst
                  len
                  inputs))]
            [_ false])])]
    [_ false]))

;; `bit-and X m` lands in [0, m] for every nonnegative m: bit-and only clears
;; bits, so the result cannot exceed m, and a nonnegative m has a clear sign bit
;; so the result cannot go negative. With `m = len - 1` that puts the index in
;; [0, len) and the check is dead. No power-of-two assumption is involved.
;;
;; `len >= 1` is load-bearing, not a formality: at `len = 0` the mask is -1,
;; `X & -1 = X` is unbounded, and the check must stay to trap. Hence the guard
;; fact requirement -- masking alone proves nothing about an empty array.
(define (opt-bounds-dom-masked-value?
  [defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [len : CompilerIrValue]
  [idx : CompilerIrValue]) : bool
  (match idx
    [(CompilerIrValue.Var var)
      (match (opt-bool-branch-def defs var)
        [(OptBoolBranchDef.No) false]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(CompilerIrInstr.BinOp _ op lhs rhs ty)
              (and
                (opt-binop-eq op (CompilerIrBinOp.BitAnd))
                (opt-integer-type? ty)
                (or
                  (opt-bounds-dom-len-minus-one?
                    defs
                    copies
                    len
                    (opt-bounds-dom-resolve copies rhs))
                  (opt-bounds-dom-len-minus-one?
                    defs
                    copies
                    len
                    (opt-bounds-dom-resolve copies lhs))))]
            [_ false])])]
    [_ false]))

;; Every input of the phi masked against this same length. A loop-carried probe
;; cursor is exactly this shape: the preheader seeds `hash & mask` and the latch
;; feeds `(cursor + 1) & mask`, so the phi is bounded even though neither the
;; seed nor the step is loop-invariant. Phi inputs are only ever tested as plain
;; masked values, so a phi of a phi answers false rather than recursing.
;; Masked directly, or a phi every input of which is masked against this same
;; length. `depth` bounds the phi recursion: a loop-carried cursor is commonly a
;; phi whose input is another phi (one per exit path of the match), and phis can
;; reference each other cyclically, so the depth counter is what guarantees
;; termination rather than any structural property of the graph.
(define (opt-bounds-dom-masked-or-phi?
  [defs : (Array OptBoolBranchDef)]
  [phi-defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [len : CompilerIrValue]
  [value : CompilerIrValue]
  [depth : i64]) : bool
  (or
    (opt-bounds-dom-masked-value? defs copies len value)
    (and
      (> depth 0)
      (match value
        [(CompilerIrValue.Var var)
          (match (opt-bool-branch-def phi-defs var)
            [(OptBoolBranchDef.No) false]
            [(OptBoolBranchDef.Some instr _)
              (match instr
                [(CompilerIrInstr.Phi _ inputs ty)
                  (and
                    (opt-integer-type? ty)
                    (opt-bounds-dom-phi-inputs-masked?
                      defs
                      phi-defs
                      copies
                      len
                      inputs
                      (- depth 1)))]
                [_ false])])]
        [_ false]))))

(define (opt-bounds-dom-phi-inputs-masked?
  [defs : (Array OptBoolBranchDef)]
  [phi-defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [len : CompilerIrValue]
  [inputs : CompilerIrPhiInputList]
  [depth : i64]) : bool
  (match inputs
    [(CompilerIrPhiInputList.Nil) false]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (and
        (opt-bounds-dom-masked-or-phi?
          defs
          phi-defs
          copies
          len
          (opt-bounds-dom-resolve copies value)
          depth)
        (match (box-get rest)
          [(CompilerIrPhiInputList.Nil) true]
          [_
            (opt-bounds-dom-phi-inputs-masked?
              defs
              phi-defs
              copies
              len
              (box-get rest)
              depth)]))]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bounds-dom-phi-inputs-masked?
        defs
        phi-defs
        copies
        len
        (compiler-ir-phi-input-seq-to-list seq)
        depth)]))

(define (opt-bounds-dom-mask-in-range?
  [type-segment-bases : i64]
  [defs : (Array OptBoolBranchDef)]
  [phi-defs : (Array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [raw-idx : CompilerIrValue]
  [raw-len : CompilerIrValue]) : bool
  (let
    [idx : CompilerIrValue
      (opt-bounds-dom-strip-int-cast type-segment-bases phi-defs copies raw-idx)]
    [len : CompilerIrValue
      (opt-bounds-dom-strip-int-cast type-segment-bases phi-defs copies raw-len)]
    (and
      (opt-bounds-dom-len-positive? type-segment-bases cmp-facts len)
      (opt-bounds-dom-masked-or-phi? defs phi-defs copies len idx 4))))

(define (opt-bounds-dom-instrs-from
  [type-segment-bases : i64]
  [defs : (Array OptBoolBranchDef)]
  [phi-defs : (Array OptBoolBranchDef)]
  [terms : (Array OptBoolBranchDef)]
  [cfg-index : OptCfgIndex]
  [block-label : i64]
  [cmp-facts : OptDomCmpFacts]
  [facts : OptBoundsFacts]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptBoundsDomWalk
  ;; Retain-only walk (drops bounds checks a dominating check/comparison already
  ;; proved, folds decided comparisons), so the output length is not known up
  ;; front: it goes into the capacity-managed dense builder seeded at the input
  ;; length. This used to be a tail-consing recursion -- recurse first, cons the
  ;; head onto the returned tail -- which built the whole block as a 112 B-per-
  ;; instruction spine that `compiler-ir-block` then re-counted and re-copied.
  ;; The facts/cmp-facts threading was already strictly forward (each step hands
  ;; the NEXT step its updated facts and the head is emitted with the facts that
  ;; were current when it was read), so the loop below threads them the same way
  ;; and pushes in the same order. Output is fresh; `instrs` is untouched.
  ;; refs #5726
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [builder : CompilerIrInstrBuilder
      (compiler-ir-instr-builder-with-capacity
        (if (< index count)
          (- count index)
          1))]
    [cur-facts : OptBoundsFacts facts]
    [cur-cmp-facts : OptDomCmpFacts cmp-facts]
    [pos : i64 index]
    (begin
      (while (< pos count)
        (let
          [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs pos)]
          (begin
            (match instr
              [(CompilerIrInstr.BoundsCheck idx len _)
                (let
                  [cidx : CompilerIrValue (opt-bounds-dom-resolve copies idx)]
                  [clen : CompilerIrValue (opt-bounds-dom-resolve copies len)]
                  (if (or
                    (opt-bounds-contains cur-facts cidx clen)
                    (opt-bounds-dom-mask-in-range?
                      type-segment-bases
                      defs
                      phi-defs
                      copies
                      cur-cmp-facts
                      cidx
                      clen)
                    (opt-bounds-dom-counter-in-range?
                      type-segment-bases
                      cfg-index
                      terms
                      defs
                      phi-defs
                      copies
                      cur-cmp-facts
                      block-label
                      (opt-bounds-dom-strip-int-cast
                        type-segment-bases
                        phi-defs
                        copies
                        cidx)
                      (opt-bounds-dom-strip-int-cast
                        type-segment-bases
                        phi-defs
                        copies
                        clen)))
                    unit
                    (let
                      [stable? : bool
                        (and
                          (opt-gvn-value-stable? sources cidx)
                          (opt-gvn-value-stable? sources clen))]
                      (begin
                        (compiler-ir-instr-builder-push! (&mut builder) instr)
                        ;; A passed bounds check is an unsigned `idx < len`
                        ;; whose length operand is a runtime container length,
                        ;; so len is always < 2^63: the continuation also
                        ;; proves 0 <= idx < len in the SIGNED domain. Record
                        ;; both lt spellings so the dominating-comparison fold
                        ;; kills a later redundant signed test (`le idx len`,
                        ;; `gt len idx`, ...) -- e.g. a loop-versioning guard
                        ;; condition that repeats what a dominating access
                        ;; already checked.
                        (if stable?
                          (begin
                            (set!
                              cur-cmp-facts
                              (OptDomCmpFacts.Cons
                                (OptDomCmpFact.Fact
                                  (CompilerIrBinOp.Lt)
                                  cidx
                                  clen
                                  (AstType.I64)
                                  true)
                                (box
                                  (OptDomCmpFacts.Cons
                                    (OptDomCmpFact.Fact
                                      (CompilerIrBinOp.Lt)
                                      clen
                                      cidx
                                      (AstType.I64)
                                      false)
                                    (box cur-cmp-facts)))))
                            (set!
                              cur-facts
                              (opt-bounds-add cur-facts cidx clen)))
                          unit)))))]
              [_
                (compiler-ir-instr-builder-push!
                  (&mut builder)
                  (opt-bounds-dom-fold-compare
                    type-segment-bases
                    cur-cmp-facts
                    copies
                    instr))])
            (set! pos (+ pos 1)))))
      (OptBoundsDomWalk.Walk
        (compiler-ir-instr-builder-to-seq builder)
        cur-facts
        cur-cmp-facts))))

;; Replace a comparison a dominating branch already decided with its constant.
;; The move keeps the destination and bool type, so every consumer -- branch,
;; select, phi input -- sees an ordinary constant and the later fold/cfg passes
;; collapse the control flow.
(define (opt-bounds-dom-fold-compare
  [type-segment-bases : i64]
  [cmp-facts : OptDomCmpFacts]
  [copies : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (and (opt-dom-cmp-foldable-op? op) (opt-integer-type? ty))
        (match (opt-dom-cmp-lookup
          type-segment-bases
          cmp-facts
          (opt-dom-cmp-canon-op op)
          (opt-bounds-dom-resolve copies (opt-dom-cmp-canon-lhs op lhs rhs))
          (opt-bounds-dom-resolve copies (opt-dom-cmp-canon-rhs op lhs rhs))
          ty)
          [(OptDomCmpLookup.No) instr]
          [(OptDomCmpLookup.Some value)
            (CompilerIrInstr.Mov
              dst
              (CompilerIrValue.Bool value)
              (AstType.Bool))])
        instr)]
    [_ instr]))

(define (opt-bounds-dom-rewrite-id
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [defs : (Array OptBoolBranchDef)]
  [phi-defs : (Array OptBoolBranchDef)]
  [terms : (Array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [facts : OptBoundsFacts]
  [blocks : CompilerIrBlockList]
  [out : (Array OptGvnBlockResult)]
  [id : i64]) : unit
  (let
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and (>= id 0) (< id count))
      (let
        [label : i64 (array-ref (struct-get index labels) id)]
        (match (opt-cfg-index-block index id)
          [(OptMaybeBlock.No) unit]
          [(OptMaybeBlock.Some block)
            (match block
              [(CompilerIrBlock.Block _ instrs)
                (match (opt-bounds-dom-instrs-from
                  type-segment-bases
                  defs
                  phi-defs
                  terms
                  index
                  label
                  cmp-facts
                  facts
                  sources
                  copies
                  instrs
                  0)
                  [(OptBoundsDomWalk.Walk rewritten out-facts out-cmp-facts)
                    (begin
                      (array-set!
                        out
                        id
                        (OptGvnBlockResult.SomeBlock
                          (CompilerIrBlock.Block label rewritten)))
                      (opt-bounds-dom-rewrite-children
                        type-segment-bases
                        context
                        children
                        defs
                        phi-defs
                        terms
                        sources
                        copies
                        out-cmp-facts
                        out-facts
                        blocks
                        out
                        id
                        instrs))])])]))
      unit)))

;; The number of predecessors a block has, straight off the CFG index rows.
;; Is `child-id` entered ONLY through the edge from `parent-id`? Every other
;; reachable predecessor must sit inside the child's own dominator subtree, which
;; makes it a backedge: control only got there by passing through the child, and
;; therefore through the parent's edge, already. Unreachable predecessors carry no
;; path at all. A loop header satisfies this -- its preds are the guard block and
;; its own latch -- which is what lets a loop-invariant guard fact reach the body.
(define (opt-bounds-dom-child-entered-only-via?
  [info : OptDomInfo]
  [index : OptCfgIndex]
  [parent-id : i64]
  [child-id : i64]) : bool
  (let
    [preds : OptCfgCsr (struct-get index preds)]
    [offsets : (Array i64) (struct-get preds offsets)]
    [edges : (Array i64) (struct-get preds edges)]
    (if (or (< child-id 0) (>= (+ child-id 1) (array-length offsets)))
      false
      (let
        [edge : i64 (array-ref offsets child-id)]
        [end : i64 (array-ref offsets (+ child-id 1))]
        [only : bool true]
        (begin
          (while (< edge end)
            (begin
              (let
                [pred : i64 (array-ref edges edge)]
                (if (or
                  (= pred parent-id)
                  (not (array-ref (struct-get index reachable) pred))
                  (opt-dom-info-dominates-id? info child-id pred))
                  unit
                  (set! only false)))
              (set! edge (+ edge 1))))
          only)))))

;; Facts to carry into one dominator child: the parent's branch decides its
;; condition for a target the branch is the ONLY way into. A target reachable
;; without taking this edge keeps the parent's facts unchanged.
(define (opt-bounds-dom-child-cmp-facts
  [info : OptDomInfo]
  [index : OptCfgIndex]
  [defs : (Array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [parent-instrs : CompilerIrInstrSeq]
  [parent-id : i64]
  [child-id : i64]) : OptDomCmpFacts
  (let
    [count : i64 (compiler-ir-instr-seq-count parent-instrs)]
    (if (or
      (< count 1)
      (not
        (opt-bounds-dom-child-entered-only-via? info index parent-id child-id)))
      cmp-facts
      (match (compiler-ir-instr-seq-ref parent-instrs (- count 1))
        [(CompilerIrInstr.Branch cond true-label false-label)
          (let
            [child-label : i64 (array-ref (struct-get index labels) child-id)]
            (cond
              ;; A branch whose edges share one label decides nothing about it.
              [(= true-label false-label) cmp-facts]
              [(= child-label true-label)
                (opt-dom-cmp-edge-fact defs copies sources cond true cmp-facts)]
              [(= child-label false-label)
                (opt-dom-cmp-edge-fact defs copies sources cond false cmp-facts)]
              [else cmp-facts]))]
        [_ cmp-facts]))))

(define (opt-bounds-dom-rewrite-children
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [defs : (Array OptBoolBranchDef)]
  [phi-defs : (Array OptBoolBranchDef)]
  [terms : (Array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [facts : OptBoundsFacts]
  [blocks : CompilerIrBlockList]
  [out : (Array OptGvnBlockResult)]
  [parent-id : i64]
  [parent-instrs : CompilerIrInstrSeq]) : unit
  (let
    [index : OptCfgIndex (struct-get context index)]
    [offsets : (Array i64) (struct-get children offsets)]
    [edges : (Array i64) (struct-get children edges)]
    [edge : i64 (array-ref offsets parent-id)]
    [end : i64 (array-ref offsets (+ parent-id 1))]
    (begin
      (while (< edge end)
        (begin
          (let
            [child-id : i64 (array-ref edges edge)]
            (opt-bounds-dom-rewrite-id
              type-segment-bases
              context
              children
              defs
              phi-defs
              terms
              sources
              copies
              (opt-bounds-dom-child-cmp-facts
                (struct-get context doms)
                index
                defs
                sources
                copies
                cmp-facts
                parent-instrs
                parent-id
                child-id)
              facts
              blocks
              out
              child-id))
          (set! edge (+ edge 1))))
      unit)))

(define (opt-bounds-dom-blocks-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [frame : i64]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [sources : opt_i64_i64_map.Map
      (opt-gvn-sources-blocks
        blocks
        (opt-gvn-sources-params params (opt_i64_i64_map.with-capacity 64)))]
    [copies : opt_i64_i64_map.Map
      (opt-bounds-dom-copies-add-blocks
        sources
        (opt_i64_i64_map.with-capacity 64)
        blocks)]
    [doms : OptDomInfo (struct-get context doms)]
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    [children : OptCfgCsr (opt-gvn-dom-children doms)]
    [defs : (Array OptBoolBranchDef) (opt-bool-branch-defs frame blocks)]
    [phi-defs : (Array OptBoolBranchDef) (opt-bounds-dom-phi-defs frame blocks)]
    [terms : (Array OptBoolBranchDef) (opt-bounds-dom-terms index blocks)]
    [out : (Array OptGvnBlockResult) (array.make-array OptGvnBlockResult count)]
    (begin
      (opt-cfg-index-refresh-blocks! index blocks)
      (opt-gvn-block-results-fill-empty! out 0)
      (match (opt-cfg-index-id index (struct-get context entry-label))
        [(option_i64.Some entry-id)
          (if (and
            (>= entry-id 0)
            (array-ref (struct-get index reachable) entry-id))
            (opt-bounds-dom-rewrite-id
              type-segment-bases
              context
              children
              defs
              phi-defs
              terms
              sources
              copies
              (OptDomCmpFacts.Nil)
              (OptBoundsFacts.Nil)
              blocks
              out
              entry-id)
            unit)]
        [(option_i64.None) unit])
      (opt-gvn-materialize-blocks doms out blocks))))

;; --- proven-safe div/rem guard elision --------------------------------------
;;
;; This pass marks integer div/rem as non-trapping only from facts established by
;; explicit dominating CFG edge checks. It deliberately ignores casts and joins:
;; a fact reaches a successor only when that successor has exactly one reachable
;; predecessor, so facts are never accidentally unioned across paths.
(defenum OptDivRemFactKind
  (NonZero)
  (NotNegOne)
  (NotSignedMin))

(defenum OptDivRemFact
  (Fact i64 AstType OptDivRemFactKind))

(defenum OptDivRemFacts
  (Nil)
  (Cons OptDivRemFact (Box OptDivRemFacts)))

(defenum OptDivRemCmp
  (NoCmp)
  (Cmp CompilerIrBinOp CompilerIrValue CompilerIrValue AstType i64))

(defenum OptDivRemBlockResult
  (NoBlock)
  (SomeBlock CompilerIrBlock))

(defenum OptDivRemInstrRewrite
  (Rewrite OptDivRemFacts CompilerIrInstrSeq))

(defenum OptDivRemBlockRewrite
  (Rewrite CompilerIrBlock OptDivRemFacts))

(define (opt-divrem-fact-kind-eq?
  [a : OptDivRemFactKind]
  [b : OptDivRemFactKind]) : bool
  (match a
    [(OptDivRemFactKind.NonZero)
      (match b
        [(OptDivRemFactKind.NonZero) true]
        [_ false])]
    [(OptDivRemFactKind.NotNegOne)
      (match b
        [(OptDivRemFactKind.NotNegOne) true]
        [_ false])]
    [(OptDivRemFactKind.NotSignedMin)
      (match b
        [(OptDivRemFactKind.NotSignedMin) true]
        [_ false])]))

(define (opt-divrem-facts-contains-kind?
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [kind : OptDivRemFactKind]) : bool
  (match facts
    [(OptDivRemFacts.Nil) false]
    [(OptDivRemFacts.Cons fact rest)
      (match fact
        [(OptDivRemFact.Fact fact-var fact-ty fact-kind)
          (if (and
            (= fact-var var)
            (opt-type-eq type-segment-bases fact-ty ty)
            (opt-divrem-fact-kind-eq? fact-kind kind))
            true
            (opt-divrem-facts-contains-kind?
              type-segment-bases
              (box-get rest)
              var
              ty
              kind))])]))

(define (opt-divrem-facts-add-kind
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [kind : OptDivRemFactKind]) : OptDivRemFacts
  (if (opt-divrem-facts-contains-kind? type-segment-bases facts var ty kind)
    facts
    (OptDivRemFacts.Cons (OptDivRemFact.Fact var ty kind) (box facts))))

(define (opt-divrem-facts-remove-var [facts : OptDivRemFacts] [var : i64]) : OptDivRemFacts
  (match facts
    [(OptDivRemFacts.Nil) (OptDivRemFacts.Nil)]
    [(OptDivRemFacts.Cons fact rest)
      (match fact
        [(OptDivRemFact.Fact fact-var _ _)
          (let
            [rest2 : OptDivRemFacts
              (opt-divrem-facts-remove-var (box-get rest) var)]
            (if (= fact-var var)
              rest2
              (OptDivRemFacts.Cons fact (box rest2))))])]))

(define (opt-divrem-add-nonzero
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]) : OptDivRemFacts
  (opt-divrem-facts-add-kind
    type-segment-bases
    facts
    var
    ty
    (OptDivRemFactKind.NonZero)))

(define (opt-divrem-add-not-neg-one
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]) : OptDivRemFacts
  (opt-divrem-facts-add-kind
    type-segment-bases
    facts
    var
    ty
    (OptDivRemFactKind.NotNegOne)))

(define (opt-divrem-add-not-signed-min
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]) : OptDivRemFacts
  (opt-divrem-facts-add-kind
    type-segment-bases
    facts
    var
    ty
    (OptDivRemFactKind.NotSignedMin)))

(define (opt-divrem-add-exact-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (!= value 0)
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (!= value (- 0 1)))
        (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (!= value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min type-segment-bases not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-not-eq-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (= value 0)
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (= value (- 0 1)))
        (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (= value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min type-segment-bases not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-gt-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (opt-typed-ge? value 0 ty)
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (>= value (- 0 1)))
        (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (>= value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min type-segment-bases not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-ge-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (opt-typed-gt? value 0 ty)
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (>= value 0))
        (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (> value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min type-segment-bases not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-lt-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (<= value 0))
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    (if (and (opt-signed-integer-type? ty) (<= value (- 0 1)))
      (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
      nonzero)))

(define (opt-divrem-add-le-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (< value 0))
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    (if (and (opt-signed-integer-type? ty) (<= value (- 0 2)))
      (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
      nonzero)))

(define (opt-divrem-add-compare-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [op : CompilerIrBinOp]
  [value : i64]) : OptDivRemFacts
  (if (not (opt-integer-type? ty))
    facts
    (match op
      [(CompilerIrBinOp.Eq)
        (opt-divrem-add-exact-facts type-segment-bases facts var ty value)]
      [(CompilerIrBinOp.Ne)
        (opt-divrem-add-not-eq-facts type-segment-bases facts var ty value)]
      [(CompilerIrBinOp.Gt)
        (opt-divrem-add-gt-facts type-segment-bases facts var ty value)]
      [(CompilerIrBinOp.Ge)
        (opt-divrem-add-ge-facts type-segment-bases facts var ty value)]
      [(CompilerIrBinOp.Lt)
        (opt-divrem-add-lt-facts type-segment-bases facts var ty value)]
      [(CompilerIrBinOp.Le)
        (opt-divrem-add-le-facts type-segment-bases facts var ty value)]
      [_ facts])))

(define (opt-divrem-invert-compare [op : CompilerIrBinOp]) : CompilerIrBinOp
  (match op
    [(CompilerIrBinOp.Eq) (CompilerIrBinOp.Ne)]
    [(CompilerIrBinOp.Ne) (CompilerIrBinOp.Eq)]
    [(CompilerIrBinOp.Lt) (CompilerIrBinOp.Ge)]
    [(CompilerIrBinOp.Le) (CompilerIrBinOp.Gt)]
    [(CompilerIrBinOp.Gt) (CompilerIrBinOp.Le)]
    [(CompilerIrBinOp.Ge) (CompilerIrBinOp.Lt)]
    [_ op]))

(define (opt-divrem-flip-compare [op : CompilerIrBinOp]) : CompilerIrBinOp
  (match op
    [(CompilerIrBinOp.Lt) (CompilerIrBinOp.Gt)]
    [(CompilerIrBinOp.Le) (CompilerIrBinOp.Ge)]
    [(CompilerIrBinOp.Gt) (CompilerIrBinOp.Lt)]
    [(CompilerIrBinOp.Ge) (CompilerIrBinOp.Le)]
    [_ op]))

(define (opt-divrem-edge-compare-op
  [op : CompilerIrBinOp]
  [truthy-edge? : bool]) : CompilerIrBinOp
  (if truthy-edge?
    op
    (opt-divrem-invert-compare op)))

(define (opt-divrem-compare-op? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Eq) true]
    [(CompilerIrBinOp.Ne) true]
    [(CompilerIrBinOp.Lt) true]
    [(CompilerIrBinOp.Le) true]
    [(CompilerIrBinOp.Gt) true]
    [(CompilerIrBinOp.Ge) true]
    [_ false]))

(define (opt-divrem-value-type
  [types : OptSsaVarTypes]
  [value : CompilerIrValue]
  [fallback : AstType]) : AstType
  (match value
    [(CompilerIrValue.Var var)
      (match (opt-ssa-var-type-lookup types var)
        [(OptMaybeAstType.Some ty) ty]
        [(OptMaybeAstType.No) fallback])]
    [_ fallback]))

(define (opt-divrem-add-edge-facts-from-cmp
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [instrs : CompilerIrInstrSeq]
  [cmp-index : i64]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : OptDivRemFacts
  (let
    [operand-ty : AstType
      (match lhs
        [(CompilerIrValue.Var _) (opt-divrem-value-type types lhs ty)]
        [_ (opt-divrem-value-type types rhs ty)])]
    (match lhs
      [(CompilerIrValue.Var var)
        (if (opt-divrem-var-defined-at-or-after? instrs cmp-index var)
          facts
          (match (opt-normalize-scalar-to-i64 rhs operand-ty)
            [(option_i64.Some value)
              (opt-divrem-add-compare-facts
                type-segment-bases
                facts
                var
                operand-ty
                op
                value)]
            [(option_i64.None) facts]))]
      [_
        (match rhs
          [(CompilerIrValue.Var var)
            (if (opt-divrem-var-defined-at-or-after? instrs cmp-index var)
              facts
              (match (opt-normalize-scalar-to-i64 lhs operand-ty)
                [(option_i64.Some value)
                  (opt-divrem-add-compare-facts
                    type-segment-bases
                    facts
                    var
                    operand-ty
                    (opt-divrem-flip-compare op)
                    value)]
                [(option_i64.None) facts]))]
          [_ facts])])))

(define (opt-divrem-edge-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [instrs : CompilerIrInstrSeq]
  [cond : CompilerIrValue]
  [truthy-edge? : bool]) : OptDivRemFacts
  (match cond
    [(CompilerIrValue.Var cond-var)
      (match (opt-divrem-find-cmp-def instrs cond-var)
        [(OptDivRemCmp.Cmp op lhs rhs ty cmp-index)
          (opt-divrem-add-edge-facts-from-cmp
            type-segment-bases
            facts
            types
            instrs
            cmp-index
            (opt-divrem-edge-compare-op op truthy-edge?)
            lhs
            rhs
            ty)]
        [(OptDivRemCmp.NoCmp) facts])]
    [_ facts]))

(define (opt-divrem-find-cmp-def-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [cond-var : i64]) : OptDivRemCmp
  (if (< index 0)
    (OptDivRemCmp.NoCmp)
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.BinOp dst op lhs rhs ty)
        (if (and (= dst cond-var) (opt-divrem-compare-op? op))
          (OptDivRemCmp.Cmp op lhs rhs ty index)
          (opt-divrem-find-cmp-def-from instrs (- index 1) cond-var))]
      [_ (opt-divrem-find-cmp-def-from instrs (- index 1) cond-var)])))

(define (opt-divrem-find-cmp-def [instrs : CompilerIrInstrSeq] [cond-var : i64]) : OptDivRemCmp
  (opt-divrem-find-cmp-def-from
    instrs
    (- (compiler-ir-instr-seq-count instrs) 1)
    cond-var))

(define (opt-divrem-instr-def-var [instr : CompilerIrInstr]) : option_i64.Option
  (match instr
    [(CompilerIrInstr.CallIndirect dst _ _ _) (option_i64.Some dst)]
    [(CompilerIrInstr.CallIndirectC dst _ _ _) (option_i64.Some dst)]
    [_ (opt-instr-def-var instr)]))

(define (opt-divrem-instr-defines-var? [instr : CompilerIrInstr] [var : i64]) : bool
  (match (opt-divrem-instr-def-var instr)
    [(option_i64.Some dst) (= dst var)]
    [(option_i64.None) false]))

(define (opt-divrem-var-defined-at-or-after-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [var : i64]) : bool
  (if (>= index count)
    false
    (if (opt-divrem-instr-defines-var?
      (compiler-ir-instr-seq-ref instrs index)
      var)
      true
      (opt-divrem-var-defined-at-or-after-from? instrs (+ index 1) count var))))

(define (opt-divrem-var-defined-at-or-after?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : bool
  (opt-divrem-var-defined-at-or-after-from?
    instrs
    index
    (compiler-ir-instr-seq-count instrs)
    var))

(define (opt-divrem-literal-proves-kind?
  [value : CompilerIrValue]
  [ty : AstType]
  [kind : OptDivRemFactKind]) : bool
  (match (opt-normalize-scalar-to-i64 value ty)
    [(option_i64.Some n)
      (match kind
        [(OptDivRemFactKind.NonZero) (!= n 0)]
        [(OptDivRemFactKind.NotNegOne)
          (if (opt-signed-integer-type? ty)
            (!= n (- 0 1))
            true)]
        [(OptDivRemFactKind.NotSignedMin)
          (if (opt-signed-integer-type? ty)
            (!= n (opt-signed-min ty))
            true)])]
    [(option_i64.None) false]))

(define (opt-divrem-value-proves-kind?
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [value : CompilerIrValue]
  [ty : AstType]
  [kind : OptDivRemFactKind]) : bool
  (if (opt-divrem-literal-proves-kind? value ty kind)
    true
    (match value
      [(CompilerIrValue.Var var)
        (opt-divrem-facts-contains-kind? type-segment-bases facts var ty kind)]
      [_ false])))

(define (opt-divrem-proven-safe?
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : bool
  (if (not (opt-integer-type? ty))
    false
    (if (opt-unsigned-integer-type? ty)
      (opt-divrem-value-proves-kind?
        type-segment-bases
        facts
        rhs
        ty
        (OptDivRemFactKind.NonZero))
      (and
        (opt-divrem-value-proves-kind?
          type-segment-bases
          facts
          rhs
          ty
          (OptDivRemFactKind.NonZero))
        (or
          (opt-divrem-value-proves-kind?
            type-segment-bases
            facts
            rhs
            ty
            (OptDivRemFactKind.NotNegOne))
          (opt-divrem-value-proves-kind?
            type-segment-bases
            facts
            lhs
            ty
            (OptDivRemFactKind.NotSignedMin)))))))

(define (opt-divrem-rewrite-op
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : CompilerIrBinOp
  (match op
    [(CompilerIrBinOp.Div)
      (if (opt-divrem-proven-safe? type-segment-bases facts lhs rhs ty)
        (CompilerIrBinOp.SafeDiv)
        op)]
    [(CompilerIrBinOp.Mod)
      (if (opt-divrem-proven-safe? type-segment-bases facts lhs rhs ty)
        (CompilerIrBinOp.SafeMod)
        op)]
    [_ op]))

(define (opt-divrem-rewrite-instr
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (CompilerIrInstr.BinOp
        dst
        (opt-divrem-rewrite-op type-segment-bases facts op lhs rhs ty)
        lhs
        rhs
        ty)]
    [_ instr]))

(define (opt-divrem-facts-after-instr
  [facts : OptDivRemFacts]
  [instr : CompilerIrInstr]) : OptDivRemFacts
  (match (opt-divrem-instr-def-var instr)
    [(option_i64.Some dst) (opt-divrem-facts-remove-var facts dst)]
    [(option_i64.None) facts]))

;; 1:1 rewrite with forward-threaded facts. The old form accumulated a reversed
;; cons list and reversed it back at the end; the fact threading is unchanged,
;; the output just lands in a right-sized dense array. Output is fresh;
;; `instrs` is untouched. refs #5726
(define (opt-divrem-rewrite-instr-seq
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [instrs : CompilerIrInstrSeq]) : OptDivRemInstrRewrite
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [out : (Array CompilerIrInstr) (array.make-array CompilerIrInstr count)]
    [current : OptDivRemFacts facts]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [rewritten : CompilerIrInstr
            (opt-divrem-rewrite-instr
              type-segment-bases
              current
              (compiler-ir-instr-seq-ref instrs index))]
          (begin
            (array-set! out index rewritten)
            (set! current (opt-divrem-facts-after-instr current rewritten))
            (set! index (+ index 1)))))
      (OptDivRemInstrRewrite.Rewrite current (CompilerIrInstrSeq out count)))))

(define (opt-divrem-rewrite-block
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [block : CompilerIrBlock]) : OptDivRemBlockRewrite
  (match block
    [(CompilerIrBlock.Block label instrs)
      (match (opt-divrem-rewrite-instr-seq type-segment-bases facts instrs)
        [(OptDivRemInstrRewrite.Rewrite final-facts rewritten)
          (OptDivRemBlockRewrite.Rewrite
            (CompilerIrBlock.Block label rewritten)
            final-facts)])]))

(define (opt-divrem-reachable-pred-count [index : OptCfgIndex] [id : i64]) : i64
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (let
      [preds : OptCfgCsr (struct-get index preds)]
      [edge : i64 (array-ref (struct-get preds offsets) id)]
      [end : i64 (array-ref (struct-get preds offsets) (+ id 1))]
      [count : i64 0]
      (begin
        (while (< edge end)
          (let
            [pred : i64 (array-ref (struct-get preds edges) edge)]
            (begin
              (if (array-ref (struct-get index reachable) pred)
                (set! count (+ count 1))
                unit)
              (set! edge (+ edge 1)))))
        count))
    0))

(define (opt-divrem-set-successor-facts!
  [index : OptCfgIndex]
  [facts-by-id : (Array OptDivRemFacts)]
  [label : i64]
  [facts : OptDivRemFacts]) : unit
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id)
      (if (and
        (array-ref (struct-get index reachable) id)
        (= (opt-divrem-reachable-pred-count index id) 1))
        (array-set! facts-by-id id facts)
        unit)]
    [(option_i64.None) unit]))

(define (opt-divrem-propagate-terminator!
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [facts-by-id : (Array OptDivRemFacts)]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [instrs : CompilerIrInstrSeq]
  [terminator : CompilerIrInstr]) : unit
  (match terminator
    [(CompilerIrInstr.Jump label)
      (opt-divrem-set-successor-facts! index facts-by-id label facts)]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (begin
        (opt-divrem-set-successor-facts!
          index
          facts-by-id
          true-label
          (opt-divrem-edge-facts
            type-segment-bases
            facts
            types
            instrs
            cond
            true))
        (opt-divrem-set-successor-facts!
          index
          facts-by-id
          false-label
          (opt-divrem-edge-facts
            type-segment-bases
            facts
            types
            instrs
            cond
            false)))]
    [_ unit]))

(define (opt-divrem-propagate-block!
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [facts-by-id : (Array OptDivRemFacts)]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [block : CompilerIrBlock]) : unit
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (> count 0)
          (opt-divrem-propagate-terminator!
            type-segment-bases
            index
            facts-by-id
            facts
            types
            instrs
            (compiler-ir-instr-seq-ref instrs (- count 1)))
          unit))]))

(define (opt-divrem-results-fill-empty!
  [out : (Array OptDivRemBlockResult)]
  [index : i64]) : unit
  (if (>= index (array-length out))
    unit
    (begin
      (array-set! out index (OptDivRemBlockResult.NoBlock))
      (opt-divrem-results-fill-empty! out (+ index 1)))))

(define (opt-divrem-facts-fill-empty!
  [facts : (Array OptDivRemFacts)]
  [index : i64]) : unit
  (if (>= index (array-length facts))
    unit
    (begin
      (array-set! facts index (OptDivRemFacts.Nil))
      (opt-divrem-facts-fill-empty! facts (+ index 1)))))

(define (opt-divrem-process-rpo!
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [types : OptSsaVarTypes]
  [facts-by-id : (Array OptDivRemFacts)]
  [out : (Array OptDivRemBlockResult)]
  [slot : i64]) : unit
  (let
    [index : OptCfgIndex (struct-get context index)]
    (if (>= slot (struct-get index reach-count))
      unit
      (let
        [id : i64 (opt-cfg-index-rpo-id index slot)]
        [facts : OptDivRemFacts (array-ref facts-by-id id)]
        (begin
          (match (opt-cfg-index-block index id)
            [(OptMaybeBlock.Some block)
              (let
                [rewrite : OptDivRemBlockRewrite
                  (opt-divrem-rewrite-block type-segment-bases facts block)]
                (match rewrite
                  [(OptDivRemBlockRewrite.Rewrite rewritten final-facts)
                    (begin
                      (array-set!
                        out
                        id
                        (OptDivRemBlockResult.SomeBlock rewritten))
                      (opt-divrem-propagate-block!
                        type-segment-bases
                        index
                        facts-by-id
                        final-facts
                        types
                        rewritten))]))]
            [(OptMaybeBlock.No) unit])
          (opt-divrem-process-rpo!
            type-segment-bases
            context
            blocks
            types
            facts-by-id
            out
            (+ slot 1)))))))

(define (opt-divrem-materialize-blocks
  [context : OptCfgContext]
  [out : (Array OptDivRemBlockResult)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (let
            [material : CompilerIrBlock
              (match (opt-cfg-index-id (struct-get context index) label)
                [(option_i64.Some id)
                  (if (and (>= id 0) (< id (array-length out)))
                    (match (array-ref out id)
                      [(OptDivRemBlockResult.SomeBlock rewritten) rewritten]
                      [(OptDivRemBlockResult.NoBlock) block])
                    block)]
                [(option_i64.None) block])]
            (compiler-ir-block-cons
              material
              (opt-divrem-materialize-blocks context out (box-get rest))))])]
    [(CompilerIrBlockList.Array seq)
      (opt-divrem-materialize-blocks
        context
        out
        (compiler-ir-block-seq-to-list seq))]))

;; Cheap any-Div/Mod pre-scan for the divrem-safety pass (allocation-free: no
;; facts, no copies, returns at the first hit). The pass can only rewrite
;; CompilerIrBinOp.Div / CompilerIrBinOp.Mod ops -- opt-divrem-rewrite-op is
;; identity for every other op -- so a function containing neither op is
;; returned unchanged, exactly the content the full pass materializes for it
;; (no block rewrite can fire), without building the SSA facts, the per-block
;; fact/result arrays, or the per-block rewrite copies.
(define (opt-divrem-instr-has-divmod? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ op _ _ _)
      (match op
        [(CompilerIrBinOp.Div) true]
        [(CompilerIrBinOp.Mod) true]
        [_ false])]
    [_ false]))

(define (opt-divrem-instr-seq-has-divmod?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-divrem-instr-has-divmod? (compiler-ir-instr-seq-ref instrs index))
      true
      (opt-divrem-instr-seq-has-divmod? instrs (+ index 1)))))

(define (opt-divrem-block-seq-has-divmod?
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-block-seq-count blocks))
    false
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block _ instrs)
        (if (opt-divrem-instr-seq-has-divmod? instrs 0)
          true
          (opt-divrem-block-seq-has-divmod? blocks (+ index 1)))])))

(define (opt-divrem-blocks-have-divmod? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-divrem-instr-seq-has-divmod? instrs 0)
            true
            (opt-divrem-blocks-have-divmod? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq) (opt-divrem-block-seq-has-divmod? seq 0)]))

(define (opt-divrem-safety-blocks-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (if (not (opt-divrem-blocks-have-divmod? blocks))
    ;; No Div/Mod op anywhere: every rewrite is identity, so the pass output
    ;; equals the input; skip the SSA facts build and the per-block copies.
    blocks
    (let
      [index : OptCfgIndex (struct-get context index)]
      [count : i64 (opt-cfg-index-block-count index)]
      [ssa-facts : OptSsaFacts
        (opt-ssa-facts-from-function type-segment-bases params blocks)]
      [types : OptSsaVarTypes
        (match ssa-facts
          [(OptSsaFacts.Facts _ _ fact-types) fact-types])]
      [facts : (Array OptDivRemFacts) (array.make-array OptDivRemFacts count)]
      [out : (Array OptDivRemBlockResult)
        (array.make-array OptDivRemBlockResult count)]
      (begin
        (opt-cfg-index-refresh-blocks! index blocks)
        (opt-divrem-facts-fill-empty! facts 0)
        (opt-divrem-results-fill-empty! out 0)
        (opt-divrem-process-rpo!
          type-segment-bases
          context
          blocks
          types
          facts
          out
          0)
        (opt-divrem-materialize-blocks context out blocks)))))

(define (opt-divrem-safety-blocks
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-divrem-safety-blocks-with-context
    type-segment-bases
    (opt-cfg-context-build blocks)
    params
    blocks))

;; --- guarded loop bounds-check elimination ---------------------------------
;;
;; The block-local bounds pass can only remove a repeated check in the same
;; block. This function pass handles the lowered dynamic-array loop shape:
;; a dominating fat-handle length store, a while header guarding `i < n`, and a
;; body bounds check against the same array length. It also handles the lowered
;; String shape where a header `string-length` load and a body `string-ref`
;; length load read the same handle. It runs before stack promotion so the
;; direct fat-handle stores/loads are still visible; later DCE removes the
;; now-dead length load/cast scaffolding.
(defenum OptLoopBceExpr
  (Unknown)
  (Value CompilerIrValue)
  (Argc)
  (Bin CompilerIrBinOp (Box OptLoopBceExpr) (Box OptLoopBceExpr) AstType))

(defenum OptLoopBceExprEnv
  (Nil)
  (Cons i64 OptLoopBceExpr (Box OptLoopBceExprEnv)))

(defenum OptLoopBceAliasEnv
  (Nil)
  (Cons i64 i64 (Box OptLoopBceAliasEnv)))

(defenum OptLoopBcePtrKind
  (Unknown)
  (LengthSlot i64)
  (DataSlot i64)
  (DataBuffer i64)
  (DataElement i64))

(defenum OptLoopBcePtrEnv
  (Nil)
  (Cons i64 OptLoopBcePtrKind (Box OptLoopBcePtrEnv)))

(defenum OptLoopBceLengthEnv
  (Nil)
  (Cons i64 OptLoopBceExpr (Box OptLoopBceLengthEnv)))

(defenum OptLoopBceCmpEnv
  (Nil)
  (Cons
    i64
    CompilerIrBinOp
    OptLoopBceExpr
    OptLoopBceExpr
    AstType
    (Box OptLoopBceCmpEnv)))

(defenum OptLoopBceGuard
  (Guard i64 OptLoopBceExpr OptLoopBceExpr))

(defenum OptLoopBceGuardEnv
  (Nil)
  (Dense (Array OptLoopBceGuard) i64))

(define (opt-loop-bce-guard-ref [env : OptLoopBceGuardEnv] [index : i64]) : OptLoopBceGuard
  (match env
    [(OptLoopBceGuardEnv.Nil)
      (OptLoopBceGuard.Guard
        -1
        (OptLoopBceExpr.Unknown)
        (OptLoopBceExpr.Unknown))]
    [(OptLoopBceGuardEnv.Dense items len) (array-ref items (- (- len 1) index))]))

(define (opt-loop-bce-guard-tail [env : OptLoopBceGuardEnv]) : OptLoopBceGuardEnv
  (match env
    [(OptLoopBceGuardEnv.Nil) (OptLoopBceGuardEnv.Nil)]
    [(OptLoopBceGuardEnv.Dense items len)
      (if (<= len 1)
        (OptLoopBceGuardEnv.Nil)
        (OptLoopBceGuardEnv.Dense items (- len 1)))]))

(define (opt-loop-bce-guard-cons
  [label : i64]
  [index : OptLoopBceExpr]
  [length : OptLoopBceExpr]
  [env : OptLoopBceGuardEnv]) : OptLoopBceGuardEnv
  (let
    [guard : OptLoopBceGuard (OptLoopBceGuard.Guard label index length)]
    (match env
      [(OptLoopBceGuardEnv.Nil)
        (let
          [items : (Array OptLoopBceGuard) (array.make-array OptLoopBceGuard 4)]
          (begin
            (array-set! items 0 guard)
            (OptLoopBceGuardEnv.Dense items 1)))]
      [(OptLoopBceGuardEnv.Dense items len)
        (if (< len (array-length items))
          (begin
            (array-set! items len guard)
            (OptLoopBceGuardEnv.Dense items (+ len 1)))
          (let
            [bigger : (Array OptLoopBceGuard)
              (array.make-array OptLoopBceGuard (opt-dense-next-capacity len))]
            [slot : i64 0]
            (begin
              (while (< slot len)
                (begin
                  (array-set! bigger slot (array-ref items slot))
                  (set! slot (+ slot 1))))
              (array-set! bigger len guard)
              (OptLoopBceGuardEnv.Dense bigger (+ len 1)))))])))

(defenum OptRangeFact
  (Nonnegative i64 OptLoopBceExpr)
  (LessThan i64 OptLoopBceExpr OptLoopBceExpr)
  (LessThanOrEq i64 OptLoopBceExpr OptLoopBceExpr))

(defenum OptRangeFacts
  (Nil)
  (Cons OptRangeFact (Box OptRangeFacts)))

(defstruct OptLoopBceSummaries
  (enabled bool)
  ;; Compile-profile ownership follows the already per-program summary bundle.
  ;; The disabled state is a one-word sentinel and allocates no summary storage.
  (profile-state profile_state.CompilerProfileState)
  (length-clean opt_i64_i64_map.Map)
  ;; Direct user calls proven not to perform memory writes. LICM consumes this
  ;; to keep descriptor header fields live across read-only helper calls without
  ;; treating arbitrary calls as safe.
  (direct-call-clean opt_i64_i64_map.Map)
  ;; Direct-call memory effects for load GVN. Each packed value records writes
  ;; through checked-reference parameter indices plus global/unknown flags.
  ;; Absence means unresolved (including recursive cycles) and remains a full
  ;; memory barrier.
  (call-memory opt_i64_i64_map.Map)
  (argc-return opt_i64_i64_map.Map)
  ;; Whole-program table of never-written literal-i64 globals, mapping
  ;; global name -> constant value. Carried alongside the BCE summaries (rather
  ;; than threaded as a separate parameter) because both are built once per
  ;; program and consumed in the same per-function level-2 pass. Empty unless
  ;; the program qualifies for summary construction.
  (const-divisors opt_i64_i64_map.Map))

(defstruct OptLoopBceState
  (exprs OptLoopBceExprEnv)
  (aliases OptLoopBceAliasEnv)
  (ptrs OptLoopBcePtrEnv)
  (lengths OptLoopBceLengthEnv)
  (cmps OptLoopBceCmpEnv)
  (guards OptLoopBceGuardEnv)
  (ranges OptRangeFacts))

(defenum OptLoopBceRewrite
  (Rewrite OptLoopBceState CompilerIrInstrList))

(defenum OptLoopBceBlockRewrite
  (Rewrite OptLoopBceState CompilerIrBlock))

(defenum OptLoopBceMaybeLabel
  (NoLabel)
  (SomeLabel i64))

(defenum OptLoopBceMaybeVar
  (NoVar)
  (SomeVar i64))

(defenum OptLoopBceIndexDef
  (NoDef)
  (Zero)
  (Increment)
  (Other))

(defenum OptLoopBceHeaderEdges
  (Edges bool bool bool))

(defenum OptLoopBceBlockResult
  (NoBlock)
  (SomeBlock CompilerIrBlock))

(define (opt-loop-bce-empty-summaries) : OptLoopBceSummaries
  (OptLoopBceSummaries
    false
    (profile_state.compiler-profile-state-new)
    (opt_i64_i64_map.with-capacity 8)
    (opt_i64_i64_map.with-capacity 8)
    (opt_i64_i64_map.with-capacity 8)
    (opt_i64_i64_map.with-capacity 8)
    (opt_i64_i64_map.with-capacity 8)))

(define (opt-loop-bce-summary-length-clean?
  [summaries : OptLoopBceSummaries]
  [name : i64]) : bool
  (opt_i64_i64_map.contains?
    (& (struct-get summaries length-clean))
    (compiler-ir-symbol-id name)))

(define (opt-loop-bce-summary-argc-return?
  [summaries : OptLoopBceSummaries]
  [name : i64]) : bool
  (opt_i64_i64_map.contains?
    (& (struct-get summaries argc-return))
    (compiler-ir-symbol-id name)))

(define (opt-loop-bce-commutative-op? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Add) true]
    [(CompilerIrBinOp.Mul) true]
    [(CompilerIrBinOp.And) true]
    [(CompilerIrBinOp.Or) true]
    [(CompilerIrBinOp.BitAnd) true]
    [(CompilerIrBinOp.BitOr) true]
    [(CompilerIrBinOp.BitXor) true]
    [_ false]))

(define (opt-loop-bce-expr-eq
  [type-segment-bases : i64]
  [a : OptLoopBceExpr]
  [b : OptLoopBceExpr]) : bool
  (match a
    [(OptLoopBceExpr.Unknown) false]
    [(OptLoopBceExpr.Value av)
      (match b
        [(OptLoopBceExpr.Value bv) (opt-value-eq av bv)]
        [_ false])]
    [(OptLoopBceExpr.Argc)
      (match b
        [(OptLoopBceExpr.Argc) true]
        [_ false])]
    [(OptLoopBceExpr.Bin aop al ar aty)
      (match b
        [(OptLoopBceExpr.Bin bop bl br bty)
          (and
            (opt-binop-eq aop bop)
            (opt-type-eq type-segment-bases aty bty)
            (or
              (and
                (opt-loop-bce-expr-eq
                  type-segment-bases
                  (box-get al)
                  (box-get bl))
                (opt-loop-bce-expr-eq
                  type-segment-bases
                  (box-get ar)
                  (box-get br)))
              (and
                (opt-loop-bce-commutative-op? aop)
                (opt-loop-bce-expr-eq
                  type-segment-bases
                  (box-get al)
                  (box-get br))
                (opt-loop-bce-expr-eq
                  type-segment-bases
                  (box-get ar)
                  (box-get bl)))))]
        [_ false])]))

(define (opt-range-nonnegative-contains?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [expr : OptLoopBceExpr]) : bool
  (match facts
    [(OptRangeFacts.Nil) false]
    [(OptRangeFacts.Cons fact rest)
      (match fact
        [(OptRangeFact.Nonnegative fact-label fact-expr)
          (if (and
            (= fact-label label)
            (opt-loop-bce-expr-eq type-segment-bases fact-expr expr))
            true
            (opt-range-nonnegative-contains?
              type-segment-bases
              (box-get rest)
              label
              expr))]
        [_
          (opt-range-nonnegative-contains?
            type-segment-bases
            (box-get rest)
            label
            expr)])]))

(define (opt-range-less-than-contains?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (match facts
    [(OptRangeFacts.Nil) false]
    [(OptRangeFacts.Cons fact rest)
      (match fact
        [(OptRangeFact.LessThan fact-label fact-lhs fact-rhs)
          (if (and
            (= fact-label label)
            (opt-loop-bce-expr-eq type-segment-bases fact-lhs lhs)
            (opt-loop-bce-expr-eq type-segment-bases fact-rhs rhs))
            true
            (opt-range-less-than-contains?
              type-segment-bases
              (box-get rest)
              label
              lhs
              rhs))]
        [_
          (opt-range-less-than-contains?
            type-segment-bases
            (box-get rest)
            label
            lhs
            rhs)])]))

(define (opt-range-less-than-or-eq-contains?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (match facts
    [(OptRangeFacts.Nil) false]
    [(OptRangeFacts.Cons fact rest)
      (match fact
        [(OptRangeFact.LessThanOrEq fact-label fact-lhs fact-rhs)
          (if (and
            (= fact-label label)
            (opt-loop-bce-expr-eq type-segment-bases fact-lhs lhs)
            (opt-loop-bce-expr-eq type-segment-bases fact-rhs rhs))
            true
            (opt-range-less-than-or-eq-contains?
              type-segment-bases
              (box-get rest)
              label
              lhs
              rhs))]
        [_
          (opt-range-less-than-or-eq-contains?
            type-segment-bases
            (box-get rest)
            label
            lhs
            rhs)])]))

(define (opt-range-proves-less-than-or-eq?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (or
    (opt-loop-bce-expr-eq type-segment-bases lhs rhs)
    (opt-range-less-than-contains? type-segment-bases facts label lhs rhs)
    (opt-range-less-than-or-eq-contains? type-segment-bases facts label lhs rhs)))

(define (opt-range-proves-less-than-through-one-bound-from?
  [type-segment-bases : i64]
  [all-facts : OptRangeFacts]
  [scan : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (match scan
    [(OptRangeFacts.Nil) false]
    [(OptRangeFacts.Cons fact rest)
      (match fact
        [(OptRangeFact.LessThan fact-label fact-lhs fact-mid)
          (if (and
            (= fact-label label)
            (opt-loop-bce-expr-eq type-segment-bases fact-lhs lhs)
            (opt-range-proves-less-than-or-eq?
              type-segment-bases
              all-facts
              label
              fact-mid
              rhs))
            true
            (opt-range-proves-less-than-through-one-bound-from?
              type-segment-bases
              all-facts
              (box-get rest)
              label
              lhs
              rhs))]
        [_
          (opt-range-proves-less-than-through-one-bound-from?
            type-segment-bases
            all-facts
            (box-get rest)
            label
            lhs
            rhs)])]))

(define (opt-range-proves-less-than-through-one-bound?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (opt-range-proves-less-than-through-one-bound-from?
    type-segment-bases
    facts
    facts
    label
    lhs
    rhs))

(define (opt-range-proves-less-than?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (or
    (opt-range-less-than-contains? type-segment-bases facts label lhs rhs)
    (opt-range-proves-less-than-through-one-bound?
      type-segment-bases
      facts
      label
      lhs
      rhs)))

(define (opt-range-proves-nonnegative?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [expr : OptLoopBceExpr]) : bool
  (opt-range-nonnegative-contains? type-segment-bases facts label expr))

(define (opt-range-facts-add-nonnegative
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [expr : OptLoopBceExpr]) : OptRangeFacts
  (if (opt-range-nonnegative-contains? type-segment-bases facts label expr)
    facts
    (OptRangeFacts.Cons (OptRangeFact.Nonnegative label expr) (box facts))))

(define (opt-range-facts-add-less-than
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (if (opt-range-less-than-contains? type-segment-bases facts label lhs rhs)
    facts
    (OptRangeFacts.Cons (OptRangeFact.LessThan label lhs rhs) (box facts))))

(define (opt-range-facts-add-less-than-or-eq
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (if (opt-range-less-than-or-eq-contains?
    type-segment-bases
    facts
    label
    lhs
    rhs)
    facts
    (OptRangeFacts.Cons (OptRangeFact.LessThanOrEq label lhs rhs) (box facts))))

(define (opt-range-facts-propagate-label-from
  [type-segment-bases : i64]
  [source : OptRangeFacts]
  [out : OptRangeFacts]
  [parent-label : i64]
  [child-label : i64]) : OptRangeFacts
  (if (= parent-label child-label)
    out
    (match source
      [(OptRangeFacts.Nil) out]
      [(OptRangeFacts.Cons fact rest)
        (let
          [next : OptRangeFacts
            (match fact
              [(OptRangeFact.Nonnegative label expr)
                (if (= label parent-label)
                  (opt-range-facts-add-nonnegative
                    type-segment-bases
                    out
                    child-label
                    expr)
                  out)]
              [(OptRangeFact.LessThan label lhs rhs)
                (if (= label parent-label)
                  (opt-range-facts-add-less-than
                    type-segment-bases
                    out
                    child-label
                    lhs
                    rhs)
                  out)]
              [(OptRangeFact.LessThanOrEq label lhs rhs)
                (if (= label parent-label)
                  (opt-range-facts-add-less-than-or-eq
                    type-segment-bases
                    out
                    child-label
                    lhs
                    rhs)
                  out)])]
          (opt-range-facts-propagate-label-from
            type-segment-bases
            (box-get rest)
            next
            parent-label
            child-label))])))

(define (opt-range-facts-propagate-label
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [parent-label : i64]
  [child-label : i64]) : OptRangeFacts
  (opt-range-facts-propagate-label-from
    type-segment-bases
    facts
    facts
    parent-label
    child-label))

(define (opt-range-expr-stable?
  [sources : opt_i64_i64_map.Map]
  [expr : OptLoopBceExpr]) : bool
  (match expr
    [(OptLoopBceExpr.Unknown) false]
    [(OptLoopBceExpr.Argc) true]
    [(OptLoopBceExpr.Value value) (opt-gvn-value-stable? sources value)]
    [(OptLoopBceExpr.Bin op lhs rhs _)
      (and
        (not (opt-binop-traps? op))
        (opt-range-expr-stable? sources (box-get lhs))
        (opt-range-expr-stable? sources (box-get rhs)))]))

(define (opt-range-expr-type
  [types : OptSsaVarTypes]
  [expr : OptLoopBceExpr]
  [fallback : AstType]) : AstType
  (match expr
    [(OptLoopBceExpr.Value value) (opt-divrem-value-type types value fallback)]
    [(OptLoopBceExpr.Argc) (AstType.I64)]
    [(OptLoopBceExpr.Bin _ _ _ ty) ty]
    [(OptLoopBceExpr.Unknown) fallback]))

(define (opt-range-compare-operand-type
  [types : OptSsaVarTypes]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [fallback : AstType]) : AstType
  (let
    [lhs-ty : AstType (opt-range-expr-type types lhs fallback)]
    (if (opt-integer-type? lhs-ty)
      lhs-ty
      (opt-range-expr-type types rhs fallback))))

(define (opt-range-compare-value-type
  [types : OptSsaVarTypes]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [fallback : AstType]) : AstType
  (match lhs
    [(CompilerIrValue.Var _) (opt-divrem-value-type types lhs fallback)]
    [_ (opt-divrem-value-type types rhs fallback)]))

(define (opt-range-expr-i64 [expr : OptLoopBceExpr] [ty : AstType]) : option_i64.Option
  (match expr
    [(OptLoopBceExpr.Value value) (opt-normalize-scalar-to-i64 value ty)]
    [_ (option_i64.None)]))

(define (opt-range-upper-minus-offset-expr
  [upper : OptLoopBceExpr]
  [offset : i64]
  [ty : AstType]) : OptLoopBceExpr
  (match (opt-range-expr-i64 upper ty)
    [(option_i64.Some value)
      (if (>= value 0)
        (OptLoopBceExpr.Value (CompilerIrValue.I64 (- value offset)))
        (OptLoopBceExpr.Bin
          (CompilerIrBinOp.Sub)
          (box upper)
          (box (OptLoopBceExpr.Value (CompilerIrValue.I64 offset)))
          ty))]
    [(option_i64.None)
      (OptLoopBceExpr.Bin
        (CompilerIrBinOp.Sub)
        (box upper)
        (box (OptLoopBceExpr.Value (CompilerIrValue.I64 offset)))
        ty)]))

(define (opt-range-proves-additive-index-parts-in-range?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [base : OptLoopBceExpr]
  [offset-expr : OptLoopBceExpr]
  [upper : OptLoopBceExpr]
  [ty : AstType]
  [upper-known-nonnegative : bool]) : bool
  (match (opt-range-expr-i64 offset-expr ty)
    [(option_i64.Some offset)
      ;; `base < upper - k` only proves `(base + k) < upper` when the trusted
      ;; upper length prevents `upper - k` from wrapping upward.
      (and
        (> offset 0)
        upper-known-nonnegative
        (opt-range-proves-nonnegative? type-segment-bases facts label base)
        (opt-range-proves-less-than?
          type-segment-bases
          facts
          label
          base
          (opt-range-upper-minus-offset-expr upper offset ty)))]
    [(option_i64.None) false]))

(define (opt-range-proves-additive-index-in-range?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [index : OptLoopBceExpr]
  [upper : OptLoopBceExpr]
  [upper-known-nonnegative : bool]) : bool
  (match index
    [(OptLoopBceExpr.Bin op lhs rhs ty)
      (if (and
        (opt-binop-eq op (CompilerIrBinOp.Add))
        (opt-signed-integer-type? ty))
        (or
          (opt-range-proves-additive-index-parts-in-range?
            type-segment-bases
            facts
            label
            (box-get lhs)
            (box-get rhs)
            upper
            ty
            upper-known-nonnegative)
          (opt-range-proves-additive-index-parts-in-range?
            type-segment-bases
            facts
            label
            (box-get rhs)
            (box-get lhs)
            upper
            ty
            upper-known-nonnegative))
        false)]
    [_ false]))

(define (opt-range-add-nonnegative-from-compare
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [sources : opt_i64_i64_map.Map]
  [label : i64]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [ty : AstType]) : OptRangeFacts
  (if (not (opt-integer-type? ty))
    facts
    (let
      [from-lhs : OptRangeFacts
        (if (opt-range-expr-stable? sources lhs)
          (match (opt-range-expr-i64 rhs ty)
            [(option_i64.Some value)
              (match op
                [(CompilerIrBinOp.Ge)
                  (if (= value 0)
                    (opt-range-facts-add-nonnegative
                      type-segment-bases
                      facts
                      label
                      lhs)
                    facts)]
                [(CompilerIrBinOp.Gt)
                  (if (and (opt-signed-integer-type? ty) (= value (- 0 1)))
                    (opt-range-facts-add-nonnegative
                      type-segment-bases
                      facts
                      label
                      lhs)
                    facts)]
                [_ facts])]
            [(option_i64.None) facts])
          facts)]
      (if (opt-range-expr-stable? sources rhs)
        (match (opt-range-expr-i64 lhs ty)
          [(option_i64.Some value)
            (match op
              [(CompilerIrBinOp.Le)
                (if (= value 0)
                  (opt-range-facts-add-nonnegative
                    type-segment-bases
                    from-lhs
                    label
                    rhs)
                  from-lhs)]
              [(CompilerIrBinOp.Lt)
                (if (and (opt-signed-integer-type? ty) (= value (- 0 1)))
                  (opt-range-facts-add-nonnegative
                    type-segment-bases
                    from-lhs
                    label
                    rhs)
                  from-lhs)]
              [_ from-lhs])]
          [(option_i64.None) from-lhs])
        from-lhs))))

(define (opt-range-add-less-than-from-compare
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [sources : opt_i64_i64_map.Map]
  [label : i64]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (match op
    [(CompilerIrBinOp.Lt)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than type-segment-bases facts label lhs rhs)
        facts)]
    [(CompilerIrBinOp.Gt)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than type-segment-bases facts label rhs lhs)
        facts)]
    [_ facts]))

(define (opt-range-add-less-than-or-eq-from-compare
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [sources : opt_i64_i64_map.Map]
  [label : i64]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (match op
    [(CompilerIrBinOp.Le)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than-or-eq
          type-segment-bases
          facts
          label
          lhs
          rhs)
        facts)]
    [(CompilerIrBinOp.Ge)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than-or-eq
          type-segment-bases
          facts
          label
          rhs
          lhs)
        facts)]
    [_ facts]))

(define (opt-range-add-edge-facts
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [label : i64]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [fallback-ty : AstType]) : OptRangeFacts
  (let
    [operand-ty : AstType
      (opt-range-compare-operand-type types lhs rhs fallback-ty)]
    [less : OptRangeFacts
      (opt-range-add-less-than-from-compare
        type-segment-bases
        facts
        sources
        label
        op
        lhs
        rhs)]
    [less-or-eq : OptRangeFacts
      (opt-range-add-less-than-or-eq-from-compare
        type-segment-bases
        less
        sources
        label
        op
        lhs
        rhs)]
    [nonnegative : OptRangeFacts
      (opt-range-add-nonnegative-from-compare
        type-segment-bases
        less-or-eq
        sources
        label
        op
        lhs
        rhs
        operand-ty)]
    (if (and
      (opt-unsigned-integer-type? operand-ty)
      (match op
        [(CompilerIrBinOp.Lt) true]
        [(CompilerIrBinOp.Gt) true]
        [_ false]))
      (match op
        [(CompilerIrBinOp.Lt)
          (if (opt-range-expr-stable? sources lhs)
            (opt-range-facts-add-nonnegative
              type-segment-bases
              nonnegative
              label
              lhs)
            nonnegative)]
        [(CompilerIrBinOp.Gt)
          (if (opt-range-expr-stable? sources rhs)
            (opt-range-facts-add-nonnegative
              type-segment-bases
              nonnegative
              label
              rhs)
            nonnegative)]
        [_ nonnegative])
      nonnegative)))

(define (opt-loop-bce-expr-unbind [env : OptLoopBceExprEnv] [var : i64]) : OptLoopBceExprEnv
  (match env
    [(OptLoopBceExprEnv.Nil) (OptLoopBceExprEnv.Nil)]
    [(OptLoopBceExprEnv.Cons id expr rest)
      (let
        [tail : OptLoopBceExprEnv (opt-loop-bce-expr-unbind (box-get rest) var)]
        (if (= id var)
          tail
          (OptLoopBceExprEnv.Cons id expr (box tail))))]))

(define (opt-loop-bce-expr-bind
  [env : OptLoopBceExprEnv]
  [var : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceExprEnv
  (match expr
    [(OptLoopBceExpr.Unknown) (opt-loop-bce-expr-unbind env var)]
    [_
      (OptLoopBceExprEnv.Cons var expr (box (opt-loop-bce-expr-unbind env var)))]))

(define (opt-loop-bce-expr-lookup [env : OptLoopBceExprEnv] [var : i64]) : OptLoopBceExpr
  (match env
    [(OptLoopBceExprEnv.Nil) (OptLoopBceExpr.Unknown)]
    [(OptLoopBceExprEnv.Cons id expr rest)
      (if (= id var)
        expr
        (opt-loop-bce-expr-lookup (box-get rest) var))]))

(define (opt-loop-bce-alias-unbind [env : OptLoopBceAliasEnv] [var : i64]) : OptLoopBceAliasEnv
  (match env
    [(OptLoopBceAliasEnv.Nil) (OptLoopBceAliasEnv.Nil)]
    [(OptLoopBceAliasEnv.Cons id root rest)
      (let
        [tail : OptLoopBceAliasEnv
          (opt-loop-bce-alias-unbind (box-get rest) var)]
        (if (= id var)
          tail
          (OptLoopBceAliasEnv.Cons id root (box tail))))]))

(define (opt-loop-bce-alias-bind
  [env : OptLoopBceAliasEnv]
  [var : i64]
  [root : i64]) : OptLoopBceAliasEnv
  (OptLoopBceAliasEnv.Cons var root (box (opt-loop-bce-alias-unbind env var))))

(define (opt-loop-bce-alias-resolve-depth
  [env : OptLoopBceAliasEnv]
  [var : i64]
  [depth : i64]) : i64
  (if (> depth 32)
    var
    (match env
      [(OptLoopBceAliasEnv.Nil) var]
      [(OptLoopBceAliasEnv.Cons id root rest)
        (if (= id var)
          (if (= root var)
            root
            (opt-loop-bce-alias-resolve-depth env root (+ depth 1)))
          (opt-loop-bce-alias-resolve-depth (box-get rest) var depth))])))

(define (opt-loop-bce-alias-resolve [env : OptLoopBceAliasEnv] [var : i64]) : i64
  (opt-loop-bce-alias-resolve-depth env var 0))

(define (opt-loop-bce-ptr-unbind [env : OptLoopBcePtrEnv] [var : i64]) : OptLoopBcePtrEnv
  (match env
    [(OptLoopBcePtrEnv.Nil) (OptLoopBcePtrEnv.Nil)]
    [(OptLoopBcePtrEnv.Cons id kind rest)
      (let
        [tail : OptLoopBcePtrEnv (opt-loop-bce-ptr-unbind (box-get rest) var)]
        (if (= id var)
          tail
          (OptLoopBcePtrEnv.Cons id kind (box tail))))]))

(define (opt-loop-bce-ptr-bind
  [env : OptLoopBcePtrEnv]
  [var : i64]
  [kind : OptLoopBcePtrKind]) : OptLoopBcePtrEnv
  (match kind
    [(OptLoopBcePtrKind.Unknown) (opt-loop-bce-ptr-unbind env var)]
    [_ (OptLoopBcePtrEnv.Cons var kind (box (opt-loop-bce-ptr-unbind env var)))]))

(define (opt-loop-bce-ptr-lookup [env : OptLoopBcePtrEnv] [var : i64]) : OptLoopBcePtrKind
  (match env
    [(OptLoopBcePtrEnv.Nil) (OptLoopBcePtrKind.Unknown)]
    [(OptLoopBcePtrEnv.Cons id kind rest)
      (if (= id var)
        kind
        (opt-loop-bce-ptr-lookup (box-get rest) var))]))

(define (opt-loop-bce-length-unbind [env : OptLoopBceLengthEnv] [object : i64]) : OptLoopBceLengthEnv
  (match env
    [(OptLoopBceLengthEnv.Nil) (OptLoopBceLengthEnv.Nil)]
    [(OptLoopBceLengthEnv.Cons id expr rest)
      (let
        [tail : OptLoopBceLengthEnv
          (opt-loop-bce-length-unbind (box-get rest) object)]
        (if (= id object)
          tail
          (OptLoopBceLengthEnv.Cons id expr (box tail))))]))

(define (opt-loop-bce-length-bind
  [env : OptLoopBceLengthEnv]
  [object : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceLengthEnv
  (match expr
    [(OptLoopBceExpr.Unknown) (opt-loop-bce-length-unbind env object)]
    [_
      (OptLoopBceLengthEnv.Cons
        object
        expr
        (box (opt-loop-bce-length-unbind env object)))]))

(define (opt-loop-bce-length-lookup [env : OptLoopBceLengthEnv] [object : i64]) : OptLoopBceExpr
  (match env
    [(OptLoopBceLengthEnv.Nil) (OptLoopBceExpr.Unknown)]
    [(OptLoopBceLengthEnv.Cons id expr rest)
      (if (= id object)
        expr
        (opt-loop-bce-length-lookup (box-get rest) object))]))

(define (opt-loop-bce-cmp-unbind [env : OptLoopBceCmpEnv] [var : i64]) : OptLoopBceCmpEnv
  (match env
    [(OptLoopBceCmpEnv.Nil) (OptLoopBceCmpEnv.Nil)]
    [(OptLoopBceCmpEnv.Cons id op lhs rhs ty rest)
      (let
        [tail : OptLoopBceCmpEnv (opt-loop-bce-cmp-unbind (box-get rest) var)]
        (if (= id var)
          tail
          (OptLoopBceCmpEnv.Cons id op lhs rhs ty (box tail))))]))

(define (opt-loop-bce-cmp-bind
  [env : OptLoopBceCmpEnv]
  [var : i64]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [ty : AstType]) : OptLoopBceCmpEnv
  (OptLoopBceCmpEnv.Cons
    var
    op
    lhs
    rhs
    ty
    (box (opt-loop-bce-cmp-unbind env var))))

(define (opt-loop-bce-cmp-lookup [env : OptLoopBceCmpEnv] [var : i64]) : OptLoopBceCmpEnv
  (match env
    [(OptLoopBceCmpEnv.Nil) (OptLoopBceCmpEnv.Nil)]
    [(OptLoopBceCmpEnv.Cons id op lhs rhs ty rest)
      (if (= id var)
        (OptLoopBceCmpEnv.Cons id op lhs rhs ty (box OptLoopBceCmpEnv.Nil))
        (opt-loop-bce-cmp-lookup (box-get rest) var))]))

(define (opt-loop-bce-guard-unbind [env : OptLoopBceGuardEnv] [label : i64]) : OptLoopBceGuardEnv
  (match env
    [(OptLoopBceGuardEnv.Nil) (OptLoopBceGuardEnv.Nil)]
    [(OptLoopBceGuardEnv.Dense _ _)
      (match (opt-loop-bce-guard-ref env 0)
        [(OptLoopBceGuard.Guard id index length)
          (let
            [tail : OptLoopBceGuardEnv
              (opt-loop-bce-guard-unbind (opt-loop-bce-guard-tail env) label)]
            (if (= id label)
              tail
              (opt-loop-bce-guard-cons id index length tail)))])]))

(define (opt-loop-bce-guard-bind
  [env : OptLoopBceGuardEnv]
  [label : i64]
  [index : OptLoopBceExpr]
  [length : OptLoopBceExpr]) : OptLoopBceGuardEnv
  (opt-loop-bce-guard-cons
    label
    index
    length
    (opt-loop-bce-guard-unbind env label)))

(define (opt-loop-bce-guard-lookup [env : OptLoopBceGuardEnv] [label : i64]) : OptLoopBceGuardEnv
  (match env
    [(OptLoopBceGuardEnv.Nil) (OptLoopBceGuardEnv.Nil)]
    [(OptLoopBceGuardEnv.Dense _ _)
      (match (opt-loop-bce-guard-ref env 0)
        [(OptLoopBceGuard.Guard id index length)
          (if (= id label)
            (opt-loop-bce-guard-cons id index length (OptLoopBceGuardEnv.Nil))
            (opt-loop-bce-guard-lookup (opt-loop-bce-guard-tail env) label))])]))

(define (opt-loop-bce-value-expr
  [sources : opt_i64_i64_map.Map]
  [env : OptLoopBceExprEnv]
  [value : CompilerIrValue]) : OptLoopBceExpr
  (match value
    [(CompilerIrValue.Var id)
      (if (opt-gvn-stable-var? sources id)
        (let
          [found : OptLoopBceExpr (opt-loop-bce-expr-lookup env id)]
          (match found
            [(OptLoopBceExpr.Unknown) (OptLoopBceExpr.Value value)]
            [_ found]))
        (OptLoopBceExpr.Value value))]
    [_ (OptLoopBceExpr.Value value)]))

(define (opt-loop-bce-same-width-int-cast?
  [type-segment-bases : i64]
  [from-ty : AstType]
  [to-ty : AstType]) : bool
  (or
    (and
      (opt-type-eq type-segment-bases from-ty (AstType.I64))
      (opt-type-eq type-segment-bases to-ty (AstType.U64)))
    (and
      (opt-type-eq type-segment-bases from-ty (AstType.U64))
      (opt-type-eq type-segment-bases to-ty (AstType.I64)))
    (opt-type-eq type-segment-bases from-ty to-ty)))

(define (opt-loop-bce-data-slot? [offset : CompilerIrValue]) : bool
  (match offset
    [(CompilerIrValue.I64 value) (= value 0)]
    [_ false]))

(define (opt-loop-bce-expr-uses-var? [expr : OptLoopBceExpr] [var : i64]) : bool
  (match expr
    [(OptLoopBceExpr.Unknown) false]
    [(OptLoopBceExpr.Argc) false]
    [(OptLoopBceExpr.Value value) (opt-value-is-var? value var)]
    [(OptLoopBceExpr.Bin _ lhs rhs _)
      (or
        (opt-loop-bce-expr-uses-var? (box-get lhs) var)
        (opt-loop-bce-expr-uses-var? (box-get rhs) var))]))

(define (opt-loop-bce-guard-invalidate-var
  [guards : OptLoopBceGuardEnv]
  [var : i64]) : OptLoopBceGuardEnv
  (match guards
    [(OptLoopBceGuardEnv.Nil) (OptLoopBceGuardEnv.Nil)]
    [(OptLoopBceGuardEnv.Dense _ _)
      (match (opt-loop-bce-guard-ref guards 0)
        [(OptLoopBceGuard.Guard label index length)
          (let
            [tail : OptLoopBceGuardEnv
              (opt-loop-bce-guard-invalidate-var
                (opt-loop-bce-guard-tail guards)
                var)]
            (if (or
              (opt-loop-bce-expr-uses-var? index var)
              (opt-loop-bce-expr-uses-var? length var))
              tail
              (opt-loop-bce-guard-cons label index length tail)))])]))

(define (opt-range-fact-uses-var? [fact : OptRangeFact] [var : i64]) : bool
  (match fact
    [(OptRangeFact.Nonnegative _ expr) (opt-loop-bce-expr-uses-var? expr var)]
    [(OptRangeFact.LessThan _ lhs rhs)
      (or
        (opt-loop-bce-expr-uses-var? lhs var)
        (opt-loop-bce-expr-uses-var? rhs var))]
    [(OptRangeFact.LessThanOrEq _ lhs rhs)
      (or
        (opt-loop-bce-expr-uses-var? lhs var)
        (opt-loop-bce-expr-uses-var? rhs var))]))

(define (opt-range-facts-invalidate-var [facts : OptRangeFacts] [var : i64]) : OptRangeFacts
  (match facts
    [(OptRangeFacts.Nil) (OptRangeFacts.Nil)]
    [(OptRangeFacts.Cons fact rest)
      (let
        [tail : OptRangeFacts
          (opt-range-facts-invalidate-var (box-get rest) var)]
        (if (opt-range-fact-uses-var? fact var)
          tail
          (OptRangeFacts.Cons fact (box tail))))]))

(define (opt-loop-bce-state-invalidate-def
  [state : OptLoopBceState]
  [var : i64]) : OptLoopBceState
  (OptLoopBceState
    (opt-loop-bce-expr-unbind (struct-get state exprs) var)
    (opt-loop-bce-alias-unbind (struct-get state aliases) var)
    (opt-loop-bce-ptr-unbind (struct-get state ptrs) var)
    (opt-loop-bce-length-unbind (struct-get state lengths) var)
    (opt-loop-bce-cmp-unbind (struct-get state cmps) var)
    (opt-loop-bce-guard-invalidate-var (struct-get state guards) var)
    (opt-range-facts-invalidate-var (struct-get state ranges) var)))

(define (opt-loop-bce-state-clear-lengths [state : OptLoopBceState]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (struct-get state ptrs)
    (OptLoopBceLengthEnv.Nil)
    (struct-get state cmps)
    (struct-get state guards)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-expr
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    (if (opt-gvn-stable-var? sources dst)
      (OptLoopBceState
        (opt-loop-bce-expr-bind (struct-get invalid exprs) dst expr)
        (struct-get invalid aliases)
        (struct-get invalid ptrs)
        (struct-get invalid lengths)
        (struct-get invalid cmps)
        (struct-get invalid guards)
        (struct-get invalid ranges))
      invalid)))

(define (opt-loop-bce-state-bind-alias
  [state : OptLoopBceState]
  [dst : i64]
  [root : i64]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (opt-loop-bce-alias-bind (struct-get state aliases) dst root)
    (struct-get state ptrs)
    (struct-get state lengths)
    (struct-get state cmps)
    (struct-get state guards)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-ptr
  [state : OptLoopBceState]
  [dst : i64]
  [kind : OptLoopBcePtrKind]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (opt-loop-bce-ptr-bind (struct-get state ptrs) dst kind)
    (struct-get state lengths)
    (struct-get state cmps)
    (struct-get state guards)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-length
  [state : OptLoopBceState]
  [object : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (struct-get state ptrs)
    (opt-loop-bce-length-bind (struct-get state lengths) object expr)
    (struct-get state cmps)
    (struct-get state guards)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-cmp
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [ty : AstType]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    (if (opt-gvn-stable-var? sources dst)
      (OptLoopBceState
        (struct-get invalid exprs)
        (struct-get invalid aliases)
        (struct-get invalid ptrs)
        (struct-get invalid lengths)
        (opt-loop-bce-cmp-bind (struct-get invalid cmps) dst op lhs rhs ty)
        (struct-get invalid guards)
        (struct-get invalid ranges))
      invalid)))

(define (opt-loop-bce-state-bind-guard
  [state : OptLoopBceState]
  [label : i64]
  [index : OptLoopBceExpr]
  [length : OptLoopBceExpr]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (struct-get state ptrs)
    (struct-get state lengths)
    (struct-get state cmps)
    (opt-loop-bce-guard-bind (struct-get state guards) label index length)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-ranges
  [state : OptLoopBceState]
  [ranges : OptRangeFacts]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (struct-get state ptrs)
    (struct-get state lengths)
    (struct-get state cmps)
    (struct-get state guards)
    ranges))

(define (opt-loop-bce-expr-var [expr : OptLoopBceExpr]) : OptLoopBceMaybeVar
  (match expr
    [(OptLoopBceExpr.Value value)
      (match value
        [(CompilerIrValue.Var var) (OptLoopBceMaybeVar.SomeVar var)]
        [_ (OptLoopBceMaybeVar.NoVar)])]
    [_ (OptLoopBceMaybeVar.NoVar)]))

(define (opt-loop-bce-label-set-other-than [labels : OptLabelSet] [skip : i64]) : OptLoopBceMaybeLabel
  (match labels
    [(OptLabelSet.Nil) (OptLoopBceMaybeLabel.NoLabel)]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (if (= label skip)
          (opt-loop-bce-label-set-other-than (opt-label-tail labels) skip)
          (match (opt-loop-bce-label-set-other-than
            (opt-label-tail labels)
            skip)
            [(OptLoopBceMaybeLabel.NoLabel)
              (OptLoopBceMaybeLabel.SomeLabel label)]
            [(OptLoopBceMaybeLabel.SomeLabel _) (OptLoopBceMaybeLabel.NoLabel)])))]))

(define (opt-loop-bce-defines-var? [instr : CompilerIrInstr] [var : i64]) : bool
  (= (opt-gvn-instr-dst instr) var))

(define (opt-loop-bce-index-init-step
  [current : OptLoopBceIndexDef]
  [instr : CompilerIrInstr]
  [index-var : i64]) : OptLoopBceIndexDef
  (if (opt-loop-bce-defines-var? instr index-var)
    (match instr
      [(CompilerIrInstr.Mov dst src _)
        (if (= dst index-var)
          (match src
            [(CompilerIrValue.I64 value)
              (if (= value 0)
                (OptLoopBceIndexDef.Zero)
                (OptLoopBceIndexDef.Other))]
            [_ (OptLoopBceIndexDef.Other)])
          (OptLoopBceIndexDef.Other))]
      [_ (OptLoopBceIndexDef.Other)])
    current))

(define (opt-loop-bce-index-init-instrs
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [index-var : i64]
  [current : OptLoopBceIndexDef]) : OptLoopBceIndexDef
  (if (>= index count)
    current
    (opt-loop-bce-index-init-instrs
      slots
      (+ index 1)
      count
      index-var
      (opt-loop-bce-index-init-step current (array-ref slots index) index-var))))

(define (opt-loop-bce-block-last-def-zero?
  [block : CompilerIrBlock]
  [index-var : i64]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (match (opt-loop-bce-index-init-instrs
        (struct-get instrs slots)
        0
        (struct-get instrs len)
        index-var
        (OptLoopBceIndexDef.NoDef))
        [(OptLoopBceIndexDef.Zero) true]
        [_ false])]))

(define (opt-loop-bce-plus-one-add?
  [type-segment-bases : i64]
  [instr : CompilerIrInstr]
  [dst : i64]
  [index-var : i64]) : bool
  (match instr
    [(CompilerIrInstr.BinOp out op lhs rhs ty)
      (and
        (= out dst)
        (opt-binop-eq op (CompilerIrBinOp.Add))
        (opt-type-eq type-segment-bases ty (AstType.I64))
        (or
          (and
            (opt-value-eq lhs (CompilerIrValue.Var index-var))
            (opt-value-eq rhs (CompilerIrValue.I64 1)))
          (and
            (opt-value-eq lhs (CompilerIrValue.I64 1))
            (opt-value-eq rhs (CompilerIrValue.Var index-var)))))]
    [_ false]))

(define (opt-loop-bce-i64-list-remove [items : OptI64List] [value : i64]) : OptI64List
  (match items
    [(OptI64List.Nil) (OptI64List.Nil)]
    [(OptI64List.Cons head rest)
      (let
        [tail : OptI64List (opt-loop-bce-i64-list-remove (box-get rest) value)]
        (if (= head value)
          tail
          (OptI64List.Cons head (box tail))))]))

(define (opt-loop-bce-index-increment-step
  [type-segment-bases : i64]
  [current : OptLoopBceIndexDef]
  [plus-one : OptI64List]
  [instr : CompilerIrInstr]
  [index-var : i64]) : OptLoopBceIndexDef
  (if (opt-loop-bce-defines-var? instr index-var)
    (match instr
      [(CompilerIrInstr.Mov dst src _)
        (if (= dst index-var)
          (match src
            [(CompilerIrValue.Var tmp)
              (if (opt-i64-list-contains? plus-one tmp)
                (OptLoopBceIndexDef.Increment)
                (OptLoopBceIndexDef.Other))]
            [_ (OptLoopBceIndexDef.Other)])
          (OptLoopBceIndexDef.Other))]
      [(CompilerIrInstr.BinOp dst _ _ _ _)
        (if (and
          (= dst index-var)
          (opt-loop-bce-plus-one-add? type-segment-bases instr dst index-var))
          (OptLoopBceIndexDef.Increment)
          (OptLoopBceIndexDef.Other))]
      [_ (OptLoopBceIndexDef.Other)])
    current))

(define (opt-loop-bce-plus-one-update
  [type-segment-bases : i64]
  [plus-one : OptI64List]
  [instr : CompilerIrInstr]
  [index-var : i64]) : OptI64List
  (let
    [dst : i64 (opt-gvn-instr-dst instr)]
    [removed : OptI64List
      (if (= dst (- 0 1))
        plus-one
        (opt-loop-bce-i64-list-remove plus-one dst))]
    (if (and
      (not (= dst (- 0 1)))
      (opt-loop-bce-plus-one-add? type-segment-bases instr dst index-var))
      (opt-i64-list-add removed dst)
      removed)))

(define (opt-loop-bce-index-increment-instrs
  [type-segment-bases : i64]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [index-var : i64]
  [current : OptLoopBceIndexDef]
  [plus-one : OptI64List]) : OptLoopBceIndexDef
  (if (>= index count)
    current
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [next : OptLoopBceIndexDef
        (opt-loop-bce-index-increment-step
          type-segment-bases
          current
          plus-one
          instr
          index-var)]
      [next-plus : OptI64List
        (opt-loop-bce-plus-one-update
          type-segment-bases
          plus-one
          instr
          index-var)]
      (opt-loop-bce-index-increment-instrs
        type-segment-bases
        slots
        (+ index 1)
        count
        index-var
        next
        next-plus))))

(define (opt-loop-bce-block-last-def-increment?
  [type-segment-bases : i64]
  [block : CompilerIrBlock]
  [index-var : i64]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (match (opt-loop-bce-index-increment-instrs
        type-segment-bases
        (struct-get instrs slots)
        0
        (struct-get instrs len)
        index-var
        (OptLoopBceIndexDef.NoDef)
        (OptI64List.Nil))
        [(OptLoopBceIndexDef.Increment) true]
        [_ false])]))

(define (opt-loop-bce-block-jumps-to? [block : CompilerIrBlock] [target : i64]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (struct-get instrs len)]
        (if (= count 0)
          false
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Jump label) (= label target)]
            [_ false])))]))

(define (opt-loop-bce-header-edge-shape
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [preds : OptLabelSet]
  [header-label : i64]
  [index-var : i64]
  [seen-init : bool]
  [seen-latch : bool]) : OptLoopBceHeaderEdges
  (match preds
    [(OptLabelSet.Nil) (OptLoopBceHeaderEdges.Edges true seen-init seen-latch)]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (match (opt-cfg-find-block blocks pred)
          [(OptMaybeBlock.Some block)
            (let
              [init? : bool (opt-loop-bce-block-last-def-zero? block index-var)]
              [latch? : bool
                (and
                  (opt-loop-bce-block-last-def-increment?
                    type-segment-bases
                    block
                    index-var)
                  (opt-loop-bce-block-jumps-to? block header-label))]
              (if (or init? latch?)
                (opt-loop-bce-header-edge-shape
                  type-segment-bases
                  blocks
                  (opt-label-tail preds)
                  header-label
                  index-var
                  (or seen-init init?)
                  (or seen-latch latch?))
                (OptLoopBceHeaderEdges.Edges false seen-init seen-latch)))]
          [(OptMaybeBlock.No)
            (OptLoopBceHeaderEdges.Edges false seen-init seen-latch)]))]))

(define (opt-loop-bce-guard-nonnegative?
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [header-label : i64]
  [body-label : i64]
  [index-expr : OptLoopBceExpr]) : bool
  (match (opt-loop-bce-expr-var index-expr)
    [(OptLoopBceMaybeVar.NoVar) false]
    [(OptLoopBceMaybeVar.SomeVar index-var)
      (let
        [body-preds : OptLabelSet (opt-cfg-index-predecessors index body-label)]
        [header-preds : OptLabelSet
          (opt-cfg-index-predecessors index header-label)]
        (if (and
          (= (opt-label-count body-preds) 1)
          (opt-label-contains body-preds header-label)
          (= (opt-label-count header-preds) 2))
          (if (opt-label-contains header-preds body-label)
            (match (opt-loop-bce-label-set-other-than header-preds body-label)
              [(OptLoopBceMaybeLabel.SomeLabel preheader-label)
                (match (opt-cfg-find-block blocks preheader-label)
                  [(OptMaybeBlock.Some preheader)
                    (match (opt-cfg-find-block blocks body-label)
                      [(OptMaybeBlock.Some body)
                        (and
                          (opt-loop-bce-block-last-def-zero?
                            preheader
                            index-var)
                          (opt-loop-bce-block-last-def-increment?
                            type-segment-bases
                            body
                            index-var)
                          (opt-loop-bce-block-jumps-to? body header-label))]
                      [(OptMaybeBlock.No) false])]
                  [(OptMaybeBlock.No) false])]
              [(OptLoopBceMaybeLabel.NoLabel) false])
            (match (opt-loop-bce-header-edge-shape
              type-segment-bases
              blocks
              header-preds
              header-label
              index-var
              false
              false)
              [(OptLoopBceHeaderEdges.Edges ok seen-init seen-latch)
                (and ok seen-init seen-latch)]))
          false))]))

(define (opt-loop-bce-induction-start-nonnegative?
  [start : CompilerIrValue]
  [ty : AstType]) : bool
  (match (opt-normalize-scalar-to-i64 start ty)
    [(option_i64.Some value) (>= value 0)]
    [(option_i64.None) false]))

(define (opt-loop-bce-induction-step-safe?
  [step : i64]
  [upper : OptLoopBceExpr]
  [upper-inclusive : bool]
  [ty : AstType]) : bool
  (if (<= step 0)
    false
    (if (and (= step 1) (not upper-inclusive))
      true
      (match (opt-range-expr-i64 upper ty)
        [(option_i64.Some value)
          (if upper-inclusive
            (<= value (- 9223372036854775807 step))
            (<= value (+ (- 9223372036854775807 step) 1)))]
        [(option_i64.None) false]))))

(define (opt-loop-bce-induction-fact-safe?
  [fact : OptInductionFact]
  [upper : OptLoopBceExpr]
  [upper-inclusive : bool]) : bool
  (match fact
    [(OptInductionFact.Fact _ start _ step ty)
      (and
        (opt-induction-i64-type? ty)
        (opt-loop-bce-induction-start-nonnegative? start ty)
        (opt-loop-bce-induction-step-safe? step upper upper-inclusive ty))]))

(define (opt-loop-bce-induction-fact-for-var-instr-seq-from
  [type-segment-bases : i64]
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptMaybeInductionFact
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptMaybeInductionFact.No)
    (match (opt-induction-fact-from-phi
      type-segment-bases
      body-blocks
      loop
      preheader
      (compiler-ir-instr-seq-ref instrs index))
      [(OptMaybeInductionFact.Some fact)
        (match fact
          [(OptInductionFact.Fact phi-var _ _ _ _)
            (if (= phi-var var)
              (OptMaybeInductionFact.Some fact)
              (opt-loop-bce-induction-fact-for-var-instr-seq-from
                type-segment-bases
                body-blocks
                loop
                preheader
                instrs
                (+ index 1)
                var))])]
      [(OptMaybeInductionFact.No)
        (opt-loop-bce-induction-fact-for-var-instr-seq-from
          type-segment-bases
          body-blocks
          loop
          preheader
          instrs
          (+ index 1)
          var)])))

(define (opt-loop-bce-induction-fact-for-var
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [var : i64]) : OptMaybeInductionFact
  (let
    [body-blocks : CompilerIrBlockList
      (opt-natural-loop-current-body-blocks loop blocks)]
    (match (opt-cfg-find-block body-blocks (opt-natural-loop-header loop))
      [(OptMaybeBlock.Some block)
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (opt-loop-bce-induction-fact-for-var-instr-seq-from
              type-segment-bases
              body-blocks
              loop
              preheader
              instrs
              0
              var)])]
      [(OptMaybeBlock.No) (OptMaybeInductionFact.No)])))

(define (opt-loop-bce-canonical-iv-loop
  [doms : OptDomInfo]
  [loops : OptNaturalLoopList]
  [header-label : i64]
  [body-label : i64]) : OptMaybeNaturalLoop
  (match loops
    [(OptNaturalLoopList.Nil) (OptMaybeNaturalLoop.No)]
    [(OptNaturalLoopList.Cons loop rest)
      (if (and
        (= (opt-natural-loop-header loop) header-label)
        (opt-label-contains (opt-natural-loop-body loop) body-label)
        (opt-dom-dominates? doms header-label body-label))
        (OptMaybeNaturalLoop.Some loop)
        (opt-loop-bce-canonical-iv-loop
          doms
          (box-get rest)
          header-label
          body-label))]))

(define (opt-loop-bce-canonical-iv-proof?
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [loops : OptNaturalLoopList]
  [sources : opt_i64_i64_map.Map]
  [header-label : i64]
  [body-label : i64]
  [iv : OptLoopBceExpr]
  [upper : OptLoopBceExpr]
  [upper-inclusive : bool]) : bool
  (and
    (opt-range-expr-stable? sources iv)
    (opt-range-expr-stable? sources upper)
    (match (opt-loop-bce-expr-var iv)
      [(OptLoopBceMaybeVar.NoVar) false]
      [(OptLoopBceMaybeVar.SomeVar iv-var)
        (match (opt-loop-bce-canonical-iv-loop
          doms
          loops
          header-label
          body-label)
          [(OptMaybeNaturalLoop.Some loop)
            (match (opt-natural-loop-preheader loop)
              [(OptLoopPreheader.Some preheader)
                (match (opt-loop-bce-induction-fact-for-var
                  type-segment-bases
                  blocks
                  loop
                  preheader
                  iv-var)
                  [(OptMaybeInductionFact.Some fact)
                    (opt-loop-bce-induction-fact-safe?
                      fact
                      upper
                      upper-inclusive)]
                  [(OptMaybeInductionFact.No) false])]
              [(OptLoopPreheader.No) false])]
          [(OptMaybeNaturalLoop.No) false])])))

(define (opt-loop-bce-add-canonical-iv-facts-for-bound
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [loops : OptNaturalLoopList]
  [sources : opt_i64_i64_map.Map]
  [header-label : i64]
  [body-label : i64]
  [iv : OptLoopBceExpr]
  [upper : OptLoopBceExpr]
  [upper-inclusive : bool]) : OptRangeFacts
  (if (opt-loop-bce-canonical-iv-proof?
    type-segment-bases
    blocks
    doms
    loops
    sources
    header-label
    body-label
    iv
    upper
    upper-inclusive)
    (opt-range-facts-add-nonnegative
      type-segment-bases
      (if upper-inclusive
        (opt-range-facts-add-less-than-or-eq
          type-segment-bases
          facts
          body-label
          iv
          upper)
        (opt-range-facts-add-less-than
          type-segment-bases
          facts
          body-label
          iv
          upper))
      body-label
      iv)
    facts))

(define (opt-loop-bce-add-canonical-iv-facts
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [loops : OptNaturalLoopList]
  [sources : opt_i64_i64_map.Map]
  [header-label : i64]
  [body-label : i64]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (match op
    [(CompilerIrBinOp.Lt)
      (opt-loop-bce-add-canonical-iv-facts-for-bound
        type-segment-bases
        facts
        blocks
        doms
        loops
        sources
        header-label
        body-label
        lhs
        rhs
        false)]
    [(CompilerIrBinOp.Gt)
      (opt-loop-bce-add-canonical-iv-facts-for-bound
        type-segment-bases
        facts
        blocks
        doms
        loops
        sources
        header-label
        body-label
        rhs
        lhs
        false)]
    [(CompilerIrBinOp.Le)
      (opt-loop-bce-add-canonical-iv-facts-for-bound
        type-segment-bases
        facts
        blocks
        doms
        loops
        sources
        header-label
        body-label
        lhs
        rhs
        true)]
    [(CompilerIrBinOp.Ge)
      (opt-loop-bce-add-canonical-iv-facts-for-bound
        type-segment-bases
        facts
        blocks
        doms
        loops
        sources
        header-label
        body-label
        rhs
        lhs
        true)]
    [_ facts]))

(define (opt-loop-bce-branch-state
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block-label : i64]
  [cond : CompilerIrValue]
  [true-label : i64]
  [false-label : i64]) : OptLoopBceState
  (match cond
    [(CompilerIrValue.Var cond-var)
      (match (opt-loop-bce-cmp-lookup (struct-get state cmps) cond-var)
        [(OptLoopBceCmpEnv.Cons _ op lhs rhs ty _)
          (let
            [marker : OptLoopBceExpr
              (OptLoopBceExpr.Value (CompilerIrValue.I64 (- 0 1)))]
            [operand-ty : AstType
              (opt-range-compare-operand-type types lhs rhs ty)]
            [true-ranges : OptRangeFacts
              (opt-range-add-edge-facts
                type-segment-bases
                (struct-get state ranges)
                sources
                types
                true-label
                op
                lhs
                rhs
                ty)]
            [false-ranges : OptRangeFacts
              (opt-range-add-edge-facts
                type-segment-bases
                true-ranges
                sources
                types
                false-label
                (opt-divrem-invert-compare op)
                lhs
                rhs
                ty)]
            [canonical-ranges : OptRangeFacts
              (opt-loop-bce-add-canonical-iv-facts
                type-segment-bases
                false-ranges
                blocks
                doms
                loops
                sources
                block-label
                true-label
                op
                lhs
                rhs)]
            [range-state : OptLoopBceState
              (opt-loop-bce-state-bind-ranges state canonical-ranges)]
            [range-nonnegative : bool
              (or
                (opt-range-nonnegative-contains?
                  type-segment-bases
                  (struct-get range-state ranges)
                  block-label
                  lhs)
                (let
                  [guard : OptLoopBceGuardEnv
                    (opt-loop-bce-guard-lookup
                      (struct-get state guards)
                      block-label)]
                  (match guard
                    [(OptLoopBceGuardEnv.Nil) false]
                    [(OptLoopBceGuardEnv.Dense _ _)
                      (match (opt-loop-bce-guard-ref guard 0)
                        [(OptLoopBceGuard.Guard _ found found-marker)
                          (and
                            (opt-loop-bce-expr-eq type-segment-bases found lhs)
                            (opt-loop-bce-expr-eq
                              type-segment-bases
                              found-marker
                              marker))])])))]
            [loop-nonnegative : bool
              (opt-loop-bce-guard-nonnegative?
                type-segment-bases
                blocks
                index
                block-label
                true-label
                lhs)]
            (match op
              [(CompilerIrBinOp.Ge)
                (match (opt-range-expr-i64 rhs operand-ty)
                  [(option_i64.Some value)
                    (if (= value 0)
                      (opt-loop-bce-state-bind-guard
                        range-state
                        true-label
                        lhs
                        marker)
                      range-state)]
                  [(option_i64.None) range-state])]
              [(CompilerIrBinOp.Gt)
                (match (opt-range-expr-i64 rhs operand-ty)
                  [(option_i64.Some value)
                    (if (and
                      (opt-signed-integer-type? operand-ty)
                      (= value (- 0 1)))
                      (opt-loop-bce-state-bind-guard
                        range-state
                        true-label
                        lhs
                        marker)
                      range-state)]
                  [(option_i64.None) range-state])]
              [(CompilerIrBinOp.Lt)
                (let
                  [lt-range-state : OptLoopBceState
                    (if loop-nonnegative
                      (opt-loop-bce-state-bind-ranges
                        range-state
                        (opt-range-facts-add-less-than
                          type-segment-bases
                          (opt-range-facts-add-nonnegative
                            type-segment-bases
                            (struct-get range-state ranges)
                            true-label
                            lhs)
                          true-label
                          lhs
                          rhs))
                      range-state)]
                  (if (or range-nonnegative loop-nonnegative)
                    (opt-loop-bce-state-bind-guard
                      lt-range-state
                      true-label
                      lhs
                      rhs)
                    lt-range-state))]
              [_ range-state]))]
        [(OptLoopBceCmpEnv.Nil) state])]
    [_ state]))

(define (opt-loop-bce-update-gep
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [ty : AstType]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    [aliases : OptLoopBceAliasEnv (struct-get invalid aliases)]
    [ptrs : OptLoopBcePtrEnv (struct-get invalid ptrs)]
    [base-kind : OptLoopBcePtrKind
      (match base
        [(CompilerIrValue.Var base-var) (opt-loop-bce-ptr-lookup ptrs base-var)]
        [_ (OptLoopBcePtrKind.Unknown)])]
    (match base
      [(CompilerIrValue.Var base-var)
        (let
          [object : i64 (opt-loop-bce-alias-resolve aliases base-var)]
          [kind : OptLoopBcePtrKind
            (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
              (OptLoopBcePtrKind.LengthSlot object)
              (if (opt-loop-bce-data-slot? offset)
                (OptLoopBcePtrKind.DataSlot object)
                (match base-kind
                  [(OptLoopBcePtrKind.DataBuffer buffer-object)
                    (OptLoopBcePtrKind.DataElement buffer-object)]
                  [_ (OptLoopBcePtrKind.Unknown)])))]
          (opt-loop-bce-state-bind-ptr
            (opt-loop-bce-state-bind-expr
              invalid
              sources
              dst
              (OptLoopBceExpr.Unknown))
            dst
            kind))]
      [_ invalid])))

(define (opt-loop-bce-update-load
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    [ptr-kind : OptLoopBcePtrKind
      (match src
        [(CompilerIrValue.Var ptr-var)
          (opt-loop-bce-ptr-lookup (struct-get invalid ptrs) ptr-var)]
        [_ (OptLoopBcePtrKind.Unknown)])]
    (match ptr-kind
      [(OptLoopBcePtrKind.LengthSlot object)
        (let
          [known : OptLoopBceExpr
            (opt-loop-bce-length-lookup (struct-get invalid lengths) object)]
          (match known
            [(OptLoopBceExpr.Unknown)
              (if (opt-gvn-stable-var? sources dst)
                (let
                  [loaded : OptLoopBceExpr
                    (OptLoopBceExpr.Value (CompilerIrValue.Var dst))]
                  (opt-loop-bce-state-bind-length
                    (opt-loop-bce-state-bind-expr invalid sources dst loaded)
                    object
                    loaded))
                invalid)]
            [_ (opt-loop-bce-state-bind-expr invalid sources dst known)]))]
      [(OptLoopBcePtrKind.DataSlot object)
        (opt-loop-bce-state-bind-ptr
          (opt-loop-bce-state-bind-expr
            invalid
            sources
            dst
            (OptLoopBceExpr.Unknown))
          dst
          (OptLoopBcePtrKind.DataBuffer object))]
      [_
        (match src
          [(CompilerIrValue.Global _)
            (if (opt-type-eq type-segment-bases ty (AstType.I64))
              (opt-loop-bce-state-bind-expr
                invalid
                sources
                dst
                (OptLoopBceExpr.Value src))
              invalid)]
          [_ invalid])])))

(define (opt-loop-bce-update-storeptr
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]) : OptLoopBceState
  (let
    [kind : OptLoopBcePtrKind
      (match ptr
        [(CompilerIrValue.Var ptr-var)
          (opt-loop-bce-ptr-lookup (struct-get state ptrs) ptr-var)]
        [_ (OptLoopBcePtrKind.Unknown)])]
    (match kind
      [(OptLoopBcePtrKind.LengthSlot object)
        (opt-loop-bce-state-bind-length
          state
          object
          (opt-loop-bce-value-expr sources (struct-get state exprs) value))]
      [(OptLoopBcePtrKind.DataSlot _) state]
      [(OptLoopBcePtrKind.DataBuffer _) state]
      [(OptLoopBcePtrKind.DataElement _) state]
      [(OptLoopBcePtrKind.Unknown) (opt-loop-bce-state-clear-lengths state)])))

(define (opt-loop-bce-update-call
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [name : i64]
  [args : CompilerIrCallArgs]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    [memory : OptLoopBceState
      (if (opt-loop-bce-summary-length-clean? summaries name)
        invalid
        (opt-loop-bce-state-clear-lengths invalid))]
    (if (and
      (= (compiler-ir-call-args-count args) 0)
      (opt-loop-bce-summary-argc-return? summaries name))
      (opt-loop-bce-state-bind-expr memory sources dst (OptLoopBceExpr.Argc))
      memory)))

(define (opt-loop-bce-update-instr
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block-label : i64]
  [instr : CompilerIrInstr]) : OptLoopBceState
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (let
        [expr-state : OptLoopBceState
          (opt-loop-bce-state-bind-expr
            state
            sources
            dst
            (opt-loop-bce-value-expr sources (struct-get state exprs) src))]
        (match src
          [(CompilerIrValue.Var src-var)
            (opt-loop-bce-state-bind-alias
              expr-state
              dst
              (opt-loop-bce-alias-resolve (struct-get state aliases) src-var))]
          [_ expr-state]))]
    [(CompilerIrInstr.Alloc dst _)
      (opt-loop-bce-state-bind-alias
        (opt-loop-bce-state-invalidate-def state dst)
        dst
        dst)]
    [(CompilerIrInstr.AddrOf dst _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.Gep dst base offset ty)
      (opt-loop-bce-update-gep
        type-segment-bases
        state
        sources
        dst
        base
        offset
        ty)]
    [(CompilerIrInstr.Load dst src ty)
      (opt-loop-bce-update-load type-segment-bases state sources dst src ty)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (opt-loop-bce-state-bind-expr
        state
        sources
        dst
        (if (opt-loop-bce-same-width-int-cast? type-segment-bases from-ty to-ty)
          (opt-loop-bce-value-expr sources (struct-get state exprs) src)
          (OptLoopBceExpr.Unknown)))]
    [(CompilerIrInstr.Bitcast dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (opt-divrem-compare-op? op)
        (let
          [operand-ty : AstType (opt-range-compare-value-type types lhs rhs ty)]
          (opt-loop-bce-state-bind-cmp
            state
            sources
            dst
            op
            (opt-loop-bce-value-expr sources (struct-get state exprs) lhs)
            (opt-loop-bce-value-expr sources (struct-get state exprs) rhs)
            operand-ty))
        (opt-loop-bce-state-bind-expr
          state
          sources
          dst
          (OptLoopBceExpr.Bin
            op
            (box (opt-loop-bce-value-expr sources (struct-get state exprs) lhs))
            (box (opt-loop-bce-value-expr sources (struct-get state exprs) rhs))
            ty)))]
    [(CompilerIrInstr.UnOp dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.LaneId dst _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.Splat dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.MaskNot dst _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
          (opt-loop-bce-state-clear-lengths
            (opt-loop-bce-state-invalidate-def state dst))])]
    [(CompilerIrInstr.TailMask dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.EntryArgc dst)
      (opt-loop-bce-state-bind-expr state sources dst (OptLoopBceExpr.Argc))]
    [(CompilerIrInstr.EntryArgv dst)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.EntryEnvp dst)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.CpuId dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.Xgetbv dst _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.Syscall dst _)
      (opt-loop-bce-state-clear-lengths
        (opt-loop-bce-state-invalidate-def state dst))]
    [(CompilerIrInstr.Call dst name args _)
      (opt-loop-bce-update-call state summaries sources dst name args)]
    [(CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-loop-bce-state-clear-lengths
        (opt-loop-bce-state-invalidate-def state dst))]
    [(CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-loop-bce-state-clear-lengths
        (opt-loop-bce-state-invalidate-def state dst))]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (match result
            [(CompilerIrSpmdCallResult.Unit)
              (opt-loop-bce-state-clear-lengths state)]
            [(CompilerIrSpmdCallResult.Value dst _ _)
              (opt-loop-bce-state-clear-lengths
                (opt-loop-bce-state-invalidate-def state dst))])])]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ _ _ _)
          (opt-loop-bce-state-clear-lengths state)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload _ _ _ _)
          (opt-loop-bce-state-clear-lengths state)])]
    [(CompilerIrInstr.StorePtr ptr value _)
      (opt-loop-bce-update-storeptr state sources ptr value)]
    [(CompilerIrInstr.CopyBytes _ _ _) (opt-loop-bce-state-clear-lengths state)]
    [(CompilerIrInstr.BoundsCheck _ _ _) state]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload _ _ _ _ _)
          (opt-loop-bce-state-clear-lengths state)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload _ _ _ _ _ _)
          (opt-loop-bce-state-clear-lengths state)])]
    [(CompilerIrInstr.Store _ _ _) state]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (opt-loop-bce-branch-state
        type-segment-bases
        state
        sources
        types
        blocks
        doms
        index
        loops
        block-label
        cond
        true-label
        false-label)]
    [(CompilerIrInstr.Phi dst _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.Pack dst _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.Word dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(CompilerIrInstr.TailCall _ _ _) (opt-loop-bce-state-clear-lengths state)]
    [(CompilerIrInstr.TailCallIndirect _ _ _)
      (opt-loop-bce-state-clear-lengths state)]
    [(CompilerIrInstr.Jump _) state]
    [(CompilerIrInstr.Return _) state]
    [(CompilerIrInstr.Switch _ _ _ _) state]))

(define (opt-loop-bce-length-expr-known?
  [type-segment-bases : i64]
  [lengths : OptLoopBceLengthEnv]
  [expr : OptLoopBceExpr]) : bool
  (match lengths
    [(OptLoopBceLengthEnv.Nil) false]
    [(OptLoopBceLengthEnv.Cons _ found rest)
      (if (opt-loop-bce-expr-eq type-segment-bases found expr)
        true
        (opt-loop-bce-length-expr-known? type-segment-bases (box-get rest) expr))]))

(define (opt-loop-bce-range-can-remove?
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [block-label : i64]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : bool
  (let
    [index-expr : OptLoopBceExpr
      (opt-loop-bce-value-expr sources (struct-get state exprs) index)]
    [length-expr : OptLoopBceExpr
      (opt-loop-bce-value-expr sources (struct-get state exprs) length)]
    [ranges : OptRangeFacts (struct-get state ranges)]
    [length-known-nonnegative : bool
      (opt-loop-bce-length-expr-known?
        type-segment-bases
        (struct-get state lengths)
        length-expr)]
    (or
      (and
        (opt-range-proves-nonnegative?
          type-segment-bases
          ranges
          block-label
          index-expr)
        (opt-range-proves-less-than?
          type-segment-bases
          ranges
          block-label
          index-expr
          length-expr))
      (opt-range-proves-additive-index-in-range?
        type-segment-bases
        ranges
        block-label
        index-expr
        length-expr
        length-known-nonnegative))))

(define (opt-loop-bce-can-remove?
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [block-label : i64]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : bool
  (let
    [length-expr : OptLoopBceExpr
      (opt-loop-bce-value-expr sources (struct-get state exprs) length)]
    (or
      (opt-loop-bce-range-can-remove?
        type-segment-bases
        state
        sources
        block-label
        index
        length)
      (and
        (opt-loop-bce-length-expr-known?
          type-segment-bases
          (struct-get state lengths)
          length-expr)
        (let
          [guard : OptLoopBceGuardEnv
            (opt-loop-bce-guard-lookup (struct-get state guards) block-label)]
          (match guard
            [(OptLoopBceGuardEnv.Nil) false]
            [(OptLoopBceGuardEnv.Dense _ _)
              (match (opt-loop-bce-guard-ref guard 0)
                [(OptLoopBceGuard.Guard _ guard-index guard-length)
                  (and
                    (opt-loop-bce-expr-eq
                      type-segment-bases
                      guard-index
                      (opt-loop-bce-value-expr
                        sources
                        (struct-get state exprs)
                        index))
                    (opt-loop-bce-expr-eq
                      type-segment-bases
                      guard-length
                      length-expr))])]))))))

(define (opt-loop-bce-rewrite-instr-seq-from
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]) : OptLoopBceRewrite
  (if (>= pos count)
    (OptLoopBceRewrite.Rewrite state CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs pos)]
      [drop? : bool
        (match instr
          [(CompilerIrInstr.BoundsCheck idx len _)
            (opt-loop-bce-can-remove?
              type-segment-bases
              state
              sources
              block-label
              idx
              len)]
          [_ false])]
      (if drop?
        (opt-loop-bce-rewrite-instr-seq-from
          type-segment-bases
          state
          summaries
          sources
          types
          blocks
          doms
          index
          loops
          block-label
          instrs
          (+ pos 1)
          count)
        (let
          [next-state : OptLoopBceState
            (opt-loop-bce-update-instr
              type-segment-bases
              state
              summaries
              sources
              types
              blocks
              doms
              index
              loops
              block-label
              instr)]
          (match (opt-loop-bce-rewrite-instr-seq-from
            type-segment-bases
            next-state
            summaries
            sources
            types
            blocks
            doms
            index
            loops
            block-label
            instrs
            (+ pos 1)
            count)
            [(OptLoopBceRewrite.Rewrite out-state out-rest)
              (OptLoopBceRewrite.Rewrite
                out-state
                (compiler-ir-instr-cons instr out-rest))]))))))

(define (opt-loop-bce-rewrite-instr-seq
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]) : OptLoopBceRewrite
  (opt-loop-bce-rewrite-instr-seq-from
    type-segment-bases
    state
    summaries
    sources
    types
    blocks
    doms
    index
    loops
    block-label
    instrs
    0
    (compiler-ir-instr-seq-count instrs)))

(define (opt-loop-bce-rewrite-block
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block : CompilerIrBlock]) : OptLoopBceBlockRewrite
  (match block
    [(CompilerIrBlock.Block label instrs)
      (match (opt-loop-bce-rewrite-instr-seq
        type-segment-bases
        state
        summaries
        sources
        types
        blocks
        doms
        index
        loops
        label
        instrs)
        [(OptLoopBceRewrite.Rewrite out-state out-instrs)
          (OptLoopBceBlockRewrite.Rewrite
            out-state
            (compiler-ir-block label out-instrs))])]))

(define (opt-loop-bce-length-store-shape-instrs
  [type-segment-bases : i64]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [ptrs : OptI64List]) : bool
  (if (>= index count)
    false
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      [removed : OptI64List
        (if (= dst (- 0 1))
          ptrs
          (opt-loop-bce-i64-list-remove ptrs dst))]
      [next-ptrs : OptI64List
        (match instr
          [(CompilerIrInstr.Gep gep-dst _ offset ty)
            (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
              (opt-i64-list-add removed gep-dst)
              removed)]
          [_ removed])]
      (match instr
        [(CompilerIrInstr.StorePtr ptr _ _)
          (match ptr
            [(CompilerIrValue.Var ptr-var)
              (if (opt-i64-list-contains? ptrs ptr-var)
                true
                (opt-loop-bce-length-store-shape-instrs
                  type-segment-bases
                  slots
                  (+ index 1)
                  count
                  next-ptrs))]
            [_
              (opt-loop-bce-length-store-shape-instrs
                type-segment-bases
                slots
                (+ index 1)
                count
                next-ptrs)])]
        [_
          (opt-loop-bce-length-store-shape-instrs
            type-segment-bases
            slots
            (+ index 1)
            count
            next-ptrs)]))))

(define (opt-loop-bce-length-store-shape-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [ptrs : OptI64List]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-length-store-shape-instrs
            type-segment-bases
            (struct-get instrs slots)
            0
            (struct-get instrs len)
            ptrs)
            true
            (opt-loop-bce-length-store-shape-blocks
              type-segment-bases
              (box-get rest)
              ptrs))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-bce-length-store-shape-blocks
        type-segment-bases
        (compiler-ir-block-seq-to-list seq)
        ptrs)]))

(define (opt-loop-bce-length-load-shape-instrs
  [type-segment-bases : i64]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [ptrs : OptI64List]) : bool
  (if (>= index count)
    false
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      [removed : OptI64List
        (if (= dst (- 0 1))
          ptrs
          (opt-loop-bce-i64-list-remove ptrs dst))]
      [next-ptrs : OptI64List
        (match instr
          [(CompilerIrInstr.Gep gep-dst _ offset ty)
            (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
              (opt-i64-list-add removed gep-dst)
              removed)]
          [_ removed])]
      (match instr
        [(CompilerIrInstr.Load _ ptr _)
          (match ptr
            [(CompilerIrValue.Var ptr-var)
              (if (opt-i64-list-contains? ptrs ptr-var)
                true
                (opt-loop-bce-length-load-shape-instrs
                  type-segment-bases
                  slots
                  (+ index 1)
                  count
                  next-ptrs))]
            [_
              (opt-loop-bce-length-load-shape-instrs
                type-segment-bases
                slots
                (+ index 1)
                count
                next-ptrs)])]
        [_
          (opt-loop-bce-length-load-shape-instrs
            type-segment-bases
            slots
            (+ index 1)
            count
            next-ptrs)]))))

(define (opt-loop-bce-length-load-shape-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [ptrs : OptI64List]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-length-load-shape-instrs
            type-segment-bases
            (struct-get instrs slots)
            0
            (struct-get instrs len)
            ptrs)
            true
            (opt-loop-bce-length-load-shape-blocks
              type-segment-bases
              (box-get rest)
              ptrs))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-bce-length-load-shape-blocks
        type-segment-bases
        (compiler-ir-block-seq-to-list seq)
        ptrs)]))

(define (opt-loop-bce-string-byte-shape-instrs
  [type-segment-bases : i64]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (array-ref slots index)
      [(CompilerIrInstr.Gep _ _ _ ty)
        (if (opt-type-eq type-segment-bases ty (AstType.Char))
          true
          (opt-loop-bce-string-byte-shape-instrs
            type-segment-bases
            slots
            (+ index 1)
            count))]
      [_
        (opt-loop-bce-string-byte-shape-instrs
          type-segment-bases
          slots
          (+ index 1)
          count)])))

(define (opt-loop-bce-string-byte-shape-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-string-byte-shape-instrs
            type-segment-bases
            (struct-get instrs slots)
            0
            (struct-get instrs len))
            true
            (opt-loop-bce-string-byte-shape-blocks
              type-segment-bases
              (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-bce-string-byte-shape-blocks
        type-segment-bases
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-argc-call-shape-instrs
  [summaries : OptLoopBceSummaries]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (array-ref slots index)
      [(CompilerIrInstr.Call _ name args _)
        (if (and
          (= (compiler-ir-call-args-count args) 0)
          (opt-loop-bce-summary-argc-return? summaries name))
          true
          (opt-loop-bce-argc-call-shape-instrs
            summaries
            slots
            (+ index 1)
            count))]
      [_
        (opt-loop-bce-argc-call-shape-instrs summaries slots (+ index 1) count)])))

(define (opt-loop-bce-argc-call-shape-blocks
  [summaries : OptLoopBceSummaries]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-argc-call-shape-instrs
            summaries
            (struct-get instrs slots)
            0
            (struct-get instrs len))
            true
            (opt-loop-bce-argc-call-shape-blocks summaries (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-bce-argc-call-shape-blocks
        summaries
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-compare-shape-instrs
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (array-ref slots index)
      [(CompilerIrInstr.BinOp _ op _ _ ty)
        (if (match op
          [(CompilerIrBinOp.Lt) true]
          [(CompilerIrBinOp.Gt) true]
          [_ false])
          true
          (opt-loop-bce-compare-shape-instrs slots (+ index 1) count))]
      [_ (opt-loop-bce-compare-shape-instrs slots (+ index 1) count)])))

(define (opt-loop-bce-compare-shape-blocks [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-compare-shape-instrs
            (struct-get instrs slots)
            0
            (struct-get instrs len))
            true
            (opt-loop-bce-compare-shape-blocks (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-bce-compare-shape-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-count-bounds-instr-seq-from
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-bounds-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(CompilerIrInstr.BoundsCheck _ _ _) 1]
          [_ 0])))))

(define (opt-count-bounds-instr-seq [instrs : CompilerIrInstrSeq]) : i64
  (opt-count-bounds-instr-seq-from
    (struct-get instrs slots)
    0
    (struct-get instrs len)
    0))

(define (opt-count-bounds-blocks [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) 0]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-bounds-instr-seq instrs)
            (opt-count-bounds-blocks (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-count-bounds-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-eligible-blocks?
  [type-segment-bases : i64]
  [summaries : OptLoopBceSummaries]
  [blocks : CompilerIrBlockList]) : bool
  (and
    (<= (compiler-ir-block-list-count blocks) 64)
    (> (opt-count-bounds-blocks blocks) 0)
    (or
      (and
        (opt-loop-bce-argc-call-shape-blocks summaries blocks)
        (opt-loop-bce-length-store-shape-blocks
          type-segment-bases
          blocks
          (OptI64List.Nil)))
      (and
        (opt-loop-bce-length-load-shape-blocks
          type-segment-bases
          blocks
          (OptI64List.Nil))
        (opt-loop-bce-string-byte-shape-blocks type-segment-bases blocks))
      (and
        (<= (compiler-ir-block-list-count blocks) 8)
        (opt-loop-bce-compare-shape-blocks blocks)))))

(define (opt-loop-bce-initial-state) : OptLoopBceState
  (OptLoopBceState
    (OptLoopBceExprEnv.Nil)
    (OptLoopBceAliasEnv.Nil)
    (OptLoopBcePtrEnv.Nil)
    (OptLoopBceLengthEnv.Nil)
    (OptLoopBceCmpEnv.Nil)
    (OptLoopBceGuardEnv.Nil)
    (OptRangeFacts.Nil)))

(define (opt-loop-bce-block-results-fill-empty!
  [out : (Array OptLoopBceBlockResult)]
  [index : i64]) : unit
  (if (>= index (array-length out))
    unit
    (begin
      (array-set! out index (OptLoopBceBlockResult.NoBlock))
      (opt-loop-bce-block-results-fill-empty! out (+ index 1)))))

(define (opt-loop-bce-materialize-blocks
  [out : (Array OptLoopBceBlockResult)]
  [blocks : CompilerIrBlockList]
  [block-id : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [material : CompilerIrBlock
          (if (< block-id (array-length out))
            (match (array-ref out block-id)
              [(OptLoopBceBlockResult.SomeBlock rewritten) rewritten]
              [(OptLoopBceBlockResult.NoBlock) block])
            block)]
        (compiler-ir-block-cons
          material
          (opt-loop-bce-materialize-blocks out (box-get rest) (+ block-id 1))))]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-bce-materialize-blocks
        out
        (compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-loop-bce-rewrite-id
  [type-segment-bases : i64]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [cfg-index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [children : OptCfgCsr]
  [out : (Array OptLoopBceBlockResult)]
  [id : i64]
  [state : OptLoopBceState]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count cfg-index)]
    (if (and (>= id 0) (< id count))
      (match (opt-cfg-index-block cfg-index id)
        [(OptMaybeBlock.No) unit]
        [(OptMaybeBlock.Some block)
          (match (opt-loop-bce-rewrite-block
            type-segment-bases
            state
            summaries
            sources
            types
            blocks
            doms
            cfg-index
            loops
            block)
            [(OptLoopBceBlockRewrite.Rewrite next-state rewritten)
              (begin
                (array-set! out id (OptLoopBceBlockResult.SomeBlock rewritten))
                (opt-loop-bce-rewrite-children
                  type-segment-bases
                  summaries
                  sources
                  types
                  blocks
                  doms
                  cfg-index
                  loops
                  children
                  out
                  id
                  next-state))])])
      unit)))

(define (opt-loop-bce-rewrite-children
  [type-segment-bases : i64]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [doms : OptDomInfo]
  [cfg-index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [children : OptCfgCsr]
  [out : (Array OptLoopBceBlockResult)]
  [parent-id : i64]
  [state : OptLoopBceState]) : unit
  (let
    [offsets : (Array i64) (struct-get children offsets)]
    [edges : (Array i64) (struct-get children edges)]
    [labels : (Array i64) (struct-get cfg-index labels)]
    [parent-label : i64 (array-ref labels parent-id)]
    [edge : i64 (array-ref offsets parent-id)]
    [end : i64 (array-ref offsets (+ parent-id 1))]
    (begin
      (while (< edge end)
        (let
          [child-id : i64 (array-ref edges edge)]
          [child-label : i64 (array-ref labels child-id)]
          [child-state : OptLoopBceState
            (opt-loop-bce-state-propagate-guard
              type-segment-bases
              state
              parent-label
              child-label)]
          (begin
            (opt-loop-bce-rewrite-id
              type-segment-bases
              summaries
              sources
              types
              blocks
              doms
              cfg-index
              loops
              children
              out
              child-id
              child-state)
            (set! edge (+ edge 1)))))
      unit)))

(define (opt-loop-bce-blocks
  [type-segment-bases : i64]
  [summaries : OptLoopBceSummaries]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (if (or
    (not (struct-get summaries enabled))
    (not (opt-loop-bce-eligible-blocks? type-segment-bases summaries blocks)))
    blocks
    (let
      [context : OptCfgContext (opt-cfg-context-build blocks)]
      [doms : OptDomInfo (struct-get context doms)]
      [cfg-index : OptCfgIndex (struct-get context index)]
      [count : i64 (opt-cfg-index-block-count cfg-index)]
      [children : OptCfgCsr (opt-gvn-dom-children doms)]
      [loops : OptNaturalLoopList
        (opt-cfg-natural-loops-with-context blocks context)]
      [out : (Array OptLoopBceBlockResult)
        (array.make-array OptLoopBceBlockResult count)]
      [sources : opt_i64_i64_map.Map
        (opt-gvn-sources-blocks
          blocks
          (opt-gvn-sources-params params (opt_i64_i64_map.with-capacity 64)))]
      [ssa-facts : OptSsaFacts
        (opt-ssa-facts-from-function type-segment-bases params blocks)]
      [types : OptSsaVarTypes
        (match ssa-facts
          [(OptSsaFacts.Facts _ _ fact-types) fact-types])]
      (begin
        (opt-loop-bce-block-results-fill-empty! out 0)
        (match (opt-cfg-index-id cfg-index (struct-get context entry-label))
          [(option_i64.Some entry-id)
            (if (and
              (>= entry-id 0)
              (array-ref (struct-get cfg-index reachable) entry-id))
              (opt-loop-bce-rewrite-id
                type-segment-bases
                summaries
                sources
                types
                blocks
                doms
                cfg-index
                loops
                children
                out
                entry-id
                (opt-loop-bce-initial-state))
              unit)]
          [(option_i64.None) unit])
        (opt-loop-bce-materialize-blocks out blocks 0)))))

(define (opt-loop-bce-state-propagate-guard
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [parent-label : i64]
  [child-label : i64]) : OptLoopBceState
  (let
    [range-state : OptLoopBceState
      (opt-loop-bce-state-bind-ranges
        state
        (opt-range-facts-propagate-label
          type-segment-bases
          (struct-get state ranges)
          parent-label
          child-label))]
    [child-guard : OptLoopBceGuardEnv
      (opt-loop-bce-guard-lookup (struct-get range-state guards) child-label)]
    (match child-guard
      [(OptLoopBceGuardEnv.Dense _ _) range-state]
      [(OptLoopBceGuardEnv.Nil)
        (let
          [parent-guard : OptLoopBceGuardEnv
            (opt-loop-bce-guard-lookup
              (struct-get range-state guards)
              parent-label)]
          (match parent-guard
            [(OptLoopBceGuardEnv.Nil) range-state]
            [(OptLoopBceGuardEnv.Dense _ _)
              (match (opt-loop-bce-guard-ref parent-guard 0)
                [(OptLoopBceGuard.Guard _ index length)
                  (opt-loop-bce-state-bind-guard
                    range-state
                    child-label
                    index
                    length)])]))])))

;; --- affine chain folding (codegen phase 6) ----------------------------------
;;
;; Collapse chained affine 64-bit integer arithmetic. With wrapping semantics
;; (SPEC: i64/u64 `+`/`-`/`*` wrap modulo 2^64),
;;   (x*C1 + K1)*C2 + K2  ==  x*(C1*C2) + (K1*C2 + K2)
;; so the x16 unroller's chained `acc = acc*A + K` copies fold back into ONE
;; mul+add per group, and chained counter increments `((i+1)+1)+1` fold into
;; parallel `i+2`/`i+3` offsets off the group counter. The pass is one forward
;; walk per block over the freshly rebuilt post-fold instruction sequence,
;; mutating it in place:
;;  * every var defined by `Add/Sub (Var x) (I64 k)` or `Mul (Var x) (I64 c)`
;;    (either operand order for Add/Mul) at 64-bit integer type gets an affine
;;    record; records are bound fully resolved (add-of-add and mul-of-mul are
;;    rewritten at bind time), so lookups never chase chains.
;;  * add-of-add and mul-of-mul rewrite only the CURRENT instruction and keep
;;    its value bit-identical, so they need no use-count gate.
;;  * add-of-mul-of-add is the recurrence composition: for
;;    `v = Mul(x, C2); dst = Add(v, K2)` with `x = Add(u, K1)`, rewrite v IN
;;    PLACE (at its recorded index) to `Mul(u', C')` and dst to
;;    `Add(v, K1*C2 + K2)`, where (u', C') resolves u through a mul record.
;;    Rewriting v changes v's VALUE (from (u+K1)*C2 to u*C2), so this arm is
;;    gated on uses(v) == 1 -- the current Add is that single use, and the
;;    gate also guarantees no OTHER record was derived from v.
;;  * The use counts are collected once per function and then kept EXACT:
;;    every rewrite that retargets an operand from one var to another also
;;    moves that use in the count array, so a later single-use consult never
;;    sees a stale count.
;;  * Records are invalidated when their key or base var is redefined
;;    (pre-SSA multi-def safety); a record whose base would be its own key
;;    (`i = i + 1`) is never bound. The env resets past a small cap so
;;    pathological blocks stay linear.
;; Runs only in the opt2 fixpoint pipeline (after fold, before loop BCE); the
;; intermediates orphaned by the rewrites are dropped by the pipeline's DCE.
(defenum OptAffineRec
  (No)
  ;; var == base + k
  (AddC i64 i64)
  ;; var == base * c, defined at instruction index idx of the current block
  (MulC i64 i64 i64))

(defenum OptAffineEnv
  (Nil)
  (Cons i64 OptAffineRec (Box OptAffineEnv)))

(defenum OptAffineStep
  (Result OptAffineEnv i64))

(defenum OptAffineOperands
  (No)
  (Some i64 i64))

;; Raised from 64 so a fully-folded x16 unrolled body (~64 affine records)
;; composes into a single mul+add group instead of splitting mid-chain.
(define (opt-affine-env-cap) : i64
  512)

(define (opt-affine-64bit-type? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [(AstType.U64) true]
    [_ false]))

;; Split a commutative (Var, I64) operand pair in either order.
(define (opt-affine-var-const [lhs : CompilerIrValue] [rhs : CompilerIrValue]) : OptAffineOperands
  (match lhs
    [(CompilerIrValue.Var v)
      (match rhs
        [(CompilerIrValue.I64 k) (OptAffineOperands.Some v k)]
        [_ (OptAffineOperands.No)])]
    [(CompilerIrValue.I64 k)
      (match rhs
        [(CompilerIrValue.Var v) (OptAffineOperands.Some v k)]
        [_ (OptAffineOperands.No)])]
    [_ (OptAffineOperands.No)]))

(define (opt-affine-env-lookup [env : OptAffineEnv] [var : i64]) : OptAffineRec
  (match env
    [(OptAffineEnv.Nil) (OptAffineRec.No)]
    [(OptAffineEnv.Cons key rec rest)
      (if (= key var)
        rec
        (opt-affine-env-lookup (box-get rest) var))]))

(define (opt-affine-rec-mentions? [rec : OptAffineRec] [var : i64]) : bool
  (match rec
    [(OptAffineRec.No) true]
    [(OptAffineRec.AddC base _) (= base var)]
    [(OptAffineRec.MulC base _ _) (= base var)]))

;; Drop every record keyed by `var` or derived from it (its base): both
;; describe the var's PREVIOUS value once it is redefined.
(define (opt-affine-env-purge [env : OptAffineEnv] [var : i64]) : OptAffineEnv
  (match env
    [(OptAffineEnv.Nil) (OptAffineEnv.Nil)]
    [(OptAffineEnv.Cons key rec rest)
      (let
        [tail : OptAffineEnv (opt-affine-env-purge (box-get rest) var)]
        (if (or (= key var) (opt-affine-rec-mentions? rec var))
          tail
          (OptAffineEnv.Cons key rec (box tail))))]))

;; Bind after the dst's def: purge stale records first, skip self-referential
;; records, and reset the env past the cap so blocks stay linear.
(define (opt-affine-env-bind-def
  [env : OptAffineEnv]
  [binds : i64]
  [dst : i64]
  [rec : OptAffineRec]) : OptAffineStep
  (let
    [purged : OptAffineEnv (opt-affine-env-purge env dst)]
    (match rec
      [(OptAffineRec.No) (OptAffineStep.Result purged binds)]
      [_
        (if (opt-affine-rec-mentions? rec dst)
          (OptAffineStep.Result purged binds)
          (if (>= binds (opt-affine-env-cap))
            (OptAffineStep.Result (OptAffineEnv.Nil) 0)
            (OptAffineStep.Result
              (OptAffineEnv.Cons dst rec (box purged))
              (+ binds 1))))])))

(define (opt-affine-use-count [uses : (Array i64)] [var : i64]) : i64
  (if (and (>= var 0) (< var (array-length uses)))
    (array-ref uses var)
    0))

;; Rewrites retarget one operand from `from` to `to`; keeping the counts exact
;; is what makes the single-use gate sound against earlier rewrites.
(define (opt-affine-use-retarget! [uses : (Array i64)] [from : i64] [to : i64]) : unit
  (begin
    (if (and (>= from 0) (< from (array-length uses)))
      (array-set! uses from (- (array-ref uses from) 1))
      unit)
    (if (and (>= to 0) (< to (array-length uses)))
      (array-set! uses to (+ (array-ref uses to) 1))
      unit)))

;; The 64-bit element type of the (recorded, hence 64-bit BinOp) instruction
;; at `index`; I64 is only a defensive fallback.
(define (opt-affine-instr-ty [instrs : CompilerIrInstrSeq] [index : i64]) : AstType
  (match (compiler-ir-instr-seq-ref instrs index)
    [(CompilerIrInstr.BinOp _ _ _ _ ty) ty]
    [_ (AstType.I64)]))

;; `dst = src + k` (Add, or Sub with k already negated; `emit-add?` keeps a
;; no-rewrite Sub in Sub form while its record is still additive).
(define (opt-affine-add-step
  [instrs : CompilerIrInstrSeq]
  [uses : (Array i64)]
  [index : i64]
  [env : OptAffineEnv]
  [binds : i64]
  [dst : i64]
  [src : i64]
  [k : i64]
  [ty : AstType]) : OptAffineStep
  (match (opt-affine-env-lookup env src)
    [(OptAffineRec.AddC base k1)
      ;; add-of-add: dst == base + (k1 + k), bit-identical.
      (begin
        (compiler-ir-instr-seq-set!
          instrs
          index
          (CompilerIrInstr.BinOp
            dst
            (CompilerIrBinOp.Add)
            (CompilerIrValue.Var base)
            (CompilerIrValue.I64 (+ k1 k))
            ty))
        (opt-affine-use-retarget! uses src base)
        (opt-affine-env-bind-def
          env
          binds
          dst
          (OptAffineRec.AddC base (+ k1 k))))]
    [(OptAffineRec.MulC mbase c vidx)
      ;; add-of-mul-of-add: the recurrence composition (see the pass comment).
      (match (opt-affine-env-lookup env mbase)
        [(OptAffineRec.AddC u k1)
          (if (= (opt-affine-use-count uses src) 1)
            (let
              ;; Resolve u through a mul record so the rewritten mul's base
              ;; stays fully resolved (mul-of-mul composes here).
              [vty : AstType (opt-affine-instr-ty instrs vidx)]
              [ubase : i64
                (match (opt-affine-env-lookup env u)
                  [(OptAffineRec.MulC t _ _) t]
                  [_ u])]
              [uc : i64
                (match (opt-affine-env-lookup env u)
                  [(OptAffineRec.MulC _ c0 _) (* c0 c)]
                  [_ c])]
              (begin
                (compiler-ir-instr-seq-set!
                  instrs
                  vidx
                  (CompilerIrInstr.BinOp
                    src
                    (CompilerIrBinOp.Mul)
                    (CompilerIrValue.Var ubase)
                    (CompilerIrValue.I64 uc)
                    vty))
                (opt-affine-use-retarget! uses mbase ubase)
                (compiler-ir-instr-seq-set!
                  instrs
                  index
                  (CompilerIrInstr.BinOp
                    dst
                    (CompilerIrBinOp.Add)
                    (CompilerIrValue.Var src)
                    (CompilerIrValue.I64 (+ (* k1 c) k))
                    ty))
                (match (opt-affine-env-bind-def
                  env
                  binds
                  src
                  (OptAffineRec.MulC ubase uc vidx))
                  [(OptAffineStep.Result env-v binds-v)
                    (opt-affine-env-bind-def
                      env-v
                      binds-v
                      dst
                      (OptAffineRec.AddC src (+ (* k1 c) k)))])))
            (opt-affine-env-bind-def env binds dst (OptAffineRec.AddC src k)))]
        [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.AddC src k))])]
    [(OptAffineRec.No)
      (opt-affine-env-bind-def env binds dst (OptAffineRec.AddC src k))]))

;; `dst = src * c`.
(define (opt-affine-mul-step
  [instrs : CompilerIrInstrSeq]
  [uses : (Array i64)]
  [index : i64]
  [env : OptAffineEnv]
  [binds : i64]
  [dst : i64]
  [src : i64]
  [c : i64]
  [ty : AstType]) : OptAffineStep
  (match (opt-affine-env-lookup env src)
    [(OptAffineRec.MulC base c1 _)
      ;; mul-of-mul: dst == base * (c1 * c), bit-identical.
      (begin
        (compiler-ir-instr-seq-set!
          instrs
          index
          (CompilerIrInstr.BinOp
            dst
            (CompilerIrBinOp.Mul)
            (CompilerIrValue.Var base)
            (CompilerIrValue.I64 (* c1 c))
            ty))
        (opt-affine-use-retarget! uses src base)
        (opt-affine-env-bind-def
          env
          binds
          dst
          (OptAffineRec.MulC base (* c1 c) index)))]
    [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.MulC src c index))]))

(define (opt-affine-instr-step
  [instrs : CompilerIrInstrSeq]
  [uses : (Array i64)]
  [index : i64]
  [env : OptAffineEnv]
  [binds : i64]) : OptAffineStep
  (let
    [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
    (match instr
      [(CompilerIrInstr.BinOp dst op lhs rhs ty)
        (if (opt-affine-64bit-type? ty)
          (match op
            [(CompilerIrBinOp.Add)
              (match (opt-affine-var-const lhs rhs)
                [(OptAffineOperands.Some src k)
                  (opt-affine-add-step instrs uses index env binds dst src k ty)]
                [(OptAffineOperands.No)
                  (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])]
            [(CompilerIrBinOp.Sub)
              ;; Only `Var - I64` is additive; the negation wraps like the op.
              (match lhs
                [(CompilerIrValue.Var src)
                  (match rhs
                    [(CompilerIrValue.I64 k)
                      (opt-affine-add-step
                        instrs
                        uses
                        index
                        env
                        binds
                        dst
                        src
                        (- 0 k)
                        ty)]
                    [_
                      (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])]
                [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])]
            [(CompilerIrBinOp.Mul)
              (match (opt-affine-var-const lhs rhs)
                [(OptAffineOperands.Some src c)
                  (opt-affine-mul-step instrs uses index env binds dst src c ty)]
                [(OptAffineOperands.No)
                  (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])]
            [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])
          (opt-affine-env-bind-def env binds dst (OptAffineRec.No)))]
      [(CompilerIrInstr.Mov dst src ty)
        ;; A register copy is a zero-offset affine link: tracking it (resolved
        ;; through the source's own additive record, exactly like an add binds)
        ;; keeps chains foldable even when the unroller's loop-carried
        ;; writeback Movs survive into the body. Record-only -- the Mov
        ;; instruction itself is never rewritten.
        (if (opt-affine-64bit-type? ty)
          (match src
            [(CompilerIrValue.Var v)
              (match (opt-affine-env-lookup env v)
                [(OptAffineRec.AddC base k1)
                  (opt-affine-env-bind-def
                    env
                    binds
                    dst
                    (OptAffineRec.AddC base k1))]
                [_
                  (opt-affine-env-bind-def
                    env
                    binds
                    dst
                    (OptAffineRec.AddC v 0))])]
            [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])
          (opt-affine-env-bind-def env binds dst (OptAffineRec.No)))]
      [_
        (let
          [dst : i64 (opt-gvn-instr-dst instr)]
          (if (< dst 0)
            (OptAffineStep.Result env binds)
            (opt-affine-env-bind-def env binds dst (OptAffineRec.No))))])))

(define (opt-affine-fold-step!
  [instrs : CompilerIrInstrSeq]
  [uses : (Array i64)]
  [index : i64]
  [env : OptAffineEnv]
  [binds : i64]) : unit
  (if (>= index (compiler-ir-instr-seq-count instrs))
    unit
    (match (opt-affine-instr-step instrs uses index env binds)
      [(OptAffineStep.Result next-env next-binds)
        (opt-affine-fold-step! instrs uses (+ index 1) next-env next-binds)])))

;; Cheap prescan: the pass only pays for blocks with at least two foldable
;; affine candidates (the minimum for any chain).
(define (opt-affine-instr-candidate? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ op lhs rhs ty)
      (if (opt-affine-64bit-type? ty)
        (match op
          [(CompilerIrBinOp.Add)
            (match (opt-affine-var-const lhs rhs)
              [(OptAffineOperands.Some _ _) true]
              [(OptAffineOperands.No) false])]
          [(CompilerIrBinOp.Sub)
            (match (opt-affine-var-const lhs rhs)
              [(OptAffineOperands.Some _ _) true]
              [(OptAffineOperands.No) false])]
          [(CompilerIrBinOp.Mul)
            (match (opt-affine-var-const lhs rhs)
              [(OptAffineOperands.Some _ _) true]
              [(OptAffineOperands.No) false])]
          [_ false])
        false)]
    [_ false]))

(define (opt-affine-instr-seq-candidate?
  [slots : (Array CompilerIrInstr)]
  [index : i64]) : bool
  (opt-affine-instr-candidate? (array-ref slots index)))

(define (opt-affine-seq-candidate-from?
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [seen : i64]) : bool
  (if (>= index count)
    false
    (if (opt-affine-instr-seq-candidate? slots index)
      (if (>= (+ seen 1) 2)
        true
        (opt-affine-seq-candidate-from? slots (+ index 1) count (+ seen 1)))
      (opt-affine-seq-candidate-from? slots (+ index 1) count seen))))

(define (opt-affine-block-candidate? [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (opt-affine-seq-candidate-from?
        (struct-get instrs slots)
        0
        (compiler-ir-instr-seq-count instrs)
        0)]))

(define (opt-affine-blocks-have-candidate? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-affine-block-candidate? block)
        true
        (opt-affine-blocks-have-candidate? (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-affine-blocks-have-candidate? (compiler-ir-block-seq-to-list seq))]))

(define (opt-affine-fold-blocks-walk!
  [uses : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (if (opt-affine-seq-candidate-from?
              (struct-get instrs slots)
              0
              (compiler-ir-instr-seq-count instrs)
              0)
              (opt-affine-fold-step! instrs uses 0 (OptAffineEnv.Nil) 0)
              unit)])
        (opt-affine-fold-blocks-walk! uses (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-affine-fold-blocks-walk! uses (compiler-ir-block-seq-to-list seq))]))

;; Entry: rewrites the (freshly fold-rebuilt, exclusively owned) blocks in
;; place and returns them; a function with no two-candidate block is untouched.
(define (opt-affine-fold-blocks [frame : i64] [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (if (opt-affine-blocks-have-candidate? blocks)
    (begin
      (opt-affine-fold-blocks-walk!
        (opt-collect-blocks-uses-array frame blocks)
        blocks)
      blocks)
    blocks))

(define (opt-fold-strength-cse-instr-seq-rewrite!
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]) : i64
  (let
    [index : i64 0]
    [store-count : i64 0]
    [fold-state : OptConstEnv (OptConstEnv.Nil)]
    [strength-state : OptConstEnv (OptConstEnv.Nil)]
    [cse-state : OptExprTable (OptExprTable.Nil)]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< index count)
        (match (opt-fold-instr
          type-segment-bases
          fold-state
          (compiler-ir-instr-seq-ref instrs index))
          [(OptInstrResult.Result next-fold folded)
            (match (opt-strength-instr strength-state folded)
              [(OptInstrResult.Result next-strength strengthened)
                (match (opt-cse-instr type-segment-bases cse-state strengthened)
                  [(OptCseResult.Result next-cse rewritten)
                    (begin
                      (match rewritten
                        [(CompilerIrInstr.StorePtr _ _ _)
                          (if (< store-count 128)
                            (set! store-count (+ store-count 1))
                            unit)]
                        [_ unit])
                      (compiler-ir-instr-seq-set! instrs index rewritten)
                      (set! fold-state next-fold)
                      (set! strength-state next-strength)
                      (set! cse-state next-cse)
                      (set! index (+ index 1)))])])]))
      store-count)))

(define (opt-load-copy-instr-seq-rewrite!
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [index : i64 0]
    [sources : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 1)]
    [call-memory : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 1)]
    [load-state : OptLoadCseState state]
    [copy-state : OptCopyEnv (OptCopyEnv.Nil)]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (while (< index count)
      (match (opt-load-cse-dispatch
        type-segment-bases
        hs
        false
        sources
        call-memory
        load-state
        (compiler-ir-instr-seq-ref instrs index))
        [(OptLoadCseResult.Result next-load loaded)
          (match (opt-copy-instr copy-state loaded)
            [(OptCopyResult.Result next-copy rewritten)
              (begin
                (compiler-ir-instr-seq-set! instrs index rewritten)
                (set! load-state next-load)
                (set! copy-state next-copy)
                (set! index (+ index 1)))])]))))

;; --- fold pre-scan -------------------------------------------------------------
;;
;; Conservative "can any fold stage fire?" scan for one block. The fold pipeline
;; clones the block and runs four in-place stages (fold/strength/cse, dead
;; store, load-CSE + copy propagation, bounds-check elimination). When the scan
;; proves no stage can rewrite any instruction, the caller returns the input
;; block unchanged, skipping the clone and every stage walk. The scan is
;; EXACTLY conservative: it only reports "no fire" when firing is impossible,
;; so the fast path is behavior-identical to the full pipeline.
;;
;; Fire rules, derived from the stage sources:
;;   * fold/strength need a constant seed: a literal-valued Mov whose dst is
;;     read later (its env binding can only fire at a use site), an
;;     all-literal BinOp/UnOp (fold), a strength-identity op with an exact
;;     identity literal (x+0, x*1, bool identities), a literal-source or
;;     narrowing Cast, or a MaskBinOp with equal operands. With no seed the
;;     const env stays empty forever, so nothing resolves.
;;   * CSE needs two same-key BinOp/UnOp/CpuId/Xgetbv instructions; ignoring
;;     invalidation only over-reports (safe).
;;   * dead store runs only at >=2 StorePtr (its own gate).
;;   * load-CSE rewrites only Load, and the table starts empty, so it needs a
;;     Load plus at least one other producer (Load/StorePtr/CopyBytes).
;;   * copy propagation needs a binding (var-var/Unit Mov, Pack, or
;;     MaskBinOp with equal operands) whose dst is used by a later instruction;
;;     the backward used-later scan tracks every rewritable use (phi inputs
;;     and AddrOf sources are never rewritten, so they are not tracked).
;;   * bounds-check elimination drops a BoundsCheck only when an earlier
;;     BoundsCheck recorded the matching fact, so it needs >=2 BoundsChecks.
(define (opt-scan-literal? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.Char _) true]
    [(CompilerIrValue.Bool _) true]
    [(CompilerIrValue.F64 _) true]
    [_ false]))

;; Exact strength-identity test: these operand/op shapes always rewrite
;; (x+0, x-0, x|0, x^0, x*0, x*1, and any Bool literal with And/Or). Anything
;; else (x+5, x*3, ...) never does, so it must not count as a seed. Matches
;; opt-strength-int-binop / opt-strength-bool-binop on literal operands; a var
;; operand can only resolve through the const env, which needs a seed first.
(define (opt-scan-i64-literal? [value : CompilerIrValue] [n : i64]) : bool
  (match value
    [(CompilerIrValue.I64 m) (= m n)]
    [_ false]))

(define (opt-scan-bool-literal? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Bool _) true]
    [_ false]))

(define (opt-scan-strength-identity?
  [op : CompilerIrBinOp]
  [l : CompilerIrValue]
  [r : CompilerIrValue]) : bool
  (match op
    [(CompilerIrBinOp.Add)
      (or (opt-scan-i64-literal? l 0) (opt-scan-i64-literal? r 0))]
    [(CompilerIrBinOp.Sub) (opt-scan-i64-literal? r 0)]
    [(CompilerIrBinOp.Mul)
      (if (opt-scan-i64-literal? l 0)
        true
        (if (opt-scan-i64-literal? l 1)
          true
          (or (opt-scan-i64-literal? r 0) (opt-scan-i64-literal? r 1))))]
    [(CompilerIrBinOp.BitOr)
      (or (opt-scan-i64-literal? l 0) (opt-scan-i64-literal? r 0))]
    [(CompilerIrBinOp.BitXor)
      (or (opt-scan-i64-literal? l 0) (opt-scan-i64-literal? r 0))]
    [(CompilerIrBinOp.And)
      (or (opt-scan-bool-literal? l) (opt-scan-bool-literal? r))]
    [(CompilerIrBinOp.Or)
      (or (opt-scan-bool-literal? l) (opt-scan-bool-literal? r))]
    [_ false]))

;; One-instruction constant-seed test for the fold/strength stages. A
;; literal-valued Mov only seeds when its dst is read later: the env binding it
;; creates can only fire at a use site, and the Mov's own normalized rewrite is
;; structurally identical. `used-later` holds uses strictly after this
;; instruction at the call site (a backward scan), which covers every position
;; fold/strength resolve (Mov/Cast/BinOp/UnOp operands; phi inputs and AddrOf
;; are never rewritten, so they are not tracked).
(define (opt-scan-fsc-seed?
  [used-later : (Array i64)]
  [generation : i64]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (and
        (opt-scan-literal? src)
        (opt-scan-stamped? used-later generation dst))]
    [(CompilerIrInstr.BinOp _ op l r _)
      (if (and (opt-scan-literal? l) (opt-scan-literal? r))
        true
        (opt-scan-strength-identity? op l r))]
    [(CompilerIrInstr.UnOp _ _ v _) (opt-scan-literal? v)]
    [(CompilerIrInstr.Cast _ src from-ty to-ty)
      (or (opt-scan-literal? src) (opt-int-cast-as-mov? from-ty to-ty))]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _) (opt-value-eq lhs rhs)]
    [_ false]))

;; Key equality between two CSE-able instructions, ignoring the result type
;; (over-reporting duplicates is safe: it only forgoes the skip).
(define (opt-scan-cse-key-eq [a : CompilerIrInstr] [b : CompilerIrInstr]) : bool
  (match a
    [(CompilerIrInstr.BinOp _ aop al ar _)
      (match b
        [(CompilerIrInstr.BinOp _ bop bl br _)
          (and (opt-binop-eq aop bop) (opt-value-eq al bl) (opt-value-eq ar br))]
        [_ false])]
    [(CompilerIrInstr.UnOp _ aop av _)
      (match b
        [(CompilerIrInstr.UnOp _ bop bv _)
          (and (opt-unop-eq aop bop) (opt-value-eq av bv))]
        [_ false])]
    [(CompilerIrInstr.CpuId _ aleaf asub areg)
      (match b
        [(CompilerIrInstr.CpuId _ bleaf bsub breg)
          (and
            (opt-value-eq aleaf bleaf)
            (opt-value-eq asub bsub)
            (= areg breg))]
        [_ false])]
    [(CompilerIrInstr.Xgetbv _ aindex)
      (match b
        [(CompilerIrInstr.Xgetbv _ bindex) (opt-value-eq aindex bindex)]
        [_ false])]
    [_ false]))

;; Nested-loop duplicate scan over the first `limit` instructions; block sizes
;; are capped by the caller, so this stays cheap.
(define (opt-scan-cse-dup-from
  [slots : (Array CompilerIrInstr)]
  [outer : i64]
  [limit : i64]) : bool
  (if (>= outer limit)
    false
    (let
      [instr : CompilerIrInstr (array-ref slots outer)]
      [dup : bool
        (match instr
          [(CompilerIrInstr.BinOp _ _ _ _ _)
            (opt-scan-cse-dup-inner slots instr (+ outer 1) limit)]
          [(CompilerIrInstr.UnOp _ _ _ _)
            (opt-scan-cse-dup-inner slots instr (+ outer 1) limit)]
          [(CompilerIrInstr.CpuId _ _ _ _)
            (opt-scan-cse-dup-inner slots instr (+ outer 1) limit)]
          [(CompilerIrInstr.Xgetbv _ _)
            (opt-scan-cse-dup-inner slots instr (+ outer 1) limit)]
          [_ false])]
      (if dup
        true
        (opt-scan-cse-dup-from slots (+ outer 1) limit)))))

(define (opt-scan-cse-dup-inner
  [slots : (Array CompilerIrInstr)]
  [instr : CompilerIrInstr]
  [inner : i64]
  [limit : i64]) : bool
  (if (>= inner limit)
    false
    (if (opt-scan-cse-key-eq instr (array-ref slots inner))
      true
      (opt-scan-cse-dup-inner slots instr (+ inner 1) limit))))

;; Generation-stamped used-later set: `opt-scan-stamp` marks a var used at the
;; current block's generation, `opt-scan-stamped?` tests membership. Out-of-range
;; vars (negative pseudo-vars, or anything past the frame) are simply untracked;
;; they can never be a copy binding's dst, so skipping them stays conservative.
(define (opt-scan-stamp [items : (Array i64)] [generation : i64] [var : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length items))
      unit
      (array-set! items var generation))))

(define (opt-scan-stamped? [items : (Array i64)] [generation : i64] [var : i64]) : bool
  (if (< var 0)
    false
    (if (>= var (array-length items))
      false
      (= (array-ref items var) generation))))

(define (opt-scan-note-value-uses
  [items : (Array i64)]
  [generation : i64]
  [value : CompilerIrValue]) : unit
  (match value
    [(CompilerIrValue.Var id) (opt-scan-stamp items generation id)]
    [_ unit]))

(define (opt-scan-note-value-list-uses
  [items : (Array i64)]
  [generation : i64]
  [values : CompilerIrValueList]) : unit
  (match values
    [(CompilerIrValueList.Nil) unit]
    [(CompilerIrValueList.Array seq)
      (opt-scan-note-value-seq-uses items generation seq 0)]
    [(CompilerIrValueList.Cons value rest)
      (begin
        (opt-scan-note-value-uses items generation value)
        (opt-scan-note-value-list-uses items generation (box-get rest)))]))

(define (opt-scan-note-value-seq-uses
  [items : (Array i64)]
  [generation : i64]
  [seq : CompilerIrValueSeq]
  [index : i64]) : unit
  (if (>= index (struct-get seq len))
    unit
    (begin
      (opt-scan-note-value-uses
        items
        generation
        (array-ref (struct-get seq slots) index))
      (opt-scan-note-value-seq-uses items generation seq (+ index 1)))))

(define (opt-scan-note-call-args-uses
  [items : (Array i64)]
  [generation : i64]
  [args : CompilerIrCallArgs]) : unit
  (match args
    [(CompilerIrCallArgs.Nil) unit]
    [(CompilerIrCallArgs.One value)
      (opt-scan-note-value-uses items generation value)]
    [(CompilerIrCallArgs.Two a b)
      (begin
        (opt-scan-note-value-uses items generation a)
        (opt-scan-note-value-uses items generation b))]
    [(CompilerIrCallArgs.Array values)
      (opt-scan-note-value-array-uses items generation values 0)]))

(define (opt-scan-note-value-array-uses
  [items : (Array i64)]
  [generation : i64]
  [values : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length values))
    unit
    (begin
      (opt-scan-note-value-uses items generation (array-ref values index))
      (opt-scan-note-value-array-uses items generation values (+ index 1)))))

(define (opt-scan-note-spmd-call-args-uses
  [items : (Array i64)]
  [generation : i64]
  [args : CompilerIrSpmdCallArgList]) : unit
  (match args
    [(CompilerIrSpmdCallArgList.Nil) unit]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (begin
            (opt-scan-note-value-uses items generation value)
            (opt-scan-note-spmd-call-args-uses items generation (box-get rest)))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (opt-scan-note-spmd-call-arg-seq-uses items generation seq 0)]))

(define (opt-scan-note-spmd-call-arg-seq-uses
  [items : (Array i64)]
  [generation : i64]
  [seq : CompilerIrSpmdCallArgSeq]
  [index : i64]) : unit
  (if (>= index (struct-get seq len))
    unit
    (match (array-ref (struct-get seq slots) index)
      [(CompilerIrSpmdCallArg.Arg _ value _)
        (begin
          (opt-scan-note-value-uses items generation value)
          (opt-scan-note-spmd-call-arg-seq-uses
            items
            generation
            seq
            (+ index 1)))])))

;; Mark every var the instruction mentions in a position fold/strength can
;; resolve or copy propagation can rewrite; phi inputs and AddrOf sources are
;; never rewritten, so those arms intentionally note nothing.
(define (opt-scan-note-instr-uses
  [items : (Array i64)]
  [generation : i64]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(CompilerIrInstr.Mov _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(CompilerIrInstr.BinOp _ _ l r _)
      (begin
        (opt-scan-note-value-uses items generation l)
        (opt-scan-note-value-uses items generation r))]
    [(CompilerIrInstr.UnOp _ _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(CompilerIrInstr.Call _ _ args _)
      (opt-scan-note-call-args-uses items generation args)]
    [(CompilerIrInstr.CallIndirect _ func args _)
      (begin
        (opt-scan-note-value-uses items generation func)
        (opt-scan-note-call-args-uses items generation args))]
    [(CompilerIrInstr.CallIndirectC _ func args _)
      (begin
        (opt-scan-note-value-uses items generation func)
        (opt-scan-note-call-args-uses items generation args))]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base _ args _)
          (begin
            (opt-scan-note-value-uses items generation base)
            (opt-scan-note-call-args-uses items generation args))])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            _)
          (begin
            (opt-scan-note-value-uses items generation base)
            (opt-scan-note-value-uses items generation func)
            (opt-scan-note-call-args-uses items generation args))])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (begin
            (opt-scan-note-value-uses items generation active-mask)
            (opt-scan-note-spmd-call-args-uses items generation args))])]
    [(CompilerIrInstr.TailCall _ args _)
      (opt-scan-note-call-args-uses items generation args)]
    [(CompilerIrInstr.Store _ value _)
      (opt-scan-note-value-uses items generation value)]
    ;; AddrOf carries a raw storage slot, not a value operand: neither
    ;; fold/strength resolution nor copy substitution ever rewrites it, so it
    ;; is not a rewritable use (same for phi inputs below).
    [(CompilerIrInstr.AddrOf _ _) unit]
    [(CompilerIrInstr.Gep _ base offset _)
      (begin
        (opt-scan-note-value-uses items generation base)
        (opt-scan-note-value-uses items generation offset))]
    [(CompilerIrInstr.Load _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(CompilerIrInstr.StorePtr ptr value _)
      (begin
        (opt-scan-note-value-uses items generation ptr)
        (opt-scan-note-value-uses items generation value))]
    [(CompilerIrInstr.CopyBytes dst src _)
      (begin
        (opt-scan-note-value-uses items generation dst)
        (opt-scan-note-value-uses items generation src))]
    [(CompilerIrInstr.BoundsCheck index length _)
      (begin
        (opt-scan-note-value-uses items generation index)
        (opt-scan-note-value-uses items generation length))]
    [(CompilerIrInstr.Cast _ src _ _)
      (opt-scan-note-value-uses items generation src)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (opt-scan-note-value-uses items generation src)]
    [(CompilerIrInstr.Splat _ value _ _)
      (opt-scan-note-value-uses items generation value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (begin
            (opt-scan-note-value-uses items generation lhs)
            (opt-scan-note-value-uses items generation rhs))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (begin
            (opt-scan-note-value-uses items generation src)
            (opt-scan-note-value-uses items generation carry))])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-scan-note-value-uses items generation src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (begin
            (opt-scan-note-value-uses items generation lhs)
            (opt-scan-note-value-uses items generation rhs))])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (opt-scan-note-value-uses items generation lhs)
        (opt-scan-note-value-uses items generation rhs))]
    [(CompilerIrInstr.MaskNot _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (begin
            (opt-scan-note-value-uses items generation mask)
            (opt-scan-note-value-uses items generation on-true)
            (opt-scan-note-value-uses items generation on-false))])]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (begin
        (opt-scan-note-value-uses items generation base)
        (opt-scan-note-value-uses items generation index))]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value _ _)
          (begin
            (opt-scan-note-value-uses items generation base)
            (opt-scan-note-value-uses items generation index)
            (opt-scan-note-value-uses items generation value))])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            _
            _)
          (begin
            (opt-scan-note-value-uses items generation base)
            (opt-scan-note-value-uses items generation index)
            (opt-scan-note-value-uses items generation value)
            (opt-scan-note-value-uses items generation mask))])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base index mask _ _)
          (begin
            (opt-scan-note-value-uses items generation base)
            (opt-scan-note-value-uses items generation index)
            (opt-scan-note-value-uses items generation mask))])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            _
            base
            index-base
            index
            _
            _
            _)
          (begin
            (opt-scan-note-value-uses items generation base)
            (opt-scan-note-value-uses items generation index-base)
            (opt-scan-note-value-uses items generation index))])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (begin
            (opt-scan-note-value-uses items generation source)
            (opt-scan-note-value-uses items generation selector-low)
            (match selector-high
              [(CompilerIrMaybeValue.Some value)
                (opt-scan-note-value-uses items generation value)]
              [(CompilerIrMaybeValue.No) unit])
            (opt-scan-note-value-uses items generation active-lanes))])]
    [(CompilerIrInstr.TailMask _ index length _)
      (begin
        (opt-scan-note-value-uses items generation index)
        (opt-scan-note-value-uses items generation length))]
    [(CompilerIrInstr.EntryArgc _) unit]
    [(CompilerIrInstr.EntryArgv _) unit]
    [(CompilerIrInstr.EntryEnvp _) unit]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (begin
        (opt-scan-note-value-uses items generation leaf)
        (opt-scan-note-value-uses items generation subleaf))]
    [(CompilerIrInstr.Xgetbv _ index)
      (opt-scan-note-value-uses items generation index)]
    [(CompilerIrInstr.Syscall _ args)
      (opt-scan-note-call-args-uses items generation args)]
    [(CompilerIrInstr.Branch cond _ _)
      (opt-scan-note-value-uses items generation cond)]
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.Some value)
          (opt-scan-note-value-uses items generation value)]
        [(CompilerIrMaybeValue.No) unit])]
    [(CompilerIrInstr.Phi _ _ _) unit]
    [(CompilerIrInstr.Pack _ words _)
      (opt-scan-note-value-list-uses items generation words)]
    [(CompilerIrInstr.Word _ src _ _)
      (opt-scan-note-value-uses items generation src)]
    [(CompilerIrInstr.TailCallIndirect func args _)
      (begin
        (opt-scan-note-value-uses items generation func)
        (opt-scan-note-call-args-uses items generation args))]
    [(CompilerIrInstr.Switch index _ _ _)
      (opt-scan-note-value-uses items generation index)]
    [_ unit]))

;; Blocks longer than this always take the full path (rare, and usually full
;; of real work); the cap also bounds the duplicate-key nested loop.
(define (opt-scan-block-limit) : i64
  128)

;; Bitmask result: 0 means every fold stage is provably a no-op for the block.
;;   1 = block too long to scan cheaply      2 = fold/strength seed present
;;   4 = duplicate CSE key                   8 = >=2 StorePtr (dead store gate)
;;  16 = load-CSE producer pair             32 = copy binding with a later use
;;  64 = >=2 BoundsCheck
(define (opt-block-fold-scan
  [used-later : (Array i64)]
  [generation : i64]
  [instrs : CompilerIrInstrSeq]) : i64
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    (if (> count (opt-scan-block-limit))
      1
      (let
        [index : i64 (- count 1)]
        [stores : i64 0]
        [loads : i64 0]
        [producers : i64 0]
        [bchecks : i64 0]
        [mask : i64 0]
        (begin
          (while (>= index 0)
            (let
              [instr : CompilerIrInstr (array-ref slots index)]
              (begin
                ;; Copy-propagation fires at the USE site, so test the binding
                ;; dst against uses strictly after it before noting this
                ;; instruction's own uses.
                (match instr
                  [(CompilerIrInstr.Mov dst src _)
                    (match src
                      [(CompilerIrValue.Var sv)
                        (if (and
                          (not (= sv dst))
                          (opt-scan-stamped? used-later generation dst))
                          (set! mask (bit-or mask 32))
                          unit)]
                      [(CompilerIrValue.Unit)
                        (if (opt-scan-stamped? used-later generation dst)
                          (set! mask (bit-or mask 32))
                          unit)]
                      [_ unit])]
                  [(CompilerIrInstr.Pack dst _ _)
                    (if (opt-scan-stamped? used-later generation dst)
                      (set! mask (bit-or mask 32))
                      unit)]
                  [_ unit])
                (match instr
                  [(CompilerIrInstr.StorePtr _ _ _)
                    (begin
                      (set! stores (+ stores 1))
                      (set! producers (+ producers 1)))]
                  [(CompilerIrInstr.Load _ _ _)
                    (begin
                      (set! loads (+ loads 1))
                      (set! producers (+ producers 1)))]
                  [(CompilerIrInstr.CopyBytes _ _ _)
                    (set! producers (+ producers 1))]
                  [_ unit])
                (match instr
                  [(CompilerIrInstr.BoundsCheck _ _ _)
                    (set! bchecks (+ bchecks 1))]
                  [_ unit])
                (if (opt-scan-fsc-seed? used-later generation instr)
                  (set! mask (bit-or mask 2))
                  unit)
                (opt-scan-note-instr-uses used-later generation instr)
                (set! index (- index 1)))))
          (if (>= stores 2)
            (set! mask (bit-or mask 8))
            unit)
          (if (and (>= loads 1) (>= producers 2))
            (set! mask (bit-or mask 16))
            unit)
          (if (>= bchecks 2)
            (set! mask (bit-or mask 64))
            unit)
          (if (opt-scan-cse-dup-from slots 0 count)
            (set! mask (bit-or mask 4))
            unit)
          mask)))))

;; Monotonic scan generation source: bumped once per scanned block, never
;; reset, so stale stamps left in a freshly bump-allocated (uninitialized)
;; scan array can never alias the live generation. Garbage bytes that happen
;; to equal the live generation would only over-report "maybe" (the safe
;; direction), never skip a firing block.
(define opt-fold-scan-tag : i64
  0)

;; True when the pre-scan proves no fold stage can fire for this block, so the
;; fold pipeline (clone + four stage walks) can be skipped and the input block
;; returned unchanged. A length-zero work array disables scanning (cold entry
;; points have no frame), forcing the full path.
(define (opt-block-scan-skippable?
  [scan-work : (Array i64)]
  [block : CompilerIrBlock]) : bool
  (if (= (array-length scan-work) 0)
    false
    (match block
      [(CompilerIrBlock.Block _ instrs)
        (begin
          (set! opt-fold-scan-tag (+ opt-fold-scan-tag 1))
          (= (opt-block-fold-scan scan-work opt-fold-scan-tag instrs) 0))])))

(define (optimize-block-hs-full
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [dead-kinds : OptLoadPtrKinds]
  [load-kinds : OptLoadPtrKinds]
  [load-facts : OptAliasFacts]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [work : CompilerIrInstrSeq (compiler-ir-clone-instr-seq pools instrs)]
        [store-capacity : i64 0]
        ;; Fold scalar constants, reduce algebraic identities, eliminate repeated
        ;; pure expressions, propagate the resulting copies, then remove duplicate
        ;; proven bounds checks; function-level DCE drops dead copies. Independent
        ;; per-stage states preserve the old scheduling while the forward
        ;; one-in/one-out stages share two in-place traversals of the cloned block
        ;; sequence; bounds-check elimination then compacts that sequence in place.
        ;; Fold runs ONCE: it is a single forward pass that binds every folded
        ;; result into its env, so over the block it already reaches a fixpoint --
        ;; a second `opt-fold-instrs` over the result only re-walked and rebuilt
        ;; the list without changing it (byte-identical output, ~0.9% of
        ;; self-compile).
        (begin
          (set!
            store-capacity
            (opt-fold-strength-cse-instr-seq-rewrite! type-segment-bases work))
          (set!
            work
            (opt-dead-store-instr-seq-known-with-kinds
              type-segment-bases
              hs
              store-capacity
              dead-kinds
              work))
          (opt-load-copy-instr-seq-rewrite!
            type-segment-bases
            hs
            (opt-load-cse-empty-state-for-size-with-kinds
              (compiler-ir-instr-seq-count work)
              load-kinds
              load-facts)
            work)
          (opt-bounds-instr-seq-rewrite! type-segment-bases work)
          (CompilerIrBlock.Block label work)))]))

(define (optimize-block-hs-with-kinds
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [dead-kinds : OptLoadPtrKinds]
  [load-kinds : OptLoadPtrKinds]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]
  [scan-work : (Array i64)]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (if (opt-block-scan-skippable? scan-work block)
    block
    (optimize-block-hs-full
      pools
      type-segment-bases
      hs
      dead-kinds
      load-kinds
      (optimize-block-entry-facts block entry-label seed-facts)
      block)))

(define (optimize-block-hs
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [scan-work : (Array i64)]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (if (opt-block-scan-skippable? scan-work block)
    block
    (optimize-block-hs-full
      pools
      type-segment-bases
      hs
      (opt-load-kinds-empty)
      (opt-load-kinds-empty)
      (opt-alias-empty)
      block)))

(define (optimize-block
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (optimize-block-hs
    pools
    type-segment-bases
    (opt-load-header-set-empty)
    (array.make-array i64 0)
    block))

(define (optimize-block-entry-facts
  [block : CompilerIrBlock]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]) : OptAliasFacts
  (match block
    [(CompilerIrBlock.Block label _)
      (if (= label entry-label)
        seed-facts
        (opt-alias-empty))]))

(define (optimize-block-seq-hs
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]
  [scan-work : (Array i64)]
  [blocks : CompilerIrBlockSeq]) : CompilerIrBlockList
  (let
    [count : i64 (compiler-ir-block-seq-count blocks)]
    [slots : (Array CompilerIrBlock) (array.make-array CompilerIrBlock count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [block : CompilerIrBlock (compiler-ir-block-seq-ref blocks index)]
          (begin
            (array-set!
              slots
              index
              (optimize-block-hs-with-kinds
                pools
                type-segment-bases
                hs
                (opt-load-kinds-empty)
                (opt-load-kinds-empty)
                entry-label
                seed-facts
                scan-work
                block))
            (set! index (+ index 1)))))
      (CompilerIrBlockList.Array (CompilerIrBlockSeq slots count)))))

(define (optimize-block-seq-hs-dense
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]
  [scan-work : (Array i64)]
  [frame : i64]
  [blocks : CompilerIrBlockSeq]) : CompilerIrBlockList
  (let
    [count : i64 (compiler-ir-block-seq-count blocks)]
    [slots : (Array CompilerIrBlock) (array.make-array CompilerIrBlock count)]
    [work : OptLoadKindsDenseWork (opt-load-kinds-dense-work-with-size frame)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [generation : i64 (+ (* index 2) 1)]
          [block : CompilerIrBlock (compiler-ir-block-seq-ref blocks index)]
          (begin
            (array-set!
              slots
              index
              (optimize-block-hs-with-kinds
                pools
                type-segment-bases
                hs
                (opt-load-kinds-dense-state
                  work
                  generation
                  opt-load-cse-kinds-cap-floor)
                (opt-load-kinds-dense-state
                  work
                  (+ generation 1)
                  opt-load-cse-kinds-cap-floor)
                entry-label
                seed-facts
                scan-work
                block))
            (set! index (+ index 1)))))
      (CompilerIrBlockList.Array (CompilerIrBlockSeq slots count)))))

(define (optimize-block-list-hs
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]
  [scan-work : (Array i64)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (optimize-block-hs-with-kinds
          pools
          type-segment-bases
          hs
          (opt-load-kinds-empty)
          (opt-load-kinds-empty)
          entry-label
          seed-facts
          scan-work
          block)
        (optimize-block-list-hs
          pools
          type-segment-bases
          hs
          entry-label
          seed-facts
          scan-work
          (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (optimize-block-seq-hs
        pools
        type-segment-bases
        hs
        entry-label
        seed-facts
        scan-work
        seq)]))

(define (optimize-block-list-has-work?
  [scan-work : (Array i64)]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-block-scan-skippable? scan-work block)
        (optimize-block-list-has-work? scan-work (box-get rest))
        true)]
    [(CompilerIrBlockList.Array seq)
      (optimize-block-list-has-work?
        scan-work
        (compiler-ir-block-seq-to-list seq))]))

;; GAP4: the header-typed handle set feeds gep classification; build it from
;; the whole function so the block-local pass sees params and cross-block defs.
;; The scan work array is one uninitialized frame-sized scratch per call:
;; generation stamps reset it per block in O(1), and stale bytes can only ever
;; over-report "maybe" (safe), never skip a firing block.
(define (optimize-block-list-for-function-pass
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [frame : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptBlockListPassResult
  (let
    [scan-work : (Array i64) (array.make-array i64 frame)]
    (if (not (optimize-block-list-has-work? scan-work blocks))
      (OptBlockListPassResult.Result blocks false)
      (let
        [hs : OptLoadHeaderSet
          (opt-load-header-set-from-function-with-size
            type-segment-bases
            params
            blocks
            frame)]
        [entry-label : i64 (opt-cfg-entry-label blocks)]
        [seed-facts : OptAliasFacts
          (opt-alias-seed-params type-segment-bases params)]
        [next : CompilerIrBlockList
          (match blocks
            [(CompilerIrBlockList.Array seq)
              (optimize-block-seq-hs-dense
                pools
                type-segment-bases
                hs
                entry-label
                seed-facts
                scan-work
                frame
                seq)]
            [_
              (optimize-block-list-hs
                pools
                type-segment-bases
                hs
                entry-label
                seed-facts
                scan-work
                blocks)])]
        [changed : bool
          (not (opt-block-list-eq type-segment-bases blocks next))]
        (OptBlockListPassResult.Result
          (if changed
            next
            blocks)
          changed)))))

(define (optimize-block-list-for-function
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [frame : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match (optimize-block-list-for-function-pass
    pools
    type-segment-bases
    frame
    params
    blocks)
    [(OptBlockListPassResult.Result next _) next]))

(define (optimize-block-list
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (optimize-block-list-hs
    pools
    type-segment-bases
    (opt-load-header-set-empty)
    (compiler-ir-label "entry")
    (opt-alias-empty)
    (array.make-array i64 0)
    blocks))

;; Whole-function transforms keep a pathological-CFG work cap. Loop transforms
;; do not use this value: `run-loop?` below is deliberately unconditional and
;; every loop pass applies its own natural-loop-local admission checks.
(define (opt-heavy-pass-block-limit) : i64
  1026)

;; The inliner uses a separate crossing guard. Raising it with the heavy-pass
;; limit regresses the measured self-compile path, so keep the old boundary
;; until the inliner has a cost model that pays for larger callers directly.
(define (opt-inline-heavy-gate-block-limit) : i64
  1024)

;; --- self-tail-recursion -> loop (tail-rec-loop) ---------------------------
;;
;; A call to the CURRENT function in tail position (its result flows straight
;; into a `return`) is lowered as an `CompilerIrInstr.TailCall` whose callee name equals
;; the function name. The backend emits a real `call` for it, which
;; grows the stack frame on every recursive step. This pass rewrites each such
;; self-tail-call into a back-edge to the function entry block, turning the
;; recursion into an in-place loop:
;;
;;   * evaluate every call argument into a fresh temp slot (so a parameter that
;;     is read by a *later* argument still sees its old value),
;;   * copy each temp into the matching parameter slot,
;;   * jump to the entry block.
;;
;; Reassigning a parameter slot via `CompilerIrInstr.Mov` is exactly what a source-level
;; `(set! param ...)` lowers to, so this stays inside the IR's existing
;; "reassignment is allowed; redundancy passes invalidate on (re)definition"
;; model. Re-running the whole entry block per iteration is precisely the
;; tail-recursion semantics (a real recursive call re-executes the entire body),
;; so no loop pre-header is required. The reassignments make the function
;; non-SSA, so the SSA-gated passes (LICM, induction) simply skip it; the
;; unconditional passes (GVN/SCCP/copy-prop/CFG/DCE) handle the reassignments
;; the same way they handle ordinary loops built from `while`/`set!`.
(define (opt-tailrec-param-count [params : CompilerIrParamList]) : i64
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) 0]
    [(CompilerIrParamList.Array seq)
      (opt-tailrec-param-count (compiler-ir-param-seq-to-list seq))]
    [(CompilerIrParamList.Cons _ rest)
      (+ 1 (opt-tailrec-param-count (box-get rest)))]))

(define (opt-tailrec-array-values-to-list
  [values : (Array CompilerIrValue)]
  [index : i64]) : CompilerIrValueList
  (if (>= index (array-length values))
    CompilerIrValueList.Nil
    (compiler-ir-value-cons
      (array-ref values index)
      (opt-tailrec-array-values-to-list values (+ index 1)))))

(define (opt-tailrec-args-to-list [args : CompilerIrCallArgs]) : CompilerIrValueList
  (match args
    [(CompilerIrCallArgs.Nil) CompilerIrValueList.Nil]
    [(CompilerIrCallArgs.One a)
      (compiler-ir-value-cons a CompilerIrValueList.Nil)]
    [(CompilerIrCallArgs.Two a b)
      (compiler-ir-value-cons
        a
        (compiler-ir-value-cons b CompilerIrValueList.Nil))]
    [(CompilerIrCallArgs.Array values)
      (opt-tailrec-array-values-to-list values 0)]))

;; An unchanged tail argument needs no write back to its parameter slot. A
;; non-scalar identity is the structural trigger: when a caller containing an
;; already-SSA inner region is converted to a loop, non-scalars remain outside
;; scalar SSA and such a write would be a permanent duplicate definition. Once
;; that exact hybrid call-site shape is proven, the rewrite also omits its
;; unchanged scalar arguments. The predicate is paired by parameter and
;; argument at this call site; it is independent of enclosing function size and
;; layout.
(define (opt-tailrec-hybrid-identity-args?
  [params : CompilerIrParamList]
  [args : CompilerIrValueList]) : bool
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) false]
    [(CompilerIrParamList.Array seq)
      (opt-tailrec-hybrid-identity-args?
        (compiler-ir-param-seq-to-list seq)
        args)]
    [(CompilerIrParamList.Cons param prest)
      (match args
        [(CompilerIrValueList.Nil) false]
        [(CompilerIrValueList.Array seq)
          (opt-tailrec-hybrid-identity-args?
            params
            (compiler-ir-value-seq-to-list seq))]
        [(CompilerIrValueList.Cons arg arest)
          (match param
            [(CompilerIrParam.Param _ ty var-id)
              (if (and
                (not (opt-ssa-scalar-type? ty))
                (match arg
                  [(CompilerIrValue.Var source) (= source var-id)]
                  [_ false]))
                true
                (opt-tailrec-hybrid-identity-args?
                  (box-get prest)
                  (box-get arest)))])])]))

(define (opt-tailrec-instrs-have-hybrid-identity-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [fname : i64]
  [n : i64]
  [params : CompilerIrParamList]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.TailCall name args _)
        (if (and
          (compiler-ir-symbol-eq? name fname)
          (= (compiler-ir-call-args-count args) n)
          (opt-tailrec-hybrid-identity-args?
            params
            (opt-tailrec-args-to-list args)))
          true
          (opt-tailrec-instrs-have-hybrid-identity-from?
            instrs
            (+ index 1)
            fname
            n
            params))]
      [_
        (opt-tailrec-instrs-have-hybrid-identity-from?
          instrs
          (+ index 1)
          fname
          n
          params)])))

(define (opt-tailrec-blocks-have-hybrid-identity?
  [blocks : CompilerIrBlockList]
  [fname : i64]
  [n : i64]
  [params : CompilerIrParamList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-tailrec-instrs-have-hybrid-identity-from?
            instrs
            0
            fname
            n
            params)
            true
            (opt-tailrec-blocks-have-hybrid-identity?
              (box-get rest)
              fname
              n
              params))])]
    [(CompilerIrBlockList.Array seq)
      (opt-tailrec-blocks-have-hybrid-identity?
        (compiler-ir-block-seq-to-list seq)
        fname
        n
        params)]))

;; Copy each parameter's staged temp back into the parameter slot, then append
;; `tail` (the back-edge jump). Run after all of the staging moves so the temps
;; already hold the new argument values.
(define (opt-tailrec-assign-movs
  [params : CompilerIrParamList]
  [base : i64]
  [index : i64]
  [tail : CompilerIrInstrList]) : CompilerIrInstrList
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) tail]
    [(CompilerIrParamList.Array seq)
      (opt-tailrec-assign-movs
        (compiler-ir-param-seq-to-list seq)
        base
        index
        tail)]
    [(CompilerIrParamList.Cons param prest)
      (match param
        [(CompilerIrParam.Param _ ty var-id)
          (compiler-ir-instr-cons
            (CompilerIrInstr.Mov var-id (CompilerIrValue.Var (+ base index)) ty)
            (opt-tailrec-assign-movs (box-get prest) base (+ index 1) tail))])]))

(define (opt-tailrec-assign-movs-hybrid
  [params : CompilerIrParamList]
  [args : CompilerIrValueList]
  [base : i64]
  [index : i64]
  [tail : CompilerIrInstrList]) : CompilerIrInstrList
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) tail]
    [(CompilerIrParamList.Array seq)
      (opt-tailrec-assign-movs-hybrid
        (compiler-ir-param-seq-to-list seq)
        args
        base
        index
        tail)]
    [(CompilerIrParamList.Cons param prest)
      (match args
        [(CompilerIrValueList.Nil) tail]
        [(CompilerIrValueList.Array seq)
          (opt-tailrec-assign-movs-hybrid
            params
            (compiler-ir-value-seq-to-list seq)
            base
            index
            tail)]
        [(CompilerIrValueList.Cons arg arest)
          (match param
            [(CompilerIrParam.Param _ ty var-id)
              (let
                [next : CompilerIrInstrList
                  (opt-tailrec-assign-movs-hybrid
                    (box-get prest)
                    (box-get arest)
                    base
                    (+ index 1)
                    tail)]
                (if (match arg
                  [(CompilerIrValue.Var source) (= source var-id)]
                  [_ false])
                  next
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Mov
                      var-id
                      (CompilerIrValue.Var (+ base index))
                      ty)
                    next)))])])]))

;; Evaluate each argument into a fresh temp slot (`base + i`) before any
;; parameter slot is overwritten, so argument aliasing on the parameters is
;; preserved.
(define (opt-tailrec-stage-movs
  [params : CompilerIrParamList]
  [args : CompilerIrValueList]
  [base : i64]
  [index : i64]
  [tail : CompilerIrInstrList]) : CompilerIrInstrList
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) tail]
    [(CompilerIrParamList.Array seq)
      (opt-tailrec-stage-movs
        (compiler-ir-param-seq-to-list seq)
        args
        base
        index
        tail)]
    [(CompilerIrParamList.Cons param prest)
      (match args
        [(CompilerIrValueList.Nil) tail]
        [(CompilerIrValueList.Array seq)
          (opt-tailrec-stage-movs
            params
            (compiler-ir-value-seq-to-list seq)
            base
            index
            tail)]
        [(CompilerIrValueList.Cons arg arest)
          (match param
            [(CompilerIrParam.Param _ ty _)
              (compiler-ir-instr-cons
                (CompilerIrInstr.Mov (+ base index) arg ty)
                (opt-tailrec-stage-movs
                  (box-get prest)
                  (box-get arest)
                  base
                  (+ index 1)
                  tail))])])]))

(define (opt-tailrec-self-call?
  [instr : CompilerIrInstr]
  [fname : i64]
  [n : i64]) : bool
  (match instr
    [(CompilerIrInstr.TailCall name args _)
      (and
        (compiler-ir-symbol-eq? name fname)
        (= (compiler-ir-call-args-count args) n))]
    [_ false]))

(define (opt-tailrec-rewrite-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [fname : i64]
  [params : CompilerIrParamList]
  [n : i64]
  [base : i64]
  [hybrid? : bool]
  [entry-label : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    CompilerIrInstrList.Nil
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (if (opt-tailrec-self-call? instr fname n)
        (match instr
          [(CompilerIrInstr.TailCall _ args _)
            (let
              [arg-list : CompilerIrValueList (opt-tailrec-args-to-list args)]
              (opt-tailrec-stage-movs
                params
                arg-list
                base
                0
                (if hybrid?
                  (opt-tailrec-assign-movs-hybrid
                    params
                    arg-list
                    base
                    0
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Jump entry-label)
                      CompilerIrInstrList.Nil))
                  (opt-tailrec-assign-movs
                    params
                    base
                    0
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Jump entry-label)
                      CompilerIrInstrList.Nil)))))]
          [_ CompilerIrInstrList.Nil])
        (compiler-ir-instr-cons
          instr
          (opt-tailrec-rewrite-instr-seq-from
            instrs
            (+ index 1)
            fname
            params
            n
            base
            hybrid?
            entry-label))))))

(define (opt-tailrec-rewrite-instr-seq
  [instrs : CompilerIrInstrSeq]
  [fname : i64]
  [params : CompilerIrParamList]
  [n : i64]
  [base : i64]
  [hybrid? : bool]
  [entry-label : i64]) : CompilerIrInstrList
  (opt-tailrec-rewrite-instr-seq-from
    instrs
    0
    fname
    params
    n
    base
    hybrid?
    entry-label))

(define (opt-tailrec-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [fname : i64]
  [params : CompilerIrParamList]
  [n : i64]
  [base : i64]
  [hybrid? : bool]
  [entry-label : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (compiler-ir-block
              label
              (opt-tailrec-rewrite-instr-seq
                instrs
                fname
                params
                n
                base
                hybrid?
                entry-label))
            (opt-tailrec-rewrite-blocks
              (box-get rest)
              fname
              params
              n
              base
              hybrid?
              entry-label))])]
    [(CompilerIrBlockList.Array seq)
      (opt-tailrec-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        fname
        params
        n
        base
        hybrid?
        entry-label)]))

(define (opt-tailrec-instr-seq-has-convertible-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [fname : i64]
  [n : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (match (& (array-ref (struct-get instrs slots) index))
      [(CompilerIrInstr.TailCall _ _ _)
        (opt-tailrec-self-call?
          (compiler-ir-instr-seq-ref instrs index)
          fname
          n)]
      [_ false])
      true
      (opt-tailrec-instr-seq-has-convertible-from? instrs (+ index 1) fname n))))

(define (opt-tailrec-instr-seq-has-convertible?
  [instrs : CompilerIrInstrSeq]
  [fname : i64]
  [n : i64]) : bool
  (opt-tailrec-instr-seq-has-convertible-from? instrs 0 fname n))

(define (opt-tailrec-blocks-have-convertible?
  [blocks : CompilerIrBlockList]
  [fname : i64]
  [n : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-tailrec-instr-seq-has-convertible? instrs fname n)
            true
            (opt-tailrec-blocks-have-convertible? (box-get rest) fname n))])]
    [(CompilerIrBlockList.Array seq)
      (opt-tailrec-blocks-have-convertible?
        (compiler-ir-block-seq-to-list seq)
        fname
        n)]))

(define (opt-tailrec-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function name params ret vars blocks)
      (let
        [n : i64 (opt-tailrec-param-count params)]
        (if (opt-tailrec-blocks-have-convertible? blocks name n)
          (let
            [hybrid? : bool
              (and
                (opt-ssa-blocks-have-phi? blocks)
                (opt-tailrec-blocks-have-hybrid-identity? blocks name n params))]
            [rewritten : CompilerIrBlockList
              (opt-tailrec-rewrite-blocks
                blocks
                name
                params
                n
                vars
                hybrid?
                (opt-cfg-entry-label blocks))]
            (CompilerIrFunction.Function
              name
              params
              ret
              (+ vars n)
              (if hybrid?
                (opt-ssa-explicit-entry-blocks rewritten)
                rewritten)))
          func))]))

;; --- canonical counted-loop unrolling (x16 straight-line / x2 diamond) -------
;;
;; Recognizes a single-block do-while loop B of the canonical rotated shape
;;
;;   B: phis...; body...; inext = iphi + 1; c = inext < bound; Branch c B EXIT
;;
;; with exactly the two CFG predecessors {P, B} (trusted from the verified phi
;; input labels) and a loop-invariant `bound`, then versions the loop: P is
;; retargeted to a fresh guard block G that either enters a fresh unrolled body
;; U (sixteen clones of B's straight-line body chained through the loop-carried
;; phis) or falls back to B, which stays in place as the remainder loop so
;; EXIT's phis keep their single B input. The guard computes
;;
;;   ngroup = bound - 16;  gok = (ngroup <= bound) and (seed < ngroup)
;;
;; and U keeps looping while its post-group counter stays below ngroup. The
;; guard uses bound - 16 (not bound - 15): B is a do-while, so handing control
;; back with the counter equal to `bound` would run one extra iteration;
;; `iu < bound - 16` guarantees the sixteen unrolled iterations AND at least
;; one remainder iteration stay below `bound`. The `ngroup <= bound` check
;; rejects a wrapped bound - 16, sending degenerate bounds straight to the
;; original loop. All counter arithmetic stays in the counter's own integer
;; type. The x16 group depth lets the affine pass fold long constant-step
;; chains (LCG-style `acc = acc*A + K`) into one composed mul+add per group,
;; which is what closes the arith_loop/array_sum instruction gap to clang.
;; A loop-carried phi other than the counter: dst, init value (from the outside
;; pred), back-edge value (from B), phi type.
(defenum OptUnrollPhi
  (Phi i64 CompilerIrValue CompilerIrValue AstType))

(defenum OptUnrollPhiList
  (Nil)
  (Cons OptUnrollPhi (Box OptUnrollPhiList)))

;; init value (from the outside pred), back-edge value, outside pred label.
(defenum OptUnrollPhiSplit
  (No)
  (Split CompilerIrValue CompilerIrValue i64))

(defenum OptUnrollMaybePhis
  (No)
  (Some OptUnrollPhiList))

(defstruct OptUnrollShape
  (loop-label i64)
  (pred-label i64)
  (phi-count i64)
  (cond-index i64)
  (cond-var i64)
  (iphi i64)
  (iphi-ty AstType)
  (seed CompilerIrValue)
  (inext i64)
  (ity AstType)
  (bound CompilerIrValue)
  (others OptUnrollPhiList))

(defenum OptUnrollMaybeShape
  (No)
  (Some OptUnrollShape))

;; SIMD values deliberately stay in mutable (non-SSA) form, so the SPMD
;; lowerer's rotated gang loop has no Phi prefix:
;;
;;   B: vector body...; i = inext; inext = i + lanes;
;;      c = inext <= bound; Branch c B EXIT
;;
;; The dedicated shape below versions that exact store-free form. Transient
;; results are freshened while a destination that reads itself remains mutable,
;; so each copy consumes the preceding copy's recurrence state. The original B
;; remains the remainder loop.
(defstruct OptUnrollSimdShape
  (pred-label i64)
  (tail-label i64)
  (cond-index i64)
  (index-var i64)
  (next-var i64)
  (step i64)
  (ity AstType)
  (bound CompilerIrValue)
  (cmp-op CompilerIrBinOp)
  (vector-base CompilerIrValue)
  (vector-ty AstType))

(defenum OptUnrollSimdMaybeShape
  (No)
  (Some OptUnrollSimdShape))

(defenum OptUnrollSimdLoadShape
  (Fail)
  (Empty)
  (Some CompilerIrValue AstType))

(defenum OptUnrollResult
  (Result CompilerIrBlockList i64 bool))

(define (opt-unroll-phi-prefix-count
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    index
    (if (compiler-ir-instr-seq-phi? instrs index)
      (opt-unroll-phi-prefix-count instrs (+ index 1))
      index)))

(define (opt-unroll-no-phi-from? [instrs : CompilerIrInstrSeq] [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (if (compiler-ir-instr-seq-phi? instrs index)
      false
      (opt-unroll-no-phi-from? instrs (+ index 1)))))

;; Clonable straight-line body instruction kinds. Anything else (calls, allocs,
;; vector stores, name stores, nested terminators) rejects the loop.
(define (opt-unroll-body-instr-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ _ _) true]
    [(CompilerIrInstr.Cast _ _ _ _) true]
    [(CompilerIrInstr.Bitcast _ _ _ _) true]
    [(CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(CompilerIrInstr.UnOp _ _ _ _) true]
    [(CompilerIrInstr.Gep _ _ _ _) true]
    [(CompilerIrInstr.Load _ _ _) true]
    ;; Store-free SIMD gang bodies have the same long-trip compute/load shape
    ;; as scalar reductions and scans. Keep vector stores and predicated memory
    ;; operations excluded alongside scalar StorePtr.
    [(CompilerIrInstr.LaneId _ _ _) true]
    [(CompilerIrInstr.Splat _ _ _ _) true]
    [(CompilerIrInstr.VectorBinOp _) true]
    [(CompilerIrInstr.VectorReduce _ _ _ _ _) true]
    [(CompilerIrInstr.VectorCompare _) true]
    [(CompilerIrInstr.MaskBinOp _ _ _ _ _) true]
    [(CompilerIrInstr.Select _) true]
    [(CompilerIrInstr.VectorLoad _ _ _ _ _) true]
    ;; StorePtr deliberately EXCLUDED: store-bearing counted loops are
    ;; dominated by fills and short-trip container writes (hashmap grow/insert
    ;; regressed 1-2%, self-compile +1.4% when they unrolled -- the entry
    ;; guard plus 4x body is a net loss below ~8 iterations, and trip counts
    ;; are unknowable statically). Pure compute/load loops (arithmetic
    ;; recurrences, sums, reductions, scans) are the long-trip shapes where
    ;; x4 pays: arith_loop -30%, array_sum -33%, spmd_reduce -36%.
    [(CompilerIrInstr.BoundsCheck _ _ _) true]
    [_ false]))

(define (opt-unroll-body-instr-seq-ok?
  [slots : (Array CompilerIrInstr)]
  [index : i64]) : bool
  (opt-unroll-body-instr-ok? (array-ref slots index)))

(define (opt-unroll-body-ok?
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-unroll-body-instr-seq-ok? slots index)
      (opt-unroll-body-ok? slots (+ index 1) last))))

(define (opt-unroll-block-defs
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index count)
    acc
    (let
      [dst : i64 (compiler-ir-instr-array-loop-dst-or slots index (- 0 1))]
      (opt-unroll-block-defs
        slots
        (+ index 1)
        count
        (if (< dst 0)
          acc
          (opt-used-add acc dst))))))

(define (opt-unroll-def-index
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [last : i64]
  [var : i64]) : i64
  (if (>= index last)
    (- 0 1)
    (if (= (compiler-ir-instr-array-loop-dst-or slots index (- 0 1)) var)
      index
      (opt-unroll-def-index slots (+ index 1) last var))))

(define (opt-unroll-uses-before
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index last)
    acc
    (opt-unroll-uses-before
      instrs
      (+ index 1)
      last
      (opt-collect-instr-uses acc (compiler-ir-instr-seq-ref instrs index)))))

;; Resolve a var through same-block Mov copies (the loop-carried writeback
;; often survives as `mov vK = vNext` feeding the phi). SSA single-defs keep
;; the chain acyclic; the fuel bounds it defensively anyway.
(define (opt-unroll-resolve-copy
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [var : i64]
  [fuel : i64]) : i64
  (if (<= fuel 0)
    var
    (let
      [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
      [def-index : i64 (opt-unroll-def-index slots phi-count last var)]
      (if (< def-index 0)
        var
        (match (array-ref slots def-index)
          [(CompilerIrInstr.Mov _ src _)
            (match src
              [(CompilerIrValue.Var src-id)
                (opt-unroll-resolve-copy
                  instrs
                  phi-count
                  last
                  src-id
                  (- fuel 1))]
              [_ var])]
          [_ var])))))

(define (opt-unroll-split-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [loop-label : i64]) : OptUnrollPhiSplit
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Cons first-value first-label rest-box)
      (match (box-get rest-box)
        [(CompilerIrPhiInputList.Cons second-value second-label tail-box)
          (match (box-get tail-box)
            [(CompilerIrPhiInputList.Nil)
              (if (= first-label loop-label)
                (if (= second-label loop-label)
                  (OptUnrollPhiSplit.No)
                  (OptUnrollPhiSplit.Split
                    second-value
                    first-value
                    second-label))
                (if (= second-label loop-label)
                  (OptUnrollPhiSplit.Split first-value second-value first-label)
                  (OptUnrollPhiSplit.No)))]
            [_ (OptUnrollPhiSplit.No)])]
        [_ (OptUnrollPhiSplit.No)])]
    [_ (OptUnrollPhiSplit.No)]))

(define (opt-unroll-collect-other-phis
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [loop-label : i64]
  [pred-label : i64]
  [iphi : i64]) : OptUnrollMaybePhis
  (if (>= index phi-count)
    (OptUnrollMaybePhis.Some (OptUnrollPhiList.Nil))
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi dst inputs ty)
        (if (= dst iphi)
          (opt-unroll-collect-other-phis
            instrs
            (+ index 1)
            phi-count
            loop-label
            pred-label
            iphi)
          (match (opt-unroll-split-phi-inputs inputs loop-label)
            [(OptUnrollPhiSplit.Split init back split-pred)
              (if (= split-pred pred-label)
                (match (opt-unroll-collect-other-phis
                  instrs
                  (+ index 1)
                  phi-count
                  loop-label
                  pred-label
                  iphi)
                  [(OptUnrollMaybePhis.Some rest)
                    (OptUnrollMaybePhis.Some
                      (OptUnrollPhiList.Cons
                        (OptUnrollPhi.Phi dst init back ty)
                        (box rest)))]
                  [(OptUnrollMaybePhis.No) (OptUnrollMaybePhis.No)])
                (OptUnrollMaybePhis.No))]
            [(OptUnrollPhiSplit.No) (OptUnrollMaybePhis.No)]))]
      [_ (OptUnrollMaybePhis.No)])))

(define (opt-unroll-invariant-bound?
  [defs : opt_i64_i64_map.Map]
  [bound : CompilerIrValue]) : bool
  (match bound
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.Var id) (not (opt-used-contains defs id))]
    [_ false]))

;; P's terminator must be a Jump/Branch (or a fallthrough into B, which the
;; guard insertion right before B preserves); retargeting a Switch is not
;; supported.
(define (opt-unroll-pred-retargetable?
  [blocks : CompilerIrBlockList]
  [pred-label : i64]) : bool
  (match (opt-cfg-find-block blocks pred-label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (if (= count 0)
              true
              (match (compiler-ir-instr-seq-ref instrs (- count 1))
                [(CompilerIrInstr.Switch _ _ _ _) false]
                [_ true])))])]))

;; The counter phi's back-edge input must carry the incremented counter,
;; possibly through same-block Mov copies.
(define (opt-unroll-back-resolves-to?
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [back : CompilerIrValue]
  [inext : i64]) : bool
  (match back
    [(CompilerIrValue.Var id)
      (= (opt-unroll-resolve-copy instrs phi-count last id 16) inext)]
    [_ false]))

(define (opt-unroll-shape-finish
  [blocks : CompilerIrBlockList]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [cond-index : i64]
  [cond-var : i64]
  [iphi : i64]
  [iphi-ty : AstType]
  [seed : CompilerIrValue]
  [inext : i64]
  [ity : AstType]
  [bound : CompilerIrValue]
  [pred-label : i64]) : OptUnrollMaybeShape
  (if (or
    (opt-cfg-block-exists?
      blocks
      (compiler-ir-label
        (string.append (compiler-ir-label-text label) "__unroll_guard")))
    (opt-cfg-block-exists?
      blocks
      (compiler-ir-label
        (string.append (compiler-ir-label-text label) "__unroll_body")))
    (not (opt-unroll-pred-retargetable? blocks pred-label)))
    (OptUnrollMaybeShape.No)
    (match (opt-unroll-collect-other-phis
      instrs
      0
      phi-count
      label
      pred-label
      iphi)
      [(OptUnrollMaybePhis.Some others)
        (OptUnrollMaybeShape.Some
          (OptUnrollShape
            label
            pred-label
            phi-count
            cond-index
            cond-var
            iphi
            iphi-ty
            seed
            inext
            ity
            bound
            others))]
      [(OptUnrollMaybePhis.No) (OptUnrollMaybeShape.No)])))

(define (opt-unroll-shape-phi
  [blocks : CompilerIrBlockList]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-index : i64]
  [cond-var : i64]
  [inext : i64]
  [ity : AstType]
  [bound : CompilerIrValue]
  [iphi : i64]) : OptUnrollMaybeShape
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [iphi-index : i64 (opt-unroll-def-index slots 0 phi-count iphi)]
    (if (< iphi-index 0)
      (OptUnrollMaybeShape.No)
      (match (compiler-ir-instr-seq-ref instrs iphi-index)
        [(CompilerIrInstr.Phi _ inputs iphi-ty)
          (match (opt-unroll-split-phi-inputs inputs label)
            [(OptUnrollPhiSplit.Split seed back pred-label)
              (if (and
                (not (= pred-label label))
                (opt-unroll-back-resolves-to? instrs phi-count last back inext))
                (opt-unroll-shape-finish
                  blocks
                  label
                  instrs
                  phi-count
                  cond-index
                  cond-var
                  iphi
                  iphi-ty
                  seed
                  inext
                  ity
                  bound
                  pred-label)
                (OptUnrollMaybeShape.No))]
            [(OptUnrollPhiSplit.No) (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-unroll-shape-step
  [blocks : CompilerIrBlockList]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [cond-index : i64]
  [inext : i64]
  [bound : CompilerIrValue]) : OptUnrollMaybeShape
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [inext-index : i64 (opt-unroll-def-index slots phi-count last inext)]
    (if (< inext-index 0)
      (OptUnrollMaybeShape.No)
      (match (compiler-ir-instr-seq-ref instrs inext-index)
        [(CompilerIrInstr.BinOp _ add-op add-lhs add-rhs ity)
          (match add-op
            [(CompilerIrBinOp.Add)
              (match add-lhs
                [(CompilerIrValue.Var add-src)
                  (match add-rhs
                    [(CompilerIrValue.I64 step)
                      (if (and (= step 1) (opt-integer-type? ity))
                        (opt-unroll-shape-phi
                          blocks
                          label
                          instrs
                          phi-count
                          last
                          cond-index
                          cond-var
                          inext
                          ity
                          bound
                          (opt-unroll-resolve-copy
                            instrs
                            phi-count
                            last
                            add-src
                            16))
                        (OptUnrollMaybeShape.No))]
                    [_ (OptUnrollMaybeShape.No)])]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-unroll-shape-counter
  [blocks : CompilerIrBlockList]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]) : OptUnrollMaybeShape
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [cond-index : i64 (opt-unroll-def-index slots phi-count last cond-var)]
    (if (< cond-index 0)
      (OptUnrollMaybeShape.No)
      (match (compiler-ir-instr-seq-ref instrs cond-index)
        [(CompilerIrInstr.BinOp _ cmp-op cmp-lhs cmp-rhs _)
          (match cmp-op
            [(CompilerIrBinOp.Lt)
              (match cmp-lhs
                [(CompilerIrValue.Var cmp-src)
                  (if (opt-unroll-invariant-bound?
                    (opt-unroll-block-defs
                      slots
                      0
                      (+ last 1)
                      (opt_i64_i64_map.with-capacity 32))
                    cmp-rhs)
                    (opt-unroll-shape-step
                      blocks
                      label
                      instrs
                      phi-count
                      last
                      cond-var
                      cond-index
                      (opt-unroll-resolve-copy instrs phi-count last cmp-src 16)
                      cmp-rhs)
                    (OptUnrollMaybeShape.No))]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

;; Fill-like store loops: StorePtr admitted only when the body has no Load
;; at all, so the x4 clones hold scalar state only (no load->store chains,
;; no container-pointer pressure). Probe/rehash loops have loads and stay
;; excluded by the main whitelist; fills (zeroing, byte stores, recurrence
;; stores) have none.
(define (opt-unroll-body-fill-instr-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Load _ _ _) false]
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [_ (opt-unroll-body-instr-ok? instr)]))

(define (opt-unroll-body-fill-ok?
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-unroll-body-fill-instr-ok? (array-ref slots index))
      (opt-unroll-body-fill-ok? slots (+ index 1) last))))

(define (opt-unroll-shape-scan
  [blocks : CompilerIrBlockList]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [count : i64]
  [cond-var : i64]) : OptUnrollMaybeShape
  (let
    [last : i64 (- count 1)]
    [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
    (if (or
      (< phi-count 1)
      (< (- last phi-count) 2)
      (> (- last phi-count) 16)
      (not (opt-unroll-no-phi-from? instrs phi-count))
      (not
        (or
          (opt-unroll-body-ok? (struct-get instrs slots) phi-count last)
          (opt-unroll-body-fill-ok? (struct-get instrs slots) phi-count last)))
      ;; the c-def is dropped from the clones, so the final branch must be c's
      ;; only use inside B.
      (opt-used-contains
        (opt-unroll-uses-before
          instrs
          0
          last
          (opt_i64_i64_map.with-capacity 64))
        cond-var))
      (OptUnrollMaybeShape.No)
      (opt-unroll-shape-counter blocks label instrs phi-count last cond-var))))

(define (opt-unroll-block-shape
  [blocks : CompilerIrBlockList]
  [entry-label : i64]
  [block : CompilerIrBlock]) : OptUnrollMaybeShape
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (< count 4)
          (OptUnrollMaybeShape.No)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Branch cond then-label else-label)
              (match cond
                [(CompilerIrValue.Var cond-var)
                  (if (and
                    (= then-label label)
                    (not (= else-label label))
                    (not (= label entry-label)))
                    (opt-unroll-shape-scan blocks label instrs count cond-var)
                    (OptUnrollMaybeShape.No))]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])))]))

;; --- rewrite -----------------------------------------------------------------
(define (opt-unroll-alloc-var [cell : (Array i64)]) : i64
  (let
    [next : i64 (array-ref cell 0)]
    (begin
      (array-set! cell 0 (+ next 1))
      next)))

(define (opt-unroll-remap-fill [remap : (Array CompilerIrValue)] [index : i64]) : unit
  (if (>= index (array-length remap))
    unit
    (begin
      (array-set! remap index (CompilerIrValue.Var (- 0 1)))
      (opt-unroll-remap-fill remap (+ index 1)))))

(define (opt-unroll-remap-set
  [remap : (Array CompilerIrValue)]
  [var : i64]
  [value : CompilerIrValue]) : unit
  (if (and (>= var 0) (< var (array-length remap)))
    (array-set! remap var value)
    unit))

(define (opt-unroll-subst-value
  [remap : (Array CompilerIrValue)]
  [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var id)
      (if (and (>= id 0) (< id (array-length remap)))
        (let
          [mapped : CompilerIrValue (array-ref remap id)]
          (match mapped
            [(CompilerIrValue.Var mapped-id)
              (if (< mapped-id 0)
                value
                mapped)]
            [_ mapped]))
        value)]
    [_ value]))

(define (opt-unroll-clone-dst
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]
  [dst : i64]) : i64
  (let
    [fresh : i64 (opt-unroll-alloc-var cell)]
    (begin
      (opt-unroll-remap-set remap dst (CompilerIrValue.Var fresh))
      fresh)))

(define (opt-unroll-copy-suffix [copy : i64]) : String
  (string.append "__u" (string.int->string copy)))

;; Clone one whitelisted body instruction: substitute uses through the remap
;; first, then allocate a fresh dst and record it. Only the kinds accepted by
;; `opt-unroll-body-instr-ok?` reach this.
(define (opt-unroll-clone-instr
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]
  [copy : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (let
        [new-src : CompilerIrValue (opt-unroll-subst-value remap src)]
        (CompilerIrInstr.Mov (opt-unroll-clone-dst remap cell dst) new-src ty))]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (let
        [new-src : CompilerIrValue (opt-unroll-subst-value remap src)]
        (CompilerIrInstr.Cast
          (opt-unroll-clone-dst remap cell dst)
          new-src
          from-ty
          to-ty))]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (let
        [new-src : CompilerIrValue (opt-unroll-subst-value remap src)]
        (CompilerIrInstr.Bitcast
          (opt-unroll-clone-dst remap cell dst)
          new-src
          from-ty
          to-ty))]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (let
        [new-lhs : CompilerIrValue (opt-unroll-subst-value remap lhs)]
        [new-rhs : CompilerIrValue (opt-unroll-subst-value remap rhs)]
        (CompilerIrInstr.BinOp
          (opt-unroll-clone-dst remap cell dst)
          op
          new-lhs
          new-rhs
          ty))]
    [(CompilerIrInstr.UnOp dst op src ty)
      (let
        [new-src : CompilerIrValue (opt-unroll-subst-value remap src)]
        (CompilerIrInstr.UnOp
          (opt-unroll-clone-dst remap cell dst)
          op
          new-src
          ty))]
    [(CompilerIrInstr.Gep dst base offset ty)
      (let
        [new-base : CompilerIrValue (opt-unroll-subst-value remap base)]
        [new-offset : CompilerIrValue (opt-unroll-subst-value remap offset)]
        (CompilerIrInstr.Gep
          (opt-unroll-clone-dst remap cell dst)
          new-base
          new-offset
          ty))]
    [(CompilerIrInstr.Load dst src ty)
      (let
        [new-src : CompilerIrValue (opt-unroll-subst-value remap src)]
        (CompilerIrInstr.Load (opt-unroll-clone-dst remap cell dst) new-src ty))]
    [(CompilerIrInstr.LaneId dst lanes ty)
      (CompilerIrInstr.LaneId (opt-unroll-clone-dst remap cell dst) lanes ty)]
    [(CompilerIrInstr.Splat dst value lanes ty)
      (CompilerIrInstr.Splat
        (opt-unroll-clone-dst remap cell dst)
        (opt-unroll-subst-value remap value)
        lanes
        ty)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst op lhs rhs lanes ty)
          (ir-instr-vector-bin-op
            (opt-unroll-clone-dst remap cell dst)
            op
            (opt-unroll-subst-value remap lhs)
            (opt-unroll-subst-value remap rhs)
            lanes
            ty)])]
    [(CompilerIrInstr.VectorReduce dst op src lanes ty)
      (CompilerIrInstr.VectorReduce
        (opt-unroll-clone-dst remap cell dst)
        op
        (opt-unroll-subst-value remap src)
        lanes
        ty)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst op lhs rhs lanes ty)
          (ir-instr-vector-compare
            (opt-unroll-clone-dst remap cell dst)
            op
            (opt-unroll-subst-value remap lhs)
            (opt-unroll-subst-value remap rhs)
            lanes
            ty)])]
    [(CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (CompilerIrInstr.MaskBinOp
        (opt-unroll-clone-dst remap cell dst)
        op
        (opt-unroll-subst-value remap lhs)
        (opt-unroll-subst-value remap rhs)
        lanes)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload
            dst
            mask
            on-true
            on-false
            lanes
            ty)
          (ir-instr-select
            (opt-unroll-clone-dst remap cell dst)
            (opt-unroll-subst-value remap mask)
            (opt-unroll-subst-value remap on-true)
            (opt-unroll-subst-value remap on-false)
            lanes
            ty)])]
    [(CompilerIrInstr.VectorLoad dst base index lanes ty)
      (CompilerIrInstr.VectorLoad
        (opt-unroll-clone-dst remap cell dst)
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap index)
        lanes
        ty)]
    [(CompilerIrInstr.StorePtr ptr value ty)
      (CompilerIrInstr.StorePtr
        (opt-unroll-subst-value remap ptr)
        (opt-unroll-subst-value remap value)
        ty)]
    [(CompilerIrInstr.BoundsCheck index length ok-label)
      ;; BoundsCheck ok-labels are function-unique local labels; suffix each
      ;; copy so the clones stay unique.
      (CompilerIrInstr.BoundsCheck
        (opt-unroll-subst-value remap index)
        (opt-unroll-subst-value remap length)
        (compiler-ir-label
          (string.append
            (compiler-ir-label-text ok-label)
            (opt-unroll-copy-suffix copy))))]
    [_ instr]))

(define (opt-unroll-phi-list-count [phis : OptUnrollPhiList]) : i64
  (match phis
    [(OptUnrollPhiList.Nil) 0]
    [(OptUnrollPhiList.Cons _ rest)
      (+ 1 (opt-unroll-phi-list-count (box-get rest)))]))

(define (opt-unroll-alloc-ku-ids
  [ku-ids : (Array i64)]
  [index : i64]
  [count : i64]
  [cell : (Array i64)]) : unit
  (if (>= index count)
    unit
    (begin
      (array-set! ku-ids index (opt-unroll-alloc-var cell))
      (opt-unroll-alloc-ku-ids ku-ids (+ index 1) count cell))))

(define (opt-unroll-ku-values
  [ku-ids : (Array i64)]
  [index : i64]
  [count : i64]) : CompilerIrValueList
  (if (>= index count)
    (CompilerIrValueList.Nil)
    (compiler-ir-value-cons
      (CompilerIrValue.Var (array-ref ku-ids index))
      (opt-unroll-ku-values ku-ids (+ index 1) count))))

;; Back-edge values of the loop-carried phis under the current remap state
;; (the values the NEXT copy's phi vars should read). Computed for every phi
;; before any phi var is re-seeded so phi-to-phi back edges (value rotations)
;; read the previous copy's state.
(define (opt-unroll-phi-chain-values
  [remap : (Array CompilerIrValue)]
  [others : OptUnrollPhiList]) : CompilerIrValueList
  (match others
    [(OptUnrollPhiList.Nil) (CompilerIrValueList.Nil)]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi _ _ back _)
          (compiler-ir-value-cons
            (opt-unroll-subst-value remap back)
            (opt-unroll-phi-chain-values remap (box-get rest)))])]))

(define (opt-unroll-write-phi-seeds
  [remap : (Array CompilerIrValue)]
  [others : OptUnrollPhiList]
  [values : CompilerIrValueList]) : unit
  (match others
    [(OptUnrollPhiList.Nil) unit]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi dst _ _ _)
          (match values
            [(CompilerIrValueList.Cons value value-rest)
              (begin
                (opt-unroll-remap-set remap dst value)
                (opt-unroll-write-phi-seeds
                  remap
                  (box-get rest)
                  (box-get value-rest)))]
            [(CompilerIrValueList.Array seq)
              (opt-unroll-write-phi-seeds
                remap
                others
                (compiler-ir-value-seq-to-list seq))]
            [(CompilerIrValueList.Nil) unit])])]))

;; One clone of B's body (the non-phi instructions minus the c-def and the
;; final branch), in original order. The let forces the clone (and its remap
;; side effects) before the recursive tail.
(define (opt-unroll-copy-body
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [skip : i64]
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]
  [copy : i64]) : CompilerIrInstrList
  (if (>= index last)
    (CompilerIrInstrList.Nil)
    (if (= index skip)
      (opt-unroll-copy-body instrs (+ index 1) last skip remap cell copy)
      (let
        [cloned : CompilerIrInstr
          (opt-unroll-clone-instr
            remap
            cell
            copy
            (compiler-ir-instr-seq-ref instrs index))]
        (compiler-ir-instr-cons
          cloned
          (opt-unroll-copy-body instrs (+ index 1) last skip remap cell copy))))))

(define (opt-unroll-copies
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [skip : i64]
  [iphi : i64]
  [inext : i64]
  [others : OptUnrollPhiList]
  [ku-ids : (Array i64)]
  [other-count : i64]
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]
  [iu : i64]
  [copy : i64]) : CompilerIrInstrList
  (if (>= copy 16)
    (CompilerIrInstrList.Nil)
    (let
      ;; Copy 0 reads the fresh U phis; later copies read the previous copy's
      ;; remapped back-edge values. All seeds are computed before any is
      ;; written so phi-to-phi back edges see the pre-copy state.
      [counter-seed : CompilerIrValue
        (if (= copy 0)
          (CompilerIrValue.Var iu)
          (opt-unroll-subst-value remap (CompilerIrValue.Var inext)))]
      [other-seeds : CompilerIrValueList
        (if (= copy 0)
          (opt-unroll-ku-values ku-ids 0 other-count)
          (opt-unroll-phi-chain-values remap others))]
      [_seed-counter : unit (opt-unroll-remap-set remap iphi counter-seed)]
      [_seed-others : unit
        (opt-unroll-write-phi-seeds remap others other-seeds)]
      [body : CompilerIrInstrList
        (opt-unroll-copy-body instrs phi-count last skip remap cell copy)]
      (opt-aggregate-instr-list-append
        body
        (opt-unroll-copies
          instrs
          phi-count
          last
          skip
          iphi
          inext
          others
          ku-ids
          other-count
          remap
          cell
          iu
          (+ copy 1))))))

(define (opt-unroll-unrolled-phis
  [others : OptUnrollPhiList]
  [ku-ids : (Array i64)]
  [index : i64]
  [chains : CompilerIrValueList]
  [guard-label : i64]
  [unrolled-label : i64]
  [tail : CompilerIrInstrList]) : CompilerIrInstrList
  (match others
    [(OptUnrollPhiList.Nil) tail]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi _ init _ ty)
          (match chains
            [(CompilerIrValueList.Cons chain chain-rest)
              (compiler-ir-instr-cons
                (CompilerIrInstr.Phi
                  (array-ref ku-ids index)
                  (compiler-ir-phi-input-cons
                    init
                    guard-label
                    (compiler-ir-phi-input-cons
                      chain
                      unrolled-label
                      (CompilerIrPhiInputList.Nil)))
                  ty)
                (opt-unroll-unrolled-phis
                  (box-get rest)
                  ku-ids
                  (+ index 1)
                  (box-get chain-rest)
                  guard-label
                  unrolled-label
                  tail))]
            [(CompilerIrValueList.Array seq)
              (opt-unroll-unrolled-phis
                others
                ku-ids
                index
                (compiler-ir-value-seq-to-list seq)
                guard-label
                unrolled-label
                tail)]
            [(CompilerIrValueList.Nil) tail])])]))

;; B stays in place as the remainder loop: each phi keeps its back-edge input,
;; its outside input is relabeled from P to the guard, and a third input from
;; the unrolled body is appended. Everything else is unchanged.
(define (opt-unroll-tail-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [loop-label : i64]
  [iphi : i64]
  [seed : CompilerIrValue]
  [inext : i64]
  [inext3 : CompilerIrValue]
  [others : OptUnrollPhiList]
  [chains : CompilerIrValueList]
  [guard-label : i64]
  [unrolled-label : i64]) : CompilerIrInstrList
  (if (>= index count)
    (CompilerIrInstrList.Nil)
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi dst _ ty)
        (if (= dst iphi)
          (compiler-ir-instr-cons
            (CompilerIrInstr.Phi
              dst
              (compiler-ir-phi-input-cons
                seed
                guard-label
                (compiler-ir-phi-input-cons
                  (CompilerIrValue.Var inext)
                  loop-label
                  (compiler-ir-phi-input-cons
                    inext3
                    unrolled-label
                    (CompilerIrPhiInputList.Nil))))
              ty)
            (opt-unroll-tail-instrs
              instrs
              (+ index 1)
              count
              loop-label
              iphi
              seed
              inext
              inext3
              others
              chains
              guard-label
              unrolled-label))
          (match others
            [(OptUnrollPhiList.Cons phi other-rest)
              (match phi
                [(OptUnrollPhi.Phi _ init back _)
                  (match chains
                    [(CompilerIrValueList.Cons chain chain-rest)
                      (compiler-ir-instr-cons
                        (CompilerIrInstr.Phi
                          dst
                          (compiler-ir-phi-input-cons
                            init
                            guard-label
                            (compiler-ir-phi-input-cons
                              back
                              loop-label
                              (compiler-ir-phi-input-cons
                                chain
                                unrolled-label
                                (CompilerIrPhiInputList.Nil))))
                          ty)
                        (opt-unroll-tail-instrs
                          instrs
                          (+ index 1)
                          count
                          loop-label
                          iphi
                          seed
                          inext
                          inext3
                          (box-get other-rest)
                          (box-get chain-rest)
                          guard-label
                          unrolled-label))]
                    [(CompilerIrValueList.Array seq)
                      (opt-unroll-tail-instrs
                        instrs
                        index
                        count
                        loop-label
                        iphi
                        seed
                        inext
                        inext3
                        others
                        (compiler-ir-value-seq-to-list seq)
                        guard-label
                        unrolled-label)]
                    [(CompilerIrValueList.Nil) (CompilerIrInstrList.Nil)])])]
            [(OptUnrollPhiList.Nil) (CompilerIrInstrList.Nil)]))]
      [_
        (compiler-ir-instr-cons
          (compiler-ir-instr-seq-ref instrs index)
          (opt-unroll-tail-instrs
            instrs
            (+ index 1)
            count
            loop-label
            iphi
            seed
            inext
            inext3
            others
            chains
            guard-label
            unrolled-label))])))

(define (opt-unroll-retarget-instr
  [instr : CompilerIrInstr]
  [from-label : i64]
  [to-label : i64]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Jump target)
      (if (= target from-label)
        (CompilerIrInstr.Jump to-label)
        instr)]
    [(CompilerIrInstr.Branch cond then-label else-label)
      (if (or (= then-label from-label) (= else-label from-label))
        (CompilerIrInstr.Branch
          cond
          (if (= then-label from-label)
            to-label
            then-label)
          (if (= else-label from-label)
            to-label
            else-label))
        instr)]
    [_ instr]))

(define (opt-unroll-retarget-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [from-label : i64]
  [to-label : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (compiler-ir-instr-cons
      (opt-unroll-retarget-instr
        (compiler-ir-instr-seq-ref instrs index)
        from-label
        to-label)
      (opt-unroll-retarget-instrs instrs (+ index 1) from-label to-label))))

;; Replace B with guard + unrolled + tail (in place, so a fallthrough pred
;; keeps reaching the loop via the guard) and retarget P's jump/branch edges
;; from B to the guard.
(define (opt-unroll-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [pred-label : i64]
  [loop-label : i64]
  [guard-block : CompilerIrBlock]
  [unrolled-block : CompilerIrBlock]
  [tail-block : CompilerIrBlock]
  [guard-label : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (if (= label loop-label)
            (compiler-ir-block-cons
              guard-block
              (compiler-ir-block-cons
                unrolled-block
                (compiler-ir-block-cons
                  tail-block
                  (opt-unroll-rewrite-blocks
                    (box-get rest)
                    pred-label
                    loop-label
                    guard-block
                    unrolled-block
                    tail-block
                    guard-label))))
            (compiler-ir-block-cons
              (if (= label pred-label)
                (compiler-ir-block
                  label
                  (opt-unroll-retarget-instrs instrs 0 loop-label guard-label))
                block)
              (opt-unroll-rewrite-blocks
                (box-get rest)
                pred-label
                loop-label
                guard-block
                unrolled-block
                tail-block
                guard-label)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        pred-label
        loop-label
        guard-block
        unrolled-block
        tail-block
        guard-label)]))

(define (opt-unroll-apply
  [blocks : CompilerIrBlockList]
  [block : CompilerIrBlock]
  [shape : OptUnrollShape]
  [frame : i64]) : OptUnrollResult
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        [last : i64 (- count 1)]
        [phi-count : i64 (struct-get shape phi-count)]
        [cond-index : i64 (struct-get shape cond-index)]
        [iphi : i64 (struct-get shape iphi)]
        [iphi-ty : AstType (struct-get shape iphi-ty)]
        [seed : CompilerIrValue (struct-get shape seed)]
        [inext : i64 (struct-get shape inext)]
        [ity : AstType (struct-get shape ity)]
        [bound : CompilerIrValue (struct-get shape bound)]
        [others : OptUnrollPhiList (struct-get shape others)]
        [pred-label : i64 (struct-get shape pred-label)]
        [guard-label : i64
          (compiler-ir-label
            (string.append (compiler-ir-label-text label) "__unroll_guard"))]
        [unrolled-label : i64
          (compiler-ir-label
            (string.append (compiler-ir-label-text label) "__unroll_body"))]
        [remap : (Array CompilerIrValue)
          (array.make-array CompilerIrValue frame)]
        [_fill : unit (opt-unroll-remap-fill remap 0)]
        [cell : (Array i64) (array.make-array i64 1)]
        [_cell : unit (array-set! cell 0 frame)]
        [iu : i64 (opt-unroll-alloc-var cell)]
        [other-count : i64 (opt-unroll-phi-list-count others)]
        [ku-ids : (Array i64)
          (array.make-array
            i64
            (if (< other-count 1)
              1
              other-count))]
        [_ku : unit (opt-unroll-alloc-ku-ids ku-ids 0 other-count cell)]
        [copies : CompilerIrInstrList
          (opt-unroll-copies
            instrs
            phi-count
            last
            cond-index
            iphi
            inext
            others
            ku-ids
            other-count
            remap
            cell
            iu
            0)]
        ;; End-of-copy-15 state: the counter and chain values the next group
        ;; iteration (and the remainder loop's phis) receive.
        [inext3 : CompilerIrValue
          (opt-unroll-subst-value remap (CompilerIrValue.Var inext))]
        [chains : CompilerIrValueList
          (opt-unroll-phi-chain-values remap others)]
        [ngroup : i64 (opt-unroll-alloc-var cell)]
        [gwrap : i64 (opt-unroll-alloc-var cell)]
        [gfirst : i64 (opt-unroll-alloc-var cell)]
        [gok : i64 (opt-unroll-alloc-var cell)]
        [gu : i64 (opt-unroll-alloc-var cell)]
        [guard-block : CompilerIrBlock
          (compiler-ir-block
            guard-label
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                ngroup
                (CompilerIrBinOp.Sub)
                bound
                (CompilerIrValue.I64 16)
                ity)
              (compiler-ir-instr-cons
                ;; false iff bound - 4 wrapped past bound.
                (CompilerIrInstr.BinOp
                  gwrap
                  (CompilerIrBinOp.Le)
                  (CompilerIrValue.Var ngroup)
                  bound
                  ity)
                (compiler-ir-instr-cons
                  (CompilerIrInstr.BinOp
                    gfirst
                    (CompilerIrBinOp.Lt)
                    seed
                    (CompilerIrValue.Var ngroup)
                    ity)
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.BinOp
                      gok
                      (CompilerIrBinOp.And)
                      (CompilerIrValue.Var gwrap)
                      (CompilerIrValue.Var gfirst)
                      (AstType.Bool))
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Branch
                        (CompilerIrValue.Var gok)
                        unrolled-label
                        label)
                      (CompilerIrInstrList.Nil)))))))]
        [unrolled-block : CompilerIrBlock
          (compiler-ir-block
            unrolled-label
            (compiler-ir-instr-cons
              (CompilerIrInstr.Phi
                iu
                (compiler-ir-phi-input-cons
                  seed
                  guard-label
                  (compiler-ir-phi-input-cons
                    inext3
                    unrolled-label
                    (CompilerIrPhiInputList.Nil)))
                iphi-ty)
              (opt-unroll-unrolled-phis
                others
                ku-ids
                0
                chains
                guard-label
                unrolled-label
                (opt-aggregate-instr-list-append
                  copies
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.BinOp
                      gu
                      (CompilerIrBinOp.Lt)
                      inext3
                      (CompilerIrValue.Var ngroup)
                      ity)
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Branch
                        (CompilerIrValue.Var gu)
                        unrolled-label
                        label)
                      (CompilerIrInstrList.Nil)))))))]
        [tail-block : CompilerIrBlock
          (compiler-ir-block
            label
            (opt-unroll-tail-instrs
              instrs
              0
              count
              label
              iphi
              seed
              inext
              inext3
              others
              chains
              guard-label
              unrolled-label))]
        (OptUnrollResult.Result
          (opt-unroll-rewrite-blocks
            blocks
            pred-label
            label
            guard-block
            unrolled-block
            tail-block
            guard-label)
          (array-ref cell 0)
          true))]))

;; The mutable SIMD path admits the same pure/load vector forms as the SSA
;; cloner, but not BoundsCheck: repeating one would duplicate its function-
;; unique continuation label. Stores and predicated memory are already absent
;; from `opt-unroll-body-instr-ok?`.
(define (opt-unroll-simd-body-instr-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BoundsCheck _ _ _) false]
    [_ (opt-unroll-body-instr-ok? instr)]))

(define (opt-unroll-simd-vector-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.LaneId _ _ _) true]
    [(CompilerIrInstr.Splat _ _ _ _) true]
    [(CompilerIrInstr.VectorBinOp _) true]
    [(CompilerIrInstr.VectorReduce _ _ _ _ _) true]
    [(CompilerIrInstr.VectorCompare _) true]
    [(CompilerIrInstr.MaskBinOp _ _ _ _ _) true]
    [(CompilerIrInstr.Select _) true]
    [(CompilerIrInstr.VectorLoad _ _ _ _ _) true]
    [_ false]))

(define (opt-unroll-simd-body-ok?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-unroll-simd-body-instr-ok? (compiler-ir-instr-seq-ref instrs index))
      (opt-unroll-simd-body-ok? instrs (+ index 1) last))))

(define (opt-unroll-simd-body-has-vector?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    false
    (or
      (opt-unroll-simd-vector-instr? (compiler-ir-instr-seq-ref instrs index))
      (opt-unroll-simd-body-has-vector? instrs (+ index 1) last))))

;; A self-loop candidate must have exactly one predecessor besides itself.
(define (opt-unroll-simd-outside-pred [preds : OptLabelSet] [loop-label : i64]) : OptLoopPreheader
  (if (= (opt-label-count preds) 2)
    (let
      [first : i64 (opt-label-ref preds 0)]
      [second : i64 (opt-label-ref preds 1)]
      (cond
        [(and (= first loop-label) (!= second loop-label))
          (OptLoopPreheader.Some second)]
        [(and (= second loop-label) (!= first loop-label))
          (OptLoopPreheader.Some first)]
        [else (OptLoopPreheader.No)]))
    (OptLoopPreheader.No)))

;; Direct gang unrolling advances the scalar index once per group. Every
;; VectorLoad must therefore read the canonical counter from the same base and
;; use one vector-width step; no other body instruction may consume that
;; counter. The unrolled group computes one Gep(base, group-index), then uses
;; literal lane-group offsets from it.
(define (opt-unroll-simd-load-shape
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [index-var : i64]
  [step : i64]
  [state : OptUnrollSimdLoadShape]) : OptUnrollSimdLoadShape
  (if (>= index last)
    state
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(CompilerIrInstr.VectorLoad _ base load-index lanes ty)
          (match load-index
            [(CompilerIrValue.Var load-index-var)
              (if (and (= load-index-var index-var) (= lanes step))
                (match state
                  [(OptUnrollSimdLoadShape.Empty)
                    (opt-unroll-simd-load-shape
                      type-segment-bases
                      instrs
                      (+ index 1)
                      last
                      index-var
                      step
                      (OptUnrollSimdLoadShape.Some base ty))]
                  [(OptUnrollSimdLoadShape.Some first-base first-ty)
                    (if (and
                      (opt-value-eq first-base base)
                      (opt-type-eq type-segment-bases first-ty ty))
                      (opt-unroll-simd-load-shape
                        type-segment-bases
                        instrs
                        (+ index 1)
                        last
                        index-var
                        step
                        state)
                      (OptUnrollSimdLoadShape.Fail))]
                  [(OptUnrollSimdLoadShape.Fail) (OptUnrollSimdLoadShape.Fail)])
                (OptUnrollSimdLoadShape.Fail))]
            [_ (OptUnrollSimdLoadShape.Fail)])]
        [_
          (if (opt-used-contains
            (opt-collect-instr-uses (opt_i64_i64_map.with-capacity 8) instr)
            index-var)
            (OptUnrollSimdLoadShape.Fail)
            (opt-unroll-simd-load-shape
              type-segment-bases
              instrs
              (+ index 1)
              last
              index-var
              step
              state))]))))

(define (opt-unroll-simd-shape-finish
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [entry-label : i64]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [cond-index : i64]
  [tail-label : i64]
  [cmp-op : CompilerIrBinOp]
  [cmp-lhs : CompilerIrValue]
  [bound : CompilerIrValue]) : OptUnrollSimdMaybeShape
  (match cmp-lhs
    [(CompilerIrValue.Var next-var)
      (if (< cond-index 2)
        (OptUnrollSimdMaybeShape.No)
        (match (compiler-ir-instr-seq-ref instrs (- cond-index 1))
          [(CompilerIrInstr.BinOp inc-dst inc-op inc-lhs inc-rhs ity)
            (match inc-op
              [(CompilerIrBinOp.Add)
                (match inc-lhs
                  [(CompilerIrValue.Var index-var)
                    (match inc-rhs
                      [(CompilerIrValue.I64 step)
                        (match (compiler-ir-instr-seq-ref
                          instrs
                          (- cond-index 2))
                          [(CompilerIrInstr.Mov move-dst move-src move-ty)
                            (match move-src
                              [(CompilerIrValue.Var move-next)
                                (let
                                  [defs : opt_i64_i64_map.Map
                                    (opt-unroll-block-defs
                                      (struct-get instrs slots)
                                      0
                                      (compiler-ir-instr-seq-count instrs)
                                      (opt_i64_i64_map.with-capacity 32))]
                                  (if (and
                                    (= inc-dst next-var)
                                    (= move-dst index-var)
                                    (= move-next next-var)
                                    (> step 0)
                                    (<= step 1024)
                                    (match ity
                                      [(AstType.I64) true]
                                      [_ false])
                                    (match move-ty
                                      [(AstType.I64) true]
                                      [_ false])
                                    (!= label entry-label)
                                    (opt-unroll-invariant-bound? defs bound)
                                    (opt-unroll-simd-body-ok?
                                      instrs
                                      0
                                      cond-index)
                                    (opt-unroll-simd-body-has-vector?
                                      instrs
                                      0
                                      cond-index)
                                    (not
                                      (opt-cfg-block-exists?
                                        blocks
                                        (compiler-ir-label
                                          (string.append
                                            (compiler-ir-label-text label)
                                            "__unroll_guard"))))
                                    (not
                                      (opt-cfg-block-exists?
                                        blocks
                                        (compiler-ir-label
                                          (string.append
                                            (compiler-ir-label-text label)
                                            "__unroll_body"))))
                                    (not
                                      (opt-cfg-block-exists?
                                        blocks
                                        (compiler-ir-label
                                          (string.append
                                            (compiler-ir-label-text label)
                                            "__unroll_exit")))))
                                    (match (opt-unroll-simd-outside-pred
                                      (opt-cfg-predecessors blocks label)
                                      label)
                                      [(OptLoopPreheader.Some pred-label)
                                        (if (opt-unroll-pred-retargetable?
                                          blocks
                                          pred-label)
                                          (match (opt-unroll-simd-load-shape
                                            type-segment-bases
                                            instrs
                                            0
                                            (- cond-index 2)
                                            index-var
                                            step
                                            (OptUnrollSimdLoadShape.Empty))
                                            [(OptUnrollSimdLoadShape.Some
                                                vector-base
                                                vector-ty)
                                              ;; The shared Gep is emitted
                                              ;; before the cloned body, so its
                                              ;; source base must be available
                                              ;; outside the loop.
                                              (if (opt-unroll-invariant-bound?
                                                defs
                                                vector-base)
                                                (OptUnrollSimdMaybeShape.Some
                                                  (OptUnrollSimdShape
                                                    pred-label
                                                    tail-label
                                                    cond-index
                                                    index-var
                                                    next-var
                                                    step
                                                    ity
                                                    bound
                                                    cmp-op
                                                    vector-base
                                                    vector-ty))
                                                (OptUnrollSimdMaybeShape.No))]
                                            [_ (OptUnrollSimdMaybeShape.No)])
                                          (OptUnrollSimdMaybeShape.No))]
                                      [(OptLoopPreheader.No)
                                        (OptUnrollSimdMaybeShape.No)])
                                    (OptUnrollSimdMaybeShape.No)))]
                              [_ (OptUnrollSimdMaybeShape.No)])]
                          [_ (OptUnrollSimdMaybeShape.No)])]
                      [_ (OptUnrollSimdMaybeShape.No)])]
                  [_ (OptUnrollSimdMaybeShape.No)])]
              [_ (OptUnrollSimdMaybeShape.No)])]
          [_ (OptUnrollSimdMaybeShape.No)]))]
    [_ (OptUnrollSimdMaybeShape.No)]))

(define (opt-unroll-simd-block-shape
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [entry-label : i64]
  [block : CompilerIrBlock]) : OptUnrollSimdMaybeShape
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (< count 7)
          (OptUnrollSimdMaybeShape.No)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Branch cond true-label false-label)
              (match cond
                [(CompilerIrValue.Var cond-var)
                  (if (and (= true-label label) (!= false-label label))
                    (let
                      [cond-index : i64 (- count 2)]
                      (match (compiler-ir-instr-seq-ref instrs cond-index)
                        [(CompilerIrInstr.BinOp cond-dst cmp-op cmp-lhs bound _)
                          (if (and
                            (= cond-dst cond-var)
                            (match cmp-op
                              [(CompilerIrBinOp.Lt) true]
                              [(CompilerIrBinOp.Le) true]
                              [_ false]))
                            (opt-unroll-simd-shape-finish
                              type-segment-bases
                              blocks
                              entry-label
                              label
                              instrs
                              cond-index
                              false-label
                              cmp-op
                              cmp-lhs
                              bound)
                            (OptUnrollSimdMaybeShape.No))]
                        [_ (OptUnrollSimdMaybeShape.No)]))
                    (OptUnrollSimdMaybeShape.No))]
                [_ (OptUnrollSimdMaybeShape.No)])]
            [_ (OptUnrollSimdMaybeShape.No)])))]))

;; A loop-carried vector recurrence cannot become an ordinary scalar Phi (the
;; Phi IR has no lane count), so keep only a vector destination that reads
;; itself mutable. Every transient vector/scalar destination is freshened: this
;; restores single-use VectorLoad facts for backend memory-operand folding and
;; gives register allocation non-overlapping scalar counter intervals.
(define (opt-unroll-simd-recurrent-vector-dst [instr : CompilerIrInstr]) : option_i64.Option
  (if (opt-unroll-simd-vector-instr? instr)
    (match (opt-instr-def-var instr)
      [(option_i64.Some dst)
        (if (opt-used-contains
          (opt-collect-instr-uses (opt_i64_i64_map.with-capacity 8) instr)
          dst)
          (option_i64.Some dst)
          (option_i64.None))]
      [(option_i64.None) (option_i64.None)])
    (option_i64.None)))

(define (opt-unroll-simd-clone-recurrence
  [remap : (Array CompilerIrValue)]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.LaneId dst lanes ty)
      (CompilerIrInstr.LaneId dst lanes ty)]
    [(CompilerIrInstr.Splat dst value lanes ty)
      (CompilerIrInstr.Splat dst (opt-unroll-subst-value remap value) lanes ty)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst op lhs rhs lanes ty)
          (ir-instr-vector-bin-op
            dst
            op
            (opt-unroll-subst-value remap lhs)
            (opt-unroll-subst-value remap rhs)
            lanes
            ty)])]
    [(CompilerIrInstr.VectorReduce dst op src lanes ty)
      (CompilerIrInstr.VectorReduce
        dst
        op
        (opt-unroll-subst-value remap src)
        lanes
        ty)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst op lhs rhs lanes ty)
          (ir-instr-vector-compare
            dst
            op
            (opt-unroll-subst-value remap lhs)
            (opt-unroll-subst-value remap rhs)
            lanes
            ty)])]
    [(CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-unroll-subst-value remap lhs)
        (opt-unroll-subst-value remap rhs)
        lanes)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload
            dst
            mask
            on-true
            on-false
            lanes
            ty)
          (ir-instr-select
            dst
            (opt-unroll-subst-value remap mask)
            (opt-unroll-subst-value remap on-true)
            (opt-unroll-subst-value remap on-false)
            lanes
            ty)])]
    [(CompilerIrInstr.VectorLoad dst base index lanes ty)
      (CompilerIrInstr.VectorLoad
        dst
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap index)
        lanes
        ty)]
    [_ instr]))

(define (opt-unroll-simd-clone-instr
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]
  [group-base : i64]
  [step : i64]
  [copy : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match (opt-unroll-simd-recurrent-vector-dst instr)
    [(option_i64.Some dst)
      (begin
        ;; The source occurrence denotes the mutable value written by the
        ;; preceding gang, not a transient clone from an earlier instruction.
        (opt-unroll-remap-set remap dst (CompilerIrValue.Var dst))
        (opt-unroll-simd-clone-recurrence remap instr))]
    [(option_i64.None)
      (match instr
        [(CompilerIrInstr.VectorLoad dst _ _ lanes ty)
          (CompilerIrInstr.VectorLoad
            (opt-unroll-clone-dst remap cell dst)
            (CompilerIrValue.Var group-base)
            (CompilerIrValue.I64 (* copy step))
            lanes
            ty)]
        [_ (opt-unroll-clone-instr remap cell copy instr)])]))

;; Emit sixteen sequential remapped copies.
(define (opt-unroll-simd-copies
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]
  [group-base : i64]
  [step : i64]
  [copy : i64]) : CompilerIrInstrList
  (if (>= copy 16)
    (CompilerIrInstrList.Nil)
    (if (>= index last)
      (opt-unroll-simd-copies
        instrs
        0
        last
        remap
        cell
        group-base
        step
        (+ copy 1))
      (let
        [cloned : CompilerIrInstr
          (opt-unroll-simd-clone-instr
            remap
            cell
            group-base
            step
            copy
            (compiler-ir-instr-seq-ref instrs index))]
        (compiler-ir-instr-cons
          cloned
          (opt-unroll-simd-copies
            instrs
            (+ index 1)
            last
            remap
            cell
            group-base
            step
            copy))))))

(define (opt-unroll-simd-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [pred-label : i64]
  [loop-label : i64]
  [guard-block : CompilerIrBlock]
  [unrolled-block : CompilerIrBlock]
  [exit-block : CompilerIrBlock]
  [original-block : CompilerIrBlock]
  [guard-label : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (if (= label loop-label)
            (compiler-ir-block-cons
              guard-block
              (compiler-ir-block-cons
                unrolled-block
                (compiler-ir-block-cons
                  exit-block
                  (compiler-ir-block-cons
                    original-block
                    (opt-unroll-simd-rewrite-blocks
                      (box-get rest)
                      pred-label
                      loop-label
                      guard-block
                      unrolled-block
                      exit-block
                      original-block
                      guard-label)))))
            (compiler-ir-block-cons
              (if (= label pred-label)
                (compiler-ir-block
                  label
                  (opt-unroll-retarget-instrs instrs 0 loop-label guard-label))
                block)
              (opt-unroll-simd-rewrite-blocks
                (box-get rest)
                pred-label
                loop-label
                guard-block
                unrolled-block
                exit-block
                original-block
                guard-label)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-simd-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        pred-label
        loop-label
        guard-block
        unrolled-block
        exit-block
        original-block
        guard-label)]))

(define (opt-unroll-simd-apply
  [blocks : CompilerIrBlockList]
  [block : CompilerIrBlock]
  [shape : OptUnrollSimdShape]
  [frame : i64]) : OptUnrollResult
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [cond-index : i64 (struct-get shape cond-index)]
        [index-var : i64 (struct-get shape index-var)]
        [step : i64 (struct-get shape step)]
        [ity : AstType (struct-get shape ity)]
        [bound : CompilerIrValue (struct-get shape bound)]
        [cmp-op : CompilerIrBinOp (struct-get shape cmp-op)]
        [pred-label : i64 (struct-get shape pred-label)]
        [tail-label : i64 (struct-get shape tail-label)]
        [guard-label : i64
          (compiler-ir-label
            (string.append (compiler-ir-label-text label) "__unroll_guard"))]
        [unrolled-label : i64
          (compiler-ir-label
            (string.append (compiler-ir-label-text label) "__unroll_body"))]
        [exit-label : i64
          (compiler-ir-label
            (string.append (compiler-ir-label-text label) "__unroll_exit"))]
        [vector-base : CompilerIrValue (struct-get shape vector-base)]
        [vector-ty : AstType (struct-get shape vector-ty)]
        [remap : (Array CompilerIrValue)
          (array.make-array CompilerIrValue frame)]
        [_fill : unit (opt-unroll-remap-fill remap 0)]
        [cell : (Array i64) (array.make-array i64 1)]
        [_cell : unit (array-set! cell 0 frame)]
        [iu : i64 (opt-unroll-alloc-var cell)]
        [group-base : i64 (opt-unroll-alloc-var cell)]
        [copies : CompilerIrInstrList
          (opt-unroll-simd-copies
            instrs
            0
            (- cond-index 2)
            remap
            cell
            group-base
            step
            0)]
        [end-index : i64 (opt-unroll-alloc-var cell)]
        [end-next : i64 (opt-unroll-alloc-var cell)]
        [remainder-ok : i64 (opt-unroll-alloc-var cell)]
        [ngroup : i64 (opt-unroll-alloc-var cell)]
        [gwrap : i64 (opt-unroll-alloc-var cell)]
        [gfirst : i64 (opt-unroll-alloc-var cell)]
        [gok : i64 (opt-unroll-alloc-var cell)]
        [gu : i64 (opt-unroll-alloc-var cell)]
        [guard-block : CompilerIrBlock
          (compiler-ir-block
            guard-label
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                ngroup
                (CompilerIrBinOp.Sub)
                bound
                (CompilerIrValue.I64 (* step 16))
                ity)
              (compiler-ir-instr-cons
                ;; Reject a wrapped bound - 16*step.
                (CompilerIrInstr.BinOp
                  gwrap
                  (CompilerIrBinOp.Le)
                  (CompilerIrValue.Var ngroup)
                  bound
                  ity)
                (compiler-ir-instr-cons
                  (CompilerIrInstr.BinOp
                    gfirst
                    cmp-op
                    (CompilerIrValue.Var index-var)
                    (CompilerIrValue.Var ngroup)
                    ity)
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.BinOp
                      gok
                      (CompilerIrBinOp.And)
                      (CompilerIrValue.Var gwrap)
                      (CompilerIrValue.Var gfirst)
                      (AstType.Bool))
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Branch
                        (CompilerIrValue.Var gok)
                        unrolled-label
                        label)
                      (CompilerIrInstrList.Nil)))))))]
        [unrolled-block : CompilerIrBlock
          (compiler-ir-block
            unrolled-label
            (compiler-ir-instr-cons
              (CompilerIrInstr.Phi
                iu
                (compiler-ir-phi-input-cons
                  (CompilerIrValue.Var index-var)
                  guard-label
                  (compiler-ir-phi-input-cons
                    (CompilerIrValue.Var end-index)
                    unrolled-label
                    (CompilerIrPhiInputList.Nil)))
                ity)
              (compiler-ir-instr-cons
                (CompilerIrInstr.Gep
                  group-base
                  vector-base
                  (CompilerIrValue.Var iu)
                  vector-ty)
                (opt-aggregate-instr-list-append
                  copies
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.BinOp
                      end-index
                      (CompilerIrBinOp.Add)
                      (CompilerIrValue.Var iu)
                      (CompilerIrValue.I64 (* step 16))
                      ity)
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.BinOp
                        end-next
                        (CompilerIrBinOp.Add)
                        (CompilerIrValue.Var end-index)
                        (CompilerIrValue.I64 step)
                        ity)
                      (compiler-ir-instr-cons
                        (CompilerIrInstr.BinOp
                          gu
                          cmp-op
                          (CompilerIrValue.Var end-index)
                          (CompilerIrValue.Var ngroup)
                          ity)
                        (compiler-ir-instr-cons
                          (CompilerIrInstr.Branch
                            (CompilerIrValue.Var gu)
                            unrolled-label
                            exit-label)
                          (CompilerIrInstrList.Nil)))))))))]
        [exit-block : CompilerIrBlock
          (compiler-ir-block
            exit-label
            (compiler-ir-instr-cons
              (CompilerIrInstr.Mov
                index-var
                (CompilerIrValue.Var end-index)
                ity)
              (compiler-ir-instr-cons
                (CompilerIrInstr.Mov
                  (struct-get shape next-var)
                  (CompilerIrValue.Var end-next)
                  ity)
                (compiler-ir-instr-cons
                  (CompilerIrInstr.BinOp
                    remainder-ok
                    cmp-op
                    (CompilerIrValue.Var end-next)
                    bound
                    ity)
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Branch
                      (CompilerIrValue.Var remainder-ok)
                      label
                      tail-label)
                    (CompilerIrInstrList.Nil))))))]
        (OptUnrollResult.Result
          (opt-unroll-simd-rewrite-blocks
            blocks
            pred-label
            label
            guard-block
            unrolled-block
            exit-block
            block
            guard-label)
          (array-ref cell 0)
          true))]))

;; Apply at most one unroll per invocation (the pipeline fixpoint picks up
;; further loops on later iterations), bounding growth.
(define (opt-unroll-blocks-scan
  [blocks : CompilerIrBlockList]
  [remaining : CompilerIrBlockList]
  [entry-label : i64]
  [frame : i64]) : OptUnrollResult
  (match remaining
    [(CompilerIrBlockList.Nil) (OptUnrollResult.Result blocks frame false)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-unroll-block-shape blocks entry-label block)
        [(OptUnrollMaybeShape.Some shape)
          (opt-unroll-apply blocks block shape frame)]
        [(OptUnrollMaybeShape.No)
          (opt-unroll-blocks-scan blocks (box-get rest) entry-label frame)])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-blocks-scan
        blocks
        (compiler-ir-block-seq-to-list seq)
        entry-label
        frame)]))

(define (opt-unroll-simd-blocks-scan
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [remaining : CompilerIrBlockList]
  [entry-label : i64]
  [frame : i64]) : OptUnrollResult
  (match remaining
    [(CompilerIrBlockList.Nil) (OptUnrollResult.Result blocks frame false)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-unroll-simd-block-shape
        type-segment-bases
        blocks
        entry-label
        block)
        [(OptUnrollSimdMaybeShape.Some shape)
          (opt-unroll-simd-apply blocks block shape frame)]
        [(OptUnrollSimdMaybeShape.No)
          (opt-unroll-simd-blocks-scan
            type-segment-bases
            blocks
            (box-get rest)
            entry-label
            frame)])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-simd-blocks-scan
        type-segment-bases
        blocks
        (compiler-ir-block-seq-to-list seq)
        entry-label
        frame)]))

;; Cheap shape prescan: a candidate self-loop either starts with a Phi (the
;; canonical SSA form) or contains a mutable SIMD instruction (the SPMD gang
;; form), and ends with a conditional Branch whose true arm targets the block
;; itself. Most functions have neither, so skip the entry verify when no block
;; can possibly match.
(define (opt-unroll-block-candidate? [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (< count 4)
          false
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Branch _ true-label _)
              (and
                (= true-label label)
                (or
                  (compiler-ir-instr-seq-phi? instrs 0)
                  (opt-unroll-simd-body-has-vector? instrs 0 (- count 1))))]
            [_ false])))]))

(define (opt-unroll-blocks-have-candidate? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-unroll-block-candidate? block)
        true
        (opt-unroll-blocks-have-candidate? (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-blocks-have-candidate? (compiler-ir-block-seq-to-list seq))]))

(define (opt-unroll-simd-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (match (opt-unroll-simd-blocks-scan
        type-segment-bases
        blocks
        blocks
        (opt-cfg-entry-label blocks)
        frame)
        [(OptUnrollResult.Result next-blocks next-frame changed)
          (if changed
            (let
              [next : CompilerIrFunction
                (CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  next-frame
                  next-blocks)]
              [next-context : OptCfgContext (opt-cfg-context-build next-blocks)]
              ;; Mutable SIMD IR is intentionally outside scalar SSA. Its
              ;; verifier contract is therefore the final/backend structural
              ;; contract; the exact local shape checks above establish the
              ;; dataflow used by the rewrite.
              (match (opt-verify-final-function next)
                [(ResultCompilerOptimizeVerify.Ok)
                  (OptFunctionCtxResult.Result next next-context)]
                [(ResultCompilerOptimizeVerify.Err _)
                  (OptFunctionCtxResult.Result func context)]))
            (OptFunctionCtxResult.Result func context))])]))

(define (opt-unroll-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match func
    [(CompilerIrFunction.Function _ params _ frame prescan-blocks)
      (if (or
        (opt-unroll-blocks-have-candidate? prescan-blocks)
        (opt-unroll-mb-blocks-have-candidate? prescan-blocks))
        (if verified?
          (opt-unroll-function-verified-with-context-result context true func)
          (match (opt-verify-function-with-context func context)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-unroll-function-verified-with-context-result
                context
                true
                func)]
            [(ResultCompilerOptimizeVerify.Err _)
              ;; SPMD vector state is deliberately mutable, so these functions
              ;; fail only the scalar single-definition contract. Admit just
              ;; the exact SIMD shape through the backend IR contract.
              (if (and
                (not (opt-verify-single-defs? params frame prescan-blocks))
                (opt-verify-ok? (opt-verify-final-function func)))
                (opt-unroll-simd-function-with-context-result
                  type-segment-bases
                  context
                  func)
                (OptFunctionCtxResult.Result func context))]))
        (OptFunctionCtxResult.Result func context))]))

(define (opt-unroll-function-verified-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-unroll-blocks-scan
            blocks
            blocks
            (opt-cfg-entry-label blocks)
            frame)
            [(OptUnrollResult.Result next-blocks next-frame changed)
              (if changed
                (let
                  [next : CompilerIrFunction
                    (CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      next-frame
                      next-blocks)]
                  ;; Unrolling rewrites the CFG, so build one fresh context
                  ;; for the new blocks, reuse it for the post-pass verify,
                  ;; and hand it back for the next pass.
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)]))
                ;; The original unroller's prescan and shape scanner only
                ;; admit a self-loop whose header is also its latch. A
                ;; versioned conditional body instead has a separate merge
                ;; latch, so try the conservative x2 diamond path over the
                ;; natural-loop records when the straight-line scan misses.
                (let
                  [loops : OptNaturalLoopList
                    (opt-cfg-natural-loops-with-context blocks context)]
                  (match (opt-unroll-mb-loops-scan
                    blocks
                    loops
                    loops
                    (opt-cfg-entry-label blocks)
                    frame)
                    [(OptUnrollResult.Result mb-blocks mb-frame mb-changed)
                      (if mb-changed
                        (let
                          [mb-next : CompilerIrFunction
                            (CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              mb-frame
                              mb-blocks)]
                          [mb-context : OptCfgContext
                            (opt-cfg-context-build mb-blocks)]
                          (match (opt-verify-function-with-context
                            mb-next
                            mb-context)
                            [(ResultCompilerOptimizeVerify.Ok)
                              (OptFunctionCtxResult.Result mb-next mb-context)]
                            [(ResultCompilerOptimizeVerify.Err _)
                              (OptFunctionCtxResult.Result func context)]))
                        (OptFunctionCtxResult.Result func context))])))])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-unroll-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-unroll-function-with-context-result
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; --- bounds-check loop versioning (codegen phase 7) ---------------------------
;;
;; A canonical counted self-loop pays cmp+jb per BoundsCheck per iteration even
;; though the whole trip range is decidable up front: for a check
;; `BoundsCheck(idx, len)` with loop-invariant `len`,
;;   * idx == the counter phi      -> every trip index lies in [seed, bound),
;;     so `seed >= 0 && bound <= len` (signed) proves every check passes;
;;   * idx == BitAnd(_, M), M >= 0 -> the index lies in [0, M], so `M < len`;
;;   * idx loop-invariant          -> `idx >= 0 && idx < len`.
;; The loop is VERSIONED on the conjunction: a fresh guard block on the entry
;; edge branches to a check-free fast clone when every condition holds and to
;; the original checked loop otherwise. Semantics are exact: the fast clone
;; runs only when no check could abort, the slow path is the unmodified
;; original, and a conservatively-false guard (e.g. a negative length's signed
;; compare) merely keeps the slow path, so nothing relies on lengths being
;; non-negative. Store-bearing bodies are ADMITTED (unlike the unroller):
;; under a true guard the clone is instruction-for-instruction the original.
;;
;; Exit wiring exploits the post-rotation invariant: the loop block does not
;; dominate its exit when the exit has another predecessor, so loop defs reach
;; outside code only as exit-phi inputs on the loop edge -- each such input
;; gains a parallel input from the fast clone. Any remaining direct outside
;; use of a loop def (the never-rotated single-pred-exit case) rejects.
;;
;; The pass runs between induction and unroll so the fast clone -- now a pure
;; whitelisted body -- unrolls in the SAME pipeline iteration. Rejections:
;; non-canonical counters, multi-block loops, a check whose condition cannot
;; be derived, and pre-existing version labels (idempotence). Verifier-gated
;; with fallback like unroll.
(defenum OptBceVersionGuardAcc
  (No)
  (Some CompilerIrInstrList CompilerIrValueList bool))

(defenum OptBceVersionGuardResult
  (No)
  (Some CompilerIrInstrList CompilerIrValue))

(define (opt-bce-version-body-max) : i64
  48)

;; Clonable body kinds: everything the unroll cloner can remap, INCLUDING
;; StorePtr (fills and container writes version fine) and BoundsCheck (the
;; checks being removed from the clone).
(define (opt-bce-version-body-instr-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ _ _) true]
    [(CompilerIrInstr.Cast _ _ _ _) true]
    [(CompilerIrInstr.Bitcast _ _ _ _) true]
    [(CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(CompilerIrInstr.UnOp _ _ _ _) true]
    [(CompilerIrInstr.Gep _ _ _ _) true]
    [(CompilerIrInstr.Load _ _ _) true]
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [(CompilerIrInstr.BoundsCheck _ _ _) true]
    [_ false]))

(define (opt-bce-version-body-instr-seq-ok?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (opt-bce-version-body-instr-ok? (compiler-ir-instr-seq-ref instrs index)))

(define (opt-bce-version-body-ok?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-bce-version-body-instr-seq-ok? instrs index)
      (opt-bce-version-body-ok? instrs (+ index 1) last))))

(define (opt-bce-version-check-count
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [acc : i64]) : i64
  (if (>= index last)
    acc
    (opt-bce-version-check-count
      instrs
      (+ index 1)
      last
      (if (compiler-ir-instr-seq-bounds-check? instrs index)
        (+ acc 1)
        acc))))

(define (opt-bce-version-alloc-var [cell : (Array i64)]) : i64
  (let
    [next : i64 (array-ref cell 0)]
    (begin
      (array-set! cell 0 (+ next 1))
      next)))

;; One derived guard condition instruction; conds accumulate as (instr, value)
;; so the And chain can be assembled afterwards.
(define (opt-bce-version-cond
  [cell : (Array i64)]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
    [(OptBceVersionGuardAcc.Some instrs values counter-seen)
      (let
        [dst : i64 (opt-bce-version-alloc-var cell)]
        (OptBceVersionGuardAcc.Some
          (compiler-ir-instr-cons
            (CompilerIrInstr.BinOp dst op lhs rhs (AstType.I64))
            instrs)
          (compiler-ir-value-cons (CompilerIrValue.Var dst) values)
          counter-seen))]))

(define (opt-bce-version-cond-counter-seen [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
    [(OptBceVersionGuardAcc.Some instrs values _)
      (OptBceVersionGuardAcc.Some instrs values true)]))

;; Resolve through same-block Mov copies AND 64-bit int reinterpret casts:
;; lowered index/length operands routinely arrive as `(cast x : u64)`-shaped
;; bit-preserving reinterprets (the #930 argument bounds-dom also relies on).
(define (opt-bce-version-resolve
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [var : i64]
  [fuel : i64]) : i64
  (if (<= fuel 0)
    var
    (let
      [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
      [def-index : i64 (opt-unroll-def-index slots phi-count last var)]
      (if (< def-index 0)
        var
        (match (array-ref slots def-index)
          [(CompilerIrInstr.Mov _ src _)
            (match src
              [(CompilerIrValue.Var src-id)
                (opt-bce-version-resolve
                  instrs
                  phi-count
                  last
                  src-id
                  (- fuel 1))]
              [_ var])]
          [(CompilerIrInstr.Cast _ src from-ty to-ty)
            (if (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
              (match src
                [(CompilerIrValue.Var src-id)
                  (opt-bce-version-resolve
                    instrs
                    phi-count
                    last
                    src-id
                    (- fuel 1))]
                [_ var])
              var)]
          [_ var])))))

;; The invariant value an operand resolves to (a literal, or a var defined
;; outside the loop -- possibly behind in-loop copies/reinterprets), if any.
;; The guard must reference the RESOLVED value: it is the one whose definition
;; dominates the loop entry edge.
(define (opt-bce-version-invariant-operand
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : CompilerIrMaybeValue
  (match value
    [(CompilerIrValue.I64 k)
      (CompilerIrMaybeValue.Some (CompilerIrValue.I64 k))]
    [(CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-version-resolve instrs phi-count last raw 16)]
        (if (opt-used-contains defs id)
          (CompilerIrMaybeValue.No)
          (CompilerIrMaybeValue.Some (CompilerIrValue.Var id))))]
    [_ (CompilerIrMaybeValue.No)]))

;; Derive the sufficient invariant condition for one check's index operand.
(define (opt-bce-version-derive-index
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [iphi : i64]
  [bound : CompilerIrValue]
  [cell : (Array i64)]
  [index-value : CompilerIrValue]
  [length-value : CompilerIrValue]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match index-value
    [(CompilerIrValue.I64 k)
      (if (>= k 0)
        (opt-bce-version-cond
          cell
          (CompilerIrBinOp.Lt)
          (CompilerIrValue.I64 k)
          length-value
          acc)
        (OptBceVersionGuardAcc.No))]
    [(CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-version-resolve instrs phi-count last raw 16)]
        (if (= id iphi)
          ;; counter: [seed, bound) subset of [0, len) iff seed >= 0 (emitted
          ;; once, below) and bound <= len.
          (opt-bce-version-cond-counter-seen
            (opt-bce-version-cond
              cell
              (CompilerIrBinOp.Le)
              bound
              length-value
              acc))
          (if (not (opt-used-contains defs id))
            ;; loop-invariant index: exactly its own range check, hoisted.
            (opt-bce-version-cond
              cell
              (CompilerIrBinOp.Lt)
              (CompilerIrValue.Var id)
              length-value
              (opt-bce-version-cond
                cell
                (CompilerIrBinOp.Ge)
                (CompilerIrValue.Var id)
                (CompilerIrValue.I64 0)
                acc))
            (let
              [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
              [def-index : i64 (opt-unroll-def-index slots phi-count last id)]
              (if (< def-index 0)
                (OptBceVersionGuardAcc.No)
                (match (array-ref slots def-index)
                  [(CompilerIrInstr.BinOp _ op lhs rhs _)
                    (match op
                      [(CompilerIrBinOp.BitAnd)
                        (match (opt-affine-var-const lhs rhs)
                          [(OptAffineOperands.Some _ m)
                            (if (>= m 0)
                              ;; masked index: in [0, m] whatever the source.
                              (opt-bce-version-cond
                                cell
                                (CompilerIrBinOp.Lt)
                                (CompilerIrValue.I64 m)
                                length-value
                                acc)
                              (OptBceVersionGuardAcc.No))]
                          [(OptAffineOperands.No) (OptBceVersionGuardAcc.No)])]
                      [_ (OptBceVersionGuardAcc.No)])]
                  [_ (OptBceVersionGuardAcc.No)]))))))]
    [_ (OptBceVersionGuardAcc.No)]))

(define (opt-bce-version-derive-checks
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [iphi : i64]
  [bound : CompilerIrValue]
  [cell : (Array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (if (>= index last)
    acc
    (opt-bce-version-derive-checks
      instrs
      (+ index 1)
      phi-count
      last
      defs
      iphi
      bound
      cell
      (match (compiler-ir-instr-seq-ref instrs index)
        [(CompilerIrInstr.BoundsCheck index-value length-value _)
          (match (opt-bce-version-invariant-operand
            instrs
            phi-count
            last
            defs
            length-value)
            [(CompilerIrMaybeValue.Some length-invariant)
              (opt-bce-version-derive-index
                instrs
                phi-count
                last
                defs
                iphi
                bound
                cell
                index-value
                length-invariant
                acc)]
            [(CompilerIrMaybeValue.No) (OptBceVersionGuardAcc.No)])]
        [_ acc]))))

(define (opt-bce-version-and-chain
  [cell : (Array i64)]
  [first : CompilerIrValue]
  [rest : CompilerIrValueList]
  [instrs : CompilerIrInstrList]) : OptBceVersionGuardResult
  (match rest
    [(CompilerIrValueList.Nil) (OptBceVersionGuardResult.Some instrs first)]
    [(CompilerIrValueList.Array seq)
      (opt-bce-version-and-chain
        cell
        first
        (compiler-ir-value-seq-to-list seq)
        instrs)]
    [(CompilerIrValueList.Cons value tail)
      (let
        [dst : i64 (opt-bce-version-alloc-var cell)]
        (opt-bce-version-and-chain
          cell
          (CompilerIrValue.Var dst)
          (box-get tail)
          (opt-aggregate-instr-list-append
            instrs
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                dst
                (CompilerIrBinOp.And)
                first
                value
                (AstType.Bool))
              (CompilerIrInstrList.Nil)))))]))

;; Assemble the guard from the derived per-check conditions: the once-only
;; `seed < bound` and `seed >= 0` when any counter-cased check needs them (a
;; literal non-negative seed skips the latter; a literal negative seed
;; rejects -- the guard could never pass), then the And chain over every
;; condition value.
(define (opt-bce-version-guard-finish
  [seed : CompilerIrValue]
  [bound : CompilerIrValue]
  [cell : (Array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardResult
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceVersionGuardResult.No)]
    [(OptBceVersionGuardAcc.Some cond-instrs cond-values counter-seen)
      (let
        ;; The canonical self-loop is do-while shaped: the FIRST body
        ;; iteration (index = seed) runs before any compare, so the counter
        ;; range argument also needs `seed < bound` in the guard -- without
        ;; it a loop entered with seed >= bound would run one unchecked fast
        ;; iteration at an index the slow path would have aborted on.
        ;; Rotated loops satisfy it dynamically (their preheader guard
        ;; proved a first iteration), so the compare never deselects the
        ;; fast path there.
        [entered : OptBceVersionGuardAcc
          (if counter-seen
            (match seed
              [(CompilerIrValue.I64 sk)
                (match bound
                  [(CompilerIrValue.I64 bk)
                    (if (< sk bk)
                      (OptBceVersionGuardAcc.Some cond-instrs cond-values true)
                      (OptBceVersionGuardAcc.No))]
                  [_
                    (opt-bce-version-cond
                      cell
                      (CompilerIrBinOp.Lt)
                      seed
                      bound
                      (OptBceVersionGuardAcc.Some cond-instrs cond-values true))])]
              [_
                (opt-bce-version-cond
                  cell
                  (CompilerIrBinOp.Lt)
                  seed
                  bound
                  (OptBceVersionGuardAcc.Some cond-instrs cond-values true))])
            (OptBceVersionGuardAcc.Some cond-instrs cond-values false))]
        [seeded : OptBceVersionGuardAcc
          (if counter-seen
            (match entered
              [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
              [(OptBceVersionGuardAcc.Some e-instrs e-values _)
                (match seed
                  [(CompilerIrValue.I64 k)
                    (if (>= k 0)
                      (OptBceVersionGuardAcc.Some e-instrs e-values true)
                      (OptBceVersionGuardAcc.No))]
                  [(CompilerIrValue.Var _)
                    (opt-bce-version-cond
                      cell
                      (CompilerIrBinOp.Ge)
                      seed
                      (CompilerIrValue.I64 0)
                      (OptBceVersionGuardAcc.Some e-instrs e-values true))]
                  [_ (OptBceVersionGuardAcc.No)])])
            entered)]
        (match seeded
          [(OptBceVersionGuardAcc.No) (OptBceVersionGuardResult.No)]
          [(OptBceVersionGuardAcc.Some all-instrs all-values _)
            (match all-values
              [(CompilerIrValueList.Nil) (OptBceVersionGuardResult.No)]
              [(CompilerIrValueList.Array seq)
                (match (compiler-ir-value-seq-to-list seq)
                  [(CompilerIrValueList.Nil) (OptBceVersionGuardResult.No)]
                  [(CompilerIrValueList.Array _) (OptBceVersionGuardResult.No)]
                  [(CompilerIrValueList.Cons first rest)
                    (opt-bce-version-and-chain
                      cell
                      first
                      (box-get rest)
                      (compiler-ir-instr-list-reverse-onto
                        all-instrs
                        CompilerIrInstrList.Nil))])]
              [(CompilerIrValueList.Cons first rest)
                (opt-bce-version-and-chain
                  cell
                  first
                  (box-get rest)
                  (compiler-ir-instr-list-reverse-onto
                    all-instrs
                    CompilerIrInstrList.Nil))])]))]))

;; Assemble the single-block guard: derive the per-check conditions, then
;; finish them (seed compares + And chain).
(define (opt-bce-version-guard-conds
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [iphi : i64]
  [seed : CompilerIrValue]
  [bound : CompilerIrValue]
  [cell : (Array i64)]) : OptBceVersionGuardResult
  (opt-bce-version-guard-finish
    seed
    bound
    cell
    (opt-bce-version-derive-checks
      instrs
      phi-count
      phi-count
      last
      defs
      iphi
      bound
      cell
      (OptBceVersionGuardAcc.Some
        (CompilerIrInstrList.Nil)
        (CompilerIrValueList.Nil)
        false))))

;; --- shape scan ---------------------------------------------------------------
(define (opt-bce-version-shape-phi
  [blocks : CompilerIrBlockList]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-index : i64]
  [cond-var : i64]
  [inext : i64]
  [ity : AstType]
  [bound : CompilerIrValue]
  [iphi : i64]) : OptUnrollMaybeShape
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [iphi-index : i64 (opt-unroll-def-index slots 0 phi-count iphi)]
    (if (< iphi-index 0)
      (OptUnrollMaybeShape.No)
      (match (compiler-ir-instr-seq-ref instrs iphi-index)
        [(CompilerIrInstr.Phi _ inputs iphi-ty)
          (match (opt-unroll-split-phi-inputs inputs label)
            [(OptUnrollPhiSplit.Split seed back pred-label)
              (if (and
                (not (= pred-label label))
                (opt-unroll-back-resolves-to? instrs phi-count last back inext)
                (not
                  (opt-cfg-block-exists?
                    blocks
                    (compiler-ir-label
                      (string.append
                        (compiler-ir-label-text label)
                        "__bce_guard"))))
                (not
                  (opt-cfg-block-exists?
                    blocks
                    (compiler-ir-label
                      (string.append
                        (compiler-ir-label-text label)
                        "__bce_fast"))))
                (opt-unroll-pred-retargetable? blocks pred-label))
                (match (opt-unroll-collect-other-phis
                  instrs
                  0
                  phi-count
                  label
                  pred-label
                  iphi)
                  [(OptUnrollMaybePhis.Some others)
                    (OptUnrollMaybeShape.Some
                      (OptUnrollShape
                        label
                        pred-label
                        phi-count
                        cond-index
                        cond-var
                        iphi
                        iphi-ty
                        seed
                        inext
                        ity
                        bound
                        others))]
                  [(OptUnrollMaybePhis.No) (OptUnrollMaybeShape.No)])
                (OptUnrollMaybeShape.No))]
            [(OptUnrollPhiSplit.No) (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-bce-version-shape-step
  [blocks : CompilerIrBlockList]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [cond-index : i64]
  [inext : i64]
  [bound : CompilerIrValue]) : OptUnrollMaybeShape
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [inext-index : i64 (opt-unroll-def-index slots phi-count last inext)]
    (if (< inext-index 0)
      (OptUnrollMaybeShape.No)
      (match (compiler-ir-instr-seq-ref instrs inext-index)
        [(CompilerIrInstr.BinOp _ add-op add-lhs add-rhs ity)
          (match add-op
            [(CompilerIrBinOp.Add)
              (match add-lhs
                [(CompilerIrValue.Var add-src)
                  (match add-rhs
                    [(CompilerIrValue.I64 step)
                      (if (and
                        (= step 1)
                        ;; I64 only: the guard reasons in SIGNED 64-bit
                        ;; arithmetic, so narrow (wrapping) and unsigned
                        ;; counters are out of scope.
                        (match ity
                          [(AstType.I64) true]
                          [_ false]))
                        (opt-bce-version-shape-phi
                          blocks
                          label
                          instrs
                          phi-count
                          last
                          cond-index
                          cond-var
                          inext
                          ity
                          bound
                          (opt-unroll-resolve-copy
                            instrs
                            phi-count
                            last
                            add-src
                            16))
                        (OptUnrollMaybeShape.No))]
                    [_ (OptUnrollMaybeShape.No)])]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-bce-version-shape-counter
  [blocks : CompilerIrBlockList]
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [defs : opt_i64_i64_map.Map]) : OptUnrollMaybeShape
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [cond-index : i64 (opt-unroll-def-index slots phi-count last cond-var)]
    (if (< cond-index 0)
      (OptUnrollMaybeShape.No)
      (match (compiler-ir-instr-seq-ref instrs cond-index)
        [(CompilerIrInstr.BinOp _ cmp-op cmp-lhs cmp-rhs _)
          (match cmp-op
            [(CompilerIrBinOp.Lt)
              (match cmp-lhs
                [(CompilerIrValue.Var cmp-src)
                  (if (opt-unroll-invariant-bound? defs cmp-rhs)
                    (opt-bce-version-shape-step
                      blocks
                      label
                      instrs
                      phi-count
                      last
                      cond-var
                      cond-index
                      (opt-unroll-resolve-copy instrs phi-count last cmp-src 16)
                      cmp-rhs)
                    (OptUnrollMaybeShape.No))]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-bce-version-block-shape
  [blocks : CompilerIrBlockList]
  [entry-label : i64]
  [block : CompilerIrBlock]) : OptUnrollMaybeShape
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (< count 4)
          (OptUnrollMaybeShape.No)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Branch cond then-label else-label)
              (match cond
                [(CompilerIrValue.Var cond-var)
                  (if (and
                    (= then-label label)
                    (not (= else-label label))
                    (not (= label entry-label)))
                    (let
                      [last : i64 (- count 1)]
                      [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
                      (if (or
                        (< phi-count 1)
                        (< (- last phi-count) 2)
                        (> (- last phi-count) (opt-bce-version-body-max))
                        (not (opt-unroll-no-phi-from? instrs phi-count))
                        (not (opt-bce-version-body-ok? instrs phi-count last))
                        (<
                          (opt-bce-version-check-count instrs phi-count last 0)
                          1))
                        (OptUnrollMaybeShape.No)
                        (opt-bce-version-shape-counter
                          blocks
                          label
                          instrs
                          phi-count
                          last
                          cond-var
                          (opt-unroll-block-defs
                            (struct-get instrs slots)
                            0
                            (+ last 1)
                            (opt_i64_i64_map.with-capacity 32)))))
                    (OptUnrollMaybeShape.No))]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])))]))

;; --- rewrite -------------------------------------------------------------------
;; Uses of loop defs anywhere outside the loop block, except as the loop-edge
;; inputs of the exit block's phis (those get the parallel fast input).
(define (opt-bce-version-outside-phi-uses
  [set : opt_i64_i64_map.Map]
  [inputs : CompilerIrPhiInputList]
  [loop-label : i64]) : opt_i64_i64_map.Map
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) set]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-version-outside-phi-uses
        set
        (compiler-ir-phi-input-seq-to-list seq)
        loop-label)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (opt-bce-version-outside-phi-uses
        (if (= label loop-label)
          set
          (opt-collect-value-uses set value))
        (box-get rest)
        loop-label)]))

(define (opt-bce-version-outside-uses-seq
  [set : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [loop-label : i64]) : opt_i64_i64_map.Map
  (if (>= index (compiler-ir-instr-seq-count instrs))
    set
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (opt-bce-version-outside-uses-seq
        (match instr
          [(CompilerIrInstr.Phi _ inputs _)
            (opt-bce-version-outside-phi-uses set inputs loop-label)]
          [_ (opt-collect-instr-uses set instr)])
        instrs
        (+ index 1)
        loop-label))))

(define (opt-bce-version-outside-uses
  [set : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]
  [loop-label : i64]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (opt-bce-version-outside-uses
        (match block
          [(CompilerIrBlock.Block label instrs)
            (if (= label loop-label)
              set
              (opt-bce-version-outside-uses-seq set instrs 0 loop-label))])
        (box-get rest)
        loop-label)]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-version-outside-uses
        set
        (compiler-ir-block-seq-to-list seq)
        loop-label)]))

(define (opt-bce-version-defs-escape?
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [outside : opt_i64_i64_map.Map]) : bool
  (if (>= index count)
    false
    (let
      [dst : i64 (compiler-ir-instr-array-loop-dst-or slots index (- 0 1))]
      (if (and (>= dst 0) (opt-used-contains outside dst))
        true
        (opt-bce-version-defs-escape? slots (+ index 1) count outside)))))

;; The fast clone's leading phis: the counter and every loop-carried value,
;; seeded from the guard and chained through the clone's remapped back edges.
(define (opt-bce-version-fast-phis
  [others : OptUnrollPhiList]
  [remap : (Array CompilerIrValue)]
  [guard-label : i64]
  [fast-label : i64]
  [tail : CompilerIrInstrList]) : CompilerIrInstrList
  (match others
    [(OptUnrollPhiList.Nil) tail]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi dst init back ty)
          (compiler-ir-instr-cons
            (CompilerIrInstr.Phi
              (match (opt-unroll-subst-value remap (CompilerIrValue.Var dst))
                [(CompilerIrValue.Var fresh-id) fresh-id]
                [_ dst])
              (compiler-ir-phi-input-cons
                init
                guard-label
                (compiler-ir-phi-input-cons
                  (opt-unroll-subst-value remap back)
                  fast-label
                  (CompilerIrPhiInputList.Nil)))
              ty)
            (opt-bce-version-fast-phis
              (box-get rest)
              remap
              guard-label
              fast-label
              tail))])]))

(define (opt-bce-version-clone-body
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]) : CompilerIrInstrList
  (if (>= index last)
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(CompilerIrInstr.BoundsCheck _ _ _)
          (opt-bce-version-clone-body instrs (+ index 1) last remap cell)]
        [_
          (let
            [cloned : CompilerIrInstr
              (opt-unroll-clone-instr remap cell 0 instr)]
            (compiler-ir-instr-cons
              cloned
              (opt-bce-version-clone-body instrs (+ index 1) last remap cell)))]))))

;; Relabel the loop phis' outside-pred inputs to the guard block.
(define (opt-relabel-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [pred-label : i64]
  [guard-label : i64]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-relabel-phi-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        pred-label
        guard-label)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        value
        (if (= label pred-label)
          guard-label
          label)
        (opt-relabel-phi-inputs (box-get rest) pred-label guard-label))]))

(define (opt-relabel-phi-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [pred-label : i64]
  [guard-label : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (compiler-ir-instr-cons
        (match instr
          [(CompilerIrInstr.Phi dst inputs ty)
            (CompilerIrInstr.Phi
              dst
              (opt-relabel-phi-inputs inputs pred-label guard-label)
              ty)]
          [_ instr])
        (opt-relabel-phi-instrs instrs (+ index 1) pred-label guard-label)))))

;; Extend the exit block's phis: every input carried on the loop edge gains a
;; parallel input carrying the fast clone's remapped value.
(define (opt-bce-version-extend-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [loop-label : i64]
  [fast-label : i64]
  [remap : (Array CompilerIrValue)]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-version-extend-phi-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        loop-label
        fast-label
        remap)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : CompilerIrPhiInputList
          (opt-bce-version-extend-phi-inputs
            (box-get rest)
            loop-label
            fast-label
            remap)]
        (if (= label loop-label)
          (compiler-ir-phi-input-cons
            value
            label
            (compiler-ir-phi-input-cons
              (opt-unroll-subst-value remap value)
              fast-label
              tail))
          (compiler-ir-phi-input-cons value label tail)))]))

(define (opt-bce-version-extend-exit-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [loop-label : i64]
  [fast-label : i64]
  [remap : (Array CompilerIrValue)]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (compiler-ir-instr-cons
        (match instr
          [(CompilerIrInstr.Phi dst inputs ty)
            (CompilerIrInstr.Phi
              dst
              (opt-bce-version-extend-phi-inputs
                inputs
                loop-label
                fast-label
                remap)
              ty)]
          [_ instr])
        (opt-bce-version-extend-exit-instrs
          instrs
          (+ index 1)
          loop-label
          fast-label
          remap)))))

(define (opt-bce-version-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [pred-label : i64]
  [loop-label : i64]
  [exit-label : i64]
  [fast-label : i64]
  [guard-label : i64]
  [guard-block : CompilerIrBlock]
  [fast-block : CompilerIrBlock]
  [remap : (Array CompilerIrValue)]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [tail : CompilerIrBlockList
              (opt-bce-version-rewrite-blocks
                (box-get rest)
                pred-label
                loop-label
                exit-label
                fast-label
                guard-label
                guard-block
                fast-block
                remap)]
            (if (= label loop-label)
              (compiler-ir-block-cons
                guard-block
                (compiler-ir-block-cons
                  fast-block
                  (compiler-ir-block-cons
                    (compiler-ir-block
                      label
                      (opt-relabel-phi-instrs instrs 0 pred-label guard-label))
                    tail)))
              (compiler-ir-block-cons
                (cond
                  [(= label pred-label)
                    (compiler-ir-block
                      label
                      (opt-unroll-retarget-instrs
                        instrs
                        0
                        loop-label
                        guard-label))]
                  [(= label exit-label)
                    (compiler-ir-block
                      label
                      (opt-bce-version-extend-exit-instrs
                        instrs
                        0
                        loop-label
                        fast-label
                        remap))]
                  [else block])
                tail)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-version-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        pred-label
        loop-label
        exit-label
        fast-label
        guard-label
        guard-block
        fast-block
        remap)]))

(define (opt-bce-version-apply
  [blocks : CompilerIrBlockList]
  [block : CompilerIrBlock]
  [shape : OptUnrollShape]
  [frame : i64]) : OptUnrollResult
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        [last : i64 (- count 1)]
        [phi-count : i64 (struct-get shape phi-count)]
        [iphi : i64 (struct-get shape iphi)]
        [iphi-ty : AstType (struct-get shape iphi-ty)]
        [seed : CompilerIrValue (struct-get shape seed)]
        [inext : i64 (struct-get shape inext)]
        [bound : CompilerIrValue (struct-get shape bound)]
        [others : OptUnrollPhiList (struct-get shape others)]
        [pred-label : i64 (struct-get shape pred-label)]
        [cond-var : i64 (struct-get shape cond-var)]
        [exit-label : i64
          (match (compiler-ir-instr-seq-ref instrs last)
            [(CompilerIrInstr.Branch _ _ else-label) else-label]
            [_ label])]
        [guard-label : i64
          (compiler-ir-label
            (string.append (compiler-ir-label-text label) "__bce_guard"))]
        [fast-label : i64
          (compiler-ir-label
            (string.append (compiler-ir-label-text label) "__bce_fast"))]
        [defs : opt_i64_i64_map.Map
          (opt-unroll-block-defs
            (struct-get instrs slots)
            0
            (compiler-ir-instr-seq-count instrs)
            (opt_i64_i64_map.with-capacity 32))]
        [outside : opt_i64_i64_map.Map
          (opt-bce-version-outside-uses
            (opt_i64_i64_map.with-capacity 64)
            blocks
            label)]
        (if (or
          (= exit-label label)
          (= exit-label pred-label)
          (opt-bce-version-defs-escape?
            (struct-get instrs slots)
            0
            (compiler-ir-instr-seq-count instrs)
            outside))
          (OptUnrollResult.Result blocks frame false)
          (let
            [cell : (Array i64) (array.make-array i64 1)]
            [_cell : unit (array-set! cell 0 frame)]
            (match (opt-bce-version-guard-conds
              instrs
              phi-count
              last
              defs
              iphi
              seed
              bound
              cell)
              [(OptBceVersionGuardResult.No)
                (OptUnrollResult.Result blocks frame false)]
              [(OptBceVersionGuardResult.Some guard-instrs guard-value)
                (let
                  [remap : (Array CompilerIrValue)
                    (array.make-array CompilerIrValue frame)]
                  [_fill : unit (opt-unroll-remap-fill remap 0)]
                  ;; Fresh phi destinations first so the cloned body reads the
                  ;; clone's loop-carried values.
                  [_iphi : i64 (opt-unroll-clone-dst remap cell iphi)]
                  [_others : unit
                    (opt-bce-version-alloc-other-phis remap cell others)]
                  [body : CompilerIrInstrList
                    (opt-bce-version-clone-body
                      instrs
                      phi-count
                      last
                      remap
                      cell)]
                  [fast-block : CompilerIrBlock
                    (compiler-ir-block
                      fast-label
                      (compiler-ir-instr-cons
                        (CompilerIrInstr.Phi
                          (match (opt-unroll-subst-value
                            remap
                            (CompilerIrValue.Var iphi))
                            [(CompilerIrValue.Var fresh-id) fresh-id]
                            [_ iphi])
                          (compiler-ir-phi-input-cons
                            seed
                            guard-label
                            (compiler-ir-phi-input-cons
                              (opt-unroll-subst-value
                                remap
                                (CompilerIrValue.Var inext))
                              fast-label
                              (CompilerIrPhiInputList.Nil)))
                          iphi-ty)
                        (opt-bce-version-fast-phis
                          others
                          remap
                          guard-label
                          fast-label
                          (opt-aggregate-instr-list-append
                            body
                            (compiler-ir-instr-cons
                              (CompilerIrInstr.Branch
                                (opt-unroll-subst-value
                                  remap
                                  (CompilerIrValue.Var cond-var))
                                fast-label
                                exit-label)
                              (CompilerIrInstrList.Nil))))))]
                  [guard-block : CompilerIrBlock
                    (compiler-ir-block
                      guard-label
                      (opt-aggregate-instr-list-append
                        guard-instrs
                        (compiler-ir-instr-cons
                          (CompilerIrInstr.Branch guard-value fast-label label)
                          (CompilerIrInstrList.Nil))))]
                  (OptUnrollResult.Result
                    (opt-bce-version-rewrite-blocks
                      blocks
                      pred-label
                      label
                      exit-label
                      fast-label
                      guard-label
                      guard-block
                      fast-block
                      remap)
                    (array-ref cell 0)
                    true))]))))]))

(define (opt-bce-version-alloc-other-phis
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]
  [others : OptUnrollPhiList]) : unit
  (match others
    [(OptUnrollPhiList.Nil) unit]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi dst _ _ _)
          (begin
            (opt-unroll-clone-dst remap cell dst)
            (opt-bce-version-alloc-other-phis remap cell (box-get rest)))])]))

;; Apply at most one versioning per invocation, like the unroller.
(define (opt-bce-version-blocks-scan
  [blocks : CompilerIrBlockList]
  [remaining : CompilerIrBlockList]
  [entry-label : i64]
  [frame : i64]) : OptUnrollResult
  (match remaining
    [(CompilerIrBlockList.Nil) (OptUnrollResult.Result blocks frame false)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-bce-version-block-shape blocks entry-label block)
        [(OptUnrollMaybeShape.Some shape)
          (match (opt-bce-version-apply blocks block shape frame)
            [(OptUnrollResult.Result next-blocks next-frame changed)
              (if changed
                (OptUnrollResult.Result next-blocks next-frame true)
                (opt-bce-version-blocks-scan
                  blocks
                  (box-get rest)
                  entry-label
                  frame))])]
        [(OptUnrollMaybeShape.No)
          (opt-bce-version-blocks-scan blocks (box-get rest) entry-label frame)])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-version-blocks-scan
        blocks
        (compiler-ir-block-seq-to-list seq)
        entry-label
        frame)]))

;; Cheap prescan: a candidate is a self-loop block that starts with a Phi,
;; ends with a self-branch, and contains a BoundsCheck.
(define (opt-bce-version-block-candidate? [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (< count 4)
          false
          (match (compiler-ir-instr-seq-ref instrs 0)
            [(CompilerIrInstr.Phi _ _ _)
              (match (compiler-ir-instr-seq-ref instrs (- count 1))
                [(CompilerIrInstr.Branch _ true-label _)
                  (and
                    (= true-label label)
                    (>= (opt-bce-version-check-count instrs 0 (- count 1) 0) 1))]
                [_ false])]
            [_ false])))]))

(define (opt-bce-version-blocks-have-candidate? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-bce-version-block-candidate? block)
        true
        (opt-bce-version-blocks-have-candidate? (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-version-blocks-have-candidate?
        (compiler-ir-block-seq-to-list seq))]))

;; --- multi-block bounds-check loop versioning ----------------------------------
;;
;; The single-block pass above only sees do-while self-loops. A counted loop
;; whose body spans several blocks (an if/else inside a scan -- the quicksort
;; partition loop is the running example) pays the same per-iteration cmp+jb
;; on every BoundsCheck even though the same up-front reasoning applies: a
;; counter phi stepping exactly +1 per latch crossing with an invariant
;; bound, plus a second "bounded" header phi sharing the counter's seed whose
;; back-edge value stays within {sphi, sphi+1} through any merge, keeps every
;; provable index inside [0, len) for the whole trip range whenever
;;   seed >= 0 && seed < bound && bound <= len.
;; This pass recognizes such a loop from its natural-loop back edge (header
;; dominating latch, a single dedicated preheader whose only successor is the
;; header, <= (opt-bce-mb-block-max) blocks, clonable whitelist instructions
;; only, Jump/Branch/Switch or intra-loop fallthrough terminators only) and versions
;; like the single-block pass: a guard block on the preheader edge branches
;; to a fast clone of the whole loop when the guard conjunction holds and to
;; the original checked loop otherwise. PARTIAL elimination: every BoundsCheck
;; whose condition derives is dropped from the clone; a check that does not
;; derive (a dynamic stack index, a second array, ...) is simply KEPT there --
;; remapped like every other cloned instruction -- instead of rejecting the
;; whole loop, and the guard constrains only the removed checks. Cloning
;; requires at least one derivable check; the kept checks preserve the exact
;; abort semantics of the slow path.
;;
;; Derivations (a check matching none of these stays in the clone):
;;   * index resolves to the counter phi       -> `bound <= len`
;;   * index resolves to a bounded header phi  -> covered by the counter's
;;     conditions (same resolved seed; back-edge value is sphi or sphi+1
;;     through any phi merge, so seed <= sphi <= scan < bound <= len); emits
;;     `bound <= len` and forces the counter seed compares
;;   * index == BitAnd(_, M), M >= 0 literal   -> `M < len`
;;   * index loop-invariant                    -> `index >= 0 && index < len`
;; A latch-merge-phi index (sphi+1 selected at the merge) is deliberately NOT
;; accepted: it can reach `bound` itself, which `bound <= len` does not
;; exclude from failing. Likewise `sphi + 1` used directly.
;;
;; Exit wiring generalizes the single-block scheme: loop defs may reach
;; outside code only as exit-phi inputs on loop edges (any other outside use
;; rejects); each such input gains a parallel input from the corresponding
;; fast clone's edge. Fallthrough is positional: loop blocks may only fall
;; through to other loop blocks, the fast clone group preserves the loop's
;; block order so intra-loop fallthroughs clone correctly, and the guard
;; sits immediately before the slow header so a fallthrough preheader lands
;; on it.
(defenum OptBceMbMaybeInstr
  (No)
  (Some CompilerIrInstr))

(defenum OptBceMbMaybeSeed
  (No)
  (Some CompilerIrValue))

;; cond-var, exit-label of a latch branch.
(defenum OptBceMbMaybeLatch
  (No)
  (Some i64 i64))

;; iphi, seed, inext, bound.
(defenum OptBceMbMaybeCounter
  (No)
  (Some i64 CompilerIrValue i64 CompilerIrValue))

(defstruct OptBceMbShape
  (header i64)
  (latch i64)
  (preheader i64)
  (body-labels OptLabelSet)
  (body-blocks CompilerIrBlockList)
  (iphi i64)
  (seed CompilerIrValue)
  (bound CompilerIrValue))

(defenum OptBceMbMaybeShape
  (No)
  (Some OptBceMbShape))

(define (opt-bce-mb-block-max) : i64
  8)

;; The (SSA single-def) instruction defining var anywhere in the loop.
(define (opt-bce-mb-find-def-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptBceMbMaybeInstr
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptBceMbMaybeInstr.No)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (if (= (compiler-ir-instr-loop-dst-or instr (- 0 1)) var)
        (OptBceMbMaybeInstr.Some instr)
        (opt-bce-mb-find-def-instrs instrs (+ index 1) var)))))

(define (opt-bce-mb-find-def [blocks : CompilerIrBlockList] [var : i64]) : OptBceMbMaybeInstr
  (match blocks
    [(CompilerIrBlockList.Nil) (OptBceMbMaybeInstr.No)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (opt-bce-mb-find-def-instrs instrs 0 var)
            [(OptBceMbMaybeInstr.Some instr) (OptBceMbMaybeInstr.Some instr)]
            [(OptBceMbMaybeInstr.No) (opt-bce-mb-find-def (box-get rest) var)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-find-def (compiler-ir-block-seq-to-list seq) var)]))

;; Resolve through Mov copies and 64-bit int reinterpret casts anywhere in
;; the loop (the multi-block analogue of `opt-bce-version-resolve`).
(define (opt-bce-mb-resolve
  [blocks : CompilerIrBlockList]
  [var : i64]
  [fuel : i64]) : i64
  (if (<= fuel 0)
    var
    (match (opt-bce-mb-find-def blocks var)
      [(OptBceMbMaybeInstr.No) var]
      [(OptBceMbMaybeInstr.Some instr)
        (match instr
          [(CompilerIrInstr.Mov _ src _)
            (match src
              [(CompilerIrValue.Var src-id)
                (opt-bce-mb-resolve blocks src-id (- fuel 1))]
              [_ var])]
          [(CompilerIrInstr.Cast _ src from-ty to-ty)
            (if (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
              (match src
                [(CompilerIrValue.Var src-id)
                  (opt-bce-mb-resolve blocks src-id (- fuel 1))]
                [_ var])
              var)]
          [_ var])])))

(define (opt-bce-mb-collect-defs
  [blocks : CompilerIrBlockList]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) acc]
    [(CompilerIrBlockList.Cons block rest)
      (opt-bce-mb-collect-defs
        (box-get rest)
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (opt-unroll-block-defs
              (struct-get instrs slots)
              0
              (compiler-ir-instr-seq-count instrs)
              acc)]))]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-collect-defs (compiler-ir-block-seq-to-list seq) acc)]))

;; --- shape scan ---------------------------------------------------------------
;; The latch must end `Branch c header exit` with the exit outside the loop.
(define (opt-bce-mb-latch-branch
  [block : CompilerIrBlock]
  [header : i64]
  [body-labels : OptLabelSet]) : OptBceMbMaybeLatch
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (< count 1)
          (OptBceMbMaybeLatch.No)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Branch cond then-label else-label)
              (match cond
                [(CompilerIrValue.Var cond-var)
                  (if (and
                    (= then-label header)
                    (not (opt-label-contains body-labels else-label)))
                    (OptBceMbMaybeLatch.Some cond-var else-label)
                    (OptBceMbMaybeLatch.No))]
                [_ (OptBceMbMaybeLatch.No)])]
            [_ (OptBceMbMaybeLatch.No)])))]))

;; The counter phi: a header phi (only header phis carry latch-edge inputs)
;; of type i64 fed (seed from the preheader, inext from the latch).
(define (opt-bce-mb-counter-phi
  [body-blocks : CompilerIrBlockList]
  [latch : i64]
  [preheader : i64]
  [inext : i64]
  [iphi : i64]) : OptBceMbMaybeSeed
  (match (opt-bce-mb-find-def body-blocks iphi)
    [(OptBceMbMaybeInstr.No) (OptBceMbMaybeSeed.No)]
    [(OptBceMbMaybeInstr.Some instr)
      (match instr
        [(CompilerIrInstr.Phi _ inputs pty)
          (match pty
            [(AstType.I64)
              (match (opt-unroll-split-phi-inputs inputs latch)
                [(OptUnrollPhiSplit.Split seed back pred-label)
                  (if (and
                    (= pred-label preheader)
                    (match back
                      [(CompilerIrValue.Var back-id)
                        (= (opt-bce-mb-resolve body-blocks back-id 16) inext)]
                      [_ false]))
                    (OptBceMbMaybeSeed.Some seed)
                    (OptBceMbMaybeSeed.No))]
                [(OptUnrollPhiSplit.No) (OptBceMbMaybeSeed.No)])]
            [_ (OptBceMbMaybeSeed.No)])]
        [_ (OptBceMbMaybeSeed.No)])]))

(define (opt-bce-mb-counter-step-inext
  [body-blocks : CompilerIrBlockList]
  [latch : i64]
  [preheader : i64]
  [inext : i64]
  [bound : CompilerIrValue]) : OptBceMbMaybeCounter
  (match (opt-bce-mb-find-def body-blocks inext)
    [(OptBceMbMaybeInstr.No) (OptBceMbMaybeCounter.No)]
    [(OptBceMbMaybeInstr.Some instr)
      (match instr
        [(CompilerIrInstr.BinOp _ add-op add-lhs add-rhs ity)
          (match add-op
            [(CompilerIrBinOp.Add)
              (match add-lhs
                [(CompilerIrValue.Var add-src)
                  (match add-rhs
                    [(CompilerIrValue.I64 step)
                      (if (and
                        (= step 1)
                        ;; I64 only: the guard reasons in SIGNED 64-bit
                        ;; arithmetic, like the single-block pass.
                        (match ity
                          [(AstType.I64) true]
                          [_ false]))
                        (let
                          [iphi : i64
                            (opt-bce-mb-resolve body-blocks add-src 16)]
                          (match (opt-bce-mb-counter-phi
                            body-blocks
                            latch
                            preheader
                            inext
                            iphi)
                            [(OptBceMbMaybeSeed.No) (OptBceMbMaybeCounter.No)]
                            [(OptBceMbMaybeSeed.Some seed)
                              (OptBceMbMaybeCounter.Some iphi seed inext bound)]))
                        (OptBceMbMaybeCounter.No))]
                    [_ (OptBceMbMaybeCounter.No)])]
                [_ (OptBceMbMaybeCounter.No)])]
            [_ (OptBceMbMaybeCounter.No)])]
        [_ (OptBceMbMaybeCounter.No)])]))

;; The latch compare `c = inext < bound` with `inext = iphi + 1` (i64, step
;; exactly one) and an invariant bound.
(define (opt-bce-mb-counter-step
  [body-blocks : CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [cond-var : i64]) : OptBceMbMaybeCounter
  (match (opt-bce-mb-find-def body-blocks cond-var)
    [(OptBceMbMaybeInstr.No) (OptBceMbMaybeCounter.No)]
    [(OptBceMbMaybeInstr.Some instr)
      (match instr
        [(CompilerIrInstr.BinOp _ cmp-op cmp-lhs cmp-rhs _)
          (match cmp-op
            [(CompilerIrBinOp.Lt)
              (match cmp-lhs
                [(CompilerIrValue.Var cmp-src)
                  (if (opt-unroll-invariant-bound? defs cmp-rhs)
                    (opt-bce-mb-counter-step-inext
                      body-blocks
                      latch
                      preheader
                      (opt-bce-mb-resolve body-blocks cmp-src 16)
                      cmp-rhs)
                    (OptBceMbMaybeCounter.No))]
                [_ (OptBceMbMaybeCounter.No)])]
            [_ (OptBceMbMaybeCounter.No)])]
        [_ (OptBceMbMaybeCounter.No)])]))

;; Every header phi must split as (preheader, latch): the header then has
;; exactly the two expected predecessors.
(define (opt-bce-mb-header-phis-ok?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [latch : i64]
  [preheader : i64]) : bool
  (if (>= index phi-count)
    true
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ inputs _)
        (match (opt-unroll-split-phi-inputs inputs latch)
          [(OptUnrollPhiSplit.Split _ _ pred-label)
            (if (= pred-label preheader)
              (opt-bce-mb-header-phis-ok?
                instrs
                (+ index 1)
                phi-count
                latch
                preheader)
              false)]
          [(OptUnrollPhiSplit.No) false])]
      [_ false])))

;; One loop block's BoundsCheck count, or -1 when the block is not clonable:
;; phis only as a prefix, whitelist body instructions, and either a
;; Jump/Branch/Switch terminator or a plain fallthrough (the fallthrough TARGET is
;; validated separately against the block list).
(define (opt-bce-mb-block-checks [block : CompilerIrBlock]) : i64
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
        (if (not (opt-unroll-no-phi-from? instrs phi-count))
          (- 0 1)
          (if (opt-cfg-instr-seq-can-fallthrough? instrs)
            (if (and
              (<= (- count phi-count) (opt-bce-version-body-max))
              (opt-bce-version-body-ok? instrs phi-count count))
              (opt-bce-version-check-count instrs phi-count count 0)
              (- 0 1))
            (let
              [last : i64 (- count 1)]
              (if (and
                (<= (- last phi-count) (opt-bce-version-body-max))
                (match (compiler-ir-instr-seq-ref instrs last)
                  [(CompilerIrInstr.Jump _) true]
                  [(CompilerIrInstr.Branch _ _ _) true]
                  [(CompilerIrInstr.Switch _ _ _ _) true]
                  [_ false])
                (opt-bce-version-body-ok? instrs phi-count last))
                (opt-bce-version-check-count instrs phi-count last 0)
                (- 0 1))))))]))

;; Total BoundsCheck count across the loop, or -1 when any block is not
;; clonable (the caller treats < 1 as a rejection).
(define (opt-bce-mb-body-checks [blocks : CompilerIrBlockList] [acc : i64]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) acc]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [checks : i64 (opt-bce-mb-block-checks block)]
        (if (< checks 0)
          (- 0 1)
          (opt-bce-mb-body-checks (box-get rest) (+ acc checks))))]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-body-checks (compiler-ir-block-seq-to-list seq) acc)]))

;; Exhaustive enum dispatches carry their totality proof on the classic Switch
;; default until the dedicated late rewrite. Cloning one of these high-fanout
;; interpreter loops duplicates every arm, pushes the combined CFG over the
;; backend's compact allocation shape, and loses far more than BCE removes.
;; Ordinary Switch loops remain clonable (and are covered by the fixture).
(define (opt-bce-mb-body-has-total-enum-switch? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (or
              (and
                (> count 0)
                (match (compiler-ir-instr-seq-ref instrs (- count 1))
                  [(CompilerIrInstr.Switch _ _ _ default-label)
                    (opt-late-total-switch-marker-label? default-label)]
                  [_ false]))
              (opt-bce-mb-body-has-total-enum-switch? (box-get rest))))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-body-has-total-enum-switch?
        (compiler-ir-block-seq-to-list seq))]))

;; Fallthrough is positional: a loop block without a terminator may only
;; fall into another loop block (the fast clone group preserves loop order,
;; so intra-loop fallthroughs clone correctly).
(define (opt-bce-mb-fallthroughs-ok?
  [blocks : CompilerIrBlockList]
  [body-labels : OptLabelSet]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (if (and
            (opt-label-contains body-labels label)
            (opt-cfg-instr-seq-can-fallthrough? instrs)
            (not
              (opt-label-contains
                body-labels
                (opt-cfg-entry-label (box-get rest)))))
            false
            (opt-bce-mb-fallthroughs-ok? (box-get rest) body-labels))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-fallthroughs-ok?
        (compiler-ir-block-seq-to-list seq)
        body-labels)]))

;; Idempotence: no fast-clone label may already exist.
(define (opt-bce-mb-fast-labels-fresh?
  [blocks : CompilerIrBlockList]
  [body-labels : OptLabelSet]) : bool
  (match body-labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref body-labels 0)]
        (if (opt-cfg-block-exists?
          blocks
          (compiler-ir-label
            (string.append (compiler-ir-label-text label) "__bce_fast")))
          false
          (opt-bce-mb-fast-labels-fresh? blocks (opt-label-tail body-labels))))]))

(define (opt-bce-mb-loop-shape-finish
  [blocks : CompilerIrBlockList]
  [header : i64]
  [latch : i64]
  [pred : i64]
  [body-labels : OptLabelSet]
  [body-blocks : CompilerIrBlockList]
  [counter : OptBceMbMaybeCounter]) : OptBceMbMaybeShape
  (match counter
    [(OptBceMbMaybeCounter.No) (OptBceMbMaybeShape.No)]
    [(OptBceMbMaybeCounter.Some iphi seed _ bound)
      (match (opt-cfg-find-block blocks header)
        [(OptMaybeBlock.No) (OptBceMbMaybeShape.No)]
        [(OptMaybeBlock.Some header-block)
          (match header-block
            [(CompilerIrBlock.Block _ header-instrs)
              (if (and
                (opt-bce-mb-header-phis-ok?
                  header-instrs
                  0
                  (opt-unroll-phi-prefix-count header-instrs 0)
                  latch
                  pred)
                (>= (opt-bce-mb-body-checks body-blocks 0) 1))
                (OptBceMbMaybeShape.Some
                  (OptBceMbShape
                    header
                    latch
                    pred
                    body-labels
                    body-blocks
                    iphi
                    seed
                    bound))
                (OptBceMbMaybeShape.No))])])]))

;; No nested natural loop inside the candidate body: versioning an OUTER
;; loop only removes its own per-iteration checks (few next to a whole inner
;; loop's work) while the guard and fast-region prologue cost is paid at
;; every outer entry -- a measured net loss (array_sum's outer loop). Flat
;; loops keep the full win.
(define (opt-bce-mb-has-nested-loop?
  [loops : OptNaturalLoopList]
  [header : i64]
  [body-labels : OptLabelSet]) : bool
  (match loops
    [(OptNaturalLoopList.Nil) false]
    [(OptNaturalLoopList.Cons loop rest)
      (match loop
        [(OptNaturalLoop.Loop other-header _ _ _)
          (if (and
            (not (= other-header header))
            (opt-label-contains body-labels other-header))
            true
            (opt-bce-mb-has-nested-loop? (box-get rest) header body-labels))])]))

(define (opt-bce-mb-loop-shape-with-preheader
  [blocks : CompilerIrBlockList]
  [loops : OptNaturalLoopList]
  [header : i64]
  [latch : i64]
  [body : OptLoopBody]
  [pred : i64]) : OptBceMbMaybeShape
  (let
    [body-labels : OptLabelSet (struct-get body labels)]
    [body-blocks : CompilerIrBlockList (struct-get body blocks)]
    (if (or
      (< (opt-label-count body-labels) 2)
      (> (opt-label-count body-labels) (opt-bce-mb-block-max))
      (opt-cfg-block-exists?
        blocks
        (compiler-ir-label
          (string.append (compiler-ir-label-text header) "__bce_guard")))
      (opt-bce-mb-has-nested-loop? loops header body-labels)
      (opt-bce-mb-body-has-total-enum-switch? body-blocks)
      (not (opt-bce-mb-fast-labels-fresh? blocks body-labels))
      (not (opt-bce-mb-fallthroughs-ok? blocks body-labels)))
      (OptBceMbMaybeShape.No)
      (match (opt-cfg-find-block blocks latch)
        [(OptMaybeBlock.No) (OptBceMbMaybeShape.No)]
        [(OptMaybeBlock.Some latch-block)
          (match (opt-bce-mb-latch-branch latch-block header body-labels)
            [(OptBceMbMaybeLatch.No) (OptBceMbMaybeShape.No)]
            [(OptBceMbMaybeLatch.Some cond-var _)
              (let
                [defs : opt_i64_i64_map.Map
                  (opt-bce-mb-collect-defs
                    body-blocks
                    (opt_i64_i64_map.with-capacity 64))]
                (opt-bce-mb-loop-shape-finish
                  blocks
                  header
                  latch
                  pred
                  body-labels
                  body-blocks
                  (opt-bce-mb-counter-step body-blocks defs latch pred cond-var)))])]))))

(define (opt-bce-mb-loop-shape
  [blocks : CompilerIrBlockList]
  [loops : OptNaturalLoopList]
  [entry-label : i64]
  [loop : OptNaturalLoop]) : OptBceMbMaybeShape
  (match loop
    [(OptNaturalLoop.Loop header latch body preheader)
      (match preheader
        [(OptLoopPreheader.No) (OptBceMbMaybeShape.No)]
        [(OptLoopPreheader.Some pred)
          (if (or
            ;; single-block self-loops belong to the dedicated pass above
            (= header latch)
            (= header entry-label))
            (OptBceMbMaybeShape.No)
            (opt-bce-mb-loop-shape-with-preheader
              blocks
              loops
              header
              latch
              body
              pred))])]))

;; --- outside uses --------------------------------------------------------------
;; Uses of loop defs anywhere outside the loop, except as the loop-edge
;; inputs of exit blocks' phis (those gain a parallel fast-edge input).
(define (opt-bce-mb-outside-phi-uses
  [set : opt_i64_i64_map.Map]
  [inputs : CompilerIrPhiInputList]
  [body-labels : OptLabelSet]) : opt_i64_i64_map.Map
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) set]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-outside-phi-uses
        set
        (compiler-ir-phi-input-seq-to-list seq)
        body-labels)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (opt-bce-mb-outside-phi-uses
        (if (opt-label-contains body-labels label)
          set
          (opt-collect-value-uses set value))
        (box-get rest)
        body-labels)]))

(define (opt-bce-mb-outside-uses-seq
  [set : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [body-labels : OptLabelSet]) : opt_i64_i64_map.Map
  (if (>= index (compiler-ir-instr-seq-count instrs))
    set
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (opt-bce-mb-outside-uses-seq
        (match instr
          [(CompilerIrInstr.Phi _ inputs _)
            (opt-bce-mb-outside-phi-uses set inputs body-labels)]
          [_ (opt-collect-instr-uses set instr)])
        instrs
        (+ index 1)
        body-labels))))

(define (opt-bce-mb-outside-uses
  [set : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]
  [body-labels : OptLabelSet]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (opt-bce-mb-outside-uses
        (match block
          [(CompilerIrBlock.Block label instrs)
            (if (opt-label-contains body-labels label)
              set
              (opt-bce-mb-outside-uses-seq set instrs 0 body-labels))])
        (box-get rest)
        body-labels)]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-outside-uses
        set
        (compiler-ir-block-seq-to-list seq)
        body-labels)]))

(define (opt-bce-mb-defs-escape-instrs?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [outside : opt_i64_i64_map.Map]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (let
      [dst : i64 (compiler-ir-instr-seq-loop-dst-or instrs index (- 0 1))]
      (if (and (>= dst 0) (opt-used-contains outside dst))
        true
        (opt-bce-mb-defs-escape-instrs? instrs (+ index 1) outside)))))

(define (opt-bce-mb-defs-escape?
  [blocks : CompilerIrBlockList]
  [outside : opt_i64_i64_map.Map]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-bce-mb-defs-escape-instrs? instrs 0 outside)
            true
            (opt-bce-mb-defs-escape? (box-get rest) outside))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-defs-escape? (compiler-ir-block-seq-to-list seq) outside)]))

;; --- guard condition derivation ------------------------------------------------
;; Seed equality for the bounded header phi: both seeds are preheader-edge
;; values defined outside the loop, but separate initializers give them
;; distinct var ids (`store : i64 lo` / `scan : i64 lo` lower to two Movs).
;; Compare them up to function-wide Mov/reinterpret-cast resolution so both
;; reduce to the same runtime value.
(define (opt-bce-mb-seeds-match?
  [all-blocks : CompilerIrBlockList]
  [seed : CompilerIrValue]
  [init : CompilerIrValue]) : bool
  (match seed
    [(CompilerIrValue.Var seed-id)
      (match init
        [(CompilerIrValue.Var init-id)
          (=
            (opt-bce-mb-resolve all-blocks seed-id 16)
            (opt-bce-mb-resolve all-blocks init-id 16))]
        [_ false])]
    [(CompilerIrValue.I64 sk)
      (match init
        [(CompilerIrValue.I64 ik) (= sk ik)]
        [_ false])]
    [_ false]))

;; The invariant value an operand resolves to across the whole loop (a
;; literal, or a var defined outside every loop block).
(define (opt-bce-mb-invariant-operand
  [body-blocks : CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : CompilerIrMaybeValue
  (match value
    [(CompilerIrValue.I64 k)
      (CompilerIrMaybeValue.Some (CompilerIrValue.I64 k))]
    [(CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (if (opt-used-contains defs id)
          (CompilerIrMaybeValue.No)
          (CompilerIrMaybeValue.Some (CompilerIrValue.Var id))))]
    [_ (CompilerIrMaybeValue.No)]))

;; The bounded header phi's back-edge value: sphi itself, sphi + 1, or a
;; merge phi whose inputs are each sphi / sphi+1 -- per latch crossing the
;; phi grows by at most the counter's step and never shrinks, so it stays
;; within [seed, scan] for every executed iteration.
(define (opt-bce-mb-bounded-value?
  [body-blocks : CompilerIrBlockList]
  [sphi : i64]
  [value : CompilerIrValue]
  [fuel : i64]) : bool
  (match value
    [(CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (cond
          [(= id sphi) true]
          [(<= fuel 0) false]
          [else
            (match (opt-bce-mb-find-def body-blocks id)
              [(OptBceMbMaybeInstr.No) false]
              [(OptBceMbMaybeInstr.Some instr)
                (match instr
                  [(CompilerIrInstr.BinOp _ op lhs rhs ty)
                    (match op
                      [(CompilerIrBinOp.Add)
                        (match rhs
                          [(CompilerIrValue.I64 step)
                            (and
                              (= step 1)
                              (match ty
                                [(AstType.I64) true]
                                [_ false])
                              (match lhs
                                [(CompilerIrValue.Var add-src)
                                  (=
                                    (opt-bce-mb-resolve body-blocks add-src 16)
                                    sphi)]
                                [_ false]))]
                          [_ false])]
                      [_ false])]
                  [(CompilerIrInstr.Phi _ inputs _)
                    (opt-bce-mb-bounded-inputs?
                      body-blocks
                      sphi
                      inputs
                      (- fuel 1))]
                  [_ false])])]))]
    [_ false]))

(define (opt-bce-mb-bounded-inputs?
  [body-blocks : CompilerIrBlockList]
  [sphi : i64]
  [inputs : CompilerIrPhiInputList]
  [fuel : i64]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) true]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-bounded-inputs?
        body-blocks
        sphi
        (compiler-ir-phi-input-seq-to-list seq)
        fuel)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (if (opt-bce-mb-bounded-value? body-blocks sphi value fuel)
        (opt-bce-mb-bounded-inputs? body-blocks sphi (box-get rest) fuel)
        false)]))

;; Derive the sufficient invariant condition for one check's index operand.
;; Underivable checks kept in the fast clone, identified by (block label,
;; instruction index) -- both walks visit `shape body-blocks` in order, so the
;; pair is a stable identity between guard derivation and cloning.
(defenum OptBceMbKeepEntry
  (Entry i64 i64))

(defenum OptBceMbKeep
  (Nil)
  (Dense (Array OptBceMbKeepEntry) i64))

(define (opt-bce-mb-keep-ref [keep : OptBceMbKeep] [index : i64]) : OptBceMbKeepEntry
  (match keep
    [(OptBceMbKeep.Nil) (OptBceMbKeepEntry.Entry -1 -1)]
    [(OptBceMbKeep.Dense items len) (array-ref items (- (- len 1) index))]))

(define (opt-bce-mb-keep-tail [keep : OptBceMbKeep]) : OptBceMbKeep
  (match keep
    [(OptBceMbKeep.Nil) (OptBceMbKeep.Nil)]
    [(OptBceMbKeep.Dense items len)
      (if (<= len 1)
        (OptBceMbKeep.Nil)
        (OptBceMbKeep.Dense items (- len 1)))]))

(define (opt-bce-mb-keep-cons [label : i64] [index : i64] [keep : OptBceMbKeep]) : OptBceMbKeep
  (let
    [entry : OptBceMbKeepEntry (OptBceMbKeepEntry.Entry label index)]
    (match keep
      [(OptBceMbKeep.Nil)
        (let
          [items : (Array OptBceMbKeepEntry)
            (array.make-array OptBceMbKeepEntry 4)]
          (begin
            (array-set! items 0 entry)
            (OptBceMbKeep.Dense items 1)))]
      [(OptBceMbKeep.Dense items len)
        (if (< len (array-length items))
          (begin
            (array-set! items len entry)
            (OptBceMbKeep.Dense items (+ len 1)))
          (let
            [bigger : (Array OptBceMbKeepEntry)
              (array.make-array OptBceMbKeepEntry (opt-dense-next-capacity len))]
            [slot : i64 0]
            (begin
              (while (< slot len)
                (begin
                  (array-set! bigger slot (array-ref items slot))
                  (set! slot (+ slot 1))))
              (array-set! bigger len entry)
              (OptBceMbKeep.Dense bigger (+ len 1)))))])))

(define (opt-bce-mb-keep-contains?
  [keep : OptBceMbKeep]
  [label : i64]
  [index : i64]) : bool
  (match keep
    [(OptBceMbKeep.Nil) false]
    [(OptBceMbKeep.Dense _ _)
      (match (opt-bce-mb-keep-ref keep 0)
        [(OptBceMbKeepEntry.Entry item-label item-index)
          (if (and (= item-index index) (= item-label label))
            true
            (opt-bce-mb-keep-contains? (opt-bce-mb-keep-tail keep) label index))])]))

;; An index expression represented as either a literal or `base + offset`.
;; Opaque SSA definitions are valid bases: this recognizes both an explicit
;; `second = first - 1` chain and two expressions such as `sp - 1` / `sp - 2`
;; derived independently from the same base.
(defenum OptBceMbAffine
  (No)
  (Const i64)
  (Base i64 i64))

(define (opt-bce-mb-affine-add [value : OptBceMbAffine] [offset : i64]) : OptBceMbAffine
  (match value
    [(OptBceMbAffine.No) (OptBceMbAffine.No)]
    [(OptBceMbAffine.Const k) (OptBceMbAffine.Const (+ k offset))]
    [(OptBceMbAffine.Base base k) (OptBceMbAffine.Base base (+ k offset))]))

(define (opt-bce-mb-affine-value
  [body-blocks : CompilerIrBlockList]
  [value : CompilerIrValue]
  [fuel : i64]) : OptBceMbAffine
  (match value
    [(CompilerIrValue.I64 k) (OptBceMbAffine.Const k)]
    [(CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (if (<= fuel 0)
          (OptBceMbAffine.Base id 0)
          (match (opt-bce-mb-find-def body-blocks id)
            [(OptBceMbMaybeInstr.No) (OptBceMbAffine.Base id 0)]
            [(OptBceMbMaybeInstr.Some instr)
              (match instr
                [(CompilerIrInstr.BinOp _ op lhs rhs ty)
                  (if (opt-affine-64bit-type? ty)
                    (match op
                      [(CompilerIrBinOp.Add)
                        (match (opt-affine-var-const lhs rhs)
                          [(OptAffineOperands.Some src k)
                            (opt-bce-mb-affine-add
                              (opt-bce-mb-affine-value
                                body-blocks
                                (CompilerIrValue.Var src)
                                (- fuel 1))
                              k)]
                          [(OptAffineOperands.No) (OptBceMbAffine.Base id 0)])]
                      [(CompilerIrBinOp.Sub)
                        (match lhs
                          [(CompilerIrValue.Var src)
                            (match rhs
                              [(CompilerIrValue.I64 k)
                                (opt-bce-mb-affine-add
                                  (opt-bce-mb-affine-value
                                    body-blocks
                                    (CompilerIrValue.Var src)
                                    (- fuel 1))
                                  (- 0 k))]
                              [_ (OptBceMbAffine.Base id 0)])]
                          [_ (OptBceMbAffine.Base id 0)])]
                      [_ (OptBceMbAffine.Base id 0)])
                    (OptBceMbAffine.Base id 0))]
                [_ (OptBceMbAffine.Base id 0)])])))]
    [_ (OptBceMbAffine.No)]))

(defenum OptBceMbAffinePair
  (No)
  (Some bool))

(define (opt-bce-mb-affine-pair
  [body-blocks : CompilerIrBlockList]
  [first : CompilerIrValue]
  [second : CompilerIrValue]) : OptBceMbAffinePair
  (match (opt-bce-mb-affine-value body-blocks first 16)
    [(OptBceMbAffine.No) (OptBceMbAffinePair.No)]
    [(OptBceMbAffine.Const first-k)
      (match (opt-bce-mb-affine-value body-blocks second 16)
        [(OptBceMbAffine.Const second-k)
          (if (= (- second-k first-k) 1)
            (OptBceMbAffinePair.Some true)
            (if (= (- first-k second-k) 1)
              (OptBceMbAffinePair.Some false)
              (OptBceMbAffinePair.No)))]
        [_ (OptBceMbAffinePair.No)])]
    [(OptBceMbAffine.Base first-base first-k)
      (match (opt-bce-mb-affine-value body-blocks second 16)
        [(OptBceMbAffine.Base second-base second-k)
          (if (= first-base second-base)
            (if (= (- second-k first-k) 1)
              (OptBceMbAffinePair.Some true)
              (if (= (- first-k second-k) 1)
                (OptBceMbAffinePair.Some false)
                (OptBceMbAffinePair.No)))
            (OptBceMbAffinePair.No))]
        [_ (OptBceMbAffinePair.No)])]))

(defenum OptBceMbPairCandidate
  (No)
  (Some i64 bool CompilerIrValue))

(define (opt-bce-mb-pair-barrier? [instr : CompilerIrInstr]) : bool
  (or
    (compiler-ir-effect-has-side-effect? (compiler-ir-instr-effect instr))
    ;; SafeDiv/SafeMod and checked scalar shifts can abort even though their
    ;; value-producing effect class is Pure.
    (match instr
      [(CompilerIrInstr.BinOp _ op _ _ _) (opt-binop-traps? op)]
      [_ false])))

;; Find the next check in this block. Reads and pure SSA calculations may sit
;; between a pair; a store, call, aborting operation, or control effect closes
;; the window. An intervening incompatible BoundsCheck also closes it because
;; that check is itself an observable trap point.
(define (opt-bce-mb-pair-next
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [body-blocks : CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [first-index : CompilerIrValue]
  [length : CompilerIrValue]) : OptBceMbPairCandidate
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptBceMbPairCandidate.No)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(CompilerIrInstr.BoundsCheck next-index next-length _)
          (match (opt-bce-mb-invariant-operand body-blocks defs next-length)
            [(CompilerIrMaybeValue.Some next-length-invariant)
              (if (opt-value-eq length next-length-invariant)
                (match (opt-bce-mb-affine-pair
                  body-blocks
                  first-index
                  next-index)
                  [(OptBceMbAffinePair.Some first-smaller)
                    (OptBceMbPairCandidate.Some index first-smaller next-index)]
                  [(OptBceMbAffinePair.No) (OptBceMbPairCandidate.No)])
                (OptBceMbPairCandidate.No))]
            [(CompilerIrMaybeValue.No) (OptBceMbPairCandidate.No)])]
        [_
          (if (opt-bce-mb-pair-barrier? instr)
            (OptBceMbPairCandidate.No)
            (opt-bce-mb-pair-next
              instrs
              (+ index 1)
              body-blocks
              defs
              first-index
              length))]))))

;; --- late paired bounds checks -----------------------------------------------
;;
;; This rewrite deliberately runs only from the post-fixpoint program tail,
;; after scratch reset and immediately before late total-switch materialization.
;; At that point the exhaustive dispatch loop has its final CFG shape. Pairing
;; edits those blocks in place: it never invokes BCE, versions a loop, or clones
;; a block.
(defenum OptLateBoundsPairEntry
  (Entry i64 i64 i64 bool CompilerIrValue))

(defenum OptLateBoundsPairPlan
  (Nil)
  (Dense (Array OptLateBoundsPairEntry) i64))

(define (opt-late-bounds-pair-plan-ref
  [plans : OptLateBoundsPairPlan]
  [index : i64]) : OptLateBoundsPairEntry
  (match plans
    [(OptLateBoundsPairPlan.Nil)
      (OptLateBoundsPairEntry.Entry -1 -1 -1 false (CompilerIrValue.I64 0))]
    [(OptLateBoundsPairPlan.Dense items len)
      (array-ref items (- (- len 1) index))]))

(define (opt-late-bounds-pair-plan-tail [plans : OptLateBoundsPairPlan]) : OptLateBoundsPairPlan
  (match plans
    [(OptLateBoundsPairPlan.Nil) (OptLateBoundsPairPlan.Nil)]
    [(OptLateBoundsPairPlan.Dense items len)
      (if (<= len 1)
        (OptLateBoundsPairPlan.Nil)
        (OptLateBoundsPairPlan.Dense items (- len 1)))]))

(define (opt-late-bounds-pair-plan-cons
  [label : i64]
  [first : i64]
  [second : i64]
  [first-smaller : bool]
  [second-value : CompilerIrValue]
  [plans : OptLateBoundsPairPlan]) : OptLateBoundsPairPlan
  (let
    [entry : OptLateBoundsPairEntry
      (OptLateBoundsPairEntry.Entry
        label
        first
        second
        first-smaller
        second-value)]
    (match plans
      [(OptLateBoundsPairPlan.Nil)
        (let
          [items : (Array OptLateBoundsPairEntry)
            (array.make-array OptLateBoundsPairEntry 4)]
          (begin
            (array-set! items 0 entry)
            (OptLateBoundsPairPlan.Dense items 1)))]
      [(OptLateBoundsPairPlan.Dense items len)
        (if (< len (array-length items))
          (begin
            (array-set! items len entry)
            (OptLateBoundsPairPlan.Dense items (+ len 1)))
          (let
            [bigger : (Array OptLateBoundsPairEntry)
              (array.make-array
                OptLateBoundsPairEntry
                (opt-dense-next-capacity len))]
            [slot : i64 0]
            (begin
              (while (< slot len)
                (begin
                  (array-set! bigger slot (array-ref items slot))
                  (set! slot (+ slot 1))))
              (array-set! bigger len entry)
              (OptLateBoundsPairPlan.Dense bigger (+ len 1)))))])))

(defenum OptLateBoundsPairAt
  (No)
  (First bool CompilerIrValue)
  (Second))

(defstruct OptLateBoundsPairCollect
  (length CompilerIrMaybeValue)
  (plans OptLateBoundsPairPlan)
  (count i64))

(defenum OptLateBoundsPairResult
  (No)
  (Some CompilerIrBlockList i64))

(defenum OptLateBoundsPairPreheader
  (No)
  (Some CompilerIrBlock))

(defenum OptLateBoundsPairSubst
  (Nil)
  (Cons i64 i64 i64 (Box OptLateBoundsPairSubst)))

;; Defs the walk deletes outright rather than renaming. The substituted second
;; chain keeps a replacement value, so its readers survive under a new name; a
;; reinterpret cast that fed only the replaced first check has no reader left at
;; all once the synthesized subtraction reads the cast's source instead.
(defenum OptLateBoundsPairDrop
  (Nil)
  (Cons i64 (Box OptLateBoundsPairDrop)))

(define (opt-late-bounds-pair-selected-length?
  [selected : CompilerIrMaybeValue]
  [length : CompilerIrValue]) : bool
  (match selected
    [(CompilerIrMaybeValue.No) true]
    [(CompilerIrMaybeValue.Some found) (opt-value-eq found length)]))

(define (opt-late-bounds-pair-collect-block
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [body-blocks : CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [state : OptLateBoundsPairCollect]) : OptLateBoundsPairCollect
  (if (>= index (compiler-ir-instr-seq-count instrs))
    state
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.BoundsCheck first-index length _)
        (match (opt-bce-mb-invariant-operand body-blocks defs length)
          [(CompilerIrMaybeValue.No)
            (opt-late-bounds-pair-collect-block
              label
              instrs
              (+ index 1)
              body-blocks
              defs
              state)]
          [(CompilerIrMaybeValue.Some invariant-length)
            (if (not
              (opt-late-bounds-pair-selected-length?
                (struct-get state length)
                invariant-length))
              (opt-late-bounds-pair-collect-block
                label
                instrs
                (+ index 1)
                body-blocks
                defs
                state)
              (match (opt-bce-mb-pair-next
                instrs
                (+ index 1)
                body-blocks
                defs
                first-index
                invariant-length)
                [(OptBceMbPairCandidate.No)
                  (opt-late-bounds-pair-collect-block
                    label
                    instrs
                    (+ index 1)
                    body-blocks
                    defs
                    state)]
                [(OptBceMbPairCandidate.Some second first-smaller second-value)
                  (opt-late-bounds-pair-collect-block
                    label
                    instrs
                    (+ second 1)
                    body-blocks
                    defs
                    (OptLateBoundsPairCollect
                      (CompilerIrMaybeValue.Some invariant-length)
                      (opt-late-bounds-pair-plan-cons
                        label
                        index
                        second
                        first-smaller
                        second-value
                        (struct-get state plans))
                      (+ (struct-get state count) 1)))]))])]
      [_
        (opt-late-bounds-pair-collect-block
          label
          instrs
          (+ index 1)
          body-blocks
          defs
          state)])))

(define (opt-late-bounds-pair-collect-blocks
  [remaining : CompilerIrBlockList]
  [body-blocks : CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [state : OptLateBoundsPairCollect]) : OptLateBoundsPairCollect
  (match remaining
    [(CompilerIrBlockList.Nil) state]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (opt-late-bounds-pair-collect-blocks
            (box-get rest)
            body-blocks
            defs
            (opt-late-bounds-pair-collect-block
              label
              instrs
              0
              body-blocks
              defs
              state))])]
    [(CompilerIrBlockList.Array seq)
      (opt-late-bounds-pair-collect-blocks
        (compiler-ir-block-seq-to-list seq)
        body-blocks
        defs
        state)]))

(define (opt-late-bounds-pair-at
  [plans : OptLateBoundsPairPlan]
  [label : i64]
  [index : i64]) : OptLateBoundsPairAt
  (match plans
    [(OptLateBoundsPairPlan.Nil) (OptLateBoundsPairAt.No)]
    [(OptLateBoundsPairPlan.Dense _ _)
      (match (opt-late-bounds-pair-plan-ref plans 0)
        [(OptLateBoundsPairEntry.Entry
            item-label
            first
            second
            first-smaller
            second-value)
          (if (and (= item-label label) (= index first))
            (OptLateBoundsPairAt.First first-smaller second-value)
            (if (and (= item-label label) (= index second))
              (OptLateBoundsPairAt.Second)
              (opt-late-bounds-pair-at
                (opt-late-bounds-pair-plan-tail plans)
                label
                index)))])]))

(define (opt-late-bounds-pair-subst-env [substs : OptLateBoundsPairSubst]) : OptCopyEnv
  (match substs
    [(OptLateBoundsPairSubst.Nil) (OptCopyEnv.Nil)]
    [(OptLateBoundsPairSubst.Cons raw resolved replacement rest)
      (let
        [tail : OptCopyEnv (opt-late-bounds-pair-subst-env (box-get rest))]
        (if (= raw resolved)
          (OptCopyEnv.Cons raw (CompilerIrValue.Var replacement) (box tail))
          (OptCopyEnv.Cons
            raw
            (CompilerIrValue.Var replacement)
            (box
              (OptCopyEnv.Cons
                resolved
                (CompilerIrValue.Var replacement)
                (box tail))))))]))

(define (opt-late-bounds-pair-subst-def?
  [substs : OptLateBoundsPairSubst]
  [dst : i64]) : bool
  (match substs
    [(OptLateBoundsPairSubst.Nil) false]
    [(OptLateBoundsPairSubst.Cons raw resolved _ rest)
      (or
        (= dst raw)
        (= dst resolved)
        (opt-late-bounds-pair-subst-def? (box-get rest) dst))]))

(define (opt-late-bounds-pair-drop? [drops : OptLateBoundsPairDrop] [dst : i64]) : bool
  (match drops
    [(OptLateBoundsPairDrop.Nil) false]
    [(OptLateBoundsPairDrop.Cons var rest)
      (or (= dst var) (opt-late-bounds-pair-drop? (box-get rest) dst))]))

;; The first check's index operand is often a width-64 reinterpret cast of the
;; real counter. i64 and u64 share their representation, so the pair-min
;; subtraction may read the cast's source and let the backend fold `src - 1`
;; into one lea instead of staging the copy the cast lowers to. Bounded like the
;; other resolve helpers; any pending substitution applies at every step.
(define (opt-late-bounds-pair-cast-src
  [body-blocks : CompilerIrBlockList]
  [env : OptCopyEnv]
  [value : CompilerIrValue]
  [fuel : i64]) : CompilerIrValue
  (if (<= fuel 0)
    value
    (match value
      [(CompilerIrValue.Var var)
        (match (opt-bce-mb-find-def body-blocks var)
          [(OptBceMbMaybeInstr.No) value]
          [(OptBceMbMaybeInstr.Some instr)
            (match instr
              [(CompilerIrInstr.Cast _ src from-ty to-ty)
                (if (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
                  (match src
                    [(CompilerIrValue.Var _)
                      (opt-late-bounds-pair-cast-src
                        body-blocks
                        env
                        (opt-copy-resolve env src)
                        (- fuel 1))]
                    [_ value])
                  value)]
              [_ value])])]
      [_ value])))

;; Emit a single check at the first trap point. When the later operand is the
;; smaller one, materialize `first - 1` there, substitute it for the later
;; affine def chain, and drop that dead chain in the same walk. The combined
;; check therefore does not add per-iteration index arithmetic.
(define (opt-late-bounds-pair-rewrite-instrs
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [body-blocks : CompilerIrBlockList]
  [plans : OptLateBoundsPairPlan]
  [short-length : CompilerIrValue]
  [substs : OptLateBoundsPairSubst]
  [drops : OptLateBoundsPairDrop]
  [cell : (Array i64)]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      [env : OptCopyEnv (opt-late-bounds-pair-subst-env substs)]
      (match (opt-late-bounds-pair-at plans label index)
        [(OptLateBoundsPairAt.Second)
          (opt-late-bounds-pair-rewrite-instrs
            label
            instrs
            (+ index 1)
            body-blocks
            plans
            short-length
            substs
            drops
            cell)]
        [(OptLateBoundsPairAt.First first-smaller second-value)
          (match instr
            [(CompilerIrInstr.BoundsCheck first-index _ ok-label)
              (if first-smaller
                (compiler-ir-instr-cons
                  (CompilerIrInstr.BoundsCheck
                    (opt-copy-resolve env first-index)
                    short-length
                    ok-label)
                  (opt-late-bounds-pair-rewrite-instrs
                    label
                    instrs
                    (+ index 1)
                    body-blocks
                    plans
                    short-length
                    substs
                    drops
                    cell))
                (match second-value
                  [(CompilerIrValue.Var raw)
                    (let
                      [smaller : i64 (opt-bce-version-alloc-var cell)]
                      [resolved : i64 (opt-bce-mb-resolve body-blocks raw 16)]
                      [next-substs : OptLateBoundsPairSubst
                        (OptLateBoundsPairSubst.Cons
                          raw
                          resolved
                          smaller
                          (box substs))]
                      (compiler-ir-instr-cons
                        (CompilerIrInstr.BinOp
                          smaller
                          (CompilerIrBinOp.Sub)
                          (opt-late-bounds-pair-cast-src
                            body-blocks
                            env
                            (opt-copy-resolve env first-index)
                            4)
                          (CompilerIrValue.I64 1)
                          (AstType.I64))
                        (compiler-ir-instr-cons
                          (CompilerIrInstr.BoundsCheck
                            (CompilerIrValue.Var smaller)
                            short-length
                            ok-label)
                          (opt-late-bounds-pair-rewrite-instrs
                            label
                            instrs
                            (+ index 1)
                            body-blocks
                            plans
                            short-length
                            next-substs
                            drops
                            cell))))]
                  [_
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.BoundsCheck
                        second-value
                        short-length
                        ok-label)
                      (opt-late-bounds-pair-rewrite-instrs
                        label
                        instrs
                        (+ index 1)
                        body-blocks
                        plans
                        short-length
                        substs
                        drops
                        cell))]))]
            [_
              (compiler-ir-instr-cons
                instr
                (opt-late-bounds-pair-rewrite-instrs
                  label
                  instrs
                  (+ index 1)
                  body-blocks
                  plans
                  short-length
                  substs
                  drops
                  cell))])]
        [(OptLateBoundsPairAt.No)
          (let
            [dst : i64 (compiler-ir-instr-loop-dst-or instr (- 0 1))]
            (if (and
              (>= dst 0)
              (or
                (opt-late-bounds-pair-subst-def? substs dst)
                (opt-late-bounds-pair-drop? drops dst)))
              (opt-late-bounds-pair-rewrite-instrs
                label
                instrs
                (+ index 1)
                body-blocks
                plans
                short-length
                substs
                drops
                cell)
              (compiler-ir-instr-cons
                (opt-copy-subst-instr env instr)
                (opt-late-bounds-pair-rewrite-instrs
                  label
                  instrs
                  (+ index 1)
                  body-blocks
                  plans
                  short-length
                  substs
                  drops
                  cell))))]))))

;; `len - zext(len >= 1)` is `len - 1` on the guarded path and zero when
;; len==0. Feeding that saturated short length to the replacement check is a
;; branch-free encoding of the raw `len >= 1` conjunct: no u64 index is below
;; zero, so the len==0 case still aborts. This lets the late pass establish the
;; fact once in the existing preheader without a slow-loop clone.
(define (opt-late-bounds-pair-preheader-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [length : CompilerIrValue]
  [nonempty : i64]
  [nonempty-i64 : i64]
  [short-length : i64]) : CompilerIrInstrList
  (if (>= index last)
    (compiler-ir-instr-cons
      (CompilerIrInstr.BinOp
        nonempty
        (CompilerIrBinOp.Ge)
        length
        (CompilerIrValue.I64 1)
        (AstType.Bool))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Cast
          nonempty-i64
          (CompilerIrValue.Var nonempty)
          (AstType.Bool)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.BinOp
            short-length
            (CompilerIrBinOp.Sub)
            length
            (CompilerIrValue.Var nonempty-i64)
            (AstType.I64))
          (compiler-ir-instr-cons
            (compiler-ir-instr-seq-ref instrs last)
            (CompilerIrInstrList.Nil)))))
    (compiler-ir-instr-cons
      (compiler-ir-instr-seq-ref instrs index)
      (opt-late-bounds-pair-preheader-instrs
        instrs
        (+ index 1)
        last
        length
        nonempty
        nonempty-i64
        short-length))))

(define (opt-late-bounds-pair-preheader
  [block : CompilerIrBlock]
  [header : i64]
  [length : CompilerIrValue]
  [nonempty : i64]
  [nonempty-i64 : i64]
  [short-length : i64]) : OptLateBoundsPairPreheader
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (< count 1)
          (OptLateBoundsPairPreheader.No)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Jump target)
              (if (= target header)
                (OptLateBoundsPairPreheader.Some
                  (compiler-ir-block
                    label
                    (opt-late-bounds-pair-preheader-instrs
                      instrs
                      0
                      (- count 1)
                      length
                      nonempty
                      nonempty-i64
                      short-length)))
                (OptLateBoundsPairPreheader.No))]
            [_ (OptLateBoundsPairPreheader.No)])))]))

(define (opt-late-bounds-pair-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [body-blocks : CompilerIrBlockList]
  [preheader-label : i64]
  [rewritten-preheader : CompilerIrBlock]
  [plans : OptLateBoundsPairPlan]
  [short-length : CompilerIrValue]
  [drops : OptLateBoundsPairDrop]
  [cell : (Array i64)]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (if (= label preheader-label)
              rewritten-preheader
              (compiler-ir-block
                label
                (opt-late-bounds-pair-rewrite-instrs
                  label
                  instrs
                  0
                  body-blocks
                  plans
                  short-length
                  (OptLateBoundsPairSubst.Nil)
                  drops
                  cell)))
            (opt-late-bounds-pair-rewrite-blocks
              (box-get rest)
              body-blocks
              preheader-label
              rewritten-preheader
              plans
              short-length
              drops
              cell))])]
    [(CompilerIrBlockList.Array seq)
      (opt-late-bounds-pair-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        body-blocks
        preheader-label
        rewritten-preheader
        plans
        short-length
        drops
        cell)]))

(define (opt-late-bounds-pair-use-count [uses : (Array i64)] [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length uses)))
    (- 0 1)
    (array-ref uses var)))

(define (opt-late-bounds-pair-reinterpret-def?
  [body-blocks : CompilerIrBlockList]
  [var : i64]) : bool
  (match (opt-bce-mb-find-def body-blocks var)
    [(OptBceMbMaybeInstr.No) false]
    [(OptBceMbMaybeInstr.Some instr)
      (match instr
        [(CompilerIrInstr.Cast _ src from-ty to-ty)
          (and
            (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
            (match src
              [(CompilerIrValue.Var _) true]
              [_ false]))]
        [_ false])]))

(define (opt-late-bounds-pair-check-index
  [body-blocks : CompilerIrBlockList]
  [label : i64]
  [index : i64]) : CompilerIrMaybeValue
  (match (opt-cfg-find-block body-blocks label)
    [(OptMaybeBlock.No) (CompilerIrMaybeValue.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (or (< index 0) (>= index (compiler-ir-instr-seq-count instrs)))
            (CompilerIrMaybeValue.No)
            (match (compiler-ir-instr-seq-ref instrs index)
              [(CompilerIrInstr.BoundsCheck first-index _ _)
                (CompilerIrMaybeValue.Some first-index)]
              [_ (CompilerIrMaybeValue.No)]))])]))

;; Nothing re-runs DCE after this pass, so a cast left with no reader still
;; lowers to a register copy. Collect the casts the rewrite strands: only the
;; `first-smaller = false` plans replace their first check, and only a cast
;; whose whole-function use census is exactly that one check is provably dead
;; afterwards. Any other reader keeps the def -- the subtraction still reads
;; through the cast, it just does not get to delete it.
(define (opt-late-bounds-pair-dead-cast-add
  [body-blocks : CompilerIrBlockList]
  [uses : (Array i64)]
  [label : i64]
  [first : i64]
  [first-smaller : bool]
  [acc : OptLateBoundsPairDrop]) : OptLateBoundsPairDrop
  (if first-smaller
    acc
    (match (opt-late-bounds-pair-check-index body-blocks label first)
      [(CompilerIrMaybeValue.No) acc]
      [(CompilerIrMaybeValue.Some first-index)
        (match first-index
          [(CompilerIrValue.Var var)
            (if (and
              (opt-late-bounds-pair-reinterpret-def? body-blocks var)
              (= (opt-late-bounds-pair-use-count uses var) 1))
              (OptLateBoundsPairDrop.Cons var (box acc))
              acc)]
          [_ acc])])))

(define (opt-late-bounds-pair-dead-casts
  [body-blocks : CompilerIrBlockList]
  [uses : (Array i64)]
  [plans : OptLateBoundsPairPlan]
  [acc : OptLateBoundsPairDrop]) : OptLateBoundsPairDrop
  (match plans
    [(OptLateBoundsPairPlan.Nil) acc]
    [(OptLateBoundsPairPlan.Dense _ _)
      (match (opt-late-bounds-pair-plan-ref plans 0)
        [(OptLateBoundsPairEntry.Entry label first _ first-smaller _)
          (opt-late-bounds-pair-dead-casts
            body-blocks
            uses
            (opt-late-bounds-pair-plan-tail plans)
            (opt-late-bounds-pair-dead-cast-add
              body-blocks
              uses
              label
              first
              first-smaller
              acc))])]))

(define (opt-late-bounds-pair-try-loop
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptLateBoundsPairResult
  (let
    [body-blocks : CompilerIrBlockList (opt-natural-loop-body-blocks loop)]
    ;; Keep the late rewrite as narrow as the total-switch lesson: ordinary
    ;; loops retain byte-identical output, while the marked exhaustive dispatch
    ;; is handled just before its totality rewrite.
    (if (not (opt-bce-mb-body-has-total-enum-switch? body-blocks))
      (OptLateBoundsPairResult.No)
      (match (opt-natural-loop-preheader loop)
        [(OptLoopPreheader.No) (OptLateBoundsPairResult.No)]
        [(OptLoopPreheader.Some preheader-label)
          (let
            [defs : opt_i64_i64_map.Map
              (opt-bce-mb-collect-defs
                body-blocks
                (opt_i64_i64_map.with-capacity 64))]
            [collected : OptLateBoundsPairCollect
              (opt-late-bounds-pair-collect-blocks
                body-blocks
                body-blocks
                defs
                (OptLateBoundsPairCollect
                  (CompilerIrMaybeValue.No)
                  (OptLateBoundsPairPlan.Nil)
                  0))]
            (if (= (struct-get collected count) 0)
              (OptLateBoundsPairResult.No)
              (match (struct-get collected length)
                [(CompilerIrMaybeValue.No) (OptLateBoundsPairResult.No)]
                [(CompilerIrMaybeValue.Some length)
                  (match (opt-cfg-find-block blocks preheader-label)
                    [(OptMaybeBlock.No) (OptLateBoundsPairResult.No)]
                    [(OptMaybeBlock.Some preheader)
                      (let
                        [drops : OptLateBoundsPairDrop
                          (opt-late-bounds-pair-dead-casts
                            body-blocks
                            (opt-collect-blocks-uses-array frame blocks)
                            (struct-get collected plans)
                            (OptLateBoundsPairDrop.Nil))]
                        (match (opt-late-bounds-pair-const-short-length length)
                          [(CompilerIrMaybeValue.Some const-short-length)
                            (let
                              [cell : (Array i64) (array.make-array i64 1)]
                              [_cell : unit (array-set! cell 0 frame)]
                              (OptLateBoundsPairResult.Some
                                (opt-late-bounds-pair-rewrite-blocks
                                  blocks
                                  body-blocks
                                  preheader-label
                                  preheader
                                  (struct-get collected plans)
                                  const-short-length
                                  drops
                                  cell)
                                (array-ref cell 0)))]
                          [(CompilerIrMaybeValue.No)
                            (let
                              [cell : (Array i64) (array.make-array i64 1)]
                              [_cell : unit (array-set! cell 0 frame)]
                              [nonempty : i64 (opt-bce-version-alloc-var cell)]
                              [nonempty-i64 : i64
                                (opt-bce-version-alloc-var cell)]
                              [short-length : i64
                                (opt-bce-version-alloc-var cell)]
                              (match (opt-late-bounds-pair-preheader
                                preheader
                                (opt-natural-loop-header loop)
                                length
                                nonempty
                                nonempty-i64
                                short-length)
                                [(OptLateBoundsPairPreheader.No)
                                  (OptLateBoundsPairResult.No)]
                                [(OptLateBoundsPairPreheader.Some
                                    rewritten-preheader)
                                  (OptLateBoundsPairResult.Some
                                    (opt-late-bounds-pair-rewrite-blocks
                                      blocks
                                      body-blocks
                                      preheader-label
                                      rewritten-preheader
                                      (struct-get collected plans)
                                      (CompilerIrValue.Var short-length)
                                      drops
                                      cell)
                                    (array-ref cell 0))]))]))])])))]))))

;; A literal length needs no preheader arithmetic: `length - (length >= 1)` is a
;; compile-time constant, so the paired check takes it as an immediate and the
;; preheader keeps its original instruction sequence.
(define (opt-late-bounds-pair-const-short-length [length : CompilerIrValue]) : CompilerIrMaybeValue
  (match length
    [(CompilerIrValue.I64 count)
      (CompilerIrMaybeValue.Some
        (CompilerIrValue.I64
          (if (>= count 1)
            (- count 1)
            count)))]
    [_ (CompilerIrMaybeValue.No)]))

(define (opt-late-bounds-pair-scan-loops
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [loops : OptNaturalLoopList]) : OptLateBoundsPairResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptLateBoundsPairResult.No)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-late-bounds-pair-try-loop blocks frame loop)
        [(OptLateBoundsPairResult.Some next-blocks next-frame)
          (OptLateBoundsPairResult.Some next-blocks next-frame)]
        [(OptLateBoundsPairResult.No)
          (opt-late-bounds-pair-scan-loops blocks frame (box-get rest))])]))

(define (opt-late-bounds-pair-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  ;; Late pass outside the verified fixpoint: scan first, and only when a
  ;; rewrite candidate exists pay for verification. Rejection keeps the input.
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (match (opt-late-bounds-pair-scan-loops
        blocks
        frame
        (opt-cfg-natural-loops blocks))
        [(OptLateBoundsPairResult.No) func]
        [(OptLateBoundsPairResult.Some next-blocks next-frame)
          (let
            [candidate : CompilerIrFunction
              (CompilerIrFunction.Function
                name
                params
                ret-ty
                next-frame
                (compiler-ir-block-list-compact next-blocks))]
            ;; The rewrite extends the versioning guard's branch chain, so
            ;; the pre-rewrite CFG context does not describe the candidate;
            ;; verify against a fresh view and keep the input on rejection.
            (match (opt-verify-function candidate)
              [(ResultCompilerOptimizeVerify.Ok)
                (compiler-opt-debug-observe-function
                  type-segment-bases
                  "paired_bounds"
                  candidate)]
              [(ResultCompilerOptimizeVerify.Err _) func]))])]))

(define (opt-late-bounds-pair-function-list
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]) : CompilerIrFunctionList
  (match functions
    [(CompilerIrFunctionList.Nil) CompilerIrFunctionList.Nil]
    [(CompilerIrFunctionList.Cons func rest)
      (compiler-ir-function-cons
        (opt-late-bounds-pair-function type-segment-bases func)
        (opt-late-bounds-pair-function-list type-segment-bases (box-get rest)))]
    [(CompilerIrFunctionList.Array seq)
      (opt-late-bounds-pair-function-list
        type-segment-bases
        (compiler-ir-function-seq-to-list seq))]))

;; Derivation fold state: the guard accumulator (conditions for REMOVED
;; checks), the kept-check set, and how many checks derived -- partial
;; versioning requires at least one derivable check to make cloning pay.
(defstruct OptBceMbDerive
  (guard OptBceVersionGuardAcc)
  (keep OptBceMbKeep)
  (derived i64))

;; guard-conds output: the guard instructions + value plus the kept-check set
;; the clone must preserve (remapped) instead of dropping.
(defenum OptBceMbGuardOut
  (No)
  (Some CompilerIrInstrList CompilerIrValue OptBceMbKeep))

(define (opt-bce-mb-derive-index
  [all-blocks : CompilerIrBlockList]
  [body-blocks : CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [iphi : i64]
  [seed : CompilerIrValue]
  [bound : CompilerIrValue]
  [cell : (Array i64)]
  [index-value : CompilerIrValue]
  [length-value : CompilerIrValue]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match index-value
    [(CompilerIrValue.I64 k)
      (if (>= k 0)
        (opt-bce-version-cond
          cell
          (CompilerIrBinOp.Lt)
          (CompilerIrValue.I64 k)
          length-value
          acc)
        (OptBceVersionGuardAcc.No))]
    [(CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (cond
          [(= id iphi)
            ;; counter: [seed, bound) subset of [0, len) iff seed >= 0
            ;; (emitted once at the end) and bound <= len.
            (opt-bce-version-cond-counter-seen
              (opt-bce-version-cond
                cell
                (CompilerIrBinOp.Le)
                bound
                length-value
                acc))]
          [(not (opt-used-contains defs id))
            ;; loop-invariant index: exactly its own range check, hoisted.
            (opt-bce-version-cond
              cell
              (CompilerIrBinOp.Lt)
              (CompilerIrValue.Var id)
              length-value
              (opt-bce-version-cond
                cell
                (CompilerIrBinOp.Ge)
                (CompilerIrValue.Var id)
                (CompilerIrValue.I64 0)
                acc))]
          [else
            (match (opt-bce-mb-find-def body-blocks id)
              [(OptBceMbMaybeInstr.No) (OptBceVersionGuardAcc.No)]
              [(OptBceMbMaybeInstr.Some instr)
                (match instr
                  [(CompilerIrInstr.BinOp _ op lhs rhs _)
                    (match op
                      [(CompilerIrBinOp.BitAnd)
                        (match (opt-affine-var-const lhs rhs)
                          [(OptAffineOperands.Some _ m)
                            (if (>= m 0)
                              ;; masked index: in [0, m] whatever the source.
                              (opt-bce-version-cond
                                cell
                                (CompilerIrBinOp.Lt)
                                (CompilerIrValue.I64 m)
                                length-value
                                acc)
                              (OptBceVersionGuardAcc.No))]
                          [(OptAffineOperands.No) (OptBceVersionGuardAcc.No)])]
                      [_ (OptBceVersionGuardAcc.No)])]
                  [(CompilerIrInstr.Phi _ inputs pty)
                    ;; Bounded header phi (only header phis carry latch-edge
                    ;; inputs): same seed as the counter, back-edge value
                    ;; within {sphi, sphi+1} through any merge. The counter's
                    ;; conditions then cover its whole range.
                    (match pty
                      [(AstType.I64)
                        (match (opt-unroll-split-phi-inputs inputs latch)
                          [(OptUnrollPhiSplit.Split init back pred-label)
                            (if (and
                              (= pred-label preheader)
                              (opt-bce-mb-seeds-match? all-blocks seed init)
                              (opt-bce-mb-bounded-value? body-blocks id back 8))
                              (opt-bce-version-cond-counter-seen
                                (opt-bce-version-cond
                                  cell
                                  (CompilerIrBinOp.Le)
                                  bound
                                  length-value
                                  acc))
                              (OptBceVersionGuardAcc.No))]
                          [(OptUnrollPhiSplit.No) (OptBceVersionGuardAcc.No)])]
                      [_ (OptBceVersionGuardAcc.No)])]
                  [_ (OptBceVersionGuardAcc.No)])])]))]
    [_ (OptBceVersionGuardAcc.No)]))

(define (opt-bce-mb-derive-block
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [all-blocks : CompilerIrBlockList]
  [body-blocks : CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [iphi : i64]
  [seed : CompilerIrValue]
  [bound : CompilerIrValue]
  [cell : (Array i64)]
  [state : OptBceMbDerive]) : OptBceMbDerive
  (if (>= index (compiler-ir-instr-seq-count instrs))
    state
    (opt-bce-mb-derive-block
      label
      instrs
      (+ index 1)
      all-blocks
      body-blocks
      defs
      latch
      preheader
      iphi
      seed
      bound
      cell
      (match (compiler-ir-instr-seq-ref instrs index)
        [(CompilerIrInstr.BoundsCheck index-value length-value _)
          (match (opt-bce-mb-invariant-operand body-blocks defs length-value)
            [(CompilerIrMaybeValue.Some length-invariant)
              (let
                [derived-guard : OptBceVersionGuardAcc
                  (opt-bce-mb-derive-index
                    all-blocks
                    body-blocks
                    defs
                    latch
                    preheader
                    iphi
                    seed
                    bound
                    cell
                    index-value
                    length-invariant
                    (struct-get state guard))]
                (match derived-guard
                  [(OptBceVersionGuardAcc.No)
                    ;; Underivable: the check STAYS (remapped) in the fast
                    ;; clone instead of rejecting the whole loop.
                    (OptBceMbDerive
                      (struct-get state guard)
                      (opt-bce-mb-keep-cons label index (struct-get state keep))
                      (struct-get state derived))]
                  [(OptBceVersionGuardAcc.Some _ _ _)
                    (OptBceMbDerive
                      derived-guard
                      (struct-get state keep)
                      (+ (struct-get state derived) 1))]))]
            [(CompilerIrMaybeValue.No)
              (OptBceMbDerive
                (struct-get state guard)
                (opt-bce-mb-keep-cons label index (struct-get state keep))
                (struct-get state derived))])]
        [_ state]))))

(define (opt-bce-mb-derive-blocks
  [remaining : CompilerIrBlockList]
  [all-blocks : CompilerIrBlockList]
  [body-blocks : CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [iphi : i64]
  [seed : CompilerIrValue]
  [bound : CompilerIrValue]
  [cell : (Array i64)]
  [state : OptBceMbDerive]) : OptBceMbDerive
  (match remaining
    [(CompilerIrBlockList.Nil) state]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (opt-bce-mb-derive-blocks
            (box-get rest)
            all-blocks
            body-blocks
            defs
            latch
            preheader
            iphi
            seed
            bound
            cell
            (opt-bce-mb-derive-block
              label
              instrs
              0
              all-blocks
              body-blocks
              defs
              latch
              preheader
              iphi
              seed
              bound
              cell
              state))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-derive-blocks
        (compiler-ir-block-seq-to-list seq)
        all-blocks
        body-blocks
        defs
        latch
        preheader
        iphi
        seed
        bound
        cell
        state)]))

(define (opt-bce-mb-guard-conds
  [all-blocks : CompilerIrBlockList]
  [shape : OptBceMbShape]
  [defs : opt_i64_i64_map.Map]
  [cell : (Array i64)]) : OptBceMbGuardOut
  (let
    [dr : OptBceMbDerive
      (opt-bce-mb-derive-blocks
        (struct-get shape body-blocks)
        all-blocks
        (struct-get shape body-blocks)
        defs
        (struct-get shape latch)
        (struct-get shape preheader)
        (struct-get shape iphi)
        (struct-get shape seed)
        (struct-get shape bound)
        cell
        (OptBceMbDerive
          (OptBceVersionGuardAcc.Some
            (CompilerIrInstrList.Nil)
            (CompilerIrValueList.Nil)
            false)
          (OptBceMbKeep.Nil)
          0))]
    (if (= (struct-get dr derived) 0)
      ;; No removable check: cloning the loop would only duplicate it.
      (OptBceMbGuardOut.No)
      (match (opt-bce-version-guard-finish
        (struct-get shape seed)
        (struct-get shape bound)
        cell
        (struct-get dr guard))
        [(OptBceVersionGuardResult.No) (OptBceMbGuardOut.No)]
        [(OptBceVersionGuardResult.Some guard-instrs guard-value)
          (OptBceMbGuardOut.Some guard-instrs guard-value (struct-get dr keep))]))))

;; --- fast-clone emission --------------------------------------------------------
(define (opt-bce-mb-fast-label [body-labels : OptLabelSet] [label : i64]) : i64
  (if (opt-label-contains body-labels label)
    (compiler-ir-label
      (string.append (compiler-ir-label-text label) "__bce_fast"))
    label))

;; Pass A: allocate a fresh id for every def in the loop BEFORE any clone
;; substitutes (loop-carried references cross blocks in both directions).
(define (opt-bce-mb-alloc-defs-instrs!
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]) : unit
  (if (>= index (compiler-ir-instr-seq-count instrs))
    unit
    (let
      [dst : i64 (compiler-ir-instr-seq-loop-dst-or instrs index (- 0 1))]
      (begin
        (if (>= dst 0)
          (begin
            (opt-unroll-clone-dst remap cell dst)
            unit)
          unit)
        (opt-bce-mb-alloc-defs-instrs! instrs (+ index 1) remap cell)))))

(define (opt-bce-mb-alloc-defs!
  [blocks : CompilerIrBlockList]
  [remap : (Array CompilerIrValue)]
  [cell : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (opt-bce-mb-alloc-defs-instrs! instrs 0 remap cell)
            (opt-bce-mb-alloc-defs! (box-get rest) remap cell))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-alloc-defs! (compiler-ir-block-seq-to-list seq) remap cell)]))

(define (opt-bce-mb-remap-dst [remap : (Array CompilerIrValue)] [dst : i64]) : i64
  (match (opt-unroll-subst-value remap (CompilerIrValue.Var dst))
    [(CompilerIrValue.Var fresh) fresh]
    [_ dst]))

(define (opt-bce-mb-clone-switch-cases-acc
  [cases : CompilerIrSwitchCaseList]
  [body-labels : OptLabelSet]
  [acc : CompilerIrSwitchCaseList]) : CompilerIrSwitchCaseList
  (match (compiler-ir-switch-case-list-force-cons cases)
    [(CompilerIrSwitchCaseList.Nil) acc]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case tag label)
          (opt-bce-mb-clone-switch-cases-acc
            (box-get rest)
            body-labels
            (compiler-ir-switch-case-cons-linked
              tag
              (opt-bce-mb-fast-label body-labels label)
              acc))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-bce-mb-clone-switch-cases-acc
        (compiler-ir-switch-case-seq-to-list seq)
        body-labels
        acc)]))

(define (opt-bce-mb-clone-switch-cases
  [cases : CompilerIrSwitchCaseList]
  [body-labels : OptLabelSet]) : CompilerIrSwitchCaseList
  (compiler-ir-switch-case-list-compact-reversed
    (opt-bce-mb-clone-switch-cases-acc
      cases
      body-labels
      CompilerIrSwitchCaseList.Nil)))

(define (opt-bce-mb-clone-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [remap : (Array CompilerIrValue)]
  [body-labels : OptLabelSet]
  [preheader : i64]
  [guard-label : i64]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-clone-phi-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        remap
        body-labels
        preheader
        guard-label)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        (opt-unroll-subst-value remap value)
        ;; only header phis carry a preheader input: it now comes from the
        ;; guard; every other loop-edge input comes from the fast clone.
        (if (= label preheader)
          guard-label
          (opt-bce-mb-fast-label body-labels label))
        (opt-bce-mb-clone-phi-inputs
          (box-get rest)
          remap
          body-labels
          preheader
          guard-label))]))

(define (opt-bce-mb-clone-instr
  [remap : (Array CompilerIrValue)]
  [body-labels : OptLabelSet]
  [all-labels : OptLabelSet]
  [preheader : i64]
  [guard-label : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (CompilerIrInstr.Mov
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (CompilerIrInstr.Cast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (CompilerIrInstr.Bitcast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (CompilerIrInstr.BinOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap lhs)
        (opt-unroll-subst-value remap rhs)
        ty)]
    [(CompilerIrInstr.UnOp dst op src ty)
      (CompilerIrInstr.UnOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap src)
        ty)]
    [(CompilerIrInstr.Gep dst base offset ty)
      (CompilerIrInstr.Gep
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap offset)
        ty)]
    [(CompilerIrInstr.Load dst src ty)
      (CompilerIrInstr.Load
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(CompilerIrInstr.StorePtr ptr value ty)
      (CompilerIrInstr.StorePtr
        (opt-unroll-subst-value remap ptr)
        (opt-unroll-subst-value remap value)
        ty)]
    [(CompilerIrInstr.Phi dst inputs ty)
      (CompilerIrInstr.Phi
        (opt-bce-mb-remap-dst remap dst)
        (opt-bce-mb-clone-phi-inputs
          inputs
          remap
          body-labels
          preheader
          guard-label)
        ty)]
    [(CompilerIrInstr.Jump target)
      (CompilerIrInstr.Jump (opt-bce-mb-fast-label body-labels target))]
    [(CompilerIrInstr.Branch cond then-label else-label)
      (CompilerIrInstr.Branch
        (opt-unroll-subst-value remap cond)
        (opt-bce-mb-fast-label body-labels then-label)
        (opt-bce-mb-fast-label body-labels else-label))]
    [(CompilerIrInstr.Switch index base cases default-label)
      (CompilerIrInstr.Switch
        (opt-unroll-subst-value remap index)
        base
        (opt-bce-mb-clone-switch-cases cases body-labels)
        (opt-bce-mb-fast-label body-labels default-label))]
    ;; A kept (underivable) check: remap operands and the ok edge. An ok-label
    ;; naming a real loop block remaps to its fast clone; one naming a real
    ;; block OUTSIDE the loop stays shared; anything else is a synthetic
    ;; mid-block continuation label the backend re-emits at the check site, so
    ;; it must be uniquified per clone or the slow and fast blocks define it
    ;; twice.
    [(CompilerIrInstr.BoundsCheck index length ok-label)
      (CompilerIrInstr.BoundsCheck
        (opt-unroll-subst-value remap index)
        (opt-unroll-subst-value remap length)
        (if (opt-label-contains body-labels ok-label)
          (opt-bce-mb-fast-label body-labels ok-label)
          (if (opt-label-contains all-labels ok-label)
            ok-label
            (compiler-ir-label
              (string.append (compiler-ir-label-text ok-label) "__bce_fast")))))]
    ;; unreachable: the shape scan whitelisted every loop instruction
    [_ instr]))

;; Every block label in the function: a kept check's ok-label that names a
;; real block outside the loop must NOT be renamed, while a synthetic
;; mid-block continuation label (no such block exists) MUST be uniquified.
(define (opt-bce-mb-all-labels-from
  [blocks : CompilerIrBlockList]
  [acc : OptLabelSet]) : OptLabelSet
  (match blocks
    [(CompilerIrBlockList.Nil) acc]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (opt-bce-mb-all-labels-from (box-get rest) (opt-label-add acc label))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-all-labels-from (compiler-ir-block-seq-to-list seq) acc)]))

;; Pass B: clone a loop's instructions, dropping every BoundsCheck the guard
;; proved non-failing and remapping the kept underivable ones (partial
;; versioning: the fast clone is not necessarily check-free).
(define (opt-bce-mb-clone-instrs
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [remap : (Array CompilerIrValue)]
  [body-labels : OptLabelSet]
  [all-labels : OptLabelSet]
  [preheader : i64]
  [guard-label : i64]
  [keep : OptBceMbKeep]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(CompilerIrInstr.BoundsCheck _ _ _)
          (if (opt-bce-mb-keep-contains? keep label index)
            (compiler-ir-instr-cons
              (opt-bce-mb-clone-instr
                remap
                body-labels
                all-labels
                preheader
                guard-label
                instr)
              (opt-bce-mb-clone-instrs
                label
                instrs
                (+ index 1)
                remap
                body-labels
                all-labels
                preheader
                guard-label
                keep))
            (opt-bce-mb-clone-instrs
              label
              instrs
              (+ index 1)
              remap
              body-labels
              all-labels
              preheader
              guard-label
              keep))]
        [_
          (compiler-ir-instr-cons
            (opt-bce-mb-clone-instr
              remap
              body-labels
              all-labels
              preheader
              guard-label
              instr)
            (opt-bce-mb-clone-instrs
              label
              instrs
              (+ index 1)
              remap
              body-labels
              all-labels
              preheader
              guard-label
              keep))]))))

(define (opt-bce-mb-clone-blocks
  [blocks : CompilerIrBlockList]
  [remap : (Array CompilerIrValue)]
  [body-labels : OptLabelSet]
  [all-labels : OptLabelSet]
  [preheader : i64]
  [guard-label : i64]
  [keep : OptBceMbKeep]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (compiler-ir-block
              (compiler-ir-label
                (string.append (compiler-ir-label-text label) "__bce_fast"))
              (opt-bce-mb-clone-instrs
                label
                instrs
                0
                remap
                body-labels
                all-labels
                preheader
                guard-label
                keep))
            (opt-bce-mb-clone-blocks
              (box-get rest)
              remap
              body-labels
              all-labels
              preheader
              guard-label
              keep))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-clone-blocks
        (compiler-ir-block-seq-to-list seq)
        remap
        body-labels
        all-labels
        preheader
        guard-label
        keep)]))

;; --- rewrite --------------------------------------------------------------------
;; Extend outside phis: every input carried on a loop edge gains a parallel
;; input carrying the fast clone's remapped value on the fast edge.
(define (opt-bce-mb-extend-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [body-labels : OptLabelSet]
  [remap : (Array CompilerIrValue)]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-extend-phi-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        body-labels
        remap)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : CompilerIrPhiInputList
          (opt-bce-mb-extend-phi-inputs (box-get rest) body-labels remap)]
        (if (opt-label-contains body-labels label)
          (compiler-ir-phi-input-cons
            value
            label
            (compiler-ir-phi-input-cons
              (opt-unroll-subst-value remap value)
              (compiler-ir-label
                (string.append (compiler-ir-label-text label) "__bce_fast"))
              tail))
          (compiler-ir-phi-input-cons value label tail)))]))

(define (opt-bce-mb-extend-exit-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [body-labels : OptLabelSet]
  [remap : (Array CompilerIrValue)]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (compiler-ir-instr-cons
        (match instr
          [(CompilerIrInstr.Phi dst inputs ty)
            (CompilerIrInstr.Phi
              dst
              (opt-bce-mb-extend-phi-inputs inputs body-labels remap)
              ty)]
          [_ instr])
        (opt-bce-mb-extend-exit-instrs instrs (+ index 1) body-labels remap)))))

(define (opt-bce-mb-blocks-cons-onto
  [fast-blocks : CompilerIrBlockList]
  [tail : CompilerIrBlockList]) : CompilerIrBlockList
  (match fast-blocks
    [(CompilerIrBlockList.Nil) tail]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        block
        (opt-bce-mb-blocks-cons-onto (box-get rest) tail))]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-blocks-cons-onto (compiler-ir-block-seq-to-list seq) tail)]))

(define (opt-bce-mb-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [shape : OptBceMbShape]
  [guard-block : CompilerIrBlock]
  [fast-blocks : CompilerIrBlockList]
  [remap : (Array CompilerIrValue)]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [tail : CompilerIrBlockList
              (opt-bce-mb-rewrite-blocks
                (box-get rest)
                shape
                guard-block
                fast-blocks
                remap)]
            (cond
              [(= label (struct-get shape header))
                ;; guard + fast group immediately before the slow header: a
                ;; fallthrough preheader lands on the guard, and the fast
                ;; group preserves loop order for intra-loop fallthroughs.
                (compiler-ir-block-cons
                  guard-block
                  (opt-bce-mb-blocks-cons-onto
                    fast-blocks
                    (compiler-ir-block-cons
                      (compiler-ir-block
                        label
                        (opt-relabel-phi-instrs
                          instrs
                          0
                          (struct-get shape preheader)
                          (compiler-ir-label
                            (string.append
                              (compiler-ir-label-text (struct-get shape header))
                              "__bce_guard"))))
                      tail)))]
              [(= label (struct-get shape preheader))
                (compiler-ir-block-cons
                  (compiler-ir-block
                    label
                    (opt-unroll-retarget-instrs
                      instrs
                      0
                      (struct-get shape header)
                      (compiler-ir-label
                        (string.append
                          (compiler-ir-label-text (struct-get shape header))
                          "__bce_guard"))))
                  tail)]
              [(opt-label-contains (struct-get shape body-labels) label)
                (compiler-ir-block-cons block tail)]
              [else
                (compiler-ir-block-cons
                  (compiler-ir-block
                    label
                    (opt-bce-mb-extend-exit-instrs
                      instrs
                      0
                      (struct-get shape body-labels)
                      remap))
                  tail)]))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        shape
        guard-block
        fast-blocks
        remap)]))

;; --- fast-exit check specialization -------------------------------------------
;;
;; A versioned loop's exit block is shared: the edge that skips the loop, the
;; slow checked loop, and the fast check-free clone all arrive there, so a
;; BoundsCheck in it must stay for the arrivals that prove nothing (the skip
;; edge's value is entirely unchecked). On the fast arrivals the exit value
;; of a bounded header phi is provably in range: it stays within
;; [seed, scan] on every executed iteration, the +1 counter exits exactly at
;; its bound, a strict BoundsCheck(bound, len) dominating the preheader gives
;; bound < len, and the guard's seed >= 0 condition gives value >= 0. When
;; every fast-latch input of the checked phi is such a bounded value, give
;; the fast arrivals their own copy of the exit block without the check;
;; every other arrival keeps the original checked block.
;; Fast-clone labels of the shape's body labels.
(define (opt-bce-mb-fast-labels-from [labels : OptLabelSet] [acc : OptLabelSet]) : OptLabelSet
  (match labels
    [(OptLabelSet.Nil) acc]
    [(OptLabelSet.Dense _ _)
      (opt-bce-mb-fast-labels-from
        (opt-label-tail labels)
        (opt-label-add
          acc
          (compiler-ir-label
            (string.append
              (compiler-ir-label-text (opt-label-ref labels 0))
              "__bce_fast"))))]))

;; Is `var` defined by a Phi instruction in this block's instruction seq?
(define (opt-bce-mb-block-phi-var?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi dst _ _)
        (if (= dst var)
          true
          (opt-bce-mb-block-phi-var? instrs (+ index 1) var))]
      [_ (opt-bce-mb-block-phi-var? instrs (+ index 1) var)])))

;; Is `var` the dst of a Cast in this block whose source is a phi defined here?
;; The phi var feeding `var`, when `var` is a phi of this block or a cast of
;; one; -1 otherwise.
(define (opt-bce-mb-phi-src-of [instrs : CompilerIrInstrSeq] [var : i64]) : i64
  (if (opt-bce-mb-block-phi-var? instrs 0 var)
    var
    (let
      [walk : i64 0]
      [found : i64 -1]
      (begin
        (while (< walk (compiler-ir-instr-seq-count instrs))
          (begin
            (match (compiler-ir-instr-seq-ref instrs walk)
              [(CompilerIrInstr.Cast dst src _ _)
                (match src
                  [(CompilerIrValue.Var v)
                    (if (and (= dst var) (opt-bce-mb-block-phi-var? instrs 0 v))
                      (set! found v)
                      unit)]
                  [_ unit])]
              [_ unit])
            (set! walk (+ walk 1))))
        found))))

(defenum OptBceMbExitCheck
  (No)
  (Some i64 i64 CompilerIrValue))

;; The first BoundsCheck in this block whose index is a phi defined here (or
;; a cast of one): (check position, phi var, length).
(define (opt-bce-mb-find-exit-check [instrs : CompilerIrInstrSeq] [index : i64]) : OptBceMbExitCheck
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptBceMbExitCheck.No)
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.BoundsCheck idx len _)
        (match idx
          [(CompilerIrValue.Var v)
            (let
              [phi-var : i64 (opt-bce-mb-phi-src-of instrs v)]
              (if (>= phi-var 0)
                (OptBceMbExitCheck.Some index phi-var len)
                (opt-bce-mb-find-exit-check instrs (+ index 1))))]
          [_ (opt-bce-mb-find-exit-check instrs (+ index 1))])]
      [_ (opt-bce-mb-find-exit-check instrs (+ index 1))])))

;; Canonical spelling of a value for cross-block comparison: vars resolved
;; through the block list's single-def Mov chains, and through same-width
;; int-to-int casts (a bit-preserving reinterpret, as in the bounds_dom
;; canonicalization).
(define (opt-bce-mb-canon-value
  [blocks : CompilerIrBlockList]
  [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var v)
      (let
        [resolved : i64 (opt-bce-mb-resolve blocks v 16)]
        (match (opt-bce-mb-find-def blocks resolved)
          [(OptBceMbMaybeInstr.No) (CompilerIrValue.Var resolved)]
          [(OptBceMbMaybeInstr.Some instr)
            (match instr
              [(CompilerIrInstr.Cast _ src from-ty to-ty)
                (if (and
                  (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
                  (match src
                    [(CompilerIrValue.Var _) true]
                    [_ false]))
                  (opt-bce-mb-canon-value blocks src)
                  (CompilerIrValue.Var resolved))]
              [_ (CompilerIrValue.Var resolved)])]))]
    [_ value]))

;; The bounded header phi of the loop: a header phi, not the counter, whose
;; loop-entry input (from the preheader, or from the guard after the rewrite
;; has spliced it in) is the counter's seed. -1 when none matches.
(define (opt-bce-mb-find-bounded-phi-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [blocks : CompilerIrBlockList]
  [preheader : i64]
  [guard-label : i64]
  [cseed : CompilerIrValue]
  [iphi : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    -1
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi dst inputs _)
        (if (and
          (not (= dst iphi))
          (let
            [walk : CompilerIrPhiInputList inputs]
            [hit : bool false]
            (while (not hit)
              (match (compiler-ir-phi-input-list-force-cons walk)
                [(CompilerIrPhiInputList.Nil) (set! hit true)]
                [(CompilerIrPhiInputList.Array seq)
                  (begin
                    (set! walk (compiler-ir-phi-input-seq-to-list seq))
                    unit)]
                [(CompilerIrPhiInputList.Cons value label rest)
                  (if (and
                    (or (= label preheader) (= label guard-label))
                    (opt-value-eq (opt-bce-mb-canon-value blocks value) cseed))
                    (set! hit true)
                    (set! walk (box-get rest)))]))
            hit))
          dst
          (opt-bce-mb-find-bounded-phi-instrs
            instrs
            (+ index 1)
            blocks
            preheader
            guard-label
            cseed
            iphi))]
      [_
        (opt-bce-mb-find-bounded-phi-instrs
          instrs
          (+ index 1)
          blocks
          preheader
          guard-label
          cseed
          iphi)])))

(define (opt-bce-mb-find-bounded-phi
  [body-blocks : CompilerIrBlockList]
  [blocks : CompilerIrBlockList]
  [header : i64]
  [preheader : i64]
  [guard-label : i64]
  [cseed : CompilerIrValue]
  [iphi : i64]) : i64
  (match body-blocks
    [(CompilerIrBlockList.Nil) -1]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (if (= label header)
            (opt-bce-mb-find-bounded-phi-instrs
              instrs
              0
              blocks
              preheader
              guard-label
              cseed
              iphi)
            (opt-bce-mb-find-bounded-phi
              (box-get rest)
              blocks
              header
              preheader
              guard-label
              cseed
              iphi))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-find-bounded-phi
        (compiler-ir-block-seq-to-list seq)
        blocks
        header
        preheader
        guard-label
        cseed
        iphi)]))

;; Every fast-latch input of the phi is a bounded value in the fast clone
;; (stays within [seed, scan] each executed iteration). Counts fast and
;; non-fast inputs; the split needs at least one of each.
(define (opt-bce-mb-exit-phi-inputs-scan
  [inputs : CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [fast-blocks : CompilerIrBlockList]
  [fast-bounded : i64]
  [fast-seen : i64]
  [other-seen : i64]
  [provable : bool]) : i64
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil)
      (if (and provable (> fast-seen 0) (> other-seen 0))
        1
        0)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-exit-phi-inputs-scan
        (compiler-ir-phi-input-seq-to-list seq)
        fast-labels
        fast-blocks
        fast-bounded
        fast-seen
        other-seen
        provable)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains fast-labels label)
        (opt-bce-mb-exit-phi-inputs-scan
          (box-get rest)
          fast-labels
          fast-blocks
          fast-bounded
          (+ fast-seen 1)
          other-seen
          (and
            provable
            (>= fast-bounded 0)
            (opt-bce-mb-bounded-value? fast-blocks fast-bounded value 16)))
        (opt-bce-mb-exit-phi-inputs-scan
          (box-get rest)
          fast-labels
          fast-blocks
          fast-bounded
          fast-seen
          (+ other-seen 1)
          provable))]))

;; The phi inputs that belong to the fast latch edges (kept in the copy).
(define (opt-bce-mb-exit-seed-nonnegative?
  [guard-instrs : CompilerIrInstrList]
  [blocks : CompilerIrBlockList]
  [seed : CompilerIrValue]
  [iphi : i64]) : bool
  (match seed
    [(CompilerIrValue.I64 value) (>= value 0)]
    [_
      (let
        [cseed : CompilerIrValue (opt-bce-mb-canon-value blocks seed)]
        (match guard-instrs
          [(CompilerIrInstrList.Nil) false]
          [(CompilerIrInstrList.Cons instr rest)
            (match instr
              [(CompilerIrInstr.BinOp _ op lhs rhs _)
                (if (and
                  (or
                    (opt-binop-eq op (CompilerIrBinOp.Ge))
                    (opt-binop-eq op (CompilerIrBinOp.Gt)))
                  (let
                    [clhs : CompilerIrValue (opt-bce-mb-canon-value blocks lhs)]
                    (or
                      (opt-value-eq clhs cseed)
                      (opt-value-eq clhs (CompilerIrValue.Var iphi))))
                  (match rhs
                    [(CompilerIrValue.I64 v)
                      (if (opt-binop-eq op (CompilerIrBinOp.Ge))
                        (>= v 0)
                        (>= v -1))]
                    [_ false]))
                  true
                  (opt-bce-mb-exit-seed-nonnegative?
                    (box-get rest)
                    blocks
                    cseed
                    iphi))]
              [_
                (opt-bce-mb-exit-seed-nonnegative?
                  (box-get rest)
                  blocks
                  cseed
                  iphi)])]))]))

;; Does any instruction in this block's terminator mention `label`?
(define (opt-bce-mb-block-targets?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [label : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Branch _ true-label false-label)
        (or
          (= true-label label)
          (= false-label label)
          (opt-bce-mb-block-targets? instrs (+ index 1) label))]
      [(CompilerIrInstr.Jump target)
        (or
          (= target label)
          (opt-bce-mb-block-targets? instrs (+ index 1) label))]
      [_ (opt-bce-mb-block-targets? instrs (+ index 1) label)])))

;; Labels of blocks whose terminator mentions `label`.
(define (opt-bce-mb-preds-from
  [blocks : CompilerIrBlockList]
  [label : i64]
  [acc : OptLabelSet]) : OptLabelSet
  (match blocks
    [(CompilerIrBlockList.Nil) acc]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block block-label instrs)
          (if (opt-bce-mb-block-targets? instrs 0 label)
            (opt-bce-mb-preds-from
              (box-get rest)
              label
              (opt-label-add acc block-label))
            (opt-bce-mb-preds-from (box-get rest) label acc))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-preds-from (compiler-ir-block-seq-to-list seq) label acc)]))

;; A strict BoundsCheck(bound, len) in this block?
(define (opt-bce-mb-block-has-strict-check?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [blocks : CompilerIrBlockList]
  [bound : CompilerIrValue]
  [len : CompilerIrValue]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.BoundsCheck idx ilen _)
        (if (and
          (opt-value-eq
            (opt-bce-mb-canon-value blocks idx)
            (opt-bce-mb-canon-value blocks bound))
          (opt-value-eq
            (opt-bce-mb-canon-value blocks ilen)
            (opt-bce-mb-canon-value blocks len)))
          true
          (opt-bce-mb-block-has-strict-check?
            instrs
            (+ index 1)
            blocks
            bound
            len))]
      [_
        (opt-bce-mb-block-has-strict-check? instrs (+ index 1) blocks bound len)])))

;; Walk the single-predecessor chain backward from `label`; a block on the
;; chain dominates it. True when a strict BoundsCheck(bound, len) appears.
(define (opt-bce-mb-strict-check-chain?
  [blocks : CompilerIrBlockList]
  [label : i64]
  [bound : CompilerIrValue]
  [len : CompilerIrValue]
  [fuel : i64]) : bool
  (if (<= fuel 0)
    false
    (let
      [instrs : CompilerIrInstrSeq (opt-bce-mb-find-block-seq blocks label)]
      (if (compiler-ir-instr-seq-empty? instrs)
        false
        (if (opt-bce-mb-block-has-strict-check? instrs 0 blocks bound len)
          true
          (let
            [preds : OptLabelSet
              (opt-bce-mb-preds-from blocks label (OptLabelSet.Nil))]
            (if (= (opt-label-count preds) 1)
              (opt-bce-mb-strict-check-chain?
                blocks
                (opt-label-ref preds 0)
                bound
                len
                (- fuel 1))
              false)))))))

;; Retarget every fast-clone block's terminators from the shared exit to the
;; new fast exit.
(define (opt-bce-mb-block-phi-inputs
  [instrs : CompilerIrInstrSeq]
  [phi-var : i64]) : CompilerIrPhiInputList
  (let
    [walk : i64 0]
    [found : CompilerIrPhiInputList (CompilerIrPhiInputList.Nil)]
    (begin
      (while (< walk (compiler-ir-instr-seq-count instrs))
        (begin
          (match (compiler-ir-instr-seq-ref instrs walk)
            [(CompilerIrInstr.Phi dst inputs _)
              (if (= dst phi-var)
                (set! found inputs)
                unit)]
            [_ unit])
          (set! walk (+ walk 1))))
      found)))

(define (opt-bce-mb-find-block-seq [blocks : CompilerIrBlockList] [label : i64]) : CompilerIrInstrSeq
  (match blocks
    [(CompilerIrBlockList.Nil)
      (compiler-ir-instr-seq-from-list (CompilerIrInstrList.Nil))]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block block-label instrs)
          (if (= block-label label)
            instrs
            (opt-bce-mb-find-block-seq (box-get rest) label))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-find-block-seq (compiler-ir-block-seq-to-list seq) label)]))

;; Top-level drive: find the first outside block whose checked exit phi is
;; provably in range on every fast arrival and split it. `blocks` is the
;; walk tail; `all-blocks` is the full rewritten function for
;; canonicalization, predecessor scans, and the strict-check chain.
(defenum OptBceMbExitSplit
  (No)
  (Some i64 i64 i64 CompilerIrValue OptLabelSet))

;; Find the first outside block whose checked exit phi is provably in range
;; on every fast arrival. `blocks` is the walk tail; `all-blocks` is the
;; full rewritten function for canonicalization, predecessor scans, and the
;; strict-check chain.
(define (opt-bce-mb-find-exit-split
  [blocks : CompilerIrBlockList]
  [all-blocks : CompilerIrBlockList]
  [shape : OptBceMbShape]
  [fast-blocks : CompilerIrBlockList]
  [fast-bounded : i64]
  [guard-instrs : CompilerIrInstrList]) : OptBceMbExitSplit
  (match blocks
    [(CompilerIrBlockList.Nil) (OptBceMbExitSplit.No)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [body-labels : OptLabelSet (struct-get shape body-labels)]
            (if (or
              (opt-label-contains body-labels label)
              (= label (struct-get shape header))
              (= label (struct-get shape preheader))
              (=
                label
                (compiler-ir-label
                  (string.append
                    (compiler-ir-label-text (struct-get shape header))
                    "__bce_guard")))
              (opt-label-contains
                (opt-bce-mb-fast-labels-from body-labels (OptLabelSet.Nil))
                label))
              (opt-bce-mb-find-exit-split
                (box-get rest)
                all-blocks
                shape
                fast-blocks
                fast-bounded
                guard-instrs)
              (match (opt-bce-mb-find-exit-check instrs 0)
                [(OptBceMbExitCheck.No)
                  (opt-bce-mb-find-exit-split
                    (box-get rest)
                    all-blocks
                    shape
                    fast-blocks
                    fast-bounded
                    guard-instrs)]
                [(OptBceMbExitCheck.Some check-pos phi-var len)
                  (let
                    [fast-labels : OptLabelSet
                      (opt-bce-mb-fast-labels-from
                        body-labels
                        (OptLabelSet.Nil))]
                    [inputs : CompilerIrPhiInputList
                      (opt-bce-mb-block-phi-inputs instrs phi-var)]
                    (if (and
                      (=
                        (opt-bce-mb-exit-phi-inputs-scan
                          inputs
                          fast-labels
                          fast-blocks
                          fast-bounded
                          0
                          0
                          true)
                        1)
                      (opt-bce-mb-exit-seed-nonnegative?
                        guard-instrs
                        all-blocks
                        (struct-get shape seed)
                        (struct-get shape iphi))
                      (opt-bce-mb-strict-check-chain?
                        all-blocks
                        (struct-get shape preheader)
                        (struct-get shape bound)
                        len
                        16))
                      (OptBceMbExitSplit.Some
                        label
                        check-pos
                        phi-var
                        len
                        fast-labels)
                      (opt-bce-mb-find-exit-split
                        (box-get rest)
                        all-blocks
                        shape
                        fast-blocks
                        fast-bounded
                        guard-instrs)))])))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-find-exit-split
        (compiler-ir-block-seq-to-list seq)
        all-blocks
        shape
        fast-blocks
        fast-bounded
        guard-instrs)]))

;; Split the first qualifying exit block over the whole rewritten function.
;; Walk the block list and rewrite the exit block via the sink; the
;; caller-provided check blocks land immediately before it.
(define (opt-bce-mb-sink-exit-block-list
  [blocks : CompilerIrBlockList]
  [exit-label : i64]
  [check-pos : i64]
  [phi-var : i64]
  [fast-labels : OptLabelSet]
  [check-blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (if (= label exit-label)
            (opt-bce-mb-blocks-cons-onto
              check-blocks
              (compiler-ir-block-cons
                (compiler-ir-block
                  label
                  (opt-bce-mb-sink-exit-instrs
                    instrs
                    0
                    check-pos
                    phi-var
                    fast-labels
                    exit-label))
                (box-get rest)))
            (compiler-ir-block-cons
              block
              (opt-bce-mb-sink-exit-block-list
                (box-get rest)
                exit-label
                check-pos
                phi-var
                fast-labels
                check-blocks)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-sink-exit-block-list
        (compiler-ir-block-seq-to-list seq)
        exit-label
        check-pos
        phi-var
        fast-labels
        check-blocks)]))

;; The exit block's instructions minus the check (and its now-unused
;; cast): every other instruction is preserved as-is.
(define (opt-bce-mb-sink-exit-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [check-pos : i64]
  [phi-var : i64]
  [fast-labels : OptLabelSet]
  [exit-label : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (if (= index check-pos)
      (opt-bce-mb-sink-exit-instrs
        instrs
        (+ index 1)
        check-pos
        phi-var
        fast-labels
        exit-label)
      (match (compiler-ir-instr-seq-ref instrs index)
        [(CompilerIrInstr.Phi dst inputs ty)
          (if (= dst phi-var)
            (compiler-ir-instr-cons
              (CompilerIrInstr.Phi
                dst
                (opt-bce-mb-sink-phi-relabel-inputs
                  inputs
                  fast-labels
                  exit-label)
                ty)
              (opt-bce-mb-sink-exit-instrs
                instrs
                (+ index 1)
                check-pos
                phi-var
                fast-labels
                exit-label))
            (compiler-ir-instr-cons
              (compiler-ir-instr-seq-ref instrs index)
              (opt-bce-mb-sink-exit-instrs
                instrs
                (+ index 1)
                check-pos
                phi-var
                fast-labels
                exit-label)))]
        [(CompilerIrInstr.Cast dst src _ _)
          (match src
            [(CompilerIrValue.Var v)
              (if (= v phi-var)
                (opt-bce-mb-sink-exit-instrs
                  instrs
                  (+ index 1)
                  check-pos
                  phi-var
                  fast-labels
                  exit-label)
                (compiler-ir-instr-cons
                  (compiler-ir-instr-seq-ref instrs index)
                  (opt-bce-mb-sink-exit-instrs
                    instrs
                    (+ index 1)
                    check-pos
                    phi-var
                    fast-labels
                    exit-label)))]
            [_
              (compiler-ir-instr-cons
                (compiler-ir-instr-seq-ref instrs index)
                (opt-bce-mb-sink-exit-instrs
                  instrs
                  (+ index 1)
                  check-pos
                  phi-var
                  fast-labels
                  exit-label))])]
        [_
          (compiler-ir-instr-cons
            (compiler-ir-instr-seq-ref instrs index)
            (opt-bce-mb-sink-exit-instrs
              instrs
              (+ index 1)
              check-pos
              phi-var
              fast-labels
              exit-label))]))))

;; Rewrite the exit phi's moved inputs to name their new check-block edges.
(define (opt-bce-mb-sink-phi-relabel-inputs
  [inputs : CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [exit-label : i64]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-sink-phi-relabel-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        fast-labels
        exit-label)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        value
        (if (opt-label-contains fast-labels label)
          label
          (compiler-ir-label
            (str_cat.str-cat
              (compiler-ir-label-text exit-label)
              "__xchk_"
              (compiler-ir-label-text label))))
        (opt-bce-mb-sink-phi-relabel-inputs
          (box-get rest)
          fast-labels
          exit-label))]))

;; Retarget the terminators that land on the exit to the input's new check
;; block, walking every non-fast predecessor.
(define (opt-bce-mb-sink-retarget-all
  [blocks : CompilerIrBlockList]
  [inputs : CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [exit-label : i64]) : CompilerIrBlockList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) blocks]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-sink-retarget-all
        blocks
        (compiler-ir-phi-input-seq-to-list seq)
        fast-labels
        exit-label)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains fast-labels label)
        (opt-bce-mb-sink-retarget-all
          blocks
          (box-get rest)
          fast-labels
          exit-label)
        (opt-bce-mb-sink-retarget-all
          (opt-bce-mb-sink-retarget-preds
            blocks
            exit-label
            (compiler-ir-label
              (str_cat.str-cat
                (compiler-ir-label-text exit-label)
                "__xchk_"
                (compiler-ir-label-text label)))
            label)
          (box-get rest)
          fast-labels
          exit-label))]))

;; The predecessor-block rewrite for the sink: retarget every terminator
;; that lands on `from-label` to `to-label`, but only in the block named
;; `pred-label`.
(define (opt-bce-mb-sink-retarget-preds
  [blocks : CompilerIrBlockList]
  [from-label : i64]
  [to-label : i64]
  [pred-label : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (if (= label pred-label)
            (compiler-ir-block-cons
              (compiler-ir-block
                label
                (opt-unroll-retarget-instrs instrs 0 from-label to-label))
              (opt-bce-mb-sink-retarget-preds
                (box-get rest)
                from-label
                to-label
                pred-label))
            (compiler-ir-block-cons
              block
              (opt-bce-mb-sink-retarget-preds
                (box-get rest)
                from-label
                to-label
                pred-label)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-sink-retarget-preds
        (compiler-ir-block-seq-to-list seq)
        from-label
        to-label
        pred-label)]))

;; Build the tiny check blocks for the non-fast phi inputs and retarget the
;; predecessor edges. Each input gets: cast input to u64, check, jump exit.
(define (opt-bce-mb-sink-check-blocks-from
  [inputs : CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [exit-label : i64]
  [len : CompilerIrValue]
  [blocks : CompilerIrBlockList]
  [cell : (Array i64)]) : CompilerIrBlockList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) blocks]
    [(CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-sink-check-blocks-from
        (compiler-ir-phi-input-seq-to-list seq)
        fast-labels
        exit-label
        len
        blocks
        cell)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains fast-labels label)
        (opt-bce-mb-sink-check-blocks-from
          (box-get rest)
          fast-labels
          exit-label
          len
          blocks
          cell)
        (let
          [check-label : i64
            (compiler-ir-label
              (str_cat.str-cat
                (compiler-ir-label-text exit-label)
                "__xchk_"
                (compiler-ir-label-text label)))]
          [cast-var : i64 (opt-bce-version-alloc-var cell)]
          [ok-label : i64
            (compiler-ir-label
              (str_cat.str-cat (compiler-ir-label-text check-label) ".0"))]
          (compiler-ir-block-cons
            (compiler-ir-block
              check-label
              (compiler-ir-instr-cons
                (CompilerIrInstr.Cast
                  cast-var
                  value
                  (AstType.I64)
                  (AstType.U64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.BoundsCheck
                    (CompilerIrValue.Var cast-var)
                    len
                    ok-label)
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Jump exit-label)
                    (CompilerIrInstrList.Nil)))))
            (opt-bce-mb-sink-check-blocks-from
              (box-get rest)
              fast-labels
              exit-label
              len
              blocks
              cell))))]))

;; Sink the check out of a qualifying exit block: the fast arrivals are
;; provably in range, so the check moves to fresh per-input check blocks on
;; the non-fast edges only. The check blocks' length operand must dominate
;; them, so it is the canonical (entry-defined) spelling, not the exit
;; block's local cast.
(define (opt-bce-mb-split-exit-checks
  [blocks : CompilerIrBlockList]
  [shape : OptBceMbShape]
  [fast-blocks : CompilerIrBlockList]
  [fast-bounded : i64]
  [guard-instrs : CompilerIrInstrList]
  [cell : (Array i64)]) : CompilerIrBlockList
  (match (opt-bce-mb-find-exit-split
    blocks
    blocks
    shape
    fast-blocks
    fast-bounded
    guard-instrs)
    [(OptBceMbExitSplit.No) blocks]
    [(OptBceMbExitSplit.Some label check-pos phi-var len fast-labels)
      (let
        [inputs : CompilerIrPhiInputList
          (opt-bce-mb-block-phi-inputs
            (opt-bce-mb-find-block-seq blocks label)
            phi-var)]
        [clen : CompilerIrValue (opt-bce-mb-canon-value blocks len)]
        ;; The check blocks land immediately before the exit block: behind
        ;; every predecessor edge, never before the function entry.
        [sunk : CompilerIrBlockList
          (opt-bce-mb-sink-exit-block-list
            blocks
            label
            check-pos
            phi-var
            fast-labels
            (opt-bce-mb-sink-check-blocks-from
              inputs
              fast-labels
              label
              clen
              (CompilerIrBlockList.Nil)
              cell))]
        [step : CompilerIrBlockList
          (opt-bce-mb-sink-retarget-all sunk inputs fast-labels label)]
        step)]))

(define (opt-bce-mb-apply
  [blocks : CompilerIrBlockList]
  [shape : OptBceMbShape]
  [frame : i64]) : OptUnrollResult
  (let
    [body-labels : OptLabelSet (struct-get shape body-labels)]
    [body-blocks : CompilerIrBlockList (struct-get shape body-blocks)]
    [defs : opt_i64_i64_map.Map
      (opt-bce-mb-collect-defs body-blocks (opt_i64_i64_map.with-capacity 64))]
    [outside : opt_i64_i64_map.Map
      (opt-bce-mb-outside-uses
        (opt_i64_i64_map.with-capacity 64)
        blocks
        body-labels)]
    (if (opt-bce-mb-defs-escape? body-blocks outside)
      (OptUnrollResult.Result blocks frame false)
      (let
        [cell : (Array i64) (array.make-array i64 1)]
        [_cell : unit (array-set! cell 0 frame)]
        (match (opt-bce-mb-guard-conds blocks shape defs cell)
          [(OptBceMbGuardOut.No) (OptUnrollResult.Result blocks frame false)]
          [(OptBceMbGuardOut.Some guard-instrs guard-value keep)
            (let
              [remap : (Array CompilerIrValue)
                (array.make-array CompilerIrValue frame)]
              [_fill : unit (opt-unroll-remap-fill remap 0)]
              [_alloc : unit (opt-bce-mb-alloc-defs! body-blocks remap cell)]
              [guard-label : i64
                (compiler-ir-label
                  (string.append
                    (compiler-ir-label-text (struct-get shape header))
                    "__bce_guard"))]
              [fast-blocks : CompilerIrBlockList
                (opt-bce-mb-clone-blocks
                  body-blocks
                  remap
                  body-labels
                  (opt-bce-mb-all-labels-from blocks (OptLabelSet.Nil))
                  (struct-get shape preheader)
                  guard-label
                  keep)]
              [guard-block : CompilerIrBlock
                (compiler-ir-block
                  guard-label
                  (opt-aggregate-instr-list-append
                    guard-instrs
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Branch
                        guard-value
                        (compiler-ir-label
                          (string.append
                            (compiler-ir-label-text (struct-get shape header))
                            "__bce_fast"))
                        (struct-get shape header))
                      (CompilerIrInstrList.Nil))))]
              (OptUnrollResult.Result
                (let
                  [rewritten-blocks : CompilerIrBlockList
                    (opt-bce-mb-rewrite-blocks
                      blocks
                      shape
                      guard-block
                      fast-blocks
                      remap)]
                  [bounded : i64
                    (opt-bce-mb-find-bounded-phi
                      (struct-get shape body-blocks)
                      rewritten-blocks
                      (struct-get shape header)
                      (struct-get shape preheader)
                      (compiler-ir-label
                        (string.append
                          (compiler-ir-label-text (struct-get shape header))
                          "__bce_guard"))
                      (opt-bce-mb-canon-value blocks (struct-get shape seed))
                      (struct-get shape iphi))]
                  (opt-bce-mb-split-exit-checks
                    rewritten-blocks
                    shape
                    fast-blocks
                    (if (< bounded 0)
                      -1
                      (match (array-ref remap bounded)
                        [(CompilerIrValue.Var fast-bounded-id) fast-bounded-id]
                        [_ -1]))
                    guard-instrs
                    cell))
                (array-ref cell 0)
                true))])))))

;; Apply at most one multi-block versioning per invocation, like the
;; single-block pass.
(define (opt-bce-mb-loops-scan
  [blocks : CompilerIrBlockList]
  [all-loops : OptNaturalLoopList]
  [loops : OptNaturalLoopList]
  [entry-label : i64]
  [frame : i64]) : OptUnrollResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptUnrollResult.Result blocks frame false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-bce-mb-loop-shape blocks all-loops entry-label loop)
        [(OptBceMbMaybeShape.Some shape)
          (match (opt-bce-mb-apply blocks shape frame)
            [(OptUnrollResult.Result next-blocks next-frame changed)
              (if changed
                (OptUnrollResult.Result next-blocks next-frame true)
                (opt-bce-mb-loops-scan
                  blocks
                  all-loops
                  (box-get rest)
                  entry-label
                  frame))])]
        [(OptBceMbMaybeShape.No)
          (opt-bce-mb-loops-scan
            blocks
            all-loops
            (box-get rest)
            entry-label
            frame)])]))

;; --- prescan ---------------------------------------------------------------------
(define (opt-bce-mb-blocks-have-check? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (>=
            (opt-bce-version-check-count
              instrs
              0
              (compiler-ir-instr-seq-count instrs)
              0)
            1)
            true
            (opt-bce-mb-blocks-have-check? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-bce-mb-blocks-have-check? (compiler-ir-block-seq-to-list seq))]))

;; Cheap prescan only checks facts that are invariant under block layout. The
;; full candidate scan below uses dominance-based natural loops.
(define (opt-bce-mb-blocks-have-candidate? [blocks : CompilerIrBlockList]) : bool
  (and (opt-bce-mb-blocks-have-check? blocks) (opt-ssa-blocks-have-phi? blocks)))

;; Rebuild the function around a versioned block list and verify it, falling
;; back to the original function when the verifier rejects the rewrite.
(define (opt-bce-version-finish-with-context
  [context : OptCfgContext]
  [func : CompilerIrFunction]
  [next-blocks : CompilerIrBlockList]
  [next-frame : i64]) : OptFunctionCtxResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty _ _)
      (let
        [next : CompilerIrFunction
          (CompilerIrFunction.Function
            name
            params
            ret-ty
            next-frame
            next-blocks)]
        [next-context : OptCfgContext (opt-cfg-context-build next-blocks)]
        (match (opt-verify-function-with-context next next-context)
          [(ResultCompilerOptimizeVerify.Ok)
            (OptFunctionCtxResult.Result next next-context)]
          [(ResultCompilerOptimizeVerify.Err _)
            (OptFunctionCtxResult.Result func context)]))]))

(define (opt-bce-version-function-verified-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(CompilerIrFunction.Function _ _ _ frame blocks)
          (match (opt-bce-version-blocks-scan
            blocks
            blocks
            (opt-cfg-entry-label blocks)
            frame)
            [(OptUnrollResult.Result next-blocks next-frame changed)
              (if changed
                (opt-bce-version-finish-with-context
                  context
                  func
                  next-blocks
                  next-frame)
                ;; no single-block self-loop matched: try multi-block
                ;; counted loops over the natural-loop back edges.
                (let
                  [loops : OptNaturalLoopList
                    (opt-cfg-natural-loops-with-context blocks context)]
                  (match (opt-bce-mb-loops-scan
                    blocks
                    loops
                    loops
                    (opt-cfg-entry-label blocks)
                    frame)
                    [(OptUnrollResult.Result mb-blocks mb-frame mb-changed)
                      (if mb-changed
                        (opt-bce-version-finish-with-context
                          context
                          func
                          mb-blocks
                          mb-frame)
                        (OptFunctionCtxResult.Result func context))])))])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-bce-version-function-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (the entry verify reuses it).
  (match func
    [(CompilerIrFunction.Function _ _ _ _ prescan-blocks)
      (if (or
        (opt-bce-version-blocks-have-candidate? prescan-blocks)
        (opt-bce-mb-blocks-have-candidate? prescan-blocks))
        (opt-bce-version-function-verified-with-context-result
          context
          verified?
          func)
        (OptFunctionCtxResult.Result func context))]))

(define (opt-bce-version-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-bce-version-function-with-context-result
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; --- x2 unrolling for versioned conditional diamonds ---------------------------
;;
;; The straight-line unroller above deliberately starts with a self-loop
;; prescan. A versioned partition loop has a four-block natural-loop body
;; instead:
;;
;;   H(phi i, phi state): body; Branch then else
;;   then/else: ...; Jump L
;;   L: merged state; inext = i + 1; c = inext < bound; Branch c H exit
;;
;; Its separate merge latch is the first gate that rejected quicksort's
;; `__bce_fast` clone; its store-bearing swap arm would also fail the
;; straight-line instruction whitelist. This path is intentionally narrower
;; than the multi-block BCE cloner: exactly one check-free four-block diamond,
;; at most two header phis, no calls or fallthroughs, <= 32 IR instructions,
;; <= 6 invariant live-ins, step +1, and an invariant bound. Requiring the
;; `__bce_fast` provenance keeps the original checked loop as the fallback and
;; preserves the guard's in-range proof without reintroducing BoundsChecks.
;;
;; G tests the parity of (bound - seed). For an odd trip count the original
;; fast body is peeled once; for an even count G enters copy 0 directly. Copy 0
;; falls through the diamond to copy 1 without an exit test, and copy 1 uses
;; the original remapped exit test to loop by two. Thus the steady-state pair
;; pays one increment/compare/branch while every memory operation remains in
;; the already-proven check-free fast region.
(defstruct OptUnrollMbShape
  (header i64)
  (latch i64)
  (preheader i64)
  (exit-label i64)
  (body-labels OptLabelSet)
  (body-blocks CompilerIrBlockList)
  (iphi i64)
  (seed CompilerIrValue)
  (inext i64)
  (cond-var i64)
  (bound CompilerIrValue))

(defenum OptUnrollMbMaybeShape
  (No)
  (Some OptUnrollMbShape))

(define (opt-unroll-mb-copy-suffix [copy : i64]) : String
  (if (= copy 0)
    "__unroll2_0"
    "__unroll2_1"))

(define (opt-unroll-mb-label
  [body-labels : OptLabelSet]
  [label : i64]
  [copy : i64]) : i64
  (if (opt-label-contains body-labels label)
    (compiler-ir-label
      (string.append
        (compiler-ir-label-text label)
        (opt-unroll-mb-copy-suffix copy)))
    label))

(define (opt-unroll-mb-guard-label [header : i64]) : i64
  (compiler-ir-label
    (string.append (compiler-ir-label-text header) "__unroll2_guard")))

(define (opt-unroll-mb-block-terminator-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Jump _) true]
    [(CompilerIrInstr.Branch _ _ _) true]
    [_ false]))

(define (opt-unroll-mb-body-instr-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ _ _) true]
    [(CompilerIrInstr.Cast _ _ _ _) true]
    [(CompilerIrInstr.Bitcast _ _ _ _) true]
    [(CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(CompilerIrInstr.UnOp _ _ _ _) true]
    [(CompilerIrInstr.Gep _ _ _ _) true]
    [(CompilerIrInstr.Load _ _ _) true]
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [_ false]))

(define (opt-unroll-mb-body-instr-status [instr : CompilerIrInstr]) : i64
  (if (not (opt-unroll-mb-body-instr-ok? instr))
    -1
    (match instr
      [(CompilerIrInstr.StorePtr _ _ _) 1]
      [_ 0])))

;; Returns -1 for an unsafe body, 0 for a safe read-only body, and 1 for a
;; safe body containing a store.
(define (opt-unroll-mb-body-instrs-status
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : i64
  (if (>= index last)
    0
    (let
      [current : i64
        (opt-unroll-mb-body-instr-status
          (compiler-ir-instr-seq-ref instrs index))]
      (if (< current 0)
        -1
        (let
          [rest : i64
            (opt-unroll-mb-body-instrs-status instrs (+ index 1) last)]
          (if (< rest 0)
            -1
            (if (or (= current 1) (= rest 1))
              1
              0)))))))

(define (opt-unroll-mb-block-status [block : CompilerIrBlock]) : i64
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
        (if (and
          (> count phi-count)
          (opt-unroll-no-phi-from? instrs phi-count)
          (opt-unroll-mb-block-terminator-ok?
            (compiler-ir-instr-seq-ref instrs (- count 1))))
          (opt-unroll-mb-body-instrs-status instrs phi-count (- count 1))
          -1))]))

(define (opt-unroll-mb-body-status [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) 0]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [current : i64 (opt-unroll-mb-block-status block)]
        (if (< current 0)
          -1
          (let
            [tail : i64 (opt-unroll-mb-body-status (box-get rest))]
            (if (< tail 0)
              -1
              (if (or (= current 1) (= tail 1))
                1
                0)))))]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-mb-body-status (compiler-ir-block-seq-to-list seq))]))

(define (opt-unroll-mb-all-fast-labels? [labels : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        [marker : String "__bce_fast"]
        [text : String (compiler-ir-label-text label)]
        (and
          (string.contains (& text) (& marker))
          (opt-unroll-mb-all-fast-labels? (opt-label-tail labels))))]))

(define (opt-unroll-mb-labels-fresh?
  [blocks : CompilerIrBlockList]
  [labels : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (and
          (not
            (opt-cfg-block-exists?
              blocks
              (compiler-ir-label
                (string.append
                  (compiler-ir-label-text label)
                  (opt-unroll-mb-copy-suffix 0)))))
          (not
            (opt-cfg-block-exists?
              blocks
              (compiler-ir-label
                (string.append
                  (compiler-ir-label-text label)
                  (opt-unroll-mb-copy-suffix 1)))))
          (opt-unroll-mb-labels-fresh? blocks (opt-label-tail labels))))]))

(define (opt-unroll-mb-block-jumps-to?
  [blocks : CompilerIrBlockList]
  [label : i64]
  [target : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (and
              (> count 0)
              (match (compiler-ir-instr-seq-ref instrs (- count 1))
                [(CompilerIrInstr.Jump actual) (= actual target)]
                [_ false])))])]))

;; The only admitted control shape is H -> {then, else} -> L -> {H, exit}.
(define (opt-unroll-mb-diamond?
  [blocks : CompilerIrBlockList]
  [body-labels : OptLabelSet]
  [header : i64]
  [latch : i64]) : bool
  (match (opt-cfg-find-block blocks header)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              false
              (match (compiler-ir-instr-seq-ref instrs (- count 1))
                [(CompilerIrInstr.Branch _ then-label else-label)
                  (and
                    (not (= then-label else-label))
                    (not (= then-label header))
                    (not (= else-label header))
                    (not (= then-label latch))
                    (not (= else-label latch))
                    (opt-label-contains body-labels then-label)
                    (opt-label-contains body-labels else-label)
                    (opt-unroll-mb-block-jumps-to? blocks then-label latch)
                    (opt-unroll-mb-block-jumps-to? blocks else-label latch))]
                [_ false])))])]))

(define (opt-unroll-mb-collect-uses
  [blocks : CompilerIrBlockList]
  [set : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-unroll-mb-collect-uses
            (box-get rest)
            (opt-collect-instr-seq-uses set instrs))])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-mb-collect-uses (compiler-ir-block-seq-to-list seq) set)]))

(define (opt-unroll-mb-remove-defs-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [uses : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index (compiler-ir-instr-seq-count instrs))
    uses
    (let
      [out : opt_i64_i64_map.Map uses]
      [dst : i64 (compiler-ir-instr-seq-loop-dst-or instrs index (- 0 1))]
      (begin
        (if (>= dst 0)
          (begin
            (opt_i64_i64_map.remove-ref! (&mut out) dst)
            unit)
          unit)
        (opt-unroll-mb-remove-defs-instrs instrs (+ index 1) out)))))

(define (opt-unroll-mb-remove-defs
  [blocks : CompilerIrBlockList]
  [uses : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) uses]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-unroll-mb-remove-defs
            (box-get rest)
            (opt-unroll-mb-remove-defs-instrs instrs 0 uses))])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-mb-remove-defs (compiler-ir-block-seq-to-list seq) uses)]))

;; This is a deliberately small register-pressure proxy: loop definitions do
;; not count, because each copy's temporaries die before the next copy starts;
;; only values kept live into both copies consume steady-state headroom.
(define (opt-unroll-mb-live-in-count [blocks : CompilerIrBlockList]) : i64
  (let
    [uses : opt_i64_i64_map.Map
      (opt-unroll-mb-collect-uses blocks (opt_i64_i64_map.with-capacity 32))]
    [live-ins : opt_i64_i64_map.Map (opt-unroll-mb-remove-defs blocks uses)]
    (opt_i64_i64_map.len (& live-ins))))

(define (opt-unroll-mb-direct-var? [value : CompilerIrValue] [var : i64]) : bool
  (match value
    [(CompilerIrValue.Var id) (= id var)]
    [_ false]))

;; Copy 1 eliminates its counter phi: each indexed Gep gets a same-block
;; `i + 1` address-only offset (the backend's displacement fold deletes it),
;; and the sole carried counter update becomes `i + 2`. Reject any other
;; direct use instead of materializing `i + 1` in the steady-state loop.
(define (opt-unroll-mb-counter-uses-ok-instrs?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [iphi : i64]
  [inext : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      [uses : opt_i64_i64_map.Map
        (opt-collect-instr-uses (opt_i64_i64_map.with-capacity 4) instr)]
      (and
        (if (not (opt-used-contains uses iphi))
          true
          (match instr
            ;; Header phis define the carried value; their incoming edges do
            ;; not execute as body uses.
            [(CompilerIrInstr.Phi _ _ _) true]
            [(CompilerIrInstr.Gep _ _ offset _)
              (opt-unroll-mb-direct-var? offset iphi)]
            [(CompilerIrInstr.BinOp dst op lhs rhs _)
              (and
                (= dst inext)
                (match op
                  [(CompilerIrBinOp.Add) true]
                  [_ false])
                (opt-unroll-mb-direct-var? lhs iphi)
                (match rhs
                  [(CompilerIrValue.I64 step) (= step 1)]
                  [_ false]))]
            [_ false]))
        (opt-unroll-mb-counter-uses-ok-instrs? instrs (+ index 1) iphi inext)))))

(define (opt-unroll-mb-counter-uses-ok?
  [blocks : CompilerIrBlockList]
  [iphi : i64]
  [inext : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (and
            (opt-unroll-mb-counter-uses-ok-instrs? instrs 0 iphi inext)
            (opt-unroll-mb-counter-uses-ok? (box-get rest) iphi inext))])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-mb-counter-uses-ok?
        (compiler-ir-block-seq-to-list seq)
        iphi
        inext)]))

(define (opt-unroll-mb-shape-finish
  [blocks : CompilerIrBlockList]
  [header : i64]
  [latch : i64]
  [preheader : i64]
  [body-labels : OptLabelSet]
  [body-blocks : CompilerIrBlockList]
  [counter : OptBceMbMaybeCounter]
  [cond-var : i64]
  [exit-label : i64]) : OptUnrollMbMaybeShape
  (match counter
    [(OptBceMbMaybeCounter.No) (OptUnrollMbMaybeShape.No)]
    [(OptBceMbMaybeCounter.Some iphi seed inext bound)
      (match (opt-cfg-find-block blocks header)
        [(OptMaybeBlock.No) (OptUnrollMbMaybeShape.No)]
        [(OptMaybeBlock.Some block)
          (match block
            [(CompilerIrBlock.Block _ instrs)
              (let
                [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
                (if (and
                  (>= phi-count 1)
                  (<= phi-count 2)
                  (opt-bce-mb-header-phis-ok?
                    instrs
                    0
                    phi-count
                    latch
                    preheader)
                  (opt-unroll-mb-diamond? blocks body-labels header latch)
                  ;; The 2x path pays an odd-trip guard and duplicates four
                  ;; blocks. Keep it for the store-bearing swap/update shape
                  ;; that benefits measurably; read-only reductions/searches
                  ;; are better left to the ordinary scalar loop pipeline.
                  (= (opt-unroll-mb-body-status body-blocks) 1)
                  (<= (compiler-ir-block-list-instruction-count body-blocks) 32)
                  (<= (opt-unroll-mb-live-in-count body-blocks) 6)
                  (opt-unroll-mb-counter-uses-ok? body-blocks iphi inext)
                  (opt-unroll-mb-all-fast-labels? body-labels)
                  (not
                    (opt-cfg-block-exists?
                      blocks
                      (opt-unroll-mb-guard-label header)))
                  (opt-unroll-mb-labels-fresh? blocks body-labels)
                  (opt-unroll-pred-retargetable? blocks preheader))
                  (OptUnrollMbMaybeShape.Some
                    (OptUnrollMbShape
                      header
                      latch
                      preheader
                      exit-label
                      body-labels
                      body-blocks
                      iphi
                      seed
                      inext
                      cond-var
                      bound))
                  (OptUnrollMbMaybeShape.No)))])])]))

(define (opt-unroll-mb-loop-shape
  [blocks : CompilerIrBlockList]
  [entry-label : i64]
  [loop : OptNaturalLoop]) : OptUnrollMbMaybeShape
  (match loop
    [(OptNaturalLoop.Loop header latch body preheader)
      (match preheader
        [(OptLoopPreheader.No) (OptUnrollMbMaybeShape.No)]
        [(OptLoopPreheader.Some pred)
          (let
            [body-labels : OptLabelSet (struct-get body labels)]
            [body-blocks : CompilerIrBlockList (struct-get body blocks)]
            (if (or
              (= header entry-label)
              (not (= (opt-label-count body-labels) 4)))
              (OptUnrollMbMaybeShape.No)
              (match (opt-cfg-find-block blocks latch)
                [(OptMaybeBlock.No) (OptUnrollMbMaybeShape.No)]
                [(OptMaybeBlock.Some latch-block)
                  (match (opt-bce-mb-latch-branch
                    latch-block
                    header
                    body-labels)
                    [(OptBceMbMaybeLatch.No) (OptUnrollMbMaybeShape.No)]
                    [(OptBceMbMaybeLatch.Some cond-var exit-label)
                      (let
                        [defs : opt_i64_i64_map.Map
                          (opt-bce-mb-collect-defs
                            body-blocks
                            (opt_i64_i64_map.with-capacity 64))]
                        (opt-unroll-mb-shape-finish
                          blocks
                          header
                          latch
                          pred
                          body-labels
                          body-blocks
                          (opt-bce-mb-counter-step
                            body-blocks
                            defs
                            latch
                            pred
                            cond-var)
                          cond-var
                          exit-label))])])))])]))

;; Map ordinary intra-loop phi edges for one copy. Header phis are handled
;; separately because copy 0 has three entry sources and copy 1 has one.
(define (opt-unroll-mb-clone-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [remap : (Array CompilerIrValue)]
  [body-labels : OptLabelSet]
  [copy : i64]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-unroll-mb-clone-phi-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        remap
        body-labels
        copy)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        (opt-unroll-subst-value remap value)
        (opt-unroll-mb-label body-labels label copy)
        (opt-unroll-mb-clone-phi-inputs (box-get rest) remap body-labels copy))]))

(define (opt-unroll-mb-clone-header-phi
  [instr : CompilerIrInstr]
  [shape : OptUnrollMbShape]
  [remap0 : (Array CompilerIrValue)]
  [remap1 : (Array CompilerIrValue)]
  [copy : i64]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Phi dst inputs ty)
      (match (opt-unroll-split-phi-inputs inputs (struct-get shape latch))
        [(OptUnrollPhiSplit.No) instr]
        [(OptUnrollPhiSplit.Split init back _)
          (if (= copy 0)
            (CompilerIrInstr.Phi
              (opt-bce-mb-remap-dst remap0 dst)
              (compiler-ir-phi-input-cons
                init
                (opt-unroll-mb-guard-label (struct-get shape header))
                (compiler-ir-phi-input-cons
                  back
                  (struct-get shape latch)
                  (compiler-ir-phi-input-cons
                    (opt-unroll-subst-value remap1 back)
                    (opt-unroll-mb-label
                      (struct-get shape body-labels)
                      (struct-get shape latch)
                      1)
                    (CompilerIrPhiInputList.Nil))))
              ty)
            (CompilerIrInstr.Phi
              (opt-bce-mb-remap-dst remap1 dst)
              (compiler-ir-phi-input-cons
                (opt-unroll-subst-value remap0 back)
                (opt-unroll-mb-label
                  (struct-get shape body-labels)
                  (struct-get shape latch)
                  0)
                (CompilerIrPhiInputList.Nil))
              ty))])]
    [_ instr]))

(define (opt-unroll-mb-clone-instr
  [instr : CompilerIrInstr]
  [remap : (Array CompilerIrValue)]
  [body-labels : OptLabelSet]
  [shape : OptUnrollMbShape]
  [copy : i64]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (CompilerIrInstr.Mov
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (CompilerIrInstr.Cast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (CompilerIrInstr.Bitcast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (CompilerIrInstr.BinOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap lhs)
        (if (and (= copy 1) (= dst (struct-get shape inext)))
          (CompilerIrValue.I64 2)
          (opt-unroll-subst-value remap rhs))
        ty)]
    [(CompilerIrInstr.UnOp dst op src ty)
      (CompilerIrInstr.UnOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap src)
        ty)]
    [(CompilerIrInstr.Gep dst base offset ty)
      (CompilerIrInstr.Gep
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap offset)
        ty)]
    [(CompilerIrInstr.Load dst src ty)
      (CompilerIrInstr.Load
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(CompilerIrInstr.StorePtr ptr value ty)
      (CompilerIrInstr.StorePtr
        (opt-unroll-subst-value remap ptr)
        (opt-unroll-subst-value remap value)
        ty)]
    [(CompilerIrInstr.Phi dst inputs ty)
      (CompilerIrInstr.Phi
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-mb-clone-phi-inputs inputs remap body-labels copy)
        ty)]
    [(CompilerIrInstr.Jump target)
      (CompilerIrInstr.Jump (opt-unroll-mb-label body-labels target copy))]
    [(CompilerIrInstr.Branch cond then-label else-label)
      (CompilerIrInstr.Branch
        (opt-unroll-subst-value remap cond)
        (opt-unroll-mb-label body-labels then-label copy)
        (opt-unroll-mb-label body-labels else-label copy))]
    [_ instr]))

(define (opt-unroll-mb-copy0-counter-tail?
  [instr : CompilerIrInstr]
  [shape : OptUnrollMbShape]) : bool
  (let
    [dst : i64 (compiler-ir-instr-loop-dst-or instr (- 0 1))]
    (and
      (>= dst 0)
      (or
        (= dst (struct-get shape cond-var))
        (=
          (opt-bce-mb-resolve (struct-get shape body-blocks) dst 16)
          (struct-get shape inext))))))

(define (opt-unroll-mb-clone-instrs
  [label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [shape : OptUnrollMbShape]
  [remap0 : (Array CompilerIrValue)]
  [remap1 : (Array CompilerIrValue)]
  [cell : (Array i64)]
  [copy : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (if (or
      (and
        (= copy 1)
        (= label (struct-get shape header))
        (match (compiler-ir-instr-seq-ref instrs index)
          [(CompilerIrInstr.Phi dst _ _) (= dst (struct-get shape iphi))]
          [_ false]))
      ;; Copy 0 never tests or carries its intermediate counter. Dropping the
      ;; whole add/copy/compare chain prevents GVN from reusing its dominating
      ;; `i + 1` in copy 1, where the offset must remain address-only.
      (and
        (= copy 0)
        (= label (struct-get shape latch))
        (opt-unroll-mb-copy0-counter-tail?
          (compiler-ir-instr-seq-ref instrs index)
          shape)))
      (opt-unroll-mb-clone-instrs
        label
        instrs
        (+ index 1)
        shape
        remap0
        remap1
        cell
        copy)
      (let
        [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
        [last? : bool (= index (- (compiler-ir-instr-seq-count instrs) 1))]
        [remap : (Array CompilerIrValue)
          (if (= copy 0)
            remap0
            remap1)]
        [cloned : CompilerIrInstr
          (if (and last? (= label (struct-get shape latch)))
            (match instr
              [(CompilerIrInstr.Branch cond _ _)
                (if (= copy 0)
                  (CompilerIrInstr.Jump
                    (opt-unroll-mb-label
                      (struct-get shape body-labels)
                      (struct-get shape header)
                      1))
                  (CompilerIrInstr.Branch
                    (opt-unroll-subst-value remap1 cond)
                    (opt-unroll-mb-label
                      (struct-get shape body-labels)
                      (struct-get shape header)
                      0)
                    (struct-get shape exit-label)))]
              [_ instr])
            (if (and
              (= label (struct-get shape header))
              (match instr
                [(CompilerIrInstr.Phi _ _ _) true]
                [_ false]))
              (opt-unroll-mb-clone-header-phi instr shape remap0 remap1 copy)
              (opt-unroll-mb-clone-instr
                instr
                remap
                (struct-get shape body-labels)
                shape
                copy)))]
        [tail : CompilerIrInstrList
          (opt-unroll-mb-clone-instrs
            label
            instrs
            (+ index 1)
            shape
            remap0
            remap1
            cell
            copy)]
        (if (= copy 1)
          (match instr
            [(CompilerIrInstr.Gep _ base offset _ty)
              (if (opt-unroll-mb-direct-var? offset (struct-get shape iphi))
                (let
                  [shifted : i64 (opt-unroll-alloc-var cell)]
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.BinOp
                      shifted
                      (CompilerIrBinOp.Add)
                      (opt-unroll-subst-value
                        remap0
                        (CompilerIrValue.Var (struct-get shape iphi)))
                      (CompilerIrValue.I64 1)
                      (AstType.I64))
                    (match cloned
                      [(CompilerIrInstr.Gep dst _ _mapped-offset mapped-ty)
                        (compiler-ir-instr-cons
                          (CompilerIrInstr.Gep
                            dst
                            (opt-unroll-subst-value remap1 base)
                            (CompilerIrValue.Var shifted)
                            mapped-ty)
                          tail)]
                      [_ (compiler-ir-instr-cons cloned tail)])))
                (compiler-ir-instr-cons cloned tail))]
            [_ (compiler-ir-instr-cons cloned tail)])
          (compiler-ir-instr-cons cloned tail))))))

(define (opt-unroll-mb-clone-blocks
  [blocks : CompilerIrBlockList]
  [shape : OptUnrollMbShape]
  [remap0 : (Array CompilerIrValue)]
  [remap1 : (Array CompilerIrValue)]
  [cell : (Array i64)]
  [copy : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (compiler-ir-block
              (opt-unroll-mb-label (struct-get shape body-labels) label copy)
              (opt-unroll-mb-clone-instrs
                label
                instrs
                0
                shape
                remap0
                remap1
                cell
                copy))
            (opt-unroll-mb-clone-blocks
              (box-get rest)
              shape
              remap0
              remap1
              cell
              copy))])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-mb-clone-blocks
        (compiler-ir-block-seq-to-list seq)
        shape
        remap0
        remap1
        cell
        copy)]))

;; The original fast body is now only the odd-trip peel, so each header phi
;; keeps its outside seed (relabeled to G) and drops its old latch input.
(define (opt-unroll-mb-peel-header-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [latch : i64]
  [guard-label : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (compiler-ir-instr-cons
        (match instr
          [(CompilerIrInstr.Phi dst inputs ty)
            (match (opt-unroll-split-phi-inputs inputs latch)
              [(OptUnrollPhiSplit.Split init _ _)
                (CompilerIrInstr.Phi
                  dst
                  (compiler-ir-phi-input-cons
                    init
                    guard-label
                    (CompilerIrPhiInputList.Nil))
                  ty)]
              [(OptUnrollPhiSplit.No) instr])]
          [_ instr])
        (opt-unroll-mb-peel-header-instrs instrs (+ index 1) latch guard-label)))))

(define (opt-unroll-mb-extend-exit-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [latch : i64]
  [clone-latch : i64]
  [remap1 : (Array CompilerIrValue)]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) (CompilerIrPhiInputList.Nil)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-unroll-mb-extend-exit-phi-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        latch
        clone-latch
        remap1)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : CompilerIrPhiInputList
          (opt-unroll-mb-extend-exit-phi-inputs
            (box-get rest)
            latch
            clone-latch
            remap1)]
        (if (= label latch)
          (compiler-ir-phi-input-cons
            value
            label
            (compiler-ir-phi-input-cons
              (opt-unroll-subst-value remap1 value)
              clone-latch
              tail))
          (compiler-ir-phi-input-cons value label tail)))]))

(define (opt-unroll-mb-extend-exit-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [latch : i64]
  [clone-latch : i64]
  [remap1 : (Array CompilerIrValue)]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (compiler-ir-instr-cons
        (match instr
          [(CompilerIrInstr.Phi dst inputs ty)
            (CompilerIrInstr.Phi
              dst
              (opt-unroll-mb-extend-exit-phi-inputs
                inputs
                latch
                clone-latch
                remap1)
              ty)]
          [_ instr])
        (opt-unroll-mb-extend-exit-instrs
          instrs
          (+ index 1)
          latch
          clone-latch
          remap1)))))

(define (opt-unroll-mb-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [shape : OptUnrollMbShape]
  [guard-block : CompilerIrBlock]
  [copy0 : CompilerIrBlockList]
  [copy1 : CompilerIrBlockList]
  [remap1 : (Array CompilerIrValue)]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [tail : CompilerIrBlockList
              (opt-unroll-mb-rewrite-blocks
                (box-get rest)
                shape
                guard-block
                copy0
                copy1
                remap1)]
            (cond
              [(= label (struct-get shape header))
                (compiler-ir-block-cons
                  guard-block
                  (opt-bce-mb-blocks-cons-onto
                    copy0
                    (opt-bce-mb-blocks-cons-onto
                      copy1
                      (compiler-ir-block-cons
                        (compiler-ir-block
                          label
                          (opt-unroll-mb-peel-header-instrs
                            instrs
                            0
                            (struct-get shape latch)
                            (opt-unroll-mb-guard-label
                              (struct-get shape header))))
                        tail))))]
              [(= label (struct-get shape preheader))
                (compiler-ir-block-cons
                  (compiler-ir-block
                    label
                    (opt-unroll-retarget-instrs
                      instrs
                      0
                      (struct-get shape header)
                      (opt-unroll-mb-guard-label (struct-get shape header))))
                  tail)]
              [(= label (struct-get shape latch))
                (compiler-ir-block-cons
                  (compiler-ir-block
                    label
                    (opt-unroll-retarget-instrs
                      instrs
                      0
                      (struct-get shape header)
                      (opt-unroll-mb-label
                        (struct-get shape body-labels)
                        (struct-get shape header)
                        0)))
                  tail)]
              [(opt-label-contains (struct-get shape body-labels) label)
                (compiler-ir-block-cons block tail)]
              [else
                (compiler-ir-block-cons
                  (compiler-ir-block
                    label
                    (opt-unroll-mb-extend-exit-instrs
                      instrs
                      0
                      (struct-get shape latch)
                      (opt-unroll-mb-label
                        (struct-get shape body-labels)
                        (struct-get shape latch)
                        1)
                      remap1))
                  tail)]))])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-mb-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        shape
        guard-block
        copy0
        copy1
        remap1)]))

(define (opt-unroll-mb-apply
  [blocks : CompilerIrBlockList]
  [shape : OptUnrollMbShape]
  [frame : i64]) : OptUnrollResult
  (let
    [body-blocks : CompilerIrBlockList (struct-get shape body-blocks)]
    [body-labels : OptLabelSet (struct-get shape body-labels)]
    [outside : opt_i64_i64_map.Map
      (opt-bce-mb-outside-uses
        (opt_i64_i64_map.with-capacity 64)
        blocks
        body-labels)]
    (if (opt-bce-mb-defs-escape? body-blocks outside)
      (OptUnrollResult.Result blocks frame false)
      (let
        [cell : (Array i64) (array.make-array i64 1)]
        [_cell : unit (array-set! cell 0 frame)]
        [remap0 : (Array CompilerIrValue)
          (array.make-array CompilerIrValue frame)]
        [remap1 : (Array CompilerIrValue)
          (array.make-array CompilerIrValue frame)]
        [_fill0 : unit (opt-unroll-remap-fill remap0 0)]
        [_fill1 : unit (opt-unroll-remap-fill remap1 0)]
        [_alloc0 : unit (opt-bce-mb-alloc-defs! body-blocks remap0 cell)]
        [_alloc1 : unit (opt-bce-mb-alloc-defs! body-blocks remap1 cell)]
        [_counter1 : unit
          (opt-unroll-remap-set
            remap1
            (struct-get shape iphi)
            (opt-unroll-subst-value
              remap0
              (CompilerIrValue.Var (struct-get shape iphi))))]
        [span : i64 (opt-unroll-alloc-var cell)]
        [odd : i64 (opt-unroll-alloc-var cell)]
        [is-odd : i64 (opt-unroll-alloc-var cell)]
        [guard-label : i64
          (opt-unroll-mb-guard-label (struct-get shape header))]
        [guard-block : CompilerIrBlock
          (compiler-ir-block
            guard-label
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                span
                (CompilerIrBinOp.Sub)
                (struct-get shape bound)
                (struct-get shape seed)
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.BinOp
                  odd
                  (CompilerIrBinOp.BitAnd)
                  (CompilerIrValue.Var span)
                  (CompilerIrValue.I64 1)
                  (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.BinOp
                    is-odd
                    (CompilerIrBinOp.Ne)
                    (CompilerIrValue.Var odd)
                    (CompilerIrValue.I64 0)
                    (AstType.I64))
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Branch
                      (CompilerIrValue.Var is-odd)
                      (struct-get shape header)
                      (opt-unroll-mb-label
                        body-labels
                        (struct-get shape header)
                        0))
                    (CompilerIrInstrList.Nil))))))]
        [copy0 : CompilerIrBlockList
          (opt-unroll-mb-clone-blocks body-blocks shape remap0 remap1 cell 0)]
        [copy1 : CompilerIrBlockList
          (opt-unroll-mb-clone-blocks body-blocks shape remap0 remap1 cell 1)]
        (OptUnrollResult.Result
          (opt-unroll-mb-rewrite-blocks
            blocks
            shape
            guard-block
            copy0
            copy1
            remap1)
          (array-ref cell 0)
          true)))))

(define (opt-unroll-mb-loops-scan
  [blocks : CompilerIrBlockList]
  [_all-loops : OptNaturalLoopList]
  [loops : OptNaturalLoopList]
  [entry-label : i64]
  [frame : i64]) : OptUnrollResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptUnrollResult.Result blocks frame false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-unroll-mb-loop-shape blocks entry-label loop)
        [(OptUnrollMbMaybeShape.Some shape)
          (match (opt-unroll-mb-apply blocks shape frame)
            [(OptUnrollResult.Result next-blocks next-frame changed)
              (if changed
                (OptUnrollResult.Result next-blocks next-frame true)
                (opt-unroll-mb-loops-scan
                  blocks
                  _all-loops
                  (box-get rest)
                  entry-label
                  frame))])]
        [(OptUnrollMbMaybeShape.No)
          (opt-unroll-mb-loops-scan
            blocks
            _all-loops
            (box-get rest)
            entry-label
            frame)])]))

(define (opt-unroll-mb-blocks-have-fast-phi? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [marker : String "__bce_fast"]
            [text : String (compiler-ir-label-text label)]
            (if (and
              (string.contains (& text) (& marker))
              (> (compiler-ir-instr-seq-count instrs) 0)
              (compiler-ir-instr-seq-phi? instrs 0))
              true
              (opt-unroll-mb-blocks-have-fast-phi? (box-get rest))))])]
    [(CompilerIrBlockList.Array seq)
      (opt-unroll-mb-blocks-have-fast-phi? (compiler-ir-block-seq-to-list seq))]))

;; Cheap companion to the original self-loop-only prescan. The full
;; dominance-based natural-loop and diamond checks remain behind this gate.
(define (opt-unroll-mb-blocks-have-candidate? [blocks : CompilerIrBlockList]) : bool
  (opt-unroll-mb-blocks-have-fast-phi? blocks))

;; --- Gep use-splitting for indexed memory operands --------------------------
;;
;; A Gep result feeding several memory operations (the quicksort swap: `g =
;; Gep a, i; x = Load g; ...; Store g, y`) defeats the backend's single-use
;; Gep+memop fusion, costing a lea per access. When EVERY use of a Gep is a
;; Load/StorePtr address operand and the base/index are single-source (one
;; definition each, so the address is identical at every use the Gep def
;; dominates), clone the Gep per use: each Load/StorePtr gets its own
;; single-use Gep, which the backend then fuses into an indexed memory
;; operand. Non-address uses, non-SIB element scales, and multi-source
;; bases/indices stay untouched. Verifier-gated with fallback like the other
;; whole-function rewrites.
;; One defining instruction per var (instruction destinations only; the
;; caller seeds params): a var with exactly one source has a single,
;; unchanging value wherever its def dominates, so an address derived from it
;; is the same at every use.
(define (opt-gep-split-defs-instrs!
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [counts : (Array i64)]) : unit
  (if (>= index (compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs index))
        [(option_i64.Some dst)
          (array-set! counts dst (+ (array-ref counts dst) 1))]
        [(option_i64.None) unit])
      (opt-gep-split-defs-instrs! instrs (+ index 1) counts))))

(define (opt-gep-split-defs-blocks!
  [blocks : CompilerIrBlockList]
  [counts : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-split-defs-instrs! instrs 0 counts)
            (opt-gep-split-defs-blocks! (box-get rest) counts))])]
    [(CompilerIrBlockList.Array seq)
      (opt-gep-split-defs-blocks! (compiler-ir-block-seq-to-list seq) counts)]))

(define (opt-gep-split-seed-params!
  [params : CompilerIrParamList]
  [counts : (Array i64)]) : unit
  (match params
    [(CompilerIrParamList.Nil) unit]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ var)
          (begin
            (array-set! counts var (+ (array-ref counts var) 1))
            (opt-gep-split-seed-params! (box-get rest) counts))])]
    [(CompilerIrParamList.Array seq)
      (opt-gep-split-seed-params! (compiler-ir-param-seq-to-list seq) counts)]))

;; Memory-address uses only (Load src / StorePtr dst): counted per var so the
;; all-uses-are-addresses test can compare against the total use count. A
;; zero-offset Gep base is also an address-only use: the wrapper is pointer
;; identity, so rewriting it with the wrapped Gep's operands exposes the
;; existing single-Gep memory fusion. chainuses distinguishes that useful
;; single-use case from the multi-use splitting this pass originally owned.
(define (opt-gep-split-memuses-instrs!
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [memuses : (Array i64)]
  [chainuses : (Array i64)]) : unit
  (if (>= index (compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (match (compiler-ir-instr-seq-ref instrs index)
        [(CompilerIrInstr.Load _ src _)
          (match src
            [(CompilerIrValue.Var v)
              (array-set! memuses v (+ (array-ref memuses v) 1))]
            [_ unit])]
        [(CompilerIrInstr.StorePtr dst _ _)
          (match dst
            [(CompilerIrValue.Var v)
              (array-set! memuses v (+ (array-ref memuses v) 1))]
            [_ unit])]
        [(CompilerIrInstr.Gep _ base offset _)
          (match offset
            [(CompilerIrValue.I64 n)
              (if (= n 0)
                (match base
                  [(CompilerIrValue.Var v)
                    (begin
                      (array-set! memuses v (+ (array-ref memuses v) 1))
                      (array-set! chainuses v (+ (array-ref chainuses v) 1)))]
                  [_ unit])
                unit)]
            [_ unit])]
        ;; A Mov of the Gep result is replaced by a fresh Gep, so it counts as
        ;; an address use too (its dst's role does not matter: the fresh Gep
        ;; yields the same address value).
        [(CompilerIrInstr.Mov _ src _)
          (match src
            [(CompilerIrValue.Var v)
              (array-set! memuses v (+ (array-ref memuses v) 1))]
            [_ unit])]
        [_ unit])
      (opt-gep-split-memuses-instrs! instrs (+ index 1) memuses chainuses))))

(define (opt-gep-split-memuses-blocks!
  [blocks : CompilerIrBlockList]
  [memuses : (Array i64)]
  [chainuses : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-split-memuses-instrs! instrs 0 memuses chainuses)
            (opt-gep-split-memuses-blocks! (box-get rest) memuses chainuses))])]
    [(CompilerIrBlockList.Array seq)
      (opt-gep-split-memuses-blocks!
        (compiler-ir-block-seq-to-list seq)
        memuses
        chainuses)]))

;; Record each SIB-scale Gep def's operands for cloning. marks[dst] = 1 means
;; the parallel arrays hold a splittable Gep for dst.
(define (opt-gep-split-geps-instrs!
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [bases : (Array CompilerIrValue)]
  [offsets : (Array CompilerIrValue)]
  [tys : (Array AstType)]
  [marks : (Array i64)]) : unit
  (if (>= index (compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (match (compiler-ir-instr-seq-ref instrs index)
        [(CompilerIrInstr.Gep dst base offset elem-ty)
          (let
            [scale : i64
              (opt-scratch-alloc-type-size type-segment-bases elem-ty)]
            (if (or (= scale 1) (= scale 2) (= scale 4) (= scale 8))
              (begin
                (array-set! bases dst base)
                (array-set! offsets dst offset)
                (array-set! tys dst elem-ty)
                (array-set! marks dst 1))
              unit))]
        [_ unit])
      (opt-gep-split-geps-instrs!
        type-segment-bases
        instrs
        (+ index 1)
        bases
        offsets
        tys
        marks))))

(define (opt-gep-split-geps-blocks!
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [bases : (Array CompilerIrValue)]
  [offsets : (Array CompilerIrValue)]
  [tys : (Array AstType)]
  [marks : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-split-geps-instrs!
              type-segment-bases
              instrs
              0
              bases
              offsets
              tys
              marks)
            (opt-gep-split-geps-blocks!
              type-segment-bases
              (box-get rest)
              bases
              offsets
              tys
              marks))])]
    [(CompilerIrBlockList.Array seq)
      (opt-gep-split-geps-blocks!
        type-segment-bases
        (compiler-ir-block-seq-to-list seq)
        bases
        offsets
        tys
        marks)]))

;; A base/index operand is safe to re-evaluate at every use when it is not the
;; Gep's own dst and has exactly one source (a literal is always fine).
(define (opt-gep-split-source-ok?
  [value : CompilerIrValue]
  [self : i64]
  [defs : (Array i64)]) : bool
  (match value
    [(CompilerIrValue.Var v) (and (!= v self) (= (array-ref defs v) 1))]
    [_ true]))

(define (opt-gep-split-candidate?
  [v : i64]
  [uses : (Array i64)]
  [memuses : (Array i64)]
  [chainuses : (Array i64)]
  [defs : (Array i64)]
  [marks : (Array i64)]
  [bases : (Array CompilerIrValue)]
  [offsets : (Array CompilerIrValue)]) : bool
  (and
    (= (array-ref marks v) 1)
    (or (>= (array-ref uses v) 2) (>= (array-ref chainuses v) 1))
    ;; every use is a memory address (Load src / StorePtr dst): the total use
    ;; count equals the address-use count.
    (= (array-ref uses v) (array-ref memuses v))
    (opt-gep-split-source-ok? (array-ref bases v) v defs)
    (opt-gep-split-source-ok? (array-ref offsets v) v defs)))

;; Compute the final candidate set: splittable Geps with >= 2 uses, or one
;; zero-Gep chain use, all of them memory addresses, with single-source
;; base/index. Fills every entry (no early exit) and returns whether any
;; candidate exists.
(define (opt-gep-split-candidates!
  [cands : (Array i64)]
  [uses : (Array i64)]
  [memuses : (Array i64)]
  [chainuses : (Array i64)]
  [defs : (Array i64)]
  [marks : (Array i64)]
  [bases : (Array CompilerIrValue)]
  [offsets : (Array CompilerIrValue)]
  [v : i64]
  [found : bool]) : bool
  (if (< v 0)
    found
    (opt-gep-split-candidates!
      cands
      uses
      memuses
      chainuses
      defs
      marks
      bases
      offsets
      (- v 1)
      (if (opt-gep-split-candidate?
        v
        uses
        memuses
        chainuses
        defs
        marks
        bases
        offsets)
        (begin
          (array-set! cands v 1)
          true)
        found))))

;; One fresh single-use Gep immediately before its Load/StorePtr use.
(define (opt-gep-split-rewrite-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [cands : (Array i64)]
  [bases : (Array CompilerIrValue)]
  [offsets : (Array CompilerIrValue)]
  [tys : (Array AstType)]
  [cell : (Array i64)]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (CompilerIrInstrList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(CompilerIrInstr.Gep dst base offset ty)
          (match base
            [(CompilerIrValue.Var v)
              (match offset
                [(CompilerIrValue.I64 n)
                  (if (and (= n 0) (= (array-ref cands v) 1))
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Gep
                        dst
                        (array-ref bases v)
                        (array-ref offsets v)
                        (array-ref tys v))
                      (opt-gep-split-rewrite-instrs
                        instrs
                        (+ index 1)
                        cands
                        bases
                        offsets
                        tys
                        cell))
                    (compiler-ir-instr-cons
                      instr
                      (opt-gep-split-rewrite-instrs
                        instrs
                        (+ index 1)
                        cands
                        bases
                        offsets
                        tys
                        cell)))]
                [_
                  (compiler-ir-instr-cons
                    instr
                    (opt-gep-split-rewrite-instrs
                      instrs
                      (+ index 1)
                      cands
                      bases
                      offsets
                      tys
                      cell))])]
            [_
              (compiler-ir-instr-cons
                instr
                (opt-gep-split-rewrite-instrs
                  instrs
                  (+ index 1)
                  cands
                  bases
                  offsets
                  tys
                  cell))])]
        [(CompilerIrInstr.Load dst src ty)
          (match src
            [(CompilerIrValue.Var v)
              (if (= (array-ref cands v) 1)
                (let
                  [fresh : i64 (opt-bce-version-alloc-var cell)]
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Gep
                      fresh
                      (array-ref bases v)
                      (array-ref offsets v)
                      (array-ref tys v))
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Load dst (CompilerIrValue.Var fresh) ty)
                      (opt-gep-split-rewrite-instrs
                        instrs
                        (+ index 1)
                        cands
                        bases
                        offsets
                        tys
                        cell))))
                (compiler-ir-instr-cons
                  instr
                  (opt-gep-split-rewrite-instrs
                    instrs
                    (+ index 1)
                    cands
                    bases
                    offsets
                    tys
                    cell)))]
            [_
              (compiler-ir-instr-cons
                instr
                (opt-gep-split-rewrite-instrs
                  instrs
                  (+ index 1)
                  cands
                  bases
                  offsets
                  tys
                  cell))])]
        [(CompilerIrInstr.StorePtr dst value ty)
          (match dst
            [(CompilerIrValue.Var v)
              (if (= (array-ref cands v) 1)
                (let
                  [fresh : i64 (opt-bce-version-alloc-var cell)]
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Gep
                      fresh
                      (array-ref bases v)
                      (array-ref offsets v)
                      (array-ref tys v))
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.StorePtr
                        (CompilerIrValue.Var fresh)
                        value
                        ty)
                      (opt-gep-split-rewrite-instrs
                        instrs
                        (+ index 1)
                        cands
                        bases
                        offsets
                        tys
                        cell))))
                (compiler-ir-instr-cons
                  instr
                  (opt-gep-split-rewrite-instrs
                    instrs
                    (+ index 1)
                    cands
                    bases
                    offsets
                    tys
                    cell)))]
            [_
              (compiler-ir-instr-cons
                instr
                (opt-gep-split-rewrite-instrs
                  instrs
                  (+ index 1)
                  cands
                  bases
                  offsets
                  tys
                  cell))])]
        [(CompilerIrInstr.Mov dst src mov-ty)
          ;; `dst = Mov gep` becomes `dst = Gep base, offset`: the copy was
          ;; just staging the address, so the fresh single-use Gep feeds the
          ;; backend's indexed fusion directly.
          (match src
            [(CompilerIrValue.Var v)
              (if (= (array-ref cands v) 1)
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Gep
                    dst
                    (array-ref bases v)
                    (array-ref offsets v)
                    (array-ref tys v))
                  (opt-gep-split-rewrite-instrs
                    instrs
                    (+ index 1)
                    cands
                    bases
                    offsets
                    tys
                    cell))
                (compiler-ir-instr-cons
                  instr
                  (opt-gep-split-rewrite-instrs
                    instrs
                    (+ index 1)
                    cands
                    bases
                    offsets
                    tys
                    cell)))]
            [_
              (compiler-ir-instr-cons
                instr
                (opt-gep-split-rewrite-instrs
                  instrs
                  (+ index 1)
                  cands
                  bases
                  offsets
                  tys
                  cell))])]
        [_
          (compiler-ir-instr-cons
            instr
            (opt-gep-split-rewrite-instrs
              instrs
              (+ index 1)
              cands
              bases
              offsets
              tys
              cell))]))))

(define (opt-gep-split-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [cands : (Array i64)]
  [bases : (Array CompilerIrValue)]
  [offsets : (Array CompilerIrValue)]
  [tys : (Array AstType)]
  [cell : (Array i64)]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (compiler-ir-block
              label
              (opt-gep-split-rewrite-instrs
                instrs
                0
                cands
                bases
                offsets
                tys
                cell))
            (opt-gep-split-rewrite-blocks
              (box-get rest)
              cands
              bases
              offsets
              tys
              cell))])]
    [(CompilerIrBlockList.Array seq)
      (opt-gep-split-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        cands
        bases
        offsets
        tys
        cell)]))

(define (opt-gep-split-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (opt-gep-split-function-inner type-segment-bases func))

(define (opt-gep-split-function-inner
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [uses : (Array i64) (opt-collect-blocks-uses-array frame blocks)]
        [memuses : (Array i64) (array.make-array i64 frame)]
        [chainuses : (Array i64) (array.make-array i64 frame)]
        [defs : (Array i64) (array.make-array i64 frame)]
        [bases : (Array CompilerIrValue)
          (array.make-array CompilerIrValue frame)]
        [offsets : (Array CompilerIrValue)
          (array.make-array CompilerIrValue frame)]
        [tys : (Array AstType) (array.make-array AstType frame)]
        [marks : (Array i64) (array.make-array i64 frame)]
        [cands : (Array i64) (array.make-array i64 frame)]
        [_uses : unit (opt-gep-split-memuses-blocks! blocks memuses chainuses)]
        [_defs : unit
          (begin
            (opt-gep-split-seed-params! params defs)
            (opt-gep-split-defs-blocks! blocks defs))]
        [_geps : unit
          (opt-gep-split-geps-blocks!
            type-segment-bases
            blocks
            bases
            offsets
            tys
            marks)]
        [any? : bool
          (opt-gep-split-candidates!
            cands
            uses
            memuses
            chainuses
            defs
            marks
            bases
            offsets
            (- frame 1)
            false)]
        (if (not any?)
          func
          (let
            [cell : (Array i64) (array.make-array i64 1)]
            [_cell : unit (array-set! cell 0 frame)]
            [next-blocks : CompilerIrBlockList
              (opt-gep-split-rewrite-blocks blocks cands bases offsets tys cell)]
            [next : CompilerIrFunction
              (CompilerIrFunction.Function
                name
                params
                ret-ty
                (array-ref cell 0)
                next-blocks)]
            (match (opt-verify-function next)
              [(ResultCompilerOptimizeVerify.Ok) next]
              [(ResultCompilerOptimizeVerify.Err _) func]))))]))

;; Sink a compare whose only block-local use is the block's final Branch to
;; the instruction right before that Branch. The backend fuses a
;; compare+branch pair (cmp;jcc) only when they are adjacent, and a
;; loop-closing compare is often separated from its branch by a flag-safe
;; pointer-increment Gep (the counted-fill shape), forcing the
;; setl/movzbq/test/jne materialization instead. The move is pure scheduling:
;; it fires only when no intervening instruction reads the compare's result
;; or redefines its operands.
;;
;; Scan backward from the branch for the cond var's definition. Returns the
;; defining compare's index, or -1 if a use of the cond var or a non-compare
;; definition comes first.
(define (opt-cmp-sink-find-compare
  [instrs : CompilerIrInstrSeq]
  [cond-var : i64]
  [index : i64]) : i64
  (if (< index 0)
    (- 0 1)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(CompilerIrInstr.BinOp dst op lhs rhs _)
          (if (= dst cond-var)
            (if (opt-bool-branch-compare-op? op)
              index
              (- 0 1))
            (if (or
              (opt-value-is-var? lhs cond-var)
              (opt-value-is-var? rhs cond-var))
              (- 0 1)
              (opt-cmp-sink-find-compare instrs cond-var (- index 1))))]
        [_
          (if (or
            (= (opt-gvn-instr-dst instr) cond-var)
            (opt-cmp-sink-instr-uses-var? instr cond-var))
            (- 0 1)
            (opt-cmp-sink-find-compare instrs cond-var (- index 1)))]))))

;; Conservative operand-position use check for the instructions that can sit
;; between a loop-closing compare and its branch (Mov/Gep/Load/Cast/Bitcast/
;; UnOp/BinOp and other non-terminators). Unknown kinds count as using the var.
(define (opt-cmp-sink-instr-uses-var? [instr : CompilerIrInstr] [var : i64]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ src _) (opt-value-is-var? src var)]
    [(CompilerIrInstr.Gep _ base offset _)
      (or (opt-value-is-var? base var) (opt-value-is-var? offset var))]
    [(CompilerIrInstr.Load _ src _) (opt-value-is-var? src var)]
    [(CompilerIrInstr.Cast _ src _ _) (opt-value-is-var? src var)]
    [(CompilerIrInstr.Bitcast _ src _ _) (opt-value-is-var? src var)]
    [(CompilerIrInstr.UnOp _ _ src _) (opt-value-is-var? src var)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (or (opt-value-is-var? lhs var) (opt-value-is-var? rhs var))]
    [_ true]))

;; Every instruction strictly between `def-index` and the block's final
;; Branch must leave the compare's operands (and its result) untouched.
(define (opt-cmp-sink-clear?
  [instrs : CompilerIrInstrSeq]
  [def-index : i64]
  [last : i64]
  [cond-var : i64]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : bool
  (if (>= def-index last)
    true
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs def-index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      (if (or
        (= dst cond-var)
        (opt-value-is-var? lhs dst)
        (opt-value-is-var? rhs dst))
        false
        (opt-cmp-sink-clear? instrs (+ def-index 1) last cond-var lhs rhs)))))

(define (opt-cmp-sink-move-onto
  [instrs : CompilerIrInstrSeq]
  [def-index : i64]
  [index : i64]
  [out : CompilerIrInstrList]) : CompilerIrInstrList
  (if (< index 0)
    out
    (opt-cmp-sink-move-onto
      instrs
      def-index
      (- index 1)
      (if (= index def-index)
        out
        (compiler-ir-instr-cons (compiler-ir-instr-seq-ref instrs index) out)))))

(define (opt-cmp-sink-block-pass [block : CompilerIrBlock]) : OptBlockPassResult
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (< count 3)
          (OptBlockPassResult.Result block false)
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(CompilerIrInstr.Branch (CompilerIrValue.Var cond-var) _ _)
              (let
                [def-index : i64
                  (opt-cmp-sink-find-compare instrs cond-var (- count 2))]
                (if (or (< def-index 0) (= def-index (- count 2)))
                  (OptBlockPassResult.Result block false)
                  (match (compiler-ir-instr-seq-ref instrs def-index)
                    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
                      (if (opt-cmp-sink-clear?
                        instrs
                        (+ def-index 1)
                        (- count 1)
                        cond-var
                        lhs
                        rhs)
                        (OptBlockPassResult.Result
                          (compiler-ir-block
                            label
                            (opt-cmp-sink-move-onto
                              instrs
                              def-index
                              (- count 2)
                              (compiler-ir-instr-cons
                                (compiler-ir-instr-seq-ref instrs def-index)
                                (compiler-ir-instr-cons
                                  (compiler-ir-instr-seq-ref instrs (- count 1))
                                  CompilerIrInstrList.Nil))))
                          true)
                        (OptBlockPassResult.Result block false))]
                    [_ (OptBlockPassResult.Result block false)])))]
            [_ (OptBlockPassResult.Result block false)])))]))

(define (opt-cmp-sink-blocks-pass [blocks : CompilerIrBlockList]) : OptBlockListPassResult
  (match blocks
    [(CompilerIrBlockList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-cmp-sink-block-pass block)
        [(OptBlockPassResult.Result next-block block-changed)
          (match (opt-cmp-sink-blocks-pass (box-get rest))
            [(OptBlockListPassResult.Result next-rest rest-changed)
              (if (or block-changed rest-changed)
                (OptBlockListPassResult.Result
                  (compiler-ir-block-cons next-block next-rest)
                  true)
                (OptBlockListPassResult.Result blocks false))])])]
    [(CompilerIrBlockList.Array seq)
      (match (opt-cmp-sink-blocks-pass (compiler-ir-block-seq-to-list seq))
        [(OptBlockListPassResult.Result next changed)
          (if changed
            (OptBlockListPassResult.Result next true)
            (OptBlockListPassResult.Result blocks false))])]))

(define (opt-cmp-sink-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match (opt-cmp-sink-blocks-pass blocks)
    [(OptBlockListPassResult.Result next _) next]))

;; --- single-predecessor successor sinking ----------------------------------
;;
;; Move a pure definition out of a Branch/Switch block when all of its uses
;; occur in one successor and that successor has no other predecessor. The
;; single-predecessor rule guarantees that the move cannot increase execution
;; count and makes dominance straightforward on verified SSA. Scanning the
;; source block backward lets a moved consumer make its own producers eligible
;; in the same pass (the Load -> Pack chain in enum dispatch is the motivating
;; shape).
(defenum OptSuccessorSinkMove
  ;; `removed` marks original source instructions that move with this bundle.
  ;; `origins[i]` is that source index for a moved instruction and -1 for a
  ;; rematerialized clone. Keeping the distinction makes use accounting ignore
  ;; new clone uses when deciding whether another original producer can move.
  (Move i64 (Array i64) i64 CompilerIrInstrSeq (Array i64)))

(defenum OptSuccessorSinkMoves
  (Nil)
  (Cons OptSuccessorSinkMove (Box OptSuccessorSinkMoves)))

(defenum OptSuccessorSinkMaybeLabel
  (No)
  (Some i64))

(defenum OptSuccessorSinkPrepared
  (No)
  (Some CompilerIrInstrSeq (Array i64) (Array i64)))

(defenum OptSuccessorSinkMaybeInstr
  (No)
  (Some CompilerIrInstr))

(defenum OptSuccessorSinkMaybeRecipe
  (No)
  (Some CompilerIrInstr CompilerIrValue AstType))

(defenum OptSuccessorSinkMaybeInductionShape
  (No)
  (Some i64 i64))

(defstruct OptSuccessorSinkPrepareContext
  (frame i64)
  (target i64)
  (blocks CompilerIrBlockList)
  (instrs CompilerIrInstrSeq)
  (terminator-index i64)
  (defs (Array i64))
  (all-defs (Array i64))
  (source-loop-target bool)
  (total-uses (Array i64))
  (base-allowed (Array i64))
  (leaf-uses (Array i64))
  (terminator-live (Array i64))
  (loop-phi-leaves (Array i64))
  (covered-uses (Array i64))
  (planned (Array i64))
  (visiting (Array i64))
  (remap (Array i64))
  (removed (Array i64))
  (frame-cell (Array i64))
  (clone-count (Array i64)))

(define (opt-successor-sink-binop? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Div) false]
    [(CompilerIrBinOp.Mod) false]
    [(CompilerIrBinOp.SafeDiv) false]
    [(CompilerIrBinOp.SafeMod) false]
    ;; Scalar shifts have language-level abort checks for invalid counts.
    [(CompilerIrBinOp.Shl) false]
    [(CompilerIrBinOp.Shr) false]
    [_ true]))

;; `Global`/`RuntimeGlobal` operands are implicit mutable reads, not stable
;; scalar values. The listed instruction forms are pure only when their value
;; operands do not introduce one of those hidden reads.
(define (opt-successor-sink-stable-value? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Global _) false]
    [(CompilerIrValue.RuntimeGlobal _) false]
    [_ true]))

(define (opt-successor-sink-stable-values? [values : CompilerIrValueList]) : bool
  (match values
    [(CompilerIrValueList.Nil) true]
    [(CompilerIrValueList.Array seq)
      (opt-successor-sink-stable-values? (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (and
        (opt-successor-sink-stable-value? value)
        (opt-successor-sink-stable-values? (box-get rest)))]))

(define (opt-successor-sink-load-barrier? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Store _ _ _) true]
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [(CompilerIrInstr.CopyBytes _ _ _) true]
    [(CompilerIrInstr.BoundsCheck _ _ _) true]
    [(CompilerIrInstr.Call _ _ _ _) true]
    [(CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(CompilerIrInstr.CallCAbiStoreResult _) true]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult _) true]
    [(CompilerIrInstr.SpmdCall _) true]
    [(CompilerIrInstr.TailCall _ _ _) true]
    [(CompilerIrInstr.TailCallIndirect _ _ _) true]
    [(CompilerIrInstr.Syscall _ _) true]
    ;; These are stores as well, even though the first-cut scalar rule does not
    ;; otherwise schedule vector instructions.
    [(CompilerIrInstr.VectorStore _) true]
    [(CompilerIrInstr.PredicatedStore _) true]
    [_ false]))

(define (opt-successor-sink-load-clear-to-terminator?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [terminator-index : i64]) : bool
  (if (>= index terminator-index)
    true
    (if (opt-successor-sink-load-barrier?
      (compiler-ir-instr-seq-ref instrs index))
      false
      (opt-successor-sink-load-clear-to-terminator?
        instrs
        (+ index 1)
        terminator-index))))

(define (opt-successor-sink-candidate?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [terminator-index : i64]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ src _) (opt-successor-sink-stable-value? src)]
    [(CompilerIrInstr.Gep _ base offset _)
      (and
        (opt-successor-sink-stable-value? base)
        (opt-successor-sink-stable-value? offset))]
    [(CompilerIrInstr.Load _ src _)
      (and
        (opt-successor-sink-stable-value? src)
        (opt-successor-sink-load-clear-to-terminator?
          instrs
          (+ index 1)
          terminator-index))]
    [(CompilerIrInstr.Cast _ src _ _) (opt-successor-sink-stable-value? src)]
    [(CompilerIrInstr.Bitcast _ src _ _) (opt-successor-sink-stable-value? src)]
    [(CompilerIrInstr.BinOp _ op lhs rhs _)
      (and
        (opt-successor-sink-binop? op)
        (opt-successor-sink-stable-value? lhs)
        (opt-successor-sink-stable-value? rhs))]
    [(CompilerIrInstr.UnOp _ _ src _) (opt-successor-sink-stable-value? src)]
    [(CompilerIrInstr.Pack _ words _) (opt-successor-sink-stable-values? words)]
    [(CompilerIrInstr.Word _ src _ _) (opt-successor-sink-stable-value? src)]
    [_ false]))

;; Rematerialization is intentionally narrower than ordinary sinking. Loads
;; and even otherwise-pure Mov/Cast forms may hide mutable or non-local facts;
;; address arithmetic is limited to non-trapping Gep/BinOp producers.
(define (opt-successor-sink-remat-candidate? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Gep _ base offset _)
      (and
        (opt-successor-sink-stable-value? base)
        (opt-successor-sink-stable-value? offset))]
    [(CompilerIrInstr.BinOp _ op lhs rhs _)
      (and
        (opt-successor-sink-binop? op)
        (opt-successor-sink-stable-value? lhs)
        (opt-successor-sink-stable-value? rhs))]
    [_ false]))

(define (opt-successor-sink-subst-value
  [frame : i64]
  [remap : (Array i64)]
  [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var var)
      (if (and (>= var 0) (< var frame) (> (array-ref remap var) 0))
        (CompilerIrValue.Var (- (array-ref remap var) 1))
        value)]
    [_ value]))

(define (opt-successor-sink-subst-values
  [frame : i64]
  [remap : (Array i64)]
  [values : CompilerIrValueList]) : CompilerIrValueList
  (match values
    [(CompilerIrValueList.Nil) CompilerIrValueList.Nil]
    [(CompilerIrValueList.Array seq)
      (opt-successor-sink-subst-values
        frame
        remap
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (compiler-ir-value-cons
        (opt-successor-sink-subst-value frame remap value)
        (opt-successor-sink-subst-values frame remap (box-get rest)))]))

(define (opt-successor-sink-subst-instr
  [frame : i64]
  [remap : (Array i64)]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (CompilerIrInstr.Mov
        dst
        (opt-successor-sink-subst-value frame remap src)
        ty)]
    [(CompilerIrInstr.Gep dst base offset ty)
      (CompilerIrInstr.Gep
        dst
        (opt-successor-sink-subst-value frame remap base)
        (opt-successor-sink-subst-value frame remap offset)
        ty)]
    [(CompilerIrInstr.Load dst src ty)
      (CompilerIrInstr.Load
        dst
        (opt-successor-sink-subst-value frame remap src)
        ty)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (CompilerIrInstr.Cast
        dst
        (opt-successor-sink-subst-value frame remap src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (CompilerIrInstr.Bitcast
        dst
        (opt-successor-sink-subst-value frame remap src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (CompilerIrInstr.BinOp
        dst
        op
        (opt-successor-sink-subst-value frame remap lhs)
        (opt-successor-sink-subst-value frame remap rhs)
        ty)]
    [(CompilerIrInstr.UnOp dst op src ty)
      (CompilerIrInstr.UnOp
        dst
        op
        (opt-successor-sink-subst-value frame remap src)
        ty)]
    [(CompilerIrInstr.Pack dst words ty)
      (CompilerIrInstr.Pack
        dst
        (opt-successor-sink-subst-values frame remap words)
        ty)]
    [(CompilerIrInstr.Word dst src index ty)
      (CompilerIrInstr.Word
        dst
        (opt-successor-sink-subst-value frame remap src)
        index
        ty)]
    [_ instr]))

(define (opt-successor-sink-remat-clone [fresh : i64] [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Gep _ base offset ty)
      (CompilerIrInstr.Gep fresh base offset ty)]
    [(CompilerIrInstr.BinOp _ op lhs rhs ty)
      (CompilerIrInstr.BinOp fresh op lhs rhs ty)]
    [_ instr]))

(define (opt-successor-sink-find-def-in-seq
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptSuccessorSinkMaybeInstr
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptSuccessorSinkMaybeInstr.No)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (= dst var)
            (OptSuccessorSinkMaybeInstr.Some instr)
            (opt-successor-sink-find-def-in-seq instrs (+ index 1) var))]
        [(option_i64.None)
          (opt-successor-sink-find-def-in-seq instrs (+ index 1) var)]))))

(define (opt-successor-sink-find-def [blocks : CompilerIrBlockList] [var : i64]) : OptSuccessorSinkMaybeInstr
  (match blocks
    [(CompilerIrBlockList.Nil) (OptSuccessorSinkMaybeInstr.No)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (opt-successor-sink-find-def-in-seq instrs 0 var)
            [(OptSuccessorSinkMaybeInstr.Some instr)
              (OptSuccessorSinkMaybeInstr.Some instr)]
            [(OptSuccessorSinkMaybeInstr.No)
              (opt-successor-sink-find-def (box-get rest) var)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-successor-sink-find-def (compiler-ir-block-seq-to-list seq) var)]))

(define (opt-successor-sink-value-i64
  [blocks : CompilerIrBlockList]
  [value : CompilerIrValue]) : option_i64.Option
  (match value
    [(CompilerIrValue.I64 n) (option_i64.Some n)]
    [(CompilerIrValue.Var var)
      (match (opt-successor-sink-find-def blocks var)
        [(OptSuccessorSinkMaybeInstr.Some instr)
          (match instr
            [(CompilerIrInstr.Mov _ (CompilerIrValue.I64 n) _)
              (option_i64.Some n)]
            [_ (option_i64.None)])]
        [(OptSuccessorSinkMaybeInstr.No) (option_i64.None)])]
    [_ (option_i64.None)]))

(define (opt-successor-sink-value-zero?
  [blocks : CompilerIrBlockList]
  [value : CompilerIrValue]) : bool
  (match (opt-successor-sink-value-i64 blocks value)
    [(option_i64.Some n) (= n 0)]
    [(option_i64.None)
      (match value
        [(CompilerIrValue.Var var)
          (match (opt-successor-sink-find-def blocks var)
            [(OptSuccessorSinkMaybeInstr.Some instr)
              (match instr
                [(CompilerIrInstr.BinOp _ (CompilerIrBinOp.Mul) lhs rhs _)
                  (or
                    (opt-successor-sink-value-zero? blocks lhs)
                    (opt-successor-sink-value-zero? blocks rhs))]
                [_ false])]
            [(OptSuccessorSinkMaybeInstr.No) false])]
        [_ false])]))

(define (opt-successor-sink-phi-zero-label
  [blocks : CompilerIrBlockList]
  [inputs : CompilerIrPhiInputList]) : OptSuccessorSinkMaybeLabel
  (match inputs
    [(CompilerIrPhiInputList.Nil) (OptSuccessorSinkMaybeLabel.No)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-phi-zero-label
        blocks
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (opt-successor-sink-value-zero? blocks value)
        (OptSuccessorSinkMaybeLabel.Some label)
        (opt-successor-sink-phi-zero-label blocks (box-get rest)))]))

(define (opt-successor-sink-phi-unit-step-value?
  [blocks : CompilerIrBlockList]
  [phi-var : i64]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var input-var)
      (match (opt-successor-sink-find-def blocks input-var)
        [(OptSuccessorSinkMaybeInstr.Some instr)
          (match instr
            [(CompilerIrInstr.BinOp _ (CompilerIrBinOp.Add) lhs rhs _)
              (or
                (and
                  (opt-value-is-var? lhs phi-var)
                  (match (opt-successor-sink-value-i64 blocks rhs)
                    [(option_i64.Some step) (= step 1)]
                    [(option_i64.None) false]))
                (and
                  (opt-value-is-var? rhs phi-var)
                  (match (opt-successor-sink-value-i64 blocks lhs)
                    [(option_i64.Some step) (= step 1)]
                    [(option_i64.None) false])))]
            [_ false])]
        [(OptSuccessorSinkMaybeInstr.No) false])]
    [_ false]))

(define (opt-successor-sink-phi-unit-step-label
  [blocks : CompilerIrBlockList]
  [phi-var : i64]
  [inputs : CompilerIrPhiInputList]) : OptSuccessorSinkMaybeLabel
  (match inputs
    [(CompilerIrPhiInputList.Nil) (OptSuccessorSinkMaybeLabel.No)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-phi-unit-step-label
        blocks
        phi-var
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (opt-successor-sink-phi-unit-step-value? blocks phi-var value)
        (OptSuccessorSinkMaybeLabel.Some label)
        (opt-successor-sink-phi-unit-step-label blocks phi-var (box-get rest)))]))

(define (opt-successor-sink-iv-phi-shape
  [blocks : CompilerIrBlockList]
  [phi-var : i64]
  [inputs : CompilerIrPhiInputList]) : OptSuccessorSinkMaybeInductionShape
  (if (not (= (compiler-ir-phi-input-list-count inputs) 2))
    (OptSuccessorSinkMaybeInductionShape.No)
    (match (opt-successor-sink-phi-zero-label blocks inputs)
      [(OptSuccessorSinkMaybeLabel.No) (OptSuccessorSinkMaybeInductionShape.No)]
      [(OptSuccessorSinkMaybeLabel.Some seed-label)
        (match (opt-successor-sink-phi-unit-step-label blocks phi-var inputs)
          [(OptSuccessorSinkMaybeLabel.No)
            (OptSuccessorSinkMaybeInductionShape.No)]
          [(OptSuccessorSinkMaybeLabel.Some step-label)
            (if (= seed-label step-label)
              (OptSuccessorSinkMaybeInductionShape.No)
              (OptSuccessorSinkMaybeInductionShape.Some seed-label step-label))])])))

(define (opt-successor-sink-pointer-seed-value?
  [blocks : CompilerIrBlockList]
  [expected-base : CompilerIrValue]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var input-var)
      (match (opt-successor-sink-find-def blocks input-var)
        [(OptSuccessorSinkMaybeInstr.Some instr)
          (match instr
            [(CompilerIrInstr.Gep _ base offset _)
              (and
                (opt-value-eq base expected-base)
                (opt-successor-sink-value-zero? blocks offset))]
            [_ false])]
        [(OptSuccessorSinkMaybeInstr.No) false])]
    [_ false]))

(define (opt-successor-sink-pointer-step-value?
  [blocks : CompilerIrBlockList]
  [phi-var : i64]
  [scale : i64]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var input-var)
      (match (opt-successor-sink-find-def blocks input-var)
        [(OptSuccessorSinkMaybeInstr.Some instr)
          (match instr
            [(CompilerIrInstr.Gep _ base offset _)
              (and
                (opt-value-is-var? base phi-var)
                (match (opt-successor-sink-value-i64 blocks offset)
                  [(option_i64.Some found) (= found scale)]
                  [(option_i64.None) false]))]
            [_ false])]
        [(OptSuccessorSinkMaybeInstr.No) false])]
    [_ false]))

(define (opt-successor-sink-pointer-edge-label
  [blocks : CompilerIrBlockList]
  [phi-var : i64]
  [base : CompilerIrValue]
  [scale : i64]
  [want-step : bool]
  [inputs : CompilerIrPhiInputList]) : OptSuccessorSinkMaybeLabel
  (match inputs
    [(CompilerIrPhiInputList.Nil) (OptSuccessorSinkMaybeLabel.No)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-pointer-edge-label
        blocks
        phi-var
        base
        scale
        want-step
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value label rest)
      (if (if want-step
        (opt-successor-sink-pointer-step-value? blocks phi-var scale value)
        (opt-successor-sink-pointer-seed-value? blocks base value))
        (OptSuccessorSinkMaybeLabel.Some label)
        (opt-successor-sink-pointer-edge-label
          blocks
          phi-var
          base
          scale
          want-step
          (box-get rest)))]))

(define (opt-successor-sink-pointer-phi-shape
  [blocks : CompilerIrBlockList]
  [phi-var : i64]
  [base : CompilerIrValue]
  [scale : i64]
  [inputs : CompilerIrPhiInputList]) : OptSuccessorSinkMaybeInductionShape
  (if (not (= (compiler-ir-phi-input-list-count inputs) 2))
    (OptSuccessorSinkMaybeInductionShape.No)
    (match (opt-successor-sink-pointer-edge-label
      blocks
      phi-var
      base
      scale
      false
      inputs)
      [(OptSuccessorSinkMaybeLabel.No) (OptSuccessorSinkMaybeInductionShape.No)]
      [(OptSuccessorSinkMaybeLabel.Some seed-label)
        (match (opt-successor-sink-pointer-edge-label
          blocks
          phi-var
          base
          scale
          true
          inputs)
          [(OptSuccessorSinkMaybeLabel.No)
            (OptSuccessorSinkMaybeInductionShape.No)]
          [(OptSuccessorSinkMaybeLabel.Some step-label)
            (if (= seed-label step-label)
              (OptSuccessorSinkMaybeInductionShape.No)
              (OptSuccessorSinkMaybeInductionShape.Some seed-label step-label))])])))

(define (opt-successor-sink-phi-update-scale
  [blocks : CompilerIrBlockList]
  [phi-var : i64]
  [inputs : CompilerIrPhiInputList]) : option_i64.Option
  (match inputs
    [(CompilerIrPhiInputList.Nil) (option_i64.None)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-phi-update-scale
        blocks
        phi-var
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (let
        [found : option_i64.Option
          (match value
            [(CompilerIrValue.Var input-var)
              (match (opt-successor-sink-find-def blocks input-var)
                [(OptSuccessorSinkMaybeInstr.Some instr)
                  (match instr
                    [(CompilerIrInstr.Gep _ base offset _)
                      (if (opt-value-is-var? base phi-var)
                        (opt-successor-sink-value-i64 blocks offset)
                        (option_i64.None))]
                    [_ (option_i64.None)])]
                [(OptSuccessorSinkMaybeInstr.No) (option_i64.None)])]
            [_ (option_i64.None)])]
        (match found
          [(option_i64.Some scale) (option_i64.Some scale)]
          [(option_i64.None)
            (opt-successor-sink-phi-update-scale blocks phi-var (box-get rest))]))]))

(define (opt-successor-sink-mul-scale-source
  [blocks : CompilerIrBlockList]
  [defs : (Array i64)]
  [frame : i64]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [scale : i64]) : bool
  (match lhs
    [(CompilerIrValue.Var iv)
      (and
        (>= iv 0)
        (< iv frame)
        (> (array-ref defs iv) 0)
        (match (opt-successor-sink-value-i64 blocks rhs)
          [(option_i64.Some n) (= n scale)]
          [(option_i64.None) false])
        (match (opt-successor-sink-find-def blocks iv)
          [(OptSuccessorSinkMaybeInstr.Some instr)
            (match instr
              [(CompilerIrInstr.Phi _ inputs _)
                (match (opt-successor-sink-iv-phi-shape blocks iv inputs)
                  [(OptSuccessorSinkMaybeInductionShape.Some _ _) true]
                  [(OptSuccessorSinkMaybeInductionShape.No) false])]
              [_ false])]
          [(OptSuccessorSinkMaybeInstr.No) false]))]
    [_ false]))

(define (opt-successor-sink-mul-scale-var
  [blocks : CompilerIrBlockList]
  [defs : (Array i64)]
  [frame : i64]
  [scale : i64]
  [instr : CompilerIrInstr]) : option_i64.Option
  (match instr
    [(CompilerIrInstr.BinOp _ (CompilerIrBinOp.Mul) lhs rhs _)
      (match lhs
        [(CompilerIrValue.Var iv)
          (if (opt-successor-sink-mul-scale-source
            blocks
            defs
            frame
            lhs
            rhs
            scale)
            (option_i64.Some iv)
            (match rhs
              [(CompilerIrValue.Var other-iv)
                (if (opt-successor-sink-mul-scale-source
                  blocks
                  defs
                  frame
                  rhs
                  lhs
                  scale)
                  (option_i64.Some other-iv)
                  (option_i64.None))]
              [_ (option_i64.None)]))]
        [_
          (match rhs
            [(CompilerIrValue.Var iv)
              (if (opt-successor-sink-mul-scale-source
                blocks
                defs
                frame
                rhs
                lhs
                scale)
                (option_i64.Some iv)
                (option_i64.None))]
            [_ (option_i64.None)])])]
    [_ (option_i64.None)]))

(define (opt-successor-sink-find-scale-mul
  [blocks : CompilerIrBlockList]
  [instrs : CompilerIrInstrSeq]
  [defs : (Array i64)]
  [frame : i64]
  [scale : i64]
  [index : i64]) : OptSuccessorSinkMaybeInstr
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptSuccessorSinkMaybeInstr.No)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(CompilerIrInstr.BinOp _ (CompilerIrBinOp.Mul) lhs rhs _)
          (if (or
            (opt-successor-sink-mul-scale-source
              blocks
              defs
              frame
              lhs
              rhs
              scale)
            (opt-successor-sink-mul-scale-source
              blocks
              defs
              frame
              rhs
              lhs
              scale))
            (OptSuccessorSinkMaybeInstr.Some instr)
            (opt-successor-sink-find-scale-mul
              blocks
              instrs
              defs
              frame
              scale
              (+ index 1)))]
        [_
          (opt-successor-sink-find-scale-mul
            blocks
            instrs
            defs
            frame
            scale
            (+ index 1))]))))

(define (opt-successor-sink-phi-init-recipe
  [blocks : CompilerIrBlockList]
  [phi-var : i64]
  [inputs : CompilerIrPhiInputList]
  [mul : CompilerIrInstr]) : OptSuccessorSinkMaybeRecipe
  (match inputs
    [(CompilerIrPhiInputList.Nil) (OptSuccessorSinkMaybeRecipe.No)]
    [(CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-phi-init-recipe
        blocks
        phi-var
        (compiler-ir-phi-input-seq-to-list seq)
        mul)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (match value
        [(CompilerIrValue.Var input-var)
          (match (opt-successor-sink-find-def blocks input-var)
            [(OptSuccessorSinkMaybeInstr.Some instr)
              (match instr
                [(CompilerIrInstr.Gep _ base offset ty)
                  (if (and
                    (not (opt-value-is-var? base phi-var))
                    (opt-successor-sink-value-zero? blocks offset))
                    (OptSuccessorSinkMaybeRecipe.Some mul base ty)
                    (opt-successor-sink-phi-init-recipe
                      blocks
                      phi-var
                      (box-get rest)
                      mul))]
                [_
                  (opt-successor-sink-phi-init-recipe
                    blocks
                    phi-var
                    (box-get rest)
                    mul)])]
            [(OptSuccessorSinkMaybeInstr.No)
              (opt-successor-sink-phi-init-recipe
                blocks
                phi-var
                (box-get rest)
                mul)])]
        [_
          (opt-successor-sink-phi-init-recipe blocks phi-var (box-get rest) mul)])]))

;; Induction strength reduction has already rewritten the original
;; `gep base, (iv * scale)` to a pointer phi by the time this late pass runs.
;; Recover that exact bounded recipe from the phi recurrence plus the retained
;; block-local Mul, so sinking a payload address never keeps the pointer phi
;; live across a dispatch.
(define (opt-successor-sink-induction-recipe
  [context : OptSuccessorSinkPrepareContext]
  [phi-var : i64]
  [producer : CompilerIrInstr]) : OptSuccessorSinkMaybeRecipe
  (match producer
    [(CompilerIrInstr.Phi _ inputs _)
      (match (opt-successor-sink-phi-update-scale
        (struct-get context blocks)
        phi-var
        inputs)
        [(option_i64.Some scale)
          (match (opt-successor-sink-find-scale-mul
            (struct-get context blocks)
            (struct-get context instrs)
            (struct-get context defs)
            (struct-get context frame)
            scale
            0)
            [(OptSuccessorSinkMaybeInstr.Some mul)
              (match (opt-successor-sink-phi-init-recipe
                (struct-get context blocks)
                phi-var
                inputs
                mul)
                [(OptSuccessorSinkMaybeRecipe.Some _ base ptr-ty)
                  (match (opt-successor-sink-mul-scale-var
                    (struct-get context blocks)
                    (struct-get context defs)
                    (struct-get context frame)
                    scale
                    mul)
                    [(option_i64.Some iv)
                      (match (opt-successor-sink-find-def
                        (struct-get context blocks)
                        iv)
                        [(OptSuccessorSinkMaybeInstr.Some iv-instr)
                          (match iv-instr
                            [(CompilerIrInstr.Phi _ iv-inputs _)
                              (match (opt-successor-sink-iv-phi-shape
                                (struct-get context blocks)
                                iv
                                iv-inputs)
                                [(OptSuccessorSinkMaybeInductionShape.Some
                                    iv-seed
                                    iv-step)
                                  (match (opt-successor-sink-pointer-phi-shape
                                    (struct-get context blocks)
                                    phi-var
                                    base
                                    scale
                                    inputs)
                                    [(OptSuccessorSinkMaybeInductionShape.Some
                                        ptr-seed
                                        ptr-step)
                                      (if (and
                                        (= iv-seed ptr-seed)
                                        (= iv-step ptr-step))
                                        (OptSuccessorSinkMaybeRecipe.Some
                                          mul
                                          base
                                          ptr-ty)
                                        (OptSuccessorSinkMaybeRecipe.No))]
                                    [(OptSuccessorSinkMaybeInductionShape.No)
                                      (OptSuccessorSinkMaybeRecipe.No)])]
                                [(OptSuccessorSinkMaybeInductionShape.No)
                                  (OptSuccessorSinkMaybeRecipe.No)])]
                            [_ (OptSuccessorSinkMaybeRecipe.No)])]
                        [(OptSuccessorSinkMaybeInstr.No)
                          (OptSuccessorSinkMaybeRecipe.No)])]
                    [(option_i64.None) (OptSuccessorSinkMaybeRecipe.No)])]
                [(OptSuccessorSinkMaybeRecipe.No)
                  (OptSuccessorSinkMaybeRecipe.No)])]
            [(OptSuccessorSinkMaybeInstr.No) (OptSuccessorSinkMaybeRecipe.No)])]
        [(option_i64.None) (OptSuccessorSinkMaybeRecipe.No)])]
    [_ (OptSuccessorSinkMaybeRecipe.No)]))

(define (opt-successor-sink-leading-phi-end
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    index
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ _ _)
        (opt-successor-sink-leading-phi-end instrs (+ index 1))]
      [_ index])))

;; Phi operands are edge uses, so they deliberately are not counted as uses in
;; the successor. The insertion point is immediately after this leading prefix.
(define (opt-successor-sink-collect-successor-uses!
  [cfg : OptCfgIndex]
  [target : i64]
  [uses : (Array i64)]) : unit
  (match (opt-cfg-index-find-block cfg target)
    [(OptMaybeBlock.No) unit]
    [(OptMaybeBlock.Some block)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [index : i64 (opt-successor-sink-leading-phi-end instrs 0)]
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (while (< index count)
              (begin
                (opt-collect-instr-uses-array
                  uses
                  (compiler-ir-instr-seq-ref instrs index))
                (set! index (+ index 1)))))])]))

(define (opt-successor-sink-collect-moved-uses!
  [moves : OptSuccessorSinkMoves]
  [target : i64]
  [uses : (Array i64)]) : unit
  (match moves
    [(OptSuccessorSinkMoves.Nil) unit]
    [(OptSuccessorSinkMoves.Cons move rest)
      (begin
        (match move
          [(OptSuccessorSinkMove.Move _ _ move-target instrs origins)
            (if (= move-target target)
              (let
                [index : i64 0]
                [count : i64 (compiler-ir-instr-seq-count instrs)]
                (while (< index count)
                  (begin
                    ;; Clone uses are new and cannot stand in for an original
                    ;; source use in the all-uses-moving test.
                    (if (>= (array-ref origins index) 0)
                      (opt-collect-instr-uses-array
                        uses
                        (compiler-ir-instr-seq-ref instrs index))
                      unit)
                    (set! index (+ index 1)))))
              unit)])
        (opt-successor-sink-collect-moved-uses! (box-get rest) target uses))]))

(define (opt-successor-sink-single-pred?
  [cfg : OptCfgIndex]
  [source : i64]
  [target : i64]) : bool
  (if (= source target)
    false
    (let
      [preds : OptLabelSet (opt-cfg-index-predecessors cfg target)]
      (and (= (opt-label-count preds) 1) (opt-label-contains preds source)))))

(define (opt-successor-sink-target-all-uses?
  [frame : i64]
  [cfg : OptCfgIndex]
  [total-uses : (Array i64)]
  [allowed-uses : (Array i64)]
  [moves : OptSuccessorSinkMoves]
  [source : i64]
  [target : i64]
  [dst : i64]) : bool
  (if (or (< dst 0) (>= dst frame))
    false
    (let
      [total : i64 (array-ref total-uses dst)]
      (if (or
        (<= total 0)
        (not (opt-successor-sink-single-pred? cfg source target)))
        false
        (begin
          (array-set! allowed-uses dst 0)
          (opt-successor-sink-collect-successor-uses! cfg target allowed-uses)
          (opt-successor-sink-collect-moved-uses! moves target allowed-uses)
          (= (array-ref allowed-uses dst) total))))))

(define (opt-successor-sink-find-target
  [frame : i64]
  [cfg : OptCfgIndex]
  [total-uses : (Array i64)]
  [allowed-uses : (Array i64)]
  [moves : OptSuccessorSinkMoves]
  [source : i64]
  [successors : OptLabelSet]
  [dst : i64]) : OptSuccessorSinkMaybeLabel
  (match successors
    [(OptLabelSet.Nil) (OptSuccessorSinkMaybeLabel.No)]
    [(OptLabelSet.Dense _ _)
      (let
        [target : i64 (opt-label-ref successors 0)]
        (if (opt-successor-sink-target-all-uses?
          frame
          cfg
          total-uses
          allowed-uses
          moves
          source
          target
          dst)
          (OptSuccessorSinkMaybeLabel.Some target)
          (opt-successor-sink-find-target
            frame
            cfg
            total-uses
            allowed-uses
            moves
            source
            (opt-label-tail successors)
            dst)))]))

(define (opt-successor-sink-collect-instr-list-uses!
  [instrs : CompilerIrInstrList]
  [uses : (Array i64)]) : unit
  (match instrs
    [(CompilerIrInstrList.Nil) unit]
    [(CompilerIrInstrList.Cons instr rest)
      (begin
        (opt-collect-instr-uses-array uses instr)
        (opt-successor-sink-collect-instr-list-uses! (box-get rest) uses))]))

(define (opt-successor-sink-fill-defs!
  [frame : i64]
  [instrs : CompilerIrInstrSeq]
  [defs : (Array i64)]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (while (< index count)
      (begin
        (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs index))
          [(option_i64.Some dst)
            (if (and (>= dst 0) (< dst frame))
              (array-set! defs dst (+ index 1))
              unit)]
          [(option_i64.None) unit])
        (set! index (+ index 1))))))

(define (opt-successor-sink-mark-terminator-live!
  [frame : i64]
  [instrs : CompilerIrInstrSeq]
  [terminator-index : i64]
  [live : (Array i64)]) : unit
  (let
    [index : i64 (- terminator-index 1)]
    (begin
      (opt-collect-instr-uses-array
        live
        (compiler-ir-instr-seq-ref instrs terminator-index))
      (while (>= index 0)
        (begin
          (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs index))
            [(option_i64.Some dst)
              (if (and (>= dst 0) (< dst frame) (> (array-ref live dst) 0))
                (opt-collect-instr-uses-array
                  live
                  (compiler-ir-instr-seq-ref instrs index))
                unit)]
            [(option_i64.None) unit])
          (set! index (- index 1)))))))

(define (opt-successor-sink-fill-all-defs!
  [frame : i64]
  [blocks : CompilerIrBlockList]
  [defs : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (opt-successor-sink-fill-defs! frame instrs defs)])
        (opt-successor-sink-fill-all-defs! frame (box-get rest) defs))]
    [(CompilerIrBlockList.Array seq)
      (opt-successor-sink-fill-all-defs!
        frame
        (compiler-ir-block-seq-to-list seq)
        defs)]))

(define (opt-successor-sink-loop-target?
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [source : i64]
  [target : i64]) : bool
  (match loops
    [(OptNaturalLoopList.Nil) false]
    [(OptNaturalLoopList.Cons loop rest)
      (if (and
        (= (opt-natural-loop-header loop) source)
        (opt-loop-body-label-member?
          (opt-natural-loop-body-info loop)
          index
          target))
        true
        (opt-successor-sink-loop-target? index (box-get rest) source target))]))

(define (opt-successor-sink-append-prepared!
  [context : OptSuccessorSinkPrepareContext]
  [builder : (&mut builder CompilerIrInstrBuilder)]
  [origins : (Array i64)]
  [instr : CompilerIrInstr]
  [origin : i64]) : unit
  (let
    [slot : i64 (struct-get builder len)]
    (begin
      (array-set! origins slot origin)
      (compiler-ir-instr-builder-push! (&mut builder) instr)
      (if (>= origin 0)
        (opt-collect-instr-uses-array (struct-get context covered-uses) instr)
        unit))))

(define (opt-successor-sink-covered-use-count
  [context : OptSuccessorSinkPrepareContext]
  [pending-moves : CompilerIrInstrList]
  [var : i64]) : i64
  (let
    [pending-uses : (Array i64) (opt-used-array-new (struct-get context frame))]
    (begin
      (opt-successor-sink-collect-instr-list-uses! pending-moves pending-uses)
      (+
        (+
          (array-ref (struct-get context base-allowed) var)
          (array-ref (struct-get context covered-uses) var))
        (array-ref pending-uses var)))))

(define (opt-successor-sink-prepare-operands-from!
  [type-segment-bases : i64]
  [context : OptSuccessorSinkPrepareContext]
  [instr : CompilerIrInstr]
  [uses : (Array i64)]
  [var : i64]
  [pending-moves : CompilerIrInstrList]
  [builder : (&mut builder CompilerIrInstrBuilder)]
  [origins : (Array i64)]) : bool
  (if (>= var (struct-get context frame))
    true
    (if (<= (array-ref uses var) 0)
      (opt-successor-sink-prepare-operands-from!
        type-segment-bases
        context
        instr
        uses
        (+ var 1)
        pending-moves
        (&mut builder)
        origins)
      (and
        (opt-successor-sink-ensure-operand!
          type-segment-bases
          context
          var
          pending-moves
          (&mut builder)
          origins)
        (opt-successor-sink-prepare-operands-from!
          type-segment-bases
          context
          instr
          uses
          (+ var 1)
          pending-moves
          (&mut builder)
          origins)))))

(define (opt-successor-sink-prepare-operands!
  [type-segment-bases : i64]
  [context : OptSuccessorSinkPrepareContext]
  [instr : CompilerIrInstr]
  [pending-moves : CompilerIrInstrList]
  [builder : (&mut builder CompilerIrInstrBuilder)]
  [origins : (Array i64)]) : bool
  (let
    [uses : (Array i64) (opt-used-array-new (struct-get context frame))]
    (begin
      (opt-collect-instr-uses-array uses instr)
      (opt-successor-sink-prepare-operands-from!
        type-segment-bases
        context
        instr
        uses
        0
        pending-moves
        (&mut builder)
        origins))))

(define (opt-successor-sink-recipe-base-safe?
  [context : OptSuccessorSinkPrepareContext]
  [base : CompilerIrValue]) : bool
  (match base
    [(CompilerIrValue.Var var)
      (or
        (< var 0)
        (>= var (struct-get context frame))
        (<= (array-ref (struct-get context defs) var) 0)
        (> (array-ref (struct-get context planned) var) 0)
        (> (array-ref (struct-get context base-allowed) var) 0))]
    [_ (opt-successor-sink-stable-value? base)]))

(define (opt-successor-sink-try-induction-remat!
  [type-segment-bases : i64]
  [context : OptSuccessorSinkPrepareContext]
  [var : i64]
  [producer : CompilerIrInstr]
  [builder : (&mut builder CompilerIrInstrBuilder)]
  [origins : (Array i64)]) : bool
  (match (opt-successor-sink-induction-recipe context var producer)
    [(OptSuccessorSinkMaybeRecipe.No) false]
    [(OptSuccessorSinkMaybeRecipe.Some mul base ptr-ty)
      (if (and
        (<= (+ (array-ref (struct-get context clone-count) 0) 2) 4)
        (opt-successor-sink-recipe-base-safe? context base)
        ;; Integer Add is byte-identical to Gep only for byte elements. This
        ;; form lets the backend select one LEA for base+scaled-index while the
        ;; following constant Gep remains a load displacement.
        (= (opt-load-loc-type-size type-segment-bases ptr-ty) 1))
        (let
          [fresh-mul : i64
            (opt-bce-version-alloc-var (struct-get context frame-cell))]
          [rewritten-mul : CompilerIrInstr
            (opt-successor-sink-subst-instr
              (struct-get context frame)
              (struct-get context remap)
              mul)]
          [fresh-gep : i64
            (opt-bce-version-alloc-var (struct-get context frame-cell))]
          (begin
            (array-set!
              (struct-get context clone-count)
              0
              (+ (array-ref (struct-get context clone-count) 0) 2))
            (opt-successor-sink-append-prepared!
              context
              (&mut builder)
              origins
              (opt-successor-sink-remat-clone fresh-mul rewritten-mul)
              (- 0 1))
            (opt-successor-sink-append-prepared!
              context
              (&mut builder)
              origins
              (CompilerIrInstr.BinOp
                fresh-gep
                (CompilerIrBinOp.Add)
                (opt-successor-sink-subst-value
                  (struct-get context frame)
                  (struct-get context remap)
                  base)
                (CompilerIrValue.Var fresh-mul)
                (AstType.I64))
              (- 0 1))
            (array-set! (struct-get context remap) var (+ fresh-gep 1))
            (array-set! (struct-get context planned) var 1)
            true))
        false)]))

;; Make one source-block operand available in the target without lengthening
;; its live range. A producer whose original uses all move may move as usual.
;; Otherwise only Gep/BinOp can be cloned, recursively, with a four-clone cap.
(define (opt-successor-sink-ensure-operand!
  [type-segment-bases : i64]
  [context : OptSuccessorSinkPrepareContext]
  [var : i64]
  [pending-moves : CompilerIrInstrList]
  [builder : (&mut builder CompilerIrInstrBuilder)]
  [origins : (Array i64)]) : bool
  (if (or
    (> (array-ref (struct-get context planned) var) 0)
    (> (array-ref (struct-get context base-allowed) var) 0)
    (> (array-ref (struct-get context leaf-uses) var) 0)
    ;; The backward slice of the source terminator is already live at the
    ;; dispatch. Reusing one of its address producers in the selected arm
    ;; cannot extend that producer's live range, and avoids pointlessly
    ;; cloning `base + iv*scale` for a payload beside the tag load.
    (and
      (struct-get context source-loop-target)
      (> (array-ref (struct-get context terminator-live) var) 0)
      (<= (array-ref (struct-get context loop-phi-leaves) var) 0)))
    true
    (let
      [def-tag : i64 (array-ref (struct-get context defs) var)]
      (cond
        [(> (array-ref (struct-get context loop-phi-leaves) var) 0)
          (let
            [_rematerialized : bool
              (if (> def-tag 0)
                (opt-successor-sink-try-induction-remat!
                  type-segment-bases
                  context
                  var
                  (compiler-ir-instr-seq-ref
                    (struct-get context instrs)
                    (- def-tag 1))
                  (&mut builder)
                  origins)
                false)]
            ;; A loop phi is already live around the natural loop. If the
            ;; specialized pointer recipe cannot prove a synchronized unit-step
            ;; IV, retaining the phi as the moved instruction's leaf is safe.
            true)]
        [(<= def-tag 0)
          ;; A value with no function definition is a parameter. An external value
          ;; used by a loop header is already live around the natural loop, so it
          ;; remains a safe leaf in a header successor. Target/terminator uses and
          ;; Phi leaves returned above cover the other permitted live cases.
          (or
            (<= (array-ref (struct-get context all-defs) var) 0)
            (struct-get context source-loop-target)
            (> (array-ref (struct-get context terminator-live) var) 0))]
        [(> (array-ref (struct-get context visiting) var) 0) false]
        [else
          (let
            [index : i64 (- def-tag 1)]
            [producer : CompilerIrInstr
              (compiler-ir-instr-seq-ref (struct-get context instrs) index)]
            [all-move? : bool
              (=
                (array-ref (struct-get context total-uses) var)
                (opt-successor-sink-covered-use-count context pending-moves var))]
            [can-move? : bool
              (and
                all-move?
                (opt-successor-sink-candidate?
                  (struct-get context instrs)
                  index
                  (struct-get context terminator-index)
                  producer))]
            (begin
              (array-set! (struct-get context visiting) var 1)
              (cond
                [can-move?
                  (let
                    [next-pending : CompilerIrInstrList
                      (compiler-ir-instr-cons producer pending-moves)]
                    [ok : bool
                      (opt-successor-sink-prepare-operands!
                        type-segment-bases
                        context
                        producer
                        next-pending
                        (&mut builder)
                        origins)]
                    (begin
                      (if ok
                        (begin
                          (opt-successor-sink-append-prepared!
                            context
                            (&mut builder)
                            origins
                            (opt-successor-sink-subst-instr
                              (struct-get context frame)
                              (struct-get context remap)
                              producer)
                            index)
                          (array-set! (struct-get context removed) index 1)
                          (array-set! (struct-get context planned) var 1))
                        unit)
                      (array-set! (struct-get context visiting) var 0)
                      ok))]
                [(and
                    (opt-successor-sink-remat-candidate? producer)
                    (< (array-ref (struct-get context clone-count) 0) 4))
                  (begin
                    ;; Reserve the chain slot before descending so a fifth
                    ;; in-progress clone cannot pass a count that has not yet
                    ;; been committed while recursion unwinds.
                    (array-set!
                      (struct-get context clone-count)
                      0
                      (+ (array-ref (struct-get context clone-count) 0) 1))
                    (let
                      ;; The original producer remains in the source. Do not
                      ;; put it in `pending-moves`: its operand uses remain
                      ;; there and force transitive rematerialization as needed.
                      [ok : bool
                        (opt-successor-sink-prepare-operands!
                          type-segment-bases
                          context
                          producer
                          pending-moves
                          (&mut builder)
                          origins)]
                      (if ok
                        (let
                          [fresh : i64
                            (opt-bce-version-alloc-var
                              (struct-get context frame-cell))]
                          [rewritten : CompilerIrInstr
                            (opt-successor-sink-subst-instr
                              (struct-get context frame)
                              (struct-get context remap)
                              producer)]
                          (begin
                            (array-set!
                              (struct-get context remap)
                              var
                              (+ fresh 1))
                            (opt-successor-sink-append-prepared!
                              context
                              (&mut builder)
                              origins
                              (opt-successor-sink-remat-clone fresh rewritten)
                              (- 0 1))
                            (array-set! (struct-get context planned) var 1)
                            (array-set! (struct-get context visiting) var 0)
                            true))
                        (begin
                          (array-set!
                            (struct-get context clone-count)
                            0
                            (- (array-ref (struct-get context clone-count) 0) 1))
                          (array-set! (struct-get context visiting) var 0)
                          false))))]
                [else
                  (begin
                    (array-set! (struct-get context visiting) var 0)
                    false)])))]))))

(define (opt-successor-sink-prepare-root
  [type-segment-bases : i64]
  [frame : i64]
  [blocks : CompilerIrBlockList]
  [cfg : OptCfgIndex]
  [all-defs : (Array i64)]
  [source-loop-target : bool]
  [total-uses : (Array i64)]
  [loop-phi-leaves : (Array i64)]
  [moves : OptSuccessorSinkMoves]
  [target : i64]
  [instrs : CompilerIrInstrSeq]
  [terminator-index : i64]
  [index : i64]
  [instr : CompilerIrInstr]
  [frame-cell : (Array i64)]) : OptSuccessorSinkPrepared
  (let
    [frame-before : i64 (array-ref frame-cell 0)]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [defs : (Array i64) (opt-used-array-new frame)]
    [base-allowed : (Array i64) (opt-used-array-new frame)]
    [leaf-uses : (Array i64) (opt-used-array-new frame)]
    [terminator-live : (Array i64) (opt-used-array-new frame)]
    [covered-uses : (Array i64) (opt-used-array-new frame)]
    [planned : (Array i64) (opt-used-array-new frame)]
    [visiting : (Array i64) (opt-used-array-new frame)]
    [remap : (Array i64) (opt-used-array-new frame)]
    [removed : (Array i64) (opt-used-array-new count)]
    [clone-count : (Array i64) (opt-used-array-new 1)]
    [builder : CompilerIrInstrBuilder
      (compiler-ir-instr-builder-with-capacity (+ count 4))]
    [origins : (Array i64) (array.make-array i64 (+ count 4))]
    (begin
      (opt-successor-sink-fill-defs! frame instrs defs)
      (opt-successor-sink-collect-successor-uses! cfg target base-allowed)
      (opt-successor-sink-collect-moved-uses! moves target base-allowed)
      (opt-collect-instr-uses-array
        leaf-uses
        (compiler-ir-instr-seq-ref instrs terminator-index))
      (opt-successor-sink-mark-terminator-live!
        frame
        instrs
        terminator-index
        terminator-live)
      (let
        [context : OptSuccessorSinkPrepareContext
          (OptSuccessorSinkPrepareContext
            frame
            target
            blocks
            instrs
            terminator-index
            defs
            all-defs
            source-loop-target
            total-uses
            base-allowed
            leaf-uses
            terminator-live
            loop-phi-leaves
            covered-uses
            planned
            visiting
            remap
            removed
            frame-cell
            clone-count)]
        [pending : CompilerIrInstrList
          (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)]
        [ok : bool
          (opt-successor-sink-prepare-operands!
            type-segment-bases
            context
            instr
            pending
            (&mut builder)
            origins)]
        (if ok
          (begin
            (opt-successor-sink-append-prepared!
              context
              (&mut builder)
              origins
              (opt-successor-sink-subst-instr frame remap instr)
              index)
            (array-set! removed index 1)
            (OptSuccessorSinkPrepared.Some
              (compiler-ir-instr-builder-to-seq builder)
              removed
              origins))
          (begin
            (array-set! frame-cell 0 frame-before)
            (OptSuccessorSinkPrepared.No)))))))

(define (opt-successor-sink-plan-block
  [type-segment-bases : i64]
  [frame : i64]
  [frame-cell : (Array i64)]
  [blocks : CompilerIrBlockList]
  [cfg : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [all-defs : (Array i64)]
  [total-uses : (Array i64)]
  [loop-phi-leaves : (Array i64)]
  [allowed-uses : (Array i64)]
  [block : CompilerIrBlock]
  [tail : OptSuccessorSinkMoves]) : OptSuccessorSinkMoves
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (< count 2)
          tail
          (let
            [terminator-index : i64 (- count 1)]
            [terminator : CompilerIrInstr
              (compiler-ir-instr-seq-ref instrs terminator-index)]
            [successors : OptLabelSet
              (match terminator
                [(CompilerIrInstr.Branch _ _ _)
                  (opt-cfg-index-successors cfg label)]
                [(CompilerIrInstr.Switch _ _ _ _)
                  (opt-cfg-index-successors cfg label)]
                [_ (OptLabelSet.Nil)])]
            [moves : OptSuccessorSinkMoves tail]
            [index : i64 (- terminator-index 1)]
            (begin
              (while (>= index 0)
                (let
                  [instr : CompilerIrInstr
                    (compiler-ir-instr-seq-ref instrs index)]
                  (begin
                    (if (and
                      (not (opt-successor-sink-source-index? moves label index))
                      (opt-successor-sink-candidate?
                        instrs
                        index
                        terminator-index
                        instr))
                      (match (opt-instr-def-var instr)
                        [(option_i64.Some dst)
                          (match (opt-successor-sink-find-target
                            frame
                            cfg
                            total-uses
                            allowed-uses
                            moves
                            label
                            successors
                            dst)
                            [(OptSuccessorSinkMaybeLabel.Some target)
                              (match (opt-successor-sink-prepare-root
                                type-segment-bases
                                frame
                                blocks
                                cfg
                                all-defs
                                (opt-successor-sink-loop-target?
                                  cfg
                                  loops
                                  label
                                  target)
                                total-uses
                                loop-phi-leaves
                                moves
                                target
                                instrs
                                terminator-index
                                index
                                instr
                                frame-cell)
                                [(OptSuccessorSinkPrepared.Some
                                    prepared
                                    removed
                                    origins)
                                  (set!
                                    moves
                                    (OptSuccessorSinkMoves.Cons
                                      (OptSuccessorSinkMove.Move
                                        label
                                        removed
                                        target
                                        prepared
                                        origins)
                                      (box moves)))]
                                [(OptSuccessorSinkPrepared.No) unit])]
                            [(OptSuccessorSinkMaybeLabel.No) unit])]
                        [(option_i64.None) unit])
                      unit)
                    (set! index (- index 1)))))
              moves))))]))

(define (opt-successor-sink-plan-blocks
  [type-segment-bases : i64]
  [frame : i64]
  [frame-cell : (Array i64)]
  [blocks : CompilerIrBlockList]
  [cfg : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [all-defs : (Array i64)]
  [total-uses : (Array i64)]
  [loop-phi-leaves : (Array i64)]
  [allowed-uses : (Array i64)]
  [remaining : CompilerIrBlockList]
  [tail : OptSuccessorSinkMoves]) : OptSuccessorSinkMoves
  (match remaining
    [(CompilerIrBlockList.Nil) tail]
    [(CompilerIrBlockList.Cons block rest)
      (opt-successor-sink-plan-blocks
        type-segment-bases
        frame
        frame-cell
        blocks
        cfg
        loops
        all-defs
        total-uses
        loop-phi-leaves
        allowed-uses
        (box-get rest)
        (opt-successor-sink-plan-block
          type-segment-bases
          frame
          frame-cell
          blocks
          cfg
          loops
          all-defs
          total-uses
          loop-phi-leaves
          allowed-uses
          block
          tail))]
    [(CompilerIrBlockList.Array seq)
      (opt-successor-sink-plan-blocks
        type-segment-bases
        frame
        frame-cell
        blocks
        cfg
        loops
        all-defs
        total-uses
        loop-phi-leaves
        allowed-uses
        (compiler-ir-block-seq-to-list seq)
        tail)]))

(define (opt-successor-sink-source-index?
  [moves : OptSuccessorSinkMoves]
  [source : i64]
  [index : i64]) : bool
  (match moves
    [(OptSuccessorSinkMoves.Nil) false]
    [(OptSuccessorSinkMoves.Cons move rest)
      (match move
        [(OptSuccessorSinkMove.Move move-source removed _ _ _)
          (if (and
            (= move-source source)
            (>= index 0)
            (< index (array-length removed))
            (> (array-ref removed index) 0))
            true
            (opt-successor-sink-source-index? (box-get rest) source index))])]))

(define (opt-successor-sink-push-target-moves!
  [moves : OptSuccessorSinkMoves]
  [target : i64]
  [builder : (&mut builder CompilerIrInstrBuilder)]) : unit
  (match moves
    [(OptSuccessorSinkMoves.Nil) unit]
    [(OptSuccessorSinkMoves.Cons move rest)
      (begin
        (match move
          [(OptSuccessorSinkMove.Move _ _ move-target instrs _)
            (if (= move-target target)
              (let
                [index : i64 0]
                [count : i64 (compiler-ir-instr-seq-count instrs)]
                (while (< index count)
                  (begin
                    (compiler-ir-instr-builder-push!
                      (&mut builder)
                      (compiler-ir-instr-seq-ref instrs index))
                    (set! index (+ index 1)))))
              unit)])
        (opt-successor-sink-push-target-moves!
          (box-get rest)
          target
          (&mut builder)))]))

(define (opt-successor-sink-rewrite-block
  [moves : OptSuccessorSinkMoves]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        [phi-end : i64 (opt-successor-sink-leading-phi-end instrs 0)]
        [builder : CompilerIrInstrBuilder
          (compiler-ir-instr-builder-with-capacity count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (if (= index phi-end)
                (opt-successor-sink-push-target-moves!
                  moves
                  label
                  (&mut builder))
                unit)
              (if (not (opt-successor-sink-source-index? moves label index))
                (compiler-ir-instr-builder-push!
                  (&mut builder)
                  (compiler-ir-instr-seq-ref instrs index))
                unit)
              (set! index (+ index 1))))
          (if (= phi-end count)
            (opt-successor-sink-push-target-moves! moves label (&mut builder))
            unit)
          (CompilerIrBlock.Block
            label
            (compiler-ir-instr-builder-to-seq builder))))]))

(define (opt-successor-sink-rewrite-blocks
  [moves : OptSuccessorSinkMoves]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerIrBlockList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-successor-sink-rewrite-block moves block)
        (opt-successor-sink-rewrite-blocks moves (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-successor-sink-rewrite-blocks
        moves
        (compiler-ir-block-seq-to-list seq))]))

;; Global Word-of-Pack forwarding can make a Pack dead immediately before this
;; pass. Remove only those dead Packs here: leaving one in place makes its stale
;; operand use block the payload sink, while running general DCE here would also
;; erase the dead BinOp address recipes needed for rematerialization.
(define (opt-successor-sink-strip-dead-packs-block
  [frame : i64]
  [uses : (Array i64)]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        [builder : CompilerIrInstrBuilder
          (compiler-ir-instr-builder-with-capacity count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (let
              [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
              (begin
                (match instr
                  [(CompilerIrInstr.Pack dst _ _)
                    (if (and
                      (>= dst 0)
                      (< dst frame)
                      (<= (array-ref uses dst) 0))
                      unit
                      (compiler-ir-instr-builder-push! (&mut builder) instr))]
                  [_ (compiler-ir-instr-builder-push! (&mut builder) instr)])
                (set! index (+ index 1)))))
          (CompilerIrBlock.Block
            label
            (compiler-ir-instr-builder-to-seq builder))))]))

(define (opt-successor-sink-strip-dead-packs
  [frame : i64]
  [uses : (Array i64)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerIrBlockList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-successor-sink-strip-dead-packs-block frame uses block)
        (opt-successor-sink-strip-dead-packs frame uses (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-successor-sink-strip-dead-packs
        frame
        uses
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-successor-sink-mark-leading-phis!
  [frame : i64]
  [instrs : CompilerIrInstrSeq]
  [leaves : (Array i64)]
  [index : i64]) : unit
  (if (>= index (compiler-ir-instr-seq-count instrs))
    unit
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi dst _ _)
        (begin
          (if (and (>= dst 0) (< dst frame))
            (array-set! leaves dst 1)
            unit)
          (opt-successor-sink-mark-leading-phis!
            frame
            instrs
            leaves
            (+ index 1)))]
      [_ unit])))

(define (opt-successor-sink-mark-phis!
  [frame : i64]
  [blocks : CompilerIrBlockList]
  [leaves : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (opt-successor-sink-mark-leading-phis! frame instrs leaves 0)])
        (opt-successor-sink-mark-phis! frame (box-get rest) leaves))]
    [(CompilerIrBlockList.Array seq)
      (opt-successor-sink-mark-phis!
        frame
        (compiler-ir-block-seq-to-list seq)
        leaves)]))

(define (opt-successor-sink-blocks-result
  [type-segment-bases : i64]
  [frame : i64]
  [frame-cell : (Array i64)]
  [blocks : CompilerIrBlockList]) : OptBlockCtxResult
  (let
    [initial-uses : (Array i64) (opt-collect-blocks-uses-array frame blocks)]
    [ready : CompilerIrBlockList
      (opt-successor-sink-strip-dead-packs frame initial-uses blocks)]
    ;; The natural-loop scan needs the pred-map/reachable/dominator view of the
    ;; SAME block list this pass already indexes, and `opt-cfg-natural-loops`
    ;; builds a whole context (index included) internally. Build the context
    ;; once and take its index instead of indexing `ready` twice.
    [cfg-context : OptCfgContext (opt-cfg-context-build ready)]
    [cfg : OptCfgIndex (struct-get cfg-context index)]
    [loops : OptNaturalLoopList
      (opt-cfg-natural-loops-with-context ready cfg-context)]
    [all-defs : (Array i64) (opt-used-array-new frame)]
    [_all-defs : unit (opt-successor-sink-fill-all-defs! frame ready all-defs)]
    [total-uses : (Array i64) (opt-collect-blocks-uses-array frame ready)]
    [loop-phi-leaves : (Array i64) (opt-used-array-new frame)]
    [_loop-phi-leaves : unit
      (opt-successor-sink-mark-phis! frame ready loop-phi-leaves)]
    [allowed-uses : (Array i64) (opt-used-array-new frame)]
    [moves : OptSuccessorSinkMoves
      (opt-successor-sink-plan-blocks
        type-segment-bases
        frame
        frame-cell
        ready
        cfg
        loops
        all-defs
        total-uses
        loop-phi-leaves
        allowed-uses
        ready
        (OptSuccessorSinkMoves.Nil))]
    ;; The no-move path returns `ready` verbatim, and `cfg-context` was built
    ;; for exactly that block list, so report it as valid for the result. This
    ;; pass runs on every function every iteration but only plans moves for a
    ;; few hundred of them, so the reuse covers the overwhelming majority of
    ;; runs and saves the caller a whole CFG context build.
    (match moves
      [(OptSuccessorSinkMoves.Nil)
        (OptBlockCtxResult.Result ready cfg-context true)]
      [_
        (OptBlockCtxResult.Result
          (opt-successor-sink-rewrite-blocks moves ready)
          cfg-context
          false)])))

(define (opt-successor-sink-blocks
  [type-segment-bases : i64]
  [frame : i64]
  [frame-cell : (Array i64)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match (opt-successor-sink-blocks-result
    type-segment-bases
    frame
    frame-cell
    blocks)
    [(OptBlockCtxResult.Result out _ _) out]))

;; Public pass boundary used by self-tests and by the opt2 pipeline. Both the
;; entry and rewritten functions are verified so this scheduling rule never runs
;; on mutable-var IR and rejects any unexpected dominance regression.
;;
;; `context` must be valid for `func`'s blocks: the entry verify runs against it
;; instead of building an identical one, and both rejection paths report it
;; unchanged. The returned context is valid for the returned function's blocks,
;; which spares the caller the rebuild it used to do right after this returned.
(define (opt-successor-sink-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; The check itself is still a full verify: this pass is NOT covered by the
  ;; `loop-cluster-verified?` invariant and skipping it crashes the self-compile.
  (match (opt-verify-function-with-context func context)
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(CompilerIrFunction.Function name params ret-ty frame blocks)
          (let
            [frame-cell : (Array i64) (opt-used-array-new 1)]
            [_frame-init : unit (array-set! frame-cell 0 frame)]
            [sink-result : OptBlockCtxResult
              (opt-successor-sink-blocks-result
                type-segment-bases
                frame
                frame-cell
                blocks)]
            [next-blocks : CompilerIrBlockList
              (match sink-result
                [(OptBlockCtxResult.Result b _ _) b])]
            [next : CompilerIrFunction
              (CompilerIrFunction.Function
                name
                params
                ret-ty
                (array-ref frame-cell 0)
                next-blocks)]
            [next-context : OptCfgContext
              (match sink-result
                [(OptBlockCtxResult.Result _ ctx reusable)
                  (if reusable
                    ctx
                    (opt-cfg-context-build next-blocks))])]
            (match (opt-verify-function-with-context next next-context)
              [(ResultCompilerOptimizeVerify.Ok)
                (OptFunctionCtxResult.Result next next-context)]
              [(ResultCompilerOptimizeVerify.Err _)
                (OptFunctionCtxResult.Result func context)]))])]))

(define (opt-successor-sink-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-successor-sink-function-with-context-result
    type-segment-bases
    (opt-cfg-context-build (opt-function-blocks func))
    func)
    [(OptFunctionCtxResult.Result f _) f]))

;; ---------------------------------------------------------------------------
(defstruct OptIfConvertBlockFact
  (label i64)
  (instrs CompilerIrInstrSeq)
  (count i64)
  (first CompilerIrInstrScalarFact)
  (before-last CompilerIrInstrScalarFact)
  (last CompilerIrInstrScalarFact))

(define (opt-if-convert-block-fact [block : CompilerIrBlock]) : OptIfConvertBlockFact
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (OptIfConvertBlockFact
          label
          instrs
          count
          (if (> count 0)
            (compiler-ir-instr-scalar-fact (compiler-ir-instr-seq-ref instrs 0))
            (CompilerIrInstrScalarFact.Other))
          (if (> count 1)
            (compiler-ir-instr-scalar-fact
              (compiler-ir-instr-seq-ref instrs (- count 2)))
            (CompilerIrInstrScalarFact.Other))
          (if (> count 0)
            (compiler-ir-instr-scalar-fact
              (compiler-ir-instr-seq-ref instrs (- count 1)))
            (CompilerIrInstrScalarFact.Other))))]))

(define (opt-if-convert-facts [blocks : CompilerIrBlockSeq]) : (Array
    OptIfConvertBlockFact)
  (let
    [count : i64 (compiler-ir-block-seq-count blocks)]
    [facts : (Array OptIfConvertBlockFact)
      (make-array OptIfConvertBlockFact count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            facts
            index
            (opt-if-convert-block-fact (compiler-ir-block-seq-ref blocks index)))
          (set! index (+ index 1))))
      facts)))

(define (opt-if-convert-arm? [fact : OptIfConvertBlockFact] [merge : i64]) : bool
  (and
    (= (struct-get fact count) 1)
    (match (struct-get fact last)
      [(CompilerIrInstrScalarFact.Jump target) (= target merge)]
      [_ false])))

(define (opt-if-convert-live-values?
  [first : CompilerIrValue]
  [second : CompilerIrValue]) : bool
  (match first
    [(CompilerIrValue.Var _)
      (match second
        [(CompilerIrValue.Var _) true]
        [_ false])]
    [_ false]))

(define (opt-if-convert-try!
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockSeq]
  [facts : (Array OptIfConvertBlockFact)]
  [id : i64]) : bool
  (if (>= (+ id 3) (array-length facts))
    false
    (let
      [source : OptIfConvertBlockFact (array-ref facts id)]
      [a : OptIfConvertBlockFact (array-ref facts (+ id 1))]
      [b : OptIfConvertBlockFact (array-ref facts (+ id 2))]
      [merge : OptIfConvertBlockFact (array-ref facts (+ id 3))]
      [source-label : i64 (struct-get source label)]
      [a-label : i64 (struct-get a label)]
      [b-label : i64 (struct-get b label)]
      [merge-label : i64 (struct-get merge label)]
      [source-instrs : CompilerIrInstrSeq (struct-get source instrs)]
      [merge-instrs : CompilerIrInstrSeq (struct-get merge instrs)]
      (begin
        (when
          (or
            (< (struct-get source count) 2)
            (< (struct-get merge count) 1)
            (match (struct-get source first)
              [(CompilerIrInstrScalarFact.Phi _ _ _) false]
              [_ true])
            (not (opt-if-convert-arm? a merge-label))
            (not (opt-if-convert-arm? b merge-label)))
          (return false))
        (match (struct-get source last)
          [(CompilerIrInstrScalarFact.Branch condition yes no)
            (if (not
              (or
                (and (= a-label yes) (= b-label no))
                (and (= a-label no) (= b-label yes))))
              false
              (match condition
                [(CompilerIrValue.Var condition-var)
                  (match (struct-get source before-last)
                    [(CompilerIrInstrScalarFact.BinOp condition-dst op _ _ _)
                      (if (not
                        (and
                          (= condition-dst condition-var)
                          (compiler-ir-binop-compare? op)))
                        false
                        (match (struct-get merge first)
                          [(CompilerIrInstrScalarFact.Phi dst inputs ty)
                            (if (or
                              (not
                                (or
                                  (opt-integer-type? ty)
                                  (opt-type-eq
                                    type-segment-bases
                                    ty
                                    (AstType.Bool))))
                              (match (struct-get merge last)
                                [(CompilerIrInstrScalarFact.Branch next _ _)
                                  (opt-value-eq (clone condition) next)]
                                [_ false]))
                              false
                              (match (opt-bool-branch-phi-inputs inputs)
                                [(OptBoolBranchPhiInputs.No) false]
                                [(OptBoolBranchPhiInputs.Two
                                    first
                                    first-label
                                    second
                                    second-label)
                                  (if (or
                                    (not
                                      (or
                                        (and
                                          (= first-label yes)
                                          (= second-label no))
                                        (and
                                          (= first-label no)
                                          (= second-label yes))))
                                    (not
                                      (opt-if-convert-live-values? first second)))
                                    false
                                    (let
                                      [tail : CompilerIrInstrList
                                        (compiler-ir-instr-cons
                                          (ir-instr-select
                                            dst
                                            condition
                                            (if (= first-label yes)
                                              first
                                              second)
                                            (if (= first-label yes)
                                              second
                                              first)
                                            0
                                            ty)
                                          (compiler-ir-instr-cons
                                            (CompilerIrInstr.Jump merge-label)
                                            CompilerIrInstrList.Nil))]
                                      (begin
                                        (array-set!
                                          (struct-get blocks slots)
                                          id
                                          (compiler-ir-block
                                            source-label
                                            (compiler-ir-instr-seq-to-list-rev
                                              (struct-get source-instrs slots)
                                              (- (struct-get source count) 2)
                                              tail)))
                                        (array-set!
                                          (struct-get blocks slots)
                                          (+ id 3)
                                          (compiler-ir-block
                                            merge-label
                                            (opt-aggregate-instr-seq-append-from
                                              merge-instrs
                                              1
                                              CompilerIrInstrList.Nil)))
                                        (array-set!
                                          facts
                                          (+ id 3)
                                          (opt-if-convert-block-fact
                                            (array-ref
                                              (struct-get blocks slots)
                                              (+ id 3))))
                                        true)))]))]
                          [_ false]))]
                    [_ false])]
                [_ false]))]
          [_ false])))))

(define (opt-if-convert-function-pass
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame original)
      (let
        [blocks : CompilerIrBlockList
          (compiler-ir-block-list-compact
            (opt-bool-branch-clone-blocks original))]
        (match blocks
          [(CompilerIrBlockList.Array seq)
            (let
              [facts : (Array OptIfConvertBlockFact) (opt-if-convert-facts seq)]
              [read : i64 0]
              [changed : bool false]
              (begin
                (while (< read (array-length facts))
                  (begin
                    (if (opt-if-convert-try! type-segment-bases seq facts read)
                      (set! changed true)
                      unit)
                    (set! read (+ read 1))))
                (if (not changed)
                  (OptFunctionPassResult.Result func false)
                  (let
                    [next : CompilerIrFunction
                      (CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        frame
                        (opt-cfg-simplify-blocks blocks))]
                    (match (opt-verify-function next)
                      [(ResultCompilerOptimizeVerify.Ok)
                        (OptFunctionPassResult.Result next true)]
                      [(ResultCompilerOptimizeVerify.Err _)
                        (OptFunctionPassResult.Result func false)])))))]
          [_ (OptFunctionPassResult.Result func false)]))]))

(define (opt-if-convert-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-if-convert-function-pass type-segment-bases func)
    [(OptFunctionPassResult.Result next _) next]))

;; --- G1a: constructor destination forwarding (SRET<-tmp) --------------------
;;
;; Lowering builds a nested constructor into a fresh frame temp and then copies
;; the finished aggregate into its real destination:
;;
;;     %t   = alloc T                 ; fresh frame storage (>= 1 slot)
;;     %p   = addr_of %t
;;     %g   = gep %p, K : u8          ; one per field
;;     store_ptr %g, v : ty
;;     ...
;;     %d   = gep %B, J : u8          ; the real destination (sret slot, field)
;;     call tl_memcpy(%d, %p, S)      ; or `copy_bytes %d, %p, S`
;;
;; The whole-aggregate copy disappears when the field stores are retargeted at
;; `%B + J + K` directly. That is a REORDERING: every retargeted store now
;; writes the destination BEFORE the instructions that used to sit between it
;; and the copy.
;;
;; SOUNDNESS. Issue #5971: TypeLisp passes by-value aggregate parameters as bare
;; pointers with no caller-side copy, and the hidden sret slot is ordinary
;; caller storage, so THE SRET SLOT MAY ALIAS A BY-VALUE ARGUMENT of the same
;; call (accumulator threading -- `acc = (f acc x)` -- produces exactly that at
;; run time). "The destination cannot alias what the window reads" is therefore
;; not derivable from types; a lowering-level version of this transform
;; miscompiled the compiler (it broke `tc-name-id-list-add`) for precisely this
;; reason. The guard below is the conservative alias proof that makes the
;; reordering safe without any interprocedural fact:
;;
;;   (1) `%t` is a FRESH FRAME ALLOCATION whose address never escapes: the
;;       ALLOC var `%t` is used exactly once in the whole function (by the
;;       matched `addr_of`, so no second pointer to the same storage exists),
;;       every use of `%p` is one of the retargeted geps or the copy's source
;;       operand, and every retargeted gep var is used only by its own store --
;;       all three via EXACT function-wide use counts. Nothing else can observe
;;       `T`, so deleting `T` is invisible.
;;   (2) The window -- from the FIRST retargeted store to the copy -- contains
;;       ONLY instructions that cannot observe or disturb the destination
;;       bytes: side-effect-free (`Pure`) instructions, frame `Alloc`s (which
;;       emit no code), the retargeted geps/stores themselves, and stores
;;       through a constant offset off the SAME base as the destination whose
;;       byte range is provably disjoint from `[J, J + S)` (two constant offsets
;;       off one pointer cannot overlap). Any load, call, or store through an
;;       unrelated pointer aborts the match -- that is exactly the class the
;;       sret-may-alias-an-argument hole makes unprovable.
;;   (3) The destination base var `%B` is not redefined between the destination
;;       address computation (or the temp's `addr_of`, whichever is earlier) and
;;       the copy, so the address the retargeted geps compute is the address the
;;       copy would have written.
;;   (4) Every retargeted store lies inside `[0, S)`, so no store escapes the
;;       byte range the copy used to define.
;;
;; Blocks are straight-line, so nothing inside the window can trap or branch out
;; between the first retargeted store and the deleted copy (a trapping check is
;; its own block, and calls are rejected by (2)); the destination is therefore
;; written on exactly the paths that used to run the copy.
;;
;; Bytes of `[J, J + S)` that no store covers keep the destination's previous
;; contents instead of receiving the temp's uninitialised stack bytes. Both are
;; values no defined program can observe (they are padding of a freshly reserved
;; frame slot), and the bootstrap fixpoint / deterministic-asm gates cover the
;; claim end to end.
;;
;; The rewrite itself is minimal: rebase the field geps and delete the copy.
;; `addr_of` and the `alloc` run then have no uses left and the pipeline DCE
;; retires them, which also releases the frame slots.
(defenum OptCtorFwdCopy
  (NoCopy)
  ;; destination address value, source var, byte size, call result var (-1 for
  ;; `CopyBytes`, which defines nothing).
  (Copy CompilerIrValue i64 i64 i64))

;; Destination base var, its constant byte offset, and the index of the address
;; computation inside the block (-1 when the address enters the block already
;; computed).
(defenum OptCtorFwdDest
  (NoDest)
  (Dest i64 i64 i64))

;; Byte width a `StorePtr` of this value type writes. This number is
;; load-bearing twice (the `offset + width <= size` coverage check and the
;; same-base disjointness check), so it MUST NOT under-report.
;;
;; The invariant that makes it exact is a BACKEND one, not a lowering one:
;; `compiler-backend-emit-store-ptr` routes every `StorePtr` through
;; `compiler-backend-emit-store-value-to-address`, which emits exactly ONE
;; register store -- `compiler-backend-emit-store-reg-to-memory` picks
;; `movq`/`movl`/`movw`/`movb` purely from `compiler-backend-type-size ty`
;; (8/4/2/1 and nothing else; `compiler_backend.tl`, the `type-size` /
;; `emit-store-reg-to-memory` pair), and the float path emits one xmm store of
;; the same width. A `StorePtr` therefore writes at most 8 bytes, whatever the
;; type, and the arms below reproduce `compiler-backend-type-size` exactly for
;; every type they accept -- including the ones that look wide at the source
;; level (`String`, `Str`, `Bytes`, `DynArray`, `Array`, `Func`, `Tuple`, and
;; register-resident `Struct`/`Enum`), all of which the backend stores as a
;; single 8-byte word.
;;
;; Every remaining type FAILS CLOSED with -1 and aborts the match, which is
;; strictly more conservative than the backend: that covers the zero-width
;; types (`Unit`/`Never`/`Expr`/`ExprList`), the type variables
;; (`Var`/`VarArgs`), and the two arms the backend resolves by recursing through
;; the type-segment table (`Region`/`Consume`), which this pass does not thread.
;; If `compiler-backend-type-size` ever grows an arm wider than 8, this function
;; must reject that type here.
(define (opt-ctor-fwd-store-byte-size [ty : AstType]) : i64
  (match ty
    [(AstType.I64) 8]
    [(AstType.U64) 8]
    [(AstType.F64) 8]
    [(AstType.I32) 4]
    [(AstType.U32) 4]
    [(AstType.F32) 4]
    [(AstType.I16) 2]
    [(AstType.U16) 2]
    [(AstType.I8) 1]
    [(AstType.U8) 1]
    [(AstType.Bool) 1]
    [(AstType.Char) 1]
    [(AstType.Ptr _) 8]
    [(AstType.MutPtr _) 8]
    [(AstType.Ref _ _) 8]
    [(AstType.MutRef _ _) 8]
    [(AstType.Box _) 8]
    [(AstType.String) 8]
    [(AstType.Str) 8]
    [(AstType.Bytes) 8]
    [(AstType.DynArray _) 8]
    [(AstType.Array _ _) 8]
    [(AstType.Func _ _) 8]
    [(AstType.Tuple _) 8]
    [(AstType.Enum _) 8]
    [(AstType.EnumArgs _ _) 8]
    [(AstType.Struct _) 8]
    [(AstType.StructArgs _ _) 8]
    [_ -1]))

(define (opt-ctor-fwd-memcpy-symbol? [symbol : i64]) : bool
  (string.eq (compiler-ir-symbol-text symbol) "tl_memcpy"))

;; A whole-aggregate copy out of an IR var: `CopyBytes` (the 16..112 B inline
;; band) or the `tl_memcpy` runtime call lowering emits above that band.
(define (opt-ctor-fwd-match-copy [instr : CompilerIrInstr]) : OptCtorFwdCopy
  (match instr
    [(CompilerIrInstr.CopyBytes dst src size)
      (match src
        [(CompilerIrValue.Var src-var)
          (if (> size 0)
            (OptCtorFwdCopy.Copy dst src-var size -1)
            (OptCtorFwdCopy.NoCopy))]
        [_ (OptCtorFwdCopy.NoCopy)])]
    [(CompilerIrInstr.Call call-dst name args _)
      (match args
        [(CompilerIrCallArgs.Array values)
          (if (= (array-length values) 3)
            (match (array-ref values 2)
              [(CompilerIrValue.I64 size)
                (match (array-ref values 1)
                  [(CompilerIrValue.Var src-var)
                    (if (and (> size 0) (opt-ctor-fwd-memcpy-symbol? name))
                      (OptCtorFwdCopy.Copy
                        (array-ref values 0)
                        src-var
                        size
                        call-dst)
                      (OptCtorFwdCopy.NoCopy))]
                  [_ (OptCtorFwdCopy.NoCopy)])]
              [_ (OptCtorFwdCopy.NoCopy)])
            (OptCtorFwdCopy.NoCopy))]
        [_ (OptCtorFwdCopy.NoCopy)])]
    [_ (OptCtorFwdCopy.NoCopy)]))

;; Cheap per-block admission: a block can only hold the pattern when it has both
;; a frame `addr_of` and a whole-aggregate copy out of a var. Everything else
;; (the exact use census, which allocates) is gated behind this.
(define (opt-ctor-fwd-block-candidate? [instrs : CompilerIrInstrSeq]) : bool
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [saw-addr : bool false]
    [saw-copy : bool false]
    [i : i64 0]
    (begin
      (while (and (< i count) (not (and saw-addr saw-copy)))
        (let
          [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs i)]
          (begin
            (match instr
              [(CompilerIrInstr.AddrOf _ _) (set! saw-addr true)]
              [_
                (match (opt-ctor-fwd-match-copy instr)
                  [(OptCtorFwdCopy.Copy _ _ _ _) (set! saw-copy true)]
                  [(OptCtorFwdCopy.NoCopy) unit])])
            (set! i (+ i 1)))))
      (and saw-addr saw-copy))))

(define (opt-ctor-fwd-blocks-have-candidate? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-ctor-fwd-block-candidate? instrs)
            true
            (opt-ctor-fwd-blocks-have-candidate? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-ctor-fwd-blocks-have-candidate? (compiler-ir-block-seq-to-list seq))]))

;; Index of the `addr_of` that defines `var`, searching back from `from`.
;; Returns -1 when the search hits another definition of `var` first or leaves
;; the block.
(define (opt-ctor-fwd-find-addr-of
  [instrs : CompilerIrInstrSeq]
  [from : i64]
  [var : i64]) : i64
  (let
    [i : i64 from]
    [found : i64 -1]
    [done : bool false]
    (begin
      (while (and (not done) (>= i 0))
        (let
          [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs i)]
          (begin
            (match instr
              [(CompilerIrInstr.AddrOf dst _)
                (if (= dst var)
                  (begin
                    (set! found i)
                    (set! done true))
                  unit)]
              [_
                (match (opt-instr-def-var instr)
                  [(option_i64.Some d)
                    (if (= d var)
                      (set! done true)
                      unit)]
                  [(option_i64.None) unit])])
            (set! i (- i 1)))))
      found)))

;; Index of the last definition of `var` in `[0, from]`, or -1 when `var` enters
;; the block already defined.
(define (opt-ctor-fwd-find-def
  [instrs : CompilerIrInstrSeq]
  [from : i64]
  [var : i64]) : i64
  (let
    [i : i64 from]
    [found : i64 -1]
    (begin
      (while (>= i 0)
        (begin
          (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs i))
            [(option_i64.Some d)
              (if (= d var)
                (begin
                  (set! found i)
                  (set! i 0))
                unit)]
            [(option_i64.None) unit])
          (set! i (- i 1))))
      found)))

(define (opt-ctor-fwd-defined-in-range?
  [instrs : CompilerIrInstrSeq]
  [lo : i64]
  [hi : i64]
  [var : i64]) : bool
  (let
    [i : i64 lo]
    [found : bool false]
    (begin
      (while (and (not found) (<= i hi))
        (begin
          (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs i))
            [(option_i64.Some d)
              (if (= d var)
                (set! found true)
                unit)]
            [(option_i64.None) unit])
          (set! i (+ i 1))))
      found)))

;; Byte offset of a `gep <base>, K : u8` instruction, or -1 when the instruction
;; is not one.
(define (opt-ctor-fwd-gep-offset [instr : CompilerIrInstr] [base : i64]) : i64
  (match instr
    [(CompilerIrInstr.Gep _ source offset elem-ty)
      (match elem-ty
        [(AstType.U8)
          (match source
            [(CompilerIrValue.Var source-var)
              (if (= source-var base)
                (match offset
                  [(CompilerIrValue.I64 k)
                    (if (>= k 0)
                      k
                      -1)]
                  [_ -1])
                -1)]
            [_ -1])]
        [_ -1])]
    [_ -1]))

(define (opt-ctor-fwd-gep-dst [instr : CompilerIrInstr]) : i64
  (match instr
    [(CompilerIrInstr.Gep dst _ _ _) dst]
    [_ -1]))

;; The frame slot var an `addr_of` reads, i.e. the storage the temp pointer
;; names. `opt-collect-instr-uses-array` counts this operand
;; (`AddrOf _ src -> opt-used-array-add items src`), so its exact function-wide
;; use count answers "is there a SECOND pointer to this storage?".
(define (opt-ctor-fwd-addr-of-slot [instr : CompilerIrInstr]) : i64
  (match instr
    [(CompilerIrInstr.AddrOf _ src) src]
    [_ -1]))

;; Constant byte offset of `var` off `base` when `var` is a `gep base, K : u8`
;; defined in `[lo, hi]`; -1 otherwise.
(define (opt-ctor-fwd-same-base-offset
  [instrs : CompilerIrInstrSeq]
  [lo : i64]
  [hi : i64]
  [base : i64]
  [var : i64]) : i64
  (let
    [index : i64 (opt-ctor-fwd-find-def instrs hi var)]
    (if (or (< index lo) (< index 0))
      -1
      (opt-ctor-fwd-gep-offset (compiler-ir-instr-seq-ref instrs index) base))))

(define (opt-ctor-fwd-ranges-disjoint?
  [a-start : i64]
  [a-size : i64]
  [b-start : i64]
  [b-size : i64]) : bool
  (or (<= (+ a-start a-size) b-start) (<= (+ b-start b-size) a-start)))

;; True for the instructions the window may contain besides the retargeted
;; geps/stores: anything without a memory effect, plus frame `Alloc` (a slot
;; reservation the backend emits no code for), plus a store through a constant
;; offset off the destination base whose bytes provably miss the destination
;; range.
(define (opt-ctor-fwd-window-instr-ok?
  [instrs : CompilerIrInstrSeq]
  [lo : i64]
  [index : i64]
  [dest-base : i64]
  [dest-off : i64]
  [dest-size : i64]) : bool
  (let
    [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
    (match instr
      [(CompilerIrInstr.Alloc _ _) true]
      [(CompilerIrInstr.StorePtr ptr _ ty)
        (match ptr
          [(CompilerIrValue.Var ptr-var)
            (let
              [width : i64 (opt-ctor-fwd-store-byte-size ty)]
              [offset : i64
                (opt-ctor-fwd-same-base-offset
                  instrs
                  lo
                  (- index 1)
                  dest-base
                  ptr-var)]
              (and
                (> width 0)
                (>= offset 0)
                (opt-ctor-fwd-ranges-disjoint? offset width dest-off dest-size)))]
          [_ false])]
      [_
        (match (compiler-ir-instr-effect instr)
          [(CompilerIrEffect.Pure) true]
          [_ false])])))

;; Exact use count of `var` across the whole function; -1 when the var is out of
;; range, which makes every test below fail closed.
(define (opt-ctor-fwd-use-count [uses : (Array i64)] [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length uses)))
    -1
    (array-ref uses var)))

;; Index of the `StorePtr` whose address is exactly `var`, searched in
;; `(from, limit)`; -1 when there is none.
(define (opt-ctor-fwd-find-store
  [instrs : CompilerIrInstrSeq]
  [from : i64]
  [limit : i64]
  [var : i64]) : i64
  (let
    [i : i64 (+ from 1)]
    [found : i64 -1]
    (begin
      (while (and (< found 0) (< i limit))
        (begin
          (match (compiler-ir-instr-seq-ref instrs i)
            [(CompilerIrInstr.StorePtr ptr _ _)
              (match ptr
                [(CompilerIrValue.Var ptr-var)
                  (if (= ptr-var var)
                    (set! found i)
                    unit)]
                [_ unit])]
            [_ unit])
          (set! i (+ i 1))))
      found)))

;; Resolve the copy destination address into `(base var, byte offset, address
;; instruction index)`.
(define (opt-ctor-fwd-resolve-dest
  [instrs : CompilerIrInstrSeq]
  [copy-index : i64]
  [dest-value : CompilerIrValue]) : OptCtorFwdDest
  (match dest-value
    [(CompilerIrValue.Var dest-var)
      (let
        [def-index : i64
          (opt-ctor-fwd-find-def instrs (- copy-index 1) dest-var)]
        [gep-offset : i64
          (if (< def-index 0)
            -1
            (match (compiler-ir-instr-seq-ref instrs def-index)
              [(CompilerIrInstr.Gep _ source offset elem-ty)
                (match elem-ty
                  [(AstType.U8)
                    (match source
                      [(CompilerIrValue.Var _)
                        (match offset
                          [(CompilerIrValue.I64 k) k]
                          [_ -1])]
                      [_ -1])]
                  [_ -1])]
              [_ -1]))]
        (if (>= gep-offset 0)
          (match (compiler-ir-instr-seq-ref instrs def-index)
            [(CompilerIrInstr.Gep _ source _ _)
              (match source
                [(CompilerIrValue.Var source-var)
                  (OptCtorFwdDest.Dest source-var gep-offset def-index)]
                [_ (OptCtorFwdDest.NoDest)])]
            [_ (OptCtorFwdDest.NoDest)])
          (OptCtorFwdDest.Dest dest-var 0 def-index)))]
    [_ (OptCtorFwdDest.NoDest)]))

;; Validate one gep off the temp. Returns the index of its store, `copy-index`
;; when the gep has no uses at all, or -1 when the gep disqualifies the site.
(define (opt-ctor-fwd-gep-store-index
  [instrs : CompilerIrInstrSeq]
  [uses : (Array i64)]
  [copy-index : i64]
  [temp : i64]
  [size : i64]
  [gep-index : i64]) : i64
  (let
    [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs gep-index)]
    [offset : i64 (opt-ctor-fwd-gep-offset instr temp)]
    [gep-dst : i64 (opt-ctor-fwd-gep-dst instr)]
    [gep-uses : i64 (opt-ctor-fwd-use-count uses gep-dst)]
    (cond
      [(< offset 0) -1]
      [(>= offset size) -1]
      [(< gep-uses 0) -1]
      [(= gep-uses 0) copy-index]
      [(> gep-uses 1) -1]
      [else
        (let
          [store-index : i64
            (opt-ctor-fwd-find-store instrs gep-index copy-index gep-dst)]
          (if (< store-index 0)
            -1
            (let
              [width : i64
                (match (compiler-ir-instr-seq-ref instrs store-index)
                  [(CompilerIrInstr.StorePtr _ _ ty)
                    (opt-ctor-fwd-store-byte-size ty)]
                  [_ -1])]
              (if (or (<= width 0) (> (+ offset width) size))
                -1
                store-index))))])))

;; Walk every gep off the temp inside the window. Returns the index of the
;; earliest retargeted store, or -1 when the site is disqualified (clauses 1
;; and 4).
(define (opt-ctor-fwd-scan-geps
  [instrs : CompilerIrInstrSeq]
  [uses : (Array i64)]
  [copy-index : i64]
  [addr-index : i64]
  [temp : i64]
  [size : i64]) : i64
  (let
    [ok : bool true]
    [gep-count : i64 0]
    [first-store : i64 copy-index]
    [i : i64 (+ addr-index 1)]
    (begin
      (while (and ok (< i copy-index))
        (begin
          (if (>=
            (opt-ctor-fwd-gep-offset (compiler-ir-instr-seq-ref instrs i) temp)
            0)
            (let
              [store-index : i64
                (opt-ctor-fwd-gep-store-index
                  instrs
                  uses
                  copy-index
                  temp
                  size
                  i)]
              (begin
                (set! gep-count (+ gep-count 1))
                (if (< store-index 0)
                  (set! ok false)
                  (if (< store-index first-store)
                    (set! first-store store-index)
                    unit))))
            unit)
          (set! i (+ i 1))))
      (if (= gep-count 0)
        (set! ok false)
        unit)
      (if (not (= (opt-ctor-fwd-use-count uses temp) (+ gep-count 1)))
        (set! ok false)
        unit)
      (if ok
        first-store
        -1))))

(define (opt-ctor-fwd-store-into-temp?
  [instrs : CompilerIrInstrSeq]
  [addr-index : i64]
  [index : i64]
  [temp : i64]) : bool
  (match (compiler-ir-instr-seq-ref instrs index)
    [(CompilerIrInstr.StorePtr ptr _ _)
      (match ptr
        [(CompilerIrValue.Var ptr-var)
          (>=
            (opt-ctor-fwd-same-base-offset
              instrs
              addr-index
              (- index 1)
              temp
              ptr-var)
            0)]
        [_ false])]
    [_ false]))

;; Clause (2): every instruction from the first retargeted store to the copy is
;; harmless with respect to the destination bytes.
(define (opt-ctor-fwd-window-ok?
  [instrs : CompilerIrInstrSeq]
  [addr-index : i64]
  [first-store : i64]
  [copy-index : i64]
  [temp : i64]
  [dest-base : i64]
  [dest-off : i64]
  [size : i64]) : bool
  (let
    [ok : bool true]
    [i : i64 first-store]
    (begin
      (while (and ok (< i copy-index))
        (begin
          (unless
            (or
              (>=
                (opt-ctor-fwd-gep-offset
                  (compiler-ir-instr-seq-ref instrs i)
                  temp)
                0)
              (opt-ctor-fwd-store-into-temp? instrs addr-index i temp)
              (opt-ctor-fwd-window-instr-ok?
                instrs
                addr-index
                i
                dest-base
                dest-off
                size))
            (set! ok false))
          (set! i (+ i 1))))
      ok)))

;; Record the rewrite: rebase each field gep onto the destination base and drop
;; the copy.
(define (opt-ctor-fwd-commit
  [instrs : CompilerIrInstrSeq]
  [plan : (Array i64)]
  [bases : (Array i64)]
  [addr-index : i64]
  [copy-index : i64]
  [temp : i64]
  [dest-base : i64]
  [dest-off : i64]) : unit
  (let
    [i : i64 (+ addr-index 1)]
    (begin
      (while (< i copy-index)
        (let
          [offset : i64
            (opt-ctor-fwd-gep-offset (compiler-ir-instr-seq-ref instrs i) temp)]
          (begin
            (if (>= offset 0)
              (begin
                (array-set! plan i (+ dest-off offset))
                (array-set! bases i dest-base))
              unit)
            (set! i (+ i 1)))))
      (array-set! plan copy-index -2))))

(define (opt-ctor-fwd-try-site
  [instrs : CompilerIrInstrSeq]
  [uses : (Array i64)]
  [copy-index : i64]
  [dest-value : CompilerIrValue]
  [temp : i64]
  [size : i64]
  [result-var : i64]
  [plan : (Array i64)]
  [bases : (Array i64)]) : bool
  (if (and
    (>= result-var 0)
    (not (= (opt-ctor-fwd-use-count uses result-var) 0)))
    false
    (let
      [addr-index : i64
        (opt-ctor-fwd-find-addr-of instrs (- copy-index 1) temp)]
      ;; Clause (1), second-pointer half: the frame slot the matched `addr_of`
      ;; reads must have exactly ONE use in the whole function -- that
      ;; `addr_of`. A second `addr_of` of the same slot would hand out an
      ;; independent pointer to `T`, and writes through it would be silently
      ;; dropped when the copy is deleted (the "uncovered bytes are only
      ;; padding" argument assumes `T` holds nothing but our own stores).
      [slot : i64
        (if (< addr-index 0)
          -1
          (opt-ctor-fwd-addr-of-slot
            (compiler-ir-instr-seq-ref instrs addr-index)))]
      (if (or
        (< addr-index 0)
        (< slot 0)
        (not (= (opt-ctor-fwd-use-count uses slot) 1)))
        false
        (match (opt-ctor-fwd-resolve-dest instrs copy-index dest-value)
          [(OptCtorFwdDest.NoDest) false]
          [(OptCtorFwdDest.Dest dest-base dest-off dest-def)
            (let
              [guard-lo : i64
                (if (and (>= dest-def 0) (< dest-def addr-index))
                  dest-def
                  addr-index)]
              (if (or
                (= dest-base temp)
                (opt-ctor-fwd-defined-in-range?
                  instrs
                  guard-lo
                  copy-index
                  dest-base))
                false
                (let
                  [first-store : i64
                    (opt-ctor-fwd-scan-geps
                      instrs
                      uses
                      copy-index
                      addr-index
                      temp
                      size)]
                  (if (or (< first-store 0) (>= first-store copy-index))
                    false
                    (if (opt-ctor-fwd-window-ok?
                      instrs
                      addr-index
                      first-store
                      copy-index
                      temp
                      dest-base
                      dest-off
                      size)
                      (begin
                        (opt-ctor-fwd-commit
                          instrs
                          plan
                          bases
                          addr-index
                          copy-index
                          temp
                          dest-base
                          dest-off)
                        true)
                      false)))))])))))

(define (opt-ctor-fwd-rebuild-from
  [instrs : CompilerIrInstrSeq]
  [plan : (Array i64)]
  [bases : (Array i64)]
  [index : i64]
  [acc : CompilerIrInstrList]) : CompilerIrInstrList
  (if (< index 0)
    acc
    (let
      [action : i64 (array-ref plan index)]
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (opt-ctor-fwd-rebuild-from
        instrs
        plan
        bases
        (- index 1)
        (cond
          [(= action -2) acc]
          [(>= action 0)
            (compiler-ir-instr-cons
              (CompilerIrInstr.Gep
                (opt-ctor-fwd-gep-dst instr)
                (CompilerIrValue.Var (array-ref bases index))
                (CompilerIrValue.I64 action)
                (AstType.U8))
              acc)]
          [else (compiler-ir-instr-cons instr acc)])))))

(define (opt-ctor-fwd-block [uses : (Array i64)] [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (if (not (opt-ctor-fwd-block-candidate? instrs))
        block
        (let
          [count : i64 (compiler-ir-instr-seq-count instrs)]
          [plan : (Array i64) (array.make-array i64 count)]
          [bases : (Array i64) (array.make-array i64 count)]
          [changed : bool false]
          [i : i64 0]
          (begin
            (while (< i count)
              (begin
                (array-set! plan i -1)
                (array-set! bases i 0)
                (set! i (+ i 1))))
            (set! i 0)
            (while (< i count)
              (begin
                (match (opt-ctor-fwd-match-copy
                  (compiler-ir-instr-seq-ref instrs i))
                  [(OptCtorFwdCopy.Copy dest-value temp size result-var)
                    (if (opt-ctor-fwd-try-site
                      instrs
                      uses
                      i
                      dest-value
                      temp
                      size
                      result-var
                      plan
                      bases)
                      (set! changed true)
                      unit)]
                  [(OptCtorFwdCopy.NoCopy) unit])
                (set! i (+ i 1))))
            (if changed
              (compiler-ir-block
                label
                (opt-ctor-fwd-rebuild-from
                  instrs
                  plan
                  bases
                  (- count 1)
                  CompilerIrInstrList.Nil))
              block))))]))

(define (opt-ctor-fwd-blocks
  [uses : (Array i64)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-ctor-fwd-block uses block)
        (opt-ctor-fwd-blocks uses (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-ctor-fwd-blocks uses (compiler-ir-block-seq-to-list seq))]))

(define (opt-ctor-fwd-function-blocks
  [frame : i64]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (if (not (opt-ctor-fwd-blocks-have-candidate? blocks))
    blocks
    (opt-ctor-fwd-blocks (opt-collect-blocks-uses-array frame blocks) blocks)))

(define (optimize-function-once-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (let
    [_t-tailrec : i64 (cfg compile-profile (profile.now-ms) 0)]
    [tailrec : CompilerIrFunction
      (compiler-opt-debug-observe-function
        type-segment-bases
        "tailrec"
        (opt-tailrec-function func))]
    (match tailrec
      [(CompilerIrFunction.Function name params ret-ty frame blocks)
        ;; Fold first so SCCP can reuse local facts, then simplify the reachable
        ;; CFG and eliminate dead pure assignments.
        (let
          [_p-tailrec : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                (struct-get summaries profile-state)
                "tailrec"
                name
                _t-tailrec)
              unit)]
          ;; Substitute proven constant-global operands up front so the local
          ;; folds below see literals: a mask global otherwise keeps its `and`
          ;; alive into the loop cluster, pushing an otherwise-unrollable body
          ;; past the unroll size gate (the opt_crc32 shape). The map is shared
          ;; with the later divisor-targeted rewrite and empty in the common
          ;; case, which makes this a length check per function.
          [const-global-blocks : CompilerIrBlockList
            (opt-const-divisor-rewrite-summary-blocks summaries blocks)]
          [_t-fold : i64 (cfg compile-profile (profile.now-ms) 0)]
          [fold-result : OptBlockListPassResult
            (optimize-block-list-for-function-pass
              pools
              type-segment-bases
              frame
              params
              const-global-blocks)]
          [folded : CompilerIrBlockList
            (compiler-opt-debug-observe-blocks
              type-segment-bases
              "fold"
              name
              params
              ret-ty
              frame
              (match fold-result
                [(OptBlockListPassResult.Result next _) next]))]
          [fold-changed : bool
            (match fold-result
              [(OptBlockListPassResult.Result _ changed) changed])]
          [_p-fold : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                (struct-get summaries profile-state)
                "fold"
                name
                _t-fold)
              unit)]
          [_t-affine : i64 (cfg compile-profile (profile.now-ms) 0)]
          [affine-candidate? : bool (opt-affine-blocks-have-candidate? folded)]
          [affine-input : CompilerIrBlockList
            (if (and affine-candidate? (not fold-changed))
              (compiler-ir-clone-block-list pools folded)
              folded)]
          [affine : CompilerIrBlockList
            (compiler-opt-debug-observe-blocks
              type-segment-bases
              "affine"
              name
              params
              ret-ty
              frame
              (if affine-candidate?
                (opt-affine-fold-blocks frame affine-input)
                folded))]
          [_p-affine : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                (struct-get summaries profile-state)
                "affine"
                name
                _t-affine)
              unit)]
          [loop-bce : CompilerIrBlockList
            (if (struct-get summaries enabled)
              (opt-loop-bce-blocks type-segment-bases summaries params affine)
              affine)]
          [_t-ctor-fwd : i64 (cfg compile-profile (profile.now-ms) 0)]
          [ctor-fwd : CompilerIrBlockList
            (compiler-opt-debug-observe-blocks
              type-segment-bases
              "ctor_fwd"
              name
              params
              ret-ty
              frame
              (opt-ctor-fwd-function-blocks frame loop-bce))]
          [_p-ctor-fwd : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                (struct-get summaries profile-state)
                "ctor_fwd"
                name
                _t-ctor-fwd)
              unit)]
          [_t-promote : i64 (cfg compile-profile (profile.now-ms) 0)]
          [promoted : CompilerIrFunction
            (compiler-opt-debug-observe-function
              type-segment-bases
              "stack_promote"
              (opt-aggregate-stack-promote-function
                type-segment-bases
                (CompilerIrFunction.Function name params ret-ty frame ctor-fwd)))]
          [_p-promote : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                (struct-get summaries profile-state)
                "stack_promote"
                name
                _t-promote)
              unit)]
          (match promoted
            [(CompilerIrFunction.Function _ _ _ promoted-frame promoted-blocks)
              ;; Aggregate field-load SROA runs on the post-promotion
              ;; blocks/frame (it leaves the frame unchanged), so the slots stay
              ;; consistent with the later global-GVN pass below.
              (let
                [_t-sroa : i64 (cfg compile-profile (profile.now-ms) 0)]
                [sroa : CompilerIrFunction
                  (compiler-opt-debug-observe-function
                    type-segment-bases
                    "sroa"
                    (opt-aggregate-sroa-function
                      type-segment-bases
                      (CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        promoted-frame
                        promoted-blocks)))]
                [_p-sroa : unit
                  (cfg
                    compile-profile
                    (compiler-opt-profile-pass-finish
                      (struct-get summaries profile-state)
                      "sroa"
                      name
                      _t-sroa)
                    unit)]
                (match sroa
                  [(CompilerIrFunction.Function _ _ _ _ sroa-blocks)
                    (let
                      [run-heavy? : bool
                        (<=
                          (compiler-ir-block-list-count sroa-blocks)
                          (opt-heavy-pass-block-limit))]
                      ;; Dominator and natural-loop analyses use the integer CFG
                      ;; index. Their admission decisions are loop-local, so an
                      ;; unrelated block elsewhere in the enclosing function
                      ;; must not turn the loop pipeline off.
                      [run-loop? : bool true]
                      [_t-rotation : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [rotation-result : OptBlockCtxResult
                        (if run-loop?
                          (opt-loop-rotation-function-result
                            pools
                            (CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              promoted-frame
                              sroa-blocks))
                          (OptBlockCtxResult.Result
                            sroa-blocks
                            (opt-cfg-context-empty)
                            false))]
                      [rotated : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "rotation"
                          (CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            promoted-frame
                            (match rotation-result
                              [(OptBlockCtxResult.Result b _ _) b])))]
                      [rotation-context : OptCfgContext
                        (match rotation-result
                          [(OptBlockCtxResult.Result _ ctx _) ctx])]
                      [rotation-context-valid? : bool
                        (match rotation-result
                          [(OptBlockCtxResult.Result _ _ valid) valid])]
                      [_p-rotation : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "rotation"
                            name
                            _t-rotation)
                          unit)]
                      ;; Scalar SSA construction feeds the verifier-gated
                      ;; dominator passes below. Unsupported cases fall back to the
                      ;; original function, so the optimization path remains safe.
                      [_t-ssa : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [ssa-result : OptFunctionCtxResult
                        (if run-loop?
                          (opt-ssa-construct-function-from-context-result
                            type-segment-bases
                            rotated
                            rotation-context
                            rotation-context-valid?)
                          (OptFunctionCtxResult.Result
                            rotated
                            (opt-cfg-context-empty)))]
                      [ssa : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "ssa"
                          (match ssa-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [ssa-context : OptCfgContext
                        (match ssa-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-ssa : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "ssa"
                            name
                            _t-ssa)
                          unit)]
                      [ssa-frame : i64 (opt-function-frame ssa)]
                      [ssa-blocks : CompilerIrBlockList
                        (opt-function-blocks ssa)]
                      [_t-gvn : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [gvn : CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "gvn"
                          name
                          params
                          ret-ty
                          ssa-frame
                          (if run-heavy?
                            (opt-gvn-blocks-with-context-and-call-memory
                              type-segment-bases
                              ssa-context
                              params
                              (struct-get summaries call-memory)
                              ssa-blocks)
                            ssa-blocks))]
                      [_p-gvn : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "gvn"
                            name
                            _t-gvn)
                          unit)]
                      ;; Dominated bounds-check dedup rides the same context:
                      ;; it only deletes mid-block BoundsCheck instructions, so
                      ;; the CFG (and ssa-context) stay valid for sccp below.
                      ;; VERIFIER-GATED like GVN: in a fallback (non-SSA)
                      ;; function a textually-single-def var inside a loop
                      ;; still changes value across iterations (loop-carried
                      ;; uses precede the redefinition), so "single source"
                      ;; only implies "single value" when the verifier proves
                      ;; every use is dominated by its definition. GVN
                      ;; preserves that property, so verifying the ssa
                      ;; function covers the gvn blocks consumed here.
                      [_t-bounds-dom : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [bounds-dom : CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "bounds_dom"
                          name
                          params
                          ret-ty
                          ssa-frame
                          (if (and
                            run-loop?
                            (opt-verify-ok?
                              (opt-verify-function-with-context ssa ssa-context)))
                            (opt-bounds-dom-blocks-with-context
                              type-segment-bases
                              ssa-context
                              params
                              ssa-frame
                              gvn)
                            gvn))]
                      [_p-bounds-dom : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "bounds_dom"
                            name
                            _t-bounds-dom)
                          unit)]
                      [_t-sccp : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [sccp-result : OptBlockCtxResult
                        (if run-loop?
                          (opt-sccp-blocks-with-context-result-raw
                            type-segment-bases
                            ssa-context
                            params
                            bounds-dom
                            ssa-frame)
                          (OptBlockCtxResult.Result
                            (opt-sccp-blocks-with-frame
                              type-segment-bases
                              params
                              bounds-dom
                              ssa-frame)
                            (opt-cfg-context-empty)
                            false))]
                      [sccp : CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "sccp"
                          name
                          params
                          ret-ty
                          ssa-frame
                          (match sccp-result
                            [(OptBlockCtxResult.Result b _ _) b]))]
                      [sccp-context : OptCfgContext
                        (match sccp-result
                          [(OptBlockCtxResult.Result _ ctx _) ctx])]
                      [sccp-context-valid : bool
                        (match sccp-result
                          [(OptBlockCtxResult.Result _ _ valid) valid])]
                      [_p-sccp : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "sccp"
                            name
                            _t-sccp)
                          unit)]
                      [_t-bool-branch : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [bool-branch-input : CompilerIrFunction
                        (CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          ssa-frame
                          sccp)]
                      [bool-branch-context : OptCfgContext
                        (if sccp-context-valid
                          sccp-context
                          (if (opt-bool-branch-blocks-have-candidate?
                            type-segment-bases
                            sccp)
                            (opt-cfg-context-build sccp)
                            (opt-cfg-context-empty)))]
                      [bool-branch-result : OptFunctionPassResult
                        (opt-bool-branch-function-with-context-result
                          type-segment-bases
                          bool-branch-context
                          false
                          bool-branch-input)]
                      [bool-branch : CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "bool_branch"
                          name
                          params
                          ret-ty
                          ssa-frame
                          (match bool-branch-result
                            [(OptFunctionPassResult.Result f _)
                              (opt-function-blocks f)]))]
                      [bool-branch-changed : bool
                        (match bool-branch-result
                          [(OptFunctionPassResult.Result _ changed) changed])]
                      [_p-bool-branch : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "bool_branch"
                            name
                            _t-bool-branch)
                          unit)]
                      [_t-cfg2 : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [cfg-result : OptBlockCtxResult
                        (if run-loop?
                          (opt-cfg-simplify-blocks-with-context-result
                            (OptBlockCtxResult.Result
                              bool-branch
                              sccp-context
                              (and sccp-context-valid (not bool-branch-changed))))
                          (OptBlockCtxResult.Result
                            (opt-cfg-simplify-blocks bool-branch)
                            (opt-cfg-context-empty)
                            false))]
                      [cfg : CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "cfg"
                          name
                          params
                          ret-ty
                          ssa-frame
                          (match cfg-result
                            [(OptBlockCtxResult.Result b _ _) b]))]
                      [cfg-context : OptCfgContext
                        (match cfg-result
                          [(OptBlockCtxResult.Result _ ctx _) ctx])]
                      [_p-cfg2 : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "cfg"
                            name
                            _t-cfg2)
                          unit)]
                      [_t-switch : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [switch-input : CompilerIrFunction
                        (CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          ssa-frame
                          cfg)]
                      [switch-result : OptFunctionPassResult
                        (if run-heavy?
                          (opt-switch-form-function-pass switch-input)
                          (OptFunctionPassResult.Result switch-input false))]
                      [switched : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "switch"
                          (match switch-result
                            [(OptFunctionPassResult.Result f _) f]))]
                      [switch-changed : bool
                        (match switch-result
                          [(OptFunctionPassResult.Result _ changed) changed])]
                      [switch-blocks : CompilerIrBlockList
                        (opt-function-blocks switched)]
                      [switch-context : OptCfgContext
                        (if run-loop?
                          (if switch-changed
                            (opt-cfg-context-build switch-blocks)
                            cfg-context)
                          (opt-cfg-context-empty))]
                      [_p-switch : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "switch"
                            name
                            _t-switch)
                          unit)]
                      [_t-preheaders : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      ;; Thread one OptCfgContext per block-state through
                      ;; the preheaders -> rotate_ssa -> scratch_reset -> licm ->
                      ;; induction -> unroll -> global_gvn chain.
                      ;; Each pass's output blocks are fed verbatim to the next,
                      ;; so the context the pass builds for its post-pass verify
                      ;; is exactly what the next pass needs for its entry verify
                      ;; and dominance queries -- no rebuild between passes. Each
                      ;; pass that rewrites the CFG builds one fresh context for
                      ;; its output; the no-op majority reuses its input context.
                      ;;
                      ;; Verification is consolidated at the cluster head: one
                      ;; full verify of the switch-form output, threaded through
                      ;; `verified?`, replaces each cluster pass's entry verify.
                      ;; Every mutating pass still post-verifies its own rewrite
                      ;; (falling back to its input on rejection), so a verified
                      ;; input stays verified across the chain.
                      [loop-cluster-verified? : bool
                        (and
                          run-loop?
                          (opt-verify-ok?
                            (opt-verify-function-with-context
                              (CompilerIrFunction.Function
                                name
                                params
                                ret-ty
                                ssa-frame
                                switch-blocks)
                              switch-context)))]
                      [preheaders-result : OptFunctionCtxResult
                        (if run-loop?
                          (let
                            [preheaders-input : CompilerIrFunction
                              (CompilerIrFunction.Function
                                name
                                params
                                ret-ty
                                ssa-frame
                                switch-blocks)]
                            (opt-loop-preheaders-function-with-context-result
                              switch-context
                              loop-cluster-verified?
                              preheaders-input))
                          (OptFunctionCtxResult.Result
                            (CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              ssa-frame
                              switch-blocks)
                            (opt-cfg-context-empty)))]
                      [preheaders : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "preheaders"
                          (match preheaders-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [preheaders-context : OptCfgContext
                        (match preheaders-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-preheaders : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "preheaders"
                            name
                            _t-preheaders)
                          unit)]
                      [_t-rotate-ssa : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [rotate-ssa-result : OptFunctionCtxResult
                        (if run-loop?
                          (opt-rotate-ssa-function-with-context-result
                            preheaders-context
                            loop-cluster-verified?
                            preheaders)
                          preheaders-result)]
                      [rotate-ssa : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "rotate_ssa"
                          (match rotate-ssa-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [rotate-ssa-context : OptCfgContext
                        (match rotate-ssa-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-rotate-ssa : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "rotate_ssa"
                            name
                            _t-rotate-ssa)
                          unit)]
                      [_t-scratch-reset : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [scratch-reset-result : OptFunctionCtxResult
                        (if run-loop?
                          (opt-scratch-reset-function-with-context-result
                            type-segment-bases
                            rotate-ssa-context
                            loop-cluster-verified?
                            rotate-ssa)
                          rotate-ssa-result)]
                      [scratch-reset : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "scratch_reset"
                          (match scratch-reset-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [scratch-reset-context : OptCfgContext
                        (match scratch-reset-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-scratch-reset : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "scratch_reset"
                            name
                            _t-scratch-reset)
                          unit)]
                      [_t-licm : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [licm-result : OptFunctionCtxResult
                        (if run-loop?
                          (opt-licm-function-with-context-result-and-direct-call-clean
                            type-segment-bases
                            scratch-reset-context
                            loop-cluster-verified?
                            (struct-get summaries direct-call-clean)
                            scratch-reset)
                          scratch-reset-result)]
                      [licm : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "licm"
                          (match licm-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [licm-context : OptCfgContext
                        (match licm-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-licm : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "licm"
                            name
                            _t-licm)
                          unit)]
                      ;; Run successor sinking while block-local address recipes
                      ;; are still explicit. Induction strength reduction below
                      ;; may replace the retained header address with a pointer
                      ;; phi, but the fresh arm clone remains an ordinary bounded
                      ;; rematerialization chain.
                      [pre-induction-sink-result : OptFunctionCtxResult
                        (if run-loop?
                          (opt-successor-sink-function-with-context-result
                            type-segment-bases
                            licm-context
                            licm)
                          licm-result)]
                      [pre-induction-sink : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "pre_induction_sink"
                          (match pre-induction-sink-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [pre-induction-sink-context : OptCfgContext
                        (match pre-induction-sink-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_t-induction : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [induction-result : OptFunctionCtxResult
                        (if run-loop?
                          (opt-induction-function-with-context-result
                            type-segment-bases
                            pre-induction-sink-context
                            loop-cluster-verified?
                            pre-induction-sink)
                          licm-result)]
                      [induction : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "induction"
                          (match induction-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [induction-context : OptCfgContext
                        (match induction-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-induction : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "induction"
                            name
                            _t-induction)
                          unit)]
                      ;; Bounds-check loop versioning runs on induction's
                      ;; output so its check-free fast clone reaches the
                      ;; unroller INSIDE the same pipeline iteration (a
                      ;; lowered while loop rotates in iteration 1 and only
                      ;; reaches canonical shape at the fixpoint cap).
                      [_t-bce-version : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [bce-version-result : OptFunctionCtxResult
                        (if run-loop?
                          (opt-bce-version-function-with-context-result
                            induction-context
                            loop-cluster-verified?
                            induction)
                          induction-result)]
                      [bce-version : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "bce_version"
                          (match bce-version-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [bce-version-context : OptCfgContext
                        (match bce-version-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-bce-version : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "bce_version"
                            name
                            _t-bce-version)
                          unit)]
                      ;; Canonical counted-loop unrolling (x4) runs on
                      ;; the versioned blocks. A successful rewrite
                      ;; versions at most one loop per pipeline iteration and
                      ;; rebuilds the context for the new CFG, so the stages
                      ;; below keep valid dominance facts.
                      [_t-unroll : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [unroll-result : OptFunctionCtxResult
                        (if run-loop?
                          (opt-unroll-function-with-context-result
                            type-segment-bases
                            bce-version-context
                            loop-cluster-verified?
                            bce-version)
                          bce-version-result)]
                      [unrolled : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "unroll"
                          (match unroll-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [unroll-context : OptCfgContext
                        (match unroll-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-unroll : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "unroll"
                            name
                            _t-unroll)
                          unit)]
                      ;; Linear-function test replacement runs here, after
                      ;; bce_version and unroll: both key their rewrites on the
                      ;; counter phi this pass retires, so it has to see their
                      ;; output rather than take their input away. The retired
                      ;; form is handed straight to affine-fold/GVN below.
                      [_t-lftr : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [lftr-result : OptFunctionCtxResult
                        (if run-loop?
                          (opt-lftr-function-with-context-result
                            type-segment-bases
                            unroll-context
                            loop-cluster-verified?
                            unrolled)
                          unroll-result)]
                      [lftr : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "lftr"
                          (match lftr-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [lftr-context : OptCfgContext
                        (match lftr-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-lftr : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "lftr"
                            name
                            _t-lftr)
                          unit)]
                      [unroll-frame : i64 (opt-function-frame lftr)]
                      ;; Affine chain folding must see the unroller's output
                      ;; INSIDE the same pipeline iteration: a lowered while
                      ;; loop spends iteration 1 on SSA+rotation and unrolls in
                      ;; iteration 2 (the fixpoint cap), so the fold-position
                      ;; run above never sees the fresh copies. The pass only
                      ;; rewrites instructions in place (no CFG change), so the
                      ;; unroll context stays valid for the passes below.
                      [unroll-blocks : CompilerIrBlockList
                        (opt-affine-fold-blocks
                          (opt-function-frame lftr)
                          (opt-function-blocks lftr))]
                      ;; Cross-block global value numbering + copy propagation
                      ;; runs after local GVN/SCCP/CFG/LICM cleanup, on
                      ;; the post-stack-promotion frame so its slots stay
                      ;; consistent with the promoted blocks. It reuses the
                      ;; context unroll handed back: unroll's output
                      ;; blocks are global_gvn's input blocks unchanged.
                      ;; Its entry verify rides the loop-cluster verification:
                      ;; every pass in between post-verifies its own rewrite
                      ;; (falling back to its verified input), so a verified
                      ;; cluster input arrives here still verified.
                      [_t-global : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [global : CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "global_gvn"
                          (if run-heavy?
                            (opt-global-value-number-function-with-context
                              type-segment-bases
                              lftr-context
                              loop-cluster-verified?
                              (CompilerIrFunction.Function
                                name
                                params
                                ret-ty
                                unroll-frame
                                unroll-blocks))
                            (CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              unroll-frame
                              unroll-blocks)))]
                      [_p-global : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "global_gvn"
                            name
                            _t-global)
                          unit)]
                      [global-blocks : CompilerIrBlockList
                        (opt-function-blocks global)]
                      ;; Substitute proven constant-global divisors with
                      ;; their literals before divrem-safety, so the literal
                      ;; divisor both enables the backend magic-multiply path and
                      ;; lets divrem-safety drop the zero/overflow guards. This
                      ;; only rewrites a binop's RHS operand value, leaving the
                      ;; CFG structure intact, so the unroll context stays
                      ;; valid for the divrem-safety pass below.
                      [const-div-blocks : CompilerIrBlockList
                        (opt-const-divisor-rewrite-summary-blocks
                          summaries
                          global-blocks)]
                      [_t-divrem-safety : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [divrem-safe : CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "divrem_safety"
                          name
                          params
                          ret-ty
                          unroll-frame
                          (if run-heavy?
                            (opt-divrem-safety-blocks-with-context
                              type-segment-bases
                              lftr-context
                              params
                              const-div-blocks)
                            const-div-blocks))]
                      [_p-divrem-safety : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "divrem_safety"
                            name
                            _t-divrem-safety)
                          unit)]
                      ;; Split multi-use Geps into per-use single-use Geps so
                      ;; the backend's indexed-memory fusion fires on every
                      ;; Load/StorePtr (the quicksort swap shape). DCE then
                      ;; drops the now-unused original Gep defs.
                      [_t-gep-split : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [gep-split : CompilerIrFunction
                        (if run-heavy?
                          (opt-gep-split-function
                            type-segment-bases
                            (CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              unroll-frame
                              divrem-safe))
                          (CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            unroll-frame
                            divrem-safe))]
                      [_p-gep-split : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "gep_split"
                            name
                            _t-gep-split)
                          unit)]
                      [gep-split-frame : i64 (opt-function-frame gep-split)]
                      [gep-split-blocks : CompilerIrBlockList
                        (opt-function-blocks gep-split)]
                      [_t-cmp-sink : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      ;; Sink loop-closing compares next to their branches so
                      ;; the backend's compare+branch fusion fires past the
                      ;; flag-safe pointer-increment Gep (the counted-fill
                      ;; shape's setl/movzbq/test/jne becomes cmp;jcc).
                      [cmp-sink : CompilerIrBlockList
                        (opt-cmp-sink-blocks gep-split-blocks)]
                      [_p-cmp-sink : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "cmp_sink"
                            name
                            _t-cmp-sink)
                          unit)]
                      [_t-successor-sink : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [successor-sink-function : CompilerIrFunction
                        (if run-heavy?
                          (opt-successor-sink-function
                            type-segment-bases
                            (CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              gep-split-frame
                              cmp-sink))
                          (CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            gep-split-frame
                            cmp-sink))]
                      [successor-sink : CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "successor_sink"
                          name
                          params
                          ret-ty
                          (opt-function-frame successor-sink-function)
                          (opt-function-blocks successor-sink-function))]
                      [successor-sink-frame : i64
                        (opt-function-frame successor-sink-function)]
                      [_p-successor-sink : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "successor_sink"
                            name
                            _t-successor-sink)
                          unit)]
                      ;; BCE versioning runs after the early bool-branch pass
                      ;; and may be the final CFG rewrite at the two-iteration
                      ;; fixpoint cap. Lower its materialized And guards here,
                      ;; after the passes that consume a single condition value
                      ;; and before DCE/regalloc. The shared helper retains its
                      ;; clone + verify rollback boundary.
                      [_t-bool-branch-late : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [bool-branch-late-input : CompilerIrFunction
                        (CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          successor-sink-frame
                          successor-sink)]
                      [bool-branch-late-result : OptFunctionPassResult
                        (if run-heavy?
                          (opt-bool-branch-chain-function-with-context-result
                            type-segment-bases
                            (if (opt-bool-branch-chain-blocks-have-candidate?
                              successor-sink)
                              (opt-cfg-context-build successor-sink)
                              (opt-cfg-context-empty))
                            false
                            bool-branch-late-input)
                          (OptFunctionPassResult.Result
                            bool-branch-late-input
                            false))]
                      [bool-branch-late-function : CompilerIrFunction
                        (match bool-branch-late-result
                          [(OptFunctionPassResult.Result f _) f])]
                      [bool-branch-late : CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "bool_branch_late"
                          name
                          params
                          ret-ty
                          (opt-function-frame bool-branch-late-function)
                          (opt-function-blocks bool-branch-late-function))]
                      [bool-branch-late-frame : i64
                        (opt-function-frame bool-branch-late-function)]
                      [_p-bool-branch-late : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "bool_branch_late"
                            name
                            _t-bool-branch-late)
                          unit)]
                      [_t-dce : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [used : (Array i64)
                        (opt-collect-blocks-uses-array
                          bool-branch-late-frame
                          bool-branch-late)]
                      [dce-result : OptBlockListPassResult
                        (opt-dce-block-list-array-pass used bool-branch-late)]
                      [dced : CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "dce"
                          name
                          params
                          ret-ty
                          bool-branch-late-frame
                          (match dce-result
                            [(OptBlockListPassResult.Result next _) next]))]
                      [_p-dce : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            (struct-get summaries profile-state)
                            "dce"
                            name
                            _t-dce)
                          unit)]
                      (CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        bool-branch-late-frame
                        dced))]))]))])))

(define (optimize-function-once
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (optimize-function-once-with-summaries
    pools
    type-segment-bases
    func
    (opt-loop-bce-empty-summaries)))

;; Level 2 keeps the self-build path lightweight while preserving the explicit
;; optimized-level checks for local scalar cleanup, bounds checks, stack
;; promotion, CFG cleanup, DCE, and program-level reachability pruning.
(defenum OptLevel1PreDceResult
  (Result CompilerIrFunction (Array i64)))

(define (optimize-function-once-level2-pre-dce-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : OptLevel1PreDceResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [_t-fold : i64 (cfg compile-profile (profile.now-ms) 0)]
        [folded : CompilerIrBlockList
          (compiler-opt-debug-observe-blocks
            type-segment-bases
            "fold"
            name
            params
            ret-ty
            frame
            (optimize-block-list-for-function
              pools
              type-segment-bases
              frame
              params
              blocks))]
        [_p-fold : unit
          (cfg
            compile-profile
            (compiler-opt-profile-pass-finish
              (struct-get summaries profile-state)
              "fold"
              name
              _t-fold)
            unit)]
        [loop-bce : CompilerIrBlockList
          (if (struct-get summaries enabled)
            (opt-loop-bce-blocks type-segment-bases summaries params folded)
            folded)]
        [_t-ctor-fwd : i64 (cfg compile-profile (profile.now-ms) 0)]
        [ctor-fwd : CompilerIrBlockList
          (compiler-opt-debug-observe-blocks
            type-segment-bases
            "ctor_fwd"
            name
            params
            ret-ty
            frame
            (opt-ctor-fwd-function-blocks frame loop-bce))]
        [_p-ctor-fwd : unit
          (cfg
            compile-profile
            (compiler-opt-profile-pass-finish
              (struct-get summaries profile-state)
              "ctor_fwd"
              name
              _t-ctor-fwd)
            unit)]
        [_t-promote : i64 (cfg compile-profile (profile.now-ms) 0)]
        [promoted : CompilerIrFunction
          (compiler-opt-debug-observe-function
            type-segment-bases
            "stack_promote"
            (opt-aggregate-stack-promote-function
              type-segment-bases
              (CompilerIrFunction.Function name params ret-ty frame ctor-fwd)))]
        [_p-promote : unit
          (cfg
            compile-profile
            (compiler-opt-profile-pass-finish
              (struct-get summaries profile-state)
              "stack_promote"
              name
              _t-promote)
            unit)]
        (match promoted
          [(CompilerIrFunction.Function _ _ _ promoted-frame promoted-blocks)
            (let
              [_t-cfg : i64 (cfg compile-profile (profile.now-ms) 0)]
              [used : (Array i64) (opt-used-array-new promoted-frame)]
              [cfg : CompilerIrBlockList
                (compiler-opt-debug-observe-blocks
                  type-segment-bases
                  "cfg"
                  name
                  params
                  ret-ty
                  promoted-frame
                  (opt-cfg-simplify-blocks-in-place promoted-blocks used))]
              [_p-cfg : unit
                (cfg
                  compile-profile
                  (compiler-opt-profile-pass-finish
                    (struct-get summaries profile-state)
                    "cfg"
                    name
                    _t-cfg)
                  unit)]
              (OptLevel1PreDceResult.Result
                (CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  promoted-frame
                  cfg)
                used))]))]))

(define (optimize-function-once-level2-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (match (optimize-function-once-level2-pre-dce-with-summaries
    pools
    type-segment-bases
    func
    summaries)
    [(OptLevel1PreDceResult.Result pre-dce used)
      (match pre-dce
        [(CompilerIrFunction.Function name params ret-ty frame blocks)
          (let
            [_t-dce : i64 (cfg compile-profile (profile.now-ms) 0)]
            [dced : CompilerIrBlockList
              (compiler-opt-debug-observe-blocks
                type-segment-bases
                "dce"
                name
                params
                ret-ty
                frame
                (opt-dce-block-list-array-in-place used blocks))]
            [_p-dce : unit
              (cfg
                compile-profile
                (compiler-opt-profile-pass-finish
                  (struct-get summaries profile-state)
                  "dce"
                  name
                  _t-dce)
                unit)]
            (CompilerIrFunction.Function name params ret-ty frame dced))])]))

(define (optimize-function-pass-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : OptFunctionPassResult
  (let
    [next : CompilerIrFunction
      (optimize-function-once-with-summaries
        pools
        type-segment-bases
        func
        summaries)]
    [changed : bool (not (opt-function-eq type-segment-bases func next))]
    (OptFunctionPassResult.Result
      (if changed
        next
        func)
      changed)))

(define (optimize-function-fixed-pass-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [remaining : i64]
  [summaries : OptLoopBceSummaries]) : OptFunctionPassResult
  (if (<= remaining 0)
    (OptFunctionPassResult.Result func false)
    (match (optimize-function-pass-with-summaries
      pools
      type-segment-bases
      func
      summaries)
      [(OptFunctionPassResult.Result next changed)
        (if changed
          (match (optimize-function-fixed-pass-with-summaries
            pools
            type-segment-bases
            next
            (- remaining 1)
            summaries)
            [(OptFunctionPassResult.Result fixed _)
              (OptFunctionPassResult.Result fixed true)])
          (OptFunctionPassResult.Result func false))])))

(define (optimize-function-fixed-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [remaining : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (match (optimize-function-fixed-pass-with-summaries
    pools
    type-segment-bases
    func
    remaining
    summaries)
    [(OptFunctionPassResult.Result next _) next]))

(define (optimize-function-fixed
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [remaining : i64]) : CompilerIrFunction
  (optimize-function-fixed-with-summaries
    pools
    type-segment-bases
    func
    remaining
    (opt-loop-bce-empty-summaries)))

(define (opt-if-convert-final-pass
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : OptFunctionPassResult
  (match (opt-if-convert-function-pass type-segment-bases func)
    [(OptFunctionPassResult.Result next changed)
      (OptFunctionPassResult.Result
        (compiler-opt-debug-observe-function
          type-segment-bases
          "if_convert"
          next)
        changed)]))

(define (opt-if-convert-final
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-if-convert-final-pass type-segment-bases func)
    [(OptFunctionPassResult.Result next _) next]))

(define (optimize-function
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (opt-if-convert-final
    type-segment-bases
    (optimize-function-fixed
      pools
      type-segment-bases
      func
      (optimize-function-max-iterations))))

;; Opt levels (0/1/2): 0 = none, 1 = cheap stack-only (the fast self-compile
;; path), 2 = the full optimizer + scalar register allocation + inlining (the
;; quality "ship" build). The old four-level scheme (with a redundant -fast level
;; between 0 and the cheap level) was collapsed: old level 2 became level 1 and
;; old level 3 became level 2.
(define (optimize-function-with-level-and-summaries-pass
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [level : i64]
  [summaries : OptLoopBceSummaries]) : OptFunctionPassResult
  (if (= level 0)
    (OptFunctionPassResult.Result func false)
    (if (= level 1)
      ;; Keep the documented cheap self-compile path cheap.  The final
      ;; if-conversion boundary performs CFG and natural-loop analysis and is
      ;; reserved for the release-quality level below; compare/test lowering
      ;; remains part of this single optimizer pass.
      (let
        [next : CompilerIrFunction
          (optimize-function-once-level2-with-summaries
            pools
            type-segment-bases
            func
            summaries)]
        [changed : bool (not (opt-function-eq type-segment-bases func next))]
        (OptFunctionPassResult.Result
          (if changed
            next
            func)
          changed))
      (match (optimize-function-fixed-pass-with-summaries
        pools
        type-segment-bases
        func
        (optimize-function-max-iterations)
        summaries)
        [(OptFunctionPassResult.Result fixed fixed-changed)
          (match (opt-if-convert-final-pass type-segment-bases fixed)
            [(OptFunctionPassResult.Result final if-convert-changed)
              (OptFunctionPassResult.Result
                final
                (or fixed-changed if-convert-changed))])]))))

(define (optimize-function-with-level-and-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [level : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (match (optimize-function-with-level-and-summaries-pass
    pools
    type-segment-bases
    func
    level
    summaries)
    [(OptFunctionPassResult.Result next _) next]))

(define (optimize-function-with-level
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [level : i64]) : CompilerIrFunction
  (optimize-function-with-level-and-summaries
    pools
    type-segment-bases
    func
    level
    (opt-loop-bce-empty-summaries)))

;; Per-function arena escape. The optimizer fixpoint allocates up to
;; ~80 throwaway IR copies per function (10 iterations x ~8 passes), none freed
;; by the bump allocator. To cap peak memory we run each function's optimization
;; in a reusable scratch arena, deep-`clone` only the final result back into the
;; enclosing (program) arena, then rewind the scratch so a single function's
;; transient generations are reclaimed before the next function is processed.
;; Level 1 is a single cheap pass sequence, so it combines final DCE, compaction,
;; and escape materialization into one enclosing-arena pass instead of compacting
;; in scratch and then cloning the whole function. The scratch path remains for
;; opt2/fixpoint.
(define (optimize-function-list-with-level-and-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [funcs : CompilerIrFunctionList]
  [level : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunctionList
  (if (= level 0)
    funcs
    (if (= level 1)
      (let
        [scratch : i64 (arena.tl_arena_make)]
        [result : CompilerIrFunctionList
          (optimize-function-list-level1-escaping-with-summaries
            pools
            type-segment-bases
            funcs
            scratch
            summaries)]
        (begin
          (allocation_profile.compiler-allocation-profile-control!
            2
            "optimize"
            "optimizer-scratch"
            scratch)
          (unsafe
            (arena.tl_arena_destroy scratch))
          result))
      (let
        [scratch : i64 (arena.tl_arena_make)]
        [result : CompilerIrFunctionList
          (optimize-function-list-escaping-with-summaries
            pools
            type-segment-bases
            funcs
            level
            scratch
            summaries)]
        (begin
          (allocation_profile.compiler-allocation-profile-control!
            2
            "optimize"
            "optimizer-scratch"
            scratch)
          (unsafe
            (arena.tl_arena_destroy scratch))
          result)))))

(define (optimize-function-level1-escaping-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [_profile-name : String
      (cfg compile-profile (compiler-opt-profile-function-name func) "")]
    (begin
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        [_t-body : i64 (cfg compile-profile (profile.now-ms) 0)]
        [pre-dce-result : OptLevel1PreDceResult
          (optimize-function-once-level2-pre-dce-with-summaries
            pools
            type-segment-bases
            func
            summaries)]
        [_profile-body : unit
          (cfg
            compile-profile
            (compiler-opt-profile-escape-finish "body" 1 _profile-name _t-body))]
        (match pre-dce-result
          [(OptLevel1PreDceResult.Result pre-dce used)
            (match pre-dce
              [(CompilerIrFunction.Function name params ret-ty frame blocks)
                (let
                  [_t-dce : i64 (cfg compile-profile (profile.now-ms) 0)]
                  [scratch-head : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set enclosing))
                    (let
                      [escaped-blocks : CompilerIrBlockList
                        (opt-dce-block-list-array-escape pools used blocks)]
                      [escaped : CompilerIrFunction
                        (CompilerIrFunction.Function
                          (compiler-ir-symbol-clone name)
                          (compiler-ir-clone-param-list pools params)
                          (compiler-ir-clone-type pools ret-ty)
                          frame
                          escaped-blocks)]
                      [_profile-dce : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-escape-finish
                            "dce_escape"
                            1
                            _profile-name
                            _t-dce))]
                      [new-enclosing : i64 (arena.tl_arena_current)]
                      [_t-restore : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [_restore : unit
                        (unsafe
                          (arena.tl_arena_set scratch-head)
                          (arena.tl_region_reset mark)
                          (arena.tl_arena_set new-enclosing))]
                      [_profile-restore : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-escape-finish
                            "restore"
                            1
                            _profile-name
                            _t-restore))]
                      escaped)))])])))))

(define (optimize-function-list-level1-escaping-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [funcs : CompilerIrFunctionList]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunctionList
  (match funcs
    [(CompilerIrFunctionList.Nil) (CompilerIrFunctionList.Nil)]
    [(CompilerIrFunctionList.Cons func rest)
      (let
        [_start : unit
          (cfg
            compile-profile
            (compiler-opt-profile-detail-start
              (struct-get summaries profile-state)))]
        [optimized : CompilerIrFunction
          (optimize-function-level1-escaping-with-summaries
            pools
            type-segment-bases
            func
            scratch
            summaries)]
        [_report : unit
          (cfg
            compile-profile
            (compiler-opt-scratch-region-report-function-escaping
              type-segment-bases
              optimized
              scratch))]
        [_finish : unit
          (cfg
            compile-profile
            (compiler-opt-profile-detail-finish
              (struct-get summaries profile-state)
              "function"
              (compiler-opt-profile-function-name func)))]
        (compiler-ir-function-cons
          optimized
          (optimize-function-list-level1-escaping-with-summaries
            pools
            type-segment-bases
            (box-get rest)
            scratch
            summaries)))]
    [(CompilerIrFunctionList.Array seq)
      (compiler-ir-function-list-compact
        (optimize-function-list-level1-escaping-with-summaries
          pools
          type-segment-bases
          (compiler-ir-function-seq-to-list seq)
          scratch
          summaries))]))

(define (optimize-function-list-escaping-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [funcs : CompilerIrFunctionList]
  [level : i64]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunctionList
  (match funcs
    [(CompilerIrFunctionList.Nil) (CompilerIrFunctionList.Nil)]
    [(CompilerIrFunctionList.Cons func rest)
      (let
        [_start : unit
          (cfg
            compile-profile
            (compiler-opt-profile-detail-start
              (struct-get summaries profile-state)))]
        [optimized : CompilerIrFunction
          (optimize-function-escaping-with-summaries
            pools
            type-segment-bases
            func
            level
            scratch
            summaries)]
        [_report : unit
          (cfg
            compile-profile
            (compiler-opt-scratch-region-report-function-escaping
              type-segment-bases
              optimized
              scratch))]
        [_finish : unit
          (cfg
            compile-profile
            (compiler-opt-profile-detail-finish
              (struct-get summaries profile-state)
              "function"
              (compiler-opt-profile-function-name func)))]
        (compiler-ir-function-cons
          optimized
          (optimize-function-list-escaping-with-summaries
            pools
            type-segment-bases
            (box-get rest)
            level
            scratch
            summaries)))]
    [(CompilerIrFunctionList.Array seq)
      (compiler-ir-function-list-compact
        (optimize-function-list-escaping-with-summaries
          pools
          type-segment-bases
          (compiler-ir-function-seq-to-list seq)
          level
          scratch
          summaries))]))

;; Optimize one function inside `scratch`, compact its blocks there, then escape
;; the result by deep-cloning it into the enclosing arena and rewinding `scratch`
;; for reuse. Even a no-op function must cross this ownership boundary: the
;; optimizer input belongs to the lower-IR arena, which is released before the
;; backend consumes the optimized program.
(define (optimize-function-escaping-with-summaries
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [level : i64]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [_profile-name : String
      (cfg compile-profile (compiler-opt-profile-function-name func) "")]
    (begin
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        [_t-body : i64 (cfg compile-profile (profile.now-ms) 0)]
        [body-result : OptFunctionPassResult
          (optimize-function-with-level-and-summaries-pass
            pools
            type-segment-bases
            func
            level
            summaries)]
        [_profile-body : unit
          (cfg
            compile-profile
            (compiler-opt-profile-escape-finish
              "body"
              level
              _profile-name
              _t-body))]
        (match body-result
          [(OptFunctionPassResult.Result body _)
            (let
              [_t-compact : i64 (cfg compile-profile (profile.now-ms) 0)]
              [optimized : CompilerIrFunction
                (compiler-ir-function-compact-blocks body)]
              [_profile-compact : unit
                (cfg
                  compile-profile
                  (compiler-opt-profile-escape-finish
                    "compact"
                    level
                    _profile-name
                    _t-compact))]
              [scratch-head : i64 (arena.tl_arena_current)]
              (begin
                (unsafe
                  (arena.tl_arena_set enclosing))
                (let
                  [_t-clone : i64 (cfg compile-profile (profile.now-ms) 0)]
                  [escaped : CompilerIrFunction
                    (compiler-ir-clone-function pools optimized)]
                  [_profile-clone : unit
                    (cfg
                      compile-profile
                      (compiler-opt-profile-escape-finish
                        "clone"
                        level
                        _profile-name
                        _t-clone))]
                  [new-enclosing : i64 (arena.tl_arena_current)]
                  [_t-restore : i64 (cfg compile-profile (profile.now-ms) 0)]
                  [_restore : unit
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set new-enclosing))]
                  [_profile-restore : unit
                    (cfg
                      compile-profile
                      (compiler-opt-profile-escape-finish
                        "restore"
                        level
                        _profile-name
                        _t-restore))]
                  escaped)))])))))

(defenum OptMaybeFunction
  (No)
  (Some CompilerIrFunction))

(defenum OptSlotList
  (Nil)
  (Cons i64 (Box OptSlotList)))

(defstruct OptFunctionNameIndex
  (ids opt_i64_i64_map.Map))

(defstruct OptFunctionIndex
  (names OptFunctionNameIndex)
  (values (Array CompilerIrFunction))
  (leaf-starts (Array i64)))

(defstruct OptCallGraph
  (count i64)
  (edges (Array OptSlotList)))

(defstruct OptInlineCensus
  ;; Both maps are keyed by OptFunctionIndex dense slots. IR spellings are
  ;; resolved once at the index boundary and never retained as census keys.
  (refcount opt_i64_i64_map.Map)
  (addrtaken opt_i64_i64_map.Map))

(defstruct OptSccResult
  (scc-of (Array i64))
  (order (Array i64)))

(defenum OptSccDiscoverState
  (State i64 i64))

(defenum OptSccPopState
  (State i64 i64))

;; Reachability working set keyed on each function's dense index slot (the value
;; OptFunctionIndex.names already maps a name to). `reachable` dedups by slot
;; (a generated i64/i64 map) and the worklist carries slots, so per-edge dedup,
;; membership, and pop-and-resolve are O(1) i64 compares instead of re-hashing
;; and string_eq-ing the name (string_eq was ~6% of an opt1 self-compile,
;; dominated by these
;; reach/cfg sweeps). One name->slot probe per reference stays (unavoidable to
;; resolve a reference), but the index value is a plain slot, so no global intern
;; table is mutated -- IR names live in the transient optimize arena and interning
;; them would dangle a table pointer after the rewind.
(defenum OptReachWorklist
  (Nil)
  (Cons i64 (Box OptReachWorklist)))

(defenum OptReachState
  (State opt_i64_i64_map.Map OptReachWorklist opt_i64_i64_map.Map i64))

(defenum OptRuntimeStringHelper
  (No)
  (Some String i64))

(defenum OptPrunedProgram
  (Program CompilerIrGlobalList CompilerIrFunctionList))

(define (opt-pruned-program-globals [pruned : OptPrunedProgram]) : CompilerIrGlobalList
  (match pruned
    [(OptPrunedProgram.Program globals _) globals]))

(define (opt-pruned-program-functions [pruned : OptPrunedProgram]) : CompilerIrFunctionList
  (match pruned
    [(OptPrunedProgram.Program _ functions) functions]))

(define (opt-function-index-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (opt-function-list-count [functions : CompilerIrFunctionList]) : i64
  (match functions
    [(CompilerIrFunctionList.Nil) 0]
    [(CompilerIrFunctionList.Cons _ rest)
      (+ 1 (opt-function-list-count (box-get rest)))]
    [(CompilerIrFunctionList.Array seq) (compiler-ir-function-seq-count seq)]))

(define (opt-function-name-index-add
  [names : OptFunctionNameIndex]
  [name : i64]
  [slot : i64]) : OptFunctionNameIndex
  (let
    [ids : opt_i64_i64_map.Map (struct-get names ids)]
    [name-id : i64 (compiler-ir-symbol-id name)]
    (begin
      (if (>= name-id 0)
        (opt_i64_i64_map.insert-ref! (&mut ids) name-id slot)
        unit)
      (OptFunctionNameIndex ids))))

(define (opt-function-index-fill
  [functions : CompilerIrFunctionList]
  [names : OptFunctionNameIndex]
  [values : (Array CompilerIrFunction)]
  [leaf-starts : (Array i64)]
  [index : i64]) : OptFunctionNameIndex
  (match functions
    [(CompilerIrFunctionList.Nil) names]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ _)
          (begin
            (array-set! values index func)
            (array-set!
              leaf-starts
              index
              (opt-symbol-leaf-start (compiler-ir-symbol-text name)))
            (opt-function-index-fill
              (box-get rest)
              (opt-function-name-index-add names name index)
              values
              leaf-starts
              (+ index 1)))])]
    [(CompilerIrFunctionList.Array seq)
      (opt-function-index-fill
        (compiler-ir-function-seq-to-list seq)
        names
        values
        leaf-starts
        index)]))

(define (opt-function-index-build [functions : CompilerIrFunctionList]) : OptFunctionIndex
  (let
    [count : i64 (opt-function-list-count functions)]
    [values : (Array CompilerIrFunction)
      (array.make-array CompilerIrFunction count)]
    [leaf-starts : (Array i64) (array.make-array i64 count)]
    [names : OptFunctionNameIndex
      (opt-function-index-fill
        functions
        (OptFunctionNameIndex
          (opt_i64_i64_map.with-capacity (opt-function-index-capacity count)))
        values
        leaf-starts
        0)]
    (OptFunctionIndex names values leaf-starts)))

(define (opt-function-index-count [index : OptFunctionIndex]) : i64
  (array-length (struct-get index values)))

(define (opt-function-index-slot-id [index : OptFunctionIndex] [name-id : i64]) : option_i64.Option
  (if (< name-id 0)
    (option_i64.None)
    (let
      [slot : i64
        (opt_i64_i64_map.get-value-or
          (& (struct-get (struct-get index names) ids))
          name-id
          -1)]
      (if (>= slot 0)
        (option_i64.Some slot)
        (option_i64.None)))))

(define (opt-function-index-slot [index : OptFunctionIndex] [name : i64]) : option_i64.Option
  (opt-function-index-slot-id index (compiler-ir-symbol-id name)))

;; Resolve a function by its dense index slot (the value held in `names` and in
;; the reachability worklist). Slots only come from a successful name lookup, so
;; they are always in range.
(define (opt-function-index-at-slot [index : OptFunctionIndex] [slot : i64]) : CompilerIrFunction
  (array-ref (struct-get index values) slot))

(define (opt-slot-list-contains? [slots : OptSlotList] [slot : i64]) : bool
  (match slots
    [(OptSlotList.Nil) false]
    [(OptSlotList.Cons item rest)
      (if (= item slot)
        true
        (opt-slot-list-contains? (box-get rest) slot))]))

(define (opt-slot-list-add [slots : OptSlotList] [slot : i64]) : OptSlotList
  (if (opt-slot-list-contains? slots slot)
    slots
    (OptSlotList.Cons slot (box slots))))

(define (opt-slot-list-count [slots : OptSlotList]) : i64
  (match slots
    [(OptSlotList.Nil) 0]
    [(OptSlotList.Cons _ rest) (+ 1 (opt-slot-list-count (box-get rest)))]))

(define (opt-callgraph-add-callee
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [name : i64]) : OptSlotList
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot) (opt-slot-list-add callees slot)]
    [(option_i64.None) callees]))

;; Deliberately call-only: address-taken function values are reachability roots,
;; but they are not direct call-graph edges for the inliner.
(define (opt-callgraph-instr
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [instr : CompilerIrInstr]) : OptSlotList
  (match instr
    [(CompilerIrInstr.Call _ name _ _)
      (opt-callgraph-add-callee index callees name)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ name _ _)
          (opt-callgraph-add-callee index callees name)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload name _ _ _ _ _)
          (opt-callgraph-add-callee index callees name)])]
    [(CompilerIrInstr.TailCall name _ _)
      (opt-callgraph-add-callee index callees name)]
    [_ callees]))

(define (opt-callgraph-instr-seq-from
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [slots : (Array CompilerIrInstr)]
  [instr-index : i64]
  [count : i64]) : OptSlotList
  (if (>= instr-index count)
    callees
    (opt-callgraph-instr-seq-from
      index
      (opt-callgraph-instr index callees (array-ref slots instr-index))
      slots
      (+ instr-index 1)
      count)))

(define (opt-callgraph-instr-seq
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [instrs : CompilerIrInstrSeq]) : OptSlotList
  (opt-callgraph-instr-seq-from
    index
    callees
    (struct-get instrs slots)
    0
    (struct-get instrs len)))

(define (opt-callgraph-blocks
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [blocks : CompilerIrBlockList]) : OptSlotList
  (match blocks
    [(CompilerIrBlockList.Nil) callees]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-callgraph-blocks
            index
            (opt-callgraph-instr-seq index callees instrs)
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (opt-callgraph-blocks index callees (compiler-ir-block-seq-to-list seq))]))

(define (opt-callgraph-callees
  [index : OptFunctionIndex]
  [func : CompilerIrFunction]) : OptSlotList
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-callgraph-blocks index OptSlotList.Nil blocks)]))

(define (opt-callgraph-init-edges
  [edges : (Array OptSlotList)]
  [slot : i64]
  [count : i64]) : unit
  (if (>= slot count)
    unit
    (begin
      (array-set! edges slot OptSlotList.Nil)
      (opt-callgraph-init-edges edges (+ slot 1) count))))

(define (opt-callgraph-build-slots
  [index : OptFunctionIndex]
  [edges : (Array OptSlotList)]
  [values : (Array CompilerIrFunction)]
  [slot : i64]
  [count : i64]) : unit
  (if (>= slot count)
    unit
    (begin
      (array-set!
        edges
        slot
        (opt-callgraph-callees index (array-ref values slot)))
      (opt-callgraph-build-slots index edges values (+ slot 1) count))))

(define (opt-callgraph-build [index : OptFunctionIndex]) : OptCallGraph
  (let
    [count : i64 (opt-function-index-count index)]
    [edges : (Array OptSlotList) (array.make-array OptSlotList count)]
    [values : (Array CompilerIrFunction) (struct-get index values)]
    (begin
      (opt-callgraph-init-edges edges 0 count)
      (opt-callgraph-build-slots index edges values 0 count)
      (OptCallGraph count edges))))

(define (opt-inline-census-capacity [index : OptFunctionIndex]) : i64
  (opt-function-index-capacity (opt-function-index-count index)))

(define (opt-inline-census-bump-map [map : opt_i64_i64_map.Map] [slot : i64]) : opt_i64_i64_map.Map
  (begin
    (match (opt_i64_i64_map.get (& map) slot)
      [(opt_i64_i64_map.LookupFound count)
        (opt_i64_i64_map.insert-ref! (&mut map) slot (+ count 1))]
      [(opt_i64_i64_map.LookupMissing)
        (opt_i64_i64_map.insert-ref! (&mut map) slot 1)])
    map))

(define (opt-inline-census-add-ref
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : i64]) : OptInlineCensus
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot)
      (OptInlineCensus
        (opt-inline-census-bump-map (struct-get census refcount) slot)
        (struct-get census addrtaken))]
    [(option_i64.None) census]))

(define (opt-inline-census-add-address
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : i64]) : OptInlineCensus
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot)
      (let
        [addrtaken : opt_i64_i64_map.Map (struct-get census addrtaken)]
        (begin
          (opt_i64_i64_map.insert-ref! (&mut addrtaken) slot 1)
          (OptInlineCensus (struct-get census refcount) addrtaken)))]
    [(option_i64.None) census]))

(define (opt-inline-census-value
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [value : CompilerIrValue]) : OptInlineCensus
  (match value
    [(CompilerIrValue.Function name)
      (opt-inline-census-add-address index census name)]
    [_ census]))

(define (opt-inline-census-args-array
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [values : (Array CompilerIrValue)]
  [arg-index : i64]) : OptInlineCensus
  (if (>= arg-index (array-length values))
    census
    (opt-inline-census-args-array
      index
      (opt-inline-census-value index census (array-ref values arg-index))
      values
      (+ arg-index 1))))

(define (opt-inline-census-args
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [args : CompilerIrCallArgs]) : OptInlineCensus
  (match args
    [(CompilerIrCallArgs.Nil) census]
    [(CompilerIrCallArgs.One value)
      (opt-inline-census-value index census value)]
    [(CompilerIrCallArgs.Two a b)
      (opt-inline-census-value index (opt-inline-census-value index census a) b)]
    [(CompilerIrCallArgs.Array values)
      (opt-inline-census-args-array index census values 0)]))

(define (opt-inline-census-spmd-args
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [args : CompilerIrSpmdCallArgList]) : OptInlineCensus
  (match args
    [(CompilerIrSpmdCallArgList.Nil) census]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (opt-inline-census-spmd-args
            index
            (opt-inline-census-value index census value)
            (box-get rest))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : OptInlineCensus census]
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (opt-inline-census-value index out value))])
              (set! i (+ i 1))))
          out))]))

(define (opt-inline-census-maybe-value
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [maybe : CompilerIrMaybeValue]) : OptInlineCensus
  (match maybe
    [(CompilerIrMaybeValue.No) census]
    [(CompilerIrMaybeValue.Some value)
      (opt-inline-census-value index census value)]))

(define (opt-inline-census-phi-inputs
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [inputs : CompilerIrPhiInputList]) : OptInlineCensus
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) census]
    [(CompilerIrPhiInputList.Array seq)
      (opt-inline-census-phi-inputs
        index
        census
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (opt-inline-census-phi-inputs
        index
        (opt-inline-census-value index census value)
        (box-get rest))]))

(define (opt-inline-census-value-list
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [values : CompilerIrValueList]) : OptInlineCensus
  (match values
    [(CompilerIrValueList.Nil) census]
    [(CompilerIrValueList.Array seq)
      (opt-inline-census-value-list
        index
        census
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (opt-inline-census-value-list
        index
        (opt-inline-census-value index census value)
        (box-get rest))]))

(define (opt-inline-census-instr
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [instr : CompilerIrInstr]) : OptInlineCensus
  (match instr
    [(CompilerIrInstr.Mov _ src _) (opt-inline-census-value index census src)]
    [(CompilerIrInstr.Alloc _ _) census]
    [(CompilerIrInstr.AddrOf _ _) census]
    [(CompilerIrInstr.Gep _ base offset _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census base)
        offset)]
    [(CompilerIrInstr.Load _ src _) (opt-inline-census-value index census src)]
    [(CompilerIrInstr.StorePtr dst src _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census dst)
        src)]
    [(CompilerIrInstr.CopyBytes dst src _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census dst)
        src)]
    [(CompilerIrInstr.BoundsCheck idx length _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census idx)
        length)]
    [(CompilerIrInstr.Cast _ src _ _)
      (opt-inline-census-value index census src)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (opt-inline-census-value index census src)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census lhs)
        rhs)]
    [(CompilerIrInstr.UnOp _ _ src _)
      (opt-inline-census-value index census src)]
    [(CompilerIrInstr.LaneId _ _ _) census]
    [(CompilerIrInstr.Splat _ value _ _)
      (opt-inline-census-value index census value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value index census lhs)
            rhs)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value index census src)
            carry)])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-inline-census-value index census src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value index census lhs)
            rhs)])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census lhs)
        rhs)]
    [(CompilerIrInstr.MaskNot _ src _)
      (opt-inline-census-value index census src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (opt-inline-census-value index census src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census mask)
              on-true)
            on-false)])]
    [(CompilerIrInstr.VectorLoad _ base idx _ _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census base)
        idx)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base idx value _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census base)
              idx)
            value)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload base idx value mask _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value
                index
                (opt-inline-census-value index census base)
                idx)
              value)
            mask)])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base idx mask _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census base)
              idx)
            mask)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload _ base index-base idx _ _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census base)
              index-base)
            idx)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (opt-inline-census-value
            index
            (opt-inline-census-maybe-value
              index
              (opt-inline-census-value
                index
                (opt-inline-census-value index census source)
                selector-low)
              selector-high)
            active-lanes)])]
    [(CompilerIrInstr.TailMask _ idx length _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census idx)
        length)]
    [(CompilerIrInstr.EntryArgc _) census]
    [(CompilerIrInstr.EntryArgv _) census]
    [(CompilerIrInstr.EntryEnvp _) census]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census leaf)
        subleaf)]
    [(CompilerIrInstr.Xgetbv _ idx) (opt-inline-census-value index census idx)]
    [(CompilerIrInstr.Syscall _ args)
      (opt-inline-census-args index census args)]
    [(CompilerIrInstr.Call _ name args _)
      (opt-inline-census-add-ref
        index
        (opt-inline-census-args index census args)
        name)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base name args _)
          (opt-inline-census-add-ref
            index
            (opt-inline-census-args
              index
              (opt-inline-census-value index census base)
              args)
            name)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload name _ _ active-mask args _)
          (opt-inline-census-add-ref
            index
            (opt-inline-census-spmd-args
              index
              (opt-inline-census-value index census active-mask)
              args)
            name)])]
    [(CompilerIrInstr.CallIndirect _ func args _)
      (opt-inline-census-args
        index
        (opt-inline-census-value index census func)
        args)]
    [(CompilerIrInstr.CallIndirectC _ func args _)
      (opt-inline-census-args
        index
        (opt-inline-census-value index census func)
        args)]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            _)
          (opt-inline-census-args
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census base)
              func)
            args)])]
    [(CompilerIrInstr.TailCall name args _)
      (opt-inline-census-add-ref
        index
        (opt-inline-census-args index census args)
        name)]
    [(CompilerIrInstr.Store _ value _)
      (opt-inline-census-value index census value)]
    [(CompilerIrInstr.Jump _) census]
    [(CompilerIrInstr.Branch cond _ _)
      (opt-inline-census-value index census cond)]
    [(CompilerIrInstr.Return maybe)
      (opt-inline-census-maybe-value index census maybe)]
    [(CompilerIrInstr.Phi _ inputs _)
      (opt-inline-census-phi-inputs index census inputs)]
    ;; Register-group ops use their operands (Pack: each word; Word: src).
    [(CompilerIrInstr.Pack _ words _)
      (opt-inline-census-value-list index census words)]
    [(CompilerIrInstr.Word _ src _ _)
      (opt-inline-census-value index census src)]
    [(CompilerIrInstr.TailCallIndirect func args _)
      (opt-inline-census-args
        index
        (opt-inline-census-value index census func)
        args)]
    [(CompilerIrInstr.Switch idx _ _ _)
      (opt-inline-census-value index census idx)]))

(define (opt-inline-census-instr-seq-from
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [instrs : CompilerIrInstrSeq]
  [instr-index : i64]) : OptInlineCensus
  (if (>= instr-index (compiler-ir-instr-seq-count instrs))
    census
    (opt-inline-census-instr-seq-from
      index
      (opt-inline-census-instr
        index
        census
        (compiler-ir-instr-seq-ref instrs instr-index))
      instrs
      (+ instr-index 1))))

(define (opt-inline-census-instr-seq
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [instrs : CompilerIrInstrSeq]) : OptInlineCensus
  (opt-inline-census-instr-seq-from index census instrs 0))

(define (opt-inline-census-blocks
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [blocks : CompilerIrBlockList]) : OptInlineCensus
  (match blocks
    [(CompilerIrBlockList.Nil) census]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-inline-census-blocks
            index
            (opt-inline-census-instr-seq index census instrs)
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-census-blocks
        index
        census
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-census-function
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func : CompilerIrFunction]) : OptInlineCensus
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-inline-census-blocks index census blocks)]))

(define (opt-inline-census-functions
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [functions : CompilerIrFunctionList]) : OptInlineCensus
  (match functions
    [(CompilerIrFunctionList.Nil) census]
    [(CompilerIrFunctionList.Cons func rest)
      (opt-inline-census-functions
        index
        (opt-inline-census-function index census func)
        (box-get rest))]
    [(CompilerIrFunctionList.Array seq)
      (opt-inline-census-functions
        index
        census
        (compiler-ir-function-seq-to-list seq))]))

(define (opt-inline-census-build
  [index : OptFunctionIndex]
  [functions : CompilerIrFunctionList]) : OptInlineCensus
  (let
    [capacity : i64 (opt-inline-census-capacity index)]
    (opt-inline-census-functions
      index
      (OptInlineCensus
        (opt_i64_i64_map.with-capacity capacity)
        (opt_i64_i64_map.with-capacity capacity))
      functions)))

(define (opt-inline-census-refcount
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : i64]) : i64
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot)
      (match (opt_i64_i64_map.get (& (struct-get census refcount)) slot)
        [(opt_i64_i64_map.LookupFound count) count]
        [(opt_i64_i64_map.LookupMissing) 0])]
    [(option_i64.None) 0]))

(define (opt-inline-census-address-taken?
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : i64]) : bool
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot)
      (opt_i64_i64_map.contains? (& (struct-get census addrtaken)) slot)]
    [(option_i64.None) false]))

(define (opt-inline-census-absorbable?
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [caller-name : i64]
  [callee-name : i64]) : bool
  (and
    (= (opt-inline-census-refcount index census callee-name) 1)
    (not (opt-inline-census-address-taken? index census callee-name))
    (not (string.eq (compiler-ir-symbol-text callee-name) "main"))
    (not (compiler-ir-symbol-eq? caller-name callee-name))))

(define (opt-callgraph-callee-count [graph : OptCallGraph] [from-slot : i64]) : i64
  (if (or (< from-slot 0) (>= from-slot (struct-get graph count)))
    -1
    (opt-slot-list-count (array-ref (struct-get graph edges) from-slot))))

(define (opt-callgraph-has-edge?
  [graph : OptCallGraph]
  [from-slot : i64]
  [to-slot : i64]) : bool
  (if (or
    (< from-slot 0)
    (< to-slot 0)
    (>= from-slot (struct-get graph count))
    (>= to-slot (struct-get graph count)))
    false
    (opt-slot-list-contains?
      (array-ref (struct-get graph edges) from-slot)
      to-slot)))

(define (opt-scc-set-low-min!
  [lowlink : (Array i64)]
  [slot : i64]
  [candidate : i64]) : unit
  (let
    [old : i64 (array-ref lowlink slot)]
    (if (< candidate old)
      (array-set! lowlink slot candidate)
      unit)))

(define (opt-scc-next-child-from
  [slots : OptSlotList]
  [after : i64]
  [best : i64]) : i64
  (match slots
    [(OptSlotList.Nil) best]
    [(OptSlotList.Cons slot rest)
      (opt-scc-next-child-from
        (box-get rest)
        after
        (if (and (> slot after) (or (< best 0) (< slot best)))
          slot
          best))]))

(define (opt-scc-next-child [graph : OptCallGraph] [slot : i64] [after : i64]) : i64
  (if (or (< slot 0) (>= slot (struct-get graph count)))
    (- 0 1)
    (opt-scc-next-child-from
      (array-ref (struct-get graph edges) slot)
      after
      (- 0 1))))

(define (opt-scc-discover!
  [slot : i64]
  [indices : (Array i64)]
  [lowlink : (Array i64)]
  [on-stack : (Array bool)]
  [node-stack : (Array i64)]
  [node-stack-len : i64]
  [next-index : i64]) : OptSccDiscoverState
  (begin
    (array-set! indices slot next-index)
    (array-set! lowlink slot next-index)
    (array-set! on-stack slot true)
    (array-set! node-stack node-stack-len slot)
    (OptSccDiscoverState.State (+ next-index 1) (+ node-stack-len 1))))

(define (opt-scc-frame-push!
  [frame-slots : (Array i64)]
  [frame-nexts : (Array i64)]
  [frame-len : i64]
  [slot : i64]) : i64
  (begin
    (array-set! frame-slots frame-len slot)
    (array-set! frame-nexts frame-len (- 0 1))
    (+ frame-len 1)))

(define (opt-scc-pop-component!
  [node-stack : (Array i64)]
  [node-stack-len : i64]
  [on-stack : (Array bool)]
  [scc-of : (Array i64)]
  [root : i64]
  [scc-id : i64]) : OptSccPopState
  (let
    [len : i64 node-stack-len]
    [done : bool false]
    [members : i64 0]
    (begin
      (while (not done)
        (let
          [next-len : i64 (- len 1)]
          [slot : i64 (array-ref node-stack next-len)]
          (begin
            (set! len next-len)
            (array-set! on-stack slot false)
            (array-set! scc-of slot scc-id)
            (set! members (+ members 1))
            (if (= slot root)
              (set! done true)
              unit))))
      (OptSccPopState.State len members))))

(define (opt-scc-copy-order [source : (Array i64)] [count : i64]) : (Array i64)
  (let
    [out : (Array i64) (array.make-array i64 count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set! out index (array-ref source index))
          (set! index (+ index 1))))
      out)))

(define (opt-scc-compute [graph : OptCallGraph]) : OptSccResult
  (let
    [count : i64 (struct-get graph count)]
    [indices : (Array i64) (array.make-array i64 count)]
    [lowlink : (Array i64) (array.make-array i64 count)]
    [on-stack : (Array bool) (array.make-array bool count)]
    [scc-of : (Array i64) (array.make-array i64 count)]
    [node-stack : (Array i64) (array.make-array i64 count)]
    [frame-slots : (Array i64) (array.make-array i64 count)]
    [frame-nexts : (Array i64) (array.make-array i64 count)]
    [order-scratch : (Array i64) (array.make-array i64 count)]
    [root : i64 0]
    [next-index : i64 0]
    [node-stack-len : i64 0]
    [frame-len : i64 0]
    [scc-count : i64 0]
    (begin
      (opt-cfg-fill-i64! indices count (- 0 1))
      (opt-cfg-fill-i64! lowlink count (- 0 1))
      (opt-cfg-fill-i64! scc-of count (- 0 1))
      (opt-cfg-fill-i64! order-scratch count (- 0 1))
      (while (< root count)
        (begin
          (if (= (array-ref indices root) (- 0 1))
            (begin
              (match (opt-scc-discover!
                root
                indices
                lowlink
                on-stack
                node-stack
                node-stack-len
                next-index)
                [(OptSccDiscoverState.State next stack-len)
                  (begin
                    (set! next-index next)
                    (set! node-stack-len stack-len))])
              (set!
                frame-len
                (opt-scc-frame-push! frame-slots frame-nexts frame-len root))
              (while (> frame-len 0)
                (let
                  [frame-index : i64 (- frame-len 1)]
                  [slot : i64 (array-ref frame-slots frame-index)]
                  [child : i64
                    (opt-scc-next-child
                      graph
                      slot
                      (array-ref frame-nexts frame-index))]
                  (if (>= child 0)
                    (begin
                      (array-set! frame-nexts frame-index child)
                      (if (= (array-ref indices child) (- 0 1))
                        (begin
                          (match (opt-scc-discover!
                            child
                            indices
                            lowlink
                            on-stack
                            node-stack
                            node-stack-len
                            next-index)
                            [(OptSccDiscoverState.State next stack-len)
                              (begin
                                (set! next-index next)
                                (set! node-stack-len stack-len))])
                          (set!
                            frame-len
                            (opt-scc-frame-push!
                              frame-slots
                              frame-nexts
                              frame-len
                              child)))
                        (if (array-ref on-stack child)
                          (opt-scc-set-low-min!
                            lowlink
                            slot
                            (array-ref indices child))
                          unit)))
                    (begin
                      (if (= (array-ref lowlink slot) (array-ref indices slot))
                        (match (opt-scc-pop-component!
                          node-stack
                          node-stack-len
                          on-stack
                          scc-of
                          slot
                          scc-count)
                          [(OptSccPopState.State stack-len _)
                            (begin
                              (set! node-stack-len stack-len)
                              (array-set! order-scratch scc-count scc-count)
                              (set! scc-count (+ scc-count 1)))])
                        unit)
                      (set! frame-len (- frame-len 1))
                      (if (> frame-len 0)
                        (let
                          [parent : i64 (array-ref frame-slots (- frame-len 1))]
                          (opt-scc-set-low-min!
                            lowlink
                            parent
                            (array-ref lowlink slot)))
                        unit))))))
            unit)
          (set! root (+ root 1))))
      (OptSccResult scc-of (opt-scc-copy-order order-scratch scc-count)))))

;; Devirtualize syntactically known function values before program-level
;; inlining, so the existing direct-call inliner can see them.
(define (opt-devirt-known-function-instr [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.CallIndirect dst (CompilerIrValue.Function name) args ty)
      (CompilerIrInstr.Call dst name args ty)]
    [(CompilerIrInstr.TailCallIndirect (CompilerIrValue.Function name) args ty)
      (CompilerIrInstr.TailCall name args ty)]
    [_ instr]))

;; Optimization receives compact, exclusively owned IR sequences. Rewrite their
;; mutable instruction arrays directly instead of rebuilding the entire program
;; through temporary cons lists before the inliner.
(define (opt-devirt-known-function-block! [block : CompilerIrBlock]) : unit
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (compiler-ir-instr-seq-rewrite! instrs opt-devirt-known-function-instr)]))

(define (opt-devirt-known-function-blocks! [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (opt-devirt-known-function-block! block)
        (opt-devirt-known-function-blocks! (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (let
        [index : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< index count)
          (begin
            (opt-devirt-known-function-block!
              (compiler-ir-block-seq-ref seq index))
            (set! index (+ index 1)))))]))

(define (opt-devirt-known-function-function! [func : CompilerIrFunction]) : unit
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-devirt-known-function-blocks! blocks)]))

(define (opt-devirt-known-function-function [func : CompilerIrFunction]) : CompilerIrFunction
  (begin
    (opt-devirt-known-function-function! func)
    func))

(define (opt-devirt-known-function-list [functions : CompilerIrFunctionList]) : CompilerIrFunctionList
  (begin
    (match functions
      [(CompilerIrFunctionList.Nil) unit]
      [(CompilerIrFunctionList.Cons func rest)
        (begin
          (opt-devirt-known-function-function! func)
          (opt-devirt-known-function-list (box-get rest))
          unit)]
      [(CompilerIrFunctionList.Array seq)
        (let
          [index : i64 0]
          [count : i64 (compiler-ir-function-seq-count seq)]
          (while (< index count)
            (begin
              (opt-devirt-known-function-function!
                (compiler-ir-function-seq-ref seq index))
              (set! index (+ index 1)))))])
    functions))

;; ---------------------------------------------------------------------------
;; Function inlining (opt level 2 only). Splices the body of small single-block
;; leaf callees into their call sites, removing call/return overhead and exposing
;; the callee's instructions to the caller's folding/DCE/GVN and to register
;; allocation. Reserved for opt2 (the quality build) so the cheap opt1
;; self-compile path pays nothing for it.
;;
;; Determinism: fresh var ids are minted from the caller function's `vars`
;; counter (the same per-function sequential scheme lowering uses), callee bodies
;; are walked in list order, and callees are resolved through the deterministic
;; OptFunctionIndex. Param var ids (0..nparams-1) are substituted with the call's
;; argument values; other callee var ids are compacted by subtracting the dead
;; read-only param slots before shifting by the caller's var count.
;; ---------------------------------------------------------------------------
(defenum OptInlineState
  (State CompilerIrInstrList i64 i64))

(defenum OptInlinePredRename
  (Rename i64 i64))

(defenum OptInlinePredRenameList
  (Nil)
  (Dense (Array OptInlinePredRename) i64))

(define (opt-inline-pred-rename-ref
  [renames : OptInlinePredRenameList]
  [index : i64]) : OptInlinePredRename
  (match renames
    [(OptInlinePredRenameList.Nil) (OptInlinePredRename.Rename -1 -1)]
    [(OptInlinePredRenameList.Dense items len)
      (array-ref items (- (- len 1) index))]))

(define (opt-inline-pred-renames-tail [renames : OptInlinePredRenameList]) : OptInlinePredRenameList
  (match renames
    [(OptInlinePredRenameList.Nil) (OptInlinePredRenameList.Nil)]
    [(OptInlinePredRenameList.Dense items len)
      (if (<= len 1)
        (OptInlinePredRenameList.Nil)
        (OptInlinePredRenameList.Dense items (- len 1)))]))

(define (opt-inline-pred-renames-cons
  [old-label : i64]
  [new-label : i64]
  [renames : OptInlinePredRenameList]) : OptInlinePredRenameList
  (let
    [rename : OptInlinePredRename
      (OptInlinePredRename.Rename old-label new-label)]
    (match renames
      [(OptInlinePredRenameList.Nil)
        (let
          [items : (Array OptInlinePredRename)
            (array.make-array OptInlinePredRename 4)]
          (begin
            (array-set! items 0 rename)
            (OptInlinePredRenameList.Dense items 1)))]
      [(OptInlinePredRenameList.Dense items len)
        (if (< len (array-length items))
          (begin
            (array-set! items len rename)
            (OptInlinePredRenameList.Dense items (+ len 1)))
          (let
            [bigger : (Array OptInlinePredRename)
              (array.make-array
                OptInlinePredRename
                (opt-dense-next-capacity len))]
            [index : i64 0]
            (begin
              (while (< index len)
                (begin
                  (array-set! bigger index (array-ref items index))
                  (set! index (+ index 1))))
              (array-set! bigger len rename)
              (OptInlinePredRenameList.Dense bigger (+ len 1)))))])))

(defenum OptInlineBlocks
  (Blocks CompilerIrBlockList i64 i64))

(defenum OptInlineSpanState
  (State CompilerIrInstrList i64 i64 CompilerSourceSpans))

(defenum OptInlineSpanBlocks
  (Blocks CompilerIrBlockList i64 i64 CompilerSourceSpans))

(defenum OptInlineSpanProgram
  (Program CompilerIrFunctionList CompilerSourceSpans))

(defenum OptInlineMultiClone
  (Clone CompilerIrBlockList CompilerIrPhiInputList))

(defenum OptInlineMultiInstrClone
  (Clone CompilerIrInstrList CompilerIrPhiInputList))

(defenum OptInlineMultiSpanClone
  (Clone CompilerIrBlockList CompilerIrPhiInputList CompilerSourceSpans))

(defenum OptInlineMultiSpanInstrClone
  (Clone CompilerIrInstrList CompilerIrPhiInputList CompilerSourceSpans))

(defenum OptInlineMaybeBlockRewrite
  (NoBlockRewrite)
  (SomeBlockRewrite CompilerIrBlockList i64 i64))

(defenum OptInlineMaybeSpanBlockRewrite
  (NoSpanBlockRewrite)
  (SomeSpanBlockRewrite CompilerIrBlockList i64 i64 CompilerSourceSpans))

(defenum OptInlineBoundsLabelScan
  (Duplicate)
  (Ok opt_string_i64_map.Map))

(define (opt-inline-max-body) : i64
  8)

(define (opt-inline-bounds-leaf-max-body) : i64
  48)

(define (opt-inline-cost-block-weight) : i64
  6)

(define (opt-inline-cost-call-bonus) : i64
  6)

(define (opt-inline-cost-const-arg-bonus) : i64
  3)

(define (opt-inline-cost-threshold) : i64
  4)

(define (opt-inline-cost-absorb-bonus) : i64
  1000)

(define (opt-inline-cost-block-fuel) : i64
  32)

(define (opt-inline-tiny-predicate-max-blocks) : i64
  4)

(define (opt-inline-tiny-predicate-max-instrs) : i64
  6)

(define (opt-inline-param-count [params : CompilerIrParamList]) : i64
  (match params
    [(CompilerIrParamList.Nil) 0]
    [(CompilerIrParamList.Array seq) (compiler-ir-param-seq-count seq)]
    [(CompilerIrParamList.Cons _ rest)
      (+ 1 (opt-inline-param-count (box-get rest)))]))

(define (opt-inline-param-seq-sequential-from?
  [params : CompilerIrParamSeq]
  [index : i64]
  [expected : i64]) : bool
  (if (>= index (compiler-ir-param-seq-count params))
    true
    (match (compiler-ir-param-seq-ref params index)
      [(CompilerIrParam.Param _ _ vid)
        (and
          (= vid expected)
          (opt-inline-param-seq-sequential-from?
            params
            (+ index 1)
            (+ expected 1)))])))

(define (opt-inline-params-sequential? [params : CompilerIrParamList] [i : i64]) : bool
  (match params
    [(CompilerIrParamList.Nil) true]
    [(CompilerIrParamList.Array seq)
      (opt-inline-param-seq-sequential-from? seq 0 i)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ vid)
          (if (= vid i)
            (opt-inline-params-sequential? (box-get rest) (+ i 1))
            false)])]))

(define (opt-inline-body-instr-op-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ _ _) true]
    [(CompilerIrInstr.Gep _ _ _ _) true]
    [(CompilerIrInstr.Load _ _ _) true]
    [(CompilerIrInstr.Cast _ _ _ _) true]
    [(CompilerIrInstr.Bitcast _ _ _ _) true]
    [(CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(CompilerIrInstr.UnOp _ _ _ _) true]
    [(CompilerIrInstr.Pack _ _ _) true]
    [(CompilerIrInstr.Word _ _ _ _) true]
    [(CompilerIrInstr.Call _ _ _ _) true]
    [(CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(CompilerIrInstr.BoundsCheck _ _ _) true]
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [(CompilerIrInstr.CopyBytes _ _ _) true]
    [_ false]))

(define (opt-inline-body-instr-ok? [instr : CompilerIrInstr] [np : i64]) : bool
  (match instr
    [(CompilerIrInstr.Mov dst _ _) (>= dst np)]
    [(CompilerIrInstr.Gep dst _ _ _) (>= dst np)]
    [(CompilerIrInstr.Load dst _ _) (>= dst np)]
    [(CompilerIrInstr.Cast dst _ _ _) (>= dst np)]
    [(CompilerIrInstr.Bitcast dst _ _ _) (>= dst np)]
    [(CompilerIrInstr.BinOp dst _ _ _ _) (>= dst np)]
    [(CompilerIrInstr.UnOp dst _ _ _) (>= dst np)]
    [(CompilerIrInstr.Pack dst _ _) (>= dst np)]
    [(CompilerIrInstr.Word dst _ _ _) (>= dst np)]
    [(CompilerIrInstr.Call dst _ _ _) (>= dst np)]
    [(CompilerIrInstr.CallIndirect dst _ _ _) (>= dst np)]
    [(CompilerIrInstr.CallIndirectC dst _ _ _) (>= dst np)]
    [(CompilerIrInstr.BoundsCheck _ _ _) true]
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [(CompilerIrInstr.CopyBytes _ _ _) true]
    [_ false]))

(define (opt-inline-body-instr-seq-ok?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [np : i64]) : bool
  (opt-inline-body-instr-ok? (compiler-ir-instr-seq-ref instrs index) np))

(define (opt-inline-instr-seq-ok-from?
  [instrs : CompilerIrInstrSeq]
  [np : i64]
  [index : i64]
  [last : i64]) : bool
  (cond
    [(> index last) false]
    [(= index last) (compiler-ir-instr-seq-return? instrs index)]
    [(opt-inline-body-instr-seq-ok? instrs index np)
      (opt-inline-instr-seq-ok-from? instrs np (+ index 1) last)]
    [else false]))

(define (opt-inline-instr-seq-ok? [instrs : CompilerIrInstrSeq] [np : i64]) : bool
  (opt-inline-instr-seq-ok-from?
    instrs
    np
    0
    (- (compiler-ir-instr-seq-count instrs) 1)))

(define (opt-inline-single-block-seq-ok? [seq : CompilerIrInstrSeq] [np : i64]) : bool
  (let
    [n : i64 (compiler-ir-instr-seq-count seq)]
    (if (< n 1)
      false
      (if (> (- n 1) (opt-inline-max-body))
        false
        (opt-inline-instr-seq-ok? seq np)))))

(define (opt-inline-single-block-ok? [blocks : CompilerIrBlockList] [np : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Cons block rest)
      (match (box-get rest)
        [(CompilerIrBlockList.Nil)
          (match block
            [(CompilerIrBlock.Block _ seq)
              (opt-inline-single-block-seq-ok? seq np)])]
        [_ false])]
    [(CompilerIrBlockList.Array seq)
      (if (= (compiler-ir-block-seq-count seq) 1)
        (match (compiler-ir-block-seq-ref seq 0)
          [(CompilerIrBlock.Block _ instrs)
            (opt-inline-single-block-seq-ok? instrs np)])
        false)]
    [_ false]))

(define (opt-inline-single-block-cost-instrs [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(CompilerIrBlockList.Cons block _)
      (match block
        [(CompilerIrBlock.Block _ seq) (- (compiler-ir-instr-seq-count seq) 1)])]
    [(CompilerIrBlockList.Array seq)
      (if (= (compiler-ir-block-seq-count seq) 1)
        (match (compiler-ir-block-seq-ref seq 0)
          [(CompilerIrBlock.Block _ instrs)
            (- (compiler-ir-instr-seq-count instrs) 1)])
        0)]
    [_ 0]))

(define (opt-inline-bounds-leaf-instr-ok? [instr : CompilerIrInstr] [np : i64]) : bool
  (match instr
    [(CompilerIrInstr.Call _ _ _ _) false]
    [(CompilerIrInstr.CallIndirect _ _ _ _) false]
    [(CompilerIrInstr.CallIndirectC _ _ _ _) false]
    [_ (opt-inline-body-instr-ok? instr np)]))

(define (opt-inline-bounds-leaf-instr-seq-ok-from?
  [instrs : CompilerIrInstrSeq]
  [np : i64]
  [index : i64]
  [last : i64]
  [has-bounds : bool]) : bool
  (if (> index last)
    false
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (if (= index last)
        (and has-bounds (compiler-ir-instr-return? instr))
        (if (opt-inline-bounds-leaf-instr-ok? instr np)
          (opt-inline-bounds-leaf-instr-seq-ok-from?
            instrs
            np
            (+ index 1)
            last
            (or has-bounds (compiler-ir-instr-bounds-check? instr)))
          false)))))

(define (opt-inline-bounds-leaf-seq-ok? [seq : CompilerIrInstrSeq] [np : i64]) : bool
  (let
    [n : i64 (compiler-ir-instr-seq-count seq)]
    [body : i64 (- n 1)]
    (and
      (>= n 1)
      (> body (opt-inline-max-body))
      (<= body (opt-inline-bounds-leaf-max-body))
      (opt-inline-bounds-leaf-instr-seq-ok-from? seq np 0 (- n 1) false))))

;; Return-to-mov cloning preserves non-owning scalar values. Keep owned String
;; and aggregate results out of this path; their call boundary carries cleanup
;; semantics that the bounds-leaf expansion does not reproduce.
(define (opt-inline-bounds-leaf-return-type? [ty : AstType]) : bool
  (if (opt-integer-type? ty)
    true
    (match ty
      [(AstType.Unit) true]
      [(AstType.Bool) true]
      [_ false])))

(define (opt-inline-bounds-leaf-ok?
  [blocks : CompilerIrBlockList]
  [np : i64]
  [ret : AstType]) : bool
  (and
    (opt-inline-bounds-leaf-return-type? ret)
    (match blocks
      [(CompilerIrBlockList.Cons block rest)
        (match (box-get rest)
          [(CompilerIrBlockList.Nil)
            (match block
              [(CompilerIrBlock.Block _ seq)
                (opt-inline-bounds-leaf-seq-ok? seq np)])]
          [_ false])]
      [(CompilerIrBlockList.Array seq)
        (if (= (compiler-ir-block-seq-count seq) 1)
          (match (compiler-ir-block-seq-ref seq 0)
            [(CompilerIrBlock.Block _ instrs)
              (opt-inline-bounds-leaf-seq-ok? instrs np)])
          false)]
      [_ false])))

(define (opt-inline-phi-input-label?
  [inputs : CompilerIrPhiInputList]
  [label : i64]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) false]
    [(CompilerIrPhiInputList.Array seq)
      (opt-inline-phi-input-label?
        (compiler-ir-phi-input-seq-to-list seq)
        label)]
    [(CompilerIrPhiInputList.Cons _ input-label rest)
      (if (= input-label label)
        true
        (opt-inline-phi-input-label? (box-get rest) label))]))

(define (opt-inline-instr-seq-phi-label-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [label : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ inputs _)
        (if (opt-inline-phi-input-label? inputs label)
          true
          (opt-inline-instr-seq-phi-label-from? instrs (+ index 1) label))]
      ;; Inliner input is SSA, where phis form the instruction prefix.
      [_ false])))

(define (opt-inline-phi-input-labels-add
  [inputs : CompilerIrPhiInputList]
  [labels : OptLabelSet]) : OptLabelSet
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) labels]
    [(CompilerIrPhiInputList.Array seq)
      (opt-inline-phi-input-labels-add
        (compiler-ir-phi-input-seq-to-list seq)
        labels)]
    [(CompilerIrPhiInputList.Cons _ label rest)
      (opt-inline-phi-input-labels-add
        (box-get rest)
        (opt-label-add labels label))]))

(define (opt-inline-instr-seq-phi-labels-add-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [labels : OptLabelSet]) : OptLabelSet
  (if (>= index (compiler-ir-instr-seq-count instrs))
    labels
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ inputs _)
        (opt-inline-instr-seq-phi-labels-add-from
          instrs
          (+ index 1)
          (opt-inline-phi-input-labels-add inputs labels))]
      ;; Inliner input is SSA, where phis form the instruction prefix.
      [_ labels])))

(define (opt-inline-blocks-phi-predecessors-add
  [blocks : CompilerIrBlockList]
  [labels : OptLabelSet]) : OptLabelSet
  (match blocks
    [(CompilerIrBlockList.Nil) labels]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-inline-blocks-phi-predecessors-add
            (box-get rest)
            (opt-inline-instr-seq-phi-labels-add-from instrs 0 labels))])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-blocks-phi-predecessors-add
        (compiler-ir-block-seq-to-list seq)
        labels)]))

;; A successful multiblock inline moves the original block's tail to the
;; generated continuation. A matching phi input is itself the old predecessor
;; edge, so rewrite only blocks that carry one and leave every other block and
;; every non-matching phi input byte-for-byte equivalent.
(define (opt-inline-repair-successor-phis
  [blocks : CompilerIrBlockList]
  [old-label : i64]
  [new-label : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (if (opt-inline-instr-seq-phi-label-from? instrs 0 old-label)
              (compiler-ir-block
                label
                (opt-relabel-phi-instrs instrs 0 old-label new-label))
              block)
            (opt-inline-repair-successor-phis
              (box-get rest)
              old-label
              new-label))])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-repair-successor-phis
        (compiler-ir-block-seq-to-list seq)
        old-label
        new-label)]))

(define (opt-inline-repair-phi-predecessors
  [blocks : CompilerIrBlockList]
  [renames : OptInlinePredRenameList]) : CompilerIrBlockList
  (match renames
    [(OptInlinePredRenameList.Nil) blocks]
    [(OptInlinePredRenameList.Dense _ _)
      (match (opt-inline-pred-rename-ref renames 0)
        [(OptInlinePredRename.Rename old-label new-label)
          (opt-inline-repair-phi-predecessors
            (opt-inline-repair-successor-phis blocks old-label new-label)
            (opt-inline-pred-renames-tail renames))])]))

(define (opt-inline-multiblock-instr-ok? [instr : CompilerIrInstr] [_np : i64]) : bool
  (match instr
    [(CompilerIrInstr.Jump _) true]
    [(CompilerIrInstr.Branch _ _ _) true]
    [(CompilerIrInstr.Switch _ _ _ _) true]
    [(CompilerIrInstr.Return _) true]
    [(CompilerIrInstr.Phi dst _ _) (>= dst 0)]
    ;; Bounds checks are inlinable: the instruction remapper freshens the
    ;; ok-label with the site prefix (the same machinery the single-block
    ;; bounds path uses), and the multiblock rewrite gates bounds-carrying
    ;; callees behind opt-inline-bounds-inline-ok? exactly like the
    ;; single-block path. This is what lets small loop-bearing helpers such
    ;; as a string-scan or hashmap probe inline into their hot single call
    ;; site instead of paying a call per iteration.
    [(CompilerIrInstr.BoundsCheck _ _ _) true]
    [_ (opt-inline-body-instr-op-ok? instr)]))

(define (opt-inline-instr-seq-has-bounds-check?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (compiler-ir-instr-seq-bounds-check? instrs index)
      true
      (opt-inline-instr-seq-has-bounds-check? instrs (+ index 1)))))

(define (opt-inline-blocks-have-bounds-check? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-inline-instr-seq-has-bounds-check? instrs 0)
            true
            (opt-inline-blocks-have-bounds-check? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-blocks-have-bounds-check? (compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-multiblock-instrs-ok-from?
  [instrs : CompilerIrInstrSeq]
  [np : i64]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (if (opt-inline-multiblock-instr-ok?
      (compiler-ir-instr-seq-ref instrs index)
      np)
      (opt-inline-multiblock-instrs-ok-from? instrs np (+ index 1))
      false)))

(define (opt-inline-multiblock-instrs-ok?
  [instrs : CompilerIrInstrSeq]
  [np : i64]) : bool
  (opt-inline-multiblock-instrs-ok-from? instrs np 0))

(define (opt-inline-multiblock-blocks-ok?
  [blocks : CompilerIrBlockList]
  [np : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (and
            (opt-inline-multiblock-instrs-ok? instrs np)
            (opt-inline-multiblock-blocks-ok? (box-get rest) np))])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-multiblock-blocks-ok? (compiler-ir-block-seq-to-list seq) np)]))

(define (opt-inline-param-mutating-instr? [instr : CompilerIrInstr] [np : i64]) : bool
  (match (opt-instr-def-var instr)
    [(option_i64.Some var) (< var np)]
    [(option_i64.None) false]))

(define (opt-inline-param-mutating-instrs-from?
  [instrs : CompilerIrInstrSeq]
  [np : i64]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-inline-param-mutating-instr?
      (compiler-ir-instr-seq-ref instrs index)
      np)
      true
      (opt-inline-param-mutating-instrs-from? instrs np (+ index 1)))))

(define (opt-inline-param-mutating-instrs?
  [instrs : CompilerIrInstrSeq]
  [np : i64]) : bool
  (opt-inline-param-mutating-instrs-from? instrs np 0))

(define (opt-inline-param-mutating-blocks?
  [blocks : CompilerIrBlockList]
  [np : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-inline-param-mutating-instrs? instrs np)
            true
            (opt-inline-param-mutating-blocks? (box-get rest) np))])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-param-mutating-blocks? (compiler-ir-block-seq-to-list seq) np)]))

(define (opt-inline-return-count-instrs-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    count
    (opt-inline-return-count-instrs-from
      instrs
      (+ index 1)
      (if (compiler-ir-instr-seq-return? instrs index)
        (+ count 1)
        count))))

(define (opt-inline-return-count-instrs [instrs : CompilerIrInstrSeq]) : i64
  (opt-inline-return-count-instrs-from instrs 0 0))

(define (opt-inline-return-count-blocks [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) 0]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (+
            (opt-inline-return-count-instrs instrs)
            (opt-inline-return-count-blocks (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-return-count-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-cost-instrs-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    count
    (opt-inline-cost-instrs-from
      instrs
      (+ index 1)
      (if (compiler-ir-instr-seq-return? instrs index)
        count
        (+ count 1)))))

(define (opt-inline-cost-instrs [instrs : CompilerIrInstrSeq]) : i64
  (opt-inline-cost-instrs-from instrs 0 0))

(define (opt-inline-multiblock-cost-instrs [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) 0]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (+
            (opt-inline-cost-instrs instrs)
            (opt-inline-multiblock-cost-instrs (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-multiblock-cost-instrs (compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-params-have-sret? [params : CompilerIrParamList]) : bool
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) false]
    [(CompilerIrParamList.Array seq)
      (opt-inline-params-have-sret? (compiler-ir-param-seq-to-list seq))]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param name _ _)
          (or
            (string.eq name "__sret")
            (opt-inline-params-have-sret? (box-get rest)))])]))

(define (opt-inline-multiblock-return-type-ok?
  [params : CompilerIrParamList]
  [ret : AstType]) : bool
  (or
    (opt-inline-params-have-sret? params)
    (opt-ssa-scalar-type? ret)
    (match ret
      [(AstType.Unit) true]
      [_ false])))

(define (opt-inline-multiblock-callee-body-ok?
  [cparams : CompilerIrParamList]
  [ret : AstType]
  [cvars : i64]
  [cblocks : CompilerIrBlockList]) : bool
  (let
    [np : i64 (opt-inline-param-count cparams)]
    (and
      (opt-inline-multiblock-return-type-ok? cparams ret)
      (opt-inline-params-sequential? cparams 0)
      (>= cvars np)
      (> (compiler-ir-block-list-count cblocks) 1)
      (> (opt-inline-return-count-blocks cblocks) 0)
      (opt-inline-structure-ok-reclaiming? cblocks)
      (opt-inline-multiblock-blocks-ok? cblocks np))))

;; Per-callee memo for the multiblock admission verdict, keyed by dense index
;; slot. SCC processing is bottom-up (Tarjan pops a callee's component before
;; any caller's), and same-SCC calls are rejected before this lookup runs, so
;; whenever a caller examines a callee here the callee's body is final for the
;; rest of the pass and the cached verdict cannot go stale. A -1 slot means
;; "not yet computed". The verdict cached here is caller-independent; the
;; self-call check stays outside in opt-inline-multiblock-callee-ok-cached?.
(define opt-inline-multiblock-ok-memo : (Array i64)
  (array.make-array i64 0))

(define (opt-inline-multiblock-ok-memo-install! [index : OptFunctionIndex]) : unit
  (let
    [count : i64 (opt-function-index-count index)]
    [memo : (Array i64) (array.make-array i64 count)]
    (begin
      (opt-cfg-fill-i64! memo count (- 0 1))
      (set! opt-inline-multiblock-ok-memo memo))))

(define (opt-inline-multiblock-ok-memo-reset!) : unit
  (set! opt-inline-multiblock-ok-memo (array.make-array i64 0)))

(define (opt-inline-multiblock-callee-ok-cached?
  [callee-slot : i64]
  [callee : CompilerIrFunction]
  [caller-name : i64]) : bool
  (match callee
    [(CompilerIrFunction.Function cname cparams ret cvars cblocks)
      (if (compiler-ir-symbol-eq? cname caller-name)
        false
        (if (or
          (< callee-slot 0)
          (>= callee-slot (array-length opt-inline-multiblock-ok-memo)))
          (opt-inline-multiblock-callee-body-ok? cparams ret cvars cblocks)
          (let
            [cached : i64 (array-ref opt-inline-multiblock-ok-memo callee-slot)]
            (if (>= cached 0)
              (= cached 1)
              (let
                [ok : bool
                  (opt-inline-multiblock-callee-body-ok?
                    cparams
                    ret
                    cvars
                    cblocks)]
                (begin
                  (array-set!
                    opt-inline-multiblock-ok-memo
                    callee-slot
                    (if ok
                      1
                      0))
                  ok))))))]))

;; Admitted inline sites in the caller currently being rewritten, bumped once
;; per single-block expansion and per multiblock rewrite. When it is still zero
;; after the walk, the caller's IR and spans are exactly the input ones, so the
;; structural re-verify and SSA reconstruction have nothing new to check.
(define opt-inline-caller-site-count : i64
  0)
(define opt-inline-pred-renames : OptInlinePredRenameList
  (OptInlinePredRenameList.Nil))
(define opt-inline-current-phi-predecessor? : bool
  false)

(define (opt-inline-callee-ok?
  [callee : CompilerIrFunction]
  [caller-name : i64]) : bool
  (match callee
    [(CompilerIrFunction.Function cname cparams cret cvars cblocks)
      (if (compiler-ir-symbol-eq? cname caller-name)
        false
        (let
          [np : i64 (opt-inline-param-count cparams)]
          (if (opt-inline-params-sequential? cparams 0)
            (if (>= cvars np)
              (or
                (opt-inline-single-block-ok? cblocks np)
                (opt-inline-bounds-leaf-ok? cblocks np cret))
              false)
            false)))]))

(define (opt-inline-arity-ok? [args : CompilerIrCallArgs] [np : i64]) : bool
  (match args
    [(CompilerIrCallArgs.Nil) (= np 0)]
    [(CompilerIrCallArgs.One _) (= np 1)]
    [(CompilerIrCallArgs.Two _ _) (= np 2)]
    [(CompilerIrCallArgs.Array arr) (= np (array-length arr))]))

(define (opt-inline-value-constant? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var _) false]
    [_ true]))

(define (opt-inline-args-array-const-count
  [values : (Array CompilerIrValue)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (array-length values))
    count
    (opt-inline-args-array-const-count
      values
      (+ index 1)
      (if (opt-inline-value-constant? (array-ref values index))
        (+ count 1)
        count))))

(define (opt-inline-args-const-count [args : CompilerIrCallArgs]) : i64
  (match args
    [(CompilerIrCallArgs.Nil) 0]
    [(CompilerIrCallArgs.One value)
      (if (opt-inline-value-constant? value)
        1
        0)]
    [(CompilerIrCallArgs.Two a b)
      (+
        (if (opt-inline-value-constant? a)
          1
          0)
        (if (opt-inline-value-constant? b)
          1
          0))]
    [(CompilerIrCallArgs.Array values)
      (opt-inline-args-array-const-count values 0 0)]))

(define (opt-inline-cost-min [a : i64] [b : i64]) : i64
  (if (< a b)
    a
    b))

(define (opt-inline-cost-crosses-heavy-gate?
  [caller-blocks : i64]
  [added-so-far : i64]
  [added-blocks : i64]) : bool
  (and
    (<= caller-blocks (opt-inline-heavy-gate-block-limit))
    (>
      (+ caller-blocks (+ added-so-far added-blocks))
      (opt-inline-heavy-gate-block-limit))))

(define (opt-inline-cost-inline?
  [callee-instrs : i64]
  [added-blocks : i64]
  [const-args : i64]
  [absorbable : bool]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (opt-inline-cost-inline-with-block-weight?
    callee-instrs
    added-blocks
    const-args
    absorbable
    caller-blocks
    added-so-far
    (opt-inline-cost-block-weight)))

(define (opt-inline-cost-inline-with-block-weight?
  [callee-instrs : i64]
  [added-blocks : i64]
  [const-args : i64]
  [absorbable : bool]
  [caller-blocks : i64]
  [added-so-far : i64]
  [block-weight : i64]) : bool
  (if (opt-inline-cost-crosses-heavy-gate?
    caller-blocks
    added-so-far
    added-blocks)
    false
    (if (> (+ added-so-far added-blocks) (opt-inline-cost-block-fuel))
      false
      (let
        [raw : i64 (+ callee-instrs (* block-weight added-blocks))]
        [const-savings : i64
          (opt-inline-cost-min
            raw
            (* (opt-inline-cost-const-arg-bonus) const-args))]
        [net : i64
          (-
            (- (- raw const-savings) (opt-inline-cost-call-bonus))
            (if absorbable
              (opt-inline-cost-absorb-bonus)
              0))]
        (<= net (opt-inline-cost-threshold))))))

(define (opt-inline-bool-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Bool) true]
    [_ false]))

(define (opt-inline-tiny-predicate-instr-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ _ _) true]
    [(CompilerIrInstr.Gep _ _ _ _) true]
    [(CompilerIrInstr.Load _ _ _) true]
    [(CompilerIrInstr.Cast _ _ _ _) true]
    [(CompilerIrInstr.Bitcast _ _ _ _) true]
    [(CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(CompilerIrInstr.UnOp _ _ _ _) true]
    [(CompilerIrInstr.Word _ _ _ _) true]
    [(CompilerIrInstr.Branch _ _ _) true]
    [(CompilerIrInstr.Return _) true]
    [(CompilerIrInstr.Phi dst _ _) (>= dst 0)]
    [(CompilerIrInstr.Jump _) true]
    [_ false]))

(define (opt-inline-tiny-predicate-instr-seq-ok?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (opt-inline-tiny-predicate-instr-ok? (compiler-ir-instr-seq-ref instrs index)))

(define (opt-inline-tiny-predicate-instrs-ok-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (if (opt-inline-tiny-predicate-instr-seq-ok? instrs index)
      (opt-inline-tiny-predicate-instrs-ok-from? instrs (+ index 1))
      false)))

(define (opt-inline-tiny-predicate-instrs-ok? [instrs : CompilerIrInstrSeq]) : bool
  (opt-inline-tiny-predicate-instrs-ok-from? instrs 0))

(define (opt-inline-tiny-predicate-blocks-ok? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (and
            (opt-inline-tiny-predicate-instrs-ok? instrs)
            (opt-inline-tiny-predicate-blocks-ok? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-tiny-predicate-blocks-ok? (compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-tiny-predicate-forward-successors?
  [index : OptCfgIndex]
  [source-id : i64]
  [succs : OptLabelSet]) : bool
  (match succs
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (match (opt-cfg-index-id index (opt-label-ref succs 0))
        [(option_i64.Some target-id)
          (and
            (> target-id source-id)
            (opt-inline-tiny-predicate-forward-successors?
              index
              source-id
              (opt-label-tail succs)))]
        [(option_i64.None) false])]))

(define (opt-inline-tiny-predicate-forward-edges-from?
  [index : OptCfgIndex]
  [id : i64]
  [count : i64]) : bool
  (if (>= id count)
    true
    (if (opt-inline-tiny-predicate-forward-successors?
      index
      id
      (opt-cfg-index-successors index (opt-cfg-index-label index id)))
      (opt-inline-tiny-predicate-forward-edges-from? index (+ id 1) count)
      false)))

(define (opt-inline-tiny-predicate-acyclic? [blocks : CompilerIrBlockList]) : bool
  (let
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    (opt-inline-tiny-predicate-forward-edges-from?
      index
      0
      (opt-cfg-index-block-count index))))

(define (opt-inline-tiny-predicate-callee?
  [index : OptFunctionIndex]
  [callee : CompilerIrFunction]
  [census : OptInlineCensus]) : bool
  (match callee
    [(CompilerIrFunction.Function callee-name cparams ret cvars cblocks)
      (let
        [np : i64 (opt-inline-param-count cparams)]
        [block-count : i64 (compiler-ir-block-list-count cblocks)]
        [instr-count : i64 (opt-inline-multiblock-cost-instrs cblocks)]
        (and
          (opt-inline-bool-type? ret)
          (not (opt-inline-census-address-taken? index census callee-name))
          (> (opt-inline-census-refcount index census callee-name) 1)
          (opt-inline-params-sequential? cparams 0)
          (>= cvars np)
          (> block-count 1)
          (<= block-count (opt-inline-tiny-predicate-max-blocks))
          (<= instr-count (opt-inline-tiny-predicate-max-instrs))
          (> (opt-inline-return-count-blocks cblocks) 0)
          (opt-inline-structure-ok-reclaiming? cblocks)
          (opt-inline-tiny-predicate-acyclic-reclaiming? cblocks)
          (not (opt-inline-param-mutating-blocks? cblocks np))
          (opt-inline-tiny-predicate-blocks-ok? cblocks)))]))

(define (opt-inline-tiny-predicate-cost-inline?
  [callee-instrs : i64]
  [added-blocks : i64]
  [const-args : i64]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (opt-inline-cost-inline-with-block-weight?
    callee-instrs
    added-blocks
    const-args
    false
    caller-blocks
    added-so-far
    0))

(define (opt-inline-rebase-var [id : i64] [np : i64] [base : i64]) : i64
  (+ base (- id np)))

(define (opt-inline-frame-growth [frame : i64] [np : i64]) : i64
  (- frame np))

(define (opt-inline-stage-arg-var [base : i64] [id : i64]) : CompilerIrValue
  (CompilerIrValue.Var (+ base id)))

(define (opt-inline-param-is-sret-at?
  [params : CompilerIrParamList]
  [target : i64]
  [index : i64]) : bool
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) false]
    [(CompilerIrParamList.Array seq)
      (opt-inline-param-is-sret-at?
        (compiler-ir-param-seq-to-list seq)
        target
        index)]
    [(CompilerIrParamList.Cons param rest)
      (if (= index target)
        (match param
          [(CompilerIrParam.Param name _ _) (string.eq name "__sret")])
        (opt-inline-param-is-sret-at? (box-get rest) target (+ index 1)))]))

(define (opt-inline-staged-arg
  [params : CompilerIrParamList]
  [args : CompilerIrCallArgs]
  [base : i64]
  [index : i64]
  [stage-all? : bool]) : CompilerIrValue
  (if (or stage-all? (not (opt-inline-param-is-sret-at? params index 0)))
    (opt-inline-stage-arg-var base index)
    (opt-inline-clone-arg-at args index)))

(define (opt-inline-staged-args-array-fill!
  [out : (Array CompilerIrValue)]
  [params : CompilerIrParamList]
  [args : CompilerIrCallArgs]
  [base : i64]
  [stage-all? : bool]
  [index : i64]) : unit
  (if (>= index (array-length out))
    unit
    (begin
      (array-set!
        out
        index
        (opt-inline-staged-arg params args base index stage-all?))
      (opt-inline-staged-args-array-fill!
        out
        params
        args
        base
        stage-all?
        (+ index 1)))))

(define (opt-inline-staged-args
  [params : CompilerIrParamList]
  [args : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [stage-all? : bool]) : CompilerIrCallArgs
  (cond
    [(= np 0) (CompilerIrCallArgs.Nil)]
    [(= np 1)
      (CompilerIrCallArgs.One
        (opt-inline-staged-arg params args base 0 stage-all?))]
    [(= np 2)
      (CompilerIrCallArgs.Two
        (opt-inline-staged-arg params args base 0 stage-all?)
        (opt-inline-staged-arg params args base 1 stage-all?))]
    [else
      (let
        [out : (Array CompilerIrValue) (array.make-array CompilerIrValue np)]
        (begin
          (opt-inline-staged-args-array-fill! out params args base stage-all? 0)
          (CompilerIrCallArgs.Array out)))]))

(define (opt-inline-stage-param-instrs
  [params : CompilerIrParamList]
  [args : CompilerIrCallArgs]
  [base : i64]
  [stage-all? : bool]
  [index : i64]) : CompilerIrInstrList
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) CompilerIrInstrList.Nil]
    [(CompilerIrParamList.Array seq)
      (opt-inline-stage-param-instrs
        (compiler-ir-param-seq-to-list seq)
        args
        base
        stage-all?
        index)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param name ty _)
          (let
            [remaining : CompilerIrInstrList
              (opt-inline-stage-param-instrs
                (box-get rest)
                args
                base
                stage-all?
                (+ index 1))]
            (if (or stage-all? (not (string.eq name "__sret")))
              (compiler-ir-instr-cons
                (CompilerIrInstr.Mov
                  (+ base index)
                  (opt-inline-clone-arg-at args index)
                  (clone ty))
                remaining)
              remaining))])]))

(define (opt-inline-clone-arg-at [sa : CompilerIrCallArgs] [id : i64]) : CompilerIrValue
  (match sa
    [(CompilerIrCallArgs.Nil) (CompilerIrValue.Unit)]
    [(CompilerIrCallArgs.One a) (compiler-ir-clone-value a)]
    [(CompilerIrCallArgs.Two a b)
      (if (= id 0)
        (compiler-ir-clone-value a)
        (compiler-ir-clone-value b))]
    [(CompilerIrCallArgs.Array arr)
      (compiler-ir-clone-value (array-ref arr id))]))

(define (opt-inline-remap-value
  [v : CompilerIrValue]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrValue
  (match v
    [(CompilerIrValue.Var id)
      (if (< id np)
        (opt-inline-clone-arg-at sa id)
        (CompilerIrValue.Var (opt-inline-rebase-var id np base)))]
    [(CompilerIrValue.Global name)
      (CompilerIrValue.Global (compiler-ir-symbol-clone name))]
    [(CompilerIrValue.GlobalAddr name)
      (CompilerIrValue.GlobalAddr (compiler-ir-symbol-clone name))]
    [(CompilerIrValue.Function name)
      (CompilerIrValue.Function (compiler-ir-symbol-clone name))]
    [(CompilerIrValue.I64 n) (CompilerIrValue.I64 n)]
    [(CompilerIrValue.F64 bits) (CompilerIrValue.F64 bits)]
    [(CompilerIrValue.Bool b) (CompilerIrValue.Bool b)]
    [(CompilerIrValue.Char c) (CompilerIrValue.Char c)]
    [(CompilerIrValue.String s) (CompilerIrValue.String (clone s))]
    [(CompilerIrValue.Bytes s) (CompilerIrValue.Bytes (clone s))]
    [(CompilerIrValue.RuntimeGlobal init)
      (CompilerIrValue.RuntimeGlobal (compiler-ir-symbol-clone init))]
    [(CompilerIrValue.Unit) (CompilerIrValue.Unit)]))

(define (opt-inline-remap-args
  [a : CompilerIrCallArgs]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrCallArgs
  (match a
    [(CompilerIrCallArgs.Nil) (CompilerIrCallArgs.Nil)]
    [(CompilerIrCallArgs.One x)
      (CompilerIrCallArgs.One (opt-inline-remap-value x sa np base))]
    [(CompilerIrCallArgs.Two x y)
      (CompilerIrCallArgs.Two
        (opt-inline-remap-value x sa np base)
        (opt-inline-remap-value y sa np base))]
    [(CompilerIrCallArgs.Array arr)
      (let
        [n : i64 (array-length arr)]
        [out : (Array CompilerIrValue) (array.make-array CompilerIrValue n)]
        [i : i64 0]
        (begin
          (while (< i n)
            (begin
              (array-set!
                out
                i
                (opt-inline-remap-value (array-ref arr i) sa np base))
              (set! i (+ i 1))))
          (CompilerIrCallArgs.Array out)))]))

(define (opt-inline-remap-value-list
  [values : CompilerIrValueList]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrValueList
  (match values
    [(CompilerIrValueList.Nil) CompilerIrValueList.Nil]
    [(CompilerIrValueList.Array seq)
      (opt-inline-remap-value-list
        (compiler-ir-value-seq-to-list seq)
        sa
        np
        base)]
    [(CompilerIrValueList.Cons value rest)
      (compiler-ir-value-cons
        (opt-inline-remap-value value sa np base)
        (opt-inline-remap-value-list (box-get rest) sa np base))]))

;; Inlining renames a callee's blocks by prefixing the caller-site tag onto the
;; original spelling, so the derived name is re-interned into a fresh id.
(define (opt-inline-maybe-prefix-label [prefix : String] [label : i64]) : i64
  (if (string.eq prefix "")
    label
    (compiler-ir-label
      (string.append (string.append prefix ".") (compiler-ir-label-text label)))))

(define (opt-inline-clone-instr
  [instr : CompilerIrInstr]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [label-prefix : String]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (CompilerIrInstr.Mov
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone ty))]
    [(CompilerIrInstr.Gep dst b o ty)
      (CompilerIrInstr.Gep
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value b sa np base)
        (opt-inline-remap-value o sa np base)
        (clone ty))]
    [(CompilerIrInstr.Load dst src ty)
      (CompilerIrInstr.Load
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone ty))]
    [(CompilerIrInstr.Cast dst src from to)
      (CompilerIrInstr.Cast
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone from)
        (clone to))]
    [(CompilerIrInstr.Bitcast dst src from to)
      (CompilerIrInstr.Bitcast
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone from)
        (clone to))]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (CompilerIrInstr.BinOp
        (opt-inline-rebase-var dst np base)
        op
        (opt-inline-remap-value lhs sa np base)
        (opt-inline-remap-value rhs sa np base)
        (clone ty))]
    [(CompilerIrInstr.UnOp dst op src ty)
      (CompilerIrInstr.UnOp
        (opt-inline-rebase-var dst np base)
        op
        (opt-inline-remap-value src sa np base)
        (clone ty))]
    ;; Pack/Word need explicit remap arms; when they were inline-eligible
    ;; without them, inlined register-group instructions kept their CALLEE-local
    ;; var ids inside the caller -- an opt2 self-build miscompile (the
    ;; stage2/stage3 fixpoint diverged and no-regalloc builds bounds-aborted
    ;; in intern-str on garbage ids).
    [(CompilerIrInstr.Pack dst words ty)
      (CompilerIrInstr.Pack
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value-list words sa np base)
        (clone ty))]
    [(CompilerIrInstr.Word dst src index ty)
      (CompilerIrInstr.Word
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        index
        (clone ty))]
    [(CompilerIrInstr.BoundsCheck idx len msg)
      (CompilerIrInstr.BoundsCheck
        (opt-inline-remap-value idx sa np base)
        (opt-inline-remap-value len sa np base)
        (opt-inline-maybe-prefix-label label-prefix msg))]
    [(CompilerIrInstr.StorePtr d s ty)
      (CompilerIrInstr.StorePtr
        (opt-inline-remap-value d sa np base)
        (opt-inline-remap-value s sa np base)
        (clone ty))]
    [(CompilerIrInstr.CopyBytes d s size)
      (CompilerIrInstr.CopyBytes
        (opt-inline-remap-value d sa np base)
        (opt-inline-remap-value s sa np base)
        size)]
    [(CompilerIrInstr.Call dst name a ty)
      (CompilerIrInstr.Call
        (opt-inline-rebase-var dst np base)
        (compiler-ir-symbol-clone name)
        (opt-inline-remap-args a sa np base)
        (clone ty))]
    [(CompilerIrInstr.CallIndirect dst callee a ty)
      (CompilerIrInstr.CallIndirect
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value callee sa np base)
        (opt-inline-remap-args a sa np base)
        (clone ty))]
    [(CompilerIrInstr.CallIndirectC dst callee a ty)
      (CompilerIrInstr.CallIndirectC
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value callee sa np base)
        (opt-inline-remap-args a sa np base)
        (clone ty))]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload
            call-base
            name
            a
            slots)
          (ir-instr-call-cabi-store-result
            (opt-inline-remap-value call-base sa np base)
            (compiler-ir-symbol-clone name)
            (opt-inline-remap-args a sa np base)
            slots)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            call-base
            callee
            a
            slots)
          (ir-instr-call-indirect-cabi-store-result
            (opt-inline-remap-value call-base sa np base)
            (opt-inline-remap-value callee sa np base)
            (opt-inline-remap-args a sa np base)
            slots)])]
    [_ instr]))

(define (opt-inline-return->mov
  [instr : CompilerIrInstr]
  [dst : i64]
  [ret : AstType]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.Some v)
          (CompilerIrInstr.Mov
            dst
            (opt-inline-remap-value v sa np base)
            (clone ret))]
        [(CompilerIrMaybeValue.No)
          (CompilerIrInstr.Mov dst (CompilerIrValue.Unit) (clone ret))])]
    [_ (CompilerIrInstr.Mov dst (CompilerIrValue.Unit) (clone ret))]))

(define (opt-inline-expand-instrs
  [instrs : CompilerIrInstrList]
  [dst : i64]
  [ret : AstType]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [label-prefix : String]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) CompilerIrInstrList.Nil]
    [(CompilerIrInstrList.Cons instr rest)
      (match (box-get rest)
        [(CompilerIrInstrList.Nil)
          (compiler-ir-instr-cons
            (opt-inline-return->mov instr dst ret sa np base)
            CompilerIrInstrList.Nil)]
        [_
          (compiler-ir-instr-cons
            (opt-inline-clone-instr instr sa np base label-prefix)
            (opt-inline-expand-instrs
              (box-get rest)
              dst
              ret
              sa
              np
              base
              label-prefix))])]))

;; Span policy for inlined clones: prefer the callee instruction's original
;; source span under the clone's new caller/value key. If the callee instruction
;; has no recorded span (notably the synthetic return->mov), use the call-site
;; span so the cloned instruction still points at useful user code.
(define (opt-source-spans-lookup-instr-span
  [source-spans : CompilerSourceSpans]
  [function : i64]
  [instr : CompilerIrInstr]) : CompilerMaybeSourceSpan
  (match source-spans
    [(CompilerSourceSpans.Spans _ instr-entries _)
      (match (opt-remap-spans-instr-key function instr)
        [(OptRemapSpanKey.NoKey) (CompilerMaybeSourceSpan.No)]
        [(OptRemapSpanKey.SomeKey key)
          (compiler-source-spans-instr-entry-list-lookup-span instr-entries key)])]))

(define (opt-inline-record-clone-span
  [source-spans : CompilerSourceSpans]
  [out : CompilerSourceSpans]
  [caller : i64]
  [call-instr : CompilerIrInstr]
  [callee : i64]
  [callee-instr : CompilerIrInstr]
  [cloned : CompilerIrInstr]) : CompilerSourceSpans
  (if (compiler-debug-info-enabled?)
    (match (compiler-source-spans-lookup-instr-location
      source-spans
      callee
      callee-instr)
      [(CompilerMaybeSourceLocation.Some (CompilerSourceLocation path-id span))
        (compiler-source-spans-insert-instr-located
          out
          caller
          cloned
          path-id
          span)]
      [(CompilerMaybeSourceLocation.No)
        (match (compiler-source-spans-lookup-instr-location
          source-spans
          caller
          call-instr)
          [(CompilerMaybeSourceLocation.Some
              (CompilerSourceLocation path-id span))
            (compiler-source-spans-insert-instr-located
              out
              caller
              cloned
              path-id
              span)]
          [(CompilerMaybeSourceLocation.No) out])])
    (match (opt-source-spans-lookup-instr-span source-spans callee callee-instr)
      [(CompilerMaybeSourceSpan.Some span)
        (compiler-source-spans-insert-instr out caller cloned span)]
      [(CompilerMaybeSourceSpan.No)
        (match (opt-source-spans-lookup-instr-span
          source-spans
          caller
          call-instr)
          [(CompilerMaybeSourceSpan.Some span)
            (compiler-source-spans-insert-instr out caller cloned span)]
          [(CompilerMaybeSourceSpan.No) out])])))

(define (opt-inline-expand-instrs-with-spans
  [instrs : CompilerIrInstrList]
  [dst : i64]
  [ret : AstType]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [label-prefix : String]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [caller : i64]
  [call-instr : CompilerIrInstr]
  [callee : i64]) : OptInlineSpanState
  (match instrs
    [(CompilerIrInstrList.Nil)
      (OptInlineSpanState.State CompilerIrInstrList.Nil base 0 out-spans)]
    [(CompilerIrInstrList.Cons instr rest)
      (match (box-get rest)
        [(CompilerIrInstrList.Nil)
          (let
            [moved : CompilerIrInstr
              (opt-inline-return->mov instr dst ret sa np base)]
            [next-spans : CompilerSourceSpans
              (opt-inline-record-clone-span
                source-spans
                out-spans
                caller
                call-instr
                callee
                instr
                moved)]
            (OptInlineSpanState.State
              (compiler-ir-instr-cons moved CompilerIrInstrList.Nil)
              base
              0
              next-spans))]
        [_
          (let
            [cloned : CompilerIrInstr
              (opt-inline-clone-instr instr sa np base label-prefix)]
            [next-spans : CompilerSourceSpans
              (opt-inline-record-clone-span
                source-spans
                out-spans
                caller
                call-instr
                callee
                instr
                cloned)]
            (match (opt-inline-expand-instrs-with-spans
              (box-get rest)
              dst
              ret
              sa
              np
              base
              label-prefix
              source-spans
              next-spans
              caller
              call-instr
              callee)
              [(OptInlineSpanState.State rest-instrs next-vars _ final-spans)
                (OptInlineSpanState.State
                  (compiler-ir-instr-cons cloned rest-instrs)
                  next-vars
                  0
                  final-spans)]))])]))

(define (opt-inline-single-block-instrs [blocks : CompilerIrBlockList]) : CompilerIrInstrList
  (match blocks
    [(CompilerIrBlockList.Cons block _)
      (match block
        [(CompilerIrBlock.Block _ seq)
          (opt-aggregate-instr-seq-append-from seq 0 CompilerIrInstrList.Nil)])]
    [(CompilerIrBlockList.Array seq)
      (if (= (compiler-ir-block-seq-count seq) 1)
        (match (compiler-ir-block-seq-ref seq 0)
          [(CompilerIrBlock.Block _ instrs)
            (opt-aggregate-instr-seq-append-from
              instrs
              0
              CompilerIrInstrList.Nil)])
        CompilerIrInstrList.Nil)]
    [_ CompilerIrInstrList.Nil]))

(define (opt-inline-append [a : CompilerIrInstrList] [b : CompilerIrInstrList]) : CompilerIrInstrList
  (match a
    [(CompilerIrInstrList.Nil) b]
    [(CompilerIrInstrList.Cons instr rest)
      (compiler-ir-instr-cons instr (opt-inline-append (box-get rest) b))]))

(define (opt-inline-block-append
  [a : CompilerIrBlockList]
  [b : CompilerIrBlockList]) : CompilerIrBlockList
  (match a
    [(CompilerIrBlockList.Nil) b]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons block (opt-inline-block-append (box-get rest) b))]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-block-append (compiler-ir-block-seq-to-list seq) b)]))

(define (opt-inline-site-prefix
  [_func-name : i64]
  [block-label : i64]
  [pos : i64]
  [_callee-name : i64]) : String
  (string.append
    (string.append
      (string.append "inl." (compiler-ir-label-text block-label))
      ".")
    (string.int->string pos)))

(define (opt-inline-prefix-label [prefix : String] [label : i64]) : i64
  (opt-inline-maybe-prefix-label prefix label))

(define (opt-inline-cont-label [prefix : String]) : i64
  (compiler-ir-label (string.append prefix ".cont")))

(define (opt-inline-remap-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [prefix : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) CompilerIrPhiInputList.Nil]
    [(CompilerIrPhiInputList.Array seq)
      (opt-inline-remap-phi-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        prefix
        sa
        np
        base)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        (opt-inline-remap-value value sa np base)
        (opt-inline-prefix-label prefix label)
        (opt-inline-remap-phi-inputs (box-get rest) prefix sa np base))]))

(define (opt-inline-prefix-switch-cases-acc
  [cases : CompilerIrSwitchCaseList]
  [prefix : String]
  [acc : CompilerIrSwitchCaseList]) : CompilerIrSwitchCaseList
  (match (compiler-ir-switch-case-list-force-cons cases)
    [(CompilerIrSwitchCaseList.Nil) acc]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case tag label)
          (opt-inline-prefix-switch-cases-acc
            (box-get rest)
            prefix
            (compiler-ir-switch-case-cons-linked
              tag
              (opt-inline-prefix-label prefix label)
              acc))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (opt-inline-prefix-switch-cases-acc
        (compiler-ir-switch-case-seq-to-list seq)
        prefix
        acc)]))

(define (opt-inline-prefix-switch-cases
  [cases : CompilerIrSwitchCaseList]
  [prefix : String]) : CompilerIrSwitchCaseList
  (compiler-ir-switch-case-list-compact-reversed
    (opt-inline-prefix-switch-cases-acc
      cases
      prefix
      CompilerIrSwitchCaseList.Nil)))

(define (opt-inline-clone-multiblock-instr
  [instr : CompilerIrInstr]
  [prefix : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Jump label)
      (CompilerIrInstr.Jump (opt-inline-prefix-label prefix label))]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (CompilerIrInstr.Branch
        (opt-inline-remap-value cond sa np base)
        (opt-inline-prefix-label prefix true-label)
        (opt-inline-prefix-label prefix false-label))]
    [(CompilerIrInstr.Switch value tag-base cases default-label)
      (CompilerIrInstr.Switch
        (opt-inline-remap-value value sa np base)
        tag-base
        (opt-inline-prefix-switch-cases cases prefix)
        (opt-inline-prefix-label prefix default-label))]
    [(CompilerIrInstr.Phi dst inputs ty)
      (CompilerIrInstr.Phi
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-phi-inputs inputs prefix sa np base)
        (clone ty))]
    [_ (opt-inline-clone-instr instr sa np base prefix)]))

(define (opt-inline-return-value
  [maybe : CompilerIrMaybeValue]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrValue
  (match maybe
    [(CompilerIrMaybeValue.Some value)
      (opt-inline-remap-value value sa np base)]
    [(CompilerIrMaybeValue.No) (CompilerIrValue.Unit)]))

(define (opt-inline-clone-multiblock-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [cloned-label : i64]
  [prefix : String]
  [cont-label : i64]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiInstrClone
  (if (>= pos count)
    (OptInlineMultiInstrClone.Clone
      CompilerIrInstrList.Nil
      CompilerIrPhiInputList.Nil)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs pos)]
      (match instr
        [(CompilerIrInstr.Return maybe)
          (OptInlineMultiInstrClone.Clone
            (compiler-ir-instr-cons
              (CompilerIrInstr.Jump cont-label)
              CompilerIrInstrList.Nil)
            (compiler-ir-phi-input-cons
              (opt-inline-return-value maybe sa np base)
              cloned-label
              CompilerIrPhiInputList.Nil))]
        [_
          (let
            [cloned : CompilerIrInstr
              (opt-inline-clone-multiblock-instr instr prefix sa np base)]
            (match (opt-inline-clone-multiblock-instr-seq-from
              instrs
              (+ pos 1)
              count
              cloned-label
              prefix
              cont-label
              sa
              np
              base)
              [(OptInlineMultiInstrClone.Clone rest-instrs rest-inputs)
                (OptInlineMultiInstrClone.Clone
                  (compiler-ir-instr-cons cloned rest-instrs)
                  rest-inputs)]))]))))

(define (opt-inline-clone-multiblock-instr-seq
  [instrs : CompilerIrInstrSeq]
  [cloned-label : i64]
  [prefix : String]
  [cont-label : i64]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiInstrClone
  (opt-inline-clone-multiblock-instr-seq-from
    instrs
    0
    (compiler-ir-instr-seq-count instrs)
    cloned-label
    prefix
    cont-label
    sa
    np
    base))

(define (opt-inline-clone-multiblock-block
  [block : CompilerIrBlock]
  [prefix : String]
  [cont-label : i64]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiClone
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [cloned-label : i64 (opt-inline-prefix-label prefix label)]
        (match (opt-inline-clone-multiblock-instr-seq
          instrs
          cloned-label
          prefix
          cont-label
          sa
          np
          base)
          [(OptInlineMultiInstrClone.Clone cloned-instrs inputs)
            (OptInlineMultiClone.Clone
              (compiler-ir-block-cons
                (compiler-ir-block cloned-label cloned-instrs)
                CompilerIrBlockList.Nil)
              inputs)]))]))

(define (opt-inline-clone-multiblock-blocks
  [blocks : CompilerIrBlockList]
  [prefix : String]
  [cont-label : i64]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiClone
  (match blocks
    [(CompilerIrBlockList.Nil)
      (OptInlineMultiClone.Clone
        CompilerIrBlockList.Nil
        CompilerIrPhiInputList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-inline-clone-multiblock-block
        block
        prefix
        cont-label
        sa
        np
        base)
        [(OptInlineMultiClone.Clone one-block one-inputs)
          (match (opt-inline-clone-multiblock-blocks
            (box-get rest)
            prefix
            cont-label
            sa
            np
            base)
            [(OptInlineMultiClone.Clone rest-blocks rest-inputs)
              (OptInlineMultiClone.Clone
                (opt-inline-block-append one-block rest-blocks)
                (compiler-ir-phi-input-list-reverse-onto one-inputs rest-inputs))])])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-clone-multiblock-blocks
        (compiler-ir-block-seq-to-list seq)
        prefix
        cont-label
        sa
        np
        base)]))

(define (opt-inline-cont-result-instr
  [dst : i64]
  [inputs : CompilerIrPhiInputList]
  [ret : AstType]) : CompilerIrInstr
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Array seq)
      (opt-inline-cont-result-instr
        dst
        (compiler-ir-phi-input-seq-to-list seq)
        ret)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (match (compiler-ir-phi-input-list-force-cons (box-get rest))
        [(CompilerIrPhiInputList.Nil)
          (CompilerIrInstr.Mov dst (compiler-ir-clone-value value) (clone ret))]
        [(CompilerIrPhiInputList.Array seq)
          (if (= (struct-get seq len) 0)
            (CompilerIrInstr.Mov
              dst
              (compiler-ir-clone-value value)
              (clone ret))
            (CompilerIrInstr.Phi dst inputs (clone ret)))]
        [_ (CompilerIrInstr.Phi dst inputs (clone ret))])]
    [(CompilerIrPhiInputList.Nil)
      (CompilerIrInstr.Mov dst (CompilerIrValue.Unit) (clone ret))]))

(define (opt-inline-call-span-to-instr
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [func-name : i64]
  [call-instr : CompilerIrInstr]
  [new-instr : CompilerIrInstr]) : CompilerSourceSpans
  (if (compiler-debug-info-enabled?)
    (match (compiler-source-spans-lookup-instr-location
      source-spans
      func-name
      call-instr)
      [(CompilerMaybeSourceLocation.Some (CompilerSourceLocation path-id span))
        (compiler-source-spans-insert-instr-located
          out-spans
          func-name
          new-instr
          path-id
          span)]
      [(CompilerMaybeSourceLocation.No) out-spans])
    (match (opt-source-spans-lookup-instr-span
      source-spans
      func-name
      call-instr)
      [(CompilerMaybeSourceSpan.Some span)
        (compiler-source-spans-insert-instr out-spans func-name new-instr span)]
      [(CompilerMaybeSourceSpan.No) out-spans])))

(define (opt-inline-lookup-inlinable
  [index : OptFunctionIndex]
  [cname : i64]
  [caller-name : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptMaybeFunction
  (match (opt-function-index-slot index cname)
    [(option_i64.Some callee-slot)
      (if (and
        (>= caller-scc 0)
        (= (array-ref (struct-get scc-result scc-of) callee-slot) caller-scc))
        (OptMaybeFunction.No)
        (let
          [callee : CompilerIrFunction
            (array-ref (struct-get index values) callee-slot)]
          (if (opt-inline-callee-ok? callee caller-name)
            (OptMaybeFunction.Some callee)
            (OptMaybeFunction.No))))]
    [(option_i64.None) (OptMaybeFunction.No)]))

(define (opt-inline-lookup-multiblock-inlinable
  [index : OptFunctionIndex]
  [cname : i64]
  [caller-name : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptMaybeFunction
  (match (opt-function-index-slot index cname)
    [(option_i64.Some callee-slot)
      (if (and
        (>= caller-scc 0)
        (= (array-ref (struct-get scc-result scc-of) callee-slot) caller-scc))
        (OptMaybeFunction.No)
        (let
          [callee : CompilerIrFunction
            (array-ref (struct-get index values) callee-slot)]
          (if (opt-inline-multiblock-callee-ok-cached?
            callee-slot
            callee
            caller-name)
            (OptMaybeFunction.Some callee)
            (OptMaybeFunction.No))))]
    [(option_i64.None) (OptMaybeFunction.No)]))

(define (opt-inline-instr-list-has-bounds-check? [instrs : CompilerIrInstrList]) : bool
  (match instrs
    [(CompilerIrInstrList.Nil) false]
    [(CompilerIrInstrList.Cons instr rest)
      (match instr
        [(CompilerIrInstr.BoundsCheck _ _ _) true]
        [_ (opt-inline-instr-list-has-bounds-check? (box-get rest))])]))

(define (opt-inline-bounds-inline-ok?
  [has-bounds? : bool]
  [absorbable? : bool]
  [const-args : i64]
  [param-count : i64]) : bool
  (if has-bounds?
    (or absorbable? (= const-args param-count))
    true))

;; Keep loop-bearing bounds callees behind the general acyclic gate. `vm-run`
;; is the one measured exception: eliminating its hot dispatch-call boundary
;; wins without changing the static bounds-check count. Match the exact IR leaf
;; so similarly shaped package functions (notably `qs-partition`) stay refused.
(define (opt-inline-vm-run-bounds-loop-exception? [callee-name : i64]) : bool
  (let
    [name : String (compiler-ir-symbol-text callee-name)]
    (opt-symbol-leaf-matches-from? name (opt-symbol-leaf-start name) "vm-run")))

(define (opt-inline-multiblock-bounds-loop-ok?
  [has-bounds? : bool]
  [callee-name : i64]
  [blocks : CompilerIrBlockList]) : bool
  (or
    (not has-bounds?)
    (opt-inline-tiny-predicate-acyclic-reclaiming? blocks)
    (opt-inline-vm-run-bounds-loop-exception? callee-name)))

(define (opt-inline-bounds-leaf-cost-inline?
  [callee-instrs : i64]
  [added-blocks : i64]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (and
    (<= callee-instrs (opt-inline-bounds-leaf-max-body))
    (not
      (opt-inline-cost-crosses-heavy-gate?
        caller-blocks
        added-so-far
        added-blocks))
    (<= (+ added-so-far added-blocks) (opt-inline-cost-block-fuel))))

(define (opt-inline-try
  [instr : CompilerIrInstr]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineState
  (match instr
    [(CompilerIrInstr.Call dst cname cargs cret)
      (match (opt-inline-lookup-inlinable
        index
        cname
        func-name
        scc-result
        caller-scc)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(CompilerIrFunction.Function
                callee-name
                cparams
                callee-ret
                cvars
                cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (let
                    [added-blocks : i64 0]
                    [body-instrs : CompilerIrInstrList
                      (opt-inline-single-block-instrs cblocks)]
                    [const-args : i64 (opt-inline-args-const-count cargs)]
                    [absorbable? : bool
                      (opt-inline-census-absorbable?
                        index
                        census
                        func-name
                        callee-name)]
                    [has-bounds? : bool
                      (opt-inline-instr-list-has-bounds-check? body-instrs)]
                    [bounds-leaf? : bool
                      (opt-inline-bounds-leaf-ok? cblocks np callee-ret)]
                    [callee-instrs : i64
                      (opt-inline-single-block-cost-instrs cblocks)]
                    (if (or
                      (and
                        (opt-inline-bounds-inline-ok?
                          has-bounds?
                          absorbable?
                          const-args
                          np)
                        (opt-inline-cost-inline?
                          callee-instrs
                          added-blocks
                          const-args
                          absorbable?
                          caller-blocks
                          added-so-far))
                      (and
                        bounds-leaf?
                        (opt-inline-bounds-leaf-cost-inline?
                          callee-instrs
                          added-blocks
                          caller-blocks
                          added-so-far)))
                      (begin
                        (set!
                          opt-inline-caller-site-count
                          (+ opt-inline-caller-site-count 1))
                        (OptInlineState.State
                          (opt-inline-expand-instrs
                            body-instrs
                            dst
                            cret
                            cargs
                            np
                            vars
                            (opt-inline-site-prefix
                              func-name
                              block-label
                              site-pos
                              callee-name))
                          (+ vars (opt-inline-frame-growth cvars np))
                          (+ added-so-far added-blocks)))
                      (OptInlineState.State
                        (compiler-ir-instr-cons
                          (CompilerIrInstr.Call dst cname cargs cret)
                          CompilerIrInstrList.Nil)
                        vars
                        added-so-far)))
                  (OptInlineState.State
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Call dst cname cargs cret)
                      CompilerIrInstrList.Nil)
                    vars
                    added-so-far)))])]
        [(OptMaybeFunction.No)
          (OptInlineState.State
            (compiler-ir-instr-cons
              (CompilerIrInstr.Call dst cname cargs cret)
              CompilerIrInstrList.Nil)
            vars
            added-so-far)])]
    [_
      (OptInlineState.State
        (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)
        vars
        added-so-far)]))

(define (opt-inline-try-with-spans
  [instr : CompilerIrInstr]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanState
  (match instr
    [(CompilerIrInstr.Call dst cname cargs cret)
      (match (opt-inline-lookup-inlinable
        index
        cname
        func-name
        scc-result
        caller-scc)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(CompilerIrFunction.Function
                callee-name
                cparams
                callee-ret
                cvars
                cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (let
                    [added-blocks : i64 0]
                    [body-instrs : CompilerIrInstrList
                      (opt-inline-single-block-instrs cblocks)]
                    [const-args : i64 (opt-inline-args-const-count cargs)]
                    [absorbable? : bool
                      (opt-inline-census-absorbable?
                        index
                        census
                        func-name
                        callee-name)]
                    [has-bounds? : bool
                      (opt-inline-instr-list-has-bounds-check? body-instrs)]
                    [bounds-leaf? : bool
                      (opt-inline-bounds-leaf-ok? cblocks np callee-ret)]
                    [callee-instrs : i64
                      (opt-inline-single-block-cost-instrs cblocks)]
                    (if (or
                      (and
                        (opt-inline-bounds-inline-ok?
                          has-bounds?
                          absorbable?
                          const-args
                          np)
                        (opt-inline-cost-inline?
                          callee-instrs
                          added-blocks
                          const-args
                          absorbable?
                          caller-blocks
                          added-so-far))
                      (and
                        bounds-leaf?
                        (opt-inline-bounds-leaf-cost-inline?
                          callee-instrs
                          added-blocks
                          caller-blocks
                          added-so-far)))
                      (begin
                        (set!
                          opt-inline-caller-site-count
                          (+ opt-inline-caller-site-count 1))
                        (match (opt-inline-expand-instrs-with-spans
                          body-instrs
                          dst
                          cret
                          cargs
                          np
                          vars
                          (opt-inline-site-prefix
                            func-name
                            block-label
                            site-pos
                            callee-name)
                          source-spans
                          out-spans
                          func-name
                          instr
                          cname)
                          [(OptInlineSpanState.State expanded _ _ next-spans)
                            (OptInlineSpanState.State
                              expanded
                              (+ vars (opt-inline-frame-growth cvars np))
                              (+ added-so-far added-blocks)
                              next-spans)]))
                      (OptInlineSpanState.State
                        (compiler-ir-instr-cons
                          (CompilerIrInstr.Call dst cname cargs cret)
                          CompilerIrInstrList.Nil)
                        vars
                        added-so-far
                        out-spans)))
                  (OptInlineSpanState.State
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Call dst cname cargs cret)
                      CompilerIrInstrList.Nil)
                    vars
                    added-so-far
                    out-spans)))])]
        [(OptMaybeFunction.No)
          (OptInlineSpanState.State
            (compiler-ir-instr-cons
              (CompilerIrInstr.Call dst cname cargs cret)
              CompilerIrInstrList.Nil)
            vars
            added-so-far
            out-spans)])]
    [_
      (OptInlineSpanState.State
        (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)
        vars
        added-so-far
        out-spans)]))

(define (opt-inline-walk-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [end : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineState
  (if (>= pos end)
    (OptInlineState.State CompilerIrInstrList.Nil vars added-so-far)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs pos)]
      (match (opt-inline-try
        instr
        index
        census
        func-name
        block-label
        site-pos
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)
        [(OptInlineState.State expanded vars2 added2)
          (match (opt-inline-walk-instr-seq-from
            instrs
            (+ pos 1)
            end
            index
            census
            func-name
            block-label
            (+ site-pos 1)
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc)
            [(OptInlineState.State rest-list vars3 added3)
              (OptInlineState.State
                (opt-inline-append expanded rest-list)
                vars3
                added3)])]))))

(define (opt-inline-walk-instr-seq-with-spans-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [end : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanState
  (if (>= pos end)
    (OptInlineSpanState.State
      CompilerIrInstrList.Nil
      vars
      added-so-far
      out-spans)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs pos)]
      (match (opt-inline-try-with-spans
        instr
        index
        census
        func-name
        block-label
        site-pos
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)
        [(OptInlineSpanState.State expanded vars2 added2 spans2)
          (match (opt-inline-walk-instr-seq-with-spans-from
            instrs
            (+ pos 1)
            end
            index
            census
            func-name
            block-label
            (+ site-pos 1)
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc
            source-spans
            spans2)
            [(OptInlineSpanState.State rest-list vars3 added3 spans3)
              (OptInlineSpanState.State
                (opt-inline-append expanded rest-list)
                vars3
                added3
                spans3)])]))))

(define (opt-inline-rewrite-single-block-seq
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineMaybeBlockRewrite
  (match (opt-inline-walk-instr-seq-from
    instrs
    0
    (compiler-ir-instr-seq-count instrs)
    index
    census
    func-name
    block-label
    0
    vars
    caller-blocks
    added-so-far
    scc-result
    caller-scc)
    [(OptInlineState.State new-instrs vars2 added2)
      (OptInlineMaybeBlockRewrite.SomeBlockRewrite
        (compiler-ir-block-cons
          (compiler-ir-block block-label new-instrs)
          CompilerIrBlockList.Nil)
        vars2
        added2)]))

(define (opt-inline-multiblock-build-rewrite-seq
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]
  [call-pos : i64]
  [count : i64]
  [site-pos : i64]
  [call-instr : CompilerIrInstr]
  [callee : CompilerIrFunction]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [index : OptFunctionIndex]) : OptInlineMaybeBlockRewrite
  (match call-instr
    [(CompilerIrInstr.Call dst cname cargs cret)
      (match callee
        [(CompilerIrFunction.Function callee-name cparams _ cvars cblocks)
          (let
            [np : i64 (opt-inline-param-count cparams)]
            (if (opt-inline-arity-ok? cargs np)
              (let
                [added-blocks : i64
                  (+ (compiler-ir-block-list-count cblocks) 1)]
                [stage-all-args? : bool
                  (opt-inline-param-mutating-blocks? cblocks np)]
                [stage-args? : bool
                  (or stage-all-args? (opt-inline-params-have-sret? cparams))]
                [callee-instrs : i64
                  (+
                    (opt-inline-multiblock-cost-instrs cblocks)
                    (if stage-args?
                      np
                      0))]
                [const-args : i64 (opt-inline-args-const-count cargs)]
                [absorbable : bool
                  (opt-inline-census-absorbable?
                    index
                    census
                    func-name
                    callee-name)]
                ;; Splitting a loop phi predecessor can lengthen live ranges.
                ;; Keep ordinary cost-model admission available here, but do
                ;; not let the unconditional single-reference absorb bonus
                ;; bypass its budget. #5193 owns the next bounded wrapper class.
                [tiny-predicate? : bool
                  (and
                    (not stage-args?)
                    (opt-inline-tiny-predicate-callee? index callee census))]
                ;; Bounds-carrying loops stay acyclic-only except for the exact
                ;; measured vm-run leaf selected by the shared gate (#5325).
                [has-bounds? : bool
                  (opt-inline-blocks-have-bounds-check? cblocks)]
                [bounds-ok? : bool
                  (opt-inline-bounds-inline-ok?
                    has-bounds?
                    absorbable
                    const-args
                    np)]
                [bounds-loop-ok? : bool
                  (opt-inline-multiblock-bounds-loop-ok?
                    has-bounds?
                    callee-name
                    cblocks)]
                [inline? : bool
                  (and
                    bounds-ok?
                    bounds-loop-ok?
                    (or
                      (opt-inline-cost-inline?
                        callee-instrs
                        added-blocks
                        const-args
                        (and
                          absorbable
                          (not opt-inline-current-phi-predecessor?))
                        caller-blocks
                        added-so-far)
                      (and
                        tiny-predicate?
                        (opt-inline-tiny-predicate-cost-inline?
                          callee-instrs
                          added-blocks
                          const-args
                          caller-blocks
                          added-so-far))))]
                (if inline?
                  (match (opt-inline-walk-instr-seq-from
                    instrs
                    0
                    call-pos
                    index
                    census
                    func-name
                    block-label
                    0
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc)
                    [(OptInlineState.State
                        prefix-instrs
                        prefix-vars
                        prefix-added)
                      (let
                        [_site-bump : unit
                          (set!
                            opt-inline-caller-site-count
                            (+ opt-inline-caller-site-count 1))]
                        [prefix : String
                          (opt-inline-site-prefix
                            func-name
                            block-label
                            site-pos
                            callee-name)]
                        [entry-label : i64
                          (opt-inline-prefix-label
                            prefix
                            (opt-cfg-entry-label cblocks))]
                        [cont-label : i64 (opt-inline-cont-label prefix)]
                        [vars2 : i64
                          (+
                            prefix-vars
                            (if stage-args?
                              cvars
                              (opt-inline-frame-growth cvars np)))]
                        [added2 : i64 (+ prefix-added added-blocks)]
                        [stage-instrs : CompilerIrInstrList
                          (if stage-args?
                            (opt-inline-stage-param-instrs
                              cparams
                              cargs
                              prefix-vars
                              stage-all-args?
                              0)
                            CompilerIrInstrList.Nil)]
                        [staged-args : CompilerIrCallArgs
                          (if stage-args?
                            (opt-inline-staged-args
                              cparams
                              cargs
                              np
                              prefix-vars
                              stage-all-args?)
                            cargs)]
                        [clone-base : i64
                          (if stage-args?
                            (+ prefix-vars np)
                            prefix-vars)]
                        [prefix-instrs2 : CompilerIrInstrList
                          (opt-inline-append
                            prefix-instrs
                            (opt-inline-append
                              stage-instrs
                              (compiler-ir-instr-cons
                                (CompilerIrInstr.Jump entry-label)
                                CompilerIrInstrList.Nil)))]
                        (match (opt-inline-clone-multiblock-blocks
                          cblocks
                          prefix
                          cont-label
                          staged-args
                          np
                          clone-base)
                          [(OptInlineMultiClone.Clone
                              cloned-blocks
                              return-inputs)
                            (match (opt-inline-walk-instr-seq-from
                              instrs
                              (+ call-pos 1)
                              count
                              index
                              census
                              func-name
                              block-label
                              (+ site-pos 1)
                              vars2
                              caller-blocks
                              added2
                              scc-result
                              caller-scc)
                              [(OptInlineState.State suffix vars3 added3)
                                (let
                                  [result-instr : CompilerIrInstr
                                    (opt-inline-cont-result-instr
                                      dst
                                      return-inputs
                                      cret)]
                                  [cont-instrs : CompilerIrInstrList
                                    (compiler-ir-instr-cons result-instr suffix)]
                                  [_record-pred-rename : unit
                                    (if opt-inline-current-phi-predecessor?
                                      (set!
                                        opt-inline-pred-renames
                                        (opt-inline-pred-renames-cons
                                          block-label
                                          cont-label
                                          opt-inline-pred-renames))
                                      unit)]
                                  (OptInlineMaybeBlockRewrite.SomeBlockRewrite
                                    (compiler-ir-block-cons
                                      (compiler-ir-block
                                        block-label
                                        prefix-instrs2)
                                      (opt-inline-block-append
                                        cloned-blocks
                                        (compiler-ir-block-cons
                                          (compiler-ir-block
                                            cont-label
                                            cont-instrs)
                                          CompilerIrBlockList.Nil)))
                                    vars3
                                    added3))])]))])
                  (OptInlineMaybeBlockRewrite.NoBlockRewrite)))
              (OptInlineMaybeBlockRewrite.NoBlockRewrite)))])]
    [_ (OptInlineMaybeBlockRewrite.NoBlockRewrite)]))

(define (opt-inline-try-multiblock-rewrite-seq-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [block-label : i64]
  [site-pos : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineMaybeBlockRewrite
  (if (>= pos count)
    (opt-inline-rewrite-single-block-seq
      block-label
      instrs
      index
      census
      func-name
      vars
      caller-blocks
      added-so-far
      scc-result
      caller-scc)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs pos)]
      (match instr
        [(CompilerIrInstr.Call _ cname _ _)
          (match (opt-inline-lookup-multiblock-inlinable
            index
            cname
            func-name
            scc-result
            caller-scc)
            [(OptMaybeFunction.Some callee)
              (match (opt-inline-multiblock-build-rewrite-seq
                block-label
                instrs
                pos
                count
                site-pos
                instr
                callee
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc
                index)
                [(OptInlineMaybeBlockRewrite.SomeBlockRewrite
                    blocks2
                    vars2
                    added2)
                  (OptInlineMaybeBlockRewrite.SomeBlockRewrite
                    blocks2
                    vars2
                    added2)]
                [(OptInlineMaybeBlockRewrite.NoBlockRewrite)
                  (opt-inline-try-multiblock-rewrite-seq-from
                    instrs
                    (+ pos 1)
                    count
                    block-label
                    (+ site-pos 1)
                    index
                    census
                    func-name
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc)])]
            [(OptMaybeFunction.No)
              (opt-inline-try-multiblock-rewrite-seq-from
                instrs
                (+ pos 1)
                count
                block-label
                (+ site-pos 1)
                index
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc)])]
        [_
          (opt-inline-try-multiblock-rewrite-seq-from
            instrs
            (+ pos 1)
            count
            block-label
            (+ site-pos 1)
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc)]))))

;; A block with no direct call instruction contains no inline site: both the
;; single-block walk and the multiblock rewrite only fire on
;; CompilerIrInstr.Call. Returning the original block skips the
;; per-instruction rebuild walk without changing the result.
(define (opt-inline-instr-seq-has-call-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Call _ _ _ _) true]
      [_ (opt-inline-instr-seq-has-call-from? instrs (+ index 1))])))

(define (opt-inline-instr-seq-has-call? [instrs : CompilerIrInstrSeq]) : bool
  (opt-inline-instr-seq-has-call-from? instrs 0))

(define (opt-inline-rewrite-block
  [block : CompilerIrBlock]
  [phi-predecessors : OptLabelSet]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineMaybeBlockRewrite
  (match block
    [(CompilerIrBlock.Block label seq)
      (if (not (opt-inline-instr-seq-has-call? seq))
        (OptInlineMaybeBlockRewrite.SomeBlockRewrite
          (compiler-ir-block-cons block CompilerIrBlockList.Nil)
          vars
          added-so-far)
        (begin
          (set!
            opt-inline-current-phi-predecessor?
            (opt-label-contains phi-predecessors label))
          (opt-inline-try-multiblock-rewrite-seq-from
            seq
            0
            (compiler-ir-instr-seq-count seq)
            label
            0
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc)))]))

(define (opt-inline-clone-multiblock-instr-seq-with-spans-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [cloned-label : i64]
  [prefix : String]
  [cont-label : i64]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [caller : i64]
  [call-instr : CompilerIrInstr]
  [callee : i64]) : OptInlineMultiSpanInstrClone
  (if (>= pos count)
    (OptInlineMultiSpanInstrClone.Clone
      CompilerIrInstrList.Nil
      CompilerIrPhiInputList.Nil
      out-spans)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs pos)]
      (match instr
        [(CompilerIrInstr.Return maybe)
          (OptInlineMultiSpanInstrClone.Clone
            (compiler-ir-instr-cons
              (CompilerIrInstr.Jump cont-label)
              CompilerIrInstrList.Nil)
            (compiler-ir-phi-input-cons
              (opt-inline-return-value maybe sa np base)
              cloned-label
              CompilerIrPhiInputList.Nil)
            out-spans)]
        [_
          (let
            [cloned : CompilerIrInstr
              (opt-inline-clone-multiblock-instr instr prefix sa np base)]
            [spans2 : CompilerSourceSpans
              (opt-inline-record-clone-span
                source-spans
                out-spans
                caller
                call-instr
                callee
                instr
                cloned)]
            (match (opt-inline-clone-multiblock-instr-seq-with-spans-from
              instrs
              (+ pos 1)
              count
              cloned-label
              prefix
              cont-label
              sa
              np
              base
              source-spans
              spans2
              caller
              call-instr
              callee)
              [(OptInlineMultiSpanInstrClone.Clone
                  rest-instrs
                  rest-inputs
                  spans3)
                (OptInlineMultiSpanInstrClone.Clone
                  (compiler-ir-instr-cons cloned rest-instrs)
                  rest-inputs
                  spans3)]))]))))

(define (opt-inline-clone-multiblock-instr-seq-with-spans
  [instrs : CompilerIrInstrSeq]
  [cloned-label : i64]
  [prefix : String]
  [cont-label : i64]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [caller : i64]
  [call-instr : CompilerIrInstr]
  [callee : i64]) : OptInlineMultiSpanInstrClone
  (opt-inline-clone-multiblock-instr-seq-with-spans-from
    instrs
    0
    (compiler-ir-instr-seq-count instrs)
    cloned-label
    prefix
    cont-label
    sa
    np
    base
    source-spans
    out-spans
    caller
    call-instr
    callee))

(define (opt-inline-clone-multiblock-block-with-spans
  [block : CompilerIrBlock]
  [prefix : String]
  [cont-label : i64]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [caller : i64]
  [call-instr : CompilerIrInstr]
  [callee : i64]) : OptInlineMultiSpanClone
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [cloned-label : i64 (opt-inline-prefix-label prefix label)]
        (match (opt-inline-clone-multiblock-instr-seq-with-spans
          instrs
          cloned-label
          prefix
          cont-label
          sa
          np
          base
          source-spans
          out-spans
          caller
          call-instr
          callee)
          [(OptInlineMultiSpanInstrClone.Clone cloned-instrs inputs spans2)
            (OptInlineMultiSpanClone.Clone
              (compiler-ir-block-cons
                (compiler-ir-block cloned-label cloned-instrs)
                CompilerIrBlockList.Nil)
              inputs
              spans2)]))]))

(define (opt-inline-clone-multiblock-blocks-with-spans
  [blocks : CompilerIrBlockList]
  [prefix : String]
  [cont-label : i64]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [caller : i64]
  [call-instr : CompilerIrInstr]
  [callee : i64]) : OptInlineMultiSpanClone
  (match blocks
    [(CompilerIrBlockList.Nil)
      (OptInlineMultiSpanClone.Clone
        CompilerIrBlockList.Nil
        CompilerIrPhiInputList.Nil
        out-spans)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-inline-clone-multiblock-block-with-spans
        block
        prefix
        cont-label
        sa
        np
        base
        source-spans
        out-spans
        caller
        call-instr
        callee)
        [(OptInlineMultiSpanClone.Clone one-block one-inputs spans2)
          (match (opt-inline-clone-multiblock-blocks-with-spans
            (box-get rest)
            prefix
            cont-label
            sa
            np
            base
            source-spans
            spans2
            caller
            call-instr
            callee)
            [(OptInlineMultiSpanClone.Clone rest-blocks rest-inputs spans3)
              (OptInlineMultiSpanClone.Clone
                (opt-inline-block-append one-block rest-blocks)
                (compiler-ir-phi-input-list-reverse-onto one-inputs rest-inputs)
                spans3)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-clone-multiblock-blocks-with-spans
        (compiler-ir-block-seq-to-list seq)
        prefix
        cont-label
        sa
        np
        base
        source-spans
        out-spans
        caller
        call-instr
        callee)]))

(define (opt-inline-rewrite-single-block-seq-with-spans
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match (opt-inline-walk-instr-seq-with-spans-from
    instrs
    0
    (compiler-ir-instr-seq-count instrs)
    index
    census
    func-name
    block-label
    0
    vars
    caller-blocks
    added-so-far
    scc-result
    caller-scc
    source-spans
    out-spans)
    [(OptInlineSpanState.State new-instrs vars2 added2 spans2)
      (OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
        (compiler-ir-block-cons
          (compiler-ir-block block-label new-instrs)
          CompilerIrBlockList.Nil)
        vars2
        added2
        spans2)]))

(define (opt-inline-multiblock-build-span-rewrite-seq
  [block-label : i64]
  [instrs : CompilerIrInstrSeq]
  [call-pos : i64]
  [count : i64]
  [site-pos : i64]
  [call-instr : CompilerIrInstr]
  [callee : CompilerIrFunction]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [index : OptFunctionIndex]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match call-instr
    [(CompilerIrInstr.Call dst cname cargs cret)
      (match callee
        [(CompilerIrFunction.Function callee-name cparams _ cvars cblocks)
          (let
            [np : i64 (opt-inline-param-count cparams)]
            (if (opt-inline-arity-ok? cargs np)
              (let
                [added-blocks : i64
                  (+ (compiler-ir-block-list-count cblocks) 1)]
                [stage-all-args? : bool
                  (opt-inline-param-mutating-blocks? cblocks np)]
                [stage-args? : bool
                  (or stage-all-args? (opt-inline-params-have-sret? cparams))]
                [callee-instrs : i64
                  (+
                    (opt-inline-multiblock-cost-instrs cblocks)
                    (if stage-args?
                      np
                      0))]
                [const-args : i64 (opt-inline-args-const-count cargs)]
                [absorbable : bool
                  (opt-inline-census-absorbable?
                    index
                    census
                    func-name
                    callee-name)]
                [tiny-predicate? : bool
                  (and
                    (not stage-args?)
                    (opt-inline-tiny-predicate-callee? index callee census))]
                ;; Keep the span-aware path on the same exact vm-run decision.
                [has-bounds? : bool
                  (opt-inline-blocks-have-bounds-check? cblocks)]
                [bounds-ok? : bool
                  (opt-inline-bounds-inline-ok?
                    has-bounds?
                    absorbable
                    const-args
                    np)]
                [bounds-loop-ok? : bool
                  (opt-inline-multiblock-bounds-loop-ok?
                    has-bounds?
                    callee-name
                    cblocks)]
                [inline? : bool
                  (and
                    bounds-ok?
                    bounds-loop-ok?
                    (or
                      (opt-inline-cost-inline?
                        callee-instrs
                        added-blocks
                        const-args
                        (and
                          absorbable
                          (not opt-inline-current-phi-predecessor?))
                        caller-blocks
                        added-so-far)
                      (and
                        tiny-predicate?
                        (opt-inline-tiny-predicate-cost-inline?
                          callee-instrs
                          added-blocks
                          const-args
                          caller-blocks
                          added-so-far))))]
                (if inline?
                  (match (opt-inline-walk-instr-seq-with-spans-from
                    instrs
                    0
                    call-pos
                    index
                    census
                    func-name
                    block-label
                    0
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc
                    source-spans
                    out-spans)
                    [(OptInlineSpanState.State
                        prefix-instrs
                        prefix-vars
                        prefix-added
                        spans2)
                      (let
                        [_site-bump : unit
                          (set!
                            opt-inline-caller-site-count
                            (+ opt-inline-caller-site-count 1))]
                        [prefix : String
                          (opt-inline-site-prefix
                            func-name
                            block-label
                            site-pos
                            callee-name)]
                        [entry-label : i64
                          (opt-inline-prefix-label
                            prefix
                            (opt-cfg-entry-label cblocks))]
                        [cont-label : i64 (opt-inline-cont-label prefix)]
                        [vars2 : i64
                          (+
                            prefix-vars
                            (if stage-args?
                              cvars
                              (opt-inline-frame-growth cvars np)))]
                        [added2 : i64 (+ prefix-added added-blocks)]
                        [stage-instrs : CompilerIrInstrList
                          (if stage-args?
                            (opt-inline-stage-param-instrs
                              cparams
                              cargs
                              prefix-vars
                              stage-all-args?
                              0)
                            CompilerIrInstrList.Nil)]
                        [staged-args : CompilerIrCallArgs
                          (if stage-args?
                            (opt-inline-staged-args
                              cparams
                              cargs
                              np
                              prefix-vars
                              stage-all-args?)
                            cargs)]
                        [clone-base : i64
                          (if stage-args?
                            (+ prefix-vars np)
                            prefix-vars)]
                        [prefix-instrs2 : CompilerIrInstrList
                          (opt-inline-append
                            prefix-instrs
                            (opt-inline-append
                              stage-instrs
                              (compiler-ir-instr-cons
                                (CompilerIrInstr.Jump entry-label)
                                CompilerIrInstrList.Nil)))]
                        (match (opt-inline-clone-multiblock-blocks-with-spans
                          cblocks
                          prefix
                          cont-label
                          staged-args
                          np
                          clone-base
                          source-spans
                          spans2
                          func-name
                          call-instr
                          callee-name)
                          [(OptInlineMultiSpanClone.Clone
                              cloned-blocks
                              return-inputs
                              spans3)
                            (match (opt-inline-walk-instr-seq-with-spans-from
                              instrs
                              (+ call-pos 1)
                              count
                              index
                              census
                              func-name
                              block-label
                              (+ site-pos 1)
                              vars2
                              caller-blocks
                              added2
                              scc-result
                              caller-scc
                              source-spans
                              spans3)
                              [(OptInlineSpanState.State
                                  suffix
                                  vars3
                                  added3
                                  spans4)
                                (let
                                  [result-instr : CompilerIrInstr
                                    (opt-inline-cont-result-instr
                                      dst
                                      return-inputs
                                      cret)]
                                  [spans5 : CompilerSourceSpans
                                    (opt-inline-call-span-to-instr
                                      source-spans
                                      spans4
                                      func-name
                                      call-instr
                                      result-instr)]
                                  [cont-instrs : CompilerIrInstrList
                                    (compiler-ir-instr-cons result-instr suffix)]
                                  [_record-pred-rename : unit
                                    (if opt-inline-current-phi-predecessor?
                                      (set!
                                        opt-inline-pred-renames
                                        (opt-inline-pred-renames-cons
                                          block-label
                                          cont-label
                                          opt-inline-pred-renames))
                                      unit)]
                                  (OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
                                    (compiler-ir-block-cons
                                      (compiler-ir-block
                                        block-label
                                        prefix-instrs2)
                                      (opt-inline-block-append
                                        cloned-blocks
                                        (compiler-ir-block-cons
                                          (compiler-ir-block
                                            cont-label
                                            cont-instrs)
                                          CompilerIrBlockList.Nil)))
                                    vars3
                                    added3
                                    spans5))])]))])
                  (OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)))
              (OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)))])]
    [_ (OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)]))

(define (opt-inline-try-multiblock-span-rewrite-seq-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [block-label : i64]
  [site-pos : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (if (>= pos count)
    (opt-inline-rewrite-single-block-seq-with-spans
      block-label
      instrs
      index
      census
      func-name
      vars
      caller-blocks
      added-so-far
      scc-result
      caller-scc
      source-spans
      out-spans)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs pos)]
      (match instr
        [(CompilerIrInstr.Call _ cname _ _)
          (match (opt-inline-lookup-multiblock-inlinable
            index
            cname
            func-name
            scc-result
            caller-scc)
            [(OptMaybeFunction.Some callee)
              (match (opt-inline-multiblock-build-span-rewrite-seq
                block-label
                instrs
                pos
                count
                site-pos
                instr
                callee
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc
                index
                source-spans
                out-spans)
                [(OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
                    blocks2
                    vars2
                    added2
                    spans2)
                  (OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
                    blocks2
                    vars2
                    added2
                    spans2)]
                [(OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)
                  (opt-inline-try-multiblock-span-rewrite-seq-from
                    instrs
                    (+ pos 1)
                    count
                    block-label
                    (+ site-pos 1)
                    index
                    census
                    func-name
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc
                    source-spans
                    out-spans)])]
            [(OptMaybeFunction.No)
              (opt-inline-try-multiblock-span-rewrite-seq-from
                instrs
                (+ pos 1)
                count
                block-label
                (+ site-pos 1)
                index
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc
                source-spans
                out-spans)])]
        [_
          (opt-inline-try-multiblock-span-rewrite-seq-from
            instrs
            (+ pos 1)
            count
            block-label
            (+ site-pos 1)
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc
            source-spans
            out-spans)]))))

(define (opt-inline-rewrite-block-with-spans
  [block : CompilerIrBlock]
  [phi-predecessors : OptLabelSet]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match block
    [(CompilerIrBlock.Block label seq)
      (if (not (opt-inline-instr-seq-has-call? seq))
        (OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
          (compiler-ir-block-cons block CompilerIrBlockList.Nil)
          vars
          added-so-far
          out-spans)
        (begin
          (set!
            opt-inline-current-phi-predecessor?
            (opt-label-contains phi-predecessors label))
          (opt-inline-try-multiblock-span-rewrite-seq-from
            seq
            0
            (compiler-ir-instr-seq-count seq)
            label
            0
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc
            source-spans
            out-spans)))]))

(define (opt-inline-blocks
  [blocks : CompilerIrBlockList]
  [phi-predecessors : OptLabelSet]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineBlocks
  (match blocks
    [(CompilerIrBlockList.Nil)
      (OptInlineBlocks.Blocks CompilerIrBlockList.Nil vars added-so-far)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-inline-rewrite-block
        block
        phi-predecessors
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)
        [(OptInlineMaybeBlockRewrite.SomeBlockRewrite rewritten vars2 added2)
          (match (opt-inline-blocks
            (box-get rest)
            phi-predecessors
            index
            census
            func-name
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc)
            [(OptInlineBlocks.Blocks rest-blocks vars3 added3)
              (OptInlineBlocks.Blocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                added3)])]
        [(OptInlineMaybeBlockRewrite.NoBlockRewrite)
          (OptInlineBlocks.Blocks
            (compiler-ir-block-cons block CompilerIrBlockList.Nil)
            vars
            added-so-far)])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-blocks
        (compiler-ir-block-seq-to-list seq)
        phi-predecessors
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)]))

(define (opt-inline-blocks-with-spans
  [blocks : CompilerIrBlockList]
  [phi-predecessors : OptLabelSet]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanBlocks
  (match blocks
    [(CompilerIrBlockList.Nil)
      (OptInlineSpanBlocks.Blocks
        CompilerIrBlockList.Nil
        vars
        added-so-far
        out-spans)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-inline-rewrite-block-with-spans
        block
        phi-predecessors
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)
        [(OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
            rewritten
            vars2
            added2
            spans2)
          (match (opt-inline-blocks-with-spans
            (box-get rest)
            phi-predecessors
            index
            census
            func-name
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc
            source-spans
            spans2)
            [(OptInlineSpanBlocks.Blocks rest-blocks vars3 added3 spans3)
              (OptInlineSpanBlocks.Blocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                added3
                spans3)])]
        [(OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)
          (OptInlineSpanBlocks.Blocks
            (compiler-ir-block-cons block CompilerIrBlockList.Nil)
            vars
            added-so-far
            out-spans)])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-blocks-with-spans
        (compiler-ir-block-seq-to-list seq)
        phi-predecessors
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)]))

(define (opt-inline-bounds-labels-unique-instrs-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [seen : opt_string_i64_map.Map]) : OptInlineBoundsLabelScan
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptInlineBoundsLabelScan.Ok seen)
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.BoundsCheck _ _ ok-label)
        (if (opt_string_i64_map.contains? (& seen) ok-label)
          (OptInlineBoundsLabelScan.Duplicate)
          (begin
            (opt_string_i64_map.insert-ref! (&mut seen) ok-label 1)
            (opt-inline-bounds-labels-unique-instrs-from
              instrs
              (+ index 1)
              seen)))]
      [_ (opt-inline-bounds-labels-unique-instrs-from instrs (+ index 1) seen)])))

(define (opt-inline-bounds-labels-unique-blocks?
  [blocks : CompilerIrBlockList]
  [seen : opt_string_i64_map.Map]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (opt-inline-bounds-labels-unique-instrs-from instrs 0 seen)
            [(OptInlineBoundsLabelScan.Duplicate) false]
            [(OptInlineBoundsLabelScan.Ok next-seen)
              (opt-inline-bounds-labels-unique-blocks? (box-get rest) next-seen)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-bounds-labels-unique-blocks?
        (compiler-ir-block-seq-to-list seq)
        seen)]))

(define (opt-inline-bounds-labels-unique? [blocks : CompilerIrBlockList]) : bool
  (opt-inline-bounds-labels-unique-blocks?
    blocks
    (opt_string_i64_map.with-capacity 64)))

(define (opt-inline-structure-ok? [blocks : CompilerIrBlockList]) : bool
  (let
    ;; The index this already builds for the phi check answers the two label
    ;; scans as well, so build it up front instead of walking the blocks twice
    ;; more first.
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    (begin
      (unless (opt-cfg-index-labels-unique? index) (return false))
      (unless (opt-inline-bounds-labels-unique? blocks) (return false))
      (unless (struct-get index targets-known) (return false))
      (opt-verify-ok?
        (opt-verify-phi-predecessors-blocks (OptPredMap index) blocks)))))

;; Inlining retains rewritten IR in the program arena, but its structural
;; verifier builds only temporary CFG indexes and predecessor maps. Reuse one
;; scratch arena across the program so those per-function tables do not remain
;; live until backend emission.
(define opt-inline-verify-scratch-arena : i64
  0)

(define (opt-inline-structure-ok-reclaiming? [blocks : CompilerIrBlockList]) : bool
  (if (= opt-inline-verify-scratch-arena 0)
    (opt-inline-structure-ok? blocks)
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 opt-inline-verify-scratch-arena]
      [_switch : unit
        (unsafe
          (arena.tl_arena_set scratch))]
      [mark : i64 (arena.tl_region_mark)]
      [ok : bool (opt-inline-structure-ok? blocks)]
      [scratch-head : i64 (arena.tl_arena_current)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch-head)
          (arena.tl_region_reset mark))
        (set! opt-inline-verify-scratch-arena (arena.tl_arena_current))
        (unsafe
          (arena.tl_arena_set enclosing))
        ok))))

(define (opt-inline-tiny-predicate-acyclic-reclaiming?
  [blocks : CompilerIrBlockList]) : bool
  (if (= opt-inline-verify-scratch-arena 0)
    (opt-inline-tiny-predicate-acyclic? blocks)
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 opt-inline-verify-scratch-arena]
      [_switch : unit
        (unsafe
          (arena.tl_arena_set scratch))]
      [mark : i64 (arena.tl_region_mark)]
      [ok : bool (opt-inline-tiny-predicate-acyclic? blocks)]
      [scratch-head : i64 (arena.tl_arena_current)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch-head)
          (arena.tl_region_reset mark))
        (set! opt-inline-verify-scratch-arena (arena.tl_arena_current))
        (unsafe
          (arena.tl_arena_set enclosing))
        ok))))

(define (opt-inline-revert-or-keep
  [fallback : CompilerIrFunction]
  [next : CompilerIrFunction]) : CompilerIrFunction
  (match next
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (if (opt-inline-structure-ok? blocks)
        next
        fallback)]))

(define (opt-inline-repair-or-keep
  [type-segment-bases : i64]
  [fallback : CompilerIrFunction]
  [next : CompilerIrFunction]
  [repair? : bool]) : CompilerIrFunction
  (match next
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (if (opt-inline-structure-ok-reclaiming? blocks)
        (if repair?
          (opt-ssa-construct-function type-segment-bases next)
          next)
        fallback)]))

(define (opt-inline-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function name params ret vars blocks)
      (let
        [caller-blocks : i64 (compiler-ir-block-list-count blocks)]
        [phi-predecessors : OptLabelSet
          (opt-inline-blocks-phi-predecessors-add blocks (OptLabelSet.Nil))]
        [_reset-sites : unit
          (begin
            (set! opt-inline-caller-site-count 0)
            (set! opt-inline-pred-renames (OptInlinePredRenameList.Nil)))]
        (match (opt-inline-blocks
          blocks
          phi-predecessors
          index
          census
          name
          vars
          caller-blocks
          0
          scc-result
          caller-scc)
          [(OptInlineBlocks.Blocks new-blocks new-vars added)
            (if (= opt-inline-caller-site-count 0)
              func
              (let
                [repaired-blocks : CompilerIrBlockList
                  (opt-inline-repair-phi-predecessors
                    new-blocks
                    opt-inline-pred-renames)]
                (opt-inline-repair-or-keep
                  type-segment-bases
                  func
                  (CompilerIrFunction.Function
                    name
                    params
                    ret
                    new-vars
                    repaired-blocks)
                  (> added 0))))]))]))

(define (opt-inline-function-with-spans
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanProgram
  (match func
    [(CompilerIrFunction.Function name params ret vars blocks)
      (let
        [caller-blocks : i64 (compiler-ir-block-list-count blocks)]
        [phi-predecessors : OptLabelSet
          (opt-inline-blocks-phi-predecessors-add blocks (OptLabelSet.Nil))]
        [_reset-sites : unit
          (begin
            (set! opt-inline-caller-site-count 0)
            (set! opt-inline-pred-renames (OptInlinePredRenameList.Nil)))]
        (match (opt-inline-blocks-with-spans
          blocks
          phi-predecessors
          index
          census
          name
          vars
          caller-blocks
          0
          scc-result
          caller-scc
          source-spans
          out-spans)
          [(OptInlineSpanBlocks.Blocks new-blocks new-vars added next-spans)
            (if (= opt-inline-caller-site-count 0)
              (OptInlineSpanProgram.Program
                (compiler-ir-function-cons func CompilerIrFunctionList.Nil)
                out-spans)
              (let
                [repaired-blocks : CompilerIrBlockList
                  (opt-inline-repair-phi-predecessors
                    new-blocks
                    opt-inline-pred-renames)]
                [next : CompilerIrFunction
                  (CompilerIrFunction.Function
                    name
                    params
                    ret
                    new-vars
                    repaired-blocks)]
                (if (opt-inline-structure-ok-reclaiming? repaired-blocks)
                  (OptInlineSpanProgram.Program
                    (compiler-ir-function-cons
                      (if (> added 0)
                        (opt-ssa-construct-function type-segment-bases next)
                        next)
                      CompilerIrFunctionList.Nil)
                    next-spans)
                  (OptInlineSpanProgram.Program
                    (compiler-ir-function-cons func CompilerIrFunctionList.Nil)
                    out-spans))))]))]))

(define (opt-function-index-to-list [index : OptFunctionIndex]) : CompilerIrFunctionList
  (CompilerIrFunctionList.Array
    (CompilerIrFunctionSeq
      (struct-get index values)
      (opt-function-index-count index))))

(define (opt-inline-slot-order [scc-result : OptSccResult]) : (Array i64)
  (let
    [order : (Array i64) (struct-get scc-result order)]
    [scc-of : (Array i64) (struct-get scc-result scc-of)]
    [slot-count : i64 (array-length scc-of)]
    [scc-count : i64 (array-length order)]
    [counts : (Array i64) (array.make-array i64 scc-count)]
    [starts : (Array i64) (array.make-array i64 scc-count)]
    [next : (Array i64) (array.make-array i64 scc-count)]
    [slots : (Array i64) (array.make-array i64 slot-count)]
    [slot : i64 0]
    [order-index : i64 0]
    [offset : i64 0]
    (begin
      (while (< slot slot-count)
        (let
          [scc-id : i64 (array-ref scc-of slot)]
          (begin
            (array-set! counts scc-id (+ (array-ref counts scc-id) 1))
            (set! slot (+ slot 1)))))
      (while (< order-index scc-count)
        (let
          [scc-id : i64 (array-ref order order-index)]
          (begin
            (array-set! starts scc-id offset)
            (array-set! next scc-id offset)
            (set! offset (+ offset (array-ref counts scc-id)))
            (set! order-index (+ order-index 1)))))
      (set! slot 0)
      (while (< slot slot-count)
        (let
          [scc-id : i64 (array-ref scc-of slot)]
          [slot-index : i64 (array-ref next scc-id)]
          (begin
            (array-set! slots slot-index slot)
            (array-set! next scc-id (+ slot-index 1))
            (set! slot (+ slot 1)))))
      slots)))

;; ---- opt1 tiny-leaf inlining -----------------------------------------------
;; The cheap level inlines only call-free single-block accessor callees whose
;; body holds at most opt-inline-tiny-leaf-max-body instructions before the
;; return. Call-free admission makes SCC ordering, census, and devirt
;; unnecessary: an admitted body contains no call sites, so it can never
;; change during the pass (one program walk in any order is confluent) and a
;; self-recursive callee can never be admitted. Splices reuse the level-2
;; single-block expansion, add no blocks, and keep SSA form, so no
;; reconstruction runs. Functions without an admitted call site are probed
;; read-only and returned untouched.
(define (opt-inline-tiny-leaf-max-body) : i64
  8)

(define (opt-inline-tiny-leaf-seq-call-free-from?
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]) : bool
  (if (>= pos count)
    true
    (match (compiler-ir-instr-seq-ref instrs pos)
      [(CompilerIrInstr.Call _ _ _ _) false]
      [(CompilerIrInstr.CallIndirect _ _ _ _) false]
      [(CompilerIrInstr.CallIndirectC _ _ _ _) false]
      [_ (opt-inline-tiny-leaf-seq-call-free-from? instrs (+ pos 1) count)])))

(define (opt-inline-tiny-leaf-blocks-call-free? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Cons block _)
      (match block
        [(CompilerIrBlock.Block _ seq)
          (opt-inline-tiny-leaf-seq-call-free-from?
            seq
            0
            (compiler-ir-instr-seq-count seq))])]
    [(CompilerIrBlockList.Array seq)
      (if (= (compiler-ir-block-seq-count seq) 1)
        (match (compiler-ir-block-seq-ref seq 0)
          [(CompilerIrBlock.Block _ instrs)
            (opt-inline-tiny-leaf-seq-call-free-from?
              instrs
              0
              (compiler-ir-instr-seq-count instrs))])
        false)]
    [_ false]))

(define (opt-inline-tiny-leaf-callee-ok? [callee : CompilerIrFunction]) : bool
  (match callee
    [(CompilerIrFunction.Function _ cparams _ cvars cblocks)
      (let
        [np : i64 (opt-inline-param-count cparams)]
        (and
          (opt-inline-params-sequential? cparams 0)
          (>= cvars np)
          (opt-inline-single-block-ok? cblocks np)
          (<=
            (opt-inline-single-block-cost-instrs cblocks)
            (opt-inline-tiny-leaf-max-body))
          (opt-inline-tiny-leaf-blocks-call-free? cblocks)))]))

(define (opt-inline-tiny-leaf-admitted-flags [index : OptFunctionIndex]) : (Array
    bool)
  (let
    [count : i64 (opt-function-index-count index)]
    [values : (Array CompilerIrFunction) (struct-get index values)]
    [flags : (Array bool)
      (make-array
        bool
        (if (> count 0)
          count
          1))]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set!
            flags
            i
            (opt-inline-tiny-leaf-callee-ok? (array-ref values i)))
          (set! i (+ i 1))))
      flags)))

(define (opt-inline-tiny-leaf-lookup
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [cname : i64]) : OptMaybeFunction
  (match (opt-function-index-slot index cname)
    [(option_i64.Some slot)
      (if (array-ref flags slot)
        (OptMaybeFunction.Some (array-ref (struct-get index values) slot))
        (OptMaybeFunction.No))]
    [(option_i64.None) (OptMaybeFunction.No)]))

(define (opt-inline-tiny-leaf-site?
  [instr : CompilerIrInstr]
  [index : OptFunctionIndex]
  [flags : (Array bool)]) : bool
  (match instr
    [(CompilerIrInstr.Call _ cname cargs _)
      (match (opt-inline-tiny-leaf-lookup index flags cname)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(CompilerIrFunction.Function _ cparams _ _ _)
              (opt-inline-arity-ok? cargs (opt-inline-param-count cparams))])]
        [(OptMaybeFunction.No) false])]
    [_ false]))

(define (opt-inline-tiny-leaf-seq-has-site-from?
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [index : OptFunctionIndex]
  [flags : (Array bool)]) : bool
  (if (>= pos count)
    false
    (if (opt-inline-tiny-leaf-site?
      (compiler-ir-instr-seq-ref instrs pos)
      index
      flags)
      true
      (opt-inline-tiny-leaf-seq-has-site-from?
        instrs
        (+ pos 1)
        count
        index
        flags))))

(define (opt-inline-tiny-leaf-seq-has-site?
  [instrs : CompilerIrInstrSeq]
  [index : OptFunctionIndex]
  [flags : (Array bool)]) : bool
  (opt-inline-tiny-leaf-seq-has-site-from?
    instrs
    0
    (compiler-ir-instr-seq-count instrs)
    index
    flags))

(define (opt-inline-tiny-leaf-block-has-site?
  [block : CompilerIrBlock]
  [index : OptFunctionIndex]
  [flags : (Array bool)]) : bool
  (match block
    [(CompilerIrBlock.Block _ seq)
      (opt-inline-tiny-leaf-seq-has-site? seq index flags)]))

(define (opt-inline-tiny-leaf-blocks-have-site?
  [blocks : CompilerIrBlockList]
  [index : OptFunctionIndex]
  [flags : (Array bool)]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (opt-inline-tiny-leaf-block-has-site? block index flags)
        true
        (opt-inline-tiny-leaf-blocks-have-site? (box-get rest) index flags))]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-tiny-leaf-block-seq-has-site? seq 0 index flags)]))

(define (opt-inline-tiny-leaf-block-seq-has-site?
  [blocks : CompilerIrBlockSeq]
  [pos : i64]
  [index : OptFunctionIndex]
  [flags : (Array bool)]) : bool
  (if (>= pos (compiler-ir-block-seq-count blocks))
    false
    (if (opt-inline-tiny-leaf-block-has-site?
      (compiler-ir-block-seq-ref blocks pos)
      index
      flags)
      true
      (opt-inline-tiny-leaf-block-seq-has-site? blocks (+ pos 1) index flags))))

(define (opt-inline-tiny-leaf-try
  [instr : CompilerIrInstr]
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]) : OptInlineState
  (match instr
    [(CompilerIrInstr.Call dst cname cargs cret)
      (match (opt-inline-tiny-leaf-lookup index flags cname)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(CompilerIrFunction.Function callee-name cparams _ cvars cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (begin
                    (set!
                      opt-inline-caller-site-count
                      (+ opt-inline-caller-site-count 1))
                    (OptInlineState.State
                      (opt-inline-expand-instrs
                        (opt-inline-single-block-instrs cblocks)
                        dst
                        cret
                        cargs
                        np
                        vars
                        (opt-inline-site-prefix
                          func-name
                          block-label
                          site-pos
                          callee-name))
                      (+ vars (opt-inline-frame-growth cvars np))
                      0))
                  (OptInlineState.State
                    (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)
                    vars
                    0)))])]
        [(OptMaybeFunction.No)
          (OptInlineState.State
            (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)
            vars
            0)])]
    [_
      (OptInlineState.State
        (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)
        vars
        0)]))

(define (opt-inline-tiny-leaf-walk-seq-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [end : i64]
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]) : OptInlineState
  (if (>= pos end)
    (OptInlineState.State CompilerIrInstrList.Nil vars 0)
    (match (opt-inline-tiny-leaf-try
      (compiler-ir-instr-seq-ref instrs pos)
      index
      flags
      func-name
      block-label
      site-pos
      vars)
      [(OptInlineState.State expanded vars2 _)
        (match (opt-inline-tiny-leaf-walk-seq-from
          instrs
          (+ pos 1)
          end
          index
          flags
          func-name
          block-label
          (+ site-pos 1)
          vars2)
          [(OptInlineState.State rest-list vars3 _)
            (OptInlineState.State
              (opt-inline-append expanded rest-list)
              vars3
              0)])])))

(define (opt-inline-tiny-leaf-rewrite-block
  [block : CompilerIrBlock]
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [func-name : i64]
  [vars : i64]) : OptInlineBlocks
  (match block
    [(CompilerIrBlock.Block label seq)
      (if (not (opt-inline-tiny-leaf-seq-has-site? seq index flags))
        (OptInlineBlocks.Blocks
          (compiler-ir-block-cons block CompilerIrBlockList.Nil)
          vars
          0)
        (match (opt-inline-tiny-leaf-walk-seq-from
          seq
          0
          (compiler-ir-instr-seq-count seq)
          index
          flags
          func-name
          label
          0
          vars)
          [(OptInlineState.State new-instrs vars2 _)
            (OptInlineBlocks.Blocks
              (compiler-ir-block-cons
                (compiler-ir-block label new-instrs)
                CompilerIrBlockList.Nil)
              vars2
              0)]))]))

(define (opt-inline-tiny-leaf-blocks
  [blocks : CompilerIrBlockList]
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [func-name : i64]
  [vars : i64]) : OptInlineBlocks
  (match blocks
    [(CompilerIrBlockList.Nil)
      (OptInlineBlocks.Blocks CompilerIrBlockList.Nil vars 0)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-inline-tiny-leaf-rewrite-block
        block
        index
        flags
        func-name
        vars)
        [(OptInlineBlocks.Blocks rewritten vars2 _)
          (match (opt-inline-tiny-leaf-blocks
            (box-get rest)
            index
            flags
            func-name
            vars2)
            [(OptInlineBlocks.Blocks rest-blocks vars3 _)
              (OptInlineBlocks.Blocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                0)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-tiny-leaf-blocks
        (compiler-ir-block-seq-to-list seq)
        index
        flags
        func-name
        vars)]))

(define (opt-inline-tiny-leaf-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [index : OptFunctionIndex]
  [flags : (Array bool)]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function name params ret vars blocks)
      (if (not (opt-inline-tiny-leaf-blocks-have-site? blocks index flags))
        func
        (begin
          (set! opt-inline-caller-site-count 0)
          (match (opt-inline-tiny-leaf-blocks blocks index flags name vars)
            [(OptInlineBlocks.Blocks new-blocks new-vars _)
              (if (= opt-inline-caller-site-count 0)
                func
                (opt-inline-repair-or-keep
                  type-segment-bases
                  func
                  (CompilerIrFunction.Function
                    name
                    params
                    ret
                    new-vars
                    new-blocks)
                  false))])))]))

(define (opt-inline-tiny-leaf-program-functions
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]) : CompilerIrFunctionList
  (let
    [index : OptFunctionIndex (opt-function-index-build functions)]
    [flags : (Array bool) (opt-inline-tiny-leaf-admitted-flags index)]
    [values : (Array CompilerIrFunction) (struct-get index values)]
    [count : i64 (opt-function-index-count index)]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set!
            values
            i
            (opt-inline-tiny-leaf-function
              type-segment-bases
              (array-ref values i)
              index
              flags))
          (set! i (+ i 1))))
      (opt-function-index-to-list index))))

(define (opt-inline-tiny-leaf-try-with-spans
  [instr : CompilerIrInstr]
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanState
  (match instr
    [(CompilerIrInstr.Call dst cname cargs cret)
      (match (opt-inline-tiny-leaf-lookup index flags cname)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(CompilerIrFunction.Function callee-name cparams _ cvars cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (begin
                    (set!
                      opt-inline-caller-site-count
                      (+ opt-inline-caller-site-count 1))
                    (match (opt-inline-expand-instrs-with-spans
                      (opt-inline-single-block-instrs cblocks)
                      dst
                      cret
                      cargs
                      np
                      vars
                      (opt-inline-site-prefix
                        func-name
                        block-label
                        site-pos
                        callee-name)
                      source-spans
                      out-spans
                      func-name
                      instr
                      cname)
                      [(OptInlineSpanState.State expanded _ _ next-spans)
                        (OptInlineSpanState.State
                          expanded
                          (+ vars (opt-inline-frame-growth cvars np))
                          0
                          next-spans)]))
                  (OptInlineSpanState.State
                    (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)
                    vars
                    0
                    out-spans)))])]
        [(OptMaybeFunction.No)
          (OptInlineSpanState.State
            (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)
            vars
            0
            out-spans)])]
    [_
      (OptInlineSpanState.State
        (compiler-ir-instr-cons instr CompilerIrInstrList.Nil)
        vars
        0
        out-spans)]))

(define (opt-inline-tiny-leaf-walk-seq-with-spans-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [end : i64]
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanState
  (if (>= pos end)
    (OptInlineSpanState.State CompilerIrInstrList.Nil vars 0 out-spans)
    (match (opt-inline-tiny-leaf-try-with-spans
      (compiler-ir-instr-seq-ref instrs pos)
      index
      flags
      func-name
      block-label
      site-pos
      vars
      source-spans
      out-spans)
      [(OptInlineSpanState.State expanded vars2 _ spans2)
        (match (opt-inline-tiny-leaf-walk-seq-with-spans-from
          instrs
          (+ pos 1)
          end
          index
          flags
          func-name
          block-label
          (+ site-pos 1)
          vars2
          source-spans
          spans2)
          [(OptInlineSpanState.State rest-list vars3 _ spans3)
            (OptInlineSpanState.State
              (opt-inline-append expanded rest-list)
              vars3
              0
              spans3)])])))

(define (opt-inline-tiny-leaf-rewrite-block-with-spans
  [block : CompilerIrBlock]
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [func-name : i64]
  [vars : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanBlocks
  (match block
    [(CompilerIrBlock.Block label seq)
      (if (not (opt-inline-tiny-leaf-seq-has-site? seq index flags))
        (OptInlineSpanBlocks.Blocks
          (compiler-ir-block-cons block CompilerIrBlockList.Nil)
          vars
          0
          out-spans)
        (match (opt-inline-tiny-leaf-walk-seq-with-spans-from
          seq
          0
          (compiler-ir-instr-seq-count seq)
          index
          flags
          func-name
          label
          0
          vars
          source-spans
          out-spans)
          [(OptInlineSpanState.State new-instrs vars2 _ spans2)
            (OptInlineSpanBlocks.Blocks
              (compiler-ir-block-cons
                (compiler-ir-block label new-instrs)
                CompilerIrBlockList.Nil)
              vars2
              0
              spans2)]))]))

(define (opt-inline-tiny-leaf-blocks-with-spans
  [blocks : CompilerIrBlockList]
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [func-name : i64]
  [vars : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanBlocks
  (match blocks
    [(CompilerIrBlockList.Nil)
      (OptInlineSpanBlocks.Blocks CompilerIrBlockList.Nil vars 0 out-spans)]
    [(CompilerIrBlockList.Cons block rest)
      (match (opt-inline-tiny-leaf-rewrite-block-with-spans
        block
        index
        flags
        func-name
        vars
        source-spans
        out-spans)
        [(OptInlineSpanBlocks.Blocks rewritten vars2 _ spans2)
          (match (opt-inline-tiny-leaf-blocks-with-spans
            (box-get rest)
            index
            flags
            func-name
            vars2
            source-spans
            spans2)
            [(OptInlineSpanBlocks.Blocks rest-blocks vars3 _ spans3)
              (OptInlineSpanBlocks.Blocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                0
                spans3)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-inline-tiny-leaf-blocks-with-spans
        (compiler-ir-block-seq-to-list seq)
        index
        flags
        func-name
        vars
        source-spans
        out-spans)]))

(define (opt-inline-tiny-leaf-function-with-spans
  [func : CompilerIrFunction]
  [index : OptFunctionIndex]
  [flags : (Array bool)]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanProgram
  (match func
    [(CompilerIrFunction.Function name params ret vars blocks)
      (if (not (opt-inline-tiny-leaf-blocks-have-site? blocks index flags))
        (OptInlineSpanProgram.Program
          (compiler-ir-function-cons func CompilerIrFunctionList.Nil)
          out-spans)
        (begin
          (set! opt-inline-caller-site-count 0)
          (match (opt-inline-tiny-leaf-blocks-with-spans
            blocks
            index
            flags
            name
            vars
            source-spans
            out-spans)
            [(OptInlineSpanBlocks.Blocks new-blocks new-vars _ next-spans)
              (if (= opt-inline-caller-site-count 0)
                (OptInlineSpanProgram.Program
                  (compiler-ir-function-cons func CompilerIrFunctionList.Nil)
                  out-spans)
                (if (opt-inline-structure-ok-reclaiming? new-blocks)
                  (OptInlineSpanProgram.Program
                    (compiler-ir-function-cons
                      (CompilerIrFunction.Function
                        name
                        params
                        ret
                        new-vars
                        new-blocks)
                      CompilerIrFunctionList.Nil)
                    next-spans)
                  (OptInlineSpanProgram.Program
                    (compiler-ir-function-cons func CompilerIrFunctionList.Nil)
                    out-spans)))])))]))

(define (opt-inline-tiny-leaf-program-functions-with-spans
  [functions : CompilerIrFunctionList]
  [spans : CompilerSourceSpans]) : OptInlineSpanProgram
  (let
    [index : OptFunctionIndex (opt-function-index-build functions)]
    [flags : (Array bool) (opt-inline-tiny-leaf-admitted-flags index)]
    [values : (Array CompilerIrFunction) (struct-get index values)]
    [count : i64 (opt-function-index-count index)]
    [i : i64 0]
    [current-spans : CompilerSourceSpans spans]
    (begin
      (while (< i count)
        (begin
          (match (opt-inline-tiny-leaf-function-with-spans
            (array-ref values i)
            index
            flags
            current-spans
            current-spans)
            [(OptInlineSpanProgram.Program one next-spans)
              (begin
                (match one
                  [(CompilerIrFunctionList.Cons head _)
                    (array-set! values i head)]
                  [(CompilerIrFunctionList.Nil) unit]
                  [(CompilerIrFunctionList.Array seq)
                    (if (> (compiler-ir-function-seq-count seq) 0)
                      (array-set! values i (compiler-ir-function-seq-ref seq 0))
                      unit)])
                (set! current-spans next-spans))])
          (set! i (+ i 1))))
      (OptInlineSpanProgram.Program
        (opt-function-index-to-list index)
        current-spans))))

(define (opt-inline-process-scc-order!
  [type-segment-bases : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]) : unit
  (let
    [scc-of : (Array i64) (struct-get scc-result scc-of)]
    [values : (Array CompilerIrFunction) (struct-get index values)]
    [slot-order : (Array i64) (opt-inline-slot-order scc-result)]
    [index-pos : i64 0]
    [slot-count : i64 (array-length slot-order)]
    (while (< index-pos slot-count)
      (begin
        (let
          [slot : i64 (array-ref slot-order index-pos)]
          [caller-scc : i64 (array-ref scc-of slot)]
          (array-set!
            values
            slot
            (opt-inline-function
              type-segment-bases
              (array-ref values slot)
              index
              census
              scc-result
              caller-scc)))
        (set! index-pos (+ index-pos 1))))))

(define (opt-inline-process-scc-order-with-spans
  [type-segment-bases : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [spans : CompilerSourceSpans]) : CompilerSourceSpans
  (let
    [scc-of : (Array i64) (struct-get scc-result scc-of)]
    [values : (Array CompilerIrFunction) (struct-get index values)]
    [slot-order : (Array i64) (opt-inline-slot-order scc-result)]
    [index-pos : i64 0]
    [slot-count : i64 (array-length slot-order)]
    [current-spans : CompilerSourceSpans spans]
    (begin
      (while (< index-pos slot-count)
        (begin
          (let
            [slot : i64 (array-ref slot-order index-pos)]
            [caller-scc : i64 (array-ref scc-of slot)]
            (match (opt-inline-function-with-spans
              type-segment-bases
              (array-ref values slot)
              index
              census
              scc-result
              caller-scc
              current-spans
              current-spans)
              [(OptInlineSpanProgram.Program one next-spans)
                (begin
                  (match one
                    [(CompilerIrFunctionList.Cons head _)
                      (array-set! values slot head)]
                    [(CompilerIrFunctionList.Nil) unit]
                    [(CompilerIrFunctionList.Array seq)
                      (if (> (compiler-ir-function-seq-count seq) 0)
                        (array-set!
                          values
                          slot
                          (compiler-ir-function-seq-ref seq 0))
                        unit)])
                  (set! current-spans next-spans))]))
          (set! index-pos (+ index-pos 1))))
      current-spans)))

;; Inline small single-block leaf callees across the whole program. Level 2
;; (the register-allocated quality build) runs the full census/SCC pipeline;
;; level 1 runs only the call-free tiny-leaf pass above.
(define (opt-inline-program-functions
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]
  [level : i64]) : CompilerIrFunctionList
  (if (< level 2)
    (if (= level 1)
      (opt-inline-tiny-leaf-program-functions type-segment-bases functions)
      functions)
    (let
      [devirt : CompilerIrFunctionList
        (opt-devirt-known-function-list functions)]
      [index : OptFunctionIndex (opt-function-index-build devirt)]
      [graph : OptCallGraph (opt-callgraph-build index)]
      [scc-result : OptSccResult (opt-scc-compute graph)]
      [census : OptInlineCensus (opt-inline-census-build index devirt)]
      [verify-scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! opt-inline-verify-scratch-arena verify-scratch)
        (opt-inline-multiblock-ok-memo-install! index)
        (opt-inline-process-scc-order!
          type-segment-bases
          index
          census
          scc-result)
        (let
          [out : CompilerIrFunctionList (opt-function-index-to-list index)]
          [scratch-head : i64 opt-inline-verify-scratch-arena]
          (begin
            (set! opt-inline-verify-scratch-arena 0)
            (opt-inline-multiblock-ok-memo-reset!)
            (unsafe
              (arena.tl_arena_destroy scratch-head))
            out))))))

(define (opt-inline-program-functions-with-spans
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]
  [level : i64]
  [spans : CompilerSourceSpans]) : OptInlineSpanProgram
  (if (< level 2)
    (if (= level 1)
      (opt-inline-tiny-leaf-program-functions-with-spans functions spans)
      (OptInlineSpanProgram.Program functions spans))
    (let
      [devirt : CompilerIrFunctionList
        (opt-devirt-known-function-list functions)]
      [index : OptFunctionIndex (opt-function-index-build devirt)]
      [graph : OptCallGraph (opt-callgraph-build index)]
      [scc-result : OptSccResult (opt-scc-compute graph)]
      [census : OptInlineCensus (opt-inline-census-build index devirt)]
      [verify-scratch : i64 (arena.tl_arena_make)]
      [_install-verify-scratch : unit
        (set! opt-inline-verify-scratch-arena verify-scratch)]
      [_install-multiblock-memo : unit
        (opt-inline-multiblock-ok-memo-install! index)]
      [next-spans : CompilerSourceSpans
        (opt-inline-process-scc-order-with-spans
          type-segment-bases
          index
          census
          scc-result
          spans)]
      [out : OptInlineSpanProgram
        (OptInlineSpanProgram.Program
          (opt-function-index-to-list index)
          next-spans)]
      [scratch-head : i64 opt-inline-verify-scratch-arena]
      (begin
        (set! opt-inline-verify-scratch-arena 0)
        (opt-inline-multiblock-ok-memo-reset!)
        (unsafe
          (arena.tl_arena_destroy scratch-head))
        out))))

(define (opt-function-list-defines?
  [functions : CompilerIrFunctionList]
  [name : String]) : bool
  (match functions
    [(CompilerIrFunctionList.Nil) false]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function func-name _ _ _ _)
          (if (string.eq (compiler-ir-symbol-text func-name) name)
            true
            (opt-function-list-defines? (box-get rest) name))])]
    [(CompilerIrFunctionList.Array seq)
      (opt-function-list-defines? (compiler-ir-function-seq-to-list seq) name)]))

(define (opt-function-list-find
  [functions : CompilerIrFunctionList]
  [name : String]) : OptMaybeFunction
  (match functions
    [(CompilerIrFunctionList.Nil) (OptMaybeFunction.No)]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function func-name _ _ _ _)
          (if (string.eq (compiler-ir-symbol-text func-name) name)
            (OptMaybeFunction.Some func)
            (opt-function-list-find (box-get rest) name))])]
    [(CompilerIrFunctionList.Array seq)
      (opt-function-list-find (compiler-ir-function-seq-to-list seq) name)]))

;; Resolve `name` to its dense index slot with a single `ids` probe (the one
;; name->key lookup the reachability walk needs); a name that names no function in
;; this index is a no-op. The reachable set and worklist then key on that slot, so
;; the dedup, membership, and pop-and-resolve are i64 compares -- no per-edge
;; string_eq, and no global intern-table mutation (IR names are transient-arena
;; strings, so interning them would dangle a table pointer after the rewind).
(define (opt-reach-add-function
  [index : OptFunctionIndex]
  [state : OptReachState]
  [name : i64]) : OptReachState
  (match (opt-function-index-slot index name)
    [(option_i64.None) state]
    [(option_i64.Some slot) (opt-reach-add-function-slot state slot)]))

(define (opt-reach-add-function-slot [state : OptReachState] [slot : i64]) : OptReachState
  (match state
    [(OptReachState.State reachable worklist globals runtime-helper-mask)
      (if (opt_i64_i64_map.contains? (& reachable) slot)
        state
        (let
          [next-reachable : opt_i64_i64_map.Map reachable]
          (begin
            (opt_i64_i64_map.insert-ref! (&mut next-reachable) slot 1)
            (OptReachState.State
              next-reachable
              (OptReachWorklist.Cons slot (box worklist))
              globals
              runtime-helper-mask))))]))

(define (opt-reach-add-global [state : OptReachState] [name : i64]) : OptReachState
  (match state
    [(OptReachState.State reachable worklist globals runtime-helper-mask)
      (let
        [name-id : i64 (compiler-ir-symbol-id name)]
        (if (or (< name-id 0) (opt_i64_i64_map.contains? (& globals) name-id))
          state
          (begin
            (opt_i64_i64_map.insert-ref! (&mut globals) name-id 1)
            (OptReachState.State reachable worklist globals runtime-helper-mask))))]))

(define (opt-reach-add-function-leaf-from
  [index : OptFunctionIndex]
  [state : OptReachState]
  [leaf : String]
  [slot : i64]
  [count : i64]) : OptReachState
  (if (>= slot count)
    state
    (match (array-ref (struct-get index values) slot)
      [(CompilerIrFunction.Function name _ _ _ _)
        (opt-reach-add-function-leaf-from
          index
          (if (opt-symbol-leaf-matches-from?
            (compiler-ir-symbol-text name)
            (array-ref (struct-get index leaf-starts) slot)
            leaf)
            (opt-reach-add-function index state name)
            state)
          leaf
          (+ slot 1)
          count)])))

(define (opt-reach-add-function-leaf
  [index : OptFunctionIndex]
  [state : OptReachState]
  [leaf : String]) : OptReachState
  (opt-reach-add-function-leaf-from
    index
    state
    leaf
    0
    (opt-function-index-count index)))

(define (opt-runtime-prelude-string-helper [source-name : String]) : OptRuntimeStringHelper
  (let
    [start : i64 (opt-symbol-leaf-start source-name)]
    [n : i64 (string.string-length source-name)]
    ;; Cheap gate: every prelude helper leaf starts with "tl_" -- reject the
    ;; overwhelming majority of call targets with three char compares before
    ;; the exact per-name checks (all allocation-free).
    (if (or
      (< (- n start) 3)
      (not (= (string.string-ref source-name start) 't'))
      (not (= (string.string-ref source-name (+ start 1)) 'l'))
      (not (= (string.string-ref source-name (+ start 2)) '_')))
      (OptRuntimeStringHelper.No)
      (cond
        [(opt-symbol-leaf-matches-from? source-name start "tl_int_to_string")
          (OptRuntimeStringHelper.Some "int-to-string" 1)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_substring")
          (OptRuntimeStringHelper.Some "substring" 2)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_str_view")
          (OptRuntimeStringHelper.Some "str-view" 4)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_string_concat")
          (OptRuntimeStringHelper.Some "string-concat" 8)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_string_concat3")
          (OptRuntimeStringHelper.Some "string-concat3" 16)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_string_concat4")
          (OptRuntimeStringHelper.Some "string-concat4" 32)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_string_concat5")
          (OptRuntimeStringHelper.Some "string-concat5" 64)]
        [else (OptRuntimeStringHelper.No)]))))

(define (opt-reach-add-runtime-prelude-string-helper
  [index : OptFunctionIndex]
  [state : OptReachState]
  [source-name : String]) : OptReachState
  (match (opt-runtime-prelude-string-helper source-name)
    [(OptRuntimeStringHelper.No) state]
    [(OptRuntimeStringHelper.Some helper helper-bit)
      (match state
        [(OptReachState.State _ _ _ runtime-helper-mask)
          (if (not (= (bit-and runtime-helper-mask helper-bit) 0))
            state
            ;; A self-compile contains hundreds of calls to these helpers. The
            ;; leaf scan retains every source-path spelling, but only needs to run
            ;; once per fixed runtime helper.
            (match (opt-reach-add-function-leaf index state helper)
              [(OptReachState.State reachable worklist globals mask)
                (OptReachState.State
                  reachable
                  worklist
                  globals
                  (bit-or mask helper-bit))]))])]))

(define (opt-reach-add-call-target
  [index : OptFunctionIndex]
  [state : OptReachState]
  [name : i64]) : OptReachState
  (opt-reach-add-runtime-prelude-string-helper
    index
    (opt-reach-add-function index state name)
    (compiler-ir-symbol-text name)))

(define (opt-reach-value
  [index : OptFunctionIndex]
  [state : OptReachState]
  [value : CompilerIrValue]) : OptReachState
  (match value
    [(CompilerIrValue.Global name)
      (opt-reach-add-function index (opt-reach-add-global state name) name)]
    [(CompilerIrValue.GlobalAddr name)
      (opt-reach-add-function index (opt-reach-add-global state name) name)]
    [(CompilerIrValue.Function name) (opt-reach-add-function index state name)]
    [(CompilerIrValue.RuntimeGlobal init)
      (opt-reach-add-function index state init)]
    [_ state]))

(define (opt-reach-call-args-array
  [index : OptFunctionIndex]
  [state : OptReachState]
  [values : (Array CompilerIrValue)]
  [arg-index : i64]) : OptReachState
  (if (>= arg-index (array-length values))
    state
    (opt-reach-call-args-array
      index
      (opt-reach-value index state (array-ref values arg-index))
      values
      (+ arg-index 1))))

(define (opt-reach-call-args
  [index : OptFunctionIndex]
  [state : OptReachState]
  [args : CompilerIrCallArgs]) : OptReachState
  (match args
    [(CompilerIrCallArgs.Nil) state]
    [(CompilerIrCallArgs.One value) (opt-reach-value index state value)]
    [(CompilerIrCallArgs.Two a b)
      (opt-reach-value index (opt-reach-value index state a) b)]
    [(CompilerIrCallArgs.Array values)
      (opt-reach-call-args-array index state values 0)]))

(define (opt-reach-spmd-call-args
  [index : OptFunctionIndex]
  [state : OptReachState]
  [args : CompilerIrSpmdCallArgList]) : OptReachState
  (match args
    [(CompilerIrSpmdCallArgList.Nil) state]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (opt-reach-spmd-call-args
            index
            (opt-reach-value index state value)
            (box-get rest))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : OptReachState state]
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (opt-reach-value index out value))])
              (set! i (+ i 1))))
          out))]))

(define (opt-reach-maybe-value
  [index : OptFunctionIndex]
  [state : OptReachState]
  [maybe : CompilerIrMaybeValue]) : OptReachState
  (match maybe
    [(CompilerIrMaybeValue.No) state]
    [(CompilerIrMaybeValue.Some value) (opt-reach-value index state value)]))

(define (opt-reach-phi-inputs
  [index : OptFunctionIndex]
  [state : OptReachState]
  [inputs : CompilerIrPhiInputList]) : OptReachState
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) state]
    [(CompilerIrPhiInputList.Array seq)
      (opt-reach-phi-inputs index state (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (opt-reach-phi-inputs
        index
        (opt-reach-value index state value)
        (box-get rest))]))

(define (opt-reach-instr
  [index : OptFunctionIndex]
  [state : OptReachState]
  [instr : CompilerIrInstr]) : OptReachState
  (match instr
    [(CompilerIrInstr.Mov _ src _) (opt-reach-value index state src)]
    [(CompilerIrInstr.Alloc _ _) state]
    [(CompilerIrInstr.AddrOf _ _) state]
    [(CompilerIrInstr.Gep _ base offset _)
      (opt-reach-value index (opt-reach-value index state base) offset)]
    [(CompilerIrInstr.Load _ src _) (opt-reach-value index state src)]
    [(CompilerIrInstr.StorePtr dst src _)
      (opt-reach-value index (opt-reach-value index state dst) src)]
    [(CompilerIrInstr.CopyBytes dst src _)
      (opt-reach-value index (opt-reach-value index state dst) src)]
    [(CompilerIrInstr.BoundsCheck idx length _)
      (opt-reach-value index (opt-reach-value index state idx) length)]
    [(CompilerIrInstr.Cast _ src _ _) (opt-reach-value index state src)]
    [(CompilerIrInstr.Bitcast _ src _ _) (opt-reach-value index state src)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (opt-reach-value index (opt-reach-value index state lhs) rhs)]
    [(CompilerIrInstr.UnOp _ _ src _) (opt-reach-value index state src)]
    [(CompilerIrInstr.LaneId _ _ _) state]
    [(CompilerIrInstr.Splat _ value _ _) (opt-reach-value index state value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (opt-reach-value index (opt-reach-value index state lhs) rhs)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (opt-reach-value index (opt-reach-value index state src) carry)])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-reach-value index state src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (opt-reach-value index (opt-reach-value index state lhs) rhs)])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-reach-value index (opt-reach-value index state lhs) rhs)]
    [(CompilerIrInstr.MaskNot _ src _) (opt-reach-value index state src)]
    [(CompilerIrInstr.MaskReduce _ _ src _) (opt-reach-value index state src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (opt-reach-value
            index
            (opt-reach-value index (opt-reach-value index state mask) on-true)
            on-false)])]
    [(CompilerIrInstr.VectorLoad _ base idx _ _)
      (opt-reach-value index (opt-reach-value index state base) idx)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base idx value _ _)
          (opt-reach-value
            index
            (opt-reach-value index (opt-reach-value index state base) idx)
            value)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload base idx value mask _ _)
          (opt-reach-value
            index
            (opt-reach-value
              index
              (opt-reach-value index (opt-reach-value index state base) idx)
              value)
            mask)])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base idx mask _ _)
          (opt-reach-value
            index
            (opt-reach-value index (opt-reach-value index state base) idx)
            mask)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload _ base index-base idx _ _ _)
          (opt-reach-value
            index
            (opt-reach-value
              index
              (opt-reach-value index state base)
              index-base)
            idx)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (opt-reach-value
            index
            (opt-reach-maybe-value
              index
              (opt-reach-value
                index
                (opt-reach-value index state source)
                selector-low)
              selector-high)
            active-lanes)])]
    [(CompilerIrInstr.TailMask _ idx length _)
      (opt-reach-value index (opt-reach-value index state idx) length)]
    [(CompilerIrInstr.EntryArgc _) state]
    [(CompilerIrInstr.EntryArgv _) state]
    [(CompilerIrInstr.EntryEnvp _) state]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-reach-value index (opt-reach-value index state leaf) subleaf)]
    [(CompilerIrInstr.Xgetbv _ idx) (opt-reach-value index state idx)]
    [(CompilerIrInstr.Syscall _ args) (opt-reach-call-args index state args)]
    [(CompilerIrInstr.Call _ name args _)
      (opt-reach-add-call-target
        index
        (opt-reach-call-args index state args)
        name)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base name args _)
          (opt-reach-add-call-target
            index
            (opt-reach-call-args index (opt-reach-value index state base) args)
            name)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload name _ _ active-mask args _)
          (opt-reach-add-call-target
            index
            (opt-reach-spmd-call-args
              index
              (opt-reach-value index state active-mask)
              args)
            name)])]
    [(CompilerIrInstr.CallIndirect _ func args _)
      (opt-reach-call-args index (opt-reach-value index state func) args)]
    [(CompilerIrInstr.CallIndirectC _ func args _)
      (opt-reach-call-args index (opt-reach-value index state func) args)]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            _)
          (opt-reach-call-args
            index
            (opt-reach-value index (opt-reach-value index state base) func)
            args)])]
    [(CompilerIrInstr.TailCall name args _)
      (opt-reach-add-call-target
        index
        (opt-reach-call-args index state args)
        name)]
    [(CompilerIrInstr.Store name value _)
      (opt-reach-value index (opt-reach-add-global state name) value)]
    [(CompilerIrInstr.Jump _) state]
    [(CompilerIrInstr.Branch cond _ _) (opt-reach-value index state cond)]
    [(CompilerIrInstr.Return maybe) (opt-reach-maybe-value index state maybe)]
    [(CompilerIrInstr.Phi _ inputs _) (opt-reach-phi-inputs index state inputs)]
    ;; Register-group ops carry word-class scalar operands (vars/consts);
    ;; lowering materializes any global/function reference into a var before
    ;; packing, so the group operands themselves reach nothing new.
    [(CompilerIrInstr.Pack _ _ _) state]
    [(CompilerIrInstr.Word _ src _ _) (opt-reach-value index state src)]
    [(CompilerIrInstr.TailCallIndirect func args _)
      (opt-reach-call-args index (opt-reach-value index state func) args)]
    [(CompilerIrInstr.Switch idx _ _ _) (opt-reach-value index state idx)]))

(define (opt-reach-instr-seq-from
  [index : OptFunctionIndex]
  [state : OptReachState]
  [slots : (Array CompilerIrInstr)]
  [instr-index : i64]
  [count : i64]) : OptReachState
  (if (>= instr-index count)
    state
    (opt-reach-instr-seq-from
      index
      (opt-reach-instr index state (array-ref slots instr-index))
      slots
      (+ instr-index 1)
      count)))

(define (opt-reach-instr-seq
  [index : OptFunctionIndex]
  [state : OptReachState]
  [instrs : CompilerIrInstrSeq]) : OptReachState
  (opt-reach-instr-seq-from
    index
    state
    (struct-get instrs slots)
    0
    (struct-get instrs len)))

(define (opt-reach-blocks
  [index : OptFunctionIndex]
  [state : OptReachState]
  [blocks : CompilerIrBlockList]) : OptReachState
  (match blocks
    [(CompilerIrBlockList.Nil) state]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-reach-blocks
            index
            (opt-reach-instr-seq index state instrs)
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (opt-reach-blocks index state (compiler-ir-block-seq-to-list seq))]))

(define (opt-reach-function
  [index : OptFunctionIndex]
  [state : OptReachState]
  [func : CompilerIrFunction]) : OptReachState
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-reach-blocks index state blocks)]))

(define (opt-reach-process [index : OptFunctionIndex] [state : OptReachState]) : OptReachState
  (match state
    [(OptReachState.State reachable worklist globals runtime-helper-mask)
      (match worklist
        [(OptReachWorklist.Nil) state]
        [(OptReachWorklist.Cons slot rest)
          (let
            [popped : OptReachState
              (OptReachState.State
                reachable
                (box-get rest)
                globals
                runtime-helper-mask)]
            (opt-reach-process
              index
              (opt-reach-function
                index
                popped
                (opt-function-index-at-slot index slot))))])]))

(define (opt-reach-global
  [index : OptFunctionIndex]
  [state : OptReachState]
  [global : CompilerIrGlobal]) : OptReachState
  (match global
    [(CompilerIrGlobal.Global name _ value)
      ;; A global with a non-constant initializer is set up before main by a
      ;; generated `__global_init_<name>` function that the backend calls from
      ;; the startup sequence; it is NOT referenced from the global's IR value,
      ;; so it must be added as a reachability root or the prune drops its
      ;; definition (unresolved-symbol link failure). opt-reach-add-function
      ;; no-ops when the function does not exist (constant-initialized globals).
      (opt-reach-value index state value)]))

(define (opt-reach-globals
  [index : OptFunctionIndex]
  [state : OptReachState]
  [globals : CompilerIrGlobalList]) : OptReachState
  (match globals
    [(CompilerIrGlobalList.Nil) state]
    [(CompilerIrGlobalList.Cons global rest)
      (opt-reach-globals
        index
        (opt-reach-global index state global)
        (box-get rest))]
    [(CompilerIrGlobalList.Array seq) (opt-reach-global-seq index state seq 0)]))

(define (opt-reach-global-seq
  [index : OptFunctionIndex]
  [state : OptReachState]
  [globals : CompilerIrGlobalSeq]
  [seq-index : i64]) : OptReachState
  (if (>= seq-index (compiler-ir-global-seq-count globals))
    state
    (opt-reach-global-seq
      index
      (opt-reach-global
        index
        state
        (compiler-ir-global-seq-ref globals seq-index))
      globals
      (+ seq-index 1))))

;; `reachable` is keyed by dense index slot; resolve each function's slot through
;; the index (the same name->slot map the reach walk used) and test membership.
(define (opt-reach-slot-set-contains-name?
  [index : OptFunctionIndex]
  [reachable : opt_i64_i64_map.Map]
  [name : i64]) : bool
  (match (opt-function-index-slot index name)
    [(option_i64.None) false]
    [(option_i64.Some slot) (opt_i64_i64_map.contains? (& reachable) slot)]))

(define (opt-filter-reachable-functions
  [index : OptFunctionIndex]
  [functions : CompilerIrFunctionList]
  [reachable : opt_i64_i64_map.Map]) : CompilerIrFunctionList
  (match functions
    [(CompilerIrFunctionList.Nil) (CompilerIrFunctionList.Nil)]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ _)
          (if (opt-reach-slot-set-contains-name? index reachable name)
            (compiler-ir-function-cons
              func
              (opt-filter-reachable-functions index (box-get rest) reachable))
            (opt-filter-reachable-functions index (box-get rest) reachable))])]
    [(CompilerIrFunctionList.Array seq)
      (compiler-ir-function-list-compact
        (opt-filter-reachable-functions
          index
          (compiler-ir-function-seq-to-list seq)
          reachable))]))

(define (opt-runtime-global? [ty : AstType] [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Unit)
      (match ty
        [(AstType.Unit) false]
        [_ true])]
    [_ false]))

(define (opt-filter-reachable-globals
  [globals : CompilerIrGlobalList]
  [reachable : opt_i64_i64_map.Map]) : CompilerIrGlobalList
  (match globals
    [(CompilerIrGlobalList.Nil) (CompilerIrGlobalList.Nil)]
    [(CompilerIrGlobalList.Cons global rest)
      (match global
        [(CompilerIrGlobal.Global name ty value)
          (if (or
            (opt-runtime-global? ty value)
            (opt_i64_i64_map.contains?
              (& reachable)
              (compiler-ir-symbol-id name)))
            (compiler-ir-global-cons
              global
              (opt-filter-reachable-globals (box-get rest) reachable))
            (opt-filter-reachable-globals (box-get rest) reachable))])]
    [(CompilerIrGlobalList.Array seq)
      (compiler-ir-global-list-compact-reversed
        (compiler-ir-global-list-reverse-onto
          (opt-filter-reachable-globals
            (compiler-ir-global-seq-to-list seq)
            reachable)
          CompilerIrGlobalList.Nil))]))

;; Exported functions are lowered to a `provided` CompilerIrExtern.Extern whose name
;; is the function's logical name. Such functions may be called only from outside
;; TypeLisp IR (e.g. the backend-emitted bounds/division/shift checks call the
;; runtime-prelude handlers), so seed them as roots for the function-level DCE.
(define (opt-reach-add-provided-externs
  [index : OptFunctionIndex]
  [externs : CompilerIrExternList]
  [state : OptReachState]) : OptReachState
  (match externs
    [(CompilerIrExternList.Nil) state]
    [(CompilerIrExternList.Cons ext rest)
      (match ext
        [(CompilerIrExtern.Extern name-id _ _ _ _ _ _ provided)
          (opt-reach-add-provided-externs
            index
            (box-get rest)
            (if provided
              (match (opt-function-index-slot-id index name-id)
                [(option_i64.Some slot)
                  (opt-reach-add-function-slot state slot)]
                [(option_i64.None) (opt-reach-add-function index state name-id)])
              state))])]
    [(CompilerIrExternList.Array seq)
      (opt-reach-add-provided-extern-seq index seq state 0)]))

(define (opt-reach-add-provided-extern-seq
  [index : OptFunctionIndex]
  [externs : CompilerIrExternSeq]
  [state : OptReachState]
  [seq-index : i64]) : OptReachState
  (if (>= seq-index (compiler-ir-extern-seq-count externs))
    state
    (match (compiler-ir-extern-seq-ref externs seq-index)
      [(CompilerIrExtern.Extern name-id _ _ _ _ _ _ provided)
        (opt-reach-add-provided-extern-seq
          index
          externs
          (if provided
            (match (opt-function-index-slot-id index name-id)
              [(option_i64.Some slot) (opt-reach-add-function-slot state slot)]
              [(option_i64.None) (opt-reach-add-function index state name-id)])
            state)
          (+ seq-index 1))])))

;; Return the byte offset just past the last '/' or ':' separator in `name`
;; (0 when there is none). Scanning backward from the end stops at the final
;; separator instead of walking the whole string, and reading the raw String
;; bytes skips the per-char bounds check of `string.string-ref`. Function names
;; are classified once when the reachability index is built; standalone call
;; targets classify once before all of their fixed helper-name checks.
(define (opt-symbol-leaf-start [name : String]) : i64
  (let
    [n : i64 (string.string-length name)]
    [data : (Ptr u8)
      (unsafe
        (string-data name))]
    [i : i64 (- n 1)]
    [start : i64 0]
    [done : bool false]
    (begin
      (while (if done
        false
        (>= i 0))
        (let
          ;; '/' = 47, ':' = 58
          [b : i64
            (unsafe
              (cast (ptr-read (ptr-offset data i)) : i64))]
          (if (if (= b 47)
            true
            (= b 58))
            (begin
              (set! start (+ i 1))
              (set! done true))
            (set! i (- i 1)))))
      start)))

;; Compare a leaf using a start already classified by the function index or by
;; the caller. The reachability pass checks the same indexed names for several
;; runtime helpers, so rescanning each name for its last separator dominated the
;; actual byte comparison.
(define (opt-symbol-leaf-matches-from?
  [name : String]
  [start : i64]
  [leaf : String]) : bool
  (let
    [n : i64 (string.string-length name)]
    [leaf-len : i64 (string.string-length leaf)]
    (if (not (= (- n start) leaf-len))
      false
      (let
        [name-data : (Ptr u8)
          (unsafe
            (string-data name))]
        [leaf-data : (Ptr u8)
          (unsafe
            (string-data leaf))]
        [ok : bool true]
        [i : i64 0]
        (begin
          (while (if ok
            (< i leaf-len)
            false)
            (if (=
              (unsafe
                (ptr-read (ptr-offset name-data (+ start i))))
              (unsafe
                (ptr-read (ptr-offset leaf-data i))))
              (set! i (+ i 1))
              (set! ok false)))
          ok)))))

;; Allocation-free equivalent of (string.eq (opt-symbol-leaf name) leaf) for
;; standalone callers that do not already have a classified start.
(define (opt-prune-unreachable-program
  [globals : CompilerIrGlobalList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]) : OptPrunedProgram
  (if (opt-function-list-defines? functions "main")
    (let
      [index : OptFunctionIndex (opt-function-index-build functions)]
      [reachable : opt_i64_i64_map.Map
        (opt_i64_i64_map.with-capacity
          (opt-function-index-capacity (opt-function-list-count functions)))]
      [reachable-globals : opt_i64_i64_map.Map
        (opt_i64_i64_map.with-capacity
          (opt-function-index-capacity (compiler-ir-global-list-count globals)))]
      (match (opt-reach-process
        index
        (opt-reach-globals
          index
          (opt-reach-add-provided-externs
            index
            externs
            (opt-reach-add-function-leaf
              index
              (OptReachState.State
                reachable
                (OptReachWorklist.Nil)
                reachable-globals
                0)
              "main"))
          globals))
        [(OptReachState.State reachable-out _ reachable-globals-out _)
          (OptPrunedProgram.Program
            (opt-filter-reachable-globals globals reachable-globals-out)
            (opt-filter-reachable-functions index functions reachable-out))]))
    (OptPrunedProgram.Program globals functions)))

(defenum OptLoopBceArgcScan
  (Scan OptLoopBceExprEnv bool bool))

(defenum OptLoopBceCleanScan
  (Scan OptLoopBceState bool))

(defenum OptLoopBceCleanPass
  (Pass opt_i64_i64_map.Map bool))

(defenum OptLoopBceIdCleanPass
  (Pass opt_i64_i64_map.Map bool))

(define (opt-loop-bce-argc-value-expr
  [env : OptLoopBceExprEnv]
  [value : CompilerIrValue]) : OptLoopBceExpr
  (match value
    [(CompilerIrValue.Var id)
      (match (opt-loop-bce-expr-lookup env id)
        [(OptLoopBceExpr.Argc) (OptLoopBceExpr.Argc)]
        [_ (OptLoopBceExpr.Value value)])]
    [_ (OptLoopBceExpr.Value value)]))

(define (opt-loop-bce-argc-scan-instr
  [type-segment-bases : i64]
  [scan : OptLoopBceArgcScan]
  [instr : CompilerIrInstr]) : OptLoopBceArgcScan
  (match scan
    [(OptLoopBceArgcScan.Scan env seen ok)
      (if (not ok)
        scan
        (match instr
          [(CompilerIrInstr.EntryArgc dst)
            (OptLoopBceArgcScan.Scan
              (opt-loop-bce-expr-bind env dst (OptLoopBceExpr.Argc))
              seen
              ok)]
          [(CompilerIrInstr.Mov dst src _)
            (OptLoopBceArgcScan.Scan
              (opt-loop-bce-expr-bind
                env
                dst
                (opt-loop-bce-argc-value-expr env src))
              seen
              ok)]
          [(CompilerIrInstr.Cast dst src from-ty to-ty)
            (OptLoopBceArgcScan.Scan
              (opt-loop-bce-expr-bind
                env
                dst
                (if (opt-loop-bce-same-width-int-cast?
                  type-segment-bases
                  from-ty
                  to-ty)
                  (opt-loop-bce-argc-value-expr env src)
                  (OptLoopBceExpr.Unknown)))
              seen
              ok)]
          [(CompilerIrInstr.Bitcast dst _ _ _)
            (OptLoopBceArgcScan.Scan
              (opt-loop-bce-expr-bind env dst (OptLoopBceExpr.Unknown))
              seen
              ok)]
          [(CompilerIrInstr.Return maybe)
            (match maybe
              [(CompilerIrMaybeValue.Some value)
                (OptLoopBceArgcScan.Scan
                  env
                  true
                  (opt-loop-bce-expr-eq
                    type-segment-bases
                    (opt-loop-bce-argc-value-expr env value)
                    (OptLoopBceExpr.Argc)))]
              [(CompilerIrMaybeValue.No)
                (OptLoopBceArgcScan.Scan env true false)])]
          [(CompilerIrInstr.Jump _) (OptLoopBceArgcScan.Scan env seen false)]
          [(CompilerIrInstr.Branch _ _ _)
            (OptLoopBceArgcScan.Scan env seen false)]
          [_
            (let
              [dst : i64 (opt-gvn-instr-dst instr)]
              (if (= dst (- 0 1))
                scan
                (OptLoopBceArgcScan.Scan
                  (opt-loop-bce-expr-unbind env dst)
                  seen
                  ok)))]))]))

(define (opt-loop-bce-argc-scan-seq-from
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [scan : OptLoopBceArgcScan]) : OptLoopBceArgcScan
  (if (>= index (compiler-ir-instr-seq-count instrs))
    scan
    (opt-loop-bce-argc-scan-seq-from
      type-segment-bases
      instrs
      (+ index 1)
      (opt-loop-bce-argc-scan-instr
        type-segment-bases
        scan
        (compiler-ir-instr-seq-ref instrs index)))))

;; Only an EntryArgc instruction can seed the argc expression tracked by the
;; full scan below. Large generated initializers can contain tens of thousands
;; of unrelated moves in one block; building and repeatedly invalidating an
;; expression environment for those functions is quadratic work that cannot
;; produce an argc-return summary.
(define (opt-loop-bce-argc-seq-has-entry? [instrs : CompilerIrInstrSeq]) : bool
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (compiler-ir-instr-seq-ref instrs index)
          [(CompilerIrInstr.EntryArgc _) (set! found true)]
          [_ (set! index (+ index 1))]))
      found)))

(define (opt-loop-bce-argc-single-block-returns?
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]) : bool
  (if (not (opt-loop-bce-argc-seq-has-entry? instrs))
    false
    (match (opt-loop-bce-argc-scan-seq-from
      type-segment-bases
      instrs
      0
      (OptLoopBceArgcScan.Scan (OptLoopBceExprEnv.Nil) false true))
      [(OptLoopBceArgcScan.Scan _ seen ok) (and seen ok)])))

(define (opt-loop-bce-function-returns-argc?
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : bool
  (match func
    [(CompilerIrFunction.Function _ params _ _ blocks)
      (if (not (= (opt-tailrec-param-count params) 0))
        false
        (match blocks
          [(CompilerIrBlockList.Cons block rest)
            (match (box-get rest)
              [(CompilerIrBlockList.Nil)
                (match block
                  [(CompilerIrBlock.Block _ instrs)
                    (opt-loop-bce-argc-single-block-returns?
                      type-segment-bases
                      instrs)])]
              [_ false])]
          [(CompilerIrBlockList.Array seq)
            (if (= (compiler-ir-block-seq-count seq) 1)
              (match (compiler-ir-block-seq-ref seq 0)
                [(CompilerIrBlock.Block _ instrs)
                  (opt-loop-bce-argc-single-block-returns?
                    type-segment-bases
                    instrs)])
              false)]
          [(CompilerIrBlockList.Nil) false]))]))

(define (opt-loop-bce-argc-summary-test-function [has-entry : bool]) : CompilerIrFunction
  (CompilerIrFunction.Function
    (if has-entry
      0
      1)
    (CompilerIrParamList.Nil)
    (AstType.I64)
    2
    (compiler-ir-block-cons
      (compiler-ir-block
        (compiler-ir-label "entry")
        (if has-entry
          (compiler-ir-instr-cons
            (CompilerIrInstr.EntryArgc 0)
            (compiler-ir-instr-cons
              (CompilerIrInstr.Mov 1 (CompilerIrValue.Var 0) (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.Return
                  (CompilerIrMaybeValue.Some (CompilerIrValue.Var 1)))
                (CompilerIrInstrList.Nil))))
          (compiler-ir-instr-cons
            (CompilerIrInstr.Mov 0 (CompilerIrValue.I64 7) (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.Return
                (CompilerIrMaybeValue.Some (CompilerIrValue.Var 0)))
              (CompilerIrInstrList.Nil)))))
      (CompilerIrBlockList.Nil))))

(define (opt-loop-bce-argc-summary-prescan-self-test?) : bool
  (and
    (not
      (opt-loop-bce-function-returns-argc?
        (ast-node-pool-reader-type-segment-bases)
        (opt-loop-bce-argc-summary-test-function false)))
    (opt-loop-bce-function-returns-argc?
      (ast-node-pool-reader-type-segment-bases)
      (opt-loop-bce-argc-summary-test-function true))))

(define (opt-loop-bce-argc-return-map
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]
  [map : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match functions
    [(CompilerIrFunctionList.Nil) map]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ _)
          (begin
            (if (opt-loop-bce-function-returns-argc? type-segment-bases func)
              (opt_i64_i64_map.insert-ref!
                (&mut map)
                (compiler-ir-symbol-id name)
                1)
              unit)
            (opt-loop-bce-argc-return-map type-segment-bases (box-get rest) map))])]
    [(CompilerIrFunctionList.Array seq)
      (opt-loop-bce-argc-return-map
        type-segment-bases
        (compiler-ir-function-seq-to-list seq)
        map)]))

(define (opt-loop-bce-clean-storeptr-safe?
  [state : OptLoopBceState]
  [ptr : CompilerIrValue]) : bool
  (match ptr
    [(CompilerIrValue.Var ptr-var)
      (match (opt-loop-bce-ptr-lookup (struct-get state ptrs) ptr-var)
        [(OptLoopBcePtrKind.DataSlot _) true]
        [(OptLoopBcePtrKind.DataBuffer _) true]
        [(OptLoopBcePtrKind.DataElement _) true]
        [_ false])]
    [_ false]))

(define (opt-loop-bce-clean-update-instr
  [type-segment-bases : i64]
  [scan : OptLoopBceCleanScan]
  [clean : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : OptLoopBceCleanScan
  (match scan
    [(OptLoopBceCleanScan.Scan state ok)
      (if (not ok)
        scan
        (match instr
          [(CompilerIrInstr.Mov dst src _)
            (let
              [invalid : OptLoopBceState
                (opt-loop-bce-state-invalidate-def state dst)]
              (match src
                [(CompilerIrValue.Var src-var)
                  (OptLoopBceCleanScan.Scan
                    (opt-loop-bce-state-bind-alias
                      invalid
                      dst
                      (opt-loop-bce-alias-resolve
                        (struct-get state aliases)
                        src-var))
                    ok)]
                [_ (OptLoopBceCleanScan.Scan invalid ok)]))]
          [(CompilerIrInstr.Alloc dst _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-bind-alias
                (opt-loop-bce-state-invalidate-def state dst)
                dst
                dst)
              ok)]
          [(CompilerIrInstr.Gep dst base offset ty)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-update-gep
                type-segment-bases
                state
                (opt_i64_i64_map.with-capacity 1)
                dst
                base
                offset
                ty)
              ok)]
          [(CompilerIrInstr.Load dst src ty)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-update-load
                type-segment-bases
                state
                (opt_i64_i64_map.with-capacity 1)
                dst
                src
                ty)
              ok)]
          [(CompilerIrInstr.StorePtr ptr _ _)
            (OptLoopBceCleanScan.Scan
              state
              (opt-loop-bce-clean-storeptr-safe? state ptr))]
          [(CompilerIrInstr.Call dst name _ _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-invalidate-def state dst)
              (opt_i64_i64_map.contains? (& clean) (compiler-ir-symbol-id name)))]
          [(CompilerIrInstr.TailCall name _ _)
            (OptLoopBceCleanScan.Scan
              state
              (opt_i64_i64_map.contains? (& clean) (compiler-ir-symbol-id name)))]
          [(CompilerIrInstr.CallIndirect dst _ _ _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-invalidate-def state dst)
              false)]
          [(CompilerIrInstr.CallIndirectC dst _ _ _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-invalidate-def state dst)
              false)]
          [(CompilerIrInstr.CallCAbiStoreResult payload-box)
            (match (box-get payload-box)
              [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ _ _ _)
                (OptLoopBceCleanScan.Scan state false)])]
          [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
            (match (box-get payload-box)
              [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
                  _
                  _
                  _
                  _)
                (OptLoopBceCleanScan.Scan state false)])]
          [(CompilerIrInstr.SpmdCall payload-box)
            (match (box-get payload-box)
              [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
                (match result
                  [(CompilerIrSpmdCallResult.Unit)
                    (OptLoopBceCleanScan.Scan state false)]
                  [(CompilerIrSpmdCallResult.Value dst _ _)
                    (OptLoopBceCleanScan.Scan
                      (opt-loop-bce-state-invalidate-def state dst)
                      false)])])]
          [(CompilerIrInstr.TailCallIndirect _ _ _)
            (OptLoopBceCleanScan.Scan state false)]
          [(CompilerIrInstr.Syscall dst _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-invalidate-def state dst)
              false)]
          [(CompilerIrInstr.CopyBytes _ _ _)
            (OptLoopBceCleanScan.Scan state false)]
          [(CompilerIrInstr.VectorStore payload-box)
            (match (box-get payload-box)
              [(CompilerIrInstrVectorStorePayload.Payload _ _ _ _ _)
                (OptLoopBceCleanScan.Scan state false)])]
          [(CompilerIrInstr.PredicatedStore payload-box)
            (match (box-get payload-box)
              [(CompilerIrInstrPredicatedStorePayload.Payload _ _ _ _ _ _)
                (OptLoopBceCleanScan.Scan state false)])]
          [_
            (let
              [dst : i64 (opt-gvn-instr-dst instr)]
              (OptLoopBceCleanScan.Scan
                (if (= dst (- 0 1))
                  state
                  (opt-loop-bce-state-invalidate-def state dst))
                ok))]))]))

(define (opt-loop-bce-clean-scan-seq-from
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [clean : opt_i64_i64_map.Map]
  [scan : OptLoopBceCleanScan]) : OptLoopBceCleanScan
  (if (>= index (compiler-ir-instr-seq-count instrs))
    scan
    (opt-loop-bce-clean-scan-seq-from
      type-segment-bases
      instrs
      (+ index 1)
      clean
      (opt-loop-bce-clean-update-instr
        type-segment-bases
        scan
        clean
        (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-loop-bce-clean-scan-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [clean : opt_i64_i64_map.Map]
  [scan : OptLoopBceCleanScan]) : OptLoopBceCleanScan
  (match scan
    [(OptLoopBceCleanScan.Scan _ ok)
      (if (not ok)
        scan
        (match blocks
          [(CompilerIrBlockList.Nil) scan]
          [(CompilerIrBlockList.Cons block rest)
            (match block
              [(CompilerIrBlock.Block _ instrs)
                (opt-loop-bce-clean-scan-blocks
                  type-segment-bases
                  (box-get rest)
                  clean
                  (opt-loop-bce-clean-scan-seq-from
                    type-segment-bases
                    instrs
                    0
                    clean
                    scan))])]
          [(CompilerIrBlockList.Array seq)
            (opt-loop-bce-clean-scan-blocks
              type-segment-bases
              (compiler-ir-block-seq-to-list seq)
              clean
              scan)]))]))

(define (opt-loop-bce-function-length-clean?
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [clean : opt_i64_i64_map.Map]) : bool
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-loop-bce-clean-scan-blocks
        type-segment-bases
        blocks
        clean
        (OptLoopBceCleanScan.Scan (opt-loop-bce-initial-state) true))
        [(OptLoopBceCleanScan.Scan _ ok) ok])]))

(define (opt-loop-bce-length-clean-pass
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]
  [clean : opt_i64_i64_map.Map]) : OptLoopBceCleanPass
  (match functions
    [(CompilerIrFunctionList.Nil) (OptLoopBceCleanPass.Pass clean false)]
    [(CompilerIrFunctionList.Cons func rest)
      (match (opt-loop-bce-length-clean-pass
        type-segment-bases
        (box-get rest)
        clean)
        [(OptLoopBceCleanPass.Pass tail-clean tail-added)
          (match func
            [(CompilerIrFunction.Function name _ _ _ _)
              (if (opt_i64_i64_map.contains?
                (& tail-clean)
                (compiler-ir-symbol-id name))
                (OptLoopBceCleanPass.Pass tail-clean tail-added)
                (if (opt-loop-bce-function-length-clean?
                  type-segment-bases
                  func
                  tail-clean)
                  (begin
                    (opt_i64_i64_map.insert-ref!
                      (&mut tail-clean)
                      (compiler-ir-symbol-id name)
                      1)
                    (OptLoopBceCleanPass.Pass tail-clean true))
                  (OptLoopBceCleanPass.Pass tail-clean tail-added)))])])]
    [(CompilerIrFunctionList.Array seq)
      (opt-loop-bce-length-clean-pass
        type-segment-bases
        (compiler-ir-function-seq-to-list seq)
        clean)]))

(define (opt-loop-bce-direct-call-clean-effect? [effect : CompilerIrEffect]) : bool
  (match effect
    [(CompilerIrEffect.Pure) true]
    [(CompilerIrEffect.MemoryRead) true]
    [(CompilerIrEffect.ControlFlow) true]
    [_ false]))

(define (opt-loop-bce-direct-call-clean-target?
  [clean : opt_i64_i64_map.Map]
  [name : i64]) : bool
  (or
    (opt_i64_i64_map.contains? (& clean) (compiler-ir-symbol-id name))
    (opt-loop-bce-direct-call-clean-effect?
      (compiler-ir-direct-call-effect-id name))))

(define (opt-loop-bce-direct-call-clean-instr?
  [clean : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Call _ name _ _)
      (opt-loop-bce-direct-call-clean-target? clean name)]
    [(CompilerIrInstr.TailCall name _ _)
      (opt-loop-bce-direct-call-clean-target? clean name)]
    [(CompilerIrInstr.CallIndirect _ _ _ _) false]
    [(CompilerIrInstr.CallIndirectC _ _ _ _) false]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ _ _ _) false])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload _ _ _ _)
          false])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ _) false])]
    [(CompilerIrInstr.TailCallIndirect _ _ _) false]
    [_
      (opt-loop-bce-direct-call-clean-effect? (compiler-ir-instr-effect instr))]))

(define (opt-loop-bce-direct-call-clean-instr-seq?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [clean : opt_i64_i64_map.Map]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-loop-bce-direct-call-clean-instr?
        clean
        (compiler-ir-instr-seq-ref instrs index))
      (opt-loop-bce-direct-call-clean-instr-seq? instrs (+ index 1) clean))))

(define (opt-loop-bce-direct-call-clean-blocks?
  [blocks : CompilerIrBlockList]
  [clean : opt_i64_i64_map.Map]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (and
            (opt-loop-bce-direct-call-clean-instr-seq? instrs 0 clean)
            (opt-loop-bce-direct-call-clean-blocks? (box-get rest) clean))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-bce-direct-call-clean-blocks?
        (compiler-ir-block-seq-to-list seq)
        clean)]))

(define (opt-loop-bce-direct-call-self-recursive-instr?
  [name : i64]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Call _ callee _ _) (compiler-ir-symbol-eq? name callee)]
    [(CompilerIrInstr.TailCall callee _ _) (compiler-ir-symbol-eq? name callee)]
    [_ false]))

(define (opt-loop-bce-direct-call-self-recursive-seq?
  [name : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-loop-bce-direct-call-self-recursive-instr?
        name
        (compiler-ir-instr-seq-ref instrs index))
      (opt-loop-bce-direct-call-self-recursive-seq? name instrs (+ index 1)))))

(define (opt-loop-bce-direct-call-self-recursive-blocks?
  [name : i64]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (or
            (opt-loop-bce-direct-call-self-recursive-seq? name instrs 0)
            (opt-loop-bce-direct-call-self-recursive-blocks?
              name
              (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-loop-bce-direct-call-self-recursive-blocks?
        name
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-function-direct-call-hoist-target?
  [func : CompilerIrFunction]
  [clean : opt_i64_i64_map.Map]) : bool
  (match func
    [(CompilerIrFunction.Function name _ _ _ blocks)
      (and
        (opt-loop-bce-direct-call-self-recursive-blocks? name blocks)
        (opt-loop-bce-direct-call-clean-blocks? blocks clean))]))

(define (opt-loop-bce-direct-call-clean-all-functions
  [functions : CompilerIrFunctionList]
  [map : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match functions
    [(CompilerIrFunctionList.Nil) map]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ _)
          (begin
            (opt_i64_i64_map.insert-ref!
              (&mut map)
              (compiler-ir-symbol-id name)
              1)
            (opt-loop-bce-direct-call-clean-all-functions (box-get rest) map))])]
    [(CompilerIrFunctionList.Array seq)
      (opt-loop-bce-direct-call-clean-all-functions
        (compiler-ir-function-seq-to-list seq)
        map)]))

(define (opt-loop-bce-direct-call-clean-filter
  [functions : CompilerIrFunctionList]
  [current : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map]
  [changed : bool]) : OptLoopBceIdCleanPass
  (match functions
    [(CompilerIrFunctionList.Nil) (OptLoopBceIdCleanPass.Pass out changed)]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ _)
          (let
            [name-id : i64 (compiler-ir-symbol-id name)]
            [was-clean : bool (opt_i64_i64_map.contains? (& current) name-id)]
            [keep : bool
              (and
                was-clean
                (opt-loop-bce-function-direct-call-hoist-target? func current))]
            [_record : unit
              (if keep
                (opt_i64_i64_map.insert-ref! (&mut out) name-id 1)
                unit)]
            (opt-loop-bce-direct-call-clean-filter
              (box-get rest)
              current
              out
              (or changed (and was-clean (not keep)))))])]
    [(CompilerIrFunctionList.Array seq)
      (opt-loop-bce-direct-call-clean-filter
        (compiler-ir-function-seq-to-list seq)
        current
        out
        changed)]))

(define (opt-loop-bce-direct-call-clean-fixed
  [functions : CompilerIrFunctionList]
  [current : opt_i64_i64_map.Map]
  [capacity : i64]
  [remaining : i64]) : opt_i64_i64_map.Map
  (if (<= remaining 0)
    current
    (match (opt-loop-bce-direct-call-clean-filter
      functions
      current
      (opt_i64_i64_map.with-capacity capacity)
      false)
      [(OptLoopBceIdCleanPass.Pass next changed)
        (if changed
          (opt-loop-bce-direct-call-clean-fixed
            functions
            next
            capacity
            (- remaining 1))
          next)])))

(define (opt-loop-bce-direct-call-clean-map
  [functions : CompilerIrFunctionList]
  [capacity : i64]) : opt_i64_i64_map.Map
  (opt-loop-bce-direct-call-clean-fixed
    functions
    (opt-loop-bce-direct-call-clean-all-functions
      functions
      (opt_i64_i64_map.with-capacity capacity))
    capacity
    (+ (opt-function-list-count functions) 1)))

;; --- direct-call memory summaries for load GVN ------------------------------
;;
;; Packed summary layout (kept nonnegative):
;;   bits 0..59  writes through that checked-reference parameter index
;;   bit 60      writes direct/reachable global storage
;;   bit 61      unknown memory effects
;;
;; The summary map is intentionally partial. Leaves are discovered first and
;; callers become eligible in later fixed-point rounds. An internal call whose
;; target is still absent makes the caller unresolved, so recursive cycles are
;; never accidentally proven clean.
(define (opt-call-memory-param-limit) : i64
  60)

(define (opt-call-memory-global-bit) : i64
  (shl 1 60))

(define (opt-call-memory-unknown-bit) : i64
  (shl 1 61))

(define (opt-call-memory-summary-param-write? [summary : i64] [index : i64]) : bool
  (and
    (>= index 0)
    (< index (opt-call-memory-param-limit))
    (not (= (bit-and summary (shl 1 index)) 0))))

(define (opt-call-memory-summary-global? [summary : i64]) : bool
  (not (= (bit-and summary (opt-call-memory-global-bit)) 0)))

(define (opt-call-memory-summary-unknown? [summary : i64]) : bool
  (not (= (bit-and summary (opt-call-memory-unknown-bit)) 0)))

(define (opt-call-memory-summary-has-param-writes? [summary : i64]) : bool
  (not (= (bit-and summary (- (opt-call-memory-global-bit) 1)) 0)))

(define (opt-call-memory-summary-add-unknown [summary : i64]) : i64
  (bit-or summary (opt-call-memory-unknown-bit)))

(define (opt-call-memory-summary-add-global [summary : i64]) : i64
  (bit-or summary (opt-call-memory-global-bit)))

(define (opt-call-memory-function-set
  [functions : CompilerIrFunctionList]
  [set : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match functions
    [(CompilerIrFunctionList.Nil) set]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ _)
          (begin
            (opt_i64_i64_map.insert-ref!
              (&mut set)
              (compiler-ir-symbol-id name)
              1)
            (opt-call-memory-function-set (box-get rest) set))])]
    [(CompilerIrFunctionList.Array seq)
      (opt-call-memory-function-set (compiler-ir-function-seq-to-list seq) set)]))

;; Find the source-level parameter index for a canonical checked-reference root
;; var. Fresh allocation roots deliberately have no parameter index.
(define (opt-call-memory-param-index-from
  [params : CompilerIrParamList]
  [root-var : i64]
  [index : i64]) : i64
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) -1]
    [(CompilerIrParamList.Array seq)
      (opt-call-memory-param-index-from
        (compiler-ir-param-seq-to-list seq)
        root-var
        index)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ var)
          (if (= var root-var)
            index
            (opt-call-memory-param-index-from
              (box-get rest)
              root-var
              (+ index 1)))])]))

(define (opt-call-memory-summary-add-root-write
  [summary : i64]
  [params : CompilerIrParamList]
  [root : OptLicmRoot]) : i64
  (match root
    [(OptLicmRoot.Fresh _) summary]
    [(OptLicmRoot.Exclusive root-var)
      (let
        [index : i64 (opt-call-memory-param-index-from params root-var 0)]
        (if (and (>= index 0) (< index (opt-call-memory-param-limit)))
          (bit-or summary (shl 1 index))
          (opt-call-memory-summary-add-unknown summary)))]
    [(OptLicmRoot.Shared root-var)
      (let
        [index : i64 (opt-call-memory-param-index-from params root-var 0)]
        (if (and (>= index 0) (< index (opt-call-memory-param-limit)))
          (bit-or summary (shl 1 index))
          (opt-call-memory-summary-add-unknown summary)))]
    [(OptLicmRoot.NoRoot) (opt-call-memory-summary-add-unknown summary)]))

;; Summary construction runs before scalar SSA. Track roots only through vars
;; with one whole-function source, so textual block order or a reused lowered
;; var can never manufacture provenance. A second scan resolves same-root phis
;; and later-listed definitions without weakening that single-source gate.
(define (opt-call-memory-root-update-instr!
  [sources : opt_i64_i64_map.Map]
  [roots : OptLicmRootEnv]
  [instr : CompilerIrInstr]) : unit
  (match (opt-instr-def-var instr)
    [(option_i64.None) unit]
    [(option_i64.Some dst)
      (if (not (opt-gvn-stable-var? sources dst))
        (opt-licm-root-env-remove! roots dst)
        (match instr
          [(CompilerIrInstr.Alloc _ _)
            (opt-licm-root-env-bind! roots dst (OptLicmRoot.Fresh dst))]
          [(CompilerIrInstr.Gep _ base _ _)
            (opt-licm-root-env-copy! roots dst base)]
          [(CompilerIrInstr.Mov _ src _)
            (opt-licm-root-env-copy! roots dst src)]
          [(CompilerIrInstr.Cast _ src _ _)
            (opt-licm-root-env-copy! roots dst src)]
          [(CompilerIrInstr.Bitcast _ src _ _)
            (opt-licm-root-env-copy! roots dst src)]
          [(CompilerIrInstr.Phi _ inputs _)
            (match (opt-licm-phi-root roots inputs (OptMaybeLicmRoot.No))
              [(OptMaybeLicmRoot.No) (opt-licm-root-env-remove! roots dst)]
              [(OptMaybeLicmRoot.Some root)
                (opt-licm-root-env-bind! roots dst root)])]
          [(CompilerIrInstr.Call _ name _ _)
            (if (compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)
              (opt-licm-root-env-bind! roots dst (OptLicmRoot.Fresh dst))
              (opt-licm-root-env-remove! roots dst))]
          [_ (opt-licm-root-env-remove! roots dst)]))]))

(define (opt-call-memory-root-scan-instrs!
  [sources : opt_i64_i64_map.Map]
  [roots : OptLicmRootEnv]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : unit
  (if (>= index (compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (opt-call-memory-root-update-instr!
        sources
        roots
        (compiler-ir-instr-seq-ref instrs index))
      (opt-call-memory-root-scan-instrs! sources roots instrs (+ index 1)))))

(define (opt-call-memory-root-scan-blocks!
  [sources : opt_i64_i64_map.Map]
  [roots : OptLicmRootEnv]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (opt-call-memory-root-scan-instrs! sources roots instrs 0)])
        (opt-call-memory-root-scan-blocks! sources roots (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-call-memory-root-scan-blocks!
        sources
        roots
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-call-memory-roots
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptLicmRootEnv
  (let
    [sources : opt_i64_i64_map.Map
      (opt-gvn-sources-blocks
        blocks
        (opt-gvn-sources-params params (opt_i64_i64_map.with-capacity 32)))]
    [roots : OptLicmRootEnv (opt-licm-root-env-with-capacity 17)]
    (begin
      (opt-licm-root-env-seed-params! type-segment-bases roots params)
      (opt-call-memory-root-scan-blocks! sources roots blocks)
      (opt-call-memory-root-scan-blocks! sources roots blocks)
      roots)))

(define (opt-call-memory-arg-at [args : CompilerIrCallArgs] [index : i64]) : CompilerIrMaybeValue
  (match args
    [(CompilerIrCallArgs.Nil) (CompilerIrMaybeValue.No)]
    [(CompilerIrCallArgs.One value)
      (if (= index 0)
        (CompilerIrMaybeValue.Some value)
        (CompilerIrMaybeValue.No))]
    [(CompilerIrCallArgs.Two a b)
      (cond
        [(= index 0) (CompilerIrMaybeValue.Some a)]
        [(= index 1) (CompilerIrMaybeValue.Some b)]
        [else (CompilerIrMaybeValue.No)])]
    [(CompilerIrCallArgs.Array values)
      (if (and (>= index 0) (< index (array-length values)))
        (CompilerIrMaybeValue.Some (array-ref values index))
        (CompilerIrMaybeValue.No))]))

(defenum OptCallMemoryCandidate
  (Unresolved)
  (Known i64))

(define (opt-call-memory-map-callee-param-writes
  [candidate : OptCallMemoryCandidate]
  [callee-summary : i64]
  [params : CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [args : CompilerIrCallArgs]
  [index : i64]) : OptCallMemoryCandidate
  (if (>= index (opt-call-memory-param-limit))
    candidate
    (match candidate
      [(OptCallMemoryCandidate.Unresolved) candidate]
      [(OptCallMemoryCandidate.Known summary)
        (if (not (opt-call-memory-summary-param-write? callee-summary index))
          (opt-call-memory-map-callee-param-writes
            candidate
            callee-summary
            params
            roots
            args
            (+ index 1))
          (match (opt-call-memory-arg-at args index)
            [(CompilerIrMaybeValue.No)
              (OptCallMemoryCandidate.Known
                (opt-call-memory-summary-add-unknown summary))]
            [(CompilerIrMaybeValue.Some value)
              (opt-call-memory-map-callee-param-writes
                (OptCallMemoryCandidate.Known
                  (opt-call-memory-summary-add-root-write
                    summary
                    params
                    (opt-licm-root-of-value roots value)))
                callee-summary
                params
                roots
                args
                (+ index 1))]))])))

(define (opt-call-memory-apply-direct-call
  [candidate : OptCallMemoryCandidate]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [params : CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [name : i64]
  [args : CompilerIrCallArgs]) : OptCallMemoryCandidate
  (match candidate
    [(OptCallMemoryCandidate.Unresolved) candidate]
    [(OptCallMemoryCandidate.Known summary)
      (match (opt_i64_i64_map.get (& summaries) (compiler-ir-symbol-id name))
        [(opt_i64_i64_map.LookupFound callee-summary)
          (opt-call-memory-map-callee-param-writes
            (OptCallMemoryCandidate.Known
              (bit-or
                summary
                (bit-and
                  callee-summary
                  (bit-or
                    (opt-call-memory-global-bit)
                    (opt-call-memory-unknown-bit)))))
            callee-summary
            params
            roots
            args
            0)]
        [(opt_i64_i64_map.LookupMissing)
          (if (opt_i64_i64_map.contains?
            (& function-set)
            (compiler-ir-symbol-id name))
            (OptCallMemoryCandidate.Unresolved)
            (match (compiler-ir-direct-call-effect-id name)
              [(CompilerIrEffect.MemoryRead) candidate]
              [_
                (OptCallMemoryCandidate.Known
                  (opt-call-memory-summary-add-unknown summary))]))])]))

(define (opt-call-memory-candidate-instr
  [candidate : OptCallMemoryCandidate]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [params : CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [instr : CompilerIrInstr]) : OptCallMemoryCandidate
  (match candidate
    [(OptCallMemoryCandidate.Unresolved) candidate]
    [(OptCallMemoryCandidate.Known summary)
      (match instr
        [(CompilerIrInstr.StorePtr ptr _ _)
          (OptCallMemoryCandidate.Known
            (opt-call-memory-summary-add-root-write
              summary
              params
              (opt-licm-root-of-value roots ptr)))]
        [(CompilerIrInstr.CopyBytes dst _ _)
          (OptCallMemoryCandidate.Known
            (opt-call-memory-summary-add-root-write
              summary
              params
              (opt-licm-root-of-value roots dst)))]
        [(CompilerIrInstr.Store _ _ _)
          (OptCallMemoryCandidate.Known
            (opt-call-memory-summary-add-global summary))]
        [(CompilerIrInstr.Call _ name args _)
          (opt-call-memory-apply-direct-call
            candidate
            summaries
            function-set
            params
            roots
            name
            args)]
        [(CompilerIrInstr.TailCall name args _)
          (opt-call-memory-apply-direct-call
            candidate
            summaries
            function-set
            params
            roots
            name
            args)]
        [(CompilerIrInstr.Alloc _ _) candidate]
        [_
          (match (compiler-ir-instr-effect instr)
            [(CompilerIrEffect.Pure) candidate]
            [(CompilerIrEffect.MemoryRead) candidate]
            [(CompilerIrEffect.ControlFlow) candidate]
            [_
              (OptCallMemoryCandidate.Known
                (opt-call-memory-summary-add-unknown summary))])])]))

(define (opt-call-memory-candidate-instrs
  [candidate : OptCallMemoryCandidate]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [params : CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptCallMemoryCandidate
  (if (>= index (compiler-ir-instr-seq-count instrs))
    candidate
    (opt-call-memory-candidate-instrs
      (opt-call-memory-candidate-instr
        candidate
        summaries
        function-set
        params
        roots
        (compiler-ir-instr-seq-ref instrs index))
      summaries
      function-set
      params
      roots
      instrs
      (+ index 1))))

(define (opt-call-memory-candidate-blocks
  [candidate : OptCallMemoryCandidate]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [params : CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [blocks : CompilerIrBlockList]) : OptCallMemoryCandidate
  (match candidate
    [(OptCallMemoryCandidate.Unresolved) candidate]
    [_
      (match blocks
        [(CompilerIrBlockList.Nil) candidate]
        [(CompilerIrBlockList.Cons block rest)
          (match block
            [(CompilerIrBlock.Block _ instrs)
              (opt-call-memory-candidate-blocks
                (opt-call-memory-candidate-instrs
                  candidate
                  summaries
                  function-set
                  params
                  roots
                  instrs
                  0)
                summaries
                function-set
                params
                roots
                (box-get rest))])]
        [(CompilerIrBlockList.Array seq)
          (opt-call-memory-candidate-blocks
            candidate
            summaries
            function-set
            params
            roots
            (compiler-ir-block-seq-to-list seq))])]))

(define (opt-call-memory-direct-needs-roots?
  [summaries : opt_i64_i64_map.Map]
  [name : i64]) : bool
  (match (opt_i64_i64_map.get (& summaries) (compiler-ir-symbol-id name))
    [(opt_i64_i64_map.LookupFound summary)
      (opt-call-memory-summary-has-param-writes? summary)]
    [(opt_i64_i64_map.LookupMissing) false]))

(define (opt-call-memory-instr-needs-roots?
  [summaries : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [(CompilerIrInstr.CopyBytes _ _ _) true]
    [(CompilerIrInstr.Call _ name _ _)
      (opt-call-memory-direct-needs-roots? summaries name)]
    [(CompilerIrInstr.TailCall name _ _)
      (opt-call-memory-direct-needs-roots? summaries name)]
    [_ false]))

(define (opt-call-memory-instrs-need-roots?
  [summaries : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-call-memory-instr-needs-roots?
        summaries
        (compiler-ir-instr-seq-ref instrs index))
      (opt-call-memory-instrs-need-roots? summaries instrs (+ index 1)))))

(define (opt-call-memory-blocks-need-roots?
  [summaries : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (or
            (opt-call-memory-instrs-need-roots? summaries instrs 0)
            (opt-call-memory-blocks-need-roots? summaries (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (opt-call-memory-blocks-need-roots?
        summaries
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-call-memory-function-candidate
  [type-segment-bases : i64]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [func : CompilerIrFunction]) : OptCallMemoryCandidate
  (match func
    [(CompilerIrFunction.Function _ params _ _ blocks)
      (opt-call-memory-candidate-blocks
        (OptCallMemoryCandidate.Known 0)
        summaries
        function-set
        params
        (if (opt-call-memory-blocks-need-roots? summaries blocks)
          (opt-call-memory-roots type-segment-bases params blocks)
          (opt-licm-root-env-with-capacity 1))
        blocks)]))

(defenum OptCallMemoryBuildPass
  (Pass opt_i64_i64_map.Map bool))

(define (opt-call-memory-build-pass
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]
  [current : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map]
  [changed : bool]) : OptCallMemoryBuildPass
  (match functions
    [(CompilerIrFunctionList.Nil) (OptCallMemoryBuildPass.Pass out changed)]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ _)
          (let
            [name-id : i64 (compiler-ir-symbol-id name)]
            (match (opt_i64_i64_map.get (& current) name-id)
              [(opt_i64_i64_map.LookupFound summary)
                (begin
                  (opt_i64_i64_map.insert-ref! (&mut out) name-id summary)
                  (opt-call-memory-build-pass
                    type-segment-bases
                    (box-get rest)
                    current
                    function-set
                    out
                    changed))]
              [(opt_i64_i64_map.LookupMissing)
                (match (opt-call-memory-function-candidate
                  type-segment-bases
                  current
                  function-set
                  func)
                  [(OptCallMemoryCandidate.Unresolved)
                    (opt-call-memory-build-pass
                      type-segment-bases
                      (box-get rest)
                      current
                      function-set
                      out
                      changed)]
                  [(OptCallMemoryCandidate.Known summary)
                    (begin
                      (opt_i64_i64_map.insert-ref! (&mut out) name-id summary)
                      (opt-call-memory-build-pass
                        type-segment-bases
                        (box-get rest)
                        current
                        function-set
                        out
                        true))])]))])]
    [(CompilerIrFunctionList.Array seq)
      (opt-call-memory-build-pass
        type-segment-bases
        (compiler-ir-function-seq-to-list seq)
        current
        function-set
        out
        changed)]))

;; Three runtime builtins have a memory footprint precise enough to summarize,
;; which lets a caller's cached load table survive them instead of being wiped:
;;
;;   - tl_alloc      : writes nothing IR-visible. Allocator bookkeeping lives in
;;                     thread-local runtime state no IR address value can name,
;;                     and the storage it returns did not exist before the call,
;;                     so no cached entry can describe it. (A recycling
;;                     tl_region_reset / tl_arena_set is deliberately NOT
;;                     summarized, so any reuse of freed storage still wipes.)
;;   - tl_array_zero : writes only through its first parameter.
;;   - tl_array_fill8: writes only through its first parameter.
;;
;; Symbols are raw interned ids (`compiler-ir-symbol-id` is the identity and
;; `compiler-ir-symbol-eq?` is `=`), so the seed key is the builtin id itself --
;; exactly what `opt-load-cse-state-direct-call` looks up for a call-site name.
;; An uninitialized builtin id is -1 and is never a call-site name, so it is
;; skipped rather than seeded (mirroring `compiler-ir-runtime-memory-write-id?`).
(define (opt-call-memory-seed-builtin
  [out : opt_i64_i64_map.Map]
  [name-id : i64]
  [summary : i64]) : opt_i64_i64_map.Map
  (if (< name-id 0)
    out
    (let
      [next : opt_i64_i64_map.Map out]
      (begin
        (opt_i64_i64_map.insert-ref!
          (&mut next)
          (compiler-ir-symbol-id name-id)
          summary)
        next))))

(define (opt-call-memory-seed-builtins [out : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (begin
    (cbi.compiler-builtin-refresh!)
    (opt-call-memory-seed-builtin
      (opt-call-memory-seed-builtin
        (opt-call-memory-seed-builtin out cbi.compiler-builtin-id-tl-alloc 0)
        cbi.compiler-builtin-id-tl-array-zero
        (shl 1 0))
      cbi.compiler-builtin-id-tl-array-fill8
      (shl 1 0))))

(define (opt-call-memory-build-fixed
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]
  [function-set : opt_i64_i64_map.Map]
  [current : opt_i64_i64_map.Map]
  [capacity : i64]
  [remaining : i64]) : opt_i64_i64_map.Map
  (if (<= remaining 0)
    current
    ;; Each round builds a fresh `out` and copies rows in per function name, so
    ;; the builtin seeds are re-applied here as well as to the initial map --
    ;; otherwise they would vanish after round one.
    (match (opt-call-memory-build-pass
      type-segment-bases
      functions
      current
      function-set
      (opt-call-memory-seed-builtins (opt_i64_i64_map.with-capacity capacity))
      false)
      [(OptCallMemoryBuildPass.Pass next changed)
        (if changed
          (opt-call-memory-build-fixed
            type-segment-bases
            functions
            function-set
            next
            capacity
            (- remaining 1))
          next)])))

(define (opt-call-memory-build
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]
  [capacity : i64]) : opt_i64_i64_map.Map
  (opt-call-memory-build-fixed
    type-segment-bases
    functions
    (opt-call-memory-function-set
      functions
      (opt_i64_i64_map.with-capacity capacity))
    (opt-call-memory-seed-builtins (opt_i64_i64_map.with-capacity capacity))
    capacity
    (+ (opt-function-list-count functions) 1)))

;; Prove which globals are compile-time constants so their value can be
;; substituted for the global at its uses. The win is twofold: (a) every global
;; use otherwise emits a rip-relative load, so substituting the literal removes a
;; per-iteration memory load (the instruction-count win on opt_crc32/opt_quicksort
;; mask constants), and (b) a div/mod by such a global becomes a literal divisor
;; the backend strength-reduces with the existing magic-multiply path (matching
;; clang).
;;
;; Soundness: substituting a global's initializer is valid only when the global is
;; immutable. A global is mutated by either (1) a direct `CompilerIrInstr.Store name`
;; (the lowering of `(set! global ...)`, see compiler_lower.tl AstExpr.Set), or
;; (2) a write through a pointer derived from its address, which only exists if
;; `(& global)` was taken -- lowered to `CompilerIrValue.GlobalAddr name`. Disqualifying a
;; global on EITHER signal leaves only provably-never-written globals, whose value
;; equals the initializer at every use. The disqualify walk mirrors
;; `opt-reach-instr` arm-for-arm (and, like it, omits a wildcard arm) so adding a
;; new IR instruction fails to compile until it is handled here -- a new operand
;; position can never silently escape the address-taken check.
(define (opt-const-globals-disq-value
  [disq : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : opt_i64_i64_map.Map
  (match value
    [(CompilerIrValue.GlobalAddr name)
      (begin
        (opt_i64_i64_map.insert-ref! (&mut disq) (compiler-ir-symbol-id name) 1)
        disq)]
    [_ disq]))

(define (opt-const-globals-disq-args-array
  [disq : opt_i64_i64_map.Map]
  [values : (Array CompilerIrValue)]
  [index : i64]) : opt_i64_i64_map.Map
  (if (>= index (array-length values))
    disq
    (opt-const-globals-disq-args-array
      (opt-const-globals-disq-value disq (array-ref values index))
      values
      (+ index 1))))

(define (opt-const-globals-disq-args
  [disq : opt_i64_i64_map.Map]
  [args : CompilerIrCallArgs]) : opt_i64_i64_map.Map
  (match args
    [(CompilerIrCallArgs.Nil) disq]
    [(CompilerIrCallArgs.One value) (opt-const-globals-disq-value disq value)]
    [(CompilerIrCallArgs.Two a b)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq a) b)]
    [(CompilerIrCallArgs.Array values)
      (opt-const-globals-disq-args-array disq values 0)]))

(define (opt-const-globals-disq-spmd-args
  [disq : opt_i64_i64_map.Map]
  [args : CompilerIrSpmdCallArgList]) : opt_i64_i64_map.Map
  (match args
    [(CompilerIrSpmdCallArgList.Nil) disq]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (opt-const-globals-disq-spmd-args
            (opt-const-globals-disq-value disq value)
            (box-get rest))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : opt_i64_i64_map.Map disq]
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (opt-const-globals-disq-value out value))])
              (set! i (+ i 1))))
          out))]))

(define (opt-const-globals-disq-maybe
  [disq : opt_i64_i64_map.Map]
  [maybe : CompilerIrMaybeValue]) : opt_i64_i64_map.Map
  (match maybe
    [(CompilerIrMaybeValue.No) disq]
    [(CompilerIrMaybeValue.Some value)
      (opt-const-globals-disq-value disq value)]))

(define (opt-const-globals-disq-phi
  [disq : opt_i64_i64_map.Map]
  [inputs : CompilerIrPhiInputList]) : opt_i64_i64_map.Map
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) disq]
    [(CompilerIrPhiInputList.Array seq)
      (opt-const-globals-disq-phi disq (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (opt-const-globals-disq-phi
        (opt-const-globals-disq-value disq value)
        (box-get rest))]))

;; Disqualify a global on a direct store to it OR on any `CompilerIrValue.GlobalAddr`
;; operand. Mirrors opt-reach-instr (no wildcard arm); the only behavioural
;; differences are that `CompilerIrInstr.Store` also records its target name and call/tail
;; targets (function names, never const-global candidates) are not scanned.
(define (opt-const-globals-disq-instr
  [disq : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : opt_i64_i64_map.Map
  (match instr
    [(CompilerIrInstr.Mov _ src _) (opt-const-globals-disq-value disq src)]
    [(CompilerIrInstr.Alloc _ _) disq]
    [(CompilerIrInstr.AddrOf _ _) disq]
    [(CompilerIrInstr.Gep _ base offset _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq base)
        offset)]
    [(CompilerIrInstr.Load _ src _) (opt-const-globals-disq-value disq src)]
    [(CompilerIrInstr.StorePtr dst src _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq dst) src)]
    [(CompilerIrInstr.CopyBytes dst src _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq dst) src)]
    [(CompilerIrInstr.BoundsCheck idx length _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq idx)
        length)]
    [(CompilerIrInstr.Cast _ src _ _) (opt-const-globals-disq-value disq src)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (opt-const-globals-disq-value disq src)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq lhs) rhs)]
    [(CompilerIrInstr.UnOp _ _ src _) (opt-const-globals-disq-value disq src)]
    [(CompilerIrInstr.LaneId _ _ _) disq]
    [(CompilerIrInstr.Splat _ value _ _)
      (opt-const-globals-disq-value disq value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq lhs)
            rhs)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq src)
            carry)])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-const-globals-disq-value disq src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq lhs)
            rhs)])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq lhs) rhs)]
    [(CompilerIrInstr.MaskNot _ src _) (opt-const-globals-disq-value disq src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (opt-const-globals-disq-value disq src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq mask)
              on-true)
            on-false)])]
    [(CompilerIrInstr.VectorLoad _ base idx _ _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq base)
        idx)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base idx value _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq base)
              idx)
            value)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload base idx value mask _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value
                (opt-const-globals-disq-value disq base)
                idx)
              value)
            mask)])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base idx mask _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq base)
              idx)
            mask)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload _ base index-base idx _ _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq base)
              index-base)
            idx)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-maybe
              (opt-const-globals-disq-value
                (opt-const-globals-disq-value disq source)
                selector-low)
              selector-high)
            active-lanes)])]
    [(CompilerIrInstr.TailMask _ idx length _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq idx)
        length)]
    [(CompilerIrInstr.EntryArgc _) disq]
    [(CompilerIrInstr.EntryArgv _) disq]
    [(CompilerIrInstr.EntryEnvp _) disq]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq leaf)
        subleaf)]
    [(CompilerIrInstr.Xgetbv _ idx) (opt-const-globals-disq-value disq idx)]
    [(CompilerIrInstr.Syscall _ args) (opt-const-globals-disq-args disq args)]
    [(CompilerIrInstr.Call _ _ args _) (opt-const-globals-disq-args disq args)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base _ args _)
          (opt-const-globals-disq-args
            (opt-const-globals-disq-value disq base)
            args)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (opt-const-globals-disq-spmd-args
            (opt-const-globals-disq-value disq active-mask)
            args)])]
    [(CompilerIrInstr.CallIndirect _ func args _)
      (opt-const-globals-disq-args
        (opt-const-globals-disq-value disq func)
        args)]
    [(CompilerIrInstr.CallIndirectC _ func args _)
      (opt-const-globals-disq-args
        (opt-const-globals-disq-value disq func)
        args)]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            _)
          (opt-const-globals-disq-args
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq base)
              func)
            args)])]
    [(CompilerIrInstr.TailCall _ args _)
      (opt-const-globals-disq-args disq args)]
    [(CompilerIrInstr.Store name value _)
      (begin
        (opt_i64_i64_map.insert-ref! (&mut disq) (compiler-ir-symbol-id name) 1)
        (opt-const-globals-disq-value disq value))]
    [(CompilerIrInstr.Jump _) disq]
    [(CompilerIrInstr.Branch cond _ _) (opt-const-globals-disq-value disq cond)]
    [(CompilerIrInstr.Return maybe) (opt-const-globals-disq-maybe disq maybe)]
    [(CompilerIrInstr.Phi _ inputs _) (opt-const-globals-disq-phi disq inputs)]
    [(CompilerIrInstr.Pack _ _ _) disq]
    [(CompilerIrInstr.Word _ src _ _) (opt-const-globals-disq-value disq src)]
    [(CompilerIrInstr.TailCallIndirect func args _)
      (opt-const-globals-disq-args
        (opt-const-globals-disq-value disq func)
        args)]
    [(CompilerIrInstr.Switch idx _ _ _) (opt-const-globals-disq-value disq idx)]))

(define (opt-const-globals-disq-seq-from
  [disq : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : opt_i64_i64_map.Map
  (if (>= index count)
    disq
    (opt-const-globals-disq-seq-from
      (opt-const-globals-disq-instr
        disq
        (compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1)
      count)))

(define (opt-const-globals-disq-blocks
  [disq : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]) : opt_i64_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) disq]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-const-globals-disq-blocks
            (opt-const-globals-disq-seq-from
              disq
              instrs
              0
              (compiler-ir-instr-seq-count instrs))
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (opt-const-globals-disq-blocks disq (compiler-ir-block-seq-to-list seq))]))

(define (opt-const-globals-disqualified
  [disq : opt_i64_i64_map.Map]
  [functions : CompilerIrFunctionList]) : opt_i64_i64_map.Map
  (match functions
    [(CompilerIrFunctionList.Nil) disq]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function _ _ _ _ blocks)
          (opt-const-globals-disqualified
            (opt-const-globals-disq-blocks disq blocks)
            (box-get rest))])]
    [(CompilerIrFunctionList.Array seq)
      (opt-const-globals-disqualified
        disq
        (compiler-ir-function-seq-to-list seq))]))

;; A constant only earns substitution when it fits a signed 32-bit immediate, so
;; the backend can fold it directly into the instruction (`and reg, $imm32`)
;; instead of loading it. A larger constant cannot be an immediate operand and
;; must be materialized with `movabs` at every use, which is no cheaper than --
;; and, when the original global load was hoisted/CSEd to a single load feeding
;; many uses, strictly worse than -- leaving the global alone. Restricting to
;; imm32 keeps the transform a pure win (it never adds instructions) and is what
;; kept the opt1 self-compile metric from regressing on the compiler's own large
;; constant globals.
(define (opt-const-globals-imm32-fits? [n : i64]) : bool
  (and (>= n (- 0 2147483648)) (<= n 2147483647)))

;; Build the constant table: literal `CompilerIrValue.I64` globals that are not
;; disqualified (stored / address-taken), are imm32-encodable, and are nonzero.
;; Zero is excluded so a substituted divisor can never become a literal `0` (the
;; backend's magic-multiply path assumes a nonzero divisor; an actual `% 0` keeps
;; its original trapping global-load form).
(define (opt-const-globals-from-globals
  [globals : CompilerIrGlobalList]
  [disq : opt_i64_i64_map.Map]
  [map : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match globals
    [(CompilerIrGlobalList.Nil) map]
    [(CompilerIrGlobalList.Cons global rest)
      (opt-const-globals-from-globals
        (box-get rest)
        disq
        (match global
          [(CompilerIrGlobal.Global name _ value)
            (match value
              [(CompilerIrValue.I64 n)
                (if (or
                  (= n 0)
                  (not (opt-const-globals-imm32-fits? n))
                  (opt_i64_i64_map.contains?
                    (& disq)
                    (compiler-ir-symbol-id name)))
                  map
                  (begin
                    (opt_i64_i64_map.insert-ref!
                      (&mut map)
                      (compiler-ir-symbol-id name)
                      n)
                    map))]
              [_ map])]))]
    [(CompilerIrGlobalList.Array seq)
      (opt-const-globals-from-global-seq seq 0 disq map)]))

(define (opt-const-globals-from-global-seq
  [globals : CompilerIrGlobalSeq]
  [index : i64]
  [disq : opt_i64_i64_map.Map]
  [map : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index (compiler-ir-global-seq-count globals))
    map
    (opt-const-globals-from-global-seq
      globals
      (+ index 1)
      disq
      (match (compiler-ir-global-seq-ref globals index)
        [(CompilerIrGlobal.Global name _ value)
          (match value
            [(CompilerIrValue.I64 n)
              (if (or
                (= n 0)
                (not (opt-const-globals-imm32-fits? n))
                (opt_i64_i64_map.contains?
                  (& disq)
                  (compiler-ir-symbol-id name)))
                map
                (begin
                  (opt_i64_i64_map.insert-ref!
                    (&mut map)
                    (compiler-ir-symbol-id name)
                    n)
                  map))]
            [_ map])]))))

(define (opt-const-divisors-build
  [globals : CompilerIrGlobalList]
  [functions : CompilerIrFunctionList]) : opt_i64_i64_map.Map
  (let
    [capacity : i64
      (opt-function-index-capacity (compiler-ir-global-list-count globals))]
    [disq : opt_i64_i64_map.Map
      (opt-const-globals-disqualified
        (opt_i64_i64_map.with-capacity capacity)
        functions)]
    (opt-const-globals-from-globals
      globals
      disq
      (opt_i64_i64_map.with-capacity capacity))))

;; The whole-program call summaries (argc-return + length-clean +
;; direct-call-clean + call-memory) gate on a function-count limit because they
;; scan function bodies across a fixpoint. The const-divisor table is independent
;; and far cheaper (one linear store scan), so it is built separately by the
;; program driver and injected here rather than tied to this gate -- see
;; optimize-program-with-level.
(define (opt-loop-bce-summary-function-limit) : i64
  ;; Dotted stdlib imports can leave small programs with more pre-prune reachable
  ;; functions than the old 64-function gate, even when the final program is still
  ;; tiny. Keep the fixpoint summary pass bounded, but high enough for those cases.
  1024)

(define (opt-loop-bce-build-summaries-with-direct-call-clean
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]
  [build-direct-call-clean : bool]
  [build-call-memory : bool]) : OptLoopBceSummaries
  (let
    [capacity : i64
      (opt-function-index-capacity (opt-function-list-count functions))]
    [argc-return : opt_i64_i64_map.Map
      (opt-loop-bce-argc-return-map
        type-segment-bases
        functions
        (opt_i64_i64_map.with-capacity capacity))]
    [length-clean : opt_i64_i64_map.Map
      (match (opt-loop-bce-length-clean-pass
        type-segment-bases
        functions
        (opt_i64_i64_map.with-capacity capacity))
        [(OptLoopBceCleanPass.Pass clean _) clean])]
    [direct-call-clean : opt_i64_i64_map.Map
      (if build-direct-call-clean
        (opt-loop-bce-direct-call-clean-map functions capacity)
        (opt_i64_i64_map.with-capacity 1))]
    [call-memory : opt_i64_i64_map.Map
      (if build-call-memory
        (opt-call-memory-build type-segment-bases functions capacity)
        (opt_i64_i64_map.with-capacity 1))]
    (OptLoopBceSummaries
      true
      (profile_state.compiler-profile-state-new)
      length-clean
      direct-call-clean
      call-memory
      argc-return
      (opt_i64_i64_map.with-capacity 1))))

(define (opt-loop-bce-summaries-set-const-divisors
  [summaries : OptLoopBceSummaries]
  [const-divisors : opt_i64_i64_map.Map]) : OptLoopBceSummaries
  (OptLoopBceSummaries
    (struct-get summaries enabled)
    (struct-get summaries profile-state)
    (struct-get summaries length-clean)
    (struct-get summaries direct-call-clean)
    (struct-get summaries call-memory)
    (struct-get summaries argc-return)
    const-divisors))

(define (opt-loop-bce-summaries-set-profile-state
  [summaries : OptLoopBceSummaries]
  [state : profile_state.CompilerProfileState]) : OptLoopBceSummaries
  (OptLoopBceSummaries
    (struct-get summaries enabled)
    state
    (struct-get summaries length-clean)
    (struct-get summaries direct-call-clean)
    (struct-get summaries call-memory)
    (struct-get summaries argc-return)
    (struct-get summaries const-divisors)))

;; Build the per-program summaries: the function-count-gated BCE/LICM call maps
;; plus the const-divisor table. The const-divisor table is built only at opt
;; level 2 (the only level whose pipeline runs the divisor rewrite), so opt0/opt1
;; -- and in particular the opt1 self-compile throughput metric -- pay nothing
;; for it and stay byte-identical.
(define (opt-build-program-summaries
  [type-segment-bases : i64]
  [globals : CompilerIrGlobalList]
  [reachable-functions : CompilerIrFunctionList]
  [level : i64]) : OptLoopBceSummaries
  (opt-loop-bce-summaries-set-const-divisors
    (if (<=
      (opt-function-list-count reachable-functions)
      (opt-loop-bce-summary-function-limit))
      (opt-loop-bce-build-summaries-with-direct-call-clean
        type-segment-bases
        reachable-functions
        (>= level 2)
        (>= level 1))
      (opt-loop-bce-empty-summaries))
    (if (>= level 2)
      (opt-const-divisors-build globals reachable-functions)
      (opt_i64_i64_map.with-capacity 1))))

;; Substitute a proven constant global with its literal value in
;; binop operands. For an ordinary operand this lets the backend fold the literal
;; instead of emitting a per-use rip-relative load (the opt_crc32/opt_quicksort
;; mask-load win). For a div/mod divisor it produces a literal `CompilerIrValue.I64`, which
;; `compiler-backend-binop-literal-divmod-asm` strength-reduces with the existing
;; magic-multiply path (matching clang). Binops are the const uses in the hot
;; loops of all three optimization benchmarks (masks via bit-and/bit-xor, the
;; modulo divisor); other instruction kinds keep the global's hidden-load form.
;; (The map is named `const-divisors` for historical reasons but now holds every
;; proven-constant global, not only divisors.)
(define (opt-const-global-subst-value
  [const-divisors : opt_i64_i64_map.Map]
  [v : CompilerIrValue]) : CompilerIrValue
  (match v
    [(CompilerIrValue.Global name)
      (match (opt_i64_i64_map.get
        (& const-divisors)
        (compiler-ir-symbol-id name))
        [(opt_i64_i64_map.LookupFound n) (CompilerIrValue.I64 n)]
        [(opt_i64_i64_map.LookupMissing) v])]
    [_ v]))

(define (opt-const-divisor-rewrite-instr
  [const-divisors : opt_i64_i64_map.Map]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (CompilerIrInstr.BinOp
        dst
        op
        (opt-const-global-subst-value const-divisors lhs)
        (opt-const-global-subst-value const-divisors rhs)
        ty)]
    [_ instr]))

;; One rewritten instruction per input instruction, so write straight into a
;; sized target sequence. The cons-and-reverse form this replaces allocated two
;; cells per instruction and then rebuilt the array it started from.
(define (opt-const-divisor-rewrite-seq
  [const-divisors : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [slots : (Array CompilerIrInstr) (array.make-array CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            slots
            index
            (opt-const-divisor-rewrite-instr
              const-divisors
              (compiler-ir-instr-seq-ref instrs index)))
          (set! index (+ index 1))))
      (CompilerIrInstrSeq slots count))))

(define (opt-const-divisor-rewrite-block
  [const-divisors : opt_i64_i64_map.Map]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (CompilerIrBlock.Block
        label
        (opt-const-divisor-rewrite-seq const-divisors instrs))]))

(define (opt-const-divisor-rewrite-blocks
  [const-divisors : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerIrBlockList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-const-divisor-rewrite-block const-divisors block)
        (opt-const-divisor-rewrite-blocks const-divisors (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-const-divisor-rewrite-blocks
        const-divisors
        (compiler-ir-block-seq-to-list seq))]))

;; Skip the whole pass (returning the blocks untouched) when no constant-global
;; divisor exists -- the common case, so the level-2 fixpoint pays only a length
;; check per function rather than a block walk.
(define (opt-const-divisor-rewrite-summary-blocks
  [summaries : OptLoopBceSummaries]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [const-divisors : opt_i64_i64_map.Map (struct-get summaries const-divisors)]
    (if (= (opt_i64_i64_map.len (& const-divisors)) 0)
      blocks
      (opt-const-divisor-rewrite-blocks const-divisors blocks))))

(define (optimize-program [program : CompilerIrProgram]) : CompilerIrProgram
  (optimize-program-with-level program (compiler-optimize-default-level)))

(define (optimize-program-with-reader-context-and-level-and-profile-state
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [level : i64]
  [profile-state : profile_state.CompilerProfileState]) : CompilerIrProgram
  (match program
    [(CompilerIrProgram.Program globals functions externs)
      (if (= level 0)
        program
        ;; Levels 1 (cheap) and 2 (quality) both prune unreachable functions;
        ;; opt-inline-program-functions runs the full inliner at level 2 and
        ;; the call-free tiny-leaf pass at level 1.
        (begin
          (cfg compile-profile (compiler-opt-profile-start profile-state))
          (let
            [reachable-functions : CompilerIrFunctionList
              (opt-inline-program-functions type-segment-bases functions level)]
            (begin
              (cfg
                compile-profile
                (compiler-opt-profile-finish profile-state "pre_prune"))
              (cfg compile-profile (compiler-opt-profile-start profile-state))
              (let
                [pruned : OptPrunedProgram
                  (opt-prune-unreachable-program
                    globals
                    reachable-functions
                    externs)]
                [pruned-globals : CompilerIrGlobalList
                  (opt-pruned-program-globals pruned)]
                [pruned-functions : CompilerIrFunctionList
                  (opt-pruned-program-functions pruned)]
                [summaries : OptLoopBceSummaries
                  (opt-loop-bce-summaries-set-profile-state
                    (opt-build-program-summaries
                      type-segment-bases
                      pruned-globals
                      pruned-functions
                      level)
                    profile-state)]
                [_load-cse-profile-reset : unit
                  (cfg
                    compile-profile
                    (compiler-opt-load-cse-profile-reset)
                    unit)]
                [optimized-functions : CompilerIrFunctionList
                  (optimize-function-list-with-level-and-summaries
                    pools
                    type-segment-bases
                    pruned-functions
                    level
                    summaries)]
                (begin
                  (cfg
                    compile-profile
                    (compiler-opt-profile-finish profile-state "functions"))
                  (cfg
                    compile-profile-summary
                    (compiler-opt-profile-summary-emit
                      (struct-get summaries profile-state)))
                  (cfg compile-profile (compiler-opt-load-cse-profile-emit))
                  (cfg
                    compile-profile
                    (compiler-opt-profile-start profile-state))
                  (let
                    [final-pruned
                      : OptPrunedProgram
                      ;; Keep scanning the original global initializers so a
                      ;; function referenced only from one still follows the
                      ;; existing reachability rule even if that global is
                      ;; later filtered from the emitted program.
                      (opt-prune-unreachable-program
                        globals
                        optimized-functions
                        externs)]
                    [final-globals : CompilerIrGlobalList
                      (opt-pruned-program-globals final-pruned)]
                    [final-functions : CompilerIrFunctionList
                      (opt-pruned-program-functions final-pruned)]
                    [scratch-reset-functions : CompilerIrFunctionList
                      (opt-scratch-reset-function-list-with-level
                        type-segment-bases
                        final-functions
                        level)]
                    [paired-bounds-functions : CompilerIrFunctionList
                      (if (< level 2)
                        scratch-reset-functions
                        (opt-late-bounds-pair-function-list
                          type-segment-bases
                          scratch-reset-functions))]
                    [total-switch-functions : CompilerIrFunctionList
                      (if (< level 2)
                        paired-bounds-functions
                        (opt-late-total-switch-function-list
                          type-segment-bases
                          paired-bounds-functions))]
                    (begin
                      (cfg
                        compile-profile
                        (compiler-opt-profile-finish profile-state "post_prune"))
                      (CompilerIrProgram.Program
                        final-globals
                        (compiler-ir-function-list-compact
                          total-switch-functions)
                        externs)))))))))]))

(define (optimize-program-with-reader-context-and-level
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [level : i64]) : CompilerIrProgram
  (optimize-program-with-reader-context-and-level-and-profile-state
    pools
    type-segment-bases
    program
    level
    (profile_state.compiler-profile-state-new)))

(define (optimize-program-with-level
  [program : CompilerIrProgram]
  [level : i64]) : CompilerIrProgram
  (let
    [pools : AstNodePoolContext (ast-node-pool-reader-context-current)]
    (optimize-program-with-reader-context-and-level
      pools
      (ast-node-pool-context-type-segment-bases pools)
      program
      level)))

(define (opt-remap-spans-prepend-entry
  [spans : CompilerSourceSpans]
  [key : CompilerSourceSpansInstrKey]
  [path-id : i64]
  [span : AstSourceSpan]) : CompilerSourceSpans
  (compiler-source-spans-insert-instr-entry-located spans key path-id span))

;; Span keys are typed (function id, var/name id) pairs, so building one is a
;; couple of integer moves and probing an entry is two integer compares; only
;; instructions whose kind can carry a span build a key at all. The key arms
;; mirror the kinds the replaced per-instruction prepend matcher accepted:
;; indirect-call destinations were looked up and then dropped by its
;; fall-through, so skipping their lookups cannot change the produced spans.
;; The entry-list probe stays the linear first-match scan: entries are
;; bounded by the 2049 fast-path cutoff.
(defenum OptRemapSpanKey
  (NoKey)
  (SomeKey CompilerSourceSpansInstrKey))

(define (opt-remap-spans-instr-key [function : i64] [instr : CompilerIrInstr]) : OptRemapSpanKey
  (match instr
    [(CompilerIrInstr.Mov dst _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Alloc dst _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.AddrOf dst _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Gep dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Load dst _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Cast dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Bitcast dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.BinOp dst _ _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.UnOp dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.LaneId dst _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Splat dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload dst _ _ _ _ _)
          (OptRemapSpanKey.SomeKey
            (CompilerSourceSpansInstrKey.Value function dst))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload dst _ _ _ _ _)
          (OptRemapSpanKey.SomeKey
            (CompilerSourceSpansInstrKey.Value function dst))])]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload dst _ _ _ _ _)
          (OptRemapSpanKey.SomeKey
            (CompilerSourceSpansInstrKey.Value function dst))])]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.MaskNot dst _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.MaskReduce dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload dst _ _ _ _ _)
          (OptRemapSpanKey.SomeKey
            (CompilerSourceSpansInstrKey.Value function dst))])]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
          (OptRemapSpanKey.SomeKey
            (CompilerSourceSpansInstrKey.Value function dst))])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
          (OptRemapSpanKey.SomeKey
            (CompilerSourceSpansInstrKey.Value function dst))])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
          (OptRemapSpanKey.SomeKey
            (CompilerSourceSpansInstrKey.Value function dst))])]
    [(CompilerIrInstr.TailMask dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.EntryArgc dst)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.EntryArgv dst)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.EntryEnvp dst)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.CpuId dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Xgetbv dst _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Syscall dst _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Call dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ result)
          (match result
            [(CompilerIrSpmdCallResult.Unit) (OptRemapSpanKey.NoKey)]
            [(CompilerIrSpmdCallResult.Value dst _ _)
              (OptRemapSpanKey.SomeKey
                (CompilerSourceSpansInstrKey.Value function dst))])])]
    [(CompilerIrInstr.Pack dst _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [(CompilerIrInstr.Word dst _ _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    ;; Tail-indirect is control flow and does not define a destination value.
    [(CompilerIrInstr.TailCallIndirect _ _ _) (OptRemapSpanKey.NoKey)]
    [(CompilerIrInstr.Store name _ _)
      (OptRemapSpanKey.SomeKey
        (CompilerSourceSpansInstrKey.Store function name))]
    [(CompilerIrInstr.Phi dst _ _)
      (OptRemapSpanKey.SomeKey (CompilerSourceSpansInstrKey.Value function dst))]
    [_ (OptRemapSpanKey.NoKey)]))

(define (opt-remap-spans-instr
  [instr-entries : CompilerSourceSpansInstrEntryList]
  [out : CompilerSourceSpans]
  [function : i64]
  [instr : CompilerIrInstr]) : CompilerSourceSpans
  (match (opt-remap-spans-instr-key function instr)
    [(OptRemapSpanKey.NoKey) out]
    [(OptRemapSpanKey.SomeKey key)
      (if (compiler-debug-info-enabled?)
        (match (compiler-source-spans-instr-entry-list-lookup instr-entries key)
          [(CompilerMaybeSourceLocation.Some
              (CompilerSourceLocation path-id span))
            (opt-remap-spans-prepend-entry out key path-id span)]
          [(CompilerMaybeSourceLocation.No) out])
        (match (compiler-source-spans-instr-entry-list-lookup-span
          instr-entries
          key)
          [(CompilerMaybeSourceSpan.Some span)
            (compiler-source-spans-insert-instr-entry out key span)]
          [(CompilerMaybeSourceSpan.No) out]))]))

(define (opt-remap-spans-instr-seq-from
  [instr-entries : CompilerSourceSpansInstrEntryList]
  [out : CompilerSourceSpans]
  [function : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerSourceSpans
  (if (>= index (compiler-ir-instr-seq-count instrs))
    out
    (opt-remap-spans-instr-seq-from
      instr-entries
      (opt-remap-spans-instr
        instr-entries
        out
        function
        (compiler-ir-instr-seq-ref instrs index))
      function
      instrs
      (+ index 1))))

(define (opt-remap-spans-instr-seq
  [instr-entries : CompilerSourceSpansInstrEntryList]
  [out : CompilerSourceSpans]
  [function : i64]
  [instrs : CompilerIrInstrSeq]) : CompilerSourceSpans
  (opt-remap-spans-instr-seq-from instr-entries out function instrs 0))

(define (opt-remap-spans-blocks
  [instr-entries : CompilerSourceSpansInstrEntryList]
  [out : CompilerSourceSpans]
  [function : i64]
  [blocks : CompilerIrBlockList]) : CompilerSourceSpans
  (match blocks
    [(CompilerIrBlockList.Nil) out]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-remap-spans-blocks
            instr-entries
            (opt-remap-spans-instr-seq instr-entries out function instrs)
            function
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (opt-remap-spans-blocks
        instr-entries
        out
        function
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-remap-spans-function
  [instr-entries : CompilerSourceSpansInstrEntryList]
  [out : CompilerSourceSpans]
  [func : CompilerIrFunction]) : CompilerSourceSpans
  (match func
    [(CompilerIrFunction.Function name _ _ _ blocks)
      (opt-remap-spans-blocks instr-entries out name blocks)]))

(define (opt-remap-spans-functions
  [instr-entries : CompilerSourceSpansInstrEntryList]
  [out : CompilerSourceSpans]
  [funcs : CompilerIrFunctionList]) : CompilerSourceSpans
  (match funcs
    [(CompilerIrFunctionList.Nil) out]
    [(CompilerIrFunctionList.Cons func rest)
      (opt-remap-spans-functions
        instr-entries
        (opt-remap-spans-function instr-entries out func)
        (box-get rest))]
    [(CompilerIrFunctionList.Array seq)
      (opt-remap-spans-functions
        instr-entries
        out
        (compiler-ir-function-seq-to-list seq))]))

(define (opt-remap-spans-fast-path? [source-spans : CompilerSourceSpans]) : bool
  (and
    (not (compiler-debug-info-enabled?))
    (compiler-source-spans-instr-count-at-least? source-spans 2049)))

(define (opt-remap-spans-program
  [source-spans : CompilerSourceSpans]
  [program : CompilerIrProgram]) : CompilerSourceSpans
  (if (opt-remap-spans-fast-path? source-spans)
    (compiler-source-spans-clear-instrs source-spans)
    (match source-spans
      [(CompilerSourceSpans.Spans _ instr-entries _)
        (match program
          [(CompilerIrProgram.Program _ functions _)
            (opt-remap-spans-functions
              instr-entries
              (compiler-source-spans-clear-instrs source-spans)
              functions)])])))

(define (optimize-program-with-spans-and-reader-context-and-level-and-profile-state
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [level : i64]
  [profile-state : profile_state.CompilerProfileState]) : CompilerOptimizedProgram
  (match program
    [(CompilerIrProgram.Program globals functions externs)
      (if (= level 0)
        (CompilerOptimizedProgram.Program
          (compiler-opt-debug-finish-program program)
          (opt-remap-spans-program spans program))
        (begin
          (cfg compile-profile (compiler-opt-profile-start profile-state))
          (match (opt-inline-program-functions-with-spans
            type-segment-bases
            functions
            level
            spans)
            [(OptInlineSpanProgram.Program reachable-functions inline-spans)
              (begin
                (cfg
                  compile-profile
                  (compiler-opt-profile-finish profile-state "pre_prune"))
                (cfg compile-profile (compiler-opt-profile-start profile-state))
                (let
                  [pruned : OptPrunedProgram
                    (opt-prune-unreachable-program
                      globals
                      reachable-functions
                      externs)]
                  [pruned-globals : CompilerIrGlobalList
                    (opt-pruned-program-globals pruned)]
                  [pruned-functions : CompilerIrFunctionList
                    (opt-pruned-program-functions pruned)]
                  [summaries : OptLoopBceSummaries
                    (opt-loop-bce-summaries-set-profile-state
                      (opt-build-program-summaries
                        type-segment-bases
                        pruned-globals
                        pruned-functions
                        level)
                      profile-state)]
                  [_load-cse-profile-reset : unit
                    (cfg
                      compile-profile
                      (compiler-opt-load-cse-profile-reset)
                      unit)]
                  [optimized-functions : CompilerIrFunctionList
                    (optimize-function-list-with-level-and-summaries
                      pools
                      type-segment-bases
                      pruned-functions
                      level
                      summaries)]
                  (begin
                    (cfg
                      compile-profile
                      (compiler-opt-profile-finish profile-state "functions"))
                    (cfg
                      compile-profile-summary
                      (compiler-opt-profile-summary-emit
                        (struct-get summaries profile-state)))
                    (cfg compile-profile (compiler-opt-load-cse-profile-emit))
                    (cfg
                      compile-profile
                      (compiler-opt-profile-start profile-state))
                    (let
                      [final-pruned
                        : OptPrunedProgram
                        ;; Keep scanning the original global initializers so a
                        ;; function referenced only from one still follows the
                        ;; existing reachability rule even if that global is
                        ;; later filtered from the emitted program.
                        (opt-prune-unreachable-program
                          globals
                          optimized-functions
                          externs)]
                      [final-globals : CompilerIrGlobalList
                        (opt-pruned-program-globals final-pruned)]
                      [final-functions : CompilerIrFunctionList
                        (opt-pruned-program-functions final-pruned)]
                      [scratch-reset-functions : CompilerIrFunctionList
                        (opt-scratch-reset-function-list-with-level
                          type-segment-bases
                          final-functions
                          level)]
                      [paired-bounds-functions : CompilerIrFunctionList
                        (if (< level 2)
                          scratch-reset-functions
                          (opt-late-bounds-pair-function-list
                            type-segment-bases
                            scratch-reset-functions))]
                      [total-switch-functions : CompilerIrFunctionList
                        (if (< level 2)
                          paired-bounds-functions
                          (opt-late-total-switch-function-list
                            type-segment-bases
                            paired-bounds-functions))]
                      [optimized : CompilerIrProgram
                        (CompilerIrProgram.Program
                          final-globals
                          (compiler-ir-function-list-compact
                            total-switch-functions)
                          externs)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-opt-profile-finish
                            profile-state
                            "post_prune"))
                        (CompilerOptimizedProgram.Program
                          (compiler-opt-debug-finish-program optimized)
                          (opt-remap-spans-program inline-spans optimized)))))))])))]))

(define (optimize-program-with-spans-and-reader-context-and-level
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [level : i64]) : CompilerOptimizedProgram
  (optimize-program-with-spans-and-reader-context-and-level-and-profile-state
    pools
    type-segment-bases
    program
    spans
    level
    (profile_state.compiler-profile-state-new)))

(define (optimize-program-with-spans-and-level
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [level : i64]) : CompilerOptimizedProgram
  (let
    [pools : AstNodePoolContext (ast-node-pool-reader-context-current)]
    (optimize-program-with-spans-and-reader-context-and-level
      pools
      (ast-node-pool-context-type-segment-bases pools)
      program
      spans
      level)))

(define (optimize-program-with-spans-and-pools-and-level
  [pools : AstNodePoolContext]
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [level : i64]) : CompilerOptimizedProgram
  (optimize-program-with-spans-and-reader-context-and-level
    pools
    (ast-node-pool-context-type-segment-bases pools)
    program
    spans
    level))

(define (optimize-program-with-spans-and-pools-and-level-and-profile-state
  [pools : AstNodePoolContext]
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [level : i64]
  [profile-state : profile_state.CompilerProfileState]) : CompilerOptimizedProgram
  (optimize-program-with-spans-and-reader-context-and-level-and-profile-state
    pools
    (ast-node-pool-context-type-segment-bases pools)
    program
    spans
    level
    profile-state))

(define (optimize-program-with-spans
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]) : CompilerOptimizedProgram
  (optimize-program-with-spans-and-level
    program
    spans
    (compiler-optimize-default-level)))

(define (opt-function-blocks [func : CompilerIrFunction]) : CompilerIrBlockList
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks) blocks]))

(define (opt-function-frame [func : CompilerIrFunction]) : i64
  (match func
    [(CompilerIrFunction.Function _ _ _ frame _) frame]))

;; --- noalias / alias fact model ---------------------------------------------
;;
;; Optimizer-internal alias facts for IR temporaries. This section models facts
;; and conservative invalidation, proves the conservatism with self-tests, and
;; feeds the local redundant-load CSE consumer.
;;
;; A fact binds an IR temporary (var id) to one of six deliberately
;; conservative kinds:
;;   - Unique epoch : a freshly allocated root no other tracked pointer aliases,
;;                    tagged with the allocation epoch (the load-GVN state's
;;                    allocation counter at the moment the allocation ran; the
;;                    scratch/report consumer has no counter and passes 0)
;;   - ExclusiveRef : a checked mutable-reference parameter root; no other
;;                    checked root in the function may alias it
;;   - SharedRef    : a checked immutable-reference parameter root; another
;;                    SharedRef root MAY designate the same storage
;;   - Derived base : a pointer derived from root/base var `base` by safe
;;                    pointer arithmetic (Gep); it aliases only that root's
;;                    allocation/reference storage
;;   - MayAlias     : unknown provenance; may alias anything tracked
;;   - Invalidated  : a previously known fact a memory effect explicitly cleared
;;
;; Invalidation keys off `compiler-ir-instr-effect`: pure instructions keep the
;; surrounding facts (and (re)bind only their destination), memory reads keep
;; facts (the loaded value itself is MayAlias), and any instruction that can
;; mutate or unknown-observe memory (stores, vector/predicated stores, direct
;; and indirect calls, tail calls) conservatively clears ALL facts rather than
;; assuming C-style noalias. Control-flow joins intersect the per-edge sets.
(defenum OptAliasKind
  (Unique i64)
  (ExclusiveRef)
  (SharedRef)
  (Derived i64)
  (MayAlias)
  (Invalidated))

;; Alias facts live in a mutable i64->i64 hashmap keyed by var id.
;; Kinds pack into the value: a Derived root is its non-negative root var id,
;; the kind-only variants take negative codes, and Unique(epoch) takes the
;; open-ended range at or below -6 (epoch >= 0). State is threaded linearly
;; through a block (helpers mutate and return the same table); control-flow
;; joins and clears build a fresh table, so retained per-block exit states
;; are never aliased by a successor's mutations.
(defenum OptAliasFacts
  (Facts opt_i64_i64_map.Map))

(define (opt-alias-empty) : OptAliasFacts
  (OptAliasFacts.Facts (opt_i64_i64_map.with-capacity 17)))

;; Unique(epoch) encodes as -(6 + epoch), so -1 is no longer produced by any
;; kind; a stale -1 (or the unused -5) decodes to the conservative Invalidated.
(define (opt-alias-kind-encode [kind : OptAliasKind]) : i64
  (match kind
    [(OptAliasKind.Unique epoch) (- 0 (+ 6 epoch))]
    [(OptAliasKind.ExclusiveRef) -2]
    [(OptAliasKind.SharedRef) -3]
    [(OptAliasKind.MayAlias) -4]
    [(OptAliasKind.Invalidated) -5]
    [(OptAliasKind.Derived root) root]))

(define (opt-alias-kind-decode [value : i64]) : OptAliasKind
  (cond
    [(>= value 0) (OptAliasKind.Derived value)]
    [(= value -2) (OptAliasKind.ExclusiveRef)]
    [(= value -3) (OptAliasKind.SharedRef)]
    [(= value -4) (OptAliasKind.MayAlias)]
    [(<= value -6) (OptAliasKind.Unique (- (- 0 value) 6))]
    [else (OptAliasKind.Invalidated)]))

(defenum OptMaybeAliasKind
  (No)
  (Some OptAliasKind))

(define (opt-alias-kind-eq [a : OptAliasKind] [b : OptAliasKind]) : bool
  (match a
    [(OptAliasKind.Unique ea)
      (match b
        [(OptAliasKind.Unique eb) (= ea eb)]
        [_ false])]
    [(OptAliasKind.ExclusiveRef)
      (match b
        [(OptAliasKind.ExclusiveRef) true]
        [_ false])]
    [(OptAliasKind.SharedRef)
      (match b
        [(OptAliasKind.SharedRef) true]
        [_ false])]
    [(OptAliasKind.Derived ba)
      (match b
        [(OptAliasKind.Derived bb) (= ba bb)]
        [_ false])]
    [(OptAliasKind.MayAlias)
      (match b
        [(OptAliasKind.MayAlias) true]
        [_ false])]
    [(OptAliasKind.Invalidated)
      (match b
        [(OptAliasKind.Invalidated) true]
        [_ false])]))

(define (opt-alias-lookup [facts : OptAliasFacts] [var : i64]) : OptMaybeAliasKind
  (match facts
    [(OptAliasFacts.Facts map)
      (match (opt_i64_i64_map.get (& map) var)
        [(opt_i64_i64_map.LookupFound value)
          (OptMaybeAliasKind.Some (opt-alias-kind-decode value))]
        [(opt_i64_i64_map.LookupMissing) (OptMaybeAliasKind.No)])]))

(define (opt-alias-remove-var [facts : OptAliasFacts] [var : i64]) : OptAliasFacts
  (match facts
    [(OptAliasFacts.Facts map)
      (let
        [out : opt_i64_i64_map.Map map]
        (begin
          (opt_i64_i64_map.remove-ref! (&mut out) var)
          (OptAliasFacts.Facts out)))]))

(define (opt-alias-bind
  [facts : OptAliasFacts]
  [var : i64]
  [kind : OptAliasKind]) : OptAliasFacts
  (match facts
    [(OptAliasFacts.Facts map)
      (let
        [out : opt_i64_i64_map.Map map]
        (begin
          (opt_i64_i64_map.insert-ref!
            (&mut out)
            var
            (opt-alias-kind-encode kind))
          (OptAliasFacts.Facts out)))]))

(define (opt-alias-mark-unique
  [facts : OptAliasFacts]
  [var : i64]
  [epoch : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.Unique epoch)))

(define (opt-alias-mark-exclusive-ref [facts : OptAliasFacts] [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.ExclusiveRef)))

(define (opt-alias-mark-shared-ref [facts : OptAliasFacts] [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.SharedRef)))

(define (opt-alias-mark-may-alias [facts : OptAliasFacts] [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.MayAlias)))

(define (opt-alias-mark-invalidated [facts : OptAliasFacts] [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.Invalidated)))

;; Copy a value's fact onto `dst` (Mov/Cast of a tracked var). Root facts become
;; Derived(root) so aliases of one root retain one canonical identity; blindly
;; copying Unique/ExclusiveRef would incorrectly make the copy look disjoint.
;; An untracked source conservatively yields a MayAlias destination.
(define (opt-alias-copy-var [facts : OptAliasFacts] [dst : i64] [src : i64]) : OptAliasFacts
  (match (opt-alias-lookup facts src)
    [(OptMaybeAliasKind.Some kind)
      (if (= dst src)
        facts
        (match kind
          [(OptAliasKind.Unique _)
            (opt-alias-bind facts dst (OptAliasKind.Derived src))]
          [(OptAliasKind.ExclusiveRef)
            (opt-alias-bind facts dst (OptAliasKind.Derived src))]
          [(OptAliasKind.SharedRef)
            (opt-alias-bind facts dst (OptAliasKind.Derived src))]
          [(OptAliasKind.Derived root)
            (opt-alias-bind facts dst (OptAliasKind.Derived root))]
          [(OptAliasKind.MayAlias) (opt-alias-mark-may-alias facts dst)]
          [(OptAliasKind.Invalidated) (opt-alias-mark-may-alias facts dst)]))]
    [(OptMaybeAliasKind.No) (opt-alias-mark-may-alias facts dst)]))

;; Derive `dst` through safe pointer arithmetic (Gep) from base var `base`.
;; A unique or already-derived base propagates the underlying root; anything
;; else is conservatively MayAlias.
(define (opt-alias-derive-var [facts : OptAliasFacts] [dst : i64] [base : i64]) : OptAliasFacts
  (match (opt-alias-lookup facts base)
    [(OptMaybeAliasKind.Some kind)
      (match kind
        [(OptAliasKind.Unique _)
          (opt-alias-bind facts dst (OptAliasKind.Derived base))]
        [(OptAliasKind.ExclusiveRef)
          (opt-alias-bind facts dst (OptAliasKind.Derived base))]
        [(OptAliasKind.SharedRef)
          (opt-alias-bind facts dst (OptAliasKind.Derived base))]
        [(OptAliasKind.Derived root)
          (opt-alias-bind facts dst (OptAliasKind.Derived root))]
        [(OptAliasKind.MayAlias) (opt-alias-mark-may-alias facts dst)]
        [(OptAliasKind.Invalidated) (opt-alias-mark-may-alias facts dst)])]
    [(OptMaybeAliasKind.No) (opt-alias-mark-may-alias facts dst)]))

(define (opt-alias-contains?
  [facts : OptAliasFacts]
  [var : i64]
  [kind : OptAliasKind]) : bool
  (match (opt-alias-lookup facts var)
    [(OptMaybeAliasKind.Some found) (opt-alias-kind-eq found kind)]
    [(OptMaybeAliasKind.No) false]))

(define (opt-alias-absent? [facts : OptAliasFacts] [var : i64]) : bool
  (match (opt-alias-lookup facts var)
    [(OptMaybeAliasKind.No) true]
    [(OptMaybeAliasKind.Some _) false]))

;; A Fresh root carries (canonical root var, allocation epoch); the other roots
;; are parameter storage that predates every allocation and carry no epoch.
(defenum OptAliasRoot
  (NoRoot)
  (Fresh i64 i64)
  (Exclusive i64)
  (Shared i64))

(define (opt-alias-root-from-kind
  [facts : OptAliasFacts]
  [var : i64]
  [kind : OptAliasKind]) : OptAliasRoot
  (match kind
    [(OptAliasKind.Unique epoch) (OptAliasRoot.Fresh var epoch)]
    [(OptAliasKind.ExclusiveRef) (OptAliasRoot.Exclusive var)]
    [(OptAliasKind.SharedRef) (OptAliasRoot.Shared var)]
    [(OptAliasKind.Derived root)
      (match (opt-alias-lookup facts root)
        [(OptMaybeAliasKind.Some root-kind)
          (match root-kind
            [(OptAliasKind.Unique epoch) (OptAliasRoot.Fresh root epoch)]
            [(OptAliasKind.ExclusiveRef) (OptAliasRoot.Exclusive root)]
            [(OptAliasKind.SharedRef) (OptAliasRoot.Shared root)]
            [_ (OptAliasRoot.NoRoot)])]
        [(OptMaybeAliasKind.No) (OptAliasRoot.NoRoot)])]
    [(OptAliasKind.MayAlias) (OptAliasRoot.NoRoot)]
    [(OptAliasKind.Invalidated) (OptAliasRoot.NoRoot)]))

(define (opt-alias-root-of-var [facts : OptAliasFacts] [var : i64]) : OptAliasRoot
  (match (opt-alias-lookup facts var)
    [(OptMaybeAliasKind.Some kind) (opt-alias-root-from-kind facts var kind)]
    [(OptMaybeAliasKind.No) (OptAliasRoot.NoRoot)]))

(define (opt-alias-root-of-value
  [facts : OptAliasFacts]
  [value : CompilerIrValue]) : OptAliasRoot
  (match value
    [(CompilerIrValue.Var var) (opt-alias-root-of-var facts var)]
    [_ (OptAliasRoot.NoRoot)]))

;; Only fresh allocations and checked mutable-reference roots prove a write
;; target disjoint from a DIFFERENT tracked root. SharedRef roots deliberately
;; do not: separate immutable-reference parameters may alias each other.
;; Allocation epochs play no part here -- root identity alone decides. The
;; epoch-ordering rule is a separate disjunct in the load-table keep test.
(define (opt-alias-store-root-disjoint?
  [store-root : OptAliasRoot]
  [entry-root : OptAliasRoot]) : bool
  (match store-root
    [(OptAliasRoot.Fresh store-id _)
      (match entry-root
        [(OptAliasRoot.Fresh entry-id _) (not (= store-id entry-id))]
        [(OptAliasRoot.Exclusive entry-id) (not (= store-id entry-id))]
        [(OptAliasRoot.Shared entry-id) (not (= store-id entry-id))]
        [(OptAliasRoot.NoRoot) false])]
    [(OptAliasRoot.Exclusive store-id)
      (match entry-root
        [(OptAliasRoot.Fresh entry-id _) (not (= store-id entry-id))]
        [(OptAliasRoot.Exclusive entry-id) (not (= store-id entry-id))]
        [(OptAliasRoot.Shared entry-id) (not (= store-id entry-id))]
        [(OptAliasRoot.NoRoot) false])]
    [(OptAliasRoot.Shared _) false]
    [(OptAliasRoot.NoRoot) false]))

(defenum OptAliasParamRootKind
  (NotCheckedRef)
  (SharedCheckedRef)
  (ExclusiveCheckedRef))

(define (opt-alias-param-root-kind [type-segment-bases : i64] [ty : AstType]) : OptAliasParamRootKind
  (match ty
    [(AstType.Ref _ _) (OptAliasParamRootKind.SharedCheckedRef)]
    [(AstType.MutRef _ _) (OptAliasParamRootKind.ExclusiveCheckedRef)]
    [(AstType.Region _ inner)
      (opt-alias-param-root-kind
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [_ (OptAliasParamRootKind.NotCheckedRef)]))

(define (opt-alias-seed-param
  [type-segment-bases : i64]
  [facts : OptAliasFacts]
  [param : CompilerIrParam]) : OptAliasFacts
  (match param
    [(CompilerIrParam.Param _ ty var)
      (match (opt-alias-param-root-kind type-segment-bases ty)
        [(OptAliasParamRootKind.SharedCheckedRef)
          (opt-alias-mark-shared-ref facts var)]
        [(OptAliasParamRootKind.ExclusiveCheckedRef)
          (opt-alias-mark-exclusive-ref facts var)]
        [(OptAliasParamRootKind.NotCheckedRef) facts])]))

(define (opt-alias-seed-param-seq
  [type-segment-bases : i64]
  [params : CompilerIrParamSeq]
  [index : i64]
  [facts : OptAliasFacts]) : OptAliasFacts
  (if (>= index (compiler-ir-param-seq-count params))
    facts
    (opt-alias-seed-param-seq
      type-segment-bases
      params
      (+ index 1)
      (opt-alias-seed-param
        type-segment-bases
        facts
        (compiler-ir-param-seq-ref params index)))))

(define (opt-alias-seed-params-from
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [facts : OptAliasFacts]) : OptAliasFacts
  (match params
    [(CompilerIrParamList.Nil) facts]
    [(CompilerIrParamList.Array seq)
      (opt-alias-seed-param-seq type-segment-bases seq 0 facts)]
    [(CompilerIrParamList.Cons param rest)
      (opt-alias-seed-params-from
        type-segment-bases
        (box-get rest)
        (opt-alias-seed-param type-segment-bases facts param))]))

(define (opt-alias-seed-params
  [type-segment-bases : i64]
  [params : CompilerIrParamList]) : OptAliasFacts
  (opt-alias-seed-params-from type-segment-bases params (opt-alias-empty)))

;; Conservative control-flow join: keep only facts that appear with an
;; identical kind on both incoming edges.
(define (opt-alias-intersect [a : OptAliasFacts] [b : OptAliasFacts]) : OptAliasFacts
  (match a
    [(OptAliasFacts.Facts amap)
      (match b
        [(OptAliasFacts.Facts bmap)
          (let
            [out : OptAliasFacts (opt-alias-empty)]
            [capacity : i64 (opt_i64_i64_map.capacity (& amap))]
            [i : i64 (opt_i64_i64_map.next-occupied (& amap) 0)]
            (begin
              (while (< i capacity)
                (begin
                  (match (opt_i64_i64_map.entry-at (& amap) i)
                    [(opt_i64_i64_map.EntrySome var value)
                      (match (opt_i64_i64_map.get (& bmap) var)
                        [(opt_i64_i64_map.LookupFound bvalue)
                          (if (= value bvalue)
                            (set!
                              out
                              (opt-alias-bind
                                out
                                var
                                (opt-alias-kind-decode value)))
                            unit)]
                        [(opt_i64_i64_map.LookupMissing) unit])]
                    [(opt_i64_i64_map.EntryNone) unit])
                  (set! i (opt_i64_i64_map.next-occupied (& amap) (+ i 1)))))
              out))])]))

(define (opt-alias-facts-len [facts : OptAliasFacts]) : i64
  (match facts
    [(OptAliasFacts.Facts map) (opt_i64_i64_map.len (& map))]))

;; Deep-copy the fact table. Per-block exit states are retained for every
;; successor's entry intersection, so a single-predecessor entry must not
;; alias (and then mutate) its predecessor's stored exit state.
(define (opt-alias-clone [facts : OptAliasFacts]) : OptAliasFacts
  (match facts
    [(OptAliasFacts.Facts map)
      (let
        [out : opt_i64_i64_map.Map
          (opt_i64_i64_map.with-capacity
            (+ (* (opt_i64_i64_map.len (& map)) 2) 17))]
        [capacity : i64 (opt_i64_i64_map.capacity (& map))]
        [i : i64 (opt_i64_i64_map.next-occupied (& map) 0)]
        (begin
          (while (< i capacity)
            (begin
              (match (opt_i64_i64_map.entry-at (& map) i)
                [(opt_i64_i64_map.EntrySome var value)
                  (opt_i64_i64_map.insert-ref! (&mut out) var value)]
                [(opt_i64_i64_map.EntryNone) unit])
              (set! i (opt_i64_i64_map.next-occupied (& map) (+ i 1)))))
          (OptAliasFacts.Facts out)))]))

;; A memory effect that can mutate or unknown-observe memory clears all facts.
;; `Alloc` is the one MemoryWrite that instead binds a fresh unique root, so it
;; is excluded by the caller below.
(define (opt-alias-effect-clears-facts? [effect : CompilerIrEffect]) : bool
  (match effect
    [(CompilerIrEffect.Pure) false]
    [(CompilerIrEffect.MemoryRead) false]
    [(CompilerIrEffect.CpuProbe) true]
    [(CompilerIrEffect.MemoryWrite) true]
    [(CompilerIrEffect.ControlFlow) false]
    [(CompilerIrEffect.Unknown) true]))

;; True when the instruction conservatively clears ALL alias facts. The
;; call family is listed explicitly because a tail call carries a control-flow
;; IR effect yet still mutates memory; `Alloc` is excluded because it binds a
;; unique root instead of clearing.
(define (opt-alias-instr-clears-all? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Alloc _ _) false]
    [(CompilerIrInstr.Call _ _ _ _) true]
    [(CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ _ _ _) true])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload _ _ _ _)
          true])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ _) true])]
    [(CompilerIrInstr.TailCall _ _ _) true]
    [(CompilerIrInstr.TailCallIndirect _ _ _) true]
    [_ (opt-alias-effect-clears-facts? (compiler-ir-instr-effect instr))]))

(define (opt-alias-update-gep
  [facts : OptAliasFacts]
  [dst : i64]
  [base : CompilerIrValue]) : OptAliasFacts
  (match base
    [(CompilerIrValue.Var base-var) (opt-alias-derive-var facts dst base-var)]
    [_ (opt-alias-mark-may-alias facts dst)]))

(define (opt-alias-update-copy
  [facts : OptAliasFacts]
  [dst : i64]
  [value : CompilerIrValue]) : OptAliasFacts
  (match value
    [(CompilerIrValue.Var src) (opt-alias-copy-var facts dst src)]
    [_ (opt-alias-mark-may-alias facts dst)]))

;; True for the two instruction shapes that create storage that did not exist
;; before them: a frame `Alloc` and a direct `tl_alloc` runtime call. The
;; load-GVN state opens a new allocation epoch for exactly these.
(define (opt-alias-instr-fresh-alloc? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Alloc _ _) true]
    [(CompilerIrInstr.Call _ name _ _)
      (compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)]
    [_ false]))

;; Value/provenance transfer independent of memory invalidation. Every
;; definition first removes an older binding for the reused var id; recognized
;; pointer producers then bind the new value. This matters in the pre-SSA local
;; pipeline, where a scalar BinOp may reuse a former pointer var id.
;;
;; `epoch` is the allocation epoch to tag a fresh allocation with. Callers that
;; run an allocation counter (load GVN) pass the ALREADY-BUMPED value, so the
;; allocation's epoch is strictly greater than every load-table entry created
;; before it; the counter-free scratch/report consumer passes 0.
(define (opt-alias-update-value-facts
  [facts : OptAliasFacts]
  [instr : CompilerIrInstr]
  [epoch : i64]) : OptAliasFacts
  (let
    [base : OptAliasFacts
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst) (opt-alias-remove-var facts dst)]
        [(option_i64.None) facts])]
    (match instr
      [(CompilerIrInstr.Alloc dst _) (opt-alias-mark-unique base dst epoch)]
      [(CompilerIrInstr.Gep dst source _ _)
        (opt-alias-update-gep base dst source)]
      [(CompilerIrInstr.Mov dst value _) (opt-alias-update-copy base dst value)]
      [(CompilerIrInstr.Cast dst value _ _)
        (opt-alias-update-copy base dst value)]
      [(CompilerIrInstr.Bitcast dst value _ _)
        (opt-alias-update-copy base dst value)]
      ;; A direct runtime allocation call returns a fresh root for subsequent
      ;; scalar-store filtering, and opens a new allocation epoch: storage that
      ;; did not exist before the call cannot alias anything cached before it.
      [(CompilerIrInstr.Call dst name _ _)
        (if (compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)
          (opt-alias-mark-unique base dst epoch)
          base)]
      [(CompilerIrInstr.Load dst _ _) (opt-alias-mark-may-alias base dst)]
      [(CompilerIrInstr.EntryArgv dst) (opt-alias-mark-may-alias base dst)]
      [(CompilerIrInstr.EntryEnvp dst) (opt-alias-mark-may-alias base dst)]
      [(CompilerIrInstr.AddrOf dst _) (opt-alias-mark-may-alias base dst)]
      [(CompilerIrInstr.VectorLoad dst _ _ _ _)
        (opt-alias-mark-may-alias base dst)]
      [(CompilerIrInstr.PredicatedLoad payload-box)
        (match (box-get payload-box)
          [(CompilerIrInstrPredicatedLoadPayload.Payload dst _ _ _ _ _)
            (opt-alias-mark-may-alias base dst)])]
      [(CompilerIrInstr.GatherLoad payload-box)
        (match (box-get payload-box)
          [(CompilerIrInstrGatherLoadPayload.Payload dst _ _ _ _ _ _)
            (opt-alias-mark-may-alias base dst)])]
      [(CompilerIrInstr.VectorShuffle payload-box)
        (match (box-get payload-box)
          [(CompilerIrInstrVectorShufflePayload.Payload dst _ _ _ _ _ _)
            (opt-alias-mark-may-alias base dst)])]
      [_ base])))

;; Transfer function for the scratch/report alias consumer. Memory-mutating or
;; unknown instructions still clear every fact; load GVN uses the provenance-
;; preserving transfer defined beside its pointer-kind model below.
(define (opt-alias-update-facts
  [facts : OptAliasFacts]
  [instr : CompilerIrInstr]) : OptAliasFacts
  (if (opt-alias-instr-clears-all? instr)
    (opt-alias-empty)
    (opt-alias-update-value-facts facts instr 0)))

(define (opt-alias-run [facts : OptAliasFacts] [instrs : CompilerIrInstrList]) : OptAliasFacts
  (match instrs
    [(CompilerIrInstrList.Nil) facts]
    [(CompilerIrInstrList.Cons instr rest)
      (opt-alias-run (opt-alias-update-facts facts instr) (box-get rest))]))

;; --- implicit scratch-region candidate report -------------------------------
;;
;; Report-only analysis for future automatic scratch regions. It recognizes
;; direct `tl_alloc` roots, tracks simple candidate-derived pointers with the
;; optimizer alias fact model, and records the first conservative blocker for a
;; function/block/loop scope. The result never rewrites IR; compile-profile
;; builds only emit deterministic detail rows to stderr.
(defenum OptScratchRootList
  (Nil)
  (Cons i64 (Box OptScratchRootList)))

(defenum OptScratchBlockerReason
  (NoBlocker)
  (Blocked String))

(defenum OptScratchAlloc
  (NoAlloc)
  (Alloc i64 i64))

(defenum OptScratchScopeState
  (State i64 i64 OptScratchRootList OptAliasFacts OptScratchBlockerReason))

(defenum OptScratchScopeReport
  (Report i64 i64 OptScratchBlockerReason))

(define (opt-scratch-alloc-type-size [type-segment-bases : i64] [ty : AstType]) : i64
  (match ty
    [(AstType.I64) 8]
    [(AstType.U64) 8]
    [(AstType.F64) 8]
    [(AstType.I32) 4]
    [(AstType.U32) 4]
    [(AstType.F32) 4]
    [(AstType.I16) 2]
    [(AstType.U16) 2]
    [(AstType.I8) 1]
    [(AstType.U8) 1]
    [(AstType.Bool) 1]
    [(AstType.Char) 1]
    [(AstType.Unit) 0]
    [(AstType.Never) 0]
    [(AstType.Expr) 0]
    [(AstType.ExprList) 0]
    [(AstType.Func _ _) 8]
    [(AstType.Tuple _) 8]
    [(AstType.Array _ _) 8]
    [(AstType.DynArray _) 8]
    [(AstType.Box _) 8]
    [(AstType.Ptr _) 8]
    [(AstType.MutPtr _) 8]
    [(AstType.Ref _ _) 8]
    [(AstType.MutRef _ _) 8]
    [(AstType.Region _ inner)
      (opt-scratch-alloc-type-size
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [(AstType.Enum _) 8]
    [(AstType.EnumArgs _ _) 8]
    [(AstType.Struct _) 8]
    [(AstType.StructArgs _ _) 8]
    [(AstType.String) 8]
    [(AstType.Str) 8]
    [(AstType.Bytes) 8]
    [(AstType.Var _) 0]
    [(AstType.VarArgs _ _) 0]
    [(AstType.Consume inner)
      (opt-scratch-alloc-type-size
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]))

(define (opt-scratch-root-list-contains?
  [roots : OptScratchRootList]
  [root : i64]) : bool
  (match roots
    [(OptScratchRootList.Nil) false]
    [(OptScratchRootList.Cons found rest)
      (or (= found root) (opt-scratch-root-list-contains? (box-get rest) root))]))

(define (opt-scratch-root-list-add [roots : OptScratchRootList] [root : i64]) : OptScratchRootList
  (if (opt-scratch-root-list-contains? roots root)
    roots
    (OptScratchRootList.Cons root (box roots))))

(define (opt-scratch-direct-alloc
  [type-segment-bases : i64]
  [instr : CompilerIrInstr]) : OptScratchAlloc
  (match instr
    [(CompilerIrInstr.Alloc dst ty)
      (OptScratchAlloc.Alloc
        dst
        (opt-scratch-alloc-type-size type-segment-bases ty))]
    [(CompilerIrInstr.Call dst name args _)
      (if (compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)
        (match (opt-aggregate-tl-alloc-size args)
          [(option_i64.Some size)
            (OptScratchAlloc.Alloc
              dst
              (if (> size 0)
                size
                0))]
          [(option_i64.None) (OptScratchAlloc.Alloc dst 0)])
        (OptScratchAlloc.NoAlloc))]
    [_ (OptScratchAlloc.NoAlloc)]))

(define (opt-scratch-arena-helper-call? [symbol : i64]) : bool
  (or
    (= symbol cbi.compiler-builtin-id-arena-current)
    (= symbol cbi.compiler-builtin-id-arena-mark)
    (= symbol cbi.compiler-builtin-id-arena-set-bang)
    (= symbol cbi.compiler-builtin-id-arena-rewind)
    (= symbol cbi.compiler-builtin-id-arena-destroy)
    (= symbol cbi.compiler-builtin-id-tl-region-mark)
    (= symbol cbi.compiler-builtin-id-tl-region-reset)
    (= symbol cbi.compiler-builtin-id-tl-arena-make)
    (= symbol cbi.compiler-builtin-id-tl-arena-current)
    (= symbol cbi.compiler-builtin-id-tl-arena-set)
    (= symbol cbi.compiler-builtin-id-tl-arena-destroy)
    (= symbol cbi.compiler-builtin-id-tl-arena-poison-enable)))

(define (opt-scratch-var-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [var : i64]) : bool
  (match (opt-alias-lookup facts var)
    [(OptMaybeAliasKind.Some kind)
      (match kind
        [(OptAliasKind.Unique _) (opt-scratch-root-list-contains? roots var)]
        [(OptAliasKind.ExclusiveRef) false]
        [(OptAliasKind.SharedRef) false]
        [(OptAliasKind.Derived root)
          (opt-scratch-root-list-contains? roots root)]
        [(OptAliasKind.MayAlias) false]
        [(OptAliasKind.Invalidated) false])]
    [(OptMaybeAliasKind.No) false]))

(define (opt-scratch-value-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var) (opt-scratch-var-derived? roots facts var)]
    [_ false]))

(define (opt-scratch-maybe-value-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [maybe : CompilerIrMaybeValue]) : bool
  (match maybe
    [(CompilerIrMaybeValue.No) false]
    [(CompilerIrMaybeValue.Some value)
      (opt-scratch-value-derived? roots facts value)]))

(define (opt-scratch-value-list-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [values : CompilerIrValueList]) : bool
  (match values
    [(CompilerIrValueList.Nil) false]
    [(CompilerIrValueList.Array seq)
      (opt-scratch-value-list-derived?
        roots
        facts
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (or
        (opt-scratch-value-derived? roots facts value)
        (opt-scratch-value-list-derived? roots facts (box-get rest)))]))

(define (opt-scratch-blocker-none? [blocker : OptScratchBlockerReason]) : bool
  (match blocker
    [(OptScratchBlockerReason.NoBlocker) true]
    [(OptScratchBlockerReason.Blocked _) false]))

(define (opt-scratch-blocker-reason
  [type-segment-bases : i64]
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [instr : CompilerIrInstr]) : OptScratchBlockerReason
  (match (opt-scratch-direct-alloc type-segment-bases instr)
    [(OptScratchAlloc.Alloc _ _) (OptScratchBlockerReason.NoBlocker)]
    [(OptScratchAlloc.NoAlloc)
      (match instr
        [(CompilerIrInstr.Call _ name _ _)
          (if (opt-scratch-arena-helper-call? name)
            (OptScratchBlockerReason.Blocked "arena_helper")
            (OptScratchBlockerReason.Blocked "call"))]
        [(CompilerIrInstr.CallIndirect _ _ _ _)
          (OptScratchBlockerReason.Blocked "call")]
        [(CompilerIrInstr.CallIndirectC _ _ _ _)
          (OptScratchBlockerReason.Blocked "extern_call")]
        [(CompilerIrInstr.CallCAbiStoreResult payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ _ _ _)
              (OptScratchBlockerReason.Blocked "extern_call")])]
        [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload _ _ _ _)
              (OptScratchBlockerReason.Blocked "extern_call")])]
        [(CompilerIrInstr.SpmdCall payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ _ _ _)
              (OptScratchBlockerReason.Blocked "call")])]
        [(CompilerIrInstr.Syscall _ _)
          (OptScratchBlockerReason.Blocked "extern_call")]
        [(CompilerIrInstr.TailCall _ _ _)
          (OptScratchBlockerReason.Blocked "tail_call")]
        [(CompilerIrInstr.TailCallIndirect _ _ _)
          (OptScratchBlockerReason.Blocked "tail_call")]
        [(CompilerIrInstr.AddrOf _ _)
          (OptScratchBlockerReason.Blocked "raw_pointer")]
        [(CompilerIrInstr.Gep _ base offset _)
          (if (opt-scratch-value-derived? roots facts offset)
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (if (opt-scratch-value-derived? roots facts base)
              (match offset
                [(CompilerIrValue.I64 _) (OptScratchBlockerReason.NoBlocker)]
                [_ (OptScratchBlockerReason.Blocked "raw_pointer")])
              (OptScratchBlockerReason.NoBlocker)))]
        [(CompilerIrInstr.Cast _ src _ _)
          (if (opt-scratch-value-derived? roots facts src)
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [(CompilerIrInstr.Bitcast _ src _ _)
          (if (opt-scratch-value-derived? roots facts src)
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [(CompilerIrInstr.StorePtr ptr value _)
          (if (and
            (opt-scratch-value-derived? roots facts value)
            (not (opt-scratch-value-derived? roots facts ptr)))
            (OptScratchBlockerReason.Blocked "store_outer")
            (OptScratchBlockerReason.NoBlocker))]
        [(CompilerIrInstr.Store _ value _)
          (if (opt-scratch-value-derived? roots facts value)
            (OptScratchBlockerReason.Blocked "store_outer")
            (OptScratchBlockerReason.NoBlocker))]
        [(CompilerIrInstr.CopyBytes dst src _)
          (if (and
            (opt-scratch-value-derived? roots facts src)
            (not (opt-scratch-value-derived? roots facts dst)))
            (OptScratchBlockerReason.Blocked "store_outer")
            (if (or
              (opt-scratch-value-derived? roots facts dst)
              (opt-scratch-value-derived? roots facts src))
              (OptScratchBlockerReason.Blocked "raw_pointer")
              (OptScratchBlockerReason.NoBlocker)))]
        [(CompilerIrInstr.VectorStore payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrVectorStorePayload.Payload base index value _ _)
              (if (and
                (opt-scratch-value-derived? roots facts value)
                (not (opt-scratch-value-derived? roots facts base)))
                (OptScratchBlockerReason.Blocked "store_outer")
                (if (or
                  (opt-scratch-value-derived? roots facts base)
                  (opt-scratch-value-derived? roots facts index)
                  (opt-scratch-value-derived? roots facts value))
                  (OptScratchBlockerReason.Blocked "raw_pointer")
                  (OptScratchBlockerReason.NoBlocker)))])]
        [(CompilerIrInstr.PredicatedStore payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrPredicatedStorePayload.Payload
                base
                index
                value
                mask
                _
                _)
              (if (and
                (opt-scratch-value-derived? roots facts value)
                (not (opt-scratch-value-derived? roots facts base)))
                (OptScratchBlockerReason.Blocked "store_outer")
                (if (or
                  (opt-scratch-value-derived? roots facts base)
                  (opt-scratch-value-derived? roots facts index)
                  (opt-scratch-value-derived? roots facts value)
                  (opt-scratch-value-derived? roots facts mask))
                  (OptScratchBlockerReason.Blocked "raw_pointer")
                  (OptScratchBlockerReason.NoBlocker)))])]
        [(CompilerIrInstr.VectorLoad _ base index _ _)
          (if (or
            (opt-scratch-value-derived? roots facts base)
            (opt-scratch-value-derived? roots facts index))
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [(CompilerIrInstr.PredicatedLoad payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrPredicatedLoadPayload.Payload
                _
                base
                index
                mask
                _
                _)
              (if (or
                (opt-scratch-value-derived? roots facts base)
                (opt-scratch-value-derived? roots facts index)
                (opt-scratch-value-derived? roots facts mask))
                (OptScratchBlockerReason.Blocked "raw_pointer")
                (OptScratchBlockerReason.NoBlocker))])]
        [(CompilerIrInstr.GatherLoad payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrGatherLoadPayload.Payload
                _
                base
                index-base
                index
                _
                _
                _)
              (if (or
                (opt-scratch-value-derived? roots facts base)
                (opt-scratch-value-derived? roots facts index-base)
                (opt-scratch-value-derived? roots facts index))
                (OptScratchBlockerReason.Blocked "raw_pointer")
                (OptScratchBlockerReason.NoBlocker))])]
        [(CompilerIrInstr.VectorShuffle payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrVectorShufflePayload.Payload
                _
                source
                selector-low
                selector-high
                active-lanes
                _
                _)
              (if (or
                (opt-scratch-value-derived? roots facts source)
                (opt-scratch-value-derived? roots facts selector-low)
                (opt-scratch-maybe-value-derived? roots facts selector-high)
                (opt-scratch-value-derived? roots facts active-lanes))
                (OptScratchBlockerReason.Blocked "raw_pointer")
                (OptScratchBlockerReason.NoBlocker))])]
        [(CompilerIrInstr.Return maybe)
          (if (opt-scratch-maybe-value-derived? roots facts maybe)
            (OptScratchBlockerReason.Blocked "return_escape")
            (OptScratchBlockerReason.NoBlocker))]
        [(CompilerIrInstr.Pack _ values _)
          (if (opt-scratch-value-list-derived? roots facts values)
            (OptScratchBlockerReason.Blocked "return_escape")
            (OptScratchBlockerReason.NoBlocker))]
        [(CompilerIrInstr.Branch cond _ _)
          (if (opt-scratch-value-derived? roots facts cond)
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [(CompilerIrInstr.BoundsCheck index length _)
          (if (or
            (opt-scratch-value-derived? roots facts index)
            (opt-scratch-value-derived? roots facts length))
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [_ (OptScratchBlockerReason.NoBlocker)])]))

(define (opt-scratch-state-with-blocker
  [state : OptScratchScopeState]
  [candidate : OptScratchBlockerReason]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State allocs bytes roots facts blocker)
      (if (opt-scratch-blocker-none? blocker)
        (match candidate
          [(OptScratchBlockerReason.NoBlocker) state]
          [(OptScratchBlockerReason.Blocked _)
            (OptScratchScopeState.State allocs bytes roots facts candidate)])
        state)]))

(define (opt-scratch-state-record-alloc
  [state : OptScratchScopeState]
  [dst : i64]
  [bytes : i64]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State alloc-count known-bytes roots facts blocker)
      (OptScratchScopeState.State
        (+ alloc-count 1)
        (+ known-bytes bytes)
        (opt-scratch-root-list-add roots dst)
        ;; The report-only scratch analysis runs no allocation counter and
        ;; never consults epochs, so every root it records is epoch 0.
        (opt-alias-mark-unique facts dst 0)
        blocker)]))

(define (opt-scratch-state-facts
  [state : OptScratchScopeState]
  [facts : OptAliasFacts]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State allocs bytes roots _ blocker)
      (OptScratchScopeState.State allocs bytes roots facts blocker)]))

(define (opt-scratch-storeptr-keeps-facts?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]) : bool
  (and
    (opt-scratch-value-derived? roots facts ptr)
    (not (opt-scratch-value-derived? roots facts value))))

(define (opt-scratch-update-nonalloc-facts
  [state : OptScratchScopeState]
  [instr : CompilerIrInstr]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State _ _ roots facts _)
      (opt-scratch-state-facts
        state
        (match instr
          [(CompilerIrInstr.StorePtr ptr value _)
            (if (opt-scratch-storeptr-keeps-facts? roots facts ptr value)
              facts
              (opt-alias-update-facts facts instr))]
          [(CompilerIrInstr.Store _ value _)
            (if (opt-scratch-value-derived? roots facts value)
              (opt-alias-update-facts facts instr)
              facts)]
          [_ (opt-alias-update-facts facts instr)]))]))

(define (opt-scratch-state-step
  [type-segment-bases : i64]
  [state : OptScratchScopeState]
  [instr : CompilerIrInstr]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State _ _ roots facts _)
      (let
        [blocked : OptScratchScopeState
          (opt-scratch-state-with-blocker
            state
            (opt-scratch-blocker-reason type-segment-bases roots facts instr))]
        (match (opt-scratch-direct-alloc type-segment-bases instr)
          [(OptScratchAlloc.Alloc dst bytes)
            (opt-scratch-state-record-alloc blocked dst bytes)]
          [(OptScratchAlloc.NoAlloc)
            (opt-scratch-update-nonalloc-facts blocked instr)]))]))

(define (opt-scratch-state-initial) : OptScratchScopeState
  (OptScratchScopeState.State
    0
    0
    (OptScratchRootList.Nil)
    (opt-alias-empty)
    (OptScratchBlockerReason.NoBlocker)))

(define (opt-scratch-scope-report-from-state [state : OptScratchScopeState]) : OptScratchScopeReport
  (match state
    [(OptScratchScopeState.State allocs bytes _ _ blocker)
      (OptScratchScopeReport.Report allocs bytes blocker)]))

(define (opt-scratch-scope-scan-instrs
  [type-segment-bases : i64]
  [state : OptScratchScopeState]
  [instrs : CompilerIrInstrList]) : OptScratchScopeState
  (match instrs
    [(CompilerIrInstrList.Nil) state]
    [(CompilerIrInstrList.Cons instr rest)
      (opt-scratch-scope-scan-instrs
        type-segment-bases
        (opt-scratch-state-step type-segment-bases state instr)
        (box-get rest))]))

(define (opt-scratch-scope-scan-instr-seq-from
  [type-segment-bases : i64]
  [state : OptScratchScopeState]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptScratchScopeState
  (if (>= index (compiler-ir-instr-seq-count instrs))
    state
    (opt-scratch-scope-scan-instr-seq-from
      type-segment-bases
      (opt-scratch-state-step
        type-segment-bases
        state
        (compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1))))

(define (opt-scratch-scope-scan-blocks
  [type-segment-bases : i64]
  [state : OptScratchScopeState]
  [blocks : CompilerIrBlockList]) : OptScratchScopeState
  (match blocks
    [(CompilerIrBlockList.Nil) state]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-scratch-scope-scan-blocks
            type-segment-bases
            (opt-scratch-scope-scan-instr-seq-from
              type-segment-bases
              state
              instrs
              0)
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (opt-scratch-scope-scan-blocks
        type-segment-bases
        state
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-scratch-scope-report-instrs
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrList]) : OptScratchScopeReport
  (opt-scratch-scope-report-from-state
    (opt-scratch-scope-scan-instrs
      type-segment-bases
      (opt-scratch-state-initial)
      instrs)))

(define (opt-scratch-scope-report-block
  [type-segment-bases : i64]
  [block : CompilerIrBlock]) : OptScratchScopeReport
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (opt-scratch-scope-report-from-state
        (opt-scratch-scope-scan-instr-seq-from
          type-segment-bases
          (opt-scratch-state-initial)
          instrs
          0))]))

(define (opt-scratch-scope-report-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]) : OptScratchScopeReport
  (opt-scratch-scope-report-from-state
    (opt-scratch-scope-scan-blocks
      type-segment-bases
      (opt-scratch-state-initial)
      blocks)))

(define (opt-scratch-report-candidate?
  [report : OptScratchScopeReport]
  [expected-allocs : i64]
  [expected-bytes : i64]) : bool
  (match report
    [(OptScratchScopeReport.Report allocs bytes blocker)
      (and
        (= allocs expected-allocs)
        (= bytes expected-bytes)
        (opt-scratch-blocker-none? blocker))]))

(define (opt-scratch-report-blocked?
  [_type-segment-bases : i64]
  [report : OptScratchScopeReport]
  [expected-allocs : i64]
  [expected-bytes : i64]
  [reason : String]) : bool
  (match report
    [(OptScratchScopeReport.Report allocs bytes blocker)
      (and
        (= allocs expected-allocs)
        (= bytes expected-bytes)
        (match blocker
          [(OptScratchBlockerReason.Blocked found) (string.eq found reason)]
          [(OptScratchBlockerReason.NoBlocker) false]))]))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-status
    [blocker : OptScratchBlockerReason]) : String
    (match blocker
      [(OptScratchBlockerReason.NoBlocker) "candidate"]
      [(OptScratchBlockerReason.Blocked _) "blocked"])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-reason
    [blocker : OptScratchBlockerReason]) : String
    (match blocker
      [(OptScratchBlockerReason.NoBlocker) "none"]
      [(OptScratchBlockerReason.Blocked reason) reason])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-line
    [status : String]
    [scope : String]
    [function : String]
    [label : i64]
    [latch : i64]
    [allocs : i64]
    [bytes : i64]
    [reason : String]) : String
    (string.concat5
      "compile-profile-detail|scratch_region|"
      status
      "|scope="
      scope
      (string.concat5
        "|function="
        function
        "|label="
        (compiler-ir-label-text label)
        (string.concat5
          "|latch="
          (compiler-ir-label-text latch)
          "|allocs="
          (string.int->string allocs)
          (string.concat5
            "|known_bytes="
            (string.int->string bytes)
            "|blocker="
            reason
            "\n"))))))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-one
    [scope : String]
    [function : String]
    [label : i64]
    [latch : i64]
    [report : OptScratchScopeReport]) : unit
    (match report
      [(OptScratchScopeReport.Report allocs bytes blocker)
        (cfg
          compile-profile-summary
          unit
          (if (> allocs 0)
            (io.print-error
              (compiler-opt-scratch-region-report-line
                (compiler-opt-scratch-region-report-status blocker)
                scope
                function
                label
                latch
                allocs
                bytes
                (compiler-opt-scratch-region-report-reason blocker)))
            unit))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-blocks
    [type-segment-bases : i64]
    [function : String]
    [blocks : CompilerIrBlockList]) : unit
    (match blocks
      [(CompilerIrBlockList.Nil) unit]
      [(CompilerIrBlockList.Cons block rest)
        (begin
          (match block
            [(CompilerIrBlock.Block label _)
              (compiler-opt-scratch-region-report-one
                "block"
                function
                label
                (compiler-ir-label "-")
                (opt-scratch-scope-report-block type-segment-bases block))])
          (compiler-opt-scratch-region-report-blocks
            type-segment-bases
            function
            (box-get rest)))]
      [(CompilerIrBlockList.Array seq)
        (compiler-opt-scratch-region-report-blocks
          type-segment-bases
          function
          (compiler-ir-block-seq-to-list seq))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-loops
    [type-segment-bases : i64]
    [function : String]
    [loops : OptNaturalLoopList]) : unit
    (match loops
      [(OptNaturalLoopList.Nil) unit]
      [(OptNaturalLoopList.Cons loop rest)
        (begin
          (compiler-opt-scratch-region-report-one
            "loop"
            function
            (opt-natural-loop-header loop)
            (opt-natural-loop-latch loop)
            (opt-scratch-scope-report-blocks
              type-segment-bases
              (opt-natural-loop-body-blocks loop)))
          (compiler-opt-scratch-region-report-loops
            type-segment-bases
            function
            (box-get rest)))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-function
    [type-segment-bases : i64]
    [func : CompilerIrFunction]) : unit
    (match func
      [(CompilerIrFunction.Function name _ _ _ blocks)
        (let
          [name-text : String (compiler-ir-symbol-text name)]
          (begin
            (compiler-opt-scratch-region-report-one
              "function"
              name-text
              (compiler-ir-label "-")
              (compiler-ir-label "-")
              (opt-scratch-scope-report-blocks type-segment-bases blocks))
            (compiler-opt-scratch-region-report-blocks
              type-segment-bases
              name-text
              blocks)
            (compiler-opt-scratch-region-report-loops
              type-segment-bases
              name-text
              (opt-cfg-natural-loops blocks))))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-function-escaping
    [type-segment-bases : i64]
    [func : CompilerIrFunction]
    [scratch : i64]) : unit
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [mark : i64 (arena.tl_region_mark)]
          [_report : unit
            (compiler-opt-scratch-region-report-function
              type-segment-bases
              func)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (unsafe
            (arena.tl_arena_set scratch-head)
            (arena.tl_region_reset mark)
            (arena.tl_arena_set enclosing)))))))

;; --- implicit scratch-region reset insertion -------------------------------
;;
;; Opt2 may wrap a proven loop-body scratch candidate with one mark before the
;; loop and one reset in the latch. The pass deliberately handles only simple
;; cleanup shapes. Any body return, candidate carried by a phi, allocation in
;; the header guard, missing unique mark block, or non-header/non-latch edge out
;; of the loop keeps the IR unchanged.
(defenum OptScratchResetApplyResult
  (Result CompilerIrBlockList i64 bool))

(defenum OptScratchResetMarkBlock
  (No)
  (Some i64))

(defenum OptScratchResetMarkCandidate
  (None)
  (One i64)
  (Many))

(define (opt-scratch-scope-state-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]) : OptScratchScopeState
  (opt-scratch-scope-scan-blocks
    type-segment-bases
    (opt-scratch-state-initial)
    blocks))

(define (opt-scratch-state-candidate? [state : OptScratchScopeState]) : bool
  (match state
    [(OptScratchScopeState.State allocs _ _ _ blocker)
      (and (> allocs 0) (opt-scratch-blocker-none? blocker))]))

(define (opt-scratch-report-alloc-count [report : OptScratchScopeReport]) : i64
  (match report
    [(OptScratchScopeReport.Report allocs _ _) allocs]))

(define (opt-scratch-block-alloc-count
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) 0]
    [(OptMaybeBlock.Some block)
      (opt-scratch-report-alloc-count
        (opt-scratch-scope-report-block type-segment-bases block))]))

(define (opt-scratch-reset-mark-candidate-add
  [candidate : OptScratchResetMarkCandidate]
  [pred : i64]) : OptScratchResetMarkCandidate
  (match candidate
    [(OptScratchResetMarkCandidate.None)
      (OptScratchResetMarkCandidate.One pred)]
    [(OptScratchResetMarkCandidate.One _) (OptScratchResetMarkCandidate.Many)]
    [(OptScratchResetMarkCandidate.Many) (OptScratchResetMarkCandidate.Many)]))

(define (opt-scratch-reset-mark-candidate-scan
  [reachable : OptLabelSet]
  [body : OptLabelSet]
  [preds : OptLabelSet]
  [candidate : OptScratchResetMarkCandidate]) : OptScratchResetMarkCandidate
  (match preds
    [(OptLabelSet.Nil) candidate]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (opt-scratch-reset-mark-candidate-scan
          reachable
          body
          (opt-label-tail preds)
          (if (and
            (opt-label-contains reachable pred)
            (not (opt-label-contains body pred)))
            (opt-scratch-reset-mark-candidate-add candidate pred)
            candidate)))]))

(define (opt-scratch-reset-mark-candidate-scan-not-label
  [reachable : OptLabelSet]
  [skip : i64]
  [preds : OptLabelSet]
  [candidate : OptScratchResetMarkCandidate]) : OptScratchResetMarkCandidate
  (match preds
    [(OptLabelSet.Nil) candidate]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (opt-scratch-reset-mark-candidate-scan-not-label
          reachable
          skip
          (opt-label-tail preds)
          (if (and (opt-label-contains reachable pred) (not (= pred skip)))
            (opt-scratch-reset-mark-candidate-add candidate pred)
            candidate)))]))

(define (opt-scratch-reset-mark-block-from-candidate
  [candidate : OptScratchResetMarkCandidate]) : OptScratchResetMarkBlock
  (match candidate
    [(OptScratchResetMarkCandidate.One label)
      (OptScratchResetMarkBlock.Some label)]
    [_ (OptScratchResetMarkBlock.No)]))

(define (opt-scratch-reset-loop-mark-block
  [context : OptCfgContext]
  [loop : OptNaturalLoop]) : OptScratchResetMarkBlock
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.Some preheader)
      (OptScratchResetMarkBlock.Some preheader)]
    [(OptLoopPreheader.No)
      (let
        [header : i64 (opt-natural-loop-header loop)]
        [preds : OptLabelSet
          (opt-pred-map-lookup (struct-get context pred-map) header)]
        [reachable : OptLabelSet (struct-get context reachable)]
        (opt-scratch-reset-mark-block-from-candidate
          (if (= header (opt-natural-loop-latch loop))
            (opt-scratch-reset-mark-candidate-scan-not-label
              reachable
              header
              preds
              (OptScratchResetMarkCandidate.None))
            (opt-scratch-reset-mark-candidate-scan
              reachable
              (opt-natural-loop-body loop)
              preds
              (OptScratchResetMarkCandidate.None)))))]))

(define (opt-scratch-phi-input-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [inputs : CompilerIrPhiInputList]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) false]
    [(CompilerIrPhiInputList.Array seq)
      (opt-scratch-phi-input-derived?
        roots
        facts
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (or
        (opt-scratch-value-derived? roots facts value)
        (opt-scratch-phi-input-derived? roots facts (box-get rest)))]))

(define (opt-scratch-instr-loop-carried-candidate?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Phi _ inputs _)
      (opt-scratch-phi-input-derived? roots facts inputs)]
    [_ false]))

(define (opt-scratch-instr-seq-loop-carried-candidate?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-scratch-instr-loop-carried-candidate?
        roots
        facts
        (compiler-ir-instr-seq-ref instrs index))
      (opt-scratch-instr-seq-loop-carried-candidate?
        roots
        facts
        instrs
        (+ index 1)))))

(define (opt-scratch-block-loop-carried-candidate?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (opt-scratch-instr-seq-loop-carried-candidate? roots facts instrs 0)]))

(define (opt-scratch-blocks-loop-carried-candidate?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (or
        (opt-scratch-block-loop-carried-candidate? roots facts block)
        (opt-scratch-blocks-loop-carried-candidate? roots facts (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-scratch-blocks-loop-carried-candidate?
        roots
        facts
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-scratch-state-loop-carried-candidate?
  [state : OptScratchScopeState]
  [blocks : CompilerIrBlockList]) : bool
  (match state
    [(OptScratchScopeState.State _ _ roots facts _)
      (opt-scratch-blocks-loop-carried-candidate? roots facts blocks)]))

(define (opt-scratch-instr-return-exit? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Return _) true]
    [(CompilerIrInstr.TailCall _ _ _) true]
    [(CompilerIrInstr.TailCallIndirect _ _ _) true]
    [_ false]))

(define (opt-scratch-instr-seq-return-exit?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-scratch-instr-return-exit? (compiler-ir-instr-seq-ref instrs index))
      (opt-scratch-instr-seq-return-exit? instrs (+ index 1)))))

(define (opt-scratch-successors-loop-safe?
  [body : OptLabelSet]
  [label : i64]
  [header : i64]
  [latch : i64]
  [mark-block : i64]
  [successors : OptLabelSet]) : bool
  (match successors
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [succ : i64 (opt-label-ref successors 0)]
        (and
          (or
            (opt-label-contains body succ)
            (= label header)
            (= label latch)
            (= label mark-block))
          (opt-scratch-successors-loop-safe?
            body
            label
            header
            latch
            mark-block
            (opt-label-tail successors))))]))

(define (opt-scratch-loop-block-exits-safe?
  [index : OptCfgIndex]
  [body : OptLabelSet]
  [header : i64]
  [latch : i64]
  [mark-block : i64]
  [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block label instrs)
      (and
        (not (opt-scratch-instr-seq-return-exit? instrs 0))
        (opt-scratch-successors-loop-safe?
          body
          label
          header
          latch
          mark-block
          (opt-cfg-index-successors index label)))]))

(define (opt-scratch-loop-blocks-exits-safe?
  [index : OptCfgIndex]
  [body : OptLabelSet]
  [header : i64]
  [latch : i64]
  [mark-block : i64]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (and
        (opt-scratch-loop-block-exits-safe?
          index
          body
          header
          latch
          mark-block
          block)
        (opt-scratch-loop-blocks-exits-safe?
          index
          body
          header
          latch
          mark-block
          (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (opt-scratch-loop-blocks-exits-safe?
        index
        body
        header
        latch
        mark-block
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-scratch-loop-eligible?
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]) : bool
  (match (opt-scratch-reset-loop-mark-block context loop)
    [(OptScratchResetMarkBlock.No) false]
    [(OptScratchResetMarkBlock.Some mark-block)
      (let
        [index : OptCfgIndex (struct-get context index)]
        [header : i64 (opt-natural-loop-header loop)]
        [latch : i64 (opt-natural-loop-latch loop)]
        [body : OptLabelSet (opt-natural-loop-body loop)]
        [body-blocks : CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        [state : OptScratchScopeState
          (opt-scratch-scope-state-blocks type-segment-bases body-blocks)]
        (and
          (opt-scratch-state-candidate? state)
          (or
            (= header latch)
            (=
              (opt-scratch-block-alloc-count type-segment-bases blocks header)
              0))
          (not (opt-scratch-state-loop-carried-candidate? state body-blocks))
          (opt-scratch-loop-blocks-exits-safe?
            index
            body
            header
            latch
            mark-block
            body-blocks)))]))

(define (opt-scratch-reset-mark-instr [mark-var : i64]) : CompilerIrInstr
  (begin
    (cbi.compiler-builtin-refresh!)
    (CompilerIrInstr.Call
      mark-var
      cbi.compiler-builtin-id-tl-region-mark
      (CompilerIrCallArgs.Nil)
      (AstType.I64))))

(define (opt-scratch-reset-reset-instr [reset-var : i64] [mark-var : i64]) : CompilerIrInstr
  (begin
    (cbi.compiler-builtin-refresh!)
    (CompilerIrInstr.Call
      reset-var
      cbi.compiler-builtin-id-tl-region-reset
      (CompilerIrCallArgs.One (CompilerIrValue.Var mark-var))
      (AstType.Unit))))

(define (opt-scratch-reset-mark-instrs [mark-var : i64]) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (opt-scratch-reset-mark-instr mark-var)
    CompilerIrInstrList.Nil))

(define (opt-scratch-reset-reset-instrs [reset-var : i64] [mark-var : i64]) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (opt-scratch-reset-reset-instr reset-var mark-var)
    CompilerIrInstrList.Nil))

(define (opt-scratch-reset-rewrite-block
  [block : CompilerIrBlock]
  [preheader : i64]
  [latch : i64]
  [mark-var : i64]
  [reset-var : i64]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (if (= label preheader)
        (compiler-ir-block
          label
          (opt-licm-insert-before-terminator-seq
            (opt-scratch-reset-mark-instrs mark-var)
            instrs))
        (if (= label latch)
          (compiler-ir-block
            label
            (opt-licm-insert-before-terminator-seq
              (opt-scratch-reset-reset-instrs reset-var mark-var)
              instrs))
          block))]))

(define (opt-scratch-reset-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [preheader : i64]
  [latch : i64]
  [mark-var : i64]
  [reset-var : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerIrBlockList.Nil)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-ir-block-cons
        (opt-scratch-reset-rewrite-block
          block
          preheader
          latch
          mark-var
          reset-var)
        (opt-scratch-reset-rewrite-blocks
          (box-get rest)
          preheader
          latch
          mark-var
          reset-var))]
    [(CompilerIrBlockList.Array seq)
      (opt-scratch-reset-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        preheader
        latch
        mark-var
        reset-var)]))

(define (opt-scratch-reset-apply-loop
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptScratchResetApplyResult
  (match (opt-scratch-reset-loop-mark-block context loop)
    [(OptScratchResetMarkBlock.No)
      (OptScratchResetApplyResult.Result blocks frame false)]
    [(OptScratchResetMarkBlock.Some mark-block)
      (OptScratchResetApplyResult.Result
        (opt-scratch-reset-rewrite-blocks
          blocks
          mark-block
          (opt-natural-loop-latch loop)
          frame
          (+ frame 1))
        (+ frame 2)
        true)]))

(define (opt-scratch-reset-apply-loops
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [loops : OptNaturalLoopList]) : OptScratchResetApplyResult
  (match loops
    [(OptNaturalLoopList.Nil)
      (OptScratchResetApplyResult.Result blocks frame false)]
    [(OptNaturalLoopList.Cons loop rest)
      (if (opt-scratch-loop-eligible? type-segment-bases context blocks loop)
        (opt-scratch-reset-apply-loop context blocks frame loop)
        (opt-scratch-reset-apply-loops
          type-segment-bases
          context
          blocks
          frame
          (box-get rest)))]))

(define (opt-scratch-reset-function-unchecked-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (match (opt-scratch-reset-apply-loops
        type-segment-bases
        context
        blocks
        frame
        (opt-cfg-natural-loops-with-context blocks context))
        [(OptScratchResetApplyResult.Result next-blocks next-frame changed)
          (if changed
            (let
              [next : CompilerIrFunction
                (CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  next-frame
                  next-blocks)]
              [next-context : OptCfgContext (opt-cfg-context-build next-blocks)]
              (OptFunctionCtxResult.Result next next-context))
            (OptFunctionCtxResult.Result func context))])]))

(define (opt-scratch-reset-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-scratch-reset-apply-loops
            type-segment-bases
            context
            blocks
            frame
            (opt-cfg-natural-loops-with-context blocks context))
            [(OptScratchResetApplyResult.Result next-blocks next-frame changed)
              (if changed
                (let
                  [next : CompilerIrFunction
                    (CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      next-frame
                      next-blocks)]
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)]))
                (OptFunctionCtxResult.Result func context))])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-scratch-reset-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-scratch-reset-function-with-context-result
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

(define (opt-scratch-reset-function-unchecked
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (if (<=
        (compiler-ir-block-list-count blocks)
        (opt-heavy-pass-block-limit))
        (match (opt-scratch-reset-function-unchecked-with-context-result
          type-segment-bases
          (opt-cfg-context-build blocks)
          func)
          [(OptFunctionCtxResult.Result next _) next])
        func)]))

(define (opt-scratch-reset-function-list-unchecked
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]) : CompilerIrFunctionList
  (match functions
    [(CompilerIrFunctionList.Nil) (CompilerIrFunctionList.Nil)]
    [(CompilerIrFunctionList.Cons func rest)
      (compiler-ir-function-cons
        (opt-scratch-reset-function-unchecked type-segment-bases func)
        (opt-scratch-reset-function-list-unchecked
          type-segment-bases
          (box-get rest)))]
    [(CompilerIrFunctionList.Array seq)
      (compiler-ir-function-list-compact
        (opt-scratch-reset-function-list-unchecked
          type-segment-bases
          (compiler-ir-function-seq-to-list seq)))]))

(define (opt-scratch-reset-function-list-with-level
  [type-segment-bases : i64]
  [functions : CompilerIrFunctionList]
  [level : i64]) : CompilerIrFunctionList
  (if (< level 2)
    functions
    (opt-scratch-reset-function-list-unchecked type-segment-bases functions)))

(define (opt-scratch-reset-pre-ssa-function-with-context-result
  [pools : AstNodePoolContext]
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  (match func
    [(CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [context : OptCfgContext
          (opt-cfg-context-build (compiler-ir-clone-block-list pools blocks))]
        [input : CompilerIrFunction
          (CompilerIrFunction.Function name params ret-ty frame blocks)]
        [preheaders-result : OptFunctionCtxResult
          (opt-loop-preheaders-function-with-context-result context false input)]
        [preheaders : CompilerIrFunction
          (match preheaders-result
            [(OptFunctionCtxResult.Result f _) f])]
        [preheaders-context : OptCfgContext
          (match preheaders-result
            [(OptFunctionCtxResult.Result _ ctx) ctx])]
        (opt-scratch-reset-function-with-context-result
          type-segment-bases
          preheaders-context
          false
          preheaders))]))

;; --- block-local redundant-load CSE -----------------------------------------
;;
;; GAP4: alias-granular invalidation + store-to-load forwarding + canonical
;; address keys.
;;
;; The original pass keyed loads by raw address VALUE (the gep temp) and wiped
;; the whole table on ANY memory write. Three upgrades, shared with the
;; cross-block pass below:
;;
;; 1. CANONICAL KEYS: every array/string access re-emits a fresh descriptor
;;    gep (`Gep arr 0/1 ty`), and the only pass that unified those geps (the
;;    global GVN) runs LAST in the optimize iteration (and needs a full SSA
;;    verify), so load CSE never saw two repeats under one key. A load whose
;;    address var is a CONST-offset gep of base B is now keyed structurally as
;;    (B, byte-offset, load-type); the byte offset is offset*type-size exactly
;;    as the backend scales gep displacements. Base redefinition drops the
;;    entries (extended invalidation below), so var identity == value identity
;;    for the key's lifetime.
;;
;; 2. ALIAS-GRANULAR INVALIDATION: a StorePtr/CopyBytes drops only MAY-ALIAS
;;    entries. Sound keep rules (everything else is dropped):
;;      - an ELEMENT store (pointer derived from a loaded array/string data
;;        pointer) keeps DESCRIPTOR-FIELD entries: data buffers never contain
;;        descriptor headers (descriptors are their own allocations; buffer
;;        elements are handles/scalars/inline structs) -- the LICM
;;        element-only-store proof, ported.
;;      - a DESCRIPTOR-FIELD store keeps element entries (same disjointness,
;;        mirrored) and same-base entries at provably disjoint byte ranges
;;        (two fields of one object cannot overlap).
;;      - a generic FIELD store (const-offset gep off a non-descriptor base)
;;        keeps only same-base disjoint-range entries: two handles may name
;;        the same object, and structs can live inline inside array buffers,
;;        so neither element nor other-base entries are safe.
;;    Alias facts (OptAliasFacts) are threaded exactly as before; they gate
;;    nothing here and keep their conservative store-clears semantics.
;;
;; 3. STORE-TO-LOAD FORWARDING: a classified StorePtr binds its (address, type)
;;    key to a canonical stored value, so a later same-key load becomes a Mov
;;    (the coalescer eats the copy; literal stores forward the literal). 8-byte
;;    values forward directly. Sub-word stores forward only normalized
;;    constants or values proven to have come from a same-type load, because
;;    arbitrary sub-word IR vars are not guaranteed high-bit-canonical while an
;;    actual load re-canonicalizes.
;;
;; Location kinds are tracked per pointer var (OptLoadPtrKinds); the
;; header-typedness of gep bases comes from a per-function pre-pass
;; (OptLoadHeaderSet) marking vars that are array/string descriptor handles at
;; EVERY def site (multi-def vars with disagreeing types are poisoned -- the
;; block-local pass runs pre-SSA).
;; Function-constant header-typed var set: var -> 1 (array/string handle at
;; every typed def) or 2 (poisoned: any non-handle or untyped def).
(defenum OptLoadHeaderSet
  (Sparse opt_i64_i64_map.Map)
  (Dense (Array i64)))

(define (opt-load-header-set-empty) : OptLoadHeaderSet
  (OptLoadHeaderSet.Sparse (opt_i64_i64_map.with-capacity 17)))

(define (opt-load-header-set-fill-zero! [items : (Array i64)] [index : i64]) : unit
  (if (>= index (array-length items))
    unit
    (begin
      (array-set! items index 0)
      (opt-load-header-set-fill-zero! items (+ index 1)))))

(define (opt-load-header-set-with-size [count : i64]) : OptLoadHeaderSet
  (let
    [items : (Array i64) (array.make-array i64 count)]
    (begin
      (opt-load-header-set-fill-zero! items 0)
      (OptLoadHeaderSet.Dense items))))

(define (opt-load-header-set-mark
  [set : OptLoadHeaderSet]
  [var : i64]
  [header? : bool]) : OptLoadHeaderSet
  (match set
    [(OptLoadHeaderSet.Sparse map)
      (if header?
        (if (opt_i64_i64_map.contains? (& map) var)
          set
          (let
            [out : opt_i64_i64_map.Map map]
            (begin
              (opt_i64_i64_map.insert-ref! (&mut out) var 1)
              (OptLoadHeaderSet.Sparse out))))
        (let
          [out : opt_i64_i64_map.Map map]
          (begin
            (opt_i64_i64_map.insert-ref! (&mut out) var 2)
            (OptLoadHeaderSet.Sparse out))))]
    [(OptLoadHeaderSet.Dense items)
      (if (or (< var 0) (>= var (array-length items)))
        set
        (begin
          (if header?
            (if (= (array-ref items var) 0)
              (array-set! items var 1)
              unit)
            (array-set! items var 2))
          set))]))

(define (opt-load-header-var? [set : OptLoadHeaderSet] [var : i64]) : bool
  (match set
    [(OptLoadHeaderSet.Sparse map)
      (match (opt_i64_i64_map.get (& map) var)
        [(opt_i64_i64_map.LookupFound value) (= value 1)]
        [(opt_i64_i64_map.LookupMissing) false])]
    [(OptLoadHeaderSet.Dense items)
      (if (or (< var 0) (>= var (array-length items)))
        false
        (= (array-ref items var) 1))]))

;; A checked reference to an array/string descriptor addresses that descriptor
;; directly, so its parameter var is a header base for GEP/load classification
;; just like a by-value descriptor var.
(define (opt-load-header-param-type? [type-segment-bases : i64] [ty : AstType]) : bool
  (match ty
    [(AstType.Ref _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [(AstType.MutRef _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [(AstType.Region _ inner)
      (opt-load-header-param-type?
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [_ (opt-licm-array-header-type? type-segment-bases ty)]))

(define (opt-load-header-set-add-param
  [type-segment-bases : i64]
  [param : CompilerIrParam]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (match param
    [(CompilerIrParam.Param _ ty var)
      (opt-load-header-set-mark
        set
        var
        (opt-load-header-param-type? type-segment-bases ty))]))

(define (opt-load-header-set-add-param-seq
  [type-segment-bases : i64]
  [params : CompilerIrParamSeq]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-param-seq-count params)]
    [work : OptLoadHeaderSet set]
    (begin
      (while (< index count)
        (begin
          (set!
            work
            (opt-load-header-set-add-param
              type-segment-bases
              (compiler-ir-param-seq-ref params index)
              work))
          (set! index (+ index 1))))
      work)))

(define (opt-load-header-set-add-params
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (match params
    [(CompilerIrParamList.Nil) set]
    [(CompilerIrParamList.Array seq)
      (opt-load-header-set-add-param-seq type-segment-bases seq set)]
    [(CompilerIrParamList.Cons param rest)
      (opt-load-header-set-add-params
        type-segment-bases
        (box-get rest)
        (opt-load-header-set-add-param type-segment-bases param set))]))

;; Defs with a declared result type mark it; every OTHER defining instruction
;; poisons its dst (its handle-ness is unknown).
(define (opt-load-header-set-add-instr
  [type-segment-bases : i64]
  [set : OptLoadHeaderSet]
  [instr : CompilerIrInstr]) : OptLoadHeaderSet
  (match instr
    [(CompilerIrInstr.Mov dst _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(CompilerIrInstr.Load dst _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(CompilerIrInstr.Call dst _ _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(CompilerIrInstr.CallIndirect dst _ _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(CompilerIrInstr.CallIndirectC dst _ _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(CompilerIrInstr.Phi dst _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(CompilerIrInstr.Cast dst _ _ to-ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases to-ty))]
    [(CompilerIrInstr.Bitcast dst _ _ to-ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases to-ty))]
    [_
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst) (opt-load-header-set-mark set dst false)]
        [(option_i64.None) set])]))

(define (opt-load-header-set-add-instr-seq-from
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (let
    [cursor : i64 index]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [work : OptLoadHeaderSet set]
    (begin
      (while (< cursor count)
        (begin
          (set!
            work
            (opt-load-header-set-add-instr
              type-segment-bases
              work
              (compiler-ir-instr-seq-ref instrs cursor)))
          (set! cursor (+ cursor 1))))
      work)))

(define (opt-load-header-set-add-block-seq
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockSeq]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    [work : OptLoadHeaderSet set]
    (begin
      (while (< index count)
        (begin
          (match (compiler-ir-block-seq-ref blocks index)
            [(CompilerIrBlock.Block _ instrs)
              (set!
                work
                (opt-load-header-set-add-instr-seq-from
                  type-segment-bases
                  instrs
                  0
                  work))])
          (set! index (+ index 1))))
      work)))

(define (opt-load-header-set-add-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (opt-load-header-set-add-blocks
            type-segment-bases
            (box-get rest)
            (opt-load-header-set-add-instr-seq-from
              type-segment-bases
              instrs
              0
              set))])]
    [(CompilerIrBlockList.Array seq)
      (opt-load-header-set-add-block-seq type-segment-bases seq set)]))

(define (opt-load-header-set-from-function
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptLoadHeaderSet
  (opt-load-header-set-add-blocks
    type-segment-bases
    blocks
    (opt-load-header-set-add-params
      type-segment-bases
      params
      (opt-load-header-set-empty))))

(define (opt-load-header-set-from-function-with-size
  [type-segment-bases : i64]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]
  [frame : i64]) : OptLoadHeaderSet
  (opt-load-header-set-add-blocks
    type-segment-bases
    blocks
    (opt-load-header-set-add-params
      type-segment-bases
      params
      (opt-load-header-set-with-size frame))))

(define opt-load-cse-table-cap-floor : i64
  128)
(define opt-load-cse-kinds-cap-floor : i64
  96)
(define opt-load-cse-cap-hard-max : i64
  2048)
(define opt-load-cse-cap-scale-divisor : i64
  2)

(define (opt-load-cse-scaled-cap [floor : i64] [instr-count : i64]) : i64
  (let
    [from-size : i64 (/ instr-count opt-load-cse-cap-scale-divisor)]
    [with-floor : i64
      (if (> from-size floor)
        from-size
        floor)]
    (if (> with-floor opt-load-cse-cap-hard-max)
      opt-load-cse-cap-hard-max
      with-floor)))

(define (opt-load-cse-table-cap-for-size [instr-count : i64]) : i64
  (opt-load-cse-scaled-cap opt-load-cse-table-cap-floor instr-count))

(define (opt-load-cse-kinds-cap-for-size [instr-count : i64]) : i64
  (opt-load-cse-scaled-cap opt-load-cse-kinds-cap-floor instr-count))

;; Byte width of a scalar Load/StorePtr and the gep displacement scale. MUST
;; mirror compiler-backend-type-size (gep disp = offset * this); 0 means
;; zero-sized/unclassifiable and callers must treat the location as unknown.
(define (opt-load-loc-type-size [type-segment-bases : i64] [ty : AstType]) : i64
  (match ty
    [(AstType.I64) 8]
    [(AstType.U64) 8]
    [(AstType.F64) 8]
    [(AstType.I32) 4]
    [(AstType.U32) 4]
    [(AstType.F32) 4]
    [(AstType.I16) 2]
    [(AstType.U16) 2]
    [(AstType.I8) 1]
    [(AstType.U8) 1]
    [(AstType.Bool) 1]
    [(AstType.Char) 1]
    [(AstType.Unit) 0]
    [(AstType.Never) 0]
    [(AstType.Expr) 0]
    [(AstType.ExprList) 0]
    [(AstType.Func _ _) 8]
    [(AstType.Tuple _) 8]
    [(AstType.Array _ _) 8]
    [(AstType.DynArray _) 8]
    [(AstType.Box _) 8]
    [(AstType.Ptr _) 8]
    [(AstType.MutPtr _) 8]
    [(AstType.Ref _ _) 8]
    [(AstType.MutRef _ _) 8]
    [(AstType.Region _ inner)
      (opt-load-loc-type-size
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [(AstType.Enum _) 8]
    [(AstType.EnumArgs _ _) 8]
    [(AstType.Struct _) 8]
    [(AstType.StructArgs _ _) 8]
    [(AstType.String) 8]
    [(AstType.Str) 8]
    [(AstType.Bytes) 8]
    [(AstType.Var _) 8]
    [(AstType.VarArgs _ _) 8]
    [(AstType.Consume inner)
      (opt-load-loc-type-size
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]))

;; What memory a pointer-valued var addresses:
;;   Element          -- points at/into some array/string DATA BUFFER (the
;;                       loaded data pointer, or any gep derived from one).
;;   Field B off w h  -- exactly (value of var B) + off bytes, w bytes wide at
;;                       binding time; h = B is a descriptor handle, so the
;;                       address lies inside a descriptor allocation.
;; A kind is a property of the pointer VALUE, so it survives calls and stores;
;; it dies only when its var (or a referenced base var) is redefined.
(defenum OptLoadLocKind
  (OptLoadLocUnknown)
  (OptLoadLocElement)
  (OptLoadLocField i64 i64 i64 bool)
  ;; A variable-index element pointer: base var, index var, element width,
  ;; header-typed base. Lets identical index geps of the same array share one
  ;; load key (the constant-offset Field cannot represent a var offset).
  (OptLoadLocScaledField i64 i64 i64 bool))

(define opt-load-loc-kind-base-scale : i64
  4294967296)
(define opt-load-loc-kind-offset-scale : i64
  4096)
(define opt-load-loc-kind-header-scale : i64
  4)
(define opt-load-loc-kind-width-scale : i64
  8)
(define opt-load-loc-field-base-limit : i64
  1073741824)
(define opt-load-loc-field-offset-limit : i64
  1048576)
(define opt-load-loc-field-width-limit : i64
  512)

;; Encoding: 0 unknown, 1 element, field = 2 + h*4 + w*8 + off*4096 + B*2^32
;; (always even), scaled-field = 3 + h*4 + w*8 + idx*4096 + B*2^32 (always odd).
(define (opt-load-loc-kind-encode [kind : OptLoadLocKind]) : i64
  (match kind
    [(OptLoadLocUnknown) 0]
    [(OptLoadLocElement) 1]
    [(OptLoadLocField base off width header?)
      (+
        2
        (+
          (if header?
            opt-load-loc-kind-header-scale
            0)
          (+
            (* width opt-load-loc-kind-width-scale)
            (+
              (* off opt-load-loc-kind-offset-scale)
              (* base opt-load-loc-kind-base-scale)))))]
    [(OptLoadLocScaledField base index width header?)
      (+
        3
        (+
          (if header?
            opt-load-loc-kind-header-scale
            0)
          (+
            (* width opt-load-loc-kind-width-scale)
            (+
              (* index opt-load-loc-kind-offset-scale)
              (* base opt-load-loc-kind-base-scale)))))]))

(define (opt-load-loc-kind-decode [value : i64]) : OptLoadLocKind
  (cond
    [(= value 0) (OptLoadLocUnknown)]
    [(= value 1) (OptLoadLocElement)]
    [(= (% value 2) 1)
      (OptLoadLocScaledField
        (/ value opt-load-loc-kind-base-scale)
        (%
          (/ value opt-load-loc-kind-offset-scale)
          opt-load-loc-field-offset-limit)
        (%
          (/ value opt-load-loc-kind-width-scale)
          opt-load-loc-field-width-limit)
        (= (% (/ value opt-load-loc-kind-header-scale) 2) 1))]
    [else
      (OptLoadLocField
        (/ value opt-load-loc-kind-base-scale)
        (%
          (/ value opt-load-loc-kind-offset-scale)
          opt-load-loc-field-offset-limit)
        (%
          (/ value opt-load-loc-kind-width-scale)
          opt-load-loc-field-width-limit)
        (= (% (/ value opt-load-loc-kind-header-scale) 2) 1))]))

;; Range-checked Field constructor: out-of-range components degrade to Unknown
;; (the encoding packs base<2^30, off<2^20, 0<w<512).
(define (opt-load-loc-field-checked
  [base : i64]
  [off : i64]
  [width : i64]
  [header? : bool]) : OptLoadLocKind
  (if (and
    (>= base 0)
    (< base opt-load-loc-field-base-limit)
    (>= off 0)
    (< off opt-load-loc-field-offset-limit)
    (> width 0)
    (< width opt-load-loc-field-width-limit))
    (OptLoadLocField base off width header?)
    (begin
      (cfg compile-profile (compiler-opt-load-cse-profile-note-field-key-drop))
      (OptLoadLocUnknown))))

;; Range-checked ScaledField constructor (same packing limits, index in the
;; offset slot).
(define (opt-load-loc-scaled-field-checked
  [base : i64]
  [index : i64]
  [width : i64]
  [header? : bool]) : OptLoadLocKind
  (if (and
    (>= base 0)
    (< base opt-load-loc-field-base-limit)
    (>= index 0)
    (< index opt-load-loc-field-offset-limit)
    (> width 0)
    (< width opt-load-loc-field-width-limit))
    (OptLoadLocScaledField base index width header?)
    (begin
      (cfg compile-profile (compiler-opt-load-cse-profile-note-field-key-drop))
      (OptLoadLocUnknown))))

;; Pointer-kind env: var -> encoded kind, plus a base-var refcount so the
;; common no-references case of a base redefinition skips the sweep. Cross-block
;; GVN uses cloneable sparse maps. The block-local pipeline uses one frame-sized
;; dense workspace per function; generation stamps reset it between blocks in
;; O(1), while an active-var vector keeps the rare base-invalidation sweep
;; proportional to live facts rather than frame size.
(defstruct OptLoadKindsDenseWork
  (kinds (Array i64))
  (kind-stamps (Array i64))
  (positions (Array i64))
  (refs (Array i64))
  (ref-stamps (Array i64))
  (active (Array i64)))

(defenum OptLoadPtrKinds
  (Sparse opt_i64_i64_map.Map opt_i64_i64_map.Map i64)
  (Dense OptLoadKindsDenseWork i64 i64 i64))

(define (opt-load-kinds-fill-zero! [items : (Array i64)] [index : i64]) : unit
  (if (>= index (array-length items))
    unit
    (begin
      (array-set! items index 0)
      (opt-load-kinds-fill-zero! items (+ index 1)))))

(define (opt-load-kinds-dense-work-with-size [count : i64]) : OptLoadKindsDenseWork
  (let
    [kind-stamps : (Array i64) (array.make-array i64 count)]
    [ref-stamps : (Array i64) (array.make-array i64 count)]
    (begin
      (opt-load-kinds-fill-zero! kind-stamps 0)
      (opt-load-kinds-fill-zero! ref-stamps 0)
      (OptLoadKindsDenseWork
        (array.make-array i64 count)
        kind-stamps
        (array.make-array i64 count)
        (array.make-array i64 count)
        ref-stamps
        (array.make-array i64 count)))))

(define (opt-load-kinds-dense-state
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [cap : i64]) : OptLoadPtrKinds
  (OptLoadPtrKinds.Dense work generation 0 cap))

(define (opt-load-kinds-set-cap [kinds : OptLoadPtrKinds] [cap : i64]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Sparse map refs _) (OptLoadPtrKinds.Sparse map refs cap)]
    [(OptLoadPtrKinds.Dense work generation len _)
      (OptLoadPtrKinds.Dense work generation len cap)]))

(define (opt-load-kinds-empty-with-cap [cap : i64]) : OptLoadPtrKinds
  (begin
    (cfg compile-profile (compiler-opt-load-cse-profile-note-kinds-cap cap))
    (OptLoadPtrKinds.Sparse
      (opt_i64_i64_map.with-capacity 17)
      (opt_i64_i64_map.with-capacity 17)
      cap)))

(define (opt-load-kinds-empty) : OptLoadPtrKinds
  (OptLoadPtrKinds.Sparse
    (opt_i64_i64_map.with-capacity 17)
    (opt_i64_i64_map.with-capacity 17)
    opt-load-cse-kinds-cap-floor))

(define (opt-load-kinds-lookup [kinds : OptLoadPtrKinds] [var : i64]) : OptLoadLocKind
  (match kinds
    [(OptLoadPtrKinds.Sparse map _ _)
      (match (opt_i64_i64_map.get (& map) var)
        [(opt_i64_i64_map.LookupFound value) (opt-load-loc-kind-decode value)]
        [(opt_i64_i64_map.LookupMissing) (OptLoadLocUnknown)])]
    [(OptLoadPtrKinds.Dense work generation _ _)
      (if (or
        (< var 0)
        (>= var (array-length (struct-get work kinds)))
        (not (= (array-ref (struct-get work kind-stamps) var) generation)))
        (OptLoadLocUnknown)
        (opt-load-loc-kind-decode (array-ref (struct-get work kinds) var)))]))

(define (opt-load-kinds-ref-count [refs : opt_i64_i64_map.Map] [base : i64]) : i64
  (match (opt_i64_i64_map.get (& refs) base)
    [(opt_i64_i64_map.LookupFound value) value]
    [(opt_i64_i64_map.LookupMissing) 0]))

(define (opt-load-kinds-dense-ref-count
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [base : i64]) : i64
  (if (or
    (< base 0)
    (>= base (array-length (struct-get work refs)))
    (not (= (array-ref (struct-get work ref-stamps) base) generation)))
    0
    (array-ref (struct-get work refs) base)))

(define (opt-load-kinds-dense-ref-add!
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [base : i64]
  [delta : i64]) : unit
  (if (or (< base 0) (>= base (array-length (struct-get work refs))))
    unit
    (let
      [stamps : (Array i64) (struct-get work ref-stamps)]
      [refs : (Array i64) (struct-get work refs)]
      [old : i64
        (if (= (array-ref stamps base) generation)
          (array-ref refs base)
          0)]
      (begin
        (array-set! stamps base generation)
        (array-set! refs base (+ old delta))))))

(define (opt-load-kinds-ref-add
  [refs : opt_i64_i64_map.Map]
  [base : i64]
  [delta : i64]) : opt_i64_i64_map.Map
  (let
    [next-count : i64 (+ (opt-load-kinds-ref-count refs base) delta)]
    [out : opt_i64_i64_map.Map refs]
    (begin
      (opt_i64_i64_map.insert-ref! (&mut out) base next-count)
      out)))

;; Adjust the refcount of every var a kind references (Field: its base;
;; ScaledField: base and index). Keeps the base-reference sweep correct for
;; redefinitions of either.
(define (opt-load-kinds-ref-add-kind
  [refs : opt_i64_i64_map.Map]
  [kind : OptLoadLocKind]
  [delta : i64]) : opt_i64_i64_map.Map
  (match kind
    [(OptLoadLocField base _ _ _) (opt-load-kinds-ref-add refs base delta)]
    [(OptLoadLocScaledField base index _ _)
      (opt-load-kinds-ref-add
        (opt-load-kinds-ref-add refs base delta)
        index
        delta)]
    [_ refs]))

(define (opt-load-kinds-dense-ref-add-kind!
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [kind : OptLoadLocKind]
  [delta : i64]) : unit
  (match kind
    [(OptLoadLocField base _ _ _)
      (opt-load-kinds-dense-ref-add! work generation base delta)]
    [(OptLoadLocScaledField base index _ _)
      (begin
        (opt-load-kinds-dense-ref-add! work generation base delta)
        (opt-load-kinds-dense-ref-add! work generation index delta))]
    [_ unit]))

;; Remove a var's binding (refcount-adjusting). Absent vars return unchanged.
(define (opt-load-kinds-remove [kinds : OptLoadPtrKinds] [var : i64]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Sparse map refs cap)
      (match (opt_i64_i64_map.get (& map) var)
        [(opt_i64_i64_map.LookupFound old-value)
          (let
            [map2 : opt_i64_i64_map.Map
              (let
                [out : opt_i64_i64_map.Map map]
                (begin
                  (opt_i64_i64_map.remove-ref! (&mut out) var)
                  out))]
            [refs2 : opt_i64_i64_map.Map
              (opt-load-kinds-ref-add-kind
                refs
                (opt-load-loc-kind-decode old-value)
                (- 0 1))]
            (OptLoadPtrKinds.Sparse map2 refs2 cap))]
        [(opt_i64_i64_map.LookupMissing) kinds])]
    [(OptLoadPtrKinds.Dense work generation len cap)
      (if (or
        (< var 0)
        (>= var (array-length (struct-get work kinds)))
        (not (= (array-ref (struct-get work kind-stamps) var) generation)))
        kinds
        (let
          [old-value : i64 (array-ref (struct-get work kinds) var)]
          [pos : i64 (array-ref (struct-get work positions) var)]
          [last-pos : i64 (- len 1)]
          [last-var : i64 (array-ref (struct-get work active) last-pos)]
          (begin
            (opt-load-kinds-dense-ref-add-kind!
              work
              generation
              (opt-load-loc-kind-decode old-value)
              (- 0 1))
            (if (not (= pos last-pos))
              (begin
                (array-set! (struct-get work active) pos last-var)
                (array-set! (struct-get work positions) last-var pos))
              unit)
            (array-set! (struct-get work kind-stamps) var 0)
            (OptLoadPtrKinds.Dense work generation last-pos cap))))]))

;; Bind var -> kind. Unknown removes; the env is size-capped (conservative:
;; new pointers just stay unclassified once the cap is hit).
(define (opt-load-kinds-bind
  [kinds : OptLoadPtrKinds]
  [var : i64]
  [kind : OptLoadLocKind]) : OptLoadPtrKinds
  (match kind
    [(OptLoadLocUnknown) (opt-load-kinds-remove kinds var)]
    [_
      (let
        [removed : OptLoadPtrKinds (opt-load-kinds-remove kinds var)]
        (match removed
          [(OptLoadPtrKinds.Sparse map refs cap)
            (let
              [current-len : i64 (opt_i64_i64_map.len (& map))]
              (begin
                (cfg
                  compile-profile
                  (compiler-opt-load-cse-profile-note-kinds-size current-len))
                (cfg
                  compile-profile
                  (compiler-opt-load-cse-profile-note-kinds-cap cap))
                (if (>= current-len cap)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-opt-load-cse-profile-note-kinds-cap-hit))
                    removed)
                  (let
                    [refs2 : opt_i64_i64_map.Map
                      (opt-load-kinds-ref-add-kind refs kind 1)]
                    (begin
                      (cfg
                        compile-profile
                        (compiler-opt-load-cse-profile-note-kinds-size
                          (+ current-len 1)))
                      (OptLoadPtrKinds.Sparse
                        (let
                          [out : opt_i64_i64_map.Map map]
                          (begin
                            (opt_i64_i64_map.insert-ref!
                              (&mut out)
                              var
                              (opt-load-loc-kind-encode kind))
                            out))
                        refs2
                        cap))))))]
          [(OptLoadPtrKinds.Dense work generation len cap)
            (if (or
              (< var 0)
              (>= var (array-length (struct-get work kinds)))
              (>= len cap)
              (>= len (array-length (struct-get work active))))
              (begin
                (if (or
                  (< var 0)
                  (>= var (array-length (struct-get work kinds))))
                  unit
                  (cfg
                    compile-profile
                    (compiler-opt-load-cse-profile-note-kinds-cap-hit)))
                removed)
              (begin
                (opt-load-kinds-dense-ref-add-kind! work generation kind 1)
                (array-set! (struct-get work active) len var)
                (array-set! (struct-get work positions) var len)
                (array-set!
                  (struct-get work kinds)
                  var
                  (opt-load-loc-kind-encode kind))
                (array-set! (struct-get work kind-stamps) var generation)
                (cfg
                  compile-profile
                  (compiler-opt-load-cse-profile-note-kinds-size (+ len 1)))
                (OptLoadPtrKinds.Dense work generation (+ len 1) cap)))]))]))

;; Redefinition of `var`: drop its own binding, and (only when some Field kind
;; references it as a base -- refcount-gated) sweep out every binding whose
;; base is `var`, because base-var identity must mean base-VALUE identity.
(define (opt-load-kinds-dense-drop-base-from
  [kinds : OptLoadPtrKinds]
  [base : i64]
  [index : i64]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Dense work _ len _)
      (if (>= index len)
        kinds
        (let
          [bound-var : i64 (array-ref (struct-get work active) index)]
          (match (opt-load-kinds-lookup kinds bound-var)
            [(OptLoadLocField found-base _ _ _)
              (if (= found-base base)
                (opt-load-kinds-dense-drop-base-from
                  (opt-load-kinds-remove kinds bound-var)
                  base
                  index)
                (opt-load-kinds-dense-drop-base-from kinds base (+ index 1)))]
            [(OptLoadLocScaledField found-base found-index _ _)
              (if (or (= found-base base) (= found-index base))
                (opt-load-kinds-dense-drop-base-from
                  (opt-load-kinds-remove kinds bound-var)
                  base
                  index)
                (opt-load-kinds-dense-drop-base-from kinds base (+ index 1)))]
            [_ (opt-load-kinds-dense-drop-base-from kinds base (+ index 1))])))]
    [_ kinds]))

(define (opt-load-kinds-invalidate-def [kinds : OptLoadPtrKinds] [var : i64]) : OptLoadPtrKinds
  (let
    [removed : OptLoadPtrKinds (opt-load-kinds-remove kinds var)]
    (match removed
      [(OptLoadPtrKinds.Sparse map refs cap)
        (if (<= (opt-load-kinds-ref-count refs var) 0)
          removed
          (let
            [capacity : i64 (opt_i64_i64_map.capacity (& map))]
            [out : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 17)]
            [out-refs : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 17)]
            [i : i64 (opt_i64_i64_map.next-occupied (& map) 0)]
            (begin
              (while (< i capacity)
                (begin
                  (match (opt_i64_i64_map.entry-at (& map) i)
                    [(opt_i64_i64_map.EntrySome bound-var value)
                      (let
                        [drop? : bool
                          (match (opt-load-loc-kind-decode value)
                            [(OptLoadLocField base _ _ _) (= base var)]
                            [(OptLoadLocScaledField base index _ _)
                              (or (= base var) (= index var))]
                            [_ false])]
                        (if drop?
                          unit
                          (begin
                            (opt_i64_i64_map.insert-ref!
                              (&mut out)
                              bound-var
                              value)
                            (set!
                              out-refs
                              (opt-load-kinds-ref-add-kind
                                out-refs
                                (opt-load-loc-kind-decode value)
                                1)))))]
                    [(opt_i64_i64_map.EntryNone) unit])
                  (set! i (opt_i64_i64_map.next-occupied (& map) (+ i 1)))))
              (OptLoadPtrKinds.Sparse out out-refs cap))))]
      [(OptLoadPtrKinds.Dense work generation _ _)
        (if (<= (opt-load-kinds-dense-ref-count work generation var) 0)
          removed
          (opt-load-kinds-dense-drop-base-from removed var 0))])))

(define (opt-load-kinds-dense-clone-from
  [kinds : OptLoadPtrKinds]
  [index : i64]
  [out : OptLoadPtrKinds]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Dense work _ len _)
      (if (>= index len)
        out
        (let
          [var : i64 (array-ref (struct-get work active) index)]
          (opt-load-kinds-dense-clone-from
            kinds
            (+ index 1)
            (opt-load-kinds-bind out var (opt-load-kinds-lookup kinds var)))))]
    [_ out]))

(define (opt-load-kinds-clone [kinds : OptLoadPtrKinds]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Sparse map refs cap)
      (let
        [out : opt_i64_i64_map.Map
          (opt_i64_i64_map.with-capacity
            (+ (* (opt_i64_i64_map.len (& map)) 2) 17))]
        [out-refs : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 17)]
        [capacity : i64 (opt_i64_i64_map.capacity (& map))]
        [i : i64 (opt_i64_i64_map.next-occupied (& map) 0)]
        (begin
          (while (< i capacity)
            (begin
              (match (opt_i64_i64_map.entry-at (& map) i)
                [(opt_i64_i64_map.EntrySome var value)
                  (begin
                    (opt_i64_i64_map.insert-ref! (&mut out) var value)
                    (set!
                      out-refs
                      (opt-load-kinds-ref-add-kind
                        out-refs
                        (opt-load-loc-kind-decode value)
                        1)))]
                [(opt_i64_i64_map.EntryNone) unit])
              (set! i (opt_i64_i64_map.next-occupied (& map) (+ i 1)))))
          (OptLoadPtrKinds.Sparse out out-refs cap)))]
    [(OptLoadPtrKinds.Dense _ _ _ cap)
      (opt-load-kinds-dense-clone-from
        kinds
        0
        (opt-load-kinds-empty-with-cap cap))]))

;; Control-flow join: keep only bindings identical on both edges.
(define (opt-load-kinds-intersect [a : OptLoadPtrKinds] [b : OptLoadPtrKinds]) : OptLoadPtrKinds
  (match a
    [(OptLoadPtrKinds.Sparse amap _ acap)
      (match b
        [(OptLoadPtrKinds.Sparse bmap _ _)
          (let
            [out : OptLoadPtrKinds (opt-load-kinds-empty-with-cap acap)]
            [capacity : i64 (opt_i64_i64_map.capacity (& amap))]
            [i : i64 (opt_i64_i64_map.next-occupied (& amap) 0)]
            (begin
              (while (< i capacity)
                (begin
                  (match (opt_i64_i64_map.entry-at (& amap) i)
                    [(opt_i64_i64_map.EntrySome var value)
                      (match (opt_i64_i64_map.get (& bmap) var)
                        [(opt_i64_i64_map.LookupFound bvalue)
                          (if (= value bvalue)
                            (set!
                              out
                              (opt-load-kinds-bind
                                out
                                var
                                (opt-load-loc-kind-decode value)))
                            unit)]
                        [(opt_i64_i64_map.LookupMissing) unit])]
                    [(opt_i64_i64_map.EntryNone) unit])
                  (set! i (opt_i64_i64_map.next-occupied (& amap) (+ i 1)))))
              out))]
        [(OptLoadPtrKinds.Dense _ _ _ _)
          (opt-load-kinds-intersect a (opt-load-kinds-clone b))])]
    [(OptLoadPtrKinds.Dense _ _ _ _)
      (opt-load-kinds-intersect (opt-load-kinds-clone a) b)]))

;; A (var, kind) binding that no unseen back edge can kill: the var and every
;; var its kind references are single-source, so nothing anywhere redefines
;; them and the value property is loop-invariant.
(define (opt-load-kind-binding-gvn-stable?
  [sources : opt_i64_i64_map.Map]
  [var : i64]
  [kind : OptLoadLocKind]) : bool
  (and
    (opt-gvn-stable-var? sources var)
    (match kind
      [(OptLoadLocUnknown) false]
      [(OptLoadLocElement) true]
      [(OptLoadLocField base _ _ _) (opt-gvn-stable-var? sources base)]
      [(OptLoadLocScaledField base index _ _)
        (and
          (opt-gvn-stable-var? sources base)
          (opt-gvn-stable-var? sources index))])))

;; Loop-header join when a predecessor is still unprocessed in the RPO sweep
;; (a back edge): the load table and alias facts must be dropped -- memory
;; contents and non-SSA redefinitions along the unseen edge are unknown -- but
;; a single-source var's kind is a property of its VALUE, which the back edge
;; cannot change, so those bindings carry into the loop.
(define (opt-load-kinds-filter-stable
  [kinds : OptLoadPtrKinds]
  [sources : opt_i64_i64_map.Map]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Sparse map _ cap)
      (let
        [out : OptLoadPtrKinds (opt-load-kinds-empty-with-cap cap)]
        [capacity : i64 (opt_i64_i64_map.capacity (& map))]
        [i : i64 (opt_i64_i64_map.next-occupied (& map) 0)]
        (begin
          (while (< i capacity)
            (begin
              (match (opt_i64_i64_map.entry-at (& map) i)
                [(opt_i64_i64_map.EntrySome var value)
                  (let
                    [kind : OptLoadLocKind (opt-load-loc-kind-decode value)]
                    (if (opt-load-kind-binding-gvn-stable? sources var kind)
                      (set! out (opt-load-kinds-bind out var kind))
                      unit))]
                [(opt_i64_i64_map.EntryNone) unit])
              (set! i (opt_i64_i64_map.next-occupied (& map) (+ i 1)))))
          out))]
    [(OptLoadPtrKinds.Dense _ _ _ _)
      (opt-load-kinds-filter-stable (opt-load-kinds-clone kinds) sources)]))

;; Kind transfer for one instruction: redefinitions first (own binding + the
;; base-reference sweep), then the deriving arms.
(define (opt-load-kinds-step
  [type-segment-bases : i64]
  [kinds : OptLoadPtrKinds]
  [hs : OptLoadHeaderSet]
  [instr : CompilerIrInstr]) : OptLoadPtrKinds
  (let
    [invalidated : OptLoadPtrKinds
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst) (opt-load-kinds-invalidate-def kinds dst)]
        [(option_i64.None) kinds])]
    (match instr
      [(CompilerIrInstr.Gep dst base offset ty)
        (match base
          [(CompilerIrValue.Var bvar)
            (match (opt-load-kinds-lookup invalidated bvar)
              [(OptLoadLocElement)
                (match offset
                  ;; A variable index into an element base yields a scaled
                  ;; element pointer, so identical index geps of the same
                  ;; array share one load key.
                  [(CompilerIrValue.Var index-var)
                    (opt-load-kinds-bind
                      invalidated
                      dst
                      (opt-load-loc-scaled-field-checked
                        bvar
                        index-var
                        (opt-load-loc-type-size type-segment-bases ty)
                        false))]
                  [_ (opt-load-kinds-bind invalidated dst (OptLoadLocElement))])]
              [(OptLoadLocField b0 o0 _ h0)
                (match offset
                  [(CompilerIrValue.I64 k)
                    (let
                      [sz : i64 (opt-load-loc-type-size type-segment-bases ty)]
                      (if (> sz 0)
                        (opt-load-kinds-bind
                          invalidated
                          dst
                          (opt-load-loc-field-checked b0 (+ o0 (* k sz)) sz h0))
                        invalidated))]
                  [(CompilerIrValue.Var index-var)
                    ;; Only a zero-offset field base is a provable element
                    ;; base; a nonzero offset would be lost by the scaled key.
                    (if (= o0 0)
                      (opt-load-kinds-bind
                        invalidated
                        dst
                        (opt-load-loc-scaled-field-checked
                          b0
                          index-var
                          (opt-load-loc-type-size type-segment-bases ty)
                          h0))
                      invalidated)]
                  [_ invalidated])]
              [(OptLoadLocUnknown)
                ;; `Gep dst dst ...` must not bind Field(dst,...): the base
                ;; var's post-instruction value is the RESULT, not the base.
                (match offset
                  [(CompilerIrValue.I64 k)
                    (let
                      [sz : i64 (opt-load-loc-type-size type-segment-bases ty)]
                      (if (and (> sz 0) (not (= bvar dst)))
                        (opt-load-kinds-bind
                          invalidated
                          dst
                          (opt-load-loc-field-checked
                            bvar
                            (* k sz)
                            sz
                            (opt-load-header-var? hs bvar)))
                        invalidated))]
                  [_ invalidated])]
              [(OptLoadLocScaledField _ _ _ _)
                ;; A Gep from a scaled data-buffer address may no longer fit
                ;; the canonical ScaledField key, but it is still an element
                ;; address. Keep the coarser location fact so stores through
                ;; inline slot-field Geps do not masquerade as unknown writes.
                (opt-load-kinds-bind invalidated dst (OptLoadLocElement))])]
          [_ invalidated])]
      [(CompilerIrInstr.Load dst src ty)
        (match src
          [(CompilerIrValue.Var p)
            (match (opt-load-kinds-lookup invalidated p)
              [(OptLoadLocField _ off _ header?)
                (if (and
                  header?
                  (= off 0)
                  (= (opt-load-loc-type-size type-segment-bases ty) 8))
                  (opt-load-kinds-bind invalidated dst (OptLoadLocElement))
                  invalidated)]
              [_
                (if (and
                  (opt-load-header-var? hs p)
                  (= (opt-load-loc-type-size type-segment-bases ty) 8))
                  ;; A header var's first word is the data pointer (the element
                  ;; base), whether or not the var already has a Field kind.
                  (opt-load-kinds-bind invalidated dst (OptLoadLocElement))
                  invalidated)])]
          [_ invalidated])]
      [(CompilerIrInstr.Mov dst src _)
        (match src
          [(CompilerIrValue.Var s)
            (match (opt-load-kinds-lookup invalidated s)
              [(OptLoadLocUnknown) invalidated]
              [(OptLoadLocElement)
                (opt-load-kinds-bind invalidated dst (OptLoadLocElement))]
              [(OptLoadLocField base off width header?)
                (opt-load-kinds-bind
                  invalidated
                  dst
                  (OptLoadLocField base off width header?))]
              [(OptLoadLocScaledField base index width header?)
                (opt-load-kinds-bind
                  invalidated
                  dst
                  (OptLoadLocScaledField base index width header?))])]
          [_ invalidated])]
      [_ invalidated])))

;; Load-GVN treats alias roots as pointer VALUE provenance, not as cached
;; memory contents. Calls/stores still clear the load table, but they do not
;; make an unchanged checked-reference parameter stop being exclusive. A load
;; from byte offset 0 of a recognized descriptor header is the descriptor's
;; data pointer and inherits the descriptor's canonical checked/allocation
;; root; ordinary loads remain MayAlias.
;; `epoch` is the state's allocation counter AFTER `opt-load-cse-epoch-step`,
;; i.e. the epoch a fresh allocation in `instr` must be tagged with.
(define (opt-load-alias-update-facts
  [type-segment-bases : i64]
  [facts : OptAliasFacts]
  [kinds : OptLoadPtrKinds]
  [instr : CompilerIrInstr]
  [epoch : i64]) : OptAliasFacts
  (match instr
    [(CompilerIrInstr.Load dst src ty)
      (let
        [base : OptAliasFacts (opt-alias-remove-var facts dst)]
        (match src
          [(CompilerIrValue.Var ptr)
            (match (opt-load-kinds-lookup kinds ptr)
              [(OptLoadLocField _ off _ header?)
                (if (and
                  header?
                  (= off 0)
                  (= (opt-load-loc-type-size type-segment-bases ty) 8))
                  (opt-alias-derive-var base dst ptr)
                  (opt-alias-mark-may-alias base dst))]
              [_ (opt-alias-mark-may-alias base dst)])]
          [_ (opt-alias-mark-may-alias base dst)]))]
    [_ (opt-alias-update-value-facts facts instr epoch)]))

;; Allocation-epoch counter discipline: a fresh allocation increments the
;; counter, everything else leaves it alone. The counter never decreases along
;; any path (block joins take the max, a single-predecessor entry carries it,
;; and the back-edge reset keeps the accumulated predecessors' value), so an
;; allocation's epoch is strictly greater than the creation epoch of every
;; load-table entry that already exists when it runs.
(define (opt-load-cse-epoch-step [epoch : i64] [instr : CompilerIrInstr]) : i64
  (if (opt-alias-instr-fresh-alloc? instr)
    (+ epoch 1)
    epoch))

;; Load-table keys. Raw keys are address-value identity (with an element flag
;; for the keep rules); Field keys are canonical (base var, byte offset,
;; loaded type, header-typed base) so distinct gep temps of the same slot CSE.
(defenum OptLoadKey
  (Raw CompilerIrValue AstType bool)
  (Field i64 i64 AstType bool)
  ;; A variable-index element address: base var, index var, gep element type
  ;; (the scale), header-typed base. The var-offset analog of Field -- two
  ;; structurally identical index geps of the same array key alike even though
  ;; each is a distinct temp var (the Raw key would not CSE them).
  (ScaledField i64 i64 AstType bool))

;; key, cached value, and the allocation epoch the entry was created at (the
;; state's allocation counter at bind time).
(defenum OptLoadEntry
  (Entry OptLoadKey CompilerIrValue i64))

(defenum OptLoadTable
  (Nil)
  (Cons OptLoadEntry (Box OptLoadTable)))

;; facts, table, pointer kinds, table cap, allocation-epoch counter.
(defenum OptLoadCseState
  (State OptAliasFacts OptLoadTable OptLoadPtrKinds i64 i64))

(defenum OptLoadCseResult
  (Result OptLoadCseState CompilerIrInstr))

;; How a classified store writes memory (Unknown clears the whole table).
(defenum OptLoadStoreClass
  (OptLoadStoreUnknown)
  (OptLoadStoreElement)
  (OptLoadStoreField i64 i64 i64 bool))

(define (opt-load-key-eq
  [type-segment-bases : i64]
  [a : OptLoadKey]
  [b : OptLoadKey]) : bool
  (match a
    [(OptLoadKey.Raw av aty aelem)
      (match b
        [(OptLoadKey.Raw bv bty belem)
          (and
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty)
            (=
              (if aelem
                1
                0)
              (if belem
                1
                0)))]
        [_ false])]
    [(OptLoadKey.Field abase aoff aty ah)
      (match b
        [(OptLoadKey.Field bbase boff bty bh)
          (and
            (= abase bbase)
            (= aoff boff)
            (opt-type-eq type-segment-bases aty bty)
            (=
              (if ah
                1
                0)
              (if bh
                1
                0)))]
        [_ false])]
    [(OptLoadKey.ScaledField abase aindex aty ah)
      (match b
        [(OptLoadKey.ScaledField bbase bindex bty bh)
          (and
            (= abase bbase)
            (= aindex bindex)
            (opt-type-eq type-segment-bases aty bty)
            (=
              (if ah
                1
                0)
              (if bh
                1
                0)))]
        [_ false])]))

(define (opt-load-key-uses-var? [key : OptLoadKey] [var : i64]) : bool
  (match key
    [(OptLoadKey.Raw value _ _) (opt-value-is-var? value var)]
    [(OptLoadKey.Field base _ _ _) (= base var)]
    [(OptLoadKey.ScaledField base index _ _) (or (= base var) (= index var))]))

(define (opt-load-key-type [key : OptLoadKey]) : AstType
  (match key
    [(OptLoadKey.Raw _ ty _) ty]
    [(OptLoadKey.Field _ _ ty _) ty]
    [(OptLoadKey.ScaledField _ _ ty _) ty]))

;; Canonical key for an address value under the current pointer kinds.
(define (opt-load-key-for-address
  [kinds : OptLoadPtrKinds]
  [addr : CompilerIrValue]
  [ty : AstType]) : OptLoadKey
  (match addr
    [(CompilerIrValue.Var p)
      (match (opt-load-kinds-lookup kinds p)
        [(OptLoadLocField base off _ header?)
          (OptLoadKey.Field base off ty header?)]
        [(OptLoadLocScaledField base index _ header?)
          (OptLoadKey.ScaledField base index ty header?)]
        [(OptLoadLocElement) (OptLoadKey.Raw addr ty true)]
        [(OptLoadLocUnknown) (OptLoadKey.Raw addr ty false)])]
    [_ (OptLoadKey.Raw addr ty false)]))

(define (opt-load-entry-key [entry : OptLoadEntry]) : OptLoadKey
  (match entry
    [(OptLoadEntry.Entry key _ _) key]))

(define (opt-load-entry-value [entry : OptLoadEntry]) : CompilerIrValue
  (match entry
    [(OptLoadEntry.Entry _ value _) value]))

(define (opt-load-entry-epoch [entry : OptLoadEntry]) : i64
  (match entry
    [(OptLoadEntry.Entry _ _ epoch) epoch]))

(define (opt-load-table-lookup
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [key : OptLoadKey]) : CompilerIrMaybeValue
  (match table
    [(OptLoadTable.Nil) (CompilerIrMaybeValue.No)]
    [(OptLoadTable.Cons entry rest)
      (if (opt-load-key-eq type-segment-bases (opt-load-entry-key entry) key)
        (CompilerIrMaybeValue.Some (opt-load-entry-value entry))
        (opt-load-table-lookup type-segment-bases (box-get rest) key))]))

(define (opt-load-table-has-value-with-type?
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [value : CompilerIrValue]
  [ty : AstType]) : bool
  (match table
    [(OptLoadTable.Nil) false]
    [(OptLoadTable.Cons entry rest)
      (if (and
        (opt-value-eq (opt-load-entry-value entry) value)
        (opt-type-eq
          type-segment-bases
          (opt-load-key-type (opt-load-entry-key entry))
          ty))
        true
        (opt-load-table-has-value-with-type?
          type-segment-bases
          (box-get rest)
          value
          ty))]))

(define (opt-load-table-remove-key-scan
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [key : OptLoadKey]) : OptLoadTable
  (match table
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-remove-key-scan type-segment-bases (box-get rest) key)]
        (if (opt-load-key-eq type-segment-bases (opt-load-entry-key entry) key)
          tail
          (OptLoadTable.Cons entry (box tail))))]))

;; Removal of an absent key returns the table unchanged instead of re-boxing
;; the whole spine (see opt-alias-remove-var).
(define (opt-load-table-len [table : OptLoadTable]) : i64
  (match table
    [(OptLoadTable.Nil) 0]
    [(OptLoadTable.Cons _ rest) (+ 1 (opt-load-table-len (box-get rest)))]))

;; Bind key -> value. Since granular invalidation lets tables survive stores,
;; cap growth: a fresh key is skipped once the table reaches the state cap.
(define (opt-load-table-bind
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [cap : i64]
  [key : OptLoadKey]
  [value : CompilerIrValue]
  [epoch : i64]) : OptLoadTable
  (match (opt-load-table-lookup type-segment-bases table key)
    [(CompilerIrMaybeValue.Some _)
      (OptLoadTable.Cons
        (OptLoadEntry.Entry key value epoch)
        (box (opt-load-table-remove-key-scan type-segment-bases table key)))]
    [(CompilerIrMaybeValue.No)
      (let
        [current-len : i64 (opt-load-table-len table)]
        (begin
          (cfg
            compile-profile
            (compiler-opt-load-cse-profile-note-table-size current-len))
          (cfg
            compile-profile
            (compiler-opt-load-cse-profile-note-table-cap cap))
          (if (>= current-len cap)
            (begin
              (cfg
                compile-profile
                (compiler-opt-load-cse-profile-note-table-cap-hit))
              table)
            (begin
              (cfg
                compile-profile
                (compiler-opt-load-cse-profile-note-table-size
                  (+ current-len 1)))
              (OptLoadTable.Cons
                (OptLoadEntry.Entry key value epoch)
                (box table))))))]))

(define (opt-load-copy-entry-within?
  [type-segment-bases : i64]
  [entry : OptLoadEntry]
  [src-base : i64]
  [src-off : i64]
  [size : i64]) : bool
  (match (opt-load-entry-key entry)
    [(OptLoadKey.Field base off ty _)
      (let
        [width : i64 (opt-load-loc-type-size type-segment-bases ty)]
        (and
          (= base src-base)
          (> width 0)
          (>= off src-off)
          (<= (+ off width) (+ src-off size))))]
    [_ false]))

;; The synthesized destination entry is created by THIS CopyBytes, so it takes
;; the state's current allocation epoch, not the source entry's older one.
(define (opt-load-copy-transfer-entry
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [cap : i64]
  [entry : OptLoadEntry]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [src-base : i64]
  [src-off : i64]
  [dst-base : i64]
  [dst-off : i64]
  [size : i64]
  [dst-header? : bool]
  [epoch : i64]) : OptLoadTable
  (if (opt-load-copy-entry-within?
    type-segment-bases
    entry
    src-base
    src-off
    size)
    (match (opt-load-entry-key entry)
      [(OptLoadKey.Field _ off ty _)
        (let
          [key : OptLoadKey
            (OptLoadKey.Field
              dst-base
              (+ dst-off (- off src-off))
              ty
              dst-header?)]
          [value : CompilerIrValue (opt-load-entry-value entry)]
          [eligible? : bool
            (if gated?
              (and
                (opt-load-key-gvn-stable? sources key)
                (opt-load-value-gvn-stable? sources value))
              true)]
          (if eligible?
            (opt-load-table-bind type-segment-bases table cap key value epoch)
            table))]
      [_ table])
    table))

(define (opt-load-table-transfer-copy-fields
  [type-segment-bases : i64]
  [source : OptLoadTable]
  [out : OptLoadTable]
  [cap : i64]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [src-base : i64]
  [src-off : i64]
  [dst-base : i64]
  [dst-off : i64]
  [size : i64]
  [dst-header? : bool]
  [epoch : i64]) : OptLoadTable
  (match source
    [(OptLoadTable.Nil) out]
    [(OptLoadTable.Cons entry rest)
      (opt-load-table-transfer-copy-fields
        type-segment-bases
        (box-get rest)
        (opt-load-copy-transfer-entry
          type-segment-bases
          out
          cap
          entry
          gated?
          sources
          src-base
          src-off
          dst-base
          dst-off
          size
          dst-header?
          epoch)
        cap
        gated?
        sources
        src-base
        src-off
        dst-base
        dst-off
        size
        dst-header?
        epoch)]))

(define (opt-load-entry-mentions-var? [entry : OptLoadEntry] [var : i64]) : bool
  (or
    (opt-value-is-var? (opt-load-entry-value entry) var)
    (opt-load-key-uses-var? (opt-load-entry-key entry) var)))

(define (opt-load-table-mentions-var? [table : OptLoadTable] [var : i64]) : bool
  (match table
    [(OptLoadTable.Nil) false]
    [(OptLoadTable.Cons entry rest)
      (if (opt-load-entry-mentions-var? entry var)
        true
        (opt-load-table-mentions-var? (box-get rest) var))]))

(define (opt-load-table-invalidate-var-scan [table : OptLoadTable] [var : i64]) : OptLoadTable
  (match table
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [rest2 : OptLoadTable
          (opt-load-table-invalidate-var-scan (box-get rest) var)]
        (if (opt-load-entry-mentions-var? entry var)
          rest2
          (OptLoadTable.Cons entry (box rest2))))]))

;; Drop entries whose key references `var` (raw address value or canonical
;; base var), or whose cached value is `var`. The IR is not globally SSA, so
;; any reused var id must make old load facts disappear before the new
;; instruction is processed. This runs for every defining instruction, so the
;; no-match case returns the table unchanged instead of re-boxing the spine.
(define (opt-load-table-invalidate-var [table : OptLoadTable] [var : i64]) : OptLoadTable
  (if (opt-load-table-mentions-var? table var)
    (opt-load-table-invalidate-var-scan table var)
    table))

;; Does an entry provably NOT alias a classified store? (GAP4 rules; anything
;; not provably disjoint is dropped.)
(define (opt-load-ranges-disjoint?
  [alo : i64]
  [awidth : i64]
  [blo : i64]
  [bwidth : i64]) : bool
  (and
    (> awidth 0)
    (> bwidth 0)
    (or (<= (+ alo awidth) blo) (<= (+ blo bwidth) alo))))

(define (opt-load-key-alias-root [facts : OptAliasFacts] [key : OptLoadKey]) : OptAliasRoot
  (match key
    [(OptLoadKey.Raw value _ _) (opt-alias-root-of-value facts value)]
    [(OptLoadKey.Field base _ _ _) (opt-alias-root-of-var facts base)]
    ;; A scaled element address lives in the base var's buffer: rooting it at
    ;; the base is what lets an exclusive-allocation store root clear it.
    [(OptLoadKey.ScaledField base _ _ _) (opt-alias-root-of-var facts base)]))

(define (opt-load-entry-survives-store-location?
  [type-segment-bases : i64]
  [class : OptLoadStoreClass]
  [entry : OptLoadEntry]) : bool
  (match class
    [(OptLoadStoreElement)
      ;; Element stores write data-buffer memory; only descriptor-field
      ;; entries (header-typed base) are provably outside every buffer.
      (match (opt-load-entry-key entry)
        [(OptLoadKey.Field _ _ _ header?) header?]
        [_ false])]
    [(OptLoadStoreField sbase slo swidth sheader?)
      (match (opt-load-entry-key entry)
        [(OptLoadKey.Raw _ _ element?)
          ;; A descriptor-field store cannot touch buffer memory; a generic
          ;; field store might (inline structs live inside buffers).
          (and element? sheader?)]
        [(OptLoadKey.Field ebase eoff ety _)
          ;; Same object (same un-redefined base var) at disjoint byte
          ;; ranges. Different base vars may name the same object -- drop.
          (and
            (= ebase sbase)
            (opt-load-ranges-disjoint?
              slo
              swidth
              eoff
              (opt-load-loc-type-size type-segment-bases ety)))]
        ;; A var-offset key cannot prove disjointness from any store: drop
        ;; (conservative, matching a generic Raw).
        [(OptLoadKey.ScaledField _ _ _ _) false])]
    [(OptLoadStoreUnknown) false]))

;; Epoch-ordering rule: freshly allocated storage is disjoint from every address
;; value that already existed when the allocation ran. So a store rooted at an
;; allocation of epoch E cannot alias an entry whose creation epoch is strictly
;; below E -- whatever that entry's own root class is (including NoRoot, an
;; untracked pointer), and whether or not the allocation escapes afterwards. The
;; inequality must be strict: an entry bound at exactly E may address the
;; allocation itself. Entries created at or after E are dropped as before.
(define (opt-load-entry-precedes-fresh-alloc?
  [store-root : OptAliasRoot]
  [entry : OptLoadEntry]) : bool
  (match store-root
    [(OptAliasRoot.Fresh _ alloc-epoch)
      (< (opt-load-entry-epoch entry) alloc-epoch)]
    [(OptAliasRoot.Exclusive _) false]
    [(OptAliasRoot.Shared _) false]
    [(OptAliasRoot.NoRoot) false]))

(define (opt-load-entry-survives-store?
  [type-segment-bases : i64]
  [facts : OptAliasFacts]
  [store-root : OptAliasRoot]
  [class : OptLoadStoreClass]
  [entry : OptLoadEntry]) : bool
  (or
    (opt-alias-store-root-disjoint?
      store-root
      (opt-load-key-alias-root facts (opt-load-entry-key entry)))
    (opt-load-entry-precedes-fresh-alloc? store-root entry)
    (opt-load-entry-survives-store-location? type-segment-bases class entry)))

(define (opt-load-table-filter-store
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [facts : OptAliasFacts]
  [store-root : OptAliasRoot]
  [class : OptLoadStoreClass]) : OptLoadTable
  (match table
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-filter-store
            type-segment-bases
            (box-get rest)
            facts
            store-root
            class)]
        (if (opt-load-entry-survives-store?
          type-segment-bases
          facts
          store-root
          class
          entry)
          (OptLoadTable.Cons entry (box tail))
          tail))]))

;; Classify a store's target from the pointer kinds; `width` is the byte size
;; actually written (StorePtr type width / CopyBytes size).
(define (opt-load-classify-store
  [kinds : OptLoadPtrKinds]
  [ptr : CompilerIrValue]
  [width : i64]) : OptLoadStoreClass
  (if (<= width 0)
    (OptLoadStoreUnknown)
    (match ptr
      [(CompilerIrValue.Var p)
        (match (opt-load-kinds-lookup kinds p)
          [(OptLoadLocElement) (OptLoadStoreElement)]
          [(OptLoadLocField base off _ header?)
            (OptLoadStoreField base off width header?)]
          ;; A scaled element store writes data-buffer memory (base is the
          ;; loaded data pointer), exactly like an Element store: descriptor
          ;; fields are provably outside it, so header-typed entries survive.
          [(OptLoadLocScaledField _ _ _ _) (OptLoadStoreElement)]
          [(OptLoadLocUnknown) (OptLoadStoreUnknown)])]
      [_ (OptLoadStoreUnknown)])))

;; Block-local dead-store elimination. Pending entries are stores that have not
;; yet been observed by an aliasing load or unknown memory effect.
(defenum OptDeadStoreEntry
  (Entry i64 OptLoadStoreClass))

(defstruct OptDeadStoreSet
  (slots (Array OptDeadStoreEntry))
  (len i64))

(define (opt-dead-store-set-with-capacity [capacity : i64]) : OptDeadStoreSet
  (OptDeadStoreSet (array.make-array OptDeadStoreEntry capacity) 0))

(define (opt-dead-store-set-clear [pending : OptDeadStoreSet]) : OptDeadStoreSet
  (OptDeadStoreSet (struct-get pending slots) 0))

(define (opt-dead-store-trackable? [class : OptLoadStoreClass]) : bool
  (match class
    [(OptLoadStoreField _ _ _ _) true]
    [_ false]))

(define (opt-dead-store-classes-exact?
  [a : OptLoadStoreClass]
  [b : OptLoadStoreClass]) : bool
  (match a
    [(OptLoadStoreField abase aoff awidth aheader?)
      (match b
        [(OptLoadStoreField bbase boff bwidth bheader?)
          (and
            (= abase bbase)
            (= aoff boff)
            (= awidth bwidth)
            (=
              (if aheader?
                1
                0)
              (if bheader?
                1
                0)))]
        [_ false])]
    [_ false]))

(define (opt-dead-store-classes-disjoint?
  [access : OptLoadStoreClass]
  [candidate : OptLoadStoreClass]) : bool
  (match access
    [(OptLoadStoreUnknown) false]
    [(OptLoadStoreElement)
      (match candidate
        [(OptLoadStoreField _ _ _ header?) header?]
        [_ false])]
    [(OptLoadStoreField abase aoff awidth aheader?)
      (match candidate
        [(OptLoadStoreElement) aheader?]
        [(OptLoadStoreField bbase boff bwidth _)
          (and
            (= abase bbase)
            (opt-load-ranges-disjoint? aoff awidth boff bwidth))]
        [(OptLoadStoreUnknown) false])]))

(define (opt-dead-store-filter-store
  [pending : OptDeadStoreSet]
  [dead : (Array i64)]
  [class : OptLoadStoreClass]) : OptDeadStoreSet
  (let
    [slots : (Array OptDeadStoreEntry) (struct-get pending slots)]
    [count : i64 (struct-get pending len)]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (let
          [entry : OptDeadStoreEntry (array-ref slots read)]
          (begin
            (match entry
              [(OptDeadStoreEntry.Entry old-index old-class)
                (if (opt-dead-store-classes-exact? old-class class)
                  (array-set! dead old-index 1)
                  (if (opt-dead-store-classes-disjoint? class old-class)
                    (begin
                      (if (not (= write read))
                        (array-set! slots write entry)
                        unit)
                      (set! write (+ write 1)))
                    unit))])
            (set! read (+ read 1)))))
      (OptDeadStoreSet slots write))))

(define (opt-dead-store-add-current
  [pending : OptDeadStoreSet]
  [index : i64]
  [class : OptLoadStoreClass]) : OptDeadStoreSet
  (if (and
    (opt-dead-store-trackable? class)
    (< (struct-get pending len) (array-length (struct-get pending slots))))
    (let
      [slots : (Array OptDeadStoreEntry) (struct-get pending slots)]
      [len : i64 (struct-get pending len)]
      (begin
        (array-set! slots len (OptDeadStoreEntry.Entry index class))
        (OptDeadStoreSet slots (+ len 1))))
    pending))

(define (opt-dead-store-filter-access
  [pending : OptDeadStoreSet]
  [class : OptLoadStoreClass]) : OptDeadStoreSet
  (let
    [slots : (Array OptDeadStoreEntry) (struct-get pending slots)]
    [count : i64 (struct-get pending len)]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (let
          [entry : OptDeadStoreEntry (array-ref slots read)]
          (begin
            (match entry
              [(OptDeadStoreEntry.Entry _ old-class)
                (if (opt-dead-store-classes-disjoint? class old-class)
                  (begin
                    (if (not (= write read))
                      (array-set! slots write entry)
                      unit)
                    (set! write (+ write 1)))
                  unit)])
            (set! read (+ read 1)))))
      (OptDeadStoreSet slots write))))

(define (opt-dead-store-class-uses-var? [class : OptLoadStoreClass] [var : i64]) : bool
  (match class
    [(OptLoadStoreField base _ _ _) (= base var)]
    [_ false]))

(define (opt-dead-store-filter-def [pending : OptDeadStoreSet] [var : i64]) : OptDeadStoreSet
  (let
    [slots : (Array OptDeadStoreEntry) (struct-get pending slots)]
    [count : i64 (struct-get pending len)]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (let
          [entry : OptDeadStoreEntry (array-ref slots read)]
          (begin
            (match entry
              [(OptDeadStoreEntry.Entry _ class)
                (if (opt-dead-store-class-uses-var? class var)
                  unit
                  (begin
                    (if (not (= write read))
                      (array-set! slots write entry)
                      unit)
                    (set! write (+ write 1))))])
            (set! read (+ read 1)))))
      (OptDeadStoreSet slots write))))

(define (opt-dead-store-other-keeps-pending? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Alloc _ _) true]
    [_
      (if (opt-alias-instr-clears-all? instr)
        false
        (match (compiler-ir-instr-effect instr)
          [(CompilerIrEffect.Pure) true]
          [_ false]))]))

(define (opt-dead-store-step
  [type-segment-bases : i64]
  [pending : OptDeadStoreSet]
  [kinds : OptLoadPtrKinds]
  [dead : (Array i64)]
  [index : i64]
  [instr : CompilerIrInstr]) : OptDeadStoreSet
  (let
    [after-memory : OptDeadStoreSet
      (match instr
        [(CompilerIrInstr.StorePtr ptr _ ty)
          (let
            [class : OptLoadStoreClass
              (opt-load-classify-store
                kinds
                ptr
                (opt-load-loc-type-size type-segment-bases ty))]
            (opt-dead-store-add-current
              (opt-dead-store-filter-store pending dead class)
              index
              class))]
        [(CompilerIrInstr.Load _ src ty)
          (opt-dead-store-filter-access
            pending
            (opt-load-classify-store
              kinds
              src
              (opt-load-loc-type-size type-segment-bases ty)))]
        [(CompilerIrInstr.CopyBytes _ _ _) (opt-dead-store-set-clear pending)]
        [_
          (if (opt-dead-store-other-keeps-pending? instr)
            pending
            (opt-dead-store-set-clear pending))])]
    (match (opt-instr-def-var instr)
      [(option_i64.Some dst) (opt-dead-store-filter-def after-memory dst)]
      [(option_i64.None) after-memory])))

(define (opt-dead-store-compact!
  [instrs : CompilerIrInstrSeq]
  [dead : (Array i64)]
  [count : i64]) : unit
  (let
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (begin
          (if (= (array-ref dead read) 0)
            (begin
              (if (not (= write read))
                (compiler-ir-instr-seq-set!
                  instrs
                  write
                  (compiler-ir-instr-seq-ref instrs read))
                unit)
              (set! write (+ write 1)))
            unit)
          (set! read (+ read 1))))
      (set! (struct-get instrs len) write))))

(define (opt-dead-store-storeptr-capacity [instrs : CompilerIrInstrSeq]) : i64
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [stores : i64 0]
    (begin
      (while (and (< index count) (< stores 128))
        (begin
          (match (compiler-ir-instr-seq-ref instrs index)
            [(CompilerIrInstr.StorePtr _ _ _) (set! stores (+ stores 1))]
            [_ unit])
          (set! index (+ index 1))))
      stores)))

(define (opt-dead-store-instr-seq-known-with-kinds
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [store-capacity : i64]
  [initial-kinds : OptLoadPtrKinds]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (if (>= store-capacity 2)
    (let
      [count : i64 (compiler-ir-instr-seq-count instrs)]
      [dead : (Array i64) (make-array i64 count)]
      [pending : OptDeadStoreSet
        (opt-dead-store-set-with-capacity store-capacity)]
      [kinds : OptLoadPtrKinds initial-kinds]
      [index : i64 0]
      (begin
        (while (< index count)
          (let
            [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
            (begin
              (set!
                pending
                (opt-dead-store-step
                  type-segment-bases
                  pending
                  kinds
                  dead
                  index
                  instr))
              (set!
                kinds
                (opt-load-kinds-step type-segment-bases kinds hs instr))
              (set! index (+ index 1)))))
        (opt-dead-store-compact! instrs dead count)
        instrs))
    instrs))

(define (opt-dead-store-instr-seq-known
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [store-capacity : i64]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (opt-dead-store-instr-seq-known-with-kinds
    type-segment-bases
    hs
    store-capacity
    (opt-load-kinds-empty)
    instrs))

(define (opt-dead-store-instr-seq
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (opt-dead-store-instr-seq-known
    type-segment-bases
    hs
    (opt-dead-store-storeptr-capacity instrs)
    instrs))

;; GVN stability for a key's referenced vars (the cross-block pass only
;; caches/forwards through single-source vars, mirroring its original
;; gates; the block-local pass needs none).
(define (opt-load-key-gvn-stable?
  [sources : opt_i64_i64_map.Map]
  [key : OptLoadKey]) : bool
  (match key
    [(OptLoadKey.Raw value _ _) (opt-gvn-value-stable? sources value)]
    [(OptLoadKey.Field base _ _ _) (opt-gvn-stable-var? sources base)]
    [(OptLoadKey.ScaledField base index _ _)
      (and
        (opt-gvn-stable-var? sources base)
        (opt-gvn-stable-var? sources index))]))

(define (opt-load-value-gvn-stable?
  [sources : opt_i64_i64_map.Map]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var v) (opt-gvn-stable-var? sources v)]
    [_ true]))

(define (opt-load-subword-forward-const
  [type-segment-bases : i64]
  [value : CompilerIrValue]
  [ty : AstType]) : CompilerIrMaybeValue
  (match ty
    [(AstType.F32) (CompilerIrMaybeValue.No)]
    [_
      (match (opt-normalize-const value ty)
        [(OptKnownConst.SomeConst normalized normalized-ty)
          (if (opt-type-eq type-segment-bases normalized-ty ty)
            (CompilerIrMaybeValue.Some normalized)
            (CompilerIrMaybeValue.No))]
        [(OptKnownConst.NoConst) (CompilerIrMaybeValue.No)])]))

(define (opt-load-subword-store-forward-value
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [value : CompilerIrValue]
  [ty : AstType]
  [width : i64]) : CompilerIrMaybeValue
  (if (opt-copy-safe-source? value)
    (if (> width 0)
      (match (opt-load-subword-forward-const type-segment-bases value ty)
        [(CompilerIrMaybeValue.Some normalized)
          (CompilerIrMaybeValue.Some normalized)]
        [(CompilerIrMaybeValue.No)
          (match value
            [(CompilerIrValue.Var _)
              (if (opt-load-table-has-value-with-type?
                type-segment-bases
                table
                value
                ty)
                (CompilerIrMaybeValue.Some value)
                (CompilerIrMaybeValue.No))]
            [_ (CompilerIrMaybeValue.No)])])
      (CompilerIrMaybeValue.No))
    (CompilerIrMaybeValue.No)))

;; Any instruction that is neither Load/StorePtr/CopyBytes nor a clear-all:
;; drop def-invalidated entries, update alias facts and pointer kinds.
(define (opt-load-cse-state-step-other
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [instr : CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State facts table kinds table-cap epoch)
      (let
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        (OptLoadCseState.State
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)
          (match (opt-instr-def-var instr)
            [(option_i64.Some dst) (opt-load-table-invalidate-var table dst)]
            [(option_i64.None) table])
          (opt-load-kinds-step type-segment-bases kinds hs instr)
          table-cap
          next-epoch))]))

;; Calls/unknown effects: the table clears entirely; pointer kinds are value
;; properties and survive (only the instr's own def is invalidated). The
;; allocation counter is carried, never reset: alias facts keep their
;; Unique(epoch) roots across the clear, so a lower counter afterwards would
;; make a later entry look older than an earlier allocation.
(define (opt-load-cse-state-clear-for-memory
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [instr : CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State facts _ kinds table-cap epoch)
      (let
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        (OptLoadCseState.State
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)
          (OptLoadTable.Nil)
          (opt-load-kinds-step type-segment-bases kinds hs instr)
          table-cap
          next-epoch))]))

;; Apply one callee parameter-write bit to the cached load table. The callee
;; summary carries no byte-range fact, so filtering is root-only: a write
;; through a fresh/exclusive argument preserves entries on different proven
;; roots; missing/unrooted/shared arguments conservatively empty the table.
(define (opt-load-table-filter-call-writes
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [facts : OptAliasFacts]
  [args : CompilerIrCallArgs]
  [summary : i64]
  [index : i64]) : OptLoadTable
  (if (>= index (opt-call-memory-param-limit))
    table
    (if (not (opt-call-memory-summary-param-write? summary index))
      (opt-load-table-filter-call-writes
        type-segment-bases
        table
        facts
        args
        summary
        (+ index 1))
      (match (opt-call-memory-arg-at args index)
        [(CompilerIrMaybeValue.No) (OptLoadTable.Nil)]
        [(CompilerIrMaybeValue.Some value)
          (opt-load-table-filter-call-writes
            type-segment-bases
            (opt-load-table-filter-store
              type-segment-bases
              table
              facts
              (opt-alias-root-of-value facts value)
              (OptLoadStoreUnknown))
            facts
            args
            summary
            (+ index 1))]))))

(define (opt-load-cse-state-direct-call
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [call-memory : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [dst : i64]
  [name : i64]
  [args : CompilerIrCallArgs]
  [instr : CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State facts table kinds table-cap epoch)
      (let
        ;; Filtering reads the PRE-call facts and table, so a tl_alloc call
        ;; cannot use its own (not yet bound) fresh root to keep entries.
        [filtered : OptLoadTable
          (match (opt_i64_i64_map.get
            (& call-memory)
            (compiler-ir-symbol-id name))
            [(opt_i64_i64_map.LookupFound summary)
              (if (or
                (opt-call-memory-summary-global? summary)
                (opt-call-memory-summary-unknown? summary))
                (OptLoadTable.Nil)
                (opt-load-table-filter-call-writes
                  type-segment-bases
                  table
                  facts
                  args
                  summary
                  0))]
            [(opt_i64_i64_map.LookupMissing)
              (match (compiler-ir-direct-call-effect-id name)
                [(CompilerIrEffect.MemoryRead) table]
                [_ (OptLoadTable.Nil)])])]
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        (OptLoadCseState.State
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)
          (opt-load-table-invalidate-var filtered dst)
          (opt-load-kinds-step type-segment-bases kinds hs instr)
          table-cap
          next-epoch))]))

;; StorePtr: granular invalidation, then store-to-load forwarding. The
;; forwarded value must be a copy-safe source (no hidden global reads). Sub-word
;; forwarding additionally requires a normalized constant or a same-type load
;; origin, so arbitrary non-canonical sub-word vars still reload from memory.
(define (opt-load-cse-state-store
  [type-segment-bases : i64]
  ;; lint-allow: unused-variable
  [hs : OptLoadHeaderSet]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [ty : AstType]
  [instr : CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State facts table kinds table-cap epoch)
      (let
        [width : i64 (opt-load-loc-type-size type-segment-bases ty)]
        [class : OptLoadStoreClass (opt-load-classify-store kinds ptr width)]
        [store-root : OptAliasRoot (opt-alias-root-of-value facts ptr)]
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        [facts2 : OptAliasFacts
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)]
        [filtered : OptLoadTable
          (opt-load-table-filter-store
            type-segment-bases
            table
            facts
            store-root
            class)]
        (match class
          [(OptLoadStoreUnknown)
            ;; Unknown offset/location still preserves entries rooted at a
            ;; different exclusive checked or fresh allocation root, and entries
            ;; created before a fresh store root's allocation epoch.
            (OptLoadCseState.State facts2 filtered kinds table-cap next-epoch)]
          [_
            (let
              [key : OptLoadKey (opt-load-key-for-address kinds ptr ty)]
              [forwardable? : bool
                (if gated?
                  (and
                    (opt-load-key-gvn-stable? sources key)
                    (opt-load-value-gvn-stable? sources value))
                  true)]
              [forwarded : CompilerIrMaybeValue
                (if forwardable?
                  (if (= width 8)
                    (if (opt-copy-safe-source? value)
                      (CompilerIrMaybeValue.Some value)
                      (CompilerIrMaybeValue.No))
                    (opt-load-subword-store-forward-value
                      type-segment-bases
                      table
                      value
                      ty
                      width))
                  (CompilerIrMaybeValue.No))]
              (OptLoadCseState.State
                facts2
                (match forwarded
                  [(CompilerIrMaybeValue.Some forwarded-value)
                    (opt-load-table-bind
                      type-segment-bases
                      filtered
                      table-cap
                      key
                      forwarded-value
                      next-epoch)]
                  [(CompilerIrMaybeValue.No) filtered])
                kinds
                table-cap
                next-epoch))]))]))

;; CopyBytes writes `size` bytes through its dst pointer: same granular
;; invalidation, plus conservative field-to-field forwarding when source and
;; destination are disjoint ranges of the same tracked base.
(define (opt-load-cse-state-copy-bytes
  [type-segment-bases : i64]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [dst : CompilerIrValue]
  [src : CompilerIrValue]
  [size : i64]
  [instr : CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State facts table kinds table-cap epoch)
      (let
        [class : OptLoadStoreClass (opt-load-classify-store kinds dst size)]
        [src-class : OptLoadStoreClass (opt-load-classify-store kinds src size)]
        [store-root : OptAliasRoot (opt-alias-root-of-value facts dst)]
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        [facts2 : OptAliasFacts
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)]
        [filtered : OptLoadTable
          (opt-load-table-filter-store
            type-segment-bases
            table
            facts
            store-root
            class)]
        (match class
          [(OptLoadStoreUnknown)
            (OptLoadCseState.State facts2 filtered kinds table-cap next-epoch)]
          [(OptLoadStoreElement)
            (OptLoadCseState.State facts2 filtered kinds table-cap next-epoch)]
          [(OptLoadStoreField dst-base dst-off _ dst-header?)
            (let
              [copied : OptLoadTable
                (match src-class
                  [(OptLoadStoreField src-base src-off _ src-header?)
                    (if (and
                      (= src-base dst-base)
                      (=
                        (if src-header?
                          1
                          0)
                        (if dst-header?
                          1
                          0))
                      (opt-load-ranges-disjoint? src-off size dst-off size))
                      (opt-load-table-transfer-copy-fields
                        type-segment-bases
                        filtered
                        filtered
                        table-cap
                        gated?
                        sources
                        src-base
                        src-off
                        dst-base
                        dst-off
                        size
                        dst-header?
                        next-epoch)
                      filtered)]
                  [_ filtered])]
              (OptLoadCseState.State facts2 copied kinds table-cap next-epoch))]))]))

(define (opt-load-cse-core-load
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]
  [instr : CompilerIrInstr]) : OptLoadCseResult
  (match state
    [(OptLoadCseState.State facts table kinds table-cap epoch)
      (let
        ;; The dst redefinition drops stale entries first; the key is computed
        ;; from the PRE-def kinds (a `Load dst <- dst` reads the old address).
        [table2 : OptLoadTable (opt-load-table-invalidate-var table dst)]
        [key : OptLoadKey (opt-load-key-for-address kinds src ty)]
        [eligible? : bool
          (if gated?
            (and
              (opt-gvn-stable-var? sources dst)
              (opt-load-key-gvn-stable? sources key))
            true)]
        (match (if eligible?
          (opt-load-table-lookup type-segment-bases table2 key)
          (CompilerIrMaybeValue.No))
          [(CompilerIrMaybeValue.Some earlier)
            ;; Entries whose cached value is dst were dropped above, so the
            ;; rewrite never copies a var this instruction overwrites.
            (let
              [new-instr : CompilerIrInstr (CompilerIrInstr.Mov dst earlier ty)]
              [next-epoch : i64 (opt-load-cse-epoch-step epoch new-instr)]
              (OptLoadCseResult.Result
                (OptLoadCseState.State
                  (opt-load-alias-update-facts
                    type-segment-bases
                    facts
                    kinds
                    new-instr
                    next-epoch)
                  table2
                  (opt-load-kinds-step type-segment-bases kinds hs new-instr)
                  table-cap
                  next-epoch)
                new-instr))]
          [(CompilerIrMaybeValue.No)
            (let
              [record? : bool
                (and eligible? (not (opt-load-key-uses-var? key dst)))]
              [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
              (OptLoadCseResult.Result
                (OptLoadCseState.State
                  (opt-load-alias-update-facts
                    type-segment-bases
                    facts
                    kinds
                    instr
                    next-epoch)
                  (if record?
                    (opt-load-table-bind
                      type-segment-bases
                      table2
                      table-cap
                      key
                      (CompilerIrValue.Var dst)
                      next-epoch)
                    table2)
                  (opt-load-kinds-step type-segment-bases kinds hs instr)
                  table-cap
                  next-epoch)
                instr))]))]))

;; Shared per-instruction dispatcher for the block-local (gated? false) and
;; cross-block (gated? true) passes. StorePtr/CopyBytes are matched before the
;; clear-all check: they ARE memory writes, handled granularly.
(define (opt-load-cse-dispatch
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [instr : CompilerIrInstr]) : OptLoadCseResult
  (match instr
    [(CompilerIrInstr.StorePtr ptr value ty)
      (OptLoadCseResult.Result
        (opt-load-cse-state-store
          type-segment-bases
          hs
          gated?
          sources
          state
          ptr
          value
          ty
          instr)
        instr)]
    [(CompilerIrInstr.CopyBytes dst src size)
      (OptLoadCseResult.Result
        (opt-load-cse-state-copy-bytes
          type-segment-bases
          gated?
          sources
          state
          dst
          src
          size
          instr)
        instr)]
    [(CompilerIrInstr.Load dst src ty)
      (opt-load-cse-core-load
        type-segment-bases
        hs
        gated?
        sources
        state
        dst
        src
        ty
        instr)]
    [(CompilerIrInstr.Call dst name args _)
      (OptLoadCseResult.Result
        (opt-load-cse-state-direct-call
          type-segment-bases
          hs
          call-memory
          state
          dst
          name
          args
          instr)
        instr)]
    [_
      (if (opt-alias-instr-clears-all? instr)
        (OptLoadCseResult.Result
          (opt-load-cse-state-clear-for-memory
            type-segment-bases
            hs
            state
            instr)
          instr)
        (OptLoadCseResult.Result
          (opt-load-cse-state-step-other type-segment-bases hs state instr)
          instr))]))

(define (opt-load-cse-instrs-from
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) (CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (match (opt-load-cse-dispatch
        type-segment-bases
        hs
        false
        sources
        call-memory
        state
        instr)
        [(OptLoadCseResult.Result next-state new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-load-cse-instrs-from
              type-segment-bases
              hs
              sources
              call-memory
              next-state
              (box-get rest)))])]))

(define (opt-load-cse-instrs
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (opt-load-cse-instrs-from
    type-segment-bases
    hs
    (opt_i64_i64_map.with-capacity 1)
    (opt_i64_i64_map.with-capacity 1)
    state
    instrs))

;; --- cross-block redundant-load GVN -----------------------------------------
(defenum OptMaybeLoadCseState
  (No)
  (Some OptLoadCseState))

(defenum OptLoadGvnBlockRewrite
  (Rewrite OptLoadCseState CompilerIrInstrSeq))

(define (opt-load-cse-state-with-caps-and-facts
  [table-cap : i64]
  [kinds-cap : i64]
  [facts : OptAliasFacts]) : OptLoadCseState
  (begin
    (cfg
      compile-profile
      (compiler-opt-load-cse-profile-note-table-cap table-cap))
    (OptLoadCseState.State
      facts
      (OptLoadTable.Nil)
      (opt-load-kinds-empty-with-cap kinds-cap)
      table-cap
      0)))

(define (opt-load-cse-empty-state-with-caps [table-cap : i64] [kinds-cap : i64]) : OptLoadCseState
  (opt-load-cse-state-with-caps-and-facts table-cap kinds-cap (opt-alias-empty)))

(define (opt-load-cse-empty-state-for-size [instr-count : i64]) : OptLoadCseState
  (opt-load-cse-empty-state-with-caps
    (opt-load-cse-table-cap-for-size instr-count)
    (opt-load-cse-kinds-cap-for-size instr-count)))

(define (opt-load-cse-empty-state-for-size-with-kinds
  [instr-count : i64]
  [kinds : OptLoadPtrKinds]
  [facts : OptAliasFacts]) : OptLoadCseState
  (let
    [table-cap : i64 (opt-load-cse-table-cap-for-size instr-count)]
    (begin
      (cfg
        compile-profile
        (compiler-opt-load-cse-profile-note-table-cap table-cap))
      (OptLoadCseState.State
        facts
        (OptLoadTable.Nil)
        (opt-load-kinds-set-cap
          kinds
          (opt-load-cse-kinds-cap-for-size instr-count))
        table-cap
        0))))

;; The load table is a persistent list, but the alias facts and pointer kinds
;; are mutable tables; entering a block through a single predecessor must
;; process a copy.
(define (opt-load-cse-state-clone-facts [state : OptLoadCseState]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State facts table kinds table-cap epoch)
      (OptLoadCseState.State
        (opt-alias-clone facts)
        table
        (opt-load-kinds-clone kinds)
        table-cap
        epoch)]))

(defenum OptMaybeLoadEntry
  (No)
  (Some OptLoadEntry))

(define (opt-load-table-find-entry
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [key : OptLoadKey]) : OptMaybeLoadEntry
  (match table
    [(OptLoadTable.Nil) (OptMaybeLoadEntry.No)]
    [(OptLoadTable.Cons entry rest)
      (if (opt-load-key-eq type-segment-bases (opt-load-entry-key entry) key)
        (OptMaybeLoadEntry.Some entry)
        (opt-load-table-find-entry type-segment-bases (box-get rest) key))]))

;; A joined entry must be older than every allocation both edges agree on, so it
;; keeps the LATER (larger) of the two creation epochs -- the conservative side
;; of the strict `entry-epoch < alloc-epoch` keep test.
(define (opt-load-table-intersect-entry
  [type-segment-bases : i64]
  [entry : OptLoadEntry]
  [other : OptLoadTable]) : OptMaybeLoadEntry
  (match entry
    [(OptLoadEntry.Entry key value epoch)
      (match (opt-load-table-find-entry type-segment-bases other key)
        [(OptMaybeLoadEntry.No) (OptMaybeLoadEntry.No)]
        [(OptMaybeLoadEntry.Some found)
          (if (opt-value-eq (opt-load-entry-value found) value)
            (OptMaybeLoadEntry.Some
              (OptLoadEntry.Entry
                key
                value
                (let
                  [found-epoch : i64 (opt-load-entry-epoch found)]
                  (if (< epoch found-epoch)
                    found-epoch
                    epoch))))
            (OptMaybeLoadEntry.No))])]))

(define (opt-load-table-intersect
  [type-segment-bases : i64]
  [a : OptLoadTable]
  [b : OptLoadTable]) : OptLoadTable
  (match a
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-intersect type-segment-bases (box-get rest) b)]
        (match (opt-load-table-intersect-entry type-segment-bases entry b)
          [(OptMaybeLoadEntry.Some merged)
            (OptLoadTable.Cons merged (box tail))]
          [(OptMaybeLoadEntry.No) tail]))]))

(define (opt-load-cse-state-intersect
  [type-segment-bases : i64]
  [a : OptLoadCseState]
  [b : OptLoadCseState]) : OptLoadCseState
  (match a
    [(OptLoadCseState.State afacts atable akinds atable-cap aepoch)
      (match b
        [(OptLoadCseState.State bfacts btable bkinds btable-cap bepoch)
          (OptLoadCseState.State
            (opt-alias-intersect afacts bfacts)
            (opt-load-table-intersect type-segment-bases atable btable)
            (opt-load-kinds-intersect akinds bkinds)
            (if (< atable-cap btable-cap)
              atable-cap
              btable-cap)
            ;; The counter takes the MAX so the next allocation's epoch still
            ;; exceeds every entry epoch arriving on either edge.
            (if (< aepoch bepoch)
              bepoch
              aepoch))])]))

(define (opt-load-state-array-fill-empty!
  [states : (Array OptMaybeLoadCseState)]
  [count : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! states i (OptMaybeLoadCseState.No))
          (set! i (+ i 1))))
      unit)))

;; --- loop-header descriptor-entry carry ---------------------------------------
;;
;; A descriptor field load (array length/data pointer) reads memory provably
;; outside every data buffer, so a loop that only writes element memory
;; (scaled/element stores of a data pointer) cannot change it. When a loop
;; header's back edge arrives unprocessed in the RPO sweep, the entry table
;; keeps those header-typed entries whose base var is single-source instead
;; of resetting to the empty table -- provided a static scan proves the loop
;; has no calls, barriers, or stores that are not provably element-based.
;; Keep only descriptor-field entries whose base var is single-source.
(define (opt-load-table-filter-descriptor-stable
  [table : OptLoadTable]
  [sources : opt_i64_i64_map.Map]) : OptLoadTable
  (match table
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-filter-descriptor-stable (box-get rest) sources)]
        (match (opt-load-entry-key entry)
          [(OptLoadKey.Field base _ _ header?)
            (if (and header? (opt-gvn-stable-var? sources base))
              (OptLoadTable.Cons entry (box tail))
              tail)]
          [_ tail]))]))

;; Find the (single, SSA) instruction defining `var` anywhere in the function.
(define (opt-load-gvn-find-def-instrs
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptMaybeInstr
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptMaybeInstr.No)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (if (= (opt-gvn-instr-dst instr) var)
        (OptMaybeInstr.Some instr)
        (opt-load-gvn-find-def-instrs instrs (+ index 1) var)))))

(define (opt-load-gvn-find-def [blocks : CompilerIrBlockList] [var : i64]) : OptMaybeInstr
  (match blocks
    [(CompilerIrBlockList.Nil) (OptMaybeInstr.No)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (opt-load-gvn-find-def-instrs instrs 0 var)
            [(OptMaybeInstr.Some instr) (OptMaybeInstr.Some instr)]
            [(OptMaybeInstr.No) (opt-load-gvn-find-def (box-get rest) var)])])]
    [(CompilerIrBlockList.Array seq)
      (opt-load-gvn-find-def (compiler-ir-block-seq-to-list seq) var)]))

;; Is `var` provably an element (data-buffer) address? A gep of an element
;; base stays in the buffer; a load of a header descriptor's first word is the
;; data pointer (the element root); phis and movs chase through. Depth-capped
;; against non-SSA cycles.
(define (opt-load-gvn-element-base?
  [hs : OptLoadHeaderSet]
  [blocks : CompilerIrBlockList]
  [var : i64]
  [depth : i64]) : bool
  (if (>= depth 8)
    false
    (match (opt-load-gvn-find-def blocks var)
      [(OptMaybeInstr.Some instr)
        (match instr
          [(CompilerIrInstr.Gep _ base _ _)
            (match base
              [(CompilerIrValue.Var bvar)
                (opt-load-gvn-element-base? hs blocks bvar (+ depth 1))]
              [_ false])]
          [(CompilerIrInstr.Mov _ src _)
            (match src
              [(CompilerIrValue.Var svar)
                (opt-load-gvn-element-base? hs blocks svar (+ depth 1))]
              [_ false])]
          [(CompilerIrInstr.Load _ src _)
            (match src
              [(CompilerIrValue.Var pvar)
                (if (opt-load-header-var? hs pvar)
                  true
                  (match (opt-load-gvn-find-def blocks pvar)
                    [(OptMaybeInstr.Some addr-def)
                      (match addr-def
                        [(CompilerIrInstr.Gep _ gbase goff _)
                          (and
                            (match gbase
                              [(CompilerIrValue.Var dvar)
                                (opt-load-header-var? hs dvar)]
                              [_ false])
                            (match goff
                              [(CompilerIrValue.I64 0) true]
                              [_ false]))]
                        [_ false])]
                    [(OptMaybeInstr.No) false]))]
              [_ false])]
          [(CompilerIrInstr.Phi _ inputs _)
            (opt-load-gvn-element-base-phi? hs blocks inputs (+ depth 1))]
          [_ false])]
      [(OptMaybeInstr.No) false])))

(define (opt-load-gvn-element-base-phi?
  [hs : OptLoadHeaderSet]
  [blocks : CompilerIrBlockList]
  [inputs : CompilerIrPhiInputList]
  [depth : i64]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) true]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (match value
        [(CompilerIrValue.Var v)
          (if (opt-load-gvn-element-base? hs blocks v depth)
            (opt-load-gvn-element-base-phi? hs blocks (box-get rest) depth)
            false)]
        [_ false])]
    ;; force-cons normalizes the array form away.
    [(CompilerIrPhiInputList.Array _) true]))

;; Scan one instruction for loop-carry safety: calls and clear-alls are out,
;; stores must be element-based.
(define (opt-load-gvn-loop-safe-instr?
  [hs : OptLoadHeaderSet]
  [blocks : CompilerIrBlockList]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.StorePtr ptr _ _)
      (match ptr
        [(CompilerIrValue.Var pvar)
          (opt-load-gvn-element-base? hs blocks pvar 0)]
        [_ false])]
    [(CompilerIrInstr.Store _ _ _) false]
    [(CompilerIrInstr.VectorStore _) false]
    [(CompilerIrInstr.PredicatedStore _) false]
    [(CompilerIrInstr.CopyBytes _ _ _) false]
    [_ (not (opt-alias-instr-clears-all? instr))]))

;; Scan the loop body's blocks.
(define (opt-load-gvn-loop-safe-blocks?
  [hs : OptLoadHeaderSet]
  [all-blocks : CompilerIrBlockList]
  [body : CompilerIrBlockList]) : bool
  (match body
    [(CompilerIrBlockList.Nil) true]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-load-gvn-loop-safe-instr-seq? hs all-blocks instrs 0)
            (opt-load-gvn-loop-safe-blocks? hs all-blocks (box-get rest))
            false)])]
    [(CompilerIrBlockList.Array seq)
      (opt-load-gvn-loop-safe-blocks?
        hs
        all-blocks
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-load-gvn-loop-safe-instr-seq?
  [hs : OptLoadHeaderSet]
  [all-blocks : CompilerIrBlockList]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (if (opt-load-gvn-loop-safe-instr?
      hs
      all-blocks
      (compiler-ir-instr-seq-ref instrs index))
      (opt-load-gvn-loop-safe-instr-seq? hs all-blocks instrs (+ index 1))
      false)))

(define (opt-load-gvn-loop-safe-contains? [safe : OptLabelSet] [label : i64]) : bool
  (opt-label-contains safe label))

(define (opt-load-gvn-loop-safe-collect
  [hs : OptLoadHeaderSet]
  [blocks : CompilerIrBlockList]
  [loops : OptNaturalLoopList]) : OptLabelSet
  (match loops
    [(OptNaturalLoopList.Nil) (OptLabelSet.Nil)]
    [(OptNaturalLoopList.Cons loop rest)
      (let
        [tail : OptLabelSet
          (opt-load-gvn-loop-safe-collect hs blocks (box-get rest))]
        (if (opt-load-gvn-loop-safe-blocks?
          hs
          blocks
          (opt-natural-loop-body-blocks loop))
          (opt-label-cons (opt-natural-loop-header loop) tail)
          tail))]))

(define (opt-load-gvn-entry-from-preds
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [exit-states : (Array OptMaybeLoadCseState)]
  [processed : (Array bool)]
  [sources : opt_i64_i64_map.Map]
  [loop-safe : OptLabelSet]
  [label : i64]
  [empty-state : OptLoadCseState]
  [edge : i64]
  [end : i64]
  [has-state : bool]
  [saw-unprocessed : bool]
  [acc : OptLoadCseState]) : OptLoadCseState
  (if (>= edge end)
    (if saw-unprocessed
      ;; A back edge arrived unprocessed: memory contents along it are unknown,
      ;; so the table and alias facts come from empty-state, but stable kinds
      ;; are value properties the back edge cannot change -- keep them. A loop
      ;; proven to write only element memory also keeps its descriptor-field
      ;; entries (header-typed, stable base): those loads live outside every
      ;; data buffer, so the loop's stores cannot reach them.
      (match acc
        [(OptLoadCseState.State _ acc-table acc-kinds _ acc-epoch)
          (match empty-state
            [(OptLoadCseState.State empty-facts empty-table _ empty-cap _)
              (OptLoadCseState.State
                empty-facts
                (if (opt-load-gvn-loop-safe-contains? loop-safe label)
                  (opt-load-table-filter-descriptor-stable acc-table sources)
                  empty-table)
                (opt-load-kinds-filter-stable acc-kinds sources)
                empty-cap
                ;; Carried entries keep their creation epochs, so the counter
                ;; must be the accumulated predecessors' value: resetting it to
                ;; zero would let a loop-body allocation claim an epoch that a
                ;; surviving entry already used.
                acc-epoch)])])
      acc)
    (let
      [pred : i64 (array-ref (struct-get (struct-get index preds) edges) edge)]
      (if (not (array-ref (struct-get index reachable) pred))
        (opt-load-gvn-entry-from-preds
          type-segment-bases
          index
          exit-states
          processed
          sources
          loop-safe
          label
          empty-state
          (+ edge 1)
          end
          has-state
          saw-unprocessed
          acc)
        (if (not (array-ref processed pred))
          (opt-load-gvn-entry-from-preds
            type-segment-bases
            index
            exit-states
            processed
            sources
            loop-safe
            label
            empty-state
            (+ edge 1)
            end
            has-state
            true
            acc)
          (match (array-ref exit-states pred)
            [(OptMaybeLoadCseState.Some pred-state)
              (opt-load-gvn-entry-from-preds
                type-segment-bases
                index
                exit-states
                processed
                sources
                loop-safe
                label
                empty-state
                (+ edge 1)
                end
                true
                saw-unprocessed
                (if has-state
                  (opt-load-cse-state-intersect
                    type-segment-bases
                    acc
                    pred-state)
                  (opt-load-cse-state-clone-facts pred-state)))]
            [(OptMaybeLoadCseState.No)
              (opt-load-gvn-entry-from-preds
                type-segment-bases
                index
                exit-states
                processed
                sources
                loop-safe
                label
                empty-state
                (+ edge 1)
                end
                has-state
                true
                acc)]))))))

(define (opt-load-gvn-entry-state
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [exit-states : (Array OptMaybeLoadCseState)]
  [processed : (Array bool)]
  [sources : opt_i64_i64_map.Map]
  [loop-safe : OptLabelSet]
  [empty-state : OptLoadCseState]
  [id : i64]) : OptLoadCseState
  (let
    [index : OptCfgIndex (struct-get context index)]
    [preds : OptCfgCsr (struct-get index preds)]
    [entry-label : i64 (struct-get context entry-label)]
    (match (opt-cfg-index-id index entry-label)
      [(option_i64.Some entry-id)
        (if (= id entry-id)
          empty-state
          (opt-load-gvn-entry-from-preds
            type-segment-bases
            index
            exit-states
            processed
            sources
            loop-safe
            (opt-cfg-index-label index id)
            empty-state
            (array-ref (struct-get preds offsets) id)
            (array-ref (struct-get preds offsets) (+ id 1))
            false
            false
            empty-state))]
      [(option_i64.None) empty-state])))

;; Same shape as the const-divisor rewrite: one instruction out per instruction
;; in, so the CSE state threads through an indexed walk that fills a sized target
;; sequence instead of consing a reversed list and reversing it back.
(define (opt-load-gvn-instr-seq
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [instrs : CompilerIrInstrSeq]) : OptLoadGvnBlockRewrite
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [slots : (Array CompilerIrInstr) (array.make-array CompilerIrInstr count)]
    [index : i64 0]
    [current : OptLoadCseState state]
    (begin
      (while (< index count)
        (begin
          (set!
            current
            (match (opt-load-cse-dispatch
              type-segment-bases
              hs
              true
              sources
              call-memory
              current
              (compiler-ir-instr-seq-ref instrs index))
              [(OptLoadCseResult.Result next-state new-instr)
                (begin
                  (array-set! slots index new-instr)
                  next-state)]))
          (set! index (+ index 1))))
      (OptLoadGvnBlockRewrite.Rewrite current (CompilerIrInstrSeq slots count)))))

(define (opt-load-gvn-rewrite-block
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [entry-state : OptLoadCseState]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [block : CompilerIrBlock]) : OptLoadGvnBlockRewrite
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (opt-load-gvn-instr-seq
        type-segment-bases
        hs
        entry-state
        sources
        call-memory
        instrs)]))

(define (opt-load-gvn-process-id
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [hs : OptLoadHeaderSet]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [loop-safe : OptLabelSet]
  [exit-states : (Array OptMaybeLoadCseState)]
  [processed : (Array bool)]
  [out : (Array OptGvnBlockResult)]
  [empty-state : OptLoadCseState]
  [id : i64]) : unit
  (let
    [index : OptCfgIndex (struct-get context index)]
    [entry-state : OptLoadCseState
      (opt-load-gvn-entry-state
        type-segment-bases
        context
        exit-states
        processed
        sources
        loop-safe
        empty-state
        id)]
    (match (opt-cfg-index-block index id)
      [(OptMaybeBlock.No) unit]
      [(OptMaybeBlock.Some block)
        (match block
          [(CompilerIrBlock.Block block-label _)
            (match (opt-load-gvn-rewrite-block
              type-segment-bases
              hs
              entry-state
              sources
              call-memory
              block)
              [(OptLoadGvnBlockRewrite.Rewrite exit-state instrs)
                (begin
                  (array-set!
                    out
                    id
                    (OptGvnBlockResult.SomeBlock
                      (CompilerIrBlock.Block block-label instrs)))
                  (array-set!
                    exit-states
                    id
                    (OptMaybeLoadCseState.Some exit-state))
                  (array-set! processed id true))])])])))

(define (opt-load-gvn-process-rpo
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [hs : OptLoadHeaderSet]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [loop-safe : OptLabelSet]
  [exit-states : (Array OptMaybeLoadCseState)]
  [processed : (Array bool)]
  [out : (Array OptGvnBlockResult)]
  [empty-state : OptLoadCseState]
  [slot : i64]) : unit
  (let
    [index : OptCfgIndex (struct-get context index)]
    [reach-count : i64 (struct-get index reach-count)]
    (if (>= slot reach-count)
      unit
      (let
        [id : i64 (opt-cfg-index-rpo-id index slot)]
        (begin
          (opt-load-gvn-process-id
            type-segment-bases
            context
            hs
            sources
            call-memory
            loop-safe
            exit-states
            processed
            out
            empty-state
            id)
          (opt-load-gvn-process-rpo
            type-segment-bases
            context
            hs
            sources
            call-memory
            loop-safe
            exit-states
            processed
            out
            empty-state
            (+ slot 1)))))))

;; Cheap any-Load pre-scan for the cross-block load GVN (allocation-free,
;; exits at the first load). The pass can only rewrite a Load, so a function
;; containing no loads is returned unchanged and avoids the whole-function
;; empty state plus the three per-block arrays. One load is enough to run the
;; pass: StorePtr can seed the value table for a later load through
;; store-to-load forwarding.
(define (opt-load-gvn-instr-load? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Load _ _ _) true]
    [_ false]))

(define (opt-load-gvn-instr-seq-has-load?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-load-gvn-instr-load? (compiler-ir-instr-seq-ref instrs index))
      true
      (opt-load-gvn-instr-seq-has-load? instrs (+ index 1)))))

(define (opt-load-gvn-block-seq-has-load?
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-block-seq-count blocks))
    false
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block _ instrs)
        (if (opt-load-gvn-instr-seq-has-load? instrs 0)
          true
          (opt-load-gvn-block-seq-has-load? blocks (+ index 1)))])))

(define (opt-load-gvn-blocks-have-load? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (opt-load-gvn-instr-seq-has-load? instrs 0)
            true
            (opt-load-gvn-blocks-have-load? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq) (opt-load-gvn-block-seq-has-load? seq 0)]))

(define (opt-load-gvn-blocks-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [sources : opt_i64_i64_map.Map]
  [hs : OptLoadHeaderSet]
  [params : CompilerIrParamList]
  [call-memory : opt_i64_i64_map.Map]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (if (not (opt-load-gvn-blocks-have-load? blocks))
    ;; No loads: no rewrite can fire, so the pass output equals the input; skip
    ;; the empty state and the per-block arrays.
    blocks
    (let
      [index : OptCfgIndex (struct-get context index)]
      [count : i64 (opt-cfg-index-block-count index)]
      [exit-states : (Array OptMaybeLoadCseState)
        (array.make-array OptMaybeLoadCseState count)]
      [processed : (Array bool) (array.make-array bool count)]
      [out : (Array OptGvnBlockResult)
        (array.make-array OptGvnBlockResult count)]
      [loop-safe : OptLabelSet
        (opt-load-gvn-loop-safe-collect
          hs
          blocks
          (opt-cfg-natural-loops-with-context blocks context))]
      [empty-state : OptLoadCseState
        (opt-load-cse-state-with-caps-and-facts
          (opt-load-cse-table-cap-for-size
            (compiler-ir-block-list-instruction-count blocks))
          (opt-load-cse-kinds-cap-for-size
            (compiler-ir-block-list-instruction-count blocks))
          (opt-alias-seed-params type-segment-bases params))]
      (begin
        (opt-cfg-index-refresh-blocks! index blocks)
        (opt-load-state-array-fill-empty! exit-states count)
        (opt-gvn-block-results-fill-empty! out 0)
        (opt-load-gvn-process-rpo
          type-segment-bases
          context
          hs
          sources
          call-memory
          loop-safe
          exit-states
          processed
          out
          empty-state
          0)
        (opt-gvn-materialize-blocks (struct-get context doms) out blocks)))))