;; compiler_optimize.tl - Selfhost optimizer: pass framework + scalar constant
;; folding (#543, first slice of #519).
;;
;; Runs between lowering (`lower-compiler-program`) and backend emission
;; (`compiler-backend-emit-program-for-target`). It performs conservative, scalar-only
;; local rewrites: constant folding, algebraic strength reduction, CSE, copy
;; propagation, conservative global value numbering/cross-block copy
;; propagation, conservative loop-invariant scalar hoisting, redundant
;; bounds-check elimination, conservative CFG simplification, and DCE.
;;
;; Safety:
;; - Integer `+`, `-`, `*`, bitwise ops, shifts, and `neg` are folded through
;;   helpers that normalize the result back to the instruction type. This keeps
;;   narrow signed/unsigned widths and `char` byte semantics explicit.
;; - Division, modulo, and shifts fold only when the static operands avoid the
;;   same runtime traps emitted by lowering: zero divisors, signed MIN / -1, and
;;   out-of-range shift counts remain in the IR.
;; - Tracking is block-local (reset per block), so no value is folded across a
;;   control-flow edge.
;;
;; Out of scope: broad aggregate/String/array IR optimization.
(import "../stdlib/io.tl")
(import "../stdlib/arena.tl")
(import "compiler_ir_types.tl")
(import "compiler_float.tl")
(import "../stdlib/hash.tl")
(import "../stdlib/hashmap.tl")
(import "../stdlib/string.tl")
(cfg compile-profile (import "../stdlib/str_cat.tl"))

(defenum ResultCompilerOptimizeLevel
  (OkCompilerOptimizeLevel i64)
  (ErrCompilerOptimizeLevel))

(defenum CompilerOptimizedProgram
  (CompilerOptimizedProgram CompilerIrProgram CompilerSourceSpans))

(defenum OptAggregatePointer
  (OptAggregatePointer i64 i64))

(defstruct OptAggregatePointerList
  (slots (Array OptAggregatePointer))
  (len i64))

(defenum OptAggregateAccess
  (OptAggregateStore i64 AstType)
  (OptAggregateLoad i64 i64 AstType))

(defstruct OptAggregateAccessList
  (slots (Array OptAggregateAccess))
  (len i64))

(defenum OptAggregateAllocCandidate
  (OptAggregateAllocCandidate
    i64
    AstType
    i64
    OptAggregatePointerList
    OptAggregateAccessList))

(defstruct OptAggregateAllocCandidateList
  (slots (Array OptAggregateAllocCandidate))
  (len i64))

(defenum OptMaybeAggregateAlloc
  (OptNoAggregateAlloc)
  (OptSomeAggregateAlloc i64 AstType i64))

(defenum OptAggregateScanResult
  (OptAggregateScanOk OptAggregatePointerList OptAggregateAccessList)
  (OptAggregateScanReject))

;; Aggregate field-load SROA (#1562) supporting types.
(defenum OptAggregateLocation
  (OptNoAggregateLocation)
  (OptSomeAggregateLocation i64 i64))

(defenum OptAggregateStoredValue
  (OptNoAggregateStoredValue)
  (OptSomeAggregateStoredValue CompilerIrValue AstType))

(defenum OptAggregateFieldFacts
  (OptAggregateFieldNil)
  (OptAggregateFieldCons
    i64
    i64
    CompilerIrValue
    AstType
    (Box OptAggregateFieldFacts)))

(defenum OptAggregateSroaResult
  (OptAggregateSroaResult OptAggregateFieldFacts CompilerIrInstr))

(defenum OptAggregatePromoteSlot
  (OptAggregatePromoteSlot i64 i64))

(defstruct OptAggregatePromoteSlotList
  (slots (Array OptAggregatePromoteSlot))
  (len i64))

(defenum OptAggregatePromoteBuild
  (OptAggregatePromoteBuild OptAggregatePromoteSlotList i64))

(define opt-aggregate-list-initial-capacity : i64
  4)
(define compiler-optimize-level-default : i64
  1)
(cfg
  compile-profile
  (define compiler-opt-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-opt-profile-start-total : i64
    0))
(cfg
  compile-profile
  (define compiler-opt-profile-start-live : i64
    0))
(cfg
  compile-profile
  (define compiler-opt-profile-detail-start-ms : i64
    0))

(cfg
  compile-profile
  (define (compiler-opt-profile-field [value : i64]) : String
    (string-append "|" (int->string value))))

(cfg
  compile-profile
  (define (compiler-opt-profile-start) : unit
    (begin
      (set! compiler-opt-profile-start-ms (profile-now-ms))
      (set! compiler-opt-profile-start-total (profile-alloc-total))
      (set! compiler-opt-profile-start-live (profile-alloc-live))
      (profile-alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-opt-profile-finish [phase : String]) : unit
    (let
      [end-ms : i64 (profile-now-ms)]
      [end-total : i64 (profile-alloc-total)]
      [end-live : i64 (profile-alloc-live)]
      [peak-delta : i64
        (- (profile-alloc-peak) compiler-opt-profile-start-live)]
      (print-error
        (string-append
          "compile-profile|optimize."
          (string-append
            phase
            (string-append
              (compiler-opt-profile-field
                (- end-ms compiler-opt-profile-start-ms))
              (string-append
                (compiler-opt-profile-field
                  (- end-total compiler-opt-profile-start-total))
                (string-append
                  (compiler-opt-profile-field
                    (- end-live compiler-opt-profile-start-live))
                  (string-append (compiler-opt-profile-field peak-delta) "\n"))))))))))

(cfg
  compile-profile
  (define (compiler-opt-profile-detail-start) : unit
    (set! compiler-opt-profile-detail-start-ms (profile-now-ms))))

(cfg
  compile-profile
  (define (compiler-opt-profile-detail-finish [phase : String] [name : String]) : unit
    (let
      [elapsed : i64 (- (profile-now-ms) compiler-opt-profile-detail-start-ms)]
      (if (>= elapsed 1)
        (print-error
          (string-append
            "compile-profile-detail|optimize."
            (string-append
              phase
              (string-append
                "|"
                (string-append
                  (int->string elapsed)
                  (string-append "|" (string-append name "\n")))))))
        unit))))

(cfg
  compile-profile
  (define (compiler-opt-profile-pass-finish
    [pass : String]
    [name : String]
    [start-ms : i64]) : unit
    (let
      [elapsed : i64 (- (profile-now-ms) start-ms)]
      (if (>= elapsed 1)
        (print-error
          (string-append
            "compile-profile-detail|optimize.pass."
            (string-append
              pass
              (string-append
                "|"
                (string-append
                  (int->string elapsed)
                  (string-append "|" (string-append name "\n")))))))
        unit))))

(cfg
  compile-profile
  (define (compiler-opt-profile-function-name [func : CompilerIrFunction]) : String
    (match func
      [(IrFunction name _ _ _ _) name])))

(define (compiler-optimize-default-level) : i64
  compiler-optimize-level-default)

(define (compiler-optimize-level-valid? [level : i64]) : bool
  (and (>= level 0) (<= level 2)))

(define (compiler-optimize-parse-level [value : String]) : ResultCompilerOptimizeLevel
  (if (= (string-length value) 1)
    (let
      [c : char (string-ref value 0)]
      (if (or (= c '0') (= c '1') (= c '2'))
        (OkCompilerOptimizeLevel (string->int value))
        (ErrCompilerOptimizeLevel)))
    (ErrCompilerOptimizeLevel)))

;; --- block-local constant environment: IR var id -> known typed scalar -------
(defenum OptMaybeI64
  (OptNoI64)
  (OptSomeI64 i64))

(defenum OptMaybeBool
  (OptNoBool)
  (OptSomeBool bool))

(defenum OptKnownConst
  (OptNoConst)
  (OptSomeConst CompilerIrValue AstType))

;; The const env is threaded linearly through a single block's fold/strength
;; passes (each block starts fresh at `OptConstNil`); it is never forked or
;; reused across blocks. So bind/unbind only ever extend the most recent env.
;; We exploit that: the newest entry for a var always shadows older ones, so
;; `bind` and `unbind` just PREPEND (O(1)) instead of rebuilding the whole list
;; to remove the prior entry (the old O(n)-per-instruction copy made folding a
;; single large block O(n^2) in both time and allocation -- e.g. a function that
;; is one giant `str-cat` lowers to a long `string-append` call chain, and each
;; call's `opt-invalidate-def` rebuilt the entire env). `OptConstShadow` records
;; "this var is no longer a known constant" so lookup stops at it.
(defenum OptConstEnv
  (OptConstNil)
  (OptConstCons i64 CompilerIrValue AstType (Box OptConstEnv))
  (OptConstShadow i64 (Box OptConstEnv)))

(define (opt-const-unbind [env : OptConstEnv] [var : i64]) : OptConstEnv
  (OptConstShadow var (box env)))

(define (opt-const-bind
  [env : OptConstEnv]
  [var : i64]
  [value : CompilerIrValue]
  [ty : AstType]) : OptConstEnv
  (OptConstCons var value ty (box env)))

(define (opt-const-lookup [env : OptConstEnv] [var : i64]) : OptKnownConst
  (match env
    [(OptConstNil) (OptNoConst)]
    [(OptConstCons id value ty rest)
      (if (= id var)
        (OptSomeConst value ty)
        (opt-const-lookup (box-get rest) var))]
    [(OptConstShadow id rest)
      (if (= id var)
        (OptNoConst)
        (opt-const-lookup (box-get rest) var))]))

(define (opt-integer-type? [ty : AstType]) : bool
  (match ty
    [(AstTyI64) true]
    [(AstTyI32) true]
    [(AstTyI16) true]
    [(AstTyI8) true]
    [(AstTyU64) true]
    [(AstTyU32) true]
    [(AstTyU16) true]
    [(AstTyU8) true]
    [_ false]))

(define (opt-signed-integer-type? [ty : AstType]) : bool
  (match ty
    [(AstTyI64) true]
    [(AstTyI32) true]
    [(AstTyI16) true]
    [(AstTyI8) true]
    [_ false]))

(define (opt-unsigned-integer-type? [ty : AstType]) : bool
  (match ty
    [(AstTyU64) true]
    [(AstTyU32) true]
    [(AstTyU16) true]
    [(AstTyU8) true]
    [_ false]))

(define (opt-int-or-char-type? [ty : AstType]) : bool
  (if (opt-integer-type? ty)
    true
    (match ty
      [(AstTyChar) true]
      [_ false])))

(define (opt-bool-type? [ty : AstType]) : bool
  (match ty
    [(AstTyBool) true]
    [_ false]))

(define (opt-float-type? [ty : AstType]) : bool
  (match ty
    [(AstTyF64) true]
    [(AstTyF32) true]
    [_ false]))

(define (opt-int-width [ty : AstType]) : i64
  (match ty
    [(AstTyI64) 64]
    [(AstTyU64) 64]
    [(AstTyI32) 32]
    [(AstTyU32) 32]
    [(AstTyI16) 16]
    [(AstTyU16) 16]
    [(AstTyI8) 8]
    [(AstTyU8) 8]
    [(AstTyChar) 8]
    [_ 0]))

(define (opt-int-sign-class [ty : AstType]) : i64
  (if (opt-signed-integer-type? ty)
    1
    (if (or
      (opt-unsigned-integer-type? ty)
      (match ty
        [(AstTyChar) true]
        [_ false]))
      2
      0)))

(define (opt-int-cast-as-mov? [from-ty : AstType] [to-ty : AstType]) : bool
  (if (and (opt-int-or-char-type? from-ty) (opt-int-or-char-type? to-ty))
    (let
      [from-width : i64 (opt-int-width from-ty)]
      [to-width : i64 (opt-int-width to-ty)]
      ;; Keep same-width signedness changes as casts; they preserve operator
      ;; type context for cases like `(shr (cast x : u64) ...)`.
      (or
        (< to-width from-width)
        (and
          (= to-width from-width)
          (= (opt-int-sign-class from-ty) (opt-int-sign-class to-ty)))))
    false))

(define (opt-value-to-i64 [value : CompilerIrValue]) : OptMaybeI64
  (match value
    [(IrValueI64 n) (OptSomeI64 n)]
    [(IrValueChar c) (OptSomeI64 (cast c : i64))]
    [_ (OptNoI64)]))

(define (opt-value-to-bool [value : CompilerIrValue]) : OptMaybeBool
  (match value
    [(IrValueBool b) (OptSomeBool b)]
    [_ (OptNoBool)]))

(define (opt-float-round-for-type [value : f64] [ty : AstType]) : f64
  (match ty
    [(AstTyF32) (compiler-float-round-f32-as-f64 value)]
    [_ value]))

(define (opt-value-to-f64 [value : CompilerIrValue] [ty : AstType]) : CompilerFloatMaybeF64
  (match value
    [(IrValueF64 bits)
      (let
        [decoded : f64
          (match ty
            [(AstTyF32) (compiler-float-f32-bits-to-f64 bits)]
            [_ (compiler-float-f64-from-bits bits)])]
        (if (compiler-float-f64-finite? decoded)
          (CompilerFloatSomeF64 decoded)
          (CompilerFloatNoF64)))]
    [_ (CompilerFloatNoF64)]))

(define (opt-f64-to-ir-value [value : f64] [ty : AstType]) : CompilerIrMaybeValue
  (let
    [rounded : f64 (opt-float-round-for-type value ty)]
    (if (compiler-float-f64-finite? rounded)
      (IrSomeValue
        (IrValueF64
          (match ty
            [(AstTyF32) (cast (compiler-float-f32-bits-from-f64 rounded) : u64)]
            [_ (compiler-float-f64-bits rounded)])))
      (IrNoValue))))

(define (opt-normalize-int-to-i64 [value : i64] [ty : AstType]) : i64
  (match ty
    [(AstTyI64) (cast (cast value : i64) : i64)]
    [(AstTyI32) (cast (cast value : i32) : i64)]
    [(AstTyI16) (cast (cast value : i16) : i64)]
    [(AstTyI8) (cast (cast value : i8) : i64)]
    [(AstTyU64) (cast (cast value : u64) : i64)]
    [(AstTyU32) (cast (cast value : u32) : i64)]
    [(AstTyU16) (cast (cast value : u16) : i64)]
    [(AstTyU8) (cast (cast value : u8) : i64)]
    [(AstTyChar) (cast (cast value : char) : i64)]
    [_ value]))

(define (opt-normalize-const [value : CompilerIrValue] [ty : AstType]) : OptKnownConst
  (if (opt-integer-type? ty)
    (match (opt-value-to-i64 value)
      [(OptSomeI64 n)
        (OptSomeConst (IrValueI64 (opt-normalize-int-to-i64 n ty)) ty)]
      [(OptNoI64) (OptNoConst)])
    (match ty
      [(AstTyChar)
        (match (opt-value-to-i64 value)
          [(OptSomeI64 n)
            (OptSomeConst (IrValueChar (cast n : char)) (AstTyChar))]
          [(OptNoI64) (OptNoConst)])]
      [(AstTyBool)
        (match (opt-value-to-bool value)
          [(OptSomeBool b) (OptSomeConst (IrValueBool b) (AstTyBool))]
          [(OptNoBool) (OptNoConst)])]
      [(AstTyF64)
        (match value
          [(IrValueF64 _) (OptSomeConst value (AstTyF64))]
          [_ (OptNoConst)])]
      [(AstTyF32)
        (match value
          [(IrValueF64 _) (OptSomeConst value (AstTyF32))]
          [_ (OptNoConst)])]
      [_ (OptNoConst)])))

(define (opt-const-value? [value : CompilerIrValue] [ty : AstType]) : bool
  (match (opt-normalize-const value ty)
    [(OptSomeConst _ _) true]
    [(OptNoConst) false]))

(define (opt-default-immediate-type
  [value : CompilerIrValue]
  [fallback : AstType]) : AstType
  (match value
    [(IrValueI64 _)
      (if (opt-int-or-char-type? fallback)
        fallback
        (AstTyI64))]
    [(IrValueChar _) (AstTyChar)]
    [(IrValueBool _) (AstTyBool)]
    [(IrValueF64 _)
      (if (opt-float-type? fallback)
        fallback
        (AstTyF64))]
    [(IrValueUnit) (AstTyUnit)]
    [_ fallback]))

(define (opt-resolve-known
  [env : OptConstEnv]
  [value : CompilerIrValue]
  [fallback-ty : AstType]) : OptKnownConst
  (match value
    [(IrValueVar id)
      (match (opt-const-lookup env id)
        [(OptSomeConst v ty) (OptSomeConst v ty)]
        [(OptNoConst) (OptNoConst)])]
    [_
      (opt-normalize-const value (opt-default-immediate-type value fallback-ty))]))

(define (opt-resolve-value [env : OptConstEnv] [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(IrValueVar id)
      (match (opt-const-lookup env id)
        [(OptSomeConst v _) v]
        [(OptNoConst) value])]
    [_ value]))

;; --- folding rules -----------------------------------------------------------
(define (opt-normalize-scalar-to-i64 [value : CompilerIrValue] [ty : AstType]) : OptMaybeI64
  (if (opt-int-or-char-type? ty)
    (match (opt-value-to-i64 value)
      [(OptSomeI64 n) (OptSomeI64 (opt-normalize-int-to-i64 n ty))]
      [(OptNoI64) (OptNoI64)])
    (OptNoI64)))

(define (opt-binop-operand-type
  [op : CompilerIrBinOp]
  [lhs-ty : AstType]
  [rhs-ty : AstType]
  [result-ty : AstType]) : AstType
  (match op
    [(IrBinEq)
      (if (opt-type-eq lhs-ty (AstTyI64))
        rhs-ty
        (if (and
          (opt-type-eq lhs-ty (AstTyF64))
          (opt-type-eq rhs-ty (AstTyF32)))
          rhs-ty
          lhs-ty))]
    [(IrBinNe)
      (if (opt-type-eq lhs-ty (AstTyI64))
        rhs-ty
        (if (and
          (opt-type-eq lhs-ty (AstTyF64))
          (opt-type-eq rhs-ty (AstTyF32)))
          rhs-ty
          lhs-ty))]
    [(IrBinLt)
      (if (opt-type-eq lhs-ty (AstTyI64))
        rhs-ty
        (if (and
          (opt-type-eq lhs-ty (AstTyF64))
          (opt-type-eq rhs-ty (AstTyF32)))
          rhs-ty
          lhs-ty))]
    [(IrBinLe)
      (if (opt-type-eq lhs-ty (AstTyI64))
        rhs-ty
        (if (and
          (opt-type-eq lhs-ty (AstTyF64))
          (opt-type-eq rhs-ty (AstTyF32)))
          rhs-ty
          lhs-ty))]
    [(IrBinGt)
      (if (opt-type-eq lhs-ty (AstTyI64))
        rhs-ty
        (if (and
          (opt-type-eq lhs-ty (AstTyF64))
          (opt-type-eq rhs-ty (AstTyF32)))
          rhs-ty
          lhs-ty))]
    [(IrBinGe)
      (if (opt-type-eq lhs-ty (AstTyI64))
        rhs-ty
        (if (and
          (opt-type-eq lhs-ty (AstTyF64))
          (opt-type-eq rhs-ty (AstTyF32)))
          rhs-ty
          lhs-ty))]
    [(IrBinBitAnd) lhs-ty]
    [(IrBinBitOr) lhs-ty]
    [(IrBinBitXor) lhs-ty]
    [(IrBinShl) lhs-ty]
    [(IrBinShr) lhs-ty]
    [_ result-ty]))

(define (opt-signed-min [ty : AstType]) : i64
  (match ty
    [(AstTyI64) (- (- 0 9223372036854775807) 1)]
    [(AstTyI32) (- 0 2147483648)]
    [(AstTyI16) (- 0 32768)]
    [(AstTyI8) (- 0 128)]
    [_ 0]))

(define (opt-divmod-valid? [a : i64] [b : i64] [ty : AstType]) : bool
  (if (= b 0)
    false
    (if (opt-signed-integer-type? ty)
      (not (and (= a (opt-signed-min ty)) (= b (- 0 1))))
      true)))

(define (opt-fold-div-value [a : i64] [b : i64] [ty : AstType]) : i64
  (match ty
    [(AstTyI64) (cast (/ (cast a : i64) (cast b : i64)) : i64)]
    [(AstTyI32) (cast (/ (cast a : i32) (cast b : i32)) : i64)]
    [(AstTyI16) (cast (/ (cast a : i16) (cast b : i16)) : i64)]
    [(AstTyI8) (cast (/ (cast a : i8) (cast b : i8)) : i64)]
    [(AstTyU64) (cast (/ (cast a : u64) (cast b : u64)) : i64)]
    [(AstTyU32) (cast (/ (cast a : u32) (cast b : u32)) : i64)]
    [(AstTyU16) (cast (/ (cast a : u16) (cast b : u16)) : i64)]
    [(AstTyU8) (cast (/ (cast a : u8) (cast b : u8)) : i64)]
    [_ 0]))

(define (opt-fold-mod-value [a : i64] [b : i64] [ty : AstType]) : i64
  (match ty
    [(AstTyI64) (cast (% (cast a : i64) (cast b : i64)) : i64)]
    [(AstTyI32) (cast (% (cast a : i32) (cast b : i32)) : i64)]
    [(AstTyI16) (cast (% (cast a : i16) (cast b : i16)) : i64)]
    [(AstTyI8) (cast (% (cast a : i8) (cast b : i8)) : i64)]
    [(AstTyU64) (cast (% (cast a : u64) (cast b : u64)) : i64)]
    [(AstTyU32) (cast (% (cast a : u32) (cast b : u32)) : i64)]
    [(AstTyU16) (cast (% (cast a : u16) (cast b : u16)) : i64)]
    [(AstTyU8) (cast (% (cast a : u8) (cast b : u8)) : i64)]
    [_ 0]))

(define (opt-unsigned-lt? [a : i64] [b : i64] [ty : AstType]) : bool
  (match ty
    [(AstTyU64) (< (cast a : u64) (cast b : u64))]
    [_ (< a b)]))

(define (opt-typed-lt? [a : i64] [b : i64] [ty : AstType]) : bool
  (if (opt-unsigned-integer-type? ty)
    (opt-unsigned-lt? a b ty)
    (< a b)))

(define (opt-typed-le? [a : i64] [b : i64] [ty : AstType]) : bool
  (or (= a b) (opt-typed-lt? a b ty)))

(define (opt-typed-gt? [a : i64] [b : i64] [ty : AstType]) : bool
  (opt-typed-lt? b a ty))

(define (opt-typed-ge? [a : i64] [b : i64] [ty : AstType]) : bool
  (or (= a b) (opt-typed-lt? b a ty)))

(define (opt-fold-compare
  [op : CompilerIrBinOp]
  [a : i64]
  [b : i64]
  [ty : AstType]) : CompilerIrMaybeValue
  (match op
    [(IrBinEq) (IrSomeValue (IrValueBool (= a b)))]
    [(IrBinNe) (IrSomeValue (IrValueBool (!= a b)))]
    [(IrBinLt) (IrSomeValue (IrValueBool (opt-typed-lt? a b ty)))]
    [(IrBinLe) (IrSomeValue (IrValueBool (opt-typed-le? a b ty)))]
    [(IrBinGt) (IrSomeValue (IrValueBool (opt-typed-gt? a b ty)))]
    [(IrBinGe) (IrSomeValue (IrValueBool (opt-typed-ge? a b ty)))]
    [_ (IrNoValue)]))

(define (opt-shift-count-valid?
  [count : i64]
  [count-ty : AstType]
  [width : i64]) : bool
  (if (not (opt-integer-type? count-ty))
    false
    (if (opt-signed-integer-type? count-ty)
      (and (>= count 0) (< count width))
      (match count-ty
        [(AstTyU64) (< (cast count : u64) (cast width : u64))]
        [_ (< count width)]))))

(define (opt-fold-shl-value [a : i64] [count : i64] [ty : AstType]) : i64
  (match ty
    [(AstTyI64) (cast (shl (cast a : i64) (cast count : i64)) : i64)]
    [(AstTyI32) (cast (shl (cast a : i32) (cast count : i32)) : i64)]
    [(AstTyI16) (cast (shl (cast a : i16) (cast count : i16)) : i64)]
    [(AstTyI8) (cast (shl (cast a : i8) (cast count : i8)) : i64)]
    [(AstTyU64) (cast (shl (cast a : u64) (cast count : u64)) : i64)]
    [(AstTyU32) (cast (shl (cast a : u32) (cast count : u32)) : i64)]
    [(AstTyU16) (cast (shl (cast a : u16) (cast count : u16)) : i64)]
    [(AstTyU8) (cast (shl (cast a : u8) (cast count : u8)) : i64)]
    [_ 0]))

(define (opt-fold-shr-value [a : i64] [count : i64] [ty : AstType]) : i64
  (match ty
    [(AstTyI64) (cast (shr (cast a : i64) (cast count : i64)) : i64)]
    [(AstTyI32) (cast (shr (cast a : i32) (cast count : i32)) : i64)]
    [(AstTyI16) (cast (shr (cast a : i16) (cast count : i16)) : i64)]
    [(AstTyI8) (cast (shr (cast a : i8) (cast count : i8)) : i64)]
    [(AstTyU64) (cast (shr (cast a : u64) (cast count : u64)) : i64)]
    [(AstTyU32) (cast (shr (cast a : u32) (cast count : u32)) : i64)]
    [(AstTyU16) (cast (shr (cast a : u16) (cast count : u16)) : i64)]
    [(AstTyU8) (cast (shr (cast a : u8) (cast count : u8)) : i64)]
    [_ 0]))

(define (opt-fold-shift
  [op : CompilerIrBinOp]
  [a : i64]
  [rhs : CompilerIrValue]
  [rhs-ty : AstType]
  [ty : AstType]) : CompilerIrMaybeValue
  (match (opt-normalize-scalar-to-i64 rhs rhs-ty)
    [(OptSomeI64 count)
      (if (opt-shift-count-valid? count rhs-ty (opt-int-width ty))
        (match op
          [(IrBinShl)
            (IrSomeValue
              (IrValueI64
                (opt-normalize-int-to-i64 (opt-fold-shl-value a count ty) ty)))]
          [(IrBinShr)
            (IrSomeValue
              (IrValueI64
                (opt-normalize-int-to-i64 (opt-fold-shr-value a count ty) ty)))]
          [_ (IrNoValue)])
        (IrNoValue))]
    [(OptNoI64) (IrNoValue)]))

(define (opt-fold-int-char-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [operand-ty : AstType]
  [rhs-ty : AstType]) : CompilerIrMaybeValue
  (match (opt-normalize-scalar-to-i64 lhs operand-ty)
    [(OptSomeI64 a)
      (match op
        [(IrBinShl) (opt-fold-shift op a rhs rhs-ty operand-ty)]
        [(IrBinShr) (opt-fold-shift op a rhs rhs-ty operand-ty)]
        [_
          (match (opt-normalize-scalar-to-i64 rhs operand-ty)
            [(OptSomeI64 b)
              (match op
                [(IrBinAdd)
                  (if (opt-integer-type? operand-ty)
                    (IrSomeValue
                      (IrValueI64 (opt-normalize-int-to-i64 (+ a b) operand-ty)))
                    (IrNoValue))]
                [(IrBinSub)
                  (if (opt-integer-type? operand-ty)
                    (IrSomeValue
                      (IrValueI64 (opt-normalize-int-to-i64 (- a b) operand-ty)))
                    (IrNoValue))]
                [(IrBinMul)
                  (if (opt-integer-type? operand-ty)
                    (IrSomeValue
                      (IrValueI64 (opt-normalize-int-to-i64 (* a b) operand-ty)))
                    (IrNoValue))]
                [(IrBinDiv)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (IrSomeValue
                      (IrValueI64 (opt-fold-div-value a b operand-ty)))
                    (IrNoValue))]
                [(IrBinMod)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (IrSomeValue
                      (IrValueI64 (opt-fold-mod-value a b operand-ty)))
                    (IrNoValue))]
                [(IrBinSafeDiv)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (IrSomeValue
                      (IrValueI64 (opt-fold-div-value a b operand-ty)))
                    (IrNoValue))]
                [(IrBinSafeMod)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (IrSomeValue
                      (IrValueI64 (opt-fold-mod-value a b operand-ty)))
                    (IrNoValue))]
                [(IrBinBitAnd)
                  (if (opt-integer-type? operand-ty)
                    (IrSomeValue
                      (IrValueI64
                        (opt-normalize-int-to-i64 (bit-and a b) operand-ty)))
                    (IrNoValue))]
                [(IrBinBitOr)
                  (if (opt-integer-type? operand-ty)
                    (IrSomeValue
                      (IrValueI64
                        (opt-normalize-int-to-i64 (bit-or a b) operand-ty)))
                    (IrNoValue))]
                [(IrBinBitXor)
                  (if (opt-integer-type? operand-ty)
                    (IrSomeValue
                      (IrValueI64
                        (opt-normalize-int-to-i64 (bit-xor a b) operand-ty)))
                    (IrNoValue))]
                [(IrBinEq) (opt-fold-compare op a b operand-ty)]
                [(IrBinNe) (opt-fold-compare op a b operand-ty)]
                [(IrBinLt) (opt-fold-compare op a b operand-ty)]
                [(IrBinLe) (opt-fold-compare op a b operand-ty)]
                [(IrBinGt) (opt-fold-compare op a b operand-ty)]
                [(IrBinGe) (opt-fold-compare op a b operand-ty)]
                [_ (IrNoValue)])]
            [(OptNoI64) (IrNoValue)])])]
    [(OptNoI64) (IrNoValue)]))

(define (opt-fold-bool
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : CompilerIrMaybeValue
  (match (opt-value-to-bool lhs)
    [(OptSomeBool a)
      (match (opt-value-to-bool rhs)
        [(OptSomeBool b)
          (match op
            [(IrBinAnd) (IrSomeValue (IrValueBool (and a b)))]
            [(IrBinOr) (IrSomeValue (IrValueBool (or a b)))]
            [(IrBinEq) (IrSomeValue (IrValueBool (= a b)))]
            [(IrBinNe) (IrSomeValue (IrValueBool (!= a b)))]
            [_ (IrNoValue)])]
        [(OptNoBool) (IrNoValue)])]
    [(OptNoBool) (IrNoValue)]))

(define (opt-fold-float-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [operand-ty : AstType]) : CompilerIrMaybeValue
  (match (opt-value-to-f64 lhs operand-ty)
    [(CompilerFloatSomeF64 a)
      (match (opt-value-to-f64 rhs operand-ty)
        [(CompilerFloatSomeF64 b)
          (match op
            [(IrBinAdd) (opt-f64-to-ir-value (+ a b) operand-ty)]
            [(IrBinSub) (opt-f64-to-ir-value (- a b) operand-ty)]
            [(IrBinMul) (opt-f64-to-ir-value (* a b) operand-ty)]
            [(IrBinDiv)
              (if (= b 0.0)
                (IrNoValue)
                (opt-f64-to-ir-value (/ a b) operand-ty))]
            [(IrBinSafeDiv)
              (if (= b 0.0)
                (IrNoValue)
                (opt-f64-to-ir-value (/ a b) operand-ty))]
            [(IrBinEq) (IrSomeValue (IrValueBool (= a b)))]
            [(IrBinNe) (IrSomeValue (IrValueBool (!= a b)))]
            [(IrBinLt) (IrSomeValue (IrValueBool (< a b)))]
            [(IrBinLe) (IrSomeValue (IrValueBool (<= a b)))]
            [(IrBinGt) (IrSomeValue (IrValueBool (> a b)))]
            [(IrBinGe) (IrSomeValue (IrValueBool (>= a b)))]
            [_ (IrNoValue)])]
        [(CompilerFloatNoF64) (IrNoValue)])]
    [(CompilerFloatNoF64) (IrNoValue)]))

(define (opt-fold-float-cast
  [src : OptKnownConst]
  [from-ty : AstType]
  [to-ty : AstType]) : CompilerIrMaybeValue
  (match src
    [(OptSomeConst value _)
      (match (opt-value-to-f64 value from-ty)
        [(CompilerFloatSomeF64 n) (opt-f64-to-ir-value n to-ty)]
        [(CompilerFloatNoF64) (IrNoValue)])]
    [(OptNoConst) (IrNoValue)]))

(define (opt-finite-cast-input [src : OptKnownConst] [from-ty : AstType]) : CompilerFiniteCastInput
  (match src
    [(OptSomeConst value _)
      (match value
        [(IrValueI64 n) (CompilerFiniteCastInputI64 n)]
        [(IrValueChar c) (CompilerFiniteCastInputChar c)]
        [(IrValueF64 bits)
          (match from-ty
            [(AstTyF32)
              (CompilerFiniteCastInputF32 (compiler-float-f32-bits-to-f64 bits))]
            [_ (CompilerFiniteCastInputF64 (compiler-float-f64-from-bits bits))])]
        [_ (CompilerFiniteCastNoInput)])]
    [(OptNoConst) (CompilerFiniteCastNoInput)]))

(define (opt-finite-cast-result-to-ir [result : CompilerFiniteCastResult]) : CompilerIrMaybeValue
  (match result
    [(CompilerFiniteCastResultI64 n) (IrSomeValue (IrValueI64 n))]
    [(CompilerFiniteCastResultChar c) (IrSomeValue (IrValueChar c))]
    [(CompilerFiniteCastResultF64 n) (opt-f64-to-ir-value n (AstTyF64))]
    [(CompilerFiniteCastResultF32 n) (opt-f64-to-ir-value n (AstTyF32))]
    [(CompilerFiniteCastNoResult) (IrNoValue)]))

(define (opt-fold-cast
  [src : OptKnownConst]
  [from-ty : AstType]
  [to-ty : AstType]) : CompilerIrMaybeValue
  (let
    [input : CompilerFiniteCastInput (opt-finite-cast-input src from-ty)]
    (match input
      [(CompilerFiniteCastNoInput) (IrNoValue)]
      [_
        (opt-finite-cast-result-to-ir
          (compiler-finite-cast-fold input from-ty to-ty))])))

(define (opt-fold-binop
  [op : CompilerIrBinOp]
  [lhs : OptKnownConst]
  [rhs : OptKnownConst]
  [result-ty : AstType]) : CompilerIrMaybeValue
  (match lhs
    [(OptSomeConst lhs-value lhs-ty)
      (match rhs
        [(OptSomeConst rhs-value rhs-ty)
          (let
            [operand-ty : AstType
              (opt-binop-operand-type op lhs-ty rhs-ty result-ty)]
            (cond
              [(opt-bool-type? operand-ty)
                (opt-fold-bool op lhs-value rhs-value)]
              [(opt-int-or-char-type? operand-ty)
                (opt-fold-int-char-binop
                  op
                  lhs-value
                  rhs-value
                  operand-ty
                  rhs-ty)]
              [(opt-float-type? operand-ty)
                (opt-fold-float-binop op lhs-value rhs-value operand-ty)]
              [else (IrNoValue)]))]
        [(OptNoConst) (IrNoValue)])]
    [(OptNoConst) (IrNoValue)]))

(define (opt-fold-unop
  [op : CompilerIrUnOp]
  [src : OptKnownConst]
  [result-ty : AstType]) : CompilerIrMaybeValue
  (match src
    [(OptSomeConst value _)
      (match op
        [(IrUnNeg)
          (if (opt-integer-type? result-ty)
            (match (opt-normalize-scalar-to-i64 value result-ty)
              [(OptSomeI64 a)
                (IrSomeValue
                  (IrValueI64 (opt-normalize-int-to-i64 (- 0 a) result-ty)))]
              [(OptNoI64) (IrNoValue)])
            (if (opt-float-type? result-ty)
              (match (opt-value-to-f64 value result-ty)
                [(CompilerFloatSomeF64 a)
                  (opt-f64-to-ir-value (- 0.0 a) result-ty)]
                [(CompilerFloatNoF64) (IrNoValue)])
              (IrNoValue)))]
        [(IrUnNot)
          (if (opt-bool-type? result-ty)
            (match (opt-value-to-bool value)
              [(OptSomeBool a) (IrSomeValue (IrValueBool (not a)))]
              [(OptNoBool) (IrNoValue)])
            (IrNoValue))]
        [(IrUnBitNot)
          (if (opt-integer-type? result-ty)
            (match (opt-normalize-scalar-to-i64 value result-ty)
              [(OptSomeI64 a)
                (IrSomeValue
                  (IrValueI64 (opt-normalize-int-to-i64 (bit-not a) result-ty)))]
              [(OptNoI64) (IrNoValue)])
            (IrNoValue))])]
    [(OptNoConst) (IrNoValue)]))

;; --- strength reduction / algebraic identities (#924) -----------------------
;;
;; Rewrite only identities that are valid for all values of the instruction's
;; type. Division, modulo, and shifts intentionally have no identities here, so
;; potentially trapping/edge-sensitive operations stay in the IR.
(define (opt-i64-zero? [value : CompilerIrValue]) : bool
  (match value
    [(IrValueI64 n) (= n 0)]
    [_ false]))

(define (opt-i64-one? [value : CompilerIrValue]) : bool
  (match value
    [(IrValueI64 n) (= n 1)]
    [_ false]))

(define (opt-bool-true? [value : CompilerIrValue]) : bool
  (match value
    [(IrValueBool b) b]
    [_ false]))

(define (opt-bool-false? [value : CompilerIrValue]) : bool
  (match value
    [(IrValueBool b) (not b)]
    [_ false]))

(define (opt-strength-int-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [resolved-lhs : CompilerIrValue]
  [resolved-rhs : CompilerIrValue]) : CompilerIrMaybeValue
  (match op
    [(IrBinAdd)
      (if (opt-i64-zero? resolved-rhs)
        (IrSomeValue lhs)
        (if (opt-i64-zero? resolved-lhs)
          (IrSomeValue rhs)
          (IrNoValue)))]
    [(IrBinSub)
      (if (opt-i64-zero? resolved-rhs)
        (IrSomeValue lhs)
        (IrNoValue))]
    [(IrBinMul)
      (cond
        [(or (opt-i64-zero? resolved-lhs) (opt-i64-zero? resolved-rhs))
          (IrSomeValue (IrValueI64 0))]
        [(opt-i64-one? resolved-rhs) (IrSomeValue lhs)]
        [(opt-i64-one? resolved-lhs) (IrSomeValue rhs)]
        [else (IrNoValue)])]
    [_ (IrNoValue)]))

(define (opt-strength-bool-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [resolved-lhs : CompilerIrValue]
  [resolved-rhs : CompilerIrValue]) : CompilerIrMaybeValue
  (match op
    [(IrBinAnd)
      (cond
        [(or (opt-bool-false? resolved-lhs) (opt-bool-false? resolved-rhs))
          (IrSomeValue (IrValueBool false))]
        [(opt-bool-true? resolved-rhs) (IrSomeValue lhs)]
        [(opt-bool-true? resolved-lhs) (IrSomeValue rhs)]
        [else (IrNoValue)])]
    [(IrBinOr)
      (cond
        [(or (opt-bool-true? resolved-lhs) (opt-bool-true? resolved-rhs))
          (IrSomeValue (IrValueBool true))]
        [(opt-bool-false? resolved-rhs) (IrSomeValue lhs)]
        [(opt-bool-false? resolved-lhs) (IrSomeValue rhs)]
        [else (IrNoValue)])]
    [_ (IrNoValue)]))

(define (opt-strength-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [resolved-lhs : CompilerIrValue]
  [resolved-rhs : CompilerIrValue]
  [ty : AstType]) : CompilerIrMaybeValue
  (if (opt-integer-type? ty)
    (opt-strength-int-binop op lhs rhs resolved-lhs resolved-rhs)
    (if (opt-bool-type? ty)
      (opt-strength-bool-binop op lhs rhs resolved-lhs resolved-rhs)
      (IrNoValue))))

;; --- instruction / block / function / program traversal ----------------------
(defenum OptInstrResult
  (OptInstrResult OptConstEnv CompilerIrInstr))

(define (opt-invalidate-def
  [env : OptConstEnv]
  [dst : i64]
  [instr : CompilerIrInstr]) : OptInstrResult
  (OptInstrResult (opt-const-unbind env dst) instr))

(define (opt-fold-mask-binop-op
  [op : CompilerIrMaskBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : CompilerIrMaskBinOp
  (if (opt-value-eq lhs rhs)
    (IrMaskAnd)
    op))

(define (opt-fold-instr [env : OptConstEnv] [instr : CompilerIrInstr]) : OptInstrResult
  (match instr
    [(IrInstrMov dst value ty)
      (match (opt-resolve-known env value ty)
        [(OptSomeConst folded _)
          (OptInstrResult
            (opt-const-bind env dst folded ty)
            (IrInstrMov dst folded ty))]
        [(OptNoConst) (OptInstrResult (opt-const-unbind env dst) instr)])]
    [(IrInstrAlloc dst ty) (opt-invalidate-def env dst instr)]
    [(IrInstrAddrOf dst src) (opt-invalidate-def env dst instr)]
    [(IrInstrGep dst base offset ty) (opt-invalidate-def env dst instr)]
    [(IrInstrLoad dst src ty) (opt-invalidate-def env dst instr)]
    [(IrInstrCast dst src from-ty to-ty)
      (match (opt-fold-cast (opt-resolve-known env src from-ty) from-ty to-ty)
        [(IrSomeValue folded)
          (OptInstrResult
            (opt-const-bind env dst folded to-ty)
            (IrInstrMov dst folded to-ty))]
        [(IrNoValue)
          (OptInstrResult
            (opt-const-unbind env dst)
            (if (opt-int-cast-as-mov? from-ty to-ty)
              (IrInstrMov dst src to-ty)
              instr))])]
    [(IrInstrBitcast dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrBinOp dst op l r ty)
      (match (opt-fold-binop
        op
        (opt-resolve-known env l ty)
        (opt-resolve-known env r ty)
        ty)
        [(IrSomeValue folded)
          (OptInstrResult
            (opt-const-bind env dst folded ty)
            (IrInstrMov dst folded ty))]
        [(IrNoValue) (OptInstrResult (opt-const-unbind env dst) instr)])]
    [(IrInstrUnOp dst op v ty)
      (match (opt-fold-unop op (opt-resolve-known env v ty) ty)
        [(IrSomeValue folded)
          (OptInstrResult
            (opt-const-bind env dst folded ty)
            (IrInstrMov dst folded ty))]
        [(IrNoValue) (OptInstrResult (opt-const-unbind env dst) instr)])]
    [(IrInstrLaneId dst _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrSplat dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(IrInstrVectorReduce dst _ _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(IrInstrMaskBinOp dst op lhs rhs lanes)
      (OptInstrResult
        (opt-const-unbind env dst)
        (IrInstrMaskBinOp dst (opt-fold-mask-binop-op op lhs rhs) lhs rhs lanes))]
    [(IrInstrMaskNot dst _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrMaskReduce dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(IrInstrVectorLoad dst _ _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(IrInstrTailMask dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrEntryArgc dst) (opt-invalidate-def env dst instr)]
    [(IrInstrEntryArgv dst) (opt-invalidate-def env dst instr)]
    [(IrInstrEntryEnvp dst) (opt-invalidate-def env dst instr)]
    [(IrInstrCpuId dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrXgetbv dst _) (opt-invalidate-def env dst instr)]
    [(IrInstrSyscall dst _) (opt-invalidate-def env dst instr)]
    [(IrInstrCall dst name args ty) (opt-invalidate-def env dst instr)]
    [(IrInstrCallIndirect dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrCallIndirectC dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrTailCall _ _ _) (OptInstrResult env instr)]
    [(IrInstrPhi dst inputs ty) (opt-invalidate-def env dst instr)]
    [_ (OptInstrResult env instr)]))

(define (opt-fold-instrs [env : OptConstEnv] [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (match (opt-fold-instr env instr)
        [(OptInstrResult new-env new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-fold-instrs new-env (box-get rest)))])]))

(define (opt-fold-instr-seq-from
  [env : OptConstEnv]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (IrInstrNil)
    (match (opt-fold-instr env (compiler-ir-instr-seq-ref instrs index))
      [(OptInstrResult new-env new-instr)
        (compiler-ir-instr-cons
          new-instr
          (opt-fold-instr-seq-from new-env instrs (+ index 1)))])))

(define (opt-fold-instr-seq [env : OptConstEnv] [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-fold-instr-seq-from env instrs 0))

(define (opt-strength-instr [env : OptConstEnv] [instr : CompilerIrInstr]) : OptInstrResult
  (match instr
    [(IrInstrMov dst value ty)
      (match (opt-resolve-known env value ty)
        [(OptSomeConst folded _)
          (OptInstrResult
            (opt-const-bind env dst folded ty)
            (IrInstrMov dst folded ty))]
        [(OptNoConst) (OptInstrResult (opt-const-unbind env dst) instr)])]
    [(IrInstrAlloc dst ty) (opt-invalidate-def env dst instr)]
    [(IrInstrAddrOf dst src) (opt-invalidate-def env dst instr)]
    [(IrInstrGep dst base offset ty) (opt-invalidate-def env dst instr)]
    [(IrInstrLoad dst src ty) (opt-invalidate-def env dst instr)]
    [(IrInstrCast dst src from-ty to-ty) (opt-invalidate-def env dst instr)]
    [(IrInstrBitcast dst src from-ty to-ty) (opt-invalidate-def env dst instr)]
    [(IrInstrBinOp dst op l r ty)
      (match (opt-strength-binop
        op
        l
        r
        (opt-resolve-value env l)
        (opt-resolve-value env r)
        ty)
        [(IrSomeValue replacement)
          (if (opt-const-value? replacement ty)
            (OptInstrResult
              (opt-const-bind env dst replacement ty)
              (IrInstrMov dst replacement ty))
            (OptInstrResult
              (opt-const-unbind env dst)
              (IrInstrMov dst replacement ty)))]
        [(IrNoValue) (OptInstrResult (opt-const-unbind env dst) instr)])]
    [(IrInstrUnOp dst op v ty) (opt-invalidate-def env dst instr)]
    [(IrInstrLaneId dst _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrSplat dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(IrInstrVectorReduce dst _ _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(IrInstrMaskBinOp dst op lhs rhs lanes)
      (OptInstrResult
        (opt-const-unbind env dst)
        (IrInstrMaskBinOp dst (opt-fold-mask-binop-op op lhs rhs) lhs rhs lanes))]
    [(IrInstrMaskNot dst _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrMaskReduce dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(IrInstrVectorLoad dst _ _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (opt-invalidate-def env dst instr)])]
    [(IrInstrTailMask dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrEntryArgc dst) (opt-invalidate-def env dst instr)]
    [(IrInstrEntryArgv dst) (opt-invalidate-def env dst instr)]
    [(IrInstrEntryEnvp dst) (opt-invalidate-def env dst instr)]
    [(IrInstrCpuId dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrXgetbv dst _) (opt-invalidate-def env dst instr)]
    [(IrInstrSyscall dst _) (opt-invalidate-def env dst instr)]
    [(IrInstrCall dst name args ty) (opt-invalidate-def env dst instr)]
    [(IrInstrCallIndirect dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrCallIndirectC dst _ _ _) (opt-invalidate-def env dst instr)]
    [(IrInstrTailCall _ _ _) (OptInstrResult env instr)]
    [(IrInstrPhi dst inputs ty) (opt-invalidate-def env dst instr)]
    [_ (OptInstrResult env instr)]))

(define (opt-strength-instrs [env : OptConstEnv] [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (match (opt-strength-instr env instr)
        [(OptInstrResult new-env new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-strength-instrs new-env (box-get rest)))])]))

;; --- dead-code elimination (#544) --------------------------------------------
;;
;; Conservative DCE matching the Rust optimizer's first slice: collect every IR
;; var id referenced as an operand anywhere in the function, then drop pure
;; temporary-producing instructions (`Mov`/`BinOp`/`UnOp`/`Phi`) whose result is
;; never used. Calls, stores, jumps, branches, and returns are kept regardless
;; (they have side effects or drive control flow). The used set is gathered over
;; the *whole reachable function* after CFG simplification, so a var used in
;; another remaining block is never dropped. DCE itself does not decide
;; reachability.
;; Used-var set: var ids referenced somewhere in the function. Backed by
;; I64I64Map (stored value 1 = present) for O(1) membership; previously a linked
;; list with O(n) contains and O(n^2) dedup'd inserts.
(define (opt-used-contains [set : I64I64Map] [var : i64]) : bool
  (i64-i64-map-contains? set var))

(define (opt-used-add [set : I64I64Map] [var : i64]) : I64I64Map
  (i64-i64-map-put set var 1))

(define (opt-collect-value-uses [set : I64I64Map] [value : CompilerIrValue]) : I64I64Map
  (match value
    [(IrValueVar id) (opt-used-add set id)]
    [_ set]))

(define (opt-collect-value-list-uses
  [set : I64I64Map]
  [values : CompilerIrValueList]) : I64I64Map
  (match values
    [(IrValueNil) set]
    [(IrValueCons value rest)
      (opt-collect-value-list-uses
        (opt-collect-value-uses set value)
        (box-get rest))]))

(define (opt-collect-call-args-array-uses
  [set : I64I64Map]
  [values : (Array CompilerIrValue)]
  [index : i64]) : I64I64Map
  (if (>= index (array-length values))
    set
    (opt-collect-call-args-array-uses
      (opt-collect-value-uses set (array-ref values index))
      values
      (+ index 1))))

(define (opt-collect-call-args-uses
  [set : I64I64Map]
  [args : CompilerIrCallArgs]) : I64I64Map
  (match args
    [(IrCallArgsNil) set]
    [(IrCallArgsOne value) (opt-collect-value-uses set value)]
    [(IrCallArgsTwo a b)
      (opt-collect-value-uses (opt-collect-value-uses set a) b)]
    [(IrCallArgsArray values) (opt-collect-call-args-array-uses set values 0)]))

(define (opt-collect-phi-uses
  [set : I64I64Map]
  [inputs : CompilerIrPhiInputList]) : I64I64Map
  (match inputs
    [(IrPhiInputNil) set]
    [(IrPhiInputCons value _ rest)
      (opt-collect-phi-uses (opt-collect-value-uses set value) (box-get rest))]))

(define (opt-collect-instr-uses [set : I64I64Map] [instr : CompilerIrInstr]) : I64I64Map
  (match instr
    [(IrInstrMov _ src _) (opt-collect-value-uses set src)]
    [(IrInstrBinOp _ _ l r _)
      (opt-collect-value-uses (opt-collect-value-uses set l) r)]
    [(IrInstrUnOp _ _ src _) (opt-collect-value-uses set src)]
    [(IrInstrCall _ _ args _) (opt-collect-call-args-uses set args)]
    [(IrInstrCallIndirect _ func args _)
      (opt-collect-call-args-uses (opt-collect-value-uses set func) args)]
    [(IrInstrCallIndirectC _ func args _)
      (opt-collect-call-args-uses (opt-collect-value-uses set func) args)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base _ args _)
          (opt-collect-call-args-uses (opt-collect-value-uses set base) args)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload base func args _)
          (opt-collect-call-args-uses
            (opt-collect-value-uses (opt-collect-value-uses set base) func)
            args)])]
    [(IrInstrTailCall _ args _) (opt-collect-call-args-uses set args)]
    [(IrInstrStore _ value _) (opt-collect-value-uses set value)]
    ;; Pointer/memory ops carry operand uses too; missing any of these would let
    ;; DCE wrongly drop a definition that feeds an address/load/store/cast.
    [(IrInstrAddrOf _ src) (opt-used-add set src)]
    [(IrInstrGep _ base offset _)
      (opt-collect-value-uses (opt-collect-value-uses set base) offset)]
    [(IrInstrLoad _ src _) (opt-collect-value-uses set src)]
    [(IrInstrStorePtr ptr value _)
      (opt-collect-value-uses (opt-collect-value-uses set ptr) value)]
    [(IrInstrCopyBytes dst src _)
      (opt-collect-value-uses (opt-collect-value-uses set dst) src)]
    [(IrInstrBoundsCheck index length _)
      (opt-collect-value-uses (opt-collect-value-uses set index) length)]
    [(IrInstrCast _ src _ _) (opt-collect-value-uses set src)]
    [(IrInstrBitcast _ src _ _) (opt-collect-value-uses set src)]
    [(IrInstrSplat _ value _ _) (opt-collect-value-uses set value)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ lhs rhs _ _)
          (opt-collect-value-uses (opt-collect-value-uses set lhs) rhs)])]
    [(IrInstrVectorReduce _ _ src _ _) (opt-collect-value-uses set src)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ lhs rhs _ _)
          (opt-collect-value-uses (opt-collect-value-uses set lhs) rhs)])]
    [(IrInstrMaskBinOp _ _ lhs rhs _)
      (opt-collect-value-uses (opt-collect-value-uses set lhs) rhs)]
    [(IrInstrMaskNot _ src _) (opt-collect-value-uses set src)]
    [(IrInstrMaskReduce _ _ src _) (opt-collect-value-uses set src)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ mask on-true on-false _ _)
          (opt-collect-value-uses
            (opt-collect-value-uses (opt-collect-value-uses set mask) on-true)
            on-false)])]
    [(IrInstrVectorLoad _ base index _ _)
      (opt-collect-value-uses (opt-collect-value-uses set base) index)]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload base index value _ _)
          (opt-collect-value-uses
            (opt-collect-value-uses (opt-collect-value-uses set base) index)
            value)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload base index value mask _ _)
          (opt-collect-value-uses
            (opt-collect-value-uses
              (opt-collect-value-uses (opt-collect-value-uses set base) index)
              value)
            mask)])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload _ base index mask _ _)
          (opt-collect-value-uses
            (opt-collect-value-uses (opt-collect-value-uses set base) index)
            mask)])]
    [(IrInstrTailMask _ index length _)
      (opt-collect-value-uses (opt-collect-value-uses set index) length)]
    [(IrInstrEntryArgc _) set]
    [(IrInstrEntryArgv _) set]
    [(IrInstrEntryEnvp _) set]
    [(IrInstrCpuId _ leaf subleaf _)
      (opt-collect-value-uses (opt-collect-value-uses set leaf) subleaf)]
    [(IrInstrXgetbv _ index) (opt-collect-value-uses set index)]
    [(IrInstrSyscall _ args) (opt-collect-call-args-uses set args)]
    [(IrInstrBranch cond _ _) (opt-collect-value-uses set cond)]
    [(IrInstrReturn maybe)
      (match maybe
        [(IrSomeValue value) (opt-collect-value-uses set value)]
        [(IrNoValue) set])]
    [(IrInstrPhi _ inputs _) (opt-collect-phi-uses set inputs)]
    ;; #2386: register-group ops use their operands -- Pack uses each word value,
    ;; Word uses the source group. Omitting these would let DCE drop a definition
    ;; that feeds a Pack/Word.
    [(IrInstrPack _ words _) (opt-collect-value-list-uses set words)]
    [(IrInstrWord _ src _ _) (opt-collect-value-uses set src)]
    [(IrInstrTailCallIndirect func args _)
      (opt-collect-call-args-uses (opt-collect-value-uses set func) args)]
    ;; `IrInstrAlloc` has no operand uses; `IrInstrJump` has none either.
    [_ set]))

(define (opt-collect-instrs-uses
  [set : I64I64Map]
  [instrs : CompilerIrInstrList]) : I64I64Map
  (match instrs
    [(IrInstrNil) set]
    [(IrInstrCons instr rest)
      (opt-collect-instrs-uses
        (opt-collect-instr-uses set instr)
        (box-get rest))]))

(define (opt-collect-instr-seq-uses-from
  [set : I64I64Map]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]) : I64I64Map
  (if (>= index count)
    set
    (opt-collect-instr-seq-uses-from
      (opt-collect-instr-uses set (array-ref slots index))
      slots
      (+ index 1)
      count)))

(define (opt-collect-instr-seq-uses
  [set : I64I64Map]
  [instrs : CompilerIrInstrSeq]) : I64I64Map
  (opt-collect-instr-seq-uses-from
    set
    (struct-get instrs slots)
    0
    (struct-get instrs len)))

(define (opt-collect-blocks-uses
  [set : I64I64Map]
  [blocks : CompilerIrBlockList]) : I64I64Map
  (match blocks
    [(IrBlockNil) set]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-collect-blocks-uses
            (opt-collect-instr-seq-uses set instrs)
            (box-get rest))])]
    [(IrBlockArray seq)
      (opt-collect-blocks-uses set (compiler-ir-block-seq-to-list seq))]))

;; Division, modulo, and shift can trap at runtime (zero divisor, signed
;; MIN / -1, shift count out of range), so a BinOp using one of those operators
;; is NOT pure: dropping it as dead would elide the trap the safe-code contract
;; requires. These ops must stay in the IR even when their result is unused.
(define (opt-binop-traps? [op : CompilerIrBinOp]) : bool
  (match op
    [(IrBinDiv) true]
    [(IrBinMod) true]
    [(IrBinShl) true]
    [(IrBinShr) true]
    [_ false]))

(define (opt-instr-alloc-dst? [instr : CompilerIrInstr] [dst : i64]) : bool
  (match instr
    [(IrInstrAlloc other _) (= other dst)]
    [_ false]))

(define (opt-next-adjacent-alloc? [next : CompilerIrInstrList] [dst : i64]) : bool
  (match next
    [(IrInstrCons instr _) (opt-instr-alloc-dst? instr (+ dst 1))]
    [_ false]))

(define (opt-array-prev-adjacent-alloc?
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [dst : i64]) : bool
  (if (<= index 0)
    false
    (opt-instr-alloc-dst? (array-ref slots (- index 1)) (- dst 1))))

(define (opt-array-next-adjacent-alloc?
  [slots : (Array CompilerIrInstr)]
  [count : i64]
  [index : i64]
  [dst : i64]) : bool
  (if (>= (+ index 1) count)
    false
    (opt-instr-alloc-dst? (array-ref slots (+ index 1)) (+ dst 1))))

;; A pure temporary-producing instruction is dead when its result var is unused.
;; Calls (side-effecting) and control-flow instructions are never dead here.
;;
;; Address arithmetic (`IrInstrGep`), value conversions (`IrInstrCast`), and
;; non-volatile reads (`IrInstrLoad`) are pure or read-only
;; (`compiler-ir-instr-effect` classes `IrEffectPure` / `IrEffectMemoryRead`): a
;; load never writes state and only ever feeds its result var, so when that var
;; is unused the whole computation is dead. These arms let DCE clear the dead
;; length-load / gep / cast chain that `opt-loop-bce-blocks` leaves behind once
;; it proves an array index in range, which otherwise survives every later pass
;; because these producers were excluded here. `IrInstrAddrOf` is intentionally
;; NOT included: making address-of DCE-eligible regressed
;; `compiler-optimize-spans-cse-ok?` (a CSE-rewritten copy feeding a surviving
;; `&v` was dropped), and it is not part of the bounds-check chain, so it stays
;; conservative here.
(define (opt-instr-dead? [set : I64I64Map] [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrMov dst _ _) (not (opt-used-contains set dst))]
    [(IrInstrGep dst _ _ _) (not (opt-used-contains set dst))]
    [(IrInstrCast dst _ _ _) (not (opt-used-contains set dst))]
    [(IrInstrLoad dst _ _) (not (opt-used-contains set dst))]
    [(IrInstrBinOp dst op _ _ _)
      (and (not (opt-binop-traps? op)) (not (opt-used-contains set dst)))]
    [(IrInstrUnOp dst _ _ _) (not (opt-used-contains set dst))]
    [(IrInstrPhi dst _ _) (not (opt-used-contains set dst))]
    [(IrInstrLaneId dst _ _) (not (opt-used-contains set dst))]
    [(IrInstrSplat dst _ _ _) (not (opt-used-contains set dst))]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (not (opt-used-contains set dst))])]
    [(IrInstrVectorReduce dst _ _ _ _) (not (opt-used-contains set dst))]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (not (opt-used-contains set dst))])]
    [(IrInstrMaskBinOp dst _ _ _ _) (not (opt-used-contains set dst))]
    [(IrInstrMaskNot dst _ _) (not (opt-used-contains set dst))]
    [(IrInstrMaskReduce dst _ _ _) (not (opt-used-contains set dst))]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (not (opt-used-contains set dst))])]
    [(IrInstrTailMask dst _ _ _) (not (opt-used-contains set dst))]
    [(IrInstrPack dst _ _) (not (opt-used-contains set dst))]
    [(IrInstrWord dst _ _ _) (not (opt-used-contains set dst))]
    [_ false]))

(define (opt-dce-instrs-from
  [set : I64I64Map]
  [instrs : CompilerIrInstrList]
  [prev-alloc-dst : i64]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (let
        [rest-list : CompilerIrInstrList (box-get rest)]
        (if (opt-instr-dead? set instr)
          (opt-dce-instrs-from set rest-list -2)
          (match instr
            [(IrInstrAlloc dst _)
              (if (and
                (not (opt-used-contains set dst))
                (not
                  (or
                    (= prev-alloc-dst (- dst 1))
                    (opt-next-adjacent-alloc? rest-list dst))))
                (opt-dce-instrs-from set rest-list dst)
                (compiler-ir-instr-cons
                  instr
                  (opt-dce-instrs-from set rest-list dst)))]
            [_
              (compiler-ir-instr-cons
                instr
                (opt-dce-instrs-from set rest-list -2))])))]))

(define (opt-dce-instrs [set : I64I64Map] [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (opt-dce-instrs-from set instrs -2))

(define (opt-dce-instr-seq-from
  [set : I64I64Map]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]) : CompilerIrInstrList
  (if (>= index count)
    (IrInstrNil)
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [rest : CompilerIrInstrList
        (opt-dce-instr-seq-from set slots (+ index 1) count)]
      (if (opt-instr-dead? set instr)
        rest
        (match instr
          [(IrInstrAlloc dst _)
            (if (and
              (not (opt-used-contains set dst))
              (not
                (or
                  (opt-array-prev-adjacent-alloc? slots index dst)
                  (opt-array-next-adjacent-alloc? slots count index dst))))
              rest
              (compiler-ir-instr-cons instr rest))]
          [_ (compiler-ir-instr-cons instr rest)])))))

(define (opt-dce-instr-seq [set : I64I64Map] [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-dce-instr-seq-from
    set
    (struct-get instrs slots)
    0
    (struct-get instrs len)))

(define (opt-dce-block [set : I64I64Map] [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-dce-instr-seq set instrs))]))

(define (opt-dce-block-list [set : I64I64Map] [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (opt-dce-block set block)
        (opt-dce-block-list set (box-get rest)))]
    [(IrBlockArray seq)
      (opt-dce-block-list set (compiler-ir-block-seq-to-list seq))]))

(define (opt-used-array-fill [items : (Array i64)] [index : i64] [value : i64]) : unit
  (if (>= index (array-length items))
    unit
    (begin
      (array-set! items index value)
      (opt-used-array-fill items (+ index 1) value))))

(define (opt-used-array-new [count : i64]) : (Array i64)
  (let
    [items : (Array i64) (make-array i64 count)]
    (begin
      (opt-used-array-fill items 0 0)
      items)))

;; Use counts (not booleans): `add` bumps the count, `contains` reports any live
;; use, and `dec` drops a single use when DCE deletes an instruction. Counting
;; lets one backward DCE sweep retire a whole dead chain -- deleting the cast
;; that fed a removed bounds check decrements its operand load, which then reads
;; as dead when the sweep reaches it, and so on down the gep.
(define (opt-used-array-add [items : (Array i64)] [var : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length items))
      unit
      (begin
        (array-set! items var (+ (array-ref items var) 1))
        unit))))

(define (opt-used-array-dec [items : (Array i64)] [var : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length items))
      unit
      (let
        [current : i64 (array-ref items var)]
        (if (> current 0)
          (begin
            (array-set! items var (- current 1))
            unit)
          unit)))))

(define (opt-used-array-contains [items : (Array i64)] [var : i64]) : bool
  (if (< var 0)
    false
    (if (>= var (array-length items))
      false
      (> (array-ref items var) 0))))

(define (opt-collect-value-uses-array
  [items : (Array i64)]
  [value : CompilerIrValue]) : unit
  (match value
    [(IrValueVar id) (opt-used-array-add items id)]
    [_ unit]))

(define (opt-collect-value-list-uses-array
  [items : (Array i64)]
  [values : CompilerIrValueList]) : unit
  (match values
    [(IrValueNil) unit]
    [(IrValueCons value rest)
      (begin
        (opt-collect-value-uses-array items value)
        (opt-collect-value-list-uses-array items (box-get rest)))]))

(define (opt-collect-call-args-array-uses-array
  [items : (Array i64)]
  [values : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length values))
    unit
    (begin
      (opt-collect-value-uses-array items (array-ref values index))
      (opt-collect-call-args-array-uses-array items values (+ index 1)))))

(define (opt-collect-call-args-uses-array
  [items : (Array i64)]
  [args : CompilerIrCallArgs]) : unit
  (match args
    [(IrCallArgsNil) unit]
    [(IrCallArgsOne value) (opt-collect-value-uses-array items value)]
    [(IrCallArgsTwo a b)
      (begin
        (opt-collect-value-uses-array items a)
        (opt-collect-value-uses-array items b))]
    [(IrCallArgsArray values)
      (opt-collect-call-args-array-uses-array items values 0)]))

(define (opt-collect-phi-uses-array
  [items : (Array i64)]
  [inputs : CompilerIrPhiInputList]) : unit
  (match inputs
    [(IrPhiInputNil) unit]
    [(IrPhiInputCons value _ rest)
      (begin
        (opt-collect-value-uses-array items value)
        (opt-collect-phi-uses-array items (box-get rest)))]))

(define (opt-collect-instr-uses-array
  [items : (Array i64)]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(IrInstrMov _ src _) (opt-collect-value-uses-array items src)]
    [(IrInstrBinOp _ _ l r _)
      (begin
        (opt-collect-value-uses-array items l)
        (opt-collect-value-uses-array items r))]
    [(IrInstrUnOp _ _ src _) (opt-collect-value-uses-array items src)]
    [(IrInstrCall _ _ args _) (opt-collect-call-args-uses-array items args)]
    [(IrInstrCallIndirect _ func args _)
      (begin
        (opt-collect-value-uses-array items func)
        (opt-collect-call-args-uses-array items args))]
    [(IrInstrCallIndirectC _ func args _)
      (begin
        (opt-collect-value-uses-array items func)
        (opt-collect-call-args-uses-array items args))]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base _ args _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-call-args-uses-array items args))])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload base func args _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-value-uses-array items func)
            (opt-collect-call-args-uses-array items args))])]
    [(IrInstrTailCall _ args _) (opt-collect-call-args-uses-array items args)]
    [(IrInstrStore _ value _) (opt-collect-value-uses-array items value)]
    [(IrInstrAddrOf _ src) (opt-used-array-add items src)]
    [(IrInstrGep _ base offset _)
      (begin
        (opt-collect-value-uses-array items base)
        (opt-collect-value-uses-array items offset))]
    [(IrInstrLoad _ src _) (opt-collect-value-uses-array items src)]
    [(IrInstrStorePtr ptr value _)
      (begin
        (opt-collect-value-uses-array items ptr)
        (opt-collect-value-uses-array items value))]
    [(IrInstrCopyBytes dst src _)
      (begin
        (opt-collect-value-uses-array items dst)
        (opt-collect-value-uses-array items src))]
    [(IrInstrBoundsCheck index length _)
      (begin
        (opt-collect-value-uses-array items index)
        (opt-collect-value-uses-array items length))]
    [(IrInstrCast _ src _ _) (opt-collect-value-uses-array items src)]
    [(IrInstrBitcast _ src _ _) (opt-collect-value-uses-array items src)]
    [(IrInstrSplat _ value _ _) (opt-collect-value-uses-array items value)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ lhs rhs _ _)
          (begin
            (opt-collect-value-uses-array items lhs)
            (opt-collect-value-uses-array items rhs))])]
    [(IrInstrVectorReduce _ _ src _ _) (opt-collect-value-uses-array items src)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ lhs rhs _ _)
          (begin
            (opt-collect-value-uses-array items lhs)
            (opt-collect-value-uses-array items rhs))])]
    [(IrInstrMaskBinOp _ _ lhs rhs _)
      (begin
        (opt-collect-value-uses-array items lhs)
        (opt-collect-value-uses-array items rhs))]
    [(IrInstrMaskNot _ src _) (opt-collect-value-uses-array items src)]
    [(IrInstrMaskReduce _ _ src _) (opt-collect-value-uses-array items src)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ mask on-true on-false _ _)
          (begin
            (opt-collect-value-uses-array items mask)
            (opt-collect-value-uses-array items on-true)
            (opt-collect-value-uses-array items on-false))])]
    [(IrInstrVectorLoad _ base index _ _)
      (begin
        (opt-collect-value-uses-array items base)
        (opt-collect-value-uses-array items index))]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload base index value _ _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-value-uses-array items index)
            (opt-collect-value-uses-array items value))])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload base index value mask _ _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-value-uses-array items index)
            (opt-collect-value-uses-array items value)
            (opt-collect-value-uses-array items mask))])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload _ base index mask _ _)
          (begin
            (opt-collect-value-uses-array items base)
            (opt-collect-value-uses-array items index)
            (opt-collect-value-uses-array items mask))])]
    [(IrInstrTailMask _ index length _)
      (begin
        (opt-collect-value-uses-array items index)
        (opt-collect-value-uses-array items length))]
    [(IrInstrEntryArgc _) unit]
    [(IrInstrEntryArgv _) unit]
    [(IrInstrEntryEnvp _) unit]
    [(IrInstrCpuId _ leaf subleaf _)
      (begin
        (opt-collect-value-uses-array items leaf)
        (opt-collect-value-uses-array items subleaf))]
    [(IrInstrXgetbv _ index) (opt-collect-value-uses-array items index)]
    [(IrInstrSyscall _ args) (opt-collect-call-args-uses-array items args)]
    [(IrInstrBranch cond _ _) (opt-collect-value-uses-array items cond)]
    [(IrInstrReturn maybe)
      (match maybe
        [(IrSomeValue value) (opt-collect-value-uses-array items value)]
        [(IrNoValue) unit])]
    [(IrInstrPhi _ inputs _) (opt-collect-phi-uses-array items inputs)]
    ;; #2386: register-group ops use their operands (Pack: each word; Word: src).
    [(IrInstrPack _ words _) (opt-collect-value-list-uses-array items words)]
    [(IrInstrWord _ src _ _) (opt-collect-value-uses-array items src)]
    [(IrInstrTailCallIndirect func args _)
      (begin
        (opt-collect-value-uses-array items func)
        (opt-collect-call-args-uses-array items args))]
    [_ unit]))

;; Decrement the operand use counts an instruction contributed. Called when DCE
;; deletes that instruction so a single backward sweep can retire the rest of a
;; now-dead chain. Only the pure/group producers DCE can delete need arms here;
;; anything else leaves the counts untouched (conservative -- it just keeps an
;; instruction).
(define (opt-uncount-value-uses-array
  [items : (Array i64)]
  [value : CompilerIrValue]) : unit
  (match value
    [(IrValueVar id) (opt-used-array-dec items id)]
    [_ unit]))

(define (opt-uncount-value-list-uses-array
  [items : (Array i64)]
  [values : CompilerIrValueList]) : unit
  (match values
    [(IrValueNil) unit]
    [(IrValueCons value rest)
      (begin
        (opt-uncount-value-uses-array items value)
        (opt-uncount-value-list-uses-array items (box-get rest)))]))

(define (opt-uncount-phi-uses-array
  [items : (Array i64)]
  [inputs : CompilerIrPhiInputList]) : unit
  (match inputs
    [(IrPhiInputNil) unit]
    [(IrPhiInputCons value _ rest)
      (begin
        (opt-uncount-value-uses-array items value)
        (opt-uncount-phi-uses-array items (box-get rest)))]))

(define (opt-uncount-instr-uses-array
  [items : (Array i64)]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(IrInstrMov _ src _) (opt-uncount-value-uses-array items src)]
    [(IrInstrGep _ base offset _)
      (begin
        (opt-uncount-value-uses-array items base)
        (opt-uncount-value-uses-array items offset))]
    [(IrInstrCast _ src _ _) (opt-uncount-value-uses-array items src)]
    [(IrInstrLoad _ src _) (opt-uncount-value-uses-array items src)]
    [(IrInstrBinOp _ _ lhs rhs _)
      (begin
        (opt-uncount-value-uses-array items lhs)
        (opt-uncount-value-uses-array items rhs))]
    [(IrInstrUnOp _ _ src _) (opt-uncount-value-uses-array items src)]
    [(IrInstrPhi _ inputs _) (opt-uncount-phi-uses-array items inputs)]
    [(IrInstrSplat _ value _ _) (opt-uncount-value-uses-array items value)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ lhs rhs _ _)
          (begin
            (opt-uncount-value-uses-array items lhs)
            (opt-uncount-value-uses-array items rhs))])]
    [(IrInstrVectorReduce _ _ src _ _) (opt-uncount-value-uses-array items src)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ lhs rhs _ _)
          (begin
            (opt-uncount-value-uses-array items lhs)
            (opt-uncount-value-uses-array items rhs))])]
    [(IrInstrMaskBinOp _ _ lhs rhs _)
      (begin
        (opt-uncount-value-uses-array items lhs)
        (opt-uncount-value-uses-array items rhs))]
    [(IrInstrMaskNot _ src _) (opt-uncount-value-uses-array items src)]
    [(IrInstrMaskReduce _ _ src _) (opt-uncount-value-uses-array items src)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ mask on-true on-false _ _)
          (begin
            (opt-uncount-value-uses-array items mask)
            (opt-uncount-value-uses-array items on-true)
            (opt-uncount-value-uses-array items on-false))])]
    [(IrInstrTailMask _ index length _)
      (begin
        (opt-uncount-value-uses-array items index)
        (opt-uncount-value-uses-array items length))]
    [(IrInstrPack _ words _) (opt-uncount-value-list-uses-array items words)]
    [(IrInstrWord _ src _ _) (opt-uncount-value-uses-array items src)]
    [_ unit]))

(define (opt-collect-instr-seq-uses-array
  [items : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (opt-collect-instr-uses-array items (array-ref slots index))
          (set! index (+ index 1))))
      unit)))

(define (opt-collect-blocks-uses-array-into
  [items : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(IrBlockNil) unit]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (begin
            (opt-collect-instr-seq-uses-array items instrs)
            (opt-collect-blocks-uses-array-into items (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-collect-blocks-uses-array-into
        items
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-collect-blocks-uses-array
  [vars : i64]
  [blocks : CompilerIrBlockList]) : (Array i64)
  (let
    [items : (Array i64) (opt-used-array-new vars)]
    (begin
      (opt-collect-blocks-uses-array-into items blocks)
      items)))

;; Mirror of `opt-instr-dead?` for the array-backed use set the pipeline DCE
;; runs on. The pure (`IrInstrGep`/`IrInstrCast`) and read-only (`IrInstrLoad`)
;; arms drop the dead length-load/gep/cast chain that `opt-loop-bce-blocks`
;; strands once a bounds check is proven redundant. `IrInstrAddrOf` is excluded
;; for the same reason as in `opt-instr-dead?`.
(define (opt-instr-dead-array?
  [items : (Array i64)]
  [slots : (Array CompilerIrInstr)]
  [count : i64]
  [index : i64]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrAlloc dst _)
      (and
        (not (opt-used-array-contains items dst))
        (not
          (or
            (opt-array-prev-adjacent-alloc? slots index dst)
            (opt-array-next-adjacent-alloc? slots count index dst))))]
    [(IrInstrMov dst _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrGep dst _ _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrCast dst _ _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrLoad dst _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrBinOp dst op _ _ _)
      (and
        (not (opt-binop-traps? op))
        (not (opt-used-array-contains items dst)))]
    [(IrInstrUnOp dst _ _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrPhi dst _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrLaneId dst _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrSplat dst _ _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (not (opt-used-array-contains items dst))])]
    [(IrInstrVectorReduce dst _ _ _ _)
      (not (opt-used-array-contains items dst))]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (not (opt-used-array-contains items dst))])]
    [(IrInstrMaskBinOp dst _ _ _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrMaskNot dst _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrMaskReduce dst _ _ _) (not (opt-used-array-contains items dst))]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (not (opt-used-array-contains items dst))])]
    [(IrInstrTailMask dst _ _ _) (not (opt-used-array-contains items dst))]
    [_ false]))

(define (opt-dce-instr-seq-array
  [items : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 (- count 1)]
    [out : CompilerIrInstrList IrInstrNil]
    (begin
      (while (>= index 0)
        (begin
          (let
            [instr : CompilerIrInstr (array-ref slots index)]
            (if (opt-instr-dead-array? items slots count index instr)
              ;; Deleting this instruction drops the uses it made, so a value it
              ;; was the last reader of becomes dead for an earlier sweep step.
              (opt-uncount-instr-uses-array items instr)
              (set! out (compiler-ir-instr-cons instr out))))
          (set! index (- index 1))))
      out)))

(define (opt-dce-block-array [items : (Array i64)] [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-dce-instr-seq-array items instrs))]))

(define (opt-dce-block-list-array
  [items : (Array i64)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (opt-dce-block-array items block)
        (opt-dce-block-list-array items (box-get rest)))]
    [(IrBlockArray seq)
      (opt-dce-block-list-array items (compiler-ir-block-seq-to-list seq))]))

;; --- aggregate allocation candidate analysis (#1487) ------------------------
;;
;; This is intentionally analysis-only. It recognizes heap aggregate allocations
;; that stay local to a function and records the constant-offset derived pointers
;; plus load/store accesses that a later scalar-replacement slice can consume.
(define (opt-aggregate-fixed-type? [ty : AstType]) : bool
  (match ty
    [(AstTyStruct _) true]
    [(AstTyStructArgs _ _) true]
    [(AstTyEnum _) true]
    [(AstTyEnumArgs _ _) true]
    [(AstTyTuple _) true]
    [(AstTyArray _ _) true]
    [_ false]))

(define (opt-aggregate-tl-alloc-size [args : CompilerIrCallArgs]) : OptMaybeI64
  (match args
    [(IrCallArgsOne value)
      (match value
        [(IrValueI64 size) (OptSomeI64 size)]
        [_ (OptNoI64)])]
    [_ (OptNoI64)]))

(define (opt-aggregate-direct-alloc [instr : CompilerIrInstr]) : OptMaybeAggregateAlloc
  (match instr
    [(IrInstrCall dst name args ty)
      (if (and (string-eq name "tl_alloc") (opt-aggregate-fixed-type? ty))
        (match (opt-aggregate-tl-alloc-size args)
          [(OptSomeI64 size)
            (if (> size 0)
              (OptSomeAggregateAlloc dst ty size)
              (OptNoAggregateAlloc))]
          [(OptNoI64) (OptNoAggregateAlloc)])
        (OptNoAggregateAlloc))]
    [_ (OptNoAggregateAlloc)]))

(define (opt-aggregate-pointer-list-with-capacity [capacity : i64]) : OptAggregatePointerList
  (OptAggregatePointerList (make-array OptAggregatePointer capacity) 0))

(define (opt-aggregate-list-next-capacity [capacity : i64]) : i64
  (if (< capacity opt-aggregate-list-initial-capacity)
    opt-aggregate-list-initial-capacity
    (* capacity 2)))

(define (opt-aggregate-pointer-list-grow [ptrs : OptAggregatePointerList]) : OptAggregatePointerList
  (let
    [old-slots : (Array OptAggregatePointer) (struct-get ptrs slots)]
    [len : i64 (struct-get ptrs len)]
    [new-slots : (Array OptAggregatePointer)
      (make-array
        OptAggregatePointer
        (opt-aggregate-list-next-capacity (array-length old-slots)))]
    [i : i64 0]
    (begin
      (while (< i len)
        (begin
          (array-set! new-slots i (array-ref old-slots i))
          (set! i (+ i 1))))
      (OptAggregatePointerList new-slots len))))

(define (opt-aggregate-pointer-list-push
  [ptrs : OptAggregatePointerList]
  [ptr : OptAggregatePointer]) : OptAggregatePointerList
  (let
    [slots : (Array OptAggregatePointer) (struct-get ptrs slots)]
    [len : i64 (struct-get ptrs len)]
    (if (>= len (array-length slots))
      (opt-aggregate-pointer-list-push
        (opt-aggregate-pointer-list-grow ptrs)
        ptr)
      (begin
        (array-set! slots len ptr)
        (OptAggregatePointerList slots (+ len 1))))))

(define (opt-aggregate-access-list-with-capacity [capacity : i64]) : OptAggregateAccessList
  (OptAggregateAccessList (make-array OptAggregateAccess capacity) 0))

(define (opt-aggregate-access-list-grow [accesses : OptAggregateAccessList]) : OptAggregateAccessList
  (let
    [old-slots : (Array OptAggregateAccess) (struct-get accesses slots)]
    [len : i64 (struct-get accesses len)]
    [new-slots : (Array OptAggregateAccess)
      (make-array
        OptAggregateAccess
        (opt-aggregate-list-next-capacity (array-length old-slots)))]
    [i : i64 0]
    (begin
      (while (< i len)
        (begin
          (array-set! new-slots i (array-ref old-slots i))
          (set! i (+ i 1))))
      (OptAggregateAccessList new-slots len))))

(define (opt-aggregate-access-list-push
  [accesses : OptAggregateAccessList]
  [access : OptAggregateAccess]) : OptAggregateAccessList
  (let
    [slots : (Array OptAggregateAccess) (struct-get accesses slots)]
    [len : i64 (struct-get accesses len)]
    (if (>= len (array-length slots))
      (opt-aggregate-access-list-push
        (opt-aggregate-access-list-grow accesses)
        access)
      (begin
        (array-set! slots len access)
        (OptAggregateAccessList slots (+ len 1))))))

(define (opt-aggregate-candidate-list-with-capacity [capacity : i64]) : OptAggregateAllocCandidateList
  (OptAggregateAllocCandidateList
    (make-array OptAggregateAllocCandidate capacity)
    0))

(define (opt-aggregate-candidate-list-grow
  [candidates : OptAggregateAllocCandidateList]) : OptAggregateAllocCandidateList
  (let
    [old-slots : (Array OptAggregateAllocCandidate)
      (struct-get candidates slots)]
    [len : i64 (struct-get candidates len)]
    [new-slots : (Array OptAggregateAllocCandidate)
      (make-array
        OptAggregateAllocCandidate
        (opt-aggregate-list-next-capacity (array-length old-slots)))]
    [i : i64 0]
    (begin
      (while (< i len)
        (begin
          (array-set! new-slots i (array-ref old-slots i))
          (set! i (+ i 1))))
      (OptAggregateAllocCandidateList new-slots len))))

(define (opt-aggregate-candidate-list-push
  [candidates : OptAggregateAllocCandidateList]
  [candidate : OptAggregateAllocCandidate]) : OptAggregateAllocCandidateList
  (let
    [slots : (Array OptAggregateAllocCandidate) (struct-get candidates slots)]
    [len : i64 (struct-get candidates len)]
    (if (>= len (array-length slots))
      (opt-aggregate-candidate-list-push
        (opt-aggregate-candidate-list-grow candidates)
        candidate)
      (begin
        (array-set! slots len candidate)
        (OptAggregateAllocCandidateList slots (+ len 1))))))

(define (opt-aggregate-promote-slot-list-with-capacity [capacity : i64]) : OptAggregatePromoteSlotList
  (OptAggregatePromoteSlotList (make-array OptAggregatePromoteSlot capacity) 0))

(define (opt-aggregate-promote-slot-list-grow
  [slots-list : OptAggregatePromoteSlotList]) : OptAggregatePromoteSlotList
  (let
    [old-slots : (Array OptAggregatePromoteSlot) (struct-get slots-list slots)]
    [len : i64 (struct-get slots-list len)]
    [new-slots : (Array OptAggregatePromoteSlot)
      (make-array
        OptAggregatePromoteSlot
        (opt-aggregate-list-next-capacity (array-length old-slots)))]
    [i : i64 0]
    (begin
      (while (< i len)
        (begin
          (array-set! new-slots i (array-ref old-slots i))
          (set! i (+ i 1))))
      (OptAggregatePromoteSlotList new-slots len))))

(define (opt-aggregate-promote-slot-list-push
  [slots-list : OptAggregatePromoteSlotList]
  [slot : OptAggregatePromoteSlot]) : OptAggregatePromoteSlotList
  (let
    [slots : (Array OptAggregatePromoteSlot) (struct-get slots-list slots)]
    [len : i64 (struct-get slots-list len)]
    (if (>= len (array-length slots))
      (opt-aggregate-promote-slot-list-push
        (opt-aggregate-promote-slot-list-grow slots-list)
        slot)
      (begin
        (array-set! slots len slot)
        (OptAggregatePromoteSlotList slots (+ len 1))))))

(define (opt-aggregate-pointer-list-lookup-from
  [ptrs : OptAggregatePointerList]
  [var : i64]
  [index : i64]) : OptMaybeI64
  (if (< index 0)
    (OptNoI64)
    (match (array-ref (struct-get ptrs slots) index)
      [(OptAggregatePointer ptr-var offset)
        (if (= ptr-var var)
          (OptSomeI64 offset)
          (opt-aggregate-pointer-list-lookup-from ptrs var (- index 1)))])))

(define (opt-aggregate-pointer-list-lookup
  [ptrs : OptAggregatePointerList]
  [var : i64]) : OptMaybeI64
  (opt-aggregate-pointer-list-lookup-from ptrs var (- (struct-get ptrs len) 1)))

(define (opt-aggregate-value-offset
  [base : i64]
  [ptrs : OptAggregatePointerList]
  [value : CompilerIrValue]) : OptMaybeI64
  (match value
    [(IrValueVar var)
      (if (= var base)
        (OptSomeI64 0)
        (opt-aggregate-pointer-list-lookup ptrs var))]
    [_ (OptNoI64)]))

(define (opt-aggregate-value-has-pointer?
  [base : i64]
  [ptrs : OptAggregatePointerList]
  [value : CompilerIrValue]) : bool
  (match (opt-aggregate-value-offset base ptrs value)
    [(OptSomeI64 _) true]
    [(OptNoI64) false]))

(define (opt-aggregate-value-list-has-pointer?
  [base : i64]
  [ptrs : OptAggregatePointerList]
  [values : CompilerIrValueList]) : bool
  (match values
    [(IrValueNil) false]
    [(IrValueCons value rest)
      (or
        (opt-aggregate-value-has-pointer? base ptrs value)
        (opt-aggregate-value-list-has-pointer? base ptrs (box-get rest)))]))

(define (opt-aggregate-call-args-array-has-pointer?
  [base : i64]
  [ptrs : OptAggregatePointerList]
  [values : (Array CompilerIrValue)]
  [index : i64]) : bool
  (if (>= index (array-length values))
    false
    (or
      (opt-aggregate-value-has-pointer? base ptrs (array-ref values index))
      (opt-aggregate-call-args-array-has-pointer? base ptrs values (+ index 1)))))

(define (opt-aggregate-call-args-has-pointer?
  [base : i64]
  [ptrs : OptAggregatePointerList]
  [args : CompilerIrCallArgs]) : bool
  (match args
    [(IrCallArgsNil) false]
    [(IrCallArgsOne value) (opt-aggregate-value-has-pointer? base ptrs value)]
    [(IrCallArgsTwo a b)
      (or
        (opt-aggregate-value-has-pointer? base ptrs a)
        (opt-aggregate-value-has-pointer? base ptrs b))]
    [(IrCallArgsArray values)
      (opt-aggregate-call-args-array-has-pointer? base ptrs values 0)]))

(define (opt-aggregate-maybe-value-has-pointer?
  [base : i64]
  [ptrs : OptAggregatePointerList]
  [maybe : CompilerIrMaybeValue]) : bool
  (match maybe
    [(IrNoValue) false]
    [(IrSomeValue value) (opt-aggregate-value-has-pointer? base ptrs value)]))

(define (opt-aggregate-phi-inputs-have-pointer?
  [base : i64]
  [ptrs : OptAggregatePointerList]
  [inputs : CompilerIrPhiInputList]) : bool
  (match inputs
    [(IrPhiInputNil) false]
    [(IrPhiInputCons value _ rest)
      (or
        (opt-aggregate-value-has-pointer? base ptrs value)
        (opt-aggregate-phi-inputs-have-pointer? base ptrs (box-get rest)))]))

(define (opt-aggregate-raw-var-is-pointer?
  [base : i64]
  [ptrs : OptAggregatePointerList]
  [var : i64]) : bool
  (or
    (= var base)
    (match (opt-aggregate-pointer-list-lookup ptrs var)
      [(OptSomeI64 _) true]
      [(OptNoI64) false])))

(define (opt-aggregate-instr-has-pointer?
  [instr : CompilerIrInstr]
  [base : i64]
  [ptrs : OptAggregatePointerList]) : bool
  (match instr
    [(IrInstrMov _ src _) (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrAddrOf _ src) (opt-aggregate-raw-var-is-pointer? base ptrs src)]
    [(IrInstrGep _ src offset _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs src)
        (opt-aggregate-value-has-pointer? base ptrs offset))]
    [(IrInstrLoad _ src _) (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrStorePtr ptr value _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs ptr)
        (opt-aggregate-value-has-pointer? base ptrs value))]
    [(IrInstrCopyBytes dst src _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs dst)
        (opt-aggregate-value-has-pointer? base ptrs src))]
    [(IrInstrBoundsCheck index length _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs index)
        (opt-aggregate-value-has-pointer? base ptrs length))]
    [(IrInstrCast _ src _ _) (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrBitcast _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrBinOp _ _ lhs rhs _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs lhs)
        (opt-aggregate-value-has-pointer? base ptrs rhs))]
    [(IrInstrUnOp _ _ src _) (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrSplat _ src _ _) (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ lhs rhs _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs lhs)
            (opt-aggregate-value-has-pointer? base ptrs rhs))])]
    [(IrInstrVectorReduce _ _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ lhs rhs _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs lhs)
            (opt-aggregate-value-has-pointer? base ptrs rhs))])]
    [(IrInstrMaskBinOp _ _ lhs rhs _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs lhs)
        (opt-aggregate-value-has-pointer? base ptrs rhs))]
    [(IrInstrMaskNot _ src _) (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrMaskReduce _ _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ mask on-true on-false _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs mask)
            (opt-aggregate-value-has-pointer? base ptrs on-true)
            (opt-aggregate-value-has-pointer? base ptrs on-false))])]
    [(IrInstrVectorLoad _ vector-base index _ _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs vector-base)
        (opt-aggregate-value-has-pointer? base ptrs index))]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload vector-base index value _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs vector-base)
            (opt-aggregate-value-has-pointer? base ptrs index)
            (opt-aggregate-value-has-pointer? base ptrs value))])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload store-base index value mask _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs store-base)
            (opt-aggregate-value-has-pointer? base ptrs index)
            (opt-aggregate-value-has-pointer? base ptrs value)
            (opt-aggregate-value-has-pointer? base ptrs mask))])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload _ load-base index mask _ _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs load-base)
            (opt-aggregate-value-has-pointer? base ptrs index)
            (opt-aggregate-value-has-pointer? base ptrs mask))])]
    [(IrInstrTailMask _ index length _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs index)
        (opt-aggregate-value-has-pointer? base ptrs length))]
    [(IrInstrEntryArgc _) false]
    [(IrInstrEntryArgv _) false]
    [(IrInstrEntryEnvp _) false]
    [(IrInstrCpuId _ leaf subleaf _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs leaf)
        (opt-aggregate-value-has-pointer? base ptrs subleaf))]
    [(IrInstrXgetbv _ index) (opt-aggregate-value-has-pointer? base ptrs index)]
    [(IrInstrSyscall _ args)
      (opt-aggregate-call-args-has-pointer? base ptrs args)]
    [(IrInstrCall _ _ args _)
      (opt-aggregate-call-args-has-pointer? base ptrs args)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload store-base _ args _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs store-base)
            (opt-aggregate-call-args-has-pointer? base ptrs args))])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload
            store-base
            func
            args
            _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs store-base)
            (opt-aggregate-value-has-pointer? base ptrs func)
            (opt-aggregate-call-args-has-pointer? base ptrs args))])]
    [(IrInstrTailCall _ args _)
      (opt-aggregate-call-args-has-pointer? base ptrs args)]
    [(IrInstrStore _ value _)
      (opt-aggregate-value-has-pointer? base ptrs value)]
    [(IrInstrBranch cond _ _) (opt-aggregate-value-has-pointer? base ptrs cond)]
    [(IrInstrReturn maybe)
      (opt-aggregate-maybe-value-has-pointer? base ptrs maybe)]
    [(IrInstrPhi _ inputs _)
      (opt-aggregate-phi-inputs-have-pointer? base ptrs inputs)]
    [(IrInstrTailCallIndirect func args _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs func)
        (opt-aggregate-call-args-has-pointer? base ptrs args))]
    [_ false]))

(define (opt-aggregate-instrs-touch-candidate?
  [instrs : CompilerIrInstrList]
  [base : i64]
  [ptrs : OptAggregatePointerList]) : bool
  (match instrs
    [(IrInstrNil) false]
    [(IrInstrCons instr rest)
      (or
        (opt-aggregate-instr-has-pointer? instr base ptrs)
        (opt-aggregate-instrs-touch-candidate? (box-get rest) base ptrs))]))

(define (opt-aggregate-instr-known-safe?
  [instr : CompilerIrInstr]
  [base : i64]
  [ptrs : OptAggregatePointerList]) : bool
  (match instr
    [(IrInstrCall dst name _ _) (and (= dst base) (string-eq name "tl_alloc"))]
    [(IrInstrGep _ src offset _)
      (match (opt-aggregate-value-offset base ptrs src)
        [(OptSomeI64 _)
          (match offset
            [(IrValueI64 _) true]
            [_ false])]
        [(OptNoI64) false])]
    [(IrInstrLoad _ src _) (opt-aggregate-value-has-pointer? base ptrs src)]
    [(IrInstrStorePtr ptr value _)
      (and
        (opt-aggregate-value-has-pointer? base ptrs ptr)
        (not (opt-aggregate-value-has-pointer? base ptrs value)))]
    [(IrInstrCopyBytes _ _ _) false]
    [_ false]))

(define (opt-aggregate-instr-crosses-unknown-effect?
  [instr : CompilerIrInstr]
  [base : i64]
  [ptrs : OptAggregatePointerList]) : bool
  (if (opt-aggregate-instr-known-safe? instr base ptrs)
    false
    (compiler-ir-effect-invalidates-cse? (compiler-ir-instr-effect instr))))

(define (opt-aggregate-scan-instrs
  [base : i64]
  [ty : AstType]
  [size : i64]
  [instrs : CompilerIrInstrList]
  [ptrs : OptAggregatePointerList]
  [accesses : OptAggregateAccessList]
  [seen-alloc : bool]) : OptAggregateScanResult
  (match instrs
    [(IrInstrNil)
      (if seen-alloc
        (OptAggregateScanOk ptrs accesses)
        (OptAggregateScanReject))]
    [(IrInstrCons instr rest)
      (if (not seen-alloc)
        (match (opt-aggregate-direct-alloc instr)
          [(OptSomeAggregateAlloc dst alloc-ty alloc-size)
            (if (and (= dst base) (= alloc-size size) (opt-type-eq alloc-ty ty))
              (opt-aggregate-scan-instrs
                base
                ty
                size
                (box-get rest)
                ptrs
                accesses
                true)
              (opt-aggregate-scan-instrs
                base
                ty
                size
                (box-get rest)
                ptrs
                accesses
                false))]
          [(OptNoAggregateAlloc)
            (opt-aggregate-scan-instrs
              base
              ty
              size
              (box-get rest)
              ptrs
              accesses
              false)])
        (match instr
          [(IrInstrGep dst src offset _)
            (match (opt-aggregate-value-offset base ptrs src)
              [(OptSomeI64 base-offset)
                (match offset
                  [(IrValueI64 field-offset)
                    (opt-aggregate-scan-instrs
                      base
                      ty
                      size
                      (box-get rest)
                      (opt-aggregate-pointer-list-push
                        ptrs
                        (OptAggregatePointer dst (+ base-offset field-offset)))
                      accesses
                      true)]
                  [_ (OptAggregateScanReject)])]
              [(OptNoI64)
                (if (opt-aggregate-value-has-pointer? base ptrs offset)
                  (OptAggregateScanReject)
                  (opt-aggregate-scan-instrs
                    base
                    ty
                    size
                    (box-get rest)
                    ptrs
                    accesses
                    true))])]
          [(IrInstrLoad dst src load-ty)
            (match (opt-aggregate-value-offset base ptrs src)
              [(OptSomeI64 offset)
                (opt-aggregate-scan-instrs
                  base
                  ty
                  size
                  (box-get rest)
                  ptrs
                  (opt-aggregate-access-list-push
                    accesses
                    (OptAggregateLoad dst offset load-ty))
                  true)]
              [(OptNoI64)
                (if (opt-aggregate-instrs-touch-candidate?
                  (box-get rest)
                  base
                  ptrs)
                  (OptAggregateScanReject)
                  (opt-aggregate-scan-instrs
                    base
                    ty
                    size
                    (box-get rest)
                    ptrs
                    accesses
                    true))])]
          [(IrInstrStorePtr ptr value store-ty)
            (match (opt-aggregate-value-offset base ptrs ptr)
              [(OptSomeI64 offset)
                (if (opt-aggregate-value-has-pointer? base ptrs value)
                  (OptAggregateScanReject)
                  (opt-aggregate-scan-instrs
                    base
                    ty
                    size
                    (box-get rest)
                    ptrs
                    (opt-aggregate-access-list-push
                      accesses
                      (OptAggregateStore offset store-ty))
                    true))]
              [(OptNoI64)
                (if (or
                  (opt-aggregate-value-has-pointer? base ptrs value)
                  (and
                    (compiler-ir-effect-invalidates-cse?
                      (compiler-ir-instr-effect instr))
                    (opt-aggregate-instrs-touch-candidate?
                      (box-get rest)
                      base
                      ptrs)))
                  (OptAggregateScanReject)
                  (opt-aggregate-scan-instrs
                    base
                    ty
                    size
                    (box-get rest)
                    ptrs
                    accesses
                    true))])]
          [_
            (if (opt-aggregate-instr-has-pointer? instr base ptrs)
              (OptAggregateScanReject)
              (if (and
                (opt-aggregate-instr-crosses-unknown-effect? instr base ptrs)
                (opt-aggregate-instrs-touch-candidate? (box-get rest) base ptrs))
                (OptAggregateScanReject)
                (opt-aggregate-scan-instrs
                  base
                  ty
                  size
                  (box-get rest)
                  ptrs
                  accesses
                  true)))]))]))

(define (opt-aggregate-classify-one
  [base : i64]
  [ty : AstType]
  [size : i64]
  [instrs : CompilerIrInstrList]) : OptAggregateScanResult
  (opt-aggregate-scan-instrs
    base
    ty
    size
    instrs
    (opt-aggregate-pointer-list-with-capacity
      opt-aggregate-list-initial-capacity)
    (opt-aggregate-access-list-with-capacity
      opt-aggregate-list-initial-capacity)
    false))

(define (opt-aggregate-candidates-from-instrs
  [scan : CompilerIrInstrList]
  [candidates : OptAggregateAllocCandidateList]) : OptAggregateAllocCandidateList
  (match scan
    [(IrInstrNil) candidates]
    [(IrInstrCons instr rest)
      (match (opt-aggregate-direct-alloc instr)
        [(OptSomeAggregateAlloc base ty size)
          (match (opt-aggregate-classify-one base ty size scan)
            [(OptAggregateScanOk ptrs accesses)
              (opt-aggregate-candidates-from-instrs
                (box-get rest)
                (opt-aggregate-candidate-list-push
                  candidates
                  (OptAggregateAllocCandidate base ty size ptrs accesses)))]
            [(OptAggregateScanReject)
              (opt-aggregate-candidates-from-instrs (box-get rest) candidates)])]
        [(OptNoAggregateAlloc)
          (opt-aggregate-candidates-from-instrs (box-get rest) candidates)])]))

(define (opt-aggregate-instr-list-append
  [left : CompilerIrInstrList]
  [right : CompilerIrInstrList]) : CompilerIrInstrList
  (match left
    [(IrInstrNil) right]
    [(IrInstrCons head rest)
      (compiler-ir-instr-cons
        head
        (opt-aggregate-instr-list-append (box-get rest) right))]))

(define (opt-aggregate-instr-seq-append-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [right : CompilerIrInstrList]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    right
    (compiler-ir-instr-cons
      (compiler-ir-instr-seq-ref instrs index)
      (opt-aggregate-instr-seq-append-from instrs (+ index 1) right))))

(define (opt-aggregate-flatten-blocks [blocks : CompilerIrBlockList]) : CompilerIrInstrList
  (match blocks
    [(IrBlockNil) (IrInstrNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-aggregate-instr-seq-append-from
            instrs
            0
            (opt-aggregate-flatten-blocks (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-aggregate-flatten-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-aggregate-allocation-candidates-function
  [func : CompilerIrFunction]) : OptAggregateAllocCandidateList
  (match func
    [(IrFunction _ _ _ _ blocks)
      (let
        [instrs : CompilerIrInstrList (opt-aggregate-flatten-blocks blocks)]
        (opt-aggregate-candidates-from-instrs
          instrs
          (opt-aggregate-candidate-list-with-capacity
            opt-aggregate-list-initial-capacity)))]))

(define (opt-aggregate-candidate-list-append
  [left : OptAggregateAllocCandidateList]
  [right : OptAggregateAllocCandidateList]) : OptAggregateAllocCandidateList
  (let
    [left-count : i64 (struct-get left len)]
    [right-count : i64 (struct-get right len)]
    [total : i64 (+ left-count right-count)]
    [slots : (Array OptAggregateAllocCandidate)
      (make-array OptAggregateAllocCandidate total)]
    [i : i64 0]
    (begin
      (while (< i left-count)
        (begin
          (array-set! slots i (array-ref (struct-get left slots) i))
          (set! i (+ i 1))))
      (let
        [j : i64 0]
        (begin
          (while (< j right-count)
            (begin
              (array-set!
                slots
                (+ left-count j)
                (array-ref (struct-get right slots) j))
              (set! j (+ j 1))))
          (OptAggregateAllocCandidateList slots total))))))

(define (opt-aggregate-allocation-candidates-functions
  [functions : CompilerIrFunctionList]) : OptAggregateAllocCandidateList
  (match functions
    [(IrFunctionNil) (opt-aggregate-candidate-list-with-capacity 0)]
    [(IrFunctionCons func rest)
      (opt-aggregate-candidate-list-append
        (opt-aggregate-allocation-candidates-function func)
        (opt-aggregate-allocation-candidates-functions (box-get rest)))]
    [(IrFunctionArray seq)
      (opt-aggregate-allocation-candidates-functions
        (compiler-ir-function-seq-to-list seq))]))

(define (opt-aggregate-allocation-candidates [program : CompilerIrProgram]) : OptAggregateAllocCandidateList
  (match program
    [(IrProgram _ functions _)
      (opt-aggregate-allocation-candidates-functions functions)]))

(define (opt-aggregate-candidate-list-count
  [candidates : OptAggregateAllocCandidateList]) : i64
  (struct-get candidates len))

(define (opt-aggregate-pointer-list-count [ptrs : OptAggregatePointerList]) : i64
  (struct-get ptrs len))

(define (opt-aggregate-access-list-count [accesses : OptAggregateAccessList]) : i64
  (struct-get accesses len))

(define (opt-aggregate-access-list-load-count-from
  [accesses : OptAggregateAccessList]
  [index : i64]) : i64
  (if (>= index (struct-get accesses len))
    0
    (+
      (match (array-ref (struct-get accesses slots) index)
        [(OptAggregateLoad _ _ _) 1]
        [_ 0])
      (opt-aggregate-access-list-load-count-from accesses (+ index 1)))))

(define (opt-aggregate-access-list-load-count
  [accesses : OptAggregateAccessList]) : i64
  (opt-aggregate-access-list-load-count-from accesses 0))

(define (opt-aggregate-access-list-store-count-from
  [accesses : OptAggregateAccessList]
  [index : i64]) : i64
  (if (>= index (struct-get accesses len))
    0
    (+
      (match (array-ref (struct-get accesses slots) index)
        [(OptAggregateStore _ _) 1]
        [_ 0])
      (opt-aggregate-access-list-store-count-from accesses (+ index 1)))))

(define (opt-aggregate-access-list-store-count
  [accesses : OptAggregateAccessList]) : i64
  (opt-aggregate-access-list-store-count-from accesses 0))

;; --- aggregate stack promotion (#1489) --------------------------------------
;;
;; Reuse the non-escaping aggregate classifier, but keep this first promotion
;; slice conservative: only fixed handle-shaped structs/enums/tuples are moved
;; onto local frame storage. Dynamic arrays and array payloads stay heap-backed.
;;
;; The backend frame model exposes 8-byte slots. To preserve positive byte
;; offsets from the aggregate base, the address points at the lowest-addressed
;; reserved slot; offset +8 then walks back toward earlier reserved slots.
(define (opt-aggregate-stack-promote-type? [ty : AstType]) : bool
  (match ty
    [(AstTyStruct _) true]
    [(AstTyStructArgs _ _) true]
    [(AstTyEnum _) true]
    [(AstTyEnumArgs _ _) true]
    [(AstTyTuple _) true]
    [_ false]))

(define (opt-aggregate-stack-slot-count [size : i64]) : i64
  (/ (+ size 7) 8))

(define (opt-aggregate-promote-build
  [candidates : OptAggregateAllocCandidateList]
  [next-frame : i64]) : OptAggregatePromoteBuild
  (let
    [candidate-slots : (Array OptAggregateAllocCandidate)
      (struct-get candidates slots)]
    [candidate-count : i64 (struct-get candidates len)]
    [promote-slots : OptAggregatePromoteSlotList
      (opt-aggregate-promote-slot-list-with-capacity
        opt-aggregate-list-initial-capacity)]
    [frame : i64 next-frame]
    [index : i64 0]
    (begin
      (while (< index candidate-count)
        (begin
          (match (array-ref candidate-slots index)
            [(OptAggregateAllocCandidate base ty size _ _)
              (if (opt-aggregate-stack-promote-type? ty)
                (let
                  [slot-count : i64 (opt-aggregate-stack-slot-count size)]
                  [storage : i64 (+ frame (- slot-count 1))]
                  (begin
                    (set!
                      promote-slots
                      (opt-aggregate-promote-slot-list-push
                        promote-slots
                        (OptAggregatePromoteSlot base storage)))
                    (set! frame (+ frame slot-count))))
                unit)])
          (set! index (+ index 1))))
      (OptAggregatePromoteBuild promote-slots frame))))

(define (opt-aggregate-promote-lookup-from
  [slot-list : OptAggregatePromoteSlotList]
  [base : i64]
  [index : i64]) : OptMaybeI64
  (if (>= index (struct-get slot-list len))
    (OptNoI64)
    (match (array-ref (struct-get slot-list slots) index)
      [(OptAggregatePromoteSlot found storage)
        (if (= found base)
          (OptSomeI64 storage)
          (opt-aggregate-promote-lookup-from slot-list base (+ index 1)))])))

(define (opt-aggregate-promote-lookup
  [slots : OptAggregatePromoteSlotList]
  [base : i64]) : OptMaybeI64
  (opt-aggregate-promote-lookup-from slots base 0))

(define (opt-aggregate-promote-rewrite-instr
  [slots : OptAggregatePromoteSlotList]
  [instr : CompilerIrInstr]) : CompilerIrInstrList
  (match (opt-aggregate-direct-alloc instr)
    [(OptSomeAggregateAlloc base ty _)
      (match (opt-aggregate-promote-lookup slots base)
        [(OptSomeI64 storage)
          (compiler-ir-instr-cons
            (IrInstrAlloc storage ty)
            (compiler-ir-instr-cons (IrInstrAddrOf base storage) IrInstrNil))]
        [(OptNoI64) (compiler-ir-instr-cons instr IrInstrNil)])]
    [(OptNoAggregateAlloc) (compiler-ir-instr-cons instr IrInstrNil)]))

(define (opt-aggregate-promote-instrs
  [slots : OptAggregatePromoteSlotList]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (opt-aggregate-instr-list-append
        (opt-aggregate-promote-rewrite-instr slots instr)
        (opt-aggregate-promote-instrs slots (box-get rest)))]))

(define (opt-aggregate-promote-instr-seq-from
  [slots : OptAggregatePromoteSlotList]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [acc : CompilerIrInstrList]) : CompilerIrInstrList
  (if (< index 0)
    acc
    (opt-aggregate-promote-instr-seq-from
      slots
      instrs
      (- index 1)
      (opt-aggregate-instr-list-append
        (opt-aggregate-promote-rewrite-instr
          slots
          (compiler-ir-instr-seq-ref instrs index))
        acc))))

(define (opt-aggregate-promote-instr-seq
  [slots : OptAggregatePromoteSlotList]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-aggregate-promote-instr-seq-from
    slots
    instrs
    (- (compiler-ir-instr-seq-count instrs) 1)
    IrInstrNil))

(define (opt-aggregate-promote-block
  [slots : OptAggregatePromoteSlotList]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-aggregate-promote-instr-seq slots instrs))]))

(define (opt-aggregate-promote-blocks
  [slots : OptAggregatePromoteSlotList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (opt-aggregate-promote-block slots block)
        (opt-aggregate-promote-blocks slots (box-get rest)))]
    [(IrBlockArray seq)
      (opt-aggregate-promote-blocks slots (compiler-ir-block-seq-to-list seq))]))

(define (opt-aggregate-stack-promote-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret-ty frame blocks)
      (match (opt-aggregate-promote-build
        (opt-aggregate-allocation-candidates-function func)
        frame)
        [(OptAggregatePromoteBuild slots promoted-frame)
          (IrFunction
            name
            params
            ret-ty
            promoted-frame
            (opt-aggregate-promote-blocks slots blocks))])]))

;; --- aggregate field-load scalar replacement (SROA, #1562) -------------------
;; Replaces loads of fields from non-escaping aggregate allocations with the
;; scalar value last stored to that field. Runs after stack promotion so it
;; handles aggregates that promotion left in memory.
(define (opt-aggregate-scalar-replace-type? [ty : AstType]) : bool
  (if (opt-int-or-char-type? ty)
    true
    (match ty
      [(AstTyBool) true]
      [(AstTyUnit) true]
      [_ false])))

(define (opt-aggregate-candidate-location
  [candidate : OptAggregateAllocCandidate]
  [value : CompilerIrValue]) : OptAggregateLocation
  (match candidate
    [(OptAggregateAllocCandidate base _ _ ptrs _)
      (match (opt-aggregate-value-offset base ptrs value)
        [(OptSomeI64 offset) (OptSomeAggregateLocation base offset)]
        [(OptNoI64) (OptNoAggregateLocation)])]))

(define (opt-aggregate-location-for-value-from
  [candidates : OptAggregateAllocCandidateList]
  [value : CompilerIrValue]
  [index : i64]) : OptAggregateLocation
  (if (>= index (struct-get candidates len))
    (OptNoAggregateLocation)
    (match (opt-aggregate-candidate-location
      (array-ref (struct-get candidates slots) index)
      value)
      [(OptSomeAggregateLocation base offset)
        (OptSomeAggregateLocation base offset)]
      [(OptNoAggregateLocation)
        (opt-aggregate-location-for-value-from candidates value (+ index 1))])))

(define (opt-aggregate-location-for-value
  [candidates : OptAggregateAllocCandidateList]
  [value : CompilerIrValue]) : OptAggregateLocation
  (opt-aggregate-location-for-value-from candidates value 0))

(define (opt-aggregate-value-is-candidate-pointer?
  [candidates : OptAggregateAllocCandidateList]
  [value : CompilerIrValue]) : bool
  (match (opt-aggregate-location-for-value candidates value)
    [(OptSomeAggregateLocation _ _) true]
    [(OptNoAggregateLocation) false]))

(define (opt-aggregate-field-facts-unbind
  [facts : OptAggregateFieldFacts]
  [base : i64]
  [offset : i64]) : OptAggregateFieldFacts
  (match facts
    [(OptAggregateFieldNil) (OptAggregateFieldNil)]
    [(OptAggregateFieldCons fact-base fact-offset value ty rest)
      (let
        [rest2 : OptAggregateFieldFacts
          (opt-aggregate-field-facts-unbind (box-get rest) base offset)]
        (if (and (= fact-base base) (= fact-offset offset))
          rest2
          (OptAggregateFieldCons fact-base fact-offset value ty (box rest2))))]))

(define (opt-aggregate-field-facts-unbind-base
  [facts : OptAggregateFieldFacts]
  [base : i64]) : OptAggregateFieldFacts
  (match facts
    [(OptAggregateFieldNil) (OptAggregateFieldNil)]
    [(OptAggregateFieldCons fact-base fact-offset value ty rest)
      (let
        [rest2 : OptAggregateFieldFacts
          (opt-aggregate-field-facts-unbind-base (box-get rest) base)]
        (if (= fact-base base)
          rest2
          (OptAggregateFieldCons fact-base fact-offset value ty (box rest2))))]))

(define (opt-aggregate-field-facts-bind
  [facts : OptAggregateFieldFacts]
  [base : i64]
  [offset : i64]
  [value : CompilerIrValue]
  [ty : AstType]) : OptAggregateFieldFacts
  (OptAggregateFieldCons
    base
    offset
    value
    ty
    (box (opt-aggregate-field-facts-unbind facts base offset))))

(define (opt-aggregate-field-facts-lookup
  [facts : OptAggregateFieldFacts]
  [base : i64]
  [offset : i64]
  [ty : AstType]) : OptAggregateStoredValue
  (match facts
    [(OptAggregateFieldNil) (OptNoAggregateStoredValue)]
    [(OptAggregateFieldCons fact-base fact-offset value fact-ty rest)
      (if (and
        (= fact-base base)
        (= fact-offset offset)
        (opt-type-eq fact-ty ty))
        (OptSomeAggregateStoredValue value fact-ty)
        (opt-aggregate-field-facts-lookup (box-get rest) base offset ty))]))

(define (opt-aggregate-field-facts-invalidate-var
  [facts : OptAggregateFieldFacts]
  [var : i64]) : OptAggregateFieldFacts
  (match facts
    [(OptAggregateFieldNil) (OptAggregateFieldNil)]
    [(OptAggregateFieldCons base offset value ty rest)
      (let
        [rest2 : OptAggregateFieldFacts
          (opt-aggregate-field-facts-invalidate-var (box-get rest) var)]
        (if (or (= base var) (opt-value-is-var? value var))
          rest2
          (OptAggregateFieldCons base offset value ty (box rest2))))]))

(define (opt-aggregate-sroa-invalidate-def
  [facts : OptAggregateFieldFacts]
  [instr : CompilerIrInstr]) : OptAggregateFieldFacts
  (match instr
    [(IrInstrMov dst _ _) (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrAlloc dst _) (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrAddrOf dst _) (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrGep dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrLoad dst _ _) (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrCast dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrBitcast dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrBinOp dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrUnOp dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrLaneId dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrSplat dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(IrInstrVectorReduce dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(IrInstrMaskBinOp dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrMaskNot dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrMaskReduce dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(IrInstrVectorLoad dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (opt-aggregate-field-facts-invalidate-var facts dst)])]
    [(IrInstrTailMask dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrEntryArgc dst)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrEntryArgv dst)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrEntryEnvp dst)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrCpuId dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrXgetbv dst _) (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrSyscall dst _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrCall dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrCallIndirect dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrCallIndirectC dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(IrInstrPhi dst _ _) (opt-aggregate-field-facts-invalidate-var facts dst)]
    [_ facts]))

(define (opt-aggregate-sroa-store
  [candidates : OptAggregateAllocCandidateList]
  [facts : OptAggregateFieldFacts]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]
  [ty : AstType]
  [instr : CompilerIrInstr]) : OptAggregateSroaResult
  (match (opt-aggregate-location-for-value candidates ptr)
    [(OptSomeAggregateLocation base offset)
      (if (and
        (opt-aggregate-scalar-replace-type? ty)
        (opt-copy-safe-source? value)
        (not (opt-aggregate-value-is-candidate-pointer? candidates value)))
        (OptAggregateSroaResult
          (opt-aggregate-field-facts-bind facts base offset value ty)
          instr)
        (OptAggregateSroaResult
          (opt-aggregate-field-facts-unbind-base facts base)
          instr))]
    [(OptNoAggregateLocation)
      (OptAggregateSroaResult (OptAggregateFieldNil) instr)]))

(define (opt-aggregate-sroa-load
  [candidates : OptAggregateAllocCandidateList]
  [facts : OptAggregateFieldFacts]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]
  [instr : CompilerIrInstr]) : OptAggregateSroaResult
  (let
    [next-facts : OptAggregateFieldFacts
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    (match (opt-aggregate-location-for-value candidates src)
      [(OptSomeAggregateLocation base offset)
        (match (opt-aggregate-field-facts-lookup facts base offset ty)
          [(OptSomeAggregateStoredValue value _)
            (OptAggregateSroaResult next-facts (IrInstrMov dst value ty))]
          [(OptNoAggregateStoredValue)
            (OptAggregateSroaResult next-facts instr)])]
      [(OptNoAggregateLocation) (OptAggregateSroaResult next-facts instr)])))

(define (opt-aggregate-sroa-instr
  [candidates : OptAggregateAllocCandidateList]
  [facts : OptAggregateFieldFacts]
  [instr : CompilerIrInstr]) : OptAggregateSroaResult
  (match instr
    [(IrInstrStorePtr ptr value ty)
      (opt-aggregate-sroa-store candidates facts ptr value ty instr)]
    [(IrInstrLoad dst src ty)
      (opt-aggregate-sroa-load candidates facts dst src ty instr)]
    [_
      (let
        [def-facts : OptAggregateFieldFacts
          (opt-aggregate-sroa-invalidate-def facts instr)]
        (if (compiler-ir-effect-invalidates-cse?
          (compiler-ir-instr-effect instr))
          (OptAggregateSroaResult (OptAggregateFieldNil) instr)
          (OptAggregateSroaResult def-facts instr)))]))

(define (opt-aggregate-sroa-instrs
  [candidates : OptAggregateAllocCandidateList]
  [facts : OptAggregateFieldFacts]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (match (opt-aggregate-sroa-instr candidates facts instr)
        [(OptAggregateSroaResult next-facts next-instr)
          (compiler-ir-instr-cons
            next-instr
            (opt-aggregate-sroa-instrs candidates next-facts (box-get rest)))])]))

(define (opt-aggregate-sroa-instr-seq-from
  [candidates : OptAggregateAllocCandidateList]
  [facts : OptAggregateFieldFacts]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    IrInstrNil
    (match (opt-aggregate-sroa-instr
      candidates
      facts
      (compiler-ir-instr-seq-ref instrs index))
      [(OptAggregateSroaResult next-facts next-instr)
        (compiler-ir-instr-cons
          next-instr
          (opt-aggregate-sroa-instr-seq-from
            candidates
            next-facts
            instrs
            (+ index 1)))])))

(define (opt-aggregate-sroa-instr-seq
  [candidates : OptAggregateAllocCandidateList]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-aggregate-sroa-instr-seq-from candidates (OptAggregateFieldNil) instrs 0))

(define (opt-aggregate-sroa-block
  [candidates : OptAggregateAllocCandidateList]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-aggregate-sroa-instr-seq candidates instrs))]))

(define (opt-aggregate-sroa-blocks
  [candidates : OptAggregateAllocCandidateList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (opt-aggregate-sroa-block candidates block)
        (opt-aggregate-sroa-blocks candidates (box-get rest)))]
    [(IrBlockArray seq)
      (opt-aggregate-sroa-blocks candidates (compiler-ir-block-seq-to-list seq))]))

(define (opt-aggregate-sroa-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret-ty frame blocks)
      (let
        [candidates : OptAggregateAllocCandidateList
          (opt-aggregate-allocation-candidates-function func)]
        (IrFunction
          name
          params
          ret-ty
          frame
          (opt-aggregate-sroa-blocks candidates blocks)))]))

;; --- block-local common subexpression elimination (#546) --------------------
;;
;; Within a single basic block, track an available-expression table mapping a
;; pure scalar `BinOp`/`UnOp` expression (operator + operand values) or a
;; repeatable CPU feature probe to the var that first computed it. A later
;; identical expression is rewritten to an `IrInstrMov` from that earlier var.
;; Scope is intentionally block-local and only covers pure scalar arithmetic
;; plus process-stable `cpuid`/`xgetbv` results; memory ops are not CSE'd.
;;
;; Invalidation keeps this correct even though the IR is not strictly SSA: when
;; an instruction (re)defines a var, every table entry whose key references that
;; var as an operand, or whose result is that var, is dropped. Calls, stores
;; (`Store`/`StorePtr`), and all control-flow boundaries clear the whole table
;; (conservative, matching the spec). Commutative operands are NOT canonicalized
;; in this slice.
(defenum OptExprKey
  (OptBinKey CompilerIrBinOp CompilerIrValue CompilerIrValue AstType)
  (OptUnKey CompilerIrUnOp CompilerIrValue AstType)
  (OptCpuIdKey CompilerIrValue CompilerIrValue i64)
  (OptXgetbvKey CompilerIrValue))

(defenum OptExprTable
  (OptExprNil)
  (OptExprCons OptExprKey i64 (Box OptExprTable)))

(define (opt-binop-tag [op : CompilerIrBinOp]) : i64
  (match op
    [(IrBinAdd) 0]
    [(IrBinSub) 1]
    [(IrBinMul) 2]
    [(IrBinDiv) 3]
    [(IrBinMod) 4]
    [(IrBinSafeDiv) 5]
    [(IrBinSafeMod) 6]
    [(IrBinEq) 7]
    [(IrBinNe) 8]
    [(IrBinLt) 9]
    [(IrBinLe) 10]
    [(IrBinGt) 11]
    [(IrBinGe) 12]
    [(IrBinAnd) 13]
    [(IrBinOr) 14]
    [(IrBinBitAnd) 15]
    [(IrBinBitOr) 16]
    [(IrBinBitXor) 17]
    [(IrBinShl) 18]
    [(IrBinShr) 19]))

(define (opt-binop-eq [a : CompilerIrBinOp] [b : CompilerIrBinOp]) : bool
  (= (opt-binop-tag a) (opt-binop-tag b)))

(define (opt-unop-tag [op : CompilerIrUnOp]) : i64
  (match op
    [(IrUnNeg) 0]
    [(IrUnNot) 1]
    [(IrUnBitNot) 2]))

(define (opt-unop-eq [a : CompilerIrUnOp] [b : CompilerIrUnOp]) : bool
  (= (opt-unop-tag a) (opt-unop-tag b)))

(define (opt-mask-binop-tag [op : CompilerIrMaskBinOp]) : i64
  (match op
    [(IrMaskAnd) 0]
    [(IrMaskOr) 1]))

(define (opt-mask-binop-eq [a : CompilerIrMaskBinOp] [b : CompilerIrMaskBinOp]) : bool
  (= (opt-mask-binop-tag a) (opt-mask-binop-tag b)))

(define (opt-vector-reduce-tag [op : CompilerIrVectorReduceOp]) : i64
  (match op
    [(IrVectorReduceSum) 0]
    [(IrVectorReduceMin) 1]
    [(IrVectorReduceMax) 2]))

(define (opt-vector-reduce-eq
  [a : CompilerIrVectorReduceOp]
  [b : CompilerIrVectorReduceOp]) : bool
  (= (opt-vector-reduce-tag a) (opt-vector-reduce-tag b)))

(define (opt-mask-reduce-tag [op : CompilerIrMaskReduceOp]) : i64
  (match op
    [(IrMaskReduceAll) 0]
    [(IrMaskReduceAny) 1]))

(define (opt-mask-reduce-eq
  [a : CompilerIrMaskReduceOp]
  [b : CompilerIrMaskReduceOp]) : bool
  (= (opt-mask-reduce-tag a) (opt-mask-reduce-tag b)))

(define (opt-value-eq [a : CompilerIrValue] [b : CompilerIrValue]) : bool
  (match a
    [(IrValueVar ia)
      (match b
        [(IrValueVar ib) (= ia ib)]
        [_ false])]
    [(IrValueGlobal ga)
      (match b
        [(IrValueGlobal gb) (string-eq ga gb)]
        [_ false])]
    [(IrValueGlobalAddr ga)
      (match b
        [(IrValueGlobalAddr gb) (string-eq ga gb)]
        [_ false])]
    [(IrValueFunction fa)
      (match b
        [(IrValueFunction fb) (string-eq fa fb)]
        [_ false])]
    [(IrValueI64 na)
      (match b
        [(IrValueI64 nb) (= na nb)]
        [_ false])]
    [(IrValueF64 fa)
      (match b
        [(IrValueF64 fb) (= fa fb)]
        [_ false])]
    [(IrValueBool ba)
      (match b
        [(IrValueBool bb)
          (if ba
            bb
            (not bb))]
        [_ false])]
    [(IrValueChar ca)
      (match b
        [(IrValueChar cb) (= ca cb)]
        [_ false])]
    [(IrValueString sa)
      (match b
        [(IrValueString sb) (string-eq sa sb)]
        [_ false])]
    [(IrValueBytes sa)
      (match b
        [(IrValueBytes sb) (string-eq sa sb)]
        [_ false])]
    [(IrValueUnit)
      (match b
        [(IrValueUnit) true]
        [_ false])]))

(define (opt-type-list-eq [a : AstTypeList] [b : AstTypeList]) : bool
  (match a
    [(AstTypeNil)
      (match b
        [(AstTypeNil) true]
        [_ false])]
    [(AstTypeCons ah at)
      (let
        [ah : AstType (ty-node-get ah)]
        [at : AstTypeList (box-get at)]
        (match b
          [(AstTypeCons bh bt)
            (let
              [bh : AstType (ty-node-get bh)]
              [bt : AstTypeList (box-get bt)]
              (and (opt-type-eq ah bh) (opt-type-list-eq at bt)))]
          [_ false]))]))

(define (opt-lifetime-list-eq [a : AstLifetimeList] [b : AstLifetimeList]) : bool
  (match a
    [(AstLifetimeNil)
      (match b
        [(AstLifetimeNil) true]
        [_ false])]
    [(AstLifetimeCons a-head a-rest)
      (let
        [a-rest : AstLifetimeList (box-get a-rest)]
        (match b
          [(AstLifetimeCons b-head b-rest)
            (let
              [b-rest : AstLifetimeList (box-get b-rest)]
              (and
                (string-eq a-head b-head)
                (opt-lifetime-list-eq a-rest b-rest)))]
          [_ false]))]))

(define (opt-type-eq [a : AstType] [b : AstType]) : bool
  (match a
    [(AstTyI64)
      (match b
        [(AstTyI64) true]
        [_ false])]
    [(AstTyI32)
      (match b
        [(AstTyI32) true]
        [_ false])]
    [(AstTyI16)
      (match b
        [(AstTyI16) true]
        [_ false])]
    [(AstTyI8)
      (match b
        [(AstTyI8) true]
        [_ false])]
    [(AstTyU64)
      (match b
        [(AstTyU64) true]
        [_ false])]
    [(AstTyU32)
      (match b
        [(AstTyU32) true]
        [_ false])]
    [(AstTyU16)
      (match b
        [(AstTyU16) true]
        [_ false])]
    [(AstTyU8)
      (match b
        [(AstTyU8) true]
        [_ false])]
    [(AstTyF64)
      (match b
        [(AstTyF64) true]
        [_ false])]
    [(AstTyF32)
      (match b
        [(AstTyF32) true]
        [_ false])]
    [(AstTyBool)
      (match b
        [(AstTyBool) true]
        [_ false])]
    [(AstTyChar)
      (match b
        [(AstTyChar) true]
        [_ false])]
    [(AstTyString)
      (match b
        [(AstTyString) true]
        [_ false])]
    [(AstTyStr)
      (match b
        [(AstTyStr) true]
        [_ false])]
    [(AstTyBytes)
      (match b
        [(AstTyBytes) true]
        [_ false])]
    [(AstTyUnit)
      (match b
        [(AstTyUnit) true]
        [_ false])]
    [(AstTyNever)
      (match b
        [(AstTyNever) true]
        [_ false])]
    [(AstTyExpr)
      (match b
        [(AstTyExpr) true]
        [_ false])]
    [(AstTyExprList)
      (match b
        [(AstTyExprList) true]
        [_ false])]
    [(AstTyFunc a-params a-ret)
      (match b
        [(AstTyFunc b-params b-ret)
          (and
            (opt-type-list-eq (box-get a-params) (box-get b-params))
            (opt-type-eq (ty-node-get a-ret) (ty-node-get b-ret)))]
        [_ false])]
    [(AstTyTuple a-items)
      (match b
        [(AstTyTuple b-items)
          (opt-type-list-eq (box-get a-items) (box-get b-items))]
        [_ false])]
    [(AstTyArray a-item a-len)
      (match b
        [(AstTyArray b-item b-len)
          (and
            (= a-len b-len)
            (opt-type-eq (ty-node-get a-item) (ty-node-get b-item)))]
        [_ false])]
    [(AstTyDynArray a-item)
      (match b
        [(AstTyDynArray b-item)
          (opt-type-eq (ty-node-get a-item) (ty-node-get b-item))]
        [_ false])]
    [(AstTyBox a-item)
      (match b
        [(AstTyBox b-item)
          (opt-type-eq (ty-node-get a-item) (ty-node-get b-item))]
        [_ false])]
    [(AstTyPtr a-item)
      (match b
        [(AstTyPtr b-item)
          (opt-type-eq (ty-node-get a-item) (ty-node-get b-item))]
        [_ false])]
    [(AstTyMutPtr a-item)
      (match b
        [(AstTyMutPtr b-item)
          (opt-type-eq (ty-node-get a-item) (ty-node-get b-item))]
        [_ false])]
    [(AstTyRef a-region a-inner)
      (match b
        [(AstTyRef b-region b-inner)
          (and
            (string-eq a-region b-region)
            (opt-type-eq (ty-node-get a-inner) (ty-node-get b-inner)))]
        [_ false])]
    [(AstTyMutRef a-region a-inner)
      (match b
        [(AstTyMutRef b-region b-inner)
          (and
            (string-eq a-region b-region)
            (opt-type-eq (ty-node-get a-inner) (ty-node-get b-inner)))]
        [_ false])]
    [(AstTyRegion a-region a-inner)
      (match b
        [(AstTyRegion b-region b-inner)
          (and
            (string-eq a-region b-region)
            (opt-type-eq (ty-node-get a-inner) (ty-node-get b-inner)))]
        [_ false])]
    [(AstTyEnum a-name)
      (match b
        [(AstTyEnum b-name) (= a-name b-name)]
        [_ false])]
    [(AstTyEnumArgs a-name a-lifetimes)
      (match b
        [(AstTyEnumArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (opt-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstTyStruct a-name)
      (match b
        [(AstTyStruct b-name) (= a-name b-name)]
        [_ false])]
    [(AstTyStructArgs a-name a-lifetimes)
      (match b
        [(AstTyStructArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (opt-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstTyVar a-name)
      (match b
        [(AstTyVar b-name) (= a-name b-name)]
        [_ false])]
    [(AstTyVarArgs a-name a-lifetimes)
      (match b
        [(AstTyVarArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (opt-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]))

(define (opt-value-hash [value : CompilerIrValue]) : i64
  (match value
    [(IrValueVar id) (hash-combine 1 (hash-i64 id))]
    [(IrValueGlobal name) (hash-combine 2 (hash-string (& name)))]
    [(IrValueGlobalAddr name) (hash-combine 3 (hash-string (& name)))]
    [(IrValueFunction name) (hash-combine 4 (hash-string (& name)))]
    [(IrValueI64 value) (hash-combine 5 (hash-i64 value))]
    [(IrValueF64 value) (hash-combine 6 (hash-i64 (cast value : i64)))]
    [(IrValueBool value) (hash-combine 7 (hash-bool value))]
    [(IrValueChar value) (hash-combine 8 (hash-char value))]
    [(IrValueString value) (hash-combine 9 (hash-string (& value)))]
    [(IrValueBytes value) (hash-combine 11 (hash-string (& value)))]
    [(IrValueUnit) (hash-i64 10)]))

(define (opt-expr-key-hash [key : OptExprKey]) : i64
  (match key
    [(OptBinKey op lhs rhs ty)
      (hash-combine
        1
        (hash-combine
          (opt-type-hash ty)
          (hash-combine
            (hash-i64 (opt-binop-tag op))
            (hash-combine (opt-value-hash lhs) (opt-value-hash rhs)))))]
    [(OptUnKey op value ty)
      (hash-combine
        2
        (hash-combine
          (opt-type-hash ty)
          (hash-combine (hash-i64 (opt-unop-tag op)) (opt-value-hash value))))]
    [(OptCpuIdKey leaf subleaf reg-index)
      (hash-combine
        3
        (hash-combine
          (hash-i64 reg-index)
          (hash-combine (opt-value-hash leaf) (opt-value-hash subleaf))))]
    [(OptXgetbvKey index) (hash-combine 4 (opt-value-hash index))]))

(define (opt-type-list-hash [types : AstTypeList]) : i64
  (match types
    [(AstTypeNil) (hash-i64 0)]
    [(AstTypeCons head rest)
      (hash-combine
        1
        (hash-combine
          (opt-type-hash (ty-node-get head))
          (opt-type-list-hash (box-get rest))))]))

(define (opt-lifetime-list-hash [lifetimes : AstLifetimeList]) : i64
  (match lifetimes
    [(AstLifetimeNil) (hash-i64 0)]
    [(AstLifetimeCons head rest)
      (hash-combine
        1
        (hash-combine
          (hash-string (& head))
          (opt-lifetime-list-hash (box-get rest))))]))

(define (opt-type-hash [ty : AstType]) : i64
  (match ty
    [(AstTyI64) (hash-i64 1)]
    [(AstTyI32) (hash-i64 2)]
    [(AstTyI16) (hash-i64 3)]
    [(AstTyI8) (hash-i64 4)]
    [(AstTyU64) (hash-i64 5)]
    [(AstTyU32) (hash-i64 6)]
    [(AstTyU16) (hash-i64 7)]
    [(AstTyU8) (hash-i64 8)]
    [(AstTyF64) (hash-i64 9)]
    [(AstTyF32) (hash-i64 10)]
    [(AstTyBool) (hash-i64 11)]
    [(AstTyChar) (hash-i64 12)]
    [(AstTyString) (hash-i64 13)]
    [(AstTyStr) (hash-i64 14)]
    [(AstTyBytes) (hash-i64 35)]
    [(AstTyUnit) (hash-i64 15)]
    [(AstTyNever) (hash-i64 16)]
    [(AstTyExpr) (hash-i64 17)]
    [(AstTyExprList) (hash-i64 18)]
    [(AstTyFunc params ret)
      (hash-combine
        19
        (hash-combine
          (opt-type-list-hash (box-get params))
          (opt-type-hash (ty-node-get ret))))]
    [(AstTyTuple items) (hash-combine 20 (opt-type-list-hash (box-get items)))]
    [(AstTyArray item len)
      (hash-combine
        21
        (hash-combine (opt-type-hash (ty-node-get item)) (hash-i64 len)))]
    [(AstTyDynArray item) (hash-combine 22 (opt-type-hash (ty-node-get item)))]
    [(AstTyBox item) (hash-combine 23 (opt-type-hash (ty-node-get item)))]
    [(AstTyPtr item) (hash-combine 24 (opt-type-hash (ty-node-get item)))]
    [(AstTyMutPtr item) (hash-combine 25 (opt-type-hash (ty-node-get item)))]
    [(AstTyRef region inner)
      (hash-combine
        26
        (hash-combine
          (hash-string (& region))
          (opt-type-hash (ty-node-get inner))))]
    [(AstTyMutRef region inner)
      (hash-combine
        27
        (hash-combine
          (hash-string (& region))
          (opt-type-hash (ty-node-get inner))))]
    [(AstTyRegion region inner)
      (hash-combine
        28
        (hash-combine
          (hash-string (& region))
          (opt-type-hash (ty-node-get inner))))]
    [(AstTyEnum name) (hash-combine 29 (hash-i64 name))]
    [(AstTyEnumArgs name lifetimes)
      (hash-combine
        30
        (hash-combine
          (hash-i64 name)
          (opt-lifetime-list-hash (box-get lifetimes))))]
    [(AstTyStruct name) (hash-combine 31 (hash-i64 name))]
    [(AstTyStructArgs name lifetimes)
      (hash-combine
        32
        (hash-combine
          (hash-i64 name)
          (opt-lifetime-list-hash (box-get lifetimes))))]
    [(AstTyVar name) (hash-combine 33 (hash-i64 name))]
    [(AstTyVarArgs name lifetimes)
      (hash-combine
        34
        (hash-combine
          (hash-i64 name)
          (opt-lifetime-list-hash (box-get lifetimes))))]))

(define (opt-maybe-value-eq
  [a : CompilerIrMaybeValue]
  [b : CompilerIrMaybeValue]) : bool
  (match a
    [(IrNoValue)
      (match b
        [(IrNoValue) true]
        [_ false])]
    [(IrSomeValue av)
      (match b
        [(IrSomeValue bv) (opt-value-eq av bv)]
        [_ false])]))

(define (opt-value-list-eq [a : CompilerIrValueList] [b : CompilerIrValueList]) : bool
  (match a
    [(IrValueNil)
      (match b
        [(IrValueNil) true]
        [_ false])]
    [(IrValueCons ah at)
      (match b
        [(IrValueCons bh bt)
          (and
            (opt-value-eq ah bh)
            (opt-value-list-eq (box-get at) (box-get bt)))]
        [_ false])]))

(define (opt-call-args-array-eq
  [a : (Array CompilerIrValue)]
  [b : (Array CompilerIrValue)]
  [index : i64]) : bool
  (if (>= index (array-length a))
    true
    (and
      (opt-value-eq (array-ref a index) (array-ref b index))
      (opt-call-args-array-eq a b (+ index 1)))))

(define (opt-call-args-eq [a : CompilerIrCallArgs] [b : CompilerIrCallArgs]) : bool
  (match a
    [(IrCallArgsNil)
      (match b
        [(IrCallArgsNil) true]
        [_ false])]
    [(IrCallArgsOne av)
      (match b
        [(IrCallArgsOne bv) (opt-value-eq av bv)]
        [_ false])]
    [(IrCallArgsTwo aa ab)
      (match b
        [(IrCallArgsTwo ba bb) (and (opt-value-eq aa ba) (opt-value-eq ab bb))]
        [_ false])]
    [(IrCallArgsArray av)
      (match b
        [(IrCallArgsArray bv)
          (and
            (= (array-length av) (array-length bv))
            (opt-call-args-array-eq av bv 0))]
        [_ false])]))

(define (opt-phi-input-eq
  [av : CompilerIrValue]
  [alabel : String]
  [bv : CompilerIrValue]
  [blabel : String]) : bool
  (and (string-eq alabel blabel) (opt-value-eq av bv)))

(define (opt-phi-input-list-eq
  [a : CompilerIrPhiInputList]
  [b : CompilerIrPhiInputList]) : bool
  (match a
    [(IrPhiInputNil)
      (match b
        [(IrPhiInputNil) true]
        [_ false])]
    [(IrPhiInputCons av alabel at)
      (match b
        [(IrPhiInputCons bv blabel bt)
          (and
            (opt-phi-input-eq av alabel bv blabel)
            (opt-phi-input-list-eq (box-get at) (box-get bt)))]
        [_ false])]))

(define (opt-c-abi-return-slot-eq
  [a : CompilerIrCAbiReturnSlot]
  [b : CompilerIrCAbiReturnSlot]) : bool
  (match a
    [(IrCAbiReturnSlot aty aoffset)
      (match b
        [(IrCAbiReturnSlot bty boffset)
          (and (= aoffset boffset) (opt-type-eq aty bty))])]))

(define (opt-c-abi-return-slot-list-eq
  [a : CompilerIrCAbiReturnSlotList]
  [b : CompilerIrCAbiReturnSlotList]) : bool
  (match a
    [(IrCAbiReturnSlotNil)
      (match b
        [(IrCAbiReturnSlotNil) true]
        [_ false])]
    [(IrCAbiReturnSlotCons aslot arest)
      (match b
        [(IrCAbiReturnSlotCons bslot brest)
          (and
            (opt-c-abi-return-slot-eq aslot bslot)
            (opt-c-abi-return-slot-list-eq (box-get arest) (box-get brest)))]
        [_ false])]))

(define (opt-instr-eq [a : CompilerIrInstr] [b : CompilerIrInstr]) : bool
  (match a
    [(IrInstrMov ad av aty)
      (match b
        [(IrInstrMov bd bv bty)
          (and (= ad bd) (opt-value-eq av bv) (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrAlloc ad aty)
      (match b
        [(IrInstrAlloc bd bty) (and (= ad bd) (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrAddrOf ad av)
      (match b
        [(IrInstrAddrOf bd bv) (and (= ad bd) (= av bv))]
        [_ false])]
    [(IrInstrGep ad abase aoffset aty)
      (match b
        [(IrInstrGep bd bbase boffset bty)
          (and
            (= ad bd)
            (opt-value-eq abase bbase)
            (opt-value-eq aoffset boffset)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrLoad ad av aty)
      (match b
        [(IrInstrLoad bd bv bty)
          (and (= ad bd) (opt-value-eq av bv) (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrStorePtr aptr av aty)
      (match b
        [(IrInstrStorePtr bptr bv bty)
          (and
            (opt-value-eq aptr bptr)
            (opt-value-eq av bv)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrCopyBytes adst asrc asize)
      (match b
        [(IrInstrCopyBytes bdst bsrc bsize)
          (and
            (= asize bsize)
            (opt-value-eq adst bdst)
            (opt-value-eq asrc bsrc))]
        [_ false])]
    [(IrInstrCast ad av afrom ato)
      (match b
        [(IrInstrCast bd bv bfrom bto)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq afrom bfrom)
            (opt-type-eq ato bto))]
        [_ false])]
    [(IrInstrBitcast ad av afrom ato)
      (match b
        [(IrInstrBitcast bd bv bfrom bto)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq afrom bfrom)
            (opt-type-eq ato bto))]
        [_ false])]
    [(IrInstrBinOp ad aop al ar aty)
      (match b
        [(IrInstrBinOp bd bop bl br bty)
          (and
            (= ad bd)
            (opt-binop-eq aop bop)
            (opt-value-eq al bl)
            (opt-value-eq ar br)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrUnOp ad aop av aty)
      (match b
        [(IrInstrUnOp bd bop bv bty)
          (and
            (= ad bd)
            (opt-unop-eq aop bop)
            (opt-value-eq av bv)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrLaneId ad alanes aty)
      (match b
        [(IrInstrLaneId bd blanes bty)
          (and (= ad bd) (= alanes blanes) (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrSplat ad av alanes aty)
      (match b
        [(IrInstrSplat bd bv blanes bty)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (= alanes blanes)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload ad aop al ar alanes aty)
          (match b
            [(IrInstrVectorBinOp other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrVectorBinOpPayload bd bop bl br blanes bty)
                  (and
                    (= ad bd)
                    (opt-binop-eq aop bop)
                    (opt-value-eq al bl)
                    (opt-value-eq ar br)
                    (= alanes blanes)
                    (opt-type-eq aty bty))])]
            [_ false])])]
    [(IrInstrVectorReduce ad aop av alanes aty)
      (match b
        [(IrInstrVectorReduce bd bop bv blanes bty)
          (and
            (= ad bd)
            (opt-vector-reduce-eq aop bop)
            (opt-value-eq av bv)
            (= alanes blanes)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload ad aop al ar alanes aty)
          (match b
            [(IrInstrVectorCompare other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrVectorComparePayload bd bop bl br blanes bty)
                  (and
                    (= ad bd)
                    (opt-binop-eq aop bop)
                    (opt-value-eq al bl)
                    (opt-value-eq ar br)
                    (= alanes blanes)
                    (opt-type-eq aty bty))])]
            [_ false])])]
    [(IrInstrMaskBinOp ad aop al ar alanes)
      (match b
        [(IrInstrMaskBinOp bd bop bl br blanes)
          (and
            (= ad bd)
            (opt-mask-binop-eq aop bop)
            (opt-value-eq al bl)
            (opt-value-eq ar br)
            (= alanes blanes))]
        [_ false])]
    [(IrInstrMaskNot ad av alanes)
      (match b
        [(IrInstrMaskNot bd bv blanes)
          (and (= ad bd) (opt-value-eq av bv) (= alanes blanes))]
        [_ false])]
    [(IrInstrMaskReduce ad aop av alanes)
      (match b
        [(IrInstrMaskReduce bd bop bv blanes)
          (and
            (= ad bd)
            (opt-mask-reduce-eq aop bop)
            (opt-value-eq av bv)
            (= alanes blanes))]
        [_ false])]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload ad amask at af alanes aty)
          (match b
            [(IrInstrSelect other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrSelectPayload bd bmask bt bf blanes bty)
                  (and
                    (= ad bd)
                    (opt-value-eq amask bmask)
                    (opt-value-eq at bt)
                    (opt-value-eq af bf)
                    (= alanes blanes)
                    (opt-type-eq aty bty))])]
            [_ false])])]
    [(IrInstrVectorLoad ad abase aindex alanes aty)
      (match b
        [(IrInstrVectorLoad bd bbase bindex blanes bty)
          (and
            (= ad bd)
            (opt-value-eq abase bbase)
            (opt-value-eq aindex bindex)
            (= alanes blanes)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload abase aindex av alanes aty)
          (match b
            [(IrInstrVectorStore other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrVectorStorePayload bbase bindex bv blanes bty)
                  (and
                    (opt-value-eq abase bbase)
                    (opt-value-eq aindex bindex)
                    (opt-value-eq av bv)
                    (= alanes blanes)
                    (opt-type-eq aty bty))])]
            [_ false])])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload
            abase
            aindex
            av
            amask
            alanes
            aty)
          (match b
            [(IrInstrPredicatedStore other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrPredicatedStorePayload
                    bbase
                    bindex
                    bv
                    bmask
                    blanes
                    bty)
                  (and
                    (opt-value-eq abase bbase)
                    (opt-value-eq aindex bindex)
                    (opt-value-eq av bv)
                    (opt-value-eq amask bmask)
                    (= alanes blanes)
                    (opt-type-eq aty bty))])]
            [_ false])])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload ad abase aindex amask alanes aty)
          (match b
            [(IrInstrPredicatedLoad other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrPredicatedLoadPayload
                    bd
                    bbase
                    bindex
                    bmask
                    blanes
                    bty)
                  (and
                    (= ad bd)
                    (opt-value-eq abase bbase)
                    (opt-value-eq aindex bindex)
                    (opt-value-eq amask bmask)
                    (= alanes blanes)
                    (opt-type-eq aty bty))])]
            [_ false])])]
    [(IrInstrTailMask ad aindex alength alanes)
      (match b
        [(IrInstrTailMask bd bindex blength blanes)
          (and
            (= ad bd)
            (opt-value-eq aindex bindex)
            (opt-value-eq alength blength)
            (= alanes blanes))]
        [_ false])]
    [(IrInstrEntryArgc ad)
      (match b
        [(IrInstrEntryArgc bd) (= ad bd)]
        [_ false])]
    [(IrInstrEntryArgv ad)
      (match b
        [(IrInstrEntryArgv bd) (= ad bd)]
        [_ false])]
    [(IrInstrEntryEnvp ad)
      (match b
        [(IrInstrEntryEnvp bd) (= ad bd)]
        [_ false])]
    [(IrInstrCpuId ad aleaf asubleaf areg)
      (match b
        [(IrInstrCpuId bd bleaf bsubleaf breg)
          (and
            (= ad bd)
            (opt-value-eq aleaf bleaf)
            (opt-value-eq asubleaf bsubleaf)
            (= areg breg))]
        [_ false])]
    [(IrInstrXgetbv ad aindex)
      (match b
        [(IrInstrXgetbv bd bindex) (and (= ad bd) (opt-value-eq aindex bindex))]
        [_ false])]
    [(IrInstrSyscall ad aargs)
      (match b
        [(IrInstrSyscall bd bargs)
          (and (= ad bd) (opt-call-args-eq aargs bargs))]
        [_ false])]
    [(IrInstrCall ad aname aargs aty)
      (match b
        [(IrInstrCall bd bname bargs bty)
          (and
            (= ad bd)
            (string-eq aname bname)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrCallIndirect ad afunc aargs aty)
      (match b
        [(IrInstrCallIndirect bd bfunc bargs bty)
          (and
            (= ad bd)
            (opt-value-eq afunc bfunc)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrCallIndirectC ad afunc aargs aty)
      (match b
        [(IrInstrCallIndirectC bd bfunc bargs bty)
          (and
            (= ad bd)
            (opt-value-eq afunc bfunc)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload abase aname aargs aslots)
          (match b
            [(IrInstrCallCAbiStoreResult other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrCallCAbiStoreResultPayload
                    bbase
                    bname
                    bargs
                    bslots)
                  (and
                    (opt-value-eq abase bbase)
                    (string-eq aname bname)
                    (opt-call-args-eq aargs bargs)
                    (opt-c-abi-return-slot-list-eq aslots bslots))])]
            [_ false])])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload
            abase
            afunc
            aargs
            aslots)
          (match b
            [(IrInstrCallIndirectCAbiStoreResult other-payload-box)
              (match (box-get other-payload-box)
                [(CompilerIrInstrCallIndirectCAbiStoreResultPayload
                    bbase
                    bfunc
                    bargs
                    bslots)
                  (and
                    (opt-value-eq abase bbase)
                    (opt-value-eq afunc bfunc)
                    (opt-call-args-eq aargs bargs)
                    (opt-c-abi-return-slot-list-eq aslots bslots))])]
            [_ false])])]
    [(IrInstrTailCall aname aargs aty)
      (match b
        [(IrInstrTailCall bname bargs bty)
          (and
            (string-eq aname bname)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrTailCallIndirect afunc aargs aty)
      (match b
        [(IrInstrTailCallIndirect bfunc bargs bty)
          (and
            (opt-value-eq afunc bfunc)
            (opt-call-args-eq aargs bargs)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrStore aname av aty)
      (match b
        [(IrInstrStore bname bv bty)
          (and
            (string-eq aname bname)
            (opt-value-eq av bv)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrBoundsCheck aindex alength alabel)
      (match b
        [(IrInstrBoundsCheck bindex blength blabel)
          (and
            (opt-value-eq aindex bindex)
            (opt-value-eq alength blength)
            (string-eq alabel blabel))]
        [_ false])]
    [(IrInstrJump alabel)
      (match b
        [(IrInstrJump blabel) (string-eq alabel blabel)]
        [_ false])]
    [(IrInstrBranch av at bt)
      (match b
        [(IrInstrBranch bv af bf)
          (and (string-eq at af) (string-eq bt bf) (opt-value-eq av bv))]
        [_ false])]
    [(IrInstrReturn av)
      (match b
        [(IrInstrReturn bv) (opt-maybe-value-eq av bv)]
        [_ false])]
    [(IrInstrPhi ad ainputs aty)
      (match b
        [(IrInstrPhi bd binputs bty)
          (and
            (= ad bd)
            (opt-phi-input-list-eq ainputs binputs)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrPack ad awords aty)
      (match b
        [(IrInstrPack bd bwords bty)
          (and
            (= ad bd)
            (opt-value-list-eq awords bwords)
            (opt-type-eq aty bty))]
        [_ false])]
    [(IrInstrWord ad asrc ai aty)
      (match b
        [(IrInstrWord bd bsrc bi bty)
          (and
            (= ad bd)
            (opt-value-eq asrc bsrc)
            (= ai bi)
            (opt-type-eq aty bty))]
        [_ false])]))

(define (opt-instr-list-eq [a : CompilerIrInstrList] [b : CompilerIrInstrList]) : bool
  (match a
    [(IrInstrNil)
      (match b
        [(IrInstrNil) true]
        [_ false])]
    [(IrInstrCons ah at)
      (match b
        [(IrInstrCons bh bt)
          (and
            (opt-instr-eq ah bh)
            (opt-instr-list-eq (box-get at) (box-get bt)))]
        [_ false])]))

(define (opt-block-eq [a : CompilerIrBlock] [b : CompilerIrBlock]) : bool
  (match a
    [(IrBlock alabel ainstrs)
      (match b
        [(IrBlock blabel binstrs)
          (and
            (string-eq alabel blabel)
            (opt-instr-list-eq
              (compiler-ir-instr-seq-to-list ainstrs)
              (compiler-ir-instr-seq-to-list binstrs)))])]))

(define (opt-block-list-eq [a : CompilerIrBlockList] [b : CompilerIrBlockList]) : bool
  (match a
    [(IrBlockNil)
      (match b
        [(IrBlockNil) true]
        [_ false])]
    [(IrBlockCons ah at)
      (match b
        [(IrBlockCons bh bt)
          (and
            (opt-block-eq ah bh)
            (opt-block-list-eq (box-get at) (box-get bt)))]
        [(IrBlockArray seq)
          (opt-block-list-eq a (compiler-ir-block-seq-to-list seq))]
        [_ false])]
    [(IrBlockArray seq)
      (opt-block-list-eq (compiler-ir-block-seq-to-list seq) b)]))

(define (opt-param-eq [a : CompilerIrParam] [b : CompilerIrParam]) : bool
  (match a
    [(IrParam aname aty aid)
      (match b
        [(IrParam bname bty bid)
          (and (string-eq aname bname) (= aid bid) (opt-type-eq aty bty))])]))

(define (opt-param-list-eq [a : CompilerIrParamList] [b : CompilerIrParamList]) : bool
  (match a
    [(IrParamNil)
      (match b
        [(IrParamNil) true]
        [_ false])]
    [(IrParamCons ah at)
      (match b
        [(IrParamCons bh bt)
          (and
            (opt-param-eq ah bh)
            (opt-param-list-eq (box-get at) (box-get bt)))]
        [_ false])]))

(define (opt-function-eq [a : CompilerIrFunction] [b : CompilerIrFunction]) : bool
  (match a
    [(IrFunction aname aparams aret aframe ablocks)
      (match b
        [(IrFunction bname bparams bret bframe bblocks)
          (and
            (string-eq aname bname)
            (= aframe bframe)
            (opt-param-list-eq aparams bparams)
            (opt-type-eq aret bret)
            (opt-block-list-eq ablocks bblocks))])]))

(define (opt-function-list-eq
  [a : CompilerIrFunctionList]
  [b : CompilerIrFunctionList]) : bool
  (match a
    [(IrFunctionNil)
      (match b
        [(IrFunctionNil) true]
        [_ false])]
    [(IrFunctionCons ah at)
      (match b
        [(IrFunctionCons bh bt)
          (and
            (opt-function-eq ah bh)
            (opt-function-list-eq (box-get at) (box-get bt)))]
        [(IrFunctionArray bseq)
          (opt-function-list-eq a (compiler-ir-function-seq-to-list bseq))]
        [_ false])]
    [(IrFunctionArray aseq)
      (opt-function-list-eq (compiler-ir-function-seq-to-list aseq) b)]))

(define (opt-global-eq [a : CompilerIrGlobal] [b : CompilerIrGlobal]) : bool
  (match a
    [(IrGlobal aname aty avalue)
      (match b
        [(IrGlobal bname bty bvalue)
          (and
            (string-eq aname bname)
            (opt-type-eq aty bty)
            (opt-value-eq avalue bvalue))])]))

(define (opt-global-list-eq
  [a : CompilerIrGlobalList]
  [b : CompilerIrGlobalList]) : bool
  (match a
    [(IrGlobalNil)
      (match b
        [(IrGlobalNil) true]
        [_ false])]
    [(IrGlobalCons ah at)
      (match b
        [(IrGlobalCons bh bt)
          (and
            (opt-global-eq ah bh)
            (opt-global-list-eq (box-get at) (box-get bt)))]
        [_ false])]))

(define (opt-extern-eq [a : CompilerIrExtern] [b : CompilerIrExtern]) : bool
  (match a
    [(IrExtern aname aty aabi asymbol alinks aprovided)
      (match b
        [(IrExtern bname bty babi bsymbol blinks bprovided)
          (and
            (string-eq aname bname)
            (opt-type-eq aty bty)
            (ast-extern-abi-eq? aabi babi)
            (string-eq asymbol bsymbol)
            (ast-extern-link-input-list-eq? alinks blinks)
            (= aprovided bprovided))])]))

(define (opt-extern-list-eq
  [a : CompilerIrExternList]
  [b : CompilerIrExternList]) : bool
  (match a
    [(IrExternNil)
      (match b
        [(IrExternNil) true]
        [_ false])]
    [(IrExternCons ah at)
      (match b
        [(IrExternCons bh bt)
          (and
            (opt-extern-eq ah bh)
            (opt-extern-list-eq (box-get at) (box-get bt)))]
        [_ false])]))

(define (opt-program-eq [a : CompilerIrProgram] [b : CompilerIrProgram]) : bool
  (match a
    [(IrProgram aglobals afunctions aexterns)
      (match b
        [(IrProgram bglobals bfunctions bexterns)
          (and
            (opt-global-list-eq aglobals bglobals)
            (opt-function-list-eq afunctions bfunctions)
            (opt-extern-list-eq aexterns bexterns))])]))

(define (opt-expr-key-eq [a : OptExprKey] [b : OptExprKey]) : bool
  (match a
    [(OptBinKey opa la ra ta)
      (match b
        [(OptBinKey opb lb rb tb)
          (and
            (opt-binop-eq opa opb)
            (opt-type-eq ta tb)
            (opt-value-eq la lb)
            (opt-value-eq ra rb))]
        [_ false])]
    [(OptUnKey opa va ta)
      (match b
        [(OptUnKey opb vb tb)
          (and (opt-unop-eq opa opb) (opt-type-eq ta tb) (opt-value-eq va vb))]
        [_ false])]
    [(OptCpuIdKey aleaf asubleaf areg)
      (match b
        [(OptCpuIdKey bleaf bsubleaf breg)
          (and
            (= areg breg)
            (opt-value-eq aleaf bleaf)
            (opt-value-eq asubleaf bsubleaf))]
        [_ false])]
    [(OptXgetbvKey aindex)
      (match b
        [(OptXgetbvKey bindex) (opt-value-eq aindex bindex)]
        [_ false])]))

(define (opt-expr-lookup [table : OptExprTable] [key : OptExprKey]) : CompilerIrMaybeValue
  (match table
    [(OptExprNil) (IrNoValue)]
    [(OptExprCons k var rest)
      (let
        [rest : OptExprTable (box-get rest)]
        (if (opt-expr-key-eq k key)
          (IrSomeValue (IrValueVar var))
          (opt-expr-lookup rest key)))]))

(define (opt-value-is-var? [value : CompilerIrValue] [var : i64]) : bool
  (match value
    [(IrValueVar id) (= id var)]
    [_ false]))

(define (opt-key-uses-var? [key : OptExprKey] [var : i64]) : bool
  (match key
    [(OptBinKey _ l r _)
      (or (opt-value-is-var? l var) (opt-value-is-var? r var))]
    [(OptUnKey _ v _) (opt-value-is-var? v var)]
    [(OptCpuIdKey leaf subleaf _)
      (or (opt-value-is-var? leaf var) (opt-value-is-var? subleaf var))]
    [(OptXgetbvKey index) (opt-value-is-var? index var)]))

;; Drop every entry whose key references `var` (a stale operand) or whose result
;; is `var` (a stale definition).
(define (opt-expr-invalidate-var [table : OptExprTable] [var : i64]) : OptExprTable
  (match table
    [(OptExprNil) (OptExprNil)]
    [(OptExprCons k v rest)
      (let
        [rest2 : OptExprTable (opt-expr-invalidate-var (box-get rest) var)]
        (if (or (opt-key-uses-var? k var) (= v var))
          rest2
          (OptExprCons k v (box rest2))))]))

(defenum OptCseResult
  (OptCseResult OptExprTable CompilerIrInstr))

(define (opt-cse-instr [table : OptExprTable] [instr : CompilerIrInstr]) : OptCseResult
  (match instr
    [(IrInstrBinOp dst op l r ty)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptBinKey op l r ty)]
        (match (opt-expr-lookup t1 key)
          [(IrSomeValue earlier) (OptCseResult t1 (IrInstrMov dst earlier ty))]
          [(IrNoValue) (OptCseResult (OptExprCons key dst (box t1)) instr)]))]
    [(IrInstrUnOp dst op v ty)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptUnKey op v ty)]
        (match (opt-expr-lookup t1 key)
          [(IrSomeValue earlier) (OptCseResult t1 (IrInstrMov dst earlier ty))]
          [(IrNoValue) (OptCseResult (OptExprCons key dst (box t1)) instr)]))]
    [(IrInstrCpuId dst leaf subleaf reg-index)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptCpuIdKey leaf subleaf reg-index)]
        (match (opt-expr-lookup t1 key)
          [(IrSomeValue earlier)
            (OptCseResult t1 (IrInstrMov dst earlier (AstTyI64)))]
          [(IrNoValue) (OptCseResult (OptExprCons key dst (box t1)) instr)]))]
    [(IrInstrXgetbv dst index)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptXgetbvKey index)]
        (match (opt-expr-lookup t1 key)
          [(IrSomeValue earlier)
            (OptCseResult t1 (IrInstrMov dst earlier (AstTyI64)))]
          [(IrNoValue) (OptCseResult (OptExprCons key dst (box t1)) instr)]))]
    ;; Other defining instructions: invalidate their dst, keep the instruction.
    [(IrInstrMov dst _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrAlloc dst _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrAddrOf dst _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrGep dst _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrLoad dst _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrCast dst _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrBitcast dst _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrPhi dst _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrLaneId dst _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrSplat dst _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (OptCseResult (opt-expr-invalidate-var table dst) instr)])]
    [(IrInstrVectorReduce dst _ _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (OptCseResult (opt-expr-invalidate-var table dst) instr)])]
    [(IrInstrMaskBinOp dst _ _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrMaskNot dst _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrMaskReduce dst _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (OptCseResult (opt-expr-invalidate-var table dst) instr)])]
    [(IrInstrVectorLoad dst _ _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (OptCseResult (opt-expr-invalidate-var table dst) instr)])]
    [(IrInstrTailMask dst _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrEntryArgc dst)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrEntryArgv dst)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrEntryEnvp dst)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    ;; Calls, stores, and control flow clear all available expressions.
    [(IrInstrSyscall _ _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrCall _ _ _ _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrCallIndirect _ _ _ _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrCallIndirectC _ _ _ _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload _ _ _ _)
          (OptCseResult (OptExprNil) instr)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload _ _ _ _)
          (OptCseResult (OptExprNil) instr)])]
    [(IrInstrTailCall _ _ _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrStore _ _ _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrStorePtr _ _ _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrCopyBytes _ _ _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload _ _ _ _ _)
          (OptCseResult (OptExprNil) instr)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload _ _ _ _ _ _)
          (OptCseResult (OptExprNil) instr)])]
    [(IrInstrBoundsCheck _ _ _) (OptCseResult table instr)]
    [(IrInstrJump _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrBranch _ _ _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrReturn _) (OptCseResult (OptExprNil) instr)]
    [(IrInstrTailCallIndirect _ _ _) (OptCseResult (OptExprNil) instr)]
    ;; #2386: register-group ops are plain defining instructions -- invalidate
    ;; their dst, keep the instruction (no CSE key for them yet).
    [(IrInstrPack dst _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]
    [(IrInstrWord dst _ _ _)
      (OptCseResult (opt-expr-invalidate-var table dst) instr)]))

(define (opt-cse-instrs [table : OptExprTable] [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (match (opt-cse-instr table instr)
        [(OptCseResult new-table new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-cse-instrs new-table (box-get rest)))])]))

;; --- block-local copy propagation (#545) ------------------------------------
;;
;; The lowerer and the CSE pass both materialize values through `IrInstrMov`
;; into fresh vars (CSE rewrites a redundant expression to `Mov dst earlier`).
;; Within a single basic block, track copies `dst -> source` and rewrite later
;; operand uses of `IrValueVar dst` to `source`, so DCE can then drop the now
;; unused copy. This needs no register allocation or CFG dataflow.
;;
;; Conservative for the first slice: only `IrValueVar` and unambiguous scalar
;; literals are recorded as copy sources (`IrValueF64`, `IrValueString`, and
;; globals are excluded until their backend paths are settled); `IrInstrPhi`
;; inputs belong to predecessor edges and are never rewritten; and `IrInstrAddrOf`
;; carries a raw var id (a storage slot), not a value operand, so it is left
;; alone. On any instruction that defines var `v`, both the mapping for `v` and
;; any mapping whose source is `IrValueVar v` are dropped, so a reused var id in
;; the non-SSA IR never triggers a stale rewrite.
(defenum OptCopyEnv
  (OptCopyNil)
  (OptCopyCons i64 CompilerIrValue (Box OptCopyEnv))
  (OptCopyPackWordCons i64 i64 CompilerIrValue (Box OptCopyEnv)))

(define (opt-copy-lookup [env : OptCopyEnv] [var : i64]) : CompilerIrMaybeValue
  (match env
    [(OptCopyNil) (IrNoValue)]
    [(OptCopyCons id value rest)
      (let
        [rest : OptCopyEnv (box-get rest)]
        (if (= id var)
          (IrSomeValue value)
          (opt-copy-lookup rest var)))]
    [(OptCopyPackWordCons _ _ _ rest) (opt-copy-lookup (box-get rest) var)]))

(define (opt-copy-pack-word-lookup
  [env : OptCopyEnv]
  [group : i64]
  [index : i64]) : CompilerIrMaybeValue
  (match env
    [(OptCopyNil) (IrNoValue)]
    [(OptCopyCons _ _ rest)
      (opt-copy-pack-word-lookup (box-get rest) group index)]
    [(OptCopyPackWordCons found-group found-index value rest)
      (if (and (= found-group group) (= found-index index))
        (IrSomeValue value)
        (opt-copy-pack-word-lookup (box-get rest) group index))]))

;; Drop the mapping for `var` and any mapping whose replacement is `IrValueVar
;; var`, so redefining either a copied destination or a copied source clears the
;; stale copy fact.
(define (opt-copy-invalidate-var [env : OptCopyEnv] [var : i64]) : OptCopyEnv
  (match env
    [(OptCopyNil) (OptCopyNil)]
    [(OptCopyCons id value rest)
      (let
        [rest2 : OptCopyEnv (opt-copy-invalidate-var (box-get rest) var)]
        (if (or (= id var) (opt-value-is-var? value var))
          rest2
          (OptCopyCons id value (box rest2))))]
    [(OptCopyPackWordCons group index value rest)
      (let
        [rest2 : OptCopyEnv (opt-copy-invalidate-var (box-get rest) var)]
        (if (or (= group var) (opt-value-is-var? value var))
          rest2
          (OptCopyPackWordCons group index value (box rest2))))]))

;; Only var copies and unambiguous scalar literals are safe to propagate in this
;; slice; F64/String/global sources stay put until their backend paths exist.
(define (opt-copy-safe-source? [value : CompilerIrValue]) : bool
  (match value
    [(IrValueVar _) true]
    [(IrValueI64 _) true]
    [(IrValueBool _) true]
    [(IrValueChar _) true]
    [(IrValueUnit) true]
    [(IrValueF64 _) false]
    [(IrValueString _) false]
    [(IrValueBytes _) false]
    [(IrValueGlobal _) false]
    [(IrValueGlobalAddr _) false]
    [(IrValueFunction _) false]))

(define (opt-copy-add-pack-word
  [env : OptCopyEnv]
  [group : i64]
  [index : i64]
  [value : CompilerIrValue]) : OptCopyEnv
  (if (and (opt-copy-safe-source? value) (not (opt-value-is-var? value group)))
    (OptCopyPackWordCons group index value (box env))
    env))

(define (opt-copy-update-pack-env
  [env : OptCopyEnv]
  [dst : i64]
  [words : CompilerIrValueList]) : OptCopyEnv
  (let
    [e1 : OptCopyEnv (opt-copy-invalidate-var env dst)]
    (match words
      [(IrValueNil) e1]
      [(IrValueCons w0 rest0)
        (let
          [e2 : OptCopyEnv (opt-copy-add-pack-word e1 dst 0 w0)]
          (match (box-get rest0)
            [(IrValueNil) e2]
            [(IrValueCons w1 _) (opt-copy-add-pack-word e2 dst 1 w1)]))])))

(define (opt-copy-mask-source? [value : CompilerIrValue] [dst : i64]) : bool
  (match value
    [(IrValueVar _) (not (opt-value-is-var? value dst))]
    [_ false]))

(define (opt-copy-resolve [env : OptCopyEnv] [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(IrValueVar id)
      (match (opt-copy-lookup env id)
        [(IrSomeValue v) v]
        [(IrNoValue) value])]
    [_ value]))

(define (opt-copy-resolve-mask [env : OptCopyEnv] [value : CompilerIrValue]) : CompilerIrValue
  (let
    [resolved : CompilerIrValue (opt-copy-resolve env value)]
    (match resolved
      [(IrValueVar _) resolved]
      [_ value])))

(define (opt-copy-subst-value-list
  [env : OptCopyEnv]
  [values : CompilerIrValueList]) : CompilerIrValueList
  (match values
    [(IrValueNil) (IrValueNil)]
    [(IrValueCons value rest)
      (compiler-ir-value-cons
        (opt-copy-resolve env value)
        (opt-copy-subst-value-list env (box-get rest)))]))

(define (opt-copy-subst-call-args-array
  [env : OptCopyEnv]
  [src : (Array CompilerIrValue)]
  [dst : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set! dst index (opt-copy-resolve env (array-ref src index)))
      (opt-copy-subst-call-args-array env src dst (+ index 1)))))

(define (opt-copy-subst-call-args
  [env : OptCopyEnv]
  [args : CompilerIrCallArgs]) : CompilerIrCallArgs
  (match args
    [(IrCallArgsNil) (IrCallArgsNil)]
    [(IrCallArgsOne value) (IrCallArgsOne (opt-copy-resolve env value))]
    [(IrCallArgsTwo a b)
      (IrCallArgsTwo (opt-copy-resolve env a) (opt-copy-resolve env b))]
    [(IrCallArgsArray values)
      (let
        [out : (Array CompilerIrValue)
          (make-array CompilerIrValue (array-length values))]
        (begin
          (opt-copy-subst-call-args-array env values out 0)
          (IrCallArgsArray out)))]))

;; Rewrite the value-use operands of an instruction through the copy env. Phi
;; inputs and the raw var id of `IrInstrAddrOf` are intentionally not rewritten.
(define (opt-copy-subst-instr [env : OptCopyEnv] [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrMov dst src ty) (IrInstrMov dst (opt-copy-resolve env src) ty)]
    [(IrInstrGep dst base offset ty)
      (IrInstrGep
        dst
        (opt-copy-resolve env base)
        (opt-copy-resolve env offset)
        ty)]
    [(IrInstrLoad dst src ty) (IrInstrLoad dst (opt-copy-resolve env src) ty)]
    [(IrInstrStorePtr ptr value ty)
      (IrInstrStorePtr
        (opt-copy-resolve env ptr)
        (opt-copy-resolve env value)
        ty)]
    [(IrInstrCopyBytes dst src size)
      (IrInstrCopyBytes
        (opt-copy-resolve env dst)
        (opt-copy-resolve env src)
        size)]
    [(IrInstrCast dst src from-ty to-ty)
      (IrInstrCast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(IrInstrBitcast dst src from-ty to-ty)
      (IrInstrBitcast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(IrInstrBinOp dst op l r ty)
      (IrInstrBinOp dst op (opt-copy-resolve env l) (opt-copy-resolve env r) ty)]
    [(IrInstrUnOp dst op v ty) (IrInstrUnOp dst op (opt-copy-resolve env v) ty)]
    [(IrInstrSplat dst value lanes ty)
      (IrInstrSplat dst (opt-copy-resolve env value) lanes ty)]
    ;; Vector IR uses private aggregate values that the scalar copy pass cannot
    ;; type-check yet, so leave those operands untouched until a vector-aware
    ;; propagation pass exists. Mask operands are private too, so only var-to-var
    ;; mask copies are substituted; scalar bool literals are not mask constants.
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ _ _ _ _) instr])]
    [(IrInstrVectorReduce _ _ _ _ _) instr]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ _ _ _ _) instr])]
    [(IrInstrMaskBinOp dst op lhs rhs lanes)
      (IrInstrMaskBinOp
        dst
        op
        (opt-copy-resolve-mask env lhs)
        (opt-copy-resolve-mask env rhs)
        lanes)]
    [(IrInstrMaskNot dst src lanes)
      (IrInstrMaskNot dst (opt-copy-resolve-mask env src) lanes)]
    [(IrInstrMaskReduce dst op src lanes)
      (IrInstrMaskReduce dst op (opt-copy-resolve-mask env src) lanes)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ _ _ _ _ _) instr])]
    [(IrInstrVectorLoad _ _ _ _ _) instr]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload _ _ _ _ _) instr])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload _ _ _ _ _ _) instr])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload _ _ _ _ _ _) instr])]
    [(IrInstrTailMask _ _ _ _) instr]
    [(IrInstrEntryArgc _) instr]
    [(IrInstrEntryArgv _) instr]
    [(IrInstrEntryEnvp _) instr]
    [(IrInstrCpuId dst leaf subleaf reg-index)
      (IrInstrCpuId
        dst
        (opt-copy-resolve env leaf)
        (opt-copy-resolve env subleaf)
        reg-index)]
    [(IrInstrXgetbv dst index) (IrInstrXgetbv dst (opt-copy-resolve env index))]
    [(IrInstrSyscall dst args)
      (IrInstrSyscall dst (opt-copy-subst-call-args env args))]
    [(IrInstrCall dst name args ty)
      (IrInstrCall dst name (opt-copy-subst-call-args env args) ty)]
    [(IrInstrCallIndirect dst func args ty)
      (IrInstrCallIndirect
        dst
        (opt-copy-resolve env func)
        (opt-copy-subst-call-args env args)
        ty)]
    [(IrInstrCallIndirectC dst func args ty)
      (IrInstrCallIndirectC
        dst
        (opt-copy-resolve env func)
        (opt-copy-subst-call-args env args)
        ty)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base name args slots)
          (ir-instr-call-cabi-store-result
            (opt-copy-resolve env base)
            name
            (opt-copy-subst-call-args env args)
            slots)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload
            base
            func
            args
            slots)
          (ir-instr-call-indirect-cabi-store-result
            (opt-copy-resolve env base)
            (opt-copy-resolve env func)
            (opt-copy-subst-call-args env args)
            slots)])]
    [(IrInstrTailCall name args ty)
      (IrInstrTailCall name (opt-copy-subst-call-args env args) ty)]
    [(IrInstrStore name value ty)
      (IrInstrStore name (opt-copy-resolve env value) ty)]
    [(IrInstrBoundsCheck index length ok-label)
      (IrInstrBoundsCheck
        (opt-copy-resolve env index)
        (opt-copy-resolve env length)
        ok-label)]
    [(IrInstrBranch cond a b) (IrInstrBranch (opt-copy-resolve env cond) a b)]
    [(IrInstrReturn maybe)
      (match maybe
        [(IrSomeValue value)
          (IrInstrReturn (IrSomeValue (opt-copy-resolve env value)))]
        [(IrNoValue) instr])]
    ;; `IrInstrAddrOf` takes the address of a storage slot named by a raw var id,
    ;; not a value, so its operand must not be copy-substituted (#545).
    [(IrInstrAddrOf _ _) instr]
    ;; `IrInstrAlloc`/`IrInstrJump` have no value operands; `IrInstrPhi` inputs
    ;; belong to predecessor edges and are not block-local copies.
    [(IrInstrAlloc _ _) instr]
    [(IrInstrLaneId _ _ _) instr]
    [(IrInstrJump _) instr]
    [(IrInstrPhi _ _ _) instr]
    ;; #2386: register-group ops carry value operands -- substitute copies into
    ;; the packed words / the extracted source group.
    [(IrInstrPack dst words ty)
      (IrInstrPack dst (opt-copy-subst-value-list env words) ty)]
    [(IrInstrWord dst src index ty)
      (let
        [resolved-src : CompilerIrValue (opt-copy-resolve env src)]
        (match resolved-src
          [(IrValueVar group)
            (match (opt-copy-pack-word-lookup env group index)
              [(IrSomeValue word)
                (IrInstrMov dst (opt-copy-resolve env word) ty)]
              [(IrNoValue) (IrInstrWord dst resolved-src index ty)])]
          [_ (IrInstrWord dst resolved-src index ty)]))]
    [(IrInstrTailCallIndirect func args ty)
      (IrInstrTailCallIndirect
        (opt-copy-resolve env func)
        (opt-copy-subst-call-args env args)
        ty)]))

;; Update the copy env after an instruction. A `Mov dst src` (with `src` already
;; substituted) records a copy when `src` is a safe, non-self source. Every other
;; defining instruction invalidates its destination. Stores and terminators
;; define no var, so the copy facts are unaffected (the env resets per block).
(define (opt-copy-update-env [env : OptCopyEnv] [instr : CompilerIrInstr]) : OptCopyEnv
  (match instr
    [(IrInstrMov dst src ty)
      (let
        [e1 : OptCopyEnv (opt-copy-invalidate-var env dst)]
        (if (and (opt-copy-safe-source? src) (not (opt-value-is-var? src dst)))
          (OptCopyCons dst src (box e1))
          e1))]
    [(IrInstrAlloc dst _) (opt-copy-invalidate-var env dst)]
    [(IrInstrAddrOf dst _) (opt-copy-invalidate-var env dst)]
    [(IrInstrGep dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrLoad dst _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrCast dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrBitcast dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrBinOp dst _ _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrUnOp dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrLaneId dst _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrSplat dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(IrInstrVectorReduce dst _ _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(IrInstrMaskBinOp dst _ lhs rhs _)
      (let
        [e1 : OptCopyEnv (opt-copy-invalidate-var env dst)]
        (if (and (opt-value-eq lhs rhs) (opt-copy-mask-source? lhs dst))
          (OptCopyCons dst lhs (box e1))
          e1))]
    [(IrInstrMaskNot dst _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrMaskReduce dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(IrInstrVectorLoad dst _ _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (opt-copy-invalidate-var env dst)])]
    [(IrInstrTailMask dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrEntryArgc dst) (opt-copy-invalidate-var env dst)]
    [(IrInstrEntryArgv dst) (opt-copy-invalidate-var env dst)]
    [(IrInstrEntryEnvp dst) (opt-copy-invalidate-var env dst)]
    [(IrInstrCpuId dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrXgetbv dst _) (opt-copy-invalidate-var env dst)]
    [(IrInstrSyscall dst _) (opt-copy-invalidate-var env dst)]
    [(IrInstrCall dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrCallIndirect dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrCallIndirectC dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(IrInstrPhi dst _ _) (opt-copy-invalidate-var env dst)]
    ;; #2386: register-group ops define their dst -- drop any stale copy fact for
    ;; it (a reused var id must not trigger a later stale rewrite).
    [(IrInstrPack dst words _) (opt-copy-update-pack-env env dst words)]
    [(IrInstrWord dst _ _ _) (opt-copy-invalidate-var env dst)]
    [_ env]))

(defenum OptCopyResult
  (OptCopyResult OptCopyEnv CompilerIrInstr))

(define (opt-copy-instr [env : OptCopyEnv] [instr : CompilerIrInstr]) : OptCopyResult
  (let
    [rewritten : CompilerIrInstr (opt-copy-subst-instr env instr)]
    (OptCopyResult (opt-copy-update-env env rewritten) rewritten)))

(define (opt-copy-instrs [env : OptCopyEnv] [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (match (opt-copy-instr env instr)
        [(OptCopyResult new-env new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-copy-instrs new-env (box-get rest)))])]))

(define (opt-copy-instr-seq-from
  [env : OptCopyEnv]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (IrInstrNil)
    (match (opt-copy-instr env (compiler-ir-instr-seq-ref instrs index))
      [(OptCopyResult new-env new-instr)
        (compiler-ir-instr-cons
          new-instr
          (opt-copy-instr-seq-from new-env instrs (+ index 1)))])))

(define (opt-copy-instr-seq [env : OptCopyEnv] [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-copy-instr-seq-from env instrs 0))

;; --- block-local redundant bounds-check elimination (#930) ------------------
;;
;; `IrInstrBoundsCheck index length ok-label` is a trapping side-effect: it must be kept
;; unless the same `(index, length)` pair has already been checked on every
;; preceding path within the same basic block. This pass is deliberately local.
;; It records successful checks after copy propagation has resolved operands,
;; invalidates facts when either operand var is redefined, and clears all facts
;; across calls, stores, control-flow boundaries, and phi boundaries.
(defenum OptBoundsFact
  (OptBoundsFact CompilerIrValue CompilerIrValue))

(defenum OptBoundsFacts
  (OptBoundsNil)
  (OptBoundsCons OptBoundsFact (Box OptBoundsFacts)))

(defenum OptObjectLengthFact
  (OptObjectLengthNone)
  (OptObjectLengthKnown i64 i64))

(define (opt-bounds-length-uses-var? [length : CompilerIrValue] [var : i64]) : bool
  (match length
    [(IrValueVar id)
      (if (< id 0)
        (= (- (- 0 id) 1) var)
        (= id var))]
    [_ false]))

(define (opt-object-length-lookup [fact : OptObjectLengthFact] [var : i64]) : OptMaybeI64
  (match fact
    [(OptObjectLengthKnown fact-var object-var)
      (if (= fact-var var)
        (OptSomeI64 object-var)
        (OptNoI64))]
    [(OptObjectLengthNone) (OptNoI64)]))

(define (opt-bounds-length-value
  [facts : OptObjectLengthFact]
  [length : CompilerIrValue]) : CompilerIrValue
  (match length
    [(IrValueVar var)
      (match (opt-object-length-lookup facts var)
        [(OptSomeI64 object-var) (IrValueVar (- 0 (+ object-var 1)))]
        [(OptNoI64) length])]
    [_ length]))

(define (opt-bounds-fact-eq
  [fact : OptBoundsFact]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : bool
  (match fact
    [(OptBoundsFact fact-index fact-length)
      (and (opt-value-eq fact-index index) (opt-value-eq fact-length length))]))

(define (opt-bounds-contains
  [facts : OptBoundsFacts]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : bool
  (match facts
    [(OptBoundsNil) false]
    [(OptBoundsCons fact rest)
      (let
        [rest : OptBoundsFacts (box-get rest)]
        (if (opt-bounds-fact-eq fact index length)
          true
          (opt-bounds-contains rest index length)))]))

(define (opt-bounds-add
  [facts : OptBoundsFacts]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : OptBoundsFacts
  (if (opt-bounds-contains facts index length)
    facts
    (OptBoundsCons (OptBoundsFact index length) (box facts))))

(define (opt-bounds-fact-uses-var? [fact : OptBoundsFact] [var : i64]) : bool
  (match fact
    [(OptBoundsFact index length)
      (or
        (opt-value-is-var? index var)
        (opt-bounds-length-uses-var? length var))]))

(define (opt-bounds-invalidate-var [facts : OptBoundsFacts] [var : i64]) : OptBoundsFacts
  (match facts
    [(OptBoundsNil) (OptBoundsNil)]
    [(OptBoundsCons fact rest)
      (let
        [rest2 : OptBoundsFacts (opt-bounds-invalidate-var (box-get rest) var)]
        (if (opt-bounds-fact-uses-var? fact var)
          rest2
          (OptBoundsCons fact (box rest2))))]))

(define (opt-object-length-invalidate-var
  [fact : OptObjectLengthFact]
  [var : i64]) : OptObjectLengthFact
  (match fact
    [(OptObjectLengthKnown length-var object-var)
      (if (or (= length-var var) (= object-var var))
        (OptObjectLengthNone)
        fact)]
    [(OptObjectLengthNone) fact]))

(define (opt-object-length-bind
  [_fact : OptObjectLengthFact]
  [length-var : i64]
  [object-var : i64]) : OptObjectLengthFact
  (OptObjectLengthKnown length-var object-var))

(define (opt-bounds-object-length-slot?
  [offset : CompilerIrValue]
  [ty : AstType]) : bool
  (match offset
    [(IrValueI64 value)
      (or
        (and (= value 1) (opt-type-eq ty (AstTyI64)))
        (and (= value 8) (opt-type-eq ty (AstTyU8))))]
    [_ false]))

(define (opt-bounds-update-facts
  [facts : OptBoundsFacts]
  [instr : CompilerIrInstr]) : OptBoundsFacts
  (match instr
    [(IrInstrMov dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrAlloc dst _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrAddrOf dst _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrGep dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrLoad dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrCast dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrBitcast dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrBinOp dst _ _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrUnOp dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrLaneId dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrSplat dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(IrInstrVectorReduce dst _ _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(IrInstrMaskBinOp dst _ _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrMaskNot dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrMaskReduce dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(IrInstrVectorLoad dst _ _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (opt-bounds-invalidate-var facts dst)])]
    [(IrInstrTailMask dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrEntryArgc dst) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrEntryArgv dst) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrEntryEnvp dst) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrCpuId _ _ _ _) (OptBoundsNil)]
    [(IrInstrXgetbv _ _) (OptBoundsNil)]
    [(IrInstrSyscall _ _) (OptBoundsNil)]
    [(IrInstrCall _ _ _ _) (OptBoundsNil)]
    [(IrInstrCallIndirect _ _ _ _) (OptBoundsNil)]
    [(IrInstrCallIndirectC _ _ _ _) (OptBoundsNil)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload _ _ _ _) (OptBoundsNil)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload _ _ _ _)
          (OptBoundsNil)])]
    [(IrInstrTailCall _ _ _) (OptBoundsNil)]
    [(IrInstrStore _ _ _) (OptBoundsNil)]
    [(IrInstrStorePtr _ _ _) (OptBoundsNil)]
    [(IrInstrCopyBytes _ _ _) (OptBoundsNil)]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload _ _ _ _ _) (OptBoundsNil)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload _ _ _ _ _ _) (OptBoundsNil)])]
    [(IrInstrJump _) (OptBoundsNil)]
    [(IrInstrBranch _ _ _) (OptBoundsNil)]
    [(IrInstrReturn _) (OptBoundsNil)]
    [(IrInstrPhi _ _ _) (OptBoundsNil)]
    [(IrInstrBoundsCheck _ _ _) facts]
    [(IrInstrPack dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrWord dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(IrInstrTailCallIndirect _ _ _) (OptBoundsNil)]))

(define (opt-bounds-instrs-with-object
  [facts : OptBoundsFacts]
  [lengths : OptObjectLengthFact]
  [ptrs : OptObjectLengthFact]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrBoundsCheck index length _)
          (let
            [length-key : CompilerIrValue
              (opt-bounds-length-value lengths length)]
            (if (opt-bounds-contains facts index length-key)
              (opt-bounds-instrs-with-object facts lengths ptrs (box-get rest))
              (compiler-ir-instr-cons
                instr
                (opt-bounds-instrs-with-object
                  (opt-bounds-add facts index length-key)
                  lengths
                  ptrs
                  (box-get rest)))))]
        [(IrInstrGep dst base offset ty)
          (let
            [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [lengths2 : OptObjectLengthFact
              (opt-object-length-invalidate-var lengths dst)]
            [ptrs2 : OptObjectLengthFact
              (opt-object-length-invalidate-var ptrs dst)]
            [ptrs3 : OptObjectLengthFact
              (if (opt-bounds-object-length-slot? offset ty)
                (match base
                  [(IrValueVar object-var)
                    (opt-object-length-bind ptrs2 dst object-var)]
                  [_ ptrs2])
                ptrs2)]
            (compiler-ir-instr-cons
              instr
              (opt-bounds-instrs-with-object
                facts2
                lengths2
                ptrs3
                (box-get rest))))]
        [(IrInstrLoad dst src ty)
          (let
            [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [lengths2 : OptObjectLengthFact
              (opt-object-length-invalidate-var lengths dst)]
            [ptrs2 : OptObjectLengthFact
              (opt-object-length-invalidate-var ptrs dst)]
            [lengths3 : OptObjectLengthFact
              (if (opt-type-eq ty (AstTyI64))
                (match src
                  [(IrValueVar ptr-var)
                    (match (opt-object-length-lookup ptrs2 ptr-var)
                      [(OptSomeI64 object-var)
                        (opt-object-length-bind lengths2 dst object-var)]
                      [(OptNoI64) lengths2])]
                  [_ lengths2])
                lengths2)]
            (compiler-ir-instr-cons
              instr
              (opt-bounds-instrs-with-object
                facts2
                lengths3
                ptrs2
                (box-get rest))))]
        [(IrInstrCast dst src from-ty to-ty)
          (let
            [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [lengths2 : OptObjectLengthFact
              (opt-object-length-invalidate-var lengths dst)]
            [ptrs2 : OptObjectLengthFact
              (opt-object-length-invalidate-var ptrs dst)]
            [lengths3 : OptObjectLengthFact
              (if (and
                (opt-type-eq from-ty (AstTyI64))
                (opt-type-eq to-ty (AstTyU64)))
                (match src
                  [(IrValueVar length-var)
                    (match (opt-object-length-lookup lengths2 length-var)
                      [(OptSomeI64 object-var)
                        (opt-object-length-bind lengths2 dst object-var)]
                      [(OptNoI64) lengths2])]
                  [_ lengths2])
                lengths2)]
            (compiler-ir-instr-cons
              instr
              (opt-bounds-instrs-with-object
                facts2
                lengths3
                ptrs2
                (box-get rest))))]
        [_
          (let
            [next-facts : OptBoundsFacts (opt-bounds-update-facts facts instr)]
            (match next-facts
              [(OptBoundsNil)
                (compiler-ir-instr-cons
                  instr
                  (opt-bounds-instrs next-facts (box-get rest)))]
              [_
                (match (opt-instr-def-var instr)
                  [(OptSomeI64 dst)
                    (compiler-ir-instr-cons
                      instr
                      (opt-bounds-instrs-with-object
                        next-facts
                        (opt-object-length-invalidate-var lengths dst)
                        (opt-object-length-invalidate-var ptrs dst)
                        (box-get rest)))]
                  [(OptNoI64)
                    (compiler-ir-instr-cons
                      instr
                      (opt-bounds-instrs-with-object
                        next-facts
                        lengths
                        ptrs
                        (box-get rest)))])]))])]))

(define (opt-bounds-instrs
  [facts : OptBoundsFacts]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrBoundsCheck index length _)
          (if (opt-bounds-contains facts index length)
            (opt-bounds-instrs facts (box-get rest))
            (compiler-ir-instr-cons
              instr
              (opt-bounds-instrs
                (opt-bounds-add facts index length)
                (box-get rest))))]
        [(IrInstrGep dst base offset ty)
          (let
            [next-facts : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            (if (opt-bounds-object-length-slot? offset ty)
              (compiler-ir-instr-cons
                instr
                (opt-bounds-instrs-with-object
                  next-facts
                  (OptObjectLengthNone)
                  (match base
                    [(IrValueVar object-var)
                      (opt-object-length-bind
                        (OptObjectLengthNone)
                        dst
                        object-var)]
                    [_ (OptObjectLengthNone)])
                  (box-get rest)))
              (compiler-ir-instr-cons
                instr
                (opt-bounds-instrs next-facts (box-get rest)))))]
        [_
          (compiler-ir-instr-cons
            instr
            (opt-bounds-instrs
              (opt-bounds-update-facts facts instr)
              (box-get rest)))])]))

;; --- conservative CFG simplification (#926) ---------------------------------
;;
;; Runs after block-local constant/copy propagation has exposed literal branch
;; conditions. It rewrites known boolean branches to jumps, computes reachable
;; blocks from the function entry block, drops unreachable blocks, and trims phi
;; inputs from predecessors that are no longer reachable.
(defenum OptLabelSet
  (OptLabelNil)
  (OptLabelCons String (Box OptLabelSet)))

(define (opt-label-contains [set : OptLabelSet] [label : String]) : bool
  (let
    [cursor : OptLabelSet set]
    [found : bool false]
    (begin
      (while (not found)
        (match cursor
          [(OptLabelNil) (return false)]
          [(OptLabelCons head rest)
            (if (string-eq head label)
              (set! found true)
              (set! cursor (box-get rest)))]))
      true)))

(define (opt-label-add [set : OptLabelSet] [label : String]) : OptLabelSet
  (if (opt-label-contains set label)
    set
    (OptLabelCons label (box set))))

(define (opt-label-count [set : OptLabelSet]) : i64
  (match set
    [(OptLabelNil) 0]
    [(OptLabelCons _ rest) (+ 1 (opt-label-count (box-get rest)))]))

(define (opt-label-subset? [a : OptLabelSet] [b : OptLabelSet]) : bool
  (match a
    [(OptLabelNil) true]
    [(OptLabelCons label rest)
      (and (opt-label-contains b label) (opt-label-subset? (box-get rest) b))]))

(define (opt-label-set-eq? [a : OptLabelSet] [b : OptLabelSet]) : bool
  (and (opt-label-subset? a b) (opt-label-subset? b a)))

(define (opt-label-intersection [a : OptLabelSet] [b : OptLabelSet]) : OptLabelSet
  (match a
    [(OptLabelNil) (OptLabelNil)]
    [(OptLabelCons label rest)
      (let
        [tail : OptLabelSet (opt-label-intersection (box-get rest) b)]
        (if (opt-label-contains b label)
          (opt-label-add tail label)
          tail))]))

(defenum OptMaybeBlock
  (OptNoBlock)
  (OptSomeBlock CompilerIrBlock))

(define (opt-cfg-find-block [blocks : CompilerIrBlockList] [label : String]) : OptMaybeBlock
  (match blocks
    [(IrBlockNil) (OptNoBlock)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock block-label _)
          (if (string-eq block-label label)
            (OptSomeBlock block)
            (opt-cfg-find-block (box-get rest) label))])]
    [(IrBlockArray seq)
      (opt-cfg-find-block (compiler-ir-block-seq-to-list seq) label)]))

(define (opt-cfg-block-exists? [blocks : CompilerIrBlockList] [label : String]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptSomeBlock _) true]
    [(OptNoBlock) false]))

(define (opt-cfg-entry-label [blocks : CompilerIrBlockList]) : String
  (match blocks
    [(IrBlockNil) ""]
    [(IrBlockCons block _)
      (match block
        [(IrBlock label _) label])]
    [(IrBlockArray seq)
      (opt-cfg-entry-label (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-block-labels [blocks : CompilerIrBlockList]) : OptLabelSet
  (match blocks
    [(IrBlockNil) (OptLabelNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (opt-label-add (opt-cfg-block-labels (box-get rest)) label)])]
    [(IrBlockArray seq)
      (opt-cfg-block-labels (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-block-labels-unique-from?
  [blocks : CompilerIrBlockList]
  [seen : OptLabelSet]) : bool
  (match blocks
    [(IrBlockNil) true]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (if (opt-label-contains seen label)
            false
            (opt-cfg-block-labels-unique-from?
              (box-get rest)
              (opt-label-add seen label)))])]
    [(IrBlockArray seq)
      (opt-cfg-block-labels-unique-from?
        (compiler-ir-block-seq-to-list seq)
        seen)]))

;; #2117: a hash-set seen-check; the incremental label-list scan made this
;; O(blocks^2) string comparisons on large functions.
(define (opt-cfg-block-labels-unique-map?
  [blocks : CompilerIrBlockList]
  [seen : StringI64Map]) : bool
  (match blocks
    [(IrBlockNil) true]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (if (string-i64-map-contains? seen label)
            false
            (opt-cfg-block-labels-unique-map?
              (box-get rest)
              (string-i64-map-put seen label 1)))])]
    [(IrBlockArray seq)
      (opt-cfg-block-labels-unique-map?
        (compiler-ir-block-seq-to-list seq)
        seen)]))

(define (opt-cfg-block-labels-unique? [blocks : CompilerIrBlockList]) : bool
  (opt-cfg-block-labels-unique-map? blocks (string-i64-map-with-capacity 64)))

(define (opt-cfg-block-label-map
  [blocks : CompilerIrBlockList]
  [seen : StringI64Map]) : StringI64Map
  (match blocks
    [(IrBlockNil) seen]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (opt-cfg-block-label-map
            (box-get rest)
            (string-i64-map-put seen label 1))])]
    [(IrBlockArray seq)
      (opt-cfg-block-label-map (compiler-ir-block-seq-to-list seq) seen)]))

(define (opt-cfg-label-set-known-in-map?
  [labels : OptLabelSet]
  [known : StringI64Map]) : bool
  (match labels
    [(OptLabelNil) true]
    [(OptLabelCons label rest)
      (and
        (string-i64-map-contains? known label)
        (opt-cfg-label-set-known-in-map? (box-get rest) known))]))

(define (opt-cfg-successor-targets-known-map?
  [blocks : CompilerIrBlockList]
  [known : StringI64Map]) : bool
  (match blocks
    [(IrBlockNil) true]
    [(IrBlockCons block rest)
      (and
        (opt-cfg-label-set-known-in-map?
          (opt-cfg-block-successors-with-next
            block
            (opt-cfg-entry-label (box-get rest)))
          known)
        (opt-cfg-successor-targets-known-map? (box-get rest) known))]
    [(IrBlockArray seq)
      (opt-cfg-successor-targets-known-map?
        (compiler-ir-block-seq-to-list seq)
        known)]))

(define (opt-cfg-successor-targets-known? [blocks : CompilerIrBlockList]) : bool
  (opt-cfg-successor-targets-known-map?
    blocks
    (opt-cfg-block-label-map blocks (string-i64-map-with-capacity 64))))

(define (opt-cfg-successor-targets-known-in-blocks?
  [blocks : CompilerIrBlockList]
  [labels : OptLabelSet]) : bool
  (match blocks
    [(IrBlockNil) true]
    [(IrBlockCons block rest)
      (and
        (opt-label-subset?
          (opt-cfg-block-successors-with-next
            block
            (opt-cfg-entry-label (box-get rest)))
          labels)
        (opt-cfg-successor-targets-known-in-blocks? (box-get rest) labels))]
    [(IrBlockArray seq)
      (opt-cfg-successor-targets-known-in-blocks?
        (compiler-ir-block-seq-to-list seq)
        labels)]))

(define (opt-cfg-predecessors-scan
  [blocks : CompilerIrBlockList]
  [label : String]) : OptLabelSet
  (match blocks
    [(IrBlockNil) (OptLabelNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock block-label _)
          (let
            [tail : OptLabelSet
              (opt-cfg-predecessors-scan (box-get rest) label)]
            (if (opt-label-contains
              (opt-cfg-block-successors-with-next
                block
                (opt-cfg-entry-label (box-get rest)))
              label)
              (opt-label-add tail block-label)
              tail))])]
    [(IrBlockArray seq)
      (opt-cfg-predecessors-scan (compiler-ir-block-seq-to-list seq) label)]))

(define (opt-cfg-predecessors [blocks : CompilerIrBlockList] [label : String]) : OptLabelSet
  (opt-cfg-index-predecessors (opt-cfg-index-build blocks) label))

(define (opt-cfg-filter-blocks-by-labels
  [labels : OptLabelSet]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (if (opt-label-contains labels label)
            (compiler-ir-block-cons
              block
              (opt-cfg-filter-blocks-by-labels labels (box-get rest)))
            (opt-cfg-filter-blocks-by-labels labels (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-cfg-filter-blocks-by-labels
        labels
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-reachable-block-order [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-cfg-filter-blocks-by-labels (opt-cfg-reachable-blocks blocks) blocks))

(defenum OptDomEntry
  (OptDomEntry String OptLabelSet))

(defenum OptLegacyDomTable
  (OptDomNil)
  (OptDomCons OptDomEntry (Box OptLegacyDomTable)))

(define (opt-dom-table-lookup [table : OptLegacyDomTable] [label : String]) : OptLabelSet
  (match table
    [(OptDomNil) (OptLabelNil)]
    [(OptDomCons entry rest)
      (let
        [rest : OptLegacyDomTable (box-get rest)]
        (match entry
          [(OptDomEntry entry-label labels)
            (if (string-eq entry-label label)
              labels
              (opt-dom-table-lookup rest label))]))]))

(define (opt-dom-entry-eq? [a : OptDomEntry] [b : OptDomEntry]) : bool
  (match a
    [(OptDomEntry a-label a-labels)
      (match b
        [(OptDomEntry b-label b-labels)
          (and
            (string-eq a-label b-label)
            (opt-label-set-eq? a-labels b-labels))])]))

(define (opt-dom-table-eq? [a : OptLegacyDomTable] [b : OptLegacyDomTable]) : bool
  (match a
    [(OptDomNil)
      (match b
        [(OptDomNil) true]
        [_ false])]
    [(OptDomCons a-entry a-rest)
      (match b
        [(OptDomCons b-entry b-rest)
          (and
            (opt-dom-entry-eq? a-entry b-entry)
            (opt-dom-table-eq? (box-get a-rest) (box-get b-rest)))]
        [_ false])]))

(define (opt-dom-intersect-preds-rest
  [table : OptLegacyDomTable]
  [preds : OptLabelSet]
  [current : OptLabelSet]) : OptLabelSet
  (match preds
    [(OptLabelNil) current]
    [(OptLabelCons pred rest)
      (opt-dom-intersect-preds-rest
        table
        (box-get rest)
        (opt-label-intersection current (opt-dom-table-lookup table pred)))]))

(define (opt-dom-intersect-preds
  [table : OptLegacyDomTable]
  [preds : OptLabelSet]) : OptLabelSet
  (match preds
    [(OptLabelNil) (OptLabelNil)]
    [(OptLabelCons pred rest)
      (opt-dom-intersect-preds-rest
        table
        (box-get rest)
        (opt-dom-table-lookup table pred))]))

(define (opt-cfg-dominators-initial
  [blocks : CompilerIrBlockList]
  [reachable : OptLabelSet]
  [entry-label : String]
  [all-reachable : OptLabelSet]) : OptLegacyDomTable
  (match blocks
    [(IrBlockNil) (OptDomNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (if (opt-label-contains reachable label)
            (OptDomCons
              (OptDomEntry
                label
                (if (string-eq label entry-label)
                  (opt-label-add (OptLabelNil) label)
                  all-reachable))
              (box
                (opt-cfg-dominators-initial
                  (box-get rest)
                  reachable
                  entry-label
                  all-reachable)))
            (opt-cfg-dominators-initial
              (box-get rest)
              reachable
              entry-label
              all-reachable))])]
    [(IrBlockArray seq)
      (opt-cfg-dominators-initial
        (compiler-ir-block-seq-to-list seq)
        reachable
        entry-label
        all-reachable)]))

;; CFG index (#2175): integer block ids are assigned in block-list order and
;; reused for successor/predecessor CSR rows, reachability, RPO, and RPO slot
;; lookup. Existing callers still consume OptLabelSet adapters, but each CFG
;; snapshot is indexed once and rebuilt only after block-list-mutating
;; optimization passes.
(defenum OptI64List
  (OptI64Nil)
  (OptI64Cons i64 (Box OptI64List)))

(defstruct OptCfgCsr
  (offsets (Array i64))
  (edges (Array i64)))

(defstruct OptCfgIndex
  (ids StringI64Map)
  (labels (Array String))
  (succs OptCfgCsr)
  (preds OptCfgCsr)
  (reachable (Array bool))
  (reach-count i64)
  (rpo (Array i64))
  (rpo-num (Array i64)))

(defstruct OptPredMap
  (index OptCfgIndex))

(define (opt-pred-map-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (opt-cfg-index-fill-labels!
  [blocks : CompilerIrBlockList]
  [ids : StringI64Map]
  [labels : (Array String)]
  [index : i64]) : StringI64Map
  (match blocks
    [(IrBlockNil) ids]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (begin
            (array-set! labels index label)
            (opt-cfg-index-fill-labels!
              (box-get rest)
              (string-i64-map-put ids label index)
              labels
              (+ index 1)))])]
    [(IrBlockArray seq)
      (opt-cfg-index-fill-labels!
        (compiler-ir-block-seq-to-list seq)
        ids
        labels
        index)]))

(define (opt-i64-list-contains? [items : OptI64List] [value : i64]) : bool
  (match items
    [(OptI64Nil) false]
    [(OptI64Cons head rest)
      (if (= head value)
        true
        (opt-i64-list-contains? (box-get rest) value))]))

(define (opt-i64-list-add [items : OptI64List] [value : i64]) : OptI64List
  (if (opt-i64-list-contains? items value)
    items
    (OptI64Cons value (box items))))

(define (opt-i64-list-reverse-onto [items : OptI64List] [acc : OptI64List]) : OptI64List
  (match items
    [(OptI64Nil) acc]
    [(OptI64Cons head rest)
      (opt-i64-list-reverse-onto (box-get rest) (OptI64Cons head (box acc)))]))

(define (opt-i64-list-reverse [items : OptI64List]) : OptI64List
  (opt-i64-list-reverse-onto items (OptI64Nil)))

(define (opt-i64-list-count [items : OptI64List]) : i64
  (match items
    [(OptI64Nil) 0]
    [(OptI64Cons _ rest) (+ 1 (opt-i64-list-count (box-get rest)))]))

(define (opt-i64-list-fill-edges!
  [items : OptI64List]
  [edges : (Array i64)]
  [index : i64]) : i64
  (match items
    [(OptI64Nil) index]
    [(OptI64Cons head rest)
      (begin
        (array-set! edges index head)
        (opt-i64-list-fill-edges! (box-get rest) edges (+ index 1)))]))

(define (opt-cfg-row-list-total
  [rows : (Array OptI64List)]
  [count : i64]
  [index : i64]
  [total : i64]) : i64
  (if (>= index count)
    total
    (opt-cfg-row-list-total
      rows
      count
      (+ index 1)
      (+ total (opt-i64-list-count (array-ref rows index))))))

(define (opt-cfg-i64-list-array-fill-empty!
  [rows : (Array OptI64List)]
  [count : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! rows i (OptI64Nil))
          (set! i (+ i 1))))
      unit)))

(define (opt-cfg-index-label-set-to-ids
  [labels : OptLabelSet]
  [ids : StringI64Map]) : OptI64List
  (match labels
    [(OptLabelNil) (OptI64Nil)]
    [(OptLabelCons label rest)
      (let
        [tail : OptI64List (opt-cfg-index-label-set-to-ids (box-get rest) ids)]
        (match (string-i64-map-get ids label)
          [(StringI64MapFound idx) (OptI64Cons idx (box tail))]
          [(StringI64MapMissing) tail]))]))

(define (opt-cfg-index-add-pred-edges!
  [pred-rows : (Array OptI64List)]
  [ids : StringI64Map]
  [source-id : i64]
  [succs : OptLabelSet]) : unit
  (match succs
    [(OptLabelNil) unit]
    [(OptLabelCons s rest)
      (begin
        (match (string-i64-map-get ids s)
          [(StringI64MapFound idx)
            (array-set!
              pred-rows
              idx
              (opt-i64-list-add (array-ref pred-rows idx) source-id))]
          [(StringI64MapMissing) unit])
        (opt-cfg-index-add-pred-edges! pred-rows ids source-id (box-get rest)))]))

(define (opt-cfg-index-fill-rows!
  [blocks : CompilerIrBlockList]
  [ids : StringI64Map]
  [succ-rows : (Array OptI64List)]
  [pred-rows : (Array OptI64List)]
  [index : i64]) : unit
  (match blocks
    [(IrBlockNil) unit]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ _)
          (let
            [succs : OptLabelSet
              (opt-cfg-block-successors-with-next
                block
                (opt-cfg-entry-label (box-get rest)))]
            (begin
              (array-set!
                succ-rows
                index
                (opt-cfg-index-label-set-to-ids succs ids))
              (opt-cfg-index-add-pred-edges! pred-rows ids index succs)
              (opt-cfg-index-fill-rows!
                (box-get rest)
                ids
                succ-rows
                pred-rows
                (+ index 1))))])]
    [(IrBlockArray seq)
      (opt-cfg-index-fill-rows!
        (compiler-ir-block-seq-to-list seq)
        ids
        succ-rows
        pred-rows
        index)]))

(define (opt-cfg-csr-fill-rows!
  [rows : (Array OptI64List)]
  [count : i64]
  [offsets : (Array i64)]
  [edges : (Array i64)]
  [row : i64]
  [edge-index : i64]) : unit
  (if (>= row count)
    (array-set! offsets count edge-index)
    (let
      [next-edge : i64
        (opt-i64-list-fill-edges!
          (opt-i64-list-reverse (array-ref rows row))
          edges
          edge-index)]
      (begin
        (array-set! offsets row edge-index)
        (opt-cfg-csr-fill-rows! rows count offsets edges (+ row 1) next-edge)))))

(define (opt-cfg-csr-build [rows : (Array OptI64List)] [count : i64]) : OptCfgCsr
  (let
    [edge-count : i64 (opt-cfg-row-list-total rows count 0 0)]
    [offsets : (Array i64) (make-array i64 (+ count 1))]
    [edges : (Array i64) (make-array i64 edge-count)]
    (begin
      (opt-cfg-csr-fill-rows! rows count offsets edges 0 0)
      (OptCfgCsr offsets edges))))

(define (opt-cfg-fill-bool!
  [values : (Array bool)]
  [count : i64]
  [value : bool]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! values i value)
          (set! i (+ i 1))))
      unit)))

(define (opt-cfg-fill-i64! [values : (Array i64)] [count : i64] [value : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! values i value)
          (set! i (+ i 1))))
      unit)))

(define (opt-cfg-index-dfs-edges!
  [succs : OptCfgCsr]
  [reachable : (Array bool)]
  [postorder : (Array i64)]
  [edge : i64]
  [end : i64]
  [post-count : i64]) : i64
  (if (>= edge end)
    post-count
    (opt-cfg-index-dfs-edges!
      succs
      reachable
      postorder
      (+ edge 1)
      end
      (opt-cfg-index-dfs-postorder!
        succs
        reachable
        postorder
        (array-ref (struct-get succs edges) edge)
        post-count))))

(define (opt-cfg-index-dfs-postorder!
  [succs : OptCfgCsr]
  [reachable : (Array bool)]
  [postorder : (Array i64)]
  [id : i64]
  [post-count : i64]) : i64
  (if (array-ref reachable id)
    post-count
    (let
      [edge : i64 (array-ref (struct-get succs offsets) id)]
      [end : i64 (array-ref (struct-get succs offsets) (+ id 1))]
      [next-count : i64
        (begin
          (array-set! reachable id true)
          (opt-cfg-index-dfs-edges!
            succs
            reachable
            postorder
            edge
            end
            post-count))]
      (begin
        (array-set! postorder next-count id)
        (+ next-count 1)))))

(define (opt-cfg-index-fill-rpo!
  [postorder : (Array i64)]
  [rpo : (Array i64)]
  [reach-count : i64]
  [index : i64]) : unit
  (if (>= index reach-count)
    unit
    (begin
      (array-set! rpo index (array-ref postorder (- (- reach-count 1) index)))
      (opt-cfg-index-fill-rpo! postorder rpo reach-count (+ index 1)))))

(define (opt-cfg-index-fill-rpo-num!
  [rpo : (Array i64)]
  [rpo-num : (Array i64)]
  [reach-count : i64]
  [slot : i64]) : unit
  (if (>= slot reach-count)
    unit
    (begin
      (array-set! rpo-num (array-ref rpo slot) slot)
      (opt-cfg-index-fill-rpo-num! rpo rpo-num reach-count (+ slot 1)))))

(define (opt-cfg-index-build [blocks : CompilerIrBlockList]) : OptCfgIndex
  (let
    [count : i64 (compiler-ir-block-list-count blocks)]
    [labels : (Array String) (make-array String count)]
    [ids : StringI64Map
      (opt-cfg-index-fill-labels!
        blocks
        (string-i64-map-with-capacity (opt-pred-map-capacity count))
        labels
        0)]
    [succ-rows : (Array OptI64List) (make-array OptI64List count)]
    [pred-rows : (Array OptI64List) (make-array OptI64List count)]
    [reachable : (Array bool) (make-array bool count)]
    [postorder : (Array i64) (make-array i64 count)]
    [rpo : (Array i64) (make-array i64 count)]
    [rpo-num : (Array i64) (make-array i64 count)]
    [reach-count : i64 0]
    (begin
      (opt-cfg-i64-list-array-fill-empty! succ-rows count)
      (opt-cfg-i64-list-array-fill-empty! pred-rows count)
      (opt-cfg-index-fill-rows! blocks ids succ-rows pred-rows 0)
      (opt-cfg-fill-bool! reachable count false)
      (opt-cfg-fill-i64! postorder count (- 0 1))
      (opt-cfg-fill-i64! rpo count (- 0 1))
      (opt-cfg-fill-i64! rpo-num count (- 0 1))
      (let
        [succ-csr : OptCfgCsr (opt-cfg-csr-build succ-rows count)]
        [pred-csr : OptCfgCsr (opt-cfg-csr-build pred-rows count)]
        (begin
          (if (> count 0)
            (set!
              reach-count
              (opt-cfg-index-dfs-postorder! succ-csr reachable postorder 0 0))
            unit)
          (opt-cfg-index-fill-rpo! postorder rpo reach-count 0)
          (opt-cfg-index-fill-rpo-num! rpo rpo-num reach-count 0)
          (OptCfgIndex
            ids
            labels
            succ-csr
            pred-csr
            reachable
            reach-count
            rpo
            rpo-num))))))

(define (opt-cfg-index-block-count [index : OptCfgIndex]) : i64
  (array-length (struct-get index labels)))

(define (opt-cfg-index-label [index : OptCfgIndex] [id : i64]) : String
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (array-ref (struct-get index labels) id)
    ""))

(define (opt-cfg-index-id [index : OptCfgIndex] [label : String]) : OptMaybeI64
  (match (string-i64-map-get (struct-get index ids) label)
    [(StringI64MapFound id) (OptSomeI64 id)]
    [(StringI64MapMissing) (OptNoI64)]))

(define (opt-cfg-index-row-labels-from
  [index : OptCfgIndex]
  [csr : OptCfgCsr]
  [edge : i64]
  [end : i64]
  [labels : OptLabelSet]) : OptLabelSet
  (if (>= edge end)
    labels
    (opt-cfg-index-row-labels-from
      index
      csr
      (+ edge 1)
      end
      (opt-label-add
        labels
        (opt-cfg-index-label index (array-ref (struct-get csr edges) edge))))))

(define (opt-cfg-index-row-labels
  [index : OptCfgIndex]
  [csr : OptCfgCsr]
  [id : i64]) : OptLabelSet
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (opt-cfg-index-row-labels-from
      index
      csr
      (array-ref (struct-get csr offsets) id)
      (array-ref (struct-get csr offsets) (+ id 1))
      (OptLabelNil))
    (OptLabelNil)))

(define (opt-cfg-index-successors [index : OptCfgIndex] [label : String]) : OptLabelSet
  (match (opt-cfg-index-id index label)
    [(OptSomeI64 id)
      (opt-cfg-index-row-labels index (struct-get index succs) id)]
    [(OptNoI64) (OptLabelNil)]))

(define (opt-cfg-index-predecessors [index : OptCfgIndex] [label : String]) : OptLabelSet
  (match (opt-cfg-index-id index label)
    [(OptSomeI64 id)
      (opt-cfg-index-row-labels index (struct-get index preds) id)]
    [(OptNoI64) (OptLabelNil)]))

(define (opt-cfg-index-reachable? [index : OptCfgIndex] [label : String]) : bool
  (match (opt-cfg-index-id index label)
    [(OptSomeI64 id) (array-ref (struct-get index reachable) id)]
    [(OptNoI64) false]))

(define (opt-cfg-index-reachable-labels-from
  [index : OptCfgIndex]
  [id : i64]
  [labels : OptLabelSet]) : OptLabelSet
  (if (>= id (opt-cfg-index-block-count index))
    labels
    (opt-cfg-index-reachable-labels-from
      index
      (+ id 1)
      (if (array-ref (struct-get index reachable) id)
        (opt-label-add labels (opt-cfg-index-label index id))
        labels))))

(define (opt-cfg-index-reachable-labels [index : OptCfgIndex]) : OptLabelSet
  (opt-cfg-index-reachable-labels-from index 0 (OptLabelNil)))

(define (opt-cfg-index-rpo-id [index : OptCfgIndex] [slot : i64]) : i64
  (if (and (>= slot 0) (< slot (struct-get index reach-count)))
    (array-ref (struct-get index rpo) slot)
    (- 0 1)))

(define (opt-cfg-index-rpo-num [index : OptCfgIndex] [id : i64]) : i64
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (array-ref (struct-get index rpo-num) id)
    (- 0 1)))

(define (opt-cfg-index-rpo-label [index : OptCfgIndex] [slot : i64]) : String
  (opt-cfg-index-label index (opt-cfg-index-rpo-id index slot)))

(define (opt-pred-map-build [blocks : CompilerIrBlockList]) : OptPredMap
  (OptPredMap (opt-cfg-index-build blocks)))

(define (opt-pred-map-lookup [map : OptPredMap] [label : String]) : OptLabelSet
  (opt-cfg-index-predecessors (struct-get map index) label))

(define (opt-pred-map-successors [map : OptPredMap] [label : String]) : OptLabelSet
  (opt-cfg-index-successors (struct-get map index) label))

(define (opt-cfg-dominators-step-entry
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : String]
  [old : OptLegacyDomTable]
  [entry : OptDomEntry]) : OptDomEntry
  (match entry
    [(OptDomEntry label _)
      (if (string-eq label entry-label)
        (OptDomEntry label (opt-label-add (OptLabelNil) label))
        (let
          [preds : OptLabelSet
            (opt-label-intersection
              (opt-pred-map-lookup pred-map label)
              reachable)]
          (OptDomEntry
            label
            (opt-label-add (opt-dom-intersect-preds old preds) label))))]))

(define (opt-cfg-dominators-step
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : String]
  [old : OptLegacyDomTable]
  [remaining : OptLegacyDomTable]) : OptLegacyDomTable
  (match remaining
    [(OptDomNil) (OptDomNil)]
    [(OptDomCons entry rest)
      (OptDomCons
        (opt-cfg-dominators-step-entry pred-map reachable entry-label old entry)
        (box
          (opt-cfg-dominators-step
            pred-map
            reachable
            entry-label
            old
            (box-get rest))))]))

(define (opt-cfg-dominators-fixed
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : String]
  [table : OptLegacyDomTable]
  [remaining : i64]) : OptLegacyDomTable
  (if (<= remaining 0)
    table
    (let
      [next : OptLegacyDomTable
        (opt-cfg-dominators-step pred-map reachable entry-label table table)]
      (if (opt-dom-table-eq? table next)
        next
        (opt-cfg-dominators-fixed
          pred-map
          reachable
          entry-label
          next
          (- remaining 1))))))

(define (opt-cfg-dominators-legacy-with
  [blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : String]) : OptLegacyDomTable
  (let
    [initial : OptLegacyDomTable
      (opt-cfg-dominators-initial blocks reachable entry-label reachable)]
    (opt-cfg-dominators-fixed
      pred-map
      reachable
      entry-label
      initial
      (+ (compiler-ir-block-list-count blocks) 1))))

(define (opt-bits-words [bits : i64]) : i64
  (/ (+ bits 62) 63))

(define (opt-bits-full-word-mask) : i64
  9223372036854775807)

(define (opt-bits-tail-mask [bits : i64]) : i64
  (let
    [rem : i64 (% bits 63)]
    (if (= rem 0)
      (opt-bits-full-word-mask)
      (- (shl 1 rem) 1))))

(define (opt-bits-set! [row : (Array i64)] [base : i64] [bit : i64]) : unit
  (let
    [w : i64 (+ base (/ bit 63))]
    (array-set! row w (bit-or (array-ref row w) (shl 1 (% bit 63))))))

(define (opt-bits-test [row : (Array i64)] [base : i64] [bit : i64]) : bool
  (not (= (bit-and (array-ref row (+ base (/ bit 63))) (shl 1 (% bit 63))) 0)))

(define (opt-bits-clear! [row : (Array i64)] [base : i64] [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (array-set! row (+ base w) 0)
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-fill-universe! [row : (Array i64)] [base : i64] [bits : i64]) : unit
  (let
    [words : i64 (opt-bits-words bits)]
    [last : i64 (- words 1)]
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (array-set!
            row
            (+ base w)
            (if (= w last)
              (opt-bits-tail-mask bits)
              (opt-bits-full-word-mask)))
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-and-into!
  [dst : (Array i64)]
  [dst-base : i64]
  [src : (Array i64)]
  [src-base : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (array-set!
            dst
            (+ dst-base w)
            (bit-and
              (array-ref dst (+ dst-base w))
              (array-ref src (+ src-base w))))
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-copy!
  [dst : (Array i64)]
  [dst-base : i64]
  [src : (Array i64)]
  [src-base : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (array-set! dst (+ dst-base w) (array-ref src (+ src-base w)))
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-eq?
  [a : (Array i64)]
  [a-base : i64]
  [b : (Array i64)]
  [b-base : i64]
  [words : i64]) : bool
  (let
    [w : i64 0]
    [same : bool true]
    (begin
      (while (and same (< w words))
        (begin
          (if (= (array-ref a (+ a-base w)) (array-ref b (+ b-base w)))
            unit
            (set! same false))
          (set! w (+ w 1))))
      same)))

(defstruct OptDomInfo
  (index OptCfgIndex)
  (words i64)
  (rows (Array i64))
  (idom (Array i64))
  (tin (Array i64))
  (tout (Array i64)))

(define (opt-dom-row-base [words : i64] [id : i64]) : i64
  (* id words))

(define (opt-dom-fill-reachable-universe!
  [index : OptCfgIndex]
  [row : (Array i64)]
  [base : i64]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [id : i64 0]
    (begin
      (while (< id count)
        (begin
          (if (array-ref (struct-get index reachable) id)
            (opt-bits-set! row base id)
            unit)
          (set! id (+ id 1))))
      unit)))

(define (opt-dom-init-row!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [words : i64]
  [entry-id : i64]
  [id : i64]) : unit
  (let
    [base : i64 (opt-dom-row-base words id)]
    (begin
      (opt-bits-clear! rows base words)
      (if (array-ref (struct-get index reachable) id)
        (if (= id entry-id)
          (opt-bits-set! rows base id)
          (opt-dom-fill-reachable-universe! index rows base))
        unit))))

(define (opt-dom-init-rows!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [words : i64]
  [entry-id : i64]) : unit
  (let
    [id : i64 0]
    [count : i64 (opt-cfg-index-block-count index)]
    (begin
      (while (< id count)
        (begin
          (opt-dom-init-row! index rows words entry-id id)
          (set! id (+ id 1))))
      unit)))

(define (opt-dom-row-from-preds!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [scratch : (Array i64)]
  [words : i64]
  [id : i64]) : unit
  (let
    [preds : OptCfgCsr (struct-get index preds)]
    [edge : i64 (array-ref (struct-get preds offsets) id)]
    [end : i64 (array-ref (struct-get preds offsets) (+ id 1))]
    [saw : bool false]
    (begin
      (opt-bits-clear! scratch 0 words)
      (opt-dom-fill-reachable-universe! index scratch 0)
      (while (< edge end)
        (let
          [pred : i64 (array-ref (struct-get preds edges) edge)]
          (begin
            (if (array-ref (struct-get index reachable) pred)
              (begin
                (opt-bits-and-into!
                  scratch
                  0
                  rows
                  (opt-dom-row-base words pred)
                  words)
                (set! saw true))
              unit)
            (set! edge (+ edge 1)))))
      (if saw
        unit
        (opt-bits-clear! scratch 0 words))
      (opt-bits-set! scratch 0 id))))

(define (opt-dom-update-row!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [scratch : (Array i64)]
  [words : i64]
  [entry-id : i64]
  [id : i64]) : bool
  (if (or (= id entry-id) (not (array-ref (struct-get index reachable) id)))
    false
    (let
      [base : i64 (opt-dom-row-base words id)]
      (begin
        (opt-dom-row-from-preds! index rows scratch words id)
        (if (opt-bits-eq? rows base scratch 0 words)
          false
          (begin
            (opt-bits-copy! rows base scratch 0 words)
            true))))))

(define (opt-dom-iterate-rpo!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [scratch : (Array i64)]
  [words : i64]
  [entry-id : i64]) : bool
  (let
    [slot : i64 0]
    [changed : bool false]
    (begin
      (while (< slot (struct-get index reach-count))
        (begin
          (if (opt-dom-update-row!
            index
            rows
            scratch
            words
            entry-id
            (opt-cfg-index-rpo-id index slot))
            (set! changed true)
            unit)
          (set! slot (+ slot 1))))
      changed)))

(define (opt-dom-fixpoint!
  [index : OptCfgIndex]
  [rows : (Array i64)]
  [scratch : (Array i64)]
  [words : i64]
  [entry-id : i64]
  [remaining : i64]) : unit
  (if (<= remaining 0)
    unit
    (if (opt-dom-iterate-rpo! index rows scratch words entry-id)
      (opt-dom-fixpoint! index rows scratch words entry-id (- remaining 1))
      unit)))

(define (opt-cfg-dominators-bitset-with
  [index : OptCfgIndex]
  [entry-label : String]) : OptDomInfo
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [words : i64 (opt-bits-words count)]
    [rows : (Array i64) (make-array i64 (* count words))]
    [scratch : (Array i64) (make-array i64 words)]
    [empty : (Array i64) (make-array i64 0)]
    [entry-id : i64 (- 0 1)]
    (begin
      (match (opt-cfg-index-id index entry-label)
        [(OptSomeI64 id) (set! entry-id id)]
        [(OptNoI64) unit])
      (opt-dom-init-rows! index rows words entry-id)
      (if (>= entry-id 0)
        (opt-dom-fixpoint! index rows scratch words entry-id (+ count 1))
        unit)
      (OptDomInfo index words rows empty empty empty))))

(define (opt-dom-intersect-idom
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [left : i64]
  [right : i64]) : i64
  (let
    [a : i64 left]
    [b : i64 right]
    (begin
      (while (!= a b)
        (begin
          (while (>
            (opt-cfg-index-rpo-num index a)
            (opt-cfg-index-rpo-num index b))
            (set! a (array-ref idom a)))
          (while (>
            (opt-cfg-index-rpo-num index b)
            (opt-cfg-index-rpo-num index a))
            (set! b (array-ref idom b)))))
      a)))

(define (opt-dom-idom-from-preds
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [id : i64]) : i64
  (let
    [preds : OptCfgCsr (struct-get index preds)]
    [edge : i64 (array-ref (struct-get preds offsets) id)]
    [end : i64 (array-ref (struct-get preds offsets) (+ id 1))]
    [candidate : i64 (- 0 1)]
    (begin
      (while (< edge end)
        (let
          [pred : i64 (array-ref (struct-get preds edges) edge)]
          (begin
            (if (and
              (array-ref (struct-get index reachable) pred)
              (>= (array-ref idom pred) 0))
              (if (< candidate 0)
                (set! candidate pred)
                (set!
                  candidate
                  (opt-dom-intersect-idom index idom pred candidate)))
              unit)
            (set! edge (+ edge 1)))))
      candidate)))

(define (opt-dom-idom-iterate-rpo!
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [entry-id : i64]) : bool
  (let
    [slot : i64 1]
    [changed : bool false]
    (begin
      (while (< slot (struct-get index reach-count))
        (let
          [id : i64 (opt-cfg-index-rpo-id index slot)]
          [new-idom : i64 (opt-dom-idom-from-preds index idom id)]
          (begin
            (if (and
              (!= id entry-id)
              (>= new-idom 0)
              (!= (array-ref idom id) new-idom))
              (begin
                (array-set! idom id new-idom)
                (set! changed true))
              unit)
            (set! slot (+ slot 1)))))
      changed)))

(define (opt-dom-idom-fixpoint!
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [entry-id : i64]
  [remaining : i64]) : unit
  (if (<= remaining 0)
    unit
    (if (opt-dom-idom-iterate-rpo! index idom entry-id)
      (opt-dom-idom-fixpoint! index idom entry-id (- remaining 1))
      unit)))

(define (opt-dom-child-rows-fill!
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [rows : (Array OptI64List)]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [id : i64 0]
    (begin
      (while (< id count)
        (let
          [parent : i64 (array-ref idom id)]
          (begin
            (if (and
              (array-ref (struct-get index reachable) id)
              (>= parent 0)
              (!= parent id))
              (array-set!
                rows
                parent
                (opt-i64-list-add (array-ref rows parent) id))
              unit)
            (set! id (+ id 1)))))
      unit)))

(define (opt-dom-euler-dfs!
  [children : OptCfgCsr]
  [tin : (Array i64)]
  [tout : (Array i64)]
  [id : i64]
  [time : i64]) : i64
  (let
    [next : i64 (+ time 1)]
    [edge : i64 (array-ref (struct-get children offsets) id)]
    [end : i64 (array-ref (struct-get children offsets) (+ id 1))]
    (begin
      (array-set! tin id time)
      (while (< edge end)
        (begin
          (set!
            next
            (opt-dom-euler-dfs!
              children
              tin
              tout
              (array-ref (struct-get children edges) edge)
              next))
          (set! edge (+ edge 1))))
      (array-set! tout id next)
      next)))

(define (opt-dom-build-euler!
  [index : OptCfgIndex]
  [idom : (Array i64)]
  [tin : (Array i64)]
  [tout : (Array i64)]
  [entry-id : i64]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [child-rows : (Array OptI64List) (make-array OptI64List count)]
    (begin
      (opt-cfg-fill-i64! tin count (- 0 1))
      (opt-cfg-fill-i64! tout count (- 0 1))
      (if (>= entry-id 0)
        (begin
          (opt-cfg-i64-list-array-fill-empty! child-rows count)
          (opt-dom-child-rows-fill! index idom child-rows)
          (let
            [children : OptCfgCsr (opt-cfg-csr-build child-rows count)]
            (begin
              (opt-dom-euler-dfs! children tin tout entry-id 0)
              unit)))
        unit))))

(define (opt-cfg-dominators-with [index : OptCfgIndex] [entry-label : String]) : OptDomInfo
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [idom : (Array i64) (make-array i64 count)]
    [tin : (Array i64) (make-array i64 count)]
    [tout : (Array i64) (make-array i64 count)]
    [empty : (Array i64) (make-array i64 0)]
    [entry-id : i64 (- 0 1)]
    (begin
      (opt-cfg-fill-i64! idom count (- 0 1))
      (match (opt-cfg-index-id index entry-label)
        [(OptSomeI64 id) (set! entry-id id)]
        [(OptNoI64) unit])
      (if (and
        (>= entry-id 0)
        (array-ref (struct-get index reachable) entry-id))
        (begin
          (array-set! idom entry-id entry-id)
          (opt-dom-idom-fixpoint! index idom entry-id (+ count 1))
          (opt-dom-build-euler! index idom tin tout entry-id))
        (begin
          (opt-cfg-fill-i64! tin count (- 0 1))
          (opt-cfg-fill-i64! tout count (- 0 1))))
      (OptDomInfo index 0 empty idom tin tout))))

(define (opt-dom-info-dominates-id?
  [info : OptDomInfo]
  [dominator-id : i64]
  [label-id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and
      (>= dominator-id 0)
      (< dominator-id count)
      (>= label-id 0)
      (< label-id count))
      (if (and
        (array-ref (struct-get index reachable) dominator-id)
        (array-ref (struct-get index reachable) label-id))
        (let
          [dom-tin : i64 (array-ref (struct-get info tin) dominator-id)]
          [dom-tout : i64 (array-ref (struct-get info tout) dominator-id)]
          [label-tin : i64 (array-ref (struct-get info tin) label-id)]
          [label-tout : i64 (array-ref (struct-get info tout) label-id)]
          (and
            (>= dom-tin 0)
            (>= label-tin 0)
            (<= dom-tin label-tin)
            (<= label-tout dom-tout)))
        false)
      false)))

(define (opt-dom-bitset-info-dominates-id?
  [info : OptDomInfo]
  [dominator-id : i64]
  [label-id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and
      (>= dominator-id 0)
      (< dominator-id count)
      (>= label-id 0)
      (< label-id count))
      (if (and
        (array-ref (struct-get index reachable) dominator-id)
        (array-ref (struct-get index reachable) label-id))
        (opt-bits-test
          (struct-get info rows)
          (opt-dom-row-base (struct-get info words) label-id)
          dominator-id)
        false)
      false)))

(define (opt-dom-info-row-matches-legacy?
  [info : OptDomInfo]
  [legacy-labels : OptLabelSet]
  [label-id : i64]
  [dominator-id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= dominator-id count)
      true
      (let
        [label : String (opt-cfg-index-label index dominator-id)]
        [legacy-has : bool (opt-label-contains legacy-labels label)]
        [info-has : bool
          (opt-dom-info-dominates-id? info dominator-id label-id)]
        (if (or (and legacy-has info-has) (and (not legacy-has) (not info-has)))
          (opt-dom-info-row-matches-legacy?
            info
            legacy-labels
            label-id
            (+ dominator-id 1))
          false)))))

(define (opt-dom-info-matches-legacy-from?
  [info : OptDomInfo]
  [legacy : OptLegacyDomTable]
  [id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= id count)
      true
      (if (array-ref (struct-get index reachable) id)
        (let
          [label : String (opt-cfg-index-label index id)]
          [legacy-labels : OptLabelSet (opt-dom-table-lookup legacy label)]
          (if (opt-dom-info-row-matches-legacy? info legacy-labels id 0)
            (opt-dom-info-matches-legacy-from? info legacy (+ id 1))
            false))
        (opt-dom-info-matches-legacy-from? info legacy (+ id 1))))))

(define (opt-dom-info-matches-legacy?
  [info : OptDomInfo]
  [legacy : OptLegacyDomTable]) : bool
  (opt-dom-info-matches-legacy-from? info legacy 0))

(define (opt-dom-info-row-matches-bitset?
  [info : OptDomInfo]
  [bitset : OptDomInfo]
  [label-id : i64]
  [dominator-id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= dominator-id count)
      true
      (let
        [info-has : bool
          (opt-dom-info-dominates-id? info dominator-id label-id)]
        [bitset-has : bool
          (opt-dom-bitset-info-dominates-id? bitset dominator-id label-id)]
        (if (or (and info-has bitset-has) (and (not info-has) (not bitset-has)))
          (opt-dom-info-row-matches-bitset?
            info
            bitset
            label-id
            (+ dominator-id 1))
          false)))))

(define (opt-dom-info-matches-bitset-from?
  [info : OptDomInfo]
  [bitset : OptDomInfo]
  [id : i64]) : bool
  (let
    [index : OptCfgIndex (struct-get info index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= id count)
      true
      (if (opt-dom-info-row-matches-bitset? info bitset id 0)
        (opt-dom-info-matches-bitset-from? info bitset (+ id 1))
        false))))

(define (opt-dom-info-matches-bitset? [info : OptDomInfo] [bitset : OptDomInfo]) : bool
  (opt-dom-info-matches-bitset-from? info bitset 0))

(defstruct OptCfgContext
  (index OptCfgIndex)
  (pred-map OptPredMap)
  (reachable OptLabelSet)
  (entry-label String)
  (doms OptDomInfo))

(define (opt-cfg-context-build [blocks : CompilerIrBlockList]) : OptCfgContext
  (let
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    [pred-map : OptPredMap (OptPredMap index)]
    [reachable : OptLabelSet (opt-cfg-index-reachable-labels index)]
    [entry-label : String (opt-cfg-entry-label blocks)]
    [doms : OptDomInfo (opt-cfg-dominators-with index entry-label)]
    (OptCfgContext index pred-map reachable entry-label doms)))

;; (#2874) A cheap placeholder context built from an empty CFG. Used only as the
;; sentinel paired with a function on the non-heavy pass path, where the threaded
;; context is never consumed (all heavy passes are skipped together).
(define (opt-cfg-context-empty) : OptCfgContext
  (opt-cfg-context-build (IrBlockNil)))

;; (#2874) Carries an optimized function together with an OptCfgContext that is
;; valid for the returned function's *current* blocks, so the next pass in
;; optimize-function-once can reuse it for entry verification and dominance
;; queries instead of rebuilding from scratch. The context is only paired with
;; the exact block list it was built from; passes that rewrite the CFG build a
;; fresh context for their output before handing it back.
(defenum OptFunctionCtxResult
  (OptFunctionCtxResult CompilerIrFunction OptCfgContext))

(defenum OptBlockCtxResult
  (OptBlockCtxResult CompilerIrBlockList OptCfgContext bool))

(define (opt-cfg-context-all-blocks-reachable? [context : OptCfgContext]) : bool
  (let
    [index : OptCfgIndex (struct-get context index)]
    (= (struct-get index reach-count) (opt-cfg-index-block-count index))))

(define (opt-cfg-dominators [blocks : CompilerIrBlockList]) : OptDomInfo
  (struct-get (opt-cfg-context-build blocks) doms))

(define (opt-cfg-dominators-match-legacy? [blocks : CompilerIrBlockList]) : bool
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (opt-dom-info-matches-legacy?
      (struct-get context doms)
      (opt-cfg-dominators-legacy-with
        blocks
        (struct-get context pred-map)
        (struct-get context reachable)
        (struct-get context entry-label)))))

(define (opt-cfg-dominators-match-bitset? [blocks : CompilerIrBlockList]) : bool
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (opt-dom-info-matches-bitset?
      (struct-get context doms)
      (opt-cfg-dominators-bitset-with
        (struct-get context index)
        (struct-get context entry-label)))))

(define (opt-dom-dominates?
  [table : OptDomInfo]
  [dominator : String]
  [label : String]) : bool
  (match (opt-cfg-index-id (struct-get table index) dominator)
    [(OptSomeI64 dominator-id)
      (match (opt-cfg-index-id (struct-get table index) label)
        [(OptSomeI64 label-id)
          (opt-dom-info-dominates-id? table dominator-id label-id)]
        [(OptNoI64) false])]
    [(OptNoI64) false]))

(define (opt-dom-strict-dominates?
  [table : OptDomInfo]
  [dominator : String]
  [label : String]) : bool
  (and
    (not (string-eq dominator label))
    (opt-dom-dominates? table dominator label)))

(define (opt-cfg-frontier-has-reachable-pred-id?
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [label-id : i64]
  [edge : i64]
  [end : i64]) : bool
  (if (>= edge end)
    false
    (let
      [pred-id : i64
        (array-ref (struct-get (struct-get index preds) edges) edge)]
      (if (and
        (array-ref (struct-get index reachable) pred-id)
        (opt-dom-info-dominates-id? doms label-id pred-id))
        true
        (opt-cfg-frontier-has-reachable-pred-id?
          index
          doms
          label-id
          (+ edge 1)
          end)))))

(define (opt-cfg-dominance-frontier-block?
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [label-id : i64]
  [block-id : i64]) : bool
  (let
    [preds : OptCfgCsr (struct-get index preds)]
    (and
      (array-ref (struct-get index reachable) block-id)
      (opt-cfg-frontier-has-reachable-pred-id?
        index
        doms
        label-id
        (array-ref (struct-get preds offsets) block-id)
        (array-ref (struct-get preds offsets) (+ block-id 1)))
      (not
        (and
          (!= label-id block-id)
          (opt-dom-info-dominates-id? doms label-id block-id))))))

(define (opt-cfg-dominance-frontier-blocks
  [remaining : CompilerIrBlockList]
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [label-id : i64]) : OptLabelSet
  (match remaining
    [(IrBlockNil) (OptLabelNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock block-label _)
          (let
            [tail : OptLabelSet
              (opt-cfg-dominance-frontier-blocks
                (box-get rest)
                index
                doms
                label-id)]
            (match (opt-cfg-index-id index block-label)
              [(OptSomeI64 block-id)
                (if (opt-cfg-dominance-frontier-block?
                  index
                  doms
                  label-id
                  block-id)
                  (opt-label-add tail block-label)
                  tail)]
              [(OptNoI64) tail]))])]
    [(IrBlockArray seq)
      (opt-cfg-dominance-frontier-blocks
        (compiler-ir-block-seq-to-list seq)
        index
        doms
        label-id)]))

(define (opt-cfg-dominance-frontier-with-context
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [label : String]) : OptLabelSet
  (let
    [index : OptCfgIndex (struct-get context index)]
    [label-id : i64
      (match (opt-cfg-index-id index label)
        [(OptSomeI64 id) id]
        [(OptNoI64) (- 0 1)])]
    (opt-cfg-dominance-frontier-blocks
      blocks
      index
      (struct-get context doms)
      label-id)))

(define (opt-cfg-dominance-frontier
  [blocks : CompilerIrBlockList]
  [label : String]) : OptLabelSet
  (opt-cfg-dominance-frontier-with-context
    blocks
    (opt-cfg-context-build blocks)
    label))

(defenum ResultCompilerOptimizeVerify
  (OkCompilerOptimizeVerify)
  (ErrCompilerOptimizeVerify String))

(define (opt-verify-ok? [result : ResultCompilerOptimizeVerify]) : bool
  (match result
    [(OkCompilerOptimizeVerify) true]
    [(ErrCompilerOptimizeVerify _) false]))

(define (opt-verify-error-ok?
  [result : ResultCompilerOptimizeVerify]
  [want : String]) : bool
  (match result
    [(ErrCompilerOptimizeVerify message) (string-eq message want)]
    [(OkCompilerOptimizeVerify) false]))

(defenum OptVarDef
  (OptVarDef i64 String i64))

(defenum OptVarDefList
  (OptVarDefNil)
  (OptVarDefCons OptVarDef (Box OptVarDefList)))

(defenum OptMaybeVarDef
  (OptNoVarDef)
  (OptSomeVarDef OptVarDef))

(defenum OptVarSetResult
  (OptVarSetOk I64I64Map)
  (OptVarSetErr))

(define (opt-var-set-add-unique [set : I64I64Map] [var : i64]) : OptVarSetResult
  (if (opt-used-contains set var)
    (OptVarSetErr)
    (OptVarSetOk (opt-used-add set var))))

(define (opt-instr-def-var [instr : CompilerIrInstr]) : OptMaybeI64
  (match instr
    [(IrInstrMov dst _ _) (OptSomeI64 dst)]
    [(IrInstrAlloc dst _) (OptSomeI64 dst)]
    [(IrInstrAddrOf dst _) (OptSomeI64 dst)]
    [(IrInstrGep dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrLoad dst _ _) (OptSomeI64 dst)]
    [(IrInstrCast dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrBitcast dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrBinOp dst _ _ _ _) (OptSomeI64 dst)]
    [(IrInstrUnOp dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrLaneId dst _ _) (OptSomeI64 dst)]
    [(IrInstrSplat dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _) (OptSomeI64 dst)])]
    [(IrInstrVectorReduce dst _ _ _ _) (OptSomeI64 dst)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _) (OptSomeI64 dst)])]
    [(IrInstrMaskBinOp dst _ _ _ _) (OptSomeI64 dst)]
    [(IrInstrMaskNot dst _ _) (OptSomeI64 dst)]
    [(IrInstrMaskReduce dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _) (OptSomeI64 dst)])]
    [(IrInstrVectorLoad dst _ _ _ _) (OptSomeI64 dst)]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _) (OptSomeI64 dst)])]
    [(IrInstrTailMask dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrEntryArgc dst) (OptSomeI64 dst)]
    [(IrInstrEntryArgv dst) (OptSomeI64 dst)]
    [(IrInstrEntryEnvp dst) (OptSomeI64 dst)]
    [(IrInstrCpuId dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrXgetbv dst _) (OptSomeI64 dst)]
    [(IrInstrSyscall dst _) (OptSomeI64 dst)]
    [(IrInstrCall dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrPhi dst _ _) (OptSomeI64 dst)]
    ;; #2386: Pack/Word define their dst like any scalar op. Without these arms
    ;; the verifier saw every use of a register-group word as use-before-def
    ;; and silently knocked aggregate-using functions out of SSA/GVN/LICM.
    [(IrInstrPack dst _ _) (OptSomeI64 dst)]
    [(IrInstrWord dst _ _ _) (OptSomeI64 dst)]
    [_ (OptNoI64)]))

(define (opt-instr-def-position [instr : CompilerIrInstr] [pos : i64]) : i64
  (match instr
    [(IrInstrPhi _ _ _) 0]
    [_ pos]))

(define (opt-verify-param-def-set
  [params : CompilerIrParamList]
  [set : I64I64Map]) : OptVarSetResult
  (match params
    [(IrParamNil) (OptVarSetOk set)]
    [(IrParamCons param rest)
      (match param
        [(IrParam _ _ var)
          (match (opt-var-set-add-unique set var)
            [(OptVarSetOk next) (opt-verify-param-def-set (box-get rest) next)]
            [(OptVarSetErr) (OptVarSetErr)])])]))

(define (opt-verify-instr-def-set
  [instrs : CompilerIrInstrList]
  [set : I64I64Map]) : OptVarSetResult
  (match instrs
    [(IrInstrNil) (OptVarSetOk set)]
    [(IrInstrCons instr rest)
      (match (opt-instr-def-var instr)
        [(OptSomeI64 var)
          (match (opt-var-set-add-unique set var)
            [(OptVarSetOk next) (opt-verify-instr-def-set (box-get rest) next)]
            [(OptVarSetErr) (OptVarSetErr)])]
        [(OptNoI64) (opt-verify-instr-def-set (box-get rest) set)])]))

(define (opt-verify-instr-def-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [set : I64I64Map]) : OptVarSetResult
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptVarSetOk set)
    (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs index))
      [(OptSomeI64 var)
        (match (opt-var-set-add-unique set var)
          [(OptVarSetOk next)
            (opt-verify-instr-def-seq-from instrs (+ index 1) next)]
          [(OptVarSetErr) (OptVarSetErr)])]
      [(OptNoI64) (opt-verify-instr-def-seq-from instrs (+ index 1) set)])))

(define (opt-verify-block-def-set
  [blocks : CompilerIrBlockList]
  [set : I64I64Map]) : OptVarSetResult
  (match blocks
    [(IrBlockNil) (OptVarSetOk set)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (match (opt-verify-instr-def-seq-from instrs 0 set)
            [(OptVarSetOk next) (opt-verify-block-def-set (box-get rest) next)]
            [(OptVarSetErr) (OptVarSetErr)])])]
    [(IrBlockArray seq)
      (opt-verify-block-def-set (compiler-ir-block-seq-to-list seq) set)]))

(define (opt-verify-single-defs?
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : bool
  (match (opt-verify-param-def-set params (i64-i64-map-with-capacity 64))
    [(OptVarSetErr) false]
    [(OptVarSetOk param-set)
      (match (opt-verify-block-def-set blocks param-set)
        [(OptVarSetOk _) true]
        [(OptVarSetErr) false])]))

(define (opt-var-defs-from-params
  [params : CompilerIrParamList]
  [entry-label : String]
  [defs : OptVarDefList]) : OptVarDefList
  (match params
    [(IrParamNil) defs]
    [(IrParamCons param rest)
      (match param
        [(IrParam _ _ var)
          (opt-var-defs-from-params
            (box-get rest)
            entry-label
            (OptVarDefCons (OptVarDef var entry-label 0) (box defs)))])]))

(define (opt-var-defs-from-instrs
  [instrs : CompilerIrInstrList]
  [block-label : String]
  [pos : i64]
  [defs : OptVarDefList]) : OptVarDefList
  (match instrs
    [(IrInstrNil) defs]
    [(IrInstrCons instr rest)
      (match (opt-instr-def-var instr)
        [(OptSomeI64 var)
          (opt-var-defs-from-instrs
            (box-get rest)
            block-label
            (+ pos 1)
            (OptVarDefCons
              (OptVarDef var block-label (opt-instr-def-position instr pos))
              (box defs)))]
        [(OptNoI64)
          (opt-var-defs-from-instrs (box-get rest) block-label (+ pos 1) defs)])]))

(define (opt-var-defs-from-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [block-label : String]
  [index : i64]
  [pos : i64]
  [defs : OptVarDefList]) : OptVarDefList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    defs
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(OptSomeI64 var)
          (opt-var-defs-from-instr-seq-from
            instrs
            block-label
            (+ index 1)
            (+ pos 1)
            (OptVarDefCons
              (OptVarDef var block-label (opt-instr-def-position instr pos))
              (box defs)))]
        [(OptNoI64)
          (opt-var-defs-from-instr-seq-from
            instrs
            block-label
            (+ index 1)
            (+ pos 1)
            defs)]))))

(define (opt-var-defs-from-blocks
  [blocks : CompilerIrBlockList]
  [defs : OptVarDefList]) : OptVarDefList
  (match blocks
    [(IrBlockNil) defs]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (opt-var-defs-from-blocks
            (box-get rest)
            (opt-var-defs-from-instr-seq-from instrs label 0 1 defs))])]
    [(IrBlockArray seq)
      (opt-var-defs-from-blocks (compiler-ir-block-seq-to-list seq) defs)]))

(define (opt-var-defs-from-function
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptVarDefList
  (opt-var-defs-from-blocks
    blocks
    (opt-var-defs-from-params
      params
      (opt-cfg-entry-label blocks)
      (OptVarDefNil))))

;; #2117: the use verifier resolves every operand's defining block, so the
;; def list is indexed into a var-id-keyed array once per verification
;; (the list scan per use made the verifier quadratic on large functions).
(define (opt-var-defs-max-id [defs : OptVarDefList] [highest : i64]) : i64
  (match defs
    [(OptVarDefNil) highest]
    [(OptVarDefCons def rest)
      (match def
        [(OptVarDef var _ _)
          (opt-var-defs-max-id
            (box-get rest)
            (if (> var highest)
              var
              highest))])]))

(define (opt-var-defs-index-fill!
  [items : (Array OptMaybeVarDef)]
  [defs : OptVarDefList]) : unit
  (match defs
    [(OptVarDefNil) unit]
    [(OptVarDefCons def rest)
      (begin
        (match def
          [(OptVarDef var _ _)
            (if (and (>= var 0) (< var (array-length items)))
              (array-set! items var (OptSomeVarDef def))
              unit)])
        (opt-var-defs-index-fill! items (box-get rest)))]))

(define (opt-var-defs-index [defs : OptVarDefList]) : (Array OptMaybeVarDef)
  (let
    [count : i64 (+ (opt-var-defs-max-id defs (- 0 1)) 1)]
    [items : (Array OptMaybeVarDef) (make-array OptMaybeVarDef count)]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! items i (OptNoVarDef))
          (set! i (+ i 1))))
      (opt-var-defs-index-fill! items defs)
      items)))

(define (opt-var-def-lookup [defs : (Array OptMaybeVarDef)] [var : i64]) : OptMaybeVarDef
  (if (and (>= var 0) (< var (array-length defs)))
    (array-ref defs var)
    (OptNoVarDef)))

(define (opt-verify-var-use
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [var : i64]
  [use-block : String]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match (opt-var-def-lookup defs var)
    [(OptNoVarDef)
      (ErrCompilerOptimizeVerify "optimizer verify: use before definition")]
    [(OptSomeVarDef def)
      (match def
        [(OptVarDef _ def-block def-pos)
          (if (not (opt-dom-dominates? doms def-block use-block))
            (ErrCompilerOptimizeVerify
              "optimizer verify: use is not dominated by definition")
            (if (and (string-eq def-block use-block) (>= def-pos use-pos))
              (ErrCompilerOptimizeVerify
                "optimizer verify: use before definition")
              (OkCompilerOptimizeVerify)))])]))

(define (opt-verify-var-use-on-edge
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [var : i64]
  [pred-label : String]) : ResultCompilerOptimizeVerify
  (match (opt-var-def-lookup defs var)
    [(OptNoVarDef)
      (ErrCompilerOptimizeVerify "optimizer verify: use before definition")]
    [(OptSomeVarDef def)
      (match def
        [(OptVarDef _ def-block _)
          (if (opt-dom-dominates? doms def-block pred-label)
            (OkCompilerOptimizeVerify)
            (ErrCompilerOptimizeVerify
              "optimizer verify: use is not dominated by definition"))])]))

(define (opt-verify-value-use
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [value : CompilerIrValue]
  [use-block : String]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match value
    [(IrValueVar var) (opt-verify-var-use defs doms var use-block use-pos)]
    [_ (OkCompilerOptimizeVerify)]))

(define (opt-verify-value-list-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [values : CompilerIrValueList]
  [use-block : String]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match values
    [(IrValueNil) (OkCompilerOptimizeVerify)]
    [(IrValueCons value rest)
      (match (opt-verify-value-use defs doms value use-block use-pos)
        [(OkCompilerOptimizeVerify)
          (opt-verify-value-list-uses
            defs
            doms
            (box-get rest)
            use-block
            use-pos)]
        [(ErrCompilerOptimizeVerify message)
          (ErrCompilerOptimizeVerify message)])]))

(define (opt-verify-call-args-array-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [values : (Array CompilerIrValue)]
  [use-block : String]
  [use-pos : i64]
  [index : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (array-length values))
    (OkCompilerOptimizeVerify)
    (match (opt-verify-value-use
      defs
      doms
      (array-ref values index)
      use-block
      use-pos)
      [(OkCompilerOptimizeVerify)
        (opt-verify-call-args-array-uses
          defs
          doms
          values
          use-block
          use-pos
          (+ index 1))]
      [(ErrCompilerOptimizeVerify message) (ErrCompilerOptimizeVerify message)])))

(define (opt-verify-call-args-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [args : CompilerIrCallArgs]
  [use-block : String]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match args
    [(IrCallArgsNil) (OkCompilerOptimizeVerify)]
    [(IrCallArgsOne value)
      (opt-verify-value-use defs doms value use-block use-pos)]
    [(IrCallArgsTwo a b)
      (opt-verify-two
        (opt-verify-value-use defs doms a use-block use-pos)
        (opt-verify-value-use defs doms b use-block use-pos))]
    [(IrCallArgsArray values)
      (opt-verify-call-args-array-uses defs doms values use-block use-pos 0)]))

(define (opt-verify-maybe-value-use
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [value : CompilerIrMaybeValue]
  [use-block : String]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match value
    [(IrNoValue) (OkCompilerOptimizeVerify)]
    [(IrSomeValue inner)
      (opt-verify-value-use defs doms inner use-block use-pos)]))

(define (opt-verify-phi-input-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [inputs : CompilerIrPhiInputList]) : ResultCompilerOptimizeVerify
  (match inputs
    [(IrPhiInputNil) (OkCompilerOptimizeVerify)]
    [(IrPhiInputCons value pred-label rest)
      (match value
        [(IrValueVar var)
          (match (opt-verify-var-use-on-edge defs doms var pred-label)
            [(OkCompilerOptimizeVerify)
              (opt-verify-phi-input-uses defs doms (box-get rest))]
            [(ErrCompilerOptimizeVerify message)
              (ErrCompilerOptimizeVerify message)])]
        [_ (opt-verify-phi-input-uses defs doms (box-get rest))])]))

(define (opt-verify-two
  [a : ResultCompilerOptimizeVerify]
  [b : ResultCompilerOptimizeVerify]) : ResultCompilerOptimizeVerify
  (match a
    [(OkCompilerOptimizeVerify) b]
    [(ErrCompilerOptimizeVerify message) (ErrCompilerOptimizeVerify message)]))

(define (opt-verify-instr-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [block-label : String]
  [pos : i64]
  [instr : CompilerIrInstr]) : ResultCompilerOptimizeVerify
  (match instr
    [(IrInstrMov _ src _) (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrAddrOf _ src) (opt-verify-var-use defs doms src block-label pos)]
    [(IrInstrGep _ base offset _)
      (opt-verify-two
        (opt-verify-value-use defs doms base block-label pos)
        (opt-verify-value-use defs doms offset block-label pos))]
    [(IrInstrLoad _ src _) (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrStorePtr ptr value _)
      (opt-verify-two
        (opt-verify-value-use defs doms ptr block-label pos)
        (opt-verify-value-use defs doms value block-label pos))]
    [(IrInstrCopyBytes dst src _)
      (opt-verify-two
        (opt-verify-value-use defs doms dst block-label pos)
        (opt-verify-value-use defs doms src block-label pos))]
    [(IrInstrBoundsCheck index length _)
      (opt-verify-two
        (opt-verify-value-use defs doms index block-label pos)
        (opt-verify-value-use defs doms length block-label pos))]
    [(IrInstrCast _ src _ _)
      (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrBitcast _ src _ _)
      (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrBinOp _ _ lhs rhs _)
      (opt-verify-two
        (opt-verify-value-use defs doms lhs block-label pos)
        (opt-verify-value-use defs doms rhs block-label pos))]
    [(IrInstrUnOp _ _ src _)
      (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrSplat _ src _ _)
      (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ lhs rhs _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms lhs block-label pos)
            (opt-verify-value-use defs doms rhs block-label pos))])]
    [(IrInstrVectorReduce _ _ src _ _)
      (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ lhs rhs _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms lhs block-label pos)
            (opt-verify-value-use defs doms rhs block-label pos))])]
    [(IrInstrMaskBinOp _ _ lhs rhs _)
      (opt-verify-two
        (opt-verify-value-use defs doms lhs block-label pos)
        (opt-verify-value-use defs doms rhs block-label pos))]
    [(IrInstrMaskNot _ src _)
      (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrMaskReduce _ _ src _)
      (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ mask on-true on-false _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms mask block-label pos)
            (opt-verify-two
              (opt-verify-value-use defs doms on-true block-label pos)
              (opt-verify-value-use defs doms on-false block-label pos)))])]
    [(IrInstrVectorLoad _ base index _ _)
      (opt-verify-two
        (opt-verify-value-use defs doms base block-label pos)
        (opt-verify-value-use defs doms index block-label pos))]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload base index value _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-label pos)
            (opt-verify-two
              (opt-verify-value-use defs doms index block-label pos)
              (opt-verify-value-use defs doms value block-label pos)))])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload base index value mask _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-label pos)
            (opt-verify-two
              (opt-verify-value-use defs doms index block-label pos)
              (opt-verify-two
                (opt-verify-value-use defs doms value block-label pos)
                (opt-verify-value-use defs doms mask block-label pos))))])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload _ base index mask _ _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-label pos)
            (opt-verify-two
              (opt-verify-value-use defs doms index block-label pos)
              (opt-verify-value-use defs doms mask block-label pos)))])]
    [(IrInstrTailMask _ index length _)
      (opt-verify-two
        (opt-verify-value-use defs doms index block-label pos)
        (opt-verify-value-use defs doms length block-label pos))]
    [(IrInstrEntryArgc _) (OkCompilerOptimizeVerify)]
    [(IrInstrEntryArgv _) (OkCompilerOptimizeVerify)]
    [(IrInstrEntryEnvp _) (OkCompilerOptimizeVerify)]
    [(IrInstrCpuId _ leaf subleaf _)
      (opt-verify-two
        (opt-verify-value-use defs doms leaf block-label pos)
        (opt-verify-value-use defs doms subleaf block-label pos))]
    [(IrInstrXgetbv _ index)
      (opt-verify-value-use defs doms index block-label pos)]
    [(IrInstrSyscall _ args)
      (opt-verify-call-args-uses defs doms args block-label pos)]
    [(IrInstrCall _ _ args _)
      (opt-verify-call-args-uses defs doms args block-label pos)]
    [(IrInstrCallIndirect _ func args _)
      (opt-verify-two
        (opt-verify-value-use defs doms func block-label pos)
        (opt-verify-call-args-uses defs doms args block-label pos))]
    [(IrInstrCallIndirectC _ func args _)
      (opt-verify-two
        (opt-verify-value-use defs doms func block-label pos)
        (opt-verify-call-args-uses defs doms args block-label pos))]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base _ args _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-label pos)
            (opt-verify-call-args-uses defs doms args block-label pos))])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload base func args _)
          (opt-verify-two
            (opt-verify-value-use defs doms base block-label pos)
            (opt-verify-two
              (opt-verify-value-use defs doms func block-label pos)
              (opt-verify-call-args-uses defs doms args block-label pos)))])]
    [(IrInstrTailCall _ args _)
      (opt-verify-call-args-uses defs doms args block-label pos)]
    [(IrInstrStore _ value _)
      (opt-verify-value-use defs doms value block-label pos)]
    [(IrInstrBranch cond _ _)
      (opt-verify-value-use defs doms cond block-label pos)]
    [(IrInstrReturn maybe)
      (opt-verify-maybe-value-use defs doms maybe block-label pos)]
    [(IrInstrPhi _ inputs _) (opt-verify-phi-input-uses defs doms inputs)]
    [(IrInstrAlloc _ _) (OkCompilerOptimizeVerify)]
    [(IrInstrLaneId _ _ _) (OkCompilerOptimizeVerify)]
    [(IrInstrJump _) (OkCompilerOptimizeVerify)]
    ;; #2386: verify register-group operands dominate their use.
    [(IrInstrPack _ words _)
      (opt-verify-value-list-uses defs doms words block-label pos)]
    [(IrInstrWord _ src _ _)
      (opt-verify-value-use defs doms src block-label pos)]
    [(IrInstrTailCallIndirect func args _)
      (opt-verify-two
        (opt-verify-value-use defs doms func block-label pos)
        (opt-verify-call-args-uses defs doms args block-label pos))]))

(define (opt-verify-instr-list-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [block-label : String]
  [instrs : CompilerIrInstrList]
  [pos : i64]) : ResultCompilerOptimizeVerify
  (match instrs
    [(IrInstrNil) (OkCompilerOptimizeVerify)]
    [(IrInstrCons instr rest)
      (match (opt-verify-instr-uses defs doms block-label pos instr)
        [(OkCompilerOptimizeVerify)
          (opt-verify-instr-list-uses
            defs
            doms
            block-label
            (box-get rest)
            (+ pos 1))]
        [(ErrCompilerOptimizeVerify message)
          (ErrCompilerOptimizeVerify message)])]))

(define (opt-verify-instr-seq-uses-from
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [block-label : String]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [pos : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OkCompilerOptimizeVerify)
    (match (opt-verify-instr-uses
      defs
      doms
      block-label
      pos
      (compiler-ir-instr-seq-ref instrs index))
      [(OkCompilerOptimizeVerify)
        (opt-verify-instr-seq-uses-from
          defs
          doms
          block-label
          instrs
          (+ index 1)
          (+ pos 1))]
      [(ErrCompilerOptimizeVerify message) (ErrCompilerOptimizeVerify message)])))

(define (opt-phi-input-labels [inputs : CompilerIrPhiInputList]) : OptLabelSet
  (match inputs
    [(IrPhiInputNil) (OptLabelNil)]
    [(IrPhiInputCons _ label rest)
      (opt-label-add (opt-phi-input-labels (box-get rest)) label)]))

(define (opt-phi-input-labels-unique-from?
  [inputs : CompilerIrPhiInputList]
  [seen : OptLabelSet]) : bool
  (match inputs
    [(IrPhiInputNil) true]
    [(IrPhiInputCons _ label rest)
      (if (opt-label-contains seen label)
        false
        (opt-phi-input-labels-unique-from?
          (box-get rest)
          (opt-label-add seen label)))]))

(define (opt-phi-input-labels-match?
  [inputs : CompilerIrPhiInputList]
  [preds : OptLabelSet]) : bool
  (and
    (opt-phi-input-labels-unique-from? inputs (OptLabelNil))
    (opt-label-set-eq? (opt-phi-input-labels inputs) preds)))

(define (opt-verify-phi-predecessors-instrs
  [pred-map : OptPredMap]
  [block-label : String]
  [instrs : CompilerIrInstrList]) : ResultCompilerOptimizeVerify
  (match instrs
    [(IrInstrNil) (OkCompilerOptimizeVerify)]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrPhi _ inputs _)
          (if (opt-phi-input-labels-match?
            inputs
            (opt-pred-map-lookup pred-map block-label))
            (opt-verify-phi-predecessors-instrs
              pred-map
              block-label
              (box-get rest))
            (ErrCompilerOptimizeVerify
              "optimizer verify: phi predecessor mismatch"))]
        [_
          (opt-verify-phi-predecessors-instrs
            pred-map
            block-label
            (box-get rest))])]))

(define (opt-verify-phi-predecessors-instr-seq-from
  [pred-map : OptPredMap]
  [block-label : String]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OkCompilerOptimizeVerify)
    (match (compiler-ir-instr-seq-ref instrs index)
      [(IrInstrPhi _ inputs _)
        (if (opt-phi-input-labels-match?
          inputs
          (opt-pred-map-lookup pred-map block-label))
          (opt-verify-phi-predecessors-instr-seq-from
            pred-map
            block-label
            instrs
            (+ index 1))
          (ErrCompilerOptimizeVerify
            "optimizer verify: phi predecessor mismatch"))]
      [_
        (opt-verify-phi-predecessors-instr-seq-from
          pred-map
          block-label
          instrs
          (+ index 1))])))

(define (opt-verify-phi-predecessors-blocks
  [pred-map : OptPredMap]
  [remaining : CompilerIrBlockList]) : ResultCompilerOptimizeVerify
  (match remaining
    [(IrBlockNil) (OkCompilerOptimizeVerify)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (match (opt-verify-phi-predecessors-instr-seq-from
            pred-map
            label
            instrs
            0)
            [(OkCompilerOptimizeVerify)
              (opt-verify-phi-predecessors-blocks pred-map (box-get rest))]
            [(ErrCompilerOptimizeVerify message)
              (ErrCompilerOptimizeVerify message)])])]
    [(IrBlockArray seq)
      (opt-verify-phi-predecessors-blocks
        pred-map
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-verify-block-uses
  [defs : (Array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [blocks : CompilerIrBlockList]) : ResultCompilerOptimizeVerify
  (match blocks
    [(IrBlockNil) (OkCompilerOptimizeVerify)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (match (opt-verify-instr-seq-uses-from defs doms label instrs 0 1)
            [(OkCompilerOptimizeVerify)
              (opt-verify-block-uses defs doms (box-get rest))]
            [(ErrCompilerOptimizeVerify message)
              (ErrCompilerOptimizeVerify message)])])]
    [(IrBlockArray seq)
      (opt-verify-block-uses defs doms (compiler-ir-block-seq-to-list seq))]))

(define (opt-verify-function-with-context
  [func : CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (match func
    [(IrFunction _ params _ _ blocks)
      (cond
        [(not (opt-cfg-block-labels-unique? blocks))
          (ErrCompilerOptimizeVerify "optimizer verify: duplicate block label")]
        [(not (opt-cfg-successor-targets-known? blocks))
          (ErrCompilerOptimizeVerify
            "optimizer verify: unknown successor label")]
        [(not (opt-verify-single-defs? params blocks))
          (ErrCompilerOptimizeVerify
            "optimizer verify: duplicate var definition")]
        [else
          (let
            [doms : OptDomInfo (struct-get context doms)]
            [pred-map : OptPredMap (struct-get context pred-map)]
            [defs : (Array OptMaybeVarDef)
              (opt-var-defs-index (opt-var-defs-from-function params blocks))]
            (match (opt-verify-phi-predecessors-blocks pred-map blocks)
              [(OkCompilerOptimizeVerify)
                (opt-verify-block-uses defs doms blocks)]
              [(ErrCompilerOptimizeVerify message)
                (ErrCompilerOptimizeVerify message)]))])]))

(define (opt-verify-function [func : CompilerIrFunction]) : ResultCompilerOptimizeVerify
  (match func
    [(IrFunction _ params _ _ blocks)
      (cond
        [(not (opt-cfg-block-labels-unique? blocks))
          (ErrCompilerOptimizeVerify "optimizer verify: duplicate block label")]
        [(not (opt-cfg-successor-targets-known? blocks))
          (ErrCompilerOptimizeVerify
            "optimizer verify: unknown successor label")]
        [(not (opt-verify-single-defs? params blocks))
          (ErrCompilerOptimizeVerify
            "optimizer verify: duplicate var definition")]
        [else
          (opt-verify-function-with-context func (opt-cfg-context-build blocks))])]))

(define (opt-verify-function-list [functions : CompilerIrFunctionList]) : ResultCompilerOptimizeVerify
  (match functions
    [(IrFunctionNil) (OkCompilerOptimizeVerify)]
    [(IrFunctionCons func rest)
      (match (opt-verify-function func)
        [(OkCompilerOptimizeVerify) (opt-verify-function-list (box-get rest))]
        [(ErrCompilerOptimizeVerify message)
          (ErrCompilerOptimizeVerify message)])]
    [(IrFunctionArray seq)
      (opt-verify-function-list (compiler-ir-function-seq-to-list seq))]))

(define (opt-verify-program [program : CompilerIrProgram]) : ResultCompilerOptimizeVerify
  (match program
    [(IrProgram _ functions _) (opt-verify-function-list functions)]))

;; --- standalone scalar SSA construction / mem2reg (#2188) ------------------
;;
;; This constructor rewrites repeated scalar virtual-register definitions into
;; single-assignment form and inserts phis at dominance frontiers. It is
;; deliberately verifier-gated: unsupported shapes leave the function unchanged.
;; This first slice handles functions without pre-existing phi nodes, which keeps
;; edge-sensitive phi-input rewriting separate from the lowering-time phis.
(defenum OptMaybeAstType
  (OptNoAstType)
  (OptSomeAstType AstType))

(defenum OptSsaVarTypes
  (OptSsaVarTypesNil)
  (OptSsaVarTypesCons i64 AstType (Box OptSsaVarTypes)))

(defenum OptSsaFacts
  (OptSsaFacts I64I64Map I64I64Map OptSsaVarTypes))

(defenum OptSsaVarBlocks
  (OptSsaVarBlocksNil)
  (OptSsaVarBlocksCons i64 OptLabelSet (Array bool) (Box OptSsaVarBlocks)))

(defenum OptSsaPhiSite
  (OptSsaPhiSite i64 String AstType i64))

(defenum OptSsaPhiSites
  (OptSsaPhiSitesNil)
  (OptSsaPhiSitesCons OptSsaPhiSite (Box OptSsaPhiSites)))

(defenum OptSsaPhiInsertState
  (OptSsaPhiInsertState
    OptSsaPhiSites
    i64
    OptLabelSet
    (Array bool)
    (Array bool)))

(defenum OptSsaRenameEnv
  (OptSsaRenameNil)
  (OptSsaRenameCons i64 i64 (Box OptSsaRenameEnv)))

(defenum OptSsaRenameBlock
  (OptSsaRenameBlock String CompilerIrInstrList))

(defenum OptSsaRenameBlocks
  (OptSsaRenameBlocksNil)
  (OptSsaRenameBlocksCons OptSsaRenameBlock (Box OptSsaRenameBlocks)))

(defenum OptSsaBlockOut
  (OptSsaBlockOut String OptSsaRenameEnv))

(defenum OptSsaBlockOuts
  (OptSsaBlockOutsNil)
  (OptSsaBlockOutsCons OptSsaBlockOut (Box OptSsaBlockOuts)))

(defenum OptSsaRenameState
  (OptSsaRenameState OptSsaRenameBlocks OptSsaBlockOuts i64))

(defenum OptSsaDstResult
  (OptSsaDstResult i64 OptSsaRenameEnv i64))

(defenum OptSsaInstrResult
  (OptSsaInstrResult CompilerIrInstr OptSsaRenameEnv i64))

(defenum OptSsaBlockResult
  (OptSsaBlockResult CompilerIrInstrList OptSsaRenameEnv i64))

(define (opt-ssa-count [counts : I64I64Map] [var : i64]) : i64
  (match (i64-i64-map-get counts var)
    [(I64I64MapFound n) n]
    [(I64I64MapMissing) 0]))

(define (opt-ssa-count-add [counts : I64I64Map] [var : i64]) : I64I64Map
  (i64-i64-map-put counts var (+ 1 (opt-ssa-count counts var))))

(define (opt-ssa-scalar-type? [ty : AstType]) : bool
  (match ty
    [(AstTyI64) true]
    [(AstTyI32) true]
    [(AstTyI16) true]
    [(AstTyI8) true]
    [(AstTyU64) true]
    [(AstTyU32) true]
    [(AstTyU16) true]
    [(AstTyU8) true]
    [(AstTyF64) true]
    [(AstTyF32) true]
    [(AstTyBool) true]
    [(AstTyChar) true]
    [(AstTyPtr _) true]
    [(AstTyMutPtr _) true]
    [(AstTyRef _ _) true]
    [(AstTyMutRef _ _) true]
    [_ false]))

(define (opt-ssa-var-type-lookup [types : OptSsaVarTypes] [var : i64]) : OptMaybeAstType
  (match types
    [(OptSsaVarTypesNil) (OptNoAstType)]
    [(OptSsaVarTypesCons id ty rest)
      (if (= id var)
        (OptSomeAstType ty)
        (opt-ssa-var-type-lookup (box-get rest) var))]))

(define (opt-ssa-facts-bad-var [facts : OptSsaFacts] [var : i64]) : OptSsaFacts
  (match facts
    [(OptSsaFacts counts bad types)
      (OptSsaFacts counts (opt-used-add bad var) types)]))

(define (opt-ssa-facts-add-def-bad [facts : OptSsaFacts] [var : i64]) : OptSsaFacts
  (match facts
    [(OptSsaFacts counts bad types)
      (OptSsaFacts (opt-ssa-count-add counts var) (opt-used-add bad var) types)]))

(define (opt-ssa-facts-add-def-ty
  [facts : OptSsaFacts]
  [var : i64]
  [ty : AstType]) : OptSsaFacts
  (match facts
    [(OptSsaFacts counts bad types)
      (let
        [next-counts : I64I64Map (opt-ssa-count-add counts var)]
        (if (not (opt-ssa-scalar-type? ty))
          (OptSsaFacts next-counts (opt-used-add bad var) types)
          (match (opt-ssa-var-type-lookup types var)
            [(OptNoAstType)
              (OptSsaFacts
                next-counts
                bad
                (OptSsaVarTypesCons var ty (box types)))]
            [(OptSomeAstType old)
              (OptSsaFacts
                next-counts
                (if (opt-type-eq old ty)
                  bad
                  (opt-used-add bad var))
                types)])))]))

(define (opt-ssa-facts-add-param
  [facts : OptSsaFacts]
  [param : CompilerIrParam]) : OptSsaFacts
  (match param
    [(IrParam _ ty var) (opt-ssa-facts-add-def-ty facts var ty)]))

(define (opt-ssa-facts-add-params
  [params : CompilerIrParamList]
  [facts : OptSsaFacts]) : OptSsaFacts
  (match params
    [(IrParamNil) facts]
    [(IrParamCons param rest)
      (opt-ssa-facts-add-params
        (box-get rest)
        (opt-ssa-facts-add-param facts param))]))

(define (opt-ssa-facts-add-instr
  [facts : OptSsaFacts]
  [instr : CompilerIrInstr]) : OptSsaFacts
  (match instr
    [(IrInstrMov dst _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrLoad dst _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrCast dst _ _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrBitcast dst _ _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrBinOp dst _ _ _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrUnOp dst _ _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrCall dst _ _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrCallIndirect dst _ _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrCallIndirectC dst _ _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrPhi dst _ ty) (opt-ssa-facts-add-def-ty facts dst ty)]
    [(IrInstrEntryArgc dst) (opt-ssa-facts-add-def-ty facts dst (AstTyI64))]
    [(IrInstrAddrOf dst src)
      (opt-ssa-facts-bad-var (opt-ssa-facts-add-def-bad facts dst) src)]
    [(IrInstrAlloc dst _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrGep dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrLaneId dst _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrSplat dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(IrInstrVectorReduce dst _ _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(IrInstrMaskBinOp dst _ _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrMaskNot dst _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrMaskReduce dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(IrInstrVectorLoad dst _ _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (opt-ssa-facts-add-def-bad facts dst)])]
    [(IrInstrTailMask dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrEntryArgv dst) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrEntryEnvp dst) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrCpuId dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrXgetbv dst _) (opt-ssa-facts-add-def-bad facts dst)]
    [(IrInstrSyscall dst _) (opt-ssa-facts-add-def-bad facts dst)]
    [_ facts]))

(define (opt-ssa-facts-add-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [facts : OptSsaFacts]) : OptSsaFacts
  (if (>= index (compiler-ir-instr-seq-count instrs))
    facts
    (opt-ssa-facts-add-instr-seq-from
      instrs
      (+ index 1)
      (opt-ssa-facts-add-instr facts (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-ssa-facts-add-blocks
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]) : OptSsaFacts
  (match blocks
    [(IrBlockNil) facts]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-ssa-facts-add-blocks
            (box-get rest)
            (opt-ssa-facts-add-instr-seq-from instrs 0 facts))])]
    [(IrBlockArray seq)
      (opt-ssa-facts-add-blocks (compiler-ir-block-seq-to-list seq) facts)]))

(define (opt-ssa-facts-from-function
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptSsaFacts
  (opt-ssa-facts-add-blocks
    blocks
    (opt-ssa-facts-add-params
      params
      (OptSsaFacts
        (i64-i64-map-with-capacity 64)
        (i64-i64-map-with-capacity 64)
        (OptSsaVarTypesNil)))))

(define (opt-ssa-candidate? [facts : OptSsaFacts] [var : i64]) : bool
  (match facts
    [(OptSsaFacts counts bad types)
      (and
        (> (opt-ssa-count counts var) 1)
        (not (opt-used-contains bad var))
        (match (opt-ssa-var-type-lookup types var)
          [(OptSomeAstType _) true]
          [(OptNoAstType) false]))]))

(define (opt-ssa-any-candidate-types?
  [facts : OptSsaFacts]
  [types : OptSsaVarTypes]) : bool
  (match types
    [(OptSsaVarTypesNil) false]
    [(OptSsaVarTypesCons var _ rest)
      (if (opt-ssa-candidate? facts var)
        true
        (opt-ssa-any-candidate-types? facts (box-get rest)))]))

(define (opt-ssa-any-candidate? [facts : OptSsaFacts]) : bool
  (match facts
    [(OptSsaFacts _ _ types) (opt-ssa-any-candidate-types? facts types)]))

(define (opt-ssa-label-members-new [index : OptCfgIndex]) : (Array bool)
  (let
    [members : (Array bool) (make-array bool (opt-cfg-index-block-count index))]
    (begin
      (opt-cfg-fill-bool! members (array-length members) false)
      members)))

(define (opt-ssa-label-member? [members : (Array bool)] [id : i64]) : bool
  (if (and (>= id 0) (< id (array-length members)))
    (array-ref members id)
    false))

(define (opt-ssa-label-add-with-members
  [index : OptCfgIndex]
  [members : (Array bool)]
  [labels : OptLabelSet]
  [label : String]) : OptLabelSet
  (match (opt-cfg-index-id index label)
    [(OptSomeI64 id)
      (if (opt-ssa-label-member? members id)
        labels
        (begin
          (array-set! members id true)
          (OptLabelCons label (box labels))))]
    [(OptNoI64) (opt-label-add labels label)]))

(define (opt-ssa-label-mark-members!
  [index : OptCfgIndex]
  [members : (Array bool)]
  [labels : OptLabelSet]) : unit
  (match labels
    [(OptLabelNil) unit]
    [(OptLabelCons label rest)
      (begin
        (match (opt-cfg-index-id index label)
          [(OptSomeI64 id)
            (if (and (>= id 0) (< id (array-length members)))
              (array-set! members id true)
              unit)]
          [(OptNoI64) unit])
        (opt-ssa-label-mark-members! index members (box-get rest)))]))

(define (opt-ssa-var-blocks-add
  [index : OptCfgIndex]
  [blocks : OptSsaVarBlocks]
  [var : i64]
  [label : String]) : OptSsaVarBlocks
  (match blocks
    [(OptSsaVarBlocksNil)
      (let
        [members : (Array bool) (opt-ssa-label-members-new index)]
        [labels : OptLabelSet
          (opt-ssa-label-add-with-members index members (OptLabelNil) label)]
        (OptSsaVarBlocksCons var labels members (box (OptSsaVarBlocksNil))))]
    [(OptSsaVarBlocksCons id labels members rest)
      (if (= id var)
        (OptSsaVarBlocksCons
          id
          (opt-ssa-label-add-with-members index members labels label)
          members
          rest)
        (OptSsaVarBlocksCons
          id
          labels
          members
          (box (opt-ssa-var-blocks-add index (box-get rest) var label))))]))

(define (opt-ssa-var-blocks-lookup [blocks : OptSsaVarBlocks] [var : i64]) : OptLabelSet
  (match blocks
    [(OptSsaVarBlocksNil) (OptLabelNil)]
    [(OptSsaVarBlocksCons id labels _ rest)
      (if (= id var)
        labels
        (opt-ssa-var-blocks-lookup (box-get rest) var))]))

(define (opt-ssa-def-blocks-add-param
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : String]
  [defs : OptSsaVarBlocks]
  [param : CompilerIrParam]) : OptSsaVarBlocks
  (match param
    [(IrParam _ _ var)
      (if (opt-ssa-candidate? facts var)
        (opt-ssa-var-blocks-add index defs var label)
        defs)]))

(define (opt-ssa-def-blocks-add-params
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : String]
  [defs : OptSsaVarBlocks]
  [params : CompilerIrParamList]) : OptSsaVarBlocks
  (match params
    [(IrParamNil) defs]
    [(IrParamCons param rest)
      (opt-ssa-def-blocks-add-params
        index
        facts
        label
        (opt-ssa-def-blocks-add-param index facts label defs param)
        (box-get rest))]))

(define (opt-ssa-def-blocks-add-instr
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : String]
  [defs : OptSsaVarBlocks]
  [instr : CompilerIrInstr]) : OptSsaVarBlocks
  (match (opt-instr-def-var instr)
    [(OptSomeI64 var)
      (if (opt-ssa-candidate? facts var)
        (opt-ssa-var-blocks-add index defs var label)
        defs)]
    [(OptNoI64) defs]))

(define (opt-ssa-def-blocks-add-instr-seq-from
  [cfg-index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : String]
  [instrs : CompilerIrInstrSeq]
  [instr-index : i64]
  [defs : OptSsaVarBlocks]) : OptSsaVarBlocks
  (if (>= instr-index (compiler-ir-instr-seq-count instrs))
    defs
    (opt-ssa-def-blocks-add-instr-seq-from
      cfg-index
      facts
      label
      instrs
      (+ instr-index 1)
      (opt-ssa-def-blocks-add-instr
        cfg-index
        facts
        label
        defs
        (compiler-ir-instr-seq-ref instrs instr-index)))))

(define (opt-ssa-def-blocks-add-blocks
  [cfg-index : OptCfgIndex]
  [facts : OptSsaFacts]
  [blocks : CompilerIrBlockList]
  [defs : OptSsaVarBlocks]) : OptSsaVarBlocks
  (match blocks
    [(IrBlockNil) defs]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (opt-ssa-def-blocks-add-blocks
            cfg-index
            facts
            (box-get rest)
            (opt-ssa-def-blocks-add-instr-seq-from
              cfg-index
              facts
              label
              instrs
              0
              defs))])]
    [(IrBlockArray seq)
      (opt-ssa-def-blocks-add-blocks
        cfg-index
        facts
        (compiler-ir-block-seq-to-list seq)
        defs)]))

(define (opt-ssa-def-blocks-from-function
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptSsaVarBlocks
  (opt-ssa-def-blocks-add-blocks
    index
    facts
    blocks
    (opt-ssa-def-blocks-add-params
      index
      facts
      (opt-cfg-entry-label blocks)
      (OptSsaVarBlocksNil)
      params)))

(define (opt-ssa-phi-add-site
  [index : OptCfgIndex]
  [state : OptSsaPhiInsertState]
  [var : i64]
  [ty : AstType]
  [label : String]) : OptSsaPhiInsertState
  (match state
    [(OptSsaPhiInsertState sites next-var worklist work-members site-members)
      (match (opt-cfg-index-id index label)
        [(OptSomeI64 id)
          (if (opt-ssa-label-member? site-members id)
            state
            (begin
              (array-set! site-members id true)
              (OptSsaPhiInsertState
                (OptSsaPhiSitesCons
                  (OptSsaPhiSite var label ty next-var)
                  (box sites))
                (+ next-var 1)
                (if (opt-ssa-label-member? work-members id)
                  worklist
                  (begin
                    (array-set! work-members id true)
                    (OptLabelCons label (box worklist))))
                work-members
                site-members)))]
        [(OptNoI64) state])]))

(define (opt-ssa-phi-add-frontier
  [index : OptCfgIndex]
  [var : i64]
  [ty : AstType]
  [frontier : OptLabelSet]
  [state : OptSsaPhiInsertState]) : OptSsaPhiInsertState
  (match frontier
    [(OptLabelNil) state]
    [(OptLabelCons label rest)
      (opt-ssa-phi-add-frontier
        index
        var
        ty
        (box-get rest)
        (opt-ssa-phi-add-site index state var ty label))]))

(define (opt-ssa-insert-phis-worklist
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [var : i64]
  [ty : AstType]
  [state : OptSsaPhiInsertState]) : OptSsaPhiInsertState
  (match state
    [(OptSsaPhiInsertState sites next-var worklist work-members site-members)
      (match worklist
        [(OptLabelNil) state]
        [(OptLabelCons label rest)
          (opt-ssa-insert-phis-worklist
            context
            blocks
            var
            ty
            (opt-ssa-phi-add-frontier
              (struct-get context index)
              var
              ty
              (opt-cfg-dominance-frontier-with-context blocks context label)
              (OptSsaPhiInsertState
                sites
                next-var
                (box-get rest)
                work-members
                site-members)))])]))

(define (opt-ssa-insert-phis-for-var
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [defs : OptSsaVarBlocks]
  [state : OptSsaPhiInsertState]
  [var : i64]
  [ty : AstType]) : OptSsaPhiInsertState
  (match state
    [(OptSsaPhiInsertState sites next-var _ work-members site-members)
      (let
        [index : OptCfgIndex (struct-get context index)]
        [worklist : OptLabelSet (opt-ssa-var-blocks-lookup defs var)]
        (begin
          (opt-cfg-fill-bool! work-members (array-length work-members) false)
          (opt-cfg-fill-bool! site-members (array-length site-members) false)
          (opt-ssa-label-mark-members! index work-members worklist)
          (opt-ssa-insert-phis-worklist
            context
            blocks
            var
            ty
            (OptSsaPhiInsertState
              sites
              next-var
              worklist
              work-members
              site-members))))]))

(define (opt-ssa-insert-phis-types
  [facts : OptSsaFacts]
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [defs : OptSsaVarBlocks]
  [types : OptSsaVarTypes]
  [state : OptSsaPhiInsertState]) : OptSsaPhiInsertState
  (match types
    [(OptSsaVarTypesNil) state]
    [(OptSsaVarTypesCons var ty rest)
      (opt-ssa-insert-phis-types
        facts
        context
        blocks
        defs
        (box-get rest)
        (if (opt-ssa-candidate? facts var)
          (opt-ssa-insert-phis-for-var context blocks defs state var ty)
          state))]))

(define (opt-ssa-insert-phis
  [facts : OptSsaFacts]
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [frame : i64]
  [blocks : CompilerIrBlockList]) : OptSsaPhiInsertState
  (match facts
    [(OptSsaFacts _ _ types)
      (let
        [index : OptCfgIndex (struct-get context index)]
        [work-members : (Array bool) (opt-ssa-label-members-new index)]
        [site-members : (Array bool) (opt-ssa-label-members-new index)]
        (opt-ssa-insert-phis-types
          facts
          context
          blocks
          (opt-ssa-def-blocks-from-function index facts params blocks)
          types
          (OptSsaPhiInsertState
            (OptSsaPhiSitesNil)
            frame
            (OptLabelNil)
            work-members
            site-members)))]))

(define (opt-ssa-env-lookup [env : OptSsaRenameEnv] [var : i64]) : OptMaybeI64
  (match env
    [(OptSsaRenameNil) (OptNoI64)]
    [(OptSsaRenameCons original current rest)
      (if (= original var)
        (OptSomeI64 current)
        (opt-ssa-env-lookup (box-get rest) var))]))

(define (opt-ssa-env-bind
  [env : OptSsaRenameEnv]
  [original : i64]
  [current : i64]) : OptSsaRenameEnv
  (OptSsaRenameCons original current (box env)))

(define (opt-ssa-env-from-params
  [facts : OptSsaFacts]
  [params : CompilerIrParamList]
  [env : OptSsaRenameEnv]) : OptSsaRenameEnv
  (match params
    [(IrParamNil) env]
    [(IrParamCons param rest)
      (match param
        [(IrParam _ _ var)
          (opt-ssa-env-from-params
            facts
            (box-get rest)
            (if (opt-ssa-candidate? facts var)
              (opt-ssa-env-bind env var var)
              env))])]))

(define (opt-ssa-env-bind-phis
  [sites : OptSsaPhiSites]
  [label : String]
  [env : OptSsaRenameEnv]) : OptSsaRenameEnv
  (match sites
    [(OptSsaPhiSitesNil) env]
    [(OptSsaPhiSitesCons site rest)
      (match site
        [(OptSsaPhiSite var site-label _ phi-var)
          (opt-ssa-env-bind-phis
            (box-get rest)
            label
            (if (string-eq label site-label)
              (opt-ssa-env-bind env var phi-var)
              env))])]))

(define (opt-ssa-rewrite-value
  [env : OptSsaRenameEnv]
  [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(IrValueVar var)
      (match (opt-ssa-env-lookup env var)
        [(OptSomeI64 current) (IrValueVar current)]
        [(OptNoI64) value])]
    [_ value]))

(define (opt-ssa-rewrite-maybe-value
  [env : OptSsaRenameEnv]
  [value : CompilerIrMaybeValue]) : CompilerIrMaybeValue
  (match value
    [(IrNoValue) (IrNoValue)]
    [(IrSomeValue inner) (IrSomeValue (opt-ssa-rewrite-value env inner))]))

(define (opt-ssa-rewrite-value-list
  [env : OptSsaRenameEnv]
  [values : CompilerIrValueList]) : CompilerIrValueList
  (match values
    [(IrValueNil) (IrValueNil)]
    [(IrValueCons value rest)
      (compiler-ir-value-cons
        (opt-ssa-rewrite-value env value)
        (opt-ssa-rewrite-value-list env (box-get rest)))]))

(define (opt-ssa-rewrite-call-args-array
  [env : OptSsaRenameEnv]
  [src : (Array CompilerIrValue)]
  [dst : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set! dst index (opt-ssa-rewrite-value env (array-ref src index)))
      (opt-ssa-rewrite-call-args-array env src dst (+ index 1)))))

(define (opt-ssa-rewrite-call-args
  [env : OptSsaRenameEnv]
  [args : CompilerIrCallArgs]) : CompilerIrCallArgs
  (match args
    [(IrCallArgsNil) (IrCallArgsNil)]
    [(IrCallArgsOne value) (IrCallArgsOne (opt-ssa-rewrite-value env value))]
    [(IrCallArgsTwo a b)
      (IrCallArgsTwo
        (opt-ssa-rewrite-value env a)
        (opt-ssa-rewrite-value env b))]
    [(IrCallArgsArray values)
      (let
        [out : (Array CompilerIrValue)
          (make-array CompilerIrValue (array-length values))]
        (begin
          (opt-ssa-rewrite-call-args-array env values out 0)
          (IrCallArgsArray out)))]))

(define (opt-ssa-rename-dst
  [facts : OptSsaFacts]
  [env : OptSsaRenameEnv]
  [next-var : i64]
  [dst : i64]) : OptSsaDstResult
  (if (opt-ssa-candidate? facts dst)
    (OptSsaDstResult
      next-var
      (opt-ssa-env-bind env dst next-var)
      (+ next-var 1))
    (OptSsaDstResult dst env next-var)))

(define (opt-ssa-rename-instr
  [facts : OptSsaFacts]
  [env : OptSsaRenameEnv]
  [next-var : i64]
  [instr : CompilerIrInstr]) : OptSsaInstrResult
  (match instr
    [(IrInstrMov dst src ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrMov out-dst (opt-ssa-rewrite-value env src) ty)
            next-env
            out-next)])]
    [(IrInstrLoad dst src ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrLoad out-dst (opt-ssa-rewrite-value env src) ty)
            next-env
            out-next)])]
    [(IrInstrCast dst src from-ty to-ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrCast out-dst (opt-ssa-rewrite-value env src) from-ty to-ty)
            next-env
            out-next)])]
    [(IrInstrBitcast dst src from-ty to-ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrBitcast
              out-dst
              (opt-ssa-rewrite-value env src)
              from-ty
              to-ty)
            next-env
            out-next)])]
    [(IrInstrBinOp dst op lhs rhs ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrBinOp
              out-dst
              op
              (opt-ssa-rewrite-value env lhs)
              (opt-ssa-rewrite-value env rhs)
              ty)
            next-env
            out-next)])]
    [(IrInstrUnOp dst op src ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrUnOp out-dst op (opt-ssa-rewrite-value env src) ty)
            next-env
            out-next)])]
    [(IrInstrCall dst name args ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrCall out-dst name (opt-ssa-rewrite-call-args env args) ty)
            next-env
            out-next)])]
    [(IrInstrCallIndirect dst func args ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrCallIndirect
              out-dst
              (opt-ssa-rewrite-value env func)
              (opt-ssa-rewrite-call-args env args)
              ty)
            next-env
            out-next)])]
    [(IrInstrCallIndirectC dst func args ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrCallIndirectC
              out-dst
              (opt-ssa-rewrite-value env func)
              (opt-ssa-rewrite-call-args env args)
              ty)
            next-env
            out-next)])]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base name args slots)
          (OptSsaInstrResult
            (ir-instr-call-cabi-store-result
              (opt-ssa-rewrite-value env base)
              name
              (opt-ssa-rewrite-call-args env args)
              slots)
            env
            next-var)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload
            base
            func
            args
            slots)
          (OptSsaInstrResult
            (ir-instr-call-indirect-cabi-store-result
              (opt-ssa-rewrite-value env base)
              (opt-ssa-rewrite-value env func)
              (opt-ssa-rewrite-call-args env args)
              slots)
            env
            next-var)])]
    [(IrInstrEntryArgc dst)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult (IrInstrEntryArgc out-dst) next-env out-next)])]
    [(IrInstrGep dst base offset ty)
      (OptSsaInstrResult
        (IrInstrGep
          dst
          (opt-ssa-rewrite-value env base)
          (opt-ssa-rewrite-value env offset)
          ty)
        env
        next-var)]
    [(IrInstrStorePtr ptr value ty)
      (OptSsaInstrResult
        (IrInstrStorePtr
          (opt-ssa-rewrite-value env ptr)
          (opt-ssa-rewrite-value env value)
          ty)
        env
        next-var)]
    [(IrInstrCopyBytes dst src size)
      (OptSsaInstrResult
        (IrInstrCopyBytes
          (opt-ssa-rewrite-value env dst)
          (opt-ssa-rewrite-value env src)
          size)
        env
        next-var)]
    [(IrInstrBoundsCheck index length ok-label)
      (OptSsaInstrResult
        (IrInstrBoundsCheck
          (opt-ssa-rewrite-value env index)
          (opt-ssa-rewrite-value env length)
          ok-label)
        env
        next-var)]
    [(IrInstrSplat dst value lanes ty)
      (OptSsaInstrResult
        (IrInstrSplat dst (opt-ssa-rewrite-value env value) lanes ty)
        env
        next-var)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst op lhs rhs lanes ty)
          (OptSsaInstrResult
            (ir-instr-vector-bin-op
              dst
              op
              (opt-ssa-rewrite-value env lhs)
              (opt-ssa-rewrite-value env rhs)
              lanes
              ty)
            env
            next-var)])]
    [(IrInstrVectorReduce dst op src lanes ty)
      (OptSsaInstrResult
        (IrInstrVectorReduce dst op (opt-ssa-rewrite-value env src) lanes ty)
        env
        next-var)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst op lhs rhs lanes ty)
          (OptSsaInstrResult
            (ir-instr-vector-compare
              dst
              op
              (opt-ssa-rewrite-value env lhs)
              (opt-ssa-rewrite-value env rhs)
              lanes
              ty)
            env
            next-var)])]
    [(IrInstrMaskBinOp dst op lhs rhs lanes)
      (OptSsaInstrResult
        (IrInstrMaskBinOp
          dst
          op
          (opt-ssa-rewrite-value env lhs)
          (opt-ssa-rewrite-value env rhs)
          lanes)
        env
        next-var)]
    [(IrInstrMaskNot dst src lanes)
      (OptSsaInstrResult
        (IrInstrMaskNot dst (opt-ssa-rewrite-value env src) lanes)
        env
        next-var)]
    [(IrInstrMaskReduce dst op src lanes)
      (OptSsaInstrResult
        (IrInstrMaskReduce dst op (opt-ssa-rewrite-value env src) lanes)
        env
        next-var)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst mask on-true on-false lanes ty)
          (OptSsaInstrResult
            (ir-instr-select
              dst
              (opt-ssa-rewrite-value env mask)
              (opt-ssa-rewrite-value env on-true)
              (opt-ssa-rewrite-value env on-false)
              lanes
              ty)
            env
            next-var)])]
    [(IrInstrVectorLoad dst base index lanes ty)
      (OptSsaInstrResult
        (IrInstrVectorLoad
          dst
          (opt-ssa-rewrite-value env base)
          (opt-ssa-rewrite-value env index)
          lanes
          ty)
        env
        next-var)]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload base index value lanes ty)
          (OptSsaInstrResult
            (ir-instr-vector-store
              (opt-ssa-rewrite-value env base)
              (opt-ssa-rewrite-value env index)
              (opt-ssa-rewrite-value env value)
              lanes
              ty)
            env
            next-var)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload base index value mask lanes ty)
          (OptSsaInstrResult
            (ir-instr-predicated-store
              (opt-ssa-rewrite-value env base)
              (opt-ssa-rewrite-value env index)
              (opt-ssa-rewrite-value env value)
              (opt-ssa-rewrite-value env mask)
              lanes
              ty)
            env
            next-var)])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst base index mask lanes ty)
          (OptSsaInstrResult
            (ir-instr-predicated-load
              dst
              (opt-ssa-rewrite-value env base)
              (opt-ssa-rewrite-value env index)
              (opt-ssa-rewrite-value env mask)
              lanes
              ty)
            env
            next-var)])]
    [(IrInstrTailMask dst index length lanes)
      (OptSsaInstrResult
        (IrInstrTailMask
          dst
          (opt-ssa-rewrite-value env index)
          (opt-ssa-rewrite-value env length)
          lanes)
        env
        next-var)]
    [(IrInstrCpuId dst leaf subleaf reg-index)
      (OptSsaInstrResult
        (IrInstrCpuId
          dst
          (opt-ssa-rewrite-value env leaf)
          (opt-ssa-rewrite-value env subleaf)
          reg-index)
        env
        next-var)]
    [(IrInstrXgetbv dst index)
      (OptSsaInstrResult
        (IrInstrXgetbv dst (opt-ssa-rewrite-value env index))
        env
        next-var)]
    [(IrInstrSyscall dst args)
      (OptSsaInstrResult
        (IrInstrSyscall dst (opt-ssa-rewrite-call-args env args))
        env
        next-var)]
    [(IrInstrStore name value ty)
      (OptSsaInstrResult
        (IrInstrStore name (opt-ssa-rewrite-value env value) ty)
        env
        next-var)]
    [(IrInstrBranch cond true-label false-label)
      (OptSsaInstrResult
        (IrInstrBranch (opt-ssa-rewrite-value env cond) true-label false-label)
        env
        next-var)]
    [(IrInstrReturn maybe)
      (OptSsaInstrResult
        (IrInstrReturn (opt-ssa-rewrite-maybe-value env maybe))
        env
        next-var)]
    [(IrInstrTailCall name args ty)
      (OptSsaInstrResult
        (IrInstrTailCall name (opt-ssa-rewrite-call-args env args) ty)
        env
        next-var)]
    [(IrInstrAlloc _ _) (OptSsaInstrResult instr env next-var)]
    [(IrInstrAddrOf _ _) (OptSsaInstrResult instr env next-var)]
    [(IrInstrLaneId _ _ _) (OptSsaInstrResult instr env next-var)]
    [(IrInstrEntryArgv _) (OptSsaInstrResult instr env next-var)]
    [(IrInstrEntryEnvp _) (OptSsaInstrResult instr env next-var)]
    [(IrInstrJump _) (OptSsaInstrResult instr env next-var)]
    [(IrInstrPhi _ _ _) (OptSsaInstrResult instr env next-var)]
    ;; #2386: SSA-rename register-group ops -- rewrite operands with the current
    ;; env, then rename the dst.
    [(IrInstrPack dst words ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrPack out-dst (opt-ssa-rewrite-value-list env words) ty)
            next-env
            out-next)])]
    [(IrInstrWord dst src index ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult out-dst next-env out-next)
          (OptSsaInstrResult
            (IrInstrWord out-dst (opt-ssa-rewrite-value env src) index ty)
            next-env
            out-next)])]
    [(IrInstrTailCallIndirect func args ty)
      (OptSsaInstrResult
        (IrInstrTailCallIndirect
          (opt-ssa-rewrite-value env func)
          (opt-ssa-rewrite-call-args env args)
          ty)
        env
        next-var)]))

(define (opt-ssa-rename-instr-seq-from
  [facts : OptSsaFacts]
  [env : OptSsaRenameEnv]
  [next-var : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptSsaBlockResult
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptSsaBlockResult (IrInstrNil) env next-var)
    (match (opt-ssa-rename-instr
      facts
      env
      next-var
      (compiler-ir-instr-seq-ref instrs index))
      [(OptSsaInstrResult instr next-env instr-next)
        (match (opt-ssa-rename-instr-seq-from
          facts
          next-env
          instr-next
          instrs
          (+ index 1))
          [(OptSsaBlockResult rest out-env out-next)
            (OptSsaBlockResult
              (compiler-ir-instr-cons instr rest)
              out-env
              out-next)])])))

(define (opt-ssa-rename-blocks-contains?
  [blocks : OptSsaRenameBlocks]
  [label : String]) : bool
  (match blocks
    [(OptSsaRenameBlocksNil) false]
    [(OptSsaRenameBlocksCons block rest)
      (match block
        [(OptSsaRenameBlock block-label _)
          (if (string-eq block-label label)
            true
            (opt-ssa-rename-blocks-contains? (box-get rest) label))])]))

(define (opt-ssa-rename-blocks-lookup
  [blocks : OptSsaRenameBlocks]
  [label : String]) : CompilerIrInstrList
  (match blocks
    [(OptSsaRenameBlocksNil) (IrInstrNil)]
    [(OptSsaRenameBlocksCons block rest)
      (match block
        [(OptSsaRenameBlock block-label instrs)
          (if (string-eq block-label label)
            instrs
            (opt-ssa-rename-blocks-lookup (box-get rest) label))])]))

(define (opt-ssa-block-out-lookup [outs : OptSsaBlockOuts] [label : String]) : OptSsaRenameEnv
  (match outs
    [(OptSsaBlockOutsNil) (OptSsaRenameNil)]
    [(OptSsaBlockOutsCons out rest)
      (match out
        [(OptSsaBlockOut out-label env)
          (if (string-eq out-label label)
            env
            (opt-ssa-block-out-lookup (box-get rest) label))])]))

(define (opt-ssa-rename-state-add-block
  [state : OptSsaRenameState]
  [label : String]
  [instrs : CompilerIrInstrList]
  [env : OptSsaRenameEnv]
  [next-var : i64]) : OptSsaRenameState
  (match state
    [(OptSsaRenameState blocks outs _)
      (OptSsaRenameState
        (OptSsaRenameBlocksCons (OptSsaRenameBlock label instrs) (box blocks))
        (OptSsaBlockOutsCons (OptSsaBlockOut label env) (box outs))
        next-var)]))

(define (opt-ssa-rename-id
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [id : i64]
  [env : OptSsaRenameEnv]
  [state : OptSsaRenameState]) : OptSsaRenameState
  (let
    [index : OptCfgIndex (struct-get context index)]
    [label : String (array-ref (struct-get index labels) id)]
    (match (opt-cfg-find-block blocks label)
      [(OptNoBlock) state]
      [(OptSomeBlock block)
        (match block
          [(IrBlock _ instrs)
            (let
              [entry-env : OptSsaRenameEnv
                (opt-ssa-env-bind-phis sites label env)]
              (match (opt-ssa-rename-instr-seq-from
                facts
                entry-env
                (match state
                  [(OptSsaRenameState _ _ next-var) next-var])
                instrs
                0)
                [(OptSsaBlockResult renamed out-env next-var)
                  (opt-ssa-rename-children
                    context
                    blocks
                    facts
                    sites
                    id
                    out-env
                    (opt-ssa-rename-state-add-block
                      state
                      label
                      renamed
                      out-env
                      next-var)
                    0)]))])])))

(define (opt-ssa-rename-children
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [parent-id : i64]
  [env : OptSsaRenameEnv]
  [state : OptSsaRenameState]
  [child-id : i64]) : OptSsaRenameState
  (let
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= child-id count)
      state
      (let
        [idom : (Array i64) (struct-get (struct-get context doms) idom)]
        [next-state : OptSsaRenameState
          (if (and
            (not (= child-id parent-id))
            (array-ref (struct-get index reachable) child-id)
            (= (array-ref idom child-id) parent-id))
            (opt-ssa-rename-id context blocks facts sites child-id env state)
            state)]
        (opt-ssa-rename-children
          context
          blocks
          facts
          sites
          parent-id
          env
          next-state
          (+ child-id 1))))))

(define (opt-ssa-rename-missing-blocks
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [initial-env : OptSsaRenameEnv]
  [state : OptSsaRenameState]) : OptSsaRenameState
  (match blocks
    [(IrBlockNil) state]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (let
            [next-state : OptSsaRenameState
              (match state
                [(OptSsaRenameState renamed _ next-var)
                  (if (opt-ssa-rename-blocks-contains? renamed label)
                    state
                    (match (opt-ssa-rename-instr-seq-from
                      facts
                      (opt-ssa-env-bind-phis sites label initial-env)
                      next-var
                      instrs
                      0)
                      [(OptSsaBlockResult out out-env out-next)
                        (opt-ssa-rename-state-add-block
                          state
                          label
                          out
                          out-env
                          out-next)]))])]
            (opt-ssa-rename-missing-blocks
              (box-get rest)
              facts
              sites
              initial-env
              next-state))])]
    [(IrBlockArray seq)
      (opt-ssa-rename-missing-blocks
        (compiler-ir-block-seq-to-list seq)
        facts
        sites
        initial-env
        state)]))

(define (opt-ssa-rename-function-blocks
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [frame : i64]
  [blocks : CompilerIrBlockList]) : OptSsaRenameState
  (let
    [initial-env : OptSsaRenameEnv
      (opt-ssa-env-from-params facts params (OptSsaRenameNil))]
    [entry-label : String (opt-cfg-entry-label blocks)]
    (match (opt-cfg-index-id (struct-get context index) entry-label)
      [(OptSomeI64 entry-id)
        (opt-ssa-rename-missing-blocks
          blocks
          facts
          sites
          initial-env
          (opt-ssa-rename-id
            context
            blocks
            facts
            sites
            entry-id
            initial-env
            (OptSsaRenameState
              (OptSsaRenameBlocksNil)
              (OptSsaBlockOutsNil)
              frame)))]
      [(OptNoI64)
        (OptSsaRenameState (OptSsaRenameBlocksNil) (OptSsaBlockOutsNil) frame)])))

(define (opt-ssa-phi-inputs
  [preds : OptLabelSet]
  [outs : OptSsaBlockOuts]
  [var : i64]) : CompilerIrPhiInputList
  (match preds
    [(OptLabelNil) (IrPhiInputNil)]
    [(OptLabelCons pred rest)
      (let
        [env : OptSsaRenameEnv (opt-ssa-block-out-lookup outs pred)]
        [value : CompilerIrValue
          (match (opt-ssa-env-lookup env var)
            [(OptSomeI64 current) (IrValueVar current)]
            [(OptNoI64) (IrValueVar var)])]
        (compiler-ir-phi-input-cons
          value
          pred
          (opt-ssa-phi-inputs (box-get rest) outs var)))]))

(define (opt-ssa-phis-for-label
  [pred-map : OptPredMap]
  [outs : OptSsaBlockOuts]
  [sites : OptSsaPhiSites]
  [label : String]) : CompilerIrInstrList
  (match sites
    [(OptSsaPhiSitesNil) (IrInstrNil)]
    [(OptSsaPhiSitesCons site rest)
      (let
        [tail : CompilerIrInstrList
          (opt-ssa-phis-for-label pred-map outs (box-get rest) label)]
        (match site
          [(OptSsaPhiSite var site-label ty phi-var)
            (if (string-eq site-label label)
              (compiler-ir-instr-cons
                (IrInstrPhi
                  phi-var
                  (opt-ssa-phi-inputs
                    (opt-pred-map-lookup pred-map label)
                    outs
                    var)
                  ty)
                tail)
              tail)]))]))

(define (opt-ssa-materialize-blocks
  [blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [renamed : OptSsaRenameBlocks]
  [outs : OptSsaBlockOuts]
  [sites : OptSsaPhiSites]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (let
            [phis : CompilerIrInstrList
              (opt-ssa-phis-for-label pred-map outs sites label)]
            [body : CompilerIrInstrList
              (opt-ssa-rename-blocks-lookup renamed label)]
            (compiler-ir-block-cons
              (compiler-ir-block
                label
                (opt-aggregate-instr-list-append phis body))
              (opt-ssa-materialize-blocks
                (box-get rest)
                pred-map
                renamed
                outs
                sites)))])]
    [(IrBlockArray seq)
      (opt-ssa-materialize-blocks
        (compiler-ir-block-seq-to-list seq)
        pred-map
        renamed
        outs
        sites)]))

(define (opt-ssa-instr-seq-has-phi? [instrs : CompilerIrInstrSeq] [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(IrInstrPhi _ _ _) true]
      [_ (opt-ssa-instr-seq-has-phi? instrs (+ index 1))])))

(define (opt-ssa-blocks-have-phi? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-ssa-instr-seq-has-phi? instrs 0)
            true
            (opt-ssa-blocks-have-phi? (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-ssa-blocks-have-phi? (compiler-ir-block-seq-to-list seq))]))

(define (opt-ssa-construct-checked
  [fallback : CompilerIrFunction]
  [next : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-verify-function next)
    [(OkCompilerOptimizeVerify) next]
    [(ErrCompilerOptimizeVerify _) fallback]))

(define (opt-ssa-construct-materialized
  [fallback : CompilerIrFunction]
  [name : String]
  [params : CompilerIrParamList]
  [ret-ty : AstType]
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [sites : OptSsaPhiSites]
  [state : OptSsaRenameState]) : CompilerIrFunction
  (match state
    [(OptSsaRenameState renamed outs next-frame)
      (opt-ssa-construct-checked
        fallback
        (IrFunction
          name
          params
          ret-ty
          next-frame
          (opt-ssa-materialize-blocks
            blocks
            (struct-get context pred-map)
            renamed
            outs
            sites)))]))

(define (opt-ssa-construct-materialized-with-context-result
  [fallback : CompilerIrFunction]
  [name : String]
  [params : CompilerIrParamList]
  [ret-ty : AstType]
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [sites : OptSsaPhiSites]
  [state : OptSsaRenameState]) : OptFunctionCtxResult
  (match state
    [(OptSsaRenameState renamed outs next-frame)
      (let
        [next-blocks : CompilerIrBlockList
          (opt-ssa-materialize-blocks
            blocks
            (struct-get context pred-map)
            renamed
            outs
            sites)]
        [next : CompilerIrFunction
          (IrFunction name params ret-ty next-frame next-blocks)]
        [next-context : OptCfgContext (opt-cfg-context-build next-blocks)]
        (match (opt-verify-function-with-context next next-context)
          [(OkCompilerOptimizeVerify) (OptFunctionCtxResult next next-context)]
          [(ErrCompilerOptimizeVerify _)
            (OptFunctionCtxResult fallback context)]))]))

;; True when the entry block has an explicit CFG predecessor (e.g. the
;; tail-recursion-to-loop back edge jumps to the function entry block).
(define (opt-ssa-entry-has-preds? [context : OptCfgContext]) : bool
  (let
    [index : OptCfgIndex (struct-get context index)]
    (match (opt-cfg-index-id index (struct-get context entry-label))
      [(OptSomeI64 id)
        (let
          [preds : OptCfgCsr (struct-get index preds)]
          [offsets : (Array i64) (struct-get preds offsets)]
          (> (- (array-ref offsets (+ id 1)) (array-ref offsets id)) 0))]
      [(OptNoI64) false])))

(define (opt-ssa-construct-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret-ty frame blocks)
      (if (opt-verify-single-defs? params blocks)
        func
        (if (opt-ssa-blocks-have-phi? blocks)
          func
          (let
            [facts : OptSsaFacts (opt-ssa-facts-from-function params blocks)]
            (if (not (opt-ssa-any-candidate? facts))
              func
              (let
                [context : OptCfgContext (opt-cfg-context-build blocks)]
                ;; A CFG edge into the entry block (the tail-recursion-to-loop
                ;; back edge) cannot be represented in SSA: the entry block's
                ;; initial values (parameters and prologue defs) arrive over the
                ;; implicit function-entry edge, which has no predecessor block
                ;; or label. A phi inserted at the entry block only sees the
                ;; explicit predecessors, so renaming silently drops the
                ;; first-iteration values (opt2 self-build miscompile: the
                ;; emitted entry block of intern-fill-empty read the back-edge
                ;; staging temps before their first write). Skip SSA
                ;; construction for such functions; the non-SSA passes still
                ;; run.
                (if (opt-ssa-entry-has-preds? context)
                  func
                  (opt-ssa-construct-with-context
                    func
                    name
                    params
                    ret-ty
                    frame
                    blocks
                    facts
                    context)))))))]))

(define (opt-ssa-construct-with-context
  [func : CompilerIrFunction]
  [name : String]
  [params : CompilerIrParamList]
  [ret-ty : AstType]
  [frame : i64]
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [context : OptCfgContext]) : CompilerIrFunction
  (let
    [phi-state : OptSsaPhiInsertState
      (opt-ssa-insert-phis facts context params frame blocks)]
    (match phi-state
      [(OptSsaPhiInsertState sites phi-next _ _ _)
        (opt-ssa-construct-materialized
          func
          name
          params
          ret-ty
          blocks
          context
          sites
          (opt-ssa-rename-function-blocks
            context
            params
            facts
            sites
            phi-next
            blocks))])))

(define (opt-ssa-construct-with-context-result
  [func : CompilerIrFunction]
  [name : String]
  [params : CompilerIrParamList]
  [ret-ty : AstType]
  [frame : i64]
  [blocks : CompilerIrBlockList]
  [facts : OptSsaFacts]
  [context : OptCfgContext]) : OptFunctionCtxResult
  (let
    [phi-state : OptSsaPhiInsertState
      (opt-ssa-insert-phis facts context params frame blocks)]
    (match phi-state
      [(OptSsaPhiInsertState sites phi-next _ _ _)
        (opt-ssa-construct-materialized-with-context-result
          func
          name
          params
          ret-ty
          blocks
          context
          sites
          (opt-ssa-rename-function-blocks
            context
            params
            facts
            sites
            phi-next
            blocks))])))

(define (opt-ssa-construct-function-with-context-result
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  (match func
    [(IrFunction name params ret-ty frame blocks)
      (let
        [context : OptCfgContext (opt-cfg-context-build blocks)]
        (if (opt-verify-single-defs? params blocks)
          (OptFunctionCtxResult func context)
          (if (opt-ssa-blocks-have-phi? blocks)
            (OptFunctionCtxResult func context)
            (let
              [facts : OptSsaFacts (opt-ssa-facts-from-function params blocks)]
              (if (not (opt-ssa-any-candidate? facts))
                (OptFunctionCtxResult func context)
                ;; A CFG edge into the entry block (the tail-recursion-to-loop
                ;; back edge) cannot be represented in SSA: the entry block's
                ;; initial values (parameters and prologue defs) arrive over the
                ;; implicit function-entry edge, which has no predecessor block
                ;; or label. A phi inserted at the entry block only sees the
                ;; explicit predecessors, so renaming silently drops the
                ;; first-iteration values. Skip SSA construction for such
                ;; functions; the non-SSA passes still run.
                (if (opt-ssa-entry-has-preds? context)
                  (OptFunctionCtxResult func context)
                  (opt-ssa-construct-with-context-result
                    func
                    name
                    params
                    ret-ty
                    frame
                    blocks
                    facts
                    context)))))))]))

;; --- conservative global value numbering / cross-block copies (#1349) -------
;;
;; This pass is deliberately SSA-gated. If the function verifier cannot prove
;; single definitions and dominance for every use, the pass leaves the function
;; unchanged and the existing block-local optimizer still runs. For verified
;; functions, a copy/expression fact is available only in the defining block
;; after the defining instruction, or in a block dominated by the definition's
;; block. Phi inputs are edge uses and are intentionally not rewritten.
(defenum OptGlobalExprKey
  (OptGlobalMovKey CompilerIrValue AstType)
  (OptGlobalGepKey CompilerIrValue CompilerIrValue AstType)
  (OptGlobalCastKey CompilerIrValue AstType AstType)
  (OptGlobalBinKey CompilerIrBinOp CompilerIrValue CompilerIrValue AstType)
  (OptGlobalUnKey CompilerIrUnOp CompilerIrValue AstType))

(defenum OptMaybeGlobalExprKey
  (OptNoGlobalExprKey)
  (OptSomeGlobalExprKey OptGlobalExprKey))

(defenum OptGlobalExprFact
  (OptGlobalExprFact OptGlobalExprKey i64 i64 i64))

(defenum OptGlobalExprFacts
  (OptGlobalExprNil)
  (OptGlobalExprCons OptGlobalExprFact (Box OptGlobalExprFacts)))

(defstruct OptGlobalExprFactTable
  (buckets (Array OptGlobalExprFacts)))

(defenum OptGlobalCopyFact
  (OptGlobalCopyFact i64 CompilerIrValue i64 i64))

(defenum OptGlobalCopyFacts
  (OptGlobalCopyNil)
  (OptGlobalCopyCons OptGlobalCopyFact (Box OptGlobalCopyFacts)))

(defstruct OptGlobalCopyFactTable
  (buckets (Array OptGlobalCopyFacts)))

(define (opt-global-expr-key-eq [a : OptGlobalExprKey] [b : OptGlobalExprKey]) : bool
  (match a
    [(OptGlobalMovKey av aty)
      (match b
        [(OptGlobalMovKey bv bty)
          (and (opt-value-eq av bv) (opt-type-eq aty bty))]
        [_ false])]
    [(OptGlobalGepKey abase aoff aty)
      (match b
        [(OptGlobalGepKey bbase boff bty)
          (and
            (opt-value-eq abase bbase)
            (opt-value-eq aoff boff)
            (opt-type-eq aty bty))]
        [_ false])]
    [(OptGlobalCastKey av afrom ato)
      (match b
        [(OptGlobalCastKey bv bfrom bto)
          (and
            (opt-value-eq av bv)
            (opt-type-eq afrom bfrom)
            (opt-type-eq ato bto))]
        [_ false])]
    [(OptGlobalBinKey aop al ar aty)
      (match b
        [(OptGlobalBinKey bop bl br bty)
          (and
            (opt-binop-eq aop bop)
            (opt-value-eq al bl)
            (opt-value-eq ar br)
            (opt-type-eq aty bty))]
        [_ false])]
    [(OptGlobalUnKey aop av aty)
      (match b
        [(OptGlobalUnKey bop bv bty)
          (and (opt-unop-eq aop bop) (opt-value-eq av bv) (opt-type-eq aty bty))]
        [_ false])]))

(define (opt-global-expr-key-hash [key : OptGlobalExprKey]) : i64
  (match key
    [(OptGlobalMovKey value ty)
      (hash-combine 1 (hash-combine (opt-value-hash value) (opt-type-hash ty)))]
    [(OptGlobalGepKey base offset ty)
      (hash-combine
        2
        (hash-combine
          (opt-value-hash base)
          (hash-combine (opt-value-hash offset) (opt-type-hash ty))))]
    [(OptGlobalCastKey value from-ty to-ty)
      (hash-combine
        3
        (hash-combine
          (opt-value-hash value)
          (hash-combine (opt-type-hash from-ty) (opt-type-hash to-ty))))]
    [(OptGlobalBinKey op lhs rhs ty)
      (hash-combine
        4
        (hash-combine
          (hash-i64 (opt-binop-tag op))
          (hash-combine
            (opt-value-hash lhs)
            (hash-combine (opt-value-hash rhs) (opt-type-hash ty)))))]
    [(OptGlobalUnKey op value ty)
      (hash-combine
        5
        (hash-combine
          (hash-i64 (opt-unop-tag op))
          (hash-combine (opt-value-hash value) (opt-type-hash ty))))]))

;; Key operands must hold a single unchanging value for the fact's lifetime.
;; An `IrValueGlobal` operand is a hidden LOAD of a mutable global (the backend
;; emits a rip-relative read at each use site), so an instruction using one is
;; not a pure expression: reusing its result across an intervening store/call
;; that mutates the global yields a stale value. The opt2 self-build miscompile
;; was exactly this -- `ty-node-push` reused the pre-grow capacity address of
;; `ty-node-pool-slots` after the grow call replaced the array, so the bounds
;; check compared against the old capacity and aborted once the pool grew.
;; `opt-copy-safe-source?` already encodes the safe operand set: vars
;; (single-def under this pass's SSA gate) and unambiguous scalar literals.
(define (opt-global-key-for-instr [instr : CompilerIrInstr]) : OptMaybeGlobalExprKey
  (match instr
    [(IrInstrMov _ src ty)
      (if (opt-copy-safe-source? src)
        (OptSomeGlobalExprKey (OptGlobalMovKey src ty))
        (OptNoGlobalExprKey))]
    [(IrInstrGep _ base offset ty)
      (if (and (opt-copy-safe-source? base) (opt-copy-safe-source? offset))
        (OptSomeGlobalExprKey (OptGlobalGepKey base offset ty))
        (OptNoGlobalExprKey))]
    [(IrInstrCast _ src from-ty to-ty)
      (if (opt-copy-safe-source? src)
        (OptSomeGlobalExprKey (OptGlobalCastKey src from-ty to-ty))
        (OptNoGlobalExprKey))]
    [(IrInstrBinOp _ op lhs rhs ty)
      (if (and (opt-copy-safe-source? lhs) (opt-copy-safe-source? rhs))
        (OptSomeGlobalExprKey (OptGlobalBinKey op lhs rhs ty))
        (OptNoGlobalExprKey))]
    [(IrInstrUnOp _ op src ty)
      (if (opt-copy-safe-source? src)
        (OptSomeGlobalExprKey (OptGlobalUnKey op src ty))
        (OptNoGlobalExprKey))]
    [_ (OptNoGlobalExprKey)]))

(define (opt-global-fact-available?
  [def-block-id : i64]
  [def-pos : i64]
  [use-block-id : i64]
  [use-pos : i64]
  [doms : OptDomInfo]) : bool
  (if (= def-block-id use-block-id)
    (< def-pos use-pos)
    (opt-dom-info-dominates-id? doms def-block-id use-block-id)))

(define (opt-global-block-id [doms : OptDomInfo] [label : String]) : i64
  (match (opt-cfg-index-id (struct-get doms index) label)
    [(OptSomeI64 id) id]
    [(OptNoI64) (- 0 1)]))

(define (opt-global-copy-facts-from-instrs
  [block-id : i64]
  [pos : i64]
  [instrs : CompilerIrInstrList]
  [tail : OptGlobalCopyFacts]) : OptGlobalCopyFacts
  (match instrs
    [(IrInstrNil) tail]
    [(IrInstrCons instr rest)
      (let
        [rest-facts : OptGlobalCopyFacts
          (opt-global-copy-facts-from-instrs
            block-id
            (+ pos 1)
            (box-get rest)
            tail)]
        (match instr
          [(IrInstrMov dst src _)
            (if (and
              (opt-copy-safe-source? src)
              (not (opt-value-is-var? src dst)))
              (OptGlobalCopyCons
                (OptGlobalCopyFact dst src block-id pos)
                (box rest-facts))
              rest-facts)]
          [_ rest-facts]))]))

(define (opt-global-copy-facts-from-instr-seq-from
  [block-id : i64]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [tail : OptGlobalCopyFacts]) : OptGlobalCopyFacts
  (if (< index 0)
    tail
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [rest-facts : OptGlobalCopyFacts tail]
      [next-tail : OptGlobalCopyFacts
        (match instr
          [(IrInstrMov dst src _)
            (if (and
              (opt-copy-safe-source? src)
              (not (opt-value-is-var? src dst)))
              (OptGlobalCopyCons
                (OptGlobalCopyFact dst src block-id (+ index 1))
                (box rest-facts))
              rest-facts)]
          [_ rest-facts])]
      (opt-global-copy-facts-from-instr-seq-from
        block-id
        slots
        (- index 1)
        next-tail))))

(define (opt-global-copy-facts-from-instr-seq
  [block-id : i64]
  [instrs : CompilerIrInstrSeq]
  [tail : OptGlobalCopyFacts]) : OptGlobalCopyFacts
  (opt-global-copy-facts-from-instr-seq-from
    block-id
    (struct-get instrs slots)
    (- (struct-get instrs len) 1)
    tail))

(define (opt-global-copy-facts-from-blocks
  [doms : OptDomInfo]
  [blocks : CompilerIrBlockList]
  [tail : OptGlobalCopyFacts]) : OptGlobalCopyFacts
  (match blocks
    [(IrBlockNil) tail]
    [(IrBlockCons block rest)
      (let
        [rest-facts : OptGlobalCopyFacts
          (opt-global-copy-facts-from-blocks doms (box-get rest) tail)]
        (match block
          [(IrBlock label instrs)
            (opt-global-copy-facts-from-instr-seq
              (opt-global-block-id doms label)
              instrs
              rest-facts)]))]
    [(IrBlockArray seq)
      (opt-global-copy-facts-from-blocks
        doms
        (compiler-ir-block-seq-to-list seq)
        tail)]))

(define (opt-global-copy-facts-max-dst
  [facts : OptGlobalCopyFacts]
  [max-dst : i64]) : i64
  (match facts
    [(OptGlobalCopyNil) max-dst]
    [(OptGlobalCopyCons fact rest)
      (match fact
        [(OptGlobalCopyFact dst _ _ _)
          (opt-global-copy-facts-max-dst
            (box-get rest)
            (if (> dst max-dst)
              dst
              max-dst))])]))

(define (opt-global-copy-buckets-fill-empty!
  [buckets : (Array OptGlobalCopyFacts)]
  [index : i64]) : unit
  (if (>= index (array-length buckets))
    unit
    (begin
      (array-set! buckets index (OptGlobalCopyNil))
      (opt-global-copy-buckets-fill-empty! buckets (+ index 1)))))

(define (opt-global-copy-table-insert!
  [table : OptGlobalCopyFactTable]
  [fact : OptGlobalCopyFact]) : unit
  (match fact
    [(OptGlobalCopyFact dst _ _ _)
      (let
        [buckets : (Array OptGlobalCopyFacts) (struct-get table buckets)]
        (if (and (>= dst 0) (< dst (array-length buckets)))
          (array-set!
            buckets
            dst
            (OptGlobalCopyCons fact (box (array-ref buckets dst))))
          unit))]))

(define (opt-global-copy-table-insert-reversed!
  [table : OptGlobalCopyFactTable]
  [facts : OptGlobalCopyFacts]) : unit
  (match facts
    [(OptGlobalCopyNil) unit]
    [(OptGlobalCopyCons fact rest)
      (begin
        (opt-global-copy-table-insert-reversed! table (box-get rest))
        (opt-global-copy-table-insert! table fact))]))

(define (opt-global-copy-table-from-facts [facts : OptGlobalCopyFacts]) : OptGlobalCopyFactTable
  (let
    [max-dst : i64 (opt-global-copy-facts-max-dst facts (- 0 1))]
    [capacity : i64
      (if (< max-dst 0)
        1
        (+ max-dst 1))]
    [buckets : (Array OptGlobalCopyFacts)
      (make-array OptGlobalCopyFacts capacity)]
    [table : OptGlobalCopyFactTable (OptGlobalCopyFactTable buckets)]
    (begin
      (opt-global-copy-buckets-fill-empty! buckets 0)
      (opt-global-copy-table-insert-reversed! table facts)
      table)))

(define (opt-global-copy-lookup-list
  [facts : OptGlobalCopyFacts]
  [var : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (match facts
    [(OptGlobalCopyNil) (IrNoValue)]
    [(OptGlobalCopyCons fact rest)
      (match fact
        [(OptGlobalCopyFact dst src def-block-id def-pos)
          (if (and
            (= dst var)
            (opt-global-fact-available?
              def-block-id
              def-pos
              use-block-id
              use-pos
              doms))
            (IrSomeValue src)
            (opt-global-copy-lookup-list
              (box-get rest)
              var
              doms
              use-block-id
              use-pos))])]))

(define (opt-global-copy-lookup
  [table : OptGlobalCopyFactTable]
  [var : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (let
    [buckets : (Array OptGlobalCopyFacts) (struct-get table buckets)]
    (if (and (>= var 0) (< var (array-length buckets)))
      (opt-global-copy-lookup-list
        (array-ref buckets var)
        var
        doms
        use-block-id
        use-pos)
      (IrNoValue))))

(define (opt-global-copy-resolve-depth
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [value : CompilerIrValue]
  [remaining : i64]) : CompilerIrValue
  (if (<= remaining 0)
    value
    (match value
      [(IrValueVar id)
        (match (opt-global-copy-lookup facts id doms use-block-id use-pos)
          [(IrSomeValue replacement)
            (opt-global-copy-resolve-depth
              facts
              doms
              use-block-id
              use-pos
              replacement
              (- remaining 1))]
          [(IrNoValue) value])]
      [_ value])))

(define (opt-global-copy-resolve
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [value : CompilerIrValue]) : CompilerIrValue
  (opt-global-copy-resolve-depth facts doms use-block-id use-pos value 8))

(define (opt-global-copy-resolve-mask
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [value : CompilerIrValue]) : CompilerIrValue
  (let
    [resolved : CompilerIrValue
      (opt-global-copy-resolve facts doms use-block-id use-pos value)]
    (match resolved
      [(IrValueVar _) resolved]
      [_ value])))

(define (opt-global-copy-subst-value-list
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [values : CompilerIrValueList]) : CompilerIrValueList
  (match values
    [(IrValueNil) (IrValueNil)]
    [(IrValueCons value rest)
      (compiler-ir-value-cons
        (opt-global-copy-resolve facts doms use-block-id use-pos value)
        (opt-global-copy-subst-value-list
          facts
          doms
          use-block-id
          use-pos
          (box-get rest)))]))

(define (opt-global-copy-subst-call-args-array
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [src : (Array CompilerIrValue)]
  [dst : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set!
        dst
        index
        (opt-global-copy-resolve
          facts
          doms
          use-block-id
          use-pos
          (array-ref src index)))
      (opt-global-copy-subst-call-args-array
        facts
        doms
        use-block-id
        use-pos
        src
        dst
        (+ index 1)))))

(define (opt-global-copy-subst-call-args
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [args : CompilerIrCallArgs]) : CompilerIrCallArgs
  (match args
    [(IrCallArgsNil) (IrCallArgsNil)]
    [(IrCallArgsOne value)
      (IrCallArgsOne
        (opt-global-copy-resolve facts doms use-block-id use-pos value))]
    [(IrCallArgsTwo a b)
      (IrCallArgsTwo
        (opt-global-copy-resolve facts doms use-block-id use-pos a)
        (opt-global-copy-resolve facts doms use-block-id use-pos b))]
    [(IrCallArgsArray values)
      (let
        [out : (Array CompilerIrValue)
          (make-array CompilerIrValue (array-length values))]
        (begin
          (opt-global-copy-subst-call-args-array
            facts
            doms
            use-block-id
            use-pos
            values
            out
            0)
          (IrCallArgsArray out)))]))

(define (opt-global-copy-subst-instr
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [block-id : i64]
  [pos : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrMov dst src ty)
      (IrInstrMov dst (opt-global-copy-resolve facts doms block-id pos src) ty)]
    [(IrInstrGep dst base offset ty)
      (IrInstrGep
        dst
        (opt-global-copy-resolve facts doms block-id pos base)
        (opt-global-copy-resolve facts doms block-id pos offset)
        ty)]
    [(IrInstrLoad dst src ty)
      (IrInstrLoad dst (opt-global-copy-resolve facts doms block-id pos src) ty)]
    [(IrInstrStorePtr ptr value ty)
      (IrInstrStorePtr
        (opt-global-copy-resolve facts doms block-id pos ptr)
        (opt-global-copy-resolve facts doms block-id pos value)
        ty)]
    [(IrInstrCopyBytes dst src size)
      (IrInstrCopyBytes
        (opt-global-copy-resolve facts doms block-id pos dst)
        (opt-global-copy-resolve facts doms block-id pos src)
        size)]
    [(IrInstrBoundsCheck index length ok-label)
      (IrInstrBoundsCheck
        (opt-global-copy-resolve facts doms block-id pos index)
        (opt-global-copy-resolve facts doms block-id pos length)
        ok-label)]
    [(IrInstrCast dst src from-ty to-ty)
      (IrInstrCast
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        from-ty
        to-ty)]
    [(IrInstrBitcast dst src from-ty to-ty)
      (IrInstrBitcast
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        from-ty
        to-ty)]
    [(IrInstrBinOp dst op lhs rhs ty)
      (IrInstrBinOp
        dst
        op
        (opt-global-copy-resolve facts doms block-id pos lhs)
        (opt-global-copy-resolve facts doms block-id pos rhs)
        ty)]
    [(IrInstrUnOp dst op src ty)
      (IrInstrUnOp
        dst
        op
        (opt-global-copy-resolve facts doms block-id pos src)
        ty)]
    [(IrInstrSplat dst src lanes ty)
      (IrInstrSplat
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        lanes
        ty)]
    [(IrInstrCall dst name args ty)
      (IrInstrCall
        dst
        name
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(IrInstrCallIndirect dst func args ty)
      (IrInstrCallIndirect
        dst
        (opt-global-copy-resolve facts doms block-id pos func)
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(IrInstrCallIndirectC dst func args ty)
      (IrInstrCallIndirectC
        dst
        (opt-global-copy-resolve facts doms block-id pos func)
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base name args slots)
          (ir-instr-call-cabi-store-result
            (opt-global-copy-resolve facts doms block-id pos base)
            name
            (opt-global-copy-subst-call-args facts doms block-id pos args)
            slots)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload
            base
            func
            args
            slots)
          (ir-instr-call-indirect-cabi-store-result
            (opt-global-copy-resolve facts doms block-id pos base)
            (opt-global-copy-resolve facts doms block-id pos func)
            (opt-global-copy-subst-call-args facts doms block-id pos args)
            slots)])]
    [(IrInstrTailCall name args ty)
      (IrInstrTailCall
        name
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(IrInstrStore name value ty)
      (IrInstrStore
        name
        (opt-global-copy-resolve facts doms block-id pos value)
        ty)]
    [(IrInstrBranch cond true-label false-label)
      (IrInstrBranch
        (opt-global-copy-resolve facts doms block-id pos cond)
        true-label
        false-label)]
    [(IrInstrReturn maybe)
      (match maybe
        [(IrSomeValue value)
          (IrInstrReturn
            (IrSomeValue
              (opt-global-copy-resolve facts doms block-id pos value)))]
        [(IrNoValue) instr])]
    [(IrInstrEntryArgc _) instr]
    [(IrInstrEntryArgv _) instr]
    [(IrInstrEntryEnvp _) instr]
    [(IrInstrCpuId dst leaf subleaf reg-index)
      (IrInstrCpuId
        dst
        (opt-global-copy-resolve facts doms block-id pos leaf)
        (opt-global-copy-resolve facts doms block-id pos subleaf)
        reg-index)]
    [(IrInstrXgetbv dst index)
      (IrInstrXgetbv
        dst
        (opt-global-copy-resolve facts doms block-id pos index))]
    [(IrInstrSyscall dst args)
      (IrInstrSyscall
        dst
        (opt-global-copy-subst-call-args facts doms block-id pos args))]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ _ _ _ _) instr])]
    [(IrInstrVectorReduce _ _ _ _ _) instr]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ _ _ _ _) instr])]
    [(IrInstrMaskBinOp dst op lhs rhs lanes)
      (IrInstrMaskBinOp
        dst
        op
        (opt-global-copy-resolve-mask facts doms block-id pos lhs)
        (opt-global-copy-resolve-mask facts doms block-id pos rhs)
        lanes)]
    [(IrInstrMaskNot dst src lanes)
      (IrInstrMaskNot
        dst
        (opt-global-copy-resolve-mask facts doms block-id pos src)
        lanes)]
    [(IrInstrMaskReduce dst op src lanes)
      (IrInstrMaskReduce
        dst
        op
        (opt-global-copy-resolve-mask facts doms block-id pos src)
        lanes)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ _ _ _ _ _) instr])]
    [(IrInstrVectorLoad _ _ _ _ _) instr]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload _ _ _ _ _) instr])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload _ _ _ _ _ _) instr])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload _ _ _ _ _ _) instr])]
    [(IrInstrTailMask _ _ _ _) instr]
    [(IrInstrAddrOf _ _) instr]
    [(IrInstrAlloc _ _) instr]
    [(IrInstrLaneId _ _ _) instr]
    [(IrInstrJump _) instr]
    [(IrInstrPhi _ _ _) instr]
    ;; #2386: leave register-group ops un-substituted here; not propagating a
    ;; global copy into their operands is always sound (original vars stay valid).
    [(IrInstrPack _ _ _) instr]
    [(IrInstrWord _ _ _ _) instr]
    [(IrInstrTailCallIndirect func args ty)
      (IrInstrTailCallIndirect
        (opt-global-copy-resolve facts doms block-id pos func)
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]))

(define (opt-global-copy-instrs
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [block-id : i64]
  [pos : i64]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (compiler-ir-instr-cons
        (opt-global-copy-subst-instr facts doms block-id pos instr)
        (opt-global-copy-instrs facts doms block-id (+ pos 1) (box-get rest)))]))

(define (opt-global-copy-instr-seq
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [block-label : String]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [index : i64 (- (struct-get instrs len) 1)]
    [block-id : i64 (opt-global-block-id doms block-label)]
    [out : CompilerIrInstrList (IrInstrNil)]
    (begin
      (while (>= index 0)
        (begin
          (set!
            out
            (compiler-ir-instr-cons
              (opt-global-copy-subst-instr
                facts
                doms
                block-id
                (+ index 1)
                (array-ref slots index))
              out))
          (set! index (- index 1))))
      out)))

(define (opt-global-copy-blocks
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (compiler-ir-block-cons
            (compiler-ir-block
              label
              (opt-global-copy-instr-seq facts doms label instrs))
            (opt-global-copy-blocks facts doms (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-global-copy-blocks facts doms (compiler-ir-block-seq-to-list seq))]))

(define (opt-global-expr-facts-from-instrs
  [block-id : i64]
  [pos : i64]
  [instrs : CompilerIrInstrList]
  [tail : OptGlobalExprFacts]) : OptGlobalExprFacts
  (match instrs
    [(IrInstrNil) tail]
    [(IrInstrCons instr rest)
      (let
        [rest-facts : OptGlobalExprFacts
          (opt-global-expr-facts-from-instrs
            block-id
            (+ pos 1)
            (box-get rest)
            tail)]
        (match (opt-global-key-for-instr instr)
          [(OptSomeGlobalExprKey key)
            (match (opt-instr-def-var instr)
              [(OptSomeI64 dst)
                (OptGlobalExprCons
                  (OptGlobalExprFact key dst block-id pos)
                  (box rest-facts))]
              [(OptNoI64) rest-facts])]
          [(OptNoGlobalExprKey) rest-facts]))]))

(define (opt-global-expr-facts-from-instr-seq-from
  [block-id : i64]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [tail : OptGlobalExprFacts]) : OptGlobalExprFacts
  (if (< index 0)
    tail
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [rest-facts : OptGlobalExprFacts tail]
      [next-tail : OptGlobalExprFacts
        (match (opt-global-key-for-instr instr)
          [(OptSomeGlobalExprKey key)
            (match (opt-instr-def-var instr)
              [(OptSomeI64 dst)
                (OptGlobalExprCons
                  (OptGlobalExprFact key dst block-id (+ index 1))
                  (box rest-facts))]
              [(OptNoI64) rest-facts])]
          [(OptNoGlobalExprKey) rest-facts])]
      (opt-global-expr-facts-from-instr-seq-from
        block-id
        slots
        (- index 1)
        next-tail))))

(define (opt-global-expr-facts-from-instr-seq
  [block-id : i64]
  [instrs : CompilerIrInstrSeq]
  [tail : OptGlobalExprFacts]) : OptGlobalExprFacts
  (opt-global-expr-facts-from-instr-seq-from
    block-id
    (struct-get instrs slots)
    (- (struct-get instrs len) 1)
    tail))

(define (opt-global-expr-facts-from-blocks
  [doms : OptDomInfo]
  [blocks : CompilerIrBlockList]
  [tail : OptGlobalExprFacts]) : OptGlobalExprFacts
  (match blocks
    [(IrBlockNil) tail]
    [(IrBlockCons block rest)
      (let
        [rest-facts : OptGlobalExprFacts
          (opt-global-expr-facts-from-blocks doms (box-get rest) tail)]
        (match block
          [(IrBlock label instrs)
            (opt-global-expr-facts-from-instr-seq
              (opt-global-block-id doms label)
              instrs
              rest-facts)]))]
    [(IrBlockArray seq)
      (opt-global-expr-facts-from-blocks
        doms
        (compiler-ir-block-seq-to-list seq)
        tail)]))

(define (opt-global-fact-bucket-capacity [count : i64]) : i64
  (let
    [target : i64
      (if (< count 1)
        1
        (* count 2))]
    [capacity : i64 1]
    (begin
      (while (< capacity target)
        (set! capacity (* capacity 2)))
      capacity)))

(define (opt-global-expr-facts-count [facts : OptGlobalExprFacts]) : i64
  (match facts
    [(OptGlobalExprNil) 0]
    [(OptGlobalExprCons _ rest)
      (+ 1 (opt-global-expr-facts-count (box-get rest)))]))

(define (opt-global-expr-buckets-fill-empty!
  [buckets : (Array OptGlobalExprFacts)]
  [index : i64]) : unit
  (if (>= index (array-length buckets))
    unit
    (begin
      (array-set! buckets index (OptGlobalExprNil))
      (opt-global-expr-buckets-fill-empty! buckets (+ index 1)))))

(define (opt-global-expr-bucket-index
  [buckets : (Array OptGlobalExprFacts)]
  [key : OptGlobalExprKey]) : i64
  (bit-and (opt-global-expr-key-hash key) (- (array-length buckets) 1)))

(define (opt-global-expr-table-insert!
  [table : OptGlobalExprFactTable]
  [fact : OptGlobalExprFact]) : unit
  (match fact
    [(OptGlobalExprFact key _ _ _)
      (let
        [buckets : (Array OptGlobalExprFacts) (struct-get table buckets)]
        [bucket : i64 (opt-global-expr-bucket-index buckets key)]
        (array-set!
          buckets
          bucket
          (OptGlobalExprCons fact (box (array-ref buckets bucket)))))]))

(define (opt-global-expr-table-insert-reversed!
  [table : OptGlobalExprFactTable]
  [facts : OptGlobalExprFacts]) : unit
  (match facts
    [(OptGlobalExprNil) unit]
    [(OptGlobalExprCons fact rest)
      (begin
        (opt-global-expr-table-insert-reversed! table (box-get rest))
        (opt-global-expr-table-insert! table fact))]))

(define (opt-global-expr-table-from-facts [facts : OptGlobalExprFacts]) : OptGlobalExprFactTable
  (let
    [capacity : i64
      (opt-global-fact-bucket-capacity (opt-global-expr-facts-count facts))]
    [buckets : (Array OptGlobalExprFacts)
      (make-array OptGlobalExprFacts capacity)]
    [table : OptGlobalExprFactTable (OptGlobalExprFactTable buckets)]
    (begin
      (opt-global-expr-buckets-fill-empty! buckets 0)
      (opt-global-expr-table-insert-reversed! table facts)
      table)))

(define (opt-global-expr-lookup-list
  [facts : OptGlobalExprFacts]
  [key : OptGlobalExprKey]
  [dst : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (match facts
    [(OptGlobalExprNil) (IrNoValue)]
    [(OptGlobalExprCons fact rest)
      (match fact
        [(OptGlobalExprFact fact-key fact-dst def-block-id def-pos)
          (if (and
            (not (= fact-dst dst))
            (opt-global-expr-key-eq fact-key key)
            (opt-global-fact-available?
              def-block-id
              def-pos
              use-block-id
              use-pos
              doms))
            (IrSomeValue (IrValueVar fact-dst))
            (opt-global-expr-lookup-list
              (box-get rest)
              key
              dst
              doms
              use-block-id
              use-pos))])]))

(define (opt-global-expr-lookup
  [table : OptGlobalExprFactTable]
  [key : OptGlobalExprKey]
  [dst : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : CompilerIrMaybeValue
  (let
    [buckets : (Array OptGlobalExprFacts) (struct-get table buckets)]
    (opt-global-expr-lookup-list
      (array-ref buckets (opt-global-expr-bucket-index buckets key))
      key
      dst
      doms
      use-block-id
      use-pos)))

(define (opt-global-cse-instr
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [block-id : i64]
  [pos : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match (opt-global-key-for-instr instr)
    [(OptSomeGlobalExprKey key)
      (match (opt-instr-def-var instr)
        [(OptSomeI64 dst)
          (match (opt-global-expr-lookup facts key dst doms block-id pos)
            [(IrSomeValue earlier)
              (match instr
                [(IrInstrMov _ _ ty) (IrInstrMov dst earlier ty)]
                [(IrInstrGep _ _ _ ty) (IrInstrMov dst earlier ty)]
                [(IrInstrCast _ _ _ to-ty) (IrInstrMov dst earlier to-ty)]
                [(IrInstrBinOp _ _ _ _ ty) (IrInstrMov dst earlier ty)]
                [(IrInstrUnOp _ _ _ ty) (IrInstrMov dst earlier ty)]
                [_ instr])]
            [(IrNoValue) instr])]
        [(OptNoI64) instr])]
    [(OptNoGlobalExprKey) instr]))

(define (opt-global-cse-instrs
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [block-id : i64]
  [pos : i64]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (compiler-ir-instr-cons
        (opt-global-cse-instr facts doms block-id pos instr)
        (opt-global-cse-instrs facts doms block-id (+ pos 1) (box-get rest)))]))

(define (opt-global-cse-instr-seq
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [block-label : String]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [index : i64 (- (struct-get instrs len) 1)]
    [block-id : i64 (opt-global-block-id doms block-label)]
    [out : CompilerIrInstrList (IrInstrNil)]
    (begin
      (while (>= index 0)
        (begin
          (set!
            out
            (compiler-ir-instr-cons
              (opt-global-cse-instr
                facts
                doms
                block-id
                (+ index 1)
                (array-ref slots index))
              out))
          (set! index (- index 1))))
      out)))

(define (opt-global-cse-blocks
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (compiler-ir-block-cons
            (compiler-ir-block
              label
              (opt-global-cse-instr-seq facts doms label instrs))
            (opt-global-cse-blocks facts doms (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-global-cse-blocks facts doms (compiler-ir-block-seq-to-list seq))]))

(define (opt-global-value-number-blocks-with-context
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [doms : OptDomInfo (struct-get context doms)]
    [copy-fact-list : OptGlobalCopyFacts
      (opt-global-copy-facts-from-blocks doms blocks (OptGlobalCopyNil))]
    [copy-facts : OptGlobalCopyFactTable
      (opt-global-copy-table-from-facts copy-fact-list)]
    [copied : CompilerIrBlockList
      (opt-global-copy-blocks copy-facts doms blocks)]
    [expr-fact-list : OptGlobalExprFacts
      (opt-global-expr-facts-from-blocks doms copied (OptGlobalExprNil))]
    [expr-facts : OptGlobalExprFactTable
      (opt-global-expr-table-from-facts expr-fact-list)]
    [cse : CompilerIrBlockList (opt-global-cse-blocks expr-facts doms copied)]
    [cse-copy-fact-list : OptGlobalCopyFacts
      (opt-global-copy-facts-from-blocks doms cse (OptGlobalCopyNil))]
    [cse-copy-facts : OptGlobalCopyFactTable
      (opt-global-copy-table-from-facts cse-copy-fact-list)]
    (opt-global-copy-blocks cse-copy-facts doms cse)))

(define (opt-global-value-number-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-global-value-number-blocks-with-context
    (opt-cfg-context-build blocks)
    blocks))

(define (opt-global-value-number-function-with-context
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-verify-function-with-context func context)
    [(OkCompilerOptimizeVerify)
      (match func
        [(IrFunction name params ret-ty frame blocks)
          (IrFunction
            name
            params
            ret-ty
            frame
            (opt-global-value-number-blocks-with-context context blocks))])]
    [(ErrCompilerOptimizeVerify _) func]))

(define (opt-global-value-number-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction _ _ _ _ blocks)
      (opt-global-value-number-function-with-context
        (opt-cfg-context-build blocks)
        func)]))

(define (opt-cfg-foldable-branch-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrBranch cond _ _)
      (match cond
        [(IrValueBool _) true]
        [_ false])]
    [_ false]))

(define (opt-cfg-foldable-branch-instr-seq?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-cfg-foldable-branch-instr?
      (compiler-ir-instr-seq-ref instrs index))
      true
      (opt-cfg-foldable-branch-instr-seq? instrs (+ index 1)))))

(define (opt-cfg-foldable-branch-block? [block : CompilerIrBlock]) : bool
  (match block
    [(IrBlock _ instrs) (opt-cfg-foldable-branch-instr-seq? instrs 0)]))

(define (opt-cfg-blocks-have-foldable-branch? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (if (opt-cfg-foldable-branch-block? block)
        true
        (opt-cfg-blocks-have-foldable-branch? (box-get rest)))]
    [(IrBlockArray seq)
      (opt-cfg-blocks-have-foldable-branch? (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-fold-branch [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrBranch cond true-label false-label)
      (match cond
        [(IrValueBool known)
          (if known
            (IrInstrJump true-label)
            (IrInstrJump false-label))]
        [_ instr])]
    [_ instr]))

(define (opt-cfg-fold-branches-instr-seq [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [index : i64 (- (struct-get instrs len) 1)]
    [out : CompilerIrInstrList IrInstrNil]
    (begin
      (while (>= index 0)
        (begin
          (set!
            out
            (compiler-ir-instr-cons
              (opt-cfg-fold-branch (array-ref slots index))
              out))
          (set! index (- index 1))))
      out)))

(define (opt-cfg-fold-branches-block [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-cfg-fold-branches-instr-seq instrs))]))

(define (opt-cfg-fold-branches-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (opt-cfg-fold-branches-block block)
        (opt-cfg-fold-branches-blocks (box-get rest)))]
    [(IrBlockArray seq)
      (opt-cfg-fold-branches-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-instr-successors [set : OptLabelSet] [instr : CompilerIrInstr]) : OptLabelSet
  (match instr
    [(IrInstrJump label) (opt-label-add set label)]
    [(IrInstrBranch _ true-label false-label)
      (opt-label-add (opt-label-add set true-label) false-label)]
    [_ set]))

(define (opt-cfg-instr-seq-successors
  [set : OptLabelSet]
  [instrs : CompilerIrInstrSeq]) : OptLabelSet
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [out : OptLabelSet set]
    (begin
      (while (< index count)
        (begin
          (set! out (opt-cfg-instr-successors out (array-ref slots index)))
          (set! index (+ index 1))))
      out)))

(define (opt-cfg-block-successors [block : CompilerIrBlock]) : OptLabelSet
  (match block
    [(IrBlock _ instrs) (opt-cfg-instr-seq-successors (OptLabelNil) instrs)]))

(define (opt-cfg-terminator-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrJump _) true]
    [(IrInstrBranch _ _ _) true]
    [(IrInstrReturn _) true]
    [(IrInstrTailCall _ _ _) true]
    [(IrInstrTailCallIndirect _ _ _) true]
    [_ false]))

(define (opt-cfg-instr-seq-can-fallthrough? [instrs : CompilerIrInstrSeq]) : bool
  (let
    [count : i64 (struct-get instrs len)]
    (if (= count 0)
      true
      (not
        (opt-cfg-terminator-instr?
          (array-ref (struct-get instrs slots) (- count 1)))))))

(define (opt-cfg-block-successors-with-next
  [block : CompilerIrBlock]
  [next-label : String]) : OptLabelSet
  (match block
    [(IrBlock _ instrs)
      (let
        [explicit : OptLabelSet
          (opt-cfg-instr-seq-successors (OptLabelNil) instrs)]
        (if (and
          (> (string-length next-label) 0)
          (opt-cfg-instr-seq-can-fallthrough? instrs))
          (opt-label-add explicit next-label)
          explicit))]))

(define (opt-cfg-blocks-successors-scan
  [blocks : CompilerIrBlockList]
  [label : String]) : OptLabelSet
  (match blocks
    [(IrBlockNil) (OptLabelNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock block-label _)
          (if (string-eq block-label label)
            (opt-cfg-block-successors-with-next
              block
              (opt-cfg-entry-label (box-get rest)))
            (opt-cfg-blocks-successors-scan (box-get rest) label))])]
    [(IrBlockArray seq)
      (opt-cfg-blocks-successors-scan (compiler-ir-block-seq-to-list seq) label)]))

(define (opt-cfg-blocks-successors
  [blocks : CompilerIrBlockList]
  [label : String]) : OptLabelSet
  (opt-cfg-index-successors (opt-cfg-index-build blocks) label))

(define (opt-cfg-reachable-blocks [blocks : CompilerIrBlockList]) : OptLabelSet
  (opt-cfg-index-reachable-labels (opt-cfg-index-build blocks)))

(defenum OptLoopPreheader
  (OptNoLoopPreheader)
  (OptSomeLoopPreheader String))

(defenum OptLoopPreheaderCandidate
  (OptLoopPreheaderNone)
  (OptLoopPreheaderOne String)
  (OptLoopPreheaderMany))

(defstruct OptLoopBody
  (labels OptLabelSet)
  (members (Array bool))
  (blocks CompilerIrBlockList))

(defenum OptNaturalLoop
  (OptNaturalLoop String String OptLoopBody OptLoopPreheader))

(defenum OptMaybeNaturalLoop
  (OptNoNaturalLoop)
  (OptSomeNaturalLoop OptNaturalLoop))

(defenum OptNaturalLoopList
  (OptNaturalLoopNil)
  (OptNaturalLoopCons OptNaturalLoop (Box OptNaturalLoopList)))

(defenum OptNaturalLoopCollectState
  (OptNaturalLoopCollectState OptLabelSet OptLabelSet))

(define (opt-loop-body-fill-members!
  [index : OptCfgIndex]
  [members : (Array bool)]
  [labels : OptLabelSet]) : unit
  (match labels
    [(OptLabelNil) unit]
    [(OptLabelCons label rest)
      (begin
        (match (opt-cfg-index-id index label)
          [(OptSomeI64 id)
            (if (and (>= id 0) (< id (array-length members)))
              (array-set! members id true)
              unit)]
          [(OptNoI64) unit])
        (opt-loop-body-fill-members! index members (box-get rest)))]))

(define (opt-loop-body-member-array-contains-id?
  [members : (Array bool)]
  [id : i64]) : bool
  (if (and (>= id 0) (< id (array-length members)))
    (array-ref members id)
    false))

(define (opt-loop-body-blocks-from
  [index : OptCfgIndex]
  [members : (Array bool)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (let
            [tail : CompilerIrBlockList
              (opt-loop-body-blocks-from index members (box-get rest))]
            (match (opt-cfg-index-id index label)
              [(OptSomeI64 id)
                (if (opt-loop-body-member-array-contains-id? members id)
                  (compiler-ir-block-cons block tail)
                  tail)]
              [(OptNoI64) tail]))])]
    [(IrBlockArray seq)
      (opt-loop-body-blocks-from
        index
        members
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-body-build
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [labels : OptLabelSet]) : OptLoopBody
  (let
    [members : (Array bool) (make-array bool (opt-cfg-index-block-count index))]
    (begin
      (opt-cfg-fill-bool! members (array-length members) false)
      (opt-loop-body-fill-members! index members labels)
      (OptLoopBody
        labels
        members
        (opt-loop-body-blocks-from index members blocks)))))

(define (opt-loop-body-labels [body : OptLoopBody]) : OptLabelSet
  (struct-get body labels))

(define (opt-loop-body-blocks [body : OptLoopBody]) : CompilerIrBlockList
  (struct-get body blocks))

(define (opt-loop-body-contains-id? [body : OptLoopBody] [id : i64]) : bool
  (opt-loop-body-member-array-contains-id? (struct-get body members) id))

(define (opt-loop-body-label-member?
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [label : String]) : bool
  (match (opt-cfg-index-id index label)
    [(OptSomeI64 id) (opt-loop-body-contains-id? body id)]
    [(OptNoI64) false]))

(define (opt-loop-body-current-blocks-from
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (let
            [tail : CompilerIrBlockList
              (opt-loop-body-current-blocks-from body index (box-get rest))]
            (match (opt-cfg-index-id index label)
              [(OptSomeI64 id)
                (if (opt-loop-body-contains-id? body id)
                  (compiler-ir-block-cons block tail)
                  tail)]
              [(OptNoI64) tail]))])]
    [(IrBlockArray seq)
      (opt-loop-body-current-blocks-from
        body
        index
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-natural-loop-header [loop : OptNaturalLoop]) : String
  (match loop
    [(OptNaturalLoop header _ _ _) header]))

(define (opt-natural-loop-latch [loop : OptNaturalLoop]) : String
  (match loop
    [(OptNaturalLoop _ latch _ _) latch]))

(define (opt-natural-loop-body-info [loop : OptNaturalLoop]) : OptLoopBody
  (match loop
    [(OptNaturalLoop _ _ body _) body]))

(define (opt-natural-loop-body [loop : OptNaturalLoop]) : OptLabelSet
  (match loop
    [(OptNaturalLoop _ _ body _) (opt-loop-body-labels body)]))

(define (opt-natural-loop-body-blocks [loop : OptNaturalLoop]) : CompilerIrBlockList
  (opt-loop-body-blocks (opt-natural-loop-body-info loop)))

(define (opt-natural-loop-body-contains-id? [loop : OptNaturalLoop] [id : i64]) : bool
  (opt-loop-body-contains-id? (opt-natural-loop-body-info loop) id))

(define (opt-natural-loop-current-body-blocks
  [index : OptCfgIndex]
  [loop : OptNaturalLoop]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-loop-body-current-blocks-from
    (opt-natural-loop-body-info loop)
    index
    blocks))

(define (opt-natural-loop-preheader [loop : OptNaturalLoop]) : OptLoopPreheader
  (match loop
    [(OptNaturalLoop _ _ _ preheader) preheader]))

(define (opt-natural-loop-list-count [loops : OptNaturalLoopList]) : i64
  (match loops
    [(OptNaturalLoopNil) 0]
    [(OptNaturalLoopCons _ rest)
      (+ 1 (opt-natural-loop-list-count (box-get rest)))]))

(define (opt-natural-loop-find
  [loops : OptNaturalLoopList]
  [header : String]
  [latch : String]) : OptMaybeNaturalLoop
  (match loops
    [(OptNaturalLoopNil) (OptNoNaturalLoop)]
    [(OptNaturalLoopCons loop rest)
      (if (and
        (string-eq (opt-natural-loop-header loop) header)
        (string-eq (opt-natural-loop-latch loop) latch))
        (OptSomeNaturalLoop loop)
        (opt-natural-loop-find (box-get rest) header latch))]))

;; #2117: membership during body collection is an O(1) id-indexed marks
;; array (the body/worklist LISTS keep their exact construction order, so
;; downstream output is byte-identical); reachability reads the CFG index's
;; bool array instead of scanning the label list.
(define (opt-natural-loop-collect-add-pred
  [index : OptCfgIndex]
  [marks : (Array bool)]
  [state : OptNaturalLoopCollectState]
  [pred : String]) : OptNaturalLoopCollectState
  (match state
    [(OptNaturalLoopCollectState body worklist)
      (match (opt-cfg-index-id index pred)
        [(OptSomeI64 pred-id)
          (if (and
            (array-ref (struct-get index reachable) pred-id)
            (not (array-ref marks pred-id)))
            (begin
              (array-set! marks pred-id true)
              (OptNaturalLoopCollectState
                (opt-label-add body pred)
                (opt-label-add worklist pred)))
            state)]
        [(OptNoI64) state])]))

(define (opt-natural-loop-collect-add-preds
  [index : OptCfgIndex]
  [marks : (Array bool)]
  [preds : OptLabelSet]
  [state : OptNaturalLoopCollectState]) : OptNaturalLoopCollectState
  (match preds
    [(OptLabelNil) state]
    [(OptLabelCons pred rest)
      (opt-natural-loop-collect-add-preds
        index
        marks
        (box-get rest)
        (opt-natural-loop-collect-add-pred index marks state pred))]))

(define (opt-natural-loop-collect-body
  [pred-map : OptPredMap]
  [index : OptCfgIndex]
  [marks : (Array bool)]
  [body : OptLabelSet]
  [worklist : OptLabelSet]) : OptLabelSet
  (match worklist
    [(OptLabelNil) body]
    [(OptLabelCons label rest)
      (let
        [state : OptNaturalLoopCollectState
          (opt-natural-loop-collect-add-preds
            index
            marks
            (opt-pred-map-lookup pred-map label)
            (OptNaturalLoopCollectState body (box-get rest)))]
        (match state
          [(OptNaturalLoopCollectState next-body next-worklist)
            (opt-natural-loop-collect-body
              pred-map
              index
              marks
              next-body
              next-worklist)]))]))

(define (opt-natural-loop-mark-label!
  [index : OptCfgIndex]
  [marks : (Array bool)]
  [label : String]) : unit
  (match (opt-cfg-index-id index label)
    [(OptSomeI64 id) (array-set! marks id true)]
    [(OptNoI64) unit]))

(define (opt-natural-loop-safe-preheader-block?
  [pred-map : OptPredMap]
  [label : String]
  [header : String]) : bool
  (let
    [successors : OptLabelSet (opt-pred-map-successors pred-map label)]
    (and
      (= (opt-label-count successors) 1)
      (opt-label-contains successors header))))

(define (opt-natural-loop-preheader-candidate-add
  [pred-map : OptPredMap]
  [header : String]
  [candidate : OptLoopPreheaderCandidate]
  [pred : String]) : OptLoopPreheaderCandidate
  (match candidate
    [(OptLoopPreheaderMany) (OptLoopPreheaderMany)]
    [(OptLoopPreheaderNone)
      (if (opt-natural-loop-safe-preheader-block? pred-map pred header)
        (OptLoopPreheaderOne pred)
        (OptLoopPreheaderMany))]
    [(OptLoopPreheaderOne _) (OptLoopPreheaderMany)]))

(define (opt-natural-loop-preheader-candidate-scan
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [header : String]
  [body : OptLabelSet]
  [preds : OptLabelSet]
  [candidate : OptLoopPreheaderCandidate]) : OptLoopPreheaderCandidate
  (match preds
    [(OptLabelNil) candidate]
    [(OptLabelCons pred rest)
      (if (and
        (opt-label-contains reachable pred)
        (not (opt-label-contains body pred)))
        (opt-natural-loop-preheader-candidate-scan
          pred-map
          reachable
          header
          body
          (box-get rest)
          (opt-natural-loop-preheader-candidate-add
            pred-map
            header
            candidate
            pred))
        (opt-natural-loop-preheader-candidate-scan
          pred-map
          reachable
          header
          body
          (box-get rest)
          candidate))]))

(define (opt-natural-loop-preheader-from-candidate
  [candidate : OptLoopPreheaderCandidate]) : OptLoopPreheader
  (match candidate
    [(OptLoopPreheaderOne label) (OptSomeLoopPreheader label)]
    [_ (OptNoLoopPreheader)]))

(define (opt-natural-loop-find-preheader
  [_blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [header : String]
  [body : OptLabelSet]) : OptLoopPreheader
  (opt-natural-loop-preheader-from-candidate
    (opt-natural-loop-preheader-candidate-scan
      pred-map
      reachable
      header
      body
      (opt-pred-map-lookup pred-map header)
      (OptLoopPreheaderNone))))

(define (opt-natural-loop-build
  [blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [header : String]
  [latch : String]) : OptNaturalLoop
  (let
    [index : OptCfgIndex (struct-get pred-map index)]
    [marks : (Array bool) (make-array bool (opt-cfg-index-block-count index))]
    [_clear-marks : unit (opt-cfg-fill-bool! marks (array-length marks) false)]
    [_seed-header : unit (opt-natural-loop-mark-label! index marks header)]
    [_seed-latch : unit (opt-natural-loop-mark-label! index marks latch)]
    [body-labels : OptLabelSet
      (opt-natural-loop-collect-body
        pred-map
        index
        marks
        (opt-label-add (opt-label-add (OptLabelNil) header) latch)
        (opt-label-add (OptLabelNil) latch))]
    [body : OptLoopBody
      (opt-loop-body-build blocks (struct-get pred-map index) body-labels)]
    (OptNaturalLoop
      header
      latch
      body
      (opt-natural-loop-find-preheader
        blocks
        pred-map
        reachable
        header
        body-labels))))

(define (opt-cfg-natural-loop-successors
  [blocks : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [source-id : i64]
  [source : String]
  [successors : OptLabelSet]
  [tail : OptNaturalLoopList]) : OptNaturalLoopList
  (match successors
    [(OptLabelNil) tail]
    [(OptLabelCons header rest)
      (let
        [next : OptNaturalLoopList
          (opt-cfg-natural-loop-successors
            blocks
            pred-map
            reachable
            doms
            source-id
            source
            (box-get rest)
            tail)]
        (match (opt-cfg-index-id (struct-get doms index) header)
          [(OptSomeI64 header-id)
            (if (and
              (opt-label-contains reachable header)
              (opt-dom-info-dominates-id? doms header-id source-id))
              (OptNaturalLoopCons
                (opt-natural-loop-build blocks pred-map reachable header source)
                (box next))
              next)]
          [(OptNoI64) next]))]))

(define (opt-cfg-natural-loop-blocks
  [all-blocks : CompilerIrBlockList]
  [remaining : CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]) : OptNaturalLoopList
  (match remaining
    [(IrBlockNil) (OptNaturalLoopNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (let
            [tail : OptNaturalLoopList
              (opt-cfg-natural-loop-blocks
                all-blocks
                (box-get rest)
                pred-map
                reachable
                doms)]
            (if (opt-label-contains reachable label)
              (match (opt-cfg-index-id (struct-get doms index) label)
                [(OptSomeI64 source-id)
                  (opt-cfg-natural-loop-successors
                    all-blocks
                    pred-map
                    reachable
                    doms
                    source-id
                    label
                    (opt-cfg-block-successors-with-next
                      block
                      (opt-cfg-entry-label (box-get rest)))
                    tail)]
                [(OptNoI64) tail])
              tail))])]
    [(IrBlockArray seq)
      (opt-cfg-natural-loop-blocks
        all-blocks
        (compiler-ir-block-seq-to-list seq)
        pred-map
        reachable
        doms)]))

(define (opt-cfg-natural-loops-with-context
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]) : OptNaturalLoopList
  (opt-cfg-natural-loop-blocks
    blocks
    blocks
    (struct-get context pred-map)
    (struct-get context reachable)
    (struct-get context doms)))

(define (opt-cfg-natural-loops [blocks : CompilerIrBlockList]) : OptNaturalLoopList
  (opt-cfg-natural-loops-with-context blocks (opt-cfg-context-build blocks)))

;; --- safe loop preheader synthesis (#2457) ----------------------------------
;;
;; LICM and induction only operate on loops with a dedicated outside predecessor
;; whose only successor is the loop header. This pass creates that block for
;; conservative natural loops and falls back to the original function if the
;; verifier rejects the result.
(defenum OptLoopPreheadersResult
  (OptLoopPreheadersResult CompilerIrBlockList bool))

(defenum OptLoopPreheadersPhiRewriteResult
  (OptLoopPreheadersPhiRewriteResult CompilerIrPhiInputList bool))

(define (opt-loop-preheaders-outside-preds-scan
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [header : String]
  [body : OptLabelSet]
  [preds : OptLabelSet]) : OptLabelSet
  (match preds
    [(OptLabelNil) (OptLabelNil)]
    [(OptLabelCons pred rest)
      (let
        [tail : OptLabelSet
          (opt-loop-preheaders-outside-preds-scan
            reachable
            doms
            header
            body
            (box-get rest))]
        (if (and
          (opt-label-contains reachable pred)
          (not (opt-label-contains body pred))
          (not (opt-dom-dominates? doms header pred)))
          (opt-label-add tail pred)
          tail))]))

(define (opt-loop-preheaders-outside-preds
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [header : String]
  [body : OptLabelSet]) : OptLabelSet
  (opt-loop-preheaders-outside-preds-scan
    reachable
    doms
    header
    body
    (opt-pred-map-lookup pred-map header)))

(define (opt-loop-preheaders-candidate-label [header : String] [suffix : i64]) : String
  (if (= suffix 0)
    (string-append header "__preheader")
    (string-append header (string-append "__preheader" (int->string suffix)))))

(define (opt-loop-preheaders-fresh-label
  [blocks : CompilerIrBlockList]
  [header : String]
  [suffix : i64]) : String
  (let
    [candidate : String (opt-loop-preheaders-candidate-label header suffix)]
    (if (opt-cfg-block-exists? blocks candidate)
      (opt-loop-preheaders-fresh-label blocks header (+ suffix 1))
      candidate)))

(define (opt-loop-preheaders-phi-outside-values-compatible?
  [outside : OptLabelSet]
  [inputs : CompilerIrPhiInputList]
  [seen : CompilerIrMaybeValue]) : bool
  (match inputs
    [(IrPhiInputNil) true]
    [(IrPhiInputCons value label rest)
      (if (opt-label-contains outside label)
        (match seen
          [(IrNoValue)
            (opt-loop-preheaders-phi-outside-values-compatible?
              outside
              (box-get rest)
              (IrSomeValue value))]
          [(IrSomeValue first)
            (and
              (opt-value-eq first value)
              (opt-loop-preheaders-phi-outside-values-compatible?
                outside
                (box-get rest)
                seen))])
        (opt-loop-preheaders-phi-outside-values-compatible?
          outside
          (box-get rest)
          seen))]))

(define (opt-loop-preheaders-header-instr-compatible?
  [outside : OptLabelSet]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrPhi _ inputs _)
      (opt-loop-preheaders-phi-outside-values-compatible?
        outside
        inputs
        (IrNoValue))]
    [_ true]))

(define (opt-loop-preheaders-header-instrs-compatible-from?
  [outside : OptLabelSet]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-loop-preheaders-header-instr-compatible?
        outside
        (compiler-ir-instr-seq-ref instrs index))
      (opt-loop-preheaders-header-instrs-compatible-from?
        outside
        instrs
        (+ index 1)))))

(define (opt-loop-preheaders-header-compatible?
  [blocks : CompilerIrBlockList]
  [header : String]
  [outside : OptLabelSet]) : bool
  (match (opt-cfg-find-block blocks header)
    [(OptNoBlock) false]
    [(OptSomeBlock block)
      (match block
        [(IrBlock _ instrs)
          (opt-loop-preheaders-header-instrs-compatible-from? outside instrs 0)])]))

(define (opt-loop-preheaders-existing-candidate-scan
  [pred-map : OptPredMap]
  [header : String]
  [outside : OptLabelSet]
  [candidate : OptLoopPreheaderCandidate]) : OptLoopPreheaderCandidate
  (match outside
    [(OptLabelNil) candidate]
    [(OptLabelCons pred rest)
      (opt-loop-preheaders-existing-candidate-scan
        pred-map
        header
        (box-get rest)
        (opt-natural-loop-preheader-candidate-add
          pred-map
          header
          candidate
          pred))]))

(define (opt-loop-preheaders-existing-safe-preheader?
  [pred-map : OptPredMap]
  [header : String]
  [outside : OptLabelSet]) : bool
  (match (opt-natural-loop-preheader-from-candidate
    (opt-loop-preheaders-existing-candidate-scan
      pred-map
      header
      outside
      (OptLoopPreheaderNone)))
    [(OptSomeLoopPreheader _) true]
    [(OptNoLoopPreheader) false]))

(define (opt-loop-preheaders-rewrite-phi-inputs-acc
  [inputs : CompilerIrPhiInputList]
  [outside : OptLabelSet]
  [preheader : String]
  [emitted : bool]
  [acc : CompilerIrPhiInputList]) : OptLoopPreheadersPhiRewriteResult
  (match inputs
    [(IrPhiInputNil)
      (OptLoopPreheadersPhiRewriteResult
        (compiler-ir-phi-input-list-reverse-onto acc (IrPhiInputNil))
        emitted)]
    [(IrPhiInputCons value label rest)
      (if (opt-label-contains outside label)
        (if emitted
          (opt-loop-preheaders-rewrite-phi-inputs-acc
            (box-get rest)
            outside
            preheader
            true
            acc)
          (opt-loop-preheaders-rewrite-phi-inputs-acc
            (box-get rest)
            outside
            preheader
            true
            (compiler-ir-phi-input-cons value preheader acc)))
        (opt-loop-preheaders-rewrite-phi-inputs-acc
          (box-get rest)
          outside
          preheader
          emitted
          (compiler-ir-phi-input-cons value label acc)))]))

(define (opt-loop-preheaders-rewrite-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [outside : OptLabelSet]
  [preheader : String]) : CompilerIrPhiInputList
  (match (opt-loop-preheaders-rewrite-phi-inputs-acc
    inputs
    outside
    preheader
    false
    (IrPhiInputNil))
    [(OptLoopPreheadersPhiRewriteResult rewritten _) rewritten]))

(define (opt-loop-preheaders-rewrite-header-instr
  [outside : OptLabelSet]
  [preheader : String]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrPhi dst inputs ty)
      (IrInstrPhi
        dst
        (opt-loop-preheaders-rewrite-phi-inputs inputs outside preheader)
        ty)]
    [_ instr]))

(define (opt-loop-preheaders-rewrite-header-instrs-from
  [outside : OptLabelSet]
  [preheader : String]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (IrInstrNil)
    (compiler-ir-instr-cons
      (opt-loop-preheaders-rewrite-header-instr
        outside
        preheader
        (compiler-ir-instr-seq-ref instrs index))
      (opt-loop-preheaders-rewrite-header-instrs-from
        outside
        preheader
        instrs
        (+ index 1)))))

(define (opt-loop-preheaders-retarget-label
  [label : String]
  [header : String]
  [preheader : String]) : String
  (if (string-eq label header)
    preheader
    label))

(define (opt-loop-preheaders-retarget-instr
  [instr : CompilerIrInstr]
  [header : String]
  [preheader : String]) : CompilerIrInstr
  (match instr
    [(IrInstrJump label)
      (IrInstrJump (opt-loop-preheaders-retarget-label label header preheader))]
    [(IrInstrBranch cond true-label false-label)
      (IrInstrBranch
        cond
        (opt-loop-preheaders-retarget-label true-label header preheader)
        (opt-loop-preheaders-retarget-label false-label header preheader))]
    [_ instr]))

(define (opt-loop-preheaders-retarget-instrs-from
  [instrs : CompilerIrInstrSeq]
  [header : String]
  [preheader : String]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (IrInstrNil)
    (compiler-ir-instr-cons
      (opt-loop-preheaders-retarget-instr
        (compiler-ir-instr-seq-ref instrs index)
        header
        preheader)
      (opt-loop-preheaders-retarget-instrs-from
        instrs
        header
        preheader
        (+ index 1)))))

(define (opt-loop-preheaders-append-jump
  [instrs : CompilerIrInstrList]
  [target : String]) : CompilerIrInstrList
  (opt-aggregate-instr-list-append
    instrs
    (compiler-ir-instr-cons (IrInstrJump target) (IrInstrNil))))

(define (opt-loop-preheaders-rewrite-block
  [block : CompilerIrBlock]
  [next-label : String]
  [header : String]
  [outside : OptLabelSet]
  [preheader : String]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (if (string-eq label header)
        (compiler-ir-block
          label
          (opt-loop-preheaders-rewrite-header-instrs-from
            outside
            preheader
            instrs
            0))
        (if (opt-label-contains outside label)
          (let
            [retargeted : CompilerIrInstrList
              (opt-loop-preheaders-retarget-instrs-from
                instrs
                header
                preheader
                0)]
            (compiler-ir-block
              label
              (if (and
                (string-eq next-label header)
                (opt-cfg-instr-seq-can-fallthrough? instrs))
                (opt-loop-preheaders-append-jump retargeted preheader)
                retargeted)))
          block))]))

(define (opt-loop-preheaders-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [header : String]
  [outside : OptLabelSet]
  [preheader : String]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (opt-loop-preheaders-rewrite-block
          block
          (opt-cfg-entry-label (box-get rest))
          header
          outside
          preheader)
        (opt-loop-preheaders-rewrite-blocks
          (box-get rest)
          header
          outside
          preheader))]
    [(IrBlockArray seq)
      (opt-loop-preheaders-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        header
        outside
        preheader)]))

(define (opt-loop-preheaders-new-block [preheader : String] [header : String]) : CompilerIrBlock
  (compiler-ir-block
    preheader
    (compiler-ir-instr-cons (IrInstrJump header) (IrInstrNil))))

(define (opt-loop-preheaders-insert-before-header
  [blocks : CompilerIrBlockList]
  [header : String]
  [preheader : String]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (if (string-eq label header)
            (compiler-ir-block-cons
              (opt-loop-preheaders-new-block preheader header)
              (compiler-ir-block-cons block (box-get rest)))
            (compiler-ir-block-cons
              block
              (opt-loop-preheaders-insert-before-header
                (box-get rest)
                header
                preheader)))])]
    [(IrBlockArray seq)
      (opt-loop-preheaders-insert-before-header
        (compiler-ir-block-seq-to-list seq)
        header
        preheader)]))

(define (opt-loop-preheaders-synthesize-loop
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [loop : OptNaturalLoop]) : OptLoopPreheadersResult
  (match (opt-natural-loop-preheader loop)
    [(OptSomeLoopPreheader _) (OptLoopPreheadersResult blocks false)]
    [(OptNoLoopPreheader)
      (let
        [header : String (opt-natural-loop-header loop)]
        [body : OptLabelSet (opt-natural-loop-body loop)]
        [outside : OptLabelSet
          (opt-loop-preheaders-outside-preds
            (struct-get context pred-map)
            (struct-get context reachable)
            (struct-get context doms)
            header
            body)]
        (if (and
          (> (opt-label-count outside) 0)
          (not
            (opt-loop-preheaders-existing-safe-preheader?
              (struct-get context pred-map)
              header
              outside))
          (opt-loop-preheaders-header-compatible? blocks header outside))
          (let
            [preheader : String
              (opt-loop-preheaders-fresh-label blocks header 0)]
            [rewritten : CompilerIrBlockList
              (opt-loop-preheaders-rewrite-blocks
                blocks
                header
                outside
                preheader)]
            (OptLoopPreheadersResult
              (opt-loop-preheaders-insert-before-header
                rewritten
                header
                preheader)
              true))
          (OptLoopPreheadersResult blocks false)))]))

(define (opt-loop-preheaders-synthesize-loops
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]) : OptLoopPreheadersResult
  (match loops
    [(OptNaturalLoopNil) (OptLoopPreheadersResult blocks false)]
    [(OptNaturalLoopCons loop rest)
      (match (opt-loop-preheaders-synthesize-loop blocks context loop)
        [(OptLoopPreheadersResult next changed)
          (if changed
            (OptLoopPreheadersResult next true)
            (opt-loop-preheaders-synthesize-loops blocks context (box-get rest)))])]))

(define (opt-loop-preheaders-blocks-once [blocks : CompilerIrBlockList]) : OptLoopPreheadersResult
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (opt-loop-preheaders-synthesize-loops
      blocks
      context
      (opt-cfg-natural-loops-with-context blocks context))))

(define (opt-loop-preheaders-blocks-fixed
  [blocks : CompilerIrBlockList]
  [remaining : i64]) : CompilerIrBlockList
  (if (<= remaining 0)
    blocks
    (match (opt-loop-preheaders-blocks-once blocks)
      [(OptLoopPreheadersResult next changed)
        (if changed
          (opt-loop-preheaders-blocks-fixed next (- remaining 1))
          next)])))

(define (opt-loop-preheaders-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-loop-preheaders-blocks-fixed
    blocks
    (+ 1 (compiler-ir-block-list-count blocks))))

(define (opt-loop-preheaders-function-with-context-result
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-function-with-context func context)
    [(OkCompilerOptimizeVerify)
      (match func
        [(IrFunction name params ret-ty frame blocks)
          (let
            [next-blocks : CompilerIrBlockList
              (opt-loop-preheaders-blocks blocks)]
            [next : CompilerIrFunction
              (IrFunction name params ret-ty frame next-blocks)]
            ;; Preheader synthesis may have inserted blocks, so build one fresh
            ;; context for the rewritten CFG, reuse it for the post-pass verify,
            ;; and hand it back for the next pass.
            [next-context : OptCfgContext (opt-cfg-context-build next-blocks)]
            (match (opt-verify-function-with-context next next-context)
              [(OkCompilerOptimizeVerify)
                (OptFunctionCtxResult next next-context)]
              [(ErrCompilerOptimizeVerify _)
                (OptFunctionCtxResult func context)]))])]
    [(ErrCompilerOptimizeVerify _) (OptFunctionCtxResult func context)]))

(define (opt-loop-preheaders-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction _ _ _ _ blocks)
      (match (opt-loop-preheaders-function-with-context-result
        (opt-cfg-context-build blocks)
        func)
        [(OptFunctionCtxResult next _) next])]))

;; --- simple top-test loop rotation (#2458) ----------------------------------
;;
;; This runs before scalar SSA construction. It only rotates non-SSA loops whose
;; header is a side-effect-free scalar guard ending in a conditional branch, with
;; one safe preheader and one latch. Duplicating the guard into the preheader and
;; latch preserves the zero-trip check while making the steady-state backedge
;; jump directly to the loop body. SSA construction then inserts the phis needed
;; for loop-carried values and rejects unsupported shapes through its existing
;; verifier gate.
(defenum OptLoopRotationHeader
  (OptNoLoopRotationHeader)
  (OptLoopRotationHeader CompilerIrInstrList))

(defenum OptLoopRotationResult
  (OptLoopRotationResult CompilerIrBlockList bool))

(define (opt-loop-rotation-header-count
  [loops : OptNaturalLoopList]
  [header : String]) : i64
  (match loops
    [(OptNaturalLoopNil) 0]
    [(OptNaturalLoopCons loop rest)
      (+
        (if (string-eq (opt-natural-loop-header loop) header)
          1
          0)
        (opt-loop-rotation-header-count (box-get rest) header))]))

(define (opt-loop-rotation-guard-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrMov _ _ _) true]
    [(IrInstrCast _ _ _ _) true]
    [(IrInstrBitcast _ _ _ _) true]
    [(IrInstrBinOp _ op _ _ _) (not (opt-binop-traps? op))]
    [(IrInstrUnOp _ _ _ _) true]
    [_ false]))

(define (opt-loop-rotation-header-prefix-ok?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-loop-rotation-guard-instr? (compiler-ir-instr-seq-ref instrs index))
      (opt-loop-rotation-header-prefix-ok? instrs (+ index 1) last))))

(define (opt-loop-rotation-header-list-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (IrInstrNil)
    (compiler-ir-instr-cons
      (compiler-ir-instr-seq-ref instrs index)
      (opt-loop-rotation-header-list-from instrs (+ index 1)))))

(define (opt-loop-rotation-body-target?
  [body : OptLabelSet]
  [header : String]
  [label : String]) : bool
  (and (not (string-eq label header)) (opt-label-contains body label)))

(define (opt-loop-rotation-exit-target? [body : OptLabelSet] [label : String]) : bool
  (not (opt-label-contains body label)))

(define (opt-loop-rotation-header-shape
  [blocks : CompilerIrBlockList]
  [header : String]
  [body : OptLabelSet]) : OptLoopRotationHeader
  (match (opt-cfg-find-block blocks header)
    [(OptNoBlock) (OptNoLoopRotationHeader)]
    [(OptSomeBlock block)
      (match block
        [(IrBlock _ instrs)
          (let
            [count : i64 (compiler-ir-instr-seq-count instrs)]
            (if (<= count 0)
              (OptNoLoopRotationHeader)
              (let
                [last : i64 (- count 1)]
                (match (compiler-ir-instr-seq-ref instrs last)
                  [(IrInstrBranch _ true-label false-label)
                    (if (and
                      (opt-loop-rotation-header-prefix-ok? instrs 0 last)
                      (or
                        (and
                          (opt-loop-rotation-body-target?
                            body
                            header
                            true-label)
                          (opt-loop-rotation-exit-target? body false-label))
                        (and
                          (opt-loop-rotation-body-target?
                            body
                            header
                            false-label)
                          (opt-loop-rotation-exit-target? body true-label))))
                      (OptLoopRotationHeader
                        (opt-loop-rotation-header-list-from instrs 0))
                      (OptNoLoopRotationHeader))]
                  [_ (OptNoLoopRotationHeader)]))))])]))

(define (opt-loop-rotation-final-jump-to?
  [instrs : CompilerIrInstrSeq]
  [target : String]) : bool
  (let
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (if (<= count 0)
      false
      (match (compiler-ir-instr-seq-ref instrs (- count 1))
        [(IrInstrJump label) (string-eq label target)]
        [_ false]))))

(define (opt-loop-rotation-edge-compatible?
  [blocks : CompilerIrBlockList]
  [label : String]
  [target : String]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptNoBlock) false]
    [(OptSomeBlock block)
      (match block
        [(IrBlock _ instrs) (opt-loop-rotation-final-jump-to? instrs target)])]))

(define (opt-loop-rotation-prefix-before-final-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : CompilerIrInstrList
  (if (>= index last)
    (IrInstrNil)
    (compiler-ir-instr-cons
      (compiler-ir-instr-seq-ref instrs index)
      (opt-loop-rotation-prefix-before-final-from instrs (+ index 1) last))))

(define (opt-loop-rotation-replace-final-jump
  [instrs : CompilerIrInstrSeq]
  [guard : CompilerIrInstrList]) : CompilerIrInstrList
  (opt-aggregate-instr-list-append
    (opt-loop-rotation-prefix-before-final-from
      instrs
      0
      (- (compiler-ir-instr-seq-count instrs) 1))
    (compiler-ir-clone-instr-list guard)))

(define (opt-loop-rotation-rewrite-block
  [block : CompilerIrBlock]
  [preheader : String]
  [latch : String]
  [guard : CompilerIrInstrList]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (if (or (string-eq label preheader) (string-eq label latch))
        (compiler-ir-block
          label
          (opt-loop-rotation-replace-final-jump instrs guard))
        block)]))

(define (opt-loop-rotation-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [header : String]
  [preheader : String]
  [latch : String]
  [guard : CompilerIrInstrList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (if (string-eq label header)
            (opt-loop-rotation-rewrite-blocks
              (box-get rest)
              header
              preheader
              latch
              guard)
            (compiler-ir-block-cons
              (opt-loop-rotation-rewrite-block block preheader latch guard)
              (opt-loop-rotation-rewrite-blocks
                (box-get rest)
                header
                preheader
                latch
                guard)))])]
    [(IrBlockArray seq)
      (opt-loop-rotation-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        header
        preheader
        latch
        guard)]))

(define (opt-loop-rotation-apply-guard
  [blocks : CompilerIrBlockList]
  [header : String]
  [preheader : String]
  [latch : String]
  [guard : CompilerIrInstrList]) : OptLoopRotationResult
  (let
    [next : CompilerIrBlockList
      (opt-loop-rotation-rewrite-blocks blocks header preheader latch guard)]
    (if (and
      (opt-cfg-block-labels-unique? next)
      (opt-cfg-successor-targets-known? next))
      (OptLoopRotationResult next true)
      (OptLoopRotationResult blocks false))))

(define (opt-loop-rotation-loop
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]
  [loop : OptNaturalLoop]) : OptLoopRotationResult
  (let
    [header : String (opt-natural-loop-header loop)]
    [latch : String (opt-natural-loop-latch loop)]
    [body : OptLabelSet (opt-natural-loop-body loop)]
    [preds : OptLabelSet
      (opt-pred-map-lookup (struct-get context pred-map) header)]
    (match (opt-natural-loop-preheader loop)
      [(OptNoLoopPreheader) (OptLoopRotationResult blocks false)]
      [(OptSomeLoopPreheader preheader)
        (if (and
          (= (opt-loop-rotation-header-count loops header) 1)
          (= (opt-label-count preds) 2)
          (opt-label-contains preds preheader)
          (opt-label-contains preds latch)
          (opt-loop-rotation-edge-compatible? blocks preheader header)
          (opt-loop-rotation-edge-compatible? blocks latch header))
          (match (opt-loop-rotation-header-shape blocks header body)
            [(OptNoLoopRotationHeader) (OptLoopRotationResult blocks false)]
            [(OptLoopRotationHeader guard)
              (opt-loop-rotation-apply-guard
                blocks
                header
                preheader
                latch
                guard)])
          (OptLoopRotationResult blocks false))])))

(define (opt-loop-rotation-loops
  [blocks : CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]
  [remaining : OptNaturalLoopList]) : OptLoopRotationResult
  (match remaining
    [(OptNaturalLoopNil) (OptLoopRotationResult blocks false)]
    [(OptNaturalLoopCons loop rest)
      (match (opt-loop-rotation-loop blocks context loops loop)
        [(OptLoopRotationResult next changed)
          (if changed
            (OptLoopRotationResult next true)
            (opt-loop-rotation-loops blocks context loops (box-get rest)))])]))

(define (opt-loop-rotation-blocks-once [blocks : CompilerIrBlockList]) : OptLoopRotationResult
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    [loops : OptNaturalLoopList
      (opt-cfg-natural-loops-with-context blocks context)]
    (opt-loop-rotation-loops blocks context loops loops)))

(define (opt-loop-rotation-blocks-fixed
  [blocks : CompilerIrBlockList]
  [remaining : i64]) : CompilerIrBlockList
  (if (<= remaining 0)
    blocks
    (match (opt-loop-rotation-blocks-once blocks)
      [(OptLoopRotationResult next changed)
        (if changed
          (opt-loop-rotation-blocks-fixed next (- remaining 1))
          next)])))

(define (opt-loop-rotation-successor-seen?
  [successors : OptLabelSet]
  [seen : OptLabelSet]) : bool
  (match successors
    [(OptLabelNil) false]
    [(OptLabelCons label rest)
      (if (opt-label-contains seen label)
        true
        (opt-loop-rotation-successor-seen? (box-get rest) seen))]))

(define (opt-loop-rotation-has-backedge-candidate-from?
  [blocks : CompilerIrBlockList]
  [seen : OptLabelSet]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (let
            [next-label : String (opt-cfg-entry-label (box-get rest))]
            [next-seen : OptLabelSet (opt-label-add seen label)]
            (if (opt-loop-rotation-successor-seen?
              (opt-cfg-block-successors-with-next block next-label)
              next-seen)
              true
              (opt-loop-rotation-has-backedge-candidate-from?
                (box-get rest)
                next-seen)))])]
    [(IrBlockArray seq)
      (opt-loop-rotation-has-backedge-candidate-from?
        (compiler-ir-block-seq-to-list seq)
        seen)]))

(define (opt-loop-rotation-has-backedge-candidate?
  [blocks : CompilerIrBlockList]) : bool
  (opt-loop-rotation-has-backedge-candidate-from? blocks (OptLabelNil)))

(define (opt-loop-rotation-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (if (or
    (opt-ssa-blocks-have-phi? blocks)
    (not (opt-loop-rotation-has-backedge-candidate? blocks)))
    blocks
    (opt-loop-rotation-blocks-fixed
      blocks
      (+ 1 (compiler-ir-block-list-count blocks)))))

(define (opt-loop-rotation-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret-ty frame blocks)
      (IrFunction name params ret-ty frame (opt-loop-rotation-blocks blocks))]))

;; --- conservative loop-invariant code motion (#1801) ------------------------
;;
;; LICM is verifier-gated. It moves non-trapping scalar `BinOp`/`UnOp`
;; definitions from natural loops with a single safe preheader. Memory LICM adds
;; a conservative load slice: invariant address GEPs and plain loads may move
;; only when the whole loop has no alias-fact-clearing memory/call/unknown
;; effect. A candidate's value operands must be defined outside the loop or by
;; an earlier instruction already selected for the same hoist. Stores, calls,
;; allocations, bounds checks, phis, vector memory ops, and trapping arithmetic
;; are left in place.
(defenum OptLicmInstrsResult
  (OptLicmInstrsResult CompilerIrInstrList CompilerIrInstrList I64I64Map bool))

(defenum OptLicmBlocksResult
  (OptLicmBlocksResult CompilerIrBlockList CompilerIrInstrList I64I64Map bool))

(define (opt-licm-body-map-capacity [body-blocks : CompilerIrBlockList]) : i64
  (+ 1 (compiler-ir-block-list-instruction-count body-blocks)))

(define (opt-licm-collect-defs-instrs
  [instrs : CompilerIrInstrList]
  [set : I64I64Map]) : I64I64Map
  (match instrs
    [(IrInstrNil) set]
    [(IrInstrCons instr rest)
      (match (opt-instr-def-var instr)
        [(OptSomeI64 var)
          (opt-licm-collect-defs-instrs (box-get rest) (opt-used-add set var))]
        [(OptNoI64) (opt-licm-collect-defs-instrs (box-get rest) set)])]))

(define (opt-licm-collect-defs-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [set : I64I64Map]) : I64I64Map
  (if (>= index (compiler-ir-instr-seq-count instrs))
    set
    (match (opt-instr-def-var (compiler-ir-instr-seq-ref instrs index))
      [(OptSomeI64 var)
        (opt-licm-collect-defs-instr-seq-from
          instrs
          (+ index 1)
          (opt-used-add set var))]
      [(OptNoI64) (opt-licm-collect-defs-instr-seq-from instrs (+ index 1) set)])))

(define (opt-licm-collect-defs-instr-seq
  [instrs : CompilerIrInstrSeq]
  [set : I64I64Map]) : I64I64Map
  (opt-licm-collect-defs-instr-seq-from instrs 0 set))

(define (opt-licm-collect-defs-blocks
  [blocks : CompilerIrBlockList]
  [set : I64I64Map]) : I64I64Map
  (match blocks
    [(IrBlockNil) set]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-licm-collect-defs-blocks
            (box-get rest)
            (opt-licm-collect-defs-instr-seq instrs set))])]
    [(IrBlockArray seq)
      (opt-licm-collect-defs-blocks (compiler-ir-block-seq-to-list seq) set)]))

(define (opt-licm-value-invariant?
  [loop-defs : I64I64Map]
  [hoisted : I64I64Map]
  [value : CompilerIrValue]) : bool
  (match value
    [(IrValueVar var)
      (or
        (not (opt-used-contains loop-defs var))
        (opt-used-contains hoisted var))]
    ;; A global operand is a hidden load of mutable state (the backend reads it
    ;; rip-relative at the use site), so it is NOT loop-invariant: a store or
    ;; call inside the loop can change it between iterations. Only literals are
    ;; unconditionally invariant.
    [(IrValueGlobal _) false]
    [_ true]))

(define (opt-licm-values-invariant?
  [loop-defs : I64I64Map]
  [hoisted : I64I64Map]
  [a : CompilerIrValue]
  [b : CompilerIrValue]) : bool
  (and
    (opt-licm-value-invariant? loop-defs hoisted a)
    (opt-licm-value-invariant? loop-defs hoisted b)))

(define (opt-licm-memory-blocker-instr? [instr : CompilerIrInstr]) : bool
  (opt-alias-instr-clears-all? instr))

(define (opt-licm-memory-safe-instr-seq-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (if (opt-licm-memory-blocker-instr?
      (compiler-ir-instr-seq-ref instrs index))
      false
      (opt-licm-memory-safe-instr-seq-from? instrs (+ index 1)))))

(define (opt-licm-memory-safe-instr-seq? [instrs : CompilerIrInstrSeq]) : bool
  (opt-licm-memory-safe-instr-seq-from? instrs 0))

(define (opt-licm-memory-safe-blocks? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(IrBlockNil) true]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (and
            (opt-licm-memory-safe-instr-seq? instrs)
            (opt-licm-memory-safe-blocks? (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-licm-memory-safe-blocks? (compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-candidate?
  [loop-defs : I64I64Map]
  [hoisted : I64I64Map]
  [sources : I64I64Map]
  [memory-safe? : bool]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrBinOp _ op lhs rhs _)
      (and
        (not (opt-binop-traps? op))
        (opt-licm-values-invariant? loop-defs hoisted lhs rhs))]
    [(IrInstrUnOp _ _ src _) (opt-licm-value-invariant? loop-defs hoisted src)]
    [(IrInstrGep dst base offset _)
      (and
        memory-safe?
        (opt-gvn-stable-var? sources dst)
        (opt-licm-values-invariant? loop-defs hoisted base offset))]
    [(IrInstrLoad dst src _)
      (and
        memory-safe?
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources src)
        (opt-licm-value-invariant? loop-defs hoisted src))]
    [_ false]))

(define (opt-licm-add-hoisted-def
  [hoisted : I64I64Map]
  [instr : CompilerIrInstr]) : I64I64Map
  (match (opt-instr-def-var instr)
    [(OptSomeI64 var) (opt-used-add hoisted var)]
    [(OptNoI64) hoisted]))

(define (opt-licm-filter-instrs
  [loop-defs : I64I64Map]
  [instrs : CompilerIrInstrList]
  [sources : I64I64Map]
  [memory-safe? : bool]
  [hoisted : I64I64Map]) : OptLicmInstrsResult
  (match instrs
    [(IrInstrNil) (OptLicmInstrsResult (IrInstrNil) (IrInstrNil) hoisted false)]
    [(IrInstrCons instr rest)
      (if (opt-licm-candidate? loop-defs hoisted sources memory-safe? instr)
        (match (opt-licm-filter-instrs
          loop-defs
          (box-get rest)
          sources
          memory-safe?
          (opt-licm-add-hoisted-def hoisted instr))
          [(OptLicmInstrsResult kept moved next-hoisted _)
            (OptLicmInstrsResult
              kept
              (compiler-ir-instr-cons instr moved)
              next-hoisted
              true)])
        (match (opt-licm-filter-instrs
          loop-defs
          (box-get rest)
          sources
          memory-safe?
          hoisted)
          [(OptLicmInstrsResult kept moved next-hoisted changed)
            (OptLicmInstrsResult
              (compiler-ir-instr-cons instr kept)
              moved
              next-hoisted
              changed)]))]))

(define (opt-licm-filter-instr-seq-from
  [loop-defs : I64I64Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [sources : I64I64Map]
  [memory-safe? : bool]
  [hoisted : I64I64Map]) : OptLicmInstrsResult
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptLicmInstrsResult (IrInstrNil) (IrInstrNil) hoisted false)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (if (opt-licm-candidate? loop-defs hoisted sources memory-safe? instr)
        (match (opt-licm-filter-instr-seq-from
          loop-defs
          instrs
          (+ index 1)
          sources
          memory-safe?
          (opt-licm-add-hoisted-def hoisted instr))
          [(OptLicmInstrsResult kept moved next-hoisted _)
            (OptLicmInstrsResult
              kept
              (compiler-ir-instr-cons instr moved)
              next-hoisted
              true)])
        (match (opt-licm-filter-instr-seq-from
          loop-defs
          instrs
          (+ index 1)
          sources
          memory-safe?
          hoisted)
          [(OptLicmInstrsResult kept moved next-hoisted changed)
            (OptLicmInstrsResult
              (compiler-ir-instr-cons instr kept)
              moved
              next-hoisted
              changed)])))))

(define (opt-licm-filter-instr-seq
  [loop-defs : I64I64Map]
  [instrs : CompilerIrInstrSeq]
  [sources : I64I64Map]
  [memory-safe? : bool]
  [hoisted : I64I64Map]) : OptLicmInstrsResult
  (opt-licm-filter-instr-seq-from
    loop-defs
    instrs
    0
    sources
    memory-safe?
    hoisted))

(define (opt-licm-filter-body-blocks
  [loop-defs : I64I64Map]
  [blocks : CompilerIrBlockList]
  [sources : I64I64Map]
  [memory-safe? : bool]
  [hoisted : I64I64Map]) : OptLicmBlocksResult
  (match blocks
    [(IrBlockNil) (OptLicmBlocksResult (IrBlockNil) (IrInstrNil) hoisted false)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (match (opt-licm-filter-instr-seq
            loop-defs
            instrs
            sources
            memory-safe?
            hoisted)
            [(OptLicmInstrsResult kept moved next-hoisted block-changed)
              (match (opt-licm-filter-body-blocks
                loop-defs
                (box-get rest)
                sources
                memory-safe?
                next-hoisted)
                [(OptLicmBlocksResult
                    rest-blocks
                    rest-moved
                    final-hoisted
                    rest-changed)
                  (OptLicmBlocksResult
                    (compiler-ir-block-cons
                      (compiler-ir-block label kept)
                      rest-blocks)
                    (opt-aggregate-instr-list-append moved rest-moved)
                    final-hoisted
                    (or block-changed rest-changed))])])])]
    [(IrBlockArray seq)
      (opt-licm-filter-body-blocks
        loop-defs
        (compiler-ir-block-seq-to-list seq)
        sources
        memory-safe?
        hoisted)]))

(define (opt-licm-replace-body-blocks
  [blocks : CompilerIrBlockList]
  [body-blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match body-blocks
    [(IrBlockNil) blocks]
    [(IrBlockCons replacement replacement-rest)
      (match blocks
        [(IrBlockNil) (IrBlockNil)]
        [(IrBlockCons block rest)
          (match block
            [(IrBlock label _)
              (match replacement
                [(IrBlock replacement-label _)
                  (if (string-eq label replacement-label)
                    (compiler-ir-block-cons
                      replacement
                      (opt-licm-replace-body-blocks
                        (box-get rest)
                        (box-get replacement-rest)))
                    (compiler-ir-block-cons
                      block
                      (opt-licm-replace-body-blocks (box-get rest) body-blocks)))])])]
        [(IrBlockArray seq)
          (opt-licm-replace-body-blocks
            (compiler-ir-block-seq-to-list seq)
            body-blocks)])]
    [(IrBlockArray seq)
      (opt-licm-replace-body-blocks blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-insert-before-terminator
  [hoisted : CompilerIrInstrList]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match hoisted
    [(IrInstrNil) instrs]
    [_
      (match instrs
        [(IrInstrNil) hoisted]
        [(IrInstrCons instr rest)
          (if (opt-cfg-terminator-instr? instr)
            (opt-aggregate-instr-list-append hoisted instrs)
            (compiler-ir-instr-cons
              instr
              (opt-licm-insert-before-terminator hoisted (box-get rest))))])]))

(define (opt-licm-insert-before-terminator-seq-from
  [hoisted : CompilerIrInstrList]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (match hoisted
    [(IrInstrNil) (opt-aggregate-instr-seq-append-from instrs index IrInstrNil)]
    [_
      (if (>= index (compiler-ir-instr-seq-count instrs))
        hoisted
        (let
          [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
          (if (opt-cfg-terminator-instr? instr)
            (opt-aggregate-instr-list-append
              hoisted
              (opt-aggregate-instr-seq-append-from instrs index IrInstrNil))
            (compiler-ir-instr-cons
              instr
              (opt-licm-insert-before-terminator-seq-from
                hoisted
                instrs
                (+ index 1))))))]))

(define (opt-licm-insert-before-terminator-seq
  [hoisted : CompilerIrInstrList]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-licm-insert-before-terminator-seq-from hoisted instrs 0))

(define (opt-licm-insert-preheader-blocks
  [preheader : String]
  [hoisted : CompilerIrInstrList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (compiler-ir-block-cons
            (if (string-eq label preheader)
              (compiler-ir-block
                label
                (opt-licm-insert-before-terminator-seq hoisted instrs))
              block)
            (opt-licm-insert-preheader-blocks preheader hoisted (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-licm-insert-preheader-blocks
        preheader
        hoisted
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-apply-loop
  [index : OptCfgIndex]
  [sources : I64I64Map]
  [blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]) : CompilerIrBlockList
  (match (opt-natural-loop-preheader loop)
    [(OptSomeLoopPreheader preheader)
      (let
        [body-blocks : CompilerIrBlockList
          (opt-natural-loop-current-body-blocks index loop blocks)]
        [map-capacity : i64 (opt-licm-body-map-capacity body-blocks)]
        [loop-defs : I64I64Map
          (opt-licm-collect-defs-blocks
            body-blocks
            (i64-i64-map-with-capacity map-capacity))]
        [memory-safe? : bool (opt-licm-memory-safe-blocks? body-blocks)]
        (match (opt-licm-filter-body-blocks
          loop-defs
          body-blocks
          sources
          memory-safe?
          (i64-i64-map-with-capacity map-capacity))
          [(OptLicmBlocksResult filtered-body hoisted _ changed)
            (if changed
              (opt-licm-insert-preheader-blocks
                preheader
                hoisted
                (opt-licm-replace-body-blocks blocks filtered-body))
              blocks)]))]
    [(OptNoLoopPreheader) blocks]))

(define (opt-licm-apply-loops
  [index : OptCfgIndex]
  [sources : I64I64Map]
  [loops : OptNaturalLoopList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match loops
    [(OptNaturalLoopNil) blocks]
    [(OptNaturalLoopCons loop rest)
      (opt-licm-apply-loops
        index
        sources
        (box-get rest)
        (opt-licm-apply-loop index sources blocks loop))]))

(define (opt-licm-blocks-with-context
  [context : OptCfgContext]
  [sources : I64I64Map]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-licm-apply-loops
    (struct-get context index)
    sources
    (opt-cfg-natural-loops-with-context blocks context)
    blocks))

(define (opt-licm-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-licm-blocks-with-context
    (opt-cfg-context-build blocks)
    (opt-gvn-sources-blocks blocks (i64-i64-map-with-capacity 64))
    blocks))

(define (opt-licm-function-with-context-result
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-function-with-context func context)
    [(OkCompilerOptimizeVerify)
      (match func
        [(IrFunction name params ret-ty frame blocks)
          (let
            [sources : I64I64Map
              (opt-gvn-sources-blocks
                blocks
                (opt-gvn-sources-params params (i64-i64-map-with-capacity 64)))]
            [hoisted-blocks : CompilerIrBlockList
              (opt-licm-blocks-with-context context sources blocks)]
            [hoisted : CompilerIrFunction
              (IrFunction name params ret-ty frame hoisted-blocks)]
            ;; LICM may hoist into a synthesized preheader edge, so build one
            ;; fresh context for the rewritten CFG, reuse it for the post-pass
            ;; verify, and hand it back for the next pass.
            [hoisted-context : OptCfgContext
              (opt-cfg-context-build hoisted-blocks)]
            (match (opt-verify-function-with-context hoisted hoisted-context)
              [(OkCompilerOptimizeVerify)
                (OptFunctionCtxResult hoisted hoisted-context)]
              [(ErrCompilerOptimizeVerify _)
                (OptFunctionCtxResult func context)]))])]
    [(ErrCompilerOptimizeVerify _) (OptFunctionCtxResult func context)]))

(define (opt-licm-function-with-context
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-licm-function-with-context-result context func)
    [(OptFunctionCtxResult next _) next]))

(define (opt-licm-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction _ _ _ _ blocks)
      (opt-licm-function-with-context (opt-cfg-context-build blocks) func)]))

;; --- simple induction-derived cleanup (#1802) ------------------------------
;;
;; This first induction slice recognizes canonical `i64` loop-carried phis:
;; `i = phi(preheader_seed, latch_next)` where `latch_next` is `i +/- const`.
;; It then strength-reduces one repeated derived offset/address family per loop
;; by adding a matching derived phi. The pass deliberately rejects loops with
;; stores, calls, allocation, or unknown-effect instructions and leaves bounds
;; checks in place. The function verifier gates the final rewritten function.
(defenum OptInductionPhiInputs
  (OptNoInductionPhiInputs)
  (OptSomeInductionPhiInputs CompilerIrValue i64))

(defenum OptInductionFact
  (OptInductionFact i64 CompilerIrValue i64 i64 AstType))

(defenum OptMaybeInductionFact
  (OptNoInductionFact)
  (OptSomeInductionFact OptInductionFact))

(defenum OptInductionDerived
  (OptInductionDerivedMul i64 AstType)
  (OptInductionDerivedGep CompilerIrValue AstType))

(defenum OptInductionLoopCandidate
  (OptNoInductionLoopCandidate)
  (OptSomeInductionLoopCandidate OptInductionFact OptInductionDerived))

(defenum OptInductionApplyResult
  (OptInductionApplyResult CompilerIrBlockList i64 bool))

(define (opt-induction-fact-start [fact : OptInductionFact]) : CompilerIrValue
  (match fact
    [(OptInductionFact _ start _ _ _) start]))

(define (opt-induction-fact-step [fact : OptInductionFact]) : i64
  (match fact
    [(OptInductionFact _ _ _ step _) step]))

(define (opt-induction-i64-type? [ty : AstType]) : bool
  (match ty
    [(AstTyI64) true]
    [_ false]))

(define (opt-induction-nonzero-step [step : i64]) : OptMaybeI64
  (if (= step 0)
    (OptNoI64)
    (OptSomeI64 step)))

(define (opt-induction-phi-input-pair
  [a-value : CompilerIrValue]
  [a-label : String]
  [b-value : CompilerIrValue]
  [b-label : String]
  [preheader : String]
  [latch : String]) : OptInductionPhiInputs
  (if (and (string-eq a-label preheader) (string-eq b-label latch))
    (match b-value
      [(IrValueVar back) (OptSomeInductionPhiInputs a-value back)]
      [_ (OptNoInductionPhiInputs)])
    (if (and (string-eq b-label preheader) (string-eq a-label latch))
      (match a-value
        [(IrValueVar back) (OptSomeInductionPhiInputs b-value back)]
        [_ (OptNoInductionPhiInputs)])
      (OptNoInductionPhiInputs))))

(define (opt-induction-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [preheader : String]
  [latch : String]) : OptInductionPhiInputs
  (match inputs
    [(IrPhiInputCons a-value a-label rest)
      (match (box-get rest)
        [(IrPhiInputCons b-value b-label rest2)
          (match (box-get rest2)
            [(IrPhiInputNil)
              (opt-induction-phi-input-pair
                a-value
                a-label
                b-value
                b-label
                preheader
                latch)]
            [_ (OptNoInductionPhiInputs)])]
        [_ (OptNoInductionPhiInputs)])]
    [_ (OptNoInductionPhiInputs)]))

(define (opt-induction-step-from-add
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : OptMaybeI64
  (match lhs
    [(IrValueVar var)
      (if (= var phi-var)
        (match rhs
          [(IrValueI64 step) (opt-induction-nonzero-step step)]
          [_ (OptNoI64)])
        (OptNoI64))]
    [(IrValueI64 step)
      (match rhs
        [(IrValueVar var)
          (if (= var phi-var)
            (opt-induction-nonzero-step step)
            (OptNoI64))]
        [_ (OptNoI64)])]
    [_ (OptNoI64)]))

(define (opt-induction-step-from-sub
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : OptMaybeI64
  (match lhs
    [(IrValueVar var)
      (if (= var phi-var)
        (match rhs
          [(IrValueI64 step) (opt-induction-nonzero-step (- 0 step))]
          [_ (OptNoI64)])
        (OptNoI64))]
    [_ (OptNoI64)]))

(define (opt-induction-step-from-binop
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]) : OptMaybeI64
  (match op
    [(IrBinAdd) (opt-induction-step-from-add lhs rhs phi-var)]
    [(IrBinSub) (opt-induction-step-from-sub lhs rhs phi-var)]
    [_ (OptNoI64)]))

(define (opt-induction-update-step-instr
  [instr : CompilerIrInstr]
  [phi-var : i64]
  [next-var : i64]
  [ty : AstType]) : OptMaybeI64
  (match instr
    [(IrInstrBinOp dst op lhs rhs instr-ty)
      (if (and
        (= dst next-var)
        (opt-type-eq instr-ty ty)
        (opt-induction-i64-type? ty))
        (opt-induction-step-from-binop op lhs rhs phi-var)
        (OptNoI64))]
    [_ (OptNoI64)]))

(define (opt-induction-find-update-instrs
  [instrs : CompilerIrInstrList]
  [phi-var : i64]
  [next-var : i64]
  [ty : AstType]) : OptMaybeI64
  (match instrs
    [(IrInstrNil) (OptNoI64)]
    [(IrInstrCons instr rest)
      (match (opt-instr-def-var instr)
        [(OptSomeI64 dst)
          (if (= dst next-var)
            (opt-induction-update-step-instr instr phi-var next-var ty)
            (opt-induction-find-update-instrs
              (box-get rest)
              phi-var
              next-var
              ty))]
        [(OptNoI64)
          (opt-induction-find-update-instrs (box-get rest) phi-var next-var ty)])]))

(define (opt-induction-find-update-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [phi-var : i64]
  [next-var : i64]
  [ty : AstType]) : OptMaybeI64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptNoI64)
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(OptSomeI64 dst)
          (if (= dst next-var)
            (opt-induction-update-step-instr instr phi-var next-var ty)
            (opt-induction-find-update-instr-seq-from
              instrs
              (+ index 1)
              phi-var
              next-var
              ty))]
        [(OptNoI64)
          (opt-induction-find-update-instr-seq-from
            instrs
            (+ index 1)
            phi-var
            next-var
            ty)]))))

(define (opt-induction-find-update-instr-seq
  [instrs : CompilerIrInstrSeq]
  [phi-var : i64]
  [next-var : i64]
  [ty : AstType]) : OptMaybeI64
  (opt-induction-find-update-instr-seq-from instrs 0 phi-var next-var ty))

(define (opt-induction-find-update-blocks
  [body-blocks : CompilerIrBlockList]
  [phi-var : i64]
  [next-var : i64]
  [ty : AstType]) : OptMaybeI64
  (match body-blocks
    [(IrBlockNil) (OptNoI64)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (match (opt-induction-find-update-instr-seq
            instrs
            phi-var
            next-var
            ty)
            [(OptSomeI64 step) (OptSomeI64 step)]
            [(OptNoI64)
              (opt-induction-find-update-blocks
                (box-get rest)
                phi-var
                next-var
                ty)])])]
    [(IrBlockArray seq)
      (opt-induction-find-update-blocks
        (compiler-ir-block-seq-to-list seq)
        phi-var
        next-var
        ty)]))

(define (opt-induction-fact-from-phi
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : String]
  [instr : CompilerIrInstr]) : OptMaybeInductionFact
  (match instr
    [(IrInstrPhi phi-var inputs ty)
      (if (opt-induction-i64-type? ty)
        (match (opt-induction-phi-inputs
          inputs
          preheader
          (opt-natural-loop-latch loop))
          [(OptSomeInductionPhiInputs start next-var)
            (match (opt-induction-find-update-blocks
              body-blocks
              phi-var
              next-var
              ty)
              [(OptSomeI64 step)
                (OptSomeInductionFact
                  (OptInductionFact phi-var start next-var step ty))]
              [(OptNoI64) (OptNoInductionFact)])]
          [(OptNoInductionPhiInputs) (OptNoInductionFact)])
        (OptNoInductionFact))]
    [_ (OptNoInductionFact)]))

(define (opt-induction-find-fact-instrs
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : String]
  [instrs : CompilerIrInstrList]) : OptMaybeInductionFact
  (match instrs
    [(IrInstrNil) (OptNoInductionFact)]
    [(IrInstrCons instr rest)
      (match (opt-induction-fact-from-phi body-blocks loop preheader instr)
        [(OptSomeInductionFact fact) (OptSomeInductionFact fact)]
        [(OptNoInductionFact)
          (opt-induction-find-fact-instrs
            body-blocks
            loop
            preheader
            (box-get rest))])]))

(define (opt-induction-find-fact-instr-seq-from
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : String]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptMaybeInductionFact
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptNoInductionFact)
    (match (opt-induction-fact-from-phi
      body-blocks
      loop
      preheader
      (compiler-ir-instr-seq-ref instrs index))
      [(OptSomeInductionFact fact) (OptSomeInductionFact fact)]
      [(OptNoInductionFact)
        (opt-induction-find-fact-instr-seq-from
          body-blocks
          loop
          preheader
          instrs
          (+ index 1))])))

(define (opt-induction-find-fact-instr-seq
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : String]
  [instrs : CompilerIrInstrSeq]) : OptMaybeInductionFact
  (opt-induction-find-fact-instr-seq-from body-blocks loop preheader instrs 0))

(define (opt-induction-find-fact
  [body-blocks : CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : String]) : OptMaybeInductionFact
  (match (opt-cfg-find-block body-blocks (opt-natural-loop-header loop))
    [(OptSomeBlock block)
      (match block
        [(IrBlock _ instrs)
          (opt-induction-find-fact-instr-seq body-blocks loop preheader instrs)])]
    [(OptNoBlock) (OptNoInductionFact)]))

(define (opt-induction-blocker-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrAlloc _ _) true]
    [(IrInstrStorePtr _ _ _) true]
    [(IrInstrCopyBytes _ _ _) true]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload _ _ _ _ _) true])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload _ _ _ _ _ _) true])]
    [(IrInstrCpuId _ _ _ _) true]
    [(IrInstrXgetbv _ _) true]
    [(IrInstrSyscall _ _) true]
    [(IrInstrCall _ _ _ _) true]
    [(IrInstrCallIndirect _ _ _ _) true]
    [(IrInstrCallIndirectC _ _ _ _) true]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload _ _ _ _) true])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload _ _ _ _) true])]
    [(IrInstrTailCall _ _ _) true]
    [(IrInstrStore _ _ _) true]
    [(IrInstrTailCallIndirect _ _ _) true]
    [_ false]))

(define (opt-induction-blocker-instrs? [instrs : CompilerIrInstrList]) : bool
  (match instrs
    [(IrInstrNil) false]
    [(IrInstrCons instr rest)
      (or
        (opt-induction-blocker-instr? instr)
        (opt-induction-blocker-instrs? (box-get rest)))]))

(define (opt-induction-blocker-instr-seq-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-induction-blocker-instr? (compiler-ir-instr-seq-ref instrs index))
      (opt-induction-blocker-instr-seq-from? instrs (+ index 1)))))

(define (opt-induction-blocker-instr-seq? [instrs : CompilerIrInstrSeq]) : bool
  (opt-induction-blocker-instr-seq-from? instrs 0))

(define (opt-induction-loop-blocked? [body-blocks : CompilerIrBlockList]) : bool
  (match body-blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-induction-blocker-instr-seq? instrs)
            true
            (opt-induction-loop-blocked? (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-induction-loop-blocked? (compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-small-const? [value : i64]) : bool
  (and (>= value (- 0 1000000)) (<= value 1000000)))

(define (opt-induction-scale-ok? [step : i64] [scale : i64]) : bool
  (and
    (not (= scale 0))
    (not (= scale 1))
    (opt-induction-small-const? step)
    (opt-induction-small-const? scale)))

(define (opt-induction-mul-scale
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [phi-var : i64]
  [step : i64]) : OptMaybeI64
  (match lhs
    [(IrValueVar var)
      (if (= var phi-var)
        (match rhs
          [(IrValueI64 scale)
            (if (opt-induction-scale-ok? step scale)
              (OptSomeI64 scale)
              (OptNoI64))]
          [_ (OptNoI64)])
        (OptNoI64))]
    [(IrValueI64 scale)
      (match rhs
        [(IrValueVar var)
          (if (and (= var phi-var) (opt-induction-scale-ok? step scale))
            (OptSomeI64 scale)
            (OptNoI64))]
        [_ (OptNoI64)])]
    [_ (OptNoI64)]))

;; Induction runs without a hoisted set, so GEP-base loop-invariance is
;; `opt-licm-value-invariant?` with an empty `hoisted` map: a var is invariant
;; iff it is not defined inside the loop body. Evaluating it directly avoids
;; allocating an empty sentinel map per GEP candidate (#2337).
(define (opt-induction-value-base-invariant?
  [loop-defs : I64I64Map]
  [value : CompilerIrValue]) : bool
  (match value
    [(IrValueVar var) (not (opt-used-contains loop-defs var))]
    [_ true]))

(define (opt-induction-find-derived-instr
  [fact : OptInductionFact]
  [loop-defs : I64I64Map]
  [instr : CompilerIrInstr]) : OptInductionLoopCandidate
  (match fact
    [(OptInductionFact phi-var _ _ step _)
      (match instr
        [(IrInstrBinOp _ op lhs rhs ty)
          (match op
            [(IrBinMul)
              (if (opt-induction-i64-type? ty)
                (match (opt-induction-mul-scale lhs rhs phi-var step)
                  [(OptSomeI64 scale)
                    (OptSomeInductionLoopCandidate
                      fact
                      (OptInductionDerivedMul scale ty))]
                  [(OptNoI64) (OptNoInductionLoopCandidate)])
                (OptNoInductionLoopCandidate))]
            [_ (OptNoInductionLoopCandidate)])]
        [(IrInstrGep _ base offset ty)
          (match offset
            [(IrValueVar offset-var)
              (if (and
                (= offset-var phi-var)
                (opt-induction-value-base-invariant? loop-defs base))
                (OptSomeInductionLoopCandidate
                  fact
                  (OptInductionDerivedGep base ty))
                (OptNoInductionLoopCandidate))]
            [_ (OptNoInductionLoopCandidate)])]
        [_ (OptNoInductionLoopCandidate)])]))

(define (opt-induction-find-derived-instrs
  [fact : OptInductionFact]
  [loop-defs : I64I64Map]
  [instrs : CompilerIrInstrList]) : OptInductionLoopCandidate
  (match instrs
    [(IrInstrNil) (OptNoInductionLoopCandidate)]
    [(IrInstrCons instr rest)
      (match (opt-induction-find-derived-instr fact loop-defs instr)
        [(OptSomeInductionLoopCandidate found-fact kind)
          (OptSomeInductionLoopCandidate found-fact kind)]
        [(OptNoInductionLoopCandidate)
          (opt-induction-find-derived-instrs fact loop-defs (box-get rest))])]))

(define (opt-induction-find-derived-instr-seq-from
  [fact : OptInductionFact]
  [loop-defs : I64I64Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptInductionLoopCandidate
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptNoInductionLoopCandidate)
    (match (opt-induction-find-derived-instr
      fact
      loop-defs
      (compiler-ir-instr-seq-ref instrs index))
      [(OptSomeInductionLoopCandidate found-fact kind)
        (OptSomeInductionLoopCandidate found-fact kind)]
      [(OptNoInductionLoopCandidate)
        (opt-induction-find-derived-instr-seq-from
          fact
          loop-defs
          instrs
          (+ index 1))])))

(define (opt-induction-find-derived-instr-seq
  [fact : OptInductionFact]
  [loop-defs : I64I64Map]
  [instrs : CompilerIrInstrSeq]) : OptInductionLoopCandidate
  (opt-induction-find-derived-instr-seq-from fact loop-defs instrs 0))

(define (opt-induction-find-derived-blocks
  [fact : OptInductionFact]
  [loop-defs : I64I64Map]
  [body-blocks : CompilerIrBlockList]) : OptInductionLoopCandidate
  (match body-blocks
    [(IrBlockNil) (OptNoInductionLoopCandidate)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (match (opt-induction-find-derived-instr-seq fact loop-defs instrs)
            [(OptSomeInductionLoopCandidate found-fact kind)
              (OptSomeInductionLoopCandidate found-fact kind)]
            [(OptNoInductionLoopCandidate)
              (opt-induction-find-derived-blocks fact loop-defs (box-get rest))])])]
    [(IrBlockArray seq)
      (opt-induction-find-derived-blocks
        fact
        loop-defs
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-derived-type [derived : OptInductionDerived]) : AstType
  (match derived
    [(OptInductionDerivedMul _ ty) ty]
    [(OptInductionDerivedGep _ ty) ty]))

(define (opt-induction-derived-matches?
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [instr : CompilerIrInstr]) : bool
  (match fact
    [(OptInductionFact phi-var _ _ step _)
      (match derived
        [(OptInductionDerivedMul scale ty)
          (match instr
            [(IrInstrBinOp _ op lhs rhs instr-ty)
              (match op
                [(IrBinMul)
                  (and
                    (opt-type-eq instr-ty ty)
                    (match (opt-induction-mul-scale lhs rhs phi-var step)
                      [(OptSomeI64 found-scale) (= found-scale scale)]
                      [(OptNoI64) false]))]
                [_ false])]
            [_ false])]
        [(OptInductionDerivedGep base ty)
          (match instr
            [(IrInstrGep _ instr-base offset instr-ty)
              (and
                (opt-type-eq instr-ty ty)
                (opt-value-eq instr-base base)
                (match offset
                  [(IrValueVar offset-var) (= offset-var phi-var)]
                  [_ false]))]
            [_ false])])]))

(define (opt-induction-rewrite-instr
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (if (opt-induction-derived-matches? fact derived instr)
    (match (opt-instr-def-var instr)
      [(OptSomeI64 dst)
        (IrInstrMov
          dst
          (IrValueVar derived-phi)
          (opt-induction-derived-type derived))]
      [(OptNoI64) instr])
    instr))

(define (opt-induction-rewrite-instrs
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (compiler-ir-instr-cons
        (opt-induction-rewrite-instr fact derived derived-phi instr)
        (opt-induction-rewrite-instrs fact derived derived-phi (box-get rest)))]))

(define (opt-induction-rewrite-instr-seq-from
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    IrInstrNil
    (compiler-ir-instr-cons
      (opt-induction-rewrite-instr
        fact
        derived
        derived-phi
        (compiler-ir-instr-seq-ref instrs index))
      (opt-induction-rewrite-instr-seq-from
        fact
        derived
        derived-phi
        instrs
        (+ index 1)))))

(define (opt-induction-rewrite-instr-seq
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-induction-rewrite-instr-seq-from fact derived derived-phi instrs 0))

(define (opt-induction-rewrite-blocks
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (compiler-ir-block-cons
            (if (opt-loop-body-label-member? body index label)
              (compiler-ir-block
                label
                (opt-induction-rewrite-instr-seq
                  fact
                  derived
                  derived-phi
                  instrs))
              block)
            (opt-induction-rewrite-blocks
              body
              index
              fact
              derived
              derived-phi
              (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-induction-rewrite-blocks
        body
        index
        fact
        derived
        derived-phi
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-seed-instr
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [seed-var : i64]) : CompilerIrInstr
  (match derived
    [(OptInductionDerivedMul scale ty)
      (IrInstrBinOp
        seed-var
        (IrBinMul)
        (opt-induction-fact-start fact)
        (IrValueI64 scale)
        ty)]
    [(OptInductionDerivedGep base ty)
      (IrInstrGep seed-var base (opt-induction-fact-start fact) ty)]))

(define (opt-induction-next-instr
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [next-var : i64]) : CompilerIrInstr
  (match derived
    [(OptInductionDerivedMul scale ty)
      (IrInstrBinOp
        next-var
        (IrBinAdd)
        (IrValueVar derived-phi)
        (IrValueI64 (* (opt-induction-fact-step fact) scale))
        ty)]
    [(OptInductionDerivedGep _ ty)
      (IrInstrGep
        next-var
        (IrValueVar derived-phi)
        (IrValueI64 (opt-induction-fact-step fact))
        ty)]))

(define (opt-induction-phi-instr
  [derived : OptInductionDerived]
  [preheader : String]
  [latch : String]
  [seed-var : i64]
  [derived-phi : i64]
  [next-var : i64]) : CompilerIrInstr
  (IrInstrPhi
    derived-phi
    (compiler-ir-phi-input-cons
      (IrValueVar seed-var)
      preheader
      (compiler-ir-phi-input-cons (IrValueVar next-var) latch (IrPhiInputNil)))
    (opt-induction-derived-type derived)))

(define (opt-induction-insert-support-blocks
  [header : String]
  [preheader : String]
  [latch : String]
  [seed-instr : CompilerIrInstr]
  [phi-instr : CompilerIrInstr]
  [next-instr : CompilerIrInstr]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (let
            [list-instrs : CompilerIrInstrList
              (opt-aggregate-instr-seq-append-from instrs 0 IrInstrNil)]
            [with-phi : CompilerIrInstrList
              (if (string-eq label header)
                (compiler-ir-instr-cons phi-instr list-instrs)
                list-instrs)]
            [with-seed : CompilerIrInstrList
              (if (string-eq label preheader)
                (opt-licm-insert-before-terminator
                  (compiler-ir-instr-cons seed-instr IrInstrNil)
                  with-phi)
                with-phi)]
            [with-next : CompilerIrInstrList
              (if (string-eq label latch)
                (opt-licm-insert-before-terminator
                  (compiler-ir-instr-cons next-instr IrInstrNil)
                  with-seed)
                with-seed)]
            (compiler-ir-block-cons
              (compiler-ir-block label with-next)
              (opt-induction-insert-support-blocks
                header
                preheader
                latch
                seed-instr
                phi-instr
                next-instr
                (box-get rest))))])]
    [(IrBlockArray seq)
      (opt-induction-insert-support-blocks
        header
        preheader
        latch
        seed-instr
        phi-instr
        next-instr
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-apply-loop
  [index : OptCfgIndex]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptInductionApplyResult
  (match (opt-natural-loop-preheader loop)
    [(OptSomeLoopPreheader preheader)
      (let
        [body : OptLoopBody (opt-natural-loop-body-info loop)]
        [body-blocks : CompilerIrBlockList
          (opt-natural-loop-current-body-blocks index loop blocks)]
        (if (opt-induction-loop-blocked? body-blocks)
          (OptInductionApplyResult blocks frame false)
          (match (opt-induction-find-fact body-blocks loop preheader)
            [(OptSomeInductionFact fact)
              (let
                [loop-defs : I64I64Map
                  (opt-licm-collect-defs-blocks
                    body-blocks
                    (i64-i64-map-with-capacity
                      (opt-licm-body-map-capacity body-blocks)))]
                (match (opt-induction-find-derived-blocks
                  fact
                  loop-defs
                  body-blocks)
                  [(OptSomeInductionLoopCandidate _ derived)
                    (let
                      [seed-var : i64 frame]
                      [derived-phi : i64 (+ frame 1)]
                      [next-var : i64 (+ frame 2)]
                      [rewritten : CompilerIrBlockList
                        (opt-induction-rewrite-blocks
                          body
                          index
                          fact
                          derived
                          derived-phi
                          blocks)]
                      [seed-instr : CompilerIrInstr
                        (opt-induction-seed-instr fact derived seed-var)]
                      [phi-instr : CompilerIrInstr
                        (opt-induction-phi-instr
                          derived
                          preheader
                          (opt-natural-loop-latch loop)
                          seed-var
                          derived-phi
                          next-var)]
                      [next-instr : CompilerIrInstr
                        (opt-induction-next-instr
                          fact
                          derived
                          derived-phi
                          next-var)]
                      (OptInductionApplyResult
                        (opt-induction-insert-support-blocks
                          (opt-natural-loop-header loop)
                          preheader
                          (opt-natural-loop-latch loop)
                          seed-instr
                          phi-instr
                          next-instr
                          rewritten)
                        (+ frame 3)
                        true))]
                  [(OptNoInductionLoopCandidate)
                    (OptInductionApplyResult blocks frame false)]))]
            [(OptNoInductionFact) (OptInductionApplyResult blocks frame false)])))]
    [(OptNoLoopPreheader) (OptInductionApplyResult blocks frame false)]))

(define (opt-induction-apply-loops
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [blocks : CompilerIrBlockList]
  [frame : i64]
  [changed : bool]) : OptInductionApplyResult
  (match loops
    [(OptNaturalLoopNil) (OptInductionApplyResult blocks frame changed)]
    [(OptNaturalLoopCons loop rest)
      (match (opt-induction-apply-loop index blocks frame loop)
        [(OptInductionApplyResult next-blocks next-frame loop-changed)
          (opt-induction-apply-loops
            index
            (box-get rest)
            next-blocks
            next-frame
            (or changed loop-changed))])]))

(define (opt-induction-function-with-context-result
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-function-with-context func context)
    [(OkCompilerOptimizeVerify)
      (match func
        [(IrFunction name params ret-ty frame blocks)
          (match (opt-induction-apply-loops
            (struct-get context index)
            (opt-cfg-natural-loops-with-context blocks context)
            blocks
            frame
            false)
            [(OptInductionApplyResult next-blocks next-frame changed)
              (if changed
                (let
                  [next : CompilerIrFunction
                    (IrFunction name params ret-ty next-frame next-blocks)]
                  ;; Induction cleanup can rewrite latch/exit edges, so build one
                  ;; fresh context for the rewritten CFG, reuse it for the
                  ;; post-pass verify, and hand it back for the next pass.
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(OkCompilerOptimizeVerify)
                      (OptFunctionCtxResult next next-context)]
                    [(ErrCompilerOptimizeVerify _)
                      (OptFunctionCtxResult func context)]))
                (OptFunctionCtxResult func context))])])]
    [(ErrCompilerOptimizeVerify _) (OptFunctionCtxResult func context)]))

(define (opt-induction-function-with-context
  [context : OptCfgContext]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match (opt-induction-function-with-context-result context func)
    [(OptFunctionCtxResult next _) next]))

(define (opt-induction-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction _ _ _ _ blocks)
      (opt-induction-function-with-context (opt-cfg-context-build blocks) func)]))

(define (opt-cfg-filter-phi-inputs
  [reachable : OptLabelSet]
  [inputs : CompilerIrPhiInputList]) : CompilerIrPhiInputList
  (match inputs
    [(IrPhiInputNil) (IrPhiInputNil)]
    [(IrPhiInputCons value label rest)
      (if (opt-label-contains reachable label)
        (compiler-ir-phi-input-cons
          value
          label
          (opt-cfg-filter-phi-inputs reachable (box-get rest)))
        (opt-cfg-filter-phi-inputs reachable (box-get rest)))]))

(define (opt-phi-input-count [inputs : CompilerIrPhiInputList]) : i64
  (match inputs
    [(IrPhiInputNil) 0]
    [(IrPhiInputCons _ _ rest) (+ 1 (opt-phi-input-count (box-get rest)))]))

(define (opt-phi-single-value [inputs : CompilerIrPhiInputList]) : CompilerIrMaybeValue
  (match inputs
    [(IrPhiInputCons value _ rest)
      (match (box-get rest)
        [(IrPhiInputNil) (IrSomeValue value)]
        [_ (IrNoValue)])]
    [_ (IrNoValue)]))

(define (opt-cfg-clean-instr
  [reachable : OptLabelSet]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrPhi dst inputs ty)
      (let
        [kept : CompilerIrPhiInputList
          (opt-cfg-filter-phi-inputs reachable inputs)]
        (if (= (opt-phi-input-count kept) 1)
          (match (opt-phi-single-value kept)
            [(IrSomeValue value)
              (if (opt-value-is-var? value dst)
                (IrInstrPhi dst kept ty)
                (IrInstrMov dst value ty))]
            [(IrNoValue) (IrInstrPhi dst kept ty)])
          (IrInstrPhi dst kept ty)))]
    [_ instr]))

(define (opt-cfg-clean-instr-seq
  [reachable : OptLabelSet]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [index : i64 (- (struct-get instrs len) 1)]
    [out : CompilerIrInstrList IrInstrNil]
    (begin
      (while (>= index 0)
        (begin
          (set!
            out
            (compiler-ir-instr-cons
              (opt-cfg-clean-instr reachable (array-ref slots index))
              out))
          (set! index (- index 1))))
      out)))

(define (opt-cfg-clean-block
  [reachable : OptLabelSet]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-cfg-clean-instr-seq reachable instrs))]))

(define (opt-cfg-filter-clean-blocks
  [reachable : OptLabelSet]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (if (opt-label-contains reachable label)
            (compiler-ir-block-cons
              (opt-cfg-clean-block reachable block)
              (opt-cfg-filter-clean-blocks reachable (box-get rest)))
            (opt-cfg-filter-clean-blocks reachable (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-cfg-filter-clean-blocks
        reachable
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-simplify-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [folded : CompilerIrBlockList (opt-cfg-fold-branches-blocks blocks)]
    [reachable : OptLabelSet (opt-cfg-reachable-blocks folded)]
    (opt-cfg-filter-clean-blocks reachable folded)))

(define (opt-cfg-simplify-blocks-with-context-result
  [input : OptBlockCtxResult]) : OptBlockCtxResult
  (match input
    [(OptBlockCtxResult blocks context context-valid)
      (if (and
        context-valid
        (not (opt-cfg-blocks-have-foldable-branch? blocks))
        (opt-cfg-context-all-blocks-reachable? context))
        (OptBlockCtxResult
          (opt-cfg-filter-clean-blocks (struct-get context reachable) blocks)
          context
          true)
        (let
          [simplified : CompilerIrBlockList (opt-cfg-simplify-blocks blocks)]
          (OptBlockCtxResult simplified (opt-cfg-context-build simplified) true)))]))

;; --- sparse conditional constant propagation (#1348) -----------------------
;;
;; SCCP v1 runs after the local scalar simplifier. It keeps a small scalar
;; lattice for SSA vars and CFG-id-backed executable block flags. Unknown values
;; are not rewritten; overdefined values keep the original instruction; proven
;; constants rewrite value uses and scalar-producing instructions. The evaluator
;; deliberately reuses the local folding helpers above so divide/modulo/shift
;; trap preservation stays identical.
(defenum OptSccpValue
  (OptSccpUnknown)
  (OptSccpConst CompilerIrValue AstType)
  (OptSccpOverdefined))

;; #2357 (orig #2386 2951f920): the SCCP lattice was a persistent assoc list
;; (OptSccpEnvCons id value rest) where opt-sccp-env-set rebuilt the WHOLE list on
;; every bind (via opt-sccp-env-remove) -> O(V) alloc per bind, O(V^2) per analysis
;; sweep, x fixpoint sweeps x all functions (~42s / ~12GB of the -O2 optimize
;; phase). The lattice is a single monotonically-rising map threaded linearly
;; through analysis (never branched), so it is now a mutable array indexed by var
;; id: O(1) lookup/set, no rebuild. Var ids are dense within a function; the array
;; is sized to cover every bound var (params + every instruction dst that
;; opt-sccp-process-instr binds). Out-of-range lookups return Unknown (the same
;; default the list gave for an unbound var), so the analysis result -- and the
;; folded output -- is byte-identical.
(defenum OptSccpEnv
  (OptSccpEnv i64 (Array OptSccpValue)))

(define (opt-sccp-env-fill-unknown!
  [slots : (Array OptSccpValue)]
  [n : i64]
  [i : i64]) : unit
  (if (>= i n)
    unit
    (begin
      (array-set! slots i (OptSccpUnknown))
      (opt-sccp-env-fill-unknown! slots n (+ i 1)))))

(define (opt-sccp-env-make [cap : i64]) : OptSccpEnv
  (let
    [n : i64
      (if (< cap 1)
        1
        cap)]
    [slots : (Array OptSccpValue) (make-array OptSccpValue n)]
    (begin
      (opt-sccp-env-fill-unknown! slots n 0)
      (OptSccpEnv n slots))))

;; Destination var bound by `opt-sccp-process-instr`, or -1 for instructions that
;; bind nothing. MUST mirror the binding arms of opt-sccp-process-instr so the
;; environment array is sized to cover every var the analysis can bind.
(define (opt-sccp-instr-dst [instr : CompilerIrInstr]) : i64
  (match instr
    [(IrInstrMov dst _ _) dst]
    [(IrInstrCast dst _ _ _) dst]
    [(IrInstrBitcast dst _ _ _) dst]
    [(IrInstrBinOp dst _ _ _ _) dst]
    [(IrInstrUnOp dst _ _ _) dst]
    [(IrInstrPhi dst _ _) dst]
    [(IrInstrAlloc dst _) dst]
    [(IrInstrAddrOf dst _) dst]
    [(IrInstrGep dst _ _ _) dst]
    [(IrInstrLoad dst _ _) dst]
    [(IrInstrEntryArgc dst) dst]
    [(IrInstrEntryArgv dst) dst]
    [(IrInstrEntryEnvp dst) dst]
    [(IrInstrCpuId dst _ _ _) dst]
    [(IrInstrXgetbv dst _) dst]
    [(IrInstrSyscall dst _) dst]
    [(IrInstrLaneId dst _ _) dst]
    [(IrInstrSplat dst _ _ _) dst]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _) dst])]
    [(IrInstrVectorReduce dst _ _ _ _) dst]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _) dst])]
    [(IrInstrMaskBinOp dst _ _ _ _) dst]
    [(IrInstrMaskNot dst _ _) dst]
    [(IrInstrMaskReduce dst _ _ _) dst]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _) dst])]
    [(IrInstrVectorLoad dst _ _ _ _) dst]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _) dst])]
    [(IrInstrTailMask dst _ _ _) dst]
    [(IrInstrCall dst _ _ _) dst]
    [(IrInstrCallIndirect dst _ _ _) dst]
    [(IrInstrCallIndirectC dst _ _ _) dst]
    ;; Pack/Word dsts must be counted so opt-sccp-env-make sizes the lattice
    ;; array over them; opt-sccp-env-set silently drops out-of-range writes,
    ;; which would defeat the Overdefined binding in opt-sccp-process-instr.
    [(IrInstrPack dst _ _) dst]
    [(IrInstrWord dst _ _ _) dst]
    [_ (- 0 1)]))

(define (opt-sccp-max-var-instr-seq
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    acc
    (let
      [dst : i64 (opt-sccp-instr-dst (compiler-ir-instr-seq-ref instrs index))]
      (opt-sccp-max-var-instr-seq
        instrs
        (+ index 1)
        (if (> dst acc)
          dst
          acc)))))

(define (opt-sccp-max-var-blocks [blocks : CompilerIrBlockList] [acc : i64]) : i64
  (match blocks
    [(IrBlockNil) acc]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-sccp-max-var-blocks
            (box-get rest)
            (opt-sccp-max-var-instr-seq instrs 0 acc))])]
    [(IrBlockArray seq)
      (opt-sccp-max-var-blocks (compiler-ir-block-seq-to-list seq) acc)]))

(define (opt-sccp-max-var-params [params : CompilerIrParamList] [acc : i64]) : i64
  (match params
    [(IrParamNil) acc]
    [(IrParamCons param rest)
      (match param
        [(IrParam _ _ id)
          (opt-sccp-max-var-params
            (box-get rest)
            (if (> id acc)
              id
              acc))])]))

(defenum OptSccpState
  (OptSccpState OptCfgIndex (Array bool) OptSccpEnv bool))

(define (opt-sccp-value-eq [a : OptSccpValue] [b : OptSccpValue]) : bool
  (match a
    [(OptSccpUnknown)
      (match b
        [(OptSccpUnknown) true]
        [_ false])]
    [(OptSccpOverdefined)
      (match b
        [(OptSccpOverdefined) true]
        [_ false])]
    [(OptSccpConst av aty)
      (match b
        [(OptSccpConst bv bty) (and (opt-value-eq av bv) (opt-type-eq aty bty))]
        [_ false])]))

(define (opt-sccp-join [old : OptSccpValue] [new : OptSccpValue]) : OptSccpValue
  (match old
    [(OptSccpUnknown) new]
    [(OptSccpOverdefined) (OptSccpOverdefined)]
    [(OptSccpConst old-value old-ty)
      (match new
        [(OptSccpUnknown) old]
        [(OptSccpOverdefined) (OptSccpOverdefined)]
        [(OptSccpConst new-value new-ty)
          (if (and
            (opt-value-eq old-value new-value)
            (opt-type-eq old-ty new-ty))
            old
            (OptSccpOverdefined))])]))

(define (opt-sccp-env-lookup [env : OptSccpEnv] [var : i64]) : OptSccpValue
  (match env
    [(OptSccpEnv cap slots)
      (if (if (>= var 0)
        (< var cap)
        false)
        (array-ref slots var)
        (OptSccpUnknown))]))

;; Mutates the shared lattice array in place and returns the same env. The
;; environment is threaded linearly through the monotone analysis, so in-place
;; update is observationally identical to the old persistent cons/remove.
(define (opt-sccp-env-set [env : OptSccpEnv] [var : i64] [value : OptSccpValue]) : OptSccpEnv
  (match env
    [(OptSccpEnv cap slots)
      (begin
        (if (if (>= var 0)
          (< var cap)
          false)
          (array-set! slots var value)
          unit)
        env)]))

(define (opt-sccp-state-bind
  [state : OptSccpState]
  [var : i64]
  [value : OptSccpValue]) : OptSccpState
  (match state
    [(OptSccpState cfg-index executable env changed)
      (let
        [old : OptSccpValue (opt-sccp-env-lookup env var)]
        [merged : OptSccpValue (opt-sccp-join old value)]
        (if (opt-sccp-value-eq old merged)
          state
          (OptSccpState
            cfg-index
            executable
            (opt-sccp-env-set env var merged)
            true)))]))

(define (opt-sccp-state-mark-executable [state : OptSccpState] [label : String]) : OptSccpState
  (match state
    [(OptSccpState cfg-index executable env changed)
      (match (opt-cfg-index-id cfg-index label)
        [(OptSomeI64 id)
          (if (and (>= id 0) (< id (array-length executable)))
            (if (array-ref executable id)
              state
              (begin
                (array-set! executable id true)
                (OptSccpState cfg-index executable env true)))
            state)]
        [(OptNoI64) state])]))

(define (opt-sccp-state-reset-changed [state : OptSccpState]) : OptSccpState
  (match state
    [(OptSccpState cfg-index executable env _)
      (OptSccpState cfg-index executable env false)]))

(define (opt-sccp-immediate [value : CompilerIrValue] [ty : AstType]) : OptSccpValue
  (match (opt-normalize-const value (opt-default-immediate-type value ty))
    [(OptSomeConst folded folded-ty) (OptSccpConst folded folded-ty)]
    [(OptNoConst) (OptSccpOverdefined)]))

(define (opt-sccp-value
  [state : OptSccpState]
  [value : CompilerIrValue]
  [ty : AstType]) : OptSccpValue
  (match state
    [(OptSccpState _ _ env _)
      (match value
        [(IrValueVar id) (opt-sccp-env-lookup env id)]
        [_ (opt-sccp-immediate value ty)])]))

(define (opt-sccp-fold-cast-value
  [src : OptSccpValue]
  [from-ty : AstType]
  [to-ty : AstType]) : OptSccpValue
  (match src
    [(OptSccpUnknown) (OptSccpUnknown)]
    [(OptSccpOverdefined) (OptSccpOverdefined)]
    [(OptSccpConst value ty)
      (match (opt-fold-cast (OptSomeConst value ty) from-ty to-ty)
        [(IrSomeValue folded) (OptSccpConst folded to-ty)]
        [(IrNoValue) (OptSccpOverdefined)])]))

(define (opt-sccp-fold-binop-value
  [op : CompilerIrBinOp]
  [lhs : OptSccpValue]
  [rhs : OptSccpValue]
  [ty : AstType]) : OptSccpValue
  (match lhs
    [(OptSccpConst lhs-value lhs-ty)
      (match rhs
        [(OptSccpConst rhs-value rhs-ty)
          (match (opt-fold-binop
            op
            (OptSomeConst lhs-value lhs-ty)
            (OptSomeConst rhs-value rhs-ty)
            ty)
            [(IrSomeValue folded) (OptSccpConst folded ty)]
            [(IrNoValue) (OptSccpOverdefined)])]
        [(OptSccpUnknown) (OptSccpUnknown)]
        [(OptSccpOverdefined) (OptSccpOverdefined)])]
    [(OptSccpUnknown) (OptSccpUnknown)]
    [(OptSccpOverdefined) (OptSccpOverdefined)]))

(define (opt-sccp-fold-unop-value
  [op : CompilerIrUnOp]
  [src : OptSccpValue]
  [ty : AstType]) : OptSccpValue
  (match src
    [(OptSccpConst value value-ty)
      (match (opt-fold-unop op (OptSomeConst value value-ty) ty)
        [(IrSomeValue folded) (OptSccpConst folded ty)]
        [(IrNoValue) (OptSccpOverdefined)])]
    [(OptSccpUnknown) (OptSccpUnknown)]
    [(OptSccpOverdefined) (OptSccpOverdefined)]))

(define (opt-sccp-phi-input-value
  [state : OptSccpState]
  [value : CompilerIrValue]
  [pred : String]
  [ty : AstType]) : OptSccpValue
  (match state
    [(OptSccpState cfg-index executable _ _)
      (match (opt-cfg-index-id cfg-index pred)
        [(OptSomeI64 pred-id)
          (if (and
            (>= pred-id 0)
            (< pred-id (array-length executable))
            (array-ref executable pred-id))
            (opt-sccp-value state value ty)
            (OptSccpUnknown))]
        [(OptNoI64) (OptSccpUnknown)])]))

(define (opt-sccp-phi-value
  [state : OptSccpState]
  [inputs : CompilerIrPhiInputList]
  [ty : AstType]) : OptSccpValue
  (match inputs
    [(IrPhiInputNil) (OptSccpUnknown)]
    [(IrPhiInputCons value pred rest)
      (opt-sccp-join
        (opt-sccp-phi-input-value state value pred ty)
        (opt-sccp-phi-value state (box-get rest) ty))]))

(define (opt-sccp-mark-branch-targets
  [state : OptSccpState]
  [cond : CompilerIrValue]
  [true-label : String]
  [false-label : String]) : OptSccpState
  (match (opt-sccp-value state cond (AstTyBool))
    [(OptSccpConst value _)
      (match value
        [(IrValueBool known)
          (if known
            (opt-sccp-state-mark-executable state true-label)
            (opt-sccp-state-mark-executable state false-label))]
        [_
          (opt-sccp-state-mark-executable
            (opt-sccp-state-mark-executable state true-label)
            false-label)])]
    [(OptSccpOverdefined)
      (opt-sccp-state-mark-executable
        (opt-sccp-state-mark-executable state true-label)
        false-label)]
    [(OptSccpUnknown) state]))

(define (opt-sccp-process-instr
  [state : OptSccpState]
  [instr : CompilerIrInstr]) : OptSccpState
  (match instr
    [(IrInstrMov dst value ty)
      (opt-sccp-state-bind state dst (opt-sccp-value state value ty))]
    [(IrInstrCast dst src from-ty to-ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-fold-cast-value
          (opt-sccp-value state src from-ty)
          from-ty
          to-ty))]
    [(IrInstrBitcast dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrBinOp dst op lhs rhs ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-fold-binop-value
          op
          (opt-sccp-value state lhs ty)
          (opt-sccp-value state rhs ty)
          ty))]
    [(IrInstrUnOp dst op value ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-fold-unop-value op (opt-sccp-value state value ty) ty))]
    [(IrInstrPhi dst inputs ty)
      (opt-sccp-state-bind state dst (opt-sccp-phi-value state inputs ty))]
    [(IrInstrJump label) (opt-sccp-state-mark-executable state label)]
    [(IrInstrBranch cond true-label false-label)
      (opt-sccp-mark-branch-targets state cond true-label false-label)]
    [(IrInstrAlloc dst _) (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrAddrOf dst _) (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrGep dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrLoad dst _ _) (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrEntryArgc dst)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrEntryArgv dst)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrEntryEnvp dst)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrCpuId dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrXgetbv dst _) (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrSyscall dst _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrLaneId dst _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrSplat dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpOverdefined))])]
    [(IrInstrVectorReduce dst _ _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpOverdefined))])]
    [(IrInstrMaskBinOp dst _ _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrMaskNot dst _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrMaskReduce dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpOverdefined))])]
    [(IrInstrVectorLoad dst _ _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (opt-sccp-state-bind state dst (OptSccpOverdefined))])]
    [(IrInstrTailMask dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrCall dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrCallIndirect dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrCallIndirectC dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    ;; #2386 register-group dsts: bind Overdefined like loads/calls. Falling
    ;; into the wildcard left them OptSccpUnknown forever, so a branch on a
    ;; Word-extracted enum tag marked NO successor executable and SCCP folded
    ;; match arms away at -O2 (stale-constant miscompile).
    [(IrInstrPack dst _ _) (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [(IrInstrWord dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpOverdefined))]
    [_ state]))

(define (opt-sccp-process-instrs
  [state : OptSccpState]
  [instrs : CompilerIrInstrList]) : OptSccpState
  (match instrs
    [(IrInstrNil) state]
    [(IrInstrCons instr rest)
      (opt-sccp-process-instrs
        (opt-sccp-process-instr state instr)
        (box-get rest))]))

(define (opt-sccp-process-instr-seq-from
  [state : OptSccpState]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptSccpState
  (if (>= index (compiler-ir-instr-seq-count instrs))
    state
    (opt-sccp-process-instr-seq-from
      (opt-sccp-process-instr state (compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1))))

(define (opt-sccp-process-instr-seq
  [state : OptSccpState]
  [instrs : CompilerIrInstrSeq]) : OptSccpState
  (opt-sccp-process-instr-seq-from state instrs 0))

(define (opt-sccp-process-block
  [state : OptSccpState]
  [block : CompilerIrBlock]
  [block-id : i64]) : OptSccpState
  (match state
    [(OptSccpState _ executable _ _)
      (match block
        [(IrBlock _ instrs)
          (if (and
            (>= block-id 0)
            (< block-id (array-length executable))
            (array-ref executable block-id))
            (opt-sccp-process-instr-seq state instrs)
            state)])]))

(define (opt-sccp-process-blocks-from
  [state : OptSccpState]
  [blocks : CompilerIrBlockList]
  [block-id : i64]) : OptSccpState
  (match blocks
    [(IrBlockNil) state]
    [(IrBlockCons block rest)
      (opt-sccp-process-blocks-from
        (opt-sccp-process-block state block block-id)
        (box-get rest)
        (+ block-id 1))]
    [(IrBlockArray seq)
      (opt-sccp-process-blocks-from
        state
        (compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-sccp-env-from-params
  [params : CompilerIrParamList]
  [env : OptSccpEnv]) : OptSccpEnv
  (match params
    [(IrParamNil) env]
    [(IrParamCons param rest)
      (match param
        [(IrParam _ _ id)
          (opt-sccp-env-from-params
            (box-get rest)
            (opt-sccp-env-set env id (OptSccpOverdefined)))])]))

(define (opt-sccp-initial-state
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptSccpState
  (let
    [max-var : i64
      (opt-sccp-max-var-params params (opt-sccp-max-var-blocks blocks (- 0 1)))]
    [executable-count : i64
      (opt-cfg-index-block-count (struct-get context index))]
    [executable-flags : (Array bool) (make-array bool executable-count)]
    [_clear-executable : unit
      (opt-cfg-fill-bool! executable-flags executable-count false)]
    [_entry : unit
      (match (opt-cfg-index-id
        (struct-get context index)
        (struct-get context entry-label))
        [(OptSomeI64 entry-id)
          (if (and (>= entry-id 0) (< entry-id executable-count))
            (array-set! executable-flags entry-id true)
            unit)]
        [(OptNoI64) unit])]
    (OptSccpState
      (struct-get context index)
      executable-flags
      (opt-sccp-env-from-params params (opt-sccp-env-make (+ max-var 1)))
      true)))

(define (opt-sccp-analyze-fixed
  [blocks : CompilerIrBlockList]
  [state : OptSccpState]
  [remaining : i64]) : OptSccpState
  (if (<= remaining 0)
    state
    (let
      [next : OptSccpState
        (opt-sccp-process-blocks-from
          (opt-sccp-state-reset-changed state)
          blocks
          0)]
      (match next
        [(OptSccpState _ _ _ changed)
          (if changed
            (opt-sccp-analyze-fixed blocks next (- remaining 1))
            next)]))))

(define (opt-sccp-analyze
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptSccpState
  (opt-sccp-analyze-fixed
    blocks
    (opt-sccp-initial-state context params blocks)
    (+
      (+ (compiler-ir-block-list-count blocks) 8)
      (* 2 (compiler-ir-block-list-instruction-count blocks)))))

(define (opt-sccp-rewrite-value [env : OptSccpEnv] [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(IrValueVar id)
      (match (opt-sccp-env-lookup env id)
        [(OptSccpConst folded _) folded]
        [_ value])]
    [_ value]))

(define (opt-sccp-instr-changes-successors?
  [env : OptSccpEnv]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrBranch cond _ _)
      (match (opt-sccp-rewrite-value env cond)
        [(IrValueBool _) true]
        [_ false])]
    [_ false]))

(define (opt-sccp-instr-seq-changes-successors?
  [env : OptSccpEnv]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-sccp-instr-changes-successors?
      env
      (compiler-ir-instr-seq-ref instrs index))
      true
      (opt-sccp-instr-seq-changes-successors? env instrs (+ index 1)))))

(define (opt-sccp-block-changes-successors?
  [env : OptSccpEnv]
  [block : CompilerIrBlock]) : bool
  (match block
    [(IrBlock _ instrs) (opt-sccp-instr-seq-changes-successors? env instrs 0)]))

(define (opt-sccp-blocks-change-successors?
  [env : OptSccpEnv]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (if (opt-sccp-block-changes-successors? env block)
        true
        (opt-sccp-blocks-change-successors? env (box-get rest)))]
    [(IrBlockArray seq)
      (opt-sccp-blocks-change-successors?
        env
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-sccp-rewrite-maybe-value
  [env : OptSccpEnv]
  [value : CompilerIrMaybeValue]) : CompilerIrMaybeValue
  (match value
    [(IrNoValue) (IrNoValue)]
    [(IrSomeValue inner) (IrSomeValue (opt-sccp-rewrite-value env inner))]))

(define (opt-sccp-rewrite-value-list
  [env : OptSccpEnv]
  [values : CompilerIrValueList]) : CompilerIrValueList
  (match values
    [(IrValueNil) (IrValueNil)]
    [(IrValueCons value rest)
      (compiler-ir-value-cons
        (opt-sccp-rewrite-value env value)
        (opt-sccp-rewrite-value-list env (box-get rest)))]))

(define (opt-sccp-rewrite-call-args-array
  [env : OptSccpEnv]
  [src : (Array CompilerIrValue)]
  [dst : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (array-set! dst index (opt-sccp-rewrite-value env (array-ref src index)))
      (opt-sccp-rewrite-call-args-array env src dst (+ index 1)))))

(define (opt-sccp-rewrite-call-args
  [env : OptSccpEnv]
  [args : CompilerIrCallArgs]) : CompilerIrCallArgs
  (match args
    [(IrCallArgsNil) (IrCallArgsNil)]
    [(IrCallArgsOne value) (IrCallArgsOne (opt-sccp-rewrite-value env value))]
    [(IrCallArgsTwo a b)
      (IrCallArgsTwo
        (opt-sccp-rewrite-value env a)
        (opt-sccp-rewrite-value env b))]
    [(IrCallArgsArray values)
      (let
        [out : (Array CompilerIrValue)
          (make-array CompilerIrValue (array-length values))]
        (begin
          (opt-sccp-rewrite-call-args-array env values out 0)
          (IrCallArgsArray out)))]))

(define (opt-sccp-rewrite-phi-inputs
  [env : OptSccpEnv]
  [inputs : CompilerIrPhiInputList]) : CompilerIrPhiInputList
  (match inputs
    [(IrPhiInputNil) (IrPhiInputNil)]
    [(IrPhiInputCons value label rest)
      (compiler-ir-phi-input-cons
        (opt-sccp-rewrite-value env value)
        label
        (opt-sccp-rewrite-phi-inputs env (box-get rest)))]))

(define (opt-sccp-rewrite-scalar-def
  [env : OptSccpEnv]
  [dst : i64]
  [ty : AstType]
  [fallback : CompilerIrInstr]) : CompilerIrInstr
  (match (opt-sccp-env-lookup env dst)
    [(OptSccpConst value _) (IrInstrMov dst value ty)]
    [_ fallback]))

(define (opt-sccp-rewrite-instr [env : OptSccpEnv] [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrMov dst value ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (IrInstrMov dst (opt-sccp-rewrite-value env value) ty))]
    [(IrInstrGep dst base offset ty)
      (IrInstrGep
        dst
        (opt-sccp-rewrite-value env base)
        (opt-sccp-rewrite-value env offset)
        ty)]
    [(IrInstrLoad dst src ty)
      (IrInstrLoad dst (opt-sccp-rewrite-value env src) ty)]
    [(IrInstrStorePtr ptr value ty)
      (IrInstrStorePtr
        (opt-sccp-rewrite-value env ptr)
        (opt-sccp-rewrite-value env value)
        ty)]
    [(IrInstrCopyBytes dst src size)
      (IrInstrCopyBytes
        (opt-sccp-rewrite-value env dst)
        (opt-sccp-rewrite-value env src)
        size)]
    [(IrInstrCast dst src from-ty to-ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        to-ty
        (IrInstrCast dst (opt-sccp-rewrite-value env src) from-ty to-ty))]
    [(IrInstrBitcast dst src from-ty to-ty)
      (IrInstrBitcast dst (opt-sccp-rewrite-value env src) from-ty to-ty)]
    [(IrInstrBinOp dst op lhs rhs ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (IrInstrBinOp
          dst
          op
          (opt-sccp-rewrite-value env lhs)
          (opt-sccp-rewrite-value env rhs)
          ty))]
    [(IrInstrUnOp dst op value ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (IrInstrUnOp dst op (opt-sccp-rewrite-value env value) ty))]
    [(IrInstrSplat dst value lanes ty)
      (IrInstrSplat dst (opt-sccp-rewrite-value env value) lanes ty)]
    [(IrInstrCall dst name args ty)
      (IrInstrCall dst name (opt-sccp-rewrite-call-args env args) ty)]
    [(IrInstrCallIndirect dst callee args ty)
      (IrInstrCallIndirect
        dst
        (opt-sccp-rewrite-value env callee)
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(IrInstrCallIndirectC dst callee args ty)
      (IrInstrCallIndirectC
        dst
        (opt-sccp-rewrite-value env callee)
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base name args slots)
          (ir-instr-call-cabi-store-result
            (opt-sccp-rewrite-value env base)
            name
            (opt-sccp-rewrite-call-args env args)
            slots)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload
            base
            callee
            args
            slots)
          (ir-instr-call-indirect-cabi-store-result
            (opt-sccp-rewrite-value env base)
            (opt-sccp-rewrite-value env callee)
            (opt-sccp-rewrite-call-args env args)
            slots)])]
    [(IrInstrTailCall name args ty)
      (IrInstrTailCall name (opt-sccp-rewrite-call-args env args) ty)]
    [(IrInstrStore name value ty)
      (IrInstrStore name (opt-sccp-rewrite-value env value) ty)]
    [(IrInstrBoundsCheck index length ok-label)
      (IrInstrBoundsCheck
        (opt-sccp-rewrite-value env index)
        (opt-sccp-rewrite-value env length)
        ok-label)]
    [(IrInstrEntryArgc _) instr]
    [(IrInstrEntryArgv _) instr]
    [(IrInstrEntryEnvp _) instr]
    [(IrInstrCpuId dst leaf subleaf reg-index)
      (IrInstrCpuId
        dst
        (opt-sccp-rewrite-value env leaf)
        (opt-sccp-rewrite-value env subleaf)
        reg-index)]
    [(IrInstrXgetbv dst index)
      (IrInstrXgetbv dst (opt-sccp-rewrite-value env index))]
    [(IrInstrSyscall dst args)
      (IrInstrSyscall dst (opt-sccp-rewrite-call-args env args))]
    [(IrInstrBranch cond true-label false-label)
      (let
        [rewritten-cond : CompilerIrValue (opt-sccp-rewrite-value env cond)]
        (match rewritten-cond
          [(IrValueBool known)
            (if known
              (IrInstrJump true-label)
              (IrInstrJump false-label))]
          [_ (IrInstrBranch rewritten-cond true-label false-label)]))]
    [(IrInstrReturn value)
      (IrInstrReturn (opt-sccp-rewrite-maybe-value env value))]
    [(IrInstrPhi dst inputs ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (IrInstrPhi dst (opt-sccp-rewrite-phi-inputs env inputs) ty))]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst op lhs rhs lanes ty)
          (ir-instr-vector-bin-op
            dst
            op
            (opt-sccp-rewrite-value env lhs)
            (opt-sccp-rewrite-value env rhs)
            lanes
            ty)])]
    [(IrInstrVectorReduce dst op src lanes ty)
      (IrInstrVectorReduce dst op (opt-sccp-rewrite-value env src) lanes ty)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst op lhs rhs lanes ty)
          (ir-instr-vector-compare
            dst
            op
            (opt-sccp-rewrite-value env lhs)
            (opt-sccp-rewrite-value env rhs)
            lanes
            ty)])]
    [(IrInstrMaskBinOp dst op lhs rhs lanes)
      (IrInstrMaskBinOp
        dst
        op
        (opt-sccp-rewrite-value env lhs)
        (opt-sccp-rewrite-value env rhs)
        lanes)]
    [(IrInstrMaskNot dst src lanes)
      (IrInstrMaskNot dst (opt-sccp-rewrite-value env src) lanes)]
    [(IrInstrMaskReduce dst op src lanes)
      (IrInstrMaskReduce dst op (opt-sccp-rewrite-value env src) lanes)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst mask true-value false-value lanes ty)
          (ir-instr-select
            dst
            (opt-sccp-rewrite-value env mask)
            (opt-sccp-rewrite-value env true-value)
            (opt-sccp-rewrite-value env false-value)
            lanes
            ty)])]
    [(IrInstrVectorLoad dst base index lanes ty)
      (IrInstrVectorLoad
        dst
        (opt-sccp-rewrite-value env base)
        (opt-sccp-rewrite-value env index)
        lanes
        ty)]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload base index value lanes ty)
          (ir-instr-vector-store
            (opt-sccp-rewrite-value env base)
            (opt-sccp-rewrite-value env index)
            (opt-sccp-rewrite-value env value)
            lanes
            ty)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload base index value mask lanes ty)
          (ir-instr-predicated-store
            (opt-sccp-rewrite-value env base)
            (opt-sccp-rewrite-value env index)
            (opt-sccp-rewrite-value env value)
            (opt-sccp-rewrite-value env mask)
            lanes
            ty)])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst base index mask lanes ty)
          (ir-instr-predicated-load
            dst
            (opt-sccp-rewrite-value env base)
            (opt-sccp-rewrite-value env index)
            (opt-sccp-rewrite-value env mask)
            lanes
            ty)])]
    [(IrInstrTailMask dst index length lanes)
      (IrInstrTailMask
        dst
        (opt-sccp-rewrite-value env index)
        (opt-sccp-rewrite-value env length)
        lanes)]
    [(IrInstrAlloc _ _) instr]
    [(IrInstrAddrOf _ _) instr]
    [(IrInstrLaneId _ _ _) instr]
    [(IrInstrJump _) instr]
    ;; #2386: register-group ops carry no SCCP-constant operands to fold.
    [(IrInstrPack _ _ _) instr]
    [(IrInstrWord _ _ _ _) instr]
    [(IrInstrTailCallIndirect callee args ty)
      (IrInstrTailCallIndirect
        (opt-sccp-rewrite-value env callee)
        (opt-sccp-rewrite-call-args env args)
        ty)]))

(define (opt-sccp-rewrite-instrs
  [env : OptSccpEnv]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (compiler-ir-instr-cons
        (opt-sccp-rewrite-instr env instr)
        (opt-sccp-rewrite-instrs env (box-get rest)))]))

(define (opt-sccp-rewrite-instr-seq-from
  [env : OptSccpEnv]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [out : CompilerIrInstrList]) : CompilerIrInstrList
  (if (< index 0)
    out
    (opt-sccp-rewrite-instr-seq-from
      env
      instrs
      (- index 1)
      (compiler-ir-instr-cons
        (opt-sccp-rewrite-instr env (compiler-ir-instr-seq-ref instrs index))
        out))))

(define (opt-sccp-rewrite-instr-seq
  [env : OptSccpEnv]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-sccp-rewrite-instr-seq-from
    env
    instrs
    (- (compiler-ir-instr-seq-count instrs) 1)
    IrInstrNil))

(define (opt-sccp-rewrite-block [env : OptSccpEnv] [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-sccp-rewrite-instr-seq env instrs))]))

(define (opt-sccp-rewrite-blocks
  [env : OptSccpEnv]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (opt-sccp-rewrite-block env block)
        (opt-sccp-rewrite-blocks env (box-get rest)))]
    [(IrBlockArray seq)
      (opt-sccp-rewrite-blocks env (compiler-ir-block-seq-to-list seq))]))

(define (opt-sccp-blocks
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (match (opt-sccp-analyze context params blocks)
      [(OptSccpState _ _ env _)
        (opt-cfg-simplify-blocks (opt-sccp-rewrite-blocks env blocks))])))

(define (opt-sccp-blocks-with-context-result
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : OptBlockCtxResult
  (match (opt-sccp-analyze context params blocks)
    [(OptSccpState _ _ env _)
      (opt-cfg-simplify-blocks-with-context-result
        (OptBlockCtxResult
          (opt-sccp-rewrite-blocks env blocks)
          context
          (not (opt-sccp-blocks-change-successors? env blocks))))]))

(defenum OptFunctionPassResult
  (OptFunctionPassResult CompilerIrFunction bool))

(define (optimize-function-max-iterations) : i64
  2)

;; --- cross-block global value numbering (#1349) -----------------------------
;;
;; Block-local CSE (`opt-cse-instr`) and copy propagation already collapse
;; redundant pure scalar expressions within a single basic block. This pass
;; lifts that to dominated blocks: a pure `BinOp`/`UnOp`, or an identical CPU
;; feature probe, is replaced by a `Mov` from an equal expression computed in a
;; strictly dominating block, after which the existing copy propagation/DCE
;; remove the dead intermediate. The IR is
;; non-SSA, so a value computed in a dominating block is only reusable at a use
;; if neither the result nor any operand can be reassigned between the two
;; points. The conservative-but-sound v1 condition is "exactly one value source"
;; per var: the value-source count = number of definitions plus one if the var
;; is a function parameter. A var with exactly one source has a single,
;; unchanging value throughout the function, so dominance alone authorizes the
;; reuse. Vars with two or more sources (a reassigned local, or a parameter that
;; is later overwritten) are excluded. Only `BinOp`/`UnOp` and CPU probes over
;; single-source operands and a single-source result are numbered; loads,
;; stores, allocations, calls, and other effectful or many-sourced instructions
;; are left untouched.
;; Phi inputs belong to predecessor edges and are never rewritten. Sibling
;; expressions never global-CSE because a join block is not strictly dominated by
;; either arm.
;; GVN value-source multiset: maps each def-site var id to how many times it is
;; defined (parameter seed + instruction destinations). A var is reusable across
;; dominance only when its count is exactly 1. Backed by I64I64Map for O(1)
;; membership; previously a linked list scanned O(n) per query inside the
;; per-instruction build and rewrite loops (O(n^2) per GVN pass).
;; The expression table itself is scoped by dominator-tree traversal: each block
;; rewrites against facts inherited from strict dominators, then pushes its own
;; original recordable expressions while visiting children and restores those
;; bucket heads on return. That makes the nearest dominating expression the
;; first same-key bucket entry, without a dominance scan during lookup.
(defenum OptGvnEntry
  (OptGvnEntry OptExprKey i64 i64))

(defenum OptGvnBucket
  (OptGvnBucketNil)
  (OptGvnBucketCons OptGvnEntry (Box OptGvnBucket)))

(defstruct OptGvnMap
  (buckets (Array OptGvnBucket)))

(defenum OptGvnScopeChange
  (OptGvnScopeChange i64 OptGvnBucket))

(defenum OptGvnScopeChanges
  (OptGvnScopeNil)
  (OptGvnScopeCons OptGvnScopeChange (Box OptGvnScopeChanges)))

(defenum OptGvnBlockResult
  (OptGvnNoBlock)
  (OptGvnSomeBlock CompilerIrBlock))

;; Number of times `var` appears as a definition site (instruction destination
;; or seeded parameter) in the collected value-source list.
(define (opt-gvn-count [sources : I64I64Map] [var : i64]) : i64
  (match (i64-i64-map-get sources var)
    [(I64I64MapFound n) n]
    [(I64I64MapMissing) 0]))

;; Record one more definition of `var` in the value-source multiset.
(define (opt-gvn-defs-add [sources : I64I64Map] [var : i64]) : I64I64Map
  (i64-i64-map-put sources var (+ 1 (opt-gvn-count sources var))))

;; A var is reusable across dominance only when it has exactly one value source.
(define (opt-gvn-stable-var? [sources : I64I64Map] [var : i64]) : bool
  (= (opt-gvn-count sources var) 1))

;; Operand values that hold a single unchanging value: literals and single-source
;; vars. Globals, global addresses, function references, and float/string
;; literals are excluded to match the existing copy-propagation conservatism.
(define (opt-gvn-value-stable? [sources : I64I64Map] [value : CompilerIrValue]) : bool
  (match value
    [(IrValueVar id) (opt-gvn-stable-var? sources id)]
    [(IrValueI64 _) true]
    [(IrValueBool _) true]
    [(IrValueChar _) true]
    [(IrValueUnit) true]
    [(IrValueF64 _) false]
    [(IrValueString _) false]
    [(IrValueBytes _) false]
    [(IrValueGlobal _) false]
    [(IrValueGlobalAddr _) false]
    [(IrValueFunction _) false]))

;; The destination var of a defining instruction, or -1 for instructions that do
;; not define a var. Mirrors the instruction set handled by `opt-cse-instr`.
(define (opt-gvn-instr-dst [instr : CompilerIrInstr]) : i64
  (match instr
    [(IrInstrMov dst _ _) dst]
    [(IrInstrAlloc dst _) dst]
    [(IrInstrAddrOf dst _) dst]
    [(IrInstrGep dst _ _ _) dst]
    [(IrInstrLoad dst _ _) dst]
    [(IrInstrCast dst _ _ _) dst]
    [(IrInstrBitcast dst _ _ _) dst]
    [(IrInstrBinOp dst _ _ _ _) dst]
    [(IrInstrUnOp dst _ _ _) dst]
    [(IrInstrLaneId dst _ _) dst]
    [(IrInstrSplat dst _ _ _) dst]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _) dst])]
    [(IrInstrVectorReduce dst _ _ _ _) dst]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _) dst])]
    [(IrInstrMaskBinOp dst _ _ _ _) dst]
    [(IrInstrMaskNot dst _ _) dst]
    [(IrInstrMaskReduce dst _ _ _) dst]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _) dst])]
    [(IrInstrVectorLoad dst _ _ _ _) dst]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _) dst])]
    [(IrInstrTailMask dst _ _ _) dst]
    [(IrInstrEntryArgc dst) dst]
    [(IrInstrEntryArgv dst) dst]
    [(IrInstrEntryEnvp dst) dst]
    [(IrInstrCpuId dst _ _ _) dst]
    [(IrInstrXgetbv dst _) dst]
    [(IrInstrSyscall dst _) dst]
    [(IrInstrCall dst _ _ _) dst]
    [(IrInstrCallIndirect dst _ _ _) dst]
    [(IrInstrCallIndirectC dst _ _ _) dst]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload _ _ _ _) (- 0 1)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload _ _ _ _) (- 0 1)])]
    [(IrInstrPhi dst _ _) dst]
    [(IrInstrStorePtr _ _ _) (- 0 1)]
    [(IrInstrCopyBytes _ _ _) (- 0 1)]
    [(IrInstrBoundsCheck _ _ _) (- 0 1)]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload _ _ _ _ _) (- 0 1)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload _ _ _ _ _ _) (- 0 1)])]
    [(IrInstrTailCall _ _ _) (- 0 1)]
    [(IrInstrStore _ _ _) (- 0 1)]
    [(IrInstrJump _) (- 0 1)]
    [(IrInstrBranch _ _ _) (- 0 1)]
    [(IrInstrReturn _) (- 0 1)]
    ;; #2386: register-group ops define their dst.
    [(IrInstrPack dst _ _) dst]
    [(IrInstrWord dst _ _ _) dst]
    [(IrInstrTailCallIndirect _ _ _) (- 0 1)]))

(define (opt-gvn-sources-params
  [params : CompilerIrParamList]
  [acc : I64I64Map]) : I64I64Map
  (match params
    [(IrParamNil) acc]
    [(IrParamCons param rest)
      (match param
        [(IrParam _ _ id)
          (opt-gvn-sources-params (box-get rest) (opt-gvn-defs-add acc id))])]))

(define (opt-gvn-sources-instrs
  [instrs : CompilerIrInstrList]
  [acc : I64I64Map]) : I64I64Map
  (match instrs
    [(IrInstrNil) acc]
    [(IrInstrCons instr rest)
      (let
        [dst : i64 (opt-gvn-instr-dst instr)]
        (opt-gvn-sources-instrs
          (box-get rest)
          (if (= dst (- 0 1))
            acc
            (opt-gvn-defs-add acc dst))))]))

(define (opt-gvn-sources-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [acc : I64I64Map]) : I64I64Map
  (if (>= index (compiler-ir-instr-seq-count instrs))
    acc
    (let
      [dst : i64 (opt-gvn-instr-dst (compiler-ir-instr-seq-ref instrs index))]
      (opt-gvn-sources-instr-seq-from
        instrs
        (+ index 1)
        (if (= dst (- 0 1))
          acc
          (opt-gvn-defs-add acc dst))))))

(define (opt-gvn-sources-blocks
  [blocks : CompilerIrBlockList]
  [acc : I64I64Map]) : I64I64Map
  (match blocks
    [(IrBlockNil) acc]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-gvn-sources-blocks
            (box-get rest)
            (opt-gvn-sources-instr-seq-from instrs 0 acc))])]
    [(IrBlockArray seq)
      (opt-gvn-sources-blocks (compiler-ir-block-seq-to-list seq) acc)]))

(define (opt-gvn-block-id [doms : OptDomInfo] [label : String]) : i64
  (match (opt-cfg-index-id (struct-get doms index) label)
    [(OptSomeI64 id) id]
    [(OptNoI64) (- 0 1)]))

(define (opt-gvn-recordable-instr?
  [instr : CompilerIrInstr]
  [sources : I64I64Map]) : bool
  (match instr
    [(IrInstrBinOp dst _ l r _)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources l)
        (opt-gvn-value-stable? sources r))]
    [(IrInstrUnOp dst _ v _)
      (and (opt-gvn-stable-var? sources dst) (opt-gvn-value-stable? sources v))]
    [(IrInstrCpuId dst leaf subleaf _)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources leaf)
        (opt-gvn-value-stable? sources subleaf))]
    [(IrInstrXgetbv dst index)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources index))]
    [_ false]))

(define (opt-gvn-record-count-instr-seq-from
  [sources : I64I64Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    0
    (+
      (if (opt-gvn-recordable-instr?
        (compiler-ir-instr-seq-ref instrs index)
        sources)
        1
        0)
      (opt-gvn-record-count-instr-seq-from sources instrs (+ index 1)))))

(define (opt-gvn-record-count-blocks
  [sources : I64I64Map]
  [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(IrBlockNil) 0]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (+
            (opt-gvn-record-count-instr-seq-from sources instrs 0)
            (opt-gvn-record-count-blocks sources (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-gvn-record-count-blocks sources (compiler-ir-block-seq-to-list seq))]))

(define (opt-gvn-bucket-capacity [count : i64]) : i64
  (opt-global-fact-bucket-capacity count))

(define (opt-gvn-buckets-fill-empty!
  [buckets : (Array OptGvnBucket)]
  [index : i64]) : unit
  (if (>= index (array-length buckets))
    unit
    (begin
      (array-set! buckets index (OptGvnBucketNil))
      (opt-gvn-buckets-fill-empty! buckets (+ index 1)))))

(define (opt-gvn-map-empty [record-count : i64]) : OptGvnMap
  (let
    [buckets : (Array OptGvnBucket)
      (make-array OptGvnBucket (opt-gvn-bucket-capacity record-count))]
    (begin
      (opt-gvn-buckets-fill-empty! buckets 0)
      (OptGvnMap buckets))))

(define (opt-gvn-bucket-index
  [buckets : (Array OptGvnBucket)]
  [key : OptExprKey]) : i64
  (bit-and (opt-expr-key-hash key) (- (array-length buckets) 1)))

(define (opt-gvn-table-push!
  [table : OptGvnMap]
  [entry : OptGvnEntry]
  [changes : OptGvnScopeChanges]) : OptGvnScopeChanges
  (match entry
    [(OptGvnEntry key _ _)
      (let
        [buckets : (Array OptGvnBucket) (struct-get table buckets)]
        [bucket : i64 (opt-gvn-bucket-index buckets key)]
        [old-head : OptGvnBucket (array-ref buckets bucket)]
        ;; #2357: under #1867 inline-by-value aggregates `array-ref` of a
        ;; memory-backed aggregate returns the element ADDRESS (in-place), not a
        ;; value snapshot the way main's old heap-handle GVN assumed. So the
        ;; scope-change MUST capture old-head's value BEFORE the array-set! below
        ;; overwrites the slot -- otherwise restore writes back the just-pushed
        ;; head and scoped dominance breaks (a dominated sibling reuses a value
        ;; that does not dominate it).
        [result : OptGvnScopeChanges
          (OptGvnScopeCons (OptGvnScopeChange bucket old-head) (box changes))]
        (begin
          (array-set! buckets bucket (OptGvnBucketCons entry (box old-head)))
          result))]))

(define (opt-gvn-table-insert! [table : OptGvnMap] [entry : OptGvnEntry]) : unit
  (begin
    (opt-gvn-table-push! table entry (OptGvnScopeNil))
    unit))

(define (opt-gvn-table-restore!
  [table : OptGvnMap]
  [changes : OptGvnScopeChanges]) : unit
  (match changes
    [(OptGvnScopeNil) unit]
    [(OptGvnScopeCons change rest)
      (match change
        [(OptGvnScopeChange bucket old-head)
          (let
            [buckets : (Array OptGvnBucket) (struct-get table buckets)]
            (begin
              (array-set! buckets bucket old-head)
              (opt-gvn-table-restore! table (box-get rest))))])]))

;; Record a `BinOp`/`UnOp`/CPU probe whose result and operands are all
;; single-source as an available value keyed by its expression and tagged with
;; its defining block.
(define (opt-gvn-record
  [instr : CompilerIrInstr]
  [def-block-id : i64]
  [sources : I64I64Map]
  [table : OptGvnMap]
  [changes : OptGvnScopeChanges]) : OptGvnScopeChanges
  (match instr
    [(IrInstrBinOp dst op l r ty)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          table
          (OptGvnEntry (OptBinKey op l r ty) dst def-block-id)
          changes)
        changes)]
    [(IrInstrUnOp dst op v ty)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          table
          (OptGvnEntry (OptUnKey op v ty) dst def-block-id)
          changes)
        changes)]
    [(IrInstrCpuId dst leaf subleaf reg-index)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          table
          (OptGvnEntry (OptCpuIdKey leaf subleaf reg-index) dst def-block-id)
          changes)
        changes)]
    [(IrInstrXgetbv dst index)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          table
          (OptGvnEntry (OptXgetbvKey index) dst def-block-id)
          changes)
        changes)]
    [_ changes]))

(define (opt-gvn-record-scope-instr-seq-from
  [sources : I64I64Map]
  [def-block-id : i64]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [table : OptGvnMap]
  [changes : OptGvnScopeChanges]) : OptGvnScopeChanges
  (if (>= index (compiler-ir-instr-seq-count instrs))
    changes
    (opt-gvn-record-scope-instr-seq-from
      sources
      def-block-id
      instrs
      (+ index 1)
      table
      (opt-gvn-record
        (compiler-ir-instr-seq-ref instrs index)
        def-block-id
        sources
        table
        changes))))

;; Find the nearest scoped result var for `key`, or -1 if none qualifies.
;; Dominance is represented by the current table scope; the bucket walk only
;; handles hash collisions and older same-key ancestors.
(define (opt-gvn-lookup-bucket [bucket : OptGvnBucket] [key : OptExprKey]) : i64
  (match bucket
    [(OptGvnBucketNil) (- 0 1)]
    [(OptGvnBucketCons entry rest)
      (match entry
        [(OptGvnEntry ekey evar def-block-id)
          (if (and (>= def-block-id 0) (opt-expr-key-eq ekey key))
            evar
            (opt-gvn-lookup-bucket (box-get rest) key))])]))

(define (opt-gvn-lookup [table : OptGvnMap] [key : OptExprKey]) : i64
  (let
    [buckets : (Array OptGvnBucket) (struct-get table buckets)]
    (opt-gvn-lookup-bucket
      (array-ref buckets (opt-gvn-bucket-index buckets key))
      key)))

(define (opt-gvn-rewrite-instr
  [table : OptGvnMap]
  [sources : I64I64Map]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrBinOp dst op l r ty)
      (if (and
        (opt-gvn-value-stable? sources l)
        (opt-gvn-value-stable? sources r))
        (let
          [earlier : i64 (opt-gvn-lookup table (OptBinKey op l r ty))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (IrInstrMov dst (IrValueVar earlier) ty)
            instr))
        instr)]
    [(IrInstrUnOp dst op v ty)
      (if (opt-gvn-value-stable? sources v)
        (let
          [earlier : i64 (opt-gvn-lookup table (OptUnKey op v ty))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (IrInstrMov dst (IrValueVar earlier) ty)
            instr))
        instr)]
    [(IrInstrCpuId dst leaf subleaf reg-index)
      (if (and
        (opt-gvn-value-stable? sources leaf)
        (opt-gvn-value-stable? sources subleaf))
        (let
          [earlier : i64
            (opt-gvn-lookup table (OptCpuIdKey leaf subleaf reg-index))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (IrInstrMov dst (IrValueVar earlier) (AstTyI64))
            instr))
        instr)]
    [(IrInstrXgetbv dst index)
      (if (opt-gvn-value-stable? sources index)
        (let
          [earlier : i64 (opt-gvn-lookup table (OptXgetbvKey index))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (IrInstrMov dst (IrValueVar earlier) (AstTyI64))
            instr))
        instr)]
    [_ instr]))

(define (opt-gvn-rewrite-instr-seq-from
  [table : OptGvnMap]
  [sources : I64I64Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [out : CompilerIrInstrList]) : CompilerIrInstrList
  (if (< index 0)
    out
    (opt-gvn-rewrite-instr-seq-from
      table
      sources
      instrs
      (- index 1)
      (compiler-ir-instr-cons
        (opt-gvn-rewrite-instr
          table
          sources
          (compiler-ir-instr-seq-ref instrs index))
        out))))

(define (opt-gvn-rewrite-instr-seq
  [table : OptGvnMap]
  [sources : I64I64Map]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-gvn-rewrite-instr-seq-from
    table
    sources
    instrs
    (- (compiler-ir-instr-seq-count instrs) 1)
    IrInstrNil))

(define (opt-gvn-rewrite-block
  [table : OptGvnMap]
  [sources : I64I64Map]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-gvn-rewrite-instr-seq table sources instrs))]))

(define (opt-gvn-dom-children [doms : OptDomInfo]) : OptCfgCsr
  (let
    [index : OptCfgIndex (struct-get doms index)]
    [count : i64 (opt-cfg-index-block-count index)]
    [child-rows : (Array OptI64List) (make-array OptI64List count)]
    (begin
      (opt-cfg-i64-list-array-fill-empty! child-rows count)
      (opt-dom-child-rows-fill! index (struct-get doms idom) child-rows)
      (opt-cfg-csr-build child-rows count))))

(define (opt-gvn-block-results-fill-empty!
  [out : (Array OptGvnBlockResult)]
  [index : i64]) : unit
  (if (>= index (array-length out))
    unit
    (begin
      (array-set! out index (OptGvnNoBlock))
      (opt-gvn-block-results-fill-empty! out (+ index 1)))))

(define (opt-gvn-materialize-blocks
  [doms : OptDomInfo]
  [out : (Array OptGvnBlockResult)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (let
            [block-id : i64 (opt-gvn-block-id doms label)]
            [material : CompilerIrBlock
              (if (and (>= block-id 0) (< block-id (array-length out)))
                (match (array-ref out block-id)
                  [(OptGvnSomeBlock rewritten) rewritten]
                  [(OptGvnNoBlock) block])
                block)]
            (compiler-ir-block-cons
              material
              (opt-gvn-materialize-blocks doms out (box-get rest))))])]
    [(IrBlockArray seq)
      (opt-gvn-materialize-blocks doms out (compiler-ir-block-seq-to-list seq))]))

(define (opt-gvn-rewrite-id
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [table : OptGvnMap]
  [sources : I64I64Map]
  [blocks : CompilerIrBlockList]
  [out : (Array OptGvnBlockResult)]
  [id : i64]) : unit
  (let
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and (>= id 0) (< id count))
      (let
        [label : String (array-ref (struct-get index labels) id)]
        (match (opt-cfg-find-block blocks label)
          [(OptNoBlock) unit]
          [(OptSomeBlock block)
            (match block
              [(IrBlock _ instrs)
                (let
                  [rewritten : CompilerIrBlock
                    (opt-gvn-rewrite-block table sources block)]
                  (begin
                    (array-set! out id (OptGvnSomeBlock rewritten))
                    (let
                      [changes : OptGvnScopeChanges
                        (opt-gvn-record-scope-instr-seq-from
                          sources
                          id
                          instrs
                          0
                          table
                          (OptGvnScopeNil))]
                      (begin
                        (opt-gvn-rewrite-children
                          context
                          children
                          table
                          sources
                          blocks
                          out
                          id)
                        (opt-gvn-table-restore! table changes)))))])]))
      unit)))

(define (opt-gvn-rewrite-children
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [table : OptGvnMap]
  [sources : I64I64Map]
  [blocks : CompilerIrBlockList]
  [out : (Array OptGvnBlockResult)]
  [parent-id : i64]) : unit
  (let
    [offsets : (Array i64) (struct-get children offsets)]
    [edges : (Array i64) (struct-get children edges)]
    [edge : i64 (array-ref offsets parent-id)]
    [end : i64 (array-ref offsets (+ parent-id 1))]
    (begin
      (while (< edge end)
        (begin
          (opt-gvn-rewrite-id
            context
            children
            table
            sources
            blocks
            out
            (array-ref edges edge))
          (set! edge (+ edge 1))))
      unit)))

(define (opt-gvn-rewrite-dom
  [context : OptCfgContext]
  [table : OptGvnMap]
  [sources : I64I64Map]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [doms : OptDomInfo (struct-get context doms)]
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    [children : OptCfgCsr (opt-gvn-dom-children doms)]
    [out : (Array OptGvnBlockResult) (make-array OptGvnBlockResult count)]
    (begin
      (opt-gvn-block-results-fill-empty! out 0)
      (match (opt-cfg-index-id index (struct-get context entry-label))
        [(OptSomeI64 entry-id)
          (if (and
            (>= entry-id 0)
            (array-ref (struct-get index reachable) entry-id))
            (opt-gvn-rewrite-id
              context
              children
              table
              sources
              blocks
              out
              entry-id)
            unit)]
        [(OptNoI64) unit])
      (opt-gvn-materialize-blocks doms out blocks))))

;; Replace dominated repeated pure scalar expressions with a copy from the first
;; dominating value; existing copy propagation and DCE remove the dead copies.
(define (opt-gvn-blocks-with-context
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [sources : I64I64Map
      (opt-gvn-sources-blocks
        blocks
        (opt-gvn-sources-params params (i64-i64-map-with-capacity 64)))]
    [table : OptGvnMap
      (opt-gvn-map-empty (opt-gvn-record-count-blocks sources blocks))]
    [gvn : CompilerIrBlockList
      (opt-gvn-rewrite-dom context table sources blocks)]
    (opt-load-gvn-blocks-with-context context sources gvn)))

(define (opt-gvn-blocks
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-gvn-blocks-with-context (opt-cfg-context-build blocks) params blocks))

;; --- proven-safe div/rem guard elision (#2937) ------------------------------
;;
;; This pass marks integer div/rem as non-trapping only from facts established by
;; explicit dominating CFG edge checks. It deliberately ignores casts and joins:
;; a fact reaches a successor only when that successor has exactly one reachable
;; predecessor, so facts are never accidentally unioned across paths.
(defenum OptDivRemFactKind
  (OptDivRemFactNonZero)
  (OptDivRemFactNotNegOne)
  (OptDivRemFactNotSignedMin))

(defenum OptDivRemFact
  (OptDivRemFact i64 AstType OptDivRemFactKind))

(defenum OptDivRemFacts
  (OptDivRemFactsNil)
  (OptDivRemFactsCons OptDivRemFact (Box OptDivRemFacts)))

(defenum OptDivRemCmp
  (OptDivRemNoCmp)
  (OptDivRemCmp CompilerIrBinOp CompilerIrValue CompilerIrValue AstType i64))

(defenum OptDivRemBlockResult
  (OptDivRemNoBlock)
  (OptDivRemSomeBlock CompilerIrBlock))

(defenum OptDivRemInstrRewrite
  (OptDivRemInstrRewrite OptDivRemFacts CompilerIrInstrList))

(defenum OptDivRemBlockRewrite
  (OptDivRemBlockRewrite CompilerIrBlock OptDivRemFacts))

(define (opt-divrem-fact-kind-eq?
  [a : OptDivRemFactKind]
  [b : OptDivRemFactKind]) : bool
  (match a
    [(OptDivRemFactNonZero)
      (match b
        [(OptDivRemFactNonZero) true]
        [_ false])]
    [(OptDivRemFactNotNegOne)
      (match b
        [(OptDivRemFactNotNegOne) true]
        [_ false])]
    [(OptDivRemFactNotSignedMin)
      (match b
        [(OptDivRemFactNotSignedMin) true]
        [_ false])]))

(define (opt-divrem-facts-contains-kind?
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [kind : OptDivRemFactKind]) : bool
  (match facts
    [(OptDivRemFactsNil) false]
    [(OptDivRemFactsCons fact rest)
      (match fact
        [(OptDivRemFact fact-var fact-ty fact-kind)
          (if (and
            (= fact-var var)
            (opt-type-eq fact-ty ty)
            (opt-divrem-fact-kind-eq? fact-kind kind))
            true
            (opt-divrem-facts-contains-kind? (box-get rest) var ty kind))])]))

(define (opt-divrem-facts-add-kind
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [kind : OptDivRemFactKind]) : OptDivRemFacts
  (if (opt-divrem-facts-contains-kind? facts var ty kind)
    facts
    (OptDivRemFactsCons (OptDivRemFact var ty kind) (box facts))))

(define (opt-divrem-facts-remove-var [facts : OptDivRemFacts] [var : i64]) : OptDivRemFacts
  (match facts
    [(OptDivRemFactsNil) (OptDivRemFactsNil)]
    [(OptDivRemFactsCons fact rest)
      (match fact
        [(OptDivRemFact fact-var _ _)
          (let
            [rest2 : OptDivRemFacts
              (opt-divrem-facts-remove-var (box-get rest) var)]
            (if (= fact-var var)
              rest2
              (OptDivRemFactsCons fact (box rest2))))])]))

(define (opt-divrem-add-nonzero
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]) : OptDivRemFacts
  (opt-divrem-facts-add-kind facts var ty (OptDivRemFactNonZero)))

(define (opt-divrem-add-not-neg-one
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]) : OptDivRemFacts
  (opt-divrem-facts-add-kind facts var ty (OptDivRemFactNotNegOne)))

(define (opt-divrem-add-not-signed-min
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]) : OptDivRemFacts
  (opt-divrem-facts-add-kind facts var ty (OptDivRemFactNotSignedMin)))

(define (opt-divrem-add-exact-facts
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (!= value 0)
        (opt-divrem-add-nonzero facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (!= value (- 0 1)))
        (opt-divrem-add-not-neg-one nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (!= value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-not-eq-facts
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (= value 0)
        (opt-divrem-add-nonzero facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (= value (- 0 1)))
        (opt-divrem-add-not-neg-one nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (= value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-gt-facts
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (opt-typed-ge? value 0 ty)
        (opt-divrem-add-nonzero facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (>= value (- 0 1)))
        (opt-divrem-add-not-neg-one nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (>= value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-ge-facts
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (opt-typed-gt? value 0 ty)
        (opt-divrem-add-nonzero facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (>= value 0))
        (opt-divrem-add-not-neg-one nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (> value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-lt-facts
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (<= value 0))
        (opt-divrem-add-nonzero facts var ty)
        facts)]
    (if (and (opt-signed-integer-type? ty) (<= value (- 0 1)))
      (opt-divrem-add-not-neg-one nonzero var ty)
      nonzero)))

(define (opt-divrem-add-le-facts
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (< value 0))
        (opt-divrem-add-nonzero facts var ty)
        facts)]
    (if (and (opt-signed-integer-type? ty) (<= value (- 0 2)))
      (opt-divrem-add-not-neg-one nonzero var ty)
      nonzero)))

(define (opt-divrem-add-compare-facts
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : AstType]
  [op : CompilerIrBinOp]
  [value : i64]) : OptDivRemFacts
  (if (not (opt-integer-type? ty))
    facts
    (match op
      [(IrBinEq) (opt-divrem-add-exact-facts facts var ty value)]
      [(IrBinNe) (opt-divrem-add-not-eq-facts facts var ty value)]
      [(IrBinGt) (opt-divrem-add-gt-facts facts var ty value)]
      [(IrBinGe) (opt-divrem-add-ge-facts facts var ty value)]
      [(IrBinLt) (opt-divrem-add-lt-facts facts var ty value)]
      [(IrBinLe) (opt-divrem-add-le-facts facts var ty value)]
      [_ facts])))

(define (opt-divrem-invert-compare [op : CompilerIrBinOp]) : CompilerIrBinOp
  (match op
    [(IrBinEq) (IrBinNe)]
    [(IrBinNe) (IrBinEq)]
    [(IrBinLt) (IrBinGe)]
    [(IrBinLe) (IrBinGt)]
    [(IrBinGt) (IrBinLe)]
    [(IrBinGe) (IrBinLt)]
    [_ op]))

(define (opt-divrem-flip-compare [op : CompilerIrBinOp]) : CompilerIrBinOp
  (match op
    [(IrBinLt) (IrBinGt)]
    [(IrBinLe) (IrBinGe)]
    [(IrBinGt) (IrBinLt)]
    [(IrBinGe) (IrBinLe)]
    [_ op]))

(define (opt-divrem-edge-compare-op
  [op : CompilerIrBinOp]
  [truthy-edge? : bool]) : CompilerIrBinOp
  (if truthy-edge?
    op
    (opt-divrem-invert-compare op)))

(define (opt-divrem-compare-op? [op : CompilerIrBinOp]) : bool
  (match op
    [(IrBinEq) true]
    [(IrBinNe) true]
    [(IrBinLt) true]
    [(IrBinLe) true]
    [(IrBinGt) true]
    [(IrBinGe) true]
    [_ false]))

(define (opt-divrem-value-type
  [types : OptSsaVarTypes]
  [value : CompilerIrValue]
  [fallback : AstType]) : AstType
  (match value
    [(IrValueVar var)
      (match (opt-ssa-var-type-lookup types var)
        [(OptSomeAstType ty) ty]
        [(OptNoAstType) fallback])]
    [_ fallback]))

(define (opt-divrem-add-edge-facts-from-cmp
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [instrs : CompilerIrInstrSeq]
  [cmp-index : i64]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : OptDivRemFacts
  (let
    [operand-ty : AstType
      (match lhs
        [(IrValueVar _) (opt-divrem-value-type types lhs ty)]
        [_ (opt-divrem-value-type types rhs ty)])]
    (match lhs
      [(IrValueVar var)
        (if (opt-divrem-var-defined-at-or-after? instrs cmp-index var)
          facts
          (match (opt-normalize-scalar-to-i64 rhs operand-ty)
            [(OptSomeI64 value)
              (opt-divrem-add-compare-facts facts var operand-ty op value)]
            [(OptNoI64) facts]))]
      [_
        (match rhs
          [(IrValueVar var)
            (if (opt-divrem-var-defined-at-or-after? instrs cmp-index var)
              facts
              (match (opt-normalize-scalar-to-i64 lhs operand-ty)
                [(OptSomeI64 value)
                  (opt-divrem-add-compare-facts
                    facts
                    var
                    operand-ty
                    (opt-divrem-flip-compare op)
                    value)]
                [(OptNoI64) facts]))]
          [_ facts])])))

(define (opt-divrem-edge-facts
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [instrs : CompilerIrInstrSeq]
  [cond : CompilerIrValue]
  [truthy-edge? : bool]) : OptDivRemFacts
  (match cond
    [(IrValueVar cond-var)
      (match (opt-divrem-find-cmp-def instrs cond-var)
        [(OptDivRemCmp op lhs rhs ty cmp-index)
          (opt-divrem-add-edge-facts-from-cmp
            facts
            types
            instrs
            cmp-index
            (opt-divrem-edge-compare-op op truthy-edge?)
            lhs
            rhs
            ty)]
        [(OptDivRemNoCmp) facts])]
    [_ facts]))

(define (opt-divrem-find-cmp-def-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [cond-var : i64]) : OptDivRemCmp
  (if (< index 0)
    (OptDivRemNoCmp)
    (match (compiler-ir-instr-seq-ref instrs index)
      [(IrInstrBinOp dst op lhs rhs ty)
        (if (and (= dst cond-var) (opt-divrem-compare-op? op))
          (OptDivRemCmp op lhs rhs ty index)
          (opt-divrem-find-cmp-def-from instrs (- index 1) cond-var))]
      [_ (opt-divrem-find-cmp-def-from instrs (- index 1) cond-var)])))

(define (opt-divrem-find-cmp-def [instrs : CompilerIrInstrSeq] [cond-var : i64]) : OptDivRemCmp
  (opt-divrem-find-cmp-def-from
    instrs
    (- (compiler-ir-instr-seq-count instrs) 1)
    cond-var))

(define (opt-divrem-instr-def-var [instr : CompilerIrInstr]) : OptMaybeI64
  (match instr
    [(IrInstrCallIndirect dst _ _ _) (OptSomeI64 dst)]
    [(IrInstrCallIndirectC dst _ _ _) (OptSomeI64 dst)]
    [_ (opt-instr-def-var instr)]))

(define (opt-divrem-instr-defines-var? [instr : CompilerIrInstr] [var : i64]) : bool
  (match (opt-divrem-instr-def-var instr)
    [(OptSomeI64 dst) (= dst var)]
    [(OptNoI64) false]))

(define (opt-divrem-var-defined-at-or-after-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [var : i64]) : bool
  (if (>= index count)
    false
    (if (opt-divrem-instr-defines-var?
      (compiler-ir-instr-seq-ref instrs index)
      var)
      true
      (opt-divrem-var-defined-at-or-after-from? instrs (+ index 1) count var))))

(define (opt-divrem-var-defined-at-or-after?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : bool
  (opt-divrem-var-defined-at-or-after-from?
    instrs
    index
    (compiler-ir-instr-seq-count instrs)
    var))

(define (opt-divrem-literal-proves-kind?
  [value : CompilerIrValue]
  [ty : AstType]
  [kind : OptDivRemFactKind]) : bool
  (match (opt-normalize-scalar-to-i64 value ty)
    [(OptSomeI64 n)
      (match kind
        [(OptDivRemFactNonZero) (!= n 0)]
        [(OptDivRemFactNotNegOne)
          (if (opt-signed-integer-type? ty)
            (!= n (- 0 1))
            true)]
        [(OptDivRemFactNotSignedMin)
          (if (opt-signed-integer-type? ty)
            (!= n (opt-signed-min ty))
            true)])]
    [(OptNoI64) false]))

(define (opt-divrem-value-proves-kind?
  [facts : OptDivRemFacts]
  [value : CompilerIrValue]
  [ty : AstType]
  [kind : OptDivRemFactKind]) : bool
  (if (opt-divrem-literal-proves-kind? value ty kind)
    true
    (match value
      [(IrValueVar var) (opt-divrem-facts-contains-kind? facts var ty kind)]
      [_ false])))

(define (opt-divrem-proven-safe?
  [facts : OptDivRemFacts]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : bool
  (if (not (opt-integer-type? ty))
    false
    (if (opt-unsigned-integer-type? ty)
      (opt-divrem-value-proves-kind? facts rhs ty (OptDivRemFactNonZero))
      (and
        (opt-divrem-value-proves-kind? facts rhs ty (OptDivRemFactNonZero))
        (or
          (opt-divrem-value-proves-kind? facts rhs ty (OptDivRemFactNotNegOne))
          (opt-divrem-value-proves-kind?
            facts
            lhs
            ty
            (OptDivRemFactNotSignedMin)))))))

(define (opt-divrem-rewrite-op
  [facts : OptDivRemFacts]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : CompilerIrBinOp
  (match op
    [(IrBinDiv)
      (if (opt-divrem-proven-safe? facts lhs rhs ty)
        (IrBinSafeDiv)
        op)]
    [(IrBinMod)
      (if (opt-divrem-proven-safe? facts lhs rhs ty)
        (IrBinSafeMod)
        op)]
    [_ op]))

(define (opt-divrem-rewrite-instr
  [facts : OptDivRemFacts]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrBinOp dst op lhs rhs ty)
      (IrInstrBinOp dst (opt-divrem-rewrite-op facts op lhs rhs ty) lhs rhs ty)]
    [_ instr]))

(define (opt-divrem-facts-after-instr
  [facts : OptDivRemFacts]
  [instr : CompilerIrInstr]) : OptDivRemFacts
  (match (opt-divrem-instr-def-var instr)
    [(OptSomeI64 dst) (opt-divrem-facts-remove-var facts dst)]
    [(OptNoI64) facts]))

(define (opt-divrem-rewrite-instr-seq-from
  [facts : OptDivRemFacts]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [out-rev : CompilerIrInstrList]) : OptDivRemInstrRewrite
  (if (>= index count)
    (OptDivRemInstrRewrite
      facts
      (compiler-ir-instr-list-reverse-onto out-rev IrInstrNil))
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      [rewritten : CompilerIrInstr (opt-divrem-rewrite-instr facts instr)]
      (opt-divrem-rewrite-instr-seq-from
        (opt-divrem-facts-after-instr facts rewritten)
        instrs
        (+ index 1)
        count
        (compiler-ir-instr-cons rewritten out-rev)))))

(define (opt-divrem-rewrite-block
  [facts : OptDivRemFacts]
  [block : CompilerIrBlock]) : OptDivRemBlockRewrite
  (match block
    [(IrBlock label instrs)
      (match (opt-divrem-rewrite-instr-seq-from
        facts
        instrs
        0
        (compiler-ir-instr-seq-count instrs)
        IrInstrNil)
        [(OptDivRemInstrRewrite final-facts rewritten)
          (OptDivRemBlockRewrite
            (compiler-ir-block label rewritten)
            final-facts)])]))

(define (opt-divrem-reachable-pred-count [index : OptCfgIndex] [id : i64]) : i64
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (let
      [preds : OptCfgCsr (struct-get index preds)]
      [edge : i64 (array-ref (struct-get preds offsets) id)]
      [end : i64 (array-ref (struct-get preds offsets) (+ id 1))]
      [count : i64 0]
      (begin
        (while (< edge end)
          (let
            [pred : i64 (array-ref (struct-get preds edges) edge)]
            (begin
              (if (array-ref (struct-get index reachable) pred)
                (set! count (+ count 1))
                unit)
              (set! edge (+ edge 1)))))
        count))
    0))

(define (opt-divrem-set-successor-facts!
  [index : OptCfgIndex]
  [facts-by-id : (Array OptDivRemFacts)]
  [label : String]
  [facts : OptDivRemFacts]) : unit
  (match (opt-cfg-index-id index label)
    [(OptSomeI64 id)
      (if (and
        (array-ref (struct-get index reachable) id)
        (= (opt-divrem-reachable-pred-count index id) 1))
        (array-set! facts-by-id id facts)
        unit)]
    [(OptNoI64) unit]))

(define (opt-divrem-propagate-terminator!
  [index : OptCfgIndex]
  [facts-by-id : (Array OptDivRemFacts)]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [instrs : CompilerIrInstrSeq]
  [terminator : CompilerIrInstr]) : unit
  (match terminator
    [(IrInstrJump label)
      (opt-divrem-set-successor-facts! index facts-by-id label facts)]
    [(IrInstrBranch cond true-label false-label)
      (begin
        (opt-divrem-set-successor-facts!
          index
          facts-by-id
          true-label
          (opt-divrem-edge-facts facts types instrs cond true))
        (opt-divrem-set-successor-facts!
          index
          facts-by-id
          false-label
          (opt-divrem-edge-facts facts types instrs cond false)))]
    [_ unit]))

(define (opt-divrem-propagate-block!
  [index : OptCfgIndex]
  [facts-by-id : (Array OptDivRemFacts)]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [block : CompilerIrBlock]) : unit
  (match block
    [(IrBlock _ instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (> count 0)
          (opt-divrem-propagate-terminator!
            index
            facts-by-id
            facts
            types
            instrs
            (compiler-ir-instr-seq-ref instrs (- count 1)))
          unit))]))

(define (opt-divrem-results-fill-empty!
  [out : (Array OptDivRemBlockResult)]
  [index : i64]) : unit
  (if (>= index (array-length out))
    unit
    (begin
      (array-set! out index (OptDivRemNoBlock))
      (opt-divrem-results-fill-empty! out (+ index 1)))))

(define (opt-divrem-facts-fill-empty!
  [facts : (Array OptDivRemFacts)]
  [index : i64]) : unit
  (if (>= index (array-length facts))
    unit
    (begin
      (array-set! facts index (OptDivRemFactsNil))
      (opt-divrem-facts-fill-empty! facts (+ index 1)))))

(define (opt-divrem-process-rpo!
  [context : OptCfgContext]
  [blocks : CompilerIrBlockList]
  [types : OptSsaVarTypes]
  [facts-by-id : (Array OptDivRemFacts)]
  [out : (Array OptDivRemBlockResult)]
  [slot : i64]) : unit
  (let
    [index : OptCfgIndex (struct-get context index)]
    (if (>= slot (struct-get index reach-count))
      unit
      (let
        [id : i64 (opt-cfg-index-rpo-id index slot)]
        [label : String (opt-cfg-index-label index id)]
        [facts : OptDivRemFacts (array-ref facts-by-id id)]
        (begin
          (match (opt-cfg-find-block blocks label)
            [(OptSomeBlock block)
              (let
                [rewrite : OptDivRemBlockRewrite
                  (opt-divrem-rewrite-block facts block)]
                (match rewrite
                  [(OptDivRemBlockRewrite rewritten final-facts)
                    (begin
                      (array-set! out id (OptDivRemSomeBlock rewritten))
                      (opt-divrem-propagate-block!
                        index
                        facts-by-id
                        final-facts
                        types
                        rewritten))]))]
            [(OptNoBlock) unit])
          (opt-divrem-process-rpo!
            context
            blocks
            types
            facts-by-id
            out
            (+ slot 1)))))))

(define (opt-divrem-materialize-blocks
  [context : OptCfgContext]
  [out : (Array OptDivRemBlockResult)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (let
            [material : CompilerIrBlock
              (match (opt-cfg-index-id (struct-get context index) label)
                [(OptSomeI64 id)
                  (if (and (>= id 0) (< id (array-length out)))
                    (match (array-ref out id)
                      [(OptDivRemSomeBlock rewritten) rewritten]
                      [(OptDivRemNoBlock) block])
                    block)]
                [(OptNoI64) block])]
            (compiler-ir-block-cons
              material
              (opt-divrem-materialize-blocks context out (box-get rest))))])]
    [(IrBlockArray seq)
      (opt-divrem-materialize-blocks
        context
        out
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-divrem-safety-blocks-with-context
  [context : OptCfgContext]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    [ssa-facts : OptSsaFacts (opt-ssa-facts-from-function params blocks)]
    [types : OptSsaVarTypes
      (match ssa-facts
        [(OptSsaFacts _ _ fact-types) fact-types])]
    [facts : (Array OptDivRemFacts) (make-array OptDivRemFacts count)]
    [out : (Array OptDivRemBlockResult) (make-array OptDivRemBlockResult count)]
    (begin
      (opt-divrem-facts-fill-empty! facts 0)
      (opt-divrem-results-fill-empty! out 0)
      (opt-divrem-process-rpo! context blocks types facts out 0)
      (opt-divrem-materialize-blocks context out blocks))))

(define (opt-divrem-safety-blocks
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (opt-divrem-safety-blocks-with-context
    (opt-cfg-context-build blocks)
    params
    blocks))

;; --- guarded loop bounds-check elimination (#2848) -------------------------
;;
;; The block-local bounds pass can only remove a repeated check in the same
;; block. This function pass handles the lowered dynamic-array loop shape:
;; a dominating fat-handle length store, a while header guarding `i < n`, and a
;; body bounds check against the same array length. It also handles the lowered
;; String shape where a header `string-length` load and a body `string-ref`
;; length load read the same handle. It runs before stack promotion so the
;; direct fat-handle stores/loads are still visible; later DCE removes the
;; now-dead length load/cast scaffolding.
(defenum OptLoopBceExpr
  (OptLoopBceUnknown)
  (OptLoopBceValue CompilerIrValue)
  (OptLoopBceArgc)
  (OptLoopBceBin
    CompilerIrBinOp
    (Box OptLoopBceExpr)
    (Box OptLoopBceExpr)
    AstType))

(defenum OptLoopBceExprEnv
  (OptLoopBceExprNil)
  (OptLoopBceExprCons i64 OptLoopBceExpr (Box OptLoopBceExprEnv)))

(defenum OptLoopBceAliasEnv
  (OptLoopBceAliasNil)
  (OptLoopBceAliasCons i64 i64 (Box OptLoopBceAliasEnv)))

(defenum OptLoopBcePtrKind
  (OptLoopBcePtrUnknown)
  (OptLoopBceLengthSlot i64)
  (OptLoopBceDataSlot i64)
  (OptLoopBceDataBuffer i64)
  (OptLoopBceDataElement i64))

(defenum OptLoopBcePtrEnv
  (OptLoopBcePtrNil)
  (OptLoopBcePtrCons i64 OptLoopBcePtrKind (Box OptLoopBcePtrEnv)))

(defenum OptLoopBceLengthEnv
  (OptLoopBceLengthNil)
  (OptLoopBceLengthCons i64 OptLoopBceExpr (Box OptLoopBceLengthEnv)))

(defenum OptLoopBceCmpEnv
  (OptLoopBceCmpNil)
  (OptLoopBceCmpCons
    i64
    CompilerIrBinOp
    OptLoopBceExpr
    OptLoopBceExpr
    AstType
    (Box OptLoopBceCmpEnv)))

(defenum OptLoopBceGuardEnv
  (OptLoopBceGuardNil)
  (OptLoopBceGuardCons
    String
    OptLoopBceExpr
    OptLoopBceExpr
    (Box OptLoopBceGuardEnv)))

(defenum OptRangeFact
  (OptRangeFactNonnegative String OptLoopBceExpr)
  (OptRangeFactLessThan String OptLoopBceExpr OptLoopBceExpr))

(defenum OptRangeFacts
  (OptRangeFactsNil)
  (OptRangeFactsCons OptRangeFact (Box OptRangeFacts)))

(defstruct OptLoopBceSummaries
  (enabled bool)
  (length-clean StringI64Map)
  (argc-return StringI64Map)
  ;; #3468: whole-program table of never-written literal-i64 globals, mapping
  ;; global name -> constant value. Carried alongside the BCE summaries (rather
  ;; than threaded as a separate parameter) because both are built once per
  ;; program and consumed in the same per-function level-2 pass. Empty unless
  ;; the program qualifies for summary construction.
  (const-divisors StringI64Map))

(defstruct OptLoopBceState
  (exprs OptLoopBceExprEnv)
  (aliases OptLoopBceAliasEnv)
  (ptrs OptLoopBcePtrEnv)
  (lengths OptLoopBceLengthEnv)
  (cmps OptLoopBceCmpEnv)
  (guards OptLoopBceGuardEnv)
  (ranges OptRangeFacts))

(defenum OptLoopBceRewrite
  (OptLoopBceRewrite OptLoopBceState CompilerIrInstrList))

(defenum OptLoopBceBlockRewrite
  (OptLoopBceBlockRewrite OptLoopBceState CompilerIrBlock))

(defenum OptLoopBceMaybeLabel
  (OptLoopBceNoLabel)
  (OptLoopBceSomeLabel String))

(defenum OptLoopBceMaybeVar
  (OptLoopBceNoVar)
  (OptLoopBceSomeVar i64))

(defenum OptLoopBceIndexDef
  (OptLoopBceIndexNoDef)
  (OptLoopBceIndexZero)
  (OptLoopBceIndexIncrement)
  (OptLoopBceIndexOther))

(defenum OptLoopBceHeaderEdges
  (OptLoopBceHeaderEdges bool bool bool))

(defenum OptLoopBceBlockResult
  (OptLoopBceNoBlock)
  (OptLoopBceSomeBlock CompilerIrBlock))

(define (opt-loop-bce-empty-summaries) : OptLoopBceSummaries
  (OptLoopBceSummaries
    false
    (string-i64-map-with-capacity 8)
    (string-i64-map-with-capacity 8)
    (string-i64-map-with-capacity 8)))

(define (opt-loop-bce-summary-length-clean?
  [summaries : OptLoopBceSummaries]
  [name : String]) : bool
  (string-i64-map-contains? (struct-get summaries length-clean) name))

(define (opt-loop-bce-summary-argc-return?
  [summaries : OptLoopBceSummaries]
  [name : String]) : bool
  (string-i64-map-contains? (struct-get summaries argc-return) name))

(define (opt-loop-bce-commutative-op? [op : CompilerIrBinOp]) : bool
  (match op
    [(IrBinAdd) true]
    [(IrBinMul) true]
    [(IrBinAnd) true]
    [(IrBinOr) true]
    [(IrBinBitAnd) true]
    [(IrBinBitOr) true]
    [(IrBinBitXor) true]
    [_ false]))

(define (opt-loop-bce-expr-eq [a : OptLoopBceExpr] [b : OptLoopBceExpr]) : bool
  (match a
    [(OptLoopBceUnknown) false]
    [(OptLoopBceValue av)
      (match b
        [(OptLoopBceValue bv) (opt-value-eq av bv)]
        [_ false])]
    [(OptLoopBceArgc)
      (match b
        [(OptLoopBceArgc) true]
        [_ false])]
    [(OptLoopBceBin aop al ar aty)
      (match b
        [(OptLoopBceBin bop bl br bty)
          (and
            (opt-binop-eq aop bop)
            (opt-type-eq aty bty)
            (or
              (and
                (opt-loop-bce-expr-eq (box-get al) (box-get bl))
                (opt-loop-bce-expr-eq (box-get ar) (box-get br)))
              (and
                (opt-loop-bce-commutative-op? aop)
                (opt-loop-bce-expr-eq (box-get al) (box-get br))
                (opt-loop-bce-expr-eq (box-get ar) (box-get bl)))))]
        [_ false])]))

(define (opt-range-nonnegative-contains?
  [facts : OptRangeFacts]
  [label : String]
  [expr : OptLoopBceExpr]) : bool
  (match facts
    [(OptRangeFactsNil) false]
    [(OptRangeFactsCons fact rest)
      (match fact
        [(OptRangeFactNonnegative fact-label fact-expr)
          (if (and
            (string-eq fact-label label)
            (opt-loop-bce-expr-eq fact-expr expr))
            true
            (opt-range-nonnegative-contains? (box-get rest) label expr))]
        [_ (opt-range-nonnegative-contains? (box-get rest) label expr)])]))

(define (opt-range-less-than-contains?
  [facts : OptRangeFacts]
  [label : String]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (match facts
    [(OptRangeFactsNil) false]
    [(OptRangeFactsCons fact rest)
      (match fact
        [(OptRangeFactLessThan fact-label fact-lhs fact-rhs)
          (if (and
            (string-eq fact-label label)
            (opt-loop-bce-expr-eq fact-lhs lhs)
            (opt-loop-bce-expr-eq fact-rhs rhs))
            true
            (opt-range-less-than-contains? (box-get rest) label lhs rhs))]
        [_ (opt-range-less-than-contains? (box-get rest) label lhs rhs)])]))

(define (opt-range-facts-add-nonnegative
  [facts : OptRangeFacts]
  [label : String]
  [expr : OptLoopBceExpr]) : OptRangeFacts
  (if (opt-range-nonnegative-contains? facts label expr)
    facts
    (OptRangeFactsCons (OptRangeFactNonnegative label expr) (box facts))))

(define (opt-range-facts-add-less-than
  [facts : OptRangeFacts]
  [label : String]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (if (opt-range-less-than-contains? facts label lhs rhs)
    facts
    (OptRangeFactsCons (OptRangeFactLessThan label lhs rhs) (box facts))))

(define (opt-range-facts-propagate-label-from
  [source : OptRangeFacts]
  [out : OptRangeFacts]
  [parent-label : String]
  [child-label : String]) : OptRangeFacts
  (if (string-eq parent-label child-label)
    out
    (match source
      [(OptRangeFactsNil) out]
      [(OptRangeFactsCons fact rest)
        (let
          [next : OptRangeFacts
            (match fact
              [(OptRangeFactNonnegative label expr)
                (if (string-eq label parent-label)
                  (opt-range-facts-add-nonnegative out child-label expr)
                  out)]
              [(OptRangeFactLessThan label lhs rhs)
                (if (string-eq label parent-label)
                  (opt-range-facts-add-less-than out child-label lhs rhs)
                  out)])]
          (opt-range-facts-propagate-label-from
            (box-get rest)
            next
            parent-label
            child-label))])))

(define (opt-range-facts-propagate-label
  [facts : OptRangeFacts]
  [parent-label : String]
  [child-label : String]) : OptRangeFacts
  (opt-range-facts-propagate-label-from facts facts parent-label child-label))

(define (opt-range-expr-stable? [sources : I64I64Map] [expr : OptLoopBceExpr]) : bool
  (match expr
    [(OptLoopBceUnknown) false]
    [(OptLoopBceArgc) true]
    [(OptLoopBceValue value) (opt-gvn-value-stable? sources value)]
    [(OptLoopBceBin op lhs rhs _)
      (and
        (not (opt-binop-traps? op))
        (opt-range-expr-stable? sources (box-get lhs))
        (opt-range-expr-stable? sources (box-get rhs)))]))

(define (opt-range-expr-type
  [types : OptSsaVarTypes]
  [expr : OptLoopBceExpr]
  [fallback : AstType]) : AstType
  (match expr
    [(OptLoopBceValue value) (opt-divrem-value-type types value fallback)]
    [(OptLoopBceArgc) (AstTyI64)]
    [(OptLoopBceBin _ _ _ ty) ty]
    [(OptLoopBceUnknown) fallback]))

(define (opt-range-compare-operand-type
  [types : OptSsaVarTypes]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [fallback : AstType]) : AstType
  (let
    [lhs-ty : AstType (opt-range-expr-type types lhs fallback)]
    (if (opt-integer-type? lhs-ty)
      lhs-ty
      (opt-range-expr-type types rhs fallback))))

(define (opt-range-compare-value-type
  [types : OptSsaVarTypes]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [fallback : AstType]) : AstType
  (match lhs
    [(IrValueVar _) (opt-divrem-value-type types lhs fallback)]
    [_ (opt-divrem-value-type types rhs fallback)]))

(define (opt-range-expr-i64 [expr : OptLoopBceExpr] [ty : AstType]) : OptMaybeI64
  (match expr
    [(OptLoopBceValue value) (opt-normalize-scalar-to-i64 value ty)]
    [_ (OptNoI64)]))

(define (opt-range-add-nonnegative-from-compare
  [facts : OptRangeFacts]
  [sources : I64I64Map]
  [label : String]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [ty : AstType]) : OptRangeFacts
  (if (not (opt-integer-type? ty))
    facts
    (let
      [from-lhs : OptRangeFacts
        (if (opt-range-expr-stable? sources lhs)
          (match (opt-range-expr-i64 rhs ty)
            [(OptSomeI64 value)
              (match op
                [(IrBinGe)
                  (if (= value 0)
                    (opt-range-facts-add-nonnegative facts label lhs)
                    facts)]
                [(IrBinGt)
                  (if (and (opt-signed-integer-type? ty) (= value (- 0 1)))
                    (opt-range-facts-add-nonnegative facts label lhs)
                    facts)]
                [_ facts])]
            [(OptNoI64) facts])
          facts)]
      (if (opt-range-expr-stable? sources rhs)
        (match (opt-range-expr-i64 lhs ty)
          [(OptSomeI64 value)
            (match op
              [(IrBinLe)
                (if (= value 0)
                  (opt-range-facts-add-nonnegative from-lhs label rhs)
                  from-lhs)]
              [(IrBinLt)
                (if (and (opt-signed-integer-type? ty) (= value (- 0 1)))
                  (opt-range-facts-add-nonnegative from-lhs label rhs)
                  from-lhs)]
              [_ from-lhs])]
          [(OptNoI64) from-lhs])
        from-lhs))))

(define (opt-range-add-less-than-from-compare
  [facts : OptRangeFacts]
  [sources : I64I64Map]
  [label : String]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (match op
    [(IrBinLt)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than facts label lhs rhs)
        facts)]
    [(IrBinGt)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than facts label rhs lhs)
        facts)]
    [_ facts]))

(define (opt-range-add-edge-facts
  [facts : OptRangeFacts]
  [sources : I64I64Map]
  [types : OptSsaVarTypes]
  [label : String]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [fallback-ty : AstType]) : OptRangeFacts
  (let
    [operand-ty : AstType
      (opt-range-compare-operand-type types lhs rhs fallback-ty)]
    [less : OptRangeFacts
      (opt-range-add-less-than-from-compare facts sources label op lhs rhs)]
    [nonnegative : OptRangeFacts
      (opt-range-add-nonnegative-from-compare
        less
        sources
        label
        op
        lhs
        rhs
        operand-ty)]
    (if (and
      (opt-unsigned-integer-type? operand-ty)
      (match op
        [(IrBinLt) true]
        [(IrBinGt) true]
        [_ false]))
      (match op
        [(IrBinLt)
          (if (opt-range-expr-stable? sources lhs)
            (opt-range-facts-add-nonnegative nonnegative label lhs)
            nonnegative)]
        [(IrBinGt)
          (if (opt-range-expr-stable? sources rhs)
            (opt-range-facts-add-nonnegative nonnegative label rhs)
            nonnegative)]
        [_ nonnegative])
      nonnegative)))

(define (opt-loop-bce-expr-unbind [env : OptLoopBceExprEnv] [var : i64]) : OptLoopBceExprEnv
  (match env
    [(OptLoopBceExprNil) (OptLoopBceExprNil)]
    [(OptLoopBceExprCons id expr rest)
      (let
        [tail : OptLoopBceExprEnv (opt-loop-bce-expr-unbind (box-get rest) var)]
        (if (= id var)
          tail
          (OptLoopBceExprCons id expr (box tail))))]))

(define (opt-loop-bce-expr-bind
  [env : OptLoopBceExprEnv]
  [var : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceExprEnv
  (match expr
    [(OptLoopBceUnknown) (opt-loop-bce-expr-unbind env var)]
    [_ (OptLoopBceExprCons var expr (box (opt-loop-bce-expr-unbind env var)))]))

(define (opt-loop-bce-expr-lookup [env : OptLoopBceExprEnv] [var : i64]) : OptLoopBceExpr
  (match env
    [(OptLoopBceExprNil) (OptLoopBceUnknown)]
    [(OptLoopBceExprCons id expr rest)
      (if (= id var)
        expr
        (opt-loop-bce-expr-lookup (box-get rest) var))]))

(define (opt-loop-bce-alias-unbind [env : OptLoopBceAliasEnv] [var : i64]) : OptLoopBceAliasEnv
  (match env
    [(OptLoopBceAliasNil) (OptLoopBceAliasNil)]
    [(OptLoopBceAliasCons id root rest)
      (let
        [tail : OptLoopBceAliasEnv
          (opt-loop-bce-alias-unbind (box-get rest) var)]
        (if (= id var)
          tail
          (OptLoopBceAliasCons id root (box tail))))]))

(define (opt-loop-bce-alias-bind
  [env : OptLoopBceAliasEnv]
  [var : i64]
  [root : i64]) : OptLoopBceAliasEnv
  (OptLoopBceAliasCons var root (box (opt-loop-bce-alias-unbind env var))))

(define (opt-loop-bce-alias-resolve-depth
  [env : OptLoopBceAliasEnv]
  [var : i64]
  [depth : i64]) : i64
  (if (> depth 32)
    var
    (match env
      [(OptLoopBceAliasNil) var]
      [(OptLoopBceAliasCons id root rest)
        (if (= id var)
          (if (= root var)
            root
            (opt-loop-bce-alias-resolve-depth env root (+ depth 1)))
          (opt-loop-bce-alias-resolve-depth (box-get rest) var depth))])))

(define (opt-loop-bce-alias-resolve [env : OptLoopBceAliasEnv] [var : i64]) : i64
  (opt-loop-bce-alias-resolve-depth env var 0))

(define (opt-loop-bce-ptr-unbind [env : OptLoopBcePtrEnv] [var : i64]) : OptLoopBcePtrEnv
  (match env
    [(OptLoopBcePtrNil) (OptLoopBcePtrNil)]
    [(OptLoopBcePtrCons id kind rest)
      (let
        [tail : OptLoopBcePtrEnv (opt-loop-bce-ptr-unbind (box-get rest) var)]
        (if (= id var)
          tail
          (OptLoopBcePtrCons id kind (box tail))))]))

(define (opt-loop-bce-ptr-bind
  [env : OptLoopBcePtrEnv]
  [var : i64]
  [kind : OptLoopBcePtrKind]) : OptLoopBcePtrEnv
  (match kind
    [(OptLoopBcePtrUnknown) (opt-loop-bce-ptr-unbind env var)]
    [_ (OptLoopBcePtrCons var kind (box (opt-loop-bce-ptr-unbind env var)))]))

(define (opt-loop-bce-ptr-lookup [env : OptLoopBcePtrEnv] [var : i64]) : OptLoopBcePtrKind
  (match env
    [(OptLoopBcePtrNil) (OptLoopBcePtrUnknown)]
    [(OptLoopBcePtrCons id kind rest)
      (if (= id var)
        kind
        (opt-loop-bce-ptr-lookup (box-get rest) var))]))

(define (opt-loop-bce-length-unbind [env : OptLoopBceLengthEnv] [object : i64]) : OptLoopBceLengthEnv
  (match env
    [(OptLoopBceLengthNil) (OptLoopBceLengthNil)]
    [(OptLoopBceLengthCons id expr rest)
      (let
        [tail : OptLoopBceLengthEnv
          (opt-loop-bce-length-unbind (box-get rest) object)]
        (if (= id object)
          tail
          (OptLoopBceLengthCons id expr (box tail))))]))

(define (opt-loop-bce-length-bind
  [env : OptLoopBceLengthEnv]
  [object : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceLengthEnv
  (match expr
    [(OptLoopBceUnknown) (opt-loop-bce-length-unbind env object)]
    [_
      (OptLoopBceLengthCons
        object
        expr
        (box (opt-loop-bce-length-unbind env object)))]))

(define (opt-loop-bce-length-lookup [env : OptLoopBceLengthEnv] [object : i64]) : OptLoopBceExpr
  (match env
    [(OptLoopBceLengthNil) (OptLoopBceUnknown)]
    [(OptLoopBceLengthCons id expr rest)
      (if (= id object)
        expr
        (opt-loop-bce-length-lookup (box-get rest) object))]))

(define (opt-loop-bce-cmp-unbind [env : OptLoopBceCmpEnv] [var : i64]) : OptLoopBceCmpEnv
  (match env
    [(OptLoopBceCmpNil) (OptLoopBceCmpNil)]
    [(OptLoopBceCmpCons id op lhs rhs ty rest)
      (let
        [tail : OptLoopBceCmpEnv (opt-loop-bce-cmp-unbind (box-get rest) var)]
        (if (= id var)
          tail
          (OptLoopBceCmpCons id op lhs rhs ty (box tail))))]))

(define (opt-loop-bce-cmp-bind
  [env : OptLoopBceCmpEnv]
  [var : i64]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [ty : AstType]) : OptLoopBceCmpEnv
  (OptLoopBceCmpCons var op lhs rhs ty (box (opt-loop-bce-cmp-unbind env var))))

(define (opt-loop-bce-cmp-lookup [env : OptLoopBceCmpEnv] [var : i64]) : OptLoopBceCmpEnv
  (match env
    [(OptLoopBceCmpNil) (OptLoopBceCmpNil)]
    [(OptLoopBceCmpCons id op lhs rhs ty rest)
      (if (= id var)
        (OptLoopBceCmpCons id op lhs rhs ty (box OptLoopBceCmpNil))
        (opt-loop-bce-cmp-lookup (box-get rest) var))]))

(define (opt-loop-bce-guard-unbind [env : OptLoopBceGuardEnv] [label : String]) : OptLoopBceGuardEnv
  (match env
    [(OptLoopBceGuardNil) (OptLoopBceGuardNil)]
    [(OptLoopBceGuardCons id index length rest)
      (let
        [tail : OptLoopBceGuardEnv
          (opt-loop-bce-guard-unbind (box-get rest) label)]
        (if (string-eq id label)
          tail
          (OptLoopBceGuardCons id index length (box tail))))]))

(define (opt-loop-bce-guard-bind
  [env : OptLoopBceGuardEnv]
  [label : String]
  [index : OptLoopBceExpr]
  [length : OptLoopBceExpr]) : OptLoopBceGuardEnv
  (OptLoopBceGuardCons
    label
    index
    length
    (box (opt-loop-bce-guard-unbind env label))))

(define (opt-loop-bce-guard-lookup [env : OptLoopBceGuardEnv] [label : String]) : OptLoopBceGuardEnv
  (match env
    [(OptLoopBceGuardNil) (OptLoopBceGuardNil)]
    [(OptLoopBceGuardCons id index length rest)
      (if (string-eq id label)
        (OptLoopBceGuardCons id index length (box OptLoopBceGuardNil))
        (opt-loop-bce-guard-lookup (box-get rest) label))]))

(define (opt-loop-bce-value-expr
  [sources : I64I64Map]
  [env : OptLoopBceExprEnv]
  [value : CompilerIrValue]) : OptLoopBceExpr
  (match value
    [(IrValueVar id)
      (if (opt-gvn-stable-var? sources id)
        (let
          [found : OptLoopBceExpr (opt-loop-bce-expr-lookup env id)]
          (match found
            [(OptLoopBceUnknown) (OptLoopBceValue value)]
            [_ found]))
        (OptLoopBceValue value))]
    [_ (OptLoopBceValue value)]))

(define (opt-loop-bce-same-width-int-cast?
  [from-ty : AstType]
  [to-ty : AstType]) : bool
  (or
    (and (opt-type-eq from-ty (AstTyI64)) (opt-type-eq to-ty (AstTyU64)))
    (and (opt-type-eq from-ty (AstTyU64)) (opt-type-eq to-ty (AstTyI64)))
    (opt-type-eq from-ty to-ty)))

(define (opt-loop-bce-data-slot? [offset : CompilerIrValue]) : bool
  (match offset
    [(IrValueI64 value) (= value 0)]
    [_ false]))

(define (opt-loop-bce-expr-uses-var? [expr : OptLoopBceExpr] [var : i64]) : bool
  (match expr
    [(OptLoopBceUnknown) false]
    [(OptLoopBceArgc) false]
    [(OptLoopBceValue value) (opt-value-is-var? value var)]
    [(OptLoopBceBin _ lhs rhs _)
      (or
        (opt-loop-bce-expr-uses-var? (box-get lhs) var)
        (opt-loop-bce-expr-uses-var? (box-get rhs) var))]))

(define (opt-loop-bce-guard-invalidate-var
  [guards : OptLoopBceGuardEnv]
  [var : i64]) : OptLoopBceGuardEnv
  (match guards
    [(OptLoopBceGuardNil) (OptLoopBceGuardNil)]
    [(OptLoopBceGuardCons label index length rest)
      (let
        [tail : OptLoopBceGuardEnv
          (opt-loop-bce-guard-invalidate-var (box-get rest) var)]
        (if (or
          (opt-loop-bce-expr-uses-var? index var)
          (opt-loop-bce-expr-uses-var? length var))
          tail
          (OptLoopBceGuardCons label index length (box tail))))]))

(define (opt-range-fact-uses-var? [fact : OptRangeFact] [var : i64]) : bool
  (match fact
    [(OptRangeFactNonnegative _ expr) (opt-loop-bce-expr-uses-var? expr var)]
    [(OptRangeFactLessThan _ lhs rhs)
      (or
        (opt-loop-bce-expr-uses-var? lhs var)
        (opt-loop-bce-expr-uses-var? rhs var))]))

(define (opt-range-facts-invalidate-var [facts : OptRangeFacts] [var : i64]) : OptRangeFacts
  (match facts
    [(OptRangeFactsNil) (OptRangeFactsNil)]
    [(OptRangeFactsCons fact rest)
      (let
        [tail : OptRangeFacts
          (opt-range-facts-invalidate-var (box-get rest) var)]
        (if (opt-range-fact-uses-var? fact var)
          tail
          (OptRangeFactsCons fact (box tail))))]))

(define (opt-loop-bce-state-invalidate-def
  [state : OptLoopBceState]
  [var : i64]) : OptLoopBceState
  (OptLoopBceState
    (opt-loop-bce-expr-unbind (struct-get state exprs) var)
    (opt-loop-bce-alias-unbind (struct-get state aliases) var)
    (opt-loop-bce-ptr-unbind (struct-get state ptrs) var)
    (opt-loop-bce-length-unbind (struct-get state lengths) var)
    (opt-loop-bce-cmp-unbind (struct-get state cmps) var)
    (opt-loop-bce-guard-invalidate-var (struct-get state guards) var)
    (opt-range-facts-invalidate-var (struct-get state ranges) var)))

(define (opt-loop-bce-state-clear-lengths [state : OptLoopBceState]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (struct-get state ptrs)
    (OptLoopBceLengthNil)
    (struct-get state cmps)
    (struct-get state guards)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-expr
  [state : OptLoopBceState]
  [sources : I64I64Map]
  [dst : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    (if (opt-gvn-stable-var? sources dst)
      (OptLoopBceState
        (opt-loop-bce-expr-bind (struct-get invalid exprs) dst expr)
        (struct-get invalid aliases)
        (struct-get invalid ptrs)
        (struct-get invalid lengths)
        (struct-get invalid cmps)
        (struct-get invalid guards)
        (struct-get invalid ranges))
      invalid)))

(define (opt-loop-bce-state-bind-alias
  [state : OptLoopBceState]
  [dst : i64]
  [root : i64]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (opt-loop-bce-alias-bind (struct-get state aliases) dst root)
    (struct-get state ptrs)
    (struct-get state lengths)
    (struct-get state cmps)
    (struct-get state guards)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-ptr
  [state : OptLoopBceState]
  [dst : i64]
  [kind : OptLoopBcePtrKind]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (opt-loop-bce-ptr-bind (struct-get state ptrs) dst kind)
    (struct-get state lengths)
    (struct-get state cmps)
    (struct-get state guards)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-length
  [state : OptLoopBceState]
  [object : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (struct-get state ptrs)
    (opt-loop-bce-length-bind (struct-get state lengths) object expr)
    (struct-get state cmps)
    (struct-get state guards)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-cmp
  [state : OptLoopBceState]
  [sources : I64I64Map]
  [dst : i64]
  [op : CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [ty : AstType]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    (if (opt-gvn-stable-var? sources dst)
      (OptLoopBceState
        (struct-get invalid exprs)
        (struct-get invalid aliases)
        (struct-get invalid ptrs)
        (struct-get invalid lengths)
        (opt-loop-bce-cmp-bind (struct-get invalid cmps) dst op lhs rhs ty)
        (struct-get invalid guards)
        (struct-get invalid ranges))
      invalid)))

(define (opt-loop-bce-state-bind-guard
  [state : OptLoopBceState]
  [label : String]
  [index : OptLoopBceExpr]
  [length : OptLoopBceExpr]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (struct-get state ptrs)
    (struct-get state lengths)
    (struct-get state cmps)
    (opt-loop-bce-guard-bind (struct-get state guards) label index length)
    (struct-get state ranges)))

(define (opt-loop-bce-state-bind-ranges
  [state : OptLoopBceState]
  [ranges : OptRangeFacts]) : OptLoopBceState
  (OptLoopBceState
    (struct-get state exprs)
    (struct-get state aliases)
    (struct-get state ptrs)
    (struct-get state lengths)
    (struct-get state cmps)
    (struct-get state guards)
    ranges))

(define (opt-loop-bce-expr-var [expr : OptLoopBceExpr]) : OptLoopBceMaybeVar
  (match expr
    [(OptLoopBceValue value)
      (match value
        [(IrValueVar var) (OptLoopBceSomeVar var)]
        [_ (OptLoopBceNoVar)])]
    [_ (OptLoopBceNoVar)]))

(define (opt-loop-bce-label-set-other-than
  [labels : OptLabelSet]
  [skip : String]) : OptLoopBceMaybeLabel
  (match labels
    [(OptLabelNil) (OptLoopBceNoLabel)]
    [(OptLabelCons label rest)
      (if (string-eq label skip)
        (opt-loop-bce-label-set-other-than (box-get rest) skip)
        (match (opt-loop-bce-label-set-other-than (box-get rest) skip)
          [(OptLoopBceNoLabel) (OptLoopBceSomeLabel label)]
          [(OptLoopBceSomeLabel _) (OptLoopBceNoLabel)]))]))

(define (opt-loop-bce-defines-var? [instr : CompilerIrInstr] [var : i64]) : bool
  (= (opt-gvn-instr-dst instr) var))

(define (opt-loop-bce-index-init-step
  [current : OptLoopBceIndexDef]
  [instr : CompilerIrInstr]
  [index-var : i64]) : OptLoopBceIndexDef
  (if (opt-loop-bce-defines-var? instr index-var)
    (match instr
      [(IrInstrMov dst src _)
        (if (= dst index-var)
          (match src
            [(IrValueI64 value)
              (if (= value 0)
                (OptLoopBceIndexZero)
                (OptLoopBceIndexOther))]
            [_ (OptLoopBceIndexOther)])
          (OptLoopBceIndexOther))]
      [_ (OptLoopBceIndexOther)])
    current))

(define (opt-loop-bce-index-init-instrs
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [index-var : i64]
  [current : OptLoopBceIndexDef]) : OptLoopBceIndexDef
  (if (>= index count)
    current
    (opt-loop-bce-index-init-instrs
      slots
      (+ index 1)
      count
      index-var
      (opt-loop-bce-index-init-step current (array-ref slots index) index-var))))

(define (opt-loop-bce-block-last-def-zero?
  [block : CompilerIrBlock]
  [index-var : i64]) : bool
  (match block
    [(IrBlock _ instrs)
      (match (opt-loop-bce-index-init-instrs
        (struct-get instrs slots)
        0
        (struct-get instrs len)
        index-var
        (OptLoopBceIndexNoDef))
        [(OptLoopBceIndexZero) true]
        [_ false])]))

(define (opt-loop-bce-plus-one-add?
  [instr : CompilerIrInstr]
  [dst : i64]
  [index-var : i64]) : bool
  (match instr
    [(IrInstrBinOp out op lhs rhs ty)
      (and
        (= out dst)
        (opt-binop-eq op (IrBinAdd))
        (opt-type-eq ty (AstTyI64))
        (or
          (and
            (opt-value-eq lhs (IrValueVar index-var))
            (opt-value-eq rhs (IrValueI64 1)))
          (and
            (opt-value-eq lhs (IrValueI64 1))
            (opt-value-eq rhs (IrValueVar index-var)))))]
    [_ false]))

(define (opt-loop-bce-i64-list-remove [items : OptI64List] [value : i64]) : OptI64List
  (match items
    [(OptI64Nil) (OptI64Nil)]
    [(OptI64Cons head rest)
      (let
        [tail : OptI64List (opt-loop-bce-i64-list-remove (box-get rest) value)]
        (if (= head value)
          tail
          (OptI64Cons head (box tail))))]))

(define (opt-loop-bce-index-increment-step
  [current : OptLoopBceIndexDef]
  [plus-one : OptI64List]
  [instr : CompilerIrInstr]
  [index-var : i64]) : OptLoopBceIndexDef
  (if (opt-loop-bce-defines-var? instr index-var)
    (match instr
      [(IrInstrMov dst src _)
        (if (= dst index-var)
          (match src
            [(IrValueVar tmp)
              (if (opt-i64-list-contains? plus-one tmp)
                (OptLoopBceIndexIncrement)
                (OptLoopBceIndexOther))]
            [_ (OptLoopBceIndexOther)])
          (OptLoopBceIndexOther))]
      [(IrInstrBinOp dst _ _ _ _)
        (if (and
          (= dst index-var)
          (opt-loop-bce-plus-one-add? instr dst index-var))
          (OptLoopBceIndexIncrement)
          (OptLoopBceIndexOther))]
      [_ (OptLoopBceIndexOther)])
    current))

(define (opt-loop-bce-plus-one-update
  [plus-one : OptI64List]
  [instr : CompilerIrInstr]
  [index-var : i64]) : OptI64List
  (let
    [dst : i64 (opt-gvn-instr-dst instr)]
    [removed : OptI64List
      (if (= dst (- 0 1))
        plus-one
        (opt-loop-bce-i64-list-remove plus-one dst))]
    (if (and
      (not (= dst (- 0 1)))
      (opt-loop-bce-plus-one-add? instr dst index-var))
      (opt-i64-list-add removed dst)
      removed)))

(define (opt-loop-bce-index-increment-instrs
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [index-var : i64]
  [current : OptLoopBceIndexDef]
  [plus-one : OptI64List]) : OptLoopBceIndexDef
  (if (>= index count)
    current
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [next : OptLoopBceIndexDef
        (opt-loop-bce-index-increment-step current plus-one instr index-var)]
      [next-plus : OptI64List
        (opt-loop-bce-plus-one-update plus-one instr index-var)]
      (opt-loop-bce-index-increment-instrs
        slots
        (+ index 1)
        count
        index-var
        next
        next-plus))))

(define (opt-loop-bce-block-last-def-increment?
  [block : CompilerIrBlock]
  [index-var : i64]) : bool
  (match block
    [(IrBlock _ instrs)
      (match (opt-loop-bce-index-increment-instrs
        (struct-get instrs slots)
        0
        (struct-get instrs len)
        index-var
        (OptLoopBceIndexNoDef)
        (OptI64Nil))
        [(OptLoopBceIndexIncrement) true]
        [_ false])]))

(define (opt-loop-bce-block-jumps-to?
  [block : CompilerIrBlock]
  [target : String]) : bool
  (match block
    [(IrBlock _ instrs)
      (let
        [count : i64 (struct-get instrs len)]
        (if (= count 0)
          false
          (match (compiler-ir-instr-seq-ref instrs (- count 1))
            [(IrInstrJump label) (string-eq label target)]
            [_ false])))]))

(define (opt-loop-bce-header-edge-shape
  [blocks : CompilerIrBlockList]
  [preds : OptLabelSet]
  [header-label : String]
  [index-var : i64]
  [seen-init : bool]
  [seen-latch : bool]) : OptLoopBceHeaderEdges
  (match preds
    [(OptLabelNil) (OptLoopBceHeaderEdges true seen-init seen-latch)]
    [(OptLabelCons pred rest)
      (match (opt-cfg-find-block blocks pred)
        [(OptSomeBlock block)
          (let
            [init? : bool (opt-loop-bce-block-last-def-zero? block index-var)]
            [latch? : bool
              (and
                (opt-loop-bce-block-last-def-increment? block index-var)
                (opt-loop-bce-block-jumps-to? block header-label))]
            (if (or init? latch?)
              (opt-loop-bce-header-edge-shape
                blocks
                (box-get rest)
                header-label
                index-var
                (or seen-init init?)
                (or seen-latch latch?))
              (OptLoopBceHeaderEdges false seen-init seen-latch)))]
        [(OptNoBlock) (OptLoopBceHeaderEdges false seen-init seen-latch)])]))

(define (opt-loop-bce-guard-nonnegative?
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [header-label : String]
  [body-label : String]
  [index-expr : OptLoopBceExpr]) : bool
  (match (opt-loop-bce-expr-var index-expr)
    [(OptLoopBceNoVar) false]
    [(OptLoopBceSomeVar index-var)
      (let
        [body-preds : OptLabelSet (opt-cfg-index-predecessors index body-label)]
        [header-preds : OptLabelSet
          (opt-cfg-index-predecessors index header-label)]
        (if (and
          (= (opt-label-count body-preds) 1)
          (opt-label-contains body-preds header-label)
          (= (opt-label-count header-preds) 2))
          (if (opt-label-contains header-preds body-label)
            (match (opt-loop-bce-label-set-other-than header-preds body-label)
              [(OptLoopBceSomeLabel preheader-label)
                (match (opt-cfg-find-block blocks preheader-label)
                  [(OptSomeBlock preheader)
                    (match (opt-cfg-find-block blocks body-label)
                      [(OptSomeBlock body)
                        (and
                          (opt-loop-bce-block-last-def-zero?
                            preheader
                            index-var)
                          (opt-loop-bce-block-last-def-increment?
                            body
                            index-var)
                          (opt-loop-bce-block-jumps-to? body header-label))]
                      [(OptNoBlock) false])]
                  [(OptNoBlock) false])]
              [(OptLoopBceNoLabel) false])
            (match (opt-loop-bce-header-edge-shape
              blocks
              header-preds
              header-label
              index-var
              false
              false)
              [(OptLoopBceHeaderEdges ok seen-init seen-latch)
                (and ok seen-init seen-latch)]))
          false))]))

(define (opt-loop-bce-branch-state
  [state : OptLoopBceState]
  [sources : I64I64Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [block-label : String]
  [cond : CompilerIrValue]
  [true-label : String]
  [false-label : String]) : OptLoopBceState
  (match cond
    [(IrValueVar cond-var)
      (match (opt-loop-bce-cmp-lookup (struct-get state cmps) cond-var)
        [(OptLoopBceCmpCons _ op lhs rhs ty _)
          (let
            [marker : OptLoopBceExpr (OptLoopBceValue (IrValueI64 (- 0 1)))]
            [operand-ty : AstType
              (opt-range-compare-operand-type types lhs rhs ty)]
            [true-ranges : OptRangeFacts
              (opt-range-add-edge-facts
                (struct-get state ranges)
                sources
                types
                true-label
                op
                lhs
                rhs
                ty)]
            [false-ranges : OptRangeFacts
              (opt-range-add-edge-facts
                true-ranges
                sources
                types
                false-label
                (opt-divrem-invert-compare op)
                lhs
                rhs
                ty)]
            [range-state : OptLoopBceState
              (opt-loop-bce-state-bind-ranges state false-ranges)]
            [range-nonnegative : bool
              (or
                (opt-range-nonnegative-contains?
                  (struct-get range-state ranges)
                  block-label
                  lhs)
                (match (opt-loop-bce-guard-lookup
                  (struct-get state guards)
                  block-label)
                  [(OptLoopBceGuardCons _ found found-marker _)
                    (and
                      (opt-loop-bce-expr-eq found lhs)
                      (opt-loop-bce-expr-eq found-marker marker))]
                  [(OptLoopBceGuardNil) false]))]
            [loop-nonnegative : bool
              (opt-loop-bce-guard-nonnegative?
                blocks
                index
                block-label
                true-label
                lhs)]
            (match op
              [(IrBinGe)
                (match (opt-range-expr-i64 rhs operand-ty)
                  [(OptSomeI64 value)
                    (if (= value 0)
                      (opt-loop-bce-state-bind-guard
                        range-state
                        true-label
                        lhs
                        marker)
                      range-state)]
                  [(OptNoI64) range-state])]
              [(IrBinGt)
                (match (opt-range-expr-i64 rhs operand-ty)
                  [(OptSomeI64 value)
                    (if (and
                      (opt-signed-integer-type? operand-ty)
                      (= value (- 0 1)))
                      (opt-loop-bce-state-bind-guard
                        range-state
                        true-label
                        lhs
                        marker)
                      range-state)]
                  [(OptNoI64) range-state])]
              [(IrBinLt)
                (if (or range-nonnegative loop-nonnegative)
                  (opt-loop-bce-state-bind-guard range-state true-label lhs rhs)
                  range-state)]
              [_ range-state]))]
        [(OptLoopBceCmpNil) state])]
    [_ state]))

(define (opt-loop-bce-update-gep
  [state : OptLoopBceState]
  [sources : I64I64Map]
  [dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [ty : AstType]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    [aliases : OptLoopBceAliasEnv (struct-get invalid aliases)]
    [ptrs : OptLoopBcePtrEnv (struct-get invalid ptrs)]
    [base-kind : OptLoopBcePtrKind
      (match base
        [(IrValueVar base-var) (opt-loop-bce-ptr-lookup ptrs base-var)]
        [_ (OptLoopBcePtrUnknown)])]
    (match base
      [(IrValueVar base-var)
        (let
          [object : i64 (opt-loop-bce-alias-resolve aliases base-var)]
          [kind : OptLoopBcePtrKind
            (if (opt-bounds-object-length-slot? offset ty)
              (OptLoopBceLengthSlot object)
              (if (opt-loop-bce-data-slot? offset)
                (OptLoopBceDataSlot object)
                (match base-kind
                  [(OptLoopBceDataBuffer buffer-object)
                    (OptLoopBceDataElement buffer-object)]
                  [_ (OptLoopBcePtrUnknown)])))]
          (opt-loop-bce-state-bind-ptr
            (opt-loop-bce-state-bind-expr
              invalid
              sources
              dst
              (OptLoopBceUnknown))
            dst
            kind))]
      [_ invalid])))

(define (opt-loop-bce-update-load
  [state : OptLoopBceState]
  [sources : I64I64Map]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    [ptr-kind : OptLoopBcePtrKind
      (match src
        [(IrValueVar ptr-var)
          (opt-loop-bce-ptr-lookup (struct-get invalid ptrs) ptr-var)]
        [_ (OptLoopBcePtrUnknown)])]
    (match ptr-kind
      [(OptLoopBceLengthSlot object)
        (let
          [known : OptLoopBceExpr
            (opt-loop-bce-length-lookup (struct-get invalid lengths) object)]
          (match known
            [(OptLoopBceUnknown)
              (if (opt-gvn-stable-var? sources dst)
                (let
                  [loaded : OptLoopBceExpr (OptLoopBceValue (IrValueVar dst))]
                  (opt-loop-bce-state-bind-length
                    (opt-loop-bce-state-bind-expr invalid sources dst loaded)
                    object
                    loaded))
                invalid)]
            [_ (opt-loop-bce-state-bind-expr invalid sources dst known)]))]
      [(OptLoopBceDataSlot object)
        (opt-loop-bce-state-bind-ptr
          (opt-loop-bce-state-bind-expr invalid sources dst (OptLoopBceUnknown))
          dst
          (OptLoopBceDataBuffer object))]
      [_
        (match src
          [(IrValueGlobal _)
            (if (opt-type-eq ty (AstTyI64))
              (opt-loop-bce-state-bind-expr
                invalid
                sources
                dst
                (OptLoopBceValue src))
              invalid)]
          [_ invalid])])))

(define (opt-loop-bce-update-storeptr
  [state : OptLoopBceState]
  [sources : I64I64Map]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]) : OptLoopBceState
  (let
    [kind : OptLoopBcePtrKind
      (match ptr
        [(IrValueVar ptr-var)
          (opt-loop-bce-ptr-lookup (struct-get state ptrs) ptr-var)]
        [_ (OptLoopBcePtrUnknown)])]
    (match kind
      [(OptLoopBceLengthSlot object)
        (opt-loop-bce-state-bind-length
          state
          object
          (opt-loop-bce-value-expr sources (struct-get state exprs) value))]
      [(OptLoopBceDataSlot _) state]
      [(OptLoopBceDataBuffer _) state]
      [(OptLoopBceDataElement _) state]
      [(OptLoopBcePtrUnknown) (opt-loop-bce-state-clear-lengths state)])))

(define (opt-loop-bce-update-call
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : I64I64Map]
  [dst : i64]
  [name : String]
  [args : CompilerIrCallArgs]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    [memory : OptLoopBceState
      (if (opt-loop-bce-summary-length-clean? summaries name)
        invalid
        (opt-loop-bce-state-clear-lengths invalid))]
    (if (and
      (= (compiler-ir-call-args-count args) 0)
      (opt-loop-bce-summary-argc-return? summaries name))
      (opt-loop-bce-state-bind-expr memory sources dst (OptLoopBceArgc))
      memory)))

(define (opt-loop-bce-update-instr
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : I64I64Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [block-label : String]
  [instr : CompilerIrInstr]) : OptLoopBceState
  (match instr
    [(IrInstrMov dst src _)
      (let
        [expr-state : OptLoopBceState
          (opt-loop-bce-state-bind-expr
            state
            sources
            dst
            (opt-loop-bce-value-expr sources (struct-get state exprs) src))]
        (match src
          [(IrValueVar src-var)
            (opt-loop-bce-state-bind-alias
              expr-state
              dst
              (opt-loop-bce-alias-resolve (struct-get state aliases) src-var))]
          [_ expr-state]))]
    [(IrInstrAlloc dst _)
      (opt-loop-bce-state-bind-alias
        (opt-loop-bce-state-invalidate-def state dst)
        dst
        dst)]
    [(IrInstrAddrOf dst _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrGep dst base offset ty)
      (opt-loop-bce-update-gep state sources dst base offset ty)]
    [(IrInstrLoad dst src ty)
      (opt-loop-bce-update-load state sources dst src ty)]
    [(IrInstrCast dst src from-ty to-ty)
      (opt-loop-bce-state-bind-expr
        state
        sources
        dst
        (if (opt-loop-bce-same-width-int-cast? from-ty to-ty)
          (opt-loop-bce-value-expr sources (struct-get state exprs) src)
          (OptLoopBceUnknown)))]
    [(IrInstrBitcast dst _ _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrBinOp dst op lhs rhs ty)
      (if (and (opt-type-eq ty (AstTyBool)) (opt-divrem-compare-op? op))
        (let
          [operand-ty : AstType (opt-range-compare-value-type types lhs rhs ty)]
          (opt-loop-bce-state-bind-cmp
            state
            sources
            dst
            op
            (opt-loop-bce-value-expr sources (struct-get state exprs) lhs)
            (opt-loop-bce-value-expr sources (struct-get state exprs) rhs)
            operand-ty))
        (opt-loop-bce-state-bind-expr
          state
          sources
          dst
          (OptLoopBceBin
            op
            (box (opt-loop-bce-value-expr sources (struct-get state exprs) lhs))
            (box (opt-loop-bce-value-expr sources (struct-get state exprs) rhs))
            ty)))]
    [(IrInstrUnOp dst _ _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrLaneId dst _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrSplat dst _ _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(IrInstrVectorReduce dst _ _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(IrInstrMaskBinOp dst _ _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrMaskNot dst _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrMaskReduce dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(IrInstrVectorLoad dst _ _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (opt-loop-bce-state-invalidate-def state dst)])]
    [(IrInstrTailMask dst _ _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrEntryArgc dst)
      (opt-loop-bce-state-bind-expr state sources dst (OptLoopBceArgc))]
    [(IrInstrEntryArgv dst) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrEntryEnvp dst) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrCpuId dst _ _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrXgetbv dst _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrSyscall dst _)
      (opt-loop-bce-state-clear-lengths
        (opt-loop-bce-state-invalidate-def state dst))]
    [(IrInstrCall dst name args _)
      (opt-loop-bce-update-call state summaries sources dst name args)]
    [(IrInstrCallIndirect dst _ _ _)
      (opt-loop-bce-state-clear-lengths
        (opt-loop-bce-state-invalidate-def state dst))]
    [(IrInstrCallIndirectC dst _ _ _)
      (opt-loop-bce-state-clear-lengths
        (opt-loop-bce-state-invalidate-def state dst))]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload _ _ _ _)
          (opt-loop-bce-state-clear-lengths state)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload _ _ _ _)
          (opt-loop-bce-state-clear-lengths state)])]
    [(IrInstrStorePtr ptr value _)
      (opt-loop-bce-update-storeptr state sources ptr value)]
    [(IrInstrCopyBytes _ _ _) (opt-loop-bce-state-clear-lengths state)]
    [(IrInstrBoundsCheck _ _ _) state]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload _ _ _ _ _)
          (opt-loop-bce-state-clear-lengths state)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload _ _ _ _ _ _)
          (opt-loop-bce-state-clear-lengths state)])]
    [(IrInstrStore _ _ _) state]
    [(IrInstrBranch cond true-label false-label)
      (opt-loop-bce-branch-state
        state
        sources
        types
        blocks
        index
        block-label
        cond
        true-label
        false-label)]
    [(IrInstrPhi dst _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrPack dst _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrWord dst _ _ _) (opt-loop-bce-state-invalidate-def state dst)]
    [(IrInstrTailCall _ _ _) (opt-loop-bce-state-clear-lengths state)]
    [(IrInstrTailCallIndirect _ _ _) (opt-loop-bce-state-clear-lengths state)]
    [(IrInstrJump _) state]
    [(IrInstrReturn _) state]))

(define (opt-loop-bce-length-expr-known?
  [lengths : OptLoopBceLengthEnv]
  [expr : OptLoopBceExpr]) : bool
  (match lengths
    [(OptLoopBceLengthNil) false]
    [(OptLoopBceLengthCons _ found rest)
      (if (opt-loop-bce-expr-eq found expr)
        true
        (opt-loop-bce-length-expr-known? (box-get rest) expr))]))

(define (opt-loop-bce-range-can-remove?
  [state : OptLoopBceState]
  [sources : I64I64Map]
  [block-label : String]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : bool
  (let
    [index-expr : OptLoopBceExpr
      (opt-loop-bce-value-expr sources (struct-get state exprs) index)]
    [length-expr : OptLoopBceExpr
      (opt-loop-bce-value-expr sources (struct-get state exprs) length)]
    [ranges : OptRangeFacts (struct-get state ranges)]
    (and
      (opt-range-nonnegative-contains? ranges block-label index-expr)
      (opt-range-less-than-contains? ranges block-label index-expr length-expr))))

(define (opt-loop-bce-can-remove?
  [state : OptLoopBceState]
  [sources : I64I64Map]
  [block-label : String]
  [index : CompilerIrValue]
  [length : CompilerIrValue]) : bool
  (let
    [length-expr : OptLoopBceExpr
      (opt-loop-bce-value-expr sources (struct-get state exprs) length)]
    (or
      (opt-loop-bce-range-can-remove? state sources block-label index length)
      (and
        (opt-loop-bce-length-expr-known? (struct-get state lengths) length-expr)
        (match (opt-loop-bce-guard-lookup (struct-get state guards) block-label)
          [(OptLoopBceGuardCons _ guard-index guard-length _)
            (and
              (opt-loop-bce-expr-eq
                guard-index
                (opt-loop-bce-value-expr sources (struct-get state exprs) index))
              (opt-loop-bce-expr-eq guard-length length-expr))]
          [(OptLoopBceGuardNil) false])))))

(define (opt-loop-bce-rewrite-instrs
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : I64I64Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [block-label : String]
  [instrs : CompilerIrInstrList]) : OptLoopBceRewrite
  (match instrs
    [(IrInstrNil) (OptLoopBceRewrite state (IrInstrNil))]
    [(IrInstrCons instr rest)
      (let
        [drop? : bool
          (match instr
            [(IrInstrBoundsCheck idx len _)
              (opt-loop-bce-can-remove? state sources block-label idx len)]
            [_ false])]
        (if drop?
          (opt-loop-bce-rewrite-instrs
            state
            summaries
            sources
            types
            blocks
            index
            block-label
            (box-get rest))
          (let
            [next-state : OptLoopBceState
              (opt-loop-bce-update-instr
                state
                summaries
                sources
                types
                blocks
                index
                block-label
                instr)]
            (match (opt-loop-bce-rewrite-instrs
              next-state
              summaries
              sources
              types
              blocks
              index
              block-label
              (box-get rest))
              [(OptLoopBceRewrite out-state out-rest)
                (OptLoopBceRewrite
                  out-state
                  (compiler-ir-instr-cons instr out-rest))]))))]))

(define (opt-loop-bce-rewrite-block
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : I64I64Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [index : OptCfgIndex]
  [block : CompilerIrBlock]) : OptLoopBceBlockRewrite
  (match block
    [(IrBlock label instrs)
      (match (opt-loop-bce-rewrite-instrs
        state
        summaries
        sources
        types
        blocks
        index
        label
        (compiler-ir-instr-seq-to-list instrs))
        [(OptLoopBceRewrite out-state out-instrs)
          (OptLoopBceBlockRewrite
            out-state
            (compiler-ir-block label out-instrs))])]))

(define (opt-loop-bce-length-store-shape-instrs
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [ptrs : OptI64List]) : bool
  (if (>= index count)
    false
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      [removed : OptI64List
        (if (= dst (- 0 1))
          ptrs
          (opt-loop-bce-i64-list-remove ptrs dst))]
      [next-ptrs : OptI64List
        (match instr
          [(IrInstrGep gep-dst _ offset ty)
            (if (opt-bounds-object-length-slot? offset ty)
              (opt-i64-list-add removed gep-dst)
              removed)]
          [_ removed])]
      (match instr
        [(IrInstrStorePtr ptr _ _)
          (match ptr
            [(IrValueVar ptr-var)
              (if (opt-i64-list-contains? ptrs ptr-var)
                true
                (opt-loop-bce-length-store-shape-instrs
                  slots
                  (+ index 1)
                  count
                  next-ptrs))]
            [_
              (opt-loop-bce-length-store-shape-instrs
                slots
                (+ index 1)
                count
                next-ptrs)])]
        [_
          (opt-loop-bce-length-store-shape-instrs
            slots
            (+ index 1)
            count
            next-ptrs)]))))

(define (opt-loop-bce-length-store-shape-blocks
  [blocks : CompilerIrBlockList]
  [ptrs : OptI64List]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-loop-bce-length-store-shape-instrs
            (struct-get instrs slots)
            0
            (struct-get instrs len)
            ptrs)
            true
            (opt-loop-bce-length-store-shape-blocks (box-get rest) ptrs))])]
    [(IrBlockArray seq)
      (opt-loop-bce-length-store-shape-blocks
        (compiler-ir-block-seq-to-list seq)
        ptrs)]))

(define (opt-loop-bce-length-load-shape-instrs
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [ptrs : OptI64List]) : bool
  (if (>= index count)
    false
    (let
      [instr : CompilerIrInstr (array-ref slots index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      [removed : OptI64List
        (if (= dst (- 0 1))
          ptrs
          (opt-loop-bce-i64-list-remove ptrs dst))]
      [next-ptrs : OptI64List
        (match instr
          [(IrInstrGep gep-dst _ offset ty)
            (if (opt-bounds-object-length-slot? offset ty)
              (opt-i64-list-add removed gep-dst)
              removed)]
          [_ removed])]
      (match instr
        [(IrInstrLoad _ ptr _)
          (match ptr
            [(IrValueVar ptr-var)
              (if (opt-i64-list-contains? ptrs ptr-var)
                true
                (opt-loop-bce-length-load-shape-instrs
                  slots
                  (+ index 1)
                  count
                  next-ptrs))]
            [_
              (opt-loop-bce-length-load-shape-instrs
                slots
                (+ index 1)
                count
                next-ptrs)])]
        [_
          (opt-loop-bce-length-load-shape-instrs
            slots
            (+ index 1)
            count
            next-ptrs)]))))

(define (opt-loop-bce-length-load-shape-blocks
  [blocks : CompilerIrBlockList]
  [ptrs : OptI64List]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-loop-bce-length-load-shape-instrs
            (struct-get instrs slots)
            0
            (struct-get instrs len)
            ptrs)
            true
            (opt-loop-bce-length-load-shape-blocks (box-get rest) ptrs))])]
    [(IrBlockArray seq)
      (opt-loop-bce-length-load-shape-blocks
        (compiler-ir-block-seq-to-list seq)
        ptrs)]))

(define (opt-loop-bce-string-byte-shape-instrs
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (array-ref slots index)
      [(IrInstrGep _ _ _ ty)
        (if (opt-type-eq ty (AstTyChar))
          true
          (opt-loop-bce-string-byte-shape-instrs slots (+ index 1) count))]
      [_ (opt-loop-bce-string-byte-shape-instrs slots (+ index 1) count)])))

(define (opt-loop-bce-string-byte-shape-blocks [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-loop-bce-string-byte-shape-instrs
            (struct-get instrs slots)
            0
            (struct-get instrs len))
            true
            (opt-loop-bce-string-byte-shape-blocks (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-loop-bce-string-byte-shape-blocks
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-argc-call-shape-instrs
  [summaries : OptLoopBceSummaries]
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (array-ref slots index)
      [(IrInstrCall _ name args _)
        (if (and
          (= (compiler-ir-call-args-count args) 0)
          (opt-loop-bce-summary-argc-return? summaries name))
          true
          (opt-loop-bce-argc-call-shape-instrs
            summaries
            slots
            (+ index 1)
            count))]
      [_
        (opt-loop-bce-argc-call-shape-instrs summaries slots (+ index 1) count)])))

(define (opt-loop-bce-argc-call-shape-blocks
  [summaries : OptLoopBceSummaries]
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-loop-bce-argc-call-shape-instrs
            summaries
            (struct-get instrs slots)
            0
            (struct-get instrs len))
            true
            (opt-loop-bce-argc-call-shape-blocks summaries (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-loop-bce-argc-call-shape-blocks
        summaries
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-compare-shape-instrs
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (array-ref slots index)
      [(IrInstrBinOp _ op _ _ ty)
        (if (and
          (opt-type-eq ty (AstTyBool))
          (match op
            [(IrBinLt) true]
            [(IrBinGt) true]
            [_ false]))
          true
          (opt-loop-bce-compare-shape-instrs slots (+ index 1) count))]
      [_ (opt-loop-bce-compare-shape-instrs slots (+ index 1) count)])))

(define (opt-loop-bce-compare-shape-blocks [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-loop-bce-compare-shape-instrs
            (struct-get instrs slots)
            0
            (struct-get instrs len))
            true
            (opt-loop-bce-compare-shape-blocks (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-loop-bce-compare-shape-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-eligible-blocks?
  [summaries : OptLoopBceSummaries]
  [blocks : CompilerIrBlockList]) : bool
  (and
    (<= (compiler-ir-block-list-count blocks) 64)
    (> (opt-count-bounds-blocks blocks) 0)
    (or
      (and
        (opt-loop-bce-argc-call-shape-blocks summaries blocks)
        (opt-loop-bce-length-store-shape-blocks blocks (OptI64Nil)))
      (and
        (opt-loop-bce-length-load-shape-blocks blocks (OptI64Nil))
        (opt-loop-bce-string-byte-shape-blocks blocks))
      (and
        (<= (compiler-ir-block-list-count blocks) 8)
        (opt-loop-bce-compare-shape-blocks blocks)))))

(define (opt-loop-bce-initial-state) : OptLoopBceState
  (OptLoopBceState
    (OptLoopBceExprNil)
    (OptLoopBceAliasNil)
    (OptLoopBcePtrNil)
    (OptLoopBceLengthNil)
    (OptLoopBceCmpNil)
    (OptLoopBceGuardNil)
    (OptRangeFactsNil)))

(define (opt-loop-bce-block-results-fill-empty!
  [out : (Array OptLoopBceBlockResult)]
  [index : i64]) : unit
  (if (>= index (array-length out))
    unit
    (begin
      (array-set! out index (OptLoopBceNoBlock))
      (opt-loop-bce-block-results-fill-empty! out (+ index 1)))))

(define (opt-loop-bce-materialize-blocks
  [doms : OptDomInfo]
  [out : (Array OptLoopBceBlockResult)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label _)
          (let
            [block-id : i64 (opt-global-block-id doms label)]
            [material : CompilerIrBlock
              (if (and (>= block-id 0) (< block-id (array-length out)))
                (match (array-ref out block-id)
                  [(OptLoopBceSomeBlock rewritten) rewritten]
                  [(OptLoopBceNoBlock) block])
                block)]
            (compiler-ir-block-cons
              material
              (opt-loop-bce-materialize-blocks doms out (box-get rest))))])]
    [(IrBlockArray seq)
      (opt-loop-bce-materialize-blocks
        doms
        out
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-rewrite-id
  [summaries : OptLoopBceSummaries]
  [sources : I64I64Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [cfg-index : OptCfgIndex]
  [children : OptCfgCsr]
  [out : (Array OptLoopBceBlockResult)]
  [id : i64]
  [state : OptLoopBceState]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count cfg-index)]
    (if (and (>= id 0) (< id count))
      (let
        [label : String (array-ref (struct-get cfg-index labels) id)]
        (match (opt-cfg-find-block blocks label)
          [(OptNoBlock) unit]
          [(OptSomeBlock block)
            (match (opt-loop-bce-rewrite-block
              state
              summaries
              sources
              types
              blocks
              cfg-index
              block)
              [(OptLoopBceBlockRewrite next-state rewritten)
                (begin
                  (array-set! out id (OptLoopBceSomeBlock rewritten))
                  (opt-loop-bce-rewrite-children
                    summaries
                    sources
                    types
                    blocks
                    cfg-index
                    children
                    out
                    id
                    next-state))])]))
      unit)))

(define (opt-loop-bce-rewrite-children
  [summaries : OptLoopBceSummaries]
  [sources : I64I64Map]
  [types : OptSsaVarTypes]
  [blocks : CompilerIrBlockList]
  [cfg-index : OptCfgIndex]
  [children : OptCfgCsr]
  [out : (Array OptLoopBceBlockResult)]
  [parent-id : i64]
  [state : OptLoopBceState]) : unit
  (let
    [offsets : (Array i64) (struct-get children offsets)]
    [edges : (Array i64) (struct-get children edges)]
    [labels : (Array String) (struct-get cfg-index labels)]
    [parent-label : String (array-ref labels parent-id)]
    [edge : i64 (array-ref offsets parent-id)]
    [end : i64 (array-ref offsets (+ parent-id 1))]
    (begin
      (while (< edge end)
        (let
          [child-id : i64 (array-ref edges edge)]
          [child-label : String (array-ref labels child-id)]
          [child-state : OptLoopBceState
            (opt-loop-bce-state-propagate-guard state parent-label child-label)]
          (begin
            (opt-loop-bce-rewrite-id
              summaries
              sources
              types
              blocks
              cfg-index
              children
              out
              child-id
              child-state)
            (set! edge (+ edge 1)))))
      unit)))

(define (opt-loop-bce-blocks
  [summaries : OptLoopBceSummaries]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (if (or
    (not (struct-get summaries enabled))
    (not (opt-loop-bce-eligible-blocks? summaries blocks)))
    blocks
    (let
      [context : OptCfgContext (opt-cfg-context-build blocks)]
      [doms : OptDomInfo (struct-get context doms)]
      [cfg-index : OptCfgIndex (struct-get context index)]
      [count : i64 (opt-cfg-index-block-count cfg-index)]
      [children : OptCfgCsr (opt-gvn-dom-children doms)]
      [out : (Array OptLoopBceBlockResult)
        (make-array OptLoopBceBlockResult count)]
      [sources : I64I64Map
        (opt-gvn-sources-blocks
          blocks
          (opt-gvn-sources-params params (i64-i64-map-with-capacity 64)))]
      [ssa-facts : OptSsaFacts (opt-ssa-facts-from-function params blocks)]
      [types : OptSsaVarTypes
        (match ssa-facts
          [(OptSsaFacts _ _ fact-types) fact-types])]
      (begin
        (opt-loop-bce-block-results-fill-empty! out 0)
        (match (opt-cfg-index-id cfg-index (struct-get context entry-label))
          [(OptSomeI64 entry-id)
            (if (and
              (>= entry-id 0)
              (array-ref (struct-get cfg-index reachable) entry-id))
              (opt-loop-bce-rewrite-id
                summaries
                sources
                types
                blocks
                cfg-index
                children
                out
                entry-id
                (opt-loop-bce-initial-state))
              unit)]
          [(OptNoI64) unit])
        (opt-loop-bce-materialize-blocks doms out blocks)))))

(define (opt-loop-bce-state-propagate-guard
  [state : OptLoopBceState]
  [parent-label : String]
  [child-label : String]) : OptLoopBceState
  (let
    [range-state : OptLoopBceState
      (opt-loop-bce-state-bind-ranges
        state
        (opt-range-facts-propagate-label
          (struct-get state ranges)
          parent-label
          child-label))]
    (match (opt-loop-bce-guard-lookup
      (struct-get range-state guards)
      child-label)
      [(OptLoopBceGuardCons _ _ _ _) range-state]
      [(OptLoopBceGuardNil)
        (match (opt-loop-bce-guard-lookup
          (struct-get range-state guards)
          parent-label)
          [(OptLoopBceGuardCons _ index length _)
            (opt-loop-bce-state-bind-guard range-state child-label index length)]
          [(OptLoopBceGuardNil) range-state])])))

(define (opt-loop-bce-function
  [summaries : OptLoopBceSummaries]
  [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret frame blocks)
      (IrFunction
        name
        params
        ret
        frame
        (opt-loop-bce-blocks summaries params blocks))]))

(define (optimize-block [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      ;; Fold scalar constants, reduce algebraic identities, eliminate repeated
      ;; pure expressions, propagate the resulting copies, then remove duplicate
      ;; proven bounds checks; function-level DCE drops dead copies.
      ;; Fold runs ONCE: it is a single forward pass that binds every folded
      ;; result into its env, so over the block it already reaches a fixpoint --
      ;; a second `opt-fold-instrs` over the result only re-walked and rebuilt the
      ;; list without changing it (byte-identical output, ~0.9% of self-compile).
      (compiler-ir-block
        label
        (opt-bounds-instrs
          (OptBoundsNil)
          (opt-copy-instrs
            (OptCopyNil)
            (opt-load-cse-instrs
              (OptLoadCseState (opt-alias-empty) (OptLoadNil))
              (opt-cse-instrs
                (OptExprNil)
                (opt-strength-instrs
                  (OptConstNil)
                  (opt-fold-instr-seq (OptConstNil) instrs)))))))]))

(define (optimize-block-fast [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-copy-instr-seq (OptCopyNil) instrs))]))

(define (optimize-block-list [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (optimize-block block)
        (optimize-block-list (box-get rest)))]
    [(IrBlockArray seq)
      (optimize-block-list (compiler-ir-block-seq-to-list seq))]))

(define (optimize-block-list-fast [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (optimize-block-fast block)
        (optimize-block-list-fast (box-get rest)))]
    [(IrBlockArray seq)
      (optimize-block-list-fast (compiler-ir-block-seq-to-list seq))]))

;; Block-count ceiling for the super-linear dominator-based passes (GVN, LICM,
;; induction, global GVN). Functions with more basic blocks than this skip those
;; passes at opt-level 2 so a few huge self-host functions cannot blow up compile
;; time; the linear passes and register allocation still run on them.
;; 1024 covers the current self-host max (806 blocks in opt-instr-eq) with
;; headroom while still keeping a finite guard for pathological inputs.
(define (opt-heavy-pass-block-limit) : i64
  1024)

;; --- self-tail-recursion -> loop (tail-rec-loop) ---------------------------
;;
;; A call to the CURRENT function in tail position (its result flows straight
;; into a `return`) is lowered as an `IrInstrTailCall` whose callee name equals
;; the function name. The backend currently emits a real `call` for it, which
;; grows the stack frame on every recursive step. This pass rewrites each such
;; self-tail-call into a back-edge to the function entry block, turning the
;; recursion into an in-place loop:
;;
;;   * evaluate every call argument into a fresh temp slot (so a parameter that
;;     is read by a *later* argument still sees its old value),
;;   * copy each temp into the matching parameter slot,
;;   * jump to the entry block.
;;
;; Reassigning a parameter slot via `IrInstrMov` is exactly what a source-level
;; `(set! param ...)` lowers to, so this stays inside the IR's existing
;; "reassignment is allowed; redundancy passes invalidate on (re)definition"
;; model. Re-running the whole entry block per iteration is precisely the
;; tail-recursion semantics (a real recursive call re-executes the entire body),
;; so no loop pre-header is required. The reassignments make the function
;; non-SSA, so the SSA-gated passes (LICM, induction) simply skip it; the
;; unconditional passes (GVN/SCCP/copy-prop/CFG/DCE) handle the reassignments
;; the same way they handle ordinary loops built from `while`/`set!`.
(define (opt-tailrec-param-count [params : CompilerIrParamList]) : i64
  (match params
    [(IrParamNil) 0]
    [(IrParamCons _ rest) (+ 1 (opt-tailrec-param-count (box-get rest)))]))

(define (opt-tailrec-array-values-to-list
  [values : (Array CompilerIrValue)]
  [index : i64]) : CompilerIrValueList
  (if (>= index (array-length values))
    IrValueNil
    (compiler-ir-value-cons
      (array-ref values index)
      (opt-tailrec-array-values-to-list values (+ index 1)))))

(define (opt-tailrec-args-to-list [args : CompilerIrCallArgs]) : CompilerIrValueList
  (match args
    [(IrCallArgsNil) IrValueNil]
    [(IrCallArgsOne a) (compiler-ir-value-cons a IrValueNil)]
    [(IrCallArgsTwo a b)
      (compiler-ir-value-cons a (compiler-ir-value-cons b IrValueNil))]
    [(IrCallArgsArray values) (opt-tailrec-array-values-to-list values 0)]))

;; Copy each parameter's staged temp back into the parameter slot, then append
;; `tail` (the back-edge jump). Run after all of the staging moves so the temps
;; already hold the new argument values.
(define (opt-tailrec-assign-movs
  [params : CompilerIrParamList]
  [base : i64]
  [index : i64]
  [tail : CompilerIrInstrList]) : CompilerIrInstrList
  (match params
    [(IrParamNil) tail]
    [(IrParamCons param prest)
      (match param
        [(IrParam _ ty var-id)
          (compiler-ir-instr-cons
            (IrInstrMov var-id (IrValueVar (+ base index)) ty)
            (opt-tailrec-assign-movs (box-get prest) base (+ index 1) tail))])]))

;; Evaluate each argument into a fresh temp slot (`base + i`) before any
;; parameter slot is overwritten, so argument aliasing on the parameters is
;; preserved.
(define (opt-tailrec-stage-movs
  [params : CompilerIrParamList]
  [args : CompilerIrValueList]
  [base : i64]
  [index : i64]
  [tail : CompilerIrInstrList]) : CompilerIrInstrList
  (match params
    [(IrParamNil) tail]
    [(IrParamCons param prest)
      (match args
        [(IrValueNil) tail]
        [(IrValueCons arg arest)
          (match param
            [(IrParam _ ty _)
              (compiler-ir-instr-cons
                (IrInstrMov (+ base index) arg ty)
                (opt-tailrec-stage-movs
                  (box-get prest)
                  (box-get arest)
                  base
                  (+ index 1)
                  tail))])])]))

(define (opt-tailrec-self-call?
  [instr : CompilerIrInstr]
  [fname : String]
  [n : i64]) : bool
  (match instr
    [(IrInstrTailCall name args _)
      (and (string-eq name fname) (= (compiler-ir-call-args-count args) n))]
    [_ false]))

(define (opt-tailrec-rewrite-instrs
  [instrs : CompilerIrInstrList]
  [fname : String]
  [params : CompilerIrParamList]
  [n : i64]
  [base : i64]
  [entry-label : String]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) IrInstrNil]
    [(IrInstrCons instr rest)
      (if (opt-tailrec-self-call? instr fname n)
        (match instr
          [(IrInstrTailCall _ args _)
            ;; `instr` is a terminator, so anything after it in `rest` is dead;
            ;; drop it and emit stage moves, parameter writebacks, then the
            ;; back-edge jump.
            (opt-tailrec-stage-movs
              params
              (opt-tailrec-args-to-list args)
              base
              0
              (opt-tailrec-assign-movs
                params
                base
                0
                (compiler-ir-instr-cons (IrInstrJump entry-label) IrInstrNil)))]
          [_ IrInstrNil])
        (compiler-ir-instr-cons
          instr
          (opt-tailrec-rewrite-instrs
            (box-get rest)
            fname
            params
            n
            base
            entry-label)))]))

(define (opt-tailrec-rewrite-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [fname : String]
  [params : CompilerIrParamList]
  [n : i64]
  [base : i64]
  [entry-label : String]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    IrInstrNil
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (if (opt-tailrec-self-call? instr fname n)
        (match instr
          [(IrInstrTailCall _ args _)
            (opt-tailrec-stage-movs
              params
              (opt-tailrec-args-to-list args)
              base
              0
              (opt-tailrec-assign-movs
                params
                base
                0
                (compiler-ir-instr-cons (IrInstrJump entry-label) IrInstrNil)))]
          [_ IrInstrNil])
        (compiler-ir-instr-cons
          instr
          (opt-tailrec-rewrite-instr-seq-from
            instrs
            (+ index 1)
            fname
            params
            n
            base
            entry-label))))))

(define (opt-tailrec-rewrite-instr-seq
  [instrs : CompilerIrInstrSeq]
  [fname : String]
  [params : CompilerIrParamList]
  [n : i64]
  [base : i64]
  [entry-label : String]) : CompilerIrInstrList
  (opt-tailrec-rewrite-instr-seq-from instrs 0 fname params n base entry-label))

(define (opt-tailrec-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [fname : String]
  [params : CompilerIrParamList]
  [n : i64]
  [base : i64]
  [entry-label : String]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock label instrs)
          (compiler-ir-block-cons
            (compiler-ir-block
              label
              (opt-tailrec-rewrite-instr-seq
                instrs
                fname
                params
                n
                base
                entry-label))
            (opt-tailrec-rewrite-blocks
              (box-get rest)
              fname
              params
              n
              base
              entry-label))])]
    [(IrBlockArray seq)
      (opt-tailrec-rewrite-blocks
        (compiler-ir-block-seq-to-list seq)
        fname
        params
        n
        base
        entry-label)]))

(define (opt-tailrec-instrs-have-convertible?
  [instrs : CompilerIrInstrList]
  [fname : String]
  [n : i64]) : bool
  (match instrs
    [(IrInstrNil) false]
    [(IrInstrCons instr rest)
      (if (opt-tailrec-self-call? instr fname n)
        true
        (opt-tailrec-instrs-have-convertible? (box-get rest) fname n))]))

(define (opt-tailrec-instr-seq-has-convertible-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [fname : String]
  [n : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-tailrec-self-call?
      (compiler-ir-instr-seq-ref instrs index)
      fname
      n)
      true
      (opt-tailrec-instr-seq-has-convertible-from? instrs (+ index 1) fname n))))

(define (opt-tailrec-instr-seq-has-convertible?
  [instrs : CompilerIrInstrSeq]
  [fname : String]
  [n : i64]) : bool
  (opt-tailrec-instr-seq-has-convertible-from? instrs 0 fname n))

(define (opt-tailrec-blocks-have-convertible?
  [blocks : CompilerIrBlockList]
  [fname : String]
  [n : i64]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-tailrec-instr-seq-has-convertible? instrs fname n)
            true
            (opt-tailrec-blocks-have-convertible? (box-get rest) fname n))])]
    [(IrBlockArray seq)
      (opt-tailrec-blocks-have-convertible?
        (compiler-ir-block-seq-to-list seq)
        fname
        n)]))

(define (opt-tailrec-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret vars blocks)
      (let
        [n : i64 (opt-tailrec-param-count params)]
        (if (opt-tailrec-blocks-have-convertible? blocks name n)
          (IrFunction
            name
            params
            ret
            (+ vars n)
            (opt-tailrec-rewrite-blocks
              blocks
              name
              params
              n
              vars
              (opt-cfg-entry-label blocks)))
          func))]))

(define (optimize-function-once-with-summaries
  [func : CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (let
    [_t-tailrec : i64 (cfg compile-profile (profile-now-ms) 0)]
    [tailrec : CompilerIrFunction (opt-tailrec-function func)]
    (match tailrec
      [(IrFunction name params ret-ty frame blocks)
        ;; Fold first so SCCP can reuse local facts, then simplify the reachable
        ;; CFG and eliminate dead pure assignments.
        (let
          [_p-tailrec : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish "tailrec" name _t-tailrec)
              unit)]
          [_t-fold : i64 (cfg compile-profile (profile-now-ms) 0)]
          [folded : CompilerIrBlockList (optimize-block-list blocks)]
          [_p-fold : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish "fold" name _t-fold)
              unit)]
          [loop-bce : CompilerIrBlockList
            (if (struct-get summaries enabled)
              (opt-loop-bce-blocks summaries params folded)
              folded)]
          [_t-promote : i64 (cfg compile-profile (profile-now-ms) 0)]
          [promoted : CompilerIrFunction
            (opt-aggregate-stack-promote-function
              (IrFunction name params ret-ty frame loop-bce))]
          [_p-promote : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish "stack_promote" name _t-promote)
              unit)]
          (match promoted
            [(IrFunction _ _ _ promoted-frame promoted-blocks)
              ;; Aggregate field-load SROA (#1562) runs on the post-promotion
              ;; blocks/frame (it leaves the frame unchanged), so the slots stay
              ;; consistent with the later #1530 global-GVN pass below.
              (let
                [_t-sroa : i64 (cfg compile-profile (profile-now-ms) 0)]
                [sroa : CompilerIrFunction
                  (opt-aggregate-sroa-function
                    (IrFunction
                      name
                      params
                      ret-ty
                      promoted-frame
                      promoted-blocks))]
                [_p-sroa : unit
                  (cfg
                    compile-profile
                    (compiler-opt-profile-pass-finish "sroa" name _t-sroa)
                    unit)]
                (match sroa
                  [(IrFunction _ _ _ _ sroa-blocks)
                    (let
                      ;; #perf: the dominator-based passes (GVN, LICM, induction,
                      ;; global GVN) are super-linear in block count (their dominance
                      ;; queries walk string label-sets), so on the handful of huge
                      ;; self-host functions (hundreds of blocks) they dominate
                      ;; compile time. Gate them off above a block-count threshold;
                      ;; register allocation and the linear cleanups still run, so
                      ;; only the incremental redundancy elimination is skipped on
                      ;; those few functions, which bounds opt-level-3 compile time.
                      [run-heavy? : bool
                        (<=
                          (compiler-ir-block-list-count sroa-blocks)
                          (opt-heavy-pass-block-limit))]
                      [_t-rotation : i64
                        (cfg compile-profile (profile-now-ms) 0)]
                      [rotated : CompilerIrFunction
                        (if run-heavy?
                          (opt-loop-rotation-function
                            (IrFunction
                              name
                              params
                              ret-ty
                              promoted-frame
                              sroa-blocks))
                          (IrFunction
                            name
                            params
                            ret-ty
                            promoted-frame
                            sroa-blocks))]
                      [_p-rotation : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            "rotation"
                            name
                            _t-rotation)
                          unit)]
                      ;; Scalar SSA construction feeds the verifier-gated
                      ;; dominator passes below. Unsupported cases fall back to the
                      ;; original function, so the optimization path remains safe.
                      [_t-ssa : i64 (cfg compile-profile (profile-now-ms) 0)]
                      [ssa-result : OptFunctionCtxResult
                        (if run-heavy?
                          (opt-ssa-construct-function-with-context-result
                            rotated)
                          (OptFunctionCtxResult rotated (opt-cfg-context-empty)))]
                      [ssa : CompilerIrFunction
                        (match ssa-result
                          [(OptFunctionCtxResult f _) f])]
                      [ssa-context : OptCfgContext
                        (match ssa-result
                          [(OptFunctionCtxResult _ ctx) ctx])]
                      [_p-ssa : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish "ssa" name _t-ssa)
                          unit)]
                      [ssa-frame : i64 (opt-function-frame ssa)]
                      [ssa-blocks : CompilerIrBlockList
                        (opt-function-blocks ssa)]
                      [_t-gvn : i64 (cfg compile-profile (profile-now-ms) 0)]
                      [gvn : CompilerIrBlockList
                        (if run-heavy?
                          (opt-gvn-blocks-with-context
                            ssa-context
                            params
                            ssa-blocks)
                          ssa-blocks)]
                      [_p-gvn : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish "gvn" name _t-gvn)
                          unit)]
                      [_t-sccp : i64 (cfg compile-profile (profile-now-ms) 0)]
                      [sccp-result : OptBlockCtxResult
                        (if run-heavy?
                          (opt-sccp-blocks-with-context-result
                            ssa-context
                            params
                            gvn)
                          (OptBlockCtxResult
                            (opt-sccp-blocks params gvn)
                            (opt-cfg-context-empty)
                            false))]
                      [sccp : CompilerIrBlockList
                        (match sccp-result
                          [(OptBlockCtxResult b _ _) b])]
                      [sccp-context : OptCfgContext
                        (match sccp-result
                          [(OptBlockCtxResult _ ctx _) ctx])]
                      [sccp-context-valid : bool
                        (match sccp-result
                          [(OptBlockCtxResult _ _ valid) valid])]
                      [_p-sccp : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish "sccp" name _t-sccp)
                          unit)]
                      [_t-cfg2 : i64 (cfg compile-profile (profile-now-ms) 0)]
                      [cfg-result : OptBlockCtxResult
                        (if run-heavy?
                          (opt-cfg-simplify-blocks-with-context-result
                            (OptBlockCtxResult
                              sccp
                              sccp-context
                              sccp-context-valid))
                          (OptBlockCtxResult
                            (opt-cfg-simplify-blocks sccp)
                            (opt-cfg-context-empty)
                            false))]
                      [cfg : CompilerIrBlockList
                        (match cfg-result
                          [(OptBlockCtxResult b _ _) b])]
                      [cfg-context : OptCfgContext
                        (match cfg-result
                          [(OptBlockCtxResult _ ctx _) ctx])]
                      [_p-cfg2 : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish "cfg" name _t-cfg2)
                          unit)]
                      [_t-preheaders : i64
                        (cfg compile-profile (profile-now-ms) 0)]
                      ;; (#2874) Thread one OptCfgContext per block-state through
                      ;; the preheaders -> licm -> induction -> global_gvn chain.
                      ;; Each pass's output blocks are fed verbatim to the next,
                      ;; so the context the pass builds for its post-pass verify
                      ;; is exactly what the next pass needs for its entry verify
                      ;; and dominance queries -- no rebuild between passes. Each
                      ;; pass that rewrites the CFG builds one fresh context for
                      ;; its output; the no-op majority reuses its input context.
                      [preheaders-result : OptFunctionCtxResult
                        (if run-heavy?
                          (let
                            [preheaders-input : CompilerIrFunction
                              (IrFunction name params ret-ty ssa-frame cfg)]
                            (opt-loop-preheaders-function-with-context-result
                              cfg-context
                              preheaders-input))
                          (OptFunctionCtxResult
                            (IrFunction name params ret-ty ssa-frame cfg)
                            (opt-cfg-context-empty)))]
                      [preheaders : CompilerIrFunction
                        (match preheaders-result
                          [(OptFunctionCtxResult f _) f])]
                      [preheaders-context : OptCfgContext
                        (match preheaders-result
                          [(OptFunctionCtxResult _ ctx) ctx])]
                      [_p-preheaders : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            "preheaders"
                            name
                            _t-preheaders)
                          unit)]
                      [_t-licm : i64 (cfg compile-profile (profile-now-ms) 0)]
                      [licm-result : OptFunctionCtxResult
                        (if run-heavy?
                          (opt-licm-function-with-context-result
                            preheaders-context
                            preheaders)
                          preheaders-result)]
                      [licm : CompilerIrFunction
                        (match licm-result
                          [(OptFunctionCtxResult f _) f])]
                      [licm-context : OptCfgContext
                        (match licm-result
                          [(OptFunctionCtxResult _ ctx) ctx])]
                      [_p-licm : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish "licm" name _t-licm)
                          unit)]
                      [_t-induction : i64
                        (cfg compile-profile (profile-now-ms) 0)]
                      [induction-result : OptFunctionCtxResult
                        (if run-heavy?
                          (opt-induction-function-with-context-result
                            licm-context
                            licm)
                          licm-result)]
                      [induction : CompilerIrFunction
                        (match induction-result
                          [(OptFunctionCtxResult f _) f])]
                      [induction-context : OptCfgContext
                        (match induction-result
                          [(OptFunctionCtxResult _ ctx) ctx])]
                      [_p-induction : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            "induction"
                            name
                            _t-induction)
                          unit)]
                      [induction-frame : i64 (opt-function-frame induction)]
                      [induction-blocks : CompilerIrBlockList
                        (opt-function-blocks induction)]
                      ;; Cross-block global value numbering + copy propagation
                      ;; (#1530) runs after local GVN/SCCP/CFG/LICM cleanup, on
                      ;; the post-stack-promotion frame so its slots stay
                      ;; consistent with the promoted blocks. It reuses the
                      ;; context induction handed back (#2874): induction's output
                      ;; blocks are global_gvn's input blocks unchanged.
                      [_t-global : i64 (cfg compile-profile (profile-now-ms) 0)]
                      [global : CompilerIrFunction
                        (if run-heavy?
                          (opt-global-value-number-function-with-context
                            induction-context
                            (IrFunction
                              name
                              params
                              ret-ty
                              induction-frame
                              induction-blocks))
                          (IrFunction
                            name
                            params
                            ret-ty
                            induction-frame
                            induction-blocks))]
                      [_p-global : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            "global_gvn"
                            name
                            _t-global)
                          unit)]
                      [global-blocks : CompilerIrBlockList
                        (opt-function-blocks global)]
                      ;; #3468: substitute proven constant-global divisors with
                      ;; their literals before divrem-safety, so the literal
                      ;; divisor both enables the backend magic-multiply path and
                      ;; lets divrem-safety drop the zero/overflow guards. This
                      ;; only rewrites a binop's RHS operand value, leaving the
                      ;; CFG structure intact, so the induction context stays
                      ;; valid for the divrem-safety pass below.
                      [const-div-blocks : CompilerIrBlockList
                        (opt-const-divisor-rewrite-summary-blocks
                          summaries
                          global-blocks)]
                      [_t-divrem-safety : i64
                        (cfg compile-profile (profile-now-ms) 0)]
                      [divrem-safe : CompilerIrBlockList
                        (if run-heavy?
                          (opt-divrem-safety-blocks-with-context
                            induction-context
                            params
                            const-div-blocks)
                          const-div-blocks)]
                      [_p-divrem-safety : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            "divrem_safety"
                            name
                            _t-divrem-safety)
                          unit)]
                      [_t-dce : i64 (cfg compile-profile (profile-now-ms) 0)]
                      [used : (Array i64)
                        (opt-collect-blocks-uses-array
                          induction-frame
                          divrem-safe)]
                      [dced : CompilerIrBlockList
                        (opt-dce-block-list-array used divrem-safe)]
                      [_p-dce : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish "dce" name _t-dce)
                          unit)]
                      (IrFunction name params ret-ty induction-frame dced))]))]))])))

(define (optimize-function-once [func : CompilerIrFunction]) : CompilerIrFunction
  (optimize-function-once-with-summaries func (opt-loop-bce-empty-summaries)))

;; Level 2 keeps the self-build path lightweight while preserving the explicit
;; optimized-level checks for local scalar cleanup, bounds checks, stack
;; promotion, CFG cleanup, DCE, and program-level reachability pruning.
(define (optimize-function-once-level2-with-summaries
  [func : CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret-ty frame blocks)
      (let
        [_t-fold : i64 (cfg compile-profile (profile-now-ms) 0)]
        [folded : CompilerIrBlockList (optimize-block-list blocks)]
        [_p-fold : unit
          (cfg
            compile-profile
            (compiler-opt-profile-pass-finish "fold" name _t-fold)
            unit)]
        [loop-bce : CompilerIrBlockList
          (if (struct-get summaries enabled)
            (opt-loop-bce-blocks summaries params folded)
            folded)]
        [_t-promote : i64 (cfg compile-profile (profile-now-ms) 0)]
        [promoted : CompilerIrFunction
          (opt-aggregate-stack-promote-function
            (IrFunction name params ret-ty frame loop-bce))]
        [_p-promote : unit
          (cfg
            compile-profile
            (compiler-opt-profile-pass-finish "stack_promote" name _t-promote)
            unit)]
        (match promoted
          [(IrFunction _ _ _ promoted-frame promoted-blocks)
            (let
              [_t-cfg : i64 (cfg compile-profile (profile-now-ms) 0)]
              [cfg : CompilerIrBlockList
                (opt-cfg-simplify-blocks promoted-blocks)]
              [_p-cfg : unit
                (cfg
                  compile-profile
                  (compiler-opt-profile-pass-finish "cfg" name _t-cfg)
                  unit)]
              [_t-dce : i64 (cfg compile-profile (profile-now-ms) 0)]
              [used : (Array i64)
                (opt-collect-blocks-uses-array promoted-frame cfg)]
              [dced : CompilerIrBlockList (opt-dce-block-list-array used cfg)]
              [_p-dce : unit
                (cfg
                  compile-profile
                  (compiler-opt-profile-pass-finish "dce" name _t-dce)
                  unit)]
              (IrFunction name params ret-ty promoted-frame dced))]))]))

(define (optimize-function-once-level2 [func : CompilerIrFunction]) : CompilerIrFunction
  (optimize-function-once-level2-with-summaries
    func
    (opt-loop-bce-empty-summaries)))

(define (optimize-function-once-fast [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret-ty frame blocks)
      (let
        [folded : CompilerIrBlockList (optimize-block-list-fast blocks)]
        [cfg : CompilerIrBlockList (opt-cfg-simplify-blocks folded)]
        [used : (Array i64) (opt-collect-blocks-uses-array frame cfg)]
        (IrFunction
          name
          params
          ret-ty
          frame
          (opt-dce-block-list-array used cfg)))]))

(define (optimize-function-pass-with-summaries
  [func : CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : OptFunctionPassResult
  (let
    [next : CompilerIrFunction
      (optimize-function-once-with-summaries func summaries)]
    (OptFunctionPassResult next (not (opt-function-eq func next)))))

(define (optimize-function-pass [func : CompilerIrFunction]) : OptFunctionPassResult
  (optimize-function-pass-with-summaries func (opt-loop-bce-empty-summaries)))

(define (optimize-function-fixed-with-summaries
  [func : CompilerIrFunction]
  [remaining : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (if (<= remaining 0)
    func
    (match (optimize-function-pass-with-summaries func summaries)
      [(OptFunctionPassResult next changed)
        (if changed
          (optimize-function-fixed-with-summaries
            next
            (- remaining 1)
            summaries)
          next)])))

(define (optimize-function-fixed [func : CompilerIrFunction] [remaining : i64]) : CompilerIrFunction
  (optimize-function-fixed-with-summaries
    func
    remaining
    (opt-loop-bce-empty-summaries)))

(define (optimize-function [func : CompilerIrFunction]) : CompilerIrFunction
  (optimize-function-fixed func (optimize-function-max-iterations)))

;; Opt levels (0/1/2): 0 = none, 1 = cheap stack-only (the fast self-compile
;; path), 2 = the full optimizer + scalar register allocation + inlining (the
;; quality "ship" build). The old four-level scheme (with a redundant -fast level
;; between 0 and the cheap level) was collapsed: old level 2 became level 1 and
;; old level 3 became level 2.
(define (optimize-function-with-level-and-summaries
  [func : CompilerIrFunction]
  [level : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (if (= level 0)
    func
    (if (= level 1)
      (optimize-function-once-level2-with-summaries func summaries)
      (optimize-function-fixed-with-summaries
        func
        (optimize-function-max-iterations)
        summaries))))

(define (optimize-function-with-level [func : CompilerIrFunction] [level : i64]) : CompilerIrFunction
  (optimize-function-with-level-and-summaries
    func
    level
    (opt-loop-bce-empty-summaries)))

(define (optimize-function-list [funcs : CompilerIrFunctionList]) : CompilerIrFunctionList
  (optimize-function-list-with-level funcs (compiler-optimize-default-level)))

;; Per-function arena escape (#1633). The optimizer fixpoint allocates up to
;; ~80 throwaway IR copies per function (10 iterations x ~8 passes), none freed
;; by the bump allocator. To cap peak memory we run each function's optimization
;; in a reusable scratch arena, deep-`clone` only the final result back into the
;; enclosing (program) arena, then rewind the scratch so a single function's
;; transient generations are reclaimed before the next function is processed.
(define (optimize-function-list-with-level
  [funcs : CompilerIrFunctionList]
  [level : i64]) : CompilerIrFunctionList
  (optimize-function-list-with-level-and-summaries
    funcs
    level
    (opt-loop-bce-empty-summaries)))

(define (optimize-function-list-with-level-and-summaries
  [funcs : CompilerIrFunctionList]
  [level : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunctionList
  (if (= level 0)
    funcs
    (let
      [scratch : i64 (arena-make)]
      [result : CompilerIrFunctionList
        (optimize-function-list-escaping-with-summaries
          funcs
          level
          scratch
          summaries)]
      (begin
        (unsafe
          (arena-destroy scratch))
        result))))

(define (optimize-function-list-escaping
  [funcs : CompilerIrFunctionList]
  [level : i64]
  [scratch : i64]) : CompilerIrFunctionList
  (optimize-function-list-escaping-with-summaries
    funcs
    level
    scratch
    (opt-loop-bce-empty-summaries)))

(define (optimize-function-list-escaping-with-summaries
  [funcs : CompilerIrFunctionList]
  [level : i64]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunctionList
  (match funcs
    [(IrFunctionNil) (IrFunctionNil)]
    [(IrFunctionCons func rest)
      (let
        [_start : unit
          (cfg compile-profile (compiler-opt-profile-detail-start))]
        [optimized : CompilerIrFunction
          (optimize-function-escaping-with-summaries
            func
            level
            scratch
            summaries)]
        [_report : unit
          (cfg
            compile-profile
            (compiler-opt-scratch-region-report-function-escaping
              optimized
              scratch))]
        [_finish : unit
          (cfg
            compile-profile
            (compiler-opt-profile-detail-finish
              "function"
              (compiler-opt-profile-function-name func)))]
        (compiler-ir-function-cons
          optimized
          (optimize-function-list-escaping-with-summaries
            (box-get rest)
            level
            scratch
            summaries)))]
    [(IrFunctionArray seq)
      (compiler-ir-function-list-compact
        (optimize-function-list-escaping-with-summaries
          (compiler-ir-function-seq-to-list seq)
          level
          scratch
          summaries))]))

;; Optimize one function inside `scratch`, compact its blocks there, then escape
;; the result by deep-cloning it into the enclosing arena and rewinding `scratch`
;; for reuse.
(define (optimize-function-escaping
  [func : CompilerIrFunction]
  [level : i64]
  [scratch : i64]) : CompilerIrFunction
  (optimize-function-escaping-with-summaries
    func
    level
    scratch
    (opt-loop-bce-empty-summaries)))

(define (optimize-function-escaping-with-summaries
  [func : CompilerIrFunction]
  [level : i64]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : CompilerIrFunction
  (with-escape
    scratch
    (compiler-ir-function-compact-blocks
      (optimize-function-with-level-and-summaries func level summaries))))

(defenum OptStringSet
  (OptStringNil)
  (OptStringCons String (Box OptStringSet)))

(defenum OptMaybeFunction
  (OptNoFunction)
  (OptSomeFunction CompilerIrFunction))

(defenum OptSlotList
  (OptSlotNil)
  (OptSlotCons i64 (Box OptSlotList)))

(defstruct OptFunctionIndex
  (ids StringI64Map)
  (values (Array CompilerIrFunction)))

(defstruct OptCallGraph
  (count i64)
  (edges (Array OptSlotList)))

(defstruct OptInlineCensus
  (refcount StringI64Map)
  (addrtaken StringI64Map))

(defstruct OptSccResult
  (scc-of (Array i64))
  (order (Array i64)))

(defenum OptSccDiscoverState
  (OptSccDiscoverState i64 i64))

(defenum OptSccPopState
  (OptSccPopState i64 i64))

(defenum OptReachState
  (OptReachState StringI64Map OptStringSet))

(define (opt-function-index-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (opt-function-list-count [functions : CompilerIrFunctionList]) : i64
  (match functions
    [(IrFunctionNil) 0]
    [(IrFunctionCons _ rest) (+ 1 (opt-function-list-count (box-get rest)))]
    [(IrFunctionArray seq) (compiler-ir-function-seq-count seq)]))

(define (opt-function-index-fill
  [functions : CompilerIrFunctionList]
  [ids : StringI64Map]
  [values : (Array CompilerIrFunction)]
  [index : i64]) : StringI64Map
  (match functions
    [(IrFunctionNil) ids]
    [(IrFunctionCons func rest)
      (match func
        [(IrFunction name _ _ _ _)
          (begin
            (array-set! values index func)
            (opt-function-index-fill
              (box-get rest)
              (string-i64-map-put ids name index)
              values
              (+ index 1)))])]
    [(IrFunctionArray seq)
      (opt-function-index-fill
        (compiler-ir-function-seq-to-list seq)
        ids
        values
        index)]))

(define (opt-function-index-build [functions : CompilerIrFunctionList]) : OptFunctionIndex
  (let
    [count : i64 (opt-function-list-count functions)]
    [values : (Array CompilerIrFunction) (make-array CompilerIrFunction count)]
    [ids : StringI64Map
      (opt-function-index-fill
        functions
        (string-i64-map-with-capacity (opt-function-index-capacity count))
        values
        0)]
    (OptFunctionIndex ids values)))

(define (opt-function-index-defines? [index : OptFunctionIndex] [name : String]) : bool
  (string-i64-map-contains? (struct-get index ids) name))

(define (opt-function-index-count [index : OptFunctionIndex]) : i64
  (array-length (struct-get index values)))

(define (opt-function-index-slot [index : OptFunctionIndex] [name : String]) : OptMaybeI64
  (if (opt-function-index-defines? index name)
    (match (string-i64-map-get (struct-get index ids) name)
      [(StringI64MapFound slot) (OptSomeI64 slot)]
      [(StringI64MapMissing) (OptNoI64)])
    (OptNoI64)))

(define (opt-function-index-find [index : OptFunctionIndex] [name : String]) : OptMaybeFunction
  (match (string-i64-map-get (struct-get index ids) name)
    [(StringI64MapFound slot)
      (OptSomeFunction (array-ref (struct-get index values) slot))]
    [(StringI64MapMissing) (OptNoFunction)]))

(define (opt-slot-list-contains? [slots : OptSlotList] [slot : i64]) : bool
  (match slots
    [(OptSlotNil) false]
    [(OptSlotCons item rest)
      (if (= item slot)
        true
        (opt-slot-list-contains? (box-get rest) slot))]))

(define (opt-slot-list-add [slots : OptSlotList] [slot : i64]) : OptSlotList
  (if (opt-slot-list-contains? slots slot)
    slots
    (OptSlotCons slot (box slots))))

(define (opt-slot-list-count [slots : OptSlotList]) : i64
  (match slots
    [(OptSlotNil) 0]
    [(OptSlotCons _ rest) (+ 1 (opt-slot-list-count (box-get rest)))]))

(define (opt-callgraph-add-callee
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [name : String]) : OptSlotList
  (match (opt-function-index-slot index name)
    [(OptSomeI64 slot) (opt-slot-list-add callees slot)]
    [(OptNoI64) callees]))

;; Deliberately call-only: address-taken function values are reachability roots,
;; but they are not direct call-graph edges for the inliner.
(define (opt-callgraph-instr
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [instr : CompilerIrInstr]) : OptSlotList
  (match instr
    [(IrInstrCall _ name _ _) (opt-callgraph-add-callee index callees name)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload _ name _ _)
          (opt-callgraph-add-callee index callees name)])]
    [(IrInstrTailCall name _ _) (opt-callgraph-add-callee index callees name)]
    [_ callees]))

(define (opt-callgraph-instr-seq-from
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [slots : (Array CompilerIrInstr)]
  [instr-index : i64]
  [count : i64]) : OptSlotList
  (if (>= instr-index count)
    callees
    (opt-callgraph-instr-seq-from
      index
      (opt-callgraph-instr index callees (array-ref slots instr-index))
      slots
      (+ instr-index 1)
      count)))

(define (opt-callgraph-instr-seq
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [instrs : CompilerIrInstrSeq]) : OptSlotList
  (opt-callgraph-instr-seq-from
    index
    callees
    (struct-get instrs slots)
    0
    (struct-get instrs len)))

(define (opt-callgraph-blocks
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [blocks : CompilerIrBlockList]) : OptSlotList
  (match blocks
    [(IrBlockNil) callees]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-callgraph-blocks
            index
            (opt-callgraph-instr-seq index callees instrs)
            (box-get rest))])]
    [(IrBlockArray seq)
      (opt-callgraph-blocks index callees (compiler-ir-block-seq-to-list seq))]))

(define (opt-callgraph-callees
  [index : OptFunctionIndex]
  [func : CompilerIrFunction]) : OptSlotList
  (match func
    [(IrFunction _ _ _ _ blocks) (opt-callgraph-blocks index OptSlotNil blocks)]))

(define (opt-callgraph-init-edges
  [edges : (Array OptSlotList)]
  [slot : i64]
  [count : i64]) : unit
  (if (>= slot count)
    unit
    (begin
      (array-set! edges slot OptSlotNil)
      (opt-callgraph-init-edges edges (+ slot 1) count))))

(define (opt-callgraph-build-slots
  [index : OptFunctionIndex]
  [edges : (Array OptSlotList)]
  [values : (Array CompilerIrFunction)]
  [slot : i64]
  [count : i64]) : unit
  (if (>= slot count)
    unit
    (begin
      (array-set!
        edges
        slot
        (opt-callgraph-callees index (array-ref values slot)))
      (opt-callgraph-build-slots index edges values (+ slot 1) count))))

(define (opt-callgraph-build [index : OptFunctionIndex]) : OptCallGraph
  (let
    [count : i64 (opt-function-index-count index)]
    [edges : (Array OptSlotList) (make-array OptSlotList count)]
    [values : (Array CompilerIrFunction) (struct-get index values)]
    (begin
      (opt-callgraph-init-edges edges 0 count)
      (opt-callgraph-build-slots index edges values 0 count)
      (OptCallGraph count edges))))

(define (opt-inline-census-capacity [index : OptFunctionIndex]) : i64
  (opt-function-index-capacity (opt-function-index-count index)))

(define (opt-inline-census-bump-map [map : StringI64Map] [name : String]) : StringI64Map
  (match (string-i64-map-get map name)
    [(StringI64MapFound count) (string-i64-map-put map name (+ count 1))]
    [(StringI64MapMissing) (string-i64-map-put map name 1)]))

(define (opt-inline-census-add-ref
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : String]) : OptInlineCensus
  (if (opt-function-index-defines? index name)
    (OptInlineCensus
      (opt-inline-census-bump-map (struct-get census refcount) name)
      (struct-get census addrtaken))
    census))

(define (opt-inline-census-add-address
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : String]) : OptInlineCensus
  (if (opt-function-index-defines? index name)
    (OptInlineCensus
      (struct-get census refcount)
      (string-i64-map-put (struct-get census addrtaken) name 1))
    census))

(define (opt-inline-census-value
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [value : CompilerIrValue]) : OptInlineCensus
  (match value
    [(IrValueFunction name) (opt-inline-census-add-address index census name)]
    [_ census]))

(define (opt-inline-census-args-array
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [values : (Array CompilerIrValue)]
  [arg-index : i64]) : OptInlineCensus
  (if (>= arg-index (array-length values))
    census
    (opt-inline-census-args-array
      index
      (opt-inline-census-value index census (array-ref values arg-index))
      values
      (+ arg-index 1))))

(define (opt-inline-census-args
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [args : CompilerIrCallArgs]) : OptInlineCensus
  (match args
    [(IrCallArgsNil) census]
    [(IrCallArgsOne value) (opt-inline-census-value index census value)]
    [(IrCallArgsTwo a b)
      (opt-inline-census-value index (opt-inline-census-value index census a) b)]
    [(IrCallArgsArray values)
      (opt-inline-census-args-array index census values 0)]))

(define (opt-inline-census-maybe-value
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [maybe : CompilerIrMaybeValue]) : OptInlineCensus
  (match maybe
    [(IrNoValue) census]
    [(IrSomeValue value) (opt-inline-census-value index census value)]))

(define (opt-inline-census-phi-inputs
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [inputs : CompilerIrPhiInputList]) : OptInlineCensus
  (match inputs
    [(IrPhiInputNil) census]
    [(IrPhiInputCons value _ rest)
      (opt-inline-census-phi-inputs
        index
        (opt-inline-census-value index census value)
        (box-get rest))]))

(define (opt-inline-census-value-list
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [values : CompilerIrValueList]) : OptInlineCensus
  (match values
    [(IrValueNil) census]
    [(IrValueCons value rest)
      (opt-inline-census-value-list
        index
        (opt-inline-census-value index census value)
        (box-get rest))]))

(define (opt-inline-census-instr
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [instr : CompilerIrInstr]) : OptInlineCensus
  (match instr
    [(IrInstrMov _ src _) (opt-inline-census-value index census src)]
    [(IrInstrAlloc _ _) census]
    [(IrInstrAddrOf _ _) census]
    [(IrInstrGep _ base offset _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census base)
        offset)]
    [(IrInstrLoad _ src _) (opt-inline-census-value index census src)]
    [(IrInstrStorePtr dst src _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census dst)
        src)]
    [(IrInstrCopyBytes dst src _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census dst)
        src)]
    [(IrInstrBoundsCheck idx length _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census idx)
        length)]
    [(IrInstrCast _ src _ _) (opt-inline-census-value index census src)]
    [(IrInstrBitcast _ src _ _) (opt-inline-census-value index census src)]
    [(IrInstrBinOp _ _ lhs rhs _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census lhs)
        rhs)]
    [(IrInstrUnOp _ _ src _) (opt-inline-census-value index census src)]
    [(IrInstrLaneId _ _ _) census]
    [(IrInstrSplat _ value _ _) (opt-inline-census-value index census value)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ lhs rhs _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value index census lhs)
            rhs)])]
    [(IrInstrVectorReduce _ _ src _ _)
      (opt-inline-census-value index census src)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ lhs rhs _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value index census lhs)
            rhs)])]
    [(IrInstrMaskBinOp _ _ lhs rhs _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census lhs)
        rhs)]
    [(IrInstrMaskNot _ src _) (opt-inline-census-value index census src)]
    [(IrInstrMaskReduce _ _ src _) (opt-inline-census-value index census src)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ mask on-true on-false _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census mask)
              on-true)
            on-false)])]
    [(IrInstrVectorLoad _ base idx _ _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census base)
        idx)]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload base idx value _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census base)
              idx)
            value)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload base idx value mask _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value
                index
                (opt-inline-census-value index census base)
                idx)
              value)
            mask)])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload _ base idx mask _ _)
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census base)
              idx)
            mask)])]
    [(IrInstrTailMask _ idx length _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census idx)
        length)]
    [(IrInstrEntryArgc _) census]
    [(IrInstrEntryArgv _) census]
    [(IrInstrEntryEnvp _) census]
    [(IrInstrCpuId _ leaf subleaf _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census leaf)
        subleaf)]
    [(IrInstrXgetbv _ idx) (opt-inline-census-value index census idx)]
    [(IrInstrSyscall _ args) (opt-inline-census-args index census args)]
    [(IrInstrCall _ name args _)
      (opt-inline-census-add-ref
        index
        (opt-inline-census-args index census args)
        name)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base name args _)
          (opt-inline-census-add-ref
            index
            (opt-inline-census-args
              index
              (opt-inline-census-value index census base)
              args)
            name)])]
    [(IrInstrCallIndirect _ func args _)
      (opt-inline-census-args
        index
        (opt-inline-census-value index census func)
        args)]
    [(IrInstrCallIndirectC _ func args _)
      (opt-inline-census-args
        index
        (opt-inline-census-value index census func)
        args)]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload base func args _)
          (opt-inline-census-args
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census base)
              func)
            args)])]
    [(IrInstrTailCall name args _)
      (opt-inline-census-add-ref
        index
        (opt-inline-census-args index census args)
        name)]
    [(IrInstrStore _ value _) (opt-inline-census-value index census value)]
    [(IrInstrJump _) census]
    [(IrInstrBranch cond _ _) (opt-inline-census-value index census cond)]
    [(IrInstrReturn maybe) (opt-inline-census-maybe-value index census maybe)]
    [(IrInstrPhi _ inputs _) (opt-inline-census-phi-inputs index census inputs)]
    ;; #2386: register-group ops use their operands (Pack: each word; Word: src).
    [(IrInstrPack _ words _) (opt-inline-census-value-list index census words)]
    [(IrInstrWord _ src _ _) (opt-inline-census-value index census src)]
    [(IrInstrTailCallIndirect func args _)
      (opt-inline-census-args
        index
        (opt-inline-census-value index census func)
        args)]))

(define (opt-inline-census-instr-seq-from
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [instrs : CompilerIrInstrSeq]
  [instr-index : i64]) : OptInlineCensus
  (if (>= instr-index (compiler-ir-instr-seq-count instrs))
    census
    (opt-inline-census-instr-seq-from
      index
      (opt-inline-census-instr
        index
        census
        (compiler-ir-instr-seq-ref instrs instr-index))
      instrs
      (+ instr-index 1))))

(define (opt-inline-census-instr-seq
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [instrs : CompilerIrInstrSeq]) : OptInlineCensus
  (opt-inline-census-instr-seq-from index census instrs 0))

(define (opt-inline-census-blocks
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [blocks : CompilerIrBlockList]) : OptInlineCensus
  (match blocks
    [(IrBlockNil) census]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-inline-census-blocks
            index
            (opt-inline-census-instr-seq index census instrs)
            (box-get rest))])]
    [(IrBlockArray seq)
      (opt-inline-census-blocks
        index
        census
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-census-function
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func : CompilerIrFunction]) : OptInlineCensus
  (match func
    [(IrFunction _ _ _ _ blocks) (opt-inline-census-blocks index census blocks)]))

(define (opt-inline-census-functions
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [functions : CompilerIrFunctionList]) : OptInlineCensus
  (match functions
    [(IrFunctionNil) census]
    [(IrFunctionCons func rest)
      (opt-inline-census-functions
        index
        (opt-inline-census-function index census func)
        (box-get rest))]
    [(IrFunctionArray seq)
      (opt-inline-census-functions
        index
        census
        (compiler-ir-function-seq-to-list seq))]))

(define (opt-inline-census-build
  [index : OptFunctionIndex]
  [functions : CompilerIrFunctionList]) : OptInlineCensus
  (let
    [capacity : i64 (opt-inline-census-capacity index)]
    (opt-inline-census-functions
      index
      (OptInlineCensus
        (string-i64-map-with-capacity capacity)
        (string-i64-map-with-capacity capacity))
      functions)))

(define (opt-inline-census-refcount [census : OptInlineCensus] [name : String]) : i64
  (match (string-i64-map-get (struct-get census refcount) name)
    [(StringI64MapFound count) count]
    [(StringI64MapMissing) 0]))

(define (opt-inline-census-address-taken?
  [census : OptInlineCensus]
  [name : String]) : bool
  (string-i64-map-contains? (struct-get census addrtaken) name))

(define (opt-inline-census-absorbable?
  [census : OptInlineCensus]
  [caller-name : String]
  [callee-name : String]) : bool
  (and
    (= (opt-inline-census-refcount census callee-name) 1)
    (not (opt-inline-census-address-taken? census callee-name))
    (not (string-eq callee-name "main"))
    (not (string-eq caller-name callee-name))))

(define (opt-callgraph-callee-count [graph : OptCallGraph] [from-slot : i64]) : i64
  (if (or (< from-slot 0) (>= from-slot (struct-get graph count)))
    -1
    (opt-slot-list-count (array-ref (struct-get graph edges) from-slot))))

(define (opt-callgraph-has-edge?
  [graph : OptCallGraph]
  [from-slot : i64]
  [to-slot : i64]) : bool
  (if (or
    (< from-slot 0)
    (< to-slot 0)
    (>= from-slot (struct-get graph count))
    (>= to-slot (struct-get graph count)))
    false
    (opt-slot-list-contains?
      (array-ref (struct-get graph edges) from-slot)
      to-slot)))

(define (opt-scc-set-low-min!
  [lowlink : (Array i64)]
  [slot : i64]
  [candidate : i64]) : unit
  (let
    [old : i64 (array-ref lowlink slot)]
    (if (< candidate old)
      (array-set! lowlink slot candidate)
      unit)))

(define (opt-scc-next-child-from
  [slots : OptSlotList]
  [after : i64]
  [best : i64]) : i64
  (match slots
    [(OptSlotNil) best]
    [(OptSlotCons slot rest)
      (opt-scc-next-child-from
        (box-get rest)
        after
        (if (and (> slot after) (or (< best 0) (< slot best)))
          slot
          best))]))

(define (opt-scc-next-child [graph : OptCallGraph] [slot : i64] [after : i64]) : i64
  (if (or (< slot 0) (>= slot (struct-get graph count)))
    (- 0 1)
    (opt-scc-next-child-from
      (array-ref (struct-get graph edges) slot)
      after
      (- 0 1))))

(define (opt-scc-discover!
  [slot : i64]
  [indices : (Array i64)]
  [lowlink : (Array i64)]
  [on-stack : (Array bool)]
  [node-stack : (Array i64)]
  [node-stack-len : i64]
  [next-index : i64]) : OptSccDiscoverState
  (begin
    (array-set! indices slot next-index)
    (array-set! lowlink slot next-index)
    (array-set! on-stack slot true)
    (array-set! node-stack node-stack-len slot)
    (OptSccDiscoverState (+ next-index 1) (+ node-stack-len 1))))

(define (opt-scc-frame-push!
  [frame-slots : (Array i64)]
  [frame-nexts : (Array i64)]
  [frame-len : i64]
  [slot : i64]) : i64
  (begin
    (array-set! frame-slots frame-len slot)
    (array-set! frame-nexts frame-len (- 0 1))
    (+ frame-len 1)))

(define (opt-scc-pop-component!
  [node-stack : (Array i64)]
  [node-stack-len : i64]
  [on-stack : (Array bool)]
  [scc-of : (Array i64)]
  [root : i64]
  [scc-id : i64]) : OptSccPopState
  (let
    [len : i64 node-stack-len]
    [done : bool false]
    [members : i64 0]
    (begin
      (while (not done)
        (let
          [next-len : i64 (- len 1)]
          [slot : i64 (array-ref node-stack next-len)]
          (begin
            (set! len next-len)
            (array-set! on-stack slot false)
            (array-set! scc-of slot scc-id)
            (set! members (+ members 1))
            (if (= slot root)
              (set! done true)
              unit))))
      (OptSccPopState len members))))

(define (opt-scc-copy-order [source : (Array i64)] [count : i64]) : (Array i64)
  (let
    [out : (Array i64) (make-array i64 count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set! out index (array-ref source index))
          (set! index (+ index 1))))
      out)))

(define (opt-scc-compute [graph : OptCallGraph]) : OptSccResult
  (let
    [count : i64 (struct-get graph count)]
    [indices : (Array i64) (make-array i64 count)]
    [lowlink : (Array i64) (make-array i64 count)]
    [on-stack : (Array bool) (make-array bool count)]
    [scc-of : (Array i64) (make-array i64 count)]
    [node-stack : (Array i64) (make-array i64 count)]
    [frame-slots : (Array i64) (make-array i64 count)]
    [frame-nexts : (Array i64) (make-array i64 count)]
    [order-scratch : (Array i64) (make-array i64 count)]
    [root : i64 0]
    [next-index : i64 0]
    [node-stack-len : i64 0]
    [frame-len : i64 0]
    [scc-count : i64 0]
    (begin
      (opt-cfg-fill-i64! indices count (- 0 1))
      (opt-cfg-fill-i64! lowlink count (- 0 1))
      (opt-cfg-fill-bool! on-stack count false)
      (opt-cfg-fill-i64! scc-of count (- 0 1))
      (opt-cfg-fill-i64! order-scratch count (- 0 1))
      (while (< root count)
        (begin
          (if (= (array-ref indices root) (- 0 1))
            (begin
              (match (opt-scc-discover!
                root
                indices
                lowlink
                on-stack
                node-stack
                node-stack-len
                next-index)
                [(OptSccDiscoverState next stack-len)
                  (begin
                    (set! next-index next)
                    (set! node-stack-len stack-len))])
              (set!
                frame-len
                (opt-scc-frame-push! frame-slots frame-nexts frame-len root))
              (while (> frame-len 0)
                (let
                  [frame-index : i64 (- frame-len 1)]
                  [slot : i64 (array-ref frame-slots frame-index)]
                  [child : i64
                    (opt-scc-next-child
                      graph
                      slot
                      (array-ref frame-nexts frame-index))]
                  (if (>= child 0)
                    (begin
                      (array-set! frame-nexts frame-index child)
                      (if (= (array-ref indices child) (- 0 1))
                        (begin
                          (match (opt-scc-discover!
                            child
                            indices
                            lowlink
                            on-stack
                            node-stack
                            node-stack-len
                            next-index)
                            [(OptSccDiscoverState next stack-len)
                              (begin
                                (set! next-index next)
                                (set! node-stack-len stack-len))])
                          (set!
                            frame-len
                            (opt-scc-frame-push!
                              frame-slots
                              frame-nexts
                              frame-len
                              child)))
                        (if (array-ref on-stack child)
                          (opt-scc-set-low-min!
                            lowlink
                            slot
                            (array-ref indices child))
                          unit)))
                    (begin
                      (if (= (array-ref lowlink slot) (array-ref indices slot))
                        (match (opt-scc-pop-component!
                          node-stack
                          node-stack-len
                          on-stack
                          scc-of
                          slot
                          scc-count)
                          [(OptSccPopState stack-len _)
                            (begin
                              (set! node-stack-len stack-len)
                              (array-set! order-scratch scc-count scc-count)
                              (set! scc-count (+ scc-count 1)))])
                        unit)
                      (set! frame-len (- frame-len 1))
                      (if (> frame-len 0)
                        (let
                          [parent : i64 (array-ref frame-slots (- frame-len 1))]
                          (opt-scc-set-low-min!
                            lowlink
                            parent
                            (array-ref lowlink slot)))
                        unit))))))
            unit)
          (set! root (+ root 1))))
      (OptSccResult scc-of (opt-scc-copy-order order-scratch scc-count)))))

;; Devirtualize syntactically known function values before program-level
;; inlining, so the existing direct-call inliner can see them.
(define (opt-devirt-known-function-instr [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrCallIndirect dst (IrValueFunction name) args ty)
      (IrInstrCall dst name args ty)]
    [(IrInstrTailCallIndirect (IrValueFunction name) args ty)
      (IrInstrTailCall name args ty)]
    [_ instr]))

(define (opt-devirt-known-function-instrs [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (compiler-ir-instr-cons
        (opt-devirt-known-function-instr instr)
        (opt-devirt-known-function-instrs (box-get rest)))]))

(define (opt-devirt-known-function-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerIrInstrList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    IrInstrNil
    (compiler-ir-instr-cons
      (opt-devirt-known-function-instr (compiler-ir-instr-seq-ref instrs index))
      (opt-devirt-known-function-instr-seq-from instrs (+ index 1)))))

(define (opt-devirt-known-function-instr-seq [instrs : CompilerIrInstrSeq]) : CompilerIrInstrList
  (opt-devirt-known-function-instr-seq-from instrs 0))

(define (opt-devirt-known-function-block [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block label (opt-devirt-known-function-instr-seq instrs))]))

(define (opt-devirt-known-function-blocks [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) (IrBlockNil)]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (opt-devirt-known-function-block block)
        (opt-devirt-known-function-blocks (box-get rest)))]
    [(IrBlockArray seq)
      (opt-devirt-known-function-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-devirt-known-function-function [func : CompilerIrFunction]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret vars blocks)
      (IrFunction
        name
        params
        ret
        vars
        (opt-devirt-known-function-blocks blocks))]))

(define (opt-devirt-known-function-list [functions : CompilerIrFunctionList]) : CompilerIrFunctionList
  (match functions
    [(IrFunctionNil) (IrFunctionNil)]
    [(IrFunctionCons func rest)
      (compiler-ir-function-cons
        (opt-devirt-known-function-function func)
        (opt-devirt-known-function-list (box-get rest)))]
    [(IrFunctionArray seq)
      (compiler-ir-function-list-compact
        (opt-devirt-known-function-list (compiler-ir-function-seq-to-list seq)))]))

;; ---------------------------------------------------------------------------
;; Function inlining (opt level 2 only). Splices the body of small single-block
;; leaf callees into their call sites, removing call/return overhead and exposing
;; the callee's instructions to the caller's folding/DCE/GVN and to register
;; allocation. Reserved for opt2 (the quality build) so the cheap opt1
;; self-compile path pays nothing for it.
;;
;; Determinism: fresh var ids are minted from the caller function's `vars`
;; counter (the same per-function sequential scheme lowering uses), callee bodies
;; are walked in list order, and callees are resolved through the deterministic
;; OptFunctionIndex. Param var ids (0..nparams-1) are substituted with the call's
;; argument values; other callee var ids are compacted by subtracting the dead
;; read-only param slots before shifting by the caller's var count.
;; ---------------------------------------------------------------------------
(defenum OptInlineState
  (OptInlineState CompilerIrInstrList i64 i64))

(defenum OptInlineBlocks
  (OptInlineBlocks CompilerIrBlockList i64 i64))

(defenum OptInlineSpanState
  (OptInlineSpanState CompilerIrInstrList i64 i64 CompilerSourceSpans))

(defenum OptInlineSpanBlocks
  (OptInlineSpanBlocks CompilerIrBlockList i64 i64 CompilerSourceSpans))

(defenum OptInlineSpanProgram
  (OptInlineSpanProgram CompilerIrFunctionList CompilerSourceSpans))

(defenum OptInlineMultiClone
  (OptInlineMultiClone CompilerIrBlockList CompilerIrPhiInputList))

(defenum OptInlineMultiInstrClone
  (OptInlineMultiInstrClone CompilerIrInstrList CompilerIrPhiInputList))

(defenum OptInlineMultiSpanClone
  (OptInlineMultiSpanClone
    CompilerIrBlockList
    CompilerIrPhiInputList
    CompilerSourceSpans))

(defenum OptInlineMultiSpanInstrClone
  (OptInlineMultiSpanInstrClone
    CompilerIrInstrList
    CompilerIrPhiInputList
    CompilerSourceSpans))

(defenum OptInlineMaybeBlockRewrite
  (OptInlineNoBlockRewrite)
  (OptInlineSomeBlockRewrite CompilerIrBlockList i64 i64))

(defenum OptInlineMaybeSpanBlockRewrite
  (OptInlineNoSpanBlockRewrite)
  (OptInlineSomeSpanBlockRewrite
    CompilerIrBlockList
    i64
    i64
    CompilerSourceSpans))

(define (opt-inline-max-body) : i64
  8)

(define (opt-inline-cost-block-weight) : i64
  6)

(define (opt-inline-cost-call-bonus) : i64
  6)

(define (opt-inline-cost-const-arg-bonus) : i64
  3)

(define (opt-inline-cost-threshold) : i64
  4)

(define (opt-inline-cost-absorb-bonus) : i64
  1000)

(define (opt-inline-cost-block-fuel) : i64
  32)

(define (opt-inline-param-count [params : CompilerIrParamList]) : i64
  (match params
    [(IrParamNil) 0]
    [(IrParamCons _ rest) (+ 1 (opt-inline-param-count (box-get rest)))]))

(define (opt-inline-params-sequential? [params : CompilerIrParamList] [i : i64]) : bool
  (match params
    [(IrParamNil) true]
    [(IrParamCons param rest)
      (match param
        [(IrParam _ _ vid)
          (if (= vid i)
            (opt-inline-params-sequential? (box-get rest) (+ i 1))
            false)])]))

(define (opt-inline-is-return? [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrReturn _) true]
    [_ false]))

(define (opt-inline-body-instr-op-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrMov _ _ _) true]
    [(IrInstrGep _ _ _ _) true]
    [(IrInstrLoad _ _ _) true]
    [(IrInstrCast _ _ _ _) true]
    [(IrInstrBitcast _ _ _ _) true]
    [(IrInstrBinOp _ _ _ _ _) true]
    [(IrInstrUnOp _ _ _ _) true]
    [(IrInstrPack _ _ _) true]
    [(IrInstrWord _ _ _ _) true]
    [(IrInstrCall _ _ _ _) true]
    [(IrInstrCallIndirect _ _ _ _) true]
    [(IrInstrCallIndirectC _ _ _ _) true]
    ;; IrInstrBoundsCheck carries a backend label in its String field; copying it
    ;; into a call site duplicates that label (assembler "symbol already defined"),
    ;; so callees containing one are not inlinable.
    [(IrInstrStorePtr _ _ _) true]
    [(IrInstrCopyBytes _ _ _) true]
    [_ false]))

(define (opt-inline-body-instr-ok? [instr : CompilerIrInstr] [np : i64]) : bool
  (match instr
    [(IrInstrMov dst _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrGep dst _ _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrLoad dst _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrCast dst _ _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrBitcast dst _ _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrBinOp dst _ _ _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrUnOp dst _ _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrPack dst _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrWord dst _ _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrCall dst _ _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrCallIndirect dst _ _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [(IrInstrCallIndirectC dst _ _ _)
      (and (>= dst np) (opt-inline-body-instr-op-ok? instr))]
    [_ (opt-inline-body-instr-op-ok? instr)]))

(define (opt-inline-seq-ok? [instrs : CompilerIrInstrList] [np : i64]) : bool
  (match instrs
    [(IrInstrNil) false]
    [(IrInstrCons instr rest)
      (match (box-get rest)
        [(IrInstrNil) (opt-inline-is-return? instr)]
        [_
          (if (opt-inline-body-instr-ok? instr np)
            (opt-inline-seq-ok? (box-get rest) np)
            false)])]))

(define (opt-inline-instr-seq-ok-from?
  [instrs : CompilerIrInstrSeq]
  [np : i64]
  [index : i64]
  [last : i64]) : bool
  (if (> index last)
    false
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (if (= index last)
        (opt-inline-is-return? instr)
        (if (opt-inline-body-instr-ok? instr np)
          (opt-inline-instr-seq-ok-from? instrs np (+ index 1) last)
          false)))))

(define (opt-inline-instr-seq-ok? [instrs : CompilerIrInstrSeq] [np : i64]) : bool
  (opt-inline-instr-seq-ok-from?
    instrs
    np
    0
    (- (compiler-ir-instr-seq-count instrs) 1)))

(define (opt-inline-single-block-ok? [blocks : CompilerIrBlockList] [np : i64]) : bool
  (match blocks
    [(IrBlockCons block rest)
      (match (box-get rest)
        [(IrBlockNil)
          (match block
            [(IrBlock _ seq)
              (let
                [n : i64 (compiler-ir-instr-seq-count seq)]
                (if (< n 1)
                  false
                  (if (> (- n 1) (opt-inline-max-body))
                    false
                    (opt-inline-instr-seq-ok? seq np))))])]
        [_ false])]
    [_ false]))

(define (opt-inline-single-block-cost-instrs [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(IrBlockCons block _)
      (match block
        [(IrBlock _ seq) (- (compiler-ir-instr-seq-count seq) 1)])]
    [_ 0]))

(define (opt-inline-phi-input-label?
  [inputs : CompilerIrPhiInputList]
  [label : String]) : bool
  (match inputs
    [(IrPhiInputNil) false]
    [(IrPhiInputCons _ input-label rest)
      (if (string-eq input-label label)
        true
        (opt-inline-phi-input-label? (box-get rest) label))]))

(define (opt-inline-instr-phi-label? [instr : CompilerIrInstr] [label : String]) : bool
  (match instr
    [(IrInstrPhi _ inputs _) (opt-inline-phi-input-label? inputs label)]
    [_ false]))

(define (opt-inline-instr-seq-phi-label-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [label : String]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-inline-instr-phi-label?
      (compiler-ir-instr-seq-ref instrs index)
      label)
      true
      (opt-inline-instr-seq-phi-label-from? instrs (+ index 1) label))))

(define (opt-inline-instr-seq-phi-label?
  [instrs : CompilerIrInstrSeq]
  [label : String]) : bool
  (opt-inline-instr-seq-phi-label-from? instrs 0 label))

(define (opt-inline-blocks-phi-label?
  [blocks : CompilerIrBlockList]
  [label : String]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-inline-instr-seq-phi-label? instrs label)
            true
            (opt-inline-blocks-phi-label? (box-get rest) label))])]
    [(IrBlockArray seq)
      (opt-inline-blocks-phi-label? (compiler-ir-block-seq-to-list seq) label)]))

(define (opt-inline-multiblock-instr-ok? [instr : CompilerIrInstr] [_np : i64]) : bool
  (match instr
    [(IrInstrJump _) true]
    [(IrInstrBranch _ _ _) true]
    [(IrInstrReturn _) true]
    [(IrInstrPhi dst _ _) (>= dst 0)]
    [_ (opt-inline-body-instr-op-ok? instr)]))

(define (opt-inline-multiblock-instrs-ok-from?
  [instrs : CompilerIrInstrSeq]
  [np : i64]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    true
    (if (opt-inline-multiblock-instr-ok?
      (compiler-ir-instr-seq-ref instrs index)
      np)
      (opt-inline-multiblock-instrs-ok-from? instrs np (+ index 1))
      false)))

(define (opt-inline-multiblock-instrs-ok?
  [instrs : CompilerIrInstrSeq]
  [np : i64]) : bool
  (opt-inline-multiblock-instrs-ok-from? instrs np 0))

(define (opt-inline-multiblock-blocks-ok?
  [blocks : CompilerIrBlockList]
  [np : i64]) : bool
  (match blocks
    [(IrBlockNil) true]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (and
            (opt-inline-multiblock-instrs-ok? instrs np)
            (opt-inline-multiblock-blocks-ok? (box-get rest) np))])]
    [(IrBlockArray seq)
      (opt-inline-multiblock-blocks-ok? (compiler-ir-block-seq-to-list seq) np)]))

(define (opt-inline-param-mutating-instr? [instr : CompilerIrInstr] [np : i64]) : bool
  (match (opt-instr-def-var instr)
    [(OptSomeI64 var) (< var np)]
    [(OptNoI64) false]))

(define (opt-inline-param-mutating-instrs-from?
  [instrs : CompilerIrInstrSeq]
  [np : i64]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (if (opt-inline-param-mutating-instr?
      (compiler-ir-instr-seq-ref instrs index)
      np)
      true
      (opt-inline-param-mutating-instrs-from? instrs np (+ index 1)))))

(define (opt-inline-param-mutating-instrs?
  [instrs : CompilerIrInstrSeq]
  [np : i64]) : bool
  (opt-inline-param-mutating-instrs-from? instrs np 0))

(define (opt-inline-param-mutating-blocks?
  [blocks : CompilerIrBlockList]
  [np : i64]) : bool
  (match blocks
    [(IrBlockNil) false]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (if (opt-inline-param-mutating-instrs? instrs np)
            true
            (opt-inline-param-mutating-blocks? (box-get rest) np))])]
    [(IrBlockArray seq)
      (opt-inline-param-mutating-blocks? (compiler-ir-block-seq-to-list seq) np)]))

(define (opt-inline-return-count-instrs-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    count
    (opt-inline-return-count-instrs-from
      instrs
      (+ index 1)
      (match (compiler-ir-instr-seq-ref instrs index)
        [(IrInstrReturn _) (+ count 1)]
        [_ count]))))

(define (opt-inline-return-count-instrs [instrs : CompilerIrInstrSeq]) : i64
  (opt-inline-return-count-instrs-from instrs 0 0))

(define (opt-inline-return-count-blocks [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(IrBlockNil) 0]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (+
            (opt-inline-return-count-instrs instrs)
            (opt-inline-return-count-blocks (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-inline-return-count-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-cost-instrs-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (compiler-ir-instr-seq-count instrs))
    count
    (opt-inline-cost-instrs-from
      instrs
      (+ index 1)
      (match (compiler-ir-instr-seq-ref instrs index)
        [(IrInstrReturn _) count]
        [_ (+ count 1)]))))

(define (opt-inline-cost-instrs [instrs : CompilerIrInstrSeq]) : i64
  (opt-inline-cost-instrs-from instrs 0 0))

(define (opt-inline-multiblock-cost-instrs [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(IrBlockNil) 0]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (+
            (opt-inline-cost-instrs instrs)
            (opt-inline-multiblock-cost-instrs (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-inline-multiblock-cost-instrs (compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-forward-successors?
  [index : OptCfgIndex]
  [source-id : i64]
  [succs : OptLabelSet]) : bool
  (match succs
    [(OptLabelNil) true]
    [(OptLabelCons label rest)
      (match (opt-cfg-index-id index label)
        [(OptSomeI64 target-id)
          (and
            (> target-id source-id)
            (opt-inline-forward-successors? index source-id (box-get rest)))]
        [(OptNoI64) false])]))

(define (opt-inline-forward-edges-from?
  [index : OptCfgIndex]
  [id : i64]
  [count : i64]) : bool
  (if (>= id count)
    true
    (if (opt-inline-forward-successors?
      index
      id
      (opt-cfg-index-successors index (opt-cfg-index-label index id)))
      (opt-inline-forward-edges-from? index (+ id 1) count)
      false)))

(define (opt-inline-callee-acyclic? [blocks : CompilerIrBlockList]) : bool
  (let
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    (opt-inline-forward-edges-from? index 0 (opt-cfg-index-block-count index))))

(define (opt-inline-multiblock-callee-ok?
  [callee : CompilerIrFunction]
  [caller-name : String]) : bool
  (match callee
    [(IrFunction cname cparams _ cvars cblocks)
      (if (string-eq cname caller-name)
        false
        (let
          [np : i64 (opt-inline-param-count cparams)]
          (and
            (opt-inline-params-sequential? cparams 0)
            (>= cvars np)
            (> (compiler-ir-block-list-count cblocks) 1)
            (> (opt-inline-return-count-blocks cblocks) 0)
            (opt-inline-structure-ok? cblocks)
            (opt-inline-multiblock-blocks-ok? cblocks np))))]))

(define (opt-inline-callee-ok?
  [callee : CompilerIrFunction]
  [caller-name : String]) : bool
  (match callee
    [(IrFunction cname cparams _ cvars cblocks)
      (if (string-eq cname caller-name)
        false
        (let
          [np : i64 (opt-inline-param-count cparams)]
          (if (opt-inline-params-sequential? cparams 0)
            (if (>= cvars np)
              (opt-inline-single-block-ok? cblocks np)
              false)
            false)))]))

(define (opt-inline-arity-ok? [args : CompilerIrCallArgs] [np : i64]) : bool
  (match args
    [(IrCallArgsNil) (= np 0)]
    [(IrCallArgsOne _) (= np 1)]
    [(IrCallArgsTwo _ _) (= np 2)]
    [(IrCallArgsArray arr) (= np (array-length arr))]))

(define (opt-inline-value-constant? [value : CompilerIrValue]) : bool
  (match value
    [(IrValueVar _) false]
    [_ true]))

(define (opt-inline-args-array-const-count
  [values : (Array CompilerIrValue)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (array-length values))
    count
    (opt-inline-args-array-const-count
      values
      (+ index 1)
      (if (opt-inline-value-constant? (array-ref values index))
        (+ count 1)
        count))))

(define (opt-inline-args-const-count [args : CompilerIrCallArgs]) : i64
  (match args
    [(IrCallArgsNil) 0]
    [(IrCallArgsOne value)
      (if (opt-inline-value-constant? value)
        1
        0)]
    [(IrCallArgsTwo a b)
      (+
        (if (opt-inline-value-constant? a)
          1
          0)
        (if (opt-inline-value-constant? b)
          1
          0))]
    [(IrCallArgsArray values) (opt-inline-args-array-const-count values 0 0)]))

(define (opt-inline-cost-min [a : i64] [b : i64]) : i64
  (if (< a b)
    a
    b))

(define (opt-inline-cost-crosses-heavy-gate?
  [caller-blocks : i64]
  [added-so-far : i64]
  [added-blocks : i64]) : bool
  (and
    (<= caller-blocks (opt-heavy-pass-block-limit))
    (>
      (+ caller-blocks (+ added-so-far added-blocks))
      (opt-heavy-pass-block-limit))))

(define (opt-inline-cost-inline?
  [callee-instrs : i64]
  [added-blocks : i64]
  [const-args : i64]
  [absorbable : bool]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (if (opt-inline-cost-crosses-heavy-gate?
    caller-blocks
    added-so-far
    added-blocks)
    false
    (if (> (+ added-so-far added-blocks) (opt-inline-cost-block-fuel))
      false
      (let
        [raw : i64
          (+ callee-instrs (* (opt-inline-cost-block-weight) added-blocks))]
        [const-savings : i64
          (opt-inline-cost-min
            raw
            (* (opt-inline-cost-const-arg-bonus) const-args))]
        [net : i64
          (-
            (- (- raw const-savings) (opt-inline-cost-call-bonus))
            (if absorbable
              (opt-inline-cost-absorb-bonus)
              0))]
        (<= net (opt-inline-cost-threshold))))))

(define (opt-inline-rebase-var [id : i64] [np : i64] [base : i64]) : i64
  (+ base (- id np)))

(define (opt-inline-frame-growth [frame : i64] [np : i64]) : i64
  (- frame np))

(define (opt-inline-stage-arg-var [base : i64] [id : i64]) : CompilerIrValue
  (IrValueVar (+ base id)))

(define (opt-inline-staged-args-array-fill!
  [out : (Array CompilerIrValue)]
  [base : i64]
  [index : i64]) : unit
  (if (>= index (array-length out))
    unit
    (begin
      (array-set! out index (opt-inline-stage-arg-var base index))
      (opt-inline-staged-args-array-fill! out base (+ index 1)))))

(define (opt-inline-staged-args [np : i64] [base : i64]) : CompilerIrCallArgs
  (cond
    [(= np 0) (IrCallArgsNil)]
    [(= np 1) (IrCallArgsOne (opt-inline-stage-arg-var base 0))]
    [(= np 2)
      (IrCallArgsTwo
        (opt-inline-stage-arg-var base 0)
        (opt-inline-stage-arg-var base 1))]
    [else
      (let
        [out : (Array CompilerIrValue) (make-array CompilerIrValue np)]
        (begin
          (opt-inline-staged-args-array-fill! out base 0)
          (IrCallArgsArray out)))]))

(define (opt-inline-stage-param-instrs
  [params : CompilerIrParamList]
  [args : CompilerIrCallArgs]
  [base : i64]
  [index : i64]) : CompilerIrInstrList
  (match params
    [(IrParamNil) IrInstrNil]
    [(IrParamCons param rest)
      (match param
        [(IrParam _ ty _)
          (compiler-ir-instr-cons
            (IrInstrMov
              (+ base index)
              (opt-inline-clone-arg-at args index)
              (clone ty))
            (opt-inline-stage-param-instrs (box-get rest) args base (+ index 1)))])]))

(define (opt-inline-clone-arg-at [sa : CompilerIrCallArgs] [id : i64]) : CompilerIrValue
  (match sa
    [(IrCallArgsNil) (IrValueUnit)]
    [(IrCallArgsOne a) (compiler-ir-clone-value a)]
    [(IrCallArgsTwo a b)
      (if (= id 0)
        (compiler-ir-clone-value a)
        (compiler-ir-clone-value b))]
    [(IrCallArgsArray arr) (compiler-ir-clone-value (array-ref arr id))]))

(define (opt-inline-remap-value
  [v : CompilerIrValue]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrValue
  (match v
    [(IrValueVar id)
      (if (< id np)
        (opt-inline-clone-arg-at sa id)
        (IrValueVar (opt-inline-rebase-var id np base)))]
    [(IrValueGlobal name) (IrValueGlobal (clone name))]
    [(IrValueGlobalAddr name) (IrValueGlobalAddr (clone name))]
    [(IrValueFunction name) (IrValueFunction (clone name))]
    [(IrValueI64 n) (IrValueI64 n)]
    [(IrValueF64 bits) (IrValueF64 bits)]
    [(IrValueBool b) (IrValueBool b)]
    [(IrValueChar c) (IrValueChar c)]
    [(IrValueString s) (IrValueString (clone s))]
    [(IrValueBytes s) (IrValueBytes (clone s))]
    [(IrValueUnit) (IrValueUnit)]))

(define (opt-inline-remap-args
  [a : CompilerIrCallArgs]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrCallArgs
  (match a
    [(IrCallArgsNil) (IrCallArgsNil)]
    [(IrCallArgsOne x) (IrCallArgsOne (opt-inline-remap-value x sa np base))]
    [(IrCallArgsTwo x y)
      (IrCallArgsTwo
        (opt-inline-remap-value x sa np base)
        (opt-inline-remap-value y sa np base))]
    [(IrCallArgsArray arr)
      (let
        [n : i64 (array-length arr)]
        [out : (Array CompilerIrValue) (make-array CompilerIrValue n)]
        [i : i64 0]
        (begin
          (while (< i n)
            (begin
              (array-set!
                out
                i
                (opt-inline-remap-value (array-ref arr i) sa np base))
              (set! i (+ i 1))))
          (IrCallArgsArray out)))]))

(define (opt-inline-remap-value-list
  [values : CompilerIrValueList]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrValueList
  (match values
    [(IrValueNil) IrValueNil]
    [(IrValueCons value rest)
      (compiler-ir-value-cons
        (opt-inline-remap-value value sa np base)
        (opt-inline-remap-value-list (box-get rest) sa np base))]))

(define (opt-inline-clone-instr
  [instr : CompilerIrInstr]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrInstr
  (match instr
    [(IrInstrMov dst src ty)
      (IrInstrMov
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone ty))]
    [(IrInstrGep dst b o ty)
      (IrInstrGep
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value b sa np base)
        (opt-inline-remap-value o sa np base)
        (clone ty))]
    [(IrInstrLoad dst src ty)
      (IrInstrLoad
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone ty))]
    [(IrInstrCast dst src from to)
      (IrInstrCast
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone from)
        (clone to))]
    [(IrInstrBitcast dst src from to)
      (IrInstrBitcast
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone from)
        (clone to))]
    [(IrInstrBinOp dst op lhs rhs ty)
      (IrInstrBinOp
        (opt-inline-rebase-var dst np base)
        op
        (opt-inline-remap-value lhs sa np base)
        (opt-inline-remap-value rhs sa np base)
        (clone ty))]
    [(IrInstrUnOp dst op src ty)
      (IrInstrUnOp
        (opt-inline-rebase-var dst np base)
        op
        (opt-inline-remap-value src sa np base)
        (clone ty))]
    ;; #2634: Pack/Word were made inline-eligible by #2629 without remap arms,
    ;; so inlined register-group instructions kept their CALLEE-local var ids
    ;; inside the caller -- the third opt2 self-build miscompile (the
    ;; stage2/stage3 fixpoint diverged and no-regalloc builds bounds-aborted
    ;; in intern-str on garbage ids).
    [(IrInstrPack dst words ty)
      (IrInstrPack
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value-list words sa np base)
        (clone ty))]
    [(IrInstrWord dst src index ty)
      (IrInstrWord
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        index
        (clone ty))]
    [(IrInstrBoundsCheck idx len msg)
      (IrInstrBoundsCheck
        (opt-inline-remap-value idx sa np base)
        (opt-inline-remap-value len sa np base)
        (clone msg))]
    [(IrInstrStorePtr d s ty)
      (IrInstrStorePtr
        (opt-inline-remap-value d sa np base)
        (opt-inline-remap-value s sa np base)
        (clone ty))]
    [(IrInstrCopyBytes d s size)
      (IrInstrCopyBytes
        (opt-inline-remap-value d sa np base)
        (opt-inline-remap-value s sa np base)
        size)]
    [(IrInstrCall dst name a ty)
      (IrInstrCall
        (opt-inline-rebase-var dst np base)
        (clone name)
        (opt-inline-remap-args a sa np base)
        (clone ty))]
    [(IrInstrCallIndirect dst callee a ty)
      (IrInstrCallIndirect
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value callee sa np base)
        (opt-inline-remap-args a sa np base)
        (clone ty))]
    [(IrInstrCallIndirectC dst callee a ty)
      (IrInstrCallIndirectC
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value callee sa np base)
        (opt-inline-remap-args a sa np base)
        (clone ty))]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload call-base name a slots)
          (ir-instr-call-cabi-store-result
            (opt-inline-remap-value call-base sa np base)
            (clone name)
            (opt-inline-remap-args a sa np base)
            slots)])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload
            call-base
            callee
            a
            slots)
          (ir-instr-call-indirect-cabi-store-result
            (opt-inline-remap-value call-base sa np base)
            (opt-inline-remap-value callee sa np base)
            (opt-inline-remap-args a sa np base)
            slots)])]
    [_ instr]))

(define (opt-inline-return->mov
  [instr : CompilerIrInstr]
  [dst : i64]
  [ret : AstType]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrInstr
  (match instr
    [(IrInstrReturn maybe)
      (match maybe
        [(IrSomeValue v)
          (IrInstrMov dst (opt-inline-remap-value v sa np base) (clone ret))]
        [(IrNoValue) (IrInstrMov dst (IrValueUnit) (clone ret))])]
    [_ (IrInstrMov dst (IrValueUnit) (clone ret))]))

(define (opt-inline-expand-instrs
  [instrs : CompilerIrInstrList]
  [dst : i64]
  [ret : AstType]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) IrInstrNil]
    [(IrInstrCons instr rest)
      (match (box-get rest)
        [(IrInstrNil)
          (compiler-ir-instr-cons
            (opt-inline-return->mov instr dst ret sa np base)
            IrInstrNil)]
        [_
          (compiler-ir-instr-cons
            (opt-inline-clone-instr instr sa np base)
            (opt-inline-expand-instrs (box-get rest) dst ret sa np base))])]))

;; Span policy for inlined clones: prefer the callee instruction's original
;; source span under the clone's new caller/value key. If the callee instruction
;; has no recorded span (notably the synthetic return->mov), use the call-site
;; span so the cloned instruction still points at useful user code.
(define (opt-inline-record-clone-span
  [source-spans : CompilerSourceSpans]
  [out : CompilerSourceSpans]
  [caller : String]
  [call-instr : CompilerIrInstr]
  [callee : String]
  [callee-instr : CompilerIrInstr]
  [cloned : CompilerIrInstr]) : CompilerSourceSpans
  (match (compiler-source-spans-lookup-instr source-spans callee callee-instr)
    [(CompilerSomeSourceSpan span)
      (compiler-source-spans-insert-instr out caller cloned span)]
    [(CompilerNoSourceSpan)
      (match (compiler-source-spans-lookup-instr source-spans caller call-instr)
        [(CompilerSomeSourceSpan span)
          (compiler-source-spans-insert-instr out caller cloned span)]
        [(CompilerNoSourceSpan) out])]))

(define (opt-inline-expand-instrs-with-spans
  [instrs : CompilerIrInstrList]
  [dst : i64]
  [ret : AstType]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [caller : String]
  [call-instr : CompilerIrInstr]
  [callee : String]) : OptInlineSpanState
  (match instrs
    [(IrInstrNil) (OptInlineSpanState IrInstrNil base 0 out-spans)]
    [(IrInstrCons instr rest)
      (match (box-get rest)
        [(IrInstrNil)
          (let
            [moved : CompilerIrInstr
              (opt-inline-return->mov instr dst ret sa np base)]
            [next-spans : CompilerSourceSpans
              (opt-inline-record-clone-span
                source-spans
                out-spans
                caller
                call-instr
                callee
                instr
                moved)]
            (OptInlineSpanState
              (compiler-ir-instr-cons moved IrInstrNil)
              base
              0
              next-spans))]
        [_
          (let
            [cloned : CompilerIrInstr (opt-inline-clone-instr instr sa np base)]
            [next-spans : CompilerSourceSpans
              (opt-inline-record-clone-span
                source-spans
                out-spans
                caller
                call-instr
                callee
                instr
                cloned)]
            (match (opt-inline-expand-instrs-with-spans
              (box-get rest)
              dst
              ret
              sa
              np
              base
              source-spans
              next-spans
              caller
              call-instr
              callee)
              [(OptInlineSpanState rest-instrs next-vars _ final-spans)
                (OptInlineSpanState
                  (compiler-ir-instr-cons cloned rest-instrs)
                  next-vars
                  0
                  final-spans)]))])]))

(define (opt-inline-single-block-instrs [blocks : CompilerIrBlockList]) : CompilerIrInstrList
  (match blocks
    [(IrBlockCons block _)
      (match block
        [(IrBlock _ seq) (opt-aggregate-instr-seq-append-from seq 0 IrInstrNil)])]
    [_ IrInstrNil]))

(define (opt-inline-append [a : CompilerIrInstrList] [b : CompilerIrInstrList]) : CompilerIrInstrList
  (match a
    [(IrInstrNil) b]
    [(IrInstrCons instr rest)
      (compiler-ir-instr-cons instr (opt-inline-append (box-get rest) b))]))

(define (opt-inline-block-append
  [a : CompilerIrBlockList]
  [b : CompilerIrBlockList]) : CompilerIrBlockList
  (match a
    [(IrBlockNil) b]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons block (opt-inline-block-append (box-get rest) b))]
    [(IrBlockArray seq)
      (opt-inline-block-append (compiler-ir-block-seq-to-list seq) b)]))

(define (opt-inline-site-prefix
  [_func-name : String]
  [block-label : String]
  [pos : i64]
  [_callee-name : String]) : String
  (string-append
    (string-append (string-append "inl." block-label) ".")
    (int->string pos)))

(define (opt-inline-prefix-label [prefix : String] [label : String]) : String
  (string-append (string-append prefix ".") label))

(define (opt-inline-cont-label [prefix : String]) : String
  (string-append prefix ".cont"))

(define (opt-inline-remap-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [prefix : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrPhiInputList
  (match inputs
    [(IrPhiInputNil) IrPhiInputNil]
    [(IrPhiInputCons value label rest)
      (compiler-ir-phi-input-cons
        (opt-inline-remap-value value sa np base)
        (opt-inline-prefix-label prefix label)
        (opt-inline-remap-phi-inputs (box-get rest) prefix sa np base))]))

(define (opt-inline-clone-multiblock-instr
  [instr : CompilerIrInstr]
  [prefix : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrInstr
  (match instr
    [(IrInstrJump label) (IrInstrJump (opt-inline-prefix-label prefix label))]
    [(IrInstrBranch cond true-label false-label)
      (IrInstrBranch
        (opt-inline-remap-value cond sa np base)
        (opt-inline-prefix-label prefix true-label)
        (opt-inline-prefix-label prefix false-label))]
    [(IrInstrPhi dst inputs ty)
      (IrInstrPhi
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-phi-inputs inputs prefix sa np base)
        (clone ty))]
    [_ (opt-inline-clone-instr instr sa np base)]))

(define (opt-inline-return-value
  [maybe : CompilerIrMaybeValue]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : CompilerIrValue
  (match maybe
    [(IrSomeValue value) (opt-inline-remap-value value sa np base)]
    [(IrNoValue) (IrValueUnit)]))

(define (opt-inline-clone-multiblock-instrs
  [instrs : CompilerIrInstrList]
  [cloned-label : String]
  [prefix : String]
  [cont-label : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiInstrClone
  (match instrs
    [(IrInstrNil) (OptInlineMultiInstrClone IrInstrNil IrPhiInputNil)]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrReturn maybe)
          (OptInlineMultiInstrClone
            (compiler-ir-instr-cons (IrInstrJump cont-label) IrInstrNil)
            (compiler-ir-phi-input-cons
              (opt-inline-return-value maybe sa np base)
              cloned-label
              IrPhiInputNil))]
        [_
          (let
            [cloned : CompilerIrInstr
              (opt-inline-clone-multiblock-instr instr prefix sa np base)]
            (match (opt-inline-clone-multiblock-instrs
              (box-get rest)
              cloned-label
              prefix
              cont-label
              sa
              np
              base)
              [(OptInlineMultiInstrClone rest-instrs rest-inputs)
                (OptInlineMultiInstrClone
                  (compiler-ir-instr-cons cloned rest-instrs)
                  rest-inputs)]))])]))

(define (opt-inline-clone-multiblock-block
  [block : CompilerIrBlock]
  [prefix : String]
  [cont-label : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiClone
  (match block
    [(IrBlock label instrs)
      (let
        [cloned-label : String (opt-inline-prefix-label prefix label)]
        (match (opt-inline-clone-multiblock-instrs
          (compiler-ir-instr-seq-to-list instrs)
          cloned-label
          prefix
          cont-label
          sa
          np
          base)
          [(OptInlineMultiInstrClone cloned-instrs inputs)
            (OptInlineMultiClone
              (compiler-ir-block-cons
                (compiler-ir-block cloned-label cloned-instrs)
                IrBlockNil)
              inputs)]))]))

(define (opt-inline-clone-multiblock-blocks
  [blocks : CompilerIrBlockList]
  [prefix : String]
  [cont-label : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiClone
  (match blocks
    [(IrBlockNil) (OptInlineMultiClone IrBlockNil IrPhiInputNil)]
    [(IrBlockCons block rest)
      (match (opt-inline-clone-multiblock-block
        block
        prefix
        cont-label
        sa
        np
        base)
        [(OptInlineMultiClone one-block one-inputs)
          (match (opt-inline-clone-multiblock-blocks
            (box-get rest)
            prefix
            cont-label
            sa
            np
            base)
            [(OptInlineMultiClone rest-blocks rest-inputs)
              (OptInlineMultiClone
                (opt-inline-block-append one-block rest-blocks)
                (compiler-ir-phi-input-list-reverse-onto one-inputs rest-inputs))])])]
    [(IrBlockArray seq)
      (opt-inline-clone-multiblock-blocks
        (compiler-ir-block-seq-to-list seq)
        prefix
        cont-label
        sa
        np
        base)]))

(define (opt-inline-cont-result-instr
  [dst : i64]
  [inputs : CompilerIrPhiInputList]
  [ret : AstType]) : CompilerIrInstr
  (match inputs
    [(IrPhiInputCons value _ rest)
      (match (box-get rest)
        [(IrPhiInputNil)
          (IrInstrMov dst (compiler-ir-clone-value value) (clone ret))]
        [_ (IrInstrPhi dst inputs (clone ret))])]
    [(IrPhiInputNil) (IrInstrMov dst (IrValueUnit) (clone ret))]))

(define (opt-inline-call-span-to-instr
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [func-name : String]
  [call-instr : CompilerIrInstr]
  [new-instr : CompilerIrInstr]) : CompilerSourceSpans
  (match (compiler-source-spans-lookup-instr source-spans func-name call-instr)
    [(CompilerSomeSourceSpan span)
      (compiler-source-spans-insert-instr out-spans func-name new-instr span)]
    [(CompilerNoSourceSpan) out-spans]))

(define (opt-inline-lookup-inlinable
  [index : OptFunctionIndex]
  [cname : String]
  [caller-name : String]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptMaybeFunction
  (match (opt-function-index-slot index cname)
    [(OptSomeI64 callee-slot)
      (if (and
        (>= caller-scc 0)
        (= (array-ref (struct-get scc-result scc-of) callee-slot) caller-scc))
        (OptNoFunction)
        (let
          [callee : CompilerIrFunction
            (array-ref (struct-get index values) callee-slot)]
          (if (opt-inline-callee-ok? callee caller-name)
            (OptSomeFunction callee)
            (OptNoFunction))))]
    [(OptNoI64) (OptNoFunction)]))

(define (opt-inline-lookup-multiblock-inlinable
  [index : OptFunctionIndex]
  [cname : String]
  [caller-name : String]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptMaybeFunction
  (match (opt-function-index-slot index cname)
    [(OptSomeI64 callee-slot)
      (if (and
        (>= caller-scc 0)
        (= (array-ref (struct-get scc-result scc-of) callee-slot) caller-scc))
        (OptNoFunction)
        (let
          [callee : CompilerIrFunction
            (array-ref (struct-get index values) callee-slot)]
          (if (opt-inline-multiblock-callee-ok? callee caller-name)
            (OptSomeFunction callee)
            (OptNoFunction))))]
    [(OptNoI64) (OptNoFunction)]))

(define (opt-inline-try
  [instr : CompilerIrInstr]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineState
  (match instr
    [(IrInstrCall dst cname cargs cret)
      (match (opt-inline-lookup-inlinable
        index
        cname
        func-name
        scc-result
        caller-scc)
        [(OptSomeFunction callee)
          (match callee
            [(IrFunction callee-name cparams _ cvars cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (let
                    [added-blocks : i64 0]
                    (if (opt-inline-cost-inline?
                      (opt-inline-single-block-cost-instrs cblocks)
                      added-blocks
                      (opt-inline-args-const-count cargs)
                      (opt-inline-census-absorbable?
                        census
                        func-name
                        callee-name)
                      caller-blocks
                      added-so-far)
                      (OptInlineState
                        (opt-inline-expand-instrs
                          (opt-inline-single-block-instrs cblocks)
                          dst
                          cret
                          cargs
                          np
                          vars)
                        (+ vars (opt-inline-frame-growth cvars np))
                        (+ added-so-far added-blocks))
                      (OptInlineState
                        (compiler-ir-instr-cons
                          (IrInstrCall dst cname cargs cret)
                          IrInstrNil)
                        vars
                        added-so-far)))
                  (OptInlineState
                    (compiler-ir-instr-cons
                      (IrInstrCall dst cname cargs cret)
                      IrInstrNil)
                    vars
                    added-so-far)))])]
        [(OptNoFunction)
          (OptInlineState
            (compiler-ir-instr-cons
              (IrInstrCall dst cname cargs cret)
              IrInstrNil)
            vars
            added-so-far)])]
    [_
      (OptInlineState
        (compiler-ir-instr-cons instr IrInstrNil)
        vars
        added-so-far)]))

(define (opt-inline-try-with-spans
  [instr : CompilerIrInstr]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanState
  (match instr
    [(IrInstrCall dst cname cargs cret)
      (match (opt-inline-lookup-inlinable
        index
        cname
        func-name
        scc-result
        caller-scc)
        [(OptSomeFunction callee)
          (match callee
            [(IrFunction callee-name cparams _ cvars cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (let
                    [added-blocks : i64 0]
                    (if (opt-inline-cost-inline?
                      (opt-inline-single-block-cost-instrs cblocks)
                      added-blocks
                      (opt-inline-args-const-count cargs)
                      (opt-inline-census-absorbable?
                        census
                        func-name
                        callee-name)
                      caller-blocks
                      added-so-far)
                      (match (opt-inline-expand-instrs-with-spans
                        (opt-inline-single-block-instrs cblocks)
                        dst
                        cret
                        cargs
                        np
                        vars
                        source-spans
                        out-spans
                        func-name
                        instr
                        cname)
                        [(OptInlineSpanState expanded _ _ next-spans)
                          (OptInlineSpanState
                            expanded
                            (+ vars (opt-inline-frame-growth cvars np))
                            (+ added-so-far added-blocks)
                            next-spans)])
                      (OptInlineSpanState
                        (compiler-ir-instr-cons
                          (IrInstrCall dst cname cargs cret)
                          IrInstrNil)
                        vars
                        added-so-far
                        out-spans)))
                  (OptInlineSpanState
                    (compiler-ir-instr-cons
                      (IrInstrCall dst cname cargs cret)
                      IrInstrNil)
                    vars
                    added-so-far
                    out-spans)))])]
        [(OptNoFunction)
          (OptInlineSpanState
            (compiler-ir-instr-cons
              (IrInstrCall dst cname cargs cret)
              IrInstrNil)
            vars
            added-so-far
            out-spans)])]
    [_
      (OptInlineSpanState
        (compiler-ir-instr-cons instr IrInstrNil)
        vars
        added-so-far
        out-spans)]))

(define (opt-inline-walk-instrs
  [instrs : CompilerIrInstrList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineState
  (match instrs
    [(IrInstrNil) (OptInlineState IrInstrNil vars added-so-far)]
    [(IrInstrCons instr rest)
      (match (opt-inline-try
        instr
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)
        [(OptInlineState expanded vars2 added2)
          (match (opt-inline-walk-instrs
            (box-get rest)
            index
            census
            func-name
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc)
            [(OptInlineState rest-list vars3 added3)
              (OptInlineState
                (opt-inline-append expanded rest-list)
                vars3
                added3)])])]))

(define (opt-inline-walk-instr-seq-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineState
  (if (>= pos (compiler-ir-instr-seq-count instrs))
    (OptInlineState IrInstrNil vars added-so-far)
    (match (opt-inline-try
      (compiler-ir-instr-seq-ref instrs pos)
      index
      census
      func-name
      vars
      caller-blocks
      added-so-far
      scc-result
      caller-scc)
      [(OptInlineState expanded vars2 added2)
        (match (opt-inline-walk-instr-seq-from
          instrs
          (+ pos 1)
          index
          census
          func-name
          vars2
          caller-blocks
          added2
          scc-result
          caller-scc)
          [(OptInlineState rest-list vars3 added3)
            (OptInlineState (opt-inline-append expanded rest-list) vars3 added3)])])))

(define (opt-inline-walk-instr-seq
  [instrs : CompilerIrInstrSeq]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineState
  (opt-inline-walk-instr-seq-from
    instrs
    0
    index
    census
    func-name
    vars
    caller-blocks
    added-so-far
    scc-result
    caller-scc))

(define (opt-inline-walk-instrs-with-spans
  [instrs : CompilerIrInstrList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanState
  (match instrs
    [(IrInstrNil) (OptInlineSpanState IrInstrNil vars added-so-far out-spans)]
    [(IrInstrCons instr rest)
      (match (opt-inline-try-with-spans
        instr
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)
        [(OptInlineSpanState expanded vars2 added2 spans2)
          (match (opt-inline-walk-instrs-with-spans
            (box-get rest)
            index
            census
            func-name
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc
            source-spans
            spans2)
            [(OptInlineSpanState rest-list vars3 added3 spans3)
              (OptInlineSpanState
                (opt-inline-append expanded rest-list)
                vars3
                added3
                spans3)])])]))

(define (opt-inline-walk-instr-seq-with-spans-from
  [instrs : CompilerIrInstrSeq]
  [pos : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanState
  (if (>= pos (compiler-ir-instr-seq-count instrs))
    (OptInlineSpanState IrInstrNil vars added-so-far out-spans)
    (match (opt-inline-try-with-spans
      (compiler-ir-instr-seq-ref instrs pos)
      index
      census
      func-name
      vars
      caller-blocks
      added-so-far
      scc-result
      caller-scc
      source-spans
      out-spans)
      [(OptInlineSpanState expanded vars2 added2 spans2)
        (match (opt-inline-walk-instr-seq-with-spans-from
          instrs
          (+ pos 1)
          index
          census
          func-name
          vars2
          caller-blocks
          added2
          scc-result
          caller-scc
          source-spans
          spans2)
          [(OptInlineSpanState rest-list vars3 added3 spans3)
            (OptInlineSpanState
              (opt-inline-append expanded rest-list)
              vars3
              added3
              spans3)])])))

(define (opt-inline-walk-instr-seq-with-spans
  [instrs : CompilerIrInstrSeq]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanState
  (opt-inline-walk-instr-seq-with-spans-from
    instrs
    0
    index
    census
    func-name
    vars
    caller-blocks
    added-so-far
    scc-result
    caller-scc
    source-spans
    out-spans))

(define (opt-inline-rewrite-single-block
  [block-label : String]
  [instrs : CompilerIrInstrList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineMaybeBlockRewrite
  (match (opt-inline-walk-instrs
    instrs
    index
    census
    func-name
    vars
    caller-blocks
    added-so-far
    scc-result
    caller-scc)
    [(OptInlineState new-instrs vars2 added2)
      (OptInlineSomeBlockRewrite
        (compiler-ir-block-cons
          (compiler-ir-block block-label new-instrs)
          IrBlockNil)
        vars2
        added2)]))

(define (opt-inline-multiblock-build-rewrite
  [block-label : String]
  [prefix-rev : CompilerIrInstrList]
  [rest : CompilerIrInstrList]
  [site-pos : i64]
  [call-instr : CompilerIrInstr]
  [callee : CompilerIrFunction]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [index : OptFunctionIndex]) : OptInlineMaybeBlockRewrite
  (match call-instr
    [(IrInstrCall dst cname cargs cret)
      (match callee
        [(IrFunction callee-name cparams _ cvars cblocks)
          (let
            [np : i64 (opt-inline-param-count cparams)]
            (if (opt-inline-arity-ok? cargs np)
              (let
                [added-blocks : i64
                  (+ (compiler-ir-block-list-count cblocks) 1)]
                [stage-args? : bool
                  (opt-inline-param-mutating-blocks? cblocks np)]
                (if (opt-inline-cost-inline?
                  (+
                    (opt-inline-multiblock-cost-instrs cblocks)
                    (if stage-args?
                      np
                      0))
                  added-blocks
                  (opt-inline-args-const-count cargs)
                  (opt-inline-census-absorbable? census func-name callee-name)
                  caller-blocks
                  added-so-far)
                  (match (opt-inline-walk-instrs
                    (compiler-ir-instr-list-reverse-onto prefix-rev IrInstrNil)
                    index
                    census
                    func-name
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc)
                    [(OptInlineState prefix-instrs prefix-vars prefix-added)
                      (let
                        [prefix : String
                          (opt-inline-site-prefix
                            func-name
                            block-label
                            site-pos
                            callee-name)]
                        [entry-label : String
                          (opt-inline-prefix-label
                            prefix
                            (opt-cfg-entry-label cblocks))]
                        [cont-label : String (opt-inline-cont-label prefix)]
                        [vars2 : i64
                          (+
                            prefix-vars
                            (if stage-args?
                              cvars
                              (opt-inline-frame-growth cvars np)))]
                        [added2 : i64 (+ prefix-added added-blocks)]
                        [stage-instrs : CompilerIrInstrList
                          (if stage-args?
                            (opt-inline-stage-param-instrs
                              cparams
                              cargs
                              prefix-vars
                              0)
                            IrInstrNil)]
                        [staged-args : CompilerIrCallArgs
                          (if stage-args?
                            (opt-inline-staged-args np prefix-vars)
                            cargs)]
                        [clone-base : i64
                          (if stage-args?
                            (+ prefix-vars np)
                            prefix-vars)]
                        [prefix-instrs2 : CompilerIrInstrList
                          (opt-inline-append
                            prefix-instrs
                            (opt-inline-append
                              stage-instrs
                              (compiler-ir-instr-cons
                                (IrInstrJump entry-label)
                                IrInstrNil)))]
                        (match (opt-inline-clone-multiblock-blocks
                          cblocks
                          prefix
                          cont-label
                          staged-args
                          np
                          clone-base)
                          [(OptInlineMultiClone cloned-blocks return-inputs)
                            (match (opt-inline-walk-instrs
                              rest
                              index
                              census
                              func-name
                              vars2
                              caller-blocks
                              added2
                              scc-result
                              caller-scc)
                              [(OptInlineState suffix vars3 added3)
                                (let
                                  [result-instr : CompilerIrInstr
                                    (opt-inline-cont-result-instr
                                      dst
                                      return-inputs
                                      cret)]
                                  [cont-instrs : CompilerIrInstrList
                                    (compiler-ir-instr-cons result-instr suffix)]
                                  (OptInlineSomeBlockRewrite
                                    (compiler-ir-block-cons
                                      (compiler-ir-block
                                        block-label
                                        prefix-instrs2)
                                      (opt-inline-block-append
                                        cloned-blocks
                                        (compiler-ir-block-cons
                                          (compiler-ir-block
                                            cont-label
                                            cont-instrs)
                                          IrBlockNil)))
                                    vars3
                                    added3))])]))])
                  (OptInlineNoBlockRewrite)))
              (OptInlineNoBlockRewrite)))])]
    [_ (OptInlineNoBlockRewrite)]))

(define (opt-inline-try-multiblock-rewrite-from
  [instrs : CompilerIrInstrList]
  [block-label : String]
  [prefix-rev : CompilerIrInstrList]
  [site-pos : i64]
  [all-blocks : CompilerIrBlockList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineMaybeBlockRewrite
  (match instrs
    [(IrInstrNil)
      (opt-inline-rewrite-single-block
        block-label
        (compiler-ir-instr-list-reverse-onto prefix-rev IrInstrNil)
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrCall _ cname _ _)
          (match (opt-inline-lookup-multiblock-inlinable
            index
            cname
            func-name
            scc-result
            caller-scc)
            [(OptSomeFunction callee)
              (match (opt-inline-multiblock-build-rewrite
                block-label
                prefix-rev
                (box-get rest)
                site-pos
                instr
                callee
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc
                index)
                [(OptInlineSomeBlockRewrite blocks2 vars2 added2)
                  (OptInlineSomeBlockRewrite blocks2 vars2 added2)]
                [(OptInlineNoBlockRewrite)
                  (opt-inline-try-multiblock-rewrite-from
                    (box-get rest)
                    block-label
                    (compiler-ir-instr-cons instr prefix-rev)
                    (+ site-pos 1)
                    all-blocks
                    index
                    census
                    func-name
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc)])]
            [(OptNoFunction)
              (opt-inline-try-multiblock-rewrite-from
                (box-get rest)
                block-label
                (compiler-ir-instr-cons instr prefix-rev)
                (+ site-pos 1)
                all-blocks
                index
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc)])]
        [_
          (opt-inline-try-multiblock-rewrite-from
            (box-get rest)
            block-label
            (compiler-ir-instr-cons instr prefix-rev)
            (+ site-pos 1)
            all-blocks
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc)])]))

(define (opt-inline-rewrite-block
  [block : CompilerIrBlock]
  [all-blocks : CompilerIrBlockList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineMaybeBlockRewrite
  (match block
    [(IrBlock label seq)
      (let
        [instrs : CompilerIrInstrList (compiler-ir-instr-seq-to-list seq)]
        (if (opt-inline-blocks-phi-label? all-blocks label)
          (opt-inline-rewrite-single-block
            label
            instrs
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc)
          (opt-inline-try-multiblock-rewrite-from
            instrs
            label
            IrInstrNil
            0
            all-blocks
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc)))]))

(define (opt-inline-clone-multiblock-instrs-with-spans
  [instrs : CompilerIrInstrList]
  [cloned-label : String]
  [prefix : String]
  [cont-label : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [caller : String]
  [call-instr : CompilerIrInstr]
  [callee : String]) : OptInlineMultiSpanInstrClone
  (match instrs
    [(IrInstrNil)
      (OptInlineMultiSpanInstrClone IrInstrNil IrPhiInputNil out-spans)]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrReturn maybe)
          (OptInlineMultiSpanInstrClone
            (compiler-ir-instr-cons (IrInstrJump cont-label) IrInstrNil)
            (compiler-ir-phi-input-cons
              (opt-inline-return-value maybe sa np base)
              cloned-label
              IrPhiInputNil)
            out-spans)]
        [_
          (let
            [cloned : CompilerIrInstr
              (opt-inline-clone-multiblock-instr instr prefix sa np base)]
            [spans2 : CompilerSourceSpans
              (opt-inline-record-clone-span
                source-spans
                out-spans
                caller
                call-instr
                callee
                instr
                cloned)]
            (match (opt-inline-clone-multiblock-instrs-with-spans
              (box-get rest)
              cloned-label
              prefix
              cont-label
              sa
              np
              base
              source-spans
              spans2
              caller
              call-instr
              callee)
              [(OptInlineMultiSpanInstrClone rest-instrs rest-inputs spans3)
                (OptInlineMultiSpanInstrClone
                  (compiler-ir-instr-cons cloned rest-instrs)
                  rest-inputs
                  spans3)]))])]))

(define (opt-inline-clone-multiblock-block-with-spans
  [block : CompilerIrBlock]
  [prefix : String]
  [cont-label : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [caller : String]
  [call-instr : CompilerIrInstr]
  [callee : String]) : OptInlineMultiSpanClone
  (match block
    [(IrBlock label instrs)
      (let
        [cloned-label : String (opt-inline-prefix-label prefix label)]
        (match (opt-inline-clone-multiblock-instrs-with-spans
          (compiler-ir-instr-seq-to-list instrs)
          cloned-label
          prefix
          cont-label
          sa
          np
          base
          source-spans
          out-spans
          caller
          call-instr
          callee)
          [(OptInlineMultiSpanInstrClone cloned-instrs inputs spans2)
            (OptInlineMultiSpanClone
              (compiler-ir-block-cons
                (compiler-ir-block cloned-label cloned-instrs)
                IrBlockNil)
              inputs
              spans2)]))]))

(define (opt-inline-clone-multiblock-blocks-with-spans
  [blocks : CompilerIrBlockList]
  [prefix : String]
  [cont-label : String]
  [sa : CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]
  [caller : String]
  [call-instr : CompilerIrInstr]
  [callee : String]) : OptInlineMultiSpanClone
  (match blocks
    [(IrBlockNil) (OptInlineMultiSpanClone IrBlockNil IrPhiInputNil out-spans)]
    [(IrBlockCons block rest)
      (match (opt-inline-clone-multiblock-block-with-spans
        block
        prefix
        cont-label
        sa
        np
        base
        source-spans
        out-spans
        caller
        call-instr
        callee)
        [(OptInlineMultiSpanClone one-block one-inputs spans2)
          (match (opt-inline-clone-multiblock-blocks-with-spans
            (box-get rest)
            prefix
            cont-label
            sa
            np
            base
            source-spans
            spans2
            caller
            call-instr
            callee)
            [(OptInlineMultiSpanClone rest-blocks rest-inputs spans3)
              (OptInlineMultiSpanClone
                (opt-inline-block-append one-block rest-blocks)
                (compiler-ir-phi-input-list-reverse-onto one-inputs rest-inputs)
                spans3)])])]
    [(IrBlockArray seq)
      (opt-inline-clone-multiblock-blocks-with-spans
        (compiler-ir-block-seq-to-list seq)
        prefix
        cont-label
        sa
        np
        base
        source-spans
        out-spans
        caller
        call-instr
        callee)]))

(define (opt-inline-rewrite-single-block-with-spans
  [block-label : String]
  [instrs : CompilerIrInstrList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match (opt-inline-walk-instrs-with-spans
    instrs
    index
    census
    func-name
    vars
    caller-blocks
    added-so-far
    scc-result
    caller-scc
    source-spans
    out-spans)
    [(OptInlineSpanState new-instrs vars2 added2 spans2)
      (OptInlineSomeSpanBlockRewrite
        (compiler-ir-block-cons
          (compiler-ir-block block-label new-instrs)
          IrBlockNil)
        vars2
        added2
        spans2)]))

(define (opt-inline-multiblock-build-span-rewrite
  [block-label : String]
  [prefix-rev : CompilerIrInstrList]
  [rest : CompilerIrInstrList]
  [site-pos : i64]
  [call-instr : CompilerIrInstr]
  [callee : CompilerIrFunction]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [index : OptFunctionIndex]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match call-instr
    [(IrInstrCall dst cname cargs cret)
      (match callee
        [(IrFunction callee-name cparams _ cvars cblocks)
          (let
            [np : i64 (opt-inline-param-count cparams)]
            (if (opt-inline-arity-ok? cargs np)
              (let
                [added-blocks : i64
                  (+ (compiler-ir-block-list-count cblocks) 1)]
                [stage-args? : bool
                  (opt-inline-param-mutating-blocks? cblocks np)]
                (if (opt-inline-cost-inline?
                  (+
                    (opt-inline-multiblock-cost-instrs cblocks)
                    (if stage-args?
                      np
                      0))
                  added-blocks
                  (opt-inline-args-const-count cargs)
                  (opt-inline-census-absorbable? census func-name callee-name)
                  caller-blocks
                  added-so-far)
                  (match (opt-inline-walk-instrs-with-spans
                    (compiler-ir-instr-list-reverse-onto prefix-rev IrInstrNil)
                    index
                    census
                    func-name
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc
                    source-spans
                    out-spans)
                    [(OptInlineSpanState
                        prefix-instrs
                        prefix-vars
                        prefix-added
                        spans2)
                      (let
                        [prefix : String
                          (opt-inline-site-prefix
                            func-name
                            block-label
                            site-pos
                            callee-name)]
                        [entry-label : String
                          (opt-inline-prefix-label
                            prefix
                            (opt-cfg-entry-label cblocks))]
                        [cont-label : String (opt-inline-cont-label prefix)]
                        [vars2 : i64
                          (+
                            prefix-vars
                            (if stage-args?
                              cvars
                              (opt-inline-frame-growth cvars np)))]
                        [added2 : i64 (+ prefix-added added-blocks)]
                        [stage-instrs : CompilerIrInstrList
                          (if stage-args?
                            (opt-inline-stage-param-instrs
                              cparams
                              cargs
                              prefix-vars
                              0)
                            IrInstrNil)]
                        [staged-args : CompilerIrCallArgs
                          (if stage-args?
                            (opt-inline-staged-args np prefix-vars)
                            cargs)]
                        [clone-base : i64
                          (if stage-args?
                            (+ prefix-vars np)
                            prefix-vars)]
                        [prefix-instrs2 : CompilerIrInstrList
                          (opt-inline-append
                            prefix-instrs
                            (opt-inline-append
                              stage-instrs
                              (compiler-ir-instr-cons
                                (IrInstrJump entry-label)
                                IrInstrNil)))]
                        (match (opt-inline-clone-multiblock-blocks-with-spans
                          cblocks
                          prefix
                          cont-label
                          staged-args
                          np
                          clone-base
                          source-spans
                          spans2
                          func-name
                          call-instr
                          callee-name)
                          [(OptInlineMultiSpanClone
                              cloned-blocks
                              return-inputs
                              spans3)
                            (match (opt-inline-walk-instrs-with-spans
                              rest
                              index
                              census
                              func-name
                              vars2
                              caller-blocks
                              added2
                              scc-result
                              caller-scc
                              source-spans
                              spans3)
                              [(OptInlineSpanState suffix vars3 added3 spans4)
                                (let
                                  [result-instr : CompilerIrInstr
                                    (opt-inline-cont-result-instr
                                      dst
                                      return-inputs
                                      cret)]
                                  [spans5 : CompilerSourceSpans
                                    (opt-inline-call-span-to-instr
                                      source-spans
                                      spans4
                                      func-name
                                      call-instr
                                      result-instr)]
                                  [cont-instrs : CompilerIrInstrList
                                    (compiler-ir-instr-cons result-instr suffix)]
                                  (OptInlineSomeSpanBlockRewrite
                                    (compiler-ir-block-cons
                                      (compiler-ir-block
                                        block-label
                                        prefix-instrs2)
                                      (opt-inline-block-append
                                        cloned-blocks
                                        (compiler-ir-block-cons
                                          (compiler-ir-block
                                            cont-label
                                            cont-instrs)
                                          IrBlockNil)))
                                    vars3
                                    added3
                                    spans5))])]))])
                  (OptInlineNoSpanBlockRewrite)))
              (OptInlineNoSpanBlockRewrite)))])]
    [_ (OptInlineNoSpanBlockRewrite)]))

(define (opt-inline-try-multiblock-span-rewrite-from
  [instrs : CompilerIrInstrList]
  [block-label : String]
  [prefix-rev : CompilerIrInstrList]
  [site-pos : i64]
  [all-blocks : CompilerIrBlockList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match instrs
    [(IrInstrNil)
      (opt-inline-rewrite-single-block-with-spans
        block-label
        (compiler-ir-instr-list-reverse-onto prefix-rev IrInstrNil)
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrCall _ cname _ _)
          (match (opt-inline-lookup-multiblock-inlinable
            index
            cname
            func-name
            scc-result
            caller-scc)
            [(OptSomeFunction callee)
              (match (opt-inline-multiblock-build-span-rewrite
                block-label
                prefix-rev
                (box-get rest)
                site-pos
                instr
                callee
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc
                index
                source-spans
                out-spans)
                [(OptInlineSomeSpanBlockRewrite blocks2 vars2 added2 spans2)
                  (OptInlineSomeSpanBlockRewrite blocks2 vars2 added2 spans2)]
                [(OptInlineNoSpanBlockRewrite)
                  (opt-inline-try-multiblock-span-rewrite-from
                    (box-get rest)
                    block-label
                    (compiler-ir-instr-cons instr prefix-rev)
                    (+ site-pos 1)
                    all-blocks
                    index
                    census
                    func-name
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc
                    source-spans
                    out-spans)])]
            [(OptNoFunction)
              (opt-inline-try-multiblock-span-rewrite-from
                (box-get rest)
                block-label
                (compiler-ir-instr-cons instr prefix-rev)
                (+ site-pos 1)
                all-blocks
                index
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc
                source-spans
                out-spans)])]
        [_
          (opt-inline-try-multiblock-span-rewrite-from
            (box-get rest)
            block-label
            (compiler-ir-instr-cons instr prefix-rev)
            (+ site-pos 1)
            all-blocks
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc
            source-spans
            out-spans)])]))

(define (opt-inline-rewrite-block-with-spans
  [block : CompilerIrBlock]
  [all-blocks : CompilerIrBlockList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match block
    [(IrBlock label seq)
      (let
        [instrs : CompilerIrInstrList (compiler-ir-instr-seq-to-list seq)]
        (if (opt-inline-blocks-phi-label? all-blocks label)
          (opt-inline-rewrite-single-block-with-spans
            label
            instrs
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc
            source-spans
            out-spans)
          (opt-inline-try-multiblock-span-rewrite-from
            instrs
            label
            IrInstrNil
            0
            all-blocks
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc
            source-spans
            out-spans)))]))

(define (opt-inline-blocks
  [blocks : CompilerIrBlockList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineBlocks
  (match blocks
    [(IrBlockNil) (OptInlineBlocks IrBlockNil vars added-so-far)]
    [(IrBlockCons block rest)
      (match (opt-inline-rewrite-block
        block
        blocks
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)
        [(OptInlineSomeBlockRewrite rewritten vars2 added2)
          (match (opt-inline-blocks
            (box-get rest)
            index
            census
            func-name
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc)
            [(OptInlineBlocks rest-blocks vars3 added3)
              (OptInlineBlocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                added3)])]
        [(OptInlineNoBlockRewrite)
          (OptInlineBlocks
            (compiler-ir-block-cons block IrBlockNil)
            vars
            added-so-far)])]
    [(IrBlockArray seq)
      (opt-inline-blocks
        (compiler-ir-block-seq-to-list seq)
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)]))

(define (opt-inline-blocks-with-spans
  [blocks : CompilerIrBlockList]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : String]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanBlocks
  (match blocks
    [(IrBlockNil) (OptInlineSpanBlocks IrBlockNil vars added-so-far out-spans)]
    [(IrBlockCons block rest)
      (match (opt-inline-rewrite-block-with-spans
        block
        blocks
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)
        [(OptInlineSomeSpanBlockRewrite rewritten vars2 added2 spans2)
          (match (opt-inline-blocks-with-spans
            (box-get rest)
            index
            census
            func-name
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc
            source-spans
            spans2)
            [(OptInlineSpanBlocks rest-blocks vars3 added3 spans3)
              (OptInlineSpanBlocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                added3
                spans3)])]
        [(OptInlineNoSpanBlockRewrite)
          (OptInlineSpanBlocks
            (compiler-ir-block-cons block IrBlockNil)
            vars
            added-so-far
            out-spans)])]
    [(IrBlockArray seq)
      (opt-inline-blocks-with-spans
        (compiler-ir-block-seq-to-list seq)
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)]))

(define (opt-inline-structure-ok? [blocks : CompilerIrBlockList]) : bool
  (if (opt-cfg-block-labels-unique? blocks)
    (if (opt-cfg-successor-targets-known? blocks)
      (let
        [pred-map : OptPredMap (OptPredMap (opt-cfg-index-build blocks))]
        (opt-verify-ok? (opt-verify-phi-predecessors-blocks pred-map blocks)))
      false)
    false))

(define (opt-inline-revert-or-keep
  [fallback : CompilerIrFunction]
  [next : CompilerIrFunction]) : CompilerIrFunction
  (match next
    [(IrFunction _ _ _ _ blocks)
      (if (opt-inline-structure-ok? blocks)
        next
        fallback)]))

(define (opt-inline-repair-or-keep
  [fallback : CompilerIrFunction]
  [next : CompilerIrFunction]
  [repair? : bool]) : CompilerIrFunction
  (match next
    [(IrFunction _ _ _ _ blocks)
      (if (opt-inline-structure-ok? blocks)
        (if repair?
          (opt-ssa-construct-function next)
          next)
        fallback)]))

(define (opt-inline-function
  [func : CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : CompilerIrFunction
  (match func
    [(IrFunction name params ret vars blocks)
      (let
        [caller-blocks : i64 (compiler-ir-block-list-count blocks)]
        (match (opt-inline-blocks
          blocks
          index
          census
          name
          vars
          caller-blocks
          0
          scc-result
          caller-scc)
          [(OptInlineBlocks new-blocks new-vars added)
            (opt-inline-repair-or-keep
              func
              (IrFunction name params ret new-vars new-blocks)
              (> added 0))]))]))

(define (opt-inline-function-with-spans
  [func : CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : CompilerSourceSpans]
  [out-spans : CompilerSourceSpans]) : OptInlineSpanProgram
  (match func
    [(IrFunction name params ret vars blocks)
      (let
        [caller-blocks : i64 (compiler-ir-block-list-count blocks)]
        (match (opt-inline-blocks-with-spans
          blocks
          index
          census
          name
          vars
          caller-blocks
          0
          scc-result
          caller-scc
          source-spans
          out-spans)
          [(OptInlineSpanBlocks new-blocks new-vars added next-spans)
            (let
              [next : CompilerIrFunction
                (IrFunction name params ret new-vars new-blocks)]
              (if (opt-inline-structure-ok? new-blocks)
                (OptInlineSpanProgram
                  (compiler-ir-function-cons
                    (if (> added 0)
                      (opt-ssa-construct-function next)
                      next)
                    IrFunctionNil)
                  next-spans)
                (OptInlineSpanProgram
                  (compiler-ir-function-cons func IrFunctionNil)
                  out-spans)))]))]))

(define (opt-function-index-to-list-from
  [index : OptFunctionIndex]
  [slot : i64]
  [count : i64]) : CompilerIrFunctionList
  (if (>= slot count)
    IrFunctionNil
    (compiler-ir-function-cons
      (array-ref (struct-get index values) slot)
      (opt-function-index-to-list-from index (+ slot 1) count))))

(define (opt-function-index-to-list [index : OptFunctionIndex]) : CompilerIrFunctionList
  (IrFunctionArray
    (CompilerIrFunctionSeq
      (struct-get index values)
      (opt-function-index-count index))))

(define (opt-inline-slot-order [scc-result : OptSccResult]) : (Array i64)
  (let
    [order : (Array i64) (struct-get scc-result order)]
    [scc-of : (Array i64) (struct-get scc-result scc-of)]
    [slot-count : i64 (array-length scc-of)]
    [scc-count : i64 (array-length order)]
    [counts : (Array i64) (make-array i64 scc-count)]
    [starts : (Array i64) (make-array i64 scc-count)]
    [next : (Array i64) (make-array i64 scc-count)]
    [slots : (Array i64) (make-array i64 slot-count)]
    [slot : i64 0]
    [order-index : i64 0]
    [offset : i64 0]
    (begin
      (opt-cfg-fill-i64! counts scc-count 0)
      (while (< slot slot-count)
        (let
          [scc-id : i64 (array-ref scc-of slot)]
          (begin
            (array-set! counts scc-id (+ (array-ref counts scc-id) 1))
            (set! slot (+ slot 1)))))
      (while (< order-index scc-count)
        (let
          [scc-id : i64 (array-ref order order-index)]
          (begin
            (array-set! starts scc-id offset)
            (array-set! next scc-id offset)
            (set! offset (+ offset (array-ref counts scc-id)))
            (set! order-index (+ order-index 1)))))
      (set! slot 0)
      (while (< slot slot-count)
        (let
          [scc-id : i64 (array-ref scc-of slot)]
          [slot-index : i64 (array-ref next scc-id)]
          (begin
            (array-set! slots slot-index slot)
            (array-set! next scc-id (+ slot-index 1))
            (set! slot (+ slot 1)))))
      slots)))

(define (opt-inline-process-scc-order!
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]) : unit
  (let
    [scc-of : (Array i64) (struct-get scc-result scc-of)]
    [values : (Array CompilerIrFunction) (struct-get index values)]
    [slot-order : (Array i64) (opt-inline-slot-order scc-result)]
    [index-pos : i64 0]
    [slot-count : i64 (array-length slot-order)]
    (while (< index-pos slot-count)
      (begin
        (let
          [slot : i64 (array-ref slot-order index-pos)]
          [caller-scc : i64 (array-ref scc-of slot)]
          (array-set!
            values
            slot
            (opt-inline-function
              (array-ref values slot)
              index
              census
              scc-result
              caller-scc)))
        (set! index-pos (+ index-pos 1))))))

(define (opt-inline-process-scc-order-with-spans
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [spans : CompilerSourceSpans]) : CompilerSourceSpans
  (let
    [scc-of : (Array i64) (struct-get scc-result scc-of)]
    [values : (Array CompilerIrFunction) (struct-get index values)]
    [slot-order : (Array i64) (opt-inline-slot-order scc-result)]
    [index-pos : i64 0]
    [slot-count : i64 (array-length slot-order)]
    [current-spans : CompilerSourceSpans spans]
    (begin
      (while (< index-pos slot-count)
        (begin
          (let
            [slot : i64 (array-ref slot-order index-pos)]
            [caller-scc : i64 (array-ref scc-of slot)]
            (match (opt-inline-function-with-spans
              (array-ref values slot)
              index
              census
              scc-result
              caller-scc
              current-spans
              current-spans)
              [(OptInlineSpanProgram one next-spans)
                (begin
                  (match one
                    [(IrFunctionCons head _) (array-set! values slot head)]
                    [(IrFunctionNil) unit]
                    [(IrFunctionArray seq)
                      (if (> (compiler-ir-function-seq-count seq) 0)
                        (array-set!
                          values
                          slot
                          (compiler-ir-function-seq-ref seq 0))
                        unit)])
                  (set! current-spans next-spans))]))
          (set! index-pos (+ index-pos 1))))
      current-spans)))

;; Inline small single-block leaf callees across the whole program. Only at opt
;; level 2 (the register-allocated quality build).
(define (opt-inline-program-functions
  [functions : CompilerIrFunctionList]
  [level : i64]) : CompilerIrFunctionList
  (if (< level 2)
    functions
    (let
      [devirt : CompilerIrFunctionList
        (opt-devirt-known-function-list functions)]
      [index : OptFunctionIndex (opt-function-index-build devirt)]
      [graph : OptCallGraph (opt-callgraph-build index)]
      [scc-result : OptSccResult (opt-scc-compute graph)]
      [census : OptInlineCensus (opt-inline-census-build index devirt)]
      (begin
        (opt-inline-process-scc-order! index census scc-result)
        (opt-function-index-to-list index)))))

(define (opt-inline-program-functions-with-spans
  [functions : CompilerIrFunctionList]
  [level : i64]
  [spans : CompilerSourceSpans]) : OptInlineSpanProgram
  (if (< level 2)
    (OptInlineSpanProgram functions spans)
    (let
      [devirt : CompilerIrFunctionList
        (opt-devirt-known-function-list functions)]
      [index : OptFunctionIndex (opt-function-index-build devirt)]
      [graph : OptCallGraph (opt-callgraph-build index)]
      [scc-result : OptSccResult (opt-scc-compute graph)]
      [census : OptInlineCensus (opt-inline-census-build index devirt)]
      [next-spans : CompilerSourceSpans
        (opt-inline-process-scc-order-with-spans index census scc-result spans)]
      (OptInlineSpanProgram (opt-function-index-to-list index) next-spans))))

(define (opt-string-set-contains? [items : OptStringSet] [name : String]) : bool
  (match items
    [(OptStringNil) false]
    [(OptStringCons item rest)
      (let
        [rest : OptStringSet (box-get rest)]
        (if (string-eq item name)
          true
          (opt-string-set-contains? rest name)))]))

(define (opt-function-list-defines?
  [functions : CompilerIrFunctionList]
  [name : String]) : bool
  (match functions
    [(IrFunctionNil) false]
    [(IrFunctionCons func rest)
      (match func
        [(IrFunction func-name _ _ _ _)
          (if (string-eq func-name name)
            true
            (opt-function-list-defines? (box-get rest) name))])]
    [(IrFunctionArray seq)
      (opt-function-list-defines? (compiler-ir-function-seq-to-list seq) name)]))

(define (opt-function-list-find
  [functions : CompilerIrFunctionList]
  [name : String]) : OptMaybeFunction
  (match functions
    [(IrFunctionNil) (OptNoFunction)]
    [(IrFunctionCons func rest)
      (match func
        [(IrFunction func-name _ _ _ _)
          (if (string-eq func-name name)
            (OptSomeFunction func)
            (opt-function-list-find (box-get rest) name))])]
    [(IrFunctionArray seq)
      (opt-function-list-find (compiler-ir-function-seq-to-list seq) name)]))

(define (opt-reach-add-function
  [index : OptFunctionIndex]
  [state : OptReachState]
  [name : String]) : OptReachState
  (match state
    [(OptReachState reachable worklist)
      (if (opt-function-index-defines? index name)
        (if (string-i64-map-contains? reachable name)
          state
          (OptReachState
            (string-i64-map-put reachable name 1)
            (OptStringCons name (box worklist))))
        state)]))

(define (opt-reach-add-function-leaf-from
  [index : OptFunctionIndex]
  [state : OptReachState]
  [leaf : String]
  [slot : i64]
  [count : i64]) : OptReachState
  (if (>= slot count)
    state
    (match (array-ref (struct-get index values) slot)
      [(IrFunction name _ _ _ _)
        (opt-reach-add-function-leaf-from
          index
          (if (string-eq (opt-symbol-leaf name) leaf)
            (opt-reach-add-function index state name)
            state)
          leaf
          (+ slot 1)
          count)])))

(define (opt-reach-add-function-leaf
  [index : OptFunctionIndex]
  [state : OptReachState]
  [leaf : String]) : OptReachState
  (opt-reach-add-function-leaf-from
    index
    state
    leaf
    0
    (opt-function-index-count index)))

(define (opt-runtime-prelude-string-helper-name [source-name : String]) : String
  (let
    [base : String (opt-symbol-leaf source-name)]
    (cond
      [(string-eq base "tl_int_to_string") "tl-runtime-int-to-string"]
      [(string-eq base "tl_substring") "tl-runtime-substring"]
      [(string-eq base "tl_str_view") "tl-runtime-str-view"]
      [(string-eq base "tl_string_concat") "tl-runtime-string-concat"]
      [(string-eq base "tl_string_concat3") "tl-runtime-string-concat3"]
      [(string-eq base "tl_string_concat4") "tl-runtime-string-concat4"]
      [(string-eq base "tl_string_concat5") "tl-runtime-string-concat5"]
      [else ""])))

(define (opt-reach-add-runtime-prelude-string-helper
  [index : OptFunctionIndex]
  [state : OptReachState]
  [source-name : String]) : OptReachState
  (let
    [helper : String (opt-runtime-prelude-string-helper-name source-name)]
    (if (string-eq helper "")
      state
      (opt-reach-add-function-leaf
        index
        (opt-reach-add-function
          index
          (opt-reach-add-function
            index
            state
            (string-append "stdlib/runtime.tl::" helper))
          (string-append "stdlib\\runtime.tl::" helper))
        helper))))

(define (opt-reach-add-call-target
  [index : OptFunctionIndex]
  [state : OptReachState]
  [name : String]) : OptReachState
  (opt-reach-add-runtime-prelude-string-helper
    index
    (opt-reach-add-function index state name)
    name))

(define (opt-reach-value
  [index : OptFunctionIndex]
  [state : OptReachState]
  [value : CompilerIrValue]) : OptReachState
  (match value
    [(IrValueGlobal name) (opt-reach-add-function index state name)]
    [(IrValueGlobalAddr name) (opt-reach-add-function index state name)]
    [(IrValueFunction name) (opt-reach-add-function index state name)]
    [_ state]))

(define (opt-reach-value-list
  [index : OptFunctionIndex]
  [state : OptReachState]
  [values : CompilerIrValueList]) : OptReachState
  (match values
    [(IrValueNil) state]
    [(IrValueCons value rest)
      (opt-reach-value-list
        index
        (opt-reach-value index state value)
        (box-get rest))]))

(define (opt-reach-call-args-array
  [index : OptFunctionIndex]
  [state : OptReachState]
  [values : (Array CompilerIrValue)]
  [arg-index : i64]) : OptReachState
  (if (>= arg-index (array-length values))
    state
    (opt-reach-call-args-array
      index
      (opt-reach-value index state (array-ref values arg-index))
      values
      (+ arg-index 1))))

(define (opt-reach-call-args
  [index : OptFunctionIndex]
  [state : OptReachState]
  [args : CompilerIrCallArgs]) : OptReachState
  (match args
    [(IrCallArgsNil) state]
    [(IrCallArgsOne value) (opt-reach-value index state value)]
    [(IrCallArgsTwo a b)
      (opt-reach-value index (opt-reach-value index state a) b)]
    [(IrCallArgsArray values) (opt-reach-call-args-array index state values 0)]))

(define (opt-reach-maybe-value
  [index : OptFunctionIndex]
  [state : OptReachState]
  [maybe : CompilerIrMaybeValue]) : OptReachState
  (match maybe
    [(IrNoValue) state]
    [(IrSomeValue value) (opt-reach-value index state value)]))

(define (opt-reach-phi-inputs
  [index : OptFunctionIndex]
  [state : OptReachState]
  [inputs : CompilerIrPhiInputList]) : OptReachState
  (match inputs
    [(IrPhiInputNil) state]
    [(IrPhiInputCons value _ rest)
      (opt-reach-phi-inputs
        index
        (opt-reach-value index state value)
        (box-get rest))]))

(define (opt-reach-instr
  [index : OptFunctionIndex]
  [state : OptReachState]
  [instr : CompilerIrInstr]) : OptReachState
  (match instr
    [(IrInstrMov _ src _) (opt-reach-value index state src)]
    [(IrInstrAlloc _ _) state]
    [(IrInstrAddrOf _ _) state]
    [(IrInstrGep _ base offset _)
      (opt-reach-value index (opt-reach-value index state base) offset)]
    [(IrInstrLoad _ src _) (opt-reach-value index state src)]
    [(IrInstrStorePtr dst src _)
      (opt-reach-value index (opt-reach-value index state dst) src)]
    [(IrInstrCopyBytes dst src _)
      (opt-reach-value index (opt-reach-value index state dst) src)]
    [(IrInstrBoundsCheck idx length _)
      (opt-reach-value index (opt-reach-value index state idx) length)]
    [(IrInstrCast _ src _ _) (opt-reach-value index state src)]
    [(IrInstrBitcast _ src _ _) (opt-reach-value index state src)]
    [(IrInstrBinOp _ _ lhs rhs _)
      (opt-reach-value index (opt-reach-value index state lhs) rhs)]
    [(IrInstrUnOp _ _ src _) (opt-reach-value index state src)]
    [(IrInstrLaneId _ _ _) state]
    [(IrInstrSplat _ value _ _) (opt-reach-value index state value)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ lhs rhs _ _)
          (opt-reach-value index (opt-reach-value index state lhs) rhs)])]
    [(IrInstrVectorReduce _ _ src _ _) (opt-reach-value index state src)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ lhs rhs _ _)
          (opt-reach-value index (opt-reach-value index state lhs) rhs)])]
    [(IrInstrMaskBinOp _ _ lhs rhs _)
      (opt-reach-value index (opt-reach-value index state lhs) rhs)]
    [(IrInstrMaskNot _ src _) (opt-reach-value index state src)]
    [(IrInstrMaskReduce _ _ src _) (opt-reach-value index state src)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ mask on-true on-false _ _)
          (opt-reach-value
            index
            (opt-reach-value index (opt-reach-value index state mask) on-true)
            on-false)])]
    [(IrInstrVectorLoad _ base idx _ _)
      (opt-reach-value index (opt-reach-value index state base) idx)]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload base idx value _ _)
          (opt-reach-value
            index
            (opt-reach-value index (opt-reach-value index state base) idx)
            value)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload base idx value mask _ _)
          (opt-reach-value
            index
            (opt-reach-value
              index
              (opt-reach-value index (opt-reach-value index state base) idx)
              value)
            mask)])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload _ base idx mask _ _)
          (opt-reach-value
            index
            (opt-reach-value index (opt-reach-value index state base) idx)
            mask)])]
    [(IrInstrTailMask _ idx length _)
      (opt-reach-value index (opt-reach-value index state idx) length)]
    [(IrInstrEntryArgc _) state]
    [(IrInstrEntryArgv _) state]
    [(IrInstrEntryEnvp _) state]
    [(IrInstrCpuId _ leaf subleaf _)
      (opt-reach-value index (opt-reach-value index state leaf) subleaf)]
    [(IrInstrXgetbv _ idx) (opt-reach-value index state idx)]
    [(IrInstrSyscall _ args) (opt-reach-call-args index state args)]
    [(IrInstrCall _ name args _)
      (opt-reach-add-call-target
        index
        (opt-reach-call-args index state args)
        name)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base name args _)
          (opt-reach-add-call-target
            index
            (opt-reach-call-args index (opt-reach-value index state base) args)
            name)])]
    [(IrInstrCallIndirect _ func args _)
      (opt-reach-call-args index (opt-reach-value index state func) args)]
    [(IrInstrCallIndirectC _ func args _)
      (opt-reach-call-args index (opt-reach-value index state func) args)]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload base func args _)
          (opt-reach-call-args
            index
            (opt-reach-value index (opt-reach-value index state base) func)
            args)])]
    [(IrInstrTailCall name args _)
      (opt-reach-add-call-target
        index
        (opt-reach-call-args index state args)
        name)]
    [(IrInstrStore _ value _) (opt-reach-value index state value)]
    [(IrInstrJump _) state]
    [(IrInstrBranch cond _ _) (opt-reach-value index state cond)]
    [(IrInstrReturn maybe) (opt-reach-maybe-value index state maybe)]
    [(IrInstrPhi _ inputs _) (opt-reach-phi-inputs index state inputs)]
    ;; #2386: register-group ops carry word-class scalar operands (vars/consts);
    ;; lowering materializes any global/function reference into a var before
    ;; packing, so the group operands themselves reach nothing new.
    [(IrInstrPack _ _ _) state]
    [(IrInstrWord _ src _ _) (opt-reach-value index state src)]
    [(IrInstrTailCallIndirect func args _)
      (opt-reach-call-args index (opt-reach-value index state func) args)]))

(define (opt-reach-instrs
  [index : OptFunctionIndex]
  [state : OptReachState]
  [instrs : CompilerIrInstrList]) : OptReachState
  (match instrs
    [(IrInstrNil) state]
    [(IrInstrCons instr rest)
      (opt-reach-instrs
        index
        (opt-reach-instr index state instr)
        (box-get rest))]))

(define (opt-reach-instr-seq-from
  [index : OptFunctionIndex]
  [state : OptReachState]
  [slots : (Array CompilerIrInstr)]
  [instr-index : i64]
  [count : i64]) : OptReachState
  (if (>= instr-index count)
    state
    (opt-reach-instr-seq-from
      index
      (opt-reach-instr index state (array-ref slots instr-index))
      slots
      (+ instr-index 1)
      count)))

(define (opt-reach-instr-seq
  [index : OptFunctionIndex]
  [state : OptReachState]
  [instrs : CompilerIrInstrSeq]) : OptReachState
  (opt-reach-instr-seq-from
    index
    state
    (struct-get instrs slots)
    0
    (struct-get instrs len)))

(define (opt-reach-blocks
  [index : OptFunctionIndex]
  [state : OptReachState]
  [blocks : CompilerIrBlockList]) : OptReachState
  (match blocks
    [(IrBlockNil) state]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-reach-blocks
            index
            (opt-reach-instr-seq index state instrs)
            (box-get rest))])]
    [(IrBlockArray seq)
      (opt-reach-blocks index state (compiler-ir-block-seq-to-list seq))]))

(define (opt-reach-function
  [index : OptFunctionIndex]
  [state : OptReachState]
  [func : CompilerIrFunction]) : OptReachState
  (match func
    [(IrFunction _ _ _ _ blocks) (opt-reach-blocks index state blocks)]))

(define (opt-reach-process [index : OptFunctionIndex] [state : OptReachState]) : OptReachState
  (match state
    [(OptReachState reachable worklist)
      (match worklist
        [(OptStringNil) state]
        [(OptStringCons name rest)
          (let
            [popped : OptReachState (OptReachState reachable (box-get rest))]
            (match (opt-function-index-find index name)
              [(OptSomeFunction func)
                (opt-reach-process index (opt-reach-function index popped func))]
              [(OptNoFunction) (opt-reach-process index popped)]))])]))

(define (opt-reach-global
  [index : OptFunctionIndex]
  [state : OptReachState]
  [global : CompilerIrGlobal]) : OptReachState
  (match global
    [(IrGlobal name _ value)
      ;; A global with a non-constant initializer is set up before main by a
      ;; generated `__global_init_<name>` function (mirrors
      ;; compiler-backend-global-init-name) that the backend calls from the
      ;; startup sequence; it is NOT referenced from the global's IR value, so it
      ;; must be added as a reachability root or the prune drops its definition
      ;; (unresolved-symbol link failure). opt-reach-add-function no-ops when the
      ;; function does not exist (constant-initialized globals).
      (opt-reach-add-function
        index
        (opt-reach-value index state value)
        (string-append "__global_init_" name))]))

(define (opt-reach-globals
  [index : OptFunctionIndex]
  [state : OptReachState]
  [globals : CompilerIrGlobalList]) : OptReachState
  (match globals
    [(IrGlobalNil) state]
    [(IrGlobalCons global rest)
      (opt-reach-globals
        index
        (opt-reach-global index state global)
        (box-get rest))]))

(define (opt-filter-reachable-functions
  [functions : CompilerIrFunctionList]
  [reachable : StringI64Map]) : CompilerIrFunctionList
  (match functions
    [(IrFunctionNil) (IrFunctionNil)]
    [(IrFunctionCons func rest)
      (match func
        [(IrFunction name _ _ _ _)
          (if (string-i64-map-contains? reachable name)
            (compiler-ir-function-cons
              func
              (opt-filter-reachable-functions (box-get rest) reachable))
            (opt-filter-reachable-functions (box-get rest) reachable))])]
    [(IrFunctionArray seq)
      (compiler-ir-function-list-compact
        (opt-filter-reachable-functions
          (compiler-ir-function-seq-to-list seq)
          reachable))]))

;; Functions exported via #2143 are lowered to a `provided` IrExtern whose name
;; is the function's logical name. Such functions may be called only from outside
;; TypeLisp IR (e.g. the backend-emitted bounds/division/shift checks call the
;; runtime-prelude handlers), so seed them as roots for the function-level DCE.
(define (opt-reach-add-provided-externs
  [index : OptFunctionIndex]
  [externs : CompilerIrExternList]
  [state : OptReachState]) : OptReachState
  (match externs
    [(IrExternNil) state]
    [(IrExternCons ext rest)
      (match ext
        [(IrExtern name _ _ _ _ provided)
          (opt-reach-add-provided-externs
            index
            (box-get rest)
            (if provided
              (opt-reach-add-function index state name)
              state))])]))

(define (opt-symbol-leaf [name : String]) : String
  (let
    [i : i64 0]
    [n : i64 (string-length name)]
    [start : i64 0]
    (begin
      (while (< i n)
        (begin
          (if (or (= (string-ref name i) '/') (= (string-ref name i) ':'))
            (set! start (+ i 1))
            unit)
          (set! i (+ i 1))))
      (substring name start (- n start)))))

(define (opt-prune-unreachable-functions
  [globals : CompilerIrGlobalList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]) : CompilerIrFunctionList
  (if (opt-function-list-defines? functions "main")
    (let
      [index : OptFunctionIndex (opt-function-index-build functions)]
      [reachable : StringI64Map
        (string-i64-map-with-capacity
          (opt-function-index-capacity (opt-function-list-count functions)))]
      (match (opt-reach-process
        index
        (opt-reach-globals
          index
          (opt-reach-add-provided-externs
            index
            externs
            (opt-reach-add-function
              index
              (OptReachState reachable (OptStringNil))
              "main"))
          globals))
        [(OptReachState reachable-out _)
          (opt-filter-reachable-functions functions reachable-out)]))
    functions))

(defenum OptLoopBceArgcScan
  (OptLoopBceArgcScan OptLoopBceExprEnv bool bool))

(defenum OptLoopBceCleanScan
  (OptLoopBceCleanScan OptLoopBceState bool))

(defenum OptLoopBceCleanPass
  (OptLoopBceCleanPass StringI64Map bool))

(define (opt-loop-bce-argc-value-expr
  [env : OptLoopBceExprEnv]
  [value : CompilerIrValue]) : OptLoopBceExpr
  (match value
    [(IrValueVar id)
      (match (opt-loop-bce-expr-lookup env id)
        [(OptLoopBceArgc) (OptLoopBceArgc)]
        [_ (OptLoopBceValue value)])]
    [_ (OptLoopBceValue value)]))

(define (opt-loop-bce-argc-scan-instr
  [scan : OptLoopBceArgcScan]
  [instr : CompilerIrInstr]) : OptLoopBceArgcScan
  (match scan
    [(OptLoopBceArgcScan env seen ok)
      (if (not ok)
        scan
        (match instr
          [(IrInstrEntryArgc dst)
            (OptLoopBceArgcScan
              (opt-loop-bce-expr-bind env dst (OptLoopBceArgc))
              seen
              ok)]
          [(IrInstrMov dst src _)
            (OptLoopBceArgcScan
              (opt-loop-bce-expr-bind
                env
                dst
                (opt-loop-bce-argc-value-expr env src))
              seen
              ok)]
          [(IrInstrCast dst src from-ty to-ty)
            (OptLoopBceArgcScan
              (opt-loop-bce-expr-bind
                env
                dst
                (if (opt-loop-bce-same-width-int-cast? from-ty to-ty)
                  (opt-loop-bce-argc-value-expr env src)
                  (OptLoopBceUnknown)))
              seen
              ok)]
          [(IrInstrBitcast dst _ _ _)
            (OptLoopBceArgcScan
              (opt-loop-bce-expr-bind env dst (OptLoopBceUnknown))
              seen
              ok)]
          [(IrInstrReturn maybe)
            (match maybe
              [(IrSomeValue value)
                (OptLoopBceArgcScan
                  env
                  true
                  (opt-loop-bce-expr-eq
                    (opt-loop-bce-argc-value-expr env value)
                    (OptLoopBceArgc)))]
              [(IrNoValue) (OptLoopBceArgcScan env true false)])]
          [(IrInstrJump _) (OptLoopBceArgcScan env seen false)]
          [(IrInstrBranch _ _ _) (OptLoopBceArgcScan env seen false)]
          [_
            (let
              [dst : i64 (opt-gvn-instr-dst instr)]
              (if (= dst (- 0 1))
                scan
                (OptLoopBceArgcScan (opt-loop-bce-expr-unbind env dst) seen ok)))]))]))

(define (opt-loop-bce-argc-scan-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [scan : OptLoopBceArgcScan]) : OptLoopBceArgcScan
  (if (>= index (compiler-ir-instr-seq-count instrs))
    scan
    (opt-loop-bce-argc-scan-seq-from
      instrs
      (+ index 1)
      (opt-loop-bce-argc-scan-instr
        scan
        (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-loop-bce-function-returns-argc? [func : CompilerIrFunction]) : bool
  (match func
    [(IrFunction _ params _ _ blocks)
      (if (not (= (opt-tailrec-param-count params) 0))
        false
        (match blocks
          [(IrBlockCons block rest)
            (match (box-get rest)
              [(IrBlockNil)
                (match block
                  [(IrBlock _ instrs)
                    (match (opt-loop-bce-argc-scan-seq-from
                      instrs
                      0
                      (OptLoopBceArgcScan (OptLoopBceExprNil) false true))
                      [(OptLoopBceArgcScan _ seen ok) (and seen ok)])])]
              [_ false])]
          [(IrBlockArray seq)
            (if (= (compiler-ir-block-seq-count seq) 1)
              (match (compiler-ir-block-seq-ref seq 0)
                [(IrBlock _ instrs)
                  (match (opt-loop-bce-argc-scan-seq-from
                    instrs
                    0
                    (OptLoopBceArgcScan (OptLoopBceExprNil) false true))
                    [(OptLoopBceArgcScan _ seen ok) (and seen ok)])])
              false)]
          [(IrBlockNil) false]))]))

(define (opt-loop-bce-argc-return-map
  [functions : CompilerIrFunctionList]
  [map : StringI64Map]) : StringI64Map
  (match functions
    [(IrFunctionNil) map]
    [(IrFunctionCons func rest)
      (match func
        [(IrFunction name _ _ _ _)
          (opt-loop-bce-argc-return-map
            (box-get rest)
            (if (opt-loop-bce-function-returns-argc? func)
              (string-i64-map-put map name 1)
              map))])]
    [(IrFunctionArray seq)
      (opt-loop-bce-argc-return-map (compiler-ir-function-seq-to-list seq) map)]))

(define (opt-loop-bce-clean-storeptr-safe?
  [state : OptLoopBceState]
  [ptr : CompilerIrValue]) : bool
  (match ptr
    [(IrValueVar ptr-var)
      (match (opt-loop-bce-ptr-lookup (struct-get state ptrs) ptr-var)
        [(OptLoopBceDataSlot _) true]
        [(OptLoopBceDataBuffer _) true]
        [(OptLoopBceDataElement _) true]
        [_ false])]
    [_ false]))

(define (opt-loop-bce-clean-update-instr
  [scan : OptLoopBceCleanScan]
  [clean : StringI64Map]
  [instr : CompilerIrInstr]) : OptLoopBceCleanScan
  (match scan
    [(OptLoopBceCleanScan state ok)
      (if (not ok)
        scan
        (match instr
          [(IrInstrMov dst src _)
            (let
              [invalid : OptLoopBceState
                (opt-loop-bce-state-invalidate-def state dst)]
              (match src
                [(IrValueVar src-var)
                  (OptLoopBceCleanScan
                    (opt-loop-bce-state-bind-alias
                      invalid
                      dst
                      (opt-loop-bce-alias-resolve
                        (struct-get state aliases)
                        src-var))
                    ok)]
                [_ (OptLoopBceCleanScan invalid ok)]))]
          [(IrInstrAlloc dst _)
            (OptLoopBceCleanScan
              (opt-loop-bce-state-bind-alias
                (opt-loop-bce-state-invalidate-def state dst)
                dst
                dst)
              ok)]
          [(IrInstrGep dst base offset ty)
            (OptLoopBceCleanScan
              (opt-loop-bce-update-gep
                state
                (i64-i64-map-with-capacity 1)
                dst
                base
                offset
                ty)
              ok)]
          [(IrInstrLoad dst src ty)
            (OptLoopBceCleanScan
              (opt-loop-bce-update-load
                state
                (i64-i64-map-with-capacity 1)
                dst
                src
                ty)
              ok)]
          [(IrInstrStorePtr ptr _ _)
            (OptLoopBceCleanScan
              state
              (opt-loop-bce-clean-storeptr-safe? state ptr))]
          [(IrInstrCall dst name _ _)
            (OptLoopBceCleanScan
              (opt-loop-bce-state-invalidate-def state dst)
              (string-i64-map-contains? clean name))]
          [(IrInstrTailCall name _ _)
            (OptLoopBceCleanScan state (string-i64-map-contains? clean name))]
          [(IrInstrCallIndirect dst _ _ _)
            (OptLoopBceCleanScan
              (opt-loop-bce-state-invalidate-def state dst)
              false)]
          [(IrInstrCallIndirectC dst _ _ _)
            (OptLoopBceCleanScan
              (opt-loop-bce-state-invalidate-def state dst)
              false)]
          [(IrInstrCallCAbiStoreResult payload-box)
            (match (box-get payload-box)
              [(CompilerIrInstrCallCAbiStoreResultPayload _ _ _ _)
                (OptLoopBceCleanScan state false)])]
          [(IrInstrCallIndirectCAbiStoreResult payload-box)
            (match (box-get payload-box)
              [(CompilerIrInstrCallIndirectCAbiStoreResultPayload _ _ _ _)
                (OptLoopBceCleanScan state false)])]
          [(IrInstrTailCallIndirect _ _ _) (OptLoopBceCleanScan state false)]
          [(IrInstrSyscall dst _)
            (OptLoopBceCleanScan
              (opt-loop-bce-state-invalidate-def state dst)
              false)]
          [(IrInstrCopyBytes _ _ _) (OptLoopBceCleanScan state false)]
          [(IrInstrVectorStore payload-box)
            (match (box-get payload-box)
              [(CompilerIrInstrVectorStorePayload _ _ _ _ _)
                (OptLoopBceCleanScan state false)])]
          [(IrInstrPredicatedStore payload-box)
            (match (box-get payload-box)
              [(CompilerIrInstrPredicatedStorePayload _ _ _ _ _ _)
                (OptLoopBceCleanScan state false)])]
          [_
            (let
              [dst : i64 (opt-gvn-instr-dst instr)]
              (OptLoopBceCleanScan
                (if (= dst (- 0 1))
                  state
                  (opt-loop-bce-state-invalidate-def state dst))
                ok))]))]))

(define (opt-loop-bce-clean-scan-seq-from
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [clean : StringI64Map]
  [scan : OptLoopBceCleanScan]) : OptLoopBceCleanScan
  (if (>= index (compiler-ir-instr-seq-count instrs))
    scan
    (opt-loop-bce-clean-scan-seq-from
      instrs
      (+ index 1)
      clean
      (opt-loop-bce-clean-update-instr
        scan
        clean
        (compiler-ir-instr-seq-ref instrs index)))))

(define (opt-loop-bce-clean-scan-blocks
  [blocks : CompilerIrBlockList]
  [clean : StringI64Map]
  [scan : OptLoopBceCleanScan]) : OptLoopBceCleanScan
  (match scan
    [(OptLoopBceCleanScan _ ok)
      (if (not ok)
        scan
        (match blocks
          [(IrBlockNil) scan]
          [(IrBlockCons block rest)
            (match block
              [(IrBlock _ instrs)
                (opt-loop-bce-clean-scan-blocks
                  (box-get rest)
                  clean
                  (opt-loop-bce-clean-scan-seq-from instrs 0 clean scan))])]
          [(IrBlockArray seq)
            (opt-loop-bce-clean-scan-blocks
              (compiler-ir-block-seq-to-list seq)
              clean
              scan)]))]))

(define (opt-loop-bce-function-length-clean?
  [func : CompilerIrFunction]
  [clean : StringI64Map]) : bool
  (match func
    [(IrFunction _ _ _ _ blocks)
      (match (opt-loop-bce-clean-scan-blocks
        blocks
        clean
        (OptLoopBceCleanScan (opt-loop-bce-initial-state) true))
        [(OptLoopBceCleanScan _ ok) ok])]))

(define (opt-loop-bce-length-clean-pass
  [functions : CompilerIrFunctionList]
  [clean : StringI64Map]) : OptLoopBceCleanPass
  (match functions
    [(IrFunctionNil) (OptLoopBceCleanPass clean false)]
    [(IrFunctionCons func rest)
      (match (opt-loop-bce-length-clean-pass (box-get rest) clean)
        [(OptLoopBceCleanPass tail-clean tail-added)
          (match func
            [(IrFunction name _ _ _ _)
              (if (string-i64-map-contains? tail-clean name)
                (OptLoopBceCleanPass tail-clean tail-added)
                (if (opt-loop-bce-function-length-clean? func tail-clean)
                  (OptLoopBceCleanPass
                    (string-i64-map-put tail-clean name 1)
                    true)
                  (OptLoopBceCleanPass tail-clean tail-added)))])])]
    [(IrFunctionArray seq)
      (opt-loop-bce-length-clean-pass
        (compiler-ir-function-seq-to-list seq)
        clean)]))

(define (opt-loop-bce-length-clean-fixed
  [functions : CompilerIrFunctionList]
  [clean : StringI64Map]
  [remaining : i64]) : StringI64Map
  (if (<= remaining 0)
    clean
    (match (opt-loop-bce-length-clean-pass functions clean)
      [(OptLoopBceCleanPass next added)
        (if added
          (opt-loop-bce-length-clean-fixed functions next (- remaining 1))
          next)])))

;; #3468: prove which globals are compile-time constants so their value can be
;; substituted for the global at its uses. The win is twofold: (a) every global
;; use otherwise emits a rip-relative load, so substituting the literal removes a
;; per-iteration memory load (the instruction-count win on opt_crc32/opt_quicksort
;; mask constants), and (b) a div/mod by such a global becomes a literal divisor
;; the backend strength-reduces with the existing magic-multiply path (matching
;; clang).
;;
;; Soundness: substituting a global's initializer is valid only when the global is
;; immutable. A global is mutated by either (1) a direct `IrInstrStore name`
;; (the lowering of `(set! global ...)`, see compiler_lower.tl AstExprSet), or
;; (2) a write through a pointer derived from its address, which only exists if
;; `(& global)` was taken -- lowered to `IrValueGlobalAddr name`. Disqualifying a
;; global on EITHER signal leaves only provably-never-written globals, whose value
;; equals the initializer at every use. The disqualify walk mirrors
;; `opt-reach-instr` arm-for-arm (and, like it, omits a wildcard arm) so adding a
;; new IR instruction fails to compile until it is handled here -- a new operand
;; position can never silently escape the address-taken check.
(define (opt-const-globals-disq-value
  [disq : StringI64Map]
  [value : CompilerIrValue]) : StringI64Map
  (match value
    [(IrValueGlobalAddr name) (string-i64-map-put disq name 1)]
    [_ disq]))

(define (opt-const-globals-disq-args-array
  [disq : StringI64Map]
  [values : (Array CompilerIrValue)]
  [index : i64]) : StringI64Map
  (if (>= index (array-length values))
    disq
    (opt-const-globals-disq-args-array
      (opt-const-globals-disq-value disq (array-ref values index))
      values
      (+ index 1))))

(define (opt-const-globals-disq-args
  [disq : StringI64Map]
  [args : CompilerIrCallArgs]) : StringI64Map
  (match args
    [(IrCallArgsNil) disq]
    [(IrCallArgsOne value) (opt-const-globals-disq-value disq value)]
    [(IrCallArgsTwo a b)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq a) b)]
    [(IrCallArgsArray values) (opt-const-globals-disq-args-array disq values 0)]))

(define (opt-const-globals-disq-maybe
  [disq : StringI64Map]
  [maybe : CompilerIrMaybeValue]) : StringI64Map
  (match maybe
    [(IrNoValue) disq]
    [(IrSomeValue value) (opt-const-globals-disq-value disq value)]))

(define (opt-const-globals-disq-phi
  [disq : StringI64Map]
  [inputs : CompilerIrPhiInputList]) : StringI64Map
  (match inputs
    [(IrPhiInputNil) disq]
    [(IrPhiInputCons value _ rest)
      (opt-const-globals-disq-phi
        (opt-const-globals-disq-value disq value)
        (box-get rest))]))

;; Disqualify a global on a direct store to it OR on any `IrValueGlobalAddr`
;; operand. Mirrors opt-reach-instr (no wildcard arm); the only behavioural
;; differences are that `IrInstrStore` also records its target name and call/tail
;; targets (function names, never const-global candidates) are not scanned.
(define (opt-const-globals-disq-instr
  [disq : StringI64Map]
  [instr : CompilerIrInstr]) : StringI64Map
  (match instr
    [(IrInstrMov _ src _) (opt-const-globals-disq-value disq src)]
    [(IrInstrAlloc _ _) disq]
    [(IrInstrAddrOf _ _) disq]
    [(IrInstrGep _ base offset _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq base)
        offset)]
    [(IrInstrLoad _ src _) (opt-const-globals-disq-value disq src)]
    [(IrInstrStorePtr dst src _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq dst) src)]
    [(IrInstrCopyBytes dst src _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq dst) src)]
    [(IrInstrBoundsCheck idx length _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq idx)
        length)]
    [(IrInstrCast _ src _ _) (opt-const-globals-disq-value disq src)]
    [(IrInstrBitcast _ src _ _) (opt-const-globals-disq-value disq src)]
    [(IrInstrBinOp _ _ lhs rhs _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq lhs) rhs)]
    [(IrInstrUnOp _ _ src _) (opt-const-globals-disq-value disq src)]
    [(IrInstrLaneId _ _ _) disq]
    [(IrInstrSplat _ value _ _) (opt-const-globals-disq-value disq value)]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload _ _ lhs rhs _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq lhs)
            rhs)])]
    [(IrInstrVectorReduce _ _ src _ _) (opt-const-globals-disq-value disq src)]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload _ _ lhs rhs _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq lhs)
            rhs)])]
    [(IrInstrMaskBinOp _ _ lhs rhs _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq lhs) rhs)]
    [(IrInstrMaskNot _ src _) (opt-const-globals-disq-value disq src)]
    [(IrInstrMaskReduce _ _ src _) (opt-const-globals-disq-value disq src)]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload _ mask on-true on-false _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq mask)
              on-true)
            on-false)])]
    [(IrInstrVectorLoad _ base idx _ _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq base)
        idx)]
    [(IrInstrVectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload base idx value _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq base)
              idx)
            value)])]
    [(IrInstrPredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload base idx value mask _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value
                (opt-const-globals-disq-value disq base)
                idx)
              value)
            mask)])]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload _ base idx mask _ _)
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq base)
              idx)
            mask)])]
    [(IrInstrTailMask _ idx length _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq idx)
        length)]
    [(IrInstrEntryArgc _) disq]
    [(IrInstrEntryArgv _) disq]
    [(IrInstrEntryEnvp _) disq]
    [(IrInstrCpuId _ leaf subleaf _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq leaf)
        subleaf)]
    [(IrInstrXgetbv _ idx) (opt-const-globals-disq-value disq idx)]
    [(IrInstrSyscall _ args) (opt-const-globals-disq-args disq args)]
    [(IrInstrCall _ _ args _) (opt-const-globals-disq-args disq args)]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload base _ args _)
          (opt-const-globals-disq-args
            (opt-const-globals-disq-value disq base)
            args)])]
    [(IrInstrCallIndirect _ func args _)
      (opt-const-globals-disq-args
        (opt-const-globals-disq-value disq func)
        args)]
    [(IrInstrCallIndirectC _ func args _)
      (opt-const-globals-disq-args
        (opt-const-globals-disq-value disq func)
        args)]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload base func args _)
          (opt-const-globals-disq-args
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq base)
              func)
            args)])]
    [(IrInstrTailCall _ args _) (opt-const-globals-disq-args disq args)]
    [(IrInstrStore name value _)
      (opt-const-globals-disq-value (string-i64-map-put disq name 1) value)]
    [(IrInstrJump _) disq]
    [(IrInstrBranch cond _ _) (opt-const-globals-disq-value disq cond)]
    [(IrInstrReturn maybe) (opt-const-globals-disq-maybe disq maybe)]
    [(IrInstrPhi _ inputs _) (opt-const-globals-disq-phi disq inputs)]
    [(IrInstrPack _ _ _) disq]
    [(IrInstrWord _ src _ _) (opt-const-globals-disq-value disq src)]
    [(IrInstrTailCallIndirect func args _)
      (opt-const-globals-disq-args
        (opt-const-globals-disq-value disq func)
        args)]))

(define (opt-const-globals-disq-seq-from
  [disq : StringI64Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : StringI64Map
  (if (>= index count)
    disq
    (opt-const-globals-disq-seq-from
      (opt-const-globals-disq-instr
        disq
        (compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1)
      count)))

(define (opt-const-globals-disq-blocks
  [disq : StringI64Map]
  [blocks : CompilerIrBlockList]) : StringI64Map
  (match blocks
    [(IrBlockNil) disq]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-const-globals-disq-blocks
            (opt-const-globals-disq-seq-from
              disq
              instrs
              0
              (compiler-ir-instr-seq-count instrs))
            (box-get rest))])]
    [(IrBlockArray seq)
      (opt-const-globals-disq-blocks disq (compiler-ir-block-seq-to-list seq))]))

(define (opt-const-globals-disqualified
  [disq : StringI64Map]
  [functions : CompilerIrFunctionList]) : StringI64Map
  (match functions
    [(IrFunctionNil) disq]
    [(IrFunctionCons func rest)
      (match func
        [(IrFunction _ _ _ _ blocks)
          (opt-const-globals-disqualified
            (opt-const-globals-disq-blocks disq blocks)
            (box-get rest))])]
    [(IrFunctionArray seq)
      (opt-const-globals-disqualified
        disq
        (compiler-ir-function-seq-to-list seq))]))

;; Build the constant table: literal `IrValueI64` globals that are neither
;; disqualified (stored / address-taken) nor zero. Zero is excluded so a
;; substituted divisor can never become a literal `0` (the backend's
;; magic-multiply path assumes a nonzero divisor; an actual `% 0` keeps its
;; original trapping global-load form).
(define (opt-const-globals-from-globals
  [globals : CompilerIrGlobalList]
  [disq : StringI64Map]
  [map : StringI64Map]) : StringI64Map
  (match globals
    [(IrGlobalNil) map]
    [(IrGlobalCons global rest)
      (opt-const-globals-from-globals
        (box-get rest)
        disq
        (match global
          [(IrGlobal name _ value)
            (match value
              [(IrValueI64 n)
                (if (or (= n 0) (string-i64-map-contains? disq name))
                  map
                  (string-i64-map-put map name n))]
              [_ map])]))]))

(define (opt-const-divisors-build
  [globals : CompilerIrGlobalList]
  [functions : CompilerIrFunctionList]) : StringI64Map
  (let
    [capacity : i64
      (opt-function-index-capacity (compiler-ir-global-list-count globals))]
    [disq : StringI64Map
      (opt-const-globals-disqualified
        (string-i64-map-with-capacity capacity)
        functions)]
    (opt-const-globals-from-globals
      globals
      disq
      (string-i64-map-with-capacity capacity))))

;; The BCE summaries (argc-return + length-clean) gate on a function-count limit
;; because the length-clean pass runs a per-function fixpoint. The const-divisor
;; table is independent and far cheaper (one linear store scan), so it is built
;; separately by the program driver and injected here rather than tied to this
;; gate -- see optimize-program-with-level.
(define (opt-loop-bce-build-summaries [functions : CompilerIrFunctionList]) : OptLoopBceSummaries
  (let
    [capacity : i64
      (opt-function-index-capacity (opt-function-list-count functions))]
    [argc-return : StringI64Map
      (opt-loop-bce-argc-return-map
        functions
        (string-i64-map-with-capacity capacity))]
    [length-clean : StringI64Map
      (match (opt-loop-bce-length-clean-pass
        functions
        (string-i64-map-with-capacity capacity))
        [(OptLoopBceCleanPass clean _) clean])]
    (OptLoopBceSummaries
      true
      length-clean
      argc-return
      (string-i64-map-with-capacity 1))))

(define (opt-loop-bce-summaries-set-const-divisors
  [summaries : OptLoopBceSummaries]
  [const-divisors : StringI64Map]) : OptLoopBceSummaries
  (OptLoopBceSummaries
    (struct-get summaries enabled)
    (struct-get summaries length-clean)
    (struct-get summaries argc-return)
    const-divisors))

;; Build the per-program summaries: the function-count-gated BCE maps plus the
;; const-divisor table. The const-divisor table is built only at opt level 2
;; (the only level whose pipeline runs the divisor rewrite), so opt0/opt1 -- and
;; in particular the opt1 self-compile throughput metric -- pay nothing for it
;; and stay byte-identical.
(define (opt-build-program-summaries
  [globals : CompilerIrGlobalList]
  [reachable-functions : CompilerIrFunctionList]
  [level : i64]) : OptLoopBceSummaries
  (opt-loop-bce-summaries-set-const-divisors
    (if (<= (opt-function-list-count reachable-functions) 64)
      (opt-loop-bce-build-summaries reachable-functions)
      (opt-loop-bce-empty-summaries))
    (if (>= level 2)
      (opt-const-divisors-build globals reachable-functions)
      (string-i64-map-with-capacity 1))))

;; #3468 rewrite: substitute a proven constant global with its literal value in
;; binop operands. For an ordinary operand this lets the backend fold the literal
;; instead of emitting a per-use rip-relative load (the opt_crc32/opt_quicksort
;; mask-load win). For a div/mod divisor it produces a literal `IrValueI64`, which
;; `compiler-backend-binop-literal-divmod-asm` strength-reduces with the existing
;; magic-multiply path (matching clang). Binops are the const uses in the hot
;; loops of all three optimization benchmarks (masks via bit-and/bit-xor, the
;; modulo divisor); other instruction kinds keep the global's hidden-load form.
;; (The map is named `const-divisors` for historical reasons but now holds every
;; proven-constant global, not only divisors.)
(define (opt-const-global-subst-value
  [const-divisors : StringI64Map]
  [v : CompilerIrValue]) : CompilerIrValue
  (match v
    [(IrValueGlobal name)
      (match (string-i64-map-get const-divisors name)
        [(StringI64MapFound n) (IrValueI64 n)]
        [(StringI64MapMissing) v])]
    [_ v]))

(define (opt-const-divisor-rewrite-instr
  [const-divisors : StringI64Map]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(IrInstrBinOp dst op lhs rhs ty)
      (IrInstrBinOp
        dst
        op
        (opt-const-global-subst-value const-divisors lhs)
        (opt-const-global-subst-value const-divisors rhs)
        ty)]
    [_ instr]))

(define (opt-const-divisor-rewrite-seq-from
  [const-divisors : StringI64Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [out-rev : CompilerIrInstrList]) : CompilerIrInstrList
  (if (>= index count)
    (compiler-ir-instr-list-reverse-onto out-rev IrInstrNil)
    (opt-const-divisor-rewrite-seq-from
      const-divisors
      instrs
      (+ index 1)
      count
      (compiler-ir-instr-cons
        (opt-const-divisor-rewrite-instr
          const-divisors
          (compiler-ir-instr-seq-ref instrs index))
        out-rev))))

(define (opt-const-divisor-rewrite-block
  [const-divisors : StringI64Map]
  [block : CompilerIrBlock]) : CompilerIrBlock
  (match block
    [(IrBlock label instrs)
      (compiler-ir-block
        label
        (opt-const-divisor-rewrite-seq-from
          const-divisors
          instrs
          0
          (compiler-ir-instr-seq-count instrs)
          IrInstrNil))]))

(define (opt-const-divisor-rewrite-blocks
  [const-divisors : StringI64Map]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(IrBlockNil) IrBlockNil]
    [(IrBlockCons block rest)
      (compiler-ir-block-cons
        (opt-const-divisor-rewrite-block const-divisors block)
        (opt-const-divisor-rewrite-blocks const-divisors (box-get rest)))]
    [(IrBlockArray seq)
      (opt-const-divisor-rewrite-blocks
        const-divisors
        (compiler-ir-block-seq-to-list seq))]))

;; Skip the whole pass (returning the blocks untouched) when no constant-global
;; divisor exists -- the common case, so the level-2 fixpoint pays only a length
;; check per function rather than a block walk.
(define (opt-const-divisor-rewrite-summary-blocks
  [summaries : OptLoopBceSummaries]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [const-divisors : StringI64Map (struct-get summaries const-divisors)]
    (if (= (string-i64-map-len const-divisors) 0)
      blocks
      (opt-const-divisor-rewrite-blocks const-divisors blocks))))

(define (optimize-program [program : CompilerIrProgram]) : CompilerIrProgram
  (optimize-program-with-level program (compiler-optimize-default-level)))

(define (optimize-program-with-level
  [program : CompilerIrProgram]
  [level : i64]) : CompilerIrProgram
  (match program
    [(IrProgram globals functions externs)
      (if (= level 0)
        program
        ;; Levels 1 (cheap) and 2 (quality) both prune unreachable functions;
        ;; inlining self-gates to level 2 inside opt-inline-program-functions.
        (begin
          (cfg compile-profile (compiler-opt-profile-start))
          (let
            [reachable-functions : CompilerIrFunctionList
              (opt-inline-program-functions functions level)]
            (begin
              (cfg compile-profile (compiler-opt-profile-finish "pre_prune"))
              (cfg compile-profile (compiler-opt-profile-start))
              (let
                [summaries : OptLoopBceSummaries
                  (opt-build-program-summaries
                    globals
                    reachable-functions
                    level)]
                [optimized-functions : CompilerIrFunctionList
                  (optimize-function-list-with-level-and-summaries
                    reachable-functions
                    level
                    summaries)]
                (begin
                  (cfg
                    compile-profile
                    (compiler-opt-profile-finish "functions"))
                  (cfg compile-profile (compiler-opt-profile-start))
                  (let
                    [final-functions : CompilerIrFunctionList
                      (opt-prune-unreachable-functions
                        globals
                        optimized-functions
                        externs)]
                    (begin
                      (cfg
                        compile-profile
                        (compiler-opt-profile-finish "post_prune"))
                      (IrProgram
                        globals
                        (compiler-ir-function-list-compact final-functions)
                        externs)))))))))]))

(define (opt-remap-spans-prepend-entry
  [spans : CompilerSourceSpans]
  [key : String]
  [span : AstSourceSpan]) : CompilerSourceSpans
  (match spans
    [(CompilerSourceSpans entries instr-entries instr-count)
      (CompilerSourceSpans
        entries
        (CompilerSourceSpansEntryCons
          (CompilerSourceSpansEntry key span)
          (box instr-entries))
        (+ instr-count 1))]))

;; The remap previously rebuilt the "value:<function>:<var>" key string --
;; three appends -- for EVERY instruction in the program, then rebuilt the
;; same key again on every hit. Now the per-function "value:<function>:"
;; prefix is built once, each key is one append, the key is shared between
;; lookup and prepend, and only instructions whose kind can carry a span
;; build a key at all. The key arms mirror the kinds the replaced
;; per-instruction prepend matcher accepted: indirect-call destinations were
;; looked up and then dropped by its fall-through, so skipping their lookups
;; cannot change the produced spans. The entry-list probe stays the linear
;; first-match scan: entries are bounded by the 2049 fast-path cutoff, and a
;; hash-indexed variant measured MORE executed instructions once #2735 moved
;; hash-string into TypeLisp (long keys hash per instruction).
(defenum OptRemapSpanKey
  (OptRemapSpanNoKey)
  (OptRemapSpanSomeKey String))

(define (opt-remap-spans-value-key [value-prefix : String] [dst : i64]) : String
  (string-append value-prefix (int->string dst)))

(define (opt-remap-spans-instr-key
  [value-prefix : String]
  [function : String]
  [instr : CompilerIrInstr]) : OptRemapSpanKey
  (match instr
    [(IrInstrMov dst _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrAlloc dst _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrAddrOf dst _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrGep dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrLoad dst _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrCast dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrBitcast dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrBinOp dst _ _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrUnOp dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrLaneId dst _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrSplat dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrVectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload dst _ _ _ _ _)
          (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))])]
    [(IrInstrVectorReduce dst _ _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrVectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload dst _ _ _ _ _)
          (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))])]
    [(IrInstrMaskBinOp dst _ _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrMaskNot dst _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrMaskReduce dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrSelect payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload dst _ _ _ _ _)
          (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))])]
    [(IrInstrVectorLoad dst _ _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrPredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
          (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))])]
    [(IrInstrTailMask dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrEntryArgc dst)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrEntryArgv dst)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrEntryEnvp dst)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrCpuId dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrXgetbv dst _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrSyscall dst _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrCall dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrPack dst _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [(IrInstrWord dst _ _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    ;; Tail-indirect is control flow and does not define a destination value.
    [(IrInstrTailCallIndirect _ _ _) (OptRemapSpanNoKey)]
    [(IrInstrStore name _ _)
      (OptRemapSpanSomeKey (compiler-source-spans-store-key function name))]
    [(IrInstrPhi dst _ _)
      (OptRemapSpanSomeKey (opt-remap-spans-value-key value-prefix dst))]
    [_ (OptRemapSpanNoKey)]))

(define (opt-remap-spans-instr
  [instr-entries : CompilerSourceSpansEntryList]
  [out : CompilerSourceSpans]
  [value-prefix : String]
  [function : String]
  [instr : CompilerIrInstr]) : CompilerSourceSpans
  (match (opt-remap-spans-instr-key value-prefix function instr)
    [(OptRemapSpanNoKey) out]
    [(OptRemapSpanSomeKey key)
      (match (compiler-source-spans-entry-list-lookup instr-entries key)
        [(CompilerSomeSourceSpan span)
          (opt-remap-spans-prepend-entry out key span)]
        [(CompilerNoSourceSpan) out])]))

(define (opt-remap-spans-instr-seq-from
  [instr-entries : CompilerSourceSpansEntryList]
  [out : CompilerSourceSpans]
  [value-prefix : String]
  [function : String]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerSourceSpans
  (if (>= index (compiler-ir-instr-seq-count instrs))
    out
    (opt-remap-spans-instr-seq-from
      instr-entries
      (opt-remap-spans-instr
        instr-entries
        out
        value-prefix
        function
        (compiler-ir-instr-seq-ref instrs index))
      value-prefix
      function
      instrs
      (+ index 1))))

(define (opt-remap-spans-instr-seq
  [instr-entries : CompilerSourceSpansEntryList]
  [out : CompilerSourceSpans]
  [value-prefix : String]
  [function : String]
  [instrs : CompilerIrInstrSeq]) : CompilerSourceSpans
  (opt-remap-spans-instr-seq-from
    instr-entries
    out
    value-prefix
    function
    instrs
    0))

(define (opt-remap-spans-blocks
  [instr-entries : CompilerSourceSpansEntryList]
  [out : CompilerSourceSpans]
  [value-prefix : String]
  [function : String]
  [blocks : CompilerIrBlockList]) : CompilerSourceSpans
  (match blocks
    [(IrBlockNil) out]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-remap-spans-blocks
            instr-entries
            (opt-remap-spans-instr-seq
              instr-entries
              out
              value-prefix
              function
              instrs)
            value-prefix
            function
            (box-get rest))])]
    [(IrBlockArray seq)
      (opt-remap-spans-blocks
        instr-entries
        out
        value-prefix
        function
        (compiler-ir-block-seq-to-list seq))]))

(define (opt-remap-spans-function
  [instr-entries : CompilerSourceSpansEntryList]
  [out : CompilerSourceSpans]
  [func : CompilerIrFunction]) : CompilerSourceSpans
  (match func
    [(IrFunction name _ _ _ blocks)
      (opt-remap-spans-blocks
        instr-entries
        out
        (string-append (string-append "value:" name) ":")
        name
        blocks)]))

(define (opt-remap-spans-functions
  [instr-entries : CompilerSourceSpansEntryList]
  [out : CompilerSourceSpans]
  [funcs : CompilerIrFunctionList]) : CompilerSourceSpans
  (match funcs
    [(IrFunctionNil) out]
    [(IrFunctionCons func rest)
      (opt-remap-spans-functions
        instr-entries
        (opt-remap-spans-function instr-entries out func)
        (box-get rest))]
    [(IrFunctionArray seq)
      (opt-remap-spans-functions
        instr-entries
        out
        (compiler-ir-function-seq-to-list seq))]))

(define (opt-remap-spans-fast-path? [source-spans : CompilerSourceSpans]) : bool
  (compiler-source-spans-instr-count-at-least? source-spans 2049))

(define (opt-remap-spans-program
  [source-spans : CompilerSourceSpans]
  [program : CompilerIrProgram]) : CompilerSourceSpans
  (if (opt-remap-spans-fast-path? source-spans)
    (compiler-source-spans-clear-instrs source-spans)
    (match source-spans
      [(CompilerSourceSpans _ instr-entries _)
        (match program
          [(IrProgram _ functions _)
            (opt-remap-spans-functions
              instr-entries
              (compiler-source-spans-clear-instrs source-spans)
              functions)])])))

(define (optimize-program-with-spans-and-level
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [level : i64]) : CompilerOptimizedProgram
  (match program
    [(IrProgram globals functions externs)
      (if (= level 0)
        (CompilerOptimizedProgram
          program
          (opt-remap-spans-program spans program))
        (begin
          (cfg compile-profile (compiler-opt-profile-start))
          (match (opt-inline-program-functions-with-spans functions level spans)
            [(OptInlineSpanProgram reachable-functions inline-spans)
              (begin
                (cfg compile-profile (compiler-opt-profile-finish "pre_prune"))
                (cfg compile-profile (compiler-opt-profile-start))
                (let
                  [summaries : OptLoopBceSummaries
                    (opt-build-program-summaries
                      globals
                      reachable-functions
                      level)]
                  [optimized-functions : CompilerIrFunctionList
                    (optimize-function-list-with-level-and-summaries
                      reachable-functions
                      level
                      summaries)]
                  (begin
                    (cfg
                      compile-profile
                      (compiler-opt-profile-finish "functions"))
                    (cfg compile-profile (compiler-opt-profile-start))
                    (let
                      [final-functions : CompilerIrFunctionList
                        (opt-prune-unreachable-functions
                          globals
                          optimized-functions
                          externs)]
                      [optimized : CompilerIrProgram
                        (IrProgram
                          globals
                          (compiler-ir-function-list-compact final-functions)
                          externs)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-opt-profile-finish "post_prune"))
                        (CompilerOptimizedProgram
                          optimized
                          (opt-remap-spans-program inline-spans optimized)))))))])))]))

(define (optimize-program-with-spans
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]) : CompilerOptimizedProgram
  (optimize-program-with-spans-and-level
    program
    spans
    (compiler-optimize-default-level)))

;; --- self-test ---------------------------------------------------------------
(define (opt-count-arith-instrs [instrs : CompilerIrInstrList]) : i64
  (match instrs
    [(IrInstrNil) 0]
    [(IrInstrCons instr rest)
      (+ (opt-arith-instr-count instr) (opt-count-arith-instrs (box-get rest)))]))

(define (opt-arith-instr-count [instr : CompilerIrInstr]) : i64
  (match instr
    [(IrInstrBinOp _ _ _ _ _) 1]
    [(IrInstrUnOp _ _ _ _) 1]
    [_ 0]))

(define (opt-count-arith-instr-seq-from
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-arith-instr-seq-from
      slots
      (+ index 1)
      count
      (+ acc (opt-arith-instr-count (array-ref slots index))))))

(define (opt-count-arith-instr-seq [instrs : CompilerIrInstrSeq]) : i64
  (opt-count-arith-instr-seq-from
    (struct-get instrs slots)
    0
    (struct-get instrs len)
    0))

(define (opt-cpuid-instr-count [instr : CompilerIrInstr]) : i64
  (match instr
    [(IrInstrCpuId _ _ _ _) 1]
    [_ 0]))

(define (opt-xgetbv-instr-count [instr : CompilerIrInstr]) : i64
  (match instr
    [(IrInstrXgetbv _ _) 1]
    [_ 0]))

(define (opt-count-cpuid-instrs [instrs : CompilerIrInstrList]) : i64
  (match instrs
    [(IrInstrNil) 0]
    [(IrInstrCons instr rest)
      (+ (opt-cpuid-instr-count instr) (opt-count-cpuid-instrs (box-get rest)))]))

(define (opt-count-xgetbv-instrs [instrs : CompilerIrInstrList]) : i64
  (match instrs
    [(IrInstrNil) 0]
    [(IrInstrCons instr rest)
      (+
        (opt-xgetbv-instr-count instr)
        (opt-count-xgetbv-instrs (box-get rest)))]))

(define (opt-count-cpuid-instr-seq-from
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-cpuid-instr-seq-from
      slots
      (+ index 1)
      count
      (+ acc (opt-cpuid-instr-count (array-ref slots index))))))

(define (opt-count-cpuid-instr-seq [instrs : CompilerIrInstrSeq]) : i64
  (opt-count-cpuid-instr-seq-from
    (struct-get instrs slots)
    0
    (struct-get instrs len)
    0))

(define (opt-count-xgetbv-instr-seq-from
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-xgetbv-instr-seq-from
      slots
      (+ index 1)
      count
      (+ acc (opt-xgetbv-instr-count (array-ref slots index))))))

(define (opt-count-xgetbv-instr-seq [instrs : CompilerIrInstrSeq]) : i64
  (opt-count-xgetbv-instr-seq-from
    (struct-get instrs slots)
    0
    (struct-get instrs len)
    0))

(define (opt-count-cpuid-blocks [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(IrBlockNil) 0]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (+
            (opt-count-cpuid-instr-seq instrs)
            (opt-count-cpuid-blocks (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-count-cpuid-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-count-xgetbv-blocks [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(IrBlockNil) 0]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (+
            (opt-count-xgetbv-instr-seq instrs)
            (opt-count-xgetbv-blocks (box-get rest)))])]
    [(IrBlockArray seq)
      (opt-count-xgetbv-blocks (compiler-ir-block-seq-to-list seq))]))

(define (opt-sum-mov-i64 [instrs : CompilerIrInstrList]) : i64
  (match instrs
    [(IrInstrNil) 0]
    [(IrInstrCons instr rest)
      (+ (opt-mov-i64-value instr) (opt-sum-mov-i64 (box-get rest)))]))

(define (opt-mov-i64-value [instr : CompilerIrInstr]) : i64
  (match instr
    [(IrInstrMov _ (IrValueI64 n) _) n]
    [_ 0]))

(define (opt-count-mov-i64-value [instrs : CompilerIrInstrList] [needle : i64]) : i64
  (match instrs
    [(IrInstrNil) 0]
    [(IrInstrCons instr rest)
      (+
        (match instr
          [(IrInstrMov _ (IrValueI64 n) _)
            (if (= n needle)
              1
              0)]
          [_ 0])
        (opt-count-mov-i64-value (box-get rest) needle))]))

(define (opt-count-mov-i64-value-instr-seq-from
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [needle : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-mov-i64-value-instr-seq-from
      slots
      (+ index 1)
      count
      needle
      (+
        acc
        (match (array-ref slots index)
          [(IrInstrMov _ (IrValueI64 n) _)
            (if (= n needle)
              1
              0)]
          [_ 0])))))

(define (opt-count-mov-i64-value-instr-seq
  [instrs : CompilerIrInstrSeq]
  [needle : i64]) : i64
  (opt-count-mov-i64-value-instr-seq-from
    (struct-get instrs slots)
    0
    (struct-get instrs len)
    needle
    0))

(define (opt-count-mov-bool-value
  [instrs : CompilerIrInstrList]
  [needle : bool]) : i64
  (match instrs
    [(IrInstrNil) 0]
    [(IrInstrCons instr rest)
      (+
        (match instr
          [(IrInstrMov _ (IrValueBool b) _)
            (if needle
              (if b
                1
                0)
              (if b
                0
                1))]
          [_ 0])
        (opt-count-mov-bool-value (box-get rest) needle))]))

(define (opt-sum-mov-var-src [instrs : CompilerIrInstrList]) : i64
  (match instrs
    [(IrInstrNil) 0]
    [(IrInstrCons instr rest)
      (+
        (match instr
          [(IrInstrMov _ (IrValueVar id) _) id]
          [_ 0])
        (opt-sum-mov-var-src (box-get rest)))]))

(define (opt-mov-dst-type-tag [instrs : CompilerIrInstrList] [dst : i64]) : i64
  (match instrs
    [(IrInstrNil) 0]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrMov d _ ty)
          (if (= d dst)
            (ast-type-tag ty)
            (opt-mov-dst-type-tag (box-get rest) dst))]
        [_ (opt-mov-dst-type-tag (box-get rest) dst)])]))

(define (opt-mov-dst-i64-value
  [instrs : CompilerIrInstrList]
  [dst : i64]
  [fallback : i64]) : i64
  (match instrs
    [(IrInstrNil) fallback]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrMov d (IrValueI64 n) _)
          (if (= d dst)
            n
            (opt-mov-dst-i64-value (box-get rest) dst fallback))]
        [_ (opt-mov-dst-i64-value (box-get rest) dst fallback)])]))

(define (opt-mov-dst-i64-value-instr-seq-from
  [slots : (Array CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index count)
    fallback
    (match (array-ref slots index)
      [(IrInstrMov d (IrValueI64 n) _)
        (if (= d dst)
          n
          (opt-mov-dst-i64-value-instr-seq-from
            slots
            (+ index 1)
            count
            dst
            fallback))]
      [_
        (opt-mov-dst-i64-value-instr-seq-from
          slots
          (+ index 1)
          count
          dst
          fallback)])))

(define (opt-mov-dst-i64-value-instr-seq
  [instrs : CompilerIrInstrSeq]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-mov-dst-i64-value-instr-seq-from
    (struct-get instrs slots)
    0
    (struct-get instrs len)
    dst
    fallback))

(define (opt-mov-dst-bool-value?
  [instrs : CompilerIrInstrList]
  [dst : i64]
  [needle : bool]) : bool
  (match instrs
    [(IrInstrNil) false]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrMov d (IrValueBool b) _)
          (if (= d dst)
            (if needle
              b
              (not b))
            (opt-mov-dst-bool-value? (box-get rest) dst needle))]
        [_ (opt-mov-dst-bool-value? (box-get rest) dst needle)])]))

(define (opt-mov-dst-char-code
  [instrs : CompilerIrInstrList]
  [dst : i64]
  [fallback : i64]) : i64
  (match instrs
    [(IrInstrNil) fallback]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrMov d (IrValueChar c) _)
          (if (= d dst)
            (cast c : i64)
            (opt-mov-dst-char-code (box-get rest) dst fallback))]
        [_ (opt-mov-dst-char-code (box-get rest) dst fallback)])]))

(define (opt-test-f64-bits [text : String]) : u64
  (match (compiler-float-parse-f64-bits text)
    [(CompilerFloatSomeBits bits) bits]
    [(CompilerFloatNoBits) (cast 0 : u64)]))

(define (opt-test-f32-bits [text : String]) : u64
  (match (compiler-float-parse-f32-bits text)
    [(CompilerFloatSomeBits bits) bits]
    [(CompilerFloatNoBits) (cast 0 : u64)]))

(define (opt-mov-dst-f64-bits?
  [instrs : CompilerIrInstrList]
  [dst : i64]
  [want : u64]) : bool
  (match instrs
    [(IrInstrNil) false]
    [(IrInstrCons instr rest)
      (match instr
        [(IrInstrMov d (IrValueF64 bits) _)
          (if (= d dst)
            (= bits want)
            (opt-mov-dst-f64-bits? (box-get rest) dst want))]
        [_ (opt-mov-dst-f64-bits? (box-get rest) dst want)])]))

(define (opt-test-span [line : i64] [col : i64]) : AstSourceSpan
  (AstSourceSpan line col line col))

(define (opt-source-span-line-col-ok?
  [span : AstSourceSpan]
  [line : i64]
  [col : i64]) : bool
  (and
    (= (struct-get span start-line) line)
    (= (struct-get span start-col) col)))

(define (opt-span-lookup-ok?
  [spans : CompilerSourceSpans]
  [function : String]
  [instr : CompilerIrInstr]
  [line : i64]
  [col : i64]) : bool
  (match (compiler-source-spans-lookup-instr spans function instr)
    [(CompilerSomeSourceSpan span) (opt-source-span-line-col-ok? span line col)]
    [(CompilerNoSourceSpan) false]))

(define (opt-span-lookup-missing?
  [spans : CompilerSourceSpans]
  [function : String]
  [instr : CompilerIrInstr]) : bool
  (match (compiler-source-spans-lookup-instr spans function instr)
    [(CompilerSomeSourceSpan _) false]
    [(CompilerNoSourceSpan) true]))

(define (opt-spans-function [instrs : CompilerIrInstrList]) : CompilerIrFunction
  (IrFunction
    "main"
    IrParamNil
    (AstTyI64)
    4
    (compiler-ir-block-cons (compiler-ir-block "entry" instrs) IrBlockNil)))

(define (opt-spans-program [instrs : CompilerIrInstrList]) : CompilerIrProgram
  (IrProgram
    IrGlobalNil
    (compiler-ir-function-cons (opt-spans-function instrs) IrFunctionNil)
    IrExternNil))

(define (opt-spans-base) : CompilerSourceSpans
  (compiler-source-spans-insert
    (compiler-source-spans-empty)
    "main"
    (opt-test-span 3 1)))

(define (compiler-optimize-spans-dce-ok?) : bool
  (let
    [dead : CompilerIrInstr (IrInstrMov 0 (IrValueI64 1) (AstTyI64))]
    [live : CompilerIrInstr (IrInstrCall 1 "opaque" (IrCallArgsNil) (AstTyI64))]
    [instrs : CompilerIrInstrList
      (compiler-ir-instr-cons
        dead
        (compiler-ir-instr-cons
          live
          (compiler-ir-instr-cons
            (IrInstrReturn (IrSomeValue (IrValueVar 1)))
            IrInstrNil)))]
    [spans : CompilerSourceSpans
      (compiler-source-spans-insert-instr
        (compiler-source-spans-insert-instr
          (opt-spans-base)
          "main"
          dead
          (opt-test-span 21 3))
        "main"
        live
        (opt-test-span 31 5))]
    (match (optimize-program-with-spans-and-level
      (opt-spans-program instrs)
      spans
      1)
      [(CompilerOptimizedProgram _ optimized-spans)
        (and
          (= (compiler-source-spans-instr-count optimized-spans) 1)
          (opt-span-lookup-missing? optimized-spans "main" dead)
          (opt-span-lookup-ok? optimized-spans "main" live 31 5))])))

(define (compiler-optimize-spans-fold-ok?) : bool
  (let
    [folded : CompilerIrInstr
      (IrInstrBinOp 2 (IrBinAdd) (IrValueI64 20) (IrValueI64 22) (AstTyI64))]
    [rewritten : CompilerIrInstr (IrInstrMov 2 (IrValueI64 42) (AstTyI64))]
    [instrs : CompilerIrInstrList
      (compiler-ir-instr-cons
        folded
        (compiler-ir-instr-cons
          (IrInstrAddrOf 3 2)
          (compiler-ir-instr-cons
            (IrInstrReturn (IrSomeValue (IrValueVar 3)))
            IrInstrNil)))]
    [spans : CompilerSourceSpans
      (compiler-source-spans-insert-instr
        (opt-spans-base)
        "main"
        folded
        (opt-test-span 41 7))]
    (match (optimize-program-with-spans-and-level
      (opt-spans-program instrs)
      spans
      2)
      [(CompilerOptimizedProgram _ optimized-spans)
        (opt-span-lookup-ok? optimized-spans "main" rewritten 41 7)])))

(define (compiler-optimize-spans-cse-ok?) : bool
  (let
    [first : CompilerIrInstr
      (IrInstrBinOp 2 (IrBinAdd) (IrValueVar 0) (IrValueVar 1) (AstTyI64))]
    [second : CompilerIrInstr
      (IrInstrBinOp 3 (IrBinAdd) (IrValueVar 0) (IrValueVar 1) (AstTyI64))]
    [rewritten : CompilerIrInstr (IrInstrMov 3 (IrValueVar 2) (AstTyI64))]
    [instrs : CompilerIrInstrList
      (compiler-ir-instr-cons
        first
        (compiler-ir-instr-cons
          second
          (compiler-ir-instr-cons
            (IrInstrAddrOf 4 3)
            (compiler-ir-instr-cons
              (IrInstrReturn (IrSomeValue (IrValueVar 4)))
              IrInstrNil))))]
    [spans : CompilerSourceSpans
      (compiler-source-spans-insert-instr
        (compiler-source-spans-insert-instr
          (opt-spans-base)
          "main"
          first
          (opt-test-span 51 9))
        "main"
        second
        (opt-test-span 61 11))]
    (match (optimize-program-with-spans-and-level
      (opt-spans-program instrs)
      spans
      2)
      [(CompilerOptimizedProgram _ optimized-spans)
        (and
          (opt-span-lookup-ok? optimized-spans "main" first 51 9)
          (opt-span-lookup-ok? optimized-spans "main" rewritten 61 11))])))

(define (opt-inline-span-callee-call) : CompilerIrInstr
  (IrInstrCall 1 "opaque" (IrCallArgsOne (IrValueVar 0)) (AstTyI64)))

(define (opt-inline-span-callee) : CompilerIrFunction
  (IrFunction
    "inline_span"
    (compiler-ir-param-cons (IrParam "value" (AstTyI64) 0) IrParamNil)
    (AstTyI64)
    2
    (compiler-ir-block-cons
      (compiler-ir-block
        "entry"
        (compiler-ir-instr-cons
          (opt-inline-span-callee-call)
          (compiler-ir-instr-cons
            (IrInstrReturn (IrSomeValue (IrValueVar 1)))
            IrInstrNil)))
      IrBlockNil)))

(define (opt-inline-span-caller-call) : CompilerIrInstr
  (IrInstrCall 0 "inline_span" (IrCallArgsOne (IrValueI64 7)) (AstTyI64)))

(define (opt-inline-span-caller) : CompilerIrFunction
  (IrFunction
    "main"
    IrParamNil
    (AstTyI64)
    1
    (compiler-ir-block-cons
      (compiler-ir-block
        "entry"
        (compiler-ir-instr-cons
          (opt-inline-span-caller-call)
          (compiler-ir-instr-cons
            (IrInstrReturn (IrSomeValue (IrValueVar 0)))
            IrInstrNil)))
      IrBlockNil)))

(define (opt-inline-span-program) : CompilerIrProgram
  (IrProgram
    IrGlobalNil
    (compiler-ir-function-cons
      (opt-inline-span-caller)
      (compiler-ir-function-cons (opt-inline-span-callee) IrFunctionNil))
    IrExternNil))

(define (compiler-optimize-spans-inline-callee-ok?) : bool
  (let
    [spans : CompilerSourceSpans
      (compiler-source-spans-insert-instr
        (compiler-source-spans-insert-instr
          (opt-spans-base)
          "inline_span"
          (opt-inline-span-callee-call)
          (opt-test-span 71 13))
        "main"
        (opt-inline-span-caller-call)
        (opt-test-span 81 15))]
    [cloned-call : CompilerIrInstr
      (IrInstrCall 1 "opaque" (IrCallArgsOne (IrValueI64 7)) (AstTyI64))]
    (match (optimize-program-with-spans-and-level
      (opt-inline-span-program)
      spans
      2)
      [(CompilerOptimizedProgram _ optimized-spans)
        (opt-span-lookup-ok? optimized-spans "main" cloned-call 71 13)])))

(define (compiler-optimize-spans-inline-fallback-ok?) : bool
  (let
    [spans : CompilerSourceSpans
