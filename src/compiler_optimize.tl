(define (compiler-optimize-natural-loop-self-test) : i64
  (let
    [single-index : OptCfgIndex (opt-cfg-index-build (opt-ssa-loop-blocks))]
    [single-loops : OptNaturalLoopList
      (opt-cfg-natural-loops (opt-ssa-loop-blocks))]
    [single : OptMaybeNaturalLoop
      (opt-natural-loop-find single-loops "loop" "body")]
    [nested-index : OptCfgIndex
      (opt-cfg-index-build (opt-natural-loop-nested-blocks))]
    [nested-loops : OptNaturalLoopList
      (opt-cfg-natural-loops (opt-natural-loop-nested-blocks))]
    [inner : OptMaybeNaturalLoop
      (opt-natural-loop-find nested-loops "inner" "inner-body")]
    [outer : OptMaybeNaturalLoop
      (opt-natural-loop-find nested-loops "outer" "outer-latch")]
    [diamond-loops : OptNaturalLoopList
      (opt-cfg-natural-loops (opt-ssa-diamond-blocks))]
    [irreducible-loops : OptNaturalLoopList
      (opt-cfg-natural-loops (opt-natural-loop-irreducible-blocks))]
    [no-preheader-loops : OptNaturalLoopList
      (opt-cfg-natural-loops (opt-natural-loop-no-preheader-blocks))]
    [no-preheader : OptMaybeNaturalLoop
      (opt-natural-loop-find no-preheader-loops "loop" "body")]
    [multi-index : OptCfgIndex
      (opt-cfg-index-build (opt-natural-loop-multi-backedge-blocks))]
    [multi-loops : OptNaturalLoopList
      (opt-cfg-natural-loops (opt-natural-loop-multi-backedge-blocks))]
    [multi-left : OptMaybeNaturalLoop
      (opt-natural-loop-find multi-loops "loop" "left")]
    [multi-right : OptMaybeNaturalLoop
      (opt-natural-loop-find multi-loops "loop" "right")]
    [preheadered-single-blocks : CompilerIrBlockList
      (opt-loop-preheaders-blocks (opt-ssa-loop-blocks))]
    [preheadered-nested-blocks : CompilerIrBlockList
      (opt-loop-preheaders-blocks (opt-natural-loop-nested-blocks))]
    [preheadered-multi-blocks : CompilerIrBlockList
      (opt-loop-preheaders-blocks (opt-natural-loop-multi-backedge-blocks))]
    [synth-blocks : CompilerIrBlockList
      (opt-loop-preheaders-blocks (opt-natural-loop-no-preheader-blocks))]
    [synth-index : OptCfgIndex (opt-cfg-index-build synth-blocks)]
    [synth-loops : OptNaturalLoopList (opt-cfg-natural-loops synth-blocks)]
    [synth-loop : OptMaybeNaturalLoop
      (opt-natural-loop-find synth-loops "loop" "body")]
    [preheadered-induction : CompilerIrFunction
      (opt-loop-preheaders-function
        (opt-induction-test-function (opt-induction-no-preheader-blocks)))]
    [preheadered-induction-blocks : CompilerIrBlockList
      (opt-function-blocks preheadered-induction)]
    [induction-after-preheader : CompilerIrFunction
      (opt-induction-function preheadered-induction)]
    [induction-after-preheader-blocks : CompilerIrBlockList
      (opt-function-blocks induction-after-preheader)]
    (cond
      [(not (= (opt-natural-loop-list-count single-loops) 1)) 1]
      [(not (= (opt-natural-loop-maybe-body-count single) 2)) 2]
      [(not (opt-natural-loop-maybe-body-contains? single "loop")) 3]
      [(not (opt-natural-loop-maybe-body-contains? single "body")) 4]
      [(not (opt-natural-loop-maybe-preheader-label? single "entry")) 5]
      [(not (= (opt-natural-loop-list-count nested-loops) 2)) 6]
      [(not (= (opt-natural-loop-maybe-body-count inner) 2)) 7]
      [(not (opt-natural-loop-maybe-body-contains? inner "inner")) 8]
      [(not (opt-natural-loop-maybe-body-contains? inner "inner-body")) 9]
      [(not (opt-natural-loop-maybe-preheader-label? inner "outer")) 10]
      [(not (= (opt-natural-loop-maybe-body-count outer) 4)) 11]
      [(not (opt-natural-loop-maybe-body-contains? outer "outer")) 12]
      [(not (opt-natural-loop-maybe-body-contains? outer "inner")) 13]
      [(not (opt-natural-loop-maybe-body-contains? outer "inner-body")) 14]
      [(not (opt-natural-loop-maybe-body-contains? outer "outer-latch")) 15]
      [(not (opt-natural-loop-maybe-preheader-label? outer "entry")) 16]
      [(not (= (opt-natural-loop-list-count diamond-loops) 0)) 17]
      [(not (= (opt-natural-loop-list-count irreducible-loops) 0)) 18]
      [(not (= (opt-natural-loop-list-count no-preheader-loops) 1)) 19]
      [(not (= (opt-natural-loop-maybe-body-count no-preheader) 2)) 20]
      [(not (opt-natural-loop-maybe-no-preheader? no-preheader)) 21]
      [(not (= (opt-natural-loop-list-count multi-loops) 2)) 22]
      [(not (= (opt-natural-loop-maybe-body-count multi-left) 2)) 23]
      [(not (opt-natural-loop-maybe-body-contains? multi-left "left")) 24]
      [(not (opt-natural-loop-maybe-body-contains? multi-left "loop")) 25]
      [(not (= (opt-natural-loop-maybe-body-count multi-right) 2)) 26]
      [(not (opt-natural-loop-maybe-body-contains? multi-right "right")) 27]
      [(not (opt-natural-loop-maybe-body-contains? multi-right "loop")) 28]
      [(not (= (opt-natural-loop-maybe-body-block-count single) 2)) 29]
      [(not (opt-natural-loop-maybe-body-block-label-at? single 0 "loop")) 30]
      [(not (opt-natural-loop-maybe-body-block-label-at? single 1 "body")) 31]
      [(not
          (opt-natural-loop-maybe-body-contains-id? single-index single "loop"))
        32]
      [(not
          (opt-natural-loop-maybe-body-contains-id? single-index single "body"))
        33]
      [(opt-natural-loop-maybe-body-contains-id? single-index single "entry")
        34]
      [(not (= (opt-natural-loop-maybe-body-block-count outer) 4)) 35]
      [(not (opt-natural-loop-maybe-body-block-label-at? outer 0 "outer")) 36]
      [(not (opt-natural-loop-maybe-body-block-label-at? outer 1 "inner")) 37]
      [(not (opt-natural-loop-maybe-body-block-label-at? outer 2 "inner-body"))
        38]
      [(not (opt-natural-loop-maybe-body-block-label-at? outer 3 "outer-latch"))
        39]
      [(not
          (opt-natural-loop-maybe-body-contains-id?
            nested-index
            outer
            "outer-latch"))
        40]
      [(not (= (opt-natural-loop-maybe-body-block-count multi-left) 2)) 41]
      [(not (opt-natural-loop-maybe-body-block-label-at? multi-left 0 "loop"))
        43]
      [(not (opt-natural-loop-maybe-body-block-label-at? multi-left 1 "left"))
        44]
      [(not (= (opt-natural-loop-maybe-body-block-count multi-right) 2)) 45]
      [(not (opt-natural-loop-maybe-body-block-label-at? multi-right 0 "loop"))
        46]
      [(not (opt-natural-loop-maybe-body-block-label-at? multi-right 1 "right"))
        47]
      [(not
          (opt-natural-loop-maybe-body-contains-id?
            multi-index
            multi-right
            "right"))
        48]
      [(not (opt-block-list-eq preheadered-single-blocks (opt-ssa-loop-blocks)))
        49]
      [(not
          (opt-block-list-eq
            preheadered-nested-blocks
            (opt-natural-loop-nested-blocks)))
        50]
      [(not
          (opt-block-list-eq
            preheadered-multi-blocks
            (opt-natural-loop-multi-backedge-blocks)))
        51]
      [(not (= (compiler-ir-block-list-count synth-blocks) 7)) 52]
      [(not (opt-block-list-has-label? synth-blocks "loop__preheader")) 53]
      [(not
          (opt-natural-loop-maybe-preheader-label? synth-loop "loop__preheader"))
        54]
      [(not
          (opt-label-contains
            (opt-cfg-index-successors synth-index "pre-one")
            "loop__preheader"))
        55]
      [(opt-label-contains
          (opt-cfg-index-successors synth-index "pre-one")
          "loop")
        56]
      [(not
          (opt-label-contains
            (opt-cfg-index-successors synth-index "loop__preheader")
            "loop"))
        57]
      [(not
          (opt-verify-ok?
            (opt-verify-function (opt-cfg-test-function synth-blocks))))
        58]
      [(not (opt-verify-ok? (opt-verify-function preheadered-induction))) 59]
      [(not
          (opt-block-list-has-label?
            preheadered-induction-blocks
            "loop__preheader"))
        60]
      [(not
          (=
            (opt-count-mul-label-blocks induction-after-preheader-blocks "body")
            0))
        61]
      [else 42])))

(define (compiler-optimize-loop-rotation-self-test) : i64
  (let
    [raw : CompilerIrBlockList (opt-loop-rotation-top-test-blocks)]
    [rotated : CompilerIrBlockList (opt-loop-rotation-blocks raw)]
    [false-body-rotated : CompilerIrBlockList
      (opt-loop-rotation-blocks (opt-loop-rotation-false-body-blocks))]
    [ssa : CompilerIrFunction
      (opt-ssa-construct-function (opt-cfg-test-function rotated))]
    [ssa-blocks : CompilerIrBlockList (opt-function-blocks ssa)]
    [optimized : CompilerIrFunction
      (optimize-function (opt-cfg-test-function raw))]
    [optimized-blocks : CompilerIrBlockList (opt-function-blocks optimized)]
    [no-preheader : CompilerIrBlockList (opt-natural-loop-no-preheader-blocks)]
    [multi-backedge : CompilerIrBlockList
      (opt-natural-loop-multi-backedge-blocks)]
    [with-phi : CompilerIrBlockList (opt-ssa-loop-blocks)]
    (cond
      [(not (= (compiler-ir-block-list-count rotated) 3)) 1]
      [(opt-block-list-has-label? rotated "loop") 2]
      [(not (opt-loop-rotation-successors? rotated "entry" "body" "exit")) 3]
      [(not (opt-loop-rotation-successors? rotated "body" "body" "exit")) 4]
      [(not (= (opt-count-jump-to-blocks rotated "loop") 0)) 5]
      [(not (= (opt-count-branches-blocks rotated) 2)) 6]
      [(opt-block-list-has-label? false-body-rotated "loop") 7]
      [(not
          (opt-loop-rotation-successors?
            false-body-rotated
            "entry"
            "body"
            "exit"))
        8]
      [(not (opt-verify-ok? (opt-verify-function ssa))) 9]
      [(not (> (opt-count-phi-blocks ssa-blocks) 0)) 10]
      [(opt-block-list-has-label? optimized-blocks "loop") 11]
      [(not (opt-cfg-successor-targets-known? optimized-blocks)) 12]
      [(not
          (opt-block-list-eq
            (opt-loop-rotation-blocks no-preheader)
            no-preheader))
        13]
      [(not
          (opt-block-list-eq
            (opt-loop-rotation-blocks multi-backedge)
            multi-backedge))
        14]
      [(not (opt-block-list-eq (opt-loop-rotation-blocks with-phi) with-phi))
        15]
      [else 42])))

(define (compiler-optimize-ssa-self-test) : i64
  (let
    [diamond-blocks : CompilerIrBlockList (opt-ssa-diamond-blocks)]
    [diamond-index : OptCfgIndex (opt-cfg-index-build diamond-blocks)]
    [diamond-doms : OptDomInfo (opt-cfg-dominators diamond-blocks)]
    [then-frontier : OptLabelSet
      (opt-cfg-dominance-frontier diamond-blocks "then")]
    [else-frontier : OptLabelSet
      (opt-cfg-dominance-frontier diamond-blocks "else")]
    [loop-blocks : CompilerIrBlockList (opt-ssa-loop-blocks)]
    [loop-index : OptCfgIndex (opt-cfg-index-build loop-blocks)]
    [loop-doms : OptDomInfo (opt-cfg-dominators loop-blocks)]
    [loop-frontier : OptLabelSet
      (opt-cfg-dominance-frontier loop-blocks "loop")]
    [unreachable-index : OptCfgIndex
      (opt-cfg-index-build (opt-ssa-unreachable-blocks))]
    [unreachable-order : CompilerIrBlockList
      (opt-cfg-reachable-block-order (opt-ssa-unreachable-blocks))]
    [constructed-diamond : CompilerIrFunction
      (opt-ssa-construct-function (opt-ssa-construct-diamond-function))]
    [constructed-diamond-blocks : CompilerIrBlockList
      (opt-function-blocks constructed-diamond)]
    [constructed-loop : CompilerIrFunction
      (opt-ssa-construct-function (opt-ssa-construct-loop-function))]
    [constructed-loop-blocks : CompilerIrBlockList
      (opt-function-blocks constructed-loop)]
    [constructed-param : CompilerIrFunction
      (opt-ssa-construct-function (opt-ssa-construct-mutated-param-function))]
    [constructed-param-blocks : CompilerIrBlockList
      (opt-function-blocks constructed-param)]
    [address-taken : CompilerIrFunction
      (opt-ssa-construct-address-taken-function)]
    [address-taken-out : CompilerIrFunction
      (opt-ssa-construct-function address-taken)]
    [existing-phi : CompilerIrFunction
      (opt-cfg-test-function (opt-cfg-phi-blocks))]
    [existing-phi-out : CompilerIrFunction
      (opt-ssa-construct-function existing-phi)]
    [pipeline-loop : CompilerIrFunction
      (optimize-function-once (opt-ssa-construct-loop-function))]
    [pipeline-loop-blocks : CompilerIrBlockList
      (opt-function-blocks pipeline-loop)]
    [entry-backedge : CompilerIrFunction (opt-ssa-entry-backedge-function)]
    [entry-backedge-out : CompilerIrFunction
      (opt-ssa-construct-function (opt-ssa-entry-backedge-function))]
    (cond
      [(not
          (= (opt-label-count (opt-cfg-predecessors diamond-blocks "join")) 2))
        1]
      [(not (= (opt-cfg-index-block-count diamond-index) 4)) 2]
      [(not (opt-verify-ok? (opt-verify-function (opt-ssa-diamond-function))))
        3]
      [(not
          (opt-label-set-eq?
            (opt-cfg-index-predecessors diamond-index "join")
            (opt-cfg-predecessors-scan diamond-blocks "join")))
        4]
      [(not
          (opt-label-set-eq?
            (opt-cfg-index-successors diamond-index "entry")
            (opt-cfg-blocks-successors-scan diamond-blocks "entry")))
        5]
      [(not (= (struct-get unreachable-index reach-count) 1)) 6]
      [(not (opt-cfg-index-reachable? unreachable-index "entry")) 7]
      [(opt-cfg-index-reachable? unreachable-index "dead") 8]
      [(not (string-eq (opt-cfg-index-rpo-label unreachable-index 0) "entry"))
        9]
      [(not (string-eq (opt-cfg-index-rpo-label loop-index 0) "entry")) 10]
      [(not (opt-dom-dominates? diamond-doms "entry" "join")) 11]
      [(opt-dom-dominates? diamond-doms "then" "join") 12]
      [(not (opt-label-contains then-frontier "join")) 13]
      [(not (opt-label-contains else-frontier "join")) 14]
      [(not (opt-dom-dominates? loop-doms "loop" "body")) 15]
      [(not (opt-label-contains loop-frontier "loop")) 16]
      [(not (= (compiler-ir-block-list-count unreachable-order) 1)) 17]
      [(not (opt-block-list-has-label? unreachable-order "entry")) 18]
      [(not (opt-verify-ok? (opt-verify-function (opt-ssa-loop-function)))) 19]
      [(not
          (opt-verify-ok? (opt-verify-function (opt-ssa-unreachable-function))))
        20]
      [(not
          (opt-verify-error-ok?
            (opt-verify-function (opt-ssa-duplicate-label-function))
            "optimizer verify: duplicate block label"))
        21]
      [(not
          (opt-verify-error-ok?
            (opt-verify-function (opt-ssa-unknown-successor-function))
            "optimizer verify: unknown successor label"))
        22]
      [(not
          (opt-verify-error-ok?
            (opt-verify-function (opt-ssa-bad-phi-function))
            "optimizer verify: phi predecessor mismatch"))
        23]
      [(not
          (opt-verify-error-ok?
            (opt-verify-function (opt-ssa-duplicate-def-function))
            "optimizer verify: duplicate var definition"))
        24]
      [(not
          (opt-verify-error-ok?
            (opt-verify-function (opt-ssa-use-before-def-function))
            "optimizer verify: use before definition"))
        25]
      [(not
          (opt-verify-error-ok?
            (opt-verify-function (opt-ssa-dominance-fail-function))
            "optimizer verify: use is not dominated by definition"))
        26]
      [(not
          (=
            (opt-cfg-index-rpo-num
              loop-index
              (opt-cfg-index-rpo-id loop-index 0))
            0))
        27]
      [(not (opt-cfg-dominators-match-legacy? diamond-blocks)) 28]
      [(not (opt-cfg-dominators-match-legacy? loop-blocks)) 29]
      [(not (opt-cfg-dominators-match-legacy? (opt-ssa-unreachable-blocks))) 30]
      [(not
          (opt-cfg-dominators-match-legacy?
            (opt-natural-loop-irreducible-blocks)))
        31]
      [(not (opt-cfg-dominators-match-bitset? diamond-blocks)) 32]
      [(not (opt-cfg-dominators-match-bitset? loop-blocks)) 33]
      [(not (opt-cfg-dominators-match-bitset? (opt-ssa-unreachable-blocks))) 34]
      [(not
          (opt-cfg-dominators-match-bitset?
            (opt-natural-loop-irreducible-blocks)))
        35]
      [(not (opt-verify-ok? (opt-verify-function constructed-diamond))) 36]
      [(not (= (opt-count-phi-blocks constructed-diamond-blocks) 1)) 37]
      [(not (= (opt-count-mov-dst-blocks constructed-diamond-blocks 1) 0)) 38]
      [(not (opt-verify-ok? (opt-verify-function constructed-loop))) 39]
      [(not (= (opt-count-phi-blocks constructed-loop-blocks) 1)) 40]
      [(not (= (opt-count-mov-dst-blocks constructed-loop-blocks 1) 0)) 41]
      [(not (opt-verify-ok? (opt-verify-function constructed-param))) 46]
      [(not (= (opt-count-phi-blocks constructed-param-blocks) 1)) 47]
      [(not (= (opt-count-mov-dst-blocks constructed-param-blocks 0) 0)) 48]
      [(not (opt-function-eq address-taken address-taken-out)) 49]
      [(not (opt-function-eq existing-phi existing-phi-out)) 50]
      [(not (opt-verify-ok? (opt-verify-function pipeline-loop))) 51]
      [(not (= (opt-count-mov-dst-blocks pipeline-loop-blocks 1) 0)) 52]
      [(not (opt-function-eq entry-backedge entry-backedge-out)) 53]
      [else 42])))

(define (compiler-optimize-cfg-self-test) : i64
  (let
    [constant-if : CompilerIrBlockList
      (opt-cfg-simplify-blocks (opt-cfg-constant-if-blocks))]
    [loop-guard : CompilerIrBlockList
      (opt-cfg-simplify-blocks (opt-cfg-loop-guard-blocks))]
    [phi-cfg : CompilerIrBlockList
      (opt-cfg-simplify-blocks (opt-cfg-phi-blocks))]
    [phi-blocks : CompilerIrBlockList
      (opt-function-blocks
        (optimize-function (opt-cfg-test-function (opt-cfg-phi-blocks))))]
    [trap-blocks : CompilerIrBlockList
      (opt-function-blocks
        (optimize-function (opt-cfg-test-function (opt-cfg-trap-path-blocks))))]
    [fallthrough-blocks : CompilerIrBlockList
      (opt-cfg-simplify-blocks (opt-cfg-fallthrough-prune-blocks))]
    (begin
      (unless (= (compiler-ir-block-list-count constant-if) 2) (return 1))
      (unless (not (opt-block-list-has-label? constant-if "else")) (return 2))
      (unless (= (opt-count-jump-to-blocks constant-if "then") 1) (return 3))
      (unless (= (opt-count-branches-blocks constant-if) 0) (return 4))
      (unless (= (compiler-ir-block-list-count loop-guard) 3) (return 5))
      (unless (not (opt-block-list-has-label? loop-guard "body")) (return 6))
      (unless (= (opt-count-jump-to-blocks loop-guard "exit") 1) (return 7))
      (unless (= (compiler-ir-block-list-count phi-blocks) 3) (return 8))
      (unless (not (opt-block-list-has-label? phi-blocks "else")) (return 9))
      (unless (= (opt-count-phi-blocks phi-blocks) 0) (return 10))
      (unless (= (opt-count-mov-dst-blocks phi-cfg 3) 1) (return 11))
      (unless (= (compiler-ir-block-list-count trap-blocks) 3) (return 12))
      (unless (opt-block-list-has-label? trap-blocks "trap") (return 13))
      (unless (= (opt-count-branches-blocks trap-blocks) 1) (return 14))
      (unless (opt-cfg-fallthrough-prune-ok? fallthrough-blocks) (return 15))
      42)))

(define (compiler-optimize-fixed-point-self-test) : i64
  (let
    [func : CompilerIrFunction (opt-test-function (opt-fixed-point-instrs))]
    [once : CompilerIrFunction (optimize-function-once func)]
    [fixed : CompilerIrFunction (optimize-function func)]
    [once-instrs : CompilerIrInstrList (opt-function-first-instrs once)]
    [fixed-instrs : CompilerIrInstrList (opt-function-first-instrs fixed)]
    [optimized-program : CompilerIrProgram
      (optimize-program-with-level
        (opt-test-program (opt-fixed-point-instrs))
        3)]
    [again-program : CompilerIrProgram
      (optimize-program-with-level optimized-program 3)]
    (cond
      [(not (= (compiler-ir-instr-list-count once-instrs) 4)) 1]
      [(not (= (opt-count-arith-instrs once-instrs) 3)) 2]
      [(not (= (compiler-ir-instr-list-count fixed-instrs) 3)) 3]
      [(not (= (opt-count-arith-instrs fixed-instrs) 2)) 4]
      [(not (opt-program-eq optimized-program again-program)) 5]
      [else 42])))

;; --- noalias / alias fact model (#1510) -------------------------------------
;;
;; Optimizer-internal alias facts for IR temporaries. This section models facts
;; and conservative invalidation, proves the conservatism with self-tests, and
;; feeds the first local redundant-load CSE consumer (#2342). Later issues derive
;; richer facts from
;; borrow/move analysis (#1048/#1049/#1050/#806) and consume them in load/store,
;; bounds-check, scalar-replacement, and loop passes.
;;
;; A fact binds an IR temporary (var id) to one of four deliberately
;; conservative kinds:
;;   - Unique       : a freshly allocated root no other tracked pointer aliases
;;   - Derived base : a pointer derived from root/base var `base` by safe
;;                    pointer arithmetic (Gep); it aliases only that root's
;;                    allocation
;;   - MayAlias     : unknown provenance; may alias anything tracked
;;   - Invalidated  : a previously known fact a memory effect explicitly cleared
;;
;; Invalidation keys off `compiler-ir-instr-effect`: pure instructions keep the
;; surrounding facts (and (re)bind only their destination), memory reads keep
;; facts (the loaded value itself is MayAlias), and any instruction that can
;; mutate or unknown-observe memory (stores, vector/predicated stores, direct
;; and indirect calls, tail calls) conservatively clears ALL facts rather than
;; assuming C-style noalias. Control-flow joins intersect the per-edge sets.
(defenum OptAliasKind
  (OptAliasUnique)
  (OptAliasDerived i64)
  (OptAliasMayAlias)
  (OptAliasInvalidated))

;; Alias facts live in a mutable i64->i64 hashmap keyed by var id (#2614).
;; Kinds pack into the value: a Derived root is its non-negative root var id,
;; the kind-only variants take negative codes. State is threaded linearly
;; through a block (helpers mutate and return the same table); control-flow
;; joins and clears build a fresh table, so retained per-block exit states
;; are never aliased by a successor's mutations.
(defenum OptAliasFacts
  (OptAliasFacts I64I64Map))

(define (opt-alias-empty) : OptAliasFacts
  (OptAliasFacts (i64-i64-map-with-capacity 17)))

(define (opt-alias-kind-encode [kind : OptAliasKind]) : i64
  (match kind
    [(OptAliasUnique) -1]
    [(OptAliasMayAlias) -2]
    [(OptAliasInvalidated) -3]
    [(OptAliasDerived root) root]))

(define (opt-alias-kind-decode [value : i64]) : OptAliasKind
  (cond
    [(>= value 0) (OptAliasDerived value)]
    [(= value -1) (OptAliasUnique)]
    [(= value -2) (OptAliasMayAlias)]
    [else (OptAliasInvalidated)]))

(defenum OptMaybeAliasKind
  (OptNoAliasKind)
  (OptSomeAliasKind OptAliasKind))

(define (opt-alias-kind-eq [a : OptAliasKind] [b : OptAliasKind]) : bool
  (match a
    [(OptAliasUnique)
      (match b
        [(OptAliasUnique) true]
        [_ false])]
    [(OptAliasDerived ba)
      (match b
        [(OptAliasDerived bb) (= ba bb)]
        [_ false])]
    [(OptAliasMayAlias)
      (match b
        [(OptAliasMayAlias) true]
        [_ false])]
    [(OptAliasInvalidated)
      (match b
        [(OptAliasInvalidated) true]
        [_ false])]))

(define (opt-alias-lookup [facts : OptAliasFacts] [var : i64]) : OptMaybeAliasKind
  (match facts
    [(OptAliasFacts map)
      (match (i64-i64-map-get map var)
        [(I64I64MapFound value)
          (OptSomeAliasKind (opt-alias-kind-decode value))]
        [(I64I64MapMissing) (OptNoAliasKind)])]))

(define (opt-alias-bound? [facts : OptAliasFacts] [var : i64]) : bool
  (match facts
    [(OptAliasFacts map) (i64-i64-map-contains? map var)]))

(define (opt-alias-remove-var [facts : OptAliasFacts] [var : i64]) : OptAliasFacts
  (match facts
    [(OptAliasFacts map)
      (match (i64-i64-map-remove map var)
        [(I64I64MapRemoveOk updated) (OptAliasFacts updated)]
        [(I64I64MapRemoveMissing updated) (OptAliasFacts updated)])]))

(define (opt-alias-bind
  [facts : OptAliasFacts]
  [var : i64]
  [kind : OptAliasKind]) : OptAliasFacts
  (match facts
    [(OptAliasFacts map)
      (OptAliasFacts (i64-i64-map-put map var (opt-alias-kind-encode kind)))]))

(define (opt-alias-mark-unique [facts : OptAliasFacts] [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasUnique)))

(define (opt-alias-mark-may-alias [facts : OptAliasFacts] [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasMayAlias)))

(define (opt-alias-mark-invalidated [facts : OptAliasFacts] [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasInvalidated)))

;; Copy a value's fact onto `dst` (Mov/Cast of a tracked var). An untracked
;; source conservatively yields a MayAlias destination.
(define (opt-alias-copy-var [facts : OptAliasFacts] [dst : i64] [src : i64]) : OptAliasFacts
  (match (opt-alias-lookup facts src)
    [(OptSomeAliasKind kind) (opt-alias-bind facts dst kind)]
    [(OptNoAliasKind) (opt-alias-mark-may-alias facts dst)]))

;; Derive `dst` through safe pointer arithmetic (Gep) from base var `base`.
;; A unique or already-derived base propagates the underlying root; anything
;; else is conservatively MayAlias.
(define (opt-alias-derive-var [facts : OptAliasFacts] [dst : i64] [base : i64]) : OptAliasFacts
  (match (opt-alias-lookup facts base)
    [(OptSomeAliasKind kind)
      (match kind
        [(OptAliasUnique) (opt-alias-bind facts dst (OptAliasDerived base))]
        [(OptAliasDerived root)
          (opt-alias-bind facts dst (OptAliasDerived root))]
        [(OptAliasMayAlias) (opt-alias-mark-may-alias facts dst)]
        [(OptAliasInvalidated) (opt-alias-mark-may-alias facts dst)])]
    [(OptNoAliasKind) (opt-alias-mark-may-alias facts dst)]))

(define (opt-alias-contains?
  [facts : OptAliasFacts]
  [var : i64]
  [kind : OptAliasKind]) : bool
  (match (opt-alias-lookup facts var)
    [(OptSomeAliasKind found) (opt-alias-kind-eq found kind)]
    [(OptNoAliasKind) false]))

(define (opt-alias-absent? [facts : OptAliasFacts] [var : i64]) : bool
  (match (opt-alias-lookup facts var)
    [(OptNoAliasKind) true]
    [(OptSomeAliasKind _) false]))

;; Conservative control-flow join: keep only facts that appear with an
;; identical kind on both incoming edges.
(define (opt-alias-intersect [a : OptAliasFacts] [b : OptAliasFacts]) : OptAliasFacts
  (match a
    [(OptAliasFacts amap)
      (match b
        [(OptAliasFacts bmap)
          (let
            [out : OptAliasFacts (opt-alias-empty)]
            [capacity : i64 (i64-i64-map-capacity amap)]
            [i : i64 (i64-i64-map-next-occupied amap 0)]
            (begin
              (while (< i capacity)
                (begin
                  (match (i64-i64-map-entry-at amap i)
                    [(I64I64MapEntrySome var value)
                      (match (i64-i64-map-get bmap var)
                        [(I64I64MapFound bvalue)
                          (if (= value bvalue)
                            (set!
                              out
                              (opt-alias-bind
                                out
                                var
                                (opt-alias-kind-decode value)))
                            unit)]
                        [(I64I64MapMissing) unit])]
                    [(I64I64MapEntryNone) unit])
                  (set! i (i64-i64-map-next-occupied amap (+ i 1)))))
              out))])]))

(define (opt-alias-facts-len [facts : OptAliasFacts]) : i64
  (match facts
    [(OptAliasFacts map) (i64-i64-map-len map)]))

;; Deep-copy the fact table. Per-block exit states are retained for every
;; successor's entry intersection, so a single-predecessor entry must not
;; alias (and then mutate) its predecessor's stored exit state.
(define (opt-alias-clone [facts : OptAliasFacts]) : OptAliasFacts
  (match facts
    [(OptAliasFacts map)
      (let
        [out : I64I64Map
          (i64-i64-map-with-capacity (+ (* (i64-i64-map-len map) 2) 17))]
        [capacity : i64 (i64-i64-map-capacity map)]
        [i : i64 (i64-i64-map-next-occupied map 0)]
        (begin
          (while (< i capacity)
            (begin
              (match (i64-i64-map-entry-at map i)
                [(I64I64MapEntrySome var value)
                  (set! out (i64-i64-map-put out var value))]
                [(I64I64MapEntryNone) unit])
              (set! i (i64-i64-map-next-occupied map (+ i 1)))))
          (OptAliasFacts out)))]))

;; A memory effect that can mutate or unknown-observe memory clears all facts.
;; `Alloc` is the one MemoryWrite that instead binds a fresh unique root, so it
;; is excluded by the caller below.
(define (opt-alias-effect-clears-facts? [effect : CompilerIrEffect]) : bool
  (match effect
    [(IrEffectPure) false]
    [(IrEffectMemoryRead) false]
    [(IrEffectCpuProbe) true]
    [(IrEffectMemoryWrite) true]
    [(IrEffectControlFlow) false]
    [(IrEffectUnknown) true]))

;; True when the instruction conservatively clears ALL alias facts. The
;; call family is listed explicitly because a tail call carries a control-flow
;; IR effect yet still mutates memory; `Alloc` is excluded because it binds a
;; unique root instead of clearing.
(define (opt-alias-instr-clears-all? [instr : CompilerIrInstr]) : bool
  (match instr
    [(IrInstrAlloc _ _) false]
    [(IrInstrCall _ _ _ _) true]
    [(IrInstrCallIndirect _ _ _ _) true]
    [(IrInstrCallIndirectC _ _ _ _) true]
    [(IrInstrCallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload _ _ _ _) true])]
    [(IrInstrCallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload _ _ _ _) true])]
    [(IrInstrTailCall _ _ _) true]
    [(IrInstrTailCallIndirect _ _ _) true]
    [_ (opt-alias-effect-clears-facts? (compiler-ir-instr-effect instr))]))

(define (opt-alias-update-gep
  [facts : OptAliasFacts]
  [dst : i64]
  [base : CompilerIrValue]) : OptAliasFacts
  (match base
    [(IrValueVar base-var) (opt-alias-derive-var facts dst base-var)]
    [_ (opt-alias-mark-may-alias facts dst)]))

(define (opt-alias-update-copy
  [facts : OptAliasFacts]
  [dst : i64]
  [value : CompilerIrValue]) : OptAliasFacts
  (match value
    [(IrValueVar src) (opt-alias-copy-var facts dst src)]
    [_ (opt-alias-mark-may-alias facts dst)]))

;; Transfer function for one instruction. Memory-mutating/unknown instructions
;; clear all facts; otherwise pure value-producers (re)bind only their
;; destination and the surrounding facts survive.
(define (opt-alias-update-facts
  [facts : OptAliasFacts]
  [instr : CompilerIrInstr]) : OptAliasFacts
  (if (opt-alias-instr-clears-all? instr)
    (opt-alias-empty)
    (match instr
      [(IrInstrAlloc dst _) (opt-alias-mark-unique facts dst)]
      [(IrInstrGep dst base _ _) (opt-alias-update-gep facts dst base)]
      [(IrInstrMov dst value _) (opt-alias-update-copy facts dst value)]
      [(IrInstrCast dst value _ _) (opt-alias-update-copy facts dst value)]
      [(IrInstrBitcast dst value _ _) (opt-alias-update-copy facts dst value)]
      [(IrInstrLoad dst _ _) (opt-alias-mark-may-alias facts dst)]
      [(IrInstrEntryArgc dst) (opt-alias-remove-var facts dst)]
      [(IrInstrEntryArgv dst) (opt-alias-mark-may-alias facts dst)]
      [(IrInstrEntryEnvp dst) (opt-alias-mark-may-alias facts dst)]
      [(IrInstrAddrOf dst _) (opt-alias-mark-may-alias facts dst)]
      [(IrInstrVectorLoad dst _ _ _ _) (opt-alias-mark-may-alias facts dst)]
      [(IrInstrPredicatedLoad payload-box)
        (match (box-get payload-box)
          [(CompilerIrInstrPredicatedLoadPayload dst _ _ _ _ _)
            (opt-alias-mark-may-alias facts dst)])]
      [_ facts])))

(define (opt-alias-run [facts : OptAliasFacts] [instrs : CompilerIrInstrList]) : OptAliasFacts
  (match instrs
    [(IrInstrNil) facts]
    [(IrInstrCons instr rest)
      (opt-alias-run (opt-alias-update-facts facts instr) (box-get rest))]))

;; --- implicit scratch-region candidate report (#2742) -----------------------
;;
;; Report-only analysis for future automatic scratch regions. It recognizes
;; direct `tl_alloc` roots, tracks simple candidate-derived pointers with the
;; optimizer alias fact model, and records the first conservative blocker for a
;; function/block/loop scope. The result never rewrites IR; compile-profile
;; builds only emit deterministic detail rows to stderr.
(defenum OptScratchRootList
  (OptScratchRootNil)
  (OptScratchRootCons i64 (Box OptScratchRootList)))

(defenum OptScratchBlockerReason
  (OptScratchNoBlocker)
  (OptScratchBlocked String))

(defenum OptScratchAlloc
  (OptScratchNoAlloc)
  (OptScratchAlloc i64 i64))

(defenum OptScratchScopeState
  (OptScratchScopeState
    i64
    i64
    OptScratchRootList
    OptAliasFacts
    OptScratchBlockerReason))

(defenum OptScratchScopeReport
  (OptScratchScopeReport i64 i64 OptScratchBlockerReason))

(define (opt-scratch-root-list-contains?
  [roots : OptScratchRootList]
  [root : i64]) : bool
  (match roots
    [(OptScratchRootNil) false]
    [(OptScratchRootCons found rest)
      (or (= found root) (opt-scratch-root-list-contains? (box-get rest) root))]))

(define (opt-scratch-root-list-add [roots : OptScratchRootList] [root : i64]) : OptScratchRootList
  (if (opt-scratch-root-list-contains? roots root)
    roots
    (OptScratchRootCons root (box roots))))

(define (opt-scratch-direct-alloc [instr : CompilerIrInstr]) : OptScratchAlloc
  (match instr
    [(IrInstrCall dst name args _)
      (if (string-eq name "tl_alloc")
        (match (opt-aggregate-tl-alloc-size args)
          [(OptSomeI64 size)
            (OptScratchAlloc
              dst
              (if (> size 0)
                size
                0))]
          [(OptNoI64) (OptScratchAlloc dst 0)])
        (OptScratchNoAlloc))]
    [_ (OptScratchNoAlloc)]))

(define (opt-scratch-arena-helper-call? [name : String]) : bool
  (or
    (string-eq name "arena-current")
    (string-eq name "arena-mark")
    (string-eq name "arena-set!")
    (string-eq name "arena-rewind")
    (string-eq name "arena-destroy")
    (string-eq name "tl_region_mark")
    (string-eq name "tl_region_reset")
    (string-eq name "tl_arena_make")
    (string-eq name "tl_arena_current")
    (string-eq name "tl_arena_set")
    (string-eq name "tl_arena_destroy")
    (string-eq name "tl_arena_poison_enable")))

(define (opt-scratch-var-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [var : i64]) : bool
  (match (opt-alias-lookup facts var)
    [(OptSomeAliasKind kind)
      (match kind
        [(OptAliasUnique) (opt-scratch-root-list-contains? roots var)]
        [(OptAliasDerived root) (opt-scratch-root-list-contains? roots root)]
        [(OptAliasMayAlias) false]
        [(OptAliasInvalidated) false])]
    [(OptNoAliasKind) false]))

(define (opt-scratch-value-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [value : CompilerIrValue]) : bool
  (match value
    [(IrValueVar var) (opt-scratch-var-derived? roots facts var)]
    [_ false]))

(define (opt-scratch-maybe-value-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [maybe : CompilerIrMaybeValue]) : bool
  (match maybe
    [(IrNoValue) false]
    [(IrSomeValue value) (opt-scratch-value-derived? roots facts value)]))

(define (opt-scratch-value-list-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [values : CompilerIrValueList]) : bool
  (match values
    [(IrValueNil) false]
    [(IrValueCons value rest)
      (or
        (opt-scratch-value-derived? roots facts value)
        (opt-scratch-value-list-derived? roots facts (box-get rest)))]))

(define (opt-scratch-call-args-array-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [values : (Array CompilerIrValue)]
  [index : i64]) : bool
  (if (>= index (array-length values))
    false
    (or
      (opt-scratch-value-derived? roots facts (array-ref values index))
      (opt-scratch-call-args-array-derived? roots facts values (+ index 1)))))

(define (opt-scratch-call-args-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [args : CompilerIrCallArgs]) : bool
  (match args
    [(IrCallArgsNil) false]
    [(IrCallArgsOne value) (opt-scratch-value-derived? roots facts value)]
    [(IrCallArgsTwo a b)
      (or
        (opt-scratch-value-derived? roots facts a)
        (opt-scratch-value-derived? roots facts b))]
    [(IrCallArgsArray values)
      (opt-scratch-call-args-array-derived? roots facts values 0)]))

(define (opt-scratch-blocker-none? [blocker : OptScratchBlockerReason]) : bool
  (match blocker
    [(OptScratchNoBlocker) true]
    [(OptScratchBlocked _) false]))

(define (opt-scratch-blocker-reason
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [instr : CompilerIrInstr]) : OptScratchBlockerReason
  (match (opt-scratch-direct-alloc instr)
    [(OptScratchAlloc _ _) (OptScratchNoBlocker)]
    [(OptScratchNoAlloc)
      (match instr
        [(IrInstrCall _ name _ _)
          (if (opt-scratch-arena-helper-call? name)
            (OptScratchBlocked "arena_helper")
            (OptScratchBlocked "call"))]
        [(IrInstrCallIndirect _ _ _ _) (OptScratchBlocked "call")]
        [(IrInstrCallIndirectC _ _ _ _) (OptScratchBlocked "extern_call")]
        [(IrInstrCallCAbiStoreResult payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrCallCAbiStoreResultPayload _ _ _ _)
              (OptScratchBlocked "extern_call")])]
        [(IrInstrCallIndirectCAbiStoreResult payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrCallIndirectCAbiStoreResultPayload _ _ _ _)
              (OptScratchBlocked "extern_call")])]
        [(IrInstrSyscall _ _) (OptScratchBlocked "extern_call")]
        [(IrInstrTailCall _ _ _) (OptScratchBlocked "tail_call")]
        [(IrInstrTailCallIndirect _ _ _) (OptScratchBlocked "tail_call")]
        [(IrInstrAddrOf _ _) (OptScratchBlocked "raw_pointer")]
        [(IrInstrGep _ base offset _)
          (if (opt-scratch-value-derived? roots facts offset)
            (OptScratchBlocked "raw_pointer")
            (if (opt-scratch-value-derived? roots facts base)
              (match offset
                [(IrValueI64 _) (OptScratchNoBlocker)]
                [_ (OptScratchBlocked "raw_pointer")])
              (OptScratchNoBlocker)))]
        [(IrInstrCast _ src _ _)
          (if (opt-scratch-value-derived? roots facts src)
            (OptScratchBlocked "raw_pointer")
            (OptScratchNoBlocker))]
        [(IrInstrBitcast _ src _ _)
          (if (opt-scratch-value-derived? roots facts src)
            (OptScratchBlocked "raw_pointer")
            (OptScratchNoBlocker))]
        [(IrInstrStorePtr ptr value _)
          (if (and
            (opt-scratch-value-derived? roots facts value)
            (not (opt-scratch-value-derived? roots facts ptr)))
            (OptScratchBlocked "store_outer")
            (OptScratchNoBlocker))]
        [(IrInstrStore _ value _)
          (if (opt-scratch-value-derived? roots facts value)
            (OptScratchBlocked "store_outer")
            (OptScratchNoBlocker))]
        [(IrInstrCopyBytes dst src _)
          (if (and
            (opt-scratch-value-derived? roots facts src)
            (not (opt-scratch-value-derived? roots facts dst)))
            (OptScratchBlocked "store_outer")
            (if (or
              (opt-scratch-value-derived? roots facts dst)
              (opt-scratch-value-derived? roots facts src))
              (OptScratchBlocked "raw_pointer")
              (OptScratchNoBlocker)))]
        [(IrInstrVectorStore payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrVectorStorePayload base index value _ _)
              (if (and
                (opt-scratch-value-derived? roots facts value)
                (not (opt-scratch-value-derived? roots facts base)))
                (OptScratchBlocked "store_outer")
                (if (or
                  (opt-scratch-value-derived? roots facts base)
                  (opt-scratch-value-derived? roots facts index)
                  (opt-scratch-value-derived? roots facts value))
                  (OptScratchBlocked "raw_pointer")
                  (OptScratchNoBlocker)))])]
        [(IrInstrPredicatedStore payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrPredicatedStorePayload base index value mask _ _)
              (if (and
                (opt-scratch-value-derived? roots facts value)
                (not (opt-scratch-value-derived? roots facts base)))
                (OptScratchBlocked "store_outer")
                (if (or
                  (opt-scratch-value-derived? roots facts base)
                  (opt-scratch-value-derived? roots facts index)
                  (opt-scratch-value-derived? roots facts value)
                  (opt-scratch-value-derived? roots facts mask))
                  (OptScratchBlocked "raw_pointer")
                  (OptScratchNoBlocker)))])]
        [(IrInstrVectorLoad _ base index _ _)
          (if (or
            (opt-scratch-value-derived? roots facts base)
            (opt-scratch-value-derived? roots facts index))
            (OptScratchBlocked "raw_pointer")
            (OptScratchNoBlocker))]
        [(IrInstrPredicatedLoad payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrPredicatedLoadPayload _ base index mask _ _)
              (if (or
                (opt-scratch-value-derived? roots facts base)
                (opt-scratch-value-derived? roots facts index)
                (opt-scratch-value-derived? roots facts mask))
                (OptScratchBlocked "raw_pointer")
                (OptScratchNoBlocker))])]
        [(IrInstrReturn maybe)
          (if (opt-scratch-maybe-value-derived? roots facts maybe)
            (OptScratchBlocked "return_escape")
            (OptScratchNoBlocker))]
        [(IrInstrPack _ values _)
          (if (opt-scratch-value-list-derived? roots facts values)
            (OptScratchBlocked "return_escape")
            (OptScratchNoBlocker))]
        [(IrInstrBranch cond _ _)
          (if (opt-scratch-value-derived? roots facts cond)
            (OptScratchBlocked "raw_pointer")
            (OptScratchNoBlocker))]
        [(IrInstrBoundsCheck index length _)
          (if (or
            (opt-scratch-value-derived? roots facts index)
            (opt-scratch-value-derived? roots facts length))
            (OptScratchBlocked "raw_pointer")
            (OptScratchNoBlocker))]
        [_ (OptScratchNoBlocker)])]))

(define (opt-scratch-state-with-blocker
  [state : OptScratchScopeState]
  [candidate : OptScratchBlockerReason]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState allocs bytes roots facts blocker)
      (if (opt-scratch-blocker-none? blocker)
        (match candidate
          [(OptScratchNoBlocker) state]
          [(OptScratchBlocked _)
            (OptScratchScopeState allocs bytes roots facts candidate)])
        state)]))

(define (opt-scratch-state-record-alloc
  [state : OptScratchScopeState]
  [dst : i64]
  [bytes : i64]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState alloc-count known-bytes roots facts blocker)
      (OptScratchScopeState
        (+ alloc-count 1)
        (+ known-bytes bytes)
        (opt-scratch-root-list-add roots dst)
        (opt-alias-mark-unique facts dst)
        blocker)]))

(define (opt-scratch-state-facts
  [state : OptScratchScopeState]
  [facts : OptAliasFacts]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState allocs bytes roots _ blocker)
      (OptScratchScopeState allocs bytes roots facts blocker)]))

(define (opt-scratch-storeptr-keeps-facts?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [ptr : CompilerIrValue]
  [value : CompilerIrValue]) : bool
  (and
    (opt-scratch-value-derived? roots facts ptr)
    (not (opt-scratch-value-derived? roots facts value))))

(define (opt-scratch-update-nonalloc-facts
  [state : OptScratchScopeState]
  [instr : CompilerIrInstr]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState _ _ roots facts _)
      (opt-scratch-state-facts
        state
        (match instr
          [(IrInstrStorePtr ptr value _)
            (if (opt-scratch-storeptr-keeps-facts? roots facts ptr value)
              facts
              (opt-alias-update-facts facts instr))]
          [(IrInstrStore _ value _)
            (if (opt-scratch-value-derived? roots facts value)
              (opt-alias-update-facts facts instr)
              facts)]
          [_ (opt-alias-update-facts facts instr)]))]))

(define (opt-scratch-state-step
  [state : OptScratchScopeState]
  [instr : CompilerIrInstr]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState _ _ roots facts _)
      (let
        [blocked : OptScratchScopeState
          (opt-scratch-state-with-blocker
            state
            (opt-scratch-blocker-reason roots facts instr))]
        (match (opt-scratch-direct-alloc instr)
          [(OptScratchAlloc dst bytes)
            (opt-scratch-state-record-alloc blocked dst bytes)]
          [(OptScratchNoAlloc)
            (opt-scratch-update-nonalloc-facts blocked instr)]))]))

(define (opt-scratch-state-initial) : OptScratchScopeState
  (OptScratchScopeState
    0
    0
    (OptScratchRootNil)
    (opt-alias-empty)
    (OptScratchNoBlocker)))

(define (opt-scratch-scope-report-from-state [state : OptScratchScopeState]) : OptScratchScopeReport
  (match state
    [(OptScratchScopeState allocs bytes _ _ blocker)
      (OptScratchScopeReport allocs bytes blocker)]))

(define (opt-scratch-scope-scan-instrs
  [state : OptScratchScopeState]
  [instrs : CompilerIrInstrList]) : OptScratchScopeState
  (match instrs
    [(IrInstrNil) state]
    [(IrInstrCons instr rest)
      (opt-scratch-scope-scan-instrs
        (opt-scratch-state-step state instr)
        (box-get rest))]))

(define (opt-scratch-scope-scan-instr-seq-from
  [state : OptScratchScopeState]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : OptScratchScopeState
  (if (>= index (compiler-ir-instr-seq-count instrs))
    state
    (opt-scratch-scope-scan-instr-seq-from
      (opt-scratch-state-step state (compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1))))

(define (opt-scratch-scope-scan-blocks
  [state : OptScratchScopeState]
  [blocks : CompilerIrBlockList]) : OptScratchScopeState
  (match blocks
    [(IrBlockNil) state]
    [(IrBlockCons block rest)
      (match block
        [(IrBlock _ instrs)
          (opt-scratch-scope-scan-blocks
            (opt-scratch-scope-scan-instr-seq-from state instrs 0)
            (box-get rest))])]
    [(IrBlockArray seq)
      (opt-scratch-scope-scan-blocks state (compiler-ir-block-seq-to-list seq))]))

(define (opt-scratch-scope-report-instrs [instrs : CompilerIrInstrList]) : OptScratchScopeReport
  (opt-scratch-scope-report-from-state
    (opt-scratch-scope-scan-instrs (opt-scratch-state-initial) instrs)))

(define (opt-scratch-scope-report-block [block : CompilerIrBlock]) : OptScratchScopeReport
  (match block
    [(IrBlock _ instrs)
      (opt-scratch-scope-report-from-state
        (opt-scratch-scope-scan-instr-seq-from
          (opt-scratch-state-initial)
          instrs
          0))]))

(define (opt-scratch-scope-report-blocks [blocks : CompilerIrBlockList]) : OptScratchScopeReport
  (opt-scratch-scope-report-from-state
    (opt-scratch-scope-scan-blocks (opt-scratch-state-initial) blocks)))

(define (opt-scratch-report-candidate?
  [report : OptScratchScopeReport]
  [expected-allocs : i64]
  [expected-bytes : i64]) : bool
  (match report
    [(OptScratchScopeReport allocs bytes blocker)
      (and
        (= allocs expected-allocs)
        (= bytes expected-bytes)
        (opt-scratch-blocker-none? blocker))]))

(define (opt-scratch-report-blocked?
  [report : OptScratchScopeReport]
  [expected-allocs : i64]
  [expected-bytes : i64]
  [reason : String]) : bool
  (match report
    [(OptScratchScopeReport allocs bytes blocker)
      (and
        (= allocs expected-allocs)
        (= bytes expected-bytes)
        (match blocker
          [(OptScratchBlocked found) (string-eq found reason)]
          [(OptScratchNoBlocker) false]))]))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-status
    [blocker : OptScratchBlockerReason]) : String
    (match blocker
      [(OptScratchNoBlocker) "candidate"]
      [(OptScratchBlocked _) "blocked"])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-reason
    [blocker : OptScratchBlockerReason]) : String
    (match blocker
      [(OptScratchNoBlocker) "none"]
      [(OptScratchBlocked reason) reason])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-line
    [status : String]
    [scope : String]
    [function : String]
    [label : String]
    [latch : String]
    [allocs : i64]
    [bytes : i64]
    [reason : String]) : String
    (str-cat
      "compile-profile-detail|scratch_region|"
      status
      "|scope="
      scope
      "|function="
      function
      "|label="
      label
      "|latch="
      latch
      "|allocs="
      (int->string allocs)
      "|known_bytes="
      (int->string bytes)
      "|blocker="
      reason
      "\n")))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-one
    [scope : String]
    [function : String]
    [label : String]
    [latch : String]
    [report : OptScratchScopeReport]) : unit
    (match report
      [(OptScratchScopeReport allocs bytes blocker)
        (if (> allocs 0)
          (print-error
            (compiler-opt-scratch-region-report-line
              (compiler-opt-scratch-region-report-status blocker)
              scope
              function
              label
              latch
              allocs
              bytes
              (compiler-opt-scratch-region-report-reason blocker)))
          unit)])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-blocks
    [function : String]
    [blocks : CompilerIrBlockList]) : unit
    (match blocks
      [(IrBlockNil) unit]
      [(IrBlockCons block rest)
        (begin
          (match block
            [(IrBlock label _)
              (compiler-opt-scratch-region-report-one
                "block"
                function
                label
                "-"
                (opt-scratch-scope-report-block block))])
          (compiler-opt-scratch-region-report-blocks function (box-get rest)))]
      [(IrBlockArray seq)
        (compiler-opt-scratch-region-report-blocks
          function
          (compiler-ir-block-seq-to-list seq))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-loops
    [function : String]
    [loops : OptNaturalLoopList]) : unit
    (match loops
      [(OptNaturalLoopNil) unit]
      [(OptNaturalLoopCons loop rest)
        (begin
          (compiler-opt-scratch-region-report-one
            "loop"
            function
            (opt-natural-loop-header loop)
            (opt-natural-loop-latch loop)
            (opt-scratch-scope-report-blocks
              (opt-natural-loop-body-blocks loop)))
          (compiler-opt-scratch-region-report-loops function (box-get rest)))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-function
    [func : CompilerIrFunction]) : unit
    (match func
      [(IrFunction name _ _ _ blocks)
        (begin
          (compiler-opt-scratch-region-report-one
            "function"
            name
            "-"
            "-"
            (opt-scratch-scope-report-blocks blocks))
          (compiler-opt-scratch-region-report-blocks name blocks)
          (compiler-opt-scratch-region-report-loops
            name
            (opt-cfg-natural-loops blocks)))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-function-escaping
    [func : CompilerIrFunction]
    [scratch : i64]) : unit
    (with-escape
      scratch
      (compiler-opt-scratch-region-report-function func)
      unit)))

(define (opt-scratch-test-alloc) : CompilerIrInstr
  (IrInstrCall 1 "tl_alloc" (IrCallArgsOne (IrValueI64 32)) (AstTyU64)))

(define (opt-scratch-test-return-zero) : CompilerIrInstr
  (IrInstrReturn (IrSomeValue (IrValueI64 0))))

(define (opt-scratch-test-one-block [middle : CompilerIrInstr]) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (opt-scratch-test-alloc)
    (compiler-ir-instr-cons
      middle
      (compiler-ir-instr-cons (opt-scratch-test-return-zero) IrInstrNil))))

(define (opt-scratch-positive-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (opt-scratch-test-alloc)
    (compiler-ir-instr-cons
      (IrInstrGep 2 (IrValueVar 1) (IrValueI64 0) (AstTyU64))
      (compiler-ir-instr-cons
        (IrInstrStorePtr (IrValueVar 2) (IrValueI64 7) (AstTyU64))
        (compiler-ir-instr-cons
          (IrInstrLoad 3 (IrValueVar 2) (AstTyU64))
          (compiler-ir-instr-cons (opt-scratch-test-return-zero) IrInstrNil))))))

(define (opt-scratch-returned-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (opt-scratch-test-alloc)
    (compiler-ir-instr-cons
      (IrInstrReturn (IrSomeValue (IrValueVar 1)))
      IrInstrNil)))

(define (opt-scratch-loop-candidate-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons (IrInstrJump "loop") IrInstrNil))
    (compiler-ir-block-cons
      (compiler-ir-block
        "loop"
        (compiler-ir-instr-cons
          (opt-scratch-test-alloc)
          (compiler-ir-instr-cons
            (IrInstrBranch (IrValueBool true) "body" "exit")
            IrInstrNil)))
      (compiler-ir-block-cons
        (compiler-ir-block
          "body"
          (compiler-ir-instr-cons (IrInstrJump "loop") IrInstrNil))
        (compiler-ir-block-cons
          (compiler-ir-block
            "exit"
            (compiler-ir-instr-cons (opt-scratch-test-return-zero) IrInstrNil))
          IrBlockNil)))))

(define (opt-scratch-loop-list-has-candidate? [loops : OptNaturalLoopList]) : bool
  (match loops
    [(OptNaturalLoopNil) false]
    [(OptNaturalLoopCons loop rest)
      (or
        (opt-scratch-report-candidate?
          (opt-scratch-scope-report-blocks (opt-natural-loop-body-blocks loop))
          1
          32)
        (opt-scratch-loop-list-has-candidate? (box-get rest)))]))

(define (compiler-optimize-scratch-region-self-test) : i64
  (let
    [positive : OptScratchScopeReport
      (opt-scratch-scope-report-instrs (opt-scratch-positive-instrs))]
    [loop-positive : bool
      (opt-scratch-loop-list-has-candidate?
        (opt-cfg-natural-loops (opt-scratch-loop-candidate-blocks)))]
    [call-blocked : OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (opt-scratch-test-one-block
          (IrInstrCall 9 "touch" (IrCallArgsNil) (AstTyUnit))))]
    [extern-blocked : OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (opt-scratch-test-one-block
          (IrInstrCallIndirectC
            9
            (IrValueFunction "ffi_touch")
            (IrCallArgsNil)
            (AstTyI64))))]
    [raw-blocked : OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (opt-scratch-test-one-block (IrInstrAddrOf 2 1)))]
    [store-blocked : OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (opt-scratch-test-one-block
          (IrInstrStorePtr (IrValueVar 99) (IrValueVar 1) (AstTyU64))))]
    [arena-blocked : OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (opt-scratch-test-one-block
          (IrInstrCall 9 "tl_region_mark" (IrCallArgsNil) (AstTyI64))))]
    [return-blocked : OptScratchScopeReport
      (opt-scratch-scope-report-instrs (opt-scratch-returned-instrs))]
    (cond
      [(not (opt-scratch-report-candidate? positive 1 32)) 1]
      [(not loop-positive) 2]
      [(not (opt-scratch-report-blocked? call-blocked 1 32 "call")) 3]
      [(not (opt-scratch-report-blocked? extern-blocked 1 32 "extern_call")) 4]
      [(not (opt-scratch-report-blocked? raw-blocked 1 32 "raw_pointer")) 5]
      [(not (opt-scratch-report-blocked? store-blocked 1 32 "store_outer")) 6]
      [(not (opt-scratch-report-blocked? arena-blocked 1 32 "arena_helper")) 7]
      [(not (opt-scratch-report-blocked? return-blocked 1 32 "return_escape"))
        8]
      [else 42])))

;; --- block-local redundant-load CSE (#2342) ---------------------------------
(defenum OptLoadKey
  (OptLoadKey CompilerIrValue AstType))

(defenum OptLoadEntry
  (OptLoadEntry OptLoadKey i64))

(defenum OptLoadTable
  (OptLoadNil)
  (OptLoadCons OptLoadEntry (Box OptLoadTable)))

(defenum OptLoadCseState
  (OptLoadCseState OptAliasFacts OptLoadTable))

(defenum OptLoadCseResult
  (OptLoadCseResult OptLoadCseState CompilerIrInstr))

(define (opt-load-key-eq [a : OptLoadKey] [b : OptLoadKey]) : bool
  (match a
    [(OptLoadKey av aty)
      (match b
        [(OptLoadKey bv bty) (and (opt-value-eq av bv) (opt-type-eq aty bty))])]))

(define (opt-load-key-uses-var? [key : OptLoadKey] [var : i64]) : bool
  (match key
    [(OptLoadKey value _) (opt-value-is-var? value var)]))

(define (opt-load-entry-key [entry : OptLoadEntry]) : OptLoadKey
  (match entry
    [(OptLoadEntry key _) key]))

(define (opt-load-entry-var [entry : OptLoadEntry]) : i64
  (match entry
    [(OptLoadEntry _ var) var]))

(define (opt-load-table-lookup [table : OptLoadTable] [key : OptLoadKey]) : OptMaybeI64
  (match table
    [(OptLoadNil) (OptNoI64)]
    [(OptLoadCons entry rest)
      (if (opt-load-key-eq (opt-load-entry-key entry) key)
        (OptSomeI64 (opt-load-entry-var entry))
        (opt-load-table-lookup (box-get rest) key))]))

(define (opt-load-table-remove-key-scan
  [table : OptLoadTable]
  [key : OptLoadKey]) : OptLoadTable
  (match table
    [(OptLoadNil) (OptLoadNil)]
    [(OptLoadCons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-remove-key-scan (box-get rest) key)]
        (if (opt-load-key-eq (opt-load-entry-key entry) key)
          tail
          (OptLoadCons entry (box tail))))]))

;; Removal of an absent key returns the table unchanged instead of re-boxing
;; the whole spine (see opt-alias-remove-var).
(define (opt-load-table-remove-key [table : OptLoadTable] [key : OptLoadKey]) : OptLoadTable
  (match (opt-load-table-lookup table key)
    [(OptSomeI64 _) (opt-load-table-remove-key-scan table key)]
    [(OptNoI64) table]))

(define (opt-load-table-bind
  [table : OptLoadTable]
  [key : OptLoadKey]
  [var : i64]) : OptLoadTable
  (OptLoadCons
    (OptLoadEntry key var)
    (box (opt-load-table-remove-key table key))))

(define (opt-load-table-mentions-var? [table : OptLoadTable] [var : i64]) : bool
  (match table
    [(OptLoadNil) false]
    [(OptLoadCons entry rest)
      (if (or
        (= (opt-load-entry-var entry) var)
        (opt-load-key-uses-var? (opt-load-entry-key entry) var))
        true
        (opt-load-table-mentions-var? (box-get rest) var))]))

(define (opt-load-table-invalidate-var-scan [table : OptLoadTable] [var : i64]) : OptLoadTable
  (match table
    [(OptLoadNil) (OptLoadNil)]
    [(OptLoadCons entry rest)
      (let
        [rest2 : OptLoadTable
          (opt-load-table-invalidate-var-scan (box-get rest) var)]
        (if (or
          (= (opt-load-entry-var entry) var)
          (opt-load-key-uses-var? (opt-load-entry-key entry) var))
          rest2
          (OptLoadCons entry (box rest2))))]))

;; Drop entries whose address expression references `var`, or whose cached load
;; result was `var`. The IR is not globally SSA, so any reused var id must make
;; old load facts disappear before the new instruction is processed. This runs
;; for every defining instruction, so the no-match case returns the table
;; unchanged instead of re-boxing the whole spine.
(define (opt-load-table-invalidate-var [table : OptLoadTable] [var : i64]) : OptLoadTable
  (if (opt-load-table-mentions-var? table var)
    (opt-load-table-invalidate-var-scan table var)
    table))

(define (opt-load-cse-state-invalidate-def
  [state : OptLoadCseState]
  [instr : CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState facts table)
      (match (opt-instr-def-var instr)
        [(OptSomeI64 dst)
          (OptLoadCseState facts (opt-load-table-invalidate-var table dst))]
        [(OptNoI64) state])]))

(define (opt-load-cse-state-update-facts
  [state : OptLoadCseState]
  [instr : CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState facts table)
      (OptLoadCseState (opt-alias-update-facts facts instr) table)]))

(define (opt-load-cse-state-clear-for-memory
  [state : OptLoadCseState]
  [instr : CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState facts _)
      (OptLoadCseState (opt-alias-update-facts facts instr) (OptLoadNil))]))

(define (opt-load-cse-record-load
  [state : OptLoadCseState]
  [key : OptLoadKey]
  [dst : i64]) : OptLoadCseState
  (match state
    [(OptLoadCseState facts table)
      (if (opt-load-key-uses-var? key dst)
        state
        (OptLoadCseState facts (opt-load-table-bind table key dst)))]))

(define (opt-load-cse-load
  [state : OptLoadCseState]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]
  [instr : CompilerIrInstr]) : OptLoadCseResult
  (let
    [invalidated : OptLoadCseState
      (opt-load-cse-state-invalidate-def state instr)]
    [key : OptLoadKey (OptLoadKey src ty)]
    (match invalidated
      [(OptLoadCseState _ table)
        (match (opt-load-table-lookup table key)
          [(OptSomeI64 earlier)
            (let
              [new-instr : CompilerIrInstr
                (IrInstrMov dst (IrValueVar earlier) ty)]
              [updated : OptLoadCseState
                (opt-load-cse-state-update-facts invalidated new-instr)]
              (OptLoadCseResult
                (opt-load-cse-record-load updated key dst)
                new-instr))]
          [(OptNoI64)
            (let
              [updated : OptLoadCseState
                (opt-load-cse-state-update-facts invalidated instr)]
              (OptLoadCseResult
                (opt-load-cse-record-load updated key dst)
                instr))])])))

(define (opt-load-cse-instr [state : OptLoadCseState] [instr : CompilerIrInstr]) : OptLoadCseResult
  (if (opt-alias-instr-clears-all? instr)
    (OptLoadCseResult (opt-load-cse-state-clear-for-memory state instr) instr)
    (match instr
      [(IrInstrLoad dst src ty) (opt-load-cse-load state dst src ty instr)]
      [_
        (OptLoadCseResult
          (opt-load-cse-state-update-facts
            (opt-load-cse-state-invalidate-def state instr)
            instr)
          instr)])))

(define (opt-load-cse-instrs
  [state : OptLoadCseState]
  [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (match instrs
    [(IrInstrNil) (IrInstrNil)]
    [(IrInstrCons instr rest)
      (match (opt-load-cse-instr state instr)
        [(OptLoadCseResult next-state new-instr)
          (compiler-ir-instr-cons
            new-instr
            (opt-load-cse-instrs next-state (box-get rest)))])]))

;; --- cross-block redundant-load GVN (#2343) ---------------------------------
(defenum OptMaybeLoadCseState
  (OptNoLoadCseState)
  (OptSomeLoadCseState OptLoadCseState))

(defenum OptLoadGvnBlockRewrite
  (OptLoadGvnBlockRewrite OptLoadCseState CompilerIrInstrList))

(define (opt-load-cse-empty-state) : OptLoadCseState
  (OptLoadCseState (opt-alias-empty) (OptLoadNil)))

;; The load table is a persistent list, but the alias facts are a mutable
;; table; entering a block through a single predecessor must process a copy.
(define (opt-load-cse-state-clone-facts [state : OptLoadCseState]) : OptLoadCseState
  (match state
    [(OptLoadCseState facts table)
      (OptLoadCseState (opt-alias-clone facts) table)]))

(define (opt-load-table-contains-entry?
  [table : OptLoadTable]
  [entry : OptLoadEntry]) : bool
  (match entry
    [(OptLoadEntry key var)
      (match (opt-load-table-lookup table key)
        [(OptSomeI64 found) (= found var)]
        [(OptNoI64) false])]))

(define (opt-load-table-intersect [a : OptLoadTable] [b : OptLoadTable]) : OptLoadTable
  (match a
    [(OptLoadNil) (OptLoadNil)]
    [(OptLoadCons entry rest)
      (let
        [tail : OptLoadTable (opt-load-table-intersect (box-get rest) b)]
        (if (opt-load-table-contains-entry? b entry)
          (OptLoadCons entry (box tail))
          tail))]))

(define (opt-load-cse-state-intersect
  [a : OptLoadCseState]
  [b : OptLoadCseState]) : OptLoadCseState
  (match a
    [(OptLoadCseState afacts atable)
      (match b
        [(OptLoadCseState bfacts btable)
          (OptLoadCseState
            (opt-alias-intersect afacts bfacts)
            (opt-load-table-intersect atable btable))])]))

(define (opt-load-state-array-fill-empty!
  [states : (Array OptMaybeLoadCseState)]
  [count : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! states i (OptNoLoadCseState))
          (set! i (+ i 1))))
      unit)))

(define (opt-load-gvn-entry-from-preds
  [index : OptCfgIndex]
  [exit-states : (Array OptMaybeLoadCseState)]
  [processed : (Array bool)]
  [edge : i64]
  [end : i64]
  [has-state : bool]
  [acc : OptLoadCseState]) : OptLoadCseState
  (if (>= edge end)
    acc
    (let
      [pred : i64 (array-ref (struct-get (struct-get index preds) edges) edge)]
      (if (not (array-ref (struct-get index reachable) pred))
        (opt-load-gvn-entry-from-preds
          index
          exit-states
          processed
          (+ edge 1)
          end
          has-state
          acc)
        (if (not (array-ref processed pred))
          (opt-load-cse-empty-state)
          (match (array-ref exit-states pred)
            [(OptSomeLoadCseState pred-state)
              (opt-load-gvn-entry-from-preds
                index
                exit-states
                processed
                (+ edge 1)
                end
                true
                (if has-state
                  (opt-load-cse-state-intersect acc pred-state)
                  (opt-load-cse-state-clone-facts pred-state)))]
            [(OptNoLoadCseState) (opt-load-cse-empty-state)]))))))

(define (opt-load-gvn-entry-state
  [context : OptCfgContext]
  [exit-states : (Array OptMaybeLoadCseState)]
  [processed : (Array bool)]
  [id : i64]) : OptLoadCseState
  (let
    [index : OptCfgIndex (struct-get context index)]
    [preds : OptCfgCsr (struct-get index preds)]
    [entry-label : String (struct-get context entry-label)]
    (match (opt-cfg-index-id index entry-label)
      [(OptSomeI64 entry-id)
        (if (= id entry-id)
          (opt-load-cse-empty-state)
          (opt-load-gvn-entry-from-preds
            index
            exit-states
            processed
            (array-ref (struct-get preds offsets) id)
            (array-ref (struct-get preds offsets) (+ id 1))
            false
            (opt-load-cse-empty-state)))]
      [(OptNoI64) (opt-load-cse-empty-state)])))

(define (opt-load-gvn-load
  [state : OptLoadCseState]
  [sources : I64I64Map]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]
  [instr : CompilerIrInstr]) : OptLoadCseResult
  (let
    [invalidated : OptLoadCseState
      (opt-load-cse-state-invalidate-def state instr)]
    [key : OptLoadKey (OptLoadKey src ty)]
    (if (and
      (opt-gvn-stable-var? sources dst)
      (opt-gvn-value-stable? sources src))
      (match invalidated
        [(OptLoadCseState _ table)
          (match (opt-load-table-lookup table key)
            [(OptSomeI64 earlier)
              (let
                [new-instr : CompilerIrInstr
                  (IrInstrMov dst (IrValueVar earlier) ty)]
                [updated : OptLoadCseState
                  (opt-load-cse-state-update-facts invalidated new-instr)]
                (OptLoadCseResult
                  (opt-load-cse-record-load updated key dst)
                  new-instr))]
            [(OptNoI64)
              (let
                [updated : OptLoadCseState
                  (opt-load-cse-state-update-facts invalidated instr)]
                (OptLoadCseResult
                  (opt-load-cse-record-load updated key dst)
                  instr))])])
      (OptLoadCseResult
        (opt-load-cse-state-update-facts invalidated instr)
        instr))))

(define (opt-load-gvn-instr
  [state : OptLoadCseState]
  [sources : I64I64Map]
  [instr : CompilerIrInstr]) : OptLoadCseResult
  (if (opt-alias-instr-clears-all? instr)
    (OptLoadCseResult (opt-load-cse-state-clear-for-memory state instr) instr)
    (match instr
      [(IrInstrLoad dst src ty)
        (opt-load-gvn-load state sources dst src ty instr)]
      [_
        (OptLoadCseResult
          (opt-load-cse-state-update-facts
            (opt-load-cse-state-invalidate-def state instr)
            instr)
          instr)])))

(define (opt-load-gvn-instr-seq-from
  [state : OptLoadCseState]
  [sources : I64I64Map]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [out-rev : CompilerIrInstrList]) : OptLoadGvnBlockRewrite
  (if (>= index (compiler-ir-instr-seq-count instrs))
    (OptLoadGvnBlockRewrite
      state
      (compiler-ir-instr-list-reverse-onto out-rev IrInstrNil))
    (match (opt-load-gvn-instr
      state
      sources
      (compiler-ir-instr-seq-ref instrs index))
      [(OptLoadCseResult next-state new-instr)
        (opt-load-gvn-instr-seq-from
          next-state
          sources
          instrs
          (+ index 1)
          (compiler-ir-instr-cons new-instr out-rev))])))

(define (opt-load-gvn-rewrite-block
  [entry-state : OptLoadCseState]
  [sources : I64I64Map]
  [block : CompilerIrBlock]) : OptLoadGvnBlockRewrite
  (match block
    [(IrBlock _ instrs)
      (opt-load-gvn-instr-seq-from entry-state sources instrs 0 IrInstrNil)]))

(define (opt-load-gvn-process-id
  [context : OptCfgContext]
  [sources : I64I64Map]
  [blocks : CompilerIrBlockList]
  [exit-states : (Array OptMaybeLoadCseState)]
  [processed : (Array bool)]
  [out : (Array OptGvnBlockResult)]
  [id : i64]) : unit
  (let
    [index : OptCfgIndex (struct-get context index)]
    [label : String (opt-cfg-index-label index id)]
    [entry-state : OptLoadCseState
      (opt-load-gvn-entry-state context exit-states processed id)]
    (match (opt-cfg-find-block blocks label)
      [(OptNoBlock) unit]
      [(OptSomeBlock block)
        (match block
          [(IrBlock block-label _)
            (match (opt-load-gvn-rewrite-block entry-state sources block)
              [(OptLoadGvnBlockRewrite exit-state instrs)
                (begin
                  (array-set!
                    out
                    id
                    (OptGvnSomeBlock (compiler-ir-block block-label instrs)))
                  (array-set! exit-states id (OptSomeLoadCseState exit-state))
                  (array-set! processed id true))])])])))

(define (opt-load-gvn-process-rpo
  [context : OptCfgContext]
  [sources : I64I64Map]
  [blocks : CompilerIrBlockList]
  [exit-states : (Array OptMaybeLoadCseState)]
  [processed : (Array bool)]
  [out : (Array OptGvnBlockResult)]
  [slot : i64]) : unit
  (let
    [index : OptCfgIndex (struct-get context index)]
    [reach-count : i64 (struct-get index reach-count)]
    (if (>= slot reach-count)
      unit
      (let
        [id : i64 (opt-cfg-index-rpo-id index slot)]
        (begin
          (opt-load-gvn-process-id
            context
            sources
            blocks
            exit-states
            processed
            out
            id)
          (opt-load-gvn-process-rpo
            context
            sources
            blocks
            exit-states
            processed
            out
            (+ slot 1)))))))

(define (opt-load-gvn-blocks-with-context
  [context : OptCfgContext]
  [sources : I64I64Map]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (let
    [index : OptCfgIndex (struct-get context index)]
    [count : i64 (opt-cfg-index-block-count index)]
    [exit-states : (Array OptMaybeLoadCseState)
      (make-array OptMaybeLoadCseState count)]
    [processed : (Array bool) (make-array bool count)]
    [out : (Array OptGvnBlockResult) (make-array OptGvnBlockResult count)]
    (begin
      (opt-load-state-array-fill-empty! exit-states count)
      (opt-cfg-fill-bool! processed count false)
      (opt-gvn-block-results-fill-empty! out 0)
      (opt-load-gvn-process-rpo
        context
        sources
        blocks
        exit-states
        processed
        out
        0)
      (opt-gvn-materialize-blocks (struct-get context doms) out blocks))))

;; --- noalias fact model self-test (#1510) -----------------------------------
(define (opt-alias-test-unique-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrGep 1 (IrValueVar 0) (IrValueI64 8) (AstTyI64))
      (compiler-ir-instr-cons
        (IrInstrBinOp 2 (IrBinAdd) (IrValueI64 1) (IrValueI64 2) (AstTyI64))
        (IrInstrNil)))))

(define (opt-alias-test-transitive-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrGep 1 (IrValueVar 0) (IrValueI64 8) (AstTyI64))
      (compiler-ir-instr-cons
        (IrInstrGep 2 (IrValueVar 1) (IrValueI64 8) (AstTyI64))
        (IrInstrNil)))))

(define (opt-alias-test-load-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrLoad 1 (IrValueVar 0) (AstTyI64))
      (IrInstrNil))))

(define (opt-alias-test-store-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrStorePtr (IrValueVar 0) (IrValueI64 5) (AstTyI64))
      (IrInstrNil))))

(define (opt-alias-test-call-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrCall 9 "tl_noop" (IrCallArgsNil) (AstTyI64))
      (IrInstrNil))))

(define (opt-alias-test-copy-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrMov 1 (IrValueVar 0) (AstTyI64))
      (compiler-ir-instr-cons
        (IrInstrMov 2 (IrValueI64 7) (AstTyI64))
        (IrInstrNil)))))

(define (opt-alias-join-facts-a) : OptAliasFacts
  (opt-alias-bind
    (opt-alias-bind
      (opt-alias-bind (opt-alias-empty) 0 (OptAliasUnique))
      1
      (OptAliasDerived 0))
    2
    (OptAliasMayAlias)))

(define (opt-alias-join-facts-b) : OptAliasFacts
  (opt-alias-bind
    (opt-alias-bind
      (opt-alias-bind (opt-alias-empty) 0 (OptAliasUnique))
      1
      (OptAliasMayAlias))
    3
    (OptAliasUnique)))

(define (opt-alias-sample-store) : CompilerIrInstr
  (IrInstrStorePtr (IrValueVar 0) (IrValueI64 5) (AstTyI64)))

(define (opt-alias-sample-tail-call) : CompilerIrInstr
  (IrInstrTailCall "tl_noop" (IrCallArgsNil) (AstTyI64)))

(define (opt-alias-sample-binop) : CompilerIrInstr
  (IrInstrBinOp 9 (IrBinAdd) (IrValueI64 1) (IrValueI64 2) (AstTyI64)))

(define (compiler-optimize-alias-self-test) : i64
  (let
    [unique : OptAliasFacts
      (opt-alias-run (opt-alias-empty) (opt-alias-test-unique-instrs))]
    [transitive : OptAliasFacts
      (opt-alias-run (opt-alias-empty) (opt-alias-test-transitive-instrs))]
    [loaded : OptAliasFacts
      (opt-alias-run (opt-alias-empty) (opt-alias-test-load-instrs))]
    [stored : OptAliasFacts
      (opt-alias-run (opt-alias-empty) (opt-alias-test-store-instrs))]
    [called : OptAliasFacts
      (opt-alias-run (opt-alias-empty) (opt-alias-test-call-instrs))]
    [copied : OptAliasFacts
      (opt-alias-run (opt-alias-empty) (opt-alias-test-copy-instrs))]
    [joined : OptAliasFacts
      (opt-alias-intersect (opt-alias-join-facts-a) (opt-alias-join-facts-b))]
    [invalidated : OptAliasFacts
      (opt-alias-mark-invalidated (opt-alias-mark-unique (opt-alias-empty) 0) 0)]
    (cond
      [(not (opt-alias-contains? unique 0 (OptAliasUnique))) 1]
      [(not (opt-alias-contains? unique 1 (OptAliasDerived 0))) 2]
      [(not (opt-alias-absent? unique 2)) 3]
      [(not (= (opt-alias-facts-len unique) 2)) 4]
      [(not (opt-alias-contains? transitive 2 (OptAliasDerived 0))) 5]
      [(not (opt-alias-contains? loaded 0 (OptAliasUnique))) 6]
      [(not (opt-alias-contains? loaded 1 (OptAliasMayAlias))) 7]
      [(not (= (opt-alias-facts-len stored) 0)) 8]
      [(not (opt-alias-instr-clears-all? (opt-alias-sample-store))) 9]
      [(not (= (opt-alias-facts-len called) 0)) 10]
      [(not (opt-alias-instr-clears-all? (opt-alias-sample-tail-call))) 11]
      [(not (opt-alias-contains? copied 1 (OptAliasUnique))) 12]
      [(not (opt-alias-contains? copied 2 (OptAliasMayAlias))) 13]
      [(not (= (opt-alias-facts-len joined) 1)) 14]
      [(not (opt-alias-contains? joined 0 (OptAliasUnique))) 15]
      [(opt-alias-contains? joined 1 (OptAliasDerived 0)) 16]
      [(opt-alias-instr-clears-all? (opt-alias-sample-binop)) 17]
      [(not (opt-alias-contains? invalidated 0 (OptAliasInvalidated))) 18]
      [else 42])))

(define (opt-load-cse-run [instrs : CompilerIrInstrList]) : CompilerIrInstrList
  (opt-load-cse-instrs (OptLoadCseState (opt-alias-empty) (OptLoadNil)) instrs))

(define (opt-load-cse-positive-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrGep 1 (IrValueVar 0) (IrValueI64 0) (AstTyI64))
      (compiler-ir-instr-cons
        (IrInstrLoad 2 (IrValueVar 1) (AstTyI64))
        (compiler-ir-instr-cons
          (IrInstrBinOp 4 (IrBinAdd) (IrValueI64 1) (IrValueI64 2) (AstTyI64))
          (compiler-ir-instr-cons
            (IrInstrLoad 3 (IrValueVar 1) (AstTyI64))
            (IrInstrNil)))))))

(define (opt-load-cse-barrier-instrs [barrier : CompilerIrInstr]) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrGep 1 (IrValueVar 0) (IrValueI64 0) (AstTyI64))
      (compiler-ir-instr-cons
        (IrInstrLoad 2 (IrValueVar 1) (AstTyI64))
        (compiler-ir-instr-cons
          barrier
          (compiler-ir-instr-cons
            (IrInstrLoad 3 (IrValueVar 1) (AstTyI64))
            (IrInstrNil)))))))

(define (opt-load-cse-address-redef-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrGep 1 (IrValueVar 0) (IrValueI64 0) (AstTyI64))
      (compiler-ir-instr-cons
        (IrInstrLoad 2 (IrValueVar 1) (AstTyI64))
        (compiler-ir-instr-cons
          (IrInstrMov 1 (IrValueI64 7) (AstTyI64))
          (compiler-ir-instr-cons
            (IrInstrLoad 3 (IrValueVar 1) (AstTyI64))
            (IrInstrNil)))))))

(define (opt-load-cse-result-redef-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrGep 1 (IrValueVar 0) (IrValueI64 0) (AstTyI64))
      (compiler-ir-instr-cons
        (IrInstrLoad 2 (IrValueVar 1) (AstTyI64))
        (compiler-ir-instr-cons
          (IrInstrMov 2 (IrValueI64 7) (AstTyI64))
          (compiler-ir-instr-cons
            (IrInstrLoad 3 (IrValueVar 1) (AstTyI64))
            (IrInstrNil)))))))

(define (opt-load-cse-type-mismatch-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrGep 1 (IrValueVar 0) (IrValueI64 0) (AstTyI64))
      (compiler-ir-instr-cons
        (IrInstrLoad 2 (IrValueVar 1) (AstTyI64))
        (compiler-ir-instr-cons
          (IrInstrLoad 3 (IrValueVar 1) (AstTyBool))
          (IrInstrNil))))))

(define (opt-load-cse-different-address-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (IrInstrAlloc 0 (AstTyI64))
    (compiler-ir-instr-cons
      (IrInstrGep 1 (IrValueVar 0) (IrValueI64 0) (AstTyI64))
      (compiler-ir-instr-cons
        (IrInstrGep 4 (IrValueVar 0) (IrValueI64 8) (AstTyI64))
        (compiler-ir-instr-cons
          (IrInstrLoad 2 (IrValueVar 1) (AstTyI64))
          (compiler-ir-instr-cons
            (IrInstrLoad 3 (IrValueVar 4) (AstTyI64))
            (IrInstrNil)))))))

(define (opt-load-cse-barrier-blocked? [barrier : CompilerIrInstr]) : bool
  (let
    [optimized : CompilerIrInstrList
      (opt-load-cse-run (opt-load-cse-barrier-instrs barrier))]
    (and
      (= (opt-count-load-instrs optimized) 2)
      (= (opt-count-mov-dst-instrs optimized 3) 0))))

(define (compiler-optimize-load-cse-self-test) : i64
  (let
    [positive : CompilerIrInstrList
      (opt-load-cse-run (opt-load-cse-positive-instrs))]
    [store : bool
      (opt-load-cse-barrier-blocked?
        (IrInstrStorePtr (IrValueVar 1) (IrValueI64 9) (AstTyI64)))]
    [global-store : bool
      (opt-load-cse-barrier-blocked?
        (IrInstrStore "g" (IrValueI64 9) (AstTyI64)))]
    [vector-store : bool
      (opt-load-cse-barrier-blocked?
        (ir-instr-vector-store
          (IrValueVar 1)
          (IrValueI64 0)
          (IrValueI64 9)
          4
          (AstTyI64)))]
    [pred-store : bool
      (opt-load-cse-barrier-blocked?
        (ir-instr-predicated-store
          (IrValueVar 1)
          (IrValueI64 0)
          (IrValueI64 9)
          (IrValueBool true)
          4
          (AstTyI64)))]
    [direct-call : bool
      (opt-load-cse-barrier-blocked?
        (IrInstrCall 9 "touch" (IrCallArgsNil) (AstTyI64)))]
    [indirect-call : bool
      (opt-load-cse-barrier-blocked?
        (IrInstrCallIndirect
          9
          (IrValueFunction "touch")
          (IrCallArgsNil)
          (AstTyI64)))]
    [tail-call : bool
      (opt-load-cse-barrier-blocked?
        (IrInstrTailCall "touch" (IrCallArgsNil) (AstTyI64)))]
    [syscall : bool
      (opt-load-cse-barrier-blocked? (IrInstrSyscall 9 (IrCallArgsNil)))]
    [address-redef : CompilerIrInstrList
      (opt-load-cse-run (opt-load-cse-address-redef-instrs))]
    [result-redef : CompilerIrInstrList
      (opt-load-cse-run (opt-load-cse-result-redef-instrs))]
    [type-mismatch : CompilerIrInstrList
      (opt-load-cse-run (opt-load-cse-type-mismatch-instrs))]
    [different-address : CompilerIrInstrList
      (opt-load-cse-run (opt-load-cse-different-address-instrs))]
    [pipeline : CompilerIrBlock
      (optimize-block
        (compiler-ir-block "entry" (opt-load-cse-positive-instrs)))]
    [pipeline-instrs : CompilerIrInstrList
      (match pipeline
        [(IrBlock _ instrs) (compiler-ir-instr-seq-to-list instrs)])]
    (cond
      [(not (= (opt-count-load-instrs positive) 1)) 1]
      [(not (= (opt-count-mov-dst-instrs positive 3) 1)) 2]
      [(not store) 3]
      [(not global-store) 4]
      [(not vector-store) 5]
      [(not pred-store) 6]
      [(not direct-call) 7]
      [(not indirect-call) 8]
      [(not tail-call) 9]
      [(not syscall) 10]
      [(not (= (opt-count-load-instrs address-redef) 2)) 11]
      [(not (= (opt-count-mov-dst-instrs address-redef 3) 0)) 12]
      [(not (= (opt-count-load-instrs result-redef) 2)) 13]
      [(not (= (opt-count-mov-dst-instrs result-redef 3) 0)) 14]
      [(not (= (opt-count-load-instrs type-mismatch) 2)) 15]
      [(not (= (opt-count-load-instrs different-address) 2)) 16]
      [(not (= (opt-count-load-instrs pipeline-instrs) 1)) 17]
      [(not (= (opt-count-mov-dst-instrs pipeline-instrs 3) 1)) 18]
      [else 42])))